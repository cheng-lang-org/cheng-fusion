fn TypedExprTypeResolutionAuthorityEmpty(): TypedExprTypeResolutionAuthority =
    var out: TypedExprTypeResolutionAuthority
    out.sealed = true
    return out

fn typedExprTypeArenaAppendI32(buf: var layout.ByteBuf, value: int32) =
    var raw = Int64(value)
    if raw < 0:
        raw = raw + Int64(4294967296)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))
    raw = raw / Int64(256)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))
    raw = raw / Int64(256)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))
    raw = raw / Int64(256)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))

@borrows
fn typedExprTypeArenaAppendText(buf: var layout.ByteBuf, text: str) =
    typedExprTypeArenaAppendI32(buf, text.len)
    for index in 0..<text.len:
        layout.ByteBufAppendByte(buf, Int32(text[index]) & 255)

@borrows
fn typedExprTypeArenaAppendColumn(
        buf: var layout.ByteBuf,
        arena: arenamod.Arena,
        column: arenamod.ArenaArrayInt32) =
    typedExprTypeArenaAppendI32(buf, column.len)
    for index in 0..<column.len:
        typedExprTypeArenaAppendI32(
            buf, arenamod.ArenaArrayInt32Get(arena, column, index))

@borrows
fn typedExprTypeArenaAppendNameColumn(
        buf: var layout.ByteBuf,
        nameIds: int32[],
        names: str[]) =
    if nameIds.len != names.len:
        panic("typed expr type arena: child name materialization mismatch")
    typedExprTypeArenaAppendI32(buf, nameIds.len)
    for index in 0..<nameIds.len:
        if nameIds[index] < 0:
            typedExprTypeArenaAppendI32(buf, -1)
        else:
            typedExprTypeArenaAppendText(buf, names[index])

@borrows
fn typedExprTypeArenaAppendRequiredNameColumn(
        buf: var layout.ByteBuf,
        names: str[]) =
    typedExprTypeArenaAppendI32(buf, names.len)
    for index in 0..<names.len:
        typedExprTypeArenaAppendText(buf, names[index])

@borrows
@borrow_result
fn typedExprTypeArenaLookupIntern(
        pool: langintern.InternPool,
        id: langintern.InternId): Result[str] =
    let result = langintern.LookupIntern(pool, id)
    if pool == nil:
        panic("typed expr type arena: intern lookup borrow lost")
    return result

@borrows
fn typedExprTypeArenaHash(
        value: TypedExprTypeArena): layout.FixedBytes32 =
    var genericNameIds: int32[]
    var genericNames: str[]
    var childNameIds: int32[]
    var childNames: str[]
    var symbolNameIds: int32[]
    var symbolNames: str[]
    var memberNameIds: int32[]
    var memberNames: str[]
    setLen(genericNameIds, value.genericSymbolNameIds.len)
    setLen(genericNames, value.genericSymbolNameIds.len)
    setLen(childNameIds, value.childNameIds.len)
    setLen(childNames, value.childNameIds.len)
    setLen(symbolNameIds, value.symbolNameIds.len)
    setLen(symbolNames, value.symbolNameIds.len)
    setLen(memberNameIds, value.memberNameIds.len)
    setLen(memberNames, value.memberNameIds.len)
    for index in 0..<genericNameIds.len:
        genericNameIds[index] = typedExprTypeArenaInt32At(value, value.genericSymbolNameIds.offset, value.genericSymbolNameIds.len, index)
    for index in 0..<childNameIds.len:
        childNameIds[index] = typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, index)
    for index in 0..<symbolNameIds.len:
        symbolNameIds[index] = typedExprTypeArenaInt32At(value, value.symbolNameIds.offset, value.symbolNameIds.len, index)
    for index in 0..<memberNameIds.len:
        memberNameIds[index] = typedExprTypeArenaInt32At(value, value.memberNameIds.offset, value.memberNameIds.len, index)
    for index in 0..<genericNames.len:
        let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
            value.internPool, genericNameIds[index])
        if !IsOk(nameResult) || Value(nameResult) == "":
            panic("typed expr type arena: generic name authority missing")
        genericNames[index] = Value(nameResult)
    for index in 0..<childNameIds.len:
        let nameId = childNameIds[index]
        if nameId >= 0:
            let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
                value.internPool, nameId)
            if !IsOk(nameResult) || Value(nameResult) == "":
                panic("typed expr type arena: child name authority missing")
            childNames[index] = Value(nameResult)
    for index in 0..<symbolNames.len:
        let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
            value.internPool, symbolNameIds[index])
        if !IsOk(nameResult) || Value(nameResult) == "":
            panic("typed expr type arena: symbol name authority missing")
        symbolNames[index] = Value(nameResult)
    for index in 0..<memberNames.len:
        let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
            value.internPool, memberNameIds[index])
        if !IsOk(nameResult) || Value(nameResult) == "":
            panic("typed expr type arena: member name authority missing")
        memberNames[index] = Value(nameResult)
    return typedExprTypeArenaHashMaterialized(
        value, genericNames, childNameIds, childNames,
        symbolNames, memberNames)

# Deterministic current-state identity used by strict mutation tests and
# receipt verifiers.  This does not admit or publish the arena.
@borrows
fn TypedExprTypeArenaArtifactCidForCurrentState(
        value: TypedExprTypeArena): layout.FixedBytes32 =
    if value == nil:
        panic("typed expr type arena: artifact identity source missing")
    return typedExprTypeArenaHash(value)

@borrows
fn typedExprTypeArenaHashMaterialized(
        value: TypedExprTypeArena,
        genericNames: str[],
        childNameIds: int32[],
        childNames: str[],
        symbolNames: str[],
        memberNames: str[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(4096)
    typedExprTypeArenaAppendText(buf, TypedExprTypeArenaHashDomain)
    typedExprTypeArenaAppendI32(buf, value.producerSourceCount)
    typedExprTypeArenaAppendI32(buf, value.tokenCount)
    typedExprTypeArenaAppendI32(buf, value.typeSyntaxCount)
    typedExprTypeArenaAppendI32(buf, value.functionCount)
    typedExprTypeArenaAppendI32(buf, value.genericSymbolCount)
    typedExprTypeArenaAppendI32(buf, value.genericSymbolChildCount)
    typedExprTypeArenaAppendI32(buf, value.bracketArgCount)
    typedExprTypeArenaAppendI32(buf, value.typeCount)
    typedExprTypeArenaAppendI32(buf, value.symbolCount)
    typedExprTypeArenaAppendI32(buf, value.memberCount)
    typedExprTypeArenaAppendI32(buf, value.resolutionCount)
    typedExprTypeArenaAppendI32(buf, value.genericResolutionCount)
    typedExprTypeArenaAppendI32(buf, value.nominalDependencyCount)
    typedExprTypeArenaAppendI32(buf, value.symbolDependencyCount)
    typedExprTypeArenaAppendI32(buf, value.sccCount)
    typedExprTypeArenaAppendI32(buf, value.complete ? 1 : 0)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.tokenProducerSourceIndexes)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.tokenKinds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.tokenSpanStarts)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.tokenSpanEnds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.typeSyntaxTypeIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxParserKinds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxProducerSourceIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxSourceLocalRows)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxSpanStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxSpanEnds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxOwnerTokenIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxQuestionTokenIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxDeclarationOwnerTokenIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxDeclarationOwnerNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxGenericSymbolStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxGenericSymbolCounts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxRootKinds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxBracketArgStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxBracketArgCounts)
    typedExprTypeArenaAppendColumn(
        buf,
        value.arena,
        value.typeSyntaxBracketBaseTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.functionSourceStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.functionSourceCounts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.functionProducerSourceIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.functionSourceLocalRows)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.functionDeclarationSourceLocalRows)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.functionOwnerTokenIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.functionReturnTypeIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.bracketArgTokenStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.bracketArgTokenCounts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.bracketArgTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolProducerSourceIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolDeclarationOwnerTokenIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolNameTokenIndexes)
    typedExprTypeArenaAppendRequiredNameColumn(buf, genericNames)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolOrdinals)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolSpanStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolSpanEnds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolOwnerTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf,
        value.arena,
        value.genericSymbolConstraintTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf,
        value.arena,
        value.genericSymbolDefaultTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolConstraintTypeIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolDefaultTypeIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolChildStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolChildCounts)
    typedExprTypeArenaAppendColumn(
        buf,
        value.arena,
        value.genericSymbolChildTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericSymbolChildTypeIds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.typeKinds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.scalarKinds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.symbolIds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.genericSymbolIds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.fixedLengths)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.functionParamCounts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.baseTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.baseTypeIds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.childStarts)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.childCounts)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.childTypeIds)
    typedExprTypeArenaAppendNameColumn(buf, childNameIds, childNames)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.traitRuleKinds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.traitPremiseStarts)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.traitPremiseCounts)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.traitPremiseTypeIds)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.managedFlags)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.sendFlags)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.syncFlags)
    typedExprTypeArenaAppendColumn(buf, value.arena, value.typeOriginKinds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.originTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.originProducerSourceIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolDeclarationRootTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolProducerSourceIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolDeclarationOwnerTokenIndexes)
    typedExprTypeArenaAppendRequiredNameColumn(buf, symbolNames)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolMemberStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolMemberCounts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.memberProducerSourceIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.memberDeclarationSymbolIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.memberNameTokenIndexes)
    typedExprTypeArenaAppendRequiredNameColumn(buf, memberNames)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.memberOrdinals)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.memberTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.memberTypeIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxParentNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.typeSyntaxEnclosingSymbolIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.resolutionTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.resolutionTargetSymbolIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericResolutionTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.genericResolutionTargetGenericSymbolRows)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.nominalDependencyTypeSyntaxNodeIndexes)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.nominalDependencySourceSymbolIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.nominalDependencyTargetSymbolIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.nominalDependencyIndirectFlags)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolDependencyStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolDependencyCounts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolDependencyTargetSymbolIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolDependencyDirectFlags)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.symbolSccIds)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.sccStarts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.sccCounts)
    typedExprTypeArenaAppendColumn(
        buf, value.arena, value.sccSymbolIds)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn typedExprTypeArenaScalarKind(text: str): TypedExprStructuralScalarKind =
    if text == "void": return TypedExprStructuralScalarVoid
    if text == "bool": return TypedExprStructuralScalarBool
    if text == "char": return TypedExprStructuralScalarChar
    if text == "int": return TypedExprStructuralScalarInt
    if text == "uint": return TypedExprStructuralScalarUInt
    if text == "int8": return TypedExprStructuralScalarInt8
    if text == "uint8" || text == "u8":
        return TypedExprStructuralScalarUInt8
    if text == "int16": return TypedExprStructuralScalarInt16
    if text == "uint16" || text == "u16":
        return TypedExprStructuralScalarUInt16
    if text == "int32": return TypedExprStructuralScalarInt32
    if text == "uint32" || text == "u32":
        return TypedExprStructuralScalarUInt32
    if text == "int64": return TypedExprStructuralScalarInt64
    if text == "uint64" || text == "u64":
        return TypedExprStructuralScalarUInt64
    if text == "float32": return TypedExprStructuralScalarFloat32
    if text == "float64": return TypedExprStructuralScalarFloat64
    if text == "str": return TypedExprStructuralScalarStr
    if text == "cstring": return TypedExprStructuralScalarCString
    if text == "ptr": return TypedExprStructuralScalarPtr
    if text == "typedesc": return TypedExprStructuralScalarTypedesc
    if text == "set": return TypedExprStructuralScalarSet
    if text == "utf8_view": return TypedExprStructuralScalarUtf8View
    if text == "bytes_view": return TypedExprStructuralScalarBytesView
    return TypedExprStructuralScalarInvalid

# [builtin-ctor] Closed vocabulary of built-in type constructors.  The arity
# is a language fact owned by this table and is NEVER read back from the
# source: `typedesc[A, B]` must fail loudly instead of silently minting a
# two-argument application.  `0` means "not a constructor" (an ordinary
# scalar).  The head of such an application is the constructor row itself,
# exactly as the cold chain's TypeIdentity APPLY carries its head in
# child[0] (bootstrap/cheng_cold.c:78304-78310, :78410-78414).
fn typedExprTypeArenaBuiltinConstructorArity(
        scalarKind: TypedExprStructuralScalarKind): int32 =
    if scalarKind == TypedExprStructuralScalarTypedesc: return 1
    if scalarKind == TypedExprStructuralScalarSet: return 1
    return 0

# [builtin-ctor] The ONE shape test for "this application row is headed by
# a built-in type constructor".  Such a row has no declaration to name, so
# its `symbolIds` is `-1` and its authority is `children[0]`: the opening is
# exactly TypeApply + symbolId == -1 + child[0] is a Scalar row, never
# wider.  Every consumer in this file calls this one predicate, so the two
# arms that need the distinction can no longer drift apart.
@borrows
fn typedExprTypeArenaBuiltinHeadApply(
        value: TypedExprTypeArena,
        typeId: int32): bool =
    if value == nil || typeId < 0 || typeId >= value.typeCount ||
       typedExprTypeArenaInt32At(
           value, value.typeKinds.offset, value.typeKinds.len, typeId) !=
           Int32(TypedExprStructuralTypeApply) ||
       typedExprTypeArenaInt32At(
           value, value.symbolIds.offset, value.symbolIds.len, typeId) !=
           -1:
        return false
    let headChildCount = typedExprTypeArenaInt32At(
        value, value.childCounts.offset, value.childCounts.len, typeId)
    if headChildCount < 1:
        return false
    let headTypeId = typedExprTypeArenaInt32At(
        value,
        value.childTypeIds.offset,
        value.childTypeIds.len,
        typedExprTypeArenaInt32At(
            value, value.childStarts.offset, value.childStarts.len, typeId))
    return headTypeId >= 0 && headTypeId < value.typeCount &&
           typedExprTypeArenaInt32At(
               value, value.typeKinds.offset, value.typeKinds.len,
               headTypeId) == Int32(TypedExprStructuralTypeScalar)

# [trait-mirror] The ONE scalar Send/Sync rule: a scalar crosses a thread
# boundary exactly when it is a plain machine value.  `str` is managed;
# `cstring` and `ptr` are FFI addresses (spec 0.3: FFI handles default to
# !Send/!Sync); `typedesc` is an erased type witness.  `set` IS sendable --
# it is a plain 64-bit mask (std/system.cheng:2821 casts it with
# `uint64(s)`).  FOUR sites must agree: the producer (`Intern`), the
# fixpoint recomputation (`typedExprTypeArenaComputeTraitFlags`), the
# `expected*` projection in `TypedExprTypeArenaStrictValidateInto`, and the
# portable mirror `csgCompilerTypeTraitsDerivedInto` in
# compiler_snapshot_schema.cheng.  They all read this one predicate now;
# a disagreement is reported as `type trait conclusion mismatch` /
# `trait rule or premise drift` and is NEVER repaired.  Keep those two
# verdicts named here: they are the detector for a site that stopped
# agreeing, and they are what caught `ptr` and `typedesc` drifting.
@borrows
fn typedExprTypeArenaScalarSendable(
        scalarKind: TypedExprStructuralScalarKind): bool =
    return scalarKind != TypedExprStructuralScalarStr &&
           scalarKind != TypedExprStructuralScalarCString &&
           scalarKind != TypedExprStructuralScalarPtr &&
           scalarKind != TypedExprStructuralScalarUtf8View &&
           scalarKind != TypedExprStructuralScalarBytesView &&
           scalarKind != TypedExprStructuralScalarTypedesc

fn typedExprTypeArenaHashStep(value: int32, item: int32): int32 =
    # Keep every intermediate inside signed int32.  This hash is only a bucket
    # selector; exact structural equality below is the cache authority.
    var normalized = item % 1000003
    if normalized < 0:
        normalized = normalized + 1000003
    return (value * 131 + normalized + 17) % 1000003

@borrows
fn typedExprTypeArenaTypeHash(
        kind: TypedExprStructuralTypeKind,
        scalarKind: TypedExprStructuralScalarKind,
        symbolId: int32,
        genericSymbolId: int32,
        fixedLength: int32,
        functionParamCount: int32,
        baseTypeId: int32,
        children: int32[],
        childNameIds: int32[]): int32 =
    var value: int32 = 23
    value = typedExprTypeArenaHashStep(value, Int32(kind))
    value = typedExprTypeArenaHashStep(value, Int32(scalarKind))
    value = typedExprTypeArenaHashStep(value, symbolId)
    value = typedExprTypeArenaHashStep(value, genericSymbolId)
    value = typedExprTypeArenaHashStep(value, fixedLength)
    value = typedExprTypeArenaHashStep(value, functionParamCount)
    value = typedExprTypeArenaHashStep(value, baseTypeId)
    value = typedExprTypeArenaHashStep(value, children.len)
    for index in 0..<children.len:
        value = typedExprTypeArenaHashStep(value, children[index])
        value = typedExprTypeArenaHashStep(value, childNameIds[index])
    return value

@borrows
fn typedExprTypeArenaTypeEqual(
        value: TypedExprTypeArena,
        typeId: int32,
        kind: TypedExprStructuralTypeKind,
        scalarKind: TypedExprStructuralScalarKind,
        symbolId: int32,
        genericSymbolId: int32,
        fixedLength: int32,
        functionParamCount: int32,
        baseTypeId: int32,
        children: int32[],
        childNameIds: int32[]): bool =
    if typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) !=
           Int32(kind) ||
       typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, typeId) !=
           Int32(scalarKind) ||
       typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, typeId) !=
           symbolId ||
       typedExprTypeArenaInt32At(value, value.genericSymbolIds.offset, value.genericSymbolIds.len, typeId) != genericSymbolId ||
       typedExprTypeArenaInt32At(value, value.fixedLengths.offset, value.fixedLengths.len, typeId) !=
           fixedLength ||
       typedExprTypeArenaInt32At(value, value.functionParamCounts.offset, value.functionParamCounts.len, typeId) !=
           functionParamCount ||
       typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, typeId) != baseTypeId ||
       typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, typeId) !=
           children.len:
        return false
    let childStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, typeId)
    for index in 0..<children.len:
        if typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart + index) !=
               children[index] ||
           typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, childStart + index) !=
               childNameIds[index]:
            return false
    return true

@borrows
fn typedExprTypeArenaChildFlag(
        value: TypedExprTypeArena,
        column: arenamod.ArenaArrayInt32,
        childTypeId: int32): bool =
    if childTypeId < 0 || childTypeId >= value.typeCount:
        panic("typed expr type arena: trait premise TypeId out of range")
    return arenamod.ArenaArrayInt32Get(
        value.arena, column, childTypeId) != 0

@borrows
fn typedExprTypeArenaIntern(
        state: var TypedExprTypeArenaBuildState,
        out: var TypedExprTypeArena,
        originTypeSyntaxNodeIndex: int32,
        kind: TypedExprStructuralTypeKind,
        scalarKind: TypedExprStructuralScalarKind,
        symbolId: int32,
        genericSymbolId: int32,
        fixedLength: int32,
        functionParamCount: int32,
        baseTypeSyntaxNodeIndex: int32,
        baseTypeId: int32,
        children: int32[],
        childNameIds: int32[],
        typeIdOut: var int32,
        err: var str): bool =
    typeIdOut = -1
    if children.len != childNameIds.len ||
       arenamod.ArenaArrayInt32Len(out.arena, state.bucketHeads) <= 0 ||
       (baseTypeSyntaxNodeIndex >= 0) != (baseTypeId >= 0) ||
       baseTypeSyntaxNodeIndex < -1 ||
       baseTypeSyntaxNodeIndex >= out.typeSyntaxCount ||
       baseTypeId < -1 || baseTypeId >= out.typeCount ||
       (baseTypeId >= 0 &&
        kind != TypedExprStructuralTypeObject &&
        kind != TypedExprStructuralTypeRefObject) ||
       (baseTypeId >= 0 &&
        arenamod.ArenaArrayInt32Get(
            out.arena, out.typeKinds, baseTypeId) !=
            Int32(TypedExprStructuralTypeObject)):
        err = " typed expr type arena: structural child columns mismatch"
        return false
    let hashValue = typedExprTypeArenaTypeHash(
        kind, scalarKind, symbolId, genericSymbolId, fixedLength,
        functionParamCount, baseTypeId,
        children, childNameIds)
    let headsLen = arenamod.ArenaArrayInt32Len(out.arena, state.bucketHeads)
    let bucket = hashValue % headsLen
    var candidate = arenamod.ArenaArrayInt32Get(
        out.arena, state.bucketHeads, bucket)
    while candidate >= 0:
        if typedExprTypeArenaTypeEqual(
               out, candidate, kind, scalarKind, symbolId, genericSymbolId,
               fixedLength, functionParamCount, baseTypeId,
               children, childNameIds):
            typeIdOut = candidate
            return true
        candidate = arenamod.ArenaArrayInt32Get(
            out.arena, state.bucketNext, candidate)
    var rule = TypedExprTypeTraitRuleInvalid
    var managed = false
    var send = false
    var sync = false
    if kind == TypedExprStructuralTypeScalar:
        if scalarKind == TypedExprStructuralScalarStr:
            rule = TypedExprTypeTraitRuleManagedString
            managed = true
        else:
            rule = TypedExprTypeTraitRulePlainScalar
            # [trait-mirror] `typedesc` is a type witness whose value is
            # erased: it is neither transferable nor shareable.  `set` stays
            # Send/Sync: it is a plain 64-bit mask (std/system.cheng:2821
            # casts it with `uint64(s)`).  `ptr`/`cstring` are FFI
            # addresses (spec 0.3).  FOUR sites must agree -- here, the
            # recomputation below, the `expected*` projection in
            # `TypedExprTypeArenaStrictValidateInto`, and the portable
            # mirror in compiler_snapshot_schema.cheng -- or the build
            # dies with `type trait conclusion mismatch` /
            # `trait rule or premise drift`.  All read the one predicate.
            send = typedExprTypeArenaScalarSendable(scalarKind)
            sync = typedExprTypeArenaScalarSendable(scalarKind)
    elif kind == TypedExprStructuralTypeBorrow:
        rule = TypedExprTypeTraitRuleBorrowedView
    elif kind == TypedExprStructuralTypeSequence:
        rule = TypedExprTypeTraitRuleLocalSequence
        managed = true
    elif kind == TypedExprStructuralTypeFixedArray:
        rule = TypedExprTypeTraitRuleFixedArrayRecursive
        managed = typedExprTypeArenaChildFlag(
            out, out.managedFlags, children[0])
        send = typedExprTypeArenaChildFlag(
            out, out.sendFlags, children[0])
        sync = typedExprTypeArenaChildFlag(
            out, out.syncFlags, children[0])
    elif kind == TypedExprStructuralTypeTuple:
        rule = TypedExprTypeTraitRuleTupleRecursive
        send = true
        sync = true
        for index in 0..<children.len:
            if typedExprTypeArenaChildFlag(
                   out, out.managedFlags, children[index]):
                managed = true
            if !typedExprTypeArenaChildFlag(
                   out, out.sendFlags, children[index]):
                send = false
            if !typedExprTypeArenaChildFlag(
                   out, out.syncFlags, children[index]):
                sync = false
    elif kind == TypedExprStructuralTypeFunction:
        rule = TypedExprTypeTraitRuleFunctionValue
        send = true
        sync = true
    elif kind == TypedExprStructuralTypeObject ||
         kind == TypedExprStructuralTypeEnum:
        rule = kind == TypedExprStructuralTypeObject ?
            TypedExprTypeTraitRuleObjectFieldsRecursive :
            TypedExprTypeTraitRuleEnumVariantsRecursive
        send = true
        sync = true
        if baseTypeId >= 0:
            if typedExprTypeArenaChildFlag(
                   out, out.managedFlags, baseTypeId):
                managed = true
            if !typedExprTypeArenaChildFlag(
                   out, out.sendFlags, baseTypeId):
                send = false
            if !typedExprTypeArenaChildFlag(
                   out, out.syncFlags, baseTypeId):
                sync = false
        for index in 0..<children.len:
            if typedExprTypeArenaChildFlag(
                   out, out.managedFlags, children[index]):
                managed = true
            if !typedExprTypeArenaChildFlag(
                   out, out.sendFlags, children[index]):
                send = false
            if !typedExprTypeArenaChildFlag(
                   out, out.syncFlags, children[index]):
                sync = false
    elif kind == TypedExprStructuralTypeRefObject:
        # A ref object owns heap storage.  Its field TypeIds remain exact
        # premises, while ordinary ref ownership is intentionally local;
        # cross-thread transfer requires Arc/share_mt at the language boundary.
        rule = TypedExprTypeTraitRuleOwnedRefObject
        managed = true
    elif kind == TypedExprStructuralTypeApply:
        rule = TypedExprTypeTraitRuleGenericApplication
        managed = typedExprTypeArenaChildFlag(
            out, out.managedFlags, children[0])
        send = typedExprTypeArenaChildFlag(
            out, out.sendFlags, children[0])
        sync = typedExprTypeArenaChildFlag(
            out, out.syncFlags, children[0])
    elif kind == TypedExprStructuralTypeAlias:
        rule = TypedExprTypeTraitRuleAliasForward
        managed = typedExprTypeArenaChildFlag(
            out, out.managedFlags, children[0])
        send = typedExprTypeArenaChildFlag(
            out, out.sendFlags, children[0])
        sync = typedExprTypeArenaChildFlag(
            out, out.syncFlags, children[0])
    elif kind == TypedExprStructuralTypeGenericParameter:
        # The generic parameter has no concrete substitution in the
        # declaration arena.  Conservatively retain it as managed and reject
        # Send/Sync until specialization supplies an exact argument TypeId.
        rule = TypedExprTypeTraitRuleGenericParameter
        managed = true
    elif kind == TypedExprStructuralTypeOptional:
        rule = TypedExprTypeTraitRuleOptionalRecursive
        managed = typedExprTypeArenaChildFlag(
            out, out.managedFlags, children[0])
        send = typedExprTypeArenaChildFlag(
            out, out.sendFlags, children[0])
        sync = typedExprTypeArenaChildFlag(
            out, out.syncFlags, children[0])
    if rule == TypedExprTypeTraitRuleInvalid:
        err = " typed expr type arena: trait derivation rule missing"
        return false
    let typeId = out.typeCount
    let childStart = out.childTypeIds.len
    let premiseStart = out.traitPremiseTypeIds.len
    arenamod.ArenaArrayInt32Add(out.arena, out.typeKinds,
                                Int32(kind))
    arenamod.ArenaArrayInt32Add(out.arena, out.scalarKinds,
                                Int32(scalarKind))
    arenamod.ArenaArrayInt32Add(out.arena, out.symbolIds, symbolId)
    arenamod.ArenaArrayInt32Add(
        out.arena, out.genericSymbolIds, genericSymbolId)
    arenamod.ArenaArrayInt32Add(out.arena, out.fixedLengths,
                                fixedLength)
    arenamod.ArenaArrayInt32Add(out.arena,
                                out.functionParamCounts,
                                functionParamCount)
    arenamod.ArenaArrayInt32Add(
        out.arena, out.baseTypeSyntaxNodeIndexes,
        baseTypeSyntaxNodeIndex)
    arenamod.ArenaArrayInt32Add(
        out.arena, out.baseTypeIds, baseTypeId)
    arenamod.ArenaArrayInt32Add(out.arena, out.childStarts,
                                childStart)
    arenamod.ArenaArrayInt32Add(out.arena, out.childCounts,
                                children.len)
    for index in 0..<children.len:
        arenamod.ArenaArrayInt32Add(out.arena,
                                    out.childTypeIds,
                                    children[index])
        arenamod.ArenaArrayInt32Add(out.arena,
                                    out.childNameIds,
                                    childNameIds[index])
    arenamod.ArenaArrayInt32Add(out.arena,
                                out.traitRuleKinds,
                                Int32(rule))
    arenamod.ArenaArrayInt32Add(out.arena,
                                out.traitPremiseStarts,
                                premiseStart)
    if baseTypeId >= 0:
        arenamod.ArenaArrayInt32Add(
            out.arena, out.traitPremiseTypeIds, baseTypeId)
    for index in 0..<children.len:
        arenamod.ArenaArrayInt32Add(
            out.arena, out.traitPremiseTypeIds, children[index])
    arenamod.ArenaArrayInt32Add(out.arena,
                                out.traitPremiseCounts,
                                children.len + (baseTypeId >= 0 ? 1 : 0))
    arenamod.ArenaArrayInt32Add(out.arena, out.managedFlags,
                                managed ? 1 : 0)
    arenamod.ArenaArrayInt32Add(out.arena, out.sendFlags,
                                send ? 1 : 0)
    arenamod.ArenaArrayInt32Add(out.arena, out.syncFlags,
                                sync ? 1 : 0)
    let originKind = originTypeSyntaxNodeIndex >= 0 ?
        TypedExprTypeOriginParserSyntax :
        TypedExprTypeOriginSemanticBuiltin
    arenamod.ArenaArrayInt32Add(
        out.arena, out.typeOriginKinds, Int32(originKind))
    arenamod.ArenaArrayInt32Add(
        out.arena, out.originTypeSyntaxNodeIndexes,
        originTypeSyntaxNodeIndex)
    arenamod.ArenaArrayInt32Add(
        out.arena, out.originProducerSourceIndexes,
        originTypeSyntaxNodeIndex >= 0 ?
            typedExprTypeArenaSyntaxProducerSourceIndexAt(
                out, originTypeSyntaxNodeIndex) :
            -1)
    # [X1-dedup] In-place insert: append the previous head of this bucket to
    # the chain column and point the bucket at the new row.  No table copy.
    arenamod.ArenaArrayInt32AddReserved(
        out.arena, state.bucketNext,
        arenamod.ArenaArrayInt32Get(out.arena, state.bucketHeads, bucket))
    arenamod.ArenaArrayInt32Set(out.arena, state.bucketHeads, bucket, typeId)
    out.typeCount = out.typeCount + 1
    typeIdOut = typeId
    return true

@borrows
fn typedExprTypeArenaReserveAggregate(
        state: var TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        declarationRoot: int32,
        symbolId: int32,
        kind: TypedExprStructuralTypeKind,
        childCount: int32,
        typeIdOut: var int32,
        err: var str): bool =
    typeIdOut = -1
    if declarationRoot < 0 || declarationRoot >= localOut.typeSyntaxCount ||
       symbolId < 0 || symbolId >= localOut.symbolCount || childCount < 0 ||
       (kind != TypedExprStructuralTypeObject &&
        kind != TypedExprStructuralTypeRefObject &&
        kind != TypedExprStructuralTypeEnum):
        err = " typed expr type arena: aggregate reservation invalid"
        return false
    let typeId = localOut.typeCount
    let childStart = localOut.childTypeIds.len
    let premiseStart = localOut.traitPremiseTypeIds.len
    let parserBaseCount =
        (kind == TypedExprStructuralTypeObject ||
         kind == TypedExprStructuralTypeRefObject) ?
            typedExprTypeArenaSyntaxChildCountAt(
                localOut, declarationRoot) :
            0
    if parserBaseCount < 0 || parserBaseCount > 1:
        err = " typed expr type arena: object base edge cardinality invalid"
        return false
    let premiseCount = childCount + parserBaseCount
    let rule = if kind == TypedExprStructuralTypeObject:
                   TypedExprTypeTraitRuleObjectFieldsRecursive
               elif kind == TypedExprStructuralTypeRefObject:
                   TypedExprTypeTraitRuleOwnedRefObject
               else:
                   TypedExprTypeTraitRuleEnumVariantsRecursive
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.typeKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.scalarKinds,
        Int32(TypedExprStructuralScalarInvalid))
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.symbolIds, symbolId)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.genericSymbolIds, -1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.fixedLengths, -1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.functionParamCounts, -1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.baseTypeSyntaxNodeIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.baseTypeIds, -1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.childStarts, childStart)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.childCounts, childCount)
    if parserBaseCount == 1:
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.traitPremiseTypeIds, -1)
    for childOffset in 0..<childCount:
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.childTypeIds, -1)
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.childNameIds, -1)
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.traitPremiseTypeIds, -1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.traitRuleKinds, Int32(rule))
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.traitPremiseStarts, premiseStart)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.traitPremiseCounts, premiseCount)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.managedFlags,
        kind == TypedExprStructuralTypeRefObject ? 1 : 0)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.sendFlags,
        kind == TypedExprStructuralTypeRefObject ? 0 : 1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.syncFlags,
        kind == TypedExprStructuralTypeRefObject ? 0 : 1)
    arenamod.ArenaArrayInt32Add(
        localOut.arena,
        localOut.typeOriginKinds,
        Int32(TypedExprTypeOriginParserSyntax))
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.originTypeSyntaxNodeIndexes,
        declarationRoot)
    arenamod.ArenaArrayInt32Add(
        localOut.arena, localOut.originProducerSourceIndexes,
        typedExprTypeArenaSyntaxProducerSourceIndexAt(
            localOut, declarationRoot))
    # [X1-dedup] Reserved-but-unminted row: one chain slot, no table copy.
    arenamod.ArenaArrayInt32AddReserved(localOut.arena, state.bucketNext, -1)
    localOut.typeCount = localOut.typeCount + 1
    arenamod.ArenaArrayInt32Set(
        localOut.arena, localOut.typeSyntaxTypeIds,
        declarationRoot, typeId)
    typeIdOut = typeId
    return true

@borrows
fn typedExprTypeArenaAggregateStructuralKind(
        tree: parser.ParserValueExprTree,
        declarationRoot: int32): TypedExprStructuralTypeKind =
    if declarationRoot < 0 || declarationRoot >= tree.typeSyntaxCount:
        return TypedExprStructuralTypeInvalid
    let parserKind = parser.ParserValueExprTypeSyntaxKindAt(
        tree, declarationRoot)
    if parserKind == parser.ParserTypeSyntaxObject ||
       parserKind == parser.ParserTypeSyntaxImplicitObject:
        return TypedExprStructuralTypeObject
    if parserKind == parser.ParserTypeSyntaxRefObject:
        return TypedExprStructuralTypeRefObject
    if parserKind == parser.ParserTypeSyntaxEnum:
        return TypedExprStructuralTypeEnum
    return TypedExprStructuralTypeInvalid

@borrows
fn typedExprTypeArenaDeclarationCreatesSymbol(
        tree: parser.ParserValueExprTree,
        declarationRoot: int32): bool =
    if declarationRoot < 0 || declarationRoot >= tree.typeSyntaxCount:
        return false
    let rootKind = parser.ParserValueExprTypeSyntaxRootKindAt(
        tree, declarationRoot)
    if rootKind == parser.ParserTypeSyntaxRootTypeDeclarationRhs:
        return true
    if rootKind != parser.ParserTypeSyntaxRootFieldDeclaration:
        return false
    let kind = typedExprTypeArenaAggregateStructuralKind(
        tree, declarationRoot)
    return kind == TypedExprStructuralTypeObject ||
           kind == TypedExprStructuralTypeRefObject

@borrows
fn typedExprTypeArenaDeclarationSymbolNameToken(
        tree: parser.ParserValueExprTree,
        declarationRoot: int32): int32 =
    if declarationRoot < 0 || declarationRoot >= tree.typeSyntaxCount:
        return -1
    if parser.ParserValueExprTypeSyntaxRootKindAt(
           tree, declarationRoot) ==
           parser.ParserTypeSyntaxRootFieldDeclaration:
        return parser.ParserValueExprTypeSyntaxOwnerTokenAt(
            tree, declarationRoot)
    return parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
        tree, declarationRoot)

# [closure8] Append a resident tree's SymbolId-creating declaration roots, in
# that tree's own row order, at their GLOBAL TypeSyntax rows.  This is the one
# traversal the SymbolId space is defined by: the declaration index build calls
# it once per source while that source's tree is still resident, and the
# whole-forest driver calls it once over the merged tree.  Callers walk sources
# in forest order, because a root's accumulated row is its SymbolId.
@borrows
fn typedExprTypeArenaAppendDeclarationSymbolRootsFromTreeInto(
        tree: parser.ParserValueExprTree,
        globalRowBase: int32,
        out: var int32[],
        err: var str): bool =
    if tree == nil || globalRowBase < 0:
        err = " typed expr type arena: declaration symbol root view invalid"
        return false
    for row in 0..<tree.typeSyntaxCount:
        if typedExprTypeArenaDeclarationCreatesSymbol(tree, row):
            add(out, globalRowBase + row)
    err = ""
    return true

# [forward-decl] The whole-forest twin of the index's declaration generic
# window.  The merged tree already carries GLOBAL generic-symbol rows (the
# forest driver passes view base 0), so this is the same predicate in the same
# row order the index build walks, and both drivers seed the build state with
# the same integers.
@borrows
fn typedExprTypeArenaAppendDeclarationGenericWindowsFromTreeInto(
        tree: parser.ParserValueExprTree,
        startsOut: var int32[],
        countsOut: var int32[],
        err: var str): bool =
    if tree == nil:
        err = " typed expr type arena: declaration generic window view invalid"
        return false
    for row in 0..<tree.typeSyntaxCount:
        if typedExprTypeArenaDeclarationCreatesSymbol(tree, row):
            add(startsOut,
                parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(
                    tree, row))
            add(countsOut,
                parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(
                    tree, row))
    err = ""
    return true

@borrows
fn typedExprTypeArenaSeedSemanticScalarRows(
        state: var TypedExprTypeArenaBuildState,
        out: var TypedExprTypeArena,
        err: var str): bool =
    for scalarValue in Int32(TypedExprStructuralScalarVoid)..
                           Int32(TypedExprStructuralScalarCString):
        if scalarValue == Int32(TypedExprStructuralScalarInt) ||
           scalarValue == Int32(TypedExprStructuralScalarUInt):
            continue
        var children: int32[]
        var childNames: int32[]
        var typeId: int32
        if !typedExprTypeArenaIntern(
               state,
               out,
               -1,
               TypedExprStructuralTypeScalar,
               TypedExprStructuralScalarKind(scalarValue),
               -1,
               -1,
               -1,
               -1,
               -1,
               -1,
               children,
               childNames,
               typeId,
               err):
            return false
    err = ""
    return true

@borrows
fn typedExprTypeArenaInt32At(value: TypedExprTypeArena,
                              offset: int32,
                              count: int32,
                              i: int32): int32 =
    if i < 0 || i >= count:
        panic("typed expr type arena: read out of bounds")
    let o = offset + i * 4
    let b0 = arenamod.arenaLoadByte(value.arena, o)
    let b1 = arenamod.arenaLoadByte(value.arena, o + 1)
    let b2 = arenamod.arenaLoadByte(value.arena, o + 2)
    let b3 = arenamod.arenaLoadByte(value.arena, o + 3)
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24)

@borrows
fn typedExprTypeArenaComputeTraitFlags(
        value: TypedExprTypeArena,
        managedOut: var int32[],
        sendOut: var int32[],
        syncOut: var int32[],
        err: var str): bool =
    setLen(managedOut, value.typeCount)
    setLen(sendOut, value.typeCount)
    setLen(syncOut, value.typeCount)
    for typeId in 0..<value.typeCount:
        let kind = TypedExprStructuralTypeKind(
            typedExprTypeArenaInt32At(
                value, value.typeKinds.offset, value.typeKinds.len, typeId))
        let scalarKind = TypedExprStructuralScalarKind(
            typedExprTypeArenaInt32At(
                value, value.scalarKinds.offset, value.scalarKinds.len, typeId))
        if kind == TypedExprStructuralTypeScalar:
            if scalarKind == TypedExprStructuralScalarStr:
                managedOut[typeId] = 1
            elif typedExprTypeArenaScalarSendable(scalarKind):
                sendOut[typeId] = 1
                syncOut[typeId] = 1
        elif kind == TypedExprStructuralTypeSequence ||
             kind == TypedExprStructuralTypeRefObject ||
             kind == TypedExprStructuralTypeGenericParameter:
            managedOut[typeId] = 1
        elif kind == TypedExprStructuralTypeFunction:
            sendOut[typeId] = 1
            syncOut[typeId] = 1
        elif kind == TypedExprStructuralTypeFixedArray ||
             kind == TypedExprStructuralTypeTuple ||
             kind == TypedExprStructuralTypeObject ||
             kind == TypedExprStructuralTypeEnum ||
             kind == TypedExprStructuralTypeApply ||
             kind == TypedExprStructuralTypeAlias ||
             kind == TypedExprStructuralTypeOptional:
            # Recursive managed is the least fixed point; Send/Sync are the
            # greatest fixed point.  These polarities make cycles unique.
            sendOut[typeId] = 1
            syncOut[typeId] = 1
        elif kind != TypedExprStructuralTypeBorrow:
            err = " typed expr type arena: trait solver kind invalid"
            return false
    var changed = true
    var iteration: int32
    let iterationLimit = value.typeCount * 3 + 1
    while changed:
        if iteration > iterationLimit:
            err = " typed expr type arena: trait fixed point did not converge"
            return false
        changed = false
        for typeId in 0..<value.typeCount:
            let kind = TypedExprStructuralTypeKind(
                typedExprTypeArenaInt32At(
                    value, value.typeKinds.offset, value.typeKinds.len, typeId))
            let childStart = typedExprTypeArenaInt32At(
                value, value.childStarts.offset, value.childStarts.len, typeId)
            let childCount = typedExprTypeArenaInt32At(
                value, value.childCounts.offset, value.childCounts.len, typeId)
            let premiseStart = typedExprTypeArenaInt32At(
                value, value.traitPremiseStarts.offset, value.traitPremiseStarts.len, typeId)
            let premiseCount = typedExprTypeArenaInt32At(
                value, value.traitPremiseCounts.offset, value.traitPremiseCounts.len, typeId)
            var nextManaged = managedOut[typeId]
            var nextSend = sendOut[typeId]
            var nextSync = syncOut[typeId]
            if kind == TypedExprStructuralTypeFixedArray ||
               kind == TypedExprStructuralTypeAlias ||
               kind == TypedExprStructuralTypeApply ||
               kind == TypedExprStructuralTypeOptional:
                if childCount <= 0:
                    err = " typed expr type arena: recursive trait premise missing"
                    return false
                let child = typedExprTypeArenaInt32At(
                    value, value.childTypeIds.offset, value.childTypeIds.len, childStart)
                if child < 0 || child >= value.typeCount:
                    err = " typed expr type arena: recursive trait premise invalid"
                    return false
                nextManaged = managedOut[child]
                nextSend = sendOut[child]
                nextSync = syncOut[child]
            elif kind == TypedExprStructuralTypeTuple ||
                 kind == TypedExprStructuralTypeObject ||
                 kind == TypedExprStructuralTypeEnum:
                nextManaged = 0
                nextSend = 1
                nextSync = 1
                let aggregateStart =
                    kind == TypedExprStructuralTypeObject ?
                        premiseStart :
                        childStart
                let aggregateCount =
                    kind == TypedExprStructuralTypeObject ?
                        premiseCount :
                        childCount
                for childOffset in 0..<aggregateCount:
                    var child: int32
                    if kind == TypedExprStructuralTypeObject:
                        child = typedExprTypeArenaInt32At(
                            value,
                            value.traitPremiseTypeIds.offset,
                            value.traitPremiseTypeIds.len,
                            aggregateStart + childOffset)
                    else:
                        child = typedExprTypeArenaInt32At(
                            value,
                            value.childTypeIds.offset,
                            value.childTypeIds.len,
                            aggregateStart + childOffset)
                    if child < 0 || child >= value.typeCount:
                        err = " typed expr type arena: aggregate trait premise invalid"
                        return false
                    if managedOut[child] != 0: nextManaged = 1
                    if sendOut[child] == 0: nextSend = 0
                    if syncOut[child] == 0: nextSync = 0
            if nextManaged != managedOut[typeId] ||
               nextSend != sendOut[typeId] ||
               nextSync != syncOut[typeId]:
                managedOut[typeId] = nextManaged
                sendOut[typeId] = nextSend
                syncOut[typeId] = nextSync
                changed = true
        iteration = iteration + 1
    return true

@borrows
fn typedExprTypeArenaAuthorityRow(
        state: TypedExprTypeArenaBuildState,
        typeSyntaxNodeIndex: int32): int32 =
    var low: int32
    var high = state.authority.typeSyntaxNodeIndexes.len
    while low < high:
        let middle = low + (high - low) / 2
        if state.authority.typeSyntaxNodeIndexes[middle] < typeSyntaxNodeIndex:
            low = middle + 1
        else:
            high = middle
    if low < state.authority.typeSyntaxNodeIndexes.len &&
       state.authority.typeSyntaxNodeIndexes[low] == typeSyntaxNodeIndex:
        return low
    return -1

@borrows
fn typedExprTypeArenaGenericAuthorityRow(
        state: TypedExprTypeArenaBuildState,
        typeSyntaxNodeIndex: int32): int32 =
    var low: int32
    var high = state.authority.genericTypeSyntaxNodeIndexes.len
    while low < high:
        let middle = low + (high - low) / 2
        if state.authority.genericTypeSyntaxNodeIndexes[middle] <
               typeSyntaxNodeIndex:
            low = middle + 1
        else:
            high = middle
    if low < state.authority.genericTypeSyntaxNodeIndexes.len &&
       state.authority.genericTypeSyntaxNodeIndexes[low] ==
           typeSyntaxNodeIndex:
        return low
    return -1

# [S1b step-3 (6)] `typeSyntaxNodeIndex` and every authority root below are
# GLOBAL rows.  The resident tree carries this source's rows only, so a read
# about this row subtracts `viewTypeSyntaxBase`; a read about a symbol token
# subtracts `viewTokenRowBase`; and a fact about a declaration root that may
# live in an earlier source (cross-source edges always point at a smaller row)
# comes from the arena column the append phase already wrote at that same
# global row.  The whole-forest driver passes 0 for both bases, so every read
# below is the previous one, unchanged.
@borrows
fn typedExprTypeArenaResolveNominal(
        state: var TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        typeSyntaxNodeIndex: int32,
        viewTypeSyntaxBase: int32,
        viewTokenRowBase: int32,
        replayForward: bool,
        readColumns: bool,
        typeIdOut: var int32,
        err: var str): bool =
    # [forward-typeid] This call's verdict is published on the state:
    # `-1` means "resolved here", `>= 0` is the exact declaration root the row
    # is deferred against.  It is reset on entry, so every early return below
    # leaves a definite value and no caller can read a previous row's root.
    state.forwardNominalRoot = -1
    state.forwardReplaySkipped = false
    var nameTokenText: str
    var parserKind: parser.ParserTypeSyntaxKind
    if readColumns:
        # [c2-replay-cols] Column path.  Same fact, same absent encoding:
        # typedExprTypeArenaTokenTextOrEmpty stores "" exactly when the name
        # token is absent (negative or past the tree's token count).
        nameTokenText = typedExprTypeArenaSyntaxNameTokenTextAt(
            localOut, typeSyntaxNodeIndex)
        if nameTokenText == "":
            err = " typed expr type arena: nominal name token missing"
            return false
        parserKind = typedExprTypeArenaSyntaxKindAt(
            localOut, typeSyntaxNodeIndex)
    else:
        let treeRow = typeSyntaxNodeIndex - viewTypeSyntaxBase
        let nameToken = parser.ParserValueExprTypeSyntaxNameTokenAt(
            state.tree, treeRow)
        if nameToken < 0 || nameToken >= state.tree.tokenCount:
            err = " typed expr type arena: nominal name token missing"
            return false
        nameTokenText = parser.ParserValueExprTokenText(
            state.tree, nameToken)
        parserKind = parser.ParserValueExprTypeSyntaxKindAt(
            state.tree, treeRow)
    let scalarKind = typedExprTypeArenaScalarKind(nameTokenText)
    if parserKind == parser.ParserTypeSyntaxNominal &&
       scalarKind != TypedExprStructuralScalarInvalid:
        # [builtin-ctor] A built-in type constructor has no nominal
        # declaration, so its ONLY legal position is the base of a bracket
        # application.  A bare spelling (`typedesc`, `set`) is not an
        # arity-0 scalar: it fails loudly here instead of degrading into
        # one.  This is a deliberate divergence from the cold chain, which
        # also accepts a bare builtin name as a SCALAR node.
        if typedExprTypeArenaBuiltinConstructorArity(scalarKind) > 0:
            let builtinCtorParent =
                state.typeSyntaxParentNodeIndexes[typeSyntaxNodeIndex]
            if builtinCtorParent < 0 ||
               builtinCtorParent >= state.typeSyntaxCount ||
               typedExprTypeArenaSyntaxKindAt(localOut, builtinCtorParent) !=
                   parser.ParserTypeSyntaxBracketApply ||
               typedExprTypeArenaSyntaxChildAt(
                   localOut, builtinCtorParent, 0) != typeSyntaxNodeIndex:
                err = Fmt" typed expr type arena: builtin type constructor requires a bracket application head row={typeSyntaxNodeIndex} scalar_kind={Int32(scalarKind)}"
                return false
        var children: int32[]
        var childNames: int32[]
        return typedExprTypeArenaIntern(
            state, localOut, typeSyntaxNodeIndex,
            TypedExprStructuralTypeScalar,
            scalarKind, -1, -1, -1, -1,
            -1, -1,
            children, childNames, typeIdOut, err)
    let genericAuthorityRow = typedExprTypeArenaGenericAuthorityRow(
        state, typeSyntaxNodeIndex)
    if genericAuthorityRow >= 0:
        if readColumns:
            # [c2-replay-cols] A generic-parameter row is never enqueued: its
            # intern has no structural children and this arm returns before
            # either enqueue site, so its flag is always false and the column
            # replay can never reach it.  Fail closed instead of reading a tree
            # the replay no longer has.
            err = " typed expr type arena: generic parameter row reached column replay"
            return false
        let genericSymbolRow =
            state.authority.genericSymbolRows[genericAuthorityRow]
        if genericSymbolRow < 0 ||
           genericSymbolRow >= localOut.genericSymbolCount:
            err = " typed expr type arena: generic SymbolId authority invalid"
            return false
        let nameTokenFromSymbol = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.genericSymbolNameTokenIndexes,
            genericSymbolRow)
        let nameFromSymbolLocal = nameTokenFromSymbol - viewTokenRowBase
        var rootTypeSyntaxNodeIndex = typeSyntaxNodeIndex
        while state.typeSyntaxParentNodeIndexes[
                  rootTypeSyntaxNodeIndex] >= 0:
            rootTypeSyntaxNodeIndex =
                state.typeSyntaxParentNodeIndexes[
                    rootTypeSyntaxNodeIndex]
        let expectedOwnerToken =
            typedExprTypeArenaSyntaxDeclarationOwnerTokenAt(
                localOut, rootTypeSyntaxNodeIndex)
        if nameTokenFromSymbol < 0 ||
           nameTokenFromSymbol >= localOut.tokenCount ||
           nameFromSymbolLocal < 0 ||
           nameFromSymbolLocal >= state.tree.tokenCount ||
           arenamod.ArenaArrayInt32Get(
               localOut.arena,
               localOut.genericSymbolProducerSourceIndexes,
               genericSymbolRow) !=
               typedExprTypeArenaSyntaxProducerSourceIndexAt(
                   localOut, typeSyntaxNodeIndex) ||
           arenamod.ArenaArrayInt32Get(
               localOut.arena,
               localOut.genericSymbolDeclarationOwnerTokenIndexes,
               genericSymbolRow) != expectedOwnerToken ||
           nameTokenText !=
               parser.ParserValueExprTokenText(
                   state.tree, nameFromSymbolLocal):
            err = " typed expr type arena: exact generic owner edge mismatch"
            return false
        var children: int32[]
        var childNames: int32[]
        if !typedExprTypeArenaIntern(
               state,
               localOut,
               typeSyntaxNodeIndex,
               TypedExprStructuralTypeGenericParameter,
               TypedExprStructuralScalarInvalid,
               -1,
               genericSymbolRow,
               -1,
               -1,
               -1,
               -1,
               children,
               childNames,
               typeIdOut,
               err):
            return false
        var genericAuthorityUsed = state.genericAuthorityUsed
        genericAuthorityUsed[genericAuthorityRow] = true
        state.genericAuthorityUsed = genericAuthorityUsed
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.genericResolutionTypeSyntaxNodeIndexes,
            typeSyntaxNodeIndex)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.genericResolutionTargetGenericSymbolRows,
            genericSymbolRow)
        localOut.genericResolutionCount =
            localOut.genericResolutionCount + 1
        return true
    let authorityRow = typedExprTypeArenaAuthorityRow(
        state, typeSyntaxNodeIndex)
    if authorityRow < 0:
        err = " typed expr type arena: nominal SymbolId authority missing"
        return false
    let declarationRoot =
        state.authority.declarationRootTypeSyntaxNodeIndexes[authorityRow]
    if declarationRoot < 0 || declarationRoot >= localOut.typeSyntaxCount:
        err = " typed expr type arena: nominal declaration root out of range"
        return false
    let symbolId = state.symbolByDeclarationRoot[declarationRoot]
    if symbolId < 0:
        err = " typed expr type arena: declaration SymbolId is not materialized"
        return false
    # [forward-receipt] The resolution receipt is recorded HERE, at this
    # row's append-phase visit position, and only here.  The column is a
    # canonical row-ordered receipt that
    # `typedExprTypeArenaAppendColumn` hashes in that order, so recording it
    # in the replay would append rows after the whole append run and break
    # the strictly ascending order `StrictValidateInto` asserts.  The
    # receipt needs only (row, target SymbolId), both exact already; the
    # TypeId -- the one value a forward edge does not have yet -- is what
    # stays deferred, so this does not weaken the deferral in any way.
    # A row reaches this function in the replay only if it reached it here
    # first: a `Nominal` row has no structural children (parser appends it
    # with an empty child list) and a `Qualified` row's children are the
    # `Nominal` path segments, which the row filter never enqueues.  The
    # replay therefore must not record a second time -- it proves the first
    # record happened instead, and fails closed if it did not.
    if !replayForward:
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.resolutionTypeSyntaxNodeIndexes,
            typeSyntaxNodeIndex)
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.resolutionTargetSymbolIds, symbolId)
        localOut.resolutionCount = localOut.resolutionCount + 1
        state.resolutionReceiptRecorded[typeSyntaxNodeIndex] = true
    elif !state.resolutionReceiptRecorded[typeSyntaxNodeIndex]:
        err = Fmt" typed expr type arena: forward replay row has no append-phase resolution receipt row={typeSyntaxNodeIndex} declaration_root={declarationRoot}"
        return false
    # [forward-typeid] The declaration root is a GLOBAL row and may belong to a
    # source the production pass has not appended yet, so its per-row columns
    # are not materialised.  That is the DEFINITION of a forward edge, not an
    # error: the row is deferred to the replay pass, which runs once every
    # source is appended and every declaration root has its TypeId.  The
    # `SymbolId` check above is what keeps this fail-closed -- a root that is
    # not in the sealed SymbolId space is an unresolvable name, never a forward
    # edge, and is reported there instead of being queued forever.
    if declarationRoot >=
           localOut.typeSyntaxDeclarationOwnerTokenIndexes.len:
        state.forwardNominalRoot = declarationRoot
        typeIdOut = -1
        return true
    let targetOwnerToken =
        typedExprTypeArenaSyntaxDeclarationOwnerTokenAt(
            localOut, declarationRoot)
    if targetOwnerToken < 0 || targetOwnerToken >= localOut.tokenCount ||
       nameTokenText !=
           typedExprTypeArenaSyntaxDeclarationOwnerTokenTextAt(
               localOut, declarationRoot):
        err = " typed expr type arena: exact nominal edge token mismatch"
        return false
    # [forward-typeid] A declaration root inside the appended range can still
    # have no TypeId: its own mint was deferred because one of ITS children is
    # a forward edge, and `blockedFlags` is the row-space bitmap that records
    # exactly that.  Such an edge is deferred like any other forward edge
    # instead of failing here; the replay pass, which runs after every source
    # is appended, re-resolves it and is the place that fails closed if the row
    # is still unresolved then.
    # The guard is merge-only: a row may be enqueued exactly once
    # (`typedExprTypeArenaForwardNominalEnqueueInto` fails a second enqueue on
    # purpose), and the replay pass walks the queue in ascending order, so a
    # target that is still blocked there is a genuine ordering defect and must
    # keep failing closed rather than re-enqueue.
    if declarationRoot < state.forwardNominal.blockedFlags.len &&
       state.forwardNominal.blockedFlags[declarationRoot]:
        if replayForward:
            # [forward-replay-fixpoint] The target's own mint is deferred, so
            # this row cannot be bound in this pass: skip it, keep its flag and
            # let the driver re-walk once the target is bound.  `-1` in
            # `typeIdOut` plus the skip flag is the whole signal; no second
            # enqueue happens.
            state.forwardReplaySkipped = true
            typeIdOut = -1
            return true
        state.forwardNominalRoot = declarationRoot
        typeIdOut = -1
        return true
    let targetTypeId = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.typeSyntaxTypeIds, declarationRoot)
    if targetTypeId < 0 || targetTypeId >= localOut.typeCount:
        err = " typed expr type arena: declaration TypeId is unavailable"
        return false
    var authorityUsed = state.authorityUsed
    authorityUsed[authorityRow] = true
    state.authorityUsed = authorityUsed
    typeIdOut = targetTypeId
    return true

@borrows
fn typedExprTypeArenaBracketConstLength(
        tree: parser.ParserValueExprTree,
        typeSyntaxNodeIndex: int32,
        valueOut: var int32): bool =
    valueOut = 0
    if parser.ParserValueExprTypeSyntaxBracketArgCountAt(
           tree, typeSyntaxNodeIndex) != 1:
        return false
    if parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
           tree, typeSyntaxNodeIndex, 0) >= 0:
        return false
    let constRoot =
        parser.ParserValueExprTypeSyntaxBracketArgConstExprRootAt(
            tree, typeSyntaxNodeIndex, 0)
    var constErr: str
    if !parser.ParserValueExprTypeConstExprEvaluateInto(
           tree, constRoot, valueOut, constErr) || valueOut <= 0:
        return false
    return true

# [S1b step-3 (6)] Bracket fixed-array length, evaluated once while the source
# tree is still resident.  `typedExprTypeArenaBracketConstLength` runs the
# parser const evaluator over the tree, which the seal-phase Preflight cannot
# do; the verdict is therefore stored at the GLOBAL row.  `-1` is exactly the
# "not a bounded positive const bracket" verdict the boolean false carried.
@borrows
fn typedExprTypeArenaMaterializeBracketConstLengths(
        tree: parser.ParserValueExprTree,
        state: var TypedExprTypeArenaBuildState,
        viewTypeSyntaxBase: int32,
        err: var str): bool =
    if tree == nil || viewTypeSyntaxBase < 0 ||
       viewTypeSyntaxBase + tree.typeSyntaxCount > state.typeSyntaxCount ||
       state.bracketConstLengths.len != state.typeSyntaxCount:
        err = Fmt" typed expr type arena: bracket const view invalid base={viewTypeSyntaxBase} rows={tree == nil ? -1 : tree.typeSyntaxCount} total={state.typeSyntaxCount}"
        return false
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) !=
               parser.ParserTypeSyntaxBracketApply:
            continue
        var fixedLength: int32
        if typedExprTypeArenaBracketConstLength(tree, row, fixedLength):
            state.bracketConstLengths[viewTypeSyntaxBase + row] = fixedLength
    err = ""
    return true

# [builtin-ctor] Builtin type constructor verdict for one bracket
# application, taken once while the source tree is still resident.  The
# base's spelling is read from the parser-owned token table (never from
# arena text or from a rebuilt name), mapped through the closed scalar
# table and then through the closed constructor table, and the verdict is
# stored at the GLOBAL row.  A base that is not a `Nominal` -- a qualified
# path, a sequence, a tuple, ... -- records nothing and keeps the previous
# byte-for-byte path in the preflight.
@borrows
fn typedExprTypeArenaMaterializeBuiltinConstructorArities(
        tree: parser.ParserValueExprTree,
        state: var TypedExprTypeArenaBuildState,
        viewTypeSyntaxBase: int32,
        err: var str): bool =
    if tree == nil || viewTypeSyntaxBase < 0 ||
       viewTypeSyntaxBase + tree.typeSyntaxCount > state.typeSyntaxCount ||
       state.builtinConstructorArities.len != state.typeSyntaxCount:
        err = Fmt" typed expr type arena: builtin constructor view invalid base={viewTypeSyntaxBase} rows={tree == nil ? -1 : tree.typeSyntaxCount} total={state.typeSyntaxCount}"
        return false
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) !=
               parser.ParserTypeSyntaxBracketApply:
            continue
        if parser.ParserValueExprTypeSyntaxChildCountAt(tree, row) <= 0:
            continue
        let headRow = parser.ParserValueExprTypeSyntaxChildAt(tree, row, 0)
        if headRow < 0 ||
           parser.ParserValueExprTypeSyntaxKindAt(tree, headRow) !=
               parser.ParserTypeSyntaxNominal:
            continue
        let headNameToken =
            parser.ParserValueExprTypeSyntaxNameTokenAt(tree, headRow)
        if headNameToken < 0 || headNameToken >= tree.tokenCount:
            continue
        let headName = parser.ParserValueExprTokenText(tree, headNameToken)
        let headArity = typedExprTypeArenaBuiltinConstructorArity(
            typedExprTypeArenaScalarKind(headName))
        if headArity > 0:
            state.builtinConstructorArities[viewTypeSyntaxBase + row] =
                headArity
    err = ""
    return true

# [S1b step-3 (6)] Seal-phase Preflight, driven entirely from arena columns.
# The authority's `declarationRoot` is a GLOBAL row and may belong to an
# earlier source, whose tree is already released; the generic-symbol
# start/count and the enum/child CSR therefore come from the columns the append
# phase materialised at that same global row.  The whole-forest driver reads
# the identical values, because FillTypeSyntax wrote them from that forest.
@borrows
fn typedExprTypeArenaPreflightBracketAuthority(
        state: TypedExprTypeArenaBuildState,
        value: TypedExprTypeArena,
        viewTypeSyntaxBase: int32,
        viewTypeSyntaxCount: int32,
        err: var str): bool =
    # [S1b step-3 (8)] Per-source slice of the whole-forest preflight.  The
    # destination columns hold only the rows materialised so far, so the
    # whole-forest bound `state.typeSyntaxCount` -- the final total -- walks
    # past `value.typeSyntaxParserKinds.len` as soon as the first source is
    # appended (measured on the two-source fixture: capacity=7, len=3, row=3).
    # A TypeSyntax row is written once, by the source that owns it, so N
    # passing slices are the same statement as one whole-forest pass; the
    # length check below pins this source's global interval to the rows its
    # own fill produced.
    if state.bracketConstLengths.len != state.typeSyntaxCount ||
       state.builtinConstructorArities.len != state.typeSyntaxCount ||
       value.typeSyntaxCount != state.typeSyntaxCount ||
       viewTypeSyntaxBase < 0 || viewTypeSyntaxCount < 0 ||
       viewTypeSyntaxBase + viewTypeSyntaxCount > state.typeSyntaxCount ||
       value.typeSyntaxParserKinds.len !=
           viewTypeSyntaxBase + viewTypeSyntaxCount:
        err = Fmt" typed expr type arena: bracket preflight view invalid base={viewTypeSyntaxBase} rows={viewTypeSyntaxCount} materialised={value.typeSyntaxParserKinds.len} total={state.typeSyntaxCount}"
        return false
    let viewTypeSyntaxEnd = viewTypeSyntaxBase + viewTypeSyntaxCount
    for typeSyntaxNodeIndex in viewTypeSyntaxBase..<viewTypeSyntaxEnd:
        if typedExprTypeArenaSyntaxKindAt(value, typeSyntaxNodeIndex) !=
               parser.ParserTypeSyntaxBracketApply:
            continue
        if typedExprTypeArenaSyntaxChildCountAt(
               value, typeSyntaxNodeIndex) <= 0:
            err = " typed expr type arena: bracket base TypeSyntax missing"
            return false
        let baseTypeSyntaxNode = typedExprTypeArenaSyntaxChildAt(
            value, typeSyntaxNodeIndex, 0)
        let authorityRow = typedExprTypeArenaAuthorityRow(
            state, baseTypeSyntaxNode)
        var genericCount: int32
        var genericStart: int32 = -1
        if authorityRow >= 0 &&
           (typedExprTypeArenaSyntaxKindAt(value, baseTypeSyntaxNode) ==
                parser.ParserTypeSyntaxNominal ||
            typedExprTypeArenaSyntaxKindAt(value, baseTypeSyntaxNode) ==
                parser.ParserTypeSyntaxQualified):
            let declarationRoot =
                state.authority.declarationRootTypeSyntaxNodeIndexes[
                    authorityRow]
            # [forward-decl] The declaration root is a GLOBAL row and may belong
            # to a source the production pass has not appended yet, so its
            # per-row arena columns hold the materialised prefix only.  The
            # sealed index's generic window is the complete authority, so the
            # prefix-column read and its OOB guard are both gone.
            if !typedExprTypeArenaDeclarationGenericWindowAt(
                   state, declarationRoot, genericStart, genericCount, err):
                err = Fmt" typed expr type arena: bracket preflight declaration window failed bracket_row={typeSyntaxNodeIndex} base_row={baseTypeSyntaxNode} authority_row={authorityRow} view_base={viewTypeSyntaxBase} view_rows={viewTypeSyntaxCount}: {err}"
                return false
        let argCount = typedExprTypeArenaSyntaxBracketArgCountAt(
            value, typeSyntaxNodeIndex)
        if genericCount > 0:
            if argCount <= 0 || argCount > genericCount ||
               typedExprTypeArenaSyntaxChildCountAt(
                   value, typeSyntaxNodeIndex) != argCount + 1:
                err = " typed expr type arena: generic application arity authority mismatch"
                return false
            for argOffset in 0..<argCount:
                let argTypeSyntaxNode =
                    typedExprTypeArenaSyntaxBracketArgTypeNodeAt(
                        value, typeSyntaxNodeIndex, argOffset)
                if argTypeSyntaxNode < 0 ||
                   typedExprTypeArenaSyntaxChildAt(
                       value, typeSyntaxNodeIndex, argOffset + 1) !=
                       argTypeSyntaxNode:
                    err = " typed expr type arena: generic argument TypeSyntax CSR incomplete"
                    return false
            for genericOffset in argCount..<genericCount:
                # [forward-decl] `genericSymbolDefaultTypeSyntaxNodeIndexes`
                # is a per-source prefix column; a default owned by a source
                # the production pass has not appended is not materialised.
                # Fail closed with the row instead of panicking without it.
                if genericStart + genericOffset >=
                       value.genericSymbolDefaultTypeSyntaxNodeIndexes.len:
                    err = Fmt" typed expr type arena: generic default is not materialised bracket_row={typeSyntaxNodeIndex} base_row={baseTypeSyntaxNode} authority_row={authorityRow} generic_symbol_row={genericStart + genericOffset} materialised={value.genericSymbolDefaultTypeSyntaxNodeIndexes.len} total={value.genericSymbolCount}"
                    return false
                if genericStart < 0 ||
                   typedExprTypeArenaGenericSymbolDefaultTypeNodeAt(
                       value, genericStart + genericOffset) < 0:
                    err = " typed expr type arena: generic application arity authority mismatch; trailing default missing"
                    return false
        else:
            # [builtin-ctor] A bracket application whose base is a builtin
            # type constructor has no declaration authority and therefore no
            # generic window: the arity is the closed table's, recorded at
            # this global row by the append phase.  It is checked here, not
            # waved through: a wrong argument count and a non-type argument
            # both hard-fail.  Everything outside this shape keeps the
            # bounded-const-array requirement below, unchanged.
            let builtinArity =
                state.builtinConstructorArities[typeSyntaxNodeIndex]
            if builtinArity > 0:
                if argCount != builtinArity ||
                   typedExprTypeArenaSyntaxChildCountAt(
                       value, typeSyntaxNodeIndex) != argCount + 1:
                    err = Fmt" typed expr type arena: builtin type constructor arity mismatch row={typeSyntaxNodeIndex} expected_args={builtinArity} actual_args={argCount}"
                    return false
                for argOffset in 0..<argCount:
                    let argTypeSyntaxNode =
                        typedExprTypeArenaSyntaxBracketArgTypeNodeAt(
                            value, typeSyntaxNodeIndex, argOffset)
                    if argTypeSyntaxNode < 0 ||
                       typedExprTypeArenaSyntaxChildAt(
                           value, typeSyntaxNodeIndex, argOffset + 1) !=
                           argTypeSyntaxNode:
                        err = " typed expr type arena: builtin constructor argument TypeSyntax CSR incomplete"
                        return false
            elif state.bracketConstLengths[typeSyntaxNodeIndex] <= 0:
                err = " typed expr type arena: bracket apply authority incomplete; exact generic SymbolId or bounded const AST required"
                return false
    return true

@borrows
fn typedExprTypeArenaBuildObjectDeclaration(
        state: TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        declarationRoot: int32,
        symbolId: int32,
        typeIdOut: var int32,
        err: var str): bool =
    typeIdOut = -1
    # [S1b-1c] Seal-phase read #5 (BuildObjectDeclaration).  Every parser fact
    # below is read from the arena column the append phase materialised at the
    # same global row; the name text still enters `internPool` at this exact
    # call site and in this exact order, so the pool sequence is unchanged.
    let parserKind = typedExprTypeArenaSyntaxKindAt(localOut, declarationRoot)
    var structuralKind = TypedExprStructuralTypeInvalid
    if parserKind == parser.ParserTypeSyntaxObject ||
       parserKind == parser.ParserTypeSyntaxImplicitObject:
        structuralKind = TypedExprStructuralTypeObject
    elif parserKind == parser.ParserTypeSyntaxRefObject:
        structuralKind = TypedExprStructuralTypeRefObject
    else:
        err = " typed expr type arena: object declaration kind invalid"
        return false
    let parserBaseCount =
        typedExprTypeArenaSyntaxChildCountAt(localOut, declarationRoot)
    if parserBaseCount < 0 || parserBaseCount > 1 ||
       (parserKind == parser.ParserTypeSyntaxImplicitObject &&
        parserBaseCount != 0):
        err = " typed expr type arena: object base edge cardinality invalid"
        return false
    var baseTypeSyntaxNodeIndex: int32 = -1
    if parserBaseCount == 1:
        baseTypeSyntaxNodeIndex =
            typedExprTypeArenaSyntaxChildAt(localOut, declarationRoot, 0)
        if baseTypeSyntaxNodeIndex < 0 ||
           baseTypeSyntaxNodeIndex >= declarationRoot ||
           typedExprTypeArenaSyntaxProducerSourceIndexAt(
               localOut, baseTypeSyntaxNodeIndex) !=
               typedExprTypeArenaSyntaxProducerSourceIndexAt(
                   localOut, declarationRoot):
            err = " typed expr type arena: object base TypeSyntax edge invalid"
            return false
    let fieldStart = state.fieldStartsByDeclarationRoot[declarationRoot]
    let fieldCount = state.fieldCountsByDeclarationRoot[declarationRoot]
    if fieldCount < 0 ||
       (fieldCount == 0 && fieldStart != -1) ||
       (fieldCount > 0 &&
        (fieldStart < 0 || fieldStart + fieldCount >
            state.fieldTypeSyntaxNodeIndexes.len)):
        err = " typed expr type arena: object field CSR invalid"
        return false
    var children: int32[]
    var childNames: int32[]
    var nameSlots: int32[]
    var slotCount: int32 = 8
    while slotCount < fieldCount * 2:
        slotCount = slotCount * 2
    setLen(nameSlots, slotCount)
    for slot in 0..<nameSlots.len:
        nameSlots[slot] = -1
    for fieldOrdinal in 0..<fieldCount:
        let fieldTypeSyntaxNode =
            state.fieldTypeSyntaxNodeIndexes[fieldStart + fieldOrdinal]
        if fieldTypeSyntaxNode < 0 ||
           fieldTypeSyntaxNode >= localOut.typeSyntaxCount:
            err = " typed expr type arena: object field TypeSyntax invalid"
            return false
        let fieldNameToken = typedExprTypeArenaSyntaxOwnerTokenAt(
            localOut, fieldTypeSyntaxNode)
        let fieldTypeId = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.typeSyntaxTypeIds,
            fieldTypeSyntaxNode)
        # [name-domain] The name domain is the parser's, not a local keyword
        # guess: `ParserValueExprTokenCanName` admits `block`/`object` as
        # contextual identifiers, and the parser creates this very field
        # root under that same predicate.
        if fieldTypeId < 0 || fieldTypeId >= localOut.typeCount ||
           typedExprTypeArenaSyntaxDeclarationOwnerAt(
               localOut, fieldTypeSyntaxNode) != declarationRoot ||
           typedExprTypeArenaSyntaxProducerSourceIndexAt(
               localOut, fieldTypeSyntaxNode) !=
               typedExprTypeArenaSyntaxProducerSourceIndexAt(
                   localOut, declarationRoot) ||
           fieldNameToken < 0 || fieldNameToken >= localOut.tokenCount ||
           !parser.ParserValueExprTokenCanName(
               typedExprTypeArenaTokenKindAt(
                   localOut, fieldNameToken)):
            err = " typed expr type arena: object field authority invalid"
            return false
        let fieldNameId = langintern.Intern(
            localOut.internPool,
            strings.CloneStr(
                typedExprTypeArenaSyntaxOwnerTokenTextAt(
                    localOut, fieldTypeSyntaxNode)))
        var slot = fieldNameId % nameSlots.len
        while nameSlots[slot] >= 0 && nameSlots[slot] != fieldNameId:
            slot = (slot + 1) % nameSlots.len
        if nameSlots[slot] == fieldNameId:
            err = " typed expr type arena: duplicate object field name"
            return false
        nameSlots[slot] = fieldNameId
        add(children, fieldTypeId)
        add(childNames, fieldNameId)
    let reservedTypeId = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.typeSyntaxTypeIds, declarationRoot)
    if reservedTypeId < 0 || reservedTypeId >= localOut.typeCount ||
       arenamod.ArenaArrayInt32Get(
           localOut.arena, localOut.typeKinds, reservedTypeId) !=
           Int32(structuralKind) ||
       arenamod.ArenaArrayInt32Get(
           localOut.arena, localOut.symbolIds, reservedTypeId) != symbolId ||
       arenamod.ArenaArrayInt32Get(
           localOut.arena, localOut.childCounts, reservedTypeId) !=
           children.len:
        err = " typed expr type arena: object reservation drift"
        return false
    let reservedChildStart = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.childStarts, reservedTypeId)
    let reservedPremiseStart = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.traitPremiseStarts, reservedTypeId)
    arenamod.ArenaArrayInt32Set(
        localOut.arena,
        localOut.baseTypeSyntaxNodeIndexes,
        reservedTypeId,
        baseTypeSyntaxNodeIndex)
    for childOffset in 0..<children.len:
        arenamod.ArenaArrayInt32Set(
            localOut.arena,
            localOut.childTypeIds,
            reservedChildStart + childOffset,
            children[childOffset])
        arenamod.ArenaArrayInt32Set(
            localOut.arena,
            localOut.childNameIds,
            reservedChildStart + childOffset,
            childNames[childOffset])
        arenamod.ArenaArrayInt32Set(
            localOut.arena,
            localOut.traitPremiseTypeIds,
            reservedPremiseStart + parserBaseCount + childOffset,
            children[childOffset])
    typeIdOut = reservedTypeId
    let memberStart = localOut.memberCount
    arenamod.ArenaArrayInt32Set(
        localOut.arena,
        localOut.symbolMemberStarts,
        symbolId,
        memberStart)
    arenamod.ArenaArrayInt32Set(
        localOut.arena,
        localOut.symbolMemberCounts,
        symbolId,
        fieldCount)
    for fieldOrdinal in 0..<fieldCount:
        let fieldTypeSyntaxNode =
            state.fieldTypeSyntaxNodeIndexes[fieldStart + fieldOrdinal]
        let fieldNameToken = typedExprTypeArenaSyntaxOwnerTokenAt(
            localOut, fieldTypeSyntaxNode)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberProducerSourceIndexes,
            typedExprTypeArenaSyntaxProducerSourceIndexAt(
                localOut, fieldTypeSyntaxNode))
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberDeclarationSymbolIds,
            symbolId)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberNameTokenIndexes,
            fieldNameToken)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberNameIds,
            childNames[fieldOrdinal])
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberOrdinals,
            fieldOrdinal)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberTypeSyntaxNodeIndexes,
            fieldTypeSyntaxNode)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberTypeIds,
            children[fieldOrdinal])
        localOut.memberCount = localOut.memberCount + 1
    return true

# [phaseB-parser] `type N = tuple[a: T, ...]` 具名元素的 member 行构建：
# 与 object 声明完全同一 member 行契约（producer/symbol/nameToken/nameId/
# ordinal/fieldRoot TypeSyntax/fieldTypeId），使 compiler csg 的 exact-field
# 坐标互证（compilerCsgExactFieldTypeIdInto）在 alias-tuple 声明上可解析
# owner symbol member。字段数据全部来自 parser FieldDeclaration root 的
# 精确声明边（ParserValueExprAppendInlineTupleFieldDeclarations 产出），
# 与 ctx.typeFields 的 exact 坐标绑定一一对应；普通别名（不含字段声明
# root）零改动。
@borrows
fn typedExprTypeArenaBuildTupleAliasMembers(
        state: TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        declarationRoot: int32,
        symbolId: int32,
        err: var str): bool =
    let fieldCount = state.fieldCountsByDeclarationRoot[declarationRoot]
    if fieldCount <= 0:
        err = ""
        return true
    # [S1b-1c] Seal-phase read #6 (BuildTupleAliasMembers): same arena columns,
    # same global rows, same in-place `Intern` call site as before.
    if typedExprTypeArenaSyntaxKindAt(localOut, declarationRoot) !=
           parser.ParserTypeSyntaxAlias ||
       typedExprTypeArenaSyntaxChildCountAt(localOut, declarationRoot) != 1 ||
       typedExprTypeArenaSyntaxKindAt(
           localOut,
           typedExprTypeArenaSyntaxChildAt(
               localOut, declarationRoot, 0)) !=
           parser.ParserTypeSyntaxTuple:
        err = " typed expr type arena: alias declaration owns fields without tuple authority"
        return false
    let fieldStart = state.fieldStartsByDeclarationRoot[declarationRoot]
    if fieldStart < 0 ||
       fieldStart + fieldCount >
           state.fieldTypeSyntaxNodeIndexes.len:
        err = " typed expr type arena: tuple alias field CSR invalid"
        return false
    let memberStart = localOut.memberCount
    arenamod.ArenaArrayInt32Set(
        localOut.arena,
        localOut.symbolMemberStarts,
        symbolId,
        memberStart)
    arenamod.ArenaArrayInt32Set(
        localOut.arena,
        localOut.symbolMemberCounts,
        symbolId,
        fieldCount)
    var nameSlotCount: int32 = 8
    while nameSlotCount < fieldCount * 2:
        nameSlotCount = nameSlotCount * 2
    var nameSlots: int32[]
    setLen(nameSlots, nameSlotCount)
    for slot in 0..<nameSlots.len:
        nameSlots[slot] = -1
    for fieldOrdinal in 0..<fieldCount:
        let fieldTypeSyntaxNode =
            state.fieldTypeSyntaxNodeIndexes[fieldStart + fieldOrdinal]
        if fieldTypeSyntaxNode < 0 ||
           fieldTypeSyntaxNode >= localOut.typeSyntaxCount:
            err = " typed expr type arena: tuple alias field TypeSyntax invalid"
            return false
        let fieldNameToken = typedExprTypeArenaSyntaxOwnerTokenAt(
            localOut, fieldTypeSyntaxNode)
        let fieldTypeId = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.typeSyntaxTypeIds,
            fieldTypeSyntaxNode)
        # [name-domain] Same name authority as the object-field arm above;
        # an inline tuple element is created by the parser under
        # `ParserValueExprTokenCanName` and must be admitted here too.
        if fieldTypeId < 0 || fieldTypeId >= localOut.typeCount ||
           typedExprTypeArenaSyntaxDeclarationOwnerAt(
               localOut, fieldTypeSyntaxNode) != declarationRoot ||
           typedExprTypeArenaSyntaxProducerSourceIndexAt(
               localOut, fieldTypeSyntaxNode) !=
               typedExprTypeArenaSyntaxProducerSourceIndexAt(
                   localOut, declarationRoot) ||
           fieldNameToken < 0 || fieldNameToken >= localOut.tokenCount ||
           !parser.ParserValueExprTokenCanName(
               typedExprTypeArenaTokenKindAt(
                   localOut, fieldNameToken)):
            err = " typed expr type arena: tuple alias field authority invalid"
            return false
        let fieldNameId = langintern.Intern(
            localOut.internPool,
            strings.CloneStr(
                typedExprTypeArenaSyntaxOwnerTokenTextAt(
                    localOut, fieldTypeSyntaxNode)))
        var slot = fieldNameId % nameSlots.len
        while nameSlots[slot] >= 0 && nameSlots[slot] != fieldNameId:
            slot = (slot + 1) % nameSlots.len
        if nameSlots[slot] == fieldNameId:
            err = " typed expr type arena: duplicate tuple alias field name"
            return false
        nameSlots[slot] = fieldNameId
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberProducerSourceIndexes,
            typedExprTypeArenaSyntaxProducerSourceIndexAt(
                localOut, fieldTypeSyntaxNode))
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberDeclarationSymbolIds,
            symbolId)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberNameTokenIndexes,
            fieldNameToken)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberNameIds,
            fieldNameId)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberOrdinals,
            fieldOrdinal)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberTypeSyntaxNodeIndexes,
            fieldTypeSyntaxNode)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberTypeIds,
            fieldTypeId)
        localOut.memberCount = localOut.memberCount + 1
    err = ""
    return true

@borrows
fn typedExprTypeArenaBuildEnumDeclaration(
        state: TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        declarationRoot: int32,
        symbolId: int32,
        typeIdOut: var int32,
        err: var str): bool =
    typeIdOut = -1
    # [S1b-1c] Seal-phase read #7 (BuildEnumDeclaration): variant CSR, variant
    # owner facts and the variant name token all come from the arena columns;
    # the name text still reaches `internPool` at this exact call site.
    if typedExprTypeArenaSyntaxKindAt(localOut, declarationRoot) !=
           parser.ParserTypeSyntaxEnum ||
       typedExprTypeArenaSyntaxRootKindAt(localOut, declarationRoot) !=
           parser.ParserTypeSyntaxRootTypeDeclarationRhs ||
       typedExprTypeArenaSyntaxDeclarationOwnerAt(
           localOut, declarationRoot) != declarationRoot:
        err = " typed expr type arena: enum declaration authority invalid"
        return false
    let variantCount = typedExprTypeArenaSyntaxEnumVariantCountAt(
        localOut, declarationRoot)
    if variantCount <= 0:
        err = " typed expr type arena: enum variant authority missing"
        return false
    let producerSourceIndex =
        typedExprTypeArenaSyntaxProducerSourceIndexAt(
            localOut, declarationRoot)
    let declarationOwnerToken =
        typedExprTypeArenaSyntaxDeclarationOwnerTokenAt(
            localOut, declarationRoot)
    var children: int32[]
    var childNames: int32[]
    var variantNameIds: int32[]
    var variantPayloadTypeSyntaxNodes: int32[]
    var variantPayloadTypeIds: int32[]
    var nameSlots: int32[]
    var slotCount: int32 = 8
    while slotCount < variantCount * 2:
        slotCount = slotCount * 2
    setLen(nameSlots, slotCount)
    for slot in 0..<nameSlots.len:
        nameSlots[slot] = -1
    var previousNameToken: int32 = -1
    for variantOffset in 0..<variantCount:
        let variantRow = typedExprTypeArenaSyntaxEnumVariantRowAt(
            localOut, declarationRoot, variantOffset)
        let variantProducerSource =
            typedExprTypeArenaEnumVariantProducerSourceIndexAt(
                localOut, variantRow)
        let variantOwner = typedExprTypeArenaEnumVariantDeclarationOwnerAt(
            localOut, variantRow)
        let variantOwnerToken =
            typedExprTypeArenaEnumVariantDeclarationOwnerTokenAt(
                localOut, variantRow)
        let variantNameToken = typedExprTypeArenaEnumVariantNameTokenAt(
            localOut, variantRow)
        let variantOrdinal = typedExprTypeArenaEnumVariantOrdinalAt(
            localOut, variantRow)
        let payloadTypeSyntaxNode =
            typedExprTypeArenaEnumVariantPayloadTypeNodeAt(
                localOut, variantRow)
        # [name-domain] The parser admits a variant name through
        # `ParserValueExprTokenCanName` (its own variant validators use that
        # predicate); this arm must not carry a stricter local guess.
        if variantProducerSource != producerSourceIndex ||
           variantOwner != declarationRoot ||
           variantOwnerToken != declarationOwnerToken ||
           variantNameToken < 0 ||
           variantNameToken >= localOut.tokenCount ||
           variantNameToken <= previousNameToken ||
           !parser.ParserValueExprTokenCanName(
               typedExprTypeArenaTokenKindAt(
                   localOut, variantNameToken)) ||
           variantOrdinal != variantOffset || payloadTypeSyntaxNode < -1 ||
           payloadTypeSyntaxNode >= localOut.typeSyntaxCount:
            err = " typed expr type arena: enum variant authority invalid"
            return false
        let variantNameId = langintern.Intern(
            localOut.internPool,
            strings.CloneStr(
                typedExprTypeArenaEnumVariantNameTokenTextAt(
                    localOut, variantRow)))
        var slot = variantNameId % nameSlots.len
        while nameSlots[slot] >= 0 && nameSlots[slot] != variantNameId:
            slot = (slot + 1) % nameSlots.len
        if nameSlots[slot] == variantNameId:
            err = " typed expr type arena: duplicate enum variant name"
            return false
        nameSlots[slot] = variantNameId
        var payloadTypeId: int32 = -1
        if payloadTypeSyntaxNode >= 0:
            payloadTypeId = arenamod.ArenaArrayInt32Get(
                localOut.arena,
                localOut.typeSyntaxTypeIds,
                payloadTypeSyntaxNode)
            if payloadTypeId < 0 || payloadTypeId >= localOut.typeCount ||
               typedExprTypeArenaSyntaxProducerSourceIndexAt(
                   localOut, payloadTypeSyntaxNode) != producerSourceIndex ||
               typedExprTypeArenaSyntaxRootKindAt(
                   localOut, payloadTypeSyntaxNode) !=
                   parser.ParserTypeSyntaxRootInvalid ||
               typedExprTypeArenaSyntaxDeclarationOwnerAt(
                   localOut, payloadTypeSyntaxNode) != -1 ||
               typedExprTypeArenaSyntaxDeclarationOwnerTokenAt(
                   localOut, payloadTypeSyntaxNode) != -1 ||
               typedExprTypeArenaSyntaxOwnerTokenAt(
                   localOut, payloadTypeSyntaxNode) != variantNameToken:
                err = " typed expr type arena: enum payload authority invalid"
                return false
            add(children, payloadTypeId)
            add(childNames, variantNameId)
        add(variantNameIds, variantNameId)
        add(variantPayloadTypeSyntaxNodes, payloadTypeSyntaxNode)
        add(variantPayloadTypeIds, payloadTypeId)
        previousNameToken = variantNameToken
    let reservedTypeId = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.typeSyntaxTypeIds, declarationRoot)
    if reservedTypeId < 0 || reservedTypeId >= localOut.typeCount ||
       arenamod.ArenaArrayInt32Get(
           localOut.arena, localOut.typeKinds, reservedTypeId) !=
           Int32(TypedExprStructuralTypeEnum) ||
       arenamod.ArenaArrayInt32Get(
           localOut.arena, localOut.symbolIds, reservedTypeId) != symbolId ||
       arenamod.ArenaArrayInt32Get(
           localOut.arena, localOut.childCounts, reservedTypeId) !=
           children.len:
        err = " typed expr type arena: enum reservation drift"
        return false
    let reservedChildStart = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.childStarts, reservedTypeId)
    let reservedPremiseStart = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.traitPremiseStarts, reservedTypeId)
    for childOffset in 0..<children.len:
        arenamod.ArenaArrayInt32Set(
            localOut.arena,
            localOut.childTypeIds,
            reservedChildStart + childOffset,
            children[childOffset])
        arenamod.ArenaArrayInt32Set(
            localOut.arena,
            localOut.childNameIds,
            reservedChildStart + childOffset,
            childNames[childOffset])
        arenamod.ArenaArrayInt32Set(
            localOut.arena,
            localOut.traitPremiseTypeIds,
            reservedPremiseStart + childOffset,
            children[childOffset])
    typeIdOut = reservedTypeId
    let memberStart = localOut.memberCount
    arenamod.ArenaArrayInt32Set(
        localOut.arena,
        localOut.symbolMemberStarts,
        symbolId,
        memberStart)
    arenamod.ArenaArrayInt32Set(
        localOut.arena,
        localOut.symbolMemberCounts,
        symbolId,
        variantCount)
    for variantOffset in 0..<variantCount:
        let variantNameToken = typedExprTypeArenaEnumVariantNameTokenAt(
            localOut,
            typedExprTypeArenaSyntaxEnumVariantRowAt(
                localOut, declarationRoot, variantOffset))
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberProducerSourceIndexes,
            producerSourceIndex)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberDeclarationSymbolIds,
            symbolId)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberNameTokenIndexes,
            variantNameToken)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberNameIds,
            variantNameIds[variantOffset])
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberOrdinals,
            variantOffset)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberTypeSyntaxNodeIndexes,
            variantPayloadTypeSyntaxNodes[variantOffset])
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.memberTypeIds,
            variantPayloadTypeIds[variantOffset])
        localOut.memberCount = localOut.memberCount + 1
    return true

# [S1b step-3 (6)] The caller's row is GLOBAL; the whole walk below (spans,
# tokens, children) is source-local, so it runs in the tree's own coordinates.
# The whole-forest driver passes base 0 and the walk is the previous one.
@borrows
@borrows
fn typedExprTypeArenaFunctionParamCount(
        tree: parser.ParserValueExprTree,
        typeSyntaxNodeIndex: int32,
        viewTypeSyntaxBase: int32,
        children: int32[],
        countOut: var int32): bool =
    countOut = -1
    let treeRow = typeSyntaxNodeIndex - viewTypeSyntaxBase
    let spanStart = parser.ParserValueExprTypeSyntaxSpanStartAt(
        tree, treeRow)
    let spanEnd = parser.ParserValueExprTypeSyntaxSpanEndAt(
        tree, treeRow)
    let producerSourceIndex =
        parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
            tree, treeRow)
    var cursor: int32
    var openToken: int32 = -1
    var closeToken: int32 = -1
    var depth: int32
    while cursor < tree.tokenCount:
        if parser.ParserValueExprTokenProducerSourceIndexAt(
               tree, cursor) != producerSourceIndex ||
           parser.ParserValueExprTokenEndAt(tree, cursor) <= spanStart ||
           parser.ParserValueExprTokenStartAt(tree, cursor) >= spanEnd:
            cursor = cursor + 1
            continue
        let kind = parser.ParserValueExprTokenKindAt(tree, cursor)
        if kind == parser.ParserValueTokenLeftParen:
            if openToken < 0: openToken = cursor
            depth = depth + 1
        elif kind == parser.ParserValueTokenRightParen:
            depth = depth - 1
            if depth == 0 && openToken >= 0:
                closeToken = cursor
                break
            if depth < 0: return false
        cursor = cursor + 1
    if openToken < 0 || closeToken < 0: return false
    let childCount =
        parser.ParserValueExprTypeSyntaxChildCountAt(
            tree, treeRow)
    if childCount != children.len:
        return false
    var paramCount: int32
    for childIndex in 0..<childCount:
        let childNodeIndex =
            parser.ParserValueExprTypeSyntaxChildAt(
                tree, treeRow, childIndex)
        if parser.ParserValueExprTypeSyntaxSpanEndAt(
               tree, childNodeIndex) <=
               parser.ParserValueExprTokenStartAt(tree, closeToken):
            paramCount = paramCount + 1
    if childCount - paramCount > 1: return false
    if childCount > paramCount:
        let separator = closeToken + 1
        if separator >= tree.tokenCount ||
           parser.ParserValueExprTokenProducerSourceIndexAt(
               tree, separator) != producerSourceIndex ||
           (parser.ParserValueExprTokenKindAt(tree, separator) !=
                parser.ParserValueTokenColon &&
            parser.ParserValueExprTokenKindAt(tree, separator) !=
                parser.ParserValueTokenArrow) ||
           parser.ParserValueExprTypeSyntaxSpanStartAt(
               tree,
               parser.ParserValueExprTypeSyntaxChildAt(
                   tree, treeRow, childCount - 1)) <
               parser.ParserValueExprTokenEndAt(tree, separator):
            return false
    countOut = paramCount
    return true

# [S1b step-3 (6)] `childNodeIndex` is a GLOBAL row, the token walk is local.
@borrows
@borrows
fn typedExprTypeArenaTupleChildNameId(
        out: var TypedExprTypeArena,
        tree: parser.ParserValueExprTree,
        childNodeIndex: int32,
        viewTypeSyntaxBase: int32): int32 =
    let treeRow = childNodeIndex - viewTypeSyntaxBase
    let ownerToken = parser.ParserValueExprTypeSyntaxOwnerTokenAt(
        tree, treeRow)
    # [name-domain] Same authority as the three arms above.  `-1` here means
    # "element has no name", so a local `== Identifier` guess would silently
    # drop the name of an element the parser did create a field root for.
    if ownerToken < 0 || ownerToken + 1 >= tree.tokenCount ||
       !parser.ParserValueExprTokenCanName(
           parser.ParserValueExprTokenKindAt(tree, ownerToken)) ||
       parser.ParserValueExprTokenKindAt(tree, ownerToken + 1) !=
           parser.ParserValueTokenColon ||
       parser.ParserValueExprTokenEndAt(tree, ownerToken + 1) >
           parser.ParserValueExprTypeSyntaxSpanStartAt(tree, treeRow):
        return -1
    return langintern.Intern(
        out.internPool,
        strings.CloneStr(
            parser.ParserValueExprTokenText(tree, ownerToken)))

@borrows
fn typedExprTypeArenaParserAuthorityShape(
        tree: parser.ParserValueExprTree,
        err: var str): bool =
    if tree.typeGenericSymbolCount < 0 ||
       tree.typeGenericSymbolProducerSourceIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolDeclarationOwnerTokenIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolNameTokenIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolOrdinals.len != tree.typeGenericSymbolCount ||
       tree.typeSyntaxChildNodeIndexes.len != tree.typeSyntaxChildCount ||
       tree.typeSyntaxBracketArgTokenStarts.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgTokenCounts.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgTypeNodeIndexes.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgConstExprRootIndexes.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeEnumVariantCount < 0 ||
       tree.typeSyntaxEnumVariantStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxEnumVariantCounts.len != tree.typeSyntaxCount ||
       tree.typeEnumVariantProducerSourceIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantDeclarationOwnerNodeIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantDeclarationOwnerTokenIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantNameTokenIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantOrdinals.len != tree.typeEnumVariantCount ||
       tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes.len !=
           tree.typeEnumVariantCount:
        err = " typed expr type arena: parser authority column shape invalid"
        return false
    if !parser.ParserValueExprTreeTypeSyntaxBracketArgsStrictValidateInto(
           tree, err):
        return false
    if !parser.ParserValueExprTreeEnumVariantsStrictValidateInto(tree, err):
        return false
    if !parser.ParserValueExprTreeGenericSymbolsStrictValidateInto(
           tree, err):
        return false
    var childSeen: bool[]
    var enumPayloadSeen: bool[]
    setLen(childSeen, tree.typeSyntaxCount)
    setLen(enumPayloadSeen, tree.typeSyntaxCount)
    for variantRow in 0..<tree.typeEnumVariantCount:
        let payloadTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
            variantRow)
        if payloadTypeSyntaxNode >= 0:
            if payloadTypeSyntaxNode >= tree.typeSyntaxCount ||
               enumPayloadSeen[payloadTypeSyntaxNode]:
                err = " typed expr type arena: enum payload TypeSyntax coverage invalid"
                return false
            enumPayloadSeen[payloadTypeSyntaxNode] = true
    var childCursor: int32
    var bracketCursor: int32
    for row in 0..<tree.typeSyntaxCount:
        let producerSourceIndex =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, row)
        let spanStart = parser.ParserValueExprTypeSyntaxSpanStartAt(tree, row)
        let spanEnd = parser.ParserValueExprTypeSyntaxSpanEndAt(tree, row)
        let ownerToken = parser.ParserValueExprTypeSyntaxOwnerTokenAt(
            tree, row)
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeSyntaxChildStarts, row)
        let childCount = parser.ParserValueExprTypeSyntaxChildCountAt(
            tree, row)
        let bracketStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeSyntaxBracketArgStarts, row)
        let bracketCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeSyntaxBracketArgCounts, row)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           spanStart < 0 || spanEnd <= spanStart || ownerToken < 0 ||
           ownerToken >= tree.tokenCount || childStart != childCursor ||
           childCount < 0 || childStart + childCount >
               tree.typeSyntaxChildCount || bracketStart != bracketCursor ||
           bracketCount < 0 || bracketStart + bracketCount >
               tree.typeSyntaxBracketArgCount:
            err = " typed expr type arena: TypeSyntax authority row invalid"
            return false
        for childOffset in 0..<childCount:
            let child = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxChildNodeIndexes,
                childStart + childOffset)
            if child < 0 || child >= row || childSeen[child] ||
               enumPayloadSeen[child]:
                err = " typed expr type arena: TypeSyntax child authority invalid"
                return false
            childSeen[child] = true
        for argOffset in 0..<bracketCount:
            let argRow = bracketStart + argOffset
            let tokenStart = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxBracketArgTokenStarts,
                argRow)
            let tokenCount = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxBracketArgTokenCounts,
                argRow)
            if tokenStart < 0 || tokenCount <= 0 ||
               tokenStart + tokenCount > tree.tokenCount:
                err = " typed expr type arena: bracket argument authority invalid"
                return false
        childCursor = childCursor + childCount
        bracketCursor = bracketCursor + bracketCount
    if childCursor != tree.typeSyntaxChildCount ||
       bracketCursor != tree.typeSyntaxBracketArgCount:
        err = " typed expr type arena: TypeSyntax CSR coverage invalid"
        return false
    var genericReferenced: bool[]
    setLen(genericReferenced, tree.typeGenericSymbolCount)
    var rootCount: int32
    for row in 0..<tree.typeSyntaxCount:
        let rootKind = parser.ParserValueExprTypeSyntaxRootKindAt(tree, row)
        let declarationOwnerToken =
            parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(tree, row)
        let declarationOwner =
            parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(tree, row)
        let genericStart =
            parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(tree, row)
        let genericCount =
            parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(tree, row)
        if genericStart < -1 || genericCount < 0 ||
           (genericCount == 0) != (genericStart == -1) ||
           (genericCount > 0 &&
            genericStart > tree.typeGenericSymbolCount - genericCount):
            err = " typed expr type arena: generic symbol range invalid"
            return false
        if childSeen[row] || enumPayloadSeen[row]:
            if rootKind != parser.ParserTypeSyntaxRootInvalid ||
               declarationOwner != -1 || declarationOwnerToken != -1 ||
               genericStart != -1 || genericCount != 0:
                err = " typed expr type arena: nested TypeSyntax carries root authority"
                return false
            continue
        if rootKind == parser.ParserTypeSyntaxRootInvalid ||
           declarationOwnerToken < 0 ||
           declarationOwnerToken >= tree.tokenCount:
            err = " typed expr type arena: TypeSyntax root authority missing"
            return false
        let producerSourceIndex =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, row)
        for symbolOffset in 0..<genericCount:
            let symbolRow = genericStart + symbolOffset
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.typeGenericSymbolProducerSourceIndexes,
                   symbolRow) != producerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
                   symbolRow) != declarationOwnerToken ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.typeGenericSymbolOrdinals,
                   symbolRow) != symbolOffset:
                err = " typed expr type arena: generic symbol CSR authority invalid"
                return false
            genericReferenced[symbolRow] = true
        if rootKind == parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            if declarationOwner != row:
                err = " typed expr type arena: type declaration owner is not self"
                return false
        elif rootKind == parser.ParserTypeSyntaxRootFieldDeclaration:
            var ownerRootKind = parser.ParserTypeSyntaxRootInvalid
            var ownerKind = parser.ParserTypeSyntaxInvalid
            if declarationOwner >= 0 && declarationOwner < row:
                ownerRootKind =
                    parser.ParserValueExprTypeSyntaxRootKindAt(
                        tree, declarationOwner)
                ownerKind = parser.ParserValueExprTypeSyntaxKindAt(
                    tree, declarationOwner)
            let topLevelObjectOwner =
                ownerRootKind ==
                    parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
                (ownerKind == parser.ParserTypeSyntaxImplicitObject ||
                 ownerKind == parser.ParserTypeSyntaxObject ||
                 ownerKind == parser.ParserTypeSyntaxRefObject)
            # [phaseB-parser] `type N = tuple[a: T, ...]` 具名元素的字段声明
            # root 的 owner 是别名包裹 tuple 的声明根；精确到「单子且子为
            # Tuple」，与 parser 的 DeclarationOwnerEdgeValid 同口径。
            let topLevelTupleAliasOwner =
                ownerRootKind ==
                    parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
                ownerKind == parser.ParserTypeSyntaxAlias &&
                parser.ParserValueExprTypeSyntaxChildCountAt(
                    tree, declarationOwner) == 1 &&
                parser.ParserValueExprTypeSyntaxKindAt(
                    tree,
                    parser.ParserValueExprTypeSyntaxChildAt(
                        tree, declarationOwner, 0)) ==
                    parser.ParserTypeSyntaxTuple
            let nestedObjectOwner =
                ownerRootKind ==
                    parser.ParserTypeSyntaxRootFieldDeclaration &&
                (ownerKind == parser.ParserTypeSyntaxObject ||
                 ownerKind == parser.ParserTypeSyntaxRefObject)
            if declarationOwner < 0 || declarationOwner >= row ||
               (!topLevelObjectOwner && !topLevelTupleAliasOwner &&
                !nestedObjectOwner) ||
               parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, declarationOwner) != declarationOwnerToken ||
               parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(
                   tree, declarationOwner) != genericStart ||
               parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(
                   tree, declarationOwner) != genericCount ||
               parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, declarationOwner) != producerSourceIndex:
                err = " typed expr type arena: field declaration owner authority invalid"
                return false
        elif declarationOwner != -1:
            err = " typed expr type arena: unexpected declaration owner authority"
            return false
        rootCount = rootCount + 1
    for symbolRow in 0..<genericReferenced.len:
        if !genericReferenced[symbolRow]:
            err = " typed expr type arena: generic symbol is unreachable"
            return false
    if tree.typeSyntaxCount > 0 && rootCount <= 0:
        err = " typed expr type arena: TypeSyntax forest has no root"
        return false
    return true

@borrows
fn typedExprTypeArenaTreeShape(
        tree: parser.ParserValueExprTree,
        err: var str): bool =
    if tree == nil || tree.producerSourceCount <= 0 ||
       tree.tokenCount < 0 || tree.typeSyntaxCount < 0:
        if tree == nil:
            err = " typed expr type arena: parser TypeSyntax tree missing"
        else:
            err = Fmt" typed expr type arena: parser TypeSyntax owner/count invalid sources={tree.producerSourceCount} tokens={tree.tokenCount} types={tree.typeSyntaxCount}"
        return false
    if !parser.ParserValueExprTreeGenericSymbolsStrictValidateInto(
           tree, err):
        return false
    if tree.typeSyntaxKinds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxProducerSourceIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSourceLocalRows.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSpanStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSpanEnds.len != tree.typeSyntaxCount:
        err = Fmt" typed expr type arena: parser TypeSyntax core shape incomplete count={tree.typeSyntaxCount} kinds={tree.typeSyntaxKinds.len} sources={tree.typeSyntaxProducerSourceIndexes.len} starts={tree.typeSyntaxSpanStarts.len} ends={tree.typeSyntaxSpanEnds.len}"
        return false
    if tree.typeSyntaxOwnerTokenIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxQuestionTokenIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxDeclarationOwnerTokenIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxDeclarationOwnerNodeIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxGenericSymbolStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxGenericSymbolCounts.len != tree.typeSyntaxCount:
        err = " typed expr type arena: parser TypeSyntax ownership shape incomplete"
        return false
    if tree.typeSyntaxChildStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxChildCounts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxBracketArgStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxBracketArgCounts.len != tree.typeSyntaxCount:
        err = " typed expr type arena: parser TypeSyntax CSR shape incomplete"
        return false
    if tree.typeSyntaxNameTokenIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxFixedLengths.len != tree.typeSyntaxCount ||
       tree.typeSyntaxRootKinds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxEnumVariantStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxEnumVariantCounts.len != tree.typeSyntaxCount:
        err = " typed expr type arena: parser TypeSyntax detail shape incomplete"
        return false
    return typedExprTypeArenaParserAuthorityShape(tree, err)

@borrows
fn typedExprTypeArenaAuthorityShape(
        authority: TypedExprTypeResolutionAuthority,
        typeSyntaxCount: int32,
        genericSymbolCount: int32,
        err: var str): bool =
    if !authority.sealed ||
       authority.typeSyntaxNodeIndexes.len !=
           authority.declarationRootTypeSyntaxNodeIndexes.len ||
       authority.genericTypeSyntaxNodeIndexes.len !=
           authority.genericSymbolRows.len:
        err = " typed expr type arena: resolution authority is unsealed"
        return false
    for row in 0..<authority.typeSyntaxNodeIndexes.len:
        if authority.typeSyntaxNodeIndexes[row] < 0 ||
           authority.typeSyntaxNodeIndexes[row] >= typeSyntaxCount ||
           authority.declarationRootTypeSyntaxNodeIndexes[row] < 0 ||
           authority.declarationRootTypeSyntaxNodeIndexes[row] >=
               typeSyntaxCount ||
           (row > 0 && authority.typeSyntaxNodeIndexes[row - 1] >=
                         authority.typeSyntaxNodeIndexes[row]):
            err = " typed expr type arena: resolution authority row invalid"
            return false
    for row in 0..<authority.genericTypeSyntaxNodeIndexes.len:
        if authority.genericTypeSyntaxNodeIndexes[row] < 0 ||
           authority.genericTypeSyntaxNodeIndexes[row] >= typeSyntaxCount ||
           authority.genericSymbolRows[row] < 0 ||
           authority.genericSymbolRows[row] >= genericSymbolCount ||
           (row > 0 &&
            authority.genericTypeSyntaxNodeIndexes[row - 1] >=
                authority.genericTypeSyntaxNodeIndexes[row]):
            err = " typed expr type arena: generic resolution authority row invalid"
            return false
    return true

@borrows
fn typedExprTypeAuthorityTextLess(left: str, right: str): bool =
    if left == right:
        return false
    let shared = left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] != right[index]:
            return left[index] < right[index]
    return left.len < right.len

@borrows
fn typedExprTypeAuthorityDeclarationLess(
        tree: parser.ParserValueExprTree,
        leftRoot: int32,
        rightRoot: int32): bool =
    let leftSource =
        parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, leftRoot)
    let rightSource =
        parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, rightRoot)
    if leftSource != rightSource:
        return leftSource < rightSource
    let leftToken =
        parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
            tree, leftRoot)
    let rightToken =
        parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
            tree, rightRoot)
    let leftName = parser.ParserValueExprTokenText(tree, leftToken)
    let rightName = parser.ParserValueExprTokenText(tree, rightToken)
    if leftName != rightName:
        return typedExprTypeAuthorityTextLess(leftName, rightName)
    return leftRoot < rightRoot

@borrows
fn typedExprTypeAuthorityDeclarationKeyEqual(
        tree: parser.ParserValueExprTree,
        leftRoot: int32,
        rightRoot: int32): bool =
    if parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
           tree, leftRoot) !=
       parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
           tree, rightRoot):
        return false
    return parser.ParserValueExprTokenText(
               tree,
               parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, leftRoot)) ==
           parser.ParserValueExprTokenText(
               tree,
               parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, rightRoot))

fn typedExprTypeAuthoritySwapRoots(values: var int32[],
                                   left: int32,
                                   right: int32) =
    let saved = values[left]
    values[left] = values[right]
    values[right] = saved

@borrows
fn typedExprTypeAuthorityRootSiftDown(
        tree: parser.ParserValueExprTree,
        values: var int32[],
        start: int32,
        count: int32) =
    var root = start
    while true:
        let left = root * 2 + 1
        if left >= count:
            return
        var selected = left
        let right = left + 1
        if right < count &&
           typedExprTypeAuthorityDeclarationLess(
               tree, values[selected], values[right]):
            selected = right
        if !typedExprTypeAuthorityDeclarationLess(
               tree, values[root], values[selected]):
            return
        typedExprTypeAuthoritySwapRoots(values, root, selected)
        root = selected

@borrows
fn typedExprTypeAuthoritySortRoots(
        tree: parser.ParserValueExprTree,
        values: var int32[]) =
    let parentCount = values.len / 2
    for reverse in 0..<parentCount:
        typedExprTypeAuthorityRootSiftDown(
            tree, values, parentCount - 1 - reverse, values.len)
    if values.len <= 1:
        return
    for reverse in 0..<values.len - 1:
        let endExclusive = values.len - reverse
        typedExprTypeAuthoritySwapRoots(values, 0, endExclusive - 1)
        typedExprTypeAuthorityRootSiftDown(
            tree, values, 0, endExclusive - 1)

@borrows
fn typedExprTypeAuthorityDeclarationBeforeKey(
        tree: parser.ParserValueExprTree,
        declarationRoot: int32,
        producerSourceIndex: int32,
        name: str): bool =
    let declarationSource =
        parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
            tree, declarationRoot)
    if declarationSource != producerSourceIndex:
        return declarationSource < producerSourceIndex
    let declarationName = parser.ParserValueExprTokenText(
        tree,
        parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
            tree, declarationRoot))
    return typedExprTypeAuthorityTextLess(declarationName, name)

@borrows
fn typedExprTypeAuthorityFindDeclaration(
        tree: parser.ParserValueExprTree,
        sortedDeclarationRoots: int32[],
        producerSourceIndex: int32,
        name: str): int32 =
    var low: int32
    var high = sortedDeclarationRoots.len
    while low < high:
        let middle = low + (high - low) / 2
        if typedExprTypeAuthorityDeclarationBeforeKey(
               tree,
               sortedDeclarationRoots[middle],
               producerSourceIndex,
               name):
            low = middle + 1
        else:
            high = middle
    if low >= sortedDeclarationRoots.len:
        return -1
    let declarationRoot = sortedDeclarationRoots[low]
    if parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
           tree, declarationRoot) != producerSourceIndex ||
       parser.ParserValueExprTokenText(
           tree,
           parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
               tree, declarationRoot)) != name:
        return -1
    return declarationRoot

@borrows
fn typedExprTypeImportAuthorityShape(
        authority: TypedExprTypeImportAuthority,
        producerSourceCount: int32,
        err: var str): bool =
    if !authority.sealed ||
       authority.ownerSourceIndexes.len !=
           authority.targetSourceIndexes.len ||
       authority.ownerSourceIndexes.len != authority.qualifiers.len ||
       authority.ownerSourceIndexes.len !=
           authority.allowsUnqualified.len:
        err = " typed expr type arena: import authority is unsealed"
        return false
    for row in 0..<authority.ownerSourceIndexes.len:
        if authority.ownerSourceIndexes[row] < 0 ||
           authority.ownerSourceIndexes[row] >= producerSourceCount ||
           authority.targetSourceIndexes[row] < 0 ||
           authority.targetSourceIndexes[row] >= producerSourceCount ||
           authority.ownerSourceIndexes[row] ==
               authority.targetSourceIndexes[row] ||
           authority.qualifiers[row] == "":
            err = " typed expr type arena: import authority row invalid"
            return false
    return true

@borrows
fn typedExprTypeImportAuthorityRowLess(
        authority: TypedExprTypeImportAuthority,
        leftRow: int32,
        rightRow: int32): bool =
    let leftOwner = authority.ownerSourceIndexes[leftRow]
    let rightOwner = authority.ownerSourceIndexes[rightRow]
    if leftOwner != rightOwner:
        return leftOwner < rightOwner
    let leftQualifier = authority.qualifiers[leftRow]
    let rightQualifier = authority.qualifiers[rightRow]
    if leftQualifier != rightQualifier:
        return typedExprTypeAuthorityTextLess(
            leftQualifier, rightQualifier)
    return authority.targetSourceIndexes[leftRow] <
           authority.targetSourceIndexes[rightRow]

@borrows
fn typedExprTypeImportAuthoritySiftDown(
        authority: TypedExprTypeImportAuthority,
        rows: var int32[],
        start: int32,
        count: int32) =
    var root = start
    while true:
        let left = root * 2 + 1
        if left >= count:
            return
        var selected = left
        let right = left + 1
        if right < count && typedExprTypeImportAuthorityRowLess(
               authority, rows[selected], rows[right]):
            selected = right
        if !typedExprTypeImportAuthorityRowLess(
               authority, rows[root], rows[selected]):
            return
        typedExprTypeAuthoritySwapRoots(rows, root, selected)
        root = selected

@borrows
fn typedExprTypeImportAuthoritySortRows(
        authority: TypedExprTypeImportAuthority,
        rows: var int32[]) =
    let parentCount = rows.len / 2
    for reverse in 0..<parentCount:
        typedExprTypeImportAuthoritySiftDown(
            authority, rows, parentCount - 1 - reverse, rows.len)
    if rows.len <= 1:
        return
    for reverse in 0..<rows.len - 1:
        let endExclusive = rows.len - reverse
        typedExprTypeAuthoritySwapRoots(rows, 0, endExclusive - 1)
        typedExprTypeImportAuthoritySiftDown(
            authority, rows, 0, endExclusive - 1)

@borrows
fn typedExprTypeImportAuthorityFindTarget(
        authority: TypedExprTypeImportAuthority,
        sortedRows: int32[],
        ownerSourceIndex: int32,
        qualifier: str): int32 =
    var low: int32
    var high = sortedRows.len
    while low < high:
        let middle = low + (high - low) / 2
        let row = sortedRows[middle]
        let owner = authority.ownerSourceIndexes[row]
        let rowQualifier = authority.qualifiers[row]
        if owner < ownerSourceIndex ||
           (owner == ownerSourceIndex &&
            typedExprTypeAuthorityTextLess(rowQualifier, qualifier)):
            low = middle + 1
        else:
            high = middle
    if low >= sortedRows.len:
        return -1
    let row = sortedRows[low]
    if authority.ownerSourceIndexes[row] != ownerSourceIndex ||
       authority.qualifiers[row] != qualifier:
        return -1
    return authority.targetSourceIndexes[row]

@borrows
fn typedExprTypeAuthorityDeclarationExportedInto(
        tree: parser.ParserValueExprTree,
        declarationRowByRoot: int32[],
        declarationRoot: int32,
        exportedOut: var bool,
        err: var str): bool =
    exportedOut = false
    if declarationRoot < 0 ||
       declarationRoot >= declarationRowByRoot.len:
        err = " typed expr type arena: declaration root identity invalid"
        return false
    let declarationRow = declarationRowByRoot[declarationRoot]
    if declarationRow < 0 ||
       declarationRow >= tree.declarationCount ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationKinds,
           declarationRow) != Int32(parser.ParserDeclarationType) ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationTypeSyntaxRootIndexes,
           declarationRow) != declarationRoot:
        err = " typed expr type arena: declaration root/DeclId join missing"
        return false
    exportedOut = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationExportedFlags,
        declarationRow) != 0
    return true

@borrows
fn typedExprTypeAuthorityFindGenericSymbol(
        tree: parser.ParserValueExprTree,
        rootTypeSyntaxNodeIndex: int32,
        producerSourceIndex: int32,
        name: str,
        err: var str): int32 =
    if rootTypeSyntaxNodeIndex < 0 ||
       rootTypeSyntaxNodeIndex >= tree.typeSyntaxCount ||
       parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
           tree, rootTypeSyntaxNodeIndex) != producerSourceIndex:
        err = " typed expr type arena: generic owner root invalid"
        return -2
    let genericStart =
        parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(
            tree, rootTypeSyntaxNodeIndex)
    let genericCount =
        parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(
            tree, rootTypeSyntaxNodeIndex)
    if genericCount == 0:
        return -1
    let ownerToken =
        parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
            tree, rootTypeSyntaxNodeIndex)
    var matchedRow: int32 = -1
    for genericOffset in 0..<genericCount:
        let genericRow = genericStart + genericOffset
        let genericNameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.typeGenericSymbolNameTokenIndexes,
            genericRow)
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.typeGenericSymbolProducerSourceIndexes,
               genericRow) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
               genericRow) != ownerToken:
            err = " typed expr type arena: generic owner identity forged"
            return -2
        if parser.ParserValueExprTokenText(tree, genericNameToken) != name:
            continue
        if matchedRow >= 0:
            err = " typed expr type arena: duplicate generic declaration"
            return -2
        matchedRow = genericRow
    return matchedRow

@borrows
fn typedExprTypeAuthorityResolveUnqualifiedInto(
        tree: parser.ParserValueExprTree,
        sortedDeclarationRoots: int32[],
        declarationRowByRoot: int32[],
        imports: TypedExprTypeImportAuthority,
        sortedImportRows: int32[],
        producerSourceIndex: int32,
        name: str,
        declarationRootOut: var int32,
        err: var str): bool =
    declarationRootOut = typedExprTypeAuthorityFindDeclaration(
        tree, sortedDeclarationRoots, producerSourceIndex, name)
    if declarationRootOut >= 0:
        return true
    var matchedRoot: int32 = -1
    for sortedOffset in 0..<sortedImportRows.len:
        let importRow = sortedImportRows[sortedOffset]
        let ownerSourceIndex = imports.ownerSourceIndexes[importRow]
        if ownerSourceIndex < producerSourceIndex:
            continue
        if ownerSourceIndex > producerSourceIndex:
            break
        if !imports.allowsUnqualified[importRow]:
            continue
        let candidateRoot = typedExprTypeAuthorityFindDeclaration(
            tree,
            sortedDeclarationRoots,
            imports.targetSourceIndexes[importRow],
            name)
        if candidateRoot < 0:
            continue
        var exported: bool
        if !typedExprTypeAuthorityDeclarationExportedInto(
               tree,
               declarationRowByRoot,
               candidateRoot,
               exported,
               err):
            return false
        if !exported:
            err = " typed expr type arena: imported type is not exported"
            return false
        if matchedRoot >= 0 && matchedRoot != candidateRoot:
            err = " typed expr type arena: unqualified imported nominal is ambiguous"
            return false
        matchedRoot = candidateRoot
    if matchedRoot < 0:
        err = Fmt" typed expr type arena: nominal declaration is not visible producer_source={producerSourceIndex} name={name}"
        return false
    declarationRootOut = matchedRoot
    return true

@borrows
fn typedExprTypeAuthorityResolveQualifiedInto(
        tree: parser.ParserValueExprTree,
        sortedDeclarationRoots: int32[],
        declarationRowByRoot: int32[],
        imports: TypedExprTypeImportAuthority,
        sortedImportRows: int32[],
        typeSyntaxNodeIndex: int32,
        declarationRootOut: var int32,
        err: var str): bool =
    declarationRootOut = -1
    let childCount = parser.ParserValueExprTypeSyntaxChildCountAt(
        tree, typeSyntaxNodeIndex)
    if childCount < 2:
        err = " typed expr type arena: qualified nominal path incomplete"
        return false
    var currentSourceIndex =
        parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
            tree, typeSyntaxNodeIndex)
    for childOffset in 0..<childCount - 1:
        let child = parser.ParserValueExprTypeSyntaxChildAt(
            tree, typeSyntaxNodeIndex, childOffset)
        if parser.ParserValueExprTypeSyntaxKindAt(tree, child) !=
               parser.ParserTypeSyntaxNominal ||
           parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
               tree, child) !=
               parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, typeSyntaxNodeIndex):
            err = " typed expr type arena: qualified nominal segment invalid"
            return false
        let qualifier = parser.ParserValueExprTokenText(
            tree, parser.ParserValueExprTypeSyntaxNameTokenAt(tree, child))
        if typedExprTypeAuthorityFindDeclaration(
               tree,
               sortedDeclarationRoots,
               currentSourceIndex,
               qualifier) >= 0:
            err = " typed expr type arena: import qualifier is shadowed"
            return false
        let targetSourceIndex = typedExprTypeImportAuthorityFindTarget(
            imports, sortedImportRows, currentSourceIndex, qualifier)
        if targetSourceIndex < 0:
            err = " typed expr type arena: qualified import alias is not visible"
            return false
        currentSourceIndex = targetSourceIndex
    let leaf = parser.ParserValueExprTypeSyntaxChildAt(
        tree, typeSyntaxNodeIndex, childCount - 1)
    if parser.ParserValueExprTypeSyntaxKindAt(tree, leaf) !=
           parser.ParserTypeSyntaxNominal:
        err = " typed expr type arena: qualified nominal leaf invalid"
        return false
    let leafName = parser.ParserValueExprTokenText(
        tree, parser.ParserValueExprTypeSyntaxNameTokenAt(tree, leaf))
    declarationRootOut = typedExprTypeAuthorityFindDeclaration(
        tree, sortedDeclarationRoots, currentSourceIndex, leafName)
    if declarationRootOut < 0:
        err = " typed expr type arena: qualified imported nominal missing"
        return false
    var exported: bool
    if !typedExprTypeAuthorityDeclarationExportedInto(
           tree,
           declarationRowByRoot,
           declarationRootOut,
           exported,
           err):
        return false
    if !exported:
        err = " typed expr type arena: imported type is not exported"
        return false
    return true

# Read-only over `tree` (shape check, counts, ArenaArrayInt32Get reads); it
# never rebinds, stores or releases it. Without @borrows the default MOVE
# consumes the caller's forest, and the caller's later
# TypedExprTypeArenaBuildFromParserTreeInto + ParserValueExprTreeRelease then
# trip cold's new "use of consumed managed value" gate. Closing @borrows here
# is the doctrine in findings.md "2026-07-26 `@borrows` 必须闭合到最后一个下游调用".
@borrows
fn TypedExprTypeResolutionAuthorityBuildPackageForestInto(
        tree: parser.ParserValueExprTree,
        imports: TypedExprTypeImportAuthority,
        out: var TypedExprTypeResolutionAuthority,
        err: var str): bool =
    if out.sealed || out.typeSyntaxNodeIndexes.len != 0 ||
       out.declarationRootTypeSyntaxNodeIndexes.len != 0:
        err = " typed expr type arena: resolution authority destination is not empty"
        return false
    if !typedExprTypeArenaTreeShape(tree, err) ||
       !typedExprTypeImportAuthorityShape(
           imports, tree.producerSourceCount, err):
        return false
    var declarationRoots: int32[]
    for typeSyntaxNodeIndex in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(
               tree, typeSyntaxNodeIndex) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            add(declarationRoots, typeSyntaxNodeIndex)
    var declarationRowByRoot: int32[]
    setLen(declarationRowByRoot, tree.typeSyntaxCount)
    for row in 0..<declarationRowByRoot.len:
        declarationRowByRoot[row] = -1
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) != Int32(parser.ParserDeclarationType):
            continue
        let declarationRoot = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationTypeSyntaxRootIndexes,
            declarationRow)
        if declarationRoot < 0 ||
           declarationRoot >= tree.typeSyntaxCount ||
           declarationRowByRoot[declarationRoot] >= 0:
            err = " typed expr type arena: declaration root/DeclId map invalid"
            return false
        declarationRowByRoot[declarationRoot] = declarationRow
    for declarationRoot in 0..<declarationRowByRoot.len:
        if parser.ParserValueExprTypeSyntaxRootKindAt(
               tree, declarationRoot) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           declarationRowByRoot[declarationRoot] < 0:
            err = " typed expr type arena: declaration root/DeclId coverage missing"
            return false
    var sortedDeclarationRoots = declarationRoots
    typedExprTypeAuthoritySortRoots(tree, sortedDeclarationRoots)
    for row in 1..<sortedDeclarationRoots.len:
        if typedExprTypeAuthorityDeclarationKeyEqual(
               tree,
               sortedDeclarationRoots[row - 1],
               sortedDeclarationRoots[row]):
            err = " typed expr type arena: duplicate same-source type declaration"
            return false
    var sortedImportRows: int32[]
    for row in 0..<imports.ownerSourceIndexes.len:
        add(sortedImportRows, row)
    typedExprTypeImportAuthoritySortRows(imports, sortedImportRows)
    for row in 1..<sortedImportRows.len:
        let previous = sortedImportRows[row - 1]
        let current = sortedImportRows[row]
        if imports.ownerSourceIndexes[previous] ==
               imports.ownerSourceIndexes[current] &&
           imports.qualifiers[previous] == imports.qualifiers[current]:
            err = " typed expr type arena: duplicate import qualifier authority"
            return false
    var qualifiedSegment: bool[]
    var typeSyntaxParentNodeIndexes: int32[]
    setLen(qualifiedSegment, tree.typeSyntaxCount)
    setLen(typeSyntaxParentNodeIndexes, tree.typeSyntaxCount)
    for row in 0..<typeSyntaxParentNodeIndexes.len:
        typeSyntaxParentNodeIndexes[row] = -1
    for typeSyntaxNodeIndex in 0..<tree.typeSyntaxCount:
        let structuralChildCount =
            parser.ParserValueExprTypeSyntaxChildCountAt(
                tree, typeSyntaxNodeIndex)
        for childOffset in 0..<structuralChildCount:
            let child = parser.ParserValueExprTypeSyntaxChildAt(
                tree, typeSyntaxNodeIndex, childOffset)
            if child < 0 || child >= typeSyntaxNodeIndex ||
               typeSyntaxParentNodeIndexes[child] >= 0:
                err = " typed expr type arena: TypeSyntax parent authority invalid"
                return false
            typeSyntaxParentNodeIndexes[child] = typeSyntaxNodeIndex
        let variantCount =
            parser.ParserValueExprTypeSyntaxEnumVariantCountAt(
                tree, typeSyntaxNodeIndex)
        for variantOffset in 0..<variantCount:
            let payload =
                parser.ParserValueExprTypeSyntaxEnumVariantPayloadTypeNodeAt(
                    tree, typeSyntaxNodeIndex, variantOffset)
            if payload >= 0:
                if payload >= typeSyntaxNodeIndex ||
                   typeSyntaxParentNodeIndexes[payload] >= 0:
                    err = " typed expr type arena: enum payload parent authority invalid"
                    return false
                typeSyntaxParentNodeIndexes[payload] = typeSyntaxNodeIndex
        if parser.ParserValueExprTypeSyntaxKindAt(
               tree, typeSyntaxNodeIndex) !=
               parser.ParserTypeSyntaxQualified:
            continue
        let childCount = parser.ParserValueExprTypeSyntaxChildCountAt(
            tree, typeSyntaxNodeIndex)
        if childCount < 2:
            err = " typed expr type arena: qualified nominal path incomplete"
            return false
        for childOffset in 0..<childCount:
            let child = parser.ParserValueExprTypeSyntaxChildAt(
                tree, typeSyntaxNodeIndex, childOffset)
            if child < 0 || child >= typeSyntaxNodeIndex ||
               qualifiedSegment[child] ||
               parser.ParserValueExprTypeSyntaxKindAt(tree, child) !=
                   parser.ParserTypeSyntaxNominal:
                err = " typed expr type arena: qualified nominal segment invalid"
                return false
            qualifiedSegment[child] = true
    var candidate: TypedExprTypeResolutionAuthority
    for typeSyntaxNodeIndex in 0..<tree.typeSyntaxCount:
        let kind = parser.ParserValueExprTypeSyntaxKindAt(
            tree, typeSyntaxNodeIndex)
        if kind == parser.ParserTypeSyntaxQualified:
            var declarationRoot: int32
            if !typedExprTypeAuthorityResolveQualifiedInto(
                   tree,
                   sortedDeclarationRoots,
                   declarationRowByRoot,
                   imports,
                   sortedImportRows,
                   typeSyntaxNodeIndex,
                   declarationRoot,
                   err):
                return false
            add(candidate.typeSyntaxNodeIndexes, typeSyntaxNodeIndex)
            add(candidate.declarationRootTypeSyntaxNodeIndexes,
                declarationRoot)
            continue
        if kind != parser.ParserTypeSyntaxNominal ||
           qualifiedSegment[typeSyntaxNodeIndex]:
            continue
        let nameToken = parser.ParserValueExprTypeSyntaxNameTokenAt(
            tree, typeSyntaxNodeIndex)
        if nameToken < 0 || nameToken >= tree.tokenCount:
            err = " typed expr type arena: nominal name token missing"
            return false
        let name = parser.ParserValueExprTokenText(tree, nameToken)
        if typedExprTypeArenaScalarKind(name) !=
               TypedExprStructuralScalarInvalid:
            continue
        let producerSourceIndex =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                tree, typeSyntaxNodeIndex)
        var rootTypeSyntaxNodeIndex = typeSyntaxNodeIndex
        while typeSyntaxParentNodeIndexes[rootTypeSyntaxNodeIndex] >= 0:
            rootTypeSyntaxNodeIndex =
                typeSyntaxParentNodeIndexes[rootTypeSyntaxNodeIndex]
        let genericSymbolRow = typedExprTypeAuthorityFindGenericSymbol(
            tree,
            rootTypeSyntaxNodeIndex,
            producerSourceIndex,
            name,
            err)
        if genericSymbolRow == -2:
            return false
        if genericSymbolRow >= 0:
            add(candidate.genericTypeSyntaxNodeIndexes,
                typeSyntaxNodeIndex)
            add(candidate.genericSymbolRows, genericSymbolRow)
            continue
        var declarationRoot: int32
        if !typedExprTypeAuthorityResolveUnqualifiedInto(
               tree,
               sortedDeclarationRoots,
               declarationRowByRoot,
               imports,
               sortedImportRows,
               producerSourceIndex,
               name,
               declarationRoot,
               err):
            return false
        add(candidate.typeSyntaxNodeIndexes, typeSyntaxNodeIndex)
        add(candidate.declarationRootTypeSyntaxNodeIndexes, declarationRoot)
    candidate.sealed = true
    if !typedExprTypeArenaAuthorityShape(
           candidate, tree.typeSyntaxCount, tree.typeGenericSymbolCount, err):
        return false
    out = candidate
    err = ""
    return true

@borrows
fn TypedExprTypeResolutionAuthorityBuildSameSourceInto(
        tree: parser.ParserValueExprTree,
        out: var TypedExprTypeResolutionAuthority,
        err: var str): bool =
    var imports: TypedExprTypeImportAuthority
    imports.sealed = true
    return TypedExprTypeResolutionAuthorityBuildPackageForestInto(
        tree, imports, out, err)

@borrows
fn typedExprTypeDeclarationIndexShape(
        index: TypedExprTypeDeclarationIndex,
        producerSourceCount: int32,
        typeSyntaxCount: int32,
        declarationCount: int32,
        err: var str): bool =
    if !index.sealed ||
       index.producerSourceCount != producerSourceCount ||
       index.typeSyntaxCount != typeSyntaxCount ||
       index.declarationCount != declarationCount ||
       index.producerSourceIndexes.len != index.declarationNameTexts.len ||
       index.producerSourceIndexes.len != index.declarationKinds.len ||
       index.producerSourceIndexes.len !=
           index.declarationExportedFlags.len ||
       index.producerSourceIndexes.len != index.globalTypeSyntaxRoots.len ||
       index.producerSourceIndexes.len != index.globalDeclarationRows.len ||
       index.typeSyntaxBaseBySource.len != producerSourceCount ||
       index.declarationBaseBySource.len != producerSourceCount ||
       index.tokenCountBySource.len != producerSourceCount ||
       index.typeSyntaxChildCountBySource.len != producerSourceCount ||
       index.enumVariantCountBySource.len != producerSourceCount ||
       index.declarationSymbolCountBySource.len != producerSourceCount ||
       index.functionCountBySource.len != producerSourceCount ||
       index.bracketArgCountBySource.len != producerSourceCount ||
       index.genericSymbolCountBySource.len != producerSourceCount ||
       index.genericSymbolChildCountBySource.len != producerSourceCount:
        err = Fmt" typed expr type arena: declaration index shape invalid entries={index.producerSourceIndexes.len} sources={index.producerSourceCount} type_syntax={index.typeSyntaxCount} declarations={index.declarationCount}"
        return false
    for row in 0..<index.producerSourceIndexes.len:
        if index.producerSourceIndexes[row] < 0 ||
           index.producerSourceIndexes[row] >= producerSourceCount ||
           index.declarationNameTexts[row] == "" ||
           index.globalTypeSyntaxRoots[row] < 0 ||
           index.globalTypeSyntaxRoots[row] >= typeSyntaxCount ||
           index.globalDeclarationRows[row] < 0 ||
           index.globalDeclarationRows[row] >= declarationCount:
            err = Fmt" typed expr type arena: declaration index entry invalid row={row}"
            return false
    if index.declarationSymbolGlobalRoots.len > typeSyntaxCount:
        err = Fmt" typed expr type arena: declaration symbol root shape invalid symbols={index.declarationSymbolGlobalRoots.len} type_syntax={typeSyntaxCount}"
        return false
    for symbolId in 0..<index.declarationSymbolGlobalRoots.len:
        let symbolRoot = index.declarationSymbolGlobalRoots[symbolId]
        if symbolRoot < 0 || symbolRoot >= typeSyntaxCount:
            err = Fmt" typed expr type arena: declaration symbol root row invalid symbol={symbolId} root={symbolRoot}"
            return false
        if symbolId > 0 &&
           index.declarationSymbolGlobalRoots[symbolId - 1] >= symbolRoot:
            err = Fmt" typed expr type arena: declaration symbol root order invalid symbol={symbolId} previous={index.declarationSymbolGlobalRoots[symbolId - 1]} root={symbolRoot}"
            return false
    return true

# Declaration-root -> declaration-row join, the exact map
# TypedExprTypeResolutionAuthorityBuildPackageForestInto derives, with the
# same coverage requirement.
@borrows
fn typedExprTypeDeclarationRowByRootInto(
        tree: parser.ParserValueExprTree,
        out: var int32[],
        err: var str): bool =
    if out.len != 0:
        err = " typed expr type arena: declaration row map destination is not empty"
        return false
    var candidate: int32[]
    setLen(candidate, tree.typeSyntaxCount)
    for row in 0..<candidate.len:
        candidate[row] = -1
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena, tree.declarationKinds, declarationRow) !=
               Int32(parser.ParserDeclarationType):
            continue
        let declarationRoot = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationTypeSyntaxRootIndexes,
            declarationRow)
        if declarationRoot < 0 ||
           declarationRoot >= tree.typeSyntaxCount ||
           candidate[declarationRoot] >= 0:
            err = " typed expr type arena: declaration index root/DeclId map invalid"
            return false
        candidate[declarationRoot] = declarationRow
    for declarationRoot in 0..<candidate.len:
        if parser.ParserValueExprTypeSyntaxRootKindAt(
               tree, declarationRoot) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           candidate[declarationRoot] < 0:
            err = " typed expr type arena: declaration index root/DeclId coverage missing"
            return false
    out = candidate
    return true

# One declaration entry: the exact cross-source projection of a
# TypeDeclarationRhs TypeSyntax root.  `typeSyntaxBase`/`declarationBase` are
# the merge offsets the forest append would assign to this source.
@borrows
fn typedExprTypeDeclarationIndexAppendEntry(
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        typeSyntaxRow: int32,
        typeSyntaxBase: int32,
        declarationBase: int32,
        declarationRowByRoot: int32[],
        out: var TypedExprTypeDeclarationIndex,
        err: var str): bool =
    if typeSyntaxRow < 0 || typeSyntaxRow >= tree.typeSyntaxCount ||
       declarationRowByRoot.len != tree.typeSyntaxCount ||
       typeSyntaxBase < 0 || declarationBase < 0:
        err = " typed expr type arena: declaration index TypeSyntax row invalid"
        return false
    let localRow = parser.ParserValueExprTypeSyntaxSourceLocalRowAt(
        tree, typeSyntaxRow)
    if localRow < 0 || localRow >= tree.typeSyntaxCount:
        err = Fmt" typed expr type arena: declaration index source-local row invalid root={typeSyntaxRow} local={localRow}"
        return false
    let declarationRow = declarationRowByRoot[typeSyntaxRow]
    if declarationRow < 0 || declarationRow >= tree.declarationCount:
        err = Fmt" typed expr type arena: declaration index root/DeclId join missing root={typeSyntaxRow} declarations={tree.declarationCount}"
        return false
    let declarationKind = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.declarationKinds, declarationRow)
    if declarationKind != Int32(parser.ParserDeclarationType) ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationTypeSyntaxRootIndexes,
           declarationRow) != typeSyntaxRow:
        err = " typed expr type arena: declaration index declaration authority invalid"
        return false
    let ownerToken = parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
        tree, typeSyntaxRow)
    if ownerToken < 0 || ownerToken >= tree.tokenCount:
        err = Fmt" typed expr type arena: declaration index name token missing root={typeSyntaxRow}"
        return false
    let name = parser.ParserValueExprTokenText(tree, ownerToken)
    if name == "":
        err = Fmt" typed expr type arena: declaration index name text empty root={typeSyntaxRow}"
        return false
    add(out.producerSourceIndexes, producerSourceIndex)
    add(out.declarationNameTexts, name)
    add(out.declarationKinds, declarationKind)
    add(out.declarationExportedFlags,
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationExportedFlags, declarationRow) != 0)
    add(out.globalTypeSyntaxRoots, typeSyntaxBase + localRow)
    add(out.globalDeclarationRows, declarationBase + declarationRow)
    return true

# Extract one source's declaration projection into the package index.  The
# caller supplies the running merge offsets; sources must arrive in forest
# order so the row order of the index equals the row order of the forest.
@borrows
fn TypedExprTypeDeclarationIndexBuildSourceInto(
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        typeSyntaxBase: int32,
        declarationBase: int32,
        genericSymbolBase: int32,
        out: var TypedExprTypeDeclarationIndex,
        err: var str): bool =
    if tree == nil ||
       tree.lifecycleState != parser.ParserValueExprOwnerActive ||
       tree.producerSourceCount != 1 ||
       producerSourceIndex < 0 ||
       typeSyntaxBase < 0 || declarationBase < 0 ||
       genericSymbolBase < 0:
        err = " typed expr type arena: declaration index source input invalid"
        return false
    if out.sealed ||
       out.producerSourceCount != producerSourceIndex ||
       out.typeSyntaxBaseBySource.len != producerSourceIndex ||
       out.declarationBaseBySource.len != producerSourceIndex ||
       out.tokenCountBySource.len != producerSourceIndex ||
       out.typeSyntaxChildCountBySource.len != producerSourceIndex ||
       out.enumVariantCountBySource.len != producerSourceIndex ||
       out.declarationSymbolCountBySource.len != producerSourceIndex ||
       out.functionCountBySource.len != producerSourceIndex ||
       out.bracketArgCountBySource.len != producerSourceIndex ||
       out.genericSymbolCountBySource.len != producerSourceIndex ||
       out.genericSymbolChildCountBySource.len != producerSourceIndex:
        err = Fmt" typed expr type arena: declaration index source order invalid source_index={producerSourceIndex} recorded={out.producerSourceCount}"
        return false
    var declarationRowByRoot: int32[]
    if !typedExprTypeDeclarationRowByRootInto(
           tree, declarationRowByRoot, err):
        return false
    for typeSyntaxRow in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(
               tree, typeSyntaxRow) !=
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            continue
        if !typedExprTypeDeclarationIndexAppendEntry(
               tree,
               producerSourceIndex,
               typeSyntaxRow,
               typeSyntaxBase,
               declarationBase,
               declarationRowByRoot,
               out,
               err):
            return false
    add(out.typeSyntaxBaseBySource, typeSyntaxBase)
    add(out.declarationBaseBySource, declarationBase)
    # [S1b step-3 (1)] Record this source's exact column contribution while
    # its single-source tree is still the authority for every one of them.
    # [closure8] The SymbolId space is materialised in the same traversal that
    # used to only count it, so the per-source total and the global root rows
    # are two readings of one walk over one predicate.
    let symbolRootsBase = out.declarationSymbolGlobalRoots.len
    for symbolRoot in 0..<tree.typeSyntaxCount:
        if typedExprTypeArenaDeclarationCreatesSymbol(tree, symbolRoot):
            add(out.declarationSymbolGlobalRoots, typeSyntaxBase + symbolRoot)
            # The same rebase the arena's FillTypeSyntax applies at that row,
            # through the same `-1` rule for a root that owns no generic symbol,
            # so the index row and the arena column are one value.
            add(out.declarationGenericSymbolStarts,
                typedExprTypeArenaRebaseRow(
                    genericSymbolBase,
                    parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(
                        tree, symbolRoot)))
            add(out.declarationGenericSymbolCounts,
                parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(
                    tree, symbolRoot))
    add(out.tokenCountBySource, tree.tokenCount)
    add(out.typeSyntaxChildCountBySource, tree.typeSyntaxChildCount)
    add(out.enumVariantCountBySource, tree.typeEnumVariantCount)
    add(out.declarationSymbolCountBySource,
        out.declarationSymbolGlobalRoots.len - symbolRootsBase)
    add(out.functionCountBySource, tree.declarationFunctionCount)
    add(out.bracketArgCountBySource, tree.typeSyntaxBracketArgCount)
    add(out.genericSymbolCountBySource, tree.typeGenericSymbolCount)
    add(out.genericSymbolChildCountBySource,
        tree.typeGenericSymbolChildCount)
    out.producerSourceCount = producerSourceIndex + 1
    out.typeSyntaxCount = out.typeSyntaxCount + tree.typeSyntaxCount
    out.declarationCount = out.declarationCount + tree.declarationCount
    err = ""
    return true

@borrows
fn typedExprTypeArenaLimitsShape(
        limits: TypedExprTypeArenaLimits,
        err: var str): bool =
    if limits.tokenCount < 0 ||
       limits.typeSyntaxCount < 0 ||
       limits.typeSyntaxChildCount < 0 ||
       limits.enumVariantCount < 0 ||
       limits.declarationSymbolCount < 0 ||
       limits.functionCount < 0 ||
       limits.bracketArgCount < 0 ||
       limits.genericSymbolCount < 0 ||
       limits.genericSymbolChildCount < 0 ||
       limits.producerSourceCount < 0:
        err = " typed expr type arena: column limits invalid"
        return false
    return true

# Every arena column the six Fill* families append to, with the row count its
# loop advances by, and how many such columns share that row count.  This is
# the single place the column inventory lives, and the reserve block below
# names exactly the same 62 columns: 4 token + 20 per-TypeSyntax-row + 1 child
# payload + 5 enum variant + 6 declaration Symbol + 5 function + 2 function
# source CSR + 3 bracket-arg + 14 generic symbol + 2 generic symbol child.  A
# column added to a Fill* loop without a term here would silently fall back to
# the doubling path, so the two lists are kept adjacent and must move together.
@borrows
fn TypedExprTypeArenaLimitsColumnRows(
        limits: TypedExprTypeArenaLimits): int64 =
    var rows: int64
    rows = rows + Int64(limits.tokenCount) * Int64(4)
    rows = rows + Int64(limits.typeSyntaxCount) * Int64(20)
    rows = rows + Int64(limits.typeSyntaxChildCount)
    rows = rows + Int64(limits.enumVariantCount) * Int64(5)
    rows = rows + Int64(limits.declarationSymbolCount) * Int64(6)
    rows = rows + Int64(limits.functionCount) * Int64(5)
    rows = rows + Int64(limits.producerSourceCount) * Int64(2)
    rows = rows + Int64(limits.bracketArgCount) * Int64(3)
    rows = rows + Int64(limits.genericSymbolCount) * Int64(14)
    rows = rows + Int64(limits.genericSymbolChildCount) * Int64(2)
    return rows

@borrows
fn TypedExprTypeArenaLimitsColumnBytes(
        limits: TypedExprTypeArenaLimits): int64 =
    return TypedExprTypeArenaLimitsColumnRows(limits) * Int64(4)

# [S1b step-3 (2)] Column limits read from the merged forest: every scalar
# counter is a tree field and the two CSR payload counts are the same tree's
# own payload columns, which is exactly the number of ArenaArrayInt32Add
# calls their Fill* loop makes.  declarationSymbolCount is the one count with
# no scalar field, so it is taken by running the same pure predicate the fill
# loop branches on, once, over the same row range.
@borrows
fn TypedExprTypeArenaLimitsFromTreeInto(
        tree: parser.ParserValueExprTree,
        out: var TypedExprTypeArenaLimits,
        err: var str): bool =
    if !typedExprTypeArenaTreeShape(tree, err):
        return false
    var candidate: TypedExprTypeArenaLimits
    candidate.tokenCount = tree.tokenCount
    candidate.typeSyntaxCount = tree.typeSyntaxCount
    candidate.typeSyntaxChildCount = tree.typeSyntaxChildCount
    candidate.enumVariantCount = tree.typeEnumVariantCount
    candidate.functionCount = tree.declarationFunctionCount
    candidate.bracketArgCount = tree.typeSyntaxBracketArgCount
    candidate.genericSymbolCount = tree.typeGenericSymbolCount
    candidate.genericSymbolChildCount = tree.typeGenericSymbolChildCount
    candidate.producerSourceCount = tree.producerSourceCount
    candidate.declarationSymbolCount =
        typedExprTypeArenaLimitsDeclarationSymbolCount(tree)
    if !typedExprTypeArenaLimitsShape(candidate, err):
        return false
    candidate.columnRows = TypedExprTypeArenaLimitsColumnRows(candidate)
    candidate.columnBytes = TypedExprTypeArenaLimitsColumnBytes(candidate)
    out = candidate
    err = ""
    return true

@borrows
fn typedExprTypeArenaLimitsDeclarationSymbolCount(
        tree: parser.ParserValueExprTree): int32 =
    var count: int32
    for symbolRoot in 0..<tree.typeSyntaxCount:
        if typedExprTypeArenaDeclarationCreatesSymbol(tree, symbolRoot):
            count = count + 1
    return count

# [S1b step-3 (2)] The same limits, summed from the per-source contributions
# the declaration index recorded in pass 0.  This is the derivation the
# per-source streaming driver uses, because it never holds the merged forest.
@borrows
fn TypedExprTypeArenaLimitsFromIndexInto(
        index: TypedExprTypeDeclarationIndex,
        out: var TypedExprTypeArenaLimits,
        err: var str): bool =
    if !index.sealed ||
       index.producerSourceCount <= 0 ||
       index.tokenCountBySource.len != index.producerSourceCount ||
       index.typeSyntaxChildCountBySource.len != index.producerSourceCount ||
       index.enumVariantCountBySource.len != index.producerSourceCount ||
       index.declarationSymbolCountBySource.len !=
           index.producerSourceCount ||
       index.functionCountBySource.len != index.producerSourceCount ||
       index.bracketArgCountBySource.len != index.producerSourceCount ||
       index.genericSymbolCountBySource.len != index.producerSourceCount ||
       index.genericSymbolChildCountBySource.len !=
           index.producerSourceCount:
        err = Fmt" typed expr type arena: column limits index invalid sources={index.producerSourceCount} sealed={index.sealed ? 1 : 0}"
        return false
    var candidate: TypedExprTypeArenaLimits
    candidate.typeSyntaxCount = index.typeSyntaxCount
    candidate.producerSourceCount = index.producerSourceCount
    for source in 0..<index.producerSourceCount:
        candidate.tokenCount =
            candidate.tokenCount + index.tokenCountBySource[source]
        candidate.typeSyntaxChildCount =
            candidate.typeSyntaxChildCount +
                index.typeSyntaxChildCountBySource[source]
        candidate.enumVariantCount =
            candidate.enumVariantCount +
                index.enumVariantCountBySource[source]
        candidate.declarationSymbolCount =
            candidate.declarationSymbolCount +
                index.declarationSymbolCountBySource[source]
        candidate.functionCount =
            candidate.functionCount + index.functionCountBySource[source]
        candidate.bracketArgCount =
            candidate.bracketArgCount +
                index.bracketArgCountBySource[source]
        candidate.genericSymbolCount =
            candidate.genericSymbolCount +
                index.genericSymbolCountBySource[source]
        candidate.genericSymbolChildCount =
            candidate.genericSymbolChildCount +
                index.genericSymbolChildCountBySource[source]
    if !typedExprTypeArenaLimitsShape(candidate, err):
        return false
    # [closure8] Fail-closed SymbolId authority: the index's per-source totals
    # and the index's own SymbolId root rows are two readings of one sealed
    # build, so a disagreement is a defect.  It aborts here, before a single
    # source tree is resident, and is never repaired by a fallback.
    if candidate.declarationSymbolCount !=
           index.declarationSymbolGlobalRoots.len:
        err = Fmt" typed expr type arena: declaration symbol root authority mismatch per_source_sum={candidate.declarationSymbolCount} symbol_roots={index.declarationSymbolGlobalRoots.len} sources={index.producerSourceCount}"
        return false
    # [forward-decl] The declaration generic window is a second reading of the
    # same sealed pass 0 build.  A short table, or a window that walks past the
    # generic-symbol total, is a defect; it aborts here, before a single source
    # tree is resident, and is never repaired by a fallback.
    if index.declarationGenericSymbolStarts.len !=
           index.declarationSymbolGlobalRoots.len ||
       index.declarationGenericSymbolCounts.len !=
           index.declarationSymbolGlobalRoots.len:
        err = Fmt" typed expr type arena: declaration generic window shape invalid symbols={index.declarationSymbolGlobalRoots.len} starts={index.declarationGenericSymbolStarts.len} counts={index.declarationGenericSymbolCounts.len}"
        return false
    for windowSymbolId in 0..<index.declarationGenericSymbolStarts.len:
        let windowStart = index.declarationGenericSymbolStarts[windowSymbolId]
        let windowCount = index.declarationGenericSymbolCounts[windowSymbolId]
        if windowCount < 0 ||
           (windowCount > 0 && windowStart < 0) ||
           Int64(windowStart) + Int64(windowCount) >
               Int64(candidate.genericSymbolCount):
            err = Fmt" typed expr type arena: declaration generic window row invalid symbol={windowSymbolId} start={windowStart} count={windowCount} generic_symbols={candidate.genericSymbolCount}"
            return false
    candidate.columnRows = TypedExprTypeArenaLimitsColumnRows(candidate)
    candidate.columnBytes = TypedExprTypeArenaLimitsColumnBytes(candidate)
    out = candidate
    err = ""
    return true

# Reserving a column is an arena allocation, so it fails hard exactly like
# every other arena allocation primitive: a column that cannot be reserved at
# its exact final length is a defect, not a recoverable condition.
@borrows
fn typedExprTypeArenaReserveColumn(
        arena: var arenamod.Arena,
        capacity: int32,
        columnName: str): arenamod.ArenaArrayInt32 =
    var out: arenamod.ArenaArrayInt32
    if capacity < 0:
        panic(Fmt"typed expr type arena: negative column reserve column={columnName} capacity={capacity}")
    if !arenamod.ArenaArrayInt32ReserveEmpty(arena, out, capacity):
        panic(Fmt"typed expr type arena: column reserve failed column={columnName} capacity={capacity}")
    return out

# [X1b-ta-scratch] Reserve a scratch column and fill it to full length once, so
# every later per-row access is an in-place `ArenaArrayInt32Set`/`Get` and the
# arena bump top never abandons a block (contrast `ArenaArrayInt32Add`, which
# doubles and abandons; see the note on `typedExprTypeArenaReserveColumn`).
fn typedExprTypeArenaReserveFilledColumn(
        arena: var arenamod.Arena,
        capacity: int32,
        columnName: str): arenamod.ArenaArrayInt32 =
    var out: arenamod.ArenaArrayInt32
    if capacity < 0:
        panic(Fmt"typed expr type arena: negative scratch reserve column={columnName} capacity={capacity}")
    if !arenamod.ArenaArrayInt32ReserveEmpty(arena, out, capacity):
        panic(Fmt"typed expr type arena: scratch reserve failed column={columnName} capacity={capacity}")
    var fillIndex: int32
    while fillIndex < capacity:
        arenamod.ArenaArrayInt32AddReserved(arena, out, 0)
        fillIndex = fillIndex + 1
    return out

# [S1b step-3 (2)] Preallocate every appended arena column at its exact final
# length.  ArenaArrayInt32Add grows a full column by doubling at the arena
# bump top and abandons the previous block in place (arena.cheng:373), so a
# column filled through Add permanently holds up to twice its live bytes and
# those abandoned pages are resident.  Add only takes the grow branch when
# len >= capacity, so reserving the exact length first means it never does;
# the six Fill* families and their values are untouched byte for byte.
@borrows
fn typedExprTypeArenaReserveColumns(
        value: var TypedExprTypeArena,
        limits: TypedExprTypeArenaLimits) =
    value.tokenProducerSourceIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.tokenCount, "tokenProducerSourceIndexes")
    value.tokenKinds = typedExprTypeArenaReserveColumn(
        value.arena, limits.tokenCount, "tokenKinds")
    value.tokenSpanStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.tokenCount, "tokenSpanStarts")
    value.tokenSpanEnds = typedExprTypeArenaReserveColumn(
        value.arena, limits.tokenCount, "tokenSpanEnds")
    value.typeSyntaxTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxTypeIds")
    value.typeSyntaxParserKinds = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxParserKinds")
    value.typeSyntaxProducerSourceIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount,
        "typeSyntaxProducerSourceIndexes")
    value.typeSyntaxSourceLocalRows = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxSourceLocalRows")
    value.typeSyntaxSpanStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxSpanStarts")
    value.typeSyntaxSpanEnds = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxSpanEnds")
    value.typeSyntaxOwnerTokenIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxOwnerTokenIndexes")
    value.typeSyntaxQuestionTokenIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount,
        "typeSyntaxQuestionTokenIndexes")
    value.typeSyntaxDeclarationOwnerTokenIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.typeSyntaxCount,
            "typeSyntaxDeclarationOwnerTokenIndexes")
    value.typeSyntaxDeclarationOwnerNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.typeSyntaxCount,
            "typeSyntaxDeclarationOwnerNodeIndexes")
    value.typeSyntaxGenericSymbolStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxGenericSymbolStarts")
    value.typeSyntaxGenericSymbolCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxGenericSymbolCounts")
    value.typeSyntaxRootKinds = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxRootKinds")
    value.typeSyntaxBracketArgStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxBracketArgStarts")
    value.typeSyntaxBracketArgCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxBracketArgCounts")
    value.typeSyntaxBracketBaseTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.typeSyntaxCount,
            "typeSyntaxBracketBaseTypeSyntaxNodeIndexes")
    value.typeSyntaxChildStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxChildStarts")
    value.typeSyntaxChildCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxChildCounts")
    value.typeSyntaxEnumVariantStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxEnumVariantStarts")
    value.typeSyntaxEnumVariantCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxEnumVariantCounts")
    value.typeSyntaxFixedLengthsByRow = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxCount, "typeSyntaxFixedLengthsByRow")
    value.typeSyntaxFunctionParamCountsByRow =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.typeSyntaxCount,
            "typeSyntaxFunctionParamCountsByRow")
    value.typeSyntaxChildNameIdsByRow = typedExprTypeArenaReserveColumn(
        value.arena, limits.typeSyntaxChildCount,
        "typeSyntaxChildNameIdsByRow")
    value.typeSyntaxChildTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.typeSyntaxChildCount,
            "typeSyntaxChildTypeSyntaxNodeIndexes")
    value.typeSyntaxEnumVariantPayloadTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.enumVariantCount,
            "typeSyntaxEnumVariantPayloadTypeSyntaxNodeIndexes")
    value.typeSyntaxEnumVariantProducerSourceIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.enumVariantCount,
            "typeSyntaxEnumVariantProducerSourceIndexes")
    value.typeSyntaxEnumVariantDeclarationOwnerNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.enumVariantCount,
            "typeSyntaxEnumVariantDeclarationOwnerNodeIndexes")
    value.typeSyntaxEnumVariantDeclarationOwnerTokenIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.enumVariantCount,
            "typeSyntaxEnumVariantDeclarationOwnerTokenIndexes")
    value.typeSyntaxEnumVariantOrdinals = typedExprTypeArenaReserveColumn(
        value.arena, limits.enumVariantCount,
        "typeSyntaxEnumVariantOrdinals")
    value.symbolDeclarationRootTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.declarationSymbolCount,
            "symbolDeclarationRootTypeSyntaxNodeIndexes")
    value.symbolProducerSourceIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.declarationSymbolCount,
        "symbolProducerSourceIndexes")
    value.symbolDeclarationOwnerTokenIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.declarationSymbolCount,
            "symbolDeclarationOwnerTokenIndexes")
    value.symbolNameIds = typedExprTypeArenaReserveColumn(
        value.arena, limits.declarationSymbolCount, "symbolNameIds")
    value.symbolMemberStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.declarationSymbolCount, "symbolMemberStarts")
    value.symbolMemberCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.declarationSymbolCount, "symbolMemberCounts")
    value.functionProducerSourceIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.functionCount, "functionProducerSourceIndexes")
    value.functionSourceLocalRows = typedExprTypeArenaReserveColumn(
        value.arena, limits.functionCount, "functionSourceLocalRows")
    value.functionDeclarationSourceLocalRows =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.functionCount,
            "functionDeclarationSourceLocalRows")
    value.functionOwnerTokenIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.functionCount, "functionOwnerTokenIndexes")
    # [X1b-ta-scratch] Per-append scratch for the function fill, reused across
    # every source instead of reallocated per source.
    value.functionScratchProducerByRow = typedExprTypeArenaReserveFilledColumn(
        value.arena, limits.functionCount, "functionScratchProducerByRow")
    value.functionScratchSourceLocalByRow =
        typedExprTypeArenaReserveFilledColumn(
            value.arena, limits.functionCount,
            "functionScratchSourceLocalByRow")
    value.functionScratchDeclarationLocalByRow =
        typedExprTypeArenaReserveFilledColumn(
            value.arena, limits.functionCount,
            "functionScratchDeclarationLocalByRow")
    value.functionScratchOwnerTokenByRow =
        typedExprTypeArenaReserveFilledColumn(
            value.arena, limits.functionCount,
            "functionScratchOwnerTokenByRow")
    value.functionScratchSeenByRow = typedExprTypeArenaReserveFilledColumn(
        value.arena, limits.functionCount, "functionScratchSeenByRow")
    value.functionScratchSourceStarts = typedExprTypeArenaReserveFilledColumn(
        value.arena, limits.producerSourceCount, "functionScratchSourceStarts")
    value.functionScratchSourceCounts = typedExprTypeArenaReserveFilledColumn(
        value.arena, limits.producerSourceCount, "functionScratchSourceCounts")
    value.functionReturnTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, limits.functionCount, "functionReturnTypeIds")
    value.functionSourceStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.producerSourceCount, "functionSourceStarts")
    value.functionSourceCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.producerSourceCount, "functionSourceCounts")
    value.bracketArgTokenStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.bracketArgCount, "bracketArgTokenStarts")
    value.bracketArgTokenCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.bracketArgCount, "bracketArgTokenCounts")
    value.bracketArgTypeSyntaxNodeIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.bracketArgCount,
        "bracketArgTypeSyntaxNodeIndexes")
    value.genericSymbolProducerSourceIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.genericSymbolCount,
            "genericSymbolProducerSourceIndexes")
    value.genericSymbolDeclarationOwnerTokenIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.genericSymbolCount,
            "genericSymbolDeclarationOwnerTokenIndexes")
    value.genericSymbolNameTokenIndexes = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount,
        "genericSymbolNameTokenIndexes")
    value.genericSymbolNameIds = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount, "genericSymbolNameIds")
    value.genericSymbolOrdinals = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount, "genericSymbolOrdinals")
    value.genericSymbolSpanStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount, "genericSymbolSpanStarts")
    value.genericSymbolSpanEnds = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount, "genericSymbolSpanEnds")
    value.genericSymbolOwnerTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.genericSymbolCount,
            "genericSymbolOwnerTypeSyntaxNodeIndexes")
    value.genericSymbolConstraintTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.genericSymbolCount,
            "genericSymbolConstraintTypeSyntaxNodeIndexes")
    value.genericSymbolDefaultTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.genericSymbolCount,
            "genericSymbolDefaultTypeSyntaxNodeIndexes")
    value.genericSymbolConstraintTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount,
        "genericSymbolConstraintTypeIds")
    value.genericSymbolDefaultTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount, "genericSymbolDefaultTypeIds")
    value.genericSymbolChildStarts = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount, "genericSymbolChildStarts")
    value.genericSymbolChildCounts = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolCount, "genericSymbolChildCounts")
    value.genericSymbolChildTypeSyntaxNodeIndexes =
        typedExprTypeArenaReserveColumn(
            value.arena, limits.genericSymbolChildCount,
            "genericSymbolChildTypeSyntaxNodeIndexes")
    value.genericSymbolChildTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, limits.genericSymbolChildCount,
        "genericSymbolChildTypeIds")

# [S1a] Completeness proof.  The forest side is re-derived here exactly the
# way TypedExprTypeResolutionAuthorityBuildPackageForestInto derives it, in
# the forest's own row order; the index side is compared entry by entry, so a
# pass means every (producerSourceIndex, name) key, global TypeSyntax root,
# global declaration row, declaration kind and exported flag the resolution
# authority can read is present in the index byte for byte.  The per-source
# prefix sums are checked against the forest's own source-local row columns.
@borrows
fn TypedExprTypeDeclarationIndexVerifyAgainstForestInto(
        tree: parser.ParserValueExprTree,
        index: TypedExprTypeDeclarationIndex,
        err: var str): bool =
    if !typedExprTypeArenaTreeShape(tree, err):
        return false
    if !typedExprTypeDeclarationIndexShape(
           index,
           tree.producerSourceCount,
           tree.typeSyntaxCount,
           tree.declarationCount,
           err):
        return false
    var declarationRowByRoot: int32[]
    if !typedExprTypeDeclarationRowByRootInto(
           tree, declarationRowByRoot, err):
        return false
    var indexCursor: int32
    for typeSyntaxRow in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(
               tree, typeSyntaxRow) !=
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            continue
        if indexCursor >= index.producerSourceIndexes.len:
            err = Fmt" typed expr type arena: declaration index entry missing forest_root={typeSyntaxRow}"
            return false
        let forestSource =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                tree, typeSyntaxRow)
        let forestDeclarationRow = declarationRowByRoot[typeSyntaxRow]
        let forestName = parser.ParserValueExprTokenText(
            tree,
            parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                tree, typeSyntaxRow))
        if index.producerSourceIndexes[indexCursor] != forestSource ||
           index.globalTypeSyntaxRoots[indexCursor] != typeSyntaxRow ||
           index.declarationNameTexts[indexCursor] != forestName ||
           index.globalDeclarationRows[indexCursor] !=
               forestDeclarationRow ||
           index.declarationKinds[indexCursor] !=
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationKinds,
                   forestDeclarationRow) ||
           index.declarationExportedFlags[indexCursor] !=
               (arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationExportedFlags,
                    forestDeclarationRow) != 0):
            err = Fmt" typed expr type arena: declaration index forest mismatch forest_root={typeSyntaxRow} cursor={indexCursor} forest_source={forestSource} index_source={index.producerSourceIndexes[indexCursor]} index_root={index.globalTypeSyntaxRoots[indexCursor]}"
            return false
        indexCursor = indexCursor + 1
    if indexCursor != index.producerSourceIndexes.len:
        err = Fmt" typed expr type arena: declaration index entry coverage mismatch forest={indexCursor} index={index.producerSourceIndexes.len}"
        return false
    var typeSyntaxCountBySource: int32[]
    var declarationCountBySource: int32[]
    setLen(typeSyntaxCountBySource, tree.producerSourceCount)
    setLen(declarationCountBySource, tree.producerSourceCount)
    for row in 0..<typeSyntaxCountBySource.len:
        typeSyntaxCountBySource[row] = 0
        declarationCountBySource[row] = 0
    for typeSyntaxRow in 0..<tree.typeSyntaxCount:
        let source = parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
            tree, typeSyntaxRow)
        let localRow = parser.ParserValueExprTypeSyntaxSourceLocalRowAt(
            tree, typeSyntaxRow)
        if source < 0 || source >= tree.producerSourceCount ||
           localRow < 0 || localRow >= tree.typeSyntaxCount ||
           typeSyntaxRow - localRow !=
               index.typeSyntaxBaseBySource[source]:
            err = Fmt" typed expr type arena: declaration index TypeSyntax partition mismatch row={typeSyntaxRow} source={source} local={localRow}"
            return false
        typeSyntaxCountBySource[source] = typeSyntaxCountBySource[source] + 1
    for declarationRow in 0..<tree.declarationCount:
        let source = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        let localRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSourceLocalRows, declarationRow)
        if source < 0 || source >= tree.producerSourceCount ||
           localRow < 0 || localRow >= tree.declarationCount ||
           declarationRow - localRow !=
               index.declarationBaseBySource[source]:
            err = Fmt" typed expr type arena: declaration index declaration partition mismatch row={declarationRow} source={source} local={localRow}"
            return false
        declarationCountBySource[source] =
            declarationCountBySource[source] + 1
    var expectedTypeSyntaxBase: int32
    var expectedDeclarationBase: int32
    for sourceIndex in 0..<tree.producerSourceCount:
        if index.typeSyntaxBaseBySource[sourceIndex] !=
               expectedTypeSyntaxBase ||
           index.declarationBaseBySource[sourceIndex] !=
               expectedDeclarationBase:
            err = Fmt" typed expr type arena: declaration index prefix sum mismatch source_index={sourceIndex} type_syntax_expected={expectedTypeSyntaxBase} type_syntax_index={index.typeSyntaxBaseBySource[sourceIndex]} declarations_expected={expectedDeclarationBase} declarations_index={index.declarationBaseBySource[sourceIndex]}"
            return false
        expectedTypeSyntaxBase = expectedTypeSyntaxBase +
                                 typeSyntaxCountBySource[sourceIndex]
        expectedDeclarationBase = expectedDeclarationBase +
                                  declarationCountBySource[sourceIndex]
    if expectedTypeSyntaxBase != tree.typeSyntaxCount ||
       expectedDeclarationBase != tree.declarationCount:
        err = Fmt" typed expr type arena: declaration index partition coverage mismatch type_syntax={expectedTypeSyntaxBase} declarations={expectedDeclarationBase}"
        return false
    err = ""
    return true

# [S1b-0b] Read side of the S1a declaration index.  The materialization pass
# resolves declarations from the index alone in global row space, so these
# helpers must reproduce the exact key and order semantics the forest-based
# authority used (typedExprTypeAuthorityDeclarationLess /
# typedExprTypeAuthorityDeclarationKeyEqual) without a tree.

@borrows
fn typedExprTypeDeclarationIndexEntryLess(
        index: TypedExprTypeDeclarationIndex,
        leftEntry: int32,
        rightEntry: int32): bool =
    if index.producerSourceIndexes[leftEntry] !=
       index.producerSourceIndexes[rightEntry]:
        return index.producerSourceIndexes[leftEntry] <
               index.producerSourceIndexes[rightEntry]
    if index.declarationNameTexts[leftEntry] !=
       index.declarationNameTexts[rightEntry]:
        return typedExprTypeAuthorityTextLess(
            index.declarationNameTexts[leftEntry],
            index.declarationNameTexts[rightEntry])
    return index.globalTypeSyntaxRoots[leftEntry] <
           index.globalTypeSyntaxRoots[rightEntry]

# The key equality the authority applies when it accepts a declaration: the
# (producerSourceIndex, name) pair.  Exportedness is a separate query.
@borrows
fn typedExprTypeDeclarationIndexEntryKeyEqual(
        index: TypedExprTypeDeclarationIndex,
        entryRow: int32,
        producerSourceIndex: int32,
        name: str): bool =
    return index.producerSourceIndexes[entryRow] == producerSourceIndex &&
           index.declarationNameTexts[entryRow] == name

@borrows
fn typedExprTypeDeclarationIndexEntryExported(
        index: TypedExprTypeDeclarationIndex,
        entryRow: int32): bool =
    return index.declarationExportedFlags[entryRow]

# globalTypeSyntaxRoots is strictly ascending by construction: entries are
# appended in (source order, source-local TypeSyntax row) order and the global
# root is typeSyntaxBase + local row with ascending bases, so the
# global-root -> entry join is a binary search, not a scan.
@borrows
fn typedExprTypeDeclarationIndexEntryForRoot(
        index: TypedExprTypeDeclarationIndex,
        globalTypeSyntaxRoot: int32): int32 =
    var low: int32
    var high = index.globalTypeSyntaxRoots.len
    while low < high:
        let middle = low + (high - low) / 2
        if index.globalTypeSyntaxRoots[middle] < globalTypeSyntaxRoot:
            low = middle + 1
        else:
            high = middle
    if low >= index.globalTypeSyntaxRoots.len ||
       index.globalTypeSyntaxRoots[low] != globalTypeSyntaxRoot:
        return -1
    return low

fn typedExprTypeDeclarationIndexSwapEntryRows(values: var int32[],
                                              left: int32,
                                              right: int32) =
    let saved = values[left]
    values[left] = values[right]
    values[right] = saved

@borrows
fn typedExprTypeDeclarationIndexEntrySiftDown(
        index: TypedExprTypeDeclarationIndex,
        values: var int32[],
        start: int32,
        count: int32) =
    var root = start
    while true:
        let left = root * 2 + 1
        if left >= count:
            return
        var selected = left
        let right = left + 1
        if right < count &&
           typedExprTypeDeclarationIndexEntryLess(
               index, values[selected], values[right]):
            selected = right
        if !typedExprTypeDeclarationIndexEntryLess(
               index, values[root], values[selected]):
            return
        typedExprTypeDeclarationIndexSwapEntryRows(values, root, selected)
        root = selected

# Sorted entry-row permutation over the index.  Index row order is merge
# order, not key order, so the authority's binary search needs this view.
# The sort is the same in-place heap sort the root-space authority used, so
# ties break by entry row exactly as they did by forest root.
@borrows
fn TypedExprTypeDeclarationIndexSortedEntryRowsInto(
        index: TypedExprTypeDeclarationIndex,
        out: var int32[],
        err: var str): bool =
    if out.len != 0:
        err = " typed expr type arena: declaration index sorted view destination is not empty"
        return false
    if !index.sealed:
        err = " typed expr type arena: declaration index sorted view requires a sealed index"
        return false
    var values: int32[]
    setLen(values, index.producerSourceIndexes.len)
    for row in 0..<values.len:
        values[row] = row
    let parentCount = values.len / 2
    for reverse in 0..<parentCount:
        typedExprTypeDeclarationIndexEntrySiftDown(
            index, values, parentCount - 1 - reverse, values.len)
    if values.len > 1:
        for reverse in 0..<values.len - 1:
            let endExclusive = values.len - reverse
            typedExprTypeDeclarationIndexSwapEntryRows(
                values, 0, endExclusive - 1)
            typedExprTypeDeclarationIndexEntrySiftDown(
                index, values, 0, endExclusive - 1)
    out = values
    err = ""
    return true

# [S1b-0f] Per-source slice of the declaration-index completeness proof.  The
# whole-forest gate above can only run while the merged forest is resident;
# once sources are consumed one at a time the proof must be taken source by
# source, against the very tree the entry was extracted from.  The slice
# checks the same facts (key, global root, global declaration row, kind,
# exported flag) plus the two prefix sums, so N passing slices plus the final
# base reconciliation is the same statement as one passing whole-forest pass.
@borrows
fn TypedExprTypeDeclarationIndexVerifySourceAgainstInto(
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        typeSyntaxBase: int32,
        declarationBase: int32,
        index: TypedExprTypeDeclarationIndex,
        err: var str): bool =
    if tree == nil ||
       tree.lifecycleState != parser.ParserValueExprOwnerActive ||
       tree.producerSourceCount != 1 ||
       producerSourceIndex < 0 ||
       typeSyntaxBase < 0 || declarationBase < 0:
        err = " typed expr type arena: declaration index source verify input invalid"
        return false
    if !typedExprTypeArenaTreeShape(tree, err):
        return false
    if !index.sealed ||
       index.producerSourceCount <= producerSourceIndex ||
       index.typeSyntaxBaseBySource.len != index.producerSourceCount ||
       index.declarationSymbolCountBySource.len != index.producerSourceCount ||
       index.declarationBaseBySource.len != index.producerSourceCount:
        err = Fmt" typed expr type arena: declaration index source verify index invalid source_index={producerSourceIndex} sources={index.producerSourceCount} sealed={index.sealed ? 1 : 0}"
        return false
    if index.typeSyntaxBaseBySource[producerSourceIndex] != typeSyntaxBase ||
       index.declarationBaseBySource[producerSourceIndex] != declarationBase:
        err = Fmt" typed expr type arena: declaration index source base mismatch source_index={producerSourceIndex} type_syntax_expected={typeSyntaxBase} type_syntax_index={index.typeSyntaxBaseBySource[producerSourceIndex]} declarations_expected={declarationBase} declarations_index={index.declarationBaseBySource[producerSourceIndex]}"
        return false
    var declarationRowByRoot: int32[]
    if !typedExprTypeDeclarationRowByRootInto(
           tree, declarationRowByRoot, err):
        return false
    var expectedTypeSyntaxRows: int32
    for typeSyntaxRow in 0..<tree.typeSyntaxCount:
        let localRow = parser.ParserValueExprTypeSyntaxSourceLocalRowAt(
            tree, typeSyntaxRow)
        if localRow < 0 || localRow >= tree.typeSyntaxCount:
            err = Fmt" typed expr type arena: declaration index source local row invalid root={typeSyntaxRow} local={localRow}"
            return false
        expectedTypeSyntaxRows = expectedTypeSyntaxRows + 1
        if parser.ParserValueExprTypeSyntaxRootKindAt(
               tree, typeSyntaxRow) !=
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            continue
        let declarationRow = declarationRowByRoot[typeSyntaxRow]
        if declarationRow < 0 || declarationRow >= tree.declarationCount:
            err = Fmt" typed expr type arena: declaration index source root/DeclId join missing root={typeSyntaxRow}"
            return false
        let entryRow = typedExprTypeDeclarationIndexEntryForRoot(
            index, typeSyntaxBase + localRow)
        if entryRow < 0:
            err = Fmt" typed expr type arena: declaration index source entry missing source_index={producerSourceIndex} global_root={typeSyntaxBase + localRow}"
            return false
        if index.producerSourceIndexes[entryRow] != producerSourceIndex ||
           !typedExprTypeDeclarationIndexEntryKeyEqual(
               index,
               entryRow,
               producerSourceIndex,
               parser.ParserValueExprTokenText(
                   tree,
                   parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                       tree, typeSyntaxRow))) ||
           index.globalDeclarationRows[entryRow] !=
               declarationBase + declarationRow ||
           index.declarationKinds[entryRow] !=
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationKinds,
                   declarationRow) ||
           index.declarationExportedFlags[entryRow] !=
               (arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationExportedFlags,
                    declarationRow) != 0):
            err = Fmt" typed expr type arena: declaration index source entry mismatch source_index={producerSourceIndex} global_root={typeSyntaxBase + localRow} entry={entryRow} entry_source={index.producerSourceIndexes[entryRow]} entry_decl={index.globalDeclarationRows[entryRow]}"
            return false
    if expectedTypeSyntaxRows != tree.typeSyntaxCount:
        err = Fmt" typed expr type arena: declaration index source TypeSyntax coverage mismatch source_index={producerSourceIndex} rows={expectedTypeSyntaxRows} types={tree.typeSyntaxCount}"
        return false
    # The next source's base must be this source's base plus this source's
    # exact row counts; the last source reconciles against the index totals.
    let expectedNextTypeSyntaxBase =
        typeSyntaxBase + tree.typeSyntaxCount
    let expectedNextDeclarationBase =
        declarationBase + tree.declarationCount
    if producerSourceIndex + 1 < index.producerSourceCount:
        let nextSourceIndex = producerSourceIndex + 1
        let nextTypeSyntaxBase = index.typeSyntaxBaseBySource[nextSourceIndex]
        let nextDeclarationBase =
            index.declarationBaseBySource[nextSourceIndex]
        if nextTypeSyntaxBase != expectedNextTypeSyntaxBase ||
           nextDeclarationBase != expectedNextDeclarationBase:
            err = Fmt" typed expr type arena: declaration index source prefix sum mismatch source_index={producerSourceIndex} next_type_syntax_expected={expectedNextTypeSyntaxBase} next_type_syntax_index={nextTypeSyntaxBase} next_declarations_expected={expectedNextDeclarationBase} next_declarations_index={nextDeclarationBase}"
            return false
    else:
        if expectedNextTypeSyntaxBase != index.typeSyntaxCount ||
           expectedNextDeclarationBase != index.declarationCount:
            err = Fmt" typed expr type arena: declaration index source total mismatch source_index={producerSourceIndex} type_syntax={expectedNextTypeSyntaxBase} declarations={expectedNextDeclarationBase} index_type_syntax={index.typeSyntaxCount} index_declarations={index.declarationCount}"
            return false
    # [closure8] The SymbolId slice this source owns, verified against the
    # resident tree: the slice is exactly the roots this tree accepts, in this
    # tree's own row order, at this source's global rows.  The bases and the
    # prefix sums above are already reconciled, so this closes the SymbolId
    # authority of the whole forest one source at a time.
    var symbolRootBase: int32
    for source in 0..<producerSourceIndex:
        symbolRootBase =
            symbolRootBase + index.declarationSymbolCountBySource[source]
    var expectedSymbolRoots: int32[]
    if !typedExprTypeArenaAppendDeclarationSymbolRootsFromTreeInto(
           tree, typeSyntaxBase, expectedSymbolRoots, err):
        return false
    if expectedSymbolRoots.len !=
           index.declarationSymbolCountBySource[producerSourceIndex]:
        err = Fmt" typed expr type arena: declaration symbol root count mismatch source_index={producerSourceIndex} tree_roots={expectedSymbolRoots.len} index_count={index.declarationSymbolCountBySource[producerSourceIndex]}"
        return false
    for offset in 0..<expectedSymbolRoots.len:
        let symbolId = symbolRootBase + offset
        if symbolId >= index.declarationSymbolGlobalRoots.len ||
           index.declarationSymbolGlobalRoots[symbolId] !=
               expectedSymbolRoots[offset]:
            err = Fmt" typed expr type arena: declaration symbol root slice mismatch source_index={producerSourceIndex} symbol={symbolId} tree_root={expectedSymbolRoots[offset]} index_root={symbolId < index.declarationSymbolGlobalRoots.len ? index.declarationSymbolGlobalRoots[symbolId] : -1}"
            return false
    err = ""
    return true

# [S1b step-3 (3)] The single allocation site for every global-row-space array
# the build state owns.  Sizes come from the caller -- the merged forest's own
# counts for the whole-forest driver, the sealed declaration index's totals for
# the per-source driver -- and are the same integers, so the whole-forest path
# allocates exactly what it used to.  `tree` is deliberately not an input: the
# per-source driver must be able to allocate before any source tree exists.
# ---------------------------------------------------------------------------
# [S1b step-3 (6)] Streaming resolution authority.
#
# The whole-forest builder answered four cross-source questions by walking the
# merged tree: which declaration root carries (source, name); whether that
# root's declaration row is exported; where a qualified import alias leads; and
# which generic symbol a declaration root introduces.  The sealed declaration
# index is exactly that projection, taken source by source in pass 0 while each
# single-source tree was still resident.  The streaming builder therefore keeps
# only the current source's tree and asks the index for every cross-source
# fact; the per-source pass over the tree is the same pass the forest builder
# ran over the merged rows, and its emitted rows are the same global rows in
# the same ascending order.
# ---------------------------------------------------------------------------
@borrows

# The forest form binary-searched `sortedDeclarationRoots` with
# `typedExprTypeAuthorityDeclarationBeforeKey`.  The index entry order is
# (producerSourceIndex, declaration name text, global root), which is that same
# key order plus a total tie-break, and the same-source duplicate the forest
# form rejects cannot exist here, so the first entry at or after the key is the
# same declaration and the returned global root is the same coordinate.
@borrows
fn typedExprTypeAuthorityIndexFindDeclaration(
        index: TypedExprTypeDeclarationIndex,
        sortedEntryRows: int32[],
        producerSourceIndex: int32,
        name: str): int32 =
    var low: int32
    var high = sortedEntryRows.len
    while low < high:
        let middle = low + (high - low) / 2
        let entryRow = sortedEntryRows[middle]
        let entrySource = index.producerSourceIndexes[entryRow]
        if entrySource < producerSourceIndex ||
           (entrySource == producerSourceIndex &&
            typedExprTypeAuthorityTextLess(
                index.declarationNameTexts[entryRow], name)):
            low = middle + 1
        else:
            high = middle
    if low >= sortedEntryRows.len:
        return -1
    let entryRow = sortedEntryRows[low]
    if !typedExprTypeDeclarationIndexEntryKeyEqual(
           index, entryRow, producerSourceIndex, name):
        return -1
    return index.globalTypeSyntaxRoots[entryRow]

@borrows
fn typedExprTypeAuthorityIndexDeclarationExportedInto(
        index: TypedExprTypeDeclarationIndex,
        declarationRoot: int32,
        exportedOut: var bool,
        err: var str): bool =
    exportedOut = false
    let entryRow = typedExprTypeDeclarationIndexEntryForRoot(
        index, declarationRoot)
    if entryRow < 0:
        err = " typed expr type arena: declaration root/DeclId join missing"
        return false
    exportedOut = typedExprTypeDeclarationIndexEntryExported(index, entryRow)
    return true

# [nominal-sweep] Enumeration mode for the cross-source name authority.
#
# `typedExprTypeAuthorityIndexResolveUnqualifiedInto` rejects a nominal that
# neither a declaration in its own source nor any import edge can reach, and
# `TypedExprTypeResolutionAuthorityAppendSourceInto` is where the failing
# TypeSyntax row and the structural root it walked to are both still bound.
# The whole-forest driver stops at the FIRST such name, which is why fixing the
# forest costs one rebuild per name.  This table keeps every rejection instead
# of the first one, so a single run enumerates the whole forest.
#
# The table is inert unless `TypedExprTypeNominalSweepBegin` has been called.
# The driver calls it only inside its `CHENG_NOMINAL_SWEEP` branch, so a default
# compile never appends a row and never reads one.
var typedExprTypeNominalSweepActive: bool
var typedExprTypeNominalSweepSourceIndexes: int32[]
var typedExprTypeNominalSweepTypeSyntaxRows: int32[]
var typedExprTypeNominalSweepRootRows: int32[]
var typedExprTypeNominalSweepNames: str[]
var typedExprTypeNominalSweepReasons: str[]

# Arm the table.  Called once per process, before the sweep's first append.
fn TypedExprTypeNominalSweepBegin() =
    typedExprTypeNominalSweepActive = true

# One rejected (producerSourceIndex, name) pair, with the two source-LOCAL rows
# that locate it: `typeSyntaxRow` is the nominal's own TypeSyntax row and
# `rootRow` is the structural root the generic-parameter walk landed on.
# `reason` is the resolver's own message, taken verbatim.
#
# Both text columns take their own copy: the call site still owns `name` and
# still owns the error string it is about to return, so the note borrows them
# (`@borrows`) and stores clones rather than moving either one out.
@borrows
fn typedExprTypeNominalSweepNote(
        producerSourceIndex: int32,
        typeSyntaxRow: int32,
        rootRow: int32,
        name: str,
        reason: str) =
    if !typedExprTypeNominalSweepActive:
        return
    add(typedExprTypeNominalSweepSourceIndexes, producerSourceIndex)
    add(typedExprTypeNominalSweepTypeSyntaxRows, typeSyntaxRow)
    add(typedExprTypeNominalSweepRootRows, rootRow)
    add(typedExprTypeNominalSweepNames, strings.CloneStr(name))
    add(typedExprTypeNominalSweepReasons, strings.CloneStr(reason))

fn TypedExprTypeNominalSweepCount(): int32 =
    return typedExprTypeNominalSweepSourceIndexes.len

fn TypedExprTypeNominalSweepSourceIndexAt(row: int32): int32 =
    return typedExprTypeNominalSweepSourceIndexes[row]

fn TypedExprTypeNominalSweepTypeSyntaxRowAt(row: int32): int32 =
    return typedExprTypeNominalSweepTypeSyntaxRows[row]

fn TypedExprTypeNominalSweepRootRowAt(row: int32): int32 =
    return typedExprTypeNominalSweepRootRows[row]

# The two text columns are cloned out: the table is module state that keeps
# growing while the caller still holds the returned text, so handing back a
# borrow of a row would alias storage a later `add` may move.
@borrows
fn TypedExprTypeNominalSweepNameAt(row: int32): str =
    return strings.CloneStr(typedExprTypeNominalSweepNames[row])

@borrows
fn TypedExprTypeNominalSweepReasonAt(row: int32): str =
    return strings.CloneStr(typedExprTypeNominalSweepReasons[row])

@borrows
fn typedExprTypeAuthorityIndexResolveUnqualifiedInto(
        index: TypedExprTypeDeclarationIndex,
        sortedEntryRows: int32[],
        imports: TypedExprTypeImportAuthority,
        sortedImportRows: int32[],
        producerSourceIndex: int32,
        name: str,
        declarationRootOut: var int32,
        err: var str): bool =
    declarationRootOut = typedExprTypeAuthorityIndexFindDeclaration(
        index, sortedEntryRows, producerSourceIndex, name)
    if declarationRootOut >= 0:
        return true
    var matchedRoot: int32 = -1
    for sortedOffset in 0..<sortedImportRows.len:
        let importRow = sortedImportRows[sortedOffset]
        let ownerSourceIndex = imports.ownerSourceIndexes[importRow]
        if ownerSourceIndex < producerSourceIndex:
            continue
        if ownerSourceIndex > producerSourceIndex:
            break
        if !imports.allowsUnqualified[importRow]:
            continue
        let candidateRoot = typedExprTypeAuthorityIndexFindDeclaration(
            index,
            sortedEntryRows,
            imports.targetSourceIndexes[importRow],
            name)
        if candidateRoot < 0:
            continue
        var exported: bool
        if !typedExprTypeAuthorityIndexDeclarationExportedInto(
               index,
               candidateRoot,
               exported,
               err):
            return false
        if !exported:
            # [not-exported coords] Diagnostic only; no behaviour change.  The
            # verdict named nothing, so a non-sweep run could not say which
            # name/source/target tripped it.  Export is decided by
            # `ParserValueExprDeclarationExportedAt` (parser.cheng) as
            # "first character is ASCII A-Z", i.e. spec 1.4 verbatim.
            err = Fmt" typed expr type arena: imported type is not exported name={name} producer_source={producerSourceIndex} target_source={imports.targetSourceIndexes[importRow]} declaration_root={candidateRoot}"
            return false
        if matchedRoot >= 0 && matchedRoot != candidateRoot:
            err = " typed expr type arena: unqualified imported nominal is ambiguous"
            return false
        matchedRoot = candidateRoot
    if matchedRoot < 0:
        err = Fmt" typed expr type arena: nominal declaration is not visible producer_source={producerSourceIndex} name={name}"
        return false
    declarationRootOut = matchedRoot
    return true

@borrows
fn typedExprTypeAuthorityIndexResolveQualifiedInto(
        tree: parser.ParserValueExprTree,
        localTypeSyntaxNodeIndex: int32,
        producerSourceIndex: int32,
        index: TypedExprTypeDeclarationIndex,
        sortedEntryRows: int32[],
        imports: TypedExprTypeImportAuthority,
        sortedImportRows: int32[],
        declarationRootOut: var int32,
        err: var str): bool =
    declarationRootOut = -1
    let childCount = parser.ParserValueExprTypeSyntaxChildCountAt(
        tree, localTypeSyntaxNodeIndex)
    if childCount < 2:
        err = " typed expr type arena: qualified nominal path incomplete"
        return false
    var currentSourceIndex = producerSourceIndex
    for childOffset in 0..<childCount - 1:
        let child = parser.ParserValueExprTypeSyntaxChildAt(
            tree, localTypeSyntaxNodeIndex, childOffset)
        if parser.ParserValueExprTypeSyntaxKindAt(tree, child) !=
               parser.ParserTypeSyntaxNominal ||
           parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
               tree, child) !=
               parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, localTypeSyntaxNodeIndex):
            err = " typed expr type arena: qualified nominal segment invalid"
            return false
        let qualifier = parser.ParserValueExprTokenText(
            tree,
            parser.ParserValueExprTypeSyntaxNameTokenAt(tree, child))
        if typedExprTypeAuthorityIndexFindDeclaration(
               index, sortedEntryRows, currentSourceIndex, qualifier) >= 0:
            err = " typed expr type arena: import qualifier is shadowed"
            return false
        let targetSourceIndex = typedExprTypeImportAuthorityFindTarget(
            imports, sortedImportRows, currentSourceIndex, qualifier)
        if targetSourceIndex < 0:
            err = " typed expr type arena: qualified import alias is not visible"
            return false
        currentSourceIndex = targetSourceIndex
    let leaf = parser.ParserValueExprTypeSyntaxChildAt(
        tree, localTypeSyntaxNodeIndex, childCount - 1)
    if parser.ParserValueExprTypeSyntaxKindAt(tree, leaf) !=
           parser.ParserTypeSyntaxNominal:
        err = " typed expr type arena: qualified nominal leaf invalid"
        return false
    let leafName = parser.ParserValueExprTokenText(
        tree, parser.ParserValueExprTypeSyntaxNameTokenAt(tree, leaf))
    declarationRootOut = typedExprTypeAuthorityIndexFindDeclaration(
        index, sortedEntryRows, currentSourceIndex, leafName)
    if declarationRootOut < 0:
        err = " typed expr type arena: qualified imported nominal missing"
        return false
    var exported: bool
    if !typedExprTypeAuthorityIndexDeclarationExportedInto(
           index, declarationRootOut, exported, err):
        return false
    if !exported:
        # [not-exported coords] Diagnostic only; no behaviour change.
        err = Fmt" typed expr type arena: imported type is not exported name={leafName} producer_source={currentSourceIndex} declaration_root={declarationRootOut} qualified_path=1"
        return false
    return true

# A single-source tree numbers its own source 0 and its generic symbol rows
# from 0, so the forest helper is run on the local root and its answer is
# rebased onto the source's global generic-symbol base.
@borrows
fn typedExprTypeAuthorityFindGenericSymbolSourceInto(
        tree: parser.ParserValueExprTree,
        localRootRow: int32,
        viewGenericSymbolBase: int32,
        name: str,
        err: var str): int32 =
    if localRootRow < 0 || localRootRow >= tree.typeSyntaxCount:
        err = " typed expr type arena: generic owner root invalid"
        return -2
    let localProducerSourceIndex =
        parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
            tree, localRootRow)
    let localRow = typedExprTypeAuthorityFindGenericSymbol(
        tree, localRootRow, localProducerSourceIndex, name, err)
    if localRow < 0:
        return localRow
    return viewGenericSymbolBase + localRow

@borrows
fn TypedExprTypeResolutionAuthorityStreamingBegin(): TypedExprTypeResolutionAuthority =
    var empty: TypedExprTypeResolutionAuthority
    empty.sealed = false
    return empty

@borrows
fn TypedExprTypeResolutionAuthorityAppendSourceInto(
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        viewTypeSyntaxBase: int32,
        viewGenericSymbolBase: int32,
        index: TypedExprTypeDeclarationIndex,
        sortedEntryRows: int32[],
        imports: TypedExprTypeImportAuthority,
        sortedImportRows: int32[],
        out: var TypedExprTypeResolutionAuthority,
        err: var str): bool =
    if tree == nil || out.sealed ||
       tree.producerSourceCount != 1 ||
       producerSourceIndex < 0 || viewTypeSyntaxBase < 0 ||
       viewGenericSymbolBase < 0 ||
       !index.sealed ||
       index.typeSyntaxBaseBySource.len != index.producerSourceCount ||
       index.producerSourceIndexes.len != index.declarationNameTexts.len:
        err = " typed expr type arena: streaming resolution authority input invalid"
        return false
    if index.typeSyntaxBaseBySource[producerSourceIndex] !=
           viewTypeSyntaxBase:
        err = Fmt" typed expr type arena: streaming resolution authority base mismatch source={producerSourceIndex} expected={index.typeSyntaxBaseBySource[producerSourceIndex]} actual={viewTypeSyntaxBase}"
        return false
    # Local structural parents and qualified-segment flags: the same
    # derivation the forest builder ran over the merged rows.  Parents never
    # cross a source boundary (the forest builder proves exactly that), so the
    # source-local walk answers the same question.
    var localParents: int32[]
    var qualifiedSegment: bool[]
    setLen(localParents, tree.typeSyntaxCount)
    setLen(qualifiedSegment, tree.typeSyntaxCount)
    for row in 0..<localParents.len:
        localParents[row] = -1
    for localRow in 0..<tree.typeSyntaxCount:
        let structuralChildCount =
            parser.ParserValueExprTypeSyntaxChildCountAt(tree, localRow)
        for childOffset in 0..<structuralChildCount:
            let child = parser.ParserValueExprTypeSyntaxChildAt(
                tree, localRow, childOffset)
            if child < 0 || child >= localRow || localParents[child] >= 0:
                err = " typed expr type arena: TypeSyntax parent authority invalid"
                return false
            localParents[child] = localRow
        let variantCount =
            parser.ParserValueExprTypeSyntaxEnumVariantCountAt(tree, localRow)
        for variantOffset in 0..<variantCount:
            let payload =
                parser.ParserValueExprTypeSyntaxEnumVariantPayloadTypeNodeAt(
                    tree, localRow, variantOffset)
            if payload >= 0:
                if payload >= localRow || localParents[payload] >= 0:
                    err = " typed expr type arena: enum payload parent authority invalid"
                    return false
                localParents[payload] = localRow
        if parser.ParserValueExprTypeSyntaxKindAt(tree, localRow) !=
               parser.ParserTypeSyntaxQualified:
            continue
        let childCount = parser.ParserValueExprTypeSyntaxChildCountAt(
            tree, localRow)
        if childCount < 2:
            err = " typed expr type arena: qualified nominal path incomplete"
            return false
        for childOffset in 0..<childCount:
            let child = parser.ParserValueExprTypeSyntaxChildAt(
                tree, localRow, childOffset)
            if child < 0 || child >= localRow ||
               qualifiedSegment[child] ||
               parser.ParserValueExprTypeSyntaxKindAt(tree, child) !=
                   parser.ParserTypeSyntaxNominal:
                err = " typed expr type arena: qualified nominal segment invalid"
                return false
            qualifiedSegment[child] = true
    for localRow in 0..<tree.typeSyntaxCount:
        let globalRow = viewTypeSyntaxBase + localRow
        let kind = parser.ParserValueExprTypeSyntaxKindAt(tree, localRow)
        if kind == parser.ParserTypeSyntaxQualified:
            var declarationRoot: int32
            if !typedExprTypeAuthorityIndexResolveQualifiedInto(
                   tree,
                   localRow,
                   producerSourceIndex,
                   index,
                   sortedEntryRows,
                   imports,
                   sortedImportRows,
                   declarationRoot,
                   err):
                return false
            add(out.typeSyntaxNodeIndexes, globalRow)
            add(out.declarationRootTypeSyntaxNodeIndexes, declarationRoot)
            continue
        if kind != parser.ParserTypeSyntaxNominal ||
           qualifiedSegment[localRow]:
            continue
        let nameToken =
            parser.ParserValueExprTypeSyntaxNameTokenAt(tree, localRow)
        if nameToken < 0 || nameToken >= tree.tokenCount:
            err = " typed expr type arena: nominal name token missing"
            return false
        let name = parser.ParserValueExprTokenText(tree, nameToken)
        if typedExprTypeArenaScalarKind(name) !=
               TypedExprStructuralScalarInvalid:
            continue
        var rootTypeSyntaxNodeIndex = localRow
        while localParents[rootTypeSyntaxNodeIndex] >= 0:
            rootTypeSyntaxNodeIndex = localParents[rootTypeSyntaxNodeIndex]
        let genericSymbolRow =
            typedExprTypeAuthorityFindGenericSymbolSourceInto(
                tree,
                rootTypeSyntaxNodeIndex,
                viewGenericSymbolBase,
                name,
                err)
        if genericSymbolRow == -2:
            return false
        if genericSymbolRow >= 0:
            add(out.genericTypeSyntaxNodeIndexes, globalRow)
            add(out.genericSymbolRows, genericSymbolRow)
            continue
        var declarationRoot: int32
        if !typedExprTypeAuthorityIndexResolveUnqualifiedInto(
               index,
               sortedEntryRows,
               imports,
               sortedImportRows,
               producerSourceIndex,
               name,
               declarationRoot,
               err):
            # [probe generic-owner] Diagnostic only; no behaviour change.  The
            # question this answers: is the name a generic parameter of SOME
            # container in this source (name_is_source_generic > 0) but the root
            # walk did not reach that container -- or does the parser record no
            # generic symbol for it at all (== 0), i.e. an ambient/undeclared
            # spelling?  `root_generic_count` is the window at the row the walk
            # actually landed on.
            var sourceGenericSymbols: int32
            var nameIsSourceGeneric: int32
            for probeGenericRow in 0..<tree.typeGenericSymbolCount:
                if arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.typeGenericSymbolProducerSourceIndexes,
                       probeGenericRow) != producerSourceIndex:
                    continue
                sourceGenericSymbols = sourceGenericSymbols + 1
                let probeNameToken = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeGenericSymbolNameTokenIndexes,
                    probeGenericRow)
                if probeNameToken >= 0 && probeNameToken < tree.tokenCount &&
                   parser.ParserValueExprTokenText(tree, probeNameToken) ==
                       name:
                    nameIsSourceGeneric = nameIsSourceGeneric + 1
            err = Fmt"{err} name_not_visible type_syntax_row={localRow} root_row={rootTypeSyntaxNodeIndex} root_generic_count={parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(tree, rootTypeSyntaxNodeIndex)} source_generic_symbols={sourceGenericSymbols} name_is_source_generic={nameIsSourceGeneric}"
            # [nominal-sweep] Keep the pair instead of stopping at it.  The
            # branch above already bound both rows, and this call is inert
            # unless the sweep driver armed the table.
            typedExprTypeNominalSweepNote(
                producerSourceIndex,
                localRow,
                rootTypeSyntaxNodeIndex,
                name,
                err)
            return false
        add(out.typeSyntaxNodeIndexes, globalRow)
        add(out.declarationRootTypeSyntaxNodeIndexes, declarationRoot)
    err = ""
    return true

@borrows
fn TypedExprTypeResolutionAuthoritySealInto(
        out: var TypedExprTypeResolutionAuthority,
        typeSyntaxCount: int32,
        genericSymbolCount: int32,
        err: var str): bool =
    if out.sealed:
        err = " typed expr type arena: resolution authority is already sealed"
        return false
    # Seal in place: `TypedExprTypeResolutionAuthority` owns an array per
    # column, and a `var copy = out` / `out = copy` replace of a managed tuple
    # is rejected by the body-store freeze.  Nothing here needs a copy.
    out.sealed = true
    if !typedExprTypeArenaAuthorityShape(
           out, typeSyntaxCount, genericSymbolCount, err):
        out.sealed = false
        return false
    err = ""
    return true

# [S1b step-3 (6)] Sorted import-edge view and the pending-generic-apply
# constructor.  The streaming driver needs both by name across the module
# boundary; neither carries state.
@borrows
fn TypedExprTypeImportAuthoritySortedRowsInto(
        authority: TypedExprTypeImportAuthority,
        out: var int32[],
        err: var str): bool =
    if out.len != 0:
        err = " typed expr type arena: import authority sorted view destination is not empty"
        return false
    var rows: int32[]
    for row in 0..<authority.ownerSourceIndexes.len:
        add(rows, row)
    typedExprTypeImportAuthoritySortRows(authority, rows)
    out = rows
    err = ""
    return true

fn TypedExprTypeArenaPendingGenericApplyNew(): TypedExprTypeArenaPendingGenericApply =
    return new(TypedExprTypeArenaPendingGenericApply)

fn TypedExprTypeArenaPendingForwardNominalNew(
        typeSyntaxCount: int32): typedExprTypeArenaPendingForwardNominal =
    if typeSyntaxCount < 0:
        panic(Fmt"typed expr type arena: forward nominal queue row space invalid type_syntax={typeSyntaxCount}")
    var out: typedExprTypeArenaPendingForwardNominal =
        new(typedExprTypeArenaPendingForwardNominal)
    setLen(out.blockedFlags, typeSyntaxCount)
    return out

# [forward-typeid] Enqueue a row that cannot be interned yet.  `declarationRoot`
# is the exact declaration root the nominal resolved to; `-1` means the row was
# deferred only because a structural child was deferred (it carries no edge of
# its own).  A row may be enqueued exactly once: a second enqueue is a defect,
# not an idempotent retry.
@borrows
fn typedExprTypeArenaForwardNominalEnqueueInto(
        forward: typedExprTypeArenaPendingForwardNominal,
        typeSyntaxNodeIndex: int32,
        declarationRoot: int32,
        producerSourceIndex: int32,
        err: var str): bool =
    if forward == nil || declarationRoot < -1 || producerSourceIndex < 0 ||
       typeSyntaxNodeIndex < 0 ||
       typeSyntaxNodeIndex >= forward.blockedFlags.len:
        err = Fmt" typed expr type arena: forward nominal enqueue invalid nominal_row={typeSyntaxNodeIndex} declaration_root={declarationRoot} producer_source={producerSourceIndex} rows={forward == nil ? -1 : forward.blockedFlags.len}"
        return false
    if forward.blockedFlags[typeSyntaxNodeIndex]:
        err = Fmt" typed expr type arena: forward nominal enqueue duplicate nominal_row={typeSyntaxNodeIndex} declaration_root={declarationRoot}"
        return false
    forward.blockedFlags[typeSyntaxNodeIndex] = true
    add(forward.typeSyntaxNodeIndexes, typeSyntaxNodeIndex)
    add(forward.declarationRoots, declarationRoot)
    add(forward.producerSourceIndexes, producerSourceIndex)
    return true

# [forward-typeid] A row bound in the replay pass has no reason to be deferred
# again; clearing the mark is what makes the post-replay drained check a total
# statement over the whole queue instead of a sample.
@borrows
fn typedExprTypeArenaForwardNominalClearRow(
        forward: typedExprTypeArenaPendingForwardNominal,
        typeSyntaxNodeIndex: int32) =
    if forward == nil || typeSyntaxNodeIndex < 0 ||
       typeSyntaxNodeIndex >= forward.blockedFlags.len:
        panic(Fmt"typed expr type arena: forward nominal clear row invalid nominal_row={typeSyntaxNodeIndex}")
    forward.blockedFlags[typeSyntaxNodeIndex] = false

# [forward-typeid] Fail-closed queue post-condition.  Every enqueued row must be
# either drained or still flagged; a still-flagged row means the replay pass did
# not run for its source and the arena holds an unbound TypeId.  There is no
# third outcome and no repair path.
@borrows
fn TypedExprTypeArenaForwardNominalRequireDrainedInto(
        forward: typedExprTypeArenaPendingForwardNominal,
        localOut: TypedExprTypeArena,
        err: var str): bool =
    if forward == nil:
        err = " typed expr type arena: forward nominal queue missing"
        return false
    if forward.typeSyntaxNodeIndexes.len !=
           forward.declarationRoots.len ||
       forward.typeSyntaxNodeIndexes.len !=
           forward.producerSourceIndexes.len:
        err = Fmt" typed expr type arena: forward nominal queue shape invalid rows={forward.typeSyntaxNodeIndexes.len} roots={forward.declarationRoots.len} sources={forward.producerSourceIndexes.len}"
        return false
    for queueIndex in 0..<forward.typeSyntaxNodeIndexes.len:
        let nominalRow = forward.typeSyntaxNodeIndexes[queueIndex]
        if nominalRow < 0 || nominalRow >= forward.blockedFlags.len:
            err = Fmt" typed expr type arena: forward nominal queue row invalid queue_index={queueIndex} nominal_row={nominalRow} rows={forward.blockedFlags.len}"
            return false
        if forward.blockedFlags[nominalRow]:
            # [forward-replay-fixpoint] Report WHAT is still flagged: the kind
            # decides whether the replay walk can ever bind the row at all.
            var flaggedCount: int32
            var sampleText: str
            for sampleIndex in 0..<forward.typeSyntaxNodeIndexes.len:
                let sampleRow = forward.typeSyntaxNodeIndexes[sampleIndex]
                if sampleRow < 0 || sampleRow >= forward.blockedFlags.len ||
                   !forward.blockedFlags[sampleRow]:
                    continue
                flaggedCount = flaggedCount + 1
                if flaggedCount <= 8:
                    let sampleKind = sampleRow <
                        arenamod.ArenaArrayInt32Len(
                            localOut.arena, localOut.typeSyntaxParserKinds) ?
                        arenamod.ArenaArrayInt32Get(
                            localOut.arena, localOut.typeSyntaxParserKinds,
                            sampleRow) : -1
                    sampleText = Fmt"{sampleText} [{sampleRow}:kind={sampleKind}:root={forward.declarationRoots[sampleIndex]}:src={forward.producerSourceIndexes[sampleIndex]}]"
            # [forward-replay-fixpoint] Also read back the TARGET row the first
            # flagged row defers against: is it queued at all, from which
            # source, what kind is it, and is its own flag still set?  That
            # distinguishes "its source was never replayed" from "its mint can
            # never succeed".
            let targetRow = forward.declarationRoots[queueIndex]
            var targetQueued: int32 = -1
            var targetQueuedSource: int32 = -1
            var targetQueuedRoot: int32 = -1
            var targetQueueScan: int32
            while targetQueueScan < forward.typeSyntaxNodeIndexes.len:
                if forward.typeSyntaxNodeIndexes[targetQueueScan] == targetRow:
                    targetQueued = targetQueueScan
                    targetQueuedSource =
                        forward.producerSourceIndexes[targetQueueScan]
                    targetQueuedRoot =
                        forward.declarationRoots[targetQueueScan]
                targetQueueScan = targetQueueScan + 1
            let targetKind = targetRow >= 0 && targetRow <
                arenamod.ArenaArrayInt32Len(
                    localOut.arena, localOut.typeSyntaxParserKinds) ?
                arenamod.ArenaArrayInt32Get(
                    localOut.arena, localOut.typeSyntaxParserKinds,
                    targetRow) : -1
            let targetFlagged: int32 = targetRow >= 0 &&
                targetRow < forward.blockedFlags.len &&
                forward.blockedFlags[targetRow] ? 1 : 0
            err = Fmt" typed expr type arena: forward nominal queue not drained rows={forward.typeSyntaxNodeIndexes.len} cleared={queueIndex} flagged={flaggedCount} first_nominal_row={nominalRow} first_declaration_root={forward.declarationRoots[queueIndex]} first_producer_source={forward.producerSourceIndexes[queueIndex]} samples={sampleText} target_row={targetRow} target_kind={targetKind} target_flagged={targetFlagged} target_queued={targetQueued} target_queued_source={targetQueuedSource} target_queued_root={targetQueuedRoot}"
            return false
    return true

# `authority` is only read (`share` into the state), so the formal borrows it:
# the whole-forest caller forwards its own `@borrows` authority parameter, and
# a borrowed actual may not bind a by-value formal.
@borrows
fn typedExprTypeArenaBuildStateInitInto(
        authority: TypedExprTypeResolutionAuthority,
        declarationSymbolGlobalRoots: int32[],
        declarationGenericSymbolStarts: int32[],
        declarationGenericSymbolCounts: int32[],
        typeSyntaxCount: int32,
        groupCount: int32,
        out: var TypedExprTypeArenaBuildState,
        err: var str): bool =
    if out != nil:
        err = " typed expr type arena: build state destination is not empty"
        return false
    if typeSyntaxCount <= 0 || groupCount <= 0:
        err = Fmt" typed expr type arena: build state counts invalid type_syntax={typeSyntaxCount} groups={groupCount}"
        return false
    var state: TypedExprTypeArenaBuildState = new(TypedExprTypeArenaBuildState)
    state.authority = share(authority)
    state.typeSyntaxCount = typeSyntaxCount
    state.groupCount = groupCount
    state.fieldCount = 0
    var symbolByDeclarationRoot: int32[]
    setLen(symbolByDeclarationRoot, typeSyntaxCount)
    for index in 0..<symbolByDeclarationRoot.len:
        symbolByDeclarationRoot[index] = -1
    # [closure8] The SymbolId space is seeded from the index, not from the
    # append order: `globalSymbolId = Sum_{s < src} count[s] + localIndex` is
    # exactly the row of this declaration root in
    # `declarationSymbolGlobalRoots`, so every declaration root -- including
    # one in a source that has not been appended yet -- becomes readable here.
    # The sequential counter is not replaced: `FillDeclarationSymbols` still
    # walks the same order and now asserts the two derivations agree.
    state.declarationSymbolTotal = declarationSymbolGlobalRoots.len
    for symbolId in 0..<declarationSymbolGlobalRoots.len:
        let declarationRoot = declarationSymbolGlobalRoots[symbolId]
        if declarationRoot < 0 || declarationRoot >= typeSyntaxCount ||
           symbolByDeclarationRoot[declarationRoot] != -1:
            err = Fmt" typed expr type arena: declaration symbol root seed invalid symbol={symbolId} root={declarationRoot} type_syntax={typeSyntaxCount}"
            return false
        symbolByDeclarationRoot[declarationRoot] = symbolId
    state.symbolByDeclarationRoot = symbolByDeclarationRoot
    # [forward-decl] The declaration generic window is seeded by the same rule
    # and from the same two callers as the SymbolId space above, so the three
    # arrays are one row space and cannot drift by construction.
    if declarationGenericSymbolStarts.len !=
           declarationSymbolGlobalRoots.len ||
       declarationGenericSymbolCounts.len !=
           declarationSymbolGlobalRoots.len:
        err = Fmt" typed expr type arena: declaration generic window seed invalid symbols={declarationSymbolGlobalRoots.len} starts={declarationGenericSymbolStarts.len} counts={declarationGenericSymbolCounts.len}"
        return false
    state.declarationGenericSymbolStarts = declarationGenericSymbolStarts
    state.declarationGenericSymbolCounts = declarationGenericSymbolCounts
    var authorityUsed: bool[]
    setLen(authorityUsed, authority.typeSyntaxNodeIndexes.len)
    state.authorityUsed = authorityUsed
    var genericAuthorityUsed: bool[]
    setLen(genericAuthorityUsed,
           authority.genericTypeSyntaxNodeIndexes.len)
    state.genericAuthorityUsed = genericAuthorityUsed
    # [X1-dedup] The dedup table is reserved in the pinned arena by
    # `typedExprTypeArenaBuildStateReserveDedupInto`, which needs the arena
    # this init function does not receive; it runs from
    # `TypedExprTypeArenaAllocateFromLimitsInto` right after this call.
    var fieldStartsByDeclarationRoot: int32[]
    var fieldCountsByDeclarationRoot: int32[]
    setLen(fieldStartsByDeclarationRoot, typeSyntaxCount)
    setLen(fieldCountsByDeclarationRoot, typeSyntaxCount)
    for index in 0..<typeSyntaxCount:
        fieldStartsByDeclarationRoot[index] = -1
        fieldCountsByDeclarationRoot[index] = 0
    state.fieldStartsByDeclarationRoot = fieldStartsByDeclarationRoot
    state.fieldCountsByDeclarationRoot = fieldCountsByDeclarationRoot
    # [S1b step-3 (6)] The three global row-space arrays the append phase fills
    # slice by slice.  They are allocated here, once, at the index's own
    # TypeSyntax total, so a per-source driver never re-sizes them and the
    # whole-forest driver (base 0) fills exactly the same slots in exactly the
    # same order as the single-pass form did.
    var typeSyntaxParentNodeIndexes: int32[]
    var typeSyntaxEnclosingSymbolIds: int32[]
    var bracketConstLengths: int32[]
    var builtinConstructorArities: int32[]
    var resolutionReceiptRecorded: bool[]
    setLen(typeSyntaxParentNodeIndexes, typeSyntaxCount)
    setLen(typeSyntaxEnclosingSymbolIds, typeSyntaxCount)
    setLen(bracketConstLengths, typeSyntaxCount)
    setLen(builtinConstructorArities, typeSyntaxCount)
    setLen(resolutionReceiptRecorded, typeSyntaxCount)
    for index in 0..<typeSyntaxCount:
        typeSyntaxParentNodeIndexes[index] = -1
        typeSyntaxEnclosingSymbolIds[index] = -1
        bracketConstLengths[index] = -1
        builtinConstructorArities[index] = -1
        resolutionReceiptRecorded[index] = false
    state.typeSyntaxParentNodeIndexes = typeSyntaxParentNodeIndexes
    state.typeSyntaxEnclosingSymbolIds = typeSyntaxEnclosingSymbolIds
    state.bracketConstLengths = bracketConstLengths
    state.builtinConstructorArities = builtinConstructorArities
    state.resolutionReceiptRecorded = resolutionReceiptRecorded
    out = state
    err = ""
    return true

# [S1b step-3 (3)] Field CSR for one source's TypeSyntax rows.  The passes run
# over `tree` (that source's own rows) and write into the *global* root slots:
# source k's declaration roots all have global rows greater than source k-1's,
# so assigning starts source by source against the persisted `state.fieldCount`
# cursor reproduces the whole-forest allocation order exactly.  The whole-forest
# driver calls this once with viewTypeSyntaxBase 0 and an empty state, which is
# the previous single-pass behaviour unchanged.
@borrows
fn typedExprTypeArenaIndexFieldsSourceInto(
        state: var TypedExprTypeArenaBuildState,
        tree: parser.ParserValueExprTree,
        viewTypeSyntaxBase: int32,
        err: var str): bool =
    if tree == nil || viewTypeSyntaxBase < 0 ||
       viewTypeSyntaxBase + tree.typeSyntaxCount > state.typeSyntaxCount ||
       state.fieldStartsByDeclarationRoot.len != state.typeSyntaxCount ||
       state.fieldCountsByDeclarationRoot.len != state.typeSyntaxCount:
        err = Fmt" typed expr type arena: field index view invalid base={viewTypeSyntaxBase} rows={tree == nil ? -1 : tree.typeSyntaxCount} total={state.typeSyntaxCount}"
        return false
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) !=
               parser.ParserTypeSyntaxRootFieldDeclaration:
            continue
        let declarationRoot =
            parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(tree, row)
        if declarationRoot < 0 || declarationRoot >= row:
            err = " typed expr type arena: field declaration owner invalid"
            return false
        let globalRoot = viewTypeSyntaxBase + declarationRoot
        state.fieldCountsByDeclarationRoot[globalRoot] =
            state.fieldCountsByDeclarationRoot[globalRoot] + 1
    for row in 0..<tree.typeSyntaxCount:
        let globalRoot = viewTypeSyntaxBase + row
        let count = state.fieldCountsByDeclarationRoot[globalRoot]
        if count > 0:
            state.fieldStartsByDeclarationRoot[globalRoot] = state.fieldCount
            state.fieldCount = state.fieldCount + count
    var fieldTypeSyntaxNodeIndexes: int32[]
    for index in 0..<state.fieldTypeSyntaxNodeIndexes.len:
        add(fieldTypeSyntaxNodeIndexes, state.fieldTypeSyntaxNodeIndexes[index])
    setLen(fieldTypeSyntaxNodeIndexes, state.fieldCount)
    var cursors: int32[]
    setLen(cursors, tree.typeSyntaxCount)
    for row in 0..<tree.typeSyntaxCount:
        cursors[row] =
            state.fieldStartsByDeclarationRoot[viewTypeSyntaxBase + row]
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) !=
               parser.ParserTypeSyntaxRootFieldDeclaration:
            continue
        let declarationRoot =
            parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(tree, row)
        let destination = cursors[declarationRoot]
        if destination < 0 || destination >=
               fieldTypeSyntaxNodeIndexes.len:
            err = " typed expr type arena: field declaration CSR invalid"
            return false
        fieldTypeSyntaxNodeIndexes[destination] = viewTypeSyntaxBase + row
        cursors[declarationRoot] = destination + 1
    state.fieldTypeSyntaxNodeIndexes = fieldTypeSyntaxNodeIndexes
    return true

# [S1b step-3 (6)] `viewTypeSyntaxBase` is the global row of this tree's first
# TypeSyntax row.  The scan itself stays source-local (parents never cross a
# source boundary -- the check below is exactly the `TypeSyntax parent crosses
# source` proof), and the result is written into the GLOBAL state slots and
# appended to the global columns.  The whole-forest driver passes base 0, so
# every write below lands on the row the single-pass form wrote.
@borrows
fn typedExprTypeArenaBuildSyntaxOwnership(
        state: var TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        viewTypeSyntaxBase: int32,
        err: var str): bool =
    if state.tree == nil || viewTypeSyntaxBase < 0 ||
       viewTypeSyntaxBase + state.tree.typeSyntaxCount >
           state.typeSyntaxCount ||
       state.typeSyntaxParentNodeIndexes.len != state.typeSyntaxCount ||
       state.typeSyntaxEnclosingSymbolIds.len != state.typeSyntaxCount:
        err = Fmt" typed expr type arena: ownership view invalid base={viewTypeSyntaxBase} rows={state.tree == nil ? -1 : state.tree.typeSyntaxCount} total={state.typeSyntaxCount}"
        return false
    var typeSyntaxParentNodeIndexes: int32[]
    var typeSyntaxEnclosingSymbolIds: int32[]
    setLen(typeSyntaxParentNodeIndexes, state.tree.typeSyntaxCount)
    setLen(typeSyntaxEnclosingSymbolIds, state.tree.typeSyntaxCount)
    for row in 0..<state.tree.typeSyntaxCount:
        typeSyntaxParentNodeIndexes[row] = -1
        typeSyntaxEnclosingSymbolIds[row] = -1
    for parent in 0..<state.tree.typeSyntaxCount:
        let childCount = parser.ParserValueExprTypeSyntaxChildCountAt(
            state.tree, parent)
        for childOffset in 0..<childCount:
            let child = parser.ParserValueExprTypeSyntaxChildAt(
                state.tree, parent, childOffset)
            if child < 0 || child >= parent ||
               typeSyntaxParentNodeIndexes[child] != -1:
                err = " typed expr type arena: TypeSyntax parent authority invalid"
                return false
            typeSyntaxParentNodeIndexes[child] = parent
        let variantCount = parser.ParserValueExprTypeSyntaxEnumVariantCountAt(
            state.tree, parent)
        for variantOffset in 0..<variantCount:
            let payload =
                parser.ParserValueExprTypeSyntaxEnumVariantPayloadTypeNodeAt(
                    state.tree, parent, variantOffset)
            if payload >= 0:
                if payload >= parent ||
                   typeSyntaxParentNodeIndexes[payload] != -1:
                    err = " typed expr type arena: enum payload parent authority invalid"
                    return false
                typeSyntaxParentNodeIndexes[payload] = parent
    for reverseOffset in 0..<state.tree.typeSyntaxCount:
        let row = state.tree.typeSyntaxCount - reverseOffset - 1
        let parent = typeSyntaxParentNodeIndexes[row]
        let source = parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
            state.tree, row)
        if parent >= 0:
            if parent >= state.tree.typeSyntaxCount ||
               parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   state.tree, parent) != source:
                err = " typed expr type arena: TypeSyntax parent crosses source"
                return false
            typeSyntaxEnclosingSymbolIds[row] =
                typeSyntaxEnclosingSymbolIds[parent]
            continue
        let rootKind = parser.ParserValueExprTypeSyntaxRootKindAt(
            state.tree, row)
        let declarationSymbolId =
            state.symbolByDeclarationRoot[viewTypeSyntaxBase + row]
        if declarationSymbolId >= 0:
            typeSyntaxEnclosingSymbolIds[row] =
                declarationSymbolId
        elif rootKind == parser.ParserTypeSyntaxRootFieldDeclaration:
            let declarationRoot =
                parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(
                    state.tree, row)
            if declarationRoot < 0 ||
               declarationRoot >= state.tree.typeSyntaxCount:
                err = " typed expr type arena: field enclosing declaration missing"
                return false
            typeSyntaxEnclosingSymbolIds[row] =
                state.symbolByDeclarationRoot[
                    viewTypeSyntaxBase + declarationRoot]
        elif rootKind == parser.ParserTypeSyntaxRootInvalid:
            err = " typed expr type arena: detached nested TypeSyntax"
            return false
    for row in 0..<state.tree.typeSyntaxCount:
        let globalParent = typedExprTypeArenaRebaseRow(
            viewTypeSyntaxBase, typeSyntaxParentNodeIndexes[row])
        state.typeSyntaxParentNodeIndexes[viewTypeSyntaxBase + row] =
            globalParent
        state.typeSyntaxEnclosingSymbolIds[viewTypeSyntaxBase + row] =
            typeSyntaxEnclosingSymbolIds[row]
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.typeSyntaxParentNodeIndexes,
            globalParent)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.typeSyntaxEnclosingSymbolIds,
            typeSyntaxEnclosingSymbolIds[row])
    return true

@borrows
fn typedExprTypeArenaDependencyIndirect(
        state: TypedExprTypeArenaBuildState,
        localOut: TypedExprTypeArena,
        typeSyntaxNodeIndex: int32,
        targetSymbolId: int32): bool =
    let targetRoot = arenamod.ArenaArrayInt32Get(
        localOut.arena,
        localOut.symbolDeclarationRootTypeSyntaxNodeIndexes,
        targetSymbolId)
    # [S1b-1c] Seal-phase read #4 (DependencyIndirect): both parser kinds come
    # from the arena column, so the walk needs no parser tree.
    if typedExprTypeArenaSyntaxKindAt(localOut, targetRoot) ==
           parser.ParserTypeSyntaxRefObject:
        return true
    var cursor = typeSyntaxNodeIndex
    while cursor >= 0:
        let kind = typedExprTypeArenaSyntaxKindAt(localOut, cursor)
        if kind == parser.ParserTypeSyntaxSeq ||
           kind == parser.ParserTypeSyntaxFunction:
            return true
        cursor = state.typeSyntaxParentNodeIndexes[cursor]
    return false

@borrows
fn typedExprTypeArenaComputeDependencyGraph(
        value: TypedExprTypeArena,
        startsOut: var int32[],
        countsOut: var int32[],
        targetsOut: var int32[],
        directFlagsOut: var int32[],
        err: var str): bool =
    var dependencyCounts: int32[]
    setLen(dependencyCounts, value.symbolCount)
    for row in 0..<value.nominalDependencyCount:
        let source = typedExprTypeArenaInt32At(value, value.nominalDependencySourceSymbolIds.offset, value.nominalDependencySourceSymbolIds.len, row)
        let target = typedExprTypeArenaInt32At(value, value.nominalDependencyTargetSymbolIds.offset, value.nominalDependencyTargetSymbolIds.len, row)
        let indirect = typedExprTypeArenaInt32At(value, value.nominalDependencyIndirectFlags.offset, value.nominalDependencyIndirectFlags.len, row)
        if source < 0 || source >= value.symbolCount || target < 0 ||
           target >= value.symbolCount || indirect < 0 || indirect > 1:
            err = " typed expr type arena: nominal dependency row invalid"
            return false
        dependencyCounts[source] = dependencyCounts[source] + 1
    var groupedStarts: int32[]
    var groupedCursors: int32[]
    var groupedRows: int32[]
    setLen(groupedStarts, value.symbolCount)
    setLen(groupedCursors, value.symbolCount)
    setLen(groupedRows, value.nominalDependencyCount)
    var groupedCursor: int32
    for symbolId in 0..<value.symbolCount:
        groupedStarts[symbolId] = groupedCursor
        groupedCursors[symbolId] = groupedCursor
        groupedCursor = groupedCursor + dependencyCounts[symbolId]
    for row in 0..<value.nominalDependencyCount:
        let source = typedExprTypeArenaInt32At(value, value.nominalDependencySourceSymbolIds.offset, value.nominalDependencySourceSymbolIds.len, row)
        groupedRows[groupedCursors[source]] = row
        groupedCursors[source] = groupedCursors[source] + 1
    var seenGeneration: int32[]
    var edgeRowByTarget: int32[]
    setLen(seenGeneration, value.symbolCount)
    setLen(edgeRowByTarget, value.symbolCount)
    for symbolId in 0..<value.symbolCount:
        add(startsOut, targetsOut.len)
        let begin = groupedStarts[symbolId]
        let limit = begin + dependencyCounts[symbolId]
        for groupedIndex in begin..<limit:
            let dependencyRow = groupedRows[groupedIndex]
            let target = typedExprTypeArenaInt32At(value, value.nominalDependencyTargetSymbolIds.offset, value.nominalDependencyTargetSymbolIds.len, dependencyRow)
            let indirect = typedExprTypeArenaInt32At(value, value.nominalDependencyIndirectFlags.offset, value.nominalDependencyIndirectFlags.len, dependencyRow)
            if seenGeneration[target] != symbolId + 1:
                seenGeneration[target] = symbolId + 1
                edgeRowByTarget[target] = targetsOut.len
                add(targetsOut, target)
                add(directFlagsOut, indirect == 0 ? 1 : 0)
            elif indirect == 0:
                directFlagsOut[edgeRowByTarget[target]] = 1
        add(countsOut, targetsOut.len - startsOut[symbolId])
    return true

@borrows
fn typedExprTypeArenaDirectGraphAcyclic(
        value: TypedExprTypeArena,
        err: var str): bool =
    var indegrees: int32[]
    var queue: int32[]
    setLen(indegrees, value.symbolCount)
    for source in 0..<value.symbolCount:
        let start = typedExprTypeArenaInt32At(value, value.symbolDependencyStarts.offset, value.symbolDependencyStarts.len, source)
        let count = typedExprTypeArenaInt32At(value, value.symbolDependencyCounts.offset, value.symbolDependencyCounts.len, source)
        for edgeOffset in 0..<count:
            let edgeRow = start + edgeOffset
            if typedExprTypeArenaInt32At(value, value.symbolDependencyDirectFlags.offset, value.symbolDependencyDirectFlags.len, edgeRow) != 0:
                let target = typedExprTypeArenaInt32At(value, value.symbolDependencyTargetSymbolIds.offset, value.symbolDependencyTargetSymbolIds.len, edgeRow)
                indegrees[target] = indegrees[target] + 1
    for symbolId in 0..<value.symbolCount:
        if indegrees[symbolId] == 0: add(queue, symbolId)
    var head: int32
    while head < queue.len:
        let source = queue[head]
        head = head + 1
        let start = typedExprTypeArenaInt32At(value, value.symbolDependencyStarts.offset, value.symbolDependencyStarts.len, source)
        let count = typedExprTypeArenaInt32At(value, value.symbolDependencyCounts.offset, value.symbolDependencyCounts.len, source)
        for edgeOffset in 0..<count:
            let edgeRow = start + edgeOffset
            if typedExprTypeArenaInt32At(value, value.symbolDependencyDirectFlags.offset, value.symbolDependencyDirectFlags.len, edgeRow) == 0:
                continue
            let target = typedExprTypeArenaInt32At(value, value.symbolDependencyTargetSymbolIds.offset, value.symbolDependencyTargetSymbolIds.len, edgeRow)
            indegrees[target] = indegrees[target] - 1
            if indegrees[target] == 0: add(queue, target)
    if queue.len != value.symbolCount:
        err = " typed expr type arena: nominal layout dependency cycle has no indirection"
        return false
    return true

@borrows
fn typedExprTypeArenaComputeScc(
        value: TypedExprTypeArena,
        symbolSccIdsOut: var int32[],
        sccStartsOut: var int32[],
        sccCountsOut: var int32[],
        sccSymbolIdsOut: var int32[],
        err: var str): bool =
    var reverseCounts: int32[]
    var reverseStarts: int32[]
    var reverseCursors: int32[]
    var reverseTargets: int32[]
    setLen(reverseCounts, value.symbolCount)
    setLen(reverseStarts, value.symbolCount)
    setLen(reverseCursors, value.symbolCount)
    setLen(reverseTargets, value.symbolDependencyCount)
    for edgeRow in 0..<value.symbolDependencyCount:
        let target = typedExprTypeArenaInt32At(value, value.symbolDependencyTargetSymbolIds.offset, value.symbolDependencyTargetSymbolIds.len, edgeRow)
        if target < 0 || target >= value.symbolCount:
            err = " typed expr type arena: dependency target out of range"
            return false
        reverseCounts[target] = reverseCounts[target] + 1
    var reverseCursor: int32
    for symbolId in 0..<value.symbolCount:
        reverseStarts[symbolId] = reverseCursor
        reverseCursors[symbolId] = reverseCursor
        reverseCursor = reverseCursor + reverseCounts[symbolId]
    for source in 0..<value.symbolCount:
        let start = typedExprTypeArenaInt32At(value, value.symbolDependencyStarts.offset, value.symbolDependencyStarts.len, source)
        let count = typedExprTypeArenaInt32At(value, value.symbolDependencyCounts.offset, value.symbolDependencyCounts.len, source)
        for edgeOffset in 0..<count:
            let target = typedExprTypeArenaInt32At(value, value.symbolDependencyTargetSymbolIds.offset, value.symbolDependencyTargetSymbolIds.len, start + edgeOffset)
            reverseTargets[reverseCursors[target]] = source
            reverseCursors[target] = reverseCursors[target] + 1
    var visited: bool[]
    var finish: int32[]
    setLen(visited, value.symbolCount)
    for seed in 0..<value.symbolCount:
        if visited[seed]: continue
        var nodeStack: int32[]
        var edgeStack: int32[]
        visited[seed] = true
        add(nodeStack, seed)
        add(edgeStack, typedExprTypeArenaInt32At(value, value.symbolDependencyStarts.offset, value.symbolDependencyStarts.len, seed))
        while nodeStack.len > 0:
            let stackOffset = nodeStack.len - 1
            let node = nodeStack[stackOffset]
            let edgeLimit = typedExprTypeArenaInt32At(value, value.symbolDependencyStarts.offset, value.symbolDependencyStarts.len, node) +
                typedExprTypeArenaInt32At(value, value.symbolDependencyCounts.offset, value.symbolDependencyCounts.len, node)
            let edgeCursor = edgeStack[stackOffset]
            if edgeCursor < edgeLimit:
                edgeStack[stackOffset] = edgeCursor + 1
                let target = typedExprTypeArenaInt32At(value, value.symbolDependencyTargetSymbolIds.offset, value.symbolDependencyTargetSymbolIds.len, edgeCursor)
                if !visited[target]:
                    visited[target] = true
                    add(nodeStack, target)
                    add(edgeStack, typedExprTypeArenaInt32At(value, value.symbolDependencyStarts.offset, value.symbolDependencyStarts.len, target))
            else:
                add(finish, node)
                setLen(nodeStack, nodeStack.len - 1)
                setLen(edgeStack, edgeStack.len - 1)
    setLen(symbolSccIdsOut, value.symbolCount)
    for symbolId in 0..<value.symbolCount:
        symbolSccIdsOut[symbolId] = -1
    for reverseOffset in 0..<finish.len:
        let seed = finish[finish.len - reverseOffset - 1]
        if symbolSccIdsOut[seed] >= 0: continue
        let sccId = sccStartsOut.len
        let memberStart = sccSymbolIdsOut.len
        var stack: int32[]
        symbolSccIdsOut[seed] = sccId
        add(stack, seed)
        while stack.len > 0:
            let node = stack[stack.len - 1]
            setLen(stack, stack.len - 1)
            add(sccSymbolIdsOut, node)
            let start = reverseStarts[node]
            let count = reverseCounts[node]
            for edgeOffset in 0..<count:
                let target = reverseTargets[start + edgeOffset]
                if symbolSccIdsOut[target] < 0:
                    symbolSccIdsOut[target] = sccId
                    add(stack, target)
        # Membership order is independent of DFS adjacency order.
        for memberIndex in memberStart + 1..<sccSymbolIdsOut.len:
            let item = sccSymbolIdsOut[memberIndex]
            var insertAt = memberIndex
            while insertAt > memberStart &&
                  sccSymbolIdsOut[insertAt - 1] > item:
                sccSymbolIdsOut[insertAt] = sccSymbolIdsOut[insertAt - 1]
                insertAt = insertAt - 1
            sccSymbolIdsOut[insertAt] = item
        add(sccStartsOut, memberStart)
        add(sccCountsOut, sccSymbolIdsOut.len - memberStart)
    return true

@borrows
fn typedExprTypeArenaBuildDependencyProof(
        state: TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        err: var str): bool =
    for resolutionRow in 0..<localOut.resolutionCount:
        let typeSyntaxNodeIndex = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.resolutionTypeSyntaxNodeIndexes,
            resolutionRow)
        let sourceSymbolId =
            state.typeSyntaxEnclosingSymbolIds[typeSyntaxNodeIndex]
        if sourceSymbolId < 0:
            continue
        let targetSymbolId = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.resolutionTargetSymbolIds,
            resolutionRow)
        let sourceProducer = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.symbolProducerSourceIndexes,
            sourceSymbolId)
        let targetProducer = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.symbolProducerSourceIndexes,
            targetSymbolId)
        if sourceProducer < 0 ||
           sourceProducer >= localOut.producerSourceCount ||
           targetProducer < 0 ||
           targetProducer >= localOut.producerSourceCount:
            err = " typed expr type arena: nominal dependency source row invalid"
            return false
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.nominalDependencyTypeSyntaxNodeIndexes,
            typeSyntaxNodeIndex)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.nominalDependencySourceSymbolIds,
            sourceSymbolId)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.nominalDependencyTargetSymbolIds,
            targetSymbolId)
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.nominalDependencyIndirectFlags,
            typedExprTypeArenaDependencyIndirect(
                state, localOut, typeSyntaxNodeIndex, targetSymbolId) ? 1 : 0)
        localOut.nominalDependencyCount =
            localOut.nominalDependencyCount + 1
    var starts: int32[]
    var counts: int32[]
    var targets: int32[]
    var directFlags: int32[]
    if !typedExprTypeArenaComputeDependencyGraph(
           localOut, starts, counts, targets, directFlags, err):
        return false
    for index in 0..<starts.len:
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.symbolDependencyStarts,
            starts[index])
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.symbolDependencyCounts,
            counts[index])
    for edgeRow in 0..<targets.len:
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.symbolDependencyTargetSymbolIds,
            targets[edgeRow])
        arenamod.ArenaArrayInt32Add(
            localOut.arena,
            localOut.symbolDependencyDirectFlags,
            directFlags[edgeRow])
    localOut.symbolDependencyCount = targets.len
    if !typedExprTypeArenaDirectGraphAcyclic(localOut, err):
        return false
    var symbolSccIds: int32[]
    var sccStarts: int32[]
    var sccCounts: int32[]
    var sccSymbolIds: int32[]
    if !typedExprTypeArenaComputeScc(
           localOut, symbolSccIds, sccStarts, sccCounts,
           sccSymbolIds, err):
        return false
    for symbolId in 0..<symbolSccIds.len:
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.symbolSccIds,
            symbolSccIds[symbolId])
    for sccId in 0..<sccStarts.len:
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.sccStarts, sccStarts[sccId])
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.sccCounts, sccCounts[sccId])
    for member in 0..<sccSymbolIds.len:
        arenamod.ArenaArrayInt32Add(
            localOut.arena, localOut.sccSymbolIds,
            sccSymbolIds[member])
    localOut.sccCount = sccStarts.len
    return true

@borrows
fn typedExprTypeArenaGenericDependenciesValidateInto(
        value: TypedExprTypeArena,
        sourceTypeId: int32,
        genericSymbolStart: int32,
        genericSymbolCount: int32,
        allowedGenericSymbolEnd: int32,
        visiting: var bool[],
        seen: var bool[],
        referencesGenericOut: var bool,
        err: var str): bool =
    if value == nil || sourceTypeId < 0 ||
       sourceTypeId >= value.typeCount ||
       genericSymbolStart < 0 || genericSymbolCount <= 0 ||
       genericSymbolStart >
           value.genericSymbolCount - genericSymbolCount ||
       allowedGenericSymbolEnd < genericSymbolStart ||
       allowedGenericSymbolEnd >
           genericSymbolStart + genericSymbolCount ||
       visiting.len != value.typeCount || seen.len != value.typeCount:
        err = " typed expr type arena: generic dependency domain invalid"
        return false
    if seen[sourceTypeId]:
        return true
    if visiting[sourceTypeId]:
        return true
    visiting[sourceTypeId] = true
    let kind = TypedExprStructuralTypeKind(
        typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, sourceTypeId))
    if kind == TypedExprStructuralTypeGenericParameter:
        let genericSymbolId = typedExprTypeArenaInt32At(value, value.genericSymbolIds.offset, value.genericSymbolIds.len, sourceTypeId)
        if genericSymbolId < genericSymbolStart ||
           genericSymbolId >=
               genericSymbolStart + genericSymbolCount:
            err = " typed expr type arena: generic default references foreign genericSymbolId"
            visiting[sourceTypeId] = false
            return false
        referencesGenericOut = true
        if genericSymbolId >= allowedGenericSymbolEnd:
            err = " typed expr type arena: generic default forward/self dependency"
            visiting[sourceTypeId] = false
            return false
        visiting[sourceTypeId] = false
        seen[sourceTypeId] = true
        return true
    let symbolId = typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, sourceTypeId)
    let nominalDefinition =
        symbolId >= 0 &&
        (kind == TypedExprStructuralTypeObject ||
         kind == TypedExprStructuralTypeRefObject ||
         kind == TypedExprStructuralTypeEnum ||
         kind == TypedExprStructuralTypeAlias)
    if nominalDefinition:
        visiting[sourceTypeId] = false
        seen[sourceTypeId] = true
        return true
    let childStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, sourceTypeId)
    let childCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, sourceTypeId)
    let firstDependencyChild =
        kind == TypedExprStructuralTypeApply ? 1 : 0
    if childStart < 0 || childCount < firstDependencyChild ||
       childStart + childCount > value.childTypeIds.len:
        err = " typed expr type arena: generic dependency child CSR invalid"
        visiting[sourceTypeId] = false
        return false
    for childOffset in firstDependencyChild..<childCount:
        let childTypeId = typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart + childOffset)
        if !typedExprTypeArenaGenericDependenciesValidateInto(
               value,
               childTypeId,
               genericSymbolStart,
               genericSymbolCount,
               allowedGenericSymbolEnd,
               visiting,
               seen,
               referencesGenericOut,
               err):
            visiting[sourceTypeId] = false
            return false
    visiting[sourceTypeId] = false
    seen[sourceTypeId] = true
    return true

@borrows
fn typedExprTypeArenaSpecializeTypeInto(
        state: var TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        originTypeSyntaxNodeIndex: int32,
        sourceTypeId: int32,
        genericSymbolStart: int32,
        genericSymbolCount: int32,
        argumentTypeIds: int32[],
        sourceTypeCount: int32,
        memo: var int32[],
        visiting: var bool[],
        specializedTypeIdOut: var int32,
        err: var str): bool =
    specializedTypeIdOut = -1
    if sourceTypeId < 0 || sourceTypeId >= sourceTypeCount ||
       sourceTypeCount > localOut.typeCount ||
       genericSymbolStart < 0 || genericSymbolCount <= 0 ||
       genericSymbolCount != argumentTypeIds.len ||
       genericSymbolStart >
           localOut.genericSymbolCount - genericSymbolCount ||
       memo.len != sourceTypeCount || visiting.len != sourceTypeCount:
        err = Fmt" typed expr type arena: generic specialization domain invalid source_type={sourceTypeId} source_count={sourceTypeCount} arena_types={localOut.typeCount} generic_start={genericSymbolStart} generic_count={genericSymbolCount} arena_generics={localOut.genericSymbolCount} args={argumentTypeIds.len} memo={memo.len} visiting={visiting.len}"
        return false
    if memo[sourceTypeId] >= 0:
        specializedTypeIdOut = memo[sourceTypeId]
        return true
    if visiting[sourceTypeId]:
        err = " typed expr type arena: recursive generic specialization requires canonical cycle producer"
        return false
    visiting[sourceTypeId] = true
    let kind = TypedExprStructuralTypeKind(
        arenamod.ArenaArrayInt32Get(
            localOut.arena, localOut.typeKinds, sourceTypeId))
    if kind == TypedExprStructuralTypeGenericParameter:
        let genericSymbolId = arenamod.ArenaArrayInt32Get(
            localOut.arena, localOut.genericSymbolIds, sourceTypeId)
        if genericSymbolId < genericSymbolStart ||
           genericSymbolId >=
               genericSymbolStart + genericSymbolCount:
            err = " typed expr type arena: generic specialization references foreign genericSymbolId"
            visiting[sourceTypeId] = false
            return false
        let genericOffset = genericSymbolId - genericSymbolStart
        if arenamod.ArenaArrayInt32Get(
               localOut.arena,
               localOut.genericSymbolOrdinals,
               genericSymbolId) != genericOffset ||
           argumentTypeIds[genericOffset] < 0 ||
           argumentTypeIds[genericOffset] >= localOut.typeCount:
            err = " typed expr type arena: generic specialization binding invalid"
            visiting[sourceTypeId] = false
            return false
        memo[sourceTypeId] = argumentTypeIds[genericOffset]
        visiting[sourceTypeId] = false
        specializedTypeIdOut = argumentTypeIds[genericOffset]
        return true
    if kind == TypedExprStructuralTypeApply:
        let sourceChildStart = arenamod.ArenaArrayInt32Get(
            localOut.arena, localOut.childStarts, sourceTypeId)
        let sourceChildCount = arenamod.ArenaArrayInt32Get(
            localOut.arena, localOut.childCounts, sourceTypeId)
        let targetSymbolId = arenamod.ArenaArrayInt32Get(
            localOut.arena, localOut.symbolIds, sourceTypeId)
        if sourceChildCount < 2 || targetSymbolId < 0 ||
           targetSymbolId >= localOut.symbolCount:
            err = " typed expr type arena: nested generic Apply specialization authority invalid"
            visiting[sourceTypeId] = false
            return false
        let targetDeclarationRoot = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.symbolDeclarationRootTypeSyntaxNodeIndexes,
            targetSymbolId)
        let targetGenericStart = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.typeSyntaxGenericSymbolStarts,
            targetDeclarationRoot)
        let targetGenericCount = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.typeSyntaxGenericSymbolCounts,
            targetDeclarationRoot)
        if targetGenericCount <= 0 ||
           sourceChildCount != targetGenericCount + 1:
            err = " typed expr type arena: nested generic Apply specialization arity invalid"
            visiting[sourceTypeId] = false
            return false
        var nestedArgumentTypeIds: int32[]
        var nestedChildren: int32[]
        var nestedChildNames: int32[]
        add(nestedChildren, -1)
        add(nestedChildNames, -1)
        var changed = false
        for targetOffset in 0..<targetGenericCount:
            let sourceArgumentTypeId = arenamod.ArenaArrayInt32Get(
                localOut.arena,
                localOut.childTypeIds,
                sourceChildStart + targetOffset + 1)
            var specializedArgumentTypeId: int32
            if !typedExprTypeArenaSpecializeTypeInto(
                   state,
                   localOut,
                   originTypeSyntaxNodeIndex,
                   sourceArgumentTypeId,
                   genericSymbolStart,
                   genericSymbolCount,
                   argumentTypeIds,
                   sourceTypeCount,
                   memo,
                   visiting,
                   specializedArgumentTypeId,
                   err):
                visiting[sourceTypeId] = false
                return false
            add(nestedArgumentTypeIds, specializedArgumentTypeId)
            add(nestedChildren, specializedArgumentTypeId)
            add(nestedChildNames, arenamod.ArenaArrayInt32Get(
                localOut.arena,
                localOut.childNameIds,
                sourceChildStart + targetOffset + 1))
            if specializedArgumentTypeId != sourceArgumentTypeId:
                changed = true
        var targetMemo: int32[]
        var targetVisiting: bool[]
        setLen(targetMemo, sourceTypeCount)
        setLen(targetVisiting, sourceTypeCount)
        for targetTypeId in 0..<sourceTypeCount:
            targetMemo[targetTypeId] = -1
        var specializedTargetDeclarationTypeId: int32
        if !typedExprTypeArenaSpecializeTypeInto(
               state,
               localOut,
               originTypeSyntaxNodeIndex,
               arenamod.ArenaArrayInt32Get(
                   localOut.arena,
                   localOut.typeSyntaxTypeIds,
                   targetDeclarationRoot),
               targetGenericStart,
               targetGenericCount,
               nestedArgumentTypeIds,
               sourceTypeCount,
               targetMemo,
               targetVisiting,
               specializedTargetDeclarationTypeId,
               err):
            visiting[sourceTypeId] = false
            return false
        nestedChildren[0] = specializedTargetDeclarationTypeId
        if specializedTargetDeclarationTypeId !=
               arenamod.ArenaArrayInt32Get(
                   localOut.arena,
                   localOut.childTypeIds,
                   sourceChildStart):
            changed = true
        if !changed:
            memo[sourceTypeId] = sourceTypeId
            visiting[sourceTypeId] = false
            specializedTypeIdOut = sourceTypeId
            return true
        var specializedApplyTypeId: int32
        if !typedExprTypeArenaIntern(
               state,
               localOut,
               originTypeSyntaxNodeIndex,
               TypedExprStructuralTypeApply,
               TypedExprStructuralScalarInvalid,
               targetSymbolId,
               -1,
               -1,
               -1,
               -1,
               -1,
               nestedChildren,
               nestedChildNames,
               specializedApplyTypeId,
               err):
            visiting[sourceTypeId] = false
            return false
        memo[sourceTypeId] = specializedApplyTypeId
        visiting[sourceTypeId] = false
        specializedTypeIdOut = specializedApplyTypeId
        return true
    let sourceBaseTypeSyntaxNodeIndex =
        arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.baseTypeSyntaxNodeIndexes,
            sourceTypeId)
    let sourceBaseTypeId = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.baseTypeIds, sourceTypeId)
    if (sourceBaseTypeSyntaxNodeIndex >= 0) != (sourceBaseTypeId >= 0) ||
       sourceBaseTypeSyntaxNodeIndex < -1 ||
       sourceBaseTypeSyntaxNodeIndex >= localOut.typeSyntaxCount ||
       sourceBaseTypeId < -1 || sourceBaseTypeId >= sourceTypeCount:
        err = " typed expr type arena: generic specialization base edge invalid"
        visiting[sourceTypeId] = false
        return false
    var specializedBaseTypeId: int32 = -1
    var changed = false
    if sourceBaseTypeId >= 0:
        if !typedExprTypeArenaSpecializeTypeInto(
               state,
               localOut,
               originTypeSyntaxNodeIndex,
               sourceBaseTypeId,
               genericSymbolStart,
               genericSymbolCount,
               argumentTypeIds,
               sourceTypeCount,
               memo,
               visiting,
               specializedBaseTypeId,
               err):
            visiting[sourceTypeId] = false
            return false
        if specializedBaseTypeId != sourceBaseTypeId:
            changed = true
    let childStart = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.childStarts, sourceTypeId)
    let childCount = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.childCounts, sourceTypeId)
    var children: int32[]
    var childNames: int32[]
    for childOffset in 0..<childCount:
        let child = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.childTypeIds,
            childStart + childOffset)
        var specializedChild: int32
        if !typedExprTypeArenaSpecializeTypeInto(
               state,
               localOut,
               originTypeSyntaxNodeIndex,
               child,
               genericSymbolStart,
               genericSymbolCount,
               argumentTypeIds,
               sourceTypeCount,
               memo,
               visiting,
               specializedChild,
               err):
            visiting[sourceTypeId] = false
            return false
        add(children, specializedChild)
        add(childNames, arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.childNameIds,
            childStart + childOffset))
        if specializedChild != child:
            changed = true
    if !changed:
        memo[sourceTypeId] = sourceTypeId
        visiting[sourceTypeId] = false
        specializedTypeIdOut = sourceTypeId
        return true
    let scalarKind = TypedExprStructuralScalarKind(
        arenamod.ArenaArrayInt32Get(
            localOut.arena, localOut.scalarKinds, sourceTypeId))
    let symbolId = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.symbolIds, sourceTypeId)
    let genericSymbolId = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.genericSymbolIds, sourceTypeId)
    let fixedLength = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.fixedLengths, sourceTypeId)
    let functionParamCount = arenamod.ArenaArrayInt32Get(
        localOut.arena, localOut.functionParamCounts, sourceTypeId)
    var specializedTypeId: int32
    if !typedExprTypeArenaIntern(
           state,
           localOut,
           originTypeSyntaxNodeIndex,
           kind,
           scalarKind,
           symbolId,
           genericSymbolId,
           fixedLength,
           functionParamCount,
           sourceBaseTypeSyntaxNodeIndex,
           specializedBaseTypeId,
           children,
           childNames,
           specializedTypeId,
           err):
        visiting[sourceTypeId] = false
        return false
    memo[sourceTypeId] = specializedTypeId
    visiting[sourceTypeId] = false
    specializedTypeIdOut = specializedTypeId
    return true

@borrows
fn typedExprTypeArenaObjectBaseTargetInto(
        state: TypedExprTypeArenaBuildState,
        value: TypedExprTypeArena,
        baseTypeSyntaxNodeIndex: int32,
        targetSymbolIdOut: var int32,
        applyTypeIdOut: var int32,
        err: var str): bool =
    targetSymbolIdOut = -1
    applyTypeIdOut = -1
    if baseTypeSyntaxNodeIndex < 0 ||
       baseTypeSyntaxNodeIndex >= value.typeSyntaxCount:
        err = " typed expr type arena: object base TypeSyntax missing"
        return false
    let syntaxTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, baseTypeSyntaxNodeIndex)
    if syntaxTypeId < 0 || syntaxTypeId >= value.typeCount:
        err = " typed expr type arena: object base canonical TypeId missing"
        return false
    let syntaxKind = TypedExprStructuralTypeKind(
        typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, syntaxTypeId))
    if syntaxKind == TypedExprStructuralTypeObject:
        targetSymbolIdOut = typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, syntaxTypeId)
    elif syntaxKind == TypedExprStructuralTypeApply:
        targetSymbolIdOut = typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, syntaxTypeId)
        applyTypeIdOut = syntaxTypeId
    else:
        if syntaxKind == TypedExprStructuralTypeRefObject:
            err = " typed expr type arena: ref object or non-object base forbidden"
        else:
            err = " typed expr type arena: object base must resolve to concrete object"
        return false
    if targetSymbolIdOut < 0 ||
       targetSymbolIdOut >= value.symbolCount:
        err = " typed expr type arena: object base SymbolId invalid"
        return false
    let targetRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, targetSymbolIdOut)
    # [S1b-1c] Seal-phase read #2 (ObjectBaseTargetInto): parser kind of the
    # base declaration root, read from the arena row the append phase filled.
    let targetParserKind = typedExprTypeArenaSyntaxKindAt(value, targetRoot)
    let targetTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, targetRoot)
    if (targetParserKind != parser.ParserTypeSyntaxObject &&
        targetParserKind != parser.ParserTypeSyntaxImplicitObject) ||
       targetTypeId < 0 || targetTypeId >= value.typeCount ||
       typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, targetTypeId) !=
           Int32(TypedExprStructuralTypeObject):
        err = " typed expr type arena: ref object or non-object base forbidden"
        return false
    return true

@borrows
fn typedExprTypeArenaFinalizeObjectBaseDfs(
        state: var TypedExprTypeArenaBuildState,
        value: var TypedExprTypeArena,
        symbolId: int32,
        colors: var int32[],
        err: var str): bool =
    if symbolId < 0 || symbolId >= value.symbolCount ||
       colors.len != value.symbolCount:
        err = " typed expr type arena: inheritance proof domain invalid"
        return false
    if colors[symbolId] == 2:
        return true
    if colors[symbolId] == 1:
        err = " typed expr type arena: object inheritance cycle"
        return false
    colors[symbolId] = 1
    let declarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
    let declarationTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, declarationRoot)
    let declarationKind = TypedExprStructuralTypeKind(
        typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, declarationTypeId))
    if declarationKind != TypedExprStructuralTypeObject &&
       declarationKind != TypedExprStructuralTypeRefObject:
        colors[symbolId] = 2
        return true
    let baseTypeSyntaxNodeIndex = typedExprTypeArenaInt32At(value, value.baseTypeSyntaxNodeIndexes.offset, value.baseTypeSyntaxNodeIndexes.len, declarationTypeId)
    let childCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, declarationTypeId)
    let premiseStart = typedExprTypeArenaInt32At(value, value.traitPremiseStarts.offset, value.traitPremiseStarts.len, declarationTypeId)
    let premiseCount = typedExprTypeArenaInt32At(value, value.traitPremiseCounts.offset, value.traitPremiseCounts.len, declarationTypeId)
    if baseTypeSyntaxNodeIndex < 0:
        if baseTypeSyntaxNodeIndex != -1 ||
           typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, declarationTypeId) != -1 ||
           premiseCount != childCount:
            err = " typed expr type arena: absent object base edge drift"
            return false
        colors[symbolId] = 2
        return true
    if premiseCount != childCount + 1:
        err = " typed expr type arena: inherited trait premise cardinality drift"
        return false
    var targetSymbolId: int32
    var applyTypeId: int32
    if !typedExprTypeArenaObjectBaseTargetInto(
           state,
           value,
           baseTypeSyntaxNodeIndex,
           targetSymbolId,
           applyTypeId,
           err) ||
       !typedExprTypeArenaFinalizeObjectBaseDfs(
           state, value, targetSymbolId, colors, err):
        return false
    let targetDeclarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, targetSymbolId)
    var concreteBaseTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, targetDeclarationRoot)
    if applyTypeId >= 0:
        let genericSymbolStart = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolStarts.offset, value.typeSyntaxGenericSymbolStarts.len, targetDeclarationRoot)
        let genericSymbolCount = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolCounts.offset, value.typeSyntaxGenericSymbolCounts.len, targetDeclarationRoot)
        let applyChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, applyTypeId)
        let applyChildCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, applyTypeId)
        if genericSymbolStart < 0 || genericSymbolCount <= 0 ||
           applyChildCount != genericSymbolCount + 1:
            err = " typed expr type arena: inherited generic base arity invalid"
            return false
        var argumentTypeIds: int32[]
        for genericOffset in 0..<genericSymbolCount:
            add(argumentTypeIds, typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, applyChildStart + genericOffset + 1))
        let sourceTypeCount = value.typeCount
        var memo: int32[]
        var visiting: bool[]
        setLen(memo, sourceTypeCount)
        setLen(visiting, sourceTypeCount)
        for typeId in 0..<sourceTypeCount:
            memo[typeId] = -1
        var specializedBaseTypeId: int32
        if !typedExprTypeArenaSpecializeTypeInto(
               state,
               value,
               baseTypeSyntaxNodeIndex,
               concreteBaseTypeId,
               genericSymbolStart,
               genericSymbolCount,
               argumentTypeIds,
               sourceTypeCount,
               memo,
               visiting,
               specializedBaseTypeId,
               err):
            return false
        concreteBaseTypeId = specializedBaseTypeId
    if concreteBaseTypeId < 0 ||
       concreteBaseTypeId >= value.typeCount ||
       typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, concreteBaseTypeId) !=
           Int32(TypedExprStructuralTypeObject) ||
       typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, concreteBaseTypeId) !=
           targetSymbolId:
        err = " typed expr type arena: concrete inherited base proof invalid"
        return false
    arenamod.ArenaArrayInt32Set(
        value.arena,
        value.baseTypeIds,
        declarationTypeId,
        concreteBaseTypeId)
    arenamod.ArenaArrayInt32Set(
        value.arena,
        value.traitPremiseTypeIds,
        premiseStart,
        concreteBaseTypeId)
    colors[symbolId] = 2
    return true

@borrows
fn typedExprTypeArenaInheritedFieldsValidateInto(
        value: TypedExprTypeArena,
        err: var str): bool =
    for symbolId in 0..<value.symbolCount:
        let declarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
        let declarationTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, declarationRoot)
        let declarationKind = TypedExprStructuralTypeKind(
            typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, declarationTypeId))
        if declarationKind != TypedExprStructuralTypeObject &&
           declarationKind != TypedExprStructuralTypeRefObject:
            continue
        let memberStart = typedExprTypeArenaInt32At(value, value.symbolMemberStarts.offset, value.symbolMemberStarts.len, symbolId)
        let memberCount = typedExprTypeArenaInt32At(value, value.symbolMemberCounts.offset, value.symbolMemberCounts.len, symbolId)
        for memberOffset in 0..<memberCount:
            let memberNameId = typedExprTypeArenaInt32At(value, value.memberNameIds.offset, value.memberNameIds.len, memberStart + memberOffset)
            var baseTypeId = typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, declarationTypeId)
            var depth: int32
            while baseTypeId >= 0:
                if baseTypeId >= value.typeCount ||
                   depth >= value.symbolCount ||
                   typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, baseTypeId) !=
                       Int32(TypedExprStructuralTypeObject):
                    err = " typed expr type arena: inherited field base chain invalid"
                    return false
                let baseSymbolId = typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, baseTypeId)
                if baseSymbolId < 0 || baseSymbolId >= value.symbolCount:
                    err = " typed expr type arena: inherited field SymbolId invalid"
                    return false
                let baseMemberStart = typedExprTypeArenaInt32At(value, value.symbolMemberStarts.offset, value.symbolMemberStarts.len, baseSymbolId)
                let baseMemberCount = typedExprTypeArenaInt32At(value, value.symbolMemberCounts.offset, value.symbolMemberCounts.len, baseSymbolId)
                for baseMemberOffset in 0..<baseMemberCount:
                    if typedExprTypeArenaInt32At(value, value.memberNameIds.offset, value.memberNameIds.len, baseMemberStart + baseMemberOffset) ==
                           memberNameId:
                        err = " typed expr type arena: inherited object field shadow forbidden"
                        return false
                baseTypeId = typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, baseTypeId)
                depth = depth + 1
    return true

@borrows
fn typedExprTypeArenaInheritanceAcyclicDfs(
        value: TypedExprTypeArena,
        symbolId: int32,
        colors: var int32[],
        err: var str): bool =
    if symbolId < 0 || symbolId >= value.symbolCount ||
       colors.len != value.symbolCount:
        err = " typed expr type arena: inheritance receipt domain invalid"
        return false
    if colors[symbolId] == 2:
        return true
    if colors[symbolId] == 1:
        err = " typed expr type arena: object inheritance cycle"
        return false
    colors[symbolId] = 1
    let declarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
    let declarationTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, declarationRoot)
    let declarationKind = TypedExprStructuralTypeKind(
        typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, declarationTypeId))
    if declarationKind == TypedExprStructuralTypeObject ||
       declarationKind == TypedExprStructuralTypeRefObject:
        let baseTypeId = typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, declarationTypeId)
        if baseTypeId >= 0:
            if baseTypeId >= value.typeCount ||
               typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, baseTypeId) !=
                   Int32(TypedExprStructuralTypeObject):
                err = " typed expr type arena: inheritance receipt base invalid"
                return false
            let baseSymbolId = typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, baseTypeId)
            if !typedExprTypeArenaInheritanceAcyclicDfs(
                   value, baseSymbolId, colors, err):
                return false
    colors[symbolId] = 2
    return true

@borrows
fn typedExprTypeArenaInheritanceAcyclic(
        value: TypedExprTypeArena,
        err: var str): bool =
    var colors: int32[]
    setLen(colors, value.symbolCount)
    for symbolId in 0..<value.symbolCount:
        if !typedExprTypeArenaInheritanceAcyclicDfs(
               value, symbolId, colors, err):
            return false
    return true

@borrows
fn typedExprTypeArenaFinalizeObjectBases(
        state: var TypedExprTypeArenaBuildState,
        value: var TypedExprTypeArena,
        err: var str): bool =
    var colors: int32[]
    setLen(colors, value.symbolCount)
    for symbolId in 0..<value.symbolCount:
        if !typedExprTypeArenaFinalizeObjectBaseDfs(
               state, value, symbolId, colors, err):
            return false
    return typedExprTypeArenaInheritedFieldsValidateInto(value, err)

@borrows
fn typedExprTypeArenaCompleteGenericArgumentsInto(
        state: var TypedExprTypeArenaBuildState,
        localOut: var TypedExprTypeArena,
        typeSyntaxNodeIndex: int32,
        declarationRoot: int32,
        explicitChildren: int32[],
        argumentTypeIdsOut: var int32[],
        err: var str): bool =
    argumentTypeIdsOut.len = 0
    if declarationRoot < 0 ||
       declarationRoot >= localOut.typeSyntaxCount:
        err = " typed expr type arena: generic declaration root invalid"
        return false
    # [S1b step-3 (6)] `declarationRoot` is a GLOBAL row and may belong to an
    # earlier source whose tree is gone.  [forward-decl] The generic window now
    # comes from the sealed index, which carries it for every source including
    # ones not yet appended; the argument count still comes from the arena
    # column filled at that same global row.  The whole-forest driver reads the
    # identical values.
    var genericSymbolStart: int32 = -1
    var genericSymbolCount: int32 = -1
    if !typedExprTypeArenaDeclarationGenericWindowAt(
           state, declarationRoot, genericSymbolStart, genericSymbolCount,
           err):
        err = Fmt" typed expr type arena: generic argument declaration window failed declaration_root={declarationRoot} bracket_row={typeSyntaxNodeIndex}: {err}"
        return false
    let explicitArgumentCount =
        typedExprTypeArenaSyntaxBracketArgCountAt(
            localOut, typeSyntaxNodeIndex)
    if genericSymbolStart < 0 || genericSymbolCount <= 0 ||
       genericSymbolStart >
           localOut.genericSymbolCount - genericSymbolCount ||
       explicitArgumentCount <= 0 ||
       explicitArgumentCount > genericSymbolCount ||
       explicitChildren.len != explicitArgumentCount + 1:
        err = " typed expr type arena: generic application arity authority mismatch"
        return false
    for explicitOffset in 0..<explicitArgumentCount:
        let explicitTypeId = explicitChildren[explicitOffset + 1]
        if explicitTypeId < 0 || explicitTypeId >= localOut.typeCount:
            err = " typed expr type arena: explicit generic argument TypeId invalid"
            return false
        add(argumentTypeIdsOut, explicitTypeId)
    for genericOffset in explicitArgumentCount..<genericSymbolCount:
        let genericSymbolRow = genericSymbolStart + genericOffset
        # [forward-decl] Same prefix-column forward edge: the default's row is
        # owned by the declaration's source and may not be materialised.
        if genericSymbolRow >=
               localOut.genericSymbolDefaultTypeSyntaxNodeIndexes.len:
            err = Fmt" typed expr type arena: generic default is not materialised declaration_root={declarationRoot} bracket_row={typeSyntaxNodeIndex} generic_symbol_row={genericSymbolRow} materialised={localOut.genericSymbolDefaultTypeSyntaxNodeIndexes.len} total={localOut.genericSymbolCount}"
            return false
        let defaultTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.genericSymbolDefaultTypeSyntaxNodeIndexes,
            genericSymbolRow)
        if defaultTypeSyntaxNode < 0 ||
           defaultTypeSyntaxNode >= localOut.typeSyntaxCount:
            err = " typed expr type arena: generic application arity authority mismatch; trailing default missing"
            return false
        let defaultTypeId = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.typeSyntaxTypeIds,
            defaultTypeSyntaxNode)
        if defaultTypeId < 0 || defaultTypeId >= localOut.typeCount:
            err = " typed expr type arena: generic default canonical TypeId unavailable"
            return false
        var dependencyVisiting: bool[]
        var dependencySeen: bool[]
        setLen(dependencyVisiting, localOut.typeCount)
        setLen(dependencySeen, localOut.typeCount)
        var referencesGeneric = false
        if !typedExprTypeArenaGenericDependenciesValidateInto(
               localOut,
               defaultTypeId,
               genericSymbolStart,
               genericSymbolCount,
               genericSymbolRow,
               dependencyVisiting,
               dependencySeen,
               referencesGeneric,
               err):
            return false
        var prefixArgumentTypeIds: int32[]
        setLen(prefixArgumentTypeIds, genericSymbolCount)
        for prefixOffset in 0..<genericSymbolCount:
            prefixArgumentTypeIds[prefixOffset] = -1
        for prefixOffset in 0..<argumentTypeIdsOut.len:
            prefixArgumentTypeIds[prefixOffset] =
                argumentTypeIdsOut[prefixOffset]
        let sourceTypeCount = localOut.typeCount
        var memo: int32[]
        var visiting: bool[]
        setLen(memo, sourceTypeCount)
        setLen(visiting, sourceTypeCount)
        for sourceTypeId in 0..<sourceTypeCount:
            memo[sourceTypeId] = -1
        var substitutedDefaultTypeId: int32
        if !typedExprTypeArenaSpecializeTypeInto(
               state,
               localOut,
               typeSyntaxNodeIndex,
               defaultTypeId,
               genericSymbolStart,
               genericSymbolCount,
               prefixArgumentTypeIds,
               sourceTypeCount,
               memo,
               visiting,
               substitutedDefaultTypeId,
               err):
            if err == "":
                err = " typed expr type arena: generic default substitution failed"
            return false
        add(argumentTypeIdsOut, substitutedDefaultTypeId)
    if argumentTypeIdsOut.len != genericSymbolCount:
        err = " typed expr type arena: complete generic argument vector missing"
        return false
    for genericOffset in 0..<genericSymbolCount:
        let genericSymbolRow = genericSymbolStart + genericOffset
        let constraintTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.genericSymbolConstraintTypeSyntaxNodeIndexes,
            genericSymbolRow)
        if constraintTypeSyntaxNode < 0:
            continue
        if constraintTypeSyntaxNode >= localOut.typeSyntaxCount:
            err = " typed expr type arena: generic constraint TypeSyntax invalid"
            return false
        let constraintTypeId = arenamod.ArenaArrayInt32Get(
            localOut.arena,
            localOut.typeSyntaxTypeIds,
            constraintTypeSyntaxNode)
        if constraintTypeId < 0 || constraintTypeId >= localOut.typeCount:
            err = " typed expr type arena: generic constraint canonical TypeId unavailable"
            return false
        var dependencyVisiting: bool[]
        var dependencySeen: bool[]
        setLen(dependencyVisiting, localOut.typeCount)
        setLen(dependencySeen, localOut.typeCount)
        var referencesGeneric = false
        if !typedExprTypeArenaGenericDependenciesValidateInto(
               localOut,
               constraintTypeId,
               genericSymbolStart,
               genericSymbolCount,
               genericSymbolStart + genericSymbolCount,
               dependencyVisiting,
               dependencySeen,
               referencesGeneric,
               err):
            return false
        let sourceTypeCount = localOut.typeCount
        var memo: int32[]
        var visiting: bool[]
        setLen(memo, sourceTypeCount)
        setLen(visiting, sourceTypeCount)
        for sourceTypeId in 0..<sourceTypeCount:
            memo[sourceTypeId] = -1
        var substitutedConstraintTypeId: int32
        if !typedExprTypeArenaSpecializeTypeInto(
               state,
               localOut,
               typeSyntaxNodeIndex,
               constraintTypeId,
               genericSymbolStart,
               genericSymbolCount,
               argumentTypeIdsOut,
               sourceTypeCount,
               memo,
               visiting,
               substitutedConstraintTypeId,
               err):
            if err == "":
                err = " typed expr type arena: generic constraint substitution failed"
            return false
        if substitutedConstraintTypeId !=
               argumentTypeIdsOut[genericOffset]:
            err = genericOffset < explicitArgumentCount ?
                " typed expr type arena: generic actual argument does not satisfy substituted exact constraint TypeId" :
                " typed expr type arena: generic default does not satisfy substituted exact constraint TypeId"
            return false
    err = ""
    return true

# Read-only over `tree` (same closure argument as
# TypedExprTypeResolutionAuthorityBuildPackageForestInto above): the caller
# still owns the forest and releases it after this returns.
# [S1b step-3 (4)] Row-coordinate rebase.  Every parser coordinate that names a
# row of another arena column (token, TypeSyntax, bracket-arg, generic-symbol)
# is source-local in a single-source tree and already global in the merged
# forest; adding the destination column's base makes both drivers store the
# same global coordinate.  -1 is "absent" and stays -1 in both.
@borrows
fn typedExprTypeArenaRebaseRow(base: int32, row: int32): int32 =
    if row < 0:
        return -1
    return base + row

# [S1b step-3 (4)] Token producer source index.  A single-source tree numbers
# its own source 0, so the per-source driver passes the loop index as the base;
# the whole-forest tree already carries the global index and the base is 0, so
# the stored value is unchanged.
@borrows
fn typedExprTypeArenaFillTokens(value: TypedExprTypeArena,
                                 tree: parser.ParserValueExprTree,
                                 viewProducerSourceBase: int32) =
    for tokenIndex in 0..<tree.tokenCount:
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.tokenProducerSourceIndexes,
            viewProducerSourceBase +
                parser.ParserValueExprTokenProducerSourceIndexAt(
                    tree, tokenIndex))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.tokenKinds,
            Int32(parser.ParserValueExprTokenKindAt(tree, tokenIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.tokenSpanStarts,
            parser.ParserValueExprTokenStartAt(tree, tokenIndex))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.tokenSpanEnds,
            parser.ParserValueExprTokenEndAt(tree, tokenIndex))

# [S1b-0c] Token text for the Seal-phase text tables.  Out-of-range tokens
# carry no text; the empty string is the column's "absent" value and is never
# interned.
@borrows
fn typedExprTypeArenaTokenTextOrEmpty(
        tree: parser.ParserValueExprTree,
        tokenIndex: int32): str =
    if tokenIndex < 0 || tokenIndex >= tree.tokenCount:
        return ""
    return parser.ParserValueExprTokenText(tree, tokenIndex)

# Same column-fill as FillTokens: loop lives here so the builder has no
# back-edge over ArenaArrayInt32Add(value.arena, value.column, ...).
@borrows
fn typedExprTypeArenaFillTypeSyntax(value: TypedExprTypeArena,
                                    tree: parser.ParserValueExprTree,
                                    viewProducerSourceIndex: int32,
                                    viewProducerSourceBase: int32,
                                    viewTokenRowBase: int32,
                                    viewBracketArgBase: int32,
                                    viewGenericSymbolBase: int32,
                                    err: var str): bool =
    # [S1b-0c] View bases.  Each is the destination column's length *before*
    # this tree is appended, i.e. exactly the global base of the rows this
    # tree is about to contribute.  The whole-forest driver passes
    # viewProducerSourceIndex 0, so every base is 0 and every rebase below is
    # an identity -- the fill is byte-for-byte the previous behaviour.
    let viewTypeSyntaxBase = value.typeSyntaxTypeIds.len
    let viewChildBase = value.typeSyntaxChildTypeSyntaxNodeIndexes.len
    let viewVariantBase = value.typeSyntaxEnumVariantOrdinals.len
    # [S1b step-3 (5)] Every token coordinate in this fill is rebased on
    # `viewTokenRowBase`, a driver-supplied parameter, and no base here is
    # derived from a destination length any more.  The 0c form
    # `let viewTokenBase = value.tokenProducerSourceIndexes.len` was wrong under
    # BOTH drivers: the token columns are filled by `FillTokens`, which runs
    # BEFORE this function, so that length is "this tree's tokens added onto the
    # base" -- for the whole-forest drive it is `tree.tokenCount` (every token
    # row already appended), for the per-source drive it is
    # `sourceTokenBase + tree.tokenCount`.  Neither is the base of this tree's
    # token rows.  With the whole-forest driver passing 0, each rebase below is
    # an identity and the stored coordinates are exactly what they always were.
    # The same reasoning covers `viewBracketArgBase` / `viewGenericSymbolBase`:
    # those columns are filled *after* this function, so they are still empty
    # here and cannot be read as bases either.
    # [c2-replay-cols] Scratch for the per-row function param count scan.
    var replayFactParamScratch: int32[]
    for typeSyntaxNodeIndex in 0..<tree.typeSyntaxCount:
        let producerSourceIndex =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                tree, typeSyntaxNodeIndex)
        let sourceLocalRow =
            parser.ParserValueExprTypeSyntaxSourceLocalRowAt(
                tree, typeSyntaxNodeIndex)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           sourceLocalRow < 0:
            err = " typed expr type arena: TypeSyntax producer source invalid"
            return false
        arenamod.ArenaArrayInt32Add(
            value.arena, value.typeSyntaxTypeIds, -1)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxParserKinds,
            Int32(parser.ParserValueExprTypeSyntaxKindAt(
                tree, typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxProducerSourceIndexes,
            viewProducerSourceBase + producerSourceIndex)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxSourceLocalRows,
            sourceLocalRow)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxSpanStarts,
            parser.ParserValueExprTypeSyntaxSpanStartAt(
                tree, typeSyntaxNodeIndex))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxSpanEnds,
            parser.ParserValueExprTypeSyntaxSpanEndAt(
                tree, typeSyntaxNodeIndex))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxOwnerTokenIndexes,
            typedExprTypeArenaRebaseRow(
                viewTokenRowBase,
                parser.ParserValueExprTypeSyntaxOwnerTokenAt(
                    tree, typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxQuestionTokenIndexes,
            typedExprTypeArenaRebaseRow(
                viewTokenRowBase,
                parser.ParserValueExprTypeSyntaxQuestionTokenAt(
                    tree, typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxDeclarationOwnerTokenIndexes,
            typedExprTypeArenaRebaseRow(
                viewTokenRowBase,
                parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                    tree, typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxDeclarationOwnerNodeIndexes,
            typedExprTypeArenaRebaseRow(
                viewTypeSyntaxBase,
                parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(
                    tree, typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxGenericSymbolStarts,
            typedExprTypeArenaRebaseRow(
                viewGenericSymbolBase,
                parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(
                    tree, typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxGenericSymbolCounts,
            parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(
                tree, typeSyntaxNodeIndex))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxRootKinds,
            Int32(parser.ParserValueExprTypeSyntaxRootKindAt(
                tree, typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxBracketArgStarts,
            typedExprTypeArenaRebaseRow(
                viewBracketArgBase,
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeSyntaxBracketArgStarts,
                    typeSyntaxNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxBracketArgCounts,
            parser.ParserValueExprTypeSyntaxBracketArgCountAt(
                tree, typeSyntaxNodeIndex))
        var bracketBaseTypeSyntaxNodeIndex: int32 = -1
        let parserKind = parser.ParserValueExprTypeSyntaxKindAt(
            tree, typeSyntaxNodeIndex)
        if parserKind == parser.ParserTypeSyntaxFixedArray ||
           parserKind == parser.ParserTypeSyntaxBracketApply:
            if parser.ParserValueExprTypeSyntaxChildCountAt(
                   tree, typeSyntaxNodeIndex) <= 0:
                err = " typed expr type arena: bracket base TypeSyntax missing"
                return false
            bracketBaseTypeSyntaxNodeIndex =
                parser.ParserValueExprTypeSyntaxChildAt(
                    tree, typeSyntaxNodeIndex, 0)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxBracketBaseTypeSyntaxNodeIndexes,
            typedExprTypeArenaRebaseRow(
                viewTypeSyntaxBase, bracketBaseTypeSyntaxNodeIndex))
        # [S1b-0c] Parser facts the Seal phase needs once no tree is resident.
        # Every base below is the destination column's current length: rows are
        # appended in source order, so the running length IS the global base of
        # the tree being viewed (all zero for the whole-forest driver, the
        # source's global base for the per-source driver).  Parser coordinates
        # are source-local in a single-source tree, which is exactly why each
        # one is rebased here rather than copied.
        let childCount = parser.ParserValueExprTypeSyntaxChildCountAt(
            tree, typeSyntaxNodeIndex)
        let sourceChildStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeSyntaxChildStarts, typeSyntaxNodeIndex)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxChildStarts,
            sourceChildStart < 0 ? -1 : viewChildBase + sourceChildStart)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.typeSyntaxChildCounts, childCount)
        # [c2-replay-cols] Materialise the per-row fixed length verbatim from
        # the tree column, and the function param count with the same tree scan
        # the intern-time call uses.  The scratch child count passed here is
        # exactly what the intern-time call passes: the arena child CSR stores
        # this same `childCount` value one line above.
        arenamod.ArenaArrayInt32Add(
            value.arena, value.typeSyntaxFixedLengthsByRow,
            parser.ParserValueExprTypeSyntaxFixedLengthAt(
                tree, typeSyntaxNodeIndex))
        if parserKind == parser.ParserTypeSyntaxFunction:
            setLen(replayFactParamScratch, childCount)
            var materialisedParamCount: int32
            if !typedExprTypeArenaFunctionParamCount(
                   tree, typeSyntaxNodeIndex, 0,
                   replayFactParamScratch, materialisedParamCount):
                materialisedParamCount = -1
            arenamod.ArenaArrayInt32Add(
                value.arena, value.typeSyntaxFunctionParamCountsByRow,
                materialisedParamCount)
        else:
            arenamod.ArenaArrayInt32Add(
                value.arena, value.typeSyntaxFunctionParamCountsByRow, -1)
        for childOffset in 0..<childCount:
            let childRow = parser.ParserValueExprTypeSyntaxChildAt(
                tree, typeSyntaxNodeIndex, childOffset)
            arenamod.ArenaArrayInt32Add(
                value.arena,
                value.typeSyntaxChildTypeSyntaxNodeIndexes,
                childRow < 0 ? -1 : viewTypeSyntaxBase + childRow)
            arenamod.ArenaArrayInt32Add(
                value.arena, value.typeSyntaxChildNameIdsByRow, -1)
        let variantCount = parser.ParserValueExprTypeSyntaxEnumVariantCountAt(
            tree, typeSyntaxNodeIndex)
        let sourceVariantStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeSyntaxEnumVariantStarts, typeSyntaxNodeIndex)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.typeSyntaxEnumVariantStarts,
            sourceVariantStart < 0 ? -1 : viewVariantBase + sourceVariantStart)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.typeSyntaxEnumVariantCounts, variantCount)
        for variantOffset in 0..<variantCount:
            let variantRow = parser.ParserValueExprTypeSyntaxEnumVariantRowAt(
                tree, typeSyntaxNodeIndex, variantOffset)
            if variantRow < 0 || variantRow >= tree.typeEnumVariantCount:
                err = " typed expr type arena: enum variant row invalid"
                return false
            let payloadTypeSyntaxNode =
                parser.ParserValueExprTypeSyntaxEnumVariantPayloadTypeNodeAt(
                    tree, typeSyntaxNodeIndex, variantOffset)
            arenamod.ArenaArrayInt32Add(
                value.arena,
                value.typeSyntaxEnumVariantPayloadTypeSyntaxNodeIndexes,
                payloadTypeSyntaxNode < 0 ?
                    -1 : viewTypeSyntaxBase + payloadTypeSyntaxNode)
            # [S1b step-3 (6)] The variant's producer source is a per-ROW
            # parser fact, not the view's source: a merged forest carries every
            # source in one tree.  The 0c form wrote the view index, which is 0
            # for the whole-forest driver and therefore forged source 0 onto
            # every enum variant outside source 0 -- a latent defect that the
            # single-source fixtures cannot see and that `BuildEnumDeclaration`
            # rejects with `enum variant authority invalid`.  The 0c rebase
            # form below is the one every other coordinate column uses: base 0
            # for the whole-forest driver (identity), the source base for the
            # streaming driver.
            arenamod.ArenaArrayInt32Add(
                value.arena,
                value.typeSyntaxEnumVariantProducerSourceIndexes,
                viewProducerSourceBase +
                    arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.typeEnumVariantProducerSourceIndexes,
                        variantRow))
            let variantOwnerNode = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeEnumVariantDeclarationOwnerNodeIndexes,
                variantRow)
            arenamod.ArenaArrayInt32Add(
                value.arena,
                value.typeSyntaxEnumVariantDeclarationOwnerNodeIndexes,
                variantOwnerNode < 0 ? -1 : viewTypeSyntaxBase + variantOwnerNode)
            let variantOwnerToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeEnumVariantDeclarationOwnerTokenIndexes,
                variantRow)
            arenamod.ArenaArrayInt32Add(
                value.arena,
                value.typeSyntaxEnumVariantDeclarationOwnerTokenIndexes,
                typedExprTypeArenaRebaseRow(
                    viewTokenRowBase, variantOwnerToken))
            arenamod.ArenaArrayInt32Add(
                value.arena,
                value.typeSyntaxEnumVariantOrdinals,
                arenamod.ArenaArrayInt32Get(
                    tree.arena, tree.typeEnumVariantOrdinals, variantRow))
            var variantNameText = ""
            let variantNameToken =
                parser.ParserValueExprTypeSyntaxEnumVariantNameTokenAt(
                    tree, typeSyntaxNodeIndex, variantOffset)
            # [S1b-1c] The token row is the global coordinate the Seal phase
            # checks the kind against; the text table below is its text.  Both
            # are needed because the Seal phase may not intern early (pool
            # order) and may not read the tree (it is released).
            arenamod.ArenaArrayInt32Add(
                value.arena,
                value.typeSyntaxEnumVariantNameTokenIndexes,
                typedExprTypeArenaRebaseRow(
                    viewTokenRowBase, variantNameToken))
            if variantNameToken >= 0 && variantNameToken < tree.tokenCount:
                variantNameText = parser.ParserValueExprTokenText(
                    tree, variantNameToken)
            add(value.typeSyntaxEnumVariantNameTokenTexts, variantNameText)
        add(value.typeSyntaxOwnerTokenTexts,
            typedExprTypeArenaTokenTextOrEmpty(
                tree, parser.ParserValueExprTypeSyntaxOwnerTokenAt(
                    tree, typeSyntaxNodeIndex)))
        add(value.typeSyntaxNameTokenTexts,
            typedExprTypeArenaTokenTextOrEmpty(
                tree, parser.ParserValueExprTypeSyntaxNameTokenAt(
                    tree, typeSyntaxNodeIndex)))
        add(value.typeSyntaxDeclarationOwnerTokenTexts,
            typedExprTypeArenaTokenTextOrEmpty(
                tree,
                parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                    tree, typeSyntaxNodeIndex)))
    return true

# [S1b step-3 (4)] Function rows.  `viewFunctionBase` is the global row of this
# tree's first function, so the per-source driver stores global function
# coordinates while the whole-forest driver (base 0) is unchanged; the source
# CSR loop is driven by an explicit group window for the same reason, and it
# also carries `viewTokenBase` for the declaration owner token column.
@borrows
@borrows
fn typedExprTypeArenaFillFunctions(value: var TypedExprTypeArena,
                                   tree: parser.ParserValueExprTree,
                                   viewFunctionBase: int32,
                                   viewGroupBase: int32,
                                   viewGroupCount: int32,
                                   viewTokenBase: int32,
                                   err: var str): bool =
    # [X1b-ta-scratch] The scratch lives in the arena and is reused across
    # sources; only `SeenByRow` carries state between sources and is cleared
    # for the rows this source touched (below).
    for producerSourceIndex in 0..<value.producerSourceCount:
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchSourceStarts,
            producerSourceIndex, -1)
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchSourceCounts,
            producerSourceIndex, 0)
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationFunction):
            continue
        let localProducerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        if localProducerSourceIndex < 0:
            err = " typed expr type arena: function declaration source invalid"
            return false
        let producerSourceIndex =
            viewGroupBase + localProducerSourceIndex
        let functionRow = viewFunctionBase +
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationFunctionRows,
                declarationRow)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= value.producerSourceCount ||
           functionRow < 0 || functionRow >= value.functionCount ||
           arenamod.ArenaArrayInt32Get(
               value.arena, value.functionScratchSeenByRow,
               functionRow) != 0:
            err = " typed expr type arena: function declaration authority invalid"
            return false
        let sourceLocalFunctionRow = arenamod.ArenaArrayInt32Get(
            value.arena, value.functionScratchSourceCounts,
            producerSourceIndex)
        let sourceStart = arenamod.ArenaArrayInt32Get(
            value.arena, value.functionScratchSourceStarts,
            producerSourceIndex)
        if sourceStart < 0:
            arenamod.ArenaArrayInt32Set(
                value.arena, value.functionScratchSourceStarts,
                producerSourceIndex, functionRow)
        elif functionRow != sourceStart + sourceLocalFunctionRow:
            err = " typed expr type arena: function source range is not dense"
            return false
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchSeenByRow, functionRow, 1)
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchProducerByRow, functionRow,
            producerSourceIndex)
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchSourceLocalByRow, functionRow,
            sourceLocalFunctionRow)
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchDeclarationLocalByRow,
            functionRow,
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationSourceLocalRows,
                declarationRow))
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchOwnerTokenByRow, functionRow,
            typedExprTypeArenaRebaseRow(
                viewTokenBase,
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationNameTokenIndexes,
                    declarationRow)))
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchSourceCounts,
            producerSourceIndex, sourceLocalFunctionRow + 1)
    let viewFunctionEnd = viewFunctionBase + tree.declarationFunctionCount
    for functionRow in viewFunctionBase..<viewFunctionEnd:
        if arenamod.ArenaArrayInt32Get(
               value.arena, value.functionScratchSeenByRow,
               functionRow) == 0:
            err = " typed expr type arena: function row has no declaration"
            return false
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.functionProducerSourceIndexes,
            arenamod.ArenaArrayInt32Get(
                value.arena, value.functionScratchProducerByRow,
                functionRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.functionSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                value.arena, value.functionScratchSourceLocalByRow,
                functionRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.functionDeclarationSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                value.arena, value.functionScratchDeclarationLocalByRow,
                functionRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.functionOwnerTokenIndexes,
            arenamod.ArenaArrayInt32Get(
                value.arena, value.functionScratchOwnerTokenByRow,
                functionRow))
        # Clear the mark for the rows this source used, so the next source sees
        # a clean scratch bitmap.
        arenamod.ArenaArrayInt32Set(
            value.arena, value.functionScratchSeenByRow, functionRow, 0)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.functionReturnTypeIds, -1)
    var sourceFunctionCursor: int32 = viewFunctionBase
    for groupOffset in 0..<viewGroupCount:
        let producerSourceIndex = viewGroupBase + groupOffset
        if producerSourceIndex < 0 ||
           producerSourceIndex >= value.producerSourceCount:
            err = " typed expr type arena: function source group invalid"
            return false
        let sourceCount = arenamod.ArenaArrayInt32Get(
            value.arena, value.functionScratchSourceCounts,
            producerSourceIndex)
        let sourceStart = arenamod.ArenaArrayInt32Get(
            value.arena, value.functionScratchSourceStarts,
            producerSourceIndex)
        if (sourceCount == 0 && sourceStart != -1) ||
           (sourceCount > 0 && sourceStart != sourceFunctionCursor):
            err = " typed expr type arena: function source CSR invalid"
            return false
        arenamod.ArenaArrayInt32Add(
            value.arena, value.functionSourceStarts,
            sourceFunctionCursor)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.functionSourceCounts, sourceCount)
        sourceFunctionCursor = sourceFunctionCursor + sourceCount
    if sourceFunctionCursor != viewFunctionEnd:
        err = " typed expr type arena: function source coverage incomplete"
        return false
    return true

@borrows
fn typedExprTypeArenaFillBracketArgs(value: TypedExprTypeArena,
                                     tree: parser.ParserValueExprTree,
                                     viewTypeSyntaxBase: int32) =
    for argRow in 0..<tree.typeSyntaxBracketArgCount:
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.bracketArgTokenStarts,
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxBracketArgTokenStarts,
                argRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.bracketArgTokenCounts,
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxBracketArgTokenCounts,
                argRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.bracketArgTypeSyntaxNodeIndexes,
            typedExprTypeArenaRebaseRow(
                viewTypeSyntaxBase,
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeSyntaxBracketArgTypeNodeIndexes,
                    argRow)))

@borrows
fn typedExprTypeArenaFillGenericSymbols(value: TypedExprTypeArena,
                                        tree: parser.ParserValueExprTree,
                                        viewProducerSourceBase: int32,
                                        viewTokenBase: int32,
                                        viewTypeSyntaxBase: int32,
                                        viewGenericSymbolChildBase: int32) =
    for symbolRow in 0..<tree.typeGenericSymbolCount:
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolProducerSourceIndexes,
            viewProducerSourceBase +
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeGenericSymbolProducerSourceIndexes,
                    symbolRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolDeclarationOwnerTokenIndexes,
            typedExprTypeArenaRebaseRow(
                viewTokenBase,
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
                    symbolRow)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolNameTokenIndexes,
            typedExprTypeArenaRebaseRow(
                viewTokenBase,
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeGenericSymbolNameTokenIndexes,
                    symbolRow)))
        let genericNameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.typeGenericSymbolNameTokenIndexes,
            symbolRow)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolNameIds,
            langintern.Intern(
                value.internPool,
                strings.CloneStr(
                    parser.ParserValueExprTokenText(
                        tree, genericNameToken))))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolOrdinals,
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeGenericSymbolOrdinals, symbolRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolSpanStarts,
            parser.ParserValueExprTypeGenericSymbolSpanStartAt(
                tree, symbolRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolSpanEnds,
            parser.ParserValueExprTypeGenericSymbolSpanEndAt(
                tree, symbolRow))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolOwnerTypeSyntaxNodeIndexes,
            typedExprTypeArenaRebaseRow(
                viewTypeSyntaxBase,
                parser.ParserValueExprTypeGenericSymbolOwnerTypeSyntaxNodeAt(
                    tree, symbolRow)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolConstraintTypeSyntaxNodeIndexes,
            typedExprTypeArenaRebaseRow(
                viewTypeSyntaxBase,
                parser.ParserValueExprTypeGenericSymbolConstraintTypeSyntaxNodeAt(
                    tree, symbolRow)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolDefaultTypeSyntaxNodeIndexes,
            typedExprTypeArenaRebaseRow(
                viewTypeSyntaxBase,
                parser.ParserValueExprTypeGenericSymbolDefaultTypeSyntaxNodeAt(
                    tree, symbolRow)))
        arenamod.ArenaArrayInt32Add(
            value.arena, value.genericSymbolConstraintTypeIds, -1)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.genericSymbolDefaultTypeIds, -1)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolChildStarts,
            typedExprTypeArenaRebaseRow(
                viewGenericSymbolChildBase,
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeGenericSymbolChildStarts,
                    symbolRow)))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolChildCounts,
            parser.ParserValueExprTypeGenericSymbolChildCountAt(
                tree, symbolRow))

@borrows
fn typedExprTypeArenaFillGenericSymbolChildren(
        value: TypedExprTypeArena,
        tree: parser.ParserValueExprTree,
        viewTypeSyntaxBase: int32) =
    for childRow in 0..<tree.typeGenericSymbolChildCount:
        let childTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.typeGenericSymbolChildTypeSyntaxNodeIndexes,
            childRow)
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.genericSymbolChildTypeSyntaxNodeIndexes,
            typedExprTypeArenaRebaseRow(
                viewTypeSyntaxBase, childTypeSyntaxNode))
        arenamod.ArenaArrayInt32Add(
            value.arena, value.genericSymbolChildTypeIds, -1)

# [S1b step-3 (6)] Global-row form of the declaration SymbolId pass.  Rows are
# appended in source order, so `viewTypeSyntaxBase + local row` is the same
# global row the merged forest carried; `viewProducerSourceBase` and
# `viewTokenRowBase` do the same for the two coordinate columns.  The
# whole-forest driver passes 0 for all three and every expression below is the
# previous one, unchanged.
@borrows
@borrows
fn typedExprTypeArenaFillDeclarationSymbols(
        value: TypedExprTypeArena,
        tree: parser.ParserValueExprTree,
        state: TypedExprTypeArenaBuildState,
        viewTypeSyntaxBase: int32,
        viewProducerSourceBase: int32,
        viewTokenRowBase: int32,
        err: var str): bool =
    for typeSyntaxNodeIndex in 0..<tree.typeSyntaxCount:
        if !typedExprTypeArenaDeclarationCreatesSymbol(
               tree, typeSyntaxNodeIndex):
            continue
        let rootKind = parser.ParserValueExprTypeSyntaxRootKindAt(
            tree, typeSyntaxNodeIndex)
        let declarationOwner =
            parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(
                tree, typeSyntaxNodeIndex)
        if (rootKind == parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
            declarationOwner != typeSyntaxNodeIndex) ||
           (rootKind == parser.ParserTypeSyntaxRootFieldDeclaration &&
            (declarationOwner < 0 ||
             declarationOwner >= typeSyntaxNodeIndex ||
             state.symbolByDeclarationRoot[
                 viewTypeSyntaxBase + declarationOwner] < 0)):
            err = " typed expr type arena: declaration SymbolId owner is not exact"
            return false
        let ownerToken =
            typedExprTypeArenaDeclarationSymbolNameToken(
                tree, typeSyntaxNodeIndex)
        let producerSourceIndex =
            viewProducerSourceBase +
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                tree, typeSyntaxNodeIndex)
        if ownerToken < 0 || ownerToken >= tree.tokenCount ||
           producerSourceIndex < 0 ||
           producerSourceIndex >= value.producerSourceCount:
            err = " typed expr type arena: declaration SymbolId authority invalid"
            return false
        let symbolId = value.symbolCount
        # [closure8] The seeded SymbolId (index-derived) and the sequential
        # counter are two derivations of one integer.  They are compared here,
        # at the only place either is written, so a disagreement aborts
        # instead of silently shifting every later symbol.
        if state.symbolByDeclarationRoot[
               viewTypeSyntaxBase + typeSyntaxNodeIndex] != symbolId:
            err = Fmt" typed expr type arena: declaration SymbolId derivation mismatch root={viewTypeSyntaxBase + typeSyntaxNodeIndex} indexed={state.symbolByDeclarationRoot[viewTypeSyntaxBase + typeSyntaxNodeIndex]} sequential={symbolId}"
            return false
        state.symbolByDeclarationRoot[
            viewTypeSyntaxBase + typeSyntaxNodeIndex] = symbolId
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.symbolDeclarationRootTypeSyntaxNodeIndexes,
            viewTypeSyntaxBase + typeSyntaxNodeIndex)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.symbolProducerSourceIndexes,
            producerSourceIndex)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.symbolDeclarationOwnerTokenIndexes,
            typedExprTypeArenaRebaseRow(viewTokenRowBase, ownerToken))
        arenamod.ArenaArrayInt32Add(
            value.arena,
            value.symbolNameIds,
            langintern.Intern(
                value.internPool,
                strings.CloneStr(
                    parser.ParserValueExprTokenText(tree, ownerToken))))
        arenamod.ArenaArrayInt32Add(
            value.arena, value.symbolMemberStarts, -1)
        arenamod.ArenaArrayInt32Add(
            value.arena, value.symbolMemberCounts, 0)
        value.symbolCount = value.symbolCount + 1
    return true

# One symbol per frame so ReserveAggregate's var-out of value/state/err
# has no loop-header merge in the builder.
# [S1b step-3 (6)] The declaration root is a GLOBAL row (it came out of
# `symbolDeclarationRootTypeSyntaxNodeIndexes`), so every fact about it is read
# from the arena columns the append phase already filled at that same global
# row: parser kind, enum variant count and the enum variant payload column.
# The whole-forest driver reads the identical values, because FillTypeSyntax
# materialised them from that forest.  `symbolId` starts at this source's
# first symbol instead of 0; source k's symbols all have rows greater than
# source k-1's, so the visit order is the merged order.
@borrows
@borrows
fn typedExprTypeArenaReserveAggregatesRec(
        value: var TypedExprTypeArena,
        state: var TypedExprTypeArenaBuildState,
        symbolId: int32,
        err: var str): bool =
    while true:
        if symbolId >= value.symbolCount:
            return true
        let declarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
        var structuralKind = TypedExprStructuralTypeInvalid
        let parserKind =
            typedExprTypeArenaSyntaxKindAt(value, declarationRoot)
        if parserKind == parser.ParserTypeSyntaxObject ||
           parserKind == parser.ParserTypeSyntaxImplicitObject:
            structuralKind = TypedExprStructuralTypeObject
        elif parserKind == parser.ParserTypeSyntaxRefObject:
            structuralKind = TypedExprStructuralTypeRefObject
        elif parserKind == parser.ParserTypeSyntaxEnum:
            structuralKind = TypedExprStructuralTypeEnum
        var aggregateChildCount: int32
        if structuralKind == TypedExprStructuralTypeObject ||
           structuralKind == TypedExprStructuralTypeRefObject:
            aggregateChildCount =
                state.fieldCountsByDeclarationRoot[declarationRoot]
        elif structuralKind == TypedExprStructuralTypeEnum:
            let variantCount =
                typedExprTypeArenaSyntaxEnumVariantCountAt(
                    value, declarationRoot)
            if variantCount < 0:
                err = " typed expr type arena: enum variant CSR view invalid"
                return false
            for variantOffset in 0..<variantCount:
                if typedExprTypeArenaEnumVariantPayloadTypeNodeAt(
                       value,
                       typedExprTypeArenaSyntaxEnumVariantRowAt(
                           value, declarationRoot, variantOffset)) >= 0:
                    aggregateChildCount = aggregateChildCount + 1
        if structuralKind != TypedExprStructuralTypeInvalid:
            var reservedTypeId: int32
            if !typedExprTypeArenaReserveAggregate(
                   state, value, declarationRoot, symbolId, structuralKind,
                   aggregateChildCount, reservedTypeId, err):
                return false
        symbolId = symbolId + 1
        continue

# One TypeSyntax row per frame. Intern/ResolveNominal var-out of
# value/state/err must not sit under a builder loop-header merge.
@borrows
fn typedExprTypeArenaInternSyntaxRec(
        value: var TypedExprTypeArena,
        tree: parser.ParserValueExprTree,
        authority: TypedExprTypeResolutionAuthority,
        state: var TypedExprTypeArenaBuildState,
        pending: TypedExprTypeArenaPendingGenericApply,
        replayForward: bool,
        typeSyntaxNodeIndex: int32,
        viewTypeSyntaxBase: int32,
        viewTokenRowBase: int32,
        err: var str): bool =
    # [forward-typeid] The queue is taken from the state, not from a parameter:
    # its row space is exactly `state.typeSyntaxCount`, which
    # `AllocateFromLimitsInto` already has, so no caller of
    # `AppendSourceFromTreeInto` needs to name it.  `replayForward` is the only
    # mode bit, and it is a parameter because this function is called from
    # exactly two places that differ in nothing else.
    let forward = state.forwardNominal
    if forward == nil:
        err = " typed expr type arena: forward nominal queue missing"
        return false
    # [S1b step-3 (6)] `typeSyntaxNodeIndex` is a GLOBAL row and stays global:
    # the TypeId column, the parent links, the authority rows and the pending
    # generic-apply receipts are all keyed by it.  The resident tree carries
    # this source's rows only, so a parser read subtracts `viewTypeSyntaxBase`
    # and a parser fact that must be global (child row, kind, question token,
    # bracket argument) is taken from the arena column the append phase wrote
    # at that same global row.  The whole-forest driver passes base 0, so
    # `treeRow == typeSyntaxNodeIndex` and every read is the previous one.
    while true:
        if typeSyntaxNodeIndex >= viewTypeSyntaxBase + tree.typeSyntaxCount:
            return true
        # [forward-typeid] Row filter.  The append pass processes rows that are
        # NOT flagged; the replay pass processes exactly the flagged ones.  With
        # nothing deferred every flag is false, so the append branch never
        # skips and this block is the identity -- which is what makes the
        # empty-queue path byte-identical to the pre-step-3 build.
        if forward.blockedFlags.len == state.typeSyntaxCount:
            if replayForward:
                if !forward.blockedFlags[typeSyntaxNodeIndex]:
                    typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
                    continue
            elif forward.blockedFlags[typeSyntaxNodeIndex]:
                typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
                continue
        let treeRow = typeSyntaxNodeIndex - viewTypeSyntaxBase
        let kind = parser.ParserValueExprTypeSyntaxKindAt(tree, treeRow)
        if kind == parser.ParserTypeSyntaxObject ||
           kind == parser.ParserTypeSyntaxRefObject ||
           kind == parser.ParserTypeSyntaxImplicitObject ||
           kind == parser.ParserTypeSyntaxEnum:
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        let parentTypeSyntaxNodeIndex =
            state.typeSyntaxParentNodeIndexes[typeSyntaxNodeIndex]
        let qualifiedSegment =
            kind == parser.ParserTypeSyntaxNominal &&
            parentTypeSyntaxNodeIndex >= 0 &&
            typedExprTypeArenaSyntaxKindAt(
                value, parentTypeSyntaxNodeIndex) ==
                parser.ParserTypeSyntaxQualified
        if qualifiedSegment:
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        var children: int32[]
        var childNames: int32[]
        let childCount = typedExprTypeArenaSyntaxChildCountAt(
            value, typeSyntaxNodeIndex)
        # [forward-typeid] Block propagation.  A row whose structural child is
        # deferred cannot be interned at all: `typedExprTypeArenaIntern`'s
        # structural key contains `children` (and `baseTypeId`), so minting the
        # parent before the child's real TypeId exists would mint a DIFFERENT
        # key, add a duplicate type row, and shift `typeCount` -- the dedup
        # chain makes "intern with a placeholder" impossible, not merely
        # undesirable.  Children always own smaller rows (postorder, checked in
        # the loop below), so one ascending walk already decides the whole
        # blocked set; no fixpoint iteration is needed.  In the replay pass this
        # check is OFF: those rows are exactly the ones being resolved.
        if !replayForward &&
           forward.blockedFlags.len == state.typeSyntaxCount:
            var blockedChild: bool
            for childOffset in 0..<childCount:
                let childNode = typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, childOffset)
                if childNode >= 0 && childNode < value.typeSyntaxCount &&
                   forward.blockedFlags[childNode]:
                    blockedChild = true
            if blockedChild:
                # [forward-typeid][L4 pool-order] DO NOT DELETE THIS BLOCK.
                # A deferred Tuple row must still run its child-name interning
                # at THIS position: `typedExprTypeArenaTupleChildNameId` inserts
                # text into `internPool`, pool ids are assigned by insertion
                # order, and `childNameIds` feeds `artifactRaw32`.  Deferring
                # the insertion would renumber every later pool entry.  Only the
                # TYPE minting is deferred.  The replay recomputes the same ids
                # (interning is idempotent by text) and inserts nothing new.
                # This block is the only thing L4 verifies; if it is removed,
                # L4's tuple fixture is the first thing that breaks.
                if kind == parser.ParserTypeSyntaxTuple:
                    for childOffset in 0..<childCount:
                        let childNode = typedExprTypeArenaSyntaxChildAt(
                            value, typeSyntaxNodeIndex, childOffset)
                        let deferredTupleNameId =
                            typedExprTypeArenaTupleChildNameId(
                                value, tree, childNode, viewTypeSyntaxBase)
                        # [c2-replay-cols] Materialise the id the replay reads.
                        # The interning itself must stay in THIS position (pool
                        # order, see the block comment above).
                        typedExprTypeArenaSyntaxChildNameIdSetAt(
                            value, typeSyntaxNodeIndex, childOffset,
                            deferredTupleNameId)
                if !typedExprTypeArenaForwardNominalEnqueueInto(
                       forward, typeSyntaxNodeIndex, -1,
                       typedExprTypeArenaSyntaxProducerSourceIndexAt(
                           value, typeSyntaxNodeIndex), err):
                    return false
                typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
                continue
        if kind != parser.ParserTypeSyntaxQualified:
            setLen(children, childCount)
            setLen(childNames, childCount)
            for childOffset in 0..<childCount:
                let childNode = typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, childOffset)
                if childNode < 0 || childNode >= typeSyntaxNodeIndex:
                    err = " typed expr type arena: TypeSyntax is not postorder"
                    return false
                let childTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, childNode)
                if childTypeId < 0 || childTypeId >= value.typeCount:
                    err = " typed expr type arena: child TypeId unavailable"
                    return false
                children[childOffset] = childTypeId
                childNames[childOffset] = -1
        var typeId: int32 = -1
        # [forward-typeid] Reset immediately before the dispatch: the qualified
        # arm short-circuits on `childCount < 2` without calling
        # `ResolveNominal`, and without this reset that path would read the
        # previous row's verdict.
        state.forwardNominalRoot = -1
        if kind == parser.ParserTypeSyntaxNominal:
            if !typedExprTypeArenaResolveNominal(
                   state, value, typeSyntaxNodeIndex, viewTypeSyntaxBase,
                   viewTokenRowBase, replayForward, false, typeId, err):
                return false
        elif kind == parser.ParserTypeSyntaxQualified:
            if childCount < 2 ||
               !typedExprTypeArenaResolveNominal(
                   state, value, typeSyntaxNodeIndex, viewTypeSyntaxBase,
                   viewTokenRowBase, replayForward, false, typeId, err):
                if err == "":
                    err = " typed expr type arena: qualified nominal path incomplete"
                return false
            for childOffset in 0..<childCount:
                let childNode = typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, childOffset)
                if childNode < 0 || childNode >= typeSyntaxNodeIndex ||
                   state.typeSyntaxParentNodeIndexes[childNode] !=
                       typeSyntaxNodeIndex ||
                   typedExprTypeArenaSyntaxKindAt(value, childNode) !=
                       parser.ParserTypeSyntaxNominal:
                    err = " typed expr type arena: qualified nominal segment invalid"
                    return false
                arenamod.ArenaArrayInt32Set(
                    value.arena,
                    value.typeSyntaxTypeIds,
                    childNode,
                    typeId)
        elif kind == parser.ParserTypeSyntaxVarBorrow:
            if children.len != 1 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeBorrow,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: borrow shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxSeq:
            if children.len != 1 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeSequence,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: sequence shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxGrouped:
            if children.len != 1:
                err = " typed expr type arena: grouped type shape invalid"
                return false
            typeId = children[0]
        elif kind == parser.ParserTypeSyntaxOptional:
            if children.len != 1 ||
               typedExprTypeArenaSyntaxQuestionTokenAt(
                   value, typeSyntaxNodeIndex) < 0 ||
               !typedExprTypeArenaIntern(
                   state,
                   value,
                   typeSyntaxNodeIndex,
                   TypedExprStructuralTypeOptional,
                   TypedExprStructuralScalarInvalid,
                   -1,
                   -1,
                   -1,
                   -1,
                   -1,
                   -1,
                   children,
                   childNames,
                   typeId,
                   err):
                if err == "":
                    err = " typed expr type arena: optional shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxFixedArray:
            let fixedLength = parser.ParserValueExprTypeSyntaxFixedLengthAt(
                tree, treeRow)
            if children.len != 1 || fixedLength <= 0 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeFixedArray,
                   TypedExprStructuralScalarInvalid, -1, -1,
                   fixedLength, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: literal fixed-array proof invalid"
                return false
        elif kind == parser.ParserTypeSyntaxBracketApply:
            if childCount <= 0:
                err = " typed expr type arena: bracket base TypeSyntax missing"
                return false
            let baseTypeSyntaxNode =
                typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, 0)
            let authorityRow = typedExprTypeArenaAuthorityRow(
                state, baseTypeSyntaxNode)
            var genericApplied = false
            if authorityRow >= 0:
                let declarationRoot =
                    authority.declarationRootTypeSyntaxNodeIndexes[
                        authorityRow]
                # [forward-decl] Same forward edge as the preflight, answered
                # the same way: the window comes from the sealed index, not
                # from a materialised prefix, so the OOB guard is gone with it.
                var genericCount: int32
                var declarationGenericStart: int32 = -1
                if !typedExprTypeArenaDeclarationGenericWindowAt(
                       state, declarationRoot, declarationGenericStart,
                       genericCount, err):
                    err = Fmt" typed expr type arena: generic apply declaration window failed bracket_row={typeSyntaxNodeIndex} base_row={baseTypeSyntaxNode} authority_row={authorityRow}: {err}"
                    return false
                if genericCount > 0:
                    let argCount =
                        typedExprTypeArenaSyntaxBracketArgCountAt(
                            value, typeSyntaxNodeIndex)
                    let symbolId =
                        state.symbolByDeclarationRoot[declarationRoot]
                    if declarationGenericStart < 0 || argCount <= 0 ||
                       argCount > genericCount ||
                       children.len != argCount + 1 || symbolId < 0:
                        err = " typed expr type arena: generic application arity authority mismatch"
                        return false
                    for argOffset in 0..<argCount:
                        let argTypeSyntaxNode =
                            typedExprTypeArenaSyntaxBracketArgTypeNodeAt(
                                value, typeSyntaxNodeIndex, argOffset)
                        if argTypeSyntaxNode < 0 ||
                           typedExprTypeArenaSyntaxChildAt(
                               value, typeSyntaxNodeIndex, argOffset + 1) !=
                               argTypeSyntaxNode ||
                           typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, argTypeSyntaxNode) != children[argOffset + 1]:
                            err = " typed expr type arena: generic argument TypeSyntax CSR incomplete"
                            return false
                    var completeArgumentTypeIds: int32[]
                    if !typedExprTypeArenaCompleteGenericArgumentsInto(
                           state,
                           value,
                           typeSyntaxNodeIndex,
                           declarationRoot,
                           children,
                           completeArgumentTypeIds,
                           err):
                        return false
                    var completeChildren: int32[]
                    var completeChildNames: int32[]
                    setLen(completeChildren, completeArgumentTypeIds.len + 1)
                    setLen(completeChildNames, completeArgumentTypeIds.len + 1)
                    completeChildren[0] = children[0]
                    completeChildNames[0] = -1
                    for genericOffset in 0..<completeArgumentTypeIds.len:
                        completeChildren[genericOffset + 1] =
                            completeArgumentTypeIds[genericOffset]
                        completeChildNames[genericOffset + 1] = -1
                    if !typedExprTypeArenaIntern(
                           state,
                           value,
                           typeSyntaxNodeIndex,
                           TypedExprStructuralTypeApply,
                           TypedExprStructuralScalarInvalid,
                           symbolId,
                           -1,
                           -1,
                           -1,
                           -1,
                           -1,
                           completeChildren,
                           completeChildNames,
                           typeId,
                           err):
                        return false
                    add(pending.typeIds, typeId)
                    add(pending.declarationRoots, declarationRoot)
                    add(pending.typeSyntaxNodeIndexes, typeSyntaxNodeIndex)
                    genericApplied = true
            if !genericApplied && authorityRow < 0:
                # [builtin-ctor] A bracket application whose base is a
                # built-in type constructor has no declaration authority.
                # The head is the base row's OWN scalar identity and the
                # arity comes from the closed constructor table -- never
                # from the syntax.  The resulting row is a TypeApply with
                # symbolId = -1 and children[0] = the builtin head, which is
                # exactly the cold chain's APPLY shape.  Layout and coreir
                # tag need no separate ruling: both already forward to
                # children[0] (compiler_csg.cheng:12637-12659,
                # canonical_type_chain.cheng:55-67).
                let builtinBaseTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, baseTypeSyntaxNode)
                if builtinBaseTypeId >= 0 && builtinBaseTypeId < value.typeCount &&
                   typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, builtinBaseTypeId) ==
                       Int32(TypedExprStructuralTypeScalar):
                    let builtinHeadKind = TypedExprStructuralScalarKind(
                        typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, builtinBaseTypeId))
                    let builtinArity =
                        typedExprTypeArenaBuiltinConstructorArity(builtinHeadKind)
                    if builtinArity > 0:
                        let builtinArgCount =
                            typedExprTypeArenaSyntaxBracketArgCountAt(
                                value, typeSyntaxNodeIndex)
                        if builtinArgCount != builtinArity ||
                           children.len != builtinArgCount + 1:
                            err = Fmt" typed expr type arena: builtin type constructor arity mismatch row={typeSyntaxNodeIndex} scalar_kind={Int32(builtinHeadKind)} expected_args={builtinArity} actual_args={builtinArgCount}"
                            return false
                        for builtinArgOffset in 0..<builtinArgCount:
                            let builtinArgTypeSyntaxNode =
                                typedExprTypeArenaSyntaxBracketArgTypeNodeAt(
                                    value, typeSyntaxNodeIndex, builtinArgOffset)
                            if builtinArgTypeSyntaxNode < 0 ||
                               typedExprTypeArenaSyntaxChildAt(
                                   value, typeSyntaxNodeIndex,
                                   builtinArgOffset + 1) !=
                                   builtinArgTypeSyntaxNode ||
                               typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, builtinArgTypeSyntaxNode) != children[builtinArgOffset + 1]:
                                err = " typed expr type arena: builtin constructor argument TypeSyntax CSR incomplete"
                                return false
                        var builtinChildren: int32[]
                        setLen(builtinChildren, builtinArgCount + 1)
                        builtinChildren[0] = builtinBaseTypeId
                        for builtinCopyOffset in 0..<builtinArgCount:
                            builtinChildren[builtinCopyOffset + 1] =
                                children[builtinCopyOffset + 1]
                        if !typedExprTypeArenaIntern(
                               state, value, typeSyntaxNodeIndex,
                               TypedExprStructuralTypeApply,
                               TypedExprStructuralScalarInvalid,
                               -1, -1, -1, -1, -1, -1,
                               builtinChildren, childNames, typeId, err):
                            return false
                        genericApplied = true
            if !genericApplied:
                let fixedLength = state.bracketConstLengths[typeSyntaxNodeIndex]
                if children.len != 1 || fixedLength <= 0:
                    err = " typed expr type arena: bracket apply authority incomplete; exact generic SymbolId or bounded const AST required"
                    return false
                if !typedExprTypeArenaIntern(
                       state, value, typeSyntaxNodeIndex,
                       TypedExprStructuralTypeFixedArray,
                       TypedExprStructuralScalarInvalid, -1, -1,
                       fixedLength, -1,
                       -1, -1,
                       children, childNames, typeId, err):
                    return false
        elif kind == parser.ParserTypeSyntaxTuple:
            if children.len <= 0:
                err = " typed expr type arena: empty tuple authority missing"
                return false
            for childOffset in 0..<childCount:
                let childNode = typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, childOffset)
                let tupleChildNameId =
                    typedExprTypeArenaTupleChildNameId(
                        value, tree, childNode, viewTypeSyntaxBase)
                typedExprTypeArenaSyntaxChildNameIdSetAt(
                    value, typeSyntaxNodeIndex, childOffset,
                    tupleChildNameId)
                childNames[childOffset] = tupleChildNameId
            if !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeTuple,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                return false
        elif kind == parser.ParserTypeSyntaxFunction:
            var paramCount: int32
            if !typedExprTypeArenaFunctionParamCount(
                   tree, typeSyntaxNodeIndex, viewTypeSyntaxBase,
                   children, paramCount) ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeFunction,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, paramCount,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: function shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxAlias:
            let symbolId = state.symbolByDeclarationRoot[typeSyntaxNodeIndex]
            if children.len != 1 || symbolId < 0 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeAlias,
                   TypedExprStructuralScalarInvalid, symbolId, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: alias SymbolId authority missing"
                return false
        else:
            err = " typed expr type arena: TypeSyntax authority incomplete"
            return false
        # [forward-typeid] The forward verdict is consumed HERE, after the whole
        # if/elif/else dispatch has closed, so this block splits no arm's
        # indentation body.  r2 put it immediately after the Qualified arm's
        # guard, which TERMINATED that arm's indentation block: the arm's
        # `for childOffset` loop became dead code and every later
        # `elif kind == ...` re-attached to the new `if`, so every kind except
        # the two nominal arms fell through to
        # `TypeSyntax authority incomplete`.  KEEP IT HERE.
        if state.forwardNominalRoot >= 0:
            # [forward-typeid] Defer: no resolution row is recorded for a
            # deferred nominal (that would double-count `resolutionCount` when
            # the replay resolves it), and no TypeId is written.  The row keeps
            # the `-1` `FillTypeSyntax` seeded it with, which is exactly the
            # value the propagation check above reads as "blocked".
            if !typedExprTypeArenaForwardNominalEnqueueInto(
                   forward, typeSyntaxNodeIndex, state.forwardNominalRoot,
                   typedExprTypeArenaSyntaxProducerSourceIndexAt(
                       value, typeSyntaxNodeIndex), err):
                return false
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        # [forward-replay-fixpoint] A skipped row is neither bound nor
        # enqueued: it keeps its flag so a later pass retries it.
        if state.forwardReplaySkipped:
            state.forwardReplaySkipped = false
            state.forwardReplayDeferredCount =
                state.forwardReplayDeferredCount + 1
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        arenamod.ArenaArrayInt32Set(
            value.arena, value.typeSyntaxTypeIds,
            typeSyntaxNodeIndex, typeId)
        if replayForward && forward.blockedFlags.len == state.typeSyntaxCount:
            # [forward-replay-progress] Only a row that was still waiting is
            # progress; every row the replay walks is flagged by construction,
            # so this is the count of deferred rows materialised this pass.
            if forward.blockedFlags[typeSyntaxNodeIndex]:
                state.forwardReplayBoundCount =
                    state.forwardReplayBoundCount + 1
            typedExprTypeArenaForwardNominalClearRow(
                forward, typeSyntaxNodeIndex)
        typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
        continue

@borrows
fn typedExprTypeArenaFillGenericSymbolTypesRec(
        value: var TypedExprTypeArena,
        symbolRow: int32,
        cursor: int32,
        err: var str): bool =
    while true:
        if symbolRow >= value.genericSymbolCount:
            if cursor != value.genericSymbolChildCount:
                err = " typed expr type arena: generic parameter child CSR coverage drift"
                return false
            return true
        let constraintTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.genericSymbolConstraintTypeSyntaxNodeIndexes.offset, value.genericSymbolConstraintTypeSyntaxNodeIndexes.len, symbolRow)
        let defaultTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.genericSymbolDefaultTypeSyntaxNodeIndexes.offset, value.genericSymbolDefaultTypeSyntaxNodeIndexes.len, symbolRow)
        let ownerTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.genericSymbolOwnerTypeSyntaxNodeIndexes.offset, value.genericSymbolOwnerTypeSyntaxNodeIndexes.len, symbolRow)
        let childStart = typedExprTypeArenaInt32At(value, value.genericSymbolChildStarts.offset, value.genericSymbolChildStarts.len, symbolRow)
        let childCount = typedExprTypeArenaInt32At(value, value.genericSymbolChildCounts.offset, value.genericSymbolChildCounts.len, symbolRow)
        if childStart != cursor:
            err = " typed expr type arena: generic parameter child CSR start drift"
            return false
        var constraintTypeId: int32 = -1
        var defaultTypeId: int32 = -1
        if constraintTypeSyntaxNode >= 0:
            constraintTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, constraintTypeSyntaxNode)
            if constraintTypeId < 0 || constraintTypeId >= value.typeCount:
                err = " typed expr type arena: generic constraint canonical TypeId missing"
                return false
        if defaultTypeSyntaxNode >= 0:
            defaultTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, defaultTypeSyntaxNode)
            if defaultTypeId < 0 || defaultTypeId >= value.typeCount:
                err = " typed expr type arena: generic default canonical TypeId missing"
                return false
        if ownerTypeSyntaxNode < 0 ||
           ownerTypeSyntaxNode >= value.typeSyntaxCount:
            err = " typed expr type arena: generic parameter owner TypeSyntax missing"
            return false
        let ownerGenericStart = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolStarts.offset, value.typeSyntaxGenericSymbolStarts.len, ownerTypeSyntaxNode)
        let ownerGenericCount = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolCounts.offset, value.typeSyntaxGenericSymbolCounts.len, ownerTypeSyntaxNode)
        var defaultReferencesGeneric = false
        if defaultTypeId >= 0:
            var dependencyVisiting: bool[]
            var dependencySeen: bool[]
            setLen(dependencyVisiting, value.typeCount)
            setLen(dependencySeen, value.typeCount)
            if !typedExprTypeArenaGenericDependenciesValidateInto(
                   value,
                   defaultTypeId,
                   ownerGenericStart,
                   ownerGenericCount,
                   symbolRow,
                   dependencyVisiting,
                   dependencySeen,
                   defaultReferencesGeneric,
                   err):
                return false
        var constraintReferencesGeneric = false
        if constraintTypeId >= 0:
            var dependencyVisiting: bool[]
            var dependencySeen: bool[]
            setLen(dependencyVisiting, value.typeCount)
            setLen(dependencySeen, value.typeCount)
            if !typedExprTypeArenaGenericDependenciesValidateInto(
                   value,
                   constraintTypeId,
                   ownerGenericStart,
                   ownerGenericCount,
                   ownerGenericStart + ownerGenericCount,
                   dependencyVisiting,
                   dependencySeen,
                   constraintReferencesGeneric,
                   err):
                return false
        if constraintTypeId >= 0 && defaultTypeId >= 0 &&
           !constraintReferencesGeneric &&
           !defaultReferencesGeneric &&
           constraintTypeId != defaultTypeId:
            err = " typed expr type arena: generic default does not satisfy exact constraint TypeId"
            return false
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.genericSymbolConstraintTypeIds,
            symbolRow,
            constraintTypeId)
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.genericSymbolDefaultTypeIds,
            symbolRow,
            defaultTypeId)
        for childOffset in 0..<childCount:
            let childTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.genericSymbolChildTypeSyntaxNodeIndexes.offset, value.genericSymbolChildTypeSyntaxNodeIndexes.len, childStart + childOffset)
            if childTypeSyntaxNode < 0 ||
               childTypeSyntaxNode >= value.typeSyntaxCount:
                err = " typed expr type arena: generic parameter child TypeSyntax invalid"
                return false
            let childTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, childTypeSyntaxNode)
            if childTypeId < 0 || childTypeId >= value.typeCount:
                err = " typed expr type arena: generic parameter child TypeId missing"
                return false
            arenamod.ArenaArrayInt32Set(
                value.arena,
                value.genericSymbolChildTypeIds,
                childStart + childOffset,
                childTypeId)
        symbolRow = symbolRow + 1
        cursor = cursor + childCount
        continue

@borrows
fn typedExprTypeArenaRealizeDeclarationsRec(
        value: var TypedExprTypeArena,
        state: var TypedExprTypeArenaBuildState,
        symbolId: int32,
        err: var str): bool =
    while true:
        if symbolId >= value.symbolCount:
            return true
        let declarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
        # [S1b-1c] Seal-phase read #1 (RealizeDeclarationsRec): the declaration
        # root's parser kind now comes from the arena column the append phase
        # filled at this exact row, not from the released parser tree.
        let declarationKind = typedExprTypeArenaSyntaxKindAt(
            value, declarationRoot)
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.symbolMemberStarts,
            symbolId,
            value.memberCount)
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.symbolMemberCounts,
            symbolId,
            0)
        if declarationKind == parser.ParserTypeSyntaxObject ||
           declarationKind == parser.ParserTypeSyntaxRefObject ||
           declarationKind == parser.ParserTypeSyntaxImplicitObject:
            var objectTypeId: int32
            if !typedExprTypeArenaBuildObjectDeclaration(
                   state,
                   value,
                   declarationRoot,
                   symbolId,
                   objectTypeId,
                   err):
                return false
            arenamod.ArenaArrayInt32Set(
                value.arena,
                value.typeSyntaxTypeIds,
                declarationRoot,
                objectTypeId)
        elif declarationKind == parser.ParserTypeSyntaxEnum:
            if state.fieldCountsByDeclarationRoot[declarationRoot] != 0:
                err = " typed expr type arena: enum declaration owns object fields"
                return false
            var enumTypeId: int32
            if !typedExprTypeArenaBuildEnumDeclaration(
                   state,
                   value,
                   declarationRoot,
                   symbolId,
                   enumTypeId,
                   err):
                return false
            arenamod.ArenaArrayInt32Set(
                value.arena,
                value.typeSyntaxTypeIds,
                declarationRoot,
                enumTypeId)
        elif declarationKind == parser.ParserTypeSyntaxAlias:
            # [phaseB-parser] alias 包裹 tuple 的声明根可拥有具名元素的
            # 字段声明 root；为 alias symbol 构建精确 member 行（同 object
            # 机制），供 compiler csg exact-field 坐标互证消费。普通别名
            # （无字段声明 root）在本臂零成员直通。
            if !typedExprTypeArenaBuildTupleAliasMembers(
                   state,
                   value,
                   declarationRoot,
                   symbolId,
                   err):
                return false
        elif state.fieldCountsByDeclarationRoot[declarationRoot] != 0:
            err = " typed expr type arena: non-object declaration owns fields"
            return false
        symbolId = symbolId + 1
        continue

@borrows
fn typedExprTypeArenaSpecializePendingRec(
        value: var TypedExprTypeArena,
        state: var TypedExprTypeArenaBuildState,
        pending: TypedExprTypeArenaPendingGenericApply,
        pendingRow: int32,
        specializationSourceTypeCount: int32,
        err: var str): bool =
    while true:
        if pendingRow >= pending.typeIds.len:
            return true
        let applyTypeId = pending.typeIds[pendingRow]
        let declarationRoot = pending.declarationRoots[pendingRow]
        let typeSyntaxNodeIndex = pending.typeSyntaxNodeIndexes[pendingRow]
        if applyTypeId < 0 || applyTypeId >= specializationSourceTypeCount ||
           declarationRoot < 0 ||
           declarationRoot >= value.typeSyntaxCount ||
           typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, applyTypeId) !=
               Int32(TypedExprStructuralTypeApply):
            err = " typed expr type arena: pending generic specialization row invalid"
            return false
        # [S1b-1c] Seal-phase read #3 (SpecializePendingRec): the declaration
        # root's generic-symbol CSR window, from the arena columns.
        let genericSymbolStart =
            typedExprTypeArenaSyntaxGenericSymbolStartAt(value, declarationRoot)
        let genericSymbolCount =
            typedExprTypeArenaSyntaxGenericSymbolCountAt(value, declarationRoot)
        let childStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, applyTypeId)
        let childCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, applyTypeId)
        if genericSymbolCount <= 0 ||
           childCount != genericSymbolCount + 1:
            err = " typed expr type arena: pending generic specialization arity drift"
            return false
        var argumentTypeIds: int32[]
        setLen(argumentTypeIds, genericSymbolCount)
        for genericOffset in 0..<genericSymbolCount:
            argumentTypeIds[genericOffset] = typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart + genericOffset + 1)
        var specializationMemo: int32[]
        var specializationVisiting: bool[]
        setLen(specializationMemo, specializationSourceTypeCount)
        setLen(specializationVisiting, specializationSourceTypeCount)
        for sourceTypeId in 0..<specializationSourceTypeCount:
            specializationMemo[sourceTypeId] = -1
        var specializedDeclarationTypeId: int32
        if !typedExprTypeArenaSpecializeTypeInto(
               state,
               value,
               typeSyntaxNodeIndex,
               typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, declarationRoot),
               genericSymbolStart,
               genericSymbolCount,
               argumentTypeIds,
               specializationSourceTypeCount,
               specializationMemo,
               specializationVisiting,
               specializedDeclarationTypeId,
               err):
            return false
        add(pending.specializedDeclarationTypeIds, specializedDeclarationTypeId)
        pendingRow = pendingRow + 1
        continue

@borrows
fn typedExprTypeArenaPatchPendingApplyRec(
        value: var TypedExprTypeArena,
        pending: TypedExprTypeArenaPendingGenericApply,
        pendingRow: int32): bool =
    while true:
        if pendingRow >= pending.typeIds.len:
            return true
        let applyTypeId = pending.typeIds[pendingRow]
        let childStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, applyTypeId)
        let specializedDeclarationTypeId =
            pending.specializedDeclarationTypeIds[pendingRow]
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.childTypeIds,
            childStart,
            specializedDeclarationTypeId)
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.traitPremiseTypeIds,
            typedExprTypeArenaInt32At(value, value.traitPremiseStarts.offset, value.traitPremiseStarts.len, applyTypeId),
            specializedDeclarationTypeId)
        pendingRow = pendingRow + 1
        continue

@borrows
fn typedExprTypeArenaBindFunctionOwnersRec(
        value: var TypedExprTypeArena,
        functionByOwnerToken: var int32[],
        voidTypeId: int32,
        functionRow: int32,
        err: var str): bool =
    while true:
        if functionRow >= value.functionCount:
            return true
        let ownerToken = typedExprTypeArenaInt32At(value, value.functionOwnerTokenIndexes.offset, value.functionOwnerTokenIndexes.len, functionRow)
        if ownerToken < 0 || ownerToken >= functionByOwnerToken.len ||
           functionByOwnerToken[ownerToken] >= 0:
            err = " typed expr type arena: function owner token authority invalid"
            return false
        functionByOwnerToken[ownerToken] = functionRow
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.functionReturnTypeIds,
            functionRow,
            voidTypeId)
        functionRow = functionRow + 1
        continue

@borrows
fn typedExprTypeArenaBindFunctionReturnsRec(
        value: var TypedExprTypeArena,
        functionByOwnerToken: int32[],
        explicitReturnCounts: var int32[],
        typeSyntaxNodeIndex: int32,
        err: var str): bool =
    while true:
        if typeSyntaxNodeIndex >= value.typeSyntaxCount:
            return true
        if typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, typeSyntaxNodeIndex) !=
               Int32(parser.ParserTypeSyntaxRootFunctionReturn):
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        let ownerToken = typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, typeSyntaxNodeIndex)
        let functionRow = ownerToken < 0 ||
            ownerToken >= functionByOwnerToken.len ? -1 :
                functionByOwnerToken[ownerToken]
        let returnTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, typeSyntaxNodeIndex)
        if functionRow < 0 || returnTypeId < 0 ||
           returnTypeId >= value.typeCount ||
           explicitReturnCounts[functionRow] != 0:
            err = " typed expr type arena: function return TypeId authority invalid"
            return false
        explicitReturnCounts[functionRow] = 1
        arenamod.ArenaArrayInt32Set(
            value.arena,
            value.functionReturnTypeIds,
            functionRow,
            returnTypeId)
        typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
        continue

@borrows
fn typedExprTypeArenaApplyTraitFlagsRec(
        value: var TypedExprTypeArena,
        derivedManaged: int32[],
        derivedSend: int32[],
        derivedSync: int32[],
        typeId: int32) =
    while true:
        if typeId >= value.typeCount:
            return
        arenamod.ArenaArrayInt32Set(
            value.arena, value.managedFlags, typeId,
            derivedManaged[typeId])
        arenamod.ArenaArrayInt32Set(
            value.arena, value.sendFlags, typeId,
            derivedSend[typeId])
        arenamod.ArenaArrayInt32Set(
            value.arena, value.syncFlags, typeId,
            derivedSync[typeId])
        typeId = typeId + 1
        continue

# [S1b step-3 (5)] The three lives the materialization pass actually has.
#
# The single whole-forest entry point below used to interleave them: allocation
# that depends only on the sealed declaration index, consumption of a resident
# parser tree, and a seal phase that must run with no tree at all.  Naming them
# is what makes the per-source driver expressible -- Init takes counts, not a
# tree; AppendSource takes exactly one resident tree plus that source's global
# view bases; Seal takes neither.
#
# The whole-forest driver is kept as a thin wrapper that calls the three in
# sequence with every view base 0, so the arena it produces is the one the
# interleaved body produced.  That equivalence is the whole point of this
# split: it is checked by byte-comparing the artifacts of the two drivers, not
# by inspection.

# [S1b arena-pin] One exact reservation for the whole materialization arena.
#
# `TypedExprTypeArenaAllocateFromLimitsInto` appends into three disjoint row
# spaces: the 62 columns `typedExprTypeArenaReserveColumns` names (exact counts
# from the sealed declaration index), the per-TypeId columns
# `typedExprTypeArenaIntern` appends to (row count = `typeCount`), and the
# columns `AppendSource`/`Seal` fill that no `TypedExprTypeArenaLimits` field
# names.  Reserving the buffer source by source let `ArenaAllocBytesAligned`
# (src/core/runtime/arena.cheng:230-242) double it four times while the exact
# column block was laid down, and every one of those four growths is a
# whole-block copy: `cheng_realloc` on an mmap-tier block is
# `cheng_malloc_locked` + `cheng_bytes_copy` + release
# (src/core/runtime/program_support_backend.cheng:6248-6259), copying
# `min(oldSize, newSize)` bytes.  Measured capacity chain for the 234-source
# closure (tokenCount=3,609,612, columnBytes=71,033,660):
#   1,048,576 -> 14,438,448 -> 28,876,896 -> 57,753,792 -> 115,507,584
# i.e. 102,117,712 B of copy; the same-window reading at that exact point is
# `r8s1 633,422,856 -> r8s2 728,089,680` (delta 94,666,824 B, .rebuild/s1b_step3/r8/gate/fix2).
# Reserving the pinned total once turns that into a single 1,048,576 B copy.
#
# The pin is a budget, not a proof of sufficiency: no limit field bounds the
# third group of columns.  Overrunning it is therefore not silent -- every
# append site ends with `typedExprTypeArenaRequirePinnedCapacity`, which panics
# when the arena grew past the pin, so a wrong budget is a named hard failure
# instead of a silent 2x physical blow-up.
const
    TypedExprTypeArenaTypeRowSeedReserve: int32 = 64
    TypedExprTypeArenaPinnedMaxBytes: int64 = 2147483391
    # The capacity `value.arena` is born with.  It is also the floor the
    # pin can never go below: `ArenaReserveCapacity` returns without
    # touching `capacityBytes` when `minCapacity <= capacityBytes`
    # (src/core/runtime/arena.cheng:202-203), so a computed pin smaller
    # than this leaves the arena at exactly this value.
    TypedExprTypeArenaInitialArenaBytes: int32 = 1048576
    # How many TypeId-row columns the per-type block reserves.
    TypedExprTypeArenaTypeOwnedColumnCount: int32 = 19

# Rows reserved for the per-TypeId columns.  Three producers, each bounded:
#   * the fixed semantic scalar seed rows
#     (`typedExprTypeArenaSeedSemanticScalarRows`; the `r8s2_alloc_from_limits`
#     probe reads `type_count=15` immediately after `AllocateFromLimits`),
#   * one row per aggregate declaration Symbol
#     (`typedExprTypeArenaReserveAggregate`, driven by
#     `typedExprTypeArenaRealizeDeclarationsRec`), bounded by
#     `limits.declarationSymbolCount`,
#   * at most one row per TypeSyntax row (`typedExprTypeArenaInternSyntaxRec`
#     advances exactly one row per iteration, and `typedExprTypeArenaIntern`
#     returns the existing TypeId when the structural key repeats,
#     typed_expr_type_arena.cheng:1062-1068), bounded by
#     `limits.typeSyntaxCount`.
# Seal-phase generic specialization (`typedExprTypeArenaSpecializePendingRec`)
# is not bounded by these two limits; it is carried by the residual budget
# below and by the fail-closed pin check.
@borrows
fn TypedExprTypeArenaTypeRowReserve(
        limits: TypedExprTypeArenaLimits): int32 =
    return limits.typeSyntaxCount + limits.declarationSymbolCount +
           TypedExprTypeArenaTypeRowSeedReserve

# Bytes the per-TypeId block reserves: 19 type-owned columns at
# `TypeRowReserve` rows, plus the three payload columns
# (`childTypeIds`/`childNameIds`/`traitPremiseTypeIds`).  Every TypeSyntax-row
# intern contributes `childCount` payload rows, so `typeSyntaxChildCount`
# bounds them; `rows` is added on top for the aggregate and specialization
# interns whose children are not TypeSyntax rows.
@borrows
fn TypedExprTypeArenaTypeSideColumnBytes(
        limits: TypedExprTypeArenaLimits): int64 =
    let rows = Int64(TypedExprTypeArenaTypeRowReserve(limits))
    var words: int64
    words = words + rows * Int64(TypedExprTypeArenaTypeOwnedColumnCount)
    words = words + Int64(limits.typeSyntaxChildCount) * Int64(3)
    words = words + rows * Int64(3)
    return words * Int64(4)

# Budget for the columns no `TypedExprTypeArenaLimits` field names
# (member*/resolution*/genericResolution*/nominalDependency*/symbolDependency*/
# scc* rows, the two TypeSyntax-row ownership columns, and the seal-phase
# generic-specialization Apply rows).  This is the one number in the pin that
# is a budget rather than an exact count; the pin check below makes an overrun
# a hard failure, and the first verification run reads the real total from
# `ArenaUsed` at seal so the budget can be replaced by a measurement.
# [seal-pin] The seal phase appends two families of columns that the limits do
# not name row-for-row, and the r87 seal probe measured both of them growing the
# arena past a pin the merge had filled to 99.1%:
#   RealizeDeclarationsRec -> +1,834,784 B   (member rows, 7 columns each)
#   BuildDependencyProof   -> +261,760 B     (4 columns per resolution row)
# 1,243,372 B past the pin is enough for the arena to double, which costs 95 MB
# of RSS to hold 1.2 MB, so both are budgeted here with PROVABLE bounds:
#   * member rows: a member row is a TypeSyntax row of the declaring object,
#     enum or tuple alias (all three builders append exactly seven columns per
#     iteration), so `typeSyntaxCount` bounds the rows at 7 words each;
#   * dependency rows: one resolution row is written per resolved TypeSyntax
#     row, so resolutions and dependency edges are bounded by
#     `typeSyntaxCount` at 4 + 2 words, and the symbol starts/counts columns are
#     exactly `declarationSymbolCount` at 2 words.
# Over-approximating a budget is sound; estimating an unknown is not, and the
# fail-closed pin check below is unchanged.
@borrows
fn TypedExprTypeArenaSealColumnBytes(
        limits: TypedExprTypeArenaLimits): int64 =
    var words: int64
    words = words + Int64(limits.typeSyntaxCount) * Int64(13)
    words = words + Int64(limits.declarationSymbolCount) * Int64(2)
    return words * Int64(4)

# Budget for the columns no `TypedExprTypeArenaLimits` field names
# (member*/resolution*/genericResolution*/nominalDependency*/symbolDependency*/
# scc* rows, the two TypeSyntax-row ownership columns, and the seal-phase
# generic-specialization Apply rows).  This is the one number in the pin that
# is a budget rather than an exact count; the pin check below makes an overrun
# a hard failure, and the first verification run reads the real total from
# `ArenaUsed` at seal so the budget can be replaced by a measurement.
@borrows
fn TypedExprTypeArenaResidualColumnBytes(
        limits: TypedExprTypeArenaLimits): int64 =
    var words: int64
    words = words + Int64(limits.typeSyntaxCount) * Int64(12)
    words = words + Int64(limits.typeSyntaxChildCount) * Int64(4)
    words = words + Int64(limits.declarationSymbolCount) * Int64(24)
    # [c2-replay-cols] The three replay fact columns: two at one word per
    # TypeSyntax row, one at one word per TypeSyntax child.  PROVABLE bounds,
    # same rule as the [seal-pin] families above.
    words = words + Int64(limits.typeSyntaxCount) * Int64(2)
    words = words + Int64(limits.typeSyntaxChildCount) * Int64(1)
    words = words + TypedExprTypeArenaSealColumnBytes(limits) / Int64(4)
    return words * Int64(4)

@borrows
fn TypedExprTypeArenaPinnedArenaBytes(
        limits: TypedExprTypeArenaLimits,
        err: var str): int32 =
    var total: int64
    total = total + TypedExprTypeArenaLimitsColumnBytes(limits)
    total = total + TypedExprTypeArenaTypeSideColumnBytes(limits)
    total = total + TypedExprTypeArenaResidualColumnBytes(limits)
    if total <= 0 || total > TypedExprTypeArenaPinnedMaxBytes:
        err = " typed expr type arena: pinned arena bytes out of range"
        return 0
    return Int32(total)

# The pin the arena is actually held to: the computed budget, but never
# below the capacity the arena is born with.  Sources small enough that the
# budget is under `TypedExprTypeArenaInitialArenaBytes` (the four user-path
# fixtures compute 6,020 / 6,432 / 7,096 B) keep the birth capacity, and that
# is not a defect: the 1 MiB is already committed by `ArenaInitDefault`
# regardless of the pin, so holding such an arena to a lower number is
# impossible and checking for one is checking for a state that cannot exist.
@borrows
fn TypedExprTypeArenaPinnedCapacity(
        limits: TypedExprTypeArenaLimits,
        err: var str): int32 =
    let budgeted = TypedExprTypeArenaPinnedArenaBytes(limits, err)
    if err != "":
        return 0
    if budgeted < TypedExprTypeArenaInitialArenaBytes:
        return TypedExprTypeArenaInitialArenaBytes
    return budgeted

# [X1-dedup] Reserve the dedup hash table in the pinned arena, once, at the
# same `TypeRowReserve` bound the per-TypeId columns use: one chain slot per
# possible type row, and a bucket array at load factor 0.5.  Both are filled
# through `ArenaArrayInt32AddReserved`, which panics on exhaustion, so a bound
# that is wrong is a hard failure rather than a silent shortfall.
@borrows
fn typedExprTypeArenaBuildStateReserveDedupInto(
        value: var TypedExprTypeArena,
        state: var TypedExprTypeArenaBuildState,
        limits: TypedExprTypeArenaLimits,
        err: var str): bool =
    let rows = TypedExprTypeArenaTypeRowReserve(limits)
    if rows <= 0:
        err = " typed expr type arena: dedup row bound invalid"
        return false
    var bucketCount: int32 = 8
    while bucketCount < rows * 2:
        if bucketCount > 1073741823:
            err = " typed expr type arena: intern bucket overflow"
            return false
        bucketCount = bucketCount * 2
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           value.arena, state.bucketHeads, bucketCount):
        err = " typed expr type arena: dedup bucket reserve failed"
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           value.arena, state.bucketNext, rows + 1):
        err = " typed expr type arena: dedup chain reserve failed"
        return false
    var fillIndex: int32
    while fillIndex < bucketCount:
        arenamod.ArenaArrayInt32AddReserved(
            value.arena, state.bucketHeads, -1)
        fillIndex = fillIndex + 1
    if arenamod.ArenaArrayInt32Len(value.arena, state.bucketHeads) !=
           bucketCount:
        err = " typed expr type arena: dedup bucket fill incomplete"
        return false
    return true

# The per-TypeId block, reserved at its exact bound before the first append.
# `typedExprTypeArenaReserveColumn` fails hard on a short reserve, so a reserve
# that cannot cover the bound is a defect, never a silent shortfall.
@borrows
fn typedExprTypeArenaReserveTypeSideColumns(
        value: var TypedExprTypeArena,
        limits: TypedExprTypeArenaLimits) =
    let rows = TypedExprTypeArenaTypeRowReserve(limits)
    let payloadRows = limits.typeSyntaxChildCount + rows
    value.typeKinds = typedExprTypeArenaReserveColumn(
        value.arena, rows, "typeKinds")
    value.scalarKinds = typedExprTypeArenaReserveColumn(
        value.arena, rows, "scalarKinds")
    value.symbolIds = typedExprTypeArenaReserveColumn(
        value.arena, rows, "symbolIds")
    value.genericSymbolIds = typedExprTypeArenaReserveColumn(
        value.arena, rows, "genericSymbolIds")
    value.fixedLengths = typedExprTypeArenaReserveColumn(
        value.arena, rows, "fixedLengths")
    value.functionParamCounts = typedExprTypeArenaReserveColumn(
        value.arena, rows, "functionParamCounts")
    value.baseTypeSyntaxNodeIndexes = typedExprTypeArenaReserveColumn(
        value.arena, rows, "baseTypeSyntaxNodeIndexes")
    value.baseTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, rows, "baseTypeIds")
    value.childStarts = typedExprTypeArenaReserveColumn(
        value.arena, rows, "childStarts")
    value.childCounts = typedExprTypeArenaReserveColumn(
        value.arena, rows, "childCounts")
    value.traitRuleKinds = typedExprTypeArenaReserveColumn(
        value.arena, rows, "traitRuleKinds")
    value.traitPremiseStarts = typedExprTypeArenaReserveColumn(
        value.arena, rows, "traitPremiseStarts")
    value.traitPremiseCounts = typedExprTypeArenaReserveColumn(
        value.arena, rows, "traitPremiseCounts")
    value.managedFlags = typedExprTypeArenaReserveColumn(
        value.arena, rows, "managedFlags")
    value.sendFlags = typedExprTypeArenaReserveColumn(
        value.arena, rows, "sendFlags")
    value.syncFlags = typedExprTypeArenaReserveColumn(
        value.arena, rows, "syncFlags")
    value.typeOriginKinds = typedExprTypeArenaReserveColumn(
        value.arena, rows, "typeOriginKinds")
    value.originTypeSyntaxNodeIndexes = typedExprTypeArenaReserveColumn(
        value.arena, rows, "originTypeSyntaxNodeIndexes")
    value.originProducerSourceIndexes = typedExprTypeArenaReserveColumn(
        value.arena, rows, "originProducerSourceIndexes")
    value.childTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, payloadRows, "childTypeIds")
    value.childNameIds = typedExprTypeArenaReserveColumn(
        value.arena, payloadRows, "childNameIds")
    value.traitPremiseTypeIds = typedExprTypeArenaReserveColumn(
        value.arena, payloadRows, "traitPremiseTypeIds")

# Fail-closed pin check.  `ArenaArrayInt32Add` grows a column by doubling at
# the arena bump top and `ArenaAllocBytesAligned` answers with
# `growCap = max(capacityBytes * 2, nextUsed)` (src/core/runtime/arena.cheng:230-242),
# so any column that overruns its reserve makes the arena capacity jump to at
# least twice the pin.  Without this check that overrun is silent: the arena
# simply grows and the compile gets slower and hungrier, with no verdict
# naming the column.  Both append entry points end here.
#
# The predicate is a strict growth test, not an equality test.
# `capacityBytes` only ever moves through `ArenaReserveCapacity` (up to the
# pinned value) and `ArenaAllocBytesAligned` (up to
# `max(2*capacityBytes, nextUsed)`), so on every reachable state
# `capacity >= pinned` holds and `capacity > pinned` is exactly "the arena
# grew".  Equality would additionally reject the legitimate state
# `capacity == TypedExprTypeArenaInitialArenaBytes` that every source whose
# budget is below the birth capacity always has -- that is the kd_r9i false
# positive (`capacity=1048576 pinned=6020`), not an overrun.
@borrows
fn typedExprTypeArenaRequirePinnedCapacity(
        value: TypedExprTypeArena,
        state: TypedExprTypeArenaBuildState,
        phase: str) =
    if state.pinnedArenaBytes <= 0:
        panic(Fmt"typed expr type arena: pinned capacity missing phase={phase}")
    let capacity = arenamod.ArenaCapacity(value.arena)
    if capacity > state.pinnedArenaBytes:
        panic(Fmt"typed expr type arena: pinned capacity overrun phase={phase} capacity={capacity} pinned={state.pinnedArenaBytes}")

@borrows
fn TypedExprTypeArenaAllocateFromLimitsInto(
        limits: TypedExprTypeArenaLimits,
        authority: TypedExprTypeResolutionAuthority,
        declarationSymbolGlobalRoots: int32[],
        declarationGenericSymbolStarts: int32[],
        declarationGenericSymbolCounts: int32[],
        out: var TypedExprTypeArena,
        state: var TypedExprTypeArenaBuildState,
        err: var str): bool =
    if out != nil || state != nil:
        err = " typed expr type arena: initialization destination is not empty"
        return false
    var value: TypedExprTypeArena = new(TypedExprTypeArena)
    value.arena = arenamod.ArenaInitDefault(
        TypedExprTypeArenaInitialArenaBytes)
    value.internPool = langintern.InternPoolNew()
    value.producerSourceCount = limits.producerSourceCount
    value.tokenCount = limits.tokenCount
    value.typeSyntaxCount = limits.typeSyntaxCount
    value.functionCount = limits.functionCount
    value.genericSymbolCount = limits.genericSymbolCount
    value.genericSymbolChildCount = limits.genericSymbolChildCount
    value.bracketArgCount = limits.bracketArgCount
    # [S1b arena-pin] Reserve the whole materialization arena once, before the
    # first column is laid down.  See the block above
    # `TypedExprTypeArenaTypeRowReserve` for the measured copy chain this
    # removes.
    var pinnedErr: str
    let pinnedArenaBytes = TypedExprTypeArenaPinnedCapacity(
        limits, pinnedErr)
    if pinnedErr != "":
        TypedExprTypeArenaRelease(value)
        err = pinnedErr
        return false
    arenamod.ArenaReserveCapacity(value.arena, pinnedArenaBytes)
    # [S1b arena-pin] Installation check, at the one place the pin is
    # applied rather than inferred from a later reading: the two entry
    # points below only assert that the arena never grows past the pin, so
    # a pin that never took effect would make them vacuous.  It holds by
    # construction -- `pinnedArenaBytes >= TypedExprTypeArenaInitialArenaBytes`,
    # so `ArenaReserveCapacity` either reallocs to exactly that value or
    # early-returns with `capacityBytes` already equal to it.
    let installedCapacity = arenamod.ArenaCapacity(value.arena)
    if installedCapacity != pinnedArenaBytes:
        panic(Fmt"typed expr type arena: pinned capacity not installed capacity={installedCapacity} pinned={pinnedArenaBytes}")
    # [S1b step-3 (2)] Reserve the appended columns at their exact final
    # length before the first Add, so no Fill* column ever takes the doubling
    # grow branch.  Everything below fills the same values into the same rows.
    typedExprTypeArenaReserveColumns(value, limits)
    # [S1b arena-pin] Same rule for the per-TypeId columns: their row count is
    # `typeCount`, which is not a limit, so they are reserved at the bound
    # `TypedExprTypeArenaTypeRowReserve` derives from the limits.
    typedExprTypeArenaReserveTypeSideColumns(value, limits)
    var built: TypedExprTypeArenaBuildState
    if !typedExprTypeArenaBuildStateInitInto(
           authority, declarationSymbolGlobalRoots,
           declarationGenericSymbolStarts,
           declarationGenericSymbolCounts,
           limits.typeSyntaxCount,
           limits.producerSourceCount, built, err):
        TypedExprTypeArenaRelease(value)
        return false
    built.pinnedArenaBytes = pinnedArenaBytes
    # [forward-typeid] The queue's row space is exactly the TypeSyntax row space
    # the state is sized for, so it is created here and nowhere else -- no
    # caller of `AllocateFromLimitsInto` has to name it, and the whole-forest
    # driver gets one too (it stays empty there, because every aggregate is
    # reserved before anything is interned).
    built.forwardNominal =
        TypedExprTypeArenaPendingForwardNominalNew(limits.typeSyntaxCount)
    built.forwardNominalRoot = -1
    if !typedExprTypeArenaBuildStateReserveDedupInto(
           value, built, limits, err):
        TypedExprTypeArenaRelease(value)
        return false
    # Scalar TypeIds are a fixed semantic prefix, independent of which source
    # happens to mention a scalar first. Parser TypeSyntax rows structurally
    # deduplicate against this reserved prefix.  Every seed row has an absent
    # origin (`-1`), so this runs before any tree is resident.
    if !typedExprTypeArenaSeedSemanticScalarRows(built, value, err):
        TypedExprTypeArenaRelease(value)
        return false
    out = value
    state = built
    err = ""
    return true

# [S1b step-3 (5)] One resident source tree, appended into the destination's
# global row space.  Every `view*Base` is the global row of this tree's first
# row in the destination column, and every one of them is 0 for the
# whole-forest driver (where the tree already carries global coordinates).
@borrows
fn TypedExprTypeArenaAppendSourceFromTreeInto(
        value: var TypedExprTypeArena,
        tree: parser.ParserValueExprTree,
        authority: TypedExprTypeResolutionAuthority,
        state: var TypedExprTypeArenaBuildState,
        producerSourceIndex: int32,
        producerSourceBase: int32,
        tokenRowBase: int32,
        bracketArgBase: int32,
        genericSymbolBase: int32,
        genericSymbolChildBase: int32,
        functionBase: int32,
        groupBase: int32,
        groupCount: int32,
        typeSyntaxBase: int32,
        pending: TypedExprTypeArenaPendingGenericApply,
        err: var str): bool =
    if value == nil || state == nil || tree == nil || pending == nil:
        err = " typed expr type arena: append source input invalid"
        return false
    # [S1b step-3 (6)] The streaming driver appends this source's authority
    # rows *before* calling here, so the build state must see the cumulative
    # authority and the two used-flag arrays must cover its rows.  The arrays
    # are copied element by element because array assignment aliases.  The
    # whole-forest driver hands the finished authority to Init, so both the
    # rebind and both growth branches are unreachable there.
    state.authority = share(authority)
    if state.authorityUsed.len < authority.typeSyntaxNodeIndexes.len:
        var grownAuthorityUsed: bool[]
        setLen(grownAuthorityUsed, authority.typeSyntaxNodeIndexes.len)
        for row in 0..<state.authorityUsed.len:
            grownAuthorityUsed[row] = state.authorityUsed[row]
        state.authorityUsed = grownAuthorityUsed
    if state.genericAuthorityUsed.len <
           authority.genericTypeSyntaxNodeIndexes.len:
        var grownGenericAuthorityUsed: bool[]
        setLen(grownGenericAuthorityUsed,
               authority.genericTypeSyntaxNodeIndexes.len)
        for row in 0..<state.genericAuthorityUsed.len:
            grownGenericAuthorityUsed[row] = state.genericAuthorityUsed[row]
        state.genericAuthorityUsed = grownGenericAuthorityUsed
    parser.ParserDebugStage("ta_append_entry")
    typedExprTypeArenaFillTokens(value, tree, producerSourceBase)
    if !typedExprTypeArenaFillTypeSyntax(
           value, tree, producerSourceIndex, producerSourceBase,
           tokenRowBase, bracketArgBase, genericSymbolBase, err):
        return false
    if !typedExprTypeArenaFillFunctions(
           value, tree, functionBase, groupBase, groupCount,
           tokenRowBase, err):
        return false
    typedExprTypeArenaFillBracketArgs(value, tree, typeSyntaxBase)
    typedExprTypeArenaFillGenericSymbols(
        value, tree, producerSourceBase, tokenRowBase, typeSyntaxBase,
        genericSymbolChildBase)
    typedExprTypeArenaFillGenericSymbolChildren(value, tree, typeSyntaxBase)
    state.tree = share(tree)
    parser.ParserDebugStage("ta_after_fill")
    if !typedExprTypeArenaIndexFieldsSourceInto(
           state, tree, typeSyntaxBase, err):
        return false
    # This source's symbols start here; source k's symbols all own declaration
    # roots with global rows greater than source k-1's, so the aggregate
    # reservation walks the merged order.
    let symbolBase = value.symbolCount
    if !typedExprTypeArenaFillDeclarationSymbols(
           value, tree, state, typeSyntaxBase, producerSourceBase,
           tokenRowBase, err):
        return false
    parser.ParserDebugStage("ta_after_decl_symbols")
    if !typedExprTypeArenaBuildSyntaxOwnership(
           state, value, typeSyntaxBase, err):
        return false
    parser.ParserDebugStage("ta_after_ownership")
    if !typedExprTypeArenaReserveAggregatesRec(
           value, state, symbolBase, err):
        return false
    if !typedExprTypeArenaMaterializeBracketConstLengths(
           tree, state, typeSyntaxBase, err):
        return false
    if !typedExprTypeArenaMaterializeBuiltinConstructorArities(
           tree, state, typeSyntaxBase, err):
        return false
    parser.ParserDebugStage("ta_after_materialize")
    if !typedExprTypeArenaPreflightBracketAuthority(
           state, value, typeSyntaxBase, tree.typeSyntaxCount, err):
        return false
    if !typedExprTypeArenaInternSyntaxRec(
           value, tree, authority, state, pending, false, typeSyntaxBase,
           typeSyntaxBase, tokenRowBase, err):
        return false
    parser.ParserDebugStage("ta_after_intern")
    typedExprTypeArenaRequirePinnedCapacity(value, state, "append_source")
    err = ""
    return true

# [forward-typeid] The replay pass.  One resident source tree, re-parsed by the
# driver, walked with the row filter inverted: only rows deferred by the append
# pass are interned, and every one of them is interned here with its children's
# REAL TypeIds.  `Seal` consumes the result, so this runs after the source loop
# and before `TypedExprTypeArenaSealInto`.
#
# Why re-parse instead of reading arena columns: the deferred rows still need
# parser facts that have no arena column -- `typedExprTypeArenaFunctionParamCount`
# scans the whole token array and `typedExprTypeArenaTupleChildNameId` reads
# token text, and there is no per-token text column.  Re-parsing one source at a
# time keeps the RSS peak where the append pass already had it (the driver still
# passes the per-source arena reserve) and costs only the parse of sources that
# actually have a forward edge.
@borrows
fn TypedExprTypeArenaReplayForwardRowsInto(
        value: var TypedExprTypeArena,
        tree: parser.ParserValueExprTree,
        authority: TypedExprTypeResolutionAuthority,
        state: var TypedExprTypeArenaBuildState,
        pending: TypedExprTypeArenaPendingGenericApply,
        producerSourceIndex: int32,
        tokenRowBase: int32,
        typeSyntaxBase: int32,
        err: var str): bool =
    if value == nil || state == nil || tree == nil || pending == nil ||
       state.forwardNominal == nil:
        err = " typed expr type arena: forward replay input invalid"
        return false
    if tree.producerSourceCount != 1 || producerSourceIndex < 0 ||
       tokenRowBase < 0 || typeSyntaxBase < 0 ||
       state.forwardNominal.blockedFlags.len != state.typeSyntaxCount ||
       typeSyntaxBase + tree.typeSyntaxCount > value.typeSyntaxCount:
        err = Fmt" typed expr type arena: forward replay view invalid source_index={producerSourceIndex} base={typeSyntaxBase} rows={tree.typeSyntaxCount} total={value.typeSyntaxCount} flags={state.forwardNominal.blockedFlags.len}"
        return false
    # The replay runs after every source was appended, so the state must be
    # re-pointed at the re-parsed tree: `ResolveNominal` still reads the nominal
    # name token from `state.tree`, and the row walk is bounded by it.
    state.authority = share(authority)
    state.tree = share(tree)
    # [forward-replay-fixpoint] Per-source readback: how many rows of this
    # source are still flagged before and after its replay.  A replay that
    # leaves the count unchanged means the walk never bound them.
    var replayFlaggedBefore: int32
    var replayFlagScan: int32
    while replayFlagScan < tree.typeSyntaxCount:
        if state.forwardNominal.blockedFlags[typeSyntaxBase + replayFlagScan]:
            replayFlaggedBefore = replayFlaggedBefore + 1
        replayFlagScan = replayFlagScan + 1
    if !typedExprTypeArenaInternSyntaxRec(
           value, tree, authority, state, pending, true,
           typeSyntaxBase, typeSyntaxBase, tokenRowBase, err):
        return false
    var replayFlaggedAfter: int32
    replayFlagScan = 0
    while replayFlagScan < tree.typeSyntaxCount:
        if state.forwardNominal.blockedFlags[typeSyntaxBase + replayFlagScan]:
            replayFlaggedAfter = replayFlaggedAfter + 1
        replayFlagScan = replayFlagScan + 1
    if replayFlaggedBefore > 0:
        parser.ParserDebugStage(
            Fmt"replay_src src={producerSourceIndex} before={replayFlaggedBefore} after={replayFlaggedAfter}")
    # No new arena column and no new reservation: the replay only writes rows
    # that already exist, so the pin must still hold exactly.
    typedExprTypeArenaRequirePinnedCapacity(value, state, "forward_replay")
    err = ""
    return true

# [c2-replay-cols] The column-reading twin of the row walk inside
# `typedExprTypeArenaInternSyntaxRec`, written out row for row: the two walks
# must stay textually comparable because the hard switch is gated on a
# row-for-row equality round between them (ReplayForwardRowsDiagnoseInto).
# The complete list of differences:
#   * no tree parameter: every parser fact comes from the columns the append
#     pass materialised (FillTypeSyntax + the two tuple-intern sites), so the
#     driver never re-parses a source;
#   * no `!replayForward` blocked-child propagation and no deferred-tuple
#     intern block: this walk IS the replay, and the append pass already
#     interned every tuple child name in pool order;
#   * `ResolveNominal` runs with readColumns=true: the name token text comes
#     from `typeSyntaxNameTokenTexts` and the generic arm fails closed (a
#     generic-parameter row is never enqueued, so the replay cannot reach it);
#   * the row filter is the replay filter: rows that are not flagged are
#     skipped, and the row bound is this source's row count instead of a
#     tree's `typeSyntaxCount`.
# A `nil` cannot be passed through the tree twin's @borrows formal
# (FunctionContractAdmission rejects a sentinel for a managed formal), which
# is exactly why this twin exists instead of a flag on the shared walk.
@borrows
fn typedExprTypeArenaInternSyntaxRowsFromState(
        value: var TypedExprTypeArena,
        authority: TypedExprTypeResolutionAuthority,
        state: var TypedExprTypeArenaBuildState,
        pending: TypedExprTypeArenaPendingGenericApply,
        typeSyntaxNodeIndex: int32,
        viewTypeSyntaxBase: int32,
        viewTokenRowBase: int32,
        sourceTypeSyntaxRowCount: int32,
        err: var str): bool =
    let forward = state.forwardNominal
    if forward == nil:
        err = " typed expr type arena: forward nominal queue missing"
        return false
    while true:
        if typeSyntaxNodeIndex >=
               viewTypeSyntaxBase + sourceTypeSyntaxRowCount:
            return true
        # [forward-typeid] Row filter: this walk processes exactly the flagged
        # rows, like the replay pass of the tree twin.
        if forward.blockedFlags.len == state.typeSyntaxCount:
            if !forward.blockedFlags[typeSyntaxNodeIndex]:
                typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
                continue
        let kind = typedExprTypeArenaSyntaxKindAt(value, typeSyntaxNodeIndex)
        if kind == parser.ParserTypeSyntaxObject ||
           kind == parser.ParserTypeSyntaxRefObject ||
           kind == parser.ParserTypeSyntaxImplicitObject ||
           kind == parser.ParserTypeSyntaxEnum:
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        let parentTypeSyntaxNodeIndex =
            state.typeSyntaxParentNodeIndexes[typeSyntaxNodeIndex]
        let qualifiedSegment =
            kind == parser.ParserTypeSyntaxNominal &&
            parentTypeSyntaxNodeIndex >= 0 &&
            typedExprTypeArenaSyntaxKindAt(
                value, parentTypeSyntaxNodeIndex) ==
                parser.ParserTypeSyntaxQualified
        if qualifiedSegment:
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        var children: int32[]
        var childNames: int32[]
        let childCount = typedExprTypeArenaSyntaxChildCountAt(
            value, typeSyntaxNodeIndex)
        if kind != parser.ParserTypeSyntaxQualified:
            setLen(children, childCount)
            setLen(childNames, childCount)
            for childOffset in 0..<childCount:
                let childNode = typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, childOffset)
                if childNode < 0 || childNode >= typeSyntaxNodeIndex:
                    err = " typed expr type arena: TypeSyntax is not postorder"
                    return false
                let childTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, childNode)
                if childTypeId < 0 || childTypeId >= value.typeCount:
                    err = " typed expr type arena: child TypeId unavailable"
                    return false
                children[childOffset] = childTypeId
                childNames[childOffset] = -1
        var typeId: int32 = -1
        # [forward-typeid] Reset immediately before the dispatch, exactly like
        # the tree twin does.
        state.forwardNominalRoot = -1
        if kind == parser.ParserTypeSyntaxNominal:
            if !typedExprTypeArenaResolveNominal(
                   state, value, typeSyntaxNodeIndex, viewTypeSyntaxBase,
                   viewTokenRowBase, true, true, typeId, err):
                return false
        elif kind == parser.ParserTypeSyntaxQualified:
            if childCount < 2 ||
               !typedExprTypeArenaResolveNominal(
                   state, value, typeSyntaxNodeIndex, viewTypeSyntaxBase,
                   viewTokenRowBase, true, true, typeId, err):
                if err == "":
                    err = " typed expr type arena: qualified nominal path incomplete"
                return false
            for childOffset in 0..<childCount:
                let childNode = typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, childOffset)
                if childNode < 0 || childNode >= typeSyntaxNodeIndex ||
                   state.typeSyntaxParentNodeIndexes[childNode] !=
                       typeSyntaxNodeIndex ||
                   typedExprTypeArenaSyntaxKindAt(value, childNode) !=
                       parser.ParserTypeSyntaxNominal:
                    err = " typed expr type arena: qualified nominal segment invalid"
                    return false
                arenamod.ArenaArrayInt32Set(
                    value.arena,
                    value.typeSyntaxTypeIds,
                    childNode,
                    typeId)
        elif kind == parser.ParserTypeSyntaxVarBorrow:
            if children.len != 1 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeBorrow,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: borrow shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxSeq:
            if children.len != 1 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeSequence,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: sequence shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxGrouped:
            if children.len != 1:
                err = " typed expr type arena: grouped type shape invalid"
                return false
            typeId = children[0]
        elif kind == parser.ParserTypeSyntaxOptional:
            if children.len != 1 ||
               typedExprTypeArenaSyntaxQuestionTokenAt(
                   value, typeSyntaxNodeIndex) < 0 ||
               !typedExprTypeArenaIntern(
                   state,
                   value,
                   typeSyntaxNodeIndex,
                   TypedExprStructuralTypeOptional,
                   TypedExprStructuralScalarInvalid,
                   -1,
                   -1,
                   -1,
                   -1,
                   -1,
                   -1,
                   children,
                   childNames,
                   typeId,
                   err):
                if err == "":
                    err = " typed expr type arena: optional shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxFixedArray:
            let fixedLength = typedExprTypeArenaSyntaxFixedLengthRowAt(
                value, typeSyntaxNodeIndex)
            if children.len != 1 || fixedLength <= 0 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeFixedArray,
                   TypedExprStructuralScalarInvalid, -1, -1,
                   fixedLength, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: literal fixed-array proof invalid"
                return false
        elif kind == parser.ParserTypeSyntaxBracketApply:
            if childCount <= 0:
                err = " typed expr type arena: bracket base TypeSyntax missing"
                return false
            let baseTypeSyntaxNode =
                typedExprTypeArenaSyntaxChildAt(
                    value, typeSyntaxNodeIndex, 0)
            let authorityRow = typedExprTypeArenaAuthorityRow(
                state, baseTypeSyntaxNode)
            var genericApplied = false
            if authorityRow >= 0:
                let declarationRoot =
                    authority.declarationRootTypeSyntaxNodeIndexes[
                        authorityRow]
                var genericCount: int32
                var declarationGenericStart: int32 = -1
                if !typedExprTypeArenaDeclarationGenericWindowAt(
                       state, declarationRoot, declarationGenericStart,
                       genericCount, err):
                    err = Fmt" typed expr type arena: generic apply declaration window failed bracket_row={typeSyntaxNodeIndex} base_row={baseTypeSyntaxNode} authority_row={authorityRow}: {err}"
                    return false
                if genericCount > 0:
                    let argCount =
                        typedExprTypeArenaSyntaxBracketArgCountAt(
                            value, typeSyntaxNodeIndex)
                    let symbolId =
                        state.symbolByDeclarationRoot[declarationRoot]
                    if declarationGenericStart < 0 || argCount <= 0 ||
                       argCount > genericCount ||
                       children.len != argCount + 1 || symbolId < 0:
                        err = " typed expr type arena: generic application arity authority mismatch"
                        return false
                    for argOffset in 0..<argCount:
                        let argTypeSyntaxNode =
                            typedExprTypeArenaSyntaxBracketArgTypeNodeAt(
                                value, typeSyntaxNodeIndex, argOffset)
                        if argTypeSyntaxNode < 0 ||
                           typedExprTypeArenaSyntaxChildAt(
                               value, typeSyntaxNodeIndex, argOffset + 1) !=
                               argTypeSyntaxNode ||
                           typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, argTypeSyntaxNode) != children[argOffset + 1]:
                            err = " typed expr type arena: generic argument TypeSyntax CSR incomplete"
                            return false
                    var completeArgumentTypeIds: int32[]
                    if !typedExprTypeArenaCompleteGenericArgumentsInto(
                           state,
                           value,
                           typeSyntaxNodeIndex,
                           declarationRoot,
                           children,
                           completeArgumentTypeIds,
                           err):
                        return false
                    var completeChildren: int32[]
                    var completeChildNames: int32[]
                    setLen(completeChildren, completeArgumentTypeIds.len + 1)
                    setLen(completeChildNames, completeArgumentTypeIds.len + 1)
                    completeChildren[0] = children[0]
                    completeChildNames[0] = -1
                    for genericOffset in 0..<completeArgumentTypeIds.len:
                        completeChildren[genericOffset + 1] =
                            completeArgumentTypeIds[genericOffset]
                        completeChildNames[genericOffset + 1] = -1
                    if !typedExprTypeArenaIntern(
                           state,
                           value,
                           typeSyntaxNodeIndex,
                           TypedExprStructuralTypeApply,
                           TypedExprStructuralScalarInvalid,
                           symbolId,
                           -1,
                           -1,
                           -1,
                           -1,
                           -1,
                           completeChildren,
                           completeChildNames,
                           typeId,
                           err):
                        return false
                    add(pending.typeIds, typeId)
                    add(pending.declarationRoots, declarationRoot)
                    add(pending.typeSyntaxNodeIndexes, typeSyntaxNodeIndex)
                    genericApplied = true
            if !genericApplied && authorityRow < 0:
                # [builtin-ctor] A bracket application whose base is a
                # built-in type constructor has no declaration authority.
                # The head is the base row's OWN scalar identity and the
                # arity comes from the closed constructor table -- never
                # from the syntax.  The resulting row is a TypeApply with
                # symbolId = -1 and children[0] = the builtin head, which is
                # exactly the cold chain's APPLY shape.  Layout and coreir
                # tag need no separate ruling: both already forward to
                # children[0] (compiler_csg.cheng:12637-12659,
                # canonical_type_chain.cheng:55-67).
                let builtinBaseTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, baseTypeSyntaxNode)
                if builtinBaseTypeId >= 0 && builtinBaseTypeId < value.typeCount &&
                   typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, builtinBaseTypeId) ==
                       Int32(TypedExprStructuralTypeScalar):
                    let builtinHeadKind = TypedExprStructuralScalarKind(
                        typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, builtinBaseTypeId))
                    let builtinArity =
                        typedExprTypeArenaBuiltinConstructorArity(builtinHeadKind)
                    if builtinArity > 0:
                        let builtinArgCount =
                            typedExprTypeArenaSyntaxBracketArgCountAt(
                                value, typeSyntaxNodeIndex)
                        if builtinArgCount != builtinArity ||
                           children.len != builtinArgCount + 1:
                            err = Fmt" typed expr type arena: builtin type constructor arity mismatch row={typeSyntaxNodeIndex} scalar_kind={Int32(builtinHeadKind)} expected_args={builtinArity} actual_args={builtinArgCount}"
                            return false
                        for builtinArgOffset in 0..<builtinArgCount:
                            let builtinArgTypeSyntaxNode =
                                typedExprTypeArenaSyntaxBracketArgTypeNodeAt(
                                    value, typeSyntaxNodeIndex, builtinArgOffset)
                            if builtinArgTypeSyntaxNode < 0 ||
                               typedExprTypeArenaSyntaxChildAt(
                                   value, typeSyntaxNodeIndex,
                                   builtinArgOffset + 1) !=
                                   builtinArgTypeSyntaxNode ||
                               typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, builtinArgTypeSyntaxNode) != children[builtinArgOffset + 1]:
                                err = " typed expr type arena: builtin constructor argument TypeSyntax CSR incomplete"
                                return false
                        var builtinChildren: int32[]
                        setLen(builtinChildren, builtinArgCount + 1)
                        builtinChildren[0] = builtinBaseTypeId
                        for builtinCopyOffset in 0..<builtinArgCount:
                            builtinChildren[builtinCopyOffset + 1] =
                                children[builtinCopyOffset + 1]
                        if !typedExprTypeArenaIntern(
                               state, value, typeSyntaxNodeIndex,
                               TypedExprStructuralTypeApply,
                               TypedExprStructuralScalarInvalid,
                               -1, -1, -1, -1, -1, -1,
                               builtinChildren, childNames, typeId, err):
                            return false
                        genericApplied = true
            if !genericApplied:
                let fixedLength = state.bracketConstLengths[typeSyntaxNodeIndex]
                if children.len != 1 || fixedLength <= 0:
                    err = " typed expr type arena: bracket apply authority incomplete; exact generic SymbolId or bounded const AST required"
                    return false
                if !typedExprTypeArenaIntern(
                       state, value, typeSyntaxNodeIndex,
                       TypedExprStructuralTypeFixedArray,
                       TypedExprStructuralScalarInvalid, -1, -1,
                       fixedLength, -1,
                       -1, -1,
                       children, childNames, typeId, err):
                    return false
        elif kind == parser.ParserTypeSyntaxTuple:
            if children.len <= 0:
                err = " typed expr type arena: empty tuple authority missing"
                return false
            for childOffset in 0..<childCount:
                childNames[childOffset] =
                    typedExprTypeArenaSyntaxChildNameIdAt(
                        value, typeSyntaxNodeIndex, childOffset)
            if !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeTuple,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                return false
        elif kind == parser.ParserTypeSyntaxFunction:
            let paramCount = typedExprTypeArenaSyntaxFunctionParamCountAt(
                value, typeSyntaxNodeIndex)
            if paramCount < 0 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeFunction,
                   TypedExprStructuralScalarInvalid, -1, -1, -1, paramCount,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: function shape invalid"
                return false
        elif kind == parser.ParserTypeSyntaxAlias:
            let symbolId = state.symbolByDeclarationRoot[typeSyntaxNodeIndex]
            if children.len != 1 || symbolId < 0 ||
               !typedExprTypeArenaIntern(
                   state, value, typeSyntaxNodeIndex,
                   TypedExprStructuralTypeAlias,
                   TypedExprStructuralScalarInvalid, symbolId, -1, -1, -1,
                   -1, -1,
                   children, childNames, typeId, err):
                if err == "": err = " typed expr type arena: alias SymbolId authority missing"
                return false
        else:
            err = " typed expr type arena: TypeSyntax authority incomplete"
            return false
        # [forward-typeid] The forward verdict is consumed HERE, after the
        # whole dispatch has closed, exactly like the tree twin.  In the replay
        # this arm is only reachable through the resolve's out-of-range root,
        # and the enqueue then fails closed on the second-enqueue guard.
        if state.forwardNominalRoot >= 0:
            if !typedExprTypeArenaForwardNominalEnqueueInto(
                   forward, typeSyntaxNodeIndex, state.forwardNominalRoot,
                   typedExprTypeArenaSyntaxProducerSourceIndexAt(
                       value, typeSyntaxNodeIndex), err):
                return false
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        # [forward-replay-fixpoint] A skipped row is neither bound nor
        # enqueued: it keeps its flag so a later pass retries it.
        if state.forwardReplaySkipped:
            state.forwardReplaySkipped = false
            state.forwardReplayDeferredCount =
                state.forwardReplayDeferredCount + 1
            typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
            continue
        arenamod.ArenaArrayInt32Set(
            value.arena, value.typeSyntaxTypeIds,
            typeSyntaxNodeIndex, typeId)
        if forward.blockedFlags.len == state.typeSyntaxCount:
            # [forward-replay-progress] Only a row that was still waiting is
            # progress; every row the replay walks is flagged by construction.
            if forward.blockedFlags[typeSyntaxNodeIndex]:
                state.forwardReplayBoundCount =
                    state.forwardReplayBoundCount + 1
            typedExprTypeArenaForwardNominalClearRow(
                forward, typeSyntaxNodeIndex)
        typeSyntaxNodeIndex = typeSyntaxNodeIndex + 1
        continue

# [c2-replay-cols] The replay entry point over the materialised columns: the
# column-reading twin of `TypedExprTypeArenaReplayForwardRowsInto`.  Hard
# switch gating: a tree-vs-column diagnose round must report zero mismatches
# first.
@borrows
fn TypedExprTypeArenaReplayForwardRowsFromState(
        value: var TypedExprTypeArena,
        authority: TypedExprTypeResolutionAuthority,
        state: var TypedExprTypeArenaBuildState,
        pending: TypedExprTypeArenaPendingGenericApply,
        producerSourceIndex: int32,
        tokenRowBase: int32,
        typeSyntaxBase: int32,
        sourceTypeSyntaxRowCount: int32,
        err: var str): bool =
    if value == nil || state == nil || pending == nil ||
       state.forwardNominal == nil:
        err = " typed expr type arena: forward replay input invalid"
        return false
    if producerSourceIndex < 0 ||
       tokenRowBase < 0 || typeSyntaxBase < 0 || sourceTypeSyntaxRowCount < 0 ||
       state.forwardNominal.blockedFlags.len != state.typeSyntaxCount ||
       typeSyntaxBase + sourceTypeSyntaxRowCount > value.typeSyntaxCount:
        err = Fmt" typed expr type arena: forward replay state view invalid source_index={producerSourceIndex} base={typeSyntaxBase} rows={sourceTypeSyntaxRowCount} total={value.typeSyntaxCount} flags={state.forwardNominal.blockedFlags.len}"
        return false
    state.authority = share(authority)
    # [forward-replay-fixpoint] Same per-source readback as the tree twin.
    var replayFlaggedBefore: int32
    var replayFlagScan: int32 = typeSyntaxBase
    while replayFlagScan < typeSyntaxBase + sourceTypeSyntaxRowCount:
        if state.forwardNominal.blockedFlags[replayFlagScan]:
            replayFlaggedBefore = replayFlaggedBefore + 1
        replayFlagScan = replayFlagScan + 1
    if !typedExprTypeArenaInternSyntaxRowsFromState(
           value, authority, state, pending,
           typeSyntaxBase, typeSyntaxBase, tokenRowBase,
           sourceTypeSyntaxRowCount, err):
        return false
    var replayFlaggedAfter: int32
    replayFlagScan = typeSyntaxBase
    while replayFlagScan < typeSyntaxBase + sourceTypeSyntaxRowCount:
        if state.forwardNominal.blockedFlags[replayFlagScan]:
            replayFlaggedAfter = replayFlaggedAfter + 1
        replayFlagScan = replayFlagScan + 1
    if replayFlaggedBefore > 0:
        parser.ParserDebugStage(
            Fmt"replay_src src={producerSourceIndex} before={replayFlaggedBefore} after={replayFlaggedAfter}")
    typedExprTypeArenaRequirePinnedCapacity(value, state, "forward_replay")
    err = ""
    return true

# [c2-replay-cols] The equality proof the hard switch is gated on.  For EVERY
# row of the source the tree read and the materialised column must agree on
# kind, name token (presence and text) and fixed length; on the blocked rows
# the replay actually interns, the param count, every tuple child name id and
# the generic-arm reachability are compared too.  Any mismatch names row and
# field in `detailOut`; the hard switch happens only after a round reports
# zero.  Re-running `typedExprTypeArenaTupleChildNameId` here is idempotent
# interning (same text, same id, nothing inserted), so the intern pool is
# untouched.
@borrows
fn TypedExprTypeArenaReplayForwardRowsDiagnoseInto(
        value: var TypedExprTypeArena,
        tree: parser.ParserValueExprTree,
        state: TypedExprTypeArenaBuildState,
        typeSyntaxBase: int32,
        mismatchOut: var int64,
        checkedOut: var int64,
        err: var str): bool =
    if value == nil || state == nil || tree == nil ||
       state.forwardNominal == nil:
        err = " typed expr type arena: replay diagnose input invalid"
        return false
    if tree.producerSourceCount != 1 || typeSyntaxBase < 0 ||
       state.forwardNominal.blockedFlags.len != state.typeSyntaxCount ||
       typeSyntaxBase + tree.typeSyntaxCount > value.typeSyntaxCount:
        err = Fmt" typed expr type arena: replay diagnose view invalid base={typeSyntaxBase} rows={tree.typeSyntaxCount} total={value.typeSyntaxCount} flags={state.forwardNominal.blockedFlags.len}"
        return false
    var diagnoseParamScratch: int32[]
    var rowLocal: int32
    while rowLocal < tree.typeSyntaxCount:
        let row = typeSyntaxBase + rowLocal
        let treeKind = parser.ParserValueExprTypeSyntaxKindAt(tree, rowLocal)
        let colKind = typedExprTypeArenaSyntaxKindAt(value, row)
        checkedOut = checkedOut + 1
        if Int32(treeKind) != Int32(colKind):
            mismatchOut = mismatchOut + 1
            if mismatchOut <= 256:
                os.WriteLine(os.Get_stderr(), Fmt"replay_col_diag_mismatch row={row} field=kind tree={Int32(treeKind)} col={Int32(colKind)}")
            rowLocal = rowLocal + 1
            continue
        let treeNameToken = parser.ParserValueExprTypeSyntaxNameTokenAt(
            tree, rowLocal)
        let treeNameValid: int32 =
            treeNameToken >= 0 && treeNameToken < tree.tokenCount ? 1 : 0
        let colNameText = typedExprTypeArenaSyntaxNameTokenTextAt(value, row)
        let colNamePresent: int32 = colNameText != "" ? 1 : 0
        checkedOut = checkedOut + 1
        if treeNameValid != colNamePresent:
            mismatchOut = mismatchOut + 1
            if mismatchOut <= 256:
                os.WriteLine(os.Get_stderr(), Fmt"replay_col_diag_mismatch row={row} field=name_valid tree_valid={treeNameValid} col_present={colNamePresent}")
        elif treeNameValid == 1:
            let treeNameText = parser.ParserValueExprTokenText(
                tree, treeNameToken)
            checkedOut = checkedOut + 1
            if treeNameText != colNameText:
                mismatchOut = mismatchOut + 1
                if mismatchOut <= 256:
                    os.WriteLine(os.Get_stderr(), Fmt"replay_col_diag_mismatch row={row} field=name_text tree={treeNameText} col={colNameText}")
        let treeFixedLength = parser.ParserValueExprTypeSyntaxFixedLengthAt(
            tree, rowLocal)
        let colFixedLength = typedExprTypeArenaSyntaxFixedLengthRowAt(
            value, row)
        checkedOut = checkedOut + 1
        if treeFixedLength != colFixedLength:
            mismatchOut = mismatchOut + 1
            if mismatchOut <= 256:
                os.WriteLine(os.Get_stderr(), Fmt"replay_col_diag_mismatch row={row} field=fixed_length tree={treeFixedLength} col={colFixedLength}")
        if state.forwardNominal.blockedFlags[row]:
            if Int32(colKind) == Int32(parser.ParserTypeSyntaxFunction):
                let childCount = typedExprTypeArenaSyntaxChildCountAt(
                    value, row)
                setLen(diagnoseParamScratch, childCount)
                var treeParamCount: int32
                let treeParamValid = typedExprTypeArenaFunctionParamCount(
                    tree, row, typeSyntaxBase, diagnoseParamScratch,
                    treeParamCount)
                let treeParamField: int32 =
                    treeParamValid ? treeParamCount : -1
                let colParamCount =
                    typedExprTypeArenaSyntaxFunctionParamCountAt(value, row)
                checkedOut = checkedOut + 1
                if treeParamField != colParamCount:
                    mismatchOut = mismatchOut + 1
                    if mismatchOut <= 256:
                        os.WriteLine(os.Get_stderr(), Fmt"replay_col_diag_mismatch row={row} field=param_count tree={treeParamField} col={colParamCount}")
            elif Int32(colKind) == Int32(parser.ParserTypeSyntaxTuple):
                let childCount = typedExprTypeArenaSyntaxChildCountAt(
                    value, row)
                for childOffset in 0..<childCount:
                    let childNode = typedExprTypeArenaSyntaxChildAt(
                        value, row, childOffset)
                    let treeNameId = typedExprTypeArenaTupleChildNameId(
                        value, tree, childNode, typeSyntaxBase)
                    let colNameId = typedExprTypeArenaSyntaxChildNameIdAt(
                        value, row, childOffset)
                    checkedOut = checkedOut + 1
                    if treeNameId != colNameId:
                        mismatchOut = mismatchOut + 1
                        if mismatchOut <= 256:
                            os.WriteLine(os.Get_stderr(), Fmt"replay_col_diag_mismatch row={row} child={childOffset} field=child_name tree={treeNameId} col={colNameId}")
            if typedExprTypeArenaGenericAuthorityRow(state, row) >= 0:
                mismatchOut = mismatchOut + 1
                if mismatchOut <= 256:
                    os.WriteLine(os.Get_stderr(), Fmt"replay_col_diag_mismatch row={row} field=generic_reach tree=unreachable col=fail_closed")
        rowLocal = rowLocal + 1
    err = ""
    return true

# [forward-decl] Equality proof for the two authorities.  `state`'s declaration
# generic window was seeded before any source was resident; the arena's
# `typeSyntaxGenericSymbolStarts/Counts` rows were written one source at a time
# by `FillTypeSyntax`.  At seal every source has been appended, so both are
# complete and must agree row for row; a disagreement is a defect, never a
# repairable condition.
@borrows
fn typedExprTypeArenaVerifyDeclarationGenericWindowsInto(
        value: TypedExprTypeArena,
        state: TypedExprTypeArenaBuildState,
        err: var str): bool =
    for symbolId in 0..<state.declarationSymbolTotal:
        let declarationRoot = typedExprTypeArenaInt32At(
            value,
            value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset,
            value.symbolDeclarationRootTypeSyntaxNodeIndexes.len,
            symbolId)
        let indexStart = state.declarationGenericSymbolStarts[symbolId]
        let indexCount = state.declarationGenericSymbolCounts[symbolId]
        let arenaStart =
            typedExprTypeArenaSyntaxGenericSymbolStartAt(
                value, declarationRoot)
        let arenaCount =
            typedExprTypeArenaSyntaxGenericSymbolCountAt(
                value, declarationRoot)
        if indexStart != arenaStart || indexCount != arenaCount:
            err = Fmt" typed expr type arena: declaration generic window drift symbol={symbolId} root={declarationRoot} index_start={indexStart} arena_start={arenaStart} index_count={indexCount} arena_count={arenaCount}"
            return false
    return true

# [S1b step-3 (5)] The seal phase, driven with no parser tree anywhere.  Every
# parser fact it reads was materialised into an arena column by AppendSource.
@borrows
fn TypedExprTypeArenaSealInto(
        value: var TypedExprTypeArena,
        state: var TypedExprTypeArenaBuildState,
        pending: TypedExprTypeArenaPendingGenericApply,
        out: var TypedExprTypeArena,
        err: var str): bool =
    if value == nil || state == nil || pending == nil || out != nil:
        err = " typed expr type arena: seal destination is not empty"
        return false
    # [closure8] Every SymbolId the sealed index predicts was materialised,
    # and no symbol was materialised that the index does not predict.
    if value.symbolCount != state.declarationSymbolTotal:
        err = Fmt" typed expr type arena: declaration SymbolId materialization mismatch materialized={value.symbolCount} indexed={state.declarationSymbolTotal}"
        return false
    # [forward-decl] Every source has been appended by now, so the index's
    # declaration generic window and the arena's per-row generic-symbol columns
    # are two complete readings of one build.  This is the equality proof that
    # makes the switched read sites byte-neutral: a drift aborts with the exact
    # SymbolId, the declaration root and both readings.
    if !typedExprTypeArenaVerifyDeclarationGenericWindowsInto(
           value, state, err):
        return false
    if !typedExprTypeArenaFillGenericSymbolTypesRec(value, 0, 0, err):
        return false
    if !typedExprTypeArenaRealizeDeclarationsRec(value, state, 0, err):
        return false
    if !typedExprTypeArenaFinalizeObjectBases(state, value, err):
        return false
    if pending.typeIds.len !=
           pending.declarationRoots.len ||
       pending.typeIds.len !=
           pending.typeSyntaxNodeIndexes.len:
        err = " typed expr type arena: pending generic specialization columns mismatch"
        return false
    let specializationSourceTypeCount = value.typeCount
    if !typedExprTypeArenaSpecializePendingRec(
           value, state, pending, 0,
           specializationSourceTypeCount, err):
        return false
    if pending.specializedDeclarationTypeIds.len !=
           pending.typeIds.len:
        err = " typed expr type arena: generic specialization result coverage drift"
        return false
    if !typedExprTypeArenaPatchPendingApplyRec(value, pending, 0):
        err = " typed expr type arena: pending generic apply patch failed"
        return false
    var voidTypeId: int32 = -1
    for typeId in 0..<value.typeCount:
        if typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) ==
               Int32(TypedExprStructuralTypeScalar) &&
           typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, typeId) ==
               Int32(TypedExprStructuralScalarVoid) &&
           typedExprTypeArenaInt32At(value, value.typeOriginKinds.offset, value.typeOriginKinds.len, typeId) ==
               Int32(TypedExprTypeOriginSemanticBuiltin):
            if voidTypeId >= 0:
                err = " typed expr type arena: semantic void authority duplicated"
                return false
            voidTypeId = typeId
    if voidTypeId < 0:
        err = " typed expr type arena: semantic void authority missing"
        return false
    var functionByOwnerToken: int32[]
    var explicitReturnCounts: int32[]
    setLen(functionByOwnerToken, value.tokenCount)
    setLen(explicitReturnCounts, value.functionCount)
    for tokenIndex in 0..<functionByOwnerToken.len:
        functionByOwnerToken[tokenIndex] = -1
    if !typedExprTypeArenaBindFunctionOwnersRec(
           value, functionByOwnerToken, voidTypeId, 0, err):
        return false
    if !typedExprTypeArenaBindFunctionReturnsRec(
           value, functionByOwnerToken, explicitReturnCounts, 0, err):
        return false
    for row in 0..<state.authorityUsed.len:
        if !state.authorityUsed[row]:
            err = " typed expr type arena: unused resolution authority edge"
            return false
    for row in 0..<state.genericAuthorityUsed.len:
        if !state.genericAuthorityUsed[row]:
            err = " typed expr type arena: unused generic resolution authority edge"
            return false
    if !typedExprTypeArenaBuildDependencyProof(state, value, err):
        return false
    var derivedManaged: int32[]
    var derivedSend: int32[]
    var derivedSync: int32[]
    if !typedExprTypeArenaComputeTraitFlags(
           value, derivedManaged, derivedSend, derivedSync, err):
        return false
    typedExprTypeArenaApplyTraitFlagsRec(
        value, derivedManaged, derivedSend, derivedSync, 0)
    value.complete = true
    value.artifactRaw32 = typedExprTypeArenaHash(value)
    if !TypedExprTypeArenaStrictValidateInto(value, err):
        return false
    typedExprTypeArenaRequirePinnedCapacity(value, state, "seal")
    out = value
    err = ""
    return true

# The whole-forest driver: one merged tree, every view base 0, one group window
# covering every producer source.  This is the same sequence of operations in
# the same order as the interleaved body it replaces.
@borrows
fn TypedExprTypeArenaBuildFromParserTreeInto(
        tree: parser.ParserValueExprTree,
        authority: TypedExprTypeResolutionAuthority,
        out: var TypedExprTypeArena,
        err: var str): bool =
    if out != nil:
        err = " typed expr type arena: destination is not empty"
        return false
    if !typedExprTypeArenaTreeShape(tree, err) ||
       !typedExprTypeArenaAuthorityShape(
           authority, tree.typeSyntaxCount,
           tree.typeGenericSymbolCount, err):
        return false
    var limits: TypedExprTypeArenaLimits
    if !TypedExprTypeArenaLimitsFromTreeInto(tree, limits, err):
        return false
    var value: TypedExprTypeArena
    var state: TypedExprTypeArenaBuildState
    # [closure8] The whole-forest driver has the merged tree resident and no
    # declaration index, so the SymbolId space is materialised from that tree
    # by the same traversal the index build uses, in the same row order.
    var declarationSymbolGlobalRoots: int32[]
    if !typedExprTypeArenaAppendDeclarationSymbolRootsFromTreeInto(
           tree, 0, declarationSymbolGlobalRoots, err):
        return false
    var declarationGenericSymbolStarts: int32[]
    var declarationGenericSymbolCounts: int32[]
    if !typedExprTypeArenaAppendDeclarationGenericWindowsFromTreeInto(
           tree, declarationGenericSymbolStarts,
           declarationGenericSymbolCounts, err):
        return false
    if !TypedExprTypeArenaAllocateFromLimitsInto(
           limits, authority, declarationSymbolGlobalRoots,
           declarationGenericSymbolStarts,
           declarationGenericSymbolCounts,
           value, state, err):
        return false
    var pending: TypedExprTypeArenaPendingGenericApply =
        new(TypedExprTypeArenaPendingGenericApply)
    if !TypedExprTypeArenaAppendSourceFromTreeInto(
           value, tree, authority, state,
           0, 0, 0, 0, 0, 0, 0, 0, value.producerSourceCount, 0,
           pending, err):
        TypedExprTypeArenaRelease(value)
        return false
    # [forward-typeid] The whole-forest driver reserves every aggregate before
    # it interns anything (`ReserveAggregatesRec` walks every symbol in one
    # call), so no nominal can ever be forward here and this queue stays empty.
    # It is still checked: a non-empty queue at this point would mean the
    # whole-forest ordering assumption broke, and the drained check turns that
    # into a named failure instead of a silently unbound TypeId row.
    if !TypedExprTypeArenaForwardNominalRequireDrainedInto(
           state.forwardNominal, value, err):
        TypedExprTypeArenaRelease(value)
        return false
    if !TypedExprTypeArenaSealInto(
           value, state, pending, out, err):
        TypedExprTypeArenaRelease(value)
        return false
    err = ""
    return true

@borrows
fn typedExprTypeArenaSpecializationMatches(
        value: TypedExprTypeArena,
        sourceTypeId: int32,
        specializedTypeId: int32,
        genericSymbolStart: int32,
        genericSymbolCount: int32,
        argumentTypeIds: int32[],
        memo: var int32[],
        visiting: var bool[],
        err: var str): bool =
    if sourceTypeId < 0 || sourceTypeId >= value.typeCount ||
       specializedTypeId < 0 || specializedTypeId >= value.typeCount ||
       genericSymbolStart < 0 || genericSymbolCount <= 0 ||
       genericSymbolCount != argumentTypeIds.len ||
       genericSymbolStart >
           value.genericSymbolCount - genericSymbolCount ||
       memo.len != value.typeCount || visiting.len != value.typeCount:
        err = " typed expr type arena: generic specialization receipt domain invalid"
        return false
    if visiting[sourceTypeId]:
        err = " typed expr type arena: recursive generic specialization receipt unsupported"
        return false
    if memo[sourceTypeId] >= 0:
        if memo[sourceTypeId] != specializedTypeId:
            err = " typed expr type arena: generic specialization memo drift"
            return false
        return true
    visiting[sourceTypeId] = true
    let sourceKind = TypedExprStructuralTypeKind(
        typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, sourceTypeId))
    if sourceKind == TypedExprStructuralTypeGenericParameter:
        let genericSymbolId = typedExprTypeArenaInt32At(value, value.genericSymbolIds.offset, value.genericSymbolIds.len, sourceTypeId)
        if genericSymbolId < genericSymbolStart ||
           genericSymbolId >=
               genericSymbolStart + genericSymbolCount:
            err = " typed expr type arena: generic specialization receipt references foreign genericSymbolId"
            visiting[sourceTypeId] = false
            return false
        let genericOffset = genericSymbolId - genericSymbolStart
        if typedExprTypeArenaInt32At(value, value.genericSymbolOrdinals.offset, value.genericSymbolOrdinals.len, genericSymbolId) != genericOffset ||
           argumentTypeIds[genericOffset] != specializedTypeId:
            err = " typed expr type arena: generic specialization binding receipt drift"
            visiting[sourceTypeId] = false
            return false
        memo[sourceTypeId] = specializedTypeId
        visiting[sourceTypeId] = false
        return true
    if sourceKind == TypedExprStructuralTypeApply:
        let sourceChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, sourceTypeId)
        let specializedChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, specializedTypeId)
        let sourceChildCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, sourceTypeId)
        let targetSymbolId = typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, sourceTypeId)
        if typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, specializedTypeId) !=
               Int32(TypedExprStructuralTypeApply) ||
           typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, specializedTypeId) !=
               targetSymbolId ||
           sourceChildCount < 2 ||
           typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, specializedTypeId) != sourceChildCount ||
           targetSymbolId < 0 || targetSymbolId >= value.symbolCount:
            err = " typed expr type arena: nested generic Apply specialization receipt invalid"
            visiting[sourceTypeId] = false
            return false
        let targetDeclarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, targetSymbolId)
        let targetGenericStart = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolStarts.offset, value.typeSyntaxGenericSymbolStarts.len, targetDeclarationRoot)
        let targetGenericCount = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolCounts.offset, value.typeSyntaxGenericSymbolCounts.len, targetDeclarationRoot)
        if targetGenericCount <= 0 ||
           sourceChildCount != targetGenericCount + 1:
            err = " typed expr type arena: nested generic Apply specialization receipt arity invalid"
            visiting[sourceTypeId] = false
            return false
        var nestedArgumentTypeIds: int32[]
        for targetOffset in 0..<targetGenericCount:
            let specializedArgumentTypeId =
                typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, specializedChildStart + targetOffset + 1)
            if typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, sourceChildStart + targetOffset + 1) !=
                   typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, specializedChildStart + targetOffset + 1) ||
               !typedExprTypeArenaSpecializationMatches(
                   value,
                   typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, sourceChildStart + targetOffset + 1),
                   specializedArgumentTypeId,
                   genericSymbolStart,
                   genericSymbolCount,
                   argumentTypeIds,
                   memo,
                   visiting,
                   err):
                if err == "":
                    err = " typed expr type arena: nested generic argument specialization receipt drift"
                visiting[sourceTypeId] = false
                return false
            add(nestedArgumentTypeIds, specializedArgumentTypeId)
        var targetMemo: int32[]
        var targetVisiting: bool[]
        setLen(targetMemo, value.typeCount)
        setLen(targetVisiting, value.typeCount)
        for targetTypeId in 0..<value.typeCount:
            targetMemo[targetTypeId] = -1
        if !typedExprTypeArenaSpecializationMatches(
               value,
               typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, targetDeclarationRoot),
               typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, specializedChildStart),
               targetGenericStart,
               targetGenericCount,
               nestedArgumentTypeIds,
               targetMemo,
               targetVisiting,
               err):
            if err == "":
                err = " typed expr type arena: nested generic declaration specialization receipt drift"
            visiting[sourceTypeId] = false
            return false
        memo[sourceTypeId] = specializedTypeId
        visiting[sourceTypeId] = false
        return true
    if typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, sourceTypeId) !=
           typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, specializedTypeId) ||
       typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, sourceTypeId) !=
           typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, specializedTypeId) ||
       typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, sourceTypeId) !=
           typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, specializedTypeId) ||
       typedExprTypeArenaInt32At(value, value.genericSymbolIds.offset, value.genericSymbolIds.len, sourceTypeId) !=
           typedExprTypeArenaInt32At(value, value.genericSymbolIds.offset, value.genericSymbolIds.len, specializedTypeId) ||
       typedExprTypeArenaInt32At(value, value.fixedLengths.offset, value.fixedLengths.len, sourceTypeId) !=
           typedExprTypeArenaInt32At(value, value.fixedLengths.offset, value.fixedLengths.len, specializedTypeId) ||
       typedExprTypeArenaInt32At(value, value.functionParamCounts.offset, value.functionParamCounts.len, sourceTypeId) !=
           typedExprTypeArenaInt32At(value, value.functionParamCounts.offset, value.functionParamCounts.len, specializedTypeId) ||
       typedExprTypeArenaInt32At(value, value.baseTypeSyntaxNodeIndexes.offset, value.baseTypeSyntaxNodeIndexes.len, sourceTypeId) !=
           typedExprTypeArenaInt32At(value, value.baseTypeSyntaxNodeIndexes.offset, value.baseTypeSyntaxNodeIndexes.len, specializedTypeId):
        err = " typed expr type arena: generic specialization structural payload drift"
        visiting[sourceTypeId] = false
        return false
    let sourceBaseTypeId = typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, sourceTypeId)
    let specializedBaseTypeId = typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, specializedTypeId)
    if (sourceBaseTypeId >= 0) != (specializedBaseTypeId >= 0):
        err = " typed expr type arena: generic specialization base presence drift"
        visiting[sourceTypeId] = false
        return false
    if sourceBaseTypeId >= 0 &&
       !typedExprTypeArenaSpecializationMatches(
           value,
           sourceBaseTypeId,
           specializedBaseTypeId,
           genericSymbolStart,
           genericSymbolCount,
           argumentTypeIds,
           memo,
           visiting,
           err):
        if err == "":
            err = " typed expr type arena: generic specialization base receipt drift"
        visiting[sourceTypeId] = false
        return false
    let sourceChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, sourceTypeId)
    let specializedChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, specializedTypeId)
    let childCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, sourceTypeId)
    if typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, specializedTypeId) != childCount:
        err = " typed expr type arena: generic specialization child count drift"
        visiting[sourceTypeId] = false
        return false
    for childOffset in 0..<childCount:
        if typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, sourceChildStart + childOffset) !=
               typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, specializedChildStart + childOffset) ||
           !typedExprTypeArenaSpecializationMatches(
               value,
               typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, sourceChildStart + childOffset),
               typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, specializedChildStart + childOffset),
               genericSymbolStart,
               genericSymbolCount,
               argumentTypeIds,
               memo,
               visiting,
               err):
            if err == "":
                err = " typed expr type arena: generic specialization child receipt drift"
            visiting[sourceTypeId] = false
            return false
    memo[sourceTypeId] = specializedTypeId
    visiting[sourceTypeId] = false
    return true

type
    typedExprTypeArenaValidateScratch = ref object
        expectedTypeSyntaxSourceLocalRows: int32[]
        bracketArgCursor: int32
        genericReferenced: bool[]
        originChildCounts: int32[]
        firstOriginChild: int32[]
        qualifiedChildCounts: int32[]
        resolutionSymbolByTypeSyntax: int32[]
        genericResolutionByTypeSyntax: int32[]

@borrows
fn typedExprTypeArenaValidateTypeSyntaxRec(
        value: TypedExprTypeArena,
        scratch: typedExprTypeArenaValidateScratch,
        row: int32,
        err: var str): bool =
    while true:
        if row >= value.typeSyntaxCount:
            for symbolRow in 0..<scratch.genericReferenced.len:
                if !scratch.genericReferenced[symbolRow]:
                    err = " typed expr type arena: generic symbol origin unreachable"
                    return false
            if scratch.bracketArgCursor != value.bracketArgCount:
                err = " typed expr type arena: bracket argument origin coverage invalid"
                return false
            return true
        let typeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, row)
        let parserKind = typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, row)
        let producerSourceIndex = typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, row)
        let sourceLocalRow = typedExprTypeArenaInt32At(value, value.typeSyntaxSourceLocalRows.offset, value.typeSyntaxSourceLocalRows.len, row)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= value.producerSourceCount ||
           sourceLocalRow !=
               scratch.expectedTypeSyntaxSourceLocalRows[
                   producerSourceIndex]:
            err = " typed expr type arena: TypeSyntax exact source-local row drift"
            return false
        scratch.expectedTypeSyntaxSourceLocalRows[producerSourceIndex] =
            sourceLocalRow + 1
        let spanStart = typedExprTypeArenaInt32At(value, value.typeSyntaxSpanStarts.offset, value.typeSyntaxSpanStarts.len, row)
        let spanEnd = typedExprTypeArenaInt32At(value, value.typeSyntaxSpanEnds.offset, value.typeSyntaxSpanEnds.len, row)
        let ownerToken = typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, row)
        let questionToken = typedExprTypeArenaInt32At(value, value.typeSyntaxQuestionTokenIndexes.offset, value.typeSyntaxQuestionTokenIndexes.len, row)
        let declarationOwnerToken = typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, row)
        let declarationOwner = typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, row)
        let genericStart = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolStarts.offset, value.typeSyntaxGenericSymbolStarts.len, row)
        let genericCount = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolCounts.offset, value.typeSyntaxGenericSymbolCounts.len, row)
        let rootKind = typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, row)
        let bracketArgStart = typedExprTypeArenaInt32At(value, value.typeSyntaxBracketArgStarts.offset, value.typeSyntaxBracketArgStarts.len, row)
        let bracketArgCount = typedExprTypeArenaInt32At(value, value.typeSyntaxBracketArgCounts.offset, value.typeSyntaxBracketArgCounts.len, row)
        let bracketBaseTypeSyntaxNodeIndex = typedExprTypeArenaInt32At(value, value.typeSyntaxBracketBaseTypeSyntaxNodeIndexes.offset, value.typeSyntaxBracketBaseTypeSyntaxNodeIndexes.len, row)
        let parentTypeSyntaxNodeIndex = typedExprTypeArenaInt32At(value, value.typeSyntaxParentNodeIndexes.offset, value.typeSyntaxParentNodeIndexes.len, row)
        var parentParserKind = Int32(parser.ParserTypeSyntaxInvalid)
        if parentTypeSyntaxNodeIndex >= 0 &&
           parentTypeSyntaxNodeIndex < value.typeSyntaxCount:
            parentParserKind = typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, parentTypeSyntaxNodeIndex)
        let qualifiedSegment =
            parserKind == Int32(parser.ParserTypeSyntaxNominal) &&
            parentParserKind == Int32(parser.ParserTypeSyntaxQualified)
        let bracketKind =
            parserKind == Int32(parser.ParserTypeSyntaxFixedArray) ||
            parserKind == Int32(parser.ParserTypeSyntaxBracketApply)
        if typeId < 0 || typeId >= value.typeCount ||
           parserKind <= Int32(parser.ParserTypeSyntaxInvalid) ||
           parserKind > Int32(parser.ParserTypeSyntaxOptional) ||
           producerSourceIndex < 0 ||
           producerSourceIndex >= value.producerSourceCount ||
           spanStart < 0 || spanEnd <= spanStart || ownerToken < 0 ||
           ownerToken >= value.tokenCount || questionToken < -1 ||
           questionToken >= value.tokenCount ||
           declarationOwnerToken < -1 ||
           declarationOwnerToken >= value.tokenCount ||
           declarationOwner < -1 || declarationOwner >= value.typeSyntaxCount ||
           genericStart < -1 || genericCount < 0 ||
           (genericCount == 0) != (genericStart == -1) ||
           (genericCount > 0 && genericStart >
               value.genericSymbolCount - genericCount) ||
           rootKind < Int32(parser.ParserTypeSyntaxRootInvalid) ||
           rootKind > Int32(parser.ParserTypeSyntaxRootGenericDefault) ||
           (rootKind == Int32(parser.ParserTypeSyntaxRootInvalid) &&
            (declarationOwnerToken != -1 || declarationOwner != -1 ||
             genericStart != -1 || genericCount != 0)) ||
           (rootKind != Int32(parser.ParserTypeSyntaxRootInvalid) &&
            declarationOwnerToken < 0) ||
           (rootKind ==
                Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) &&
            declarationOwner != row) ||
           bracketArgStart != scratch.bracketArgCursor || bracketArgCount < 0 ||
           bracketArgStart + bracketArgCount > value.bracketArgCount ||
           (bracketKind != (bracketArgCount > 0)) ||
           (bracketKind != (bracketBaseTypeSyntaxNodeIndex >= 0)) ||
           (bracketBaseTypeSyntaxNodeIndex >= row):
            err = " typed expr type arena: TypeSyntax origin authority invalid"
            return false
        if rootKind ==
               Int32(parser.ParserTypeSyntaxRootFieldDeclaration):
            if declarationOwner < 0 || declarationOwner >= row:
                err = " typed expr type arena: field declaration owner cycle or forward edge"
                return false
            let declarationOwnerRootKind =
                typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, declarationOwner)
            let declarationOwnerParserKind =
                typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, declarationOwner)
            let topLevelObjectOwner =
                declarationOwnerRootKind ==
                    Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) &&
                (declarationOwnerParserKind ==
                     Int32(parser.ParserTypeSyntaxImplicitObject) ||
                 declarationOwnerParserKind ==
                     Int32(parser.ParserTypeSyntaxObject) ||
                 declarationOwnerParserKind ==
                     Int32(parser.ParserTypeSyntaxRefObject))
            # [phaseB-parser] `type N = tuple[a: T, ...]` 具名元素的字段声明
            # root 的 owner 是别名包裹 tuple 的声明根；精确到「单子且子为
            # Tuple」，与 parser 的 DeclarationOwnerEdgeValid 同口径。
            let topLevelTupleAliasOwner =
                declarationOwnerRootKind ==
                    Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) &&
                declarationOwnerParserKind ==
                    Int32(parser.ParserTypeSyntaxAlias) &&
                scratch.originChildCounts[declarationOwner] == 1 &&
                scratch.firstOriginChild[declarationOwner] >= 0 &&
                typedExprTypeArenaInt32At(
                    value,
                    value.typeSyntaxParserKinds.offset,
                    value.typeSyntaxParserKinds.len,
                    scratch.firstOriginChild[declarationOwner]) ==
                    Int32(parser.ParserTypeSyntaxTuple)
            let nestedObjectOwner =
                declarationOwnerRootKind ==
                    Int32(parser.ParserTypeSyntaxRootFieldDeclaration) &&
                (declarationOwnerParserKind ==
                     Int32(parser.ParserTypeSyntaxObject) ||
                 declarationOwnerParserKind ==
                     Int32(parser.ParserTypeSyntaxRefObject))
            if (!topLevelObjectOwner && !topLevelTupleAliasOwner &&
                !nestedObjectOwner) ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, declarationOwner) != producerSourceIndex ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, declarationOwner) != declarationOwnerToken ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolStarts.offset, value.typeSyntaxGenericSymbolStarts.len, declarationOwner) != genericStart ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolCounts.offset, value.typeSyntaxGenericSymbolCounts.len, declarationOwner) != genericCount:
                err = " typed expr type arena: immediate field declaration owner drift"
                return false
        let optional =
            parserKind == Int32(parser.ParserTypeSyntaxOptional)
        let grouped =
            parserKind == Int32(parser.ParserTypeSyntaxGrouped)
        if optional != (questionToken >= 0):
            err = " typed expr type arena: optional token shape drift"
            return false
        if grouped:
            let child = scratch.firstOriginChild[row]
            if scratch.originChildCounts[row] != 1 || child < 0 ||
               child >= row ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, child) != producerSourceIndex ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, child) != ownerToken ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, child) !=
                   Int32(parser.ParserTypeSyntaxRootInvalid) ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, child) != -1 ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxSpanStarts.offset, value.typeSyntaxSpanStarts.len, child) <= spanStart ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxSpanEnds.offset, value.typeSyntaxSpanEnds.len, child) >= spanEnd ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, child) != typeId:
                err = " typed expr type arena: grouped origin authority drift"
                return false
        if optional:
            let child = scratch.firstOriginChild[row]
            if scratch.originChildCounts[row] != 1 || child < 0 ||
               questionToken <= 0 ||
               typedExprTypeArenaInt32At(value, value.tokenProducerSourceIndexes.offset, value.tokenProducerSourceIndexes.len, questionToken) != producerSourceIndex ||
               typedExprTypeArenaInt32At(value, value.tokenKinds.offset, value.tokenKinds.len, questionToken) !=
                   Int32(parser.ParserValueTokenQuestion) ||
               typedExprTypeArenaInt32At(value, value.tokenProducerSourceIndexes.offset, value.tokenProducerSourceIndexes.len, questionToken - 1) != producerSourceIndex ||
               typedExprTypeArenaInt32At(value, value.tokenSpanEnds.offset, value.tokenSpanEnds.len, questionToken - 1) !=
                   typedExprTypeArenaInt32At(value, value.typeSyntaxSpanEnds.offset, value.typeSyntaxSpanEnds.len, child) ||
               typedExprTypeArenaInt32At(value, value.tokenSpanStarts.offset, value.tokenSpanStarts.len, questionToken) <
                   typedExprTypeArenaInt32At(value, value.tokenSpanEnds.offset, value.tokenSpanEnds.len, questionToken - 1) ||
               typedExprTypeArenaInt32At(value, value.tokenSpanEnds.offset, value.tokenSpanEnds.len, questionToken) != spanEnd ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, child) ==
                   Int32(parser.ParserTypeSyntaxInvalid) ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, child) != producerSourceIndex ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, child) != ownerToken ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxSpanStarts.offset, value.typeSyntaxSpanStarts.len, child) !=
                   spanStart ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxSpanEnds.offset, value.typeSyntaxSpanEnds.len, child) >= spanEnd ||
               typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) !=
                   Int32(TypedExprStructuralTypeOptional):
                err = " typed expr type arena: optional origin authority drift"
                return false
        if bracketBaseTypeSyntaxNodeIndex >= 0 &&
           (typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, bracketBaseTypeSyntaxNodeIndex) != producerSourceIndex ||
            typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, bracketBaseTypeSyntaxNodeIndex) != ownerToken):
            err = " typed expr type arena: bracket base origin invalid"
            return false
        let nominalRequiresResolution =
            (parserKind == Int32(parser.ParserTypeSyntaxNominal) &&
             !qualifiedSegment &&
             typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) !=
                 Int32(TypedExprStructuralTypeScalar) &&
             typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) !=
                 Int32(TypedExprStructuralTypeGenericParameter)) ||
            parserKind == Int32(parser.ParserTypeSyntaxQualified)
        let genericRequiresResolution =
            parserKind == Int32(parser.ParserTypeSyntaxNominal) &&
            !qualifiedSegment &&
            typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) ==
                Int32(TypedExprStructuralTypeGenericParameter)
        if (scratch.resolutionSymbolByTypeSyntax[row] >= 0) !=
               nominalRequiresResolution ||
           (scratch.genericResolutionByTypeSyntax[row] >= 0) !=
               genericRequiresResolution:
            err = " typed expr type arena: nominal resolution receipt drift"
            return false
        if genericRequiresResolution &&
           typedExprTypeArenaInt32At(value, value.genericSymbolIds.offset, value.genericSymbolIds.len, typeId) !=
               scratch.genericResolutionByTypeSyntax[row]:
            err = " typed expr type arena: generic resolution TypeId drift"
            return false
        if parentParserKind == Int32(parser.ParserTypeSyntaxQualified) &&
           (parserKind != Int32(parser.ParserTypeSyntaxNominal) ||
            parentTypeSyntaxNodeIndex <= row ||
            producerSourceIndex != typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, parentTypeSyntaxNodeIndex) ||
            typeId != typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, parentTypeSyntaxNodeIndex)):
            err = " typed expr type arena: qualified nominal segment receipt drift"
            return false
        if parserKind == Int32(parser.ParserTypeSyntaxQualified) &&
           scratch.qualifiedChildCounts[row] < 2:
            err = " typed expr type arena: qualified nominal child coverage drift"
            return false
        for argOffset in 0..<bracketArgCount:
            let argRow = bracketArgStart + argOffset
            let tokenStart = typedExprTypeArenaInt32At(value, value.bracketArgTokenStarts.offset, value.bracketArgTokenStarts.len, argRow)
            let tokenCount = typedExprTypeArenaInt32At(value, value.bracketArgTokenCounts.offset, value.bracketArgTokenCounts.len, argRow)
            let argTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.bracketArgTypeSyntaxNodeIndexes.offset, value.bracketArgTypeSyntaxNodeIndexes.len, argRow)
            if tokenStart < 0 || tokenCount <= 0 ||
               tokenStart + tokenCount > value.tokenCount ||
               argTypeSyntaxNode < -1 || argTypeSyntaxNode >= row ||
               (parserKind == Int32(parser.ParserTypeSyntaxFixedArray) &&
                argTypeSyntaxNode != -1) ||
               (argTypeSyntaxNode >= 0 &&
                (typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, argTypeSyntaxNode) != producerSourceIndex ||
                 typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, argTypeSyntaxNode) != ownerToken)):
                err = " typed expr type arena: bracket argument origin invalid"
                return false
        if parserKind == Int32(parser.ParserTypeSyntaxFixedArray) ||
           parserKind == Int32(parser.ParserTypeSyntaxBracketApply):
            let semanticKind = typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId)
            # [builtin-ctor] An application row has TWO possible authorities,
            # and this arm must judge each against its own.  A declaration
            # application carries the declaration's SymbolId; a built-in
            # type constructor application has no declaration at all and
            # carries `-1` with the constructor row in child[0].  The
            # discrimination is the module's one shape test -- the same call
            # the payload section below makes -- not a second local opening.
            let builtinHeadApply =
                typedExprTypeArenaBuiltinHeadApply(value, typeId)
            if semanticKind == Int32(TypedExprStructuralTypeApply) &&
               !builtinHeadApply:
                let symbolId = typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, typeId)
                if parserKind !=
                       Int32(parser.ParserTypeSyntaxBracketApply) ||
                   symbolId < 0 || symbolId >= value.symbolCount:
                    err = " typed expr type arena: generic application origin invalid"
                    return false
                let declarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
                let semanticChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, typeId)
                let semanticChildCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, typeId)
                let declarationGenericStart = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolStarts.offset, value.typeSyntaxGenericSymbolStarts.len, declarationRoot)
                let declarationGenericCount = typedExprTypeArenaInt32At(value, value.typeSyntaxGenericSymbolCounts.offset, value.typeSyntaxGenericSymbolCounts.len, declarationRoot)
                if declarationRoot < 0 ||
                   declarationRoot >= value.typeSyntaxCount ||
                   bracketArgCount <= 0 ||
                   bracketArgCount > declarationGenericCount ||
                   scratch.resolutionSymbolByTypeSyntax[
                       bracketBaseTypeSyntaxNodeIndex] != symbolId ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, bracketBaseTypeSyntaxNodeIndex) !=
                       Int32(parser.ParserTypeSyntaxNominal) &&
                   typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, bracketBaseTypeSyntaxNodeIndex) !=
                       Int32(parser.ParserTypeSyntaxQualified) ||
                   declarationGenericStart < 0 ||
                   declarationGenericCount <= 0 ||
                   semanticChildCount != declarationGenericCount + 1 ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, bracketBaseTypeSyntaxNodeIndex) !=
                       typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, declarationRoot):
                    err = " typed expr type arena: generic declaration authority drift"
                    return false
                var argumentTypeIds: int32[]
                    setLen(argumentTypeIds, declarationGenericCount)
                for genericOffset in 0..<declarationGenericCount:
                    let argumentTypeId = typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, semanticChildStart + genericOffset + 1)
                    if argumentTypeId < 0 ||
                       argumentTypeId >= value.typeCount:
                        err = " typed expr type arena: generic argument TypeId drift"
                        return false
                    if genericOffset < bracketArgCount:
                        let argTypeSyntaxNode =
                            typedExprTypeArenaInt32At(value, value.bracketArgTypeSyntaxNodeIndexes.offset, value.bracketArgTypeSyntaxNodeIndexes.len, bracketArgStart + genericOffset)
                        if argTypeSyntaxNode < 0 ||
                           argumentTypeId !=
                               typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, argTypeSyntaxNode):
                            err = " typed expr type arena: generic argument TypeId drift"
                            return false
                    argumentTypeIds[genericOffset] = argumentTypeId
                for genericOffset in bracketArgCount..<
                        declarationGenericCount:
                    let genericSymbolRow =
                        declarationGenericStart + genericOffset
                    let defaultTypeId = typedExprTypeArenaInt32At(value, value.genericSymbolDefaultTypeIds.offset, value.genericSymbolDefaultTypeIds.len, genericSymbolRow)
                    if defaultTypeId < 0 ||
                       defaultTypeId >= value.typeCount:
                        err = " typed expr type arena: trailing generic default receipt missing"
                        return false
                    var dependencyVisiting: bool[]
                    var dependencySeen: bool[]
                    setLen(dependencyVisiting, value.typeCount)
                    setLen(dependencySeen, value.typeCount)
                    var referencesGeneric = false
                    if !typedExprTypeArenaGenericDependenciesValidateInto(
                           value,
                           defaultTypeId,
                           declarationGenericStart,
                           declarationGenericCount,
                           genericSymbolRow,
                           dependencyVisiting,
                           dependencySeen,
                           referencesGeneric,
                           err):
                        return false
                    var prefixArgumentTypeIds: int32[]
                    setLen(prefixArgumentTypeIds,
                           declarationGenericCount)
                    for prefixOffset in 0..<declarationGenericCount:
                        prefixArgumentTypeIds[prefixOffset] = -1
                    for prefixOffset in 0..<genericOffset:
                        prefixArgumentTypeIds[prefixOffset] =
                            argumentTypeIds[prefixOffset]
                    var defaultMemo: int32[]
                    var defaultVisiting: bool[]
                    setLen(defaultMemo, value.typeCount)
                    setLen(defaultVisiting, value.typeCount)
                    for sourceTypeId in 0..<value.typeCount:
                        defaultMemo[sourceTypeId] = -1
                    if !typedExprTypeArenaSpecializationMatches(
                           value,
                           defaultTypeId,
                           argumentTypeIds[genericOffset],
                           declarationGenericStart,
                           declarationGenericCount,
                           prefixArgumentTypeIds,
                           defaultMemo,
                           defaultVisiting,
                           err):
                        err = " typed expr type arena: trailing generic default substitution receipt drift"
                        return false
                for genericOffset in 0..<declarationGenericCount:
                    let genericSymbolRow =
                        declarationGenericStart + genericOffset
                    let constraintTypeId = typedExprTypeArenaInt32At(value, value.genericSymbolConstraintTypeIds.offset, value.genericSymbolConstraintTypeIds.len, genericSymbolRow)
                    if constraintTypeId < 0:
                        continue
                    if constraintTypeId >= value.typeCount:
                        err = " typed expr type arena: generic constraint receipt invalid"
                        return false
                    var dependencyVisiting: bool[]
                    var dependencySeen: bool[]
                    setLen(dependencyVisiting, value.typeCount)
                    setLen(dependencySeen, value.typeCount)
                    var referencesGeneric = false
                    if !typedExprTypeArenaGenericDependenciesValidateInto(
                           value,
                           constraintTypeId,
                           declarationGenericStart,
                           declarationGenericCount,
                           declarationGenericStart +
                               declarationGenericCount,
                           dependencyVisiting,
                           dependencySeen,
                           referencesGeneric,
                           err):
                        return false
                    var constraintMemo: int32[]
                    var constraintVisiting: bool[]
                    setLen(constraintMemo, value.typeCount)
                    setLen(constraintVisiting, value.typeCount)
                    for sourceTypeId in 0..<value.typeCount:
                        constraintMemo[sourceTypeId] = -1
                    if !typedExprTypeArenaSpecializationMatches(
                           value,
                           constraintTypeId,
                           argumentTypeIds[genericOffset],
                           declarationGenericStart,
                           declarationGenericCount,
                           argumentTypeIds,
                           constraintMemo,
                           constraintVisiting,
                           err):
                        err = " typed expr type arena: generic constraint admission receipt drift"
                        return false
                var specializationMemo: int32[]
                var specializationVisiting: bool[]
                setLen(specializationMemo, value.typeCount)
                setLen(specializationVisiting, value.typeCount)
                for sourceTypeId in 0..<value.typeCount:
                    specializationMemo[sourceTypeId] = -1
                if !typedExprTypeArenaSpecializationMatches(
                       value,
                       typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, declarationRoot),
                       typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, semanticChildStart),
                       declarationGenericStart,
                       declarationGenericCount,
                       argumentTypeIds,
                       specializationMemo,
                       specializationVisiting,
                       err):
                    if err == "":
                        err = " typed expr type arena: generic specialization receipt drift"
                    return false
            elif semanticKind == Int32(TypedExprStructuralTypeApply):
                # [builtin-ctor] This arm is not a bypass: the head must be a
                # constructor of the closed table and the arity must be the
                # table's -- read from the table, never from the syntax --
                # and every bracket argument must be the exact TypeSyntax
                # child the producer keyed the application on.
                if parserKind != Int32(parser.ParserTypeSyntaxBracketApply):
                    err = " typed expr type arena: generic application origin invalid"
                    return false
                let builtinHeadChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, typeId)
                let builtinHeadTypeId = typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, builtinHeadChildStart)
                let builtinArity = typedExprTypeArenaBuiltinConstructorArity(
                    TypedExprStructuralScalarKind(
                        typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, builtinHeadTypeId)))
                let builtinApplyChildCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, typeId)
                if builtinArity <= 0 ||
                   builtinApplyChildCount != builtinArity + 1 ||
                   bracketArgCount != builtinArity:
                    err = Fmt" typed expr type arena: generic application origin invalid row={row} builtin_arity={builtinArity} bracket_args={bracketArgCount} apply_children={builtinApplyChildCount}"
                    return false
                for builtinArgOffset in 0..<builtinArity:
                    let builtinArgTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.bracketArgTypeSyntaxNodeIndexes.offset, value.bracketArgTypeSyntaxNodeIndexes.len, bracketArgStart + builtinArgOffset)
                    if builtinArgTypeSyntaxNode < 0 ||
                       typedExprTypeArenaSyntaxChildAt(
                           value, row, builtinArgOffset + 1) !=
                           builtinArgTypeSyntaxNode ||
                       typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, builtinArgTypeSyntaxNode) !=
                           typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, builtinHeadChildStart + builtinArgOffset + 1):
                        err = Fmt" typed expr type arena: generic application origin invalid row={row} builtin_arg={builtinArgOffset} builtin_arity={builtinArity}"
                        return false
            elif semanticKind == Int32(TypedExprStructuralTypeFixedArray):
                let semanticChildStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, typeId)
                if typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, semanticChildStart) !=
                       typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, bracketBaseTypeSyntaxNodeIndex):
                    err = " typed expr type arena: fixed array base TypeId drift"
                    return false
                for argOffset in 0..<bracketArgCount:
                    if typedExprTypeArenaInt32At(value, value.bracketArgTypeSyntaxNodeIndexes.offset, value.bracketArgTypeSyntaxNodeIndexes.len, bracketArgStart + argOffset) != -1:
                        err = " typed expr type arena: const and type authority ambiguous"
                        return false
            else:
                err = " typed expr type arena: bracket semantic kind invalid"
                return false
        scratch.bracketArgCursor = scratch.bracketArgCursor + bracketArgCount
        for symbolOffset in 0..<genericCount:
            let symbolRow = genericStart + symbolOffset
            if typedExprTypeArenaInt32At(value, value.genericSymbolProducerSourceIndexes.offset, value.genericSymbolProducerSourceIndexes.len, symbolRow) != producerSourceIndex ||
               typedExprTypeArenaInt32At(value, value.genericSymbolDeclarationOwnerTokenIndexes.offset, value.genericSymbolDeclarationOwnerTokenIndexes.len, symbolRow) != declarationOwnerToken ||
               typedExprTypeArenaInt32At(value, value.genericSymbolOrdinals.offset, value.genericSymbolOrdinals.len, symbolRow) != symbolOffset:
                err = " typed expr type arena: generic origin CSR invalid"
                return false
            scratch.genericReferenced[symbolRow] = true
        row = row + 1

@borrows
fn TypedExprTypeArenaStrictValidateInto(
        value: TypedExprTypeArena,
        err: var str): bool =
    if value == nil || !value.complete || value.arena.capacityBytes <= 0 ||
       value.internPool == nil || value.producerSourceCount <= 0 ||
       value.tokenCount < 0 || value.typeSyntaxCount < 0 ||
       value.genericSymbolCount < 0 ||
       value.genericSymbolChildCount < 0 ||
       value.bracketArgCount < 0 ||
       value.typeCount < 0 || value.symbolCount < 0 ||
       value.memberCount < 0 || value.resolutionCount < 0 ||
       value.genericResolutionCount < 0 ||
       value.nominalDependencyCount < 0 ||
       value.symbolDependencyCount < 0 || value.sccCount < 0 ||
       value.tokenProducerSourceIndexes.len != value.tokenCount ||
       value.tokenKinds.len != value.tokenCount ||
       value.tokenSpanStarts.len != value.tokenCount ||
       value.tokenSpanEnds.len != value.tokenCount ||
       value.typeSyntaxTypeIds.len != value.typeSyntaxCount ||
       value.typeSyntaxParserKinds.len != value.typeSyntaxCount ||
       value.typeSyntaxProducerSourceIndexes.len != value.typeSyntaxCount ||
       value.typeSyntaxSourceLocalRows.len != value.typeSyntaxCount ||
       value.typeSyntaxSpanStarts.len != value.typeSyntaxCount ||
       value.typeSyntaxSpanEnds.len != value.typeSyntaxCount ||
       value.typeSyntaxOwnerTokenIndexes.len != value.typeSyntaxCount ||
       value.typeSyntaxQuestionTokenIndexes.len != value.typeSyntaxCount ||
       value.typeSyntaxDeclarationOwnerTokenIndexes.len !=
           value.typeSyntaxCount ||
       value.typeSyntaxDeclarationOwnerNodeIndexes.len !=
           value.typeSyntaxCount ||
       value.typeSyntaxGenericSymbolStarts.len != value.typeSyntaxCount ||
       value.typeSyntaxGenericSymbolCounts.len != value.typeSyntaxCount ||
       value.typeSyntaxRootKinds.len != value.typeSyntaxCount ||
       value.typeSyntaxBracketArgStarts.len != value.typeSyntaxCount ||
       value.typeSyntaxBracketArgCounts.len != value.typeSyntaxCount ||
       value.typeSyntaxBracketBaseTypeSyntaxNodeIndexes.len !=
           value.typeSyntaxCount ||
       value.typeSyntaxChildStarts.len != value.typeSyntaxCount ||
       value.typeSyntaxChildCounts.len != value.typeSyntaxCount ||
       value.typeSyntaxEnumVariantStarts.len != value.typeSyntaxCount ||
       value.typeSyntaxEnumVariantCounts.len != value.typeSyntaxCount ||
       value.typeSyntaxFixedLengthsByRow.len != value.typeSyntaxCount ||
       value.typeSyntaxFunctionParamCountsByRow.len !=
           value.typeSyntaxCount ||
       value.typeSyntaxChildNameIdsByRow.len !=
           value.typeSyntaxChildTypeSyntaxNodeIndexes.len ||
       value.typeSyntaxOwnerTokenTexts.len != value.typeSyntaxCount ||
       value.typeSyntaxNameTokenTexts.len != value.typeSyntaxCount ||
       value.typeSyntaxDeclarationOwnerTokenTexts.len !=
           value.typeSyntaxCount ||
       value.typeSyntaxEnumVariantPayloadTypeSyntaxNodeIndexes.len !=
           value.typeSyntaxEnumVariantOrdinals.len ||
       value.typeSyntaxEnumVariantNameTokenIndexes.len !=
           value.typeSyntaxEnumVariantOrdinals.len ||
       value.typeSyntaxEnumVariantProducerSourceIndexes.len !=
           value.typeSyntaxEnumVariantOrdinals.len ||
       value.typeSyntaxEnumVariantDeclarationOwnerNodeIndexes.len !=
           value.typeSyntaxEnumVariantOrdinals.len ||
       value.typeSyntaxEnumVariantDeclarationOwnerTokenIndexes.len !=
           value.typeSyntaxEnumVariantOrdinals.len ||
       value.typeSyntaxEnumVariantNameTokenTexts.len !=
           value.typeSyntaxEnumVariantOrdinals.len ||
       value.functionSourceStarts.len != value.producerSourceCount ||
       value.functionSourceCounts.len != value.producerSourceCount ||
       value.functionProducerSourceIndexes.len != value.functionCount ||
       value.functionSourceLocalRows.len != value.functionCount ||
       value.functionDeclarationSourceLocalRows.len !=
           value.functionCount ||
       value.functionOwnerTokenIndexes.len != value.functionCount ||
       value.functionReturnTypeIds.len != value.functionCount ||
       value.bracketArgTokenStarts.len != value.bracketArgCount ||
       value.bracketArgTokenCounts.len != value.bracketArgCount ||
       value.bracketArgTypeSyntaxNodeIndexes.len != value.bracketArgCount ||
       value.genericSymbolProducerSourceIndexes.len !=
           value.genericSymbolCount ||
       value.genericSymbolDeclarationOwnerTokenIndexes.len !=
           value.genericSymbolCount ||
       value.genericSymbolNameTokenIndexes.len != value.genericSymbolCount ||
       value.genericSymbolNameIds.len != value.genericSymbolCount ||
       value.genericSymbolOrdinals.len != value.genericSymbolCount ||
       value.genericSymbolSpanStarts.len != value.genericSymbolCount ||
       value.genericSymbolSpanEnds.len != value.genericSymbolCount ||
       value.genericSymbolOwnerTypeSyntaxNodeIndexes.len !=
           value.genericSymbolCount ||
       value.genericSymbolConstraintTypeSyntaxNodeIndexes.len !=
           value.genericSymbolCount ||
       value.genericSymbolDefaultTypeSyntaxNodeIndexes.len !=
           value.genericSymbolCount ||
       value.genericSymbolConstraintTypeIds.len !=
           value.genericSymbolCount ||
       value.genericSymbolDefaultTypeIds.len !=
           value.genericSymbolCount ||
       value.genericSymbolChildStarts.len != value.genericSymbolCount ||
       value.genericSymbolChildCounts.len != value.genericSymbolCount ||
       value.genericSymbolChildTypeSyntaxNodeIndexes.len !=
           value.genericSymbolChildCount ||
       value.genericSymbolChildTypeIds.len !=
           value.genericSymbolChildCount ||
       value.typeKinds.len != value.typeCount ||
       value.scalarKinds.len != value.typeCount ||
       value.symbolIds.len != value.typeCount ||
       value.genericSymbolIds.len != value.typeCount ||
       value.fixedLengths.len != value.typeCount ||
       value.functionParamCounts.len != value.typeCount ||
       value.baseTypeSyntaxNodeIndexes.len != value.typeCount ||
       value.baseTypeIds.len != value.typeCount ||
       value.childStarts.len != value.typeCount ||
       value.childCounts.len != value.typeCount ||
       value.childTypeIds.len != value.childNameIds.len ||
       value.traitRuleKinds.len != value.typeCount ||
       value.traitPremiseStarts.len != value.typeCount ||
       value.traitPremiseCounts.len != value.typeCount ||
       value.managedFlags.len != value.typeCount ||
       value.sendFlags.len != value.typeCount ||
       value.syncFlags.len != value.typeCount ||
       value.typeOriginKinds.len != value.typeCount ||
       value.originTypeSyntaxNodeIndexes.len != value.typeCount ||
       value.originProducerSourceIndexes.len != value.typeCount ||
       value.symbolDeclarationRootTypeSyntaxNodeIndexes.len !=
           value.symbolCount ||
       value.symbolProducerSourceIndexes.len != value.symbolCount ||
       value.symbolDeclarationOwnerTokenIndexes.len != value.symbolCount ||
       value.symbolNameIds.len != value.symbolCount ||
       value.symbolMemberStarts.len != value.symbolCount ||
       value.symbolMemberCounts.len != value.symbolCount ||
       value.memberProducerSourceIndexes.len != value.memberCount ||
       value.memberDeclarationSymbolIds.len != value.memberCount ||
       value.memberNameTokenIndexes.len != value.memberCount ||
       value.memberNameIds.len != value.memberCount ||
       value.memberOrdinals.len != value.memberCount ||
       value.memberTypeSyntaxNodeIndexes.len != value.memberCount ||
       value.memberTypeIds.len != value.memberCount ||
       value.typeSyntaxParentNodeIndexes.len != value.typeSyntaxCount ||
       value.typeSyntaxEnclosingSymbolIds.len != value.typeSyntaxCount ||
       value.resolutionTypeSyntaxNodeIndexes.len != value.resolutionCount ||
       value.resolutionTargetSymbolIds.len != value.resolutionCount ||
       value.genericResolutionTypeSyntaxNodeIndexes.len !=
           value.genericResolutionCount ||
       value.genericResolutionTargetGenericSymbolRows.len !=
           value.genericResolutionCount ||
       value.nominalDependencyTypeSyntaxNodeIndexes.len !=
           value.nominalDependencyCount ||
       value.nominalDependencySourceSymbolIds.len !=
           value.nominalDependencyCount ||
       value.nominalDependencyTargetSymbolIds.len !=
           value.nominalDependencyCount ||
       value.nominalDependencyIndirectFlags.len !=
           value.nominalDependencyCount ||
       value.symbolDependencyStarts.len != value.symbolCount ||
       value.symbolDependencyCounts.len != value.symbolCount ||
       value.symbolDependencyTargetSymbolIds.len !=
           value.symbolDependencyCount ||
       value.symbolDependencyDirectFlags.len !=
           value.symbolDependencyCount ||
       value.symbolSccIds.len != value.symbolCount ||
       value.sccStarts.len != value.sccCount ||
       value.sccCounts.len != value.sccCount ||
       value.sccSymbolIds.len != value.symbolCount:
        err = " typed expr type arena: column shape mismatch"
        return false
    # [S1b-1a] Seal-phase parser facts.  Row-aligned columns must cover every
    # TypeSyntax row, and the variant-family columns must agree with each
    # other because they are appended one row per enum variant.  The child CSR
    # payload has no scalar total on this object, so it is reconciled against
    # the sum of typeSyntaxChildCounts below.  These checks land in the same
    # round as the columns' first real consumer; adding them earlier would have
    # rejected any arena not built through FillTypeSyntax, which is a
    # behaviour change rather than a pure add.
    #
    # NOTE: this comment sits AFTER the condition chain on purpose.  Cheng does
    # not accept a comment line between `||` and the next operand -- doing so
    # yields `expected : after condition` and then misreports the whole
    # function as `reachable function body missing`.  Do not move it back in.
    var typeSyntaxChildTotal: int32
    for childRow in 0..<value.typeSyntaxCount:
        let childRowCount = typedExprTypeArenaInt32At(
            value,
            value.typeSyntaxChildCounts.offset,
            value.typeSyntaxChildCounts.len,
            childRow)
        if childRowCount < 0:
            err = " typed expr type arena: TypeSyntax child count invalid"
            return false
        typeSyntaxChildTotal = typeSyntaxChildTotal + childRowCount
    if typeSyntaxChildTotal != value.typeSyntaxChildTypeSyntaxNodeIndexes.len:
        err = Fmt" typed expr type arena: TypeSyntax child CSR payload mismatch counts={typeSyntaxChildTotal} payload={value.typeSyntaxChildTypeSyntaxNodeIndexes.len}"
        return false
    var functionCursor: int32
    for producerSourceIndex in 0..<value.producerSourceCount:
        let functionStart = typedExprTypeArenaInt32At(value, value.functionSourceStarts.offset, value.functionSourceStarts.len, producerSourceIndex)
        let functionCount = typedExprTypeArenaInt32At(value, value.functionSourceCounts.offset, value.functionSourceCounts.len, producerSourceIndex)
        if functionStart != functionCursor || functionCount < 0 ||
           functionStart + functionCount > value.functionCount:
            err = " typed expr type arena: function source CSR invalid"
            return false
        for sourceLocalFunctionRow in 0..<functionCount:
            let functionRow =
                functionStart + sourceLocalFunctionRow
            let declarationSourceLocalRow =
                typedExprTypeArenaInt32At(value, value.functionDeclarationSourceLocalRows.offset, value.functionDeclarationSourceLocalRows.len, functionRow)
            let ownerToken = typedExprTypeArenaInt32At(value, value.functionOwnerTokenIndexes.offset, value.functionOwnerTokenIndexes.len, functionRow)
            let returnTypeId = typedExprTypeArenaInt32At(value, value.functionReturnTypeIds.offset, value.functionReturnTypeIds.len, functionRow)
            if typedExprTypeArenaInt32At(value, value.functionProducerSourceIndexes.offset, value.functionProducerSourceIndexes.len, functionRow) != producerSourceIndex ||
               typedExprTypeArenaInt32At(value, value.functionSourceLocalRows.offset, value.functionSourceLocalRows.len, functionRow) != sourceLocalFunctionRow ||
               declarationSourceLocalRow < 0 ||
               ownerToken < 0 || ownerToken >= value.tokenCount ||
               typedExprTypeArenaInt32At(value, value.tokenProducerSourceIndexes.offset, value.tokenProducerSourceIndexes.len, ownerToken) != producerSourceIndex ||
               returnTypeId < 0 || returnTypeId >= value.typeCount:
                err = " typed expr type arena: function signature row invalid"
                return false
        functionCursor = functionCursor + functionCount
    if functionCursor != value.functionCount:
        err = " typed expr type arena: function source coverage incomplete"
        return false
    for tokenIndex in 0..<value.tokenCount:
        let producerSourceIndex = typedExprTypeArenaInt32At(value, value.tokenProducerSourceIndexes.offset, value.tokenProducerSourceIndexes.len, tokenIndex)
        let tokenKind = typedExprTypeArenaInt32At(value, value.tokenKinds.offset, value.tokenKinds.len, tokenIndex)
        let spanStart = typedExprTypeArenaInt32At(value, value.tokenSpanStarts.offset, value.tokenSpanStarts.len, tokenIndex)
        let spanEnd = typedExprTypeArenaInt32At(value, value.tokenSpanEnds.offset, value.tokenSpanEnds.len, tokenIndex)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= value.producerSourceCount ||
           tokenKind <= Int32(parser.ParserValueTokenInvalid) ||
           tokenKind > Int32(parser.ParserValueTokenRangeExclusive) ||
           spanStart < 0 || spanEnd <= spanStart:
            err = " typed expr type arena: parser token authority drift"
            return false
    var genericNameIds: int32[]
    var genericNames: str[]
    var childNameIds: int32[]
    var childNames: str[]
    var symbolNameIds: int32[]
    var symbolNames: str[]
    var memberNameIds: int32[]
    var memberNames: str[]
    setLen(genericNameIds, value.genericSymbolNameIds.len)
    setLen(genericNames, value.genericSymbolNameIds.len)
    setLen(childNameIds, value.childNameIds.len)
    setLen(childNames, value.childNameIds.len)
    setLen(symbolNameIds, value.symbolNameIds.len)
    setLen(symbolNames, value.symbolNameIds.len)
    setLen(memberNameIds, value.memberNameIds.len)
    setLen(memberNames, value.memberNameIds.len)
    for row in 0..<genericNameIds.len:
        genericNameIds[row] = typedExprTypeArenaInt32At(value, value.genericSymbolNameIds.offset, value.genericSymbolNameIds.len, row)
    for row in 0..<childNameIds.len:
        childNameIds[row] = typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, row)
    for row in 0..<symbolNameIds.len:
        symbolNameIds[row] = typedExprTypeArenaInt32At(value, value.symbolNameIds.offset, value.symbolNameIds.len, row)
    for row in 0..<memberNameIds.len:
        memberNameIds[row] = typedExprTypeArenaInt32At(value, value.memberNameIds.offset, value.memberNameIds.len, row)
    for row in 0..<genericNameIds.len:
        let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
            value.internPool, genericNameIds[row])
        if !IsOk(nameResult) || Value(nameResult) == "":
            err = " typed expr type arena: generic name authority missing"
            return false
        genericNames[row] = Value(nameResult)
    for row in 0..<childNameIds.len:
        let nameId = childNameIds[row]
        if nameId < -1:
            err = " typed expr type arena: child name authority id invalid"
            return false
        if nameId >= 0:
            let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
                value.internPool, nameId)
            if !IsOk(nameResult) || Value(nameResult) == "":
                err = " typed expr type arena: child name authority missing"
                return false
            childNames[row] = Value(nameResult)
    for row in 0..<symbolNameIds.len:
        let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
            value.internPool, symbolNameIds[row])
        if !IsOk(nameResult) || Value(nameResult) == "":
            err = " typed expr type arena: symbol name authority missing"
            return false
        symbolNames[row] = Value(nameResult)
    for row in 0..<memberNameIds.len:
        let nameResult: Result[str] = typedExprTypeArenaLookupIntern(
            value.internPool, memberNameIds[row])
        if !IsOk(nameResult) || Value(nameResult) == "":
            err = " typed expr type arena: member name authority missing"
            return false
        memberNames[row] = Value(nameResult)
    if value.internPool == nil:
        err = " typed expr type arena: intern pool ownership lost"
        return false
    let recomputedArtifactRaw32 = typedExprTypeArenaHashMaterialized(
        value, genericNames, childNameIds, childNames,
        symbolNames, memberNames)
    var symbolByDeclarationRoot: int32[]
    setLen(symbolByDeclarationRoot, value.typeSyntaxCount)
    for row in 0..<symbolByDeclarationRoot.len:
        symbolByDeclarationRoot[row] = -1
    for symbolId in 0..<value.symbolCount:
        let root = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
        if root < 0 || root >= value.typeSyntaxCount ||
           symbolByDeclarationRoot[root] >= 0:
            err = " typed expr type arena: declaration root SymbolId map invalid"
            return false
        symbolByDeclarationRoot[root] = symbolId
    for row in 0..<value.typeSyntaxCount:
        let rootKind = typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, row)
        let parserKind = typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, row)
        let aggregateField =
            rootKind ==
                Int32(parser.ParserTypeSyntaxRootFieldDeclaration) &&
            (parserKind == Int32(parser.ParserTypeSyntaxObject) ||
             parserKind == Int32(parser.ParserTypeSyntaxRefObject))
        let expectedSymbol =
            rootKind ==
                Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) ||
            aggregateField
        if expectedSymbol != (symbolByDeclarationRoot[row] >= 0):
            err = " typed expr type arena: declaration SymbolId coverage drift"
            return false
    for reverseOffset in 0..<value.typeSyntaxCount:
        let row = value.typeSyntaxCount - reverseOffset - 1
        let parent = typedExprTypeArenaInt32At(value, value.typeSyntaxParentNodeIndexes.offset, value.typeSyntaxParentNodeIndexes.len, row)
        let enclosing = typedExprTypeArenaInt32At(value, value.typeSyntaxEnclosingSymbolIds.offset, value.typeSyntaxEnclosingSymbolIds.len, row)
        let source = typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, row)
        let rootKind = typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, row)
        let declarationOwner = typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, row)
        var expectedEnclosing: int32 = -1
        if parent >= 0:
            if parent <= row || parent >= value.typeSyntaxCount ||
               rootKind != Int32(parser.ParserTypeSyntaxRootInvalid) ||
               declarationOwner != -1 ||
               typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, parent) != source:
                err = " typed expr type arena: TypeSyntax parent receipt invalid"
                return false
            expectedEnclosing = typedExprTypeArenaInt32At(value, value.typeSyntaxEnclosingSymbolIds.offset, value.typeSyntaxEnclosingSymbolIds.len, parent)
        elif symbolByDeclarationRoot[row] >= 0:
            expectedEnclosing = symbolByDeclarationRoot[row]
        elif rootKind ==
                 Int32(parser.ParserTypeSyntaxRootFieldDeclaration):
            if declarationOwner < 0 ||
               declarationOwner >= value.typeSyntaxCount:
                err = " typed expr type arena: field enclosing receipt invalid"
                return false
            expectedEnclosing = symbolByDeclarationRoot[declarationOwner]
        elif rootKind == Int32(parser.ParserTypeSyntaxRootInvalid):
            err = " typed expr type arena: detached nested TypeSyntax receipt"
            return false
        if enclosing != expectedEnclosing ||
           enclosing < -1 || enclosing >= value.symbolCount:
            err = " typed expr type arena: enclosing SymbolId receipt drift"
            return false
    var resolutionSymbolByTypeSyntax: int32[]
    setLen(resolutionSymbolByTypeSyntax, value.typeSyntaxCount)
    for row in 0..<resolutionSymbolByTypeSyntax.len:
        resolutionSymbolByTypeSyntax[row] = -1
    for resolutionRow in 0..<value.resolutionCount:
        let typeSyntaxNodeIndex = typedExprTypeArenaInt32At(value, value.resolutionTypeSyntaxNodeIndexes.offset, value.resolutionTypeSyntaxNodeIndexes.len, resolutionRow)
        let symbolId = typedExprTypeArenaInt32At(value, value.resolutionTargetSymbolIds.offset, value.resolutionTargetSymbolIds.len, resolutionRow)
        if typeSyntaxNodeIndex < 0 ||
           typeSyntaxNodeIndex >= value.typeSyntaxCount ||
           symbolId < 0 || symbolId >= value.symbolCount ||
           (resolutionRow > 0 &&
            typedExprTypeArenaInt32At(value, value.resolutionTypeSyntaxNodeIndexes.offset, value.resolutionTypeSyntaxNodeIndexes.len, resolutionRow - 1) >= typeSyntaxNodeIndex):
            err = " typed expr type arena: resolution receipt row invalid"
            return false
        resolutionSymbolByTypeSyntax[typeSyntaxNodeIndex] = symbolId
    var genericResolutionByTypeSyntax: int32[]
    setLen(genericResolutionByTypeSyntax, value.typeSyntaxCount)
    for row in 0..<genericResolutionByTypeSyntax.len:
        genericResolutionByTypeSyntax[row] = -1
    for resolutionRow in 0..<value.genericResolutionCount:
        let typeSyntaxNodeIndex = typedExprTypeArenaInt32At(value, value.genericResolutionTypeSyntaxNodeIndexes.offset, value.genericResolutionTypeSyntaxNodeIndexes.len, resolutionRow)
