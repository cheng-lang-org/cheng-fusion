# [c2-replay-cols] The three per-row parser facts the forward replay reads.
# All three are materialised for every TypeSyntax row while the tree is still
# resident (`typedExprTypeArenaFillTypeSyntax` plus the two tuple-intern
# sites), so the replay pass reads columns and no source is ever re-parsed.
@borrows
fn typedExprTypeArenaSyntaxFixedLengthRowAt(
        value: TypedExprTypeArena,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        value.arena, value.typeSyntaxFixedLengthsByRow, row)

