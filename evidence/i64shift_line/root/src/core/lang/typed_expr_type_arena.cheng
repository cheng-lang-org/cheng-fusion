        if managed < 0 || managed > 1 || send < 0 || send > 1 ||
           sync < 0 || sync > 1:
            err = " typed expr type arena: trait flag invalid"
            return false
        var expectedRule = TypedExprTypeTraitRuleInvalid
        var expectedManaged: int32
        var expectedSend: int32
        var expectedSync: int32
        if kind == TypedExprStructuralTypeScalar:
            if scalarKind == TypedExprStructuralScalarStr:
                expectedRule = TypedExprTypeTraitRuleManagedString
                expectedManaged = 1
            else:
                expectedRule = TypedExprTypeTraitRulePlainScalar
                # [trait-mirror] This projection is the FOURTH copy of the
                # rule, and it used to enumerate only `cstring` as an
                # exception: every `ptr` and every `typedesc` scalar row
                # therefore drifted by one bit against the producer and
                # died here as `trait rule or premise drift`.  It reads
                # the one predicate now, like the other three sites.
                if typedExprTypeArenaScalarSendable(scalarKind):
                    expectedSend = 1
                    expectedSync = 1
        elif kind == TypedExprStructuralTypeBorrow:
            expectedRule = TypedExprTypeTraitRuleBorrowedView
        elif kind == TypedExprStructuralTypeSequence:
            expectedRule = TypedExprTypeTraitRuleLocalSequence
            expectedManaged = 1
        elif kind == TypedExprStructuralTypeFixedArray ||
             kind == TypedExprStructuralTypeAlias ||
             kind == TypedExprStructuralTypeOptional:
            if kind == TypedExprStructuralTypeFixedArray:
                expectedRule = TypedExprTypeTraitRuleFixedArrayRecursive
            elif kind == TypedExprStructuralTypeAlias:
                expectedRule = TypedExprTypeTraitRuleAliasForward
            else:
                expectedRule = TypedExprTypeTraitRuleOptionalRecursive
            let child = typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart)
            expectedManaged = typedExprTypeArenaInt32At(value, value.managedFlags.offset, value.managedFlags.len, child)
            expectedSend = typedExprTypeArenaInt32At(value, value.sendFlags.offset, value.sendFlags.len, child)
            expectedSync = typedExprTypeArenaInt32At(value, value.syncFlags.offset, value.syncFlags.len, child)
        elif kind == TypedExprStructuralTypeApply:
            expectedRule = TypedExprTypeTraitRuleGenericApplication
            let declarationType = typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart)
            expectedManaged = typedExprTypeArenaInt32At(value, value.managedFlags.offset, value.managedFlags.len, declarationType)
            expectedSend = typedExprTypeArenaInt32At(value, value.sendFlags.offset, value.sendFlags.len, declarationType)
            expectedSync = typedExprTypeArenaInt32At(value, value.syncFlags.offset, value.syncFlags.len, declarationType)
        elif kind == TypedExprStructuralTypeTuple:
            expectedRule = TypedExprTypeTraitRuleTupleRecursive
            expectedSend = 1
            expectedSync = 1
            for childOffset in 0..<childCount:
                let child = typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart + childOffset)
                if typedExprTypeArenaInt32At(value, value.managedFlags.offset, value.managedFlags.len, child) != 0:
                    expectedManaged = 1
                if typedExprTypeArenaInt32At(value, value.sendFlags.offset, value.sendFlags.len, child) == 0:
                    expectedSend = 0
                if typedExprTypeArenaInt32At(value, value.syncFlags.offset, value.syncFlags.len, child) == 0:
                    expectedSync = 0
        elif kind == TypedExprStructuralTypeFunction:
            expectedRule = TypedExprTypeTraitRuleFunctionValue
            expectedSend = 1
            expectedSync = 1
        elif kind == TypedExprStructuralTypeObject ||
             kind == TypedExprStructuralTypeEnum:
            expectedRule = kind == TypedExprStructuralTypeObject ?
                TypedExprTypeTraitRuleObjectFieldsRecursive :
                TypedExprTypeTraitRuleEnumVariantsRecursive
            expectedSend = 1
            expectedSync = 1
            let aggregateStart =
                kind == TypedExprStructuralTypeObject ?
                    premiseStart :
                    childStart
            let aggregateCount =
                kind == TypedExprStructuralTypeObject ?
                    premiseCount :
                    childCount
            for childOffset in 0..<aggregateCount:
                var child: int32
                if kind == TypedExprStructuralTypeObject:
                    child = typedExprTypeArenaInt32At(
                        value,
                        value.traitPremiseTypeIds.offset,
                        value.traitPremiseTypeIds.len,
                        aggregateStart + childOffset)
                else:
                    child = typedExprTypeArenaInt32At(
                        value,
                        value.childTypeIds.offset,
                        value.childTypeIds.len,
                        aggregateStart + childOffset)
                if typedExprTypeArenaInt32At(value, value.managedFlags.offset, value.managedFlags.len, child) != 0:
                    expectedManaged = 1
                if typedExprTypeArenaInt32At(value, value.sendFlags.offset, value.sendFlags.len, child) == 0:
                    expectedSend = 0
                if typedExprTypeArenaInt32At(value, value.syncFlags.offset, value.syncFlags.len, child) == 0:
                    expectedSync = 0
        elif kind == TypedExprStructuralTypeRefObject:
            expectedRule = TypedExprTypeTraitRuleOwnedRefObject
            expectedManaged = 1
        elif kind == TypedExprStructuralTypeGenericParameter:
            expectedRule = TypedExprTypeTraitRuleGenericParameter
            expectedManaged = 1
        if rule != expectedRule || managed != expectedManaged ||
           send != expectedSend || sync != expectedSync ||
           managed != derivedManaged[typeId] ||
           send != derivedSend[typeId] || sync != derivedSync[typeId]:
            err = " typed expr type arena: trait rule or premise drift"
            return false
        childCursor = childCursor + childCount
        premiseCursor = premiseCursor + premiseCount
    if childCursor != value.childTypeIds.len ||
       premiseCursor != value.traitPremiseTypeIds.len:
        err = " typed expr type arena: CSR coverage mismatch"
        return false
    var memberCursor: int32
    for symbolId in 0..<value.symbolCount:
        let root = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
        let producerSourceIndex = typedExprTypeArenaInt32At(value, value.symbolProducerSourceIndexes.offset, value.symbolProducerSourceIndexes.len, symbolId)
        let ownerToken = typedExprTypeArenaInt32At(value, value.symbolDeclarationOwnerTokenIndexes.offset, value.symbolDeclarationOwnerTokenIndexes.len, symbolId)
        let memberStart = typedExprTypeArenaInt32At(value, value.symbolMemberStarts.offset, value.symbolMemberStarts.len, symbolId)
        let memberCount = typedExprTypeArenaInt32At(value, value.symbolMemberCounts.offset, value.symbolMemberCounts.len, symbolId)
        let rootKind = root >= 0 && root < value.typeSyntaxCount ?
            typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, root) :
            Int32(parser.ParserTypeSyntaxRootInvalid)
        let parserKind = root >= 0 && root < value.typeSyntaxCount ?
            typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, root) :
            Int32(parser.ParserTypeSyntaxInvalid)
        let topLevelDeclaration =
            rootKind ==
                Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs)
        let nestedAggregateDeclaration =
            rootKind ==
                Int32(parser.ParserTypeSyntaxRootFieldDeclaration) &&
            (parserKind == Int32(parser.ParserTypeSyntaxObject) ||
             parserKind == Int32(parser.ParserTypeSyntaxRefObject))
        var expectedSymbolNameToken: int32 = -1
        if root >= 0 && root < value.typeSyntaxCount:
            expectedSymbolNameToken =
                nestedAggregateDeclaration ?
                    typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, root) :
                    typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, root)
        if root < 0 || root >= value.typeSyntaxCount ||
           producerSourceIndex < 0 ||
           producerSourceIndex >= value.producerSourceCount ||
           ownerToken < 0 || ownerToken >= value.tokenCount ||
           (!topLevelDeclaration && !nestedAggregateDeclaration) ||
           (topLevelDeclaration &&
            typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, root) != root) ||
           (nestedAggregateDeclaration &&
            (typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, root) < 0 ||
             typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, root) >= root)) ||
           expectedSymbolNameToken != ownerToken ||
           typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, root) != producerSourceIndex ||
           typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, root)) != symbolId:
            err = " typed expr type arena: SymbolId row invalid"
            return false
        if memberStart != memberCursor || memberCount < 0 ||
           memberStart + memberCount > value.memberCount:
            err = " typed expr type arena: declaration member CSR invalid"
            return false
        let rootTypeId = typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, root)
        let structuralKind = typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, rootTypeId)
        let objectDeclaration =
            parserKind == Int32(parser.ParserTypeSyntaxObject) ||
            parserKind == Int32(parser.ParserTypeSyntaxImplicitObject) ||
            parserKind == Int32(parser.ParserTypeSyntaxRefObject)
        let enumDeclaration =
            parserKind == Int32(parser.ParserTypeSyntaxEnum)
        # [phaseB-parser] `type N = tuple[a: T, ...]` 的 alias 声明根持有
        # 具名元素 member 行（与 object member 同一精确边契约；type 行子
        # 耦合不适用——alias type 行的子是 tuple 行本身）。
        let aliasDeclaration =
            parserKind == Int32(parser.ParserTypeSyntaxAlias)
        let expectedObjectKind =
            parserKind == Int32(parser.ParserTypeSyntaxRefObject) ?
                Int32(TypedExprStructuralTypeRefObject) :
                Int32(TypedExprStructuralTypeObject)
        if objectDeclaration:
            let childStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, rootTypeId)
            let objectBaseTypeSyntaxNodeIndex =
                typedExprTypeArenaInt32At(value, value.baseTypeSyntaxNodeIndexes.offset, value.baseTypeSyntaxNodeIndexes.len, rootTypeId)
            let objectBaseTypeId = typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, rootTypeId)
            let expectedBaseChildCount =
                objectBaseTypeId >= 0 ? 1 : 0
            if structuralKind != expectedObjectKind ||
               typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, rootTypeId) != memberCount ||
               scratch.originChildCounts[root] != expectedBaseChildCount ||
               (expectedBaseChildCount == 1 &&
                scratch.firstOriginChild[root] != objectBaseTypeSyntaxNodeIndex) ||
               (parserKind ==
                    Int32(parser.ParserTypeSyntaxImplicitObject) &&
                expectedBaseChildCount != 0):
                err = " typed expr type arena: object member shape drift"
                return false
            var nameSlots: int32[]
            var slotCount: int32 = 8
            while slotCount < memberCount * 2:
                slotCount = slotCount * 2
            setLen(nameSlots, slotCount)
            for slot in 0..<nameSlots.len:
                nameSlots[slot] = -1
            for memberOffset in 0..<memberCount:
                let memberRow = memberStart + memberOffset
                let memberNameToken = typedExprTypeArenaInt32At(value, value.memberNameTokenIndexes.offset, value.memberNameTokenIndexes.len, memberRow)
                let memberNameId = typedExprTypeArenaInt32At(value, value.memberNameIds.offset, value.memberNameIds.len, memberRow)
                let memberTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.memberTypeSyntaxNodeIndexes.offset, value.memberTypeSyntaxNodeIndexes.len, memberRow)
                let memberTypeId = typedExprTypeArenaInt32At(value, value.memberTypeIds.offset, value.memberTypeIds.len, memberRow)
                if typedExprTypeArenaInt32At(value, value.memberProducerSourceIndexes.offset, value.memberProducerSourceIndexes.len, memberRow) != producerSourceIndex ||
                   typedExprTypeArenaInt32At(value, value.memberDeclarationSymbolIds.offset, value.memberDeclarationSymbolIds.len, memberRow) != symbolId ||
                   memberNameToken < 0 || memberNameToken >= value.tokenCount ||
                   typedExprTypeArenaInt32At(value, value.memberOrdinals.offset, value.memberOrdinals.len, memberRow) !=
                       memberOffset ||
                   memberTypeSyntaxNode < 0 ||
                   memberTypeSyntaxNode >= value.typeSyntaxCount ||
                   memberTypeId < 0 || memberTypeId >= value.typeCount ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, memberTypeSyntaxNode) !=
                       Int32(parser.ParserTypeSyntaxRootFieldDeclaration) ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, memberTypeSyntaxNode) != root ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, memberTypeSyntaxNode) !=
                       typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, root) ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, memberTypeSyntaxNode) != memberNameToken ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, memberTypeSyntaxNode) != producerSourceIndex ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, memberTypeSyntaxNode) != memberTypeId ||
                   typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart + memberOffset) != memberTypeId ||
                   typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, childStart + memberOffset) != memberNameId:
                    err = " typed expr type arena: object member authority drift"
                    return false
                var nameSlot = memberNameId % nameSlots.len
                while nameSlots[nameSlot] >= 0 &&
                      nameSlots[nameSlot] != memberNameId:
                    nameSlot = (nameSlot + 1) % nameSlots.len
                if nameSlots[nameSlot] == memberNameId:
                    err = " typed expr type arena: duplicate member name"
                    return false
                nameSlots[nameSlot] = memberNameId
        elif enumDeclaration:
            let childStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, rootTypeId)
            let childCount = typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, rootTypeId)
            if structuralKind != Int32(TypedExprStructuralTypeEnum) ||
               memberCount <= 0:
                err = " typed expr type arena: enum member shape drift"
                return false
            var nameSlots: int32[]
            var slotCount: int32 = 8
            while slotCount < memberCount * 2:
                slotCount = slotCount * 2
            setLen(nameSlots, slotCount)
            for slot in 0..<nameSlots.len:
                nameSlots[slot] = -1
            var payloadCursor: int32
            var previousNameToken: int32 = -1
            for memberOffset in 0..<memberCount:
                let memberRow = memberStart + memberOffset
                let memberNameToken = typedExprTypeArenaInt32At(value, value.memberNameTokenIndexes.offset, value.memberNameTokenIndexes.len, memberRow)
                let memberNameId = typedExprTypeArenaInt32At(value, value.memberNameIds.offset, value.memberNameIds.len, memberRow)
                let memberTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.memberTypeSyntaxNodeIndexes.offset, value.memberTypeSyntaxNodeIndexes.len, memberRow)
                let memberTypeId = typedExprTypeArenaInt32At(value, value.memberTypeIds.offset, value.memberTypeIds.len, memberRow)
                if typedExprTypeArenaInt32At(value, value.memberProducerSourceIndexes.offset, value.memberProducerSourceIndexes.len, memberRow) != producerSourceIndex ||
                   typedExprTypeArenaInt32At(value, value.memberDeclarationSymbolIds.offset, value.memberDeclarationSymbolIds.len, memberRow) != symbolId ||
                   memberNameToken < 0 || memberNameToken >= value.tokenCount ||
                   memberNameToken <= previousNameToken ||
                   typedExprTypeArenaInt32At(value, value.memberOrdinals.offset, value.memberOrdinals.len, memberRow) !=
                       memberOffset:
                    err = " typed expr type arena: enum member authority drift"
                    return false
                if memberTypeSyntaxNode < 0:
                    if memberTypeSyntaxNode != -1 || memberTypeId != -1:
                        err = " typed expr type arena: enum payload pair drift"
                        return false
                else:
                    if memberTypeSyntaxNode >= value.typeSyntaxCount ||
                       memberTypeId < 0 || memberTypeId >= value.typeCount ||
                       typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, memberTypeSyntaxNode) !=
                           Int32(parser.ParserTypeSyntaxRootInvalid) ||
                       typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, memberTypeSyntaxNode) != -1 ||
                       typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, memberTypeSyntaxNode) != -1 ||
                       typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, memberTypeSyntaxNode) != memberNameToken ||
                       typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, memberTypeSyntaxNode) != producerSourceIndex ||
                       typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, memberTypeSyntaxNode) != memberTypeId ||
                       payloadCursor >= childCount ||
                       typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart + payloadCursor) != memberTypeId ||
                       typedExprTypeArenaInt32At(value, value.childNameIds.offset, value.childNameIds.len, childStart + payloadCursor) != memberNameId:
                        err = " typed expr type arena: enum payload authority drift"
                        return false
                    payloadCursor = payloadCursor + 1
                var nameSlot = memberNameId % nameSlots.len
                while nameSlots[nameSlot] >= 0 &&
                      nameSlots[nameSlot] != memberNameId:
                    nameSlot = (nameSlot + 1) % nameSlots.len
                if nameSlots[nameSlot] == memberNameId:
                    err = " typed expr type arena: duplicate enum member name"
                    return false
                nameSlots[nameSlot] = memberNameId
                previousNameToken = memberNameToken
            if payloadCursor != childCount:
                err = " typed expr type arena: enum payload coverage drift"
                return false
        elif aliasDeclaration:
            # [phaseB-parser] alias 包裹 tuple 的具名元素 member 行校验：
            # 每行精确回到其 FieldDeclaration root（rootKind/owner 边/
            # ownerToken/producer/TypeId/ordinal），名字唯一；alias type 行
            # 的子是 tuple 行本身，故无 object 的 childTypeIds 逐成员耦合。
            # [alias-zero-member] ZERO member rows is a LEGAL alias shape, not
            # a defect: `typedExprTypeArenaBuildTupleAliasMembers` returns
            # success with no members whenever the declaration root owns no
            # field roots (`:2508-2511`), and `RealizeDeclarationsRec` says so
            # in words ("普通别名（无字段声明 root）在本臂零成员直通",
            # `:8126-8130`).  The parser receipt and the snapshot sidecar join
            # state the same fact ("普通类型别名仍不得拥有字段声明",
            # compiler_parser_receipt.cheng:4672-4678;
            # compiler_snapshot_schema.cheng:3920-3924).  Demanding members
            # here rejected every plain alias -- `type FrameKind = int32`,
            # `type cstring = ptr`, `type seq_string = str[]`.
            # The converse must NOT be asserted either: an alias wrapping a
            # tuple may still own zero members, because the parser mints
            # field roots for NAMED tuple elements only.  Only the structural
            # kind is asserted here; the per-member checks below run for
            # exactly the member rows that exist (a no-op at zero).
            if structuralKind != Int32(TypedExprStructuralTypeAlias):
                err = " typed expr type arena: alias member shape drift"
                return false
            var nameSlots: int32[]
            var slotCount: int32 = 8
            while slotCount < memberCount * 2:
                slotCount = slotCount * 2
            setLen(nameSlots, slotCount)
            for slot in 0..<nameSlots.len:
                nameSlots[slot] = -1
            for memberOffset in 0..<memberCount:
                let memberRow = memberStart + memberOffset
                let memberNameToken = typedExprTypeArenaInt32At(value, value.memberNameTokenIndexes.offset, value.memberNameTokenIndexes.len, memberRow)
                let memberNameId = typedExprTypeArenaInt32At(value, value.memberNameIds.offset, value.memberNameIds.len, memberRow)
                let memberTypeSyntaxNode = typedExprTypeArenaInt32At(value, value.memberTypeSyntaxNodeIndexes.offset, value.memberTypeSyntaxNodeIndexes.len, memberRow)
                let memberTypeId = typedExprTypeArenaInt32At(value, value.memberTypeIds.offset, value.memberTypeIds.len, memberRow)
                if typedExprTypeArenaInt32At(value, value.memberProducerSourceIndexes.offset, value.memberProducerSourceIndexes.len, memberRow) != producerSourceIndex ||
                   typedExprTypeArenaInt32At(value, value.memberDeclarationSymbolIds.offset, value.memberDeclarationSymbolIds.len, memberRow) != symbolId ||
                   memberNameToken < 0 || memberNameToken >= value.tokenCount ||
                   typedExprTypeArenaInt32At(value, value.memberOrdinals.offset, value.memberOrdinals.len, memberRow) !=
                       memberOffset ||
                   memberTypeSyntaxNode < 0 ||
                   memberTypeSyntaxNode >= value.typeSyntaxCount ||
                   memberTypeId < 0 || memberTypeId >= value.typeCount ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxRootKinds.offset, value.typeSyntaxRootKinds.len, memberTypeSyntaxNode) !=
                       Int32(parser.ParserTypeSyntaxRootFieldDeclaration) ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerNodeIndexes.offset, value.typeSyntaxDeclarationOwnerNodeIndexes.len, memberTypeSyntaxNode) != root ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, memberTypeSyntaxNode) !=
                       typedExprTypeArenaInt32At(value, value.typeSyntaxDeclarationOwnerTokenIndexes.offset, value.typeSyntaxDeclarationOwnerTokenIndexes.len, root) ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxOwnerTokenIndexes.offset, value.typeSyntaxOwnerTokenIndexes.len, memberTypeSyntaxNode) != memberNameToken ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxProducerSourceIndexes.offset, value.typeSyntaxProducerSourceIndexes.len, memberTypeSyntaxNode) != producerSourceIndex ||
                   typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, memberTypeSyntaxNode) != memberTypeId:
                    err = " typed expr type arena: alias member authority drift"
                    return false
                var nameSlot = memberNameId % nameSlots.len
                while nameSlots[nameSlot] >= 0 &&
                      nameSlots[nameSlot] != memberNameId:
                    nameSlot = (nameSlot + 1) % nameSlots.len
                if nameSlots[nameSlot] == memberNameId:
                    err = " typed expr type arena: duplicate member name"
                    return false
                nameSlots[nameSlot] = memberNameId
        elif memberCount != 0:
            err = " typed expr type arena: non-aggregate owns members"
            return false
        memberCursor = memberCursor + memberCount
    if memberCursor != value.memberCount:
        err = " typed expr type arena: declaration member coverage invalid"
        return false
    if !typedExprTypeArenaInheritanceAcyclic(value, err) ||
       !typedExprTypeArenaInheritedFieldsValidateInto(value, err):
        return false
    for resolutionRow in 0..<value.resolutionCount:
        let typeSyntaxNodeIndex = typedExprTypeArenaInt32At(value, value.resolutionTypeSyntaxNodeIndexes.offset, value.resolutionTypeSyntaxNodeIndexes.len, resolutionRow)
        let symbolId = typedExprTypeArenaInt32At(value, value.resolutionTargetSymbolIds.offset, value.resolutionTargetSymbolIds.len, resolutionRow)
        let declarationRoot = typedExprTypeArenaInt32At(value, value.symbolDeclarationRootTypeSyntaxNodeIndexes.offset, value.symbolDeclarationRootTypeSyntaxNodeIndexes.len, symbolId)
        let resolutionParserKind = typedExprTypeArenaInt32At(value, value.typeSyntaxParserKinds.offset, value.typeSyntaxParserKinds.len, typeSyntaxNodeIndex)
        if (resolutionParserKind !=
                Int32(parser.ParserTypeSyntaxNominal) &&
            resolutionParserKind !=
                Int32(parser.ParserTypeSyntaxQualified)) ||
           typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, typeSyntaxNodeIndex) !=
               typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, declarationRoot):
            err = " typed expr type arena: exact resolution receipt drift"
            return false
    if !layout.FixedBytes32Equal(
           recomputedArtifactRaw32, value.artifactRaw32):
        err = " typed expr type arena: artifact CID mismatch"
        return false
    err = ""
    return true

@borrows
fn TypedExprTypeArenaTypeIdForTypeSyntax(
        value: TypedExprTypeArena,
        typeSyntaxNodeIndex: int32): int32 =
    if value == nil || !value.complete || typeSyntaxNodeIndex < 0 ||
       typeSyntaxNodeIndex >= value.typeSyntaxCount:
        panic("typed expr type arena: TypeSyntax index out of range")
    return typedExprTypeArenaInt32At(value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len, typeSyntaxNodeIndex)

@borrows
fn TypedExprTypeArenaReservedScalarTypeId(
        value: TypedExprTypeArena,
        scalarKind: TypedExprStructuralScalarKind): int32 =
    if value == nil || !value.complete ||
       scalarKind <= TypedExprStructuralScalarInvalid ||
       scalarKind > TypedExprStructuralScalarCString ||
       scalarKind == TypedExprStructuralScalarPtr ||
       scalarKind == TypedExprStructuralScalarUtf8View ||
       scalarKind == TypedExprStructuralScalarBytesView ||
       scalarKind == TypedExprStructuralScalarTypedesc ||
       scalarKind == TypedExprStructuralScalarSet ||
       scalarKind == TypedExprStructuralScalarInt ||
       scalarKind == TypedExprStructuralScalarUInt:
        panic("typed expr type arena: reserved scalar authority invalid")
    for typeId in 0..<value.typeCount:
        if typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) ==
               Int32(TypedExprStructuralTypeScalar) &&
           typedExprTypeArenaInt32At(value, value.scalarKinds.offset, value.scalarKinds.len, typeId) ==
               Int32(scalarKind) &&
           typedExprTypeArenaInt32At(value, value.typeOriginKinds.offset, value.typeOriginKinds.len, typeId) ==
               Int32(TypedExprTypeOriginSemanticBuiltin):
            return typeId
    panic("typed expr type arena: reserved scalar authority missing")
    return -1

@borrows
fn TypedExprTypeArenaReservedScalarTypeIdForText(
        value: TypedExprTypeArena,
        typeText: str): int32 =
    let scalarKind = typedExprTypeArenaScalarKind(typeText)
    if value == nil || !value.complete ||
       scalarKind <= TypedExprStructuralScalarInvalid ||
       scalarKind > TypedExprStructuralScalarCString ||
       scalarKind == TypedExprStructuralScalarPtr ||
       scalarKind == TypedExprStructuralScalarUtf8View ||
       scalarKind == TypedExprStructuralScalarBytesView ||
       scalarKind == TypedExprStructuralScalarTypedesc ||
       scalarKind == TypedExprStructuralScalarSet ||
       scalarKind == TypedExprStructuralScalarInt ||
       scalarKind == TypedExprStructuralScalarUInt:
        return -1
    return TypedExprTypeArenaReservedScalarTypeId(value, scalarKind)

@borrows
fn TypedExprTypeArenaFunctionReturnTypeId(
        value: TypedExprTypeArena,
        producerSourceIndex: int32,
        sourceLocalFunctionRow: int32): int32 =
    if value == nil || !value.complete ||
       producerSourceIndex < 0 ||
       producerSourceIndex >= value.producerSourceCount ||
       sourceLocalFunctionRow < 0:
        panic("typed expr type arena: function return coordinate invalid")
    let start = typedExprTypeArenaInt32At(value, value.functionSourceStarts.offset, value.functionSourceStarts.len, producerSourceIndex)
    let count = typedExprTypeArenaInt32At(value, value.functionSourceCounts.offset, value.functionSourceCounts.len, producerSourceIndex)
    if sourceLocalFunctionRow >= count:
        panic("typed expr type arena: function return row out of range")
    let functionRow = start + sourceLocalFunctionRow
    if typedExprTypeArenaInt32At(value, value.functionProducerSourceIndexes.offset, value.functionProducerSourceIndexes.len, functionRow) != producerSourceIndex ||
       typedExprTypeArenaInt32At(value, value.functionSourceLocalRows.offset, value.functionSourceLocalRows.len, functionRow) != sourceLocalFunctionRow:
        panic("typed expr type arena: function return coordinate drift")
    return typedExprTypeArenaInt32At(value, value.functionReturnTypeIds.offset, value.functionReturnTypeIds.len, functionRow)

@borrows
fn TypedExprTypeArenaUnaryTypeId(
        value: TypedExprTypeArena,
        kind: TypedExprStructuralTypeKind,
        childTypeId: int32): int32 =
    if value == nil || !value.complete ||
       (kind != TypedExprStructuralTypeSequence &&
        kind != TypedExprStructuralTypeBorrow &&
        kind != TypedExprStructuralTypeAlias &&
        kind != TypedExprStructuralTypeOptional) ||
       childTypeId < 0 || childTypeId >= value.typeCount:
        panic("typed expr type arena: unary structural lookup invalid")
    for typeId in 0..<value.typeCount:
        if typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId) != Int32(kind) ||
           typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, typeId) != 1:
            continue
        let childStart = typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, typeId)
        if typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, childStart) ==
               childTypeId:
            return typeId
    return -1

@borrows
fn TypedExprTypeArenaUnaryChildTypeId(
        value: TypedExprTypeArena,
        typeId: int32,
        firstKind: TypedExprStructuralTypeKind,
        secondKind: TypedExprStructuralTypeKind): int32 =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: unary child coordinate invalid")
    let kind = TypedExprStructuralTypeKind(
        typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId))
    if (kind != firstKind && kind != secondKind) ||
       typedExprTypeArenaInt32At(value, value.childCounts.offset, value.childCounts.len, typeId) != 1:
        return -1
    return typedExprTypeArenaInt32At(value, value.childTypeIds.offset, value.childTypeIds.len, typedExprTypeArenaInt32At(value, value.childStarts.offset, value.childStarts.len, typeId))

@borrows
fn TypedExprTypeArenaInt32At(
        value: TypedExprTypeArena,
        offset: int32,
        count: int32,
        i: int32): int32 =
    return typedExprTypeArenaInt32At(value, offset, count, i)

@borrows
fn TypedExprTypeArenaKindAt(
        value: TypedExprTypeArena,
        typeId: int32): TypedExprStructuralTypeKind =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return TypedExprStructuralTypeKind(typedExprTypeArenaInt32At(value, value.typeKinds.offset, value.typeKinds.len, typeId))

# [phaseB-enum] 标量种类精确读取：typeId 必须是标量结构类型行。
@borrows
fn TypedExprTypeArenaScalarKindAt(
        value: TypedExprTypeArena,
        typeId: int32): TypedExprStructuralScalarKind =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return TypedExprStructuralScalarKind(typedExprTypeArenaInt32At(
        value, value.scalarKinds.offset, value.scalarKinds.len, typeId))

# [phaseB-enum] enum 成员名精确查询。typeId 必须是 enum 结构类型行；查询名
# 经 intern pool 精确比对（不是文本近似键）。返回该 enum 的成员名表是否
# 恰含这个名字。供 value-definition 等价核对证明"此 I32Const 是该 enum 的
# 成员 ordinal"使用。
@borrows
fn TypedExprTypeArenaEnumDeclaresMemberName(value: TypedExprTypeArena,
                                            typeId: int32,
                                            nameText: str): bool =
    if value == nil || !value.complete || typeId < 0 ||
           typeId >= value.typeCount:
        return false
    if TypedExprTypeArenaKindAt(value, typeId) !=
           TypedExprStructuralTypeEnum:
        return false
    let symbolId = typedExprTypeArenaInt32At(value, value.symbolIds.offset,
                                             value.symbolIds.len, typeId)
    if symbolId < 0 || symbolId >= value.symbolCount:
        return false
    let memberStart = typedExprTypeArenaInt32At(
        value, value.symbolMemberStarts.offset,
        value.symbolMemberStarts.len, symbolId)
    let memberLength = typedExprTypeArenaInt32At(
        value, value.symbolMemberCounts.offset,
        value.symbolMemberCounts.len, symbolId)
    if memberStart < 0 || memberLength < 0 ||
           memberStart + memberLength > value.memberCount:
        return false
    let queryNameId = langintern.Intern(value.internPool,
                                        strings.CloneStr(nameText))
    for memberOffset in 0..<memberLength:
        if typedExprTypeArenaInt32At(
               value, value.memberNameIds.offset,
               value.memberNameIds.len, memberStart + memberOffset) ==
               queryNameId:
            return true
    return false

# [phaseB-enum] enum 声明名精确查询：typeId 必须是 enum 结构类型行，返回其
# 声明符号名的 intern 精确文本；非 enum 行返回空串。
@borrows
fn TypedExprTypeArenaEnumDeclarationName(value: TypedExprTypeArena,
                                         typeId: int32): str =
    if value == nil || !value.complete || typeId < 0 ||
           typeId >= value.typeCount:
        return ""
    if TypedExprTypeArenaKindAt(value, typeId) !=
           TypedExprStructuralTypeEnum:
        return ""
    let symbolId = typedExprTypeArenaInt32At(value, value.symbolIds.offset,
                                             value.symbolIds.len, typeId)
    if symbolId < 0 || symbolId >= value.symbolCount:
        return ""
    let nameId = typedExprTypeArenaInt32At(
        value, value.symbolNameIds.offset, value.symbolNameIds.len, symbolId)
    if nameId < 0:
        return ""
    return Value(langintern.LookupIntern(value.internPool, nameId))

@borrows
fn TypedExprTypeArenaFixedLengthAt(
        value: TypedExprTypeArena,
        typeId: int32): int32 =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return typedExprTypeArenaInt32At(value, value.fixedLengths.offset, value.fixedLengths.len, typeId)

@borrows
fn TypedExprTypeArenaTraitRuleAt(
        value: TypedExprTypeArena,
        typeId: int32): TypedExprTypeTraitRuleKind =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return TypedExprTypeTraitRuleKind(typedExprTypeArenaInt32At(value, value.traitRuleKinds.offset, value.traitRuleKinds.len, typeId))

@borrows
fn TypedExprTypeArenaComplete(value: TypedExprTypeArena): bool =
    return value != nil && value.complete

@borrows
fn TypedExprTypeArenaTypeCount(value: TypedExprTypeArena): int32 =
    if value == nil || !value.complete:
        panic("typed expr type arena: incomplete snapshot")
    return value.typeCount

@borrows
fn TypedExprTypeArenaUsedBytes(value: TypedExprTypeArena): int32 =
    if value == nil || !value.complete:
        panic("typed expr type arena: incomplete snapshot")
    return arenamod.ArenaUsed(value.arena)

@borrows
fn TypedExprTypeArenaBaseTypeSyntaxNodeIndexAt(
        value: TypedExprTypeArena,
        typeId: int32): int32 =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: base TypeSyntax query invalid")
    return typedExprTypeArenaInt32At(value, value.baseTypeSyntaxNodeIndexes.offset, value.baseTypeSyntaxNodeIndexes.len, typeId)

@borrows
fn TypedExprTypeArenaBaseTypeIdAt(
        value: TypedExprTypeArena,
        typeId: int32): int32 =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: base TypeId query invalid")
    return typedExprTypeArenaInt32At(value, value.baseTypeIds.offset, value.baseTypeIds.len, typeId)

@borrows
fn TypedExprTypeArenaSymbolIdAt(
        value: TypedExprTypeArena,
        typeId: int32): int32 =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return typedExprTypeArenaInt32At(value, value.symbolIds.offset, value.symbolIds.len, typeId)

@borrows
fn TypedExprTypeArenaTraitPremiseCountAt(
        value: TypedExprTypeArena,
        typeId: int32): int32 =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return typedExprTypeArenaInt32At(value, value.traitPremiseCounts.offset, value.traitPremiseCounts.len, typeId)

@borrows
fn TypedExprTypeArenaTraitPremiseTypeIdAt(
        value: TypedExprTypeArena,
        typeId: int32,
        premiseOffset: int32): int32 =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    let premiseCount = typedExprTypeArenaInt32At(value, value.traitPremiseCounts.offset, value.traitPremiseCounts.len, typeId)
    if premiseOffset < 0 || premiseOffset >= premiseCount:
        panic("typed expr type arena: trait premise out of range")
    let premiseStart = typedExprTypeArenaInt32At(value, value.traitPremiseStarts.offset, value.traitPremiseStarts.len, typeId)
    return typedExprTypeArenaInt32At(value, value.traitPremiseTypeIds.offset, value.traitPremiseTypeIds.len, premiseStart + premiseOffset)

@borrows
fn TypedExprTypeArenaManagedAt(
        value: TypedExprTypeArena,
        typeId: int32): bool =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return typedExprTypeArenaInt32At(value, value.managedFlags.offset, value.managedFlags.len, typeId) != 0

@borrows
fn TypedExprTypeArenaSendAt(
        value: TypedExprTypeArena,
        typeId: int32): bool =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return typedExprTypeArenaInt32At(value, value.sendFlags.offset, value.sendFlags.len, typeId) != 0

@borrows
fn TypedExprTypeArenaSyncAt(
        value: TypedExprTypeArena,
        typeId: int32): bool =
    if value == nil || !value.complete || typeId < 0 ||
       typeId >= value.typeCount:
        panic("typed expr type arena: TypeId out of range")
    return typedExprTypeArenaInt32At(value, value.syncFlags.offset, value.syncFlags.len, typeId) != 0

# Diagnostic clones must own independent Arena/InternPool storage.  Arena
# column descriptors are immutable offsets, so cloning the backing arena and
# copying the descriptors preserves every exact TypeId/SymbolId coordinate.
@borrows
fn TypedExprTypeArenaClone(value: TypedExprTypeArena): TypedExprTypeArena =
    if value == nil:
        return nil
    var err: str
    if !TypedExprTypeArenaStrictValidateInto(value, err):
        panic(Fmt"typed expr type arena: clone source invalid: {err}")
    var out: TypedExprTypeArena = new(TypedExprTypeArena)
    out.arena = arenamod.ArenaClone(value.arena)
    out.internPool = langintern.InternPoolClone(value.internPool)
    out.producerSourceCount = value.producerSourceCount
    out.tokenCount = value.tokenCount
    out.typeSyntaxCount = value.typeSyntaxCount
    out.functionCount = value.functionCount
    out.genericSymbolCount = value.genericSymbolCount
    out.genericSymbolChildCount = value.genericSymbolChildCount
    out.bracketArgCount = value.bracketArgCount
    out.typeCount = value.typeCount
    out.symbolCount = value.symbolCount
    out.memberCount = value.memberCount
    out.resolutionCount = value.resolutionCount
    out.genericResolutionCount = value.genericResolutionCount
    out.complete = value.complete
    out.tokenProducerSourceIndexes = value.tokenProducerSourceIndexes
    out.tokenKinds = value.tokenKinds
    out.tokenSpanStarts = value.tokenSpanStarts
    out.tokenSpanEnds = value.tokenSpanEnds
    out.typeSyntaxTypeIds = value.typeSyntaxTypeIds
    out.typeSyntaxParserKinds = value.typeSyntaxParserKinds
    out.typeSyntaxProducerSourceIndexes =
        value.typeSyntaxProducerSourceIndexes
    out.typeSyntaxSourceLocalRows = value.typeSyntaxSourceLocalRows
    out.typeSyntaxSpanStarts = value.typeSyntaxSpanStarts
    out.typeSyntaxSpanEnds = value.typeSyntaxSpanEnds
    out.typeSyntaxOwnerTokenIndexes = value.typeSyntaxOwnerTokenIndexes
    out.typeSyntaxQuestionTokenIndexes =
        value.typeSyntaxQuestionTokenIndexes
    out.typeSyntaxDeclarationOwnerTokenIndexes =
        value.typeSyntaxDeclarationOwnerTokenIndexes
    out.typeSyntaxDeclarationOwnerNodeIndexes =
        value.typeSyntaxDeclarationOwnerNodeIndexes
    out.typeSyntaxGenericSymbolStarts = value.typeSyntaxGenericSymbolStarts
    out.typeSyntaxGenericSymbolCounts = value.typeSyntaxGenericSymbolCounts
    out.typeSyntaxRootKinds = value.typeSyntaxRootKinds
    out.typeSyntaxBracketArgStarts = value.typeSyntaxBracketArgStarts
    out.typeSyntaxBracketArgCounts = value.typeSyntaxBracketArgCounts
    out.typeSyntaxBracketBaseTypeSyntaxNodeIndexes =
        value.typeSyntaxBracketBaseTypeSyntaxNodeIndexes
    # [S1b-0c] Seal-phase parser facts.  This clone is column-explicit, so a
    # column missing here is silently dropped for every downstream consumer.
    out.typeSyntaxChildStarts = value.typeSyntaxChildStarts
    out.typeSyntaxChildCounts = value.typeSyntaxChildCounts
    out.typeSyntaxChildTypeSyntaxNodeIndexes =
        value.typeSyntaxChildTypeSyntaxNodeIndexes
    out.typeSyntaxEnumVariantStarts = value.typeSyntaxEnumVariantStarts
    out.typeSyntaxEnumVariantCounts = value.typeSyntaxEnumVariantCounts
    out.typeSyntaxEnumVariantPayloadTypeSyntaxNodeIndexes =
        value.typeSyntaxEnumVariantPayloadTypeSyntaxNodeIndexes
    out.typeSyntaxEnumVariantProducerSourceIndexes =
        value.typeSyntaxEnumVariantProducerSourceIndexes
    out.typeSyntaxEnumVariantDeclarationOwnerNodeIndexes =
        value.typeSyntaxEnumVariantDeclarationOwnerNodeIndexes
    out.typeSyntaxEnumVariantDeclarationOwnerTokenIndexes =
        value.typeSyntaxEnumVariantDeclarationOwnerTokenIndexes
    out.typeSyntaxEnumVariantOrdinals = value.typeSyntaxEnumVariantOrdinals
    # [S1b-1c] The variant name token row is a first-class column: the Seal
    # phase reads it, and StrictValidateInto asserts its length against
    # typeSyntaxEnumVariantOrdinals.len, so a clone that skipped it would be a
    # structurally invalid arena rather than a loud failure at the clone site.
    out.typeSyntaxEnumVariantNameTokenIndexes =
        value.typeSyntaxEnumVariantNameTokenIndexes
    out.typeSyntaxOwnerTokenTexts = value.typeSyntaxOwnerTokenTexts
    out.typeSyntaxNameTokenTexts = value.typeSyntaxNameTokenTexts
    out.typeSyntaxDeclarationOwnerTokenTexts =
        value.typeSyntaxDeclarationOwnerTokenTexts
    out.typeSyntaxEnumVariantNameTokenTexts =
        value.typeSyntaxEnumVariantNameTokenTexts
    out.functionSourceStarts = value.functionSourceStarts
    out.functionSourceCounts = value.functionSourceCounts
    out.functionProducerSourceIndexes =
        value.functionProducerSourceIndexes
    out.functionSourceLocalRows = value.functionSourceLocalRows
    out.functionDeclarationSourceLocalRows =
        value.functionDeclarationSourceLocalRows
    out.functionOwnerTokenIndexes = value.functionOwnerTokenIndexes
    out.functionReturnTypeIds = value.functionReturnTypeIds
    out.bracketArgTokenStarts = value.bracketArgTokenStarts
    out.bracketArgTokenCounts = value.bracketArgTokenCounts
    out.bracketArgTypeSyntaxNodeIndexes =
        value.bracketArgTypeSyntaxNodeIndexes
    out.genericSymbolProducerSourceIndexes =
        value.genericSymbolProducerSourceIndexes
    out.genericSymbolDeclarationOwnerTokenIndexes =
        value.genericSymbolDeclarationOwnerTokenIndexes
    out.genericSymbolNameTokenIndexes = value.genericSymbolNameTokenIndexes
    out.genericSymbolNameIds = value.genericSymbolNameIds
    out.genericSymbolOrdinals = value.genericSymbolOrdinals
    out.genericSymbolSpanStarts = value.genericSymbolSpanStarts
    out.genericSymbolSpanEnds = value.genericSymbolSpanEnds
    out.genericSymbolOwnerTypeSyntaxNodeIndexes =
        value.genericSymbolOwnerTypeSyntaxNodeIndexes
    out.genericSymbolConstraintTypeSyntaxNodeIndexes =
        value.genericSymbolConstraintTypeSyntaxNodeIndexes
    out.genericSymbolDefaultTypeSyntaxNodeIndexes =
        value.genericSymbolDefaultTypeSyntaxNodeIndexes
    out.genericSymbolConstraintTypeIds =
        value.genericSymbolConstraintTypeIds
    out.genericSymbolDefaultTypeIds = value.genericSymbolDefaultTypeIds
    out.genericSymbolChildStarts = value.genericSymbolChildStarts
    out.genericSymbolChildCounts = value.genericSymbolChildCounts
    out.genericSymbolChildTypeSyntaxNodeIndexes =
        value.genericSymbolChildTypeSyntaxNodeIndexes
    out.genericSymbolChildTypeIds = value.genericSymbolChildTypeIds
    out.typeKinds = value.typeKinds
    out.scalarKinds = value.scalarKinds
    out.symbolIds = value.symbolIds
    out.genericSymbolIds = value.genericSymbolIds
    out.fixedLengths = value.fixedLengths
    out.functionParamCounts = value.functionParamCounts
    out.baseTypeSyntaxNodeIndexes = value.baseTypeSyntaxNodeIndexes
    out.baseTypeIds = value.baseTypeIds
    out.childStarts = value.childStarts
    out.childCounts = value.childCounts
    out.childTypeIds = value.childTypeIds
    out.childNameIds = value.childNameIds
    out.traitRuleKinds = value.traitRuleKinds
    out.traitPremiseStarts = value.traitPremiseStarts
    out.traitPremiseCounts = value.traitPremiseCounts
    out.traitPremiseTypeIds = value.traitPremiseTypeIds
    out.managedFlags = value.managedFlags
    out.sendFlags = value.sendFlags
    out.syncFlags = value.syncFlags
    out.typeOriginKinds = value.typeOriginKinds
    out.originTypeSyntaxNodeIndexes = value.originTypeSyntaxNodeIndexes
    out.originProducerSourceIndexes = value.originProducerSourceIndexes
    out.symbolDeclarationRootTypeSyntaxNodeIndexes =
        value.symbolDeclarationRootTypeSyntaxNodeIndexes
    out.symbolProducerSourceIndexes = value.symbolProducerSourceIndexes
    out.symbolDeclarationOwnerTokenIndexes =
        value.symbolDeclarationOwnerTokenIndexes
    out.symbolNameIds = value.symbolNameIds
    out.symbolMemberStarts = value.symbolMemberStarts
    out.symbolMemberCounts = value.symbolMemberCounts
    out.memberProducerSourceIndexes = value.memberProducerSourceIndexes
    out.memberDeclarationSymbolIds = value.memberDeclarationSymbolIds
    out.memberNameTokenIndexes = value.memberNameTokenIndexes
    out.memberNameIds = value.memberNameIds
    out.memberOrdinals = value.memberOrdinals
    out.memberTypeSyntaxNodeIndexes = value.memberTypeSyntaxNodeIndexes
    out.memberTypeIds = value.memberTypeIds
    out.typeSyntaxParentNodeIndexes = value.typeSyntaxParentNodeIndexes
    out.typeSyntaxEnclosingSymbolIds = value.typeSyntaxEnclosingSymbolIds
    out.resolutionTypeSyntaxNodeIndexes =
        value.resolutionTypeSyntaxNodeIndexes
    out.resolutionTargetSymbolIds = value.resolutionTargetSymbolIds
    out.genericResolutionTypeSyntaxNodeIndexes =
        value.genericResolutionTypeSyntaxNodeIndexes
    out.genericResolutionTargetGenericSymbolRows =
        value.genericResolutionTargetGenericSymbolRows
    out.nominalDependencyCount = value.nominalDependencyCount
    out.nominalDependencyTypeSyntaxNodeIndexes =
        value.nominalDependencyTypeSyntaxNodeIndexes
    out.nominalDependencySourceSymbolIds =
        value.nominalDependencySourceSymbolIds
    out.nominalDependencyTargetSymbolIds =
        value.nominalDependencyTargetSymbolIds
    out.nominalDependencyIndirectFlags = value.nominalDependencyIndirectFlags
    out.symbolDependencyCount = value.symbolDependencyCount
    out.symbolDependencyStarts = value.symbolDependencyStarts
    out.symbolDependencyCounts = value.symbolDependencyCounts
    out.symbolDependencyTargetSymbolIds =
        value.symbolDependencyTargetSymbolIds
    out.symbolDependencyDirectFlags = value.symbolDependencyDirectFlags
    out.sccCount = value.sccCount
    out.symbolSccIds = value.symbolSccIds
    out.sccStarts = value.sccStarts
    out.sccCounts = value.sccCounts
    out.sccSymbolIds = value.sccSymbolIds
    out.artifactRaw32 = value.artifactRaw32
    return out

fn TypedExprTypeArenaRelease(value: var TypedExprTypeArena) =
    if value == nil: return
    arenamod.ArenaRelease(value.arena)
    langintern.InternPoolRelease(value.internPool)
    value = nil

fn TypedExprTypeArenaReleaseOwned(value: TypedExprTypeArena) =
    var owned: TypedExprTypeArena
    owned = value
    TypedExprTypeArenaRelease(owned)
