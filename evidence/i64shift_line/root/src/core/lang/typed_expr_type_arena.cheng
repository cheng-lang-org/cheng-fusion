    return arenamod.ArenaArrayInt32Get(
        value.arena, value.typeSyntaxChildNameIdsByRow,
        childStart + childOffset)

@borrows
fn typedExprTypeArenaSyntaxChildNameIdSetAt(
        value: var TypedExprTypeArena,
        row: int32,
        childOffset: int32,
        nameId: int32) =
    let childStart = arenamod.ArenaArrayInt32Get(
        value.arena, value.typeSyntaxChildStarts, row)
    arenamod.ArenaArrayInt32Set(
        value.arena, value.typeSyntaxChildNameIdsByRow,
        childStart + childOffset, nameId)

# [c2-replay-cols] Exported read of one global TypeSyntax row's TypeId.  The
# driver's replay_tid probe prints one line per originally-flagged row of
# every replayed source; the tree arm and the column arm print the SAME keys,
# so the two runs' stderr streams must be line-for-line identical.  A diverging
# tid names the first row where the two walks disagree.
@borrows
fn TypedExprTypeArenaTypeSyntaxTypeIdAt(
        value: TypedExprTypeArena,
        row: int32): int32 =
    return typedExprTypeArenaInt32At(
        value, value.typeSyntaxTypeIds.offset, value.typeSyntaxTypeIds.len,
        row)

@borrows
fn typedExprTypeArenaSyntaxGenericSymbolStartAt(
        value: TypedExprTypeArena,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        value.arena, value.typeSyntaxGenericSymbolStarts, row)

@borrows
fn typedExprTypeArenaSyntaxGenericSymbolCountAt(
        value: TypedExprTypeArena,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        value.arena, value.typeSyntaxGenericSymbolCounts, row)

# [forward-decl] Declaration generic window, keyed by the exact SymbolId space
# closure8 sealed.  The caller holds a GLOBAL declaration root; its SymbolId is
# the dense forest-order row of `declarationSymbolGlobalRoots`, and the window
# is the parser fact the owning source contributed in pass 0.  A root outside
# the sealed space is a defect and aborts with the root; no default is
# substituted, and no caller may fall back to a per-source prefix column, whose
# `len` is the materialised prefix only.
@borrows
fn typedExprTypeArenaDeclarationGenericWindowAt(
        state: TypedExprTypeArenaBuildState,
        declarationRoot: int32,
        startOut: var int32,
        countOut: var int32,
        err: var str): bool =
    startOut = -1
    countOut = -1
    if state == nil:
        err = " typed expr type arena: declaration generic window state missing"
        return false
    if declarationRoot < 0 ||
       declarationRoot >= state.symbolByDeclarationRoot.len:
        err = Fmt" typed expr type arena: declaration generic window root out of range declaration_root={declarationRoot} type_syntax={state.symbolByDeclarationRoot.len}"
        return false
    let symbolId = state.symbolByDeclarationRoot[declarationRoot]
    if symbolId < 0 ||
       symbolId >= state.declarationGenericSymbolCounts.len:
        err = Fmt" typed expr type arena: declaration generic window symbol unmaterialised declaration_root={declarationRoot} symbol={symbolId} symbols={state.declarationGenericSymbolCounts.len}"
        return false
    startOut = state.declarationGenericSymbolStarts[symbolId]
    countOut = state.declarationGenericSymbolCounts[symbolId]
    return true

