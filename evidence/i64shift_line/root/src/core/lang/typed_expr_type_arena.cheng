import std/result
import std/strings
import cheng/core/lang/parser
import cheng/core/lang/intern as langintern
import cheng/core/runtime/arena as arenamod
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/os

type
    # Snapshot-local TypeIds and SymbolIds are dense int32 rows.  They are never
    # serialized as portable declaration identity: the snapshot builder binds
    # them to the document/module SymbolCid receipt in the next layer.
    TypedExprStructuralTypeKind = enum
        TypedExprStructuralTypeInvalid
        TypedExprStructuralTypeScalar
        TypedExprStructuralTypeBorrow
        TypedExprStructuralTypeSequence
        TypedExprStructuralTypeFixedArray
        TypedExprStructuralTypeTuple
        TypedExprStructuralTypeFunction
        TypedExprStructuralTypeObject
        TypedExprStructuralTypeRefObject
        TypedExprStructuralTypeEnum
        TypedExprStructuralTypeApply
        TypedExprStructuralTypeAlias
        TypedExprStructuralTypeGenericParameter
        TypedExprStructuralTypeOptional

    TypedExprStructuralScalarKind = enum
        TypedExprStructuralScalarInvalid
        TypedExprStructuralScalarVoid
        TypedExprStructuralScalarBool
        TypedExprStructuralScalarChar
        TypedExprStructuralScalarInt
        TypedExprStructuralScalarUInt
        TypedExprStructuralScalarInt8
        TypedExprStructuralScalarUInt8
        TypedExprStructuralScalarInt16
        TypedExprStructuralScalarUInt16
        TypedExprStructuralScalarInt32
        TypedExprStructuralScalarUInt32
        TypedExprStructuralScalarInt64
        TypedExprStructuralScalarUInt64
        TypedExprStructuralScalarFloat32
        TypedExprStructuralScalarFloat64
        TypedExprStructuralScalarStr
        TypedExprStructuralScalarCString
        TypedExprStructuralScalarPtr
        # [builtin-ctor] Built-in *type constructors*: names that carry no
        # nominal declaration and are only meaningful as the base of a
        # bracket application (`typedesc[T]`, `set[T]`).  They are appended
        # after `Ptr`, so every existing scalar ordinal is unchanged.
        TypedExprStructuralScalarTypedesc
        TypedExprStructuralScalarSet
        # [sabi-view] Built-in SABI boundary types (spec 9.x `str bridge`:
        # "`utf8_view`: 只读 UTF-8 `(ptr,len)`，仅 C ABI 参数可用" /
        # "`bytes_view`: 只读 bytes `(ptr,len)`，仅 C ABI 参数可用").  They
        # have no declaration in any source, so the arena must carry them as
        # scalar rows.  Appended after `Set`, so every existing scalar
        # ordinal -- and therefore every existing type CID byte -- is
        # unchanged.
        TypedExprStructuralScalarUtf8View
        TypedExprStructuralScalarBytesView

    TypedExprTypeTraitRuleKind = enum
        TypedExprTypeTraitRuleInvalid
        TypedExprTypeTraitRulePlainScalar
        TypedExprTypeTraitRuleManagedString
        TypedExprTypeTraitRuleBorrowedView
        TypedExprTypeTraitRuleLocalSequence
        TypedExprTypeTraitRuleFixedArrayRecursive
        TypedExprTypeTraitRuleTupleRecursive
        TypedExprTypeTraitRuleFunctionValue
        TypedExprTypeTraitRuleObjectFieldsRecursive
        TypedExprTypeTraitRuleOwnedRefObject
        TypedExprTypeTraitRuleEnumVariantsRecursive
        TypedExprTypeTraitRuleGenericApplication
        TypedExprTypeTraitRuleAliasForward
        TypedExprTypeTraitRuleGenericParameter
        TypedExprTypeTraitRuleOptionalRecursive

    TypedExprTypeOriginKind = enum
        TypedExprTypeOriginInvalid
        TypedExprTypeOriginParserSyntax
        TypedExprTypeOriginSemanticBuiltin

    # Exact resolution edges are producer facts, not text lookup hints.  Every
    # row maps one nominal TypeSyntax node to one exact declaration root.
    TypedExprTypeResolutionAuthority =
        typeSyntaxNodeIndexes: int32[]
        declarationRootTypeSyntaxNodeIndexes: int32[]
        genericTypeSyntaxNodeIndexes: int32[]
        genericSymbolRows: int32[]
        sealed: bool

    # Exact package-forest import bindings.  Source rows are the same dense
    # producerSourceIndexes used by ParserValueExprTree; qualifier text comes
    # only from the parser's resolved ImportEdge, never from source scanning.
    TypedExprTypeImportAuthority =
        ownerSourceIndexes: int32[]
        targetSourceIndexes: int32[]
        qualifiers: str[]
        allowsUnqualified: bool[]
        sealed: bool

    # [S1a] Offline cross-source declaration index.  The resolution authority
    # learns exactly four cross-source facts from the package forest: the
    # (producerSourceIndex, declaration name) key that locates a declaration
    # root, the global TypeSyntax root itself, the global declaration row
    # behind it, and that row's kind/exported flag.  This index is that exact
    # projection, extracted from each single-source tree while the forest
    # window still owns it, so resolution no longer needs the merged forest
    # resident.  Flat SoA columns with int32 row identities, the same shape
    # doctrine as TypedExprTypeImportAuthority.  Entries are appended in
    # forest row order (source order, then source-local TypeSyntax row), so
    # row order is the merge order by construction.
    TypedExprTypeDeclarationIndex =
        producerSourceIndexes: int32[]
        declarationNameTexts: str[]
        declarationKinds: int32[]
        declarationExportedFlags: bool[]
        globalTypeSyntaxRoots: int32[]
        globalDeclarationRows: int32[]
        # S-c prefix sums: first global row owned by each producer source,
        # exactly the ParserValueExprTreeAppendFromImpl offsets.
        typeSyntaxBaseBySource: int32[]
        declarationBaseBySource: int32[]
        # [S1b step-3 (1)] Per-source column totals.  Each entry is the exact
        # number of ArenaArrayInt32Add calls the materialization phase will
        # make on that column while appending this source, so the Init phase
        # can reserve every column at its exact final length and the column
        # fill never takes the doubling path.  They are read from the same
        # authority the corresponding Fill* loop iterates, never counted
        # twice and never estimated.
        tokenCountBySource: int32[]
        typeSyntaxChildCountBySource: int32[]
        enumVariantCountBySource: int32[]
        declarationSymbolCountBySource: int32[]
        # [closure8] The declaration SymbolId space itself: one row per
        # TypeSyntax row that `typedExprTypeArenaDeclarationCreatesSymbol`
        # accepts, in forest order, carrying that row's GLOBAL TypeSyntax
        # index.  A declaration root's row in this array IS its SymbolId,
        # because `typedExprTypeArenaFillDeclarationSymbols` walks exactly
        # that predicate in exactly that order.  `symbolByDeclarationRoot`
        # can only be filled for sources that have already been appended,
        # and a nominal in source k may resolve through the import fallback
        # to a declaration in source j > k whose SymbolId the sequential
        # counter has not reached; this array is the only SymbolId authority
        # that is complete before any source is resident.
        declarationSymbolGlobalRoots: int32[]
        # [forward-decl] The declaration generic window, in the exact row space
        # `declarationSymbolGlobalRoots` established: one row per declaration
        # root `typedExprTypeArenaDeclarationCreatesSymbol` accepts, in forest
        # order, carrying that root's GLOBAL generic-symbol start and its exact
        # count.  Both are pure parser facts of the owning source, read in pass
        # 0 while that source's tree was still resident and rebased by the same
        # prefix sum the production pass advances, so a nominal in source k that
        # resolves through the index to a declaration in source j > k reads the
        # identical integers a whole-forest build would have written.  Not
        # enumerated by `typedExprTypeArenaHashMaterialized`.
        declarationGenericSymbolStarts: int32[]
        declarationGenericSymbolCounts: int32[]
        functionCountBySource: int32[]
        bracketArgCountBySource: int32[]
        genericSymbolCountBySource: int32[]
        genericSymbolChildCountBySource: int32[]
        producerSourceCount: int32
        typeSyntaxCount: int32
        declarationCount: int32
        sealed: bool

    # [S1b step-3 (2)] Exact final length of every arena column filled by the
    # six Fill* families, derived either from the merged forest tree or from
    # the declaration index sums above.  Both derivations read the same
    # authority arrays, so they are the same integers; neither is an estimate
    # and no default is substituted when a value is unavailable.
    TypedExprTypeArenaLimits =
        tokenCount: int32
        typeSyntaxCount: int32
        typeSyntaxChildCount: int32
        enumVariantCount: int32
        declarationSymbolCount: int32
        functionCount: int32
        bracketArgCount: int32
        genericSymbolCount: int32
        genericSymbolChildCount: int32
        producerSourceCount: int32
        columnRows: int64
        columnBytes: int64

    TypedExprTypeArena = ref object
        arena: arenamod.Arena
        internPool: langintern.InternPool
        producerSourceCount: int32
        tokenCount: int32
        typeSyntaxCount: int32
        functionCount: int32
        genericSymbolCount: int32
        genericSymbolChildCount: int32
        bracketArgCount: int32
        typeCount: int32
        symbolCount: int32
        memberCount: int32
        resolutionCount: int32
        genericResolutionCount: int32
        complete: bool
        # Immutable parser token authority retained by TypeArena so token
        # indexes are exact coordinates, not unverified integers.
        tokenProducerSourceIndexes: arenamod.ArenaArrayInt32
        tokenKinds: arenamod.ArenaArrayInt32
        tokenSpanStarts: arenamod.ArenaArrayInt32
        tokenSpanEnds: arenamod.ArenaArrayInt32
        typeSyntaxTypeIds: arenamod.ArenaArrayInt32
        typeSyntaxParserKinds: arenamod.ArenaArrayInt32
        typeSyntaxProducerSourceIndexes: arenamod.ArenaArrayInt32
        # Immutable parser-production coordinate within the producer source.
        # This prevents equal-kind TypeSyntax rows from being exchanged while
        # retaining a superficially valid source partition.
        typeSyntaxSourceLocalRows: arenamod.ArenaArrayInt32
        typeSyntaxSpanStarts: arenamod.ArenaArrayInt32
        typeSyntaxSpanEnds: arenamod.ArenaArrayInt32
        typeSyntaxOwnerTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxQuestionTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxDeclarationOwnerTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxDeclarationOwnerNodeIndexes: arenamod.ArenaArrayInt32
        typeSyntaxGenericSymbolStarts: arenamod.ArenaArrayInt32
        typeSyntaxGenericSymbolCounts: arenamod.ArenaArrayInt32
        typeSyntaxRootKinds: arenamod.ArenaArrayInt32
        typeSyntaxBracketArgStarts: arenamod.ArenaArrayInt32
        typeSyntaxBracketArgCounts: arenamod.ArenaArrayInt32
        typeSyntaxBracketBaseTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        # [S1b-0c] Seal-phase parser facts.  Once sources are consumed one at
        # a time the Seal phase has no tree, so every fact the seven Seal tree
        # reads need must already live here.  Two rules are load-bearing:
        #   1. Rows and offsets are GLOBAL.  A single-source tree carries
        #      source-local coordinates, and ParserValueExprTreeAppendFromImpl
        #      rebases them while merging (parser.cheng HEAD:11102 children,
        #      :11194 producer source index, :11235 child cursor, :11270-11280
        #      enum variants, :11012 variant payload).  The fill therefore adds
        #      the view bases; the whole-forest driver passes base 0.
        #   2. The name columns are TEXT tables, never intern ids.  Intern ids
        #      are assigned by pool insertion order, and the field/variant names
        #      are interned during Seal (BuildObjectDeclaration /
        #      BuildTupleAliasMembers / BuildEnumDeclaration).  Interning them
        #      earlier would reorder the pool and change
        #      symbolNameIds/childNameIds/memberNameIds, which feed
        #      artifactRaw32.  Seal must call Intern in place.
        # None of these columns is enumerated by
        # typedExprTypeArenaHashMaterialized, so adding them does not disturb
        # artifactRaw32 -- that is what makes 0c a pure addition.
        typeSyntaxChildStarts: arenamod.ArenaArrayInt32
        typeSyntaxChildCounts: arenamod.ArenaArrayInt32
        typeSyntaxChildTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantStarts: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantCounts: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantPayloadTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        # [S1b-1c] Variant name token row.  The Seal phase checks the token's
        # kind and interns its text; the text lives in
        # `typeSyntaxEnumVariantNameTokenTexts`, the row lives here so the
        # token-kind authority stays the arena's own `tokenKinds` column.
        typeSyntaxEnumVariantNameTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantProducerSourceIndexes: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantDeclarationOwnerNodeIndexes: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantDeclarationOwnerTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantOrdinals: arenamod.ArenaArrayInt32
        typeSyntaxOwnerTokenTexts: str[]
        typeSyntaxNameTokenTexts: str[]
        typeSyntaxDeclarationOwnerTokenTexts: str[]
        typeSyntaxEnumVariantNameTokenTexts: str[]
        # [c2-replay-cols] Parser facts the forward replay reads, materialised
        # per row while the tree is resident.  Not enumerated by
        # typedExprTypeArenaHashMaterialized, so artifactRaw32 is unchanged.
        typeSyntaxFixedLengthsByRow: arenamod.ArenaArrayInt32
        typeSyntaxFunctionParamCountsByRow: arenamod.ArenaArrayInt32
        typeSyntaxChildNameIdsByRow: arenamod.ArenaArrayInt32
        # Exact executable-function signature authority. Function rows are
        # dense in parser-forest order; sourceStarts/sourceCounts make the
        # producerSourceIndex + source-local function row join O(1).
        functionSourceStarts: arenamod.ArenaArrayInt32
        functionSourceCounts: arenamod.ArenaArrayInt32
        functionProducerSourceIndexes: arenamod.ArenaArrayInt32
        functionSourceLocalRows: arenamod.ArenaArrayInt32
        functionDeclarationSourceLocalRows: arenamod.ArenaArrayInt32
        functionOwnerTokenIndexes: arenamod.ArenaArrayInt32
        # [X1b-ta-scratch] Per-append scratch, reused across sources.  Sized by
        # the global function/source bounds because the row index IS the global
        # function row; these used to be freshly `setLen` heap arrays on every
        # source (six allocations of 70-380 KB each, about half of the
        # `post_authority -> post_ta` phase's 136.5 MB).
        functionScratchProducerByRow: arenamod.ArenaArrayInt32
        functionScratchSourceLocalByRow: arenamod.ArenaArrayInt32
        functionScratchDeclarationLocalByRow: arenamod.ArenaArrayInt32
        functionScratchOwnerTokenByRow: arenamod.ArenaArrayInt32
        functionScratchSeenByRow: arenamod.ArenaArrayInt32
        functionScratchSourceStarts: arenamod.ArenaArrayInt32
        functionScratchSourceCounts: arenamod.ArenaArrayInt32
        functionReturnTypeIds: arenamod.ArenaArrayInt32
        bracketArgTokenStarts: arenamod.ArenaArrayInt32
        bracketArgTokenCounts: arenamod.ArenaArrayInt32
        bracketArgTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        genericSymbolProducerSourceIndexes: arenamod.ArenaArrayInt32
        genericSymbolDeclarationOwnerTokenIndexes: arenamod.ArenaArrayInt32
        genericSymbolNameTokenIndexes: arenamod.ArenaArrayInt32
        genericSymbolNameIds: arenamod.ArenaArrayInt32
        genericSymbolOrdinals: arenamod.ArenaArrayInt32
        genericSymbolSpanStarts: arenamod.ArenaArrayInt32
        genericSymbolSpanEnds: arenamod.ArenaArrayInt32
        genericSymbolOwnerTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        genericSymbolConstraintTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        genericSymbolDefaultTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        genericSymbolConstraintTypeIds: arenamod.ArenaArrayInt32
        genericSymbolDefaultTypeIds: arenamod.ArenaArrayInt32
        genericSymbolChildStarts: arenamod.ArenaArrayInt32
        genericSymbolChildCounts: arenamod.ArenaArrayInt32
        genericSymbolChildTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        genericSymbolChildTypeIds: arenamod.ArenaArrayInt32
        typeKinds: arenamod.ArenaArrayInt32
        scalarKinds: arenamod.ArenaArrayInt32
        symbolIds: arenamod.ArenaArrayInt32
        genericSymbolIds: arenamod.ArenaArrayInt32
        fixedLengths: arenamod.ArenaArrayInt32
        functionParamCounts: arenamod.ArenaArrayInt32
        # Object inheritance is an independent semantic edge.  It is never
        # flattened into the local field CSR below.
        baseTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        baseTypeIds: arenamod.ArenaArrayInt32
        childStarts: arenamod.ArenaArrayInt32
        childCounts: arenamod.ArenaArrayInt32
        childTypeIds: arenamod.ArenaArrayInt32
        childNameIds: arenamod.ArenaArrayInt32
        traitRuleKinds: arenamod.ArenaArrayInt32
        traitPremiseStarts: arenamod.ArenaArrayInt32
        traitPremiseCounts: arenamod.ArenaArrayInt32
        traitPremiseTypeIds: arenamod.ArenaArrayInt32
        managedFlags: arenamod.ArenaArrayInt32
        sendFlags: arenamod.ArenaArrayInt32
        syncFlags: arenamod.ArenaArrayInt32
        typeOriginKinds: arenamod.ArenaArrayInt32
        originTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        originProducerSourceIndexes: arenamod.ArenaArrayInt32
        symbolDeclarationRootTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        symbolProducerSourceIndexes: arenamod.ArenaArrayInt32
        symbolDeclarationOwnerTokenIndexes: arenamod.ArenaArrayInt32
        symbolNameIds: arenamod.ArenaArrayInt32
        symbolMemberStarts: arenamod.ArenaArrayInt32
        symbolMemberCounts: arenamod.ArenaArrayInt32
        memberProducerSourceIndexes: arenamod.ArenaArrayInt32
        memberDeclarationSymbolIds: arenamod.ArenaArrayInt32
        memberNameTokenIndexes: arenamod.ArenaArrayInt32
        memberNameIds: arenamod.ArenaArrayInt32
        memberOrdinals: arenamod.ArenaArrayInt32
        memberTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        memberTypeIds: arenamod.ArenaArrayInt32
        # Exact parser-forest ownership retained after the parser tree is
        # released.  Parent rows are postorder int32 coordinates; enclosing
        # SymbolIds are derived only from declaration-root/field ownership.
        typeSyntaxParentNodeIndexes: arenamod.ArenaArrayInt32
        typeSyntaxEnclosingSymbolIds: arenamod.ArenaArrayInt32
        resolutionTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        resolutionTargetSymbolIds: arenamod.ArenaArrayInt32
        genericResolutionTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        genericResolutionTargetGenericSymbolRows: arenamod.ArenaArrayInt32
        # One row for every resolved nominal TypeSyntax inside a type
        # declaration.  The declaration graph is the de-duplicated CSR below;
        # SCC rows are a deterministic proof over that exact graph.
        nominalDependencyCount: int32
        nominalDependencyTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        nominalDependencySourceSymbolIds: arenamod.ArenaArrayInt32
        nominalDependencyTargetSymbolIds: arenamod.ArenaArrayInt32
        nominalDependencyIndirectFlags: arenamod.ArenaArrayInt32
        symbolDependencyCount: int32
        symbolDependencyStarts: arenamod.ArenaArrayInt32
        symbolDependencyCounts: arenamod.ArenaArrayInt32
        symbolDependencyTargetSymbolIds: arenamod.ArenaArrayInt32
        symbolDependencyDirectFlags: arenamod.ArenaArrayInt32
        sccCount: int32
        symbolSccIds: arenamod.ArenaArrayInt32
        sccStarts: arenamod.ArenaArrayInt32
        sccCounts: arenamod.ArenaArrayInt32
        sccSymbolIds: arenamod.ArenaArrayInt32
        artifactRaw32: layout.FixedBytes32

    TypedExprTypeArenaBuildState = ref object
        tree: parser.ParserValueExprTree
        authority: TypedExprTypeResolutionAuthority
        # [S1b step-3 (3)] Global row spaces this state is sized for.  They come
        # from the caller (the merged forest's counts, or the sealed
        # declaration index's totals for the per-source driver), never from
        # `tree`, so every array below has one allocation site and one size.
        typeSyntaxCount: int32
        groupCount: int32
        # The field-CSR allocation cursor.  It persists on the state because
        # source k's declaration roots all have global rows greater than
        # source k-1's, so a per-source reset would silently shift every later
        # root's field range and corrupt symbolMemberStarts/Counts.
        fieldCount: int32
        symbolByDeclarationRoot: int32[]
        # [forward-decl] The declaration generic window, keyed by the exact
        # SymbolId `symbolByDeclarationRoot` maps each declaration root to.
        # Seeded before any source is resident, so a forward nominal's generic
        # extent is readable without touching a per-source prefix column.
        declarationGenericSymbolStarts: int32[]
        declarationGenericSymbolCounts: int32[]
        # [closure8] The SymbolId total the sealed declaration index predicts.
        # `symbolByDeclarationRoot` is seeded from that index at Init, so the
        # append phase never reaches into a source it has not appended; this
        # total is what the seal phase reconciles `value.symbolCount` against,
        # so a mismatch aborts instead of producing a short table.
        declarationSymbolTotal: int32
        # [forward-typeid] The deferred-TypeId queue and `ResolveNominal`'s
        # verdict for the row being processed.  They live on the state, not in
        # parameter lists, so that no caller of `AppendSourceFromTreeInto` /
        # `BuildStateInitInto` / `ResolveNominal` has to change: the queue's
        # size is exactly `limits.typeSyntaxCount`, which `AllocateFromLimits`
        # already has, and the verdict is consumed by `InternSyntaxRec` in the
        # same statement that produced it.  `forwardNominalRoot` is reset to
        # `-1` both at `ResolveNominal` entry and immediately before the
        # nominal/qualified dispatch, so a short-circuited dispatch can never
        # read a stale root.
        forwardNominal: typedExprTypeArenaPendingForwardNominal
        forwardNominalRoot: int32
        # [forward-replay-fixpoint] Set when a replay pass had to skip a row
        # because its target declaration was still deferred; the driver
        # re-walks the queue while the count grows.  A row still flagged after
        # the pass bound fails closed in
        # `TypedExprTypeArenaForwardNominalRequireDrainedInto`.
        forwardReplaySkipped: bool
        forwardReplayDeferredCount: int32
        # [forward-replay-progress] Deferred rows this pass actually BOUND.
        # A pass that binds at least one row has shrunk the flagged set, so the
        # driver re-walks; a pass that binds none is the fixpoint and the drained
        # check judges it.  This is what replaces the arbitrary pass cap: the
        # bound is now "one pass per deferred row", proved by the counter, not
        # assumed.
        forwardReplayBoundCount: int32
        authorityUsed: bool[]
        genericAuthorityUsed: bool[]
        fieldStartsByDeclarationRoot: int32[]
        fieldCountsByDeclarationRoot: int32[]
        fieldTypeSyntaxNodeIndexes: int32[]
        typeSyntaxParentNodeIndexes: int32[]
        typeSyntaxEnclosingSymbolIds: int32[]
        # [S1b step-3 (6)] Exact bracket fixed-array length per TypeSyntax row.
        # `typedExprTypeArenaBracketConstLength` runs the parser const
        # evaluator over the source tree; the seal-phase Preflight needs the
        # same verdict after every tree is gone, so the append phase stores it
        # here at the global row.  `-1` means "not a bounded const bracket".
        bracketConstLengths: int32[]
        # [builtin-ctor] Exact builtin type constructor arity per TypeSyntax
        # row, recorded by the append phase for the same reason as
        # `bracketConstLengths` above: identifying the base's spelling needs
        # the resident source tree, and the seal-phase Preflight runs after
        # every tree is gone.  `-1` means "the base is not a builtin type
        # constructor"; a positive value is the closed table's arity, and a
        # bracket application that carries it has no declaration authority
        # and no generic window to fall back on.
        builtinConstructorArities: int32[]
        # [forward-receipt] Append-phase receipt bitmap (`row IS the
        # index`).  `resolutionTypeSyntaxNodeIndexes` is a canonical
        # row-ordered column that `typedExprTypeArenaAppendColumn` hashes
        # IN THAT ORDER, so its row is recorded when the row is VISITED,
        # not when the forward replay happens to bind its TypeId.  This
        # bitmap is what makes the replay's "the receipt already exists"
        # claim checkable instead of assumed.  Plain heap array, outside
        # the pinned arena budget and outside `HashMaterialized` (same
        # rule as `blockedFlags`).
        resolutionReceiptRecorded: bool[]
        # [X1-dedup] Arena-resident dedup table.  These used to be heap
        # `int32[]` rebuilt in full on every mint; one insertion cost O(table)
        # allocation and the merge phase paid 2,070.9 MB for it (r63 bisect).
        # Reserved once at `TypeRowReserve` rows and written in place.
        bucketHeads: arenamod.ArenaArrayInt32
        bucketNext: arenamod.ArenaArrayInt32
        # [S1b arena-pin] The exact capacity `AllocateFromLimits` reserved
        # for this arena.  Not enumerated by
        # `typedExprTypeArenaHashMaterialized`, so it does not disturb
        # `artifactRaw32` (same rule as the [S1b-0c] columns above).
        pinnedArenaBytes: int32

    TypedExprTypeArenaPendingGenericApply = ref object
        typeIds: int32[]
        declarationRoots: int32[]
        typeSyntaxNodeIndexes: int32[]
        specializedDeclarationTypeIds: int32[]

    # [forward-typeid] The deterministic work queue for forward cross-source
    # TypeId binding.  Rows are GLOBAL TypeSyntax rows, enqueued in the order
    # `InternSyntaxRec` walks them (ascending within a source, sources in
    # `orderedSources` order), and global row order IS that order because the
    # per-source bases are prefix sums -- so the queue is in global postorder
    # by construction.  No hash traversal, no pointer order, no text key.
    # `blockedFlags` is the row-space bitmap (`row IS the index`), so "is this
    # row deferred?" is one int32-indexed bool read and is identical on every
    # run.  Plain heap arrays: this queue is NOT in the arena, so it is outside
    # the pinned-capacity budget and outside
    # `typedExprTypeArenaHashMaterialized`.
    typedExprTypeArenaPendingForwardNominal = ref object
        typeSyntaxNodeIndexes: int32[]
        declarationRoots: int32[]
        producerSourceIndexes: int32[]
        blockedFlags: bool[]

const
    TypedExprTypeArenaHashDomain = "cheng.typed_expr.type_arena"

# [merge-release] Drop the per-source tree slot this state parks during an
# append (the `state.tree = share(tree)` below).  The slot exists so the
# field-index and syntax-ownership passes can reach the tree through `state`;
# every reader of it runs inside the same append call, so nothing may read it
# after that call returns.  A share that outlives its source keeps the source's
# parse arena alive past the caller's ParserValueExprTreeRelease -- that
# release frees the arena only while no borrow lease is outstanding and the
# owner is still attached -- and leaves one resident parse footprint per merged
# source in the forest merge.
fn TypedExprTypeArenaBuildStateDetachSourceTree(
        state: var TypedExprTypeArenaBuildState) =
    if state.tree == nil:
        return
    state.tree = nil

# [S1b-1c] Arena-resident parser authority readers.
#
# The Seal phase runs after every parser tree has been released.  The seven
# remaining tree readers are redirected here instead of into the parser.  Each
# reader answers exactly what the parser accessor of the same name answered for
# the merged forest: the append phase materialised every column at the same
# global row coordinate (`typedExprTypeArenaFillTypeSyntax` rebases each
# source-local parser coordinate onto the destination base while the source is
# still resident), so this is a coordinate substitution, not a re-derivation.
# Absent markers are preserved verbatim: a `-1` in the tree is a `-1` here.
@borrows
fn typedExprTypeArenaSyntaxKindAt(
        value: TypedExprTypeArena,
        row: int32): parser.ParserTypeSyntaxKind =
    return parser.ParserTypeSyntaxKind(arenamod.ArenaArrayInt32Get(
        value.arena, value.typeSyntaxParserKinds, row))

