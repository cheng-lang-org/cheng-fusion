# csge_ir_cache — csg_e 跨文件增量化 spec Commit C: statements2/nodes2 IR 片段
# 的分片存储层 (新 Tier1, 不复用 compile_skip_cache.cheng Tier2)。
# spec: docs/beat-c-csge-incremental-spec.md §2.4 ("新增 Tier1...不能复用
# compile_skip_cache.cheng 本身: 其键 funcEmitCid 是 BodyIR 降级产物, 用它判断
# 要不要建 TypedExprIr 是先有鸡先有蛋倒置") + §3.4 Commit C ("存储层+编解码器,
# 无接线")。
#
# 状态: 纯加法, 不接入主构建路径 (Commit D 才在 TypedExprBuildIrForScope 前插
# 查询/splice 分支)。
#
# 工程范式镜像 compile_skip_cache.cheng 四条硬约束 (spec §2.4 "工程范式抄
# compile_skip_cache.cheng"):
#   ① env-gate 默认关 = 零回归字节等价 HEAD (CHENG_CSGE_IR_CACHE_ROOT 空 = 完全跳过)
#   ② miss 走现有路径绝不 fallback (Get 返回 Err, 调用方必须走正常构建, 不许猜测/降级)
#   ③ hit 二次校验防污染 (解码后的 sourcePath/functionName 必须与查询键完全一致,
#      不能只信任"文件在预期路径上"这一件事, 镜像 compile_skip_cache.cheng 的
#      contentCid 二次校验纪律)
#   ④ 空 key 拒收 panic (sourcePath/sourceContentHash/functionName 任一为空 = panic,
#      空键碰撞 = 任意函数命中他人缓存)
#
# 分片路径规则 (spec §2.4): <root>/<sourceContentHash[:2]>/<cacheKey>.frag
# cacheKey (spec §2.1 "函数体缓存键") = sha256(sourcePath 词法归一化, sourceContentHash,
# functionName, signatureLineNumber) —— sourcePath 归一化用 parser.ParserNormalizePath
# (剥尾随 "/"、折叠前导 "../" 段, 与 TypedExprSourcePathsEquivalent 内部调用的
# 同一个规范化原语); 指纹拼接用 Commit B 已交付的 csge_fingerprint.cheng 原语
# (不重新发明域隔离编码)。
#
# 范围边界 (实测记录, 供 Commit D 接线时注意): TypedExprSourcePathsEquivalent
# 除了 ParserNormalizePath 之外还有一段"一个绝对路径/一个相对路径, 且相对路径
# 是绝对路径的路径后缀"就判等价的逻辑 (typed_expr.cheng:16267-16292)——那段
# 依赖"两个路径联合判断", 无法收窄成"对单个路径算出一个跟对方无关的规范形" (缓存
# key 只能从一个字符串独立算出, 算不出"与某个尚不知道的绝对路径等价"这种关系)。
# 本文件的 CsgeIrCacheKey 只做 ParserNormalizePath 这一层 (尾随斜杠/前导 "../"
# 折叠), 不做 abs-vs-rel 后缀匹配。Commit D 接线时若调用方传入的 sourcePath
# 表示法不统一 (同一个 source 时而绝对路径时而相对路径), 需要调用方自己先统一
# 成一种表示法再喂给本文件, 不能依赖本文件替它做等价判断。
#
# 本文件不做"读取集比对/失效传播"判断 (spec §2.3, 那是 Commit D 接线时的调用方
# 职责: 调用方在 Get 命中后还要自己拿 fragment 携带的读取集跟当前 build 的
# sourceInterfaceHash 逐条比对) —— 本文件只负责"给定 key, 存/取一份 fragment
# 字节", 契约边界与 compile_skip_cache.cheng 一致 (它也不比较 typedFnCanonicalHash
# 以外的语义, 只做 cid 二次校验)。

import std/os
import std/result
import std/rawbytes
import cheng/core/lang/parser
import cheng/core/lang/csge_fingerprint as csgefp
import cheng/core/tooling/path as chengpath
import cheng/core/lang/typed_expr_frag_codec as tefc

# ---- env-gate (关 = 现有路径, 零回归) ----
fn CsgeIrCacheEnabled(): bool =
    return os.GetEnv("CHENG_CSGE_IR_CACHE_ROOT") != ""

fn CsgeIrCacheRoot(): str =
    return os.GetEnv("CHENG_CSGE_IR_CACHE_ROOT")

# 函数体缓存键 (spec §2.1): sourcePath 先词法归一化 (与 TypedExprSourcePathsEquivalent
# 同口径), 再与 sourceContentHash/functionName/signatureLineNumber 一起喂
# csge_fingerprint.cheng 的域隔离指纹原语 (长度前缀消 concat 歧义)。
@borrows
fn CsgeIrCacheKey(sourcePathRaw: str, sourceContentHash: str, functionName: str,
                   signatureLineNumber: int32): str =
    if sourcePathRaw == "" || sourceContentHash == "" || functionName == "":
        panic("csge_ir_cache_key_empty_input")
    let normalizedPath = parser.ParserNormalizePath(sourcePathRaw)
    var buf = csgefp.CsgeFingerprintNewBuf()
    csgefp.CsgeFingerprintAppendText(buf, "cheng.csge.ircache.key")
    csgefp.CsgeFingerprintAppendText(buf, normalizedPath)
    csgefp.CsgeFingerprintAppendText(buf, sourceContentHash)
    csgefp.CsgeFingerprintAppendText(buf, functionName)
    csgefp.CsgeFingerprintAppendU32(buf, signatureLineNumber)
    return csgefp.CsgeFingerprintFinalizeHex(buf)

# ---- 缓存路径: <root>/<sourceContentHash[:2]>/<cacheKey>.frag (spec §2.4) ----
# 按 sourceContentHash (非 cacheKey) 分片: 一个 source 变化时, 它名下的所有
# 函数缓存条目落在同一个分片目录里, 便于人工/工具按 source 粒度清理。
@borrows
fn CsgeIrCacheShardDir(sourceContentHash: str): str =
    if sourceContentHash == "":
        panic("csge_ir_cache_shard_empty_content_hash")
    let root = CsgeIrCacheRoot()
    let shard = chengpath.TextSlice(sourceContentHash, 0, 2)
    return root + "/" + shard

@borrows
fn CsgeIrCachePath(sourceContentHash: str, cacheKey: str): str =
    return CsgeIrCacheShardDir(sourceContentHash) + "/" + cacheKey + ".frag"

# ---- 查缓存: miss=Err 走现有路径; hit=decode+二次身份校验 (spec §2.4 门③) ----
fn CsgeIrCacheGet(sourcePathRaw: str, sourceContentHash: str, functionName: str,
                   signatureLineNumber: int32): Result[tefc.TypedExprIrFunctionFragment] =
    if !CsgeIrCacheEnabled():
        return Err[tefc.TypedExprIrFunctionFragment]("csge ir cache disabled (no-op)")
    if sourcePathRaw == "" || sourceContentHash == "" || functionName == "":
        panic("csge_ir_cache_get_empty_key_input")
    let cacheKey = CsgeIrCacheKey(sourcePathRaw, sourceContentHash, functionName, signatureLineNumber)
    let p = CsgeIrCachePath(sourceContentHash, cacheKey)
    if !os.FileExists(p):
        return Err[tefc.TypedExprIrFunctionFragment]("csge ir cache miss key=" + cacheKey)
    var readRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(p)
    if IsErr(readRes):
        return Err[tefc.TypedExprIrFunctionFragment]("csge ir cache read failed key=" + cacheKey)
    let bytes = Value(readRes)
    var cursor: int32
    let frag = tefc.TypedExprIrFunctionFragmentDecode(bytes, cursor)
    if cursor != rawbytes.BytesLen(bytes):
        panic("csge_ir_cache_trailing_bytes")
    # 命中后二次身份校验: 解码出的 sourcePath/functionName 必须与查询键完全
    # 一致, 防止 sha256 碰撞或分片目录被外部污染时静默张冠李戴 (镜像
    # compile_skip_cache.cheng CompileSkipCacheGet 的 contentCid 二次校验纪律,
    # 绝不降级成"反正拿到数据就用")。
    if parser.ParserNormalizePath(frag.sourcePath) != parser.ParserNormalizePath(sourcePathRaw):
        panic("csge_ir_cache_content_mismatch_source_path")
    if frag.functionName != functionName:
        panic("csge_ir_cache_content_mismatch_function_name")
    return Ok[tefc.TypedExprIrFunctionFragment](frag)

# ---- 写缓存: 空 key 拒收; 原子写 tmp+rename; 失败硬崩 (spec §2.4 门④) ----
fn CsgeIrCachePut(sourcePathRaw: str, sourceContentHash: str, functionName: str,
                   signatureLineNumber: int32, frag: tefc.TypedExprIrFunctionFragment): Result[bool] =
    if !CsgeIrCacheEnabled():
        return Ok[bool](true)
    if sourcePathRaw == "" || sourceContentHash == "" || functionName == "":
        panic("csge_ir_cache_put_empty_key_input")
    let cacheKey = CsgeIrCacheKey(sourcePathRaw, sourceContentHash, functionName, signatureLineNumber)
    let finalPath = CsgeIrCachePath(sourceContentHash, cacheKey)
    os.MkdirAll(CsgeIrCacheShardDir(sourceContentHash), 493)
    var enc: rawbytes.Bytes = tefc.TypedExprIrFunctionFragmentEncode(frag)
    let tmpPath = finalPath + ".tmp"
    if os.FileExists(tmpPath):
        os.RemoveFile(tmpPath)
    var writeRes: Result[bool] = os.WriteFileBytesResult(tmpPath, enc)
    rawbytes.BytesFree(enc)
    if IsErr(writeRes):
        os.RemoveFile(tmpPath)
        return Err[bool]("csge_ir_cache put: tmp write failed: " + tmpPath)
    if !os.FileExists(tmpPath):
        return Err[bool]("csge_ir_cache put: tmp missing after write: " + tmpPath)
    if os.RenameFile(tmpPath, finalPath):
        return Ok[bool](true)
    if os.FileExists(finalPath):
        os.RemoveFile(tmpPath)
        return Ok[bool](true)
    os.RemoveFile(tmpPath)
    return Err[bool]("csge_ir_cache put: rename failed: " + finalPath)
