    index.fieldOwnerTails = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=131")
    index.fieldRowNext = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=132")
    index.layoutBucketHeads = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=133")
    index.layoutNext = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=134")
    index.layoutHashes = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=135")
    index.layoutSourcePaths = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=136")
    index.layoutTypeNames = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=137")
    index.layoutStates = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=138")
    index.layoutSizeBytes = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=139")
    index.layoutAlignBytes = []
    index.permanentlySealed = false
    index.frozenReadOnlyQueries = false
    index.canonicalMetadataTransferred = false
    index.validationEpoch = 0
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=140")
    index.hardError = ""
    index.contentCacheReleased = true
    index.released = true
    index.releaseCount = index.releaseCount + 1

@borrows
fn TypedExprBuildIndexReleaseCount(index: TypedExprBuildIndex): int32 =
    if index == nil:
        return 0
    return index.releaseCount

@borrows
fn TypedExprBuildIndexContextCount(index: TypedExprBuildIndex): int32 =
    if index == nil:
        panic("typed expr: build index context count unavailable state=nil")
    if index.released:
        panic("typed expr: build index context count unavailable state=released")
    return index.contextCount

fn TypedExprSourceContextReleaseBuildIndex(ctx: var TypedExprSourceContext) =
    let index = share(ctx.buildIndex)
    let owned = ctx.buildIndexOwned
    # Detach first so repeated clear/release is idempotent even if the owner
    # points at a shell that another fail-stop path already released.
    ctx.buildIndex = nil
    ctx.buildIndexOwned = false
    if !owned || index == nil || index.released:
        return
    TypedExprBuildIndexRelease(index)

@borrows
fn TypedExprSourceContextSetBorrowedBuildIndex(ctx: var TypedExprSourceContext,
                                               index: TypedExprBuildIndex) =
    if index == nil:
        panic("typed expr: source context borrowed build index missing")
    if index.released:
        panic("typed expr: source context cannot borrow released build index")
    if ctx.buildIndex == index:
        if ctx.buildIndexOwned:
            panic("typed expr: owner-to-borrowed conversion requires an explicit source owner")
        return
    TypedExprSourceContextReleaseBuildIndex(ctx)
    ctx.buildIndex = index
    ctx.buildIndexOwned = false

fn TypedExprSourceContextSetOwnedBuildIndex(ctx: var TypedExprSourceContext,
                                            index: TypedExprBuildIndex) =
    TypedExprSourceContextReleaseBuildIndex(ctx)
    if index != nil && index.released:
        panic("typed expr: source context cannot own released build index")
    let indexOwned = index != nil
    ctx.buildIndex = index
    ctx.buildIndexOwned = indexOwned

fn TypedExprSourceContextTakeBuildIndex(ctx: var TypedExprSourceContext,
                                       indexOut: var TypedExprBuildIndex,
                                       ownedOut: var bool) =
    indexOut = ctx.buildIndex
    ownedOut = ctx.buildIndexOwned
    ctx.buildIndex = nil
    ctx.buildIndexOwned = false

fn TypedExprSourceContextRestoreBuildIndex(ctx: var TypedExprSourceContext,
                                          index: TypedExprBuildIndex,
                                          owned: bool) =
    if ctx.buildIndex != nil || ctx.buildIndexOwned:
        panic("typed expr: source context restore requires detached build index")
    if index != nil && index.released:
        panic("typed expr: source context cannot restore released build index")
    let restoreOwned = owned && index != nil
    ctx.buildIndex = index
    ctx.buildIndexOwned = restoreOwned

@borrows
fn typedExprSourceContextsDetachBorrowedBuildIndex(
        contexts: var TypedExprSourceContext[],
        index: TypedExprBuildIndex) =
    if index == nil:
        return
    for contextIndex in 0..<contexts.len:
        if contexts[contextIndex].buildIndex != index:
            continue
        if contexts[contextIndex].buildIndexOwned:
            panic("typed expr: cannot detach canonical build index owner as borrower")
        TypedExprSourceContextReleaseBuildIndex(contexts[contextIndex])

fn TypedExprSourceContextOwnsBuildIndex(ctx: var TypedExprSourceContext): bool =
    return ctx.buildIndexOwned && ctx.buildIndex != nil && !ctx.buildIndex.released

@borrows
fn TypedExprSourceContextBorrowBuildIndexFromOwner(ctx: var TypedExprSourceContext,
                                                   ownerCtx: TypedExprSourceContext) =
    let ownerIndex = ownerCtx.buildIndex
    if ownerIndex == nil || ownerIndex.released || !ownerCtx.buildIndexOwned:
        panic("typed expr: build-index borrow source is not a live owner")
    if ctx.buildIndex == ownerIndex:
        if ctx.buildIndexOwned:
            # A value copy of an owner carries the ownership bit. Demote only the
            # copy; touching the shared index would release the real owner's data.
            ctx.buildIndexOwned = false
            if !ownerCtx.buildIndexOwned:
                # Both var parameters refer to the same descriptor. Restore it
                # before fail-stop so the alias probe itself cannot leak ownership.
                ctx.buildIndexOwned = true
                panic("typed expr: build-index borrow target aliases owner descriptor")
        if ownerCtx.buildIndex != ownerIndex || ownerIndex.released ||
           !ownerCtx.buildIndexOwned:
            panic("typed expr: build-index owner changed during borrow")
        return
    # A different owned index belongs to the target and must be released before
    # replacing its descriptor. A different borrowed index is detached only.
    TypedExprSourceContextReleaseBuildIndex(ctx)
    if ownerCtx.buildIndex != ownerIndex || ownerIndex.released ||
       !ownerCtx.buildIndexOwned:
        panic("typed expr: build-index owner changed while replacing borrow target")
    ctx.buildIndex = ownerIndex
    ctx.buildIndexOwned = false

# [orcd8] ①号假设刀核心原语: 交换式逐列 move (具体类型重载)。out 拿走 src
# 现值, src 拿走 out 旧值 (MoveInto 调用点 out 已先 TypedExprClearSourceContext
# AllFields 全清空, 故 src 终值逐列可证空)。纯换手: 任何一步都不释放任何块,
# 对任意赋值语义精确 —— 每列换手后恰有一个持有人, 旧形 `out = ctx` 整构赋值
# + Clear(ctx) 的聚合拷贝对「列内 str 行块」丢 retain (mc_line 仪器实锤:
# 两结构体共享行头), merge 窗扫清的二次释放 (ORCM@13 32B 0xdd registry_miss
# 面) 由换手结构性消除: 源清退化为对全空头的 fail-closed 空操作。
# 泛型 var T 形态过不了 cold exact-copy 门 (bake R1 + probe R2 实证: generic
# specialization copy source is not exact @ str/struct), 必须具体类型重载。
# 语义先例 = 同文件 TypedExprIrMoveInto (:8946) 逐列显式 move; 通道先例 =
# ORCD6/mc 私钥习语 (所有权在换手点显式交接, 不继承别名)。
fn typedExprSwapMoveStr(out: var str, src: var str) =
    var swapMoveTmp: str
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveStrSeq(out: var str[], src: var str[]) =
    var swapMoveTmp: str[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveInt32Seq(out: var int32[], src: var int32[]) =
    var swapMoveTmp: int32[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveScopeSeq(out: var TypedExprFunctionScope[],
                             src: var TypedExprFunctionScope[]) =
    var swapMoveTmp: TypedExprFunctionScope[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveBindingSeq(out: var TypedExprBinding[],
                               src: var TypedExprBinding[]) =
    var swapMoveTmp: TypedExprBinding[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveImportcFunctionSeq(out: var TypedExprImportcFunction[],
                                       src: var TypedExprImportcFunction[]) =
    var swapMoveTmp: TypedExprImportcFunction[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveImportedModuleSeq(out: var TypedExprImportedModule[],
                                      src: var TypedExprImportedModule[]) =
    var swapMoveTmp: TypedExprImportedModule[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveTypeFieldDeclSeq(out: var TypedExprTypeFieldDecl[],
                                     src: var TypedExprTypeFieldDecl[]) =
    var swapMoveTmp: TypedExprTypeFieldDecl[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveColdCsgTypeRowSeq(out: var TypedExprColdCsgTypeRow[],
                                      src: var TypedExprColdCsgTypeRow[]) =
    var swapMoveTmp: TypedExprColdCsgTypeRow[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveColdCsgStatementRowSeq(
        out: var TypedExprColdCsgStatementRow[],
        src: var TypedExprColdCsgStatementRow[]) =
    var swapMoveTmp: TypedExprColdCsgStatementRow[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveBucketSeq(out: var parser.ParserSourcePathIndexBucket[],
                              src: var parser.ParserSourcePathIndexBucket[]) =
    var swapMoveTmp: parser.ParserSourcePathIndexBucket[]
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveBuildIndex(out: var TypedExprBuildIndex,
                               src: var TypedExprBuildIndex) =
    var swapMoveTmp: TypedExprBuildIndex
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

fn typedExprSwapMoveFrozenProjection(
        out: var typedExprFrozenMetadataProjection,
        src: var typedExprFrozenMetadataProjection) =
    var swapMoveTmp: typedExprFrozenMetadataProjection
    swapMoveTmp = out
    out = src
    src = swapMoveTmp

@borrows
fn typedExprSourceContextRetainedCopy(
        ctx: TypedExprSourceContext): TypedExprSourceContext =
    return ctx

@borrows
fn TypedExprSourceContextBorrowedView(
        ctx: TypedExprSourceContext): TypedExprSourceContext =
    if ctx.buildIndex != nil && ctx.buildIndex.released:
        panic("typed expr: source context cannot borrow released build index")
    var out = typedExprSourceContextRetainedCopy(ctx)
    if ctx.buildIndexOwned:
        TypedExprSourceContextBorrowBuildIndexFromOwner(out, ctx)
    else:
        out.buildIndexOwned = false
    return out

fn TypedExprSourceContextClone(ctx: var TypedExprSourceContext): TypedExprSourceContext =
    if ctx.buildIndex != nil && ctx.buildIndex.released:
        panic("typed expr: source context clone from released build index")
    var out = typedExprSourceContextRetainedCopy(ctx)
    out.buildIndex = TypedExprBuildIndexClone(ctx.buildIndex)
    out.buildIndexOwned = out.buildIndex != nil
    return out

fn TypedExprSourceContextTakeAt(items: var TypedExprSourceContext[],
                                 index: int32): TypedExprSourceContext =
    if index < 0 || index >= items.len:
        panic("typed expr: source context take index out of range")
    var out: TypedExprSourceContext
    TypedExprSourceContextMoveInto(out, items[index])
    return out

fn TypedExprSourceContextMoveInto(out: var TypedExprSourceContext,
                                  ctx: var TypedExprSourceContext) =
    TypedExprClearSourceContextAllFields(out)
    # [orcd9-inst] src 侧全列观测 + 出口标：O8MI-IN 与 O8MI-OK 之间崩 =
    # swap 释放 src 悬挂头（哪列非零即元凶）
    var o9MiBIdx: int32
    var o9MiProj: int32
    if orcd8TraceEnabled():
        if ctx.buildIndex != nil:
            o9MiBIdx = 1
        if ctx.frozenMetadataProjection != nil:
            o9MiProj = 1
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(),
                     Fmt"O8MI-IN srcPath={ctx.sourcePath.len} nsp={ctx.normalizedSourcePath.len} pok={ctx.packageOwnerKey.len} bIdx={o9MiBIdx} proj={o9MiProj} ln={ctx.lineNumbers.len} slb={ctx.sourceLineByteStarts.len} sll={ctx.sourceLineByteLengths.len} sloi={ctx.sourceLineOverrideIndexes.len} slot={ctx.sourceLineOverrideTexts.len} lines={ctx.lines.len} scopes={ctx.scopes.len} sig={ctx.signatureScopes.len} binds={ctx.bindings.len} impc={ctx.importcFunctions.len} impm={ctx.importedModules.len} dt={ctx.declaredTypes.len} dtpsi={ctx.declaredTypeProducerSourceIndexes.len} dtdslr={ctx.declaredTypeDeclarationSourceLocalRows.len} dtbk={ctx.declaredTypeBuiltinKinds.len} ref={ctx.refTypes.len} tdan={ctx.typeDefAliasNames.len} tdatt={ctx.typeDefAliasTargetTypes.len} tf={ctx.typeFields.len} cctr={ctx.coldCsgTypeRows.len} ccstr={ctx.coldCsgStatementRows.len} evn={ctx.enumValueNames.len} evt={ctx.enumValueTypes.len} evo={ctx.enumValueOrdinals.len} elch={ctx.exprLineColumnHeads.len} elcv={ctx.exprLineColumnValues.len} elcn={ctx.exprLineColumnNext.len} bnibh={ctx.bindingNameIndexBucketHeads.len} bnien={ctx.bindingNameIndexEntryNames.len} bnibi={ctx.bindingNameIndexEntryBindingIndexes.len} bnin={ctx.bindingNameIndexEntryNext.len} snibh={ctx.scopeNameIndexBucketHeads.len} snien={ctx.scopeNameIndexEntryNames.len} snisi={ctx.scopeNameIndexEntryScopeIndexes.len} snin={ctx.scopeNameIndexEntryNext.len} msl={ctx.moduleConstLookup.slots.len} mbl={ctx.moduleConstLookup.buckets.len} mcn={ctx.moduleConstNames.len} mcl={ctx.moduleConstLiterals.len} fhl={ctx.functionHeaderLookup.slots.len} fbl={ctx.functionHeaderLookup.buckets.len} fhn={ctx.functionHeaderNames.len} fhr={ctx.functionHeaderReturnTypes.len}")
    # [orcd8] ①号假设刀: 全列显式换手 move (列清单=结构体定义 68 列, 机械核对
    # 全覆盖)。标量列=值拷贝+哨兵清零; 托管列(str/str[]/结构体列/ref)走具体
    # 类型换手 helper。旧形 `out = ctx` 整构聚合拷贝对列内 str 行块丢 retain
    # (mc_line 仪器实锤「两结构体共享行头」), 换手使每列恰有一个持有人, 源清
    # 退化为可证空操作, 二次 clear 结构性不可能。
    typedExprSwapMoveBuildIndex(out.buildIndex, ctx.buildIndex)
    out.buildIndexOwned = ctx.buildIndexOwned
    ctx.buildIndexOwned = false
    typedExprSwapMoveFrozenProjection(out.frozenMetadataProjection,
                                      ctx.frozenMetadataProjection)
    out.frozenMetadataContextIndex = ctx.frozenMetadataContextIndex
    ctx.frozenMetadataContextIndex = -1
    typedExprSwapMoveStr(out.sourcePath, ctx.sourcePath)
    typedExprSwapMoveStr(out.normalizedSourcePath, ctx.normalizedSourcePath)
    typedExprSwapMoveStr(out.packageOwnerKey, ctx.packageOwnerKey)
    out.snapshotOnly = ctx.snapshotOnly
    ctx.snapshotOnly = false
    out.factsFunctionRangeUnionBuildCount =
        ctx.factsFunctionRangeUnionBuildCount
    ctx.factsFunctionRangeUnionBuildCount = 0
    out.factsFullSourceRescanCount = ctx.factsFullSourceRescanCount
    ctx.factsFullSourceRescanCount = 0
    typedExprSwapMoveInt32Seq(out.lineNumbers, ctx.lineNumbers)
    out.sourceLineCount = ctx.sourceLineCount
    ctx.sourceLineCount = 0
    out.sourceByteLength = ctx.sourceByteLength
    ctx.sourceByteLength = 0
    typedExprSwapMoveInt32Seq(out.sourceLineByteStarts,
                              ctx.sourceLineByteStarts)
    typedExprSwapMoveInt32Seq(out.sourceLineByteLengths,
                              ctx.sourceLineByteLengths)
    typedExprSwapMoveInt32Seq(out.sourceLineOverrideIndexes,
                              ctx.sourceLineOverrideIndexes)
    typedExprSwapMoveStrSeq(out.sourceLineOverrideTexts,
                            ctx.sourceLineOverrideTexts)
    out.sourceIndexProducerFullTraversalCount =
        ctx.sourceIndexProducerFullTraversalCount
    ctx.sourceIndexProducerFullTraversalCount = 0
    out.factsSelectedLineVisitCount = ctx.factsSelectedLineVisitCount
    ctx.factsSelectedLineVisitCount = Int64(0)
    out.factsSelectedLineBytes = ctx.factsSelectedLineBytes
    ctx.factsSelectedLineBytes = Int64(0)
    out.factsSelectedScopeVisitCount = ctx.factsSelectedScopeVisitCount
    ctx.factsSelectedScopeVisitCount = Int64(0)
    out.factsSelectedBindingVisitCount = ctx.factsSelectedBindingVisitCount
    ctx.factsSelectedBindingVisitCount = Int64(0)
    out.factsGlobalBindingVisitCount = ctx.factsGlobalBindingVisitCount
    ctx.factsGlobalBindingVisitCount = Int64(0)
    typedExprSwapMoveStrSeq(out.lines, ctx.lines)
    typedExprSwapMoveScopeSeq(out.scopes, ctx.scopes)
    typedExprSwapMoveScopeSeq(out.signatureScopes, ctx.signatureScopes)
    typedExprSwapMoveBindingSeq(out.bindings, ctx.bindings)
    typedExprSwapMoveImportcFunctionSeq(out.importcFunctions,
                                        ctx.importcFunctions)
    typedExprSwapMoveImportedModuleSeq(out.importedModules,
                                       ctx.importedModules)
    typedExprSwapMoveStrSeq(out.declaredTypes, ctx.declaredTypes)
    out.exactLayoutProducerSourceCount = ctx.exactLayoutProducerSourceCount
    ctx.exactLayoutProducerSourceCount = 0
    out.exactLayoutDeclarationSourceCount =
        ctx.exactLayoutDeclarationSourceCount
    ctx.exactLayoutDeclarationSourceCount = 0
    out.exactLayoutParserIdentityBound = ctx.exactLayoutParserIdentityBound
    ctx.exactLayoutParserIdentityBound = false
    typedExprSwapMoveInt32Seq(out.declaredTypeProducerSourceIndexes,
                              ctx.declaredTypeProducerSourceIndexes)
    typedExprSwapMoveInt32Seq(out.declaredTypeDeclarationSourceLocalRows,
                              ctx.declaredTypeDeclarationSourceLocalRows)
    typedExprSwapMoveInt32Seq(out.declaredTypeBuiltinKinds,
                              ctx.declaredTypeBuiltinKinds)
    typedExprSwapMoveStrSeq(out.refTypes, ctx.refTypes)
    typedExprSwapMoveStrSeq(out.typeDefAliasNames, ctx.typeDefAliasNames)
    typedExprSwapMoveStrSeq(out.typeDefAliasTargetTypes,
                            ctx.typeDefAliasTargetTypes)
    typedExprSwapMoveTypeFieldDeclSeq(out.typeFields, ctx.typeFields)
    typedExprSwapMoveColdCsgTypeRowSeq(out.coldCsgTypeRows,
                                       ctx.coldCsgTypeRows)
    typedExprSwapMoveColdCsgStatementRowSeq(out.coldCsgStatementRows,
                                            ctx.coldCsgStatementRows)
    typedExprSwapMoveStrSeq(out.enumValueNames, ctx.enumValueNames)
    typedExprSwapMoveStrSeq(out.enumValueTypes, ctx.enumValueTypes)
    typedExprSwapMoveInt32Seq(out.enumValueOrdinals, ctx.enumValueOrdinals)
    typedExprSwapMoveInt32Seq(out.exprLineColumnHeads, ctx.exprLineColumnHeads)
    typedExprSwapMoveInt32Seq(out.exprLineColumnValues,
                              ctx.exprLineColumnValues)
    typedExprSwapMoveInt32Seq(out.exprLineColumnNext, ctx.exprLineColumnNext)
    typedExprSwapMoveInt32Seq(out.bindingNameIndexBucketHeads,
                              ctx.bindingNameIndexBucketHeads)
    typedExprSwapMoveStrSeq(out.bindingNameIndexEntryNames,
                            ctx.bindingNameIndexEntryNames)
    typedExprSwapMoveInt32Seq(out.bindingNameIndexEntryBindingIndexes,
                              ctx.bindingNameIndexEntryBindingIndexes)
    typedExprSwapMoveInt32Seq(out.bindingNameIndexEntryNext,
                              ctx.bindingNameIndexEntryNext)
    out.bindingNameIndexBuiltCount = ctx.bindingNameIndexBuiltCount
    ctx.bindingNameIndexBuiltCount = -1
    typedExprSwapMoveInt32Seq(out.scopeNameIndexBucketHeads,
                              ctx.scopeNameIndexBucketHeads)
    typedExprSwapMoveStrSeq(out.scopeNameIndexEntryNames,
                            ctx.scopeNameIndexEntryNames)
    typedExprSwapMoveInt32Seq(out.scopeNameIndexEntryScopeIndexes,
                              ctx.scopeNameIndexEntryScopeIndexes)
    typedExprSwapMoveInt32Seq(out.scopeNameIndexEntryNext,
                              ctx.scopeNameIndexEntryNext)
    out.scopeNameIndexBuiltCount = ctx.scopeNameIndexBuiltCount
    ctx.scopeNameIndexBuiltCount = -1
    out.moduleConstScanned = ctx.moduleConstScanned
    ctx.moduleConstScanned = false
    typedExprSwapMoveInt32Seq(out.moduleConstLookup.slots,
                              ctx.moduleConstLookup.slots)
    typedExprSwapMoveBucketSeq(out.moduleConstLookup.buckets,
                               ctx.moduleConstLookup.buckets)
    typedExprSwapMoveStrSeq(out.moduleConstNames, ctx.moduleConstNames)
    typedExprSwapMoveStrSeq(out.moduleConstLiterals, ctx.moduleConstLiterals)
    out.moduleConstLookupTransientPeakBytes =
        ctx.moduleConstLookupTransientPeakBytes
    ctx.moduleConstLookupTransientPeakBytes = 0
    out.moduleConstLookupFinalized = ctx.moduleConstLookupFinalized
    ctx.moduleConstLookupFinalized = false
    out.functionHeaderScanned = ctx.functionHeaderScanned
    ctx.functionHeaderScanned = false
    typedExprSwapMoveInt32Seq(out.functionHeaderLookup.slots,
                              ctx.functionHeaderLookup.slots)
    typedExprSwapMoveBucketSeq(out.functionHeaderLookup.buckets,
                               ctx.functionHeaderLookup.buckets)
    typedExprSwapMoveStrSeq(out.functionHeaderNames, ctx.functionHeaderNames)
    typedExprSwapMoveStrSeq(out.functionHeaderReturnTypes,
                            ctx.functionHeaderReturnTypes)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8MI-OK")

fn TypedExprSourceContextMoveBorrowedIntoExisting(out: var TypedExprSourceContext,
                                                  borrowed: var TypedExprSourceContext) =
    let index = out.buildIndex
    let owned = out.buildIndexOwned
    if index == nil || index.released:
        panic("typed expr: borrowed context move destination has no live build index")
    if borrowed.buildIndex != index || borrowed.buildIndexOwned:
        panic("typed expr: borrowed context move descriptor mismatch")
    # A temporary detach distinguishes actual var-parameter aliasing from two
    # descriptors that legitimately reference the same owner.
    borrowed.buildIndex = nil
    if out.buildIndex != index:
        borrowed.buildIndex = index
        panic("typed expr: borrowed context move aliases destination descriptor")
    borrowed.buildIndex = index

    # Keep the destination's ownership state out of generic clear. The borrowed
    # value moves all ordinary fields, then the original descriptor is restored.
    out.buildIndex = nil
    out.buildIndexOwned = false
    TypedExprClearSourceContextAllFields(out)
    # [orcd9-inst] MB 入口标
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8MB-IN")
    # [orcd8] ①号假设刀: 普通列逐列换手 move (buildIndex/buildIndexOwned 由
    # 上方守卫托管, 换手区精确排除; 语义论证同 TypedExprSourceContextMoveInto)。
    typedExprSwapMoveFrozenProjection(out.frozenMetadataProjection,
                                      borrowed.frozenMetadataProjection)
    out.frozenMetadataContextIndex = borrowed.frozenMetadataContextIndex
    borrowed.frozenMetadataContextIndex = -1
    typedExprSwapMoveStr(out.sourcePath, borrowed.sourcePath)
    typedExprSwapMoveStr(out.normalizedSourcePath,
                         borrowed.normalizedSourcePath)
    typedExprSwapMoveStr(out.packageOwnerKey, borrowed.packageOwnerKey)
    out.snapshotOnly = borrowed.snapshotOnly
    borrowed.snapshotOnly = false
    out.factsFunctionRangeUnionBuildCount =
        borrowed.factsFunctionRangeUnionBuildCount
    borrowed.factsFunctionRangeUnionBuildCount = 0
    out.factsFullSourceRescanCount = borrowed.factsFullSourceRescanCount
    borrowed.factsFullSourceRescanCount = 0
    typedExprSwapMoveInt32Seq(out.lineNumbers, borrowed.lineNumbers)
    out.sourceLineCount = borrowed.sourceLineCount
    borrowed.sourceLineCount = 0
    out.sourceByteLength = borrowed.sourceByteLength
    borrowed.sourceByteLength = 0
    typedExprSwapMoveInt32Seq(out.sourceLineByteStarts,
                              borrowed.sourceLineByteStarts)
    typedExprSwapMoveInt32Seq(out.sourceLineByteLengths,
                              borrowed.sourceLineByteLengths)
    typedExprSwapMoveInt32Seq(out.sourceLineOverrideIndexes,
                              borrowed.sourceLineOverrideIndexes)
    typedExprSwapMoveStrSeq(out.sourceLineOverrideTexts,
                            borrowed.sourceLineOverrideTexts)
    out.sourceIndexProducerFullTraversalCount =
        borrowed.sourceIndexProducerFullTraversalCount
    borrowed.sourceIndexProducerFullTraversalCount = 0
    out.factsSelectedLineVisitCount = borrowed.factsSelectedLineVisitCount
    borrowed.factsSelectedLineVisitCount = Int64(0)
    out.factsSelectedLineBytes = borrowed.factsSelectedLineBytes
    borrowed.factsSelectedLineBytes = Int64(0)
    out.factsSelectedScopeVisitCount = borrowed.factsSelectedScopeVisitCount
    borrowed.factsSelectedScopeVisitCount = Int64(0)
    out.factsSelectedBindingVisitCount =
        borrowed.factsSelectedBindingVisitCount
    borrowed.factsSelectedBindingVisitCount = Int64(0)
    out.factsGlobalBindingVisitCount = borrowed.factsGlobalBindingVisitCount
    borrowed.factsGlobalBindingVisitCount = Int64(0)
    typedExprSwapMoveStrSeq(out.lines, borrowed.lines)
    typedExprSwapMoveScopeSeq(out.scopes, borrowed.scopes)
    typedExprSwapMoveScopeSeq(out.signatureScopes, borrowed.signatureScopes)
    typedExprSwapMoveBindingSeq(out.bindings, borrowed.bindings)
    typedExprSwapMoveImportcFunctionSeq(out.importcFunctions,
                                        borrowed.importcFunctions)
    typedExprSwapMoveImportedModuleSeq(out.importedModules,
                                       borrowed.importedModules)
    typedExprSwapMoveStrSeq(out.declaredTypes, borrowed.declaredTypes)
    out.exactLayoutProducerSourceCount =
        borrowed.exactLayoutProducerSourceCount
    borrowed.exactLayoutProducerSourceCount = 0
    out.exactLayoutDeclarationSourceCount =
        borrowed.exactLayoutDeclarationSourceCount
    borrowed.exactLayoutDeclarationSourceCount = 0
    out.exactLayoutParserIdentityBound =
        borrowed.exactLayoutParserIdentityBound
    borrowed.exactLayoutParserIdentityBound = false
    typedExprSwapMoveInt32Seq(out.declaredTypeProducerSourceIndexes,
                              borrowed.declaredTypeProducerSourceIndexes)
    typedExprSwapMoveInt32Seq(out.declaredTypeDeclarationSourceLocalRows,
                              borrowed.declaredTypeDeclarationSourceLocalRows)
    typedExprSwapMoveInt32Seq(out.declaredTypeBuiltinKinds,
                              borrowed.declaredTypeBuiltinKinds)
    typedExprSwapMoveStrSeq(out.refTypes, borrowed.refTypes)
    typedExprSwapMoveStrSeq(out.typeDefAliasNames, borrowed.typeDefAliasNames)
    typedExprSwapMoveStrSeq(out.typeDefAliasTargetTypes,
                            borrowed.typeDefAliasTargetTypes)
    typedExprSwapMoveTypeFieldDeclSeq(out.typeFields, borrowed.typeFields)
    typedExprSwapMoveColdCsgTypeRowSeq(out.coldCsgTypeRows,
                                       borrowed.coldCsgTypeRows)
    typedExprSwapMoveColdCsgStatementRowSeq(out.coldCsgStatementRows,
                                            borrowed.coldCsgStatementRows)
    typedExprSwapMoveStrSeq(out.enumValueNames, borrowed.enumValueNames)
    typedExprSwapMoveStrSeq(out.enumValueTypes, borrowed.enumValueTypes)
    typedExprSwapMoveInt32Seq(out.enumValueOrdinals,
                              borrowed.enumValueOrdinals)
    typedExprSwapMoveInt32Seq(out.exprLineColumnHeads,
                              borrowed.exprLineColumnHeads)
    typedExprSwapMoveInt32Seq(out.exprLineColumnValues,
                              borrowed.exprLineColumnValues)
    typedExprSwapMoveInt32Seq(out.exprLineColumnNext,
                              borrowed.exprLineColumnNext)
    typedExprSwapMoveInt32Seq(out.bindingNameIndexBucketHeads,
                              borrowed.bindingNameIndexBucketHeads)
    typedExprSwapMoveStrSeq(out.bindingNameIndexEntryNames,
                            borrowed.bindingNameIndexEntryNames)
    typedExprSwapMoveInt32Seq(out.bindingNameIndexEntryBindingIndexes,
                              borrowed.bindingNameIndexEntryBindingIndexes)
    typedExprSwapMoveInt32Seq(out.bindingNameIndexEntryNext,
                              borrowed.bindingNameIndexEntryNext)
    out.bindingNameIndexBuiltCount = borrowed.bindingNameIndexBuiltCount
    borrowed.bindingNameIndexBuiltCount = -1
    typedExprSwapMoveInt32Seq(out.scopeNameIndexBucketHeads,
                              borrowed.scopeNameIndexBucketHeads)
    typedExprSwapMoveStrSeq(out.scopeNameIndexEntryNames,
                            borrowed.scopeNameIndexEntryNames)
    typedExprSwapMoveInt32Seq(out.scopeNameIndexEntryScopeIndexes,
                              borrowed.scopeNameIndexEntryScopeIndexes)
    typedExprSwapMoveInt32Seq(out.scopeNameIndexEntryNext,
                              borrowed.scopeNameIndexEntryNext)
    out.scopeNameIndexBuiltCount = borrowed.scopeNameIndexBuiltCount
    borrowed.scopeNameIndexBuiltCount = -1
    out.moduleConstScanned = borrowed.moduleConstScanned
    borrowed.moduleConstScanned = false
    typedExprSwapMoveInt32Seq(out.moduleConstLookup.slots,
                              borrowed.moduleConstLookup.slots)
    typedExprSwapMoveBucketSeq(out.moduleConstLookup.buckets,
                               borrowed.moduleConstLookup.buckets)
    typedExprSwapMoveStrSeq(out.moduleConstNames, borrowed.moduleConstNames)
    typedExprSwapMoveStrSeq(out.moduleConstLiterals,
                            borrowed.moduleConstLiterals)
    out.moduleConstLookupTransientPeakBytes =
        borrowed.moduleConstLookupTransientPeakBytes
    borrowed.moduleConstLookupTransientPeakBytes = 0
    out.moduleConstLookupFinalized = borrowed.moduleConstLookupFinalized
    borrowed.moduleConstLookupFinalized = false
    out.functionHeaderScanned = borrowed.functionHeaderScanned
    borrowed.functionHeaderScanned = false
    typedExprSwapMoveInt32Seq(out.functionHeaderLookup.slots,
                              borrowed.functionHeaderLookup.slots)
    typedExprSwapMoveBucketSeq(out.functionHeaderLookup.buckets,
                               borrowed.functionHeaderLookup.buckets)
    typedExprSwapMoveStrSeq(out.functionHeaderNames,
                            borrowed.functionHeaderNames)
    typedExprSwapMoveStrSeq(out.functionHeaderReturnTypes,
                            borrowed.functionHeaderReturnTypes)
    borrowed.buildIndex = nil
    borrowed.buildIndexOwned = false
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8MB-MID")
    TypedExprClearSourceContextAllFields(borrowed)
    out.buildIndex = index
    out.buildIndexOwned = owned
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8MB-OK")
    if index.released:
        panic("typed expr: build index released during borrowed context move")

fn TypedExprSourceContextReleaseMovedSourceStorage(
        ctx: var TypedExprSourceContext) =
    # [orcd8-inst] 诊断探针（env=CHENG_ORCD8_TRACE）：强制行释出点归因
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(),
                     Fmt"O8FORCE src={ctx.sourcePath} names={ctx.moduleConstNames.len} lines={ctx.lines.len} scopes={ctx.scopes.len} binds={ctx.bindings.len}")
    seqs.freeSeq_int32(ctx.lineNumbers)
    seqs.freeSeq_int32(ctx.sourceLineByteStarts)
    seqs.freeSeq_int32(ctx.sourceLineByteLengths)
    seqs.freeSeq_int32(ctx.sourceLineOverrideIndexes)
    seqs.freeSeqStrRelease(ctx.sourceLineOverrideTexts)
    seqs.freeSeqStrRelease(ctx.lines)
    seqs.chengSeqFreeTyped(ctx.scopes)
    seqs.chengSeqFreeTyped(ctx.signatureScopes)
    seqs.chengSeqFreeTyped(ctx.bindings)
    seqs.chengSeqFreeTyped(ctx.importcFunctions)
    seqs.chengSeqFreeTyped(ctx.importedModules)
    seqs.freeSeqStrRelease(ctx.declaredTypes)
    seqs.freeSeq_int32(ctx.declaredTypeProducerSourceIndexes)
    seqs.freeSeq_int32(ctx.declaredTypeDeclarationSourceLocalRows)
    seqs.freeSeq_int32(ctx.declaredTypeBuiltinKinds)
    seqs.freeSeqStrRelease(ctx.refTypes)
    seqs.freeSeqStrRelease(ctx.typeDefAliasNames)
    seqs.freeSeqStrRelease(ctx.typeDefAliasTargetTypes)
    seqs.chengSeqFreeTyped(ctx.typeFields)
    seqs.chengSeqFreeTyped(ctx.coldCsgTypeRows)
    seqs.chengSeqFreeTyped(ctx.coldCsgStatementRows)
    seqs.freeSeqStrRelease(ctx.enumValueNames)
    seqs.freeSeqStrRelease(ctx.enumValueTypes)
    seqs.freeSeq_int32(ctx.enumValueOrdinals)
    seqs.freeSeq_int32(ctx.exprLineColumnHeads)
    seqs.freeSeq_int32(ctx.exprLineColumnValues)
    seqs.freeSeq_int32(ctx.exprLineColumnNext)
    seqs.freeSeq_int32(ctx.bindingNameIndexBucketHeads)
    seqs.freeSeqStrRelease(ctx.bindingNameIndexEntryNames)
    seqs.freeSeq_int32(ctx.bindingNameIndexEntryBindingIndexes)
    seqs.freeSeq_int32(ctx.bindingNameIndexEntryNext)
    seqs.freeSeq_int32(ctx.scopeNameIndexBucketHeads)
    seqs.freeSeqStrRelease(ctx.scopeNameIndexEntryNames)
    seqs.freeSeq_int32(ctx.scopeNameIndexEntryScopeIndexes)
    seqs.freeSeq_int32(ctx.scopeNameIndexEntryNext)
    seqs.chengSeqFreeTyped(ctx.moduleConstLookup.slots)
    seqs.chengSeqFreeTyped(ctx.moduleConstLookup.buckets)
    seqs.freeSeqStrRelease(ctx.moduleConstNames)
    seqs.freeSeqStrRelease(ctx.moduleConstLiterals)
    seqs.chengSeqFreeTyped(ctx.functionHeaderLookup.slots)
    seqs.chengSeqFreeTyped(ctx.functionHeaderLookup.buckets)
    seqs.freeSeqStrRelease(ctx.functionHeaderNames)
    seqs.freeSeqStrRelease(ctx.functionHeaderReturnTypes)
    # [orcd9-inst] 强制行释出完成标记
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8FDONE")

fn typedExprSourceContextMovedStorageEmpty(
        ctx: var TypedExprSourceContext): bool =
    return ctx.lineNumbers.len == 0 &&
           ctx.lineNumbers.cap == 0 &&
           ctx.sourceLineByteStarts.len == 0 &&
           ctx.sourceLineByteStarts.cap == 0 &&
           ctx.sourceLineByteLengths.len == 0 &&
           ctx.sourceLineByteLengths.cap == 0 &&
           ctx.sourceLineOverrideIndexes.len == 0 &&
           ctx.sourceLineOverrideIndexes.cap == 0 &&
           ctx.sourceLineOverrideTexts.len == 0 &&
           ctx.sourceLineOverrideTexts.cap == 0 &&
           ctx.lines.len == 0 &&
           ctx.lines.cap == 0 &&
           ctx.scopes.len == 0 &&
           ctx.scopes.cap == 0 &&
           ctx.signatureScopes.len == 0 &&
           ctx.signatureScopes.cap == 0 &&
           ctx.bindings.len == 0 &&
           ctx.bindings.cap == 0 &&
           ctx.importcFunctions.len == 0 &&
           ctx.importcFunctions.cap == 0 &&
           ctx.importedModules.len == 0 &&
           ctx.importedModules.cap == 0 &&
           ctx.declaredTypes.len == 0 &&
           ctx.declaredTypes.cap == 0 &&
           ctx.declaredTypeProducerSourceIndexes.len == 0 &&
           ctx.declaredTypeProducerSourceIndexes.cap == 0 &&
           ctx.declaredTypeDeclarationSourceLocalRows.len == 0 &&
           ctx.declaredTypeDeclarationSourceLocalRows.cap == 0 &&
           ctx.declaredTypeBuiltinKinds.len == 0 &&
           ctx.declaredTypeBuiltinKinds.cap == 0 &&
           ctx.refTypes.len == 0 &&
           ctx.refTypes.cap == 0 &&
           ctx.typeDefAliasNames.len == 0 &&
           ctx.typeDefAliasNames.cap == 0 &&
           ctx.typeDefAliasTargetTypes.len == 0 &&
           ctx.typeDefAliasTargetTypes.cap == 0 &&
           ctx.typeFields.len == 0 &&
           ctx.typeFields.cap == 0 &&
           ctx.coldCsgTypeRows.len == 0 &&
           ctx.coldCsgTypeRows.cap == 0 &&
           ctx.coldCsgStatementRows.len == 0 &&
           ctx.coldCsgStatementRows.cap == 0 &&
           ctx.enumValueNames.len == 0 &&
           ctx.enumValueNames.cap == 0 &&
           ctx.enumValueTypes.len == 0 &&
           ctx.enumValueTypes.cap == 0 &&
           ctx.enumValueOrdinals.len == 0 &&
           ctx.enumValueOrdinals.cap == 0 &&
           ctx.exprLineColumnHeads.len == 0 &&
           ctx.exprLineColumnHeads.cap == 0 &&
           ctx.exprLineColumnValues.len == 0 &&
           ctx.exprLineColumnValues.cap == 0 &&
           ctx.exprLineColumnNext.len == 0 &&
           ctx.exprLineColumnNext.cap == 0 &&
           ctx.bindingNameIndexBucketHeads.len == 0 &&
           ctx.bindingNameIndexBucketHeads.cap == 0 &&
           ctx.bindingNameIndexEntryNames.len == 0 &&
           ctx.bindingNameIndexEntryNames.cap == 0 &&
           ctx.bindingNameIndexEntryBindingIndexes.len == 0 &&
           ctx.bindingNameIndexEntryBindingIndexes.cap == 0 &&
           ctx.bindingNameIndexEntryNext.len == 0 &&
           ctx.bindingNameIndexEntryNext.cap == 0 &&
           ctx.scopeNameIndexBucketHeads.len == 0 &&
           ctx.scopeNameIndexBucketHeads.cap == 0 &&
           ctx.scopeNameIndexEntryNames.len == 0 &&
           ctx.scopeNameIndexEntryNames.cap == 0 &&
           ctx.scopeNameIndexEntryScopeIndexes.len == 0 &&
           ctx.scopeNameIndexEntryScopeIndexes.cap == 0 &&
           ctx.scopeNameIndexEntryNext.len == 0 &&
           ctx.scopeNameIndexEntryNext.cap == 0 &&
           ctx.moduleConstLookup.slots.len == 0 &&
           ctx.moduleConstLookup.slots.cap == 0 &&
           ctx.moduleConstLookup.buckets.len == 0 &&
           ctx.moduleConstLookup.buckets.cap == 0 &&
           ctx.moduleConstNames.len == 0 &&
           ctx.moduleConstNames.cap == 0 &&
           ctx.moduleConstLiterals.len == 0 &&
           ctx.moduleConstLiterals.cap == 0 &&
           ctx.functionHeaderLookup.slots.len == 0 &&
           ctx.functionHeaderLookup.slots.cap == 0 &&
           ctx.functionHeaderLookup.buckets.len == 0 &&
           ctx.functionHeaderLookup.buckets.cap == 0 &&
           ctx.functionHeaderNames.len == 0 &&
           ctx.functionHeaderNames.cap == 0 &&
           ctx.functionHeaderReturnTypes.len == 0 &&
           ctx.functionHeaderReturnTypes.cap == 0

fn TypedExprSourceContextAppendMove(out: var TypedExprSourceContext[],
                                    ctx: TypedExprSourceContext) =
    if ctx.sourcePath == "" ||
       !typedExprSequenceBufferUnique(out) ||
       !typedExprSourceContextMetadataBuffersUnique(ctx):
        panic("typed expr: source context append move ownership precondition failed")
    add(out, ctx)
    var sharedColumnId: int32
    var sharedColumnName: str
    var sharedRefCount: int32
    if typedExprSourceContextFirstSharedMetadataBufferInto(
           out[out.len - 1],
           sharedColumnId,
           sharedColumnName,
           sharedRefCount):
        panic(Fmt"typed expr: source context append move postcondition failed column={sharedColumnName} column_id={sharedColumnId} refcount={sharedRefCount}")

