        ir.nodes2_bindingDeclarationSourceLocalRows,
        nodeIndex)

@borrows
fn TypedExprIrNodeBindingPatternSourceLocalRowAt(
        ir: TypedExprIr,
        nodeIndex: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_bindingPatternSourceLocalRows,
        nodeIndex)

@borrows
fn TypedExprIrNodeBindingValueDefinitionRowAt(
        ir: TypedExprIr,
        nodeIndex: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_bindingValueDefinitionRows,
        nodeIndex)

@borrows
fn TypedExprIrNodeProducedValueDefinitionRowAt(
        ir: TypedExprIr,
        nodeIndex: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_producedValueDefinitionRows,
