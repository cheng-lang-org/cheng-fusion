        first, second, projection.fieldProducerSourceIndexes)
    typedExprCanonicalDigestInts(
        first, second,
        projection.fieldOwnerDeclarationSourceLocalRows)
    typedExprCanonicalDigestInts(
        first, second,
        projection.fieldDeclarationSourceLocalRows)
    typedExprCanonicalDigestInts(
        first, second, projection.fieldOrdinals)
    typedExprCanonicalDigestInts(
        first, second, projection.fieldBuiltinKinds)
    typedExprCanonicalDigestInts(first, second,
                                  projection.fieldBuildEntryIndexes)
    typedExprCanonicalDigestInts(first, second,
                                  projection.fieldBuildNodeIndexes)
    typedExprCanonicalDigestInts(first, second, projection.enumStarts)
    typedExprCanonicalDigestInts(first, second, projection.enumCounts)
    typedExprCanonicalDigestInts(first, second, projection.enumNameIds)
    typedExprCanonicalDigestInts(first, second, projection.enumTypeIds)
    typedExprCanonicalDigestInts(first, second, projection.enumOrdinals)
    typedExprCanonicalDigestInts(first, second,
                                  projection.enumNameBuildEntryIndexes)
    typedExprCanonicalDigestInts(first, second,
                                  projection.enumTypeBuildEntryIndexes)
    typedExprCanonicalDigestInts(first, second, projection.moduleConstStarts)
    typedExprCanonicalDigestInts(first, second, projection.moduleConstCounts)
    typedExprCanonicalDigestInts(first, second, projection.moduleConstNameIds)
    typedExprCanonicalDigestInts(first, second,
                                  projection.moduleConstLiteralIds)
    typedExprCanonicalDigestInts(first, second,
                                  projection.moduleConstBuildEntryIndexes)
    typedExprCanonicalDigestStep(first, second,
                                  projection.joinedLookupKeyBytes)

@borrows
fn typedExprFrozenExactRanges(starts: int32[],
                              counts: int32[],
                              contextCount: int32,
                              rowCount: int32,
                              label: str,
                              err: var str): bool =
    if starts.len != contextCount || counts.len != contextCount ||
       rowCount < 0:
        err = Fmt" typed expr: frozen metadata {label} range cardinality mismatch"
        return false
    var cursor: int32
    for contextIndex in 0..<contextCount:
        let count = counts[contextIndex]
        if starts[contextIndex] != cursor || count < 0:
            err = Fmt" typed expr: frozen metadata {label} range gap context_index={contextIndex}"
            return false
        cursor = typedExprCheckedAddInt32(cursor, count,
                                          "canonical_range_cursor")
        if cursor > rowCount:
            err = Fmt" typed expr: frozen metadata {label} range overflow context_index={contextIndex}"
            return false
    if cursor != rowCount:
        err = Fmt" typed expr: frozen metadata {label} range tail mismatch"
        return false
    return true

@borrows
fn typedExprFrozenScopeSchemaExact(rows: typedExprFrozenScopeSoA,
                                   contextCount: int32,
                                   label: str,
                                   err: var str): bool =
    let rowCount = rows.nameIds.len
    if rowCount != rows.producerDeclarationOrdinals.len ||
       rowCount != rows.startLines.len || rowCount != rows.endLines.len ||
       rowCount != rows.returnTypeIds.len ||
       rowCount != rows.borrowResults.len ||
       rowCount != rows.borrowsArguments.len ||
       rowCount != rows.manualConsumePresents.len ||
       rowCount != rows.manualConsumeFunctionDeclarationRows.len ||
       rowCount != rows.manualConsumeTargetParameterOrdinals.len ||
       rowCount != rows.manualConsumeSourceParameterOrdinals.len ||
       rowCount != rows.manualConsumeTargetParameterDeclarationRows.len ||
       rowCount != rows.manualConsumeSourceParameterDeclarationRows.len ||
       rowCount != rows.manualConsumeTargetTypeIds.len ||
       rowCount != rows.manualConsumeSourceTypeIds.len ||
       rowCount != rows.manualConsumeEffectCids.len ||
       rowCount != rows.genericStarts.len ||
       rowCount != rows.genericCounts.len ||
       rowCount != rows.paramStarts.len ||
       rowCount != rows.paramCounts.len ||
       !typedExprFrozenExactRanges(rows.contextStarts,
                                    rows.contextCounts,
                                    contextCount,
                                    rowCount,
                                    label,
                                    err):
        if err == "":
            err = Fmt" typed expr: frozen metadata {label} row columns mismatch"
        return false
    var genericCursor: int32
    var paramCursor: int32
    for rowIndex in 0..<rowCount:
        if rows.producerDeclarationOrdinals[rowIndex] < 0 ||
           rows.startLines[rowIndex] <= 0 ||
           rows.endLines[rowIndex] < rows.startLines[rowIndex] ||
           rows.genericStarts[rowIndex] != genericCursor ||
           rows.genericCounts[rowIndex] < 0 ||
           rows.paramStarts[rowIndex] != paramCursor ||
           rows.paramCounts[rowIndex] < 0:
            err = Fmt" typed expr: frozen metadata {label} semantic row invalid row={rowIndex}"
            return false
        if rows.manualConsumePresents[rowIndex]:
            if rows.manualConsumeFunctionDeclarationRows[rowIndex] < 0 ||
               rows.manualConsumeTargetParameterOrdinals[rowIndex] < 0 ||
               rows.manualConsumeSourceParameterOrdinals[rowIndex] < 0 ||
               rows.manualConsumeTargetParameterOrdinals[rowIndex] ==
                   rows.manualConsumeSourceParameterOrdinals[rowIndex] ||
               rows.manualConsumeTargetParameterDeclarationRows[rowIndex] < 0 ||
               rows.manualConsumeSourceParameterDeclarationRows[rowIndex] < 0 ||
               rows.manualConsumeTargetParameterDeclarationRows[rowIndex] ==
                   rows.manualConsumeSourceParameterDeclarationRows[rowIndex] ||
               rows.manualConsumeTargetTypeIds[rowIndex] < 0 ||
               rows.manualConsumeSourceTypeIds[rowIndex] < 0 ||
               rows.manualConsumeTargetTypeIds[rowIndex] ==
                   rows.manualConsumeSourceTypeIds[rowIndex] ||
               layout.FixedBytes32Equal(
                   rows.manualConsumeEffectCids[rowIndex],
                   layout.FixedBytes32()):
                err = Fmt" typed expr: frozen metadata {label} manual-consume row invalid row={rowIndex}"
                return false
        elif !typedExprManualConsumeEffectAbsent(
                 false,
                 rows.manualConsumeFunctionDeclarationRows[rowIndex],
                 rows.manualConsumeTargetParameterOrdinals[rowIndex],
                 rows.manualConsumeSourceParameterOrdinals[rowIndex],
                 rows.manualConsumeTargetParameterDeclarationRows[rowIndex],
                 rows.manualConsumeSourceParameterDeclarationRows[rowIndex],
                 rows.manualConsumeTargetTypeIds[rowIndex],
                 rows.manualConsumeSourceTypeIds[rowIndex],
                 rows.manualConsumeEffectCids[rowIndex]):
            err = Fmt" typed expr: frozen metadata {label} absent manual-consume row non-empty row={rowIndex}"
            return false
        genericCursor = typedExprCheckedAddInt32(
            genericCursor, rows.genericCounts[rowIndex],
            "canonical_scope_generic_cursor")
        if genericCursor > rows.genericNameIds.len:
            err = Fmt" typed expr: frozen metadata {label} generic range overflow row={rowIndex}"
            return false
        paramCursor = typedExprCheckedAddInt32(
            paramCursor, rows.paramCounts[rowIndex],
            "canonical_scope_param_cursor")
        if paramCursor > rows.paramTypeIds.len:
            err = Fmt" typed expr: frozen metadata {label} parameter range overflow row={rowIndex}"
            return false
    if genericCursor != rows.genericNameIds.len:
        err = Fmt" typed expr: frozen metadata {label} generic tail mismatch"
        return false
    if paramCursor != rows.paramTypeIds.len:
        err = Fmt" typed expr: frozen metadata {label} parameter tail mismatch"
        return false
    return true

@borrows
fn typedExprFrozenProjectionSchemaExact(
        projection: typedExprFrozenMetadataProjection,
        contextCount: int32,
        err: var str): bool =
    if projection == nil || projection.released ||
       projection.internPool == nil || contextCount <= 0 ||
       projection.rawSourcePathIds.len != contextCount ||
       projection.normalizedSourcePathIds.len != contextCount ||
       projection.packageOwnerIds.len != contextCount ||
       projection.snapshotOnly.len != contextCount ||
       projection.contextBuildEntryIndexes.len != contextCount ||
       projection.contextMetadataRowCounts.len != contextCount ||
       projection.sourceIndexProducerFullTraversalCounts.len != contextCount ||
       projection.sourceByteLengths.len != contextCount:
        err = " typed expr: frozen metadata canonical context columns mismatch"
        return false
    let sourceLineCount = projection.sourceLineByteStarts.len
    if sourceLineCount != projection.sourceLineByteLengths.len ||
       (projection.sourceLineOverrideTexts.len == 0 &&
        projection.sourceLineOverrideIndexes.len != 0) ||
       (projection.sourceLineOverrideTexts.len > 0 &&
        sourceLineCount != projection.sourceLineOverrideIndexes.len) ||
       !typedExprFrozenExactRanges(projection.sourceLineStarts,
                                    projection.sourceLineCounts,
                                    contextCount,
                                    sourceLineCount,
                                    "source_line",
                                    err):
        return false
    var overrideCursor: int32
    for contextIndex in 0..<contextCount:
        let lineStart = projection.sourceLineStarts[contextIndex]
        let lineCount = projection.sourceLineCounts[contextIndex]
        let sourceBytes = projection.sourceByteLengths[contextIndex]
        if projection.sourceIndexProducerFullTraversalCounts[contextIndex] != 1 ||
           lineCount <= 0 || sourceBytes < 0:
            err = Fmt" typed expr: frozen metadata source line domain invalid context_index={contextIndex}"
            return false
        for localIndex in 0..<lineCount:
            let rowIndex = lineStart + localIndex
            let byteStart = projection.sourceLineByteStarts[rowIndex]
            let byteLength = projection.sourceLineByteLengths[rowIndex]
            var overrideIndex: int32 = -1
            if projection.sourceLineOverrideIndexes.len > 0:
                overrideIndex = projection.sourceLineOverrideIndexes[rowIndex]
            if byteStart < 0 || byteLength < 0 ||
               byteStart > sourceBytes ||
               byteLength > sourceBytes - byteStart ||
               (localIndex == 0 && byteStart != 0) ||
               (localIndex > 0 &&
                (projection.sourceLineByteStarts[rowIndex - 1] < 0 ||
                 projection.sourceLineByteStarts[rowIndex - 1] >= sourceBytes ||
                 projection.sourceLineByteLengths[rowIndex - 1] < 0 ||
                 projection.sourceLineByteLengths[rowIndex - 1] >
                     sourceBytes -
                         projection.sourceLineByteStarts[rowIndex - 1] - 1 ||
                 byteStart !=
                     projection.sourceLineByteStarts[rowIndex - 1] +
                         projection.sourceLineByteLengths[rowIndex - 1] + 1)) ||
               (localIndex + 1 == lineCount &&
                byteLength != sourceBytes - byteStart) ||
               overrideIndex < -1 ||
               overrideIndex >= projection.sourceLineOverrideTexts.len ||
               (overrideIndex >= 0 && overrideIndex != overrideCursor):
                err = Fmt" typed expr: frozen metadata source line row invalid context_index={contextIndex} line={localIndex + 1}"
                return false
            if overrideIndex >= 0:
                overrideCursor = overrideCursor + 1
    if overrideCursor != projection.sourceLineOverrideTexts.len:
        err = Fmt" typed expr: frozen metadata source line override tail mismatch used={overrideCursor} rows={projection.sourceLineOverrideTexts.len}"
        return false
    let globalBindingCount = projection.globalBindingNameIds.len
    if globalBindingCount != projection.globalBindingLineNumbers.len ||
       globalBindingCount != projection.globalBindingTypeIds.len ||
       globalBindingCount !=
           projection.globalBindingProducerSourceIndexes.len ||
       globalBindingCount !=
           projection.globalBindingDeclarationSourceLocalRows.len ||
       globalBindingCount != projection.globalBindingMutableFlags.len ||
       globalBindingCount != projection.globalBindingInitValueIds.len ||
       globalBindingCount != projection.globalBindingNext.len ||
       globalBindingCount != projection.globalBindingHashes.len ||
       projection.globalBindingBucketHeads.len <= 0 ||
       !typedExprFrozenExactRanges(projection.globalBindingStarts,
                                    projection.globalBindingCounts,
                                    contextCount,
                                    globalBindingCount,
                                    "global_binding",
                                    err):
        return false
    for contextIndex in 0..<contextCount:
        let start = projection.globalBindingStarts[contextIndex]
        for localIndex in 0..<projection.globalBindingCounts[contextIndex]:
            let rowIndex = start + localIndex
            if projection.globalBindingLineNumbers[rowIndex] <= 0 ||
               projection.globalBindingLineNumbers[rowIndex] >
                   projection.sourceLineCounts[contextIndex] ||
               projection.globalBindingNameIds[rowIndex] < 0 ||
               projection.globalBindingTypeIds[rowIndex] < 0 ||
               projection.globalBindingProducerSourceIndexes[rowIndex] < 0 ||
               projection.globalBindingDeclarationSourceLocalRows[rowIndex] <
                   0 ||
               projection.globalBindingInitValueIds[rowIndex] < 0 ||
               projection.globalBindingNext[rowIndex] < -1 ||
               projection.globalBindingNext[rowIndex] >= globalBindingCount:
                err = Fmt" typed expr: frozen metadata global binding row invalid context_index={contextIndex} row={localIndex}"
                return false
            let name = typedExprFrozenProjectionText(
                projection, projection.globalBindingNameIds[rowIndex])
            if typedExprFrozenGlobalBindingRowLookup(
                   projection, contextIndex, name) != rowIndex:
                err = Fmt" typed expr: frozen metadata global binding index mismatch context_index={contextIndex} row={localIndex}"
                return false
    for bucketIndex in 0..<projection.globalBindingBucketHeads.len:
        let head = projection.globalBindingBucketHeads[bucketIndex]
        if head < -1 || head >= globalBindingCount:
            err = Fmt" typed expr: frozen metadata global binding bucket invalid bucket={bucketIndex} head={head}"
            return false
    if !typedExprFrozenScopeSchemaExact(projection.scopes,
                                         contextCount,
                                         "scope",
                                         err) ||
       !typedExprFrozenScopeSchemaExact(projection.signatures,
                                         contextCount,
                                         "signature_scope",
                                         err):
        return false
    let importcCount = projection.importcs.nameIds.len
    if importcCount !=
           projection.importcs.producerDeclarationOrdinals.len ||
       importcCount != projection.importcs.targetIds.len ||
       importcCount != projection.importcs.returnTypeIds.len ||
       importcCount != projection.importcs.paramStarts.len ||
       importcCount != projection.importcs.paramCounts.len ||
       importcCount != projection.importcs.ffiMapPtrArgs.len ||
       importcCount != projection.importcs.ffiMapLenArgs.len ||
       importcCount != projection.importcs.ffiOutPtrArgIds.len ||
       importcCount != projection.importcs.abiInternals.len ||
       importcCount != projection.importcs.ffiOwnedResultPresents.len ||
       importcCount != projection.importcs.ffiOwnedResultFreeIds.len ||
       !typedExprFrozenExactRanges(projection.importcs.contextStarts,
                                    projection.importcs.contextCounts,
                                    contextCount,
                                    importcCount,
                                    "importc",
                                    err):
        if err == "":
            err = " typed expr: frozen metadata importc columns mismatch"
        return false
    var paramCursor: int32
    for rowIndex in 0..<importcCount:
        if projection.importcs.producerDeclarationOrdinals[rowIndex] < 0 ||
           projection.importcs.paramStarts[rowIndex] != paramCursor ||
           projection.importcs.paramCounts[rowIndex] < 0:
            err = Fmt" typed expr: frozen metadata importc parameter range gap row={rowIndex}"
            return false
        paramCursor = typedExprCheckedAddInt32(
            paramCursor,
            projection.importcs.paramCounts[rowIndex],
            "canonical_importc_param_cursor")
        if paramCursor > projection.importcs.paramTypeIds.len:
            err = Fmt" typed expr: frozen metadata importc parameter range overflow row={rowIndex}"
            return false
    if paramCursor != projection.importcs.paramTypeIds.len:
        err = " typed expr: frozen metadata importc parameter tail mismatch"
        return false
    if projection.importQualifierIds.len !=
           projection.importTargetSourcePathIds.len ||
       projection.importQualifierIds.len !=
           projection.importBuildEntryIndexes.len ||
       projection.importQualifierIds.len !=
           projection.importTargetBuildEntryIndexes.len ||
       !typedExprFrozenExactRanges(projection.importStarts,
                                    projection.importCounts,
                                    contextCount,
                                    projection.importQualifierIds.len,
                                    "import",
                                    err):
        return false
    if projection.declaredTypeIds.len !=
           projection.declaredBuildEntryIndexes.len ||
       projection.declaredTypeIds.len !=
           projection.declaredTypeProducerSourceIndexes.len ||
       projection.declaredTypeIds.len !=
           projection.declaredTypeDeclarationSourceLocalRows.len ||
       projection.declaredTypeIds.len !=
           projection.declaredTypeBuiltinKinds.len ||
       !typedExprFrozenExactRanges(projection.declaredStarts,
                                    projection.declaredCounts,
                                    contextCount,
                                    projection.declaredTypeIds.len,
                                    "declared",
                                    err):
        return false
    for row in 0..<projection.declaredTypeIds.len:
        let builtinRaw = projection.declaredTypeBuiltinKinds[row]
        if builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(TypedExprLayoutBuiltinOptional):
            err = " typed expr: frozen declared builtin kind invalid"
            return false
        let builtinKind = TypedExprLayoutBuiltinKind(
            builtinRaw)
        if projection.declaredTypeProducerSourceIndexes[row] < 0 ||
           ((builtinKind == TypedExprLayoutBuiltinNone) !=
            (projection.declaredTypeDeclarationSourceLocalRows[row] >=
             0)):
            err = " typed expr: frozen declared exact coordinate invalid"
            return false
    if projection.refTypeIds.len != projection.refBuildEntryIndexes.len ||
       !typedExprFrozenExactRanges(projection.refStarts,
                                    projection.refCounts,
                                    contextCount,
                                    projection.refTypeIds.len,
                                    "ref",
                                    err):
        return false
    if projection.aliasNameIds.len != projection.aliasTargetTypeIds.len ||
       projection.aliasNameIds.len != projection.aliasBuildEntryIndexes.len ||
       !typedExprFrozenExactRanges(projection.aliasStarts,
                                    projection.aliasCounts,
                                    contextCount,
                                    projection.aliasNameIds.len,
                                    "alias",
                                    err):
        return false
    let fieldCount = projection.fieldOwnerTypeIds.len
    if fieldCount != projection.fieldNameIds.len ||
       fieldCount != projection.fieldTypeIds.len ||
       fieldCount != projection.fieldOffsetBytes.len ||
       fieldCount != projection.fieldSizeBytes.len ||
       fieldCount != projection.fieldAlignBytes.len ||
       fieldCount != projection.fieldProducerSourceIndexes.len ||
       fieldCount !=
           projection.fieldOwnerDeclarationSourceLocalRows.len ||
       fieldCount !=
           projection.fieldDeclarationSourceLocalRows.len ||
       fieldCount != projection.fieldOrdinals.len ||
       fieldCount != projection.fieldBuiltinKinds.len ||
       fieldCount != projection.fieldBuildEntryIndexes.len ||
       fieldCount != projection.fieldBuildNodeIndexes.len ||
       !typedExprFrozenExactRanges(projection.fieldStarts,
                                    projection.fieldCounts,
                                    contextCount,
                                    fieldCount,
                                    "field",
                                    err):
        return false
    for row in 0..<fieldCount:
        let builtinRaw = projection.fieldBuiltinKinds[row]
        if builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(TypedExprLayoutBuiltinOptional):
            err = " typed expr: frozen field builtin kind invalid"
            return false
        let builtinKind = TypedExprLayoutBuiltinKind(
            builtinRaw)
        if projection.fieldProducerSourceIndexes[row] < 0 ||
           projection.fieldOrdinals[row] < 0 ||
           ((builtinKind == TypedExprLayoutBuiltinNone) !=
            (projection.fieldOwnerDeclarationSourceLocalRows[row] >= 0 &&
             projection.fieldDeclarationSourceLocalRows[row] >= 0)):
            err = " typed expr: frozen field exact coordinate invalid"
            return false
    let enumCount = projection.enumNameIds.len
    if enumCount != projection.enumTypeIds.len ||
       enumCount != projection.enumOrdinals.len ||
       enumCount != projection.enumNameBuildEntryIndexes.len ||
       enumCount != projection.enumTypeBuildEntryIndexes.len ||
       !typedExprFrozenExactRanges(projection.enumStarts,
                                    projection.enumCounts,
                                    contextCount,
                                    enumCount,
                                    "enum",
                                    err):
        return false
    if projection.moduleConstNameIds.len !=
           projection.moduleConstLiteralIds.len ||
       projection.moduleConstNameIds.len !=
           projection.moduleConstBuildEntryIndexes.len ||
       !typedExprFrozenExactRanges(projection.moduleConstStarts,
                                    projection.moduleConstCounts,
                                    contextCount,
                                    projection.moduleConstNameIds.len,
                                    "moduleconst",
                                    err):
        return false
    err = ""
    return true

@borrows
fn typedExprExactBucketBijection(bucketHeads: int32[],
                                 next: int32[],
                                 hashes: int32[],
                                 rowCount: int32,
                                 activeRows: bool[],
                                 label: str,
                                 err: var str): bool =
    if bucketHeads.len <= 0 || next.len != rowCount ||
       hashes.len != rowCount ||
       (activeRows.len != 0 && activeRows.len != rowCount):
        err = Fmt" typed expr: {label} bucket cardinality mismatch"
        return false
    var visited: bool[]
    for rowIndex in 0..<rowCount:
        add(visited, false)
    for bucketIndex in 0..<bucketHeads.len:
        var rowIndex = bucketHeads[bucketIndex]
        var chainCount: int32
        while rowIndex >= 0:
            if rowIndex >= rowCount || visited[rowIndex] ||
               (activeRows.len != 0 && !activeRows[rowIndex]) ||
               TypedExprBuildIndexBucket(hashes[rowIndex],
                                         bucketHeads.len) != bucketIndex:
                err = Fmt" typed expr: {label} bucket chain invalid bucket={bucketIndex} row={rowIndex}"
                return false
            visited[rowIndex] = true
            chainCount = typedExprCheckedAddInt32(
                chainCount, 1, "canonical_bucket_chain_count")
            if chainCount > rowCount:
                err = Fmt" typed expr: {label} bucket cycle bucket={bucketIndex}"
                return false
            rowIndex = next[rowIndex]
    for rowIndex in 0..<rowCount:
        let expected = activeRows.len == 0 || activeRows[rowIndex]
        if visited[rowIndex] != expected:
            err = Fmt" typed expr: {label} bucket bijection mismatch row={rowIndex}"
            return false
        if !expected && (next[rowIndex] != -1 || hashes[rowIndex] != 0):
            err = Fmt" typed expr: {label} inactive row linked row={rowIndex}"
            return false
    return true

@borrows
fn typedExprFrozenScopeTopologyExact(
        projection: typedExprFrozenMetadataProjection,
        rows: typedExprFrozenScopeSoA,
        bucketHeads: int32[],
        next: int32[],
        hashes: int32[],
        snapshotOnly: bool,
        label: str,
        err: var str): bool =
    var activeRows: bool[]
    if snapshotOnly:
        for rowIndex in 0..<rows.nameIds.len:
            let contextIndex = typedExprFrozenScopeRowContextIndex(rows,
                                                                    rowIndex)
            if contextIndex < 0 || contextIndex >= projection.snapshotOnly.len:
                err = Fmt" typed expr: {label} row has no context row={rowIndex}"
                return false
            add(activeRows, projection.snapshotOnly[contextIndex])
    if !typedExprExactBucketBijection(bucketHeads,
                                       next,
                                       hashes,
                                       rows.nameIds.len,
                                       activeRows,
                                       label,
                                       err):
        return false
    for rowIndex in 0..<rows.nameIds.len:
        if snapshotOnly && !activeRows[rowIndex]:
            continue
        let contextIndex = typedExprFrozenScopeRowContextIndex(rows,
                                                                rowIndex)
        let name = typedExprFrozenProjectionText(projection,
                                                  rows.nameIds[rowIndex])
        let startLine = snapshotOnly ? 0 : rows.startLines[rowIndex]
        if hashes[rowIndex] != typedExprFrozenStructuredHash(contextIndex,
                                                              name,
                                                              startLine):
            err = Fmt" typed expr: {label} row hash mismatch row={rowIndex}"
            return false
    return true

@borrows
fn typedExprFrozenProjectionFindTextId(
        projection: typedExprFrozenMetadataProjection,
        text: str): langintern.InternId =
    if projection == nil || projection.released ||
       projection.internPool == nil:
        return langintern.InvalidInternId()
    return langintern.FindInternId(projection.internPool, text)

fn typedExprFrozenExpectedEntryAuditNew(
        rowCount: int32): typedExprFrozenExpectedEntryAudit =
    var out: typedExprFrozenExpectedEntryAudit
    for rowIndex in 0..<rowCount:
        add(out.seen, false)
        add(out.states, TypedExprBuildIndexMissing)
        add(out.valueIndexes, -1)
        add(out.originIds, langintern.InvalidInternId())
        add(out.fingerprintIds, langintern.InvalidInternId())
    return out

@borrows
fn typedExprFrozenAuditExpectedEntry(
        index: TypedExprBuildIndex,
        projection: typedExprFrozenMetadataProjection,
        audit: var typedExprFrozenExpectedEntryAudit,
        kind: str,
        sourcePath: str,
        name: str,
        detail: str,
        valueIndex: int32,
        origin: str,
        fingerprint: str,
        err: var str): bool =
    let rowIndex = TypedExprBuildIndexFindEntry(index,
                                                 kind,
                                                 sourcePath,
                                                 name,
                                                 detail,
                                                 false)
    if rowIndex < 0 || rowIndex >= audit.seen.len:
        err = Fmt" typed expr: canonical expected entry missing kind={kind} source={sourcePath} name={name} detail={detail}"
        return false
    let originId = typedExprFrozenProjectionFindTextId(projection, origin)
    let fingerprintId = typedExprFrozenProjectionFindTextId(projection,
                                                              fingerprint)
    if originId < 0 || fingerprintId < 0:
        err = Fmt" typed expr: canonical expected entry text not interned kind={kind} row={rowIndex}"
        return false
    if !audit.seen[rowIndex]:
        audit.seen[rowIndex] = true
        audit.states[rowIndex] = TypedExprBuildIndexUnique
        audit.valueIndexes[rowIndex] = valueIndex
        audit.originIds[rowIndex] = originId
        audit.fingerprintIds[rowIndex] = fingerprintId
        return true
    # Registration keeps the first payload and turns only a different
    # origin/fingerprint pair into an ambiguous aggregate row.
    if audit.originIds[rowIndex] != originId ||
       audit.fingerprintIds[rowIndex] != fingerprintId:
        audit.states[rowIndex] = TypedExprBuildIndexAmbiguous
        audit.valueIndexes[rowIndex] = -1
    return true

@borrows
fn typedExprFrozenFinishExpectedEntryAudit(
        index: TypedExprBuildIndex,
        audit: typedExprFrozenExpectedEntryAudit,
        err: var str): bool =
    let rowCount = typedExprBuildIndexEntryCount(index)
    if audit.seen.len != rowCount || audit.states.len != rowCount ||
       audit.valueIndexes.len != rowCount || audit.originIds.len != rowCount ||
       audit.fingerprintIds.len != rowCount:
        err = " typed expr: canonical expected entry audit columns mismatch"
        return false
    for rowIndex in 0..<rowCount:
        if !audit.seen[rowIndex] ||
           index.entryStates[rowIndex] != audit.states[rowIndex] ||
           index.entryValueIndexes[rowIndex] != audit.valueIndexes[rowIndex] ||
           index.entryOriginIds[rowIndex] != audit.originIds[rowIndex] ||
           index.entryFingerprintIds[rowIndex] !=
               audit.fingerprintIds[rowIndex]:
            err = Fmt" typed expr: canonical expected entry bijection mismatch row={rowIndex}"
            return false
    return true

fn typedExprFrozenExpectedVisibilityAuditNew(
        rowCount: int32): typedExprFrozenExpectedVisibilityAudit =
    var out: typedExprFrozenExpectedVisibilityAudit
    for rowIndex in 0..<rowCount:
        add(out.seen, false)
    return out

@borrows
fn typedExprFrozenAuditExpectedVisibility(
        index: TypedExprBuildIndex,
        audit: var typedExprFrozenExpectedVisibilityAudit,
        kind: str,
        sourcePath: str,
        name: str,
        detail: str,
        valueIndex: int32,
        fingerprint: str,
        err: var str): bool =
    let rowIndex = TypedExprBuildIndexFindVisibilityDeclaration(
        index, kind, sourcePath, name, detail, false)
    if rowIndex < 0 || rowIndex >= audit.seen.len ||
       index.visibilityValueIndexes[rowIndex] != valueIndex ||
       typedExprBuildIndexVisibilityFingerprint(index, rowIndex) != fingerprint:
        err = Fmt" typed expr: canonical expected visibility mismatch kind={kind} source={sourcePath} name={name} detail={detail}"
        return false
    audit.seen[rowIndex] = true
    return true

@borrows
fn typedExprFrozenFinishExpectedVisibilityAudit(
        index: TypedExprBuildIndex,
        audit: typedExprFrozenExpectedVisibilityAudit,
        err: var str): bool =
    if audit.seen.len != typedExprBuildIndexVisibilityCount(index):
        err = " typed expr: canonical expected visibility cardinality mismatch"
        return false
    for rowIndex in 0..<audit.seen.len:
        if !audit.seen[rowIndex]:
            err = Fmt" typed expr: canonical expected visibility orphan row={rowIndex}"
            return false
    return true

@borrows
fn typedExprFrozenExpectedCanonicalRowsExact(
        session: typedExprFrozenMetadataSession,
        err: var str): bool =
    let projection = session.projection
    let index = session.index
    var entries = typedExprFrozenExpectedEntryAuditNew(
        typedExprBuildIndexEntryCount(index))
    var visibility = typedExprFrozenExpectedVisibilityAuditNew(
        typedExprBuildIndexVisibilityCount(index))
    var fieldOwnerCounts: int32[]
    setLen(fieldOwnerCounts,
           langintern.InternPoolCount(projection.internPool))
    var declarationBase: int32
    for contextIndex in 0..<session.contextCount:
        let sourcePath = typedExprFrozenProjectionText(
            projection, projection.normalizedSourcePathIds[contextIndex])
        if !typedExprFrozenAuditExpectedEntry(
                index, projection, entries, "ctx_source", sourcePath,
                "", "", contextIndex, sourcePath, sourcePath, err):
            return false

        let importStart = projection.importStarts[contextIndex]
        for localIndex in 0..<projection.importCounts[contextIndex]:
            let rowIndex = importStart + localIndex
            let qualifier = typedExprFrozenProjectionText(
                projection, projection.importQualifierIds[rowIndex])
            let target = typedExprFrozenProjectionText(
                projection, projection.importTargetSourcePathIds[rowIndex])
            let targetContextIndex = typedExprFrozenContextIndexForPath(
                projection, target)
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_import_alias",
                    sourcePath, qualifier, "", targetContextIndex,
                    sourcePath, target, err):
                return false
            if targetContextIndex >= 0 &&
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_import_target",
                    sourcePath, target, "", targetContextIndex,
                    sourcePath, target, err):
                return false

        let constStart = projection.moduleConstStarts[contextIndex]
        for localIndex in 0..<projection.moduleConstCounts[contextIndex]:
            let rowIndex = constStart + localIndex
            let name = typedExprFrozenProjectionText(
                projection, projection.moduleConstNameIds[rowIndex])
            let literal = typedExprFrozenProjectionText(
                projection, projection.moduleConstLiteralIds[rowIndex])
            if !typedExprFrozenBuildEntryMatches(
                    index,
                    projection.moduleConstBuildEntryIndexes[rowIndex],
                    "ctx_module_const_source",
                    sourcePath,
                    name,
                    "",
                    sourcePath,
                    literal,
                    true,
                    0):
                err = Fmt" typed expr: frozen metadata module const entry mismatch context_index={contextIndex} row={localIndex}"
                return false
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_module_const_source",
                    sourcePath, name, "", 0, sourcePath, literal, err):
                return false

        let declaredStart = projection.declaredStarts[contextIndex]
        for localIndex in 0..<projection.declaredCounts[contextIndex]:
            let rowIndex = declaredStart + localIndex
            let name = typedExprFrozenProjectionText(
                projection, projection.declaredTypeIds[rowIndex])
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_declared_source",
                    sourcePath, name, "", contextIndex, sourcePath, name,
                    err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_declared_global",
                    "", name, "", contextIndex, sourcePath, name, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_declared", sourcePath,
                    name, "", contextIndex, name, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_composite", sourcePath,
                    name, "", contextIndex, name, err):
                return false

        let refStart = projection.refStarts[contextIndex]
        for localIndex in 0..<projection.refCounts[contextIndex]:
            let rowIndex = refStart + localIndex
            let name = typedExprFrozenProjectionText(
                projection, projection.refTypeIds[rowIndex])
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_ref_source",
                    sourcePath, name, "", contextIndex, sourcePath, name,
                    err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_ref_global", "",
                    name, "", contextIndex, sourcePath, name, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_ref", sourcePath, name,
                    "", contextIndex, name, err):
                return false

        let aliasStart = projection.aliasStarts[contextIndex]
        for localIndex in 0..<projection.aliasCounts[contextIndex]:
            let rowIndex = aliasStart + localIndex
            let name = typedExprFrozenProjectionText(
                projection, projection.aliasNameIds[rowIndex])
            let target = typedExprFrozenProjectionText(
                projection, projection.aliasTargetTypeIds[rowIndex])
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_alias_source",
                    sourcePath, name, "", contextIndex, sourcePath, target,
                    err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_alias_global", "",
                    name, "", contextIndex, sourcePath, target, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_alias_def", sourcePath,
                    name, "", contextIndex, target, err):
                return false

        let enumStart = projection.enumStarts[contextIndex]
        for localIndex in 0..<projection.enumCounts[contextIndex]:
            let rowIndex = enumStart + localIndex
            let name = typedExprFrozenProjectionText(
                projection, projection.enumNameIds[rowIndex])
            let typeName = typedExprFrozenProjectionText(
                projection, projection.enumTypeIds[rowIndex])
            let ordinal = projection.enumOrdinals[rowIndex]
            let payload = Fmt"{typeName}:{ordinal}"
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_enum_name_source",
                    sourcePath, name, "", ordinal, sourcePath, payload,
                    err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_enum_name_global", "",
                    name, "", ordinal, sourcePath, payload, err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries,
                    "ctx_enum_name_type_source", sourcePath, name, "",
                    contextIndex, sourcePath, typeName, err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries,
                    "ctx_enum_name_type_global", "", name, "",
                    contextIndex, sourcePath, typeName, err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_enum_type_source",
                    sourcePath, typeName, "", contextIndex, sourcePath,
                    typeName, err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_enum_type_global", "",
                    typeName, "", contextIndex, sourcePath, typeName, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_enum_name", sourcePath,
                    name, "", contextIndex, payload, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_enum_name_type",
                    sourcePath, name, "", contextIndex, typeName, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_enum_type", sourcePath,
                    typeName, "", contextIndex, typeName, err):
                return false

        let fieldStart = projection.fieldStarts[contextIndex]
        for localIndex in 0..<projection.fieldCounts[contextIndex]:
            let rowIndex = fieldStart + localIndex
            let ownerId = projection.fieldOwnerTypeIds[rowIndex]
            if ownerId < 0 || ownerId >= fieldOwnerCounts.len:
                err = Fmt" typed expr: canonical field owner id invalid row={rowIndex}"
                return false
            fieldOwnerCounts[ownerId] = typedExprCheckedAddInt32(
                fieldOwnerCounts[ownerId], 1,
                "canonical_expected_field_owner_count")
        for localIndex in 0..<projection.fieldCounts[contextIndex]:
            let rowIndex = fieldStart + localIndex
            let ownerId = projection.fieldOwnerTypeIds[rowIndex]
            let ownerType = typedExprFrozenProjectionText(projection,
                                                            ownerId)
            let fieldName = typedExprFrozenProjectionText(
                projection, projection.fieldNameIds[rowIndex])
            let fieldType = typedExprFrozenProjectionText(
                projection, projection.fieldTypeIds[rowIndex])
            let nodeIndex = projection.fieldBuildNodeIndexes[rowIndex]
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_field_owner_source",
                    sourcePath, ownerType, "", contextIndex, sourcePath,
                    ownerType, err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_field_owner_global",
                    "", ownerType, "", contextIndex, sourcePath, ownerType,
                    err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_field_source",
                    sourcePath, ownerType, fieldName, nodeIndex, sourcePath,
                    fieldType, err) ||
               !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries, "ctx_field_global", "",
                    ownerType, fieldName, nodeIndex, sourcePath, fieldType,
                    err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_field_owner", sourcePath,
                    ownerType, "", contextIndex, ownerType, err) ||
               !typedExprFrozenAuditExpectedVisibility(
                    index, visibility, "ctx_import_composite", sourcePath,
                    ownerType, "", contextIndex, ownerType, err):
                return false
            if fieldOwnerCounts[ownerId] > 0:
                if !typedExprFrozenAuditExpectedEntry(
                        index, projection, entries,
                        "ctx_field_count_source", sourcePath, ownerType, "",
                        fieldOwnerCounts[ownerId], sourcePath, ownerType, err):
                    return false
                fieldOwnerCounts[ownerId] = 0

        var authorityRows = projection.scopes
        if projection.signatures.contextCounts[contextIndex] > 0:
            authorityRows = projection.signatures
        let scopeStart = authorityRows.contextStarts[contextIndex]
        let scopeCount = authorityRows.contextCounts[contextIndex]
        for localIndex in 0..<scopeCount:
            let rowIndex = scopeStart + localIndex
            let name = typedExprFrozenProjectionText(
                projection, authorityRows.nameIds[rowIndex])
            let declarationRow = typedExprCheckedAddInt32(
                declarationBase, localIndex,
                "canonical_expected_function_declaration_row")
            if !typedExprFrozenAuditExpectedEntry(
                    index, projection, entries,
                    "ctx_function_decl_name_source", sourcePath, name, "",
                    declarationRow, sourcePath, name, err):
                return false
        declarationBase = typedExprCheckedAddInt32(
            declarationBase, scopeCount,
            "canonical_expected_declaration_base")
        declarationBase = typedExprCheckedAddInt32(
            declarationBase,
            projection.importcs.contextCounts[contextIndex],
            "canonical_expected_declaration_base")
    if declarationBase != typedExprBuildIndexCallDeclarationCount(index):
        err = " typed expr: canonical expected declaration cardinality mismatch"
        return false
    if !typedExprFrozenFinishExpectedEntryAudit(index, entries, err) ||
       !typedExprFrozenFinishExpectedVisibilityAudit(index, visibility, err):
        return false
    err = ""
    return true

@borrows
fn typedExprFrozenIndexTopologyExact(
        ir: var TypedExprIr,
        session: typedExprFrozenMetadataSession,
        err: var str): bool =
    let projection = session.projection
    let index = session.index
    if !typedExprFrozenProjectionSchemaExact(projection,
                                              session.contextCount,
                                              err):
        return false
    var allRows: bool[]
    if !typedExprExactBucketBijection(projection.contextBucketHeads,
                                       projection.contextNext,
                                       projection.contextHashes,
                                       session.contextCount,
                                       allRows,
                                       "canonical_context",
                                       err):
        return false
    for contextIndex in 0..<session.contextCount:
        let sourcePath = typedExprFrozenProjectionText(
            projection, projection.normalizedSourcePathIds[contextIndex])
        if projection.contextHashes[contextIndex] !=
           TypedExprBuildIndexHash4(sourcePath, "", "", ""):
            err = Fmt" typed expr: canonical context hash mismatch row={contextIndex}"
            return false
    if !typedExprFrozenScopeTopologyExact(
            projection, projection.scopes,
            projection.scopeBucketHeads, projection.scopeNext,
            projection.scopeHashes, false, "canonical_scope", err) ||
       !typedExprFrozenScopeTopologyExact(
            projection, projection.signatures,
            projection.signatureBucketHeads, projection.signatureNext,
            projection.signatureHashes, false, "canonical_signature", err) ||
       !typedExprFrozenScopeTopologyExact(
            projection, projection.scopes,
            projection.snapshotFunctionBucketHeads,
            projection.snapshotFunctionNext,
            projection.snapshotFunctionHashes, true,
            "canonical_snapshot_function", err):
        return false
    if projection.snapshotImportcNext.len !=
           projection.snapshotImportcContextIndexes.len ||
       projection.snapshotImportcNext.len !=
           projection.snapshotImportcNameIds.len ||
       projection.snapshotImportcNext.len !=
           projection.snapshotImportcRowIndexes.len ||
       !typedExprExactBucketBijection(
            projection.snapshotImportcBucketHeads,
            projection.snapshotImportcNext,
            projection.snapshotImportcHashes,
            projection.snapshotImportcContextIndexes.len,
            allRows,
            "canonical_snapshot_importc",
            err):
        if err == "":
            err = " typed expr: canonical snapshot importc columns mismatch"
        return false
    for rowIndex in 0..<projection.snapshotImportcContextIndexes.len:
        let contextIndex = projection.snapshotImportcContextIndexes[rowIndex]
        let importcRow = projection.snapshotImportcRowIndexes[rowIndex]
        if contextIndex < 0 || contextIndex >= session.contextCount ||
           !projection.snapshotOnly[contextIndex] ||
           importcRow < 0 || importcRow >= projection.importcs.nameIds.len:
            err = Fmt" typed expr: canonical snapshot importc row invalid row={rowIndex}"
            return false
        let name = typedExprFrozenProjectionText(
            projection, projection.snapshotImportcNameIds[rowIndex])
        let declaredName = typedExprFrozenProjectionText(
            projection, projection.importcs.nameIds[importcRow])
        let targetName = typedExprFrozenProjectionText(
            projection, projection.importcs.targetIds[importcRow])
        if (name != declaredName && name != targetName) ||
           projection.snapshotImportcHashes[rowIndex] !=
               typedExprFrozenStructuredHash(contextIndex, name, 0):
            err = Fmt" typed expr: canonical snapshot importc semantic mismatch row={rowIndex}"
            return false

    if index == nil || index.released || !index.compactCanonical ||
       index.canonicalProjection != projection ||
       typedExprBuildIndexOwnedSemanticTextBytes(index) != 0 ||
       session.duplicatedSemanticTextBytes != 0 ||
       index.contentCacheKinds.len != 0 ||
       index.visibilityQueryKinds.len != 0 ||
       index.fieldOwnerSourcePaths.len != 0 ||
       index.layoutSourcePaths.len != 0:
        err = " typed expr: compact canonical ownership invariant failed"
        return false
    let entryCount = typedExprBuildIndexEntryCount(index)
    if entryCount != index.entrySourcePathIds.len ||
       entryCount != index.entryNameIds.len ||
       entryCount != index.entryDetailIds.len ||
       entryCount != index.entryOriginIds.len ||
       entryCount != index.entryFingerprintIds.len ||
       entryCount != index.entryStates.len ||
       entryCount != index.entryValueIndexes.len ||
       entryCount != index.entryValidationMarks.len ||
       !typedExprExactBucketBijection(index.entryBucketHeads,
                                       index.entryNext,
                                       index.entryHashes,
                                       entryCount,
                                       allRows,
                                       "compact_entry",
                                       err):
        if err == "":
            err = " typed expr: compact canonical entry columns mismatch"
        return false
    for rowIndex in 0..<entryCount:
        let kind = typedExprBuildIndexEntryKind(index, rowIndex)
        let sourcePath = typedExprBuildIndexEntrySourcePath(index, rowIndex)
        let name = typedExprBuildIndexEntryName(index, rowIndex)
        let detail = typedExprBuildIndexEntryDetail(index, rowIndex)
        if !typedExprCanonicalMetadataEntryKind(kind) ||
           index.entryHashes[rowIndex] !=
               TypedExprBuildIndexHash4(kind, sourcePath, name, detail):
            err = Fmt" typed expr: compact canonical entry semantic mismatch row={rowIndex}"
            return false
    let visibilityCount = typedExprBuildIndexVisibilityCount(index)
    if visibilityCount != index.visibilitySourcePathIds.len ||
       visibilityCount != index.visibilityNameIds.len ||
       visibilityCount != index.visibilityDetailIds.len ||
       visibilityCount != index.visibilityFingerprintIds.len ||
       visibilityCount != index.visibilityValueIndexes.len ||
       !typedExprExactBucketBijection(index.visibilityBucketHeads,
                                       index.visibilityNext,
                                       index.visibilityHashes,
                                       visibilityCount,
                                       allRows,
                                       "compact_visibility",
                                       err):
        return false
    for rowIndex in 0..<visibilityCount:
        let kind = typedExprBuildIndexVisibilityKindAt(index, rowIndex)
        let sourcePath = typedExprBuildIndexVisibilitySourcePath(index,
                                                                  rowIndex)
        let name = typedExprBuildIndexVisibilityName(index, rowIndex)
        let detail = typedExprBuildIndexVisibilityDetail(index, rowIndex)
        if !TypedExprBuildIndexVisibilityKind(kind) ||
           index.visibilityHashes[rowIndex] !=
               TypedExprBuildIndexHash4(kind, sourcePath, name, detail):
            err = Fmt" typed expr: compact visibility semantic mismatch row={rowIndex}"
            return false
    # Reconstruct every expected canonical entry/visibility row exclusively
    # from projection semantics. This independent pass proves exact states,
    # payloads and row coverage; the compact index never validates itself.
    if !typedExprFrozenExpectedCanonicalRowsExact(session, err):
        return false
    let ownerCount = typedExprBuildIndexImportOwnerCount(index)
    if ownerCount != index.importOwnerTargetHeads.len ||
       !typedExprExactBucketBijection(index.importOwnerBucketHeads,
                                       index.importOwnerNext,
                                       index.importOwnerHashes,
                                       ownerCount,
                                       allRows,
                                       "compact_import_owner",
                                       err):
        return false
    for ownerIndex in 0..<ownerCount:
        let sourcePath = typedExprBuildIndexImportOwnerSourcePath(index,
                                                                  ownerIndex)
        if index.importOwnerHashes[ownerIndex] !=
           TypedExprBuildIndexHash2(sourcePath, ""):
            err = Fmt" typed expr: compact import owner hash mismatch row={ownerIndex}"
            return false
    if index.importTargetNext.len != index.importTargetEntryIndexes.len ||
       index.importTargetNext.len != index.visibilityEdgeCount:
        err = " typed expr: compact import target columns mismatch"
        return false
    var visitedTargets: bool[]
    for nodeIndex in 0..<index.importTargetNext.len:
        add(visitedTargets, false)
    for ownerIndex in 0..<ownerCount:
        let ownerSourcePath = typedExprBuildIndexImportOwnerSourcePath(
            index, ownerIndex)
        var nodeIndex = index.importOwnerTargetHeads[ownerIndex]
        while nodeIndex >= 0:
            if nodeIndex >= visitedTargets.len || visitedTargets[nodeIndex]:
                err = Fmt" typed expr: compact import target chain invalid owner={ownerIndex} node={nodeIndex}"
                return false
            visitedTargets[nodeIndex] = true
            let entryIndex = index.importTargetEntryIndexes[nodeIndex]
            if entryIndex < 0 || entryIndex >= entryCount ||
               typedExprBuildIndexEntryKind(index, entryIndex) !=
                   "ctx_import_target" ||
               typedExprBuildIndexEntrySourcePath(index, entryIndex) !=
                   ownerSourcePath:
                err = Fmt" typed expr: compact import target semantic mismatch owner={ownerIndex} node={nodeIndex}"
                return false
            nodeIndex = index.importTargetNext[nodeIndex]
    for nodeIndex in 0..<visitedTargets.len:
        if !visitedTargets[nodeIndex]:
            err = Fmt" typed expr: compact import target orphan node={nodeIndex}"
            return false
    for importIndex in 0..<projection.importTargetBuildEntryIndexes.len:
        let expectedEntry = projection.importTargetBuildEntryIndexes[importIndex]
        if expectedEntry < 0:
            continue
        var matchCount: int32
        for nodeIndex in 0..<index.importTargetEntryIndexes.len:
            if index.importTargetEntryIndexes[nodeIndex] == expectedEntry:
                matchCount = typedExprCheckedAddInt32(
                    matchCount, 1, "compact_import_target_match_count")
        if matchCount != 1:
            err = Fmt" typed expr: compact import target bijection mismatch import_row={importIndex} matches={matchCount}"
            return false
    let fieldOwnerCount = typedExprBuildIndexContextFieldOwnerCount(index)
    if fieldOwnerCount != index.contextFieldOwnerHeads.len ||
       fieldOwnerCount != index.contextFieldOwnerTails.len ||
       !typedExprExactBucketBijection(index.contextFieldOwnerBucketHeads,
                                       index.contextFieldOwnerNext,
                                       index.contextFieldOwnerHashes,
                                       fieldOwnerCount,
                                       allRows,
                                       "compact_context_field_owner",
                                       err):
        return false
    for ownerIndex in 0..<fieldOwnerCount:
        let sourcePath = typedExprBuildIndexContextFieldOwnerSourcePath(
            index, ownerIndex)
        let ownerType = typedExprBuildIndexContextFieldOwnerType(index,
                                                                  ownerIndex)
        if index.contextFieldOwnerHashes[ownerIndex] !=
           TypedExprBuildIndexHash2(sourcePath, ownerType):
            err = Fmt" typed expr: compact context field owner hash mismatch row={ownerIndex}"
            return false
    let fieldNodeCount = index.contextFieldNodeNext.len
    if fieldNodeCount != index.contextFieldNodeContextIndexes.len ||
       fieldNodeCount != index.contextFieldNodeRowIndexes.len ||
       fieldNodeCount != index.contextFieldNodeDeclaredOffsetBytes.len ||
       fieldNodeCount != index.contextFieldNodeDeclaredSizeBytes.len ||
       fieldNodeCount != index.contextFieldNodeDeclaredAlignBytes.len ||
       fieldNodeCount != index.contextFieldNodeOffsetBytes.len ||
       fieldNodeCount != index.contextFieldNodeSizeBytes.len ||
       fieldNodeCount != index.contextFieldNodeAlignBytes.len ||
       fieldNodeCount != index.contextFieldNodeLayoutReady.len:
        err = " typed expr: compact context field node columns mismatch"
        return false
    var visitedFieldNodes: bool[]
    for nodeIndex in 0..<fieldNodeCount:
        add(visitedFieldNodes, false)
    for ownerIndex in 0..<fieldOwnerCount:
        let sourcePath = typedExprBuildIndexContextFieldOwnerSourcePath(
            index, ownerIndex)
        let ownerType = typedExprBuildIndexContextFieldOwnerType(index,
                                                                  ownerIndex)
        var nodeIndex = index.contextFieldOwnerHeads[ownerIndex]
        var lastNode: int32 = -1
        while nodeIndex >= 0:
            if nodeIndex >= fieldNodeCount || visitedFieldNodes[nodeIndex]:
                err = Fmt" typed expr: compact context field chain invalid owner={ownerIndex} node={nodeIndex}"
                return false
            visitedFieldNodes[nodeIndex] = true
            let contextIndex = index.contextFieldNodeContextIndexes[nodeIndex]
            let localRow = index.contextFieldNodeRowIndexes[nodeIndex]
            if contextIndex < 0 || contextIndex >= session.contextCount ||
               typedExprBuildIndexContextSourcePath(index, contextIndex) !=
                   sourcePath || localRow < 0 ||
               localRow >= projection.fieldCounts[contextIndex]:
                err = Fmt" typed expr: compact context field node identity mismatch owner={ownerIndex} node={nodeIndex}"
                return false
            let projectionRow = projection.fieldStarts[contextIndex] + localRow
            if typedExprFrozenProjectionText(
                   projection,
                   projection.fieldOwnerTypeIds[projectionRow]) != ownerType:
                err = Fmt" typed expr: compact context field node owner mismatch owner={ownerIndex} node={nodeIndex}"
                return false
            lastNode = nodeIndex
            nodeIndex = index.contextFieldNodeNext[nodeIndex]
        if lastNode != index.contextFieldOwnerTails[ownerIndex]:
            err = Fmt" typed expr: compact context field tail mismatch owner={ownerIndex}"
            return false
    for nodeIndex in 0..<fieldNodeCount:
        if !visitedFieldNodes[nodeIndex]:
            err = Fmt" typed expr: compact context field orphan node={nodeIndex}"
            return false

    let callCount = typedExprBuildIndexCallDeclarationCount(index)
    let callGenericCount = typedExprBuildIndexCallGenericNameCount(index)
    let callParamCount = typedExprBuildIndexCallParamCount(index)
    if callCount != index.callDeclarationArities.len ||
       callCount != index.callDeclarationGenericStarts.len ||
       callCount != index.callDeclarationGenericCounts.len ||
       callCount != index.callDeclarationParamStarts.len ||
       callCount != index.callDeclarationParamCounts.len ||
       callCount != index.callDeclarationReturnTypeIds.len ||
       callCount != index.callDeclarationTargetSymbolIds.len ||
       callCount != index.callDeclarationSignatureLineNumbers.len ||
       callCount != index.callDeclarationKinds.len ||
       callCount != index.callDeclarationResultExprClasses.len ||
       callCount != index.callDeclarationProducerSourceIndexes.len ||
       callCount !=
           index.callDeclarationProducerDeclarationOrdinals.len ||
       callCount != index.callDeclarationProducerFunctionRows.len ||
       callCount != index.callDeclarationManualConsumePresents.len ||
       callCount !=
           index.callDeclarationManualConsumeFunctionDeclarationRows.len ||
       callCount !=
           index.callDeclarationManualConsumeTargetParameterOrdinals.len ||
       callCount !=
           index.callDeclarationManualConsumeSourceParameterOrdinals.len ||
       callCount !=
           index.callDeclarationManualConsumeTargetParameterDeclarationRows.len ||
       callCount !=
           index.callDeclarationManualConsumeSourceParameterDeclarationRows.len ||
       callCount != index.callDeclarationManualConsumeTargetTypeIds.len ||
       callCount != index.callDeclarationManualConsumeSourceTypeIds.len ||
       callCount != index.callDeclarationManualConsumeEffectCids.len ||
       !index.callDeclarationManualConsumeTypeArenaBound ||
       callCount != index.callDeclarationSortedRows.len:
        err = " typed expr: compact call declaration columns mismatch"
        return false
    var genericCursor: int32
    var paramCursor: int32
    var visitedCalls: bool[]
    for rowIndex in 0..<callCount:
        add(visitedCalls, false)
        if index.callDeclarationGenericStarts[rowIndex] != genericCursor ||
           index.callDeclarationGenericCounts[rowIndex] < 0 ||
           index.callDeclarationParamStarts[rowIndex] != paramCursor ||
           index.callDeclarationParamCounts[rowIndex] < 0 ||
           index.callDeclarationParamCounts[rowIndex] !=
               index.callDeclarationArities[rowIndex]:
            err = Fmt" typed expr: compact call parameter range mismatch row={rowIndex}"
            return false
        if (index.callDeclarationKinds[rowIndex] ==
                TypedExprCallDeclarationFunction &&
            index.callDeclarationSignatureLineNumbers[rowIndex] <= 0) ||
           (index.callDeclarationKinds[rowIndex] ==
                TypedExprCallDeclarationImportc &&
            index.callDeclarationSignatureLineNumbers[rowIndex] != 0):
            err = Fmt" typed expr: compact call signature identity invalid row={rowIndex}"
            return false
        let resultExprClass = index.callDeclarationResultExprClasses[rowIndex]
        let producerSourceIndex =
            index.callDeclarationProducerSourceIndexes[rowIndex]
        let producerDeclarationOrdinal =
            index.callDeclarationProducerDeclarationOrdinals[rowIndex]
        let producerFunctionRow =
            index.callDeclarationProducerFunctionRows[rowIndex]
        let declarationKind =
            index.callDeclarationKinds[rowIndex]
        if producerSourceIndex < -1 ||
           producerSourceIndex >= index.contextCount ||
           producerDeclarationOrdinal < -1 ||
           producerFunctionRow < -1 ||
           (producerSourceIndex < 0 &&
            producerDeclarationOrdinal >= 0) ||
           (producerSourceIndex < 0 &&
            producerFunctionRow >= 0) ||
           (producerSourceIndex >= 0 &&
            producerDeclarationOrdinal < 0) ||
           (declarationKind == TypedExprCallDeclarationFunction &&
            producerSourceIndex >= 0 && producerFunctionRow < 0) ||
           (declarationKind == TypedExprCallDeclarationImportc &&
            producerFunctionRow != -1):
            err = Fmt" typed expr: compact call producer coordinate invalid row={rowIndex} source={producerSourceIndex} declaration_ordinal={producerDeclarationOrdinal} function_row={producerFunctionRow}"
            return false
        if (index.callDeclarationKinds[rowIndex] ==
                TypedExprCallDeclarationFunction &&
            resultExprClass != TypedExprExprOwned &&
            resultExprClass != TypedExprExprBorrowed) ||
           (index.callDeclarationKinds[rowIndex] ==
                TypedExprCallDeclarationImportc &&
            resultExprClass != TypedExprExprUnknown &&
            resultExprClass != TypedExprExprOwned):
            err = Fmt" typed expr: compact call result ownership invalid row={rowIndex}"
            return false
        let manualConsumePresent =
            index.callDeclarationManualConsumePresents[rowIndex]
        let manualConsumeFunctionDeclarationRow =
            index.callDeclarationManualConsumeFunctionDeclarationRows[
                rowIndex]
        let manualConsumeTargetOrdinal =
            index.callDeclarationManualConsumeTargetParameterOrdinals[
                rowIndex]
        let manualConsumeSourceOrdinal =
            index.callDeclarationManualConsumeSourceParameterOrdinals[
                rowIndex]
        let manualConsumeTargetDeclarationRow =
            index.callDeclarationManualConsumeTargetParameterDeclarationRows[
                rowIndex]
        let manualConsumeSourceDeclarationRow =
            index.callDeclarationManualConsumeSourceParameterDeclarationRows[
                rowIndex]
        let manualConsumeTargetTypeId =
            index.callDeclarationManualConsumeTargetTypeIds[rowIndex]
        let manualConsumeSourceTypeId =
            index.callDeclarationManualConsumeSourceTypeIds[rowIndex]
        let manualConsumeEffectCid =
            index.callDeclarationManualConsumeEffectCids[rowIndex]
        if manualConsumePresent:
            if declarationKind != TypedExprCallDeclarationFunction ||
               manualConsumeFunctionDeclarationRow < 0 ||
               manualConsumeTargetOrdinal < 0 ||
               manualConsumeTargetOrdinal >=
                   index.callDeclarationParamCounts[rowIndex] ||
               manualConsumeSourceOrdinal < 0 ||
               manualConsumeSourceOrdinal >=
                   index.callDeclarationParamCounts[rowIndex] ||
               manualConsumeTargetOrdinal == manualConsumeSourceOrdinal ||
               manualConsumeTargetDeclarationRow < 0 ||
               manualConsumeSourceDeclarationRow < 0 ||
               manualConsumeTargetDeclarationRow ==
                   manualConsumeSourceDeclarationRow ||
               ir.exactTypeArena == nil ||
               !ir.valueDefinitionTypeArenaBound ||
               !layout.FixedBytes32Equal(
                   ir.valueDefinitionTypeArenaArtifactCid,
                   ir.exactTypeArena.artifactRaw32) ||
               !typedExprManualConsumeTypeIdsExact(
                   ir.exactTypeArena,
                   manualConsumeTargetTypeId,
                   manualConsumeSourceTypeId) ||
               !layout.FixedBytes32Equal(
                   manualConsumeEffectCid,
                   typedExprManualConsumeEffectCid(
                       ir.valueDefinitionTypeArenaArtifactCid,
                       producerSourceIndex,
                       producerDeclarationOrdinal,
                       producerFunctionRow,
                       manualConsumeFunctionDeclarationRow,
                       manualConsumeTargetOrdinal,
                       manualConsumeSourceOrdinal,
                       manualConsumeTargetDeclarationRow,
                       manualConsumeSourceDeclarationRow,
                       manualConsumeTargetTypeId,
                       manualConsumeSourceTypeId)):
                err = Fmt" typed expr: compact call manual-consume authority invalid row={rowIndex}"
                return false
        elif !typedExprManualConsumeEffectAbsent(
                 false,
                 manualConsumeFunctionDeclarationRow,
                 manualConsumeTargetOrdinal,
                 manualConsumeSourceOrdinal,
                 manualConsumeTargetDeclarationRow,
                 manualConsumeSourceDeclarationRow,
                 manualConsumeTargetTypeId,
                 manualConsumeSourceTypeId,
                 manualConsumeEffectCid):
            err = Fmt" typed expr: compact call absent manual-consume authority non-empty row={rowIndex}"
            return false
        genericCursor = typedExprCheckedAddInt32(
            genericCursor, index.callDeclarationGenericCounts[rowIndex],
            "compact_call_generic_cursor")
        if genericCursor > callGenericCount:
            err = Fmt" typed expr: compact call generic overflow row={rowIndex}"
            return false
        paramCursor = typedExprCheckedAddInt32(
            paramCursor, index.callDeclarationParamCounts[rowIndex],
            "compact_call_param_cursor")
        if paramCursor > callParamCount:
            err = Fmt" typed expr: compact call parameter overflow row={rowIndex}"
            return false
    if genericCursor != callGenericCount:
        err = " typed expr: compact call generic tail mismatch"
        return false
    if paramCursor != callParamCount:
        err = " typed expr: compact call parameter tail mismatch"
        return false
    for sortedIndex in 0..<callCount:
        let rowIndex = index.callDeclarationSortedRows[sortedIndex]
        if rowIndex < 0 || rowIndex >= callCount || visitedCalls[rowIndex]:
            err = Fmt" typed expr: compact call sorted permutation invalid row={sortedIndex}"
            return false
        visitedCalls[rowIndex] = true
        if sortedIndex > 0 &&
           TypedExprCallDeclarationRowCompare(
               index,
               index.callDeclarationSortedRows[sortedIndex - 1],
               rowIndex) > 0:
            err = Fmt" typed expr: compact call sorted order invalid row={sortedIndex}"
            return false
    err = ""
    return true

@borrows
fn typedExprFrozenProjectionMatchesBuildIndex(
        ir: var TypedExprIr,
        session: typedExprFrozenMetadataSession,
        err: var str): bool =
    let projection = session.projection
    let index = session.index
    if projection == nil || projection.released || index == nil || index.released:
        err = " typed expr: frozen metadata close projection unavailable"
        return false
    if !typedExprFrozenIndexTopologyExact(ir, session, err):
        return false
    if projection.joinedLookupKeyBytes != 0 ||
       projection.contextBucketHeads.len <= 0 ||
       projection.contextNext.len != session.contextCount ||
       projection.contextHashes.len != session.contextCount ||
       projection.rawSourcePathIds.len != session.contextCount ||
       projection.normalizedSourcePathIds.len != session.contextCount ||
       projection.packageOwnerIds.len != session.contextCount ||
       projection.snapshotOnly.len != session.contextCount ||
       projection.contextBuildEntryIndexes.len != session.contextCount ||
       projection.contextMetadataRowCounts.len != session.contextCount ||
       projection.sourceIndexProducerFullTraversalCounts.len !=
           session.contextCount ||
       projection.sourceByteLengths.len != session.contextCount ||
       projection.sourceLineStarts.len != session.contextCount ||
       projection.sourceLineCounts.len != session.contextCount ||
       projection.globalBindingStarts.len != session.contextCount ||
       projection.globalBindingCounts.len != session.contextCount ||
       typedExprBuildIndexContextSourceCount(index) !=
           session.contextCount ||
       index.contextMetadataDomainCounts.len !=
           typedExprContextDomainColumnCount(session.contextCount):
        err = " typed expr: frozen metadata close projection cardinality drift"
        return false
    for contextIndex in 0..<session.contextCount:
        let sourcePath = typedExprFrozenProjectionText(projection,
                                                        projection.normalizedSourcePathIds[contextIndex])
        if typedExprFrozenContextIndexForPath(projection, sourcePath) != contextIndex ||
           typedExprBuildIndexContextSourcePath(index, contextIndex) !=
               sourcePath ||
           !typedExprFrozenBuildEntryMatches(index,
                                              projection.contextBuildEntryIndexes[contextIndex],
                                              "ctx_source",
                                              sourcePath,
                                              "",
                                              "",
                                              sourcePath,
                                              sourcePath,
                                              true,
                                              contextIndex):
            err = Fmt" typed expr: frozen metadata close source mismatch context_index={contextIndex}"
            return false
        if TypedExprBuildIndexContextDomainCount(index, contextIndex, 0) != projection.importCounts[contextIndex] ||
           TypedExprBuildIndexContextDomainCount(index, contextIndex, 1) != projection.declaredCounts[contextIndex] ||
           TypedExprBuildIndexContextDomainCount(index, contextIndex, 2) != projection.refCounts[contextIndex] ||
           TypedExprBuildIndexContextDomainCount(index, contextIndex, 3) != projection.aliasCounts[contextIndex] ||
           TypedExprBuildIndexContextDomainCount(index, contextIndex, 4) != projection.enumCounts[contextIndex] ||
           TypedExprBuildIndexContextDomainCount(index, contextIndex, 5) != projection.fieldCounts[contextIndex]:
            err = Fmt" typed expr: frozen metadata close domain mismatch context_index={contextIndex}"
            return false
        let importStart = projection.importStarts[contextIndex]
        for localIndex in 0..<projection.importCounts[contextIndex]:
            let rowIndex = importStart + localIndex
            let qualifier = typedExprFrozenProjectionText(projection,
                                                            projection.importQualifierIds[rowIndex])
            let target = typedExprFrozenProjectionText(projection,
                                                         projection.importTargetSourcePathIds[rowIndex])
            let targetContextIndex = typedExprFrozenContextIndexForPath(
                projection,
                target)
            if !typedExprFrozenBuildEntryMatches(index,
                                                  projection.importBuildEntryIndexes[rowIndex],
                                                  "ctx_import_alias",
                                                  sourcePath,
                                                  qualifier,
                                                  "",
                                                  sourcePath,
                                                  target,
                                                  true,
                                                  targetContextIndex):
                err = Fmt" typed expr: frozen metadata close import mismatch context_index={contextIndex} row={localIndex}"
                return false
            if targetContextIndex >= 0 &&
               !typedExprFrozenBuildEntryMatches(index,
                                                  projection.importTargetBuildEntryIndexes[rowIndex],
                                                  "ctx_import_target",
                                                  sourcePath,
                                                  target,
                                                  "",
                                                  sourcePath,
                                                  target,
                                                  true,
                                                  targetContextIndex):
                err = Fmt" typed expr: frozen metadata close import edge mismatch context_index={contextIndex} row={localIndex}"
                return false
        let declaredStart = projection.declaredStarts[contextIndex]
        for localIndex in 0..<projection.declaredCounts[contextIndex]:
            let rowIndex = declaredStart + localIndex
            let name = typedExprFrozenProjectionText(projection,
                                                       projection.declaredTypeIds[rowIndex])
            if !typedExprFrozenBuildEntryMatches(index,
                                                  projection.declaredBuildEntryIndexes[rowIndex],
                                                  "ctx_declared_source",
                                                  sourcePath,
                                                  name,
                                                  "",
                                                  sourcePath,
                                                  name,
                                                  true,
                                                  contextIndex):
                err = Fmt" typed expr: frozen metadata close declared mismatch context_index={contextIndex} row={localIndex}"
                return false
        let refStart = projection.refStarts[contextIndex]
        for localIndex in 0..<projection.refCounts[contextIndex]:
            let rowIndex = refStart + localIndex
            let name = typedExprFrozenProjectionText(projection,
                                                       projection.refTypeIds[rowIndex])
            if !typedExprFrozenBuildEntryMatches(index,
                                                  projection.refBuildEntryIndexes[rowIndex],
                                                  "ctx_ref_source",
                                                  sourcePath,
                                                  name,
                                                  "",
                                                  sourcePath,
                                                  name,
                                                  true,
                                                  contextIndex):
                err = Fmt" typed expr: frozen metadata close ref mismatch context_index={contextIndex} row={localIndex}"
                return false
        let aliasStart = projection.aliasStarts[contextIndex]
        for localIndex in 0..<projection.aliasCounts[contextIndex]:
            let rowIndex = aliasStart + localIndex
            let name = typedExprFrozenProjectionText(projection,
                                                       projection.aliasNameIds[rowIndex])
            let target = typedExprFrozenProjectionText(projection,
                                                         projection.aliasTargetTypeIds[rowIndex])
            if !typedExprFrozenBuildEntryMatches(index,
                                                  projection.aliasBuildEntryIndexes[rowIndex],
                                                  "ctx_alias_source",
                                                  sourcePath,
                                                  name,
                                                  "",
                                                  sourcePath,
                                                  target,
                                                  true,
                                                  contextIndex):
                err = Fmt" typed expr: frozen metadata close alias mismatch context_index={contextIndex} row={localIndex}"
                return false
        let fieldStart = projection.fieldStarts[contextIndex]
        for localIndex in 0..<projection.fieldCounts[contextIndex]:
            let rowIndex = fieldStart + localIndex
            let ownerType = typedExprFrozenProjectionText(projection,
                                                            projection.fieldOwnerTypeIds[rowIndex])
            let fieldName = typedExprFrozenProjectionText(projection,
                                                            projection.fieldNameIds[rowIndex])
            let fieldType = typedExprFrozenProjectionText(projection,
                                                            projection.fieldTypeIds[rowIndex])
            let nodeIndex = projection.fieldBuildNodeIndexes[rowIndex]
            if !typedExprFrozenBuildEntryMatches(index,
                                                  projection.fieldBuildEntryIndexes[rowIndex],
                                                  "ctx_field_source",
                                                  sourcePath,
                                                  ownerType,
                                                  fieldName,
                                                  sourcePath,
                                                  fieldType,
                                                  true,
                                                  nodeIndex) ||
               nodeIndex < 0 || nodeIndex >= index.contextFieldNodeContextIndexes.len ||
               nodeIndex >= index.contextFieldNodeRowIndexes.len ||
               nodeIndex >= index.contextFieldNodeDeclaredOffsetBytes.len ||
               nodeIndex >= index.contextFieldNodeDeclaredSizeBytes.len ||
               nodeIndex >= index.contextFieldNodeDeclaredAlignBytes.len ||
               index.contextFieldNodeContextIndexes[nodeIndex] != contextIndex ||
               index.contextFieldNodeRowIndexes[nodeIndex] != localIndex ||
               index.contextFieldNodeDeclaredOffsetBytes[nodeIndex] != projection.fieldOffsetBytes[rowIndex] ||
               index.contextFieldNodeDeclaredSizeBytes[nodeIndex] != projection.fieldSizeBytes[rowIndex] ||
               index.contextFieldNodeDeclaredAlignBytes[nodeIndex] != projection.fieldAlignBytes[rowIndex]:
                err = Fmt" typed expr: frozen metadata close field mismatch context_index={contextIndex} row={localIndex}"
                return false
        let enumStart = projection.enumStarts[contextIndex]
        for localIndex in 0..<projection.enumCounts[contextIndex]:
            let rowIndex = enumStart + localIndex
            let name = typedExprFrozenProjectionText(projection,
                                                       projection.enumNameIds[rowIndex])
            let typeName = typedExprFrozenProjectionText(projection,
                                                           projection.enumTypeIds[rowIndex])
            let ordinal = projection.enumOrdinals[rowIndex]
            if !typedExprFrozenBuildEntryMatches(index,
                                                  projection.enumNameBuildEntryIndexes[rowIndex],
                                                  "ctx_enum_name_source",
                                                  sourcePath,
                                                  name,
                                                  "",
                                                  sourcePath,
                                                  "",
                                                  false,
                                                  ordinal) ||
               !typedExprFrozenBuildEntryMatches(index,
                                                  projection.enumTypeBuildEntryIndexes[rowIndex],
                                                  "ctx_enum_name_type_source",
                                                  sourcePath,
                                                  name,
                                                  "",
                                                  sourcePath,
                                                  typeName,
                                                  true,
                                                  contextIndex):
                err = Fmt" typed expr: frozen metadata close enum mismatch context_index={contextIndex} row={localIndex}"
                return false
    if !typedExprFrozenValidateCallRows(index, projection, err):
        return false
    err = ""
    return true

fn typedExprDisposeFrozenMetadataSession(session: typedExprFrozenMetadataSession) =
    if session == nil || session.released:
        return
    # [orcd9-inst] 入口标 + 环后步进（D1..D16）：registry_miss 前最后一条
    # D 编号 = 致命 aux 释放动作
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(),
                     Fmt"O8DISP ctxLen={session.roundCacheContexts.len} keysLen={session.roundCacheKeys.len} parkKeys={session.roundParkKeys.len}")
    for slot in 0..<session.roundCacheContexts.len:
        if session.roundCacheKeys[slot] >= 0:
            TypedExprClearSourceContextAllFields(
                session.roundCacheContexts[slot])
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D1")
    session.roundCacheContexts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D2")
    session.roundCacheKeys = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D3")
    session.roundCacheMetadata = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D4")
    session.roundCacheScopeStarts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D5")
    session.roundCacheScopeEnds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D6")
    session.roundCacheRowIds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D7")
    session.roundCacheRowStarts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D8")
    session.roundCacheFullMaterialize = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D9")
    session.roundParkKeys = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D10")
    session.roundParkMetadata = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D11")
    session.roundParkScopeStarts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D12")
    session.roundParkScopeEnds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D13")
    session.roundParkRowIds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D14")
    session.roundParkRowStarts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D15")
    session.roundParkFullMaterialize = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "D16")
    var ownedProjection: typedExprFrozenMetadataProjection
    ownedProjection = session.projection
    session.projection = nil
    typedExprReleaseFrozenMetadataProjection(ownedProjection)
    var canonicalIndex: TypedExprBuildIndex
    canonicalIndex = session.index
    session.index = nil
    if canonicalIndex != nil && !canonicalIndex.released:
        TypedExprBuildIndexRelease(canonicalIndex)
    session.canonicalIndexBytes = 0
    session.canonicalStoreBytes = 0
    session.roundViewLiveBytes = 0
    session.roundContextCount = 0
    session.roundDependencyCount = 0
    session.closed = true
    session.released = true

fn typedExprIrDisposeFrozenMetadataSession(ir: var TypedExprIr) =
    if ir.typedExprMetadataSession != nil &&
       memRefCount(ir.typedExprMetadataSession) != 1:
        panic("typed expr: frozen metadata session owner is shared by value assignment")
    var session: typedExprFrozenMetadataSession
    session = ir.typedExprMetadataSession
    ir.typedExprMetadataSession = nil
    typedExprDisposeFrozenMetadataSession(session)

@borrows
@borrow_result
fn typedExprRequireFrozenMetadataSession(ir: TypedExprIr,
                                         operation: str): typedExprFrozenMetadataSession =
    let session = ir.typedExprMetadataSession
    if session == nil:
        panic(Fmt"typed expr: frozen metadata session missing operation={operation}")
    if session.released:
        panic(Fmt"typed expr: frozen metadata session released operation={operation}")
    if session.closed:
        panic(Fmt"typed expr: frozen metadata session closed operation={operation}")
    if session.index == nil || ir.buildIndex == nil ||
       session.index.released || ir.buildIndex.released:
        panic(Fmt"typed expr: frozen metadata session index unavailable operation={operation}")
    if session.index == ir.buildIndex:
        panic(Fmt"typed expr: frozen metadata canonical and derived indexes alias operation={operation}")
    if !session.index.permanentlySealed ||
       !session.index.frozenReadOnlyQueries ||
       !session.index.compactCanonical ||
       session.index.canonicalProjection != session.projection ||
       ir.buildIndex.permanentlySealed ||
       ir.buildIndex.compactCanonical ||
       ir.buildIndex.canonicalProjection != session.projection:
        panic(Fmt"typed expr: frozen metadata index mutability drift operation={operation}")
    if session.buildGeneration != ir.buildIndexGeneration ||
       session.buildGeneration != session.index.buildGeneration ||
       session.buildGeneration != ir.buildIndex.buildGeneration:
        panic(Fmt"typed expr: frozen metadata session generation mismatch operation={operation}")
    if session.sessionGeneration != ir.typedExprMetadataSessionGeneration:
        panic(Fmt"typed expr: frozen metadata session lifecycle generation mismatch operation={operation}")
    if session.projection == nil || session.projection.released:
        panic(Fmt"typed expr: frozen metadata projection unavailable operation={operation}")
    if session.buildCount != session.index.buildCount ||
       session.contextCount != session.index.contextCount ||
       session.contextCount != ir.buildIndex.contextCount ||
       session.fullContextCount != 0 ||
       session.duplicatedSemanticTextBytes != 0 ||
       typedExprPostSealDuplicatedSemanticTextBytes(session,
                                                    ir.buildIndex) != 0 ||
       typedExprDerivedIrCanonicalTextOverlapBytes(
           ir.buildIndex, session.projection) != 0 ||
       session.contextCount != session.projection.rawSourcePathIds.len ||
       session.contextCount != session.projection.contextMetadataRowCounts.len ||
       session.contextCount != session.projection.contextNext.len ||
       session.contextCount != session.projection.contextHashes.len ||
       session.projection.contextBucketHeads.len <= 0:
        panic(Fmt"typed expr: frozen metadata session cardinality drift operation={operation}")
    if session.validationEpochAtSeal != session.index.validationEpoch ||
       session.reuseCountAtSeal != session.index.reuseCount:
        panic(Fmt"typed expr: frozen metadata session full-validation drift operation={operation}")
    if !session.index.callDeclarationSealed ||
       !session.index.contentCacheReleased ||
       !ir.buildIndex.callDeclarationSealed ||
       ir.buildIndex.contentCacheReleased:
        panic(Fmt"typed expr: frozen metadata session lifecycle mismatch operation={operation}")
    return session

# Module constants and import visibility remain in the immutable canonical
# metadata index after sealing; ir.buildIndex is the separate derived-IR index.
# Keep the index private and expose only read-only const queries so consumers
# cannot accidentally mutate or query the wrong authority.
@borrows
fn typedExprIrConstQueryIndex(ir: TypedExprIr,
                              operation: str): TypedExprBuildIndex =
    # During a live frozen metadata session the sealed canonical index owns the
    # module-const rows. After close those rows live in the derived IR index
    # (moved verbatim at close); ordinary non-frozen builds keep them in the
    # one full index. All three are the same lookup surface.
    let session = ir.typedExprMetadataSession
    if session != nil && !session.closed && !session.released &&
       session.index != nil && !session.index.released:
        return session.index
    if ir.buildIndex == nil || ir.buildIndex.released:
        panic(Fmt"typed expr: const query index unavailable operation={operation}")
    return ir.buildIndex

@borrows
fn TypedExprIrCallConstTarget(ir: TypedExprIr,
                              ownerSourcePathRaw: str,
                              nameRaw: str,
                              visitedOwners: var str[],
                              visitedNames: var str[],
                              targetOwnerSourcePathOut: var str,
                              literalOut: var str,
                              foundOut: var bool,
                              cycleOut: var bool): bool =
    let queryIndex = typedExprIrConstQueryIndex(ir, "canonical const target")
    return TypedExprCallConstTarget(queryIndex,
                                    ownerSourcePathRaw,
                                    nameRaw,
                                    visitedOwners,
                                    visitedNames,
                                    targetOwnerSourcePathOut,
                                    literalOut,
                                    foundOut,
                                    cycleOut)

@borrows
fn TypedExprIrCallConstIntValue(ir: TypedExprIr,
                                ownerSourcePathRaw: str,
                                textRaw: str,
                                visitedOwners: var str[],
                                visitedNames: var str[],
                                recognizedOut: var bool,
                                valueOut: var int64): bool =
    let queryIndex = typedExprIrConstQueryIndex(ir, "canonical int const")
    return TypedExprCallConstIntValue(queryIndex,
                                      ownerSourcePathRaw,
                                      textRaw,
                                      visitedOwners,
                                      visitedNames,
                                      recognizedOut,
                                      valueOut)

@borrows
fn typedExprIrFrozenFieldOwnerRequireRow(
        ir: TypedExprIr,
        ownerSourcePath: str,
        ownerType: str,
        rowIndex: int32): int32 =
    if rowIndex < 0 ||
       rowIndex >= ir.buildIndex.fieldRowNext.len ||
       rowIndex >= ir.typeFieldSourcePaths.len ||
       rowIndex >= ir.typeFieldOwnerTypes.len ||
       rowIndex >= ir.typeFieldNames.len ||
       rowIndex >= ir.typeFieldTypes.len ||
       rowIndex >= ir.typeFieldOffsetBytes.len ||
       rowIndex >= ir.typeFieldSizeBytes.len ||
       rowIndex >= ir.typeFieldAlignBytes.len:
        panic("typed expr: frozen field-owner row out of range")
    let rowSourcePath = parser.ParserNormalizePath(
        ir.typeFieldSourcePaths[rowIndex])
    let rowOwnerType = TypedExprTypeLeafName(
        TypedExprNormalizeTypeText(ir.typeFieldOwnerTypes[rowIndex]))
    if rowSourcePath == "" || rowOwnerType == "" ||
       !TypedExprSourcePathsEquivalent(rowSourcePath, ownerSourcePath) ||
       rowOwnerType != ownerType:
        panic(Fmt"typed expr: frozen field-owner row identity drift row={rowIndex} owner_source={ownerSourcePath} owner_type={ownerType} row_source={rowSourcePath} row_owner={rowOwnerType}")
    let nextRow = ir.buildIndex.fieldRowNext[rowIndex]
    if nextRow < -1:
        panic("typed expr: frozen field-owner next row is invalid")
    if nextRow >= 0:
        if nextRow >= ir.buildIndex.fieldRowNext.len ||
           nextRow >= ir.typeFieldSourcePaths.len ||
           nextRow >= ir.typeFieldOwnerTypes.len ||
           nextRow >= ir.typeFieldNames.len ||
           nextRow >= ir.typeFieldTypes.len ||
           nextRow >= ir.typeFieldOffsetBytes.len ||
           nextRow >= ir.typeFieldSizeBytes.len ||
           nextRow >= ir.typeFieldAlignBytes.len:
            panic("typed expr: frozen field-owner next row out of range")
    return nextRow

@borrows
fn typedExprIrFrozenFieldOwnerValidateChain(
        ir: TypedExprIr,
        ownerSourcePath: str,
        ownerType: str,
        headRow: int32): int32 =
    if headRow < 0:
        return 0
    var slowRow = headRow
    var fastRow = headRow
    while fastRow >= 0:
        slowRow = typedExprIrFrozenFieldOwnerRequireRow(
            ir, ownerSourcePath, ownerType, slowRow)
        fastRow = typedExprIrFrozenFieldOwnerRequireRow(
            ir, ownerSourcePath, ownerType, fastRow)
        if fastRow >= 0:
            fastRow = typedExprIrFrozenFieldOwnerRequireRow(
                ir, ownerSourcePath, ownerType, fastRow)
        if slowRow >= 0 && fastRow >= 0 && slowRow == fastRow:
            panic(Fmt"typed expr: frozen field-owner cycle owner_source={ownerSourcePath} owner_type={ownerType} row={slowRow}")
    var rowCount: int32
    var rowIndex = headRow
    while rowIndex >= 0:
        if rowCount >= ir.typeFieldNames.len:
            panic(Fmt"typed expr: frozen field-owner row count exceeds field table owner_source={ownerSourcePath} owner_type={ownerType}")
        rowCount = rowCount + 1
        rowIndex = typedExprIrFrozenFieldOwnerRequireRow(
            ir, ownerSourcePath, ownerType, rowIndex)
    return rowCount

# Begin an O(owner-fields) traversal of the exact derived field-owner chain.
# The canonical frozen session proves the source/type identity; the cursor
# keeps build generation and chain cardinality private from backend modules.
# frozen field-owner 查询的 generation: session 活着时走完整 frozen 封存验证
# (后端阶段); typed 构建期 (seal 前, session==nil) 降级用 ir.buildIndexGeneration —
# field-owner 数据在同一 buildIndex, typed 构建期的 managed-str-field 查询
# (core_runtime_provider_darwin 的 typed ir build) 本无 frozen 封存可验。
@borrows
fn typedExprIrFrozenFieldOwnerGeneration(ir: TypedExprIr,
                                         operation: str): int32 =
    if ir.typedExprMetadataSession != nil &&
       !ir.typedExprMetadataSession.closed &&
       !ir.typedExprMetadataSession.released:
        let session = typedExprRequireFrozenMetadataSession(ir, operation)
        return session.buildGeneration
    return ir.buildIndexGeneration

@borrows
fn TypedExprIrFrozenFieldOwnerHead(
        ir: TypedExprIr,
        ownerSourcePathRaw: str,
        ownerTypeRaw: str,
        cursor: var TypedExprFrozenFieldOwnerCursor): int32 =
    let headGeneration = typedExprIrFrozenFieldOwnerGeneration(
        ir, "frozen field-owner head")
    cursor.ownerSourcePath = ""
    cursor.ownerType = ""
    cursor.currentRow = -1
    cursor.remainingRows = 0
    cursor.buildGeneration = headGeneration
    cursor.active = false
    let ownerSourcePath = parser.ParserNormalizePath(ownerSourcePathRaw)
    let ownerType = TypedExprTypeLeafName(
        TypedExprNormalizeTypeText(ownerTypeRaw))
    if ownerSourcePath == "" || ownerType == "":
        return -1
    let headRow = TypedExprBuildIndexFieldOwnerHead(
        ir.buildIndex, ownerSourcePath, ownerType)
    if headRow < 0:
        return -1
    let rowCount = typedExprIrFrozenFieldOwnerValidateChain(
        ir, ownerSourcePath, ownerType, headRow)
    if rowCount <= 0:
        panic("typed expr: frozen field-owner head has empty chain")
    cursor.ownerSourcePath = ownerSourcePath
    cursor.ownerType = ownerType
    cursor.currentRow = headRow
    cursor.remainingRows = rowCount
    cursor.active = true
    return headRow

@borrows
fn TypedExprIrFrozenFieldOwnerNext(
        ir: TypedExprIr,
        cursor: var TypedExprFrozenFieldOwnerCursor,
        currentRow: int32): int32 =
    let nextGeneration = typedExprIrFrozenFieldOwnerGeneration(
        ir, "frozen field-owner next")
    if !cursor.active || cursor.ownerSourcePath == "" ||
       cursor.ownerType == "" || cursor.remainingRows <= 0 ||
       cursor.currentRow != currentRow:
        panic("typed expr: frozen field-owner cursor state mismatch")
    if cursor.buildGeneration != nextGeneration:
        panic("typed expr: frozen field-owner cursor generation drift")
    let nextRow = typedExprIrFrozenFieldOwnerRequireRow(
        ir, cursor.ownerSourcePath, cursor.ownerType, currentRow)
    cursor.remainingRows = cursor.remainingRows - 1
    if cursor.remainingRows == 0:
        if nextRow >= 0:
            panic("typed expr: frozen field-owner cursor terminal mismatch")
        cursor.currentRow = -1
        cursor.active = false
        return -1
    if nextRow < 0:
        panic("typed expr: frozen field-owner cursor truncated")
    cursor.currentRow = nextRow
    return nextRow

@borrows
@borrow_result
fn typedExprPrepareFrozenMetadataOperation(ir: var TypedExprIr,
                                           operation: str): typedExprFrozenMetadataSession =
    let session = typedExprRequireFrozenMetadataSession(ir, operation)
    if session.sealedValidationCount >= 2147483647:
        panic("typed expr: frozen metadata session validation telemetry exhausted")
    return session

fn typedExprPreflightFrozenMetadataOperation(ir: var TypedExprIr,
                                              operation: str) =
    let session = typedExprPrepareFrozenMetadataOperation(ir, operation)
    if session == nil:
        panic("typed expr: frozen metadata session preflight lost authority")

@borrows
fn typedExprStageFrozenMetadataContextVisit(session: typedExprFrozenMetadataSession,
                                            contextIndex: int32,
                                            metadataRowsVisited: var int64) =
    if contextIndex < 0 ||
       contextIndex >= session.projection.contextMetadataRowCounts.len:
        panic("typed expr: frozen metadata context visit out of range")
    # This authorizes one immutable context header only. No canonical metadata
    # row is scanned or copied after seal; selected scope-row work has its own
    # exact projection telemetry and must not be disguised as a full visit.
    if metadataRowsVisited < 0:
        panic("typed expr: frozen metadata visit telemetry invalid")

fn TypedExprMetadataVisitReceiptExact(
        contextCountExpected: int32,
        contextCountObserved: int32,
        metadataRowsExpected: int64,
        metadataRowsObserved: int64): bool =
    return contextCountExpected >= 0 && metadataRowsExpected >= Int64(0) &&
           contextCountObserved == contextCountExpected &&
           metadataRowsObserved == metadataRowsExpected

@borrows
fn typedExprCommitFrozenMetadataOperation(session: typedExprFrozenMetadataSession,
                                          metadataRowsVisited: int64) =
    if metadataRowsVisited < 0:
        panic("typed expr: frozen metadata visit telemetry delta invalid")
    if session.sealedValidationCount >= 2147483647:
        panic("typed expr: frozen metadata session validation telemetry exhausted")
    if session.metadataRowsVisitedAfterSeal >
       9223372036854775807 - metadataRowsVisited:
        panic("typed expr: frozen metadata visit telemetry exhausted")
    session.sealedValidationCount = session.sealedValidationCount + 1
    session.metadataRowsVisitedAfterSeal =
        session.metadataRowsVisitedAfterSeal + metadataRowsVisited

@borrows
fn typedExprBeginFrozenReadOnlyQueries(
        session: typedExprFrozenMetadataSession,
        queryLookupCount: var int32,
        queryProbeCount: var int32,
        queryMetadataScanCount: var int32) =
    if session == nil || session.index == nil || session.index.released ||
       !session.index.permanentlySealed ||
       !session.index.frozenReadOnlyQueries:
        panic("typed expr: frozen metadata read-only query window unavailable")
    queryLookupCount = session.index.queryLookupCount
    queryProbeCount = session.index.queryProbeCount
    queryMetadataScanCount = session.index.queryMetadataScanCount

@borrows
fn typedExprEndFrozenReadOnlyQueries(
        session: typedExprFrozenMetadataSession,
        queryLookupCount: int32,
        queryProbeCount: int32,
        queryMetadataScanCount: int32) =
    if session == nil || session.index == nil || session.index.released ||
       !session.index.permanentlySealed ||
       !session.index.frozenReadOnlyQueries:
        panic("typed expr: frozen metadata read-only query window drift")
    if session.index.queryLookupCount != queryLookupCount ||
       session.index.queryProbeCount != queryProbeCount ||
       session.index.queryMetadataScanCount != queryMetadataScanCount:
        panic("typed expr: sealed build index query mutated canonical telemetry")

@borrows
fn typedExprCanonicalMetadataEntryKind(kind: str): bool =
    return kind.len >= 4 && chengpath.TextSlice(kind, 0, 4) == "ctx_"

@borrows
fn typedExprRemapCanonicalEntryIndexes(indexes: var int32[],
                                       remap: int32[],
                                       allowMissing: bool,
                                       column: str,
                                       err: var str): bool =
    for rowIndex in 0..<indexes.len:
        let oldIndex = indexes[rowIndex]
        if oldIndex < 0:
            if allowMissing && oldIndex == -1:
                continue
            err = Fmt" typed expr: compact canonical invalid entry reference column={column} row={rowIndex} value={oldIndex}"
            return false
        if oldIndex >= remap.len || remap[oldIndex] < 0:
            err = Fmt" typed expr: compact canonical non-metadata entry reference column={column} row={rowIndex} value={oldIndex}"
            return false
        indexes[rowIndex] = remap[oldIndex]
    return true

@borrows
fn typedExprBuildCompactCanonicalIndex(
        full: TypedExprBuildIndex,
        projection: var typedExprFrozenMetadataProjection,
        err: var str): TypedExprBuildIndex =
    if full == nil || full.released || full.compactCanonical ||
       projection == nil || projection.released ||
       projection.internPool == nil:
        err = " typed expr: compact canonical source unavailable"
        return nil
    if full.hardError != "" || !full.callDeclarationSealed:
        err = " typed expr: compact canonical source lifecycle invalid"
        return nil
    let fullEntryCount = full.entryKinds.len
    if fullEntryCount != full.entrySourcePaths.len ||
       fullEntryCount != full.entryNames.len ||
       fullEntryCount != full.entryDetails.len ||
       fullEntryCount != full.entryStates.len ||
       fullEntryCount != full.entryValueIndexes.len ||
       fullEntryCount != full.entryOrigins.len ||
       fullEntryCount != full.entryFingerprints.len ||
       fullEntryCount != full.entryValidationMarks.len:
        err = " typed expr: compact canonical source entry columns mismatch"
        return nil
    var metadataEntryCount: int32
    var entryRemap: int32[]
    for oldIndex in 0..<fullEntryCount:
        add(entryRemap, -1)
        if typedExprCanonicalMetadataEntryKind(full.entryKinds[oldIndex]):
            metadataEntryCount = typedExprCheckedAddInt32(
                metadataEntryCount, 1, "compact_canonical_entry_count")
    let out = TypedExprBuildIndexNew(typedExprCheckedAddInt32(
        metadataEntryCount, 16, "compact_canonical_capacity"))
    out.compactCanonical = true
    out.entryBucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(metadataEntryCount, 8,
                                 "compact_canonical_entry_buckets"))
    for oldIndex in 0..<fullEntryCount:
        let kind = full.entryKinds[oldIndex]
        if !typedExprCanonicalMetadataEntryKind(kind):
            continue
        let sourcePath = full.entrySourcePaths[oldIndex]
        let name = full.entryNames[oldIndex]
        let detail = full.entryDetails[oldIndex]
        let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
        let bucket = TypedExprBuildIndexBucket(hashValue,
                                                out.entryBucketHeads.len)
        let rowIndex = out.entryKindIds.len
        entryRemap[oldIndex] = rowIndex
        add(out.entryNext, out.entryBucketHeads[bucket])
        add(out.entryHashes, hashValue)
        add(out.entryKindIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(kind)))
        add(out.entrySourcePathIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(sourcePath)))
        add(out.entryNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        add(out.entryDetailIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(detail)))
        add(out.entryStates, full.entryStates[oldIndex])
        add(out.entryValueIndexes, full.entryValueIndexes[oldIndex])
        add(out.entryOriginIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.entryOrigins[oldIndex])))
        add(out.entryFingerprintIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.entryFingerprints[oldIndex])))
        add(out.entryValidationMarks, full.entryValidationMarks[oldIndex])
        out.entryBucketHeads[bucket] = rowIndex

    let visibilityCount = full.visibilityKinds.len
    if visibilityCount != full.visibilitySourcePaths.len ||
       visibilityCount != full.visibilityNames.len ||
       visibilityCount != full.visibilityDetails.len ||
       visibilityCount != full.visibilityValueIndexes.len ||
       visibilityCount != full.visibilityFingerprints.len:
        err = " typed expr: compact canonical visibility columns mismatch"
        return nil
    out.visibilityBucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(visibilityCount, 8,
                                 "compact_canonical_visibility_buckets"))
    for rowIndex in 0..<visibilityCount:
        let kind = full.visibilityKinds[rowIndex]
        let sourcePath = full.visibilitySourcePaths[rowIndex]
        let name = full.visibilityNames[rowIndex]
        let detail = full.visibilityDetails[rowIndex]
        let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
        let bucket = TypedExprBuildIndexBucket(hashValue,
                                                out.visibilityBucketHeads.len)
        add(out.visibilityNext, out.visibilityBucketHeads[bucket])
        add(out.visibilityHashes, hashValue)
        add(out.visibilityKindIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(kind)))
        add(out.visibilitySourcePathIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(sourcePath)))
        add(out.visibilityNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        add(out.visibilityDetailIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(detail)))
        add(out.visibilityValueIndexes,
            full.visibilityValueIndexes[rowIndex])
        add(out.visibilityFingerprintIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.visibilityFingerprints[rowIndex])))
        out.visibilityBucketHeads[bucket] = rowIndex

    let ownerCount = full.importOwnerSourcePaths.len
    if ownerCount != full.importOwnerTargetHeads.len:
        err = " typed expr: compact canonical import-owner columns mismatch"
        return nil
    out.importOwnerBucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(ownerCount, 8,
                                 "compact_canonical_import_owner_buckets"))
    for ownerIndex in 0..<ownerCount:
        let sourcePath = full.importOwnerSourcePaths[ownerIndex]
        let hashValue = TypedExprBuildIndexHash2(sourcePath, "")
        let bucket = TypedExprBuildIndexBucket(hashValue,
                                                out.importOwnerBucketHeads.len)
        add(out.importOwnerNext, out.importOwnerBucketHeads[bucket])
        add(out.importOwnerHashes, hashValue)
        add(out.importOwnerSourcePathIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(sourcePath)))
        add(out.importOwnerTargetHeads,
            full.importOwnerTargetHeads[ownerIndex])
        out.importOwnerBucketHeads[bucket] = ownerIndex
    if full.importTargetNext.len != full.importTargetEntryIndexes.len:
        err = " typed expr: compact canonical import-target columns mismatch"
        return nil
    for nodeIndex in 0..<full.importTargetNext.len:
        let oldEntryIndex = full.importTargetEntryIndexes[nodeIndex]
        if oldEntryIndex < 0 || oldEntryIndex >= entryRemap.len ||
           entryRemap[oldEntryIndex] < 0:
            err = Fmt" typed expr: compact canonical import target is not metadata node={nodeIndex}"
            return nil
        add(out.importTargetNext, full.importTargetNext[nodeIndex])
        add(out.importTargetEntryIndexes, entryRemap[oldEntryIndex])

    let callCount = full.callDeclarationSourcePaths.len
    if callCount != full.callDeclarationNames.len ||
       callCount != full.callDeclarationArities.len ||
       callCount != full.callDeclarationGenericStarts.len ||
       callCount != full.callDeclarationGenericCounts.len ||
       callCount != full.callDeclarationParamStarts.len ||
       callCount != full.callDeclarationParamCounts.len ||
       callCount != full.callDeclarationReturnTypes.len ||
       callCount != full.callDeclarationTargetSymbols.len ||
       callCount != full.callDeclarationSignatureLineNumbers.len ||
       callCount != full.callDeclarationKinds.len ||
       callCount != full.callDeclarationResultExprClasses.len ||
       callCount != full.callDeclarationProducerSourceIndexes.len ||
       callCount !=
           full.callDeclarationProducerDeclarationOrdinals.len ||
       callCount != full.callDeclarationProducerFunctionRows.len ||
       callCount != full.callDeclarationManualConsumePresents.len ||
       callCount !=
           full.callDeclarationManualConsumeFunctionDeclarationRows.len ||
       callCount !=
           full.callDeclarationManualConsumeTargetParameterOrdinals.len ||
       callCount !=
           full.callDeclarationManualConsumeSourceParameterOrdinals.len ||
       callCount !=
           full.callDeclarationManualConsumeTargetParameterDeclarationRows.len ||
       callCount !=
           full.callDeclarationManualConsumeSourceParameterDeclarationRows.len ||
       callCount != full.callDeclarationManualConsumeTargetTypeIds.len ||
       callCount != full.callDeclarationManualConsumeSourceTypeIds.len ||
       callCount != full.callDeclarationManualConsumeEffectCids.len ||
       callCount != full.callDeclarationSortedRows.len:
        err = " typed expr: compact canonical call columns mismatch"
        return nil
    for rowIndex in 0..<callCount:
        add(out.callDeclarationSourcePathIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.callDeclarationSourcePaths[rowIndex])))
        add(out.callDeclarationNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.callDeclarationNames[rowIndex])))
        add(out.callDeclarationArities,
            full.callDeclarationArities[rowIndex])
        add(out.callDeclarationGenericStarts,
            full.callDeclarationGenericStarts[rowIndex])
        add(out.callDeclarationGenericCounts,
            full.callDeclarationGenericCounts[rowIndex])
        add(out.callDeclarationParamStarts,
            full.callDeclarationParamStarts[rowIndex])
        add(out.callDeclarationParamCounts,
            full.callDeclarationParamCounts[rowIndex])
        add(out.callDeclarationReturnTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.callDeclarationReturnTypes[rowIndex])))
        add(out.callDeclarationTargetSymbolIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.callDeclarationTargetSymbols[rowIndex])))
        add(out.callDeclarationSignatureLineNumbers,
            full.callDeclarationSignatureLineNumbers[rowIndex])
        add(out.callDeclarationKinds,
            full.callDeclarationKinds[rowIndex])
        add(out.callDeclarationResultExprClasses,
            full.callDeclarationResultExprClasses[rowIndex])
        add(out.callDeclarationProducerSourceIndexes,
            full.callDeclarationProducerSourceIndexes[rowIndex])
        add(out.callDeclarationProducerDeclarationOrdinals,
            full.callDeclarationProducerDeclarationOrdinals[rowIndex])
        add(out.callDeclarationProducerFunctionRows,
            full.callDeclarationProducerFunctionRows[rowIndex])
        add(out.callDeclarationManualConsumePresents,
            full.callDeclarationManualConsumePresents[rowIndex])
        add(out.callDeclarationManualConsumeFunctionDeclarationRows,
            full.callDeclarationManualConsumeFunctionDeclarationRows[rowIndex])
        add(out.callDeclarationManualConsumeTargetParameterOrdinals,
            full.callDeclarationManualConsumeTargetParameterOrdinals[rowIndex])
        add(out.callDeclarationManualConsumeSourceParameterOrdinals,
            full.callDeclarationManualConsumeSourceParameterOrdinals[rowIndex])
        add(out.callDeclarationManualConsumeTargetParameterDeclarationRows,
            full.callDeclarationManualConsumeTargetParameterDeclarationRows[rowIndex])
        add(out.callDeclarationManualConsumeSourceParameterDeclarationRows,
            full.callDeclarationManualConsumeSourceParameterDeclarationRows[rowIndex])
        add(out.callDeclarationManualConsumeTargetTypeIds,
            full.callDeclarationManualConsumeTargetTypeIds[rowIndex])
        add(out.callDeclarationManualConsumeSourceTypeIds,
            full.callDeclarationManualConsumeSourceTypeIds[rowIndex])
        add(out.callDeclarationManualConsumeEffectCids,
            layout.FixedBytes32Copy(
                full.callDeclarationManualConsumeEffectCids[rowIndex]))
        add(out.callDeclarationSortedRows,
            full.callDeclarationSortedRows[rowIndex])
    for genericIndex in 0..<full.callDeclarationGenericNames.len:
        add(out.callDeclarationGenericNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.callDeclarationGenericNames[genericIndex])))
    for paramIndex in 0..<full.callDeclarationParamTypes.len:
        add(out.callDeclarationParamTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.callDeclarationParamTypes[paramIndex])))
    out.callDeclarationManualConsumeTypeArenaBound =
        full.callDeclarationManualConsumeTypeArenaBound

    for contextIndex in 0..<full.contextSourcePaths.len:
        add(out.contextSourcePathIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(full.contextSourcePaths[contextIndex])))
    for columnIndex in 0..<full.contextMetadataDomainCounts.len:
        add(out.contextMetadataDomainCounts,
            full.contextMetadataDomainCounts[columnIndex])

    let fieldOwnerCount = full.contextFieldOwnerSourcePaths.len
    if fieldOwnerCount != full.contextFieldOwnerTypes.len ||
       fieldOwnerCount != full.contextFieldOwnerHeads.len ||
       fieldOwnerCount != full.contextFieldOwnerTails.len:
        err = " typed expr: compact canonical context-field owner columns mismatch"
        return nil
    out.contextFieldOwnerBucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(fieldOwnerCount, 8,
                                 "compact_canonical_field_owner_buckets"))
    for ownerIndex in 0..<fieldOwnerCount:
        let sourcePath = full.contextFieldOwnerSourcePaths[ownerIndex]
        let ownerType = full.contextFieldOwnerTypes[ownerIndex]
        let hashValue = TypedExprBuildIndexHash2(sourcePath, ownerType)
        let bucket = TypedExprBuildIndexBucket(
            hashValue, out.contextFieldOwnerBucketHeads.len)
        add(out.contextFieldOwnerNext,
            out.contextFieldOwnerBucketHeads[bucket])
        add(out.contextFieldOwnerHashes, hashValue)
        add(out.contextFieldOwnerSourcePathIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(sourcePath)))
        add(out.contextFieldOwnerTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(ownerType)))
        add(out.contextFieldOwnerHeads,
            full.contextFieldOwnerHeads[ownerIndex])
        add(out.contextFieldOwnerTails,
            full.contextFieldOwnerTails[ownerIndex])
        out.contextFieldOwnerBucketHeads[bucket] = ownerIndex
    let fieldNodeCount = full.contextFieldNodeNext.len
    if fieldNodeCount != full.contextFieldNodeContextIndexes.len ||
       fieldNodeCount != full.contextFieldNodeRowIndexes.len ||
       fieldNodeCount != full.contextFieldNodeDeclaredOffsetBytes.len ||
       fieldNodeCount != full.contextFieldNodeDeclaredSizeBytes.len ||
       fieldNodeCount != full.contextFieldNodeDeclaredAlignBytes.len ||
       fieldNodeCount != full.contextFieldNodeOffsetBytes.len ||
       fieldNodeCount != full.contextFieldNodeSizeBytes.len ||
       fieldNodeCount != full.contextFieldNodeAlignBytes.len ||
       fieldNodeCount != full.contextFieldNodeLayoutReady.len:
        err = " typed expr: compact canonical context-field node columns mismatch"
        return nil
    for nodeIndex in 0..<fieldNodeCount:
        add(out.contextFieldNodeNext, full.contextFieldNodeNext[nodeIndex])
        add(out.contextFieldNodeContextIndexes,
            full.contextFieldNodeContextIndexes[nodeIndex])
        add(out.contextFieldNodeRowIndexes,
            full.contextFieldNodeRowIndexes[nodeIndex])
        add(out.contextFieldNodeDeclaredOffsetBytes,
            full.contextFieldNodeDeclaredOffsetBytes[nodeIndex])
        add(out.contextFieldNodeDeclaredSizeBytes,
            full.contextFieldNodeDeclaredSizeBytes[nodeIndex])
        add(out.contextFieldNodeDeclaredAlignBytes,
            full.contextFieldNodeDeclaredAlignBytes[nodeIndex])
        add(out.contextFieldNodeOffsetBytes,
            full.contextFieldNodeOffsetBytes[nodeIndex])
        add(out.contextFieldNodeSizeBytes,
            full.contextFieldNodeSizeBytes[nodeIndex])
        add(out.contextFieldNodeAlignBytes,
            full.contextFieldNodeAlignBytes[nodeIndex])
        add(out.contextFieldNodeLayoutReady,
            full.contextFieldNodeLayoutReady[nodeIndex])

    if !typedExprRemapCanonicalEntryIndexes(
            projection.contextBuildEntryIndexes, entryRemap, false,
            "context", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.importBuildEntryIndexes, entryRemap, false,
            "import", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.importTargetBuildEntryIndexes, entryRemap, true,
            "import_target", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.declaredBuildEntryIndexes, entryRemap, false,
            "declared", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.refBuildEntryIndexes, entryRemap, false,
            "ref", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.aliasBuildEntryIndexes, entryRemap, false,
            "alias", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.fieldBuildEntryIndexes, entryRemap, false,
            "field", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.enumNameBuildEntryIndexes, entryRemap, false,
            "enum_name", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.enumTypeBuildEntryIndexes, entryRemap, false,
            "enum_type", err) ||
       !typedExprRemapCanonicalEntryIndexes(
            projection.moduleConstBuildEntryIndexes, entryRemap, false,
            "moduleconst", err):
        return nil

    # Query memo, source caches and IR/layout indexes belong to the build or
    # derived IR lifetime. They never enter the frozen canonical authority.
    out.visibilityQueryBucketHeads = []
    out.contentCacheBucketHeads = []
    out.fieldOwnerBucketHeads = []
    out.layoutBucketHeads = []
    out.buildCount = full.buildCount
    out.reuseCount = full.reuseCount
    out.contextCount = full.contextCount
    out.metadataDeclarationCount = full.metadataDeclarationCount
    out.visibilityEdgeCount = full.visibilityEdgeCount
    out.registerCount = full.registerCount
    out.registerProbeCount = full.registerProbeCount
    out.rehashEntryVisitCount = full.rehashEntryVisitCount
    out.queryLookupCount = full.queryLookupCount
    out.queryProbeCount = full.queryProbeCount
    out.queryMetadataScanCount = full.queryMetadataScanCount
    out.validationEpoch = full.validationEpoch
    out.buildGeneration = full.buildGeneration
    out.callDeclarationSealed = true
    out.contentCacheReleased = true
    out.permanentlySealed = true
    out.frozenReadOnlyQueries = true
    err = ""
    return out

@borrows
fn typedExprBuildDerivedIrIndex(ir: var TypedExprIr,
                                canonicalIndex: TypedExprBuildIndex,
                                projection: typedExprFrozenMetadataProjection): TypedExprBuildIndex =
    var capacity = typedExprCheckedAdd64(Int64(ir.typeLayoutNames.len),
                                         Int64(ir.typeFieldNames.len),
                                         "derived_ir_index_capacity")
    capacity = typedExprCheckedAdd64(capacity,
                                     Int64(ir.typeDefAliasNames.len),
                                     "derived_ir_index_capacity")
    capacity = typedExprCheckedAdd64(capacity,
                                     Int64(ir.typeAliasQualifiers.len),
                                     "derived_ir_index_capacity")
    capacity = typedExprCheckedAdd64(capacity,
                                     Int64(ir.enumValueNames.len),
                                     "derived_ir_index_capacity")
    capacity = typedExprCheckedAdd64(capacity,
                                     Int64(ir.refObjectTypeNames.len),
                                     "derived_ir_index_capacity")
    capacity = typedExprCheckedAdd64(capacity, 32,
                                     "derived_ir_index_capacity")
    let derived = TypedExprBuildIndexNew(typedExprCheckedInt32Capacity(
        capacity, "derived_ir_index_capacity"))
    # Derived IR rows borrow any text already owned by the immutable canonical
    # pool. Their ordinary string slots remain empty for borrowed values.
    derived.canonicalProjection = share(projection)
    derived.buildGeneration = canonicalIndex.buildGeneration
    derived.contextCount = canonicalIndex.contextCount
    derived.reuseCount = canonicalIndex.reuseCount
    derived.validationEpoch = canonicalIndex.validationEpoch
    derived.callDeclarationSealed = true
    # Call declarations remain wholly canonical during the frozen fixed point.
    # typedExprIrCallDeclarationOwnerIndex routes every declaration consumer to
    # that owner; copying even the structural columns here would create a
    # second declaration authority before the close-time ownership move.
    ir.buildIndex = share(derived)
    TypedExprBuildIndexSeedIrMetadata(ir)
    return derived

fn typedExprMoveCanonicalCallDeclarationsToDerived(
        canonicalIndex: var TypedExprBuildIndex,
        derivedIndex: var TypedExprBuildIndex) =
    if canonicalIndex == nil || derivedIndex == nil:
        panic("typed expr: canonical call declaration transfer missing index")
    let callCount = canonicalIndex.callDeclarationSourcePathIds.len
    let genericCount = canonicalIndex.callDeclarationGenericNameIds.len
    let paramCount = canonicalIndex.callDeclarationParamTypeIds.len
    if !canonicalIndex.compactCanonical ||
       !canonicalIndex.callDeclarationSealed ||
       derivedIndex.compactCanonical ||
       !derivedIndex.callDeclarationSealed ||
       canonicalIndex.callDeclarationNameIds.len != callCount ||
       canonicalIndex.callDeclarationReturnTypeIds.len != callCount ||
       canonicalIndex.callDeclarationTargetSymbolIds.len != callCount ||
       canonicalIndex.callDeclarationArities.len != callCount ||
       canonicalIndex.callDeclarationGenericStarts.len != callCount ||
       canonicalIndex.callDeclarationGenericCounts.len != callCount ||
       canonicalIndex.callDeclarationParamStarts.len != callCount ||
       canonicalIndex.callDeclarationParamCounts.len != callCount ||
       canonicalIndex.callDeclarationSignatureLineNumbers.len != callCount ||
       canonicalIndex.callDeclarationKinds.len != callCount ||
       canonicalIndex.callDeclarationResultExprClasses.len != callCount ||
       canonicalIndex.callDeclarationProducerSourceIndexes.len != callCount ||
       canonicalIndex.callDeclarationProducerDeclarationOrdinals.len !=
           callCount ||
       canonicalIndex.callDeclarationProducerFunctionRows.len !=
           callCount ||
       canonicalIndex.callDeclarationManualConsumePresents.len != callCount ||
       canonicalIndex.callDeclarationManualConsumeFunctionDeclarationRows.len !=
           callCount ||
       canonicalIndex.callDeclarationManualConsumeTargetParameterOrdinals.len !=
           callCount ||
       canonicalIndex.callDeclarationManualConsumeSourceParameterOrdinals.len !=
           callCount ||
       canonicalIndex.callDeclarationManualConsumeTargetParameterDeclarationRows.len !=
           callCount ||
       canonicalIndex.callDeclarationManualConsumeSourceParameterDeclarationRows.len !=
           callCount ||
       canonicalIndex.callDeclarationManualConsumeTargetTypeIds.len != callCount ||
       canonicalIndex.callDeclarationManualConsumeSourceTypeIds.len != callCount ||
       canonicalIndex.callDeclarationManualConsumeEffectCids.len != callCount ||
       canonicalIndex.callDeclarationSortedRows.len != callCount ||
       canonicalIndex.callDeclarationSourcePaths.len != 0 ||
       canonicalIndex.callDeclarationNames.len != 0 ||
       canonicalIndex.callDeclarationGenericNames.len != 0 ||
       canonicalIndex.callDeclarationParamTypes.len != 0 ||
       canonicalIndex.callDeclarationReturnTypes.len != 0 ||
       canonicalIndex.callDeclarationTargetSymbols.len != 0 ||
       derivedIndex.callDeclarationSourcePathIds.len != 0 ||
       derivedIndex.callDeclarationNameIds.len != 0 ||
       derivedIndex.callDeclarationGenericNameIds.len != 0 ||
       derivedIndex.callDeclarationParamTypeIds.len != 0 ||
       derivedIndex.callDeclarationReturnTypeIds.len != 0 ||
       derivedIndex.callDeclarationTargetSymbolIds.len != 0 ||
       derivedIndex.callDeclarationSortedRows.len != 0 ||
       derivedIndex.callDeclarationArities.len != 0 ||
       derivedIndex.callDeclarationGenericStarts.len != 0 ||
       derivedIndex.callDeclarationGenericCounts.len != 0 ||
       derivedIndex.callDeclarationParamStarts.len != 0 ||
       derivedIndex.callDeclarationParamCounts.len != 0 ||
       derivedIndex.callDeclarationSourcePaths.len != 0 ||
       derivedIndex.callDeclarationNames.len != 0 ||
       derivedIndex.callDeclarationGenericNames.len != 0 ||
       derivedIndex.callDeclarationParamTypes.len != 0 ||
       derivedIndex.callDeclarationReturnTypes.len != 0 ||
       derivedIndex.callDeclarationTargetSymbols.len != 0 ||
       derivedIndex.callDeclarationSignatureLineNumbers.len != 0 ||
       derivedIndex.callDeclarationResultExprClasses.len != 0 ||
       derivedIndex.callDeclarationKinds.len != 0 ||
       derivedIndex.callDeclarationProducerSourceIndexes.len != 0 ||
       derivedIndex.callDeclarationProducerDeclarationOrdinals.len != 0 ||
       derivedIndex.callDeclarationProducerFunctionRows.len != 0 ||
       derivedIndex.callDeclarationManualConsumePresents.len != 0 ||
       derivedIndex.callDeclarationManualConsumeFunctionDeclarationRows.len != 0 ||
       derivedIndex.callDeclarationManualConsumeTargetParameterOrdinals.len != 0 ||
       derivedIndex.callDeclarationManualConsumeSourceParameterOrdinals.len != 0 ||
       derivedIndex.callDeclarationManualConsumeTargetParameterDeclarationRows.len != 0 ||
       derivedIndex.callDeclarationManualConsumeSourceParameterDeclarationRows.len != 0 ||
       derivedIndex.callDeclarationManualConsumeTargetTypeIds.len != 0 ||
       derivedIndex.callDeclarationManualConsumeSourceTypeIds.len != 0 ||
       derivedIndex.callDeclarationManualConsumeEffectCids.len != 0:
        panic("typed expr: canonical call declaration transfer invalid")

    derivedIndex.callDeclarationSourcePathIds =
        canonicalIndex.callDeclarationSourcePathIds
    derivedIndex.callDeclarationNameIds =
        canonicalIndex.callDeclarationNameIds
    derivedIndex.callDeclarationGenericNameIds =
        canonicalIndex.callDeclarationGenericNameIds
    derivedIndex.callDeclarationParamTypeIds =
        canonicalIndex.callDeclarationParamTypeIds
    derivedIndex.callDeclarationReturnTypeIds =
        canonicalIndex.callDeclarationReturnTypeIds
    derivedIndex.callDeclarationTargetSymbolIds =
        canonicalIndex.callDeclarationTargetSymbolIds
    derivedIndex.callDeclarationSortedRows =
        canonicalIndex.callDeclarationSortedRows
    derivedIndex.callDeclarationArities =
        canonicalIndex.callDeclarationArities
    derivedIndex.callDeclarationGenericStarts =
        canonicalIndex.callDeclarationGenericStarts
    derivedIndex.callDeclarationGenericCounts =
        canonicalIndex.callDeclarationGenericCounts
    derivedIndex.callDeclarationParamStarts =
        canonicalIndex.callDeclarationParamStarts
    derivedIndex.callDeclarationParamCounts =
        canonicalIndex.callDeclarationParamCounts
    derivedIndex.callDeclarationSignatureLineNumbers =
        canonicalIndex.callDeclarationSignatureLineNumbers
    derivedIndex.callDeclarationResultExprClasses =
        canonicalIndex.callDeclarationResultExprClasses
    derivedIndex.callDeclarationKinds =
        canonicalIndex.callDeclarationKinds
    derivedIndex.callDeclarationProducerSourceIndexes =
        canonicalIndex.callDeclarationProducerSourceIndexes
    derivedIndex.callDeclarationProducerDeclarationOrdinals =
        canonicalIndex.callDeclarationProducerDeclarationOrdinals
    derivedIndex.callDeclarationProducerFunctionRows =
        canonicalIndex.callDeclarationProducerFunctionRows
    derivedIndex.callDeclarationManualConsumePresents =
        canonicalIndex.callDeclarationManualConsumePresents
    derivedIndex.callDeclarationManualConsumeFunctionDeclarationRows =
        canonicalIndex.callDeclarationManualConsumeFunctionDeclarationRows
    derivedIndex.callDeclarationManualConsumeTargetParameterOrdinals =
        canonicalIndex.callDeclarationManualConsumeTargetParameterOrdinals
    derivedIndex.callDeclarationManualConsumeSourceParameterOrdinals =
        canonicalIndex.callDeclarationManualConsumeSourceParameterOrdinals
    derivedIndex.callDeclarationManualConsumeTargetParameterDeclarationRows =
        canonicalIndex.callDeclarationManualConsumeTargetParameterDeclarationRows
    derivedIndex.callDeclarationManualConsumeSourceParameterDeclarationRows =
        canonicalIndex.callDeclarationManualConsumeSourceParameterDeclarationRows
    derivedIndex.callDeclarationManualConsumeTargetTypeIds =
        canonicalIndex.callDeclarationManualConsumeTargetTypeIds
    derivedIndex.callDeclarationManualConsumeSourceTypeIds =
        canonicalIndex.callDeclarationManualConsumeSourceTypeIds
    derivedIndex.callDeclarationManualConsumeEffectCids =
        canonicalIndex.callDeclarationManualConsumeEffectCids
    derivedIndex.callDeclarationManualConsumeTypeArenaBound =
        canonicalIndex.callDeclarationManualConsumeTypeArenaBound

    canonicalIndex.callDeclarationSourcePathIds = []
    canonicalIndex.callDeclarationNameIds = []
    canonicalIndex.callDeclarationGenericNameIds = []
    canonicalIndex.callDeclarationParamTypeIds = []
    canonicalIndex.callDeclarationReturnTypeIds = []
    canonicalIndex.callDeclarationTargetSymbolIds = []
    canonicalIndex.callDeclarationSortedRows = []
    canonicalIndex.callDeclarationArities = []
    canonicalIndex.callDeclarationGenericStarts = []
    canonicalIndex.callDeclarationGenericCounts = []
    canonicalIndex.callDeclarationParamStarts = []
    canonicalIndex.callDeclarationParamCounts = []
    canonicalIndex.callDeclarationSignatureLineNumbers = []
    canonicalIndex.callDeclarationKinds = []
    canonicalIndex.callDeclarationResultExprClasses = []
    canonicalIndex.callDeclarationProducerSourceIndexes = []
    canonicalIndex.callDeclarationProducerDeclarationOrdinals = []
    canonicalIndex.callDeclarationProducerFunctionRows = []
    canonicalIndex.callDeclarationManualConsumePresents = []
    canonicalIndex.callDeclarationManualConsumeFunctionDeclarationRows = []
    canonicalIndex.callDeclarationManualConsumeTargetParameterOrdinals = []
    canonicalIndex.callDeclarationManualConsumeSourceParameterOrdinals = []
    canonicalIndex.callDeclarationManualConsumeTargetParameterDeclarationRows = []
    canonicalIndex.callDeclarationManualConsumeSourceParameterDeclarationRows = []
    canonicalIndex.callDeclarationManualConsumeTargetTypeIds = []
    canonicalIndex.callDeclarationManualConsumeSourceTypeIds = []
    canonicalIndex.callDeclarationManualConsumeEffectCids = []
    canonicalIndex.callDeclarationManualConsumeTypeArenaBound = false
    canonicalIndex.callDeclarationSealed = false

    setLen(derivedIndex.callDeclarationSourcePaths, callCount)
    setLen(derivedIndex.callDeclarationNames, callCount)
    setLen(derivedIndex.callDeclarationGenericNames, genericCount)
    setLen(derivedIndex.callDeclarationParamTypes, paramCount)
    setLen(derivedIndex.callDeclarationReturnTypes, callCount)
    setLen(derivedIndex.callDeclarationTargetSymbols, callCount)

@borrows
fn typedExprBuildIndexAppendPlainEntry(index: var TypedExprBuildIndex,
                                       kind: str,
                                       sourcePath: str,
                                       name: str,
                                       detail: str,
                                       valueIndex: int32,
                                       origin: str,
                                       fingerprint: str,
                                       existingOut: var int32): int32 =
    # Close-time verbatim transfer append. Mirrors the new-entry arm of
    # TypedExprBuildIndexRegister without the mutability gate: the derived
    # index is permanently sealed for consumers, and the close transfer is the
    # sole writer. Returns the appended row, or -1 with existingOut set when
    # the key is already present.
    existingOut = TypedExprBuildIndexFindEntry(index,
                                                kind,
                                                sourcePath,
                                                name,
                                                detail,
                                                true)
    if existingOut >= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                           index.entryBucketHeads.len)
    let entryIndex = index.entryKinds.len
    seqs.Add(index.entryNext, index.entryBucketHeads[bucket])
    seqs.Add(index.entryHashes, hashValue)
    typedExprBuildIndexAppendBorrowedText(
        index, typedExprBuildIndexTextColumnEntryKind, kind)
    typedExprBuildIndexAppendBorrowedText(
        index, typedExprBuildIndexTextColumnEntrySourcePath, sourcePath)
    typedExprBuildIndexAppendBorrowedText(
        index, typedExprBuildIndexTextColumnEntryName, name)
    typedExprBuildIndexAppendBorrowedText(
        index, typedExprBuildIndexTextColumnEntryDetail, detail)
    seqs.Add(index.entryStates, TypedExprBuildIndexUnique)
    seqs.Add(index.entryValueIndexes, valueIndex)
    typedExprBuildIndexAppendBorrowedText(
        index, typedExprBuildIndexTextColumnEntryOrigin, origin)
    typedExprBuildIndexAppendBorrowedText(
        index, typedExprBuildIndexTextColumnEntryFingerprint, fingerprint)
    seqs.Add(index.entryValidationMarks, 0)
    index.entryBucketHeads[bucket] = entryIndex
    return entryIndex

@borrows
fn typedExprMoveCanonicalConstResolutionToDerived(
        canonicalIndex: TypedExprBuildIndex,
        derivedIndex: var TypedExprBuildIndex) =
    # Post-close module-const resolution reads the derived index only (the
    # canonical metadata index is released at close). Move exactly the rows
    # the const resolver consumes: context source paths, import-alias edges,
    # and module-const rows. Import-visible consts are flattened into the
    # importer's own-const kind; an own-module row shadows, and a
    # visible-vs-visible name collision keeps Ambiguous, mirroring
    # TypedExprBuildIndexVisibleLookup semantics without the visibility graph.
    if canonicalIndex == nil || derivedIndex == nil ||
       !canonicalIndex.compactCanonical || derivedIndex.compactCanonical:
        panic("typed expr: canonical const resolution transfer invalid")
    if derivedIndex.contextSourcePaths.len != 0 ||
       derivedIndex.contextSourcePathIds.len != 0:
        panic("typed expr: derived context paths populated before const transfer")
    let contextCount = typedExprBuildIndexContextSourceCount(canonicalIndex)
    for row in 0..<contextCount:
        typedExprBuildIndexAppendBorrowedText(
            derivedIndex,
            typedExprBuildIndexTextColumnContextSourcePath,
            typedExprBuildIndexContextSourcePath(canonicalIndex, row))
    let entryCount = typedExprBuildIndexEntryCount(canonicalIndex)
    for row in 0..<entryCount:
        let kind = typedExprBuildIndexEntryKind(canonicalIndex, row)
        if kind != "ctx_import_alias" && kind != "ctx_module_const_source":
            continue
        if canonicalIndex.entryStates[row] != TypedExprBuildIndexUnique:
            panic("typed expr: canonical const resolution row is not unique")
        var existingRow: int32
        if typedExprBuildIndexAppendPlainEntry(
                derivedIndex,
                kind,
                typedExprBuildIndexEntrySourcePath(canonicalIndex, row),
                typedExprBuildIndexEntryName(canonicalIndex, row),
                typedExprBuildIndexEntryDetail(canonicalIndex, row),
                canonicalIndex.entryValueIndexes[row],
                typedExprBuildIndexEntryOrigin(canonicalIndex, row),
                typedExprBuildIndexEntryFingerprint(canonicalIndex, row),
                existingRow) < 0:
            panic("typed expr: const resolution transfer key collision")
    var visibleRows: int32[]
    for row in 0..<entryCount:
        if typedExprBuildIndexEntryKind(canonicalIndex, row) !=
           "ctx_import_module_const":
            continue
        let name = typedExprBuildIndexEntryName(canonicalIndex, row)
        if !TypedExprTopLevelDeclarationExportedByCase(name):
            continue
        let owner = typedExprBuildIndexEntrySourcePath(canonicalIndex, row)
        let detail = typedExprBuildIndexEntryDetail(canonicalIndex, row)
        var existingRow = TypedExprBuildIndexFindEntry(derivedIndex,
                                                       "ctx_module_const_source",
                                                       owner,
                                                       name,
                                                       detail,
                                                       true)
        if existingRow >= 0:
            var earlierVisible = false
            for visibleIndex in 0..<visibleRows.len:
                if visibleRows[visibleIndex] == existingRow:
                    earlierVisible = true
                    break
            if !earlierVisible:
                # An own-module row shadows any import-visible candidate.
                continue
            if canonicalIndex.entryStates[row] == TypedExprBuildIndexAmbiguous ||
               typedExprBuildIndexEntryFingerprint(derivedIndex, existingRow) !=
               typedExprBuildIndexEntryFingerprint(canonicalIndex, row):
                derivedIndex.entryStates[existingRow] =
                    TypedExprBuildIndexAmbiguous
                derivedIndex.entryValueIndexes[existingRow] = -1
            continue
        var collisionRow: int32
        let appended = typedExprBuildIndexAppendPlainEntry(
            derivedIndex,
            "ctx_module_const_source",
            owner,
            name,
            detail,
            canonicalIndex.entryValueIndexes[row],
            typedExprBuildIndexEntryOrigin(canonicalIndex, row),
            typedExprBuildIndexEntryFingerprint(canonicalIndex, row),
            collisionRow)
        if appended < 0:
            panic("typed expr: const resolution visible transfer state corrupt")
        add(visibleRows, appended)
        if canonicalIndex.entryStates[row] == TypedExprBuildIndexAmbiguous:
            derivedIndex.entryStates[appended] = TypedExprBuildIndexAmbiguous
            derivedIndex.entryValueIndexes[appended] = -1

# CompilerCSG fixed-point entry. The one complete validation below precedes the
# ownership transfer; all later rounds can only reach the private frozen copy.
fn TypedExprSealBuildSourceContextIndex(ir: var TypedExprIr,
                                         sourceContexts: var TypedExprSourceContext[],
                                         err: var str): bool =
    err = ""
    if ir.typedExprMetadataSession != nil:
        err = typedExprFrozenSealDiagnostic("session_exists",
                                            "metadata session already exists")
        return false
    if ir.buildIndex == nil || ir.buildIndex.released:
        err = typedExprFrozenSealDiagnostic("index_unavailable",
                                            "existing live index required")
        return false
    let index = ir.buildIndex
    if index.permanentlySealed || index.frozenReadOnlyQueries:
        panic("typed expr: frozen metadata seal entered during read-only query window")
    if sourceContexts.len <= 0:
        err = typedExprFrozenSealDiagnostic("context_set_empty",
                                            "context set empty")
        return false
    if !typedExprSequenceBufferUnique(sourceContexts):
        let contextSequenceBuffer = seqs.bufferIdentity(sourceContexts)
        let contextSequenceRefCount = memRefCount(contextSequenceBuffer)
        err = typedExprFrozenSealDiagnostic(
            "context_sequence_shared",
            Fmt"context sequence is not uniquely owned ref_count={contextSequenceRefCount}")
        return false
    for contextIndex in 0..<sourceContexts.len:
        var sharedColumnId: int32
        var sharedColumnName: str
        var sharedRefCount: int32
        if typedExprSourceContextFirstSharedMetadataBufferInto(
               sourceContexts[contextIndex],
               sharedColumnId,
               sharedColumnName,
               sharedRefCount):
            err = typedExprFrozenSealDiagnostic(
                "context_storage_shared",
                Fmt"context has shared mutable storage index={contextIndex} column_id={sharedColumnId} column={sharedColumnName} ref_count={sharedRefCount}")
            return false
    if !ir.typedExprGlobalMetadataReady:
        err = typedExprFrozenSealDiagnostic(
            "global_metadata_missing",
            "first-round global metadata required")
        return false
    if ir.buildIndexGeneration <= 0 ||
       index.buildGeneration != ir.buildIndexGeneration ||
       index.contentCacheReleased || !index.callDeclarationSealed ||
       index.contextCount != sourceContexts.len ||
       index.contextSourcePaths.len != sourceContexts.len ||
       index.contextMetadataDomainCounts.len !=
           typedExprContextDomainColumnCount(sourceContexts.len) ||
       index.entryValidationMarks.len != index.entryKinds.len ||
       ir.sourceContextIndexSourcePaths.len != index.contextSourcePaths.len ||
       ir.sourceContextIndexBucketHeads.len != 0 ||
       ir.sourceContextIndexEntryNext.len != 0 ||
       ir.sourceContextIndexEntryIndexes.len != 0:
        err = typedExprFrozenSealDiagnostic("index_lifecycle_drift",
                                            "build-index lifecycle drift")
        return false
    let reuseBefore = index.reuseCount
    let validationEpochBefore = index.validationEpoch
    var projection: typedExprFrozenMetadataProjection
    if !typedExprBuildFrozenMetadataProjection(index,
                                                sourceContexts,
                                                projection,
                                                err):
        err = typedExprFrozenSealDiagnostic("canonical_store_invalid", err)
        typedExprReleaseFrozenMetadataProjection(projection)
        return false
    if !typedExprFrozenIrGlobalsExact(ir, projection, err):
        err = typedExprFrozenSealDiagnostic("global_commit_invalid", err)
        typedExprReleaseFrozenMetadataProjection(projection)
        return false
    if ir.typedExprMetadataSessionGeneration < 0 ||
       ir.typedExprMetadataSessionGeneration >= 2147483647:
        typedExprReleaseFrozenMetadataProjection(projection)
        panic("typed expr: frozen metadata session generation exhausted")
    var session: typedExprFrozenMetadataSession = new(typedExprFrozenMetadataSession)
    # No recoverable work remains after this point. The complete validation is
    # the only mutation before the private projection commit and context release.
    if reuseBefore < 0 || reuseBefore >= 2147483647 ||
       validationEpochBefore < 0 ||
       validationEpochBefore > 2147483647 - sourceContexts.len:
        panic("typed expr: frozen metadata seal epoch telemetry exhausted")
    TypedExprBuildSourceContextIndex(ir, sourceContexts)
    if ir.buildIndex != index || index.released ||
       index.reuseCount != reuseBefore + 1 ||
       index.validationEpoch != validationEpochBefore + sourceContexts.len:
        panic("typed expr: frozen metadata seal validation did not commit exactly")
    session.preSealFullIndexBytes =
        TypedExprBuildIndexStructuredLiveBytes(index)
    # Finish the canonical intern pool before seeding derived rows. Compact
    # metadata contributes exact payloads such as enum fingerprints; seeding
    # first would classify those values as IR-owned and duplicate them once the
    # compact index interns the same text.
    var compactErr: str
    let compactIndex = typedExprBuildCompactCanonicalIndex(index,
                                                            projection,
                                                            compactErr)
    if compactIndex == nil:
        panic(Fmt"typed expr: compact canonical build failed detail={compactErr}")
    compactIndex.canonicalProjection = share(projection)
    let derivedIndex = typedExprBuildDerivedIrIndex(ir, index, projection)
    if derivedIndex == nil || derivedIndex == index ||
       derivedIndex.permanentlySealed ||
       derivedIndex.buildGeneration != index.buildGeneration ||
       derivedIndex.contextCount != index.contextCount:
        panic("typed expr: frozen metadata derived IR index split failed")
    let derivedIrSemanticTextBytes =
        typedExprBuildIndexOwnedSemanticTextBytes(derivedIndex)
    let derivedIrCanonicalTextOverlapBytes =
        typedExprDerivedIrCanonicalTextOverlapBytes(derivedIndex,
                                                     projection)
    let derivedMetadataDuplicateBytes =
        typedExprDerivedCanonicalMetadataDuplicateBytes(derivedIndex)
    # Keep the immutable text->id index through the frozen session. Derived-row
    # borrowing and overlap audits require one exact O(1) lookup per value; the
    # projection release at close frees both directions together.
    session.sessionGeneration = ir.typedExprMetadataSessionGeneration + 1
    session.contextCount = sourceContexts.len
    session.fullContextCount = 0
    session.buildGeneration = compactIndex.buildGeneration
    session.buildCount = compactIndex.buildCount
    session.validationEpochAtSeal = compactIndex.validationEpoch
    session.reuseCountAtSeal = compactIndex.reuseCount
    session.fullValidationCount = 1
    for contextIndex in 0..<projection.contextMetadataRowCounts.len:
        let rowCount = projection.contextMetadataRowCounts[contextIndex]
        if rowCount < 0 || session.metadataRowCount > 2147483647 - rowCount:
            panic("typed expr: frozen metadata row telemetry exhausted")
        session.metadataRowCount = session.metadataRowCount + rowCount
    session.scopeCount = projection.scopes.nameIds.len
    session.importcCount = projection.importcs.nameIds.len
    typedExprFrozenCanonicalDigest(projection,
                                    session.canonicalDigestFirst,
                                    session.canonicalDigestSecond)
    session.canonicalIndexBytes =
        TypedExprBuildIndexStructuredLiveBytes(compactIndex)
    session.canonicalStoreBytes = typedExprFrozenProjectionLiveBytes(projection)
    session.derivedIrSemanticTextBytes = derivedIrSemanticTextBytes
    session.derivedIrCanonicalTextOverlapBytes =
        derivedIrCanonicalTextOverlapBytes
    session.duplicatedSemanticTextBytes = typedExprCheckedAdd64(
        typedExprBuildIndexOwnedSemanticTextBytes(compactIndex),
        derivedMetadataDuplicateBytes,
        "duplicated_semantic_text_bytes")
    session.duplicatedSemanticTextBytes = typedExprCheckedAdd64(
        session.duplicatedSemanticTextBytes,
        derivedIrCanonicalTextOverlapBytes,
        "duplicated_semantic_text_bytes")
    if session.duplicatedSemanticTextBytes != 0:
        panic("typed expr: compact canonical retained duplicated semantic text")
    if session.preSealFullIndexBytes <= 0 ||
       session.canonicalIndexBytes <= 0 ||
       session.canonicalIndexBytes >= session.preSealFullIndexBytes:
        panic(Fmt"typed expr: compact canonical live-byte reduction unproved before={session.preSealFullIndexBytes} after={session.canonicalIndexBytes}")
    session.projection = projection
    session.index = compactIndex
    ir.typedExprMetadataSessionGeneration = session.sessionGeneration
    ir.typedExprMetadataSession = session
    # Commit is complete. No operation below can return false; release every
    # full context immediately so the fixed-point lifetime retains only SoA.
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), Fmt"O8SEALLOOP n={sourceContexts.len}")
    for contextIndex in 0..<sourceContexts.len:
        TypedExprClearSourceContextAllFields(sourceContexts[contextIndex])
    sourceContexts = []
    TypedExprBuildIndexRelease(index)
    return true

fn TypedExprCloseSealedBuildSourceContextIndex(ir: var TypedExprIr,
                                                err: var str): bool =
    err = ""
    if ir.typedExprMetadataSession == nil:
        err = " typed expr: frozen metadata session missing at close"
        return false
    if ir.typedExprMetadataSession.closed || ir.typedExprMetadataSession.released:
        err = " typed expr: frozen metadata session already closed"
        return false
    let active = typedExprRequireFrozenMetadataSession(ir, "close")
    if !active.index.permanentlySealed ||
       !active.index.frozenReadOnlyQueries:
        panic("typed expr: frozen metadata close lost permanent seal")
    if active.roundViewLiveBytes != 0 || active.roundContextCount != 0 ||
       active.roundDependencyCount != 0:
        panic("typed expr: frozen metadata close while round view is live")
    if active.fullValidationCount != 1:
        panic("typed expr: frozen metadata full-validation count drift before close")
    let reuseBefore = ir.buildIndex.reuseCount
    let validationEpochBefore = ir.buildIndex.validationEpoch
    if reuseBefore != active.reuseCountAtSeal ||
       validationEpochBefore != active.validationEpochAtSeal:
        panic("typed expr: frozen metadata close epoch drift before final validation")
    if active.reuseCountAtSeal >= 2147483647 ||
       active.validationEpochAtSeal > 2147483647 - active.contextCount:
        panic("typed expr: frozen metadata close epoch telemetry exhausted")
    var auditErr: str
    var digestFirst: int64
    var digestSecond: int64
    typedExprFrozenCanonicalDigest(active.projection,
                                    digestFirst,
                                    digestSecond)
    if digestFirst != active.canonicalDigestFirst ||
       digestSecond != active.canonicalDigestSecond:
        panic("typed expr: frozen metadata canonical digest drift")
    # Compare independent canonical projection values directly with their
    # structured BuildIndex rows. Bucket hashes select no equality outcome.
    if !typedExprFrozenProjectionMatchesBuildIndex(ir, active, auditErr):
        panic(auditErr)
    ir.buildIndex.reuseCount = ir.buildIndex.reuseCount + 1
    ir.buildIndex.validationEpoch =
        ir.buildIndex.validationEpoch + active.contextCount
    if ir.buildIndex.reuseCount != active.reuseCountAtSeal + 1 ||
       ir.buildIndex.validationEpoch !=
           active.validationEpochAtSeal + active.contextCount ||
       active.index.reuseCount != active.reuseCountAtSeal ||
       active.index.validationEpoch != active.validationEpochAtSeal:
        panic("typed expr: frozen metadata close epoch commit drift")
    active.fullValidationCount = 2
    active.finalValidationEpoch = ir.buildIndex.validationEpoch
    active.derivedIrCanonicalTextOverlapBytes =
        typedExprDerivedIrCanonicalTextOverlapBytes(ir.buildIndex,
                                                     active.projection)
    active.duplicatedSemanticTextBytes =
        typedExprPostSealDuplicatedSemanticTextBytes(active, ir.buildIndex)
    if active.duplicatedSemanticTextBytes != 0 ||
       active.derivedIrCanonicalTextOverlapBytes != 0:
        panic("typed expr: frozen metadata duplicate text appeared during close")
    # The canonical query index is dead after the exact audit. Transfer borrowed
    # declaration structure first, then materialize all borrowed text while the
    # intern pool is still live. The backend index becomes the sole declaration
    # owner without retaining the full canonical metadata index.
    var canonicalIndex: TypedExprBuildIndex
    canonicalIndex = active.index
    active.index = nil
    var derivedIndex: TypedExprBuildIndex
    derivedIndex = ir.buildIndex
    ir.buildIndex = nil
    typedExprMoveCanonicalCallDeclarationsToDerived(canonicalIndex,
                                                     derivedIndex)
    typedExprMoveCanonicalConstResolutionToDerived(canonicalIndex,
                                                    derivedIndex)
    TypedExprBuildIndexRelease(canonicalIndex)
    typedExprBuildIndexDetachCanonicalText(derivedIndex)
    if derivedIndex.contextMetadataDomainCounts.len != 0 ||
       derivedIndex.contextSourcePaths.len != derivedIndex.contextCount ||
       derivedIndex.canonicalProjection != nil ||
       derivedIndex.compactCanonical:
        panic("typed expr: derived canonical metadata transfer incomplete")
    derivedIndex.canonicalMetadataTransferred = true
    active.derivedIrSemanticTextBytes =
        typedExprBuildIndexOwnedSemanticTextBytes(derivedIndex)
    var ownedProjection: typedExprFrozenMetadataProjection
    ownedProjection = active.projection
    active.projection = nil
    typedExprReleaseFrozenMetadataProjection(ownedProjection)
    active.canonicalIndexBytes = 0
    active.canonicalStoreBytes = 0
    active.closed = true
    ir.buildIndex = derivedIndex
    return true

@borrows
fn TypedExprSourceContextLookupWithIndex(ir: var TypedExprIr,
                                           sourcePathRaw: str): int32 =
    var sourcePath: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, pathErr):
        return -1
    if sourcePath == "":
        return -1
    var lookupIndex = ir.buildIndex
    if ir.typedExprMetadataSession != nil &&
       !ir.typedExprMetadataSession.closed &&
       !ir.typedExprMetadataSession.released &&
       ir.typedExprMetadataSession.index != nil:
        lookupIndex = ir.typedExprMetadataSession.index
    var contextIndex: int32
    let state = TypedExprBuildIndexLookup(lookupIndex,
                                          "ctx_source", sourcePath, "", "", contextIndex)
    if state == TypedExprBuildIndexAmbiguous:
        return -2
    if state != TypedExprBuildIndexUnique:
        return -1
    return contextIndex

@borrows
@borrow_result
fn typedExprIrCanonicalMetadataIndex(ir: TypedExprIr): TypedExprBuildIndex =
    if ir.typedExprMetadataSession != nil &&
       !ir.typedExprMetadataSession.closed &&
       !ir.typedExprMetadataSession.released &&
       ir.typedExprMetadataSession.index != nil:
        return ir.typedExprMetadataSession.index
    return ir.buildIndex

# The frozen fixed-point session deliberately splits immutable source metadata
# from the derived IR index so both do not own the same semantic text. Consumers
# validating declarations must query this authority instead of `ir.buildIndex`,
# whose post-seal domain contains IR-derived rows only.
@borrows
@borrow_result
fn TypedExprIrCanonicalMetadataIndex(ir: TypedExprIr): TypedExprBuildIndex =
    return typedExprIrCanonicalMetadataIndex(ir)

@borrows
fn TypedExprSourceContextLookup(sourceContexts: TypedExprSourceContext[],
                                  sourcePathRaw: str): int32 =
    var sourcePath: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, pathErr):
        return -1
    var contextIndex: int32
    let state = TypedExprBuildIndexLookup(TypedExprContextsBuildIndex(sourceContexts),
                                          "ctx_source", sourcePath, "", "", contextIndex)
    if state == TypedExprBuildIndexAmbiguous:
        return -2
    if state != TypedExprBuildIndexUnique:
        return -1
    return typedExprContextArrayIndexForBuildIndex(sourceContexts,
                                                    contextIndex)

@borrows
fn TypedExprSourceContextLookupFast(ir: var TypedExprIr,
                                      sourceContexts: TypedExprSourceContext[],
                                      sourcePathRaw: str): int32 =
    if ir.buildIndex != nil:
        return TypedExprSourceContextLookupWithIndex(ir, sourcePathRaw)
    return TypedExprSourceContextLookup(sourceContexts, sourcePathRaw)

# bail=711 族G 根修: 跨模块同名聚合类型撞名(如 3 个不同模块各自声明 `Connection`/
# `MultiAddress`)使 TypedExprTypeContextIndexAdd 把该叶子名的全局索引显式投毒为 -1
# (设计上正确: 全局无法安全猜是哪个)。但对READING文件自身而言并不模糊——它只
# import 了其中一个模块，import 图本身就是权威的消歧证据。global 索引 miss 后，
# 仅在 currentCtx 自己的 importedModules 范围内找"唯一一个声明了该类型"的目标
# context；若 currentCtx 自己的 import 集内仍出现 ≥2 个候选，保持既有保守失败
# (不新增任何猜测)。窄门:只在原逻辑已经判定 miss(-1)时才追加这一次尝试，不改变
# 任何已成功路径的结果。
@borrows
fn TypedExprFieldContextLookupViaImports(currentCtx: TypedExprSourceContext,
                                          sourceContexts: TypedExprSourceContext[],
                                          ownerType: str): int32 =
    var found: int32
    let state = TypedExprBuildIndexLookup(currentCtx.buildIndex,
                                          "ctx_import_field_owner",
                                          parser.ParserNormalizePath(parser.ParserOwnedText(currentCtx.sourcePath)),
                                          TypedExprTypeLeafName(share(ownerType)),
                                          "",
                                          found)
    if state != TypedExprBuildIndexUnique:
        return -1
    return typedExprContextArrayIndexForBuildIndex(sourceContexts, found)

@borrows
fn TypedExprDeclaredTypeContextLookupViaImports(currentCtx: TypedExprSourceContext,
                                                 sourceContexts: TypedExprSourceContext[],
                                                 leafType: str): int32 =
    var found: int32
    let state = TypedExprBuildIndexLookup(currentCtx.buildIndex,
                                          "ctx_import_declared",
                                          parser.ParserNormalizePath(parser.ParserOwnedText(currentCtx.sourcePath)),
                                          TypedExprTypeLeafName(share(leafType)),
                                          "",
                                          found)
    if state != TypedExprBuildIndexUnique:
        return -1
    return typedExprContextArrayIndexForBuildIndex(sourceContexts, found)

@borrows
fn TypedExprFieldContextLookup(currentCtx: TypedExprSourceContext,
                                sourceContexts: TypedExprSourceContext[],
                                ownerTypeRaw: str): int32 =
    let ownerType = TypedExprTypeLeafName(parser.ParserOwnedText(ownerTypeRaw))
    let typeText = TypedExprStripVarType(parser.ParserOwnedText(ownerTypeRaw))
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(share(typeText), 0, dotPos))
        let targetPath = TypedExprLookupQualifiedModuleSourcePath(currentCtx,
                                                                  sourceContexts,
                                                                  qualifier)
        let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetPath)
        if targetIndex >= 0 && TypedExprContextHasTypeField(sourceContexts[targetIndex], ownerType):
            return targetIndex
        return -1
    if TypedExprContextHasTypeField(currentCtx, ownerType):
        return -2
    return TypedExprFieldContextLookupViaImports(currentCtx, sourceContexts, ownerType)

@borrows
fn TypedExprDeclaredTypeContextLookup(currentCtx: TypedExprSourceContext,
                                       sourceContexts: TypedExprSourceContext[],
                                       typeRaw: str): int32 =
    let typeText = TypedExprStripVarType(parser.ParserOwnedText(typeRaw))
    let leaf = TypedExprTypeLeafName(share(typeText))
    if leaf == "":
        return -1
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(share(typeText), 0, dotPos))
        let targetPath = TypedExprLookupQualifiedModuleSourcePath(currentCtx,
                                                                  sourceContexts,
                                                                  qualifier)
        let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetPath)
        if targetIndex >= 0 && TypedExprSourceHasDeclaredType(sourceContexts[targetIndex], leaf):
            return targetIndex
        return -1
    if TypedExprSourceHasDeclaredType(currentCtx, leaf):
        return -2
    return TypedExprDeclaredTypeContextLookupViaImports(currentCtx, sourceContexts, leaf)

@borrows
fn TypedExprTypeLayoutObjectFields(ownerCtx: TypedExprSourceContext,
                                    sourceContexts: TypedExprSourceContext[],
                                    typeRaw: str,
                                    sizeBytes: var int32,
                                    alignBytes: var int32,
                                    activeSourcePaths: var str[],
                                    activeTypes: var str[]): bool =
    sizeBytes = 0
    alignBytes = 1
    let ownerType = TypedExprTypeLeafName(typeRaw)
    let sourcePath = parser.ParserNormalizePath(ownerCtx.sourcePath)
    var offset: int32
    var maxAlign: int32 = 1
    var nodeIndex = TypedExprBuildIndexContextFieldHead(ownerCtx.buildIndex,
                                                        sourcePath,
                                                        ownerType)
    while nodeIndex >= 0:
        var contextIndex: int32
        var rowIndex: int32
        if !TypedExprBuildIndexContextFieldNode(ownerCtx.buildIndex,
                                                nodeIndex,
                                                contextIndex,
                                                rowIndex):
            return false
        let localContextIndex = typedExprContextArrayIndexForBuildIndex(
            sourceContexts,
            contextIndex)
        if localContextIndex < 0:
            return false
        var field: TypedExprTypeFieldDecl
        if !typedExprContextFieldAt(sourceContexts[localContextIndex],
                                    rowIndex,
                                    field):
            return false
        if TypedExprTypeLeafName(field.ownerType) != ownerType:
            return false
        var fieldSize: int32
        var fieldAlign: int32
        if !typedExprTypeLayoutReadOnlyActive(sourceContexts[localContextIndex],
                                          sourceContexts,
                                          field.fieldType,
                                          fieldSize,
                                          fieldAlign,
                                          activeSourcePaths,
                                          activeTypes):
            return false
        if fieldAlign <= 0:
            fieldAlign = 1
        offset = TypedExprAlignBytes(offset, fieldAlign)
        offset = offset + fieldSize
        if fieldAlign > maxAlign:
            maxAlign = fieldAlign
        nodeIndex = TypedExprBuildIndexContextFieldNext(ownerCtx.buildIndex, nodeIndex)
    sizeBytes = TypedExprAlignBytes(offset, maxAlign)
    alignBytes = maxAlign
    return true

@borrows
fn TypedExprTypeLayoutCompute(currentCtx: TypedExprSourceContext,
                              sourceContexts: TypedExprSourceContext[],
                              typeRaw: str,
                              sizeBytes: var int32,
                              alignBytes: var int32,
                              activeSourcePaths: var str[],
                              activeTypes: var str[]): bool =
    sizeBytes = 0
    alignBytes = 0
    let typeText = TypedExprStripVarType(typeRaw)
    if typeText == "":
        return false
    if typeText == "bool" || typeText == "int8" || typeText == "uint8" || typeText == "u8":
        sizeBytes = 1
        alignBytes = 1
        return true
    if typeText == "int16" || typeText == "uint16" || typeText == "u16":
        sizeBytes = 2
        alignBytes = 2
        return true
    if typeText == "int32" || typeText == "int" ||
       typeText == "uint32" || typeText == "u32" ||
       typeText == "char":
        sizeBytes = 4
        alignBytes = 4
        return true
    if typeText == "CompilerEmit" || typeText == "creq.CompilerEmit" || typeText == "compiler_request.CompilerEmit":
        sizeBytes = 4
        alignBytes = 4
        return true
    if typeText == "int64" || typeText == "uint64" ||
       typeText == "u64" || typeText == "float32" ||
       typeText == "float64":
        sizeBytes = 8
        alignBytes = 8
        return true
    if typeText == "ptr" || typeText == "cstring" ||
       typeText == "owned_cstring" ||
       parser.ParserStartsWith(typeText, "ref"):
        sizeBytes = 8
        alignBytes = 8
        return true
    if typeText == "utf8_view" || typeText == "bytes_view":
        sizeBytes = 16
        alignBytes = 8
        return true
    if typeText == "str":
        sizeBytes = 24
        alignBytes = 8
        return true
    if typeText == "Bytes" || typeText == "bytes.Bytes" || typeText == "rawbytes.Bytes":
        sizeBytes = 16
        alignBytes = 8
        return true
    if typeText == "FixedBytes32" || typeText == "layout.FixedBytes32" || typeText == "bytes_layout.FixedBytes32":
        sizeBytes = 32
        alignBytes = 1
        return true
    if typeText == "FixedBytes64" || typeText == "layout.FixedBytes64" || typeText == "bytes_layout.FixedBytes64":
        sizeBytes = 64
        alignBytes = 1
        return true
    if typeText == "FixedBytes65" || typeText == "layout.FixedBytes65" || typeText == "bytes_layout.FixedBytes65":
        sizeBytes = 65
        alignBytes = 1
        return true
    if typeText == "ErrorInfo":
        sizeBytes = 32
        alignBytes = 8
        return true
    if typeText.len >= 2 && chengpath.TextSlice(typeText, typeText.len - 2, 2) == "[]":
        sizeBytes = 16
        alignBytes = 8
        return true
    if parser.ParserStartsWith(typeText, "seq[") ||
       parser.ParserStartsWith(typeText, "array["):
        sizeBytes = 16
        alignBytes = 8
        return true
    var fixedArrayElemType = ""
    var fixedArrayLen: int32
    if TypedExprIrFixedArrayTypeParts(currentCtx, typeText, fixedArrayElemType, fixedArrayLen):
        var elemSize: int32
        var elemAlign: int32
        if !typedExprTypeLayoutReadOnlyActive(currentCtx,
                                          sourceContexts,
                                          fixedArrayElemType,
                                          elemSize,
                                          elemAlign,
                                          activeSourcePaths,
                                          activeTypes):
            return false
        if elemAlign <= 0:
            return false
        let fixedArraySize = Int64(elemSize) * Int64(fixedArrayLen)
        if fixedArraySize <= 0 || fixedArraySize > Int64(2147483647):
            panic(Fmt"typed expr: fixed-array type layout size overflow source={currentCtx.sourcePath} type={typeText} elem_size={elemSize} length={fixedArrayLen}")
        sizeBytes = int32(fixedArraySize)
        alignBytes = elemAlign
        return true
    if parser.ParserStartsWith(typeText, "Result[") &&
       typeText.len > 8 &&
       chengpath.TextSlice(typeText, typeText.len - 1, 1) == "]":
        let inner = chengpath.TextSlice(typeText, 7, typeText.len - 8)
        var valueSize: int32
        var valueAlign: int32
        var errSize: int32
        var errAlign: int32
        if !typedExprTypeLayoutReadOnlyActive(currentCtx, sourceContexts, inner,
                                          valueSize, valueAlign,
                                          activeSourcePaths, activeTypes):
            return false
        if !typedExprTypeLayoutReadOnlyActive(currentCtx, sourceContexts,
                                          "ErrorInfo", errSize, errAlign,
                                          activeSourcePaths, activeTypes):
            return false
        let valueOffset = TypedExprAlignBytes(1, valueAlign)
        let errOffset = TypedExprAlignBytes(valueOffset + valueSize, errAlign)
        alignBytes = valueAlign
        if errAlign > alignBytes:
            alignBytes = errAlign
        if alignBytes <= 0:
            alignBytes = 1
        sizeBytes = TypedExprAlignBytes(errOffset + errSize, alignBytes)
        return true
    # Option[T] = { has: bool@0; value: T@align(1,alignT) } builtin generic. The
    # instantiation text `Option[Inner]` has no declared field table (the generic's
    # `value: T` carries an unsubstituted type param), so the ObjectFields path below
    # cannot size it → any struct embedding an Option field can't lay out its later
    # fields → backend2 bail=711. Mirror the Result[ handler above (identical
    # flag-first-then-value shape, no err field).
    if parser.ParserStartsWith(typeText, "Option[") &&
       typeText.len > 8 &&
       chengpath.TextSlice(typeText, typeText.len - 1, 1) == "]":
        let optInner = chengpath.TextSlice(typeText, 7, typeText.len - 8)
        var optValueSize: int32
        var optValueAlign: int32
        if !typedExprTypeLayoutReadOnlyActive(currentCtx, sourceContexts, optInner,
                                          optValueSize, optValueAlign,
                                          activeSourcePaths, activeTypes):
            return false
        let optValueOffset = TypedExprAlignBytes(1, optValueAlign)
        alignBytes = optValueAlign
        if alignBytes <= 0:
            alignBytes = 1
        sizeBytes = TypedExprAlignBytes(optValueOffset + optValueSize, alignBytes)
        return true
    let declaredIndex = TypedExprDeclaredTypeContextLookup(currentCtx, sourceContexts, typeText)
    if declaredIndex == -2:
        if TypedExprSourceHasRefType(currentCtx, typeText):
            sizeBytes = 8
            alignBytes = 8
            return true
        if !TypedExprContextHasTypeField(currentCtx, typeText):
            sizeBytes = 4
            alignBytes = 4
            return true
    elif declaredIndex >= 0:
        if TypedExprSourceHasRefType(sourceContexts[declaredIndex], typeText):
            sizeBytes = 8
            alignBytes = 8
            return true
        if !TypedExprContextHasTypeField(sourceContexts[declaredIndex], typeText):
            sizeBytes = 4
            alignBytes = 4
            return true
    let ctxIndex = TypedExprFieldContextLookup(currentCtx, sourceContexts, typeText)
    if ctxIndex >= 0:
        # bail=44 C1 根修: declared-lookup miss(别名表缺失)后经全局字段索引落到
        # 这里的 ref-object 类型 (`Name = ref`) 仍是 8 字节指针存储位, 不得摊开
        # pointee 字段布局 (ObjectFields 摊开会给 ref 字段/变量报 pointee 尺寸,
        # 与上方 declaredIndex 分支的既有 ref 判定语义不一致)。
        if TypedExprSourceHasRefType(sourceContexts[ctxIndex], typeText):
            sizeBytes = 8
            alignBytes = 8
            return true
        return TypedExprTypeLayoutObjectFields(sourceContexts[ctxIndex],
                                               sourceContexts,
                                               typeText,
                                               sizeBytes,
                                               alignBytes,
                                               activeSourcePaths,
                                               activeTypes)
    if ctxIndex == -2:
        if TypedExprSourceHasRefType(currentCtx, typeText):
            sizeBytes = 8
            alignBytes = 8
            return true
        return TypedExprTypeLayoutObjectFields(currentCtx,
                                               sourceContexts,
                                               typeText,
                                               sizeBytes,
                                               alignBytes,
                                               activeSourcePaths,
                                               activeTypes)
    if declaredIndex >= 0:
        return TypedExprTypeLayoutObjectFields(sourceContexts[declaredIndex],
                                               sourceContexts,
                                               typeText,
                                               sizeBytes,
                                               alignBytes,
                                               activeSourcePaths,
                                               activeTypes)
    if TypedExprSourceHasDeclaredType(currentCtx, TypedExprTypeLeafName(typeText)):
        sizeBytes = 4
        alignBytes = 4
        return true
    return false

@borrows
fn typedExprTypeLayoutReadOnlyActive(
        currentCtx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        typeRaw: str,
        sizeBytes: var int32,
        alignBytes: var int32,
        activeSourcePaths: var str[],
        activeTypes: var str[]): bool =
    sizeBytes = 0
    alignBytes = 0
    if currentCtx.buildIndex == nil || currentCtx.buildIndex.released:
        panic("typed expr: read-only type layout query requires explicit live build index")
    if activeSourcePaths.len != activeTypes.len:
        panic("typed expr: read-only type layout active-path columns mismatch")
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(currentCtx.sourcePath))
    let typeText = TypedExprStripVarType(parser.ParserOwnedText(typeRaw))
    if sourcePath == "" || typeText == "":
        return false
    for activeIndex in 0..<activeTypes.len:
        if activeTypes[activeIndex] == typeText &&
           TypedExprSourcePathsEquivalent(activeSourcePaths[activeIndex],
                                           sourcePath):
            panic(Fmt"typed expr: read-only type layout cycle source={sourcePath} type={typeText}")
    let activeCount = activeTypes.len
    add(activeSourcePaths, share(sourcePath))
    add(activeTypes, share(typeText))
    let ok = TypedExprTypeLayoutCompute(currentCtx,
                                        sourceContexts,
                                        typeText,
                                        sizeBytes,
                                        alignBytes,
                                        activeSourcePaths,
                                        activeTypes)
    setLen(activeSourcePaths, activeCount)
    setLen(activeTypes, activeCount)
    return ok

fn typedExprTypeLayoutImplActive(currentCtx: TypedExprSourceContext,
                                  sourceContexts: var TypedExprSourceContext[],
                                  typeRaw: str,
                                  sizeBytes: var int32,
                                  alignBytes: var int32,
                                  activeSourcePaths: var str[],
                                  activeTypes: var str[]): bool =
    sizeBytes = 0
    alignBytes = 0
    if currentCtx.buildIndex == nil || currentCtx.buildIndex.released:
        panic("typed expr: type layout query requires explicit live build index")
    if activeSourcePaths.len != activeTypes.len:
        panic("typed expr: type layout active-path columns mismatch")
    let sourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
    let typeText = TypedExprStripVarType(typeRaw)
    if sourcePath == "" || typeText == "":
        return false
    for activeIndex in 0..<activeTypes.len:
        if activeTypes[activeIndex] == typeText &&
           TypedExprSourcePathsEquivalent(activeSourcePaths[activeIndex],
                                           sourcePath):
            panic(Fmt"typed expr: inline type layout cycle source={sourcePath} type={typeText}")
    let activeCount = activeTypes.len
    add(activeSourcePaths, share(sourcePath))
    add(activeTypes, share(typeText))
    var ok: bool
    if currentCtx.buildIndex.frozenReadOnlyQueries:
        ok = TypedExprTypeLayoutCompute(currentCtx,
                                        sourceContexts,
                                        typeText,
                                        sizeBytes,
                                        alignBytes,
                                        activeSourcePaths,
                                        activeTypes)
    else:
        var slot: int32
        let state = TypedExprBuildIndexLayoutLookup(currentCtx.buildIndex,
                                                    sourcePath,
                                                    typeText,
                                                    slot,
                                                    sizeBytes,
                                                    alignBytes)
        if state == 2:
            ok = true
        elif state != 1 && state != 3:
            slot = TypedExprBuildIndexLayoutBegin(currentCtx.buildIndex,
                                                   sourcePath,
                                                   share(typeText))
            ok = TypedExprTypeLayoutCompute(currentCtx,
                                             sourceContexts,
                                             typeText,
                                             sizeBytes,
                                             alignBytes,
                                             activeSourcePaths,
                                             activeTypes)
            TypedExprBuildIndexLayoutFinish(currentCtx.buildIndex,
                                            slot,
                                            ok,
                                            sizeBytes,
                                            alignBytes)
    setLen(activeSourcePaths, activeCount)
    setLen(activeTypes, activeCount)
    return ok

fn TypedExprTypeLayoutImpl(currentCtx: TypedExprSourceContext,
                            sourceContexts: var TypedExprSourceContext[],
                            typeRaw: str,
                            sizeBytes: var int32,
                            alignBytes: var int32): bool =
    var activeSourcePaths: str[]
    var activeTypes: str[]
    return typedExprTypeLayoutImplActive(currentCtx,
                                         sourceContexts,
                                         typeRaw,
                                         sizeBytes,
                                         alignBytes,
                                         activeSourcePaths,
                                         activeTypes)

@borrows
fn TypedExprTypeLayout(currentCtx: TypedExprSourceContext,
                        sourceContexts: TypedExprSourceContext[],
                        typeRaw: str,
                        sizeBytes: var int32,
                        alignBytes: var int32): bool =
    var activeSourcePaths: str[]
    var activeTypes: str[]
    return typedExprTypeLayoutReadOnlyActive(currentCtx,
                                             sourceContexts,
                                             typeRaw,
                                             sizeBytes,
                                             alignBytes,
                                             activeSourcePaths,
                                             activeTypes)

@borrows
fn TypedExprContextFieldCountForType(ctx: TypedExprSourceContext,
                                      typeRaw: str): int32 =
    if TypedExprSourceHasRefType(ctx, typeRaw):
        return 0
    let ownerType = TypedExprTypeLeafName(typeRaw)
    var count: int32
    let state = TypedExprBuildIndexLookup(ctx.buildIndex,
                                          "ctx_field_count_source",
                                          parser.ParserNormalizePath(ctx.sourcePath),
                                          ownerType,
                                          "",
                                          count)
    if state != TypedExprBuildIndexUnique:
        return 0
    return count

@borrows
fn TypedExprBuildIndexRegisterIrTypeLayout(ir: var TypedExprIr,
                                            sourcePath: str,
                                            typeName: str,
                                            rowIndex: int32,
                                            fingerprint: str) =
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_layout_source", sourcePath, typeName, "", rowIndex, sourcePath, fingerprint, true)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_layout_global", "", typeName, "", rowIndex, sourcePath, fingerprint, false)

@borrows
fn TypedExprBuildIndexRegisterIrTypeField(ir: var TypedExprIr,
                                           sourcePath: str,
                                           ownerType: str,
                                           fieldName: str,
                                           rowIndex: int32,
                                           fingerprint: str) =
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_field_source", sourcePath, ownerType, fieldName, rowIndex, sourcePath, fingerprint, true)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_field_global", "", ownerType, fieldName, rowIndex, sourcePath, fingerprint, false)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_field_owner_global", "", ownerType, "", rowIndex, sourcePath, ownerType, false)
    TypedExprBuildIndexAddFieldOwnerRow(ir.buildIndex, sourcePath, ownerType, rowIndex)

@borrows
fn TypedExprBuildIndexRegisterIrTypeDefAlias(ir: var TypedExprIr,
                                              sourcePath: str,
                                              aliasName: str,
                                              rowIndex: int32,
                                              targetType: str) =
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_alias_def_source", sourcePath, aliasName, "", rowIndex, sourcePath, targetType, true)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_alias_def_global", "", aliasName, "", rowIndex, sourcePath, targetType, false)

@borrows
fn TypedExprBuildIndexRegisterIrImportAlias(ir: var TypedExprIr,
                                             sourcePath: str,
                                             qualifier: str,
                                             rowIndex: int32,
                                             targetSourcePath: str) =
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_import_alias", sourcePath, qualifier, "", rowIndex, sourcePath, targetSourcePath, true)

fn TypedExprBuildIndexRegisterIrGlobal(ir: var TypedExprIr,
                                        sourcePath: str,
                                        name: str,
                                        rowIndex: int32,
                                        typeText: str): TypedExprBuildIndexLookupState =
    return TypedExprBuildIndexRegister(ir.buildIndex,
                                        "ir_global_source",
                                        sourcePath,
                                        name,
                                        "",
                                        rowIndex,
                                        sourcePath,
                                        typeText,
                                        false)


@borrows
fn TypedExprBuildIndexRegisterIrEnum(ir: var TypedExprIr,
                                     sourcePath: str,
                                     name: str,
                                     typeName: str,
                                     rowIndex: int32,
                                     ordinal: int32) =
    let fingerprint = Fmt"{typeName}:{ordinal}"
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_enum_name_source", sourcePath, name, "", rowIndex, sourcePath, fingerprint, true)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_enum_name_global", "", name, "", rowIndex, sourcePath, fingerprint, false)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_enum_type_source", sourcePath, typeName, "", rowIndex, sourcePath, typeName, false)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_enum_type_global", "", typeName, "", rowIndex, sourcePath, typeName, false)

@borrows
fn TypedExprBuildIndexRegisterIrRef(ir: var TypedExprIr,
                                    sourcePath: str,
                                    typeName: str,
                                    rowIndex: int32) =
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_ref_source", sourcePath, typeName, "", rowIndex, sourcePath, typeName, true)
    TypedExprBuildIndexRegister(ir.buildIndex, "ir_ref_global", "", typeName, "", rowIndex, sourcePath, typeName, false)

fn TypedExprBuildIndexSeedIrMetadata(ir: var TypedExprIr) =
    if ir.buildIndex == nil:
        panic("typed expr: IR metadata seed requires build index")
    for i in 0..<ir.typeLayoutNames.len:
        if i >= ir.typeLayoutSourcePaths.len || i >= ir.typeLayoutSizeBytes.len ||
           i >= ir.typeLayoutAlignBytes.len || i >= ir.typeLayoutFieldCounts.len ||
           i >= ir.typeLayoutProducerSourceIndexes.len ||
           i >= ir.typeLayoutDeclarationSourceLocalRows.len ||
           i >= ir.typeLayoutBuiltinKinds.len:
            panic("typed expr: type layout columns mismatch")
        let sourcePath = parser.ParserNormalizePath(ir.typeLayoutSourcePaths[i])
        let typeName = TypedExprNormalizeTypeText(ir.typeLayoutNames[i])
        let fingerprint = Fmt"{ir.typeLayoutSizeBytes[i]}:{ir.typeLayoutAlignBytes[i]}:{ir.typeLayoutFieldCounts[i]}"
        TypedExprBuildIndexRegisterIrTypeLayout(ir, sourcePath, typeName, i, fingerprint)
    for i in 0..<ir.typeFieldOwnerTypes.len:
        if i >= ir.typeFieldSourcePaths.len || i >= ir.typeFieldNames.len ||
           i >= ir.typeFieldTypes.len || i >= ir.typeFieldOffsetBytes.len ||
           i >= ir.typeFieldSizeBytes.len || i >= ir.typeFieldAlignBytes.len ||
           i >= ir.typeFieldProducerSourceIndexes.len ||
           i >= ir.typeFieldOwnerDeclarationSourceLocalRows.len ||
           i >= ir.typeFieldDeclarationSourceLocalRows.len ||
           i >= ir.typeFieldOrdinals.len ||
           i >= ir.typeFieldBuiltinKinds.len:
            panic("typed expr: type field columns mismatch")
        let sourcePath = parser.ParserNormalizePath(ir.typeFieldSourcePaths[i])
        let ownerType = TypedExprNormalizeTypeText(ir.typeFieldOwnerTypes[i])
        let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(ir.typeFieldNames[i]))
        let fingerprint = Fmt"{ir.typeFieldTypes[i]}:{ir.typeFieldOffsetBytes[i]}:{ir.typeFieldSizeBytes[i]}:{ir.typeFieldAlignBytes[i]}"
        TypedExprBuildIndexRegisterIrTypeField(ir, sourcePath, ownerType, fieldName, i, fingerprint)
    for i in 0..<ir.typeDefAliasNames.len:
        if i >= ir.typeDefAliasSourcePaths.len || i >= ir.typeDefAliasTargetTypes.len:
            panic("typed expr: type alias columns mismatch")
        TypedExprBuildIndexRegisterIrTypeDefAlias(ir,
                                                   parser.ParserNormalizePath(ir.typeDefAliasSourcePaths[i]),
                                                   ir.typeDefAliasNames[i], i,
                                                   TypedExprNormalizeTypeText(ir.typeDefAliasTargetTypes[i]))
    for i in 0..<ir.typeAliasQualifiers.len:
        if i >= ir.typeAliasSourcePaths.len || i >= ir.typeAliasTargetSourcePaths.len:
            panic("typed expr: import alias columns mismatch")
        TypedExprBuildIndexRegisterIrImportAlias(ir,
                                                  parser.ParserNormalizePath(ir.typeAliasSourcePaths[i]),
                                                  ir.typeAliasQualifiers[i], i,
                                                  parser.ParserNormalizePath(ir.typeAliasTargetSourcePaths[i]))
    for i in 0..<ir.enumValueNames.len:
        if i >= ir.enumValueSourcePaths.len || i >= ir.enumValueTypes.len || i >= ir.enumValueOrdinals.len:
            panic("typed expr: enum columns mismatch")
        TypedExprBuildIndexRegisterIrEnum(ir,
                                           parser.ParserNormalizePath(ir.enumValueSourcePaths[i]),
                                           ir.enumValueNames[i], ir.enumValueTypes[i], i,
                                           ir.enumValueOrdinals[i])
    for i in 0..<ir.refObjectTypeNames.len:
        if i >= ir.refObjectSourcePaths.len:
            panic("typed expr: ref type columns mismatch")
        TypedExprBuildIndexRegisterIrRef(ir,
                                          parser.ParserNormalizePath(ir.refObjectSourcePaths[i]),
                                          ir.refObjectTypeNames[i], i)

fn typedExprIrPrepareExactLayoutIndexes(
        ir: var TypedExprIr,
        contexts: var TypedExprSourceContext[],
        producerSourceCount: int32,
        declarationCounts: var int32[]) =
    if ir.exactLayoutIndexSourceStarts.len > 0:
        if producerSourceCount <= 0 ||
           contexts.len != producerSourceCount ||
           declarationCounts.len != producerSourceCount ||
           ir.exactLayoutIndexSourceStarts.len !=
               producerSourceCount + 1 ||
           ir.exactLayoutDeclarationAuthorityStates.len !=
               ir.exactLayoutTypeDeclarationRows.len ||
           ir.exactLayoutDeclarationTypeArenaIds.len !=
               ir.exactLayoutTypeDeclarationRows.len ||
           ir.exactLayoutDeclarationSizeBytes.len !=
               ir.exactLayoutTypeDeclarationRows.len ||
           ir.exactLayoutDeclarationAlignBytes.len !=
               ir.exactLayoutTypeDeclarationRows.len ||
           ir.exactLayoutDeclarationGenericSymbolCounts.len !=
               ir.exactLayoutTypeDeclarationRows.len:
            panic("typed expr: exact layout retained authority drift")
        for sourceId in 0..<producerSourceCount:
            if ir.exactLayoutIndexSourceStarts[sourceId + 1] -
                   ir.exactLayoutIndexSourceStarts[sourceId] !=
                   declarationCounts[sourceId]:
                panic("typed expr: exact layout declaration authority drift")
        return
    if ir.exactLayoutTypeDeclarationRows.len != 0 ||
       ir.exactLayoutTypeBuiltinRows.len != 0 ||
       ir.exactLayoutFieldDeclarationRows.len != 0 ||
       ir.exactLayoutFieldBuiltinRows.len != 0 ||
       ir.exactLayoutOwnerDeclarationFieldCounts.len != 0 ||
       ir.exactLayoutOwnerBuiltinFieldCounts.len != 0 ||
       ir.exactLayoutDeclarationAuthorityStates.len != 0 ||
       ir.exactLayoutDeclarationTypeArenaIds.len != 0 ||
       ir.exactLayoutDeclarationSizeBytes.len != 0 ||
       ir.exactLayoutDeclarationAlignBytes.len != 0 ||
       ir.exactLayoutDeclarationGenericSymbolCounts.len != 0 ||
       ir.typeLayoutProducerSourceIndexes.len != 0 ||
       ir.typeFieldProducerSourceIndexes.len != 0:
        panic("typed expr: exact layout index initialization state invalid")
    if producerSourceCount <= 0 ||
       producerSourceCount >= 134217727 ||
       contexts.len != producerSourceCount ||
       declarationCounts.len != producerSourceCount:
        panic("typed expr: exact layout producer authority invalid")
    for sourceId in 0..<producerSourceCount:
        if declarationCounts[sourceId] < 0:
            panic("typed expr: exact layout declaration authority invalid")
        if contexts[sourceId].declaredTypes.len !=
               contexts[sourceId].declaredTypeProducerSourceIndexes.len ||
           contexts[sourceId].declaredTypes.len !=
               contexts[sourceId].declaredTypeDeclarationSourceLocalRows.len ||
           contexts[sourceId].declaredTypes.len !=
               contexts[sourceId].declaredTypeBuiltinKinds.len:
            panic("typed expr: exact layout declared coordinate columns split")
        for row in 0..<contexts[sourceId].declaredTypes.len:
            let coordinateSourceId =
                contexts[sourceId].
                    declaredTypeProducerSourceIndexes[row]
            let builtinRaw =
                contexts[sourceId].declaredTypeBuiltinKinds[row]
            let declarationRow =
                contexts[sourceId].
                    declaredTypeDeclarationSourceLocalRows[row]
            if coordinateSourceId != sourceId ||
               builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
               builtinRaw > Int32(TypedExprLayoutBuiltinOptional) ||
               ((builtinRaw ==
                    Int32(TypedExprLayoutBuiltinNone)) !=
                (declarationRow >= 0 &&
                 declarationRow < declarationCounts[sourceId])):
                panic("typed expr: exact layout context source coverage invalid")
        for row in 0..<contexts[sourceId].typeFields.len:
            let field = contexts[sourceId].typeFields[row]
            let declared =
                field.builtinKind == TypedExprLayoutBuiltinNone
            if field.producerSourceIndex != sourceId ||
               field.ordinal < 0 ||
               Int32(field.builtinKind) <
                   Int32(TypedExprLayoutBuiltinNone) ||
               Int32(field.builtinKind) >
                   Int32(TypedExprLayoutBuiltinOptional) ||
               (declared !=
                (field.ownerDeclarationSourceLocalRow >= 0 &&
                 field.ownerDeclarationSourceLocalRow <
                     declarationCounts[sourceId] &&
                 field.fieldDeclarationSourceLocalRow >= 0 &&
                 field.fieldDeclarationSourceLocalRow <
                     declarationCounts[sourceId])):
                panic("typed expr: exact field context source coverage invalid")
    setLen(
        ir.exactLayoutIndexSourceStarts,
        producerSourceCount + 1)
    for sourceId in 0..<producerSourceCount:
        if ir.exactLayoutIndexSourceStarts[sourceId] >
               2147483647 - declarationCounts[sourceId]:
            panic("typed expr: exact layout direct index overflow")
        ir.exactLayoutIndexSourceStarts[sourceId + 1] =
            ir.exactLayoutIndexSourceStarts[sourceId] +
            declarationCounts[sourceId]
    let declarationDomain =
        ir.exactLayoutIndexSourceStarts[producerSourceCount]
    setLen(ir.exactLayoutTypeDeclarationRows, declarationDomain)
    setLen(
        ir.exactLayoutDeclarationAuthorityStates,
        declarationDomain)
    setLen(
        ir.exactLayoutDeclarationTypeArenaIds,
        declarationDomain)
    setLen(
        ir.exactLayoutDeclarationSizeBytes,
        declarationDomain)
    setLen(
        ir.exactLayoutDeclarationAlignBytes,
        declarationDomain)
    setLen(
        ir.exactLayoutDeclarationGenericSymbolCounts,
        declarationDomain)
    setLen(ir.exactLayoutFieldDeclarationRows, declarationDomain)
    setLen(
        ir.exactLayoutOwnerDeclarationFieldCounts,
        declarationDomain)
    setLen(
        ir.exactLayoutTypeBuiltinRows,
        producerSourceCount * 4)
    setLen(
        ir.exactLayoutFieldBuiltinRows,
        producerSourceCount * 16)
    setLen(
        ir.exactLayoutOwnerBuiltinFieldCounts,
        producerSourceCount * 4)
    for index in 0..<ir.exactLayoutTypeDeclarationRows.len:
        ir.exactLayoutTypeDeclarationRows[index] = -1
        ir.exactLayoutFieldDeclarationRows[index] = -1
        ir.exactLayoutDeclarationTypeArenaIds[index] = -1
        ir.exactLayoutDeclarationGenericSymbolCounts[index] = -1
    for index in 0..<ir.exactLayoutTypeBuiltinRows.len:
        ir.exactLayoutTypeBuiltinRows[index] = -1
    for index in 0..<ir.exactLayoutFieldBuiltinRows.len:
        ir.exactLayoutFieldBuiltinRows[index] = -1

fn typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
        ir: var TypedExprIr,
        contexts: var TypedExprSourceContext[]) =
    let producerSourceCount = contexts.len
    if producerSourceCount <= 0 ||
       producerSourceCount >= 134217727:
        panic("typed expr: exact layout parser authority missing")
    var sharedColumnId: int32
    var sharedColumnName: str
    var sharedRefCount: int32
    for sourceId in 0..<producerSourceCount:
        if typedExprSourceContextFirstSharedMetadataBufferInto(
               contexts[sourceId],
               sharedColumnId,
               sharedColumnName,
               sharedRefCount):
            panic(Fmt"typed expr: exact layout parser authority context storage shared stage=before source={sourceId} column_id={sharedColumnId} column={sharedColumnName} ref_count={sharedRefCount}")
    if ir.exactLayoutIndexSourceStarts.len > 0:
        let retainedProducerSourceCount =
            ir.exactLayoutIndexSourceStarts.len - 1
        if retainedProducerSourceCount == producerSourceCount:
            return
        # A frozen reachability round materializes only its exact frontier.
        # Its int32 producer coordinate remains in the package-wide projection;
        # validate that immutable identity instead of mistaking the subset
        # cardinality for a new parser authority domain.
        let session = ir.typedExprMetadataSession
        if session == nil:
            panic(Fmt"typed expr: exact layout retained parser authority drift state=session_missing retained={retainedProducerSourceCount} supplied={producerSourceCount}")
        if session.closed || session.released:
            panic(Fmt"typed expr: exact layout retained parser authority drift state=session_inactive closed={session.closed} released={session.released}")
        if session.index == nil || session.index.released ||
           ir.buildIndex == nil || ir.buildIndex.released ||
           session.index == ir.buildIndex ||
           session.index.buildGeneration !=
               ir.buildIndex.buildGeneration:
            panic("typed expr: exact layout retained parser authority drift state=index_identity")
        if session.projection == nil || session.projection.released:
            panic("typed expr: exact layout retained parser authority drift state=projection_inactive")
        if session.projection.rawSourcePathIds.len !=
               retainedProducerSourceCount ||
           session.projection.normalizedSourcePathIds.len !=
               retainedProducerSourceCount:
            panic(Fmt"typed expr: exact layout retained parser authority drift state=producer_domain retained={retainedProducerSourceCount} raw={session.projection.rawSourcePathIds.len} normalized={session.projection.normalizedSourcePathIds.len}")
        for sourceId in 0..<producerSourceCount:
            let frozenContextIndex =
                contexts[sourceId].frozenMetadataContextIndex
            if contexts[sourceId].frozenMetadataProjection !=
                   session.projection ||
               contexts[sourceId].buildIndex != session.index ||
               contexts[sourceId].buildIndexOwned ||
               frozenContextIndex < 0 ||
               frozenContextIndex >= retainedProducerSourceCount:
                panic("typed expr: exact layout frozen producer identity drift")
            var normalizedSourcePath =
                contexts[sourceId].normalizedSourcePath
            if normalizedSourcePath == "":
                normalizedSourcePath = parser.ParserNormalizePath(
                    contexts[sourceId].sourcePath)
            if normalizedSourcePath !=
                   typedExprFrozenProjectionText(
                       session.projection,
                       session.projection.normalizedSourcePathIds[
                           frozenContextIndex]):
                panic("typed expr: exact layout frozen producer path drift")
        return
    var declarationCounts: int32[]
    setLen(declarationCounts, producerSourceCount)
    for sourceId in 0..<producerSourceCount:
        if !contexts[sourceId].exactLayoutParserIdentityBound ||
           contexts[sourceId].exactLayoutProducerSourceCount !=
               producerSourceCount ||
           contexts[sourceId].exactLayoutDeclarationSourceCount < 0:
            panic("typed expr: exact layout source parser authority missing")
        declarationCounts[sourceId] =
            contexts[sourceId].exactLayoutDeclarationSourceCount
    typedExprIrPrepareExactLayoutIndexes(
        ir,
        contexts,
        producerSourceCount,
        declarationCounts)
    for sourceId in 0..<producerSourceCount:
        if typedExprSourceContextFirstSharedMetadataBufferInto(
               contexts[sourceId],
               sharedColumnId,
               sharedColumnName,
               sharedRefCount):
            panic(Fmt"typed expr: exact layout parser authority context storage shared stage=after source={sourceId} column_id={sharedColumnId} column={sharedColumnName} ref_count={sharedRefCount}")

fn TypedExprIrPrepareExactLayoutParserAuthority(
        ir: var TypedExprIr,
        contexts: var TypedExprSourceContext[]) =
    typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
        ir, contexts)

fn TypedExprIrBindExactDeclarationLayoutAuthority(
        ir: var TypedExprIr,
        producerSourceIndex: int32,
        declarationSourceLocalRow: int32,
        typeArenaId: int32,
        genericSymbolCount: int32,
        layoutPresent: bool,
        sizeBytes: int32,
        alignBytes: int32) =
    let exactIndex = typedExprIrExactDeclarationIndex(
        ir,
        producerSourceIndex,
        declarationSourceLocalRow)
    if exactIndex < 0 ||
       typeArenaId < 0 ||
       genericSymbolCount < 0 ||
       ir.exactLayoutDeclarationAuthorityStates[exactIndex] != 0 ||
       ir.exactLayoutDeclarationTypeArenaIds[exactIndex] != -1 ||
       ir.exactLayoutDeclarationGenericSymbolCounts[exactIndex] != -1 ||
       (layoutPresent &&
        (genericSymbolCount != 0 ||
         sizeBytes <= 0 ||
         alignBytes <= 0)) ||
       (!layoutPresent &&
        (sizeBytes != 0 ||
         alignBytes != 1)):
        panic("typed expr: exact declaration layout authority invalid")
    ir.exactLayoutDeclarationAuthorityStates[exactIndex] =
        layoutPresent ? 2 : 1
    ir.exactLayoutDeclarationTypeArenaIds[exactIndex] =
        typeArenaId
    ir.exactLayoutDeclarationSizeBytes[exactIndex] =
        sizeBytes
    ir.exactLayoutDeclarationAlignBytes[exactIndex] =
        alignBytes
    ir.exactLayoutDeclarationGenericSymbolCounts[exactIndex] =
        genericSymbolCount

@borrows
fn typedExprIrExactDeclarationIndex(
        ir: TypedExprIr,
        producerSourceIndex: int32,
        declarationSourceLocalRow: int32): int32 =
    if producerSourceIndex < 0 ||
       producerSourceIndex + 1 >=
           ir.exactLayoutIndexSourceStarts.len ||
       declarationSourceLocalRow < 0:
        return -1
    let start =
        ir.exactLayoutIndexSourceStarts[producerSourceIndex]
    let stop =
        ir.exactLayoutIndexSourceStarts[producerSourceIndex + 1]
    if declarationSourceLocalRow >= stop - start:
        return -1
    return start + declarationSourceLocalRow

@borrows
fn typedExprIrExactTypeLayoutRow(
        ir: TypedExprIr,
        producerSourceIndex: int32,
        declarationSourceLocalRow: int32,
        builtinKind: TypedExprLayoutBuiltinKind): int32 =
    if builtinKind == TypedExprLayoutBuiltinNone:
        let index = typedExprIrExactDeclarationIndex(
            ir,
            producerSourceIndex,
            declarationSourceLocalRow)
        if index < 0:
            return -1
        return ir.exactLayoutTypeDeclarationRows[index]
    if producerSourceIndex < 0 ||
       producerSourceIndex * 4 + Int32(builtinKind) >=
           ir.exactLayoutTypeBuiltinRows.len:
        return -1
    return ir.exactLayoutTypeBuiltinRows[
        producerSourceIndex * 4 + Int32(builtinKind)]

@borrows
fn typedExprIrExactTypeFieldRow(
        ir: TypedExprIr,
        producerSourceIndex: int32,
        ownerDeclarationSourceLocalRow: int32,
        fieldDeclarationSourceLocalRow: int32,
        ordinal: int32,
        builtinKind: TypedExprLayoutBuiltinKind): int32 =
    if builtinKind == TypedExprLayoutBuiltinNone:
        let index = typedExprIrExactDeclarationIndex(
            ir,
            producerSourceIndex,
            fieldDeclarationSourceLocalRow)
        if index < 0:
            return -1
        return ir.exactLayoutFieldDeclarationRows[index]
    if producerSourceIndex < 0 || ordinal < 0 || ordinal >= 4:
        return -1
    let index =
        producerSourceIndex * 16 +
        Int32(builtinKind) * 4 +
        ordinal
    if index < 0 || index >= ir.exactLayoutFieldBuiltinRows.len:
        return -1
    return ir.exactLayoutFieldBuiltinRows[index]

fn typedExprIrExactTypeOwnerHasField(
        ir: var TypedExprIr,
        producerSourceIndex: int32,
        ownerDeclarationSourceLocalRow: int32,
        builtinKind: TypedExprLayoutBuiltinKind): bool =
    if builtinKind == TypedExprLayoutBuiltinNone:
        let index = typedExprIrExactDeclarationIndex(
            ir,
            producerSourceIndex,
            ownerDeclarationSourceLocalRow)
        return index >= 0 &&
               ir.exactLayoutOwnerDeclarationFieldCounts[index] > 0
    let index =
        producerSourceIndex * 4 + Int32(builtinKind)
    return producerSourceIndex >= 0 && index >= 0 &&
           index < ir.exactLayoutOwnerBuiltinFieldCounts.len &&
           ir.exactLayoutOwnerBuiltinFieldCounts[index] > 0

fn TypedExprIrAppendTypeLayout(ir: var TypedExprIr,
                                sourcePathRaw: str,
                                typeNameRaw: str,
                                sizeBytes: int32,
                                alignBytes: int32,
                                fieldCount: int32,
                                producerSourceIndex: int32,
                                declarationSourceLocalRow: int32,
                                builtinKind: TypedExprLayoutBuiltinKind) =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let typeName = TypedExprNormalizeTypeText(typeNameRaw)
    if producerSourceIndex < 0 || fieldCount < 0 ||
       ((builtinKind == TypedExprLayoutBuiltinNone) !=
        (declarationSourceLocalRow >= 0)):
        panic("typed expr: type layout exact coordinate invalid")
    if sourcePath == "" || typeName == "" || sizeBytes <= 0 ||
       alignBytes <= 0:
        panic("typed expr: type layout receipt payload invalid")
    if ir.buildIndex == nil:
        panic("typed expr: type layout append requires build index")
    let fingerprint = Fmt"{sizeBytes}:{alignBytes}:{fieldCount}"
    let exactRow = typedExprIrExactTypeLayoutRow(
        ir,
        producerSourceIndex,
        declarationSourceLocalRow,
        builtinKind)
    var textRow: int32
    let textState = TypedExprBuildIndexLookup(
        ir.buildIndex,
        "ir_layout_source",
        sourcePath,
        typeName,
        "",
        textRow)
    if exactRow >= 0:
        if exactRow >= ir.typeLayoutSourcePaths.len ||
           ir.typeLayoutSourcePaths[exactRow] != sourcePath ||
           ir.typeLayoutNames[exactRow] != typeName ||
           ir.typeLayoutProducerSourceIndexes[exactRow] !=
               producerSourceIndex ||
           ir.typeLayoutDeclarationSourceLocalRows[exactRow] !=
               declarationSourceLocalRow ||
           ir.typeLayoutBuiltinKinds[exactRow] !=
               Int32(builtinKind) ||
           ir.typeLayoutSizeBytes[exactRow] != sizeBytes ||
           ir.typeLayoutAlignBytes[exactRow] != alignBytes ||
           ir.typeLayoutFieldCounts[exactRow] != fieldCount ||
           textState != TypedExprBuildIndexUnique ||
           textRow != exactRow:
            panic("typed expr: type layout receipt cross-check drift")
        return
    if textState != TypedExprBuildIndexMissing:
        panic("typed expr: type layout text collides with exact identity")
    var exactIndex: int32
    if builtinKind == TypedExprLayoutBuiltinNone:
        exactIndex = typedExprIrExactDeclarationIndex(
            ir,
            producerSourceIndex,
            declarationSourceLocalRow)
        if exactIndex < 0 ||
           ir.exactLayoutTypeDeclarationRows[exactIndex] != -1:
            panic("typed expr: type layout direct index invalid")
    else:
        exactIndex =
            producerSourceIndex * 4 + Int32(builtinKind)
        if exactIndex < 0 ||
           exactIndex >= ir.exactLayoutTypeBuiltinRows.len ||
           ir.exactLayoutTypeBuiltinRows[exactIndex] != -1:
            panic("typed expr: builtin type layout direct index invalid")
    let rowIndex = ir.typeLayoutNames.len
    TypedExprBuildIndexRegisterIrTypeLayout(ir, sourcePath, typeName, rowIndex, fingerprint)
    add(ir.typeLayoutSourcePaths, sourcePath)
    add(ir.typeLayoutNames, typeName)
    add(ir.typeLayoutSizeBytes, sizeBytes)
    add(ir.typeLayoutAlignBytes, alignBytes)
    add(ir.typeLayoutFieldCounts, fieldCount)
    add(ir.typeLayoutProducerSourceIndexes, producerSourceIndex)
    add(ir.typeLayoutDeclarationSourceLocalRows,
        declarationSourceLocalRow)
    add(ir.typeLayoutBuiltinKinds, Int32(builtinKind))
    if builtinKind == TypedExprLayoutBuiltinNone:
        ir.exactLayoutTypeDeclarationRows[exactIndex] = rowIndex
    else:
        ir.exactLayoutTypeBuiltinRows[exactIndex] = rowIndex

fn TypedExprIrHasTypeLayout(ir: var TypedExprIr,
                             sourcePathRaw: str,
                             typeNameRaw: str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let typeName = TypedExprNormalizeTypeText(typeNameRaw)
    if sourcePath == "" || typeName == "":
        return false
    var rowIndex: int32
    return TypedExprBuildIndexLookup(ir.buildIndex,
                                     "ir_layout_source", sourcePath, typeName, "", rowIndex) == TypedExprBuildIndexUnique

fn TypedExprIrAppendTypeFieldLayout(ir: var TypedExprIr,
                                     sourcePathRaw: str,
                                     ownerTypeRaw: str,
                                     fieldNameRaw: str,
                                     fieldTypeRaw: str,
                                     fieldOffsetBytes: int32,
                                     fieldSizeBytes: int32,
                                     fieldAlignBytes: int32,
                                     producerSourceIndex: int32,
                                     ownerDeclarationSourceLocalRow: int32,
                                     fieldDeclarationSourceLocalRow: int32,
                                     ordinal: int32,
                                     builtinKind: TypedExprLayoutBuiltinKind) =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let ownerType = TypedExprNormalizeTypeText(ownerTypeRaw)
    let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw))
    let fieldType = TypedExprNormalizeTypeText(fieldTypeRaw)
    if producerSourceIndex < 0 || ordinal < 0 ||
       ((builtinKind == TypedExprLayoutBuiltinNone) !=
        (ownerDeclarationSourceLocalRow >= 0 &&
         fieldDeclarationSourceLocalRow >= 0)):
        panic("typed expr: type field exact coordinate invalid")
    if sourcePath == "" || ownerType == "" || fieldName == "" ||
       fieldType == "" || fieldOffsetBytes < 0 || fieldSizeBytes <= 0 ||
       fieldAlignBytes <= 0:
        panic("typed expr: type field receipt payload invalid")
    if ir.buildIndex == nil:
        panic("typed expr: type field append requires build index")
    let fingerprint = Fmt"{fieldType}:{fieldOffsetBytes}:{fieldSizeBytes}:{fieldAlignBytes}"
    let exactRow = typedExprIrExactTypeFieldRow(
        ir,
        producerSourceIndex,
        ownerDeclarationSourceLocalRow,
        fieldDeclarationSourceLocalRow,
        ordinal,
        builtinKind)
    var textRow: int32
    let textState = TypedExprBuildIndexLookup(
        ir.buildIndex,
        "ir_field_source",
        sourcePath,
        ownerType,
        fieldName,
        textRow)
    if exactRow >= 0:
        if exactRow >= ir.typeFieldSourcePaths.len ||
           ir.typeFieldSourcePaths[exactRow] != sourcePath ||
           ir.typeFieldOwnerTypes[exactRow] != ownerType ||
           ir.typeFieldNames[exactRow] != fieldName ||
           ir.typeFieldTypes[exactRow] != fieldType ||
           ir.typeFieldProducerSourceIndexes[exactRow] !=
               producerSourceIndex ||
           ir.typeFieldOwnerDeclarationSourceLocalRows[exactRow] !=
               ownerDeclarationSourceLocalRow ||
           ir.typeFieldDeclarationSourceLocalRows[exactRow] !=
               fieldDeclarationSourceLocalRow ||
           ir.typeFieldOrdinals[exactRow] != ordinal ||
           ir.typeFieldBuiltinKinds[exactRow] !=
               Int32(builtinKind) ||
           ir.typeFieldOffsetBytes[exactRow] != fieldOffsetBytes ||
           ir.typeFieldSizeBytes[exactRow] != fieldSizeBytes ||
           ir.typeFieldAlignBytes[exactRow] != fieldAlignBytes ||
           textState != TypedExprBuildIndexUnique ||
           textRow != exactRow:
            panic("typed expr: type field receipt cross-check drift")
        return
    if textState != TypedExprBuildIndexMissing:
        panic("typed expr: type field text collides with exact identity")
    var exactIndex: int32
    var ownerIndex: int32
    if builtinKind == TypedExprLayoutBuiltinNone:
        exactIndex = typedExprIrExactDeclarationIndex(
            ir,
            producerSourceIndex,
            fieldDeclarationSourceLocalRow)
        ownerIndex = typedExprIrExactDeclarationIndex(
            ir,
            producerSourceIndex,
            ownerDeclarationSourceLocalRow)
        if exactIndex < 0 || ownerIndex < 0 ||
           ir.exactLayoutFieldDeclarationRows[exactIndex] != -1:
            panic("typed expr: type field direct index invalid")
    else:
        exactIndex =
            producerSourceIndex * 16 +
            Int32(builtinKind) * 4 +
            ordinal
        ownerIndex =
            producerSourceIndex * 4 + Int32(builtinKind)
        if ordinal >= 4 || exactIndex < 0 ||
           exactIndex >= ir.exactLayoutFieldBuiltinRows.len ||
           ownerIndex < 0 ||
           ownerIndex >=
               ir.exactLayoutOwnerBuiltinFieldCounts.len ||
           ir.exactLayoutFieldBuiltinRows[exactIndex] != -1:
            panic("typed expr: builtin type field direct index invalid")
    let rowIndex = ir.typeFieldOwnerTypes.len
    TypedExprBuildIndexRegisterIrTypeField(ir, sourcePath, ownerType, fieldName, rowIndex, fingerprint)
    add(ir.typeFieldSourcePaths, sourcePath)
    add(ir.typeFieldOwnerTypes, ownerType)
    add(ir.typeFieldNames, fieldName)
    add(ir.typeFieldTypes, fieldType)
    add(ir.typeFieldOffsetBytes, fieldOffsetBytes)
    add(ir.typeFieldSizeBytes, fieldSizeBytes)
    add(ir.typeFieldAlignBytes, fieldAlignBytes)
    add(ir.typeFieldProducerSourceIndexes, producerSourceIndex)
    add(ir.typeFieldOwnerDeclarationSourceLocalRows,
        ownerDeclarationSourceLocalRow)
    add(ir.typeFieldDeclarationSourceLocalRows,
        fieldDeclarationSourceLocalRow)
    add(ir.typeFieldOrdinals, ordinal)
    add(ir.typeFieldBuiltinKinds, Int32(builtinKind))
    if builtinKind == TypedExprLayoutBuiltinNone:
        ir.exactLayoutFieldDeclarationRows[exactIndex] = rowIndex
        ir.exactLayoutOwnerDeclarationFieldCounts[ownerIndex] =
            ir.exactLayoutOwnerDeclarationFieldCounts[ownerIndex] + 1
    else:
        ir.exactLayoutFieldBuiltinRows[exactIndex] = rowIndex
        ir.exactLayoutOwnerBuiltinFieldCounts[ownerIndex] =
            ir.exactLayoutOwnerBuiltinFieldCounts[ownerIndex] + 1

@borrows
fn TypedExprIrExactLayoutCoordinateShapeComplete(
        ir: TypedExprIr): bool =
    let layoutCount = ir.typeLayoutNames.len
    let fieldCount = ir.typeFieldOwnerTypes.len
    return layoutCount == ir.typeLayoutSourcePaths.len &&
           layoutCount == ir.typeLayoutSizeBytes.len &&
           layoutCount == ir.typeLayoutAlignBytes.len &&
           layoutCount == ir.typeLayoutFieldCounts.len &&
           layoutCount == ir.typeLayoutProducerSourceIndexes.len &&
           layoutCount ==
               ir.typeLayoutDeclarationSourceLocalRows.len &&
           layoutCount == ir.typeLayoutBuiltinKinds.len &&
           fieldCount == ir.typeFieldSourcePaths.len &&
           fieldCount == ir.typeFieldNames.len &&
           fieldCount == ir.typeFieldTypes.len &&
           fieldCount == ir.typeFieldOffsetBytes.len &&
           fieldCount == ir.typeFieldSizeBytes.len &&
           fieldCount == ir.typeFieldAlignBytes.len &&
           fieldCount == ir.typeFieldProducerSourceIndexes.len &&
           fieldCount ==
               ir.typeFieldOwnerDeclarationSourceLocalRows.len &&
           fieldCount ==
               ir.typeFieldDeclarationSourceLocalRows.len &&
           fieldCount == ir.typeFieldOrdinals.len &&
           fieldCount == ir.typeFieldBuiltinKinds.len

@borrows
fn TypedExprIrExactLayoutCoordinatesStrictValidateInto(
        ir: TypedExprIr,
        producerSourceCount: int32,
        err: var str): bool =
    if producerSourceCount <= 0 ||
       !TypedExprIrExactLayoutCoordinateShapeComplete(ir):
        err = " typed expr: exact layout coordinate columns split"
        return false
    if ir.typeLayoutNames.len > 1073741823 ||
       ir.typeFieldOwnerTypes.len > 1073741823:
        err = " typed expr: exact layout coordinate domain overflow"
        return false
    if ir.exactLayoutIndexSourceStarts.len <= 0 ||
       ir.exactLayoutIndexSourceStarts[0] != 0:
        err = " typed expr: exact layout direct index missing"
        return false
    let indexedSourceCount =
        ir.exactLayoutIndexSourceStarts.len - 1
    if indexedSourceCount > producerSourceCount ||
       indexedSourceCount > 134217727:
        err = " typed expr: exact layout direct source domain invalid"
        return false
    for sourceId in 0..<indexedSourceCount:
        if ir.exactLayoutIndexSourceStarts[sourceId] >
               ir.exactLayoutIndexSourceStarts[sourceId + 1]:
            err = " typed expr: exact layout direct ranges invalid"
            return false
    let declarationDomain =
        ir.exactLayoutIndexSourceStarts[indexedSourceCount]
    if declarationDomain !=
           ir.exactLayoutTypeDeclarationRows.len ||
       declarationDomain !=
           ir.exactLayoutDeclarationAuthorityStates.len ||
       declarationDomain !=
           ir.exactLayoutDeclarationTypeArenaIds.len ||
       declarationDomain !=
           ir.exactLayoutDeclarationSizeBytes.len ||
       declarationDomain !=
           ir.exactLayoutDeclarationAlignBytes.len ||
       declarationDomain !=
           ir.exactLayoutDeclarationGenericSymbolCounts.len ||
       declarationDomain !=
           ir.exactLayoutFieldDeclarationRows.len ||
       declarationDomain !=
           ir.exactLayoutOwnerDeclarationFieldCounts.len ||
       indexedSourceCount * 4 !=
           ir.exactLayoutTypeBuiltinRows.len ||
       indexedSourceCount * 16 !=
           ir.exactLayoutFieldBuiltinRows.len ||
       indexedSourceCount * 4 !=
           ir.exactLayoutOwnerBuiltinFieldCounts.len:
        err = " typed expr: exact layout direct index columns split"
        return false
    for row in 0..<ir.typeLayoutNames.len:
        let sourceId = ir.typeLayoutProducerSourceIndexes[row]
        let declarationRow =
            ir.typeLayoutDeclarationSourceLocalRows[row]
        let builtinRaw = ir.typeLayoutBuiltinKinds[row]
        if builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(TypedExprLayoutBuiltinOptional):
            err = " typed expr: layout builtin kind outside closed domain"
            return false
        let builtinKind = TypedExprLayoutBuiltinKind(builtinRaw)
        if sourceId < 0 || sourceId >= producerSourceCount ||
           ((builtinKind == TypedExprLayoutBuiltinNone) !=
            (declarationRow >= 0)):
            err = " typed expr: layout exact owner coordinate invalid"
            return false
        if builtinKind == TypedExprLayoutBuiltinNone:
            let exactIndex = typedExprIrExactDeclarationIndex(
                ir, sourceId, declarationRow)
            if exactIndex < 0:
                err = Fmt" typed expr: layout differs from exact TypeArena authority row={row} source={sourceId} declaration={declarationRow} type={ir.typeLayoutNames[row]} branch=coordinate_missing authority_domain={ir.exactLayoutTypeDeclarationRows.len}"
                return false
            if ir.exactLayoutDeclarationAuthorityStates[
                   exactIndex] != 2 ||
               ir.exactLayoutDeclarationTypeArenaIds[
                   exactIndex] < 0 ||
               ir.exactLayoutDeclarationGenericSymbolCounts[
                   exactIndex] != 0:
                err = Fmt" typed expr: layout differs from exact TypeArena authority row={row} source={sourceId} declaration={declarationRow} type={ir.typeLayoutNames[row]} state={ir.exactLayoutDeclarationAuthorityStates[exactIndex]} arena_id={ir.exactLayoutDeclarationTypeArenaIds[exactIndex]} generic={ir.exactLayoutDeclarationGenericSymbolCounts[exactIndex]} layout_size={ir.typeLayoutSizeBytes[row]} layout_align={ir.typeLayoutAlignBytes[row]}"
                return false
            if ir.exactLayoutDeclarationSizeBytes[
                   exactIndex] !=
                   ir.typeLayoutSizeBytes[row] ||
               ir.exactLayoutDeclarationAlignBytes[
                   exactIndex] !=
                   ir.typeLayoutAlignBytes[row]:
                err = Fmt" typed expr: layout differs from exact TypeArena authority row={row} source={sourceId} declaration={declarationRow} type={ir.typeLayoutNames[row]} authority_size={ir.exactLayoutDeclarationSizeBytes[exactIndex]} authority_align={ir.exactLayoutDeclarationAlignBytes[exactIndex]} layout_size={ir.typeLayoutSizeBytes[row]} layout_align={ir.typeLayoutAlignBytes[row]}"
                return false
        if typedExprIrExactTypeLayoutRow(
               ir,
               sourceId,
               declarationRow,
               builtinKind) != row:
            err = " typed expr: exact layout direct row mismatch"
            return false
    var observedDeclarationFieldCounts: int32[]
    var observedBuiltinFieldCounts: int32[]
    setLen(observedDeclarationFieldCounts, declarationDomain)
    setLen(
        observedBuiltinFieldCounts,
        indexedSourceCount * 4)
    for row in 0..<ir.typeFieldOwnerTypes.len:
        let sourceId = ir.typeFieldProducerSourceIndexes[row]
        let ownerDeclarationRow =
            ir.typeFieldOwnerDeclarationSourceLocalRows[row]
        let fieldDeclarationRow =
            ir.typeFieldDeclarationSourceLocalRows[row]
        let ordinal = ir.typeFieldOrdinals[row]
        let builtinRaw = ir.typeFieldBuiltinKinds[row]
        if builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(TypedExprLayoutBuiltinOptional):
            err = " typed expr: field builtin kind outside closed domain"
            return false
        let builtinKind = TypedExprLayoutBuiltinKind(builtinRaw)
        if sourceId < 0 || sourceId >= producerSourceCount ||
           ordinal < 0 ||
           ((builtinKind == TypedExprLayoutBuiltinNone) !=
            (ownerDeclarationRow >= 0 &&
             fieldDeclarationRow >= 0)):
            err = " typed expr: field exact coordinate invalid"
            return false
        if typedExprIrExactTypeFieldRow(
               ir,
               sourceId,
               ownerDeclarationRow,
               fieldDeclarationRow,
               ordinal,
               builtinKind) != row:
            err = " typed expr: exact field direct row mismatch"
            return false
        if builtinKind == TypedExprLayoutBuiltinNone:
            let ownerIndex = typedExprIrExactDeclarationIndex(
                ir, sourceId, ownerDeclarationRow)
            if ownerIndex < 0:
                err = " typed expr: exact field direct owner missing"
                return false
            observedDeclarationFieldCounts[ownerIndex] =
                observedDeclarationFieldCounts[ownerIndex] + 1
        else:
            let ownerIndex =
                sourceId * 4 + builtinRaw
            observedBuiltinFieldCounts[ownerIndex] =
                observedBuiltinFieldCounts[ownerIndex] + 1
        if typedExprIrExactTypeLayoutRow(
               ir,
               sourceId,
               ownerDeclarationRow,
               builtinKind) < 0:
            err = " typed expr: field exact owner layout missing"
            return false
    for index in 0..<observedDeclarationFieldCounts.len:
        if observedDeclarationFieldCounts[index] !=
               ir.exactLayoutOwnerDeclarationFieldCounts[index]:
            err = " typed expr: exact field owner count mismatch"
            return false
    for index in 0..<observedBuiltinFieldCounts.len:
        if observedBuiltinFieldCounts[index] !=
               ir.exactLayoutOwnerBuiltinFieldCounts[index]:
            err = " typed expr: builtin field owner count mismatch"
            return false
    err = ""
    return true

fn TypedExprIrAppendTypeAlias(ir: var TypedExprIr,
                               sourcePathRaw: str,
                               qualifierRaw: str,
                               targetSourcePathRaw: str) =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(qualifierRaw))
    let targetSourcePath = parser.ParserNormalizePath(targetSourcePathRaw)
    if sourcePath == "" || qualifier == "" || targetSourcePath == "":
        return
    if ir.buildIndex == nil:
        panic("typed expr: import alias append requires build index")
    var existingIndex: int32
    let existingState = TypedExprBuildIndexLookup(ir.buildIndex, "ir_import_alias", sourcePath, qualifier, "", existingIndex)
    if existingState == TypedExprBuildIndexUnique:
        TypedExprBuildIndexRegisterIrImportAlias(ir, sourcePath, qualifier, existingIndex, targetSourcePath)
        return
    if existingState == TypedExprBuildIndexAmbiguous:
        panic(Fmt"typed expr: ambiguous source import alias source={sourcePath} qualifier={qualifier}")
    let rowIndex = ir.typeAliasQualifiers.len
    TypedExprBuildIndexRegisterIrImportAlias(ir, sourcePath, qualifier, rowIndex, targetSourcePath)
    add(ir.typeAliasSourcePaths, sourcePath)
    add(ir.typeAliasQualifiers, qualifier)
    add(ir.typeAliasTargetSourcePaths, targetSourcePath)

@borrows
fn TypedExprIrAppendTypeDefAliasesFromContext(ir: var TypedExprIr,
                                               ctx: TypedExprSourceContext) =
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    if sourcePath == "":
        return
    for i in 0..<ctx.typeDefAliasNames.len:
        if i >= ctx.typeDefAliasTargetTypes.len:
            continue
        let aliasName = parser.ParserIdentPrefix(chengpath.PathTrim(ctx.typeDefAliasNames[i]))
        let targetType = TypedExprNormalizeTypeText(ctx.typeDefAliasTargetTypes[i])
        if aliasName == "" || targetType == "":
            continue
        var existingIndex: int32
        let existingState = TypedExprBuildIndexLookup(ir.buildIndex, "ir_alias_def_source", sourcePath, aliasName, "", existingIndex)
        if existingState == TypedExprBuildIndexUnique:
            TypedExprBuildIndexRegisterIrTypeDefAlias(ir, sourcePath, aliasName, existingIndex, targetType)
            continue
        if existingState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: ambiguous source type alias source={sourcePath} alias={aliasName}")
        let rowIndex = ir.typeDefAliasNames.len
        TypedExprBuildIndexRegisterIrTypeDefAlias(ir, sourcePath, aliasName, rowIndex, targetType)
        add(ir.typeDefAliasSourcePaths, share(sourcePath))
        add(ir.typeDefAliasNames, aliasName)
        add(ir.typeDefAliasTargetTypes, targetType)

fn TypedExprIrAppendLeafLayoutMatchesField(fieldTypeRaw: str,
                                            fieldTypeLeaf: str): bool =
    # A field's whole-type layout only equals its leaf struct's own layout when
    # the field is a plain named-struct value. Containers (seq[...], ...[], fixed
    # arrays [...], pointers ...*, Result[...]) carry a different size than the
    # element struct, so their cached size must not be attributed to the leaf.
    let typeText = TypedExprStripVarType(fieldTypeRaw)
    if typeText == "" || fieldTypeLeaf == "":
        return false
    if typeText.len > 0 && typeText[typeText.len - 1] == '*':
        return false
    for i in 0..<typeText.len:
        if typeText[i] == '[' || typeText[i] == ']':
            return false
    return true

@borrows
fn TypedExprIrAppendObjectTypeLayoutFromContext(ir: var TypedExprIr,
                                                 ctx: TypedExprSourceContext,
                                                 sourceContexts: var TypedExprSourceContext[],
                                                 typeName: str,
                                                 producerSourceIndex: int32,
                                                 declarationSourceLocalRow: int32,
                                                 builtinKind: TypedExprLayoutBuiltinKind): bool =
    let ownerType = TypedExprTypeLeafName(typeName)
    if ownerType == "":
        return false
    var offset: int32
    var maxAlign: int32 = 1
    var fieldCount: int32
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    var fieldNode = TypedExprBuildIndexContextFieldHead(ctx.buildIndex, sourcePath, ownerType)
    # [phaseB-parser] 入口源文件命名构造通道根修：重建/冻结轮的 ctx 可能
    # 借到不含 ctx_field 节点的 build index（头部 -1），但 ctx.typeFields
    # 本身携带 compiler csg 绑定的精确坐标列（producer/ownerRow/fieldRow/
    # ordinal）。build-index 通道无节点时按同一 owner 的精确 typeFields
    # 列直走——同一份已绑定数据，只是不经过二级投影；已工作形状
    # （build-index 通道有节点）零改动。
    var useDirectTypeFieldWalk = false
    if fieldNode < 0:
        for directFieldIndex in 0..<ctx.typeFields.len:
            if TypedExprTypeLeafName(ctx.typeFields[directFieldIndex].ownerType) ==
                   ownerType &&
               ctx.typeFields[directFieldIndex].producerSourceIndex ==
                   producerSourceIndex &&
               ctx.typeFields[directFieldIndex].fieldDeclarationSourceLocalRow >= 0:
                useDirectTypeFieldWalk = true
                break
        if !useDirectTypeFieldWalk:
            return false
    if useDirectTypeFieldWalk:
        for directFieldIndex in 0..<ctx.typeFields.len:
            let field = ctx.typeFields[directFieldIndex]
            if TypedExprTypeLeafName(field.ownerType) != ownerType:
                continue
            var fieldSizeBytes: int32
            var fieldAlignBytes: int32
            var cachedFieldCount: int32
            let fieldTypeIsSeqOrArray = parser.ParserFindText(field.fieldType, "[") >= 0
            let fieldTypeIsRefObject =
                !fieldTypeIsSeqOrArray &&
                (TypedExprIrTypeIsRef(ir, ctx.sourcePath, field.fieldType) ||
                 TypedExprTypeIsRefObjectInContext(ctx, sourceContexts, field.fieldType))
            if fieldTypeIsRefObject:
                fieldSizeBytes = 8
                fieldAlignBytes = 8
            elif !TypedExprIrLookupTypeLayout(ir,
                                            ctx.sourcePath,
                                            field.fieldType,
                                            fieldSizeBytes,
                                            fieldAlignBytes,
                                            cachedFieldCount):
                if !TypedExprTypeLayout(ctx,
                                        sourceContexts,
                                        field.fieldType,
                                        fieldSizeBytes,
                                        fieldAlignBytes):
                    return false
            if fieldAlignBytes <= 0:
                fieldAlignBytes = 1
            offset = TypedExprAlignBytes(offset, fieldAlignBytes)
            TypedExprIrAppendTypeFieldLayout(ir,
                                             share(ctx.sourcePath),
                                             share(typeName),
                                             share(field.fieldName),
                                             share(field.fieldType),
                                             offset,
                                             fieldSizeBytes,
                                             fieldAlignBytes,
                                             field.producerSourceIndex,
                                             field.ownerDeclarationSourceLocalRow,
                                             field.fieldDeclarationSourceLocalRow,
                                             field.ordinal,
                                             field.builtinKind)
            offset = offset + fieldSizeBytes
            if fieldAlignBytes > maxAlign:
                maxAlign = fieldAlignBytes
            fieldCount = fieldCount + 1
        if fieldCount <= 0:
            return false
        var directRowSizeBytes = TypedExprAlignBytes(offset, maxAlign)
        var directRowAlignBytes = maxAlign
        # W-F 根修同口径：ref object 声明行的 owner 行取声明坐标的权威冻结
        # 列（8 字节指针句柄），字段行仍按 pointee 偏移发布。
        if builtinKind == TypedExprLayoutBuiltinNone &&
           (TypedExprIrTypeIsRef(ir, ctx.sourcePath, typeName) ||
            TypedExprTypeIsRefObjectInContext(ctx, sourceContexts, typeName)):
            let directAuthorityIndex = typedExprIrExactDeclarationIndex(
                ir, producerSourceIndex, declarationSourceLocalRow)
            if directAuthorityIndex < 0 ||
               ir.exactLayoutDeclarationAuthorityStates[directAuthorityIndex] != 2 ||
               ir.exactLayoutDeclarationSizeBytes[directAuthorityIndex] <= 0 ||
               ir.exactLayoutDeclarationAlignBytes[directAuthorityIndex] <= 0:
                panic("typed expr: ref object owner layout authority missing")
            directRowSizeBytes =
                ir.exactLayoutDeclarationSizeBytes[directAuthorityIndex]
            directRowAlignBytes =
                ir.exactLayoutDeclarationAlignBytes[directAuthorityIndex]
        TypedExprIrAppendTypeLayout(ir,
                                    share(ctx.sourcePath),
                                    share(typeName),
                                    directRowSizeBytes,
                                    directRowAlignBytes,
                                    fieldCount,
                                    producerSourceIndex,
                                    declarationSourceLocalRow,
                                    builtinKind)
        return true
    while fieldNode >= 0:
        var fieldContextIndex: int32
        var fieldIndex: int32
        if !TypedExprBuildIndexContextFieldNode(ctx.buildIndex,
                                                fieldNode,
                                                fieldContextIndex,
                                                fieldIndex):
            return false
        let localFieldContextIndex = typedExprContextArrayIndexForBuildIndex(
            sourceContexts,
            fieldContextIndex)
        if localFieldContextIndex < 0 ||
           parser.ParserNormalizePath(sourceContexts[localFieldContextIndex].sourcePath) != sourcePath:
            return false
        var field: TypedExprTypeFieldDecl
        if !typedExprContextFieldAt(sourceContexts[localFieldContextIndex],
                                    fieldIndex,
                                    field):
            return false
        if TypedExprTypeLeafName(field.ownerType) != ownerType:
            return false
        var fieldSizeBytes: int32
        var fieldAlignBytes: int32
        var cachedFieldCount: int32
        # bail=44 C1 根修: ref-object 类型 (`Name = ref`) 作字段的存储位宽恒为
        # 8 字节指针。此前 cache-first LookupTypeLayout 对 `langintern.InternPool`
        # 经别名解到 intern.cheng 的 owner 行 (pointee 布局 168B), 字段行注册成
        # size=168 且后继字段偏移全体 +160 漂移 → 跨模块 named-field ctor 的
        # LookupIntern(ir.internPool,...) 实参物化 8B ptr 槽 < 168 恒败
        # (MaterializeFieldArgSlot 436 → bail_44, lowering_plan:827 等 ×9)。
        # ref 判定双保险 (IR 镜像表按 metadataContexts 处理序渐次填充, ctx 镜像
        # 表在 ctx 构建期即完备): 命中即定 8/8, 不再查 owner pointee 布局。
        # W2D 根修: ref-seq/定长数组字段 (`Sym[]`/`Sym[N]`) 的存储是 16B seq 头
        # (或 N*8 内联数组), 不是 ref 句柄的 8B 指针。TypeLeafName 剥 `[]` 后
        # TypedExprIrTypeIsRef 命中元素 ref 注册表, 此前把这类字段错注成 8B ——
        # 与前端节点布局 (TypedExprTypeLayoutImpl: T[]=16B 头) 及运行时 add/len
        # 的内联头读写相差 8B, 后继字段偏移全体漂移, 节点求值按错偏移读出头外
        # 垃圾 (MachoProviderObject.relocs 索引读 SIGSEGV)。含 `[` 容器形跳过
        # ref 规则, 落常规布局 (T[]→16B 头; T[N]→内联 N*elem)。
        let fieldTypeIsSeqOrArray = parser.ParserFindText(field.fieldType, "[") >= 0
        let fieldTypeIsRefObject =
            !fieldTypeIsSeqOrArray &&
            (TypedExprIrTypeIsRef(ir, ctx.sourcePath, field.fieldType) ||
             TypedExprTypeIsRefObjectInContext(ctx, sourceContexts, field.fieldType))
        if fieldTypeIsRefObject:
            fieldSizeBytes = 8
            fieldAlignBytes = 8
        elif !TypedExprIrLookupTypeLayout(ir,
                                        ctx.sourcePath,
                                        field.fieldType,
                                        fieldSizeBytes,
                                        fieldAlignBytes,
                                        cachedFieldCount):
            if !TypedExprTypeLayout(ctx,
                                    sourceContexts,
                                    field.fieldType,
                                    fieldSizeBytes,
                                    fieldAlignBytes):
                return false
        # Nested type rows are emitted only from their own exact declaration
        # coordinate. A containing field cannot mint another type's identity.
        if fieldAlignBytes <= 0:
            fieldAlignBytes = 1
        offset = TypedExprAlignBytes(offset, fieldAlignBytes)
        TypedExprIrAppendTypeFieldLayout(ir,
                                         share(ctx.sourcePath),
                                         share(typeName),
                                         share(field.fieldName),
                                         share(field.fieldType),
                                         offset,
                                         fieldSizeBytes,
                                         fieldAlignBytes,
                                         field.producerSourceIndex,
                                         field.ownerDeclarationSourceLocalRow,
                                         field.fieldDeclarationSourceLocalRow,
                                         field.ordinal,
                                         field.builtinKind)
        offset = offset + fieldSizeBytes
        if fieldAlignBytes > maxAlign:
            maxAlign = fieldAlignBytes
        fieldCount = fieldCount + 1
        fieldNode = TypedExprBuildIndexContextFieldNext(ctx.buildIndex, fieldNode)
    if fieldCount <= 0:
        return false
    var rowSizeBytes = TypedExprAlignBytes(offset, maxAlign)
    var rowAlignBytes = maxAlign
    # W-F 根修: ref object 声明(`Name = ref object ...`)的 typeLayout owner
    # 行是 exact TypeArena 权威的 RefObject kind → 8 字节指针句柄, 不是
    # pointee struct。上方字段行走的是 pointee 布局(字段行仍按 pointee 偏移
    # 发布, 供后端句柄解引用后的字段寻址), 但 owner 行若按 pointee 尺寸发布,
    # TypedExprIrExactLayoutCoordinatesStrictValidateInto 与 csg
    # exact-layout 表重建的 authority/layout 逐字节互证必死(v6 实测 Box
    # authority_size=8 authority_align=8 layout_size=4 layout_align=4)。
    # 行值直接取声明坐标的权威冻结列(调用方已保证 state==2), 零派生;
    # 非 ref owner 与 builtin 行为逐字节不变。
    if builtinKind == TypedExprLayoutBuiltinNone &&
       (TypedExprIrTypeIsRef(ir, ctx.sourcePath, typeName) ||
        TypedExprTypeIsRefObjectInContext(ctx, sourceContexts, typeName)):
        let authorityIndex = typedExprIrExactDeclarationIndex(
            ir, producerSourceIndex, declarationSourceLocalRow)
        if authorityIndex < 0 ||
           ir.exactLayoutDeclarationAuthorityStates[authorityIndex] != 2 ||
           ir.exactLayoutDeclarationSizeBytes[authorityIndex] <= 0 ||
           ir.exactLayoutDeclarationAlignBytes[authorityIndex] <= 0:
            panic("typed expr: ref object owner layout authority missing")
        rowSizeBytes = ir.exactLayoutDeclarationSizeBytes[authorityIndex]
        rowAlignBytes = ir.exactLayoutDeclarationAlignBytes[authorityIndex]
    TypedExprIrAppendTypeLayout(ir,
                                share(ctx.sourcePath),
                                share(typeName),
                                rowSizeBytes,
                                rowAlignBytes,
                                fieldCount,
                                producerSourceIndex,
                                declarationSourceLocalRow,
                                builtinKind)
    return true

@borrows
fn TypedExprIrLookupTypeDefAliasTargetType(ir: TypedExprIr,
                                            sourcePathRaw: str,
                                            aliasNameRaw: str): str =
    # The @borrow_result metadata forward requires the pristine incoming var
    # root; later var-boundary calls in this body re-seat it.  The index
    # depends only on ir, so bind it first.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(sourcePathRaw))
    let aliasName = parser.ParserIdentPrefix(
        chengpath.PathTrim(parser.ParserOwnedText(aliasNameRaw)))
    if aliasName == "":
        return ""
    var rowIndex: int32
    if sourcePath != "":
        let sourceState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_alias_def_source", sourcePath, aliasName, "", rowIndex)
        if sourceState == TypedExprBuildIndexAmbiguous:
            return ""
        if sourceState == TypedExprBuildIndexUnique &&
           rowIndex >= 0 && rowIndex < ir.typeDefAliasTargetTypes.len:
            return parser.ParserOwnedText(
                ir.typeDefAliasTargetTypes[rowIndex])
        var targetSourcePath: str
        let visibleState = TypedExprBuildIndexVisibleContextSourcePath(
                                                                       canonicalMetadataIndex,
                                                                       "ctx_import_alias_def",
                                                                       sourcePath,
                                                                       aliasName,
                                                                       "",
                                                                       targetSourcePath)
        if visibleState != TypedExprBuildIndexUnique:
            return ""
        let targetState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_alias_def_source",
                                                     targetSourcePath,
                                                     aliasName,
                                                     "",
                                                     rowIndex)
        if targetState != TypedExprBuildIndexUnique ||
           rowIndex < 0 || rowIndex >= ir.typeDefAliasTargetTypes.len:
            return ""
        return parser.ParserOwnedText(
            ir.typeDefAliasTargetTypes[rowIndex])
    let globalState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                 "ir_alias_def_global", "", aliasName, "", rowIndex)
    if globalState != TypedExprBuildIndexUnique ||
       rowIndex < 0 || rowIndex >= ir.typeDefAliasTargetTypes.len:
        return ""
    return parser.ParserOwnedText(
        ir.typeDefAliasTargetTypes[rowIndex])

# wave3 44-N 严格同源枚举成员查值: name 必须是【定义在 sourcePath 内】的枚举成员。
# 无跨源回退 — 供限定枚举实参 (orel.ObjectRelocBranch26) 用, qualifier 已解析为
# 目标模块源, 跨源回退在这里只会引入撞名错值。
@borrows
fn TypedExprIrLookupEnumConstValueInSource(ir: TypedExprIr,
                                           sourcePathRaw: str,
                                           nameRaw: str,
                                           valueOut: var int32): bool =
    valueOut = 0
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if sourcePath == "" || name == "":
        return false
    var rowIndex: int32
    let state = TypedExprBuildIndexLookup(ir.buildIndex,
                                          "ir_enum_name_source", sourcePath, name, "", rowIndex)
    if state != TypedExprBuildIndexUnique ||
       rowIndex < 0 || rowIndex >= ir.enumValueOrdinals.len:
        return false
    valueOut = ir.enumValueOrdinals[rowIndex]
    return true

# wave3 0-B 严格同源判定: aliasName 是否为【定义在 sourcePath 内】且目标为动态
# seq (`T[]`) 的类型别名。无跨源回退 — 供 seq-alias 构造头识别用 (reachability
# 跳过判定), 全局唯一回退在这里会把与他模块别名撞名的真函数误判成构造器。
@borrows
fn TypedExprIrTypeDefAliasIsSameSourceSeq(ir: TypedExprIr,
                                          sourcePathRaw: str,
                                          aliasNameRaw: str): bool =
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(sourcePathRaw))
    let aliasName = parser.ParserIdentPrefix(
        chengpath.PathTrim(parser.ParserOwnedText(aliasNameRaw)))
    if sourcePath == "" || aliasName == "":
        return false
    var rowIndex: int32
    let state = TypedExprBuildIndexLookup(ir.buildIndex,
                                          "ir_alias_def_source", sourcePath, aliasName, "", rowIndex)
    if state != TypedExprBuildIndexUnique ||
       rowIndex < 0 || rowIndex >= ir.typeDefAliasTargetTypes.len:
        return false
    let target = TypedExprNormalizeTypeText(
        parser.ParserOwnedText(ir.typeDefAliasTargetTypes[rowIndex]))
    return target.len >= 2 && chengpath.TextSlice(target, target.len - 2, 2) == "[]"

# wave6 R-F: aliasName 是否为【定义在 sourcePath 内】且目标为指针 (`T *`) 的
# 类型别名 (BytePtr = uint8 * 等)。`BytePtr(ptr(...))` 是纯 8 字节指针位重解释
# cast, 非函数调用 — 与 seq 别名构造头 (上方 IsSameSourceSeq) 同理不得登记为
# 可解析调用目标, 否则幻影 missing_call_target (bytePtrAt 实测)。
# 严格同源, 无跨源回退 (全局唯一回退会把撞名真函数误判成 cast 头)。
@borrows
fn TypedExprIrTypeDefAliasIsSameSourcePtr(ir: TypedExprIr,
                                          sourcePathRaw: str,
                                          aliasNameRaw: str): bool =
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(sourcePathRaw))
    let aliasName = parser.ParserIdentPrefix(
        chengpath.PathTrim(parser.ParserOwnedText(aliasNameRaw)))
    if sourcePath == "" || aliasName == "":
        return false
    var rowIndex: int32
    let state = TypedExprBuildIndexLookup(ir.buildIndex,
                                          "ir_alias_def_source", sourcePath, aliasName, "", rowIndex)
    if state != TypedExprBuildIndexUnique ||
       rowIndex < 0 || rowIndex >= ir.typeDefAliasTargetTypes.len:
        return false
    let target = TypedExprNormalizeTypeText(
        parser.ParserOwnedText(ir.typeDefAliasTargetTypes[rowIndex]))
    return target.len >= 2 && chengpath.TextSlice(target, target.len - 1, 1) == "*"

# The verbatim RHS literal text of a global's initializer (e.g. "42"), or ""
# when the global is zero-initialized / not found. Keyed by exact source path +
# name so a global only matches its own translation unit.
@borrows
fn TypedExprIrLookupGlobalInitValue(ir: TypedExprIr,
                                     sourcePathRaw: str,
                                     nameRaw: str): str =
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return ""
    for i in 0..<ir.globalNames.len:
        if i >= ir.globalSourcePaths.len || i >= ir.globalInitValues.len:
            continue
        if ir.globalNames[i] != name:
            continue
        if ir.globalSourcePaths[i] == sourcePathRaw ||
           TypedExprPathNormalizedEquals(ir.globalSourcePaths[i], sourcePathRaw):
            return strings.CloneStr(ir.globalInitValues[i])
    return ""

fn TypedExprIrAppendColdCsgRowsFromContext(ir: var TypedExprIr,
                                            ctx: var TypedExprSourceContext) =
    if os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_ROWS") != "1":
        return
    for i in 0..<ctx.coldCsgTypeRows.len:
        let row = ctx.coldCsgTypeRows[i]
        var seen = false
        for existingIndex in 0..<ir.coldCsgTypeRows.len:
            let existing = ir.coldCsgTypeRows[existingIndex]
            if existing.sourcePath == row.sourcePath &&
               existing.rowKind == row.rowKind &&
               existing.typeName == row.typeName:
                seen = true
                break
        if !seen:
            add(ir.coldCsgTypeRows, TypedExprColdCsgTypeRowClone(row))
    if os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_STATEMENTS") != "1":
        return
    for i in 0..<ctx.coldCsgStatementRows.len:
        add(ir.coldCsgStatementRows, TypedExprColdCsgStatementRowClone(ctx.coldCsgStatementRows[i]))

@borrows
fn TypedExprIrLookupTypeAliasTargetSourcePath(ir: TypedExprIr,
                                               sourcePathRaw: str,
                                               qualifierRaw: str): str =
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(sourcePathRaw))
    let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(
        parser.ParserOwnedText(qualifierRaw)))
    if sourcePath == "" || qualifier == "":
        return ""
    var rowIndex: int32
    let state = TypedExprBuildIndexLookup(ir.buildIndex,
                                          "ir_import_alias", sourcePath, qualifier, "", rowIndex)
    if state != TypedExprBuildIndexUnique ||
       rowIndex < 0 || rowIndex >= ir.typeAliasTargetSourcePaths.len:
        return ""
    return parser.ParserOwnedText(ir.typeAliasTargetSourcePaths[rowIndex])

@borrows
fn TypedExprIrVisibleSourceRowState(ir: TypedExprIr,
                                    kind: str,
                                    sourcePathRaw: str,
                                    name: str,
                                    detail: str,
                                    rowIndexOut: var int32,
                                    definingSourcePathOut: var str): TypedExprBuildIndexLookupState =
    rowIndexOut = -1
    definingSourcePathOut = ""
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(sourcePathRaw))
    if ir.buildIndex == nil || ir.buildIndex.released ||
       sourcePath == "" || name == "":
        return TypedExprBuildIndexMissing
    let localState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                kind,
                                                sourcePath,
                                                name,
                                                detail,
                                                rowIndexOut)
    if localState == TypedExprBuildIndexAmbiguous:
        rowIndexOut = -1
        return localState
    if localState == TypedExprBuildIndexUnique:
        definingSourcePathOut = sourcePath
        return localState
    if !TypedExprTopLevelDeclarationExportedByCase(name):
        rowIndexOut = -1
        return TypedExprBuildIndexMissing
    for importIndex in 0..<ir.typeAliasSourcePaths.len:
        if importIndex >= ir.typeAliasTargetSourcePaths.len:
            panic("typed expr: import visibility columns mismatch")
        let importerSourcePath = parser.ParserNormalizePath(
            parser.ParserOwnedText(
                ir.typeAliasSourcePaths[importIndex]))
        if importerSourcePath != sourcePath:
            continue
        let targetSourcePath = parser.ParserNormalizePath(
            parser.ParserOwnedText(
                ir.typeAliasTargetSourcePaths[importIndex]))
        if targetSourcePath == "":
            panic("typed expr: import visibility target missing")
        var candidateRow: int32
        let candidateState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                        kind,
                                                        targetSourcePath,
                                                        name,
                                                        detail,
                                                        candidateRow)
        if candidateState == TypedExprBuildIndexAmbiguous:
            rowIndexOut = -1
            definingSourcePathOut = ""
            return TypedExprBuildIndexAmbiguous
        if candidateState != TypedExprBuildIndexUnique:
            continue
        if definingSourcePathOut == "":
            definingSourcePathOut = targetSourcePath
            rowIndexOut = candidateRow
            continue
        if definingSourcePathOut != targetSourcePath ||
           rowIndexOut != candidateRow:
            rowIndexOut = -1
            definingSourcePathOut = ""
            return TypedExprBuildIndexAmbiguous
    if definingSourcePathOut != "":
        return TypedExprBuildIndexUnique
    return TypedExprBuildIndexMissing


@borrows
fn TypedExprIrImportAliasTargetState(ir: TypedExprIr,
                                      sourcePathRaw: str,
                                      qualifierRaw: str,
                                      targetSourcePathOut: var str): TypedExprBuildIndexLookupState =
    targetSourcePathOut = ""
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(sourcePathRaw))
    let qualifierText = chengpath.PathTrim(
        parser.ParserOwnedText(qualifierRaw))
    let qualifier = parser.ParserIdentPrefix(
        parser.ParserOwnedText(qualifierText))
    if ir.buildIndex == nil || ir.buildIndex.released ||
       sourcePath == "" || qualifier == "" || qualifier != qualifierText:
        return TypedExprBuildIndexMissing
    var rowIndex: int32
    let state = TypedExprBuildIndexLookup(ir.buildIndex,
                                          "ir_import_alias",
                                          sourcePath,
                                          qualifier,
                                          "",
                                          rowIndex)
    if state != TypedExprBuildIndexUnique:
        return state
    if rowIndex < 0 || rowIndex >= ir.typeAliasTargetSourcePaths.len:
        panic("typed expr: import alias row out of bounds")
    targetSourcePathOut = parser.ParserNormalizePath(
        parser.ParserOwnedText(
            ir.typeAliasTargetSourcePaths[rowIndex]))
    if targetSourcePathOut == "":
        panic("typed expr: import alias target missing")
    return TypedExprBuildIndexUnique


@borrows
fn TypedExprIrAliasTarget(ir: TypedExprIr,
                           ownerSourcePathRaw: str,
                           typeRaw: str,
                           visitedOwners: var str[],
                           visitedNames: var str[],
                           targetOwnerSourcePathOut: var str,
                           targetTypeOut: var str,
                           cycleOut: var bool): TypedExprBuildIndexLookupState =
    targetOwnerSourcePathOut = ""
    targetTypeOut = ""
    cycleOut = false
    let ownerSourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(ownerSourcePathRaw))
    let typeText = TypedExprNormalizeTypeText(
        TypedExprStripVarType(parser.ParserOwnedText(typeRaw)))
    if ir.buildIndex == nil || ir.buildIndex.released ||
       ownerSourcePath == "" || typeText == "":
        return TypedExprBuildIndexMissing
    var aliasOwnerSourcePath = share(ownerSourcePath)
    var aliasName = share(typeText)
    var rowIndex: int32
    var state = TypedExprBuildIndexMissing
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(
            chengpath.TextSlice(typeText, 0, dotPos))
        aliasName = parser.ParserOwnedText(chengpath.PathTrim(
            chengpath.TextSlice(typeText,
                                dotPos + 1,
                                typeText.len - dotPos - 1)))
        if qualifier == "" ||
           parser.ParserIdentPrefix(parser.ParserOwnedText(qualifier)) !=
               qualifier ||
           aliasName == "" ||
           parser.ParserIdentPrefix(parser.ParserOwnedText(aliasName)) !=
               aliasName:
            return TypedExprBuildIndexMissing
        let importState = TypedExprIrImportAliasTargetState(
            ir, ownerSourcePath, qualifier, aliasOwnerSourcePath)
        if importState != TypedExprBuildIndexUnique:
            return importState
        if !TypedExprTopLevelDeclarationExportedByCase(aliasName):
            aliasOwnerSourcePath = ""
            return TypedExprBuildIndexMissing
        state = TypedExprBuildIndexLookup(ir.buildIndex,
                                           "ir_alias_def_source",
                                           aliasOwnerSourcePath,
                                           aliasName,
                                           "",
                                           rowIndex)
    else:
        if parser.ParserIdentPrefix(parser.ParserOwnedText(aliasName)) !=
           aliasName:
            return TypedExprBuildIndexMissing
        state = TypedExprIrVisibleSourceRowState(ir,
                                                  "ir_alias_def_source",
                                                  ownerSourcePath,
                                                  aliasName,
                                                  "",
                                                  rowIndex,
                                                  aliasOwnerSourcePath)
    if state != TypedExprBuildIndexUnique:
        return state
    if rowIndex < 0 || rowIndex >= ir.typeDefAliasTargetTypes.len:
        panic("typed expr: alias target row out of bounds")
    for visitIndex in 0..<visitedOwners.len:
        if visitIndex < visitedNames.len &&
           visitedOwners[visitIndex] == aliasOwnerSourcePath &&
           visitedNames[visitIndex] == aliasName:
            cycleOut = true
            return TypedExprBuildIndexMissing
    add(visitedOwners, parser.ParserOwnedText(aliasOwnerSourcePath))
    add(visitedNames, parser.ParserOwnedText(aliasName))
    targetTypeOut = TypedExprNormalizeTypeText(
        parser.ParserOwnedText(ir.typeDefAliasTargetTypes[rowIndex]))
    if targetTypeOut == "":
        panic("typed expr: alias target payload missing")
    targetOwnerSourcePathOut = aliasOwnerSourcePath
    return TypedExprBuildIndexUnique


@borrows
fn TypedExprIrCanonicalFieldMetaState(
        ir: TypedExprIr,
        ownerSourcePathRaw: str,
        ownerTypeRaw: str,
        fieldNameRaw: str,
        fieldTypeSourcePathOut: var str,
        fieldTypeOut: var str,
        fieldOffsetBytesOut: var int32,
        fieldSizeBytesOut: var int32,
        fieldAlignBytesOut: var int32,
        fieldRowOut: var int32): TypedExprBuildIndexLookupState =
    fieldTypeSourcePathOut = ""
    fieldTypeOut = ""
    fieldOffsetBytesOut = 0
    fieldSizeBytesOut = 0
    fieldAlignBytesOut = 0
    fieldRowOut = -1
    var ownerSourcePath = parser.ParserNormalizePath(ownerSourcePathRaw)
    var ownerType = TypedExprNormalizeTypeText(
        TypedExprStripVarType(ownerTypeRaw))
    let fieldNameText = chengpath.PathTrim(fieldNameRaw)
    let fieldName = parser.ParserIdentPrefix(fieldNameText)
    if ir.buildIndex == nil || ir.buildIndex.released ||
       ownerSourcePath == "" || ownerType == "" ||
       fieldName == "" || fieldName != fieldNameText:
        return TypedExprBuildIndexMissing
    var visitedOwners: str[]
    var visitedNames: str[]
    var strippedRefSurface = false
    while true:
        # 字段行直查必须先于别名跳: decl 头行 (`Name = object` / `Name = ref
        # object`) 经 TypedExprContextProcessTypeDeclLine ->
        # TypedExprMaybeAddTypeDefAlias 也登记别名行, 但目标是形状关键字
        # ("object" / NormalizeTypeText 后的 "refobject"), 不是真实类型。
        # 别名优先会把 owner 劫持到形状关键字上, 本 owner 在 ir_field_source
        # 精确注册的字段行永不可达, RHS field hop 必 miss (structural binary
        # operand did not build 墙)。真实别名 (`Foo = Bar`) 自身没有字段行,
        # 直查落空后才跟别名跳, 与原序在真别名上的行为逐字节一致。
        var rowIndex: int32
        var definingSourcePath = ""
        var fieldState = TypedExprBuildIndexMissing
        let dotPos = TypedExprQualifiedTypeDot(ownerType)
        if dotPos > 0:
            let qualifier = chengpath.PathTrim(
                chengpath.TextSlice(ownerType, 0, dotPos))
            let leaf = chengpath.PathTrim(
                chengpath.TextSlice(ownerType,
                                    dotPos + 1,
                                    ownerType.len - dotPos - 1))
            if qualifier != "" && parser.ParserIdentPrefix(qualifier) == qualifier &&
               leaf != "" && parser.ParserIdentPrefix(leaf) == leaf:
                let importState = TypedExprIrImportAliasTargetState(
                    ir, ownerSourcePath, qualifier, definingSourcePath)
                if importState == TypedExprBuildIndexAmbiguous:
                    return importState
                if importState == TypedExprBuildIndexUnique &&
                   TypedExprTopLevelDeclarationExportedByCase(leaf):
                    fieldState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                           "ir_field_source",
                                                           definingSourcePath,
                                                           leaf,
                                                           fieldName,
                                                           rowIndex)
        else:
            let leaf = parser.ParserIdentPrefix(ownerType)
            if leaf == ownerType:
                fieldState = TypedExprIrVisibleSourceRowState(
                    ir,
                    "ir_field_source",
                    ownerSourcePath,
                    leaf,
                    fieldName,
                    rowIndex,
                    definingSourcePath)
        if fieldState == TypedExprBuildIndexAmbiguous:
            return fieldState
        if fieldState == TypedExprBuildIndexUnique:
            if rowIndex < 0 || rowIndex >= ir.typeFieldTypes.len ||
               rowIndex >= ir.typeFieldOffsetBytes.len ||
               rowIndex >= ir.typeFieldSizeBytes.len ||
               rowIndex >= ir.typeFieldAlignBytes.len:
                panic("typed expr: IR field row out of bounds")
            fieldTypeOut = TypedExprNormalizeTypeText(ir.typeFieldTypes[rowIndex])
            fieldTypeSourcePathOut = parser.ParserNormalizePath(definingSourcePath)
            fieldOffsetBytesOut = ir.typeFieldOffsetBytes[rowIndex]
            fieldSizeBytesOut = ir.typeFieldSizeBytes[rowIndex]
            fieldAlignBytesOut = ir.typeFieldAlignBytes[rowIndex]
            fieldRowOut = rowIndex
            if fieldTypeSourcePathOut == "" || fieldTypeOut == "" || fieldOffsetBytesOut < 0 ||
               fieldSizeBytesOut <= 0 || fieldAlignBytesOut <= 0:
                panic("typed expr: IR field metadata payload invalid")
            return TypedExprBuildIndexUnique
        var aliasOwnerSourcePath = ""
        var aliasTarget = ""
        var aliasCycle = false
        let aliasState = TypedExprIrAliasTarget(ir,
                                                 ownerSourcePath,
                                                 ownerType,
                                                 visitedOwners,
                                                 visitedNames,
                                                 aliasOwnerSourcePath,
                                                 aliasTarget,
                                                 aliasCycle)
        if aliasCycle:
            panic(Fmt"typed expr: IR field owner alias cycle source={ownerSourcePath} type={ownerType}")
        if aliasState == TypedExprBuildIndexAmbiguous:
            return aliasState
        if aliasState == TypedExprBuildIndexUnique:
            ownerSourcePath = aliasOwnerSourcePath
            ownerType = aliasTarget
            continue
        if !strippedRefSurface &&
           parser.ParserStartsWith(ownerType, "ref") && ownerType.len > 3:
            strippedRefSurface = true
            ownerType = chengpath.TextSlice(ownerType,
                                            3,
                                            ownerType.len - 3)
            continue
        return TypedExprBuildIndexMissing


@borrows
fn TypedExprIrCanonicalFieldTypeState(
        ir: TypedExprIr,
        ownerSourcePathRaw: str,
        ownerTypeRaw: str,
        fieldNameRaw: str,
        fieldTypeOut: var str): TypedExprBuildIndexLookupState =
    var fieldOffsetBytes: int32
    var fieldSizeBytes: int32
    var fieldAlignBytes: int32
    var fieldTypeSourcePath: str
    var fieldRow: int32
    return TypedExprIrCanonicalFieldMetaState(ir,
                                               ownerSourcePathRaw,
                                               ownerTypeRaw,
                                               fieldNameRaw,
                                               fieldTypeSourcePath,
                                               fieldTypeOut,
                                               fieldOffsetBytes,
                                               fieldSizeBytes,
                                               fieldAlignBytes,
                                               fieldRow)

@borrows
fn TypedExprIrResolveExactFieldNodeMeta(
        ir: TypedExprIr,
        currentCtx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        ownerSourcePathRaw: str,
        ownerTypeRaw: str,
        fieldNameRaw: str,
        fieldTypeSourcePathOut: var str,
        fieldTypeOut: var str,
        fieldOffsetBytesOut: var int32,
        fieldSizeBytesOut: var int32,
        fieldAlignBytesOut: var int32,
        fieldProducerSourceIndexOut: var int32,
        fieldOwnerDeclarationSourceLocalRowOut: var int32,
        fieldDeclarationSourceLocalRowOut: var int32,
        fieldOrdinalOut: var int32,
        fieldBuiltinKindOut: var int32): bool =
    fieldTypeSourcePathOut = ""
    fieldTypeOut = ""
    fieldOffsetBytesOut = 0
    fieldSizeBytesOut = 0
    fieldAlignBytesOut = 0
    fieldProducerSourceIndexOut = -1
    fieldOwnerDeclarationSourceLocalRowOut = -1
    fieldDeclarationSourceLocalRowOut = -1
    fieldOrdinalOut = -1
    fieldBuiltinKindOut = Int32(TypedExprLayoutBuiltinNone)
    var fieldRow: int32
    let state = TypedExprIrCanonicalFieldMetaState(
        ir,
        share(ownerSourcePathRaw),
        share(ownerTypeRaw),
        share(fieldNameRaw),
        fieldTypeSourcePathOut,
        fieldTypeOut,
        fieldOffsetBytesOut,
        fieldSizeBytesOut,
        fieldAlignBytesOut,
        fieldRow)
    if state == TypedExprBuildIndexUnique:
        if fieldRow < 0 ||
           fieldRow >= ir.typeFieldProducerSourceIndexes.len ||
           fieldRow >=
               ir.typeFieldOwnerDeclarationSourceLocalRows.len ||
           fieldRow >=
               ir.typeFieldDeclarationSourceLocalRows.len ||
           fieldRow >= ir.typeFieldOrdinals.len ||
           fieldRow >= ir.typeFieldBuiltinKinds.len:
            panic("typed expr: exact field producer row unavailable")
        fieldProducerSourceIndexOut =
            ir.typeFieldProducerSourceIndexes[fieldRow]
        fieldOwnerDeclarationSourceLocalRowOut =
            ir.typeFieldOwnerDeclarationSourceLocalRows[fieldRow]
        fieldDeclarationSourceLocalRowOut =
            ir.typeFieldDeclarationSourceLocalRows[fieldRow]
        fieldOrdinalOut = ir.typeFieldOrdinals[fieldRow]
        fieldBuiltinKindOut = ir.typeFieldBuiltinKinds[fieldRow]
        return true
    if state == TypedExprBuildIndexAmbiguous:
        panic(Fmt"typed expr: field node canonical owner ambiguous source={ownerSourcePathRaw} owner={ownerTypeRaw} field={fieldNameRaw}")
    let ownerType = TypedExprNormalizeTypeText(
        TypedExprStripVarType(share(ownerTypeRaw)))
    let builtinOwner = ownerType == "str" || ownerType == "Bytes" ||
                       ownerType == "bytes.Bytes" ||
                       ownerType == "rawbytes.Bytes" ||
                       (ownerType.len >= 2 &&
                        chengpath.TextSlice(share(ownerType),
                                           ownerType.len - 2,
                                           2) == "[]") ||
                       parser.ParserStartsWith(ownerType, "Result[") ||
                       parser.ParserStartsWith(ownerType, "Option[")
    let ownerSourcePath = parser.ParserNormalizePath(share(ownerSourcePathRaw))
    if !builtinOwner || ownerSourcePath == "":
        return false
    var resolved = false
    let ownerContextIndex = TypedExprSourceContextLookup(
        sourceContexts,
        ownerSourcePath)
    if ownerContextIndex == -2:
        panic(Fmt"typed expr: builtin field owner source ambiguous source={ownerSourcePath} owner={ownerType} field={fieldNameRaw}")
    if ownerContextIndex >= 0:
        resolved = TypedExprResolveFieldPathMeta(
            sourceContexts[ownerContextIndex],
            sourceContexts,
            share(ownerType),
            share(fieldNameRaw),
            fieldTypeOut,
            fieldOffsetBytesOut,
            fieldSizeBytesOut,
            fieldAlignBytesOut)
    else:
        resolved = TypedExprResolveFieldPathMeta(
            currentCtx,
            sourceContexts,
            share(ownerType),
            share(fieldNameRaw),
            fieldTypeOut,
            fieldOffsetBytesOut,
            fieldSizeBytesOut,
            fieldAlignBytesOut)
    if !resolved:
        return false
    fieldTypeSourcePathOut = ownerSourcePath
    fieldProducerSourceIndexOut =
        ir.valueExprTransactionProducerSourceIndex
    if fieldProducerSourceIndexOut < 0:
        panic("typed expr: builtin field producer source unavailable")
    if ownerType == "str":
        fieldBuiltinKindOut = Int32(TypedExprLayoutBuiltinStr)
        if fieldNameRaw == "data":
            fieldOrdinalOut = 0
        elif fieldNameRaw == "len":
            fieldOrdinalOut = 1
        elif fieldNameRaw == "storeId" || fieldNameRaw == "store_id":
            fieldOrdinalOut = 2
        elif fieldNameRaw == "flags":
            fieldOrdinalOut = 3
    elif ownerType == "Bytes" || ownerType == "bytes.Bytes" ||
         ownerType == "rawbytes.Bytes":
        fieldBuiltinKindOut = Int32(TypedExprLayoutBuiltinSequence)
        if fieldNameRaw == "data":
            fieldOrdinalOut = 0
        elif fieldNameRaw == "len":
            fieldOrdinalOut = 1
    elif ownerType.len >= 2 &&
         chengpath.TextSlice(share(ownerType), ownerType.len - 2, 2) == "[]":
        fieldBuiltinKindOut = Int32(TypedExprLayoutBuiltinSequence)
        if fieldNameRaw == "len":
            fieldOrdinalOut = 0
        elif fieldNameRaw == "cap":
            fieldOrdinalOut = 1
        elif fieldNameRaw == "buffer":
            fieldOrdinalOut = 2
    elif parser.ParserStartsWith(ownerType, "Option["):
        fieldBuiltinKindOut = Int32(TypedExprLayoutBuiltinOptional)
        if fieldNameRaw == "has":
            fieldOrdinalOut = 0
        elif fieldNameRaw == "value":
            fieldOrdinalOut = 1
    else:
        panic("typed expr: builtin field is outside closed identity domain")
    if fieldOrdinalOut < 0:
        panic("typed expr: builtin field ordinal unavailable")
    return true


@borrows
fn TypedExprIrExactGlobalRowState(
        ir: TypedExprIr,
        sourcePathRaw: str,
        nameRaw: str,
        rowIndexOut: var int32): TypedExprBuildIndexLookupState =
    rowIndexOut = -1
    let sourcePath = parser.ParserNormalizePath(parser.ParserOwnedText(sourcePathRaw))
    let nameText = chengpath.PathTrim(parser.ParserOwnedText(nameRaw))
    let name = parser.ParserIdentPrefix(nameText)
    if ir.buildIndex == nil || ir.buildIndex.released ||
       sourcePath == "" || name == "" || name != nameText:
        return TypedExprBuildIndexMissing
    let state = TypedExprBuildIndexLookup(ir.buildIndex,
                                          "ir_global_source",
                                          sourcePath,
                                          name,
                                          "",
                                          rowIndexOut)
    if state != TypedExprBuildIndexUnique:
        rowIndexOut = -1
        return state
    if rowIndexOut < 0 ||
       rowIndexOut >= ir.globalNames.len ||
       rowIndexOut >= ir.globalSourcePaths.len ||
       rowIndexOut >= ir.globalTypes.len:
        panic("typed expr: exact global row out of bounds")
    if ir.globalNames[rowIndexOut] != name ||
       parser.ParserNormalizePath(ir.globalSourcePaths[rowIndexOut]) != sourcePath:
        panic("typed expr: exact global row payload mismatch")
    return TypedExprBuildIndexUnique


fn TypedExprIrVisibleGlobalTypeState(
        ir: var TypedExprIr,
        sourcePathRaw: str,
        nameRaw: str,
        typeOut: var str): TypedExprBuildIndexLookupState =
    typeOut = ""
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let nameText = chengpath.PathTrim(nameRaw)
    let name = parser.ParserIdentPrefix(nameText)
    if sourcePath == "" || name == "" || name != nameText:
        return TypedExprBuildIndexMissing
    var rowIndex: int32
    var definingSourcePath = ""
    let state = TypedExprIrVisibleSourceRowState(ir,
                                                  "ir_global_source",
                                                  sourcePath,
                                                  name,
                                                  "",
                                                  rowIndex,
                                                  definingSourcePath)
    if state != TypedExprBuildIndexUnique:
        return state
    if rowIndex < 0 || rowIndex >= ir.globalTypes.len:
        panic("typed expr: global type row out of bounds")
    typeOut = TypedExprNormalizeTypeText(ir.globalTypes[rowIndex])
    if typeOut == "":
        panic("typed expr: global type payload missing")
    return TypedExprBuildIndexUnique


fn TypedExprIrQualifiedGlobalTypeState(
        ir: var TypedExprIr,
        sourcePathRaw: str,
        qualifiedNameRaw: str,
        ownerSourcePathOut: var str,
        typeOut: var str,
        visibilityDeniedOut: var bool): TypedExprBuildIndexLookupState =
    ownerSourcePathOut = ""
    typeOut = ""
    visibilityDeniedOut = false
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let qualifiedName = chengpath.PathTrim(qualifiedNameRaw)
    let dotPos = TypedExprQualifiedCallDot(qualifiedName)
    if sourcePath == "" || dotPos <= 0 || dotPos + 1 >= qualifiedName.len:
        return TypedExprBuildIndexMissing
    let qualifier = chengpath.PathTrim(
        chengpath.TextSlice(qualifiedName, 0, dotPos))
    let name = chengpath.PathTrim(
        chengpath.TextSlice(qualifiedName,
                            dotPos + 1,
                            qualifiedName.len - dotPos - 1))
    if qualifier == "" || parser.ParserIdentPrefix(qualifier) != qualifier ||
       name == "" || parser.ParserIdentPrefix(name) != name:
        return TypedExprBuildIndexMissing
    let importState = TypedExprIrImportAliasTargetState(ir,
                                                         sourcePath,
                                                         qualifier,
                                                         ownerSourcePathOut)
    if importState != TypedExprBuildIndexUnique:
        ownerSourcePathOut = ""
        return importState
    var rowIndex: int32
    let state = TypedExprBuildIndexLookup(ir.buildIndex,
                                          "ir_global_source",
                                          ownerSourcePathOut,
                                          name,
                                          "",
                                          rowIndex)
    if state != TypedExprBuildIndexUnique:
        ownerSourcePathOut = ""
        return state
    if !TypedExprTopLevelDeclarationExportedByCase(name):
        visibilityDeniedOut = true
        ownerSourcePathOut = ""
        return TypedExprBuildIndexMissing
    if rowIndex < 0 || rowIndex >= ir.globalTypes.len:
        panic("typed expr: qualified global type row out of bounds")
    typeOut = TypedExprNormalizeTypeText(ir.globalTypes[rowIndex])
    if typeOut == "":
        panic("typed expr: qualified global type payload missing")
    return TypedExprBuildIndexUnique


@borrows
fn TypedExprPathTrimStart(text: str): int32 =
    var start: int32
    while start < text.len:
        let code = Int32(text[start])
        if code != 32 && code != 9 && code != 10 && code != 13:
            break
        start = start + 1
    return start

@borrows
fn TypedExprPathTrimStop(text: str,
                          start: int32): int32 =
    var stop = text.len
    while stop > start:
        let code = Int32(text[stop - 1])
        if code != 32 && code != 9 && code != 10 && code != 13:
            break
        stop = stop - 1
    return stop

@borrows
fn TypedExprPathNormalizedStop(text: str,
                                start: int32,
                                stopRaw: int32): int32 =
    var stop = stopRaw
    while stop > start + 1:
        let last = text[stop - 1]
        if last != '/' && last != '\\':
            break
        stop = stop - 1
    return stop

@borrows
fn TypedExprPathNormalizedEquals(left: str,
                                  right: str): bool =
    let leftStart = TypedExprPathTrimStart(left)
    let rightStart = TypedExprPathTrimStart(right)
    let leftStop = TypedExprPathNormalizedStop(left, leftStart, TypedExprPathTrimStop(left, leftStart))
    let rightStop = TypedExprPathNormalizedStop(right, rightStart, TypedExprPathTrimStop(right, rightStart))
    let leftLen = leftStop - leftStart
    let rightLen = rightStop - rightStart
    if leftLen != rightLen:
        return false
    for i in 0..<leftLen:
        if left[leftStart + i] != right[rightStart + i]:
            return false
    return true

fn TypedExprMaybeQualifyImportedFieldType(importedCtx: var TypedExprSourceContext,
                                           qualifier: str,
                                           fieldTypeRaw: str): str =
    let fieldType = TypedExprNormalizeTypeText(fieldTypeRaw)
    if qualifier == "" || fieldType == "":
        return fieldType
    if TypedExprQualifiedTypeDot(fieldType) > 0:
        return fieldType
    if TypedExprSourceHasDeclaredType(importedCtx, fieldType):
        return Fmt"{qualifier}.{fieldType}"
    return fieldType

@borrows
fn TypedExprIrAppendTypeLayoutsFromContext(ir: var TypedExprIr,
                                            ctx: TypedExprSourceContext,
                                            sourceContexts: var TypedExprSourceContext[]) =
    typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
        ir, sourceContexts)
    if ctx.declaredTypes.len !=
           ctx.declaredTypeProducerSourceIndexes.len ||
       ctx.declaredTypes.len !=
           ctx.declaredTypeDeclarationSourceLocalRows.len ||
       ctx.declaredTypes.len != ctx.declaredTypeBuiltinKinds.len:
        panic("typed expr: declared type exact coordinate columns split")
    for importIndex in 0..<ctx.importedModules.len:
        let qualifier = ctx.importedModules[importIndex].qualifier
        let targetSourcePath = ctx.importedModules[importIndex].targetSourcePath
        if qualifier == "" || targetSourcePath == "":
            continue
        TypedExprIrAppendTypeAlias(ir,
                                   share(ctx.sourcePath),
                                   share(qualifier),
                                   share(targetSourcePath))
    for i in 0..<ctx.declaredTypes.len:
        let typeName = ctx.declaredTypes[i]
        let producerSourceIndex =
            ctx.declaredTypeProducerSourceIndexes[i]
        let declarationSourceLocalRow =
            ctx.declaredTypeDeclarationSourceLocalRows[i]
        let builtinRaw = ctx.declaredTypeBuiltinKinds[i]
        if builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(TypedExprLayoutBuiltinOptional):
            panic("typed expr: declared layout builtin kind invalid")
        let builtinKind = TypedExprLayoutBuiltinKind(
            builtinRaw)
        var exactDeclarationIndex: int32 = -1
        var exactAuthorityState: int32
        if builtinKind == TypedExprLayoutBuiltinNone:
            exactDeclarationIndex =
                typedExprIrExactDeclarationIndex(
                    ir,
                    producerSourceIndex,
                    declarationSourceLocalRow)
            if exactDeclarationIndex < 0:
                panic("typed expr: declared layout authority coordinate missing")
            exactAuthorityState =
                ir.exactLayoutDeclarationAuthorityStates[
                    exactDeclarationIndex]
            if exactAuthorityState == 1:
                if ir.exactLayoutTypeDeclarationRows[
                       exactDeclarationIndex] != -1 ||
                   ir.exactLayoutDeclarationTypeArenaIds[
                       exactDeclarationIndex] < 0:
                    panic("typed expr: absent generic declaration layout authority drift")
                continue
            if exactAuthorityState != 2 ||
               ir.exactLayoutDeclarationTypeArenaIds[
                   exactDeclarationIndex] < 0 ||
               ir.exactLayoutDeclarationGenericSymbolCounts[
                   exactDeclarationIndex] != 0 ||
               ir.exactLayoutDeclarationSizeBytes[
                   exactDeclarationIndex] <= 0 ||
               ir.exactLayoutDeclarationAlignBytes[
                   exactDeclarationIndex] <= 0:
                panic("typed expr: concrete declaration layout authority missing")
        let exactLayoutRow = typedExprIrExactTypeLayoutRow(
            ir,
            producerSourceIndex,
            declarationSourceLocalRow,
            builtinKind)
        if exactLayoutRow >= 0 &&
           typedExprIrExactTypeOwnerHasField(
               ir,
               producerSourceIndex,
               declarationSourceLocalRow,
               builtinKind):
            continue
        if TypedExprIrAppendObjectTypeLayoutFromContext(
               ir,
               ctx,
               sourceContexts,
               typeName,
               producerSourceIndex,
               declarationSourceLocalRow,
               builtinKind):
            continue
        if exactLayoutRow >= 0:
            continue
        var sizeBytes: int32
        var alignBytes: int32
        let fieldCount = TypedExprContextFieldCountForType(ctx, typeName)
        if builtinKind == TypedExprLayoutBuiltinNone:
            sizeBytes =
                ir.exactLayoutDeclarationSizeBytes[
                    exactDeclarationIndex]
            alignBytes =
                ir.exactLayoutDeclarationAlignBytes[
                    exactDeclarationIndex]
        elif !TypedExprTypeLayout(
                   ctx,
                   sourceContexts,
                   typeName,
                   sizeBytes,
                   alignBytes):
            continue
        if sizeBytes > 0 && alignBytes > 0:
            TypedExprIrAppendTypeLayout(ir,
                                        share(ctx.sourcePath),
                                        share(typeName),
                                        sizeBytes,
                                        alignBytes,
                                        fieldCount,
                                        producerSourceIndex,
                                        declarationSourceLocalRow,
                                        builtinKind)

fn TypedExprIrAppendEnumValuesFromContext(ir: var TypedExprIr,
                                           ctx: var TypedExprSourceContext) =
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    for i in 0..<ctx.enumValueNames.len:
        if i >= ctx.enumValueTypes.len || i >= ctx.enumValueOrdinals.len:
            continue
        let name = ctx.enumValueNames[i]
        let typeName = ctx.enumValueTypes[i]
        if name == "" || typeName == "":
            continue
        var existingIndex: int32
        let existingState = TypedExprBuildIndexLookup(ir.buildIndex, "ir_enum_name_source", sourcePath, name, "", existingIndex)
        if existingState == TypedExprBuildIndexUnique:
            TypedExprBuildIndexRegisterIrEnum(ir, sourcePath, name, typeName, existingIndex, ctx.enumValueOrdinals[i])
            continue
        if existingState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: ambiguous source enum value source={sourcePath} name={name}")
        let rowIndex = ir.enumValueNames.len
        TypedExprBuildIndexRegisterIrEnum(ir, sourcePath, name, typeName, rowIndex, ctx.enumValueOrdinals[i])
        add(ir.enumValueSourcePaths, share(sourcePath))
        add(ir.enumValueNames, share(name))
        add(ir.enumValueTypes, share(typeName))
        add(ir.enumValueOrdinals, ctx.enumValueOrdinals[i])

# Mirror the per-source ref-object type leaf names into the IR, so the
# backend type-shape resolver (IR-only access) can classify `Name = ref`
# types as 8-byte pointers instead of inlining the ref's pointee struct.
@borrows
fn TypedExprIrAppendRefTypesFromContext(ir: var TypedExprIr,
                                         ctx: TypedExprSourceContext) =
    let ctxSourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    for i in 0..<ctx.refTypes.len:
        let typeName = ctx.refTypes[i]
        if typeName == "":
            continue
        var existingIndex: int32
        let existingState = TypedExprBuildIndexLookup(ir.buildIndex, "ir_ref_source", ctxSourcePath, typeName, "", existingIndex)
        if existingState == TypedExprBuildIndexUnique:
            continue
        if existingState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: ambiguous source ref type source={ctxSourcePath} type={typeName}")
        let rowIndex = ir.refObjectTypeNames.len
        TypedExprBuildIndexRegisterIrRef(ir, ctxSourcePath, typeName, rowIndex)
        add(ir.refObjectSourcePaths, share(ctxSourcePath))
        add(ir.refObjectTypeNames, share(typeName))

type
    TypedExprRefTypeCols =
        sourcePaths: str[]
        typeNames: str[]

    TypedExprTypeDefAliasCols =
        sourcePaths: str[]
        names: str[]
        targetTypes: str[]

@borrows
fn TypedExprIrAppendRefTypesFromContextOwned(sourcePaths: str[],
                                              typeNames: str[],
                                              buildIndex: TypedExprBuildIndex,
                                              ctx: TypedExprSourceContext): TypedExprRefTypeCols =
    var out: TypedExprRefTypeCols
    out.sourcePaths = TypedExprCloneStrSeq(sourcePaths)
    out.typeNames = TypedExprCloneStrSeq(typeNames)
    let ctxSourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    for i in 0..<ctx.refTypes.len:
        let typeName = ctx.refTypes[i]
        if typeName == "":
            continue
        var existingIndex: int32
        let existingState = TypedExprBuildIndexLookup(buildIndex, "ir_ref_source", ctxSourcePath, typeName, "", existingIndex)
        if existingState == TypedExprBuildIndexUnique:
            continue
        if existingState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: ambiguous source ref type source={ctxSourcePath} type={typeName}")
        let rowIndex = out.typeNames.len
        TypedExprBuildIndexRegister(buildIndex, "ir_ref_source", ctxSourcePath, typeName, "", rowIndex, ctxSourcePath, typeName, true)
        TypedExprBuildIndexRegister(buildIndex, "ir_ref_global", "", typeName, "", rowIndex, ctxSourcePath, typeName, false)
        add(out.sourcePaths, strings.CloneStr(ctxSourcePath))
        add(out.typeNames, strings.CloneStr(typeName))
    return out

@borrows
fn TypedExprIrAppendTypeDefAliasesFromContextOwned(sourcePaths: str[],
                                                    names: str[],
                                                    targetTypes: str[],
                                                    buildIndex: TypedExprBuildIndex,
                                                    ctx: TypedExprSourceContext): TypedExprTypeDefAliasCols =
    var out: TypedExprTypeDefAliasCols
    out.sourcePaths = TypedExprCloneStrSeq(sourcePaths)
    out.names = TypedExprCloneStrSeq(names)
    out.targetTypes = TypedExprCloneStrSeq(targetTypes)
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    if sourcePath == "":
        return out
    for i in 0..<ctx.typeDefAliasNames.len:
        if i >= ctx.typeDefAliasTargetTypes.len:
            continue
        let aliasName = parser.ParserIdentPrefix(chengpath.PathTrim(ctx.typeDefAliasNames[i]))
        let targetType = TypedExprNormalizeTypeText(ctx.typeDefAliasTargetTypes[i])
        if aliasName == "" || targetType == "":
            continue
        var existingIndex: int32
        let existingState = TypedExprBuildIndexLookup(buildIndex, "ir_alias_def_source", sourcePath, aliasName, "", existingIndex)
        if existingState == TypedExprBuildIndexUnique:
            TypedExprBuildIndexRegister(buildIndex, "ir_alias_def_source", sourcePath, aliasName, "", existingIndex, sourcePath, targetType, true)
            TypedExprBuildIndexRegister(buildIndex, "ir_alias_def_global", "", aliasName, "", existingIndex, sourcePath, targetType, false)
            continue
        if existingState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: ambiguous source type alias source={sourcePath} alias={aliasName}")
        let rowIndex = out.names.len
        TypedExprBuildIndexRegister(buildIndex, "ir_alias_def_source", sourcePath, aliasName, "", rowIndex, sourcePath, targetType, true)
        TypedExprBuildIndexRegister(buildIndex, "ir_alias_def_global", "", aliasName, "", rowIndex, sourcePath, targetType, false)
        add(out.sourcePaths, strings.CloneStr(sourcePath))
        add(out.names, aliasName)
        add(out.targetTypes, targetType)
    return out

# IR-level ref-object query. For a qualified name (`atomic.I32`) the
# qualifier is resolved to its owning source via the type-alias map (same
# path TypedExprIrLookupTypeLayout uses) and the leaf is matched there. For
# an unqualified name the leaf must resolve to a single unambiguous owning
# source, optionally pinned to the caller's sourcePath.
@borrows
fn TypedExprIrRefRegisteredAt(ir: TypedExprIr,
                               targetSourcePathRaw: str,
                               leafName: str): bool =
    let targetSourcePath = parser.ParserNormalizePath(targetSourcePathRaw)
    if targetSourcePath == "" || leafName == "":
        return false
    var rowIndex: int32
    return TypedExprBuildIndexLookup(ir.buildIndex,
                                     "ir_ref_source", targetSourcePath, leafName, "", rowIndex) == TypedExprBuildIndexUnique

@borrows
fn TypedExprIrTypeIsRef(ir: TypedExprIr,
                         sourcePathRaw: str,
                         typeRaw: str): bool =
    # The @borrow_result metadata forward requires the pristine incoming var
    # root; the lookup calls below re-seat it.  The index depends only on ir,
    # so bind it before any other var-boundary call in this body.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let fullTypeName = TypedExprStripVarType(typeRaw)
    let leafName = TypedExprTypeLeafName(fullTypeName)
    if leafName == "":
        return false
    let qualifiedDotPos = TypedExprQualifiedTypeDot(fullTypeName)
    if qualifiedDotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(fullTypeName, 0, qualifiedDotPos))
        let targetSourcePath = TypedExprIrLookupTypeAliasTargetSourcePath(ir,
                                                                          sourcePath,
                                                                          qualifier)
        if targetSourcePath != "":
            return TypedExprIrRefRegisteredAt(ir, targetSourcePath, leafName)
        # Qualifier did not resolve through the import map; fall through to
        # the unambiguous-leaf scan below rather than guessing.
    if sourcePath != "":
        if TypedExprIrRefRegisteredAt(ir, sourcePath, leafName):
            return true
        var targetSourcePath: str
        let visibleState = TypedExprBuildIndexVisibleContextSourcePath(
                                                                       canonicalMetadataIndex,
                                                                       "ctx_import_ref",
                                                                       sourcePath,
                                                                       leafName,
                                                                       "",
                                                                       targetSourcePath)
        if visibleState != TypedExprBuildIndexUnique:
            return false
        return TypedExprIrRefRegisteredAt(ir, targetSourcePath, leafName)
    var rowIndex: int32
    return TypedExprBuildIndexLookup(ir.buildIndex,
                                     "ir_ref_global", "", leafName, "", rowIndex) == TypedExprBuildIndexUnique

@borrows
fn TypedExprIrLookupEnumConstValue(ir: TypedExprIr,
                                    sourcePathRaw: str,
                                    nameRaw: str,
                                    typeNameOut: var str,
                                    valueOut: var int32): bool =
    # Bind the immutable metadata index before the visibility lookup chain.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    typeNameOut = ""
    valueOut = 0
    let sourcePath = parser.ParserNormalizePath(parser.ParserOwnedText(sourcePathRaw))
    let nameText = chengpath.PathTrim(parser.ParserOwnedText(nameRaw))
    # Only plain (possibly qualified) identifiers may resolve as enum
    # constants. The last-dot name extraction below would otherwise collapse
    # whole call expressions containing a dotted enum value into a constant.
    if !TypedExprCallHeadIsPlainQualifiedIdent(share(nameText)):
        return false
    var nameStart: int32
    for ci in 0..<nameText.len:
        if nameText[ci] == '.':
            nameStart = ci + 1
    let name = parser.ParserIdentPrefix(chengpath.TextSlice(nameText,
                                                            nameStart,
                                                            nameText.len - nameStart))
    if name == "":
        return false
    var foundIndex: int32
    if sourcePath != "":
        let sourceState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_enum_name_source", sourcePath, name, "", foundIndex)
        if sourceState == TypedExprBuildIndexAmbiguous:
            return false
        if sourceState == TypedExprBuildIndexUnique:
            if foundIndex < 0 || foundIndex >= ir.enumValueTypes.len || foundIndex >= ir.enumValueOrdinals.len:
                return false
            typeNameOut = parser.ParserOwnedText(ir.enumValueTypes[foundIndex])
            valueOut = ir.enumValueOrdinals[foundIndex]
            return true
        var targetSourcePath: str
        let visibleState = TypedExprBuildIndexVisibleContextSourcePath(
                                                                       canonicalMetadataIndex,
                                                                       "ctx_import_enum_name_type",
                                                                       sourcePath,
                                                                       name,
                                                                       "",
                                                                       targetSourcePath)
        if visibleState != TypedExprBuildIndexUnique:
            return false
        let targetState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_enum_name_source",
                                                     targetSourcePath,
                                                     name,
                                                     "",
                                                     foundIndex)
        if targetState != TypedExprBuildIndexUnique ||
           foundIndex < 0 || foundIndex >= ir.enumValueTypes.len ||
           foundIndex >= ir.enumValueOrdinals.len:
            return false
        typeNameOut = parser.ParserOwnedText(ir.enumValueTypes[foundIndex])
        valueOut = ir.enumValueOrdinals[foundIndex]
        return true
    let globalState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                 "ir_enum_name_global", "", name, "", foundIndex)
    if globalState != TypedExprBuildIndexUnique ||
       foundIndex < 0 || foundIndex >= ir.enumValueTypes.len || foundIndex >= ir.enumValueOrdinals.len:
        return false
    typeNameOut = parser.ParserOwnedText(ir.enumValueTypes[foundIndex])
    valueOut = ir.enumValueOrdinals[foundIndex]
    return true

@borrows
fn TypedExprIrTypeIsEnum(ir: TypedExprIr,
                          sourcePathRaw: str,
                          typeRaw: str): bool =
    # The @borrow_result metadata forward requires the pristine incoming var
    # root; later var-boundary calls in this body re-seat it.  The index
    # depends only on ir, so bind it first.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    let sourcePath = parser.ParserNormalizePath(parser.ParserOwnedText(sourcePathRaw))
    let typeName = TypedExprStripVarType(parser.ParserOwnedText(typeRaw))
    let leafName = TypedExprTypeLeafName(typeName)
    if typeName == "" || leafName == "":
        return false
    var rowIndex: int32
    if sourcePath != "":
        let sourceState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_enum_type_source", sourcePath, typeName, "", rowIndex)
        if sourceState == TypedExprBuildIndexUnique:
            return true
        if sourceState == TypedExprBuildIndexAmbiguous:
            return false
        if leafName != typeName:
            let leafState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                       "ir_enum_type_source", sourcePath, leafName, "", rowIndex)
            if leafState == TypedExprBuildIndexUnique:
                return true
            if leafState == TypedExprBuildIndexAmbiguous:
                return false
        var targetSourcePath: str
        let visibleState = TypedExprBuildIndexVisibleContextSourcePath(
                                                                       canonicalMetadataIndex,
                                                                       "ctx_import_enum_type",
                                                                       sourcePath,
                                                                       leafName,
                                                                       "",
                                                                       targetSourcePath)
        if visibleState != TypedExprBuildIndexUnique:
            return false
        return TypedExprBuildIndexLookup(ir.buildIndex,
                                         "ir_enum_type_source",
                                         targetSourcePath,
                                         leafName,
                                         "",
                                         rowIndex) == TypedExprBuildIndexUnique
    let globalState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                 "ir_enum_type_global", "", leafName, "", rowIndex)
    return globalState == TypedExprBuildIndexUnique

@borrows
fn TypedExprIrBuiltinTypeLayout(typeRaw: str,
                                 sizeBytes: var int32,
                                 alignBytes: var int32,
                                 fieldCount: var int32): bool =
    sizeBytes = 0
    alignBytes = 0
    fieldCount = 0
    let typeText = TypedExprStripVarType(typeRaw)
    if typeText.len >= 2 && chengpath.TextSlice(typeText, typeText.len - 2, 2) == "[]":
        sizeBytes = 16
        alignBytes = 8
        fieldCount = 3
        return true
    if parser.ParserStartsWith(typeText, "seq[") ||
       parser.ParserStartsWith(typeText, "array["):
        sizeBytes = 16
        alignBytes = 8
        fieldCount = 3
        return true
    if typeText == "str":
        sizeBytes = 24
        alignBytes = 8
        fieldCount = 4
        return true
    if typeText == "Bytes" || typeText == "bytes.Bytes" || typeText == "rawbytes.Bytes":
        sizeBytes = 16
        alignBytes = 8
        fieldCount = 2
        return true
    if typeText == "FixedBytes32" || typeText == "layout.FixedBytes32" || typeText == "bytes_layout.FixedBytes32":
        sizeBytes = 32
        alignBytes = 1
        fieldCount = 1
        return true
    if typeText == "FixedBytes64" || typeText == "layout.FixedBytes64" || typeText == "bytes_layout.FixedBytes64":
        sizeBytes = 64
        alignBytes = 1
        fieldCount = 1
        return true
    if typeText == "FixedBytes65" || typeText == "layout.FixedBytes65" || typeText == "bytes_layout.FixedBytes65":
        sizeBytes = 65
        alignBytes = 1
        fieldCount = 1
        return true
    if typeText == "ErrorInfo":
        sizeBytes = 32
        alignBytes = 8
        fieldCount = 2
        return true
    return false

@borrows
fn TypedExprIrLookupTypeLayoutRow(ir: TypedExprIr,
                                   sourcePath: str,
                                   typeName: str): int32 =
    # The @borrow_result metadata forward requires the pristine incoming var
    # root; later var-boundary calls in this body re-seat it.  The index
    # depends only on ir, so bind it first.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    var rowIndex: int32
    if sourcePath != "":
        let sourceState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_layout_source", sourcePath, typeName, "", rowIndex)
        if sourceState == TypedExprBuildIndexAmbiguous:
            return -2
        if sourceState == TypedExprBuildIndexUnique:
            return rowIndex
        var targetSourcePath: str
        let visibleState = TypedExprBuildIndexVisibleContextSourcePath(
                                                                       canonicalMetadataIndex,
                                                                       "ctx_import_composite",
                                                                       sourcePath,
                                                                       TypedExprTypeLeafName(typeName),
                                                                       "",
                                                                       targetSourcePath)
        if visibleState == TypedExprBuildIndexAmbiguous:
            return -2
        if visibleState != TypedExprBuildIndexUnique:
            return -1
        let targetState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_layout_source",
                                                     targetSourcePath,
                                                     typeName,
                                                     "",
                                                     rowIndex)
        if targetState == TypedExprBuildIndexAmbiguous:
            return -2
        if targetState == TypedExprBuildIndexUnique:
            return rowIndex
        return -1
    # An absent lexical owner cannot prove a unique type identity. Global rows
    # are diagnostic indexes only and must never recover an unowned query.
    return -1

# Registry 的 whole-type layout 条目是 dedup-suppress(TypedExprIrAppendTypeLayout):
# 一旦 (sourcePath,typeName) 有条目就不再覆盖,即便首写携带了退化 size(跨模块聚合在
# prescan fallback / 外层 struct 嵌入预注册时,字段表未就绪→size 退化为 4/8)。
# 但逐字段行 ir.typeField*(由 AppendObjectTypeLayoutFromContext 无条件写入)携带正确
# offset/size/align。本 fn 从字段行重算 whole-type size,仅当字段表完整(seen==注册
# fieldCount)且重算值严格大于注册值(即可证退化)时覆写。健康类型 recomputed==registered
# → 不覆写;字段表残缺 seen!=fieldCount → 不覆写。最坏精确 no-op,绝不回归。
@borrows
fn TypedExprIrRecomputeTypeLayoutFromFields(ir: TypedExprIr,
                                             ownerSourcePath: str,
                                             ownerTypeName: str,
                                             registeredSizeBytes: int32,
                                             registeredFieldCount: int32,
                                             sizeBytes: var int32,
                                             alignBytes: var int32): bool =
    sizeBytes = registeredSizeBytes
    alignBytes = 0
    let ownerLeaf = TypedExprTypeLeafName(ownerTypeName)
    if ownerLeaf == "" || registeredFieldCount <= 0:
        return false
    var tailByte: int32
    var maxAlign: int32
    var seen: int32
    var fieldIndex = TypedExprBuildIndexFieldOwnerHead(ir.buildIndex,
                                                       parser.ParserNormalizePath(ownerSourcePath),
                                                       ownerLeaf)
    while fieldIndex >= 0:
        if fieldIndex >= ir.typeFieldOffsetBytes.len ||
           fieldIndex >= ir.typeFieldSizeBytes.len ||
           fieldIndex >= ir.typeFieldAlignBytes.len ||
           fieldIndex >= ir.buildIndex.fieldRowNext.len:
            return false
        let endByte = ir.typeFieldOffsetBytes[fieldIndex] + ir.typeFieldSizeBytes[fieldIndex]
        if endByte > tailByte:
            tailByte = endByte
        if ir.typeFieldAlignBytes[fieldIndex] > maxAlign:
            maxAlign = ir.typeFieldAlignBytes[fieldIndex]
        seen = seen + 1
        fieldIndex = ir.buildIndex.fieldRowNext[fieldIndex]
    if seen != registeredFieldCount || maxAlign <= 0:
        return false
    let recomputed = TypedExprAlignBytes(tailByte, maxAlign)
    if recomputed <= registeredSizeBytes:
        return false
    sizeBytes = recomputed
    alignBytes = maxAlign
    return true

fn TypedExprIrFixedArrayTypePartsFromIndex(ir: var TypedExprIr,
                                            ownerSourcePathRaw: str,
                                            typeRaw: str,
                                            elemType: var str,
                                            length: var int32): bool =
    elemType = ""
    length = 0
    if ir.buildIndex == nil || ir.buildIndex.released:
        panic("typed expr: fixed-array query on unavailable build index")
    let typeText = TypedExprNormalizeTypeText(TypedExprStripVarType(typeRaw))
    if typeText.len <= 3 || typeText[typeText.len - 1] != ']':
        return false
    let openPos = TypedExprCallTrailingBracketOpen(typeText)
    if openPos <= 0 || openPos + 1 >= typeText.len - 1:
        return false
    let elemText = chengpath.PathTrim(chengpath.TextSlice(typeText,
                                                          0,
                                                          openPos))
    let dimText = chengpath.PathTrim(chengpath.TextSlice(typeText,
                                                         openPos + 1,
                                                         typeText.len - openPos - 2))
    if elemText == "" || dimText == "":
        return false
    var visitedOwners: str[]
    var visitedNames: str[]
    var recognized = false
    var dimValue: int64
    if !TypedExprIrCallConstIntValue(ir,
                                     ownerSourcePathRaw,
                                     dimText,
                                     visitedOwners,
                                     visitedNames,
                                     recognized,
                                     dimValue):
        if recognized:
            panic(Fmt"typed expr: fixed-array dimension invalid or cyclic source={ownerSourcePathRaw} type={typeText} dimension={dimText}")
        return false
    if !recognized || dimValue <= 0 || dimValue > Int64(2147483647):
        panic(Fmt"typed expr: fixed-array dimension outside int32 range source={ownerSourcePathRaw} type={typeText} dimension={dimText} value={dimValue}")
    elemType = elemText
    length = int32(dimValue)
    return true


@borrows
fn TypedExprIrLookupTypeLayout(ir: TypedExprIr,
                                sourcePathRaw: str,
                                typeRaw: str,
                                sizeBytes: var int32,
                                alignBytes: var int32,
                                fieldCount: var int32): bool =
    if TypedExprIrBuiltinTypeLayout(typeRaw, sizeBytes, alignBytes, fieldCount):
        return true
    let normalizedType = TypedExprStripVarType(typeRaw)
    var fixedArrayElemType = ""
    var fixedArrayLen: int32
    # Build a lightweight const-scan context anchored at the type's defining module
    # path. The const literal resolver reads the module's const block from this path
    # (loading the file when `lines` is empty), so symbolic fixed-array lengths such
    # as `uint8[fixedBytes32Size]` resolve to their declared decimal value here too.
    var constCtx: TypedExprSourceContext
    TypedExprSourceContextSetBorrowedBuildIndex(constCtx, ir.buildIndex)
    constCtx.sourcePath = share(sourcePathRaw)
    if TypedExprIrFixedArrayTypeParts(constCtx, normalizedType, fixedArrayElemType, fixedArrayLen):
        var elemSize: int32
        var elemAlign: int32
        var elemFieldCount: int32
        if !TypedExprIrLookupTypeLayout(ir,
                                        sourcePathRaw,
                                        fixedArrayElemType,
                                        elemSize,
                                        elemAlign,
                                        elemFieldCount):
            return false
        if elemAlign <= 0:
            return false
        sizeBytes = elemSize * fixedArrayLen
        alignBytes = elemAlign
        fieldCount = 0
        return true
    if parser.ParserStartsWith(normalizedType, "Result[") &&
       normalizedType.len > 8 &&
       chengpath.TextSlice(normalizedType, normalizedType.len - 1, 1) == "]":
        let inner = chengpath.TextSlice(normalizedType, 7, normalizedType.len - 8)
        var valueSize: int32
        var valueAlign: int32
        var valueFieldCount: int32
        if !TypedExprIrLookupTypeLayout(ir,
                                        sourcePathRaw,
                                        inner,
                                        valueSize,
                                        valueAlign,
                                        valueFieldCount):
            return false
        var errSize: int32
        var errAlign: int32
        var errFieldCount: int32
        if !TypedExprIrLookupTypeLayout(ir,
                                        sourcePathRaw,
                                        "ErrorInfo",
                                        errSize,
                                        errAlign,
                                        errFieldCount):
            return false
        let valueOffset = TypedExprAlignBytes(1, valueAlign)
        let errOffset = TypedExprAlignBytes(valueOffset + valueSize, errAlign)
        alignBytes = valueAlign
        if errAlign > alignBytes:
            alignBytes = errAlign
        if alignBytes <= 0:
            alignBytes = 1
        sizeBytes = TypedExprAlignBytes(errOffset + errSize, alignBytes)
        fieldCount = 3
        return true
    sizeBytes = 0
    alignBytes = 0
    fieldCount = 0
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let fullTypeName = TypedExprStripVarType(typeRaw)
    let qualifiedDotPos = TypedExprQualifiedTypeDot(fullTypeName)
    if qualifiedDotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(fullTypeName, 0, qualifiedDotPos))
        let leafName = chengpath.PathTrim(chengpath.TextSlice(fullTypeName,
                                                               qualifiedDotPos + 1,
                                                               fullTypeName.len - qualifiedDotPos - 1))
        let targetSourcePath = TypedExprIrLookupTypeAliasTargetSourcePath(ir,
                                                                          sourcePath,
                                                                          qualifier)
        if targetSourcePath != "" && leafName != "":
            return TypedExprIrLookupTypeLayout(ir,
                                               targetSourcePath,
                                               leafName,
                                               sizeBytes,
                                               alignBytes,
                                               fieldCount)
    var typeName = share(fullTypeName)
    if typeName == "":
        return false
    var foundIndex = TypedExprIrLookupTypeLayoutRow(ir, sourcePath, typeName)
    if foundIndex >= 0 &&
       foundIndex < ir.typeLayoutSizeBytes.len &&
       foundIndex < ir.typeLayoutAlignBytes.len &&
       foundIndex < ir.typeLayoutFieldCounts.len &&
       foundIndex < ir.typeLayoutSourcePaths.len &&
       foundIndex < ir.typeLayoutNames.len:
        sizeBytes = ir.typeLayoutSizeBytes[foundIndex]
        alignBytes = ir.typeLayoutAlignBytes[foundIndex]
        fieldCount = ir.typeLayoutFieldCounts[foundIndex]
        if sizeBytes > 0 && alignBytes > 0:
            # 跨模块聚合 prescan 退化 size 校正:从逐字段行重算 whole-size,仅当字段表
            # 完整且重算值严格大于注册值(可证退化)时覆写。健康类型 no-op 不回归。
            var verifiedSize: int32
            var verifiedAlign: int32
            if TypedExprIrRecomputeTypeLayoutFromFields(ir,
                                                       ir.typeLayoutSourcePaths[foundIndex],
                                                       ir.typeLayoutNames[foundIndex],
                                                       sizeBytes,
                                                       fieldCount,
                                                       verifiedSize,
                                                       verifiedAlign):
                sizeBytes = verifiedSize
                if verifiedAlign > 0:
                    alignBytes = verifiedAlign
            return true
    typeName = TypedExprTypeLeafName(typeRaw)
    if typeName == "" || typeName == fullTypeName:
        return false
    foundIndex = TypedExprIrLookupTypeLayoutRow(ir, sourcePath, typeName)
    if foundIndex < 0 ||
       foundIndex >= ir.typeLayoutSizeBytes.len ||
       foundIndex >= ir.typeLayoutAlignBytes.len ||
       foundIndex >= ir.typeLayoutFieldCounts.len:
        return false
    sizeBytes = ir.typeLayoutSizeBytes[foundIndex]
    alignBytes = ir.typeLayoutAlignBytes[foundIndex]
    fieldCount = ir.typeLayoutFieldCounts[foundIndex]
    if sizeBytes <= 0:
        return false
    if alignBytes <= 0:
        return false
    return true

# Enumerate inline `str` leaves without allocating a temporary offset array.
# Dynamic-seq fields are separate owners and deliberately stop this walk; a
# later recursive seq descriptor closes that owner class. `wantedIndex < 0`
# performs a count-only pass. Exact active source/type pairs use storage
# proportional to the current nesting depth and reject only real cycles.
@borrows
fn typedExprIrVisitManagedStrFieldOffsetsActive(
        ir: TypedExprIr,
        sourcePathRaw: str,
        typeRaw: str,
        baseOffset: int32,
        wantedIndex: int32,
        seenCount: var int32,
        foundOffset: var int32,
        activeSourcePaths: var str[],
        activeTypes: var str[]): bool =
    # The @borrow_result metadata forward requires the pristine incoming var
    # root; later var-boundary calls in this body re-seat it.  The index
    # depends only on ir, so bind it first.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    if baseOffset < 0:
        return false
    if activeSourcePaths.len != activeTypes.len:
        panic("typed expr: managed string layout active-path columns mismatch")
    let callerSource = parser.ParserNormalizePath(sourcePathRaw)
    let normalizedType = TypedExprStripVarType(typeRaw)
    if callerSource == "" || normalizedType == "":
        return false
    if normalizedType == "str":
        if seenCount == wantedIndex:
            foundOffset = baseOffset
        seenCount = seenCount + 1
        return true
    if len(normalizedType) >= 2 &&
       chengpath.TextSlice(normalizedType, len(normalizedType) - 2, 2) == "[]":
        # The seq header owns another allocation. It is not inline storage and
        # must not be interpreted as an embedded string layout.
        return true
    var fixedCtx: TypedExprSourceContext
    fixedCtx.sourcePath = sourcePathRaw
    var fixedElemType = ""
    var fixedCount: int32
    if TypedExprIrFixedArrayTypeParts(fixedCtx,
                                     strings.CloneStr(normalizedType),
                                     fixedElemType,
                                     fixedCount):
        let fixedElemTypeOwned = strings.CloneStr(fixedElemType)
        var elemSize: int32
        var elemAlign: int32
        var elemFieldCount: int32
        if fixedCount <= 0 ||
           !TypedExprIrLookupTypeLayout(ir,
                                        strings.CloneStr(callerSource),
                                        fixedElemTypeOwned,
                                        elemSize,
                                        elemAlign,
                                        elemFieldCount) ||
           elemSize <= 0:
            return false
        for activeIndex in 0..<activeTypes.len:
            if activeSourcePaths[activeIndex] == callerSource &&
               activeTypes[activeIndex] == normalizedType:
                panic(Fmt"typed expr: managed string layout cycle source={callerSource} type={normalizedType}")
        let activeCount = activeTypes.len
        add(activeSourcePaths, share(callerSource))
        add(activeTypes, share(normalizedType))
        for itemIndex in 0..<fixedCount:
            let itemOffset = Int64(baseOffset) + Int64(itemIndex) * Int64(elemSize)
            if itemOffset < 0 || itemOffset > Int64(2147483647):
                panic(Fmt"typed expr: fixed-array managed-field offset overflow source={sourcePathRaw} type={normalizedType} base={baseOffset} elem_size={elemSize} index={itemIndex}")
            if !typedExprIrVisitManagedStrFieldOffsetsActive(
                    ir,
                    strings.CloneStr(callerSource),
                    strings.CloneStr(fixedElemTypeOwned),
                    int32(itemOffset),
                    wantedIndex,
                    seenCount,
                    foundOffset,
                    activeSourcePaths,
                    activeTypes):
                setLen(activeSourcePaths, activeCount)
                setLen(activeTypes, activeCount)
                return false
        setLen(activeSourcePaths, activeCount)
        setLen(activeTypes, activeCount)
        return true
    # Scalars, pointers and builtin buffer handles have no inline str leaf.
    if normalizedType == "bool" ||
       normalizedType == "char" ||
       normalizedType == "int8" || normalizedType == "uint8" ||
       normalizedType == "int16" || normalizedType == "uint16" ||
       normalizedType == "int32" || normalizedType == "uint32" ||
       normalizedType == "int64" || normalizedType == "uint64" ||
       normalizedType == "float32" || normalizedType == "float64" ||
       normalizedType == "ptr" || normalizedType == "cstring":
        return true
    # Bytes can carry either owned or borrowed raw storage, but the type text
    # has no ownership discriminator.  Whole-value ownership cannot be proven.
    if normalizedType == "Bytes" || normalizedType == "bytes.Bytes" ||
       normalizedType == "rawbytes.Bytes":
        return false
    if TypedExprIrTypeIsRef(ir, strings.CloneStr(callerSource), strings.CloneStr(normalizedType)) ||
       (normalizedType.len > 0 &&
        normalizedType[normalizedType.len - 1] == '*'):
        return true

    var ownerSource = ""
    var ownerType = ""
    let qualifiedDot = TypedExprQualifiedTypeDot(normalizedType)
    if qualifiedDot > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(normalizedType,
                                                               0,
                                                               qualifiedDot))
        let leaf = chengpath.PathTrim(chengpath.TextSlice(normalizedType,
                                                          qualifiedDot + 1,
                                                          normalizedType.len - qualifiedDot - 1))
        let targetSource = TypedExprIrLookupTypeAliasTargetSourcePath(ir,
                                                                      callerSource,
                                                                      qualifier)
        if targetSource != "" && leaf != "":
            ownerSource = parser.ParserNormalizePath(targetSource)
            ownerType = leaf
    if ownerSource == "":
        ownerSource = strings.CloneStr(callerSource)
    if ownerType == "":
        ownerType = strings.CloneStr(normalizedType)
    ownerType = TypedExprTypeLeafName(ownerType)
    if ownerType == "":
        return true

    var fieldCursor: TypedExprFrozenFieldOwnerCursor
    var fieldIndex = TypedExprIrFrozenFieldOwnerHead(ir,
                                                     ownerSource,
                                                     ownerType,
                                                     fieldCursor)
    if fieldIndex < 0:
        var visibleOwnerSource: str
        let ownerState = TypedExprBuildIndexVisibleContextSourcePath(
                                                                     canonicalMetadataIndex,
                                                                     "ctx_import_field_owner",
                                                                     ownerSource,
                                                                     ownerType,
                                                                     "",
                                                                     visibleOwnerSource)
        if ownerState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: managed string layout owner ambiguous source={ownerSource} type={ownerType}")
        if ownerState != TypedExprBuildIndexUnique:
            return false
        ownerSource = parser.ParserNormalizePath(visibleOwnerSource)
        if ownerSource == "":
            panic("typed expr: managed string layout visible owner source missing")
        fieldIndex = TypedExprIrFrozenFieldOwnerHead(ir,
                                                     ownerSource,
                                                     ownerType,
                                                     fieldCursor)
    for activeIndex in 0..<activeTypes.len:
        if activeSourcePaths[activeIndex] == ownerSource &&
           activeTypes[activeIndex] == ownerType:
            panic(Fmt"typed expr: managed string layout cycle source={ownerSource} type={ownerType}")
    let activeCount = activeTypes.len
    add(activeSourcePaths, share(ownerSource))
    add(activeTypes, share(ownerType))
    var matchedRows: int32
    while fieldIndex >= 0:
        matchedRows = matchedRows + 1
        let fieldOffset = ir.typeFieldOffsetBytes[fieldIndex]
        if fieldOffset < 0:
            setLen(activeSourcePaths, activeCount)
            setLen(activeTypes, activeCount)
            return false
        let nestedOffset = Int64(baseOffset) + Int64(fieldOffset)
        if nestedOffset < 0 || nestedOffset > Int64(2147483647):
            panic(Fmt"typed expr: managed string field offset overflow source={ownerSource} type={ownerType} base={baseOffset} field_offset={fieldOffset}")
        if !typedExprIrVisitManagedStrFieldOffsetsActive(
                ir,
                ownerSource,
                ir.typeFieldTypes[fieldIndex],
                int32(nestedOffset),
                wantedIndex,
                seenCount,
                foundOffset,
                activeSourcePaths,
                activeTypes):
            setLen(activeSourcePaths, activeCount)
            setLen(activeTypes, activeCount)
            return false
        fieldIndex = TypedExprIrFrozenFieldOwnerNext(ir,
                                                     fieldCursor,
                                                     fieldIndex)
    if matchedRows <= 0:
        var layoutSize: int32
        var layoutAlign: int32
        var layoutFields: int32
        if TypedExprIrLookupTypeLayout(ir,
                                       ownerSource,
                                       ownerType,
                                       layoutSize,
                                       layoutAlign,
                                       layoutFields) &&
           layoutFields > 0:
            setLen(activeSourcePaths, activeCount)
            setLen(activeTypes, activeCount)
            return false
    setLen(activeSourcePaths, activeCount)
    setLen(activeTypes, activeCount)
    return true

@borrows
fn TypedExprIrVisitManagedStrFieldOffsets(ir: TypedExprIr,
                                           sourcePathRaw: str,
                                           typeRaw: str,
                                           baseOffset: int32,
                                           wantedIndex: int32,
                                           seenCount: var int32,
                                           foundOffset: var int32): bool =
    var activeSourcePaths: str[]
    var activeTypes: str[]
    return typedExprIrVisitManagedStrFieldOffsetsActive(
        ir,
        sourcePathRaw,
        typeRaw,
        baseOffset,
        wantedIndex,
        seenCount,
        foundOffset,
        activeSourcePaths,
        activeTypes)

@borrows
fn TypedExprIrManagedStrFieldCount(ir: TypedExprIr,
                                    sourcePathRaw: str,
                                    typeRaw: str,
                                    fieldCount: var int32): bool =
    fieldCount = 0
    var ignoredOffset: int32 = -1
    return TypedExprIrVisitManagedStrFieldOffsets(ir,
                                                   sourcePathRaw,
                                                   typeRaw,
                                                   0,
                                                   -1,
                                                   fieldCount,
                                                   ignoredOffset)

@borrows
fn TypedExprIrManagedStrFieldOffsetAt(ir: TypedExprIr,
                                       sourcePathRaw: str,
                                       typeRaw: str,
                                       wantedIndex: int32,
                                       fieldOffset: var int32): bool =
    fieldOffset = -1
    if wantedIndex < 0:
        return false
    var seenCount: int32
    if !TypedExprIrVisitManagedStrFieldOffsets(ir,
                                                sourcePathRaw,
                                                typeRaw,
                                                0,
                                                wantedIndex,
                                                seenCount,
                                                fieldOffset):
        return false
    return fieldOffset >= 0

# Exact ownership classifier for stores that copy a whole value.  `str`, a
# dynamic-seq header, and a managed `ref` are ownership-bearing roots; inline
# structs/fixed arrays recurse through their declared fields.  Unknown layouts
# are rejected instead of being guessed plain.
@borrows
fn typedExprIrTypeContainsManagedStorageActive(
        ir: TypedExprIr,
        sourcePathRaw: str,
        typeRaw: str,
        hasManaged: var bool,
        activeSourcePaths: var str[],
        activeTypes: var str[]): bool =
    let callerSource = parser.ParserNormalizePath(sourcePathRaw)
    # The @borrow_result metadata forward requires the pristine incoming var
    # root; later var-boundary calls in this body re-seat it.  The index
    # depends only on ir, so bind it first.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    let normalizedType = TypedExprStripVarType(typeRaw)
    if callerSource == "" || normalizedType == "":
        return false
    if normalizedType == "str" ||
       (len(normalizedType) >= 2 &&
        chengpath.TextSlice(normalizedType, len(normalizedType) - 2, 2) == "[]") ||
       (len(normalizedType) > 5 &&
        chengpath.TextSlice(normalizedType, 0, 4) == "seq[" &&
        chengpath.TextSlice(normalizedType, len(normalizedType) - 1, 1) == "]"):
        hasManaged = true
        return true
    # `void` is not an aggregate type and owns no fields: a void call result
    # (e.g. seqs.Add(out, x)) must not fall through to the field-owner chain,
    # which requires the frozen metadata session that only exists after the
    # build-index seal.  Resolved, not managed — no session needed.
    if normalizedType == "void":
        return true
    # A generic placeholder (T/refT/varT) inside a template body has no
    # field-owner row until instantiation; routing it to the field-owner chain
    # panics on the not-yet-sealed metadata session.  Treat it conservatively
    # as managed storage: refs/params then classify as Borrowed views, which
    # is the safe ownership for an unknown instantiation and never requires a
    # session.
    if TypedExprTypeIsGenericPlaceholder(normalizedType):
        hasManaged = true
        return true
    var fixedCtx: TypedExprSourceContext
    # 符号维度(`int32[SlotCount]`)的解析必须有 build index:
    # TypedExprConstDimIntValue(:19981-19982) 在 ctx.buildIndex 缺席时直接返回
    # false, 而本分支此前只设 sourcePath ⇒ 含符号维度定长数组字段的聚合一律
    # 查询失败(false) → 上游 exprClass=Unknown → value-definition ownership
    # proof 按构造缺失(:6089 → :6098)。姊妹点 TypedExprIrLookupTypeLayout
    # (:47500-47502) 早已按同一 (borrowed buildIndex, sourcePath) 组合建 ctx,
    # 此处对齐。nil/released 时保持原样: 不改行为, 不 panic。
    if ir.buildIndex != nil && !ir.buildIndex.released:
        TypedExprSourceContextSetBorrowedBuildIndex(fixedCtx, ir.buildIndex)
    fixedCtx.sourcePath = sourcePathRaw
    var fixedElemType = ""
    var fixedCount: int32
    if TypedExprIrFixedArrayTypeParts(fixedCtx,
                                     normalizedType,
                                     fixedElemType,
                                     fixedCount):
        if fixedCount <= 0 || fixedElemType == "":
            return false
        for activeIndex in 0..<activeTypes.len:
            if activeSourcePaths[activeIndex] == callerSource &&
               activeTypes[activeIndex] == normalizedType:
                panic(Fmt"typed expr: managed-storage layout cycle source={callerSource} type={normalizedType}")
        let activeCount = activeTypes.len
        add(activeSourcePaths, share(callerSource))
        add(activeTypes, share(normalizedType))
        let nestedOk = typedExprIrTypeContainsManagedStorageActive(
            ir,
            callerSource,
            fixedElemType,
            hasManaged,
            activeSourcePaths,
            activeTypes)
        setLen(activeSourcePaths, activeCount)
        setLen(activeTypes, activeCount)
        return nestedOk
    if normalizedType == "bool" ||
       normalizedType == "char" ||
       normalizedType == "int8" || normalizedType == "uint8" ||
       normalizedType == "int16" || normalizedType == "uint16" ||
       normalizedType == "int32" || normalizedType == "uint32" ||
       normalizedType == "int64" || normalizedType == "uint64" ||
       normalizedType == "float32" || normalizedType == "float64" ||
       normalizedType == "ptr" || normalizedType == "cstring":
        return true
    if normalizedType == "Bytes" || normalizedType == "bytes.Bytes" ||
       normalizedType == "rawbytes.Bytes":
        return false
    # ref 修饰形状（`refT`，如 new(T) 内征结果的 ref{T} 结果文本；NormalizeTypeText
    # 删除全部空白，规范形状无空格）：引用值即托管存储，与下方 TypeIsRef（ref
    # object 声明在册）臂同判 hasManaged=true。TypeLeafName 不剥 "ref" 前缀，
    # 原路径把该形状当未知类型名走字段行直查/别名链 → 双 miss → 查询失败
    # false → 上游 exprClass=Unknown → node value/share 审计死（kernel_driver_
    # w21 v6 main:42 new(Node) 实测）。叶子名必须经 TypeIsRef 在册判定（与
    # 下方声明名臂同一权威），叶子非在册 ref 类型落回原路径 fail-closed 不变；
    # 叶子名恰以 ref 开头的普通类型（如 refCount）剥前缀后不在册 → 原路径
    # 字段行直查仍命中自身 → 零误伤。
    if normalizedType.len > 3 &&
       parser.ParserStartsWithExact(normalizedType, "ref"):
        let refLeafName = chengpath.PathTrim(
            chengpath.TextSlice(normalizedType, 3, normalizedType.len - 3))
        if refLeafName != "" &&
           TypedExprIrTypeIsRef(ir, callerSource, refLeafName):
            hasManaged = true
            return true
    if TypedExprIrTypeIsRef(ir, callerSource, normalizedType):
        hasManaged = true
        return true
    if normalizedType.len > 0 &&
       normalizedType[normalizedType.len - 1] == '*':
        return true
    # 类型别名(如 Int32Ptr=int32*): 逐层解别名成目标类型, 递归判 (§5 每跳核对
    # 精确类型与布局, 不可判 hard-fail)。裸指针/内置类型在递归终点命中上方
    # `T *`/int32 等分支判 hasManaged=false; 本类型自身没有字段行时才解别名
    # (真别名无字段行, 直查落空后跟别名与原别名优先序行为一致)。activeTypes
    # 环检防 A=B B=A 无限递归 (与上方 fixed-array 同款)。
    # 指针别名(Int32Ptr=int32*)严格同源判定为 `T *` 别名 → 视同裸指针不托管
    # (与上轮 ctor 闸 LoweringCallHeadIsNonExecutableTypeMaterialization 同源判据一致:
    # TypedExprIrTypeDefAliasIsSameSourcePtr 以函数 source 同源命中 Int32Ptr)。
    if TypedExprIrTypeDefAliasIsSameSourcePtr(ir, callerSource, normalizedType):
        return true
    # alias 目标在原代码位置序捕获；其三个消费值同点经 share 固化为独立
    # var 槽。本函数 @borrows 借权链对托管槽版本极敏感（烤机实测三连败定案）：
    # a) let 调用结果跨字段行直查调用后作实参/share 均失 exact 证明；
    # b) `var x = <str>` 是 move，会把源槽搬空、破坏后续原序列消费；
    # c) share 非 move：share(src) 在 src 尚有效的原位产生独立 owned 句柄，
    #    跨块后仍可作 add 元素与递归实参（ownerSource 跨 FFHead/自递归后
    #    share/传递的既有拼写同款）。分支是否生效仍由字段行直查结果决定。
    let aliasTarget = TypedExprIrLookupTypeDefAliasTargetType(ir, callerSource, normalizedType)
    var aliasSourceArg = share(callerSource)
    var aliasTypeArg = share(normalizedType)
    var aliasTargetArg = share(aliasTarget)
    # 本类型字段行直查优先于别名跳。decl 头行（`type Col = object` 等）会被
    # TypedExprContextProcessTypeDeclLine 登记成伪别名（alias["Col"]=
    # "object" 形状关键字, 非真实别名目标；与 TypedExprIrCanonicalFieldMetaState
    # 的调序修复同一病灶族）：别名优先会把一切本源声明的 object/ref object
    # 类型劫持到无字段行的形状关键字 owner → 查询失败(false) 被上游
    # TypedExprIrExprClassForResultTypeExact 当「类型不可判」→ exprClass=
    # Unknown → 参数 value-definition 的 ownership proof 按构造缺失。真别名
    # 自身没有字段行, 直查落空后仍跟别名, 该路径行为逐字节不变。
    var ownerSource = ""
    var ownerType = ""
    let qualifiedDot = TypedExprQualifiedTypeDot(normalizedType)
    if qualifiedDot > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(normalizedType,
                                                               0,
                                                               qualifiedDot))
        let leaf = chengpath.PathTrim(chengpath.TextSlice(normalizedType,
                                                          qualifiedDot + 1,
                                                          normalizedType.len - qualifiedDot - 1))
        let targetSource = TypedExprIrLookupTypeAliasTargetSourcePath(ir,
                                                                      callerSource,
                                                                      qualifier)
        if targetSource != "" && leaf != "":
            ownerSource = parser.ParserNormalizePath(targetSource)
            ownerType = leaf
    if ownerSource == "":
        ownerSource = callerSource
    if ownerType == "":
        ownerType = normalizedType
    ownerType = TypedExprTypeLeafName(ownerType)
    var fieldCursor: TypedExprFrozenFieldOwnerCursor
    var fieldIndex = -1
    if ownerType != "":
        fieldIndex = TypedExprIrFrozenFieldOwnerHead(ir,
                                                     ownerSource,
                                                     ownerType,
                                                     fieldCursor)
        if fieldIndex < 0:
            var visibleOwnerSource: str
            let ownerState = TypedExprBuildIndexVisibleContextSourcePath(
                canonicalMetadataIndex,
                "ctx_import_field_owner",
                ownerSource,
                ownerType,
                "",
                visibleOwnerSource)
            if ownerState == TypedExprBuildIndexAmbiguous:
                panic(Fmt"typed expr: managed-storage owner ambiguous source={ownerSource} type={ownerType}")
            if ownerState == TypedExprBuildIndexUnique:
                let visibleSource = parser.ParserNormalizePath(visibleOwnerSource)
                if visibleSource != "":
                    ownerSource = visibleSource
                    fieldIndex = TypedExprIrFrozenFieldOwnerHead(ir,
                                                                 ownerSource,
                                                                 ownerType,
                                                                 fieldCursor)
    if fieldIndex >= 0:
        for activeIndex in 0..<activeTypes.len:
            if activeSourcePaths[activeIndex] == ownerSource &&
               activeTypes[activeIndex] == ownerType:
                panic(Fmt"typed expr: managed-storage layout cycle source={ownerSource} type={ownerType}")
        let activeCount = activeTypes.len
        add(activeSourcePaths, share(ownerSource))
        add(activeTypes, share(ownerType))
        var matchedRows: int32
        while fieldIndex >= 0:
            matchedRows = matchedRows + 1
            if !typedExprIrTypeContainsManagedStorageActive(
                    ir,
                    ownerSource,
                    ir.typeFieldTypes[fieldIndex],
                    hasManaged,
                    activeSourcePaths,
                    activeTypes):
                setLen(activeSourcePaths, activeCount)
                setLen(activeTypes, activeCount)
                return false
            fieldIndex = TypedExprIrFrozenFieldOwnerNext(ir,
                                                         fieldCursor,
                                                         fieldIndex)
        setLen(activeSourcePaths, activeCount)
        setLen(activeTypes, activeCount)
        if matchedRows <= 0:
            return false
        return true
    # 本类型自身无字段行：才解别名（真别名无字段行，此处与原序等价；连别名
    # 都不是的未知类型名仍按查询失败 false 上抛，上游 fail-closed 语义不变）。
    # share 与递归实参全部取直查前固化的 var 槽（ownerSource 同款拼写）。
    if aliasTargetArg != "" && aliasTargetArg != aliasTypeArg:
        for activeIndex in 0..<activeTypes.len:
            if activeSourcePaths[activeIndex] == aliasSourceArg &&
               activeTypes[activeIndex] == aliasTypeArg:
                panic(Fmt"typed expr: managed-storage alias cycle source={aliasSourceArg} type={aliasTypeArg}")
        let activeCount = activeTypes.len
        add(activeSourcePaths, share(aliasSourceArg))
        add(activeTypes, share(aliasTypeArg))
        let aliasNestedOk = typedExprIrTypeContainsManagedStorageActive(
            ir,
            aliasSourceArg,
            aliasTargetArg,
            hasManaged,
            activeSourcePaths,
            activeTypes)
        setLen(activeSourcePaths, activeCount)
        setLen(activeTypes, activeCount)
        return aliasNestedOk
    return false

@borrows
fn TypedExprIrTypeContainsManagedStorage(ir: TypedExprIr,
                                          sourcePathRaw: str,
                                          typeRaw: str,
                                          hasManaged: var bool): bool =
    hasManaged = false
    var activeSourcePaths: str[]
    var activeTypes: str[]
    return typedExprIrTypeContainsManagedStorageActive(ir,
                                                        sourcePathRaw,
                                                        typeRaw,
                                                        hasManaged,
                                                        activeSourcePaths,
                                                        activeTypes)

@borrows
fn TypedExprFieldMetaValid(fieldType: str,
                            fieldOffsetBytes: int32,
                            fieldSizeBytes: int32,
                            fieldAlignBytes: int32): bool =
    if fieldType == "":
        return false
    if fieldOffsetBytes < 0:
        return false
    if fieldSizeBytes <= 0:
        return false
    if fieldAlignBytes <= 0:
        return false
    return true

@borrows
fn TypedExprIrIndexedFieldRow(ir: TypedExprIr,
                               sourcePath: str,
                               ownerType: str,
                               fieldName: str): int32 =
    # Bind the immutable metadata index before the visibility lookup chain.
    let canonicalMetadataIndex = typedExprIrCanonicalMetadataIndex(ir)
    var rowIndex: int32
    if sourcePath != "":
        let sourceState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_field_source", sourcePath, ownerType, fieldName, rowIndex)
        if sourceState == TypedExprBuildIndexAmbiguous:
            return -2
        if sourceState == TypedExprBuildIndexUnique:
            return rowIndex
        var targetSourcePath: str
        let visibleState = TypedExprBuildIndexVisibleContextSourcePath(
                                                                       canonicalMetadataIndex,
                                                                       "ctx_import_field_owner",
                                                                       sourcePath,
                                                                       TypedExprTypeLeafName(ownerType),
                                                                       "",
                                                                       targetSourcePath)
        if visibleState == TypedExprBuildIndexAmbiguous:
            return -2
        if visibleState != TypedExprBuildIndexUnique:
            return -1
        let targetState = TypedExprBuildIndexLookup(ir.buildIndex,
                                                     "ir_field_source",
                                                     targetSourcePath,
                                                     ownerType,
                                                     fieldName,
                                                     rowIndex)
        if targetState == TypedExprBuildIndexAmbiguous:
            return -2
        if targetState == TypedExprBuildIndexUnique:
            return rowIndex
        return -1
    # An absent lexical owner cannot prove a unique field identity. Global
    # rows are diagnostic indexes only and must never recover an unowned query.
    return -1

@borrows
fn TypedExprIrLoadFieldRow(ir: TypedExprIr,
                            rowIndex: int32,
                            fieldType: var str,
                            fieldOffsetBytes: var int32,
                            fieldSizeBytes: var int32,
                            fieldAlignBytes: var int32): bool =
    if rowIndex < 0 || rowIndex >= ir.typeFieldTypes.len ||
       rowIndex >= ir.typeFieldOffsetBytes.len ||
       rowIndex >= ir.typeFieldSizeBytes.len ||
       rowIndex >= ir.typeFieldAlignBytes.len:
        return false
    fieldType = strings.CloneStr(ir.typeFieldTypes[rowIndex])
    fieldOffsetBytes = ir.typeFieldOffsetBytes[rowIndex]
    fieldSizeBytes = ir.typeFieldSizeBytes[rowIndex]
    fieldAlignBytes = ir.typeFieldAlignBytes[rowIndex]
    return TypedExprFieldMetaValid(fieldType,
                                   fieldOffsetBytes,
                                   fieldSizeBytes,
                                   fieldAlignBytes)

@borrows
fn TypedExprIrLookupSingleFieldMeta(ir: TypedExprIr,
                                     sourcePathRaw: str,
                                     ownerTypeRaw: str,
                                     fieldNameRaw: str,
                                     fieldType: var str,
                                     fieldOffsetBytes: var int32,
                                     fieldSizeBytes: var int32,
                                     fieldAlignBytes: var int32): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let ownerType = TypedExprStripVarType(ownerTypeRaw)
    # form60: single-field API must not IdentPrefix-truncate multi-segment paths
    # ("flags.len" → "flags" hit bool[] Aggregate and poisoned Cmp operands).
    let fieldNameRawTrim = chengpath.PathTrim(fieldNameRaw)
    let fieldName = parser.ParserIdentPrefix(fieldNameRawTrim)
    if fieldName != fieldNameRawTrim:
        return false
    if ownerType == "" || fieldName == "":
        return false
    if ownerType == "str":
        if fieldName == "data":
            fieldType = "ptr"
            fieldOffsetBytes = 0
            fieldSizeBytes = 8
            fieldAlignBytes = 8
        elif fieldName == "len":
            fieldType = "int32"
            fieldOffsetBytes = 8
            fieldSizeBytes = 4
            fieldAlignBytes = 4
        elif fieldName == "storeId" || fieldName == "store_id":
            fieldType = "int32"
            fieldOffsetBytes = 12
            fieldSizeBytes = 4
            fieldAlignBytes = 4
        elif fieldName == "flags":
            fieldType = "int32"
            fieldOffsetBytes = 16
            fieldSizeBytes = 4
            fieldAlignBytes = 4
        else:
            return false
        return TypedExprFieldMetaValid(fieldType,
                                       fieldOffsetBytes,
                                       fieldSizeBytes,
                                       fieldAlignBytes)
    if ownerType == "Bytes" || ownerType == "bytes.Bytes" || ownerType == "rawbytes.Bytes":
        if fieldName == "data":
            fieldType = "ptr"
            fieldOffsetBytes = 0
            fieldSizeBytes = 8
            fieldAlignBytes = 8
        elif fieldName == "len":
            fieldType = "int32"
            fieldOffsetBytes = 8
            fieldSizeBytes = 4
            fieldAlignBytes = 4
        else:
            return false
        return TypedExprFieldMetaValid(fieldType,
                                       fieldOffsetBytes,
                                       fieldSizeBytes,
                                       fieldAlignBytes)
    if ownerType.len >= 2 && chengpath.TextSlice(ownerType, ownerType.len - 2, 2) == "[]":
        if fieldName == "len":
            fieldType = "int32"
            fieldOffsetBytes = 0
            fieldSizeBytes = 4
            fieldAlignBytes = 4
        elif fieldName == "cap":
            fieldType = "int32"
            fieldOffsetBytes = 4
            fieldSizeBytes = 4
            fieldAlignBytes = 4
        elif fieldName == "buffer":
            fieldType = "ptr"
            fieldOffsetBytes = 8
            fieldSizeBytes = 8
            fieldAlignBytes = 8
        else:
            return false
        return TypedExprFieldMetaValid(fieldType,
                                       fieldOffsetBytes,
                                       fieldSizeBytes,
                                       fieldAlignBytes)
    var indexedOwnerSource = share(sourcePath)
    let indexedQualifiedDot = TypedExprQualifiedTypeDot(ownerType)
    var indexedQualifier = ""
    if indexedQualifiedDot > 0:
        indexedQualifier = chengpath.PathTrim(
            chengpath.TextSlice(ownerType, 0, indexedQualifiedDot))
    var indexedOwnerType = TypedExprTypeLeafName(ownerType)
    if indexedQualifiedDot > 0:
        let indexedTargetSource = TypedExprIrLookupTypeAliasTargetSourcePath(ir,
                                                                              sourcePath,
                                                                              indexedQualifier)
        if indexedTargetSource != "":
            indexedOwnerSource = parser.ParserNormalizePath(indexedTargetSource)
    let indexedRow = TypedExprIrIndexedFieldRow(ir,
                                                 indexedOwnerSource,
                                                 indexedOwnerType,
                                                 fieldName)
    return TypedExprIrLoadFieldRow(ir,
                                   indexedRow,
                                   fieldType,
                                   fieldOffsetBytes,
                                   fieldSizeBytes,
                                   fieldAlignBytes)

@borrows
fn TypedExprIrLookupFieldPathMeta(ir: TypedExprIr,
                                   sourcePathRaw: str,
                                   ownerTypeRaw: str,
                                   fieldPathRaw: str,
                                   fieldType: var str,
                                   fieldOffsetBytes: var int32,
                                   fieldSizeBytes: var int32,
                                   fieldAlignBytes: var int32): bool =
    fieldType = TypedExprStripVarType(ownerTypeRaw)
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let parts = parser.ParserSplitChar(chengpath.PathTrim(fieldPathRaw), '.')
    if fieldType == "" || parts.len <= 0:
        return false
    for i in 0..<parts.len:
        let part = parser.ParserIdentPrefix(parts[i])
        if part == "":
            return false
        var nextType = ""
        var nextOffset: int32
        var nextSize: int32
        var nextAlign: int32
        if !TypedExprIrLookupSingleFieldMeta(ir,
                                             sourcePathRaw,
                                             fieldType,
                                             part,
                                             nextType,
                                             nextOffset,
                                             nextSize,
                                             nextAlign):
            return false
        fieldOffsetBytes = fieldOffsetBytes + nextOffset
        fieldType = nextType
        fieldSizeBytes = nextSize
        fieldAlignBytes = nextAlign
    return true

@borrows
fn typedExprResolveContextFieldLayoutReadOnly(
        ownerCtx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        ownerType: str,
        targetNodeIndex: int32,
        fieldOffsetBytes: var int32,
        fieldSizeBytes: var int32,
        fieldAlignBytes: var int32): bool =
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let sourcePath = parser.ParserNormalizePath(ownerCtx.sourcePath)
    var offset: int32
    var nodeIndex = TypedExprBuildIndexContextFieldHead(ownerCtx.buildIndex,
                                                        sourcePath,
                                                        ownerType)
    while nodeIndex >= 0:
        var contextIndex: int32
        var rowIndex: int32
        if !TypedExprBuildIndexContextFieldNode(ownerCtx.buildIndex,
                                                nodeIndex,
                                                contextIndex,
                                                rowIndex):
            return false
        var field: TypedExprTypeFieldDecl
        if !typedExprContextFieldAt(ownerCtx, rowIndex, field) ||
           TypedExprTypeLeafName(field.ownerType) != ownerType:
            return false
        var sizeBytes: int32
        var alignBytes: int32
        if !TypedExprTypeLayout(ownerCtx,
                                sourceContexts,
                                field.fieldType,
                                sizeBytes,
                                alignBytes) || alignBytes <= 0:
            return false
        offset = TypedExprAlignBytes(offset, alignBytes)
        if nodeIndex == targetNodeIndex:
            fieldOffsetBytes = offset
            fieldSizeBytes = sizeBytes
            fieldAlignBytes = alignBytes
            return true
        offset = offset + sizeBytes
        nodeIndex = TypedExprBuildIndexContextFieldNext(ownerCtx.buildIndex,
                                                        nodeIndex)
    return false

@borrows
fn TypedExprResolveFieldMetaFromOwnerContext(ownerCtx: TypedExprSourceContext,
                                              sourceContexts: TypedExprSourceContext[],
                                              baseTypeRaw: str,
                                              fieldNameRaw: str,
                                              fieldType: var str,
                                              fieldOffsetBytes: var int32,
                                              fieldSizeBytes: var int32,
                                              fieldAlignBytes: var int32): bool =
    let ownerType = TypedExprTypeLeafName(baseTypeRaw)
    let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw))
    if ownerType == "" || fieldName == "":
        return false
    var ownerSize: int32
    var ownerAlign: int32
    if !TypedExprTypeLayout(ownerCtx,
                            sourceContexts,
                            baseTypeRaw,
                            ownerSize,
                            ownerAlign):
        return false
    var nodeIndex: int32
    let state = TypedExprBuildIndexLookup(ownerCtx.buildIndex,
                                          "ctx_field_source",
                                          parser.ParserNormalizePath(ownerCtx.sourcePath),
                                          ownerType,
                                          fieldName,
                                          nodeIndex)
    var contextIndex: int32
    var rowIndex: int32
    if state != TypedExprBuildIndexUnique ||
       !TypedExprBuildIndexContextFieldNode(ownerCtx.buildIndex,
                                           nodeIndex,
                                           contextIndex,
                                           rowIndex):
        return false
    if !TypedExprBuildIndexContextFieldLayout(ownerCtx.buildIndex,
                                              nodeIndex,
                                              fieldOffsetBytes,
                                              fieldSizeBytes,
                                              fieldAlignBytes):
        # Some canonical builtin layouts (notably ErrorInfo) are known without
        # walking their declared field rows, so the aggregate size cache can be
        # ready while an individual field offset is not. Frozen queries derive
        # the offset from the same ordered field table without mutating the
        # shared build index.
        if !typedExprResolveContextFieldLayoutReadOnly(ownerCtx,
                                                       sourceContexts,
                                                       ownerType,
                                                       nodeIndex,
                                                       fieldOffsetBytes,
                                                       fieldSizeBytes,
                                                       fieldAlignBytes):
            return false
    var field: TypedExprTypeFieldDecl
    if !typedExprContextFieldAt(ownerCtx, rowIndex, field):
        return false
    fieldType = field.fieldType
    return true

@borrows
fn TypedExprContextTypeDefAliasTarget(ctx: TypedExprSourceContext,
                                       leafName: str): str =
    var targetType: str
    let state = TypedExprBuildIndexLookupFingerprint(ctx.buildIndex,
                                                      "ctx_alias_source",
                                                      parser.ParserNormalizePath(parser.ParserOwnedText(ctx.sourcePath)),
                                                      leafName,
                                                      "",
                                                      targetType)
    if state == TypedExprBuildIndexAmbiguous:
        panic(Fmt"typed expr: ambiguous source type alias source={ctx.sourcePath} type={leafName}")
    if state != TypedExprBuildIndexUnique:
        return ""
    return targetType

@borrows
fn TypedExprTypeDefAliasOwnerLookup(currentCtx: TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     baseTypeRaw: str,
                                     outTargetType: var str): int32 =
    outTargetType = ""
    let baseType = TypedExprStripVarType(baseTypeRaw)
    let leaf = TypedExprTypeLeafName(baseType)
    if leaf == "":
        return -1
    let dotPos = TypedExprQualifiedTypeDot(baseType)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(baseType, 0, dotPos))
        let targetPath = TypedExprLookupQualifiedModuleSourcePath(currentCtx,
                                                                  sourceContexts,
                                                                  qualifier)
        let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetPath)
        if targetIndex == -2:
            panic(Fmt"typed expr: qualified type alias owner ambiguous source={currentCtx.sourcePath} qualifier={qualifier} type={leaf}")
        if targetIndex < 0:
            return -1
        outTargetType = TypedExprContextTypeDefAliasTarget(sourceContexts[targetIndex], leaf)
        if outTargetType == "":
            return -1
        return targetIndex
    let currentTarget = TypedExprContextTypeDefAliasTarget(currentCtx, leaf)
    if currentTarget != "":
        outTargetType = currentTarget
        return -2
    var found: int32
    let state = TypedExprBuildIndexLookup(currentCtx.buildIndex,
                                          "ctx_import_alias_def",
                                          parser.ParserNormalizePath(currentCtx.sourcePath),
                                          leaf,
                                          "",
                                          found)
    if state == TypedExprBuildIndexAmbiguous:
        panic(Fmt"typed expr: ambiguous visible type alias source={currentCtx.sourcePath} type={leaf}")
    if state != TypedExprBuildIndexUnique:
        return -1
    let localFound = typedExprContextArrayIndexForBuildIndex(sourceContexts,
                                                              found)
    if localFound < 0:
        return -1
    outTargetType = TypedExprContextTypeDefAliasTarget(sourceContexts[localFound], leaf)
    if outTargetType == "":
        return -1
    return localFound

@borrows
fn TypedExprResolveFieldMetaImpl(currentCtx: TypedExprSourceContext,
                                  sourceContexts: TypedExprSourceContext[],
                                  baseTypeRaw: str,
                                  fieldNameRaw: str,
                                  fieldType: var str,
                                  fieldOffsetBytes: var int32,
                                  fieldSizeBytes: var int32,
                                  fieldAlignBytes: var int32,
                                  activeOwnerSourcePaths: var str[],
                                  activeOwnerTypes: var str[]): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    if activeOwnerSourcePaths.len != activeOwnerTypes.len:
        panic("typed expr: field metadata alias active-path columns mismatch")
    var baseType = TypedExprStripVarType(baseTypeRaw)
    # ref T 在 `.field` 访问处自动解引用(文本路径已下降 `out.data`,out=new(T))。
    # `ref T` 归一成无空格 `refT`,匹配不到任何 struct 名 → field meta 失败 → no_node。
    # 剥首 `ref` 到 pointee struct 名让下面 struct 回退能解析。**仅当剥后是可解析
    # struct(或 builtin str)才剥**,故字面以 "ref" 开头的用户类型不会被误解引用。
    if parser.ParserStartsWith(baseType, "ref") && baseType.len > 3:
        let refPointee = chengpath.TextSlice(baseType, 3, baseType.len - 3)
        if refPointee != "" &&
           (TypedExprFieldContextLookup(currentCtx, sourceContexts, refPointee) != -1 ||
            TypedExprNormalizeTypeText(refPointee) == "str"):
            baseType = refPointee
    let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw))
    if fieldName == "":
        return false
    if baseType == "str":
        if fieldName == "data":
            fieldType = "ptr"
            fieldOffsetBytes = 0
        elif fieldName == "len":
            fieldType = "int32"
            fieldOffsetBytes = 8
        elif fieldName == "storeId" || fieldName == "store_id":
            fieldType = "int32"
            fieldOffsetBytes = 12
        elif fieldName == "flags":
            fieldType = "int32"
            fieldOffsetBytes = 16
        else:
            return false
        return TypedExprTypeLayout(currentCtx, sourceContexts, fieldType, fieldSizeBytes, fieldAlignBytes)
    if baseType == "Bytes" || baseType == "bytes.Bytes" || baseType == "rawbytes.Bytes":
        if fieldName == "data":
            fieldType = "ptr"
            fieldOffsetBytes = 0
        elif fieldName == "len":
            fieldType = "int32"
            fieldOffsetBytes = 8
        else:
            return false
        return TypedExprTypeLayout(currentCtx, sourceContexts, fieldType, fieldSizeBytes, fieldAlignBytes)
    if baseType.len >= 2 && chengpath.TextSlice(baseType, baseType.len - 2, 2) == "[]":
        if fieldName == "len":
            fieldType = "int32"
            fieldOffsetBytes = 0
        elif fieldName == "cap":
            fieldType = "int32"
            fieldOffsetBytes = 4
        elif fieldName == "buffer":
            fieldType = "ptr"
            fieldOffsetBytes = 8
        else:
            return false
        return TypedExprTypeLayout(currentCtx, sourceContexts, fieldType, fieldSizeBytes, fieldAlignBytes)
    let resultInner = TypedExprResultSuccessType(baseType)
    if resultInner != "":
        let inner = resultInner
        var valueSize: int32
        var valueAlign: int32
        if !TypedExprTypeLayout(currentCtx, sourceContexts, inner, valueSize, valueAlign):
            return false
        if fieldName == "ok":
            fieldType = "bool"
            fieldOffsetBytes = 0
        elif fieldName == "value":
            fieldType = inner
            fieldOffsetBytes = TypedExprAlignBytes(1, valueAlign)
        elif fieldName == "err":
            var errSize: int32
            var errAlign: int32
            if !TypedExprTypeLayout(currentCtx, sourceContexts, "ErrorInfo", errSize, errAlign):
                return false
            fieldType = "ErrorInfo"
            fieldOffsetBytes = TypedExprAlignBytes(TypedExprAlignBytes(1, valueAlign) + valueSize, errAlign)
        else:
            return false
        return TypedExprTypeLayout(currentCtx, sourceContexts, fieldType, fieldSizeBytes, fieldAlignBytes)
    # Option[T] is a builtin generic struct { has: bool@0; value: T@align(1,alignT) }
    # (src/core/option.cheng / src/runtime/option.cheng). The generic-instantiation
    # type text `Option[Inner]` matches no user struct context, so the field-context
    # lookup below returns miss → assign-field resolution fails → backend2 bail=711
    # on every `opt.has =`/`opt.value =` and nested `root.optField.sub =`. Mirror the
    # Result[ handler above (identical flag-first-then-value layout) so field-path meta
    # resolves the generic's sub-fields instead of poisoning the whole body.
    if parser.ParserStartsWith(baseType, "Option[") &&
       baseType.len > 8 &&
       chengpath.TextSlice(baseType, baseType.len - 1, 1) == "]":
        let optInner = chengpath.TextSlice(baseType, 7, baseType.len - 8)
        var optValueSize: int32
        var optValueAlign: int32
        if !TypedExprTypeLayout(currentCtx, sourceContexts, optInner, optValueSize, optValueAlign):
            return false
        if fieldName == "has":
            fieldType = "bool"
            fieldOffsetBytes = 0
        elif fieldName == "value":
            fieldType = optInner
            fieldOffsetBytes = TypedExprAlignBytes(1, optValueAlign)
        else:
            return false
        return TypedExprTypeLayout(currentCtx, sourceContexts, fieldType, fieldSizeBytes, fieldAlignBytes)
    let ctxIndex = TypedExprFieldContextLookup(currentCtx, sourceContexts, baseType)
    if ctxIndex >= 0:
        var fieldOwnerContext = share(sourceContexts[ctxIndex])
        return TypedExprResolveFieldMetaFromOwnerContext(fieldOwnerContext,
                                                         sourceContexts,
                                                         baseType,
                                                         fieldName,
                                                         fieldType,
                                                         fieldOffsetBytes,
                                                         fieldSizeBytes,
                                                         fieldAlignBytes)
    if ctxIndex == -2:
        return TypedExprResolveFieldMetaFromOwnerContext(currentCtx,
                                                         sourceContexts,
                                                         baseType,
                                                         fieldName,
                                                         fieldType,
                                                         fieldOffsetBytes,
                                                         fieldSizeBytes,
                                                         fieldAlignBytes)
    var aliasTarget = ""
    let aliasOwnerIndex = TypedExprTypeDefAliasOwnerLookup(currentCtx,
                                                           sourceContexts,
                                                           share(baseType),
                                                           aliasTarget)
    if aliasTarget != "":
        var aliasCtxIndex = aliasOwnerIndex
        var aliasOwnerSourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
        if aliasCtxIndex >= 0:
            aliasOwnerSourcePath = parser.ParserNormalizePath(
                sourceContexts[aliasCtxIndex].sourcePath)
        let aliasOwnerType = TypedExprTypeLeafName(baseType)
        if aliasOwnerSourcePath == "" || aliasOwnerType == "":
            panic("typed expr: field metadata alias owner identity missing")
        for activeIndex in 0..<activeOwnerTypes.len:
            if activeOwnerSourcePaths[activeIndex] == aliasOwnerSourcePath &&
               activeOwnerTypes[activeIndex] == aliasOwnerType:
                panic(Fmt"typed expr: field metadata alias cycle source={aliasOwnerSourcePath} type={aliasOwnerType} field={fieldName}")
        let activeCount = activeOwnerTypes.len
        add(activeOwnerSourcePaths, aliasOwnerSourcePath)
        add(activeOwnerTypes, aliasOwnerType)
        var resolved = false
        if aliasCtxIndex >= 0:
            var aliasContext = share(sourceContexts[aliasCtxIndex])
            resolved = TypedExprResolveFieldMetaImpl(
                aliasContext,
                sourceContexts,
                aliasTarget,
                fieldName,
                fieldType,
                fieldOffsetBytes,
                fieldSizeBytes,
                fieldAlignBytes,
                activeOwnerSourcePaths,
                activeOwnerTypes)
        else:
            resolved = TypedExprResolveFieldMetaImpl(
                currentCtx,
                sourceContexts,
                aliasTarget,
                fieldName,
                fieldType,
                fieldOffsetBytes,
                fieldSizeBytes,
                fieldAlignBytes,
                activeOwnerSourcePaths,
                activeOwnerTypes)
        setLen(activeOwnerSourcePaths, activeCount)
        setLen(activeOwnerTypes, activeCount)
        return resolved
    return false

@borrows
fn TypedExprResolveFieldMeta(currentCtx: TypedExprSourceContext,
                              sourceContexts: TypedExprSourceContext[],
                              baseTypeRaw: str,
                              fieldNameRaw: str,
                              fieldType: var str,
                              fieldOffsetBytes: var int32,
                              fieldSizeBytes: var int32,
                              fieldAlignBytes: var int32): bool =
    var activeOwnerSourcePaths: str[]
    var activeOwnerTypes: str[]
    return TypedExprResolveFieldMetaImpl(currentCtx,
                                         sourceContexts,
                                         baseTypeRaw,
                                         fieldNameRaw,
                                         fieldType,
                                         fieldOffsetBytes,
                                         fieldSizeBytes,
                                         fieldAlignBytes,
                                         activeOwnerSourcePaths,
                                         activeOwnerTypes)

@borrows
fn TypedExprResolveFieldPathMeta(currentCtx: TypedExprSourceContext,
                                  sourceContexts: TypedExprSourceContext[],
                                  rootTypeRaw: str,
                                  fieldPathRaw: str,
                                  fieldType: var str,
                                  fieldOffsetBytes: var int32,
                                  fieldSizeBytes: var int32,
                                  fieldAlignBytes: var int32): bool =
    fieldType = TypedExprStripVarType(rootTypeRaw)
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let parts = parser.ParserSplitChar(chengpath.PathTrim(fieldPathRaw), '.')
    if parts.len <= 0:
        return false
    var pathContextIndex: int32 = -2
    for i in 0..<parts.len:
        let part = parser.ParserIdentPrefix(share(parts[i]))
        if part == "":
            return false
        var nextType = ""
        var nextOffset: int32
        var nextSize: int32
        var nextAlign: int32
        var ownerContextIndex: int32
        var resolved = false
        if pathContextIndex >= 0:
            var pathContext = share(sourceContexts[pathContextIndex])
            ownerContextIndex = TypedExprFieldContextLookup(pathContext,
                                                            sourceContexts,
                                                            strings.CloneStr(fieldType))
            resolved = TypedExprResolveFieldMeta(pathContext,
                                                 sourceContexts,
                                                 strings.CloneStr(fieldType),
                                                 share(part),
                                                 nextType,
                                                 nextOffset,
                                                 nextSize,
                                                 nextAlign)
        else:
            ownerContextIndex = TypedExprFieldContextLookup(currentCtx,
                                                            sourceContexts,
                                                            strings.CloneStr(fieldType))
            resolved = TypedExprResolveFieldMeta(currentCtx,
                                                 sourceContexts,
                                                 strings.CloneStr(fieldType),
                                                 share(part),
                                                 nextType,
                                                 nextOffset,
                                                 nextSize,
                                                 nextAlign)
        if !resolved:
            return false
        fieldOffsetBytes = fieldOffsetBytes + nextOffset
        fieldType = nextType
        fieldSizeBytes = nextSize
        fieldAlignBytes = nextAlign
        if ownerContextIndex >= 0:
            pathContextIndex = ownerContextIndex
        # (707 解封) 字段类型的符号数组维度在类型定义模块 (owner) 语境解析并
        # 规范化为数字字面量, 防止 const 名流出定义模块后下游文本解析连锁 miss。
        if pathContextIndex >= 0:
            var dimContext = share(sourceContexts[pathContextIndex])
            fieldType = TypedExprCanonicalizeFixedArrayDimText(dimContext,
                                                               strings.CloneStr(fieldType))
        else:
            fieldType = TypedExprCanonicalizeFixedArrayDimText(currentCtx,
                                                               strings.CloneStr(fieldType))
    return true

fn TypedExprSourceLine(ctx: var TypedExprSourceContext,
                         lineNumber: int32): str =
    if lineNumber <= 0:
        return ""
    let selectedLineIndex = TypedExprSourceContextLineIndex(ctx, lineNumber)
    if selectedLineIndex >= 0:
        return ctx.lines[selectedLineIndex]
    if ctx.sourcePath == "":
        return ""
    if ctx.snapshotOnly:
        panic(Fmt"typed expr: snapshot-only source line missing source={ctx.sourcePath} line={lineNumber} loaded_lines={ctx.lines.len}")
    if ctx.factsFullSourceRescanCount < 0 ||
       ctx.factsFullSourceRescanCount >= 2147483647:
        panic("typed expr: full-source rescan telemetry exhausted")
    # This is the only physical whole-source fallback. Count the real event
    # before opening the file so failed reads cannot disappear from evidence.
    ctx.factsFullSourceRescanCount = ctx.factsFullSourceRescanCount + 1
    var sourceText = chengpath.ReadTextFile("", ctx.sourcePath)
    if sourceText == "":
        sourceText = os.ReadFile(chengpath.PathProviderFilePath(ctx.sourcePath))
    if sourceText == "":
        return ""
    let lines = parser.ParserSplitChar(sourceText, '\n')
    if lineNumber > lines.len:
        return ""
    return lines[lineNumber - 1]

fn TypedExprClearSourceContextHeavyFields(ctx: var TypedExprSourceContext) =
    ctx.lineNumbers = []
    ctx.sourceLineCount = 0
    ctx.sourceByteLength = 0
    ctx.sourceLineByteStarts = []
    ctx.sourceLineByteLengths = []
    ctx.sourceLineOverrideIndexes = []
    ctx.sourceLineOverrideTexts = []
    ctx.sourceIndexProducerFullTraversalCount = 0
    ctx.factsSelectedLineVisitCount = Int64(0)
    ctx.factsSelectedLineBytes = Int64(0)
    ctx.factsSelectedScopeVisitCount = Int64(0)
    ctx.factsSelectedBindingVisitCount = Int64(0)
    ctx.factsGlobalBindingVisitCount = Int64(0)
    ctx.lines = []
    ctx.bindings = []
    ctx.bindingNameIndexBucketHeads = []
    ctx.bindingNameIndexEntryNames = []
    ctx.bindingNameIndexEntryBindingIndexes = []
    ctx.bindingNameIndexEntryNext = []
    ctx.bindingNameIndexBuiltCount = -1
    ctx.scopeNameIndexBucketHeads = []
    ctx.scopeNameIndexEntryNames = []
    ctx.scopeNameIndexEntryScopeIndexes = []
    ctx.scopeNameIndexEntryNext = []
    ctx.scopeNameIndexBuiltCount = -1
    ctx.exprLineColumnHeads = []
    ctx.exprLineColumnValues = []
    ctx.exprLineColumnNext = []

fn TypedExprClearMetadataContextScopeSourcePaths(ctx: var TypedExprSourceContext) =
    for i in 0..<ctx.scopes.len:
        var scope = ctx.scopes[i]
        scope.sourcePath = ""
        ctx.scopes[i] = scope
    for i in 0..<ctx.importcFunctions.len:
        var importcFn = ctx.importcFunctions[i]
        importcFn.sourcePath = ""
        ctx.importcFunctions[i] = importcFn

@borrows
fn typedExprFunctionScopeCloneOwned(scope: TypedExprFunctionScope): TypedExprFunctionScope =
    var out: TypedExprFunctionScope
    out.sourcePath = strings.CloneStr(scope.sourcePath)
    out.name = strings.CloneStr(scope.name)
    out.producerDeclarationOrdinal = scope.producerDeclarationOrdinal
    out.startLine = scope.startLine
    out.endLine = scope.endLine
    out.returnType = strings.CloneStr(scope.returnType)
    out.genericNameJoin = strings.CloneStr(scope.genericNameJoin)
    out.genericNamesComplete = scope.genericNamesComplete
    out.paramTypeJoin = strings.CloneStr(scope.paramTypeJoin)
    out.paramTypesComplete = scope.paramTypesComplete
    out.borrowResult = scope.borrowResult
    out.borrowsArguments = scope.borrowsArguments
    out.manualConsumePresent = scope.manualConsumePresent
    out.manualConsumeFunctionDeclarationRow = scope.manualConsumeFunctionDeclarationRow
    out.manualConsumeTargetParameterOrdinal = scope.manualConsumeTargetParameterOrdinal
    out.manualConsumeSourceParameterOrdinal = scope.manualConsumeSourceParameterOrdinal
    out.manualConsumeTargetParameterDeclarationRow =
        scope.manualConsumeTargetParameterDeclarationRow
    out.manualConsumeSourceParameterDeclarationRow =
        scope.manualConsumeSourceParameterDeclarationRow
    out.manualConsumeTargetTypeId = scope.manualConsumeTargetTypeId
    out.manualConsumeSourceTypeId = scope.manualConsumeSourceTypeId
    out.manualConsumeEffectCid = scope.manualConsumeEffectCid
    out.loopVarTableBuilt = false
    out.loopVarRecordNames = []
    out.loopVarRecordLineNumbers = []
    out.loopVarRecordIndents = []
    out.loopVarRecordRangeFlags = []
    out.loopVarRecordIterableTexts = []
    out.loopVarRecordNext = []
    out.loopVarNameBucketHeads = []
    out.loopVarLineEnclosingForRecordIndexes = []
    return out

@borrows
fn typedExprBindingCloneOwned(binding: TypedExprBinding): TypedExprBinding =
    var out: TypedExprBinding
    out.sourcePath = strings.CloneStr(binding.sourcePath)
    out.functionName = strings.CloneStr(binding.functionName)
    out.globalFlag = binding.globalFlag
    out.mutableFlag = binding.mutableFlag
    out.producerSourceIndex = binding.producerSourceIndex
    out.declarationSourceLocalRow = binding.declarationSourceLocalRow
    out.lineNumber = binding.lineNumber
    out.name = strings.CloneStr(binding.name)
    out.typeText = strings.CloneStr(binding.typeText)
    out.initValueText = strings.CloneStr(binding.initValueText)
    return out

@borrows
fn typedExprImportcFunctionCloneOwned(
        item: TypedExprImportcFunction): TypedExprImportcFunction =
    var out: TypedExprImportcFunction
    out.sourcePath = strings.CloneStr(item.sourcePath)
    out.name = strings.CloneStr(item.name)
    out.producerDeclarationOrdinal = item.producerDeclarationOrdinal
    out.importName = strings.CloneStr(item.importName)
    out.returnType = strings.CloneStr(item.returnType)
    out.paramTypeJoin = strings.CloneStr(item.paramTypeJoin)
    out.ffiMapPtrArg = item.ffiMapPtrArg
    out.ffiMapLenArg = item.ffiMapLenArg
    out.ffiOutPtrArgs = strings.CloneStr(item.ffiOutPtrArgs)
    out.abiInternal = item.abiInternal
    out.ffiOwnedResultPresent = item.ffiOwnedResultPresent
    out.ffiOwnedResultFree = strings.CloneStr(item.ffiOwnedResultFree)
    return out

@borrows
fn typedExprImportedModuleCloneOwned(
        item: TypedExprImportedModule): TypedExprImportedModule =
    var out: TypedExprImportedModule
    out.qualifier = strings.CloneStr(item.qualifier)
    out.targetSourcePath = strings.CloneStr(item.targetSourcePath)
    out.allowsUnqualifiedCall = item.allowsUnqualifiedCall
    return out

@borrows
fn typedExprTypeFieldDeclCloneOwned(
        item: TypedExprTypeFieldDecl): TypedExprTypeFieldDecl =
    var out: TypedExprTypeFieldDecl
    out.ownerType = strings.CloneStr(item.ownerType)
    out.fieldName = strings.CloneStr(item.fieldName)
    out.fieldType = strings.CloneStr(item.fieldType)
    out.producerSourceIndex = item.producerSourceIndex
    out.ownerDeclarationSourceLocalRow = item.ownerDeclarationSourceLocalRow
    out.fieldDeclarationSourceLocalRow = item.fieldDeclarationSourceLocalRow
    out.ordinal = item.ordinal
    out.builtinKind = item.builtinKind
    out.offsetBytes = item.offsetBytes
    out.sizeBytes = item.sizeBytes
    out.alignBytes = item.alignBytes
    return out

@borrows
fn typedExprCloneOwnedSourcePathIndexLookupInto(
        dst: var parser.ParserSourcePathIndexLookup,
        src: parser.ParserSourcePathIndexLookup) =
    if src.slots.len == 0 && src.buckets.len == 0:
        dst = parser.ParserSourcePathIndexLookup()
        return
    dst = parser.ParserSourcePathIndexLookupInit(src.slots.len)
    for bucketIndex in 0..<src.buckets.len:
        let items = src.buckets[bucketIndex].items
        for itemIndex in 0..<items.len:
            parser.ParserSourcePathIndexLookupInsertExact(
                dst,
                strings.CloneStr(items[itemIndex].sourcePath),
                items[itemIndex].profileIndex)

@borrows
fn TypedExprAttachStableMetadataToRebuildContext(ctx: var TypedExprSourceContext,
                                                 metadataCtx: TypedExprSourceContext) =
    let frozenProjection = metadataCtx.frozenMetadataProjection
    let frozenContextIndex = metadataCtx.frozenMetadataContextIndex
    if (frozenProjection == nil && frozenContextIndex >= 0) ||
       (frozenProjection != nil && frozenContextIndex < 0):
        panic("typed expr: stable metadata frozen identity is partial")
    if metadataCtx.buildIndexOwned:
        TypedExprSourceContextBorrowBuildIndexFromOwner(ctx, metadataCtx)
    else:
        TypedExprSourceContextSetBorrowedBuildIndex(ctx, metadataCtx.buildIndex)
    ctx.frozenMetadataProjection = share(frozenProjection)
    ctx.frozenMetadataContextIndex = frozenContextIndex
    ctx.packageOwnerKey = strings.CloneStr(metadataCtx.packageOwnerKey)
    if metadataCtx.frozenMetadataProjection != nil:
        let producerContextIndex =
            metadataCtx.frozenMetadataContextIndex
        if producerContextIndex < 0 ||
           producerContextIndex >= metadataCtx.frozenMetadataProjection.sourceIndexProducerFullTraversalCounts.len:
            panic(Fmt"typed expr: frozen source index producer telemetry missing source={metadataCtx.sourcePath}")
        ctx.sourceIndexProducerFullTraversalCount =
            metadataCtx.frozenMetadataProjection.sourceIndexProducerFullTraversalCounts[
                producerContextIndex]
    else:
        ctx.sourceIndexProducerFullTraversalCount =
            metadataCtx.sourceIndexProducerFullTraversalCount
    if frozenProjection != nil:
        # Frozen rounds borrow every global/import/type/layout/signature domain
        # through the canonical SoA projection and compact BuildIndex. Only the
        # selected function-scope rows are materialized by BuildRoundViews.
        ctx.snapshotOnly = true
        return
    # exe 可达裁剪轮次：BuildSourceContextBorrowed 的签名过滤门让 ctx.scopes 只含
    # 本轮新可达函数，同文件 helper（如 BackendDriverDispatchMinNowNs）的返回型
    # 查询落空 → BuildRhsWholeCallNode -1 → whole_call_no_trace → rhsNodeIndex=-1
    # → 后端字段赋值 RHS 无节点可求值落 bail_712（dispatch_min 8 个 Emit 入口）。
    # metadata context 的 scopes 是无过滤的全量结构化签名表，挂到
    # signatureScopes 供声明索引与本地存在性查询使用；不并入 ctx.scopes，
    # 本轮 body/binding 构建范围不变。
    ctx.signatureScopes = []
    for scopeIndex in 0..<metadataCtx.scopes.len:
        add(ctx.signatureScopes,
            typedExprFunctionScopeCloneOwned(metadataCtx.scopes[scopeIndex]))
    if metadataCtx.snapshotOnly:
        ctx.snapshotOnly = true
    ctx.importcFunctions = []
    for importcIndex in 0..<metadataCtx.importcFunctions.len:
        add(ctx.importcFunctions,
            typedExprImportcFunctionCloneOwned(
                metadataCtx.importcFunctions[importcIndex]))
    ctx.importedModules = []
    for moduleIndex in 0..<metadataCtx.importedModules.len:
        add(ctx.importedModules,
            typedExprImportedModuleCloneOwned(
                metadataCtx.importedModules[moduleIndex]))
    ctx.declaredTypes = []
    typedExprCloneStrColRec(ctx.declaredTypes, metadataCtx.declaredTypes, 0)
    ctx.declaredTypeProducerSourceIndexes = []
    typedExprCloneI32ColRec(ctx.declaredTypeProducerSourceIndexes,
                            metadataCtx.declaredTypeProducerSourceIndexes, 0)
    ctx.declaredTypeDeclarationSourceLocalRows = []
    typedExprCloneI32ColRec(ctx.declaredTypeDeclarationSourceLocalRows,
                            metadataCtx.declaredTypeDeclarationSourceLocalRows, 0)
    ctx.declaredTypeBuiltinKinds = []
    typedExprCloneI32ColRec(ctx.declaredTypeBuiltinKinds,
                            metadataCtx.declaredTypeBuiltinKinds, 0)
    ctx.refTypes = []
    typedExprCloneStrColRec(ctx.refTypes, metadataCtx.refTypes, 0)
    ctx.typeDefAliasNames = []
    typedExprCloneStrColRec(ctx.typeDefAliasNames,
                            metadataCtx.typeDefAliasNames, 0)
    ctx.typeDefAliasTargetTypes = []
    typedExprCloneStrColRec(ctx.typeDefAliasTargetTypes,
                            metadataCtx.typeDefAliasTargetTypes, 0)
    ctx.typeFields = []
    for fieldIndex in 0..<metadataCtx.typeFields.len:
        add(ctx.typeFields,
            typedExprTypeFieldDeclCloneOwned(metadataCtx.typeFields[fieldIndex]))
    ctx.enumValueNames = []
    typedExprCloneStrColRec(ctx.enumValueNames, metadataCtx.enumValueNames, 0)
    ctx.enumValueTypes = []
    typedExprCloneStrColRec(ctx.enumValueTypes, metadataCtx.enumValueTypes, 0)
    ctx.enumValueOrdinals = []
    typedExprCloneI32ColRec(ctx.enumValueOrdinals,
                            metadataCtx.enumValueOrdinals, 0)
    ctx.moduleConstScanned = metadataCtx.moduleConstScanned
    typedExprCloneOwnedSourcePathIndexLookupInto(
        ctx.moduleConstLookup, metadataCtx.moduleConstLookup)
    ctx.moduleConstNames = []
    typedExprCloneStrColRec(ctx.moduleConstNames,
                            metadataCtx.moduleConstNames, 0)
    ctx.moduleConstLiterals = []
    typedExprCloneStrColRec(ctx.moduleConstLiterals,
                            metadataCtx.moduleConstLiterals, 0)
    ctx.moduleConstLookupTransientPeakBytes =
        metadataCtx.moduleConstLookupTransientPeakBytes
    ctx.moduleConstLookupFinalized = metadataCtx.moduleConstLookupFinalized
    ctx.functionHeaderScanned = metadataCtx.functionHeaderScanned
    typedExprCloneOwnedSourcePathIndexLookupInto(
        ctx.functionHeaderLookup, metadataCtx.functionHeaderLookup)
    ctx.functionHeaderNames = []
    typedExprCloneStrColRec(ctx.functionHeaderNames,
                            metadataCtx.functionHeaderNames, 0)
    ctx.functionHeaderReturnTypes = []
    typedExprCloneStrColRec(ctx.functionHeaderReturnTypes,
                            metadataCtx.functionHeaderReturnTypes, 0)

fn typedExprAttachParserOwnedGlobalBindings(ctx: var TypedExprSourceContext,
                                            metadataCtx: var TypedExprSourceContext) =
    # parser-owned 全局身份行 (producerSourceIndex / declarationSourceLocalRow)
    # 由 metadata context 持有: compiler csg 的
    # CompilerCsgBindMetadataGlobalParserIdentities 已从 parser sidecar 绑定。
    # 重建上下文的裸扫描全局行无 parser 身份 (-1), 必须用权威行整体替换,
    # 否则 TypedIR 全局 parser 身份列不全 (compiler csg 闸
    # "TypedIR global parser identity columns are incomplete")。
    var stableBindings: TypedExprBinding[]
    for bindingIndex in 0..<ctx.bindings.len:
        let binding = ctx.bindings[bindingIndex]
        if binding.globalFlag:
            continue
        add(stableBindings, typedExprBindingCloneOwned(binding))
    if metadataCtx.frozenMetadataProjection != nil:
        # Global value-def identities were committed before seal and immutable
        # lookup now reads the projection. Re-copying all globals per function
        # round would restore the eliminated quadratic edge.
        ctx.bindings = stableBindings
        ctx.bindingNameIndexBuiltCount = -1
        TypedExprBindingNameIndexPrepare(ctx)
        return
    for bindingIndex in 0..<metadataCtx.bindings.len:
        var binding = typedExprBindingCloneOwned(metadataCtx.bindings[bindingIndex])
        if !binding.globalFlag || binding.functionName != "":
            panic(Fmt"typed expr: metadata context retained a non-global binding source={ctx.sourcePath} row={bindingIndex}")
        binding.sourcePath = strings.CloneStr(ctx.sourcePath)
        add(stableBindings, binding)
    ctx.bindings = stableBindings
    ctx.bindingNameIndexBuiltCount = -1
    TypedExprBindingNameIndexPrepare(ctx)

@borrows
fn TypedExprBuildFactsSelectedRangesForExprRange(
        sourcePathRaw: str,
        scopes: TypedExprFunctionScope[],
        exprLayer: parser.NormalizedExprLayer,
        exprStart: int32,
        exprEnd: int32,
        selectedScopeIndexes: var int32[],
        selectedLineStarts: var int32[],
        selectedLineCounts: var int32[]) =
    selectedScopeIndexes = []
    selectedLineStarts = []
    selectedLineCounts = []
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    for exprIndex in exprStart..<exprEnd:
        if exprIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if exprIndex < 0 || exprIndex >= exprLayer.exprs.len:
            continue
        let expr = exprLayer.exprs[exprIndex]
        if !TypedExprExprRequiresPersistentFact(expr):
            continue
        if parser.ParserNormalizePath(expr.sourcePath) != sourcePath:
            continue
        let scopeIndex = TypedExprScopeIndexForLine(scopes, expr.lineNumber)
        if scopeIndex < 0 || scopeIndex >= scopes.len:
            continue
        if selectedScopeIndexes.len <= 0 ||
           selectedScopeIndexes[selectedScopeIndexes.len - 1] != scopeIndex:
            add(selectedScopeIndexes, scopeIndex)
            add(selectedLineStarts, scopes[scopeIndex].startLine)
            add(selectedLineCounts,
                scopes[scopeIndex].endLine - scopes[scopeIndex].startLine + 1)

@borrows
fn TypedExprBuildFactsSelectedRangesForFunctionRangeUnion(
        sourcePathRaw: str,
        scopes: TypedExprFunctionScope[],
        functionIndexes: int32[],
        functionSourcePaths: str[],
        functionStartLines: int32[],
        functionEndLines: int32[],
        functionSelected: bool[],
        functionSelectionActive: bool,
        functionRangeStart: int32,
        functionRangeEnd: int32,
        selectedScopeIndexes: var int32[],
        selectedLineStarts: var int32[],
        selectedLineCounts: var int32[],
        err: var str): bool =
    selectedScopeIndexes = []
    selectedLineStarts = []
    selectedLineCounts = []
    if functionSourcePaths.len != functionStartLines.len ||
       functionSourcePaths.len != functionEndLines.len ||
       functionSourcePaths.len != functionSelected.len:
        err = Fmt" typed expr: function range union columns mismatch sources={functionSourcePaths.len} starts={functionStartLines.len} ends={functionEndLines.len} selected={functionSelected.len}"
        return false
    if functionRangeStart < 0 ||
       functionRangeEnd < functionRangeStart ||
       functionRangeEnd > functionIndexes.len:
        err = Fmt" typed expr: function range union bounds invalid start={functionRangeStart} end={functionRangeEnd} rows={functionIndexes.len}"
        return false
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    for functionRowIndex in functionRangeStart..<functionRangeEnd:
        if functionRowIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let functionIndex = functionIndexes[functionRowIndex]
        if functionIndex < 0 || functionIndex >= functionSourcePaths.len:
            err = Fmt" typed expr: function range union identity index invalid row={functionRowIndex} function_index={functionIndex} functions={functionSourcePaths.len}"
            return false
        if parser.ParserNormalizePath(functionSourcePaths[functionIndex]) != sourcePath:
            err = Fmt" typed expr: function range union source-scoped index mismatch source={sourcePathRaw} function_source={functionSourcePaths[functionIndex]} row={functionRowIndex} function_index={functionIndex}"
            return false
        if functionSelectionActive && !functionSelected[functionIndex]:
            continue
        let startLine = functionStartLines[functionIndex]
        let endLine = functionEndLines[functionIndex]
        if startLine <= 0 || endLine < startLine:
            err = Fmt" typed expr: function range union line bounds invalid source={sourcePathRaw} function_index={functionIndex} start={startLine} end={endLine}"
            return false
        let scopeIndex = TypedExprScopeIndexForLine(scopes, startLine)
        if scopeIndex < 0 || scopeIndex >= scopes.len ||
           scopes[scopeIndex].startLine != startLine ||
           scopes[scopeIndex].endLine != endLine:
            err = Fmt" typed expr: function range union scope identity mismatch source={sourcePathRaw} function_index={functionIndex} start={startLine} end={endLine} scope_index={scopeIndex}"
            return false
        if selectedLineStarts.len > 0:
            let previousEnd = selectedLineStarts[selectedLineStarts.len - 1] +
                              selectedLineCounts[selectedLineCounts.len - 1] - 1
            if startLine <= previousEnd:
                err = Fmt" typed expr: function range union is not canonical source={sourcePathRaw} function_index={functionIndex} start={startLine} previous_end={previousEnd}"
                return false
        add(selectedScopeIndexes, scopeIndex)
        add(selectedLineStarts, startLine)
        add(selectedLineCounts, endLine - startLine + 1)
    err = ""
    return true

fn TypedExprClearSourceContextAllFields(ctx: var TypedExprSourceContext) =
    # [orcd8-inst] 诊断探针（env=CHENG_ORCD8_TRACE，默认零输出零行为差）
    # [orcd9-inst] 盲区列扩展：O8CLEAR 增 ref/str/lookup 盲区列内联头状态
    # （bIdx/proj=nil 判定，nsp/pok=str 长度，msl/mbl/fsl/fbl=lookup 子列长；
    # 不读 ref 指向字段，防悬挂读把 registry_miss 转换成 segfault）。
    # O9S=n = 46 个托管释放动作的步进标记：registry_miss 前最后一条 O9S
    # 编号 = 致命动作。
    if orcd8TraceEnabled():
        var o9BIdx: int32
        var o9Proj: int32
        if ctx.buildIndex != nil:
            o9BIdx = 1
        if ctx.frozenMetadataProjection != nil:
            o9Proj = 1
        os.WriteLine(os.Get_stderr(),
                     Fmt"O8CLEAR src={ctx.sourcePath} names={ctx.moduleConstNames.len} lits={ctx.moduleConstLiterals.len} lines={ctx.lines.len} scopes={ctx.scopes.len} binds={ctx.bindings.len} sig={ctx.signatureScopes.len} bIdx={o9BIdx} proj={o9Proj} nsp={ctx.normalizedSourcePath.len} pok={ctx.packageOwnerKey.len} msl={ctx.moduleConstLookup.slots.len} mbl={ctx.moduleConstLookup.buckets.len} fsl={ctx.functionHeaderLookup.slots.len} fbl={ctx.functionHeaderLookup.buckets.len}")
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O9S=1")
    TypedExprSourceContextReleaseBuildIndex(ctx)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O9S=2")
    ctx.frozenMetadataProjection = nil
    ctx.frozenMetadataContextIndex = -1
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O9S=3")
    ctx.sourcePath = ""
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O9S=4")
    ctx.normalizedSourcePath = ""
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O9S=5")
    ctx.packageOwnerKey = ""
    ctx.snapshotOnly = false
    ctx.factsFunctionRangeUnionBuildCount = 0
    ctx.factsFullSourceRescanCount = 0
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O9S=6")
    ctx.lineNumbers = []
    ctx.sourceLineCount = 0
    ctx.sourceByteLength = 0
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O9S=7")
    ctx.sourceLineByteStarts = []
