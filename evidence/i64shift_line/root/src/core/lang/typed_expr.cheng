    projection.declaredTypeDeclarationSourceLocalRows = []
    projection.declaredTypeBuiltinKinds = []
    projection.declaredBuildEntryIndexes = []
    projection.refStarts = []
    projection.refCounts = []
    projection.refTypeIds = []
    projection.refBuildEntryIndexes = []
    projection.aliasStarts = []
    projection.aliasCounts = []
    projection.aliasNameIds = []
    projection.aliasTargetTypeIds = []
    projection.aliasBuildEntryIndexes = []
    projection.fieldStarts = []
