        return true
    if typedExprSharedMetadataColumnInto(
           ctx.bindingNameIndexEntryNames, 28, "bindingNameIndexEntryNames",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.bindingNameIndexEntryBindingIndexes, 29,
           "bindingNameIndexEntryBindingIndexes",
