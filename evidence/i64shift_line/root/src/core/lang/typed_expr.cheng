fn TypedExprSealedBuildIndexCanonicalDigest(ir: var TypedExprIr): str =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "canonical digest telemetry")
    if session == nil:
        return ""
    return Fmt"{session.canonicalDigestFirst}:{session.canonicalDigestSecond}"

fn TypedExprSealedBuildIndexActive(ir: var TypedExprIr): bool =
    let session = typedExprMetadataSessionForTelemetry(ir, "active telemetry")
    return session != nil && !session.closed && !session.released

fn TypedExprSealedBuildIndexClosed(ir: var TypedExprIr): bool =
    let session = typedExprMetadataSessionForTelemetry(ir, "closed telemetry")
    return session != nil && session.closed && !session.released

@borrows
fn TypedExprBuildIndexStringArrayBytes(items: str[],
                                        retainedCapacity: bool): int64 =
    # Slot capacity is structural. Payload len is a deterministic logical
    # estimate only: ORC sharing and allocator rounding make it neither an
    # ownership-exact byte count nor process RSS.
    let slots = retainedCapacity ? items.cap : items.len
    var total = typedExprCheckedMul64(Int64(slots), 24,
                                      "string_array_slots")
    for i in 0..<items.len:
        total = typedExprCheckedAdd64(total, Int64(items[i].len),
                                      "string_array_payload")
    return total

@borrows
fn typedExprStringPayloadBytes(items: str[]): int64 =
    var total: int64
    for itemIndex in 0..<items.len:
        total = typedExprCheckedAdd64(total, Int64(items[itemIndex].len),
                                      "semantic_text_payload")
    return total

@borrows
fn typedExprBuildIndexOwnedSemanticTextBytes(index: TypedExprBuildIndex): int64 =
    if index == nil || index.released:
        return 0
    var total: int64
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.entryKinds), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.entrySourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.entryNames), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.entryDetails), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.entryOrigins), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.entryFingerprints), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityKinds), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilitySourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityNames), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityDetails), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityFingerprints), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.importOwnerSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityQueryOwnerSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityQueryKinds), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityQueryNames), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityQueryDetails), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.visibilityQueryFingerprints), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.contentCacheKinds), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.contentCacheSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.contentCacheNames), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.contentCacheValues), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.callDeclarationSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.callDeclarationNames), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.callDeclarationGenericNames), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.callDeclarationParamTypes), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.callDeclarationReturnTypes), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.callDeclarationTargetSymbols), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.contextSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.contextFieldOwnerSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.contextFieldOwnerTypes), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.fieldOwnerSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.fieldOwnerTypes), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.layoutSourcePaths), "semantic_text_total")
    total = typedExprCheckedAdd64(total, typedExprStringPayloadBytes(index.layoutTypeNames), "semantic_text_total")
    total = typedExprCheckedAdd64(total, Int64(index.hardError.len),
                                  "semantic_text_total")
    return total

@borrows
fn typedExprDerivedIrEntryKind(kind: str): bool =
    return kind.len >= 3 && chengpath.TextSlice(kind, 0, 3) == "ir_"

@borrows
fn typedExprDerivedCanonicalMetadataDuplicateBytes(
        index: TypedExprBuildIndex): int64 =
    if index == nil || index.released:
        return 1
    if index.compactCanonical || index.canonicalProjection == nil ||
       index.canonicalProjection.released ||
       index.entryKindIds.len != index.entryKinds.len ||
       index.entrySourcePathIds.len != index.entryKinds.len ||
       index.entryNameIds.len != index.entryKinds.len ||
       index.entryDetailIds.len != index.entryKinds.len ||
       index.entryOriginIds.len != index.entryKinds.len ||
       index.entryFingerprintIds.len != index.entryKinds.len ||
       index.fieldOwnerSourcePathIds.len !=
           index.fieldOwnerSourcePaths.len ||
       index.fieldOwnerTypeIds.len != index.fieldOwnerSourcePaths.len ||
       index.layoutSourcePathIds.len != index.layoutSourcePaths.len ||
       index.layoutTypeNameIds.len != index.layoutSourcePaths.len:
        return 1
    var total: int64
    for rowIndex in 0..<typedExprBuildIndexEntryCount(index):
        let entryKind = typedExprBuildIndexEntryKind(index, rowIndex)
        if typedExprDerivedIrEntryKind(entryKind):
            continue
        total = typedExprCheckedAdd64(total, 1,
                                      "derived_metadata_duplicate")
        total = typedExprCheckedAdd64(total,
            Int64(entryKind.len),
            "derived_metadata_duplicate")
        total = typedExprCheckedAdd64(total,
            Int64(typedExprBuildIndexEntrySourcePath(index, rowIndex).len),
            "derived_metadata_duplicate")
        total = typedExprCheckedAdd64(total,
            Int64(typedExprBuildIndexEntryName(index, rowIndex).len),
            "derived_metadata_duplicate")
        total = typedExprCheckedAdd64(total,
            Int64(typedExprBuildIndexEntryDetail(index, rowIndex).len),
            "derived_metadata_duplicate")
        total = typedExprCheckedAdd64(total,
            Int64(typedExprBuildIndexEntryOrigin(index, rowIndex).len),
            "derived_metadata_duplicate")
        total = typedExprCheckedAdd64(total,
            Int64(typedExprBuildIndexEntryFingerprint(index, rowIndex).len),
            "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityKinds),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilitySourcePaths),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityNames),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityDetails),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityFingerprints),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.importOwnerSourcePaths),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.callDeclarationSourcePaths),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.callDeclarationNames),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.callDeclarationGenericNames),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.callDeclarationParamTypes),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.callDeclarationReturnTypes),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.callDeclarationTargetSymbols),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.contextSourcePaths),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.contextFieldOwnerSourcePaths),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.contextFieldOwnerTypes),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityQueryOwnerSourcePaths),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityQueryKinds),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityQueryNames),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityQueryDetails),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.visibilityQueryFingerprints),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.contentCacheKinds),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.contentCacheSourcePaths),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.contentCacheNames),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(total,
        typedExprStringPayloadBytes(index.contentCacheValues),
        "derived_metadata_duplicate")
    # The derived index may own IR entry/field/layout rows. Every canonical id,
    # visibility/call/context/cache row is metadata duplication even when its
    # string happens to be empty, so structural columns are charged as well.
    var structuralItems: int64
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.visibilityKindIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.visibilitySourcePathIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.visibilityNameIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.visibilityDetailIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.visibilityFingerprintIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.importOwnerSourcePathIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contentCacheKindIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contentCacheSourcePathIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contentCacheNameIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contentCacheValueIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationSourcePathIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationNameIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationGenericNameIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationParamTypeIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationReturnTypeIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationTargetSymbolIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contextSourcePathIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contextFieldOwnerSourcePathIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contextFieldOwnerTypeIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.visibilityNext.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.importOwnerNext.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.importOwnerTargetHeads.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.importTargetNext.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.importTargetEntryIndexes.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.visibilityQueryNext.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contentCacheNext.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationSignatureLineNumbers.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationKinds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationResultExprClasses.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationProducerSourceIndexes.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationProducerDeclarationOrdinals.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationProducerFunctionRows.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationManualConsumeFunctionDeclarationRows.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationManualConsumeTargetParameterOrdinals.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationManualConsumeSourceParameterOrdinals.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationManualConsumeTargetParameterDeclarationRows.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationManualConsumeSourceParameterDeclarationRows.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationManualConsumeTargetTypeIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.callDeclarationManualConsumeSourceTypeIds.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contextSourcePaths.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contextMetadataDomainCounts.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contextFieldOwnerNext.len), "derived_metadata_structural_items")
    structuralItems = typedExprCheckedAdd64(structuralItems, Int64(index.contextFieldNodeNext.len), "derived_metadata_structural_items")
    if index.compactCanonical:
        structuralItems = typedExprCheckedAdd64(
            structuralItems, 1, "derived_metadata_structural_items")
    if structuralItems > 0:
        total = typedExprCheckedAdd64(
            total,
            typedExprCheckedMul64(structuralItems, 4,
                                  "derived_metadata_structural_bytes"),
            "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(
        total,
        Int64(index.callDeclarationManualConsumePresents.len),
        "derived_metadata_duplicate")
    total = typedExprCheckedAdd64(
        total,
        typedExprCheckedMul64(
            Int64(index.callDeclarationManualConsumeEffectCids.len),
            32,
            "derived_metadata_manual_consume_cid_bytes"),
        "derived_metadata_duplicate")
    return total

@borrows
fn typedExprPostSealDuplicatedSemanticTextBytes(
        session: typedExprFrozenMetadataSession,
        derivedIndex: TypedExprBuildIndex): int64 =
    if session == nil:
        return 0
    if session.closed || session.released:
        return session.duplicatedSemanticTextBytes
    if session.index == nil || session.index.released ||
       derivedIndex == nil || derivedIndex.released:
        return 1
    var total = typedExprCheckedAdd64(
        typedExprBuildIndexOwnedSemanticTextBytes(session.index),
        typedExprDerivedCanonicalMetadataDuplicateBytes(derivedIndex),
        "post_seal_duplicated_semantic_text_bytes")
    total = typedExprCheckedAdd64(
        total,
        typedExprDerivedIrCanonicalTextOverlapBytes(derivedIndex,
                                                     session.projection),
        "post_seal_duplicated_semantic_text_bytes")
    return total

@borrows
fn typedExprProjectionOwnedTextOverlapBytes(
        pool: langintern.InternPool,
        value: str,
        probe: var langintern.InternLookupProbe): int64 =
    let textId = langintern.FindInternIdWithProbe(pool, value, probe)
    if value == "" || textId < 0:
        return 0
    return Int64(value.len)

@borrows
fn typedExprProjectionOverlapTextBytes(pool: langintern.InternPool,
                                       values: str[],
                                       probe: var langintern.InternLookupProbe): int64 =
    var total: int64
    for valueIndex in 0..<values.len:
        total = typedExprCheckedAdd64(
            total,
            typedExprProjectionOwnedTextOverlapBytes(pool,
                                                     values[valueIndex],
                                                     probe),
            "derived_ir_text_overlap")
    return total

@borrows
fn typedExprDerivedIrCanonicalTextOverlapAudit(
        index: TypedExprBuildIndex,
        projection: typedExprFrozenMetadataProjection,
        probe: var langintern.InternLookupProbe): int64 =
    if index == nil || index.released || projection == nil ||
       projection.released || projection.internPool == nil:
        return 0
    var total: int64
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.entryKinds, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.entrySourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.entryNames, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.entryDetails, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.entryOrigins, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.entryFingerprints, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityKinds, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilitySourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityNames, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityDetails, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityFingerprints, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.importOwnerSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityQueryOwnerSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityQueryKinds, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityQueryNames, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityQueryDetails, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.visibilityQueryFingerprints, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.contentCacheKinds, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.contentCacheSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.contentCacheNames, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.contentCacheValues, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.callDeclarationSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.callDeclarationNames, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.callDeclarationGenericNames, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.callDeclarationParamTypes, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.callDeclarationReturnTypes, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.callDeclarationTargetSymbols, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.contextSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.contextFieldOwnerSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.contextFieldOwnerTypes, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.fieldOwnerSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.fieldOwnerTypes, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.layoutSourcePaths, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(total, typedExprProjectionOverlapTextBytes(projection.internPool, index.layoutTypeNames, probe), "derived_ir_text_overlap")
    total = typedExprCheckedAdd64(
        total,
        typedExprProjectionOwnedTextOverlapBytes(projection.internPool,
                                                index.hardError,
                                                probe),
        "derived_ir_text_overlap")
    return total

@borrows
fn typedExprDerivedIrCanonicalTextOverlapBytes(
        index: TypedExprBuildIndex,
        projection: typedExprFrozenMetadataProjection): int64 =
    var probe: langintern.InternLookupProbe
    return typedExprDerivedIrCanonicalTextOverlapAudit(index,
                                                       projection,
                                                       probe)

@borrows
fn TypedExprBuildIndexIntArrayBytes(items: int32[],
                                     retainedCapacity: bool): int64 =
    let slots = retainedCapacity ? items.cap : items.len
    return typedExprCheckedMul64(Int64(slots), 4, "int32_array_slots")

@borrows
fn TypedExprBuildIndexInternIdArrayBytes(items: langintern.InternId[],
                                         retainedCapacity: bool): int64 =
    let slots = retainedCapacity ? items.cap : items.len
    return typedExprCheckedMul64(Int64(slots), 4, "intern_id_array_slots")

@borrows
fn TypedExprBuildIndexStateArrayBytes(items: TypedExprBuildIndexLookupState[],
                                       retainedCapacity: bool): int64 =
    let slots = retainedCapacity ? items.cap : items.len
    return typedExprCheckedMul64(Int64(slots), 4, "state_array_slots")

@borrows
fn TypedExprBuildIndexCallDeclarationKindArrayBytes(items: TypedExprCallDeclarationKind[],
                                                     retainedCapacity: bool): int64 =
    let slots = retainedCapacity ? items.cap : items.len
    return typedExprCheckedMul64(Int64(slots), 4,
                                 "call_declaration_kind_slots")

@borrows
fn TypedExprBuildIndexExprClassArrayBytes(items: TypedExprExprClass[],
                                           retainedCapacity: bool): int64 =
    let slots = retainedCapacity ? items.cap : items.len
    return typedExprCheckedMul64(Int64(slots), 4,
                                 "expression_class_slots")

@borrows
fn TypedExprBuildIndexBoolArrayBytes(items: bool[],
                                      retainedCapacity: bool): int64 =
    let slots = retainedCapacity ? items.cap : items.len
    return Int64(slots)

@borrows
fn TypedExprBuildIndexFixedBytes32ArrayBytes(
        items: layout.FixedBytes32[],
        retainedCapacity: bool): int64 =
    let slots = retainedCapacity ? items.cap : items.len
    return typedExprCheckedMul64(
        Int64(slots), 32, "fixed_bytes32_array_slots")

fn TypedExprBuildIndexObjectBytes(): int64 =
    # arm64 Cheng ABI retained approximation, including the compact canonical
    # intern-id columns, the projection owner reference and the [D-B2a]
    # streaming intern pool reference. Manual-consume adds nine 24-byte
    # sequence descriptors; its bound bit shares the existing trailing
    # bool/padding region.
    return Int64(2392)

# This is the single field inventory for logical and retained accounting.
# Every owned sequence appears in exactly one section. Retained mode charges
# sequence backing capacity; string payloads add logical len only. The result is
# a deterministic retained approximation for compiler ledgers, never exact RSS.
@borrows
fn TypedExprBuildIndexMeasureLiveBytesMode(index: TypedExprBuildIndex,
                                            retainedCapacity: bool): TypedExprBuildIndexLiveByteReport =
    var out: TypedExprBuildIndexLiveByteReport
    if index == nil:
        return out
    # A released ref shell remains an allocated live object while the caller
    # still holds it. Its cleared columns measure zero, but the owner object
    # itself must remain in the retained-byte inventory.
    out.objectBytes = TypedExprBuildIndexObjectBytes()

    out.bucketBytes = out.bucketBytes + TypedExprBuildIndexIntArrayBytes(index.entryBucketHeads, retainedCapacity)
    out.bucketBytes = out.bucketBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityBucketHeads, retainedCapacity)
    out.bucketBytes = out.bucketBytes + TypedExprBuildIndexIntArrayBytes(index.importOwnerBucketHeads, retainedCapacity)
    out.bucketBytes = out.bucketBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityQueryBucketHeads, retainedCapacity)
    out.bucketBytes = out.bucketBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldOwnerBucketHeads, retainedCapacity)
    out.bucketBytes = out.bucketBytes + TypedExprBuildIndexIntArrayBytes(index.fieldOwnerBucketHeads, retainedCapacity)
    out.bucketBytes = out.bucketBytes + TypedExprBuildIndexIntArrayBytes(index.layoutBucketHeads, retainedCapacity)

    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.entryNext, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.entryHashes, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexStateArrayBytes(index.entryStates, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.entryValueIndexes, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.entryValidationMarks, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityNext, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityHashes, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityValueIndexes, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.importOwnerNext, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.importOwnerHashes, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.importOwnerTargetHeads, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.importTargetNext, retainedCapacity)
    out.entryBytes = out.entryBytes + TypedExprBuildIndexIntArrayBytes(index.importTargetEntryIndexes, retainedCapacity)

    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.entryKinds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.entrySourcePaths, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.entryNames, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.entryDetails, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.entryOrigins, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.entryFingerprints, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityKinds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.visibilitySourcePaths, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityNames, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityDetails, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityFingerprints, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexStringArrayBytes(index.importOwnerSourcePaths, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.entryKindIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.entrySourcePathIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.entryNameIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.entryDetailIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.entryOriginIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.entryFingerprintIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.visibilityKindIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.visibilitySourcePathIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.visibilityNameIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.visibilityDetailIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.visibilityFingerprintIds, retainedCapacity)
    out.keyBytes = out.keyBytes + TypedExprBuildIndexInternIdArrayBytes(index.importOwnerSourcePathIds, retainedCapacity)
    # hardError is assigned only immediately before panic; no returned ledger
    # state can own a non-empty payload. Its string header is already included
    # in objectBytes, so adding payload bytes here would be unreachable.

    out.rootBytes = TypedExprBuildIndexStringArrayBytes(index.contextSourcePaths, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.contextMetadataDomainCounts, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationSortedRows, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexStringArrayBytes(index.callDeclarationSourcePaths, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexStringArrayBytes(index.callDeclarationNames, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationArities, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationGenericStarts, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationGenericCounts, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexStringArrayBytes(index.callDeclarationGenericNames, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationParamStarts, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationParamCounts, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexStringArrayBytes(index.callDeclarationParamTypes, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexStringArrayBytes(index.callDeclarationReturnTypes, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexStringArrayBytes(index.callDeclarationTargetSymbols, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationSignatureLineNumbers, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexCallDeclarationKindArrayBytes(index.callDeclarationKinds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexExprClassArrayBytes(index.callDeclarationResultExprClasses, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationProducerSourceIndexes, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationProducerDeclarationOrdinals, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationProducerFunctionRows, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexBoolArrayBytes(index.callDeclarationManualConsumePresents, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationManualConsumeFunctionDeclarationRows, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationManualConsumeTargetParameterOrdinals, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationManualConsumeSourceParameterOrdinals, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationManualConsumeTargetParameterDeclarationRows, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationManualConsumeSourceParameterDeclarationRows, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationManualConsumeTargetTypeIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexIntArrayBytes(index.callDeclarationManualConsumeSourceTypeIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexFixedBytes32ArrayBytes(index.callDeclarationManualConsumeEffectCids, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexInternIdArrayBytes(index.contextSourcePathIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexInternIdArrayBytes(index.callDeclarationSourcePathIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexInternIdArrayBytes(index.callDeclarationNameIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexInternIdArrayBytes(index.callDeclarationGenericNameIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexInternIdArrayBytes(index.callDeclarationParamTypeIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexInternIdArrayBytes(index.callDeclarationReturnTypeIds, retainedCapacity)
    out.rootBytes = out.rootBytes + TypedExprBuildIndexInternIdArrayBytes(index.callDeclarationTargetSymbolIds, retainedCapacity)

    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexIntArrayBytes(index.contentCacheBucketHeads, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexIntArrayBytes(index.contentCacheNext, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexIntArrayBytes(index.contentCacheHashes, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexStringArrayBytes(index.contentCacheKinds, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexStringArrayBytes(index.contentCacheSourcePaths, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexStringArrayBytes(index.contentCacheNames, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexStringArrayBytes(index.contentCacheValues, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.contentCacheKindIds, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.contentCacheSourcePathIds, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.contentCacheNameIds, retainedCapacity)
    out.contentCacheBytes = out.contentCacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.contentCacheValueIds, retainedCapacity)

    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldOwnerNext, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldOwnerHashes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.contextFieldOwnerSourcePaths, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.contextFieldOwnerTypes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.contextFieldOwnerSourcePathIds, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.contextFieldOwnerTypeIds, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldOwnerHeads, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldOwnerTails, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeNext, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeContextIndexes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeRowIndexes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeDeclaredOffsetBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeDeclaredSizeBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeDeclaredAlignBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeOffsetBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeSizeBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.contextFieldNodeAlignBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexBoolArrayBytes(index.contextFieldNodeLayoutReady, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.fieldOwnerNext, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.fieldOwnerHashes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.fieldOwnerSourcePaths, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.fieldOwnerTypes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.fieldOwnerSourcePathIds, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.fieldOwnerTypeIds, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.fieldOwnerHeads, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.fieldOwnerTails, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.fieldRowNext, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.layoutNext, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.layoutHashes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.layoutSourcePaths, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.layoutTypeNames, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.layoutSourcePathIds, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexInternIdArrayBytes(index.layoutTypeNameIds, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.layoutStates, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.layoutSizeBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.layoutAlignBytes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityQueryNext, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityQueryHashes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityQueryOwnerSourcePaths, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityQueryKinds, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityQueryNames, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityQueryDetails, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStateArrayBytes(index.visibilityQueryStates, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexIntArrayBytes(index.visibilityQueryValueIndexes, retainedCapacity)
    out.cacheBytes = out.cacheBytes + TypedExprBuildIndexStringArrayBytes(index.visibilityQueryFingerprints, retainedCapacity)

    # [D-B2a] the intern pool is real retained structure: its flat index
    # columns, text slots and the single logical payload instance per distinct
    # text. Column payload lens above stay a logical estimate (shared handles
    # double-count logical payload len; the pool term carries the physical
    # single instance once).
    if index.internPool != nil:
        var poolByteReport = langintern.InternPoolRetainedBytes(index.internPool)
        out.internPoolBytes = poolByteReport.structuredBytes +
                              poolByteReport.logicalPayloadBytes
    out.totalBytes = out.objectBytes + out.bucketBytes + out.entryBytes +
                     out.keyBytes + out.rootBytes + out.cacheBytes +
                     out.contentCacheBytes + out.internPoolBytes
    return out

@borrows
fn TypedExprBuildIndexLogicalLiveBytes(index: TypedExprBuildIndex): int64 =
    return TypedExprBuildIndexMeasureLiveBytesMode(index, false).totalBytes

@borrows
fn TypedExprIrBuildIndexLogicalLiveBytes(ir: TypedExprIr): int64 =
    return TypedExprBuildIndexLogicalLiveBytes(ir.buildIndex)

# Public deterministic retained-approximation report used by compiler/lowering
# lifetime ledgers. Sequence slots are structural; string payload and allocator
# overhead are estimated, so this API must not be reported as process RSS.
# A released shell contributes no object bytes, but its columns are still
# measured so a missed clear cannot be hidden by the lifecycle flag.
@borrows
fn TypedExprBuildIndexMeasureLiveBytes(index: TypedExprBuildIndex): TypedExprBuildIndexLiveByteReport =
    return TypedExprBuildIndexMeasureLiveBytesMode(index, true)

@borrows
fn TypedExprBuildIndexStructuredLiveBytes(index: TypedExprBuildIndex): int64 =
    return TypedExprBuildIndexMeasureLiveBytes(index).totalBytes

@borrows
fn TypedExprIrBuildIndexStructuredLiveBytes(ir: TypedExprIr): int64 =
    return TypedExprBuildIndexStructuredLiveBytes(ir.buildIndex)

@borrows
fn TypedExprBuildIndexLiveBytes(index: TypedExprBuildIndex): int64 =
    return TypedExprBuildIndexStructuredLiveBytes(index)

@borrows
fn typedExprFrozenScopeLiveBytes(rows: typedExprFrozenScopeSoA): int64 =
    var total: int64
    total = total + TypedExprBuildIndexIntArrayBytes(rows.contextStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.contextCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.nameIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.producerDeclarationOrdinals, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.startLines, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.endLines, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.returnTypeIds, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(rows.borrowResults, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(
        rows.borrowsArguments, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(
        rows.manualConsumePresents, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        rows.manualConsumeFunctionDeclarationRows, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        rows.manualConsumeTargetParameterOrdinals, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        rows.manualConsumeSourceParameterOrdinals, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        rows.manualConsumeTargetParameterDeclarationRows, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        rows.manualConsumeSourceParameterDeclarationRows, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        rows.manualConsumeTargetTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        rows.manualConsumeSourceTypeIds, true)
    total = total + TypedExprBuildIndexFixedBytes32ArrayBytes(
        rows.manualConsumeEffectCids, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.genericStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.genericCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.genericNameIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.paramStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.paramCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.paramTypeIds, true)
    return total

@borrows
fn typedExprFrozenImportcLiveBytes(rows: typedExprFrozenImportcSoA): int64 =
    var total: int64
    total = total + TypedExprBuildIndexIntArrayBytes(rows.contextStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.contextCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.nameIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.producerDeclarationOrdinals, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.targetIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.returnTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.paramStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.paramCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.paramTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.ffiMapPtrArgs, true)
    total = total + TypedExprBuildIndexIntArrayBytes(rows.ffiMapLenArgs, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.ffiOutPtrArgIds, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(rows.abiInternals, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(rows.ffiOwnedResultPresents, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(rows.ffiOwnedResultFreeIds, true)
    return total

@borrows
fn typedExprFrozenProjectionLiveBytes(projection: typedExprFrozenMetadataProjection): int64 =
    if projection == nil || projection.released:
        return 0
    # The two inline scope/signature SoA shells each gained nine 24-byte
    # manual-consume sequence descriptors.
    var total: int64 = 1528
    if projection.internPool != nil:
        total = total + TypedExprBuildIndexStringArrayBytes(projection.internPool.texts,
                                                             true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.contextBucketHeads, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.contextNext, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.contextHashes, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.rawSourcePathIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.normalizedSourcePathIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.packageOwnerIds, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(projection.snapshotOnly, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.contextBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.contextMetadataRowCounts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.sourceIndexProducerFullTraversalCounts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.sourceByteLengths, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.sourceLineStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.sourceLineCounts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.sourceLineByteStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.sourceLineByteLengths, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.sourceLineOverrideIndexes, true)
    total = total + TypedExprBuildIndexStringArrayBytes(projection.sourceLineOverrideTexts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.globalBindingStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.globalBindingCounts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.globalBindingLineNumbers, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.globalBindingNameIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.globalBindingTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.globalBindingProducerSourceIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.globalBindingDeclarationSourceLocalRows, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(projection.globalBindingMutableFlags, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.globalBindingInitValueIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.globalBindingBucketHeads, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.globalBindingNext, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.globalBindingHashes, true)
    total = total + typedExprFrozenScopeLiveBytes(projection.scopes)
    total = total + typedExprFrozenScopeLiveBytes(projection.signatures)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.scopeBucketHeads, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.scopeNext, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.scopeHashes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.signatureBucketHeads, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.signatureNext, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.signatureHashes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotFunctionBucketHeads, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotFunctionNext, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotFunctionHashes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotImportcBucketHeads, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotImportcNext, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotImportcHashes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotImportcContextIndexes, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.snapshotImportcNameIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.snapshotImportcRowIndexes, true)
    total = total + typedExprFrozenImportcLiveBytes(projection.importcs)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.importStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.importCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.importQualifierIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.importTargetSourcePathIds, true)
    total = total + TypedExprBuildIndexBoolArrayBytes(projection.importAllowsUnqualifiedCalls, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.importBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.importTargetBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.declaredStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.declaredCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.declaredTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.declaredTypeProducerSourceIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.declaredTypeDeclarationSourceLocalRows, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.declaredTypeBuiltinKinds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.declaredBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.refStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.refCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.refTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.refBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.aliasStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.aliasCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.aliasNameIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.aliasTargetTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.aliasBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.fieldStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.fieldCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.fieldOwnerTypeIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.fieldNameIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.fieldTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.fieldOffsetBytes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.fieldSizeBytes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.fieldAlignBytes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.fieldProducerSourceIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.fieldOwnerDeclarationSourceLocalRows, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.fieldDeclarationSourceLocalRows, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.fieldOrdinals, true)
    total = total + TypedExprBuildIndexIntArrayBytes(
        projection.fieldBuiltinKinds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.fieldBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.fieldBuildNodeIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.enumStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.enumCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.enumNameIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.enumTypeIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.enumOrdinals, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.enumNameBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.enumTypeBuildEntryIndexes, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.moduleConstStarts, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.moduleConstCounts, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.moduleConstNameIds, true)
    total = total + TypedExprBuildIndexInternIdArrayBytes(projection.moduleConstLiteralIds, true)
    total = total + TypedExprBuildIndexIntArrayBytes(projection.moduleConstBuildEntryIndexes, true)
    return total

fn TypedExprSealedBuildIndexMetadataLiveBytes(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(ir, "metadata live-byte telemetry")
    if session == nil:
        return 0
    var total = typedExprCheckedAdd64(session.canonicalIndexBytes,
                                      session.canonicalStoreBytes,
                                      "sealed_metadata_live_bytes")
    total = typedExprCheckedAdd64(total, session.roundViewLiveBytes,
                                  "sealed_metadata_live_bytes")
    return total

fn TypedExprSealedBuildIndexCanonicalIndexBytes(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "canonical index byte telemetry")
    if session == nil:
        return 0
    return session.canonicalIndexBytes

fn TypedExprSealedBuildIndexCanonicalStoreBytes(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "canonical store byte telemetry")
    if session == nil:
        return 0
    return session.canonicalStoreBytes

fn TypedExprSealedBuildIndexPreSealFullIndexBytes(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(
        ir, "pre-seal full index byte telemetry")
    if session == nil:
        return 0
    return session.preSealFullIndexBytes

fn TypedExprSealedBuildIndexDuplicatedSemanticTextBytes(
        ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(
        ir, "duplicated semantic text telemetry")
    if session == nil:
        return 0
    return typedExprPostSealDuplicatedSemanticTextBytes(session,
                                                        ir.buildIndex)

fn TypedExprSealedBuildIndexDerivedIrSemanticTextBytes(
        ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(
        ir, "derived IR semantic text telemetry")
    if session == nil:
        return 0
    if !session.closed && !session.released:
        return typedExprBuildIndexOwnedSemanticTextBytes(ir.buildIndex)
    return session.derivedIrSemanticTextBytes

fn TypedExprSealedBuildIndexDerivedIrCanonicalTextOverlapBytes(
        ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(
        ir, "derived IR canonical text overlap telemetry")
    if session == nil:
        return 0
    if !session.closed && !session.released:
        return typedExprDerivedIrCanonicalTextOverlapBytes(ir.buildIndex,
                                                            session.projection)
    return session.derivedIrCanonicalTextOverlapBytes

fn TypedExprTestDerivedIrCanonicalTextOverlapProbe(
        ir: var TypedExprIr,
        queryCount: var int64,
        bucketLookupCount: var int64,
        emptyLookupCount: var int64,
        linearTextScanStepCount: var int64): int64 =
    let session = typedExprRequireFrozenMetadataSession(
        ir, "test derived canonical text overlap probe")
    var probe: langintern.InternLookupProbe
    let overlapBytes = typedExprDerivedIrCanonicalTextOverlapAudit(
        ir.buildIndex, session.projection, probe)
    queryCount = probe.queryCount
    bucketLookupCount = probe.bucketLookupCount
    emptyLookupCount = probe.emptyLookupCount
    linearTextScanStepCount = probe.linearTextScanStepCount
    return overlapBytes

fn TypedExprSealedBuildIndexRoundViewLiveBytes(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "round view byte telemetry")
    if session == nil:
        return 0
    return session.roundViewLiveBytes

fn TypedExprSealedBuildIndexRoundPeakBytes(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "round peak byte telemetry")
    if session == nil:
        return 0
    return session.roundPeakBytes

fn TypedExprSealedBuildIndexRoundContextCount(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "round context telemetry")
    if session == nil:
        return 0
    return session.lastRoundContextCount

fn TypedExprSealedBuildIndexDependencyCount(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "round dependency telemetry")
    if session == nil:
        return 0
    return session.lastRoundDependencyCount

fn TypedExprSealedBuildIndexMetadataOwnerCount(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir,
                                                       "metadata owner telemetry")
    if session == nil || session.closed || session.released:
        return 0
    return typedExprCheckedAddInt32(
        2,
        typedExprCheckedAddInt32(session.roundContextCount,
                                 session.roundDependencyCount,
                                 "metadata_owner_count"),
        "metadata_owner_count")

fn TypedExprSealedBuildIndexFullContextCount(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir, "full context telemetry")
    if session == nil:
        return 0
    return session.fullContextCount

fn TypedExprSealedBuildIndexJoinedLookupKeyBytes(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(ir, "joined lookup key telemetry")
    if session == nil || session.projection == nil:
        return 0
    return session.projection.joinedLookupKeyBytes

fn TypedExprTestArmFrozenLateFailureAfterScope(ir: var TypedExprIr,
                                               scopeCount: int32) =
    if scopeCount <= 0:
        panic("typed expr: late failure injection scope count invalid")
    let session = typedExprRequireFrozenMetadataSession(
        ir, "test late failure arm")
    session.lateFailureAfterScopeCount = scopeCount
    session.lateFailureObserved = false

fn TypedExprTestFrozenLateFailureObserved(ir: var TypedExprIr): bool =
    let session = typedExprMetadataSessionForTelemetry(
        ir, "test late failure observation")
    return session != nil && session.lateFailureObserved

fn TypedExprTestAttemptSealedCanonicalMutation(ir: var TypedExprIr) =
    typedExprRequireFrozenMetadataSessionUniqueOwner(
        ir, "test canonical mutation")
    typedExprTestAttemptSealedCanonicalMutationWithSession(
        ir.typedExprMetadataSession)

@borrows
fn typedExprRequireFrozenMetadataSessionUniqueOwner(
        ir: TypedExprIr,
        operation: str) =
    let session = typedExprRequireFrozenMetadataSession(ir, operation)
    typedExprMetadataSessionOwnerCheck(session, operation)
    if memRefCount(session.index) != 1:
        panic(Fmt"typed expr: frozen metadata canonical index owner is shared by value assignment operation={operation}")

fn typedExprTestAttemptSealedCanonicalMutationWithSession(
        session: var typedExprFrozenMetadataSession) =
    if session == nil || session.index == nil:
        panic("typed expr: test canonical mutation missing exact session owner")
    let _state = TypedExprBuildIndexRegister(
        session.index,
        "ctx_test_forbidden",
        "test://sealed",
        "forbidden",
        "",
        0,
        "test://sealed",
        "forbidden",
        true)

@borrows
fn TypedExprTestRegisterDerivedBuildIndex(
        ir: var TypedExprIr,
        kind: str,
        sourcePath: str,
        name: str,
        detail: str,
        valueIndex: int32,
        origin: str,
        fingerprint: str,
        hardConflict: bool): TypedExprBuildIndexLookupState =
    if ir.buildIndex == nil:
        panic("typed expr: test derived build index missing exact IR owner")
    return TypedExprBuildIndexRegister(
        ir.buildIndex,
        kind,
        sourcePath,
        name,
        detail,
        valueIndex,
        origin,
        fingerprint,
        hardConflict)

fn TypedExprTestInjectDerivedCanonicalTextOverlap(ir: var TypedExprIr) =
    let session = typedExprRequireFrozenMetadataSession(
        ir, "test derived canonical text overlap")
    let index = ir.buildIndex
    for rowIndex in 0..<index.entrySourcePathIds.len:
        let textId = index.entrySourcePathIds[rowIndex]
        if textId < 0:
            continue
        let text = typedExprFrozenProjectionText(session.projection, textId)
        if text == "":
            continue
        index.entrySourcePaths[rowIndex] = text
        return
    panic("typed expr: test derived canonical text overlap has no borrowed text")

@borrows
fn TypedExprBuildIndexVisibilityKind(kind: str): bool =
    return kind == "ctx_import_declared" ||
           kind == "ctx_import_composite" ||
           kind == "ctx_import_ref" ||
           kind == "ctx_import_alias_def" ||
           kind == "ctx_import_enum_name" ||
           kind == "ctx_import_enum_name_type" ||
           kind == "ctx_import_enum_type" ||
           kind == "ctx_import_field_owner"

@borrows
fn TypedExprBuildIndexRehashEntries(index: TypedExprBuildIndex,
                                     minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for entryIndex in 0..<index.entryKinds.len:
        if entryIndex >= index.entryHashes.len:
            panic("typed expr: corrupt entry hash columns during rehash")
        let bucket = TypedExprBuildIndexBucket(index.entryHashes[entryIndex], heads.len)
        add(next, heads[bucket])
        heads[bucket] = entryIndex
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.entryBucketHeads = heads
    index.entryNext = next

@borrows
fn TypedExprBuildIndexEnsureEntryCapacity(index: TypedExprBuildIndex) =
    if index.entryBucketHeads.len <= 0:
        index.entryBucketHeads = TypedExprBuildIndexEmptyBuckets(16)
        return
    let nextItems = typedExprCheckedAdd64(Int64(index.entryKinds.len), 1,
                                          "entry_load_items")
    if typedExprCheckedMul64(nextItems, 4, "entry_load_items") <
       typedExprCheckedMul64(Int64(index.entryBucketHeads.len), 3,
                             "entry_load_buckets"):
        return
    TypedExprBuildIndexRehashEntries(index, index.entryBucketHeads.len)

@borrows
fn TypedExprBuildIndexFindEntry(index: TypedExprBuildIndex,
                                 kind: str,
                                 sourcePath: str,
                                 name: str,
                                 detail: str,
                                 registerProbe: bool): int32 =
    if index.entryBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
    let bucket = TypedExprBuildIndexBucket(hashValue, index.entryBucketHeads.len)
    var entryIndex = index.entryBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= index.entryNext.len ||
           entryIndex >= index.entryHashes.len ||
           entryIndex >= typedExprBuildIndexEntryCount(index):
            panic("typed expr: corrupt structured entry chain")
        if !index.frozenReadOnlyQueries:
            if registerProbe:
                index.registerProbeCount = index.registerProbeCount + 1
            else:
                index.queryProbeCount = index.queryProbeCount + 1
        if index.entryHashes[entryIndex] == hashValue &&
           typedExprBuildIndexEntryKind(index, entryIndex) == kind &&
           typedExprBuildIndexEntrySourcePath(index, entryIndex) == sourcePath &&
           typedExprBuildIndexEntryName(index, entryIndex) == name &&
           typedExprBuildIndexEntryDetail(index, entryIndex) == detail:
            return entryIndex
        entryIndex = index.entryNext[entryIndex]
    return -1

@borrows
fn TypedExprBuildIndexRehashVisibility(index: TypedExprBuildIndex,
                                        minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for candidateIndex in 0..<index.visibilityKinds.len:
        if candidateIndex >= index.visibilityHashes.len:
            panic("typed expr: corrupt visibility hash columns during rehash")
        let bucket = TypedExprBuildIndexBucket(index.visibilityHashes[candidateIndex], heads.len)
        add(next, heads[bucket])
        heads[bucket] = candidateIndex
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.visibilityBucketHeads = heads
    index.visibilityNext = next

@borrows
fn TypedExprBuildIndexEnsureVisibilityCapacity(index: TypedExprBuildIndex) =
    if index.visibilityBucketHeads.len <= 0:
        index.visibilityBucketHeads = TypedExprBuildIndexEmptyBuckets(16)
        return
    let nextItems = typedExprCheckedAdd64(Int64(index.visibilityKinds.len), 1,
                                          "visibility_load_items")
    if typedExprCheckedMul64(nextItems, 4, "visibility_load_items") <
       typedExprCheckedMul64(Int64(index.visibilityBucketHeads.len), 3,
                             "visibility_load_buckets"):
        return
    TypedExprBuildIndexRehashVisibility(index, index.visibilityBucketHeads.len)

@borrows
fn TypedExprBuildIndexFindVisibilityDeclaration(index: TypedExprBuildIndex,
                                                 kind: str,
                                                 sourcePath: str,
                                                 name: str,
                                                 detail: str,
                                                 registerProbe: bool): int32 =
    if index.visibilityBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            index.visibilityBucketHeads.len)
    var candidateIndex = index.visibilityBucketHeads[bucket]
    while candidateIndex >= 0:
        if candidateIndex >= index.visibilityNext.len ||
           candidateIndex >= index.visibilityHashes.len ||
           candidateIndex >= typedExprBuildIndexVisibilityCount(index) ||
           candidateIndex >= index.visibilityValueIndexes.len:
            panic("typed expr: corrupt exact visibility declaration chain")
        if !index.frozenReadOnlyQueries:
            if registerProbe:
                index.registerProbeCount = index.registerProbeCount + 1
            else:
                index.queryProbeCount = index.queryProbeCount + 1
        if index.visibilityHashes[candidateIndex] == hashValue &&
           typedExprBuildIndexVisibilityKindAt(index, candidateIndex) == kind &&
           typedExprBuildIndexVisibilitySourcePath(index, candidateIndex) == sourcePath &&
           typedExprBuildIndexVisibilityName(index, candidateIndex) == name &&
           typedExprBuildIndexVisibilityDetail(index, candidateIndex) == detail:
            return candidateIndex
        candidateIndex = index.visibilityNext[candidateIndex]
    return -1

@borrows
fn TypedExprBuildIndexRehashImportOwners(index: TypedExprBuildIndex,
                                         minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for ownerIndex in 0..<index.importOwnerSourcePaths.len:
        if ownerIndex >= index.importOwnerHashes.len:
            panic("typed expr: corrupt import owner hashes during rehash")
        let bucket = TypedExprBuildIndexBucket(index.importOwnerHashes[ownerIndex], heads.len)
        add(next, heads[bucket])
        heads[bucket] = ownerIndex
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.importOwnerBucketHeads = heads
    index.importOwnerNext = next

@borrows
fn TypedExprBuildIndexEnsureImportOwnerCapacity(index: TypedExprBuildIndex) =
    if index.importOwnerBucketHeads.len <= 0:
        index.importOwnerBucketHeads = TypedExprBuildIndexEmptyBuckets(16)
        return
    let nextItems = typedExprCheckedAdd64(
        Int64(index.importOwnerSourcePaths.len), 1, "import_owner_load_items")
    if typedExprCheckedMul64(nextItems, 4, "import_owner_load_items") <
       typedExprCheckedMul64(Int64(index.importOwnerBucketHeads.len), 3,
                             "import_owner_load_buckets"):
        return
    TypedExprBuildIndexRehashImportOwners(index,
                                          index.importOwnerBucketHeads.len)

@borrows
fn TypedExprBuildIndexFindImportOwner(index: TypedExprBuildIndex,
                                      ownerSourcePath: str,
                                      registerProbe: bool): int32 =
    if index.importOwnerBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash2(ownerSourcePath, "")
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            index.importOwnerBucketHeads.len)
    var ownerIndex = index.importOwnerBucketHeads[bucket]
    while ownerIndex >= 0:
        if ownerIndex >= index.importOwnerNext.len ||
           ownerIndex >= index.importOwnerHashes.len ||
           ownerIndex >= typedExprBuildIndexImportOwnerCount(index) ||
           ownerIndex >= index.importOwnerTargetHeads.len:
            panic("typed expr: corrupt import owner chain")
        if !index.frozenReadOnlyQueries:
            if registerProbe:
                index.registerProbeCount = index.registerProbeCount + 1
            else:
                index.queryProbeCount = index.queryProbeCount + 1
        if index.importOwnerHashes[ownerIndex] == hashValue &&
           typedExprBuildIndexImportOwnerSourcePath(index, ownerIndex) == ownerSourcePath:
            return ownerIndex
        ownerIndex = index.importOwnerNext[ownerIndex]
    return -1

@borrows
fn TypedExprBuildIndexAppendNewImportTarget(index: TypedExprBuildIndex,
                                            ownerSourcePath: str,
                                            entryIndex: int32) =
    if entryIndex < 0 || entryIndex >= typedExprBuildIndexEntryCount(index) ||
       typedExprBuildIndexEntryKind(index, entryIndex) !=
           "ctx_import_target" ||
       typedExprBuildIndexEntrySourcePath(index, entryIndex) !=
           ownerSourcePath:
        panic("typed expr: invalid canonical import target adjacency entry")
    TypedExprBuildIndexEnsureImportOwnerCapacity(index)
    var ownerIndex = TypedExprBuildIndexFindImportOwner(index,
                                                         ownerSourcePath,
                                                         true)
    if ownerIndex < 0:
        let hashValue = TypedExprBuildIndexHash2(ownerSourcePath, "")
        let bucket = TypedExprBuildIndexBucket(hashValue,
                                                index.importOwnerBucketHeads.len)
        ownerIndex = index.importOwnerSourcePaths.len
        let ownerBucketHead = index.importOwnerBucketHeads[bucket]
        add(index.importOwnerNext, ownerBucketHead)
        add(index.importOwnerHashes, hashValue)
        typedExprBuildIndexAppendBorrowedText(
            index,
            typedExprBuildIndexTextColumnImportOwnerSourcePath,
            ownerSourcePath)
        add(index.importOwnerTargetHeads, -1)
        index.importOwnerBucketHeads[bucket] = ownerIndex
    let targetNodeIndex = index.importTargetNext.len
    let ownerTargetHead = index.importOwnerTargetHeads[ownerIndex]
    add(index.importTargetNext, ownerTargetHead)
    add(index.importTargetEntryIndexes, entryIndex)
    index.importOwnerTargetHeads[ownerIndex] = targetNodeIndex

@borrows
fn TypedExprBuildIndexRehashVisibilityQueries(index: TypedExprBuildIndex,
                                               minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for queryIndex in 0..<index.visibilityQueryKinds.len:
        if queryIndex >= index.visibilityQueryHashes.len:
            panic("typed expr: corrupt visibility query hashes during rehash")
        let bucket = TypedExprBuildIndexBucket(index.visibilityQueryHashes[queryIndex], heads.len)
        add(next, heads[bucket])
        heads[bucket] = queryIndex
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.visibilityQueryBucketHeads = heads
    index.visibilityQueryNext = next

@borrows
fn TypedExprBuildIndexEnsureVisibilityQueryCapacity(index: TypedExprBuildIndex) =
    if index.visibilityQueryBucketHeads.len <= 0:
        index.visibilityQueryBucketHeads = TypedExprBuildIndexEmptyBuckets(16)
        return
    let nextItems = typedExprCheckedAdd64(
        Int64(index.visibilityQueryKinds.len), 1,
        "visibility_query_load_items")
    if typedExprCheckedMul64(nextItems, 4,
                             "visibility_query_load_items") <
       typedExprCheckedMul64(Int64(index.visibilityQueryBucketHeads.len), 3,
                             "visibility_query_load_buckets"):
        return
    TypedExprBuildIndexRehashVisibilityQueries(index,
                                                index.visibilityQueryBucketHeads.len)

@borrows
fn TypedExprBuildIndexFindVisibilityQuery(index: TypedExprBuildIndex,
                                           ownerSourcePath: str,
                                           kind: str,
                                           name: str,
                                           detail: str): int32 =
    if index.visibilityQueryBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash4(ownerSourcePath, kind, name, detail)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            index.visibilityQueryBucketHeads.len)
    var queryIndex = index.visibilityQueryBucketHeads[bucket]
    while queryIndex >= 0:
        if queryIndex >= index.visibilityQueryNext.len ||
           queryIndex >= index.visibilityQueryHashes.len ||
           queryIndex >= index.visibilityQueryOwnerSourcePaths.len ||
           queryIndex >= index.visibilityQueryKinds.len ||
           queryIndex >= index.visibilityQueryNames.len ||
           queryIndex >= index.visibilityQueryDetails.len ||
           queryIndex >= index.visibilityQueryStates.len ||
           queryIndex >= index.visibilityQueryValueIndexes.len ||
           queryIndex >= index.visibilityQueryFingerprints.len:
            panic("typed expr: corrupt visibility query cache chain")
        if !index.frozenReadOnlyQueries:
            index.queryProbeCount = index.queryProbeCount + 1
        if index.visibilityQueryHashes[queryIndex] == hashValue &&
           index.visibilityQueryOwnerSourcePaths[queryIndex] == ownerSourcePath &&
           index.visibilityQueryKinds[queryIndex] == kind &&
           index.visibilityQueryNames[queryIndex] == name &&
           index.visibilityQueryDetails[queryIndex] == detail:
            return queryIndex
        queryIndex = index.visibilityQueryNext[queryIndex]
    return -1

@borrows
fn TypedExprBuildIndexRegisterVisibilityDeclaration(index: TypedExprBuildIndex,
                                                      kind: str,
                                                      sourcePath: str,
                                                      name: str,
                                                      detail: str,
                                                      valueIndex: int32,
                                                      fingerprint: str) =
    if index == nil || index.released || !TypedExprBuildIndexVisibilityKind(kind):
        panic("typed expr: invalid visibility declaration registration")
    typedExprBuildIndexRequireMutable(index, "visibility_declaration_register")
    if index.visibilityQueryKinds.len > 0:
        panic("typed expr: visibility declaration mutation after query cache seal")
    index.registerCount = index.registerCount + 1
    TypedExprBuildIndexEnsureVisibilityCapacity(index)
    let existing = TypedExprBuildIndexFindVisibilityDeclaration(index,
                                                                  kind,
                                                                  sourcePath,
                                                                  name,
                                                                  detail,
                                                                  true)
    if existing >= 0:
        if index.visibilityValueIndexes[existing] != valueIndex ||
           index.visibilityFingerprints[existing] != fingerprint:
            panic(Fmt"typed expr: conflicting declaration visibility kind={kind} source={sourcePath} name={name}")
        return
    let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
    let bucket = TypedExprBuildIndexBucket(hashValue, index.visibilityBucketHeads.len)
    let nextIndex = index.visibilityKinds.len
    let bucketHead = index.visibilityBucketHeads[bucket]
    # [D-B2a] canonical intern: the identity columns (kind, sourcePath) become
    # shared handles into the index-owned pool; the high-cardinality payload
    # columns (name, detail, fingerprint) stay per-row owned clones. Appended
    # values, their order and the dedup decision are unchanged.
    let declaredKind = typedExprBuildIndexInternSharedText(index, kind)
    let declaredSourcePath = typedExprBuildIndexInternSharedText(index, sourcePath)
    let ownedName = parser.ParserOwnedText(name)
    let ownedDetail = parser.ParserOwnedText(detail)
    let ownedFingerprint = parser.ParserOwnedText(fingerprint)
    # [S1b step-3 (8)] In-place append, the shape `TypedExprBuildIndexRegister`
    # already uses on these same `ref object` sequence fields.  The previous
    # clone-and-write-back form copied all nine sequences per registration --
    # O(N^2) allocation churn, 4.85 GB of arena-external churn on the 234-source
    # compiler (measured: r8s3 -> r8s4 = +4,852,010,584 B phys_footprint).  The
    # registered values, their order and the dedup decision are unchanged.
    add(index.visibilityNext, bucketHead)
    add(index.visibilityHashes, hashValue)
    add(index.visibilityKinds, declaredKind)
    add(index.visibilitySourcePaths, declaredSourcePath)
    add(index.visibilityNames, ownedName)
    add(index.visibilityDetails, ownedDetail)
    add(index.visibilityValueIndexes, valueIndex)
    add(index.visibilityFingerprints, ownedFingerprint)
    index.visibilityBucketHeads[bucket] = nextIndex
    index.metadataDeclarationCount = index.metadataDeclarationCount + 1

@borrows
fn TypedExprBuildIndexVisibleLookup(index: TypedExprBuildIndex,
                                     kind: str,
                                     ownerSourcePath: str,
                                     name: str,
                                     detail: str,
                                     valueIndex: var int32,
                                     fingerprint: var str): TypedExprBuildIndexLookupState =
    valueIndex = -1
    fingerprint = ""
    let cachedIndex = TypedExprBuildIndexFindVisibilityQuery(index,
                                                              ownerSourcePath,
                                                              kind,
                                                              name,
                                                              detail)
    if cachedIndex >= 0:
        let cachedState = index.visibilityQueryStates[cachedIndex]
        if cachedState == TypedExprBuildIndexUnique:
            valueIndex = index.visibilityQueryValueIndexes[cachedIndex]
            fingerprint = parser.ParserOwnedText(
                index.visibilityQueryFingerprints[cachedIndex])
        return cachedState
    let ownerIndex = TypedExprBuildIndexFindImportOwner(index,
                                                         ownerSourcePath,
                                                         false)
    var state = TypedExprBuildIndexMissing
    # The canonical ctx_import_target row is the exact source-identity edge.
    # Keep the selection as an int32 row identity instead of moving an owned
    # path string into a second local and then reading the consumed value.
    var selectedTargetEntryIndex: int32 = -1
    var targetNodeIndex: int32 = -1
    if ownerIndex >= 0:
        targetNodeIndex = index.importOwnerTargetHeads[ownerIndex]
    while targetNodeIndex >= 0:
        if targetNodeIndex >= index.importTargetNext.len ||
           targetNodeIndex >= index.importTargetEntryIndexes.len:
            panic("typed expr: corrupt import target adjacency chain")
        let edgeEntryIndex = index.importTargetEntryIndexes[targetNodeIndex]
        if edgeEntryIndex < 0 ||
           edgeEntryIndex >= typedExprBuildIndexEntryCount(index) ||
           edgeEntryIndex >= index.entryStates.len ||
           typedExprBuildIndexEntryKind(index, edgeEntryIndex) !=
               "ctx_import_target" ||
           typedExprBuildIndexEntrySourcePath(index, edgeEntryIndex) !=
               ownerSourcePath ||
           index.entryStates[edgeEntryIndex] != TypedExprBuildIndexUnique:
            panic("typed expr: corrupt canonical import target entry")
        if !index.frozenReadOnlyQueries:
            index.queryMetadataScanCount = index.queryMetadataScanCount + 1
        let targetSourcePath = typedExprBuildIndexEntryName(index,
                                                             edgeEntryIndex)
        let declarationIndex = TypedExprBuildIndexFindVisibilityDeclaration(index,
                                                                              kind,
                                                                              targetSourcePath,
                                                                              name,
                                                                              detail,
                                                                              false)
        if declarationIndex >= 0:
            if state == TypedExprBuildIndexMissing:
                state = TypedExprBuildIndexUnique
                selectedTargetEntryIndex = edgeEntryIndex
                valueIndex = index.visibilityValueIndexes[declarationIndex]
                fingerprint = parser.ParserOwnedText(
                    typedExprBuildIndexVisibilityFingerprint(
                        index, declarationIndex))
            elif edgeEntryIndex == selectedTargetEntryIndex:
                panic("typed expr: duplicate target in import adjacency")
            else:
                valueIndex = -1
                fingerprint = ""
                state = TypedExprBuildIndexAmbiguous
                break
        targetNodeIndex = index.importTargetNext[targetNodeIndex]
    if !index.frozenReadOnlyQueries:
        TypedExprBuildIndexEnsureVisibilityQueryCapacity(index)
        let hashValue = TypedExprBuildIndexHash4(ownerSourcePath,
                                                  kind,
                                                  name,
                                                  detail)
        var heads = TypedExprCloneI32Seq(index.visibilityQueryBucketHeads)
        let bucket = TypedExprBuildIndexBucket(hashValue, heads.len)
        let queryIndex = index.visibilityQueryKinds.len
        var next = TypedExprCloneI32Seq(index.visibilityQueryNext)
        add(next, heads[bucket])
        index.visibilityQueryNext = next
        var hashes = TypedExprCloneI32Seq(index.visibilityQueryHashes)
        add(hashes, hashValue)
        index.visibilityQueryHashes = hashes
        var ownerSourcePaths = TypedExprCloneStrSeq(
            index.visibilityQueryOwnerSourcePaths)
        add(ownerSourcePaths, parser.ParserOwnedText(ownerSourcePath))
        index.visibilityQueryOwnerSourcePaths = ownerSourcePaths
        var kinds = TypedExprCloneStrSeq(index.visibilityQueryKinds)
        add(kinds, parser.ParserOwnedText(kind))
        index.visibilityQueryKinds = kinds
        var names = TypedExprCloneStrSeq(index.visibilityQueryNames)
        add(names, parser.ParserOwnedText(name))
        index.visibilityQueryNames = names
        var details = TypedExprCloneStrSeq(index.visibilityQueryDetails)
        add(details, parser.ParserOwnedText(detail))
        index.visibilityQueryDetails = details
        var states: TypedExprBuildIndexLookupState[]
        typedExprCloneLookupStateColRec(states, index.visibilityQueryStates, 0)
        add(states, state)
        index.visibilityQueryStates = states
        var valueIndexes = TypedExprCloneI32Seq(
            index.visibilityQueryValueIndexes)
        add(valueIndexes, valueIndex)
        index.visibilityQueryValueIndexes = valueIndexes
        var fingerprints = TypedExprCloneStrSeq(
            index.visibilityQueryFingerprints)
        add(fingerprints, parser.ParserOwnedText(fingerprint))
        index.visibilityQueryFingerprints = fingerprints
        heads[bucket] = queryIndex
        index.visibilityQueryBucketHeads = heads
    return state

@borrows
fn TypedExprBuildIndexRehashContentCache(index: TypedExprBuildIndex,
                                          minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for entryIndex in 0..<index.contentCacheKinds.len:
        if entryIndex >= index.contentCacheHashes.len:
            panic("typed expr: corrupt content cache hashes during rehash")
        let bucket = TypedExprBuildIndexBucket(index.contentCacheHashes[entryIndex], heads.len)
        add(next, heads[bucket])
        heads[bucket] = entryIndex
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.contentCacheBucketHeads = heads
    index.contentCacheNext = next

@borrows
fn TypedExprBuildIndexEnsureContentCacheCapacity(index: TypedExprBuildIndex) =
    if index.contentCacheBucketHeads.len <= 0:
        index.contentCacheBucketHeads = TypedExprBuildIndexEmptyBuckets(0)
        return
    let nextItems = typedExprCheckedAdd64(Int64(index.contentCacheKinds.len), 1,
                                          "content_cache_load_items")
    if typedExprCheckedMul64(nextItems, 4, "content_cache_load_items") <
       typedExprCheckedMul64(Int64(index.contentCacheBucketHeads.len), 3,
                             "content_cache_load_buckets"):
        return
    TypedExprBuildIndexRehashContentCache(index,
                                           index.contentCacheBucketHeads.len)

@borrows
fn TypedExprBuildIndexFindContentCache(index: TypedExprBuildIndex,
                                        kind: str,
                                        sourcePath: str,
                                        name: str,
                                        registerProbe: bool): int32 =
    if index.contentCacheBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, "")
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            index.contentCacheBucketHeads.len)
    var entryIndex = index.contentCacheBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= index.contentCacheKinds.len ||
           entryIndex >= index.contentCacheNext.len ||
           entryIndex >= index.contentCacheHashes.len ||
           entryIndex >= index.contentCacheSourcePaths.len ||
           entryIndex >= index.contentCacheNames.len ||
           entryIndex >= index.contentCacheValues.len:
            panic("typed expr: corrupt content cache chain")
        if !index.frozenReadOnlyQueries:
            if registerProbe:
                index.registerProbeCount = index.registerProbeCount + 1
            else:
                index.queryProbeCount = index.queryProbeCount + 1
        if index.contentCacheHashes[entryIndex] == hashValue &&
           index.contentCacheKinds[entryIndex] == kind &&
           index.contentCacheSourcePaths[entryIndex] == sourcePath &&
           index.contentCacheNames[entryIndex] == name:
            return entryIndex
        entryIndex = index.contentCacheNext[entryIndex]
    return -1

@borrows
fn TypedExprBuildIndexContentCacheKind(kind: str): bool =
    return kind == "function_header_return" ||
           kind == "function_header_scanned"

fn TypedExprBuildIndexRegisterContentCache(index: TypedExprBuildIndex,
                                            kind: str,
                                            sourcePath: str,
                                            name: str,
                                            value: str) =
    if index == nil || index.released ||
       !TypedExprBuildIndexContentCacheKind(kind):
        panic("typed expr: content cache register on missing or released build index")
    typedExprBuildIndexRequireMutable(index, "content_cache_register")
    if index.contentCacheReleased:
        panic("typed expr: content cache register after backend handoff")
    index.registerCount = index.registerCount + 1
    TypedExprBuildIndexEnsureContentCacheCapacity(index)
    let existing = TypedExprBuildIndexFindContentCache(index,
                                                        kind,
                                                        sourcePath,
                                                        name,
                                                        true)
    if existing >= 0:
        if index.contentCacheValues[existing] != value:
            panic(Fmt"typed expr: conflicting content cache kind={kind} source={sourcePath} name={name}")
        return
    let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, "")
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            index.contentCacheBucketHeads.len)
    let entryIndex = index.contentCacheKinds.len
    add(index.contentCacheNext, index.contentCacheBucketHeads[bucket])
    add(index.contentCacheHashes, hashValue)
    add(index.contentCacheKinds, kind)
    add(index.contentCacheSourcePaths, sourcePath)
    add(index.contentCacheNames, name)
    add(index.contentCacheValues, value)
    index.contentCacheBucketHeads[bucket] = entryIndex

@borrows
fn TypedExprBuildIndexLookupContentCache(index: TypedExprBuildIndex,
                                          kind: str,
                                          sourcePath: str,
                                          name: str,
                                          value: var str): TypedExprBuildIndexLookupState =
    value = ""
    if index == nil:
        return TypedExprBuildIndexMissing
    if !TypedExprBuildIndexContentCacheKind(kind):
        panic("typed expr: invalid content cache query kind")
    if index.released:
        panic("typed expr: content cache query on released build index")
    if index.contentCacheReleased:
        panic("typed expr: content cache query after backend handoff")
    if !index.frozenReadOnlyQueries:
        index.queryLookupCount = index.queryLookupCount + 1
    let entryIndex = TypedExprBuildIndexFindContentCache(index,
                                                          kind,
                                                          sourcePath,
                                                          name,
                                                          false)
    if entryIndex < 0:
        return TypedExprBuildIndexMissing
    value = parser.ParserOwnedText(
        typedExprBuildIndexContentCacheValue(index, entryIndex))
    return TypedExprBuildIndexUnique

@borrows
fn TypedExprBuildIndexReleaseContentCache(index: TypedExprBuildIndex) =
    if index == nil:
        return
    if index.released:
        panic("typed expr: content cache release on released build index")
    typedExprBuildIndexRequireMutable(index, "content_cache_release")
    if index.contentCacheReleased:
        return
    index.contentCacheBucketHeads = []
    index.contentCacheNext = []
    index.contentCacheHashes = []
    index.contentCacheKinds = []
    index.contentCacheSourcePaths = []
    index.contentCacheNames = []
    index.contentCacheValues = []
    index.contentCacheReleased = true

@borrows
fn TypedExprBuildIndexRegister(index: TypedExprBuildIndex,
                                kind: str,
                                sourcePath: str,
                                name: str,
                                detail: str,
                                valueIndex: int32,
                                origin: str,
                                fingerprint: str,
                                hardConflict: bool): TypedExprBuildIndexLookupState =
    if TypedExprBuildIndexContentCacheKind(kind):
        panic("typed expr: content cache kind requires scoped cache registration")
    typedExprBuildIndexRequireMutable(index, "structured_entry_register")
    if kind == "ctx_import_target" && index.visibilityQueryKinds.len > 0:
        panic("typed expr: import visibility edge mutation after query cache seal")
    index.registerCount = index.registerCount + 1
    TypedExprBuildIndexEnsureEntryCapacity(index)
    let existing = TypedExprBuildIndexFindEntry(index,
                                                 kind,
                                                 sourcePath,
                                                 name,
                                                 detail,
                                                 true)
    if existing < 0:
        let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
        let bucket = TypedExprBuildIndexBucket(hashValue, index.entryBucketHeads.len)
        let entryIndex = index.entryKinds.len
        let entryBucketHead = typedExprBuildIndexInt32At(
            index.entryBucketHeads, bucket)
        add(index.entryNext, entryBucketHead)
        add(index.entryHashes, hashValue)
        typedExprBuildIndexAppendBorrowedText(
            index, typedExprBuildIndexTextColumnEntryKind, kind)
        typedExprBuildIndexAppendBorrowedText(index,
                                              typedExprBuildIndexTextColumnEntrySourcePath,
                                              sourcePath)
        typedExprBuildIndexAppendBorrowedText(
            index, typedExprBuildIndexTextColumnEntryName, name)
        typedExprBuildIndexAppendBorrowedText(
            index, typedExprBuildIndexTextColumnEntryDetail, detail)
        add(index.entryStates, TypedExprBuildIndexUnique)
        add(index.entryValueIndexes, valueIndex)
        typedExprBuildIndexAppendBorrowedText(
            index, typedExprBuildIndexTextColumnEntryOrigin, origin)
        typedExprBuildIndexAppendBorrowedText(index,
                                              typedExprBuildIndexTextColumnEntryFingerprint,
                                              fingerprint)
        add(index.entryValidationMarks, 0)
        index.entryBucketHeads[bucket] = entryIndex
        if kind == "ctx_import_target":
            TypedExprBuildIndexAppendNewImportTarget(index,
                                                      sourcePath,
                                                      entryIndex)
            index.visibilityEdgeCount = index.visibilityEdgeCount + 1
        return TypedExprBuildIndexUnique
    if existing >= index.entryStates.len ||
       existing >= index.entryValueIndexes.len ||
       existing >= index.entryOrigins.len ||
       existing >= index.entryFingerprints.len:
        panic("typed expr: corrupt build index entry")
    if typedExprBuildIndexEntryOrigin(index, existing) == origin &&
       typedExprBuildIndexEntryFingerprint(index, existing) == fingerprint:
        return index.entryStates[existing]
    index.entryStates[existing] = TypedExprBuildIndexAmbiguous
    index.entryValueIndexes[existing] = -1
    if hardConflict:
        index.hardError = Fmt" typed expr: conflicting indexed metadata kind={kind} source={sourcePath} name={name} detail={detail} first_origin={typedExprBuildIndexEntryOrigin(index, existing)} next_origin={origin}"
        panic(parser.ParserOwnedText(index.hardError))
    return TypedExprBuildIndexAmbiguous

@borrows
fn TypedExprBuildIndexLookup(index: TypedExprBuildIndex,
                              kind: str,
                              sourcePath: str,
                              name: str,
                              detail: str,
                              valueIndex: var int32): TypedExprBuildIndexLookupState =
    valueIndex = -1
    if index == nil:
        return TypedExprBuildIndexMissing
    if TypedExprBuildIndexContentCacheKind(kind):
        panic("typed expr: content cache kind requires scoped cache query")
    if index.released:
        panic("typed expr: query on released build index")
    if !index.frozenReadOnlyQueries:
        index.queryLookupCount = index.queryLookupCount + 1
    if TypedExprBuildIndexVisibilityKind(kind):
        var ignoredFingerprint: str
        return TypedExprBuildIndexVisibleLookup(index,
                                                 kind,
                                                 sourcePath,
                                                 name,
                                                 detail,
                                                 valueIndex,
                                                 ignoredFingerprint)
    let entryIndex = TypedExprBuildIndexFindEntry(index,
                                                   kind,
                                                   sourcePath,
                                                   name,
                                                   detail,
                                                   false)
    if entryIndex < 0 ||
       entryIndex >= index.entryStates.len ||
       entryIndex >= index.entryValueIndexes.len:
        return TypedExprBuildIndexMissing
    let state = index.entryStates[entryIndex]
    if state == TypedExprBuildIndexUnique:
        valueIndex = index.entryValueIndexes[entryIndex]
    return state

@borrows
fn TypedExprBuildIndexLookupFingerprint(index: TypedExprBuildIndex,
                                         kind: str,
                                         sourcePath: str,
                                         name: str,
                                         detail: str,
                                         fingerprint: var str): TypedExprBuildIndexLookupState =
    fingerprint = ""
    if index == nil:
        return TypedExprBuildIndexMissing
    if TypedExprBuildIndexContentCacheKind(kind):
        panic("typed expr: content cache kind requires scoped cache query")
    if index.released:
        panic("typed expr: fingerprint query on released build index")
    if !index.frozenReadOnlyQueries:
        index.queryLookupCount = index.queryLookupCount + 1
    if TypedExprBuildIndexVisibilityKind(kind):
        var ignoredValueIndex: int32
        return TypedExprBuildIndexVisibleLookup(index,
                                                 kind,
                                                 sourcePath,
                                                 name,
                                                 detail,
                                                 ignoredValueIndex,
                                                 fingerprint)
    let entryIndex = TypedExprBuildIndexFindEntry(index,
                                                   kind,
                                                   sourcePath,
                                                   name,
                                                   detail,
                                                   false)
    if entryIndex < 0 || entryIndex >= index.entryStates.len ||
       entryIndex >= typedExprBuildIndexEntryCount(index):
        return TypedExprBuildIndexMissing
    let state = index.entryStates[entryIndex]
    if state == TypedExprBuildIndexUnique:
        fingerprint = parser.ParserOwnedText(
            typedExprBuildIndexEntryFingerprint(index, entryIndex))
    return state

fn TypedExprBuildIndexIncrement(index: var TypedExprBuildIndex,
                                 kind: str,
                                 sourcePath: str,
                                 name: str) =
    if TypedExprBuildIndexContentCacheKind(kind):
        panic("typed expr: content cache kind cannot use counter registration")
    typedExprBuildIndexRequireMutable(index, "structured_counter_increment")
    let entryIndex = TypedExprBuildIndexFindEntry(index,
                                                   kind,
                                                   sourcePath,
                                                   name,
                                                   "",
                                                   true)
    if entryIndex < 0:
        TypedExprBuildIndexRegister(index, kind, sourcePath, name, "", 1, sourcePath, name, true)
        return
    index.registerCount = index.registerCount + 1
    if entryIndex >= index.entryValueIndexes.len:
        panic("typed expr: corrupt build index count entry")
    index.entryValueIndexes[entryIndex] =
        index.entryValueIndexes[entryIndex] + 1

@borrows
fn TypedExprBuildIndexRehashContextFieldOwners(index: TypedExprBuildIndex,
                                                minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for ownerIndex in 0..<index.contextFieldOwnerSourcePaths.len:
        if ownerIndex >= index.contextFieldOwnerHashes.len:
            panic("typed expr: corrupt context field owner hashes")
        let bucket = TypedExprBuildIndexBucket(index.contextFieldOwnerHashes[ownerIndex], heads.len)
        add(next, heads[bucket])
        heads[bucket] = ownerIndex
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.contextFieldOwnerBucketHeads = heads
    index.contextFieldOwnerNext = next

@borrows
fn TypedExprBuildIndexFindContextFieldOwner(index: TypedExprBuildIndex,
                                             sourcePath: str,
                                             ownerType: str,
                                             registerProbe: bool): int32 =
    if index.contextFieldOwnerBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash2(sourcePath, ownerType)
    let bucket = TypedExprBuildIndexBucket(hashValue, index.contextFieldOwnerBucketHeads.len)
    var ownerIndex = index.contextFieldOwnerBucketHeads[bucket]
    while ownerIndex >= 0:
        if ownerIndex >= index.contextFieldOwnerNext.len ||
           ownerIndex >= index.contextFieldOwnerHashes.len ||
           ownerIndex >= typedExprBuildIndexContextFieldOwnerCount(index):
            panic("typed expr: corrupt context field owner chain")
        if !index.frozenReadOnlyQueries:
            if registerProbe:
                index.registerProbeCount = index.registerProbeCount + 1
            else:
                index.queryProbeCount = index.queryProbeCount + 1
        if index.contextFieldOwnerHashes[ownerIndex] == hashValue &&
           typedExprBuildIndexContextFieldOwnerSourcePath(index,
                                                           ownerIndex) == sourcePath &&
           typedExprBuildIndexContextFieldOwnerType(index,
                                                     ownerIndex) == ownerType:
            return ownerIndex
        ownerIndex = index.contextFieldOwnerNext[ownerIndex]
    return -1

@borrows
fn TypedExprBuildIndexAddContextFieldNode(index: var TypedExprBuildIndex,
                                           sourcePath: str,
                                           ownerType: str,
                                           contextIndex: int32,
                                           rowIndex: int32,
                                           declaredOffsetBytes: int32,
                                           declaredSizeBytes: int32,
                                           declaredAlignBytes: int32): int32 =
    if index == nil || index.released || contextIndex < 0 || rowIndex < 0:
        panic("typed expr: context field row requires live build index")
    typedExprBuildIndexRequireMutable(index, "context_field_node_add")
    index.registerCount = index.registerCount + 1
    let nextOwners = typedExprCheckedAdd64(
        Int64(index.contextFieldOwnerSourcePaths.len), 1,
        "context_field_owner_load_items")
    if typedExprCheckedMul64(nextOwners, 4,
                             "context_field_owner_load_items") >=
       typedExprCheckedMul64(Int64(index.contextFieldOwnerBucketHeads.len), 3,
                             "context_field_owner_load_buckets"):
        TypedExprBuildIndexRehashContextFieldOwners(index,
                                                     index.contextFieldOwnerBucketHeads.len)
    var ownerIndex = TypedExprBuildIndexFindContextFieldOwner(index,
                                                               sourcePath,
                                                               ownerType,
                                                               true)
    if ownerIndex < 0:
        let hashValue = TypedExprBuildIndexHash2(sourcePath, ownerType)
        let bucket = TypedExprBuildIndexBucket(hashValue, index.contextFieldOwnerBucketHeads.len)
        ownerIndex = index.contextFieldOwnerSourcePaths.len
        let ownedSourcePath = parser.ParserOwnedText(sourcePath)
        let ownedOwnerType = parser.ParserOwnedText(ownerType)
        seqs.Add(index.contextFieldOwnerNext, index.contextFieldOwnerBucketHeads[bucket])
        seqs.Add(index.contextFieldOwnerHashes, hashValue)
        seqs.Add(index.contextFieldOwnerSourcePaths, ownedSourcePath)
        seqs.Add(index.contextFieldOwnerTypes, ownedOwnerType)
        seqs.Add(index.contextFieldOwnerHeads, -1)
        seqs.Add(index.contextFieldOwnerTails, -1)
        index.contextFieldOwnerBucketHeads[bucket] = ownerIndex
    let nodeIndex = index.contextFieldNodeNext.len
    seqs.Add(index.contextFieldNodeNext, -1)
    seqs.Add(index.contextFieldNodeContextIndexes, contextIndex)
    seqs.Add(index.contextFieldNodeRowIndexes, rowIndex)
    seqs.Add(index.contextFieldNodeDeclaredOffsetBytes, declaredOffsetBytes)
    seqs.Add(index.contextFieldNodeDeclaredSizeBytes, declaredSizeBytes)
    seqs.Add(index.contextFieldNodeDeclaredAlignBytes, declaredAlignBytes)
    seqs.Add(index.contextFieldNodeOffsetBytes, 0)
    seqs.Add(index.contextFieldNodeSizeBytes, 0)
    seqs.Add(index.contextFieldNodeAlignBytes, 0)
    seqs.Add(index.contextFieldNodeLayoutReady, false)
    if index.contextFieldOwnerHeads[ownerIndex] < 0:
        index.contextFieldOwnerHeads[ownerIndex] = nodeIndex
    else:
        index.contextFieldNodeNext[
            index.contextFieldOwnerTails[ownerIndex]] = nodeIndex
    index.contextFieldOwnerTails[ownerIndex] = nodeIndex
    return nodeIndex

@borrows
fn TypedExprBuildIndexContextFieldHead(index: TypedExprBuildIndex,
                                        sourcePath: str,
                                        ownerType: str): int32 =
    if index == nil:
        return -1
    if index.released:
        panic("typed expr: context field head query on released build index")
    if !index.frozenReadOnlyQueries:
        index.queryLookupCount = index.queryLookupCount + 1
    let ownerIndex = TypedExprBuildIndexFindContextFieldOwner(index,
                                                               sourcePath,
                                                               ownerType,
                                                               false)
    if ownerIndex < 0 || ownerIndex >= index.contextFieldOwnerHeads.len:
        return -1
    return index.contextFieldOwnerHeads[ownerIndex]

@borrows
fn TypedExprBuildIndexContextFieldNode(index: TypedExprBuildIndex,
                                        nodeIndex: int32,
                                        contextIndex: var int32,
                                        rowIndex: var int32): bool =
    contextIndex = -1
    rowIndex = -1
    if index == nil:
        return false
    if index.released:
        panic("typed expr: context field node query on released build index")
    if nodeIndex < 0 ||
       nodeIndex >= index.contextFieldNodeContextIndexes.len ||
       nodeIndex >= index.contextFieldNodeRowIndexes.len:
        return false
    contextIndex = index.contextFieldNodeContextIndexes[nodeIndex]
    rowIndex = index.contextFieldNodeRowIndexes[nodeIndex]
    return true

@borrows
fn TypedExprBuildIndexContextFieldNext(index: TypedExprBuildIndex,
                                        nodeIndex: int32): int32 =
    if index == nil:
        return -1
    if index.released:
        panic("typed expr: context field next query on released build index")
    if nodeIndex < 0 || nodeIndex >= index.contextFieldNodeNext.len:
        return -1
    return index.contextFieldNodeNext[nodeIndex]

fn TypedExprBuildIndexContextFieldSetLayout(index: var TypedExprBuildIndex,
                                             nodeIndex: int32,
                                             offsetBytes: int32,
                                             sizeBytes: int32,
                                             alignBytes: int32) =
    if index == nil || index.released || nodeIndex < 0 ||
       nodeIndex >= index.contextFieldNodeOffsetBytes.len ||
       nodeIndex >= index.contextFieldNodeSizeBytes.len ||
       nodeIndex >= index.contextFieldNodeAlignBytes.len ||
       nodeIndex >= index.contextFieldNodeLayoutReady.len ||
       offsetBytes < 0 || sizeBytes <= 0 || alignBytes <= 0:
        panic("typed expr: invalid context field layout write")
    typedExprBuildIndexRequireMutable(index, "context_field_layout_write")
    index.contextFieldNodeOffsetBytes[nodeIndex] = offsetBytes
    index.contextFieldNodeSizeBytes[nodeIndex] = sizeBytes
    index.contextFieldNodeAlignBytes[nodeIndex] = alignBytes
    index.contextFieldNodeLayoutReady[nodeIndex] = true

@borrows
fn TypedExprBuildIndexContextFieldLayout(index: TypedExprBuildIndex,
                                          nodeIndex: int32,
                                          offsetBytes: var int32,
                                          sizeBytes: var int32,
                                          alignBytes: var int32): bool =
    offsetBytes = 0
    sizeBytes = 0
    alignBytes = 0
    if index == nil:
        return false
    if index.released:
        panic("typed expr: context field layout query on released build index")
    if nodeIndex < 0 ||
       nodeIndex >= index.contextFieldNodeLayoutReady.len ||
       nodeIndex >= index.contextFieldNodeOffsetBytes.len ||
       nodeIndex >= index.contextFieldNodeSizeBytes.len ||
       nodeIndex >= index.contextFieldNodeAlignBytes.len ||
       !index.contextFieldNodeLayoutReady[nodeIndex]:
        return false
    offsetBytes = index.contextFieldNodeOffsetBytes[nodeIndex]
    sizeBytes = index.contextFieldNodeSizeBytes[nodeIndex]
    alignBytes = index.contextFieldNodeAlignBytes[nodeIndex]
    return true

@borrows
fn TypedExprBuildIndexRehashLayouts(index: TypedExprBuildIndex,
                                     minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for slot in 0..<index.layoutSourcePaths.len:
        if slot >= index.layoutHashes.len:
            panic("typed expr: corrupt layout hashes")
        let bucket = TypedExprBuildIndexBucket(index.layoutHashes[slot], heads.len)
        add(next, heads[bucket])
        heads[bucket] = slot
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.layoutBucketHeads = heads
    index.layoutNext = next

@borrows
@borrow_result
fn typedExprBuildIndexLayoutSourcePath(index: TypedExprBuildIndex,
                                       row: int32): str =
    return typedExprBuildIndexTextAt(
        index, row, typedExprBuildIndexTextColumnLayoutSourcePath)

@borrows
@borrow_result
fn typedExprBuildIndexLayoutTypeName(index: TypedExprBuildIndex,
                                     row: int32): str =
    return typedExprBuildIndexTextAt(
        index, row, typedExprBuildIndexTextColumnLayoutTypeName)

@borrows
fn TypedExprBuildIndexFindLayout(index: TypedExprBuildIndex,
                                  sourcePath: str,
                                  typeText: str,
                                  registerProbe: bool): int32 =
    if index.layoutBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash2(sourcePath, typeText)
    let bucket = TypedExprBuildIndexBucket(hashValue, index.layoutBucketHeads.len)
    var slot = index.layoutBucketHeads[bucket]
    while slot >= 0:
        if slot >= index.layoutNext.len ||
           slot >= index.layoutHashes.len ||
           slot >= index.layoutTypeNames.len:
            panic("typed expr: corrupt layout chain")
        if !index.frozenReadOnlyQueries:
            if registerProbe:
                index.registerProbeCount = index.registerProbeCount + 1
            else:
                index.queryProbeCount = index.queryProbeCount + 1
        if index.layoutHashes[slot] == hashValue &&
           typedExprBuildIndexLayoutSourcePath(index, slot) == sourcePath &&
           typedExprBuildIndexLayoutTypeName(index, slot) == typeText:
            return slot
        slot = index.layoutNext[slot]
    return -1

fn TypedExprBuildIndexLayoutBegin(index: TypedExprBuildIndex,
                                   sourcePath: str,
                                   typeText: str): int32 =
    typedExprBuildIndexRequireMutable(index, "type_layout_begin")
    index.registerCount = index.registerCount + 1
    let nextLayouts = typedExprCheckedAdd64(Int64(index.layoutSourcePaths.len), 1,
                                            "layout_load_items")
    if typedExprCheckedMul64(nextLayouts, 4, "layout_load_items") >=
       typedExprCheckedMul64(Int64(index.layoutBucketHeads.len), 3,
                             "layout_load_buckets"):
        TypedExprBuildIndexRehashLayouts(index, index.layoutBucketHeads.len)
    let existing = TypedExprBuildIndexFindLayout(index, sourcePath, typeText, true)
    if existing >= 0:
        return existing
    let hashValue = TypedExprBuildIndexHash2(sourcePath, typeText)
    let bucket = TypedExprBuildIndexBucket(hashValue, index.layoutBucketHeads.len)
    let slot = index.layoutSourcePaths.len
    seqs.Add(index.layoutNext, index.layoutBucketHeads[bucket])
    seqs.Add(index.layoutHashes, hashValue)
    typedExprBuildIndexAppendBorrowedText(index,
                                          typedExprBuildIndexTextColumnLayoutSourcePath,
                                          sourcePath)
    typedExprBuildIndexAppendBorrowedText(index,
                                          typedExprBuildIndexTextColumnLayoutTypeName,
                                          typeText)
    seqs.Add(index.layoutStates, 1)
    seqs.Add(index.layoutSizeBytes, 0)
    seqs.Add(index.layoutAlignBytes, 0)
    index.layoutBucketHeads[bucket] = slot
    return slot

@borrows
fn TypedExprBuildIndexLayoutLookup(index: TypedExprBuildIndex,
                                    sourcePath: str,
                                    typeText: str,
                                    slot: var int32,
                                    sizeBytes: var int32,
                                    alignBytes: var int32): int32 =
    slot = -1
    sizeBytes = 0
    alignBytes = 0
    if index == nil:
        return 0
    if index.released:
        panic("typed expr: layout query on released build index")
    if !index.frozenReadOnlyQueries:
        index.queryLookupCount = index.queryLookupCount + 1
    slot = TypedExprBuildIndexFindLayout(index, sourcePath, typeText, false)
    if slot < 0:
        return 0
    if slot >= index.layoutStates.len || slot >= index.layoutSizeBytes.len || slot >= index.layoutAlignBytes.len:
        panic("typed expr: corrupt context layout index")
    if index.layoutStates[slot] == 2:
        sizeBytes = index.layoutSizeBytes[slot]
        alignBytes = index.layoutAlignBytes[slot]
    return index.layoutStates[slot]

fn TypedExprBuildIndexLayoutFinish(index: TypedExprBuildIndex,
                                    slot: int32,
                                    ok: bool,
                                    sizeBytes: int32,
                                    alignBytes: int32) =
    if index == nil || index.released || slot < 0 ||
       slot >= index.layoutStates.len || slot >= index.layoutSizeBytes.len || slot >= index.layoutAlignBytes.len:
        panic("typed expr: invalid context layout completion")
    typedExprBuildIndexRequireMutable(index, "type_layout_finish")
    var states = index.layoutStates
    var sizes = index.layoutSizeBytes
    var aligns = index.layoutAlignBytes
    if ok:
        if sizeBytes <= 0 || alignBytes <= 0:
            panic("typed expr: successful context layout is invalid")
        states[slot] = 2
        sizes[slot] = sizeBytes
        aligns[slot] = alignBytes
    else:
        states[slot] = 3
        sizes[slot] = 0
        aligns[slot] = 0
    index.layoutStates = states
    index.layoutSizeBytes = sizes
    index.layoutAlignBytes = aligns

@borrows
fn TypedExprBuildIndexRehashFieldOwners(index: TypedExprBuildIndex,
                                         minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for ownerIndex in 0..<index.fieldOwnerSourcePaths.len:
        if ownerIndex >= index.fieldOwnerHashes.len:
            panic("typed expr: corrupt field owner hashes")
        let bucket = TypedExprBuildIndexBucket(index.fieldOwnerHashes[ownerIndex], heads.len)
        add(next, heads[bucket])
        heads[bucket] = ownerIndex
        index.rehashEntryVisitCount = index.rehashEntryVisitCount + 1
    index.fieldOwnerBucketHeads = heads
    index.fieldOwnerNext = next

@borrows
@borrow_result
fn typedExprBuildIndexFieldOwnerSourcePath(index: TypedExprBuildIndex,
                                           row: int32): str =
    return typedExprBuildIndexTextAt(
        index, row, typedExprBuildIndexTextColumnFieldOwnerSourcePath)

@borrows
@borrow_result
fn typedExprBuildIndexFieldOwnerType(index: TypedExprBuildIndex,
                                     row: int32): str =
    return typedExprBuildIndexTextAt(
        index, row, typedExprBuildIndexTextColumnFieldOwnerType)

@borrows
fn TypedExprBuildIndexFindFieldOwner(index: TypedExprBuildIndex,
                                      sourcePath: str,
                                      ownerType: str,
                                      registerProbe: bool): int32 =
    if index.fieldOwnerBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash2(sourcePath, ownerType)
    let bucket = TypedExprBuildIndexBucket(hashValue, index.fieldOwnerBucketHeads.len)
    var ownerIndex = index.fieldOwnerBucketHeads[bucket]
    while ownerIndex >= 0:
        if ownerIndex >= index.fieldOwnerNext.len ||
           ownerIndex >= index.fieldOwnerHashes.len ||
           ownerIndex >= index.fieldOwnerTypes.len:
            panic("typed expr: corrupt field owner chain")
        if !index.frozenReadOnlyQueries:
            if registerProbe:
                index.registerProbeCount = index.registerProbeCount + 1
            else:
                index.queryProbeCount = index.queryProbeCount + 1
        if index.fieldOwnerHashes[ownerIndex] == hashValue &&
           typedExprBuildIndexFieldOwnerSourcePath(index, ownerIndex) ==
               sourcePath &&
           typedExprBuildIndexFieldOwnerType(index, ownerIndex) == ownerType:
            return ownerIndex
        ownerIndex = index.fieldOwnerNext[ownerIndex]
    return -1

@borrows
fn TypedExprBuildIndexAddFieldOwnerRow(index: var TypedExprBuildIndex,
                                        sourcePath: str,
                                        ownerType: str,
                                        rowIndex: int32) =
    if index == nil || index.released || rowIndex < 0:
        panic("typed expr: field owner row requires live build index")
    typedExprBuildIndexRequireMutable(index, "field_owner_row_add")
    index.registerCount = index.registerCount + 1
    let nextOwners = typedExprCheckedAdd64(Int64(index.fieldOwnerSourcePaths.len), 1,
                                           "field_owner_load_items")
    if typedExprCheckedMul64(nextOwners, 4, "field_owner_load_items") >=
       typedExprCheckedMul64(Int64(index.fieldOwnerBucketHeads.len), 3,
                             "field_owner_load_buckets"):
        TypedExprBuildIndexRehashFieldOwners(index, index.fieldOwnerBucketHeads.len)
    var ownerIndex = TypedExprBuildIndexFindFieldOwner(index, sourcePath, ownerType, true)
    if ownerIndex < 0:
        let hashValue = TypedExprBuildIndexHash2(sourcePath, ownerType)
        let bucket = TypedExprBuildIndexBucket(hashValue, index.fieldOwnerBucketHeads.len)
        ownerIndex = index.fieldOwnerSourcePaths.len
        seqs.Add(index.fieldOwnerNext, index.fieldOwnerBucketHeads[bucket])
        seqs.Add(index.fieldOwnerHashes, hashValue)
        typedExprBuildIndexAppendBorrowedText(index,
                                              typedExprBuildIndexTextColumnFieldOwnerSourcePath,
                                              sourcePath)
        typedExprBuildIndexAppendBorrowedText(index,
                                              typedExprBuildIndexTextColumnFieldOwnerType,
                                              ownerType)
        seqs.Add(index.fieldOwnerHeads, -1)
        seqs.Add(index.fieldOwnerTails, -1)
        index.fieldOwnerBucketHeads[bucket] = ownerIndex
    while index.fieldRowNext.len <= rowIndex:
        seqs.Add(index.fieldRowNext, -1)
    if index.fieldOwnerHeads[ownerIndex] < 0:
        index.fieldOwnerHeads[ownerIndex] = rowIndex
    else:
        index.fieldRowNext[index.fieldOwnerTails[ownerIndex]] = rowIndex
    index.fieldOwnerTails[ownerIndex] = rowIndex

@borrows
fn TypedExprBuildIndexFieldOwnerHead(index: TypedExprBuildIndex,
                                      sourcePath: str,
                                      ownerType: str): int32 =
    if index == nil:
        return -1
    if index.released:
        panic("typed expr: field owner query on released build index")
    if !index.frozenReadOnlyQueries:
        index.queryLookupCount = index.queryLookupCount + 1
    let ownerIndex = TypedExprBuildIndexFindFieldOwner(index, sourcePath, ownerType, false)
    if ownerIndex < 0 || ownerIndex >= index.fieldOwnerHeads.len:
        return -1
    return index.fieldOwnerHeads[ownerIndex]

@borrows
@borrow_result
fn TypedExprBuildIndexContextSourcePath(index: TypedExprBuildIndex,
                                         contextIndex: int32): str =
    if index == nil:
        panic("typed expr: context source query requires an index")
    if index.released:
        panic("typed expr: context source query on released build index")
    if contextIndex < 0 ||
       contextIndex >= typedExprBuildIndexContextSourceCount(index):
        panic("typed expr: context source query index out of bounds")
    return typedExprBuildIndexContextSourcePath(index, contextIndex)

@borrows
fn TypedExprBuildIndexVisibleContextSourcePath(index: TypedExprBuildIndex,
                                                kind: str,
                                                ownerSourcePath: str,
                                                name: str,
                                                detail: str,
                                                targetSourcePath: var str): TypedExprBuildIndexLookupState =
    targetSourcePath = ""
    var targetContextIndex: int32
    let state = TypedExprBuildIndexLookup(index,
                                          kind,
                                          ownerSourcePath,
                                          name,
                                          detail,
                                          targetContextIndex)
    if state != TypedExprBuildIndexUnique:
        return state
    targetSourcePath = parser.ParserOwnedText(
        TypedExprBuildIndexContextSourcePath(index,
                                             targetContextIndex))
    if targetSourcePath == "":
        panic("typed expr: visible declaration has no target source")
    return state

@borrows
fn TypedExprBuildIndexSourceContextForBuild(index: TypedExprBuildIndex,
                                             sourcePath: str): int32 =
    if index == nil:
        return -1
    if index.released:
        panic("typed expr: build source context query on released build index")
    let entryIndex = TypedExprBuildIndexFindEntry(index,
                                                   "ctx_source",
                                                   sourcePath,
                                                   "",
                                                   "",
                                                   true)
    if entryIndex < 0 ||
       entryIndex >= index.entryStates.len ||
       entryIndex >= index.entryValueIndexes.len ||
       index.entryStates[entryIndex] != TypedExprBuildIndexUnique:
        return -1
    return index.entryValueIndexes[entryIndex]

fn TypedExprBuildIndexTakeContextCaches(index: TypedExprBuildIndex,
                                         ctx: var TypedExprSourceContext,
                                         sourcePath: str) =
    if ctx.functionHeaderScanned:
        if ctx.functionHeaderNames.len != ctx.functionHeaderReturnTypes.len:
            panic("typed expr: function header context cache columns mismatch")
        for cacheIndex in 0..<ctx.functionHeaderNames.len:
            TypedExprBuildIndexRegisterContentCache(share(index),
                                                     "function_header_return",
                                                     share(sourcePath),
                                                     share(ctx.functionHeaderNames[cacheIndex]),
                                                     share(ctx.functionHeaderReturnTypes[cacheIndex]))
        TypedExprBuildIndexRegisterContentCache(index,
                                                 "function_header_scanned",
                                                 share(sourcePath),
                                                 "",
                                                 sourcePath)
    elif ctx.functionHeaderNames.len != 0 ||
         ctx.functionHeaderReturnTypes.len != 0:
        panic("typed expr: unowned function header context cache")
    ctx.functionHeaderScanned = false
    ctx.functionHeaderLookup = parser.ParserSourcePathIndexLookup()
    ctx.functionHeaderNames = []
    ctx.functionHeaderReturnTypes = []

@borrows
fn TypedExprSourceContextHasLocalBuildCaches(ctx: TypedExprSourceContext): bool =
    return ctx.functionHeaderScanned ||
           ctx.functionHeaderLookup.slots.len != 0 ||
           ctx.functionHeaderLookup.buckets.len != 0 ||
           ctx.functionHeaderNames.len != 0 ||
           ctx.functionHeaderReturnTypes.len != 0

@borrows
fn TypedExprBuildIndexRequireFreshMetadataKey(index: TypedExprBuildIndex,
                                               kind: str,
                                               sourcePath: str,
                                               name: str,
                                               detail: str) =
    if TypedExprBuildIndexFindEntry(index,
                                    kind,
                                    sourcePath,
                                    name,
                                    detail,
                                    true) >= 0:
        panic(Fmt"typed expr: duplicate structured metadata kind={kind} source={sourcePath} name={name} detail={detail}")

@borrows
fn TypedExprBuildIndexExactEntryValue(index: TypedExprBuildIndex,
                                      kind: str,
                                      sourcePath: str,
                                      name: str,
                                      detail: str,
                                      expectedOrigin: str,
                                      expectedFingerprint: str,
                                      checkFingerprint: bool,
                                      validationMark: int32,
                                      valueIndexOut: var int32): bool =
    valueIndexOut = -1
    if index == nil || index.released:
        panic("typed expr: exact metadata validation requires live build index")
    if !index.frozenReadOnlyQueries:
        index.queryLookupCount = index.queryLookupCount + 1
    let entryIndex = TypedExprBuildIndexFindEntry(index,
                                                   kind,
                                                   sourcePath,
                                                   name,
                                                   detail,
                                                   false)
    if entryIndex < 0 ||
       entryIndex >= index.entryStates.len ||
       entryIndex >= index.entryValueIndexes.len ||
       entryIndex >= typedExprBuildIndexEntryCount(index) ||
       entryIndex >= index.entryValidationMarks.len ||
       index.entryStates[entryIndex] != TypedExprBuildIndexUnique ||
       typedExprBuildIndexEntryOrigin(index, entryIndex) != expectedOrigin:
        return false
    if checkFingerprint &&
       typedExprBuildIndexEntryFingerprint(index, entryIndex) !=
           expectedFingerprint:
        return false
    if validationMark > 0:
        if index.permanentlySealed:
            panic("typed expr: sealed build index validation mark mutation forbidden")
        if index.entryValidationMarks[entryIndex] == validationMark:
            return false
        var marks = index.entryValidationMarks
        marks[entryIndex] = validationMark
        index.entryValidationMarks = marks
    valueIndexOut = index.entryValueIndexes[entryIndex]
    return true

@borrows
fn TypedExprBuildIndexContextDomainCount(index: TypedExprBuildIndex,
                                          contextIndex: int32,
                                          domainOffset: int32): int32 =
    let slot = typedExprCheckedInt32Capacity(
        typedExprCheckedAdd64(
            typedExprCheckedMul64(Int64(contextIndex), 8,
                                  "context_domain_slot"),
            Int64(domainOffset),
            "context_domain_slot"),
        "context_domain_slot")
    if contextIndex < 0 || domainOffset < 0 || domainOffset >= 8 ||
       slot < 0 || slot >= index.contextMetadataDomainCounts.len:
        panic("typed expr: corrupt context metadata domain counts")
    return index.contextMetadataDomainCounts[slot]

@borrows
fn TypedExprBuildIndexValidateOneCallDeclaration(index: TypedExprBuildIndex,
                                                   sourcePath: str,
                                                   name: str,
                                                   genericNames: str[],
                                                   paramTypes: str[],
                                                   returnTypeRaw: str,
                                                   declarationKind: TypedExprCallDeclarationKind,
                                                   targetSymbolRaw: str,
                                                   signatureLineNumber: int32,
                                                   resultExprClass: TypedExprExprClass): int32 =
    var rowIndex: int32
    let normalizedSourcePath = parser.ParserNormalizePath(sourcePath)
    let trimmedName = chengpath.PathTrim(share(name))
    var normalizedName = parser.ParserIdentPrefix(trimmedName)
    if normalizedName == "":
        normalizedName = trimmedName
    let state = typedExprBuildIndexLookupExactCallDeclarationRow(
        share(index),
        normalizedSourcePath,
        normalizedName,
        declarationKind,
        paramTypes,
        rowIndex)
    var returnType = TypedExprNormalizeTypeText(returnTypeRaw)
    if returnType == "":
        returnType = "void"
    var targetSymbol = chengpath.PathTrim(targetSymbolRaw)
    if targetSymbol == "":
        targetSymbol = share(name)
    if state != TypedExprBuildIndexUnique ||
       rowIndex < 0 ||
       rowIndex >= typedExprBuildIndexCallDeclarationCount(index) ||
       index.callDeclarationReturnTypes[rowIndex] != returnType ||
       index.callDeclarationTargetSymbols[rowIndex] != targetSymbol ||
       index.callDeclarationSignatureLineNumbers[rowIndex] !=
           signatureLineNumber ||
       index.callDeclarationKinds[rowIndex] != declarationKind ||
       index.callDeclarationResultExprClasses[rowIndex] != resultExprClass:
        panic(Fmt"typed expr: call declaration metadata changed source={sourcePath} name={name}; explicit reset required")
    if rowIndex >= index.callDeclarationGenericStarts.len ||
       rowIndex >= index.callDeclarationGenericCounts.len ||
       index.callDeclarationGenericCounts[rowIndex] != genericNames.len:
        panic(Fmt"typed expr: call declaration generic metadata changed source={sourcePath} name={name}; explicit reset required")
    let genericStart = index.callDeclarationGenericStarts[rowIndex]
    if genericStart < 0 ||
       genericStart > typedExprBuildIndexCallGenericNameCount(index) - genericNames.len:
        panic(Fmt"typed expr: call declaration generic range changed source={sourcePath} name={name}; explicit reset required")
    for genericIndex in 0..<genericNames.len:
        if typedExprBuildIndexCallGenericName(share(index),
                                              genericStart + genericIndex) !=
           genericNames[genericIndex]:
            panic(Fmt"typed expr: call declaration generic name changed source={sourcePath} name={name} index={genericIndex}; explicit reset required")
    return rowIndex

@borrows
fn TypedExprBuildIndexValidateScopeCallDeclaration(index: TypedExprBuildIndex,
                                                     ctx: var TypedExprSourceContext,
                                                     scope: TypedExprFunctionScope,
                                                     sourcePath: str): int32 =
    var genericNames: str[]
    var paramTypes: str[]
    var returnType: str
    TypedExprScopeCallDeclarationInto(ctx,
                                      share(scope),
                                      genericNames,
                                      paramTypes,
                                      returnType)
    let rowIndex = TypedExprBuildIndexValidateOneCallDeclaration(share(index),
                                                   sourcePath,
                                                   share(scope.name),
                                                   genericNames,
                                                   share(paramTypes),
                                                   returnType,
                                                   TypedExprCallDeclarationFunction,
                                                   scope.name,
                                                   scope.startLine,
                                                       scope.borrowResult ?
                                                           TypedExprExprBorrowed :
                                                           TypedExprExprOwned)
    if rowIndex < 0 ||
       index.callDeclarationManualConsumePresents[rowIndex] !=
           scope.manualConsumePresent ||
       index.callDeclarationManualConsumeFunctionDeclarationRows[rowIndex] !=
           scope.manualConsumeFunctionDeclarationRow ||
       index.callDeclarationManualConsumeTargetParameterOrdinals[rowIndex] !=
           scope.manualConsumeTargetParameterOrdinal ||
       index.callDeclarationManualConsumeSourceParameterOrdinals[rowIndex] !=
           scope.manualConsumeSourceParameterOrdinal ||
       index.callDeclarationManualConsumeTargetParameterDeclarationRows[
           rowIndex] != scope.manualConsumeTargetParameterDeclarationRow ||
       index.callDeclarationManualConsumeSourceParameterDeclarationRows[
           rowIndex] != scope.manualConsumeSourceParameterDeclarationRow:
        panic("typed expr: call declaration manual-consume parser identity changed; explicit reset required")
    if scope.manualConsumePresent &&
       index.callDeclarationManualConsumeTypeArenaBound &&
       (index.callDeclarationManualConsumeTargetTypeIds[rowIndex] < 0 ||
        index.callDeclarationManualConsumeSourceTypeIds[rowIndex] < 0 ||
        layout.FixedBytes32Equal(
            index.callDeclarationManualConsumeEffectCids[rowIndex],
            layout.FixedBytes32())):
        panic("typed expr: call declaration manual-consume TypeArena authority changed")
    return paramTypes.len

# Initial construction rejects duplicate primary keys. On reuse, equal domain
# counts plus one-to-one marked matches against complete structured entries form
# an exact bijection; bucket hashes affect lookup cost, never equality.
@borrows
fn TypedExprBuildIndexValidateContextMetadata(index: TypedExprBuildIndex,
                                               ctx: var TypedExprSourceContext,
                                               contextIndex: int32,
                                               sourcePath: str,
                                               validationMark: int32) =
    if ctx.typeDefAliasNames.len != ctx.typeDefAliasTargetTypes.len:
        panic("typed expr: type alias metadata columns changed after index seal")
    if ctx.declaredTypes.len !=
           ctx.declaredTypeProducerSourceIndexes.len ||
       ctx.declaredTypes.len !=
           ctx.declaredTypeDeclarationSourceLocalRows.len ||
       ctx.declaredTypes.len != ctx.declaredTypeBuiltinKinds.len:
        panic("typed expr: declared type exact coordinate columns changed after index seal")
    if ctx.enumValueNames.len != ctx.enumValueTypes.len ||
       ctx.enumValueNames.len != ctx.enumValueOrdinals.len:
        panic("typed expr: enum metadata columns changed after index seal")
    if TypedExprBuildIndexContextDomainCount(index, contextIndex, 0) != ctx.importedModules.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 1) != ctx.declaredTypes.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 2) != ctx.refTypes.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 3) != ctx.typeDefAliasNames.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 4) != ctx.enumValueNames.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 5) != ctx.typeFields.len:
        panic(Fmt"typed expr: metadata domain count changed index={contextIndex}; explicit reset required")

    var callDeclarationCount: int32
    var callParameterCount: int32
    if ctx.signatureScopes.len > 0:
        for itemIndex in 0..<ctx.signatureScopes.len:
            let parameterCount = TypedExprBuildIndexValidateScopeCallDeclaration(share(index),
                                                                                   ctx,
                                                                                   ctx.signatureScopes[itemIndex],
                                                                                   share(sourcePath))
            callParameterCount = callParameterCount + parameterCount
            callDeclarationCount = callDeclarationCount + 1
    else:
        for itemIndex in 0..<ctx.scopes.len:
            let parameterCount = TypedExprBuildIndexValidateScopeCallDeclaration(share(index),
                                                                                   ctx,
                                                                                   ctx.scopes[itemIndex],
                                                                                   share(sourcePath))
            callParameterCount = callParameterCount + parameterCount
            callDeclarationCount = callDeclarationCount + 1
    for itemIndex in 0..<ctx.importcFunctions.len:
        let importcFn = ctx.importcFunctions[itemIndex]
        let paramTypes = TypedExprSplitParamTypeJoin(importcFn.paramTypeJoin)
        var targetSymbol = importcFn.importName
        if targetSymbol == "":
            targetSymbol = importcFn.name
        TypedExprBuildIndexValidateOneCallDeclaration(share(index),
                                                       share(sourcePath),
                                                       importcFn.name,
                                                       [],
                                                       share(paramTypes),
                                                       importcFn.returnType,
                                                       TypedExprCallDeclarationImportc,
                                                       targetSymbol,
                                                       0,
                                                       importcFn.ffiOwnedResultPresent ?
                                                           TypedExprExprOwned :
                                                           TypedExprExprUnknown)
        callDeclarationCount = callDeclarationCount + 1
        callParameterCount = callParameterCount + paramTypes.len
    if TypedExprBuildIndexContextDomainCount(index, contextIndex, 6) != callDeclarationCount ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 7) != callParameterCount:
        panic(Fmt"typed expr: call declaration domain count changed index={contextIndex}; explicit reset required")

    for itemIndex in 0..<ctx.importedModules.len:
        let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(share(ctx.importedModules[itemIndex].qualifier)))
        let targetSourcePath = parser.ParserNormalizePath(ctx.importedModules[itemIndex].targetSourcePath)
        if qualifier == "" || targetSourcePath == "":
            panic("typed expr: imported module identity changed after index seal")
        var targetContextIndex: int32
        let targetState = TypedExprBuildIndexLookup(index,
                                                     "ctx_source",
                                                     targetSourcePath,
                                                     "",
                                                     "",
                                                     targetContextIndex)
        if targetState == TypedExprBuildIndexMissing:
            targetContextIndex = -1
        elif targetState != TypedExprBuildIndexUnique:
            panic("typed expr: imported module target became ambiguous")
        var entryValue: int32
        if !TypedExprBuildIndexExactEntryValue(share(index),
                                               "ctx_import_alias",
                                               share(sourcePath),
                                               qualifier,
                                               "",
                                               share(sourcePath),
                                               share(targetSourcePath),
                                               true,
                                               validationMark,
                                               entryValue) ||
           entryValue != targetContextIndex:
            panic(Fmt"typed expr: import metadata changed index={contextIndex} row={itemIndex}; explicit reset required")
        if targetContextIndex >= 0:
            if !TypedExprBuildIndexExactEntryValue(share(index),
                                                   "ctx_import_target",
                                                   share(sourcePath),
                                                   share(targetSourcePath),
                                                   "",
                                                   share(sourcePath),
                                                   targetSourcePath,
                                                   true,
                                                   0,
                                                   entryValue) ||
               entryValue != targetContextIndex:
                panic(Fmt"typed expr: import edge changed index={contextIndex} row={itemIndex}; explicit reset required")

    for itemIndex in 0..<ctx.declaredTypes.len:
        let builtinRaw =
            ctx.declaredTypeBuiltinKinds[itemIndex]
        if builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(TypedExprLayoutBuiltinOptional):
            panic("typed expr: declared type builtin kind invalid")
        let builtinKind = TypedExprLayoutBuiltinKind(
            builtinRaw)
        if ctx.declaredTypeProducerSourceIndexes[itemIndex] < 0 ||
           ((builtinKind == TypedExprLayoutBuiltinNone) !=
            (ctx.declaredTypeDeclarationSourceLocalRows[itemIndex] >= 0)):
            panic("typed expr: declared type exact coordinate missing")
        let name = TypedExprTypeLeafName(ctx.declaredTypes[itemIndex])
        var entryValue: int32
        if !TypedExprBuildIndexExactEntryValue(share(index),
                                               "ctx_declared_source",
                                               share(sourcePath),
                                               share(name),
                                               "",
                                               share(sourcePath),
                                               name,
                                               true,
                                               validationMark,
                                               entryValue) ||
           entryValue != contextIndex:
            panic(Fmt"typed expr: declared type metadata changed index={contextIndex} row={itemIndex}; explicit reset required")

    for itemIndex in 0..<ctx.typeFields.len:
        let field = ctx.typeFields[itemIndex]
        if field.producerSourceIndex < 0 || field.ordinal < 0 ||
           ((field.builtinKind == TypedExprLayoutBuiltinNone) !=
            (field.ownerDeclarationSourceLocalRow >= 0 &&
             field.fieldDeclarationSourceLocalRow >= 0)):
            panic("typed expr: field exact coordinate missing")

    for itemIndex in 0..<ctx.refTypes.len:
        let name = TypedExprTypeLeafName(ctx.refTypes[itemIndex])
        var entryValue: int32
        if !TypedExprBuildIndexExactEntryValue(share(index),
                                               "ctx_ref_source",
                                               share(sourcePath),
                                               share(name),
                                               "",
                                               share(sourcePath),
                                               name,
                                               true,
                                               validationMark,
                                               entryValue) ||
           entryValue != contextIndex:
            panic(Fmt"typed expr: ref type metadata changed index={contextIndex} row={itemIndex}; explicit reset required")

    for itemIndex in 0..<ctx.typeDefAliasNames.len:
        let name = parser.ParserIdentPrefix(chengpath.PathTrim(share(ctx.typeDefAliasNames[itemIndex])))
        let target = TypedExprNormalizeTypeText(share(ctx.typeDefAliasTargetTypes[itemIndex]))
        var entryValue: int32
        if !TypedExprBuildIndexExactEntryValue(share(index),
                                               "ctx_alias_source",
                                               share(sourcePath),
                                               name,
                                               "",
                                               share(sourcePath),
                                               target,
                                               true,
                                               validationMark,
                                               entryValue) ||
           entryValue != contextIndex:
            panic(Fmt"typed expr: alias metadata changed index={contextIndex} row={itemIndex}; explicit reset required")

    for itemIndex in 0..<ctx.enumValueNames.len:
        let name = ctx.enumValueNames[itemIndex]
        let typeName = TypedExprTypeLeafName(ctx.enumValueTypes[itemIndex])
        var entryValue: int32
        if !TypedExprBuildIndexExactEntryValue(share(index),
                                               "ctx_enum_name_source",
                                               share(sourcePath),
                                               share(name),
                                               "",
                                               share(sourcePath),
                                               "",
                                               false,
                                               validationMark,
                                               entryValue) ||
           entryValue != ctx.enumValueOrdinals[itemIndex]:
            panic(Fmt"typed expr: enum ordinal metadata changed index={contextIndex} row={itemIndex}; explicit reset required")
        if !TypedExprBuildIndexExactEntryValue(share(index),
                                               "ctx_enum_name_type_source",
                                               share(sourcePath),
                                               share(name),
                                               "",
                                               share(sourcePath),
                                               typeName,
                                               true,
                                               0,
                                               entryValue) ||
           entryValue != contextIndex:
            panic(Fmt"typed expr: enum type metadata changed index={contextIndex} row={itemIndex}; explicit reset required")

    for itemIndex in 0..<ctx.typeFields.len:
        let field = ctx.typeFields[itemIndex]
        let ownerType = TypedExprTypeLeafName(field.ownerType)
        let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(share(field.fieldName)))
        let fieldType = TypedExprNormalizeTypeText(share(field.fieldType))
        var nodeIndex: int32
        if !TypedExprBuildIndexExactEntryValue(share(index),
                                               "ctx_field_source",
                                               share(sourcePath),
                                               ownerType,
                                               fieldName,
                                               share(sourcePath),
                                               fieldType,
                                               true,
                                               validationMark,
                                               nodeIndex) ||
           nodeIndex < 0 ||
           nodeIndex >= index.contextFieldNodeContextIndexes.len ||
           nodeIndex >= index.contextFieldNodeRowIndexes.len ||
           nodeIndex >= index.contextFieldNodeDeclaredOffsetBytes.len ||
           nodeIndex >= index.contextFieldNodeDeclaredSizeBytes.len ||
           nodeIndex >= index.contextFieldNodeDeclaredAlignBytes.len ||
           index.contextFieldNodeContextIndexes[nodeIndex] != contextIndex ||
           index.contextFieldNodeRowIndexes[nodeIndex] != itemIndex ||
           index.contextFieldNodeDeclaredOffsetBytes[nodeIndex] != field.offsetBytes ||
           index.contextFieldNodeDeclaredSizeBytes[nodeIndex] != field.sizeBytes ||
           index.contextFieldNodeDeclaredAlignBytes[nodeIndex] != field.alignBytes:
            panic(Fmt"typed expr: field metadata changed index={contextIndex} row={itemIndex}; explicit reset required")

# [D-B2b] Exact core-build reservation (gk1 measured+64KB precedent: the
# measured size is in hand before the build). The expected entry-row count is
# summed from the same metadata context columns the two registration passes
# iterate, counting one row per Register call, so the sum is an exact upper
# bound on appended entry rows (dedup only reduces). Reserving the entry
# columns and their bucket directory once up front removes the append-doubling
# transients, retained capacity slack and the rehash chain for the dominant
# table. The visibility/owner/node tables stay on plain append growth: their
# whole live size is under ~2MB, so a reserve that honours the dedup-shaped
# upper bound would touch more pages up front than doubling ever allocates
# (measured: v1 whole-index reserve moved the pass-1 window the wrong way).
# Reservation is a hint: exceeding a cap still falls back to normal growth,
# never a correctness input.
@borrows
fn typedExprBuildIndexReserveCoreCapacity(
        index: TypedExprBuildIndex,
        sourceContexts: var TypedExprSourceContext[]) =
    if index == nil || index.released:
        panic("typed expr: build index reserve on missing or released index")
    var entryRows: int64
    for ctxIndex in 0..<sourceContexts.len:
        # Upper bounds per context: ctx_source 1 + the unconditional
        # module_const_scanned marker 1; imports alias+target 2;
        # declared/ref/alias 2 entries each; enums 6 entries; fields 5 entries
        # (owner source and global and count dedup); module consts 2 entries
        # (counted only when the context already carries the scanned names; an
        # unscanned context contributes 0 here and the column falls back to
        # normal growth, never a correctness input).
        let imports = sourceContexts[ctxIndex].importedModules.len
        let declared = sourceContexts[ctxIndex].declaredTypes.len
        let refs = sourceContexts[ctxIndex].refTypes.len
        let aliases = sourceContexts[ctxIndex].typeDefAliasNames.len
        let enums = sourceContexts[ctxIndex].enumValueNames.len
        let fields = sourceContexts[ctxIndex].typeFields.len
        let consts = sourceContexts[ctxIndex].moduleConstNames.len
        entryRows = typedExprCheckedAdd64(entryRows, Int64(2),
                                          "reserve_entry_rows")
        entryRows = typedExprCheckedAdd64(entryRows,
            typedExprCheckedMul64(Int64(imports), 2, "reserve_entry_rows"),
            "reserve_entry_rows")
        entryRows = typedExprCheckedAdd64(entryRows,
            typedExprCheckedMul64(Int64(declared), 2, "reserve_entry_rows"),
            "reserve_entry_rows")
        entryRows = typedExprCheckedAdd64(entryRows,
            typedExprCheckedMul64(Int64(refs), 2, "reserve_entry_rows"),
            "reserve_entry_rows")
        entryRows = typedExprCheckedAdd64(entryRows,
            typedExprCheckedMul64(Int64(aliases), 2, "reserve_entry_rows"),
            "reserve_entry_rows")
        entryRows = typedExprCheckedAdd64(entryRows,
            typedExprCheckedMul64(Int64(enums), 6, "reserve_entry_rows"),
            "reserve_entry_rows")
        entryRows = typedExprCheckedAdd64(entryRows,
            typedExprCheckedMul64(Int64(fields), 5, "reserve_entry_rows"),
            "reserve_entry_rows")
        entryRows = typedExprCheckedAdd64(entryRows,
            typedExprCheckedMul64(Int64(consts), 2, "reserve_entry_rows"),
            "reserve_entry_rows")
    let entryCap = typedExprCheckedInt32Capacity(entryRows, "reserve_entry_cap")
    let contextCap = typedExprCheckedInt32Capacity(
        Int64(sourceContexts.len), "reserve_context_cap")
    if entryCap > 0:
        index.entryBucketHeads = typedExprBuildIndexExactBuckets(entryCap)
        seqs.Reserve(index.entryNext, entryCap)
        seqs.Reserve(index.entryHashes, entryCap)
        seqs.Reserve(index.entryStates, entryCap)
        seqs.Reserve(index.entryValueIndexes, entryCap)
        seqs.Reserve(index.entryValidationMarks, entryCap)
        seqs.Reserve(index.entryKinds, entryCap)
        seqs.Reserve(index.entrySourcePaths, entryCap)
        seqs.Reserve(index.entryNames, entryCap)
        seqs.Reserve(index.entryDetails, entryCap)
        seqs.Reserve(index.entryOrigins, entryCap)
        seqs.Reserve(index.entryFingerprints, entryCap)
    seqs.Reserve(index.contextSourcePaths, contextCap)
    seqs.Reserve(index.contextMetadataDomainCounts,
                 typedExprContextDomainColumnCount(contextCap))

# [p1phase1] Core pass 1 extracted verbatim from
# `typedExprBuildIndexForContextsCore` so the streaming deferred-core
# builder runs exactly the same statements in exactly the same order
# (byte-identity contract: same producer, same registration order, no
# reordering anywhere).
@borrows
fn typedExprBuildIndexCorePass1(
        sourceContexts: var TypedExprSourceContext[],
        index: TypedExprBuildIndex) =
    # Pass 1 establishes exact source identity before any cross-context edge is
    # indexed. No query can observe a partially registered source set.
    for ctxIndex in 0..<sourceContexts.len:
        var sourcePath = sourceContexts[ctxIndex].normalizedSourcePath
        if sourcePath == "":
            sourcePath = parser.ParserNormalizePath(sourceContexts[ctxIndex].sourcePath)
            sourceContexts[ctxIndex].normalizedSourcePath = share(sourcePath)
        if sourcePath == "":
            panic("typed expr: build index source path missing")
        TypedExprSourceContextSetBorrowedBuildIndex(
            sourceContexts[ctxIndex], share(index))
        add(index.contextSourcePaths, share(sourcePath))
        TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                   "ctx_source",
                                                   sourcePath,
                                                   "",
                                                   "")
        TypedExprBuildIndexRegister(index, "ctx_source", sourcePath, "", "", ctxIndex,
                                    sourcePath, sourcePath, true)
        # Freeze consumes one authority only: local module-const SoA is built
        # first, then the exact same rows are registered into the shared index.
        # Direct lines->index scanning would leave projection rows empty and
        # violate the compact-entry/projection bijection.
        if !sourceContexts[ctxIndex].moduleConstScanned:
            if sourceContexts[ctxIndex].lines.len <= 0:
                panic("typed expr: module const authority missing before build index")
            TypedExprModuleConstScanStoredContextLines(
                sourceContexts[ctxIndex],
                sourcePath)
        TypedExprModuleConstRegisterContextRows(sourceContexts[ctxIndex],
                                                 sourcePath)
        TypedExprBuildIndexTakeContextCaches(share(index),
                                             sourceContexts[ctxIndex],
                                             sourcePath)
        if sourceContexts[ctxIndex].typeDefAliasNames.len !=
           sourceContexts[ctxIndex].typeDefAliasTargetTypes.len:
            panic("typed expr: type alias metadata columns mismatch")
        if sourceContexts[ctxIndex].enumValueNames.len != sourceContexts[ctxIndex].enumValueTypes.len ||
           sourceContexts[ctxIndex].enumValueNames.len != sourceContexts[ctxIndex].enumValueOrdinals.len:
            panic("typed expr: enum metadata columns mismatch")
        add(index.contextMetadataDomainCounts, sourceContexts[ctxIndex].importedModules.len)
        add(index.contextMetadataDomainCounts, sourceContexts[ctxIndex].declaredTypes.len)
        add(index.contextMetadataDomainCounts, sourceContexts[ctxIndex].refTypes.len)
        add(index.contextMetadataDomainCounts, sourceContexts[ctxIndex].typeDefAliasNames.len)
        add(index.contextMetadataDomainCounts, sourceContexts[ctxIndex].enumValueNames.len)
        add(index.contextMetadataDomainCounts, sourceContexts[ctxIndex].typeFields.len)
        add(index.contextMetadataDomainCounts, 0)
        add(index.contextMetadataDomainCounts, 0)
    index.contextCount = sourceContexts.len
# [p1phase1] Core pass 2 extracted verbatim from
# `typedExprBuildIndexForContextsCore`; the deferred-core finish runs
# this verbatim as the metadata producer after the merge loop.  The
# index formal is `var` because the fields loop forwards it to
# var-formal mutators (TypedExprBuildIndexIncrement /
# AddContextFieldNode), and the fn is @borrows so the var formal
# accepts a forwarded mutable borrow (the
# typedExprBuildIndexFinishCallDeclarationsManualRec ->
# TypedExprBuildIndexAppendContextCallDeclarationsManual shape).
@borrows
fn typedExprBuildIndexCorePass2(
        sourceContexts: var TypedExprSourceContext[],
        index: var TypedExprBuildIndex) =
    # Pass 2 visits every metadata row once and records exact source/global keys.
    for ctxIndex in 0..<sourceContexts.len:
        let sourcePath = sourceContexts[ctxIndex].normalizedSourcePath
        for itemIndex in 0..<sourceContexts[ctxIndex].importedModules.len:
            let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(sourceContexts[ctxIndex].importedModules[itemIndex].qualifier))
            let targetSourcePath = parser.ParserNormalizePath(sourceContexts[ctxIndex].importedModules[itemIndex].targetSourcePath)
            if qualifier == "" || targetSourcePath == "":
                panic("typed expr: imported module identity missing")
            let targetContextIndex = TypedExprBuildIndexSourceContextForBuild(index,
                                                                               targetSourcePath)
            TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                       "ctx_import_alias",
                                                       sourcePath,
                                                       qualifier,
                                                       "")
            TypedExprBuildIndexRegister(index, "ctx_import_alias", sourcePath, qualifier, "",
                                        targetContextIndex, sourcePath, targetSourcePath, true)
            if targetContextIndex < 0:
                continue
            TypedExprBuildIndexRegister(index, "ctx_import_target", sourcePath, targetSourcePath, "",
                                        targetContextIndex, sourcePath, targetSourcePath, true)
        for itemIndex in 0..<sourceContexts[ctxIndex].declaredTypes.len:
            let name = TypedExprTypeLeafName(sourceContexts[ctxIndex].declaredTypes[itemIndex])
            TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                       "ctx_declared_source",
                                                       sourcePath,
                                                       name,
                                                       "")
            TypedExprBuildIndexRegister(index, "ctx_declared_source", sourcePath, name, "", ctxIndex, sourcePath, name, true)
            TypedExprBuildIndexRegister(index, "ctx_declared_global", "", name, "", ctxIndex, sourcePath, name, false)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_declared", sourcePath, name, "",
                                                              ctxIndex, name)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_composite", sourcePath, name, "",
                                                              ctxIndex, name)
        for itemIndex in 0..<sourceContexts[ctxIndex].refTypes.len:
            let name = TypedExprTypeLeafName(sourceContexts[ctxIndex].refTypes[itemIndex])
            TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                       "ctx_ref_source",
                                                       sourcePath,
                                                       name,
                                                       "")
            TypedExprBuildIndexRegister(index, "ctx_ref_source", sourcePath, name, "", ctxIndex, sourcePath, name, true)
            TypedExprBuildIndexRegister(index, "ctx_ref_global", "", name, "", ctxIndex, sourcePath, name, false)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_ref", sourcePath, name, "",
                                                              ctxIndex, name)
        for itemIndex in 0..<sourceContexts[ctxIndex].typeDefAliasNames.len:
            if itemIndex >= sourceContexts[ctxIndex].typeDefAliasTargetTypes.len:
                panic("typed expr: type alias metadata columns mismatch")
            let name = parser.ParserIdentPrefix(chengpath.PathTrim(sourceContexts[ctxIndex].typeDefAliasNames[itemIndex]))
            let target = TypedExprNormalizeTypeText(sourceContexts[ctxIndex].typeDefAliasTargetTypes[itemIndex])
            TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                       "ctx_alias_source",
                                                       sourcePath,
                                                       name,
                                                       "")
            TypedExprBuildIndexRegister(index, "ctx_alias_source", sourcePath, name, "", ctxIndex, sourcePath, target, true)
            TypedExprBuildIndexRegister(index, "ctx_alias_global", "", name, "", ctxIndex, sourcePath, target, false)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_alias_def", sourcePath, name, "",
                                                              ctxIndex, target)
        for itemIndex in 0..<sourceContexts[ctxIndex].enumValueNames.len:
            if itemIndex >= sourceContexts[ctxIndex].enumValueTypes.len ||
               itemIndex >= sourceContexts[ctxIndex].enumValueOrdinals.len:
                panic("typed expr: enum metadata columns mismatch")
            let name = sourceContexts[ctxIndex].enumValueNames[itemIndex]
            let typeName = TypedExprTypeLeafName(sourceContexts[ctxIndex].enumValueTypes[itemIndex])
            let ordinal = sourceContexts[ctxIndex].enumValueOrdinals[itemIndex]
            let enumPayload = Fmt"{typeName}:{ordinal}"
            TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                       "ctx_enum_name_source",
                                                       sourcePath,
                                                       name,
                                                       "")
            TypedExprBuildIndexRegister(index, "ctx_enum_name_source", sourcePath, name, "", ordinal, sourcePath, enumPayload, true)
            TypedExprBuildIndexRegister(index, "ctx_enum_name_global", "", name, "", ordinal, sourcePath, enumPayload, false)
            TypedExprBuildIndexRegister(index, "ctx_enum_name_type_source", sourcePath, name, "", ctxIndex, sourcePath, typeName, true)
            TypedExprBuildIndexRegister(index, "ctx_enum_name_type_global", "", name, "", ctxIndex, sourcePath, typeName, false)
            TypedExprBuildIndexRegister(index, "ctx_enum_type_source", sourcePath, typeName, "", ctxIndex, sourcePath, typeName, false)
            TypedExprBuildIndexRegister(index, "ctx_enum_type_global", "", typeName, "", ctxIndex, sourcePath, typeName, false)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_enum_name", sourcePath, name, "",
                                                              ctxIndex, enumPayload)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_enum_name_type", sourcePath, name, "",
                                                              ctxIndex, typeName)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_enum_type", sourcePath, typeName, "",
                                                              ctxIndex, typeName)
        for itemIndex in 0..<sourceContexts[ctxIndex].typeFields.len:
            let field = sourceContexts[ctxIndex].typeFields[itemIndex]
            let ownerType = TypedExprTypeLeafName(field.ownerType)
            let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(field.fieldName))
            let payload = TypedExprNormalizeTypeText(field.fieldType)
            TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                       "ctx_field_source",
                                                       sourcePath,
                                                       ownerType,
                                                       fieldName)
            let nodeIndex = TypedExprBuildIndexAddContextFieldNode(index, sourcePath, ownerType,
                                                                   ctxIndex, itemIndex,
                                                                   field.offsetBytes,
                                                                   field.sizeBytes,
                                                                   field.alignBytes)
            TypedExprBuildIndexRegister(index, "ctx_field_owner_source", sourcePath, ownerType, "", ctxIndex, sourcePath, ownerType, false)
            TypedExprBuildIndexRegister(index, "ctx_field_owner_global", "", ownerType, "", ctxIndex, sourcePath, ownerType, false)
            TypedExprBuildIndexRegister(index, "ctx_field_source", sourcePath, ownerType, fieldName, nodeIndex, sourcePath, payload, true)
            TypedExprBuildIndexRegister(index, "ctx_field_global", "", ownerType, fieldName, nodeIndex, sourcePath, payload, false)
            TypedExprBuildIndexIncrement(index, "ctx_field_count_source", share(sourcePath), share(ownerType))
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_field_owner", sourcePath, ownerType, "",
                                                              ctxIndex, ownerType)
            TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_composite", sourcePath, ownerType, "",
                                                              ctxIndex, ownerType)
@borrows
fn typedExprBuildIndexForContextsCore(
        sourceContexts: var TypedExprSourceContext[],
        minCap: int32): TypedExprBuildIndex =
    var index = TypedExprBuildIndexNew(minCap)
    typedExprBuildIndexRequireMutable(index,
                                      "context_set_call_declarations")
    # [D-B2b] exact reservation before the two registration passes.
    typedExprBuildIndexReserveCoreCapacity(index, sourceContexts)
    typedExprBuildIndexCorePass1(sourceContexts, index)
    typedExprBuildIndexCorePass2(sourceContexts, index)
    return index

# [S1b-0d] One context's worth of manual-authority call declarations.  The
# whole-forest driver runs this in a loop and seals once at the end; the
# streaming driver runs the very same body once per source and seals through
# the existing TypedExprBuildIndexSealCallDeclarations.  The body is the
# former loop body verbatim, so the append order (and therefore every
# recorded row and domain count) is unchanged.
@borrows
fn TypedExprBuildIndexAppendContextCallDeclarationsManual(
        index: var TypedExprBuildIndex,
        sourceContexts: var TypedExprSourceContext[],
        ctxIndex: int32,
        treeProducerSourceIndex: int32,
        manualTree: parser.ParserValueExprTree,
        producerFunctionBase: int32): bool =
    if ctxIndex < 0 || ctxIndex >= sourceContexts.len:
        return false
    let declarationStart = index.callDeclarationSourcePaths.len
    let parameterStart = index.callDeclarationParamTypes.len
    typedExprBuildIndexAddContextCallDeclarationsWithManualAuthority(
        index,
        sourceContexts[ctxIndex],
        ctxIndex,
        treeProducerSourceIndex,
        manualTree,
        producerFunctionBase)
    let domainBase = typedExprCheckedInt32Capacity(
        typedExprCheckedMul64(Int64(ctxIndex), 8,
                              "context_call_domain_slot"),
        "context_call_domain_slot")
    index.contextMetadataDomainCounts[
        typedExprCheckedAddInt32(domainBase, 6,
                                 "context_call_domain_slot")] =
        index.callDeclarationSourcePaths.len - declarationStart
    index.contextMetadataDomainCounts[
        typedExprCheckedAddInt32(domainBase, 7,
                                 "context_call_domain_slot")] =
        index.callDeclarationParamTypes.len - parameterStart
    return true

@borrows
fn typedExprBuildIndexFinishCallDeclarationsManualRec(
        index: var TypedExprBuildIndex,
        sourceContexts: var TypedExprSourceContext[],
        manualTree: parser.ParserValueExprTree,
        ctxIndex: int32): bool =
    while true:
        if ctxIndex >= sourceContexts.len:
            TypedExprBuildIndexSealCallDeclarations(index)
            return true
        # The whole forest numbers sources globally, so the tree's own source
        # numbering is the recorded one.
        if !TypedExprBuildIndexAppendContextCallDeclarationsManual(
               index, sourceContexts, ctxIndex, ctxIndex, manualTree, 0):
            return false
        ctxIndex = ctxIndex + 1
        continue

@borrows
fn typedExprBuildIndexFinishCallDeclarationsPlainRec(
        index: var TypedExprBuildIndex,
        sourceContexts: var TypedExprSourceContext[],
        ctxIndex: int32): bool =
    while true:
        if ctxIndex >= sourceContexts.len:
            TypedExprBuildIndexSealCallDeclarations(index)
            return true
        let declarationStart = index.callDeclarationSourcePaths.len
        let parameterStart = index.callDeclarationParamTypes.len
        TypedExprBuildIndexAddContextCallDeclarations(
            index,
            sourceContexts[ctxIndex],
            ctxIndex)
        let domainBase = typedExprCheckedInt32Capacity(
            typedExprCheckedMul64(Int64(ctxIndex), 8,
                                  "context_call_domain_slot"),
            "context_call_domain_slot")
        index.contextMetadataDomainCounts[
            typedExprCheckedAddInt32(domainBase, 6,
                                     "context_call_domain_slot")] =
            index.callDeclarationSourcePaths.len - declarationStart
        index.contextMetadataDomainCounts[
            typedExprCheckedAddInt32(domainBase, 7,
                                     "context_call_domain_slot")] =
            index.callDeclarationParamTypes.len - parameterStart
        ctxIndex = ctxIndex + 1
        continue

@borrows
fn typedExprBuildIndexForContextsWithManualAuthority(
        sourceContexts: var TypedExprSourceContext[],
        minCap: int32,
        manualTree: parser.ParserValueExprTree): TypedExprBuildIndex =
    var index = typedExprBuildIndexForContextsCore(sourceContexts, minCap)
    if !typedExprBuildIndexFinishCallDeclarationsManualRec(
           index, sourceContexts, manualTree, 0):
        panic("typed expr: build index call declaration finish failed")
    return index


# [S1b step-3 (6)] Per-source call-declaration append for the streaming driver.
# One source's tree is resident and numbers its own source 0, while the
# recorded producer source index and producer function row must be the forest
# coordinates the whole-forest loop recorded; hence ctxIndex and
# producerFunctionBase here and treeProducerSourceIndex 0 into the tree query.
# Every recorded row and every `contextMetadataDomainCounts` slot is written by
# the same body in the same per-context order, so the sealed index is the one
# the whole-forest loop produced.

var typedExprBuildIndexTraceInitialized: bool
var typedExprBuildIndexTraceEnabled: bool

# [E1f] Read-only column census for the streaming call-declaration append.
# The pass-1 loop appends one source at a time into this index; this census is
# what separates "the index grows per source" from "something else grows per
# source".  It reads len only -- never add/setLen/rewrite a column.  Same
# one-time latch idiom as the other traces here; switch off => prints nothing.
# live is deliberately not read here (this file does not import std/system);
# the caller loop already prints it per source on forest_appended.
@borrows
fn TypedExprBuildIndexColumnLensTrace(index: TypedExprBuildIndex,
                                      stage: str,
                                      sourceIndex: int32,
                                      sourceBytes: int32) =
    if index == nil:
        return
    if !typedExprBuildIndexTraceInitialized:
        typedExprBuildIndexTraceInitialized = true
        typedExprBuildIndexTraceEnabled = os.GetEnv("CHENG_BUILDINDEX_TRACE") == "1"
    if typedExprBuildIndexTraceEnabled:
        os.WriteLine(os.Get_stderr(),
                     Fmt"buildindex_trace stage={stage} src_index={sourceIndex} source_bytes={sourceBytes} rss={os.ProcessRssBytes()}")
        os.WriteLine(os.Get_stderr(),
                     Fmt"buildindex_ids stage={stage} src_index={sourceIndex} entry_kind_ids={index.entryKindIds.len} entry_source_path_ids={index.entrySourcePathIds.len} entry_name_ids={index.entryNameIds.len} entry_detail_ids={index.entryDetailIds.len} entry_origin_ids={index.entryOriginIds.len} entry_fingerprint_ids={index.entryFingerprintIds.len} visibility_kind_ids={index.visibilityKindIds.len} visibility_source_path_ids={index.visibilitySourcePathIds.len} visibility_name_ids={index.visibilityNameIds.len} visibility_detail_ids={index.visibilityDetailIds.len} visibility_fingerprint_ids={index.visibilityFingerprintIds.len} import_owner_source_path_ids={index.importOwnerSourcePathIds.len} content_cache_kind_ids={index.contentCacheKindIds.len} content_cache_source_path_ids={index.contentCacheSourcePathIds.len} content_cache_name_ids={index.contentCacheNameIds.len} content_cache_value_ids={index.contentCacheValueIds.len} call_declaration_source_path_ids={index.callDeclarationSourcePathIds.len} call_declaration_name_ids={index.callDeclarationNameIds.len} call_declaration_generic_name_ids={index.callDeclarationGenericNameIds.len} call_declaration_param_type_ids={index.callDeclarationParamTypeIds.len} call_declaration_return_type_ids={index.callDeclarationReturnTypeIds.len} call_declaration_target_symbol_ids={index.callDeclarationTargetSymbolIds.len} context_source_path_ids={index.contextSourcePathIds.len} context_field_owner_source_path_ids={index.contextFieldOwnerSourcePathIds.len} context_field_owner_type_ids={index.contextFieldOwnerTypeIds.len} field_owner_source_path_ids={index.fieldOwnerSourcePathIds.len} field_owner_type_ids={index.fieldOwnerTypeIds.len} layout_source_path_ids={index.layoutSourcePathIds.len} layout_type_name_ids={index.layoutTypeNameIds.len}")
        os.WriteLine(os.Get_stderr(),
                     Fmt"buildindex_strs stage={stage} src_index={sourceIndex} entry_kinds={index.entryKinds.len} entry_source_paths={index.entrySourcePaths.len} entry_names={index.entryNames.len} entry_details={index.entryDetails.len} entry_origins={index.entryOrigins.len} entry_fingerprints={index.entryFingerprints.len} visibility_kinds={index.visibilityKinds.len} visibility_source_paths={index.visibilitySourcePaths.len} visibility_names={index.visibilityNames.len} visibility_details={index.visibilityDetails.len} visibility_fingerprints={index.visibilityFingerprints.len} import_owner_source_paths={index.importOwnerSourcePaths.len} visibility_query_owner_source_paths={index.visibilityQueryOwnerSourcePaths.len} visibility_query_kinds={index.visibilityQueryKinds.len} visibility_query_names={index.visibilityQueryNames.len} visibility_query_details={index.visibilityQueryDetails.len} visibility_query_fingerprints={index.visibilityQueryFingerprints.len} content_cache_kinds={index.contentCacheKinds.len} content_cache_source_paths={index.contentCacheSourcePaths.len} content_cache_names={index.contentCacheNames.len} content_cache_values={index.contentCacheValues.len} call_declaration_source_paths={index.callDeclarationSourcePaths.len} call_declaration_names={index.callDeclarationNames.len} call_declaration_generic_names={index.callDeclarationGenericNames.len} call_declaration_param_types={index.callDeclarationParamTypes.len} call_declaration_return_types={index.callDeclarationReturnTypes.len} call_declaration_target_symbols={index.callDeclarationTargetSymbols.len} context_source_paths={index.contextSourcePaths.len} context_field_owner_source_paths={index.contextFieldOwnerSourcePaths.len} context_field_owner_types={index.contextFieldOwnerTypes.len} field_owner_source_paths={index.fieldOwnerSourcePaths.len} field_owner_types={index.fieldOwnerTypes.len} layout_source_paths={index.layoutSourcePaths.len} layout_type_names={index.layoutTypeNames.len}")


# [B9] One context's worth of enum metadata rows, verbatim from the Core
# registration loop (same keys, payloads, visibility declarations).  The
# streaming exact-context index is built over an empty context set and only
# appends call declarations per source, so without this companion the
# streaming index never carries the enum domain and every static-typing
# enum query misses in that phase (192 family: cleanup_cfg:4486
# `odir.OwnershipDropEdgeReturn`).  Streaming wrapper only: the
# whole-forest driver registers these rows through the Core over all
# contexts and must not append twice (RequireFresh panics on duplicates).
fn TypedExprBuildIndexAppendContextEnumMetadataRows(
        index: var TypedExprBuildIndex,
        enumCtx: var TypedExprSourceContext,
        ctxIndex: int32): bool =
    if index == nil || index.released:
        return false
    var sourcePath = enumCtx.normalizedSourcePath
    if sourcePath == "":
        sourcePath = parser.ParserNormalizePath(enumCtx.sourcePath)
    if sourcePath == "":
        return false
    for itemIndex in 0..<enumCtx.enumValueNames.len:
        if itemIndex >= enumCtx.enumValueTypes.len ||
           itemIndex >= enumCtx.enumValueOrdinals.len:
            panic("typed expr: enum metadata columns mismatch")
        let name = enumCtx.enumValueNames[itemIndex]
        let typeName = TypedExprTypeLeafName(enumCtx.enumValueTypes[itemIndex])
        let ordinal = enumCtx.enumValueOrdinals[itemIndex]
        let enumPayload = Fmt"{typeName}:{ordinal}"
        # 幂等守卫：同一源可能经历多轮 typed-expr 消费、多次走本 append；
        # call-declaration 域自身有定位去重，metadata 域的 RequireFresh 合同
        # 则假定一次性登记，故这里对已登记成员直接跳过（同批 8 行原子）。
        if TypedExprBuildIndexFindEntry(index,
                                        "ctx_enum_name_source",
                                        sourcePath,
                                        name,
                                        "",
                                        false) >= 0:
            continue
        TypedExprBuildIndexRequireFreshMetadataKey(index,
                                                   "ctx_enum_name_source",
                                                   sourcePath,
                                                   name,
                                                   "")
        TypedExprBuildIndexRegister(index, "ctx_enum_name_source", sourcePath, name, "", ordinal, sourcePath, enumPayload, true)
        TypedExprBuildIndexRegister(index, "ctx_enum_name_global", "", name, "", ordinal, sourcePath, enumPayload, false)
        TypedExprBuildIndexRegister(index, "ctx_enum_name_type_source", sourcePath, name, "", ctxIndex, sourcePath, typeName, true)
        TypedExprBuildIndexRegister(index, "ctx_enum_name_type_global", "", name, "", ctxIndex, sourcePath, typeName, false)
        TypedExprBuildIndexRegister(index, "ctx_enum_type_source", sourcePath, typeName, "", ctxIndex, sourcePath, typeName, false)
        TypedExprBuildIndexRegister(index, "ctx_enum_type_global", "", typeName, "", ctxIndex, sourcePath, typeName, false)
        TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_enum_name", sourcePath, name, "",
                                                          ctxIndex, enumPayload)
        TypedExprBuildIndexRegisterVisibilityDeclaration(index, "ctx_import_enum_name_type", sourcePath, name, "",
                                                          ctxIndex, typeName)
    return true

@borrows
fn TypedExprBuildIndexAppendSourceCallDeclarationsManual(
        index: var TypedExprBuildIndex,
        sourceContexts: var TypedExprSourceContext[],
        ctxIndex: int32,
        manualTree: parser.ParserValueExprTree,
        producerFunctionBase: int32): bool =
    if ctxIndex < 0 || ctxIndex >= sourceContexts.len:
        return false
    if !TypedExprBuildIndexAppendContextEnumMetadataRows(
           index, sourceContexts[ctxIndex], ctxIndex):
        return false
    return TypedExprBuildIndexAppendContextCallDeclarationsManual(
        index, sourceContexts, ctxIndex, 0, manualTree, producerFunctionBase)

# [S1b step-3 (6)] Streaming exact-context index: source identity, the sealed
# lookup and the index core are built once (everything
# `typedExprBuildSourceContextExactIndexWithManualAuthority` did except the
# call-declaration finish), each source appends its own call declarations in
# the streaming loop, and `TypedExprBuildIndexSealCallDeclarations` seals once.

# [S1b step-3 (6)] Single decision point for which index core to build.  The
# sealed variant runs the whole-forest call-declaration finish; the streaming
# variant stops after the core so the driver can append one source at a time.
@borrows
fn typedExprBuildIndexForContextsManualAuthority(
        sourceContexts: var TypedExprSourceContext[],
        minCap: int32,
        manualTree: parser.ParserValueExprTree,
        sealCallDeclarations: bool): TypedExprBuildIndex =
    if sealCallDeclarations:
        return typedExprBuildIndexForContextsWithManualAuthority(
            sourceContexts, minCap, manualTree)
    return typedExprBuildIndexForContextsCore(sourceContexts, minCap)

fn typedExprBuildIndexForContextsPlain(
        sourceContexts: var TypedExprSourceContext[],
        minCap: int32): TypedExprBuildIndex =
    var index = typedExprBuildIndexForContextsCore(sourceContexts, minCap)
    if !typedExprBuildIndexFinishCallDeclarationsPlainRec(
           index, sourceContexts, 0):
        panic("typed expr: build index call declaration finish failed")
    return index

fn TypedExprBuildIndexForContexts(sourceContexts: var TypedExprSourceContext[],
                                    minCap: int32): TypedExprBuildIndex =
    return typedExprBuildIndexForContextsPlain(sourceContexts, minCap)

@borrows
fn typedExprManualConsumeParameterTypeId(
        arena: arenamod.Arena,
        parameterOrdinalsByDeclarationRow: arenamod.ArenaArrayInt32,
        exactTypeArena: typearena.TypedExprTypeArena,
        valueExprTree: parser.ParserValueExprTree,
        valueDefinitionTypeArenaBound: bool,
        valueExprTreeBorrowLease: bool,
        producerSourceIndex: int32,
        producerFunctionRow: int32,
        parameterOrdinal: int32,
        declarationSourceLocalRow: int32): int32 =
    if exactTypeArena == nil ||
       !valueDefinitionTypeArenaBound ||
       !valueExprTreeBorrowLease ||
       valueExprTree == nil ||
       producerSourceIndex < 0 ||
       producerFunctionRow < 0 ||
       parameterOrdinal < 0 ||
       declarationSourceLocalRow < 0:
        return -1
    var matchedTypeId: int32 = -1
    for declarationRow in 0..<valueExprTree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               valueExprTree.arena,
               valueExprTree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationParameter) ||
           arenamod.ArenaArrayInt32Get(
               valueExprTree.arena,
               valueExprTree.declarationProducerSourceIndexes,
               declarationRow) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               valueExprTree.arena,
               valueExprTree.declarationFunctionRows,
               declarationRow) != producerFunctionRow ||
           arenamod.ArenaArrayInt32Get(
               valueExprTree.arena,
               valueExprTree.declarationSourceLocalRows,
               declarationRow) != declarationSourceLocalRow:
            continue
        if declarationRow < 0 ||
           declarationRow >=
               parameterOrdinalsByDeclarationRow.len ||
           arenamod.ArenaArrayInt32Get(
               arena,
               parameterOrdinalsByDeclarationRow,
               declarationRow) != parameterOrdinal:
            return -1
        let typeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            valueExprTree.arena,
            valueExprTree.declarationTypeSyntaxRootIndexes,
            declarationRow)
        if typeSyntaxRoot < 0:
            return -1
        let typeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
            exactTypeArena, typeSyntaxRoot)
        if matchedTypeId >= 0:
            return -1
        matchedTypeId = typeId
    return matchedTypeId

@borrows
fn typedExprManualConsumeFunctionRowExact(
        valueExprTree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        declarationSourceLocalRow: int32): int32 =
    return typedExprManualConsumeTreeFunctionRowExact(
        valueExprTree,
        producerSourceIndex,
        declarationSourceLocalRow)

@borrows
fn typedExprBindBuildIndexManualConsumeEffects(
        index: var TypedExprBuildIndex,
        exactTypeArena: typearena.TypedExprTypeArena,
        valueExprTree: parser.ParserValueExprTree,
        valueExprTreeBorrowLease: bool,
        valueDefinitionTypeArenaBound: bool,
        valueDefinitionTypeArenaArtifactCid: layout.FixedBytes32,
        arena: arenamod.Arena,
        parameterOrdinalsByDeclarationRow: arenamod.ArenaArrayInt32) =
    if index == nil || index.released ||
       !index.callDeclarationSealed:
        panic("typed expr: manual-consume build-index bind state invalid")
    if index.callDeclarationManualConsumeTypeArenaBound:
        return
    if exactTypeArena == nil ||
       !valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           valueDefinitionTypeArenaArtifactCid,
           exactTypeArena.artifactRaw32) ||
       !valueExprTreeBorrowLease ||
       valueExprTree == nil:
        if valueDefinitionTypeArenaBound:
            for row in 0..<index.callDeclarationManualConsumePresents.len:
                if index.callDeclarationManualConsumePresents[row]:
                    panic("typed expr: manual-consume exact TypeArena bind incomplete")
        return
    let rowCount = index.callDeclarationSourcePaths.len
    if rowCount != index.callDeclarationManualConsumePresents.len ||
       rowCount !=
           index.callDeclarationManualConsumeFunctionDeclarationRows.len ||
       rowCount !=
           index.callDeclarationManualConsumeTargetParameterOrdinals.len ||
       rowCount !=
           index.callDeclarationManualConsumeSourceParameterOrdinals.len ||
       rowCount !=
           index.callDeclarationManualConsumeTargetParameterDeclarationRows.len ||
       rowCount !=
           index.callDeclarationManualConsumeSourceParameterDeclarationRows.len ||
       rowCount != index.callDeclarationManualConsumeTargetTypeIds.len ||
       rowCount != index.callDeclarationManualConsumeSourceTypeIds.len ||
       rowCount != index.callDeclarationManualConsumeEffectCids.len:
        panic("typed expr: manual-consume build-index columns incomplete")
    for row in 0..<rowCount:
        if !index.callDeclarationManualConsumePresents[row]:
            if !typedExprManualConsumeEffectAbsent(
                   false,
                   index.callDeclarationManualConsumeFunctionDeclarationRows[
                       row],
                   index.callDeclarationManualConsumeTargetParameterOrdinals[row],
                   index.callDeclarationManualConsumeSourceParameterOrdinals[row],
                   index.callDeclarationManualConsumeTargetParameterDeclarationRows[row],
                   index.callDeclarationManualConsumeSourceParameterDeclarationRows[row],
                   index.callDeclarationManualConsumeTargetTypeIds[row],
                   index.callDeclarationManualConsumeSourceTypeIds[row],
                   index.callDeclarationManualConsumeEffectCids[row]):
                panic("typed expr: absent manual-consume call effect non-empty")
            continue
        if index.callDeclarationKinds[row] !=
               TypedExprCallDeclarationFunction:
            panic("typed expr: manual-consume effect declaration kind invalid")
        let producerSourceIndex =
            index.callDeclarationProducerSourceIndexes[row]
        let producerDeclarationOrdinal =
            index.callDeclarationProducerDeclarationOrdinals[row]
        let producerFunctionRow =
            index.callDeclarationProducerFunctionRows[row]
        let targetOrdinal =
            index.callDeclarationManualConsumeTargetParameterOrdinals[row]
        let sourceOrdinal =
            index.callDeclarationManualConsumeSourceParameterOrdinals[row]
        let targetDeclarationRow =
            index.callDeclarationManualConsumeTargetParameterDeclarationRows[
                row]
        let sourceDeclarationRow =
            index.callDeclarationManualConsumeSourceParameterDeclarationRows[
                row]
        let functionDeclarationRow =
            index.callDeclarationManualConsumeFunctionDeclarationRows[
                row]
        let exactProducerFunctionRow =
            typedExprManualConsumeFunctionRowExact(
                valueExprTree,
                producerSourceIndex,
                functionDeclarationRow)
        if exactProducerFunctionRow < 0:
            panic("typed expr: manual-consume function declaration identity drift")
        if producerFunctionRow != exactProducerFunctionRow:
            panic("typed expr: sealed manual-consume producer function row drift")
        let targetTypeId = typedExprManualConsumeParameterTypeId(
            arena,
            parameterOrdinalsByDeclarationRow,
            exactTypeArena,
            valueExprTree,
            valueDefinitionTypeArenaBound,
            valueExprTreeBorrowLease,
            producerSourceIndex,
            producerFunctionRow,
            targetOrdinal,
            targetDeclarationRow)
        let sourceTypeId = typedExprManualConsumeParameterTypeId(
            arena,
            parameterOrdinalsByDeclarationRow,
            exactTypeArena,
            valueExprTree,
            valueDefinitionTypeArenaBound,
            valueExprTreeBorrowLease,
            producerSourceIndex,
            producerFunctionRow,
            sourceOrdinal,
            sourceDeclarationRow)
        if targetTypeId < 0 || sourceTypeId < 0 ||
           !typedExprManualConsumeTypeIdsExact(
               exactTypeArena, targetTypeId, sourceTypeId):
            panic("typed expr: manual-consume structural TypeId contract invalid")
        index.callDeclarationManualConsumeTargetTypeIds[row] =
            targetTypeId
        index.callDeclarationManualConsumeSourceTypeIds[row] =
            sourceTypeId
        index.callDeclarationManualConsumeEffectCids[row] =
            typedExprManualConsumeEffectCid(
                valueDefinitionTypeArenaArtifactCid,
                producerSourceIndex,
                producerDeclarationOrdinal,
                producerFunctionRow,
                functionDeclarationRow,
                targetOrdinal,
                sourceOrdinal,
                targetDeclarationRow,
                sourceDeclarationRow,
                targetTypeId,
                sourceTypeId)
    index.callDeclarationManualConsumeTypeArenaBound = true

@borrows
@borrow_result
fn TypedExprContextsBuildIndex(sourceContexts: TypedExprSourceContext[]): TypedExprBuildIndex =
    if sourceContexts.len <= 0:
        return nil
    return sourceContexts[0].buildIndex

fn TypedExprTypeFieldContextIndexLookup(sourceContexts: var TypedExprSourceContext[],
                                         ownerType: str): int32 =
    var ctxIndex: int32
    let state = TypedExprBuildIndexLookup(TypedExprContextsBuildIndex(sourceContexts),
                                          "ctx_field_owner_global", "", TypedExprTypeLeafName(ownerType), "", ctxIndex)
    if state != TypedExprBuildIndexUnique:
        return -1
    return typedExprContextArrayIndexForBuildIndex(sourceContexts, ctxIndex)

fn TypedExprDeclaredTypeContextIndexLookup(sourceContexts: var TypedExprSourceContext[],
                                            typeName: str): int32 =
    var ctxIndex: int32
    let state = TypedExprBuildIndexLookup(TypedExprContextsBuildIndex(sourceContexts),
                                          "ctx_declared_global", "", TypedExprTypeLeafName(typeName), "", ctxIndex)
    if state != TypedExprBuildIndexUnique:
        return -1
    return typedExprContextArrayIndexForBuildIndex(sourceContexts, ctxIndex)

fn TypedExprBuildSourceContextIndex(ir: var TypedExprIr,
                                      sourceContexts: var TypedExprSourceContext[]) =
    let activeSession = ir.typedExprMetadataSession
    if activeSession != nil && !activeSession.fullValidationActive:
        panic("typed expr: full metadata validation forbidden while frozen session is active")
    if ir.buildIndex != nil:
        if ir.buildIndex.released:
            panic("typed expr: IR holds released build index")
        if ir.buildIndexGeneration <= 0 ||
           ir.buildIndex.buildGeneration != ir.buildIndexGeneration:
            panic("typed expr: build index generation drift")
        if ir.buildIndex.contentCacheReleased:
            panic("typed expr: TypedIR build index reused after backend handoff")
        if !ir.buildIndex.callDeclarationSealed:
            panic("typed expr: TypedIR call declaration index is not sealed")
        if !ir.buildIndex.callDeclarationManualConsumeTypeArenaBound:
            typedExprBindBuildIndexManualConsumeEffects(
                ir.buildIndex,
                ir.exactTypeArena,
                ir.valueExprTree,
                ir.valueExprTreeBorrowLease,
                ir.valueDefinitionTypeArenaBound,
                ir.valueDefinitionTypeArenaArtifactCid,
                ir.arena,
                ir.valueExprTransactionParameterOrdinalsByDeclarationRow)
        if ir.buildIndex.contextCount != sourceContexts.len ||
           ir.buildIndex.contextSourcePaths.len != sourceContexts.len ||
           ir.buildIndex.contextMetadataDomainCounts.len !=
               typedExprContextDomainColumnCount(sourceContexts.len) ||
           ir.buildIndex.entryValidationMarks.len != ir.buildIndex.entryKinds.len:
            panic("typed expr: build-once context set changed without explicit reset")
        if ir.buildIndex.validationEpoch < 0 ||
           ir.buildIndex.validationEpoch > 2147483647 - sourceContexts.len:
            for entryIndex in 0..<ir.buildIndex.entryValidationMarks.len:
                ir.buildIndex.entryValidationMarks[entryIndex] = 0
            ir.buildIndex.validationEpoch = 0
        # Epoch/marks are fail-stop telemetry. A freshness panic terminates this
        # build and may leave partial marks; an O(metadata) rollback copy would
        # add peak RSS without making the failed index reusable.
        for contextIndex in 0..<sourceContexts.len:
            if sourceContexts[contextIndex].buildIndex != ir.buildIndex ||
               sourceContexts[contextIndex].buildIndexOwned:
                panic(Fmt"typed expr: build-once context owner changed index={contextIndex}; explicit reset required")
            if TypedExprSourceContextHasLocalBuildCaches(sourceContexts[contextIndex]):
                panic(Fmt"typed expr: context cache changed after build index seal index={contextIndex}; explicit reset required")
            var sourcePath = sourceContexts[contextIndex].normalizedSourcePath
            if sourcePath == "":
                sourcePath = parser.ParserNormalizePath(sourceContexts[contextIndex].sourcePath)
            if sourcePath != ir.buildIndex.contextSourcePaths[contextIndex]:
                panic(Fmt"typed expr: build-once source identity changed index={contextIndex} expected={ir.buildIndex.contextSourcePaths[contextIndex]} actual={sourcePath}")
            ir.buildIndex.validationEpoch = ir.buildIndex.validationEpoch + 1
            TypedExprBuildIndexValidateContextMetadata(ir.buildIndex,
                                                       sourceContexts[contextIndex],
                                                       contextIndex,
                                                       sourcePath,
                                                       ir.buildIndex.validationEpoch)
        ir.buildIndex.reuseCount = ir.buildIndex.reuseCount + 1
        if ir.sourceContextIndexSourcePaths.len != ir.buildIndex.contextSourcePaths.len ||
           ir.sourceContextIndexBucketHeads.len != 0 ||
           ir.sourceContextIndexEntryNext.len != 0 ||
           ir.sourceContextIndexEntryIndexes.len != 0:
            panic("typed expr: build-once compatibility telemetry drift")
        return
    for contextIndex in 0..<sourceContexts.len:
        TypedExprSourceContextReleaseBuildIndex(sourceContexts[contextIndex])
    if ir.buildIndexGeneration < 0 || ir.buildIndexGeneration >= 2147483647:
        panic("typed expr: build index generation exhausted")
    let nextBuildGeneration = ir.buildIndexGeneration + 1
    var buildCapacity = typedExprCheckedAdd64(
        Int64(sourceContexts.len), Int64(ir.typeFieldOwnerTypes.len),
        "source_context_index_capacity")
    buildCapacity = typedExprCheckedAdd64(
        buildCapacity, Int64(ir.typeLayoutNames.len),
        "source_context_index_capacity")
    buildCapacity = typedExprCheckedAdd64(buildCapacity, 32,
                                          "source_context_index_capacity")
    var nextBuildIndex = typedExprBuildIndexForContextsWithManualAuthority(
        sourceContexts,
        typedExprCheckedInt32Capacity(buildCapacity,
                                      "source_context_index_capacity"),
        ir.valueExprTree)
    typedExprBindBuildIndexManualConsumeEffects(
        nextBuildIndex,
        ir.exactTypeArena,
        ir.valueExprTree,
        ir.valueExprTreeBorrowLease,
        ir.valueDefinitionTypeArenaBound,
        ir.valueDefinitionTypeArenaArtifactCid,
        ir.arena,
        ir.valueExprTransactionParameterOrdinalsByDeclarationRow)
    nextBuildIndex.buildGeneration = nextBuildGeneration
    ir.buildIndex = nextBuildIndex
    ir.buildIndexGeneration = nextBuildGeneration
    ir.sourceContextIndexSourcePaths = []
    ir.sourceContextIndexBucketHeads = []
    ir.sourceContextIndexEntryNext = []
    ir.sourceContextIndexEntryIndexes = []
    for sourceIndex in 0..<ir.buildIndex.contextSourcePaths.len:
        add(ir.sourceContextIndexSourcePaths,
            share(ir.buildIndex.contextSourcePaths[sourceIndex]))
    TypedExprBuildIndexSeedIrMetadata(ir)

@borrows
fn typedExprSourceContextMetadataRowCount(ctx: var TypedExprSourceContext): int32 =
    var count: int64 = 1
    count = typedExprCheckedAdd64(count, Int64(ctx.scopes.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.signatureScopes.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.importcFunctions.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.importedModules.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.declaredTypes.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.refTypes.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.typeDefAliasNames.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.typeFields.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.enumValueNames.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count, Int64(ctx.moduleConstNames.len),
                                  "metadata_row_count")
    count = typedExprCheckedAdd64(count,
                                  Int64(ctx.sourceLineByteStarts.len),
                                  "metadata_row_count")
    for bindingIndex in 0..<ctx.bindings.len:
        if ctx.bindings[bindingIndex].globalFlag:
            count = typedExprCheckedAdd64(count, Int64(1),
                                          "metadata_row_count")
    return typedExprCheckedInt32Capacity(count, "metadata_row_count")

fn typedExprSourceContextsMetadataRowCountRec(
        contexts: var TypedExprSourceContext[],
        contextIndex: int32,
        count: int64): int64 =
    while true:
        if contextIndex >= contexts.len:
            return count
        let rowCount = typedExprSourceContextMetadataRowCount(contexts[contextIndex])
        count = typedExprCheckedAdd64(count, Int64(rowCount), "source_contexts_metadata_row_count")
        contextIndex = contextIndex + 1
        continue

fn TypedExprSourceContextsMetadataRowCount(
        contexts: var TypedExprSourceContext[]): int32 =
    return typedExprCheckedInt32Capacity(
        typedExprSourceContextsMetadataRowCountRec(contexts, 0, 0),
        "source_contexts_metadata_row_count")

fn typedExprSequenceBufferUnique(items: var T[]): bool =
    # Descriptor identity read stays in provider-tier std/seqs so no pointer
    # surface crosses into this kernel module.
    let buffer = seqs.bufferIdentity(items)
    return buffer == nil || memRefCount(buffer) == 1

fn typedExprSharedMetadataColumnInto(
        items: var T[],
        stableColumnId: int32,
        stableColumnName: str,
        columnId: var int32,
        columnName: var str,
        refCount: var int32): bool =
    let buffer = seqs.bufferIdentity(items)
    if buffer == nil:
        return false
    let observedRefCount = memRefCount(buffer)
    if observedRefCount == 1:
        return false
    columnId = stableColumnId
    columnName = stableColumnName
    refCount = observedRefCount
    return true

fn typedExprSourceContextFirstSharedMetadataBufferInto(
        ctx: var TypedExprSourceContext,
        columnId: var int32,
        columnName: var str,
        refCount: var int32): bool =
    columnId = 0
    columnName = ""
    refCount = 0
    if typedExprSharedMetadataColumnInto(
           ctx.lineNumbers, 43, "lineNumbers",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.lines, 1, "lines", columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.sourceLineByteStarts, 2, "sourceLineByteStarts",
           columnId, columnName, refCount):
