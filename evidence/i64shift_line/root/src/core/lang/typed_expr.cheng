        TypedExprIrCloneArenaArrayInt32(
            ir.arena,
            ir.valueDefinitionGroups_consumedFlags,
            out.arena)
    if Int64(out.arena.usedBytes) != logicalBytes:
        panic("typed expr: reachable arena clone retained non-live bytes")

fn typedExprIrCloneImpl(ir: var TypedExprIr,
                        allowFrozenBorrow: bool): TypedExprIr =
    if ir.valueExprTree != nil || ir.valueExprTreeBorrowLease:
        panic("typed expr: clone during parser value-tree transaction forbidden")
    if ir.exactTypeArena != nil:
        panic("typed expr: clone during exact TypeArena producer borrow forbidden")
    if ir.typedExprMetadataSession != nil && !allowFrozenBorrow:
        panic("typed expr: active frozen metadata IR clone forbidden")
    var out: TypedExprIr
    # Transaction scratch is intentionally not cloned. Its exact idle
    # producer sentinel is -1, not the aggregate zero value.
    out.valueExprTransactionParserProducerSourceIndex = -1
    out.valueExprTransactionProducerSourceIndex = -1
    out.valueExprCurrentParserFunctionRow = -1
    out.buildIndex = TypedExprBuildIndexClone(ir.buildIndex)
    out.buildIndexGeneration = ir.buildIndexGeneration
    out.typedExprGlobalMetadataReady = ir.typedExprGlobalMetadataReady
    out.valueDefinitionTypeArenaArtifactCid =
        ir.valueDefinitionTypeArenaArtifactCid
    out.valueDefinitionTypeArenaBound =
        ir.valueDefinitionTypeArenaBound
    # An active frozen session has unique ownership of metadata contexts and is
    # intentionally never cloned. A cloned derived index may borrow immutable
    # intern ids while the source frozen session remains live; no canonical
    # mutation surface is copied.
    # InternPool and Arena own explicitly released storage. Rebuild the Arena
    # from live descriptors so dead capacity and superseded buffers do not cross
    # the ownership boundary.
    if ir.internPool != nil:
        out.internPool = langintern.InternPoolClone(ir.internPool)
    else:
        out.internPool = langintern.InternPoolNew()
    TypedExprIrCloneReachableArenaColumns(ir, out)
    TypedExprIrCloneOrdinarySoAColumns(out, ir)
    for i in 0..<ir.coldCsgTypeRows.len:
        add(out.coldCsgTypeRows, TypedExprColdCsgTypeRowClone(ir.coldCsgTypeRows[i]))
    for i in 0..<ir.coldCsgStatementRows.len:
        add(out.coldCsgStatementRows, TypedExprColdCsgStatementRowClone(ir.coldCsgStatementRows[i]))
    for i in 0..<ir.globalSourcePaths.len:
        add(out.globalSourcePaths, share(ir.globalSourcePaths[i]))
    for i in 0..<ir.globalNames.len:
        add(out.globalNames, share(ir.globalNames[i]))
    for i in 0..<ir.globalTypes.len:
        add(out.globalTypes, share(ir.globalTypes[i]))
    for i in 0..<ir.globalProducerSourceIndexes.len:
        add(out.globalProducerSourceIndexes,
            ir.globalProducerSourceIndexes[i])
    for i in 0..<ir.globalDeclarationSourceLocalRows.len:
        add(out.globalDeclarationSourceLocalRows,
            ir.globalDeclarationSourceLocalRows[i])
    for i in 0..<ir.globalInitValues.len:
        add(out.globalInitValues, share(ir.globalInitValues[i]))
    for i in 0..<ir.localBindingSourcePaths.len:
        add(out.localBindingSourcePaths, share(ir.localBindingSourcePaths[i]))
    for i in 0..<ir.localBindingFunctionNames.len:
        add(out.localBindingFunctionNames, share(ir.localBindingFunctionNames[i]))
    for i in 0..<ir.localBindingLineNumbers.len:
        add(out.localBindingLineNumbers, ir.localBindingLineNumbers[i])
    for i in 0..<ir.localBindingNames.len:
        add(out.localBindingNames, share(ir.localBindingNames[i]))
    for i in 0..<ir.localBindingTypes.len:
        add(out.localBindingTypes, share(ir.localBindingTypes[i]))
    for i in 0..<ir.localBindingNameIndexBucketHeads.len:
        add(out.localBindingNameIndexBucketHeads, ir.localBindingNameIndexBucketHeads[i])
    for i in 0..<ir.localBindingNameIndexEntryNext.len:
        add(out.localBindingNameIndexEntryNext, ir.localBindingNameIndexEntryNext[i])
    for i in 0..<ir.localBindingNameIndexEntryBindingIndexes.len:
        add(out.localBindingNameIndexEntryBindingIndexes, ir.localBindingNameIndexEntryBindingIndexes[i])
    for i in 0..<ir.localBindingNameIndexEntryNames.len:
        add(out.localBindingNameIndexEntryNames, share(ir.localBindingNameIndexEntryNames[i]))
    out.localBindingNameIndexSealed = ir.localBindingNameIndexSealed
    for i in 0..<ir.importcSourcePaths.len:
        add(out.importcSourcePaths, share(ir.importcSourcePaths[i]))
    for i in 0..<ir.importcNames.len:
        add(out.importcNames, share(ir.importcNames[i]))
    for i in 0..<ir.importcReturnTypes.len:
        add(out.importcReturnTypes, share(ir.importcReturnTypes[i]))
    for i in 0..<ir.importcTargetSymbols.len:
        add(out.importcTargetSymbols, share(ir.importcTargetSymbols[i]))
    for i in 0..<ir.importcParamTypeJoins.len:
        add(out.importcParamTypeJoins, share(ir.importcParamTypeJoins[i]))
    for i in 0..<ir.typeLayoutSourcePaths.len:
        add(out.typeLayoutSourcePaths, share(ir.typeLayoutSourcePaths[i]))
    for i in 0..<ir.typeLayoutNames.len:
        add(out.typeLayoutNames, share(ir.typeLayoutNames[i]))
    for i in 0..<ir.typeLayoutSizeBytes.len:
        add(out.typeLayoutSizeBytes, ir.typeLayoutSizeBytes[i])
    for i in 0..<ir.typeLayoutAlignBytes.len:
        add(out.typeLayoutAlignBytes, ir.typeLayoutAlignBytes[i])
    for i in 0..<ir.typeLayoutFieldCounts.len:
        add(out.typeLayoutFieldCounts, ir.typeLayoutFieldCounts[i])
    for i in 0..<ir.typeLayoutProducerSourceIndexes.len:
        add(out.typeLayoutProducerSourceIndexes,
            ir.typeLayoutProducerSourceIndexes[i])
    for i in 0..<ir.typeLayoutDeclarationSourceLocalRows.len:
        add(out.typeLayoutDeclarationSourceLocalRows,
            ir.typeLayoutDeclarationSourceLocalRows[i])
    for i in 0..<ir.typeLayoutBuiltinKinds.len:
        add(out.typeLayoutBuiltinKinds, ir.typeLayoutBuiltinKinds[i])
    for i in 0..<ir.typeFieldSourcePaths.len:
        add(out.typeFieldSourcePaths, share(ir.typeFieldSourcePaths[i]))
    for i in 0..<ir.typeFieldOwnerTypes.len:
        add(out.typeFieldOwnerTypes, share(ir.typeFieldOwnerTypes[i]))
    for i in 0..<ir.typeFieldNames.len:
        add(out.typeFieldNames, share(ir.typeFieldNames[i]))
    for i in 0..<ir.typeFieldTypes.len:
        add(out.typeFieldTypes, share(ir.typeFieldTypes[i]))
    for i in 0..<ir.typeFieldOffsetBytes.len:
        add(out.typeFieldOffsetBytes, ir.typeFieldOffsetBytes[i])
    for i in 0..<ir.typeFieldSizeBytes.len:
        add(out.typeFieldSizeBytes, ir.typeFieldSizeBytes[i])
    for i in 0..<ir.typeFieldAlignBytes.len:
        add(out.typeFieldAlignBytes, ir.typeFieldAlignBytes[i])
    for i in 0..<ir.typeFieldProducerSourceIndexes.len:
        add(out.typeFieldProducerSourceIndexes,
            ir.typeFieldProducerSourceIndexes[i])
    for i in 0..<ir.typeFieldOwnerDeclarationSourceLocalRows.len:
        add(out.typeFieldOwnerDeclarationSourceLocalRows,
            ir.typeFieldOwnerDeclarationSourceLocalRows[i])
    for i in 0..<ir.typeFieldDeclarationSourceLocalRows.len:
        add(out.typeFieldDeclarationSourceLocalRows,
            ir.typeFieldDeclarationSourceLocalRows[i])
    for i in 0..<ir.typeFieldOrdinals.len:
        add(out.typeFieldOrdinals, ir.typeFieldOrdinals[i])
    for i in 0..<ir.typeFieldBuiltinKinds.len:
        add(out.typeFieldBuiltinKinds, ir.typeFieldBuiltinKinds[i])
    for i in 0..<ir.exactLayoutIndexSourceStarts.len:
        add(out.exactLayoutIndexSourceStarts,
            ir.exactLayoutIndexSourceStarts[i])
    for i in 0..<ir.exactLayoutDeclarationAuthorityStates.len:
        add(out.exactLayoutDeclarationAuthorityStates,
            ir.exactLayoutDeclarationAuthorityStates[i])
    for i in 0..<ir.exactLayoutDeclarationTypeArenaIds.len:
        add(out.exactLayoutDeclarationTypeArenaIds,
            ir.exactLayoutDeclarationTypeArenaIds[i])
    for i in 0..<ir.exactLayoutDeclarationSizeBytes.len:
        add(out.exactLayoutDeclarationSizeBytes,
            ir.exactLayoutDeclarationSizeBytes[i])
    for i in 0..<ir.exactLayoutDeclarationAlignBytes.len:
        add(out.exactLayoutDeclarationAlignBytes,
            ir.exactLayoutDeclarationAlignBytes[i])
    for i in 0..<ir.exactLayoutDeclarationGenericSymbolCounts.len:
        add(out.exactLayoutDeclarationGenericSymbolCounts,
            ir.exactLayoutDeclarationGenericSymbolCounts[i])
    for i in 0..<ir.exactLayoutTypeDeclarationRows.len:
        add(out.exactLayoutTypeDeclarationRows,
            ir.exactLayoutTypeDeclarationRows[i])
    for i in 0..<ir.exactLayoutTypeBuiltinRows.len:
        add(out.exactLayoutTypeBuiltinRows,
            ir.exactLayoutTypeBuiltinRows[i])
    for i in 0..<ir.exactLayoutFieldDeclarationRows.len:
        add(out.exactLayoutFieldDeclarationRows,
            ir.exactLayoutFieldDeclarationRows[i])
    for i in 0..<ir.exactLayoutFieldBuiltinRows.len:
        add(out.exactLayoutFieldBuiltinRows,
            ir.exactLayoutFieldBuiltinRows[i])
    for i in 0..<ir.exactLayoutOwnerDeclarationFieldCounts.len:
        add(out.exactLayoutOwnerDeclarationFieldCounts,
            ir.exactLayoutOwnerDeclarationFieldCounts[i])
    for i in 0..<ir.exactLayoutOwnerBuiltinFieldCounts.len:
        add(out.exactLayoutOwnerBuiltinFieldCounts,
            ir.exactLayoutOwnerBuiltinFieldCounts[i])
    for i in 0..<ir.typeDefAliasSourcePaths.len:
        add(out.typeDefAliasSourcePaths, share(ir.typeDefAliasSourcePaths[i]))
    for i in 0..<ir.typeDefAliasNames.len:
        add(out.typeDefAliasNames, share(ir.typeDefAliasNames[i]))
    for i in 0..<ir.typeDefAliasTargetTypes.len:
        add(out.typeDefAliasTargetTypes, share(ir.typeDefAliasTargetTypes[i]))
    for i in 0..<ir.typeAliasSourcePaths.len:
        add(out.typeAliasSourcePaths, share(ir.typeAliasSourcePaths[i]))
    for i in 0..<ir.typeAliasQualifiers.len:
        add(out.typeAliasQualifiers, share(ir.typeAliasQualifiers[i]))
    for i in 0..<ir.typeAliasTargetSourcePaths.len:
        add(out.typeAliasTargetSourcePaths, share(ir.typeAliasTargetSourcePaths[i]))
    for i in 0..<ir.enumValueSourcePaths.len:
        add(out.enumValueSourcePaths, share(ir.enumValueSourcePaths[i]))
    for i in 0..<ir.enumValueNames.len:
        add(out.enumValueNames, share(ir.enumValueNames[i]))
    for i in 0..<ir.enumValueTypes.len:
        add(out.enumValueTypes, share(ir.enumValueTypes[i]))
    for i in 0..<ir.enumValueOrdinals.len:
        add(out.enumValueOrdinals, ir.enumValueOrdinals[i])
    for i in 0..<ir.refObjectSourcePaths.len:
        add(out.refObjectSourcePaths, share(ir.refObjectSourcePaths[i]))
    for i in 0..<ir.refObjectTypeNames.len:
        add(out.refObjectTypeNames, share(ir.refObjectTypeNames[i]))
    for i in 0..<ir.sourceContextIndexSourcePaths.len:
        add(out.sourceContextIndexSourcePaths, share(ir.sourceContextIndexSourcePaths[i]))
    for i in 0..<ir.statementFunctionIndexBucketHeads.len:
        add(out.statementFunctionIndexBucketHeads, ir.statementFunctionIndexBucketHeads[i])
    for i in 0..<ir.statementFunctionIndexEntryNext.len:
        add(out.statementFunctionIndexEntryNext, ir.statementFunctionIndexEntryNext[i])
    for i in 0..<ir.statementFunctionIndexEntryStatementIndexes.len:
        add(out.statementFunctionIndexEntryStatementIndexes, ir.statementFunctionIndexEntryStatementIndexes[i])
    for i in 0..<ir.statementFunctionIndexEntryNames.len:
        add(out.statementFunctionIndexEntryNames, share(ir.statementFunctionIndexEntryNames[i]))
    for i in 0..<ir.statementFnBindingIndexBucketHeads.len:
        add(out.statementFnBindingIndexBucketHeads, ir.statementFnBindingIndexBucketHeads[i])
    for i in 0..<ir.statementFnBindingIndexEntryNext.len:
        add(out.statementFnBindingIndexEntryNext, ir.statementFnBindingIndexEntryNext[i])
    for i in 0..<ir.statementFnBindingIndexEntryStatementIndexes.len:
        add(out.statementFnBindingIndexEntryStatementIndexes, ir.statementFnBindingIndexEntryStatementIndexes[i])
    for i in 0..<ir.statementFnBindingIndexEntryFunctionNames.len:
        add(out.statementFnBindingIndexEntryFunctionNames, share(ir.statementFnBindingIndexEntryFunctionNames[i]))
    for i in 0..<ir.statementFnBindingIndexEntryBindingNames.len:
        add(out.statementFnBindingIndexEntryBindingNames, share(ir.statementFnBindingIndexEntryBindingNames[i]))
    for i in 0..<ir.paramRefIndexBucketHeads.len:
        add(out.paramRefIndexBucketHeads, ir.paramRefIndexBucketHeads[i])
    for i in 0..<ir.paramRefIndexEntryNext.len:
        add(out.paramRefIndexEntryNext, ir.paramRefIndexEntryNext[i])
    for i in 0..<ir.paramRefIndexEntryNodeIndexes.len:
        add(out.paramRefIndexEntryNodeIndexes, ir.paramRefIndexEntryNodeIndexes[i])
    for i in 0..<ir.paramRefIndexEntrySourcePaths.len:
        add(out.paramRefIndexEntrySourcePaths, share(ir.paramRefIndexEntrySourcePaths[i]))
    for i in 0..<ir.paramRefIndexEntryFunctionNames.len:
        add(out.paramRefIndexEntryFunctionNames, share(ir.paramRefIndexEntryFunctionNames[i]))
    for i in 0..<ir.paramRefIndexEntryParamNames.len:
        add(out.paramRefIndexEntryParamNames, share(ir.paramRefIndexEntryParamNames[i]))
    out.nodesTailOwnerSourcePathId = ir.nodesTailOwnerSourcePathId
    out.nodesTailOwnerFunctionNameId = ir.nodesTailOwnerFunctionNameId
    out.nodesTailBlockStartNodeIndex = ir.nodesTailBlockStartNodeIndex
    return out

fn TypedExprIrClone(ir: var TypedExprIr): TypedExprIr =
    return typedExprIrCloneImpl(ir, false)

fn TypedExprIrAssignInto(out: var TypedExprIr,
                          ir: var TypedExprIr) =
    # Assignment has the same owning semantics as Clone. Build one complete
    # clone and transfer it so this path cannot grow a second field inventory.
    var cloned = TypedExprIrClone(ir)
    TypedExprIrMoveInto(out, cloned)

fn TypedExprIrMoveInto(out: var TypedExprIr,
                        ir: var TypedExprIr) =
    if ir.valueExprTree != nil || ir.valueExprTreeBorrowLease ||
       out.valueExprTree != nil || out.valueExprTreeBorrowLease:
        panic("typed expr: move during parser value-tree transaction forbidden")
    # A fresh private ref is an unforgeable descriptor marker. This detects true
    # var-parameter aliasing without confusing two distinct IRs that happen to
    # own equal values, and restores the source before fail-stop.
    if ir.typedExprMetadataSession != nil &&
       memRefCount(ir.typedExprMetadataSession) != 1:
        panic("typed expr: TypedExprIrMoveInto source session owner is shared by value assignment")
    let sourceSession = ir.typedExprMetadataSession
    var aliasMarker: typedExprFrozenMetadataSession = new(typedExprFrozenMetadataSession)
    ir.typedExprMetadataSession = share(aliasMarker)
    let descriptorsAlias = out.typedExprMetadataSession == aliasMarker
    ir.typedExprMetadataSession = sourceSession
    if descriptorsAlias:
        panic("typed expr: TypedExprIrMoveInto source aliases destination descriptor")
    TypedExprIrReleasePayload(out)
    out.buildIndex = ir.buildIndex
    out.buildIndexGeneration = ir.buildIndexGeneration
    out.typedExprMetadataSession = ir.typedExprMetadataSession
    out.typedExprMetadataSessionGeneration = ir.typedExprMetadataSessionGeneration
    out.typedExprGlobalMetadataReady = ir.typedExprGlobalMetadataReady
    out.valueDefinitionTypeArenaArtifactCid =
        ir.valueDefinitionTypeArenaArtifactCid
    out.valueDefinitionTypeArenaBound =
        ir.valueDefinitionTypeArenaBound
    out.exactTypeArena = ir.exactTypeArena
    ir.buildIndex = nil
    ir.typedExprMetadataSession = nil
    # combo B: move the intern pool ref to out; the source is reset below.
    if ir.internPool != nil:
        out.internPool = ir.internPool
    else:
        out.internPool = langintern.InternPoolNew()
    # combo B-3: carry arena (value copy; deep ArenaClone + true move when columns migrate)
    out.arena = ir.arena
    out.valueExprTransactionDefinitionGroupRowsByPatternRow =
        ir.valueExprTransactionDefinitionGroupRowsByPatternRow
    out.valueExprTransactionParameterOrdinalsByDeclarationRow =
        ir.valueExprTransactionParameterOrdinalsByDeclarationRow
