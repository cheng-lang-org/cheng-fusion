    if typedExprSharedMetadataColumnInto(
           ctx.functionHeaderNames, 41, "functionHeaderNames",
           columnId, columnName, refCount):
        return true
    return typedExprSharedMetadataColumnInto(
        ctx.functionHeaderReturnTypes, 42, "functionHeaderReturnTypes",
        columnId, columnName, refCount)

fn typedExprSourceContextMetadataBuffersUnique(ctx: var TypedExprSourceContext): bool =
    var columnId: int32
    var columnName: str
    var refCount: int32
    return !typedExprSourceContextFirstSharedMetadataBufferInto(
        ctx, columnId, columnName, refCount)

fn TypedExprSourceContextSharedMetadataBufferInto(
        ctx: var TypedExprSourceContext,
        columnId: var int32,
        columnName: var str,
        refCount: var int32): bool =
    return typedExprSourceContextFirstSharedMetadataBufferInto(
        ctx, columnId, columnName, refCount)

@borrows
@borrow_result
fn typedExprFrozenProjectionText(projection: typedExprFrozenMetadataProjection,
                                  id: langintern.InternId): str =
    if projection == nil || projection.released || projection.internPool == nil:
        panic("typed expr: frozen metadata projection text unavailable")
    let textResult: Result[str] = langintern.LookupIntern(projection.internPool, id)
    if !IsOk(textResult):
        panic("typed expr: frozen metadata projection intern miss")
    return textResult.value

# Share of the projection's interned text for materialized context fields.
# The projection outlives every round view (contexts are released inside
# the round; the projection is released at session dispose), so a share is
# sound where a borrowed view is not storable. This replaces the per-round
# ParserOwnedText clone of every materialized row -- the facts/append round
# segments' dominant allocation. Materialized identity texts are immutable
# by contract; the share must never be mutated in place.
@borrows
fn typedExprFrozenProjectionTextShared(
        projection: typedExprFrozenMetadataProjection,
        id: langintern.InternId): str =
    if projection == nil || projection.released || projection.internPool == nil:
        panic("typed expr: frozen metadata projection text unavailable")
    return langintern.LookupInternShared(projection.internPool, id)

@borrows
fn typedExprFrozenContextIndexForIds(
        projection: typedExprFrozenMetadataProjection,
        sourcePath: str,
        normalizedSourcePathIds: langintern.InternId[],
        contextBucketHeads: int32[],
        contextNext: int32[],
        contextHashes: int32[]): int32 =
    if projection == nil || projection.released || sourcePath == "" ||
       contextBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash4(sourcePath, "", "", "")
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            contextBucketHeads.len)
    var contextIndex = contextBucketHeads[bucket]
    while contextIndex >= 0:
        if contextIndex >= contextNext.len ||
           contextIndex >= contextHashes.len ||
           contextIndex >= normalizedSourcePathIds.len:
            panic("typed expr: corrupt frozen metadata context index")
        if contextHashes[contextIndex] == hashValue &&
           typedExprFrozenProjectionText(
               projection,
               normalizedSourcePathIds[contextIndex]) == sourcePath:
            return contextIndex
        contextIndex = contextNext[contextIndex]
    return -1

@borrows
fn typedExprFrozenContextIndexForPath(
        projection: typedExprFrozenMetadataProjection,
        sourcePath: str): int32 =
    return typedExprFrozenContextIndexForIds(
        projection, sourcePath, projection.normalizedSourcePathIds,
        projection.contextBucketHeads, projection.contextNext,
        projection.contextHashes)

@borrows
fn typedExprFrozenAppendContextIndex(
        projection: var typedExprFrozenMetadataProjection,
        sourcePath: str,
        contextIndex: int32,
        normalizedSourcePathIds: langintern.InternId[]): bool =
    if projection == nil:
        panic("typed expr: frozen metadata context index append projection nil")
    if projection.released:
        panic("typed expr: frozen metadata context index append after release")
    if sourcePath == "":
        panic("typed expr: frozen metadata context index append source missing")
    if contextIndex != projection.contextNext.len:
        panic(Fmt"typed expr: frozen metadata context index row drift index={contextIndex} next_len={projection.contextNext.len} source_id_len={normalizedSourcePathIds.len}")
    if contextIndex >= normalizedSourcePathIds.len:
        panic(Fmt"typed expr: frozen metadata context source id missing index={contextIndex} next_len={projection.contextNext.len} source_id_len={normalizedSourcePathIds.len}")
    if typedExprFrozenContextIndexForIds(projection,
                                          sourcePath,
                                          normalizedSourcePathIds,
                                          projection.contextBucketHeads,
                                          projection.contextNext,
                                          projection.contextHashes) >= 0:
        return false
    let hashValue = TypedExprBuildIndexHash4(sourcePath, "", "", "")
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            projection.contextBucketHeads.len)
    add(projection.contextNext, projection.contextBucketHeads[bucket])
    add(projection.contextHashes, hashValue)
    projection.contextBucketHeads[bucket] = contextIndex
    return true

@borrows
fn typedExprFrozenStructuredHash(contextIndex: int32,
                                  name: str,
                                  startLine: int32): int32 =
    var seed: int64 = 2166136261
    seed = TypedExprBuildIndexHashText(seed, name)
    seed = (seed * 16777619 + Int64(contextIndex) + 1) % 2147483647
    seed = (seed * 16777619 + Int64(startLine) + 1) % 2147483647
    return Int32(seed)

@borrows
fn typedExprFrozenGlobalBindingRowContextIndex(
        projection: typedExprFrozenMetadataProjection,
        rowIndex: int32): int32 =
    if projection == nil ||
       projection.globalBindingStarts.len != projection.globalBindingCounts.len:
        panic("typed expr: frozen metadata global binding ranges mismatch")
    var low: int32
    var high = projection.globalBindingStarts.len
    while low < high:
        let middle = low + (high - low) / 2
        if projection.globalBindingStarts[middle] <= rowIndex:
            low = middle + 1
        else:
            high = middle
    let contextIndex = low - 1
    if contextIndex >= 0:
        let start = projection.globalBindingStarts[contextIndex]
        let count = projection.globalBindingCounts[contextIndex]
        if rowIndex >= start && rowIndex < start + count:
            return contextIndex
    return -1

@borrows
fn typedExprFrozenGlobalBindingRowLookup(
        projection: typedExprFrozenMetadataProjection,
        contextIndex: int32,
        name: str): int32 =
    if projection == nil || projection.released ||
       contextIndex < 0 ||
       contextIndex >= projection.globalBindingStarts.len ||
       name == "" || projection.globalBindingBucketHeads.len <= 0:
        return -1
    let nameId = langintern.FindInternId(projection.internPool, name)
    if nameId < 0:
        return -1
    let hashValue = typedExprFrozenStructuredHash(contextIndex, name, 0)
    let bucket = TypedExprBuildIndexBucket(
        hashValue, projection.globalBindingBucketHeads.len)
    var rowIndex = projection.globalBindingBucketHeads[bucket]
    while rowIndex >= 0:
        if rowIndex >= projection.globalBindingNext.len ||
           rowIndex >= projection.globalBindingHashes.len ||
           rowIndex >= projection.globalBindingNameIds.len:
            panic("typed expr: frozen metadata global binding index corrupt")
        if projection.globalBindingHashes[rowIndex] == hashValue &&
           projection.globalBindingNameIds[rowIndex] == nameId &&
           typedExprFrozenGlobalBindingRowContextIndex(
               projection, rowIndex) == contextIndex:
            return rowIndex
        rowIndex = projection.globalBindingNext[rowIndex]
    return -1

@borrows
fn typedExprFrozenBuildGlobalBindingIndex(
        projection: var typedExprFrozenMetadataProjection,
        err: var str): bool =
    projection.globalBindingBucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(projection.globalBindingNameIds.len, 8,
                                 "global_binding_bucket_capacity"))
    projection.globalBindingNext = []
    projection.globalBindingHashes = []
    for contextIndex in 0..<projection.globalBindingStarts.len:
        let start = projection.globalBindingStarts[contextIndex]
        let count = projection.globalBindingCounts[contextIndex]
        for localIndex in 0..<count:
            let rowIndex = start + localIndex
            if rowIndex != projection.globalBindingNext.len ||
               rowIndex >= projection.globalBindingNameIds.len:
                err = Fmt" typed expr: frozen metadata global binding row gap context_index={contextIndex} row={rowIndex}"
                return false
            let name = typedExprFrozenProjectionText(
                projection, projection.globalBindingNameIds[rowIndex])
            if typedExprFrozenGlobalBindingRowLookup(
                   projection, contextIndex, name) >= 0:
                err = Fmt" typed expr: frozen metadata duplicate global binding context_index={contextIndex} name={name}"
                return false
            let hashValue = typedExprFrozenStructuredHash(contextIndex,
                                                           name,
                                                           0)
            let bucket = TypedExprBuildIndexBucket(
                hashValue, projection.globalBindingBucketHeads.len)
            add(projection.globalBindingNext,
                projection.globalBindingBucketHeads[bucket])
            add(projection.globalBindingHashes, hashValue)
            projection.globalBindingBucketHeads[bucket] = rowIndex
    err = ""
    return true

@borrows
fn typedExprFrozenIrGlobalsExact(
        ir: TypedExprIr,
        projection: typedExprFrozenMetadataProjection,
        err: var str): bool =
    let count = projection.globalBindingNameIds.len
    if ir.globalNames.len != count || ir.globalSourcePaths.len != count ||
       ir.globalTypes.len != count || ir.globalInitValues.len != count ||
       ir.globalProducerSourceIndexes.len != count ||
       ir.globalDeclarationSourceLocalRows.len != count:
        err = Fmt" typed expr: frozen metadata globals were not committed before seal ir={ir.globalNames.len} projection={count}"
        return false
    var seen: bool[]
    setLen(seen, count)
    for globalIndex in 0..<count:
        let sourcePath = parser.ParserNormalizePath(
            ir.globalSourcePaths[globalIndex])
        let contextIndex = typedExprFrozenContextIndexForPath(
            projection, sourcePath)
        let rowIndex = typedExprFrozenGlobalBindingRowLookup(
            projection, contextIndex, ir.globalNames[globalIndex])
        if contextIndex < 0 || rowIndex < 0 || rowIndex >= count ||
           seen[rowIndex] ||
           ir.globalTypes[globalIndex] != typedExprFrozenProjectionText(
               projection, projection.globalBindingTypeIds[rowIndex]) ||
           ir.globalInitValues[globalIndex] != typedExprFrozenProjectionText(
               projection, projection.globalBindingInitValueIds[rowIndex]) ||
           ir.globalProducerSourceIndexes[globalIndex] !=
               projection.globalBindingProducerSourceIndexes[rowIndex] ||
           ir.globalDeclarationSourceLocalRows[globalIndex] !=
               projection.globalBindingDeclarationSourceLocalRows[rowIndex]:
            err = Fmt" typed expr: frozen metadata global commit mismatch row={globalIndex} source={sourcePath} name={ir.globalNames[globalIndex]}"
            return false
        seen[rowIndex] = true
    err = ""
    return true

@borrows
fn typedExprFrozenScopeRowLookup(projection: typedExprFrozenMetadataProjection,
                                  rows: typedExprFrozenScopeSoA,
                                  bucketHeads: int32[],
                                  next: int32[],
                                  hashes: int32[],
                                  contextIndex: int32,
                                  functionName: str,
                                  startLine: int32): int32 =
    if projection == nil || bucketHeads.len <= 0 || functionName == "":
        return -1
    let hashValue = typedExprFrozenStructuredHash(contextIndex,
                                                   functionName,
                                                   startLine)
    let bucket = TypedExprBuildIndexBucket(hashValue, bucketHeads.len)
    var rowIndex = bucketHeads[bucket]
    while rowIndex >= 0:
        if rowIndex >= next.len || rowIndex >= hashes.len ||
           rowIndex >= rows.nameIds.len || rowIndex >= rows.startLines.len:
            panic("typed expr: corrupt frozen metadata scope index")
        if hashes[rowIndex] == hashValue &&
           rows.startLines[rowIndex] == startLine &&
           typedExprFrozenProjectionText(projection,
                                          rows.nameIds[rowIndex]) == functionName:
            let rowContextIndex = typedExprFrozenScopeRowContextIndex(rows,
                                                                       rowIndex)
            if rowContextIndex == contextIndex:
                return rowIndex
        rowIndex = next[rowIndex]
    return -1

@borrows
fn typedExprFrozenScopeRowContextIndex(rows: typedExprFrozenScopeSoA,
                                        rowIndex: int32): int32 =
    if rows.contextStarts.len != rows.contextCounts.len:
        panic("typed expr: frozen metadata scope range columns mismatch")
    var low: int32
    var high = rows.contextStarts.len
    while low < high:
        let middle = low + (high - low) / 2
        if rows.contextStarts[middle] <= rowIndex:
            low = middle + 1
        else:
            high = middle
    let contextIndex = low - 1
    if contextIndex >= 0:
        let start = rows.contextStarts[contextIndex]
        let count = rows.contextCounts[contextIndex]
        if rowIndex >= start && rowIndex < start + count:
            return contextIndex
    return -1

@borrows
fn typedExprFrozenScopeRowForLine(
        projection: typedExprFrozenMetadataProjection,
        contextIndex: int32,
        lineNumber: int32): int32 =
    if projection == nil || projection.released || contextIndex < 0 ||
       contextIndex >= projection.scopes.contextStarts.len ||
       contextIndex >= projection.scopes.contextCounts.len || lineNumber <= 0:
        return -1
    let start = projection.scopes.contextStarts[contextIndex]
    let count = projection.scopes.contextCounts[contextIndex]
    if start < 0 || count < 0 || start > projection.scopes.startLines.len - count ||
       projection.scopes.endLines.len != projection.scopes.startLines.len:
        panic("typed expr: frozen metadata scope line range corrupt")
    var low = start
    var high = start + count
    while low < high:
        let middle = low + (high - low) / 2
        if projection.scopes.startLines[middle] <= lineNumber:
            low = middle + 1
        else:
            high = middle
    let rowIndex = low - 1
    if rowIndex >= start && rowIndex < start + count &&
       projection.scopes.startLines[rowIndex] <= lineNumber &&
       projection.scopes.endLines[rowIndex] >= lineNumber:
        return rowIndex
    return -1

@borrows
fn typedExprFrozenBuildEntryIndex(index: TypedExprBuildIndex,
                                   kind: str,
                                   sourcePath: str,
                                   name: str,
                                   detail: str): int32 =
    if index == nil || index.released || index.entryBucketHeads.len <= 0:
        return -1
    let hashValue = TypedExprBuildIndexHash4(kind, sourcePath, name, detail)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            index.entryBucketHeads.len)
    var entryIndex = index.entryBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= index.entryNext.len ||
           entryIndex >= index.entryHashes.len ||
           entryIndex >= typedExprBuildIndexEntryCount(index):
            panic("typed expr: corrupt build index while projecting metadata")
        if index.entryHashes[entryIndex] == hashValue &&
           typedExprBuildIndexEntryKind(index, entryIndex) == kind &&
           typedExprBuildIndexEntrySourcePath(index, entryIndex) == sourcePath &&
           typedExprBuildIndexEntryName(index, entryIndex) == name &&
           typedExprBuildIndexEntryDetail(index, entryIndex) == detail:
            return entryIndex
        entryIndex = index.entryNext[entryIndex]
    return -1

@borrows
fn typedExprFrozenBuildEntryMatches(index: TypedExprBuildIndex,
                                     entryIndex: int32,
                                     kind: str,
                                     sourcePath: str,
                                     name: str,
                                     detail: str,
                                     origin: str,
                                     fingerprint: str,
                                     checkFingerprint: bool,
                                     valueIndex: int32): bool =
    return index != nil && !index.released &&
           entryIndex >= 0 &&
           entryIndex < typedExprBuildIndexEntryCount(index) &&
           entryIndex < index.entryStates.len &&
           entryIndex < index.entryValueIndexes.len &&
           typedExprBuildIndexEntryKind(index, entryIndex) == kind &&
           typedExprBuildIndexEntrySourcePath(index, entryIndex) == sourcePath &&
           typedExprBuildIndexEntryName(index, entryIndex) == name &&
           typedExprBuildIndexEntryDetail(index, entryIndex) == detail &&
           index.entryStates[entryIndex] == TypedExprBuildIndexUnique &&
           typedExprBuildIndexEntryOrigin(index, entryIndex) == origin &&
           (!checkFingerprint ||
            typedExprBuildIndexEntryFingerprint(index, entryIndex) ==
                fingerprint) &&
           index.entryValueIndexes[entryIndex] == valueIndex

@borrows
fn typedExprFrozenClaimBuildEntry(acc: typedExprFrozenProjPass2Acc,
                                   entryIndex: int32): bool =
    if acc == nil || entryIndex < 0 || entryIndex >= acc.claimed.len:
        return false
    if acc.claimed[entryIndex]:
        return false
    acc.claimed[entryIndex] = true
    return true

@borrows
fn typedExprFrozenContextIndex(session: typedExprFrozenMetadataSession,
                               sourcePathRaw: str): int32 =
    var sourcePath: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(share(sourcePathRaw), sourcePath, pathErr):
        panic(Fmt"typed expr: frozen metadata source identity invalid path={sourcePathRaw}")
    return typedExprFrozenContextIndexForPath(session.projection, sourcePath)

@borrows
fn typedExprFrozenMetadataHasScope(session: typedExprFrozenMetadataSession,
                                   contextIndex: int32,
                                   scope: TypedExprFunctionScope): bool =
    return typedExprFrozenScopeRowLookup(session.projection,
                                         session.projection.scopes,
                                         session.projection.scopeBucketHeads,
                                         session.projection.scopeNext,
                                         session.projection.scopeHashes,
                                         contextIndex,
                                         scope.name,
                                         scope.startLine) >= 0

@borrows
fn typedExprFrozenScopeSourceLen(ctx: var TypedExprSourceContext,
                                  useSignatures: bool): int32 =
    if useSignatures:
        return ctx.signatureScopes.len
    return ctx.scopes.len

@borrows
fn typedExprFrozenAppendScopeRowOne(
        projection: var typedExprFrozenMetadataProjection,
        ctx: var TypedExprSourceContext,
        useSignatures: bool,
        contextIndex: int32,
        scopeIndex: int32,
        err: var str): bool =
    var name: str
    var startLine: int32
    var endLine: int32
    var producerDeclarationOrdinal: int32
    var borrowResult: bool
    var borrowsArguments: bool
    var returnTypeField: str
    var genericNameJoin: str
    var genericNamesComplete: bool
    var paramTypeJoin: str
    var paramTypesComplete: bool
    var manualConsumePresent: bool
    var manualConsumeFunctionDeclarationRow: int32
    var manualConsumeTargetParameterOrdinal: int32
    var manualConsumeSourceParameterOrdinal: int32
    var manualConsumeTargetParameterDeclarationRow: int32
    var manualConsumeSourceParameterDeclarationRow: int32
    if useSignatures:
        name = strings.CloneStr(ctx.signatureScopes[scopeIndex].name)
        startLine = ctx.signatureScopes[scopeIndex].startLine
        endLine = ctx.signatureScopes[scopeIndex].endLine
        producerDeclarationOrdinal =
            ctx.signatureScopes[scopeIndex].producerDeclarationOrdinal
        borrowResult = ctx.signatureScopes[scopeIndex].borrowResult
        borrowsArguments =
            ctx.signatureScopes[scopeIndex].borrowsArguments
        returnTypeField = strings.CloneStr(ctx.signatureScopes[scopeIndex].returnType)
        genericNameJoin = strings.CloneStr(ctx.signatureScopes[scopeIndex].genericNameJoin)
        genericNamesComplete = ctx.signatureScopes[scopeIndex].genericNamesComplete
        paramTypeJoin = strings.CloneStr(ctx.signatureScopes[scopeIndex].paramTypeJoin)
        paramTypesComplete = ctx.signatureScopes[scopeIndex].paramTypesComplete
        manualConsumePresent = ctx.signatureScopes[scopeIndex].manualConsumePresent
        manualConsumeFunctionDeclarationRow =
            ctx.signatureScopes[scopeIndex].manualConsumeFunctionDeclarationRow
        manualConsumeTargetParameterOrdinal =
            ctx.signatureScopes[scopeIndex].manualConsumeTargetParameterOrdinal
        manualConsumeSourceParameterOrdinal =
            ctx.signatureScopes[scopeIndex].manualConsumeSourceParameterOrdinal
        manualConsumeTargetParameterDeclarationRow =
            ctx.signatureScopes[scopeIndex].manualConsumeTargetParameterDeclarationRow
        manualConsumeSourceParameterDeclarationRow =
            ctx.signatureScopes[scopeIndex].manualConsumeSourceParameterDeclarationRow
    else:
        name = strings.CloneStr(ctx.scopes[scopeIndex].name)
        startLine = ctx.scopes[scopeIndex].startLine
        endLine = ctx.scopes[scopeIndex].endLine
        producerDeclarationOrdinal =
            ctx.scopes[scopeIndex].producerDeclarationOrdinal
        borrowResult = ctx.scopes[scopeIndex].borrowResult
        borrowsArguments = ctx.scopes[scopeIndex].borrowsArguments
        returnTypeField = strings.CloneStr(ctx.scopes[scopeIndex].returnType)
        genericNameJoin = strings.CloneStr(ctx.scopes[scopeIndex].genericNameJoin)
        genericNamesComplete = ctx.scopes[scopeIndex].genericNamesComplete
        paramTypeJoin = strings.CloneStr(ctx.scopes[scopeIndex].paramTypeJoin)
        paramTypesComplete = ctx.scopes[scopeIndex].paramTypesComplete
        manualConsumePresent = ctx.scopes[scopeIndex].manualConsumePresent
        manualConsumeFunctionDeclarationRow =
            ctx.scopes[scopeIndex].manualConsumeFunctionDeclarationRow
        manualConsumeTargetParameterOrdinal =
            ctx.scopes[scopeIndex].manualConsumeTargetParameterOrdinal
        manualConsumeSourceParameterOrdinal =
            ctx.scopes[scopeIndex].manualConsumeSourceParameterOrdinal
        manualConsumeTargetParameterDeclarationRow =
            ctx.scopes[scopeIndex].manualConsumeTargetParameterDeclarationRow
        manualConsumeSourceParameterDeclarationRow =
            ctx.scopes[scopeIndex].manualConsumeSourceParameterDeclarationRow
    if name == "" || startLine <= 0 || endLine < startLine:
        err = Fmt" typed expr: frozen metadata scope invalid function={name} start={startLine} end={endLine}"
        return false
    var scope: TypedExprFunctionScope
    scope.name = strings.CloneStr(name)
    scope.startLine = startLine
    scope.endLine = endLine
    scope.producerDeclarationOrdinal = producerDeclarationOrdinal
    scope.borrowResult = borrowResult
    scope.borrowsArguments = borrowsArguments
    scope.returnType = strings.CloneStr(returnTypeField)
    scope.genericNameJoin = strings.CloneStr(genericNameJoin)
    scope.genericNamesComplete = genericNamesComplete
    scope.paramTypeJoin = strings.CloneStr(paramTypeJoin)
    scope.paramTypesComplete = paramTypesComplete
    scope.manualConsumePresent = manualConsumePresent
    scope.manualConsumeFunctionDeclarationRow = manualConsumeFunctionDeclarationRow
    scope.manualConsumeTargetParameterOrdinal = manualConsumeTargetParameterOrdinal
    scope.manualConsumeSourceParameterOrdinal = manualConsumeSourceParameterOrdinal
    scope.manualConsumeTargetParameterDeclarationRow =
        manualConsumeTargetParameterDeclarationRow
    scope.manualConsumeSourceParameterDeclarationRow =
        manualConsumeSourceParameterDeclarationRow
    var genericNames: str[]
    var paramTypes: str[]
    var returnType: str
    TypedExprScopeCallDeclarationInto(ctx,
                                       share(scope),
                                       genericNames,
                                       paramTypes,
                                       returnType)
    if ctx.buildIndex == nil || ctx.buildIndex.released ||
       !ctx.buildIndex.callDeclarationSealed:
        err = " typed expr: frozen metadata manual-consume index unavailable"
        return false
    var declarationRow: int32 = -1
    if !typedExprFrozenScopeFindDeclarationRow(ctx,
                                               contextIndex,
                                               producerDeclarationOrdinal,
                                               declarationRow,
                                               err):
        return false
    if ctx.buildIndex.callDeclarationManualConsumePresents[
           declarationRow] != manualConsumePresent ||
       ctx.buildIndex.callDeclarationManualConsumeFunctionDeclarationRows[
           declarationRow] != manualConsumeFunctionDeclarationRow ||
       ctx.buildIndex.callDeclarationManualConsumeTargetParameterOrdinals[
           declarationRow] != manualConsumeTargetParameterOrdinal ||
       ctx.buildIndex.callDeclarationManualConsumeSourceParameterOrdinals[
           declarationRow] != manualConsumeSourceParameterOrdinal ||
       ctx.buildIndex.callDeclarationManualConsumeTargetParameterDeclarationRows[
           declarationRow] !=
           manualConsumeTargetParameterDeclarationRow ||
       ctx.buildIndex.callDeclarationManualConsumeSourceParameterDeclarationRows[
           declarationRow] !=
           manualConsumeSourceParameterDeclarationRow:
        err = " typed expr: frozen metadata manual-consume parser identity drift"
        return false
    if manualConsumePresent &&
       (!ctx.buildIndex.callDeclarationManualConsumeTypeArenaBound ||
        ctx.buildIndex.callDeclarationManualConsumeTargetTypeIds[
            declarationRow] < 0 ||
        ctx.buildIndex.callDeclarationManualConsumeSourceTypeIds[
            declarationRow] < 0 ||
        layout.FixedBytes32Equal(
            ctx.buildIndex.callDeclarationManualConsumeEffectCids[
                declarationRow],
            layout.FixedBytes32())):
        err = " typed expr: frozen metadata manual-consume TypeArena authority missing"
        return false
    var nameId = TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                                                            share(name))
    var returnTypeId = TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                                                                  share(returnType))
    var targetTypeId =
        ctx.buildIndex.callDeclarationManualConsumeTargetTypeIds[declarationRow]
    var sourceTypeId =
        ctx.buildIndex.callDeclarationManualConsumeSourceTypeIds[declarationRow]
    var effectCid = layout.FixedBytes32Copy(
        ctx.buildIndex.callDeclarationManualConsumeEffectCids[declarationRow])
    if useSignatures:
        add(projection.signatures.nameIds, nameId)
        add(projection.signatures.producerDeclarationOrdinals,
            producerDeclarationOrdinal)
        add(projection.signatures.startLines, startLine)
        add(projection.signatures.endLines, endLine)
        add(projection.signatures.returnTypeIds, returnTypeId)
        add(projection.signatures.borrowResults, borrowResult)
        add(projection.signatures.borrowsArguments, borrowsArguments)
        add(projection.signatures.manualConsumePresents, manualConsumePresent)
        add(projection.signatures.manualConsumeFunctionDeclarationRows,
            manualConsumeFunctionDeclarationRow)
        add(projection.signatures.manualConsumeTargetParameterOrdinals,
            manualConsumeTargetParameterOrdinal)
        add(projection.signatures.manualConsumeSourceParameterOrdinals,
            manualConsumeSourceParameterOrdinal)
        add(projection.signatures.manualConsumeTargetParameterDeclarationRows,
            manualConsumeTargetParameterDeclarationRow)
        add(projection.signatures.manualConsumeSourceParameterDeclarationRows,
            manualConsumeSourceParameterDeclarationRow)
        add(projection.signatures.manualConsumeTargetTypeIds, targetTypeId)
        add(projection.signatures.manualConsumeSourceTypeIds, sourceTypeId)
        add(projection.signatures.manualConsumeEffectCids, effectCid)
        add(projection.signatures.genericStarts, projection.signatures.genericNameIds.len)
        add(projection.signatures.genericCounts, genericNames.len)
        if !typedExprFrozenScopeAddTextIds(projection,
                                           true,
                                           genericNames,
                                           0,
                                           err):
            return false
        add(projection.signatures.paramStarts, projection.signatures.paramTypeIds.len)
        add(projection.signatures.paramCounts, paramTypes.len)
        if !typedExprFrozenScopeAddParamTypeIds(projection,
                                                true,
                                                paramTypes,
                                                name,
                                                0,
                                                err):
            return false
    else:
        add(projection.scopes.nameIds, nameId)
        add(projection.scopes.producerDeclarationOrdinals,
            producerDeclarationOrdinal)
        add(projection.scopes.startLines, startLine)
        add(projection.scopes.endLines, endLine)
        add(projection.scopes.returnTypeIds, returnTypeId)
        add(projection.scopes.borrowResults, borrowResult)
        add(projection.scopes.borrowsArguments, borrowsArguments)
        add(projection.scopes.manualConsumePresents, manualConsumePresent)
        add(projection.scopes.manualConsumeFunctionDeclarationRows,
            manualConsumeFunctionDeclarationRow)
        add(projection.scopes.manualConsumeTargetParameterOrdinals,
            manualConsumeTargetParameterOrdinal)
        add(projection.scopes.manualConsumeSourceParameterOrdinals,
            manualConsumeSourceParameterOrdinal)
        add(projection.scopes.manualConsumeTargetParameterDeclarationRows,
            manualConsumeTargetParameterDeclarationRow)
        add(projection.scopes.manualConsumeSourceParameterDeclarationRows,
            manualConsumeSourceParameterDeclarationRow)
        add(projection.scopes.manualConsumeTargetTypeIds, targetTypeId)
        add(projection.scopes.manualConsumeSourceTypeIds, sourceTypeId)
        add(projection.scopes.manualConsumeEffectCids, effectCid)
        add(projection.scopes.genericStarts, projection.scopes.genericNameIds.len)
        add(projection.scopes.genericCounts, genericNames.len)
        if !typedExprFrozenScopeAddTextIds(projection,
                                           false,
                                           genericNames,
                                           0,
                                           err):
            return false
        add(projection.scopes.paramStarts, projection.scopes.paramTypeIds.len)
        add(projection.scopes.paramCounts, paramTypes.len)
        if !typedExprFrozenScopeAddParamTypeIds(projection,
                                                false,
                                                paramTypes,
                                                name,
                                                0,
                                                err):
            return false
    err = ""
    return true

@borrows
fn typedExprFrozenScopeFindDeclarationRow(
        ctx: var TypedExprSourceContext,
        contextIndex: int32,
        producerDeclarationOrdinal: int32,
        declarationRow: var int32,
        err: var str): bool =
    declarationRow = -1
    return typedExprFrozenScopeFindDeclarationRowRec(
        ctx, contextIndex, producerDeclarationOrdinal, 0, declarationRow, err)

@borrows
fn typedExprFrozenScopeFindDeclarationRowRec(
        ctx: var TypedExprSourceContext,
        contextIndex: int32,
        producerDeclarationOrdinal: int32,
        callRow: int32,
        declarationRow: var int32,
        err: var str): bool =
    while true:
        if callRow >= ctx.buildIndex.callDeclarationSourcePaths.len:
            if declarationRow < 0:
                err = " typed expr: frozen metadata manual-consume producer missing"
                return false
            err = ""
            return true
        if ctx.buildIndex.callDeclarationKinds[callRow] ==
               TypedExprCallDeclarationFunction &&
           ctx.buildIndex.callDeclarationProducerSourceIndexes[callRow] ==
               contextIndex &&
           ctx.buildIndex.callDeclarationProducerDeclarationOrdinals[callRow] ==
               producerDeclarationOrdinal:
            if declarationRow >= 0:
                err = " typed expr: frozen metadata manual-consume producer ambiguous"
                return false
            declarationRow = callRow
        callRow = callRow + 1
        continue

@borrows
fn typedExprFrozenScopeAddTextIds(
        projection: var typedExprFrozenMetadataProjection,
        useSignatures: bool,
        items: str[],
        itemIndex: int32,
        err: var str): bool =
    while true:
        if itemIndex >= items.len:
            err = ""
            return true
        let textId = TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                                                                 share(items[itemIndex]))
        if useSignatures:
            add(projection.signatures.genericNameIds, textId)
        else:
            add(projection.scopes.genericNameIds, textId)
        itemIndex = itemIndex + 1
        continue

@borrows
fn typedExprFrozenScopeAddParamTypeIds(
        projection: var typedExprFrozenMetadataProjection,
        useSignatures: bool,
        items: str[],
        functionName: str,
        itemIndex: int32,
        err: var str): bool =
    while true:
        if itemIndex >= items.len:
            err = ""
            return true
        let paramType = TypedExprNormalizeTypeText(items[itemIndex])
        if paramType == "":
            err = Fmt" typed expr: frozen metadata scope parameter type missing function={functionName} index={itemIndex}"
            return false
        let typeId = TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                                                                 share(paramType))
        if useSignatures:
            add(projection.signatures.paramTypeIds, typeId)
        else:
            add(projection.scopes.paramTypeIds, typeId)
        itemIndex = itemIndex + 1
        continue

@borrows
fn typedExprFrozenAppendScopeRowRec(
        projection: var typedExprFrozenMetadataProjection,
        ctx: var TypedExprSourceContext,
        useSignatures: bool,
        contextIndex: int32,
        sourceLen: int32,
        scopeIndex: int32,
        err: var str): bool =
    while true:
        if scopeIndex >= sourceLen:
            err = ""
            return true
        if !typedExprFrozenAppendScopeRowOne(projection,
                                              ctx,
                                              useSignatures,
                                              contextIndex,
                                              scopeIndex,
                                              err):
            return false
        scopeIndex = scopeIndex + 1
        continue

@borrows
fn typedExprFrozenAppendScopeContext(projection: var typedExprFrozenMetadataProjection,
                                      ctx: var TypedExprSourceContext,
                                      useSignatures: bool,
                                      contextIndex: int32,
                                      err: var str): bool =
    let sourceLen = typedExprFrozenScopeSourceLen(ctx, useSignatures)
    if useSignatures:
        add(projection.signatures.contextStarts, projection.signatures.nameIds.len)
        add(projection.signatures.contextCounts, sourceLen)
    else:
        add(projection.scopes.contextStarts, projection.scopes.nameIds.len)
        add(projection.scopes.contextCounts, sourceLen)
    return typedExprFrozenAppendScopeRowRec(projection,
                                             ctx,
                                             useSignatures,
                                             contextIndex,
                                             sourceLen,
                                             0,
                                             err)

@borrows
fn typedExprFrozenProjAppendScopesRec(
        contexts: var TypedExprSourceContext[],
        projection: var typedExprFrozenMetadataProjection,
        contextIndex: int32,
        err: var str): bool =
    while true:
        if contextIndex >= contexts.len:
            err = ""
            return true
        if !typedExprFrozenAppendScopeContext(projection,
                                               contexts[contextIndex],
                                               false,
                                               contextIndex,
                                               err):
            return false
        if !typedExprFrozenAppendScopeContext(projection,
                                               contexts[contextIndex],
                                               true,
                                               contextIndex,
                                               err):
            return false
        contextIndex = contextIndex + 1
        continue

@borrows
fn typedExprFrozenScopeRowContextIndexKind(
        projection: typedExprFrozenMetadataProjection,
        useSignatures: bool,
        rowIndex: int32): int32 =
    var low: int32
    var high: int32
    if useSignatures:
        if projection.signatures.contextStarts.len !=
               projection.signatures.contextCounts.len:
            panic("typed expr: frozen metadata scope range columns mismatch")
        high = projection.signatures.contextStarts.len
        while low < high:
            let middle = low + (high - low) / 2
            if projection.signatures.contextStarts[middle] <= rowIndex:
                low = middle + 1
            else:
                high = middle
        let contextIndex = low - 1
        if contextIndex >= 0:
            let start = projection.signatures.contextStarts[contextIndex]
            let count = projection.signatures.contextCounts[contextIndex]
            if rowIndex >= start && rowIndex < start + count:
                return contextIndex
        return -1
    if projection.scopes.contextStarts.len != projection.scopes.contextCounts.len:
        panic("typed expr: frozen metadata scope range columns mismatch")
    high = projection.scopes.contextStarts.len
    while low < high:
        let middle = low + (high - low) / 2
        if projection.scopes.contextStarts[middle] <= rowIndex:
            low = middle + 1
        else:
            high = middle
    let contextIndex = low - 1
    if contextIndex >= 0:
        let start = projection.scopes.contextStarts[contextIndex]
        let count = projection.scopes.contextCounts[contextIndex]
        if rowIndex >= start && rowIndex < start + count:
            return contextIndex
    return -1

@borrows
fn typedExprFrozenBuildScopeIndex(projection: var typedExprFrozenMetadataProjection,
                                   useSignatures: bool,
                                   uniqueByName: bool,
                                   label: str,
                                   err: var str): bool =
    var nameCount: int32
    var contextCount: int32
    if useSignatures:
        nameCount = projection.signatures.nameIds.len
        contextCount = projection.signatures.contextStarts.len
    else:
        nameCount = projection.scopes.nameIds.len
        contextCount = projection.scopes.contextStarts.len
    var bucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(nameCount, 8, "frozen_scope_bucket_capacity"))
    var next: int32[]
    var hashes: int32[]
    for rowIndex in 0..<nameCount:
        add(next, -1)
        add(hashes, 0)
    for contextIndex in 0..<contextCount:
        var start: int32
        var count: int32
        var nameLen: int32
        if useSignatures:
            if contextIndex >= projection.signatures.contextCounts.len:
                panic("typed expr: frozen metadata scope range columns mismatch")
            start = projection.signatures.contextStarts[contextIndex]
            count = projection.signatures.contextCounts[contextIndex]
            nameLen = projection.signatures.nameIds.len
        else:
            if contextIndex >= projection.scopes.contextCounts.len:
                panic("typed expr: frozen metadata scope range columns mismatch")
            start = projection.scopes.contextStarts[contextIndex]
            count = projection.scopes.contextCounts[contextIndex]
            nameLen = projection.scopes.nameIds.len
        if start < 0 || count < 0 || start > nameLen - count:
            panic("typed expr: frozen metadata scope range corrupt")
        for localIndex in 0..<count:
            let rowIndex = start + localIndex
            var name: str
            var startLine: int32
            if useSignatures:
                name = typedExprFrozenProjectionText(
                    projection, projection.signatures.nameIds[rowIndex])
                startLine = projection.signatures.startLines[rowIndex]
            else:
                name = typedExprFrozenProjectionText(
                    projection, projection.scopes.nameIds[rowIndex])
                startLine = projection.scopes.startLines[rowIndex]
            var keyStartLine = startLine
            if uniqueByName:
                keyStartLine = 0
            let hashValue = typedExprFrozenStructuredHash(contextIndex,
                                                           name,
                                                           keyStartLine)
            let bucket = TypedExprBuildIndexBucket(hashValue,
                                                    bucketHeads.len)
            var existing = bucketHeads[bucket]
            while existing >= 0:
                var existingName: str
                var existingStartLine: int32
                if useSignatures:
                    existingName = typedExprFrozenProjectionText(
                        projection, projection.signatures.nameIds[existing])
                    existingStartLine = projection.signatures.startLines[existing]
                else:
                    existingName = typedExprFrozenProjectionText(
                        projection, projection.scopes.nameIds[existing])
                    existingStartLine = projection.scopes.startLines[existing]
                if hashes[existing] == hashValue && existingName == name:
                    let existingContext = typedExprFrozenScopeRowContextIndexKind(
                        projection, useSignatures, existing)
                    var sameKey = existingContext == contextIndex
                    if !uniqueByName:
                        sameKey = sameKey && existingStartLine == startLine
                    if sameKey:
                        err = Fmt" typed expr: frozen metadata duplicate {label} context_index={contextIndex} function={name} start={startLine}"
                        return false
                existing = next[existing]
            next[rowIndex] = bucketHeads[bucket]
            hashes[rowIndex] = hashValue
            bucketHeads[bucket] = rowIndex
    if useSignatures:
        projection.signatureBucketHeads = bucketHeads
        projection.signatureNext = next
        projection.signatureHashes = hashes
    else:
        projection.scopeBucketHeads = bucketHeads
        projection.scopeNext = next
        projection.scopeHashes = hashes
    err = ""
    return true

@borrows
fn typedExprFrozenBuildSnapshotScopeIndex(
        projection: var typedExprFrozenMetadataProjection,
        err: var str): bool =
    let nameCount = projection.scopes.nameIds.len
    var bucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(nameCount, 8, "snapshot_scope_bucket_capacity"))
    var next: int32[]
    var hashes: int32[]
    for rowIndex in 0..<nameCount:
        add(next, -1)
        add(hashes, 0)
    for contextIndex in 0..<projection.scopes.contextStarts.len:
        if contextIndex >= projection.scopes.contextCounts.len ||
           contextIndex >= projection.snapshotOnly.len:
            panic("typed expr: frozen snapshot scope range columns mismatch")
        if !projection.snapshotOnly[contextIndex]:
            continue
        let start = projection.scopes.contextStarts[contextIndex]
        let count = projection.scopes.contextCounts[contextIndex]
        if start < 0 || count < 0 || start > nameCount - count:
            panic("typed expr: frozen snapshot scope range corrupt")
        for localIndex in 0..<count:
            let rowIndex = start + localIndex
            let name = typedExprFrozenProjectionText(
                projection, projection.scopes.nameIds[rowIndex])
            let hashValue = typedExprFrozenStructuredHash(contextIndex,
                                                           name,
                                                           0)
            let bucket = TypedExprBuildIndexBucket(hashValue,
                                                    bucketHeads.len)
            var existing = bucketHeads[bucket]
            while existing >= 0:
                if hashes[existing] == hashValue &&
                   typedExprFrozenScopeRowContextIndexKind(
                       projection, false, existing) == contextIndex &&
                   typedExprFrozenProjectionText(
                       projection,
                       projection.scopes.nameIds[existing]) == name &&
                   projection.scopes.startLines[existing] ==
                       projection.scopes.startLines[rowIndex]:
                    err = Fmt" typed expr: frozen metadata duplicate snapshot scope context_index={contextIndex} function={name} start={projection.scopes.startLines[rowIndex]}"
                    return false
                existing = next[existing]
            next[rowIndex] = bucketHeads[bucket]
            hashes[rowIndex] = hashValue
            bucketHeads[bucket] = rowIndex
    projection.snapshotFunctionBucketHeads = bucketHeads
    projection.snapshotFunctionNext = next
    projection.snapshotFunctionHashes = hashes
    err = ""
    return true

@borrows
fn typedExprFrozenBuildSnapshotImportcIndex(projection: typedExprFrozenMetadataProjection,
                                             err: var str): bool =
    var entryCount: int32
    for contextIndex in 0..<projection.importcs.contextStarts.len:
        if contextIndex >= projection.snapshotOnly.len:
            panic("typed expr: frozen snapshot importc context range mismatch")
        if !projection.snapshotOnly[contextIndex]:
            continue
        let start = projection.importcs.contextStarts[contextIndex]
        let count = projection.importcs.contextCounts[contextIndex]
        for localIndex in 0..<count:
            let rowIndex = start + localIndex
            entryCount = typedExprCheckedAddInt32(entryCount, 1,
                                                  "snapshot_importc_entries")
            if projection.importcs.targetIds[rowIndex] !=
               projection.importcs.nameIds[rowIndex]:
                entryCount = typedExprCheckedAddInt32(entryCount, 1,
                                                      "snapshot_importc_entries")
    projection.snapshotImportcBucketHeads =
        TypedExprBuildIndexEmptyBuckets(typedExprCheckedAddInt32(
            entryCount, 8, "snapshot_importc_bucket_capacity"))
    for contextIndex in 0..<projection.importcs.contextStarts.len:
        if contextIndex >= projection.snapshotOnly.len:
            panic("typed expr: frozen snapshot importc context range mismatch")
        if !projection.snapshotOnly[contextIndex]:
            continue
        let start = projection.importcs.contextStarts[contextIndex]
        let count = projection.importcs.contextCounts[contextIndex]
        for localIndex in 0..<count:
            let rowIndex = start + localIndex
            var nameIds: langintern.InternId[]
            add(nameIds, projection.importcs.nameIds[rowIndex])
            if projection.importcs.targetIds[rowIndex] !=
               projection.importcs.nameIds[rowIndex]:
                add(nameIds, projection.importcs.targetIds[rowIndex])
            for nameIndex in 0..<nameIds.len:
                let name = typedExprFrozenProjectionText(projection,
                                                           nameIds[nameIndex])
                let hashValue = typedExprFrozenStructuredHash(contextIndex,
                                                               name,
                                                               0)
                let bucket = TypedExprBuildIndexBucket(hashValue,
                                                        projection.snapshotImportcBucketHeads.len)
                var entryIndex = projection.snapshotImportcBucketHeads[bucket]
                while entryIndex >= 0:
                    if entryIndex >= projection.snapshotImportcNext.len ||
                       entryIndex >= projection.snapshotImportcHashes.len ||
                       entryIndex >= projection.snapshotImportcContextIndexes.len ||
                       entryIndex >= projection.snapshotImportcNameIds.len ||
                       entryIndex >= projection.snapshotImportcRowIndexes.len:
                        panic("typed expr: corrupt frozen snapshot importc index")
                    if projection.snapshotImportcHashes[entryIndex] == hashValue &&
                       projection.snapshotImportcContextIndexes[entryIndex] == contextIndex &&
                       typedExprFrozenProjectionText(projection,
                                                      projection.snapshotImportcNameIds[entryIndex]) == name:
                        if projection.snapshotImportcRowIndexes[entryIndex] != rowIndex:
                            if nameIndex == 0:
                                err = Fmt" typed expr: frozen metadata snapshot importc ambiguous context_index={contextIndex} name={name}"
                                return false
                            # A shared import TARGET name is a legitimate
                            # many-to-one C symbol mapping across canonical
                            # overloads with distinct Cheng signatures. Each
                            # declaration keeps its exact source-row identity;
                            # for target keys the first row already covers the
                            # lookup contract, so later duplicates are skipped
                            # instead of being rejected.
                            entryIndex = -1
                            break
                        entryIndex = -1
                        break
                    entryIndex = projection.snapshotImportcNext[entryIndex]
                if entryIndex == -1:
                    var duplicate = false
                    let existingHead = projection.snapshotImportcBucketHeads[bucket]
                    var existingIndex = existingHead
                    while existingIndex >= 0:
                        if projection.snapshotImportcHashes[existingIndex] == hashValue &&
                           projection.snapshotImportcContextIndexes[existingIndex] == contextIndex &&
                           typedExprFrozenProjectionText(projection,
                                                          projection.snapshotImportcNameIds[existingIndex]) == name:
                            duplicate = true
                            break
                        existingIndex = projection.snapshotImportcNext[existingIndex]
                    if duplicate:
                        continue
                var heads = TypedExprCloneI32Seq(
                    projection.snapshotImportcBucketHeads)
                let nextIndex = projection.snapshotImportcContextIndexes.len
                var next = TypedExprCloneI32Seq(projection.snapshotImportcNext)
                add(next, heads[bucket])
                projection.snapshotImportcNext = next
                var hashes = TypedExprCloneI32Seq(
                    projection.snapshotImportcHashes)
                add(hashes, hashValue)
                projection.snapshotImportcHashes = hashes
                var contextIndexes = TypedExprCloneI32Seq(
                    projection.snapshotImportcContextIndexes)
                add(contextIndexes, contextIndex)
                projection.snapshotImportcContextIndexes = contextIndexes
                var snapshotNameIds = TypedExprCloneI32Seq(
                    projection.snapshotImportcNameIds)
                add(snapshotNameIds, nameIds[nameIndex])
                projection.snapshotImportcNameIds = snapshotNameIds
                var rowIndexes = TypedExprCloneI32Seq(
                    projection.snapshotImportcRowIndexes)
                add(rowIndexes, rowIndex)
                projection.snapshotImportcRowIndexes = rowIndexes
                heads[bucket] = nextIndex
                projection.snapshotImportcBucketHeads = heads
    err = ""
    return true

@borrows
@borrow_result
fn typedExprFrozenScopeParamText(projection: typedExprFrozenMetadataProjection,
                                  rows: typedExprFrozenScopeSoA,
                                  rowIndex: int32,
                                  paramIndex: int32): str =
    if rowIndex < 0 || rowIndex >= rows.paramStarts.len ||
       rowIndex >= rows.paramCounts.len || paramIndex < 0 ||
       paramIndex >= rows.paramCounts[rowIndex]:
        panic("typed expr: frozen metadata scope parameter out of range")
    let itemIndex = rows.paramStarts[rowIndex] + paramIndex
    if itemIndex < 0 || itemIndex >= rows.paramTypeIds.len:
        panic("typed expr: frozen metadata scope parameter range corrupt")
    return typedExprFrozenProjectionText(projection,
                                          rows.paramTypeIds[itemIndex])

@borrows
@borrow_result
fn typedExprFrozenScopeGenericName(projection: typedExprFrozenMetadataProjection,
                                    rows: typedExprFrozenScopeSoA,
                                    rowIndex: int32,
                                    genericIndex: int32): str =
    if rowIndex < 0 || rowIndex >= rows.genericStarts.len ||
       rowIndex >= rows.genericCounts.len || genericIndex < 0 ||
       genericIndex >= rows.genericCounts[rowIndex]:
        panic("typed expr: frozen metadata scope generic out of range")
    let itemIndex = rows.genericStarts[rowIndex] + genericIndex
    if itemIndex < 0 || itemIndex >= rows.genericNameIds.len:
        panic("typed expr: frozen metadata scope generic range corrupt")
    return typedExprFrozenProjectionText(projection,
                                          rows.genericNameIds[itemIndex])

@borrows
@borrow_result
fn typedExprFrozenImportcParamText(projection: typedExprFrozenMetadataProjection,
                                    rowIndex: int32,
                                    paramIndex: int32): str =
    if rowIndex < 0 || rowIndex >= projection.importcs.paramStarts.len ||
       rowIndex >= projection.importcs.paramCounts.len || paramIndex < 0 ||
       paramIndex >= projection.importcs.paramCounts[rowIndex]:
        panic("typed expr: frozen metadata importc parameter out of range")
    let itemIndex = projection.importcs.paramStarts[rowIndex] + paramIndex
    if itemIndex < 0 || itemIndex >= projection.importcs.paramTypeIds.len:
        panic("typed expr: frozen metadata importc parameter range corrupt")
    return typedExprFrozenProjectionText(projection,
                                          projection.importcs.paramTypeIds[itemIndex])

@borrows
fn typedExprFrozenValidateCallRow(index: TypedExprBuildIndex,
                                   projection: typedExprFrozenMetadataProjection,
                                   declarationRow: int32,
                                   sourcePath: str,
                                   name: str,
                                   returnType: str,
                                   targetSymbol: str,
                                   kind: TypedExprCallDeclarationKind,
                                   scopeRows: typedExprFrozenScopeSoA,
                                   scopeRowIndex: int32,
                                   importcRowIndex: int32): bool =
    if declarationRow < 0 ||
       declarationRow >= typedExprBuildIndexCallDeclarationCount(index) ||
       declarationRow >= index.callDeclarationArities.len ||
       declarationRow >= index.callDeclarationGenericStarts.len ||
       declarationRow >= index.callDeclarationGenericCounts.len ||
       declarationRow >= index.callDeclarationParamStarts.len ||
       declarationRow >= index.callDeclarationParamCounts.len ||
       declarationRow >= index.callDeclarationSignatureLineNumbers.len ||
       declarationRow >= index.callDeclarationKinds.len ||
       declarationRow >= index.callDeclarationResultExprClasses.len ||
       declarationRow >= index.callDeclarationManualConsumePresents.len ||
       declarationRow >=
           index.callDeclarationManualConsumeFunctionDeclarationRows.len ||
       declarationRow >=
           index.callDeclarationManualConsumeTargetParameterOrdinals.len ||
       declarationRow >=
           index.callDeclarationManualConsumeSourceParameterOrdinals.len ||
       declarationRow >=
           index.callDeclarationManualConsumeTargetParameterDeclarationRows.len ||
       declarationRow >=
           index.callDeclarationManualConsumeSourceParameterDeclarationRows.len ||
       declarationRow >= index.callDeclarationManualConsumeTargetTypeIds.len ||
       declarationRow >= index.callDeclarationManualConsumeSourceTypeIds.len ||
       declarationRow >= index.callDeclarationManualConsumeEffectCids.len:
        return false
    var expectedGenericCount: int32
    var expectedParamCount: int32
    if scopeRowIndex >= 0:
        expectedGenericCount = scopeRows.genericCounts[scopeRowIndex]
        expectedParamCount = scopeRows.paramCounts[scopeRowIndex]
    else:
        expectedGenericCount = 0
        expectedParamCount = projection.importcs.paramCounts[importcRowIndex]
    var expectedExprClass = TypedExprExprUnknown
    if scopeRowIndex >= 0:
        expectedExprClass = scopeRows.borrowResults[scopeRowIndex] ?
            TypedExprExprBorrowed : TypedExprExprOwned
    elif projection.importcs.ffiOwnedResultPresents[importcRowIndex]:
        expectedExprClass = TypedExprExprOwned
    if typedExprBuildIndexCallSourcePath(index, declarationRow) != sourcePath ||
       typedExprBuildIndexCallName(index, declarationRow) != name ||
       index.callDeclarationArities[declarationRow] != expectedParamCount ||
       index.callDeclarationGenericCounts[declarationRow] != expectedGenericCount ||
       index.callDeclarationParamCounts[declarationRow] != expectedParamCount ||
       typedExprBuildIndexCallReturnType(index, declarationRow) != returnType ||
       typedExprBuildIndexCallTargetSymbol(index, declarationRow) != targetSymbol ||
       index.callDeclarationSignatureLineNumbers[declarationRow] !=
           (scopeRowIndex >= 0 ? scopeRows.startLines[scopeRowIndex] : 0) ||
       index.callDeclarationKinds[declarationRow] != kind ||
       index.callDeclarationResultExprClasses[declarationRow] !=
           expectedExprClass:
        return false
    if scopeRowIndex >= 0:
        if index.callDeclarationManualConsumePresents[declarationRow] !=
               scopeRows.manualConsumePresents[scopeRowIndex] ||
           index.callDeclarationManualConsumeFunctionDeclarationRows[
               declarationRow] !=
               scopeRows.manualConsumeFunctionDeclarationRows[scopeRowIndex] ||
           index.callDeclarationManualConsumeTargetParameterOrdinals[
               declarationRow] !=
               scopeRows.manualConsumeTargetParameterOrdinals[scopeRowIndex] ||
           index.callDeclarationManualConsumeSourceParameterOrdinals[
               declarationRow] !=
               scopeRows.manualConsumeSourceParameterOrdinals[scopeRowIndex] ||
           index.callDeclarationManualConsumeTargetParameterDeclarationRows[
               declarationRow] !=
               scopeRows.manualConsumeTargetParameterDeclarationRows[
                   scopeRowIndex] ||
           index.callDeclarationManualConsumeSourceParameterDeclarationRows[
               declarationRow] !=
               scopeRows.manualConsumeSourceParameterDeclarationRows[
                   scopeRowIndex] ||
           index.callDeclarationManualConsumeTargetTypeIds[declarationRow] !=
               scopeRows.manualConsumeTargetTypeIds[scopeRowIndex] ||
           index.callDeclarationManualConsumeSourceTypeIds[declarationRow] !=
               scopeRows.manualConsumeSourceTypeIds[scopeRowIndex] ||
           !layout.FixedBytes32Equal(
               index.callDeclarationManualConsumeEffectCids[declarationRow],
               scopeRows.manualConsumeEffectCids[scopeRowIndex]):
            return false
    elif !typedExprManualConsumeEffectAbsent(
             index.callDeclarationManualConsumePresents[declarationRow],
             index.callDeclarationManualConsumeFunctionDeclarationRows[
                 declarationRow],
             index.callDeclarationManualConsumeTargetParameterOrdinals[
                 declarationRow],
             index.callDeclarationManualConsumeSourceParameterOrdinals[
                 declarationRow],
             index.callDeclarationManualConsumeTargetParameterDeclarationRows[
                 declarationRow],
             index.callDeclarationManualConsumeSourceParameterDeclarationRows[
                 declarationRow],
             index.callDeclarationManualConsumeTargetTypeIds[declarationRow],
             index.callDeclarationManualConsumeSourceTypeIds[declarationRow],
             index.callDeclarationManualConsumeEffectCids[declarationRow]):
        return false
    let genericStart = index.callDeclarationGenericStarts[declarationRow]
    if genericStart < 0 || expectedGenericCount < 0 ||
       genericStart > typedExprBuildIndexCallGenericNameCount(index) - expectedGenericCount:
        return false
    for genericIndex in 0..<expectedGenericCount:
        if typedExprBuildIndexCallGenericName(share(index),
                                              genericStart + genericIndex) !=
           typedExprFrozenScopeGenericName(projection,
                                           scopeRows,
                                           scopeRowIndex,
                                           genericIndex):
            return false
    let paramStart = index.callDeclarationParamStarts[declarationRow]
    if paramStart < 0 || expectedParamCount < 0 ||
       paramStart > typedExprBuildIndexCallParamCount(index) - expectedParamCount:
        return false
    for paramIndex in 0..<expectedParamCount:
        var expected = ""
        if scopeRowIndex >= 0:
            expected = typedExprFrozenScopeParamText(projection,
                                                      scopeRows,
                                                      scopeRowIndex,
                                                      paramIndex)
        else:
            expected = typedExprFrozenImportcParamText(projection,
                                                        importcRowIndex,
                                                        paramIndex)
        if typedExprBuildIndexCallParamType(index,
                                             paramStart + paramIndex) != expected:
            return false
    return true

@borrows
fn typedExprFrozenValidateCallRows(index: TypedExprBuildIndex,
                                    projection: typedExprFrozenMetadataProjection,
                                    err: var str): bool =
    var declarationBase: int32
    var genericBase: int32
    var parameterBase: int32
    for contextIndex in 0..<projection.rawSourcePathIds.len:
        let sourcePath = typedExprFrozenProjectionText(projection,
                                                        projection.normalizedSourcePathIds[contextIndex])
        let declarationCount = TypedExprBuildIndexContextDomainCount(index,
                                                                      contextIndex,
                                                                      6)
        let parameterCount = TypedExprBuildIndexContextDomainCount(index,
                                                                    contextIndex,
                                                                    7)
        var localDeclaration: int32
        var localGenerics: int32
        var localParameters: int32
        var authorityRows = projection.scopes
        if projection.signatures.contextCounts[contextIndex] > 0:
            authorityRows = projection.signatures
        let scopeStart = authorityRows.contextStarts[contextIndex]
        let scopeCount = authorityRows.contextCounts[contextIndex]
        for localIndex in 0..<scopeCount:
            let rowIndex = scopeStart + localIndex
            let name = typedExprFrozenProjectionText(projection,
                                                       authorityRows.nameIds[rowIndex])
            let returnType = typedExprFrozenProjectionText(projection,
                                                             authorityRows.returnTypeIds[rowIndex])
            let declarationRow = declarationBase + localDeclaration
            if declarationRow < 0 ||
               declarationRow >=
                   index.callDeclarationProducerSourceIndexes.len ||
               declarationRow >=
                   index.callDeclarationProducerDeclarationOrdinals.len ||
               declarationRow >=
                   index.callDeclarationProducerFunctionRows.len ||
               index.callDeclarationProducerSourceIndexes[declarationRow] !=
                   contextIndex ||
               index.callDeclarationProducerDeclarationOrdinals[
                   declarationRow] !=
                   authorityRows.producerDeclarationOrdinals[rowIndex] ||
               index.callDeclarationProducerFunctionRows[
                   declarationRow] != localIndex:
                err = Fmt" typed expr: frozen metadata function producer coordinate differs from build index context_index={contextIndex} row={localIndex}"
                return false
            if !typedExprFrozenValidateCallRow(index,
                                                projection,
                                                declarationRow,
                                                sourcePath,
                                                name,
                                                returnType,
                                                name,
                                                TypedExprCallDeclarationFunction,
                                                authorityRows,
                                                rowIndex,
                                                -1):
                err = Fmt" typed expr: frozen metadata function declaration differs from build index context_index={contextIndex} row={localIndex}"
                return false
            localDeclaration = localDeclaration + 1
            localGenerics = localGenerics + authorityRows.genericCounts[rowIndex]
            localParameters = localParameters + authorityRows.paramCounts[rowIndex]
        let importcStart = projection.importcs.contextStarts[contextIndex]
        let importcCount = projection.importcs.contextCounts[contextIndex]
        for localIndex in 0..<importcCount:
            let rowIndex = importcStart + localIndex
            let name = typedExprFrozenProjectionText(projection,
                                                       projection.importcs.nameIds[rowIndex])
            let target = typedExprFrozenProjectionText(projection,
                                                         projection.importcs.targetIds[rowIndex])
            let returnType = typedExprFrozenProjectionText(projection,
                                                             projection.importcs.returnTypeIds[rowIndex])
            let declarationRow = declarationBase + localDeclaration
            if declarationRow < 0 ||
               declarationRow >=
                   index.callDeclarationProducerSourceIndexes.len ||
               declarationRow >=
                   index.callDeclarationProducerDeclarationOrdinals.len ||
               declarationRow >=
                   index.callDeclarationProducerFunctionRows.len ||
               index.callDeclarationProducerSourceIndexes[declarationRow] !=
                   contextIndex ||
               index.callDeclarationProducerDeclarationOrdinals[
                   declarationRow] !=
                   projection.importcs.producerDeclarationOrdinals[rowIndex] ||
               index.callDeclarationProducerFunctionRows[
                   declarationRow] != -1:
                err = Fmt" typed expr: frozen metadata importc producer coordinate differs from build index context_index={contextIndex} row={localIndex}"
                return false
            if !typedExprFrozenValidateCallRow(index,
                                                projection,
                                                declarationRow,
                                                sourcePath,
                                                name,
                                                returnType,
                                                target,
                                                TypedExprCallDeclarationImportc,
                                                typedExprFrozenScopeSoA(),
                                                -1,
                                                rowIndex):
                err = Fmt" typed expr: frozen metadata importc declaration differs from build index context_index={contextIndex} row={localIndex}"
                return false
            localDeclaration = localDeclaration + 1
            localParameters = localParameters + projection.importcs.paramCounts[rowIndex]
        if localDeclaration != declarationCount ||
           localParameters != parameterCount:
            err = Fmt" typed expr: frozen metadata call domain differs from build index context_index={contextIndex}"
            return false
        declarationBase = declarationBase + declarationCount
        genericBase = genericBase + localGenerics
        parameterBase = parameterBase + parameterCount
    if declarationBase != typedExprBuildIndexCallDeclarationCount(index) ||
       genericBase != typedExprBuildIndexCallGenericNameCount(index) ||
       parameterBase != typedExprBuildIndexCallParamCount(index):
        err = " typed expr: frozen metadata call declaration cardinality differs from build index"
        return false
    err = ""
    return true

type
    typedExprFrozenProjAcc = ref object
        rawSourcePathIds: langintern.InternId[]
        normalizedSourcePathIds: langintern.InternId[]
        packageOwnerIds: langintern.InternId[]
        snapshotOnly: bool[]
        contextBuildEntryIndexes: int32[]
        sourceIndexProducerFullTraversalCounts: int32[]
        sourceByteLengths: int32[]
        sourceLineStarts: int32[]
        sourceLineCounts: int32[]
        sourceLineByteStarts: int32[]
        sourceLineByteLengths: int32[]
        sourceLineOverrideIndexes: int32[]
        sourceLineOverrideTexts: str[]
        globalBindingStarts: int32[]
        globalBindingLineNumbers: int32[]
        globalBindingNameIds: langintern.InternId[]
        globalBindingTypeIds: langintern.InternId[]
        globalBindingProducerSourceIndexes: int32[]
        globalBindingDeclarationSourceLocalRows: int32[]
        globalBindingMutableFlags: bool[]
        globalBindingInitValueIds: langintern.InternId[]
        globalBindingCounts: int32[]

@borrows
fn typedExprFrozenProjAppendLinesRec(
        ctx: var TypedExprSourceContext,
        acc: typedExprFrozenProjAcc,
        contextIndex: int32,
        lineCount: int32,
        lineIndex: int32,
        overrideCursor: var int32,
        err: var str): bool =
    while true:
        if lineIndex >= lineCount:
            return true
        let byteStart = ctx.sourceLineByteStarts[lineIndex]
        let byteLength = TypedExprSourceContextLineByteLength(ctx, lineIndex)
        var previousByteLength: int32
        if lineIndex > 0:
            previousByteLength =
                TypedExprSourceContextLineByteLength(ctx, lineIndex - 1)
        if byteStart < 0 || byteLength < 0 ||
           byteStart > ctx.sourceByteLength ||
           byteLength > ctx.sourceByteLength - byteStart ||
           (lineIndex == 0 && byteStart != 0) ||
           (lineIndex > 0 &&
            (ctx.sourceLineByteStarts[lineIndex - 1] < 0 ||
             ctx.sourceLineByteStarts[lineIndex - 1] >=
                 ctx.sourceByteLength ||
             previousByteLength < 0 ||
             previousByteLength >
                 ctx.sourceByteLength -
                     ctx.sourceLineByteStarts[lineIndex - 1] - 1 ||
             byteStart !=
                 ctx.sourceLineByteStarts[lineIndex - 1] +
                     previousByteLength + 1)) ||
           (lineIndex + 1 == lineCount &&
            byteLength != ctx.sourceByteLength - byteStart):
            err = Fmt" typed expr: frozen metadata source line byte range invalid context_index={contextIndex} line={lineIndex + 1} start={byteStart} length={byteLength} source_bytes={ctx.sourceByteLength}"
            return false
        add(acc.sourceLineByteStarts, byteStart)
        add(acc.sourceLineByteLengths, byteLength)
        var overrideIndex: int32 = -1
        if ctx.sourceLineOverrideIndexes.len > 0:
            overrideIndex = ctx.sourceLineOverrideIndexes[lineIndex]
        if overrideIndex < 0:
            add(acc.sourceLineOverrideIndexes, -1)
        else:
            if overrideIndex != overrideCursor ||
               overrideIndex >= ctx.sourceLineOverrideTexts.len:
                err = Fmt" typed expr: frozen metadata source line override out of range context_index={contextIndex} line={lineIndex + 1} override={overrideIndex} overrides={ctx.sourceLineOverrideTexts.len}"
                return false
            add(acc.sourceLineOverrideIndexes, acc.sourceLineOverrideTexts.len)
            add(acc.sourceLineOverrideTexts,
                strings.CloneStr(ctx.sourceLineOverrideTexts[overrideIndex]))
            overrideCursor = overrideCursor + 1
        lineIndex = lineIndex + 1

@borrows
fn typedExprFrozenProjAppendGlobalsRec(
        ctx: var TypedExprSourceContext,
        projection: var typedExprFrozenMetadataProjection,
        acc: typedExprFrozenProjAcc,
        contextIndex: int32,
        lineCount: int32,
        bindingIndex: int32,
        globalBindingCount: var int32,
        err: var str): bool =
    while true:
        if bindingIndex >= ctx.bindings.len:
            return true
        if !ctx.bindings[bindingIndex].globalFlag:
            bindingIndex = bindingIndex + 1
            continue
        if ctx.bindings[bindingIndex].sourcePath != ctx.sourcePath ||
           ctx.bindings[bindingIndex].functionName != "" ||
           ctx.bindings[bindingIndex].lineNumber <= 0 ||
           ctx.bindings[bindingIndex].lineNumber > lineCount ||
           ctx.bindings[bindingIndex].name == "" ||
           ctx.bindings[bindingIndex].typeText == "":
            err = Fmt" typed expr: frozen metadata global binding invalid context_index={contextIndex} row={bindingIndex}"
            return false
        add(acc.globalBindingLineNumbers, ctx.bindings[bindingIndex].lineNumber)
        add(acc.globalBindingNameIds,
            TypedExprFrozenMetadataProjectionInternText(
                projection.internPool,
                strings.CloneStr(ctx.bindings[bindingIndex].name)))
        add(acc.globalBindingTypeIds,
            TypedExprFrozenMetadataProjectionInternText(
                projection.internPool,
                strings.CloneStr(ctx.bindings[bindingIndex].typeText)))
        add(acc.globalBindingProducerSourceIndexes,
            ctx.bindings[bindingIndex].producerSourceIndex)
        add(acc.globalBindingDeclarationSourceLocalRows,
            ctx.bindings[bindingIndex].declarationSourceLocalRow)
        add(acc.globalBindingMutableFlags, ctx.bindings[bindingIndex].mutableFlag)
        add(acc.globalBindingInitValueIds,
            TypedExprFrozenMetadataProjectionInternText(
                projection.internPool,
                strings.CloneStr(ctx.bindings[bindingIndex].initValueText)))
        globalBindingCount = globalBindingCount + 1
        bindingIndex = bindingIndex + 1

@borrows
fn typedExprContextBuildIndexMismatch(ctx: var TypedExprSourceContext,
                                      index: TypedExprBuildIndex): bool =
    if ctx.buildIndexOwned:
        return true
    return ctx.buildIndex != index

@borrows
fn typedExprFrozenProjPass1One(
        index: TypedExprBuildIndex,
        ctx: var TypedExprSourceContext,
        projection: var typedExprFrozenMetadataProjection,
        acc: typedExprFrozenProjAcc,
        contextIndex: int32,
        err: var str): bool =
    if typedExprContextBuildIndexMismatch(ctx, index):
        err = Fmt" typed expr: frozen metadata build-index ownership mismatch index={contextIndex}"
        return false
    if TypedExprSourceContextHasLocalBuildCaches(ctx):
        err = Fmt" typed expr: frozen metadata source cache not transferred index={contextIndex}"
        return false
    var sourcePathRaw = strings.CloneStr(ctx.normalizedSourcePath)
    if sourcePathRaw == "":
        sourcePathRaw = strings.CloneStr(ctx.sourcePath)
    var sourcePath: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, err):
        err = Fmt" typed expr: frozen metadata source identity invalid index={contextIndex}: {err}"
        return false
    var rawSourcePath = strings.CloneStr(ctx.sourcePath)
    if rawSourcePath == "":
        rawSourcePath = share(sourcePath)
    add(acc.rawSourcePathIds,
        TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(rawSourcePath)))
    add(acc.normalizedSourcePathIds,
        TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(sourcePath)))
    if !typedExprFrozenAppendContextIndex(projection,
                                           sourcePath,
                                           contextIndex,
                                           acc.normalizedSourcePathIds):
        err = Fmt" typed expr: frozen metadata duplicate source identity source={sourcePath} index={contextIndex}"
        return false
    add(acc.packageOwnerIds,
        TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                          strings.CloneStr(ctx.packageOwnerKey)))
    add(acc.snapshotOnly, ctx.snapshotOnly)
    let entryIndex = typedExprFrozenBuildEntryIndex(index,
                                                     "ctx_source",
                                                     sourcePath,
                                                     "",
                                                     "")
    if !typedExprFrozenBuildEntryMatches(index,
                                          entryIndex,
                                          "ctx_source",
                                          sourcePath,
                                          "",
                                          "",
                                          sourcePath,
                                          sourcePath,
                                          true,
                                          contextIndex):
        err = Fmt" typed expr: frozen metadata source differs from build index index={contextIndex}"
        return false
    add(acc.contextBuildEntryIndexes, entryIndex)
    let lineCount = ctx.sourceLineByteStarts.len
    if ctx.sourceIndexProducerFullTraversalCount != 1 ||
       ctx.sourceByteLength < 0 ||
       ctx.sourceLineCount != lineCount ||
       (ctx.sourceLineByteLengths.len != 0 &&
        ctx.sourceLineByteLengths.len != lineCount) ||
       (ctx.sourceLineOverrideTexts.len == 0 &&
        ctx.sourceLineOverrideIndexes.len != 0) ||
       (ctx.sourceLineOverrideTexts.len > 0 &&
        ctx.sourceLineOverrideIndexes.len != lineCount) ||
       lineCount <= 0:
        err = Fmt" typed expr: frozen metadata source line index columns mismatch context_index={contextIndex} lines={lineCount} source_lines={ctx.sourceLineCount}"
        return false
    add(acc.sourceIndexProducerFullTraversalCounts,
        ctx.sourceIndexProducerFullTraversalCount)
    add(acc.sourceByteLengths, ctx.sourceByteLength)
    add(acc.sourceLineStarts, acc.sourceLineByteStarts.len)
    add(acc.sourceLineCounts, lineCount)
    var contextOverrideCursor: int32
    if !typedExprFrozenProjAppendLinesRec(
           ctx, acc, contextIndex, lineCount, 0, contextOverrideCursor, err):
        return false
    if contextOverrideCursor != ctx.sourceLineOverrideTexts.len:
        err = Fmt" typed expr: frozen metadata source line override tail mismatch context_index={contextIndex} used={contextOverrideCursor} rows={ctx.sourceLineOverrideTexts.len}"
        return false
    add(acc.globalBindingStarts, acc.globalBindingNameIds.len)
    var globalBindingCount: int32
    if !typedExprFrozenProjAppendGlobalsRec(
           ctx, projection, acc, contextIndex, lineCount, 0,
           globalBindingCount, err):
        return false
    add(acc.globalBindingCounts, globalBindingCount)
    return true

@borrows
fn typedExprFrozenProjPass1Rec(
        index: TypedExprBuildIndex,
        contexts: var TypedExprSourceContext[],
        projection: var typedExprFrozenMetadataProjection,
        acc: typedExprFrozenProjAcc,
        contextIndex: int32,
        err: var str): bool =
    while true:
        if contextIndex >= contexts.len:
            return true
        if !typedExprFrozenProjPass1One(
               index, contexts[contextIndex], projection, acc, contextIndex, err):
            return false
        contextIndex = contextIndex + 1
        continue

@borrows
fn typedExprFrozenProjPass2One(
        index: TypedExprBuildIndex,
        ctx: var TypedExprSourceContext,
        projection: var typedExprFrozenMetadataProjection,
        acc: typedExprFrozenProjPass2Acc,
        contextIndex: int32,
        err: var str): bool =
    let sourcePath = typedExprFrozenProjectionText(projection,
                                                    projection.normalizedSourcePathIds[contextIndex])
    add(acc.importcsContextStarts,
        acc.importcsNameIds.len)
    add(acc.importcsContextCounts,
        ctx.importcFunctions.len)
    for itemIndex in 0..<ctx.importcFunctions.len:
        let name = parser.ParserIdentPrefix(chengpath.PathTrim(ctx.importcFunctions[itemIndex].name))
        var target = chengpath.PathTrim(ctx.importcFunctions[itemIndex].importName)
        if target == "":
            target = share(name)
        var returnType = TypedExprNormalizeTypeText(ctx.importcFunctions[itemIndex].returnType)
        if returnType == "":
            returnType = "void"
        if name == "" || target == "":
            err = Fmt" typed expr: frozen metadata importc identity missing context_index={contextIndex} row={itemIndex}"
            return false
        let paramTypes = TypedExprSplitParamTypeJoin(ctx.importcFunctions[itemIndex].paramTypeJoin)
        add(acc.importcsNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        add(acc.importcsProducerDeclarationOrdinals,
            ctx.importcFunctions[itemIndex].producerDeclarationOrdinal)
        add(acc.importcsTargetIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(target)))
        add(acc.importcsReturnTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(returnType)))
        add(acc.importcsParamStarts,
            acc.importcsParamTypeIds.len)
        add(acc.importcsParamCounts, paramTypes.len)
        add(acc.importcsFfiMapPtrArgs, ctx.importcFunctions[itemIndex].ffiMapPtrArg)
        add(acc.importcsFfiMapLenArgs, ctx.importcFunctions[itemIndex].ffiMapLenArg)
        add(acc.importcsFfiOutPtrArgIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(ctx.importcFunctions[itemIndex].ffiOutPtrArgs)))
        add(acc.importcsAbiInternals, ctx.importcFunctions[itemIndex].abiInternal)
        add(acc.importcsFfiOwnedResultPresents,
            ctx.importcFunctions[itemIndex].ffiOwnedResultPresent)
        add(acc.importcsFfiOwnedResultFreeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(ctx.importcFunctions[itemIndex].ffiOwnedResultFree)))
        for paramIndex in 0..<paramTypes.len:
            let paramType = TypedExprNormalizeTypeText(paramTypes[paramIndex])
            if paramType == "":
                err = Fmt" typed expr: frozen metadata importc parameter type missing context_index={contextIndex} row={itemIndex} param={paramIndex}"
                return false
            add(acc.importcsParamTypeIds,
                TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                                  share(paramType)))
    add(acc.importStarts, acc.importQualifierIds.len)
    add(acc.importCounts, ctx.importedModules.len)
    for itemIndex in 0..<ctx.importedModules.len:
        let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(share(ctx.importedModules[itemIndex].qualifier)))
        let targetSourcePath = parser.ParserNormalizePath(ctx.importedModules[itemIndex].targetSourcePath)
        if qualifier == "" || targetSourcePath == "":
            err = Fmt" typed expr: frozen metadata import identity missing context_index={contextIndex} row={itemIndex}"
            return false
        let targetContextIndex = typedExprFrozenContextIndexForPath(
            projection,
            targetSourcePath)
        let entryIndex = typedExprFrozenBuildEntryIndex(index,
                                                         "ctx_import_alias",
                                                         sourcePath,
                                                         qualifier,
                                                         "")
        if !typedExprFrozenBuildEntryMatches(index,
                                              entryIndex,
                                              "ctx_import_alias",
                                              sourcePath,
                                              qualifier,
                                              "",
                                              sourcePath,
                                              targetSourcePath,
                                              true,
                                              targetContextIndex):
            err = Fmt" typed expr: frozen metadata import differs from build index context_index={contextIndex} row={itemIndex}"
            return false
        var targetEntryIndex: int32 = -1
        if targetContextIndex >= 0:
            targetEntryIndex = typedExprFrozenBuildEntryIndex(index,
                                                               "ctx_import_target",
                                                               sourcePath,
                                                               targetSourcePath,
                                                               "")
            if !typedExprFrozenBuildEntryMatches(index,
                                                  targetEntryIndex,
                                                  "ctx_import_target",
                                                  sourcePath,
                                                  targetSourcePath,
                                                  "",
                                                  sourcePath,
                                                  targetSourcePath,
                                                  true,
                                                  targetContextIndex):
                err = Fmt" typed expr: frozen metadata import edge differs from build index context_index={contextIndex} row={itemIndex}"
                return false
        add(acc.importQualifierIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(qualifier)))
        add(acc.importTargetSourcePathIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool,
                              share(targetSourcePath)))
        add(acc.importAllowsUnqualifiedCalls,
            ctx.importedModules[itemIndex].allowsUnqualifiedCall)
        if !typedExprFrozenClaimBuildEntry(acc,
                                            entryIndex):
            err = Fmt" typed expr: frozen metadata duplicate import key context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.importBuildEntryIndexes, entryIndex)
        add(acc.importTargetBuildEntryIndexes, targetEntryIndex)
    add(acc.declaredStarts, acc.declaredTypeIds.len)
    add(acc.declaredCounts, ctx.declaredTypes.len)
    if ctx.declaredTypes.len !=
           ctx.declaredTypeProducerSourceIndexes.len ||
       ctx.declaredTypes.len !=
           ctx.declaredTypeDeclarationSourceLocalRows.len ||
       ctx.declaredTypes.len !=
           ctx.declaredTypeBuiltinKinds.len:
        err = Fmt" typed expr: frozen declared type coordinate columns split context_index={contextIndex}"
        return false
    for itemIndex in 0..<ctx.declaredTypes.len:
        let name = TypedExprTypeLeafName(ctx.declaredTypes[itemIndex])
        let producerSourceIndex =
            ctx.declaredTypeProducerSourceIndexes[itemIndex]
        let declarationSourceLocalRow =
            ctx.declaredTypeDeclarationSourceLocalRows[itemIndex]
        let builtinRaw =
            ctx.declaredTypeBuiltinKinds[itemIndex]
        if builtinRaw < Int32(TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(TypedExprLayoutBuiltinOptional):
            err = Fmt" typed expr: frozen declared type builtin kind invalid context_index={contextIndex} row={itemIndex}"
            return false
        let builtinKind = TypedExprLayoutBuiltinKind(
            builtinRaw)
        if producerSourceIndex < 0 ||
           ((builtinKind == TypedExprLayoutBuiltinNone) !=
            (declarationSourceLocalRow >= 0)):
            err = Fmt" typed expr: frozen declared type exact coordinate missing context_index={contextIndex} row={itemIndex}"
            return false
        let entryIndex = typedExprFrozenBuildEntryIndex(index,
                                                         "ctx_declared_source",
                                                         sourcePath,
                                                         name,
                                                         "")
        if name == "" || !typedExprFrozenBuildEntryMatches(index,
                                                             entryIndex,
                                                             "ctx_declared_source",
                                                             sourcePath,
                                                             name,
                                                             "",
                                                             sourcePath,
                                                             name,
                                                             true,
                                                             contextIndex):
            err = Fmt" typed expr: frozen metadata declared type differs from build index context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.declaredTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        add(acc.declaredTypeProducerSourceIndexes,
            producerSourceIndex)
        add(acc.declaredTypeDeclarationSourceLocalRows,
            declarationSourceLocalRow)
        add(acc.declaredTypeBuiltinKinds,
            Int32(builtinKind))
        if !typedExprFrozenClaimBuildEntry(acc,
                                            entryIndex):
            err = Fmt" typed expr: frozen metadata duplicate declared key context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.declaredBuildEntryIndexes, entryIndex)
    add(acc.refStarts, acc.refTypeIds.len)
    add(acc.refCounts, ctx.refTypes.len)
    for itemIndex in 0..<ctx.refTypes.len:
        let name = TypedExprTypeLeafName(ctx.refTypes[itemIndex])
        let entryIndex = typedExprFrozenBuildEntryIndex(index,
                                                         "ctx_ref_source",
                                                         sourcePath,
                                                         name,
                                                         "")
        if name == "" || !typedExprFrozenBuildEntryMatches(index,
                                                             entryIndex,
                                                             "ctx_ref_source",
                                                             sourcePath,
                                                             name,
                                                             "",
                                                             sourcePath,
                                                             name,
                                                             true,
                                                             contextIndex):
            err = Fmt" typed expr: frozen metadata ref type differs from build index context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.refTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        if !typedExprFrozenClaimBuildEntry(acc,
                                            entryIndex):
            err = Fmt" typed expr: frozen metadata duplicate ref key context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.refBuildEntryIndexes, entryIndex)
    if ctx.typeDefAliasNames.len != ctx.typeDefAliasTargetTypes.len:
        err = Fmt" typed expr: frozen metadata alias columns mismatch context_index={contextIndex}"
        return false
    add(acc.aliasStarts, acc.aliasNameIds.len)
    add(acc.aliasCounts, ctx.typeDefAliasNames.len)
    for itemIndex in 0..<ctx.typeDefAliasNames.len:
        let name = parser.ParserIdentPrefix(chengpath.PathTrim(ctx.typeDefAliasNames[itemIndex]))
        let target = TypedExprNormalizeTypeText(ctx.typeDefAliasTargetTypes[itemIndex])
        let entryIndex = typedExprFrozenBuildEntryIndex(index,
                                                         "ctx_alias_source",
                                                         sourcePath,
                                                         name,
                                                         "")
        if name == "" || target == "" ||
           !typedExprFrozenBuildEntryMatches(index,
                                              entryIndex,
                                              "ctx_alias_source",
                                              sourcePath,
                                              name,
                                              "",
                                              sourcePath,
                                              target,
                                              true,
                                              contextIndex):
            err = Fmt" typed expr: frozen metadata alias differs from build index context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.aliasNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        add(acc.aliasTargetTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(target)))
        if !typedExprFrozenClaimBuildEntry(acc,
                                            entryIndex):
            err = Fmt" typed expr: frozen metadata duplicate alias key context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.aliasBuildEntryIndexes, entryIndex)
    add(acc.fieldStarts, acc.fieldOwnerTypeIds.len)
    add(acc.fieldCounts, ctx.typeFields.len)
    for itemIndex in 0..<ctx.typeFields.len:
        let ownerType = TypedExprTypeLeafName(strings.CloneStr(ctx.typeFields[itemIndex].ownerType))
        let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(strings.CloneStr(ctx.typeFields[itemIndex].fieldName)))
        let fieldType = TypedExprNormalizeTypeText(strings.CloneStr(ctx.typeFields[itemIndex].fieldType))
        let fieldProducerSourceIndex = ctx.typeFields[itemIndex].producerSourceIndex
        let fieldOrdinal = ctx.typeFields[itemIndex].ordinal
        let fieldBuiltinKind = ctx.typeFields[itemIndex].builtinKind
        let fieldOwnerDeclRow = ctx.typeFields[itemIndex].ownerDeclarationSourceLocalRow
        let fieldDeclRow = ctx.typeFields[itemIndex].fieldDeclarationSourceLocalRow
        let fieldOffsetBytesValue = ctx.typeFields[itemIndex].offsetBytes
        let fieldSizeBytesValue = ctx.typeFields[itemIndex].sizeBytes
        let fieldAlignBytesValue = ctx.typeFields[itemIndex].alignBytes
        if fieldProducerSourceIndex < 0 ||
           fieldOrdinal < 0 ||
           ((fieldBuiltinKind == TypedExprLayoutBuiltinNone) !=
            (fieldOwnerDeclRow >= 0 &&
             fieldDeclRow >= 0)):
            err = Fmt" typed expr: frozen field exact coordinate missing context_index={contextIndex} row={itemIndex}"
            return false
        let entryIndex = typedExprFrozenBuildEntryIndex(index,
                                                         "ctx_field_source",
                                                         sourcePath,
                                                         ownerType,
                                                         fieldName)
        if entryIndex < 0 || entryIndex >= index.entryValueIndexes.len:
            err = Fmt" typed expr: frozen metadata field entry missing context_index={contextIndex} row={itemIndex}"
            return false
        let nodeIndex = index.entryValueIndexes[entryIndex]
        if ownerType == "" || fieldName == "" || fieldType == "" ||
           !typedExprFrozenBuildEntryMatches(index,
                                              entryIndex,
                                              "ctx_field_source",
                                              sourcePath,
                                              ownerType,
                                              fieldName,
                                              sourcePath,
                                              fieldType,
                                              true,
                                              nodeIndex) ||
           nodeIndex < 0 ||
           nodeIndex >= index.contextFieldNodeContextIndexes.len ||
           nodeIndex >= index.contextFieldNodeRowIndexes.len ||
           nodeIndex >= index.contextFieldNodeDeclaredOffsetBytes.len ||
           nodeIndex >= index.contextFieldNodeDeclaredSizeBytes.len ||
           nodeIndex >= index.contextFieldNodeDeclaredAlignBytes.len ||
           index.contextFieldNodeContextIndexes[nodeIndex] != contextIndex ||
           index.contextFieldNodeRowIndexes[nodeIndex] != itemIndex ||
           index.contextFieldNodeDeclaredOffsetBytes[nodeIndex] != fieldOffsetBytesValue ||
           index.contextFieldNodeDeclaredSizeBytes[nodeIndex] != fieldSizeBytesValue ||
           index.contextFieldNodeDeclaredAlignBytes[nodeIndex] != fieldAlignBytesValue:
            err = Fmt" typed expr: frozen metadata field differs from build index context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.fieldOwnerTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(ownerType)))
        add(acc.fieldNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(fieldName)))
        add(acc.fieldTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(fieldType)))
        add(acc.fieldOffsetBytes, fieldOffsetBytesValue)
        add(acc.fieldSizeBytes, fieldSizeBytesValue)
        add(acc.fieldAlignBytes, fieldAlignBytesValue)
        add(acc.fieldProducerSourceIndexes,
            fieldProducerSourceIndex)
        add(acc.fieldOwnerDeclarationSourceLocalRows,
            fieldOwnerDeclRow)
        add(acc.fieldDeclarationSourceLocalRows,
            fieldDeclRow)
        add(acc.fieldOrdinals, fieldOrdinal)
        add(acc.fieldBuiltinKinds,
            Int32(fieldBuiltinKind))
        if !typedExprFrozenClaimBuildEntry(acc,
                                            entryIndex):
            err = Fmt" typed expr: frozen metadata duplicate field key context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.fieldBuildEntryIndexes, entryIndex)
        add(acc.fieldBuildNodeIndexes, nodeIndex)
    if ctx.enumValueNames.len != ctx.enumValueTypes.len ||
       ctx.enumValueNames.len != ctx.enumValueOrdinals.len:
        err = Fmt" typed expr: frozen metadata enum columns mismatch context_index={contextIndex}"
        return false
    add(acc.enumStarts, acc.enumNameIds.len)
    add(acc.enumCounts, ctx.enumValueNames.len)
    for itemIndex in 0..<ctx.enumValueNames.len:
        let name = strings.CloneStr(ctx.enumValueNames[itemIndex])
        let typeName = TypedExprTypeLeafName(ctx.enumValueTypes[itemIndex])
        let ordinal = ctx.enumValueOrdinals[itemIndex]
        let nameEntryIndex = typedExprFrozenBuildEntryIndex(index,
                                                             "ctx_enum_name_source",
                                                             sourcePath,
                                                             name,
                                                             "")
        let typeEntryIndex = typedExprFrozenBuildEntryIndex(index,
                                                             "ctx_enum_name_type_source",
                                                             sourcePath,
                                                             name,
                                                             "")
        if name == "" || typeName == "" ||
           !typedExprFrozenBuildEntryMatches(index,
                                              nameEntryIndex,
                                              "ctx_enum_name_source",
                                              sourcePath,
                                              name,
                                              "",
                                              sourcePath,
                                              "",
                                              false,
                                              ordinal) ||
           !typedExprFrozenBuildEntryMatches(index,
                                              typeEntryIndex,
                                              "ctx_enum_name_type_source",
                                              sourcePath,
                                              name,
                                              "",
                                              sourcePath,
                                              typeName,
                                              true,
                                              contextIndex):
            err = Fmt" typed expr: frozen metadata enum differs from build index context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.enumNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        add(acc.enumTypeIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(typeName)))
        add(acc.enumOrdinals, ordinal)
        if !typedExprFrozenClaimBuildEntry(acc,
                                            nameEntryIndex):
            err = Fmt" typed expr: frozen metadata duplicate enum key context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.enumNameBuildEntryIndexes, nameEntryIndex)
        add(acc.enumTypeBuildEntryIndexes, typeEntryIndex)
    add(acc.moduleConstStarts, acc.moduleConstNameIds.len)
    add(acc.moduleConstCounts, ctx.moduleConstNames.len)
    if ctx.moduleConstNames.len != ctx.moduleConstLiterals.len:
        err = Fmt" typed expr: frozen metadata module const columns mismatch context_index={contextIndex}"
        return false
    for itemIndex in 0..<ctx.moduleConstNames.len:
        let name = strings.CloneStr(ctx.moduleConstNames[itemIndex])
        let literal = strings.CloneStr(ctx.moduleConstLiterals[itemIndex])
        let entryIndex = typedExprFrozenBuildEntryIndex(index,
                                                         "ctx_module_const_source",
                                                         sourcePath,
                                                         name,
                                                         "")
        if name == "" || literal == "" ||
           !typedExprFrozenBuildEntryMatches(index,
                                              entryIndex,
                                              "ctx_module_const_source",
                                              sourcePath,
                                              name,
                                              "",
                                              sourcePath,
                                              literal,
                                              true,
                                              0):
            err = Fmt" typed expr: frozen metadata module const differs from build index context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.moduleConstNameIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(name)))
        add(acc.moduleConstLiteralIds,
            TypedExprFrozenMetadataProjectionInternText(projection.internPool, share(literal)))
        if !typedExprFrozenClaimBuildEntry(acc,
                                            entryIndex):
            err = Fmt" typed expr: frozen metadata duplicate module const key context_index={contextIndex} row={itemIndex}"
            return false
        add(acc.moduleConstBuildEntryIndexes, entryIndex)
    let metadataRowCount = typedExprSourceContextMetadataRowCount(
        ctx)
    add(acc.contextMetadataRowCounts, metadataRowCount)
    if TypedExprBuildIndexContextDomainCount(index, contextIndex, 0) != ctx.importedModules.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 1) != ctx.declaredTypes.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 2) != ctx.refTypes.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 3) != ctx.typeDefAliasNames.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 4) != ctx.enumValueNames.len ||
       TypedExprBuildIndexContextDomainCount(index, contextIndex, 5) != ctx.typeFields.len:
        err = Fmt" typed expr: frozen metadata domain counts differ from build index context_index={contextIndex}"
        return false
    return true

@borrows
fn typedExprFrozenProjPass2Rec(
        index: TypedExprBuildIndex,
        contexts: var TypedExprSourceContext[],
        projection: var typedExprFrozenMetadataProjection,
        acc: typedExprFrozenProjPass2Acc,
        contextIndex: int32,
        err: var str): bool =
    while true:
        if contextIndex >= contexts.len:
            err = ""
            return true
        if !typedExprFrozenProjPass2One(index, contexts[contextIndex], projection, acc, contextIndex, err):
            return false
        contextIndex = contextIndex + 1
        continue

@borrows
fn typedExprBuildFrozenMetadataProjection(index: TypedExprBuildIndex,
                                           contexts: var TypedExprSourceContext[],
                                           projection: var typedExprFrozenMetadataProjection,
                                           err: var str): bool =
    projection = new(typedExprFrozenMetadataProjection)
    projection.internPool = langintern.InternPoolNew()
    projection.contextBucketHeads = TypedExprBuildIndexEmptyBuckets(
        typedExprCheckedAddInt32(contexts.len, 8,
                                 "canonical_context_bucket_capacity"))
    var claimedBits: bool[]
    typedExprFrozenClaimedFalseRec(claimedBits, index.entryKinds.len, 0)
    var acc: typedExprFrozenProjAcc = new(typedExprFrozenProjAcc)
    var acc2: typedExprFrozenProjPass2Acc = new(typedExprFrozenProjPass2Acc)
    acc2.claimed = claimedBits
    if !typedExprFrozenProjPass1Rec(index, contexts, projection, acc, 0, err):
        return false
    projection.rawSourcePathIds = acc.rawSourcePathIds
    projection.normalizedSourcePathIds = acc.normalizedSourcePathIds
    projection.packageOwnerIds = acc.packageOwnerIds
    projection.snapshotOnly = acc.snapshotOnly
    projection.contextBuildEntryIndexes = acc.contextBuildEntryIndexes
    projection.sourceIndexProducerFullTraversalCounts = acc.sourceIndexProducerFullTraversalCounts
    projection.sourceByteLengths = acc.sourceByteLengths
    projection.sourceLineStarts = acc.sourceLineStarts
    projection.sourceLineCounts = acc.sourceLineCounts
    projection.sourceLineByteStarts = acc.sourceLineByteStarts
    projection.sourceLineByteLengths = acc.sourceLineByteLengths
    # An all-(-1) projection override column is pure overhead when no source
    # owns override text: readers synthesize -1 on an absent column.
    if acc.sourceLineOverrideTexts.len == 0:
        seqs.freeSeq_int32(acc.sourceLineOverrideIndexes)
        acc.sourceLineOverrideIndexes = []
    projection.sourceLineOverrideIndexes = acc.sourceLineOverrideIndexes
    projection.sourceLineOverrideTexts = acc.sourceLineOverrideTexts
    projection.globalBindingStarts = acc.globalBindingStarts
    projection.globalBindingLineNumbers = acc.globalBindingLineNumbers
    projection.globalBindingNameIds = acc.globalBindingNameIds
    projection.globalBindingTypeIds = acc.globalBindingTypeIds
    projection.globalBindingProducerSourceIndexes = acc.globalBindingProducerSourceIndexes
    projection.globalBindingDeclarationSourceLocalRows = acc.globalBindingDeclarationSourceLocalRows
    projection.globalBindingMutableFlags = acc.globalBindingMutableFlags
    projection.globalBindingInitValueIds = acc.globalBindingInitValueIds
    projection.globalBindingCounts = acc.globalBindingCounts
    if !typedExprFrozenProjAppendScopesRec(contexts, projection, 0, err):
        return false
    if !typedExprFrozenProjPass2Rec(index, contexts, projection, acc2, 0, err):
        return false
    projection.importcs.contextStarts = acc2.importcsContextStarts
    projection.importcs.contextCounts = acc2.importcsContextCounts
    projection.importcs.nameIds = acc2.importcsNameIds
    projection.importcs.producerDeclarationOrdinals = acc2.importcsProducerDeclarationOrdinals
    projection.importcs.targetIds = acc2.importcsTargetIds
    projection.importcs.returnTypeIds = acc2.importcsReturnTypeIds
    projection.importcs.paramStarts = acc2.importcsParamStarts
    projection.importcs.paramCounts = acc2.importcsParamCounts
    projection.importcs.paramTypeIds = acc2.importcsParamTypeIds
    projection.importcs.ffiMapPtrArgs = acc2.importcsFfiMapPtrArgs
    projection.importcs.ffiMapLenArgs = acc2.importcsFfiMapLenArgs
    projection.importcs.ffiOutPtrArgIds = acc2.importcsFfiOutPtrArgIds
    projection.importcs.abiInternals = acc2.importcsAbiInternals
    projection.importcs.ffiOwnedResultPresents = acc2.importcsFfiOwnedResultPresents
    projection.importcs.ffiOwnedResultFreeIds = acc2.importcsFfiOwnedResultFreeIds
    projection.importStarts = acc2.importStarts
    projection.importCounts = acc2.importCounts
    projection.importQualifierIds = acc2.importQualifierIds
    projection.importTargetSourcePathIds = acc2.importTargetSourcePathIds
    projection.importAllowsUnqualifiedCalls = acc2.importAllowsUnqualifiedCalls
    projection.importBuildEntryIndexes = acc2.importBuildEntryIndexes
    projection.importTargetBuildEntryIndexes = acc2.importTargetBuildEntryIndexes
    projection.declaredStarts = acc2.declaredStarts
    projection.declaredCounts = acc2.declaredCounts
    projection.declaredTypeIds = acc2.declaredTypeIds
    projection.declaredTypeProducerSourceIndexes = acc2.declaredTypeProducerSourceIndexes
    projection.declaredTypeDeclarationSourceLocalRows = acc2.declaredTypeDeclarationSourceLocalRows
    projection.declaredTypeBuiltinKinds = acc2.declaredTypeBuiltinKinds
    projection.declaredBuildEntryIndexes = acc2.declaredBuildEntryIndexes
    projection.refStarts = acc2.refStarts
    projection.refCounts = acc2.refCounts
    projection.refTypeIds = acc2.refTypeIds
    projection.refBuildEntryIndexes = acc2.refBuildEntryIndexes
    projection.aliasStarts = acc2.aliasStarts
    projection.aliasCounts = acc2.aliasCounts
    projection.aliasNameIds = acc2.aliasNameIds
    projection.aliasTargetTypeIds = acc2.aliasTargetTypeIds
    projection.aliasBuildEntryIndexes = acc2.aliasBuildEntryIndexes
    projection.fieldStarts = acc2.fieldStarts
    projection.fieldCounts = acc2.fieldCounts
    projection.fieldOwnerTypeIds = acc2.fieldOwnerTypeIds
    projection.fieldNameIds = acc2.fieldNameIds
    projection.fieldTypeIds = acc2.fieldTypeIds
    projection.fieldOffsetBytes = acc2.fieldOffsetBytes
    projection.fieldSizeBytes = acc2.fieldSizeBytes
    projection.fieldAlignBytes = acc2.fieldAlignBytes
    projection.fieldProducerSourceIndexes = acc2.fieldProducerSourceIndexes
    projection.fieldOwnerDeclarationSourceLocalRows = acc2.fieldOwnerDeclarationSourceLocalRows
    projection.fieldDeclarationSourceLocalRows = acc2.fieldDeclarationSourceLocalRows
    projection.fieldOrdinals = acc2.fieldOrdinals
    projection.fieldBuiltinKinds = acc2.fieldBuiltinKinds
    projection.fieldBuildEntryIndexes = acc2.fieldBuildEntryIndexes
    projection.fieldBuildNodeIndexes = acc2.fieldBuildNodeIndexes
    projection.enumStarts = acc2.enumStarts
    projection.enumCounts = acc2.enumCounts
    projection.enumNameIds = acc2.enumNameIds
    projection.enumTypeIds = acc2.enumTypeIds
    projection.enumOrdinals = acc2.enumOrdinals
    projection.enumNameBuildEntryIndexes = acc2.enumNameBuildEntryIndexes
    projection.enumTypeBuildEntryIndexes = acc2.enumTypeBuildEntryIndexes
    projection.moduleConstStarts = acc2.moduleConstStarts
    projection.moduleConstCounts = acc2.moduleConstCounts
    projection.moduleConstNameIds = acc2.moduleConstNameIds
    projection.moduleConstLiteralIds = acc2.moduleConstLiteralIds
    projection.moduleConstBuildEntryIndexes = acc2.moduleConstBuildEntryIndexes
    projection.contextMetadataRowCounts = acc2.contextMetadataRowCounts
    if !typedExprFrozenBuildGlobalBindingIndex(projection, err):
        return false
    if !typedExprFrozenBuildScopeIndex(projection, false, false, "scope", err):
        return false
    if !typedExprFrozenBuildScopeIndex(projection, true, false, "signature", err):
        return false
    if !typedExprFrozenBuildSnapshotScopeIndex(projection, err):
        return false
    if !typedExprFrozenBuildSnapshotImportcIndex(projection, err):
        return false
    if !typedExprFrozenValidateCallRows(index, projection, err):
        return false
    projection.joinedLookupKeyBytes = 0
    err = ""
    return true

@borrows
fn typedExprFrozenParamTypeJoin(projection: typedExprFrozenMetadataProjection,
                                 paramTypeIds: langintern.InternId[],
                                 start: int32,
                                 count: int32): str =
    if start < 0 || count < 0 || start > paramTypeIds.len - count:
        panic("typed expr: frozen metadata parameter range corrupt")
    var items: str[]
    for paramIndex in 0..<count:
        add(items, typedExprFrozenProjectionTextShared(projection, paramTypeIds[start + paramIndex]))
    return strutil.Join(items, ";;")

@borrows
fn typedExprFrozenParamTypeJoinKind(projection: typedExprFrozenMetadataProjection,
                                     useSignatures: bool,
                                     generic: bool,
                                     start: int32,
                                     count: int32): str =
    var items: str[]
    if useSignatures && generic:
        if start < 0 || count < 0 ||
           start > projection.signatures.genericNameIds.len - count:
            panic("typed expr: frozen metadata parameter range corrupt")
        for paramIndex in 0..<count:
            add(items, typedExprFrozenProjectionTextShared(projection, projection.signatures.genericNameIds[start + paramIndex]))
    elif useSignatures:
        if start < 0 || count < 0 ||
           start > projection.signatures.paramTypeIds.len - count:
            panic("typed expr: frozen metadata parameter range corrupt")
        for paramIndex in 0..<count:
            add(items, typedExprFrozenProjectionTextShared(projection, projection.signatures.paramTypeIds[start + paramIndex]))
    elif generic:
        if start < 0 || count < 0 ||
           start > projection.scopes.genericNameIds.len - count:
            panic("typed expr: frozen metadata parameter range corrupt")
        for paramIndex in 0..<count:
            add(items, typedExprFrozenProjectionTextShared(projection, projection.scopes.genericNameIds[start + paramIndex]))
    else:
        if start < 0 || count < 0 ||
           start > projection.scopes.paramTypeIds.len - count:
            panic("typed expr: frozen metadata parameter range corrupt")
        for paramIndex in 0..<count:
            add(items, typedExprFrozenProjectionTextShared(projection, projection.scopes.paramTypeIds[start + paramIndex]))
    return strutil.Join(items, ";;")

@borrows
fn typedExprFrozenImportcParamTypeJoin(projection: typedExprFrozenMetadataProjection,
                                        start: int32,
                                        count: int32): str =
    if start < 0 || count < 0 ||
       start > projection.importcs.paramTypeIds.len - count:
        panic("typed expr: frozen metadata parameter range corrupt")
    var items: str[]
    for paramIndex in 0..<count:
        add(items, typedExprFrozenProjectionTextShared(projection, projection.importcs.paramTypeIds[start + paramIndex]))
    return strutil.Join(items, ";;")

@borrows
fn typedExprFrozenAppendMaterializedScopeRow(
        projection: typedExprFrozenMetadataProjection,
        ctx: var TypedExprSourceContext,
        rowIndex: int32,
        useSignatures: bool) =
    var scope: TypedExprFunctionScope
    scope.sourcePath = ""
    if useSignatures:
        if rowIndex < 0 || rowIndex >= projection.signatures.nameIds.len:
            panic("typed expr: frozen metadata signature row out of range")
        scope.name = typedExprFrozenProjectionTextShared(projection, projection.signatures.nameIds[rowIndex])
        scope.producerDeclarationOrdinal =
            projection.signatures.producerDeclarationOrdinals[rowIndex]
        scope.startLine = projection.signatures.startLines[rowIndex]
        scope.endLine = projection.signatures.endLines[rowIndex]
        scope.returnType = typedExprFrozenProjectionTextShared(projection, projection.signatures.returnTypeIds[rowIndex])
        scope.borrowResult = projection.signatures.borrowResults[rowIndex]
        scope.borrowsArguments =
            projection.signatures.borrowsArguments[rowIndex]
        scope.manualConsumePresent =
            projection.signatures.manualConsumePresents[rowIndex]
        scope.manualConsumeFunctionDeclarationRow =
            projection.signatures.manualConsumeFunctionDeclarationRows[rowIndex]
        scope.manualConsumeTargetParameterOrdinal =
            projection.signatures.manualConsumeTargetParameterOrdinals[rowIndex]
        scope.manualConsumeSourceParameterOrdinal =
            projection.signatures.manualConsumeSourceParameterOrdinals[rowIndex]
        scope.manualConsumeTargetParameterDeclarationRow =
            projection.signatures.manualConsumeTargetParameterDeclarationRows[rowIndex]
        scope.manualConsumeSourceParameterDeclarationRow =
            projection.signatures.manualConsumeSourceParameterDeclarationRows[rowIndex]
        scope.manualConsumeTargetTypeId =
            projection.signatures.manualConsumeTargetTypeIds[rowIndex]
        scope.manualConsumeSourceTypeId =
            projection.signatures.manualConsumeSourceTypeIds[rowIndex]
        scope.manualConsumeEffectCid = layout.FixedBytes32Copy(
            projection.signatures.manualConsumeEffectCids[rowIndex])
        scope.genericNameJoin = typedExprFrozenParamTypeJoinKind(
            projection, true, true,
            projection.signatures.genericStarts[rowIndex],
            projection.signatures.genericCounts[rowIndex])
        scope.paramTypeJoin = typedExprFrozenParamTypeJoinKind(
            projection, true, false,
            projection.signatures.paramStarts[rowIndex],
            projection.signatures.paramCounts[rowIndex])
    else:
        if rowIndex < 0 || rowIndex >= projection.scopes.nameIds.len:
            panic("typed expr: frozen metadata scope row out of range")
        scope.name = typedExprFrozenProjectionTextShared(projection, projection.scopes.nameIds[rowIndex])
        scope.producerDeclarationOrdinal =
            projection.scopes.producerDeclarationOrdinals[rowIndex]
        scope.startLine = projection.scopes.startLines[rowIndex]
        scope.endLine = projection.scopes.endLines[rowIndex]
        scope.returnType = typedExprFrozenProjectionTextShared(projection, projection.scopes.returnTypeIds[rowIndex])
        scope.borrowResult = projection.scopes.borrowResults[rowIndex]
        scope.borrowsArguments =
            projection.scopes.borrowsArguments[rowIndex]
        scope.manualConsumePresent =
            projection.scopes.manualConsumePresents[rowIndex]
        scope.manualConsumeFunctionDeclarationRow =
            projection.scopes.manualConsumeFunctionDeclarationRows[rowIndex]
        scope.manualConsumeTargetParameterOrdinal =
            projection.scopes.manualConsumeTargetParameterOrdinals[rowIndex]
        scope.manualConsumeSourceParameterOrdinal =
            projection.scopes.manualConsumeSourceParameterOrdinals[rowIndex]
        scope.manualConsumeTargetParameterDeclarationRow =
            projection.scopes.manualConsumeTargetParameterDeclarationRows[rowIndex]
        scope.manualConsumeSourceParameterDeclarationRow =
            projection.scopes.manualConsumeSourceParameterDeclarationRows[rowIndex]
        scope.manualConsumeTargetTypeId =
            projection.scopes.manualConsumeTargetTypeIds[rowIndex]
        scope.manualConsumeSourceTypeId =
            projection.scopes.manualConsumeSourceTypeIds[rowIndex]
        scope.manualConsumeEffectCid = layout.FixedBytes32Copy(
            projection.scopes.manualConsumeEffectCids[rowIndex])
        scope.genericNameJoin = typedExprFrozenParamTypeJoinKind(
            projection, false, true,
            projection.scopes.genericStarts[rowIndex],
            projection.scopes.genericCounts[rowIndex])
        scope.paramTypeJoin = typedExprFrozenParamTypeJoinKind(
            projection, false, false,
            projection.scopes.paramStarts[rowIndex],
            projection.scopes.paramCounts[rowIndex])
    scope.genericNamesComplete = true
    scope.paramTypesComplete = true
    if useSignatures:
        add(ctx.signatureScopes, scope)
    else:
        add(ctx.scopes, scope)

@borrows
fn typedExprFrozenAppendMaterializedScopes(projection: typedExprFrozenMetadataProjection,
                                            ctx: var TypedExprSourceContext,
                                            contextIndex: int32,
                                            useSignatures: bool) =
    var start: int32
    var count: int32
    var nameLen: int32
    if useSignatures:
        if contextIndex < 0 ||
           contextIndex >= projection.signatures.contextStarts.len ||
           contextIndex >= projection.signatures.contextCounts.len:
            panic("typed expr: frozen metadata scope context out of range")
        start = projection.signatures.contextStarts[contextIndex]
        count = projection.signatures.contextCounts[contextIndex]
        nameLen = projection.signatures.nameIds.len
    else:
        if contextIndex < 0 ||
           contextIndex >= projection.scopes.contextStarts.len ||
           contextIndex >= projection.scopes.contextCounts.len:
            panic("typed expr: frozen metadata scope context out of range")
        start = projection.scopes.contextStarts[contextIndex]
        count = projection.scopes.contextCounts[contextIndex]
        nameLen = projection.scopes.nameIds.len
    if start < 0 || count < 0 || start > nameLen - count:
        panic("typed expr: frozen metadata scope context out of range")
    for localIndex in 0..<count:
        typedExprFrozenAppendMaterializedScopeRow(projection,
                                                  ctx,
                                                  start + localIndex,
                                                  useSignatures)

@borrows
fn typedExprFrozenMaterializeContext(session: typedExprFrozenMetadataSession,
                                      contextIndex: int32,
                                      includeMetadata: bool,
                                      includeAllScopes: bool,
                                      ctx: var TypedExprSourceContext) =
    let projection = session.projection
    if projection == nil || projection.released ||
       contextIndex < 0 || contextIndex >= projection.rawSourcePathIds.len:
        panic("typed expr: frozen metadata materialize context out of range")
    TypedExprClearSourceContextAllFields(ctx)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), Fmt"O8MAT n={contextIndex}")
    TypedExprSourceContextSetBorrowedBuildIndex(ctx, session.index)
    ctx.frozenMetadataProjection = projection
    ctx.frozenMetadataContextIndex = contextIndex
    ctx.sourcePath = typedExprFrozenProjectionTextShared(projection, projection.rawSourcePathIds[contextIndex])
    ctx.normalizedSourcePath = typedExprFrozenProjectionTextShared(projection, projection.normalizedSourcePathIds[contextIndex])
    ctx.packageOwnerKey = typedExprFrozenProjectionTextShared(projection, projection.packageOwnerIds[contextIndex])
    ctx.snapshotOnly = projection.snapshotOnly[contextIndex]
    ctx.bindingNameIndexBuiltCount = -1
    ctx.scopeNameIndexBuiltCount = -1
    if !includeMetadata:
        # Bindings are the authority (empty here). Immutable Indexed queries
        # require a matching prepared name index.
        TypedExprBindingNameIndexPrepare(ctx)
        return
    let globalBindingStart = projection.globalBindingStarts[contextIndex]
    let globalBindingCount = projection.globalBindingCounts[contextIndex]
    for localIndex in 0..<globalBindingCount:
        let rowIndex = globalBindingStart + localIndex
        var binding: TypedExprBinding
        binding.sourcePath = parser.ParserOwnedText(ctx.sourcePath)
        binding.functionName = ""
        binding.globalFlag = true
        binding.mutableFlag =
            projection.globalBindingMutableFlags[rowIndex]
        binding.producerSourceIndex =
            projection.globalBindingProducerSourceIndexes[rowIndex]
        binding.declarationSourceLocalRow =
            projection.globalBindingDeclarationSourceLocalRows[rowIndex]
        binding.lineNumber =
            projection.globalBindingLineNumbers[rowIndex]
        binding.name = typedExprFrozenProjectionTextShared(projection, projection.globalBindingNameIds[rowIndex])
        binding.typeText = typedExprFrozenProjectionTextShared(projection, projection.globalBindingTypeIds[rowIndex])
        binding.initValueText = typedExprFrozenProjectionTextShared(projection, projection.globalBindingInitValueIds[rowIndex])
        add(ctx.bindings, binding)
    if includeAllScopes:
        typedExprFrozenAppendMaterializedScopes(projection,
                                                 ctx,
                                                 contextIndex,
                                                 false)
        typedExprFrozenAppendMaterializedScopes(projection,
                                                 ctx,
                                                 contextIndex,
                                                 true)
    let importcStart = projection.importcs.contextStarts[contextIndex]
    let importcCount = projection.importcs.contextCounts[contextIndex]
    for localIndex in 0..<importcCount:
        let rowIndex = importcStart + localIndex
        var item: TypedExprImportcFunction
        item.sourcePath = ""
        item.name = typedExprFrozenProjectionTextShared(projection, projection.importcs.nameIds[rowIndex])
        item.producerDeclarationOrdinal =
            projection.importcs.producerDeclarationOrdinals[rowIndex]
        item.importName = typedExprFrozenProjectionTextShared(projection, projection.importcs.targetIds[rowIndex])
        item.returnType = typedExprFrozenProjectionTextShared(projection, projection.importcs.returnTypeIds[rowIndex])
        item.paramTypeJoin = typedExprFrozenImportcParamTypeJoin(
            projection,
            projection.importcs.paramStarts[rowIndex],
            projection.importcs.paramCounts[rowIndex])
        item.ffiMapPtrArg = projection.importcs.ffiMapPtrArgs[rowIndex]
        item.ffiMapLenArg = projection.importcs.ffiMapLenArgs[rowIndex]
        item.ffiOutPtrArgs = typedExprFrozenProjectionTextShared(projection, projection.importcs.ffiOutPtrArgIds[rowIndex])
        item.abiInternal = projection.importcs.abiInternals[rowIndex]
        item.ffiOwnedResultPresent =
            projection.importcs.ffiOwnedResultPresents[rowIndex]
        item.ffiOwnedResultFree = typedExprFrozenProjectionTextShared(projection, projection.importcs.ffiOwnedResultFreeIds[rowIndex])
        add(ctx.importcFunctions, item)
    let importStart = projection.importStarts[contextIndex]
    let importCount = projection.importCounts[contextIndex]
    for localIndex in 0..<importCount:
        let rowIndex = importStart + localIndex
        var item: TypedExprImportedModule
        item.qualifier = typedExprFrozenProjectionTextShared(projection, projection.importQualifierIds[rowIndex])
        item.targetSourcePath = typedExprFrozenProjectionTextShared(projection, projection.importTargetSourcePathIds[rowIndex])
        item.allowsUnqualifiedCall = projection.importAllowsUnqualifiedCalls[rowIndex]
        add(ctx.importedModules, item)
    let declaredStart = projection.declaredStarts[contextIndex]
    for localIndex in 0..<projection.declaredCounts[contextIndex]:
        let rowIndex = declaredStart + localIndex
        add(ctx.declaredTypes, typedExprFrozenProjectionTextShared(projection, projection.declaredTypeIds[rowIndex]))
        add(ctx.declaredTypeProducerSourceIndexes,
            projection.declaredTypeProducerSourceIndexes[rowIndex])
        add(ctx.declaredTypeDeclarationSourceLocalRows,
            projection.declaredTypeDeclarationSourceLocalRows[rowIndex])
        add(ctx.declaredTypeBuiltinKinds,
            projection.declaredTypeBuiltinKinds[rowIndex])
    let refStart = projection.refStarts[contextIndex]
    for localIndex in 0..<projection.refCounts[contextIndex]:
        add(ctx.refTypes, typedExprFrozenProjectionTextShared(projection, projection.refTypeIds[refStart + localIndex]))
    let aliasStart = projection.aliasStarts[contextIndex]
    for localIndex in 0..<projection.aliasCounts[contextIndex]:
        let rowIndex = aliasStart + localIndex
        add(ctx.typeDefAliasNames, typedExprFrozenProjectionTextShared(projection, projection.aliasNameIds[rowIndex]))
        add(ctx.typeDefAliasTargetTypes, typedExprFrozenProjectionTextShared(projection, projection.aliasTargetTypeIds[rowIndex]))
    let fieldStart = projection.fieldStarts[contextIndex]
    for localIndex in 0..<projection.fieldCounts[contextIndex]:
        let rowIndex = fieldStart + localIndex
        var item: TypedExprTypeFieldDecl
        item.ownerType = typedExprFrozenProjectionTextShared(projection, projection.fieldOwnerTypeIds[rowIndex])
        item.fieldName = typedExprFrozenProjectionTextShared(projection, projection.fieldNameIds[rowIndex])
        item.fieldType = typedExprFrozenProjectionTextShared(projection, projection.fieldTypeIds[rowIndex])
        item.producerSourceIndex =
            projection.fieldProducerSourceIndexes[rowIndex]
        item.ownerDeclarationSourceLocalRow =
            projection.fieldOwnerDeclarationSourceLocalRows[rowIndex]
        item.fieldDeclarationSourceLocalRow =
            projection.fieldDeclarationSourceLocalRows[rowIndex]
        item.ordinal = projection.fieldOrdinals[rowIndex]
        item.builtinKind = TypedExprLayoutBuiltinKind(
            projection.fieldBuiltinKinds[rowIndex])
        item.offsetBytes = projection.fieldOffsetBytes[rowIndex]
        item.sizeBytes = projection.fieldSizeBytes[rowIndex]
        item.alignBytes = projection.fieldAlignBytes[rowIndex]
        add(ctx.typeFields, item)
    let enumStart = projection.enumStarts[contextIndex]
    for localIndex in 0..<projection.enumCounts[contextIndex]:
        let rowIndex = enumStart + localIndex
        add(ctx.enumValueNames, typedExprFrozenProjectionTextShared(projection, projection.enumNameIds[rowIndex]))
        add(ctx.enumValueTypes, typedExprFrozenProjectionTextShared(projection, projection.enumTypeIds[rowIndex]))
        add(ctx.enumValueOrdinals,
            projection.enumOrdinals[rowIndex])
    let moduleConstStart = projection.moduleConstStarts[contextIndex]
    for localIndex in 0..<projection.moduleConstCounts[contextIndex]:
        let rowIndex = moduleConstStart + localIndex
        let name = typedExprFrozenProjectionText(
            projection, projection.moduleConstNameIds[rowIndex])
        let literal = typedExprFrozenProjectionText(
            projection, projection.moduleConstLiteralIds[rowIndex])
        if !typedExprFrozenBuildEntryMatches(
                session.index,
                projection.moduleConstBuildEntryIndexes[rowIndex],
                "ctx_module_const_source",
                ctx.normalizedSourcePath,
                name,
                "",
                ctx.normalizedSourcePath,
                literal,
                true,
                0):
            panic("typed expr: frozen metadata materialize module const entry mismatch")
        add(ctx.moduleConstNames, parser.ParserOwnedText(name))
        add(ctx.moduleConstLiterals, parser.ParserOwnedText(literal))
    ctx.moduleConstScanned = true
    ctx.moduleConstLookupFinalized = true
    TypedExprBindingNameIndexPrepare(ctx)

@borrows
fn typedExprFrozenBindRoundContext(
        session: typedExprFrozenMetadataSession,
        contextIndex: int32,
        ctx: var TypedExprSourceContext) =
    let projection = session.projection
    if projection == nil || projection.released ||
       contextIndex < 0 || contextIndex >= projection.rawSourcePathIds.len:
        panic("typed expr: frozen metadata round context out of range")
    TypedExprClearSourceContextAllFields(ctx)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), Fmt"O8BIND n={contextIndex}")
    TypedExprSourceContextSetBorrowedBuildIndex(ctx, session.index)
    ctx.frozenMetadataProjection = projection
    ctx.frozenMetadataContextIndex = contextIndex
    ctx.sourcePath = typedExprFrozenProjectionTextShared(projection, projection.rawSourcePathIds[contextIndex])
    ctx.normalizedSourcePath = typedExprFrozenProjectionTextShared(projection, projection.normalizedSourcePathIds[contextIndex])
    ctx.packageOwnerKey = typedExprFrozenProjectionTextShared(projection, projection.packageOwnerIds[contextIndex])
    ctx.snapshotOnly = projection.snapshotOnly[contextIndex]
    ctx.bindingNameIndexBuiltCount = -1
    ctx.scopeNameIndexBuiltCount = -1
    TypedExprBindingNameIndexPrepare(ctx)

@borrows
fn typedExprContextFieldAt(ctx: TypedExprSourceContext,
                            localIndex: int32,
                            field: var TypedExprTypeFieldDecl): bool =
    let projection = ctx.frozenMetadataProjection
    if projection == nil:
        if localIndex < 0 || localIndex >= ctx.typeFields.len:
            return false
        field = share(ctx.typeFields[localIndex])
        return true
    let contextIndex = ctx.frozenMetadataContextIndex
    if projection.released || contextIndex < 0 ||
       contextIndex >= projection.fieldStarts.len ||
       contextIndex >= projection.fieldCounts.len || localIndex < 0 ||
       localIndex >= projection.fieldCounts[contextIndex]:
        return false
    let rowIndex = projection.fieldStarts[contextIndex] + localIndex
    # These field declarations outlive the round view and can be stored on
    # the IR past the frozen session's dispose, so they keep owned clones;
    # only round-scoped context rows take projection shares.
    field.ownerType = parser.ParserOwnedText(typedExprFrozenProjectionText(projection, projection.fieldOwnerTypeIds[rowIndex]))
    field.fieldName = parser.ParserOwnedText(typedExprFrozenProjectionText(projection, projection.fieldNameIds[rowIndex]))
    field.fieldType = parser.ParserOwnedText(typedExprFrozenProjectionText(projection, projection.fieldTypeIds[rowIndex]))
    field.producerSourceIndex =
        projection.fieldProducerSourceIndexes[rowIndex]
    field.ownerDeclarationSourceLocalRow =
        projection.fieldOwnerDeclarationSourceLocalRows[rowIndex]
    field.fieldDeclarationSourceLocalRow =
        projection.fieldDeclarationSourceLocalRows[rowIndex]
    field.ordinal = projection.fieldOrdinals[rowIndex]
    field.builtinKind = TypedExprLayoutBuiltinKind(
        projection.fieldBuiltinKinds[rowIndex])
    field.offsetBytes = projection.fieldOffsetBytes[rowIndex]
    field.sizeBytes = projection.fieldSizeBytes[rowIndex]
    field.alignBytes = projection.fieldAlignBytes[rowIndex]
    return true

fn typedExprSparseSelectionHash(contextIndex: int32): int32 =
    if contextIndex < 0:
        panic("typed expr: sparse context selection index negative")
    return Int32((Int64(contextIndex) * 1103515245 + 12345) % 2147483647)

@borrows
fn typedExprSparseSelectionFind(selection: typedExprSparseContextSelection,
                                contextIndex: int32): int32 =
    if selection.bucketHeads.len <= 0:
        return -1
    let hashValue = typedExprSparseSelectionHash(contextIndex)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                           selection.bucketHeads.len)
    var itemIndex = selection.bucketHeads[bucket]
    while itemIndex >= 0:
        if itemIndex >= selection.next.len ||
           itemIndex >= selection.contextIndexes.len:
            panic("typed expr: sparse context selection chain corrupt")
        if selection.contextIndexes[itemIndex] == contextIndex:
            return itemIndex
        itemIndex = selection.next[itemIndex]
    return -1

fn typedExprSparseSelectionRehash(selection: var typedExprSparseContextSelection,
                                  minItems: int32) =
    var heads = TypedExprBuildIndexEmptyBuckets(minItems)
    var next: int32[]
    for itemIndex in 0..<selection.contextIndexes.len:
        let hashValue = typedExprSparseSelectionHash(
            selection.contextIndexes[itemIndex])
        let bucket = TypedExprBuildIndexBucket(hashValue, heads.len)
        add(next, heads[bucket])
        heads[bucket] = itemIndex
    selection.bucketHeads = heads
    selection.next = next

fn typedExprSparseSelectionAdd(selection: var typedExprSparseContextSelection,
                               contextIndex: int32,
                               includeMetadata: bool): bool =
    if contextIndex < 0:
        panic("typed expr: sparse context selection add out of range")
    let existing = typedExprSparseSelectionFind(selection, contextIndex)
    if existing >= 0:
        if includeMetadata && !selection.includeMetadata[existing]:
            selection.includeMetadata[existing] = true
        return false
    if selection.bucketHeads.len <= 0:
        selection.bucketHeads = TypedExprBuildIndexEmptyBuckets(8)
    let nextItems = typedExprCheckedAdd64(
        Int64(selection.contextIndexes.len), 1,
        "sparse_context_selection_items")
    if typedExprCheckedMul64(nextItems, 4,
                             "sparse_context_selection_items") >=
       typedExprCheckedMul64(Int64(selection.bucketHeads.len), 3,
                             "sparse_context_selection_buckets"):
        typedExprSparseSelectionRehash(selection,
                                       selection.bucketHeads.len)
    let hashValue = typedExprSparseSelectionHash(contextIndex)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                           selection.bucketHeads.len)
    let itemIndex = selection.contextIndexes.len
    add(selection.next, selection.bucketHeads[bucket])
    add(selection.contextIndexes, contextIndex)
    add(selection.includeMetadata, includeMetadata)
    selection.bucketHeads[bucket] = itemIndex
    return true

fn typedExprSparseSelectionSort(selection: var typedExprSparseContextSelection) =
    var divisor: int32 = 1
    var passIndex: int32
    while passIndex < 4:
        var counts: int32[]
        setLen(counts, 256)
        for itemIndex in 0..<selection.contextIndexes.len:
            let contextIndex = selection.contextIndexes[itemIndex]
            if contextIndex < 0:
                panic("typed expr: sparse context selection index negative")
            let digit = (contextIndex / divisor) % 256
            counts[digit] = counts[digit] + 1
        var offsets: int32[]
        setLen(offsets, 256)
        var running: int32
        for digit in 0..<256:
            offsets[digit] = running
            running = typedExprCheckedAddInt32(
                running, counts[digit], "sparse_context_radix_offset")
        var sortedIndexes: int32[]
        var sortedMetadata: bool[]
        setLen(sortedIndexes, selection.contextIndexes.len)
        setLen(sortedMetadata, selection.includeMetadata.len)
        for itemIndex in 0..<selection.contextIndexes.len:
            let contextIndex = selection.contextIndexes[itemIndex]
            let digit = (contextIndex / divisor) % 256
            let target = offsets[digit]
            sortedIndexes[target] = contextIndex
            sortedMetadata[target] = selection.includeMetadata[itemIndex]
            offsets[digit] = target + 1
        selection.contextIndexes = sortedIndexes
        selection.includeMetadata = sortedMetadata
        passIndex = passIndex + 1
        if passIndex < 4:
            divisor = typedExprCheckedInt32Capacity(
                typedExprCheckedMul64(Int64(divisor), 256,
                                      "sparse_context_radix_divisor"),
                "sparse_context_radix_divisor")

fn typedExprFrozenCanonicalizeScopeRows(rows: var int32[]) =
    # Four stable byte passes sort non-negative int32 identities in O(rows).
    # A comparison sort here would reintroduce a superlinear per-round edge.
    var divisor: int32 = 1
    var passIndex: int32
    while passIndex < 4:
        var counts: int32[]
        setLen(counts, 256)
        for rowIndex in 0..<rows.len:
            let digit = (rows[rowIndex] / divisor) % 256
            counts[digit] = counts[digit] + 1
        var offsets: int32[]
        setLen(offsets, 256)
        var running: int32
        for digit in 0..<256:
            offsets[digit] = running
            running = typedExprCheckedAddInt32(
                running, counts[digit], "round_scope_radix_offset")
        var sortedRows: int32[]
        setLen(sortedRows, rows.len)
        for rowIndex in 0..<rows.len:
            let row = rows[rowIndex]
            let digit = (row / divisor) % 256
            let target = offsets[digit]
            sortedRows[target] = row
            offsets[digit] = target + 1
        rows = sortedRows
        passIndex = passIndex + 1
        if passIndex < 4:
            divisor = typedExprCheckedInt32Capacity(
                typedExprCheckedMul64(Int64(divisor), 256,
                                      "round_scope_radix_divisor"),
                "round_scope_radix_divisor")
    var uniqueRows: int32[]
    for rowIndex in 0..<rows.len:
        if uniqueRows.len <= 0 ||
           uniqueRows[uniqueRows.len - 1] != rows[rowIndex]:
            add(uniqueRows, rows[rowIndex])
    rows = uniqueRows

fn typedExprSparseSelectionLiveBytes(selection: typedExprSparseContextSelection): int64 =
    var total = TypedExprBuildIndexIntArrayBytes(selection.bucketHeads, true)
    total = typedExprCheckedAdd64(
        total,
        TypedExprBuildIndexIntArrayBytes(selection.next, true),
        "round_view_bytes")
    total = typedExprCheckedAdd64(
        total,
        TypedExprBuildIndexIntArrayBytes(selection.contextIndexes, true),
        "round_view_bytes")
    total = typedExprCheckedAdd64(
        total,
        TypedExprBuildIndexBoolArrayBytes(selection.includeMetadata, true),
        "round_selection_bytes")
    return total

@borrows
fn typedExprFrozenContextViewBytes(
        includeMetadata: bool,
        selectedScopeCount: int32): int64 =
    # Strings borrow the canonical intern pool. Charge only view descriptors
    # and per-row sequence slots, never canonical string payload a second time.
    var total: int64 = 512
    if !includeMetadata:
        return total
    total = typedExprCheckedAdd64(total,
        typedExprCheckedMul64(Int64(selectedScopeCount), 208,
                              "round_selected_scope_view_bytes"),
        "round_context_view_bytes")
    return total

@borrows
fn typedExprFrozenBuildRoundViews(session: typedExprFrozenMetadataSession,
                                   sourcePaths: str[],
                                   dependencySourcePaths: str[],
                                   scopeSelectionActive: bool,
                                   selectedScopeRowsRaw: int32[],
                                   contexts: var TypedExprSourceContext[],
                                   err: var str): bool =
    # [orcd9-inst] 入口标 + 头释放步进 BRVH1..8
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(),
                     Fmt"O8BRVENT srcs={sourcePaths.len} deps={dependencySourcePaths.len} scopeRows={selectedScopeRowsRaw.len} cacheKeys={session.roundCacheKeys.len}")
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH1")
    contexts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH2")
    session.roundParkKeys = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH3")
    session.roundParkMetadata = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH4")
    session.roundParkScopeStarts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH5")
    session.roundParkScopeEnds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH6")
    session.roundParkRowIds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH7")
    session.roundParkRowStarts = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "BRVH8")
    session.roundParkFullMaterialize = []
    var selectedScopeRows: int32[]
    for rowIndex in 0..<selectedScopeRowsRaw.len:
        let selectedRow = selectedScopeRowsRaw[rowIndex]
        if selectedRow < 0 ||
           selectedRow >= session.projection.scopes.nameIds.len:
            err = Fmt" typed expr: frozen metadata round scope row out of range row={selectedRow} rows={session.projection.scopes.nameIds.len}"
            return false
        add(selectedScopeRows, selectedRow)
    typedExprFrozenCanonicalizeScopeRows(selectedScopeRows)
    if !scopeSelectionActive && selectedScopeRows.len > 0:
        err = " typed expr: frozen metadata round has inactive scope selection with rows"
        return false
    var selection: typedExprSparseContextSelection
    for sourceIndex in 0..<sourcePaths.len:
        let contextIndex = typedExprFrozenContextIndex(session,
                                                        sourcePaths[sourceIndex])
        if contextIndex < 0 || contextIndex >= session.contextCount:
            err = Fmt" typed expr: frozen metadata round source missing source={sourcePaths[sourceIndex]}"
            return false
        let _added = typedExprSparseSelectionAdd(selection,
                                                  contextIndex,
                                                  true)
    for sourceIndex in 0..<dependencySourcePaths.len:
        if dependencySourcePaths[sourceIndex] == "":
            continue
        let contextIndex = typedExprFrozenContextIndex(
            session,
            dependencySourcePaths[sourceIndex])
        if contextIndex < 0:
            continue
        if contextIndex >= session.contextCount:
            panic("typed expr: frozen metadata dependency context out of range")
        let _added = typedExprSparseSelectionAdd(selection,
                                                  contextIndex,
                                                  false)
    var cursor: int32
    while cursor < selection.contextIndexes.len:
        let contextIndex = selection.contextIndexes[cursor]
        cursor = cursor + 1
        let start = session.projection.importStarts[contextIndex]
        let count = session.projection.importCounts[contextIndex]
        for localIndex in 0..<count:
            let rowIndex = start + localIndex
            let targetSourcePath = typedExprFrozenProjectionText(
                session.projection,
                session.projection.importTargetSourcePathIds[rowIndex])
            let targetContextIndex = typedExprFrozenContextIndexForPath(
                session.projection,
                targetSourcePath)
            if targetContextIndex < 0:
                continue
            if targetContextIndex >= session.contextCount:
                panic("typed expr: frozen metadata import context out of range")
            let _added = typedExprSparseSelectionAdd(selection,
                                                      targetContextIndex,
                                                      false)
    typedExprSparseSelectionSort(selection)
    var rootCount: int32
    var roundViewBytes: int64
    var selectedScopeCursor: int32
    var roundCacheCursor: int32
    for itemIndex in 0..<selection.contextIndexes.len:
        let contextIndex = selection.contextIndexes[itemIndex]
        let includeMetadata = selection.includeMetadata[itemIndex]
        if includeMetadata:
            rootCount = typedExprCheckedAddInt32(rootCount, 1,
                                                "round_root_count")
        var selectedScopeEnd = selectedScopeCursor
        let contextScopeStart =
            session.projection.scopes.contextStarts[contextIndex]
        let contextScopeEnd = contextScopeStart +
            session.projection.scopes.contextCounts[contextIndex]
        while selectedScopeEnd < selectedScopeRows.len:
            let selectedRow = selectedScopeRows[selectedScopeEnd]
            if selectedRow < contextScopeStart:
                err = Fmt" typed expr: frozen metadata selected scope source is not a round root context_index={contextIndex} row={selectedRow}"
                return false
            if selectedRow >= contextScopeEnd:
                break
            if !includeMetadata:
                err = Fmt" typed expr: frozen metadata selected scope belongs to dependency-only context context_index={contextIndex} row={selectedRow}"
                return false
            selectedScopeEnd = selectedScopeEnd + 1
        var selectedScopeCount = selectedScopeEnd - selectedScopeCursor
        let windowStart = selectedScopeCursor
        let wantFullMaterialize = includeMetadata && !scopeSelectionActive
        var ctx: TypedExprSourceContext
        var cacheHit = false
        # Both selections are canonical int32 identity order. Merge them with
        # one monotonic cursor; restarting at slot zero for every context would
        # turn the exact reuse check back into Theta(current * previous).
        while roundCacheCursor < session.roundCacheKeys.len &&
              session.roundCacheKeys[roundCacheCursor] < contextIndex:
            # Sorted identities prove this parked context cannot match this or
            # any later round row. Release its nested SoA storage immediately
            # instead of retaining two disjoint rounds until the outer release.
            if session.roundCacheKeys[roundCacheCursor] >= 0:
                TypedExprClearSourceContextAllFields(
                    session.roundCacheContexts[roundCacheCursor])
                session.roundCacheKeys[roundCacheCursor] = -1
            roundCacheCursor = roundCacheCursor + 1
        if roundCacheCursor < session.roundCacheKeys.len &&
           session.roundCacheKeys[roundCacheCursor] == contextIndex &&
           session.roundCacheMetadata[roundCacheCursor] == includeMetadata &&
           session.roundCacheFullMaterialize[roundCacheCursor] ==
               wantFullMaterialize:
            let slot = roundCacheCursor
            var rowsMatch = true
            if !wantFullMaterialize:
                let rowCount = selectedScopeEnd - windowStart
                if session.roundCacheScopeEnds[slot] -
                       session.roundCacheScopeStarts[slot] != rowCount:
                    rowsMatch = false
                else:
                    for rowOffset in 0..<rowCount:
                        if session.roundCacheRowIds[
                                session.roundCacheRowStarts[slot] + rowOffset] !=
                            selectedScopeRows[windowStart + rowOffset]:
                            rowsMatch = false
                            break
            if rowsMatch:
                ctx = TypedExprSourceContextTakeAt(
                    session.roundCacheContexts, slot)
                session.roundCacheKeys[slot] = -1
                cacheHit = true
        # The context identity is unique in both sorted selections. An exact
        # key with different metadata/scope rows cannot match a later item.
        if roundCacheCursor < session.roundCacheKeys.len &&
           session.roundCacheKeys[roundCacheCursor] == contextIndex:
            TypedExprClearSourceContextAllFields(
                session.roundCacheContexts[roundCacheCursor])
            session.roundCacheKeys[roundCacheCursor] = -1
        if roundCacheCursor < session.roundCacheKeys.len &&
           session.roundCacheKeys[roundCacheCursor] <= contextIndex:
            roundCacheCursor = roundCacheCursor + 1
        if !cacheHit:
            typedExprFrozenBindRoundContext(session, contextIndex, ctx)
            if includeMetadata && !scopeSelectionActive:
                typedExprFrozenAppendMaterializedScopes(session.projection,
                                                         ctx,
                                                         contextIndex,
                                                         false)
            else:
                for rowCursor in selectedScopeCursor..<selectedScopeEnd:
                    typedExprFrozenAppendMaterializedScopeRow(
                        session.projection,
                        ctx,
                        selectedScopeRows[rowCursor],
                        false)
        if includeMetadata && !scopeSelectionActive:
            selectedScopeCount = ctx.scopes.len
        add(session.roundParkRowStarts, session.roundParkRowIds.len)
        if !wantFullMaterialize:
            for rowCursor in windowStart..<selectedScopeEnd:
                add(session.roundParkRowIds, selectedScopeRows[rowCursor])
        add(session.roundParkKeys, contextIndex)
        add(session.roundParkMetadata, includeMetadata)
        add(session.roundParkScopeStarts, windowStart)
        add(session.roundParkScopeEnds, selectedScopeEnd)
        add(session.roundParkFullMaterialize, wantFullMaterialize)
        selectedScopeCursor = selectedScopeEnd
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(), Fmt"O8BRVADD n={itemIndex}")
        add(contexts, ctx)
        roundViewBytes = typedExprCheckedAdd64(
            roundViewBytes,
            typedExprFrozenContextViewBytes(includeMetadata,
                                             selectedScopeCount),
            "round_view_live_bytes")
    # No current identity remains, so every unconsumed parked view is stale.
    # Clear nested columns before validation/telemetry to bound the overlap to
    # the merge frontier rather than the union of two whole rounds.
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8BRVSTALE")
    while roundCacheCursor < session.roundCacheKeys.len:
        if session.roundCacheKeys[roundCacheCursor] >= 0:
            TypedExprClearSourceContextAllFields(
                session.roundCacheContexts[roundCacheCursor])
            session.roundCacheKeys[roundCacheCursor] = -1
        roundCacheCursor = roundCacheCursor + 1
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8BRVSTALEEND")
    if selectedScopeCursor != selectedScopeRows.len:
        let rowIndex = selectedScopeRows[selectedScopeCursor]
        let contextIndex = typedExprFrozenScopeRowContextIndex(
            session.projection.scopes, rowIndex)
        err = Fmt" typed expr: frozen metadata selected scope source missing from round roots context_index={contextIndex} row={rowIndex}"
        return false
    let dependencyCount = selection.contextIndexes.len - rootCount
    if rootCount > sourcePaths.len || dependencyCount < 0 ||
       typedExprCheckedAddInt32(rootCount, dependencyCount,
                                "round_total_context_count") != contexts.len:
        panic("typed expr: frozen metadata round cardinality gate failed")
    let roundPeakBytes = typedExprCheckedAdd64(
        roundViewBytes,
        typedExprSparseSelectionLiveBytes(selection),
        "round_peak_bytes")
    session.roundContextCount = rootCount
    session.roundDependencyCount = dependencyCount
    session.lastRoundContextCount = rootCount
    session.lastRoundDependencyCount = dependencyCount
    session.roundViewLiveBytes = roundViewBytes
    if roundPeakBytes > session.roundPeakBytes:
        session.roundPeakBytes = roundPeakBytes
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8BRVEXIT")
    err = ""
    return true

@borrows
fn typedExprReleaseFrozenRoundViews(session: typedExprFrozenMetadataSession,
                                    contexts: var TypedExprSourceContext[]) =
    if session != nil:
        # Drop the previous park first: the cache is bounded by one round's
        # selection set, so stale slots never accumulate.
        # [orcd9-inst] 入口标 + drop 环毕标 + park 环逐迭代标
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(),
                         Fmt"O8RVENT ctxLen={contexts.len} cacheLen={session.roundCacheContexts.len} parkKeys={session.roundParkKeys.len}")
        for slot in 0..<session.roundCacheContexts.len:
            if session.roundCacheKeys[slot] >= 0:
                TypedExprClearSourceContextAllFields(
                    session.roundCacheContexts[slot])
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(), "O8RVDROP")
        session.roundCacheContexts = []
        session.roundCacheKeys = []
        session.roundCacheMetadata = []
        session.roundCacheScopeStarts = []
        session.roundCacheScopeEnds = []
        session.roundCacheRowIds = []
        session.roundCacheRowStarts = []
        session.roundCacheFullMaterialize = []
        # Park this round's views by the keys BuildRoundViews recorded; the
        # projection is immutable, so an exact-key match next round is
        # byte-identical to re-materialization.
        for contextIndex in 0..<contexts.len:
            if contextIndex < session.roundParkKeys.len:
                var parked: TypedExprSourceContext
                if orcd8TraceEnabled():
                    os.WriteLine(os.Get_stderr(), Fmt"O8RVPARK n={contextIndex}")
                TypedExprSourceContextMoveInto(parked,
                                               contexts[contextIndex])
                add(session.roundCacheContexts, parked)
                if orcd8TraceEnabled():
                    os.WriteLine(os.Get_stderr(), Fmt"O8RVDONE n={contextIndex}")
                add(session.roundCacheKeys,
                    session.roundParkKeys[contextIndex])
                add(session.roundCacheMetadata,
                    session.roundParkMetadata[contextIndex])
                add(session.roundCacheScopeStarts,
                    session.roundParkScopeStarts[contextIndex])
                add(session.roundCacheScopeEnds,
                    session.roundParkScopeEnds[contextIndex])
                add(session.roundCacheRowStarts,
                    session.roundCacheRowIds.len)
                let parkRowStart =
                    session.roundParkRowStarts[contextIndex]
                let parkRowEnd = contextIndex + 1 <
                        session.roundParkRowStarts.len
                    ? session.roundParkRowStarts[contextIndex + 1]
                    : session.roundParkRowIds.len
                for rowCursor in parkRowStart..<parkRowEnd:
                    add(session.roundCacheRowIds,
                        session.roundParkRowIds[rowCursor])
                add(session.roundCacheFullMaterialize,
                    session.roundParkFullMaterialize[contextIndex])
            else:
                TypedExprSourceContextReleaseMovedSourceStorage(
                    contexts[contextIndex])
                TypedExprClearSourceContextAllFields(
                    contexts[contextIndex])
        session.roundParkKeys = []
        session.roundParkMetadata = []
        session.roundParkScopeStarts = []
        session.roundParkScopeEnds = []
        session.roundParkRowIds = []
        session.roundParkRowStarts = []
        session.roundParkFullMaterialize = []
    else:
        for contextIndex in 0..<contexts.len:
            TypedExprSourceContextReleaseMovedSourceStorage(
                contexts[contextIndex])
            TypedExprClearSourceContextAllFields(
                contexts[contextIndex])
    contexts = []
    if session != nil:
        session.roundContextCount = 0
        session.roundDependencyCount = 0
        session.roundViewLiveBytes = 0

@borrows
fn typedExprFrozenExactScopeRows(
        session: typedExprFrozenMetadataSession,
        sourcePaths: str[],
        functionNames: str[],
        startLines: int32[],
        endLines: int32[],
        rows: var int32[],
        err: var str): bool =
    rows = []
    if sourcePaths.len != functionNames.len ||
       sourcePaths.len != startLines.len ||
       (endLines.len != 0 && endLines.len != sourcePaths.len):
        err = Fmt" typed expr: frozen exact scope selection columns mismatch sources={sourcePaths.len} functions={functionNames.len} starts={startLines.len} ends={endLines.len}"
        return false
    for itemIndex in 0..<sourcePaths.len:
        let contextIndex = typedExprFrozenContextIndex(session,
                                                        sourcePaths[itemIndex])
        if contextIndex < 0:
            err = Fmt" typed expr: frozen exact scope source missing source={sourcePaths[itemIndex]} function={functionNames[itemIndex]} start={startLines[itemIndex]}"
            return false
        let rowIndex = typedExprFrozenScopeRowLookup(
            session.projection,
            session.projection.scopes,
            session.projection.scopeBucketHeads,
            session.projection.scopeNext,
            session.projection.scopeHashes,
            contextIndex,
            functionNames[itemIndex],
            startLines[itemIndex])
        var actualEnd: int32 = -1
        if rowIndex >= 0:
            actualEnd = session.projection.scopes.endLines[rowIndex]
        if rowIndex < 0 ||
           (endLines.len > 0 && actualEnd != endLines[itemIndex]):
            var expectedEnd: int32 = -1
            if endLines.len > 0:
                expectedEnd = endLines[itemIndex]
            err = Fmt" typed expr: frozen exact scope missing source={sourcePaths[itemIndex]} function={functionNames[itemIndex]} start={startLines[itemIndex]} expected_end={expectedEnd} actual_end={actualEnd}"
            return false
        add(rows, rowIndex)
    err = ""
    return true

@borrows
fn typedExprFrozenScopeRowsForFunctionIndexes(
        session: typedExprFrozenMetadataSession,
        functionIndexes: int32[],
        functionSourcePaths: str[],
        functionStartLines: int32[],
        functionEndLines: int32[],
        functionSelected: bool[],
        functionSelectionActive: bool,
        rows: var int32[],
        err: var str): bool =
    rows = []
    if functionSourcePaths.len != functionStartLines.len ||
       functionSourcePaths.len != functionEndLines.len ||
       functionSourcePaths.len != functionSelected.len:
        err = Fmt" typed expr: frozen function scope selection columns mismatch sources={functionSourcePaths.len} starts={functionStartLines.len} ends={functionEndLines.len} selected={functionSelected.len}"
        return false
    for itemIndex in 0..<functionIndexes.len:
        let functionIndex = functionIndexes[itemIndex]
        if functionIndex < 0 || functionIndex >= functionSourcePaths.len:
            err = Fmt" typed expr: frozen function scope selection index invalid row={itemIndex} function_index={functionIndex} functions={functionSourcePaths.len}"
            return false
        if functionSelectionActive && !functionSelected[functionIndex]:
            continue
        let contextIndex = typedExprFrozenContextIndex(
            session, functionSourcePaths[functionIndex])
        let rowIndex = typedExprFrozenScopeRowForLine(
            session.projection, contextIndex, functionStartLines[functionIndex])
        if contextIndex < 0 || rowIndex < 0 ||
           session.projection.scopes.startLines[rowIndex] !=
               functionStartLines[functionIndex] ||
           session.projection.scopes.endLines[rowIndex] !=
               functionEndLines[functionIndex]:
            err = Fmt" typed expr: frozen function scope selection identity mismatch source={functionSourcePaths[functionIndex]} function_index={functionIndex} start={functionStartLines[functionIndex]} end={functionEndLines[functionIndex]} row={rowIndex}"
            return false
        add(rows, rowIndex)
    err = ""
    return true

@borrows
fn typedExprFrozenScopeRowsForExprLayer(
        session: typedExprFrozenMetadataSession,
        exprLayer: parser.NormalizedExprLayer,
        rows: var int32[],
        err: var str): bool =
    rows = []
    for exprIndex in 0..<exprLayer.exprs.len:
        let expr = exprLayer.exprs[exprIndex]
        if !TypedExprExprRequiresPersistentFact(expr):
            continue
        let contextIndex = typedExprFrozenContextIndex(session,
                                                        expr.sourcePath)
        if contextIndex < 0:
            err = Fmt" typed expr: frozen fact scope source missing source={expr.sourcePath} line={expr.lineNumber}"
            return false
        let rowIndex = typedExprFrozenScopeRowForLine(session.projection,
                                                       contextIndex,
                                                       expr.lineNumber)
        # Top-level initializers intentionally have no function scope.
        if rowIndex >= 0:
            add(rows, rowIndex)
    err = ""
    return true

@borrows
fn typedExprFrozenAppendUniqueRoundPathIndexed(
        paths: var str[],
        lookup: var parser.ParserSourcePathIndexLookup,
        sourcePathRaw: str) =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    if sourcePath == "" ||
       parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
           lookup, sourcePath) >= 0:
        return
    parser.ParserSourcePathIndexLookupInsertExact(lookup,
                                                   share(sourcePath),
                                                   paths.len)
    add(paths, sourcePath)

@borrows
fn typedExprReleaseFrozenMetadataProjection(projection: typedExprFrozenMetadataProjection) =
    if projection == nil || projection.released:
        return
    langintern.InternPoolRelease(projection.internPool)
    projection.contextBucketHeads = []
    projection.contextNext = []
    projection.contextHashes = []
    projection.rawSourcePathIds = []
    projection.normalizedSourcePathIds = []
