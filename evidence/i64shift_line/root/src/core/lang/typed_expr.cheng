    if columnId == typedExprBuildIndexTextColumnCallReturnType:
        compactCount = index.callDeclarationReturnTypeIds.len
        ordinaryCount = index.callDeclarationReturnTypes.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.callDeclarationReturnTypeIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnCallTargetSymbol:
        compactCount = index.callDeclarationTargetSymbolIds.len
        ordinaryCount = index.callDeclarationTargetSymbols.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.callDeclarationTargetSymbolIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnContextSourcePath:
        compactCount = index.contextSourcePathIds.len
        ordinaryCount = index.contextSourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.contextSourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnContextFieldOwnerSourcePath:
        compactCount = index.contextFieldOwnerSourcePathIds.len
        ordinaryCount = index.contextFieldOwnerSourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.contextFieldOwnerSourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnContextFieldOwnerType:
        compactCount = index.contextFieldOwnerTypeIds.len
        ordinaryCount = index.contextFieldOwnerTypes.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.contextFieldOwnerTypeIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnLayoutSourcePath:
        compactCount = index.layoutSourcePathIds.len
        ordinaryCount = index.layoutSourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.layoutSourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnLayoutTypeName:
        compactCount = index.layoutTypeNameIds.len
        ordinaryCount = index.layoutTypeNames.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.layoutTypeNameIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnFieldOwnerSourcePath:
        compactCount = index.fieldOwnerSourcePathIds.len
        ordinaryCount = index.fieldOwnerSourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.fieldOwnerSourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnFieldOwnerType:
        compactCount = index.fieldOwnerTypeIds.len
        ordinaryCount = index.fieldOwnerTypes.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.fieldOwnerTypeIds[rowIndex]
        return
    panic(Fmt"typed expr: build index text column invalid column_id={columnId}")

@borrows
@borrow_result
fn typedExprBuildIndexOrdinaryTextAt(index: TypedExprBuildIndex,
                                      columnId: int32,
                                      rowIndex: int32): str =
    if index == nil || index.released || rowIndex < 0:
        panic(Fmt"typed expr: ordinary build index text unavailable column_id={columnId} row={rowIndex}")
    if columnId == typedExprBuildIndexTextColumnEntryKind:
        if rowIndex >= index.entryKinds.len:
            panic("typed expr: entry kind row out of range")
        return index.entryKinds[rowIndex]
    if columnId == typedExprBuildIndexTextColumnEntrySourcePath:
        if rowIndex >= index.entrySourcePaths.len:
            panic("typed expr: entry source path row out of range")
        return index.entrySourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnEntryName:
        if rowIndex >= index.entryNames.len:
            panic("typed expr: entry name row out of range")
        return index.entryNames[rowIndex]
    if columnId == typedExprBuildIndexTextColumnEntryDetail:
        if rowIndex >= index.entryDetails.len:
            panic("typed expr: entry detail row out of range")
        return index.entryDetails[rowIndex]
    if columnId == typedExprBuildIndexTextColumnEntryOrigin:
        if rowIndex >= index.entryOrigins.len:
            panic("typed expr: entry origin row out of range")
        return index.entryOrigins[rowIndex]
    if columnId == typedExprBuildIndexTextColumnEntryFingerprint:
        if rowIndex >= index.entryFingerprints.len:
            panic("typed expr: entry fingerprint row out of range")
        return index.entryFingerprints[rowIndex]
    if columnId == typedExprBuildIndexTextColumnVisibilityKind:
        if rowIndex >= index.visibilityKinds.len:
            panic("typed expr: visibility kind row out of range")
        return index.visibilityKinds[rowIndex]
    if columnId == typedExprBuildIndexTextColumnVisibilitySourcePath:
        if rowIndex >= index.visibilitySourcePaths.len:
            panic("typed expr: visibility source path row out of range")
        return index.visibilitySourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnVisibilityName:
        if rowIndex >= index.visibilityNames.len:
            panic("typed expr: visibility name row out of range")
        return index.visibilityNames[rowIndex]
    if columnId == typedExprBuildIndexTextColumnVisibilityDetail:
        if rowIndex >= index.visibilityDetails.len:
            panic("typed expr: visibility detail row out of range")
        return index.visibilityDetails[rowIndex]
    if columnId == typedExprBuildIndexTextColumnVisibilityFingerprint:
        if rowIndex >= index.visibilityFingerprints.len:
            panic("typed expr: visibility fingerprint row out of range")
        return index.visibilityFingerprints[rowIndex]
    if columnId == typedExprBuildIndexTextColumnImportOwnerSourcePath:
        if rowIndex >= index.importOwnerSourcePaths.len:
            panic("typed expr: import owner source path row out of range")
        return index.importOwnerSourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnContentCacheKind:
        if rowIndex >= index.contentCacheKinds.len:
            panic("typed expr: content cache kind row out of range")
        return index.contentCacheKinds[rowIndex]
    if columnId == typedExprBuildIndexTextColumnContentCacheSourcePath:
        if rowIndex >= index.contentCacheSourcePaths.len:
            panic("typed expr: content cache source path row out of range")
        return index.contentCacheSourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnContentCacheName:
        if rowIndex >= index.contentCacheNames.len:
            panic("typed expr: content cache name row out of range")
        return index.contentCacheNames[rowIndex]
    if columnId == typedExprBuildIndexTextColumnContentCacheValue:
        if rowIndex >= index.contentCacheValues.len:
            panic("typed expr: content cache value row out of range")
        return index.contentCacheValues[rowIndex]
    if columnId == typedExprBuildIndexTextColumnCallSourcePath:
        if rowIndex >= index.callDeclarationSourcePaths.len:
            panic("typed expr: call source path row out of range")
        return index.callDeclarationSourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnCallName:
        if rowIndex >= index.callDeclarationNames.len:
            panic("typed expr: call name row out of range")
        return index.callDeclarationNames[rowIndex]
    if columnId == typedExprBuildIndexTextColumnCallGenericName:
        if rowIndex >= index.callDeclarationGenericNames.len:
            panic("typed expr: call generic name row out of range")
        return index.callDeclarationGenericNames[rowIndex]
    if columnId == typedExprBuildIndexTextColumnCallParamType:
        if rowIndex >= index.callDeclarationParamTypes.len:
            panic("typed expr: call parameter type row out of range")
        return index.callDeclarationParamTypes[rowIndex]
    if columnId == typedExprBuildIndexTextColumnCallReturnType:
        if rowIndex >= index.callDeclarationReturnTypes.len:
            panic("typed expr: call return type row out of range")
        return index.callDeclarationReturnTypes[rowIndex]
    if columnId == typedExprBuildIndexTextColumnCallTargetSymbol:
        if rowIndex >= index.callDeclarationTargetSymbols.len:
            panic("typed expr: call target symbol row out of range")
        return index.callDeclarationTargetSymbols[rowIndex]
    if columnId == typedExprBuildIndexTextColumnContextSourcePath:
        if rowIndex >= index.contextSourcePaths.len:
            panic("typed expr: context source path row out of range")
        return index.contextSourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnContextFieldOwnerSourcePath:
        if rowIndex >= index.contextFieldOwnerSourcePaths.len:
            panic("typed expr: context field owner source path row out of range")
        return index.contextFieldOwnerSourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnContextFieldOwnerType:
        if rowIndex >= index.contextFieldOwnerTypes.len:
            panic("typed expr: context field owner type row out of range")
        return index.contextFieldOwnerTypes[rowIndex]
    if columnId == typedExprBuildIndexTextColumnLayoutSourcePath:
        if rowIndex >= index.layoutSourcePaths.len:
            panic("typed expr: layout source path row out of range")
        return index.layoutSourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnLayoutTypeName:
        if rowIndex >= index.layoutTypeNames.len:
            panic("typed expr: layout type name row out of range")
        return index.layoutTypeNames[rowIndex]
    if columnId == typedExprBuildIndexTextColumnFieldOwnerSourcePath:
        if rowIndex >= index.fieldOwnerSourcePaths.len:
            panic("typed expr: field owner source path row out of range")
        return index.fieldOwnerSourcePaths[rowIndex]
    if columnId == typedExprBuildIndexTextColumnFieldOwnerType:
        if rowIndex >= index.fieldOwnerTypes.len:
            panic("typed expr: field owner type row out of range")
        return index.fieldOwnerTypes[rowIndex]
    panic(Fmt"typed expr: ordinary build index text column invalid column_id={columnId}")

@borrows
@borrow_result
fn typedExprBuildIndexTextAt(index: TypedExprBuildIndex,
                             rowIndex: int32,
                             columnId: int32): str =
    if index == nil || index.released || rowIndex < 0:
        panic(Fmt"typed expr: build index text unavailable column_id={columnId} row={rowIndex}")
    var compactCount: int32
    var ordinaryCount: int32
    var compactId: langintern.InternId
    typedExprBuildIndexTextColumnFacts(
        index, columnId, rowIndex,
        compactCount, ordinaryCount, compactId)
    let hasBorrowColumn = compactCount > 0
    if !index.compactCanonical && !hasBorrowColumn:
        if rowIndex >= ordinaryCount:
            panic(Fmt"typed expr: build index text row out of range column_id={columnId} row={rowIndex}")
        return typedExprBuildIndexOrdinaryTextAt(index, columnId, rowIndex)
    if !index.compactCanonical && rowIndex >= ordinaryCount:
        panic(Fmt"typed expr: borrowed build index text row out of range column_id={columnId} row={rowIndex}")
    if index.canonicalProjection == nil ||
       index.canonicalProjection.released ||
       index.canonicalProjection.internPool == nil ||
       rowIndex >= compactCount:
        panic(Fmt"typed expr: canonical borrowed text unavailable column_id={columnId} row={rowIndex}")
    if !index.compactCanonical && compactId < 0:
        return typedExprBuildIndexOrdinaryTextAt(index, columnId, rowIndex)
    let textResult: Result[str] = langintern.LookupIntern(
        index.canonicalProjection.internPool,
        compactId)
    if !IsOk(textResult):
        panic(Fmt"typed expr: canonical borrowed intern miss column_id={columnId} row={rowIndex}")
    return textResult.value

fn typedExprBuildIndexMaterializeBorrowedTextColumn(
        index: var TypedExprBuildIndex,
        columnId: int32) =
    if index == nil || index.released || index.canonicalProjection == nil ||
       index.canonicalProjection.released ||
       index.canonicalProjection.internPool == nil:
        panic(Fmt"typed expr: borrowed text detach invalid column_id={columnId}")
    if columnId != typedExprBuildIndexTextColumnEntryKind &&
       columnId != typedExprBuildIndexTextColumnEntrySourcePath &&
       columnId != typedExprBuildIndexTextColumnEntryName &&
       columnId != typedExprBuildIndexTextColumnEntryDetail &&
       columnId != typedExprBuildIndexTextColumnEntryOrigin &&
       columnId != typedExprBuildIndexTextColumnEntryFingerprint &&
       columnId != typedExprBuildIndexTextColumnContextSourcePath &&
       columnId != typedExprBuildIndexTextColumnFieldOwnerSourcePath &&
       columnId != typedExprBuildIndexTextColumnFieldOwnerType &&
       columnId != typedExprBuildIndexTextColumnLayoutSourcePath &&
       columnId != typedExprBuildIndexTextColumnLayoutTypeName &&
       columnId != typedExprBuildIndexTextColumnCallSourcePath &&
       columnId != typedExprBuildIndexTextColumnCallName &&
       columnId != typedExprBuildIndexTextColumnCallGenericName &&
       columnId != typedExprBuildIndexTextColumnCallParamType &&
       columnId != typedExprBuildIndexTextColumnCallReturnType &&
       columnId != typedExprBuildIndexTextColumnCallTargetSymbol:
        panic(Fmt"typed expr: borrowed text detach column unsupported column_id={columnId}")
    var compactCount: int32
    var ordinaryCount: int32
    var compactId: langintern.InternId
    typedExprBuildIndexTextColumnFacts(
        index, columnId, -1, compactCount, ordinaryCount, compactId)
    if compactCount == 0:
        return
    if compactCount != ordinaryCount:
        panic(Fmt"typed expr: borrowed text detach shape invalid column_id={columnId}")
    for rowIndex in 0..<compactCount:
        typedExprBuildIndexTextColumnFacts(
            index, columnId, rowIndex,
            compactCount, ordinaryCount, compactId)
        if compactId < 0:
            continue
        let textResult: Result[str] = langintern.LookupIntern(
            index.canonicalProjection.internPool, compactId)
        if !IsOk(textResult):
            panic(Fmt"typed expr: borrowed text detach intern miss column_id={columnId} row={rowIndex}")
        let ownedText = parser.ParserOwnedText(textResult.value)
        if columnId == typedExprBuildIndexTextColumnEntryKind:
            index.entryKinds[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnEntrySourcePath:
            index.entrySourcePaths[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnEntryName:
            index.entryNames[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnEntryDetail:
            index.entryDetails[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnEntryOrigin:
            index.entryOrigins[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnEntryFingerprint:
            index.entryFingerprints[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnContextSourcePath:
            index.contextSourcePaths[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnFieldOwnerSourcePath:
            index.fieldOwnerSourcePaths[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnFieldOwnerType:
            index.fieldOwnerTypes[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnLayoutSourcePath:
            index.layoutSourcePaths[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnLayoutTypeName:
            index.layoutTypeNames[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnCallSourcePath:
            index.callDeclarationSourcePaths[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnCallName:
            index.callDeclarationNames[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnCallGenericName:
            index.callDeclarationGenericNames[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnCallParamType:
            index.callDeclarationParamTypes[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnCallReturnType:
            index.callDeclarationReturnTypes[rowIndex] = ownedText
        elif columnId == typedExprBuildIndexTextColumnCallTargetSymbol:
            index.callDeclarationTargetSymbols[rowIndex] = ownedText
    if columnId == typedExprBuildIndexTextColumnEntryKind:
        index.entryKindIds = []
    elif columnId == typedExprBuildIndexTextColumnEntrySourcePath:
        index.entrySourcePathIds = []
    elif columnId == typedExprBuildIndexTextColumnEntryName:
        index.entryNameIds = []
    elif columnId == typedExprBuildIndexTextColumnEntryDetail:
        index.entryDetailIds = []
    elif columnId == typedExprBuildIndexTextColumnEntryOrigin:
        index.entryOriginIds = []
    elif columnId == typedExprBuildIndexTextColumnEntryFingerprint:
        index.entryFingerprintIds = []
    elif columnId == typedExprBuildIndexTextColumnContextSourcePath:
        index.contextSourcePathIds = []
    elif columnId == typedExprBuildIndexTextColumnFieldOwnerSourcePath:
        index.fieldOwnerSourcePathIds = []
    elif columnId == typedExprBuildIndexTextColumnFieldOwnerType:
        index.fieldOwnerTypeIds = []
    elif columnId == typedExprBuildIndexTextColumnLayoutSourcePath:
        index.layoutSourcePathIds = []
    elif columnId == typedExprBuildIndexTextColumnLayoutTypeName:
        index.layoutTypeNameIds = []
    elif columnId == typedExprBuildIndexTextColumnCallSourcePath:
        index.callDeclarationSourcePathIds = []
    elif columnId == typedExprBuildIndexTextColumnCallName:
        index.callDeclarationNameIds = []
    elif columnId == typedExprBuildIndexTextColumnCallGenericName:
        index.callDeclarationGenericNameIds = []
    elif columnId == typedExprBuildIndexTextColumnCallParamType:
        index.callDeclarationParamTypeIds = []
    elif columnId == typedExprBuildIndexTextColumnCallReturnType:
        index.callDeclarationReturnTypeIds = []
    elif columnId == typedExprBuildIndexTextColumnCallTargetSymbol:
        index.callDeclarationTargetSymbolIds = []

fn typedExprBuildIndexDetachCanonicalText(
        index: var TypedExprBuildIndex) =
    if index == nil || index.released || index.compactCanonical ||
       index.canonicalProjection == nil:
        panic("typed expr: derived build index canonical detach invalid")
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnEntryKind)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnEntrySourcePath)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnEntryName)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnEntryDetail)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnEntryOrigin)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnEntryFingerprint)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnContextSourcePath)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnFieldOwnerSourcePath)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnFieldOwnerType)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnLayoutSourcePath)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnLayoutTypeName)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnCallSourcePath)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnCallName)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnCallGenericName)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnCallParamType)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnCallReturnType)
    typedExprBuildIndexMaterializeBorrowedTextColumn(
        index, typedExprBuildIndexTextColumnCallTargetSymbol)
    index.canonicalProjection = nil

@borrows
fn typedExprBuildIndexEntryCount(index: TypedExprBuildIndex): int32 =
    if index == nil:
        return 0
    return index.compactCanonical ? index.entryKindIds.len : index.entryKinds.len

