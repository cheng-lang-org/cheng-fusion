        batch: TypedExprSealedFactsBatch): int32 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.indexProducerFullTraversalCount

@borrows
fn TypedExprSealedFactsBatchSelectedLineVisitCount(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.selectedLineVisitCount

@borrows
fn TypedExprSealedFactsBatchSelectedLineBytes(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.selectedLineBytes

@borrows
fn TypedExprSealedFactsBatchSelectedScopeVisitCount(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.selectedScopeVisitCount

@borrows
fn TypedExprSealedFactsBatchSelectedBindingVisitCount(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.selectedBindingVisitCount

@borrows
fn TypedExprSealedFactsBatchGlobalBindingVisitCount(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.globalBindingVisitCount

@borrows
fn TypedExprSealedFactsBatchPeakPackedLineCount(
        batch: TypedExprSealedFactsBatch): int32 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.peakPackedLineCount

@borrows
fn TypedExprSealedFactsBatchPeakPackedLineBytes(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.peakPackedLineBytes

@borrows
fn TypedExprSealedFactsBatchSourceLineDomainPeak(
        batch: TypedExprSealedFactsBatch): int32 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.sourceLineDomainPeak

@borrows
fn TypedExprSealedFactsBatchReusableContextOwnerPeak(
        batch: TypedExprSealedFactsBatch): int32 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch telemetry queried outside active transaction")
    return batch.reusableContextOwnerPeak

fn TypedExprSealedFactsBatchFinish(
        sourceTexts: var TypedExprSourceText[],
        batch: var TypedExprSealedFactsBatch,
        metadataRowsVisited: var int64) =
    if batch == nil || !batch.active || batch.session == nil:
        panic("typed expr: sealed facts batch finish outside active transaction")
    let stagedMetadataRowsVisited = batch.metadataRowsVisited
    if !TypedExprMetadataVisitReceiptExact(
            batch.metadataContextCountExpected,
            batch.metadataContextCountObserved,
            batch.metadataRowsExpected,
            stagedMetadataRowsVisited):
        panic("typed expr: sealed facts batch finish metadata conservation drift")
    batch.telemetryCommitted = true
    typedExprSealedFactsBatchCloseRound(batch)
    let session = batch.session
    typedExprMoveFrozenRoundSourceTexts(sourceTexts,
                                        batch.stagedSourceTexts)
    typedExprCommitFrozenMetadataOperation(session,
                                           stagedMetadataRowsVisited)
    metadataRowsVisited = stagedMetadataRowsVisited
    batch.session = nil
    batch = nil

fn TypedExprSealedFactsBatchAbort(batch: var TypedExprSealedFactsBatch) =
    if batch == nil:
        return
    if batch.active:
        typedExprSealedFactsBatchCloseRound(batch)
    batch.session = nil
    batch = nil

fn TypedExprBuildFactsForExprLayerPreservingSealed(
        sourceTexts: var TypedExprSourceText[],
        exprLayer: var parser.NormalizedExprLayer,
        ir: var TypedExprIr,
        facts: var TypedExprFactTable,
        err: var str): bool =
    let session = typedExprPrepareFrozenMetadataOperation(ir, "facts")
    var queryLookupCount: int32
    var queryProbeCount: int32
    var queryMetadataScanCount: int32
    typedExprBeginFrozenReadOnlyQueries(session,
                                        queryLookupCount,
                                        queryProbeCount,
                                        queryMetadataScanCount)
    var stagedSourceTexts = typedExprCloneFrozenRoundSourceTexts(sourceTexts)
    var stagedExprLayer = parser.NormalizedExprLayerClone(exprLayer)
    var stagedFacts: TypedExprFactTable
    var metadataRowsVisited: int64
    var activeSourcePaths: str[]
    var activeSourcePathLookup =
        parser.ParserSourcePathIndexLookupInit(32)
    for sourceIndex in 0..<stagedSourceTexts.len:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            activeSourcePaths,
            activeSourcePathLookup,
            stagedSourceTexts[sourceIndex].sourcePath)
    var dependencySourcePaths: str[]
    var dependencySourcePathLookup =
        parser.ParserSourcePathIndexLookupInit(32)
    for exprIndex in 0..<stagedExprLayer.exprs.len:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            dependencySourcePaths,
            dependencySourcePathLookup,
            stagedExprLayer.exprs[exprIndex].callTargetSourcePath)
    var roundScopeRows: int32[]
    if !typedExprFrozenScopeRowsForExprLayer(session,
                                             stagedExprLayer,
                                             roundScopeRows,
                                             err):
        typedExprEndFrozenReadOnlyQueries(session,
                                          queryLookupCount,
                                          queryProbeCount,
                                          queryMetadataScanCount)
        parser.NormalizedExprLayerReset(stagedExprLayer)
        return false
    var roundContexts: TypedExprSourceContext[]
    if !typedExprFrozenBuildRoundViews(session,
                                        activeSourcePaths,
                                        dependencySourcePaths,
                                        true,
                                        roundScopeRows,
                                        roundContexts,
                                        err):
        typedExprEndFrozenReadOnlyQueries(session,
                                          queryLookupCount,
                                          queryProbeCount,
                                          queryMetadataScanCount)
        typedExprReleaseFrozenRoundViews(session, roundContexts)
        parser.NormalizedExprLayerReset(stagedExprLayer)
        return false
    var roundContextLookup: parser.ParserSourcePathIndexLookup
    if !TypedExprBuildSourceContextExactIndex(roundContexts,
                                               roundContextLookup,
                                               err):
        typedExprEndFrozenReadOnlyQueries(session,
                                          queryLookupCount,
                                          queryProbeCount,
                                          queryMetadataScanCount)
        typedExprReleaseFrozenRoundViews(session, roundContexts)
        parser.NormalizedExprLayerReset(stagedExprLayer)
        return false
    if !typedExprBuildFactsForExprLayerPreservingWithLookup(
            stagedSourceTexts,
            stagedExprLayer,
            roundContexts,
            roundContextLookup,
            session,
            metadataRowsVisited,
            stagedFacts,
            err):
        typedExprEndFrozenReadOnlyQueries(session,
                                          queryLookupCount,
                                          queryProbeCount,
                                          queryMetadataScanCount)
        typedExprReleaseFrozenRoundViews(session, roundContexts)
        TypedExprFactTableRelease(stagedFacts)
        parser.NormalizedExprLayerReset(stagedExprLayer)
        return false
    typedExprEndFrozenReadOnlyQueries(session,
                                      queryLookupCount,
                                      queryProbeCount,
                                      queryMetadataScanCount)
    typedExprReleaseFrozenRoundViews(session, roundContexts)
    typedExprMoveFrozenRoundSourceTexts(sourceTexts, stagedSourceTexts)
    parser.NormalizedExprLayerReset(stagedExprLayer)
    TypedExprFactTableRelease(facts)
    TypedExprFactTableMoveInto(facts, stagedFacts)
    typedExprFactTableRequireExactPreparedBuild(facts)
    typedExprCommitFrozenMetadataOperation(session, metadataRowsVisited)
    return true

fn TypedExprBuildFacts(sourceTexts: var TypedExprSourceText[],
                         exprLayer: var parser.NormalizedExprLayer,
                         facts: var TypedExprFactTable,
                         err: var str): bool =
    TypedExprFactTableRelease(facts)
    TypedExprTraceLine("typed_facts:enter")
    TypedExprTraceLine("typed_facts:source_text_count")
    var factsExprLayer = parser.NormalizedExprLayerClone(exprLayer)
    if !TypedExprEnsureSourceTextsCoverExprLayer(sourceTexts, factsExprLayer, err):
        parser.NormalizedExprLayerReset(factsExprLayer)
        return false
    var contexts: TypedExprSourceContext[]
    TypedExprTraceLine("typed_facts:before_context_loop")
    for i in 0..<sourceTexts.len:
        TypedExprTraceLine("typed_facts:context_loop_top")
        os.ProcessResourceGuardCheck()
        if !TypedExprBuildFactsAppendMetadataContext(sourceTexts, i, contexts, err):
            parser.NormalizedExprLayerReset(factsExprLayer)
            return false
    let ok = TypedExprBuildFactsWithMetadataContexts(sourceTexts,
                                                      factsExprLayer,
                                                      contexts,
                                                      facts,
                                                      err)
    parser.NormalizedExprLayerReset(factsExprLayer)
    return ok

fn TypedExprBuildFactsWithMetadataContexts(sourceTexts: var TypedExprSourceText[],
                                            exprLayer: var parser.NormalizedExprLayer,
                                            contexts: var TypedExprSourceContext[],
                                            facts: var TypedExprFactTable,
                                            err: var str): bool =
    TypedExprFactTableRelease(facts)
    typedExprFactTablePrepareEmptyExprRange(facts,
                                            exprLayer,
                                            0,
                                            exprLayer.exprs.len)
    var sourceIdentityIndex: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(sourceTexts, sourceIdentityIndex, err):
        return false
    var contextLookup: parser.ParserSourcePathIndexLookup
    if !TypedExprBuildSourceContextExactIndex(contexts, contextLookup, err):
        return false
    var exprIndex: int32
    TypedExprTraceLine("typed_facts:before_expr_loop")
    while exprIndex < exprLayer.exprs.len:
        TypedExprTraceLine("typed_facts:expr_loop_top")
        if exprIndex % 256 == 0:
            os.ProcessResourceGuardCheck()
        let sourcePath = exprLayer.exprs[exprIndex].sourcePath
        var sourceTextIndex: int32
        if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                             sourcePath,
                                             sourceTextIndex,
                                             err) || sourceTextIndex < 0:
            err = Fmt" typed expr: missing source text source={sourcePath} line={exprLayer.exprs[exprIndex].lineNumber} expr={exprLayer.exprs[exprIndex].exprId} source_count={sourceTexts.len}"
            return false
        let ctxIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextLookup,
                                                                                    sourceTexts[sourceTextIndex].sourcePath)
        TypedExprTraceLine("typed_facts:after_context_lookup")
        if ctxIndex < 0:
            err = Fmt" typed expr: missing source context source={sourcePath} line={exprLayer.exprs[exprIndex].lineNumber} expr={exprLayer.exprs[exprIndex].exprId} source_count={contexts.len}"
            return false
        var exprEnd = TypedExprExprLayerEndIndexForSource(exprLayer, sourcePath, exprIndex)
        if exprEnd <= exprIndex:
            exprEnd = exprIndex + 1
        TypedExprTraceLine("typed_facts:range")
        let sourceFactStart = facts.count
        if !TypedExprBuildFactsAppendSourceRangeFacts(sourceTexts,
                                                      sourceTextIndex,
                                                      contexts,
                                                      sourceIdentityIndex,
                                                      contextLookup,
                                                      exprLayer,
                                                      exprIndex,
                                                      exprEnd,
                                                      false,
                                                      facts,
                                                      err):
            return false
        let sourceFactEnd = facts.count
        var validateErr = ""
        TypedExprTraceLine("typed_facts:before_validate_call_resolution_range")
        if !TypedExprFactsValidateCallResolutionRange(exprLayer,
                                                      contexts,
                                                      facts,
                                                      exprIndex,
                                                      exprEnd,
                                                      sourceFactStart,
                                                      sourceFactEnd,
                                                      validateErr):
            err = validateErr
            return false
        TypedExprTraceLine("typed_facts:after_validate_call_resolution_range")
        TypedExprCompactStoredFactsRange(facts, sourceFactStart, sourceFactEnd)
        TypedExprClearExprLayerRange(exprLayer, exprIndex, exprEnd)
        exprIndex = exprEnd
        TypedExprTraceLine("typed_facts:after_expr_range")
    typedExprFactTableRequireExactPreparedBuild(facts)
    err = ""
    return true

# Snapshot build path: 直接从 metadataContexts + facts + exprLayer 构建 typedIr,
# 跳过 TypedExprBuildIrWithFactsMetadataAndExprLayer 的 per-source metadata 重构建。
# 复用 BuildIrForScopeWithFactsAndExprLayer (已证 O(N) per scope)。
fn TypedExprSnapshotBuild(sourceTexts: var TypedExprSourceText[],
                        metadataContexts: var TypedExprSourceContext[],
                        facts: var TypedExprFactTable,
                        exprLayer: var parser.NormalizedExprLayer,
                        ir: var TypedExprIr,
                        filterActive: bool,
                        filterSourcePaths: str[],
                        filterFunctionNames: str[],
                        filterStartLines: int32[]): bool =
    TypedExprIrBeginValueExprBorrow(ir, exprLayer)
    let ok = TypedExprSnapshotBuildCore(
        sourceTexts, metadataContexts, facts, exprLayer, ir,
        filterActive, filterSourcePaths, filterFunctionNames,
        filterStartLines)
    TypedExprIrEndValueExprBorrow(ir)
    return ok

fn TypedExprSnapshotBuildCore(sourceTexts: var TypedExprSourceText[],
                        metadataContexts: var TypedExprSourceContext[],
                        facts: var TypedExprFactTable,
                        exprLayer: var parser.NormalizedExprLayer,
                        ir: var TypedExprIr,
                        filterActive: bool,
                        filterSourcePaths: str[],
                        filterFunctionNames: str[],
                        filterStartLines: int32[]): bool =
    TypedExprValidateNormalizedDeferFacts(exprLayer)
    var normalizedScopeIndex = TypedExprNormalizedScopeIndexBuild(exprLayer)
    if metadataContexts.len <= 0 || facts.count <= 0:
        return false
    var functionFilterIndex: TypedExprFunctionFilterIndex
    if filterActive:
        var filterErr: str
        if !TypedExprBuildFunctionFilterIndex(sourceTexts,
                                              true,
                                              filterSourcePaths,
                                              filterFunctionNames,
                                              filterStartLines,
                                              functionFilterIndex,
                                              filterErr):
            return false
    var snapshotErr: str
    if !TypedExprValidateSnapshotOnlyIrInputs(sourceTexts,
                                              metadataContexts,
                                              facts,
                                              exprLayer,
                                              filterActive,
                                              filterSourcePaths,
                                              filterFunctionNames,
                                              filterStartLines,
                                              snapshotErr):
        return false
    if ir.arena.capacityBytes <= 0:
        ir.arena = arenamod.ArenaInitDefault(1048576)
    if ir.internPool == nil:
        ir.internPool = langintern.InternPoolNew()
    TypedExprIrPrepareValueExprCallMetadata(ir, facts)
    for mi in 0..<metadataContexts.len:
        TypedExprIrAppendEnumValuesFromContext(ir, metadataContexts[mi])
        TypedExprIrAppendImportcFunctionsFromContext(ir, metadataContexts[mi])
        TypedExprIrAppendRefTypesFromContext(ir, metadataContexts[mi])
        TypedExprIrAppendTypeDefAliasesFromContext(ir, metadataContexts[mi])
        TypedExprIrAppendTypeLayoutsFromContext(ir, metadataContexts[mi], metadataContexts)
    var exprCursor: int32
    var factCursor: int32
    for ctxIndex in 0..<metadataContexts.len:
        var ctx = TypedExprSourceContextBorrowedView(metadataContexts[ctxIndex])
        let srcPath = ctx.sourcePath
        # 旧版 build 在 scope 循环前调 AttachStableMetadata + EnsureLinesLoaded
        TypedExprAttachStableMetadataToRebuildContext(ctx, metadataContexts[ctxIndex])
        # BuildIrForScopeWithFactsAndExprLayer 需要 ctx.lines (函数声明/return 提取)
        if ctx.lines.len <= 0:
            if ctx.snapshotOnly:
                panic(Fmt"typed expr: snapshot-only fast-build context lines missing source={srcPath}")
            var reloadSource: TypedExprSourceText
            reloadSource.sourcePath = srcPath
            var reloadErr: str
            if !TypedExprEnsureSourceContextLinesLoaded(reloadSource, ctx, reloadErr):
                continue
        # 填充 local/global bindings per-line (O(lines) per source, 镜像旧版 BuildSourceContextBorrowed)
        var snapshotInGlobalVarBlock: bool
        for snapshotLineIdx in 0..<ctx.lines.len:
            let snapshotLineNum = snapshotLineIdx + 1
            let snapshotRawLine = ctx.lines[snapshotLineIdx]
            let snapshotTrimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(snapshotRawLine)))
            if !parser.ParserHasLeadingIndent(snapshotRawLine):
                if snapshotTrimmed != "":
                    snapshotInGlobalVarBlock = snapshotTrimmed == "var"
            var snapshotBindName = ""
            var snapshotBindType = ""
            var snapshotRhsCol: int32 = -1
            if !TypedExprParseBindingLine(snapshotRawLine, snapshotBindName, snapshotBindType, snapshotRhsCol):
                if snapshotInGlobalVarBlock && parser.ParserHasLeadingIndent(snapshotRawLine):
                    var snapshotGName = ""
                    var snapshotGType = ""
                    if TypedExprParseTypeFieldLine(snapshotRawLine, snapshotGName, snapshotGType):
                        TypedExprMaybeAddBinding(ctx.bindings, srcPath, "", true,
                                                 true, snapshotLineNum,
                                                 snapshotGName, snapshotGType)
                continue
            if snapshotBindType == "" && snapshotRhsCol > 0:
                snapshotBindType = TypedExprLiteralBindingType(TypedExprBindingRhsText(snapshotRawLine, snapshotRhsCol))
            if snapshotBindType == "" && snapshotRhsCol > 0:
                let snapshotScopeIdx = TypedExprScopeIndexForLine(ctx.scopes, snapshotLineNum)
                if snapshotScopeIdx >= 0:
                    snapshotBindType = TypedExprInferLocalDeclTypeFromIdentRhs(ctx.bindings,
                                                                          ctx.scopes[snapshotScopeIdx].name,
                                                                          snapshotLineNum,
                                                                          TypedExprBindingRhsText(snapshotRawLine, snapshotRhsCol))
            if snapshotBindType == "" && snapshotRhsCol > 0:
                let snapshotScopeIdx = TypedExprScopeIndexForLine(ctx.scopes, snapshotLineNum)
                if snapshotScopeIdx >= 0:
                    snapshotBindType = TypedExprBindingRhsForRangeI32Type(ctx,
                                                                     ctx.scopes[snapshotScopeIdx],
                                                                     snapshotLineNum,
                                                                     TypedExprBindingRhsText(snapshotRawLine, snapshotRhsCol))
            if snapshotBindName != "":
                let snapshotScopeIdx = TypedExprScopeIndexForLine(ctx.scopes, snapshotLineNum)
                var snapshotFnName = ""
                if snapshotScopeIdx >= 0 && snapshotScopeIdx < ctx.scopes.len:
                    snapshotFnName = ctx.scopes[snapshotScopeIdx].name
                TypedExprMaybeAddBinding(
                    ctx.bindings, srcPath, snapshotFnName, false,
                    parser.ParserBindingDeclarationIsMutable(snapshotRawLine),
                    snapshotLineNum, snapshotBindName, snapshotBindType)
        # 找该 source 的 expr 范围 (exprLayer 按 sourcePath 排序)。段首快照 =
        # 推进前 cursor (0a0e732fa 只写了 :25617 用点, 声明与 cursor 推进缺失 →
        # 未声明标识符: cold 静默吞, node 路径 bail=709; 且 cursor 永不推进 →
        # 首源之后所有 source 空段)。
        let sourceExprStart = exprCursor
        var exprEnd: int32
        exprEnd = sourceExprStart
        while exprEnd < exprLayer.exprs.len:
            if exprLayer.exprs[exprEnd].sourcePath != srcPath:
                break
            exprEnd = exprEnd + 1
        exprCursor = exprEnd
        # 找该 source 的 fact 范围
        let sourceFactStart = factCursor
        var factEnd: int32
        factEnd = sourceFactStart
        while factEnd < facts.count:
            let f = TypedExprFactAt(facts, factEnd)
            if f.sourcePath != srcPath:
                break
            factEnd = factEnd + 1
        factCursor = factEnd
        # 遍历该 source 的 scopes
        for scopeIndex in 0..<ctx.scopes.len:
            let scope = ctx.scopes[scopeIndex]
            # filter: skip 不可达 scope (旧版 build 在 scope 循环前 filter stableScopes)
            if filterActive:
                if !TypedExprFunctionFilterAllowsDecl(functionFilterIndex,
                                                      srcPath,
                                                      scope.name,
                                                      scope.startLine):
                    continue
            # 填充 param bindings (旧版 BuildSourceContextBorrowed includeBindings=true)
            if scope.startLine > 0 && scope.startLine <= ctx.lines.len:
                let declHeader = TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine)
                TypedExprAppendParamBindings(ctx.bindings, scope, declHeader)
            # per-scope expr/fact start
            let scopeExprStart = sourceExprStart
            let scopeFactStart = sourceFactStart
            TypedExprBuildIrForScopeWithFactsAndExprLayer(ctx,
                                                          metadataContexts,
                                                          scope,
                                                          facts,
                                                          scopeFactStart,
                                                          factEnd,
                                                          exprLayer,
                                                          normalizedScopeIndex,
                                                          scopeExprStart,
                                                          exprEnd,
                                                          ir)
        TypedExprSourceContextMoveBorrowedIntoExisting(metadataContexts[ctxIndex], ctx)
    return true

# Snapshot build path (no filter): 从 metadataContexts + facts + exprLayer 直建 typedIr.
# PERF-9/snapshot_build 撞名根修: 原与带 filter 的 8 参重载同名 TypedExprSnapshotBuild,
# 自举后端按 (sourcePath, tailName) 解析时 foundCount=2 -> 二义 -> missing_call_target
# (bail=0), 污染编译器 CSG 构建的 8 参路径。
# 4 参版零外部调用, 改名为 TypedExprSnapshotBuildNoFilter 消除同名; 8 参版与其调用点不动。
fn TypedExprSnapshotBuildNoFilter(metadataContexts: var TypedExprSourceContext[],
                        facts: var TypedExprFactTable,
                        exprLayer: var parser.NormalizedExprLayer,
                        ir: var TypedExprIr): bool =
    TypedExprValidateNormalizedDeferFacts(exprLayer)
    var normalizedScopeIndex = TypedExprNormalizedScopeIndexBuild(exprLayer)
    if metadataContexts.len <= 0 || facts.count <= 0:
        return false
    var exprCursor: int32
    var factCursor: int32
    for ctxIndex in 0..<metadataContexts.len:
        var ctx = TypedExprSourceContextBorrowedView(metadataContexts[ctxIndex])
        let srcPath = ctx.sourcePath
        if ctx.lines.len <= 0:
            var reloadSource: TypedExprSourceText
            reloadSource.sourcePath = srcPath
            var reloadErr: str
            if !TypedExprEnsureSourceContextLinesLoaded(reloadSource, ctx, reloadErr):
                continue
        var exprEnd: int32
        exprEnd = exprCursor
        while exprEnd < exprLayer.exprs.len:
            if exprLayer.exprs[exprEnd].sourcePath != srcPath:
                break
            exprEnd = exprEnd + 1
        var factEnd: int32
        factEnd = factCursor
        while factEnd < facts.count:
            let f = TypedExprFactAt(facts, factEnd)
            if f.sourcePath != srcPath:
                break
            factEnd = factEnd + 1
        for scopeIndex in 0..<ctx.scopes.len:
            let scope = ctx.scopes[scopeIndex]
            if scope.startLine <= 0 || scope.startLine > ctx.lines.len:
                continue
            if scope.endLine > ctx.lines.len:
                continue
            while exprCursor < exprEnd && exprLayer.exprs[exprCursor].lineNumber < scope.startLine:
                exprCursor = exprCursor + 1
            while factCursor < factEnd && TypedExprFactAt(facts, factCursor).lineNumber < scope.startLine:
                factCursor = factCursor + 1
            TypedExprBuildIrForScopeWithFactsAndExprLayer(ctx,
                                                          metadataContexts,
                                                          scope,
                                                          facts,
                                                          factCursor,
                                                          factEnd,
                                                          exprLayer,
                                                          normalizedScopeIndex,
                                                          exprCursor,
                                                          exprEnd,
                                                          ir)
        TypedExprSourceContextMoveBorrowedIntoExisting(metadataContexts[ctxIndex], ctx)
    return true
