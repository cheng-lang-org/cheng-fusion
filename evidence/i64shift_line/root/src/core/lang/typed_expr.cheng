fn TypedExprLoweringRulesReportText(rules: TypedExprLoweringRule[]): str =
    var out = ""
    TypedExprReportAppendLine(out, "lowering_rule_count", IntToStr(rules.len))
    TypedExprReportAppendLine(out, "lowering_rule_unique_shape_count", IntToStr(TypedExprLoweringRuleUniqueShapeCount(rules)))
    TypedExprReportAppendLine(out, "lowering_rule_unique_key_count", IntToStr(TypedExprLoweringRuleUniqueKeyCount(rules)))
    TypedExprReportAppendLine(out, "lowering_rule_arg_value_count", IntToStr(TypedExprLoweringRuleCountArgPassKind(rules, TypedExprArgPassValue)))
    TypedExprReportAppendLine(out, "lowering_rule_arg_address_count", IntToStr(TypedExprLoweringRuleCountArgPassKind(rules, TypedExprArgPassAddress)))
    TypedExprReportAppendLine(out, "lowering_rule_arg_call_result_address_count", IntToStr(TypedExprLoweringRuleCountArgPassKind(rules, TypedExprArgPassCallResultAddress)))
    TypedExprReportAppendLine(out, "lowering_rule_result_reg_count", IntToStr(TypedExprLoweringRuleCountResultPassKind(rules, TypedExprResultPassReg)))
    TypedExprReportAppendLine(out, "lowering_rule_result_local_address_count", IntToStr(TypedExprLoweringRuleCountResultPassKind(rules, TypedExprResultPassLocalAddress)))
    TypedExprReportAppendLine(out, "lowering_rule_result_sret_count", IntToStr(TypedExprLoweringRuleCountResultPassKind(rules, TypedExprResultPassSret)))
    TypedExprReportAppendLine(out, "lowering_rule_materialize_register_count", IntToStr(TypedExprLoweringRuleCountMaterializeKind(rules, TypedExprMaterializeRegister)))
    TypedExprReportAppendLine(out, "lowering_rule_materialize_local_slot_count", IntToStr(TypedExprLoweringRuleCountMaterializeKind(rules, TypedExprMaterializeLocalSlot)))
    TypedExprReportAppendLine(out, "lowering_rule_materialize_call_result_local_count", IntToStr(TypedExprLoweringRuleCountMaterializeKind(rules, TypedExprMaterializeCallResultLocal)))
    TypedExprReportAppendLine(out, "lowering_rule_materialize_dest_address_count", IntToStr(TypedExprLoweringRuleCountMaterializeKind(rules, TypedExprMaterializeDestAddress)))
    TypedExprReportAppendLine(out, "lowering_rule_copy_scalar_store_count", IntToStr(TypedExprLoweringRuleCountCopyKind(rules, TypedExprCopyScalarStore)))
    TypedExprReportAppendLine(out, "lowering_rule_copy_region_copy_count", IntToStr(TypedExprLoweringRuleCountCopyKind(rules, TypedExprCopyRegionCopy)))
    TypedExprReportAppendLine(out, "lowering_rule_import_import_buffer_count", IntToStr(TypedExprLoweringRuleCountImportKind(rules, TypedExprImportImportBuffer)))
    TypedExprReportAppendLine(out, "lowering_rule_import_builtin_address_slot_count", IntToStr(TypedExprLoweringRuleCountImportKind(rules, TypedExprImportBuiltinAddressSlot)))
    TypedExprReportAppendLine(out, "lowering_rule_import_i32_value_slot_count", IntToStr(TypedExprLoweringRuleCountImportKind(rules, TypedExprImportI32ValueSlot)))
    TypedExprReportAppendLine(out, "lowering_rule_import_i32_address_slot_count", IntToStr(TypedExprLoweringRuleCountImportKind(rules, TypedExprImportI32AddressSlot)))
    TypedExprReportAppendLine(out, "lowering_rule_type_call_none_count", IntToStr(TypedExprLoweringRuleCountTypeCallKind(rules, TypedExprTypeCallNone)))
    TypedExprReportAppendLine(out, "lowering_rule_type_call_default_init_count", IntToStr(TypedExprLoweringRuleCountTypeCallKind(rules, TypedExprTypeCallDefaultInit)))
    TypedExprReportAppendLine(out, "lowering_rule_type_call_constructor_count", IntToStr(TypedExprLoweringRuleCountTypeCallKind(rules, TypedExprTypeCallConstructor)))
    TypedExprReportAppendLine(out, "lowering_rule_type_call_identity_count", IntToStr(TypedExprLoweringRuleCountTypeCallKind(rules, TypedExprTypeCallIdentity)))
    TypedExprReportAppendLine(out, "lowering_rule_return_root_count", IntToStr(TypedExprLoweringRuleReturnRootCount(rules)))
    for i in 0..<rules.len:
        TypedExprReportAppendLine(out, strutil.Join(["lowering_rule_entry[", IntToStr(i), "]"], ""), TypedExprLoweringRuleEntryText(rules[i]))
    return out

fn TypedExprReportText(facts: var TypedExprFactTable,
                         rules: TypedExprLoweringRule[]): str =
    let factsText = TypedExprFactsReportText(facts)
    let rulesText = TypedExprLoweringRulesReportText(rules)
    return strutil.Join([factsText, rulesText], "")

fn TypedExprLoweringRuleValidateTypeCallMaterialize(rule: var TypedExprLoweringRule,
                                                      err: var str): bool =
    if rule.typeCallKind == TypedExprTypeCallNone:
        return true
    if !TypedExprTypeTextIsConcrete(rule.typeText):
        err = Fmt" typed expr: type-call rule missing concrete type at {rule.sourcePath}:{rule.lineNumber} type={rule.typeText} args={rule.callArgsText}"
        return false
    if rule.callKind != TypedExprCallNone:
        err = " typed expr: type-call rule leaked ordinary call kind"
        return false
    if rule.typeCallKind == TypedExprTypeCallIdentity:
        if rule.callArgCount != 1 || rule.callArgsText == "" ||
           rule.materializeKind != TypedExprMaterializeNone ||
           rule.copyKind != TypedExprCopyNone:
            err = " typed expr: identity type-call rule materialized or copied"
            return false
        err = ""
        return true
    if rule.abiClass == TypedExprAbiScalar || rule.abiClass == TypedExprAbiPointerLike:
        if rule.abiClass == TypedExprAbiScalar && rule.valueKind != TypedExprValueScalar:
            err = " typed expr: type-call scalar conversion value drift"
            return false
        if rule.abiClass == TypedExprAbiPointerLike && rule.valueKind != TypedExprValuePointerLike:
            err = " typed expr: type-call pointer conversion value drift"
            return false
        if rule.placeKind == TypedExprPlaceCallResult:
            err = " typed expr: type-call conversion cannot use call-result place"
            return false
        if rule.loweringMode != TypedExprLowerReg ||
           rule.returnKind != TypedExprReturnReg ||
           rule.argPassKind != TypedExprArgPassValue ||
           rule.resultPassKind != TypedExprResultPassReg ||
           rule.materializeKind != TypedExprMaterializeRegister ||
           rule.copyKind != TypedExprCopyScalarStore:
            err = " typed expr: type-call conversion register lowering drift"
            return false
        err = ""
        return true
    if rule.abiClass != TypedExprAbiComposite ||
       rule.valueKind != TypedExprValueComposite:
        err = " typed expr: type-call rule must materialize composite"
        return false
    if rule.placeKind == TypedExprPlaceCallResult:
        err = " typed expr: type-call rule cannot use call-result place"
        return false
    if rule.argPassKind != TypedExprArgPassAddress:
        err = " typed expr: type-call rule must pass address"
        return false
    if rule.copyKind != TypedExprCopyRegionCopy:
        err = " typed expr: type-call rule must copy region"
        return false
    if rule.loweringMode == TypedExprLowerLocalAddress:
        if rule.returnKind != TypedExprReturnCompositeLocal ||
           rule.resultPassKind != TypedExprResultPassLocalAddress ||
           rule.materializeKind != TypedExprMaterializeLocalSlot:
            err = " typed expr: type-call rule local-address lowering drift"
            return false
        err = ""
        return true
    if rule.loweringMode == TypedExprLowerSret:
        if rule.returnKind != TypedExprReturnSret ||
           rule.resultPassKind != TypedExprResultPassSret ||
           rule.materializeKind != TypedExprMaterializeDestAddress:
            err = " typed expr: type-call rule sret lowering drift"
            return false
        err = ""
        return true
    err = " typed expr: type-call rule missing address lowering"
    return false

fn TypedExprLoweringRulesValidate(rules: var TypedExprLoweringRule[],
                                    err: var str): bool =
    for i in 0..<rules.len:
        if rules[i].exprId == "" || rules[i].sourcePath == "":
            err = strutil.Join([" typed expr: lowering rule missing owner index=",
                                IntToStr(i),
                                " expr=",
                                rules[i].exprId,
                                " source=",
                                rules[i].sourcePath,
                                " line=",
                                IntToStr(rules[i].lineNumber),
                                " column=",
                                IntToStr(rules[i].columnNumber),
                                " callee=",
                                rules[i].callCallee,
                                " target=",
                                rules[i].callTarget], "")
            return false
        if rules[i].callKind == TypedExprCallResultIntrinsic:
            if rules[i].surfaceCallKind != TypedExprSurfaceCallNone ||
               rules[i].callResolved ||
               rules[i].callReason != TypedExprCallReasonNone ||
               rules[i].callQualifier != "" ||
               rules[i].callTarget != "" ||
               rules[i].callTargetSourcePath != "" ||
               rules[i].callTargetSignatureLineNumber != 0 ||
               rules[i].callTargetImportc:
                err = Fmt" typed expr: result intrinsic rule leaked resolved target at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            if rules[i].callCallee == "":
                err = Fmt" typed expr: result intrinsic rule missing callee at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            if rules[i].typeCallKind != TypedExprTypeCallNone:
                err = Fmt" typed expr: result intrinsic rule leaked type-call kind at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            continue
        if rules[i].callKind == TypedExprCallBuiltin &&
           rules[i].surfaceCallKind == TypedExprSurfaceCallNone &&
           rules[i].callCallee == "$":
            if !rules[i].callResolved || rules[i].callReason != TypedExprCallReasonNone:
                err = Fmt" typed expr: stringify builtin rule resolution drift at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            if rules[i].callTarget != "" ||
               rules[i].callTargetSourcePath != "" ||
               rules[i].callTargetSignatureLineNumber != 0 ||
               rules[i].callTargetImportc:
                err = Fmt" typed expr: stringify builtin rule leaked runtime target at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            if rules[i].typeCallKind != TypedExprTypeCallNone:
                err = Fmt" typed expr: stringify builtin rule leaked type-call kind at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            continue
        if rules[i].callKind == TypedExprCallBuiltin &&
           rules[i].surfaceCallKind != TypedExprSurfaceCallNone:
            if !rules[i].callResolved || rules[i].callReason != TypedExprCallReasonNone:
                err = Fmt" typed expr: builtin call rule resolution drift at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            if rules[i].callCallee == "":
                err = Fmt" typed expr: builtin call rule missing callee at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            if rules[i].callTarget != "" ||
               rules[i].callTargetSourcePath != "" ||
               rules[i].callTargetSignatureLineNumber != 0 ||
               rules[i].callTargetImportc:
                let importcText = if rules[i].callTargetImportc: "1" else: "0"
                err = Fmt" typed expr: builtin call rule leaked runtime target at {rules[i].sourcePath}:{rules[i].lineNumber} callee={rules[i].callCallee} target={rules[i].callTarget} target_source={rules[i].callTargetSourcePath} importc={importcText}"
                return false
            if rules[i].typeCallKind != TypedExprTypeCallNone:
                err = Fmt" typed expr: builtin call rule leaked type-call kind at {rules[i].sourcePath}:{rules[i].lineNumber}"
                return false
            continue
        if rules[i].surfaceCallKind == TypedExprSurfaceCallNone:
            if rules[i].callResolved:
                err = Fmt" typed expr: non-call rule leaked callResolved at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].callReason != TypedExprCallReasonNone:
                err = Fmt" typed expr: non-call rule leaked callReason={TypedExprCallReasonText(rules[i].callReason)} at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].callQualifier != "":
                err = Fmt" typed expr: non-call rule leaked callQualifier={rules[i].callQualifier} at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].callCallee != "":
                err = Fmt" typed expr: non-call rule leaked callCallee={rules[i].callCallee} at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].callTarget != "":
                err = Fmt" typed expr: non-call rule leaked callTarget={rules[i].callTarget} at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].callTargetSourcePath != "":
                err = Fmt" typed expr: non-call rule leaked callTargetSourcePath={rules[i].callTargetSourcePath} at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].callTargetSignatureLineNumber != 0:
                err = Fmt" typed expr: non-call rule leaked call declaration identity at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].callTargetImportc:
                err = Fmt" typed expr: non-call rule leaked callTargetImportc at {rules[i].sourcePath}:{rules[i].lineNumber}:{rules[i].columnNumber} expr={rules[i].exprId}"
                return false
            if rules[i].typeCallKind != TypedExprTypeCallNone:
                if !TypedExprLoweringRuleValidateTypeCallMaterialize(rules[i], err):
                    return false
            elif rules[i].callPrefixStyle ||
                 rules[i].callArgCount != 0 ||
                 rules[i].callArgsText != "":
                err = " typed expr: non-call rule leaked call args"
                return false
        else:
            if rules[i].typeCallKind != TypedExprTypeCallNone:
                err = " typed expr: call rule leaked type-call kind"
                return false
            if rules[i].callQualifier == "" &&
               (rules[i].surfaceCallKind == TypedExprSurfaceCallExternal ||
                rules[i].surfaceCallKind == TypedExprSurfaceCallMember):
                if parser.ParserFindText(rules[i].callTarget, ".") >= 0:
                    err = strutil.Join([" typed expr: qualified call rule missing qualifier: target=", rules[i].callTarget, " callee=", rules[i].callCallee, " source=", rules[i].sourcePath, " expr=", rules[i].exprId], "")
                    return false
            if rules[i].callCallee == "" || rules[i].callTarget == "":
                err = " typed expr: call rule missing callee or target"
                return false
            if rules[i].callResolved && rules[i].callReason != TypedExprCallReasonNone:
                err = " typed expr: resolved rule keeps call reason"
                return false
            if !rules[i].callResolved && rules[i].callReason == TypedExprCallReasonNone:
                err = " typed expr: unresolved rule missing call reason"
                return false
            if rules[i].callResolved && rules[i].callTargetSourcePath == "":
                err = " typed expr: resolved rule missing target source"
                return false
            if !rules[i].callResolved && rules[i].callTargetSourcePath != "":
                err = " typed expr: unresolved rule keeps target source"
                return false
            if !rules[i].callResolved && rules[i].callTargetImportc:
                err = " typed expr: unresolved rule keeps importc target"
                return false
            if rules[i].callResolved &&
               ((rules[i].callTargetImportc &&
                 rules[i].callTargetSignatureLineNumber != 0) ||
                (!rules[i].callTargetImportc &&
                 rules[i].callTargetSignatureLineNumber <= 0)):
                err = " typed expr: resolved rule declaration identity invalid"
                return false
            if !rules[i].callResolved &&
               rules[i].callTargetSignatureLineNumber != 0:
                err = " typed expr: unresolved rule keeps declaration identity"
                return false
        if rules[i].typeCallKind != TypedExprTypeCallNone &&
           rules[i].surfaceCallKind != TypedExprSurfaceCallNone:
            err = " typed expr: type-call rule leaked call surface"
            return false
        if (rules[i].abiClass == TypedExprAbiPolymorphic ||
            rules[i].loweringMode == TypedExprLowerDeferred) &&
           (rules[i].argPassKind != TypedExprArgPassDeferred ||
            rules[i].resultPassKind != TypedExprResultPassDeferred ||
            rules[i].materializeKind != TypedExprMaterializeDeferred ||
            rules[i].copyKind != TypedExprCopyDeferred ||
            rules[i].importKind != TypedExprImportDeferred):
            err = " typed expr: deferred rule leaked concrete lowering"
            return false
        if rules[i].importKind == TypedExprImportImportBuffer &&
           rules[i].loweringMode != TypedExprLowerImportBuffer &&
           rules[i].returnKind != TypedExprReturnImportBuffer:
            err = " typed expr: import buffer rule missing import buffer return"
            return false
        if rules[i].copyKind == TypedExprCopyRegionCopy &&
           rules[i].valueKind != TypedExprValueComposite:
            err = " typed expr: region copy rule must stay composite"
            return false
    err = ""
    return true

fn TypedExprBuildLoweringRules(facts: var TypedExprFactTable,
                                 rules: var TypedExprLoweringRule[],
                                 err: var str): bool =
    rules = []
    for i in 0..<facts.count:
        var rule: TypedExprLoweringRule
        TypedExprLoweringRuleFillFromFact(TypedExprFactAt(facts, i), rule)
        add(rules, rule)
    if !TypedExprLoweringRulesValidate(rules, err):
        return false
    err = ""
    return true

fn TypedExprValidateLoweringRulesFromFacts(facts: var TypedExprFactTable,
                                            ruleCount: var int32,
                                            err: var str): bool =
    ruleCount = 0
    var singleRule: TypedExprLoweringRule[]
    for i in 0..<facts.count:
        singleRule = []
        var rule: TypedExprLoweringRule
        TypedExprLoweringRuleFillFromFact(TypedExprFactAt(facts, i), rule)
        add(singleRule, rule)
        if !TypedExprLoweringRulesValidate(singleRule, err):
            return false
        ruleCount = ruleCount + 1
    err = ""
    return true

fn TypedExprConcat3(a: str, b: str, c: str): str =
    return strutil.Join([a, b, c], "")

fn TypedExprConcat4(a: str, b: str, c: str, d: str): str =
    return strutil.Join([a, b, c, d], "")

var gNormTypePool: langintern.InternPool
var gNormTypeValues: str[]

@borrows
fn TypedExprNormalizeTypeTextUncached(typeRaw: str): str =
    let trimmed: str = chengpath.PathTrim(share(typeRaw))
    if trimmed == "":
        return ""
    if trimmed == "void" || trimmed == "str" || trimmed == "cstring" ||
       trimmed == "ptr" ||
       trimmed == "bool" || trimmed == "char" ||
       trimmed == "int32" || trimmed == "int64" ||
       trimmed == "uint32" || trimmed == "uint64":
        return trimmed
    var hasInnerSpace = false
    for i in 0..<trimmed.len:
        let scan = trimmed[i]
        if scan == ' ' || scan == '\t' || scan == '\n' || scan == '\r':
            hasInnerSpace = true
            break
    if !hasInnerSpace:
        return trimmed
    var out = buffer.NewByteBuffer()
    for i in 0..<trimmed.len:
        let piece = trimmed[i]
        if piece == ' ':
            continue
        if piece == '\t':
            continue
        if piece == '\n':
            continue
        if piece == '\r':
            continue
        buffer.AppendByte(out, int32(piece))
    return rawbytes.BytesToString(buffer.ToBytes(out))

# Borrow mode is call-resolution metadata, not part of a Cheng runtime type.
# Keep it behind a source-impossible marker so a legal type name such as
# `variant` can never be mistaken for the old normalized `var T` spelling.
@borrows
fn TypedExprCallBorrowModeInner(typeRaw: str,
                                innerTypeOut: var str): bool =
    innerTypeOut = ""
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    let marker = "@borrow:"
    if typeText.len < marker.len ||
       !parser.ParserStartsWith(typeText, marker):
        return false
    if typeText.len == marker.len:
        panic("typed expr: empty internal borrow-mode type")
    innerTypeOut = TypedExprNormalizeTypeText(chengpath.TextSlice(
        typeText, marker.len, typeText.len - marker.len))
    if innerTypeOut == "" || parser.ParserStartsWith(innerTypeOut, marker):
        panic("typed expr: malformed internal borrow-mode type")
    return true

var gNormTypeMemoHits: int64
var gNormTypeMemoMiss: int64

@borrows
fn TypedExprNormalizeTypeText(typeRaw: str): str =
    if gNormTypePool == nil:
        gNormTypePool = langintern.InternPoolNew()
    let keyId = langintern.FindInternId(gNormTypePool, typeRaw)
    if keyId >= 0 && keyId < gNormTypeValues.len:
        gNormTypeMemoHits = gNormTypeMemoHits + 1
        return strings.CloneStr(gNormTypeValues[keyId])
    gNormTypeMemoMiss = gNormTypeMemoMiss + 1
    let fresh = TypedExprNormalizeTypeTextUncached(typeRaw)
    let newId = langintern.Intern(gNormTypePool, typeRaw)
    while gNormTypeValues.len <= newId:
        add(gNormTypeValues, "")
    gNormTypeValues[newId] = strings.CloneStr(fresh)
    return fresh

fn TypedExprCallBorrowModeType(typeRaw: str): str =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        panic("typed expr: borrow-mode type missing runtime type")
    var nestedInner = ""
    if TypedExprCallBorrowModeInner(typeText, nestedInner):
        panic("typed expr: duplicate internal borrow-mode type")
    return Fmt"@borrow:{typeText}"

@borrows
fn TypedExprCallRuntimeType(typeRaw: str): str =
    var innerType = ""
    if TypedExprCallBorrowModeInner(typeRaw, innerType):
        return innerType
    return TypedExprNormalizeTypeText(typeRaw)

@borrows
fn TypedExprCallParamType(param: TypedExprParam): str =
    let runtimeType = TypedExprNormalizeTypeText(param.typeText)
    if runtimeType == "":
        return ""
    if param.mutableFlag:
        return TypedExprCallBorrowModeType(runtimeType)
    return runtimeType

@borrows
fn TypedExprSourceTextManifestPackageFacts(packageRootRaw: str,
                                            packageId: var str,
                                            packageChannel: var str) =
    packageId = ""
    packageChannel = ""
    let packageRoot = parser.ParserNormalizePath(packageRootRaw)
    if packageRoot == "":
        return
    let manifestText = parser.ParserPackageManifestText(packageRoot)
    packageId = parser.ParserManifestNormalizePackageId(parser.ParserManifestValue(manifestText,
                                                                                    "package_id"))
    if packageId == "":
        return
    packageChannel = parser.ParserManifestValidatedChannel(parser.ParserManifestValue(manifestText,
                                                                                       "channel"),
                                                            packageId)

fn TypedExprSourceTextNewWithPackageFacts(workspaceRoot: str,
                                           packageRoot: str,
                                           packageIdRaw: str,
                                           packageChannelRaw: str,
                                           externalPackageRoots: parser.ParserExternalPackageRoot[],
                                           sourcePath: str,
                                           text: str): TypedExprSourceText =
    var out: TypedExprSourceText
    out.workspaceRoot = parser.ParserNormalizePath(workspaceRoot)
    out.packageRoot = parser.ParserNormalizePath(packageRoot)
    out.packageId = parser.ParserManifestNormalizePackageId(packageIdRaw)
    out.packageChannel = parser.ParserManifestValidatedChannel(packageChannelRaw,
                                                                out.packageId)
    out.externalPackageRoots = parser.ParserExternalPackageRootsClone(externalPackageRoots)
    out.sourcePath = parser.ParserNormalizePath(sourcePath)
    out.text = text
    out.textLoaded = true
    return out

@borrows
fn TypedExprSourceTextBorrowPackageFacts(workspaceRoot: str,
                                          packageRoot: str,
                                          packageIdRaw: str,
                                          packageChannelRaw: str,
                                          externalPackageRoots: parser.ParserExternalPackageRoot[],
                                          sourcePath: str,
                                          text: str): TypedExprSourceText =
    var out: TypedExprSourceText
    out.workspaceRoot = parser.ParserNormalizePath(workspaceRoot)
    out.packageRoot = parser.ParserNormalizePath(packageRoot)
    out.packageId = parser.ParserManifestNormalizePackageId(packageIdRaw)
    out.packageChannel = parser.ParserManifestValidatedChannel(packageChannelRaw,
                                                                out.packageId)
    out.externalPackageRoots = externalPackageRoots
    out.sourcePath = parser.ParserNormalizePath(sourcePath)
    out.text = text
    out.textLoaded = true
    return out

fn TypedExprSourceTextNewWithExternalPackageRoots(workspaceRoot: str,
                                                    packageRoot: str,
                                                    externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                    sourcePath: str,
                                                    text: str): TypedExprSourceText =
    var packageId: str
    var packageChannel: str
    TypedExprSourceTextManifestPackageFacts(packageRoot, packageId, packageChannel)
    return TypedExprSourceTextNewWithPackageFacts(workspaceRoot,
                                                   packageRoot,
                                                   packageId,
                                                   packageChannel,
                                                   externalPackageRoots,
                                                   sourcePath,
                                                   text)

@borrows
fn TypedExprSourceTextBorrowExternalPackageRoots(workspaceRoot: str,
                                                   packageRoot: str,
                                                   externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                   sourcePath: str,
                                                   text: str): TypedExprSourceText =
    var packageId: str
    var packageChannel: str
    TypedExprSourceTextManifestPackageFacts(packageRoot, packageId, packageChannel)
    return TypedExprSourceTextBorrowPackageFacts(workspaceRoot,
                                                  packageRoot,
                                                  packageId,
                                                  packageChannel,
                                                  externalPackageRoots,
                                                  sourcePath,
                                                  text)

fn TypedExprSourceTextNew(workspaceRoot: str,
                            packageRoot: str,
                            sourcePath: str,
                            text: str): TypedExprSourceText =
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    return TypedExprSourceTextNewWithExternalPackageRoots(workspaceRoot,
                                                            packageRoot,
                                                            externalPackageRoots,
                                                            sourcePath,
                                                            text)

fn TypedExprResultType(innerTypeRaw: str): str =
    let innerType = TypedExprNormalizeTypeText(innerTypeRaw)
    if innerType == "":
        return ""
    return TypedExprConcat3("Result[", innerType, "]")

@borrows
fn TypedExprResultSuccessType(typeRaw: str): str =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    # `var b: result.Result[rawbytes.Bytes]` 等限定写法把模块别名 `result.` 留在
    # 类型文本前导(全树罕见但 bytes.cheng readFileBytes/readFileSlice 用此形态)。
    # normalize 只去空白不剥别名,致 Result[ 前缀判定失败、Value 投影内型解析返空。
    # 剥「首个 `[` 之前的最后一个 `.`」前的限定段(括号内 `rawbytes.Bytes` 的内层
    # `.` 在 `[` 之后不被波及),裸 `Result[...]` 因 `[` 前无 `.` 恒等不变。
    var resultHead = typeText
    let rsBracketPos = parser.ParserFindText(resultHead, "[")
    if rsBracketPos > 0:
        var rsDotPos: int32 = -1
        for rsScan in 0..<rsBracketPos:
            if resultHead[rsScan] == '.':
                rsDotPos = rsScan
        if rsDotPos >= 0 && rsDotPos + 1 < resultHead.len:
            resultHead = chengpath.TextSlice(resultHead,
                                             rsDotPos + 1,
                                             resultHead.len - rsDotPos - 1)
    if !parser.ParserStartsWith(resultHead, "Result["):
        return ""
    if resultHead.len <= 8:
        return ""
    if chengpath.TextSlice(share(resultHead), resultHead.len - 1, 1) != "]":
        return ""
    return chengpath.TextSlice(resultHead, Len("Result["), resultHead.len - Len("Result[") - 1)

@borrows
fn TypedExprTypeIsScalar(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    if typeText == "":
        return false
    if typeText == "void":
        return true
    if typeText == "bool" || typeText == "char":
        return true
    if typeText == "int" || typeText == "uint":
        return true
    if typeText == "int8" || typeText == "uint8" || typeText == "u8":
        return true
    if typeText == "int16" || typeText == "uint16" || typeText == "u16":
        return true
    if typeText == "int32" || typeText == "uint32" || typeText == "u32":
        return true
    if typeText == "int64" || typeText == "uint64" || typeText == "u64":
        return true
    if typeText == "float32" || typeText == "float64":
        return true
    return false

# 非浮点标量 (bool/char/各宽整数): 供 PointerLike↔整数标量互转放行臂判定,
# 浮点标量 (float32/float64) 与指针互转不在其列。
fn TypedExprTypeIsIntegerScalar(typeRaw: str): bool =
    if !TypedExprTypeIsScalar(typeRaw):
        return false
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    return typeText != "float32" && typeText != "float64"

@borrows
fn TypedExprTypeIsPointerLike(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    if typeText == "cstring":
        return true
    if typeText == "ptr":
        return true
    if parser.ParserStartsWith(typeText, "ref"):
        return true
    if parser.ParserStartsWith(typeText, "ptr["):
        return true
    if parser.ParserStartsWith(typeText, "Pointer["):
        return true
    return false

@borrows
fn TypedExprTypeIsComposite(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    if typeText == "":
        return false
    if typeText == "str" ||
       typeText == "Bytes" ||
       typeText == "bytes.Bytes" ||
       typeText == "rawbytes.Bytes":
        return true
    if typeText == "rawbytes" || typeText == "ErrorInfo" || typeText == "range":
        return true
    if typeText == "BigInt" || typeText == "bigint.BigInt":
        return true
    if parser.ParserStartsWith(typeText, "Result["):
        return true
    if parser.ParserStartsWith(typeText, "seq["):
        return true
    if parser.ParserStartsWith(typeText, "tuple["):
        return true
    if parser.ParserStartsWith(typeText, "array["):
        return true
    if parser.ParserStartsWith(typeText, "object["):
        return true
    if typeText.len >= 2 && chengpath.TextSlice(share(typeText), typeText.len - 2, 2) == "[]":
        return true
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let afterQualifier = chengpath.PathTrim(chengpath.TextSlice(share(typeText), dotPos + 1, typeText.len - dotPos - 1))
        if afterQualifier != "" && afterQualifier != typeText:
            return TypedExprTypeIsComposite(afterQualifier)
    return false

@borrows
fn TypedExprAbiClassForType(typeRaw: str): TypedExprAbiClass =
    if TypedExprTypeIsScalar(typeRaw):
        return TypedExprAbiScalar
    if TypedExprTypeIsPointerLike(typeRaw):
        return TypedExprAbiPointerLike
    if TypedExprTypeIsComposite(typeRaw):
        return TypedExprAbiComposite
    return TypedExprAbiPolymorphic

fn TypedExprValueKindForAbiClass(abiClass: TypedExprAbiClass): TypedExprValueKind =
    if abiClass == TypedExprAbiScalar:
        return TypedExprValueScalar
    if abiClass == TypedExprAbiComposite:
        return TypedExprValueComposite
    if abiClass == TypedExprAbiPointerLike:
        return TypedExprValuePointerLike
    return TypedExprValuePolymorphic

@borrows
fn TypedExprSkipInlineSpaces(lineRaw: str,
                               start: int32): int32 =
    var cursor = start
    for i in start..<lineRaw.len:
        if parser.ParserIsInlineSpace(lineRaw[i]):
            cursor = i + 1
        else:
            return i
    return cursor

@borrows
fn TypedExprFindMatchingPair(lineRaw: str,
                               openPos: int32,
                               openText: str,
                               closeText: str): int32 =
    if openPos < 0:
        return -1
    if openPos >= lineRaw.len:
        return -1
    if openText.len != 1 || closeText.len != 1:
        return -1
    let openCh = openText[0]
    let closeCh = closeText[0]
    if lineRaw[openPos] != openCh:
        return -1
    var depth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in openPos..<lineRaw.len:
        let piece = lineRaw[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
        elif piece == '\'':
            inChar = true
        elif piece == openCh:
            depth = depth + 1
        elif piece == closeCh:
            depth = depth - 1
            if depth == 0:
                return i
    return -1

@borrows
fn TypedExprFindMatchingParen(lineRaw: str,
                                openPos: int32): int32 =
    return TypedExprFindMatchingPair(lineRaw, openPos, "(", ")")

@borrows
fn TypedExprFindMatchingBracket(lineRaw: str,
                                  openPos: int32): int32 =
    return TypedExprFindMatchingPair(lineRaw, openPos, "[", "]")

@borrows
fn TypedExprSliceTrim(textRaw: str,
                        start: int32,
                        count: int32): str =
    if start < 0 || count <= 0:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(textRaw, start, count))

@borrows
fn TypedExprFindTopLevelToken(textRaw: str,
                                target: str): int32 =
    if target.len != 1:
        return TypedExprFindTopLevelTextToken(textRaw, target)
    let targetCh = target[0]
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    for i in 0..<textRaw.len:
        let piece = textRaw[i]
        # An opening delimiter belongs to the surrounding depth before it
        # opens its nested region. Check the requested token first so callers
        # can locate a top-level generic/type-argument bracket.
        if piece == targetCh &&
           bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            return i
        if piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
    return -1

@borrows
fn TypedExprFindWholeCallOpenParen(rhsRaw: str): int32 =
    let rhs = chengpath.PathTrim(share(rhsRaw))
    if rhs == "":
        return -1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<rhs.len:
        let piece = rhs[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
        elif piece == '\'':
            inChar = true
        elif piece == '(':
            if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
                return i
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
    return -1

@borrows
fn TypedExprCallHeadIsPlainQualifiedIdent(callHeadRaw: str): bool =
    var genericTypes: str[]
    var explicit = false
    var callHead = ""
    var genericErr: str
    if !TypedExprCallHeadGenericTypesInto(callHeadRaw,
                                           genericTypes,
                                           explicit,
                                           callHead,
                                           genericErr):
        return false
    let parts = parser.ParserSplitChar(callHead, '.')
    if parts.len <= 0:
        return false
    for i in 0..<parts.len:
        let part = chengpath.PathTrim(share(parts[i]))
        if part == "":
            return false
        if parser.ParserIdentPrefix(part) != part:
            return false
    return true

# Extract the sole explicit type argument from a call head such as
# `load[uint8]` or `system.load[uint8]`.  The result is usable as runtime type
# evidence only when the argument is concrete; missing, multiple, and still-
# generic arguments remain unresolved.
fn TypedExprCallHeadSingleConcreteGenericType(callHeadRaw: str): str =
    var genericTypes: str[]
    var explicit = false
    var baseHead: str
    var err: str
    if !TypedExprCallHeadGenericTypesInto(callHeadRaw,
                                           genericTypes,
                                           explicit,
                                           baseHead,
                                           err) ||
       !explicit || genericTypes.len != 1:
        return ""
    let genericType = genericTypes[0]
    if !TypedExprTypeTextIsConcrete(genericType) ||
       TypedExprTypeIsGenericPlaceholder(genericType):
        return ""
    return genericType

@borrows
fn TypedExprTextAt(textRaw: str,
                    start: int32,
                    target: str): bool =
    if start < 0 || strings.Len(target) <= 0:
        return false
    if start + strings.Len(target) > strings.Len(textRaw):
        return false
    for i in 0..<strings.Len(target):
        if textRaw[start + i] != target[i]:
            return false
    return true

fn TypedExprTrimmedLineRange(lineRaw: str,
                               lineStart: var int32,
                               lineStop: var int32): bool =
    lineStart = 0
    lineStop = lineRaw.len
    while lineStart < lineStop:
        let code = Int32(lineRaw[lineStart])
        if code != 32 && code != 9 && code != 13 && code != 10:
            break
        lineStart = lineStart + 1
    while lineStop > lineStart:
        let code = Int32(lineRaw[lineStop - 1])
        if code != 32 && code != 9 && code != 13 && code != 10:
            break
        lineStop = lineStop - 1
    return lineStart < lineStop

@borrows
fn TypedExprReadFunctionDeclsLinesInto(lines: str[],
                                         migrationSourceSyntax: bool,
                                         decls: var parser.NormalizedFunctionDecl[],
                                         err: var str): bool =
    let readOk = migrationSourceSyntax ?
        parser.ParserReadMigrationSourceFunctionDeclsLines(lines,
                                                            decls,
                                                            err) :
        parser.ParserReadNormalizedFunctionDeclsLines(lines, decls, err)
    if !readOk:
        return false
    err = ""
    return true

@borrows
fn TypedExprFindTopLevelTextToken(textRaw: str,
                                   target: str): int32 =
    if strings.Len(target) <= 0 || strings.Len(target) > strings.Len(textRaw):
        return -1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    for i in 0..<textRaw.len:
        let piece = textRaw[i]
        if piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            if TypedExprTextAt(textRaw, i, target):
                if target == "-":
                    if i + 1 < textRaw.len:
                        if textRaw[i + 1] == '>':
                            continue
                if target == ">":
                    if i > 0:
                        if textRaw[i - 1] == '-':
                            continue
                return i
    return -1

@borrows
fn TypedExprFindTopLevelBitwiseTextToken(textRaw: str,
                                          target: str): int32 =
    if Len(target) != 1 || Len(textRaw) <= 0:
        return -1
    let token = target[0]
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    for i in 0..<textRaw.len:
        let piece = textRaw[i]
        if piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif bracketDepth == 0 && parenDepth == 0 && braceDepth == 0 && piece == token:
            var prevSame = false
            if i > 0:
                prevSame = textRaw[i - 1] == token
            var nextSame = false
            if i + 1 < textRaw.len:
                nextSame = textRaw[i + 1] == token
            if !prevSame && !nextSame:
                return i
    return -1

@borrows
fn TypedExprParseFunctionReturnType(lineRaw: str): str =
    let line = chengpath.PathTrim(lineRaw)
    let openPos = parser.ParserFindText(line, "(")
    if openPos < 0:
        return ""
    let closePos = TypedExprFindMatchingParen(line, openPos)
    if closePos < 0:
        return ""
    let cursor0 = TypedExprSkipInlineSpaces(line, closePos + 1)
    var cursor = cursor0
    if cursor >= line.len:
        return ""
    var markerLen: int32
    if cursor + 1 < line.len && chengpath.TextSlice(line, cursor, 2) == "->":
        markerLen = 2
    elif chengpath.TextSlice(line, cursor, 1) == ":":
        markerLen = 1
    else:
        return ""
    cursor = TypedExprSkipInlineSpaces(line, cursor + markerLen)
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var endPos = line.len
    for i in cursor..<line.len:
        let ch = line[i]
        if ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
        elif ch == '=':
            if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
                endPos = i
                break
        elif ch == ':':
            if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
                let tail = chengpath.PathTrim(chengpath.TextSlice(line,
                                                                  i + 1,
                                                                  line.len - i - 1))
                if tail == "":
                    endPos = i
                    break
    if endPos <= cursor:
        return ""
    return TypedExprNormalizeTypeText(chengpath.TextSlice(line, cursor, endPos - cursor))

@borrows
fn TypedExprSourceContextLineCount(ctx: TypedExprSourceContext): int32 =
    if ctx.lineNumbers.len > 0:
        return ctx.sourceLineCount
    return ctx.lines.len

@borrows
fn TypedExprSourceContextLineIndex(ctx: TypedExprSourceContext,
                                   lineNumber: int32): int32 =
    if lineNumber <= 0:
        return -1
    if ctx.lineNumbers.len == 0:
        return lineNumber <= ctx.lines.len ? lineNumber - 1 : -1
    var low: int32
    var high = ctx.lineNumbers.len
    while low < high:
        let mid = low + (high - low) / 2
        if ctx.lineNumbers[mid] < lineNumber:
            low = mid + 1
        else:
            high = mid
    if low < ctx.lineNumbers.len && ctx.lineNumbers[low] == lineNumber:
        return low
    return -1

@borrows
fn TypedExprSourceContextStoredLineNumber(
        ctx: TypedExprSourceContext,
        lineIndex: int32): int32 =
    if lineIndex < 0 || lineIndex >= ctx.lines.len:
        return -1
    if ctx.lineNumbers.len > 0:
        if lineIndex >= ctx.lineNumbers.len:
            panic("typed expr: packed source line columns mismatch")
        return ctx.lineNumbers[lineIndex]
    return lineIndex + 1

@borrows
fn TypedExprSourceContextLineText(ctx: TypedExprSourceContext,
                                  lineNumber: int32): str =
    let lineIndex = TypedExprSourceContextLineIndex(ctx, lineNumber)
    if lineIndex < 0:
        return ""
    return ctx.lines[lineIndex]

@borrows
fn TypedExprRoutineHeaderLineEndsWithColon(text: str): bool =
    return text.len > 0 && text[text.len - 1] == ':'

# Form-B 冒号续头共享扫描: 配平 `):` 之后的返回类型区逐物理行找顶层 `=`。
# region 深度跨行累积(括号/方括号/花括号未配平时下一物理行仍属同一返回类型
# 段, 镜像 parser 逻辑行续行); 命中 depth-0 `=` 返回 true, suiteInline 表示
# `=` 同行有后随 token(行内套件, 镜像 parser.cheng:24934-24941 帽规则的
# 并体形); 连续两个 `=`(比较符)跳过不算套件赋值。
@borrows
fn TypedExprRoutineHeaderSuiteAssignScan(trimmed: str,
                                         regionParen: var int32,
                                         regionBracket: var int32,
                                         regionBrace: var int32,
                                         suiteInline: var bool): bool =
    var j = 0
    while j < trimmed.len:
        let ch = trimmed[j]
        if ch == '(':
            regionParen = regionParen + 1
        elif ch == ')':
            regionParen = regionParen - 1
        elif ch == '[':
            regionBracket = regionBracket + 1
        elif ch == ']':
            regionBracket = regionBracket - 1
        elif ch == '{':
            regionBrace = regionBrace + 1
        elif ch == '}':
            regionBrace = regionBrace - 1
        elif ch == '=' && regionParen == 0 && regionBracket == 0 &&
             regionBrace == 0:
            if j + 1 < trimmed.len && trimmed[j + 1] == '=':
                j = j + 1
            else:
                suiteInline = j + 1 < trimmed.len
                return true
        j = j + 1
    return false

@borrows
fn TypedExprFunctionDeclHeaderTextForContext(
        ctx: TypedExprSourceContext,
        lineNumber: int32): str =
    if lineNumber <= 0 || lineNumber > TypedExprSourceContextLineCount(ctx):
        return ""
    var header = chengpath.PathTrim(
        TypedExprSourceContextLineText(ctx, lineNumber))
    var parenDepth: int32
    for byteIndex in 0..<header.len:
        if header[byteIndex] == '(':
            parenDepth = parenDepth + 1
        elif header[byteIndex] == ')':
            parenDepth = parenDepth - 1
    var needSuiteAssign = parenDepth <= 0 &&
        TypedExprRoutineHeaderLineEndsWithColon(header)
    if parenDepth <= 0 && !needSuiteAssign:
        return header
    let lineCount = TypedExprSourceContextLineCount(ctx)
    var nextLineNumber = lineNumber + 1
    if parenDepth > 0:
        for scanLineNumber in (lineNumber + 1)..lineCount:
            let lineRaw = TypedExprSourceContextLineText(ctx, scanLineNumber)
            let trimmed = chengpath.PathTrim(share(lineRaw))
            nextLineNumber = scanLineNumber + 1
            if trimmed.len <= 0:
                continue
            if !parser.ParserHasLeadingIndent(lineRaw) && parenDepth <= 0:
                break
            header = Fmt"{header} {trimmed}"
            for byteIndex in 0..<trimmed.len:
                if trimmed[byteIndex] == '(':
                    parenDepth = parenDepth + 1
                elif trimmed[byteIndex] == ')':
                    parenDepth = parenDepth - 1
            if parenDepth <= 0:
                needSuiteAssign = TypedExprRoutineHeaderLineEndsWithColon(header)
                break
    # Form-B 冒号续头: 配平后拼接行以顶层 `:` 收尾(`):` 行尾换行、返回类型
    # 独占更深缩进的下一物理行)时, 继续拼入直到含顶层 `=` 的行(镜像
    # parser.cheng:24934-24941 帽规则: 行尾 `=` 止于 `=` 后, 行内 `=` 并体)。
    # 拼不到 `=`(前向桩/下一顶层声明)头保持无顶层 `=`, 前向桩跳过口径不变。
    if needSuiteAssign:
        var regionParen: int32
        var regionBracket: int32
        var regionBrace: int32
        var suiteInline = false
        while nextLineNumber <= lineCount:
            let lineRaw = TypedExprSourceContextLineText(ctx, nextLineNumber)
            let trimmed = chengpath.PathTrim(share(lineRaw))
            nextLineNumber = nextLineNumber + 1
            if trimmed.len <= 0:
                continue
            if !parser.ParserHasLeadingIndent(lineRaw):
                break
            header = Fmt"{header} {trimmed}"
            if TypedExprRoutineHeaderSuiteAssignScan(trimmed, regionParen,
                                                     regionBracket, regionBrace,
                                                     suiteInline):
                break
            if regionParen == 0 && regionBracket == 0 && regionBrace == 0 &&
               !TypedExprRoutineHeaderLineEndsWithColon(trimmed):
                break
    return header

@borrows
fn TypedExprFunctionDeclHeaderText(lines: str[],
                                    lineIndex: int32): str =
    if lineIndex <= 0 || lineIndex > lines.len:
        return ""
    var header = chengpath.PathTrim(share(lines[lineIndex - 1]))
    var parenDepth: int32
    for i in 0..<header.len:
        if header[i] == '(':
            parenDepth = parenDepth + 1
        elif header[i] == ')':
            parenDepth = parenDepth - 1
    var needSuiteAssign = parenDepth <= 0 &&
        TypedExprRoutineHeaderLineEndsWithColon(header)
    if parenDepth <= 0 && !needSuiteAssign:
        return header
    var cursor = lineIndex
    if parenDepth > 0:
        for i in lineIndex..<lines.len:
            let lineRaw = lines[i]
            let trimmed = chengpath.PathTrim(share(lineRaw))
            cursor = i + 1
            if strings.Len(trimmed) <= 0:
                continue
            # 多行签名约定:参数列表逐行缩进,闭合行 `): RetType =` 顶格(无缩进)。
            # 原先「无缩进即 break」会在拼接闭合行之前退出,丢掉携带返回类型的
            # `): coreir.BodyIR =` 段 → scope.returnType="" → 该函数被解析成 void,
            # 致 `var x = MultiLineSigFn(...)` 的 x 记成 void、后续 x.field 字段 leaf
            # 解析失败 → 条件 no_node。括号未平衡(parenDepth>0)时仍在签名内,顶格闭合
            # 行属于 header,必须拼入;只在括号已平衡后遇无缩进行才停(下一顶层声明)。
            if !parser.ParserHasLeadingIndent(lineRaw) && parenDepth <= 0:
                break
            header = Fmt"{header} {trimmed}"
            for j in 0..<trimmed.len:
                if trimmed[j] == '(':
                    parenDepth = parenDepth + 1
                elif trimmed[j] == ')':
                    parenDepth = parenDepth - 1
            if parenDepth <= 0:
                needSuiteAssign = TypedExprRoutineHeaderLineEndsWithColon(header)
                break
    # Form-B 冒号续头: 配平后拼接行以顶层 `:` 收尾(`):` 行尾换行、返回类型
    # 独占更深缩进的下一物理行)时, 继续拼入直到含顶层 `=` 的行(镜像
    # parser.cheng:24934-24941 帽规则: 行尾 `=` 止于 `=` 后, 行内 `=` 并体)。
    # 拼不到 `=`(前向桩/下一顶层声明)头保持无顶层 `=`, :53120 前向桩跳过
    # 口径不变(零判词放宽)。
    if needSuiteAssign:
        var regionParen: int32
        var regionBracket: int32
        var regionBrace: int32
        var suiteInline = false
        while cursor < lines.len:
            let lineRaw = lines[cursor]
            let trimmed = chengpath.PathTrim(share(lineRaw))
            cursor = cursor + 1
            if strings.Len(trimmed) <= 0:
                continue
            if !parser.ParserHasLeadingIndent(lineRaw):
                break
            header = Fmt"{header} {trimmed}"
            if TypedExprRoutineHeaderSuiteAssignScan(trimmed, regionParen,
                                                     regionBracket, regionBrace,
                                                     suiteInline):
                break
            if regionParen == 0 && regionBracket == 0 && regionBrace == 0 &&
               !TypedExprRoutineHeaderLineEndsWithColon(trimmed):
                break
    return header

@borrows
fn TypedExprFunctionDeclBodyStartIndex(lines: str[],
                                        lineIndex: int32): int32 =
    if lineIndex <= 0 || lineIndex > lines.len:
        return lineIndex
    var parenDepth: int32
    let first = chengpath.PathTrim(share(lines[lineIndex - 1]))
    for i in 0..<first.len:
        if first[i] == '(':
            parenDepth = parenDepth + 1
        elif first[i] == ')':
            parenDepth = parenDepth - 1
    var needSuiteAssign = parenDepth <= 0 &&
        TypedExprRoutineHeaderLineEndsWithColon(first)
    if parenDepth <= 0 && !needSuiteAssign:
        return lineIndex
    var cursor = lineIndex
    var regionParen: int32
    var regionBracket: int32
    var regionBrace: int32
    var suiteInline = false
    while cursor < lines.len:
        let lineRaw = lines[cursor]
        let trimmed = chengpath.PathTrim(share(lineRaw))
        cursor = cursor + 1
        if Len(trimmed) <= 0:
            continue
        # 多行签名约定:参数逐行缩进,闭合行 `): RetType =` 顶格(无缩进)。括号
        # 未平衡(parenDepth>0)时仍在签名内,顶格闭合行属于签名,不能当 body 起点;
        # 必须先计入其 `)` 使 parenDepth 归零、再返回其后一行。镜像
        # TypedExprFunctionDeclHeaderText 的同款修复——否则顶格 `): T =` 被当签名
        # 结束返回,致 TypedExprFunctionBodyLine 在该无缩进行立刻 break →
        # bodyLineNumber=0 → 该函数被误当前向声明从函数集剔除 → missing_call_target。
        if !parser.ParserHasLeadingIndent(lineRaw) &&
           (needSuiteAssign || parenDepth <= 0):
            return cursor - 1
        if !needSuiteAssign:
            for j in 0..<trimmed.len:
                if trimmed[j] == '(':
                    parenDepth = parenDepth + 1
                elif trimmed[j] == ')':
                    parenDepth = parenDepth - 1
            if parenDepth <= 0:
                # Form-B(`):` 行尾换行): 配平行以顶层 `:` 收尾, 返回类型独占后续
                # 缩进行, body 起点须跳过它(镜像 HeaderText 冒号续头, 否则返回
                # 类型行被当 body 首行)。
                if TypedExprRoutineHeaderLineEndsWithColon(trimmed):
                    needSuiteAssign = true
                else:
                    return cursor
        elif TypedExprRoutineHeaderSuiteAssignScan(trimmed, regionParen,
                                                   regionBracket, regionBrace,
                                                   suiteInline):
            # 行尾 `=` → body 在下一缩进行; `=` 同行并体 → body 即本行。
            if suiteInline:
                return cursor - 1
            return cursor
        elif regionParen == 0 && regionBracket == 0 && regionBrace == 0 &&
             !TypedExprRoutineHeaderLineEndsWithColon(trimmed):
            # 防御: 返回类型区无顶层 `=`(未注册形态, 正常到不了这里)。
            return cursor - 1
    return cursor

@borrows
fn TypedExprFunctionDeclBodyStartLineForContext(
        ctx: TypedExprSourceContext,
        lineNumber: int32): int32 =
    if lineNumber <= 0 || lineNumber > TypedExprSourceContextLineCount(ctx):
        return lineNumber
    var parenDepth: int32
    let first = chengpath.PathTrim(
        TypedExprSourceContextLineText(ctx, lineNumber))
    for byteIndex in 0..<first.len:
        if first[byteIndex] == '(':
            parenDepth = parenDepth + 1
        elif first[byteIndex] == ')':
            parenDepth = parenDepth - 1
    var needSuiteAssign = parenDepth <= 0 &&
        TypedExprRoutineHeaderLineEndsWithColon(first)
    if parenDepth <= 0 && !needSuiteAssign:
        return lineNumber + 1
    var cursor = lineNumber + 1
    let lineCount = TypedExprSourceContextLineCount(ctx)
    var regionParen: int32
    var regionBracket: int32
    var regionBrace: int32
    var suiteInline = false
    while cursor <= lineCount:
        let lineRaw = TypedExprSourceContextLineText(ctx, cursor)
        let trimmed = chengpath.PathTrim(share(lineRaw))
        cursor = cursor + 1
        if trimmed.len <= 0:
            continue
        if !parser.ParserHasLeadingIndent(lineRaw) &&
           (needSuiteAssign || parenDepth <= 0):
            return cursor - 1
        if !needSuiteAssign:
            for byteIndex in 0..<trimmed.len:
                if trimmed[byteIndex] == '(':
                    parenDepth = parenDepth + 1
                elif trimmed[byteIndex] == ')':
                    parenDepth = parenDepth - 1
            if parenDepth <= 0:
                # Form-B(`):` 行尾换行): 配平行以顶层 `:` 收尾, 返回类型独占
                # 后续缩进行, body 起点须跳过它(镜像 HeaderText 冒号续头)。
                if TypedExprRoutineHeaderLineEndsWithColon(trimmed):
                    needSuiteAssign = true
                else:
                    return cursor
        elif TypedExprRoutineHeaderSuiteAssignScan(trimmed, regionParen,
                                                   regionBracket, regionBrace,
                                                   suiteInline):
            # 行尾 `=` → body 在下一缩进行; `=` 同行并体 → body 即本行。
            if suiteInline:
                return cursor - 1
            return cursor
        elif regionParen == 0 && regionBracket == 0 && regionBrace == 0 &&
             !TypedExprRoutineHeaderLineEndsWithColon(trimmed):
            # 防御: 返回类型区无顶层 `=`(未注册形态, 正常到不了这里)。
            return cursor - 1
    return cursor

fn TypedExprBodyTextAfterEquals(lineRaw: str): str =
    let eqPos = TypedExprFindTopLevelTextToken(lineRaw, "=")
    if eqPos < 0:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(lineRaw, eqPos + 1, lineRaw.len - eqPos - 1))

@borrows
fn TypedExprFunctionBodyLine(ctx: TypedExprSourceContext,
                              scope: TypedExprFunctionScope,
                              bodyLineNumber: var int32): str =
    bodyLineNumber = 0
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return ""
    let declHeader = TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine)
    let inlineBody = TypedExprBodyTextAfterEquals(declHeader)
    if inlineBody != "":
        bodyLineNumber = scope.startLine
        return inlineBody
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    var lineEnd = TypedExprSourceContextLineCount(ctx)
    if scope.endLine > 0 && scope.endLine < lineEnd:
        lineEnd = scope.endLine
    for lineNumber in bodyStartLine..lineEnd:
        let bodyRaw = TypedExprSourceContextLineText(ctx, lineNumber)
        let bodyTrim = chengpath.PathTrim(share(bodyRaw))
        if bodyTrim == "":
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        bodyLineNumber = lineNumber
        return bodyTrim
    return ""

@borrows
fn TypedExprFunctionTopLevelReturnExpr(ctx: TypedExprSourceContext,
                                        scope: TypedExprFunctionScope,
                                        returnLineNumber: var int32): str =
    returnLineNumber = 0
    var bodyIndent: int32 = -1
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return ""
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    var lineEnd = TypedExprSourceContextLineCount(ctx)
    if scope.endLine > 0 && scope.endLine < lineEnd:
        lineEnd = scope.endLine
    for lineNumber in bodyStartLine..lineEnd:
        let bodyRaw = TypedExprSourceContextLineText(ctx, lineNumber)
        let bodyTrim = chengpath.PathTrim(share(bodyRaw))
        if bodyTrim == "":
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        let lineIndent = TypedExprLineIndentWidth(bodyRaw)
        if bodyIndent < 0:
            bodyIndent = lineIndent
        if lineIndent != bodyIndent:
            continue
        if parser.ParserStartsWith(bodyTrim, "return "):
            returnLineNumber = lineNumber
            return TypedExprReturnExprFromBody(bodyTrim)
    return ""

@borrows
fn TypedExprFunctionSingleExpressionBodyExpr(ctx: TypedExprSourceContext,
                                             scope: TypedExprFunctionScope,
                                             returnLineNumber: var int32): str =
    returnLineNumber = 0
    if scope.returnType == "" || scope.returnType == "void":
        return ""
    if scope.startLine > 0 &&
       scope.startLine <= TypedExprSourceContextLineCount(ctx):
        # Single-line body: fn name(args): type = expr
        let declRaw = chengpath.PathTrim(
            TypedExprSourceContextLineText(ctx, scope.startLine))
        if parser.ParserStartsWith(declRaw, "fn "):
            let declOpen = parser.ParserFindText(declRaw, "(")
            if declOpen > 0:
                let declClose = TypedExprFindMatchingParen(declRaw, declOpen)
                if declClose > declOpen:
                    var declEq = -1
                    var declScan = declClose + 1
                    while declScan + 1 < len(declRaw):
                        if declRaw[declScan] == '=' && declRaw[declScan + 1] != '=':
                            declEq = declScan
                            break
                        declScan = declScan + 1
                    if declEq > 0 && declEq + 1 < len(declRaw):
                        let declBody = chengpath.PathTrim(chengpath.TextSlice(declRaw,
                                                                              declEq + 1,
                                                                              len(declRaw) - declEq - 1))
                        if declBody != "":
                            returnLineNumber = scope.startLine
                            return declBody
    var bodyIndent: int32 = -1
    var bodyCount: int32
    var exprText = ""
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    var lineEnd = TypedExprSourceContextLineCount(ctx)
    if scope.endLine > 0 && scope.endLine < lineEnd:
        lineEnd = scope.endLine
    for lineNumber in bodyStartLine..lineEnd:
        let bodyRaw = TypedExprSourceContextLineText(ctx, lineNumber)
        let bodyTrim = chengpath.PathTrim(share(bodyRaw))
        if bodyTrim == "":
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        let lineIndent = TypedExprLineIndentWidth(bodyRaw)
        if bodyIndent < 0:
            bodyIndent = lineIndent
        if lineIndent != bodyIndent:
            return ""
        bodyCount = bodyCount + 1
        if bodyCount > 1:
            return ""
        exprText = bodyTrim
        returnLineNumber = lineNumber
    if bodyCount != 1:
        return ""
    if parser.ParserStartsWith(exprText, "let ") ||
       parser.ParserStartsWith(exprText, "var ") ||
       parser.ParserStartsWith(exprText, "const ") ||
       parser.ParserStartsWith(exprText, "if ") ||
       parser.ParserStartsWith(exprText, "elif ") ||
       parser.ParserStartsWith(exprText, "else") ||
       parser.ParserStartsWith(exprText, "for ") ||
       parser.ParserStartsWith(exprText, "while ") ||
       parser.ParserStartsWith(exprText, "case ") ||
       parser.ParserStartsWith(exprText, "return ") ||
       parser.ParserStartsWith(exprText, "yield ") ||
       parser.ParserStartsWith(exprText, "break") ||
       parser.ParserStartsWith(exprText, "continue"):
        return ""
    return exprText

@borrows
fn TypedExprFunctionParamsOwned(lineRaw: str): TypedExprParam[] =
    var params: TypedExprParam[]
    TypedExprFunctionParamsInto(lineRaw, params)
    return params

@borrows
fn TypedExprFunctionParamsInto(lineRaw: str,
                               out: var TypedExprParam[]) =
    TypedExprTraceLine("typed_function_params:enter")
    out = []
    let line = chengpath.PathTrim(lineRaw)
    TypedExprTraceLine("typed_function_params:after_trim")
    let openPos = parser.ParserFindText(line, "(")
    if openPos < 0:
        return
    TypedExprTraceLine("typed_function_params:before_matching")
    let closePos = TypedExprFindMatchingParen(line, openPos)
    TypedExprTraceLine("typed_function_params:after_matching")
    if closePos <= openPos:
        return
    var itemStart = openPos + 1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var paramRawItems: str[]
    var cursor = itemStart
    while cursor <= closePos:
        TypedExprTraceLine("typed_function_params:param_loop")
        let atEnd = cursor >= closePos
        var splitHere = atEnd
        if !atEnd:
            let ch = line[cursor]
            if ch == '[':
                bracketDepth = bracketDepth + 1
            elif ch == ']':
                bracketDepth = bracketDepth - 1
            elif ch == '(':
                parenDepth = parenDepth + 1
            elif ch == ')':
                parenDepth = parenDepth - 1
            elif ch == '{':
                braceDepth = braceDepth + 1
            elif ch == '}':
                braceDepth = braceDepth - 1
            elif ch == ',':
                if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
                    splitHere = true
        if splitHere:
            TypedExprTraceLine("typed_function_params:before_item_parse")
            let rawItem = TypedExprSliceTrim(share(line), itemStart, cursor - itemStart)
            if rawItem != "":
                add(paramRawItems, rawItem)
            TypedExprTraceLine("typed_function_params:after_item_parse")
            itemStart = cursor + 1
        cursor = cursor + 1
    for paramItemIndex in 0..<paramRawItems.len:
        var item = paramRawItems[paramItemIndex]
        var paramMutable = false
        if parser.ParserStartsWith(item, "var "):
            paramMutable = true
            item = chengpath.TextSlice(item, 4, item.len - 4)
        let colonPos = TypedExprFindTopLevelTextToken(item, ":")
        if colonPos > 0:
            var typeText = chengpath.TextSlice(item, colonPos + 1, item.len - colonPos - 1)
            let eqPos = TypedExprFindTopLevelTextToken(typeText, "=")
            if eqPos >= 0:
                typeText = chengpath.TextSlice(typeText, 0, eqPos)
            let trimmedTypeText = chengpath.PathTrim(typeText)
            var runtimeTypeText = ""
            if parser.ParserStartsWith(trimmedTypeText, "var "):
                paramMutable = true
                runtimeTypeText = chengpath.PathTrim(chengpath.TextSlice(
                    trimmedTypeText, 4, trimmedTypeText.len - 4))
            else:
                runtimeTypeText = trimmedTypeText
            var param: TypedExprParam
            param.name = parser.ParserIdentPrefix(chengpath.PathTrim(chengpath.TextSlice(item, 0, colonPos)))
            param.typeText = TypedExprNormalizeTypeText(runtimeTypeText)
            param.mutableFlag = paramMutable
            if param.name != "" && param.typeText != "":
                add(out, param)
            continue
        # Grouped parameter (`a, b: T`): a bare name inherits the type of
        # the next annotated item. Dropping it would desync every later
        # parameter register and read.
        let groupedBareName = parser.ParserIdentPrefix(chengpath.PathTrim(share(item)))
        if groupedBareName == "" || groupedBareName != chengpath.PathTrim(item):
            continue
        var groupedTypeText = ""
        var groupedMutable = paramMutable
        for groupedJ in paramItemIndex + 1..<paramRawItems.len:
            var groupedItem = paramRawItems[groupedJ]
            if parser.ParserStartsWith(groupedItem, "var "):
                groupedMutable = true
                groupedItem = chengpath.TextSlice(groupedItem, 4, groupedItem.len - 4)
            let groupedColon = TypedExprFindTopLevelTextToken(groupedItem, ":")
            if groupedColon <= 0:
                continue
            var groupedTail = chengpath.TextSlice(groupedItem, groupedColon + 1, groupedItem.len - groupedColon - 1)
            let groupedEq = TypedExprFindTopLevelTextToken(groupedTail, "=")
            if groupedEq >= 0:
                groupedTail = chengpath.TextSlice(groupedTail, 0, groupedEq)
            if parser.ParserStartsWith(chengpath.PathTrim(share(groupedTail)),
                                       "var "):
                groupedMutable = true
                let trimmedGroupedTail = chengpath.PathTrim(groupedTail)
                groupedTypeText = chengpath.PathTrim(chengpath.TextSlice(
                    trimmedGroupedTail, 4, trimmedGroupedTail.len - 4))
            else:
                groupedTypeText = groupedTail
            break
        if groupedTypeText == "":
            continue
        var groupedParam: TypedExprParam
        groupedParam.name = groupedBareName
        groupedParam.typeText = TypedExprNormalizeTypeText(groupedTypeText)
        groupedParam.mutableFlag = groupedMutable
        if groupedParam.name != "" && groupedParam.typeText != "":
            add(out, groupedParam)

@borrows
fn TypedExprFunctionParams(lineRaw: str): TypedExprParam[] =
    var out: TypedExprParam[]
    TypedExprFunctionParamsInto(lineRaw, out)
    return out

@borrows
fn TypedExprFunctionParamTypeInHeader(lineRaw: str,
                                      targetName: str): str =
    if targetName == "":
        return ""
    let line = chengpath.PathTrim(lineRaw)
    let openPos = parser.ParserFindText(line, "(")
    if openPos < 0:
        return ""
    let closePos = TypedExprFindMatchingParen(line, openPos)
    if closePos <= openPos:
        return ""
    var itemStart = openPos + 1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var cursor = itemStart
    while cursor <= closePos:
        let atEnd = cursor >= closePos
        var splitHere = atEnd
        if !atEnd:
            let ch = line[cursor]
            if ch == '[':
                bracketDepth = bracketDepth + 1
            elif ch == ']':
                bracketDepth = bracketDepth - 1
            elif ch == '(':
                parenDepth = parenDepth + 1
            elif ch == ')':
                parenDepth = parenDepth - 1
            elif ch == '{':
                braceDepth = braceDepth + 1
            elif ch == '}':
                braceDepth = braceDepth - 1
            elif ch == ',':
                if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
                    splitHere = true
        if splitHere:
            var item = TypedExprSliceTrim(share(line), itemStart, cursor - itemStart)
            if parser.ParserStartsWith(item, "var "):
                item = chengpath.TextSlice(item, 4, item.len - 4)
            let colonPos = TypedExprFindTopLevelTextToken(item, ":")
            if colonPos > 0:
                let paramName = parser.ParserIdentPrefix(chengpath.PathTrim(chengpath.TextSlice(item, 0, colonPos)))
                if paramName == targetName:
                    var typeText = chengpath.TextSlice(item, colonPos + 1, item.len - colonPos - 1)
                    let eqPos = TypedExprFindTopLevelTextToken(typeText, "=")
                    if eqPos >= 0:
                        typeText = chengpath.TextSlice(typeText, 0, eqPos)
                    return TypedExprNormalizeTypeText(typeText)
            itemStart = cursor + 1
        cursor = cursor + 1
    return ""

@borrows
fn TypedExprReturnExprFromBody(bodyText: str): str =
    let trimmed = chengpath.PathTrim(share(bodyText))
    if parser.ParserStartsWith(trimmed, "return "):
        return chengpath.PathTrim(chengpath.TextSlice(trimmed, 7, trimmed.len - 7))
    return trimmed

fn TypedExprIrNodeNew(): TypedExprIrNode =
    var node: TypedExprIrNode
    node.fieldTypeSourcePath = ""
    node.fieldOffsetBytes = 0
    node.fieldSizeBytes = 0
    node.fieldAlignBytes = 0
    node.fieldProducerSourceIndex = -1
    node.fieldOwnerDeclarationSourceLocalRow = -1
    node.fieldDeclarationSourceLocalRow = -1
    node.fieldOrdinal = -1
    node.fieldBuiltinKind =
        Int32(TypedExprLayoutBuiltinNone)
    return node

fn TypedExprIrAddNode(ir: var TypedExprIr,
                       node: TypedExprIrNode): int32 =
    var out = node
    out.nodeIndex = ir.nodes2_nodeIndexs.len
    TypedExprIrAppendNode(ir, share(out))
    return out.nodeIndex

@borrows
fn TypedExprIrParamRefIndexHash(sourcePath: str,
                                 functionName: str,
                                 paramName: str,
                                 bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(sourcePath):
        h = h * 31 + int32(sourcePath[i])
    h = h * 31 + 10
    for i in 0..<len(functionName):
        h = h * 31 + int32(functionName[i])
    h = h * 31 + 10
    for i in 0..<len(paramName):
        h = h * 31 + int32(paramName[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

fn TypedExprIrParamRefIndexRegister(ir: var TypedExprIr,
                                     sourcePath: str,
                                     functionName: str,
                                     paramName: str,
                                     nodeIndex: int32) =
    if nodeIndex < 0:
        return
    if ir.paramRefIndexBucketHeads.len <= 0:
        for bucketIndex in 0..<16384:
            add(ir.paramRefIndexBucketHeads, -1)
    let bucket = TypedExprIrParamRefIndexHash(sourcePath,
                                              functionName,
                                              paramName,
                                              ir.paramRefIndexBucketHeads.len)
    if bucket < 0:
        return
    let entryIndex = ir.paramRefIndexEntryNodeIndexes.len
    add(ir.paramRefIndexEntryNodeIndexes, nodeIndex)
    add(ir.paramRefIndexEntrySourcePaths, sourcePath)
    add(ir.paramRefIndexEntryFunctionNames, functionName)
    add(ir.paramRefIndexEntryParamNames, paramName)
    add(ir.paramRefIndexEntryNext, ir.paramRefIndexBucketHeads[bucket])
    ir.paramRefIndexBucketHeads[bucket] = entryIndex

fn TypedExprIrParamRefIndexBuildAll(ir: var TypedExprIr) =
    if ir.paramRefIndexBucketHeads.len > 0:
        return
    for bucketIndex in 0..<16384:
        add(ir.paramRefIndexBucketHeads, -1)
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        if ir.nodes2_opKinds[nodeIndex] != TypedExprIrOpParamRef:
            continue
        let srcRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_sourcePathIds[nodeIndex])
        let fnRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_functionNameIds[nodeIndex])
        let nameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_paramNameIds[nodeIndex])
        if !IsOk(srcRes) || !IsOk(fnRes) || !IsOk(nameRes):
            panic("typed expr: param ref index build intern miss")
        TypedExprIrParamRefIndexRegister(ir,
                                         Value(srcRes),
                                         Value(fnRes),
                                         Value(nameRes),
                                         nodeIndex)

fn TypedExprIrAddParamNode(ir: var TypedExprIr,
                            sourcePath: str,
                            functionName: str,
                            lineNumber: int32,
                            param: TypedExprParam,
                            paramSlot: int32,
                            structuralTypeId: int32): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginParameter
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = share(sourcePath)
    node.functionName = share(functionName)
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpParamRef
    node.resultType = param.typeText
    # Parameter value-defs freeze the exact ParamRef ownership before any
    # BindingInitializer/CallResult row is appended. A managed parameter is a
    # borrowed place at this node; unmanaged scalar types remain Unmanaged.
    node.exprClass = TypedExprIrExprClassForResultTypeExact(
        ir, sourcePath, node.resultType, TypedExprExprBorrowed)
    typedExprIrBindNodeStructuralType(
        ir,
        node,
        structuralTypeId)
    node.surfaceText = share(param.name)
    node.paramSlot = paramSlot
    node.paramName = share(param.name)
    node.paramMutableFlag = param.mutableFlag
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    let paramNodeIndex = TypedExprIrAddNode(ir, node)
    TypedExprIrParamRefIndexRegister(ir,
                                     sourcePath,
                                     functionName,
                                     share(param.name),
                                     paramNodeIndex)
    return paramNodeIndex

@borrows
fn typedExprIrScopeParserFunctionIdentityExact(
        ir: var TypedExprIr,
        scope: TypedExprFunctionScope,
        producerSourceIndexOut: var int32,
        functionRowOut: var int32): int32 =
    producerSourceIndexOut = -1
    functionRowOut = -1
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil ||
       scope.producerDeclarationOrdinal < 0:
        panic("typed expr value definition: parser function scope identity unavailable")
    let tree = ir.valueExprTree
    var sourceFunctionOrdinals: int32[]
    var maxProducerSourceIndex: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        if producerSourceIndex > maxProducerSourceIndex:
            maxProducerSourceIndex = producerSourceIndex
    setLen(sourceFunctionOrdinals, maxProducerSourceIndex + 1)
    var matchedDeclarationRow: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationFunction):
            continue
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sourceFunctionOrdinals.len:
            panic("typed expr value definition: function producer source invalid")
        let sourceFunctionOrdinal =
            sourceFunctionOrdinals[producerSourceIndex]
        sourceFunctionOrdinals[producerSourceIndex] =
            sourceFunctionOrdinal + 1
        if sourceFunctionOrdinal != scope.producerDeclarationOrdinal ||
           (ir.valueExprTransactionParserProducerSourceIndex >= 0 &&
            producerSourceIndex !=
                ir.valueExprTransactionParserProducerSourceIndex):
            continue
        if matchedDeclarationRow >= 0:
            panic("typed expr value definition: parser function identity ambiguous")
        matchedDeclarationRow = declarationRow
        producerSourceIndexOut = producerSourceIndex
        functionRowOut = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationFunctionRows,
            declarationRow)
    if matchedDeclarationRow < 0 || producerSourceIndexOut < 0 ||
       functionRowOut < 0:
        panic("typed expr value definition: parser function identity missing")
    return matchedDeclarationRow

@borrows
fn typedExprIrParamStructuralTypeIdsExact(
        ir: var TypedExprIr,
        scope: TypedExprFunctionScope,
        paramCount: int32,
        structuralTypeIds: var int32[]) =
    if paramCount < 0:
        panic("typed expr value definition: parameter count invalid")
    setLen(structuralTypeIds, paramCount)
    for ordinal in 0..<paramCount:
        structuralTypeIds[ordinal] = -1
    if !ir.valueExprTreeBorrowLease:
        return
    if ir.valueExprTree == nil || ir.exactTypeArena == nil ||
       !ir.valueDefinitionTypeArenaBound ||
       arenamod.ArenaArrayInt32Len(
           ir.arena,
           ir.valueExprTransactionParameterOrdinalsByDeclarationRow) !=
           ir.valueExprTree.declarationCount:
        panic("typed expr value definition: parameter exact type authority unavailable")
    var parserProducerSourceIndex: int32
    var parserFunctionRow: int32
    let _ = typedExprIrScopeParserFunctionIdentityExact(
        ir, scope, parserProducerSourceIndex, parserFunctionRow)
    if parserFunctionRow < 0 ||
       parserFunctionRow >=
           ir.valueExprTransactionParameterCountsByFunctionRow.len ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueExprTransactionParameterCountsByFunctionRow,
           parserFunctionRow) != paramCount:
        panic("typed expr value definition: parser/ABI parameter count drift")
    var matchedCount: int32
    for declarationRow in 0..<ir.valueExprTree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               ir.valueExprTree.arena,
               ir.valueExprTree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationParameter) ||
           arenamod.ArenaArrayInt32Get(
               ir.valueExprTree.arena,
               ir.valueExprTree.declarationProducerSourceIndexes,
               declarationRow) != parserProducerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.valueExprTree.arena,
               ir.valueExprTree.declarationFunctionRows,
               declarationRow) != parserFunctionRow:
            continue
        let ordinal = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueExprTransactionParameterOrdinalsByDeclarationRow,
            declarationRow)
        if ordinal < 0 || ordinal >= paramCount ||
           structuralTypeIds[ordinal] >= 0:
            panic("typed expr value definition: parameter ordinal split")
        let typeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            ir.valueExprTree.arena,
            ir.valueExprTree.declarationTypeSyntaxRootIndexes,
            declarationRow)
        if typeSyntaxRoot < 0:
            panic("typed expr value definition: parameter TypeSyntax missing")
        let structuralTypeId =
            typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                ir.exactTypeArena, typeSyntaxRoot)
        if structuralTypeId < 0:
            panic("typed expr value definition: parameter exact TypeId missing")
        structuralTypeIds[ordinal] = structuralTypeId
        matchedCount = matchedCount + 1
    if matchedCount != paramCount:
        panic("typed expr value definition: parameter exact type coverage incomplete")

@borrows
fn TypedExprIrAddParamNodes(ir: var TypedExprIr,
                             scope: TypedExprFunctionScope,
                             params: TypedExprParam[],
                             paramNodeIndices: var int32[]) =
    paramNodeIndices = []
    ir.valueExprCurrentParamDefinitionNodeIndexes = []
    ir.valueExprCurrentParamValueDefinitionRows = []
    ir.valueExprCurrentParserFunctionRow = -1
    var structuralTypeIds: int32[]
    typedExprIrParamStructuralTypeIdsExact(
        ir, scope, params.len, structuralTypeIds)
    for i in 0..<params.len:
        var structuralTypeId = structuralTypeIds[i]
        if !ir.valueExprTreeBorrowLease:
            structuralTypeId =
                typedExprIrReservedScalarTypeIdForRuntimeType(
                    ir, params[i].typeText)
        if structuralTypeId < 0:
            panic("typed expr value definition: parameter exact TypeId unavailable")
        let nodeIndex = TypedExprIrAddParamNode(ir,
                                                share(scope.sourcePath),
                                                share(scope.name),
                                                scope.startLine,
                                                share(params[i]),
                                                i,
                                                structuralTypeId)
        add(paramNodeIndices, nodeIndex)
        add(ir.valueExprCurrentParamDefinitionNodeIndexes, nodeIndex)

@borrows
fn typedExprIrBindFunctionManualConsumeEffect(
        ir: var TypedExprIr,
        scope: TypedExprFunctionScope,
        fnIr: var TypedExprIrFunction) =
    fnIr.manualConsumePresent = scope.manualConsumePresent
    fnIr.manualConsumeFunctionDeclarationRow =
        scope.manualConsumeFunctionDeclarationRow
    fnIr.manualConsumeTargetParameterOrdinal =
        scope.manualConsumeTargetParameterOrdinal
    fnIr.manualConsumeSourceParameterOrdinal =
        scope.manualConsumeSourceParameterOrdinal
    fnIr.manualConsumeTargetParameterDeclarationRow =
        scope.manualConsumeTargetParameterDeclarationRow
    fnIr.manualConsumeSourceParameterDeclarationRow =
        scope.manualConsumeSourceParameterDeclarationRow
    if !scope.manualConsumePresent:
        if !typedExprManualConsumeEffectAbsent(
               false,
               scope.manualConsumeFunctionDeclarationRow,
               scope.manualConsumeTargetParameterOrdinal,
               scope.manualConsumeSourceParameterOrdinal,
               scope.manualConsumeTargetParameterDeclarationRow,
               scope.manualConsumeSourceParameterDeclarationRow,
               scope.manualConsumeTargetTypeId,
               scope.manualConsumeSourceTypeId,
               scope.manualConsumeEffectCid):
            panic("typed expr: absent scope manual-consume effect non-empty")
        return
    let declarationOwner = typedExprIrCallDeclarationOwnerIndex(ir)
    if declarationOwner == nil || declarationOwner.released ||
       !declarationOwner.callDeclarationSealed ||
       !declarationOwner.callDeclarationManualConsumeTypeArenaBound:
        panic("typed expr: function manual-consume build-index authority missing")
    var parserProducerSourceIndex: int32
    var producerFunctionRow: int32
    let functionDeclarationRow =
        typedExprIrScopeParserFunctionIdentityExact(
            ir, scope, parserProducerSourceIndex, producerFunctionRow)
    let producerSourceIndex =
        ir.valueExprTransactionProducerSourceIndex
    if producerSourceIndex < 0:
        panic("typed expr: function manual-consume stable producer missing")
    if arenamod.ArenaArrayInt32Get(
           ir.valueExprTree.arena,
           ir.valueExprTree.declarationSourceLocalRows,
           functionDeclarationRow) !=
           scope.manualConsumeFunctionDeclarationRow:
        panic("typed expr: function manual-consume declaration identity drift")
    var callDeclarationRow: int32 = -1
    for row in 0..<typedExprBuildIndexCallDeclarationCount(
            declarationOwner):
        if declarationOwner.callDeclarationKinds[row] !=
               TypedExprCallDeclarationFunction ||
           declarationOwner.callDeclarationProducerSourceIndexes[row] !=
               producerSourceIndex ||
           declarationOwner.callDeclarationProducerDeclarationOrdinals[row] !=
               scope.producerDeclarationOrdinal ||
           declarationOwner.callDeclarationProducerFunctionRows[row] !=
               producerFunctionRow:
            continue
        if callDeclarationRow >= 0:
            panic("typed expr: function manual-consume call producer ambiguous")
        callDeclarationRow = row
    if callDeclarationRow < 0 ||
       !declarationOwner.callDeclarationManualConsumePresents[
           callDeclarationRow] ||
       declarationOwner.callDeclarationManualConsumeFunctionDeclarationRows[
           callDeclarationRow] !=
           scope.manualConsumeFunctionDeclarationRow ||
       declarationOwner.callDeclarationManualConsumeTargetParameterOrdinals[
           callDeclarationRow] !=
           scope.manualConsumeTargetParameterOrdinal ||
       declarationOwner.callDeclarationManualConsumeSourceParameterOrdinals[
           callDeclarationRow] !=
           scope.manualConsumeSourceParameterOrdinal ||
       declarationOwner.callDeclarationManualConsumeTargetParameterDeclarationRows[
           callDeclarationRow] !=
           scope.manualConsumeTargetParameterDeclarationRow ||
       declarationOwner.callDeclarationManualConsumeSourceParameterDeclarationRows[
           callDeclarationRow] !=
           scope.manualConsumeSourceParameterDeclarationRow:
        panic("typed expr: function manual-consume call effect identity drift")
    fnIr.manualConsumeTargetTypeId =
        declarationOwner.callDeclarationManualConsumeTargetTypeIds[
            callDeclarationRow]
    fnIr.manualConsumeSourceTypeId =
        declarationOwner.callDeclarationManualConsumeSourceTypeIds[
            callDeclarationRow]
    fnIr.manualConsumeEffectCid = layout.FixedBytes32Copy(
        declarationOwner.callDeclarationManualConsumeEffectCids[
            callDeclarationRow])
    let expectedEffectCid = typedExprManualConsumeEffectCid(
        ir.valueDefinitionTypeArenaArtifactCid,
        producerSourceIndex,
        scope.producerDeclarationOrdinal,
        producerFunctionRow,
        scope.manualConsumeFunctionDeclarationRow,
        scope.manualConsumeTargetParameterOrdinal,
        scope.manualConsumeSourceParameterOrdinal,
        scope.manualConsumeTargetParameterDeclarationRow,
        scope.manualConsumeSourceParameterDeclarationRow,
        fnIr.manualConsumeTargetTypeId,
        fnIr.manualConsumeSourceTypeId)
    if !layout.FixedBytes32Equal(
           fnIr.manualConsumeEffectCid, expectedEffectCid):
        panic("typed expr: function manual-consume effect CID drift")

@borrows
fn TypedExprIrAppendParameterValueDefinitionsExact(
        ir: var TypedExprIr,
        scope: TypedExprFunctionScope,
        typedFunctionIndex: int32) =
    if typedFunctionIndex != ir.functions2_functionNameIds.len ||
       ir.valueExprCurrentParamValueDefinitionRows.len != 0:
        panic("typed expr value definition: parameter producer state invalid")
    var parserProducerSourceIndex: int32
    var parserFunctionRow: int32
    let _ = typedExprIrScopeParserFunctionIdentityExact(
        ir, scope, parserProducerSourceIndex, parserFunctionRow)
    let producerSourceIndex =
        ir.valueExprTransactionProducerSourceIndex
    if producerSourceIndex < 0:
        panic("typed expr value definition: parameter stable producer missing")
    let parameterCount = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueExprTransactionParameterCountsByFunctionRow,
        parserFunctionRow)
    if parameterCount !=
           ir.valueExprCurrentParamDefinitionNodeIndexes.len:
        panic("typed expr value definition: parser/ABI parameter count drift")
    setLen(ir.valueExprCurrentParamValueDefinitionRows, parameterCount)
    for ordinal in 0..<parameterCount:
        ir.valueExprCurrentParamValueDefinitionRows[ordinal] = -1
    for declarationRow in 0..<ir.valueExprTree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               ir.valueExprTree.arena,
               ir.valueExprTree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationParameter) ||
           arenamod.ArenaArrayInt32Get(
               ir.valueExprTree.arena,
               ir.valueExprTree.declarationFunctionRows,
               declarationRow) != parserFunctionRow:
            continue
        let ordinal = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueExprTransactionParameterOrdinalsByDeclarationRow,
            declarationRow)
        if ordinal < 0 || ordinal >= parameterCount ||
           ir.valueExprCurrentParamValueDefinitionRows[ordinal] != -1:
            panic("typed expr value definition: parameter ordinal split")
        let declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.valueExprTree.arena,
            ir.valueExprTree.declarationSourceLocalRows,
            declarationRow)
        let parameterNodeIndex =
            ir.valueExprCurrentParamDefinitionNodeIndexes[ordinal]
        let definitionOwnership =
            typedExprIrParameterDefinitionOwnershipExact(
                ir, parameterNodeIndex, scope.borrowsArguments)
        let definitionRow = typedExprIrAppendValueDefinitionExact(
            ir,
            TypedExprValueDefinitionOriginParameter,
            producerSourceIndex,
            -1,
            declarationSourceLocalRow,
            -1,
            typedFunctionIndex,
            parameterNodeIndex,
            -1,
            definitionOwnership)
        ir.valueExprCurrentParamValueDefinitionRows[ordinal] =
            definitionRow
    for ordinal in 0..<parameterCount:
        if ir.valueExprCurrentParamValueDefinitionRows[ordinal] < 0:
            panic("typed expr value definition: parameter coverage incomplete")
    ir.valueExprCurrentParserFunctionRow = parserFunctionRow

@borrows
fn TypedExprIrAppendMissingCallResultValueDefinitionsExact(
        ir: var TypedExprIr,
        scope: TypedExprFunctionScope,
        typedFunctionIndex: int32,
        nodeStart: int32) =
    var parserProducerSourceIndex: int32
    var parserFunctionRow: int32
    let _ = typedExprIrScopeParserFunctionIdentityExact(
        ir, scope, parserProducerSourceIndex, parserFunctionRow)
    let producerSourceIndex =
        ir.valueExprTransactionProducerSourceIndex
    if producerSourceIndex < 0:
        panic("typed expr value definition: CallResult stable producer missing")
    if ir.valueExprCurrentParserFunctionRow != parserFunctionRow ||
       nodeStart < 0 || nodeStart > ir.nodes2_nodeIndexs.len:
        panic("typed expr value definition: CallResult function identity drift")
    for nodeIndex in nodeStart..<ir.nodes2_nodeIndexs.len:
        if ir.nodes2_opKinds[nodeIndex] != TypedExprIrOpCallExpr ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_producedValueDefinitionRows,
               nodeIndex) >= 0:
            continue
        let sourceLocalNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_originParserNodeIds,
            nodeIndex)
        if sourceLocalNodeIndex < 0 ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_syntheticOriginKinds,
               nodeIndex) != TypedExprSyntheticOriginNone:
            panic("typed expr value definition: CallResult parser origin missing")
        let _ = typedExprIrAppendValueDefinitionExact(
            ir,
            TypedExprValueDefinitionOriginCallResult,
            producerSourceIndex,
            sourceLocalNodeIndex,
            -1,
            -1,
            typedFunctionIndex,
            nodeIndex,
            -1,
            ir.nodes2_exprClasses[nodeIndex])

@borrows
fn TypedExprIrAppendMissingManagedTemporaryValueDefinitionsExact(
        ir: var TypedExprIr,
        scope: TypedExprFunctionScope,
        typedFunctionIndex: int32,
        nodeStart: int32) =
    var parserProducerSourceIndex: int32
    var parserFunctionRow: int32
    let _ = typedExprIrScopeParserFunctionIdentityExact(
        ir, scope, parserProducerSourceIndex, parserFunctionRow)
    let producerSourceIndex =
        ir.valueExprTransactionProducerSourceIndex
    if producerSourceIndex < 0:
        panic("typed expr value definition: managed temporary stable producer missing")
    if ir.valueExprCurrentParserFunctionRow != parserFunctionRow ||
       nodeStart < 0 || nodeStart > ir.nodes2_nodeIndexs.len:
        panic("typed expr value definition: managed temporary function identity drift")
    for nodeIndex in nodeStart..<ir.nodes2_nodeIndexs.len:
        if !TypedExprIrOpIsExactManagedTemporaryProducer(
               ir.nodes2_opKinds[nodeIndex]) ||
           ir.nodes2_exprClasses[nodeIndex] !=
               TypedExprExprOwned ||
           !ir.nodes2_resultTypeManagedFlags[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_producedValueDefinitionRows,
               nodeIndex) >= 0:
            continue
        let sourceLocalNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_originParserNodeIds,
            nodeIndex)
        let syntheticOriginKind = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_syntheticOriginKinds,
            nodeIndex)
        # Structural link/desugaring nodes are not value producers. Their
        # parser-backed owned child receives the exact definition row.
        if sourceLocalNodeIndex < 0 ||
           syntheticOriginKind != TypedExprSyntheticOriginNone:
            continue
        let _ = typedExprIrAppendValueDefinitionExact(
            ir,
            TypedExprValueDefinitionOriginManagedTemporary,
            producerSourceIndex,
            sourceLocalNodeIndex,
            -1,
            -1,
            typedFunctionIndex,
            nodeIndex,
            -1,
            ir.nodes2_exprClasses[nodeIndex])

@borrows
fn TypedExprParamSlot(params: TypedExprParam[],
                       name: str): int32 =
    for i in 0..<params.len:
        if params[i].name == name:
            return i
    return -1

@borrows
fn TypedExprIrParamNodeIndex(params: TypedExprParam[],
                              paramNodeIndices: int32[],
                              name: str): int32 =
    let slot = TypedExprParamSlot(params, name)
    if slot < 0 || slot >= paramNodeIndices.len:
        return -1
    return paramNodeIndices[slot]

@borrows
fn TypedExprIrIsI32ConstLiteral(textRaw: str): bool =
    let text = chengpath.PathTrim(share(textRaw))
    if Len(text) <= 0:
        return false
    var constValue: int32
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        let digit = Int32(ch) - Int32('0')
        if constValue > 6553 || (constValue == 6553 && digit > 5):
            return false
        constValue = constValue * 10 + digit
    return true

@borrows
fn TypedExprIrParseI32Const(textRaw: str): int32 =
    let text = chengpath.PathTrim(share(textRaw))
    var constValue: int32
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return 0
        constValue = constValue * 10 + Int32(ch) - Int32('0')
    return constValue

@borrows
fn TypedExprIrAddI32ConstNode(ir: var TypedExprIr,
                               sourcePath: str,
                               functionName: str,
                               lineNumber: int32,
                               literalText: str): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginDesugared
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = share(sourcePath)
    node.functionName = share(functionName)
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpI32Const
    node.resultType = "int32"
    typedExprIrBindNodeStructuralType(
        ir,
        node,
        typedExprIrReservedScalarTypeId(
            ir, typearena.TypedExprStructuralScalarInt32))
    node.surfaceText = share(literalText)
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = share(literalText)
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrAddOpNode(ir: var TypedExprIr,
                         sourcePath: str,
                         functionName: str,
                         lineNumber: int32,
                         opKind: TypedExprIrOpKind,
                         resultType: str,
                         surfaceText: str,
                         operand0: int32,
                         operand1: int32,
                         operand2: int32): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginDesugared
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = share(sourcePath)
    node.functionName = share(functionName)
    node.lineNumber = lineNumber
    node.opKind = opKind
    node.resultType = share(resultType)
    node.exprClass = TypedExprIrExprClassForResultTypeExact(
        ir, sourcePath, node.resultType, TypedExprExprOwned)
    # [op73] AddrOf 的 reserved 臂对 "ptr" 恒 -1(文本表无此项), 该类
    # 节点的权威 TypeId 由拼写 ptr 行读路由供给(见
    # typedExprIrAddrOfPointerStructuralTypeId); 其余 op 与 reserved 命中
    # 的 AddrOf 形态逐字节走原路。
    var opNodeStructuralTypeId =
        typedExprIrReservedScalarTypeIdForRuntimeType(ir, node.resultType)
    if opKind == TypedExprIrOpAddrOf && opNodeStructuralTypeId < 0 &&
       ir.exactTypeArena != nil && ir.valueDefinitionTypeArenaBound:
        opNodeStructuralTypeId =
            typedExprIrAddrOfPointerStructuralTypeId(ir.exactTypeArena)
    typedExprIrBindNodeStructuralType(ir, node, opNodeStructuralTypeId)
    node.surfaceText = share(surfaceText)
    node.paramSlot = -1
    node.operand0NodeIndex = operand0
    node.operand1NodeIndex = operand1
    node.operand2NodeIndex = operand2
    return TypedExprIrAddNode(ir, node)

fn TypedExprReturnStrLenFastBindingName(exprRaw: str): str =
    let exprText = chengpath.PathTrim(exprRaw)
    let prefix = "StrLenFast("
    if Len(exprText) <= Len(prefix):
        return ""
    if !parser.ParserStartsWith(exprText, prefix):
        return ""
    if exprText[Len(exprText) - 1] != ')':
        return ""
    let innerLen = Len(exprText) - Len(prefix) - 1
    if innerLen <= 0:
        return ""
    let innerText = chengpath.PathTrim(chengpath.TextSlice(exprText, Len(prefix), innerLen))
    if parser.ParserIdentPrefix(parser.ParserFirstToken(innerText)) != innerText:
        return ""
    return innerText

@borrows
fn TypedExprFunctionBodyIsStrEmptyReturn(ctx: TypedExprSourceContext,
                                          scope: TypedExprFunctionScope,
                                          params: TypedExprParam[],
                                          returnLineNumber: var int32): bool =
    returnLineNumber = 0
    if scope.returnType != "str":
        return false
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return false
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    let bodyStartIndex = TypedExprSourceContextLineIndex(ctx, bodyStartLine)
    let bodyEndIndex = TypedExprSourceContextLineIndex(ctx, scope.endLine)
    if bodyStartIndex < 0 || bodyEndIndex < bodyStartIndex:
        return false
    var bodyCount: int32
    for i in bodyStartIndex..bodyEndIndex:
        let bodyRaw = ctx.lines[i]
        let bodyTrim = chengpath.PathTrim(share(bodyRaw))
        if bodyTrim == "":
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        bodyCount = bodyCount + 1
        if bodyCount == 1:
            if bodyTrim != "var out: str":
                return false
            continue
        if bodyCount == 2:
            if bodyTrim != "return out":
                return false
            returnLineNumber = TypedExprSourceContextStoredLineNumber(ctx, i)
            continue
        return false
    if bodyCount != 2:
        return false
    if returnLineNumber <= 0:
        return false
    return true

fn TypedExprLetCallBindingNameFromBody(bodyTextRaw: str): str =
    let bodyText = chengpath.PathTrim(bodyTextRaw)
    var prefix = ""
    if parser.ParserStartsWith(bodyText, "let "):
        prefix = "let "
    elif parser.ParserStartsWith(bodyText, "var "):
        prefix = "var "
    if prefix == "":
        return ""
    let tail = chengpath.TextSlice(bodyText, Len(prefix), bodyText.len - Len(prefix))
    let eqPos = TypedExprFindTopLevelTextToken(tail, "=")
    if eqPos <= 0:
        return ""
    let bindingText = chengpath.PathTrim(chengpath.TextSlice(tail, 0, eqPos))
    return parser.ParserIdentPrefix(parser.ParserFirstToken(bindingText))

fn TypedExprAssignCanonicalLhsText(lhsRaw: str): str =
    var lhsText = chengpath.PathTrim(lhsRaw)
    # inline match arm body (`Label => target = rhs`): the arm arrow prefix
    # `Label =>` leaks into the assign LHS. Strip it so the assign target is the
    # real binding (`target`), not the phantom `Label => target` slot. `=>` is
    # never valid in a plain assign LHS, so this strip is unconditional-safe.
    let armArrowPos = parser.ParserFindText(lhsText, "=>")
    if armArrowPos >= 0:
        lhsText = chengpath.PathTrim(chengpath.TextSlice(lhsText,
                                                         armArrowPos + 2,
                                                         lhsText.len - armArrowPos - 2))
    # ParserStartsWith PathTrim 掉 prefix 末尾空格 → "let " 退化成 "let"，使
    # `letters`（无空格分界）误判为带 let 声明前缀，被切成 `ers`（letters[4:]）。
    # 用 ParserStartsWithExact（不裁剪 prefix）严格要求关键字后跟真实空格分界。
    var prefix = ""
    if parser.ParserStartsWithExact(lhsText, "let "):
        prefix = "let "
    elif parser.ParserStartsWithExact(lhsText, "var "):
        prefix = "var "
    elif parser.ParserStartsWithExact(lhsText, "const "):
        prefix = "const "
    if prefix == "":
        return lhsText
    let tail = chengpath.TextSlice(lhsText, Len(prefix), lhsText.len - Len(prefix))
    var stop = tail.len
    let colonPos = TypedExprFindTopLevelToken(tail, ":")
    if colonPos >= 0:
        stop = colonPos
    let bindingText = chengpath.PathTrim(chengpath.TextSlice(tail, 0, stop))
    let bindingName = parser.ParserIdentPrefix(parser.ParserFirstToken(bindingText))
    if bindingName == "":
        return lhsText
    return bindingName

@borrows
fn TypedExprAssignLhsHasDeclPrefix(lhsRaw: str): bool =
    let lhsText = chengpath.PathTrim(lhsRaw)
    if parser.ParserStartsWith(lhsText, "let "):
        return true
    if parser.ParserStartsWith(lhsText, "var "):
        return true
    if parser.ParserStartsWith(lhsText, "const "):
        return true
    return false

@borrows
fn TypedExprBindingDeclaredTypeFromLhs(lhsRaw: str): str =
    let lhsText = chengpath.PathTrim(lhsRaw)
    var prefix = ""
    if parser.ParserStartsWithExact(lhsText, "let "):
        prefix = "let "
    elif parser.ParserStartsWithExact(lhsText, "var "):
        prefix = "var "
    elif parser.ParserStartsWithExact(lhsText, "const "):
        prefix = "const "
    if prefix == "":
        return ""
    let tail = chengpath.TextSlice(
        lhsText, prefix.len, lhsText.len - prefix.len)
    let colonPos = TypedExprFindTopLevelToken(tail, ":")
    if colonPos < 0 || colonPos + 1 >= tail.len:
        return ""
    return TypedExprNormalizeTypeText(chengpath.PathTrim(
        chengpath.TextSlice(
            tail, colonPos + 1, tail.len - colonPos - 1)))

@borrows
fn TypedExprFunctionBodyIsCstringToStrCopy(ctx: TypedExprSourceContext,
                                            scope: TypedExprFunctionScope,
                                            params: TypedExprParam[],
                                            returnLineNumber: var int32): bool =
    returnLineNumber = 0
    if scope.returnType != "str":
        return false
    if params.len != 1 || params[0].typeText != "cstring":
        return false
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return false
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    let bodyStartIndex = TypedExprSourceContextLineIndex(ctx, bodyStartLine)
    let bodyEndIndex = TypedExprSourceContextLineIndex(ctx, scope.endLine)
    if bodyStartIndex < 0 || bodyEndIndex < bodyStartIndex:
        return false
    var bodyLines: str[]
    var bodyLineNumbers: int32[]
    for i in bodyStartIndex..bodyEndIndex:
        let bodyRaw = ctx.lines[i]
        let bodyTrim = chengpath.PathTrim(share(bodyRaw))
        if bodyTrim == "":
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        add(bodyLines, bodyTrim)
        add(bodyLineNumbers,
            TypedExprSourceContextStoredLineNumber(ctx, i))
    let copyReturn = strutil.Join(
        ["return system.strFromCStringCopy(",
         strings.CloneStr(params[0].name), ")"], "")
    if bodyLines.len == 1 && bodyLines[0] == copyReturn:
        returnLineNumber = bodyLineNumbers[0]
        return true
    if bodyLines.len != 3:
        return false
    if bodyLines[0] != strutil.Join(
            ["if ptr(", strings.CloneStr(params[0].name), ") == nil:"], ""):
        return false
    if bodyLines[1] != "return \"\"":
        return false
    if bodyLines[2] != copyReturn:
        return false
    returnLineNumber = bodyLineNumbers[2]
    return true

@borrows
fn TypedExprIrAddLetCallNode(ir: var TypedExprIr,
                              sourcePath: str,
                              functionName: str,
                              lineNumber: int32,
                              bodyText: str): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginDesugared
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = share(sourcePath)
    node.functionName = share(functionName)
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpLetCall
    node.resultType = "void"
    node.exprClass = TypedExprIrExprClassForResultTypeExact(
        ir, sourcePath, node.resultType, TypedExprExprOwned)
    typedExprIrBindNodeStructuralType(
        ir,
        node,
        typedExprIrReservedScalarTypeId(
            ir, typearena.TypedExprStructuralScalarVoid))
    node.surfaceText = share(bodyText)
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrAddStrEmptyReturnNode(ir: var TypedExprIr,
                                     sourcePath: str,
                                     functionName: str,
                                     lineNumber: int32): int32 =
    return TypedExprIrAddOpNode(ir,
                                sourcePath,
                                functionName,
                                lineNumber,
                                TypedExprIrOpStrEmptyReturn,
                                "str",
                                "str_empty_return",
                                -1,
                                -1,
                                -1)

@borrows
fn TypedExprIrAddCstringToStrCopyNode(ir: var TypedExprIr,
                                       sourcePath: str,
                                       functionName: str,
                                       lineNumber: int32,
                                       paramNodeIndex: int32,
                                       paramName: str): int32 =
    return TypedExprIrAddOpNode(ir,
                                sourcePath,
                                functionName,
                                lineNumber,
                                TypedExprIrOpCstringToStrCopy,
                                "str",
                                paramName,
                                paramNodeIndex,
                                -1,
                                -1)

@borrows
fn TypedExprReturnConstTextFromLine(lineRaw: str): str =
    let exprText = TypedExprReturnExprFromBody(lineRaw)
    if TypedExprIrIsI32ConstLiteral(exprText):
        return exprText
    return ""

@borrows
fn TypedExprFunctionBodyIsI32IfArg0LeZeroConstElseConst(ctx: TypedExprSourceContext,
                                                         scope: TypedExprFunctionScope,
                                                         params: TypedExprParam[],
                                                         bodyLineNumber: var int32,
                                                         thenConstText: var str,
                                                         elseConstText: var str): bool =
    bodyLineNumber = 0
    thenConstText = ""
    elseConstText = ""
    if scope.returnType != "int32":
        return false
    if params.len != 1 || params[0].typeText != "int32":
        return false
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return false
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    let bodyStartIndex = TypedExprSourceContextLineIndex(ctx, bodyStartLine)
    let bodyEndIndex = TypedExprSourceContextLineIndex(ctx, scope.endLine)
    if bodyStartIndex < 0 || bodyEndIndex < bodyStartIndex:
        return false
    var bodyLines: str[]
    var bodyLineNumbers: int32[]
    for i in bodyStartIndex..bodyEndIndex:
        let bodyRaw = ctx.lines[i]
        let bodyTrim = chengpath.PathTrim(share(bodyRaw))
        if Len(bodyTrim) <= 0:
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        add(bodyLines, bodyTrim)
        add(bodyLineNumbers,
            TypedExprSourceContextStoredLineNumber(ctx, i))
    if bodyLines.len != 3:
        return false
    if bodyLines[0] != strutil.Join(
            ["if ", strings.CloneStr(params[0].name), " <= 0:"], ""):
        return false
    let thenText = TypedExprReturnConstTextFromLine(bodyLines[1])
    let elseText = TypedExprReturnConstTextFromLine(bodyLines[2])
    if Len(thenText) <= 0 || Len(elseText) <= 0:
        return false
    bodyLineNumber = bodyLineNumbers[0]
    thenConstText = thenText
    elseConstText = elseText
    return true

@borrows
fn TypedExprIrAddI32IfArg0LeZeroConstElseConstNode(ir: var TypedExprIr,
                                                    sourcePath: str,
                                                    functionName: str,
                                                    lineNumber: int32,
                                                    paramNodeIndex: int32,
                                                    thenConstText: str,
                                                    elseConstText: str): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginImplicitControl
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = share(sourcePath)
    node.functionName = share(functionName)
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpI32IfArg0LeZeroConstElseConst
    node.resultType = "int32"
    node.surfaceText = "if_arg0_le_zero_const_else_const"
    node.paramSlot = -1
    node.operand0NodeIndex = paramNodeIndex
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = strutil.Join(
        [strings.CloneStr(thenConstText), ",",
         strings.CloneStr(elseConstText)], "")
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrAddBinaryIfMatches(ir: var TypedExprIr,
                                  sourcePath: str,
                                  functionName: str,
                                  lineNumber: int32,
                                  params: TypedExprParam[],
                                  paramNodeIndices: int32[],
                                  returnExpr: str,
                                  opText: str,
                                  opKind: TypedExprIrOpKind,
                                  resultType: str): int32 =
    let opIndex = TypedExprFindTopLevelTextToken(returnExpr, opText)
    if opIndex < 0:
        return -1
    let lhsText = chengpath.PathTrim(chengpath.TextSlice(returnExpr, 0, opIndex))
    let rhsStart = opIndex + Len(opText)
    let rhsText = chengpath.PathTrim(chengpath.TextSlice(returnExpr,
                                                         rhsStart,
                                                         returnExpr.len - rhsStart))
    let lhsNodeIndex = TypedExprIrParamNodeIndex(params, paramNodeIndices, lhsText)
    let rhsNodeIndex = TypedExprIrParamNodeIndex(params, paramNodeIndices, rhsText)
    if lhsNodeIndex < 0 || rhsNodeIndex < 0:
        # P1 producer: binary IR 透传时 operand 名查不到 paramNames - 当前
        # 直接返 -1 无字段访问.  按 design caller-side 写法但 caller (5706/
        # 5718/5730/5742/5755) 也无 stmt 上下文, 唯一可靠通道是模块 hint.
        # operand 文本含 '[' (typed param brackets) → generic_return; 否则
        # → call_surface_unresolved.  17946/21454 outer 写 stmt.rhsBailReason
        # 时读+清空 hint.
        let _lhsHasBr = TypedExprFindTopLevelTextToken(lhsText, "[") >= 0
        let _rhsHasBr = TypedExprFindTopLevelTextToken(rhsText, "[") >= 0
        if _lhsHasBr || _rhsHasBr:
            TypedExprIrSetRhsBailHint("generic_return")
        else:
            TypedExprIrSetRhsBailHint("call_surface_unresolved")
        return -1
    return TypedExprIrAddOpNode(ir,
                                sourcePath,
                                functionName,
                                lineNumber,
                                opKind,
                                resultType,
                                returnExpr,
                                lhsNodeIndex,
                                rhsNodeIndex,
                                -1)

@borrows
fn TypedExprIrBuildBinaryReturnNode(ir: var TypedExprIr,
                                     sourcePath: str,
                                     functionName: str,
                                     lineNumber: int32,
                                     params: TypedExprParam[],
                                     paramNodeIndices: int32[],
                                     returnType: str,
                                     returnExpr: str): int32 =
    if params.len != 2:
        return -1
    if params[0].typeText == "int32" &&
       params[1].typeText == "int32" &&
       returnType == "int32":
        let addIndex = TypedExprIrAddBinaryIfMatches(ir,
                                                     sourcePath,
                                                     functionName,
                                                     lineNumber,
                                                     params,
                                                     paramNodeIndices,
                                                     returnExpr,
                                                     "+",
                                                     TypedExprIrOpI32Add,
                                                     "int32")
        if addIndex >= 0:
            return addIndex
        let subIndex = TypedExprIrAddBinaryIfMatches(ir,
                                                     sourcePath,
                                                     functionName,
                                                     lineNumber,
                                                     params,
                                                     paramNodeIndices,
                                                     returnExpr,
                                                     "-",
                                                     TypedExprIrOpI32Sub,
                                                     "int32")
        if subIndex >= 0:
            return subIndex
        let mulIndex = TypedExprIrAddBinaryIfMatches(ir,
                                                     sourcePath,
                                                     functionName,
                                                     lineNumber,
                                                     params,
                                                     paramNodeIndices,
                                                     returnExpr,
                                                     "*",
                                                     TypedExprIrOpI32Mul,
                                                     "int32")
        if mulIndex >= 0:
            return mulIndex
        return TypedExprIrAddBinaryIfMatches(ir,
                                             sourcePath,
                                             functionName,
                                             lineNumber,
                                             params,
                                             paramNodeIndices,
                                             returnExpr,
                                             ">>",
                                             TypedExprIrOpI32Asr,
                                             "int32")
    if params[0].typeText == "float64" &&
       params[1].typeText == "float64" &&
       returnType == "float64":
        return TypedExprIrAddBinaryIfMatches(ir,
                                             sourcePath,
                                             functionName,
                                             lineNumber,
                                             params,
                                             paramNodeIndices,
                                             returnExpr,
                                             "*",
                                             TypedExprIrOpF64Mul,
                                             "float64")
    return -1

@borrows
fn TypedExprIrBinaryParamsMatch(textRaw: str,
                                 lhsName: str,
                                 opText: str,
                                 rhsName: str): bool =
    let opIndex = TypedExprFindTopLevelTextToken(textRaw, opText)
    if opIndex < 0:
        return false
    let lhsText = chengpath.PathTrim(chengpath.TextSlice(textRaw, 0, opIndex))
    let rhsStart = opIndex + Len(opText)
    let rhsText = chengpath.PathTrim(chengpath.TextSlice(textRaw,
                                                         rhsStart,
                                                         textRaw.len - rhsStart))
    if lhsText != lhsName:
        return false
    if rhsText != rhsName:
        return false
    return true

@borrows
fn TypedExprIrBuildMaddReturnNode(ir: var TypedExprIr,
                                   sourcePath: str,
                                   functionName: str,
                                   lineNumber: int32,
                                   params: TypedExprParam[],
                                   paramNodeIndices: int32[],
                                   returnType: str,
                                   returnExpr: str): int32 =
    if params.len != 3:
        return -1
    if params[0].typeText != "int32" ||
       params[1].typeText != "int32" ||
       params[2].typeText != "int32" ||
       returnType != "int32":
        return -1
    let opIndex = TypedExprFindTopLevelTextToken(returnExpr, "+")
    if opIndex < 0:
        return -1
    let leftText = chengpath.PathTrim(chengpath.TextSlice(returnExpr, 0, opIndex))
    let rightStart = opIndex + 1
    let rightText = chengpath.PathTrim(chengpath.TextSlice(returnExpr,
                                                          rightStart,
                                                          returnExpr.len - rightStart))
    var matched = false
    if rightText == params[2].name:
        matched = TypedExprIrBinaryParamsMatch(leftText,
                                               params[0].name,
                                               "*",
                                               params[1].name)
    elif leftText == params[2].name:
        matched = TypedExprIrBinaryParamsMatch(rightText,
                                               params[0].name,
                                               "*",
                                               params[1].name)
    if !matched:
        return -1
    return TypedExprIrAddOpNode(ir,
                                sourcePath,
                                functionName,
                                lineNumber,
                                TypedExprIrOpI32Madd,
                                "int32",
                                returnExpr,
                                paramNodeIndices[0],
                                paramNodeIndices[1],
                                paramNodeIndices[2])

@borrows
fn TypedExprFunctionBodyMatchesF64MulCheckExit(ctx: TypedExprSourceContext,
                                                scope: TypedExprFunctionScope): bool =
    if scope.name != "main" || scope.returnType != "int32":
        return false
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return false
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    let bodyStartIndex = TypedExprSourceContextLineIndex(ctx, bodyStartLine)
    let bodyEndIndex = TypedExprSourceContextLineIndex(ctx, scope.endLine)
    if bodyStartIndex < 0 || bodyEndIndex < bodyStartIndex:
        return false
    var bodyLines: str[]
    for i in bodyStartIndex..bodyEndIndex:
        let bodyRaw = ctx.lines[i]
        let bodyTrim = chengpath.PathTrim(share(bodyRaw))
        if Len(bodyTrim) <= 0:
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        add(bodyLines, bodyTrim)
    if bodyLines.len != 6:
        return false
    if bodyLines[0] != "let a = 1.5":
        return false
    if bodyLines[1] != "let b = 2.0":
        return false
    if bodyLines[2] != "let product = a * b":
        return false
    if bodyLines[3] != "if product == 3.0:":
        return false
    if bodyLines[4] != "return 0":
        return false
    return bodyLines[5] == "return 1"

@borrows
fn TypedExprFunctionBodyMatchesStrLenFast(ctx: TypedExprSourceContext,
                                           scope: TypedExprFunctionScope,
                                           params: TypedExprParam[]): bool =
    # 停用叶子习语折叠: 折叠产物(零语句 + 单叶子节点)没有可建 BodyIR 的
    # 语句,生产流发射(regalloc)无从消费;fixed-template provenance 通道
    # (recipe provenance 合同的 fixed_template)在 regalloc lane 落地前,
    # strLenFast 一律走普通语句构建 + 统一 regalloc 发射。
    return false

@borrows
fn TypedExprIrBuildReturnNode(ir: var TypedExprIr,
                               ctx: TypedExprSourceContext,
                               scope: TypedExprFunctionScope,
                               bodyLineNumber: int32,
                               returnExpr: str,
                               params: TypedExprParam[],
                               paramNodeIndices: int32[]): int32 =
    var ifLineNumber: int32
    var ifThenConst = ""
    var ifElseConst = ""
    if TypedExprFunctionBodyIsI32IfArg0LeZeroConstElseConst(ctx,
                                                            scope,
                                                            params,
                                                            ifLineNumber,
                                                            ifThenConst,
                                                            ifElseConst):
        return TypedExprIrAddI32IfArg0LeZeroConstElseConstNode(ir,
                                                               ctx.sourcePath,
                                                               scope.name,
                                                               ifLineNumber,
                                                               paramNodeIndices[0],
                                                               ifThenConst,
                                                               ifElseConst)
    if TypedExprFunctionBodyMatchesF64MulCheckExit(ctx, scope):
        return TypedExprIrAddOpNode(ir,
                                    ctx.sourcePath,
                                    scope.name,
                                    bodyLineNumber,
                                    TypedExprIrOpMainF64MulCheckExit,
                                    "int32",
                                    "main_f64_mul_check_exit",
                                    -1,
                                    -1,
                                    -1)
    if TypedExprFunctionBodyMatchesStrLenFast(ctx, scope, params):
        return TypedExprIrAddOpNode(ir,
                                    ctx.sourcePath,
                                    scope.name,
                                    bodyLineNumber,
                                    TypedExprIrOpStrLenFast,
                                    "int32",
                                    "str_len_fast",
                                    paramNodeIndices[0],
                                    -1,
                                    -1)
    if scope.returnType == "bool" &&
       params.len == 1 &&
       params[0].typeText == "int32" &&
       returnExpr == Fmt"{params[0].name} >= 0 && {params[0].name} <= 31":
        return TypedExprIrAddOpNode(ir,
                                    ctx.sourcePath,
                                    scope.name,
                                    bodyLineNumber,
                                    TypedExprIrOpReturnBoolI32Arg0Range0To31,
                                    "bool",
                                    returnExpr,
                                    paramNodeIndices[0],
                                    -1,
                                    -1)
    if scope.returnType == "int32":
        let returnParamIndex = TypedExprIrParamNodeIndex(params,
                                                         paramNodeIndices,
                                                         returnExpr)
        if returnParamIndex >= 0 && returnParamIndex < ir.nodes2_nodeIndexs.len:
            let retParamTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[returnParamIndex])
            if IsOk(retParamTypeRes) && Value(retParamTypeRes) == "int32":
                return returnParamIndex
    if scope.returnType == "uint64" &&
       params.len == 1 &&
       params[0].typeText == "uint64":
        let orIndex = TypedExprFindTopLevelTextToken(returnExpr, "|")
        if orIndex > 0:
            let lhsText = chengpath.PathTrim(chengpath.TextSlice(returnExpr, 0, orIndex))
            let rhsStart = orIndex + 1
            let rhsText = chengpath.PathTrim(chengpath.TextSlice(returnExpr,
                                                                 rhsStart,
                                                                 returnExpr.len - rhsStart))
            if lhsText == params[0].name && rhsText == "uint64(4)":
                return TypedExprIrAddOpNode(ir,
                                            ctx.sourcePath,
                                            scope.name,
                                            bodyLineNumber,
                                            TypedExprIrOpU64OrArg0Const4,
                                            "uint64",
                                            returnExpr,
                                            paramNodeIndices[0],
                                            -1,
                                            -1)
    if scope.returnType == "bool" &&
       params.len == 1 &&
       params[0].typeText == "uint64":
        let neIndex = TypedExprFindTopLevelTextToken(returnExpr, "!=")
        if neIndex > 0:
            let lhsText = chengpath.PathTrim(chengpath.TextSlice(returnExpr, 0, neIndex))
            let rhsStart = neIndex + 2
            let rhsText = chengpath.PathTrim(chengpath.TextSlice(returnExpr,
                                                                 rhsStart,
                                                                 returnExpr.len - rhsStart))
            let expectedLhsText = Fmt"({params[0].name} & uint64(4))"
            if lhsText == expectedLhsText && rhsText == "uint64(0)":
                return TypedExprIrAddOpNode(ir,
                                            ctx.sourcePath,
                                            scope.name,
                                            bodyLineNumber,
                                            TypedExprIrOpU64Arg0AndConst4NotZero,
                                            "bool",
                                            returnExpr,
                                            paramNodeIndices[0],
                                            -1,
                                            -1)
    var cstringCopyLineNumber: int32
    if TypedExprFunctionBodyIsCstringToStrCopy(ctx,
                                               scope,
                                               params,
                                               cstringCopyLineNumber):
        return TypedExprIrAddCstringToStrCopyNode(ir,
                                                  ctx.sourcePath,
                                                  scope.name,
                                                  cstringCopyLineNumber,
                                                  paramNodeIndices[0],
                                                  params[0].name)
    var strEmptyReturnLineNumber: int32
    if TypedExprFunctionBodyIsStrEmptyReturn(ctx,
                                             scope,
                                             params,
                                             strEmptyReturnLineNumber):
        return TypedExprIrAddStrEmptyReturnNode(ir,
                                                ctx.sourcePath,
                                                scope.name,
                                                strEmptyReturnLineNumber)
    if scope.returnType == "int32" && TypedExprIrIsI32ConstLiteral(returnExpr):
        return TypedExprIrAddI32ConstNode(ir,
                                          ctx.sourcePath,
                                          scope.name,
                                          bodyLineNumber,
                                          returnExpr)
    let maddIndex = TypedExprIrBuildMaddReturnNode(ir,
                                                   ctx.sourcePath,
                                                   scope.name,
                                                   bodyLineNumber,
                                                   params,
                                                   paramNodeIndices,
                                                   scope.returnType,
                                                   returnExpr)
    if maddIndex >= 0:
        return maddIndex
    return TypedExprIrBuildBinaryReturnNode(ir,
                                            ctx.sourcePath,
                                            scope.name,
                                            bodyLineNumber,
                                            params,
                                            paramNodeIndices,
                                            scope.returnType,
                                            returnExpr)

@borrows
fn TypedExprParseTypeDeclName(lineRaw: str): str =
    let line = chengpath.PathTrim(lineRaw)
    if line == "":
        return ""
    let eqPos = TypedExprFindTopLevelToken(line, "=")
    if eqPos <= 0:
        return ""
    let headRaw = chengpath.PathTrim(chengpath.TextSlice(line, 0, eqPos))
    # A type-decl head is `Name` or `Name[T,...]`; it never carries a top-level
    # `:`. A field line with a default value (`name: Type = init`) does, and
    # would otherwise be misread as a sibling `Name = alias` decl — silently
    # dropping the field from the owner's layout so every read of it falls to
    # no_node. Reject those here so the field-line parser sees them instead.
    if TypedExprFindTopLevelToken(headRaw, ":") >= 0:
        return ""
    let genericPos = TypedExprFindTopLevelToken(headRaw, "[")
    var head: str
    if genericPos > 0:
        head = chengpath.PathTrim(chengpath.TextSlice(headRaw, 0, genericPos))
    else:
        head = headRaw
    return parser.ParserIdentPrefix(parser.ParserFirstToken(head))

@borrows
fn TypedExprParseTypeDeclRhs(lineRaw: str): str =
    let line = chengpath.PathTrim(lineRaw)
    if line == "":
        return ""
    let eqPos = TypedExprFindTopLevelToken(line, "=")
    if eqPos <= 0 || eqPos + 1 >= line.len:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(line,
                                                  eqPos + 1,
                                                  line.len - eqPos - 1))

# `Name = enum A, B, C` keeps its values on the decl line, so the indented
# value-line walk in the context builders never sees them. Extract the
# comma-joined tail here; multi-line `Name = enum` yields "".
@borrows
fn TypedExprInlineEnumValuesText(aliasTargetRaw: str): str =
    let aliasTarget = chengpath.PathTrim(aliasTargetRaw)
    if len(aliasTarget) <= 5:
        return ""
    if !parser.ParserStartsWith(aliasTarget, "enum "):
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(aliasTarget, 5, len(aliasTarget) - 5))

@borrows
fn TypedExprContextAddInlineEnumValues(enumValueNames: var str[],
                                        enumValueTypes: var str[],
                                        enumValueOrdinals: var int32[],
                                        declaredType: str,
                                        aliasTarget: str) =
    let inlineValuesText = TypedExprInlineEnumValuesText(aliasTarget)
    if inlineValuesText == "":
        return
    let inlineNames = parser.ParserSplitChar(inlineValuesText, ',')
    var ordinal: int32
    for vi in 0..<inlineNames.len:
        let enumValueName = parser.ParserIdentPrefix(chengpath.PathTrim(inlineNames[vi]))
        if enumValueName != "":
            add(enumValueNames, enumValueName)
            add(enumValueTypes, strings.CloneStr(declaredType))
            add(enumValueOrdinals, ordinal)
            ordinal = ordinal + 1

# [phaseB-parser] `type N = tuple[a: T, ...]` 具名元素进入 ctx.typeFields，
# 与 object 缩进字段同一登记通道与同一顺序约定（parser 为元素按序产出
# FieldDeclaration 声明行，compiler csg exact-layout 绑定按序配对并绑定
# 精确坐标）。无名元素不登记；元素默认值只取类型部分，与字段行扫描口径
# 一致。非 tuple[...] 形状的 RHS 在此直通。
@borrows
fn TypedExprContextAddInlineTupleTypeFields(typeFields: var TypedExprTypeFieldDecl[],
                                             declaredType: str,
                                             aliasTargetRaw: str,
                                             sourcePath: str,
                                             declLineNumber: int32,
                                             err: var str) =
    err = ""
    let aliasTarget = chengpath.PathTrim(aliasTargetRaw)
    if declaredType == "" || len(aliasTarget) < 8:
        return
    if !parser.ParserStartsWith(aliasTarget, "tuple[") ||
       aliasTarget[len(aliasTarget) - 1] != ']':
        return
    let itemsText = chengpath.PathTrim(
        chengpath.TextSlice(aliasTarget, 6, len(aliasTarget) - 7))
    var items: str[]
    var itemsErr: str
    if !TypedExprSplitTopLevelTypeList(itemsText, items, itemsErr):
        err = Fmt"typed expr: inline tuple element list invalid at {sourcePath}:{declLineNumber}: {itemsErr}"
        return
    for itemIndex in 0..<items.len:
        let fieldParse = TypedExprParseTypeFieldLineOwned(items[itemIndex])
        if !fieldParse.ok:
            # 无名元素（tuple[int32, str]）不产字段行
            continue
        if TypedExprTypeContainsSabiBoundary(fieldParse.fieldType):
            err = Fmt"ZRPC/SABI violation at {sourcePath}:{declLineNumber}: SABI boundary type `{fieldParse.fieldType}` cannot be used as a tuple field"
            return
        TypedExprAddTypeFieldDeclInPlace(typeFields,
                                         declaredType,
                                         fieldParse.fieldName,
                                         fieldParse.fieldType)

# Multi-line enum value lines may carry an explicit ordinal (`Name = 3`).
# Returns the explicit ordinal when the `=` tail is a plain decimal, else
# the sequential fallback.
@borrows
fn TypedExprEnumValueLineOrdinal(trimmed: str, fallbackOrdinal: int32): int32 =
    let eqPos = parser.ParserFindText(trimmed, "=")
    if eqPos < 0:
        return fallbackOrdinal
    let tail = chengpath.PathTrim(chengpath.TextSlice(trimmed,
                                                      eqPos + 1,
                                                      len(trimmed) - eqPos - 1))
    if tail == "":
        return fallbackOrdinal
    for ti in 0..<tail.len:
        if tail[ti] < '0' || tail[ti] > '9':
            return fallbackOrdinal
    return TypedExprIrParseI32Const(tail)

@borrows
fn TypedExprTypeDeclRhsIsRefObject(rhsRaw: str): bool =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "ref":
        return true
    if parser.ParserStartsWithExact(rhs, "ref object"):
        return true
    return parser.ParserStartsWithExact(rhs, "ref ")

@borrows
fn TypedExprMaybeAddRefType(refTypes: var str[],
                             typeNameRaw: str,
                             rhsRaw: str) =
    if !TypedExprTypeDeclRhsIsRefObject(rhsRaw):
        return
    let typeName = TypedExprTypeLeafName(typeNameRaw)
    if typeName == "":
        return
    if parser.ParserStringSeqContainsExact(refTypes, typeName):
        return
    add(refTypes, typeName)

@borrows
fn TypedExprPointerAliasPointeeType(typeRaw: str): str =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return ""
    if typeText.len > 0 && typeText[typeText.len - 1] == '*':
        return chengpath.PathTrim(chengpath.TextSlice(typeText, 0, typeText.len - 1))
    return ""

@borrows
fn TypedExprMaybeAddTypeDefAlias(sourcePath: str,
                                  typeDefAliasNames: var str[],
                                  typeDefAliasTargetTypes: var str[],
                                  aliasNameRaw: str,
                                  targetTypeRaw: str,
                                  declLineNumber: int32,
                                  err: var str) =
    let aliasName = parser.ParserIdentPrefix(chengpath.PathTrim(aliasNameRaw))
    let targetType = TypedExprNormalizeTypeText(targetTypeRaw)
    if aliasName == "" || targetType == "":
        return
    # `record` is not a Cheng keyword or built-in type (the formal spec has no
    # such construct; struct-like types use `object` / `ref object`). Without
    # this check `type Foo = record` was silently accepted as an alias whose
    # target type never resolves, so every field read of `Foo` fell through
    # to a fabricated/uninitialized slot instead of failing at compile time.
    if targetType == "record":
        err = Fmt"invalid type alias at {sourcePath}:{declLineNumber}: `type {aliasName} = record` is not valid Cheng syntax — `record` is not a declared type or keyword (use `object` / `ref object` to declare a struct type)"
        return
    for i in 0..<typeDefAliasNames.len:
        if i >= typeDefAliasTargetTypes.len:
            continue
        if typeDefAliasNames[i] == aliasName:
            return
    add(typeDefAliasNames, aliasName)
    add(typeDefAliasTargetTypes, targetType)

# Process one type-decl head line (`Name =`, `Name[T] =`, `Name = enum ...`,
# `Name = alias`) into the source context, updating the running scan state. Used
# for both the block form (a `type` line then an indented `Name =` line) and the
# inline form (`type Name = ...` on one line). The inline form was previously
# only recognized as a bare `type` keyword line, so `type Name =` declarations
# never entered the type block and the type's fields were dropped from the
# context entirely — every field read of such a type then fell to no_node /
# fabricated-uninitialized-slot in the pure node backend. Returns the declared
# leaf name ("" when the line is not a type-decl head, also "" with `err` set
# on a rejected alias — callers must check `err` before treating "" as benign).
@borrows
fn TypedExprContextProcessTypeDeclLine(sourcePath: str,
                                        typeDefAliasNames: var str[],
                                        typeDefAliasTargetTypes: var str[],
                                        refTypes: var str[],
                                        enumValueNames: var str[],
                                        enumValueTypes: var str[],
                                        enumValueOrdinals: var int32[],
                                        declaredTypes: var str[],
                                        declaredTypeProducerSourceIndexes: var int32[],
                                        declaredTypeDeclarationSourceLocalRows: var int32[],
                                        declaredTypeBuiltinKinds: var int32[],
                                        declTrimmed: str,
                                        declIndent: int32,
                                        includeTypeFields: bool,
                                        currentTypeName: var str,
                                        currentTypeIndent: var int32,
                                        currentTypeIsEnum: var bool,
                                        currentEnumOrdinal: var int32,
                                        declLineNumber: int32,
                                        err: var str): str =
    let declaredType = TypedExprParseTypeDeclName(declTrimmed)
    if declaredType == "":
        return ""
    let aliasTarget = TypedExprParseTypeDeclRhs(declTrimmed)
    TypedExprMaybeAddTypeDefAlias(sourcePath,
                                  typeDefAliasNames,
                                  typeDefAliasTargetTypes,
                                  declaredType,
                                  aliasTarget,
                                  declLineNumber,
                                  err)
    if err != "":
        return ""
    TypedExprMaybeAddRefType(refTypes, declaredType, aliasTarget)
    currentTypeName = strings.CloneStr(declaredType)
    currentTypeIndent = declIndent
    currentTypeIsEnum = parser.ParserFindText(declTrimmed, "enum") >= 0
    currentEnumOrdinal = 0
    if includeTypeFields:
        TypedExprContextAddInlineEnumValues(enumValueNames,
                                            enumValueTypes,
                                            enumValueOrdinals,
                                            declaredType,
                                            aliasTarget)
    if !parser.ParserStringSeqContainsExact(declaredTypes, declaredType):
        add(declaredTypes, strings.CloneStr(declaredType))
        add(declaredTypeProducerSourceIndexes, -1)
        add(declaredTypeDeclarationSourceLocalRows, -1)
        add(declaredTypeBuiltinKinds,
            Int32(TypedExprLayoutBuiltinNone))
    return declaredType

@borrows
fn TypedExprCloneStrSeq(items: str[]): str[] =
    var out: str[]
    for i in 0..<items.len:
        add(out, share(items[i]))
    return out

@borrows
fn TypedExprCloneI32Seq(items: int32[]): int32[] =
    var out: int32[]
    for i in 0..<items.len:
        add(out, items[i])
    return out

type
    TypedExprTypeDeclLineResult =
        declaredType: str
        typeDefAliasNames: str[]
        typeDefAliasTargetTypes: str[]
        refTypes: str[]
        enumValueNames: str[]
        enumValueTypes: str[]
        enumValueOrdinals: int32[]
        declaredTypes: str[]
        declaredTypeProducerSourceIndexes: int32[]
        declaredTypeDeclarationSourceLocalRows: int32[]
        declaredTypeBuiltinKinds: int32[]
        currentTypeName: str
        currentTypeIndent: int32
        currentTypeIsEnum: bool
        currentEnumOrdinal: int32
        err: str

@borrows
fn TypedExprContextProcessTypeDeclLineOwned(sourcePath: str,
                                             typeDefAliasNames: str[],
                                             typeDefAliasTargetTypes: str[],
                                             refTypes: str[],
                                             enumValueNames: str[],
                                             enumValueTypes: str[],
                                             enumValueOrdinals: int32[],
                                             declaredTypes: str[],
                                             declaredTypeProducerSourceIndexes: int32[],
                                             declaredTypeDeclarationSourceLocalRows: int32[],
                                             declaredTypeBuiltinKinds: int32[],
                                             declTrimmed: str,
                                             declIndent: int32,
                                             includeTypeFields: bool,
                                             currentTypeName: str,
                                             currentTypeIndent: int32,
                                             currentTypeIsEnum: bool,
                                             currentEnumOrdinal: int32,
                                             declLineNumber: int32): TypedExprTypeDeclLineResult =
    # Fast reject: a line without a top-level type-decl name cannot mutate any
    # accumulated type table. Return the borrowed columns unchanged instead of
    # cloning ten growing arrays on every field/enum line.
    if TypedExprParseTypeDeclName(declTrimmed) == "":
        var fastOut: TypedExprTypeDeclLineResult
        fastOut.typeDefAliasNames = share(typeDefAliasNames)
        fastOut.typeDefAliasTargetTypes = share(typeDefAliasTargetTypes)
        fastOut.refTypes = share(refTypes)
        fastOut.enumValueNames = share(enumValueNames)
        fastOut.enumValueTypes = share(enumValueTypes)
        fastOut.enumValueOrdinals = share(enumValueOrdinals)
        fastOut.declaredTypes = share(declaredTypes)
        fastOut.declaredTypeProducerSourceIndexes =
            share(declaredTypeProducerSourceIndexes)
        fastOut.declaredTypeDeclarationSourceLocalRows =
            share(declaredTypeDeclarationSourceLocalRows)
        fastOut.declaredTypeBuiltinKinds = share(declaredTypeBuiltinKinds)
        fastOut.currentTypeName = share(currentTypeName)
        fastOut.currentTypeIndent = currentTypeIndent
        fastOut.currentTypeIsEnum = currentTypeIsEnum
        fastOut.currentEnumOrdinal = currentEnumOrdinal
        fastOut.err = ""
        return fastOut
    var out: TypedExprTypeDeclLineResult
    var aliasNames = TypedExprCloneStrSeq(typeDefAliasNames)
    var aliasTargets = TypedExprCloneStrSeq(typeDefAliasTargetTypes)
    var refs = TypedExprCloneStrSeq(refTypes)
    var enumNames = TypedExprCloneStrSeq(enumValueNames)
    var enumTypes = TypedExprCloneStrSeq(enumValueTypes)
    var enumOrdinals = TypedExprCloneI32Seq(enumValueOrdinals)
    var declTypes = TypedExprCloneStrSeq(declaredTypes)
    var declProducers = TypedExprCloneI32Seq(declaredTypeProducerSourceIndexes)
    var declRows = TypedExprCloneI32Seq(declaredTypeDeclarationSourceLocalRows)
    var declBuiltins = TypedExprCloneI32Seq(declaredTypeBuiltinKinds)
    var typeName = strings.CloneStr(currentTypeName)
    var typeIndent = currentTypeIndent
    var typeIsEnum = currentTypeIsEnum
    var typeOrdinal = currentEnumOrdinal
    var lineErr = ""
    out.declaredType = TypedExprContextProcessTypeDeclLine(sourcePath,
                                                           aliasNames,
                                                           aliasTargets,
                                                           refs,
                                                           enumNames,
                                                           enumTypes,
                                                           enumOrdinals,
                                                           declTypes,
                                                           declProducers,
                                                           declRows,
                                                           declBuiltins,
                                                           declTrimmed,
                                                           declIndent,
                                                           includeTypeFields,
                                                           typeName,
                                                           typeIndent,
                                                           typeIsEnum,
                                                           typeOrdinal,
                                                           declLineNumber,
                                                           lineErr)
    out.typeDefAliasNames = aliasNames
    out.typeDefAliasTargetTypes = aliasTargets
    out.refTypes = refs
    out.enumValueNames = enumNames
    out.enumValueTypes = enumTypes
    out.enumValueOrdinals = enumOrdinals
    out.declaredTypes = declTypes
    out.declaredTypeProducerSourceIndexes = declProducers
    out.declaredTypeDeclarationSourceLocalRows = declRows
    out.declaredTypeBuiltinKinds = declBuiltins
    out.currentTypeName = typeName
    out.currentTypeIndent = typeIndent
    out.currentTypeIsEnum = typeIsEnum
    out.currentEnumOrdinal = typeOrdinal
    out.err = lineErr
    return out

# Recognize the inline type-decl head `type Name = ...` on a non-indented line
# and return its tail (`Name = ...`); "" for the bare block keyword `type` or a
# non-type line. The tail is fed to TypedExprContextProcessTypeDeclLine with the
# `type` line's own indent so subsequent more-indented field lines are captured.
@borrows
fn TypedExprInlineTypeDeclTail(trimmedRaw: str): str =
    let trimmed = chengpath.PathTrim(trimmedRaw)
    if !parser.ParserStartsWith(trimmed, "type "):
        return ""
    let tail = chengpath.PathTrim(chengpath.TextSlice(trimmed, 5, trimmed.len - 5))
    if tail == "":
        return ""
    if TypedExprParseTypeDeclName(tail) == "":
        return ""
    return tail

# Hot read-only line trim: borrow the comment-stripped slice instead of paying
# ParserStripLineComment's owned copy plus PathTrim's second copy on every line.
# The view is consumed inside the loop; persistent derived names are owned copies.
@borrows
@borrow_result
fn TypedExprTrimmedLineView(lineRaw: str): str =
    let stripped = parser.ParserStripLineCommentHashAwareView(lineRaw)
    var start: int32
    var stop: int32
    if !parser.ParserTrimmedLineRange(stripped, start, stop):
        return ""
    return parser.ParserTextSliceFast(stripped, start, stop - start)

@borrows
@borrow_result
fn TypedExprTrimmedRangeView(text: str,
                              startRaw: int32,
                              stopRaw: int32): str =
    let slice = parser.ParserTextSliceFast(text, startRaw, stopRaw - startRaw)
    var start: int32
    var stop: int32
    if !parser.ParserTrimmedLineRange(slice, start, stop):
        return ""
    return parser.ParserTextSliceFast(slice, start, stop - start)

# Exact raw line byte length. The dense column is optional: when absent (the
# common metadata case) derive it from the next line start, or from
# sourceByteLength for the final line. '\n' is the sole separator consumed by
# typedExprBuildSealedSourceLineIndex, so this is byte-identical.
@borrows
fn TypedExprSourceContextLineByteLength(ctx: TypedExprSourceContext,
                                        lineIndex: int32): int32 =
    if lineIndex < 0 || lineIndex >= ctx.sourceLineByteStarts.len:
        return -1
    if ctx.sourceLineByteLengths.len > 0:
        return ctx.sourceLineByteLengths[lineIndex]
    if lineIndex + 1 < ctx.sourceLineByteStarts.len:
        return ctx.sourceLineByteStarts[lineIndex + 1] -
               ctx.sourceLineByteStarts[lineIndex] - 1
    return ctx.sourceByteLength - ctx.sourceLineByteStarts[lineIndex]


# Signature generic discovery runs before the full type-field scan. Collect the
# declaration names once so an in-scope one-letter type remains concrete instead
# of being misclassified as an implicit generic solely because of build order.
@borrows
fn TypedExprCollectDeclaredTypeNames(lines: str[],
                                     declaredTypes: var str[]) =
    declaredTypes = []
    var inTypeBlock = false
    var currentTypeName = ""
    var currentTypeIndent: int32
    var currentTypeIsEnum = false
    for lineIndex in 0..<lines.len:
        let rawLine = lines[lineIndex]
        let trimmed = TypedExprTrimmedLineView(rawLine)
        if !parser.ParserHasLeadingIndent(rawLine):
            if trimmed == "":
                continue
            currentTypeName = ""
            currentTypeIndent = 0
            currentTypeIsEnum = false
            inTypeBlock = trimmed == "type"
            let inlineTypeTail = TypedExprInlineTypeDeclTail(trimmed)
            if inlineTypeTail != "":
                inTypeBlock = true
                let declaredType = TypedExprParseTypeDeclName(inlineTypeTail)
                if declaredType != "":
                    if !parser.ParserStringSeqContainsExact(declaredTypes,
                                                            declaredType):
                        add(declaredTypes, share(declaredType))
                    currentTypeName = declaredType
                    currentTypeIsEnum = parser.ParserFindText(inlineTypeTail,
                                                              "enum") >= 0
            continue
        if !inTypeBlock:
            continue
        let lineIndent = TypedExprLineIndentWidth(rawLine)
        if currentTypeIsEnum && currentTypeName != "" &&
           lineIndent > currentTypeIndent:
            continue
        let declaredType = TypedExprParseTypeDeclName(trimmed)
        if declaredType == "":
            continue
        if !parser.ParserStringSeqContainsExact(declaredTypes, declaredType):
            add(declaredTypes, share(declaredType))
        currentTypeName = declaredType
        currentTypeIndent = lineIndent
        currentTypeIsEnum = parser.ParserFindText(trimmed, "enum") >= 0

@borrows
fn TypedExprSplitTopLevelCsv(itemsRaw: str): str[] =
    TypedExprTraceLine("typed_split_csv:enter")
    var out: str[]
    var start: int32
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<itemsRaw.len:
        if i % 128 == 0:
            TypedExprTraceLine("typed_split_csv:loop_chunk")
        let piece = itemsRaw[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
        elif piece == '\'':
            inChar = true
        elif piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif piece == ',':
            if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
                TypedExprTraceLine("typed_split_csv:before_add_piece")
                add(out, TypedExprSliceTrim(share(itemsRaw), start, i - start))
                TypedExprTraceLine("typed_split_csv:after_add_piece")
                start = i + 1
    TypedExprTraceLine("typed_split_csv:before_add_tail")
    add(out, TypedExprSliceTrim(share(itemsRaw), start, itemsRaw.len - start))
    TypedExprTraceLine("typed_split_csv:after_add_tail")
    return out

fn TypedExprSplitTopLevelTypeList(itemsRaw: str,
                                   itemsOut: var str[],
                                   err: var str): bool =
    itemsOut = []
    let items = chengpath.PathTrim(itemsRaw)
    if items == "":
        err = "typed expr: empty generic parameter list"
        return false
    var start: int32
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    for i in 0..<items.len:
        let ch = items[i]
        if ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
        elif (ch == ',' || ch == ';') &&
             bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            let item = TypedExprSliceTrim(share(items), start, i - start)
            if item == "":
                err = "typed expr: empty generic list item"
                return false
            add(itemsOut, item)
            start = i + 1
        if bracketDepth < 0 || parenDepth < 0 || braceDepth < 0:
            err = "typed expr: unbalanced generic list"
            return false
    if bracketDepth != 0 || parenDepth != 0 || braceDepth != 0:
        err = "typed expr: unbalanced generic list"
        return false
    let tail = TypedExprSliceTrim(share(items), start, items.len - start)
    if tail == "":
        err = "typed expr: empty generic list tail"
        return false
    add(itemsOut, tail)
    err = ""
    return true

@borrows
fn TypedExprCallHeadGenericTypesInto(callHeadRaw: str,
                                      genericTypesOut: var str[],
                                      explicitOut: var bool,
                                      baseHeadOut: var str,
                                      err: var str): bool =
    genericTypesOut = []
    explicitOut = false
    baseHeadOut = ""
    let callHead = chengpath.PathTrim(share(callHeadRaw))
    if callHead == "":
        err = "typed expr: empty call head"
        return false
    let genericOpen = TypedExprFindTopLevelToken(callHead, "[")
    if genericOpen < 0:
        baseHeadOut = callHead
        err = ""
        return true
    let genericClose = TypedExprFindMatchingBracket(callHead, genericOpen)
    if genericClose <= genericOpen || genericClose + 1 != callHead.len:
        err = Fmt"typed expr: malformed explicit generic call head={callHead}"
        return false
    baseHeadOut = chengpath.PathTrim(chengpath.TextSlice(share(callHead),
                                                         0,
                                                         genericOpen))
    if baseHeadOut == "":
        err = Fmt"typed expr: explicit generic call has no callee head={callHead}"
        return false
    var genericItems: str[]
    if !TypedExprSplitTopLevelTypeList(
            chengpath.TextSlice(share(callHead),
                               genericOpen + 1,
                               genericClose - genericOpen - 1),
            genericItems,
            err):
        return false
    for itemIndex in 0..<genericItems.len:
        let genericType = TypedExprNormalizeTypeText(share(genericItems[itemIndex]))
        if genericType == "" || !TypedExprBootstrapContractTypeOk(share(genericType)):
            err = Fmt"typed expr: invalid explicit generic argument index={itemIndex} head={callHead}"
            return false
        add(genericTypesOut, genericType)
    explicitOut = true
    err = ""
    return true

@borrows
fn TypedExprFunctionExplicitGenericNamesInto(headerRaw: str,
                                               genericNamesOut: var str[],
                                               explicitOut: var bool,
                                               err: var str): bool =
    genericNamesOut = []
    explicitOut = false
    let header = chengpath.PathTrim(headerRaw)
    if header == "":
        err = ""
        return true
    let paramOpen = TypedExprFindWholeCallOpenParen(share(header))
    if paramOpen <= 0:
        err = ""
        return true
    let routineHead = chengpath.PathTrim(chengpath.TextSlice(header,
                                                             0,
                                                             paramOpen))
    # The collected header still includes its declaration keyword. Strip that
    # exact surface prefix before classifying the routine-name token.
    var nameHead = share(routineHead)
    if parser.ParserStartsWith(nameHead, "importc fn "):
        nameHead = chengpath.PathTrim(chengpath.TextSlice(nameHead,
                                                          11,
                                                          nameHead.len - 11))
    elif parser.ParserStartsWith(nameHead, "async fn "):
        nameHead = chengpath.PathTrim(chengpath.TextSlice(nameHead,
                                                          9,
                                                          nameHead.len - 9))
    elif parser.ParserStartsWith(nameHead, "fn "):
        nameHead = chengpath.PathTrim(chengpath.TextSlice(nameHead,
                                                          3,
                                                          nameHead.len - 3))
    elif parser.ParserStartsWith(nameHead, "iterator "):
        nameHead = chengpath.PathTrim(chengpath.TextSlice(nameHead,
                                                          9,
                                                          nameHead.len - 9))
    # Backtick operators are a distinct name token. Brackets inside `` `[]` ``
    # and `` `[]=` `` spell the operator, not a type-parameter list. The formal
    # routine grammar only attaches an explicit typeParamList to an identifier,
    # so operator declarations continue to use the existing implicit generics.
    if nameHead.len > 0 && Int32(nameHead[0]) == 96:
        var backtickClose: int32 = 1
        while backtickClose < nameHead.len &&
              Int32(nameHead[backtickClose]) != 96:
            backtickClose = backtickClose + 1
        if backtickClose <= 1 || backtickClose >= nameHead.len:
            err = Fmt"typed expr: malformed backtick function declaration head={routineHead}"
            return false
        let operatorTail = chengpath.PathTrim(chengpath.TextSlice(
            nameHead,
            backtickClose + 1,
            nameHead.len - backtickClose - 1))
        if operatorTail != "":
            err = Fmt"typed expr: malformed function generic declaration head={routineHead}"
            return false
        err = ""
        return true
    let routineName = parser.ParserIdentPrefix(nameHead)
    if routineName == "":
        err = ""
        return true
    let genericTail = chengpath.PathTrim(chengpath.TextSlice(
        nameHead,
        routineName.len,
        nameHead.len - routineName.len))
    if genericTail == "":
        err = ""
        return true
    if genericTail[0] != '[':
        err = ""
        return true
    let genericOpen = 0
    let genericClose = TypedExprFindMatchingBracket(genericTail, genericOpen)
    if genericClose <= genericOpen || genericClose + 1 != genericTail.len:
        err = Fmt"typed expr: malformed function generic declaration head={routineHead}"
        return false
    var genericItems: str[]
    if !TypedExprSplitTopLevelTypeList(
            chengpath.TextSlice(genericTail,
                               genericOpen + 1,
                               genericClose - genericOpen - 1),
            genericItems,
            err):
        return false
    for itemIndex in 0..<genericItems.len:
        let item = chengpath.PathTrim(share(genericItems[itemIndex]))
        var stop = item.len
        let colonPos = TypedExprFindTopLevelTextToken(item, ":")
        let eqPos = TypedExprFindTopLevelTextToken(item, "=")
        if colonPos >= 0 && colonPos < stop:
            stop = colonPos
        if eqPos >= 0 && eqPos < stop:
            stop = eqPos
        let genericName = chengpath.PathTrim(chengpath.TextSlice(item, 0, stop))
        if genericName == "" || parser.ParserIdentPrefix(genericName) != genericName:
            err = Fmt"typed expr: invalid function generic parameter index={itemIndex} item={item}"
            return false
        for priorIndex in 0..<genericNamesOut.len:
            if genericNamesOut[priorIndex] == genericName:
                err = Fmt"typed expr: duplicate function generic parameter name={genericName}"
                return false
        if colonPos >= 0:
            if eqPos >= 0 && eqPos < colonPos:
                err = Fmt"typed expr: generic default precedes constraint name={genericName}"
                return false
            var constraintStop = item.len
            if eqPos >= 0:
                constraintStop = eqPos
            let constraintType = chengpath.PathTrim(chengpath.TextSlice(
                item,
                colonPos + 1,
                constraintStop - colonPos - 1))
            if constraintType == "":
                err = Fmt"typed expr: empty function generic constraint name={genericName}"
                return false
        if eqPos >= 0:
            let defaultType = chengpath.PathTrim(chengpath.TextSlice(
                item,
                eqPos + 1,
                item.len - eqPos - 1))
            if defaultType == "":
                err = Fmt"typed expr: empty function generic default name={genericName}"
                return false
        add(genericNamesOut, genericName)
    explicitOut = true
    err = ""
    return true

@borrows
fn TypedExprContextHasConcreteSingleLetterType(ctx: TypedExprSourceContext,
                                                name: str): bool =
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    if sourcePath == "" || name == "":
        return false
    var rowIndex: int32
    return TypedExprBuildIndexLookup(ctx.buildIndex,
                                     "ctx_declared_source",
                                     sourcePath,
                                     name,
                                     "",
                                     rowIndex) == TypedExprBuildIndexUnique ||
           TypedExprBuildIndexLookup(ctx.buildIndex,
                                     "ctx_ref_source",
                                     sourcePath,
                                     name,
                                     "",
                                     rowIndex) == TypedExprBuildIndexUnique ||
           TypedExprBuildIndexLookup(ctx.buildIndex,
                                     "ctx_alias_source",
                                     sourcePath,
                                     name,
                                     "",
                                     rowIndex) == TypedExprBuildIndexUnique

@borrows
fn TypedExprAppendImplicitGenericNamesFromType(
        ctx: TypedExprSourceContext,
        typeRaw: str,
        genericNames: var str[]) =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    var cursor: int32
    while cursor < typeText.len:
        let first = typeText[cursor]
        let identStart = (first >= 'a' && first <= 'z') ||
                         (first >= 'A' && first <= 'Z') || first == '_'
        if !identStart:
            cursor = cursor + 1
            continue
        let start = cursor
        cursor = cursor + 1
        while cursor < typeText.len:
            let ch = typeText[cursor]
            let identPart = (ch >= 'a' && ch <= 'z') ||
                            (ch >= 'A' && ch <= 'Z') ||
                            (ch >= '0' && ch <= '9') || ch == '_'
            if !identPart:
                break
            cursor = cursor + 1
        let token = chengpath.TextSlice(typeText, start, cursor - start)
        var genericName = ""
        if token.len == 1 && token[0] >= 'A' && token[0] <= 'Z':
            genericName = token
        elif token.len == 4 &&
             (chengpath.TextSlice(token, 0, 3) == "ref" ||
              chengpath.TextSlice(token, 0, 3) == "var") &&
             token[3] >= 'A' && token[3] <= 'Z':
            genericName = chengpath.TextSlice(token, 3, 1)
        if genericName == "":
            continue
        let qualifiedLeft = start > 0 && typeText[start - 1] == '.'
        let qualifiedRight = cursor < typeText.len && typeText[cursor] == '.'
        if qualifiedLeft || qualifiedRight ||
           TypedExprContextHasConcreteSingleLetterType(ctx, share(genericName)):
            continue
        var seen = false
        for nameIndex in 0..<genericNames.len:
            if genericNames[nameIndex] == genericName:
                seen = true
                break
        if !seen:
            add(genericNames, genericName)

type
    TypedExprGenericNameJoinResult =
        ok: bool
        join: str
        err: str

@borrows
fn TypedExprFunctionGenericNameJoinOwned(ctx: TypedExprSourceContext,
                                          headerRaw: str,
                                          paramTypes: str[],
                                          returnType: str): TypedExprGenericNameJoinResult =
    var out: TypedExprGenericNameJoinResult
    var genericNames: str[]
    var genericErr = ""
    if !TypedExprFunctionGenericNamesInto(ctx,
                                          headerRaw,
                                          paramTypes,
                                          returnType,
                                          genericNames,
                                          genericErr):
        out.err = genericErr
        return out
    out.ok = true
    out.join = TypedExprJoinGenericNames(genericNames)
    return out

@borrows
fn TypedExprFunctionGenericNamesInto(ctx: TypedExprSourceContext,
                                      headerRaw: str,
                                      paramTypes: str[],
                                      returnType: str,
                                      genericNamesOut: var str[],
                                      err: var str): bool =
    var explicit = false
    if !TypedExprFunctionExplicitGenericNamesInto(headerRaw,
                                                   genericNamesOut,
                                                   explicit,
                                                   err):
        return false
    if explicit:
        return true
    genericNamesOut = []
    for paramIndex in 0..<paramTypes.len:
        TypedExprAppendImplicitGenericNamesFromType(ctx,
                                                    paramTypes[paramIndex],
                                                    genericNamesOut)
    TypedExprAppendImplicitGenericNamesFromType(ctx,
                                                returnType,
                                                genericNamesOut)
    err = ""
    return true

fn TypedExprAlignBytes(value: int32, alignRaw: int32): int32 =
    var align = alignRaw
    if align <= 1:
        return value
    let rem = value % align
    if rem == 0:
        return value
    return value + (align - rem)

@borrows
fn TypedExprStripVarType(typeRaw: str): str =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if parser.ParserStartsWith(typeText, "var") && typeText.len > 3:
        return chengpath.TextSlice(typeText, 3, typeText.len - 3)
    return typeText

@borrows
fn TypedExprTypeLeafName(typeRaw: str): str =
    let typeText = TypedExprStripVarType(typeRaw)
    var start: int32
    var stop: int32 = typeText.len
    for i in 0..<typeText.len:
        if typeText[i] == '.':
            start = i + 1
        elif i + 1 < typeText.len && typeText[i] == ':' && typeText[i + 1] == ':':
            start = i + 2
        elif typeText[i] == '[':
            stop = i
            break
    if start >= stop:
        start = 0
        stop = typeText.len
    if start > 0 && start < stop:
        return chengpath.TextSlice(typeText, start, stop - start)
    if stop < typeText.len:
        return chengpath.PathTrim(chengpath.TextSlice(typeText, 0, stop))
    return typeText

@borrows
fn TypedExprPointerPointeeType(currentCtx: TypedExprSourceContext,
                                sourceContexts: TypedExprSourceContext[],
                                typeRaw: str): str =
    let typeText = chengpath.PathTrim(TypedExprStripVarType(typeRaw))
    if typeText == "":
        return ""
    if typeText.len > 0 && typeText[typeText.len - 1] == '*':
        return chengpath.PathTrim(chengpath.TextSlice(typeText, 0, typeText.len - 1))
    let aliasName = TypedExprTypeLeafName(typeText)
    var targetType: str
    let sourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
    let sourceState = TypedExprBuildIndexLookupFingerprint(currentCtx.buildIndex,
                                                            "ctx_alias_source", sourcePath, aliasName, "", targetType)
    if sourceState == TypedExprBuildIndexUnique:
        return TypedExprPointerAliasPointeeType(targetType)
    if sourceState == TypedExprBuildIndexAmbiguous:
        return ""
    let importedState = TypedExprBuildIndexLookupFingerprint(currentCtx.buildIndex,
                                                               "ctx_import_alias_def", sourcePath, aliasName, "", targetType)
    if importedState == TypedExprBuildIndexUnique:
        return TypedExprPointerAliasPointeeType(targetType)
    if sourcePath != "":
        return ""
    let globalState = TypedExprBuildIndexLookupFingerprint(TypedExprContextsBuildIndex(sourceContexts),
                                                            "ctx_alias_global", "", aliasName, "", targetType)
    if globalState != TypedExprBuildIndexUnique:
        return ""
    return TypedExprPointerAliasPointeeType(targetType)

fn TypedExprTypeFieldDeclMatches(field: TypedExprTypeFieldDecl,
                                  ownerTypeRaw: str,
                                  fieldNameRaw: str): bool =
    if field.ownerType != TypedExprTypeLeafName(ownerTypeRaw):
        return false
    if field.fieldName != parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw)):
        return false
    return true

@borrows
fn TypedExprContextHasTypeField(ctx: TypedExprSourceContext,
                                 ownerTypeRaw: str): bool =
    let ownerType = TypedExprTypeLeafName(ownerTypeRaw)
    var contextIndex: int32
    return TypedExprBuildIndexLookup(ctx.buildIndex,
                                     "ctx_field_owner_source",
                                     parser.ParserNormalizePath(ctx.sourcePath),
                                     ownerType,
                                     "",
                                     contextIndex) == TypedExprBuildIndexUnique

fn TypedExprAddTypeFieldDecl(ctx: var TypedExprSourceContext,
                              ownerTypeRaw: str,
                              fieldNameRaw: str,
                              fieldTypeRaw: str) =
    let ownerType = TypedExprTypeLeafName(ownerTypeRaw)
    let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw))
    let fieldType = TypedExprNormalizeTypeText(fieldTypeRaw)
    if ownerType == "" || fieldName == "" || fieldType == "":
        return
    var decl: TypedExprTypeFieldDecl
    decl.ownerType = ownerType
    decl.fieldName = fieldName
    decl.fieldType = fieldType
    decl.producerSourceIndex = -1
    decl.ownerDeclarationSourceLocalRow = -1
    decl.fieldDeclarationSourceLocalRow = -1
    decl.ordinal = -1
    decl.builtinKind = TypedExprLayoutBuiltinNone
    add(ctx.typeFields, decl)

# O(1) append. The previous spelling rebuilt the complete `typeFields` seq on
# every parsed field row, which made self-host metadata construction quadratic
# in field count (1.48M calls / 740MB copied on the kernel self-bake).
# Normalize first, reject the empty row, then append in place.
@borrows
fn TypedExprAddTypeFieldDeclInPlace(typeFields: var TypedExprTypeFieldDecl[],
                                    ownerTypeRaw: str,
                                    fieldNameRaw: str,
                                    fieldTypeRaw: str) =
    let ownerType = TypedExprTypeLeafName(ownerTypeRaw)
    let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw))
    let fieldType = TypedExprNormalizeTypeText(fieldTypeRaw)
    if ownerType == "" || fieldName == "" || fieldType == "":
        return
    var decl: TypedExprTypeFieldDecl
    decl.ownerType = ownerType
    decl.fieldName = fieldName
    decl.fieldType = fieldType
    decl.producerSourceIndex = -1
    decl.ownerDeclarationSourceLocalRow = -1
    decl.fieldDeclarationSourceLocalRow = -1
    decl.ordinal = -1
    decl.builtinKind = TypedExprLayoutBuiltinNone
    add(typeFields, decl)

fn TypedExprBindDeclaredTypeExactCoordinate(
        ctx: var TypedExprSourceContext,
        declaredTypeIndex: int32,
        producerSourceIndex: int32,
        declarationSourceLocalRow: int32,
        builtinKind: TypedExprLayoutBuiltinKind) =
    if declaredTypeIndex < 0 ||
       declaredTypeIndex >= ctx.declaredTypes.len ||
       ctx.declaredTypeProducerSourceIndexes.len !=
           ctx.declaredTypes.len ||
       ctx.declaredTypeDeclarationSourceLocalRows.len !=
           ctx.declaredTypes.len ||
       ctx.declaredTypeBuiltinKinds.len != ctx.declaredTypes.len ||
       producerSourceIndex < 0 ||
       ((builtinKind == TypedExprLayoutBuiltinNone) !=
        (declarationSourceLocalRow >= 0)):
        panic("typed expr: declared type exact coordinate invalid")
    if ctx.declaredTypeProducerSourceIndexes[declaredTypeIndex] != -1 ||
       ctx.declaredTypeDeclarationSourceLocalRows[declaredTypeIndex] != -1 ||
       ctx.declaredTypeBuiltinKinds[declaredTypeIndex] !=
           Int32(TypedExprLayoutBuiltinNone):
        panic("typed expr: declared type exact coordinate rebound")
    ctx.declaredTypeProducerSourceIndexes[declaredTypeIndex] =
        producerSourceIndex
    ctx.declaredTypeDeclarationSourceLocalRows[declaredTypeIndex] =
        declarationSourceLocalRow
    ctx.declaredTypeBuiltinKinds[declaredTypeIndex] =
        Int32(builtinKind)

fn TypedExprBindTypeFieldExactCoordinate(
        ctx: var TypedExprSourceContext,
        fieldIndex: int32,
        producerSourceIndex: int32,
        ownerDeclarationSourceLocalRow: int32,
        fieldDeclarationSourceLocalRow: int32,
        ordinal: int32,
        builtinKind: TypedExprLayoutBuiltinKind) =
    if fieldIndex < 0 || fieldIndex >= ctx.typeFields.len ||
       producerSourceIndex < 0 || ordinal < 0 ||
       ((builtinKind == TypedExprLayoutBuiltinNone) !=
        (ownerDeclarationSourceLocalRow >= 0 &&
         fieldDeclarationSourceLocalRow >= 0)):
        panic("typed expr: type field exact coordinate invalid")
    let prior = ctx.typeFields[fieldIndex]
    if prior.producerSourceIndex != -1 ||
       prior.ownerDeclarationSourceLocalRow != -1 ||
       prior.fieldDeclarationSourceLocalRow != -1 ||
       prior.ordinal != -1 ||
       prior.builtinKind != TypedExprLayoutBuiltinNone:
        panic("typed expr: type field exact coordinate rebound")
    var next = prior
    next.producerSourceIndex = producerSourceIndex
    next.ownerDeclarationSourceLocalRow =
        ownerDeclarationSourceLocalRow
    next.fieldDeclarationSourceLocalRow =
        fieldDeclarationSourceLocalRow
    next.ordinal = ordinal
    next.builtinKind = builtinKind
    ctx.typeFields[fieldIndex] = next

fn TypedExprBindExactLayoutParserAuthority(
        ctx: var TypedExprSourceContext,
        producerSourceCount: int32,
        declarationSourceCount: int32) =
    if producerSourceCount <= 0 ||
       producerSourceCount >= 134217727 ||
       declarationSourceCount < 0:
        panic("typed expr: exact layout parser authority invalid")
    if ctx.exactLayoutParserIdentityBound:
        if ctx.exactLayoutProducerSourceCount !=
               producerSourceCount ||
           ctx.exactLayoutDeclarationSourceCount !=
               declarationSourceCount:
            panic("typed expr: exact layout parser authority rebound")
        return
    if ctx.exactLayoutProducerSourceCount != 0 ||
       ctx.exactLayoutDeclarationSourceCount != 0:
        panic("typed expr: partial exact layout parser authority")
    ctx.exactLayoutProducerSourceCount = producerSourceCount
    ctx.exactLayoutDeclarationSourceCount =
        declarationSourceCount
    ctx.exactLayoutParserIdentityBound = true

@borrows
fn TypedExprParseTypeFieldLine(lineRaw: str,
                                fieldName: var str,
                                fieldType: var str): bool =
    fieldName = ""
    fieldType = ""
    let line = chengpath.PathTrim(parser.ParserStripLineComment(lineRaw))
    if line == "":
        return false
    let colonPos = TypedExprFindTopLevelToken(line, ":")
    if colonPos <= 0:
        return false
    let eqPos = TypedExprFindTopLevelToken(line, "=")
    fieldName = parser.ParserIdentPrefix(chengpath.TextSlice(line, 0, colonPos))
    var typeEnd = line.len
    if eqPos > colonPos:
        typeEnd = eqPos
    fieldType = TypedExprNormalizeTypeText(chengpath.TextSlice(line,
                                                               colonPos + 1,
                                                               typeEnd - colonPos - 1))
    if fieldName == "":
        return false
    if fieldType == "":
        return false
    return true

@borrows
fn TypedExprConstBlockEntryBinding(lineRaw: str,
                                    entryName: var str,
                                    entryType: var str,
                                    entryInit: var str): bool =
    # `const` 块内**无类型标注**的条目（`Name = literal`）。有标注的条目
    # （`Name: T = literal`）走 TypedExprParseTypeFieldLine，不进这里。
    #
    # 存在的理由（2026-09-11）：parser sidecar 把 `const` 块条目记成模块级
    # 声明行，parser-owned 全局身份 pass 因而为它产出全局绑定；而 metadata
    # 侧三个绑定生产点此前只认 `var` 块，`const` 块条目一条都不产 ⇒
    # compiler_csg 的覆盖闸 `candidate.len != ctx.bindings.len` 对**任何含
    # `const` 块的源**失败（全仓 818 文件 / 9041 条目）⇒ 逐源增量森林
    # forest_appended 恒为 0。类型推断阶梯必须与 parser 侧逐字一致：
    # bool 表达式类型 → 字面量类型；推不出类型的条目不绑（parser 侧同样不产
    # 绑定），否则计数会反向不等。
    entryName = ""
    entryType = ""
    entryInit = ""
    let line = chengpath.PathTrim(parser.ParserStripLineComment(lineRaw))
    if line == "":
        return false
    let eqPos = TypedExprFindTopLevelToken(line, "=")
    if eqPos <= 0:
        return false
    let head = chengpath.TextSlice(line, 0, eqPos)
    if TypedExprFindTopLevelToken(head, ":") >= 0:
        return false
    entryName = parser.ParserIdentPrefix(chengpath.PathTrim(head))
    if entryName == "":
        return false
    entryInit = chengpath.PathTrim(chengpath.TextSlice(line,
                                                        eqPos + 1,
                                                        line.len - eqPos - 1))
    if entryInit == "":
        return false
    entryType = TypedExprBindingRhsBoolExprType(entryInit)
    if entryType == "":
        entryType = TypedExprLiteralBindingType(entryInit)
    if entryType == "":
        return false
    return true

@borrows
fn TypedExprColdCsgTextIsFactSafe(text: str): bool =
    for i in 0..<text.len:
        if text[i] == '\t' || text[i] == '\n' || text[i] == '\r':
            return false
    return true

@borrows
fn TypedExprColdCsgLineHasTripleQuote(line: str): bool =
    return parser.ParserFindText(line, "\"\"\"") >= 0

@borrows
fn TypedExprColdCsgLineTopLevel(line: str): bool =
    let trimmed = chengpath.PathTrim(line)
    if trimmed == "":
        return false
    return TypedExprLineIndentWidth(line) == 0

fn TypedExprColdCsgStripTrailingColon(textRaw: str): str =
    var text = chengpath.PathTrim(textRaw)
    if text.len > 0 && text[text.len - 1] == ':':
        text = chengpath.PathTrim(chengpath.TextSlice(text, 0, text.len - 1))
    return text

fn TypedExprColdCsgStripTrailingOpenBrace(textRaw: str): str =
    var text = chengpath.PathTrim(textRaw)
    if text.len > 0 && text[text.len - 1] == '{':
        text = chengpath.PathTrim(chengpath.TextSlice(text, 0, text.len - 1))
    return text

fn TypedExprColdCsgControlPayload(surfaceRaw: str, keyword: str): str =
    let surface = TypedExprColdCsgStripTrailingColon(surfaceRaw)
    if !parser.ParserStartsWith(surface, keyword):
        return surface
    if surface.len <= keyword.len:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(surface,
                                                  keyword.len,
                                                  surface.len - keyword.len))

@borrows
fn TypedExprColdCsgFieldKindCodeFromTypeName(typeName: str): str =
    let t = TypedExprNormalizeTypeText(typeName)
    if t == "str" || t == "cstring":
        return "s"
    if t == "int32[]" || t == "int[]":
        return ""
    if t == "uint64" || t == "int64":
        return "l"
    if t.len > 1 && t[0] >= 'A' && t[0] <= 'Z':
        return "v"
    return "i"

@borrows
fn TypedExprColdCsgObjectFieldSpec(typeName: str): str =
    let t = TypedExprNormalizeTypeText(typeName)
    if t == "int32[]" || t == "int[]":
        return ""
    if parser.ParserStartsWith(t, "int32[") && t.len > 7 && t[t.len - 1] == ']':
        return Fmt"a{chengpath.TextSlice(t, 6, t.len - 7)}"
    return TypedExprColdCsgFieldKindCodeFromTypeName(t)

@borrows
fn TypedExprColdCsgFieldDeclSpec(declRaw: str): str =
    let decl = chengpath.PathTrim(declRaw)
    let colon = parser.ParserFindText(decl, ":")
    if colon <= 0:
        return ""
    let name = parser.ParserIdentPrefix(chengpath.TextSlice(decl, 0, colon))
    var typeText = chengpath.PathTrim(chengpath.TextSlice(decl,
                                                          colon + 1,
                                                          decl.len - colon - 1))
    let eq = parser.ParserFindText(typeText, "=")
    if eq >= 0:
        typeText = chengpath.PathTrim(chengpath.TextSlice(typeText, 0, eq))
    if name == "" || typeText == "":
        return ""
    let spec = TypedExprColdCsgObjectFieldSpec(typeText)
    if spec == "":
        return ""
    return Fmt"{name}:{spec}"

@borrows
fn TypedExprColdCsgObjectSpecsFromLines(ctx: var TypedExprSourceContext,
                                         startIndex: int32,
                                         endIndex: int32): str =
    var out = ""
    for i in startIndex..<endIndex:
        let trimmed = chengpath.PathTrim(ctx.lines[i])
        if trimmed == "":
            continue
        let spec = TypedExprColdCsgFieldDeclSpec(ctx.lines[i])
        if spec == "":
            return ""
        if out != "":
            out = Fmt"{out},"
        out = Fmt"{out}{spec}"
    return out

@borrows
fn TypedExprColdCsgTupleSpecsFromText(fieldsRaw: str): str =
    let parts = strutil.Split(fieldsRaw, ',')
    var out = ""
    for i in 0..<parts.len:
        let trimmed = chengpath.PathTrim(parts[i])
        if trimmed == "":
            continue
        let spec = TypedExprColdCsgFieldDeclSpec(parts[i])
        if spec == "":
            return ""
        if out != "":
            out = Fmt"{out},"
        out = Fmt"{out}{spec}"
    return out

fn TypedExprColdCsgTypeParamsFromHead(headRaw: str): str =
    let head = chengpath.PathTrim(headRaw)
    let open = parser.ParserFindText(head, "[")
    if open <= 0 || head.len <= open + 1 || head[head.len - 1] != ']':
        return ""
    let inner = chengpath.TextSlice(head, open + 1, head.len - open - 2)
    let parts = strutil.Split(inner, ',')
    var out: str
    for i in 0..<parts.len:
        let part = chengpath.PathTrim(parts[i])
        if part == "":
            continue
        if out != "":
            out = Fmt"{out},"
        out = Fmt"{out}{part}"
    return out

fn TypedExprColdCsgTypeEntryParts(lineRaw: str,
                                   name: var str,
                                   rhs: var str): bool =
    name = ""
    rhs = ""
    let line = chengpath.PathTrim(lineRaw)
    let eq = TypedExprFindTopLevelToken(line, "=")
    if eq <= 0:
        return false
    let left = chengpath.PathTrim(chengpath.TextSlice(line, 0, eq))
    name = parser.ParserFirstToken(left)
    rhs = chengpath.PathTrim(chengpath.TextSlice(line, eq + 1, line.len - eq - 1))
    return name != ""

@borrows
fn TypedExprColdCsgTupleObjectSpecs(rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    let open = parser.ParserFindText(rhs, "[")
    if open <= 0 || rhs.len <= open + 1 || rhs[rhs.len - 1] != ']':
        return ""
    let fields = chengpath.TextSlice(rhs, open + 1, rhs.len - open - 2)
    return TypedExprColdCsgTupleSpecsFromText(fields)

@borrows
fn TypedExprColdCsgJoinIndentedLines(ctx: var TypedExprSourceContext,
                                      startIndex: int32,
                                      endIndex: int32): str =
    var out = ""
    for i in startIndex..<endIndex:
        let part = chengpath.PathTrim(ctx.lines[i])
        if part == "":
            continue
        if out != "":
            out = Fmt"{out} "
        out = Fmt"{out}{part}"
    return out

fn TypedExprColdCsgVariantSpecsFromText(text: str): str =
    var out: str
    var pos = 0
    var emitted = 0
    while pos < Len(text):
        while pos < Len(text) && (text[pos] == ' ' || text[pos] == '|'):
            pos = pos + 1
        if pos >= Len(text):
            break
        var nameEnd = pos
        while nameEnd < Len(text) && text[nameEnd] != ' ' && text[nameEnd] != '(' && text[nameEnd] != '|':
            nameEnd = nameEnd + 1
        if nameEnd <= pos:
            break
        let variantName = chengpath.TextSlice(text, pos, nameEnd - pos)
        pos = nameEnd
        var fieldCount = 0
        var fieldKinds: str
        while pos < Len(text) && text[pos] == ' ':
            pos = pos + 1
        if pos < Len(text) && text[pos] == '(':
            pos = pos + 1
            var depth = 1
            let fieldStart = pos
            while pos < Len(text) && depth > 0:
                if text[pos] == '(':
                    depth = depth + 1
                elif text[pos] == ')':
                    depth = depth - 1
                if depth > 0:
                    pos = pos + 1
            if depth == 0:
                let fields = chengpath.TextSlice(text, fieldStart, pos - fieldStart)
                pos = pos + 1
                var fp = 0
                while fp < Len(fields):
                    while fp < Len(fields) && fields[fp] == ' ':
                        fp = fp + 1
                    if fp >= Len(fields):
                        break
                    var nameStop = fp
                    while nameStop < Len(fields) && fields[nameStop] != ' ' && fields[nameStop] != ':':
                        nameStop = nameStop + 1
                    if nameStop <= fp:
                        break
                    fp = nameStop
                    while fp < Len(fields) && (fields[fp] == ' ' || fields[fp] == ':'):
                        fp = fp + 1
                    var typeStop = fp
                    var bracketDepth = 0
                    while typeStop < Len(fields):
                        if fields[typeStop] == '[':
                            bracketDepth = bracketDepth + 1
                        elif fields[typeStop] == ']':
                            bracketDepth = bracketDepth - 1
                        elif fields[typeStop] == ',' && bracketDepth == 0:
                            break
                        typeStop = typeStop + 1
                    let fieldType = chengpath.PathTrim(chengpath.TextSlice(fields, fp, typeStop - fp))
                    if Len(fieldType) > 0:
                        fieldKinds = Fmt"{fieldKinds}{TypedExprColdCsgFieldKindCodeFromTypeName(fieldType)}"
                        if TypedExprTypeIsGenericPlaceholder(fieldType):
                            fieldKinds = Fmt"{fieldKinds}:{fieldType}"
                    fieldCount = fieldCount + 1
                    fp = typeStop
                    while fp < Len(fields) && fields[fp] == ',':
                        fp = fp + 1
        if emitted > 0:
            out = Fmt"{out},"
        out = Fmt"{out}{variantName}:{IntToStr(fieldCount)}"
        if Len(fieldKinds) > 0:
            out = Fmt"{out}:{fieldKinds}"
        emitted = emitted + 1
        while pos < Len(text) && text[pos] == ' ':
            pos = pos + 1
        if pos < Len(text) && text[pos] == '|':
            pos = pos + 1
    return out

@borrows
fn TypedExprFindTypeFieldDecl(ctx: TypedExprSourceContext,
                               ownerTypeRaw: str,
                               fieldNameRaw: str,
                               out: var TypedExprTypeFieldDecl): bool =
    let ownerType = TypedExprTypeLeafName(ownerTypeRaw)
    let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw))
    var nodeIndex: int32
    let state = TypedExprBuildIndexLookup(ctx.buildIndex,
                                          "ctx_field_source",
                                          parser.ParserNormalizePath(ctx.sourcePath),
                                          ownerType,
                                          fieldName,
                                          nodeIndex)
    var contextIndex: int32
    var itemIndex: int32
    if state != TypedExprBuildIndexUnique ||
       !TypedExprBuildIndexContextFieldNode(ctx.buildIndex,
                                           nodeIndex,
                                           contextIndex,
                                           itemIndex) ||
       !typedExprContextFieldAt(ctx, itemIndex, out):
        return false
    return true

@borrows
fn TypedExprMaybeAddBindingOwned(bindings: TypedExprBinding[],
                                  sourcePath: str,
                                  functionName: str,
                                  globalFlag: bool,
                                  mutableFlag: bool,
                                  lineNumber: int32,
                                  nameRaw: str,
                                  typeRaw: str): TypedExprBinding[] =
    var out: TypedExprBinding[]
    for i in 0..<bindings.len:
        add(out, share(bindings[i]))
    TypedExprMaybeAddBinding(out,
                             sourcePath,
                             functionName,
                             globalFlag,
                             mutableFlag,
                             lineNumber,
                             nameRaw,
                             typeRaw)
    return out

@borrows
fn TypedExprMaybeAddBindingInitOwned(bindings: TypedExprBinding[],
                                      sourcePath: str,
                                      functionName: str,
                                      globalFlag: bool,
                                      mutableFlag: bool,
                                      lineNumber: int32,
                                      nameRaw: str,
                                      typeRaw: str,
                                      initValueText: str): TypedExprBinding[] =
    var out: TypedExprBinding[]
    for i in 0..<bindings.len:
        add(out, share(bindings[i]))
    TypedExprMaybeAddBindingInit(out,
                                 sourcePath,
                                 functionName,
                                 globalFlag,
                                 mutableFlag,
                                 lineNumber,
                                 nameRaw,
                                 typeRaw,
                                 initValueText)
    return out

@borrows
fn TypedExprMaybeAddBinding(bindings: var TypedExprBinding[],
                              sourcePath: str,
                              functionName: str,
                              globalFlag: bool,
                              mutableFlag: bool,
                              lineNumber: int32,
                              nameRaw: str,
                              typeRaw: str) =
    TypedExprMaybeAddBindingInit(bindings,
                                 sourcePath,
                                 functionName,
                                 globalFlag,
                                 mutableFlag,
                                 lineNumber,
                                 nameRaw,
                                 typeRaw,
                                 "")

@borrows
fn TypedExprMaybeAddBindingInit(bindings: var TypedExprBinding[],
                                  sourcePath: str,
                                  functionName: str,
                                  globalFlag: bool,
                                  mutableFlag: bool,
                                  lineNumber: int32,
                                  nameRaw: str,
                                  typeRaw: str,
                                  initValueText: str) =
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if name == "" || typeText == "":
        return
    var binding: TypedExprBinding
    binding.sourcePath = share(sourcePath)
    binding.functionName = share(functionName)
    binding.globalFlag = globalFlag
    binding.mutableFlag = mutableFlag
    binding.lineNumber = lineNumber
    binding.name = name
    binding.typeText = typeText
    binding.initValueText = share(initValueText)
    add(bindings, binding)

@borrows
fn TypedExprParserOwnedGlobalBindingFromSpans(
        sourcePath: str,
        sourceText: str,
        producerSourceIndex: int32,
        declarationSourceLocalRow: int32,
        mutableFlag: bool,
        lineNumber: int32,
        name: str,
        typeSpanStart: int32,
        typeSpanEnd: int32,
        initSpanStart: int32,
        initSpanEnd: int32,
        bindingOut: var TypedExprBinding,
        emittedOut: var bool,
        err: var str): bool =
    bindingOut = TypedExprBinding()
    emittedOut = false
    if sourcePath == "" || producerSourceIndex < 0 ||
       declarationSourceLocalRow < 0 || lineNumber <= 0 || name == "":
        err = " typed expr: parser-owned global identity is invalid"
        return false
    let typeSpanAbsent = typeSpanStart == -1 && typeSpanEnd == -1
    if (!typeSpanAbsent &&
        (typeSpanStart < 0 || typeSpanEnd <= typeSpanStart ||
         typeSpanEnd > sourceText.len)):
        err = " typed expr: parser-owned global type span is invalid"
        return false
    let initSpanAbsent = initSpanStart == -1 && initSpanEnd == -1
    if (!initSpanAbsent &&
        (initSpanStart < 0 || initSpanEnd <= initSpanStart ||
         initSpanEnd > sourceText.len)):
        err = " typed expr: parser-owned global initializer span is invalid"
        return false
    var typeText = ""
    if !typeSpanAbsent:
        typeText = TypedExprNormalizeTypeText(
            chengpath.TextSlice(sourceText,
                                typeSpanStart,
                                typeSpanEnd - typeSpanStart))
    var initValueText = ""
    if !initSpanAbsent:
        initValueText = chengpath.PathTrim(
            chengpath.TextSlice(sourceText,
                                initSpanStart,
                                initSpanEnd - initSpanStart))
    # Keep the existing global metadata coverage for declarations whose type is
    # inferred from an exact parser-owned initializer root. This decides only
    # the legacy type-text payload; semantic identity remains the declaration
    # coordinate above and TypeArena admission still requires a TypeSyntax root.
    if typeText == "" && initValueText != "":
        typeText = TypedExprBindingRhsBoolExprType(initValueText)
    if typeText == "" && initValueText != "":
        typeText = TypedExprLiteralBindingType(initValueText)
    if typeText == "" && initValueText != "":
        let callHead = TypedExprBindingRhsCallHead(initValueText)
        if TypedExprQualifiedCallLeaf(callHead) == "new":
            let openPos = TypedExprFindWholeCallOpenParen(initValueText)
            let closePos = TypedExprFindMatchingParen(initValueText, openPos)
            if openPos > 0 && closePos > openPos:
                let arg = chengpath.PathTrim(chengpath.TextSlice(
                    initValueText,
                    openPos + 1,
                    closePos - openPos - 1))
                if arg != "" &&
                   TypedExprFindTopLevelToken(arg, ",") < 0:
                    let refType =
                        TypedExprNormalizeTypeText(Fmt"ref{arg}")
                    if TypedExprTypeTextIsConcrete(refType):
                        typeText = refType
    if typeText == "":
        err = ""
        return true
    bindingOut.sourcePath = share(sourcePath)
    bindingOut.functionName = ""
    bindingOut.globalFlag = true
    bindingOut.mutableFlag = mutableFlag
    bindingOut.producerSourceIndex = producerSourceIndex
    bindingOut.declarationSourceLocalRow =
        declarationSourceLocalRow
    bindingOut.lineNumber = lineNumber
    bindingOut.name = share(name)
    bindingOut.typeText = typeText
    bindingOut.initValueText = initValueText
    emittedOut = true
    err = ""
    return true

@borrows
fn TypedExprAppendParamBindings(bindings: var TypedExprBinding[],
                                  scope: TypedExprFunctionScope,
                                  lineRaw: str) =
    var params: TypedExprParam[]
    TypedExprFunctionParamsInto(lineRaw, params)
    for i in 0..<params.len:
        TypedExprMaybeAddBinding(bindings,
                                   share(scope.sourcePath),
                                   share(scope.name),
                                   false,
                                   params[i].mutableFlag,
                                   scope.startLine,
                                   share(params[i].name),
                                   share(params[i].typeText))

@borrows
fn TypedExprMaybeAddInferredCallBinding(ctx: var TypedExprSourceContext,
                                         sourceContexts: TypedExprSourceContext[],
                                         fact: TypedExprFact) =
    if parser.ParserNormalizePath(fact.sourcePath) != parser.ParserNormalizePath(ctx.sourcePath):
        return
    if fact.kind != parser.NormalizedExprCall &&
       fact.kind != parser.NormalizedExprResultIntrinsic:
        return
    if !fact.hasSink:
        return
    if fact.sinkPlaceKind != TypedExprPlaceLocal &&
       fact.sinkPlaceKind != TypedExprPlaceGlobal:
        return
    let lineRaw = TypedExprSourceLine(ctx, fact.lineNumber)
    var bindingName = ""
    var explicitType = ""
    var rhsStartColumn: int32 = -1
    if !TypedExprParseBindingLine(lineRaw, bindingName, explicitType, rhsStartColumn):
        return
    if bindingName == "" || explicitType != "":
        return
    let inferredCallBindingRhsText = TypedExprBindingRhsTextWithContinuation(ctx,
                                                                            fact.lineNumber - 1,
                                                                            rhsStartColumn)
    if TypedExprBindingRhsIsSeqLiteral(inferredCallBindingRhsText):
        return
    # `let b = os.GetEnv("X") != ""` (or any `<call> <cmp> <expr>`): the call is a
    # sub-expression feeding a top-level comparison, so the binding's value type is
    # bool, not the call's return type. Recording the call return type here locks
    # the IR local-binding store to the wrong type (the bool collection cannot
    # overwrite a concrete entry), leaving `if b:` with an unresolved condition
    # node (cond_shape gap). Defer to the dedicated bool-expr inference.
    if rhsStartColumn > 0 &&
       TypedExprBindingRhsBoolExprType(TypedExprBindingRhsText(lineRaw, rhsStartColumn)) != "":
        return
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, fact.lineNumber)
    var typeText = ""
    if fact.kind == parser.NormalizedExprCall:
        # r98 hot-path: the fact row already carries the first-pass resolved
        # return type (ApplyResolvedType stored its normalized form). The
        # second whole-resolution here re-derived the identical answer for
        # every call site at ~9ms per function on chain fixtures; trust the
        # row and keep the T69 cast-head override below as the authority for
        # scalar-cast heads. Byte-invariance is arbitrated by the fixture
        # matrix; any divergence must land here, not in the overrides.
        typeText = fact.typeText
    # T69: fact.callCallee 是整句 RHS 里被包调用(如 `int32(probeU32(...))` 的
    # probeU32),上面按它解出的 typeText 是被包调用的返回类型，与 RHS 顶层若
    # 确有具体标量转换头(此处 int32)不符时会记错绑定类型——下游 level==2 比较
    # 门按 intMix 白名单拒绝该非法混型，整条件 poison 落 text-fallback(T69)。
    # 仅当整句 RHS 确系「顶层标量转换头(...)」形态才覆盖，非转换头调用(用户
    # 函数/len/BytesAlloc/new 等)不受影响。
    let castHeadName = TypedExprBindingRhsCallHead(inferredCallBindingRhsText)
    if castHeadName != "":
        let castTargetType = TypedExprScalarCastHeadTargetType(castHeadName)
        if castTargetType != "":
            typeText = castTargetType
    if !TypedExprTypeTextIsConcrete(typeText) || TypedExprTypeIsGenericPlaceholder(typeText):
        typeText = fact.typeText
    # 裸泛型占位符(T/refT/varT)不是具体类型:`new(X)` 经调用目标返回类型解析到
    # system.cheng `fn new(): ref T` 的未替换 `ref T`→refT,TypeTextIsConcrete 对它
    # 误判 concrete,会把 out 以 refT 追加进 ctx.bindings 覆盖更早正确推断的
    # refMachoProviderObject(LookupBindingType 取最后同行项),致 out.data 字段
    # 解析失败 no_node。占位符不入绑定表,让 local-decl new(T) 单态化结果胜出。
    if !TypedExprTypeTextIsConcrete(typeText) || TypedExprTypeIsGenericPlaceholder(typeText):
        return
    # 限定符调用 `mod.Fn()` 返回 mod 模块内定义的无限定 struct T:存裸 "T" 会在
    # 读取侧(他模块)撞同名 type(历史实例:bytes.ByteBuffer={len,data:ptr} vs
    # buffer.ByteBuffer={data:Bytes}, 后者 2026-07-08 已改名 GrowByteBuffer 消撞;
    # 机制仍在,任何新撞名同样触发)→ 跨模块 type-field 索引 TypeFieldContextIndexLookup
    # 因歧义返 -1 → `x.field` 字段 leaf 解析失败 → 条件 no_node。按调用限定符把类型
    # 限定成 mod.T(镜像 coreir.BodyIR 限定型本就能正常解析);仅当裸名、且 mod 模块
    # 确有该 type-field 时限定,builtin/标量(str/int/..)因 HasTypeField 假天然跳过。
    if fact.callQualifier != "" &&
       TypedExprQualifiedTypeDot(typeText) <= 0:
        let qmodPath = TypedExprLookupQualifiedModuleSourcePath(ctx, sourceContexts, fact.callQualifier)
        let qmodIndex = TypedExprSourceContextLookup(sourceContexts, qmodPath)
        if qmodIndex >= 0 && TypedExprContextHasTypeField(sourceContexts[qmodIndex], typeText):
            typeText = TypedExprNormalizeTypeText(strutil.Join(
                [share(fact.callQualifier), ".", share(typeText)], ""))
    # `let x = mod.Fn(...).field[.field...]`:上面只取到 Fn 的返回 struct 型,RHS 在
    # 调用闭括号后的尾部纯字段链未被投影,致 x 记成整 struct 型(如 osym.ObjectSymbol)
    # 而非字段型(.name→str)。下游 `len(x)<=8` 等按字段标量用时 backend len 探针因
    # 类型非 str/Bytes 拒(call_special_head no_node)。此处对尾部纯字段链(仅 ident+'.',
    # 无 '['/'(' 即非 index/再调用)用 ResolveFieldPathMeta 投影出真字段型。
    let projRhsText = TypedExprBindingRhsText(lineRaw, rhsStartColumn)
    let projCallOpen = TypedExprFindWholeCallOpenParen(projRhsText)
    if projCallOpen > 0:
        let projCallClose = TypedExprFindMatchingParen(projRhsText, projCallOpen)
        if projCallClose > projCallOpen &&
           projCallClose + 1 < projRhsText.len &&
           projRhsText[projCallClose + 1] == '.':
            let projTail = chengpath.PathTrim(chengpath.TextSlice(projRhsText,
                                                                  projCallClose + 2,
                                                                  projRhsText.len - projCallClose - 2))
            var projTailPureField = projTail != ""
            for projCh in 0..<projTail.len:
                let projC = projTail[projCh]
                if projC == '[' || projC == '(' || projC == ' ':
                    projTailPureField = false
            if projTailPureField:
                var projFieldType = ""
                var projFieldOff: int32
                var projFieldSize: int32
                var projFieldAlign: int32
                if TypedExprResolveFieldPathMeta(ctx,
                                                 sourceContexts,
                                                 typeText,
                                                 projTail,
                                                 projFieldType,
                                                 projFieldOff,
                                                 projFieldSize,
                                                 projFieldAlign) &&
                   TypedExprTypeTextIsConcrete(projFieldType):
                    typeText = TypedExprNormalizeTypeText(projFieldType)
    var functionName = ""
    var globalFlag = true
    if scopeIndex >= 0:
        functionName = ctx.scopes[scopeIndex].name
        globalFlag = false
    TypedExprMaybeAddBinding(ctx.bindings,
                             share(ctx.sourcePath),
                             functionName,
                             globalFlag,
                             parser.ParserBindingDeclarationIsMutable(
                                 lineRaw),
                             fact.lineNumber,
                             bindingName,
                             typeText)

@borrows
fn TypedExprLocalBindingNameFnIndexHash(name: str,
                                         functionName: str,
                                         bucketCount: int32): int32 =
    # (name,functionName) 组合键: 只按 name 建链时跨函数同名绑定 (i/out/err...)
    # 把链拉成 O(函数数), 加 function 键后链长回落到同函数 shadow 数。
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(name):
        h = h * 31 + int32(name[i])
    h = h * 31 + 10
    for i in 0..<len(functionName):
        h = h * 31 + int32(functionName[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

@borrows
fn TypedExprIrLocalBindingIndexShapeComplete(ir: TypedExprIr): bool =
    let rowCount = ir.localBindingNames.len
    if ir.localBindingSourcePaths.len != rowCount ||
       ir.localBindingFunctionNames.len != rowCount ||
       ir.localBindingLineNumbers.len != rowCount ||
       ir.localBindingTypes.len != rowCount ||
       ir.localBindingNameIndexEntryNext.len != rowCount ||
       ir.localBindingNameIndexEntryBindingIndexes.len != rowCount ||
       ir.localBindingNameIndexEntryNames.len != rowCount:
        return false
    if rowCount == 0:
        return ir.localBindingNameIndexBucketHeads.len == 0
    let bucketCount = ir.localBindingNameIndexBucketHeads.len
    return bucketCount > 0 && (bucketCount & (bucketCount - 1)) == 0

fn typedExprIrZeroFunctionDomainStrictValidateWithLocalBindingSeal(
        ir: var TypedExprIr,
        localBindingNameIndexSealed: bool): bool =
    # A zero-function IR may still carry module/type/global metadata and its
    # sealed source-context index.  Every function-owned or transaction-owned
    # side domain must nevertheless be exactly empty; shape-only validation is
    # insufficient because a complete non-empty column set is still residue.
    if !TypedExprIrFunctions2ShapeComplete(ir) ||
       !TypedExprIrScopes2ShapeComplete(ir) ||
       !TypedExprIrStatements2ShapeComplete(ir) ||
       !TypedExprIrNodes2ShapeComplete(ir) ||
       !TypedExprValueDefinitionAuthorityShapeComplete(ir) ||
       !TypedExprValueDefinitionGroupAuthorityShapeComplete(ir) ||
       !TypedExprIrLocalBindingIndexShapeComplete(ir):
        return false
    if ir.functions2_functionNameIds.len != 0 ||
       ir.scopes2_scopeIds.len != 0 ||
       ir.statements2_statementIndexs.len != 0 ||
       ir.nodes2_nodeIndexs.len != 0 ||
       TypedExprValueDefinitionAuthorityCount(ir) != 0 ||
       TypedExprValueDefinitionGroupAuthorityCount(ir) != 0:
        return false
    if ir.valueExprTree != nil ||
       ir.valueExprTreeBorrowLease ||
       ir.valueExprTransactionNodeStart != 0 ||
       ir.valueExprTransactionDeclarationLocalGroupRows.len != 0 ||
       ir.valueExprTransactionParserProducerSourceIndex != -1 ||
       ir.valueExprTransactionProducerSourceIndex != -1 ||
       ir.valueExprTransactionDefinitionGroupStart != 0 ||
       ir.valueExprTransactionDefinitionGroupRootNodeIndexes.len != 0 ||
       ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len != 0 ||
       ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex.len != 0 ||
       arenamod.ArenaArrayInt32Len(
           ir.arena,
           ir.valueExprTransactionDefinitionGroupRowsByPatternRow) != 0 ||
       arenamod.ArenaArrayInt32Len(
           ir.arena,
           ir.valueExprTransactionParameterOrdinalsByDeclarationRow) != 0 ||
       arenamod.ArenaArrayInt32Len(
           ir.arena,
           ir.valueExprTransactionParameterCountsByFunctionRow) != 0 ||
       ir.valueExprTransactionParameterOrdinalLookupCount != 0 ||
       ir.valueExprCurrentParamDefinitionNodeIndexes.len != 0 ||
       ir.valueExprCurrentParamValueDefinitionRows.len != 0 ||
       ir.valueExprCurrentParserFunctionRow != -1 ||
       ir.valueExprCallMetaResultTypeIds.len != 0 ||
       ir.valueExprCallMetaOriginParserNodeIds.len != 0 ||
       ir.originParserNodeStack.len != 0:
        return false
    if ir.coldCsgStatementRows.len != 0 ||
       ir.localBindingSourcePaths.len != 0 ||
       ir.localBindingNameIndexSealed != localBindingNameIndexSealed ||
       ir.statementFunctionIndexBucketHeads.len != 0 ||
       ir.statementFunctionIndexEntryNext.len != 0 ||
       ir.statementFunctionIndexEntryStatementIndexes.len != 0 ||
       ir.statementFunctionIndexEntryNames.len != 0 ||
       ir.statementFnBindingIndexBucketHeads.len != 0 ||
       ir.statementFnBindingIndexEntryNext.len != 0 ||
       ir.statementFnBindingIndexEntryStatementIndexes.len != 0 ||
       ir.statementFnBindingIndexEntryFunctionNames.len != 0 ||
       ir.statementFnBindingIndexEntryBindingNames.len != 0 ||
       ir.paramRefIndexBucketHeads.len != 0 ||
       ir.paramRefIndexEntryNext.len != 0 ||
       ir.paramRefIndexEntryNodeIndexes.len != 0 ||
       ir.paramRefIndexEntrySourcePaths.len != 0 ||
       ir.paramRefIndexEntryFunctionNames.len != 0 ||
       ir.paramRefIndexEntryParamNames.len != 0:
        return false
    return ir.nodesTailOwnerSourcePathId == 0 &&
           ir.nodesTailOwnerFunctionNameId == 0 &&
           ir.nodesTailBlockStartNodeIndex == 0

fn TypedExprIrZeroFunctionDomainStrictValidate(
        ir: var TypedExprIr): bool =
    return typedExprIrZeroFunctionDomainStrictValidateWithLocalBindingSeal(
        ir, false)

fn TypedExprIrZeroFunctionSealedDomainStrictValidate(
        ir: var TypedExprIr): bool =
    return typedExprIrZeroFunctionDomainStrictValidateWithLocalBindingSeal(
        ir, true)

fn TypedExprIrLocalBindingIndexComplete(ir: var TypedExprIr): bool =
    if !TypedExprIrLocalBindingIndexShapeComplete(ir):
        return false
    let rowCount = ir.localBindingNames.len
    if rowCount == 0:
        return true
    var seenEntries: bool[]
    var seenBindings: bool[]
    for i in 0..<rowCount:
        add(seenEntries, false)
        add(seenBindings, false)
    var visited: int32
    for bucket in 0..<ir.localBindingNameIndexBucketHeads.len:
        var entryIndex = ir.localBindingNameIndexBucketHeads[bucket]
        while entryIndex >= 0:
            if entryIndex >= rowCount || seenEntries[entryIndex]:
                return false
            seenEntries[entryIndex] = true
            visited = visited + 1
            let bindingIndex = ir.localBindingNameIndexEntryBindingIndexes[entryIndex]
            if bindingIndex < 0 || bindingIndex >= rowCount ||
               seenBindings[bindingIndex] ||
               ir.localBindingNameIndexEntryNames[entryIndex] !=
                   ir.localBindingNames[bindingIndex] ||
               TypedExprLocalBindingNameFnIndexHash(
                   ir.localBindingNames[bindingIndex],
                   ir.localBindingFunctionNames[bindingIndex],
                   ir.localBindingNameIndexBucketHeads.len) != bucket:
                return false
            seenBindings[bindingIndex] = true
            let nextEntry = ir.localBindingNameIndexEntryNext[entryIndex]
            if nextEntry < -1 || nextEntry >= rowCount:
                return false
            entryIndex = nextEntry
    if visited != rowCount:
        return false
    for i in 0..<rowCount:
        if !seenEntries[i] || !seenBindings[i]:
            return false
    return true

fn TypedExprLocalBindingNameIndexRegister(ir: var TypedExprIr, bindingIndex: int32) =
    if ir.localBindingNameIndexSealed:
        panic("typed expr: append to sealed local-binding index")
    if bindingIndex < 0 || bindingIndex >= ir.localBindingNames.len:
        panic("typed expr: local-binding register index out of range")
    if bindingIndex >= ir.localBindingFunctionNames.len:
        panic("typed expr: local-binding register function column mismatch")
    if ir.localBindingNameIndexBucketHeads.len <= 0:
        for bucketIndex in 0..<16384:
            add(ir.localBindingNameIndexBucketHeads, -1)
    let name = ir.localBindingNames[bindingIndex]
    let bucket = TypedExprLocalBindingNameFnIndexHash(name,
                                                      ir.localBindingFunctionNames[bindingIndex],
                                                      ir.localBindingNameIndexBucketHeads.len)
    if bucket < 0:
        panic("typed expr: local-binding register bucket invalid")
    let entryIndex = ir.localBindingNameIndexEntryBindingIndexes.len
    add(ir.localBindingNameIndexEntryBindingIndexes, bindingIndex)
    add(ir.localBindingNameIndexEntryNames, share(name))
    add(ir.localBindingNameIndexEntryNext, ir.localBindingNameIndexBucketHeads[bucket])
    ir.localBindingNameIndexBucketHeads[bucket] = entryIndex

@borrows
fn TypedExprIrAppendLocalBinding(ir: var TypedExprIr,
                                  sourcePathRaw: str,
                                  functionNameRaw: str,
                                  lineNumber: int32,
                                  nameRaw: str,
                                  typeRaw: str) =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if sourcePath == "" || functionName == "" || lineNumber <= 0 || name == "" || typeText == "":
        return
    if !TypedExprBootstrapContractTextStable(typeText):
        panic(Fmt"typed expr: local-binding type text is not stable source={sourcePath} function={functionName} line={lineNumber} binding={name}")
    typedExprCheckedInt32Capacity(Int64(typeText.len),
                                  "local_binding_type_text")
    if ir.localBindingNameIndexSealed:
        panic("typed expr: local-binding append after backend handoff")
    if ir.localBindingNames.len > 0 &&
       !TypedExprIrLocalBindingIndexShapeComplete(ir):
        panic("typed expr: local-binding index incomplete during append")
    if ir.localBindingNameIndexBucketHeads.len > 0:
        let bucket = TypedExprLocalBindingNameFnIndexHash(name,
                                                          functionName,
                                                          ir.localBindingNameIndexBucketHeads.len)
        if bucket >= 0:
            var entryIndex = ir.localBindingNameIndexBucketHeads[bucket]
            while entryIndex >= 0:
                if entryIndex >= ir.localBindingNameIndexEntryBindingIndexes.len:
                    panic("typed expr: local-binding index entry out of range")
                if ir.localBindingNameIndexEntryNames[entryIndex] == name:
                    let i = ir.localBindingNameIndexEntryBindingIndexes[entryIndex]
                    if i < 0 || i >= ir.localBindingNames.len:
                        panic("typed expr: local-binding index binding out of range")
                    if i < ir.localBindingSourcePaths.len &&
                       i < ir.localBindingFunctionNames.len &&
                       i < ir.localBindingLineNumbers.len &&
                       ir.localBindingSourcePaths[i] == sourcePath &&
                       ir.localBindingFunctionNames[i] == functionName &&
                       ir.localBindingLineNumbers[i] == lineNumber &&
                       ir.localBindingNames[i] == name:
                        if i < ir.localBindingTypes.len:
                            let existingType = ir.localBindingTypes[i]
                            if !TypedExprBootstrapContractTextStable(existingType):
                                panic("typed expr: stored local-binding type text is not stable")
                            if existingType == "" ||
                               existingType == "unknown" ||
                                existingType == "call_expr" ||
                                existingType == "constructor_expr" ||
                                existingType == "default_init_expr":
                                ir.localBindingTypes[i] = typeText
                        return
                let nextEntry = ir.localBindingNameIndexEntryNext[entryIndex]
                if nextEntry < -1:
                    panic("typed expr: local-binding append next out of range")
                entryIndex = nextEntry
    let newBindingIndex = ir.localBindingNames.len
    let nextBindingCount = typedExprCheckedAddInt32(newBindingIndex,
                                                     1,
                                                     "local_binding_rows")
    # The IR outlives the frozen metadata session (and its intern pool):
    # these rows are appended once per binding for the whole run, so a
    # bounded clone here is the ownership boundary that keeps pool-backed
    # shares inside round-scoped contexts.
    add(ir.localBindingSourcePaths, strings.CloneStr(sourcePath))
    add(ir.localBindingFunctionNames, strings.CloneStr(functionName))
    add(ir.localBindingLineNumbers, lineNumber)
    add(ir.localBindingNames, strings.CloneStr(name))
    add(ir.localBindingTypes, strings.CloneStr(typeText))
    TypedExprLocalBindingNameIndexRegister(ir, newBindingIndex)
    if ir.localBindingNames.len != nextBindingCount ||
       !TypedExprIrLocalBindingIndexShapeComplete(ir):
        panic("typed expr: local-binding exact storage cardinality drift")

@borrows
fn TypedExprIrLookupLocalBindingType(ir: TypedExprIr,
                                      sourcePathRaw: str,
                                      functionNameRaw: str,
                                      lineNumber: int32,
                                      nameRaw: str): str =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if sourcePath == "" || functionName == "" || lineNumber <= 0 || name == "":
        return ""
    if ir.localBindingNames.len <= 0:
        return ""
    if !TypedExprIrLocalBindingIndexShapeComplete(ir):
        panic("typed expr: local-binding lookup requires complete index")
    if ir.localBindingNameIndexBucketHeads.len > 0:
        let bucket = TypedExprLocalBindingNameFnIndexHash(name,
                                                          functionName,
                                                          ir.localBindingNameIndexBucketHeads.len)
        if bucket >= 0:
            var entryIndex = ir.localBindingNameIndexBucketHeads[bucket]
            while entryIndex >= 0:
                if entryIndex >= ir.localBindingNameIndexEntryBindingIndexes.len:
                    panic("typed expr: local-binding lookup entry out of range")
                if ir.localBindingNameIndexEntryNames[entryIndex] == name:
                    let i = ir.localBindingNameIndexEntryBindingIndexes[entryIndex]
                    if i < 0 || i >= ir.localBindingNames.len:
                        panic("typed expr: local-binding lookup binding out of range")
                    if i < ir.localBindingSourcePaths.len &&
                       i < ir.localBindingFunctionNames.len &&
                       i < ir.localBindingLineNumbers.len &&
                       i < ir.localBindingTypes.len &&
                       ir.localBindingLineNumbers[i] < lineNumber &&
                       ir.localBindingFunctionNames[i] == functionName &&
                       (ir.localBindingSourcePaths[i] == sourcePath ||
                        TypedExprPathNormalizedEquals(ir.localBindingSourcePaths[i], sourcePathRaw)):
                        let candidateType = TypedExprNormalizeTypeText(ir.localBindingTypes[i])
                        if !TypedExprBootstrapContractTextStable(candidateType):
                            panic("typed expr: local-binding lookup found unstable type text")
                        typedExprCheckedInt32Capacity(
                            Int64(candidateType.len),
                            "local_binding_lookup_type_text")
                        if TypedExprTypeTextIsConcrete(candidateType):
                            return candidateType
                let nextEntry = ir.localBindingNameIndexEntryNext[entryIndex]
                if nextEntry < -1:
                    panic("typed expr: local-binding lookup next out of range")
                entryIndex = nextEntry
    return ""

# Line-independent local-binding type lookup: returns the concrete declared type
# of `name` within the given function/source ignoring statement order, but ONLY
# when every concrete declaration of that name in the function agrees on the
# type (unambiguous). When two shadowing decls disagree it returns "" so callers
# do not silently pick the wrong shape. Used by backend paths that resolve an
# operand without a reliable line number (condition probes pass line 0).
@borrows
fn TypedExprIrLookupLocalBindingTypeAnyLine(ir: TypedExprIr,
                                            sourcePathRaw: str,
                                            functionNameRaw: str,
                                            nameRaw: str): str =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if sourcePath == "" || functionName == "" || name == "":
        return ""
    if ir.localBindingNames.len <= 0:
        return ""
    if !TypedExprIrLocalBindingIndexShapeComplete(ir):
        panic("typed expr: any-line local-binding lookup requires complete index")
    var foundType = ""
    var ambiguous = false
    let bucket = TypedExprLocalBindingNameFnIndexHash(
        name,
        functionName,
        ir.localBindingNameIndexBucketHeads.len)
    var entryIndex = ir.localBindingNameIndexBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= ir.localBindingNameIndexEntryBindingIndexes.len:
            panic("typed expr: any-line local-binding entry out of range")
        if ir.localBindingNameIndexEntryNames[entryIndex] == name:
            let i = ir.localBindingNameIndexEntryBindingIndexes[entryIndex]
            if i < 0 || i >= ir.localBindingNames.len:
                panic("typed expr: any-line local-binding binding out of range")
            if ir.localBindingFunctionNames[i] == functionName &&
               (ir.localBindingSourcePaths[i] == sourcePath ||
                TypedExprPathNormalizedEquals(ir.localBindingSourcePaths[i], sourcePathRaw)):
                let candidateType = TypedExprNormalizeTypeText(ir.localBindingTypes[i])
                if !TypedExprBootstrapContractTextStable(candidateType):
                    panic("typed expr: any-line local-binding lookup found unstable type text")
                typedExprCheckedInt32Capacity(
                    Int64(candidateType.len),
                    "local_binding_any_line_type_text")
                if TypedExprTypeTextIsConcrete(candidateType):
                    if foundType == "":
                        foundType = candidateType
                    elif foundType != candidateType:
                        ambiguous = true
        let nextEntry = ir.localBindingNameIndexEntryNext[entryIndex]
        if nextEntry < -1:
            panic("typed expr: any-line local-binding next out of range")
        entryIndex = nextEntry
    if ambiguous:
        return ""
    return foundType

@borrows
fn TypedExprAppendInferredCallBindings(ctx: var TypedExprSourceContext,
                                        sourceContexts: TypedExprSourceContext[],
                                        facts: var TypedExprFactTable,
                                        startIndex: int32,
                                        endIndexRaw: int32) =
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > facts.count:
        endIndex = facts.count
    for i in startIndex..<endIndex:
        TypedExprMaybeAddInferredCallBinding(ctx, sourceContexts, TypedExprFactAt(facts, i))

@borrows
fn TypedExprMaybeAddInferredIndexBinding(ir: var TypedExprIr,
                                          ctx: var TypedExprSourceContext,
                                          sourceContexts: TypedExprSourceContext[],
                                          lineRaw: str,
                                          lineNumber: int32) =
    if lineRaw == "" || !parser.ParserHasLeadingIndent(lineRaw):
        return
    var bindingName = ""
    var explicitType = ""
    var rhsStartColumn: int32 = -1
    if !TypedExprParseBindingLine(lineRaw, bindingName, explicitType, rhsStartColumn):
        return
    if bindingName == "" || explicitType != "":
        return
    let rhsText = TypedExprBindingRhsText(lineRaw, rhsStartColumn)
    if rhsText == "" || rhsText[rhsText.len - 1] != ']':
        return
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
    if scopeIndex < 0:
        return
    let scope = ctx.scopes[scopeIndex]
    let elemType = TypedExprBindingRhsIndexType(ir,
                                                ctx,
                                                sourceContexts,
                                                share(scope),
                                                lineNumber,
                                                rhsText)
    if !TypedExprTypeTextIsConcrete(elemType):
        return
    TypedExprMaybeAddBinding(ctx.bindings,
                             share(ctx.sourcePath),
                             share(scope.name),
                             false,
                             parser.ParserBindingDeclarationIsMutable(
                                 lineRaw),
                             lineNumber,
                             bindingName,
                             elemType)

@borrows
fn TypedExprAppendInferredIndexBindings(ir: var TypedExprIr,
                                         ctx: var TypedExprSourceContext,
                                         sourceContexts: TypedExprSourceContext[]) =
    for i in 0..<ctx.lines.len:
        TypedExprMaybeAddInferredIndexBinding(ir, ctx, sourceContexts, ctx.lines[i], i + 1)

@borrows
fn TypedExprBindingRhsCallHead(rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "":
        return ""
    let openPos = TypedExprFindWholeCallOpenParen(rhs)
    if openPos <= 0:
        return ""
    let closePos = TypedExprFindMatchingParen(rhs, openPos)
    if closePos <= openPos || closePos + 1 != rhs.len:
        return ""
    let callHead = chengpath.PathTrim(chengpath.TextSlice(rhs, 0, openPos))
    if !TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return ""
    return callHead

fn TypedExprCallDeclarationReturnTypeForStaticArg(
        ctx: var TypedExprSourceContext,
        qualifierRaw: str,
        declarationSourcePathRaw: str,
        returnTypeRaw: str): str =
    let returnType = TypedExprNormalizeTypeText(returnTypeRaw)
    let qualifier = chengpath.PathTrim(qualifierRaw)
    let declarationSourcePath = parser.ParserNormalizePath(
        declarationSourcePathRaw)
    if returnType == "" || qualifier == "" || declarationSourcePath == "" ||
       TypedExprQualifiedTypeDot(returnType) > 0:
        return returnType
    let qualifiedTargetSourcePath = parser.ParserNormalizePath(
        TypedExprLookupImportedModuleSourcePath(ctx, qualifier))
    if qualifiedTargetSourcePath == "" ||
       !TypedExprSourcePathsEquivalent(qualifiedTargetSourcePath,
                                       declarationSourcePath):
        panic(Fmt"typed expr: call declaration qualifier owner drift source={ctx.sourcePath} qualifier={qualifier} declaration_source={declarationSourcePath} qualifier_source={qualifiedTargetSourcePath}")
    var typeOwnerSourcePath: str
    var typeLeaf: str
    if !TypedExprCallTypeOwner(ctx.buildIndex,
                               declarationSourcePath,
                               returnType,
                               typeOwnerSourcePath,
                               typeLeaf):
        return returnType
    if !TypedExprSourcePathsEquivalent(typeOwnerSourcePath,
                                        declarationSourcePath):
        return returnType
    return TypedExprNormalizeTypeText(Fmt"{qualifier}.{returnType}")


@borrows
fn TypedExprBindingRhsCallReturnType(ctx: TypedExprSourceContext,
                                      sourceContexts: TypedExprSourceContext[],
                                      lineNumber: int32,
                                      rhsRaw: str): str =
    let callHead = TypedExprBindingRhsCallHead(rhsRaw)
    if callHead == "":
        return ""
    let qualifier = TypedExprQualifiedCallQualifier(callHead)
    let callee = TypedExprQualifiedCallLeaf(callHead)
    if callee == "":
        return ""
    let rhs = chengpath.PathTrim(rhsRaw)
    let openPos = TypedExprFindWholeCallOpenParen(rhs)
    let closePos = TypedExprFindMatchingParen(rhs, openPos)
    if openPos <= 0 || closePos <= openPos:
        return ""
    let argsText = chengpath.PathTrim(chengpath.TextSlice(rhs,
                                                          openPos + 1,
                                                          closePos - openPos - 1))
    if qualifier == "":
        let builtinReturnType = TypedExprBuiltinCalleeReturnType(callee,
                                                                 argsText,
                                                                 parser.ParserCountTopLevelArgs(argsText))
        if builtinReturnType != "":
            return builtinReturnType
    if sourceContexts.len <= 0 && qualifier == "cmdline":
        if callee == "ParamCount":
            return "int32"
        if callee == "ParamStr":
            return "str"
        if callee == "CaptureCmdLine":
            return "void"
    let knownQualifiedReturnType = TypedExprKnownQualifiedCallReturnType(qualifier, callee)
    if knownQualifiedReturnType != "" && sourceContexts.len <= 0:
        return knownQualifiedReturnType
    var targetSourcePath: str
    var returnType: str
    var targetSymbol: str
    var targetImportc: bool
    var declarationRow: int32
    let state = TypedExprResolveCallDeclarationFromText(ctx,
                                                        sourceContexts,
                                                        qualifier,
                                                        callee,
                                                        callHead,
                                                        argsText,
                                                        lineNumber,
                                                        targetSourcePath,
                                                        returnType,
                                                        targetSymbol,
                                                        targetImportc,
                                                        declarationRow)
    if state != TypedExprBuildIndexUnique:
        if state == TypedExprBuildIndexMissing &&
           TypedExprConstructorCallReturnType(ctx, sourceContexts, callHead) != "":
            return TypedExprNormalizeTypeText(callHead)
        return ""
    return returnType

@borrows
fn TypedExprCallParamTypeAt(ir: var TypedExprIr,
                             ctx: TypedExprSourceContext,
                             sourceContexts: TypedExprSourceContext[],
                             callHeadRaw: str,
                             argsTextRaw: str,
                             lineNumber: int32,
                             argIndex: int32): str =
    let callHead = chengpath.PathTrim(callHeadRaw)
    let qualifier = TypedExprQualifiedCallQualifier(callHead)
    let callee = TypedExprQualifiedCallLeaf(callHead)
    if callee == "" || argIndex < 0:
        return ""
    if ctx.buildIndex == nil:
        return ""
    var targetSourcePath: str
    var returnType: str
    var targetSymbol: str
    var targetImportc: bool
    var declarationRow: int32
    let state = TypedExprResolveCallDeclarationFromText(ctx,
                                                        sourceContexts,
                                                        qualifier,
                                                        callee,
                                                        callHead,
                                                        argsTextRaw,
                                                        lineNumber,
                                                        targetSourcePath,
                                                        returnType,
                                                        targetSymbol,
                                                        targetImportc,
                                                        declarationRow)
    if state != TypedExprBuildIndexUnique || declarationRow < 0:
        return ""
    var scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
    var scope: TypedExprFunctionScope
    if scopeIndex >= 0:
        scope = ctx.scopes[scopeIndex]
    else:
        scopeIndex = TypedExprScopeIndexForLine(ctx.signatureScopes,
                                                lineNumber)
        if scopeIndex >= 0:
            scope = ctx.signatureScopes[scopeIndex]
        else:
            scope.sourcePath = ctx.sourcePath
            scope.startLine = 1
            scope.endLine = ctx.lines.len
            scope.genericNamesComplete = true
    var argTypes: str[]
    if !TypedExprCallStaticArgTypesInto(ctx,
                                        sourceContexts,
                                        scope,
                                        lineNumber,
                                        argsTextRaw,
                                        argTypes):
        panic(Fmt"typed expr: selected call parameter argument type unavailable source={ctx.sourcePath} name={callee} line={lineNumber}")
    var explicitGenericTypes: str[]
    var explicitGenericPresent = false
    var baseHead: str
    var genericErr: str
    if !TypedExprCallHeadGenericTypesInto(callHead,
                                           explicitGenericTypes,
                                           explicitGenericPresent,
                                           baseHead,
                                           genericErr):
        panic(Fmt"{genericErr} source={ctx.sourcePath} line={lineNumber}")
    return TypedExprCallDeclarationResolvedParamTypeForArgOwner(ctx.buildIndex,
                                                                 declarationRow,
                                                                 ctx.sourcePath,
                                                                 argTypes,
                                                                 explicitGenericTypes,
                                                                 explicitGenericPresent,
                                                                 argIndex)

@borrows
fn TypedExprLookupEnumConstType(ctx: TypedExprSourceContext,
                               sourceContexts: TypedExprSourceContext[],
                               nameRaw: str): str =
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return ""
    let index = ctx.buildIndex
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    var typeName: str
    let sourceState = TypedExprBuildIndexLookupFingerprint(index,
                                                           "ctx_enum_name_type_source",
                                                           sourcePath,
                                                           name,
                                                           "",
                                                           typeName)
    if sourceState == TypedExprBuildIndexUnique:
        return typeName
    if sourceState == TypedExprBuildIndexAmbiguous:
        return ""
    let importedState = TypedExprBuildIndexLookupFingerprint(index,
                                                             "ctx_import_enum_name_type",
                                                             sourcePath,
                                                             name,
                                                             "",
                                                             typeName)
    if importedState == TypedExprBuildIndexUnique:
        return typeName
    if sourcePath != "":
        return ""
    let globalState = TypedExprBuildIndexLookupFingerprint(TypedExprContextsBuildIndex(sourceContexts),
                                                            "ctx_enum_name_type_global",
                                                            "",
                                                            name,
                                                            "",
                                                            typeName)
    if globalState != TypedExprBuildIndexUnique:
        return ""
    return typeName

# Top-level token scan that skips string/char literal interiors. The plain
# TypedExprFindTopLevelTextToken only tracks bracket/paren/brace depth, so an
# operator that appears *inside* a string literal (e.g. `"a == b"`) registers as
# a real top-level hit. For binding-type inference we must distinguish a genuine
# comparison operator (`os.GetEnv("X") != ""` → bool) from such literal text, so
# this variant ignores anything between matched quotes.
@borrows
fn TypedExprFindTopLevelTextTokenStringAware(textRaw: str,
                                              target: str): int32 =
    if Len(target) <= 0 || Len(target) > Len(textRaw):
        return -1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<textRaw.len:
        let piece = textRaw[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
        elif piece == '\'':
            inChar = true
        elif piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            if TypedExprTextAt(textRaw, i, target):
                return i
    return -1

# A top-level comparison/relational operator (`== != <= >=`) is unambiguously a
# bool result regardless of operand types — including comparisons whose operands
# are strings (`os.GetEnv("X") != ""`). String-literal-aware so an operator that
# only appears inside a quoted literal is not mistaken for a real comparison.
@borrows
fn TypedExprBindingRhsUnambiguousCompareType(rhsRaw: str): str =
    if TypedExprFindTopLevelTextTokenStringAware(rhsRaw, "==") >= 0:
        return "bool"
    if TypedExprFindTopLevelTextTokenStringAware(rhsRaw, "!=") >= 0:
        return "bool"
    if TypedExprFindTopLevelTextTokenStringAware(rhsRaw, "<=") >= 0:
        return "bool"
    if TypedExprFindTopLevelTextTokenStringAware(rhsRaw, ">=") >= 0:
        return "bool"
    return ""

@borrows
fn TypedExprBindingRhsCompareType(rhsRaw: str): str =
    # `let s = (a == b) ? "x" : "y"`:顶层是三元,绑定值类型由三元臂裁决(str),不是
    # cond 里那个 `==` 的 bool。CompareType 在派发链(11115)早于 TernaryType(11284),
    # 若不先排除顶层三元,会把含 `==`/`!=` 的三元 cond 误推 bool→i32 → 后端 str-ternary
    # gate(SlotType==Str)失败整条跳过 → local_bool_enum_ternary gap + wcz。镜像
    # BoolExprType(6875)既有的同款 `?` 保护;纯比较绑定(无 `?`)IsTopLevelTernary=false
    # 仍推 bool,零回归。
    if TypedExprBindingRhsIsTopLevelTernary(rhsRaw):
        return ""
    let eqPos = TypedExprFindTopLevelTextToken(rhsRaw, "==")
    if eqPos >= 0:
        return "bool"
    let nePos = TypedExprFindTopLevelTextToken(rhsRaw, "!=")
    if nePos >= 0:
        return "bool"
    return ""

@borrows
fn TypedExprBindingRhsRelationalCharAt(rhsRaw: str, pos: int32): bool =
    if pos <= 0 || pos + 1 >= rhsRaw.len:
        return false
    let prev = rhsRaw[pos - 1]
    if prev == '<' || prev == '>' || prev == '=' || prev == '-' || prev == '!' || prev == '\'':
        return false
    let next = rhsRaw[pos + 1]
    if next == '<' || next == '>' || next == '=' || next == '\'':
        return false
    return true

# Untyped local whose initializer is a bare identifier naming an enclosing
# for-range loop binding: the loop induction variable is always int32 in Cheng,
# so the new local is int32 too. Without this the condition-node builder cannot
# resolve `var lo = i` (no explicit type), and every later `if lo >= hi` /
# `while lo > 0` comparison falls to the text path (`if_cond no_node`).
@borrows
fn TypedExprBindingRhsForRangeI32Type(ctx: TypedExprSourceContext,
                                       scope: TypedExprFunctionScope,
                                       lineNumber: int32,
                                       rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "" || parser.ParserIdentPrefix(rhs) != rhs:
        return ""
    if TypedExprEnclosingForRangeBindingIsI32(ctx, scope, lineNumber, rhs):
        return "int32"
    return ""

@borrows
fn TypedExprBindingRhsBoolExprType(rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "":
        return ""
    # A top-level conditional `<cond> ? <a> : <b>` is not a bool binding (its
    # value is one of the arms); reject before any comparison probe.
    if TypedExprFindTopLevelTextTokenStringAware(rhs, "?") >= 0:
        return ""
    # An unambiguous top-level comparison (`== != <= >=`) is always bool, even
    # when an operand is a string literal (`os.GetEnv("X") != ""`). This must run
    # before the string-literal guard below, which exists only to keep the weaker
    # heuristics (literal classification, `&&`/`||`, bare relational `<`/`>`) from
    # being fooled by operator-looking characters inside quoted text.
    if TypedExprBindingRhsUnambiguousCompareType(rhs) != "":
        return "bool"
    # A top-level `&&`/`||` is unambiguously bool regardless of operand types,
    # including when an operand carries a string literal
    # (`(t == "a") && cond`). Run a string-literal-aware top-level scan before
    # the `"` guard below so such compound conditions infer bool instead of "";
    # an operator that only appears inside a quoted literal stays unmatched and
    # falls through to the guard.
    if TypedExprFindTopLevelTextTokenStringAware(rhs, "&&") >= 0:
        return "bool"
    if TypedExprFindTopLevelTextTokenStringAware(rhs, "||") >= 0:
        return "bool"
    for i in 0..<rhs.len:
        if rhs[i] == '"':
            return ""
    if TypedExprLiteralBindingType(rhs) != "":
        return ""
    let ltPos = TypedExprFindTopLevelTextToken(rhs, "<")
    if ltPos >= 0 && TypedExprBindingRhsRelationalCharAt(rhs, ltPos):
        return "bool"
    let gtPos = TypedExprFindTopLevelTextToken(rhs, ">")
    if gtPos >= 0 && TypedExprBindingRhsRelationalCharAt(rhs, gtPos):
        return "bool"
    return ""

# `var out = ident` / `let out = ident` with no explicit type: infer `out`'s
# type from the already-collected binding (param or earlier local) `ident`
# resolves to, in the same function scope. Without this, later `out.field = ...`
# (esp. `out.seqField = []`) cannot resolve the field type, so the frontend
# leaves rhsNodeIndex=-1 (assign no_node) and the node-eval path drops the
# field-store — a silent miscompile (driver field-reset lost vs stage3).
# Direct linear scan over ctx.bindings (no name-index rebuild): the collection
# loop appends bindings every iteration, so the cached index would thrash.
@borrows
fn TypedExprInferLocalDeclTypeFromIdentRhs(bindings: TypedExprBinding[],
                                            functionName: str,
                                            lineNumber: int32,
                                            rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "":
        return ""
    # only a bare identifier RHS (no field path, index, call, operator).
    if parser.ParserIdentPrefix(rhs) != rhs:
        return ""
    var bestLine: int32 = -1
    var bestType = ""
    for i in 0..<bindings.len:
        let binding = bindings[i]
        if binding.name != rhs:
            continue
        if binding.globalFlag:
            if bestLine < 0:
                bestLine = binding.lineNumber
                bestType = binding.typeText
            continue
        if binding.functionName != functionName:
            continue
        if binding.lineNumber > lineNumber:
            continue
        if binding.lineNumber >= bestLine:
            bestLine = binding.lineNumber
            bestType = binding.typeText
    # `var x = ident` 绑定的是 ident 读取出的"值"，绝不会是引用。当 ident 是
    # var 形参（如 `nextIndex: var int32`，typeText=`var int32`）时，读取它产生
    # int32 值；若直接把 `var int32` 当作 x 的类型，后端会把 x 槽误定型为 Ptr，
    # 之后 `x = ident + 1` 的 I32Add assign 因 LHS 非 I32 被拒 → 整函数 wcz。
    # 剥掉 var 限定还原值类型。
    return TypedExprStripVarType(bestType)

@borrows
fn TypedExprInferLocalDeclTypeFromIdentRhsIndexed(
        ctx: TypedExprSourceContext,
        scopeIndex: int32,
        lineNumber: int32,
        rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "":
        return ""
    # only a bare identifier RHS (no field path, index, call, operator).
    if parser.ParserIdentPrefix(rhs) != rhs:
        return ""
    let typeText = TypedExprStripVarType(
        TypedExprLookupBindingTypeIndexed(ctx,
                                          scopeIndex,
                                          lineNumber,
                                          rhs))
    if typeText == "":
        return ""
    return strings.CloneStr(TypedExprNormalizeTypeText(typeText))

# Strip one or more layers of fully-wrapping outer parentheses: `((expr))` ->
# `expr`. A paren pair only wraps when its match is the final character of the
# trimmed text (otherwise the leading `(` belongs to a sub-expression).
@borrows
fn TypedExprStripWrappingParens(textRaw: str): str =
    var text = chengpath.PathTrim(textRaw)
    while text.len >= 2 && text[0] == '(':
        let closePos = TypedExprFindMatchingParen(text, 0)
        if closePos != text.len - 1:
            break
        text = chengpath.PathTrim(chengpath.TextSlice(text, 1, text.len - 2))
    return text

# Does the binding RHS denote a top-level conditional `<cond> ? <a> : <b>`?
# The grouping parens that commonly wrap a ternary in let/var bindings hide the
# `?` from a raw top-level scan, so strip them first. Used to keep inner calls
# (in the condition or arms) from being mis-promoted into let-call statements.
@borrows
fn TypedExprBindingRhsIsTopLevelTernary(rhsRaw: str): bool =
    let text = TypedExprStripWrappingParens(rhsRaw)
    let qPos = TypedExprFindTopLevelTextToken(text, "?")
    if qPos < 0:
        return false
    let colonPos = TypedExprFindTopLevelTextToken(text, ":")
    return colonPos > qPos

@borrows
fn TypedExprBindingRhsIsSeqLiteral(rhsRaw: str): bool =
    let text = chengpath.PathTrim(rhsRaw)
    if text.len < 2 || text[0] != '[' || text[text.len - 1] != ']':
        return false
    return TypedExprFindMatchingBracket(text, 0) == text.len - 1

# A binding RHS whose top level is an arithmetic/bitwise binary `+ - * / % | & << >>`
# with a non-empty left operand: the calls inside it are SUB-expressions of the
# binary, not the binding's value. Promoting the first call to a let-call binds
# the local to that single call's result and silently drops the operator and the
# other operand (net-audit r13 r13_unsigned_cast_chain: both operands were
# `uint32(call())` and the driver emitted only the first `bl`). Leave the whole
# RHS to the LocalDecl twin, whose binary-with-call decomposer materializes each
# operand into its own slot then adds. Mirrors the top-level-ternary guard. The
# `pos > 0` + non-empty stripped LHS check excludes a leading unary `-f()` (which
# the binary decomposer rejects, so its let-call promotion must stand).
@borrows
fn TypedExprBindingRhsHasTopLevelBinaryOperator(rhsRaw: str): bool =
    let text = TypedExprStripWrappingParens(rhsRaw)
    if text == "":
        return false
    var binPos: int32 = -1
    let bitOrPos = TypedExprFindTopLevelBitwiseTextToken(text, "|")
    let bitAndPos = TypedExprFindTopLevelBitwiseTextToken(text, "&")
    let addPos = TypedExprFindTopLevelTextToken(text, "+")
    let subPos = TypedExprFindTopLevelTextToken(text, "-")
    let mulPos = TypedExprFindTopLevelTextToken(text, "*")
    let divPos = TypedExprFindTopLevelTextToken(text, "/")
    let modPos = TypedExprFindTopLevelTextToken(text, "%")
    let shrPos = TypedExprFindTopLevelTextToken(text, ">>")
    let shlPos = TypedExprFindTopLevelTextToken(text, "<<")
    if bitOrPos > 0:
        binPos = bitOrPos
    elif bitAndPos > 0:
        binPos = bitAndPos
    elif addPos > 0:
        binPos = addPos
    elif subPos > 0:
        binPos = subPos
    elif mulPos > 0:
        binPos = mulPos
    elif divPos > 0:
        binPos = divPos
    elif modPos > 0:
        binPos = modPos
    elif shrPos > 0:
        binPos = shrPos
    elif shlPos > 0:
        binPos = shlPos
    if binPos <= 0:
        return false
    let lhsText = chengpath.PathTrim(chengpath.TextSlice(text, 0, binPos))
    return lhsText != ""

fn TypedExprBindingRhsTernaryType(ir: var TypedExprIr,
                                   ctx: var TypedExprSourceContext,
                                   sourceContexts: var TypedExprSourceContext[],
                                   scope: TypedExprFunctionScope,
                                   lineNumber: int32,
                                   rhsRaw: str): str =
    let qPos = TypedExprFindTopLevelTextToken(rhsRaw, "?")
    if qPos < 0:
        return ""
    let colonPos = TypedExprFindTopLevelTextToken(rhsRaw, ":")
    if colonPos <= qPos:
        return ""
    let trueText = chengpath.PathTrim(chengpath.TextSlice(rhsRaw,
                                                         qPos + 1,
                                                         colonPos - qPos - 1))
    let falseText = chengpath.PathTrim(chengpath.TextSlice(rhsRaw,
                                                          colonPos + 1,
                                                          rhsRaw.len - colonPos - 1))
    # 枚举常量臂优先(逐字保留原 local_bool_enum_ternary 绑定路径),否则回退到通用
    # 操作数解析器——与紧邻的 TypedExprBindingRhsIfExprType(同喂 LocalBoolEnumTernary
    # select 节点)完全同款策略。此前只认枚举臂:非枚举臂(int32 局部/str 字面量)
    # 返空 → 级联全空 → 整条 local_decl 被丢 → 不建槽 → 后续 ident/for-bound 用该
    # local 建不出节点 → no_node。值侧三元节点 builder(TypedExprIrBuildRhsTernaryNode)
    # 早已能建非枚举臂;此处只对齐槽侧绑定型。两臂同一具体类型才取(三元恒返回两臂
    # 公共类型)。
    let trueEnumType = TypedExprLookupEnumConstType(ctx, sourceContexts, trueText)
    if trueEnumType != "":
        let falseEnumType = TypedExprLookupEnumConstType(ctx, sourceContexts, falseText)
        if falseEnumType == trueEnumType:
            return trueEnumType
    if trueText == "" || falseText == "":
        return ""
    let trueType = TypedExprBindingOperandType(ir, ctx, sourceContexts, scope, lineNumber, trueText)
    if !TypedExprTypeTextIsConcrete(trueType):
        return ""
    let falseType = TypedExprBindingOperandType(ir, ctx, sourceContexts, scope, lineNumber, falseText)
    if trueType == falseType:
        return trueType
    return ""

# `if <cond>: <then> else: <else>` is the if-expr spelling of a ternary. When
# both arms resolve to the same concrete type the binding takes that type;
# without this resolver the let-decl's binding type was empty and the whole
# statement was silently dropped (no slot for the binding -> any later use,
# e.g. a Fmt arg, was unresolvable -> the enclosing function went wcz).
fn TypedExprBindingRhsIfExprType(ir: var TypedExprIr,
                                  ctx: var TypedExprSourceContext,
                                  sourceContexts: var TypedExprSourceContext[],
                                  scope: TypedExprFunctionScope,
                                  lineNumber: int32,
                                  rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs.len < 4 || !parser.ParserStartsWith(rhs, "if "):
        return ""
    let elsePos = TypedExprFindTopLevelTextToken(rhs, "else:")
    if elsePos <= 3:
        return ""
    var colonPos = -1
    var scan = 3
    var depth = 0
    while scan < elsePos:
        if rhs[scan] == '(' || rhs[scan] == '[':
            depth = depth + 1
        elif rhs[scan] == ')' || rhs[scan] == ']':
            depth = depth - 1
        elif rhs[scan] == ':' && depth == 0:
            colonPos = scan
            break
        scan = scan + 1
    if colonPos <= 3:
        return ""
    let thenText = chengpath.PathTrim(chengpath.TextSlice(rhs, colonPos + 1, elsePos - colonPos - 1))
    let elseText = chengpath.PathTrim(chengpath.TextSlice(rhs, elsePos + 5, rhs.len - elsePos - 5))
    if thenText == "" || elseText == "":
        return ""
    let thenType = TypedExprBindingOperandType(ir, ctx, sourceContexts, scope, lineNumber, thenText)
    if !TypedExprTypeTextIsConcrete(thenType):
        return ""
    let elseType = TypedExprBindingOperandType(ir, ctx, sourceContexts, scope, lineNumber, elseText)
    if thenType == elseType:
        return thenType
    return ""

@borrows
fn TypedExprBindingRhsLocalRefType(ir: var TypedExprIr,
                                    ctx: var TypedExprSourceContext,
                                    scope: TypedExprFunctionScope,
                                    lineNumber: int32,
                                    rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    let name = parser.ParserIdentPrefix(rhs)
    if name == "" || name != rhs:
        return ""
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
    var typeText = TypedExprLookupBindingType(ctx,
                                             scopeIndex,
                                             lineNumber,
                                             name)
    if typeText == "":
        typeText = TypedExprIrPriorBindingType(ir,
                                               ctx.sourcePath,
                                               scope.name,
                                               lineNumber,
                                               name)
    if typeText == "":
        typeText = TypedExprFunctionParamTypeInHeader(TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine),
                                                      name)
    return TypedExprNormalizeTypeText(typeText)

@borrows
fn TypedExprForHeaderIterableText(headerRaw: str): str =
    var header = chengpath.PathTrim(headerRaw)
    if header == "":
        return ""
    if parser.ParserStartsWith(header, "for "):
        header = chengpath.PathTrim(chengpath.TextSlice(header, 4, header.len - 4))
    if header.len > 0 && header[header.len - 1] == ':':
        header = chengpath.PathTrim(chengpath.TextSlice(header, 0, header.len - 1))
    let inPos = parser.ParserFindText(header, " in ")
    if inPos <= 0:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(header,
                                                  inPos + 4,
                                                  header.len - inPos - 4))

@borrows
fn TypedExprForSeqBindingElementType(ir: var TypedExprIr,
                                      ctx: var TypedExprSourceContext,
                                      sourceContexts: TypedExprSourceContext[],
                                      scope: TypedExprFunctionScope,
                                      lineNumber: int32,
                                      bindingNameRaw: str): str =
    let bindingName = parser.ParserIdentPrefix(chengpath.PathTrim(bindingNameRaw))
    if bindingName == "" || lineNumber <= scope.startLine:
        return ""
    var currentIndent: int32 = 1000000000
    if lineNumber > 0 &&
       lineNumber <= TypedExprSourceContextLineCount(ctx):
        currentIndent = TypedExprLineIndentWidth(
            TypedExprSourceContextLineText(ctx, lineNumber))
        if currentIndent <= 0:
            return ""
    if !scope.loopVarTableBuilt:
        return "int32"
    let bucket = TypedExprScopeLoopVarNameHash(bindingName,
                                               scope.loopVarNameBucketHeads.len)
    if bucket < 0:
        return ""
    var bestLine: int32 = -1
    var bestType = ""
    var entryIndex = scope.loopVarNameBucketHeads[bucket]
    while entryIndex >= 0:
        let recordIndex = entryIndex
        if scope.loopVarRecordNames[recordIndex] == bindingName &&
           scope.loopVarRecordLineNumbers[recordIndex] < lineNumber &&
           scope.loopVarRecordIndents[recordIndex] < currentIndent &&
           !scope.loopVarRecordRangeFlags[recordIndex]:
            let iterableText = scope.loopVarRecordIterableTexts[recordIndex]
            if iterableText != "" && iterableText != bindingName:
                let sourceLineNumber = scope.loopVarRecordLineNumbers[recordIndex]
                var iterableType = ""
                if TypedExprTextIsSimpleIdent(iterableText):
                    iterableType = TypedExprBindingRhsLocalRefType(ir,
                                                                  ctx,
                                                                  scope,
                                                                  sourceLineNumber,
                                                                  iterableText)
                    if iterableType == "":
                        let iterableScopeIndex = TypedExprScopeIndexForLine(ctx.scopes, sourceLineNumber)
                        iterableType = TypedExprNormalizeTypeText(TypedExprLookupBindingType(ctx,
                                                                                             iterableScopeIndex,
                                                                                             sourceLineNumber,
                                                                                             iterableText))
                else:
                    iterableType = TypedExprBindingRhsPostfixType(ir,
                                                                 ctx,
                                                                 sourceContexts,
                                                                 scope,
                                                                 sourceLineNumber,
                                                                 iterableText)
                    if iterableType == "":
                        iterableType = TypedExprBindingRhsIndexType(ir,
                                                                   ctx,
                                                                   sourceContexts,
                                                                   scope,
                                                                   sourceLineNumber,
                                                                   iterableText)
                let elemType = TypedExprNormalizeTypeText(TypedExprIrRhsIndexElemType(ctx, iterableType))
                if elemType != "" && sourceLineNumber >= bestLine:
                    bestLine = sourceLineNumber
                    bestType = elemType
        entryIndex = scope.loopVarRecordNext[recordIndex]
    return bestType

@borrows
fn TypedExprBindingRhsIndexType(ir: var TypedExprIr,
                                 ctx: var TypedExprSourceContext,
                                 sourceContexts: TypedExprSourceContext[],
                                 scope: TypedExprFunctionScope,
                                 lineNumber: int32,
                                 rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "" || rhs[rhs.len - 1] != ']':
        return ""
    # Split at the open bracket that pairs with the FINAL `]`, not the first
    # `[` — for a chained subscript like `contexts[i].bindings[bindingIndex]`
    # the trailing index belongs to `contexts[i].bindings`, so the root must be
    # the whole prefix before that bracket (scanning the first `[` mis-rooted it
    # at `contexts`, yielding the outer element type instead of the inner one).
    var openPos: int32 = -1
    var bracketDepth: int32
    for backScan in 0..<rhs.len:
        let i = rhs.len - 1 - backScan
        if rhs[i] == ']':
            bracketDepth = bracketDepth + 1
        elif rhs[i] == '[':
            bracketDepth = bracketDepth - 1
            if bracketDepth == 0:
                openPos = i
                break
    if openPos <= 0:
        return ""
    let rootText = chengpath.PathTrim(chengpath.TextSlice(rhs, 0, openPos))
    let indexText = chengpath.PathTrim(chengpath.TextSlice(rhs,
                                                          openPos + 1,
                                                          rhs.len - openPos - 2))
    if rootText == "" || indexText == "":
        return ""
    var rootType = ""
    if parser.ParserIdentPrefix(rootText) == rootText:
        rootType = TypedExprBindingRhsLocalRefType(ir, ctx, scope, lineNumber, rootText)
        if rootType == "":
            let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
            rootType = TypedExprNormalizeTypeText(TypedExprLookupBindingType(ctx,
                                                                            scopeIndex,
                                                                            lineNumber,
                                                                            rootText))
    elif TypedExprTextIsSimpleFieldPath(rootText):
        # Index element typing only needs the frozen declared member type, not
        # the owner's complete byte layout.  Requiring layout here makes a
        # valid `owner.seqField[index]` binding disappear when an unrelated
        # sibling field is not yet realizable during bootstrap.
        TypedExprBindingNameIndexPrepare(ctx)
        rootType = TypedExprNormalizeTypeText(TypedExprAssignStatementType(
            ctx, sourceContexts, scope, lineNumber, rootText))
    else:
        # The root is itself a postfix chain that contains its own subscript
        # (e.g. `contexts[i].bindings`); resolve its whole type through the
        # general postfix walker, which handles arbitrary `.field`/`[idx]`
        # sequences, then take the element type of that array below.
        rootType = TypedExprBindingRhsPostfixType(ir,
                                                  ctx,
                                                  sourceContexts,
                                                  scope,
                                                  lineNumber,
                                                  rootText)
        if rootType == "":
            return ""
    if rootType == "str":
        return "char"
    if rootType == "Bytes" || rootType == "rawbytes.Bytes" || rootType == "bytes.Bytes":
        return "uint8"
    return TypedExprIrRhsIndexElemType(ctx, rootType)

@borrows
fn TypedExprPostfixValueTypeFromRoot(ctx: TypedExprSourceContext,
                                      sourceContexts: TypedExprSourceContext[],
                                      rhsRaw: str,
                                      rootNameRaw: str,
                                      rootTypeRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    let rootName = chengpath.PathTrim(rootNameRaw)
    var currentType = TypedExprNormalizeTypeText(rootTypeRaw)
    if rhs == "" || rootName == "" || currentType == "" ||
       rootName.len >= rhs.len ||
       chengpath.TextSlice(rhs, 0, rootName.len) != rootName:
        return ""
    var cursor = rootName.len
    var seenPostfix = false
    while cursor < rhs.len:
        if rhs[cursor] == '[':
            let closePos = TypedExprFindMatchingBracket(rhs, cursor)
            if closePos <= cursor:
                return ""
            let indexText = TypedExprSliceTrim(rhs,
                                               cursor + 1,
                                               closePos - cursor - 1)
            if indexText == "":
                return ""
            let elemType = TypedExprIrRhsIndexElemType(ctx, share(currentType))
            if elemType == "":
                return ""
            # A range subscript is a slice and keeps the container value type;
            # an ordinary subscript yields the exact element type.
            if !TypedExprTextHasTopLevelRangeOp(indexText):
                currentType = TypedExprNormalizeTypeText(elemType)
            cursor = closePos + 1
            seenPostfix = true
            continue
        var fieldName = ""
        var fieldRootType = currentType
        var fieldPrefixLen: int32
        if rhs[cursor] == '.':
            fieldPrefixLen = 1
        elif cursor + 1 < rhs.len &&
             rhs[cursor] == '-' && rhs[cursor + 1] == '>':
            fieldPrefixLen = 2
            fieldRootType = TypedExprPointerPointeeType(ctx,
                                                        sourceContexts,
                                                        fieldRootType)
            if fieldRootType == "":
                return ""
        else:
            return ""
        if cursor + fieldPrefixLen >= rhs.len:
            return ""
        var fieldTextStart = cursor + fieldPrefixLen
        # 行尾点号/箭头续行（合法表面，如 cleanup_cfg:10291 平移调用的
        # `bodyIR.callSequence[callIndex].` + 续行成员名）：成员名提取前
        # 跳过续行空白；其余字符仍由下方 ident 前缀判定 fail-closed
        # （不扩大接受集，零放宽）。
        while fieldTextStart < rhs.len &&
              (rhs[fieldTextStart] == ' ' || rhs[fieldTextStart] == '\t' ||
               rhs[fieldTextStart] == '\n' || rhs[fieldTextStart] == '\r'):
            fieldTextStart = fieldTextStart + 1
        if fieldTextStart >= rhs.len:
            return ""
        fieldName = parser.ParserIdentPrefix(chengpath.TextSlice(
            rhs,
            fieldTextStart,
            rhs.len - fieldTextStart))
        if fieldName == "":
            return ""
        let fieldNameLen = fieldName.len
        var fieldType = ""
        var fieldOffset: int32
        var fieldSize: int32
        var fieldAlign: int32
        if !TypedExprResolveFieldPathMeta(ctx,
                                          sourceContexts,
                                          share(fieldRootType),
                                          share(fieldName),
                                          fieldType,
                                          fieldOffset,
                                          fieldSize,
                                          fieldAlign):
            # Built-in members such as sequence/string `len` have no user
            # type-layout row, but are still exact language-defined fields.
            fieldType = TypedExprAssignFieldType(fieldRootType, fieldName)
            if fieldType == "":
                # [static-arg 族成员 2 配套] 本源声明字段直查回退（与
                # TypedExprAssignStatementType 的 directOwnerLeaf 回退同病灶
                # 同法：binding-declaration-index 相 build 索引只含
                # call-declaration 域，ctx_field_source 查询对本源 object
                # 字段全 miss，注释原文在案）。本消费者只取字段类型文本
                # （offset/size/align 弃置，不参与任何布局判定），直查
                # ctx.typeFields 精确 ownerType leaf + field ident，仅单一
                # 不同声明型才取，否则维持返空 fail-closed（零放宽）。
                let directOwnerLeaf = TypedExprTypeLeafName(fieldRootType)
                var directFieldType = ""
                var directFieldTypeSeen = false
                var directMatchAmbiguous = false
                for directFieldRowIndex in 0..<ctx.typeFields.len:
                    let directFieldRow = ctx.typeFields[directFieldRowIndex]
                    if TypedExprTypeLeafName(directFieldRow.ownerType) !=
                           directOwnerLeaf:
                        continue
                    if parser.ParserIdentPrefix(
                           chengpath.PathTrim(directFieldRow.fieldName)) !=
                           fieldName:
                        continue
                    let directRowType =
                        TypedExprNormalizeTypeText(directFieldRow.fieldType)
                    if !directFieldTypeSeen:
                        directFieldType = directRowType
                        directFieldTypeSeen = true
                    elif directRowType != directFieldType:
                        directMatchAmbiguous = true
                        break
                if directFieldTypeSeen && !directMatchAmbiguous &&
                   directFieldType != "":
                    fieldType = directFieldType
            if fieldType == "":
                return ""
        currentType = TypedExprNormalizeTypeText(fieldType)
        cursor = fieldTextStart + fieldNameLen
        seenPostfix = true
    if !seenPostfix:
        return ""
    return currentType

@borrows
fn TypedExprBindingRhsPostfixType(ir: var TypedExprIr,
                                   ctx: var TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   scope: TypedExprFunctionScope,
                                   lineNumber: int32,
                                   rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "":
        return ""
    let rootName = parser.ParserIdentPrefix(rhs)
    if rootName == "" || rootName.len >= rhs.len:
        return ""
    var currentType = TypedExprBindingRhsLocalRefType(ir, ctx, scope, lineNumber, rootName)
    if currentType == "":
        let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
        currentType = TypedExprNormalizeTypeText(TypedExprLookupBindingType(ctx,
                                                                            scopeIndex,
                                                                            lineNumber,
                                                                            rootName))
    if TypedExprStripVarType(currentType) == "range":
        let forSeqElemType = TypedExprForSeqBindingElementType(ir,
                                                              ctx,
                                                              sourceContexts,
                                                              scope,
                                                              lineNumber,
                                                              share(rootName))
        if forSeqElemType != "":
            currentType = forSeqElemType
    if currentType == "":
        return ""
    return TypedExprPostfixValueTypeFromRoot(ctx,
                                             sourceContexts,
                                             rhs,
                                             rootName,
                                             currentType)

fn TypedExprBindingOperandType(ir: var TypedExprIr,
                                ctx: var TypedExprSourceContext,
                                sourceContexts: var TypedExprSourceContext[],
                                scope: TypedExprFunctionScope,
                                lineNumber: int32,
                                textRaw: str): str =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return ""
    TypedExprBindingNameIndexPrepare(ctx)
    # A fully parenthesized operand (e.g. `(hi - lo)`) has the same type as its
    # inner expression; strip one matching outer-paren layer (same matched-paren
    # test as TypedExprIrBuildRhsPrimaryNode) so the binding type is recovered
    # instead of every classifier branch failing and dropping the let-decl.
    if text[0] == '(' && TypedExprFindMatchingParen(text, 0) == text.len - 1:
        let inner = TypedExprSliceTrim(text, 1, text.len - 2)
        if inner == "":
            return ""
        var innerType = TypedExprBindingOperandType(ir, ctx, sourceContexts, scope, lineNumber, inner)
        if innerType == "":
            innerType = TypedExprBindingRhsBinaryOpType(ir, ctx, sourceContexts, scope, lineNumber, inner)
        return innerType
    var explicitTargetType = ""
    var explicitOperandText = ""
    var explicitBorrow = false
    if TypedExprExplicitTypeConversionSurface(text,
                                               explicitTargetType,
                                               explicitOperandText,
                                               explicitBorrow) &&
       TypedExprExplicitTypeTargetVisible(ctx,
                                          sourceContexts,
                                          explicitTargetType):
        TypedExprBindingNameIndexPrepare(ctx)
        let explicitOperandType = TypedExprStaticExprTypeAtLevel(
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            explicitOperandText,
            0)
        let explicitKind = TypedExprExplicitTypeConversionClassify(
            ctx,
            sourceContexts,
            ctx.sourcePath,
            explicitTargetType,
            ctx.sourcePath,
            explicitOperandType,
            explicitBorrow,
            TypedExprExplicitTypeConversionPlaceUnknown)
        let normalizedExplicitTarget = TypedExprNormalizeTypeText(
            explicitTargetType)
        if explicitKind == TypedExprExplicitTypeConversionBorrow ||
           explicitKind == TypedExprExplicitTypeConversionDeferred:
            return TypedExprCallBorrowModeType(normalizedExplicitTarget)
        if explicitKind == TypedExprExplicitTypeConversionIdentity ||
           explicitKind == TypedExprExplicitTypeConversionScalar:
            return normalizedExplicitTarget
    let literalType = TypedExprLiteralBindingType(text)
    if literalType != "":
        return literalType
    let refType = TypedExprBindingRhsLocalRefType(ir, ctx, scope, lineNumber, text)
    if refType != "":
        return refType
    # 裸模块级 const 操作数(如 `MachoCodeSignaturePageSize = 4096`)不是 local/param,
    # local-ref 查询返 "" → 整条二元算术绑定类型塌成 "" → 静默丢 let-decl,并把
    # no_node 级联到所有后续用法(macho codeSlots/cdLen 等)。叶节点 builder
    # (TypedExprIrBuildRhsIdentNode)本就把这种 const 解析成 typed literal 节点;
    # 此处镜像之,使绑定类型与将建节点类型一致。仅对裸简单标识符、其 const 字面量
    # 归一为具体标量类型时解析。
    if TypedExprTextIsSimpleIdent(text):
        let constOperandLiteral = TypedExprModuleConstLiteralForContext(ctx, text)
        if constOperandLiteral != "":
            let constOperandType = TypedExprLiteralBindingType(constOperandLiteral)
            if constOperandType != "":
                return constOperandType
    # 限定模块 const 操作数(如 `coreir.ResultStrOkOffset`)不是 simple ident(带点号
    # 限定),被上面的门挡掉,也不是 local/param,local-ref 查询返 "" → binary-op
    # 类型塌成 "" → 静默丢算术 let-decl → no_node 级联到所有把该 local 作 call-arg/
    # if-cond 的用法。值侧节点 builder(TypedExprIrBuildRhsQualifiedEnumConstNode)早
    # 已把 `mod.NAME` 解析成 typed const 叶;此处镜像之(用既有 QualifiedConstLiteral
    # 解析器),使绑定类型与将建节点类型一致。仅当其 const 字面量归一为具体标量类型时解析。
    let qualifiedConstOperandLiteral = TypedExprQualifiedConstLiteral(ctx, sourceContexts, text)
    if qualifiedConstOperandLiteral != "":
        let qualifiedConstOperandType = TypedExprLiteralBindingType(qualifiedConstOperandLiteral)
        if qualifiedConstOperandType != "":
            return qualifiedConstOperandType
    # A bare reference to an enclosing `for x in a..b` induction variable is i32.
    # Local-ref lookup does not see the loop var binding, so a binary-op operand
    # that is the loop variable (`stop - offset`) otherwise resolved to "" and the
    # whole let-decl was silently dropped (binding type empty -> statement skipped),
    # losing the binding and its uses (the dropped `let scan = stop - offset` then
    # made `s[scan]` unresolvable -> build_word_count_zero / stale value).
    let forRangeType = TypedExprBindingRhsForRangeI32Type(ctx, scope, lineNumber, text)
    if forRangeType != "":
        return forRangeType
    if TypedExprTextIsSimpleIdent(text):
        let forSeqElemType = TypedExprForSeqBindingElementType(ir,
                                                              ctx,
                                                              sourceContexts,
                                                              scope,
                                                              lineNumber,
                                                              text)
        if forSeqElemType != "":
            return forSeqElemType
    let postfixType = TypedExprBindingRhsPostfixType(ir, ctx, sourceContexts, scope, lineNumber, text)
    if postfixType != "":
        return postfixType
    let indexType = TypedExprBindingRhsIndexType(ir, ctx, sourceContexts, scope, lineNumber, text)
    if indexType != "":
        return indexType
    let callType = TypedExprBindingRhsCallReturnType(ctx, sourceContexts, lineNumber, text)
    if TypedExprTypeTextIsConcrete(callType):
        return callType
    # 裸 Result 内征臂（`Value(r)` / `IsOk(r)` / `Error(r)` 等）：内征非 scope 内普通
    # 函数，上面 call 解析器返空，operand 型塌成 "" → 父三元/if-expr 两臂型不一致 →
    # 整条 local_decl 绑定型 "" → 不建槽 → 同行 result_intrinsic 孪生找不到驱动 →
    # bail=61。按内征语义补型（固定返回直接给；Value 从实参 Result[T] 推 T）。
    let resultIntrinsicType = TypedExprBindingRhsResultIntrinsicType(ir,
                                                                    ctx,
                                                                    sourceContexts,
                                                                    scope,
                                                                    lineNumber,
                                                                    text)
    if resultIntrinsicType != "":
        return resultIntrinsicType
    # 三元 operand（嵌套三元臂 `(c2 ? "b" : "c")` 或裸 `c2 ? "b" : "c"`):上面所有标量/
    # 字面量/调用解析器都不认顶层三元,operand 型塌成 "" → 父三元两臂型不一致 → 整条
    # local_decl 绑定型 "" → 不建槽 → 后续 seq_add/用法 no_node。镜像 BindingRhsTernaryType
    # (两臂同型取公共型),覆盖括号 inner 递归(7298 已 strip 一层)与裸 false 臂两路。
    # IsTopLevelTernary 对非三元恒 false → 零回归;臂为严格更短子串 → 互递归必终止。
    if TypedExprBindingRhsIsTopLevelTernary(text):
        return TypedExprBindingRhsTernaryType(ir, ctx, sourceContexts, scope, lineNumber, text)
    return ""

# 解析一个**整体即单个 Result 内征调用**的 operand 文本（`IsOk(r)`/`Value(r)` 等）的
# 类型。固定返回内征按 result.cheng 签名直接给（IsOk/IsErr→bool、Error→str、
# ErrorInfoOf→ErrorInfo）；Value(r) 的返回是泛型 T，从实参 `r` 的 Result[T] 推出 T。
# 推不出具体 T（实参型未知或非 Result[...]）时返 ""（poison-on-miss）——宁可该条仍
# bail，绝不臆造错型引入 width/type miscompile。Ok/Err 构造器返 Result[T]，T 不可从
# operand 文本干净推得，故此处不处理（返 ""）。
fn TypedExprBindingRhsResultIntrinsicType(ir: var TypedExprIr,
                                           ctx: var TypedExprSourceContext,
                                           sourceContexts: var TypedExprSourceContext[],
                                           scope: TypedExprFunctionScope,
                                           lineNumber: int32,
                                           textRaw: str): str =
    let text = chengpath.PathTrim(textRaw)
    let callHead = TypedExprBindingRhsCallHead(text)
    if callHead == "":
        return ""
    let detailKind = parser.ParserResultIntrinsicDetailKind(callHead)
    if detailKind == parser.NormalizedExprDetailResultIsOk ||
       detailKind == parser.NormalizedExprDetailResultIsErr:
        return "bool"
    if detailKind == parser.NormalizedExprDetailResultError:
        return "str"
    if detailKind == parser.NormalizedExprDetailResultErrorInfoOf:
        return "ErrorInfo"
    if detailKind == parser.NormalizedExprDetailResultValue:
        let openPos = TypedExprFindWholeCallOpenParen(text)
        if openPos <= 0:
            return ""
        let closePos = TypedExprFindMatchingParen(text, openPos)
        if closePos <= openPos:
            return ""
        let argText = chengpath.PathTrim(chengpath.TextSlice(text,
                                                            openPos + 1,
                                                            closePos - openPos - 1))
        if argText == "":
            return ""
        let argType = TypedExprBindingOperandType(ir,
                                                  ctx,
                                                  sourceContexts,
                                                  scope,
                                                  lineNumber,
                                                  argText)
        let innerType = TypedExprResultSuccessType(argType)
        if TypedExprTypeTextIsConcrete(innerType):
            return innerType
        return ""
    return ""

fn TypedExprBindingRhsBinaryOpType(ir: var TypedExprIr,
                                    ctx: var TypedExprSourceContext,
                                    sourceContexts: var TypedExprSourceContext[],
                                    scope: TypedExprFunctionScope,
                                    lineNumber: int32,
                                    rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if rhs == "":
        return ""
    var opPos = TypedExprFindTopLevelBitwiseTextToken(rhs, "|")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelBitwiseTextToken(rhs, "&")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelTextToken(rhs, "+")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelTextToken(rhs, "-")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelTextToken(rhs, "*")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelTextToken(rhs, "/")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelTextToken(rhs, "%")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelTextToken(rhs, ">>")
    var isShift = false
    if opPos > 0:
        isShift = TypedExprTextAt(rhs, opPos, ">>")
    if opPos <= 0:
        opPos = TypedExprFindTopLevelTextToken(rhs, "<<")
        if opPos > 0:
            isShift = true
    if opPos <= 0 || opPos + 1 >= rhs.len:
        return ""
    var opLen: int32
    opLen = 1
    if TypedExprTextAt(rhs, opPos, ">>") || TypedExprTextAt(rhs, opPos, "<<"):
        opLen = 2
    let opText = chengpath.TextSlice(rhs, opPos, opLen)
    let lhsText = chengpath.PathTrim(chengpath.TextSlice(rhs, 0, opPos))
    let rhsText = chengpath.PathTrim(chengpath.TextSlice(rhs,
                                                         opPos + opLen,
                                                         rhs.len - opPos - opLen))
    var lhsType = TypedExprBindingOperandType(ir, ctx, sourceContexts, scope, lineNumber, lhsText)
    if lhsType == "":
        lhsType = TypedExprBindingRhsBinaryOpType(ir, ctx, sourceContexts, scope, lineNumber, lhsText)
    # `var T` 形参在值位读出即 T(by-ref 只影响写回 ABI 不影响读值标量类型)。operand
    # 解析漏带 `var`(name: var int32 → "varint32")使下面 ==int32 混型规则全失配、
    # 返回 "" → let-decl 被丢、其作算术/调用实参的用法 no_node。读值前剥 var。
    lhsType = TypedExprStripVarType(lhsType)
    var rhsType = TypedExprBindingOperandType(ir, ctx, sourceContexts, scope, lineNumber, rhsText)
    if rhsType == "":
        rhsType = TypedExprBindingRhsBinaryOpType(ir, ctx, sourceContexts, scope, lineNumber, rhsText)
    rhsType = TypedExprStripVarType(rhsType)
    if lhsType == "" || rhsType == "":
        return ""
    if isShift:
        let lhsInteger = lhsType == "int8" || lhsType == "uint8" ||
                         lhsType == "int16" || lhsType == "uint16" ||
                         lhsType == "int32" || lhsType == "uint32" ||
                         lhsType == "int64" || lhsType == "uint64" ||
                         lhsType == "int" || lhsType == "uint"
        let rhsInteger = rhsType == "int8" || rhsType == "uint8" ||
                         rhsType == "int16" || rhsType == "uint16" ||
                         rhsType == "int32" || rhsType == "uint32" ||
                         rhsType == "int64" || rhsType == "uint64" ||
                         rhsType == "int" || rhsType == "uint"
        if !lhsInteger || !rhsInteger:
            return ""
        return lhsType
    if lhsType == "float64" && rhsType == "float64":
        if opText == "+" || opText == "-" || opText == "*" || opText == "/":
            return "float64"
        return ""
    if lhsType == "int64" || rhsType == "int64" ||
       lhsType == "uint64" || rhsType == "uint64":
        return "int64"
    if lhsType == "int32" && rhsType == "int32":
        return "int32"
    return ""

fn TypedExprBindingRhsSeqLiteralType(ir: var TypedExprIr,
                                      ctx: var TypedExprSourceContext,
                                      sourceContexts: var TypedExprSourceContext[],
                                      scope: TypedExprFunctionScope,
                                      lineNumber: int32,
                                      rhsRaw: str): str =
    let rhs = chengpath.PathTrim(rhsRaw)
    if !TypedExprBindingRhsIsSeqLiteral(rhs):
        return ""
    let inner = TypedExprSliceTrim(rhs, 1, rhs.len - 2)
    if inner == "":
        return ""
    let elems = TypedExprSplitTopLevelCsv(inner)
    if elems.len <= 0:
        return ""
    var elemType = ""
    for elemIndex in 0..<elems.len:
        let elemText = chengpath.PathTrim(elems[elemIndex])
        if elemText == "":
            return ""
        var itemType = TypedExprBindingOperandType(ir,
                                                   ctx,
                                                   sourceContexts,
                                                   scope,
                                                   lineNumber,
                                                   elemText)
        if itemType == "":
            itemType = TypedExprBindingRhsBinaryOpType(ir,
                                                       ctx,
                                                       sourceContexts,
                                                       scope,
                                                       lineNumber,
                                                       elemText)
        itemType = TypedExprNormalizeTypeText(TypedExprStripVarType(itemType))
        if !TypedExprTypeTextIsConcrete(itemType):
            return ""
        if elemType == "":
            elemType = itemType
        elif elemType != itemType:
            return ""
    if elemType == "":
        return ""
    return strutil.Join([elemType, "[]"], "")

var typedExprRhsNodeBuiltCount: int32
var typedExprRhsNodeSkippedCount: int32
var typedExprRhsNodeSkipReason: str
# wall31: 赋值 LHS 文本构建窗口内(tree 会话)为真。窗口内参数名读经
# TypedExprIrBuildRhsIdentNode 索引快路径命中时, 发布 fresh detached
# ParamRef 引用副本而不是共享定义载体; 载体是 Parameter-origin value
# definition row 的 defining node, 契约要求 owner_statement == -1, 一旦
# 入语句图会被所有权声明器盖章死(parameterOrigin && ownerStatement != -1)。
var typedExprLhsFreshParamRefActive: bool
var typedExprRhsNodeTraceInitialized: bool
var typedExprRhsNodeTraceEnabled: bool

fn TypedExprRhsNodeBuiltCount(): int32 =
    return typedExprRhsNodeBuiltCount

fn TypedExprRhsNodeSkippedCount(): int32 =
    return typedExprRhsNodeSkippedCount

fn TypedExprIrRhsNodeTraceEnabled(): bool =
    if !typedExprRhsNodeTraceInitialized:
        typedExprRhsNodeTraceInitialized = true
        typedExprRhsNodeTraceEnabled = os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1"
    return typedExprRhsNodeTraceEnabled

@borrows
fn TypedExprIrRhsCharAtIs(text: str,
                           pos: int32,
                           ch: char): bool =
    if pos < 0 || pos >= text.len:
        return false
    return text[pos] == ch

fn TypedExprIrRhsCharIsOperandEnd(ch: char): bool =
    if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9'):
        return true
    return ch == '_' || ch == ')' || ch == ']' || ch == '"' || ch == '\''

@borrows
fn TypedExprIrRhsPrevNonSpacePos(text: str,
                                  posRaw: int32): int32 =
    var pos = posRaw - 1
    while pos >= 0:
        let code = Int32(text[pos])
        if code != 32 && code != 9:
            return pos
        pos = pos - 1
    return -1

@borrows
fn TypedExprIrRhsBinaryOpContextOk(text: str,
                                    pos: int32): bool =
    let prevPos = TypedExprIrRhsPrevNonSpacePos(text, pos)
    if prevPos < 0:
        return false
    return TypedExprIrRhsCharIsOperandEnd(text[prevPos])

@borrows
fn TypedExprIrRhsMatchEqualityOpLenAt(text: str,
                                       i: int32): int32 =
    let ch = text[i]
    if ch == '=' && TypedExprIrRhsCharAtIs(text, i + 1, '=') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '=') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '!') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '<') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '>'):
        return 2
    if ch == '!' && TypedExprIrRhsCharAtIs(text, i + 1, '='):
        return 2
    return 0

@borrows
fn TypedExprIrRhsMatchRelationalOpLenAt(text: str,
                                         i: int32): int32 =
    let ch = text[i]
    if ch == '<' && !TypedExprIrRhsCharAtIs(text, i - 1, '<'):
        if TypedExprIrRhsCharAtIs(text, i + 1, '='):
            return 2
        if !TypedExprIrRhsCharAtIs(text, i + 1, '<'):
            return 1
    if ch == '>' && !TypedExprIrRhsCharAtIs(text, i - 1, '>') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '-') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '='):
        if TypedExprIrRhsCharAtIs(text, i + 1, '='):
            return 2
        if !TypedExprIrRhsCharAtIs(text, i + 1, '>'):
            return 1
    return 0

@borrows
fn TypedExprIrRhsMatchShiftOpLenAt(text: str,
                                    i: int32): int32 =
    let ch = text[i]
    if ch == '<' && TypedExprIrRhsCharAtIs(text, i + 1, '<') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '<') &&
       !TypedExprIrRhsCharAtIs(text, i + 2, '<') &&
       !TypedExprIrRhsCharAtIs(text, i + 2, '='):
        return 2
    if ch == '>' && TypedExprIrRhsCharAtIs(text, i + 1, '>') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '>') &&
       !TypedExprIrRhsCharAtIs(text, i - 1, '-') &&
       !TypedExprIrRhsCharAtIs(text, i + 2, '>') &&
       !TypedExprIrRhsCharAtIs(text, i + 2, '='):
        return 2
    return 0

@borrows
fn TypedExprIrRhsMatchOpLenAt(text: str,
                               i: int32,
                               level: int32): int32 =
    let ch = text[i]
    if level == 0:
        if ch == '|' && TypedExprIrRhsCharAtIs(text, i + 1, '|') &&
           !TypedExprIrRhsCharAtIs(text, i - 1, '|'):
            return 2
        return 0
    if level == 1:
        if ch == '&' && TypedExprIrRhsCharAtIs(text, i + 1, '&') &&
           !TypedExprIrRhsCharAtIs(text, i - 1, '&'):
            return 2
        return 0
    if level == 2:
        if ch == '|' && !TypedExprIrRhsCharAtIs(text, i + 1, '|') &&
           !TypedExprIrRhsCharAtIs(text, i - 1, '|'):
            return 1
        return 0
    if level == 3:
        if ch == '^':
            return 1
        return 0
    if level == 4:
        # 二元位与 `x & y` 需左侧有操作数；位置 0（或前面无操作数）的 `&` 是
        # 一元取址前缀 `&place`，不在此切分，留给 BuildRhsUnaryNode 的 AddrOf 分支。
        if ch == '&' && !TypedExprIrRhsCharAtIs(text, i + 1, '&') &&
           !TypedExprIrRhsCharAtIs(text, i - 1, '&') &&
           TypedExprIrRhsBinaryOpContextOk(text, i):
            return 1
        return 0
    if level == 5:
        return TypedExprIrRhsMatchEqualityOpLenAt(text, i)
    if level == 6:
        return TypedExprIrRhsMatchRelationalOpLenAt(text, i)
    if level == 7:
        return TypedExprIrRhsMatchShiftOpLenAt(text, i)
    if level == 8:
        if ch != '+' && ch != '-':
            return 0
        if ch == '-' && TypedExprIrRhsCharAtIs(text, i + 1, '>'):
            return 0
        if !TypedExprIrRhsBinaryOpContextOk(text, i):
            return 0
        return 1
    if level == 9:
        if ch != '*' && ch != '/' && ch != '%':
            return 0
        if !TypedExprIrRhsBinaryOpContextOk(text, i):
            return 0
        return 1
    return 0

# Detects a bare top-level `..` (range operator) while skipping string/char
# literals and any `..` nested inside (), [], {}. `..<` starts with `..` so it
# matches too. Returns false when every `..` is quoted or parenthesized.
@borrows
fn TypedExprTextHasTopLevelRangeOp(text: str): bool =
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<text.len:
        let piece = text[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
        elif piece == '\'':
            inChar = true
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
            if piece == '.' && TypedExprIrRhsCharAtIs(text, i + 1, '.'):
                return true
    return false

# Returns -1 when no top-level operator of this level exists; otherwise the
# encoded last match `pos * 4 + opLen` (opLen is 1 or 2).
@borrows
fn TypedExprIrRhsFindSplit(text: str,
                            level: int32): int32 =
    var found: int32 = -1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<text.len:
        let piece = text[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
        elif piece == '\'':
            inChar = true
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
            let matchLen = TypedExprIrRhsMatchOpLenAt(text, i, level)
            if matchLen > 0:
                found = i * 4 + matchLen
    return found

@borrows
fn TypedExprIrRhsCallFormPos(text: str): int32 =
    for i in 0..<text.len:
        if text[i] != '(':
            continue
        if i <= 0:
            continue
        if TypedExprIrRhsCharIsOperandEnd(text[i - 1]):
            return i
    return -1

@borrows
fn TypedExprIrRhsTextIsStringLiteral(text: str): bool =
    if text.len < 2 || text[0] != '"' || text[text.len - 1] != '"':
        return false
    var escaped = false
    let stop = text.len - 1
    for i in 1..<stop:
        let piece = text[i]
        if escaped:
            escaped = false
        elif piece == '\\':
            escaped = true
        elif piece == '"':
            return false
    return !escaped

@borrows
fn TypedExprIrRhsTextIsCharLiteral(text: str): bool =
    if text.len < 3 || text[0] != '\'' || text[text.len - 1] != '\'':
        return false
    if text.len == 3:
        return text[1] != '\\' && text[1] != '\''
    if text.len == 4:
        return text[1] == '\\'
    return false

@borrows
fn TypedExprIrRhsTextIsI32Literal(text: str): bool =
    if text.len <= 0:
        return false
    if text.len > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X'):
        if text.len > 10:
            return false
        var hexValue: int64
        for i in 2..<text.len:
            let hch = text[i]
            var hv: int64 = -1
            if hch >= '0' && hch <= '9':
                hv = Int64(Int32(hch) - Int32('0'))
            elif hch >= 'a' && hch <= 'f':
                hv = Int64(Int32(hch) - Int32('a') + 10)
            elif hch >= 'A' && hch <= 'F':
                hv = Int64(Int32(hch) - Int32('A') + 10)
            if hv < 0:
                return false
            hexValue = hexValue * 16 + hv
        return hexValue <= 2147483647
    if text.len > 11:
        return false
    var value: int64
    var i32LitStart: int32
    # 前导负号:负 i32 字面量(如 const EClassNoClass = -1)首字符 '-' 之前被直接拒,
    # 致 `add(seq, -1常量)` 实参建不出节点 → 整调用 no_node。对照同文件 F64 版已处理
    # 前导 '-'。负数幅值界 2147483648(int32 min 的绝对值)。
    if text[0] == '-':
        if text.len < 2:
            return false
        i32LitStart = 1
    for i in i32LitStart..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        value = value * 10 + Int64(Int32(ch) - Int32('0'))
    if text[0] == '-':
        return value <= 2147483648
    return value <= 2147483647

@borrows
fn TypedExprIrRhsTextIsF64Literal(textRaw: str): bool =
    let text = chengpath.PathTrim(share(textRaw))
    if text.len < 3:
        return false
    var start: int32
    if text[0] == '-':
        if text.len < 4:
            return false
        start = 1
    var dotCount: int32
    var digitsBefore: int32
    var digitsAfter: int32
    for i in start..<text.len:
        let ch = text[i]
        if ch == '.':
            dotCount = dotCount + 1
            if dotCount > 1:
                return false
            continue
        if ch < '0' || ch > '9':
            return false
        if dotCount == 0:
            digitsBefore = digitsBefore + 1
        else:
            digitsAfter = digitsAfter + 1
    return dotCount == 1 && digitsBefore > 0 && digitsAfter > 0

@borrows
fn TypedExprIrTypeTextIsSeq(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(TypedExprStripVarType(share(typeRaw)))
    if typeText.len > 2 &&
       chengpath.TextSlice(share(typeText), typeText.len - 2, 2) == "[]":
        return true
    if parser.ParserStartsWith(typeText, "seq["):
        return true
    return false

@borrows
fn TypedExprIrTypeTextIsFixedArray(ctx: TypedExprSourceContext,
                                    typeRaw: str): bool =
    var elemType = ""
    var length: int32
    return TypedExprIrFixedArrayTypeParts(ctx, typeRaw, elemType, length)

# Fixed-array dimensions use the same exact-owner evaluator as call constants.
# This preserves the canonical precedence, associativity, cast and overflow
# rules while allowing arbitrary acyclic const chains. A recognized invalid
# expression is never reclassified as a generic type argument.
@borrows
fn TypedExprConstDimIntValue(ctx: TypedExprSourceContext,
                              textRaw: str,
                              value: var int32): bool =
    value = 0
    # typed 构建期模块按序构建: 被查询 context 的 buildIndex 可能尚未就绪
    # (provider 闭包跨模块符号维度, core_runtime_provider_darwin 的
    # sockaddr/host 常量维度) — 这是合法中间态, 不是内部错误。返回 false
    # 让上层按「未识别」降级 (CanonicalizeFixedArrayDimText 保留原文本,
    # 待 buildIndex 就绪后重解析), 不 panic。
    if ctx.buildIndex == nil || ctx.buildIndex.released:
        return false
    let ownerSourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    if ownerSourcePath == "":
        panic("typed expr: const dimension owner source missing")
    var visitedOwners: str[]
    var visitedNames: str[]
    var recognized = false
    var resolvedValue: int64
    let resolved = TypedExprCallConstIntValue(ctx.buildIndex,
                                               ownerSourcePath,
                                               textRaw,
                                               visitedOwners,
                                               visitedNames,
                                               recognized,
                                               resolvedValue)
    if !resolved:
        if recognized:
            panic(Fmt"typed expr: invalid fixed-array dimension const expression source={ownerSourcePath} text={textRaw}")
        return false
    if !recognized:
        return false
    if resolvedValue <= 0 || resolvedValue > Int64(2147483647):
        panic(Fmt"typed expr: fixed-array dimension out of range source={ownerSourcePath} text={textRaw} value={resolvedValue}")
    value = int32(resolvedValue)
    return true

@borrows
fn TypedExprIrFixedArrayTypeParts(ctx: TypedExprSourceContext,
                                   typeRaw: str,
                                   elemType: var str,
                                   length: var int32): bool =
    elemType = ""
    length = 0
    let typeText = TypedExprNormalizeTypeText(TypedExprStripVarType(typeRaw))
    if typeText.len <= 3 || typeText[typeText.len - 1] != ']':
        return false
    var openPos = -1
    for i in 0..<typeText.len:
        if typeText[i] == '[':
            openPos = i
    if openPos <= 0 || openPos + 1 >= typeText.len - 1:
        return false
    elemType = chengpath.PathTrim(chengpath.TextSlice(typeText, 0, openPos))
    if elemType == "":
        return false
    let lengthText = chengpath.PathTrim(chengpath.TextSlice(typeText,
                                                            openPos + 1,
                                                            typeText.len - 1 - (openPos + 1)))
    if lengthText == "":
        return false
    return TypedExprConstDimIntValue(ctx, lengthText, length)

# (707 解封) 符号维度定长数组类型文本规范化: `int32[maxBigIntLimbs]` →
# `int32[256]`。维度 const 属于类型定义模块的 const 块; 字段类型文本原样携带
# 符号名流出定义模块后, 使用方模块 ctx 的 const 解析必败, 下游全部文本消费者
# (RhsIndexElemType / IsFixedArray / TypeShapeFromText) 连锁 miss → rhsNodeIndex
# 建树被 badtype 拒 → bail 707 家族 (rsa.cheng:743 读 bigint.BigInt.limbs)。
# 调用点须持类型定义模块 (owner) 的 ctx。已是数字的维度原样返回 (零扰动);
# 其余维度复用唯一常量求值器并写成精确十进制值; 嵌套数组递归内层。
@borrows
fn TypedExprCanonicalizeFixedArrayDimText(ownerCtx: TypedExprSourceContext,
                                           typeRaw: str): str =
    let ownedTypeRaw = parser.ParserOwnedText(typeRaw)
    let typeText = parser.ParserOwnedText(TypedExprNormalizeTypeText(TypedExprStripVarType(ownedTypeRaw)))
    if typeText.len <= 3 || typeText[typeText.len - 1] != ']':
        return typeRaw
    var openPos = -1
    for i in 0..<typeText.len:
        if typeText[i] == '[':
            openPos = i
    if openPos <= 0 || openPos + 1 >= typeText.len - 1:
        return typeRaw
    let dimSlice = parser.ParserOwnedTextRange(typeText,
                                               openPos + 1,
                                               typeText.len - 1 - (openPos + 1))
    let elemSlice = parser.ParserOwnedTextRange(typeText, 0, openPos)
    let dimText = parser.ParserOwnedText(chengpath.PathTrim(dimSlice))
    if dimText == "":
        return typeRaw
    let elemRaw = parser.ParserOwnedText(chengpath.PathTrim(elemSlice))
    if elemRaw == "":
        return typeRaw
    var dimAllDigits = true
    for dimIndex in 0..<dimText.len:
        if dimText[dimIndex] < '0' || dimText[dimIndex] > '9':
            dimAllDigits = false
            break
    if dimAllDigits:
        # 数字维度本身零扰动; 仅内层元素类型可能仍带符号维度时重写。
        let numElemInner = parser.ParserOwnedText(TypedExprCanonicalizeFixedArrayDimText(ownerCtx, elemRaw))
        if numElemInner == elemRaw:
            return typeRaw
        return parser.ParserConcat4(numElemInner, "[", dimText, "]")
    var dimValue: int32
    if !TypedExprConstDimIntValue(ownerCtx, dimText, dimValue):
        return typeRaw
    let elemInner = parser.ParserOwnedText(TypedExprCanonicalizeFixedArrayDimText(ownerCtx, elemRaw))
    let dimValueText = parser.ParserOwnedText(IntToStr(dimValue))
    return parser.ParserConcat4(elemInner, "[", dimValueText, "]")

@borrows
fn TypedExprTypeTextIsFnPtr(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    return parser.ParserStartsWith(typeText, "fn(")

@borrows
fn TypedExprRejectStrNilLiteral(ctx: TypedExprSourceContext, lineNumber: int32) =
    # string_abi_contract.nil_compare.cstring_only=1 (docs/cheng-formal-spec.md
    # str-nil 语义稳定口径): str 的 = nil / == nil / != nil 编译期硬错误。
    # 与 bootstrap/cold_parser.c 的 cold_reject_str_nil 镜像同一条禁令 (两路
    # 检查点在源码上分离, 语义共享)。cstring (utf8/opaque ABI 类型) 不受影响。
    panic(strutil.Join([strings.CloneStr(ctx.sourcePath), ":", IntToStr(lineNumber),
                         " str nil is forbidden; use empty string \"\" or Len()==0"], ""))

@borrows
fn TypedExprIrTypeTextIsNilPtr(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(TypedExprStripVarType(share(typeRaw)))
    if typeText == "":
        return false
    if TypedExprTypeIsPointerLike(share(typeText)):
        return true
    if typeText.len > 0 && typeText[typeText.len - 1] == '*':
        return true
    return false

@borrows
fn TypedExprIrTypeTextIsNilPtrInContext(ctx: TypedExprSourceContext,
                                         sourceContexts: TypedExprSourceContext[],
                                         typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(TypedExprStripVarType(share(typeRaw)))
    if TypedExprIrTypeTextIsNilPtr(typeText):
        return true
    if typeText == "" || typeText == "str":
        return false
    if TypedExprPointerPointeeType(ctx, sourceContexts, share(typeText)) != "":
        return true
    if TypedExprTypeIsRefObjectInContext(ctx, sourceContexts, share(typeText)):
        return true
    # Function-pointer typedefs (`Name = fn(...)`) lower to a raw pointer slot,
    # so `Name == nil` is well-defined. Resolve the alias target and treat a
    # `fn(...)` shape as nil-comparable pointer form.
    if TypedExprTypeTextIsFnPtr(typeText):
        return true
    let aliasTarget = TypedExprLookupTypeAliasTargetInContext(ctx, sourceContexts, share(typeText))
    if aliasTarget != "" && aliasTarget != typeText && TypedExprTypeTextIsFnPtr(aliasTarget):
        return true
    return TypedExprAbiClassForTypeInContext(ctx, sourceContexts, share(typeText)) == TypedExprAbiPointerLike

@borrows
fn typedExprIrBuildSeqLiteralElemsRec(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        elemTexts: str[],
        elemTypeHint: str,
        elemIndex: int32,
        elemNodes: var int32[],
        elemType: var str): bool =
    while true:
        if elemIndex >= elemTexts.len:
            return true
        let elemText = chengpath.PathTrim(elemTexts[elemIndex])
        if elemText == "":
            return false
        let elemNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                      ctx,
                                                                      sourceContexts,
                                                                      share(scope),
                                                                      lineNumber,
                                                                      elemText,
                                                                      share(elemTypeHint))
        if elemNode < 0:
            return false
        let elemNodeTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[elemNode])
        var elemNodeType = ""
        if IsOk(elemNodeTypeRes):
            let enType_f59: str = Value(elemNodeTypeRes)
            elemNodeType = TypedExprNormalizeTypeText(TypedExprStripVarType(enType_f59))
        if elemNodeType == "" || elemNodeType == "unknown":
            return false
        if elemType == "":
            elemType = elemNodeType
        elif elemType != elemNodeType:
            return false
        add(elemNodes, elemNode)
        elemIndex = elemIndex + 1
        continue

@borrows
fn typedExprIrBuildSeqLiteralLinksRec(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        elemNodes: var int32[],
        linkIndex: int32,
        firstLink: var int32) =
    while true:
        if linkIndex < 0:
            return
        let elemSurfaceRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_surfaceTextIds[elemNodes[linkIndex]])
        let elemSurface = if IsOk(elemSurfaceRes): Value(elemSurfaceRes) else: ""
        firstLink = TypedExprIrAddRhsCallArgLinkNode(ir,
                                                     share(ctx.sourcePath),
                                                     share(scope.name),
                                                     lineNumber,
                                                     share(elemSurface),
                                                     elemNodes[linkIndex],
                                                     firstLink)
        linkIndex = linkIndex - 1
        continue

@borrows
fn TypedExprIrBuildSeqLiteralNode(ir: var TypedExprIr,
                                   ctx: var TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   scope: TypedExprFunctionScope,
                                   lineNumber: int32,
                                   textRaw: str,
                                   expectedTypeRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text.len < 3 || text[0] != '[' || text[text.len - 1] != ']':
        return -1
    let expectedType = TypedExprNormalizeTypeText(TypedExprStripVarType(expectedTypeRaw))
    var elemTypeHint = ""
    if TypedExprIrTypeTextIsSeq(expectedType):
        elemTypeHint = TypedExprIrRhsIndexElemType(ctx, expectedType)
    let innerText = TypedExprSliceTrim(text, 1, text.len - 2)
    if innerText == "":
        return -1
    let elemTexts = TypedExprSplitTopLevelCsv(innerText)
    if elemTexts.len <= 0:
        return -1
    var elemNodes: int32[]
    elemNodes = []
    var elemType = share(elemTypeHint)
    if !typedExprIrBuildSeqLiteralElemsRec(
           ir, ctx, sourceContexts, scope, lineNumber, elemTexts, elemTypeHint,
           0, elemNodes, elemType):
        return -1
    var elemSizeBytes: int32
    var elemAlignBytes: int32
    if elemType == "str":
        elemSizeBytes = 24
        elemAlignBytes = 8
    else:
        if !TypedExprTypeIsScalar(elemType) ||
           !TypedExprTypeLayout(ctx,
                                sourceContexts,
                                elemType,
                                elemSizeBytes,
                                elemAlignBytes):
            return -1
        if (elemSizeBytes != 1 && elemSizeBytes != 2 &&
            elemSizeBytes != 4 && elemSizeBytes != 8) ||
           elemAlignBytes <= 0 || elemAlignBytes > elemSizeBytes:
            return -1
    var firstLink: int32 = -1
    typedExprIrBuildSeqLiteralLinksRec(
        ir, ctx, scope, lineNumber, elemNodes, elemNodes.len - 1, firstLink)
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = share(ctx.sourcePath)
    node.functionName = share(scope.name)
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpSeqLiteral
    node.resultType = strutil.Join([share(elemType), "[]"], "")
    node.surfaceText = share(text)
    node.paramSlot = -1
    node.paramName = ""
    node.operand0NodeIndex = firstLink
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = elemType
    node.elemSizeBytes = elemSizeBytes
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrBuildContextualLiteralNode(ir: var TypedExprIr,
                                          ctx: var TypedExprSourceContext,
                                          sourceContexts: TypedExprSourceContext[],
                                          scope: TypedExprFunctionScope,
                                          lineNumber: int32,
                                          textRaw: str,
                                          expectedTypeRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    let expectedType = TypedExprNormalizeTypeText(TypedExprStripVarType(expectedTypeRaw))
    if text == "[]" && TypedExprIrTypeTextIsSeq(expectedType):
        return TypedExprIrAddRhsLeafNode(ir,
                                         share(ctx.sourcePath),
                                         share(scope.name),
                                         lineNumber,
                                         TypedExprIrOpEmptySeqInit,
                                         expectedType,
                                         "[]",
                                         "[]")
    if text.len > 2 && text[0] == '[' && text[text.len - 1] == ']':
        let seqLiteralNode = TypedExprIrBuildSeqLiteralNode(ir,
                                                            ctx,
                                                            sourceContexts,
                                                            share(scope),
                                                            lineNumber,
                                                            share(text),
                                                            share(expectedTypeRaw))
        if seqLiteralNode >= 0:
            return seqLiteralNode
    if text == "nil" && expectedType == "str":
        TypedExprRejectStrNilLiteral(ctx, lineNumber)
    if text == "nil" && TypedExprIrTypeTextIsNilPtrInContext(ctx, sourceContexts, expectedType):
        return TypedExprIrAddRhsLeafNode(ir,
                                         share(ctx.sourcePath),
                                         share(scope.name),
                                         lineNumber,
                                         TypedExprIrOpNilPtr,
                                         expectedType,
                                         "nil",
                                         "")
    if TypedExprIrRhsTextIsF64Literal(text) && expectedType == "float64":
        return TypedExprIrAddRhsLeafNode(ir,
                                         share(ctx.sourcePath),
                                         share(scope.name),
                                         lineNumber,
                                         TypedExprIrOpF64Const,
                                         "float64",
                                         share(text),
                                         text)
    return -1

@borrows
fn TypedExprIrAddTypedNilPtrNode(ir: var TypedExprIr,
                                  ctx: TypedExprSourceContext,
                                  sourceContexts: TypedExprSourceContext[],
                                  scope: TypedExprFunctionScope,
                                  lineNumber: int32,
                                  resultTypeRaw: str): int32 =
    let resultType = TypedExprNormalizeTypeText(TypedExprStripVarType(resultTypeRaw))
    if resultType == "str":
        TypedExprRejectStrNilLiteral(ctx, lineNumber)
    if !TypedExprIrTypeTextIsNilPtrInContext(ctx, sourceContexts, resultType):
        return -1
    return TypedExprIrAddRhsLeafNode(ir,
                                     ctx.sourcePath,
                                     scope.name,
                                     lineNumber,
                                     TypedExprIrOpNilPtr,
                                     resultType,
                                     "nil",
                                     "")

@borrows
fn TypedExprIrRhsIndexOpenPos(text: str): int32 =
    var parenDepth: int32
    var bracketDepth: int32
    for i in 0..<text.len:
        let piece = text[i]
        if piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '[':
            if parenDepth == 0 && bracketDepth == 0:
                return i
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
    return -1

@borrows
fn TypedExprIrRhsIndexElemType(ctx: TypedExprSourceContext,
                                baseTypeRaw: str): str =
    let baseType = TypedExprStripVarType(baseTypeRaw)
    if baseType == "str":
        return "char"
    if baseType == "Bytes" || baseType == "rawbytes.Bytes" || baseType == "bytes.Bytes":
        return "uint8"
    if baseType.len > 2 &&
       chengpath.TextSlice(baseType, baseType.len - 2, 2) == "[]":
        return chengpath.PathTrim(chengpath.TextSlice(baseType, 0, baseType.len - 2))
    if parser.ParserStartsWith(baseType, "seq[") &&
       baseType.len > 5 &&
       baseType[baseType.len - 1] == ']':
        return chengpath.PathTrim(chengpath.TextSlice(baseType, 4, baseType.len - 5))
    if TypedExprIrTypeTextIsFixedArray(ctx, baseType):
        var openPos = -1
        for i in 0..<baseType.len:
            if baseType[i] == '[':
                openPos = i
        if openPos > 0:
            return chengpath.PathTrim(chengpath.TextSlice(baseType, 0, openPos))
    return ""

@borrows
fn TypedExprIrRhsCmpOpKind(opText: str): TypedExprIrOpKind =
    if opText == "==":
        return TypedExprIrOpCmpEq
    if opText == "!=":
        return TypedExprIrOpCmpNe
    if opText == "<":
        return TypedExprIrOpCmpLt
    if opText == "<=":
        return TypedExprIrOpCmpLe
    if opText == ">":
        return TypedExprIrOpCmpGt
    if opText == ">=":
        return TypedExprIrOpCmpGe
    return TypedExprIrOpUnsupported

@borrows
fn TypedExprIrRhsArithOpKind(opText: str,
                              wide: bool,
                              unsigned: bool): TypedExprIrOpKind =
    if opText == "+":
        if wide:
            return TypedExprIrOpI64Add
        return TypedExprIrOpI32Add
    if opText == "-":
        if wide:
            return TypedExprIrOpI64Sub
        return TypedExprIrOpI32Sub
    if opText == "*":
        if wide:
            return TypedExprIrOpI64Mul
        return TypedExprIrOpI32Mul
    if opText == "/":
        if unsigned:
            if wide:
                return TypedExprIrOpI64Udiv
            return TypedExprIrOpI32Udiv
        if wide:
            return TypedExprIrOpI64Sdiv
        return TypedExprIrOpI32Sdiv
    if opText == "%":
        if unsigned:
            if wide:
                return TypedExprIrOpI64Umod
            return TypedExprIrOpI32Umod
        if wide:
            return TypedExprIrOpI64Mod
        return TypedExprIrOpI32Mod
    if opText == "&":
        if wide:
            return TypedExprIrOpI64BitAnd
        return TypedExprIrOpI32BitAnd
    if opText == "|":
        if wide:
            return TypedExprIrOpI64BitOr
        return TypedExprIrOpI32BitOr
    if opText == "^":
        if wide:
            return TypedExprIrOpI64BitXor
        return TypedExprIrOpI32BitXor
    if opText == "<<":
        if wide:
            return TypedExprIrOpI64Lsl
        return TypedExprIrOpI32Lsl
    if opText == ">>":
        if unsigned:
            if wide:
                return TypedExprIrOpI64Lsr
            return TypedExprIrOpI32Lsr
        if wide:
            return TypedExprIrOpI64Asr
        return TypedExprIrOpI32Asr
    return TypedExprIrOpUnsupported

@borrows
fn TypedExprIrRhsF64ArithOpKind(opText: str): TypedExprIrOpKind =
    if opText == "+":
        return TypedExprIrOpF64Add
    if opText == "-":
        return TypedExprIrOpF64Sub
    if opText == "*":
        return TypedExprIrOpF64Mul
    if opText == "/":
        return TypedExprIrOpF64Div
    return TypedExprIrOpUnsupported

@borrows
fn TypedExprIrRhsBinopResultMeta(lhsTypeRaw: str,
                                  rhsTypeRaw: str,
                                  level: int32,
                                  opText: str,
                                  opKindOut: var TypedExprIrOpKind,
                                  resultTypeOut: var str): bool =
    opKindOut = TypedExprIrOpUnsupported
    resultTypeOut = ""
    let lhsSurfaceType = TypedExprStripVarType(lhsTypeRaw)
    let rhsSurfaceType = TypedExprStripVarType(rhsTypeRaw)
    var lhsType = share(lhsSurfaceType)
    var rhsType = share(rhsSurfaceType)
    # char 在运行期即 int32 值(后端 OpCharLit/str 索引/int32() 转换全降为
    # LocalI32Tag),与 int32 混算/比较合法。把 char 归一到 int32 让
    # int32(ch) >= 数字字面量、ch == 下划线 等比较条件建出节点(否则 char 异于
    # int32,level==2 类型不匹配门拒绝 → if_cond no_node)。
    if lhsType == "char":
        lhsType = "int32"
    if rhsType == "char":
        rhsType = "int32"
    if lhsType == "" || rhsType == "":
        return false
    let intMix = (lhsType == "int32" && rhsType == "int64") ||
                 (lhsType == "int64" && rhsType == "int32")
    if level == 0 || level == 1:
        if lhsType != "bool" || rhsType != "bool":
            return false
        if level == 0:
            opKindOut = TypedExprIrOpLogOr
        else:
            opKindOut = TypedExprIrOpLogAnd
        resultTypeOut = "bool"
        return true
    if level == 5 || level == 6:
        if lhsType != rhsType && !intMix:
            return false
        opKindOut = TypedExprIrRhsCmpOpKind(opText)
        if opKindOut == TypedExprIrOpUnsupported:
            return false
        resultTypeOut = "bool"
        return true
    if lhsType == "float64" && rhsType == "float64":
        opKindOut = TypedExprIrRhsF64ArithOpKind(opText)
        if opKindOut == TypedExprIrOpUnsupported:
            return false
        resultTypeOut = "float64"
        return true
    # Width follows the binding-type classifier: unsigned operands normalize to
    # the matching signed width (uint32->int32, uint64->int64). Signed and
    # unsigned ops are bit-identical for + - * & | ^ << so they route through the
    # shared op kinds. Division/modulo/arithmetic-shift-right (/ % >>) differ for
    # unsigned (need Udiv/Umod/Lsr which the leaf set does not carry), so those
    # stay unbuilt when any operand is unsigned rather than emitting a signed op.
    let lhsUnsigned = lhsType == "uint32" || lhsType == "uint64" || lhsType == "uint"
    let rhsUnsigned = rhsType == "uint32" || rhsType == "uint64" || rhsType == "uint"
    let anyUnsigned = lhsUnsigned || rhsUnsigned
    # int8/uint8/int16/uint16 操作数(如 ch: uint8 参与 `ch - uint8('0')`)此前不在
    # lhsIntLike/rhsIntLike 判定内,两侧都落空 → return false → 调用方把整个 BinOp
    # 节点标记 TypedExprIrOpUnsupported → node-eval 探针见 op=unsupported 回落文本
    # 路径(T46 定谳: debug_parse_i32_field:168 `out = out*10+int32(ch-uint8('0'))`
    # node_eval_miss 复合 cast 触发 fill_blocks_fail)。这些窄类型零扩展到 int32 后,
    # + - * & | ^ << 与 signed int32 语义位等价(不下放到 lhsUnsigned/rhsUnsigned
    # 的 Udiv/Umod/Lsr 无符号专用桶——窄类型零扩展后取值范围全落在 int32 非负区间,
    # 有符号 int32 除法/取模/算术右移与无符号版本结果恒等,故按 signed int32 走全
    # 部算符即正确,不需要窄类型专属的无符号 op kind)。
    let lhsNarrowInt = lhsType == "int8" || lhsType == "uint8" ||
                       lhsType == "int16" || lhsType == "uint16"
    let rhsNarrowInt = rhsType == "int8" || rhsType == "uint8" ||
                       rhsType == "int16" || rhsType == "uint16"
    let lhsIntLike = lhsType == "int32" || lhsType == "int64" || lhsType == "int" ||
                     lhsUnsigned || lhsNarrowInt
    let rhsIntLike = rhsType == "int32" || rhsType == "int64" || rhsType == "int" ||
                     rhsUnsigned || rhsNarrowInt
    let lhsWide = lhsType == "int64" || lhsType == "uint64"
    let rhsWide = rhsType == "int64" || rhsType == "uint64"
    # The formal shift result type is exactly the left operand type; the right
    # operand contributes only the shift count.  Physical lowering still uses
    # the I32/I64 op family, while signedness of `>>` is selected solely from
    # the left operand.  This keeps overload selection and value IR aligned for
    # cases such as `uint32(1) << int64(3)`.
    if opText == "<<" || opText == ">>":
        let lhsShiftInteger = lhsSurfaceType == "int8" || lhsSurfaceType == "uint8" ||
                              lhsSurfaceType == "int16" || lhsSurfaceType == "uint16" ||
                              lhsSurfaceType == "int32" || lhsSurfaceType == "uint32" ||
                              lhsSurfaceType == "int64" || lhsSurfaceType == "uint64" ||
                              lhsSurfaceType == "int" || lhsSurfaceType == "uint"
        let rhsShiftInteger = rhsSurfaceType == "int8" || rhsSurfaceType == "uint8" ||
                              rhsSurfaceType == "int16" || rhsSurfaceType == "uint16" ||
                              rhsSurfaceType == "int32" || rhsSurfaceType == "uint32" ||
                              rhsSurfaceType == "int64" || rhsSurfaceType == "uint64" ||
                              rhsSurfaceType == "int" || rhsSurfaceType == "uint"
        if !lhsShiftInteger || !rhsShiftInteger:
            return false
        opKindOut = TypedExprIrRhsArithOpKind(opText,
                                              lhsWide,
                                              lhsUnsigned)
        if opKindOut == TypedExprIrOpUnsupported:
            return false
        resultTypeOut = lhsSurfaceType
        return true
    var width = ""
    if lhsIntLike && rhsIntLike:
        if lhsWide || rhsWide:
            width = "int64"
        else:
            width = "int32"
    elif intMix:
        width = "int64"
    else:
        return false
    let resultWide = width == "int64"
    opKindOut = TypedExprIrRhsArithOpKind(opText, resultWide, anyUnsigned)
    if opKindOut == TypedExprIrOpUnsupported:
        return false
    # 无符号算术结果保留无符号宽度,使下游比较(`a + b >= a`、
    # `value % uint64(4) != uint64(0)`、`off + i >= uint64(buf.len)`)在 level==2
    # 相等门看到匹配的无符号操作数类型而建出 cmp 节点,后端据操作数 resultType
    # 选无符号条件码(hi/hs/lo/ls)。op kind 已编码无符号操作(Udiv/Umod/Lsr;
    # + - * & | ^ << 位等价),故只需保留结果类型的符号性,槽/codegen 形态不变
    # (uint32->I32, uint64->I64)。混合 signed/unsigned 仍按 signed(行为不变)。
    resultTypeOut = width
    if lhsUnsigned && rhsUnsigned:
        if resultWide:
            resultTypeOut = "uint64"
        else:
            resultTypeOut = "uint32"
    elif resultWide && (lhsType == "uint64" || rhsType == "uint64"):
        # 64 位结果且有 uint64 操作数:uint64 秩最高,按 C 通常算术转换 uint64+intN
        # 结果为 uint64(如 off:uint64 + i:int32 的循环索引)。否则原"混合按 signed"
        # 把它算成 int64,致下游 `off + i >= uint64(buf.len)` 在 level==2 相等门
        # int64≠uint64 被拒 → if_cond no_node。仅最宽 uint64 触发(uint32+int64 仍
        # int64:int64 更宽可容 uint32,不破窄混型语义);+ - * & | ^ << 位等价,
        # codegen 不变,仅结果类型转无符号让下游比较选无符号条件码(#34 已修)。
        resultTypeOut = "uint64"
    return true

@borrows
fn TypedExprIrAddRhsLeafNode(ir: var TypedExprIr,
                              sourcePath: str,
                              functionName: str,
                              lineNumber: int32,
                              opKind: TypedExprIrOpKind,
                              resultType: str,
                              surfaceText: str,
                              literalText: str): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = opKind
    node.resultType = resultType
    node.surfaceText = surfaceText
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = literalText
    typedExprIrBindNodeStructuralType(
        ir,
        node,
        typedExprIrReservedScalarTypeIdForRuntimeType(ir, node.resultType))
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrAddFuncRefNode(ir: var TypedExprIr,
                              sourcePath: str,
                              functionName: str,
                              lineNumber: int32,
                              surfaceText: str,
                              callDeclarationRow: int32): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpFuncRef
    node.resultType = "ptr"
    node.surfaceText = surfaceText
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    # The spelling is retained for diagnostics only. The immutable identity is
    # the domain-qualified CallDeclaration row published below.
    node.literalText = surfaceText
    node.funcRefTargetDomain =
        Int32(TypedExprFuncRefTargetDomainCallDeclaration)
    node.funcRefCallDeclarationRow = callDeclarationRow
    # [op79] FuncRef(&FunctionName) 与 AddrOf(&place) 同家族: resultType 恒
    # "ptr", reserved 标量文本表无此项; 权威 TypeId 由同一拼写 ptr 行读路由
    # (typedExprIrAddrOfPointerStructuralTypeId)供给, 即 op73 读路由臂按
    # opKind==FuncRef 铸造点的一行级扩展。fail-closed 逐层保留: arena 未绑
    # / 行不存在 -> -1, bind 对 -1 是 no-op, exact producer TypeId 权威门
    # 原样 hard-fail, 零弱化。
    var funcRefStructuralTypeId: int32 = -1
    if ir.exactTypeArena != nil && ir.valueDefinitionTypeArenaBound:
        funcRefStructuralTypeId =
            typedExprIrAddrOfPointerStructuralTypeId(ir.exactTypeArena)
    typedExprIrBindNodeStructuralType(ir, node, funcRefStructuralTypeId)
    return TypedExprIrAddNode(ir, node)

# Desugared leaf built outside any parser value-expression origin (e.g. bare
# `var n: int32` zero-init, which is semantically `n = 0` with no source
# literal): the origin stack fallback in TypedExprIrAppendNode cannot prove
# provenance, so the node carries its synthetic proof explicitly.
fn TypedExprIrAddDesugaredLeafNode(ir: var TypedExprIr,
                                   sourcePath: str,
                                   functionName: str,
                                   lineNumber: int32,
                                   opKind: TypedExprIrOpKind,
                                   resultType: str,
                                   surfaceText: str,
                                   literalText: str): int32 =
    var node: TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginDesugared
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = opKind
    # [stage0-W3] 裸零值声明叶(int64/bool/str 等臂)必须与
    # TypedExprIrAddI32ConstNode(:15436) 同源发布 exact structural TypeId,
    # 否则 value-definition 守卫(:6085 exactTypeId<0)炸 :6097。非标量文本
    # (如 EmptySeqInit 的 数组形)返回 -1, bind 对 -1 是 no-op, 行为不变。
    # [windowline-w3fix 2026-09-16] 消费序修正: bind 只写 type-proof 字段
    # (不读 node.resultType), 且 ForText 只借读 resultType —— 必须置于
    # `node.resultType = resultType` 移动之前, 否则 C 链判 use of consumed
    # managed value (首轮一烤实证 kd_windowline)。语义逐位不变。
    typedExprIrBindNodeStructuralType(
        ir,
        node,
        typearena.TypedExprTypeArenaReservedScalarTypeIdForText(
            ir.exactTypeArena, resultType))
    node.resultType = resultType
    node.surfaceText = surfaceText
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = literalText
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrAddRhsScalarLeafNode(
        ir: var TypedExprIr,
        sourcePath: str,
        functionName: str,
        lineNumber: int32,
        opKind: TypedExprIrOpKind,
        resultType: str,
        surfaceText: str,
        literalText: str,
        semanticScalarKind:
            typearena.TypedExprStructuralScalarKind): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = opKind
    node.resultType = resultType
    if semanticScalarKind !=
           typearena.TypedExprStructuralScalarInvalid:
        typedExprIrBindNodeStructuralType(
            ir,
            node,
            typedExprIrReservedScalarTypeId(
                ir, semanticScalarKind))
    node.surfaceText = surfaceText
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = literalText
    return TypedExprIrAddNode(ir, node)

# [wall43] 文本路径 LocalRef 的结构 TypeId 模板解析。赋值 LHS 文本路径
# (TypedExprIrBuildRhsIdentNode)经 TypedExprIrAddRhsLocalRefNode 发布的
# LocalRef 此前是 LocalRef 生产者中唯一不发布 structuralTypeId 的拼写:
# exact 读走 typedExprIrAddExactBindingRefNode 克隆 decl-local 组 defining
# 节点列(已绑), 参数 ident 走参数索引快路径(已绑), 唯 local ident 落穿
# 本生产者 → -1。compiler csg typed-node 权威门对全节点要求 exact TypeId,
# 该形状必死(kernel_driver_w40 编 v6: main `n = new(Node)` LHS node=57
# op=38 实证)。修法 = wall31 模板克隆范本: 模板 = 同名 decl-local 组
# (ParserDeclarationLocal + 当前 parser function row + Declaration
# introduction + 名字 token 唯一命中, TypedExprIrConsumeDeclarationLocal
# ValueDefinition 同一坐标系)的 value-definition defining 节点 —— 裸
# `var n: Node` 即 w24 NilPtr 零值模板、`var x: int32` 即 I32Const 零值、
# seq/str 同族零值臂, 均经 typedExprIrBindNodeStructuralType 绑定, 且该列
# 已被 seal 审计与 valueDefinitions_exactTypeIds 逐行互证。克隆前比对模板
# resultType 文本与本节点 resultType: 不等一律 -1(循环变量同名单穿等
# 非本绑定形状绝不误绑), 保证克隆列恒精确描述节点自身类型。
# fail-closed: 无 tree lease / arena 未绑 / 函数行未定 / 组未注册或未消费 /
# defining 节点越界 / TypeId 列 -1 → bind 对 -1 是 no-op, 列原样保持 -1,
# 下游 exact producer TypeId 权威门原样 hard-fail, 零弱化; treeless 会话
# (无 lease)行为逐字节不变。
@borrows
fn typedExprIrDeclarationLocalTemplateStructuralTypeId(
        ir: var TypedExprIr,
        name: str,
        resultType: str): int32 =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil ||
       ir.exactTypeArena == nil || !ir.valueDefinitionTypeArenaBound ||
       ir.valueExprCurrentParserFunctionRow < 0:
        return -1
    let bindingName = parser.ParserIdentPrefix(chengpath.PathTrim(name))
    if bindingName == "":
        return -1
    let tree = ir.valueExprTree
    if ir.valueExprTransactionDeclarationLocalGroupRows.len !=
           tree.declarationCount:
        return -1
    var hits: int32
    var foundDeclarationRow: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationLocal):
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationFunctionRows,
               declarationRow) !=
               ir.valueExprCurrentParserFunctionRow:
            continue
        if typedExprIrDeclarationIntroductionKind(tree, declarationRow) !=
               parser.ParserLexicalBindingIntroductionDeclaration:
            continue
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        if parser.ParserValueExprTokenText(tree, nameToken) != bindingName:
            continue
        hits = hits + 1
        foundDeclarationRow = declarationRow
    if hits != 1 || foundDeclarationRow < 0:
        return -1
    let groupRow =
        ir.valueExprTransactionDeclarationLocalGroupRows[foundDeclarationRow]
    if groupRow < ir.valueExprTransactionDefinitionGroupStart ||
       groupRow >= TypedExprValueDefinitionGroupAuthorityCount(ir):
        return -1
    if arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_typedFunctionIndexes,
           groupRow) != ir.functions2_functionNameIds.len:
        return -1
    let definitionRow = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueDefinitionGroups_definitionRows,
        groupRow)
    if definitionRow < 0 ||
       definitionRow >= TypedExprValueDefinitionAuthorityCount(ir):
        return -1
    let templateNodeIndex = TypedExprValueDefinitionDefiningTypedNodeIndexAt(
        ir, definitionRow)
    if templateNodeIndex < 0 ||
       templateNodeIndex >= ir.nodes2_nodeIndexs.len:
        return -1
    let templateTypeId = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_structuralTypeIds,
        templateNodeIndex)
    if templateTypeId < 0:
        return -1
    let templateTypeResult: Result[str] = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_resultTypeIds[templateNodeIndex])
    if !IsOk(templateTypeResult) || Value(templateTypeResult) != resultType:
        return -1
    return templateTypeId

# [op38] 文本路径 LocalRef 的结构 TypeId 第二臂: Initializer-introduction
# 声明(var a: I32 = new(I32) 族)的读。wall43 模板(上一函数)只认
# Declaration-introduction, 而 decl-local 组注册与消费同一断言, Initializer
# 形既无组也无 defining 节点, 其声明行的权威 TypeId 载体是语句孪生:
# LetCall/LocalDecl 语句的 rhsNodeIndex 是该行绑定值的生产者节点
# (TypedExprIrAddCallStatement -> TypedExprIrBuildStatementCallRoot exact
# 返回 TypeId / TypeArena new 臂绑定; repair -> BuildStatementValueRoot),
# 且每条语句追加时经 TypedExprStatementFunctionIndexRegister 登入
# (functionName, bindingName) 索引。坐标系: 树侧锚(ParserDeclarationLocal +
# 当前 parser 函数行 + Initializer introduction + 名字 token 唯一命中)证明
# 读名是本函数的初始化局部; 语句侧锚(sourcePath+functionName+bindingName
# 等值复验 + LetCall 须 BindingInitializer role(赋值 LetCall 同名排除) +
# 行严格先于读行)唯一命中后克隆其 rhs 节点 structuralTypeId。克隆前比对
# 语句 resultType 列(经 Normalize+RuntimeScalarType 归一化, 与 wall43
# resultType 文本比对同一归一化空间)与本节点 resultType: 不等一律 -1。
# fail-closed: 无 tree lease / arena 未绑 / 函数行未定 / 树锚不唯一 /
# 语句锚不唯一 / rhs 越界 / TypeId 列 -1 -> 返回 -1, bind 对 -1 是 no-op,
# 下游 exact producer TypeId 权威门原样 hard-fail, 零弱化。
@borrows
fn typedExprIrInitializerStatementTemplateStructuralTypeId(
        ir: var TypedExprIr,
        sourcePath: str,
        functionName: str,
        lineNumber: int32,
        name: str,
        resultType: str): int32 =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil ||
       ir.exactTypeArena == nil || !ir.valueDefinitionTypeArenaBound ||
       ir.valueExprCurrentParserFunctionRow < 0:
        return -1
    let bindingName = parser.ParserIdentPrefix(chengpath.PathTrim(name))
    if bindingName == "":
        return -1
    let tree = ir.valueExprTree
    if ir.valueExprTransactionDeclarationLocalGroupRows.len !=
           tree.declarationCount:
        return -1
    var declarationHits: int32
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationLocal):
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationFunctionRows,
               declarationRow) !=
               ir.valueExprCurrentParserFunctionRow:
            continue
        if typedExprIrDeclarationIntroductionKind(tree, declarationRow) !=
               parser.ParserLexicalBindingIntroductionInitializer:
            continue
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        if parser.ParserValueExprTokenText(tree, nameToken) != bindingName:
            continue
        declarationHits = declarationHits + 1
    if declarationHits != 1:
        return -1
    if ir.statementFnBindingIndexBucketHeads.len <= 0:
        return -1
    let bindingBucket = TypedExprStatementFnBindingIndexHash(
        functionName,
        bindingName,
        ir.statementFnBindingIndexBucketHeads.len)
    if bindingBucket < 0:
        return -1
    var statementHits: int32
    var templateNodeIndex: int32 = -1
    var entryIndex = ir.statementFnBindingIndexBucketHeads[bindingBucket]
    while entryIndex >= 0:
        if ir.statementFnBindingIndexEntryFunctionNames[entryIndex] ==
               functionName &&
           ir.statementFnBindingIndexEntryBindingNames[entryIndex] ==
               bindingName:
            let stmtIndex =
                ir.statementFnBindingIndexEntryStatementIndexes[entryIndex]
            if stmtIndex >= 0 &&
               stmtIndex < ir.statements2_statementIndexs.len:
                let stmtSourceRes: Result[str] = langintern.LookupIntern(
                    ir.internPool,
                    ir.statements2_sourcePathIds[stmtIndex])
                let stmtFunctionRes: Result[str] = langintern.LookupIntern(
                    ir.internPool,
                    ir.statements2_functionNameIds[stmtIndex])
                let stmtBindingRes: Result[str] = langintern.LookupIntern(
                    ir.internPool,
                    ir.statements2_bindingNameIds[stmtIndex])
                let stmtKind = ir.statements2_kinds[stmtIndex]
                let stmtRole = arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.statements2_valueExprStatementRoles,
                    stmtIndex)
                if IsOk(stmtSourceRes) && IsOk(stmtFunctionRes) &&
                   IsOk(stmtBindingRes) &&
                   Value(stmtSourceRes) == sourcePath &&
                   Value(stmtFunctionRes) == functionName &&
                   Value(stmtBindingRes) == bindingName &&
                   (stmtKind == TypedExprIrStmtLocalDecl ||
                    (stmtKind == TypedExprIrStmtLetCall &&
                     stmtRole ==
                         Int32(parser.ParserValueExprStatementBindingInitializer))):
                    let stmtLine = arenamod.ArenaArrayInt32Get(
                        ir.arena,
                        ir.statements2_lineNumbers,
                        stmtIndex)
                    if stmtLine >= 0 && stmtLine < lineNumber:
                        let rhsNodeIndex = arenamod.ArenaArrayInt32Get(
                            ir.arena,
                            ir.statements2_rhsNodeIndexs,
                            stmtIndex)
                        if rhsNodeIndex >= 0 &&
                           rhsNodeIndex < ir.nodes2_nodeIndexs.len:
                            let rhsTypeId = arenamod.ArenaArrayInt32Get(
                                ir.arena,
                                ir.nodes2_structuralTypeIds,
                                rhsNodeIndex)
                            if rhsTypeId >= 0:
                                let stmtTypeRes: Result[str] =
                                    langintern.LookupIntern(
                                        ir.internPool,
                                        ir.statements2_resultTypeIds[
                                            stmtIndex])
                                if IsOk(stmtTypeRes):
                                    let stmtTypeText =
                                        TypedExprIrRuntimeScalarType(
                                            ir,
                                            sourcePath,
                                            TypedExprNormalizeTypeText(
                                                Value(stmtTypeRes)))
                                    if stmtTypeText == resultType:
                                        statementHits = statementHits + 1
                                        templateNodeIndex = rhsNodeIndex
        entryIndex = ir.statementFnBindingIndexEntryNext[entryIndex]
    if statementHits != 1 || templateNodeIndex < 0:
        return -1
    return arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_structuralTypeIds,
        templateNodeIndex)

# [wall78] 赋值语句 LHS 绑定目标定义行读回（wall72 语句级列契约的赋值端
# 供给补全，wall74 移交 2）。plain assign 的 LHS 文本无 identifier 节点
# （w31/w70 契约，lvalue 构建窗口内节点被去起源化），绑定目标声明组的
# 定义行只能从组权威表读回：坐标系与 TypedExprIrConsumeDeclarationLocal
# ValueDefinition / wall43 模板解析完全同源（ParserDeclarationLocal +
# 当前 parser function row + Declaration introduction + 名字 token 唯一
# 命中 → decl-local 组 → definitionRows）。唯一命中、组归属当前函数且已
# 消费才返回该行；任何一格不满足（treeless、参数/全局、字段/下标 LHS、
# 同名歧义、组未消费）一律 -1，列保持 -1，primary 行守卫原样 hard-fail
# ——零弱化，歧义名绝不猜绑。
@borrows
fn typedExprIrAssignBindingTargetDefinitionRow(
        ir: TypedExprIr,
        lhsText: str): int32 =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil:
        return -1
    let trimmedLhs = chengpath.PathTrim(lhsText)
    let bindingName = parser.ParserIdentPrefix(trimmedLhs)
    if bindingName == "" || bindingName != trimmedLhs:
        return -1
    let tree = ir.valueExprTree
    if ir.valueExprCurrentParserFunctionRow < 0 ||
       ir.valueExprTransactionDeclarationLocalGroupRows.len !=
           tree.declarationCount:
        return -1
    var hits: int32
    var foundDeclarationRow: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        let declarationKind = parser.ParserDeclarationKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationKinds,
                declarationRow))
        if declarationKind != parser.ParserDeclarationParameter &&
           declarationKind != parser.ParserDeclarationLocal:
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationFunctionRows,
               declarationRow) !=
               ir.valueExprCurrentParserFunctionRow:
            continue
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        if parser.ParserValueExprTokenText(tree, nameToken) != bindingName:
            continue
        hits = hits + 1
        if declarationKind == parser.ParserDeclarationLocal &&
           typedExprIrDeclarationIntroductionKind(tree, declarationRow) ==
               parser.ParserLexicalBindingIntroductionDeclaration:
            foundDeclarationRow = declarationRow
    # 值命名空间（Parameter/Local）同名声明必须恰 1 且为 Declaration
    # introduction 的 decl-local：内层 Initializer/迭代绑定遮蔽、参数遮蔽
    # 等任何同名族一律 -1（文本 LHS 无作用域坐标，宁可 fail-closed 也不
    # 误绑外层组行）。
    if hits != 1 || foundDeclarationRow < 0:
        return -1
    let groupRow =
        ir.valueExprTransactionDeclarationLocalGroupRows[foundDeclarationRow]
    if groupRow < ir.valueExprTransactionDefinitionGroupStart ||
       groupRow >= TypedExprValueDefinitionGroupAuthorityCount(ir):
        return -1
    if arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_typedFunctionIndexes,
           groupRow) != ir.functions2_functionNameIds.len:
        return -1
    let definitionRow = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueDefinitionGroups_definitionRows,
        groupRow)
    if definitionRow < 0 ||
       definitionRow >= TypedExprValueDefinitionAuthorityCount(ir):
        return -1
    return definitionRow

fn TypedExprIrAddRhsLocalRefNode(ir: var TypedExprIr,
                                  sourcePath: str,
                                  functionName: str,
                                  lineNumber: int32,
                                  name: str,
                                  resultType: str): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    # [op38] Initializer-introduction 第二臂解析必须先于 sourcePath/
    # functionName 的 move(@borrows 借读, 不消费调用方所有权); wall43 臂
    # miss 时才在下方钩子消费其结果。
    let op38InitializerTemplateTypeId =
        typedExprIrInitializerStatementTemplateStructuralTypeId(
            ir, sourcePath, functionName, lineNumber, name, resultType)
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpLocalRef
    # [wall43] local 绑定读发布其 decl-local 组 defining 节点的精确结构
    # TypeId(producer freezes, csg never derives); 查找不可得时 -1 原样,
    # bind 对 -1 是 no-op, 权威门原样兜底。必须在 resultType/name move 入
    # 节点列之前解析(@borrows 借读, 不消费调用方所有权)。
    let wall43TemplateTypeId =
        typedExprIrDeclarationLocalTemplateStructuralTypeId(
            ir, name, resultType)
    var localRefTemplateTypeId = wall43TemplateTypeId
    if localRefTemplateTypeId < 0:
        # [op38] Initializer-introduction 声明(var a: I32 = new(I32) 族)
        # 在 wall43 模板无资格(其查找只认 Declaration-introduction), 无
        # decl-local 组权威可克隆; 消费上方已解析的语句孪生臂结果, 任何
        # 锚不满足仍 -1 原样, 权威门零弱化。
        localRefTemplateTypeId = op38InitializerTemplateTypeId
    node.resultType = resultType
    typedExprIrBindNodeStructuralType(ir, node, localRefTemplateTypeId)
    node.surfaceText = share(name)
    node.paramSlot = -1
    node.paramName = name
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    return TypedExprIrAddNode(ir, node)

# Exact structural TypeId publication for FieldGet rhs nodes — the same
# family spelling TypedExprIrAddRhsIndexGetNode already follows: the producer
# freezes the authority column, compiler csg only cross-checks it against the
# exact field declaration authority and never derives it. Non-builtin fields
# resolve through the exact TypeArena symbol member table (the frozen table
# compiler csg's declaration route is itself cross-checked against, so both
# routes agree by construction; the base node TypeId is peeled to its physical
# owner exactly like the csg owner-side physical equality check). Builtin
# fields resolve through the reserved scalar families the exact layout builtin
# arm admits (str: data=CString len/storeId/flags=int32; sequence:
# len/cap=int32 buffer=CString; optional: has=bool value=child). A -1 result
# (base node not yet bound / coordinates not derivable) leaves the column
# unset for the downstream exact producer TypeId authority gate, which stays
# the single hard-fail authority for this node class.
@borrows
fn typedExprIrFieldGetBuiltinStructuralTypeId(
        arena: typearena.TypedExprTypeArena,
        ownerTypeId: int32,
        fieldOrdinal: int32,
        fieldBuiltinKind: int32): int32 =
    if fieldOrdinal < 0:
        return -1
    let ownerKind = typearena.TypedExprTypeArenaKindAt(
        arena, ownerTypeId)
    if fieldBuiltinKind == Int32(TypedExprLayoutBuiltinStr):
        if ownerKind != typearena.TypedExprStructuralTypeScalar ||
           typearena.TypedExprStructuralScalarKind(
               arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.scalarKinds,
                   ownerTypeId)) !=
               typearena.TypedExprStructuralScalarStr:
            return -1
        if fieldOrdinal == 0:
            return typearena.TypedExprTypeArenaReservedScalarTypeId(
                arena,
                typearena.TypedExprStructuralScalarCString)
        if fieldOrdinal >= 1 && fieldOrdinal <= 3:
            return typearena.TypedExprTypeArenaReservedScalarTypeId(
                arena,
                typearena.TypedExprStructuralScalarInt32)
        return -1
    if fieldBuiltinKind == Int32(TypedExprLayoutBuiltinSequence):
        if ownerKind != typearena.TypedExprStructuralTypeSequence:
            return -1
        if fieldOrdinal == 0 || fieldOrdinal == 1:
            return typearena.TypedExprTypeArenaReservedScalarTypeId(
                arena,
                typearena.TypedExprStructuralScalarInt32)
        if fieldOrdinal == 2:
            return typearena.TypedExprTypeArenaReservedScalarTypeId(
                arena,
                typearena.TypedExprStructuralScalarCString)
        return -1
    if fieldBuiltinKind == Int32(TypedExprLayoutBuiltinOptional):
        if ownerKind != typearena.TypedExprStructuralTypeOptional:
            return -1
        if fieldOrdinal == 0:
            return typearena.TypedExprTypeArenaReservedScalarTypeId(
                arena,
                typearena.TypedExprStructuralScalarBool)
        if fieldOrdinal == 1:
            let childCount = arenamod.ArenaArrayInt32Get(
                arena.arena, arena.childCounts, ownerTypeId)
            if childCount != 1:
                return -1
            let childStart = arenamod.ArenaArrayInt32Get(
                arena.arena, arena.childStarts, ownerTypeId)
            let childTypeId = arenamod.ArenaArrayInt32Get(
                arena.arena, arena.childTypeIds, childStart)
            if childTypeId < 0 ||
               childTypeId >=
                   typearena.TypedExprTypeArenaTypeCount(arena):
                return -1
            return childTypeId
        return -1
    return -1

@borrows
fn typedExprIrFieldGetExactStructuralTypeId(
        arena: typearena.TypedExprTypeArena,
        baseTypeId: int32,
        fieldProducerSourceIndex: int32,
        fieldOrdinal: int32,
        fieldBuiltinKind: int32): int32 =
    if arena == nil || baseTypeId < 0:
        return -1
    let typeCount = typearena.TypedExprTypeArenaTypeCount(arena)
    var ownerTypeId = baseTypeId
    var ownerSymbolId: int32 = -1
    var visited: int32
    while true:
        if ownerTypeId < 0 || ownerTypeId >= typeCount ||
           visited > typeCount:
            return -1
        let ownerKind = typearena.TypedExprTypeArenaKindAt(
            arena, ownerTypeId)
        # [phaseB-csg] chase 链上最近声明 symbol 携带：alias(Tuple) 声明根
        # 的 member 行挂在 alias symbol 上（memberDeclarationSymbolIds 与
        # 之同源），而 chase 落点的 tuple 子类型 symbolId 恒为 -1；member
        # 查询必须使用链上最近的有效 symbolId，否则 alias 包装聚合
        # （`type N = tuple[...]`）的字段读取在此 miss。链上无有效 symbol
        # 时保持 -1 的 fail-closed 语义。
        let chaseSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
            arena, ownerTypeId)
        if chaseSymbolId >= 0:
            ownerSymbolId = chaseSymbolId
        if ownerKind == typearena.TypedExprStructuralTypeAlias ||
           ownerKind == typearena.TypedExprStructuralTypeApply ||
           ownerKind == typearena.TypedExprStructuralTypeBorrow:
            let childCount = arenamod.ArenaArrayInt32Get(
                arena.arena, arena.childCounts, ownerTypeId)
            if childCount <= 0:
                return -1
            let childStart = arenamod.ArenaArrayInt32Get(
                arena.arena, arena.childStarts, ownerTypeId)
            ownerTypeId = arenamod.ArenaArrayInt32Get(
                arena.arena, arena.childTypeIds, childStart)
            visited = visited + 1
            continue
        if fieldBuiltinKind != Int32(TypedExprLayoutBuiltinNone):
            return typedExprIrFieldGetBuiltinStructuralTypeId(
                arena, ownerTypeId, fieldOrdinal, fieldBuiltinKind)
        let symbolId = ownerSymbolId
        if symbolId < 0:
            return -1
        let memberStart = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.symbolMemberStarts, symbolId)
        let memberCount = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.symbolMemberCounts, symbolId)
        if memberStart < 0 || fieldOrdinal < 0 ||
           fieldOrdinal >= memberCount:
            return -1
        let memberRow = memberStart + fieldOrdinal
        if arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.memberProducerSourceIndexes,
               memberRow) != fieldProducerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.memberDeclarationSymbolIds,
               memberRow) != symbolId ||
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.memberOrdinals,
               memberRow) != fieldOrdinal:
            return -1
        let memberTypeId = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.memberTypeIds, memberRow)
        if memberTypeId < 0 || memberTypeId >= typeCount:
            return -1
        return memberTypeId

fn TypedExprIrAddRhsFieldGetNode(ir: var TypedExprIr,
                                  sourcePath: str,
                                  functionName: str,
                                  lineNumber: int32,
                                  surfaceText: str,
                                  fieldName: str,
                                  resultType: str,
                                  fieldTypeSourcePath: str,
                                  baseNode: int32,
                                  offsetBytes: int32,
                                  sizeBytes: int32,
                                  alignBytes: int32,
                                  fieldProducerSourceIndex: int32,
                                  fieldOwnerDeclarationSourceLocalRow: int32,
                                  fieldDeclarationSourceLocalRow: int32,
                                  fieldOrdinal: int32,
                                  fieldBuiltinKind: int32): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpFieldGet
    node.resultType = resultType
    node.surfaceText = surfaceText
    node.paramSlot = -1
    node.operand0NodeIndex = baseNode
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = fieldName
    node.fieldTypeSourcePath = fieldTypeSourcePath
    node.fieldOffsetBytes = offsetBytes
    node.fieldSizeBytes = sizeBytes
    node.fieldAlignBytes = alignBytes
    node.fieldProducerSourceIndex = fieldProducerSourceIndex
    node.fieldOwnerDeclarationSourceLocalRow =
        fieldOwnerDeclarationSourceLocalRow
    node.fieldDeclarationSourceLocalRow =
        fieldDeclarationSourceLocalRow
    node.fieldOrdinal = fieldOrdinal
    node.fieldBuiltinKind = fieldBuiltinKind
    if ir.exactTypeArena != nil && baseNode >= 0:
        node.resultStructuralTypeId =
            typedExprIrFieldGetExactStructuralTypeId(
                ir.exactTypeArena,
                TypedExprIrNodeStructuralTypeIdAt(ir, baseNode),
                fieldProducerSourceIndex,
                fieldOrdinal,
                fieldBuiltinKind)
    typedExprIrBindNodeStructuralType(
        ir, node, node.resultStructuralTypeId)
    return TypedExprIrAddNode(ir, node)

fn TypedExprIrAddRhsIndexGetNode(ir: var TypedExprIr,
                                  sourcePath: str,
                                  functionName: str,
                                  lineNumber: int32,
                                  surfaceText: str,
                                  resultType: str,
                                  baseNode: int32,
                                  indexNode: int32,
                                  elemSizeBytes: int32): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = share(sourcePath)
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpIndexGet
    node.resultType = share(resultType)
    if ir.exactTypeArena != nil && baseNode >= 0:
        let baseTypeId =
            TypedExprIrNodeStructuralTypeIdAt(ir, baseNode)
        if baseTypeId >= 0:
            node.resultStructuralTypeId =
                typearena.TypedExprTypeArenaUnaryChildTypeId(
                    ir.exactTypeArena,
                    baseTypeId,
                    typearena.TypedExprStructuralTypeSequence,
                    typearena.TypedExprStructuralTypeFixedArray)
            if node.resultStructuralTypeId < 0 &&
               typearena.TypedExprTypeArenaKindAt(
                   ir.exactTypeArena,
                   baseTypeId) ==
                   typearena.TypedExprStructuralTypeScalar &&
               baseTypeId ==
                   typearena.TypedExprTypeArenaReservedScalarTypeId(
                       ir.exactTypeArena,
                       typearena.TypedExprStructuralScalarStr):
                node.resultStructuralTypeId =
                    typearena.TypedExprTypeArenaReservedScalarTypeId(
                        ir.exactTypeArena,
                        typearena.TypedExprStructuralScalarChar)
    typedExprIrBindNodeStructuralType(
        ir, node, node.resultStructuralTypeId)
    node.surfaceText = surfaceText
    node.paramSlot = -1
    node.operand0NodeIndex = baseNode
    node.operand1NodeIndex = indexNode
    node.operand2NodeIndex = -1
    # Front-end source-of-truth correction for cross-module aggregate element
    # reads. The caller's `elemSizeBytes` comes from TypedExprTypeLayout against
    # the *current* parse context, which lacks the field table for a struct
    # declared in another module and therefore degrades to a 4-byte scalar slot
    # (TypedExprTypeLayoutImpl `sizeBytes = 4` fallbacks). By the time RHS
    # IndexGet nodes are built, the populated registry (`ir.typeLayout*`,
    # filled by the pre-scan over all metadata contexts) holds the true size.
    # Re-resolve the element type against that registry; only when it confirms a
    # named aggregate (regFieldCount > 0) whose true size exceeds the degraded
    # value do we fall back to the registry size. Scalars/ptr/seq/str report
    # regFieldCount == 0 and never enter the branch; already-correct aggregates
    # have regSize == elemSizeBytes and stay unchanged. Same registry/algorithm
    # the backend uses (PrimaryBodyIrTypeShapeFromText -> TypedExprIrLookupTypeLayout),
    # so front-end and back-end elemSizeBytes agree from a single front-end site.
    var regSize: int32
    var regAlign: int32
    var regFieldCount: int32
    if TypedExprIrTypeIsRef(ir, share(sourcePath), share(resultType)):
        # T60-v7: `resultType` names a `ref`-declared type, so seq elements are
        # 8-byte pointer HANDLES into the heap, never inline copies of the
        # pointee struct. TypedExprIrLookupTypeLayout below reports the
        # POINTEE struct's own field layout (regFieldCount>0, regSize=pointee
        # size) — that table exists so `.field` access through the ref can
        # resolve offsets, but it must never leak into the SEQ ELEMENT STRIDE.
        # The regFieldCount>0 branch below upgrades elemSizeBytes to the
        # pointee's full struct size for exactly this case (a ref type with
        # fields), which makes the backend's dynamic-seq addressing walk the
        # wrong stride for `ref[]` indexed-then-field-accessed reads
        # (`seq[idx].field`), and makes the node-eval probe bail (its
        # authoritative 8-byte pointer shape < the inflated node stride),
        # kicking the whole expression to the weaker text/poison fallback
        # (silent wrong-value reads on `syms[idx].val`-shaped code). Force the
        # ref handle's true storage width, bypassing the registry entirely.
        node.elemSizeBytes = 8
    elif TypedExprIrLookupTypeLayout(ir, sourcePath, resultType, regSize, regAlign, regFieldCount):
        if regFieldCount > 0 && regSize > elemSizeBytes:
            node.elemSizeBytes = regSize
        else:
            node.elemSizeBytes = elemSizeBytes
    else:
        node.elemSizeBytes = elemSizeBytes
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrRuntimeScalarType(ir: var TypedExprIr,
                                 sourcePath: str,
                                 typeTextRaw: str): str =
    let typeText = chengpath.PathTrim(share(typeTextRaw))
    if typeText == "":
        return typeText
    let strippedType = TypedExprStripVarType(share(typeText))
    # 标量 enum 塌成 int32 供 binop meta 对齐;但 enum SEQ(`MyEnum[]`)必须保留 seq 型,
    # 否则 FieldGet 节点丢 seq 性,链式 `.len` fieldhop-miss(base=int32 无 len)致该
    # 实参无法节点化 → 连坐调用 bail=44。TypeIsEnum 只按叶名匹配无视 `[]`,故加 seq 护栏。
    if TypedExprIrTypeIsEnum(ir, sourcePath, strippedType) && !TypedExprIrTypeTextIsSeq(strippedType):
        return "int32"
    # Collapse a scalar type-def alias (`type FileHandle = uint64`) to its
    # underlying primitive so binop meta sees matching operand types
    # (`handle == uint64(0)`: FileHandle vs uint64 would otherwise mismatch and
    # the comparison node would not build). Only alias targets that are
    # primitive scalars collapse; struct/pointer/ref aliases stay intact so
    # aggregate ABI handling is unchanged. Alias traversal carries the exact
    # defining source/name path, so arbitrary acyclic chains work and cycles
    # fail loudly instead of looking like a non-scalar alias.
    if TypedExprTypeIsScalar(strippedType):
        return typeText
    var aliasOwnerSourcePath = parser.ParserNormalizePath(share(sourcePath))
    var aliasType = strippedType
    var visitedOwners: str[]
    var visitedNames: str[]
    while true:
        var targetOwnerSourcePath = ""
        var aliasTarget = ""
        var aliasCycle = false
        let aliasState = TypedExprIrAliasTarget(ir,
                                                aliasOwnerSourcePath,
                                                aliasType,
                                                visitedOwners,
                                                visitedNames,
                                                targetOwnerSourcePath,
                                                aliasTarget,
                                                aliasCycle)
        if aliasCycle:
            panic(Fmt"typed expr: runtime scalar alias cycle source={aliasOwnerSourcePath} type={aliasType}")
        if aliasState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: runtime scalar alias ambiguous source={aliasOwnerSourcePath} type={aliasType}")
        if aliasState == TypedExprBuildIndexMissing:
            break
        let aliasLeaf = TypedExprStripVarType(chengpath.PathTrim(aliasTarget))
        if aliasLeaf == "":
            panic(Fmt"typed expr: runtime scalar alias target missing source={targetOwnerSourcePath} type={aliasType}")
        if TypedExprTypeIsScalar(aliasLeaf):
            return aliasLeaf
        aliasOwnerSourcePath = targetOwnerSourcePath
        aliasType = aliasLeaf
    return typeText

# P1 暗协议 cross-fn signal: 5680 (binary IR helper) / 16001 (fact-resolver ctor
# inference) 远离 stmt 上下文却需要把失败根因传回 outer stmt.rhsBailReason 分流
# 路径.  与 module-const-cache (下方) 同 pattern: 写入 hint string, outer 调用
# 边 (TypedExprIrConsumeRhsBailHint) 在写 stmt.rhsBailReason 前读+清空.  Bare
# string (非 enum) 让 cheng_seed 跨编译单元保持稳态; 内容必须是
# RhsBailReasonForHint 已知 case 之一: "aggregate_ctor_fail" / "generic_return"
# / "call_surface_unresolved" / 等 (其余视为 None).
var typedExprLastRhsBailReasonHint: str

fn TypedExprIrSetRhsBailHint(hint: str) =
    typedExprLastRhsBailReasonHint = hint

fn TypedExprIrConsumeRhsBailHint(): str =
    let h = typedExprLastRhsBailReasonHint
    typedExprLastRhsBailReasonHint = ""
    return h

fn TypedExprIrRhsBailReasonLabel(reason: RhsBailReason): str =
    if reason == RhsBailBare:
        return "bare"
    if reason == RhsBailWholeCallNoTrace:
        return "whole_call_no_trace"
    if reason == RhsBailFmt:
        return "fmt"
    if reason == RhsBailRange:
        return "range"
    if reason == RhsBailBadToken:
        return "bad_token"
    if reason == RhsBailUnknown:
        return "unknown"
    if reason == RhsBailAggregateCtorFail:
        return "aggregate_ctor_fail"
    if reason == RhsBailCallTargetMissing:
        return "call_target_missing"
    if reason == RhsBailCallTargetAmbiguous:
        return "call_target_ambiguous"
    if reason == RhsBailCallSurfaceUnresolved:
        return "call_surface_unresolved"
    if reason == RhsBailGenericReturn:
        return "generic_return"
    if reason == RhsBailIndexedMember:
        return "indexed_member"
    if reason == RhsBailReceiverChainEmpty:
        return "receiver_chain_empty"
    if reason == RhsBailTailLeafSplitFail:
        return "tail_leaf_split_fail"
    return "none"

# P2 schema extension label helper (sibling of RhsBailReasonLabel above): maps
# the 10-case CallTargetResolutionKind detail enum into a stable lowercase
# snake-case string for dispatch_min frontend output keys
# (primary_object_first_missing_call_target_resolution_label).
fn TypedExprIrCallTargetResolutionKindLabel(kind: CallTargetResolutionKind): str =
    if kind == CallTargetSameSourceUnique:
        return "same_source_unique"
    if kind == CallTargetSameSourceAmbiguous:
        return "same_source_ambiguous"
    if kind == CallTargetQualifiedCrossSourceUnique:
        return "qualified_cross_source_unique"
    if kind == CallTargetQualifiedCrossSourceAmbiguous:
        return "qualified_cross_source_ambiguous"
    if kind == CallTargetGlobalUnique:
        return "global_unique"
    if kind == CallTargetGlobalAmbiguous:
        return "global_ambiguous"
    if kind == CallTargetMissing:
        return "missing"
    if kind == CallTargetTailLeafSplitFail:
        return "tail_leaf_split_fail"
    if kind == CallTargetDeadOverload:
        return "dead_overload"
    return "unresolved"

fn TypedExprIrRhsBailReasonForHint(hint: str): RhsBailReason =
    if hint == "aggregate_ctor_fail":
        return RhsBailAggregateCtorFail
    if hint == "call_target_missing":
        return RhsBailCallTargetMissing
    if hint == "call_target_ambiguous":
        return RhsBailCallTargetAmbiguous
    if hint == "call_surface_unresolved":
        return RhsBailCallSurfaceUnresolved
    if hint == "generic_return":
        return RhsBailGenericReturn
    if hint == "indexed_member":
        return RhsBailIndexedMember
    if hint == "receiver_chain_empty":
        return RhsBailReceiverChainEmpty
    if hint == "tail_leaf_split_fail":
        return RhsBailTailLeafSplitFail
    if hint == "fmt":
        return RhsBailFmt
    if hint == "bad_token":
        return RhsBailBadToken
    return RhsBailNone

@borrows
fn TypedExprModuleConstEntryForLine(lineRaw: str,
                                     inConstBlock: var bool,
                                     entryName: var str,
                                     literal: var str): bool =
    entryName = ""
    literal = ""
    let hasLeadingIndent =
        lineRaw.len > 0 && (lineRaw[0] == ' ' || lineRaw[0] == '\t')
    # Hot per-line rejection path: borrow the stripped/trimmed slice. The two
    # owned copies here were the dominant allocator churn for every source line;
    # only the const-entry acceptance path below still materializes owned text.
    let trimmed = TypedExprTrimmedLineView(lineRaw)
    if trimmed == "":
        return false
    var entryText = ""
    if !hasLeadingIndent:
        inConstBlock = trimmed == "const"
        if parser.ParserStartsWith(trimmed, "const "):
            entryText = chengpath.PathTrim(chengpath.TextSlice(trimmed,
                                                               6,
                                                               trimmed.len - 6))
    elif inConstBlock:
        entryText = trimmed
    if entryText == "":
        return false
    let eqPos = TypedExprFindTopLevelTextToken(entryText, "=")
    if eqPos <= 0:
        return false
    if entryText[eqPos - 1] == '=' ||
       entryText[eqPos - 1] == '!' ||
       entryText[eqPos - 1] == '<' ||
       entryText[eqPos - 1] == '>':
        return false
    if eqPos + 1 < entryText.len && entryText[eqPos + 1] == '=':
        return false
    let entryHead = TypedExprTrimmedRangeView(entryText, 0, eqPos)
    entryName = parser.ParserIdentPrefix(entryHead)
    if entryName == "":
        return false
    if entryName != entryHead:
        let entryHeadRest = TypedExprTrimmedRangeView(entryHead,
                                                      entryName.len,
                                                      entryHead.len)
        if entryHeadRest == "" || entryHeadRest[0] != ':':
            entryName = ""
            return false
    if eqPos + 1 == entryText.len:
        # 行尾 '=' = 初式在续行。此声明布局 parser 一贯接受（森林闭包内
        # 29 文件 218 处；body_ir_exact_def.cheng:382
        # BodyIrExactDefContractCidDomainTag 即此形），但行定界扫描此前把
        # 整条 const 漏表——qualified/裸名 const 字面量查询全域 Missing，
        # 静态实参定型 fail-closed 判 192 族（exact_def_call_authority:1462
        # `args=buf, exactdef.BodyIrExactDefContractCidDomainTag`）。此处
        # 产出 pending 项（accepted 且 literal 为空；b2002 语义 accepted
        # 恒有非空 literal，组合无歧义），由扫描循环的续行载具吸收初式。
        literal = ""
        return true
    literal = chengpath.PathTrim(chengpath.TextSlice(entryText,
                                                     eqPos + 1,
                                                     entryText.len - eqPos - 1))
    return true

fn TypedExprModuleConstResetLocalContext(ctx: var TypedExprSourceContext,
                                         lineCount: int32) =
    ctx.moduleConstLookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedAddInt32(lineCount, 8,
                                 "module_const_lookup_capacity"))
    ctx.moduleConstNames = []
    ctx.moduleConstLiterals = []
    ctx.moduleConstScanned = false
    ctx.moduleConstLookupFinalized = false

@borrows
fn TypedExprModuleConstLocalEntryIsFresh(
        ctx: var TypedExprSourceContext,
        entryName: str,
        literal: str,
        sourcePath: str): bool =
    let existingIndex =
        parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
            ctx.moduleConstLookup, entryName)
    if existingIndex >= 0:
        if existingIndex >= ctx.moduleConstLiterals.len ||
           ctx.moduleConstLiterals[existingIndex] != literal:
            panic(Fmt"typed expr: conflicting module const source={sourcePath} name={entryName}")
        return false
    return true

# [orcd11] 借用合同补标 (ORCM@13 根修): 本函数只读 entryName/literal ——
# names 列取 ParserOwnedText 私有自有拷贝, literals 列由 add 记账保留,
# lookup key 亦为私有拷贝; 返回后不持有任何调用方块。缺 @borrows 时形参
# 按接管合同在返回处释放, 而续行 const 路径传入的 pendingContinuationName
# (随后 ="" 清场) 与 continuationValue (else 块尾释放) 各自仍按自身 scope
# 释放一次 => pending 块二次释放 (registry_miss, 崩窗=首次续行 const 源)。
# 列内 literal 保留块亦被双重扣减致列悬垂。同形合同先例 =
# TypedExprModuleConstLocalEntryIsFresh (@borrows + var ctx + str 形参)。
@borrows
fn TypedExprModuleConstStoreLocalEntryOwned(
        ctx: var TypedExprSourceContext,
        entryName: str,
        literal: str) =
    let entryIndex = ctx.moduleConstNames.len
    # [mcfix] names 列入库 = ParserOwnedText 私有自有拷贝 (ORCD6 私钥习语同款):
    # entryName 在 continuation 路径经跨迭代 pending 中转, 其块寿命不归列管;
    # 列必须在此处 (借用权活体内) 取字节级自有拷贝自证所有权, 禁 share 继承
    # 借用。lit 侧 PathTrim 已是自有拷贝, 维持原状。
    add(ctx.moduleConstNames, parser.ParserOwnedText(entryName))
    # [orcd11] @borrows 合同下 literals 列入列须显式 share 记账 (借用源
    # 入 value 形 add 被 fail-closed 门拒绝; 列在此取精确保留权, 调用方
    # scope 尾各释一次, 列持有权活至 Reset/S3 清释)。
    add(ctx.moduleConstLiterals, share(literal))
    parser.ParserSourcePathIndexLookupInsertExact(ctx.moduleConstLookup,
                                                  parser.ParserOwnedText(entryName),
                                                  entryIndex)

@borrows
fn TypedExprModuleConstScanContext(ctx: var TypedExprSourceContext,
                                    constLines: var str[],
                                    sourcePath: str) =
    TypedExprModuleConstResetLocalContext(ctx, constLines.len)
    var inConstBlock = false
    var pendingContinuationName = ""
    for i in 0..<constLines.len:
        var entryName = ""
        var literal = ""
        let entryAccepted = TypedExprModuleConstEntryForLine(constLines[i],
                                                   inConstBlock,
                                                   entryName,
                                                   literal)
        if pendingContinuationName != "":
            if !inConstBlock:
                pendingContinuationName = ""
            elif entryAccepted:
                # 新 entry 头先于续行值出现 = 声明布局非法，fail-closed
                # （该 const 维持未登记，与 b2002 行为一致）；当前行照常
                # 走下方 entry 处理。
                pendingContinuationName = ""
            else:
                let continuationValue = chengpath.PathTrim(constLines[i])
                if continuationValue != "" && continuationValue[0] != '#':
                    if TypedExprModuleConstLocalEntryIsFresh(ctx,
                                                             pendingContinuationName,
                                                             continuationValue,
                                                             sourcePath):
                        TypedExprModuleConstStoreLocalEntryOwned(ctx,
                                                                 pendingContinuationName,
                                                                 continuationValue)
                    pendingContinuationName = ""
                continue
        if !entryAccepted:
            continue
        if literal == "":
            # [mcfix] 跨迭代 pending 中转 = ParserOwnedText 私有自有拷贝:
            # `pendingContinuationName = entryName` 直接赋值让 pending 与
            # 迭代局部 entryName 共块, entryName 迭代尾释放后 pending(及其
            # 后续入库行) 即持悬垂头(仪器 K1 实锤: continuation 行 name
            # rc=0 毒印, 同行 lit rc=2 健康)。pending 必须自持私有字节,
            # 消费点 pending="" 处平衡释放。
            pendingContinuationName = parser.ParserOwnedText(entryName)
            continue
        if !TypedExprModuleConstLocalEntryIsFresh(ctx,
                                                  entryName,
                                                  literal,
                                                  sourcePath):
            continue
        TypedExprModuleConstStoreLocalEntryOwned(ctx,
                                                 entryName,
                                                 literal)
    ctx.moduleConstScanned = true

@borrows
fn TypedExprModuleConstScanStoredContextLines(
        ctx: var TypedExprSourceContext,
        sourcePath: str) =
    let lineCount = ctx.lines.len
    TypedExprModuleConstResetLocalContext(ctx, lineCount)
    var inConstBlock = false
    var pendingContinuationName = ""
    for i in 0..<lineCount:
        var entryName = ""
        var literal = ""
        let entryAccepted = TypedExprModuleConstEntryForLine(ctx.lines[i],
                                                   inConstBlock,
                                                   entryName,
                                                   literal)
        if pendingContinuationName != "":
            if !inConstBlock:
                pendingContinuationName = ""
            elif entryAccepted:
                # 新 entry 头先于续行值出现 = 声明布局非法，fail-closed
                # （该 const 维持未登记，与 b2002 行为一致）；当前行照常
                # 走下方 entry 处理。
                pendingContinuationName = ""
            else:
                let continuationValue = chengpath.PathTrim(ctx.lines[i])
                if continuationValue != "" && continuationValue[0] != '#':
                    if TypedExprModuleConstLocalEntryIsFresh(ctx,
                                                             pendingContinuationName,
                                                             continuationValue,
                                                             sourcePath):
                        TypedExprModuleConstStoreLocalEntryOwned(ctx,
                                                                 pendingContinuationName,
                                                                 continuationValue)
                    pendingContinuationName = ""
                continue
        if !entryAccepted:
            continue
        if literal == "":
            # [mcfix] 跨迭代 pending 中转 = ParserOwnedText 私有自有拷贝:
            # `pendingContinuationName = entryName` 直接赋值让 pending 与
            # 迭代局部 entryName 共块, entryName 迭代尾释放后 pending(及其
            # 后续入库行) 即持悬垂头(仪器 K1 实锤: continuation 行 name
            # rc=0 毒印, 同行 lit rc=2 健康)。pending 必须自持私有字节,
            # 消费点 pending="" 处平衡释放。
            pendingContinuationName = parser.ParserOwnedText(entryName)
            continue
        if !TypedExprModuleConstLocalEntryIsFresh(ctx,
                                                  entryName,
                                                  literal,
                                                  sourcePath):
            continue
        TypedExprModuleConstStoreLocalEntryOwned(ctx,
                                                 entryName,
                                                 literal)
    ctx.moduleConstScanned = true

@borrows
fn TypedExprModuleConstLiteralFromLines(constLines: var str[],
                                         name: str,
                                         sourcePath: str): str =
    var transientContext: TypedExprSourceContext
    TypedExprModuleConstScanContext(transientContext,
                                    constLines,
                                    sourcePath)
    let entryIndex =
        parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
            transientContext.moduleConstLookup, name)
    var literal = ""
    if entryIndex >= 0:
        if entryIndex >= transientContext.moduleConstLiterals.len:
            panic("typed expr: transient module const lookup out of range")
        literal = share(transientContext.moduleConstLiterals[entryIndex])
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SITE=transient")
    TypedExprClearSourceContextAllFields(transientContext)
    return literal

@borrows
fn TypedExprModuleConstRegisterContextRows(
        ctx: var TypedExprSourceContext,
        sourcePath: str) =
    if ctx.buildIndex == nil:
        panic("typed expr: module const registration missing build index")
    if ctx.buildIndex.released:
        panic("typed expr: module const registration on released build index")
    if ctx.buildIndex.frozenReadOnlyQueries:
        panic("typed expr: module const registration on frozen build index")
    if !ctx.moduleConstScanned ||
       ctx.moduleConstNames.len != ctx.moduleConstLiterals.len:
        panic("typed expr: module const registration missing local authority")
    for rowIndex in 0..<ctx.moduleConstNames.len:
        let _ = TypedExprBuildIndexRegister(ctx.buildIndex,
                                            "module_const",
                                            sourcePath,
                                            ctx.moduleConstNames[rowIndex],
                                            "",
                                            0,
                                            sourcePath,
                                            ctx.moduleConstLiterals[rowIndex],
                                            true)
        # 索引级解析器(TypedExprCallConstTarget)按 "ctx_module_const_source"
        # 命名空间查询,与 context 本地路径("module_const")并行登记同一行。
        let _ = TypedExprBuildIndexRegister(ctx.buildIndex,
                                            "ctx_module_const_source",
                                            sourcePath,
                                            ctx.moduleConstNames[rowIndex],
                                            "",
                                            0,
                                            sourcePath,
                                            ctx.moduleConstLiterals[rowIndex],
                                            true)
    let _ = TypedExprBuildIndexRegister(ctx.buildIndex,
                                        "module_const_scanned",
                                        sourcePath,
                                        "",
                                        "",
                                        1,
                                        sourcePath,
                                        sourcePath,
                                        true)

fn TypedExprEnsureModuleConstMetadata(ctx: var TypedExprSourceContext,
                                      sourcePath: str) =
    if !ctx.moduleConstScanned:
        panic(Fmt"typed expr: module const metadata not eagerly scanned source={sourcePath}")
    if ctx.moduleConstNames.len != ctx.moduleConstLiterals.len:
        panic(Fmt"typed expr: module const metadata columns mismatch source={sourcePath}")
    if ctx.moduleConstNames.len > 0 &&
       ctx.moduleConstLookup.slots.len == 0:
        panic(Fmt"typed expr: module const lookup used after context finalization before build index attach source={sourcePath}")
    for itemIndex in 0..<ctx.moduleConstNames.len:
        let name = ctx.moduleConstNames[itemIndex]
        let literal = ctx.moduleConstLiterals[itemIndex]
        if name == "" || parser.ParserIdentPrefix(name) != name ||
           literal == "" ||
           parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
               ctx.moduleConstLookup, name) != itemIndex:
            panic(Fmt"typed expr: module const metadata row invalid source={sourcePath} row={itemIndex}")


fn TypedExprModuleConstLookupLogicalBytes(ctx: var TypedExprSourceContext): int64 =
    var total = typedExprCheckedMul64(Int64(ctx.moduleConstLookup.slots.len),
                                      4,
                                      "module_const_lookup_bytes")
    total = typedExprCheckedAdd64(
        total,
        typedExprCheckedMul64(Int64(ctx.moduleConstLookup.buckets.len),
                              64,
                              "module_const_lookup_bytes"),
        "module_const_lookup_bytes")
    for bucketIndex in 0..<ctx.moduleConstLookup.buckets.len:
        total = typedExprCheckedAdd64(
            total,
            typedExprCheckedMul64(
                Int64(ctx.moduleConstLookup.buckets[bucketIndex].items.len),
                32,
                "module_const_lookup_bytes"),
            "module_const_lookup_bytes")
    return total


fn TypedExprFinalizeModuleConstMetadata(ctx: var TypedExprSourceContext,
                                        sourcePath: str) =
    TypedExprEnsureModuleConstMetadata(ctx, sourcePath)
    let transientBytes = TypedExprModuleConstLookupLogicalBytes(ctx)
    if ctx.moduleConstNames.len > 0 && transientBytes <= 0:
        panic(Fmt"typed expr: module const lookup missing before context finalization source={sourcePath}")
    if transientBytes > ctx.moduleConstLookupTransientPeakBytes:
        ctx.moduleConstLookupTransientPeakBytes = transientBytes
    ctx.moduleConstLookup = parser.ParserSourcePathIndexLookup()
    ctx.moduleConstLookupFinalized = true
    if TypedExprModuleConstLookupLogicalBytes(ctx) != 0:
        panic(Fmt"typed expr: module const lookup release failed source={sourcePath}")

@borrows
fn TypedExprModuleConstLiteralFromFile(
        constCtx: var TypedExprSourceContext,
        name: str,
        sourcePath: str): str =
    if constCtx.snapshotOnly:
        panic(Fmt"typed expr: snapshot-only module const context lines missing source={sourcePath} name={name}")
    var sourceText = chengpath.ReadTextFile("", constCtx.sourcePath)
    if sourceText == "":
        sourceText = os.ReadFile(
            chengpath.PathProviderFilePath(constCtx.sourcePath))
    if sourceText == "":
        return ""
    var constLines = parser.ParserSplitChar(sourceText, '\n')
    return TypedExprModuleConstLiteralFromLines(constLines,
                                                 name,
                                                 sourcePath)

@borrows
fn TypedExprModuleConstLiteralForContext(constCtx: var TypedExprSourceContext,
                                          name: str): str =
    if name == "":
        return ""
    let sourcePath = parser.ParserNormalizePath(constCtx.sourcePath)
    if constCtx.buildIndex != nil &&
       constCtx.buildIndex.frozenReadOnlyQueries:
        var frozenLiteral: str
        let frozenState = TypedExprBuildIndexLookupFingerprint(
            constCtx.buildIndex,
            "ctx_module_const_source",
            sourcePath,
            name,
            "",
            frozenLiteral)
        if frozenState == TypedExprBuildIndexUnique:
            return frozenLiteral
        if frozenState == TypedExprBuildIndexMissing:
            return ""
        panic(Fmt"typed expr: ambiguous frozen module const source={sourcePath} name={name}")
    var indexedScanned = false
    if constCtx.buildIndex != nil:
        var scannedValue: int32
        indexedScanned = TypedExprBuildIndexLookup(constCtx.buildIndex,
                                                    "module_const_scanned",
                                                    sourcePath,
                                                    "",
                                                    "",
                                                    scannedValue) == TypedExprBuildIndexUnique
    if constCtx.buildIndex != nil:
        if !indexedScanned:
            if !constCtx.moduleConstScanned:
                if constCtx.lines.len <= 0:
                    return TypedExprModuleConstLiteralFromFile(constCtx,
                                                                name,
                                                                sourcePath)
                TypedExprModuleConstScanStoredContextLines(constCtx,
                                                            sourcePath)
            TypedExprModuleConstRegisterContextRows(constCtx,
                                                     sourcePath)
        var literal: str
        let state = TypedExprBuildIndexLookupFingerprint(constCtx.buildIndex,
                                                          "module_const",
                                                          sourcePath,
                                                          name,
                                                          "",
                                                          literal)
        if state == TypedExprBuildIndexUnique:
            return literal
        if state == TypedExprBuildIndexMissing:
            return ""
        panic(Fmt"typed expr: ambiguous module const index source={sourcePath} name={name}")
    if !constCtx.moduleConstScanned:
        if constCtx.lines.len <= 0:
            return TypedExprModuleConstLiteralFromFile(constCtx,
                                                        name,
                                                        sourcePath)
        TypedExprModuleConstScanStoredContextLines(constCtx, sourcePath)
    let entryIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(constCtx.moduleConstLookup,
                                                                                  name)
    if entryIndex < 0:
        return ""
    if entryIndex >= constCtx.moduleConstLiterals.len:
        panic("typed expr: corrupt module const build cache")
    return constCtx.moduleConstLiterals[entryIndex]

# [xmod const] Read-only module-const lookup through the registered build
# index; the name is historical (frozen session), but the query is legal in
# BOTH phases: the streaming typed-facts pass (pre-seal) and the frozen fixed
# point.  The (sourcePath,name) rows are registered into the shared index at
# index-build time (typedExprBuildIndexForContextsCore ->
# TypedExprModuleConstRegisterContextRows, "ctx_module_const_source"
# namespace), so this function only reads -- no scan, no registration -- and
# Unique/Missing are exact answers in either phase.  The old contract bound a
# readonly query to frozenReadOnlyQueries and killed the legal pre-seal
# consumer (cleanup_cfg:755 `var expectedManagedStoreKind =
# coreir.ManagedStoreNoneTag`, same form at all eight sites; fixture
# b8_repro_xmod_pair reproduces verbatim).
@borrows
fn TypedExprModuleConstLiteralForFrozenContext(
        constCtx: TypedExprSourceContext,
        name: str): str =
    if name == "":
        return ""
    let sourcePath = parser.ParserNormalizePath(constCtx.sourcePath)
    if constCtx.buildIndex == nil || constCtx.buildIndex.released:
        panic(Fmt"typed expr: module const readonly query without build index authority source={sourcePath} name={name}")
    var literal: str
    let state = TypedExprBuildIndexLookupFingerprint(
        constCtx.buildIndex,
        "ctx_module_const_source",
        sourcePath,
        name,
        "",
        literal)
    if state == TypedExprBuildIndexUnique:
        return literal
    if state == TypedExprBuildIndexMissing:
        return ""
    panic(Fmt"typed expr: ambiguous frozen module const source={sourcePath} name={name}")

# Resolve a bare qualified cross-module const reference (`alias.ConstName`) to the
# const's literal text, by resolving the import alias to the target module and
# scanning its const block with the existing const scanner. Returns "" when the
# RHS is not a clean qualified reference or the target const cannot be found.
@borrows
fn TypedExprQualifiedConstLiteral(ctx: TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   textRaw: str): str =
    let text = chengpath.PathTrim(textRaw)
    let qualifier = TypedExprQualifiedCallQualifier(text)
    let constName = TypedExprQualifiedCallLeaf(text)
    if qualifier == "" || constName == "":
        return ""
    if Fmt"{qualifier}.{constName}" != text:
        return ""
    let targetSourcePath = TypedExprLookupQualifiedModuleSourcePath(ctx,
                                                                    sourceContexts,
                                                                    qualifier)
    if targetSourcePath == "":
        return ""
    let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetSourcePath)
    if targetIndex < 0:
        return ""
    return TypedExprModuleConstLiteralForFrozenContext(
        sourceContexts[targetIndex],
        constName)

fn TypedExprIrBuildModuleConstLiteralNode(ir: var TypedExprIr,
                                           sourcePath: str,
                                           functionName: str,
                                           lineNumber: int32,
                                           surfaceText: str,
                                           literalText: str): int32 =
    if literalText == "":
        return -1
    if TypedExprIrRhsTextIsStringLiteral(literalText):
        return TypedExprIrAddRhsLeafNode(ir,
                                         sourcePath,
                                         functionName,
                                         lineNumber,
                                         TypedExprIrOpStrLit,
                                         "str",
                                         surfaceText,
                                         literalText)
    if literalText == "true" || literalText == "false":
        return TypedExprIrAddRhsLeafNode(ir,
                                         sourcePath,
                                         functionName,
                                         lineNumber,
                                         TypedExprIrOpBoolLit,
                                         "bool",
                                         surfaceText,
                                         literalText)
    if TypedExprIrRhsTextIsCharLiteral(literalText):
        return TypedExprIrAddRhsLeafNode(ir,
                                         sourcePath,
                                         functionName,
                                         lineNumber,
                                         TypedExprIrOpCharLit,
                                         "char",
                                         surfaceText,
                                         literalText)
    if TypedExprIrRhsTextIsI32Literal(literalText):
        return TypedExprIrAddRhsLeafNode(ir,
                                         sourcePath,
                                         functionName,
                                         lineNumber,
                                         TypedExprIrOpI32Const,
                                         "int32",
                                         surfaceText,
                                         literalText)
    # 模块 const 写成 castType(intLiteral)(uint64(257)/int64(0)/uint8(0x..)...):
    # 扫到的值文本不匹配上面任何裸字面量探针,使 const-ident RHS 建不出节点
    # (no_node)。物化与 whole-call 实参兜底(TypedExprIrBuildRhsWholeCallNode 的
    # intConvType 分支)同款 typed 整数 const 叶:剥 cast,int64/uint64 发 I64Const、
    # 更窄发 I32Const,带裸内层字面量与 resultType=cast 目标类型。守卫
    # TypedExprTextIsIntegerLiteral 仅认真字面量内参(cast-of-表达式 const 仍 -1)。
    let constCastOpenPos = TypedExprFindWholeCallOpenParen(literalText)
    if constCastOpenPos > 0:
        let constCastClosePos = TypedExprFindMatchingParen(literalText, constCastOpenPos)
        if constCastClosePos > constCastOpenPos && constCastClosePos + 1 == literalText.len:
            let constCastHead = chengpath.PathTrim(chengpath.TextSlice(literalText, 0, constCastOpenPos))
            let constCastType = TypedExprIntConversionFnTargetType(constCastHead)
            let constCastInner = TypedExprSliceTrim(literalText,
                                                    constCastOpenPos + 1,
                                                    constCastClosePos - constCastOpenPos - 1)
            if constCastType != "" && TypedExprTextIsIntegerLiteral(constCastInner):
                if constCastType == "int64" || constCastType == "uint64":
                    return TypedExprIrAddRhsLeafNode(ir,
                                                     sourcePath,
                                                     functionName,
                                                     lineNumber,
                                                     TypedExprIrOpI64Const,
                                                     constCastType,
                                                     surfaceText,
                                                     constCastInner)
                return TypedExprIrAddRhsLeafNode(ir,
                                                 sourcePath,
                                                 functionName,
                                                 lineNumber,
                                                 TypedExprIrOpI32Const,
                                                 constCastType,
                                                 surfaceText,
                                                 constCastInner)
    return -1

@borrows
fn TypedExprScopeLoopVarNameHash(name: str, bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(name):
        h = h * 31 + int32(name[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

fn TypedExprScopeLoopVarTablePrepare(ctx: var TypedExprSourceContext) =
    let lineCount = TypedExprSourceContextLineCount(ctx)
    for scopeIndex in 0..<ctx.scopes.len:
        var scope = ctx.scopes[scopeIndex]
        if scope.loopVarTableBuilt:
            continue
        scope.loopVarRecordNames = []
        scope.loopVarRecordLineNumbers = []
        scope.loopVarRecordIndents = []
        scope.loopVarRecordRangeFlags = []
        scope.loopVarRecordIterableTexts = []
        scope.loopVarRecordNext = []
        scope.loopVarNameBucketHeads = []
        scope.loopVarLineEnclosingForRecordIndexes = []
        var stackLineNumbers: int32[]
        var stackIndents: int32[]
        var stackBreakRecordIndexes: int32[]
        var lastLine = scope.endLine
        if lastLine <= scope.startLine:
            lastLine = lineCount
        elif lastLine > lineCount:
            lastLine = lineCount
        if lastLine > scope.startLine:
            for lineNumber in (scope.startLine + 1)..lastLine:
                let rawLine = TypedExprSourceContextLineText(ctx, lineNumber)
                if rawLine == "":
                    add(scope.loopVarLineEnclosingForRecordIndexes, -1)
                    continue
                let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
                if trimmed == "":
                    add(scope.loopVarLineEnclosingForRecordIndexes, -1)
                    continue
                let lineIndent = TypedExprLineIndentWidth(rawLine)
                let isFor = parser.ParserStartsWith(trimmed, "for ")
                let hasIn = parser.ParserFindText(trimmed, " in ") >= 0
                var recordIndex: int32 = -1
                if isFor || hasIn:
                    let bindingName = TypedExprForBindingNameFromHeader(trimmed)
                    var rangeStartText = ""
                    var rangeEndText = ""
                    let rangeFlag = TypedExprForHeaderRangeBounds(trimmed, rangeStartText, rangeEndText)
                    let iterableText = TypedExprForHeaderIterableText(trimmed)
                    recordIndex = scope.loopVarRecordNames.len
                    add(scope.loopVarRecordNames, share(bindingName))
                    add(scope.loopVarRecordLineNumbers, lineNumber)
                    add(scope.loopVarRecordIndents, lineIndent)
                    add(scope.loopVarRecordRangeFlags, rangeFlag)
                    add(scope.loopVarRecordIterableTexts, share(iterableText))
                    add(scope.loopVarRecordNext, -1)
                var popCount: int32
                while popCount < stackLineNumbers.len &&
                      stackIndents[stackLineNumbers.len - 1 - popCount] >= lineIndent:
                    popCount = popCount + 1
                setLen(stackLineNumbers, stackLineNumbers.len - popCount)
                setLen(stackIndents, stackIndents.len - popCount)
                setLen(stackBreakRecordIndexes, stackBreakRecordIndexes.len - popCount)
                var enclosingRecordIndex: int32 = -1
                if stackLineNumbers.len > 0:
                    let topPos = stackLineNumbers.len - 1
                    let topIndent = stackIndents[topPos]
                    if topIndent > 0:
                        let topBreak = stackBreakRecordIndexes[topPos]
                        if topBreak >= 0:
                            enclosingRecordIndex = topBreak
                        else:
                            let topLine = stackLineNumbers[topPos]
                            let topLineIndex = topLine - scope.startLine - 1
                            if topLineIndex >= 0 &&
                               topLineIndex < scope.loopVarLineEnclosingForRecordIndexes.len:
                                enclosingRecordIndex =
                                    scope.loopVarLineEnclosingForRecordIndexes[topLineIndex]
                add(scope.loopVarLineEnclosingForRecordIndexes, enclosingRecordIndex)
                var breakRecordIndex: int32 = -1
                if isFor:
                    breakRecordIndex = recordIndex
                add(stackLineNumbers, lineNumber)
                add(stackIndents, lineIndent)
                add(stackBreakRecordIndexes, breakRecordIndex)
        for bucketIndex in 0..<4096:
            add(scope.loopVarNameBucketHeads, -1)
        for recordIndex in 0..<scope.loopVarRecordNames.len:
            let recordName = scope.loopVarRecordNames[recordIndex]
            if recordName == "":
                continue
            let bucket = TypedExprScopeLoopVarNameHash(recordName,
                                                       scope.loopVarNameBucketHeads.len)
            if bucket < 0:
                continue
            scope.loopVarRecordNext[recordIndex] = scope.loopVarNameBucketHeads[bucket]
            scope.loopVarNameBucketHeads[bucket] = recordIndex
        scope.loopVarTableBuilt = true
        ctx.scopes[scopeIndex] = scope

@borrows
fn TypedExprEnclosingForRangeBindingIsI32(ctx: TypedExprSourceContext,
                                           scope: TypedExprFunctionScope,
                                           lineNumber: int32,
                                           name: str): bool =
    if name == "" || lineNumber <= scope.startLine:
        return false
    let usageLineRaw = TypedExprSourceContextLineText(ctx, lineNumber)
    if usageLineRaw == "" || TypedExprLineIndentWidth(usageLineRaw) <= 0:
        return false
    if !scope.loopVarTableBuilt:
        # 表未建相位 (range(...) 脱糖在 context 构建早期的查询): 该查询
        # 只发生在 range 消费路径, for-range 循环变量按语言定义恒 int32
        # —— 未知相位假定 int32 (对普通 int32 局部名同型无害)。
        return true
    let lineIndex = lineNumber - scope.startLine - 1
    if lineIndex < 0 || lineIndex >= scope.loopVarLineEnclosingForRecordIndexes.len:
        return false
    let recordIndex = scope.loopVarLineEnclosingForRecordIndexes[lineIndex]
    if recordIndex < 0 || recordIndex >= scope.loopVarRecordNames.len:
        return false
    return scope.loopVarRecordRangeFlags[recordIndex] &&
           scope.loopVarRecordNames[recordIndex] == name

@borrows
fn TypedExprEnclosingForSeqBindingElementType(ir: var TypedExprIr,
                                               ctx: var TypedExprSourceContext,
                                               scope: TypedExprFunctionScope,
                                               lineNumber: int32,
                                               name: str): str =
    if name == "" || lineNumber <= scope.startLine:
        return ""
    let usageLineRaw = TypedExprSourceContextLineText(ctx, lineNumber)
    if usageLineRaw == "" || TypedExprLineIndentWidth(usageLineRaw) <= 0:
        return ""
    if !scope.loopVarTableBuilt:
        return "int32"
    let lineIndex = lineNumber - scope.startLine - 1
    if lineIndex < 0 || lineIndex >= scope.loopVarLineEnclosingForRecordIndexes.len:
        return ""
    let recordIndex = scope.loopVarLineEnclosingForRecordIndexes[lineIndex]
    if recordIndex < 0 || recordIndex >= scope.loopVarRecordNames.len:
        return ""
    if scope.loopVarRecordNames[recordIndex] != name:
        return ""
    if scope.loopVarRecordRangeFlags[recordIndex]:
        return ""
    let iterableText = scope.loopVarRecordIterableTexts[recordIndex]
    if iterableText == "" ||
       iterableText == name ||
       parser.ParserIdentPrefix(iterableText) != iterableText:
        return ""
    let ln = scope.loopVarRecordLineNumbers[recordIndex]
    var iterableType = TypedExprBindingRhsLocalRefType(ir,
                                                       ctx,
                                                       scope,
                                                       ln,
                                                       share(iterableText))
    if iterableType == "":
        let iterableScopeIndex = TypedExprScopeIndexForLine(ctx.scopes, ln)
        iterableType = TypedExprNormalizeTypeText(
            TypedExprLookupBindingTypeIndexed(
                ctx,
                iterableScopeIndex,
                ln,
                iterableText))
    return TypedExprNormalizeTypeText(TypedExprIrRhsIndexElemType(ctx, iterableType))

@borrows
fn typedExprIrAddExactBindingRefNode(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        surfaceText: str,
        templateNodeIndex: int32,
        opKind: TypedExprIrOpKind,
        parserNodeIndex: int32,
        parserProducerSourceIndex: int32,
        declarationSourceLocalRow: int32,
        patternSourceLocalRow: int32,
        valueDefinitionRow: int32): int32 =
    if templateNodeIndex < 0 ||
       templateNodeIndex >= ir.nodes2_nodeIndexs.len ||
       (opKind != TypedExprIrOpParamRef &&
        opKind != TypedExprIrOpLocalRef):
        panic("typed expr binding: template node unavailable")
    let resultTypeResult = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_resultTypeIds[templateNodeIndex])
    if !IsOk(resultTypeResult):
        panic("typed expr binding: template result type unavailable")
    # Never CloneStr the caller-provided surfaceText view. If the by-value
    # str was polluted by a cross-function ABI mismatch (r68probe6 saw
    # len=0x07ffffff -> a 128MiB owned copy), re-derive it inside this
    # function from the sealed parser tree int32 atom span and let
    # TypedExprIrAppendNode intern by the real length.
    var bindingSurfaceText = surfaceText
    let bindingTree = ir.valueExprTree
    if bindingTree != nil && parserNodeIndex >= 0 &&
       parserNodeIndex < parser.ParserValueExprTreeNodeCount(bindingTree):
        let bindingAtomStart = arenamod.ArenaArrayInt32Get(
            bindingTree.arena, bindingTree.atomStarts, parserNodeIndex)
        let bindingAtomEnd = arenamod.ArenaArrayInt32Get(
            bindingTree.arena, bindingTree.atomEnds, parserNodeIndex)
        if bindingAtomEnd >= bindingAtomStart &&
           (bindingSurfaceText.len < 0 ||
            bindingSurfaceText.len > 16384 ||
            bindingSurfaceText.len != bindingAtomEnd - bindingAtomStart):
            bindingSurfaceText = parser.ParserValueExprNodeAtomText(
                bindingTree, parserNodeIndex)
            if bindingSurfaceText.len < 0 ||
               bindingSurfaceText.len > 16384 ||
               bindingSurfaceText.len != bindingAtomEnd - bindingAtomStart:
                panic(Fmt"typed expr binding: exact ref surface text authority drift len={bindingSurfaceText.len} atom={bindingAtomEnd - bindingAtomStart}")
    var node = TypedExprIrNodeNew()
    node.sourcePath = share(ctx.sourcePath)
    node.functionName = share(scope.name)
    node.lineNumber = lineNumber
    node.opKind = opKind
    node.resultType = Value(resultTypeResult)
    node.resultTypeProofKind = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_resultTypeProofKinds,
        templateNodeIndex)
    node.resultTypeManaged =
        ir.nodes2_resultTypeManagedFlags[templateNodeIndex]
    node.resultTypeSend =
        ir.nodes2_resultTypeSendFlags[templateNodeIndex]
    node.resultTypeSync =
        ir.nodes2_resultTypeSyncFlags[templateNodeIndex]
    node.resultStructuralTypeId = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_structuralTypeIds,
        templateNodeIndex)
    node.surfaceText = share(bindingSurfaceText)
    node.paramName = share(bindingSurfaceText)
    node.paramSlot = opKind == TypedExprIrOpParamRef ?
        arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_paramSlots,
            templateNodeIndex) :
        -1
    node.paramMutableFlag =
        opKind == TypedExprIrOpParamRef &&
        ir.nodes2_paramMutableFlags[templateNodeIndex]
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    # [bd] The durable binding column carries the source-stable
    # projection (snapshot bindingParserSourceLocalNodeRows contract
    # domain); the sealed forest-global row moves to the parallel column.
    # Same guard domain as the caller's origin transaction.
    if ir.valueExprTree == nil || parserNodeIndex < 0 ||
       parserNodeIndex >=
           parser.ParserValueExprTreeNodeCount(ir.valueExprTree):
        panic("typed expr binding: exact forest node unavailable")
    let bindingParserSourceLocalRow =
        parser.ParserValueExprNodeSourceLocalIndexAt(
            ir.valueExprTree, parserNodeIndex)
    if ir.originParserNodeStack.len <= 0 ||
       ir.originParserNodeStack[
           ir.originParserNodeStack.len - 1] !=
           bindingParserSourceLocalRow:
        panic("typed expr binding: exact source-local projection drift")
    node.bindingParserNodeIndex = bindingParserSourceLocalRow
    node.bindingParserForestNodeIndex = parserNodeIndex
    node.bindingParserProducerSourceIndex =
        parserProducerSourceIndex
    node.bindingDeclarationSourceLocalRow =
        declarationSourceLocalRow
    node.bindingPatternSourceLocalRow =
        patternSourceLocalRow
    node.bindingValueDefinitionRow = valueDefinitionRow
    return TypedExprIrAddNode(ir, node)

fn typedExprIrExactLocalValueDefinitionRow(
        ir: var TypedExprIr,
        parserPatternRow: int32,
        parserProducerSourceIndex: int32,
        declarationSourceLocalRow: int32,
        patternSourceLocalRow: int32,
        typedFunctionIndex: int32): int32 =
    if parserPatternRow < 0 ||
       parserPatternRow >=
           arenamod.ArenaArrayInt32Len(
               ir.arena,
               ir.valueExprTransactionDefinitionGroupRowsByPatternRow):
        panic("typed expr binding: parser Pattern group index unavailable")
    let groupRow = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
        parserPatternRow)
    if groupRow < ir.valueExprTransactionDefinitionGroupStart ||
       groupRow >= TypedExprValueDefinitionGroupAuthorityCount(ir) ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_parserProducerSourceIndexes,
           groupRow) != parserProducerSourceIndex ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_declarationSourceLocalRows,
           groupRow) != declarationSourceLocalRow ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_patternSourceLocalRows,
           groupRow) != patternSourceLocalRow ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_typedFunctionIndexes,
           groupRow) != typedFunctionIndex ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_consumedFlags,
           groupRow) != 1:
        panic("typed expr binding: exact local value-definition group unavailable")
    let definitionRow = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueDefinitionGroups_definitionRows,
        groupRow)
    if definitionRow < 0 ||
       definitionRow >= TypedExprValueDefinitionAuthorityCount(ir):
        panic("typed expr binding: exact local value-definition row unavailable")
    return definitionRow

@borrows
fn typedExprIrBuildRhsIdentifierFromParserActive(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        parserNodeIndex: int32): int32 =
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease ||
       parser.ParserValueExprNodeKindAt(tree, parserNodeIndex) !=
           parser.ParserValueExprIdentifier:
        panic("typed expr binding: exact parser Identifier unavailable")
    let parserSourceLocalRow =
        parser.ParserValueExprNodeSourceLocalIndexAt(
            tree, parserNodeIndex)
    if parserSourceLocalRow < 0 ||
       ir.originParserNodeStack.len <= 0 ||
       ir.originParserNodeStack[
           ir.originParserNodeStack.len - 1] != parserSourceLocalRow:
        panic("typed expr binding: exact parser origin transaction unavailable")
    var lexicalScopeRow: int32
    var resolutionKind =
        parser.ParserValueExprBindingResolutionNone
    var declarationRow: int32
    var patternRow: int32
    if !parser.ParserValueExprNodeBindingResolutionAt(
           tree,
           parserNodeIndex,
           lexicalScopeRow,
           resolutionKind,
           declarationRow,
           patternRow):
        panic("typed expr binding: sealed parser resolution unavailable")
    let surfaceText =
        parser.ParserValueExprNodeAtomText(tree, parserNodeIndex)
    if resolutionKind ==
           parser.ParserValueExprBindingResolutionNone:
        return TypedExprIrBuildRhsIdentNode(
            ir, ctx, scope, lineNumber, surfaceText)
    if declarationRow < 0 || declarationRow >= tree.declarationCount:
        panic("typed expr binding: resolved declaration row unavailable")
    let parserProducerSourceIndex =
        parser.ParserValueExprNodeProducerSourceIndexAt(
            tree, parserNodeIndex)
    let declarationProducerSourceIndex =
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
    let declarationSourceLocalRow =
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationSourceLocalRows,
            declarationRow)
    let parserFunctionRow =
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationFunctionRows,
            declarationRow)
    # 表达式位置的模块级 `const` 读取(如 `fn main` 里读 `const SlotCount`)在
    # parser 侧是一条真实词法绑定: const 条目经 ParserValueExprProcessBindingEntryRange
    # 发布 Source 作用域的 ParserDeclarationLocal + Pattern
    # (parser.cheng:24002/24111/24179; 作用域父链 9903-9928 使函数体可见),
    # 收据校验器也承认该解析(compiler_parser_receipt.cheng:5697-5720 只要求
    # 声明 kind == ParserDeclarationLocal)。下面的守卫要求声明必须是函数局部,
    # 因为它的两条支路都发精确的**局部**身份引用(OpLocalRef/OpParamRef, 按函数
    # 局部 value-definition 组编址): 模块级声明没有函数局部定义可编址, 在该表示
    # 里不可表示 —— 所以这里不能放宽守卫, 只能先按 `const` 的语义把读取折成常量。
    # `const` 是编译期常量(docs/cheng-formal-spec.md:555; C 链 cold_parser.c:53180
    # parser_find_const -> cold_materialize_const_value:51680 发 BODY_OP_I32_CONST,
    # 从不发存储读), 文本路径的同一标识符早已这样折
    # (TypedExprIrBuildRhsIdentNode -> TypedExprModuleConstLiteralForContext:22464)。
    # 判据与 compilerCsgParserGlobalDeclaration(compiler_csg.cheng:33457-33473)
    # 的模块级全局声明判据同源: Local + functionRow == -1 + Source 作用域。
    # 守卫与其四条判据逐字保留: 模块级 var/let、非字面量 RHS 常量、块内同名
    # 遮蔽、以及生产式不等的任何形态一律照旧 panic, 判据零放宽。
    let declarationLexicalScopeRow =
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeRows,
            declarationRow)
    if resolutionKind ==
           parser.ParserValueExprBindingResolutionPattern &&
       parserFunctionRow < 0 &&
       declarationLexicalScopeRow >= 0 &&
       declarationLexicalScopeRow < tree.declarationLexicalScopeCount &&
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeKinds,
           declarationLexicalScopeRow) ==
           Int32(parser.ParserDeclarationLexicalScopeSource):
        let moduleConstLiteral =
            TypedExprModuleConstLiteralForContext(ctx, share(surfaceText))
        if moduleConstLiteral != "":
            let moduleConstNode = TypedExprIrBuildModuleConstLiteralNode(
                ir,
                strings.CloneStr(ctx.sourcePath),
                strings.CloneStr(scope.name),
                lineNumber,
                strings.CloneStr(surfaceText),
                moduleConstLiteral)
            if moduleConstNode >= 0:
                return moduleConstNode
    if parserProducerSourceIndex < 0 ||
       parserProducerSourceIndex != declarationProducerSourceIndex ||
       declarationSourceLocalRow < 0 || parserFunctionRow < 0:
        panic("typed expr binding: declaration producer identity split")
    if ir.valueExprCurrentParserFunctionRow < 0:
        ir.valueExprCurrentParserFunctionRow = parserFunctionRow
    elif ir.valueExprCurrentParserFunctionRow != parserFunctionRow:
        panic("typed expr binding: parser function identity changed inside TypedExpr function")
    if resolutionKind ==
           parser.ParserValueExprBindingResolutionParameter:
        if patternRow != -1:
            panic("typed expr binding: parameter unexpectedly owns Pattern")
        if declarationRow >= arenamod.ArenaArrayInt32Len(
               ir.arena,
               ir.valueExprTransactionParameterOrdinalsByDeclarationRow) ||
           parserFunctionRow >= arenamod.ArenaArrayInt32Len(
               ir.arena,
               ir.valueExprTransactionParameterCountsByFunctionRow):
            panic("typed expr binding: parameter ordinal index unavailable")
        let parameterOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueExprTransactionParameterOrdinalsByDeclarationRow,
            declarationRow)
        let parameterCount = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueExprTransactionParameterCountsByFunctionRow,
            parserFunctionRow)
        ir.valueExprTransactionParameterOrdinalLookupCount =
            ir.valueExprTransactionParameterOrdinalLookupCount + 1
        if parameterOrdinal < 0 ||
           parameterCount !=
               ir.valueExprCurrentParamDefinitionNodeIndexes.len ||
           parameterCount !=
               ir.valueExprCurrentParamValueDefinitionRows.len:
            panic("typed expr binding: parameter declaration/ABI slot coverage drift")
        let templateNodeIndex =
            ir.valueExprCurrentParamDefinitionNodeIndexes[
                parameterOrdinal]
        if templateNodeIndex < 0 ||
           templateNodeIndex >= ir.nodes2_nodeIndexs.len ||
           ir.nodes2_opKinds[templateNodeIndex] !=
               TypedExprIrOpParamRef ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_paramSlots,
               templateNodeIndex) != parameterOrdinal:
            panic("typed expr binding: parameter ABI slot identity drift")
        return typedExprIrAddExactBindingRefNode(
            ir,
            ctx,
            scope,
            lineNumber,
            surfaceText,
            templateNodeIndex,
            TypedExprIrOpParamRef,
            parserNodeIndex,
            parserProducerSourceIndex,
            declarationSourceLocalRow,
            -1,
            ir.valueExprCurrentParamValueDefinitionRows[
                parameterOrdinal])
    if resolutionKind !=
           parser.ParserValueExprBindingResolutionPattern ||
       patternRow < 0 || patternRow >= tree.patternCount:
        panic("typed expr binding: unsupported parser resolution kind")
    if arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.patternProducerSourceIndexes,
           patternRow) != parserProducerSourceIndex ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.patternBindingDeclarationRows,
           patternRow) != declarationRow:
        panic("typed expr binding: Pattern declaration identity split")
    let patternSourceLocalRow =
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternSourceLocalRows,
            patternRow)
    let valueDefinitionRow =
        typedExprIrExactLocalValueDefinitionRow(
            ir,
            patternRow,
            parserProducerSourceIndex,
            declarationSourceLocalRow,
            patternSourceLocalRow,
            ir.functions2_functionNameIds.len)
    let templateNodeIndex =
        TypedExprValueDefinitionDefiningTypedNodeIndexAt(
            ir, valueDefinitionRow)
    return typedExprIrAddExactBindingRefNode(
        ir,
        ctx,
        scope,
        lineNumber,
        surfaceText,
        templateNodeIndex,
        TypedExprIrOpLocalRef,
        parserNodeIndex,
        parserProducerSourceIndex,
        declarationSourceLocalRow,
        patternSourceLocalRow,
        valueDefinitionRow)

@borrows
fn TypedExprIrBuildRhsIdentifierFromParser(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        parserNodeIndex: int32): int32 =
    if ir.valueExprTree == nil || !ir.valueExprTreeBorrowLease ||
       parserNodeIndex < 0 ||
       parserNodeIndex >=
           parser.ParserValueExprTreeNodeCount(ir.valueExprTree):
        panic("typed expr binding: exact parser Identifier unavailable")
    add(
        ir.originParserNodeStack,
        parser.ParserValueExprNodeSourceLocalIndexAt(
            ir.valueExprTree, parserNodeIndex))
    let nodeIndex = typedExprIrBuildRhsIdentifierFromParserActive(
        ir, ctx, scope, lineNumber, parserNodeIndex)
    setLen(
        ir.originParserNodeStack,
        ir.originParserNodeStack.len - 1)
    return nodeIndex

# wall31: 赋值 LHS 参数引用的 fresh detached ParamRef 副本。类型/结构
# TypeId/托管与证明/槽位/可变性逐列拷贝载体; binding 五列 -1 +
# originParserNodeId=-1 + Desugared/NoSource 拼写(wall26 同款, binding
# 审计空身份臂 continue 接受), producedValueDefinitionRows 保持 -1:
# 引用副本永非 defining node, 可被语句所有权声明器安全盖章。
@borrows
fn typedExprIrAddLhsFreshParamRefNode(ir: var TypedExprIr,
                                      ctx: var TypedExprSourceContext,
                                      scope: TypedExprFunctionScope,
                                      lineNumber: int32,
                                      surfaceText: str,
                                      templateNodeIndex: int32): int32 =
    if templateNodeIndex < 0 ||
       templateNodeIndex >= ir.nodes2_nodeIndexs.len ||
       ir.nodes2_opKinds[templateNodeIndex] !=
           TypedExprIrOpParamRef:
        panic("typed expr: lhs fresh param ref template unavailable")
    let templateTypeResult: Result[str] = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_resultTypeIds[templateNodeIndex])
    if !IsOk(templateTypeResult):
        panic("typed expr: lhs fresh param ref template type unavailable")
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginDesugared
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = share(ctx.sourcePath)
    node.functionName = share(scope.name)
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpParamRef
    node.resultType = Value(templateTypeResult)
    typedExprIrBindNodeStructuralType(
        ir,
        node,
        arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_structuralTypeIds,
            templateNodeIndex))
    node.surfaceText = share(surfaceText)
    node.paramName = share(surfaceText)
    node.paramSlot = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.nodes2_paramSlots, templateNodeIndex)
    node.paramMutableFlag =
        ir.nodes2_paramMutableFlags[templateNodeIndex]
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrBuildRhsIdentNode(ir: var TypedExprIr,
                                 ctx: var TypedExprSourceContext,
                                 scope: TypedExprFunctionScope,
                                 lineNumber: int32,
                                 name: str): int32 =
    if ir.paramRefIndexBucketHeads.len <= 0:
        TypedExprIrParamRefIndexBuildAll(ir)
    if ir.paramRefIndexBucketHeads.len > 0:
        # 索引路径: 复刻原逆扫语义 — 只在 nodes2 尾块属主 == (scope,src) 时找该键
        # ParamRef, 返回尾块内最高 nodeIndex 命中。链上条目可能跨可达轮 stale
        # (compiler_csg 轮间清 nodes2 不清本索引), 故逐条对现役 nodes2 复验
        # (界内 + 段首内 + 属主 id + ParamRef + 参数名) 取最大合法位; 无合法命中
        # = miss 落穿 (原 break-on-foreign 边界), 绝不短路后续 enum/const 解析。
        if ir.nodes2_nodeIndexs.len > 0:
            let tailFnRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodesTailOwnerFunctionNameId)
            let tailSrcRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodesTailOwnerSourcePathId)
            if IsOk(tailFnRes) && IsOk(tailSrcRes) &&
               Value(tailFnRes) == scope.name && Value(tailSrcRes) == ctx.sourcePath:
                let bucket = TypedExprIrParamRefIndexHash(ctx.sourcePath,
                                                          scope.name,
                                                          name,
                                                          ir.paramRefIndexBucketHeads.len)
                var bestParamNodeIndex: int32 = -1
                var entryIndex = ir.paramRefIndexBucketHeads[bucket]
                while entryIndex >= 0:
                    if ir.paramRefIndexEntryParamNames[entryIndex] == name &&
                       ir.paramRefIndexEntryFunctionNames[entryIndex] == scope.name &&
                       ir.paramRefIndexEntrySourcePaths[entryIndex] == ctx.sourcePath:
                        let paramNodeIndex = ir.paramRefIndexEntryNodeIndexes[entryIndex]
                        if paramNodeIndex >= ir.nodesTailBlockStartNodeIndex &&
                           paramNodeIndex < ir.nodes2_nodeIndexs.len &&
                           paramNodeIndex > bestParamNodeIndex:
                            if ir.nodes2_opKinds[paramNodeIndex] == TypedExprIrOpParamRef &&
                               ir.nodes2_functionNameIds[paramNodeIndex] == ir.nodesTailOwnerFunctionNameId &&
                               ir.nodes2_sourcePathIds[paramNodeIndex] == ir.nodesTailOwnerSourcePathId:
                                let entryParamNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_paramNameIds[paramNodeIndex])
                                if IsOk(entryParamNameRes) && Value(entryParamNameRes) == name:
                                    bestParamNodeIndex = paramNodeIndex
                    entryIndex = ir.paramRefIndexEntryNext[entryIndex]
                if bestParamNodeIndex >= 0:
                    if typedExprLhsFreshParamRefActive:
                        # wall31: LHS 窗口内绝不发布共享定义载体本身,
                        # 改发可被语句安全盖章的 fresh 引用副本。
                        return typedExprIrAddLhsFreshParamRefNode(
                            ir,
                            ctx,
                            scope,
                            lineNumber,
                            name,
                            bestParamNodeIndex)
                    return bestParamNodeIndex
    elif ir.nodes2_nodeIndexs.len > 0:
        panic("typed expr: rhs ident node requires param ref index")
    var enumTypeName = ""
    var enumOrdinal: int32
    if TypedExprIrLookupEnumConstValue(ir, ctx.sourcePath, name, enumTypeName, enumOrdinal):
        return TypedExprIrAddRhsLeafNode(ir,
                                         strings.CloneStr(ctx.sourcePath),
                                         strings.CloneStr(scope.name),
                                         lineNumber,
                                         TypedExprIrOpI32Const,
                                         "int32",
                                         strings.CloneStr(name),
                                         IntToStr(enumOrdinal))
    # [w40-textpath-const] 模块级 `const` 在文本路径必须先折成常量节点。
    # `const` 是编译期常量(docs/cheng-formal-spec.md:555; C 链 cold_parser.c:53180
    # parser_find_const -> cold_materialize_const_value:51680 发 BODY_OP_I32_CONST,
    # 从不发存储读)。模块级 `const` 条目自 s1b_step3l 起也进 ctx.bindings 的
    # globalFlag 行(:54963 inGlobalConstBlock), 而 TypedExprLookupBindingBestIndex
    # 把 globalFlag 纳入函数内可见集(:50556), 函数体里读该名时
    # TypedExprBindingRhsLocalRefType 返回非空类型文本, 下面 refType=="" 的既有
    # const 折叠被跳过, 落进 TypedExprIrAddRhsLocalRefNode 发一个"函数局部槽读"
    # 节点: 模块级声明没有函数局部 value-definition 组可编址(wall43 模板解析
    # :20760-20771 要求 declarationFunctionRows == 当前 parser 函数行), 该节点
    # structuralTypeId 只能保持 -1, compiler csg 精确生产 TypeId 门
    # (compiler_csg.cheng:34393)hard-fail(实测定长数组四件 node=8 op=38
    # o0=-1 o1=-1); 该节点即便过门也不可下降——primary 的 ParamRef/LocalRef 臂
    # 要求 bindingValueDefinitionRow >= 0(primary_object_plan.cheng:18055-18062)。
    # 判据只认"本行胜出绑定为模块级"(globalFlag 且 functionName==""), 同名函数
    # 局部遮蔽时胜出绑定非模块级, 原本地路径逐字不变; constLiteral=="" 时原样
    # 落穿(模块级 var/let 与不可物化常量的行为逐字不变), 判据零放宽。
    let moduleConstBindingRow = TypedExprLookupBindingBestIndex(
        ctx,
        TypedExprScopeIndexForLine(ctx.scopes, lineNumber),
        lineNumber,
        share(name))
    var moduleScopeBindingRef = false
    if moduleConstBindingRow >= 0 &&
       ctx.bindings[moduleConstBindingRow].globalFlag &&
       ctx.bindings[moduleConstBindingRow].functionName == "":
        moduleScopeBindingRef = true
    let refType = TypedExprBindingRhsLocalRefType(ir,
                                                   ctx,
                                                   share(scope),
                                                   lineNumber,
                                                   share(name))
    if refType == "" || moduleScopeBindingRef:
        let constLiteral = TypedExprModuleConstLiteralForContext(
            ctx, share(name))
        if constLiteral != "":
            let constNode = TypedExprIrBuildModuleConstLiteralNode(ir,
                                                                   strings.CloneStr(ctx.sourcePath),
                                                                   strings.CloneStr(scope.name),
                                                                   lineNumber,
                                                                   strings.CloneStr(name),
                                                                   constLiteral)
            if constNode >= 0:
                return constNode
        if TypedExprEnclosingForRangeBindingIsI32(ctx,
                                                   share(scope),
                                                   lineNumber,
                                                   share(name)):
            return TypedExprIrAddRhsLocalRefNode(ir,
                                                 strings.CloneStr(ctx.sourcePath),
                                                 strings.CloneStr(scope.name),
                                                 lineNumber,
                                                 strings.CloneStr(name),
                                                 "int32")
        typedExprRhsNodeSkipReason = "badtype"
        if TypedExprIrRhsNodeTraceEnabled():
            os.WriteLine(os.Get_stderr(),
                         Fmt"phase=rhs_node_ident_miss name={name} line={lineNumber}")
        return -1
    if TypedExprStripVarType(refType) == "range" &&
       TypedExprEnclosingForRangeBindingIsI32(ctx,
                                               share(scope),
                                               lineNumber,
                                               share(name)):
        return TypedExprIrAddRhsLocalRefNode(ir,
                                             strings.CloneStr(ctx.sourcePath),
                                             strings.CloneStr(scope.name),
                                             lineNumber,
                                             strings.CloneStr(name),
                                             "int32")
    if TypedExprStripVarType(refType) == "range":
        let forSeqElemType = TypedExprEnclosingForSeqBindingElementType(ir,
                                                                       ctx,
                                                                       share(scope),
                                                                       lineNumber,
                                                                       share(name))
        if forSeqElemType != "":
            return TypedExprIrAddRhsLocalRefNode(ir,
                                                 strings.CloneStr(ctx.sourcePath),
                                                 strings.CloneStr(scope.name),
                                                 lineNumber,
                                                 strings.CloneStr(name),
                                                 TypedExprIrRuntimeScalarType(ir, ctx.sourcePath, forSeqElemType))
    return TypedExprIrAddRhsLocalRefNode(ir,
                                         strings.CloneStr(ctx.sourcePath),
                                         strings.CloneStr(scope.name),
                                         lineNumber,
                                         strings.CloneStr(name),
                                         TypedExprIrRuntimeScalarType(ir, ctx.sourcePath, refType))

type
    typedExprFieldHopState = ref object
        currentNode: int32
        surface: str

@borrows
fn typedExprIrBuildRhsFieldHopsRec(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        parts: str[],
        i: int32,
        st: typedExprFieldHopState): bool =
    while true:
        if i >= parts.len:
            return true
        let part = chengpath.PathTrim(share(parts[i]))
        if part == "" || parser.ParserIdentPrefix(part) != part:
            return false
        let fhBaseTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[st.currentNode])
        var baseType = ""
        if IsOk(fhBaseTypeRes):
            let fhBase_f59: str = Value(fhBaseTypeRes)
            baseType = TypedExprStripVarType(fhBase_f59)
        var baseTypeSourcePath = ctx.sourcePath
        if ir.nodes2_opKinds[st.currentNode] == TypedExprIrOpFieldGet:
            let baseTypeSourceRes: Result[str] = langintern.LookupIntern(
                ir.internPool,
                ir.nodes2_fieldTypeSourcePathIds[st.currentNode])
            if !IsOk(baseTypeSourceRes) || Value(baseTypeSourceRes) == "":
                panic("typed expr: field hop base type owner unavailable")
            baseTypeSourcePath = Value(baseTypeSourceRes)
        var fieldType = ""
        var fieldTypeSourcePath = ""
        var fieldOffset: int32
        var fieldSize: int32
        var fieldAlign: int32
        var fieldProducerSourceIndex: int32
        var fieldOwnerDeclarationSourceLocalRow: int32
        var fieldDeclarationSourceLocalRow: int32
        var fieldOrdinal: int32
        var fieldBuiltinKind: int32
        if !TypedExprIrResolveExactFieldNodeMeta(ir,
                                                 ctx,
                                                 sourceContexts,
                                                 share(baseTypeSourcePath),
                                                 share(baseType),
                                                 share(part),
                                                 fieldTypeSourcePath,
                                                 fieldType,
                                                 fieldOffset,
                                                 fieldSize,
                                                 fieldAlign,
                                                 fieldProducerSourceIndex,
                                                 fieldOwnerDeclarationSourceLocalRow,
                                                 fieldDeclarationSourceLocalRow,
                                                 fieldOrdinal,
                                                 fieldBuiltinKind):
            typedExprRhsNodeSkipReason = "badtype"
            if TypedExprIrRhsNodeTraceEnabled():
                os.WriteLine(os.Get_stderr(),
                             Fmt"phase=rhs_node_fieldhop_miss base={baseType} part={part} surface={st.surface}")
            return false
        st.surface = Fmt"{st.surface}.{part}"
        st.currentNode = TypedExprIrAddRhsFieldGetNode(ir,
                                                       strings.CloneStr(ctx.sourcePath),
                                                       strings.CloneStr(scope.name),
                                                       lineNumber,
                                                       share(st.surface),
                                                       part,
                                                       TypedExprIrRuntimeScalarType(ir, fieldTypeSourcePath, TypedExprNormalizeTypeText(fieldType)),
                                                       fieldTypeSourcePath,
                                                       st.currentNode,
                                                       fieldOffset,
                                                       fieldSize,
                                                       fieldAlign,
                                                       fieldProducerSourceIndex,
                                                       fieldOwnerDeclarationSourceLocalRow,
                                                       fieldDeclarationSourceLocalRow,
                                                       fieldOrdinal,
                                                       fieldBuiltinKind)
        i = i + 1
        continue

@borrows
fn TypedExprIrBuildRhsFieldHopsNode(ir: var TypedExprIr,
                                     ctx: var TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     scope: TypedExprFunctionScope,
                                     lineNumber: int32,
                                     rootNode: int32,
                                     rootSurface: str,
                                     fieldPath: str): int32 =
    var st: typedExprFieldHopState = new(typedExprFieldHopState)
    st.currentNode = rootNode
    st.surface = rootSurface
    let parts = parser.ParserSplitChar(fieldPath, '.')
    if !typedExprIrBuildRhsFieldHopsRec(
           ir, ctx, sourceContexts, scope, lineNumber, parts, 0, st):
        return -1
    return st.currentNode

@borrows
fn TypedExprIrBuildRhsFieldPathNode(ir: var TypedExprIr,
                                     ctx: var TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     scope: TypedExprFunctionScope,
                                     lineNumber: int32,
                                     textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if parser.ParserFindText(text, "->") >= 0:
        return -1
    if !TypedExprTextIsSimpleFieldPath(share(text)):
        return -1
    let rootName = TypedExprAssignLhsRootName(share(text))
    let fieldPath = TypedExprAssignFieldPath(share(text))
    if rootName == "" || fieldPath == "":
        return -1
    let rootNode = TypedExprIrBuildRhsIdentNode(ir, ctx, share(scope), lineNumber, share(rootName))
    if rootNode < 0:
        return -1
    return TypedExprIrBuildRhsFieldHopsNode(ir,
                                            ctx,
                                            sourceContexts,
                                            scope,
                                            lineNumber,
                                            rootNode,
                                            rootName,
                                            fieldPath)

type
    typedExprPostfixChainState = ref object
        currentNode: int32
        surface: str
        cursor: int32
        seenPostfix: bool

@borrows
fn typedExprIrBuildRhsPostfixChainRec(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        text: str,
        st: typedExprPostfixChainState): bool =
    while true:
        if st.cursor >= text.len:
            return st.seenPostfix
        if st.cursor + 1 < text.len && text[st.cursor] == '-' && text[st.cursor + 1] == '>':
            let arrowFieldName = parser.ParserIdentPrefix(chengpath.TextSlice(text,
                                                                              st.cursor + 2,
                                                                              text.len - st.cursor - 2))
            if arrowFieldName == "":
                return false
            let ppBaseRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[st.currentNode])
            let ppBase = if IsOk(ppBaseRes): Value(ppBaseRes) else: ""
            var ppBaseSourcePath = ctx.sourcePath
            if ir.nodes2_opKinds[st.currentNode] == TypedExprIrOpFieldGet:
                let ppBaseSourceRes: Result[str] = langintern.LookupIntern(
                    ir.internPool,
                    ir.nodes2_fieldTypeSourcePathIds[st.currentNode])
                if !IsOk(ppBaseSourceRes) || Value(ppBaseSourceRes) == "":
                    panic("typed expr: arrow base type owner unavailable")
                ppBaseSourcePath = Value(ppBaseSourceRes)
            let pointeeType = TypedExprPointerPointeeType(ctx,
                                                          sourceContexts,
                                                          ppBase)
            if pointeeType == "":
                typedExprRhsNodeSkipReason = "badtype"
                return false
            var arrowFieldType = ""
            var arrowFieldTypeSourcePath = ""
            var arrowFieldOffset: int32
            var arrowFieldSize: int32
            var arrowFieldAlign: int32
            var arrowFieldProducerSourceIndex: int32
            var arrowFieldOwnerDeclarationSourceLocalRow: int32
            var arrowFieldDeclarationSourceLocalRow: int32
            var arrowFieldOrdinal: int32
            var arrowFieldBuiltinKind: int32
            if !TypedExprIrResolveExactFieldNodeMeta(ir,
                                                     ctx,
                                                     sourceContexts,
                                                     ppBaseSourcePath,
                                                     pointeeType,
                                                     arrowFieldName,
                                                     arrowFieldTypeSourcePath,
                                                     arrowFieldType,
                                                     arrowFieldOffset,
                                                     arrowFieldSize,
                                                     arrowFieldAlign,
                                                     arrowFieldProducerSourceIndex,
                                                     arrowFieldOwnerDeclarationSourceLocalRow,
                                                     arrowFieldDeclarationSourceLocalRow,
                                                     arrowFieldOrdinal,
                                                     arrowFieldBuiltinKind):
                typedExprRhsNodeSkipReason = "badtype"
                return false
            st.surface = Fmt"{st.surface}->{arrowFieldName}"
            st.currentNode = TypedExprIrAddRhsFieldGetNode(ir,
                                                        strings.CloneStr(ctx.sourcePath),
                                                        strings.CloneStr(scope.name),
                                                        lineNumber,
                                                        share(st.surface),
                                                        share(arrowFieldName),
                                                        TypedExprIrRuntimeScalarType(ir, arrowFieldTypeSourcePath, TypedExprNormalizeTypeText(arrowFieldType)),
                                                        arrowFieldTypeSourcePath,
                                                        st.currentNode,
                                                        arrowFieldOffset,
                                                        arrowFieldSize,
                                                        arrowFieldAlign,
                                                        arrowFieldProducerSourceIndex,
                                                        arrowFieldOwnerDeclarationSourceLocalRow,
                                                        arrowFieldDeclarationSourceLocalRow,
                                                        arrowFieldOrdinal,
                                                        arrowFieldBuiltinKind)
            st.cursor = st.cursor + 2 + arrowFieldName.len
            st.seenPostfix = true
            continue
        if text[st.cursor] == '.':
            if st.cursor + 1 >= text.len:
                return false
            let fieldName = parser.ParserIdentPrefix(chengpath.TextSlice(text,
                                                                          st.cursor + 1,
                                                                          text.len - st.cursor - 1))
            if fieldName == "":
                return false
            let pdBaseRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[st.currentNode])
            var baseType = ""
            if IsOk(pdBaseRes):
                # form59 residual: hoist Value(Result[str]) before StripVarType
                let pdBase_f59: str = Value(pdBaseRes)
                baseType = TypedExprStripVarType(pdBase_f59)
            var baseTypeSourcePath = ctx.sourcePath
            if ir.nodes2_opKinds[st.currentNode] == TypedExprIrOpFieldGet:
                let baseTypeSourceRes: Result[str] = langintern.LookupIntern(
                    ir.internPool,
                    ir.nodes2_fieldTypeSourcePathIds[st.currentNode])
                if !IsOk(baseTypeSourceRes) || Value(baseTypeSourceRes) == "":
                    panic("typed expr: postfix field base type owner unavailable")
                baseTypeSourcePath = Value(baseTypeSourceRes)
            var fieldType = ""
            var fieldTypeSourcePath = ""
            var fieldOffset: int32
            var fieldSize: int32
            var fieldAlign: int32
            var fieldProducerSourceIndex: int32
            var fieldOwnerDeclarationSourceLocalRow: int32
            var fieldDeclarationSourceLocalRow: int32
            var fieldOrdinal: int32
            var fieldBuiltinKind: int32
            if !TypedExprIrResolveExactFieldNodeMeta(ir,
                                                     ctx,
                                                     sourceContexts,
                                                     baseTypeSourcePath,
                                                     baseType,
                                                     fieldName,
                                                     fieldTypeSourcePath,
                                                     fieldType,
                                                     fieldOffset,
                                                     fieldSize,
                                                     fieldAlign,
                                                     fieldProducerSourceIndex,
                                                     fieldOwnerDeclarationSourceLocalRow,
                                                     fieldDeclarationSourceLocalRow,
                                                     fieldOrdinal,
                                                     fieldBuiltinKind):
                typedExprRhsNodeSkipReason = "badtype"
                return false
            st.surface = Fmt"{st.surface}.{fieldName}"
            st.currentNode = TypedExprIrAddRhsFieldGetNode(ir,
                                                        strings.CloneStr(ctx.sourcePath),
                                                        strings.CloneStr(scope.name),
                                                        lineNumber,
                                                        share(st.surface),
                                                        share(fieldName),
                                                        TypedExprIrRuntimeScalarType(ir, fieldTypeSourcePath, TypedExprNormalizeTypeText(fieldType)),
                                                        fieldTypeSourcePath,
                                                        st.currentNode,
                                                        fieldOffset,
                                                        fieldSize,
                                                        fieldAlign,
                                                        fieldProducerSourceIndex,
                                                        fieldOwnerDeclarationSourceLocalRow,
                                                        fieldDeclarationSourceLocalRow,
                                                        fieldOrdinal,
                                                        fieldBuiltinKind)
            st.cursor = st.cursor + 1 + fieldName.len
            st.seenPostfix = true
            continue
        if text[st.cursor] == '[':
            let closePos = TypedExprFindMatchingBracket(text, st.cursor)
            if closePos <= st.cursor:
                return false
            let indexText = TypedExprSliceTrim(text,
                                               st.cursor + 1,
                                               closePos - st.cursor - 1)
            if indexText == "":
                return false
            let piBaseRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[st.currentNode])
            let elemType = if IsOk(piBaseRes): TypedExprIrRhsIndexElemType(ctx, Value(piBaseRes)) else: ""
            if elemType == "":
                typedExprRhsNodeSkipReason = "badtype"
                return false
            let indexNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                         ctx,
                                                         sourceContexts,
                                                         share(scope),
                                                         lineNumber,
                                                         share(indexText),
                                                         0)
            if indexNode < 0:
                return false
            var elemSize: int32
            var elemAlign: int32
            if !TypedExprTypeLayout(ctx, sourceContexts, elemType, elemSize, elemAlign):
                typedExprRhsNodeSkipReason = "badtype"
                return false
            st.surface = Fmt"{st.surface}[{indexText}]"
            st.currentNode = TypedExprIrAddRhsIndexGetNode(ir,
                                                        strings.CloneStr(ctx.sourcePath),
                                                        strings.CloneStr(scope.name),
                                                        lineNumber,
                                                        share(st.surface),
                                                        TypedExprIrRuntimeScalarType(ir, ctx.sourcePath, elemType),
                                                        st.currentNode,
                                                        indexNode,
                                                        elemSize)
            st.cursor = closePos + 1
            st.seenPostfix = true
            continue
        return false

@borrows
fn TypedExprIrBuildRhsPostfixChainNode(ir: var TypedExprIr,
                                        ctx: var TypedExprSourceContext,
                                        sourceContexts: TypedExprSourceContext[],
                                        scope: TypedExprFunctionScope,
                                        lineNumber: int32,
                                        textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return -1
    let rootName = parser.ParserIdentPrefix(text)
    if rootName == "" || rootName.len >= text.len:
        return -1
    var currentNode: int32 = -1
    var surface = ""
    var cursor: int32
    # Whole-call chain root: `head(args).tail` where head(args) does not span the
    # whole text (a postfix tail like `.len` follows). The plain-ident root path
    # below cannot represent the call, so the entire RHS falls to the text path
    # (no_node). Build the leading call as a whole-call node and start the chain
    # from there; the existing postfix while-loop consumes `.len`/`.field`/`[i]`/
    # `->f` on the call's aggregate/str result. `.len` over a seq result resolves
    # through TypedExprResolveFieldPathMeta (str[] header: offset 0, size 4).
    let chainCallOpenPos = TypedExprFindWholeCallOpenParen(text)
    if chainCallOpenPos > 0:
        let chainCallClosePos = TypedExprFindMatchingParen(text, chainCallOpenPos)
        if chainCallClosePos > chainCallOpenPos && chainCallClosePos + 1 < text.len:
            let chainCallHead = chengpath.PathTrim(chengpath.TextSlice(text, 0, chainCallOpenPos))
            if TypedExprCallHeadIsPlainQualifiedIdent(chainCallHead):
                let chainCallText = chengpath.PathTrim(chengpath.TextSlice(text, 0, chainCallClosePos + 1))
                var chainCallSkipReason = "call"
                let chainCallNode = TypedExprIrBuildRhsWholeCallNode(ir,
                                                                     ctx,
                                                                     sourceContexts,
                                                                     share(scope),
                                                                     lineNumber,
                                                                     share(chainCallText),
                                                                     false,
                                                                     "",
                                                                     chainCallSkipReason)
                if chainCallNode >= 0:
                    currentNode = chainCallNode
                    surface = chainCallText
                    cursor = chainCallClosePos + 1
    if currentNode < 0:
        currentNode = TypedExprIrBuildRhsIdentNode(
            ir, ctx, share(scope), lineNumber, share(rootName))
        if currentNode < 0:
            return -1
        cursor = rootName.len
        surface = rootName
    var st: typedExprPostfixChainState = new(typedExprPostfixChainState)
    st.currentNode = currentNode
    st.surface = surface
    st.cursor = cursor
    if !typedExprIrBuildRhsPostfixChainRec(
           ir, ctx, sourceContexts, scope, lineNumber, text, st):
        return -1
    return st.currentNode

@borrows
fn TypedExprIrBuildRhsIndexedFieldPathNode(ir: var TypedExprIr,
                                            ctx: var TypedExprSourceContext,
                                            sourceContexts: TypedExprSourceContext[],
                                            scope: TypedExprFunctionScope,
                                            lineNumber: int32,
                                            textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if parser.ParserFindText(text, "->") >= 0:
        return -1
    let openPos = TypedExprIrRhsIndexOpenPos(text)
    if openPos <= 0:
        return -1
    let closePos = TypedExprFindMatchingBracket(text, openPos)
    if closePos <= openPos || closePos + 2 >= text.len:
        return -1
    if text[closePos + 1] != '.':
        return -1
    let fieldPath = TypedExprSliceTrim(share(text), closePos + 2, text.len - closePos - 2)
    if fieldPath == "" ||
       parser.ParserFindText(fieldPath, "[") >= 0 ||
       parser.ParserFindText(fieldPath, "(") >= 0:
        return -1
    let baseText = TypedExprSliceTrim(share(text), 0, closePos + 1)
    let baseNode = TypedExprIrBuildRhsIndexNode(ir,
                                                ctx,
                                                sourceContexts,
                                                share(scope),
                                                lineNumber,
                                                share(baseText))
    if baseNode < 0:
        return -1
    return TypedExprIrBuildRhsFieldHopsNode(ir,
                                            ctx,
                                            sourceContexts,
                                            scope,
                                            lineNumber,
                                            baseNode,
                                            baseText,
                                            fieldPath)

@borrows
fn typedExprIrFinishRhsIndexNode(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        text: str,
        indexText: str,
        baseNode: int32): int32 =
    if baseNode < 0:
        return -1
    let idxBaseRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[baseNode])
    var elemType = ""
    if IsOk(idxBaseRes):
        let idxBase = Value(idxBaseRes)
        elemType = TypedExprIrRhsIndexElemType(ctx, idxBase)
    if elemType == "":
        typedExprRhsNodeSkipReason = "badtype"
        return -1
    let indexNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                 ctx,
                                                 sourceContexts,
                                                 share(scope),
                                                 lineNumber,
                                                 indexText,
                                                 0)
    if indexNode < 0:
        return -1
    var elemSize: int32
    var elemAlign: int32
    if !TypedExprTypeLayout(ctx, sourceContexts, elemType, elemSize, elemAlign):
        typedExprRhsNodeSkipReason = "badtype"
        return -1
    let runtimeElemType = TypedExprIrRuntimeScalarType(ir, ctx.sourcePath, elemType)
    let clonedSourcePath = strings.CloneStr(ctx.sourcePath)
    let clonedScopeName = strings.CloneStr(scope.name)
    let ownedText = strings.CloneStr(text)
    return TypedExprIrAddRhsIndexGetNode(ir,
                                         clonedSourcePath,
                                         clonedScopeName,
                                         lineNumber,
                                         ownedText,
                                         runtimeElemType,
                                         baseNode,
                                         indexNode,
                                         elemSize)

@borrows
fn TypedExprIrBuildRhsIndexNode(ir: var TypedExprIr,
                                 ctx: var TypedExprSourceContext,
                                 sourceContexts: TypedExprSourceContext[],
                                 scope: TypedExprFunctionScope,
                                 lineNumber: int32,
                                 textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text.len < 4 || text[text.len - 1] != ']':
        return -1
    let openPos = TypedExprIrRhsIndexOpenPos(text)
    if openPos <= 0:
        return -1
    if TypedExprFindMatchingBracket(text, openPos) != text.len - 1:
        return -1
    let baseText = TypedExprSliceTrim(share(text), 0, openPos)
    let indexText = TypedExprSliceTrim(share(text), openPos + 1, text.len - openPos - 2)
    if baseText == "" || indexText == "":
        return -1
    if parser.ParserIdentPrefix(share(baseText)) == baseText:
        let identNode = TypedExprIrBuildRhsIdentNode(ir, ctx, share(scope), lineNumber, baseText)
        return typedExprIrFinishRhsIndexNode(
            ir, ctx, sourceContexts, scope, lineNumber, text, indexText, identNode)
    let levelNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                 ctx,
                                                 sourceContexts,
                                                 share(scope),
                                                 lineNumber,
                                                 baseText,
                                                 0)
    return typedExprIrFinishRhsIndexNode(
        ir, ctx, sourceContexts, scope, lineNumber, text, indexText, levelNode)

@borrows
fn TypedExprIrBuildRhsQualifiedEnumConstNode(ir: var TypedExprIr,
                                              ctx: var TypedExprSourceContext,
                                              sourceContexts: TypedExprSourceContext[],
                                              scope: TypedExprFunctionScope,
                                              lineNumber: int32,
                                              textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    let qualifier = TypedExprQualifiedCallQualifier(text)
    let constName = TypedExprQualifiedCallLeaf(text)
    if qualifier == "" || constName == "":
        return -1
    if Fmt"{qualifier}.{constName}" != text:
        return -1
    let targetSourcePath = TypedExprLookupQualifiedModuleSourcePath(ctx,
                                                                    sourceContexts,
                                                                    qualifier)
    if targetSourcePath == "":
        return -1
    let targetIndex = TypedExprSourceContextLookupFast(ir, sourceContexts, targetSourcePath)
    if targetIndex < 0:
        return -1
    var ordinal: int32
    let enumState = TypedExprBuildIndexLookup(TypedExprContextsBuildIndex(sourceContexts),
                                              "ctx_enum_name_source",
                                              parser.ParserNormalizePath(strings.CloneStr(targetSourcePath)),
                                              constName,
                                              "",
                                              ordinal)
    if enumState != TypedExprBuildIndexUnique:
        let constLiteral = TypedExprModuleConstLiteralForFrozenContext(
            sourceContexts[targetIndex], share(constName))
        if constLiteral != "":
            return TypedExprIrBuildModuleConstLiteralNode(ir,
                                                          strings.CloneStr(ctx.sourcePath),
                                                          strings.CloneStr(scope.name),
                                                          lineNumber,
                                                          text,
                                                          constLiteral)
        # bail=44 C4 根修: 目标模块 ctx 未带 includeTypeFields 时 enumValueNames 为空,
        # 跨模块限定枚举成员 (parser.NormalizedExprSurfaceCallLocal / os.pcDir) 作
        # call-arg 建不出节点 → 整调用 -1 → bail_44。IR 级合并枚举表 (22646
        # metadataContexts 预灌, 早于任何函数 IR 构建) 已按 sourcePath 记录全模块
        # 枚举值, 用既有 LookupEnumConstValue 按目标模块路径精确解 ordinal。
        var irEnumTypeName = ""
        var irEnumOrdinal: int32
        if TypedExprIrLookupEnumConstValue(ir,
                                           targetSourcePath,
                                           constName,
                                           irEnumTypeName,
                                           irEnumOrdinal):
            return TypedExprIrAddRhsLeafNode(ir,
                                             strings.CloneStr(ctx.sourcePath),
                                             strings.CloneStr(scope.name),
                                             lineNumber,
                                             TypedExprIrOpI32Const,
                                             "int32",
                                             text,
                                             IntToStr(irEnumOrdinal))
        return -1
    return TypedExprIrAddRhsLeafNode(ir,
                                     strings.CloneStr(ctx.sourcePath),
                                     strings.CloneStr(scope.name),
                                     lineNumber,
                                     TypedExprIrOpI32Const,
                                     "int32",
                                     text,
                                     IntToStr(ordinal))

# sizeof(T) is a compile-time constant: resolve the operand type's byte size via
# the canonical type-layout oracle. Returns the size in bytes, or -1 when the
# text is not a whole sizeof(...) call or the operand type cannot be laid out.
# Folding sizeof to a constant node keeps any expression that contains it on the
# node-eval path; without this the call-form node build fails on sizeof and the
# whole RHS falls to the text path, which cannot lower arrow-field call args.
@borrows
fn TypedExprIrSizeofConstBytes(ctx: TypedExprSourceContext,
                                sourceContexts: TypedExprSourceContext[],
                                textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "" || text[text.len - 1] != ')':
        return -1
    let openPos = TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0 || TypedExprFindMatchingParen(text, openPos) != text.len - 1:
        return -1
    let head = chengpath.PathTrim(chengpath.TextSlice(text, 0, openPos))
    if head != "sizeof":
        return -1
    let innerType = chengpath.PathTrim(chengpath.TextSlice(text, openPos + 1, text.len - openPos - 2))
    if innerType == "":
        return -1
    var sizeBytes: int32
    var alignBytes: int32
    if !TypedExprTypeLayout(ctx, sourceContexts, innerType, sizeBytes, alignBytes):
        return -1
    if sizeBytes <= 0:
        return -1
    return sizeBytes

# elemSize[T]() (std/system.cheng) is `return int32(sizeof(T))`. elemSize's
# own declared signature (`(): int32`, no params) carries no visible generic
# placeholder, so PrimaryObjectPlanFunctionIsGenericTemplate classifies it as
# an ordinary, non-template function and it is compiled exactly once, from
# its shared source text. A *bare, explicit-bracket, no-inferable-argument*
# call to it — `elemSize[int64]()`, written directly at a call site with no
# value of type T available to bind from — never gets a per-instantiation
# specialized body, so the `sizeof(T)` fold above only ever sees the literal
# formal name "T" and silently sizes it as 4 bytes regardless of the actual
# T requested (confirmed on production stage3: elemSize[int32/int64/uint64/
# uint8/ptr]() all return 4; std/env.cheng and std/http.cheng call this
# exact bare form via `elemSize[ptr]()` for pointer-array stride arithmetic
# and get the wrong stride on this 8-byte-pointer target). This is narrower
# than "every generic T is erased": std/seqs.cheng's Add/`[]`/`[]=`/setLen
# etc. (whose own signatures DO carry T, e.g. `val: T`) are dispatched by a
# separate, dedicated backend intrinsic path in primary_object_plan.cheng
# (the "generic call path", PrimaryObjectCallTargetIsBuiltin's add/Add/len/
# setLen/reserve/clear entries) that derives elemSize from the call site's
# own concrete declared array/value type directly — verified end-to-end on
# unpatched production stage3 with `var xs: int64[]; seqs.Add(xs,100/200/
# 300); xs[0..2]`, which round-trips exactly (rc=0, no 4-byte-stride data
# corruption). That path never reaches this fold and is untouched by it.
#
# Fix: fold the whole bare call here, reading the concrete type text out of
# the call's own generic bracket at its own call site — exactly mirroring
# TypedExprIrSizeofConstBytes above, which already does this correctly for
# plain `sizeof(concreteType)`. Two independent guards keep this from ever
# turning an honest failure into a silent wrong answer:
#   1. Returns -1 (not this call shape) whenever anything about the shape
#      doesn't match a bare zero-arg `identifier[Type]()`, so any other call
#      shape falls through to ordinary call handling unchanged.
#   2. Returns -1 when the bracket text is itself an unsubstituted generic
#      placeholder (bare single-letter name, e.g. "T"/"U", or var/ref of one
#      — TypedExprTypeIsGenericPlaceholder). This literal-"T" shape is what
#      typed_expr sees today when a *user-defined* generic function's own
#      body writes `elemSize[T]()` with T being that function's own,
#      not-yet-bound type parameter (e.g. `fn wrap[T](): int32 =
#      return elemSize[T]()`); today that already correctly fails compile
#      with ZC_NOT_READY missing_call_target rather than a wrong value
#      (verified: `myWrapB[T](val:T): int32 = elemSize[T]()` reports
#      primary_object_first_missing_call_target_resolution_label=missing at
#      the elemSize[T] call). Without this guard, TypedExprTypeLayout's own
#      pre-existing silent-4-byte fallback for unresolved type names (see
#      ~14004 below) would make this new fold ALSO accept "T" and turn that
#      honest compile failure into a new silent wrong-answer path — a
#      regression this fix must not introduce.
@borrows
fn TypedExprIrElemSizeConstBytes(ctx: TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "" || text[text.len - 1] != ')':
        return -1
    let openPos = TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0 || TypedExprFindMatchingParen(text, openPos) != text.len - 1:
        return -1
    let args = chengpath.PathTrim(chengpath.TextSlice(text, openPos + 1, text.len - openPos - 2))
    if args != "":
        return -1
    let head = chengpath.PathTrim(chengpath.TextSlice(text, 0, openPos))
    # head must be nothing but a (possibly dotted) call target with an
    # optional trailing generic bracket -- e.g. "system.elemSize[ptr]" or
    # "elemSize[ptr]" -- and NOT a larger expression that merely ENDS in
    # such a shape, e.g. "i * system.elemSize[ptr]". TypedExprTypeLeafName
    # below only looks at the text after the last '.', so on that compound
    # head it still returns "elemSize" and the fold below would wrongly
    # collapse the whole `i * elemSize[ptr]()` expression down to the bare
    # elemSize constant, silently dropping the `i *` (confirmed miscompile:
    # `let stride: int32 = i * system.elemSize[ptr]()` folded to `8` instead
    # of `24`). TypedExprCallHeadIsPlainQualifiedIdent (the same guard used
    # at every other whole-call-head site in this file, e.g.
    # TypedExprBootstrapContractValidateWholeCall/TypedExprBindingRhsCallHead)
    # rejects any head containing operators/parens/whitespace outside a
    # plain dotted identifier chain, so compound expressions fall through
    # to ordinary sub-expression handling (which folds `system.elemSize[ptr]()`
    # correctly further down in its own, narrower recursive call) instead of
    # being swallowed whole here.
    if !TypedExprCallHeadIsPlainQualifiedIdent(head):
        return -1
    if TypedExprTypeLeafName(head) != "elemSize":
        return -1
    let genericOpen = parser.ParserFindText(head, "[")
    if genericOpen <= 0:
        return -1
    let genericClose = TypedExprFindMatchingBracket(head, genericOpen)
    if genericClose != head.len - 1:
        return -1
    let innerType = chengpath.PathTrim(chengpath.TextSlice(head, genericOpen + 1, genericClose - genericOpen - 1))
    if innerType == "":
        return -1
    if TypedExprTypeIsGenericPlaceholder(innerType):
        return -1
    var sizeBytes: int32
    var alignBytes: int32
    if !TypedExprTypeLayout(ctx, sourceContexts, innerType, sizeBytes, alignBytes):
        return -1
    if sizeBytes <= 0:
        return -1
    return sizeBytes

@borrows
fn TypedExprIrBuildRhsPrimaryNode(ir: var TypedExprIr,
                                   ctx: var TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   scope: TypedExprFunctionScope,
                                   lineNumber: int32,
                                   textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return -1
    var explicitConversionRecognized = false
    let explicitConversionNode = TypedExprIrBuildExplicitTypeConversionNode(
        ir,
        ctx,
        sourceContexts,
        share(scope),
        lineNumber,
        share(text),
        explicitConversionRecognized)
    if explicitConversionRecognized:
        return explicitConversionNode
    if text[0] == '(' && TypedExprFindMatchingParen(text, 0) == text.len - 1:
        let inner = TypedExprSliceTrim(share(text), 1, text.len - 2)
        if inner == "":
            return -1
        return TypedExprIrBuildRhsNodeLevel(ir, ctx, sourceContexts, scope, lineNumber, inner, 0)
    if TypedExprIrRhsTextIsStringLiteral(share(text)):
        return TypedExprIrAddRhsLeafNode(ir,
                                         ctx.sourcePath,
                                         scope.name,
                                         lineNumber,
                                         TypedExprIrOpStrLit,
                                         "str",
                                         share(text),
                                         text)
    if TypedExprIrTextIsWholeFmtLiteral(share(text)):
        return TypedExprIrBuildFmtNode(ir, ctx, sourceContexts, scope, lineNumber, text)
    if text == "true" || text == "false":
        return TypedExprIrAddRhsLeafNode(ir,
                                         ctx.sourcePath,
                                         scope.name,
                                         lineNumber,
                                         TypedExprIrOpBoolLit,
                                         "bool",
                                         share(text),
                                         text)
    if TypedExprIrRhsTextIsCharLiteral(share(text)):
        return TypedExprIrAddRhsLeafNode(ir,
                                         ctx.sourcePath,
                                         scope.name,
                                         lineNumber,
                                         TypedExprIrOpCharLit,
                                         "char",
                                         share(text),
                                         text)
    if TypedExprIrRhsTextIsF64Literal(share(text)):
        return TypedExprIrAddRhsLeafNode(ir,
                                         ctx.sourcePath,
                                         scope.name,
                                         lineNumber,
                                         TypedExprIrOpF64Const,
                                         "float64",
                                         share(text),
                                         text)
    if TypedExprIrRhsTextIsI32Literal(share(text)):
        return TypedExprIrAddI32ConstNode(ir, ctx.sourcePath, scope.name, lineNumber, text)
    # 超 int32 范围的裸十进制整数字面量（如 2147483648/3000000000）：i32 叶探针
    # 已拒（value > 2147483647），通用 primary 此前无 int64 字面量叶，致 `x <= 2147483648`
    # 等 i64 边界比较的 RHS 建不出节点 → 整比较/if/return 落 no_node。此处建 I64Const 叶
    # （resultType=int64），与既有 const-cast/intConv-arg/local-decl 三处 I64Const 叶同款约定：
    # literalText 保留裸十进制原文，后端 I64Const const-eval 解 64 位常量。仅接纯十进制
    # （剥前导 - 后非 0x/0b 前缀），避免触碰 hex/bin 宽字面量（其位63语义另路处理）。
    # 值不纳 i32 故唯一合法标量类型是 int64，按 int64 物化类型精确。
    if TypedExprTextIsIntegerLiteral(share(text)):
        var wideLitDecStart: int32
        if text[0] == '-':
            wideLitDecStart = 1
        let wideLitIsHexOrBin = wideLitDecStart + 1 < text.len &&
                                text[wideLitDecStart] == '0' &&
                                (text[wideLitDecStart + 1] == 'x' ||
                                 text[wideLitDecStart + 1] == 'X' ||
                                 text[wideLitDecStart + 1] == 'b' ||
                                 text[wideLitDecStart + 1] == 'B')
        if !wideLitIsHexOrBin:
            return TypedExprIrAddRhsLeafNode(ir,
                                             ctx.sourcePath,
                                             scope.name,
                                             lineNumber,
                                             TypedExprIrOpI64Const,
                                             "int64",
                                             share(text),
                                             text)
    let sizeofConstBytes = TypedExprIrSizeofConstBytes(ctx, sourceContexts, share(text))
    if sizeofConstBytes >= 0:
        return TypedExprIrAddI32ConstNode(ir,
                                          ctx.sourcePath,
                                          scope.name,
                                          lineNumber,
                                          IntToStr(sizeofConstBytes))
    let elemSizeConstBytes = TypedExprIrElemSizeConstBytes(ctx, sourceContexts, share(text))
    if elemSizeConstBytes >= 0:
        return TypedExprIrAddI32ConstNode(ir,
                                          ctx.sourcePath,
                                          scope.name,
                                          lineNumber,
                                          IntToStr(elemSizeConstBytes))
    if parser.ParserIdentPrefix(share(text)) == text:
        return TypedExprIrBuildRhsIdentNode(ir, ctx, scope, lineNumber, text)
    if text[text.len - 1] == ')':
        let openPos = TypedExprFindWholeCallOpenParen(text)
        if openPos > 0 && TypedExprFindMatchingParen(text, openPos) == text.len - 1:
            var callSkipReason = "call"
            let callNode = TypedExprIrBuildRhsWholeCallNode(ir,
                                                            ctx,
                                                            sourceContexts,
                                                            scope,
                                                            lineNumber,
                                                            text,
                                                            false,
                                                            "",
                                                            callSkipReason)
            if callNode < 0:
                typedExprRhsNodeSkipReason = strings.CloneStr(callSkipReason)
            return callNode
    let postfixNode = TypedExprIrBuildRhsPostfixChainNode(ir,
                                                          ctx,
                                                          sourceContexts,
                                                          share(scope),
                                                          lineNumber,
                                                          share(text))
    if postfixNode >= 0:
        return postfixNode
    if text[text.len - 1] == ']':
        return TypedExprIrBuildRhsIndexNode(ir, ctx, sourceContexts, scope, lineNumber, text)
    if TypedExprTextIsSimpleFieldPath(share(text)):
        let fieldNode = TypedExprIrBuildRhsFieldPathNode(ir, ctx, sourceContexts, share(scope), lineNumber, share(text))
        if fieldNode >= 0:
            return fieldNode
        return TypedExprIrBuildRhsQualifiedEnumConstNode(ir,
                                                         ctx,
                                                         sourceContexts,
                                                         scope,
                                                         lineNumber,
                                                         text)
    return TypedExprIrBuildRhsIndexedFieldPathNode(ir,
                                                   ctx,
                                                   sourceContexts,
                                                   scope,
                                                   lineNumber,
                                                   text)

@borrows
fn TypedExprIrBuildRhsUnaryNode(ir: var TypedExprIr,
                                 ctx: var TypedExprSourceContext,
                                 sourceContexts: TypedExprSourceContext[],
                                 scope: TypedExprFunctionScope,
                                 lineNumber: int32,
                                 textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return -1
    if text[0] == '!' && text.len > 1 && text[1] != '=':
        let operandText = TypedExprSliceTrim(share(text), 1, text.len - 1)
        if operandText == "":
            return -1
        let operandNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                       ctx,
                                                       sourceContexts,
                                                       share(scope),
                                                       lineNumber,
                                                       operandText,
                                                       10)
        if operandNode < 0:
            return -1
        let unTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[operandNode])
        var unType = ""
        if IsOk(unTypeRes):
            # form59 residual: hoist Value(Result[str]) before StripVarType
            let unType_f59: str = Value(unTypeRes)
            unType = TypedExprStripVarType(unType_f59)
        if unType != "bool":
            typedExprRhsNodeSkipReason = "badtype"
            return -1
        return TypedExprIrAddOpNode(ir,
                                    share(ctx.sourcePath),
                                    share(scope.name),
                                    lineNumber,
                                    TypedExprIrOpLogNot,
                                    "bool",
                                    share(text),
                                    operandNode,
                                    -1,
                                    -1)
    if text[0] == '-' && text.len > 1 && text[1] != '>':
        let operandText = TypedExprSliceTrim(share(text), 1, text.len - 1)
        if operandText == "":
            return -1
        let operandNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                       ctx,
                                                       sourceContexts,
                                                       share(scope),
                                                       lineNumber,
                                                       operandText,
                                                       10)
        if operandNode < 0:
            return -1
        let negTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[operandNode])
        var operandType = ""
        if IsOk(negTypeRes):
            # form59 residual: hoist Value(Result[str]) before StripVarType
            let negType_f59: str = Value(negTypeRes)
            operandType = TypedExprStripVarType(negType_f59)
        # Negation is 0 - x, bit-identical for signed and unsigned (two's
        # complement wraparound). Unsigned operands normalize to the matching
        # signed result width to stay consistent with the binding classifier.
        var negType = ""
        if operandType == "int32" || operandType == "uint32":
            negType = "int32"
        elif operandType == "int64" || operandType == "uint64":
            negType = "int64"
        else:
            typedExprRhsNodeSkipReason = "badtype"
            return -1
        return TypedExprIrAddOpNode(ir,
                                    share(ctx.sourcePath),
                                    share(scope.name),
                                    lineNumber,
                                    TypedExprIrOpNeg,
                                    negType,
                                    share(text),
                                    operandNode,
                                    -1,
                                    -1)
    # `&place` 取址：operand 必须是可取址左值（字段路径 / 局部 / 形参），建
    # FieldGet/LocalRef/ParamRef 子节点，发 AddrOf op（结果恒 8 字节 ptr）。后端
    # 经 VarArgFieldPathInfo 对子节点求 root 槽 + 偏移，再发 base+offset 进 Ptr 槽。
    # 限制到 place 形态，避免对临时/算术结果取址（无稳定地址）。
    if text[0] == '&' && text.len > 1:
        let addrOperandText = TypedExprSliceTrim(share(text), 1, text.len - 1)
        if addrOperandText == "":
            return -1
        # `&FunctionName` 取顶层函数符号地址当 8 字节数据指针（如
        # thread.StartPtr(&worker, ...)）。仅当 operand 是裸标识符、不是
        # local/param 绑定、也不是模块 const，且在本模块函数表里查得到时——建
        # FuncRef 叶子（literalText=函数名），再包进 AddrOf。后端按函数符号发
        # adrp+add（PAGE/PAGEOFF reloc）物化函数入口地址进 Ptr 槽。
        if TypedExprTextIsSimpleIdent(share(addrOperandText)) &&
           TypedExprBindingRhsLocalRefType(ir, ctx, share(scope), lineNumber, share(addrOperandText)) == "" &&
           TypedExprModuleConstLiteralForContext(ctx, share(addrOperandText)) == "":
            var funcRefDeclarationRow: int32
            let funcRefState = typedExprLocalFunctionNameRow(
                ctx, share(addrOperandText), funcRefDeclarationRow)
            if funcRefState == TypedExprBuildIndexUnique:
                let funcRefNode = TypedExprIrAddFuncRefNode(
                    ir,
                    share(ctx.sourcePath),
                    share(scope.name),
                    lineNumber,
                    share(addrOperandText),
                    funcRefDeclarationRow)
                if funcRefNode < 0:
                    return -1
                return TypedExprIrAddOpNode(ir,
                                            share(ctx.sourcePath),
                                            share(scope.name),
                                            lineNumber,
                                            TypedExprIrOpAddrOf,
                                            "ptr",
                                            share(text),
                                            funcRefNode,
                                            -1,
                                            -1)
        let addrOperandNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                           ctx,
                                                           sourceContexts,
                                                           share(scope),
                                                           lineNumber,
                                                           addrOperandText,
                                                           10)
        if addrOperandNode < 0:
            return -1
        let addrOperandKind = ir.nodes2_opKinds[addrOperandNode]
        if addrOperandKind != TypedExprIrOpFieldGet &&
           addrOperandKind != TypedExprIrOpLocalRef &&
           addrOperandKind != TypedExprIrOpParamRef:
            typedExprRhsNodeSkipReason = "badtype"
            return -1
        return TypedExprIrAddOpNode(ir,
                                    share(ctx.sourcePath),
                                    share(scope.name),
                                    lineNumber,
                                    TypedExprIrOpAddrOf,
                                    "ptr",
                                    share(text),
                                    addrOperandNode,
                                    -1,
                                    -1)
    return TypedExprIrBuildRhsPrimaryNode(ir,
                                          ctx,
                                          sourceContexts,
                                          share(scope),
                                          lineNumber,
                                          share(text))

@borrows
fn TypedExprIrAddRhsBinopNode(ir: var TypedExprIr,
                               ctx: var TypedExprSourceContext,
                               scope: TypedExprFunctionScope,
                               lineNumber: int32,
                               surfaceText: str,
                               level: int32,
                               opText: str,
                               lhsNode: int32,
                               rhsNode: int32): int32 =
    var opKind: TypedExprIrOpKind
    var resultType = ""
    let lhsTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[lhsNode])
    let lhsTypeText = if IsOk(lhsTypeRes): Value(lhsTypeRes) else: ""
    let lhsMetaType = TypedExprIrRuntimeScalarType(ir,
                                                   ctx.sourcePath,
                                                   lhsTypeText)
    let rhsTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[rhsNode])
    let rhsTypeText = if IsOk(rhsTypeRes): Value(rhsTypeRes) else: ""
    let rhsMetaType = TypedExprIrRuntimeScalarType(ir,
                                                   ctx.sourcePath,
                                                   rhsTypeText)
    if !TypedExprIrRhsBinopResultMeta(lhsMetaType,
                                      rhsMetaType,
                                      level,
                                      opText,
                                      opKind,
                                      resultType):
        typedExprRhsNodeSkipReason = "badtype"
        return -1
    return TypedExprIrAddOpNode(ir,
                                share(ctx.sourcePath),
                                share(scope.name),
                                lineNumber,
                                opKind,
                                resultType,
                                share(surfaceText),
                                lhsNode,
                                rhsNode,
                                -1)

@borrows
fn TypedExprIrBuildRhsNodeLevel(ir: var TypedExprIr,
                                 ctx: var TypedExprSourceContext,
                                 sourceContexts: TypedExprSourceContext[],
                                 scope: TypedExprFunctionScope,
                                 lineNumber: int32,
                                 textRaw: str,
                                 level: int32): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return -1
    let conditionalNode = TypedExprIrBuildRhsConditionalValueNode(ir,
                                                                 ctx,
                                                                 sourceContexts,
                                                                 share(scope),
                                                                 lineNumber,
                                                                 share(text),
                                                                 "")
    if conditionalNode >= 0:
        return conditionalNode
    if level >= 10:
        return TypedExprIrBuildRhsUnaryNode(ir, ctx, sourceContexts, scope, lineNumber, text)
    let split = TypedExprIrRhsFindSplit(share(text), level)
    if split < 0:
        return TypedExprIrBuildRhsNodeLevel(ir,
                                            ctx,
                                            sourceContexts,
                                            scope,
                                            lineNumber,
                                            text,
                                            level + 1)
    let opPos = split / 4
    let opLen = split % 4
    if opPos <= 0 || opPos + opLen >= text.len:
        return -1
    let opText = chengpath.TextSlice(share(text), opPos, opLen)
    let lhsText = TypedExprSliceTrim(share(text), 0, opPos)
    let rhsText = TypedExprSliceTrim(share(text), opPos + opLen, text.len - opPos - opLen)
    if lhsText == "" || rhsText == "":
        return -1
    if level == 5 &&
       (opText == "==" || opText == "!=") &&
       (lhsText == "nil" || rhsText == "nil"):
        if lhsText == "nil" && rhsText == "nil":
            typedExprRhsNodeSkipReason = "badtype"
            return -1
        var typedSideNode: int32 = -1
        var nilSideNode: int32 = -1
        if lhsText == "nil":
            typedSideNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                         ctx,
                                                         sourceContexts,
                                                         share(scope),
                                                         lineNumber,
                                                         rhsText,
                                                         level + 1)
            if typedSideNode >= 0:
                let nlTypeRes1: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[typedSideNode])
                let nlTypeText1 = if IsOk(nlTypeRes1): Value(nlTypeRes1) else: ""
                nilSideNode = TypedExprIrAddTypedNilPtrNode(ir,
                                                            ctx,
                                                            sourceContexts,
                                                            share(scope),
                                                            lineNumber,
                                                            nlTypeText1)
            if nilSideNode < 0:
                typedExprRhsNodeSkipReason = "badtype"
                return -1
            return TypedExprIrAddRhsBinopNode(ir,
                                              ctx,
                                              scope,
                                              lineNumber,
                                              text,
                                              level,
                                              opText,
                                              nilSideNode,
                                              typedSideNode)
        typedSideNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                     ctx,
                                                     sourceContexts,
                                                     share(scope),
                                                     lineNumber,
                                                     lhsText,
                                                     level)
        if typedSideNode >= 0:
            let nlTypeRes2: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[typedSideNode])
            let nlTypeText2 = if IsOk(nlTypeRes2): Value(nlTypeRes2) else: ""
            nilSideNode = TypedExprIrAddTypedNilPtrNode(ir,
                                                        ctx,
                                                        sourceContexts,
                                                        share(scope),
                                                        lineNumber,
                                                        nlTypeText2)
        if nilSideNode < 0:
            typedExprRhsNodeSkipReason = "badtype"
            return -1
        return TypedExprIrAddRhsBinopNode(ir,
                                          ctx,
                                          scope,
                                          lineNumber,
                                          text,
                                          level,
                                          opText,
                                          typedSideNode,
                                          nilSideNode)
    let lhsNode = TypedExprIrBuildRhsNodeLevel(ir,
                                               ctx,
                                               sourceContexts,
                                               share(scope),
                                               lineNumber,
                                               lhsText,
                                               level)
    if lhsNode < 0:
        return -1
    let rhsNode = TypedExprIrBuildRhsNodeLevel(ir,
                                               ctx,
                                               sourceContexts,
                                               share(scope),
                                               lineNumber,
                                               rhsText,
                                               level + 1)
    if rhsNode < 0:
        return -1
    return TypedExprIrAddRhsBinopNode(ir,
                                      ctx,
                                      scope,
                                      lineNumber,
                                      text,
                                      level,
                                      opText,
                                      lhsNode,
                                      rhsNode)

@borrows
fn TypedExprIrBuildRhsConditionalValueNode(ir: var TypedExprIr,
                                            ctx: var TypedExprSourceContext,
                                            sourceContexts: TypedExprSourceContext[],
                                            scope: TypedExprFunctionScope,
                                            lineNumber: int32,
                                            textRaw: str,
                                            expectedTypeRaw: str): int32 =
    let text = TypedExprStripWrappingParens(textRaw)
    if text == "":
        return -1
    let ternaryNode = TypedExprIrBuildRhsTernaryNode(ir,
                                                     ctx,
                                                     sourceContexts,
                                                     share(scope),
                                                     lineNumber,
                                                     share(text),
                                                     share(expectedTypeRaw))
    if ternaryNode >= 0:
        return ternaryNode
    return TypedExprIrBuildRhsIfExprNode(ir,
                                         ctx,
                                         sourceContexts,
                                         scope,
                                         lineNumber,
                                         text,
                                         expectedTypeRaw)

@borrows
fn TypedExprIrBuildRhsTernaryNode(ir: var TypedExprIr,
                                   ctx: var TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   scope: TypedExprFunctionScope,
                                   lineNumber: int32,
                                   textRaw: str,
                                   expectedTypeRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    # 整体被一层匹配括号包裹的三元(嵌套链的 false 臂 `(b ? c : d)`):剥一层外括号
    # 再解析,否则顶层 `?` 落在括号内(depth>0)→ FindTopLevelTextToken 返 -1 →
    # 建不出嵌套三元节点 → 整 `a ? x : (b ? y : z)` 的 rhsNodeIndex=-1 → no_node。
    # 仅整体包裹时剥(`(a) ? b : c` 非整体包裹,不剥)。非三元内层 qPos<=0 仍返 -1
    # 无害。surfaceText 仍用原 text 保留源文。
    var ternaryText = share(text)
    if ternaryText.len >= 2 && ternaryText[0] == '(' &&
       TypedExprFindMatchingParen(ternaryText, 0) == ternaryText.len - 1:
        ternaryText = TypedExprSliceTrim(ternaryText, 1, ternaryText.len - 2)
    let qPos = TypedExprFindTopLevelTextToken(ternaryText, "?")
    if qPos <= 0:
        return -1
    let tailText = TypedExprSliceTrim(ternaryText, qPos + 1, ternaryText.len - qPos - 1)
    let colonRel = TypedExprFindTopLevelTextToken(tailText, ":")
    if colonRel < 0:
        return -1
    let condText = TypedExprSliceTrim(ternaryText, 0, qPos)
    let trueText = TypedExprSliceTrim(tailText, 0, colonRel)
    let falseText = TypedExprSliceTrim(tailText,
                                       colonRel + 1,
                                       tailText.len - colonRel - 1)
    if condText == "" || trueText == "" || falseText == "":
        return -1
    let condNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                ctx,
                                                sourceContexts,
                                                share(scope),
                                                lineNumber,
                                                condText,
                                                0)
    if condNode < 0:
        return -1
    let condTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[condNode])
    var condType = ""
    if IsOk(condTypeRes):
        # form59 residual: hoist Value(Result[str]) before StripVarType
        let condType_f59: str = Value(condTypeRes)
        condType = TypedExprStripVarType(condType_f59)
    if condType != "bool":
        typedExprRhsNodeSkipReason = "badtype"
        return -1
    let expectedType = TypedExprNormalizeTypeText(TypedExprStripVarType(expectedTypeRaw))
    let trueNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                  ctx,
                                                                  sourceContexts,
                                                                  share(scope),
                                                                  lineNumber,
                                                                  trueText,
                                                                  share(expectedType))
    if trueNode < 0:
        return -1
    let falseNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                   ctx,
                                                                   sourceContexts,
                                                                   share(scope),
                                                                   lineNumber,
                                                                   falseText,
                                                                   share(expectedType))
    if falseNode < 0:
        return -1
    var resultType = expectedType
    if resultType == "" || resultType == "unknown":
        let trueNodeTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[trueNode])
        let falseNodeTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[falseNode])
        if !IsOk(trueNodeTypeRes) || !IsOk(falseNodeTypeRes) ||
           Value(trueNodeTypeRes) != Value(falseNodeTypeRes):
            typedExprRhsNodeSkipReason = "badtype"
            return -1
        resultType = Value(trueNodeTypeRes)
    return TypedExprIrAddOpNode(ir,
                                share(ctx.sourcePath),
                                share(scope.name),
                                lineNumber,
                                TypedExprIrOpLocalBoolEnumTernary,
                                resultType,
                                share(text),
                                condNode,
                                trueNode,
                                falseNode)

@borrows
fn TypedExprIrBuildRhsIfExprNode(ir: var TypedExprIr,
                                  ctx: var TypedExprSourceContext,
                                  sourceContexts: TypedExprSourceContext[],
                                  scope: TypedExprFunctionScope,
                                  lineNumber: int32,
                                  textRaw: str,
                                  expectedTypeRaw: str): int32 =
    # Value-form `if cond: A else: B` builds the same select node as the ternary
    # `cond ? A : B` (TypedExprIrOpLocalBoolEnumTernary). Parse the three
    # segments identically to TypedExprBindingRhsIfExprType so the binding type
    # and the built node agree.
    let text = chengpath.PathTrim(textRaw)
    if text.len < 4 || !parser.ParserStartsWith(text, "if "):
        return -1
    let elsePos = TypedExprFindTopLevelTextToken(text, "else:")
    if elsePos <= 3:
        return -1
    var colonPos = -1
    var scan = 3
    var depth = 0
    while scan < elsePos:
        if text[scan] == '(' || text[scan] == '[':
            depth = depth + 1
        elif text[scan] == ')' || text[scan] == ']':
            depth = depth - 1
        elif text[scan] == ':' && depth == 0:
            colonPos = scan
            break
        scan = scan + 1
    if colonPos <= 3:
        return -1
    let condText = TypedExprSliceTrim(text, 3, colonPos - 3)
    let thenText = TypedExprSliceTrim(text, colonPos + 1, elsePos - colonPos - 1)
    let elseText = TypedExprSliceTrim(text, elsePos + 5, text.len - elsePos - 5)
    if condText == "" || thenText == "" || elseText == "":
        return -1
    let condNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                ctx,
                                                sourceContexts,
                                                scope,
                                                lineNumber,
                                                condText,
                                                0)
    if condNode < 0:
        return -1
    let condTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[condNode])
    var condType = ""
    if IsOk(condTypeRes):
        # form59 residual: hoist Value(Result[str]) before StripVarType
        let condType_f59: str = Value(condTypeRes)
        condType = TypedExprStripVarType(condType_f59)
    if condType != "bool":
        typedExprRhsNodeSkipReason = "badtype"
        return -1
    let expectedType = TypedExprNormalizeTypeText(TypedExprStripVarType(expectedTypeRaw))
    let thenNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                  ctx,
                                                                  sourceContexts,
                                                                  share(scope),
                                                                  lineNumber,
                                                                  thenText,
                                                                  share(expectedType))
    if thenNode < 0:
        return -1
    let elseNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                  ctx,
                                                                  sourceContexts,
                                                                  share(scope),
                                                                  lineNumber,
                                                                  elseText,
                                                                  share(expectedType))
    if elseNode < 0:
        return -1
    var resultType = expectedType
    if resultType == "" || resultType == "unknown":
        let thenNodeTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[thenNode])
        let elseNodeTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[elseNode])
        if !IsOk(thenNodeTypeRes) || !IsOk(elseNodeTypeRes) ||
           Value(thenNodeTypeRes) != Value(elseNodeTypeRes):
            typedExprRhsNodeSkipReason = "badtype"
            return -1
        resultType = Value(thenNodeTypeRes)
    return TypedExprIrAddOpNode(ir,
                                share(ctx.sourcePath),
                                share(scope.name),
                                lineNumber,
                                TypedExprIrOpLocalBoolEnumTernary,
                                resultType,
                                text,
                                condNode,
                                thenNode,
                                elseNode)

fn TypedExprIrNodeIsWritableLvalue(ir: var TypedExprIr,
                                    nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_opKinds.len:
        return false
    let opKind = ir.nodes2_opKinds[nodeIndex]
    return opKind == TypedExprIrOpLocalRef ||
           opKind == TypedExprIrOpParamRef ||
           opKind == TypedExprIrOpFieldGet ||
           opKind == TypedExprIrOpIndexGet

@borrows
fn TypedExprIrNodeTypeOwnerSourcePath(ir: var TypedExprIr,
                                       fallbackSourcePathRaw: str,
                                       nodeIndex: int32): str =
    let fallbackSourcePath = parser.ParserNormalizePath(fallbackSourcePathRaw)
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_opKinds.len:
        return fallbackSourcePath
    let opKind = ir.nodes2_opKinds[nodeIndex]
    if opKind == TypedExprIrOpFieldGet:
        let ownerResult: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_fieldTypeSourcePathIds[nodeIndex])
        if IsOk(ownerResult) && Value(ownerResult) != "":
            return parser.ParserNormalizePath(Value(ownerResult))
    if opKind == TypedExprIrOpIndexGet:
        let baseNode = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand0NodeIndexs, nodeIndex)
        return TypedExprIrNodeTypeOwnerSourcePath(ir,
                                                  fallbackSourcePath,
                                                  baseNode)
    if opKind == TypedExprIrOpCallExpr:
        let ownerResult: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_callTargetSourcePathIds[nodeIndex])
        if IsOk(ownerResult) && Value(ownerResult) != "":
            return parser.ParserNormalizePath(Value(ownerResult))
    return fallbackSourcePath

@borrows
fn TypedExprIrBuildExplicitTypeConversionNode(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        textRaw: str,
        recognizedOut: var bool): int32 =
    recognizedOut = false
    var targetType = ""
    var operandText = ""
    var borrow = false
    if !TypedExprExplicitTypeConversionSurface(textRaw,
                                                targetType,
                                                operandText,
                                                borrow) ||
       !TypedExprExplicitTypeTargetVisible(ctx,
                                          sourceContexts,
                                          targetType):
        return -1
    let operandType = TypedExprStaticExprTypeAtLevel(ctx,
                                                     sourceContexts,
                                                     scope,
                                                     lineNumber,
                                                     operandText,
                                                     0)
    let staticKind = TypedExprExplicitTypeConversionClassify(
        ctx,
        sourceContexts,
        ctx.sourcePath,
        targetType,
        ctx.sourcePath,
        operandType,
        borrow,
        TypedExprExplicitTypeConversionPlaceUnknown)
    if staticKind == TypedExprExplicitTypeConversionNone ||
       staticKind == TypedExprExplicitTypeConversionScalar ||
       staticKind == TypedExprExplicitTypeConversionDeferred:
        return -1
    recognizedOut = true
    let operandNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(
        ir,
        ctx,
        sourceContexts,
        scope,
        lineNumber,
        operandText,
        share(targetType))
    if operandNode < 0:
        return -1
    let realizedKind = TypedExprExplicitTypeConversionClassify(
        ctx,
        sourceContexts,
        ctx.sourcePath,
        targetType,
        TypedExprIrNodeTypeOwnerSourcePath(ir,
                                           ctx.sourcePath,
                                           operandNode),
        operandType,
        borrow,
        TypedExprExplicitTypeConversionPlaceUnknown)
    if realizedKind != staticKind:
        panic("typed expr: explicit type conversion resolver/realizer drift")
    return operandNode

@borrows
fn TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir: var TypedExprIr,
                                                   ctx: var TypedExprSourceContext,
                                                   sourceContexts: TypedExprSourceContext[],
                                                   scope: TypedExprFunctionScope,
                                                   lineNumber: int32,
                                                   textRaw: str,
                                                   expectedTypeRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return -1
    var explicitConversionRecognized = false
    let explicitConversionNode = TypedExprIrBuildExplicitTypeConversionNode(
        ir,
        ctx,
        sourceContexts,
        share(scope),
        lineNumber,
        share(text),
        explicitConversionRecognized)
    if explicitConversionRecognized:
        return explicitConversionNode
    let contextualNode = TypedExprIrBuildContextualLiteralNode(ir,
                                                               ctx,
                                                               sourceContexts,
                                                               share(scope),
                                                               lineNumber,
                                                               share(text),
                                                               share(expectedTypeRaw))
    if contextualNode >= 0:
        return contextualNode
    let conditionalNode = TypedExprIrBuildRhsConditionalValueNode(ir,
                                                                 ctx,
                                                                 sourceContexts,
                                                                 share(scope),
                                                                 lineNumber,
                                                                 share(text),
                                                                 share(expectedTypeRaw))
    if conditionalNode >= 0:
        return conditionalNode
    # Expected-type dispatch is reserved for a bare generic-return whole call.
    # Concrete calls and intrinsic call-shaped expressions must keep flowing
    # through BuildRhsNodeLevel, whose structured primary/postfix builders own
    # sizeof/elemSize/len and the rest of the pre-existing surface.
    if TypedExprWholeCallNeedsExpectedResult(ctx,
                                             sourceContexts,
                                             lineNumber,
                                             text):
        var expectedCallSkipReason = "generic"
        let expectedCallNode = TypedExprIrBuildRhsWholeCallNode(ir,
                                                                ctx,
                                                                sourceContexts,
                                                                scope,
                                                                lineNumber,
                                                                text,
                                                                false,
                                                                expectedTypeRaw,
                                                                expectedCallSkipReason)
        if expectedCallNode >= 0:
            return expectedCallNode
        typedExprRhsNodeSkipReason = strings.CloneStr(expectedCallSkipReason)
        return -1
    return TypedExprIrBuildRhsNodeLevel(ir,
                                        ctx,
                                        sourceContexts,
                                        scope,
                                        lineNumber,
                                        text,
                                        0)

@borrows
fn TypedExprIrAddRhsCallArgLinkNode(ir: var TypedExprIr,
                                     sourcePath: str,
                                     functionName: str,
                                     lineNumber: int32,
                                     surfaceText: str,
                                     valueNode: int32,
                                     nextLink: int32): int32 =
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = TypedExprSyntheticOriginStructuralLink
    node.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpArgLink
    # valueNode may be -1 for a partial-chain placeholder (a ctor field whose value
    # node could not be built): guard the SoA lookup so the -1 position is recorded
    # as an ArgLink with operand0=-1 instead of indexing nodes2_resultTypeIds[-1]
    # (out-of-bounds → bounds trap). Existing callers always pass valueNode>=0, so
    # their behavior is unchanged.
    if valueNode >= 0:
        let calValueTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[valueNode])
        if IsOk(calValueTypeRes):
            node.resultType = Value(calValueTypeRes)
        node.resultStructuralTypeId =
            TypedExprIrNodeStructuralTypeIdAt(ir, valueNode)
        typedExprIrBindNodeStructuralType(
            ir, node, node.resultStructuralTypeId)
        node.exprClass = TypedExprIrNodeExprClassAt(ir, valueNode)
    node.surfaceText = surfaceText
    node.paramSlot = -1
    node.operand0NodeIndex = valueNode
    node.operand1NodeIndex = nextLink
    node.operand2NodeIndex = -1
    return TypedExprIrAddNode(ir, node)

# bail44 enum-成员-实参臂: `rank(Color.Red)` 里实参 head 是枚举类型名而非模块
# 限定, QualifiedEnumConstNode 的模块查找必落空 → 实参建节点 -1 → 实参链
# fail-closed → 后端 AppendCallArgs bail_44。head 经 TypedExprIrTypeIsEnum 判真时
# 按 IR 级合并枚举表 (22646 metadataContexts 预灌) 解成员序数, 按枚举常量约定建
# I32Const 叶 (同 10330 enum-member→I32Const: resultType=int32, literalText=序数,
# 与 11551 枚举构造折叠语义同源: 枚举 i32 背衬)。成员解析不到或成员所属枚举类型
# 与 head 不符 → -1, 调用方原路 fail-closed (不放宽)。
@borrows
fn TypedExprIrBuildEnumScopedConstArgNode(ir: var TypedExprIr,
                                           ctx: var TypedExprSourceContext,
                                           scope: TypedExprFunctionScope,
                                           lineNumber: int32,
                                           argTextRaw: str): int32 =
    let text = chengpath.PathTrim(argTextRaw)
    let qualifier = TypedExprQualifiedCallQualifier(text)
    let memberName = TypedExprQualifiedCallLeaf(text)
    if qualifier == "" || memberName == "":
        return -1
    if Fmt"{qualifier}.{memberName}" != text:
        return -1
    if !TypedExprIrTypeIsEnum(ir, ctx.sourcePath, qualifier):
        return -1
    var enumTypeName = ""
    var enumOrdinal: int32
    if !TypedExprIrLookupEnumConstValue(ir,
                                        ctx.sourcePath,
                                        text,
                                        enumTypeName,
                                        enumOrdinal):
        return -1
    if enumTypeName != qualifier &&
       enumTypeName != TypedExprTypeLeafName(qualifier):
        return -1
    return TypedExprIrAddRhsLeafNode(ir,
                                     ctx.sourcePath,
                                     scope.name,
                                     lineNumber,
                                     TypedExprIrOpI32Const,
                                     "int32",
                                     text,
                                     IntToStr(enumOrdinal))

@borrows
fn TypedExprIrValueExprChildAt(tree: parser.ParserValueExprTree,
                                nodeIndex: int32,
                                childOrdinal: int32): int32 =
    let childCount = parser.ParserValueExprNodeChildCount(tree, nodeIndex)
    if childOrdinal < 0 || childOrdinal >= childCount:
        panic("typed expr: structural value child ordinal out of bounds")
    var child = parser.ParserValueExprNodeFirstChild(tree, nodeIndex)
    var ordinal: int32
    while ordinal < childOrdinal:
        child = parser.ParserValueExprNodeNextSibling(tree, child)
        ordinal = ordinal + 1
    if child < 0 || child >= nodeIndex:
        panic("typed expr: structural value tree is not postorder")
    return child

fn TypedExprIrStructuralValueUnsupportedKind(
        kind: parser.ParserValueExprKind): TypedExprStructuredValueUnsupportedKind =
    if kind == parser.ParserValueExprInvalid:
        return TypedExprStructuredValueInvalid
    if kind == parser.ParserValueExprSpaceCall:
        return TypedExprStructuredValueSpaceCall
    if kind == parser.ParserValueExprTupleLiteral:
        return TypedExprStructuredValueTupleLiteral
    if kind == parser.ParserValueExprBraceLiteral:
        return TypedExprStructuredValueBraceLiteral
    if kind == parser.ParserValueExprSlice:
        return TypedExprStructuredValueSlice
    if kind == parser.ParserValueExprTry:
        return TypedExprStructuredValueTry
    if kind == parser.ParserValueExprIf:
        return TypedExprStructuredValueIf
    if kind == parser.ParserValueExprWhen:
        return TypedExprStructuredValueWhen
    if kind == parser.ParserValueExprCase:
        return TypedExprStructuredValueCase
    if kind == parser.ParserValueExprCaseBranch:
        return TypedExprStructuredValueCaseBranch
    if kind == parser.ParserValueExprComprehension:
        return TypedExprStructuredValueComprehension
    if kind == parser.ParserValueExprFunctionLiteral:
        return TypedExprStructuredValueFunctionLiteral
    if kind == parser.ParserValueExprIteratorLiteral:
        return TypedExprStructuredValueIteratorLiteral
    return TypedExprStructuredValueSupported

fn TypedExprIrValueExprNodeResultType(ir: var TypedExprIr,
                                      nodeIndex: int32): str =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_resultTypeIds.len:
        return ""
    let result = langintern.LookupIntern(ir.internPool,
                                         ir.nodes2_resultTypeIds[nodeIndex])
    if !IsOk(result):
        return ""
    return Value(result)

@borrows
fn TypedExprIrValueExprConversionTarget(
        tree: parser.ParserValueExprTree,
        nodeIndex: int32,
        targetTypeOut: var str,
        borrowOut: var bool): bool =
    targetTypeOut = ""
    borrowOut = false
    if parser.ParserValueExprNodeKindAt(tree, nodeIndex) !=
       parser.ParserValueExprTypeConversion:
        return false
    var targetSurface = chengpath.PathTrim(
        parser.ParserValueExprNodeAtomText(tree, nodeIndex))
    if targetSurface.len > 4 &&
       parser.ParserStartsWith(targetSurface, "var"):
        let boundary = targetSurface[3]
        if boundary == ' ' || boundary == '\t' ||
           boundary == '\r' || boundary == '\n':
            borrowOut = true
            targetSurface = chengpath.PathTrim(
                chengpath.TextSlice(targetSurface, 4,
                                    targetSurface.len - 4))
    if targetSurface == "":
        return false
    targetTypeOut = targetSurface
    return true

@borrows
fn TypedExprIrValueExprSemanticArgumentType(
        ir: var TypedExprIr,
        tree: parser.ParserValueExprTree,
        rootNodeIndex: int32,
        valueNodeIndex: int32): str =
    var targetType = ""
    var borrow = false
    if TypedExprIrValueExprConversionTarget(tree,
                                             rootNodeIndex,
                                             targetType,
                                             borrow):
        let normalizedTarget = TypedExprNormalizeTypeText(targetType)
        if borrow:
            return TypedExprCallBorrowModeType(normalizedTarget)
        return normalizedTarget
    return TypedExprNormalizeTypeText(
        TypedExprIrValueExprNodeResultType(ir, valueNodeIndex))

@borrows
fn TypedExprIrValueExprNodeIsWritablePlace(
        ctx: TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        tree: parser.ParserValueExprTree,
        nodeIndex: int32): bool =
    if tree == nil || nodeIndex < 0:
        return false
    let kind = parser.ParserValueExprNodeKindAt(tree, nodeIndex)
    if kind == parser.ParserValueExprGrouped:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 1:
            return false
        return TypedExprIrValueExprNodeIsWritablePlace(
            ctx,
            scope,
            lineNumber,
            tree,
            TypedExprIrValueExprChildAt(tree, nodeIndex, 0))
    if kind == parser.ParserValueExprIdentifier:
        let name = parser.ParserValueExprNodeAtomText(tree, nodeIndex)
        let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes,
                                                    lineNumber)
        var bindingType = ""
        var bindingSourcePath = ""
        var bindingGlobal = false
        var bindingMutable = false
        if TypedExprLookupBindingMeta(ctx,
                                              scopeIndex,
                                              lineNumber,
                                              name,
                                              bindingType,
                                              bindingSourcePath,
                                              bindingGlobal,
                                              bindingMutable):
            return bindingMutable
        return false
    if kind != parser.ParserValueExprField &&
       kind != parser.ParserValueExprIndex:
        return false
    let expectedChildren = if kind == parser.ParserValueExprField: 1 else: 2
    if parser.ParserValueExprNodeChildCount(tree, nodeIndex) !=
       expectedChildren:
        return false
    return TypedExprIrValueExprNodeIsWritablePlace(
        ctx,
        scope,
        lineNumber,
        tree,
        TypedExprIrValueExprChildAt(tree, nodeIndex, 0))

@borrows
fn TypedExprIrValueExprConversionNodeTarget(
        tree: parser.ParserValueExprTree,
        nodeIndex: int32,
        targetTypeOut: var str,
        borrowOut: var bool): bool =
    if TypedExprIrValueExprConversionTarget(tree,
                                             nodeIndex,
                                             targetTypeOut,
                                             borrowOut):
        return true
    targetTypeOut = ""
    borrowOut = false
    if tree == nil || nodeIndex < 0 ||
       parser.ParserValueExprNodeKindAt(tree, nodeIndex) !=
           parser.ParserValueExprCall ||
       parser.ParserValueExprNodeArgumentRootCount(tree, nodeIndex) != 1:
        return false
    let rootStart = parser.ParserValueExprNodeArgumentRootStart(tree,
                                                                nodeIndex)
    let operandRoot = parser.ParserValueExprRootNodeAt(tree, rootStart)
    if parser.ParserValueExprNodeArgumentName(tree, operandRoot) != "":
        return false
    targetTypeOut = TypedExprIrValueExprCallHead(tree, nodeIndex)
    return targetTypeOut != ""

@borrows
fn TypedExprIrValueExprConversionClassify(
        ir: var TypedExprIr,
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        tree: parser.ParserValueExprTree,
        conversionNodeIndex: int32,
        operandRootNodeIndex: int32,
        operandValueNodeIndex: int32): TypedExprExplicitTypeConversionKind =
    var targetType = ""
    var borrow = false
    if !TypedExprIrValueExprConversionNodeTarget(tree,
                                                  conversionNodeIndex,
                                                  targetType,
                                                  borrow) ||
       !TypedExprExplicitTypeTargetVisible(ctx,
                                          sourceContexts,
                                          targetType):
        return TypedExprExplicitTypeConversionNone
    let operandType = TypedExprIrValueExprNodeResultType(
        ir, operandValueNodeIndex)
    var placeState = TypedExprExplicitTypeConversionPlaceNotWritable
    if TypedExprIrValueExprNodeIsWritablePlace(ctx,
                                                scope,
                                                lineNumber,
                                                tree,
                                                operandRootNodeIndex) &&
       TypedExprIrNodeIsWritableLvalue(ir, operandValueNodeIndex):
        placeState = TypedExprExplicitTypeConversionPlaceWritable
    return TypedExprExplicitTypeConversionClassify(
        ctx,
        sourceContexts,
        ctx.sourcePath,
        targetType,
        TypedExprIrNodeTypeOwnerSourcePath(ir,
                                           ctx.sourcePath,
                                           operandValueNodeIndex),
        operandType,
        borrow,
        placeState)

@borrows
fn TypedExprIrValueExprConversionPreflight(
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        tree: parser.ParserValueExprTree,
        conversionNodeIndex: int32,
        operandRootNodeIndex: int32): TypedExprExplicitTypeConversionKind =
    var targetType = ""
    var borrow = false
    if !TypedExprIrValueExprConversionNodeTarget(tree,
                                                  conversionNodeIndex,
                                                  targetType,
                                                  borrow) ||
       !TypedExprExplicitTypeTargetVisible(ctx,
                                          sourceContexts,
                                          targetType):
        return TypedExprExplicitTypeConversionNone
    let operandSurface = parser.ParserValueExprNodeText(
        tree, operandRootNodeIndex)
    let operandType = TypedExprStaticExprTypeAtLevel(ctx,
                                                     sourceContexts,
                                                     scope,
                                                     lineNumber,
                                                     operandSurface,
                                                     0)
    var placeState = TypedExprExplicitTypeConversionPlaceUnknown
    if borrow:
        placeState = TypedExprExplicitTypeConversionPlaceNotWritable
        if TypedExprIrValueExprNodeIsWritablePlace(ctx,
                                                   scope,
                                                   lineNumber,
                                                   tree,
                                                   operandRootNodeIndex):
            placeState = TypedExprExplicitTypeConversionPlaceWritable
    return TypedExprExplicitTypeConversionClassify(
        ctx,
        sourceContexts,
        ctx.sourcePath,
        targetType,
        ctx.sourcePath,
        operandType,
        borrow,
        placeState)

@borrows
fn TypedExprValueExprValidateConversionsPreflight(
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        tree: parser.ParserValueExprTree,
        nodeIndex: int32) =
    if tree == nil || nodeIndex < 0:
        panic("typed expr: conversion preflight has no parser node")
    let kind = parser.ParserValueExprNodeKindAt(tree, nodeIndex)
    if kind == parser.ParserValueExprTypeConversion:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 1:
            panic("typed expr: conversion preflight arity mismatch")
        let operandRoot = TypedExprIrValueExprChildAt(tree, nodeIndex, 0)
        let conversionKind = TypedExprIrValueExprConversionPreflight(
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            tree,
            nodeIndex,
            operandRoot)
        if conversionKind != TypedExprExplicitTypeConversionIdentity &&
           conversionKind != TypedExprExplicitTypeConversionBorrow:
            panic("typed expr: structural type conversion preflight kind invalid")
    elif kind == parser.ParserValueExprCall &&
         parser.ParserValueExprNodeArgumentRootCount(tree, nodeIndex) == 1:
        let rootStart = parser.ParserValueExprNodeArgumentRootStart(
            tree, nodeIndex)
        let operandRoot = parser.ParserValueExprRootNodeAt(tree, rootStart)
        if parser.ParserValueExprNodeArgumentName(tree, operandRoot) == "":
            let conversionKind = TypedExprIrValueExprConversionPreflight(
                ctx,
                sourceContexts,
                scope,
                lineNumber,
                tree,
                nodeIndex,
                operandRoot)
            if conversionKind == TypedExprExplicitTypeConversionDeferred ||
               conversionKind == TypedExprExplicitTypeConversionBorrow:
                panic("typed expr: call-shaped type conversion leaked borrow mode")
    let childCount = parser.ParserValueExprNodeChildCount(tree, nodeIndex)
    for childOrdinal in 0..<childCount:
        TypedExprValueExprValidateConversionsPreflight(
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            tree,
            TypedExprIrValueExprChildAt(tree, nodeIndex, childOrdinal))

@borrows
fn TypedExprIrValueExprBinaryLevel(operatorText: str): int32 =
    if operatorText == "||": return 0
    if operatorText == "&&": return 1
    if operatorText == "|": return 2
    if operatorText == "^": return 3
    if operatorText == "&": return 4
    if operatorText == "==" || operatorText == "!=": return 5
    if operatorText == "<" || operatorText == "<=" ||
       operatorText == ">" || operatorText == ">=": return 6
    if operatorText == "<<" || operatorText == ">>": return 7
    if operatorText == "+" || operatorText == "-": return 8
    if operatorText == "*" || operatorText == "/" ||
       operatorText == "%": return 9
    return -1

@borrows
fn TypedExprIrValueExprCallHead(tree: parser.ParserValueExprTree,
                                 nodeIndex: int32): str =
    let baseHead = chengpath.PathTrim(
        parser.ParserValueExprNodeAtomText(tree, nodeIndex))
    let genericCount = parser.ParserValueExprNodeExplicitGenericCount(
        tree, nodeIndex)
    if genericCount <= 0:
        return baseHead
    var parts: str[]
    add(parts, share(baseHead))
    add(parts, "[")
    for genericIndex in 0..<genericCount:
        if genericIndex > 0:
            add(parts, ", ")
        add(parts, share(parser.ParserValueExprNodeExplicitGenericText(
            tree, nodeIndex, genericIndex)))
    add(parts, "]")
    return strutil.Join(parts, "")

@borrows
fn TypedExprIrStructuralTypeOwnerSourcePath(
        ir: var TypedExprIr,
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        qualifierRaw: str,
        typeNameRaw: str): str =
    let typeName = parser.ParserIdentPrefix(
        chengpath.PathTrim(typeNameRaw))
    if typeName == "":
        return ""
    let qualifier = chengpath.PathTrim(qualifierRaw)
    if qualifier != "":
        let targetSource = TypedExprLookupQualifiedModuleSourcePath(
            ctx, sourceContexts, qualifier)
        if targetSource == "" ||
           TypedExprIrLookupTypeLayoutRow(ir, targetSource, typeName) < 0:
            return ""
        return parser.ParserNormalizePath(targetSource)
    let currentSource = parser.ParserNormalizePath(ctx.sourcePath)
    if TypedExprIrLookupTypeLayoutRow(ir, currentSource, typeName) >= 0:
        return currentSource
    if !TypedExprSymbolExportedByCase(typeName):
        return ""
    var foundSource = ""
    for importIndex in 0..<TypedExprContextImportCount(ctx):
        let candidate = parser.ParserNormalizePath(
            TypedExprContextImportTargetAt(ctx, importIndex))
        if candidate == "" ||
           TypedExprIrLookupTypeLayoutRow(ir, candidate, typeName) < 0:
            continue
        if foundSource != "" && foundSource != candidate:
            panic(Fmt"typed expr: ambiguous structural type constructor type={typeName}")
        foundSource = candidate
    return foundSource

# Same unique (source, name) row the fact builder registers.  Used when
# IR structural Call cannot rank by arg-owner; Unique only, never copy a
# fact line or invent a target.
@borrows
fn TypedExprLookupSameSourceFunctionDeclFromNameSource(
        currentCtx: TypedExprSourceContext,
        calleeRaw: str,
        targetOut: var str,
        targetSourcePathOut: var str,
        targetSignatureLineNumberOut: var int32,
        importcOut: var bool,
        declarationIndexOut: var int32,
        returnTypeOut: var str): TypedExprBuildIndexLookupState =
    targetOut = ""
    targetSourcePathOut = ""
    targetSignatureLineNumberOut = 0
    importcOut = false
    declarationIndexOut = -1
    returnTypeOut = ""
    let index = currentCtx.buildIndex
    if index == nil || index.released || !index.callDeclarationSealed:
        panic("typed expr: same-source function declaration query without structured index")
    let sourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
    let trimmedName = chengpath.PathTrim(parser.ParserOwnedText(calleeRaw))
    var name = parser.ParserIdentPrefix(trimmedName)
    if name == "":
        name = trimmedName
    if sourcePath == "" || name == "":
        return TypedExprBuildIndexMissing
    var nameSourceRow: int32
    let nameSourceState = TypedExprBuildIndexLookup(
        index,
        "ctx_function_decl_name_source",
        sourcePath,
        name,
        "",
        nameSourceRow)
    if nameSourceState != TypedExprBuildIndexUnique:
        return nameSourceState
    if nameSourceRow < 0 ||
       nameSourceRow >= typedExprBuildIndexCallDeclarationCount(index) ||
       nameSourceRow >= index.callDeclarationKinds.len:
        panic("typed expr: same-source function declaration row unavailable")
    if index.callDeclarationKinds[nameSourceRow] !=
       TypedExprCallDeclarationFunction:
        return TypedExprBuildIndexMissing
    let rowSource = parser.ParserNormalizePath(
        parser.ParserOwnedText(
            typedExprBuildIndexCallSourcePath(index, nameSourceRow)))
    if rowSource != sourcePath:
        return TypedExprBuildIndexMissing
    targetOut = parser.ParserOwnedText(
        typedExprBuildIndexCallTargetSymbol(index, nameSourceRow))
    targetSourcePathOut = rowSource
    targetSignatureLineNumberOut =
        typedExprBuildIndexCallSignatureLineNumber(index, nameSourceRow)
    declarationIndexOut = nameSourceRow
    returnTypeOut = TypedExprCallRuntimeType(
        parser.ParserOwnedText(
            typedExprBuildIndexCallReturnType(index, nameSourceRow)))
    if targetOut == "" || targetSourcePathOut == "" ||
       returnTypeOut == "" || returnTypeOut == "unknown" ||
       returnTypeOut == "call_expr":
        targetOut = ""
        targetSourcePathOut = ""
        targetSignatureLineNumberOut = 0
        declarationIndexOut = -1
        returnTypeOut = ""
        return TypedExprBuildIndexMissing
    return TypedExprBuildIndexUnique

@borrows
fn TypedExprIrResolveStructuralCallAuthority(
        ir: var TypedExprIr,
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        nodeIndex: int32,
        argTypes: str[],
        resultTypeRaw: str,
        targetOut: var str,
        targetSourcePathOut: var str,
        targetSignatureLineNumberOut: var int32,
        importcOut: var bool,
        declarationIndexOut: var int32,
        resultExprClassOut: var TypedExprExprClass,
        resultTypeOut: var str) =
    targetOut = ""
    targetSourcePathOut = ""
    targetSignatureLineNumberOut = 0
    importcOut = false
    declarationIndexOut = -1
    resultExprClassOut = TypedExprExprUnknown
    resultTypeOut = TypedExprCallRuntimeType(resultTypeRaw)
    if resultTypeOut == "unknown" || resultTypeOut == "call_expr":
        resultTypeOut = ""
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease ||
       parser.ParserValueExprNodeKindAt(tree, nodeIndex) !=
           parser.ParserValueExprCall:
        panic("typed expr: call authority requires parser Call node")
    let callee = parser.ParserValueExprNodeNameText(tree, nodeIndex)
    let qualifier = parser.ParserValueExprNodeOwnerText(tree, nodeIndex)
    if callee == "":
        panic("typed expr: structural Call has no static callee")
    let resultIntrinsicDetail =
        parser.ParserResultIntrinsicDetailKind(share(callee))
    if parser.ParserCallNameIsBuiltinCallee(callee) ||
       resultIntrinsicDetail != parser.NormalizedExprDetailNone:
        let primitiveConversion =
            parser.ParserCallNameIsBuiltinPrimitiveConversion(share(callee))
        let builtinValueSemantic =
            parser.ParserBuiltinCallValueSemantic(share(callee))
        if primitiveConversion:
            resultTypeOut = TypedExprNormalizeTypeText(callee)
        elif callee == "sizeof":
            resultTypeOut = "int32"
        if resultTypeOut == "" || resultTypeOut == "unknown" ||
           resultTypeOut == "call_expr":
            resultTypeOut = TypedExprBuiltinCalleeReturnType(
                callee, "", argTypes.len)
        if resultIntrinsicDetail == parser.NormalizedExprDetailResultOk ||
           resultIntrinsicDetail == parser.NormalizedExprDetailResultErr:
            resultExprClassOut = TypedExprIrExprClassForResultTypeExact(
                ir,
                ctx.sourcePath,
                resultTypeOut,
                TypedExprExprOwned)
        elif resultIntrinsicDetail ==
                 parser.NormalizedExprDetailResultValue ||
             resultIntrinsicDetail ==
                 parser.NormalizedExprDetailResultError ||
             resultIntrinsicDetail ==
                 parser.NormalizedExprDetailResultErrorInfoOf:
            resultExprClassOut = TypedExprIrExprClassForResultTypeExact(
                ir,
                ctx.sourcePath,
                resultTypeOut,
                TypedExprExprBorrowed)
        elif builtinValueSemantic == parser.ParserBuiltinValueOwned:
            resultExprClassOut = TypedExprIrExprClassForResultTypeExact(
                ir,
                ctx.sourcePath,
                resultTypeOut,
                TypedExprExprOwned)
        else:
            var builtinHasManaged: bool
            if TypedExprIrTypeContainsManagedStorage(ir,
                                                      ctx.sourcePath,
                                                      resultTypeOut,
                                                      builtinHasManaged) &&
               builtinHasManaged:
                if primitiveConversion:
                    panic(Fmt"typed expr: managed primitive-conversion builtin Call has no normalized value provenance type={resultTypeOut}")
                panic(Fmt"typed expr: managed builtin Call has no normalized value provenance callee={callee} type={resultTypeOut}")
            resultExprClassOut = TypedExprIrExprClassForResultTypeExact(
                ir,
                ctx.sourcePath,
                resultTypeOut,
                TypedExprExprOwned)
        return
    let typeOwner = TypedExprIrStructuralTypeOwnerSourcePath(
        ir, ctx, sourceContexts, qualifier, share(callee))
    # [N3 判点①] 泛型声明聚合构造权威臂。typeOwner 只认 ir_layout 行，而泛型
    # 类型声明按 exact-layout authority state=1 刻意不落 ir_layout
    # （AppendTypeLayoutsFromContext 泛型 continue 臂）。core/option.cheng:7
    # `Option[T](has: true, value: value)`（全仓唯二泛型聚合构造面，用户域
    # import 闭包必拉入）typeOwner 恒空 → 掉进函数声明解析 → unresolved
    # structural Call（r6_opt_min 判词逐字复现）。此处补第二构造权威源：
    # 本源 declaredTypes 精确名匹配 + exact-layout 泛型 authority state=1
    # 证明 + builtinKind None 限定；具体类型已有 ir_layout 行走原臂，本源
    # 之外（含跨层泛型构造头）保持既有 fail-closed 判词。同名函数优先合同
    # （下方 b10 判据）对泛型构造读法原样生效。
    var genericCtorOwner = ""
    var genericCtorHead = ""
    if typeOwner == "" && chengpath.PathTrim(qualifier) == "":
        let genericCtorName = parser.ParserIdentPrefix(
            chengpath.PathTrim(share(callee)))
        if genericCtorName != "":
            for genericCtorIndex in 0..<ctx.declaredTypes.len:
                if TypedExprNormalizeTypeText(
                           ctx.declaredTypes[genericCtorIndex]) !=
                       genericCtorName:
                    continue
                if ctx.declaredTypeBuiltinKinds[genericCtorIndex] !=
                       Int32(TypedExprLayoutBuiltinNone):
                    break
                let genericCtorExact = typedExprIrExactDeclarationIndex(
                    ir,
                    ctx.declaredTypeProducerSourceIndexes[
                        genericCtorIndex],
                    ctx.declaredTypeDeclarationSourceLocalRows[
                        genericCtorIndex])
                if genericCtorExact >= 0 &&
                   genericCtorExact <
                       ir.exactLayoutDeclarationAuthorityStates.len &&
                   ir.exactLayoutDeclarationAuthorityStates[
                       genericCtorExact] == 1:
                    genericCtorOwner = parser.ParserNormalizePath(
                        ctx.sourcePath)
                    genericCtorHead = TypedExprIrValueExprCallHead(
                        tree, nodeIndex)
                break
    # [b10 同名函数优先臂·结构化 call 权威面] typeOwner 命中（类型构造读法）
    # 但 callee 同时解析为已登记函数声明（值命名空间）时，函数调用是唯一
    # 类型检查合读（见 TypedExprExplicitTypeTargetResolvesToFunction 契约
    # 注）。此臂原样提前 return 会使 signature line 恒 0，与 facts 侧名字级
    # 声明行恢复打穿 `compiler csg: resolved-call fact/TypedIR target
    # payload drift`（kd_b1001 夹具 b10_ctrl_local_ctor 实证 fact=6
    # typed=0）。不提前 return → 落入下方声明权威解析，签名行/声明行/
    # exprClass 全套盖章；纯类型（无同名函数）走原构造读法，行为逐位不变。
    var b10CtorTargetText = share(callee)
    if qualifier != "":
        b10CtorTargetText = Fmt"{qualifier}.{callee}"
    if (typeOwner != "" || genericCtorOwner != "") &&
       !TypedExprExplicitTypeTargetResolvesToFunction(ctx,
                                                       sourceContexts,
                                                       b10CtorTargetText):
        targetOut = share(callee)
        if typeOwner != "":
            targetSourcePathOut = typeOwner
            resultTypeOut = TypedExprNormalizeTypeText(callee)
        else:
            # 泛型构造读法：结果类型携带实例化实参（如 Option[T]），
            # NormalizeTypeText 保留括号群；targetSourcePath 指向泛型声明本源。
            targetSourcePathOut = genericCtorOwner
            resultTypeOut = TypedExprNormalizeTypeText(genericCtorHead)
        # [phaseB-parser] 构造头（类型 owner 分支）的表达类不再硬编 Owned：
        # 与其它 CallExpr 产线同一 exact 推导（托管→Owned、非托管→Unmanaged、
        # 不可判→Unknown），消除入口文件 POD 聚合构造（如 tuple[x: int32,
        # y: int32] / 全标量 object）在节点校验层的 expr class drift。
        resultExprClassOut = TypedExprIrExprClassForResultTypeExact(
            ir,
            ctx.sourcePath,
            resultTypeOut,
            TypedExprExprOwned)
        return
    var explicitGenericTypes: str[]
    let genericCount = parser.ParserValueExprNodeExplicitGenericCount(
        tree, nodeIndex)
    for genericIndex in 0..<genericCount:
        add(explicitGenericTypes,
            share(parser.ParserValueExprNodeExplicitGenericText(
                tree, nodeIndex, genericIndex)))
    var resolvedReturnType = ""
    var resolvedRow: int32
    var explicitMismatch = false
    let state = TypedExprResolveCallDeclarationWithExplicit(
        ctx,
        qualifier,
        share(callee),
        argTypes,
        explicitGenericTypes,
        genericCount > 0,
        TypedExprCallDeclarationFunctionOrImportc,
        targetSourcePathOut,
        resolvedReturnType,
        targetOut,
        importcOut,
        resolvedRow,
        explicitMismatch)
    var resolved = state == TypedExprBuildIndexUnique &&
                   targetOut != "" &&
                   targetSourcePathOut != ""
    if !resolved &&
       state == TypedExprBuildIndexMissing &&
       qualifier == "":
        var nameReturnType = ""
        let nameSourceState = TypedExprLookupSameSourceFunctionDeclFromNameSource(
            ctx,
            share(callee),
            targetOut,
            targetSourcePathOut,
            targetSignatureLineNumberOut,
            importcOut,
            resolvedRow,
            nameReturnType)
        if nameSourceState == TypedExprBuildIndexUnique &&
           targetOut != "" &&
           targetSourcePathOut != "" &&
           nameReturnType != "":
            resolvedReturnType = nameReturnType
            resolved = true
    if !resolved:
        var argTypesText = ""
        var incomparable = false
        for argIndex in 0..<argTypes.len:
            if argIndex > 0:
                argTypesText = strutil.Join([share(argTypesText), ","], "")
            let argType = TypedExprNormalizeTypeText(argTypes[argIndex])
            argTypesText = strutil.Join([share(argTypesText), share(argType)], "")
            if TypedExprCallDeclarationComparableType(argType) == "":
                incomparable = true
        var nameSourceRow: int32
        let nameSourceState = TypedExprBuildIndexLookup(
            ctx.buildIndex,
            "ctx_function_decl_name_source",
            parser.ParserNormalizePath(ctx.sourcePath),
            share(callee),
            "",
            nameSourceRow)
        panic(Fmt"typed expr: unresolved structural Call callee={callee} qualifier={qualifier} result={resultTypeRaw} state={Int32(state)} explicit_mismatch={explicitMismatch} source={ctx.sourcePath} args={argTypesText} incomparable={incomparable} name_source={Int32(nameSourceState)} name_row={nameSourceRow}")
    targetSourcePathOut = parser.ParserNormalizePath(targetSourcePathOut)
    targetSignatureLineNumberOut =
        typedExprBuildIndexCallSignatureLineNumber(ctx.buildIndex,
                                                    resolvedRow)
    if resolvedRow < 0 ||
       resolvedRow >= ctx.buildIndex.callDeclarationResultExprClasses.len:
        panic("typed expr: structural Call declaration ownership row unavailable")
    declarationIndexOut = resolvedRow
    # [ia1 alias-family] targetOut must carry the declaration row's
    # registered name, never the targetSymbols payload: the compiler
    # csg validator compares the resolved-call fact row and the
    # TypedIR node columns for exact identity, and the backend importc
    # authority gates (TypedExprIrLookupImportcReturnType /
    # LookupImportcTargetSymbol) are keyed by the declared name.
    # Function rows: name == target symbol, so this write is
    # value-identical to the WithExplicit output.
    targetOut = parser.ParserOwnedText(
        typedExprBuildIndexCallName(ctx.buildIndex, resolvedRow))
    resultTypeOut = TypedExprCallRuntimeType(resolvedReturnType)
    if resultTypeOut == "" || resultTypeOut == "unknown" ||
       resultTypeOut == "call_expr":
        panic(Fmt"typed expr: structural Call declaration return type unavailable callee={callee} qualifier={qualifier}")
    resultExprClassOut = TypedExprIrExprClassForResultTypeExact(
        ir,
        ctx.sourcePath,
        resultTypeOut,
        ctx.buildIndex.callDeclarationResultExprClasses[resolvedRow])

@borrows
fn TypedExprIrCallKindForCallee(calleeRaw: str): TypedExprCallKind =
    let callee = TypedExprQualifiedCallLeaf(
        chengpath.PathTrim(calleeRaw))
    if parser.ParserResultIntrinsicDetailKind(callee) !=
       parser.NormalizedExprDetailNone:
        return TypedExprCallResultIntrinsic
    if parser.ParserCallNameIsBuiltinCallee(callee) ||
       parser.ParserCallNameIsBuiltinPrimitiveConversion(callee):
        return TypedExprCallBuiltin
    return TypedExprCallNone

@borrows
fn typedExprIrExactCallReturnTypeId(
        ir: TypedExprIr,
        declarationIndex: int32): int32 =
    # Intrinsics and type constructors deliberately have no declaration row.
    # A parser-owned declaration call must never degrade to an unknown TypeId:
    # its exact producer coordinate and the bound TypeArena artifact are the
    # only authority for the result type.
    if declarationIndex < 0:
        return -1
    if ir.exactTypeArena == nil ||
       !ir.valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           ir.valueDefinitionTypeArenaArtifactCid,
           ir.exactTypeArena.artifactRaw32):
        panic("typed expr: declaration Call exact TypeArena authority unavailable")
    let declarationOwner =
        typedExprIrCallDeclarationOwnerIndex(ir)
    if declarationOwner == nil || declarationOwner.released ||
       !declarationOwner.callDeclarationSealed ||
       declarationIndex >=
           typedExprBuildIndexCallDeclarationCount(
               declarationOwner) ||
       declarationIndex >=
           declarationOwner.callDeclarationKinds.len ||
       declarationIndex >=
           declarationOwner.callDeclarationProducerSourceIndexes.len ||
       declarationIndex >=
           declarationOwner.callDeclarationProducerDeclarationOrdinals.len ||
       declarationIndex >=
           declarationOwner.callDeclarationProducerFunctionRows.len:
        panic("typed expr: declaration Call exact producer row unavailable")
    let declarationKind =
        declarationOwner.callDeclarationKinds[declarationIndex]
    if declarationKind != TypedExprCallDeclarationFunction &&
       declarationKind != TypedExprCallDeclarationImportc:
        panic("typed expr: declaration Call exact producer kind invalid")
    let producerSourceIndex =
        declarationOwner.callDeclarationProducerSourceIndexes[
            declarationIndex]
    let producerDeclarationOrdinal =
            declarationOwner.callDeclarationProducerDeclarationOrdinals[
            declarationIndex]
    if producerSourceIndex < 0 || producerDeclarationOrdinal < 0:
        panic("typed expr: declaration Call exact producer coordinate invalid")
    let resultTypeId =
        typearena.TypedExprTypeArenaFunctionReturnTypeId(
            ir.exactTypeArena,
            producerSourceIndex,
            producerDeclarationOrdinal)
    if resultTypeId < 0 ||
       resultTypeId >=
           typearena.TypedExprTypeArenaTypeCount(ir.exactTypeArena):
        panic("typed expr: declaration Call exact return TypeId invalid")
    return resultTypeId

@borrows
fn TypedExprIrExactCallReturnTypeIdAt(
        ir: TypedExprIr,
        declarationIndex: int32): int32 =
    return typedExprIrExactCallReturnTypeId(
        ir,
        declarationIndex)

@borrows
fn TypedExprIrCallManualConsumeEffectInto(
        ir: TypedExprIr,
        nodeIndex: int32,
        targetParameterOrdinalOut: var int32,
        sourceParameterOrdinalOut: var int32,
        targetParameterDeclarationRowOut: var int32,
        sourceParameterDeclarationRowOut: var int32,
        targetTypeIdOut: var int32,
        sourceTypeIdOut: var int32,
        effectCidOut: var layout.FixedBytes32): bool =
    targetParameterOrdinalOut = -1
    sourceParameterOrdinalOut = -1
    targetParameterDeclarationRowOut = -1
    sourceParameterDeclarationRowOut = -1
    targetTypeIdOut = -1
    sourceTypeIdOut = -1
    effectCidOut = layout.FixedBytes32()
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len ||
       ir.nodes2_opKinds[nodeIndex] != TypedExprIrOpCallExpr:
        panic("typed expr: manual-consume query requires CallExpr node")
    let declarationIndex = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_callDeclarationIndexes,
        nodeIndex)
    if declarationIndex < 0:
        return false
    let declarationOwner = typedExprIrCallDeclarationOwnerIndex(ir)
    if declarationOwner == nil || declarationOwner.released ||
       !declarationOwner.callDeclarationSealed ||
       declarationIndex >=
           typedExprBuildIndexCallDeclarationCount(declarationOwner) ||
       declarationIndex >= declarationOwner.callDeclarationKinds.len ||
       declarationIndex >=
           declarationOwner.callDeclarationProducerSourceIndexes.len ||
       declarationIndex >=
           declarationOwner.callDeclarationProducerDeclarationOrdinals.len ||
       declarationIndex >=
           declarationOwner.callDeclarationProducerFunctionRows.len ||
       declarationIndex >=
           declarationOwner.callDeclarationManualConsumePresents.len:
        panic("typed expr: manual-consume CallExpr declaration authority missing")
    if !declarationOwner.callDeclarationManualConsumePresents[
           declarationIndex]:
        if !typedExprManualConsumeEffectAbsent(
               false,
               declarationOwner.callDeclarationManualConsumeFunctionDeclarationRows[
                   declarationIndex],
               declarationOwner.callDeclarationManualConsumeTargetParameterOrdinals[
                   declarationIndex],
               declarationOwner.callDeclarationManualConsumeSourceParameterOrdinals[
                   declarationIndex],
               declarationOwner.callDeclarationManualConsumeTargetParameterDeclarationRows[
                   declarationIndex],
               declarationOwner.callDeclarationManualConsumeSourceParameterDeclarationRows[
                   declarationIndex],
               declarationOwner.callDeclarationManualConsumeTargetTypeIds[
                   declarationIndex],
               declarationOwner.callDeclarationManualConsumeSourceTypeIds[
                   declarationIndex],
               declarationOwner.callDeclarationManualConsumeEffectCids[
                   declarationIndex]):
            panic("typed expr: absent CallExpr manual-consume effect non-empty")
        return false
    if !declarationOwner.callDeclarationManualConsumeTypeArenaBound:
        panic("typed expr: present CallExpr manual-consume TypeArena authority missing")
    if declarationOwner.callDeclarationKinds[declarationIndex] !=
           TypedExprCallDeclarationFunction:
        panic("typed expr: CallExpr manual-consume declaration kind invalid")
    if ir.exactTypeArena == nil ||
       !ir.valueDefinitionTypeArenaBound ||
       layout.FixedBytes32Equal(
           ir.valueDefinitionTypeArenaArtifactCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           ir.valueDefinitionTypeArenaArtifactCid,
           ir.exactTypeArena.artifactRaw32):
        panic("typed expr: CallExpr manual-consume current TypeArena authority missing")
    let targetParameterOrdinal =
        declarationOwner.callDeclarationManualConsumeTargetParameterOrdinals[
            declarationIndex]
    let sourceParameterOrdinal =
        declarationOwner.callDeclarationManualConsumeSourceParameterOrdinals[
            declarationIndex]
    let targetParameterDeclarationRow =
        declarationOwner.callDeclarationManualConsumeTargetParameterDeclarationRows[
            declarationIndex]
    let sourceParameterDeclarationRow =
        declarationOwner.callDeclarationManualConsumeSourceParameterDeclarationRows[
            declarationIndex]
    let targetTypeId =
        declarationOwner.callDeclarationManualConsumeTargetTypeIds[
            declarationIndex]
    let sourceTypeId =
        declarationOwner.callDeclarationManualConsumeSourceTypeIds[
            declarationIndex]
    let effectCid = layout.FixedBytes32Copy(
        declarationOwner.callDeclarationManualConsumeEffectCids[
            declarationIndex])
    if !typedExprManualConsumeTypeIdsExact(
           ir.exactTypeArena, targetTypeId, sourceTypeId):
        panic("typed expr: CallExpr manual-consume structural TypeId drift")
    let expectedEffectCid = typedExprManualConsumeEffectCid(
        ir.valueDefinitionTypeArenaArtifactCid,
        declarationOwner.callDeclarationProducerSourceIndexes[
            declarationIndex],
        declarationOwner.callDeclarationProducerDeclarationOrdinals[
            declarationIndex],
        declarationOwner.callDeclarationProducerFunctionRows[
            declarationIndex],
        declarationOwner.callDeclarationManualConsumeFunctionDeclarationRows[
            declarationIndex],
        targetParameterOrdinal,
        sourceParameterOrdinal,
        targetParameterDeclarationRow,
        sourceParameterDeclarationRow,
        targetTypeId,
        sourceTypeId)
    if targetParameterOrdinal < 0 ||
       sourceParameterOrdinal < 0 ||
       targetParameterOrdinal == sourceParameterOrdinal ||
       targetParameterDeclarationRow < 0 ||
       sourceParameterDeclarationRow < 0 ||
       targetParameterDeclarationRow == sourceParameterDeclarationRow ||
       !layout.FixedBytes32Equal(effectCid, expectedEffectCid):
        panic("typed expr: CallExpr manual-consume effect CID invalid")
    targetParameterOrdinalOut = targetParameterOrdinal
    sourceParameterOrdinalOut = sourceParameterOrdinal
    targetParameterDeclarationRowOut = targetParameterDeclarationRow
    sourceParameterDeclarationRowOut = sourceParameterDeclarationRow
    targetTypeIdOut = targetTypeId
    sourceTypeIdOut = sourceTypeId
    effectCidOut = effectCid
    return true

@borrows
fn TypedExprIrValueFmtStaticLiteral(source: str,
                                     startIndex: int32,
                                     endIndex: int32): str =
    if startIndex < 0 || endIndex < startIndex || endIndex > source.len:
        panic("typed expr: structural Fmt literal span out of bounds")
    var out = buffer.NewByteBuffer()
    buffer.AppendText(out, "\"")
    var cursor = startIndex
    while cursor < endIndex:
        if cursor + 1 < endIndex && source[cursor] == '{' &&
           source[cursor + 1] == '{':
            buffer.AppendText(out, "{")
            cursor = cursor + 2
            continue
        if cursor + 1 < endIndex && source[cursor] == '}' &&
           source[cursor + 1] == '}':
            buffer.AppendText(out, "}")
            cursor = cursor + 2
            continue
        buffer.AppendText(out, chengpath.TextSlice(source, cursor, 1))
        cursor = cursor + 1
    buffer.AppendText(out, "\"")
    return buffer.FinishString(out)

@borrows
fn TypedExprIrBuildValueExprNode(ir: var TypedExprIr,
                                 ctx: var TypedExprSourceContext,
                                 sourceContexts: TypedExprSourceContext[],
                                  scope: TypedExprFunctionScope,
                                  lineNumber: int32,
                                  nodeIndex: int32,
                                  expectedTypeRaw: str): int32 =
    if ir.valueExprTree == nil || nodeIndex < 0 ||
       nodeIndex >= ir.valueExprTree.nodeCount:
        panic("typed expr: parser origin node is unavailable")
    add(ir.originParserNodeStack,
        parser.ParserValueExprNodeSourceLocalIndexAt(
            ir.valueExprTree, nodeIndex))
    let out = TypedExprIrBuildValueExprNodeActive(
        ir, ctx, sourceContexts, scope, lineNumber,
        nodeIndex, expectedTypeRaw)
    setLen(ir.originParserNodeStack,
           ir.originParserNodeStack.len - 1)
    return out

@borrows
fn typedExprIrValueCallFieldCalleeKind(
        ir: var TypedExprIr,
        sourcePath: str,
        tree: parser.ParserValueExprTree,
        callNodeIndex: int32,
        calleeNodeIndexOut: var int32): int32 =
    calleeNodeIndexOut = -1
    if tree == nil ||
       parser.ParserValueExprNodeKindAt(tree, callNodeIndex) !=
           parser.ParserValueExprCall ||
       parser.ParserValueExprNodeChildCount(tree, callNodeIndex) <= 0:
        return 0
    var calleeNodeIndex =
        TypedExprIrValueExprChildAt(tree, callNodeIndex, 0)
    while parser.ParserValueExprNodeKindAt(tree, calleeNodeIndex) ==
          parser.ParserValueExprGrouped:
        if parser.ParserValueExprNodeChildCount(
               tree, calleeNodeIndex) != 1:
            panic("typed expr: grouped call callee arity invalid")
        calleeNodeIndex =
            TypedExprIrValueExprChildAt(tree, calleeNodeIndex, 0)
    if parser.ParserValueExprNodeKindAt(tree, calleeNodeIndex) !=
       parser.ParserValueExprField:
        return 0
    var rootNodeIndex = calleeNodeIndex
    while parser.ParserValueExprNodeKindAt(tree, rootNodeIndex) ==
          parser.ParserValueExprField:
        if parser.ParserValueExprNodeChildCount(
               tree, rootNodeIndex) != 1:
            panic("typed expr: field call callee arity invalid")
        rootNodeIndex =
            TypedExprIrValueExprChildAt(tree, rootNodeIndex, 0)
    if parser.ParserValueExprNodeKindAt(tree, rootNodeIndex) ==
       parser.ParserValueExprIdentifier:
        let rootName =
            parser.ParserValueExprNodeAtomText(tree, rootNodeIndex)
        var targetSourcePath = ""
        let importState = TypedExprIrImportAliasTargetState(
            ir, sourcePath, rootName, targetSourcePath)
        if importState == TypedExprBuildIndexAmbiguous:
            panic("typed expr: field call root import alias is ambiguous")
        if importState == TypedExprBuildIndexUnique:
            return 2
    calleeNodeIndexOut = calleeNodeIndex
    return 1

fn typedExprIrPhysicalFunctionTypeId(
        ir: var TypedExprIr,
        typeIdRaw: int32): int32 =
    let arena = ir.exactTypeArena
    if arena == nil || !arena.complete ||
       typeIdRaw < 0 || typeIdRaw >= arena.typeCount:
        return -1
    var visited: bool[]
    setLen(visited, arena.typeCount)
    var typeId = typeIdRaw
    while true:
        if typeId < 0 || typeId >= arena.typeCount || visited[typeId]:
            panic("typed expr: function field TypeId chain invalid")
        visited[typeId] = true
        let kind = typearena.TypedExprTypeArenaKindAt(arena, typeId)
        if kind == typearena.TypedExprStructuralTypeFunction:
            return typeId
        if kind != typearena.TypedExprStructuralTypeAlias &&
           kind != typearena.TypedExprStructuralTypeBorrow &&
           kind != typearena.TypedExprStructuralTypeApply:
            return -1
        let childStart = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childStarts, typeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childCounts, typeId)
        if childCount <= 0:
            panic("typed expr: function field TypeId chain child missing")
        typeId = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childTypeIds, childStart)

fn typedExprIrFunctionReturnTypeId(
        ir: var TypedExprIr,
        functionTypeId: int32): int32 =
    let arena = ir.exactTypeArena
    if arena == nil || !arena.complete ||
       functionTypeId < 0 || functionTypeId >= arena.typeCount ||
       typearena.TypedExprTypeArenaKindAt(arena, functionTypeId) !=
           typearena.TypedExprStructuralTypeFunction:
        panic("typed expr: function return TypeId authority invalid")
    let childStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childStarts, functionTypeId)
    let childCount = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childCounts, functionTypeId)
    let paramCount = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.functionParamCounts, functionTypeId)
    if paramCount < 0 || paramCount > childCount ||
       childCount - paramCount > 1:
        panic("typed expr: function return TypeId shape invalid")
    if childCount == paramCount:
        return typearena.TypedExprTypeArenaReservedScalarTypeId(
            arena, typearena.TypedExprStructuralScalarVoid)
    return arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childTypeIds,
        childStart + childCount - 1)

@borrows
fn typedExprIrBuildValueExprNodePrefixActive(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
                                  scope: TypedExprFunctionScope,
                                  lineNumber: int32,
                                  nodeIndex: int32,
                                  expectedTypeRaw: str): int32 =
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: structural value consumer has no parser lease")
    let kind = parser.ParserValueExprNodeKindAt(tree, nodeIndex)
    let surface = parser.ParserValueExprNodeText(tree, nodeIndex)
    let atom = parser.ParserValueExprNodeAtomText(tree, nodeIndex)
    if kind == parser.ParserValueExprGrouped:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 1:
            panic("typed expr: structural grouped node arity mismatch")
        return TypedExprIrBuildValueExprNode(
            ir,
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            TypedExprIrValueExprChildAt(tree, nodeIndex, 0),
            expectedTypeRaw)
    if kind == parser.ParserValueExprIdentifier:
        return typedExprIrBuildRhsIdentifierFromParserActive(
            ir,
            ctx,
            share(scope),
            lineNumber,
            nodeIndex)
    if kind == parser.ParserValueExprBoolLiteral:
        return TypedExprIrAddRhsScalarLeafNode(ir, ctx.sourcePath, scope.name,
                                         lineNumber, TypedExprIrOpBoolLit,
                                         "bool", surface, atom,
                                         typearena.TypedExprStructuralScalarBool)
    if kind == parser.ParserValueExprCharLiteral:
        return TypedExprIrAddRhsScalarLeafNode(ir, ctx.sourcePath, scope.name,
                                         lineNumber, TypedExprIrOpCharLit,
                                         "char", surface, atom,
                                         typearena.TypedExprStructuralScalarChar)
    if kind == parser.ParserValueExprStringLiteral:
        return TypedExprIrAddRhsScalarLeafNode(ir, ctx.sourcePath, scope.name,
                                         lineNumber, TypedExprIrOpStrLit,
                                         "str", surface, atom,
                                         typearena.TypedExprStructuralScalarStr)
    if kind == parser.ParserValueExprFloatLiteral:
        return TypedExprIrAddRhsScalarLeafNode(ir, ctx.sourcePath, scope.name,
                                         lineNumber, TypedExprIrOpF64Const,
                                         "float64", surface, atom,
                                         typearena.TypedExprStructuralScalarFloat64)
    if kind == parser.ParserValueExprIntegerLiteral:
        if TypedExprIrRhsTextIsI32Literal(atom):
            return TypedExprIrAddRhsScalarLeafNode(ir, ctx.sourcePath, scope.name,
                                             lineNumber, TypedExprIrOpI32Const,
                                             "int32", surface, atom,
                                             typearena.TypedExprStructuralScalarInt32)
        if TypedExprTextIsIntegerLiteral(atom):
            return TypedExprIrAddRhsScalarLeafNode(ir, ctx.sourcePath, scope.name,
                                             lineNumber, TypedExprIrOpI64Const,
                                             "int64", surface, atom,
                                             typearena.TypedExprStructuralScalarInt64)
        panic("typed expr: parser integer node is not a supported integer literal")
    if kind == parser.ParserValueExprNilLiteral:
        let nilNode = TypedExprIrAddTypedNilPtrNode(ir,
                                                    ctx,
                                                    sourceContexts,
                                                    scope,
                                                    lineNumber,
                                                    expectedTypeRaw)
        if nilNode < 0:
            panic("typed expr: structural nil argument has no concrete pointer type")
        return nilNode
    if kind == parser.ParserValueExprTypeConversion:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 1:
            panic("typed expr: structural type conversion arity mismatch")
        var targetType = ""
        var borrow = false
        if !TypedExprIrValueExprConversionTarget(tree,
                                                  nodeIndex,
                                                  targetType,
                                                  borrow) ||
           !TypedExprExplicitTypeTargetVisible(ctx,
                                              sourceContexts,
                                              targetType):
            panic(Fmt"typed expr: structural type conversion target is not visible surface={surface}")
        let operandIndex = TypedExprIrValueExprChildAt(tree, nodeIndex, 0)
        let preflightKind = TypedExprIrValueExprConversionPreflight(
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            tree,
            nodeIndex,
            operandIndex)
        if preflightKind != TypedExprExplicitTypeConversionIdentity &&
           preflightKind != TypedExprExplicitTypeConversionBorrow:
            panic(Fmt"typed expr: structural type conversion preflight failed surface={surface}")
        let operandNode = TypedExprIrBuildValueExprNode(ir,
                                                        ctx,
                                                        sourceContexts,
                                                        scope,
                                                        lineNumber,
                                                        operandIndex,
                                                        targetType)
        if operandNode < 0:
            panic("typed expr: structural type conversion operand did not build")
        let realizedKind = TypedExprIrValueExprConversionClassify(
            ir,
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            tree,
            nodeIndex,
            operandIndex,
            operandNode)
        if realizedKind != TypedExprExplicitTypeConversionIdentity &&
           realizedKind != TypedExprExplicitTypeConversionBorrow:
            panic(Fmt"typed expr: structural type conversion is not identity surface={surface}")
        if realizedKind != preflightKind:
            panic("typed expr: structural type conversion preflight/realizer drift")
        return operandNode
    if kind == parser.ParserValueExprField:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 1:
            panic("typed expr: structural field node arity mismatch")
        let ownerIndex = TypedExprIrValueExprChildAt(tree, nodeIndex, 0)
        let ownerKind = parser.ParserValueExprNodeKindAt(tree, ownerIndex)
        let fieldName = parser.ParserValueExprNodeAtomText(tree, nodeIndex)
        if ownerKind == parser.ParserValueExprIdentifier:
            let ownerName = parser.ParserValueExprNodeAtomText(tree, ownerIndex)
            if TypedExprIrTypeIsEnum(ir, ctx.sourcePath, ownerName):
                var enumTypeName: str
                var enumOrdinal: int32
                if !TypedExprIrLookupEnumConstValue(ir,
                                                    ctx.sourcePath,
                                                    surface,
                                                    enumTypeName,
                                                    enumOrdinal):
                    panic("typed expr: structural enum member is unresolved")
                return TypedExprIrAddRhsScalarLeafNode(
                    ir, ctx.sourcePath, scope.name, lineNumber,
                    TypedExprIrOpI32Const, "int32", surface,
                    IntToStr(enumOrdinal),
                    typearena.TypedExprStructuralScalarInt32)
            # [R7(1) 判点B=typed-expr 残余族第 4 实例] 跨模块 `alias.CONST` field
            # 读法在结构层此前无解析臂: owner(别名标识符)无词法绑定
            # (resolutionKind=None) → owner build Missing → 下方 structural
            # field owner did not build panic(R6F 夹具 v1 bklib.LibValue 首暴露)。
            # 文本层同形早已可解(TypedExprIrBuildRhsQualifiedEnumConstNode
            # const 面 + TypedExprQualifiedConstLiteral), 本臂为其结构层镜像:
            # import 别名 Unique 解析(调用位先例
            # typedExprIrValueCallFieldCalleeKind) → 目标 ctx 冻结 const 查询
            # → 既有 TypedExprIrBuildModuleConstLiteralNode(同模块 const 读法臂
            # 同一 builder)。守卫逐条 fail-closed: buildIndex 无权威 / 词法绑定
            # 遮蔽(resolutionKind!=None, 局部变量优先合同保留) / 别名非 Unique /
            # 目标 ctx 缺席或缺索引权威 / 非模块常量或常量字面量建不出叶 →
            # 一律落回既有 owner-build 路径, 原行为(含原 panic)逐字节保持。
            if ctx.buildIndex != nil && !ctx.buildIndex.released:
                var ownerResolutionKind =
                    parser.ParserValueExprBindingResolutionNone
                var ownerLexicalScopeRow: int32
                var ownerDeclarationRow: int32
                var ownerPatternRow: int32
                if parser.ParserValueExprNodeBindingResolutionAt(
                        tree, ownerIndex,
                        ownerLexicalScopeRow,
                        ownerResolutionKind,
                        ownerDeclarationRow,
                        ownerPatternRow):
                    if ownerResolutionKind ==
                            parser.ParserValueExprBindingResolutionNone:
                        var aliasTargetPath = ""
                        if TypedExprIrImportAliasTargetState(
                                ir, ctx.sourcePath, ownerName,
                                aliasTargetPath) == TypedExprBuildIndexUnique:
                            let aliasTargetIndex =
                                TypedExprSourceContextLookupFast(
                                    ir, sourceContexts, aliasTargetPath)
                            if aliasTargetIndex >= 0:
                                let aliasConstLiteral =
                                    TypedExprModuleConstLiteralForFrozenContext(
                                        sourceContexts[aliasTargetIndex],
                                        share(fieldName))
                                if aliasConstLiteral != "":
                                    let aliasConstNode =
                                        TypedExprIrBuildModuleConstLiteralNode(
                                            ir,
                                            strings.CloneStr(ctx.sourcePath),
                                            strings.CloneStr(scope.name),
                                            lineNumber,
                                            strings.CloneStr(surface),
                                            aliasConstLiteral)
                                    if aliasConstNode >= 0:
                                        return aliasConstNode
        let ownerNode = TypedExprIrBuildValueExprNode(ir,
                                                      ctx,
                                                      sourceContexts,
                                                      scope,
                                                      lineNumber,
                                                      ownerIndex,
                                                      "")
        if ownerNode < 0:
            panic("typed expr: structural field owner did not build")
        return TypedExprIrBuildRhsFieldHopsNode(ir,
                                                ctx,
                                                sourceContexts,
                                                share(scope),
                                                lineNumber,
                                                ownerNode,
                                                share(parser.ParserValueExprNodeText(
                                                    tree, ownerIndex)),
                                                share(fieldName))
    if kind == parser.ParserValueExprIndex:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 2:
            panic("typed expr: structural index node arity mismatch")
        let baseIndex = TypedExprIrValueExprChildAt(tree, nodeIndex, 0)
        let subscriptIndex = TypedExprIrValueExprChildAt(tree, nodeIndex, 1)
        let baseNode = TypedExprIrBuildValueExprNode(ir, ctx, sourceContexts,
                                                     scope, lineNumber,
                                                     baseIndex, "")
        let subscriptNode = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, lineNumber, subscriptIndex, "int32")
        if baseNode < 0 || subscriptNode < 0:
            panic("typed expr: structural index operand did not build")
        let baseType = TypedExprIrValueExprNodeResultType(ir, baseNode)
        let elemType = TypedExprIrRhsIndexElemType(ctx, baseType)
        var elemSize: int32
        var elemAlign: int32
        if elemType == "" ||
           !TypedExprTypeLayout(ctx, sourceContexts, elemType,
                                elemSize, elemAlign):
            panic("typed expr: structural index element layout unavailable")
        return TypedExprIrAddRhsIndexGetNode(
            ir, share(ctx.sourcePath), share(scope.name), lineNumber,
            share(surface),
            TypedExprIrRuntimeScalarType(ir, ctx.sourcePath, elemType),
            baseNode, subscriptNode, elemSize)
    if kind == parser.ParserValueExprUnary:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 1:
            panic("typed expr: structural unary node arity mismatch")
        let operandIndex = TypedExprIrValueExprChildAt(tree, nodeIndex, 0)
        let operatorText = parser.ParserValueExprNodeOperatorText(tree,
                                                                  nodeIndex)
        if operatorText == "-" &&
           parser.ParserValueExprNodeKindAt(tree, operandIndex) ==
               parser.ParserValueExprFloatLiteral:
            return TypedExprIrAddRhsLeafNode(
                ir, ctx.sourcePath, scope.name, lineNumber,
                TypedExprIrOpF64Const, "float64", surface, surface)
        let operandNode = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, lineNumber, operandIndex, "")
        if operandNode < 0:
            # [op79] &FunctionName 树路径救援: 文本引擎 TypedExprIrBuildRhsUnaryNode
            # 的 FuncRef 臂在结构树模式下不可达(树租约恒在, 裸函数名 operand
            # 构建失败先炸本 panic)。此处按文本引擎同款三守卫(裸标识符/非
            # local-param 绑定/非模块 const)+顶层函数行唯一, 铸 FuncRef 叶
            # (其 "ptr" 权威 TypeId 由 TypedExprIrAddFuncRefNode [op79] 同一
            # 拼写行读路由绑定)再包 AddrOf。任一守卫不满足仍原样 panic,
            # fail-closed 零弱化; operand 构建成功的既有形态逐字节原路。
            if operatorText == "&" &&
               parser.ParserValueExprNodeKindAt(tree, operandIndex) ==
                   parser.ParserValueExprIdentifier:
                let funcRefOperandText = parser.ParserValueExprNodeAtomText(
                    tree, operandIndex)
                if TypedExprTextIsSimpleIdent(funcRefOperandText) &&
                   TypedExprBindingRhsLocalRefType(ir, ctx, share(scope),
                                                   lineNumber,
                                                   share(funcRefOperandText)) == "" &&
                   TypedExprModuleConstLiteralForContext(ctx,
                                                         share(funcRefOperandText)) == "":
                    var funcRefDeclarationRow: int32
                    let funcRefState = typedExprLocalFunctionNameRow(
                        ctx, share(funcRefOperandText), funcRefDeclarationRow)
                    if funcRefState == TypedExprBuildIndexUnique:
                        let funcRefNode = TypedExprIrAddFuncRefNode(
                            ir,
                            share(ctx.sourcePath),
                            share(scope.name),
                            lineNumber,
                            share(funcRefOperandText),
                            funcRefDeclarationRow)
                        if funcRefNode < 0:
                            panic("typed expr: structural unary operand did not build")
                        return TypedExprIrAddOpNode(ir, ctx.sourcePath,
                                                    scope.name, lineNumber,
                                                    TypedExprIrOpAddrOf,
                                                    "ptr", surface,
                                                    funcRefNode, -1, -1)
            panic("typed expr: structural unary operand did not build")
        let operandType = TypedExprCallRuntimeType(
            TypedExprIrValueExprNodeResultType(ir, operandNode))
        if operatorText == "!" && operandType == "bool":
            return TypedExprIrAddOpNode(ir, ctx.sourcePath, scope.name,
                                        lineNumber, TypedExprIrOpLogNot,
                                        "bool", surface, operandNode, -1, -1)
        if operatorText == "-":
            var resultType = ""
            if operandType == "int32" || operandType == "uint32":
                resultType = "int32"
            elif operandType == "int64" || operandType == "uint64":
                resultType = "int64"
            if resultType != "":
                return TypedExprIrAddOpNode(ir, ctx.sourcePath, scope.name,
                                            lineNumber, TypedExprIrOpNeg,
                                            resultType, surface,
                                            operandNode, -1, -1)
        if operatorText == "&" &&
           (ir.nodes2_opKinds[operandNode] == TypedExprIrOpFieldGet ||
            ir.nodes2_opKinds[operandNode] == TypedExprIrOpLocalRef ||
            ir.nodes2_opKinds[operandNode] == TypedExprIrOpParamRef ||
            ir.nodes2_opKinds[operandNode] == TypedExprIrOpFuncRef):
            return TypedExprIrAddOpNode(ir, ctx.sourcePath, scope.name,
                                        lineNumber, TypedExprIrOpAddrOf,
                                        "ptr", surface,
                                        operandNode, -1, -1)
        panic("typed expr: unsupported structural unary operator or operand type")
    panic("typed expr: structural prefix value dispatch mismatch")

@borrows
fn typedExprIrBuildValueExprNodeCompositeActive(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        nodeIndex: int32,
        expectedTypeRaw: str): int32 =
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: structural value consumer has no parser lease")
    let kind = parser.ParserValueExprNodeKindAt(tree, nodeIndex)
    let surface = parser.ParserValueExprNodeText(tree, nodeIndex)
    if kind == parser.ParserValueExprBinary:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 2:
            panic("typed expr: structural binary node arity mismatch")
        let lhsIndex = TypedExprIrValueExprChildAt(tree, nodeIndex, 0)
        let rhsIndex = TypedExprIrValueExprChildAt(tree, nodeIndex, 1)
        let operatorText = parser.ParserValueExprNodeOperatorText(tree,
                                                                  nodeIndex)
        var lhsNode: int32 = -1
        var rhsNode: int32 = -1
        if parser.ParserValueExprNodeKindAt(tree, lhsIndex) ==
           parser.ParserValueExprNilLiteral:
            rhsNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, rhsIndex, "")
            lhsNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, lhsIndex,
                TypedExprIrValueExprNodeResultType(ir, rhsNode))
        elif parser.ParserValueExprNodeKindAt(tree, rhsIndex) ==
             parser.ParserValueExprNilLiteral:
            lhsNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, lhsIndex, "")
            rhsNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, rhsIndex,
                TypedExprIrValueExprNodeResultType(ir, lhsNode))
        else:
            lhsNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, lhsIndex, "")
            rhsNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, rhsIndex, "")
        if lhsNode < 0 || rhsNode < 0:
            panic("typed expr: structural binary operand did not build")
        let lhsType = TypedExprCallRuntimeType(
            TypedExprIrValueExprNodeResultType(ir, lhsNode))
        let rhsType = TypedExprCallRuntimeType(
            TypedExprIrValueExprNodeResultType(ir, rhsNode))
        if operatorText == "+" && lhsType == "str" && rhsType == "str":
            return TypedExprIrAddOpNode(ir, ctx.sourcePath, scope.name,
                                        lineNumber, TypedExprIrOpStrAdd,
                                        "str", surface,
                                        lhsNode, rhsNode, -1)
        let level = TypedExprIrValueExprBinaryLevel(operatorText)
        if level < 0:
            panic("typed expr: structural binary operator is unsupported")
        let resultNode = TypedExprIrAddRhsBinopNode(
            ir, ctx, scope, lineNumber, surface, level,
            operatorText, lhsNode, rhsNode)
        if resultNode < 0:
            panic("typed expr: structural binary operand types do not match")
        return resultNode
    if kind == parser.ParserValueExprTernary:
        if parser.ParserValueExprNodeChildCount(tree, nodeIndex) != 3:
            panic("typed expr: structural ternary node arity mismatch")
        let conditionNode = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, lineNumber,
            TypedExprIrValueExprChildAt(tree, nodeIndex, 0), "bool")
        let thenNode = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, lineNumber,
            TypedExprIrValueExprChildAt(tree, nodeIndex, 1), expectedTypeRaw)
        let elseNode = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, lineNumber,
            TypedExprIrValueExprChildAt(tree, nodeIndex, 2), expectedTypeRaw)
        if TypedExprCallRuntimeType(
               TypedExprIrValueExprNodeResultType(ir, conditionNode)) != "bool":
            panic("typed expr: structural ternary condition is not bool")
        var resultType = TypedExprCallRuntimeType(expectedTypeRaw)
        let thenType = TypedExprIrValueExprNodeResultType(ir, thenNode)
        let elseType = TypedExprIrValueExprNodeResultType(ir, elseNode)
        if resultType == "" || resultType == "unknown":
            if thenType == "" || thenType != elseType:
                panic("typed expr: structural ternary branch types differ")
            resultType = thenType
        return TypedExprIrAddOpNode(
            ir, ctx.sourcePath, scope.name, lineNumber,
            TypedExprIrOpLocalBoolEnumTernary, resultType, surface,
            conditionNode, thenNode, elseNode)
    if kind == parser.ParserValueExprIf:
        # 行内 if 表达式(Fmt 插值 `{if c: "1" else: "0"}` 等)与 `? :` 三元
        # 同构: 子布局 [cond, then, (elif cond, then)*, else], 自右向左折叠
        # 成嵌套三元链; 分支接合定型与三元分支同口径。
        let childCount = parser.ParserValueExprNodeChildCount(tree, nodeIndex)
        if childCount < 3 || childCount % 2 != 1:
            panic("typed expr: structural inline-if node arity mismatch")
        var joinNode = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, lineNumber,
            TypedExprIrValueExprChildAt(tree, nodeIndex, childCount - 1),
            expectedTypeRaw)
        var pairIndex = childCount - 3
        while pairIndex >= 0:
            let conditionNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber,
                TypedExprIrValueExprChildAt(tree, nodeIndex, pairIndex),
                "bool")
            let thenNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber,
                TypedExprIrValueExprChildAt(tree, nodeIndex, pairIndex + 1),
                expectedTypeRaw)
            if TypedExprCallRuntimeType(
                   TypedExprIrValueExprNodeResultType(ir, conditionNode)) !=
                   "bool":
                panic("typed expr: structural inline-if condition is not bool")
            let thenType = TypedExprIrValueExprNodeResultType(ir, thenNode)
            let joinType = TypedExprIrValueExprNodeResultType(ir, joinNode)
            var armType = TypedExprCallRuntimeType(expectedTypeRaw)
            if armType == "" || armType == "unknown":
                if thenType == "" || thenType != joinType:
                    panic("typed expr: structural inline-if branch types differ")
                armType = thenType
            joinNode = TypedExprIrAddOpNode(
                ir, ctx.sourcePath, scope.name, lineNumber,
                TypedExprIrOpLocalBoolEnumTernary, armType, surface,
                conditionNode, thenNode, joinNode)
            pairIndex = pairIndex - 2
        return joinNode
    if kind == parser.ParserValueExprListLiteral:
        let childCount = parser.ParserValueExprNodeChildCount(tree, nodeIndex)
        let expectedType = TypedExprCallRuntimeType(expectedTypeRaw)
        var elemType = ""
        if TypedExprIrTypeTextIsSeq(expectedType):
            elemType = TypedExprIrRhsIndexElemType(ctx, expectedType)
        if childCount == 0:
            if expectedType == "" || !TypedExprIrTypeTextIsSeq(expectedType):
                panic("typed expr: empty structural list has no expected seq type")
            return TypedExprIrAddRhsLeafNode(
                ir, ctx.sourcePath, scope.name, lineNumber,
                TypedExprIrOpEmptySeqInit, expectedType, surface, surface)
        var elemNodes: int32[]
        for childOrdinal in 0..<childCount:
            let elemNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber,
                TypedExprIrValueExprChildAt(tree, nodeIndex, childOrdinal),
                elemType)
            let itemType = TypedExprCallRuntimeType(
                TypedExprIrValueExprNodeResultType(ir, elemNode))
            if itemType == "" || itemType == "unknown":
                panic("typed expr: structural list element type unavailable")
            if elemType == "":
                elemType = itemType
            elif elemType != itemType:
                panic("typed expr: structural list element types differ")
            add(elemNodes, elemNode)
        var elemSize: int32
        var elemAlign: int32
        if elemType == "str":
            elemSize = 24
            elemAlign = 8
        elif !TypedExprTypeIsScalar(elemType) ||
             !TypedExprTypeLayout(ctx, sourceContexts, elemType,
                                  elemSize, elemAlign):
            panic("typed expr: structural list element layout unavailable")
        var firstLink: int32 = -1
        var linkIndex = elemNodes.len - 1
        while linkIndex >= 0:
            firstLink = TypedExprIrAddRhsCallArgLinkNode(
                ir, ctx.sourcePath, scope.name, lineNumber,
                parser.ParserValueExprNodeText(
                    tree, TypedExprIrValueExprChildAt(tree, nodeIndex,
                                                       linkIndex)),
                elemNodes[linkIndex], firstLink)
            linkIndex = linkIndex - 1
        var listNode = TypedExprIrNodeNew()
        listNode.resultStructuralTypeId = -1
        listNode.callDeclarationIndex = -1
        listNode.sourcePath = ctx.sourcePath
        listNode.functionName = scope.name
        listNode.lineNumber = lineNumber
        listNode.opKind = TypedExprIrOpSeqLiteral
        listNode.resultType = strutil.Join([share(elemType), "[]"], "")
        if ir.exactTypeArena != nil && elemNodes.len > 0:
            let elementTypeId =
                TypedExprIrNodeStructuralTypeIdAt(
                    ir, elemNodes[0])
            var exactElementDomain = elementTypeId >= 0
            for elemIndex in 1..<elemNodes.len:
                if TypedExprIrNodeStructuralTypeIdAt(
                       ir, elemNodes[elemIndex]) !=
                       elementTypeId:
                    exactElementDomain = false
            if exactElementDomain:
                listNode.resultStructuralTypeId =
                    typearena.TypedExprTypeArenaUnaryTypeId(
                        ir.exactTypeArena,
                        typearena.TypedExprStructuralTypeSequence,
                        elementTypeId)
                typedExprIrBindNodeStructuralType(
                    ir,
                    listNode,
                    listNode.resultStructuralTypeId)
        listNode.surfaceText = surface
        listNode.paramSlot = -1
        listNode.operand0NodeIndex = firstLink
        listNode.operand1NodeIndex = -1
        listNode.operand2NodeIndex = -1
        listNode.literalText = elemType
        listNode.elemSizeBytes = elemSize
        return TypedExprIrAddNode(ir, listNode)
    panic("typed expr: structural composite value dispatch mismatch")

@borrows
fn typedExprIrBuildValueExprNodeCallFmtActive(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        nodeIndex: int32,
        expectedTypeRaw: str): int32 =
    expectedTypeRaw
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: structural value consumer has no parser lease")
    let kind = parser.ParserValueExprNodeKindAt(tree, nodeIndex)
    let surface = parser.ParserValueExprNodeText(tree, nodeIndex)
    if kind == parser.ParserValueExprCall:
        let rootStart = parser.ParserValueExprNodeArgumentRootStart(tree,
                                                                    nodeIndex)
        let rootCount = parser.ParserValueExprNodeArgumentRootCount(tree,
                                                                    nodeIndex)
        let resultTypeRaw = TypedExprIrValueExprCallResultType(ir, nodeIndex)
        var calleeParserNodeIndex: int32
        let fieldCalleeKind = typedExprIrValueCallFieldCalleeKind(
            ir, ctx.sourcePath, tree, nodeIndex,
            calleeParserNodeIndex)
        # new(T):堆对象分配内征(与文本路径 TypedExprIrBuildRhsWholeCallNode 的
        # new 专臂同一契约):callHead=="new" 是后端识别的分配头(primary
        # node-eval 按 literalText=="new" 专支消费 surfaceText),不是函数;唯一
        # 实参 `T` 是类型名而非值表达式——走下方 arg-loop 会把 T 当值建节点
        # (binding resolution None → ident miss -1)→ structural nested call
        # argument panic。在此建占位 CallExpr 叶节点(literalText="new"、
        # surfaceText 保留完整 `new(T)`、resultType=ref{T}、无子参节点、
        # callKind=Builtin、exprClass=Owned),并按参数 typeId 同款拼写(T 类型
        # 声明行的 TypeSyntax 根 → TypeArena id,typedExprIrParamStructuralTypeIdsExact
        # 同款声明行扫描)绑定结构类型,满足 CallResult value-definition 的
        # exactTypeId/ownership/proof 审计。T 非具体 ref{T}/声明行不唯一/
        # TypeArena 权威缺席时不拦截,原样落 arg-loop fail-closed。
        if ir.exactTypeArena != nil && ir.valueDefinitionTypeArenaBound &&
           rootCount == 1 &&
           TypedExprQualifiedCallLeaf(
               TypedExprIrValueExprCallHead(tree, nodeIndex)) == "new":
            let newTypeArgRoot = parser.ParserValueExprRootNodeAt(tree,
                                                                  rootStart)
            let newTypeArgText = chengpath.PathTrim(
                parser.ParserValueExprNodeText(tree, newTypeArgRoot))
            let newResultType = TypedExprNormalizeTypeText(
                Fmt"ref{newTypeArgText}")
            if newTypeArgText != "" &&
               TypedExprTypeTextIsConcrete(newResultType):
                var newTypeId: int32 = -1
                var newTypeHits: int32
                for newDeclarationRow in 0..<tree.declarationCount:
                    if arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.declarationKinds,
                           newDeclarationRow) !=
                           Int32(parser.ParserDeclarationType):
                        continue
                    let newNameToken = arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.declarationNameTokenIndexes,
                        newDeclarationRow)
                    if parser.ParserValueExprTokenText(tree, newNameToken) !=
                           newTypeArgText:
                        continue
                    newTypeHits = newTypeHits + 1
                    let newTypeSyntaxRoot = arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.declarationTypeSyntaxRootIndexes,
                        newDeclarationRow)
                    if newTypeSyntaxRoot >= 0 && newTypeId < 0:
                        newTypeId =
                            typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                                ir.exactTypeArena, newTypeSyntaxRoot)
                if newTypeHits == 1 && newTypeId >= 0:
                    var newNode = TypedExprIrNodeNew()
                    newNode.resultStructuralTypeId = -1
                    newNode.callDeclarationIndex = -1
                    newNode.sourcePath = ctx.sourcePath
                    newNode.functionName = scope.name
                    newNode.lineNumber = lineNumber
                    newNode.opKind = TypedExprIrOpCallExpr
                    newNode.resultType = newResultType
                    newNode.surfaceText = surface
                    newNode.paramSlot = -1
                    newNode.paramName = ""
                    newNode.operand0NodeIndex = -1
                    newNode.operand1NodeIndex = -1
                    newNode.operand2NodeIndex = -1
                    newNode.literalText = "new"
                    newNode.callKind = TypedExprCallBuiltin
                    newNode.originParserNodeId =
                        TypedExprIrValueExprCallOriginParserNodeId(
                            ir,
                            nodeIndex,
                            parser.ParserValueExprNodeSourceLocalIndexAt(
                                tree, nodeIndex))
                    typedExprIrBindNodeStructuralType(ir, newNode, newTypeId)
                    newNode.exprClass =
                        TypedExprIrExprClassForResultTypeExact(
                            ir,
                            ctx.sourcePath,
                            newNode.resultType,
                            TypedExprExprOwned)
                    return TypedExprIrAddNode(ir, newNode)
        var conversionPreflight = TypedExprExplicitTypeConversionNone
        var conversionOperandRoot: int32 = -1
        if rootCount == 1:
            conversionOperandRoot = parser.ParserValueExprRootNodeAt(
                tree, rootStart)
            if parser.ParserValueExprNodeArgumentName(
                   tree, conversionOperandRoot) == "":
                conversionPreflight =
                    TypedExprIrValueExprConversionPreflight(
                        ctx,
                        sourceContexts,
                        scope,
                        lineNumber,
                        tree,
                        nodeIndex,
                        conversionOperandRoot)
        var argNodes: int32[]
        var argTypes: str[]
        for rootOrdinal in 0..<rootCount:
            let argRoot = parser.ParserValueExprRootNodeAt(
                tree, rootStart + rootOrdinal)
            let argNode = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, argRoot, "")
            if argNode < 0:
                panic("typed expr: structural nested call argument did not build")
            add(argNodes, argNode)
            let argType = TypedExprIrValueExprSemanticArgumentType(
                ir, tree, argRoot, argNode)
            if argType == "" || argType == "unknown":
                panic("typed expr: structural nested call argument type unavailable")
            add(argTypes, argType)
        if conversionPreflight ==
           TypedExprExplicitTypeConversionIdentity:
            let conversionKind =
                TypedExprIrValueExprConversionClassify(
                    ir,
                    ctx,
                    sourceContexts,
                    scope,
                    lineNumber,
                    tree,
                    nodeIndex,
                    conversionOperandRoot,
                    argNodes[0])
            if conversionKind != conversionPreflight:
                panic("typed expr: call-shaped type conversion preflight/realizer drift")
            return argNodes[0]
        var firstLink: int32 = -1
        var linkIndex = argNodes.len - 1
        while linkIndex >= 0:
            let argRoot = parser.ParserValueExprRootNodeAt(
                tree, rootStart + linkIndex)
            firstLink = TypedExprIrAddRhsCallArgLinkNode(
                ir, ctx.sourcePath, scope.name, lineNumber,
                parser.ParserValueExprNodeText(tree, argRoot),
                argNodes[linkIndex], firstLink)
            linkIndex = linkIndex - 1
        var calleeTypedNodeIndex: int32 = -1
        var functionTypeId: int32 = -1
        if fieldCalleeKind == 1:
            calleeTypedNodeIndex = TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber,
                calleeParserNodeIndex, "")
            if calleeTypedNodeIndex < 0 ||
               ir.nodes2_opKinds[calleeTypedNodeIndex] !=
                   TypedExprIrOpFieldGet:
                panic("typed expr: field call callee did not build exact FieldGet")
            functionTypeId = typedExprIrPhysicalFunctionTypeId(
                ir,
                TypedExprIrNodeStructuralTypeIdAt(
                    ir, calleeTypedNodeIndex))
            if functionTypeId < 0:
                panic("typed expr: field call callee is not a structural function type")
        var callNode = TypedExprIrNodeNew()
        callNode.resultStructuralTypeId = -1
        callNode.callDeclarationIndex = -1
        callNode.sourcePath = ctx.sourcePath
        callNode.functionName = scope.name
        callNode.lineNumber = lineNumber
        callNode.originParserNodeId =
            TypedExprIrValueExprCallOriginParserNodeId(
                ir,
                nodeIndex,
                parser.ParserValueExprNodeSourceLocalIndexAt(tree,
                                                              nodeIndex))
        callNode.opKind = TypedExprIrOpCallExpr
        callNode.surfaceText = surface
        callNode.paramSlot = -1
        callNode.operand0NodeIndex = firstLink
        callNode.operand1NodeIndex = -1
        callNode.operand2NodeIndex = calleeTypedNodeIndex
        callNode.literalText = TypedExprIrValueExprCallHead(tree, nodeIndex)
        callNode.callKind =
            TypedExprIrCallKindForCallee(callNode.literalText)
        var resolvedResultType = ""
        if fieldCalleeKind != 1:
            TypedExprIrResolveStructuralCallAuthority(
                ir,
                ctx,
                sourceContexts,
                nodeIndex,
                argTypes,
                resultTypeRaw,
                callNode.callTarget,
                callNode.callTargetSourcePath,
                callNode.callTargetSignatureLineNumber,
                callNode.callTargetImportc,
                callNode.callDeclarationIndex,
                callNode.exprClass,
                resolvedResultType)
        else:
            resolvedResultType = resultTypeRaw
        if resolvedResultType == "" || resolvedResultType == "unknown" ||
           resolvedResultType == "call_expr" || resolvedResultType == "void":
            panic("typed expr: structural nested call has no concrete value type")
        callNode.resultType = TypedExprIrRuntimeScalarType(
            ir, ctx.sourcePath, resolvedResultType)
        if fieldCalleeKind == 1:
            callNode.resultStructuralTypeId =
                typedExprIrFunctionReturnTypeId(
                    ir, functionTypeId)
            callNode.exprClass = TypedExprIrExprClassForResultTypeExact(
                ir, ctx.sourcePath, callNode.resultType,
                TypedExprExprOwned)
        else:
            callNode.resultStructuralTypeId =
                typedExprIrExactCallReturnTypeId(
                    ir, callNode.callDeclarationIndex)
            if callNode.resultStructuralTypeId < 0:
                callNode.resultStructuralTypeId =
                    typedExprIrReservedScalarTypeIdForRuntimeType(
                        ir, callNode.resultType)
        typedExprIrBindNodeStructuralType(
            ir, callNode, callNode.resultStructuralTypeId)
        return TypedExprIrAddNode(ir, callNode)
    if kind == parser.ParserValueExprFmtLiteral:
        let sourceId = parser.ParserValueExprNodeSourceIdAt(tree, nodeIndex)
        let source = parser.ParserValueExprSourceText(tree, sourceId)
        let fmtStart = parser.ParserValueExprNodeSpanStartAt(tree, nodeIndex)
        let fmtEnd = parser.ParserValueExprNodeSpanEndAt(tree, nodeIndex)
        if fmtStart + 5 > fmtEnd || fmtEnd > source.len:
            panic("typed expr: structural Fmt node span invalid")
        # [wall140] 嵌套 Fmt 位于外层插值洞内时，其定界符是转义形 `\"`
        # （顶层形为单字符 `Fmt"`）。此前一律按 +4/-1 剥壳：转义形的开引号
        # `"` 被收进首段、闭 `\` 留在尾段（cold_nested 实测字面量池首段
        # `"inner=` 尾段 `\`，拼出 outer="inner=asset-7\，len 20 ≠ 19 判
        # fail）。此处按 parser 同一转义约定逐字节判定定界形：开侧直接
        # 判 `"`/`\"` 两种合法形（其余 panic fail-closed），闭侧用
        # ParserQuoteIsEscaped 判闭引号是否转义形。两种形各自精确，无启发式。
        var contentEnd = fmtEnd - 1
        if parser.ParserQuoteIsEscaped(source, contentEnd):
            contentEnd = contentEnd - 1
        var literalStart = fmtStart + 3
        if source[literalStart] == '\\':
            if literalStart + 1 >= fmtEnd || source[literalStart + 1] != '"':
                panic("typed expr: structural Fmt escaped open quote missing")
            literalStart = literalStart + 2
        elif source[literalStart] == '"':
            literalStart = literalStart + 1
        else:
            panic("typed expr: structural Fmt open quote missing")
        var pieceNodes: int32[]
        let childCount = parser.ParserValueExprNodeChildCount(tree, nodeIndex)
        for childOrdinal in 0..<childCount:
            let childIndex = TypedExprIrValueExprChildAt(tree,
                                                         nodeIndex,
                                                         childOrdinal)
            let childStart = parser.ParserValueExprNodeSpanStartAt(tree,
                                                                   childIndex)
            let childEnd = parser.ParserValueExprNodeSpanEndAt(tree,
                                                               childIndex)
            var openBrace = childStart - 1
            while openBrace >= literalStart && source[openBrace] != '{':
                openBrace = openBrace - 1
            if openBrace < literalStart:
                panic("typed expr: structural Fmt interpolation open brace missing")
            if openBrace > literalStart:
                let literalText = TypedExprIrValueFmtStaticLiteral(
                    source, literalStart, openBrace)
                add(pieceNodes, TypedExprIrAddRhsLeafNode(
                    ir, ctx.sourcePath, scope.name, lineNumber,
                    TypedExprIrOpStrLit, "str", literalText, literalText))
            add(pieceNodes, TypedExprIrBuildValueExprNode(
                ir, ctx, sourceContexts, scope, lineNumber, childIndex, ""))
            var closeBrace = childEnd
            while closeBrace < fmtEnd &&
                  (source[closeBrace] == ' ' || source[closeBrace] == '\t' ||
                   source[closeBrace] == '\r' || source[closeBrace] == '\n'):
                closeBrace = closeBrace + 1
            if closeBrace >= fmtEnd || source[closeBrace] != '}':
                panic("typed expr: structural Fmt interpolation close brace missing")
            literalStart = closeBrace + 1
        # [wall140] 尾段沿用上方转义感知的 contentEnd（原 `let contentEnd =
        # fmtEnd - 1` 会遮蔽转义定界的剥壳结果，尾段 `\` 因此漏进字面量）。
        if literalStart < contentEnd || pieceNodes.len == 0:
            let literalText = TypedExprIrValueFmtStaticLiteral(
                source, literalStart, contentEnd)
            add(pieceNodes, TypedExprIrAddRhsLeafNode(
                ir, ctx.sourcePath, scope.name, lineNumber,
                TypedExprIrOpStrLit, "str", literalText, literalText))
        var firstLink: int32 = -1
        var linkIndex = pieceNodes.len - 1
        while linkIndex >= 0:
            firstLink = TypedExprIrAddRhsCallArgLinkNode(
                ir, ctx.sourcePath, scope.name, lineNumber,
                TypedExprIrValueExprNodeResultType(ir,
                                                   pieceNodes[linkIndex]),
                pieceNodes[linkIndex], firstLink)
            linkIndex = linkIndex - 1
        var fmtNode = TypedExprIrNodeNew()
        fmtNode.resultStructuralTypeId = -1
        fmtNode.callDeclarationIndex = -1
        fmtNode.sourcePath = ctx.sourcePath
        fmtNode.functionName = scope.name
        fmtNode.lineNumber = lineNumber
        fmtNode.opKind = TypedExprIrOpFmt
        fmtNode.resultType = "str"
        typedExprIrBindNodeStructuralType(
            ir,
            fmtNode,
            typedExprIrReservedScalarTypeId(
                ir, typearena.TypedExprStructuralScalarStr))
        fmtNode.surfaceText = surface
        fmtNode.paramSlot = -1
        fmtNode.operand0NodeIndex = firstLink
        fmtNode.operand1NodeIndex = -1
        fmtNode.operand2NodeIndex = -1
        return TypedExprIrAddNode(ir, fmtNode)
    let unsupportedKind = TypedExprIrStructuralValueUnsupportedKind(kind)
    if unsupportedKind == TypedExprStructuredValueSupported:
        panic(Fmt"typed expr: missing structural value consumer kind={Int32(kind)} surface={surface}")
    panic(Fmt"typed expr: unsupported structural value case={Int32(unsupportedKind)} parser_kind={Int32(kind)} surface={surface}")

@borrows
fn TypedExprIrBuildValueExprNodeActive(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        nodeIndex: int32,
        expectedTypeRaw: str): int32 =
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: structural value consumer has no parser lease")
    let kind = parser.ParserValueExprNodeKindAt(tree, nodeIndex)
    if kind == parser.ParserValueExprGrouped ||
       kind == parser.ParserValueExprIdentifier ||
       kind == parser.ParserValueExprBoolLiteral ||
       kind == parser.ParserValueExprCharLiteral ||
       kind == parser.ParserValueExprStringLiteral ||
       kind == parser.ParserValueExprFloatLiteral ||
       kind == parser.ParserValueExprIntegerLiteral ||
       kind == parser.ParserValueExprNilLiteral ||
       kind == parser.ParserValueExprTypeConversion ||
       kind == parser.ParserValueExprField ||
       kind == parser.ParserValueExprIndex ||
       kind == parser.ParserValueExprUnary:
        return typedExprIrBuildValueExprNodePrefixActive(
            ir, ctx, sourceContexts, scope, lineNumber,
            nodeIndex, expectedTypeRaw)
    if kind == parser.ParserValueExprBinary ||
       kind == parser.ParserValueExprTernary ||
       kind == parser.ParserValueExprIf ||
       kind == parser.ParserValueExprListLiteral:
        return typedExprIrBuildValueExprNodeCompositeActive(
            ir, ctx, sourceContexts, scope, lineNumber,
            nodeIndex, expectedTypeRaw)
    return typedExprIrBuildValueExprNodeCallFmtActive(
        ir, ctx, sourceContexts, scope, lineNumber,
        nodeIndex, expectedTypeRaw)

@borrows
fn TypedExprIrPopulateCallArgNodeChain(ir: var TypedExprIr,
                                        ctx: var TypedExprSourceContext,
                                        sourceContexts: TypedExprSourceContext[],
                                        scope: TypedExprFunctionScope,
                                        lineNumber: int32,
                                        stmt: var TypedExprIrStatement) =
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    stmt.callArgTypesText = ""
    if ir.valueExprTree == nil || !ir.valueExprTreeBorrowLease:
        # Treeless layer (CSG compact frontier pipeline never produces the
        # parser value-expr tree): fall back to the exact pre-migration text
        # argument chain.  The structural path below stays authoritative
        # whenever the tree is present.
        var textCallHead = stmt.surfaceText
        if textCallHead == "":
            textCallHead = stmt.callTarget
        let textArgsText = chengpath.PathTrim(stmt.callArgsText)
        if textArgsText == "" || textCallHead == "":
            return
        let textArgTexts = TypedExprSplitTopLevelCsv(share(textArgsText))
        if textArgTexts.len <= 0:
            return
        var textArgValueNodes: int32[]
        textArgValueNodes = []
        for i in 0..<textArgTexts.len:
            let textArgText = chengpath.PathTrim(textArgTexts[i])
            if textArgText == "":
                return
            let textExpectedArgType = TypedExprCallParamTypeAt(ir,
                                                               ctx,
                                                               sourceContexts,
                                                               textCallHead,
                                                               textArgsText,
                                                               lineNumber,
                                                               i)
            let textArgNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                             ctx,
                                                                             sourceContexts,
                                                                             share(scope),
                                                                             lineNumber,
                                                                             share(textArgText),
                                                                             textExpectedArgType)
            if textArgNode < 0:
                # enum-成员-实参专臂 (见 TypedExprIrBuildEnumScopedConstArgNode); miss
                # 仍原路 fail-closed。
                let textEnumScopedArgNode = TypedExprIrBuildEnumScopedConstArgNode(ir,
                                                                                   ctx,
                                                                                   share(scope),
                                                                                   lineNumber,
                                                                                   share(textArgText))
                if textEnumScopedArgNode < 0:
                    return
                add(textArgValueNodes, textEnumScopedArgNode)
                continue
            add(textArgValueNodes, textArgNode)
        var textFirstLink: int32 = -1
        var textLinkIndex = textArgValueNodes.len - 1
        while textLinkIndex >= 0:
            textFirstLink = TypedExprIrAddRhsCallArgLinkNode(ir,
                                                             ctx.sourcePath,
                                                             scope.name,
                                                             lineNumber,
                                                             chengpath.PathTrim(textArgTexts[textLinkIndex]),
                                                             textArgValueNodes[textLinkIndex],
                                                             textFirstLink)
            textLinkIndex = textLinkIndex - 1
        stmt.callArgNodeStart = textFirstLink
        stmt.callArgNodeCount = textArgValueNodes.len
        stmt.callArgTypesText = TypedExprIrCallArgTypesText(ctx,
                                                            sourceContexts,
                                                            scope,
                                                            lineNumber,
                                                            textArgsText)
        return
    if stmt.valueExprCallNodeIndex < 0:
        if stmt.callArgCount != 0:
            panic("typed expr: call arguments have no structural call node")
        return
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: call statement has no structural tree lease")
    let nodeKind = parser.ParserValueExprNodeKindAt(
        tree, stmt.valueExprCallNodeIndex)
    if nodeKind != parser.ParserValueExprCall:
        panic("typed expr: strict call statement does not reference Call node")
    let rootStart = parser.ParserValueExprNodeArgumentRootStart(
        tree, stmt.valueExprCallNodeIndex)
    let rootCount = parser.ParserValueExprNodeArgumentRootCount(
        tree, stmt.valueExprCallNodeIndex)
    if rootStart != stmt.valueExprArgRootStart ||
       rootCount != stmt.valueExprArgRootCount:
        let producerSourceIndex =
            parser.ParserValueExprNodeProducerSourceIndexAt(
                tree, stmt.valueExprCallNodeIndex)
        let sourceLocalNodeId =
            parser.ParserValueExprNodeSourceLocalIndexAt(
                tree, stmt.valueExprCallNodeIndex)
        panic(Fmt"typed expr: call fact root range differs from parser authority aggregate_node={stmt.valueExprCallNodeIndex} producer_source={producerSourceIndex} source_local_node={sourceLocalNodeId} parser_root_start={rootStart} fact_root_start={stmt.valueExprArgRootStart} parser_root_count={rootCount} fact_root_count={stmt.valueExprArgRootCount} call_arg_count={stmt.callArgCount} source={ctx.sourcePath} function={scope.name} line={lineNumber}")
    # `callArgCount` is populated only on the dedicated NormalizedExprCall
    # fact. Return/assignment roots carry the same exact Call node through the
    # structural identity columns above, so derive their count from that
    # parser-owned row rather than treating a non-call fact's zero as
    # authority.
    stmt.callArgCount = rootCount
    for rootOrdinal in 0..<rootCount:
        TypedExprValueExprValidateConversionsPreflight(
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            tree,
            parser.ParserValueExprRootNodeAt(
                tree, rootStart + rootOrdinal))
    var argValueNodes: int32[]
    var argTypes: str[]
    for rootOrdinal in 0..<rootCount:
        let rootNode = parser.ParserValueExprRootNodeAt(
            tree, rootStart + rootOrdinal)
        let argNode = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, lineNumber, rootNode, "")
        if argNode < 0:
            panic("typed expr: structural call argument did not build")
        let argType = TypedExprIrValueExprSemanticArgumentType(
            ir, tree, rootNode, argNode)
        if argType == "" || argType == "unknown":
            panic("typed expr: structural call argument type unavailable")
        add(argValueNodes, argNode)
        add(argTypes, argType)
    var firstLink: int32 = -1
    var linkIndex = argValueNodes.len - 1
    while linkIndex >= 0:
        let rootNode = parser.ParserValueExprRootNodeAt(
            tree, rootStart + linkIndex)
        var rootSurface = parser.ParserValueExprNodeText(tree, rootNode)
        let argumentName = parser.ParserValueExprNodeArgumentName(
            tree, rootNode)
        if argumentName != "":
            rootSurface = Fmt"{argumentName}: {rootSurface}"
        firstLink = TypedExprIrAddRhsCallArgLinkNode(
            ir, ctx.sourcePath, scope.name, lineNumber,
            rootSurface, argValueNodes[linkIndex], firstLink)
        linkIndex = linkIndex - 1
    stmt.callArgNodeStart = firstLink
    stmt.callArgNodeCount = argValueNodes.len
    stmt.callArgTypesText = strutil.Join(argTypes, ",")

@borrows
fn typedExprIrCollectStatementCallArgTypesRec(
        ir: var TypedExprIr,
        tree: parser.ParserValueExprTree,
        statementArgRootStart: int32,
        callArgNodeCount: int32,
        argOrdinal: int32,
        linkNode: int32,
        argTypes: var str[]): int32 =
    while true:
        if argOrdinal >= callArgNodeCount:
            return linkNode
        if linkNode < 0 || linkNode >= ir.nodes2_nodeIndexs.len ||
           ir.nodes2_opKinds[linkNode] != TypedExprIrOpArgLink:
            panic("typed expr: structural call argument link chain invalid")
        let valueNode = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand0NodeIndexs, linkNode)
        let rootNode = parser.ParserValueExprRootNodeAt(
            tree, statementArgRootStart + argOrdinal)
        let argType = TypedExprIrValueExprSemanticArgumentType(
            ir, tree, rootNode, valueNode)
        if argType == "" || argType == "unknown":
            panic("typed expr: structural call statement argument type unavailable")
        add(argTypes, strings.CloneStr(argType))
        let nextLink = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand1NodeIndexs, linkNode)
        argOrdinal = argOrdinal + 1
        linkNode = nextLink
        continue

@borrows
fn typedExprIrProjectStatementCallArgsFromBuiltRoot(
        ir: var TypedExprIr,
        stmt: var TypedExprIrStatement) =
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    stmt.callArgTypesText = ""
    if stmt.rhsNodeIndex < 0:
        return
    if stmt.rhsNodeIndex >= ir.nodes2_nodeIndexs.len:
        panic("typed expr: statement value root node is out of range")
    if ir.nodes2_opKinds[stmt.rhsNodeIndex] != TypedExprIrOpCallExpr:
        return
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: built statement CallExpr has no parser lease")
    if stmt.valueExprRootNodeIndex < 0 ||
       (stmt.valueExprCallNodeIndex >= 0 &&
        stmt.valueExprCallNodeIndex != stmt.valueExprRootNodeIndex):
        panic("typed expr: built statement CallExpr parser root drift")
    let rootKind = parser.ParserValueExprNodeKindAt(
        tree, stmt.valueExprRootNodeIndex)
    if rootKind != parser.ParserValueExprCall &&
       rootKind != parser.ParserValueExprSpaceCall:
        panic("typed expr: built statement CallExpr parser kind drift")
    let expectedOrigin = TypedExprIrValueExprCallOriginParserNodeId(
        ir, stmt.valueExprRootNodeIndex, stmt.originParserNodeId)
    if arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.nodes2_originParserNodeIds,
           stmt.rhsNodeIndex) != expectedOrigin:
        panic("typed expr: built statement CallExpr parser origin drift")
    let rootStart = parser.ParserValueExprNodeArgumentRootStart(
        tree, stmt.valueExprRootNodeIndex)
    let rootCount = parser.ParserValueExprNodeArgumentRootCount(
        tree, stmt.valueExprRootNodeIndex)
    if rootStart != stmt.valueExprArgRootStart ||
       rootCount != stmt.valueExprArgRootCount:
        panic("typed expr: built statement CallExpr argument range drift")
    let firstLink = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_operand0NodeIndexs,
        stmt.rhsNodeIndex)
    var argTypes: str[]
    let terminalLink = typedExprIrCollectStatementCallArgTypesRec(
        ir, tree, rootStart, rootCount, 0, firstLink, argTypes)
    if terminalLink != -1 || argTypes.len != rootCount:
        panic("typed expr: built statement CallExpr argument chain drift")
    stmt.callArgCount = rootCount
    stmt.callArgNodeStart = firstLink
    stmt.callArgNodeCount = rootCount
    stmt.callArgTypesText = strutil.Join(argTypes, ",")

@borrows
fn TypedExprIrBuildStatementCallRoot(ir: var TypedExprIr,
                                      ctx: var TypedExprSourceContext,
                                      sourceContexts: TypedExprSourceContext[],
                                      scope: TypedExprFunctionScope,
                                      stmt: var TypedExprIrStatement): int32 =
    if ir.valueExprTree == nil || !ir.valueExprTreeBorrowLease:
        # Treeless layer: exact pre-migration text whole-call builder (same
        # producer chain the structural path replaced; kept for layers the
        # parser tree has not reached yet).
        var textCallSkipReason = ""
        let ownedSurface = strings.CloneStr(stmt.surfaceText)
        let ownedArgs = strings.CloneStr(stmt.callArgsText)
        let textCallNode = TypedExprIrBuildRhsWholeCallNode(ir,
                                                            ctx,
                                                            sourceContexts,
                                                            scope,
                                                            stmt.lineNumber,
                                                            Fmt"{ownedSurface}({ownedArgs})",
                                                            true,
                                                            "",
                                                            textCallSkipReason)
        if textCallNode < 0:
            let _hint21454 = TypedExprIrConsumeRhsBailHint()
            if _hint21454 != "":
                stmt.rhsBailReason = TypedExprIrRhsBailReasonForHint(_hint21454)
            elif textCallSkipReason == "ambig_target":
                stmt.rhsBailReason = RhsBailCallTargetAmbiguous
            elif textCallSkipReason == "missing_target":
                stmt.rhsBailReason = RhsBailCallTargetMissing
            elif textCallSkipReason == "fmt":
                stmt.rhsBailReason = RhsBailFmt
            elif textCallSkipReason == "bad_token":
                stmt.rhsBailReason = RhsBailBadToken
            else:
                stmt.rhsBailReason = RhsBailWholeCallNoTrace
        return textCallNode
    if stmt.valueExprRootNodeIndex < 0:
        panic(Fmt"typed expr: call statement has no parser-owned value root source={ctx.sourcePath} function={scope.name} line={stmt.lineNumber} call_node={stmt.valueExprCallNodeIndex} surface={stmt.surfaceText}")
    if stmt.valueExprRootNodeIndex != stmt.valueExprCallNodeIndex:
        panic("typed expr: call statement root differs from call node")
    let originParserNodeId =
        TypedExprIrValueExprCallOriginParserNodeId(
            ir,
            stmt.valueExprCallNodeIndex,
            stmt.originParserNodeId)
    let tree = ir.valueExprTree
    if parser.ParserValueExprNodeKindAt(tree,
                                        stmt.valueExprRootNodeIndex) !=
       parser.ParserValueExprCall:
        panic("typed expr: call statement root is not a strict Call node")
    if parser.ParserValueExprNodeSpanStartAt(
           tree, stmt.valueExprRootNodeIndex) != stmt.valueExprSpanStart ||
       parser.ParserValueExprNodeSpanEndAt(
           tree, stmt.valueExprRootNodeIndex) != stmt.valueExprSpanEnd:
        panic("typed expr: call statement root span differs from parser fact")
    var calleeParserNodeIndex: int32
    let fieldCalleeKind = typedExprIrValueCallFieldCalleeKind(
        ir, strings.CloneStr(ctx.sourcePath), tree, stmt.valueExprRootNodeIndex,
        calleeParserNodeIndex)
    var argTypes: str[]
    let statementArgRootStart =
        parser.ParserValueExprNodeArgumentRootStart(
            tree, stmt.valueExprRootNodeIndex)
    let terminalLink = typedExprIrCollectStatementCallArgTypesRec(
        ir, tree, statementArgRootStart, stmt.callArgNodeCount,
        0, stmt.callArgNodeStart, argTypes)
    if terminalLink != -1:
        panic("typed expr: structural call argument link chain has invalid terminator")
    var callNode = TypedExprIrNodeNew()
    callNode.resultStructuralTypeId = -1
    callNode.callDeclarationIndex = -1
    callNode.sourcePath = strings.CloneStr(ctx.sourcePath)
    callNode.functionName = strings.CloneStr(scope.name)
    callNode.lineNumber = stmt.lineNumber
    callNode.originParserNodeId = originParserNodeId
    callNode.opKind = TypedExprIrOpCallExpr
    callNode.surfaceText = strings.CloneStr(parser.ParserValueExprNodeText(
        tree, stmt.valueExprRootNodeIndex))
    callNode.paramSlot = -1
    callNode.operand0NodeIndex = stmt.callArgNodeStart
    callNode.operand1NodeIndex = -1
    callNode.operand2NodeIndex = -1
    callNode.literalText = strings.CloneStr(TypedExprIrValueExprCallHead(
        tree, stmt.valueExprRootNodeIndex))
    callNode.callKind =
        TypedExprIrCallKindForCallee(callNode.literalText)
    if callNode.callKind != stmt.callKind:
        panic("typed expr: statement/call-node intrinsic identity drift")
    var functionTypeId: int32 = -1
    if fieldCalleeKind == 1:
        callNode.operand2NodeIndex = TypedExprIrBuildValueExprNode(
            ir, ctx, sourceContexts, scope, stmt.lineNumber,
            calleeParserNodeIndex, "")
        if callNode.operand2NodeIndex < 0 ||
           ir.nodes2_opKinds[callNode.operand2NodeIndex] !=
               TypedExprIrOpFieldGet:
            panic("typed expr: statement CallExpr field callee missing")
        functionTypeId = typedExprIrPhysicalFunctionTypeId(
            ir,
            TypedExprIrNodeStructuralTypeIdAt(
                ir, callNode.operand2NodeIndex))
        if functionTypeId < 0:
            panic("typed expr: statement CallExpr field callee is not callable")
        callNode.resultType = TypedExprIrRuntimeScalarType(
            ir, strings.CloneStr(ctx.sourcePath), strings.CloneStr(stmt.resultType))
        callNode.resultStructuralTypeId =
            typedExprIrFunctionReturnTypeId(
                ir, functionTypeId)
        callNode.exprClass = TypedExprIrExprClassForResultTypeExact(
            ir, strings.CloneStr(ctx.sourcePath), callNode.resultType,
            TypedExprExprOwned)
    else:
        var resolvedTarget = ""
        var resolvedTargetSourcePath = ""
        var resolvedTargetSignatureLineNumber: int32
        var resolvedImportc = false
        var resolvedDeclarationIndex: int32 = -1
        var resolvedExprClass: TypedExprExprClass
        var resolvedResultType = strings.CloneStr(stmt.resultType)
        let resultTypeRaw = strings.CloneStr(stmt.resultType)
        TypedExprIrResolveStructuralCallAuthority(
            ir,
            ctx,
            sourceContexts,
            stmt.valueExprRootNodeIndex,
            argTypes,
            resultTypeRaw,
            resolvedTarget,
            resolvedTargetSourcePath,
            resolvedTargetSignatureLineNumber,
            resolvedImportc,
            resolvedDeclarationIndex,
            resolvedExprClass,
            resolvedResultType)
        callNode.callTarget = resolvedTarget
        callNode.callTargetSourcePath = resolvedTargetSourcePath
        callNode.callTargetSignatureLineNumber =
            resolvedTargetSignatureLineNumber
        callNode.callTargetImportc = resolvedImportc
        callNode.callDeclarationIndex = resolvedDeclarationIndex
        callNode.exprClass = resolvedExprClass
        if resolvedResultType != "":
            stmt.resultType = strings.CloneStr(resolvedResultType)
        callNode.resultType = TypedExprIrRuntimeScalarType(
            ir, strings.CloneStr(ctx.sourcePath), strings.CloneStr(stmt.resultType))
        callNode.resultStructuralTypeId =
            typedExprIrExactCallReturnTypeId(
                ir, callNode.callDeclarationIndex)
        if callNode.resultStructuralTypeId < 0:
            callNode.resultStructuralTypeId =
                typedExprIrReservedScalarTypeIdForRuntimeType(
                    ir, callNode.resultType)
    typedExprIrBindNodeStructuralType(
        ir, callNode, callNode.resultStructuralTypeId)
    stmt.callTarget = strings.CloneStr(callNode.callTarget)
    stmt.callTargetSourcePath = strings.CloneStr(callNode.callTargetSourcePath)
    stmt.callTargetSignatureLineNumber =
        callNode.callTargetSignatureLineNumber
    stmt.callTargetImportc = callNode.callTargetImportc
    return TypedExprIrAddNode(ir, callNode)

fn TypedExprIrStatementValueRootText(ir: var TypedExprIr,
                                      rootNodeIndex: int32,
                                      spanStart: int32,
                                      spanEnd: int32,
                                      role: parser.ParserValueExprStatementRole): str =
    if rootNodeIndex < 0 || role == parser.ParserValueExprStatementInvalid:
        panic(Fmt"typed expr: statement has no parser-owned value root root={rootNodeIndex} role={Int32(role)}")
    let tree = ir.valueExprTree
    if tree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: statement value root has no tree lease")
    if parser.ParserValueExprNodeSpanStartAt(tree, rootNodeIndex) != spanStart ||
       parser.ParserValueExprNodeSpanEndAt(tree, rootNodeIndex) != spanEnd:
        panic("typed expr: statement value span differs from parser authority")
    return parser.ParserValueExprNodeText(tree, rootNodeIndex)

@borrows
fn TypedExprIrBuildStatementValueRoot(ir: var TypedExprIr,
                                       ctx: var TypedExprSourceContext,
                                       sourceContexts: TypedExprSourceContext[],
                                       scope: TypedExprFunctionScope,
                                       stmt: var TypedExprIrStatement,
                                       expectedType: str): int32 =
    if ir.valueExprTree == nil || !ir.valueExprTreeBorrowLease:
        # Treeless layer: build the value node from the statement surface text
        # (pre-migration producer).  stmt.surfaceText for return statements is
        # the bare expression (parser strips `return `); assign statements
        # carry the RHS text (stmt.surfaceText = rhsText at :41510).
        var valueText = chengpath.PathTrim(stmt.surfaceText)
        if parser.ParserStartsWithExact(valueText, "return "):
            valueText = chengpath.PathTrim(chengpath.TextSlice(valueText,
                                                               7,
                                                               valueText.len - 7))
        if valueText == "" || valueText == "return":
            return -1
        return TypedExprIrBuildExprNodeWithExpectedType(ir,
                                                        ctx,
                                                        sourceContexts,
                                                        share(scope),
                                                        stmt.lineNumber,
                                                        valueText,
                                                        share(expectedType))
    if stmt.valueExprRootNodeIndex < 0 ||
       stmt.valueExprStatementRole ==
           parser.ParserValueExprStatementInvalid:
        panic(Fmt"typed expr: value parser root missing source={ctx.sourcePath} function={scope.name} line={stmt.lineNumber} kind={Int32(stmt.kind)} surface={stmt.surfaceText}")
    let _ = TypedExprIrStatementValueRootText(
        ir,
        stmt.valueExprRootNodeIndex,
        stmt.valueExprSpanStart,
        stmt.valueExprSpanEnd,
        stmt.valueExprStatementRole)
    TypedExprValueExprValidateConversionsPreflight(
        ctx,
        sourceContexts,
        scope,
        stmt.lineNumber,
        ir.valueExprTree,
        stmt.valueExprRootNodeIndex)
    let rootKind = parser.ParserValueExprNodeKindAt(
        ir.valueExprTree, stmt.valueExprRootNodeIndex)
    if rootKind == parser.ParserValueExprCall ||
       rootKind == parser.ParserValueExprSpaceCall:
        if stmt.valueExprCallNodeIndex >= 0 &&
           stmt.valueExprCallNodeIndex != stmt.valueExprRootNodeIndex:
            panic(Fmt"typed expr: statement root/call aggregate identity drift root={stmt.valueExprRootNodeIndex} call={stmt.valueExprCallNodeIndex} source={ctx.sourcePath} function={scope.name} line={stmt.lineNumber}")
        let originParserNodeId =
            TypedExprIrValueExprCallOriginParserNodeId(
                ir,
                stmt.valueExprRootNodeIndex,
                stmt.originParserNodeId)
        add(ir.originParserNodeStack, originParserNodeId)
        let rooted = TypedExprIrBuildValueExprNodeActive(
            ir,
            ctx,
            sourceContexts,
            scope,
            stmt.lineNumber,
            stmt.valueExprRootNodeIndex,
            expectedType)
        setLen(ir.originParserNodeStack,
               ir.originParserNodeStack.len - 1)
        return rooted
    return TypedExprIrBuildValueExprNode(ir,
                                         ctx,
                                         sourceContexts,
                                         scope,
                                         stmt.lineNumber,
                                         stmt.valueExprRootNodeIndex,
                                         expectedType)

fn TypedExprIrBindDirectCallAuthorityFromRhsNode(
        ir: var TypedExprIr,
        stmt: var TypedExprIrStatement) =
    if stmt.rhsNodeIndex < 0 ||
       stmt.rhsNodeIndex >= ir.nodes2_nodeIndexs.len ||
       ir.nodes2_opKinds[stmt.rhsNodeIndex] != TypedExprIrOpCallExpr:
        return
    let targetResult = langintern.LookupIntern(
        ir.internPool, ir.nodes2_callTargetIds[stmt.rhsNodeIndex])
    let sourceResult = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_callTargetSourcePathIds[stmt.rhsNodeIndex])
    if !IsOk(targetResult) || !IsOk(sourceResult):
        panic("typed expr: direct call authority intern id invalid")
    let target = Value(targetResult)
    let targetSource = Value(sourceResult)
    if (target == "") != (targetSource == ""):
        panic("typed expr: direct call authority target/source incomplete")
    if target == "" && targetSource == "":
        # The node carries no declaration row (e.g. a parser-preresolved
        # module-private cross-module call the declaration index hides behind
        # the export-visibility gate).  The statement's preresolved identity
        # from the fact is the authority here; do not clear it with the
        # unresolved node's empty fields.
        return
    stmt.callTarget = target
    stmt.callTargetSourcePath = targetSource
    stmt.callTargetSignatureLineNumber = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_callTargetSignatureLineNumbers,
        stmt.rhsNodeIndex)
    stmt.callTargetImportc =
        ir.nodes2_callTargetImportcs[stmt.rhsNodeIndex]

@borrows
fn TypedExprConstructorCallReturnType(ctx: TypedExprSourceContext,
                                       sourceContexts: TypedExprSourceContext[],
                                       callHeadRaw: str): str =
    let leaf = TypedExprQualifiedCallLeaf(chengpath.PathTrim(callHeadRaw))
    if leaf == "":
        return ""
    if leaf[0] < 'A' || leaf[0] > 'Z':
        return ""
    var typeSize: int32
    var typeAlign: int32
    if !TypedExprTypeLayout(ctx, sourceContexts, leaf, typeSize, typeAlign):
        return ""
    if typeSize <= 0:
        return ""
    return TypedExprNormalizeTypeText(leaf)

@borrows
fn TypedExprIrTextIsWholeFmtLiteral(text: str): bool =
    if text.len < 5 || !parser.ParserStartsWith(text, "Fmt\""):
        return false
    return TypedExprIrRhsTextIsStringLiteral(chengpath.TextSlice(text, 3, text.len - 3))

# Fmt 插值片段含 int-to-str 内征 `IntToStr(inner)`/`Int64ToStr(inner)`（裸或点限定
# 如 `strings.IntToStr`）：内征返回 str，但其值恒等于直接把 inner 标量拼进 Fmt
# （Fmt 标量片段本就经后端 scalar-to-str bridge 自动字符串化）。前端节点路径剥去
# 内征外壳、以 inner 作片段表达式建子节点（inner 可为裸标量/字段路径/真调用，由
# RhsNodeLevel 下降；inner 含真调用如 `IntToStr(twice(n))` 时经 call 面注册 ordinal
# 并发 bl 求值）。内征名集合限定 IntToStr/Int64ToStr；用更宽的规则会让别的输入上的
# 剥壳行为分叉。返回 inner 文本；非 int-to-str 内征片段返回 ""。
@borrows
fn TypedExprIrFmtIntToStrInner(textRaw: str): str =
    let text = chengpath.PathTrim(textRaw)
    let openPos = TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0:
        return ""
    let closePos = TypedExprFindMatchingParen(text, openPos)
    if closePos != text.len - 1:
        return ""
    let head = chengpath.PathTrim(chengpath.TextSlice(text, 0, openPos))
    if !TypedExprCallHeadIsPlainQualifiedIdent(head):
        return ""
    let tail = TypedExprQualifiedCallLeaf(head)
    if tail != "IntToStr" && tail != "Int64ToStr":
        return ""
    return TypedExprSliceTrim(text, openPos + 1, closePos - openPos - 1)

type
    typedExprFmtScanState = ref object
        i: int32
        litStart: int32
        pieceNodes: int32[]
        litFrags: str[]

@borrows
fn typedExprIrBuildFmtLinksRec(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        pieceNodes: var int32[],
        linkIndex: int32,
        firstLink: var int32) =
    while true:
        if linkIndex < 0:
            return
        let fmtPieceSurfaceRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_surfaceTextIds[pieceNodes[linkIndex]])
        let fmtPieceSurface = if IsOk(fmtPieceSurfaceRes): Value(fmtPieceSurfaceRes) else: ""
        firstLink = TypedExprIrAddRhsCallArgLinkNode(ir,
                                                     strings.CloneStr(ctx.sourcePath),
                                                     strings.CloneStr(scope.name),
                                                     lineNumber,
                                                     strings.CloneStr(fmtPieceSurface),
                                                     pieceNodes[linkIndex],
                                                     firstLink)
        linkIndex = linkIndex - 1
        continue

@borrows
fn typedExprIrBuildFmtScanRec(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        payload: str,
        st: typedExprFmtScanState): bool =
    while true:
        if st.i >= payload.len:
            return true
        let ch = payload[st.i]
        if ch == '{':
            if st.i + 1 < payload.len && payload[st.i + 1] == '{':
                if st.i > st.litStart:
                    add(st.litFrags, strings.CloneStr(chengpath.TextSlice(payload, st.litStart, st.i - st.litStart)))
                add(st.litFrags, "{")
                st.i = st.i + 2
                st.litStart = st.i
                continue
            if st.i > st.litStart:
                add(st.litFrags, strings.CloneStr(chengpath.TextSlice(payload, st.litStart, st.i - st.litStart)))
            st.litStart = st.i
            if st.litFrags.len > 0:
                let currentLiteral = strutil.Join(st.litFrags, "")
                let litText = strutil.Join(["\"", currentLiteral, "\""], "")
                if !TypedExprIrRhsTextIsStringLiteral(litText):
                    return false
                let litNode = TypedExprIrAddRhsLeafNode(ir,
                                                        strings.CloneStr(ctx.sourcePath),
                                                        strings.CloneStr(scope.name),
                                                        lineNumber,
                                                        TypedExprIrOpStrLit,
                                                        "str",
                                                        litText,
                                                        litText)
                if litNode < 0:
                    return false
                add(st.pieceNodes, litNode)
                st.litFrags = []
            let exprStart = st.i + 1
            var exprEnd = -1
            var inExprString = false
            var inExprChar = false
            var parenDepth: int32
            var bracketDepth: int32
            var braceDepth: int32
            var cursor = exprStart
            while cursor < payload.len:
                let cch = payload[cursor]
                if !inExprChar && cch == '"' &&
                   !(cursor > 0 && payload[cursor - 1] == '\\'):
                    inExprString = !inExprString
                    cursor = cursor + 1
                    continue
                if !inExprString && cch == '\'' &&
                   !(cursor > 0 && payload[cursor - 1] == '\\'):
                    inExprChar = !inExprChar
                    cursor = cursor + 1
                    continue
                if inExprString || inExprChar:
                    cursor = cursor + 1
                    continue
                if cch == '(':
                    parenDepth = parenDepth + 1
                elif cch == ')':
                    if parenDepth > 0:
                        parenDepth = parenDepth - 1
                elif cch == '[':
                    bracketDepth = bracketDepth + 1
                elif cch == ']':
                    if bracketDepth > 0:
                        bracketDepth = bracketDepth - 1
                elif cch == '{':
                    braceDepth = braceDepth + 1
                elif cch == '}':
                    if parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
                        exprEnd = cursor
                        break
                    if braceDepth > 0:
                        braceDepth = braceDepth - 1
                cursor = cursor + 1
            if exprEnd < exprStart:
                return false
            var exprText = TypedExprSliceTrim(payload, exprStart, exprEnd - exprStart)
            if exprText == "":
                return false
            let fmtIntToStrInner = TypedExprIrFmtIntToStrInner(exprText)
            if fmtIntToStrInner != "":
                exprText = fmtIntToStrInner
            let exprNode = TypedExprIrBuildRhsNodeLevel(ir,
                                                        ctx,
                                                        sourceContexts,
                                                        share(scope),
                                                        lineNumber,
                                                        exprText,
                                                        0)
            if exprNode < 0:
                return false
            add(st.pieceNodes, exprNode)
            st.i = exprEnd + 1
            st.litStart = st.i
            continue
        if ch == '}':
            if st.i + 1 < payload.len && payload[st.i + 1] == '}':
                if st.i > st.litStart:
                    add(st.litFrags, strings.CloneStr(chengpath.TextSlice(payload, st.litStart, st.i - st.litStart)))
                add(st.litFrags, "}")
                st.i = st.i + 2
                st.litStart = st.i
                continue
            return false
        st.i = st.i + 1
        continue

@borrows
fn TypedExprIrBuildFmtNode(ir: var TypedExprIr,
                            ctx: var TypedExprSourceContext,
                            sourceContexts: TypedExprSourceContext[],
                            scope: TypedExprFunctionScope,
                            lineNumber: int32,
                            text: str): int32 =
    if !TypedExprIrTextIsWholeFmtLiteral(text):
        return -1
    let payload = chengpath.TextSlice(text, 4, text.len - 5)
    var st: typedExprFmtScanState = new(typedExprFmtScanState)
    if !typedExprIrBuildFmtScanRec(
           ir, ctx, sourceContexts, scope, lineNumber, payload, st):
        return -1
    if payload.len > st.litStart:
        add(st.litFrags, strings.CloneStr(chengpath.TextSlice(payload, st.litStart, payload.len - st.litStart)))
    if st.litFrags.len > 0 || st.pieceNodes.len == 0:
        let currentLiteral = strutil.Join(st.litFrags, "")
        let tailLitText = strutil.Join(["\"", currentLiteral, "\""], "")
        if !TypedExprIrRhsTextIsStringLiteral(tailLitText):
            return -1
        let tailLitNode = TypedExprIrAddRhsLeafNode(ir,
                                                    strings.CloneStr(ctx.sourcePath),
                                                    strings.CloneStr(scope.name),
                                                    lineNumber,
                                                    TypedExprIrOpStrLit,
                                                    "str",
                                                    tailLitText,
                                                    tailLitText)
        if tailLitNode < 0:
            return -1
        add(st.pieceNodes, tailLitNode)
    var firstLink: int32 = -1
    typedExprIrBuildFmtLinksRec(
        ir, ctx, scope, lineNumber, st.pieceNodes, st.pieceNodes.len - 1, firstLink)
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = strings.CloneStr(ctx.sourcePath)
    node.functionName = strings.CloneStr(scope.name)
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpFmt
    node.resultType = "str"
    node.surfaceText = strings.CloneStr(text)
    node.paramSlot = -1
    node.paramName = ""
    node.operand0NodeIndex = firstLink
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = ""
    return TypedExprIrAddNode(ir, node)

# 基本数值转换函数 fn(literal)（uint64(0)/Int64(N)/int32(N)/UInt32(M) 等）在值层
# 是编译期常量转换，等价于「字面量按目标类型直接物化」。这些转换头是 std 的泛型/
# 重载函数（fn uint64(x: T)...），调用路径既解析不出唯一 ordinal、又把字面量包成
# CallExpr，落 text 路径（reason=call）。返回目标类型名（i64 类 8 字节、其余 4 字节），
# 非数值转换头返回 ""。后端 const node-eval（PrimaryBodyIrExtractInt64FromText/
# ExtractIntFromText）已能解析裸字面量文本，故此处建 I64Const/I32Const 叶节点即可。
@borrows
fn TypedExprIntConversionFnTargetType(headRaw: str): str =
    let head = chengpath.PathTrim(headRaw)
    if head == "int64" || head == "Int64":
        return "int64"
    if head == "uint64" || head == "UInt64":
        return "uint64"
    if head == "int32" || head == "Int32":
        return "int32"
    if head == "uint32" || head == "UInt32":
        return "uint32"
    if head == "int16" || head == "Int16":
        return "int16"
    if head == "uint16" || head == "UInt16":
        return "uint16"
    if head == "int8" || head == "Int8":
        return "int8"
    if head == "uint8" || head == "UInt8":
        return "uint8"
    return ""

# T69: `let x = <castHead>(<expr>)` 整句 RHS 是顶层具体标量转换头包一层表达式/
# 调用时(如 `int32(probeU32(...))`),castHead 才是绑定值运行期真实类型;被包表
# 达式自身的类型(如内层调用的返回类型 uint32)只是转换的输入，不是绑定类型。
# 复用上面的 TypedExprIntConversionFnTargetType(int8..uint64 数值转换头，已用于
# CallExpr 节点构建的同类识别)并补齐 float32/float64/bool/char/str（与
# TypedExprBuiltinCalleeReturnType 标量转换分支同一保留转换头集合），不含
# new/len/BytesAlloc 等其余内征调用头（避免过泛覆盖本不属于「标量转换」的调用）。
@borrows
fn TypedExprScalarCastHeadTargetType(headRaw: str): str =
    let head = chengpath.PathTrim(headRaw)
    let intTarget = TypedExprIntConversionFnTargetType(head)
    if intTarget != "":
        return intTarget
    if head == "float32":
        return "float32"
    if head == "float64":
        return "float64"
    if head == "bool":
        return "bool"
    if head == "char":
        return "char"
    if head == "str":
        return "str"
    return ""

# Resolve a call result against its structural sink/cast context.  A concrete
# declaration is authoritative and may not be rewritten by the sink.  Only a
# bare generic return placeholder (the `T` in `load(...): T`) is instantiated
# from a concrete expected type; missing/generic expectations and concrete
# conflicts fail closed.
@borrows
fn TypedExprWholeCallResultTypeWithExpected(returnTypeRaw: str,
                                             expectedTypeRaw: str,
                                             resultTypeOut: var str): bool =
    resultTypeOut = ""
    let declaredSurfaceType = TypedExprNormalizeTypeText(returnTypeRaw)
    let declaredType = TypedExprNormalizeTypeText(TypedExprStripVarType(returnTypeRaw))
    let expectedType = TypedExprNormalizeTypeText(TypedExprStripVarType(expectedTypeRaw))
    if declaredType == "" || declaredType == "unknown":
        return false
    if TypedExprTypeIsBareGenericPlaceholder(declaredSurfaceType):
        if expectedType == "" ||
           !TypedExprTypeTextIsConcrete(expectedType) ||
           TypedExprTypeIsGenericPlaceholder(expectedType):
            return false
        resultTypeOut = expectedType
        return true
    # `refT` and `varT` are wrapped generic shapes, not aliases for a bare T.
    # Their wrapper must be preserved by structural substitution; an arbitrary
    # scalar expected type cannot erase it.  This expected-result path has no
    # proof for the wrapped inner type, so leave it unresolved and fail closed.
    if TypedExprTypeIsGenericPlaceholder(declaredSurfaceType) ||
       TypedExprTypeIsGenericPlaceholder(declaredType):
        return false
    if !TypedExprTypeTextIsConcrete(declaredType):
        return false
    if expectedType != "" &&
       TypedExprTypeTextIsConcrete(expectedType) &&
       !TypedExprTypeIsGenericPlaceholder(expectedType) &&
       expectedType != declaredType:
        return false
    resultTypeOut = declaredType
    return true

# True only for an exact whole-call surface whose declared result is a bare
# generic placeholder.  This is the sole shape allowed to consume an outer
# expected type; every concrete call and every intrinsic miss remains owned by
# the ordinary structured RHS builder.
@borrows
fn TypedExprWholeCallNeedsExpectedResult(ctx: TypedExprSourceContext,
                                          sourceContexts: TypedExprSourceContext[],
                                          lineNumber: int32,
                                          textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "" || text[text.len - 1] != ')':
        return false
    let openPos = TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0 || TypedExprFindMatchingParen(text, openPos) != text.len - 1:
        return false
    let callHead = chengpath.PathTrim(chengpath.TextSlice(text, 0, openPos))
    if !TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return false
    if TypedExprNamedAggregateConstructorBindingTypeInContext(ctx,
                                                               sourceContexts,
                                                               text) != "":
        return false
    var returnTypeRaw = TypedExprBindingRhsCallReturnType(ctx,
                                                          sourceContexts,
                                                          lineNumber,
                                                          text)
    if returnTypeRaw == "":
        returnTypeRaw = TypedExprConstructorCallReturnType(ctx,
                                                            sourceContexts,
                                                            callHead)
    let declaredType = TypedExprNormalizeTypeText(returnTypeRaw)
    return declaredType != "" && TypedExprTypeIsBareGenericPlaceholder(declaredType)

# 整数字面量识别：可选前导 '-'，随后十进制数字、0x/0X 十六进制或 0b/0B 二进制。
# 与后端 PrimaryBodyIrExtractInt64FromDigits 的接受口径一致（裸字面量文本将原样
# 传给该提取器）。下划线分隔符同样接受。
@borrows
fn TypedExprTextIsIntegerLiteral(textRaw: str): bool =
    let text = chengpath.PathTrim(share(textRaw))
    if text == "":
        return false
    var start: int32
    if text[0] == '-':
        start = 1
    if start >= text.len:
        return false
    if start + 1 < text.len && text[start] == '0' &&
       (text[start + 1] == 'x' || text[start + 1] == 'X'):
        var hexDigits: int32
        for i in (start + 2)..<text.len:
            let ch = text[i]
            if ch == '_':
                continue
            if !((ch >= '0' && ch <= '9') ||
                 (ch >= 'a' && ch <= 'f') ||
                 (ch >= 'A' && ch <= 'F')):
                return false
            hexDigits = hexDigits + 1
        return hexDigits > 0
    if start + 1 < text.len && text[start] == '0' &&
       (text[start + 1] == 'b' || text[start + 1] == 'B'):
        var binDigits: int32
        for i in (start + 2)..<text.len:
            let ch = text[i]
            if ch == '_':
                continue
            if ch != '0' && ch != '1':
                return false
            binDigits = binDigits + 1
        return binDigits > 0
    var decDigits: int32
    for i in start..<text.len:
        let ch = text[i]
        if ch == '_':
            continue
        if ch < '0' || ch > '9':
            return false
        decDigits = decDigits + 1
    return decDigits > 0

# 批次5：RHS 整体为单个调用 Target(args...)（含模块限定 mod.Fn）时建
# CallExpr 节点。literalText=调用头（后端 whole-call ordinal 解析所需
# 形态），resultType=既有调用返回类型解析（enum 归一化 int32），
# operand0=首个 ArgLink（值节点经既有构建器构建；ArgLink.operand0=
# 实参值节点、operand1=下一 ArgLink/-1）。批次6a：实参经
# TypedExprIrBuildRhsNodeLevel 递归构建（嵌套调用走 primary 的 call
# 分支）；返回类型非具体（泛型 T 等）skip（reason=generic）；其余失败
# 保持 reason=call 桶口径。
# skipReasonOut carries the sub-classification back to the caller through the
# caller frame (var param) rather than the module global: the cold seed
# miscompiles a global-str read taken immediately after this function returns
# (the readback came back empty, collapsing nested_call/generic into a blank
# label). A var-param write lands in the caller's local reliably.
@borrows
fn TypedExprIrBuildRhsWholeCallNode(ir: var TypedExprIr,
                                    ctx: var TypedExprSourceContext,
                                    sourceContexts: TypedExprSourceContext[],
                                     scope: TypedExprFunctionScope,
                                     lineNumber: int32,
                                     text: str,
                                     allowVoid: bool,
                                     expectedTypeRaw: str,
                                     skipReasonOut: var str): int32 =
    skipReasonOut = "call"
    let openPos = TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0:
        return -1
    let closePos = TypedExprFindMatchingParen(text, openPos)
    if closePos <= openPos || closePos + 1 != text.len:
        return -1
    let callHead = chengpath.PathTrim(chengpath.TextSlice(text, 0, openPos))
    # Ok[T](v) / Err[T](msg) 构造内征：调用头带显式类型实参（`Ok[MiniDecoded]`），
    # 不是 plain qualified ident，会被下面的门拒绝（→ rhsNodeIndex=-1 → 后端 return/
    # let/assign 落文本路径 bail_801/no_node）。但后端 EvalNode 的 OpCallExpr 分支经
    # ResultConstructHead/InnerType(literalText) 识别构造头、按 Result[T] 模板物化 64B
    # 聚合（无 Ok/Err ordinal）。在此建 literalText 保留类型实参的 CallExpr 节点（单
    # payload 实参经 NoTrace 建节点），让驱动语句的节点求值器直接构造，绕开 plain-ident
    # 门与 ordinal 解析。无特判、无 fallback（构造头本就是后端识别的内征）。
    let rcBracketPos = parser.ParserFindText(share(callHead), "[")
    if rcBracketPos > 0:
        let rcLeaf = TypedExprQualifiedCallLeaf(
            chengpath.PathTrim(
                chengpath.TextSlice(
                    share(callHead), 0, rcBracketPos)))
        if rcLeaf == "Ok" || rcLeaf == "Err":
            let rcClosePos = TypedExprFindMatchingBracket(
                share(callHead), rcBracketPos)
            if rcClosePos > rcBracketPos && rcClosePos + 1 == callHead.len:
                let rcInner = chengpath.PathTrim(
                    chengpath.TextSlice(
                        share(callHead),
                        rcBracketPos + 1,
                        rcClosePos - rcBracketPos - 1))
                let rcArgsText = TypedExprSliceTrim(text, openPos + 1, closePos - openPos - 1)
                var rcArgTexts: str[]
                rcArgTexts = []
                if rcArgsText != "":
                    rcArgTexts = TypedExprSplitTopLevelCsv(rcArgsText)
                if rcArgTexts.len == 1 &&
                   TypedExprTypeTextIsConcrete(share(rcInner)):
                    let rcResultType = Fmt"Result[{rcInner}]"
                    var rcExpectedArg = rcInner
                    if rcLeaf == "Err":
                        rcExpectedArg = "str"
                    let rcArgNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                                  ctx,
                                                                                  sourceContexts,
                                                                                  share(scope),
                                                                                  lineNumber,
                                                                                  chengpath.PathTrim(rcArgTexts[0]),
                                                                                  rcExpectedArg)
                    if rcArgNode < 0:
                        # P1 producer: Ok/Err NoTrace 内征建节点失败 (sub-expr
                        # 求值不出节点) 是聚合 ctor 失败的真根因, 不应被压缩
                        # 进 WholeCallNoTrace.  写入 outer-caller signal:
                        # skipReasonOut (function 已有 var-out 参数) + 模块
                        # hint (跨 fact 路径的 producer 路径备份).  Outer
                        # 17946/21454 在写 stmt.rhsBailReason 时优先取 hint.
                        skipReasonOut = "aggregate_ctor_fail"
                        TypedExprIrSetRhsBailHint("aggregate_ctor_fail")
                    if rcArgNode >= 0:
                        let rcLink = TypedExprIrAddRhsCallArgLinkNode(ir,
                                                                     share(ctx.sourcePath),
                                                                     share(scope.name),
                                                                     lineNumber,
                                                                     chengpath.PathTrim(rcArgTexts[0]),
                                                                     rcArgNode,
                                                                     -1)
                        var rcNode = TypedExprIrNodeNew()
                        rcNode.resultStructuralTypeId = -1
                        rcNode.callDeclarationIndex = -1
                        rcNode.sourcePath = ctx.sourcePath
                        rcNode.functionName = scope.name
                        rcNode.lineNumber = lineNumber
                        rcNode.opKind = TypedExprIrOpCallExpr
                        rcNode.resultType = rcResultType
                        rcNode.surfaceText = text
                        rcNode.paramSlot = -1
                        rcNode.paramName = ""
                        rcNode.operand0NodeIndex = rcLink
                        rcNode.operand1NodeIndex = -1
                        rcNode.operand2NodeIndex = -1
                        rcNode.literalText = callHead
                        rcNode.callKind = TypedExprCallResultIntrinsic
                        rcNode.exprClass =
                            TypedExprIrExprClassForResultTypeExact(
                                ir,
                                ctx.sourcePath,
                                rcNode.resultType,
                                TypedExprExprOwned)
                        return TypedExprIrAddNode(ir, rcNode)
    if !TypedExprCallHeadIsPlainQualifiedIdent(
            share(callHead)):
        return -1
    let argsText = TypedExprSliceTrim(text, openPos + 1, closePos - openPos - 1)
    var argTexts: str[]
    argTexts = []
    if argsText != "":
        argTexts = TypedExprSplitTopLevelCsv(share(argsText))
    for i in 0..<argTexts.len:
        let argText = chengpath.PathTrim(argTexts[i])
        if argText == "":
            return -1
        if !TypedExprIrTextIsWholeFmtLiteral(argText) &&
           !TypedExprIrRhsTextIsStringLiteral(argText) &&
           (parser.ParserFindText(argText, "..") >= 0 ||
            parser.ParserFindText(argText, "Fmt\"") >= 0):
            return -1
    # `add(seq, Type(field: v, ...))` — 命名字段聚合构造器作 add 第二实参（或整调用
    # RHS）。构造器不是函数：字段实参 `field: v` 在 RhsNodeLevel 无顶层切分算符、落
    # primary 兜底建不出节点 → 整调用 return -1 → 后端 seq_add_node gap。callHead 是
    # 具体聚合构造头且任一实参是命名字段（顶层 `:`、无顶层 `?`、冒号前裸 ident）时，
    # 建占位 CallExpr 节点（literalText=构造头、surfaceText=原文、无子参节点）；后端
    # PrimaryBodyIrAppendAggregateConstructorToSlot 按 raw text 逐字段 FieldStore 真物化。
    # 通用求值器对构造头 ordinal 解析必失败而让位（let/return/call-arg 等其它位仍走既有
    # 文本构造器路径），无回归。
    if TypedExprBindingRhsIsAggregateConstructor(ir, ctx, text):
        var ctorNode = TypedExprIrNodeNew()
        ctorNode.resultStructuralTypeId = -1
        ctorNode.callDeclarationIndex = -1
        ctorNode.sourcePath = ctx.sourcePath
        ctorNode.functionName = scope.name
        ctorNode.lineNumber = lineNumber
        ctorNode.opKind = TypedExprIrOpCallExpr
        ctorNode.resultType = TypedExprConstructorBindingType(share(text))
        let ctorLeaf = TypedExprQualifiedCallLeaf(
            share(callHead))
        let ctorOwner = TypedExprIrStructuralTypeOwnerSourcePath(
            ir,
            ctx,
            sourceContexts,
            TypedExprQualifiedCallQualifier(
                share(callHead)),
            share(ctorLeaf))
        if ctorLeaf == "" || ctorOwner == "":
            panic("typed expr: aggregate constructor type authority missing")
        ctorNode.callTarget = ctorLeaf
        ctorNode.callTargetSourcePath = ctorOwner
        ctorNode.surfaceText = text
        ctorNode.paramSlot = -1
        ctorNode.paramName = ""
        ctorNode.operand0NodeIndex = -1
        ctorNode.operand1NodeIndex = -1
        ctorNode.operand2NodeIndex = -1
        ctorNode.literalText = callHead
        ctorNode.exprClass = TypedExprIrExprClassForResultTypeExact(
            ir,
            ctx.sourcePath,
            ctorNode.resultType,
            TypedExprExprOwned)
        return TypedExprIrAddNode(ir, ctorNode)
    # 枚举构造 EnumType(value):枚举 i32 背衬,构造在值层是 i32 透传(int↔enum
    # 同一 i32 值)。callHead 是枚举类型名而非函数,ordinal 解析必失败、落 text
    # 路径(reason=call_ordinal)。在此直接建内层 arg 节点、按枚举常量约定标
    # int32 结果类型(见 9221 enum-member→I32Const),绕开 CallExpr/ordinal。
    if argTexts.len == 1 &&
       TypedExprIrTypeIsEnum(
           ir, ctx.sourcePath, share(callHead)):
        let enumCtorArgNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                             ctx,
                                                                             sourceContexts,
                                                                             share(scope),
                                                                             lineNumber,
                                                                             share(argTexts[0]),
                                                                             "int32")
        if enumCtorArgNode >= 0:
            # combo C Phase1: the AoS resultType override was redundant (the node was
            # built with expectedType "int32", so the SoA resultTypeIds slot already
            # carries int32) and dead for SoA readers. Removed with the AoS producer.
            return enumCtorArgNode
    # Char(intLiteral)/char(intLiteral):编译期常量转换(int32→char 截断)。Char 是
    # std 重载(Char(int32)/Char(char),system.cheng:566/568),后端 whole-call 解析器
    # 按 name+argcount 区分不出唯一 ordinal、字面量包成 CallExpr 落 call_ordinal(主桶,
    # parser 里 ch==Char(34) 等遍布)。单整数字面量 arg 时直接物化 char 常量叶(后端
    # I32Const const-eval 经 ExtractInt64FromText 解裸十进制,resultType=char 定 1 字节
    # 宽,与既有 int8/uint8 转换折叠同形),绕开重载解析。无 fallback(int→char 截断
    # 语义精确)。char-literal 形态('X')的 arg 已由 OpCharLit 路径覆盖,此处只接裸整数。
    if argTexts.len == 1 && TypedExprTextIsIntegerLiteral(argTexts[0]):
        let charConvLeaf = TypedExprQualifiedCallLeaf(
            share(callHead))
        if charConvLeaf == "Char" || charConvLeaf == "char":
            let charConvLiteral = chengpath.PathTrim(argTexts[0])
            return TypedExprIrAddRhsLeafNode(ir,
                                             share(ctx.sourcePath),
                                             share(scope.name),
                                             lineNumber,
                                             TypedExprIrOpI32Const,
                                             "char",
                                             charConvLiteral,
                                             charConvLiteral)
    # Value(res):Result[T] 成功投影内征。callHead=="Value" 是后端识别的 Result 投影
    # 头(探针 probeCallHead=="Value"、求值 24444、投影 21130 已完备),不是函数,
    # 通用 returnTypeRaw 解析按函数返回型查必落空 → 整调用 -1 → return/let 落
    # no_node(os.cheng:1228 `return Value(readRes)`)。从单实参绑定型解 Result[T] 的
    # T,T 具体时建 LocalRef→ArgLink→CallExpr(literalText="Value",resultType=T)节点,
    # 让节点求值器经 Result 投影直接物化,绕开函数返回型门。无 fallback(投影头本就是
    # 后端内征)。
    if argTexts.len == 1 &&
       TypedExprQualifiedCallLeaf(
           share(callHead)) == "Value":
        let valueProjArg = chengpath.PathTrim(argTexts[0])
        let valueProjScopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
        var valueProjBindingType = TypedExprLookupBindingTypeIndexed(
            ctx,
            valueProjScopeIndex,
            lineNumber,
            valueProjArg)
        if valueProjBindingType == "":
            valueProjBindingType = TypedExprIrPriorBindingType(ir,
                                                              ctx.sourcePath,
                                                              scope.name,
                                                              lineNumber,
                                                              valueProjArg)
        if valueProjBindingType != "":
            let valueProjSuccessType = TypedExprResultSuccessType(TypedExprStripVarType(valueProjBindingType))
            if valueProjSuccessType != "" && TypedExprTypeTextIsConcrete(valueProjSuccessType):
                let valueProjArgNode = TypedExprIrAddRhsLocalRefNode(ir,
                                                                    share(ctx.sourcePath),
                                                                    share(scope.name),
                                                                    lineNumber,
                                                                    share(valueProjArg),
                                                                    valueProjBindingType)
                let valueProjLink = TypedExprIrAddRhsCallArgLinkNode(ir,
                                                                    share(ctx.sourcePath),
                                                                    share(scope.name),
                                                                    lineNumber,
                                                                    valueProjArg,
                                                                    valueProjArgNode,
                                                                    -1)
                var valueProjNode = TypedExprIrNodeNew()
                valueProjNode.resultStructuralTypeId = -1
                valueProjNode.callDeclarationIndex = -1
                valueProjNode.sourcePath = ctx.sourcePath
                valueProjNode.functionName = scope.name
                valueProjNode.lineNumber = lineNumber
                valueProjNode.opKind = TypedExprIrOpCallExpr
                valueProjNode.resultType = valueProjSuccessType
                valueProjNode.surfaceText = text
                valueProjNode.paramSlot = -1
                valueProjNode.paramName = ""
                valueProjNode.operand0NodeIndex = valueProjLink
                valueProjNode.operand1NodeIndex = -1
                valueProjNode.operand2NodeIndex = -1
                valueProjNode.literalText = "Value"
                valueProjNode.callKind = TypedExprCallResultIntrinsic
                valueProjNode.exprClass =
                    TypedExprIrExprClassForResultTypeExact(
                        ir,
                        ctx.sourcePath,
                        valueProjNode.resultType,
                        TypedExprExprBorrowed)
                return TypedExprIrAddNode(ir, valueProjNode)
        # Value(<call>):实参是调用而非绑定。绑定路径(上)对 local/param 名建
        # LocalRef→Value 投影;实参是整调用(`Value(Lookup(pool, field[call()]))`)时
        # 绑定型查空、绕过上支 → 整调用返 -1 → PopulateCallArgNodeChain 弃 → 后端
        # 全文本, call 值下标文本路径吃不了 → bail44。此处解 arg 调用的 Result[T]
        # 返回型抽 T(与 8508 求内征型同源:BindingRhsCallReturnType→ResultSuccessType),
        # T 具体时递归建整调用节点(既有 whole-call 递归:literalText=被调头、resultType=
        # Result[T]、内层 LookupIntern/IndexGet/CallExpr 自然建), 再 ArgLink→CallExpr
        # (literalText="Value"、resultType=T)。后端 ResultValueArgNodeIndex 认 CallExpr
        # 实参、AppendResultValueProjection 先 EvalNode 物化 Result[T] 临时槽再走既有
        # 投影。T 不可解或 arg 建不出 CallExpr 节点 → 不建(-1, poison=今日行为)。
        let valueProjCallReturnType = TypedExprBindingRhsCallReturnType(ctx,
                                                                        sourceContexts,
                                                                        lineNumber,
                                                                        valueProjArg)
        let valueProjCallSuccessType = TypedExprResultSuccessType(valueProjCallReturnType)
        if valueProjCallSuccessType != "" && TypedExprTypeTextIsConcrete(valueProjCallSuccessType):
            let valueProjCallArgNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                                     ctx,
                                                                                     sourceContexts,
                                                                                     share(scope),
                                                                                     lineNumber,
                                                                                     share(valueProjArg),
                                                                                     valueProjCallReturnType)
            if valueProjCallArgNode >= 0 &&
               ir.nodes2_opKinds[valueProjCallArgNode] == TypedExprIrOpCallExpr:
                let valueProjCallLink = TypedExprIrAddRhsCallArgLinkNode(ir,
                                                                        share(ctx.sourcePath),
                                                                        share(scope.name),
                                                                        lineNumber,
                                                                        valueProjArg,
                                                                        valueProjCallArgNode,
                                                                        -1)
                var valueProjCallNode = TypedExprIrNodeNew()
                valueProjCallNode.resultStructuralTypeId = -1
                valueProjCallNode.callDeclarationIndex = -1
                valueProjCallNode.sourcePath = ctx.sourcePath
                valueProjCallNode.functionName = scope.name
                valueProjCallNode.lineNumber = lineNumber
                valueProjCallNode.opKind = TypedExprIrOpCallExpr
                valueProjCallNode.resultType = valueProjCallSuccessType
                valueProjCallNode.surfaceText = text
                valueProjCallNode.paramSlot = -1
                valueProjCallNode.paramName = ""
                valueProjCallNode.operand0NodeIndex = valueProjCallLink
                valueProjCallNode.operand1NodeIndex = -1
                valueProjCallNode.operand2NodeIndex = -1
                valueProjCallNode.literalText = "Value"
                valueProjCallNode.callKind =
                    TypedExprCallResultIntrinsic
                valueProjCallNode.exprClass =
                    TypedExprIrExprClassForResultTypeExact(
                        ir,
                        ctx.sourcePath,
                        valueProjCallNode.resultType,
                        TypedExprExprBorrowed)
                return TypedExprIrAddNode(ir, valueProjCallNode)
    # new(T):堆对象分配内征。callHead=="new" 是后端识别的分配头(后端
    # PrimaryBodyIrAppendNewObjectValue→AppendHeapObjectAllocZero 已完备),不是
    # 函数,实参 `I32` 是类型名而非值表达式——走下面的 arg-loop 会把 I32 当值建
    # 节点(失败)→ 整调用 -1 → no_node。在此建占位 CallExpr 叶节点(literalText=
    # "new"、surfaceText 保留完整 `new(I32)`、resultType=ref{argTexts[0]}、无子参
    # 节点,绕开把 I32 当值建节点),让后端 node-eval 的 new 专支按 surfaceText 直接
    # 分配零初始化对象。无 fallback(分配头本就是后端内征)。
    if argTexts.len == 1 &&
       TypedExprQualifiedCallLeaf(
           share(callHead)) == "new":
        let newResultType = TypedExprNormalizeTypeText(Fmt"ref{argTexts[0]}")
        if TypedExprTypeTextIsConcrete(newResultType):
            var newNode = TypedExprIrNodeNew()
            newNode.resultStructuralTypeId = -1
            newNode.callDeclarationIndex = -1
            newNode.sourcePath = ctx.sourcePath
            newNode.functionName = scope.name
            newNode.lineNumber = lineNumber
            newNode.opKind = TypedExprIrOpCallExpr
            newNode.resultType = newResultType
            newNode.surfaceText = text
            newNode.paramSlot = -1
            newNode.paramName = ""
            newNode.operand0NodeIndex = -1
            newNode.operand1NodeIndex = -1
            newNode.operand2NodeIndex = -1
            newNode.literalText = "new"
            newNode.callKind = TypedExprCallBuiltin
            newNode.exprClass = TypedExprIrExprClassForResultTypeExact(
                ir,
                ctx.sourcePath,
                newNode.resultType,
                TypedExprExprOwned)
            return TypedExprIrAddNode(ir, newNode)
    var returnTypeRaw = TypedExprBindingRhsCallReturnType(ctx,
                                                          sourceContexts,
                                                          lineNumber,
                                                          text)
    if returnTypeRaw == "":
        returnTypeRaw = TypedExprConstructorCallReturnType(
            ctx, sourceContexts, share(callHead))
    if returnTypeRaw == "" || (returnTypeRaw == "void" && !allowVoid):
        return -1
    var resolvedReturnType = ""
    if !TypedExprWholeCallResultTypeWithExpected(returnTypeRaw,
                                                  expectedTypeRaw,
                                                  resolvedReturnType):
        if TypedExprTypeIsGenericPlaceholder(returnTypeRaw):
            skipReasonOut = "generic"
        else:
            skipReasonOut = "badtype"
        return -1
    var argValueNodes: int32[]
    argValueNodes = []
    for i in 0..<argTexts.len:
        var expectedArgType = TypedExprCallParamTypeAt(ir,
                                                       ctx,
                                                       sourceContexts,
                                                       share(callHead),
                                                       share(argsText),
                                                       lineNumber,
                                                       i)
        let argNode = TypedExprIrBuildRhsNodeWithExpectedTypeNoTrace(ir,
                                                                     ctx,
                                                                     sourceContexts,
                                                                     share(scope),
                                                                     lineNumber,
                                                                     share(argTexts[i]),
                                                                     expectedArgType)
        if argNode < 0:
            # 基本数值转换 fn(literal) 且字面量超出 i32(i64 字面量无叶构建器,arg
            # 建节点失败)时,转换在值层是编译期常量,按目标类型直接物化常量叶节点,
            # 绕开 CallExpr。仅在常规 arg 建节点失败时兜底:fit-i32 字面量仍走原
            # CallExpr 路径(let 绑定的 int64(4) 等不回归)。
            if argTexts.len == 1:
                let intConvType =
                    TypedExprIntConversionFnTargetType(
                        share(callHead))
                if intConvType != "" && TypedExprTextIsIntegerLiteral(argTexts[0]):
                    let intConvLiteral = chengpath.PathTrim(argTexts[0])
                    if intConvType == "int64" || intConvType == "uint64":
                        return TypedExprIrAddRhsLeafNode(ir,
                                                         share(ctx.sourcePath),
                                                         share(scope.name),
                                                         lineNumber,
                                                         TypedExprIrOpI64Const,
                                                         intConvType,
                                                         intConvLiteral,
                                                         intConvLiteral)
                    return TypedExprIrAddRhsLeafNode(ir,
                                                     share(ctx.sourcePath),
                                                     share(scope.name),
                                                     lineNumber,
                                                     TypedExprIrOpI32Const,
                                                     intConvType,
                                                     intConvLiteral,
                                                     intConvLiteral)
            # enum-成员-实参专臂 (见 TypedExprIrBuildEnumScopedConstArgNode); miss
            # 仍原路 fail-closed。
            let wholeCallEnumArgNode = TypedExprIrBuildEnumScopedConstArgNode(ir,
                                                                              ctx,
                                                                              share(scope),
                                                                              lineNumber,
                                                                              share(argTexts[i]))
            if wholeCallEnumArgNode >= 0:
                add(argValueNodes, wholeCallEnumArgNode)
                continue
            # RootB: 非节点化实参(裸聚合/seq 形参引用/跨模块聚合字段)不再连坐整调用。
            # 塞一个 Unsupported sentinel 占位保持 arg-link 位次对齐,同调用的节点依赖
            # 实参(Fmt/算术/带调用下标 subscript)于是能经 CallArgNodeIndexAt 取到真
            # 节点;sentinel 位实参由其文本臂(取址/simplefield,不查节点)照旧物化。整
            # 调用 wholesale 消费者 eval 到 sentinel(opKind=Unsupported)落 EvalNode
            # default miss 返 -1 而 poison,故修不了的形态保持 bail,绝不 miscompile。
            let sentinelArgNode = TypedExprIrAddRhsLeafNode(ir,
                                                            share(ctx.sourcePath),
                                                            share(scope.name),
                                                            lineNumber,
                                                            TypedExprIrOpUnsupported,
                                                            "",
                                                            argTexts[i],
                                                            "")
            add(argValueNodes, sentinelArgNode)
            continue
        add(argValueNodes, argNode)
    var firstLink: int32 = -1
    var linkIndex = argValueNodes.len - 1
    while linkIndex >= 0:
        firstLink = TypedExprIrAddRhsCallArgLinkNode(ir,
                                                     share(ctx.sourcePath),
                                                     share(scope.name),
                                                     lineNumber,
                                                     chengpath.PathTrim(argTexts[linkIndex]),
                                                     argValueNodes[linkIndex],
                                                     firstLink)
        linkIndex = linkIndex - 1
    var node = TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.sourcePath = ctx.sourcePath
    node.functionName = scope.name
    node.lineNumber = lineNumber
    node.opKind = TypedExprIrOpCallExpr
    node.resultType = TypedExprIrRuntimeScalarType(ir,
                                                   ctx.sourcePath,
                                                   resolvedReturnType)
    node.surfaceText = text
    node.paramSlot = -1
    node.paramName = ""
    node.operand0NodeIndex = firstLink
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = share(callHead)
    let callQualifier = TypedExprQualifiedCallQualifier(
        share(callHead))
    let callCallee = TypedExprQualifiedCallLeaf(
        share(callHead))
    node.callKind = TypedExprIrCallKindForCallee(callCallee)
    var authoritySourcePath = ""
    var authorityReturnType = ""
    var authorityTarget = ""
    var authorityImportc = false
    var authorityRow: int32 = -1
    let authorityState = TypedExprResolveCallDeclarationFromText(
        ctx,
        sourceContexts,
        callQualifier,
        callCallee,
        share(callHead),
        argsText,
        lineNumber,
        authoritySourcePath,
        authorityReturnType,
        authorityTarget,
        authorityImportc,
        authorityRow)
    if authorityState == TypedExprBuildIndexUnique:
        if node.callKind != TypedExprCallNone:
            panic("typed expr: intrinsic callee resolved as declaration")
        if authorityRow < 0 || ctx.buildIndex == nil ||
           authorityRow >=
               ctx.buildIndex.callDeclarationResultExprClasses.len:
            panic("typed expr: whole CallExpr declaration ownership row unavailable")
        # [ia1 alias-family] Same canonical-identity rule as the
        # structural authority arm: stamp the declaration row's
        # registered name, never the targetSymbols payload (the
        # @importc C symbol for alias rows).
        node.callTarget = parser.ParserOwnedText(
            typedExprBuildIndexCallName(ctx.buildIndex, authorityRow))
        node.callTargetSourcePath = authoritySourcePath
        node.callTargetSignatureLineNumber =
            typedExprBuildIndexCallSignatureLineNumber(ctx.buildIndex,
                                                       authorityRow)
        node.callTargetImportc = authorityImportc
        node.callDeclarationIndex = authorityRow
        node.exprClass = TypedExprIrExprClassForResultTypeExact(
            ir,
            ctx.sourcePath,
            node.resultType,
            ctx.buildIndex.callDeclarationResultExprClasses[authorityRow])
        node.resultStructuralTypeId =
            typedExprIrExactCallReturnTypeId(ir, authorityRow)
        typedExprIrBindNodeStructuralType(
            ir, node, node.resultStructuralTypeId)
    else:
        let constructorType = TypedExprConstructorCallReturnType(
            ctx, sourceContexts, share(callHead))
        if constructorType != "":
            if node.callKind != TypedExprCallNone:
                panic("typed expr: intrinsic callee resolved as constructor")
            let constructorOwner = TypedExprIrStructuralTypeOwnerSourcePath(
                ir,
                ctx,
                sourceContexts,
                callQualifier,
                share(callCallee))
            if constructorOwner == "":
                panic("typed expr: whole constructor type authority missing")
            node.callTarget = callCallee
            node.callTargetSourcePath = constructorOwner
            node.exprClass = TypedExprIrExprClassForResultTypeExact(
                ir,
                ctx.sourcePath,
                node.resultType,
                TypedExprExprOwned)
        else:
            var unresolvedHasManaged: bool
            if TypedExprIrTypeContainsManagedStorage(ir,
                                                      ctx.sourcePath,
                                                      node.resultType,
                                                      unresolvedHasManaged) &&
               unresolvedHasManaged:
                panic(Fmt"typed expr: managed whole CallExpr has no exact declaration row callee={callHead}")
    return TypedExprIrAddNode(ir, node)

@borrows
fn TypedExprIrBuildExprNode(ir: var TypedExprIr,
                            ctx: var TypedExprSourceContext,
                            sourceContexts: TypedExprSourceContext[],
                             scope: TypedExprFunctionScope,
                             lineNumber: int32,
                             textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return -1
    # elemSize[T]() (see TypedExprIrElemSizeConstBytes) must be folded to its
    # constant byte size before the generic whole-call dispatch below gets a
    # chance to resolve `elemSize` as an ordinary callable target: unlike
    # `sizeof`, `elemSize` is a real declared std/system.cheng function, so
    # TypedExprIrBuildRhsWholeCallNode successfully builds a ordinary call
    # node for it and this fold (reachable only from deeper sub-expressions
    # via TypedExprIrBuildRhsPrimaryNode) would never run for a bare
    # `return elemSize[T]()` statement, leaving the call target unresolved
    # downstream instead of constant-folded.
    let elemSizeConstBytesTop = TypedExprIrElemSizeConstBytes(ctx, sourceContexts, share(text))
    if elemSizeConstBytesTop >= 0:
        let elemSizeNodeIndex = TypedExprIrAddI32ConstNode(ir,
                                                           ctx.sourcePath,
                                                           scope.name,
                                                           lineNumber,
                                                           IntToStr(elemSizeConstBytesTop))
        typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
        if TypedExprIrRhsNodeTraceEnabled():
            os.WriteLine(os.Get_stderr(),
                         Fmt"phase=rhs_node_built function={scope.name} line={lineNumber} nodes=1")
        return elemSizeNodeIndex
    var skipReason = ""
    if TypedExprIrTextIsWholeFmtLiteral(share(text)):
        let nodeCountBeforeFmt = ir.nodes2_nodeIndexs.len
        let fmtNodeIndex = TypedExprIrBuildFmtNode(ir,
                                                   ctx,
                                                   sourceContexts,
                                                   share(scope),
                                                   lineNumber,
                                                   share(text))
        if fmtNodeIndex >= 0:
            typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
            if TypedExprIrRhsNodeTraceEnabled():
                let builtFmtNodes = ir.nodes2_nodeIndexs.len - nodeCountBeforeFmt
                os.WriteLine(os.Get_stderr(),
                             strutil.Join(["phase=rhs_node_built function=",
                                           strings.CloneStr(scope.name),
                                           " line=",
                                           IntToStr(lineNumber),
                                           " nodes=",
                                           IntToStr(builtFmtNodes)], ""))
            return fmtNodeIndex
        skipReason = "fmt"
    elif TypedExprTextHasTopLevelRangeOp(share(text)):
        # Only a bare top-level `..`/`..<` (outside string/char literals and
        # outside (), [], {}) is a range operator. `..` inside a literal or
        # parenthesized subexpression is not a range prejudge, so those build
        # normally instead of being skipped as range.
        skipReason = "range"
    elif TypedExprIrRhsCallFormPos(share(text)) >= 0:
        # 批次5：单 call 整 RHS 优先建 CallExpr 节点，失败回到 skip 计数。
        let nodeCountBeforeCall = ir.nodes2_nodeIndexs.len
        var callSkipReason = "call"
        let callNodeIndex = TypedExprIrBuildRhsWholeCallNode(ir,
                                                             ctx,
                                                             sourceContexts,
                                                             share(scope),
                                                             lineNumber,
                                                             share(text),
                                                             false,
                                                             "",
                                                             callSkipReason)
        if callNodeIndex >= 0:
            typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
            if TypedExprIrRhsNodeTraceEnabled():
                let builtCallNodes = ir.nodes2_nodeIndexs.len - nodeCountBeforeCall
                os.WriteLine(os.Get_stderr(),
                             Fmt"phase=rhs_node_built function={scope.name} line={lineNumber} nodes={builtCallNodes}")
            return callNodeIndex
        skipReason = callSkipReason
    if skipReason == "" || skipReason == "call":
        typedExprRhsNodeSkipReason = "badtoken"
        let nodeCountBefore = ir.nodes2_nodeIndexs.len
        let nodeIndex = TypedExprIrBuildRhsNodeLevel(ir,
                                                     ctx,
                                                     sourceContexts,
                                                     share(scope),
                                                     lineNumber,
                                                     share(text),
                                                     0)
        if nodeIndex >= 0:
            typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
            if TypedExprIrRhsNodeTraceEnabled():
                let builtNodes = ir.nodes2_nodeIndexs.len - nodeCountBefore
                os.WriteLine(os.Get_stderr(),
                             Fmt"phase=rhs_node_built function={scope.name} line={lineNumber} nodes={builtNodes}")
            return nodeIndex
        if skipReason == "":
            skipReason = typedExprRhsNodeSkipReason
    typedExprRhsNodeSkippedCount = typedExprRhsNodeSkippedCount + 1
    if TypedExprIrRhsNodeTraceEnabled():
        os.WriteLine(os.Get_stderr(),
                     Fmt"phase=rhs_node_skip reason={skipReason} expr={text}")
    return -1

@borrows
fn TypedExprIrBuildExprNodeWithExpectedType(ir: var TypedExprIr,
                                             ctx: var TypedExprSourceContext,
                                             sourceContexts: TypedExprSourceContext[],
                                             scope: TypedExprFunctionScope,
                                             lineNumber: int32,
                                             textRaw: str,
                                             expectedTypeRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return -1
    let contextualNode = TypedExprIrBuildContextualLiteralNode(ir,
                                                               ctx,
                                                               sourceContexts,
                                                               share(scope),
                                                               lineNumber,
                                                               share(text),
                                                               share(expectedTypeRaw))
    if contextualNode >= 0:
        typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
        if TypedExprIrRhsNodeTraceEnabled():
            os.WriteLine(os.Get_stderr(),
                         Fmt"phase=rhs_node_built function={scope.name} line={lineNumber} nodes=1")
        return contextualNode
    let nodeCountBeforeTernary = ir.nodes2_nodeIndexs.len
    let ternaryNode = TypedExprIrBuildRhsTernaryNode(ir,
                                                     ctx,
                                                     sourceContexts,
                                                     share(scope),
                                                     lineNumber,
                                                     share(text),
                                                     share(expectedTypeRaw))
    if ternaryNode >= 0:
        typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
        if TypedExprIrRhsNodeTraceEnabled():
            let builtTernaryNodes = ir.nodes2_nodeIndexs.len - nodeCountBeforeTernary
            os.WriteLine(os.Get_stderr(),
                         Fmt"phase=rhs_node_built function={scope.name} line={lineNumber} nodes={builtTernaryNodes}")
        return ternaryNode
    let nodeCountBeforeIfExpr = ir.nodes2_nodeIndexs.len
    let ifExprNode = TypedExprIrBuildRhsIfExprNode(ir,
                                                   ctx,
                                                   sourceContexts,
                                                   share(scope),
                                                   lineNumber,
                                                   share(text),
                                                   share(expectedTypeRaw))
    if ifExprNode >= 0:
        typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
        if TypedExprIrRhsNodeTraceEnabled():
            let builtIfExprNodes = ir.nodes2_nodeIndexs.len - nodeCountBeforeIfExpr
            os.WriteLine(os.Get_stderr(),
                         Fmt"phase=rhs_node_built function={scope.name} line={lineNumber} nodes={builtIfExprNodes}")
        return ifExprNode
    if TypedExprWholeCallNeedsExpectedResult(ctx,
                                             sourceContexts,
                                             lineNumber,
                                             share(text)):
        let nodeCountBeforeCall = ir.nodes2_nodeIndexs.len
        var expectedCallSkipReason = "generic"
        let expectedCallNode = TypedExprIrBuildRhsWholeCallNode(ir,
                                                                ctx,
                                                                sourceContexts,
                                                                share(scope),
                                                                lineNumber,
                                                                share(text),
                                                                false,
                                                                share(expectedTypeRaw),
                                                                expectedCallSkipReason)
        if expectedCallNode >= 0:
            typedExprRhsNodeBuiltCount = typedExprRhsNodeBuiltCount + 1
            if TypedExprIrRhsNodeTraceEnabled():
                let builtCallNodes = ir.nodes2_nodeIndexs.len - nodeCountBeforeCall
                os.WriteLine(os.Get_stderr(),
                             Fmt"phase=rhs_node_built function={scope.name} line={lineNumber} nodes={builtCallNodes}")
            return expectedCallNode
        typedExprRhsNodeSkipReason = strings.CloneStr(expectedCallSkipReason)
        return -1
    return TypedExprIrBuildExprNode(ir,
                                    ctx,
                                    sourceContexts,
                                    share(scope),
                                    lineNumber,
                                    text)

@borrows
fn TypedExprScopeIndexForLine(scopes: TypedExprFunctionScope[],
                                lineNumber: int32): int32 =
    # scopes 按 startLine 严格升序且非重叠(顶层 decl 源序 append:
    # BuildSourceContext/BuildMetadataContextFromProfile 逐 decl 追加,
    # endLine 以下一顶层 decl 前一行封顶; compiler_csg 可达过滤保序),
    # 二分找 startLine<=lineNumber 的最大下标再验 endLine, O(log n)。
    var lo: int32
    var hi = scopes.len
    while lo < hi:
        let mid = lo + (hi - lo) / 2
        if scopes[mid].startLine <= lineNumber:
            lo = mid + 1
        else:
            hi = mid
    if lo <= 0:
        return -1
    let candidate = lo - 1
    if lineNumber > scopes[candidate].endLine:
        return -1
    return candidate

type
    TypedExprBindingLineParse =
        ok: bool
        name: str
        typeText: str
        rhsStartColumn: int32

    TypedExprTypeFieldLineParse =
        ok: bool
        fieldName: str
        fieldType: str

@borrows
fn TypedExprParseBindingLineOwned(lineRaw: str): TypedExprBindingLineParse =
    var out: TypedExprBindingLineParse
    out.rhsStartColumn = -1
    var name = ""
    var typeText = ""
    var rhsStartColumn: int32 = -1
    out.ok = TypedExprParseBindingLine(lineRaw, name, typeText, rhsStartColumn)
    out.name = name
    out.typeText = typeText
    out.rhsStartColumn = rhsStartColumn
    return out

@borrows
fn TypedExprParseTypeFieldLineOwned(lineRaw: str): TypedExprTypeFieldLineParse =
    var out: TypedExprTypeFieldLineParse
    # Fast reject: a field line always carries a top-level ':'. Enum/alias and
    # comment-only lines skip the owned field parser entirely.
    let fieldView = TypedExprTrimmedLineView(lineRaw)
    if fieldView == "" ||
       TypedExprFindTopLevelTextToken(fieldView, ":") < 0:
        return out
    var fieldName = ""
    var fieldType = ""
    out.ok = TypedExprParseTypeFieldLine(lineRaw, fieldName, fieldType)
    out.fieldName = fieldName
    out.fieldType = fieldType
    return out

@borrows
fn TypedExprParseBindingLine(lineRaw: str,
                               name: var str,
                               typeText: var str,
                               rhsStartColumn: var int32): bool =
    name = ""
    typeText = ""
    rhsStartColumn = -1
    # bail=631 簇B: `var gSeq: int32[]   # ...; -1 = ...` 行尾注释破坏解析——
    # 注释文本混进 typeText(全局 seq 元素类型带注释 → 后端 `[]` 后缀判定失败),
    # 注释内的 `=` 还会被当 RHS 起点。先剥注释(string-aware)再解析;
    # rhsStartColumn 仍按 lineRaw 原始列计算,真 `=` 必在注释前,列不受影响。
    let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(lineRaw))
    var prefix = ""
    if parser.ParserStartsWith(trimmed, "let "):
        prefix = "let "
    elif parser.ParserStartsWith(trimmed, "var "):
        prefix = "var "
    elif parser.ParserStartsWith(trimmed, "const "):
        prefix = "const "
    if prefix == "":
        return false
    if Len(trimmed) <= Len(prefix):
        return false
    let tail = strings.SliceBytes(trimmed, Len(prefix), Len(trimmed) - Len(prefix))
    if chengpath.PathTrim(tail) == "":
        return false
    let rawName = parser.ParserFirstToken(tail)
    let bindingName = parser.ParserIdentPrefix(rawName)
    if bindingName == "":
        return false
    var colonPos = TypedExprFindTopLevelToken(tail, ":")
    let eqPos = TypedExprFindTopLevelToken(tail, "=")
    if eqPos >= 0 && colonPos > eqPos:
        colonPos = -1
    if colonPos < 0:
        if eqPos < 0:
            return false
        name = bindingName
        typeText = ""
        let originalEqPosNoType = parser.ParserFindText(lineRaw, "=")
        if originalEqPosNoType < 0:
            return true
        rhsStartColumn = originalEqPosNoType + 2
        for column in rhsStartColumn..lineRaw.len:
            if parser.ParserIsInlineSpace(lineRaw[column - 1]):
                rhsStartColumn = column + 1
            else:
                rhsStartColumn = column
                break
        return true
    if eqPos >= 0 && eqPos <= colonPos:
        return false
    name = bindingName
    if eqPos < 0:
        typeText = TypedExprNormalizeTypeText(strings.SliceBytes(tail,
                                                                 colonPos + 1,
                                                                 Len(tail) - colonPos - 1))
        if name == "":
            return false
        if typeText == "":
            return false
        return true
    typeText = TypedExprNormalizeTypeText(strings.SliceBytes(tail, colonPos + 1, eqPos - colonPos - 1))
    let originalEqPos = parser.ParserFindText(lineRaw, "=")
    if originalEqPos < 0:
        return false
    rhsStartColumn = originalEqPos + 2
    for column in rhsStartColumn..lineRaw.len:
        if parser.ParserIsInlineSpace(lineRaw[column - 1]):
            rhsStartColumn = column + 1
        else:
            rhsStartColumn = column
            break
    if name == "":
        return false
    if typeText == "":
        return false
    return true

# 十进制整数字面量且值在 (int32 max, int64 max] — 与 TypedExprIrRhsTextIsI32Literal
# (≤int32 max) 互补, 供大整数字面量定型 int64。
@borrows
fn TypedExprTextIsInt64DecimalLiteral(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text.len <= 0 || text.len > 19:
        return false
    var value: uint64
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        let digit = uint64(Int32(ch) - Int32('0'))
        if value > uint64(922337203685477580):
            return false
        value = value * uint64(10) + digit
    return value > uint64(2147483647) && value <= uint64(9223372036854775807)

@borrows
fn TypedExprScalarLiteralType(exprRaw: str): str =
    let expr = chengpath.PathTrim(exprRaw)
    if Len(expr) >= 2 && expr[0] == Char(34) && expr[Len(expr) - 1] == Char(34):
        return "str"
    if Len(expr) >= 5 &&
       parser.ParserStartsWith(expr, "Fmt") &&
       expr[3] == Char(34) &&
       expr[Len(expr) - 1] == Char(34):
        return "str"
    if expr == "true" || expr == "false":
        return "bool"
    # char 字面量 'c'/'\n' (host_ops.cheng `Int32('0')` 数字解析习语): 此前无
    # 定型臂 → cast operand type unavailable。
    if TypedExprIrRhsTextIsCharLiteral(expr):
        return "char"
    # 通用 i32 字面量判定用全范围版本 (十进制 ≤2147483647/hex/前导负号):
    # TypedExprIrIsI32ConstLiteral 是 BodyKind 折叠模板专用 (上限 65535,
    # BodyKindReturnI32ConstMax), 把它当通用判定会让 `int64(1099511627)` 这类
    # 大范围十进制字面量推不出绑定型 → cast operand type unavailable。
    if TypedExprIrRhsTextIsI32Literal(expr):
        return "int32"
    # 超 int32 上限的十进制整数字面量 (uint32 mask 习语 uint64(4294967295)
    # 等): cold 定型为大整数 int64, 经 cast 与 uint64/int64 互通。
    if TypedExprTextIsInt64DecimalLiteral(expr):
        return "int64"
    # 十六进制整数字面量(`0x40`/`0xFF`,≤INT32_MAX)是 int32 值,但上面的 i32 字面量
    # 分类器 TypedExprIrIsI32ConstLiteral 只认十进制数字。没这条,`var v = 0x40`(常见
    # opcode/mask 初值)推不出绑定型 → local-decl 被丢 → 任何读 v(或 v 作 call-arg,如
    # `return x64bPut8(words, pos, v)`)建不出节点 → no_node。镜像值侧 primary builder
    # (它已用 TypedExprIrRhsTextIsI32Literal 对同款 hex 建 I32Const 叶)使槽侧绑定型与
    # 值侧 init 节点同一接受口径(仅范围内 hex;超范围 hex 两侧都不绑)。仅 0x(0b 值侧
    # 9096-9102 显式排除,绑 0b 会造成槽建而无 init 节点的不对称)。
    if Len(expr) >= 3 && expr[0] == '0' && (expr[1] == 'x' || expr[1] == 'X') &&
       TypedExprIrRhsTextIsI32Literal(expr):
        return "int32"
    # A negated integer literal (`-1`, `-42`) is still an int32 value. The raw
    # i32-literal classifier only accepts decimal digits, so peel one leading `-`
    # before re-testing. Without this, `var x = -1` (a common sentinel init) gets
    # no binding type, so reads of `x` cannot build a node and any call taking
    # `x` as an arg falls off the node-eval path (reason=call gap).
    if Len(expr) >= 2 && expr[0] == '-' && TypedExprIrIsI32ConstLiteral(chengpath.PathTrim(chengpath.TextSlice(expr, 1, Len(expr) - 1))):
        return "int32"
    return ""

@borrows
fn TypedExprLiteralBindingType(exprRaw: str): str =
    let scalarType = TypedExprScalarLiteralType(exprRaw)
    if scalarType != "":
        return scalarType
    let expr = chengpath.PathTrim(exprRaw)
    # 全 str 元素的数组字面量 `["a","b",...]` → str[]。seq-literal 节点 builder
    # (7846)只物化 str 元素 seq 字面量,后端 str-seq eval(23716)产 16 字节聚合
    # 槽;把局部绑定成 str[] 才使它得到匹配的聚合槽,local-decl 的 store 走聚合-
    # 聚合拷贝(20911,16=16)而非落 store_shape_l1。否则局部无记录类型→标量
    # 槽(kind 1)→store 失败,且其 .len/[i] 用法解析不出 → no_node 连锁。
    if Len(expr) >= 3 && expr[0] == '[' && expr[Len(expr) - 1] == ']':
        let seqLitInner = TypedExprSliceTrim(expr, 1, Len(expr) - 2)
        if seqLitInner != "":
            let seqLitElems = TypedExprSplitTopLevelCsv(seqLitInner)
            if seqLitElems.len > 0:
                var seqLitAllStr = true
                for seqLitEi in 0..<seqLitElems.len:
                    let seqLitElem = chengpath.PathTrim(seqLitElems[seqLitEi])
                    if !(Len(seqLitElem) >= 2 &&
                         seqLitElem[0] == Char(34) &&
                         seqLitElem[Len(seqLitElem) - 1] == Char(34)):
                        seqLitAllStr = false
                if seqLitAllStr:
                    return "str[]"
    return ""

@borrows
fn TypedExprConstructorBindingSurface(exprRaw: str,
                                       constructorHead: var str,
                                       argsText: var str,
                                       parenthesized: var bool): bool =
    constructorHead = ""
    argsText = ""
    parenthesized = false
    let expr = chengpath.PathTrim(exprRaw)
    var openPos = TypedExprFindWholeCallOpenParen(expr)
    var closePos: int32 = -1
    if openPos > 0:
        closePos = TypedExprFindMatchingParen(expr, openPos)
        parenthesized = true
    else:
        # The formal surface gives `T { field: value }` exactly the same
        # constructor semantics as `T(field: value)`.  A nested call's `(` is
        # hidden below brace depth by FindWholeCallOpenParen, so only a real
        # top-level constructor brace can reach this branch.
        openPos = parser.ParserFindText(expr, "{")
        if openPos > 0:
            closePos = parser.ParserFindMatchingBrace(expr, openPos)
    if openPos <= 0 || closePos <= openPos || closePos + 1 != expr.len:
        return false
    # The constructor head is the whole token before the delimiter. For a qualified
    # constructor `mod.Type()` the leading-ident prefix stops at the dot
    # (`ParserIdentPrefix("mod.Type")` == "mod"), which mis-binds the local
    # slot to the module qualifier (i32) instead of the aggregate type. Take
    # the full plain qualified ident so `var x = parser.NormalizedExprLayer()`
    # binds to `parser.NormalizedExprLayer` and gets an aggregate slot.
    constructorHead = chengpath.PathTrim(chengpath.TextSlice(expr, 0, openPos))
    if !TypedExprCallHeadIsPlainQualifiedIdent(constructorHead):
        constructorHead = ""
        return false
    argsText = chengpath.PathTrim(chengpath.TextSlice(expr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    return true

fn TypedExprConstructorBindingType(exprRaw: str): str =
    var constructorHead: str
    var argsText: str
    var parenthesized: bool
    if !TypedExprConstructorBindingSurface(exprRaw,
                                            constructorHead,
                                            argsText,
                                            parenthesized):
        return ""
    return TypedExprNormalizeTypeText(constructorHead)

@borrows
fn TypedExprConstructorNamedFieldsInto(argsTextRaw: str,
                                         fieldNames: var str[],
                                         invalidReason: var str): bool =
    fieldNames = []
    invalidReason = ""
    let argsText = chengpath.PathTrim(argsTextRaw)
    if argsText == "":
        return false
    let items = TypedExprSplitTopLevelCsv(argsText)
    var namedSurface = false
    for itemIndex in 0..<items.len:
        let item = chengpath.PathTrim(items[itemIndex])
        let colonPos = TypedExprFindTopLevelToken(item, ":")
        if colonPos <= 0:
            continue
        let fieldName = chengpath.PathTrim(chengpath.TextSlice(item, 0, colonPos))
        if fieldName != "" && parser.ParserIdentPrefix(fieldName) == fieldName:
            namedSurface = true
            break
    if !namedSurface:
        return false
    for itemIndex in 0..<items.len:
        let item = chengpath.PathTrim(items[itemIndex])
        if item == "":
            # SplitTopLevelCsv retains one empty tail for a legal trailing comma.
            if itemIndex + 1 == items.len:
                continue
            invalidReason = "empty object constructor field"
            return false
        let colonPos = TypedExprFindTopLevelToken(item, ":")
        if colonPos <= 0:
            invalidReason = "expected : in object constructor field"
            return false
        let fieldName = chengpath.PathTrim(chengpath.TextSlice(item, 0, colonPos))
        let fieldValue = chengpath.PathTrim(chengpath.TextSlice(item,
                                                                colonPos + 1,
                                                                item.len - colonPos - 1))
        if fieldName == "" || parser.ParserIdentPrefix(fieldName) != fieldName:
            invalidReason = "empty object constructor field name"
            return false
        if parser.ParserStringSeqContainsExact(fieldNames, fieldName):
            invalidReason = "duplicate object constructor field"
            return false
        if fieldValue == "":
            invalidReason = "object constructor field value missing"
            return false
        add(fieldNames, fieldName)
    return fieldNames.len > 0

@borrows
fn TypedExprBindingRhsUsesNamedArgumentSurface(rhsRaw: str): bool =
    var constructorHead: str
    var argsText: str
    var parenthesized: bool
    if !TypedExprConstructorBindingSurface(rhsRaw,
                                            constructorHead,
                                            argsText,
                                            parenthesized):
        return false
    var fieldNames: str[]
    var invalidReason: str
    let validNamedSurface = TypedExprConstructorNamedFieldsInto(argsText,
                                                                 fieldNames,
                                                                 invalidReason)
    return validNamedSurface || invalidReason != ""

# The first source-context binding pass runs before field layouts are indexed,
# but declared type names are already canonical. Lock only the type-vs-value
# namespace here so a named object surface never enters call-return inference;
# the metadata/facts pass below validates every field against the frozen layout.
@borrows
fn TypedExprNamedAggregateConstructorDeclaredTypeLock(
        ctx: var TypedExprSourceContext,
        rhsRaw: str): str =
    var constructorHead: str
    var argsText: str
    var parenthesized: bool
    if !TypedExprConstructorBindingSurface(rhsRaw,
                                            constructorHead,
                                            argsText,
                                            parenthesized):
        return ""
    var fieldNames: str[]
    var invalidReason: str
    let validNamedSurface = TypedExprConstructorNamedFieldsInto(argsText,
                                                                 fieldNames,
                                                                 invalidReason)
    if !validNamedSurface && invalidReason == "":
        return ""
    let constructorType = TypedExprNormalizeTypeText(constructorHead)
    if TypedExprQualifiedTypeDot(constructorType) >= 0:
        return ""
    if !TypedExprSourceHasDeclaredType(ctx, constructorType):
        return ""
    if !validNamedSurface:
        panic(invalidReason)
    return constructorType

# A binding whose complete RHS is a known aggregate constructor owns every
# call inside its field-value list. Those calls are value producers for the
# LocalDecl node, not standalone Call/LetCall statements. Object constructors
# have an exact whole `T(field: value)` / `T { field: value }` surface: requiring
# every top-level item to be a real named field distinguishes them from ordinary
# calls, including calls that merely take a constructor as an argument.
@borrows
fn TypedExprBindingRhsIsAggregateConstructor(
        ir: var TypedExprIr,
        ctx: TypedExprSourceContext,
        rhsRaw: str): bool =
    var constructorHead: str
    var argsText: str
    var parenthesized: bool
    if !TypedExprConstructorBindingSurface(rhsRaw,
                                            constructorHead,
                                            argsText,
                                            parenthesized):
        return false
    let constructorType = TypedExprNormalizeTypeText(constructorHead)
    var fieldNames: str[]
    var invalidReason: str
    let validNamedSurface = TypedExprConstructorNamedFieldsInto(argsText,
                                                                 fieldNames,
                                                                 invalidReason)
    if !validNamedSurface && invalidReason == "":
        return false
    if TypedExprIrLookupTypeLayoutRow(ir,
                                      parser.ParserNormalizePath(ctx.sourcePath),
                                      constructorType) == -2:
        panic("ambiguous object constructor type")
    var sizeBytes: int32
    var alignBytes: int32
    var fieldCount: int32
    if !TypedExprIrLookupTypeLayout(ir,
                                    ctx.sourcePath,
                                    constructorType,
                                    sizeBytes,
                                    alignBytes,
                                    fieldCount) ||
       sizeBytes <= 0 || fieldCount <= 0:
        return false
    if !validNamedSurface:
        panic(invalidReason)
    for fieldIndex in 0..<fieldNames.len:
        let fieldName = fieldNames[fieldIndex]
        var fieldType: str
        var fieldOffsetBytes: int32
        var fieldSizeBytes: int32
        var fieldAlignBytes: int32
        if !TypedExprIrLookupSingleFieldMeta(ir,
                                             ctx.sourcePath,
                                             constructorType,
                                             fieldName,
                                             fieldType,
                                             fieldOffsetBytes,
                                             fieldSizeBytes,
                                             fieldAlignBytes):
            panic("unknown object constructor field")
    return true

@borrows
fn TypedExprBindingRhsText(lineRaw: str,
                            rhsStartColumn: int32): str =
    if rhsStartColumn <= 0 || rhsStartColumn > lineRaw.len:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(lineRaw,
                                                  rhsStartColumn - 1,
                                                  lineRaw.len - rhsStartColumn + 1))

# Bracket-depth accumulation that skips string/char literal contents. The
# naive per-char count treated bracket characters inside literals (e.g. the
# "[" argument in `ParserFindText(typeText, "[")`) as real nesting, so the
# continuation scan below consumed every remaining source line with a
# quadratic string append (11GiB+ RSS on the compiler's own sources).
@borrows
fn TypedExprAccumulateBracketDepths(text: str,
                                     parenDepth: var int32,
                                     bracketDepth: var int32,
                                     braceDepth: var int32) =
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<text.len:
        let piece = text[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
        elif piece == '\'':
            inChar = true
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1

# 行尾成员访问点判定: `root.`(成员名在续行, WA1 U1/U2 形)。消费点传入的文本
# 可能带行尾注释(rhs 首行原文/expr 表面文本), 故先 quote-aware 剥注释再判尾
# 字符——纯注释句点(census 97.8% 点尾行)剥后为空或尾字符非点, 不触发。排除
# Range `..` 尾(B15 域)与浮点字面量尾(`1.`, 点前是数字)。括号未配平时返回
# false: 该形态由括号深度臂 owns 触发(已覆盖 J1 形, B17 空白跳过消费), 点臂
# 不改写其单空格粘合, 既有文本逐字节不变。与 parser.cheng
# ParserLineEndsWithMemberAccessDot 同一谓词(消费链同构, 两文件各自实例化)。
@borrows
fn TypedExprRhsTextEndsWithMemberDot(textRaw: str): bool =
    let text = chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(textRaw))
    if text.len < 2:
        return false
    if text[text.len - 1] != '.':
        return false
    let prevCh = text[text.len - 2]
    if prevCh == '.':
        return false
    if prevCh >= '0' && prevCh <= '9':
        return false
    var parenDepth = 0
    var inString = false
    var ci = 0
    while ci < text.len:
        let ch = text[ci]
        if inString:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '(' || ch == '[':
            parenDepth = parenDepth + 1
        elif ch == ')' || ch == ']':
            parenDepth = parenDepth - 1
        ci = ci + 1
    if inString:
        return false
    return parenDepth <= 0

@borrows
fn TypedExprRhsTextHasTrailingBinaryOperator(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return false
    let lastCh = text[text.len - 1]
    if lastCh == '|' || lastCh == '&' || lastCh == '+' || lastCh == '*' ||
       lastCh == '/' || lastCh == ',' || lastCh == '<' || lastCh == '>':
        return true
    if lastCh == '=' && text.len > 1 && text[text.len - 2] != '=':
        return true
    # 行尾成员访问点(`root.`): 触发 rhs 续行吸收(WA1 U1)。判定用剥注释文本
    # (:28437/:60936 消费点传入的 rhs 首行原文可能带行尾注释, 注释句点不得
    # 触发), Range `..` 尾与浮点尾排除见 helper。
    if TypedExprRhsTextEndsWithMemberDot(text):
        return true
    return false

@borrows
fn TypedExprBindingRhsTextWithContinuationSpan(ctx: TypedExprSourceContext,
                                                lineIndex: int32,
                                                rhsStartColumn: int32,
                                                endLineNumber: var int32): str =
    endLineNumber = lineIndex + 1
    if lineIndex < 0 || lineIndex >= ctx.lines.len:
        return ""
    var rhsText = TypedExprBindingRhsText(ctx.lines[lineIndex], rhsStartColumn)
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    # An empty first-line RHS means `=` dangles at the end of the declaration line
    # and the value lives entirely on continuation lines (`let x =` newline `Fn(...)`).
    # A bare empty return here would lose the whole RHS, so only return early when a
    # genuinely complete (non-empty, balanced, no trailing operator) RHS sits inline.
    if rhsText != "":
        TypedExprAccumulateBracketDepths(parser.ParserStripLineComment(rhsText),
                                         parenDepth,
                                         bracketDepth,
                                         braceDepth)
        if parenDepth <= 0 && bracketDepth <= 0 && braceDepth <= 0 &&
           !TypedExprRhsTextHasTrailingBinaryOperator(rhsText):
            return rhsText
    elif rhsStartColumn <= 0:
        return rhsText
    var cursor = lineIndex + 1
    while cursor < ctx.lines.len:
        endLineNumber = cursor + 1
        let rawLine = ctx.lines[cursor]
        # `//`-aware 剥注释(见 ParserStripLineCommentSlashAware 定义处注释): 纯
        # '//' 续行会原样当代码文本拼进 rhsText, 且其杂散括号会误导下面的括号
        # 深度续行判定(同族, 控制头续行第 5 处旁的多行 RHS 拼接消费点)。
        let trimmed = chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(share(rawLine)))
        if trimmed != "":
            # 点边界无空格粘合: 成员点尾触发的续行使 rhs 与单行书写形逐字节
            # 同(`a.`+`b` → `a.b`), 下游 call head/postfix/字段路径文本消费点
            # 按既有单行形解析。此处 depths 即 rhsText 当前态(上一轮累积),
            # 括号深度臂边界维持单空格(J1 文本逐字节不变)。
            if parenDepth <= 0 && bracketDepth <= 0 && braceDepth <= 0 &&
               TypedExprRhsTextEndsWithMemberDot(rhsText):
                rhsText = Fmt"{rhsText}{trimmed}"
            else:
                rhsText = Fmt"{rhsText} {trimmed}"
            TypedExprAccumulateBracketDepths(trimmed,
                                             parenDepth,
                                             bracketDepth,
                                             braceDepth)
            if parenDepth <= 0 && bracketDepth <= 0 && braceDepth <= 0 &&
               !TypedExprRhsTextHasTrailingBinaryOperator(rhsText):
                break
        cursor = cursor + 1
    return rhsText

@borrows
fn TypedExprBindingRhsTextWithContinuation(ctx: TypedExprSourceContext,
                                            lineIndex: int32,
                                            rhsStartColumn: int32): str =
    var endLineNumber: int32
    return TypedExprBindingRhsTextWithContinuationSpan(ctx,
                                                        lineIndex,
                                                        rhsStartColumn,
                                                        endLineNumber)

# 裸 Result 内征作 call-arg（`add(seq, Value(r))` / `Make(id, Value(r))` 等）的 operand
# 型化：LHS-resolver `TypedExprAssignStatementType` 对 `Value(r)` 返 ""（非 LHS 形态）致
# callArgTypesText 留空槽 → 后端 InvalidOp(61)。此处是 :8508
# TypedExprBindingRhsResultIntrinsicType 的 ctx-only 版（无 ir 线程化）：IsOk/IsErr→bool、
# Error→str、ErrorInfoOf→ErrorInfo 按 result.cheng 签名固定给；Value(r) 从裸标识符 r 的
# Result[T] 抽 T。推不出具体 T 时返 ""（poison-on-miss，绝不臆造）。
@borrows
fn TypedExprCallArgResultIntrinsicType(ctx: TypedExprSourceContext,
                                        lineNumber: int32,
                                        argTextRaw: str): str =
    let argText = chengpath.PathTrim(argTextRaw)
    let callHead = TypedExprBindingRhsCallHead(argText)
    if callHead == "":
        return ""
    let detailKind = parser.ParserResultIntrinsicDetailKind(callHead)
    if detailKind == parser.NormalizedExprDetailResultIsOk ||
       detailKind == parser.NormalizedExprDetailResultIsErr:
        return "bool"
    if detailKind == parser.NormalizedExprDetailResultError:
        return "str"
    if detailKind == parser.NormalizedExprDetailResultErrorInfoOf:
        return "ErrorInfo"
    if detailKind == parser.NormalizedExprDetailResultValue:
        let openPos = TypedExprFindWholeCallOpenParen(argText)
        if openPos <= 0:
            return ""
        let closePos = TypedExprFindMatchingParen(argText, openPos)
        if closePos <= openPos:
            return ""
        let innerArg = chengpath.PathTrim(chengpath.TextSlice(argText,
                                                             openPos + 1,
                                                             closePos - openPos - 1))
        if innerArg == "":
            return ""
        let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
        let operandType = TypedExprStripVarType(
            TypedExprLookupBindingTypeIndexed(
                ctx, scopeIndex, lineNumber, innerArg))
        let innerType = TypedExprResultSuccessType(operandType)
        if TypedExprTypeTextIsConcrete(innerType):
            return innerType
        return ""
    return ""

# A call argument that is itself a builtin call (`Int32(x)`, `len(x)`, `setLen(s, n)`,
# ...) has a trivially known result type independent of the inner expression —
# TypedExprBuiltinCalleeReturnType already carries that exact mapping (used for RHS
# assignment typing). TypedExprAssignStatementType only resolves lvalue-shaped
# binding/field text and TypedExprCallArgResultIntrinsicType only covers Result[T]
# intrinsics, so a nested builtin-cast call argument (e.g. `reserve(seqInst,
# Int32(newCap))`) fell through both with an empty type text: the overload
# disambiguator (PrimaryObjectPlanCallCandidateMatchesArgTypes) then could not tell
# an `int32`-typed candidate from an `int`-typed one on that argument and treated
# both concrete overloads as matching, emptying the call reloc
# (body_ir_call_empty_reloc_target). Qualified heads are left alone (return "") —
# builtin casts are never module-qualified.
@borrows
fn TypedExprCallArgBuiltinCastResultType(argTextRaw: str): str =
    let argText = chengpath.PathTrim(argTextRaw)
    let callHead = TypedExprBindingRhsCallHead(argText)
    if callHead == "" || TypedExprQualifiedCallQualifier(callHead) != "":
        return ""
    let openPos = TypedExprFindWholeCallOpenParen(argText)
    let closePos = TypedExprFindMatchingParen(argText, openPos)
    if openPos <= 0 || closePos <= openPos:
        return ""
    let innerArgsText = chengpath.PathTrim(chengpath.TextSlice(argText,
                                                               openPos + 1,
                                                               closePos - openPos - 1))
    return TypedExprBuiltinCalleeReturnType(callHead,
                                            innerArgsText,
                                            parser.ParserCountTopLevelArgs(innerArgsText))

# Resolve the source type of a call argument without depending on TypedExprIr.
# Facts build call-declaration identities before value IR exists, so overload
# selection must use the same precedence splitter and binary result rules as the
# later IR builder rather than guessing from the first identifier in the text.
# Every recursive edge consumes either a stricter precedence level or a proper
# sub-expression, hence malformed/unknown inputs terminate as an empty type and
# preserve the existing hard-fail contract.
@borrows
fn TypedExprExplicitTypeConversionFinalOpen(textRaw: str): int32 =
    let text = chengpath.PathTrim(textRaw)
    if text.len < 3 || text[text.len - 1] != ')':
        return -1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<text.len:
        let piece = text[i]
        if inString:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif piece == '\\':
                escaped = true
            elif piece == '\'':
                inChar = false
            continue
        if piece == '"':
            inString = true
            continue
        if piece == '\'':
            inChar = true
            continue
        if piece == '[':
            bracketDepth = bracketDepth + 1
            continue
        if piece == ']':
            bracketDepth = bracketDepth - 1
            if bracketDepth < 0:
                return -1
            continue
        if piece == '{':
            braceDepth = braceDepth + 1
            continue
        if piece == '}':
            braceDepth = braceDepth - 1
            if braceDepth < 0:
                return -1
            continue
        if piece == '(':
            if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0 &&
               TypedExprFindMatchingParen(text, i) == text.len - 1:
                return i
            parenDepth = parenDepth + 1
            continue
        if piece == ')':
            parenDepth = parenDepth - 1
            if parenDepth < 0:
                return -1
    return -1

@borrows
fn TypedExprExplicitTypeConversionSurface(textRaw: str,
                                            targetTypeOut: var str,
                                            operandTextOut: var str,
                                            borrowOut: var bool): bool =
    targetTypeOut = ""
    operandTextOut = ""
    borrowOut = false
    let text = chengpath.PathTrim(textRaw)
    let openPos = TypedExprExplicitTypeConversionFinalOpen(text)
    if openPos <= 0 || openPos + 1 >= text.len:
        return false
    let prior = text[openPos - 1]
    if prior == ' ' || prior == '\t' || prior == '\r' || prior == '\n':
        return false
    var targetSurface = chengpath.PathTrim(
        chengpath.TextSlice(text, 0, openPos))
    let operandText = chengpath.PathTrim(
        chengpath.TextSlice(text, openPos + 1,
                            text.len - openPos - 2))
    if targetSurface == "" || operandText == "" ||
       parser.ParserCountTopLevelArgs(operandText) != 1:
        return false
    let namedColon = TypedExprFindTopLevelTextToken(operandText, ":")
    let ternaryQuestion = TypedExprFindTopLevelTextToken(operandText, "?")
    if namedColon > 0 &&
       (ternaryQuestion < 0 || namedColon < ternaryQuestion):
        let possibleName = chengpath.PathTrim(
            chengpath.TextSlice(operandText, 0, namedColon))
        if possibleName != "" && parser.ParserIdentPrefix(possibleName) == possibleName:
            return false
    if targetSurface.len > 4 &&
       parser.ParserStartsWith(targetSurface, "var"):
        let boundary = targetSurface[3]
        if boundary == ' ' || boundary == '\t' ||
           boundary == '\r' || boundary == '\n':
            borrowOut = true
            targetSurface = chengpath.PathTrim(
                chengpath.TextSlice(targetSurface, 4,
                                    targetSurface.len - 4))
    if targetSurface == "":
        return false
    targetTypeOut = targetSurface
    operandTextOut = operandText
    return true

@borrows
fn TypedExprExplicitTypeCanonicalAlias(
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        typeRaw: str): str =
    var current = TypedExprNormalizeTypeText(typeRaw)
    var visited: str[]
    while current != "":
        for i in 0..<visited.len:
            if visited[i] == current:
                return ""
        add(visited, share(current))
        var target = TypedExprNormalizeTypeText(
            TypedExprLookupTypeAliasTargetInContext(ctx,
                                                    sourceContexts,
                                                    share(current)))
        if target == "" || target == current:
            return current
        let currentDot = TypedExprQualifiedTypeDot(current)
        if currentDot > 0 && TypedExprQualifiedTypeDot(target) <= 0:
            let qualifier = chengpath.PathTrim(
                chengpath.TextSlice(current, 0, currentDot))
            if qualifier == "":
                return ""
            target = TypedExprNormalizeTypeText(Fmt"{qualifier}.{target}")
        current = target
    return ""

@borrows
fn TypedExprExplicitTypeTargetVisible(
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        targetTypeRaw: str): bool =
    let targetType = TypedExprNormalizeTypeText(targetTypeRaw)
    if targetType == "" || targetType == "void" ||
       !TypedExprTypeTextIsConcrete(targetType) ||
       TypedExprTypeIsGenericPlaceholder(targetType):
        return false
    let canonical = TypedExprExplicitTypeCanonicalAlias(ctx,
                                                         sourceContexts,
                                                         targetType)
    if canonical == "":
        return false
    return TypedExprAbiClassForTypeInContext(ctx,
                                             sourceContexts,
                                             canonical) !=
           TypedExprAbiPolymorphic

@borrows
fn TypedExprExplicitTypeCanonicalIdentity(
        index: TypedExprBuildIndex,
        ownerSourcePathRaw: str,
        typeRaw: str,
        ownerSourcePathOut: var str,
        typeOut: var str): bool =
    ownerSourcePathOut = parser.ParserNormalizePath(ownerSourcePathRaw)
    typeOut = TypedExprNormalizeTypeText(typeRaw)
    if index == nil || index.released ||
       ownerSourcePathOut == "" || typeOut == "":
        return false
    var visitedOwners: str[]
    var visitedNames: str[]
    while true:
        var targetOwner = ""
        var targetType = ""
        var cycle = false
        if !TypedExprCallAliasTarget(index,
                                      ownerSourcePathOut,
                                      typeOut,
                                      visitedOwners,
                                      visitedNames,
                                      targetOwner,
                                      targetType,
                                      cycle):
            if cycle:
                ownerSourcePathOut = ""
                typeOut = ""
                return false
            return true
        ownerSourcePathOut = parser.ParserNormalizePath(targetOwner)
        typeOut = TypedExprNormalizeTypeText(targetType)
        if ownerSourcePathOut == "" || typeOut == "":
            return false

@borrows
fn TypedExprExplicitTypeIdentityEqual(
        ctx: TypedExprSourceContext,
        targetOwnerSourcePathRaw: str,
        targetTypeRaw: str,
        operandOwnerSourcePathRaw: str,
        operandTypeRaw: str): bool =
    var targetOwner = ""
    var targetType = ""
    var operandOwner = ""
    var operandType = ""
    if !TypedExprExplicitTypeCanonicalIdentity(ctx.buildIndex,
                                                targetOwnerSourcePathRaw,
                                                targetTypeRaw,
                                                targetOwner,
                                                targetType) ||
       !TypedExprExplicitTypeCanonicalIdentity(ctx.buildIndex,
                                                operandOwnerSourcePathRaw,
                                                operandTypeRaw,
                                                operandOwner,
                                                operandType):
        return false
    if targetType == operandType:
        var targetDeclaredOwner = ""
        var targetLeaf = ""
        var operandDeclaredOwner = ""
        var operandLeaf = ""
        let targetNamed = TypedExprCallTypeOwner(ctx.buildIndex,
                                                  targetOwner,
                                                  targetType,
                                                  targetDeclaredOwner,
                                                  targetLeaf)
        let operandNamed = TypedExprCallTypeOwner(ctx.buildIndex,
                                                   operandOwner,
                                                   operandType,
                                                   operandDeclaredOwner,
                                                   operandLeaf)
        if targetNamed || operandNamed:
            return targetNamed && operandNamed &&
                   targetLeaf == operandLeaf &&
                   TypedExprSourcePathsEquivalent(targetDeclaredOwner,
                                                   operandDeclaredOwner)
        return true
    return TypedExprCallTypeIdentityEqual(ctx.buildIndex,
                                           targetOwner,
                                           targetType,
                                           operandOwner,
                                           operandType)

# [b10 同名函数优先臂] 显式转换分类器的合同上界：callee 形 `Head(单位置实参)`
# 的 Head 同时是可见类型（类型命名空间）与已登记函数声明（值命名空间）时，
# 调用位置的函数调用是唯一类型检查合读（spec :639 类型与值命名空间分离；
# :577 转换仅写作 `TypeExpr(expr)` 且转换不属于函数调用语法；:639 转换只
# 在 callee 解析为类型且不存在同名值声明劫持时成立）。实例：
# cleanup_cfg.cheng:16266 `phase.PhaseArenaReport(plan.arena)` —
# phase_arena.cheng:246 `fn PhaseArenaReport(arena: PhaseArena): PhaseArenaReport`
# 同名构造惯例（全树 8 处 `fn T(..): T`，调用形 2 处，如
# compiler_runtime.cheng:91 `CompilerRuntimeContract(rootDir)`）；转换读法
# PhaseArena→PhaseArenaReport 结构上必被拒（b905b 门轮判词
# `explicit type conversion requires exact or alias-equivalent source type
# target=phase.PhaseArenaReport source=phase.PhaseArena` 即此断裂）。
# 存在性探针 = build index `ctx_function_decl_name_source`（owner,leaf）
# 精确名查询，Unique/Ambiguous 均算存在（重载自然覆盖）；索引式 alias
# 解析失败时回退本源 importedModules 表（B9 限定臂同款）。builtin 标量
# 转换惯用语（int32(x)/uint8(x)/str(x)... 族）豁免：leaf 命中 builtin
# 转换名单一律维持转换语义（std/system.cheng:2633 `fn int32(x: T)` 函数体
# `return int32(x)` 正依赖该读法；与 facts 侧 builtin 隔离合同同向）。
# index nil/released（流式 metadata 相，B9 限界①同域）→ false，原
# fail-closed 行为逐位不变。
@borrows
fn TypedExprExplicitTypeTargetResolvesToFunction(
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        targetTypeRaw: str): bool =
    let targetType = chengpath.PathTrim(targetTypeRaw)
    if targetType == "":
        return false
    let qualifier = TypedExprQualifiedCallQualifier(targetType)
    let leaf = TypedExprQualifiedCallLeaf(targetType)
    if leaf == "":
        return false
    # 形态门：裸纯标识符（owner=本源）或纯限定形 `alias.Member`，其余形态
    # （泛型头/数组缀等）不属函数头探针射程，交回原转换合同。
    if qualifier == "":
        if parser.ParserIdentPrefix(targetType) != targetType:
            return false
    else:
        if Fmt"{qualifier}.{leaf}" != targetType:
            return false
    if TypedExprBuiltinCalleeReturnType(leaf, "", 1) != "":
        return false
    var ownerPath = ""
    if qualifier == "":
        ownerPath = parser.ParserNormalizePath(ctx.sourcePath)
    else:
        ownerPath = TypedExprLookupQualifiedModuleSourcePath(ctx,
                                                              sourceContexts,
                                                              qualifier)
        if ownerPath == "":
            for importedScan in 0..<ctx.importedModules.len:
                let importedQualifier = parser.ParserIdentPrefix(
                    chengpath.PathTrim(
                        ctx.importedModules[importedScan].qualifier))
                if importedQualifier == qualifier:
                    ownerPath = parser.ParserNormalizePath(
                        ctx.importedModules[importedScan].targetSourcePath)
                    break
        if ownerPath == "":
            return false
    var indexHandle = TypedExprContextsBuildIndex(sourceContexts)
    if indexHandle == nil:
        indexHandle = ctx.buildIndex
    if indexHandle == nil || indexHandle.released:
        return false
    var functionDeclRow: int32 = -1
    let functionDeclState = TypedExprBuildIndexLookup(
        indexHandle,
        "ctx_function_decl_name_source",
        ownerPath,
        leaf,
        "",
        functionDeclRow)
    return functionDeclState == TypedExprBuildIndexUnique ||
           functionDeclState == TypedExprBuildIndexAmbiguous

@borrows
fn TypedExprExplicitTypeConversionClassify(
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        targetOwnerSourcePathRaw: str,
        targetTypeRaw: str,
        operandOwnerSourcePathRaw: str,
        operandTypeRaw: str,
        borrow: bool,
        operandPlaceState: TypedExprExplicitTypeConversionPlaceState): TypedExprExplicitTypeConversionKind =
    let targetType = TypedExprNormalizeTypeText(targetTypeRaw)
    let operandType = TypedExprCallRuntimeType(operandTypeRaw)
    if !TypedExprExplicitTypeTargetVisible(ctx, sourceContexts, targetType):
        return TypedExprExplicitTypeConversionNone
    # range(...) 构造臂 (批次五层修复, 39d06f10f): for 头/seq 绑定把
    # `a..<b`/`a..b` 脱糖为 range(start, end); range 虽是内置类型名,
    # 但此处不是类型转换——整数实参按构造放行 (两标量 ABI 承载)。
    if targetType == "range":
        return TypedExprExplicitTypeConversionScalar
    # [b10 同名函数优先臂] callee 名已登记为函数/importc 声明 → 本面是函数
    # 调用而非转换（见 TypedExprExplicitTypeTargetResolvesToFunction 契约
    # 注），返回 None 交回调用解析链；六个 classify 调用点对 None 的既有
    # 下游都是调用返回类型臂（BindingOperandType:19423 /
    # StaticExprTypeAtLevel 调用臂 / RhsNodeLevel 调用分支），零新链。
    if TypedExprExplicitTypeTargetResolvesToFunction(ctx,
                                                      sourceContexts,
                                                      targetType):
        return TypedExprExplicitTypeConversionNone
    if operandType == "" || !TypedExprTypeTextIsConcrete(operandType):
        panic(Fmt"typed expr: explicit type conversion operand type unavailable target={targetType} operandRaw={operandTypeRaw} operandOwner={operandOwnerSourcePathRaw} targetOwner={targetOwnerSourcePathRaw} borrow={borrow} place={operandPlaceState}")
    if TypedExprExplicitTypeIdentityEqual(ctx,
                                           targetOwnerSourcePathRaw,
                                           targetType,
                                           operandOwnerSourcePathRaw,
                                           operandType):
        if borrow:
            if operandPlaceState ==
               TypedExprExplicitTypeConversionPlaceUnknown:
                return TypedExprExplicitTypeConversionDeferred
            if operandPlaceState !=
               TypedExprExplicitTypeConversionPlaceWritable:
                panic(Fmt"typed expr: var type conversion requires lvalue target={targetType}")
            return TypedExprExplicitTypeConversionBorrow
        return TypedExprExplicitTypeConversionIdentity
    if borrow:
        panic(Fmt"typed expr: var type conversion requires exact source type target={targetType} source={operandType}")
    var targetCtx = TypedExprSourceContextForPathOrCurrent(
        ctx, sourceContexts, targetOwnerSourcePathRaw)
    var operandCtx = TypedExprSourceContextForPathOrCurrent(
        ctx, sourceContexts, operandOwnerSourcePathRaw)
    let targetCanonical = TypedExprExplicitTypeCanonicalAlias(
        targetCtx, sourceContexts, targetType)
    # [b11 枚举退化别名守恒] `Name = enum` 声明头被 metadata 收集器登记为
    # 退化别名（alias target = 形状关键字 "enum"，TypedExprContextProcess-
    # TypeDeclLine 无条件走 MaybeAddTypeDefAlias），canonical 化会把枚举
    # 类型名洗成 "enum"，ABI 查询随之失去枚举身份（枚举行按精确类型名登
    # 记，跳1/跳2/ctx 列/导入回退全都查不到 "enum"）。operand 为精确枚举
    # 类型名时保留原名进入 ABI：枚举是 int32 类标量（TypedExprStatic-
    # RuntimeScalarType 同合同），Scalar 判定仍来自精确枚举行（含 b11 两
    # 臂修复），零启发式、零放宽。实参经 share 保持借用活源（同行既有
    # share(typeRaw) 先例），末行判词 Fmt 读取不落在收缩后的活源区间外。
    let operandIsExactEnum = TypedExprTypeIsEnumInContexts(
        operandCtx, sourceContexts, share(operandType))
    var operandCanonical = TypedExprExplicitTypeCanonicalAlias(
        operandCtx, sourceContexts, operandType)
    if operandIsExactEnum:
        operandCanonical = operandType
    let targetAbiClass = TypedExprAbiClassForTypeInContext(targetCtx,
                                                           sourceContexts,
                                                           targetCanonical)
    let operandAbiClass = TypedExprAbiClassForTypeInContext(operandCtx,
                                                            sourceContexts,
                                                            operandCanonical)
    if targetAbiClass == TypedExprAbiScalar && operandAbiClass == TypedExprAbiScalar:
        return TypedExprExplicitTypeConversionScalar
    # 机器字互转 (PointerLike | 整数标量, 任一侧为 PointerLike) 是指针算术
    # 基本习语, cold 前端一贯放行: ptr(uint64(addr))/uint64(p) 的指针-整数
    # 互转, 以及 T*↔U*/别名指针型↔ptr (如 VoidPtrPtr→ptr) 的指针-指针互转,
    # 位级同为机器字宽, 按标量转换放行; 浮点标量与指针互转仍拒绝。
    let targetPtrCastWord = TypedExprTypeIsIntegerScalar(targetCanonical)
    let operandPtrCastWord = TypedExprTypeIsIntegerScalar(operandCanonical)
    let targetMachineWord = targetAbiClass == TypedExprAbiPointerLike || targetPtrCastWord
    let operandMachineWord = operandAbiClass == TypedExprAbiPointerLike || operandPtrCastWord
    let eitherPointerCast = targetAbiClass == TypedExprAbiPointerLike || operandAbiClass == TypedExprAbiPointerLike
    if targetMachineWord && operandMachineWord && eitherPointerCast:
        return TypedExprExplicitTypeConversionScalar
    panic(Fmt"typed expr: explicit type conversion requires exact or alias-equivalent source type target={targetType} source={operandType}")

@borrows
fn TypedExprStaticRuntimeScalarType(ctx: TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     typeRaw: str): str =
    let originalType = TypedExprCallRuntimeType(typeRaw)
    if originalType == "":
        return ""
    if originalType.len >= 2 &&
       chengpath.TextSlice(originalType, originalType.len - 2, 2) == "[]":
        return originalType
    if TypedExprTypeIsEnumInContexts(ctx, sourceContexts, originalType):
        return "int32"
    if TypedExprTypeIsScalar(originalType):
        return originalType
    var visited: str[]
    var currentType = share(originalType)
    while currentType != "":
        for i in 0..<visited.len:
            if visited[i] == currentType:
                return ""
        add(visited, share(currentType))
        var targetType = TypedExprNormalizeTypeText(
            TypedExprLookupTypeAliasTargetInContext(ctx,
                                                    sourceContexts,
                                                    currentType))
        if targetType == "" || targetType == currentType:
            return originalType
        if TypedExprTypeIsEnumInContexts(ctx, sourceContexts, targetType):
            return "int32"
        if TypedExprTypeIsScalar(targetType):
            return targetType
        let currentDot = TypedExprQualifiedTypeDot(currentType)
        if currentDot > 0 && TypedExprQualifiedTypeDot(targetType) <= 0:
            let currentQualifier = chengpath.PathTrim(chengpath.TextSlice(currentType,
                                                                           0,
                                                                           currentDot))
            if currentQualifier == "":
                return originalType
            targetType = TypedExprNormalizeTypeText(Fmt"{currentQualifier}.{targetType}")
        currentType = targetType
    return originalType

# Static (value-IR-free) counterpart of TypedExprForSeqBindingElementType for
# call-argument typing: a `for x in seq:` induction variable carries no binding
# row, so recover its exact element type from the enclosing for-header. The
# iterable is typed through the same static surface as the call arguments, so
# this works during binding registration before any value IR exists.
@borrows
fn TypedExprStaticForSeqBindingElementType(ctx: TypedExprSourceContext,
                                            sourceContexts: TypedExprSourceContext[],
                                            scope: TypedExprFunctionScope,
                                            lineNumber: int32,
                                            bindingNameRaw: str): str =
    let bindingName = parser.ParserIdentPrefix(chengpath.PathTrim(bindingNameRaw))
    if bindingName == "" || lineNumber <= scope.startLine:
        return ""
    var currentIndent: int32 = 1000000000
    if lineNumber > 0 &&
       lineNumber <= TypedExprSourceContextLineCount(ctx):
        currentIndent = TypedExprLineIndentWidth(
            TypedExprSourceContextLineText(ctx, lineNumber))
    var bestLine: int32 = -1
    var bestType = ""
    for sourceLineNumber in scope.startLine..<lineNumber:
        if sourceLineNumber <= 0 ||
           sourceLineNumber > TypedExprSourceContextLineCount(ctx):
            continue
        let rawLine = TypedExprSourceContextLineText(ctx, sourceLineNumber)
        let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
        if trimmed == "":
            continue
        if !parser.ParserStartsWith(trimmed, "for ") &&
           parser.ParserFindText(trimmed, " in ") < 0:
            continue
        let indent = TypedExprLineIndentWidth(rawLine)
        if indent >= currentIndent:
            continue
        if TypedExprForBindingNameFromHeader(trimmed) != bindingName:
            continue
        var rangeStartText = ""
        var rangeEndText = ""
        if TypedExprForHeaderRangeBounds(trimmed, rangeStartText, rangeEndText):
            continue
        let iterableText = TypedExprForHeaderIterableText(trimmed)
        if iterableText == "" || iterableText == bindingName:
            continue
        let iterableType = TypedExprStaticExprTypeAtLevel(ctx,
                                                          sourceContexts,
                                                          scope,
                                                          sourceLineNumber,
                                                          iterableText,
                                                          0)
        if iterableType == "":
            continue
        let elemType = TypedExprNormalizeTypeText(
            TypedExprIrRhsIndexElemType(ctx, iterableType))
        if elemType == "":
            continue
        if sourceLineNumber >= bestLine:
            bestLine = sourceLineNumber
            bestType = elemType
    return bestType

# 解引用值类型: 命名指针型按后缀剥 pointee; 小整数指针 (8/16 位) 的值读一律
# 提升为 int32 (与 BodyIR 的 1/2 字节装载同规), 64 位整型指针→int64,
# ptr/VoidPtr 族→ptr。非命名指针型返回 "" 交调用方走原 fallback。
fn TypedExprDerefValueScalarType(typeRaw: str): str =
    let t = TypedExprNormalizeTypeText(typeRaw)
    if t == "Int64Ptr" || t == "UInt64Ptr":
        return "int64"
    if t == "Int32Ptr" || t == "UInt32Ptr" ||
       t == "Int8Ptr" || t == "UInt8Ptr" ||
       t == "Int16Ptr" || t == "UInt16Ptr" ||
       t == "CharPtr" || t == "BoolPtr":
        return "int32"
    if t == "Float64Ptr":
        return "float64"
    if t == "Float32Ptr":
        return "float32"
    if t == "ptr" || t == "VoidPtr" || t == "VoidPtrPtr":
        return "ptr"
    return ""

# place 链形态: ident 开头, 顶层 (深度 0) 只出现 `.`/`->`/`[`/`]` 链接符,
# 下标/括号内允许任意表达式 (如 `newline[0]`/`xs[i]`/`a.b`/`p->f`)。
# 用于 `&<place>` 的类型推导 — 任何合法 place 的 addr-of 都是 ptr。
fn TypedExprTextIsPlaceChainSurface(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text.len <= 0:
        return false
    let first = text[0]
    if !(first >= 'a' && first <= 'z') && !(first >= 'A' && first <= 'Z') && first != '_':
        return false
    var depth: int32
    for i in 1..<text.len:
        let ch = text[i]
        if ch == '[' || ch == '(':
            depth = depth + 1
        elif ch == ']' || ch == ')':
            if depth <= 0:
                return false
            depth = depth - 1
        elif depth == 0:
            if !(ch >= 'a' && ch <= 'z') && !(ch >= 'A' && ch <= 'Z') &&
               !(ch >= '0' && ch <= '9') && ch != '_' && ch != '.' &&
               ch != '-' && ch != '>':
                return false
    return depth == 0

@borrows
fn TypedExprStaticExprTypeAtLevel(ctx: TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   scope: TypedExprFunctionScope,
                                   lineNumber: int32,
                                   textRaw: str,
                                   level: int32): str =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return ""
    let unwrapped = TypedExprStripWrappingParens(text)
    if unwrapped != text:
        return TypedExprStaticExprTypeAtLevel(ctx,
                                               sourceContexts,
                                               scope,
                                               lineNumber,
                                               unwrapped,
                                               0)
    # 一元解引用 *(expr): 值类型 = 指针型的 pointee。必须在二元分裂之前拦截 —
    # 顶层 `*` 在 opPos=0 会被分裂臂当乘法拒绝 (return ""), 使 `let x = *(T(p))`
    # 的绑定类型与 `int64(x)` cast operand 定型全部落空 (cold 一贯支持:
    # core_runtime_provider_darwin 的 rss/proc_info 路径)。`*(T(...))` 的类型
    # 只取决于 cast 头 T (与内层实参无关); `*(x)` 取 x 的指针型再剥 pointee。
    if text.len > 3 && text[0] == '*' && text[1] == '(' && text[text.len - 1] == ')':
        let derefInner = chengpath.PathTrim(chengpath.TextSlice(text, 2, text.len - 3))
        let derefCastHead = TypedExprBindingRhsCallHead(derefInner)
        if derefCastHead != "":
            let derefCastPointee = TypedExprDerefValueScalarType(derefCastHead)
            if derefCastPointee != "":
                return derefCastPointee
        let derefInnerType = TypedExprStaticExprTypeAtLevel(ctx,
                                                            sourceContexts,
                                                            scope,
                                                            lineNumber,
                                                            derefInner,
                                                            0)
        if derefInnerType != "":
            let derefPointee = TypedExprDerefValueScalarType(derefInnerType)
            if derefPointee != "":
                return derefPointee
    # 三元 `cond ? then : else`（规范 1.3.4）静态定型：顶层空隔 `?`/`:` 分裂,
    # 两臂递归定型同型即得。仅认前后皆空格的 `?`（书写惯例）——`x?` postfix
    # try 的 `?` 紧贴前 token 自然排除; 无空格形交原 fallback 不强行定型。
    # dict `{k: v}` 与 slice `[a: b]` 的 `:` 在 depth>0 不入。扫描助手落
    # parser.cheng（typed_expr.cheng 函数数触 cold 上限, 新增函数定义即
    # use-of-consumed 编译失败; 函数体内嵌语句与 parser.cheng 新增函数无恙）。
    let ternaryQuestion = parser.ParserTernaryTopLevelQuestionPos(text)
    if ternaryQuestion > 0:
        let ternaryColon = parser.ParserTernaryTopLevelColonPos(
            text, ternaryQuestion + 1)
        if ternaryColon > ternaryQuestion + 1 &&
           ternaryColon + 1 < text.len:
            let ternaryThenText = chengpath.PathTrim(
                chengpath.TextSlice(text,
                                    ternaryQuestion + 1,
                                    ternaryColon - ternaryQuestion - 1))
            let ternaryThenType = TypedExprStaticExprTypeAtLevel(
                ctx,
                sourceContexts,
                scope,
                lineNumber,
                ternaryThenText,
                0)
            let ternaryElseText = chengpath.PathTrim(
                chengpath.TextSlice(text,
                                    ternaryColon + 1,
                                    text.len - ternaryColon - 1))
            let ternaryElseType = TypedExprStaticExprTypeAtLevel(
                ctx,
                sourceContexts,
                scope,
                lineNumber,
                ternaryElseText,
                0)
            if ternaryThenType != "" && ternaryThenType == ternaryElseType:
                return TypedExprNormalizeTypeText(ternaryThenType)
    # Value-form `if cond: A else: B` 的 call 静态实参定型补臂（static-arg
    # 单入口族现役判点 ownership_drop_ir.cheng:1809 `add(out.placeStateMasks,
    # if initialized: ... else: ...)`，p1vis 绿轮 sweep_green.stderr 终点）。
    # 分段合同与 TypedExprBindingRhsIfExprType / TypedExprIrBuildRhsIfExprNode
    # 逐字同构：if 前缀 + 顶层 else: + 深度感知首个冒号，两臂交同一静态定型
    # 机器递归；同型才定型，异型或任一臂不可定型返空——fail-closed 语义
    # 不变（零放宽），elif/异型等不匹配形落回原路径照旧判词。
    if text.len >= 4 && parser.ParserStartsWith(text, "if "):
        let ifExprElsePos = TypedExprFindTopLevelTextToken(text, "else:")
        if ifExprElsePos > 3:
            var ifExprColonPos = -1
            var ifExprScan = 3
            var ifExprDepth = 0
            while ifExprScan < ifExprElsePos:
                if text[ifExprScan] == '(' || text[ifExprScan] == '[':
                    ifExprDepth = ifExprDepth + 1
                elif text[ifExprScan] == ')' || text[ifExprScan] == ']':
                    ifExprDepth = ifExprDepth - 1
                elif text[ifExprScan] == ':' && ifExprDepth == 0:
                    ifExprColonPos = ifExprScan
                    break
                ifExprScan = ifExprScan + 1
            if ifExprColonPos > 3:
                let ifExprThenText = chengpath.PathTrim(
                    chengpath.TextSlice(text,
                                        ifExprColonPos + 1,
                                        ifExprElsePos - ifExprColonPos - 1))
                let ifExprElseText = chengpath.PathTrim(
                    chengpath.TextSlice(text,
                                        ifExprElsePos + 5,
                                        text.len - ifExprElsePos - 5))
                if ifExprThenText != "" && ifExprElseText != "":
                    let ifExprThenType = TypedExprStaticExprTypeAtLevel(
                        ctx,
                        sourceContexts,
                        scope,
                        lineNumber,
                        ifExprThenText,
                        0)
                    let ifExprElseType = TypedExprStaticExprTypeAtLevel(
                        ctx,
                        sourceContexts,
                        scope,
                        lineNumber,
                        ifExprElseText,
                        0)
                    if ifExprThenType != "" &&
                       ifExprThenType == ifExprElseType:
                        return TypedExprNormalizeTypeText(ifExprThenType)
    # A top-level range owns `<` characters that are not relational operators.
    # Range values are typed by their dedicated consumers, never as binary call
    # arguments, so leave them unknown here rather than splitting `..<` at `<`.
    if TypedExprTextHasTopLevelRangeOp(text):
        return ""
    if level < 10:
        let split = TypedExprIrRhsFindSplit(text, level)
        if split < 0:
            return TypedExprStaticExprTypeAtLevel(ctx,
                                                   sourceContexts,
                                                   scope,
                                                   lineNumber,
                                                   text,
                                                   level + 1)
        let opPos = split / 4
        let opLen = split % 4
        if opPos <= 0 || opLen <= 0 || opPos + opLen >= text.len:
            return ""
        let lhsText = TypedExprSliceTrim(text, 0, opPos)
        let rhsText = TypedExprSliceTrim(text,
                                         opPos + opLen,
                                         text.len - opPos - opLen)
        if lhsText == "" || rhsText == "":
            return ""
        let lhsType = TypedExprStaticExprTypeAtLevel(ctx,
                                                      sourceContexts,
                                                      scope,
                                                      lineNumber,
                                                      lhsText,
                                                      level)
        if lhsType == "":
            return ""
        let rhsType = TypedExprStaticExprTypeAtLevel(ctx,
                                                      sourceContexts,
                                                      scope,
                                                      lineNumber,
                                                      rhsText,
                                                      level + 1)
        if rhsType == "":
            return ""
        var opKind: TypedExprIrOpKind
        var resultType = ""
        let opText = chengpath.TextSlice(text, opPos, opLen)
        let lhsMetaType = TypedExprStaticRuntimeScalarType(ctx,
                                                            sourceContexts,
                                                            lhsType)
        let rhsMetaType = TypedExprStaticRuntimeScalarType(ctx,
                                                            sourceContexts,
                                                            rhsType)
        if lhsMetaType == "" || rhsMetaType == "" ||
           !TypedExprIrRhsBinopResultMeta(lhsMetaType,
                                          rhsMetaType,
                                          level,
                                          opText,
                                          opKind,
                                          resultType):
            return ""
        return TypedExprNormalizeTypeText(resultType)

    var conversionTarget = ""
    var conversionOperand = ""
    var conversionBorrow = false
    if TypedExprExplicitTypeConversionSurface(text,
                                               conversionTarget,
                                               conversionOperand,
                                               conversionBorrow) &&
       TypedExprExplicitTypeTargetVisible(ctx,
                                          sourceContexts,
                                          conversionTarget):
        let conversionOperandType = TypedExprStaticExprTypeAtLevel(
            ctx,
            sourceContexts,
            scope,
            lineNumber,
            conversionOperand,
            0)
        let conversionKind = TypedExprExplicitTypeConversionClassify(
            ctx,
            sourceContexts,
            ctx.sourcePath,
            conversionTarget,
            ctx.sourcePath,
            conversionOperandType,
            conversionBorrow,
            TypedExprExplicitTypeConversionPlaceUnknown)
        let normalizedTarget = TypedExprNormalizeTypeText(conversionTarget)
        if conversionKind == TypedExprExplicitTypeConversionDeferred ||
           conversionKind == TypedExprExplicitTypeConversionBorrow:
            return TypedExprCallBorrowModeType(normalizedTarget)
        if conversionKind == TypedExprExplicitTypeConversionIdentity ||
           conversionKind == TypedExprExplicitTypeConversionScalar:
            return normalizedTarget

    let literalType = TypedExprLiteralBindingType(text)
    if literalType != "":
        return TypedExprNormalizeTypeText(literalType)
    # nil 是 ptr 类型的字面量 (importc 实参定型 libc_*(..., nil, ...) 需要),
    # 此前无定型臂 → call declaration static argument type unavailable。
    if text == "nil":
        return "ptr"
    # 数组字面量 [e0, e1, ...]: 逐元素静态定型, 元素同型 → elemType[]。
    # 全 str 字面量元素已被上面 LiteralBindingType 的 str[] 臂命中; 混合元素
    # (str 变量+字面量, host_ops.cheng `Join(["...", filePath, "\n"], "")`)
    # 在此逐元素递归定型。异型/含不可定型元素 → 交原 fallback (不强行定型)。
    if text.len >= 2 && text[0] == '[' && text[text.len - 1] == ']':
        let seqLitInnerText = TypedExprSliceTrim(text, 1, text.len - 2)
        if seqLitInnerText != "":
            let seqLitElems = TypedExprSplitTopLevelCsv(seqLitInnerText)
            if seqLitElems.len > 0:
                var seqLitElemType = ""
                var seqLitElemSame = true
                for seqLitElemI in 0..<seqLitElems.len:
                    let seqLitElemText = chengpath.PathTrim(seqLitElems[seqLitElemI])
                    let seqLitElemOneType = TypedExprStaticExprTypeAtLevel(ctx,
                                                                           sourceContexts,
                                                                           scope,
                                                                           lineNumber,
                                                                           seqLitElemText,
                                                                           0)
                    if seqLitElemOneType == "":
                        seqLitElemSame = false
                    elif seqLitElemType == "":
                        seqLitElemType = seqLitElemOneType
                    elif seqLitElemOneType != seqLitElemType:
                        seqLitElemSame = false
                if seqLitElemSame && seqLitElemType != "":
                    return Fmt"{seqLitElemType}[]"
    var primaryType = ""
    # Arbitrary postfix/control syntax is not value-equivalent to an assignment
    # path.  Feeding it through the broad LHS resolver can truncate the text to
    # its first identifier and silently inherit the wrong type.
    if TypedExprTextIsSimpleIdent(text) ||
       TypedExprTextIsSimpleFieldPath(text):
        primaryType = TypedExprAssignStatementType(ctx,
                                                    sourceContexts,
                                                    scope,
                                                    lineNumber,
                                                    text)
        if primaryType == "" && TypedExprTextIsSimpleIdent(text):
            primaryType = TypedExprStaticLetCallResultType(ctx,
                                                           sourceContexts,
                                                           scope,
                                                           lineNumber,
                                                           text)
    if primaryType == "":
        let postfixRootName = parser.ParserIdentPrefix(text)
        if postfixRootName != "" && postfixRootName.len < text.len:
            var postfixRootType = TypedExprAssignStatementType(ctx,
                                                                sourceContexts,
                                                                scope,
                                                                lineNumber,
                                                                postfixRootName)
            # let 推断根回探（static-arg 族成员 2：ownership_drop_ir.cheng:3176
            # `let effect = ir.deferEffects[...]` 后 `effect.placeId` 作 call 实参，
            # kd_staticargd1 爬深轮实测判点）。推断 let 无绑定行
            # （TypedExprMaybeAddBindingInit 只收 typeText 非空行），故按
            # TypedExprStaticLetCallResultType 行扫描回退同法逐行扫本 scope
            # 取 `let <root> = <rhs>` 定义行，RHS 交同一静态定型机器在定义行
            # 递归定型得根型；门 level<=10（无二元运算文本爬梯后恰在 10 抵达
            # 本臂，v1/v2 的 <10 门因此永不触发，d2/d3/d4 三轮实证）+探针
            # 递归 level+1 天然限深，链式 let 根超一跳仍返空 fail-closed
            # （零放宽）。
            if postfixRootType == "" && level <= 10 &&
               TypedExprTextIsSimpleIdent(postfixRootName):
                var rootScanLine = scope.startLine
                if rootScanLine < 1:
                    rootScanLine = 1
                var rootDefLineNumber: int32
                var rootRhsText = ""
                while rootScanLine < lineNumber &&
                      (scope.endLine <= 0 || rootScanLine <= scope.endLine):
                    let rootRawLine = TypedExprSourceContextLineText(
                        ctx, rootScanLine)
                    let rootParsed = TypedExprParseBindingLineOwned(rootRawLine)
                    if rootParsed.ok && rootParsed.name == postfixRootName &&
                       rootParsed.rhsStartColumn > 0:
                        rootDefLineNumber = rootScanLine
                        rootRhsText = TypedExprBindingRhsText(
                            rootRawLine,
                            rootParsed.rhsStartColumn)
                    rootScanLine = rootScanLine + 1
                if rootRhsText != "":
                    postfixRootType = TypedExprStaticExprTypeAtLevel(
                        ctx,
                        sourceContexts,
                        scope,
                        rootDefLineNumber,
                        rootRhsText,
                        level + 1)
            if postfixRootType != "":
                primaryType = TypedExprPostfixValueTypeFromRoot(ctx,
                                                                sourceContexts,
                                                                text,
                                                                postfixRootName,
                                                                postfixRootType)
    if primaryType == "":
        primaryType = TypedExprBindingRhsForRangeI32Type(ctx,
                                                         scope,
                                                         lineNumber,
                                                         text)
    # `for x in seq:` induction variable: no binding row exists for it (the
    # seq-element type lives only in the for-header), so the binding/param
    # lookups above miss. Mirror the value-IR resolvers
    # (TypedExprBindingOperandType :11844) and recover the exact element type
    # from the enclosing for-header through the static surface.
    if primaryType == "" && TypedExprTextIsSimpleIdent(text):
        primaryType = TypedExprStaticForSeqBindingElementType(ctx,
                                                              sourceContexts,
                                                              scope,
                                                              lineNumber,
                                                              text)
    if primaryType == "":
        primaryType = TypedExprCallArgResultIntrinsicType(ctx,
                                                          lineNumber,
                                                          text)
    if primaryType == "":
        primaryType = TypedExprCallArgBuiltinCastResultType(text)
    if primaryType == "" && TypedExprTextIsSimpleIdent(text):
        var constLiteral = ""
        if ctx.buildIndex != nil && ctx.buildIndex.frozenReadOnlyQueries:
            constLiteral = TypedExprModuleConstLiteralForFrozenContext(
                ctx, text)
        if constLiteral != "":
            primaryType = TypedExprLiteralBindingType(constLiteral)
    if primaryType == "":
        let qualifiedConstLiteral = TypedExprQualifiedConstLiteral(ctx,
                                                                    sourceContexts,
                                                                    text)
        if qualifiedConstLiteral != "":
            primaryType = TypedExprLiteralBindingType(qualifiedConstLiteral)
    if primaryType == "":
        primaryType = TypedExprLookupEnumConstType(ctx, sourceContexts, text)
    # 静态实参定型的枚举成员权威补臂（192 族：cleanup_cfg:4486
    # `odir.OwnershipDropEdgeReturn` 判词，kd_b801 逐字复现）。流式
    # typed-facts 相两个既有枚举臂全落空：限定形没有
    # 「共享索引 (targetPath, member) → typeName」查询臂（探针 kd_b901
    # 实证该行 Unique 且 typeName 正确、无人查）；同模块裸形即使
    # ctx 自带 enumValueNames/Types 元数据（重建 context 由
    # AttachStableMetadataToRebuildContext 克隆）也无读者——既有臂只查
    # build index，本相该键 Missing。探针证明此处之前所有臂对这两形
    # 都返回 ""，补臂只把原 fail-closed 判词改为精确定型，冻结相既有
    # 臂先命中、行为不变。IR 侧同域合同先例：
    # TypedExprIrBuildRhsQualifiedEnumConstNode（bail=44 根修）。
    if primaryType == "" && parser.ParserIdentPrefix(text) == text:
        var enumOwnIndex = -1
        for enumOwnScan in 0..<ctx.enumValueNames.len:
            if ctx.enumValueNames[enumOwnScan] == text:
                enumOwnIndex = enumOwnScan
                break
        if enumOwnIndex >= 0 && enumOwnIndex < ctx.enumValueTypes.len:
            let enumOwnType = TypedExprTypeLeafName(
                ctx.enumValueTypes[enumOwnIndex])
            if enumOwnType != "":
                primaryType = enumOwnType
    if primaryType == "":
        let enumQual = TypedExprQualifiedCallQualifier(text)
        let enumMember = TypedExprQualifiedCallLeaf(text)
        if enumQual != "" && enumMember != "" &&
           Fmt"{enumQual}.{enumMember}" == text:
            var enumTargetPath = TypedExprLookupQualifiedModuleSourcePath(
                ctx,
                sourceContexts,
                enumQual)
            # 流式精确索引只 append call-declaration 域，import 行缺席时
            # 索引式 alias 解析失败；回退本源 importedModules 表（metadata
            # 构建时收集、重建 context 由 AttachStableMetadataToRebuildContext
            # 克隆），qualifier 精确匹配、目标路径归一化，无启发式。
            if enumTargetPath == "":
                for importedScan in 0..<ctx.importedModules.len:
                    let importedQualifier = parser.ParserIdentPrefix(
                        chengpath.PathTrim(
                            ctx.importedModules[importedScan].qualifier))
                    if importedQualifier == enumQual:
                        enumTargetPath = parser.ParserNormalizePath(
                            ctx.importedModules[importedScan].targetSourcePath)
                        break
            if enumTargetPath != "":
                var enumIndexHandle = TypedExprContextsBuildIndex(sourceContexts)
                if enumIndexHandle == nil:
                    enumIndexHandle = ctx.buildIndex
                if enumIndexHandle != nil:
                    var enumMemberType = ""
                    let enumMemberState = TypedExprBuildIndexLookupFingerprint(
                        enumIndexHandle,
                        "ctx_enum_name_type_source",
                        parser.ParserNormalizePath(enumTargetPath),
                        enumMember,
                        "",
                        enumMemberType)
                    if enumMemberState == TypedExprBuildIndexUnique &&
                       enumMemberType != "":
                        primaryType = Fmt"{enumQual}.{enumMemberType}"
    if primaryType == "":
        primaryType = TypedExprBindingRhsCallReturnType(ctx,
                                                        sourceContexts,
                                                        lineNumber,
                                                        text)
    if primaryType == "" && text.len > 1:
        let prefix = text[0]
        if prefix == '!' || prefix == '-' || prefix == '&':
            let operandText = TypedExprSliceTrim(text, 1, text.len - 1)
            if prefix == '&':
                var placeType = ""
                if TypedExprTextIsSimpleIdent(operandText) ||
                   TypedExprTextIsSimpleFieldPath(operandText):
                    placeType = TypedExprAssignStatementType(ctx,
                                                              sourceContexts,
                                                              scope,
                                                              lineNumber,
                                                              operandText)
                # `&arr[i]`/`&s.field[i]` 等下标/链式 place 的 addr-of 同样是 ptr
                # (cold 一贯支持: libc_write(1, &newline[0], 1) 的 importc 实参
                # 定型), 原臂只认 simple ident/field path 会把下标 place 漏成 ""。
                if placeType != "" ||
                   (TypedExprTextIsSimpleIdent(operandText) &&
                    TypedExprLocalFunctionNameState(ctx, operandText) !=
                    TypedExprBuildIndexMissing) ||
                   TypedExprTextIsPlaceChainSurface(operandText):
                    primaryType = "ptr"
            else:
                let operandType = TypedExprStaticExprTypeAtLevel(ctx,
                                                                  sourceContexts,
                                                                  scope,
                                                                  lineNumber,
                                                                  operandText,
                                                                  10)
                if prefix == '!' && operandType == "bool":
                    primaryType = "bool"
                elif prefix == '-' &&
                     (operandType == "int32" || operandType == "uint32"):
                    primaryType = "int32"
                elif prefix == '-' &&
                     (operandType == "int64" || operandType == "uint64"):
                    primaryType = "int64"
    if primaryType == "":
        let callHead = TypedExprBindingRhsCallHead(text)
        if callHead != "":
            primaryType = TypedExprBindingRhsCallReturnType(
                ctx, sourceContexts, lineNumber, text)
            if primaryType == "":
                primaryType = TypedExprStaticUniqueCalleeReturnType(ctx, text)
    # share(<expr>) 惯用面静态定型补臂（192 族新实例：cleanup_cfg:836
    # `add(bodyIR.callSequence, share(call))`；B9 枚举定型双臂与流式补登
    # 不覆盖 share() 泛型调用实参形态）。share 是语言内建借用共享惯用面
    # （spec 所有权：share(x) 增引用计数并返回同型可共享引用），静态结果
    # 类型 = 操作数静态类型。此前该形态全臂落空：非字面量/非简单标识符、
    # TypedExprBuiltinCalleeReturnType 无 share 映射、share 声明查询
    # Missing（rhsRet/uniqueRet 双空）→ fail-closed 判词。声明权威臂先行
    # （上方 callHead 臂），无同名声明且全臂落空才按惯用面定型；操作数
    # 递归走同一静态定型函数，不可定型仍返空，fail-closed 语义不变
    # （零放宽）。全树无用户态 fn share 声明（std 只有 share_mt）。
    if primaryType == "" && TypedExprBindingRhsCallHead(text) == "share":
        let shareOpenPos = TypedExprFindWholeCallOpenParen(text)
        let shareClosePos = TypedExprFindMatchingParen(text, shareOpenPos)
        if shareOpenPos > 0 && shareClosePos > shareOpenPos:
            let shareOperandText = chengpath.PathTrim(
                chengpath.TextSlice(text,
                                    shareOpenPos + 1,
                                    shareClosePos - shareOpenPos - 1))
            if shareOperandText != "" &&
               parser.ParserCountTopLevelArgs(shareOperandText) == 1:
                primaryType = TypedExprStaticExprTypeAtLevel(ctx,
                                                             sourceContexts,
                                                             scope,
                                                             lineNumber,
                                                             shareOperandText,
                                                             0)
                # V1 补臂（census R2 / wall_pattern_census.md §七）：操作数=调用
                # 结果+postfix（`call(args).field` / `call(args)[i]`）时上方递归
                # 臂必落空——尾缀使 TypedExprBindingRhsCallHead 返空(18415
                # closePos+1!=len)，postfix 根臂按根名查绑定亦查无调用名。
                # 先将整段调用部分（至匹配右括号）交同一静态定型机器递归
                # 定型（callHead 声明权威/intrinsic/builtin cast 臂均可达），
                # 非空则以其为根走 TypedExprPostfixValueTypeFromRoot 消化后缀
                # 链；任一段不可定型仍返空，fail-closed 判词语义不变（零放宽）。
                # 子臂仅在调用右括号后紧跟 `[`/`.`/`->` 后缀时可达，其余操作数
                # 形状行为逐位不变。
                if primaryType == "":
                    let shareOpCallOpenPos = TypedExprFindWholeCallOpenParen(
                        shareOperandText)
                    if shareOpCallOpenPos > 0:
                        let shareOpCallClosePos = TypedExprFindMatchingParen(
                            shareOperandText, shareOpCallOpenPos)
                        if shareOpCallClosePos > shareOpCallOpenPos &&
                           shareOpCallClosePos + 1 < shareOperandText.len:
                            let shareOpNext = shareOperandText[shareOpCallClosePos + 1]
                            let shareOpArrow = shareOpNext == '-' &&
                                shareOpCallClosePos + 2 < shareOperandText.len &&
                                shareOperandText[shareOpCallClosePos + 2] == '>'
                            if shareOpNext == '.' || shareOpNext == '[' ||
                               shareOpArrow:
                                let shareOpCallText = chengpath.TextSlice(
                                    shareOperandText,
                                    0,
                                    shareOpCallClosePos + 1)
                                let shareOpCallHead = chengpath.PathTrim(
                                    chengpath.TextSlice(shareOperandText,
                                                        0,
                                                        shareOpCallOpenPos))
                                if TypedExprCallHeadIsPlainQualifiedIdent(
                                                                          shareOpCallHead):
                                    let shareOpCallRootType = TypedExprStaticExprTypeAtLevel(ctx,
                                                                                             sourceContexts,
                                                                                             scope,
                                                                                             lineNumber,
                                                                                             shareOpCallText,
                                                                                             0)
                                    if shareOpCallRootType != "":
                                        primaryType = TypedExprPostfixValueTypeFromRoot(ctx,
                                                                                        sourceContexts,
                                                                                        shareOperandText,
                                                                                        shareOpCallText,
                                                                                        shareOpCallRootType)
    primaryType = TypedExprCallRuntimeType(primaryType)
    if primaryType == "void":
        return ""
    if !TypedExprTypeTextIsConcrete(primaryType) ||
       TypedExprTypeIsGenericPlaceholder(primaryType):
        # A scope's own declared generics are exact static argument types inside
        # that generic body (overload binding matches them verbatim, e.g.
        # `add(seqInst, val)` inside `fn Add(seqInst: var T[], val: T)`).
        # Undeclared placeholders stay unavailable (fail-closed).
        if !TypedExprExplicitGenericActualAllowed(ctx, scope, primaryType):
            return ""
    return primaryType

@borrows
fn TypedExprCallStaticArgTypesInto(ctx: TypedExprSourceContext,
                                   sourceContexts: TypedExprSourceContext[],
                                   scope: TypedExprFunctionScope,
                                   lineNumber: int32,
                                   argsTextRaw: str,
                                   argTypesOut: var str[]): bool =
    argTypesOut = []
    let argsText = chengpath.PathTrim(argsTextRaw)
    if argsText == "":
        return true
    let args = TypedExprSplitTopLevelCsv(argsText)
    var complete = true
    for i in 0..<args.len:
        let argText = chengpath.PathTrim(args[i])
        var argType = TypedExprStaticExprTypeAtLevel(ctx,
                                                      sourceContexts,
                                                      scope,
                                                      lineNumber,
                                                      argText,
                                                      0)
        argType = TypedExprNormalizeTypeText(argType)
        if argType == "":
            complete = false
        add(argTypesOut, argType)
    return complete

@borrows
fn TypedExprIrCallArgTypesText(ctx: TypedExprSourceContext,
                                sourceContexts: TypedExprSourceContext[],
                                scope: TypedExprFunctionScope,
                                lineNumber: int32,
                                argsTextRaw: str): str =
    var argTypes: str[]
    let _complete = TypedExprCallStaticArgTypesInto(ctx,
                                                    sourceContexts,
                                                    scope,
                                                    lineNumber,
                                                    argsTextRaw,
                                                    argTypes)
    var out = ""
    for i in 0..<argTypes.len:
        if i > 0:
            out = strutil.Join([share(out), ","], "")
        out = strutil.Join([share(out), share(argTypes[i])], "")
    return out

@borrows
fn TypedExprExplicitGenericActualAllowed(
        ctx: TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "" || typeText == "unknown":
        return false
    let callerGenericNames = TypedExprSplitGenericNameJoin(
        scope.genericNameJoin)
    var cursor: int32
    while cursor < typeText.len:
        let first = typeText[cursor]
        let identStart = (first >= 'a' && first <= 'z') ||
                         (first >= 'A' && first <= 'Z') || first == '_'
        if !identStart:
            cursor = cursor + 1
            continue
        let start = cursor
        cursor = cursor + 1
        while cursor < typeText.len:
            let ch = typeText[cursor]
            let identPart = (ch >= 'a' && ch <= 'z') ||
                            (ch >= 'A' && ch <= 'Z') ||
                            (ch >= '0' && ch <= '9') || ch == '_'
            if !identPart:
                break
            cursor = cursor + 1
        let token = chengpath.TextSlice(typeText, start, cursor - start)
        var possibleImplicit = ""
        if token.len == 1 && token[0] >= 'A' && token[0] <= 'Z':
            possibleImplicit = share(token)
        elif token.len == 4 &&
             (chengpath.TextSlice(token, 0, 3) == "ref" ||
              chengpath.TextSlice(token, 0, 3) == "var") &&
             token[3] >= 'A' && token[3] <= 'Z':
            possibleImplicit = chengpath.TextSlice(token, 3, 1)
        if possibleImplicit != "":
            let qualifiedLeft = start > 0 && typeText[start - 1] == '.'
            let qualifiedRight = cursor < typeText.len && typeText[cursor] == '.'
            if qualifiedLeft || qualifiedRight ||
               TypedExprContextHasConcreteSingleLetterType(ctx,
                                                           possibleImplicit):
                continue
            if TypedExprDeclaredGenericNameIndex(callerGenericNames,
                                                  possibleImplicit) < 0:
                return false
        elif TypedExprDeclaredGenericNameIndex(callerGenericNames, token) >= 0:
            continue
    return true

@borrows
fn TypedExprResolveCallDeclarationFromText(currentCtx: TypedExprSourceContext,
                                            sourceContexts: TypedExprSourceContext[],
                                            qualifierRaw: str,
                                            nameRaw: str,
                                            callHeadRaw: str,
                                            argsTextRaw: str,
                                            lineNumber: int32,
                                            sourcePathOut: var str,
                                            returnTypeOut: var str,
                                            targetSymbolOut: var str,
                                            importcOut: var bool,
                                            rowIndexOut: var int32): TypedExprBuildIndexLookupState =
    var scopeIndex = TypedExprScopeIndexForLine(currentCtx.scopes, lineNumber)
    var scope: TypedExprFunctionScope
    if scopeIndex >= 0:
        scope = currentCtx.scopes[scopeIndex]
    else:
        scopeIndex = TypedExprScopeIndexForLine(currentCtx.signatureScopes,
                                                lineNumber)
        if scopeIndex >= 0:
            scope = currentCtx.signatureScopes[scopeIndex]
        else:
            # Top-level initializers have no function scope. A synthetic
            # global scope still permits literal/global-binding typing;
            # unresolved local identifiers remain Missing below.
            scope.sourcePath = currentCtx.sourcePath
            scope.name = ""
            scope.startLine = 1
            scope.endLine = currentCtx.lines.len
            scope.genericNamesComplete = true
    var explicitGenericTypes: str[]
    var explicitGenericPresent = false
    var baseCallHead: str
    var genericErr: str
    var callHead = chengpath.PathTrim(callHeadRaw)
    if callHead == "":
        callHead = TypedExprQualifiedCallSurface(qualifierRaw, nameRaw)
    if !TypedExprCallHeadGenericTypesInto(callHead,
                                           explicitGenericTypes,
                                           explicitGenericPresent,
                                           baseCallHead,
                                           genericErr):
        panic(Fmt"{genericErr} source={currentCtx.sourcePath} line={lineNumber}")
    if TypedExprQualifiedCallLeaf(baseCallHead) !=
       parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw)):
        panic(Fmt"typed expr: call head identity drift source={currentCtx.sourcePath} head={callHead} name={nameRaw} line={lineNumber}")
    # Object constructors and value calls share the parser's call-shaped
    # surface. Resolve the complete named-field aggregate contract before any
    # function-argument typing: a constructor never enters the value
    # declaration resolver, even when a same-named function exists.
    if TypedExprNamedAggregateConstructorTypeInContext(currentCtx,
                                                        sourceContexts,
                                                        baseCallHead,
                                                        argsTextRaw) != "":
        sourcePathOut = ""
        returnTypeOut = ""
        targetSymbolOut = ""
        importcOut = false
        rowIndexOut = -1
        return TypedExprBuildIndexMissing
    # Primitive conversions are reserved builtins; sizeof additionally consumes
    # a type expression rather than a runtime value.  Neither belongs in
    # declaration overload resolution (the std/system compatibility shims are
    # lowering surfaces, not recursively callable source implementations).
    let reservedBuiltinName = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if chengpath.PathTrim(qualifierRaw) == "" &&
       (reservedBuiltinName == "sizeof" || reservedBuiltinName == "new" ||
        parser.ParserCallNameIsBuiltinPrimitiveConversion(reservedBuiltinName)):
        sourcePathOut = ""
        returnTypeOut = ""
        targetSymbolOut = ""
        importcOut = false
        rowIndexOut = -1
        return TypedExprBuildIndexMissing
    for genericIndex in 0..<explicitGenericTypes.len:
        if !TypedExprExplicitGenericActualAllowed(currentCtx,
                                                   scope,
                                                   explicitGenericTypes[genericIndex]):
            panic(Fmt"typed expr: undeclared generic argument source={currentCtx.sourcePath} name={nameRaw} line={lineNumber} index={genericIndex} type={explicitGenericTypes[genericIndex]}")
    var argTypes: str[]
    let argsText = chengpath.PathTrim(argsTextRaw)
    if argsText != "":
        if !TypedExprCallStaticArgTypesInto(currentCtx,
                                            sourceContexts,
                                            scope,
                                            lineNumber,
                                            argsText,
                                            argTypes):
            panic(Fmt"typed expr: call declaration static argument type unavailable source={currentCtx.sourcePath} name={nameRaw} line={lineNumber} scope={scope.name} scope_start={scope.startLine} args={argsText} scopes={currentCtx.scopes.len} signatures={currentCtx.signatureScopes.len} bindings={currentCtx.bindings.len} lines={currentCtx.lines.len}")
    if currentCtx.buildIndex == nil:
        panic("typed expr: call declaration query without structured index")
    var explicitContractMismatch = false
    let state = TypedExprResolveCallDeclarationWithExplicit(
        currentCtx,
        qualifierRaw,
        nameRaw,
        argTypes,
        explicitGenericTypes,
        explicitGenericPresent,
        TypedExprCallDeclarationFunctionOrImportc,
        sourcePathOut,
        returnTypeOut,
        targetSymbolOut,
        importcOut,
        rowIndexOut,
        explicitContractMismatch)
    if explicitContractMismatch:
        panic(Fmt"typed expr: explicit generic binding mismatch source={currentCtx.sourcePath} name={nameRaw} line={lineNumber} count={explicitGenericTypes.len}")
    if state == TypedExprBuildIndexAmbiguous:
        panic(Fmt"typed expr: ambiguous call declaration source={currentCtx.sourcePath} name={nameRaw} arity={argTypes.len}")
    return state

# [w24] 裸 `var n: Node`(nil-able 无初值声明)的 decl-local 零值定义模板。
# 契约: tree-lease 会话内每个 registered decl-local 组必须恰被消费一次
# (typedExprIrExactLocalValueDefinitionRow 的 consumedFlags 审计), 消费点在
# TypedExprIrAddLocalDeclStatement; 此前只有 seq/scalar/bool/str 零值臂能提供
# defining 节点, nil-able 类型(用户 ref object 最常见)落空 → 组 registered 却
# 永不 consumed → 该局部首个精确 Identifier 读必 panic
# "typed expr binding: exact local value-definition group unavailable"
# (w21c v6 main:47 `outer(n, 2)` 读 n 实证, 外层 outer 的 r1 initializer 组
# 同守卫 PASS 互证)。修法 = 为 nil-able 无初值声明补零值定义载体: detached
# (不接 stmt.rhsNodeIndex, 后端对裸声明槽已有完备 bare-default 零值发射
# ptr 槽 LoadConst 0 / 聚合槽 setMem, 语句发射逐字节不变; 参数 ParamRef
# place 同款离语句形态, ownerStatement 恒 -1; NilPtr 非 CallResult/managed-
# temporary producer, 无 sweep 认领)。节点只作 value definition 的 defining
# 载体与后续 LocalRef 读的类型/证明模板。结构类型按 new(T) 臂同款声明行
# 扫描绑定(hits==1 且 TypeSyntax→TypeArena id 有效才拦); 非 nil-able/声明
# 不唯一/arena 缺席一律 -1 fail-closed(组照旧未消费, 守卫原样兜底, 不弱化)。
@borrows
fn typedExprIrAddNilZeroDeclarationLocalTemplate(
        ir: var TypedExprIr,
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        bindingType: str): int32 =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil ||
       ir.exactTypeArena == nil || !ir.valueDefinitionTypeArenaBound:
        return -1
    if !TypedExprIrTypeTextIsNilPtrInContext(ctx, sourceContexts, bindingType):
        return -1
    let nilTree = ir.valueExprTree
    var nilTypeId: int32 = -1
    var nilTypeHits: int32
    for nilDeclarationRow in 0..<nilTree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               nilTree.arena,
               nilTree.declarationKinds,
               nilDeclarationRow) !=
               Int32(parser.ParserDeclarationType):
            continue
        let nilNameToken = arenamod.ArenaArrayInt32Get(
            nilTree.arena,
            nilTree.declarationNameTokenIndexes,
            nilDeclarationRow)
        if parser.ParserValueExprTokenText(nilTree, nilNameToken) != bindingType:
            continue
        nilTypeHits = nilTypeHits + 1
        let nilTypeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            nilTree.arena,
            nilTree.declarationTypeSyntaxRootIndexes,
            nilDeclarationRow)
        if nilTypeSyntaxRoot >= 0 && nilTypeId < 0:
            nilTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                ir.exactTypeArena, nilTypeSyntaxRoot)
    if nilTypeHits != 1 || nilTypeId < 0:
        return -1
    var nilNode = TypedExprIrNodeNew()
    nilNode.resultStructuralTypeId = -1
    nilNode.callDeclarationIndex = -1
    nilNode.originParserNodeId = -1
    nilNode.syntheticOriginKind = TypedExprSyntheticOriginDesugared
    nilNode.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    nilNode.sourcePath = ctx.sourcePath
    nilNode.functionName = scope.name
    nilNode.lineNumber = lineNumber
    nilNode.opKind = TypedExprIrOpNilPtr
    nilNode.resultType = bindingType
    nilNode.surfaceText = "nil"
    nilNode.paramSlot = -1
    nilNode.paramName = ""
    nilNode.operand0NodeIndex = -1
    nilNode.operand1NodeIndex = -1
    nilNode.operand2NodeIndex = -1
    nilNode.literalText = "nil"
    typedExprIrBindNodeStructuralType(ir, nilNode, nilTypeId)
    return TypedExprIrAddNode(ir, nilNode)

# [w24-agg] 按值复合(聚合/定长数组)裸 `var s: Slots` 的 decl-local 零值定义
# 模板。契约与 nil-able 版(上方 typedExprIrAddNilZeroDeclarationLocalTemplate)
# 同族: tree-lease 会话内每个 registered decl-local 组必须恰被消费一次
# (消费点 TypedExprIrAddLocalDeclStatement), 否则该局部首个精确读炸
# "typed expr binding: exact local value-definition group unavailable"(:22146),
# 即使一次也没读, 函数收尾也炸
# "typed expr value definition: function group was not consumed exactly once"
# (:2804)。零值臂(:29505-29563)只覆盖 seq/scalar/bool/str, 按值复合类型全落空。
# 判据(零文本启发, 全精确坐标, 任一列不符一律 -1 fail-closed):
#   1. 声明行 = 本函数内唯一 `ParserDeclarationLocal` +
#      `ParserLexicalBindingIntroductionDeclaration` + 绑定名匹配行 —— 与消费点
#      TypedExprIrConsumeDeclarationLocalValueDefinition(:5747-5771)同一扫描;
#   2. 精确类型 = 该声明行自带的绑定注解 TypeSyntax 根(parser.cheng:24080-24086
#      对 let/var/const 注解行统一盖章; 参数路径 :15011 同源)解析出的 TypeArena
#      TypeId;
#   3. 结构 kind 必须 ∈ {Object, FixedArray(FixedLength>0)}: 即后端
#      PrimaryBodyIrTypeShapeFromText 会经类型布局注册表(:5116-5132)建成
#      LocalAggregateTag 的"按值复合且非 nil-able"类型, 裸声明槽的 bare-default
#      零值发射 = setMem 全零(primary_object_plan.cheng:53450-53457)。RefObject/
#      Borrow/指针属 nil-able 家族(上方 w24 臂先手); Alias/Apply/Optional/Tuple/
#      GenericParameter/标量一律 -1, 绝不"推不出就套模板";
#   4. 组坐标联证: valueExprTransactionDeclarationLocalGroupRows[声明行] 必须是
#      本函数已注册、definitionRows 未落、consumedFlags==0 的组(组注册
#      :61524-61532 先于语句构建 :61614), 即紧随其后的消费点必然命中同一组。
# 载体与 w24 同款 detached 形态(ownerStatement=-1 + NilPtr + parser origin=-1 +
# Desugared + NoSource): 该指纹是三处跨模块审计的既有放行臂(typed_expr :4226 /
# typed_expr_frag_codec :1763 / lowering_plan :6275), 逐列同款故不新增 op 枚举,
# 不动任何身份/哈希/序列化面。语句 rhs 保持 no_node(stmt.rhsNodeIndex 不接),
# 后端语句发射逐字节不变; 节点只作 value definition 的 defining 载体, 以及后续
# 精确读 typedExprIrAddExactBindingRefNode(:22017-22105)复制类型/证明列的模板。
@borrows
fn typedExprIrAddAggregateZeroDeclarationLocalTemplate(
        ir: var TypedExprIr,
        ctx: TypedExprSourceContext,
        scope: TypedExprFunctionScope,
        lineNumber: int32,
        bindingName: str,
        bindingType: str): int32 =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil ||
       ir.exactTypeArena == nil || !ir.valueDefinitionTypeArenaBound ||
       ir.valueExprCurrentParserFunctionRow < 0:
        return -1
    let aggTree = ir.valueExprTree
    let aggName = parser.ParserIdentPrefix(chengpath.PathTrim(bindingName))
    if aggName == "" ||
       ir.valueExprTransactionDeclarationLocalGroupRows.len !=
           aggTree.declarationCount:
        return -1
    var aggDeclarationRow: int32 = -1
    var aggDeclarationHits: int32
    for aggRow in 0..<aggTree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               aggTree.arena,
               aggTree.declarationKinds,
               aggRow) != Int32(parser.ParserDeclarationLocal):
            continue
        if arenamod.ArenaArrayInt32Get(
               aggTree.arena,
               aggTree.declarationFunctionRows,
               aggRow) != ir.valueExprCurrentParserFunctionRow:
            continue
        if typedExprIrDeclarationIntroductionKind(aggTree, aggRow) !=
               parser.ParserLexicalBindingIntroductionDeclaration:
            continue
        let aggNameToken = arenamod.ArenaArrayInt32Get(
            aggTree.arena,
            aggTree.declarationNameTokenIndexes,
            aggRow)
        if parser.ParserValueExprTokenText(aggTree, aggNameToken) != aggName:
            continue
        aggDeclarationHits = aggDeclarationHits + 1
        aggDeclarationRow = aggRow
    if aggDeclarationHits != 1 || aggDeclarationRow < 0:
        return -1
    let aggGroupRow =
        ir.valueExprTransactionDeclarationLocalGroupRows[aggDeclarationRow]
    if aggGroupRow < ir.valueExprTransactionDefinitionGroupStart ||
       aggGroupRow >= TypedExprValueDefinitionGroupAuthorityCount(ir) ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_typedFunctionIndexes,
           aggGroupRow) != ir.functions2_functionNameIds.len ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_definitionRows,
           aggGroupRow) != -1 ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_consumedFlags,
           aggGroupRow) != 0:
        return -1
    let aggTypeSyntaxRoot = arenamod.ArenaArrayInt32Get(
        aggTree.arena,
        aggTree.declarationTypeSyntaxRootIndexes,
        aggDeclarationRow)
    if aggTypeSyntaxRoot < 0:
        return -1
    let aggTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        ir.exactTypeArena, aggTypeSyntaxRoot)
    if aggTypeId < 0:
        return -1
    let aggTypeKind = typearena.TypedExprTypeArenaKindAt(
        ir.exactTypeArena, aggTypeId)
    var aggTypeIsByValueComposite: bool
    if aggTypeKind == typearena.TypedExprStructuralTypeObject:
        aggTypeIsByValueComposite = true
    elif aggTypeKind == typearena.TypedExprStructuralTypeFixedArray:
        if typearena.TypedExprTypeArenaFixedLengthAt(
               ir.exactTypeArena, aggTypeId) > 0:
            aggTypeIsByValueComposite = true
    if !aggTypeIsByValueComposite:
        return -1
    # 后端裸声明槽定型的同源查询: PrimaryBodyIrTypedSlotShape(:5693-5724) 在文本
    # 整形给不出正尺寸时(命名复合/定长数组恒如此)调用
    # PrimaryBodyIrCanonicalTypeLayout(:6995-7014), 后者就是本函数
    # (TypedExprIrLookupTypeLayout, :47485) —— 命中 size>0/align>0 即无条件定型
    # LocalAggregateTag, 聚合槽零值发射(primary_object_plan.cheng:53450-53457)
    # 随之成立。同一函数、同一 (sourcePath, 类型文本) 坐标, 与后端 :5120/:7003
    # 逐字同源, 且布局行在 metadata 阶段一次性建全(:62067-62083)先于函数体构建。
    var aggLayoutSizeBytes: int32
    var aggLayoutAlignBytes: int32
    var aggLayoutFieldCount: int32
    if !TypedExprIrLookupTypeLayout(ir,
                                    ctx.sourcePath,
                                    bindingType,
                                    aggLayoutSizeBytes,
                                    aggLayoutAlignBytes,
                                    aggLayoutFieldCount):
        return -1
    if aggLayoutSizeBytes <= 0 || aggLayoutAlignBytes <= 0:
        return -1
    # (C) 托管存储类必须可判。消费点把节点的 exprClasses 列**原样**当
    # value-definition ownership 传下去(:5808), 而该列由 AppendNode(:6555) 的
    # typedExprNodeExprClassExact 生产: 它在 TypedExprIrTypeContainsManagedStorage
    # 返回 false 时给 TypedExprExprUnknown(:2965-2969), 于是 :6089
    # `ownership <= Int32(TypedExprExprUnknown)` 直接炸 :6098
    # "producer lacks exact type or ownership proof"(:6093 那条
    # ownership != exprClasses[defining] 是同一列自比, 恒真, 不可能是死因)。
    # 类不可判即拒发模板(fail-closed, 旧判词保留), 绝不让 Unknown 流到 :6098。
    var aggHasManagedStorage: bool
    if !TypedExprIrTypeContainsManagedStorage(
           ir, ctx.sourcePath, bindingType, aggHasManagedStorage):
        return -1
    var aggNode = TypedExprIrNodeNew()
    aggNode.resultStructuralTypeId = -1
    aggNode.callDeclarationIndex = -1
    aggNode.originParserNodeId = -1
    aggNode.syntheticOriginKind = TypedExprSyntheticOriginDesugared
    aggNode.spanAuthorityKind = TypedExprSpanAuthorityNoSource
    aggNode.sourcePath = ctx.sourcePath
    aggNode.functionName = scope.name
    aggNode.lineNumber = lineNumber
    aggNode.opKind = TypedExprIrOpNilPtr
    aggNode.resultType = bindingType
    aggNode.surfaceText = "nil"
    aggNode.paramSlot = -1
    aggNode.paramName = ""
    aggNode.operand0NodeIndex = -1
    aggNode.operand1NodeIndex = -1
    aggNode.operand2NodeIndex = -1
    aggNode.literalText = "nil"
    typedExprIrBindNodeStructuralType(ir, aggNode, aggTypeId)
    return TypedExprIrAddNode(ir, aggNode)

@borrows
fn TypedExprIrAddLocalDeclStatement(ir: var TypedExprIr,
                                     ctx: TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     scope: TypedExprFunctionScope,
                                     sourcePath: str,
                                     lineNumber: int32,
                                     lineIndent: int32,
                                     bindingName: str,
                                     bindingTypeRaw: str) =
    let bindingType = TypedExprNormalizeTypeText(bindingTypeRaw)
    if Len(bindingName) <= 0 || Len(bindingType) <= 0:
        return
    var stmt: TypedExprIrStatement
    stmt.rhsNodeIndex = -1
    stmt.rhsBailReason = RhsBailNone
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.bindingTargetDefinitionRow = -1
    stmt.assignIndexNodeIndex = -1
    stmt.sourcePath = share(sourcePath)
    stmt.functionName = share(scope.name)
    stmt.statementIndex = ir.statements2_statementIndexs.len
    var localEndColumn = TypedExprSourceContextLineText(ctx, lineNumber).len
    if localEndColumn <= lineIndent:
        localEndColumn = lineIndent + 1
    TypedExprIrSetStatementDefaultLocation(stmt,
                                           lineNumber,
                                           lineIndent + 1,
                                           lineNumber,
                                           localEndColumn)
    stmt.lineIndent = lineIndent
    var enclosingIfLineNumber: int32
    var enclosingIfConditionText = ""
    TypedExprNearestEnclosingIf(ctx,
                                scope,
                                lineNumber,
                                lineIndent,
                                enclosingIfLineNumber,
                                enclosingIfConditionText)
    stmt.enclosingIfLineNumber = enclosingIfLineNumber
    stmt.enclosingIfConditionText = enclosingIfConditionText
    stmt.exprId = ""
    stmt.kind = TypedExprIrStmtLocalDecl
    stmt.callKind = TypedExprCallNone
    stmt.detailKind = parser.NormalizedExprDetailNone
    stmt.surfaceText = ""
    stmt.bindingName = share(bindingName)
    stmt.resultType = share(bindingType)
    stmt.conditionKind = TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignFieldAlignBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueFieldAlignBytes = 0
    stmt.assignValueOpKind = TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.assignValueRhsConst = 0
    stmt.assignValueRhsHasConst = false
    stmt.callQualifier = ""
    stmt.callCallee = ""
    stmt.callTarget = ""
    stmt.callTargetSourcePath = ""
    stmt.callTargetImportc = false
    stmt.callArgCount = 0
    stmt.callArgsText = ""
    stmt.callArgTypesText = ""
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    if TypedExprIrTypeTextIsSeq(bindingType):
        # Bare `var xs: T[]` zero-init is semantically `xs = []`: build the same
        # EmptySeqInit node the `= []` form builds (TypedExprIrBuildContextualLiteralNode),
        # so the node-eval path owns the decl with an empty 16-byte seq header
        # instead of leaving rhsNodeIndex=-1 (local_decl no_node).
        stmt.rhsNodeIndex = TypedExprIrAddDesugaredLeafNode(ir,
                                                      share(ctx.sourcePath),
                                                      share(scope.name),
                                                      lineNumber,
                                                      TypedExprIrOpEmptySeqInit,
                                                      TypedExprNormalizeTypeText(TypedExprStripVarType(bindingType)),
                                                      "[]",
                                                      "[]")
    else:
        let declScalarType = TypedExprStripVarType(TypedExprIrRuntimeScalarType(ir,
                                                                                ctx.sourcePath,
                                                                                bindingType))
        if declScalarType == "int32":
            stmt.rhsNodeIndex = TypedExprIrAddI32ConstNode(ir,
                                                          share(ctx.sourcePath),
                                                          share(scope.name),
                                                          lineNumber,
                                                          "0")
        elif declScalarType == "uint32":
            stmt.rhsNodeIndex = TypedExprIrAddDesugaredLeafNode(ir,
                                                          share(ctx.sourcePath),
                                                          share(scope.name),
                                                          lineNumber,
                                                          TypedExprIrOpI32Const,
                                                          declScalarType,
                                                          "0",
                                                          "0")
        elif declScalarType == "int64" || declScalarType == "uint64":
            stmt.rhsNodeIndex = TypedExprIrAddDesugaredLeafNode(ir,
                                                          share(ctx.sourcePath),
                                                          share(scope.name),
                                                          lineNumber,
                                                          TypedExprIrOpI64Const,
                                                          declScalarType,
                                                          "0",
                                                          "0")
        elif declScalarType == "bool":
            stmt.rhsNodeIndex = TypedExprIrAddDesugaredLeafNode(ir,
                                                          share(ctx.sourcePath),
                                                          share(scope.name),
                                                          lineNumber,
                                                          TypedExprIrOpBoolLit,
                                                          "bool",
                                                          "false",
                                                          "false")
        elif declScalarType == "str":
            stmt.rhsNodeIndex = TypedExprIrAddDesugaredLeafNode(ir,
                                                          share(ctx.sourcePath),
                                                          share(scope.name),
                                                          lineNumber,
                                                          TypedExprIrOpStrLit,
                                                          "str",
                                                          "\"\"",
                                                          "\"\"")
    stmt.loweringMode = TypedExprLowerLocalAddress
    stmt.returnKind = TypedExprReturnDeferred
    stmt.returnRoot = false
    var declLocalDefiningNodeIndex = stmt.rhsNodeIndex
    if declLocalDefiningNodeIndex < 0:
        # [w24] nil-able 无初值声明(裸 `var n: Node` 家族)此前零值臂全落空:
        # 组 registered 却永不 consumed, 该局部首个精确 Identifier 读 panic
        # "exact local value-definition group unavailable"。补 detached 零值
        # 定义模板(机理与 fail-closed 契约见 helper 注释); 语句 rhs 保持
        # no_node, 后端 bare-default 零值发射不变。
        declLocalDefiningNodeIndex = typedExprIrAddNilZeroDeclarationLocalTemplate(
            ir, ctx, sourceContexts, scope, lineNumber, bindingType)
        if declLocalDefiningNodeIndex < 0:
            # [w24-agg] 同族第二臂: 按值复合(聚合/定长数组, TypeArena kind
            # Object / FixedArray)裸声明的零值臂同样全落空。判据、detached 载体
            # 与 fail-closed 契约见 helper 注释; seq/scalar 两臂与 nil-able 家族
            # 在此不可达(rhsNodeIndex 已非负或上一臂已命中)。
            declLocalDefiningNodeIndex = typedExprIrAddAggregateZeroDeclarationLocalTemplate(
                ir, ctx, scope, lineNumber, bindingName, bindingType)
    if declLocalDefiningNodeIndex >= 0:
        stmt.bindingTargetDefinitionRow = TypedExprIrConsumeDeclarationLocalValueDefinition(
            ir, bindingName, declLocalDefiningNodeIndex)
    TypedExprIrAppendStatement(ir, stmt)
    TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
    TypedExprIrAppendLocalBinding(ir,
                                  sourcePath,
                                  share(scope.name),
                                  lineNumber,
                                  bindingName,
                                  bindingType)

@borrows
fn TypedExprIrAppendLocalDeclStatementsForScope(ir: var TypedExprIr,
                                                 ctx: var TypedExprSourceContext,
                                                 sourceContexts: TypedExprSourceContext[],
                                                 scope: TypedExprFunctionScope) =
    if scope.startLine + 1 > scope.endLine:
        return
    for lineNumber in (scope.startLine + 1)..scope.endLine:
        let lineRaw = TypedExprSourceContextLineText(ctx, lineNumber)
        let trimmedLine = chengpath.PathTrim(lineRaw)
        if Len(trimmedLine) <= 0:
            continue
        # ParserStartsWith 松散匹配(尾空格当词边界):`constTypeKind != ...` 会误配
        # "const " 而进入 binding 解析,抽出垃圾绑定名(如 "ypeKind")建出 rhsNodeIndex<0
        # 的幻影 local_decl → no_node(多行 `if X!=A && X!=B && X!=C:` 续行被双计)。
        # 用 ParserStartsWithExact(保留尾空格,首标识符以关键字字母开头不再误配),
        # 同 00a5bf9a5 if/return strip 修复族。
        if !parser.ParserStartsWithExact(trimmedLine, "let ") &&
           !parser.ParserStartsWithExact(trimmedLine, "var ") &&
           !parser.ParserStartsWithExact(trimmedLine, "const "):
            continue
        var bindingName = ""
        var bindingType = ""
        var rhsStartColumn: int32 = -1
        if !TypedExprParseBindingLine(lineRaw, bindingName, bindingType, rhsStartColumn):
            continue
        # Initializers are parser-owned BindingInitializer roots and are
        # materialized by TypedExprIrAddAssignStatementFromExpr.  This source
        # walk is retained only for declarations with no value expression.
        if rhsStartColumn >= 0:
            continue
        if Len(bindingType) <= 0:
            panic(Fmt"typed expr: declaration without initializer has no explicit type source={ctx.sourcePath} line={lineNumber} binding={bindingName}")
        TypedExprIrAddLocalDeclStatement(ir,
                                         ctx,
                                         sourceContexts,
                                         share(scope),
                                         share(ctx.sourcePath),
                                         lineNumber,
                                         TypedExprLineIndentWidth(lineRaw),
                                         share(bindingName),
                                         share(bindingType))

@borrows
fn typedExprCheckedAdd64(left: int64,
                         right: int64,
                         operation: str): int64 =
    if left < 0 || right < 0 || left > 9223372036854775807 - right:
        panic(Fmt"typed expr: capacity add overflow operation={operation} left={left} right={right}")
    return left + right

@borrows
fn typedExprCheckedMul64(left: int64,
                         right: int64,
                         operation: str): int64 =
    if left < 0 || right < 0:
        panic(Fmt"typed expr: capacity multiply negative operation={operation} left={left} right={right}")
    if left != 0 && right > 9223372036854775807 / left:
        panic(Fmt"typed expr: capacity multiply overflow operation={operation} left={left} right={right}")
    return left * right

@borrows
fn typedExprCheckedInt32Capacity(value: int64, operation: str): int32 =
    if value < 0 || value > 2147483647:
        panic(Fmt"typed expr: capacity exceeds int32 operation={operation} value={value}")
    return Int32(value)

@borrows
fn typedExprCheckedAddInt32(left: int32,
                            right: int32,
                            operation: str): int32 =
    return typedExprCheckedInt32Capacity(
        typedExprCheckedAdd64(Int64(left), Int64(right), operation),
        operation)

fn typedExprContextDomainColumnCount(contextCount: int32): int32 =
    return typedExprCheckedInt32Capacity(
        typedExprCheckedMul64(Int64(contextCount), 8,
                              "context_domain_columns"),
        "context_domain_columns")

fn TypedExprBuildIndexBucketCount(itemCount: int32): int32 =
    if itemCount < 0:
        panic("typed expr: negative build-index bucket item count")
    var need = typedExprCheckedAdd64(
        typedExprCheckedMul64(Int64(itemCount), 2, "build_index_bucket_need"),
        16,
        "build_index_bucket_need")
    if need < 16:
        need = 16
    var out: int64 = 1
    while out < need:
        out = typedExprCheckedMul64(out, 2, "build_index_bucket_power")
        if out > 1073741824:
            panic("typed expr: build-index bucket count exceeds addressable sequence")
    return typedExprCheckedInt32Capacity(out, "build_index_bucket_count")

@borrows
fn TypedExprBuildIndexHashText(seedRaw: int64, text: str): int64 =
    var seed = seedRaw
    for i in 0..<text.len:
        seed = (seed * 16777619 + Int64(int32(text[i])) + 1) % 2147483647
    return (seed * 16777619 + 257) % 2147483647

@borrows
fn TypedExprBuildIndexHash4(first: str,
                             second: str,
                             third: str,
                             fourth: str): int32 =
    var seed: int64 = 2166136261
    seed = TypedExprBuildIndexHashText(seed, first)
    seed = TypedExprBuildIndexHashText(seed, second)
    seed = TypedExprBuildIndexHashText(seed, third)
    seed = TypedExprBuildIndexHashText(seed, fourth)
    return int32(seed)

@borrows
fn TypedExprBuildIndexHash2(first: str, second: str): int32 =
    return TypedExprBuildIndexHash4(first, second, "", "")

@borrows
fn typedExprBuildIndexCanonicalTextId(
        index: TypedExprBuildIndex,
        text: str): langintern.InternId =
    if index == nil || index.canonicalProjection == nil ||
       index.canonicalProjection.released ||
       index.canonicalProjection.internPool == nil:
        return langintern.InvalidInternId()
    return langintern.FindInternId(index.canonicalProjection.internPool, text)

# [D-B2a] Streaming-core canonical intern for the low-cardinality identity
# columns (kinds, source paths, origins, owner/layout type names): one owned
# payload per distinct text; every ordinary-mode column slot stores the shared
# handle instead of a per-row owned clone. High-cardinality semantic payload
# columns (names, details, fingerprints) stay per-row owned clones: their
# texts are near-unique, so interning them would add per-distinct pool
# overhead without dedup gain (measured: v1 all-column intern moved the
# pass-1 window the wrong way). The pool is created with a small entry limit
# and only grows if the identity set does; it is owned by the index and
# released with it, so the stored shared handles' lifetime stays inside the
# pool's.
@borrows
fn typedExprBuildIndexInternSharedText(index: TypedExprBuildIndex,
                                       text: str): str =
    if index.internPool == nil:
        index.internPool = langintern.InternPoolNew(512)
    let textId = langintern.Intern(index.internPool, text)
    return langintern.LookupInternShared(index.internPool, textId)

# [D-B2a] Column policy: only low-cardinality identity columns intern (the
# kinds and the source-path family, where tens of thousands of rows collapse
# onto a few hundred distinct texts).
@borrows
fn typedExprBuildIndexColumnInterns(columnId: int32): bool =
    return columnId == typedExprBuildIndexTextColumnEntryKind ||
           columnId == typedExprBuildIndexTextColumnEntrySourcePath ||
           columnId == typedExprBuildIndexTextColumnEntryOrigin ||
           columnId == typedExprBuildIndexTextColumnImportOwnerSourcePath ||
           columnId == typedExprBuildIndexTextColumnContextSourcePath

const
    typedExprBuildIndexTextColumnEntryKind: int32 = 1
    typedExprBuildIndexTextColumnEntrySourcePath: int32 = 2
    typedExprBuildIndexTextColumnEntryName: int32 = 3
    typedExprBuildIndexTextColumnEntryDetail: int32 = 4
    typedExprBuildIndexTextColumnEntryOrigin: int32 = 5
    typedExprBuildIndexTextColumnEntryFingerprint: int32 = 6
    typedExprBuildIndexTextColumnVisibilityKind: int32 = 7
    typedExprBuildIndexTextColumnVisibilitySourcePath: int32 = 8
    typedExprBuildIndexTextColumnVisibilityName: int32 = 9
    typedExprBuildIndexTextColumnVisibilityDetail: int32 = 10
    typedExprBuildIndexTextColumnVisibilityFingerprint: int32 = 11
    typedExprBuildIndexTextColumnImportOwnerSourcePath: int32 = 12
    typedExprBuildIndexTextColumnContentCacheKind: int32 = 13
    typedExprBuildIndexTextColumnContentCacheSourcePath: int32 = 14
    typedExprBuildIndexTextColumnContentCacheName: int32 = 15
    typedExprBuildIndexTextColumnContentCacheValue: int32 = 16
    typedExprBuildIndexTextColumnCallSourcePath: int32 = 17
    typedExprBuildIndexTextColumnCallName: int32 = 18
    typedExprBuildIndexTextColumnCallGenericName: int32 = 19
    typedExprBuildIndexTextColumnCallParamType: int32 = 20
    typedExprBuildIndexTextColumnCallReturnType: int32 = 21
    typedExprBuildIndexTextColumnCallTargetSymbol: int32 = 22
    typedExprBuildIndexTextColumnContextSourcePath: int32 = 23
    typedExprBuildIndexTextColumnContextFieldOwnerSourcePath: int32 = 24
    typedExprBuildIndexTextColumnContextFieldOwnerType: int32 = 25
    typedExprBuildIndexTextColumnLayoutSourcePath: int32 = 26
    typedExprBuildIndexTextColumnLayoutTypeName: int32 = 27
    typedExprBuildIndexTextColumnFieldOwnerSourcePath: int32 = 28
    typedExprBuildIndexTextColumnFieldOwnerType: int32 = 29

@borrows
fn typedExprBuildIndexAppendBorrowedText(
        index: TypedExprBuildIndex,
        columnId: int32,
        text: str) =
    var textId = langintern.InvalidInternId()
    var storedText: str
    let compact = index.canonicalProjection != nil
    if compact:
        textId = typedExprBuildIndexCanonicalTextId(index, text)
        if textId < 0:
            storedText = parser.ParserOwnedText(text)
    elif typedExprBuildIndexColumnInterns(columnId):
        # [D-B2a] canonical intern: shared handle into the index-owned pool
        # instead of a per-row owned clone (identity columns only).
        storedText = typedExprBuildIndexInternSharedText(index, text)
    else:
        storedText = parser.ParserOwnedText(text)
    if columnId == typedExprBuildIndexTextColumnEntryKind:
        if compact: add(index.entryKindIds, textId)
        add(index.entryKinds, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnEntrySourcePath:
        if compact: add(index.entrySourcePathIds, textId)
        add(index.entrySourcePaths, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnEntryName:
        if compact: add(index.entryNameIds, textId)
        add(index.entryNames, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnEntryDetail:
        if compact: add(index.entryDetailIds, textId)
        add(index.entryDetails, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnEntryOrigin:
        if compact: add(index.entryOriginIds, textId)
        add(index.entryOrigins, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnEntryFingerprint:
        if compact: add(index.entryFingerprintIds, textId)
        add(index.entryFingerprints, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnImportOwnerSourcePath:
        if compact: add(index.importOwnerSourcePathIds, textId)
        add(index.importOwnerSourcePaths, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnContextSourcePath:
        if compact: add(index.contextSourcePathIds, textId)
        add(index.contextSourcePaths, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnLayoutSourcePath:
        if compact: add(index.layoutSourcePathIds, textId)
        add(index.layoutSourcePaths, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnLayoutTypeName:
        if compact: add(index.layoutTypeNameIds, textId)
        add(index.layoutTypeNames, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnFieldOwnerSourcePath:
        if compact: add(index.fieldOwnerSourcePathIds, textId)
        add(index.fieldOwnerSourcePaths, storedText)
        return
    if columnId == typedExprBuildIndexTextColumnFieldOwnerType:
        if compact: add(index.fieldOwnerTypeIds, textId)
        add(index.fieldOwnerTypes, storedText)
        return
    panic(Fmt"typed expr: append borrowed text column unsupported column_id={columnId}")

@borrows
fn typedExprBuildIndexTextColumnFacts(
        index: TypedExprBuildIndex,
        columnId: int32,
        rowIndex: int32,
        compactCount: var int32,
        ordinaryCount: var int32,
        compactId: var langintern.InternId) =
    compactCount = 0
    ordinaryCount = 0
    compactId = langintern.InvalidInternId()
    if columnId == typedExprBuildIndexTextColumnEntryKind:
        compactCount = index.entryKindIds.len
        ordinaryCount = index.entryKinds.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.entryKindIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnEntrySourcePath:
        compactCount = index.entrySourcePathIds.len
        ordinaryCount = index.entrySourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.entrySourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnEntryName:
        compactCount = index.entryNameIds.len
        ordinaryCount = index.entryNames.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.entryNameIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnEntryDetail:
        compactCount = index.entryDetailIds.len
        ordinaryCount = index.entryDetails.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.entryDetailIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnEntryOrigin:
        compactCount = index.entryOriginIds.len
        ordinaryCount = index.entryOrigins.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.entryOriginIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnEntryFingerprint:
        compactCount = index.entryFingerprintIds.len
        ordinaryCount = index.entryFingerprints.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.entryFingerprintIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnVisibilityKind:
        compactCount = index.visibilityKindIds.len
        ordinaryCount = index.visibilityKinds.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.visibilityKindIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnVisibilitySourcePath:
        compactCount = index.visibilitySourcePathIds.len
        ordinaryCount = index.visibilitySourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.visibilitySourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnVisibilityName:
        compactCount = index.visibilityNameIds.len
        ordinaryCount = index.visibilityNames.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.visibilityNameIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnVisibilityDetail:
        compactCount = index.visibilityDetailIds.len
        ordinaryCount = index.visibilityDetails.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.visibilityDetailIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnVisibilityFingerprint:
        compactCount = index.visibilityFingerprintIds.len
        ordinaryCount = index.visibilityFingerprints.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.visibilityFingerprintIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnImportOwnerSourcePath:
        compactCount = index.importOwnerSourcePathIds.len
        ordinaryCount = index.importOwnerSourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.importOwnerSourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnContentCacheKind:
        compactCount = index.contentCacheKindIds.len
        ordinaryCount = index.contentCacheKinds.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.contentCacheKindIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnContentCacheSourcePath:
        compactCount = index.contentCacheSourcePathIds.len
        ordinaryCount = index.contentCacheSourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.contentCacheSourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnContentCacheName:
        compactCount = index.contentCacheNameIds.len
        ordinaryCount = index.contentCacheNames.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.contentCacheNameIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnContentCacheValue:
        compactCount = index.contentCacheValueIds.len
        ordinaryCount = index.contentCacheValues.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.contentCacheValueIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnCallSourcePath:
        compactCount = index.callDeclarationSourcePathIds.len
        ordinaryCount = index.callDeclarationSourcePaths.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.callDeclarationSourcePathIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnCallName:
        compactCount = index.callDeclarationNameIds.len
        ordinaryCount = index.callDeclarationNames.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.callDeclarationNameIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnCallGenericName:
        compactCount = index.callDeclarationGenericNameIds.len
        ordinaryCount = index.callDeclarationGenericNames.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.callDeclarationGenericNameIds[rowIndex]
        return
    if columnId == typedExprBuildIndexTextColumnCallParamType:
        compactCount = index.callDeclarationParamTypeIds.len
        ordinaryCount = index.callDeclarationParamTypes.len
        if rowIndex >= 0 && rowIndex < compactCount:
            compactId = index.callDeclarationParamTypeIds[rowIndex]
