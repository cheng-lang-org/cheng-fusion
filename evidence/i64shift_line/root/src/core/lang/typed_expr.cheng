fn TypedExprIrArenaOwnerRetainedBytes(ir: var TypedExprIr): int64 =
    if ir.arena.basePtr == nil:
        return 0
    if ir.arena.capacityBytes <= 0:
        return 0
    return Int64(ir.arena.capacityBytes)

@borrows
fn TypedExprIrCloneArenaArrayInt32(srcArena: arenamod.Arena,
                                    src: arenamod.ArenaArrayInt32,
                                    dstArena: var arenamod.Arena): arenamod.ArenaArrayInt32 =
    var out = arenamod.ArenaArrayInt32Init()
    if src.len <= 0:
        return out
    let cloneBytes = typedExprCheckedInt32Capacity(
        typedExprCheckedMul64(Int64(src.len), 4,
                              "arena_int32_clone_bytes"),
        "arena_int32_clone_bytes")
    let bytes = arenamod.ArenaAllocBytesAligned(dstArena, cloneBytes, 4)
    out.offset = bytes.offset
    out.len = src.len
    out.capacity = src.len
    out.generation = bytes.generation
    for i in 0..<src.len:
        arenamod.ArenaArrayInt32Set(dstArena,
                                    out,
                                    i,
                                    arenamod.ArenaArrayInt32Get(srcArena, src, i))
    return out

@borrows
fn TypedExprIrCloneReachableArenaColumns(ir: var TypedExprIr,
                                          out: var TypedExprIr) =
    let logicalBytes = TypedExprIrArenaLogicalLiveBytes(ir)
    if logicalBytes <= 0:
        return
    if logicalBytes > 2147483647:
        panic("typed expr: reachable arena clone exceeds int32 address space")
    out.arena = arenamod.ArenaInitDefault(Int32(logicalBytes))
    out.functions2_signatureLineNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_signatureLineNumbers, out.arena)
    out.functions2_endLineNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_endLineNumbers, out.arena)
    out.functions2_bodyLineNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_bodyLineNumbers, out.arena)
    out.functions2_statementStarts = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_statementStarts, out.arena)
    out.functions2_statementCounts = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_statementCounts, out.arena)
    out.functions2_scopeStarts = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_scopeStarts, out.arena)
    out.functions2_scopeCounts = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_scopeCounts, out.arena)
    out.functions2_nodeStarts = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_nodeStarts, out.arena)
    out.functions2_nodeCounts = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_nodeCounts, out.arena)
    out.functions2_returnNodeIndexs = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.functions2_returnNodeIndexs, out.arena)
    out.functions2_valueDefinitionStarts = TypedExprIrCloneArenaArrayInt32(
        ir.arena, ir.functions2_valueDefinitionStarts, out.arena)
    out.functions2_valueDefinitionCounts = TypedExprIrCloneArenaArrayInt32(
        ir.arena, ir.functions2_valueDefinitionCounts, out.arena)
    out.functions2_valueDefinitionGroupStarts = TypedExprIrCloneArenaArrayInt32(
        ir.arena, ir.functions2_valueDefinitionGroupStarts, out.arena)
    out.functions2_valueDefinitionGroupCounts = TypedExprIrCloneArenaArrayInt32(
        ir.arena, ir.functions2_valueDefinitionGroupCounts, out.arena)
    out.scopes2_scopeIds = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_scopeIds, out.arena)
    out.scopes2_parentScopeIds = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_parentScopeIds, out.arena)
    out.scopes2_ownerStatementOrdinals = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_ownerStatementOrdinals, out.arena)
    out.scopes2_lexicalOrdinals = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_lexicalOrdinals, out.arena)
    out.scopes2_startLineNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_startLineNumbers, out.arena)
    out.scopes2_startColumnNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_startColumnNumbers, out.arena)
    out.scopes2_endLineNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_endLineNumbers, out.arena)
    out.scopes2_endColumnNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.scopes2_endColumnNumbers, out.arena)
    out.statements2_statementIndexs = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.statements2_statementIndexs, out.arena)
    out.statements2_lineNumbers = TypedExprIrCloneArenaArrayInt32(ir.arena, ir.statements2_lineNumbers, out.arena)
