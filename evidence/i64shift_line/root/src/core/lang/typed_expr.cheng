fn TypedExprClearIrForMetadataRebuild(ir: var TypedExprIr,
                                       preserveTypeInfo: bool) =
    if !preserveTypeInfo:
        # The wrapper owns this short read lease.  Payload replacement must not
        # release it mid-transaction; detach it from the payload reset and put
        # the exact descriptor back for the structural consumer.
        let valueExprTree = ir.valueExprTree
        let valueExprTreeBorrowLease = ir.valueExprTreeBorrowLease
        ir.valueExprTree = nil
        ir.valueExprTreeBorrowLease = false
        TypedExprIrReleasePayload(ir)
        ir.internPool = langintern.InternPoolNew()
        ir.valueExprTree = valueExprTree
        ir.valueExprTreeBorrowLease = valueExprTreeBorrowLease
        return
    # combo C Phase2: clear the 87 IR-data SoA columns (producers write only SoA;
    # the AoS functions/nodes/statements arrays are removed in Phase2). Non-IR-data
    # metadata (coldCsg/global/localBinding/sourceContext/statementFunctionIndex)
    # is reset below — TypedExprIrClearSoAIRData does not touch it.
    TypedExprIrClearSoAIRData(ir)
    ir.coldCsgTypeRows = []
    ir.coldCsgStatementRows = []
    ir.globalSourcePaths = []
    ir.globalNames = []
    ir.globalTypes = []
    ir.globalProducerSourceIndexes = []
    ir.globalDeclarationSourceLocalRows = []
    ir.globalInitValues = []
    ir.localBindingSourcePaths = []
    ir.localBindingFunctionNames = []
    ir.localBindingLineNumbers = []
    ir.localBindingNames = []
    ir.localBindingTypes = []
    ir.localBindingNameIndexBucketHeads = []
    ir.localBindingNameIndexEntryNext = []
    ir.localBindingNameIndexEntryBindingIndexes = []
    ir.localBindingNameIndexEntryNames = []
    ir.localBindingNameIndexSealed = false
    # Keep importc, type layout, type field, alias, and enum metadata across reachability rounds.
    ir.sourceContextIndexSourcePaths = []
    ir.sourceContextIndexBucketHeads = []
    ir.sourceContextIndexEntryNext = []
    ir.sourceContextIndexEntryIndexes = []
    ir.statementFunctionIndexBucketHeads = []
    ir.statementFunctionIndexEntryNext = []
    ir.statementFunctionIndexEntryStatementIndexes = []
    ir.statementFunctionIndexEntryNames = []
    ir.statementFnBindingIndexBucketHeads = []
    ir.statementFnBindingIndexEntryNext = []
    ir.statementFnBindingIndexEntryStatementIndexes = []
    ir.statementFnBindingIndexEntryFunctionNames = []
    ir.statementFnBindingIndexEntryBindingNames = []
    ir.paramRefIndexBucketHeads = []
    ir.paramRefIndexEntryNext = []
    ir.paramRefIndexEntryNodeIndexes = []
    ir.paramRefIndexEntrySourcePaths = []
    ir.paramRefIndexEntryFunctionNames = []
    ir.paramRefIndexEntryParamNames = []
    ir.nodesTailOwnerSourcePathId = 0
    ir.nodesTailOwnerFunctionNameId = 0
    ir.nodesTailBlockStartNodeIndex = 0

@borrows
fn TypedExprSnapshotOnlyTargetName(callCalleeRaw: str,
                                   callTargetRaw: str): str =
    let callCallee = chengpath.PathTrim(callCalleeRaw)
    if callCallee != "":
        return callCallee
    let callTarget = chengpath.PathTrim(callTargetRaw)
    let callTargetLeaf = TypedExprQualifiedCallLeaf(callTarget)
    if callTargetLeaf != "":
        return callTargetLeaf
    return callTarget

@borrows
fn TypedExprSnapshotContextFunctionKey(contextIndex: int32,
                                        functionName: str): str =
    return Fmt"{contextIndex}:{functionName}"

@borrows
fn TypedExprSnapshotContextSignatureKey(contextIndex: int32,
                                         functionName: str,
                                         startLine: int32): str =
    return Fmt"{contextIndex}:{startLine}:{functionName}"

@borrows
fn TypedExprSnapshotContextIndexAddScope(index: var TypedExprSnapshotContextIndex,
                                         contextIndex: int32,
                                         scope: TypedExprFunctionScope,
                                         err: var str): bool =
    if scope.name == "" || scope.startLine <= 0 || scope.endLine < scope.startLine:
        err = Fmt" typed expr: snapshot-only function scope invalid context_index={contextIndex} function={scope.name} start={scope.startLine} end={scope.endLine}"
        return false
    let functionKey = TypedExprSnapshotContextFunctionKey(contextIndex, scope.name)
    let existingStartLine = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.functions,
                                                                                          functionKey)
    if existingStartLine >= 0:
        err = Fmt" typed expr: snapshot-only function scope duplicate or ambiguous context_index={contextIndex} function={scope.name} first_start={existingStartLine} next_start={scope.startLine}"
        return false
    parser.ParserSourcePathIndexLookupInsertExact(index.functions,
                                                  functionKey,
                                                  scope.startLine)
    err = ""
    return true

@borrows
fn TypedExprSnapshotContextIndexAddSignature(index: var TypedExprSnapshotContextIndex,
                                             contextIndex: int32,
                                             scope: TypedExprFunctionScope,
                                             err: var str): bool =
    if scope.name == "" || scope.startLine <= 0 || scope.endLine < scope.startLine:
        err = Fmt" typed expr: snapshot-only function signature invalid context_index={contextIndex} function={scope.name} start={scope.startLine} end={scope.endLine}"
        return false
    let signatureKey = TypedExprSnapshotContextSignatureKey(contextIndex,
                                                             scope.name,
                                                             scope.startLine)
    let existingSignature = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.signatures,
                                                                                          signatureKey)
    if existingSignature >= 0:
        err = Fmt" typed expr: snapshot-only function signature duplicate context_index={contextIndex} function={scope.name} start={scope.startLine}"
        return false
    parser.ParserSourcePathIndexLookupInsertExact(index.signatures,
                                                  signatureKey,
                                                  scope.startLine)
    err = ""
    return true

fn TypedExprBuildSnapshotContextIndex(contexts: var TypedExprSourceContext[],
                                       index: var TypedExprSnapshotContextIndex,
                                       err: var str): bool =
    index = TypedExprSnapshotContextIndex()
    if !TypedExprBuildSourceContextExactIndex(contexts, index.sources, err):
        return false
    var functionCount: int32
    var importcCount: int32
    for contextIndex in 0..<contexts.len:
        functionCount = typedExprCheckedAddInt32(
            functionCount,
            contexts[contextIndex].scopes.len,
            "snapshot_function_count")
        functionCount = typedExprCheckedAddInt32(
            functionCount,
            contexts[contextIndex].signatureScopes.len,
            "snapshot_function_count")
        importcCount = typedExprCheckedAddInt32(
            importcCount,
            typedExprCheckedInt32Capacity(
                typedExprCheckedMul64(
                    Int64(contexts[contextIndex].importcFunctions.len), 2,
                    "snapshot_importc_count"),
                "snapshot_importc_count"),
            "snapshot_importc_count")
    let functionCapacity = typedExprCheckedInt32Capacity(
        typedExprCheckedAdd64(
            typedExprCheckedMul64(Int64(functionCount), 2,
                                  "snapshot_function_capacity"),
            8, "snapshot_function_capacity"),
        "snapshot_function_capacity")
    index.functions = parser.ParserSourcePathIndexLookupInit(functionCapacity)
    index.signatures = parser.ParserSourcePathIndexLookupInit(functionCapacity)
    index.importcs = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(importcCount), 2,
                                      "snapshot_importc_capacity"),
                8, "snapshot_importc_capacity"),
            "snapshot_importc_capacity"))
    for contextIndex in 0..<contexts.len:
        for scopeIndex in 0..<contexts[contextIndex].scopes.len:
            if !TypedExprSnapshotContextIndexAddScope(index,
                                                      contextIndex,
                                                      contexts[contextIndex].scopes[scopeIndex],
                                                      err):
                return false
        for scopeIndex in 0..<contexts[contextIndex].signatureScopes.len:
            if !TypedExprSnapshotContextIndexAddSignature(index,
                                                          contextIndex,
                                                          contexts[contextIndex].signatureScopes[scopeIndex],
                                                          err):
                return false
        for importcIndex in 0..<contexts[contextIndex].importcFunctions.len:
            let importcFn = contexts[contextIndex].importcFunctions[importcIndex]
            if importcFn.name == "":
                err = Fmt" typed expr: snapshot-only importc declaration name missing context_index={contextIndex} importc_index={importcIndex} kind=declaration_importc"
                return false
            var importNames = [strings.CloneStr(importcFn.name)]
            if importcFn.importName != "" && importcFn.importName != importcFn.name:
                add(importNames, strings.CloneStr(importcFn.importName))
            for importNameIndex in 0..<importNames.len:
                let key = TypedExprSnapshotContextFunctionKey(contextIndex,
                                                               importNames[importNameIndex])
                let existingImportc = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.importcs,
                                                                                                    key)
                if existingImportc >= 0 && existingImportc != importcIndex:
                    err = Fmt" typed expr: snapshot-only importc declaration ambiguous context_index={contextIndex} name={importNames[importNameIndex]} first_index={existingImportc} next_index={importcIndex} kind=declaration_importc"
                    return false
                if existingImportc < 0:
                    parser.ParserSourcePathIndexLookupInsertExact(index.importcs,
                                                                  key,
                                                                  importcIndex)
    err = ""
    return true

@borrows
fn TypedExprValidateSnapshotOnlyCallTarget(sourceTexts: var TypedExprSourceText[],
                                            sourceIdentityIndex: var TypedExprSourceIdentityIndex,
                                            contexts: var TypedExprSourceContext[],
                                            contextIndex: TypedExprSnapshotContextIndex,
                                            ownerSourcePathRaw: str,
                                            targetSourcePathRaw: str,
                                            callCalleeRaw: str,
                                            callTargetRaw: str,
                                            targetImportc: bool,
                                            lineNumber: int32,
                                            err: var str): bool =
    if targetSourcePathRaw == "":
        return true
    var ownerSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         ownerSourcePathRaw,
                                         ownerSourceIndex,
                                         err):
        return false
    if ownerSourceIndex < 0 || ownerSourceIndex >= sourceTexts.len:
        err = Fmt" typed expr: snapshot-only imported call owner source missing owner={ownerSourcePathRaw} line={lineNumber}"
        return false
    if !sourceTexts[ownerSourceIndex].snapshotOnly:
        return true
    var targetSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         targetSourcePathRaw,
                                         targetSourceIndex,
                                         err):
        return false
    if targetSourceIndex < 0 || targetSourceIndex >= sourceTexts.len:
        err = Fmt" typed expr: snapshot-only imported call target source missing owner={ownerSourcePathRaw} target_source={targetSourcePathRaw} line={lineNumber}"
        return false
    if ownerSourceIndex == targetSourceIndex:
        return true
    var ownerSourcePath: str
    var targetSourcePath: str
    if !TypedExprLexicalSourcePath(sourceTexts[ownerSourceIndex].sourcePath,
                                   ownerSourcePath,
                                   err):
        return false
    if !TypedExprLexicalSourcePath(sourceTexts[targetSourceIndex].sourcePath,
                                   targetSourcePath,
                                   err):
        return false
    let targetContextIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextIndex.sources,
                                                                                          targetSourcePath)
    if targetContextIndex < 0 || targetContextIndex >= contexts.len:
        err = Fmt" typed expr: snapshot-only imported call target context missing owner={ownerSourcePath} target_source={targetSourcePath} line={lineNumber}"
        return false
    if !contexts[targetContextIndex].snapshotOnly:
        err = Fmt" typed expr: snapshot-only imported call target is not snapshot-only owner={ownerSourcePath} target_source={targetSourcePath} line={lineNumber}"
        return false
    let targetName = TypedExprSnapshotOnlyTargetName(callCalleeRaw, callTargetRaw)
    if targetName == "":
        err = Fmt" typed expr: snapshot-only imported call target name missing owner={ownerSourcePath} target_source={targetSourcePath} line={lineNumber}"
        return false
    if targetImportc:
        let importcKey = TypedExprSnapshotContextFunctionKey(targetContextIndex, targetName)
        if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextIndex.importcs,
                                                                        importcKey) < 0:
            err = Fmt" typed expr: snapshot-only imported call importc declaration missing owner={ownerSourcePath} target_source={targetSourcePath} target={targetName} line={lineNumber} kind=declaration_importc"
            return false
        return true
    let functionKey = TypedExprSnapshotContextFunctionKey(targetContextIndex, targetName)
    let targetStartLine = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextIndex.functions,
                                                                                       functionKey)
    if targetStartLine < 0:
        err = Fmt" typed expr: snapshot-only imported call scope missing owner={ownerSourcePath} target_source={targetSourcePath} target={targetName} line={lineNumber}"
        return false
    let signatureKey = TypedExprSnapshotContextSignatureKey(targetContextIndex,
                                                             targetName,
                                                             targetStartLine)
    if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextIndex.signatures,
                                                                    signatureKey) < 0:
        err = Fmt" typed expr: snapshot-only imported call signature missing owner={ownerSourcePath} target_source={targetSourcePath} target={targetName} start={targetStartLine} line={lineNumber}"
        return false
    return true

@borrows
fn typedExprFrozenSnapshotScopeNameRow(projection: typedExprFrozenMetadataProjection,
                                        contextIndex: int32,
                                        functionName: str): int32 =
    if projection == nil || projection.snapshotFunctionBucketHeads.len <= 0 ||
       functionName == "":
        return -1
    let hashValue = typedExprFrozenStructuredHash(contextIndex,
                                                   functionName,
                                                   0)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            projection.snapshotFunctionBucketHeads.len)
    var rowIndex = projection.snapshotFunctionBucketHeads[bucket]
    while rowIndex >= 0:
        if rowIndex >= projection.snapshotFunctionNext.len ||
           rowIndex >= projection.snapshotFunctionHashes.len ||
           rowIndex >= projection.scopes.nameIds.len:
            panic("typed expr: corrupt frozen snapshot function index")
        if projection.snapshotFunctionHashes[rowIndex] == hashValue &&
           typedExprFrozenScopeRowContextIndex(projection.scopes,
                                                rowIndex) == contextIndex &&
           typedExprFrozenProjectionText(projection,
                                          projection.scopes.nameIds[rowIndex]) == functionName:
            return rowIndex
        rowIndex = projection.snapshotFunctionNext[rowIndex]
    return -1

@borrows
fn typedExprFrozenSnapshotImportcRow(projection: typedExprFrozenMetadataProjection,
                                      contextIndex: int32,
                                      name: str): int32 =
    if projection == nil || projection.snapshotImportcBucketHeads.len <= 0 ||
       name == "":
        return -1
    let hashValue = typedExprFrozenStructuredHash(contextIndex, name, 0)
    let bucket = TypedExprBuildIndexBucket(hashValue,
                                            projection.snapshotImportcBucketHeads.len)
    var entryIndex = projection.snapshotImportcBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= projection.snapshotImportcNext.len ||
           entryIndex >= projection.snapshotImportcHashes.len ||
           entryIndex >= projection.snapshotImportcContextIndexes.len ||
           entryIndex >= projection.snapshotImportcNameIds.len ||
           entryIndex >= projection.snapshotImportcRowIndexes.len:
            panic("typed expr: corrupt frozen snapshot importc index")
        if projection.snapshotImportcHashes[entryIndex] == hashValue &&
           projection.snapshotImportcContextIndexes[entryIndex] == contextIndex &&
           typedExprFrozenProjectionText(projection,
                                          projection.snapshotImportcNameIds[entryIndex]) == name:
            return projection.snapshotImportcRowIndexes[entryIndex]
        entryIndex = projection.snapshotImportcNext[entryIndex]
    return -1

@borrows
fn typedExprValidateSnapshotOnlyCallTargetFrozen(
        sourceTexts: var TypedExprSourceText[],
        sourceIdentityIndex: var TypedExprSourceIdentityIndex,
        session: typedExprFrozenMetadataSession,
        ownerSourcePathRaw: str,
        targetSourcePathRaw: str,
        callCalleeRaw: str,
        callTargetRaw: str,
        targetImportc: bool,
        lineNumber: int32,
        err: var str): bool =
    if targetSourcePathRaw == "":
        return true
    var ownerSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         ownerSourcePathRaw,
                                         ownerSourceIndex,
                                         err):
        return false
    if ownerSourceIndex < 0 || ownerSourceIndex >= sourceTexts.len:
        err = Fmt" typed expr: snapshot-only imported call owner source missing owner={ownerSourcePathRaw} line={lineNumber}"
        return false
    if !sourceTexts[ownerSourceIndex].snapshotOnly:
        return true
    var targetSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         targetSourcePathRaw,
                                         targetSourceIndex,
                                         err):
        return false
    if targetSourceIndex < 0 || targetSourceIndex >= sourceTexts.len:
        err = Fmt" typed expr: snapshot-only imported call target source missing owner={ownerSourcePathRaw} target_source={targetSourcePathRaw} line={lineNumber}"
        return false
    if ownerSourceIndex == targetSourceIndex:
        return true
    var ownerSourcePath: str
    var targetSourcePath: str
    if !TypedExprLexicalSourcePath(sourceTexts[ownerSourceIndex].sourcePath,
                                   ownerSourcePath,
                                   err) ||
       !TypedExprLexicalSourcePath(sourceTexts[targetSourceIndex].sourcePath,
                                   targetSourcePath,
                                   err):
        return false
    let projection = session.projection
    let targetContextIndex = typedExprFrozenContextIndexForPath(projection,
                                                                 targetSourcePath)
    if targetContextIndex < 0 || targetContextIndex >= projection.snapshotOnly.len:
        err = Fmt" typed expr: snapshot-only imported call target context missing owner={ownerSourcePath} target_source={targetSourcePath} line={lineNumber}"
        return false
    if !projection.snapshotOnly[targetContextIndex]:
        err = Fmt" typed expr: snapshot-only imported call target is not snapshot-only owner={ownerSourcePath} target_source={targetSourcePath} line={lineNumber}"
        return false
    let targetName = TypedExprSnapshotOnlyTargetName(callCalleeRaw,
                                                      callTargetRaw)
    if targetName == "":
        err = Fmt" typed expr: snapshot-only imported call target name missing owner={ownerSourcePath} target_source={targetSourcePath} line={lineNumber}"
        return false
    if targetImportc:
        if typedExprFrozenSnapshotImportcRow(projection,
                                             targetContextIndex,
                                             targetName) < 0:
            err = Fmt" typed expr: snapshot-only imported call importc declaration missing owner={ownerSourcePath} target_source={targetSourcePath} target={targetName} line={lineNumber} kind=declaration_importc"
            return false
        return true
    let scopeRow = typedExprFrozenSnapshotScopeNameRow(projection,
                                                        targetContextIndex,
                                                        targetName)
    if scopeRow < 0:
        err = Fmt" typed expr: snapshot-only imported call scope missing owner={ownerSourcePath} target_source={targetSourcePath} target={targetName} line={lineNumber}"
        return false
    let targetStartLine = projection.scopes.startLines[scopeRow]
    if typedExprFrozenScopeRowLookup(projection,
                                     projection.signatures,
                                     projection.signatureBucketHeads,
                                     projection.signatureNext,
                                     projection.signatureHashes,
                                     targetContextIndex,
                                     targetName,
                                     targetStartLine) < 0:
        err = Fmt" typed expr: snapshot-only imported call signature missing owner={ownerSourcePath} target_source={targetSourcePath} target={targetName} start={targetStartLine} line={lineNumber}"
        return false
    return true

@borrows
fn typedExprValidateSnapshotOnlyIrInputsFrozen(
        sourceTexts: var TypedExprSourceText[],
        session: typedExprFrozenMetadataSession,
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        filterActive: bool,
        filterSourcePaths: str[],
        filterFunctionNames: str[],
        filterStartLines: int32[],
        err: var str): bool =
    if !TypedExprSourceTextsSnapshotOnly(sourceTexts):
        err = ""
        return true
    var sourceIdentityIndex: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(sourceTexts,
                                          sourceIdentityIndex,
                                          err):
        return false
    let projection = session.projection
    for sourceIndex in 0..<sourceTexts.len:
        if !sourceTexts[sourceIndex].snapshotOnly:
            continue
        if sourceTexts[sourceIndex].text == "":
            err = Fmt" typed expr: snapshot-only source body missing source={sourceTexts[sourceIndex].sourcePath} index={sourceIndex}"
            return false
        var sourcePath: str
        if !TypedExprLexicalSourcePath(sourceTexts[sourceIndex].sourcePath,
                                       sourcePath,
                                       err):
            return false
        let contextIndex = typedExprFrozenContextIndexForPath(projection,
                                                               sourcePath)
        if contextIndex < 0:
            err = Fmt" typed expr: snapshot-only metadata context missing source={sourceTexts[sourceIndex].sourcePath}"
            return false
        if !projection.snapshotOnly[contextIndex]:
            err = Fmt" typed expr: snapshot-only metadata contract missing source={sourceTexts[sourceIndex].sourcePath} context_index={contextIndex}"
            return false
        if projection.scopes.contextCounts[contextIndex] <= 0 &&
           projection.importcs.contextCounts[contextIndex] <= 0:
            err = Fmt" typed expr: snapshot-only declaration table missing source={sourceTexts[sourceIndex].sourcePath} context_index={contextIndex} kind=function_or_declaration_importc"
            return false
    if filterActive:
        if filterSourcePaths.len != filterFunctionNames.len ||
           filterStartLines.len != filterFunctionNames.len:
            err = Fmt" typed expr: snapshot-only function filter columns mismatch sources={filterSourcePaths.len} functions={filterFunctionNames.len} starts={filterStartLines.len}"
            return false
        for filterIndex in 0..<filterFunctionNames.len:
            var filterSourceIndex: int32
            if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                                 filterSourcePaths[filterIndex],
                                                 filterSourceIndex,
                                                 err) ||
               filterSourceIndex < 0 || filterSourceIndex >= sourceTexts.len:
                err = Fmt" typed expr: snapshot-only filter source missing source={filterSourcePaths[filterIndex]} function={filterFunctionNames[filterIndex]} line={filterStartLines[filterIndex]}"
                return false
            if !sourceTexts[filterSourceIndex].snapshotOnly:
                continue
            var filterSourcePath: str
            if !TypedExprLexicalSourcePath(sourceTexts[filterSourceIndex].sourcePath,
                                           filterSourcePath,
                                           err):
                return false
            let contextIndex = typedExprFrozenContextIndexForPath(
                projection,
                filterSourcePath)
            let scopeRow = typedExprFrozenSnapshotScopeNameRow(projection,
                                                                contextIndex,
                                                                filterFunctionNames[filterIndex])
            var actualStart: int32 = -1
            if scopeRow >= 0:
                actualStart = projection.scopes.startLines[scopeRow]
            if scopeRow < 0 || actualStart != filterStartLines[filterIndex]:
                err = Fmt" typed expr: snapshot-only filter scope missing or mismatched source={filterSourcePaths[filterIndex]} function={filterFunctionNames[filterIndex]} expected_start={filterStartLines[filterIndex]} actual_start={actualStart}"
                return false
            if typedExprFrozenScopeRowLookup(projection,
                                             projection.signatures,
                                             projection.signatureBucketHeads,
                                             projection.signatureNext,
                                             projection.signatureHashes,
                                             contextIndex,
                                             filterFunctionNames[filterIndex],
                                             filterStartLines[filterIndex]) < 0:
                err = Fmt" typed expr: snapshot-only signature missing source={filterSourcePaths[filterIndex]} function={filterFunctionNames[filterIndex]} line={filterStartLines[filterIndex]}"
                return false
    for exprIndex in 0..<exprLayer.exprs.len:
        let expr = exprLayer.exprs[exprIndex]
        if !typedExprValidateSnapshotOnlyCallTargetFrozen(sourceTexts,
                                                          sourceIdentityIndex,
                                                          session,
                                                          expr.sourcePath,
                                                          expr.callTargetSourcePath,
                                                          expr.callCallee,
                                                          expr.callTarget,
                                                          expr.callTargetImportc,
                                                          expr.lineNumber,
                                                          err):
            return false
    for factIndex in 0..<facts.count:
        let fact = TypedExprFactAt(facts, factIndex)
        if !typedExprValidateSnapshotOnlyCallTargetFrozen(sourceTexts,
                                                          sourceIdentityIndex,
                                                          session,
                                                          fact.sourcePath,
                                                          fact.callTargetSourcePath,
                                                          fact.callCallee,
                                                          fact.callTarget,
                                                          fact.callTargetImportc,
                                                          fact.lineNumber,
                                                          err):
            return false
    err = ""
    return true

@borrows
fn typedExprValidateSnapshotOnlyIrInputsImpl(sourceTexts: var TypedExprSourceText[],
                                             metadataContexts: var TypedExprSourceContext[],
                                             facts: var TypedExprFactTable,
                                             exprLayer: var parser.NormalizedExprLayer,
                                             filterActive: bool,
                                             filterSourcePaths: str[],
                                             filterFunctionNames: str[],
                                             filterStartLines: int32[],
                                             err: var str): bool =
    if !TypedExprSourceTextsSnapshotOnly(sourceTexts):
        err = ""
        return true
    var sourceIdentityIndex: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(sourceTexts,
                                          sourceIdentityIndex,
                                          err):
        return false
    var snapshotContextIndex: TypedExprSnapshotContextIndex
    if !TypedExprBuildSnapshotContextIndex(metadataContexts,
                                           snapshotContextIndex,
                                           err):
        return false
    for sourceIndex in 0..<sourceTexts.len:
        if !sourceTexts[sourceIndex].snapshotOnly:
            continue
        if sourceTexts[sourceIndex].text == "":
            err = Fmt" typed expr: snapshot-only source body missing source={sourceTexts[sourceIndex].sourcePath} index={sourceIndex}"
            return false
        var sourcePath: str
        if !TypedExprLexicalSourcePath(sourceTexts[sourceIndex].sourcePath,
                                       sourcePath,
                                       err):
            return false
        let contextIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(snapshotContextIndex.sources,
                                                                                        sourcePath)
        if contextIndex < 0:
            err = Fmt" typed expr: snapshot-only metadata context missing source={sourceTexts[sourceIndex].sourcePath}"
            return false
        if !metadataContexts[contextIndex].snapshotOnly:
            err = Fmt" typed expr: snapshot-only metadata contract missing source={sourceTexts[sourceIndex].sourcePath} context_index={contextIndex}"
            return false
        if metadataContexts[contextIndex].scopes.len <= 0 &&
           metadataContexts[contextIndex].importcFunctions.len <= 0:
            err = Fmt" typed expr: snapshot-only declaration table missing source={sourceTexts[sourceIndex].sourcePath} context_index={contextIndex} kind=function_or_declaration_importc"
            return false
    if filterActive:
        if filterSourcePaths.len != filterFunctionNames.len ||
           filterStartLines.len != filterFunctionNames.len:
            err = Fmt" typed expr: snapshot-only function filter columns mismatch sources={filterSourcePaths.len} functions={filterFunctionNames.len} starts={filterStartLines.len}"
            return false
        for filterIndex in 0..<filterFunctionNames.len:
            var filterSourceIndex: int32
            if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                                 filterSourcePaths[filterIndex],
                                                 filterSourceIndex,
                                                 err):
                return false
            if filterSourceIndex < 0 || filterSourceIndex >= sourceTexts.len:
                err = Fmt" typed expr: snapshot-only filter source missing source={filterSourcePaths[filterIndex]} function={filterFunctionNames[filterIndex]} line={filterStartLines[filterIndex]}"
                return false
            if !sourceTexts[filterSourceIndex].snapshotOnly:
                continue
            var filterSourcePath: str
            if !TypedExprLexicalSourcePath(sourceTexts[filterSourceIndex].sourcePath,
                                           filterSourcePath,
                                           err):
                return false
            let contextIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(snapshotContextIndex.sources,
                                                                                            filterSourcePath)
            if contextIndex < 0:
                err = Fmt" typed expr: snapshot-only signature context missing source={filterSourcePaths[filterIndex]} function={filterFunctionNames[filterIndex]} line={filterStartLines[filterIndex]}"
                return false
            let functionKey = TypedExprSnapshotContextFunctionKey(contextIndex,
                                                                   filterFunctionNames[filterIndex])
            let scopeStartLine = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(snapshotContextIndex.functions,
                                                                                              functionKey)
            if scopeStartLine != filterStartLines[filterIndex]:
                err = Fmt" typed expr: snapshot-only filter scope missing or mismatched source={filterSourcePaths[filterIndex]} function={filterFunctionNames[filterIndex]} expected_start={filterStartLines[filterIndex]} actual_start={scopeStartLine}"
                return false
            let signatureKey = TypedExprSnapshotContextSignatureKey(contextIndex,
                                                                     filterFunctionNames[filterIndex],
                                                                     filterStartLines[filterIndex])
            if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(snapshotContextIndex.signatures,
                                                                            signatureKey) < 0:
                err = Fmt" typed expr: snapshot-only signature missing source={filterSourcePaths[filterIndex]} function={filterFunctionNames[filterIndex]} line={filterStartLines[filterIndex]}"
                return false
    for exprIndex in 0..<exprLayer.exprs.len:
        let expr = exprLayer.exprs[exprIndex]
        if !TypedExprValidateSnapshotOnlyCallTarget(sourceTexts,
                                                     sourceIdentityIndex,
                                                     metadataContexts,
                                                     snapshotContextIndex,
                                                     expr.sourcePath,
                                                     expr.callTargetSourcePath,
                                                     expr.callCallee,
                                                     expr.callTarget,
                                                     expr.callTargetImportc,
                                                     expr.lineNumber,
                                                     err):
            return false
    for factIndex in 0..<facts.count:
        let fact = TypedExprFactAt(facts, factIndex)
        if !TypedExprValidateSnapshotOnlyCallTarget(sourceTexts,
                                                     sourceIdentityIndex,
                                                     metadataContexts,
                                                     snapshotContextIndex,
                                                     fact.sourcePath,
                                                     fact.callTargetSourcePath,
                                                     fact.callCallee,
                                                     fact.callTarget,
                                                     fact.callTargetImportc,
                                                     fact.lineNumber,
                                                     err):
            return false
    err = ""
    return true

@borrows
fn TypedExprValidateSnapshotOnlyIrInputs(sourceTexts: var TypedExprSourceText[],
                                         metadataContexts: var TypedExprSourceContext[],
                                         facts: var TypedExprFactTable,
                                         exprLayer: var parser.NormalizedExprLayer,
                                         filterActive: bool,
                                         filterSourcePaths: str[],
                                         filterFunctionNames: str[],
                                         filterStartLines: int32[],
                                         err: var str): bool =
    return typedExprValidateSnapshotOnlyIrInputsImpl(sourceTexts,
                                                     metadataContexts,
                                                     facts,
                                                     exprLayer,
                                                     filterActive,
                                                     filterSourcePaths,
                                                     filterFunctionNames,
                                                     filterStartLines,
                                                     err)

fn typedExprReleaseFrozenRoundContexts(contexts: var TypedExprSourceContext[]) =
    for contextIndex in 0..<contexts.len:
        TypedExprSourceContextReleaseMovedSourceStorage(
            contexts[contextIndex])
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(), "O8SITE=release_round_ctx")
        TypedExprClearSourceContextAllFields(contexts[contextIndex])
    contexts = []

fn TypedExprFunctionSourceRangeSetInit(expectedRowCount: int32): TypedExprFunctionSourceRangeSet =
    if expectedRowCount < 0:
        panic("typed expr: negative function source range capacity")
    var out: TypedExprFunctionSourceRangeSet
    out.expectedRowCount = expectedRowCount
    reserve(out.sourcePaths, expectedRowCount)
    reserve(out.functionNames, expectedRowCount)
    reserve(out.functionStartLines, expectedRowCount)
    reserve(out.functionEndLines, expectedRowCount)
    reserve(out.sourceContextIndexes, expectedRowCount)
    reserve(out.functionScopeIndexes, expectedRowCount)
    reserve(out.sourceScopeRootIndexes, expectedRowCount)
    reserve(out.exprPhysicalStarts, expectedRowCount)
    reserve(out.exprCounts, expectedRowCount)
    reserve(out.factPhysicalStarts, expectedRowCount)
    reserve(out.factCounts, expectedRowCount)
    reserve(out.scopeStarts, expectedRowCount)
    reserve(out.scopeCounts, expectedRowCount)
    reserve(out.statementStarts, expectedRowCount)
    reserve(out.statementCounts, expectedRowCount)
    return out

@borrows
fn TypedExprFunctionSourceRangeSetAppend(
        ranges: var TypedExprFunctionSourceRangeSet,
        sourcePath: str,
        functionName: str,
        functionStartLine: int32,
        functionEndLine: int32,
        sourceContextIndex: int32,
        functionScopeIndex: int32,
        sourceScopeRootIndex: int32,
        exprStart: int32,
        exprCount: int32,
        factStart: int32,
        factCount: int32,
        scopeStart: int32,
        scopeCount: int32,
        statementStart: int32,
        statementCount: int32) =
    if ranges.sealed:
        panic("typed expr: function source range append after seal")
    if ranges.sourcePaths.len >= ranges.expectedRowCount:
        panic("typed expr: function source range append exceeds reserve")
    if ranges.sourcePaths.cap < ranges.expectedRowCount ||
       ranges.functionNames.cap < ranges.expectedRowCount ||
       ranges.functionStartLines.cap < ranges.expectedRowCount ||
       ranges.functionEndLines.cap < ranges.expectedRowCount ||
       ranges.sourceContextIndexes.cap < ranges.expectedRowCount ||
       ranges.functionScopeIndexes.cap < ranges.expectedRowCount ||
       ranges.sourceScopeRootIndexes.cap < ranges.expectedRowCount ||
       ranges.exprPhysicalStarts.cap < ranges.expectedRowCount ||
       ranges.exprCounts.cap < ranges.expectedRowCount ||
       ranges.factPhysicalStarts.cap < ranges.expectedRowCount ||
       ranges.factCounts.cap < ranges.expectedRowCount ||
       ranges.scopeStarts.cap < ranges.expectedRowCount ||
       ranges.scopeCounts.cap < ranges.expectedRowCount ||
       ranges.statementStarts.cap < ranges.expectedRowCount ||
       ranges.statementCounts.cap < ranges.expectedRowCount:
        panic("typed expr: function source range reserve drift")
    add(ranges.sourcePaths, share(sourcePath))
    add(ranges.functionNames, share(functionName))
    add(ranges.functionStartLines, functionStartLine)
    add(ranges.functionEndLines, functionEndLine)
    add(ranges.sourceContextIndexes, sourceContextIndex)
    add(ranges.functionScopeIndexes, functionScopeIndex)
    add(ranges.sourceScopeRootIndexes, sourceScopeRootIndex)
    add(ranges.exprPhysicalStarts, exprStart)
    add(ranges.exprCounts, exprCount)
    add(ranges.factPhysicalStarts, factStart)
    add(ranges.factCounts, factCount)
    add(ranges.scopeStarts, scopeStart)
    add(ranges.scopeCounts, scopeCount)
    add(ranges.statementStarts, statementStart)
    add(ranges.statementCounts, statementCount)

fn TypedExprFunctionSourceRangeSetSeal(ranges: var TypedExprFunctionSourceRangeSet) =
    if ranges.sealed:
        panic("typed expr: duplicate function source range seal")
    if ranges.sourcePaths.len != ranges.expectedRowCount:
        panic(Fmt"typed expr: incomplete function source range set rows={ranges.sourcePaths.len} expected={ranges.expectedRowCount}")
    ranges.sealed = true

fn typedExprFunctionSourceRangeColumnsComplete(
        ranges: var TypedExprFunctionSourceRangeSet): bool =
    let rowCount = ranges.sourcePaths.len
    return ranges.functionNames.len == rowCount &&
           ranges.functionStartLines.len == rowCount &&
           ranges.functionEndLines.len == rowCount &&
           ranges.sourceContextIndexes.len == rowCount &&
           ranges.functionScopeIndexes.len == rowCount &&
           ranges.sourceScopeRootIndexes.len == rowCount &&
           ranges.exprPhysicalStarts.len == rowCount &&
           ranges.exprCounts.len == rowCount &&
           ranges.factPhysicalStarts.len == rowCount &&
           ranges.factCounts.len == rowCount &&
           ranges.scopeStarts.len == rowCount &&
           ranges.scopeCounts.len == rowCount &&
           ranges.statementStarts.len == rowCount &&
           ranges.statementCounts.len == rowCount

fn typedExprFunctionSourceRangeEnd(start: int32,
                                    count: int32,
                                    domain: str,
                                    err: var str): int32 =
    if start < 0 || count < 0 || Int64(start) + Int64(count) > Int64(2147483647):
        err = Fmt" typed expr: function source {domain} range invalid start={start} count={count}"
        return -1
    return start + count

fn typedExprFunctionSourceRangeLocalScopeId(sourceScopeId: int32,
                                             scopeStart: int32,
                                             scopeCount: int32): int32 =
    if sourceScopeId == 0:
        return 0
    if sourceScopeId < scopeStart || sourceScopeId >= scopeStart + scopeCount:
        panic("typed expr: source scope escaped preflighted function range")
    return sourceScopeId - scopeStart + 1

fn typedExprFunctionSourceRangeLocalStatementOrdinal(
        sourceOrdinal: int32,
        statementStart: int32,
        statementCount: int32): int32 =
    if sourceOrdinal < 0:
        return -1
    if sourceOrdinal < statementStart ||
       sourceOrdinal >= statementStart + statementCount:
        panic("typed expr: source statement escaped preflighted function range")
    return sourceOrdinal - statementStart

@borrows
fn typedExprFunctionBindingPlanKey(contextIndex: int32,
                                    functionName: str,
                                    functionStartLine: int32): str =
    return Fmt"{contextIndex}:{functionStartLine}:{functionName}"

@borrows
fn typedExprBindingIdentityKey(binding: TypedExprBinding): str =
    var globalValue: int32
    if binding.globalFlag:
        globalValue = 1
    return Fmt"{binding.sourcePath.len}:{binding.sourcePath}:{binding.functionName.len}:{binding.functionName}:{binding.lineNumber}:{globalValue}:{binding.name.len}:{binding.name}:{binding.typeText.len}:{binding.typeText}:{binding.initValueText.len}:{binding.initValueText}"

fn typedExprFunctionBindingPlanBuild(
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        plan: var typedExprFunctionBindingPlan,
        report: var TypedExprFunctionSourceRangeBuildReport,
        err: var str): bool =
    plan = typedExprFunctionBindingPlan()
    setLen(plan.rowStarts, ranges.sourcePaths.len)
    setLen(plan.rowCounts, ranges.sourcePaths.len)
    var firstRows: int32[]
    var seenContexts: bool[]
    var stableBindingCapacity: int64
    setLen(firstRows, sourceContexts.len)
    setLen(seenContexts, sourceContexts.len)
    for contextIndex in 0..<firstRows.len:
        firstRows[contextIndex] = -1
    let rowLookupCapacity = typedExprCheckedInt32Capacity(
        typedExprCheckedAdd64(
            typedExprCheckedMul64(Int64(ranges.sourcePaths.len), 2,
                                  "function_binding_row_lookup_capacity"),
            8, "function_binding_row_lookup_capacity"),
        "function_binding_row_lookup_capacity")
    var rowLookup = parser.ParserSourcePathIndexLookupInit(rowLookupCapacity)
    for rowIndex in 0..<ranges.sourcePaths.len:
        let contextIndex = ranges.sourceContextIndexes[rowIndex]
        if firstRows[contextIndex] < 0:
            firstRows[contextIndex] = rowIndex
            stableBindingCapacity = typedExprCheckedAdd64(
                stableBindingCapacity,
                Int64(sourceContexts[contextIndex].bindings.len),
                "function_binding_identity_capacity")
        let key = typedExprFunctionBindingPlanKey(
            contextIndex,
            ranges.functionNames[rowIndex],
            ranges.functionStartLines[rowIndex])
        if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                rowLookup, key) >= 0:
            err = Fmt" typed expr: bounded binding plan has duplicate function identity context={contextIndex} function={ranges.functionNames[rowIndex]}"
            return false
        parser.ParserSourcePathIndexLookupInsertExact(rowLookup, key, rowIndex)

    let identityLookupCapacity = typedExprCheckedInt32Capacity(
        typedExprCheckedAdd64(
            typedExprCheckedMul64(stableBindingCapacity, 2,
                                  "function_binding_identity_capacity"),
            8, "function_binding_identity_capacity"),
        "function_binding_identity_capacity")
    plan.identityLookup =
        parser.ParserSourcePathIndexLookupInit(identityLookupCapacity)

    var targetRows: int32[]
    var contextIndexes: int32[]
    var bindingIndexes: int32[]
    for rangeRowIndex in 0..<ranges.sourceContextIndexes.len:
        let contextIndex = ranges.sourceContextIndexes[rangeRowIndex]
        if seenContexts[contextIndex]:
            continue
        seenContexts[contextIndex] = true
        report.sourceBindingIndexBuildCount =
            report.sourceBindingIndexBuildCount + 1
        for bindingIndex in 0..<sourceContexts[contextIndex].bindings.len:
            report.bindingIndexBuildVisitCount =
                report.bindingIndexBuildVisitCount + Int64(1)
            let binding = sourceContexts[contextIndex].bindings[bindingIndex]
            if binding.sourcePath != ranges.sourcePaths[rangeRowIndex]:
                err = Fmt" typed expr: bounded binding source identity drift context={contextIndex} binding={bindingIndex} source={binding.sourcePath}"
                return false
            let identityKey = typedExprBindingIdentityKey(binding)
            if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                    plan.identityLookup, identityKey) >= 0:
                err = Fmt" typed expr: duplicate stable bounded binding context={contextIndex} binding={bindingIndex} function={binding.functionName} line={binding.lineNumber} name={binding.name}"
                return false
            parser.ParserSourcePathIndexLookupInsertExact(
                plan.identityLookup, identityKey, bindingIndex)
            var targetRow = firstRows[contextIndex]
            if !binding.globalFlag:
                let bindingScopeIndex = TypedExprScopeIndexForLine(
                    sourceContexts[contextIndex].scopes,
                    binding.lineNumber)
                if bindingScopeIndex < 0:
                    err = Fmt" typed expr: bounded binding scope missing context={contextIndex} binding={bindingIndex} function={binding.functionName} line={binding.lineNumber}"
                    return false
                let bindingScope =
                    sourceContexts[contextIndex].scopes[bindingScopeIndex]
                if bindingScope.name != binding.functionName:
                    err = Fmt" typed expr: bounded binding scope identity drift context={contextIndex} binding={bindingIndex} function={binding.functionName} scope_function={bindingScope.name} line={binding.lineNumber}"
                    return false
                let key = typedExprFunctionBindingPlanKey(
                    contextIndex,
                    binding.functionName,
                    bindingScope.startLine)
                targetRow =
                    parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                        rowLookup, key)
                if targetRow < 0 || binding.lineNumber < ranges.functionStartLines[targetRow] ||
                   binding.lineNumber > ranges.functionEndLines[targetRow] ||
                   bindingScope.endLine != ranges.functionEndLines[targetRow]:
                    err = Fmt" typed expr: bounded binding function identity missing context={contextIndex} binding={bindingIndex} function={binding.functionName} line={binding.lineNumber}"
                    return false
            if targetRow < 0 || targetRow >= ranges.sourcePaths.len:
                err = Fmt" typed expr: bounded binding target row missing context={contextIndex} binding={bindingIndex}"
                return false
            add(targetRows, targetRow)
            add(contextIndexes, contextIndex)
            add(bindingIndexes, bindingIndex)
            plan.rowCounts[targetRow] = plan.rowCounts[targetRow] + 1
    var bindingStart: int32
    for rowIndex in 0..<plan.rowCounts.len:
        plan.rowStarts[rowIndex] = bindingStart
        bindingStart = bindingStart + plan.rowCounts[rowIndex]
    setLen(plan.contextIndexes, bindingStart)
    setLen(plan.bindingIndexes, bindingStart)
    # rowStarts is durable plan metadata. Cheng sequence assignment moves or
    # aliases the backing storage; filling cursors through such an alias would
    # rewrite rowStarts into row ends and make commit read past the plan arrays.
    var writeCursors: int32[]
    reserve(writeCursors, Int32(plan.rowStarts.len))
    for rowIndex in 0..<plan.rowStarts.len:
        add(writeCursors, plan.rowStarts[rowIndex])
    for bindingPosition in 0..<targetRows.len:
        report.bindingIndexFillVisitCount =
            report.bindingIndexFillVisitCount + Int64(1)
        let targetRow = targetRows[bindingPosition]
        let writeIndex = writeCursors[targetRow]
        plan.contextIndexes[writeIndex] = contextIndexes[bindingPosition]
        plan.bindingIndexes[writeIndex] = bindingIndexes[bindingPosition]
        writeCursors[targetRow] = writeIndex + 1
    plan.stableBindingCount = bindingStart
    err = ""
    return true

fn typedExprFunctionSourceRangePreflight(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        filterIndex: var TypedExprFunctionFilterIndex,
        bindingPlan: var typedExprFunctionBindingPlan,
        report: var TypedExprFunctionSourceRangeBuildReport,
        err: var str): bool =
    report = TypedExprFunctionSourceRangeBuildReport()
    report.fullSourceScopeRescanCount = 0
    report.fullSourceLineRescanCount = 0
    report.perRowFullSourceBindingRescanCount = 0
    if !ranges.sealed || !typedExprFunctionSourceRangeColumnsComplete(ranges) ||
       ranges.expectedRowCount != ranges.sourcePaths.len:
        err = Fmt" typed expr: function source range set is not sealed and complete rows={ranges.sourcePaths.len} expected={ranges.expectedRowCount} sealed={ranges.sealed}"
        return false
    if ranges.sourcePaths.len <= 0:
        err = " typed expr: function source range set is empty"
        return false
    if !TypedExprBuildFunctionFilterIndex(sourceTexts,
                                          true,
                                          ranges.sourcePaths,
                                          ranges.functionNames,
                                          ranges.functionStartLines,
                                          filterIndex,
                                          err):
        return false
    var seenContexts: bool[]
    setLen(seenContexts, sourceContexts.len)
    var sourceScopeTotals: int32[]
    setLen(sourceScopeTotals, sourceContexts.len)
    for rangeMetadataIndex in 0..<ranges.sourcePaths.len:
        let rangeContextIndex = ranges.sourceContextIndexes[rangeMetadataIndex]
        report.preflightRangeMetadataVisitCount =
            report.preflightRangeMetadataVisitCount + Int64(1)
        if rangeContextIndex < 0 || rangeContextIndex >= sourceContexts.len ||
           ranges.scopeStarts[rangeMetadataIndex] < 0 ||
           ranges.scopeCounts[rangeMetadataIndex] < 0 ||
           Int64(ranges.scopeStarts[rangeMetadataIndex]) +
               Int64(ranges.scopeCounts[rangeMetadataIndex]) >
                   Int64(2147483647):
            err = Fmt" typed expr: function source range metadata invalid row={rangeMetadataIndex} context={rangeContextIndex}"
            return false
        let rangeScopeEnd = ranges.scopeStarts[rangeMetadataIndex] +
                            ranges.scopeCounts[rangeMetadataIndex]
        if rangeScopeEnd > sourceScopeTotals[rangeContextIndex]:
            sourceScopeTotals[rangeContextIndex] = rangeScopeEnd
    var scopeChildNext: int32[]
    var lexicalStatementNext: int32[]
    var suiteOwnerSeen: bool[]
    var deferSuiteSeen: bool[]
    var owningDeferScopeIds: int32[]
    var expectedExprStart: int32
    var expectedFactStart: int32
    var expectedScopeStart: int32 = 1
    var expectedStatementStart: int32
    var expectedPhysicalRoot: int32
    var previousSourceRow: int32 = -1
    var previousContextIndex: int32 = -1
    var previousRootIndex: int32 = -1
    for rowIndex in 0..<ranges.sourcePaths.len:
        report.preflightRowVisitCount = report.preflightRowVisitCount + Int64(1)
        let functionStartLine = ranges.functionStartLines[rowIndex]
        let functionEndLine = ranges.functionEndLines[rowIndex]
        let contextIndex = ranges.sourceContextIndexes[rowIndex]
        let functionScopeIndex = ranges.functionScopeIndexes[rowIndex]
        let rootIndex = ranges.sourceScopeRootIndexes[rowIndex]
        let exprStart = ranges.exprPhysicalStarts[rowIndex]
        let exprEnd = typedExprFunctionSourceRangeEnd(
            exprStart, ranges.exprCounts[rowIndex], "expr", err)
        if exprEnd < 0:
            return false
        let factStart = ranges.factPhysicalStarts[rowIndex]
        let factEnd = typedExprFunctionSourceRangeEnd(
            factStart, ranges.factCounts[rowIndex], "fact", err)
        if factEnd < 0:
            return false
        let scopeStart = ranges.scopeStarts[rowIndex]
        let scopeEnd = typedExprFunctionSourceRangeEnd(
            scopeStart, ranges.scopeCounts[rowIndex], "scope", err)
        if scopeEnd < 0:
            return false
        let statementStart = ranges.statementStarts[rowIndex]
        let statementEnd = typedExprFunctionSourceRangeEnd(
            statementStart, ranges.statementCounts[rowIndex], "statement", err)
        if statementEnd < 0:
            return false
        if ranges.sourcePaths[rowIndex].len == 0 ||
           ranges.functionNames[rowIndex].len == 0 || functionStartLine <= 0 ||
           functionEndLine < functionStartLine || contextIndex < 0 ||
           contextIndex >= sourceContexts.len || functionScopeIndex < 0 ||
           functionScopeIndex >= sourceContexts[contextIndex].scopes.len ||
           rootIndex < 0 || rootIndex >= exprLayer.scopes.len ||
           exprStart != expectedExprStart || factStart != expectedFactStart ||
           exprEnd > exprLayer.exprs.len || factEnd > facts.count:
            err = Fmt" typed expr: function source range row invalid row={rowIndex} expr_start={exprStart} expected_expr={expectedExprStart} fact_start={factStart} expected_fact={expectedFactStart}"
            return false
        if !typedExprExactTextEqual(sourceContexts[contextIndex].sourcePath,
                                    ranges.sourcePaths[rowIndex]) ||
           !typedExprExactTextEqual(
               sourceContexts[contextIndex].scopes[functionScopeIndex].sourcePath,
               ranges.sourcePaths[rowIndex]) ||
           !typedExprExactTextEqual(
               sourceContexts[contextIndex].scopes[functionScopeIndex].name,
               ranges.functionNames[rowIndex]) ||
           sourceContexts[contextIndex].scopes[functionScopeIndex].startLine !=
               functionStartLine ||
           sourceContexts[contextIndex].scopes[functionScopeIndex].endLine !=
               functionEndLine ||
           TypedExprSourceContextLineCount(sourceContexts[contextIndex]) <
               functionEndLine:
            err = Fmt" typed expr: function source range identity drift row={rowIndex} context={contextIndex} scope={functionScopeIndex}"
            return false
        let newSource = previousSourceRow < 0 ||
                        !typedExprExactTextEqual(
                            ranges.sourcePaths[previousSourceRow],
                            ranges.sourcePaths[rowIndex])
        if newSource:
            if seenContexts[contextIndex] || rootIndex != expectedPhysicalRoot ||
               scopeStart != 1 || statementStart != 0:
                err = Fmt" typed expr: function source ranges are not source-grouped row={rowIndex} root={rootIndex} expected_root={expectedPhysicalRoot} scope_start={scopeStart} statement_start={statementStart}"
                return false
            seenContexts[contextIndex] = true
            expectedScopeStart = 1
            expectedStatementStart = 0
            previousSourceRow = rowIndex
            previousContextIndex = contextIndex
            previousRootIndex = rootIndex
            let sourceScopeTotal = sourceScopeTotals[contextIndex]
            setLen(scopeChildNext, sourceScopeTotal)
            setLen(lexicalStatementNext, sourceScopeTotal)
            setLen(suiteOwnerSeen, sourceScopeTotal)
            setLen(deferSuiteSeen, sourceScopeTotal)
            setLen(owningDeferScopeIds, sourceScopeTotal)
            for sourceScopeIndex in 0..<sourceScopeTotal:
                scopeChildNext[sourceScopeIndex] = 0
                lexicalStatementNext[sourceScopeIndex] = 0
                suiteOwnerSeen[sourceScopeIndex] = false
                deferSuiteSeen[sourceScopeIndex] = false
                owningDeferScopeIds[sourceScopeIndex] = -1
        elif contextIndex != previousContextIndex || rootIndex != previousRootIndex:
            err = Fmt" typed expr: function source range source carrier drift row={rowIndex}"
            return false
        if scopeStart != expectedScopeStart || statementStart != expectedStatementStart:
            err = Fmt" typed expr: function source range overlap or gap row={rowIndex} scope_start={scopeStart} expected_scope={expectedScopeStart} statement_start={statementStart} expected_statement={expectedStatementStart}"
            return false
        let rootScope = exprLayer.scopes[rootIndex]
        if !typedExprExactTextEqual(rootScope.sourcePath,
                                    ranges.sourcePaths[rowIndex]) ||
           rootScope.scopeId != 0 ||
           rootScope.sourceScopeId != 0 || rootScope.parentScopeId != -1 ||
           rootScope.kind != parser.NormalizedScopeRoot ||
           rootScope.ownerStatementOrdinal != -1 ||
           rootScope.ownerDeclarationRow != -1 ||
           rootScope.lexicalOrdinal != 0 ||
           !TypedExprNormalizedSpanValid(rootScope.startLineNumber,
                                         rootScope.startColumnNumber,
                                         rootScope.endLineNumber,
                                         rootScope.endColumnNumber):
            err = Fmt" typed expr: function source root identity invalid row={rowIndex} root={rootIndex}"
            return false
        var ownedSuiteScopeCount: int32
        for scopeOffset in 0..<ranges.scopeCounts[rowIndex]:
            report.preflightScopeVisitCount = report.preflightScopeVisitCount + Int64(1)
            let sourceScopeId = scopeStart + scopeOffset
            let physicalScopeIndex = rootIndex + sourceScopeId
            if physicalScopeIndex < 0 || physicalScopeIndex >= exprLayer.scopes.len:
                err = Fmt" typed expr: function source scope range out of bounds row={rowIndex} source_scope={sourceScopeId}"
                return false
            let scope = exprLayer.scopes[physicalScopeIndex]
            # Frontier slices project each source's scope set: scopeId is the
            # dense per-source local index (consumed at rootIndex+scopeId) while
            # sourceScopeId retains the original facts-table id as provenance.
            # Consumers below index on scopeId only, so identity of the two is
            # not required here (same contract as the csg consumer gate).
            if !typedExprExactTextEqual(scope.sourcePath,
                                        ranges.sourcePaths[rowIndex]) ||
               scope.scopeId != sourceScopeId ||
               scope.parentScopeId < 0 ||
               (scope.parentScopeId != 0 &&
                (scope.parentScopeId < scopeStart ||
                 scope.parentScopeId >= sourceScopeId)) ||
               scope.startLineNumber < functionStartLine ||
               scope.endLineNumber > functionEndLine ||
               scope.ownerDeclarationRow < -1 ||
               (scope.ownerStatementOrdinal >= 0 &&
                scope.ownerDeclarationRow != -1) ||
               (scope.ownerDeclarationRow >= 0 &&
                (scope.ownerStatementOrdinal != -1 ||
                 scope.kind != parser.NormalizedScopeIndentedSuite)) ||
               (scope.ownerStatementOrdinal >= 0 &&
                (scope.ownerStatementOrdinal < statementStart ||
                 scope.ownerStatementOrdinal >= statementEnd)):
                err = Fmt" typed expr: function source scope ownership invalid row={rowIndex} source_scope={sourceScopeId} parent={scope.parentScopeId} owner={scope.ownerStatementOrdinal}"
                return false
            let parentScope = exprLayer.scopes[rootIndex + scope.parentScopeId]
            if !TypedExprNormalizedSpanValid(scope.startLineNumber,
                                             scope.startColumnNumber,
                                             scope.endLineNumber,
                                             scope.endColumnNumber) ||
               !TypedExprPositionAtOrBefore(parentScope.startLineNumber,
                                             parentScope.startColumnNumber,
                                             scope.startLineNumber,
                                             scope.startColumnNumber) ||
               !TypedExprPositionAtOrBefore(scope.endLineNumber,
                                             scope.endColumnNumber,
                                             parentScope.endLineNumber,
                                             parentScope.endColumnNumber) ||
               scope.lexicalOrdinal != scopeChildNext[scope.parentScopeId]:
                err = Fmt" typed expr: function source scope ownership invalid row={rowIndex} source_scope={sourceScopeId} parent={scope.parentScopeId} owner={scope.ownerStatementOrdinal}"
                return false
            scopeChildNext[scope.parentScopeId] =
                scopeChildNext[scope.parentScopeId] + 1
            if scope.ownerStatementOrdinal >= 0:
                if scope.kind != parser.NormalizedScopeIndentedSuite &&
                   scope.kind != parser.NormalizedScopeInlineSuite &&
                   scope.kind != parser.NormalizedScopeDeferSuite:
                    err = Fmt" typed expr: bounded owned suite kind invalid row={rowIndex} source_scope={sourceScopeId}"
                    return false
                ownedSuiteScopeCount = ownedSuiteScopeCount + 1
            if scope.kind == parser.NormalizedScopeDeferSuite:
                owningDeferScopeIds[sourceScopeId] = sourceScopeId
            else:
                owningDeferScopeIds[sourceScopeId] =
                    owningDeferScopeIds[scope.parentScopeId]
        var nextStatement = statementStart
        var seenOwnedSuiteScopeCount: int32
        for exprIndex in exprStart..<exprEnd:
            report.preflightExprVisitCount = report.preflightExprVisitCount + Int64(1)
            let expr = exprLayer.exprs[exprIndex]
            if !typedExprExactTextEqual(expr.sourcePath,
                                        ranges.sourcePaths[rowIndex]) ||
               expr.lineNumber < functionStartLine ||
               expr.lineNumber > functionEndLine ||
               (expr.lexicalScopeId != 0 &&
                (expr.lexicalScopeId < scopeStart || expr.lexicalScopeId >= scopeEnd)) ||
               (expr.suiteScopeId >= 0 &&
                (expr.suiteScopeId < scopeStart || expr.suiteScopeId >= scopeEnd)) ||
               (expr.statementOrdinal >= 0 &&
                (expr.statementOrdinal < statementStart ||
                 expr.statementOrdinal >= statementEnd)) ||
               (expr.deferOwnerStatementOrdinal >= 0 &&
                (expr.deferOwnerStatementOrdinal < statementStart ||
                 expr.deferOwnerStatementOrdinal >= statementEnd)):
                err = Fmt" typed expr: function source expr ownership invalid row={rowIndex} expr={exprIndex} line={expr.lineNumber}"
                return false
            let isSidecarStructured =
                parser.ParserNormalizedExprKindIsSidecarStructured(expr.kind)
            if isSidecarStructured:
                report.preflightDeferContractExprVisitCount =
                    report.preflightDeferContractExprVisitCount + Int64(1)
                if !TypedExprNormalizedSpanValid(expr.lineNumber,
                                                 expr.columnNumber,
                                                 expr.endLineNumber,
                                                 expr.endColumnNumber):
                    err = Fmt" typed expr: malformed bounded structured span row={rowIndex} expr={exprIndex}"
                    return false
                if !TypedExprScopeContainsNormalizedExpr(
                        exprLayer.scopes[rootIndex + expr.lexicalScopeId],
                        expr) ||
                   expr.lexicalOrdinal !=
                       lexicalStatementNext[expr.lexicalScopeId]:
                    err = Fmt" typed expr: bounded structured lexical identity drift row={rowIndex} expr={exprIndex} scope={expr.lexicalScopeId} lexical={expr.lexicalOrdinal} expected={lexicalStatementNext[expr.lexicalScopeId]}"
                    return false
                lexicalStatementNext[expr.lexicalScopeId] =
                    lexicalStatementNext[expr.lexicalScopeId] + 1
                if expr.statementOrdinal != nextStatement:
                    err = Fmt" typed expr: function source statement identity drift row={rowIndex} expr={exprIndex} statement={expr.statementOrdinal} expected={nextStatement}"
                    return false
                nextStatement = nextStatement + 1
                report.preflightStatementVisitCount = report.preflightStatementVisitCount + Int64(1)
                let ownsOrdinarySuite =
                    expr.kind == parser.NormalizedExprIfStmt ||
                    expr.kind == parser.NormalizedExprElifStmt ||
                    expr.kind == parser.NormalizedExprElseStmt ||
                    expr.kind == parser.NormalizedExprForStmt ||
                    expr.kind == parser.NormalizedExprMatchStmt ||
                    expr.kind == parser.NormalizedExprCaseStmt ||
                    expr.kind == parser.NormalizedExprWhileStmt
                if ownsOrdinarySuite && expr.suiteScopeId < 0:
                    err = Fmt" typed expr: bounded ordinary suite fact missing row={rowIndex} expr={exprIndex}"
                    return false
                if expr.suiteScopeId >= 0:
                    let suiteScope =
                        exprLayer.scopes[rootIndex + expr.suiteScopeId]
                    let suiteKindValid =
                        (expr.kind == parser.NormalizedExprDeferStmt &&
                         suiteScope.kind == parser.NormalizedScopeDeferSuite) ||
                        (expr.kind != parser.NormalizedExprDeferStmt &&
                         (suiteScope.kind == parser.NormalizedScopeIndentedSuite ||
                          suiteScope.kind == parser.NormalizedScopeInlineSuite))
                    if !suiteKindValid ||
                       suiteScope.parentScopeId != expr.lexicalScopeId ||
                       suiteScope.ownerStatementOrdinal != expr.statementOrdinal ||
                       suiteOwnerSeen[expr.suiteScopeId]:
                        err = Fmt" typed expr: bounded suite owner mismatch row={rowIndex} expr={exprIndex} suite={expr.suiteScopeId}"
                        return false
                    suiteOwnerSeen[expr.suiteScopeId] = true
                    seenOwnedSuiteScopeCount = seenOwnedSuiteScopeCount + 1
                if expr.kind == parser.NormalizedExprDeferStmt:
                    if expr.deferOwnerStatementOrdinal != -1 ||
                       owningDeferScopeIds[expr.lexicalScopeId] >= 0 ||
                       expr.suiteScopeId < 0:
                        err = Fmt" typed expr: bounded nested defer fact invalid row={rowIndex} expr={exprIndex}"
                        return false
                    let deferScope =
                        exprLayer.scopes[rootIndex + expr.suiteScopeId]
                    if deferScope.kind != parser.NormalizedScopeDeferSuite ||
                       deferScope.parentScopeId != expr.lexicalScopeId ||
                       deferScope.ownerStatementOrdinal != expr.statementOrdinal ||
                       deferScope.endLineNumber != expr.endLineNumber ||
                       deferScope.endColumnNumber != expr.endColumnNumber ||
                       deferSuiteSeen[expr.suiteScopeId] ||
                       !suiteOwnerSeen[expr.suiteScopeId]:
                        err = Fmt" typed expr: malformed bounded defer suite row={rowIndex} expr={exprIndex}"
                        return false
                    deferSuiteSeen[expr.suiteScopeId] = true
                if expr.kind == parser.NormalizedExprBreakStmt ||
                   expr.kind == parser.NormalizedExprContinueStmt:
                    if expr.suiteScopeId != -1 ||
                       expr.deferOwnerStatementOrdinal != -1 ||
                       owningDeferScopeIds[expr.lexicalScopeId] >= 0:
                        err = Fmt" typed expr: malformed bounded transfer row={rowIndex} expr={exprIndex}"
                        return false
            if expr.deferOwnerStatementOrdinal >= 0:
                if !isSidecarStructured:
                    report.preflightDeferContractExprVisitCount =
                        report.preflightDeferContractExprVisitCount + Int64(1)
                if !TypedExprNormalizedSpanValid(expr.lineNumber,
                                                 expr.columnNumber,
                                                 expr.endLineNumber,
                                                 expr.endColumnNumber):
                    err = Fmt" typed expr: malformed bounded deferred-body span row={rowIndex} expr={exprIndex}"
                    return false
                let owningDeferScopeId =
                    owningDeferScopeIds[expr.lexicalScopeId]
                if owningDeferScopeId < 0 ||
                   exprLayer.scopes[rootIndex + owningDeferScopeId].ownerStatementOrdinal !=
                       expr.deferOwnerStatementOrdinal ||
                   !deferSuiteSeen[owningDeferScopeId] ||
                   !TypedExprScopeContainsNormalizedExpr(
                        exprLayer.scopes[rootIndex + expr.lexicalScopeId], expr) ||
                   !TypedExprScopeContainsNormalizedExpr(
                        exprLayer.scopes[rootIndex + owningDeferScopeId], expr):
                    err = Fmt" typed expr: malformed bounded deferred-body owner row={rowIndex} expr={exprIndex}"
                    return false
        if nextStatement != statementEnd:
            err = Fmt" typed expr: function source statement coverage incomplete row={rowIndex} visited={nextStatement - statementStart} expected={ranges.statementCounts[rowIndex]}"
            return false
        if seenOwnedSuiteScopeCount != ownedSuiteScopeCount:
            err = Fmt" typed expr: bounded suite ownership coverage incomplete row={rowIndex} seen={seenOwnedSuiteScopeCount} expected={ownedSuiteScopeCount}"
            return false
        for factIndex in factStart..<factEnd:
            report.preflightFactVisitCount = report.preflightFactVisitCount + Int64(1)
            let fact = TypedExprFactAt(facts, factIndex)
            if !typedExprExactTextEqual(fact.sourcePath,
                                        ranges.sourcePaths[rowIndex]) ||
               fact.lineNumber < functionStartLine ||
               fact.lineNumber > functionEndLine ||
               (fact.lexicalScopeId != 0 &&
                (fact.lexicalScopeId < scopeStart || fact.lexicalScopeId >= scopeEnd)) ||
               (fact.suiteScopeId >= 0 &&
                (fact.suiteScopeId < scopeStart || fact.suiteScopeId >= scopeEnd)) ||
               (fact.statementOrdinal >= 0 &&
                (fact.statementOrdinal < statementStart || fact.statementOrdinal >= statementEnd)) ||
               (fact.deferOwnerStatementOrdinal >= 0 &&
                (fact.deferOwnerStatementOrdinal < statementStart ||
                 fact.deferOwnerStatementOrdinal >= statementEnd)):
                err = Fmt" typed expr: function source fact ownership invalid row={rowIndex} fact={factIndex} line={fact.lineNumber}"
                return false
        expectedExprStart = exprEnd
        expectedFactStart = factEnd
        expectedScopeStart = scopeEnd
        expectedStatementStart = statementEnd
        if rowIndex + 1 >= ranges.sourcePaths.len ||
           !typedExprExactTextEqual(ranges.sourcePaths[rowIndex + 1],
                                    ranges.sourcePaths[rowIndex]):
            expectedPhysicalRoot = rootIndex + scopeEnd
    if expectedExprStart != exprLayer.exprs.len || expectedFactStart != facts.count ||
       expectedPhysicalRoot != exprLayer.scopes.len:
        err = Fmt" typed expr: function source range coverage incomplete exprs={expectedExprStart}/{exprLayer.exprs.len} facts={expectedFactStart}/{facts.count} scopes={expectedPhysicalRoot}/{exprLayer.scopes.len}"
        return false
    report.rowCount = ranges.sourcePaths.len
    if !typedExprFunctionBindingPlanBuild(sourceContexts,
                                          ranges,
                                          bindingPlan,
                                          report,
                                          err):
        return false
    err = ""
    return true

fn TypedExprFunctionSourceRangesPreflight(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        report: var TypedExprFunctionSourceRangeBuildReport,
        err: var str): bool =
    var filterIndex: TypedExprFunctionFilterIndex
    var bindingPlan: typedExprFunctionBindingPlan
    return typedExprFunctionSourceRangePreflight(sourceTexts,
                                                 facts,
                                                 exprLayer,
                                                 sourceContexts,
                                                 ranges,
                                                 filterIndex,
                                                 bindingPlan,
                                                 report,
                                                 err)

@borrows
fn typedExprFunctionSourceRangeProjectRow(
        facts: TypedExprFactTable,
        exprLayer: parser.NormalizedExprLayer,
        ranges: TypedExprFunctionSourceRangeSet,
        rowIndex: int32,
        exprScratch: var parser.NormalizedExprLayer,
        factScratch: var TypedExprFactTable,
        projectedChildCounts: var int32[],
        factScratchRowCapacity: int32,
        report: var TypedExprFunctionSourceRangeBuildReport) =
    if report.activeRangeCount != 0:
        panic("typed expr: bounded function range scratch overlap")
    parser.NormalizedExprLayerReset(exprScratch)
    TypedExprFactTableReset(factScratch)
    let sourcePath = ranges.sourcePaths[rowIndex]
    let functionStartLine = ranges.functionStartLines[rowIndex]
    let functionEndLine = ranges.functionEndLines[rowIndex]
    let rootIndex = ranges.sourceScopeRootIndexes[rowIndex]
    let scopeStart = ranges.scopeStarts[rowIndex]
    let scopeCount = ranges.scopeCounts[rowIndex]
    let statementStart = ranges.statementStarts[rowIndex]
    let statementCount = ranges.statementCounts[rowIndex]
    let exprStart = ranges.exprPhysicalStarts[rowIndex]
    let exprEnd = exprStart + ranges.exprCounts[rowIndex]
    let factStart = ranges.factPhysicalStarts[rowIndex]
    let factEnd = factStart + ranges.factCounts[rowIndex]

    var root = exprLayer.scopes[rootIndex]
    root.scopeId = 0
    root.sourceScopeId = 0
    root.parentScopeId = -1
    root.kind = parser.NormalizedScopeRoot
    root.ownerStatementOrdinal = -1
    root.ownerDeclarationRow = -1
    root.lexicalOrdinal = 0
    root.startLineNumber = functionStartLine
    root.startColumnNumber = 1
    root.endLineNumber = functionEndLine
    if root.endColumnNumber <= 0:
        root.endColumnNumber = 1
    # [w24] 投影是逐行写穿共享 scope 行的再盖章: root 行(全层 scopes[0])的
    # sourcePath 会被上一行提交后的 scratch Reset(NormalizedExprLayerReset 对
    # scratch 行的 sourcePath="" 清空写穿共享行)抹掉, 而本投影从不重设它 →
    # 下一个带 generated statement 的函数行在 annotate 的 root 身份查找
    # (TypedExprNormalizedScopeGlobalIndex) panic "normalized scope index
    # identity mismatch"(w24d v6 main row=3 实证: rowPath="" pathEq=0)。
    # 单源投影 scratch 的 root 身份 = ranges.sourcePaths[rowIndex], 与
    # scopeId/kind/span 的逐行再盖章同一契约, 在此显式补全。
    root.sourcePath = sourcePath
    add(exprScratch.scopes, share(root))
    setLen(projectedChildCounts, scopeCount + 1)
    for childCountIndex in 0..<projectedChildCounts.len:
        projectedChildCounts[childCountIndex] = 0
    for scopeOffset in 0..<scopeCount:
        let sourceScopeId = scopeStart + scopeOffset
        var scope = exprLayer.scopes[rootIndex + sourceScopeId]
        let localScopeId = scopeOffset + 1
        let localParentScopeId = typedExprFunctionSourceRangeLocalScopeId(
            scope.parentScopeId, scopeStart, scopeCount)
        scope.scopeId = localScopeId
        # Keep the validated source identity in its dedicated column while the
        # builder consumes dense scopeId/parentScopeId.
        scope.sourceScopeId = sourceScopeId
        scope.parentScopeId = localParentScopeId
        scope.ownerStatementOrdinal =
            typedExprFunctionSourceRangeLocalStatementOrdinal(
                scope.ownerStatementOrdinal, statementStart, statementCount)
        scope.lexicalOrdinal = projectedChildCounts[localParentScopeId]
        projectedChildCounts[localParentScopeId] =
            projectedChildCounts[localParentScopeId] + 1
        add(exprScratch.scopes, share(scope))
        report.commitScopeVisitCount = report.commitScopeVisitCount + Int64(1)
    reserve(exprScratch.exprs, ranges.exprCounts[rowIndex])
    for exprIndex in exprStart..<exprEnd:
        var expr = exprLayer.exprs[exprIndex]
        expr.lexicalScopeId = typedExprFunctionSourceRangeLocalScopeId(
            expr.lexicalScopeId, scopeStart, scopeCount)
        if expr.suiteScopeId >= 0:
            expr.suiteScopeId = typedExprFunctionSourceRangeLocalScopeId(
                expr.suiteScopeId, scopeStart, scopeCount)
        expr.statementOrdinal =
            typedExprFunctionSourceRangeLocalStatementOrdinal(
                expr.statementOrdinal, statementStart, statementCount)
        expr.deferOwnerStatementOrdinal =
            typedExprFunctionSourceRangeLocalStatementOrdinal(
                expr.deferOwnerStatementOrdinal, statementStart, statementCount)
        add(exprScratch.exprs, share(expr))
        report.commitExprVisitCount = report.commitExprVisitCount + Int64(1)
        if parser.ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            report.commitStatementVisitCount =
                report.commitStatementVisitCount + Int64(1)
    exprScratch.sourceCount = 1
    if !TypedExprFactTablePrepareEmptyRows(factScratch,
                                           factScratchRowCapacity):
        panic("typed expr: bounded function fact scratch reserve failed")
    for factIndex in factStart..<factEnd:
        var fact = TypedExprFactAt(facts, factIndex)
        fact.lexicalScopeId = typedExprFunctionSourceRangeLocalScopeId(
            fact.lexicalScopeId, scopeStart, scopeCount)
        if fact.suiteScopeId >= 0:
            fact.suiteScopeId = typedExprFunctionSourceRangeLocalScopeId(
                fact.suiteScopeId, scopeStart, scopeCount)
        fact.statementOrdinal =
            typedExprFunctionSourceRangeLocalStatementOrdinal(
                fact.statementOrdinal, statementStart, statementCount)
        fact.deferOwnerStatementOrdinal =
            typedExprFunctionSourceRangeLocalStatementOrdinal(
                fact.deferOwnerStatementOrdinal, statementStart, statementCount)
        TypedExprFactTableAppend(factScratch, fact)
        report.commitFactVisitCount = report.commitFactVisitCount + Int64(1)
    report.commitRowVisitCount = report.commitRowVisitCount + Int64(1)
    report.activeRangeCount = 1
    if report.activeRangePeak < 1:
        report.activeRangePeak = 1

fn typedExprAppendInferredIndexBindingsForFunctionRange(
        ir: var TypedExprIr,
        ctx: var TypedExprSourceContext,
        sourceContexts: var TypedExprSourceContext[],
        scopeStartLine: int32,
        scopeEndLine: int32,
        report: var TypedExprFunctionSourceRangeBuildReport) =
    var startLine = scopeStartLine
    if startLine < 1:
        startLine = 1
    var endLine = scopeEndLine
    let sourceLineCount = TypedExprSourceContextLineCount(ctx)
    if endLine > sourceLineCount:
        endLine = sourceLineCount
    for lineNumber in startLine..endLine:
        report.functionLineVisitCount = report.functionLineVisitCount + Int64(1)
        let lineText = TypedExprSourceContextLineText(ctx, lineNumber)
        if lineText == "" &&
           TypedExprSourceContextLineIndex(ctx, lineNumber) < 0:
            panic(Fmt"typed expr: bounded function source line missing source={ctx.sourcePath} line={lineNumber}")
        TypedExprMaybeAddInferredIndexBinding(ir,
                                               ctx,
                                               sourceContexts,
                                               lineText,
                                               lineNumber)

fn typedExprFunctionSourceRangeReleaseScratch(
        exprScratch: var parser.NormalizedExprLayer,
        factScratch: var TypedExprFactTable,
        report: var TypedExprFunctionSourceRangeBuildReport) =
    parser.NormalizedExprLayerReset(exprScratch)
    TypedExprFactTableReset(factScratch)
    if report.activeRangeCount != 1:
        panic("typed expr: bounded function range scratch release mismatch")
    report.activeRangeCount = 0

type
    TypedExprFunctionRangeScratch = ref object
        exprScratch: parser.NormalizedExprLayer
        factScratch: TypedExprFactTable
        projectedChildCounts: int32[]
        report: TypedExprFunctionSourceRangeBuildReport

    TypedExprRangeCommitOwner = ref object
        facts: TypedExprFactTable
        exprLayer: parser.NormalizedExprLayer
        sourceContexts: TypedExprSourceContext[]
        ranges: TypedExprFunctionSourceRangeSet
        bindingPlan: typedExprFunctionBindingPlan
        ir: TypedExprIr
        normalizedScopeIndex: TypedExprNormalizedScopeIndex
        sourceInitialized: bool[]

fn TypedExprSourceContextSeqTakeFromOwner(owner: TypedExprRangeCommitOwner): TypedExprSourceContext[] =
    # [orcd9-inst] 环入口/出口标
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), Fmt"O8TAKE n={owner.sourceContexts.len}")
    var out: TypedExprSourceContext[]
    setLen(out, owner.sourceContexts.len)
    for i in 0..<owner.sourceContexts.len:
        TypedExprSourceContextMoveInto(out[i], owner.sourceContexts[i])
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8TAKEOK")
    return out

@borrows
fn typedExprFunctionSourceRangeCommitActiveRow(owner: TypedExprRangeCommitOwner,
                                                scratch: TypedExprFunctionRangeScratch,
                                                rowIndex: int32) =
    let contextIndex = owner.ranges.sourceContextIndexes[rowIndex]
    if contextIndex < 0 || contextIndex >= owner.sourceContexts.len:
        panic("typed expr: bounded function range context index out of range")
    var items = TypedExprSourceContextSeqTakeFromOwner(owner)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8CAR-TAKEN")
    var activeContext = TypedExprSourceContextTakeAt(items, contextIndex)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8CAR-TAKEAT")
    let activeSourcePath = share(activeContext.sourcePath)
    let activeNormalizedSourcePath =
        share(activeContext.normalizedSourcePath)
    let activeBuildIndex = activeContext.buildIndex
    let activeProjection = share(activeContext.frozenMetadataProjection)
    let activeProjectionIndex =
        activeContext.frozenMetadataContextIndex
    if activeSourcePath == "" || activeBuildIndex == nil:
        panic("typed expr: bounded function range active authority missing")
    items[contextIndex].sourcePath =
        share(activeSourcePath)
    items[contextIndex].normalizedSourcePath =
        share(activeNormalizedSourcePath)
    items[contextIndex].frozenMetadataProjection =
        share(activeProjection)
    items[contextIndex].frozenMetadataContextIndex =
        activeProjectionIndex
    TypedExprSourceContextSetBorrowedBuildIndex(
        items[contextIndex],
        activeBuildIndex)
    if items[contextIndex].sourcePath != activeSourcePath ||
       items[contextIndex].normalizedSourcePath !=
           activeNormalizedSourcePath ||
       items[contextIndex].buildIndex != activeBuildIndex ||
       items[contextIndex].buildIndexOwned ||
       !typedExprSourceContextMovedStorageEmpty(
           items[contextIndex]):
        panic("typed expr: bounded function range context sentinel failed")
    let functionScope =
        activeContext.scopes[
            owner.ranges.functionScopeIndexes[rowIndex]]
    if !owner.sourceInitialized[contextIndex]:
        TypedExprIrAppendColdCsgRowsFromContext(
            owner.ir, activeContext)
        owner.sourceInitialized[contextIndex] = true
    let bindingsBefore = activeContext.bindings.len
    TypedExprAppendInferredCallBindings(activeContext,
                                        items,
                                        scratch.factScratch,
                                        0,
                                        scratch.factScratch.count)
    typedExprAppendInferredIndexBindingsForFunctionRange(owner.ir,
                                                          activeContext,
                                                          items,
                                                          functionScope.startLine,
                                                          functionScope.endLine,
                                                          scratch.report)
    let bindingsAfter = activeContext.bindings.len
    let stableBindingStart = owner.bindingPlan.rowStarts[rowIndex]
    let stableBindingEnd = stableBindingStart + owner.bindingPlan.rowCounts[rowIndex]
    for planIndex in stableBindingStart..<stableBindingEnd:
        if owner.bindingPlan.contextIndexes[planIndex] != contextIndex:
            panic("typed expr: bounded binding plan context drift")
        TypedExprIrAppendBindingFromContextRow(
            owner.ir,
            activeContext,
            owner.bindingPlan.bindingIndexes[planIndex])
        scratch.report.commitBindingVisitCount =
            scratch.report.commitBindingVisitCount + Int64(1)
    for bindingIndex in bindingsBefore..<bindingsAfter:
        let binding = activeContext.bindings[bindingIndex]
        scratch.report.inferredBindingCandidateVisitCount =
            scratch.report.inferredBindingCandidateVisitCount + Int64(1)
        if binding.sourcePath != owner.ranges.sourcePaths[rowIndex] ||
           binding.globalFlag || binding.functionName != functionScope.name ||
           binding.lineNumber < functionScope.startLine ||
           binding.lineNumber > functionScope.endLine:
            panic("typed expr: inferred binding delta escaped function range")
        let identityKey = typedExprBindingIdentityKey(binding)
        if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                owner.bindingPlan.identityLookup, identityKey) >= 0:
            scratch.report.inferredBindingDuplicateVisitCount =
                scratch.report.inferredBindingDuplicateVisitCount + Int64(1)
            continue
        parser.ParserSourcePathIndexLookupInsertExact(
            owner.bindingPlan.identityLookup, identityKey, bindingIndex)
        TypedExprIrAppendBindingValue(owner.ir, binding)
        scratch.report.commitBindingVisitCount =
            scratch.report.commitBindingVisitCount + Int64(1)
        scratch.report.inferredBindingDeltaVisitCount =
            scratch.report.inferredBindingDeltaVisitCount + Int64(1)
    setLen(activeContext.bindings, bindingsBefore)
    setLen(owner.normalizedScopeIndex.sourcePaths, 1)
    setLen(owner.normalizedScopeIndex.starts, 1)
    setLen(owner.normalizedScopeIndex.counts, 1)
    owner.normalizedScopeIndex.sourcePaths[0] = owner.ranges.sourcePaths[rowIndex]
    owner.normalizedScopeIndex.starts[0] = 0
    owner.normalizedScopeIndex.counts[0] = scratch.exprScratch.scopes.len
    var stableProducerSourceIndex = contextIndex
    if activeProjectionIndex >= 0:
        stableProducerSourceIndex = activeProjectionIndex
    TypedExprIrSetValueDefinitionProducerSourceIndex(
        owner.ir, contextIndex, stableProducerSourceIndex)
    TypedExprBuildIrForScopeWithFactsAndExprLayer(activeContext,
                                                  items,
                                                  functionScope,
                                                  scratch.factScratch,
                                                  0,
                                                  scratch.factScratch.count,
                                                  scratch.exprScratch,
                                                  owner.normalizedScopeIndex,
                                                  0,
                                                  scratch.exprScratch.exprs.len,
                                                  owner.ir)
    if items[contextIndex].sourcePath != activeSourcePath ||
       items[contextIndex].normalizedSourcePath !=
           activeNormalizedSourcePath ||
       items[contextIndex].buildIndex != activeBuildIndex ||
       items[contextIndex].buildIndexOwned ||
       items[contextIndex].frozenMetadataProjection !=
           activeProjection ||
       items[contextIndex].frozenMetadataContextIndex !=
           activeProjectionIndex ||
       !typedExprSourceContextMovedStorageEmpty(
           items[contextIndex]):
        panic("typed expr: bounded function range context sentinel mutated")
    TypedExprSourceContextMoveInto(items[contextIndex],
                                   activeContext)
    if activeContext.sourcePath != "" ||
       activeContext.buildIndex != nil ||
       activeContext.buildIndexOwned ||
       !typedExprSourceContextMovedStorageEmpty(activeContext):
        panic("typed expr: bounded function range context restore failed")
    owner.ir.valueExprTransactionParserProducerSourceIndex = -1
    owner.ir.valueExprTransactionProducerSourceIndex = -1
    typedExprFunctionSourceRangeReleaseScratch(scratch.exprScratch,
                                                scratch.factScratch,
                                                scratch.report)
    let committedExprStart = owner.ranges.exprPhysicalStarts[rowIndex]
    let committedExprEnd = committedExprStart +
                           owner.ranges.exprCounts[rowIndex]
    TypedExprClearExprLayerRange(owner.exprLayer,
                                 committedExprStart,
                                 committedExprEnd)
    owner.sourceContexts = items

@borrows
fn typedExprFunctionSourceRangesCommitRec(
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        bindingPlan: var typedExprFunctionBindingPlan,
        ir: var TypedExprIr,
        scratch: TypedExprFunctionRangeScratch,
        sourceInitialized: var bool[],
        normalizedScopeIndex: var TypedExprNormalizedScopeIndex,
        maxFactCount: int32,
        rowIndex: int32) =
    while true:
        if rowIndex >= ranges.sourcePaths.len:
            return
        typedExprFunctionSourceRangeProjectRow(facts,
                                               exprLayer,
                                               ranges,
                                               rowIndex,
                                               scratch.exprScratch,
                                               scratch.factScratch,
                                               scratch.projectedChildCounts,
                                               maxFactCount,
                                               scratch.report)
        let contextIndex = ranges.sourceContextIndexes[rowIndex]
        if contextIndex < 0 || contextIndex >= sourceContexts.len:
            panic("typed expr: bounded function range context index out of range")
        var activeContext: TypedExprSourceContext
        TypedExprSourceContextMoveInto(activeContext,
                                       sourceContexts[contextIndex])
        let activeSourcePath = share(activeContext.sourcePath)
        let activeNormalizedSourcePath =
            share(activeContext.normalizedSourcePath)
        let activeBuildIndex = activeContext.buildIndex
        let activeProjection = share(activeContext.frozenMetadataProjection)
        let activeProjectionIndex =
            activeContext.frozenMetadataContextIndex
        if activeSourcePath == "" || activeBuildIndex == nil:
            panic("typed expr: bounded function range active authority missing")
        sourceContexts[contextIndex].sourcePath =
            share(activeSourcePath)
        sourceContexts[contextIndex].normalizedSourcePath =
            share(activeNormalizedSourcePath)
        sourceContexts[contextIndex].frozenMetadataProjection =
            share(activeProjection)
        sourceContexts[contextIndex].frozenMetadataContextIndex =
            activeProjectionIndex
        TypedExprSourceContextSetBorrowedBuildIndex(
            sourceContexts[contextIndex],
            activeBuildIndex)
        if sourceContexts[contextIndex].sourcePath != activeSourcePath ||
           sourceContexts[contextIndex].normalizedSourcePath !=
               activeNormalizedSourcePath ||
           sourceContexts[contextIndex].buildIndex != activeBuildIndex ||
           sourceContexts[contextIndex].buildIndexOwned ||
           !typedExprSourceContextMovedStorageEmpty(
               sourceContexts[contextIndex]):
            panic("typed expr: bounded function range context sentinel failed")
        let functionScope =
            activeContext.scopes[
                ranges.functionScopeIndexes[rowIndex]]
        if !sourceInitialized[contextIndex]:
            TypedExprIrAppendColdCsgRowsFromContext(
                ir, activeContext)
            sourceInitialized[contextIndex] = true
        let bindingsBefore = activeContext.bindings.len
        TypedExprAppendInferredCallBindings(activeContext,
                                            sourceContexts,
                                            scratch.factScratch,
                                            0,
                                            scratch.factScratch.count)
        typedExprAppendInferredIndexBindingsForFunctionRange(ir,
                                                              activeContext,
                                                              sourceContexts,
                                                              functionScope.startLine,
                                                              functionScope.endLine,
                                                              scratch.report)
        let bindingsAfter = activeContext.bindings.len
        let stableBindingStart = bindingPlan.rowStarts[rowIndex]
        let stableBindingEnd = stableBindingStart + bindingPlan.rowCounts[rowIndex]
        for planIndex in stableBindingStart..<stableBindingEnd:
            if bindingPlan.contextIndexes[planIndex] != contextIndex:
                panic("typed expr: bounded binding plan context drift")
            TypedExprIrAppendBindingFromContextRow(
                ir,
                activeContext,
                bindingPlan.bindingIndexes[planIndex])
            scratch.report.commitBindingVisitCount =
                scratch.report.commitBindingVisitCount + Int64(1)
        for bindingIndex in bindingsBefore..<bindingsAfter:
            let binding = activeContext.bindings[bindingIndex]
            scratch.report.inferredBindingCandidateVisitCount =
                scratch.report.inferredBindingCandidateVisitCount + Int64(1)
            if binding.sourcePath != ranges.sourcePaths[rowIndex] ||
               binding.globalFlag || binding.functionName != functionScope.name ||
               binding.lineNumber < functionScope.startLine ||
               binding.lineNumber > functionScope.endLine:
                panic("typed expr: inferred binding delta escaped function range")
            let identityKey = typedExprBindingIdentityKey(binding)
            if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                    bindingPlan.identityLookup, identityKey) >= 0:
                scratch.report.inferredBindingDuplicateVisitCount =
                    scratch.report.inferredBindingDuplicateVisitCount + Int64(1)
                continue
            parser.ParserSourcePathIndexLookupInsertExact(
                bindingPlan.identityLookup, identityKey, bindingIndex)
            TypedExprIrAppendBindingValue(ir, binding)
            scratch.report.commitBindingVisitCount =
                scratch.report.commitBindingVisitCount + Int64(1)
            scratch.report.inferredBindingDeltaVisitCount =
                scratch.report.inferredBindingDeltaVisitCount + Int64(1)
        setLen(activeContext.bindings, bindingsBefore)
        setLen(normalizedScopeIndex.sourcePaths, 1)
        setLen(normalizedScopeIndex.starts, 1)
        setLen(normalizedScopeIndex.counts, 1)
        normalizedScopeIndex.sourcePaths[0] = ranges.sourcePaths[rowIndex]
        normalizedScopeIndex.starts[0] = 0
        normalizedScopeIndex.counts[0] = scratch.exprScratch.scopes.len
        var stableProducerSourceIndex = contextIndex
        if activeProjectionIndex >= 0:
            stableProducerSourceIndex = activeProjectionIndex
        TypedExprIrSetValueDefinitionProducerSourceIndex(
            ir, contextIndex, stableProducerSourceIndex)
        TypedExprBuildIrForScopeWithFactsAndExprLayer(activeContext,
                                                      sourceContexts,
                                                      functionScope,
                                                      scratch.factScratch,
                                                      0,
                                                      scratch.factScratch.count,
                                                      scratch.exprScratch,
                                                      normalizedScopeIndex,
                                                      0,
                                                      scratch.exprScratch.exprs.len,
                                                      ir)
        if sourceContexts[contextIndex].sourcePath != activeSourcePath ||
           sourceContexts[contextIndex].normalizedSourcePath !=
               activeNormalizedSourcePath ||
           sourceContexts[contextIndex].buildIndex != activeBuildIndex ||
           sourceContexts[contextIndex].buildIndexOwned ||
           sourceContexts[contextIndex].frozenMetadataProjection !=
               activeProjection ||
           sourceContexts[contextIndex].frozenMetadataContextIndex !=
               activeProjectionIndex ||
           !typedExprSourceContextMovedStorageEmpty(
               sourceContexts[contextIndex]):
            panic("typed expr: bounded function range context sentinel mutated")
        TypedExprSourceContextMoveInto(sourceContexts[contextIndex],
                                       activeContext)
        if activeContext.sourcePath != "" ||
           activeContext.buildIndex != nil ||
           activeContext.buildIndexOwned ||
           !typedExprSourceContextMovedStorageEmpty(activeContext):
            panic("typed expr: bounded function range context restore failed")
        ir.valueExprTransactionParserProducerSourceIndex = -1
        ir.valueExprTransactionProducerSourceIndex = -1
        typedExprFunctionSourceRangeReleaseScratch(scratch.exprScratch,
                                                    scratch.factScratch,
                                                    scratch.report)
        let committedExprStart = ranges.exprPhysicalStarts[rowIndex]
        let committedExprEnd = committedExprStart +
                               ranges.exprCounts[rowIndex]
        TypedExprClearExprLayerRange(exprLayer,
                                     committedExprStart,
                                     committedExprEnd)
        rowIndex = rowIndex + 1
        let _ = os.ProcessMemoryPressureRelief()
        continue

fn typedExprFunctionSourceRangesCommit(
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        bindingPlan: var typedExprFunctionBindingPlan,
        ir: var TypedExprIr,
        report: var TypedExprFunctionSourceRangeBuildReport) =
    var scratch = new(TypedExprFunctionRangeScratch)
    var normalizedScopeIndex: TypedExprNormalizedScopeIndex
    var maxExprCount: int32
    var maxScopeCount: int32
    var maxFactCount: int32
    for rowIndex in 0..<ranges.sourcePaths.len:
        if ranges.exprCounts[rowIndex] > maxExprCount:
            maxExprCount = ranges.exprCounts[rowIndex]
        if ranges.scopeCounts[rowIndex] > maxScopeCount:
            maxScopeCount = ranges.scopeCounts[rowIndex]
        if ranges.factCounts[rowIndex] > maxFactCount:
            maxFactCount = ranges.factCounts[rowIndex]
    reserve(scratch.exprScratch.exprs, maxExprCount)
    reserve(scratch.exprScratch.scopes, maxScopeCount + 1)
    reserve(scratch.projectedChildCounts, maxScopeCount + 1)
    reserve(normalizedScopeIndex.sourcePaths, 1)
    reserve(normalizedScopeIndex.starts, 1)
    reserve(normalizedScopeIndex.counts, 1)
    scratch.report = report
    scratch.report.exprScratchPeakCapacity = scratch.exprScratch.exprs.cap
    scratch.report.scopeScratchPeakCapacity = scratch.exprScratch.scopes.cap
    scratch.report.factScratchPeakRowCapacity = maxFactCount
    scratch.report.childCountScratchPeakCapacity = scratch.projectedChildCounts.cap
    scratch.report.normalizedScopeIndexScratchPeakCapacity =
        normalizedScopeIndex.sourcePaths.cap
    var sourceInitialized: bool[]
    setLen(sourceInitialized, sourceContexts.len)
    typedExprFunctionSourceRangesCommitRec(facts,
                                           exprLayer,
                                           sourceContexts,
                                           ranges,
                                           bindingPlan,
                                           ir,
                                           scratch,
                                           sourceInitialized,
                                           normalizedScopeIndex,
                                           maxFactCount,
                                           0)
    TypedExprFactTableRelease(scratch.factScratch)
    report = scratch.report

fn typedExprFunctionSourceRangeReportBegin(
        ir: var TypedExprIr,
        report: var TypedExprFunctionSourceRangeBuildReport) =
    report.functionCountBefore = ir.functions2_functionNameIds.len
    report.statementCountBefore = ir.statements2_statementIndexs.len
    report.nodeCountBefore = ir.nodes2_nodeIndexs.len

fn typedExprFunctionSourceRangeReportFinish(
        ir: var TypedExprIr,
        ranges: var TypedExprFunctionSourceRangeSet,
        bindingPlan: var typedExprFunctionBindingPlan,
        report: var TypedExprFunctionSourceRangeBuildReport) =
    report.functionCountAfter = ir.functions2_functionNameIds.len
    report.statementCountAfter = ir.statements2_statementIndexs.len
    report.nodeCountAfter = ir.nodes2_nodeIndexs.len
    if report.activeRangeCount != 0 || report.activeRangePeak != 1 ||
       report.fullSourceScopeRescanCount != 0 ||
       report.fullSourceLineRescanCount != 0 ||
       report.perRowFullSourceBindingRescanCount != 0 ||
       report.commitRowVisitCount != Int64(ranges.sourcePaths.len) ||
       report.commitExprVisitCount != report.preflightExprVisitCount ||
       report.commitFactVisitCount != report.preflightFactVisitCount ||
       report.commitScopeVisitCount != report.preflightScopeVisitCount ||
       report.commitStatementVisitCount != report.preflightStatementVisitCount ||
       report.bindingIndexBuildVisitCount != Int64(bindingPlan.stableBindingCount) ||
       report.bindingIndexFillVisitCount != Int64(bindingPlan.stableBindingCount) ||
       report.commitBindingVisitCount !=
           Int64(bindingPlan.stableBindingCount) +
               report.inferredBindingDeltaVisitCount ||
       report.inferredBindingCandidateVisitCount !=
           report.inferredBindingDeltaVisitCount +
               report.inferredBindingDuplicateVisitCount ||
       report.functionCountAfter - report.functionCountBefore != ranges.sourcePaths.len:
        panic("typed expr: bounded function range commit accounting drift")

fn TypedExprBuildIrForFunctionSourceRanges(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        ir: var TypedExprIr,
        report: var TypedExprFunctionSourceRangeBuildReport,
        err: var str): bool =
    var filterIndex: TypedExprFunctionFilterIndex
    var bindingPlan: typedExprFunctionBindingPlan
    if !typedExprFunctionSourceRangePreflight(sourceTexts,
                                              facts,
                                              exprLayer,
                                              sourceContexts,
                                              ranges,
                                              filterIndex,
                                              bindingPlan,
                                              report,
                                              err):
        return false
    typedExprFunctionSourceRangeReportBegin(ir, report)
    var candidate: TypedExprIr
    candidate.internPool = langintern.InternPoolNew()
    if ir.exactTypeArena == nil || !ir.valueDefinitionTypeArenaBound:
        err = " typed expr: bounded function range build requires exact TypeArena authority"
        TypedExprIrReleasePayload(candidate)
        return false
    var candidateExactTypeArena = share(ir.exactTypeArena)
    if !TypedExprIrBindExactTypeArena(
           candidate, candidateExactTypeArena, err):
        TypedExprIrReleasePayload(candidate)
        return false
    TypedExprIrBeginValueExprBorrow(candidate, exprLayer)
    TypedExprIrPrepareValueExprCallMetadata(candidate, facts)
    TypedExprIrAppendMetadataDefinitionsForFilter(candidate,
                                                   sourceContexts,
                                                   filterIndex,
                                                   false,
                                                   false)
    typedExprFunctionSourceRangesCommit(facts,
                                        exprLayer,
                                        sourceContexts,
                                        ranges,
                                        bindingPlan,
                                        candidate,
                                        report)
    # Build replaces the target atomically: all fallible validation completed
    # before candidate construction, and the old IR remains untouched until move.
    report.functionCountBefore = ir.functions2_functionNameIds.len
    report.statementCountBefore = ir.statements2_statementIndexs.len
    report.nodeCountBefore = ir.nodes2_nodeIndexs.len
    report.functionCountAfter = candidate.functions2_functionNameIds.len
    report.statementCountAfter = candidate.statements2_statementIndexs.len
    report.nodeCountAfter = candidate.nodes2_nodeIndexs.len
    if report.activeRangeCount != 0 || report.activeRangePeak != 1 ||
       report.commitRowVisitCount != Int64(ranges.sourcePaths.len) ||
       report.commitExprVisitCount != report.preflightExprVisitCount ||
       report.commitFactVisitCount != report.preflightFactVisitCount ||
       report.commitScopeVisitCount != report.preflightScopeVisitCount ||
       report.commitStatementVisitCount != report.preflightStatementVisitCount ||
       report.bindingIndexBuildVisitCount != Int64(bindingPlan.stableBindingCount) ||
       report.bindingIndexFillVisitCount != Int64(bindingPlan.stableBindingCount) ||
       report.commitBindingVisitCount !=
           Int64(bindingPlan.stableBindingCount) +
               report.inferredBindingDeltaVisitCount ||
       report.inferredBindingCandidateVisitCount !=
           report.inferredBindingDeltaVisitCount +
               report.inferredBindingDuplicateVisitCount ||
       candidate.functions2_functionNameIds.len != ranges.sourcePaths.len:
        panic("typed expr: bounded function range build accounting drift")
    TypedExprIrEndValueExprBorrow(candidate)
    TypedExprIrMoveInto(ir, candidate)
    err = ""
    return true

fn typedExprFunctionSourceRangesValidateAppendMetadata(
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        ir: var TypedExprIr,
        err: var str): bool =
    if ir.typedExprMetadataSession == nil:
        err = ""
        return true
    let session = ir.typedExprMetadataSession
    if session.closed || session.released || session.index == nil:
        err = " typed expr: bounded append requires an active frozen metadata session"
        return false
    var seenContexts: bool[]
    setLen(seenContexts, sourceContexts.len)
    for rowIndex in 0..<ranges.sourceContextIndexes.len:
        let contextIndex = ranges.sourceContextIndexes[rowIndex]
        if seenContexts[contextIndex]:
            continue
        seenContexts[contextIndex] = true
        if sourceContexts[contextIndex].buildIndex != session.index ||
           sourceContexts[contextIndex].buildIndexOwned ||
           sourceContexts[contextIndex].frozenMetadataProjection != session.projection:
            err = Fmt" typed expr: bounded append frozen context ownership drift context={contextIndex}"
            return false
    err = ""
    return true

fn TypedExprAppendIrFunctionsForFunctionSourceRanges(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        sourceContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        ir: var TypedExprIr,
        report: var TypedExprFunctionSourceRangeBuildReport,
        err: var str): bool =
    var filterIndex: TypedExprFunctionFilterIndex
    var bindingPlan: typedExprFunctionBindingPlan
    if !typedExprFunctionSourceRangePreflight(sourceTexts,
                                              facts,
                                              exprLayer,
                                              sourceContexts,
                                              ranges,
                                              filterIndex,
                                              bindingPlan,
                                              report,
                                              err) ||
       !typedExprFunctionSourceRangesValidateAppendMetadata(sourceContexts,
                                                            ranges,
                                                            ir,
                                                            err):
        return false
    typedExprFunctionSourceRangeReportBegin(ir, report)
    if ir.typedExprMetadataSession == nil:
        TypedExprIrBeginValueExprBorrow(ir, exprLayer)
        typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
            ir, sourceContexts)
        TypedExprBuildSourceContextIndex(ir, sourceContexts)
        TypedExprIrAppendMetadataDefinitionsForFilter(ir,
                                                       sourceContexts,
                                                       filterIndex,
                                                       false,
                                                       true)
        TypedExprIrPrepareValueExprCallMetadata(ir, facts)
        typedExprFunctionSourceRangesCommit(facts,
                                            exprLayer,
                                            sourceContexts,
                                            ranges,
                                            bindingPlan,
                                            ir,
                                            report)
        TypedExprIrEndValueExprBorrow(ir)
    else:
        let session = typedExprPrepareFrozenMetadataOperation(ir,
                                                               "bounded append")
        var metadataRowsVisited: int64
        var metadataRowsExpected: int64
        var metadataContextCountExpected: int32
        var metadataContextCountObserved: int32
        var expectedContexts: bool[]
        setLen(expectedContexts, sourceContexts.len)
        for rowIndex in 0..<ranges.sourceContextIndexes.len:
            let contextIndex = ranges.sourceContextIndexes[rowIndex]
            if expectedContexts[contextIndex]:
                continue
            expectedContexts[contextIndex] = true
            let frozenContextIndex =
                sourceContexts[contextIndex].frozenMetadataContextIndex
            if frozenContextIndex < 0 ||
               frozenContextIndex >=
                   session.projection.contextMetadataRowCounts.len:
                err = Fmt" typed expr: bounded append expected metadata context missing context={contextIndex} frozen={frozenContextIndex}"
                return false
            metadataContextCountExpected =
                metadataContextCountExpected + 1
            # Header authorization touches zero canonical semantic rows.
        var visitedContexts: bool[]
        setLen(visitedContexts, sourceContexts.len)
        for rowIndex in 0..<ranges.sourceContextIndexes.len:
            let contextIndex = ranges.sourceContextIndexes[rowIndex]
            if visitedContexts[contextIndex]:
                continue
            visitedContexts[contextIndex] = true
            metadataContextCountObserved =
                metadataContextCountObserved + 1
            typedExprStageFrozenMetadataContextVisit(
                session,
                sourceContexts[contextIndex].frozenMetadataContextIndex,
                metadataRowsVisited)
        typedExprIrAppendMetadataDefinitionsForFrozenFrontier(ir,
                                                               session,
                                                               sourceContexts,
                                                               sourceTexts,
                                                               filterIndex,
                                                               false)
        var queryLookupCount: int32
        var queryProbeCount: int32
        var queryMetadataScanCount: int32
        typedExprBeginFrozenReadOnlyQueries(session,
                                            queryLookupCount,
                                            queryProbeCount,
                                            queryMetadataScanCount)
        TypedExprIrBeginValueExprBorrow(ir, exprLayer)
        TypedExprIrPrepareValueExprCallMetadata(ir, facts)
        typedExprFunctionSourceRangesCommit(facts,
                                            exprLayer,
                                            sourceContexts,
                                            ranges,
                                            bindingPlan,
                                            ir,
                                            report)
        TypedExprIrEndValueExprBorrow(ir)
        typedExprEndFrozenReadOnlyQueries(session,
                                          queryLookupCount,
                                          queryProbeCount,
                                          queryMetadataScanCount)
        if !TypedExprMetadataVisitReceiptExact(
                metadataContextCountExpected,
                metadataContextCountObserved,
                metadataRowsExpected,
                metadataRowsVisited):
            panic("typed expr: bounded append metadata conservation drift")
        report.sealedMetadataContextCountExpected =
            metadataContextCountExpected
        report.sealedMetadataContextCountObserved =
            metadataContextCountObserved
        report.sealedMetadataRowsExpected = metadataRowsExpected
        report.sealedMetadataRowsVisited = metadataRowsVisited
        typedExprCommitFrozenMetadataOperation(session, metadataRowsVisited)
    typedExprFunctionSourceRangeReportFinish(ir,
                                              ranges,
                                              bindingPlan,
                                              report)
    err = ""
    return true

@borrows
fn typedExprFunctionSourceRangeBorrowMetadataContexts(
        metadataContexts: var TypedExprSourceContext[]):
        TypedExprSourceContext[] =
    var preparedContexts: TypedExprSourceContext[]
    reserve(preparedContexts, metadataContexts.len)
    for contextIndex in 0..<metadataContexts.len:
        # Path-only unique seed. Attach owned-rebuilds metadata columns from
        # metadataContexts[contextIndex]; do not share original seqs.
        var seed: TypedExprSourceContext
        seed.sourcePath = share(metadataContexts[contextIndex].sourcePath)
        seed.normalizedSourcePath =
            share(metadataContexts[contextIndex].normalizedSourcePath)
        if seed.normalizedSourcePath == "" && seed.sourcePath != "":
            seed.normalizedSourcePath =
                parser.ParserNormalizePath(seed.sourcePath)
        TypedExprSourceContextAppendMove(preparedContexts, seed)
    return preparedContexts

@borrows
fn typedExprFunctionSourceRangeResolveScope(
        ctx: var TypedExprSourceContext,
        functionName: str,
        functionStartLine: int32,
        functionEndLine: int32,
        scopeIndex: var int32,
        err: var str): bool =
    scopeIndex = -1
    TypedExprScopeNameIndexPrepare(ctx)
    let bucket = TypedExprSourceContextIndexHash(
        functionName, ctx.scopeNameIndexBucketHeads.len)
    if bucket < 0:
        err = Fmt" typed expr: bounded function scope hash invalid function={functionName}"
        return false
    var entryIndex = ctx.scopeNameIndexBucketHeads[bucket]
    var sameNameCount: int32
    var firstSameNameStart: int32 = -1
    var firstSameNameEnd: int32 = -1
    while entryIndex >= 0:
        if entryIndex >= ctx.scopeNameIndexEntryNames.len ||
           entryIndex >= ctx.scopeNameIndexEntryScopeIndexes.len ||
           entryIndex >= ctx.scopeNameIndexEntryNext.len:
            panic("typed expr: bounded function scope index corrupt")
        let candidateIndex = ctx.scopeNameIndexEntryScopeIndexes[entryIndex]
        if candidateIndex < 0 || candidateIndex >= ctx.scopes.len:
            panic("typed expr: bounded function scope row corrupt")
        let candidate = ctx.scopes[candidateIndex]
        if ctx.scopeNameIndexEntryNames[entryIndex] == functionName &&
           candidate.name == functionName:
            sameNameCount = sameNameCount + 1
            if firstSameNameStart < 0:
                firstSameNameStart = candidate.startLine
                firstSameNameEnd = candidate.endLine
            if candidate.startLine == functionStartLine &&
               candidate.endLine == functionEndLine:
                if scopeIndex >= 0:
                    err = Fmt" typed expr: bounded function scope ambiguous source={ctx.sourcePath} function={functionName} start={functionStartLine} end={functionEndLine}"
                    return false
                scopeIndex = candidateIndex
        entryIndex = ctx.scopeNameIndexEntryNext[entryIndex]
    if scopeIndex < 0:
        err = Fmt" typed expr: bounded function scope missing source={ctx.sourcePath} function={functionName} start={functionStartLine} end={functionEndLine} same_name_count={sameNameCount} first_same_name_start={firstSameNameStart} first_same_name_end={firstSameNameEnd}"
        return false
    err = ""
    return true

fn typedExprFunctionSourceRangeContextLookupBuild(
        contexts: var TypedExprSourceContext[],
        lookup: var parser.ParserSourcePathIndexLookup,
        buildVisitCount: var int64,
        err: var str): bool =
    lookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(contexts.len), 2,
                                      "bounded_context_lookup_capacity"),
                8, "bounded_context_lookup_capacity"),
            "bounded_context_lookup_capacity"))
    buildVisitCount = Int64(0)
    for contextIndex in 0..<contexts.len:
        buildVisitCount = buildVisitCount + Int64(1)
        var sourcePathRaw = contexts[contextIndex].normalizedSourcePath
        if sourcePathRaw == "":
            sourcePathRaw = contexts[contextIndex].sourcePath
        var sourcePath: str
        if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, err):
            err = Fmt" typed expr: bounded context identity invalid index={contextIndex}: {err}"
            return false
        let existingIndex =
            parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                lookup, sourcePath)
        if existingIndex >= 0:
            err = Fmt" typed expr: bounded context identity duplicate source={sourcePath} first={existingIndex} next={contextIndex}"
            return false
        parser.ParserSourcePathIndexLookupInsertExact(lookup,
                                                       sourcePath,
                                                       contextIndex)
    err = ""
    return true

@borrows
fn typedExprBuildBoundedIrContextFromSealedRanges(
        source: var TypedExprSourceText,
        metadataContexts: var TypedExprSourceContext[],
        metadataContextIndex: int32,
        ranges: var TypedExprFunctionSourceRangeSet,
        sourcePath: str,
        ctx: var TypedExprSourceContext,
        err: var str): bool =
    if metadataContextIndex < 0 ||
       metadataContextIndex >= metadataContexts.len:
        err = Fmt" typed expr: bounded sealed metadata context index invalid source={sourcePath} index={metadataContextIndex} count={metadataContexts.len}"
        return false
    var metadataCtx = TypedExprSourceContextBorrowedView(
        metadataContexts[metadataContextIndex])
    if metadataCtx.frozenMetadataProjection == nil ||
       metadataCtx.frozenMetadataContextIndex < 0:
        err = Fmt" typed expr: bounded sealed source projection missing source={sourcePath}"
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(), "O8SITE=sealed_proj_miss")
        TypedExprClearSourceContextAllFields(metadataCtx)
        return false
    var selectedScopeIndexes: int32[]
    var selectedLineStarts: int32[]
    var selectedLineCounts: int32[]
    for rowIndex in 0..<ranges.sourcePaths.len:
        if !typedExprExactTextEqual(ranges.sourcePaths[rowIndex], sourcePath):
            continue
        let functionStartLine = ranges.functionStartLines[rowIndex]
        let functionEndLine = ranges.functionEndLines[rowIndex]
        if functionStartLine <= 0 || functionEndLine < functionStartLine:
            err = Fmt" typed expr: bounded sealed source range invalid source={sourcePath} row={rowIndex} start={functionStartLine} end={functionEndLine}"
            if orcd8TraceEnabled():
                os.WriteLine(os.Get_stderr(), "O8SITE=sealed_range_invalid")
            TypedExprClearSourceContextAllFields(metadataCtx)
            return false
        var functionScopeIndex: int32
        if !typedExprFunctionSourceRangeResolveScope(
                metadataCtx,
                ranges.functionNames[rowIndex],
                functionStartLine,
                functionEndLine,
                functionScopeIndex,
                err):
            if orcd8TraceEnabled():
                os.WriteLine(os.Get_stderr(), "O8SITE=sealed_scope_fail")
            TypedExprClearSourceContextAllFields(metadataCtx)
            return false
        add(selectedScopeIndexes, functionScopeIndex)
        add(selectedLineStarts, functionStartLine)
        add(selectedLineCounts, functionEndLine - functionStartLine + 1)
    if selectedScopeIndexes.len <= 0:
        err = Fmt" typed expr: bounded sealed source has no selected range source={sourcePath}"
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(), "O8SITE=sealed_no_sel")
        TypedExprClearSourceContextAllFields(metadataCtx)
        return false
    let ok = typedExprBuildFactsContextFromSelectedMetadata(
        source,
        metadataCtx,
        metadataContexts,
        "",
        selectedScopeIndexes,
        selectedLineStarts,
        selectedLineCounts,
        ctx,
        err)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SITE=sealed_post_build")
    TypedExprClearSourceContextAllFields(metadataCtx)
    return ok

fn typedExprPrepareFunctionSourceRangeContexts(
        sourceTexts: var TypedExprSourceText[],
        ranges: var TypedExprFunctionSourceRangeSet,
        metadataContexts: var TypedExprSourceContext[],
        preparedContexts: var TypedExprSourceContext[],
        preparedRanges: var TypedExprFunctionSourceRangeSet,
        contextIndexBuildVisitCount: var int64,
        contextIndexLookupCount: var int64,
        err: var str): bool =
    if !ranges.sealed || !typedExprFunctionSourceRangeColumnsComplete(ranges) ||
       ranges.sourcePaths.len <= 0 ||
       ranges.sourcePaths.len != ranges.expectedRowCount:
        err = " typed expr: bounded function context preparation requires sealed ranges"
        return false
    if metadataContexts.len != preparedContexts.len:
        err = Fmt" typed expr: bounded function metadata/prepared index mismatch metadata={metadataContexts.len} prepared={preparedContexts.len}"
        return false
    var filterIndex: TypedExprFunctionFilterIndex
    if !TypedExprBuildFunctionFilterIndex(sourceTexts,
                                          true,
                                          ranges.sourcePaths,
                                          ranges.functionNames,
                                          ranges.functionStartLines,
                                          filterIndex,
                                          err):
        return false
    var sourceIdentityIndex: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(sourceTexts,
                                           sourceIdentityIndex,
                                           err):
        return false
    var contextLookup: parser.ParserSourcePathIndexLookup
    if !typedExprFunctionSourceRangeContextLookupBuild(
            preparedContexts,
            contextLookup,
            contextIndexBuildVisitCount,
            err):
        return false
    contextIndexLookupCount = Int64(0)
    var preparedSourceContexts: bool[]
    setLen(preparedSourceContexts, preparedContexts.len)
    preparedRanges = TypedExprFunctionSourceRangeSetInit(
        ranges.expectedRowCount)
    for rowIndex in 0..<ranges.sourcePaths.len:
        let sourcePath = ranges.sourcePaths[rowIndex]
        contextIndexLookupCount = contextIndexLookupCount + Int64(1)
        let contextIndex =
            parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                contextLookup, sourcePath)
        if contextIndex < 0 || contextIndex >= preparedContexts.len:
            err = Fmt" typed expr: bounded function metadata context missing row={rowIndex} source={sourcePath} context={contextIndex}"
            return false
        if !preparedSourceContexts[contextIndex]:
            var sourceIndex: int32
            if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                                  sourcePath,
                                                  sourceIndex,
                                                  err) ||
               sourceIndex < 0 || sourceIndex >= sourceTexts.len:
                if err == "":
                    err = Fmt" typed expr: bounded function source text missing source={sourcePath}"
                return false
            TypedExprEnsureSourceTextLoaded(sourceTexts[sourceIndex])
            var rebuiltContext: TypedExprSourceContext
            let includeColdCsgRowsForIr =
                os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_ROWS") == "1" ||
                os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_STATEMENTS") == "1"
            var contextBuilt = false
            if includeColdCsgRowsForIr ||
               metadataContexts[contextIndex].frozenMetadataProjection == nil:
                # includeTypeFields must be true here: the context rebuild's
                # binding loop types binding-initializer calls and resolves
                # `param.field` static argument types through the declared
                # field rows scanned by the type-metadata pass. With the scan
                # disabled the loop saw no local field rows and every
                # `let r = callee(owner.field, ...)` initializer failed with
                # "call declaration static argument type unavailable".
                # TypedExprAttachStableMetadataToRebuildContext replaces these
                # columns with the metadata context's authoritative copies
                # afterwards, so nothing downstream sees a second-class scan.
                contextBuilt = TypedExprBuildSourceContextBorrowed(
                    sourceTexts[sourceIndex],
                    rebuiltContext,
                    true,
                    includeColdCsgRowsForIr,
                    true,
                    filterIndex,
                    err)
                if contextBuilt:
                    TypedExprAttachStableMetadataToRebuildContext(
                        rebuiltContext, metadataContexts[contextIndex])
                    typedExprAttachParserOwnedGlobalBindings(
                        rebuiltContext, metadataContexts[contextIndex])
                    contextBuilt = TypedExprEnsureSourceContextLinesLoaded(
                        sourceTexts[sourceIndex], rebuiltContext, err)
            else:
                contextBuilt =
                    typedExprBuildBoundedIrContextFromSealedRanges(
                        sourceTexts[sourceIndex],
                        metadataContexts,
                        contextIndex,
                        ranges,
                        sourcePath,
                        rebuiltContext,
                        err)
            if !contextBuilt:
                if orcd8TraceEnabled():
                    os.WriteLine(os.Get_stderr(), "O8SITE=rebuild_fail")
                TypedExprClearSourceContextAllFields(rebuiltContext)
                if err != "":
                    err = Fmt" typed expr: bounded function source context failed source={sourcePath}: {err}"
                else:
                    err = Fmt" typed expr: bounded function source context failed source={sourcePath}"
                return false
            TypedExprSourceContextMoveInto(preparedContexts[contextIndex],
                                           rebuiltContext)
            preparedSourceContexts[contextIndex] = true
        var functionScopeIndex: int32
        if !typedExprFunctionSourceRangeResolveScope(
                preparedContexts[contextIndex],
                ranges.functionNames[rowIndex],
                ranges.functionStartLines[rowIndex],
                ranges.functionEndLines[rowIndex],
                functionScopeIndex,
                err):
            return false
        TypedExprFunctionSourceRangeSetAppend(
            preparedRanges,
            sourcePath,
            share(ranges.functionNames[rowIndex]),
            ranges.functionStartLines[rowIndex],
            ranges.functionEndLines[rowIndex],
            contextIndex,
            functionScopeIndex,
            ranges.sourceScopeRootIndexes[rowIndex],
            ranges.exprPhysicalStarts[rowIndex],
            ranges.exprCounts[rowIndex],
            ranges.factPhysicalStarts[rowIndex],
            ranges.factCounts[rowIndex],
            ranges.scopeStarts[rowIndex],
            ranges.scopeCounts[rowIndex],
            ranges.statementStarts[rowIndex],
            ranges.statementCounts[rowIndex])
    TypedExprFunctionSourceRangeSetSeal(preparedRanges)
    err = ""
    return true

fn TypedExprBuildIrForFunctionSourceRangesFromMetadata(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        metadataContexts: var TypedExprSourceContext[],
        ranges: var TypedExprFunctionSourceRangeSet,
        ir: var TypedExprIr,
        report: var TypedExprFunctionSourceRangeBuildReport,
        err: var str): bool =
    report = TypedExprFunctionSourceRangeBuildReport()
    var candidate: TypedExprIr
    candidate.internPool = langintern.InternPoolNew()
    if ir.exactTypeArena == nil || !ir.valueDefinitionTypeArenaBound:
        err = " typed expr: bounded metadata build requires exact TypeArena authority"
        TypedExprIrReleasePayload(candidate)
        return false
    var candidateExactTypeArena = share(ir.exactTypeArena)
    if !TypedExprIrBindExactTypeArena(
           candidate, candidateExactTypeArena, err):
        TypedExprIrReleasePayload(candidate)
        return false
    # Context reconstruction resolves local calls while it rebuilds bindings,
    # so the complete canonical metadata index must exist before preparation.
    # Build it on the private candidate: the destination IR remains unchanged
    # until the final move, and every rebuilt context borrows this exact index.
    TypedExprIrBeginValueExprBorrow(candidate, exprLayer)
    typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
        candidate, metadataContexts)
    # csg stamps the exact declaration layout authority onto the retained ir
    # before the first reach round (compiler csg bind). The candidate is a
    # fresh ir and prepare just zero-initialized its authority columns, so
    # the stamp facts must move across or the layout consumer below reads
    # state==0 and the bind stamps die with the final move. Mirror the
    # exactTypeArena share above: carry only rows the ir actually stamped,
    # after asserting both index domains are the same coordinate space that
    # prepare derived from the same contexts. Unstamped rows stay untouched,
    # which keeps declaration-free sources byte-identical.
    if ir.exactLayoutIndexSourceStarts.len > 0:
        if ir.exactLayoutIndexSourceStarts.len !=
               candidate.exactLayoutIndexSourceStarts.len:
            panic("typed expr: exact layout inherited authority source domain drift")
        for sourceId in 0..<candidate.exactLayoutIndexSourceStarts.len:
            if ir.exactLayoutIndexSourceStarts[sourceId] !=
                   candidate.exactLayoutIndexSourceStarts[sourceId]:
                panic("typed expr: exact layout inherited authority coordinate drift")
        for index in 0..<candidate.exactLayoutDeclarationAuthorityStates.len:
            if ir.exactLayoutDeclarationAuthorityStates[index] == 0:
                continue
            if candidate.exactLayoutDeclarationAuthorityStates[index] != 0:
                panic("typed expr: exact layout inherited authority conflict")
            candidate.exactLayoutDeclarationAuthorityStates[index] =
                ir.exactLayoutDeclarationAuthorityStates[index]
            candidate.exactLayoutDeclarationTypeArenaIds[index] =
                ir.exactLayoutDeclarationTypeArenaIds[index]
            candidate.exactLayoutDeclarationSizeBytes[index] =
                ir.exactLayoutDeclarationSizeBytes[index]
            candidate.exactLayoutDeclarationAlignBytes[index] =
                ir.exactLayoutDeclarationAlignBytes[index]
            candidate.exactLayoutDeclarationGenericSymbolCounts[index] =
                ir.exactLayoutDeclarationGenericSymbolCounts[index]
    TypedExprBuildSourceContextIndex(candidate, metadataContexts)
    var preparedContexts =
        typedExprFunctionSourceRangeBorrowMetadataContexts(metadataContexts)
    var preparedRanges: TypedExprFunctionSourceRangeSet
    var contextIndexBuildVisitCount: int64
    var contextIndexLookupCount: int64
    if !typedExprPrepareFunctionSourceRangeContexts(sourceTexts,
                                                     ranges,
                                                     metadataContexts,
                                                     preparedContexts,
                                                     preparedRanges,
                                                     contextIndexBuildVisitCount,
                                                     contextIndexLookupCount,
                                                     err):
        typedExprReleaseFrozenRoundContexts(preparedContexts)
        typedExprSourceContextsDetachBorrowedBuildIndex(
            metadataContexts, candidate.buildIndex)
        TypedExprIrReleasePayload(candidate)
        return false
    var filterIndex: TypedExprFunctionFilterIndex
    var bindingPlan: typedExprFunctionBindingPlan
    if !typedExprFunctionSourceRangePreflight(sourceTexts,
                                              facts,
                                              exprLayer,
                                              preparedContexts,
                                              preparedRanges,
                                              filterIndex,
                                              bindingPlan,
                                              report,
                                              err):
        typedExprReleaseFrozenRoundContexts(preparedContexts)
        typedExprSourceContextsDetachBorrowedBuildIndex(
            metadataContexts, candidate.buildIndex)
        TypedExprIrReleasePayload(candidate)
        return false
    report.contextIndexBuildVisitCount = contextIndexBuildVisitCount
    report.contextIndexLookupCount = contextIndexLookupCount
    typedExprFunctionSourceRangeReportBegin(ir, report)
    # The canonical metadata index is built from the complete contexts that the
    # caller will seal. Filtered contexts carry only current-round body rows and
    # borrow that same index during bounded commit.
    TypedExprIrPrepareValueExprCallMetadata(candidate, facts)
    TypedExprIrAppendMetadataDefinitionsForFilter(candidate,
                                                   metadataContexts,
                                                   filterIndex,
                                                   false,
                                                   true)
    for contextIndex in 0..<preparedContexts.len:
        TypedExprSourceContextSetBorrowedBuildIndex(
            preparedContexts[contextIndex], candidate.buildIndex)
    typedExprFunctionSourceRangesCommit(facts,
                                        exprLayer,
                                        preparedContexts,
                                        preparedRanges,
                                        bindingPlan,
                                        candidate,
                                        report)
    report.functionCountBefore = ir.functions2_functionNameIds.len
    report.statementCountBefore = ir.statements2_statementIndexs.len
    report.nodeCountBefore = ir.nodes2_nodeIndexs.len
    report.functionCountAfter = candidate.functions2_functionNameIds.len
    report.statementCountAfter = candidate.statements2_statementIndexs.len
    report.nodeCountAfter = candidate.nodes2_nodeIndexs.len
    if report.activeRangeCount != 0 || report.activeRangePeak != 1 ||
       report.commitRowVisitCount != Int64(preparedRanges.sourcePaths.len) ||
       report.commitExprVisitCount != report.preflightExprVisitCount ||
       report.commitFactVisitCount != report.preflightFactVisitCount ||
       report.commitScopeVisitCount != report.preflightScopeVisitCount ||
       report.commitStatementVisitCount != report.preflightStatementVisitCount ||
       report.bindingIndexBuildVisitCount !=
           Int64(bindingPlan.stableBindingCount) ||
       report.bindingIndexFillVisitCount !=
           Int64(bindingPlan.stableBindingCount) ||
       report.commitBindingVisitCount !=
           Int64(bindingPlan.stableBindingCount) +
               report.inferredBindingDeltaVisitCount ||
       report.inferredBindingCandidateVisitCount !=
           report.inferredBindingDeltaVisitCount +
               report.inferredBindingDuplicateVisitCount ||
       report.contextIndexBuildVisitCount !=
           Int64(preparedContexts.len) ||
       report.contextIndexLookupCount !=
           Int64(preparedRanges.sourcePaths.len) ||
       candidate.functions2_functionNameIds.len !=
           preparedRanges.sourcePaths.len:
        panic("typed expr: bounded metadata function range build accounting drift")
    TypedExprIrEndValueExprBorrow(candidate)
    TypedExprIrMoveInto(ir, candidate)
    typedExprReleaseFrozenRoundContexts(preparedContexts)
    err = ""
    return true

fn TypedExprAppendIrFunctionsForFunctionSourceRangesSealed(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        ranges: var TypedExprFunctionSourceRangeSet,
        ir: var TypedExprIr,
        report: var TypedExprFunctionSourceRangeBuildReport,
        err: var str): bool =
    report = TypedExprFunctionSourceRangeBuildReport()
    typedExprPreflightFrozenMetadataOperation(ir, "bounded append entry")
    let session = ir.typedExprMetadataSession
    let roundPeakBefore = session.roundPeakBytes
    let lastRoundContextBefore = session.lastRoundContextCount
    let lastRoundDependencyBefore = session.lastRoundDependencyCount
    var roundSourcePaths: str[]
    var roundSourcePathLookup =
        parser.ParserSourcePathIndexLookupInit(32)
    for rowIndex in 0..<ranges.sourcePaths.len:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            roundSourcePaths,
            roundSourcePathLookup,
            ranges.sourcePaths[rowIndex])
    var roundDependencySourcePaths: str[]
    var roundDependencySourcePathLookup =
        parser.ParserSourcePathIndexLookupInit(32)
    for exprIndex in 0..<exprLayer.exprs.len:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            roundDependencySourcePaths,
            roundDependencySourcePathLookup,
            exprLayer.exprs[exprIndex].callTargetSourcePath)
    for factIndex in 0..<facts.count:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            roundDependencySourcePaths,
            roundDependencySourcePathLookup,
            TypedExprFactAt(facts, factIndex).callTargetSourcePath)
    var roundScopeRows: int32[]
    if !typedExprFrozenExactScopeRows(session,
                                      ranges.sourcePaths,
                                      ranges.functionNames,
                                      ranges.functionStartLines,
                                      ranges.functionEndLines,
                                      roundScopeRows,
                                      err):
        session.roundPeakBytes = roundPeakBefore
        session.lastRoundContextCount = lastRoundContextBefore
        session.lastRoundDependencyCount = lastRoundDependencyBefore
        return false
    var roundContexts: TypedExprSourceContext[]
    if !typedExprFrozenBuildRoundViews(session,
                                       roundSourcePaths,
                                       roundDependencySourcePaths,
                                       true,
                                       roundScopeRows,
                                       roundContexts,
                                       err):
        typedExprReleaseFrozenRoundViews(session, roundContexts)
        session.roundPeakBytes = roundPeakBefore
        session.lastRoundContextCount = lastRoundContextBefore
        session.lastRoundDependencyCount = lastRoundDependencyBefore
        return false
    let roundContextCount = session.roundContextCount
    let roundDependencyCount = session.roundDependencyCount
    var preparedContexts =
        typedExprFunctionSourceRangeBorrowMetadataContexts(roundContexts)
    var preparedRanges: TypedExprFunctionSourceRangeSet
    var contextIndexBuildVisitCount: int64
    var contextIndexLookupCount: int64
    if !typedExprPrepareFunctionSourceRangeContexts(sourceTexts,
                                                     ranges,
                                                     roundContexts,
                                                     preparedContexts,
                                                     preparedRanges,
                                                     contextIndexBuildVisitCount,
                                                     contextIndexLookupCount,
                                                     err):
        typedExprReleaseFrozenRoundContexts(preparedContexts)
        typedExprReleaseFrozenRoundViews(session, roundContexts)
        session.roundPeakBytes = roundPeakBefore
        session.lastRoundContextCount = lastRoundContextBefore
        session.lastRoundDependencyCount = lastRoundDependencyBefore
        return false
    let ok = TypedExprAppendIrFunctionsForFunctionSourceRanges(
        sourceTexts,
        facts,
        exprLayer,
        preparedContexts,
        preparedRanges,
        ir,
        report,
        err)
    report.contextIndexBuildVisitCount = contextIndexBuildVisitCount
    report.contextIndexLookupCount = contextIndexLookupCount
    if ok:
        if report.contextIndexBuildVisitCount != Int64(preparedContexts.len) ||
           report.contextIndexLookupCount !=
               Int64(preparedRanges.sourcePaths.len):
            panic("typed expr: bounded sealed context index accounting drift")
        report.sealedRoundViewUsed = true
        report.sealedRoundContextCount = roundContextCount
        report.sealedRoundDependencyCount = roundDependencyCount
    else:
        session.roundPeakBytes = roundPeakBefore
        session.lastRoundContextCount = lastRoundContextBefore
        session.lastRoundDependencyCount = lastRoundDependencyBefore
    typedExprReleaseFrozenRoundContexts(preparedContexts)
    typedExprReleaseFrozenRoundViews(session, roundContexts)
    return ok

@borrows
fn TypedExprBuildIrWithFactsMetadataAndExprLayerImpl(sourceTexts: var TypedExprSourceText[],
                                                      facts: var TypedExprFactTable,
                                                      exprLayer: var parser.NormalizedExprLayer,
                                                      metadataContexts: var TypedExprSourceContext[],
                                                      filterActive: bool,
                                                      filterSourcePaths: str[],
                                                      filterFunctionNames: str[],
                                                      filterStartLines: int32[],
                                                      preserveTypeInfo: bool,
                                                      appendOnly: bool,
                                                      sealedSessionMode: bool,
                                                      ir: var TypedExprIr,
                                                      err: var str): bool =
    TypedExprIrBeginValueExprBorrow(ir, exprLayer)
    let ok = TypedExprBuildIrWithFactsMetadataAndExprLayerCore(
        sourceTexts,
        facts,
        exprLayer,
        metadataContexts,
        filterActive,
        filterSourcePaths,
        filterFunctionNames,
        filterStartLines,
        preserveTypeInfo,
        appendOnly,
        sealedSessionMode,
        ir,
        err)
    TypedExprIrEndValueExprBorrow(ir)
    return ok

@borrows
fn TypedExprBuildIrWithFactsMetadataAndExprLayerCore(sourceTexts: var TypedExprSourceText[],
                                                      facts: var TypedExprFactTable,
                                                      exprLayer: var parser.NormalizedExprLayer,
                                                      metadataContexts: var TypedExprSourceContext[],
                                                      filterActive: bool,
                                                      filterSourcePaths: str[],
                                                      filterFunctionNames: str[],
                                                      filterStartLines: int32[],
                                                      preserveTypeInfo: bool,
                                                      appendOnly: bool,
                                                      sealedSessionMode: bool,
                                                      ir: var TypedExprIr,
                                                      err: var str): bool =
    TypedExprValidateNormalizedDeferFacts(exprLayer)
    var normalizedScopeIndex = TypedExprNormalizedScopeIndexBuild(exprLayer)
    var frozenSession: typedExprFrozenMetadataSession
    var metadataRowsVisited: int64
    if sealedSessionMode:
        if !appendOnly:
            err = " typed expr: frozen metadata session requires append-only mode"
            return false
        frozenSession = typedExprPrepareFrozenMetadataOperation(ir, "append")
    elif ir.typedExprMetadataSession != nil:
        panic("typed expr: ordinary IR build API cannot consume an active frozen metadata session")
    var buildIndexAlreadyValidated = false
    if appendOnly && !sealedSessionMode:
        if metadataContexts.len <= 0:
            err = " typed expr: ordinary append requires metadata contexts"
            return false
        # Legacy append remains a deliberately expensive compatibility API.
        # It always performs complete metadata validation, even without a filter.
        typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
            ir, metadataContexts)
        TypedExprBuildSourceContextIndex(ir, metadataContexts)
        buildIndexAlreadyValidated = true
    var functionFilterIndex: TypedExprFunctionFilterIndex
    if sourceTexts.len > 0:
        if !TypedExprBuildFunctionFilterIndex(sourceTexts,
                                              filterActive,
                                              filterSourcePaths,
                                              filterFunctionNames,
                                              filterStartLines,
                                              functionFilterIndex,
                                              err):
            return false
    elif filterActive:
        err = " typed expr: active function filter has no source identity roots"
        return false
    if sealedSessionMode:
        if !typedExprValidateSnapshotOnlyIrInputsFrozen(sourceTexts,
                                                        frozenSession,
                                                        facts,
                                                        exprLayer,
                                                        filterActive,
                                                        filterSourcePaths,
                                                        filterFunctionNames,
                                                        filterStartLines,
                                                        err):
            return false
    else:
        if !TypedExprValidateSnapshotOnlyIrInputs(sourceTexts,
                                                  metadataContexts,
                                                  facts,
                                                  exprLayer,
                                                  filterActive,
                                                  filterSourcePaths,
                                                  filterFunctionNames,
                                                  filterStartLines,
                                                  err):
            return false
    if !appendOnly:
        TypedExprClearIrForMetadataRebuild(ir, preserveTypeInfo)
    TypedExprIrPrepareValueExprCallMetadata(ir, facts)
    if !sealedSessionMode && facts.count <= 0 && metadataContexts.len <= 0:
        return TypedExprBuildIrWithFactsAndExprLayerCore(sourceTexts,
                                                         facts,
                                                         exprLayer,
                                                         ir,
                                                         err)
    if !sealedSessionMode && sourceTexts.len > 0 && metadataContexts.len <= 0:
        err = Fmt" typed expr: metadata contexts empty source_count={sourceTexts.len} fact_count={facts.count} expr_count={exprLayer.exprs.len}"
        return false
    let traceTypedIr = os.GetEnv("CHENG_TYPED_IR_TRACE") == "1"
    if traceTypedIr:
        TypedExprTraceLine("typed_ir_stream:source_text_count")
    var debugScopeTotal: int32
    var debugImportcTotal: int32
    var debugFirstSourcePath = ""
    var debugFirstScopeCount: int32
    var debugFirstImportcCount: int32
    if sealedSessionMode:
        debugScopeTotal = frozenSession.scopeCount
        debugImportcTotal = frozenSession.importcCount
        if frozenSession.contextCount > 0:
            debugFirstSourcePath = typedExprFrozenProjectionText(
                frozenSession.projection,
                frozenSession.projection.rawSourcePathIds[0])
            debugFirstScopeCount = frozenSession.projection.scopes.contextCounts[0]
            debugFirstImportcCount = frozenSession.projection.importcs.contextCounts[0]
    elif metadataContexts.len > 0:
        debugFirstSourcePath = metadataContexts[0].sourcePath
        debugFirstScopeCount = metadataContexts[0].scopes.len
        debugFirstImportcCount = metadataContexts[0].importcFunctions.len
        for contextIndex in 0..<metadataContexts.len:
            debugScopeTotal = debugScopeTotal + metadataContexts[contextIndex].scopes.len
            debugImportcTotal = debugImportcTotal + metadataContexts[contextIndex].importcFunctions.len
    if debugScopeTotal <= 0 && sourceTexts.len > 0:
        err = Fmt" typed expr: metadata contexts contain no local scopes source_count={sourceTexts.len} fact_count={facts.count} expr_count={exprLayer.exprs.len} context_count={metadataContexts.len} importc_total={debugImportcTotal} first_source={debugFirstSourcePath} first_scope_count={debugFirstScopeCount} first_importc_count={debugFirstImportcCount}"
        return false
    var factSourceRanges = TypedExprSourceRangeIndexBuildFromFacts(facts)
    var exprSourceRanges = TypedExprSourceRangeIndexBuildFromExprLayer(exprLayer)
    var preparedContexts: TypedExprSourceContext[]
    var preparedSourceIndexes: int32[]
    var preparedMetadataContextIndexes: int32[]
    if sealedSessionMode:
        for sourceIndex in 0..<sourceTexts.len:
            os.ProcessResourceGuardCheck()
            if !TypedExprFunctionFilterHasSource(functionFilterIndex,
                                                  sourceTexts[sourceIndex].sourcePath):
                continue
            let metadataContextIndex = typedExprFrozenContextIndex(
                frozenSession,
                sourceTexts[sourceIndex].sourcePath)
            if metadataContextIndex < 0:
                typedExprReleaseFrozenRoundContexts(preparedContexts)
                err = Fmt" typed expr: missing metadata context for source {sourceTexts[sourceIndex].sourcePath}"
                return false
            let metadataViewIndex = TypedExprSourceContextLookup(
                metadataContexts,
                sourceTexts[sourceIndex].sourcePath)
            if metadataViewIndex < 0:
                panic("typed expr: frozen append metadata projection view missing")
            typedExprStageFrozenMetadataContextVisit(frozenSession,
                                                      metadataContextIndex,
                                                      metadataRowsVisited)
            var preparedContext: TypedExprSourceContext
            let includeColdCsgRowsForIr =
                os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_ROWS") == "1" ||
                os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_STATEMENTS") == "1"
            TypedExprEnsureSourceTextLoaded(sourceTexts[sourceIndex])
            if orcd8TraceEnabled():
                os.WriteLine(os.Get_stderr(), "O8SITE=facts_fail_1")
            if !TypedExprBuildSourceContextBorrowed(sourceTexts[sourceIndex],
                                                    preparedContext,
                                                    true,
                                                    includeColdCsgRowsForIr,
                                                    false,
                                                    functionFilterIndex,
                                                    err):
                TypedExprClearSourceContextAllFields(preparedContext)
                typedExprReleaseFrozenRoundContexts(preparedContexts)
                if err != "":
                    err = parser.ParserConcat2(
                        " typed expr: build typed ir source context failed: ",
                        parser.ParserOwnedText(err))
                else:
                    err = " typed expr: build typed ir source context failed"
                return false
            TypedExprAttachStableMetadataToRebuildContext(
                preparedContext,
                metadataContexts[metadataViewIndex])
            typedExprAttachParserOwnedGlobalBindings(
                preparedContext,
                metadataContexts[metadataViewIndex])
            if orcd8TraceEnabled():
                os.WriteLine(os.Get_stderr(), "O8SITE=facts_fail_2")
            if !TypedExprEnsureSourceContextLinesLoaded(sourceTexts[sourceIndex],
                                                        preparedContext,
                                                        err):
                TypedExprClearSourceContextAllFields(preparedContext)
                typedExprReleaseFrozenRoundContexts(preparedContexts)
                if err != "":
                    err = parser.ParserConcat2(
                        " typed expr: reload typed ir source lines failed: ",
                        parser.ParserOwnedText(err))
                else:
                    err = " typed expr: reload typed ir source lines failed"
                return false
            add(preparedSourceIndexes, sourceIndex)
            add(preparedMetadataContextIndexes, metadataContextIndex)
            TypedExprSourceContextAppendMove(preparedContexts, preparedContext)
    if traceTypedIr:
        TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_enter sources={sourceTexts.len} facts={facts.count} exprs={exprLayer.exprs.len} metadata={metadataContexts.len}")
    if !appendOnly || filterActive:
        if sealedSessionMode:
            typedExprIrAppendMetadataDefinitionsForFrozenFrontier(ir,
                                                                  frozenSession,
                                                                  metadataContexts,
                                                                  sourceTexts,
                                                                  functionFilterIndex,
                                                                  traceTypedIr)
        else:
            TypedExprIrAppendMetadataDefinitionsForFilter(ir,
                                                           metadataContexts,
                                                           functionFilterIndex,
                                                           traceTypedIr,
                                                           buildIndexAlreadyValidated)
    var preparedContextCursor: int32
    var sealedEmittedScopeCount: int32
    for i in 0..<sourceTexts.len:
        os.ProcessResourceGuardCheck()
        if !TypedExprFunctionFilterHasSource(functionFilterIndex,
                                             sourceTexts[i].sourcePath):
            continue
        var metadataContextIndex: int32
        var ctx: TypedExprSourceContext
        if sealedSessionMode:
            if preparedContextCursor >= preparedContexts.len ||
               preparedSourceIndexes[preparedContextCursor] != i:
                panic("typed expr: frozen append prepared context order drift")
            metadataContextIndex =
                preparedMetadataContextIndexes[preparedContextCursor]
            TypedExprSourceContextMoveInto(
                ctx,
                preparedContexts[preparedContextCursor])
            preparedContextCursor = preparedContextCursor + 1
        else:
            metadataContextIndex = TypedExprSourceContextLookupFast(ir,
                                                                    metadataContexts,
                                                                    sourceTexts[i].sourcePath)
        if metadataContextIndex < 0:
            if sealedSessionMode:
                panic("typed expr: frozen append committed missing metadata context")
            err = Fmt" typed expr: missing metadata context for source {sourceTexts[i].sourcePath}"
            return false
        if traceTypedIr:
            TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_before_source_context source={sourceTexts[i].sourcePath} text_len={sourceTexts[i].text.len}")
        if !sealedSessionMode:
            let includeColdCsgRowsForIr = os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_ROWS") == "1" ||
                                          os.GetEnv("CHENG_TYPED_IR_KEEP_COLD_CSG_STATEMENTS") == "1"
            TypedExprEnsureSourceTextLoaded(sourceTexts[i])
            if !TypedExprBuildSourceContextBorrowed(sourceTexts[i],
                                                    ctx,
                                                    true,
                                                    includeColdCsgRowsForIr,
                                                    false,
                                                    functionFilterIndex,
                                                    err):
                if err != "":
                    err = parser.ParserConcat2(
                        " typed expr: build typed ir source context failed: ",
                        parser.ParserOwnedText(err))
                else:
                    err = " typed expr: build typed ir source context failed"
                return false
        TypedExprClearSourceTextBody(sourceTexts[i])
        if !sealedSessionMode:
            TypedExprAttachStableMetadataToRebuildContext(ctx, metadataContexts[metadataContextIndex])
            typedExprAttachParserOwnedGlobalBindings(ctx, metadataContexts[metadataContextIndex])
            if !TypedExprEnsureSourceContextLinesLoaded(sourceTexts[i], ctx, err):
                if err != "":
                    err = parser.ParserConcat2(
                        " typed expr: reload typed ir source lines failed: ",
                        parser.ParserOwnedText(err))
                else:
                    err = " typed expr: reload typed ir source lines failed"
                return false
        let ctxSourcePath = share(ctx.sourcePath)
        if traceTypedIr:
            TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_after_source_context scopes={ctx.scopes.len} lines={ctx.lines.len} bindings={ctx.bindings.len}")
        TypedExprIrAppendColdCsgRowsFromContext(ir, ctx)
        let sourceFactRange = TypedExprSourceRangeIndexFind(factSourceRanges, ctxSourcePath)
        var sourceFactStart: int32
        var sourceFactEnd: int32
        var factCursor: int32
        if sourceFactRange >= 0:
            sourceFactStart = factSourceRanges.starts[sourceFactRange]
            sourceFactEnd = factSourceRanges.ends[sourceFactRange]
            factCursor = sourceFactStart
            TypedExprAppendInferredCallBindings(ctx,
                                                metadataContexts,
                                                facts,
                                                sourceFactStart,
                                                sourceFactEnd)
        else:
            sourceFactEnd = 0
            factCursor = 0
        TypedExprAppendInferredIndexBindings(ir, ctx, metadataContexts)
        TypedExprIrAppendBindingsFromContext(ir, ctx)
        let sourceExprRange = TypedExprSourceRangeIndexFind(exprSourceRanges, ctxSourcePath)
        var sourceExprStart: int32
        var sourceExprEnd: int32
        var exprCursor: int32
        if sourceExprRange >= 0:
            sourceExprStart = exprSourceRanges.starts[sourceExprRange]
            sourceExprEnd = exprSourceRanges.ends[sourceExprRange]
            exprCursor = sourceExprStart
        else:
            sourceExprEnd = 0
            exprCursor = 0
        var stableScopes: TypedExprFunctionScope[]
        for stableScopeIndex in 0..<ctx.scopes.len:
            let scopeForStable = ctx.scopes[stableScopeIndex]
            if facts.count > 0:
                if sealedSessionMode:
                    if !typedExprFrozenMetadataHasScope(frozenSession,
                                                        metadataContextIndex,
                                                        scopeForStable):
                        continue
                elif !TypedExprMetadataContextHasScope(metadataContexts[metadataContextIndex],
                                                       scopeForStable):
                    continue
            if !TypedExprFunctionFilterAllowsScope(functionFilterIndex,
                                                   ctxSourcePath,
                                                   scopeForStable):
                continue
            add(stableScopes, share(scopeForStable))
        let typedFilterDebugTarget = TypedExprFilterDebugEnvName()
        if typedFilterDebugTarget != "":
            var debugCandidateScopes: int32
            var debugCtxMatches: int32
            var debugMetaMatches: int32
            var debugFilterAllows: int32
            for debugScopeIndex in 0..<stableScopes.len:
                let debugScope = stableScopes[debugScopeIndex]
                let debugFilterOk = TypedExprFunctionFilterAllowsScope(functionFilterIndex,
                                                                        ctxSourcePath,
                                                                        debugScope)
                if !debugFilterOk:
                    continue
                debugCandidateScopes = debugCandidateScopes + 1
                if debugScope.name != typedFilterDebugTarget:
                    continue
                debugCtxMatches = debugCtxMatches + 1
                debugMetaMatches = debugMetaMatches + 1
                if debugFilterOk:
                    debugFilterAllows = debugFilterAllows + 1
                os.WriteLine(os.GetStderr(),
                             Fmt"typed_filter_debug scope source={ctxSourcePath} target={typedFilterDebugTarget} line={debugScope.startLine} meta={debugMetaMatches} filter={debugFilterAllows}")
            os.WriteLine(os.GetStderr(),
                         Fmt"typed_filter_debug source={ctxSourcePath} target={typedFilterDebugTarget} scopes={debugCandidateScopes} ctx_matches={debugCtxMatches} meta_matches={debugMetaMatches} filter_allows={debugFilterAllows} filter_active={filterActive} metadata_index={metadataContextIndex}")
        var emittedScopeIndex: int32
        for scopeIndex in 0..<stableScopes.len:
            if scopeIndex % 128 == 0:
                os.ProcessResourceGuardCheck()
            let currentScope = stableScopes[scopeIndex]
            var currentScopeMetadataOk = true
            var currentScopeFilterOk = true
            if typedFilterDebugTarget != "" && currentScope.name == typedFilterDebugTarget:
                os.WriteLine(os.GetStderr(),
                             Fmt"typed_filter_debug loop_check name={currentScope.name} source={ctxSourcePath} line={currentScope.startLine} metadata_ok={currentScopeMetadataOk} filter_ok={currentScopeFilterOk} facts={facts.count}")
            if !currentScopeMetadataOk:
                continue
            if !currentScopeFilterOk:
                continue
            if traceTypedIr && emittedScopeIndex == 0:
                TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_scope_loop_begin scopes={stableScopes.len} source_expr_end={sourceExprEnd}")
            if traceTypedIr:
                TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_scope_enter index={emittedScopeIndex} name={currentScope.name} rss={os.ProcessRssBytes()}")
            if traceTypedIr && facts.count <= 0 && (emittedScopeIndex < 48 || emittedScopeIndex % 8 == 0):
                TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_scope_index index={emittedScopeIndex} name={currentScope.name} start={currentScope.startLine} end={currentScope.endLine}")
            # 单行函数体糖 `fn f(...) [: T] = STMT`: STMT 与函数签名同一行
            # (currentScope.startLine)。多行函数体的这条游标推进把 <=
            # startLine 的 fact/expr 全部当"签名行, 不属于任何函数体"吃掉,
            # 对多行是对的(签名行从不含真正的语句)。但内联单行体的 STMT 恰好
            # 落在 startLine 上, 一旦吃掉就再也回不来——下一个函数的推进只会
            # 把它当"更早的东西"继续跳过, 永远没有函数把它纳入自己的
            # [factCursor,sourceFactEnd) 窗口。只在探测到真正内联体时才把
            # 边界放宽成"只吃 < startLine", 把 == startLine 留给这个函数自己
            # 认领; 非内联体场景 (绝大多数函数) 边界与行为完全不变。
            let currentScopeHasInlineBody = currentScope.startLine > 0 &&
                                             currentScope.startLine <=
                                                 TypedExprSourceContextLineCount(ctx) &&
                                             TypedExprBodyTextAfterEquals(TypedExprFunctionDeclHeaderTextForContext(ctx, currentScope.startLine)) != ""
            if factCursor < sourceFactEnd:
                for factIndex in factCursor..<sourceFactEnd:
                    let factLineNumber = TypedExprFactAt(facts, factIndex).lineNumber
                    if currentScopeHasInlineBody:
                        if factLineNumber >= currentScope.startLine:
                            break
                    else:
                        if factLineNumber > currentScope.startLine:
                            break
                    factCursor = factIndex + 1
            if exprCursor < sourceExprEnd:
                for exprIndex in exprCursor..<sourceExprEnd:
                    let exprLineNumber = exprLayer.exprs[exprIndex].lineNumber
                    if currentScopeHasInlineBody:
                        if exprLineNumber >= currentScope.startLine:
                            break
                    else:
                        if exprLineNumber > currentScope.startLine:
                            break
                    exprCursor = exprIndex + 1
            # Route to the structured-statement path whenever facts exist OR the
            # source supplies structured-statement exprs (assign / control / for).
            # A unit whose only calls are builtins (add(seq, v)) yields zero facts,
            # yet still has assign exprs like `xs[1] = v` that the simple path
            # cannot represent; gating only on facts.count silently dropped them.
            if ctx.lines.len <= 0:
                if sealedSessionMode:
                    panic("typed expr: frozen append prepared context lost source lines")
                elif !TypedExprEnsureSourceContextLinesLoaded(sourceTexts[i], ctx, err):
                    if err != "":
                        err = parser.ParserConcat2(
                            " typed expr: reload typed ir source lines before scope build failed: ",
                            parser.ParserOwnedText(err))
                    else:
                        err = " typed expr: reload typed ir source lines before scope build failed"
                    return false
            if typedFilterDebugTarget != "" && currentScope.name == typedFilterDebugTarget:
                os.WriteLine(os.GetStderr(),
                             Fmt"typed_filter_debug before_build name={currentScope.name} source={ctxSourcePath} line={currentScope.startLine} end={currentScope.endLine} ctx_lines={ctx.lines.len} facts={facts.count} fact_cursor={factCursor} fact_end={sourceFactEnd} expr_cursor={exprCursor} expr_end={sourceExprEnd} functions={ir.functions2_functionNameIds.len} statements={ir.statements2_statementIndexs.len}")
            if facts.count > 0 || sourceExprEnd > 0 || exprLayer.scopes.len > 0:
                TypedExprBuildIrForScopeWithFactsAndExprLayer(ctx,
                                                              metadataContexts,
                                                              share(currentScope),
                                                              facts,
                                                              factCursor,
                                                              sourceFactEnd,
                                                              exprLayer,
                                                              normalizedScopeIndex,
                                                              exprCursor,
                                                              sourceExprEnd,
                                                              ir)
            else:
                TypedExprBuildIrForScope(
                    ctx, metadataContexts, share(currentScope), facts,
                    factCursor, sourceFactEnd, ir)
            if typedFilterDebugTarget != "" && currentScope.name == typedFilterDebugTarget:
                var debugStatementCount: int32
                var debugBodyLine: int32
                var debugReturnLine: int32
                if ir.functions2_functionNameIds.len > 0:
                    let debugFnLastIndex = ir.functions2_functionNameIds.len - 1
                    debugStatementCount = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementCounts, debugFnLastIndex)
                    debugBodyLine = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_bodyLineNumbers, debugFnLastIndex)
                    debugReturnLine = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, debugFnLastIndex)
                os.WriteLine(os.GetStderr(),
                             Fmt"typed_filter_debug after_build name={currentScope.name} source={ctxSourcePath} line={currentScope.startLine} end={currentScope.endLine} functions={ir.functions2_functionNameIds.len} statements={ir.statements2_statementIndexs.len} fn_statements={debugStatementCount} body_line={debugBodyLine} signature_line={debugReturnLine}")
            if traceTypedIr && emittedScopeIndex == 0:
                TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_scope_loop_after_first functions={ir.functions2_functionNameIds.len} statements={ir.statements2_statementIndexs.len}")
            if traceTypedIr && facts.count <= 0 && (emittedScopeIndex < 48 || emittedScopeIndex % 8 == 0):
                TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_scope_done index={emittedScopeIndex} functions={ir.functions2_functionNameIds.len} statements={ir.statements2_statementIndexs.len}")
            emittedScopeIndex = emittedScopeIndex + 1
            if sealedSessionMode:
                sealedEmittedScopeCount = typedExprCheckedAddInt32(
                    sealedEmittedScopeCount, 1,
                    "sealed_emitted_scope_count")
            if sealedSessionMode &&
               frozenSession.lateFailureAfterScopeCount > 0 &&
               sealedEmittedScopeCount >=
                   frozenSession.lateFailureAfterScopeCount:
                frozenSession.lateFailureAfterScopeCount = 0
                if orcd8TraceEnabled():
                    os.WriteLine(os.Get_stderr(), "O8SITE=late_failure")
                frozenSession.lateFailureObserved = true
                TypedExprClearSourceContextAllFields(ctx)
                typedExprReleaseFrozenRoundContexts(preparedContexts)
                err = " typed expr: injected frozen metadata late failure after first scope"
                return false
        if sourceExprRange >= 0:
            TypedExprClearExprLayerRange(exprLayer, sourceExprStart, sourceExprEnd)
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(), "O8SITE=src_body_clear")
        TypedExprClearSourceContextAllFields(ctx)
        TypedExprClearSourceTextBody(sourceTexts[i])
        let _typedIrSourceContextRelief = os.ProcessMemoryPressureRelief()
        os.ProcessResourceGuardCheck()
    if sealedSessionMode && preparedContextCursor != preparedContexts.len:
        panic("typed expr: frozen append prepared context commit incomplete")
    if sealedSessionMode:
        typedExprCommitFrozenMetadataOperation(frozenSession,
                                               metadataRowsVisited)
    err = ""
    return true

@borrows
fn TypedExprBuildIrWithFactsMetadataAndExprLayer(sourceTexts: var TypedExprSourceText[],
                                                  facts: var TypedExprFactTable,
                                                  exprLayer: var parser.NormalizedExprLayer,
                                                  metadataContexts: var TypedExprSourceContext[],
                                                  filterActive: bool,
                                                  filterSourcePaths: str[],
                                                  filterFunctionNames: str[],
                                                  filterStartLines: int32[],
                                                  ir: var TypedExprIr,
                                                  err: var str): bool =
    return TypedExprBuildIrWithFactsMetadataAndExprLayerImpl(sourceTexts,
                                                            facts,
                                                            exprLayer,
                                                            metadataContexts,
                                                            filterActive,
                                                            filterSourcePaths,
                                                            filterFunctionNames,
                                                            filterStartLines,
                                                            false,
                                                            false,
                                                            false,
                                                            ir,
                                                            err)

fn TypedExprBuildIrWithFactsMetadataAndExprLayerReusingTypeInfo(sourceTexts: var TypedExprSourceText[],
                                                                 facts: var TypedExprFactTable,
                                                                 exprLayer: var parser.NormalizedExprLayer,
                                                                 metadataContexts: var TypedExprSourceContext[],
                                                                 filterActive: bool,
                                                                 filterSourcePaths: str[],
                                                                 filterFunctionNames: str[],
                                                                 filterStartLines: int32[],
                                                                 ir: var TypedExprIr,
                                                                 err: var str): bool =
    return TypedExprBuildIrWithFactsMetadataAndExprLayerImpl(sourceTexts,
                                                            facts,
                                                            exprLayer,
                                                            metadataContexts,
                                                            filterActive,
                                                            filterSourcePaths,
                                                            filterFunctionNames,
                                                            filterStartLines,
                                                            true,
                                                            false,
                                                            false,
                                                            ir,
                                                            err)

fn TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayer(sourceTexts: var TypedExprSourceText[],
                                                           facts: var TypedExprFactTable,
                                                           exprLayer: var parser.NormalizedExprLayer,
                                                           metadataContexts: var TypedExprSourceContext[],
                                                           filterActive: bool,
                                                           filterSourcePaths: str[],
                                                           filterFunctionNames: str[],
                                                           filterStartLines: int32[],
                                                           ir: var TypedExprIr,
                                                           err: var str): bool =
    return TypedExprBuildIrWithFactsMetadataAndExprLayerImpl(sourceTexts,
                                                            facts,
                                                            exprLayer,
                                                            metadataContexts,
                                                            filterActive,
                                                            filterSourcePaths,
                                                            filterFunctionNames,
                                                            filterStartLines,
                                                            true,
                                                            true,
                                                            false,
                                                            ir,
                                                            err)

@borrows
fn typedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealedImpl(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        filterActive: bool,
        filterSourcePaths: str[],
        filterFunctionNames: str[],
        filterStartLines: int32[],
        ir: var TypedExprIr,
        err: var str): bool =
    typedExprPreflightFrozenMetadataOperation(ir, "append entry")
    let roundPeakBefore = ir.typedExprMetadataSession.roundPeakBytes
    let lastRoundContextBefore =
        ir.typedExprMetadataSession.lastRoundContextCount
    let lastRoundDependencyBefore =
        ir.typedExprMetadataSession.lastRoundDependencyCount
    var roundSourcePaths: str[]
    var roundSourcePathLookup =
        parser.ParserSourcePathIndexLookupInit(32)
    for sourceIndex in 0..<sourceTexts.len:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            roundSourcePaths,
            roundSourcePathLookup,
            sourceTexts[sourceIndex].sourcePath)
    var roundDependencySourcePaths: str[]
    var roundDependencySourcePathLookup =
        parser.ParserSourcePathIndexLookupInit(32)
    for exprIndex in 0..<exprLayer.exprs.len:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            roundDependencySourcePaths,
            roundDependencySourcePathLookup,
            exprLayer.exprs[exprIndex].callTargetSourcePath)
    for factIndex in 0..<facts.count:
        typedExprFrozenAppendUniqueRoundPathIndexed(
            roundDependencySourcePaths,
            roundDependencySourcePathLookup,
            TypedExprFactAt(facts, factIndex).callTargetSourcePath)
    var roundScopeRows: int32[]
    if filterActive &&
       !typedExprFrozenExactScopeRows(ir.typedExprMetadataSession,
                                     filterSourcePaths,
                                     filterFunctionNames,
                                     filterStartLines,
                                     [],
                                     roundScopeRows,
                                     err):
        ir.typedExprMetadataSession.roundPeakBytes = roundPeakBefore
        ir.typedExprMetadataSession.lastRoundContextCount =
            lastRoundContextBefore
        ir.typedExprMetadataSession.lastRoundDependencyCount =
            lastRoundDependencyBefore
        return false
    var roundContexts: TypedExprSourceContext[]
    if !typedExprFrozenBuildRoundViews(ir.typedExprMetadataSession,
                                       roundSourcePaths,
                                       roundDependencySourcePaths,
                                       filterActive,
                                       roundScopeRows,
                                       roundContexts,
                                       err):
        typedExprReleaseFrozenRoundViews(ir.typedExprMetadataSession,
                                         roundContexts)
        ir.typedExprMetadataSession.roundPeakBytes = roundPeakBefore
        ir.typedExprMetadataSession.lastRoundContextCount =
            lastRoundContextBefore
        ir.typedExprMetadataSession.lastRoundDependencyCount =
            lastRoundDependencyBefore
        return false
    var queryLookupCount: int32
    var queryProbeCount: int32
    var queryMetadataScanCount: int32
    typedExprBeginFrozenReadOnlyQueries(ir.typedExprMetadataSession,
                                        queryLookupCount,
                                        queryProbeCount,
                                        queryMetadataScanCount)
    var stagedSourceTexts = typedExprCloneFrozenRoundSourceTexts(sourceTexts)
    var stagedExprLayer = parser.NormalizedExprLayerClone(exprLayer)
    if !TypedExprBuildIrWithFactsMetadataAndExprLayerImpl(
            stagedSourceTexts,
            facts,
            stagedExprLayer,
            roundContexts,
            filterActive,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            true,
            true,
            true,
            ir,
            err):
        typedExprEndFrozenReadOnlyQueries(ir.typedExprMetadataSession,
                                          queryLookupCount,
                                          queryProbeCount,
                                          queryMetadataScanCount)
        parser.NormalizedExprLayerReset(stagedExprLayer)
        typedExprReleaseFrozenRoundViews(ir.typedExprMetadataSession,
                                         roundContexts)
        ir.typedExprMetadataSession.roundPeakBytes = roundPeakBefore
        ir.typedExprMetadataSession.lastRoundContextCount =
            lastRoundContextBefore
        ir.typedExprMetadataSession.lastRoundDependencyCount =
            lastRoundDependencyBefore
        return false
    typedExprEndFrozenReadOnlyQueries(ir.typedExprMetadataSession,
                                      queryLookupCount,
                                      queryProbeCount,
                                      queryMetadataScanCount)
    typedExprReleaseFrozenRoundViews(ir.typedExprMetadataSession,
                                     roundContexts)
    typedExprMoveFrozenRoundSourceTexts(sourceTexts, stagedSourceTexts)
    parser.NormalizedExprLayerCommitBorrowedMetadata(exprLayer,
                                                      stagedExprLayer)
    return true

@borrows
fn TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
        sourceTexts: var TypedExprSourceText[],
        facts: var TypedExprFactTable,
        exprLayer: var parser.NormalizedExprLayer,
        filterActive: bool,
        filterSourcePaths: str[],
        filterFunctionNames: str[],
        filterStartLines: int32[],
        ir: var TypedExprIr,
        err: var str): bool =
    typedExprPreflightFrozenMetadataOperation(ir, "append transaction entry")
    let session = ir.typedExprMetadataSession
    if session.lateFailureAfterScopeCount <= 0:
        return typedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealedImpl(
            sourceTexts,
            facts,
            exprLayer,
            filterActive,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            ir,
            err)

    # A late-failure probe must exercise the complete append path without ever
    # replacing the live IR or BuildIndex object. Build a private candidate and
    # give it the session's unique operation authority temporarily. On failure,
    # discarding the candidate is the rollback; every public alias still names
    # the original, unmodified objects. If the armed threshold is not reached,
    # the successful candidate proves the deterministic commit path, which is
    # then run once against the live inputs with the telemetry snapshot restored.
    let sessionGeneration = ir.typedExprMetadataSessionGeneration
    let sealedValidationBefore = session.sealedValidationCount
    let metadataRowsBefore = session.metadataRowsVisitedAfterSeal
    let roundViewBytesBefore = session.roundViewLiveBytes
    let roundPeakBefore = session.roundPeakBytes
    let roundContextBefore = session.roundContextCount
    let roundDependencyBefore = session.roundDependencyCount
    let lastRoundContextBefore = session.lastRoundContextCount
    let lastRoundDependencyBefore = session.lastRoundDependencyCount
    let lateFailureAfterScopeBefore = session.lateFailureAfterScopeCount
    let lateFailureObservedBefore = session.lateFailureObserved

    var candidateIr = typedExprIrCloneImpl(ir, true)
    candidateIr.typedExprMetadataSession = session
    candidateIr.typedExprMetadataSessionGeneration = sessionGeneration
    ir.typedExprMetadataSession = nil
    var candidateSources = typedExprCloneFrozenRoundSourceTexts(sourceTexts)
    var candidateFacts = TypedExprFactTableClone(facts)
    var candidateExprLayer = parser.NormalizedExprLayerClone(exprLayer)
    let candidateOk =
        typedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealedImpl(
            candidateSources,
            candidateFacts,
            candidateExprLayer,
            filterActive,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            candidateIr,
            err)
    candidateIr.typedExprMetadataSession = nil
    ir.typedExprMetadataSession = session
    ir.typedExprMetadataSessionGeneration = sessionGeneration
    TypedExprFactTableRelease(candidateFacts)
    parser.NormalizedExprLayerReset(candidateExprLayer)
    TypedExprIrReleasePayload(candidateIr)

    if !candidateOk:
        if session.sealedValidationCount != sealedValidationBefore ||
           session.metadataRowsVisitedAfterSeal != metadataRowsBefore ||
           session.roundViewLiveBytes != roundViewBytesBefore ||
           session.roundPeakBytes != roundPeakBefore ||
           session.roundContextCount != roundContextBefore ||
           session.roundDependencyCount != roundDependencyBefore ||
           session.lastRoundContextCount != lastRoundContextBefore ||
           session.lastRoundDependencyCount != lastRoundDependencyBefore:
            panic("typed expr: staged late failure mutated frozen session telemetry")
        return false

    if session.lateFailureAfterScopeCount != lateFailureAfterScopeBefore ||
       session.lateFailureObserved != lateFailureObservedBefore ||
       session.roundViewLiveBytes != roundViewBytesBefore ||
       session.roundContextCount != roundContextBefore ||
       session.roundDependencyCount != roundDependencyBefore:
        panic("typed expr: successful late-failure staging changed probe state")
    session.sealedValidationCount = sealedValidationBefore
    session.metadataRowsVisitedAfterSeal = metadataRowsBefore
    session.roundPeakBytes = roundPeakBefore
    session.lastRoundContextCount = lastRoundContextBefore
    session.lastRoundDependencyCount = lastRoundDependencyBefore
    return typedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealedImpl(
        sourceTexts,
        facts,
        exprLayer,
        filterActive,
        filterSourcePaths,
        filterFunctionNames,
        filterStartLines,
        ir,
        err)

fn TypedExprBuildIrWithFactsAndExprLayer(sourceTexts: var TypedExprSourceText[],
                                          facts: var TypedExprFactTable,
                                          exprLayer: var parser.NormalizedExprLayer,
                                          ir: var TypedExprIr,
                                          err: var str): bool =
    TypedExprIrBeginValueExprBorrow(ir, exprLayer)
    let ok = TypedExprBuildIrWithFactsAndExprLayerCore(
        sourceTexts, facts, exprLayer, ir, err)
    TypedExprIrEndValueExprBorrow(ir)
    return ok

fn TypedExprBuildIrWithFactsAndExprLayerCore(sourceTexts: var TypedExprSourceText[],
                                          facts: var TypedExprFactTable,
                                          exprLayer: var parser.NormalizedExprLayer,
                                          ir: var TypedExprIr,
                                          err: var str): bool =
    TypedExprValidateNormalizedDeferFacts(exprLayer)
    var normalizedScopeIndex = TypedExprNormalizedScopeIndexBuild(exprLayer)
    let valueExprTree = ir.valueExprTree
    let valueExprTreeBorrowLease = ir.valueExprTreeBorrowLease
    ir.valueExprTree = nil
    ir.valueExprTreeBorrowLease = false
    TypedExprIrReleasePayload(ir)
    ir.internPool = langintern.InternPoolNew()
    ir.valueExprTree = valueExprTree
    ir.valueExprTreeBorrowLease = valueExprTreeBorrowLease
    TypedExprIrPrepareValueExprCallMetadata(ir, facts)
    var contexts: TypedExprSourceContext[]
    let traceTypedIr = os.GetEnv("CHENG_TYPED_IR_TRACE") == "1"
    if traceTypedIr:
        TypedExprTraceLine("typed_ir_trace:source_text_count")
    if facts.count > 0:
        for i in 0..<sourceTexts.len:
            os.ProcessResourceGuardCheck()
            TypedExprEnsureSourceTextLoaded(sourceTexts[i])
            var context: TypedExprSourceContext
            if !TypedExprBuildSourceContextBorrowed(sourceTexts[i],
                                                    context,
                                                    true,
                                                    true,
                                                    true,
                                                    TypedExprFunctionFilterIndex(),
                                                    err):
                if err != "":
                    err = parser.ParserConcat2(" typed expr: build typed ir source context failed: ",
                                               parser.ParserOwnedText(err))
                else:
                    err = " typed expr: build typed ir source context failed"
                return false
            if traceTypedIr:
                TypedExprTraceLine("typed_ir_context:before_add")
                if i < 6:
                    TypedExprTraceLine("typed_ir_trace:context")
            TypedExprClearSourceTextBody(sourceTexts[i])
            add(contexts, context)
            if traceTypedIr:
                TypedExprTraceLine("typed_ir_context:after_add")
        var debugScopeTotal: int32
        var debugImportcTotal: int32
        var debugFirstSourcePath = ""
        var debugFirstLineCount: int32
        var debugFirstScopeCount: int32
        var debugFirstImportcCount: int32
        if contexts.len > 0:
            debugFirstSourcePath = contexts[0].sourcePath
            debugFirstLineCount = contexts[0].lines.len
            debugFirstScopeCount = contexts[0].scopes.len
            debugFirstImportcCount = contexts[0].importcFunctions.len
        for contextIndex in 0..<contexts.len:
            debugScopeTotal = debugScopeTotal + contexts[contextIndex].scopes.len
            debugImportcTotal = debugImportcTotal + contexts[contextIndex].importcFunctions.len
        if debugScopeTotal <= 0 && sourceTexts.len > 0:
            err = Fmt" typed expr: typed ir source contexts contain no local scopes source_count={sourceTexts.len} fact_count={facts.count} expr_count={exprLayer.exprs.len} context_count={contexts.len} importc_total={debugImportcTotal} first_source={debugFirstSourcePath} first_line_count={debugFirstLineCount} first_scope_count={debugFirstScopeCount} first_importc_count={debugFirstImportcCount}"
            return false
    var factSourceRanges: TypedExprSourceRangeIndex
    var exprSourceRanges: TypedExprSourceRangeIndex
    if facts.count > 0:
        if traceTypedIr:
            TypedExprTraceLine("typed_ir_context:before_range_build")
        factSourceRanges = TypedExprSourceRangeIndexBuildFromFacts(facts)
        exprSourceRanges = TypedExprSourceRangeIndexBuildFromExprLayer(exprLayer)
        TypedExprTraceLine("typed_ir_context:range_counts")
        if traceTypedIr:
            TypedExprTraceLine("typed_ir_context:before_context_index")
        typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
            ir, contexts)
        TypedExprBuildSourceContextIndex(ir, contexts)
        if traceTypedIr:
            TypedExprTraceLine("typed_ir_context:after_context_index")
    for ci in 0..<contexts.len:
        TypedExprTraceLine("typed_ir_context:before_type_defs")
        TypedExprIrAppendTypeDefAliasesFromContext(ir, contexts[ci])
        TypedExprTraceLine("typed_ir_context:after_type_defs")
        TypedExprIrAppendTypeLayoutsFromContext(ir, contexts[ci], contexts)
        TypedExprTraceLine("typed_ir_context:after_type_layouts")
    for i in 0..<sourceTexts.len:
        os.ProcessResourceGuardCheck()
        if facts.count > 0 && i < contexts.len:
            TypedExprTraceLine("typed_ir_source_loop:index")
            TypedExprIrAppendImportcFunctionsFromContext(ir, contexts[i])
            TypedExprTraceLine("typed_ir_source_loop:after_importc")
            TypedExprIrAppendEnumValuesFromContext(ir, contexts[i])
            TypedExprTraceLine("typed_ir_source_loop:after_enum")
            TypedExprIrAppendColdCsgRowsFromContext(ir, contexts[i])
            TypedExprTraceLine("typed_ir_source_loop:after_cold_rows")
            TypedExprTraceLine( "typed_ir_source_loop:before_fact_range")
            let borrowedSourceFactRange = TypedExprSourceRangeIndexFind(factSourceRanges, contexts[i].sourcePath)
            TypedExprTraceLine("typed_ir_source_loop:after_fact_range")
            var borrowedSourceFactStart: int32
            var borrowedSourceFactEnd: int32
            var borrowedFactCursor: int32
            if borrowedSourceFactRange >= 0:
                borrowedSourceFactStart = factSourceRanges.starts[borrowedSourceFactRange]
                borrowedSourceFactEnd = factSourceRanges.ends[borrowedSourceFactRange]
                borrowedFactCursor = borrowedSourceFactStart
                TypedExprTraceLine("typed_ir_source_loop:before_inferred")
                TypedExprAppendInferredCallBindings(contexts[i],
                                                    contexts,
                                                    facts,
                                                    borrowedSourceFactStart,
                                                    borrowedSourceFactEnd)
                TypedExprTraceLine("typed_ir_source_loop:after_inferred")
            else:
                borrowedSourceFactEnd = 0
                borrowedFactCursor = 0
            TypedExprAppendInferredIndexBindings(ir, contexts[i], contexts)
            for bindingIndex in 0..<contexts[i].bindings.len:
                let binding = contexts[i].bindings[bindingIndex]
                if !binding.globalFlag:
                    TypedExprIrAppendLocalBinding(ir,
                                                  binding.sourcePath,
                                                  binding.functionName,
                                                  binding.lineNumber,
                                                  binding.name,
                                                  binding.typeText)
                    continue
                var seenGlobalBorrowed = false
                for globalIndex in 0..<ir.globalNames.len:
                    if globalIndex >= ir.globalSourcePaths.len:
                        continue
                    if ir.globalSourcePaths[globalIndex] == binding.sourcePath &&
                       ir.globalNames[globalIndex] == binding.name:
                        seenGlobalBorrowed = true
                        break
                if seenGlobalBorrowed:
                    continue
                TypedExprIrAppendBindingValue(ir, binding)
            TypedExprTraceLine( "typed_ir_source_loop:before_expr_range")
            let borrowedSourceExprRange = TypedExprSourceRangeIndexFind(exprSourceRanges, contexts[i].sourcePath)
            TypedExprTraceLine("typed_ir_source_loop:after_expr_range")
            var borrowedSourceExprStart: int32
            var borrowedSourceExprEnd: int32
            var borrowedExprCursor: int32
            if borrowedSourceExprRange >= 0:
                borrowedSourceExprStart = exprSourceRanges.starts[borrowedSourceExprRange]
                borrowedSourceExprEnd = exprSourceRanges.ends[borrowedSourceExprRange]
                borrowedExprCursor = borrowedSourceExprStart
            else:
                borrowedSourceExprEnd = 0
                borrowedExprCursor = 0
            TypedExprTraceLine("typed_ir_scope_loop:begin")
            for j in 0..<contexts[i].scopes.len:
                if j % 128 == 0:
                    os.ProcessResourceGuardCheck()
                TypedExprTraceLine("typed_ir_scope_loop:j")
                if borrowedFactCursor < borrowedSourceFactEnd:
                    for factIndex in borrowedFactCursor..<borrowedSourceFactEnd:
                        if TypedExprFactAt(facts, factIndex).lineNumber > contexts[i].scopes[j].startLine:
                            break
                        borrowedFactCursor = factIndex + 1
                if borrowedExprCursor < borrowedSourceExprEnd:
                    for exprIndex in borrowedExprCursor..<borrowedSourceExprEnd:
                        if exprLayer.exprs[exprIndex].lineNumber > contexts[i].scopes[j].startLine:
                            break
                        borrowedExprCursor = exprIndex + 1
                TypedExprTraceLine("typed_ir_scope_loop:before_build")
                TypedExprBuildIrForScopeWithFactsAndExprLayer(contexts[i],
                                                              contexts,
                                                              contexts[i].scopes[j],
                                                              facts,
                                                              borrowedFactCursor,
                                                              borrowedSourceFactEnd,
                                                              exprLayer,
                                                              normalizedScopeIndex,
                                                              borrowedExprCursor,
                                                              borrowedSourceExprEnd,
                                                              ir)
                TypedExprTraceLine("typed_ir_scope_loop:after_build")
            TypedExprClearSourceContextHeavyFields(contexts[i])
            TypedExprClearSourceTextBody(sourceTexts[i])
            continue
        var ctx: TypedExprSourceContext
        if facts.count > 0 && i < contexts.len:
            ctx = TypedExprSourceContextBorrowedView(contexts[i])
        else:
            TypedExprEnsureSourceTextLoaded(sourceTexts[i])
            if !TypedExprBuildSourceContextBorrowed(sourceTexts[i],
                                                    ctx,
                                                    true,
                                                    true,
                                                    true,
                                                    TypedExprFunctionFilterIndex(),
                                                    err):
                if err != "":
                    err = parser.ParserConcat2(" typed expr: build typed ir source context failed: ",
                                               parser.ParserOwnedText(err))
                else:
                    err = " typed expr: build typed ir source context failed"
                return false
        if traceTypedIr && i < 6:
            TypedExprTraceLine("typed_ir_trace:ir_source")
        TypedExprIrAppendImportcFunctionsFromContext(ir, ctx)
        TypedExprIrAppendEnumValuesFromContext(ir, ctx)
        TypedExprIrAppendTypeDefAliasesFromContext(ir, ctx)
        TypedExprIrAppendTypeLayoutsFromContext(ir, ctx, contexts)
        TypedExprIrAppendColdCsgRowsFromContext(ir, ctx)
        let sourceFactRange = TypedExprSourceRangeIndexFind(factSourceRanges, ctx.sourcePath)
        var sourceFactStart: int32
        var sourceFactEnd: int32
        var factCursor: int32
        if sourceFactRange >= 0:
            sourceFactStart = factSourceRanges.starts[sourceFactRange]
            sourceFactEnd = factSourceRanges.ends[sourceFactRange]
            factCursor = sourceFactStart
            TypedExprAppendInferredCallBindings(ctx,
                                                contexts,
                                                facts,
                                                sourceFactStart,
                                                sourceFactEnd)
        else:
            sourceFactEnd = 0
            factCursor = 0
        TypedExprAppendInferredIndexBindings(ir, ctx, contexts)
        for bindingIndex in 0..<ctx.bindings.len:
            let binding = ctx.bindings[bindingIndex]
            if !binding.globalFlag:
                TypedExprIrAppendLocalBinding(ir,
                                              binding.sourcePath,
                                              binding.functionName,
                                              binding.lineNumber,
                                              binding.name,
                                              binding.typeText)
                continue
            var seenGlobal = false
            for globalIndex in 0..<ir.globalNames.len:
                if globalIndex >= ir.globalSourcePaths.len:
                    continue
                if ir.globalSourcePaths[globalIndex] == binding.sourcePath &&
                   ir.globalNames[globalIndex] == binding.name:
                    seenGlobal = true
                    break
            if seenGlobal:
                continue
            TypedExprIrAppendBindingValue(ir, binding)
        let sourceExprRange = TypedExprSourceRangeIndexFind(exprSourceRanges, ctx.sourcePath)
        var sourceExprStart: int32
        var sourceExprEnd: int32
        var exprCursor: int32
        if facts.count > 0 && sourceExprRange >= 0:
            sourceExprStart = exprSourceRanges.starts[sourceExprRange]
            sourceExprEnd = exprSourceRanges.ends[sourceExprRange]
            exprCursor = sourceExprStart
        else:
            sourceExprEnd = 0
            exprCursor = 0
        for j in 0..<ctx.scopes.len:
            if j % 128 == 0:
                os.ProcessResourceGuardCheck()
            if factCursor < sourceFactEnd:
                for factIndex in factCursor..<sourceFactEnd:
                    if TypedExprFactAt(facts, factIndex).lineNumber > ctx.scopes[j].startLine:
                        break
                    factCursor = factIndex + 1
            if exprCursor < sourceExprEnd:
                for exprIndex in exprCursor..<sourceExprEnd:
                    if exprLayer.exprs[exprIndex].lineNumber > ctx.scopes[j].startLine:
                        break
                    exprCursor = exprIndex + 1
            if facts.count > 0 || exprLayer.scopes.len > 0:
                TypedExprBuildIrForScopeWithFactsAndExprLayer(ctx,
                                                              contexts,
                                                              ctx.scopes[j],
                                                              facts,
                                                              factCursor,
                                                              sourceFactEnd,
                                                              exprLayer,
                                                              normalizedScopeIndex,
                                                              exprCursor,
                                                              sourceExprEnd,
                                                              ir)
            else:
                TypedExprBuildIrForScope(ctx, contexts, ctx.scopes[j], facts, factCursor, sourceFactEnd, ir)
        if facts.count > 0 && i < contexts.len:
            TypedExprClearSourceContextHeavyFields(contexts[i])
        TypedExprClearSourceTextBody(sourceTexts[i])
    err = ""
    return true

fn TypedExprBuildIrWithFacts(sourceTexts: var TypedExprSourceText[],
                              facts: var TypedExprFactTable,
                              ir: var TypedExprIr,
                              err: var str): bool =
    var exprLayer: parser.NormalizedExprLayer
    if facts.count > 0:
        if !TypedExprReadNormalizedExprLayerForSourceTexts(sourceTexts, exprLayer, err):
            err = Fmt" typed expr: build typed ir normalized expr layer failed: {err}"
            return false
    let ok = TypedExprBuildIrWithFactsAndExprLayer(sourceTexts,
                                                   facts,
                                                   exprLayer,
                                                   ir,
                                                   err)
    parser.NormalizedExprLayerReset(exprLayer)
    return ok

fn TypedExprBuildIrFromExprLayer(sourceTexts: var TypedExprSourceText[],
                                  exprLayer: var parser.NormalizedExprLayer,
                                  ir: var TypedExprIr,
                                  err: var str): bool =
    TypedExprIrBeginValueExprBorrow(ir, exprLayer)
    let ok = TypedExprBuildIrFromExprLayerCore(
        sourceTexts, exprLayer, ir, err)
    TypedExprIrEndValueExprBorrow(ir)
    return ok

fn TypedExprBuildIrFromExprLayerCore(sourceTexts: var TypedExprSourceText[],
                                  exprLayer: var parser.NormalizedExprLayer,
                                  ir: var TypedExprIr,
                                  err: var str): bool =
    TypedExprValidateNormalizedDeferFacts(exprLayer)
    var normalizedScopeIndex = TypedExprNormalizedScopeIndexBuild(exprLayer)
    let valueExprTree = ir.valueExprTree
    let valueExprTreeBorrowLease = ir.valueExprTreeBorrowLease
    ir.valueExprTree = nil
    ir.valueExprTreeBorrowLease = false
    TypedExprIrReleasePayload(ir)
    ir.internPool = langintern.InternPoolNew()
    ir.valueExprTree = valueExprTree
    ir.valueExprTreeBorrowLease = valueExprTreeBorrowLease
    var noFacts: TypedExprFactTable
    TypedExprIrPrepareValueExprCallMetadata(ir, noFacts)
    var contexts: TypedExprSourceContext[]
    var exprSourceRanges = TypedExprSourceRangeIndexBuildFromExprLayer(exprLayer)
    for i in 0..<sourceTexts.len:
        os.ProcessResourceGuardCheck()
        TypedExprEnsureSourceTextLoaded(sourceTexts[i])
        var ctx: TypedExprSourceContext
        if !TypedExprBuildSourceContextBorrowed(sourceTexts[i],
                                                ctx,
                                                true,
                                                true,
                                                true,
                                                TypedExprFunctionFilterIndex(),
                                                err):
            if err != "":
                err = parser.ParserConcat2(" typed expr: build typed ir source context failed: ",
                                           parser.ParserOwnedText(err))
            else:
                err = " typed expr: build typed ir source context failed"
            return false
        TypedExprClearSourceTextBody(sourceTexts[i])
        TypedExprSourceContextAppendMove(contexts, ctx)
    typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
        ir, contexts)
    TypedExprBuildSourceContextIndex(ir, contexts)
    for i in 0..<sourceTexts.len:
        os.ProcessResourceGuardCheck()
        var ctxForIr = TypedExprSourceContextBorrowedView(contexts[i])
        TypedExprIrAppendImportcFunctionsFromContext(ir, ctxForIr)
        TypedExprIrAppendEnumValuesFromContext(ir, ctxForIr)
        TypedExprIrAppendTypeDefAliasesFromContext(ir, ctxForIr)
        TypedExprIrAppendTypeLayoutsFromContext(ir, ctxForIr, contexts)
        TypedExprIrAppendColdCsgRowsFromContext(ir, ctxForIr)
        for bindingIndex in 0..<ctxForIr.bindings.len:
            let binding = ctxForIr.bindings[bindingIndex]
            if !binding.globalFlag:
                TypedExprIrAppendLocalBinding(ir,
                                              binding.sourcePath,
                                              binding.functionName,
                                              binding.lineNumber,
                                              binding.name,
                                              binding.typeText)
                continue
            var seenGlobal = false
            for globalIndex in 0..<ir.globalNames.len:
                if globalIndex >= ir.globalSourcePaths.len:
                    continue
                if ir.globalSourcePaths[globalIndex] == binding.sourcePath &&
                   ir.globalNames[globalIndex] == binding.name:
                    seenGlobal = true
                    break
            if seenGlobal:
                continue
            TypedExprIrAppendBindingValue(ir, binding)
        let sourceExprRange = TypedExprSourceRangeIndexFind(exprSourceRanges, ctxForIr.sourcePath)
        var sourceExprStart: int32
        var sourceExprEnd: int32
        var exprCursor: int32
        if sourceExprRange >= 0:
            sourceExprStart = exprSourceRanges.starts[sourceExprRange]
            sourceExprEnd = exprSourceRanges.ends[sourceExprRange]
            exprCursor = sourceExprStart
        else:
            sourceExprEnd = 0
            exprCursor = 0
        let scopeCount = ctxForIr.scopes.len
        for j in 0..<scopeCount:
            if j % 128 == 0:
                os.ProcessResourceGuardCheck()
            let scope = ctxForIr.scopes[j]
            if exprCursor < sourceExprEnd:
                for exprIndex in exprCursor..<sourceExprEnd:
                    if exprLayer.exprs[exprIndex].lineNumber > scope.startLine:
                        break
                    exprCursor = exprIndex + 1
            TypedExprBuildIrForScopeFromExprLayer(ctxForIr,
                                                  contexts,
                                                  scope,
                                                  exprLayer,
                                                  normalizedScopeIndex,
                                                  exprCursor,
                                                  sourceExprEnd,
                                                  ir)
        TypedExprClearSourceContextHeavyFields(contexts[i])
        TypedExprClearSourceTextBody(sourceTexts[i])
        os.ProcessResourceGuardCheck()
    err = ""
    return true

fn TypedExprBuildIr(sourceTexts: var TypedExprSourceText[],
                     ir: var TypedExprIr,
                     err: var str): bool =
    var emptyFacts: TypedExprFactTable
    return TypedExprBuildIrWithFacts(sourceTexts, emptyFacts, ir, err)

fn TypedExprReturnOpFactFromIrFunction(ir: var TypedExprIr,
                                        fnIndex: int32): TypedExprReturnOpFact =
    var fact: TypedExprReturnOpFact
    let rfSrcRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_sourcePathIds[fnIndex])
    if IsOk(rfSrcRes):
        fact.sourcePath = Value(rfSrcRes)
    let rfNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[fnIndex])
    if IsOk(rfNameRes):
        fact.functionName = Value(rfNameRes)
    fact.signatureLineNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, fnIndex)
    fact.bodyLineNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_bodyLineNumbers, fnIndex)
    let rfRetRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_returnTypeIds[fnIndex])
    if IsOk(rfRetRes):
        fact.returnType = Value(rfRetRes)
    let rfRetExprRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_returnExprIds[fnIndex])
    if IsOk(rfRetExprRes):
        fact.returnExpr = Value(rfRetExprRes)
    fact.opKind = TypedExprReturnOpUnsupported
    let returnNodeIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_returnNodeIndexs, fnIndex)
    if returnNodeIndex < 0 || returnNodeIndex >= ir.nodes2_nodeIndexs.len:
        return fact
    fact.opKind = TypedExprReturnOpKindFromIrOp(ir.nodes2_opKinds[returnNodeIndex])
    if fact.opKind == TypedExprReturnOpUnsupported:
        return fact
        let lhsNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_paramNameIds[arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand0NodeIndexs, returnNodeIndex)])
        if IsOk(lhsNameRes):
            fact.lhsName = Value(lhsNameRes)
        let lhsTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand0NodeIndexs, returnNodeIndex)])
        if IsOk(lhsTypeRes):
            fact.lhsType = Value(lhsTypeRes)
        let rhsNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_paramNameIds[arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand1NodeIndexs, returnNodeIndex)])
        if IsOk(rhsNameRes):
            fact.rhsName = Value(rhsNameRes)
        let rhsTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand1NodeIndexs, returnNodeIndex)])
        if IsOk(rhsTypeRes):
            fact.rhsType = Value(rhsTypeRes)
        let accNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_paramNameIds[arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand2NodeIndexs, returnNodeIndex)])
        if IsOk(accNameRes):
            fact.accName = Value(accNameRes)
        let accTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand2NodeIndexs, returnNodeIndex)])
        if IsOk(accTypeRes):
            fact.accType = Value(accTypeRes)
    return fact

fn TypedExprReturnOpFactsFromIr(ir: var TypedExprIr): TypedExprReturnOpFact[] =
    var facts: TypedExprReturnOpFact[]
    for i in 0..<ir.functions2_functionNameIds.len:
        let fact = TypedExprReturnOpFactFromIrFunction(ir, i)
        if fact.opKind == TypedExprReturnOpUnsupported:
            continue
        add(facts, fact)
    return facts

fn TypedExprBuildReturnOpFacts(sourceTexts: var TypedExprSourceText[],
                                facts: var TypedExprReturnOpFact[],
                                err: var str): bool =
    var ir: var TypedExprIr
    if !TypedExprBuildIr(sourceTexts, ir, err):
        return false
    facts = TypedExprReturnOpFactsFromIr(ir)
    err = ""
    return true

# [S1b step-3 (6)] `sealCallDeclarations` false stops after the index core, so
# the streaming driver can append one source's call declarations at a time and
# seal once at the end.  The index core, the lookup and the ownership handoff
# are the same statements in the same order either way; `manualTree` is only
# consulted on the sealing path.
@borrows
fn typedExprBuildSourceContextExactIndexWithManualAuthority(
        contexts: var TypedExprSourceContext[],
        manualTree: parser.ParserValueExprTree,
        sealCallDeclarations: bool,
        lookup: var parser.ParserSourcePathIndexLookup,
        err: var str): bool =
    lookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(contexts.len), 2,
                                      "context_lookup_capacity"),
                8, "context_lookup_capacity"),
            "context_lookup_capacity"))
    var builtIndex: TypedExprBuildIndex
    if contexts.len > 0 &&
       (contexts[0].buildIndex == nil || contexts[0].buildIndex.released):
        builtIndex = typedExprBuildIndexForContextsManualAuthority(
            contexts,
            typedExprCheckedAddInt32(contexts.len, 32,
                                     "facts_context_index_capacity"),
            manualTree,
            sealCallDeclarations)
        if builtIndex.hardError != "":
            err = builtIndex.hardError
            for contextIndex in 0..<contexts.len:
                if contexts[contextIndex].buildIndex == builtIndex:
                    TypedExprSourceContextReleaseBuildIndex(
                        contexts[contextIndex])
            TypedExprBuildIndexRelease(builtIndex)
            return false
    elif contexts.len > 0:
        let sharedIndex = contexts[0].buildIndex
        var ownerCount: int32
        var ownerIndex: int32 = -1
        for contextIndex in 0..<contexts.len:
            if contexts[contextIndex].buildIndex != sharedIndex ||
               contexts[contextIndex].buildIndex == nil ||
               contexts[contextIndex].buildIndex.released:
                err = Fmt" typed expr: source context build-index set mismatch index={contextIndex}"
                return false
            if contexts[contextIndex].buildIndexOwned:
                ownerCount = ownerCount + 1
                ownerIndex = contextIndex
        # Zero owners means TypedIR owns the shared index. A standalone context
        # set owns it only through the first context.
        if ownerCount > 1 || (ownerCount == 1 && ownerIndex != 0):
            err = Fmt" typed expr: source context build-index ownership invalid owner_count={ownerCount} owner_index={ownerIndex}"
            return false
    for contextIndex in 0..<contexts.len:
        var sourcePathRaw = contexts[contextIndex].normalizedSourcePath
        if sourcePathRaw == "":
            sourcePathRaw = contexts[contextIndex].sourcePath
        var sourcePath: str
        if !TypedExprLexicalSourcePath(sourcePathRaw,
                                       sourcePath,
                                       err):
            err = Fmt" typed expr: source context identity invalid index={contextIndex}: {err}"
            if builtIndex != nil:
                for cleanupIndex in 0..<contexts.len:
                    if contexts[cleanupIndex].buildIndex == builtIndex:
                        TypedExprSourceContextReleaseBuildIndex(
                            contexts[cleanupIndex])
                TypedExprBuildIndexRelease(builtIndex)
            return false
        let existingIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(lookup,
                                                                                         sourcePath)
        if existingIndex >= 0:
            err = Fmt" typed expr: duplicate source context identity source={sourcePath} first_index={existingIndex} next_index={contextIndex}"
            if builtIndex != nil:
                for cleanupIndex in 0..<contexts.len:
                    if contexts[cleanupIndex].buildIndex == builtIndex:
                        TypedExprSourceContextReleaseBuildIndex(
                            contexts[cleanupIndex])
                TypedExprBuildIndexRelease(builtIndex)
            return false
        contexts[contextIndex].normalizedSourcePath = strings.CloneStr(sourcePath)
        parser.ParserSourcePathIndexLookupInsertExact(lookup, sourcePath, contextIndex)
    if builtIndex != nil:
        TypedExprSourceContextSetOwnedBuildIndex(contexts[0], builtIndex)
    err = ""
    return true

@borrows
fn typedExprReleaseMatchingBuildIndexRec(
        contexts: var TypedExprSourceContext[],
        builtIndex: TypedExprBuildIndex,
        contextIndex: int32): bool =
    while true:
        if contextIndex >= contexts.len:
            return true
        if contexts[contextIndex].buildIndex == builtIndex:
            TypedExprSourceContextReleaseBuildIndex(contexts[contextIndex])
        contextIndex = contextIndex + 1
        continue

@borrows
fn typedExprSourceContextSharedIndexOwnersRec(
        contexts: var TypedExprSourceContext[],
        sharedIndex: TypedExprBuildIndex,
        contextIndex: int32,
        ownerCount: var int32,
        ownerIndex: var int32,
        err: var str): bool =
    while true:
        if contextIndex >= contexts.len:
            return true
        if contexts[contextIndex].buildIndex != sharedIndex ||
           contexts[contextIndex].buildIndex == nil ||
           contexts[contextIndex].buildIndex.released:
            err = Fmt" typed expr: source context build-index set mismatch index={contextIndex}"
            return false
        if contexts[contextIndex].buildIndexOwned:
            ownerCount = ownerCount + 1
            ownerIndex = contextIndex
        contextIndex = contextIndex + 1
        continue

@borrows
fn typedExprSourceContextInsertLookupRec(
        contexts: var TypedExprSourceContext[],
        lookup: var parser.ParserSourcePathIndexLookup,
        builtIndex: TypedExprBuildIndex,
        contextIndex: int32,
        err: var str): bool =
    while true:
        if contextIndex >= contexts.len:
            return true
        var sourcePathRaw = strings.CloneStr(contexts[contextIndex].normalizedSourcePath)
        if sourcePathRaw == "":
            sourcePathRaw = strings.CloneStr(contexts[contextIndex].sourcePath)
        var sourcePath: str
        if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, err):
            err = Fmt" typed expr: source context identity invalid index={contextIndex}: {err}"
            if builtIndex != nil:
                typedExprReleaseMatchingBuildIndexRec(contexts, builtIndex, 0)
                TypedExprBuildIndexRelease(builtIndex)
            return false
        let existingIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(lookup,
                                                                                         sourcePath)
        if existingIndex >= 0:
            err = Fmt" typed expr: duplicate source context identity source={sourcePath} first_index={existingIndex} next_index={contextIndex}"
            if builtIndex != nil:
                typedExprReleaseMatchingBuildIndexRec(contexts, builtIndex, 0)
                TypedExprBuildIndexRelease(builtIndex)
            return false
        contexts[contextIndex].normalizedSourcePath = strings.CloneStr(sourcePath)
        parser.ParserSourcePathIndexLookupInsertExact(lookup, sourcePath, contextIndex)
        contextIndex = contextIndex + 1
        continue

fn typedExprBuildSourceContextExactIndexPlain(
        contexts: var TypedExprSourceContext[],
        lookup: var parser.ParserSourcePathIndexLookup,
        err: var str): bool =
    lookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(contexts.len), 2,
                                      "context_lookup_capacity"),
                8, "context_lookup_capacity"),
            "context_lookup_capacity"))
    var builtIndex: TypedExprBuildIndex
    if contexts.len > 0 &&
       (contexts[0].buildIndex == nil || contexts[0].buildIndex.released):
        builtIndex = typedExprBuildIndexForContextsPlain(
            contexts,
            typedExprCheckedAddInt32(contexts.len, 32,
                                     "facts_context_index_capacity"))
        if builtIndex.hardError != "":
            err = builtIndex.hardError
            if !typedExprReleaseMatchingBuildIndexRec(contexts, builtIndex, 0):
                return false
            TypedExprBuildIndexRelease(builtIndex)
            return false
    elif contexts.len > 0:
        let sharedIndex = contexts[0].buildIndex
        var ownerCount: int32
        var ownerIndex: int32 = -1
        if !typedExprSourceContextSharedIndexOwnersRec(
               contexts, sharedIndex, 0, ownerCount, ownerIndex, err):
            return false
        if ownerCount > 1 || (ownerCount == 1 && ownerIndex != 0):
            err = Fmt" typed expr: source context build-index ownership invalid owner_count={ownerCount} owner_index={ownerIndex}"
            return false
    if !typedExprSourceContextInsertLookupRec(contexts, lookup, builtIndex, 0, err):
        return false
    if builtIndex != nil:
        TypedExprSourceContextSetOwnedBuildIndex(contexts[0], builtIndex)
    err = ""
    return true

fn TypedExprBuildSourceContextExactIndex(
        contexts: var TypedExprSourceContext[],
        lookup: var parser.ParserSourcePathIndexLookup,
        err: var str): bool =
    return typedExprBuildSourceContextExactIndexPlain(contexts, lookup, err)

# [S1b step-3 (6)] `sealCallDeclarations` false is the streaming entry: the
# index core, the lookup and the ownership handoff are built here, the caller
# appends one source's call declarations at a time and seals once at the end.
# `manualTree` is only consulted on the sealing path, so the streaming caller
# passes nil and the authority check is scoped to that path.
@borrows
fn TypedExprBuildSourceContextExactIndexWithManualAuthority(
        contexts: var TypedExprSourceContext[],
        manualTree: parser.ParserValueExprTree,
        sealCallDeclarations: bool,
        lookup: var parser.ParserSourcePathIndexLookup,
        err: var str): bool =
    if sealCallDeclarations && manualTree == nil:
        err = " typed expr: source context exact index parser authority missing"
        return false
    return typedExprBuildSourceContextExactIndexWithManualAuthority(
        contexts, manualTree, sealCallDeclarations, lookup, err)

# [p1phase1] Streaming deferred-core builder: runs core pass 1 only and marks
# the index so the finish and the per-source deferred append are
# order-enforced.  The metadata producer (core pass 2) runs later, verbatim,
# in `TypedExprBuildIndexFinishDeferredCore`.
@borrows
fn typedExprBuildIndexForContextsDeferredCore(
        sourceContexts: var TypedExprSourceContext[],
        minCap: int32): TypedExprBuildIndex =
    var index = TypedExprBuildIndexNew(minCap)
    typedExprBuildIndexRequireMutable(index,
                                      "context_set_call_declarations")
    typedExprBuildIndexCorePass1(sourceContexts, index)
    index.coreMetadataDeferredPending = true
    return index

# [p1phase1] Streaming deferred-core entry: identity/lookup/ownership and
# core pass 1 only; the metadata registration is deferred to the finish
# after the merge loop.  Fail-closed on a context set that already carries a
# build index: the deferred-core shape is defined only for a fresh
# streaming set.
fn TypedExprBuildSourceContextExactIndexDeferredCore(
        contexts: var TypedExprSourceContext[],
        lookup: var parser.ParserSourcePathIndexLookup,
        err: var str): bool =
    if contexts.len > 0 && contexts[0].buildIndex != nil &&
       !contexts[0].buildIndex.released:
        err = " typed expr: deferred core entry requires an empty context build-index set"
        return false
    lookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(contexts.len), 2,
                                      "context_lookup_capacity"),
                8, "context_lookup_capacity"),
            "context_lookup_capacity"))
    var builtIndex: TypedExprBuildIndex
    if contexts.len > 0:
        builtIndex = typedExprBuildIndexForContextsDeferredCore(
            contexts,
            typedExprCheckedAddInt32(contexts.len, 32,
                                     "facts_context_index_capacity"))
        if builtIndex.hardError != "":
            err = builtIndex.hardError
            for contextIndex in 0..<contexts.len:
                if contexts[contextIndex].buildIndex == builtIndex:
                    TypedExprSourceContextReleaseBuildIndex(
                        contexts[contextIndex])
            TypedExprBuildIndexRelease(builtIndex)
            return false
    for contextIndex in 0..<contexts.len:
        var sourcePathRaw = contexts[contextIndex].normalizedSourcePath
        if sourcePathRaw == "":
            sourcePathRaw = contexts[contextIndex].sourcePath
        var sourcePath: str
        if !TypedExprLexicalSourcePath(sourcePathRaw,
                                       sourcePath,
                                       err):
            err = Fmt" typed expr: source context identity invalid index={contextIndex}: {err}"
            if builtIndex != nil:
                for cleanupIndex in 0..<contexts.len:
                    if contexts[cleanupIndex].buildIndex == builtIndex:
                        TypedExprSourceContextReleaseBuildIndex(
                            contexts[cleanupIndex])
                TypedExprBuildIndexRelease(builtIndex)
            return false
        let existingIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(lookup,
                                                                                         sourcePath)
        if existingIndex >= 0:
            err = Fmt" typed expr: duplicate source context identity source={sourcePath} first_index={existingIndex} next_index={contextIndex}"
            if builtIndex != nil:
                for cleanupIndex in 0..<contexts.len:
                    if contexts[cleanupIndex].buildIndex == builtIndex:
                        TypedExprSourceContextReleaseBuildIndex(
                            contexts[cleanupIndex])
                TypedExprBuildIndexRelease(builtIndex)
            return false
        contexts[contextIndex].normalizedSourcePath = strings.CloneStr(sourcePath)
        parser.ParserSourcePathIndexLookupInsertExact(lookup, sourcePath, contextIndex)
    if builtIndex != nil:
        TypedExprSourceContextSetOwnedBuildIndex(contexts[0], builtIndex)
    err = ""
    return true

# [p1phase1] Deferred-core finish: exact same metadata producer as core pass
# 2, in the exact same context order, so the sealed index content is
# byte-identical to the core-first arm.  The exact-capacity reserve runs
# here (never earlier: it replaces the entry bucket heads), followed by a
# rehash that relinks the rows core pass 1 already registered into the exact
# buckets; capacity therefore matches the core-first arm too.
@borrows
fn TypedExprBuildIndexFinishDeferredCore(
        contexts: var TypedExprSourceContext[],
        index: var TypedExprBuildIndex,
        err: var str): bool =
    if index == nil || index.released:
        err = " typed expr: deferred core finish on missing or released index"
        return false
    if contexts.len == 0:
        err = " typed expr: deferred core finish index set mismatch"
        return false
    # Identity between `index` and the context set is enforced by the
    # deferred-pending flag below, not by a ref-vs-formal compare: only the
    # deferred builder ever sets the flag, and the driver's single call
    # site passes the handle it read from `contexts[0].buildIndex`.  (Both
    # direct compare shapes -- field-vs-formal and let-vs-formal -- are
    # rejected by the body-store-freeze exact-identity gate as defless
    # managed copies; the field-vs-let shape in
    # typedExprBuildSourceContextExactIndexWithManualAuthority never
    # compares against a formal.)
    if !index.coreMetadataDeferredPending:
        panic("typed expr: deferred core finish without deferred core state")
    typedExprBuildIndexReserveCoreCapacity(index, contexts)
    TypedExprBuildIndexRehashEntries(index, index.entryBucketHeads.len)
    typedExprBuildIndexCorePass2(contexts, index)
    index.coreMetadataDeferredPending = false
    err = ""
    return true

# [p1phase1] Streaming per-source append for the deferred-core arm: call
# declarations only.  The enum metadata companion is owned by the deferred
# finish (core pass 2 registers the enum rows verbatim, including
# ctx_import_enum_type, which the companion does not carry); appending them
# in the loop as well would double-register and RequireFresh-panic at the
# finish.
@borrows
fn TypedExprBuildIndexAppendSourceCallDeclarationsDeferredCore(
        index: var TypedExprBuildIndex,
        sourceContexts: var TypedExprSourceContext[],
        ctxIndex: int32,
        manualTree: parser.ParserValueExprTree,
        producerFunctionBase: int32): bool =
    if index == nil || index.released:
        return false
    if !index.coreMetadataDeferredPending:
        panic("typed expr: deferred append after deferred core finish")
    if ctxIndex < 0 || ctxIndex >= sourceContexts.len:
        return false
    return TypedExprBuildIndexAppendContextCallDeclarationsManual(
        index, sourceContexts, ctxIndex, 0, manualTree, producerFunctionBase)

fn TypedExprPopulateSourceExprLineColumns(contexts: var TypedExprSourceContext[],
                                            exprLayer: var parser.NormalizedExprLayer,
                                            err: var str): bool =
    var contextLookup: parser.ParserSourcePathIndexLookup
    if !TypedExprBuildSourceContextExactIndex(contexts, contextLookup, err):
        return false
    for i in 0..<exprLayer.exprs.len:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        let expr = exprLayer.exprs[i]
        var exprSourcePath: str
        if !TypedExprLexicalSourcePath(expr.sourcePath, exprSourcePath, err):
            err = Fmt" typed expr: expr source identity invalid expr_index={i}: {err}"
            return false
        let ctxIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextLookup,
                                                                                    exprSourcePath)
        if ctxIndex < 0:
            err = Fmt" typed expr: missing source context source={expr.sourcePath} line={expr.lineNumber} expr={expr.exprId} source_count={contexts.len}"
            return false
        if expr.lineNumber <= 0 || expr.lineNumber > contexts[ctxIndex].exprLineColumnHeads.len:
            err = Fmt" typed expr: expr line out of range source={expr.sourcePath} line={expr.lineNumber} line_count={contexts[ctxIndex].exprLineColumnHeads.len} expr={expr.exprId} column={expr.columnNumber}"
            return false
        let lineIndex = expr.lineNumber - 1
        let previousHead = contexts[ctxIndex].exprLineColumnHeads[lineIndex]
        var shouldAppend = true
        if previousHead >= 0:
            assert(previousHead < contexts[ctxIndex].exprLineColumnValues.len,
                   "typed expr: corrupt context line-column head")
            shouldAppend = contexts[ctxIndex].exprLineColumnValues[previousHead] != expr.columnNumber
        if shouldAppend:
            let columnIndex = contexts[ctxIndex].exprLineColumnValues.len
            add(contexts[ctxIndex].exprLineColumnValues, expr.columnNumber)
            add(contexts[ctxIndex].exprLineColumnNext, previousHead)
            contexts[ctxIndex].exprLineColumnHeads[lineIndex] = columnIndex
    err = ""
    return true

@borrows
fn TypedExprPopulateSourceExprLineColumnsForRange(ctx: var TypedExprSourceContext,
                                                   exprLayer: parser.NormalizedExprLayer,
                                                   startIndex: int32,
                                                   endIndexRaw: int32,
                                                   err: var str): bool =
    if startIndex < 0 || endIndexRaw < startIndex || endIndexRaw > exprLayer.exprs.len:
        err = Fmt" typed expr: expr range invalid start={startIndex} end={endIndexRaw} expr_count={exprLayer.exprs.len}"
        return false
    var contextSourcePath: str
    if !TypedExprLexicalSourcePath(ctx.normalizedSourcePath, contextSourcePath, err):
        return false
    for i in startIndex..<endIndexRaw:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        let expr = exprLayer.exprs[i]
        var exprSourcePath: str
        if !TypedExprLexicalSourcePath(expr.sourcePath, exprSourcePath, err):
            return false
        if exprSourcePath != contextSourcePath:
            err = Fmt" typed expr: expr range source mismatch context={contextSourcePath} expr_source={exprSourcePath} expr_index={i}"
            return false
        let lineIndex = TypedExprSourceContextLineIndex(ctx, expr.lineNumber)
        if lineIndex < 0 || lineIndex >= ctx.exprLineColumnHeads.len:
            err = Fmt" typed expr: expr line out of range source={expr.sourcePath} line={expr.lineNumber} line_count={ctx.exprLineColumnHeads.len} expr={expr.exprId} column={expr.columnNumber}"
            return false
        let previousHead = ctx.exprLineColumnHeads[lineIndex]
        var shouldAppend = true
        if previousHead >= 0:
            assert(previousHead < ctx.exprLineColumnValues.len,
                   "typed expr: corrupt range line-column head")
            shouldAppend = ctx.exprLineColumnValues[previousHead] != expr.columnNumber
        if shouldAppend:
            let columnIndex = ctx.exprLineColumnValues.len
            add(ctx.exprLineColumnValues, expr.columnNumber)
            add(ctx.exprLineColumnNext, previousHead)
            ctx.exprLineColumnHeads[lineIndex] = columnIndex
    err = ""
    return true

fn TypedExprClearSourceExprLineColumnsForRange(ctx: var TypedExprSourceContext,
                                               exprLayer: var parser.NormalizedExprLayer,
                                               startIndex: int32,
                                               endIndexRaw: int32) =
    if startIndex < 0 || endIndexRaw < startIndex || endIndexRaw > exprLayer.exprs.len:
        panic(Fmt"typed expr: clear expr range invalid start={startIndex} end={endIndexRaw} expr_count={exprLayer.exprs.len}")
    for i in startIndex..<endIndexRaw:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        let lineNumber = exprLayer.exprs[i].lineNumber
        let lineIndex = TypedExprSourceContextLineIndex(ctx, lineNumber)
        if lineIndex < 0 || lineIndex >= ctx.exprLineColumnHeads.len:
            panic(Fmt"typed expr: clear expr line out of range source={exprLayer.exprs[i].sourcePath} line={lineNumber} line_count={ctx.exprLineColumnHeads.len} expr_index={i}")
        ctx.exprLineColumnHeads[lineIndex] = -1
    setLen(ctx.exprLineColumnValues, 0)
    setLen(ctx.exprLineColumnNext, 0)

fn TypedExprBuildFactsAppendMetadataContext(sourceTexts: var TypedExprSourceText[],
                                             sourceIndex: int32,
                                             contexts: var TypedExprSourceContext[],
                                             err: var str): bool =
    var sourceForContext = sourceTexts[sourceIndex]
    TypedExprEnsureSourceTextLoaded(sourceForContext)
    TypedExprFactsContextTrace(Fmt"facts_context_index={sourceIndex} source={sourceForContext.sourcePath}")
    var ctx: TypedExprSourceContext
    TypedExprTraceLine("typed_facts:before_build_source_context")
    if !TypedExprBuildSourceContextBorrowed(sourceForContext,
                                            ctx,
                                            false,
                                            false,
                                            true,
                                            TypedExprFunctionFilterIndex(),
                                            err):
        if err != "":
            err = parser.ParserConcat2(
                " typed expr: build source context failed: ",
                parser.ParserOwnedText(err))
        else:
            err = " typed expr: build source context failed"
        return false
    TypedExprClearSourceTextBody(sourceForContext)
    if sourceTexts[sourceIndex].sourcePath != "":
        TypedExprClearSourceTextBody(sourceTexts[sourceIndex])
    TypedExprTraceLine("typed_facts:after_build_source_context")
    TypedExprFactsContextTrace(Fmt"facts_context_done_index={sourceIndex} source={sourceForContext.sourcePath}")
    TypedExprTraceLine("typed_facts:context")
    ctx.lines = []
    ctx.bindings = []
    ctx.bindingNameIndexBuiltCount = -1
    ctx.exprLineColumnHeads = []
    ctx.exprLineColumnValues = []
    ctx.exprLineColumnNext = []
    ctx.coldCsgTypeRows = []
    ctx.coldCsgStatementRows = []
    TypedExprClearMetadataContextScopeSourcePaths(ctx)
    TypedExprSourceContextAppendMove(contexts, ctx)
    TypedExprTraceLine("typed_facts:after_context_add")
    TypedExprClearSourceTextAllFields(sourceForContext)
    err = ""
    return true

@borrows
fn typedExprBuildFactsContextFromSelectedMetadata(
        source: var TypedExprSourceText,
        metadataCtx: TypedExprSourceContext,
        metadataContexts: TypedExprSourceContext[],
        normalizedText: str,
        selectedScopeIndexes: int32[],
        selectedLineStarts: int32[],
        selectedLineCounts: int32[],
        ctx: var TypedExprSourceContext,
        err: var str): bool =
    ctx.sourcePath = strings.CloneStr(source.sourcePath)
    ctx.normalizedSourcePath = parser.ParserNormalizePath(source.sourcePath)
    ctx.packageOwnerKey = strings.CloneStr(metadataCtx.packageOwnerKey)
    # The reusable context owns only the selected range-CSR overlay.  Once the
    # normalized bytes have been projected, every absent line is outside that
    # frozen overlay and must hard-fail in TypedExprSourceLine; falling back to
    # the physical file would silently turn a sparse slice into a full-source
    # rescan while leaving factsFullSourceRescanCount at zero.
    ctx.snapshotOnly = true
    ctx.lineNumbers = []
    ctx.sourceLineCount = 0
    ctx.lines = []
    ctx.scopes = []
    ctx.signatureScopes = []
    ctx.bindings = []
    ctx.importcFunctions = []
    ctx.importedModules = []
    ctx.declaredTypes = []
    ctx.declaredTypeProducerSourceIndexes = []
    ctx.declaredTypeDeclarationSourceLocalRows = []
    ctx.declaredTypeBuiltinKinds = []
    ctx.refTypes = []
    ctx.typeDefAliasNames = []
    ctx.typeDefAliasTargetTypes = []
    ctx.typeFields = []
    ctx.coldCsgTypeRows = []
    ctx.coldCsgStatementRows = []
    ctx.enumValueNames = []
    ctx.enumValueTypes = []
    ctx.enumValueOrdinals = []
    ctx.exprLineColumnHeads = []
    ctx.exprLineColumnValues = []
    ctx.exprLineColumnNext = []
    ctx.bindingNameIndexBucketHeads = []
    ctx.bindingNameIndexEntryNames = []
    ctx.bindingNameIndexEntryBindingIndexes = []
    ctx.bindingNameIndexEntryNext = []
    ctx.bindingNameIndexBuiltCount = -1
    ctx.scopeNameIndexBucketHeads = []
    ctx.scopeNameIndexEntryNames = []
    ctx.scopeNameIndexEntryScopeIndexes = []
    ctx.scopeNameIndexEntryNext = []
    ctx.scopeNameIndexBuiltCount = -1
    if selectedLineStarts.len != selectedLineCounts.len ||
       selectedScopeIndexes.len != selectedLineStarts.len:
        err = Fmt" typed expr: selected range overlay shape mismatch scopes={selectedScopeIndexes.len} starts={selectedLineStarts.len} counts={selectedLineCounts.len}"
        return false
    for selectedIndex in 0..<selectedScopeIndexes.len:
        let scopeIndex = selectedScopeIndexes[selectedIndex]
        if scopeIndex < 0 || scopeIndex >= metadataCtx.scopes.len:
            err = Fmt" typed expr: selected scope index out of range selected={selectedIndex} scope_index={scopeIndex} scopes={metadataCtx.scopes.len}"
            return false
        var scope = share(metadataCtx.scopes[scopeIndex])
        scope.sourcePath = strings.CloneStr(source.sourcePath)
        add(ctx.scopes, scope)
        ctx.factsSelectedScopeVisitCount =
            ctx.factsSelectedScopeVisitCount + Int64(1)
    TypedExprAttachStableMetadataToRebuildContext(ctx, metadataCtx)
    if metadataCtx.frozenMetadataProjection != nil ||
       metadataCtx.sourceLineByteStarts.len > 0:
        if normalizedText != "":
            err = Fmt" typed expr: sealed reusable facts received an unindexed normalized source copy source={source.sourcePath}"
            return false
        if !TypedExprAppendSelectedSealedSourceLines(
                source,
                metadataCtx,
                selectedLineStarts,
                selectedLineCounts,
                ctx.lineNumbers,
                ctx.lines,
                ctx.factsSelectedLineVisitCount,
                ctx.factsSelectedLineBytes,
                ctx.sourceLineCount,
                err):
            return false
        for bindingIndex in 0..<metadataCtx.bindings.len:
            var binding = share(metadataCtx.bindings[bindingIndex])
            if !binding.globalFlag || binding.functionName != "":
                panic(Fmt"typed expr: frozen metadata retained a non-global binding source={source.sourcePath} row={bindingIndex}")
            binding.sourcePath = strings.CloneStr(source.sourcePath)
            add(ctx.bindings, binding)
            ctx.factsSelectedBindingVisitCount =
                ctx.factsSelectedBindingVisitCount + Int64(1)
            ctx.factsGlobalBindingVisitCount =
                ctx.factsGlobalBindingVisitCount + Int64(1)
    else:
        TypedExprAppendSelectedSourceLines(normalizedText,
                                           selectedLineStarts,
                                           selectedLineCounts,
                                           ctx.lineNumbers,
                                           ctx.lines,
                                           ctx.factsSelectedLineVisitCount,
                                           ctx.sourceLineCount)
    for selectedIndex in 0..<selectedLineStarts.len:
        let selectedStart = selectedLineStarts[selectedIndex]
        let selectedEnd = selectedStart + selectedLineCounts[selectedIndex] - 1
        if selectedEnd > ctx.sourceLineCount ||
           TypedExprSourceContextLineIndex(ctx, selectedStart) < 0 ||
           TypedExprSourceContextLineIndex(ctx, selectedEnd) < 0:
            err = Fmt" typed expr: selected source range outside frozen bytes source={source.sourcePath} range={selectedStart}..{selectedEnd} source_lines={ctx.sourceLineCount}"
            return false
    if ctx.lines.len <= 0:
        err = Fmt" typed expr: empty source lines for facts source={source.sourcePath}"
        return false
    # Metadata attachment above installs the one authoritative package index.
    # Binding inference must keep that producer alive: a call-declaration-only
    # replacement drops ctx_field_* / ctx_ref_* / import rows, so a valid RHS
    # such as `pool.index` becomes untypable even though the frozen/full SoA
    # contains the exact owner and field rows.  The authoritative index is
    # already call-declaration sealed and supports both pre-seal and frozen
    # read-only queries; rebuilding a partial per-source index is invalid.
    if ctx.buildIndex == nil || ctx.buildIndex != metadataCtx.buildIndex ||
       ctx.buildIndex.released || !ctx.buildIndex.callDeclarationSealed ||
       ctx.buildIndexOwned:
        panic(Fmt"typed expr: facts binding requires borrowed authoritative sealed build index source={source.sourcePath}")
    for scopeIndex in 0..<ctx.scopes.len:
        let scope = ctx.scopes[scopeIndex]
        if scope.startLine <= 0 ||
           scope.startLine > TypedExprSourceContextLineCount(ctx):
            continue
        let declHeader = TypedExprFunctionDeclHeaderTextForContext(
            ctx, scope.startLine)
        TypedExprAppendParamBindings(ctx.bindings, scope, declHeader)
    var inGlobalVarBlock = false
    var inGlobalConstBlock = false
    for i in 0..<ctx.lines.len:
        let lineNumber = ctx.lineNumbers.len > 0 ? ctx.lineNumbers[i] : i + 1
        let rawLineForBinding = ctx.lines[i]
        let trimmedForBinding = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLineForBinding)))
        let hasLeadingIndent = parser.ParserHasLeadingIndent(rawLineForBinding)
        if !hasLeadingIndent:
            if trimmedForBinding != "":
                inGlobalVarBlock = trimmedForBinding == "var"
                inGlobalConstBlock = trimmedForBinding == "const"
        # Packed rows contain only the range CSR plus top-level/global rows.
        # No full-source membership bitmap is consulted here.
        var bindingName = ""
        var bindingType = ""
        var rhsStartColumn: int32 = -1
        if !TypedExprParseBindingLine(rawLineForBinding, bindingName, bindingType, rhsStartColumn):
            if (inGlobalVarBlock || inGlobalConstBlock) &&
               parser.ParserHasLeadingIndent(rawLineForBinding):
                var globalName = ""
                var globalType = ""
                var globalInit = ""
                var globalOk = false
                if TypedExprParseTypeFieldLine(rawLineForBinding, globalName, globalType):
                    globalOk = true
                elif inGlobalConstBlock:
                    globalOk = TypedExprConstBlockEntryBinding(
                        rawLineForBinding,
                        globalName,
                        globalType,
                        globalInit)
                if globalOk:
                    if TypedExprTypeContainsSabiBoundary(globalType):
                        err = Fmt"ZRPC/SABI violation at {source.sourcePath}:{lineNumber}: SABI boundary type `{globalType}` cannot be used as a global value"
                        return false
                    TypedExprMaybeAddBindingInit(ctx.bindings,
                                               source.sourcePath,
                                               "",
                                               true,
                                               inGlobalVarBlock,
                                               lineNumber,
                                               globalName,
                                               globalType,
                                               globalInit)
            continue
        if TypedExprTypeContainsSabiBoundary(bindingType):
            err = Fmt"ZRPC/SABI violation at {source.sourcePath}:{lineNumber}: SABI boundary type `{bindingType}` cannot be used as a local/global value"
            return false
        if bindingType == "" && rhsStartColumn > 0:
            bindingType = TypedExprBindingRhsBoolExprType(TypedExprBindingRhsText(rawLineForBinding,
                                                                                 rhsStartColumn))
        if bindingType == "" && rhsStartColumn > 0:
            bindingType = TypedExprLiteralBindingType(TypedExprBindingRhsText(rawLineForBinding,
                                                                              rhsStartColumn))
        let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
        if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
            bindingType = TypedExprInferLocalDeclTypeFromIdentRhs(ctx.bindings,
                                                                  ctx.scopes[scopeIndex].name,
                                                                  lineNumber,
                                                                  TypedExprBindingRhsText(rawLineForBinding,
                                                                                          rhsStartColumn))
        if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
            bindingType = TypedExprBindingRhsForRangeI32Type(ctx,
                                                             ctx.scopes[scopeIndex],
                                                             lineNumber,
                                                             TypedExprBindingRhsText(rawLineForBinding,
                                                                                     rhsStartColumn))
        if bindingType == "" && rhsStartColumn > 0:
            let newDeclRhs = TypedExprBindingRhsTextWithContinuation(ctx, i, rhsStartColumn)
            let newDeclHead = TypedExprBindingRhsCallHead(newDeclRhs)
            if TypedExprQualifiedCallLeaf(newDeclHead) == "new":
                let newDeclOpen = TypedExprFindWholeCallOpenParen(newDeclRhs)
                let newDeclClose = TypedExprFindMatchingParen(newDeclRhs, newDeclOpen)
                if newDeclOpen > 0 && newDeclClose > newDeclOpen:
                    let newDeclArg = chengpath.PathTrim(chengpath.TextSlice(newDeclRhs,
                                                                           newDeclOpen + 1,
                                                                           newDeclClose - newDeclOpen - 1))
                    if newDeclArg != "" && TypedExprFindTopLevelToken(newDeclArg, ",") < 0:
                        let newDeclRef = TypedExprNormalizeTypeText(Fmt"ref{newDeclArg}")
                        if TypedExprTypeTextIsConcrete(newDeclRef):
                            bindingType = newDeclRef
        if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
            let bindingRhsCallText = TypedExprBindingRhsTextWithContinuation(ctx,
                                                                             i,
                                                                             rhsStartColumn)
            bindingType = TypedExprNamedAggregateConstructorBindingTypeInContext(
                ctx,
                metadataContexts,
                bindingRhsCallText)
            if bindingType == "":
                let bindingRhsCallHead = TypedExprBindingRhsCallHead(bindingRhsCallText)
                if bindingRhsCallHead != "" &&
                   TypedExprQualifiedCallQualifier(bindingRhsCallHead) == "":
                    TypedExprBindingNameIndexPrepare(ctx)
                    let bindingLocalCallReturnType = TypedExprBindingRhsCallReturnType(ctx,
                                                                                       metadataContexts,
                                                                                       lineNumber,
                                                                                       bindingRhsCallText)
                    if bindingLocalCallReturnType != "" && bindingLocalCallReturnType != "void":
                        bindingType = bindingLocalCallReturnType
        if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
            let bindingRhsStaticText = TypedExprBindingRhsTextWithContinuation(ctx,
                                                                               i,
                                                                               rhsStartColumn)
            # Static typing below reads previous local/parameter bindings
            # through TypedExprLookupBindingTypeIndexed. The context is still
            # being built line-by-line, so refresh the immutable name index
            # immediately before this read-only query.
            TypedExprBindingNameIndexPrepare(ctx)
            bindingType = TypedExprStaticExprTypeAtLevel(ctx,
                                                          metadataContexts,
                                                          ctx.scopes[scopeIndex],
                                                          lineNumber,
                                                          bindingRhsStaticText,
                                                          0)
        if scopeIndex >= 0:
            TypedExprMaybeAddBinding(ctx.bindings,
                                       source.sourcePath,
                                       ctx.scopes[scopeIndex].name,
                                       false,
                                       parser.ParserBindingDeclarationIsMutable(
                                           rawLineForBinding),
                                       lineNumber,
                                       bindingName,
                                       bindingType)
        else:
            var globalInitText = ""
            if rhsStartColumn > 0:
                globalInitText = TypedExprBindingRhsText(rawLineForBinding,
                                                         rhsStartColumn)
            TypedExprMaybeAddBindingInit(ctx.bindings,
                                         source.sourcePath,
                                         "",
                                         true,
                                         parser.ParserBindingDeclarationIsMutable(
                                             rawLineForBinding),
                                         lineNumber,
                                         bindingName,
                                         bindingType,
                                         globalInitText)
        ctx.factsSelectedBindingVisitCount =
            ctx.factsSelectedBindingVisitCount + Int64(1)
    TypedExprBindingNameIndexPrepare(ctx)
    err = ""
    return true

@borrows
fn TypedExprBuildFactsContextFromMetadata(source: var TypedExprSourceText,
                                           metadataCtx: TypedExprSourceContext,
                                           metadataContexts: TypedExprSourceContext[],
                                           exprLayer: parser.NormalizedExprLayer,
                                           exprStart: int32,
                                           exprEnd: int32,
                                           ctx: var TypedExprSourceContext,
                                           err: var str): bool =
    var normalizedText = ""
    if !TypedExprNormalizedSourceTextForContext(source, normalizedText, err):
        return false
    var selectedScopeIndexes: int32[]
    var selectedLineStarts: int32[]
    var selectedLineCounts: int32[]
    TypedExprBuildFactsSelectedRangesForExprRange(source.sourcePath,
                                                  metadataCtx.scopes,
                                                  exprLayer,
                                                  exprStart,
                                                  exprEnd,
                                                  selectedScopeIndexes,
                                                  selectedLineStarts,
                                                  selectedLineCounts)
    return typedExprBuildFactsContextFromSelectedMetadata(source,
                                                           metadataCtx,
                                                           metadataContexts,
                                                           normalizedText,
                                                           selectedScopeIndexes,
                                                           selectedLineStarts,
                                                           selectedLineCounts,
                                                           ctx,
                                                           err)

# 裁定: 单一权威=plan 封缄身份。root 外文件先核对是否 sealed closure 成员
# (sourceTexts 即 typed expr 当前封缄闭包的文件集合, 精确 sourcePath 匹配),
# 在 closure 内即直通作身份键, 不再要 root 锚点; 不在才走 known-roots 校验,
# 严禁任意路径放行。
fn TypedExprMetadataSourceIdentityKey(sourceTexts: var TypedExprSourceText[],
                                      sourcePathRaw: str,
                                      out: var str,
                                      err: var str): bool =
    out = ""
    let reqPath = parser.ParserNormalizePath(sourcePathRaw)
    var inSealedClosure = false
    for i in 0..<sourceTexts.len:
        if sourceTexts[i].sourcePath == reqPath:
            inSealedClosure = true
    if inSealedClosure:
        out = reqPath
        err = ""
        return true
    var roots: str[]
    if !TypedExprSourceIdentityRoots(sourceTexts[0].workspaceRoot,
                                     sourceTexts[0].packageRoot,
                                     sourceTexts[0].externalPackageRoots,
                                     roots,
                                     err):
        return false
    return TypedExprSourceIdentityKeyFromRoots(roots,
                                               sourceTexts[0].packageRoot,
                                               sourcePathRaw,
                                               out,
                                               err)

fn TypedExprEnsureMetadataContextForSourcePath(sourceTexts: var TypedExprSourceText[],
                                               sourcePathRaw: str,
                                               contexts: var TypedExprSourceContext[],
                                               err: var str): bool =
    if sourceTexts.len <= 0:
        err = " typed expr: metadata source roots missing"
        return false
    var sourcePath: str
    if !TypedExprMetadataSourceIdentityKey(sourceTexts,
                                           sourcePathRaw,
                                           sourcePath,
                                           err):
        return false
    if TypedExprSourceTextsSnapshotOnly(sourceTexts):
        err = Fmt" typed expr: snapshot-only metadata context missing source={sourcePath}"
        return false
    var workspaceRoot = ""
    var packageRoot = ""
    var packageId = ""
    var packageChannel = ""
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    if sourceTexts.len > 0:
        workspaceRoot = sourceTexts[0].workspaceRoot
        packageRoot = sourceTexts[0].packageRoot
        packageId = sourceTexts[0].packageId
        packageChannel = sourceTexts[0].packageChannel
        externalPackageRoots = sourceTexts[0].externalPackageRoots
    var sourceText = chengpath.ReadTextFile("", sourcePath)
    if sourceText == "":
        sourceText = os.ReadFile(chengpath.PathProviderFilePath(sourcePath))
    if sourceText == "":
        err = Fmt" typed expr: missing source text for metadata context source={sourcePath}"
        return false
    var sourceForContext = TypedExprSourceTextNewWithPackageFacts(workspaceRoot,
                                                                   packageRoot,
                                                                   packageId,
                                                                   packageChannel,
                                                                   externalPackageRoots,
                                                                   sourcePath,
                                                                   sourceText)
    TypedExprEnsureSourceTextLoaded(sourceForContext)
    var ctx: TypedExprSourceContext
    if !TypedExprBuildSourceContextBorrowed(sourceForContext,
                                            ctx,
                                            false,
                                            false,
                                            true,
                                            TypedExprFunctionFilterIndex(),
                                            err):
        if err != "":
            err = parser.ParserConcat2(
                " typed expr: rebuild metadata source context failed: ",
                parser.ParserOwnedText(err))
        else:
            err = " typed expr: rebuild metadata source context failed"
        return false
    ctx.lines = []
    ctx.bindings = []
    ctx.bindingNameIndexBuiltCount = -1
    ctx.exprLineColumnHeads = []
    ctx.exprLineColumnValues = []
    ctx.exprLineColumnNext = []
    ctx.coldCsgTypeRows = []
    ctx.coldCsgStatementRows = []
    TypedExprClearMetadataContextScopeSourcePaths(ctx)
    TypedExprSourceContextAppendMove(contexts, ctx)
    err = ""
    return true

fn TypedExprEnsureMetadataContextPresentForSourcePath(sourceTexts: var TypedExprSourceText[],
                                                       sourcePathRaw: str,
                                                       contexts: var TypedExprSourceContext[],
                                                       err: var str): bool =
    if sourceTexts.len <= 0:
        err = " typed expr: metadata source roots missing"
        return false
    var sourcePath: str
    if !TypedExprMetadataSourceIdentityKey(sourceTexts,
                                           sourcePathRaw,
                                           sourcePath,
                                           err):
        return false
    var contextLookup: parser.ParserSourcePathIndexLookup
    if !TypedExprBuildSourceContextExactIndex(contexts, contextLookup, err):
        return false
    if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextLookup,
                                                                   sourcePath) >= 0:
        err = ""
        return true
    return TypedExprEnsureMetadataContextForSourcePath(sourceTexts,
                                                       sourcePath,
                                                       contexts,
                                                       err)

fn TypedExprEnsureMetadataContextForSourceIndex(sourceTexts: var TypedExprSourceText[],
                                                sourceIndex: int32,
                                                contexts: var TypedExprSourceContext[],
                                                err: var str): bool =
    if sourceIndex < 0 || sourceIndex >= sourceTexts.len:
        err = Fmt" typed expr: metadata source index out of range source_index={sourceIndex} source_count={sourceTexts.len}"
        return false
    return TypedExprEnsureMetadataContextForSourcePath(sourceTexts,
                                                       sourceTexts[sourceIndex].sourcePath,
                                                       contexts,
                                                       err)

# CHENG_TF_SUBTIME sub-timing probe (decl_line). Env-gated once per process;
# the default path pays one boolean check per timer site and nothing else.
# Counters are plain int64 columns; the flush prints and resets once per
# source at TypedExprReleaseReusableFactsSourceContext (survives mid-run
# walls, which is the norm for diagnostic rounds on this frontier).
var typedExprSubTimeEnvReady: bool
var typedExprSubTimeEnabled: bool

const
    TypedExprSubTimeCtxSelectedRanges = 0
    TypedExprSubTimeCtxFromMetadata = 1
    TypedExprSubTimeCtxLineColumns = 2
    TypedExprSubTimeSlicePrepare = 3
    TypedExprSubTimeSliceIdentity = 4
    TypedExprSubTimeColsPrepare = 5
    TypedExprSubTimeColsPopulate = 6
    TypedExprSubTimeFactIdentity = 7
    TypedExprSubTimeFactBuild = 8
    TypedExprSubTimeFactCanon = 9
    TypedExprSubTimeFactInferred = 10
    TypedExprSubTimeFactAppend = 11
    TypedExprSubTimeSliceValidate = 12
    TypedExprSubTimeSliceCompact = 13
    TypedExprSubTimeBfStableId = 14
    TypedExprSubTimeBfSink = 15
    TypedExprSubTimeBfPreflight = 16
    TypedExprSubTimeBfAggregate = 17
    TypedExprSubTimeBfResolve = 18
    TypedExprSubTimeBfQual = 19
    TypedExprSubTimeBfLookupMain = 20
    TypedExprSubTimeVaAgg = 21
    TypedExprSubTimeVaZero = 22
    TypedExprSubTimeVaQual = 23
    TypedExprSubTimeVaReresolve = 24
    TypedExprSubTimeStepCount = 25

var typedExprSubTimeStepNs: int64[25]
var typedExprSubTimeStepCalls: int64[25]
var typedExprSubTimeKindNs: int64[64]
var typedExprSubTimeKindCnt: int64[64]
var typedExprSubTimeSlices: int64
var typedExprSubTimeExprs: int64
var typedExprSubTimeFacts: int64
var typedExprSubTimeArmed: bool
# Heaviest-slice leaderboard per source: rank 0 is the heaviest slice.
var typedExprSubTimeTopNs: int64[3]
var typedExprSubTimeTopLine: int32[3]
var typedExprSubTimeTopExprs: int32[3]
# Heaviest-fact leaderboard per source: rank 0 is the costliest single fact.
var typedExprSubTimeTopFactNs: int64[3]
var typedExprSubTimeTopFactPre: int64[3]
var typedExprSubTimeTopFactRes: int64[3]
var typedExprSubTimeTopFactLine: int32[3]
var typedExprSubTimeTopFactKind: int32[3]
var typedExprSubTimeTopFactCallee0: str
var typedExprSubTimeTopFactCallee1: str
var typedExprSubTimeTopFactCallee2: str
# Per-fact named sub-step tallies written by TypedExprBuildFactInto.
var typedExprSubTimeLastPreflight: int64
var typedExprSubTimeLastResolve: int64

fn TypedExprSubTimeEnabled(): bool =
    if !typedExprSubTimeEnvReady:
        typedExprSubTimeEnabled = os.GetEnv("CHENG_TF_SUBTIME") == "1"
        typedExprSubTimeEnvReady = true
    return typedExprSubTimeEnabled

fn TypedExprSubTimeNowNs(): int64 =
    return monotimes.MonoTimeNs(monotimes.GetMonoTime())

fn TypedExprSubTimeAccum(step: int32, startNs: int64) =
    typedExprSubTimeStepNs[step] = typedExprSubTimeStepNs[step] +
                                   (TypedExprSubTimeNowNs() - startNs)
    typedExprSubTimeStepCalls[step] = typedExprSubTimeStepCalls[step] + 1

fn TypedExprSubTimeReset() =
    var step: int32
    while step < TypedExprSubTimeStepCount:
        typedExprSubTimeStepNs[step] = 0
        typedExprSubTimeStepCalls[step] = 0
        step = step + 1
    typedExprSubTimeSlices = 0
    typedExprSubTimeExprs = 0
    typedExprSubTimeFacts = 0
    var kindCode: int32
    while kindCode < 64:
        typedExprSubTimeKindNs[kindCode] = 0
        typedExprSubTimeKindCnt[kindCode] = 0
        kindCode = kindCode + 1
    var rank: int32
    while rank < 3:
        typedExprSubTimeTopNs[rank] = 0
        typedExprSubTimeTopLine[rank] = 0
        typedExprSubTimeTopExprs[rank] = 0
        rank = rank + 1
    rank = 0
    while rank < 3:
        typedExprSubTimeTopFactNs[rank] = 0
        typedExprSubTimeTopFactPre[rank] = 0
        typedExprSubTimeTopFactRes[rank] = 0
        typedExprSubTimeTopFactLine[rank] = 0
        typedExprSubTimeTopFactKind[rank] = 0
        typedExprSubTimeTopFactCallee0 = ""
        typedExprSubTimeTopFactCallee1 = ""
        typedExprSubTimeTopFactCallee2 = ""
        rank = rank + 1

@borrows
fn TypedExprSubTimeNoteFact(factNs: int64,
                            preflightNs: int64,
                            resolveNs: int64,
                            lineNumber: int32,
                            kindCode: int32,
                            callee: str) =
    if factNs <= typedExprSubTimeTopFactNs[2]:
        return
    var rank: int32 = 2
    while rank > 0:
        if typedExprSubTimeTopFactNs[rank - 1] >= factNs:
            break
        typedExprSubTimeTopFactNs[rank] = typedExprSubTimeTopFactNs[rank - 1]
        typedExprSubTimeTopFactPre[rank] = typedExprSubTimeTopFactPre[rank - 1]
        typedExprSubTimeTopFactRes[rank] = typedExprSubTimeTopFactRes[rank - 1]
        typedExprSubTimeTopFactLine[rank] = typedExprSubTimeTopFactLine[rank - 1]
        typedExprSubTimeTopFactKind[rank] = typedExprSubTimeTopFactKind[rank - 1]
        if rank == 2:
            typedExprSubTimeTopFactCallee2 = typedExprSubTimeTopFactCallee1
        else:
            typedExprSubTimeTopFactCallee1 = typedExprSubTimeTopFactCallee0
        rank = rank - 1
    typedExprSubTimeTopFactNs[rank] = factNs
    typedExprSubTimeTopFactPre[rank] = preflightNs
    typedExprSubTimeTopFactRes[rank] = resolveNs
    typedExprSubTimeTopFactLine[rank] = lineNumber
    typedExprSubTimeTopFactKind[rank] = kindCode
    if rank == 0:
        typedExprSubTimeTopFactCallee0 = strings.CloneStr(callee)
    elif rank == 1:
        typedExprSubTimeTopFactCallee1 = strings.CloneStr(callee)
    else:
        typedExprSubTimeTopFactCallee2 = strings.CloneStr(callee)

fn TypedExprSubTimeNoteSlice(sliceNs: int64, firstLine: int32, exprCount: int32) =
    if sliceNs <= typedExprSubTimeTopNs[2]:
        return
    var rank: int32 = 2
    while rank > 0:
        if typedExprSubTimeTopNs[rank - 1] >= sliceNs:
            break
        typedExprSubTimeTopNs[rank] = typedExprSubTimeTopNs[rank - 1]
        typedExprSubTimeTopLine[rank] = typedExprSubTimeTopLine[rank - 1]
        typedExprSubTimeTopExprs[rank] = typedExprSubTimeTopExprs[rank - 1]
        rank = rank - 1
    typedExprSubTimeTopNs[rank] = sliceNs
    typedExprSubTimeTopLine[rank] = firstLine
    typedExprSubTimeTopExprs[rank] = exprCount

fn TypedExprSubTimeStepName(step: int32): str =
    if step == TypedExprSubTimeCtxSelectedRanges:
        return "ctx_selected_ranges"
    if step == TypedExprSubTimeCtxFromMetadata:
        return "ctx_from_metadata"
    if step == TypedExprSubTimeCtxLineColumns:
        return "ctx_line_columns"
    if step == TypedExprSubTimeSlicePrepare:
        return "slice_prepare"
    if step == TypedExprSubTimeSliceIdentity:
        return "slice_identity"
    if step == TypedExprSubTimeColsPrepare:
        return "cols_prepare"
    if step == TypedExprSubTimeColsPopulate:
        return "cols_populate"
    if step == TypedExprSubTimeFactIdentity:
        return "fact_identity"
    if step == TypedExprSubTimeFactBuild:
        return "fact_build"
    if step == TypedExprSubTimeFactCanon:
        return "fact_canon"
    if step == TypedExprSubTimeFactInferred:
        return "fact_inferred"
    if step == TypedExprSubTimeFactAppend:
        return "fact_append"
    if step == TypedExprSubTimeSliceValidate:
        return "slice_validate"
    if step == TypedExprSubTimeSliceCompact:
        return "slice_compact"
    if step == TypedExprSubTimeBfStableId:
        return "bf_stable_id"
    if step == TypedExprSubTimeBfSink:
        return "bf_sink"
    if step == TypedExprSubTimeBfPreflight:
        return "bf_preflight"
    if step == TypedExprSubTimeBfAggregate:
        return "bf_aggregate"
    if step == TypedExprSubTimeBfResolve:
        return "bf_resolve"
    if step == TypedExprSubTimeBfQual:
        return "bf_qual"
    if step == TypedExprSubTimeBfLookupMain:
        return "bf_lookup_main"
    if step == TypedExprSubTimeVaAgg:
        return "va_agg"
    if step == TypedExprSubTimeVaZero:
        return "va_zero"
    if step == TypedExprSubTimeVaQual:
        return "va_qual"
    if step == TypedExprSubTimeVaReresolve:
        return "va_reresolve"
    return "unknown"

fn TypedExprSubTimeNoteKindBucket(kindCode: int32, delta: int64) =
    if kindCode < 0 || kindCode >= 64:
        return
    typedExprSubTimeKindNs[kindCode] = typedExprSubTimeKindNs[kindCode] + delta
    typedExprSubTimeKindCnt[kindCode] = typedExprSubTimeKindCnt[kindCode] + 1

fn TypedExprSubTimeTopFactCalleeAt(rank: int32): str =
    if rank == 0:
        return typedExprSubTimeTopFactCallee0
    if rank == 1:
        return typedExprSubTimeTopFactCallee1
    return typedExprSubTimeTopFactCallee2

@borrows
fn TypedExprSubTimeFlush(sourcePath: str) =
    if !TypedExprSubTimeEnabled() || !typedExprSubTimeArmed:
        return
    typedExprSubTimeArmed = false
    let stderr = os.Get_stderr()
    os.WriteLine(stderr, Fmt"tf_subtime source={sourcePath} slices={typedExprSubTimeSlices} exprs={typedExprSubTimeExprs} facts={typedExprSubTimeFacts}")
    var step: int32
    while step < TypedExprSubTimeStepCount:
        if typedExprSubTimeStepCalls[step] > 0:
            let totalMs = typedExprSubTimeStepNs[step] / int64(1000000)
            let avgUs = typedExprSubTimeStepNs[step] /
                        typedExprSubTimeStepCalls[step] / int64(1000)
            os.WriteLine(stderr, Fmt"tf_subtime_step step={TypedExprSubTimeStepName(step)} total_ms={totalMs} calls={typedExprSubTimeStepCalls[step]} avg_us={avgUs}")
        step = step + 1
    var kindCode: int32
    while kindCode < 64:
        if typedExprSubTimeKindCnt[kindCode] > 0:
            os.WriteLine(stderr, Fmt"tf_subtime_kind kind={kindCode} build_ms={typedExprSubTimeKindNs[kindCode] / int64(1000000)} calls={typedExprSubTimeKindCnt[kindCode]}")
        kindCode = kindCode + 1
    var rank: int32
    while rank < 3:
        if typedExprSubTimeTopNs[rank] > 0:
            os.WriteLine(stderr, Fmt"tf_subtime_top rank={rank} line={typedExprSubTimeTopLine[rank]} exprs={typedExprSubTimeTopExprs[rank]} slice_ms={typedExprSubTimeTopNs[rank] / int64(1000000)}")
        rank = rank + 1
    rank = 0
    while rank < 3:
        if typedExprSubTimeTopFactNs[rank] > 0:
            os.WriteLine(stderr, Fmt"tf_subtime_fact rank={rank} line={typedExprSubTimeTopFactLine[rank]} kind={typedExprSubTimeTopFactKind[rank]} build_ms={typedExprSubTimeTopFactNs[rank] / int64(1000000)} preflight_ms={typedExprSubTimeTopFactPre[rank] / int64(1000000)} resolve_ms={typedExprSubTimeTopFactRes[rank] / int64(1000000)} callee={TypedExprSubTimeTopFactCalleeAt(rank)}")
        rank = rank + 1
    TypedExprSubTimeReset()

@borrows
fn TypedExprBuildFactsAppendPreparedSourceRangeFacts(sourceTexts: var TypedExprSourceText[],
                                                      contexts: var TypedExprSourceContext[],
                                                      sourceIdentityIndex: var TypedExprSourceIdentityIndex,
                                                      contextLookup: var parser.ParserSourcePathIndexLookup,
                                                      exprLayer: parser.NormalizedExprLayer,
                                                      exprStart: int32,
                                                      exprEnd: int32,
                                                      preserveSourceTextBody: bool,
                                                      allowSourceSwitch: bool,
                                                      resetExprLineColumns: bool,
                                                      ctxForFacts: var TypedExprSourceContext,
                                                      facts: var TypedExprFactTable,
                                                      sliceScratch: var TypedExprSliceResolutionScratch,
                                                      err: var str): bool =
    let traceFacts = TypedExprFactsStderrTraceEnabled()
    let subTime = TypedExprSubTimeEnabled()
    var stepT0: int64
    var preparedSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         ctxForFacts.sourcePath,
                                         preparedSourceIndex,
                                         err) || preparedSourceIndex < 0:
        err = Fmt" typed expr: prepared facts source identity missing source={ctxForFacts.sourcePath}: {err}"
        return false
    typedExprFactTableEnsureExprRangeCapacity(facts,
                                              exprLayer,
                                              exprStart,
                                              exprEnd)
    if resetExprLineColumns:
        if subTime:
            stepT0 = TypedExprSubTimeNowNs()
        TypedExprPrepareSourceExprLineColumns(ctxForFacts)
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeColsPrepare, stepT0)
    if traceFacts:
        TypedExprFactsStderrTrace(Fmt"typed_facts_after_prepare_columns source={ctxForFacts.sourcePath} line_columns={ctxForFacts.exprLineColumnHeads.len} flat_columns={ctxForFacts.exprLineColumnValues.len} rss={os.ProcessRssBytes()}")
    TypedExprTraceLine("typed_facts:before_populate_source_expr_columns")
    if subTime:
        stepT0 = TypedExprSubTimeNowNs()
    if !TypedExprPopulateSourceExprLineColumnsForRange(ctxForFacts,
                                                       exprLayer,
                                                       exprStart,
                                                       exprEnd,
                                                       err):
        return false
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeColsPopulate, stepT0)
    if traceFacts:
        TypedExprFactsStderrTrace(Fmt"typed_facts_after_populate_columns source={ctxForFacts.sourcePath} facts={facts.count} rss={os.ProcessRssBytes()}")
    TypedExprTraceLine("typed_facts:after_populate_source_expr_columns")
    TypedExprTraceLine("typed_facts:before_fact_loop")
    if subTime:
        typedExprSubTimeExprs = typedExprSubTimeExprs +
                                Int64(exprEnd - exprStart)
    for factIndex in exprStart..<exprEnd:
        TypedExprTraceLine("typed_facts:fact_loop_top")
        if factIndex % 256 == 0:
            os.ProcessResourceGuardCheck()
        if traceFacts && factIndex % 4096 == 0:
            TypedExprFactsStderrTrace(Fmt"typed_facts_loop source={ctxForFacts.sourcePath} fact_index={factIndex} facts={facts.count} rss={os.ProcessRssBytes()}")
        if !TypedExprExprRequiresPersistentFact(exprLayer.exprs[factIndex]):
            continue
        let factExprSourcePath = exprLayer.exprs[factIndex].sourcePath
        var factSourceIndex: int32
        if subTime:
            stepT0 = TypedExprSubTimeNowNs()
        if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                             factExprSourcePath,
                                             factSourceIndex,
                                             err):
            err = Fmt" typed expr: fact expr source identity invalid expr_index={factIndex}: {err}"
            return false
        if factSourceIndex < 0:
            err = Fmt" typed expr: fact expr source missing source={factExprSourcePath} expr_index={factIndex}"
            return false
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeFactIdentity, stepT0)
        if factSourceIndex != preparedSourceIndex:
            if !allowSourceSwitch:
                err = Fmt" typed expr: prepared facts context source mismatch context={ctxForFacts.sourcePath} expr_source={factExprSourcePath} expr_index={factIndex}"
                return false
            if preserveSourceTextBody:
                TypedExprEnsureSourceTextLoaded(sourceTexts[factSourceIndex])
            var sourceForFact = sourceTexts[factSourceIndex]
            TypedExprEnsureSourceTextLoaded(sourceForFact)
            var switchedCtx: TypedExprSourceContext
            let switchedMetadataContextIndex =
                parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextLookup,
                                                                             sourceForFact.sourcePath)
            if switchedMetadataContextIndex < 0:
                err = Fmt" typed expr: missing switched metadata context for facts source {sourceForFact.sourcePath}"
                return false
            if !TypedExprBuildFactsContextFromMetadata(sourceForFact,
                                                       contexts[switchedMetadataContextIndex],
                                                       contexts,
                                                       exprLayer,
                                                       exprStart,
                                                       exprEnd,
                                                       switchedCtx,
                                                       err):
                if err != "":
                    err = parser.ParserConcat2(
                        " typed expr: build switched source context for facts failed: ",
                        parser.ParserOwnedText(err))
                else:
                    err = " typed expr: build switched source context for facts failed"
                return false
            TypedExprPrepareSourceExprLineColumns(switchedCtx)
            if !TypedExprPopulateSourceExprLineColumnsForRange(switchedCtx,
                                                               exprLayer,
                                                               exprStart,
                                                               exprEnd,
                                                               err):
                return false
            ctxForFacts = switchedCtx
            preparedSourceIndex = factSourceIndex
        # A range may intentionally switch to the expression's owning source.
        # Freeze the selected context for this fact, then prove the fact builder
        # itself did not mutate that context identity.
        let factContextSourcePath = parser.ParserNormalizePath(ctxForFacts.sourcePath)
        var fact: TypedExprFact
        if subTime:
            stepT0 = TypedExprSubTimeNowNs()
        TypedExprBuildFactInto(ctxForFacts,
                               contexts,
                               exprLayer.valueExprTree,
                               exprLayer.exprs[factIndex],
                               fact,
                               sliceScratch,
                               factIndex)
        if subTime:
            let buildDelta = TypedExprSubTimeNowNs() - stepT0
            TypedExprSubTimeAccum(TypedExprSubTimeFactBuild, stepT0)
            TypedExprSubTimeNoteKindBucket(
                parser.NormalizedExprKindCode(exprLayer.exprs[factIndex].kind),
                buildDelta)
            TypedExprSubTimeNoteFact(buildDelta,
                                     typedExprSubTimeLastPreflight,
                                     typedExprSubTimeLastResolve,
                                     exprLayer.exprs[factIndex].lineNumber,
                                     parser.NormalizedExprKindCode(exprLayer.exprs[factIndex].kind),
                                     exprLayer.exprs[factIndex].callCallee)
            typedExprSubTimeFacts = typedExprSubTimeFacts + 1
        if parser.ParserNormalizePath(ctxForFacts.sourcePath) != factContextSourcePath:
            err = Fmt" typed expr: fact build mutated prepared context source expected={factContextSourcePath} actual={ctxForFacts.sourcePath} expr_index={factIndex} line={exprLayer.exprs[factIndex].lineNumber} column={exprLayer.exprs[factIndex].columnNumber} kind={parser.NormalizedExprKindCode(exprLayer.exprs[factIndex].kind)} callee={exprLayer.exprs[factIndex].callCallee} target={exprLayer.exprs[factIndex].callTarget} target_source={exprLayer.exprs[factIndex].callTargetSourcePath}"
            return false
        fact.sourcePath = exprLayer.exprs[factIndex].sourcePath
        if subTime:
            stepT0 = TypedExprSubTimeNowNs()
        TypedExprMaterializeNamedTypeCallIfNeeded(fact)
        TypedExprCanonicalizeBuiltFactCallTarget(fact)
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeFactCanon, stepT0)
        # Facts are built in source order. Commit each resolved call sink to the
        # per-range context before building the next fact, so a later call can
        # type a local produced by an earlier call without a second whole-range
        # pass. The binding line strictly precedes every consumer, so dependency
        # resolution is acyclic and remains fail-closed on an unresolved type.
        if subTime:
            stepT0 = TypedExprSubTimeNowNs()
        var bindingsBeforeInferred = ctxForFacts.bindings.len
        TypedExprMaybeAddInferredCallBinding(ctxForFacts, contexts, fact)
        if ctxForFacts.bindings.len > bindingsBeforeInferred &&
           sliceScratch.exprCount > factIndex:
            # [d2 M3] This fact registered its own binding after its build:
            # the re-validator must keep re-deriving its resolution because a
            # same-line self-shadow changes eligibility between the passes.
            sliceScratch.resolveFlags[factIndex] =
                sliceScratch.resolveFlags[factIndex] | 4
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeFactInferred, stepT0)
        if TypedExprBuiltinFactCanDropArgsText(fact):
            fact.callArgsText = ""
        TypedExprTraceLine("typed_facts:after_build_fact")
        if subTime:
            stepT0 = TypedExprSubTimeNowNs()
        TypedExprFactTableAppendPrepared(facts, fact)
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeFactAppend, stepT0)
        TypedExprTraceLine("typed_facts:after_add_fact")
    err = ""
    return true

fn TypedExprBuildFactsAppendSourceRangeFacts(sourceTexts: var TypedExprSourceText[],
                                              sourceIndex: int32,
                                              contexts: var TypedExprSourceContext[],
                                              sourceIdentityIndex: var TypedExprSourceIdentityIndex,
                                              contextLookup: var parser.ParserSourcePathIndexLookup,
                                              exprLayer: var parser.NormalizedExprLayer,
                                              exprStart: int32,
                                              exprEnd: int32,
                                              preserveSourceTextBody: bool,
                                              facts: var TypedExprFactTable,
                                              err: var str): bool =
    if sourceIndex < 0 || sourceIndex >= sourceTexts.len:
        err = Fmt" typed expr: source index out of range source_index={sourceIndex} source_count={sourceTexts.len}"
        return false
    var traceFacts = TypedExprFactsStderrTraceEnabled()
    if traceFacts:
        var traceSourcePath = ""
        if sourceIndex >= 0 && sourceIndex < sourceTexts.len:
            traceSourcePath = sourceTexts[sourceIndex].sourcePath
        TypedExprFactsStderrTrace(Fmt"typed_facts_range_enter source={traceSourcePath} expr_start={exprStart} expr_end={exprEnd} existing_facts={facts.count} contexts={contexts.len} rss={os.ProcessRssBytes()}")
    if preserveSourceTextBody:
        TypedExprEnsureSourceTextLoaded(sourceTexts[sourceIndex])
    var sourceForFacts = sourceTexts[sourceIndex]
    TypedExprEnsureSourceTextLoaded(sourceForFacts)
    if traceFacts:
        TypedExprFactsStderrTrace(Fmt"typed_facts_after_source_text source={sourceForFacts.sourcePath} text_len={sourceForFacts.text.len} rss={os.ProcessRssBytes()}")
    var ctxForFacts: TypedExprSourceContext
    var rangeScratch: TypedExprSliceResolutionScratch
    var normalizedSourcePath: str
    var sourcePathErr: str
    if !TypedExprLexicalSourcePath(sourceForFacts.sourcePath,
                                   normalizedSourcePath,
                                   sourcePathErr):
        err = sourcePathErr
        return false
    let metadataContextIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextLookup,
                                                                                            normalizedSourcePath)
    if metadataContextIndex < 0:
        err = Fmt" typed expr: missing metadata context for facts source {sourceForFacts.sourcePath}"
        return false
    if sourceForFacts.snapshotOnly:
        if !contexts[metadataContextIndex].snapshotOnly:
            err = Fmt" typed expr: snapshot-only facts metadata contract missing source={sourceForFacts.sourcePath}"
            return false
        if contexts[metadataContextIndex].scopes.len <= 0:
            err = Fmt" typed expr: snapshot-only facts scope table missing source={sourceForFacts.sourcePath}"
            return false
    if !TypedExprBuildFactsContextFromMetadata(sourceForFacts,
                                               contexts[metadataContextIndex],
                                               contexts,
                                               exprLayer,
                                               exprStart,
                                               exprEnd,
                                               ctxForFacts,
                                               err):
        if err != "":
            err = parser.ParserConcat2(
                " typed expr: build source context for facts failed: ",
                parser.ParserOwnedText(err))
        else:
            err = " typed expr: build source context for facts failed"
        return false
    if traceFacts:
        TypedExprFactsStderrTrace(Fmt"typed_facts_after_source_context source={ctxForFacts.sourcePath} scopes={ctxForFacts.scopes.len} bindings={ctxForFacts.bindings.len} lines={ctxForFacts.lines.len} rss={os.ProcessRssBytes()}")
    if traceFacts:
        TypedExprFactsStderrTrace(Fmt"typed_facts_after_attach_metadata source={ctxForFacts.sourcePath} scopes={ctxForFacts.scopes.len} bindings={ctxForFacts.bindings.len} rss={os.ProcessRssBytes()}")
    TypedExprClearSourceTextBody(sourceForFacts)
    if !preserveSourceTextBody && sourceTexts[sourceIndex].sourcePath != "":
        TypedExprClearSourceTextBody(sourceTexts[sourceIndex])
    TypedExprTraceLine("typed_facts:before_expr_line_columns_init")
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SITE=facts_ctx_init")
    if !TypedExprBuildFactsAppendPreparedSourceRangeFacts(sourceTexts,
                                                          contexts,
                                                          sourceIdentityIndex,
                                                          contextLookup,
                                                          exprLayer,
                                                          exprStart,
                                                          exprEnd,
                                                          preserveSourceTextBody,
                                                          true,
                                                          true,
                                                          ctxForFacts,
                                                          facts,
                                                          rangeScratch,
                                                          err):
        return false
    TypedExprClearSourceContextAllFields(ctxForFacts)
    TypedExprClearSourceTextAllFields(sourceForFacts)
    if traceFacts:
        TypedExprFactsStderrTrace(Fmt"typed_facts_range_done source_index={sourceIndex} facts={facts.count} rss={os.ProcessRssBytes()}")
    err = ""
    return true

fn TypedExprAppendSourceTextForPath(sourceTexts: var TypedExprSourceText[],
                                    sourcePathRaw: str,
                                    err: var str): int32 =
    if sourceTexts.len <= 0:
        err = " typed expr: source text roots missing"
        return -1
    var roots: str[]
    if !TypedExprSourceIdentityRoots(sourceTexts[0].workspaceRoot,
                                     sourceTexts[0].packageRoot,
                                     sourceTexts[0].externalPackageRoots,
                                     roots,
                                     err):
        return -1
    var sourcePath: str
    if !TypedExprSourceIdentityKeyFromRoots(roots,
                                            sourceTexts[0].packageRoot,
                                            sourcePathRaw,
                                            sourcePath,
                                            err):
        return -1
    if TypedExprSourceTextsSnapshotOnly(sourceTexts):
        err = Fmt" typed expr: snapshot-only source row missing source={sourcePath}"
        return -1
    var workspaceRoot = ""
    var packageRoot = ""
    var packageId = ""
    var packageChannel = ""
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    if sourceTexts.len > 0:
        workspaceRoot = sourceTexts[0].workspaceRoot
        packageRoot = sourceTexts[0].packageRoot
        packageId = sourceTexts[0].packageId
        packageChannel = sourceTexts[0].packageChannel
        externalPackageRoots = sourceTexts[0].externalPackageRoots
    var text = chengpath.ReadTextFile("", sourcePath)
    if text == "":
        text = os.ReadFile(chengpath.PathProviderFilePath(sourcePath))
    if text == "":
        err = Fmt" typed expr: missing source text for source={sourcePath}"
        return -1
    add(sourceTexts, TypedExprSourceTextNewWithPackageFacts(workspaceRoot,
                                                             packageRoot,
                                                             packageId,
                                                             packageChannel,
                                                             externalPackageRoots,
                                                             sourcePath,
                                                             text))
    err = ""
    return sourceTexts.len - 1

fn TypedExprCompactStoredFactsRange(facts: var TypedExprFactTable,
                                     startIndex: int32,
                                     endIndexRaw: int32) =
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > facts.count:
        endIndex = facts.count
    for i in startIndex..<endIndex:
        var fact = TypedExprFactAt(facts, i)
        if TypedExprBuiltinFactCanDropArgsText(fact):
            fact.callArgsText = ""
        if fact.callTarget == fact.callCallee:
            fact.callTarget = fact.callCallee
        TypedExprFactTableSet(facts, i, fact)

fn TypedExprCanonicalizeBuiltFactCallTarget(fact: var TypedExprFact) =
    if fact.kind != parser.NormalizedExprCall:
        return
    if !fact.callResolved:
        return
    if fact.callKind == TypedExprCallBuiltin && !fact.callTargetImportc:
        fact.callTarget = ""
        fact.callTargetSourcePath = ""
        return
    if fact.callQualifier == "":
        return
    if fact.surfaceCallKind == TypedExprSurfaceCallMember:
        return
    if fact.callCallee == "":
        return
    fact.callTarget = fact.callCallee

fn TypedExprMaterializeNamedTypeCallIfNeeded(fact: var TypedExprFact) =
    if fact.typeCallKind == TypedExprTypeCallNone:
        return
    if fact.typeCallKind == TypedExprTypeCallIdentity:
        return
    if fact.kind != parser.NormalizedExprDefaultInit &&
       fact.kind != parser.NormalizedExprConstructor:
        return
    if fact.abiClass != TypedExprAbiPolymorphic:
        return
    let typeName = TypedExprTypeLeafName(fact.typeText)
    if !TypedExprSymbolExportedByCase(typeName):
        return
    fact.abiClass = TypedExprAbiComposite
    fact.valueKind = TypedExprValueComposite
    fact.loweringMode = TypedExprLowerLocalAddress
    fact.returnKind = TypedExprReturnCompositeLocal

fn TypedExprFactsSourceExprChunkSize(): int32 =
    return 4096

@borrows
fn TypedExprBuildReusableFactsSourceContext(sourceTexts: var TypedExprSourceText[],
                                             sourceIndex: int32,
                                             contexts: var TypedExprSourceContext[],
                                             contextLookup: var parser.ParserSourcePathIndexLookup,
                                             functionIndexes: int32[],
                                             functionSourcePaths: str[],
                                             functionStartLines: int32[],
                                             functionEndLines: int32[],
                                             functionSelected: bool[],
                                             functionSelectionActive: bool,
                                             functionRangeStart: int32,
                                             functionRangeEnd: int32,
                                             ctxForFacts: var TypedExprSourceContext,
                                             err: var str): bool =
    if sourceIndex < 0 || sourceIndex >= sourceTexts.len:
        err = Fmt" typed expr: reusable facts source index out of range source_index={sourceIndex} source_count={sourceTexts.len}"
        return false
    let subTime = TypedExprSubTimeEnabled()
    var ctxT0: int64
    if subTime:
        typedExprSubTimeArmed = true
        TypedExprSubTimeReset()
    TypedExprEnsureSourceTextLoaded(sourceTexts[sourceIndex])
    if !sourceTexts[sourceIndex].textLoaded:
        err = Fmt" typed expr: reusable facts source text missing source={sourceTexts[sourceIndex].sourcePath}"
        return false
    var normalizedSourcePath: str
    if !TypedExprLexicalSourcePath(sourceTexts[sourceIndex].sourcePath,
                                   normalizedSourcePath,
                                   err):
        return false
    let metadataContextIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(contextLookup,
                                                                                            normalizedSourcePath)
    if metadataContextIndex < 0:
        err = Fmt" typed expr: reusable facts metadata context missing source={sourceTexts[sourceIndex].sourcePath}"
        return false
    if sourceTexts[sourceIndex].snapshotOnly:
        if !contexts[metadataContextIndex].snapshotOnly:
            err = Fmt" typed expr: snapshot-only reusable facts metadata contract missing source={sourceTexts[sourceIndex].sourcePath}"
            return false
        if contexts[metadataContextIndex].scopes.len <= 0:
            err = Fmt" typed expr: snapshot-only reusable facts scope table missing source={sourceTexts[sourceIndex].sourcePath}"
            return false
    var selectedScopeIndexes: int32[]
    var selectedLineStarts: int32[]
    var selectedLineCounts: int32[]
    if subTime:
        ctxT0 = TypedExprSubTimeNowNs()
    if !TypedExprBuildFactsSelectedRangesForFunctionRangeUnion(
            sourceTexts[sourceIndex].sourcePath,
            contexts[metadataContextIndex].scopes,
            functionIndexes,
            functionSourcePaths,
            functionStartLines,
            functionEndLines,
            functionSelected,
            functionSelectionActive,
            functionRangeStart,
            functionRangeEnd,
            selectedScopeIndexes,
            selectedLineStarts,
            selectedLineCounts,
            err):
        return false
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeCtxSelectedRanges, ctxT0)
        ctxT0 = TypedExprSubTimeNowNs()
    if !typedExprBuildFactsContextFromSelectedMetadata(
            sourceTexts[sourceIndex],
            contexts[metadataContextIndex],
            contexts,
            "",
            selectedScopeIndexes,
            selectedLineStarts,
            selectedLineCounts,
            ctxForFacts,
            err):
        if err != "":
            err = parser.ParserConcat2(
                " typed expr: reusable facts source context failed: ",
                parser.ParserOwnedText(err))
        else:
            err = " typed expr: reusable facts source context failed"
        return false
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeCtxFromMetadata, ctxT0)
    ctxForFacts.factsFunctionRangeUnionBuildCount =
        ctxForFacts.factsFunctionRangeUnionBuildCount + 1
    if ctxForFacts.lineNumbers.len != ctxForFacts.lines.len ||
       ctxForFacts.sourceIndexProducerFullTraversalCount != 1 ||
       ctxForFacts.factsSelectedScopeVisitCount !=
           Int64(selectedScopeIndexes.len) ||
       ctxForFacts.factsSelectedLineVisitCount != Int64(ctxForFacts.lines.len) ||
       ctxForFacts.factsSelectedLineBytes < Int64(0) ||
       ctxForFacts.factsGlobalBindingVisitCount < Int64(0) ||
       ctxForFacts.factsGlobalBindingVisitCount >
           ctxForFacts.factsSelectedBindingVisitCount:
        err = Fmt" typed expr: reusable facts sparse overlay accounting drift source={sourceTexts[sourceIndex].sourcePath} line_numbers={ctxForFacts.lineNumbers.len} lines={ctxForFacts.lines.len} selected_scopes={ctxForFacts.factsSelectedScopeVisitCount}/{selectedScopeIndexes.len} selected_lines={ctxForFacts.factsSelectedLineVisitCount}"
        return false
    if subTime:
        ctxT0 = TypedExprSubTimeNowNs()
    TypedExprPrepareSourceExprLineColumns(ctxForFacts)
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeCtxLineColumns, ctxT0)
    # Keep sealed identity fields. TypedIR frontier rebuilds owner roots
    # from these rows after Rec; AllFields here hollows workspaceRoot.
    TypedExprClearSourceTextBody(sourceTexts[sourceIndex])
    err = ""
    return true

    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SITE=facts_ctx_release")
fn TypedExprReleaseReusableFactsSourceContext(ctxForFacts: var TypedExprSourceContext) =
    TypedExprSubTimeFlush(ctxForFacts.sourcePath)
    TypedExprClearSourceContextAllFields(ctxForFacts)

fn TypedExprBuildFactsAppendSourceExprLayerWithContext(sourceTexts: var TypedExprSourceText[],
                                                       contexts: var TypedExprSourceContext[],
                                                       sourceIdentityIndex: var TypedExprSourceIdentityIndex,
                                                       contextLookup: var parser.ParserSourcePathIndexLookup,
                                                       sourceExprLayer: var parser.NormalizedExprLayer,
                                                       ctxForFacts: var TypedExprSourceContext,
                                                       facts: var TypedExprFactTable,
                                                       err: var str): bool =
    # This API is called once per function slice. Reset releases arenas above
    # the 16KiB scratch bound, then the current slice receives an exact 32-column
    # reservation. Small arenas may be reused; large-slice storage never stays
    # live across the next function.
    let subTime = TypedExprSubTimeEnabled()
    var sliceT0: int64
    var stepT0: int64
    var sliceScratch: TypedExprSliceResolutionScratch
    if subTime:
        sliceT0 = TypedExprSubTimeNowNs()
        typedExprSubTimeSlices = typedExprSubTimeSlices + 1
    if subTime:
        stepT0 = TypedExprSubTimeNowNs()
    TypedExprFactTableReset(facts)
    if sourceExprLayer.exprs.len <= 0:
        typedExprFactTableRequireExactPreparedBuild(facts)
        err = ""
        return true
    typedExprFactTablePrepareEmptyExprRange(facts,
                                            sourceExprLayer,
                                            0,
                                            sourceExprLayer.exprs.len)
    typedExprSliceResolutionScratchPrepare(sliceScratch, sourceExprLayer.exprs.len)
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeSlicePrepare, stepT0)
    if ctxForFacts.sourcePath == "" || ctxForFacts.exprLineColumnHeads.len != ctxForFacts.lines.len:
        err = Fmt" typed expr: reusable facts context is not initialized source={ctxForFacts.sourcePath} lines={ctxForFacts.lines.len} columns={ctxForFacts.exprLineColumnHeads.len}"
        return false
    if ctxForFacts.factsFunctionRangeUnionBuildCount != 1 ||
       ctxForFacts.factsFullSourceRescanCount != 0:
        err = Fmt" typed expr: reusable facts function union telemetry invalid source={ctxForFacts.sourcePath} union_builds={ctxForFacts.factsFunctionRangeUnionBuildCount} full_source_rescan_count={ctxForFacts.factsFullSourceRescanCount}"
        return false
    let sourcePath = sourceExprLayer.exprs[0].sourcePath
    if subTime:
        stepT0 = TypedExprSubTimeNowNs()
    var contextSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         ctxForFacts.sourcePath,
                                         contextSourceIndex,
                                         err) || contextSourceIndex < 0:
        err = Fmt" typed expr: reusable facts context identity missing source={ctxForFacts.sourcePath}: {err}"
        return false
    var exprSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         sourcePath,
                                         exprSourceIndex,
                                         err) || exprSourceIndex < 0:
        err = Fmt" typed expr: reusable facts expr identity missing source={sourcePath}: {err}"
        return false
    if contextSourceIndex != exprSourceIndex:
        err = Fmt" typed expr: reusable facts context source mismatch context={ctxForFacts.sourcePath} expr_source={sourcePath}"
        return false
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeSliceIdentity, stepT0)
    let sourceFactStart = facts.count
    if !TypedExprBuildFactsAppendPreparedSourceRangeFacts(sourceTexts,
                                                          contexts,
                                                          sourceIdentityIndex,
                                                          contextLookup,
                                                          sourceExprLayer,
                                                          0,
                                                          sourceExprLayer.exprs.len,
                                                          true,
                                                          false,
                                                          false,
                                                          ctxForFacts,
                                                          facts,
                                                          sliceScratch,
                                                          err):
        TypedExprClearSourceExprLineColumnsForRange(ctxForFacts,
                                                    sourceExprLayer,
                                                    0,
                                                    sourceExprLayer.exprs.len)
        TypedExprFactTableReset(facts)
        return false
    # The flat value/next columns are per-slice scratch. Clear only the heads
    # touched by this slice and retain the flat arrays' capacity, so storage is
    # bounded by the largest function rather than by all functions in a source.
    TypedExprClearSourceExprLineColumnsForRange(ctxForFacts,
                                                sourceExprLayer,
                                                0,
                                                sourceExprLayer.exprs.len)
    let sourceFactEnd = facts.count
    var validateErr = ""
    if subTime:
        stepT0 = TypedExprSubTimeNowNs()
    if !TypedExprFactsValidateCallResolutionRangeWithPreparedContext(
            sourceExprLayer,
            contexts,
            ctxForFacts,
            facts,
            0,
            sourceExprLayer.exprs.len,
            sourceFactStart,
            sourceFactEnd,
            sliceScratch,
            validateErr):
        err = validateErr
        TypedExprFactTableReset(facts)
        return false
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeSliceValidate, stepT0)
    typedExprSliceResolutionScratchClear(sliceScratch)
    if subTime:
        stepT0 = TypedExprSubTimeNowNs()
    TypedExprCompactStoredFactsRange(facts, sourceFactStart, sourceFactEnd)
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeSliceCompact, stepT0)
        TypedExprSubTimeNoteSlice(TypedExprSubTimeNowNs() - sliceT0,
                                  sourceExprLayer.exprs[0].lineNumber,
                                  sourceExprLayer.exprs.len)
    typedExprFactTableRequireExactPreparedBuild(facts)
    err = ""
    return true

fn TypedExprBuildFactsAppendSourceExprLayer(sourceTexts: var TypedExprSourceText[],
                                             sourceIndex: int32,
                                             contexts: var TypedExprSourceContext[],
                                             sourceExprLayer: var parser.NormalizedExprLayer,
                                             facts: var TypedExprFactTable,
                                             err: var str): bool =
    if facts.count != 0 || facts.compactGrowCount != 0 ||
       !TypedExprFactTableColumnsLockstep(facts) ||
       facts.exprIdIds.capacity != 0 || facts.arena.usedBytes != 0:
        panic("typed expr fact table: source-layer build requires an empty unprepared output")
    typedExprFactTablePrepareEmptyExprRange(facts,
                                            sourceExprLayer,
                                            0,
                                            sourceExprLayer.exprs.len)
    if sourceExprLayer.exprs.len <= 0:
        typedExprFactTableRequireExactPreparedBuild(facts)
        err = ""
        return true
    let sourceFactStart = facts.count
    if !TypedExprEnsureMetadataContextPresentForSourcePath(sourceTexts,
                                                           sourceExprLayer.exprs[0].sourcePath,
                                                           contexts,
                                                           err):
        return false
    var sourceIdentityIndex: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(sourceTexts, sourceIdentityIndex, err):
        return false
    var rangeSourceIndex: int32
    if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                         sourceExprLayer.exprs[0].sourcePath,
                                         rangeSourceIndex,
                                         err):
        return false
    if rangeSourceIndex < 0:
        rangeSourceIndex = TypedExprAppendSourceTextForPath(sourceTexts,
                                                            sourceExprLayer.exprs[0].sourcePath,
                                                            err)
        if rangeSourceIndex < 0:
            return false
        if !TypedExprBuildSourceIdentityIndex(sourceTexts, sourceIdentityIndex, err):
            return false
    var contextLookup: parser.ParserSourcePathIndexLookup
    if !TypedExprBuildSourceContextExactIndex(contexts, contextLookup, err):
        return false
    let chunkSize = TypedExprFactsSourceExprChunkSize()
    var exprStart: int32
    while exprStart < sourceExprLayer.exprs.len:
        os.ProcessResourceGuardCheck()
        var exprEnd = exprStart + chunkSize
        if exprEnd > sourceExprLayer.exprs.len:
            exprEnd = sourceExprLayer.exprs.len
        if !TypedExprBuildFactsAppendSourceRangeFacts(sourceTexts,
                                                      rangeSourceIndex,
                                                      contexts,
                                                      sourceIdentityIndex,
                                                      contextLookup,
                                                      sourceExprLayer,
                                                      exprStart,
                                                      exprEnd,
                                                      true,
                                                      facts,
                                                      err):
            return false
        exprStart = exprEnd
    let sourceFactEnd = facts.count
    var validateErr = ""
    if !TypedExprFactsValidateCallResolutionRange(sourceExprLayer,
                                                  contexts,
                                                  facts,
                                                  0,
                                                  sourceExprLayer.exprs.len,
                                                  sourceFactStart,
                                                  sourceFactEnd,
                                                  validateErr):
        err = validateErr
        return false
    TypedExprCompactStoredFactsRange(facts, sourceFactStart, sourceFactEnd)
    typedExprFactTableRequireExactPreparedBuild(facts)
    err = ""
    return true

@borrows
fn typedExprBuildFactsForExprLayerPreservingWithLookup(
        sourceTexts: var TypedExprSourceText[],
        exprLayer: var parser.NormalizedExprLayer,
        contexts: var TypedExprSourceContext[],
        contextLookup: var parser.ParserSourcePathIndexLookup,
        session: typedExprFrozenMetadataSession,
        metadataRowsVisited: var int64,
        facts: var TypedExprFactTable,
        err: var str): bool =
    TypedExprFactTableReset(facts)
    if exprLayer.exprs.len <= 0:
        typedExprFactTableRequireExactPreparedBuild(facts)
        err = ""
        return true
    typedExprFactTablePrepareEmptyExprRange(facts,
                                            exprLayer,
                                            0,
                                            exprLayer.exprs.len)
    if !TypedExprEnsureSourceTextsCoverExprLayer(sourceTexts, exprLayer, err):
        return false
    var sourceIdentityIndex: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(sourceTexts, sourceIdentityIndex, err):
        return false
    var exprStart: int32
    while exprStart < exprLayer.exprs.len:
        let sourcePath = exprLayer.exprs[exprStart].sourcePath
        var sourceIndex: int32
        if !TypedExprSourceIdentityIndexFind(sourceIdentityIndex,
                                             sourcePath,
                                             sourceIndex,
                                             err) || sourceIndex < 0:
            err = Fmt" typed expr: covered expr source missing source={sourcePath} expr_index={exprStart}: {err}"
            return false
        if session != nil:
            let metadataContextIndex = typedExprFrozenContextIndex(session, sourcePath)
            if metadataContextIndex < 0:
                panic(Fmt"typed expr: frozen facts metadata context missing source={sourcePath}")
            typedExprStageFrozenMetadataContextVisit(session,
                                                      metadataContextIndex,
                                                      metadataRowsVisited)
        var exprEnd = TypedExprExprLayerEndIndexForSource(exprLayer,
                                                          sourcePath,
                                                          exprStart)
        if exprEnd <= exprStart:
            exprEnd = exprStart + 1
        let factStart = facts.count
        if !TypedExprBuildFactsAppendSourceRangeFacts(sourceTexts,
                                                      sourceIndex,
                                                      contexts,
                                                      sourceIdentityIndex,
                                                      contextLookup,
                                                      exprLayer,
                                                      exprStart,
                                                      exprEnd,
                                                      true,
                                                      facts,
                                                      err):
            return false
        let factEnd = facts.count
        var validateErr = ""
        if !TypedExprFactsValidateCallResolutionRange(exprLayer,
                                                      contexts,
                                                      facts,
                                                      exprStart,
                                                      exprEnd,
                                                      factStart,
                                                      factEnd,
                                                      validateErr):
            err = validateErr
            return false
        TypedExprCompactStoredFactsRange(facts, factStart, factEnd)
        exprStart = exprEnd
    typedExprFactTableRequireExactPreparedBuild(facts)
    err = ""
    return true

fn TypedExprBuildFactsForExprLayerPreserving(sourceTexts: var TypedExprSourceText[],
                                             exprLayer: var parser.NormalizedExprLayer,
                                             contexts: var TypedExprSourceContext[],
                                             facts: var TypedExprFactTable,
                                             err: var str): bool =
    TypedExprFactTableReset(facts)
    var contextLookup: parser.ParserSourcePathIndexLookup
    if !TypedExprBuildSourceContextExactIndex(contexts, contextLookup, err):
        return false
    var metadataRowsVisited: int64
    return typedExprBuildFactsForExprLayerPreservingWithLookup(sourceTexts,
                                                               exprLayer,
                                                               contexts,
                                                               contextLookup,
                                                               nil,
                                                               metadataRowsVisited,
                                                               facts,
                                                               err)

fn typedExprSealedFactsBatchCloseRound(batch: var TypedExprSealedFactsBatch) =
    if batch == nil || !batch.active:
        return
    if batch.reusableSourceIndex >= 0:
        if batch.reusableContextOwnerCount != 1:
            panic("typed expr: sealed facts reusable context owner drift")
        TypedExprReleaseReusableFactsSourceContext(batch.reusableContext)
        batch.reusableSourceIndex = -1
        batch.reusableContextOwnerCount = 0
    elif batch.reusableContextOwnerCount != 0:
        panic("typed expr: sealed facts reusable context owner without source")
    if batch.queryWindowActive:
        typedExprEndFrozenReadOnlyQueries(batch.session,
                                          batch.queryLookupCount,
                                          batch.queryProbeCount,
                                          batch.queryMetadataScanCount)
        batch.queryWindowActive = false
    typedExprReleaseFrozenRoundViews(batch.session, batch.roundContexts)
    if !batch.telemetryCommitted:
        batch.session.sealedValidationCount =
            batch.sealedValidationCountBefore
        batch.session.metadataRowsVisitedAfterSeal =
            batch.metadataRowsVisitedBefore
        batch.session.roundViewLiveBytes = batch.roundViewLiveBytesBefore
        batch.session.roundPeakBytes = batch.roundPeakBytesBefore
        batch.session.roundContextCount = batch.roundContextCountBefore
        batch.session.roundDependencyCount = batch.roundDependencyCountBefore
        batch.session.lastRoundContextCount =
            batch.lastRoundContextCountBefore
        batch.session.lastRoundDependencyCount =
            batch.lastRoundDependencyCountBefore
    batch.active = false

fn TypedExprSealedFactsBatchBegin(
        sourceTexts: var TypedExprSourceText[],
        exprLayer: var parser.NormalizedExprLayer,
        functionIndexes: var int32[],
        functionSourcePaths: var str[],
        functionStartLines: var int32[],
        functionEndLines: var int32[],
        functionSelected: var bool[],
        functionSelectionActive: bool,
        ir: var TypedExprIr,
        batch: var TypedExprSealedFactsBatch,
        err: var str): bool =
    if batch != nil:
        panic("typed expr: sealed facts batch output is already active")
    let session = typedExprPrepareFrozenMetadataOperation(ir, "facts_batch")
    var nextBatch = new(TypedExprSealedFactsBatch)
    nextBatch.session = share(ir.typedExprMetadataSession)
    nextBatch.active = true
    nextBatch.reusableSourceIndex = -1
    nextBatch.sealedValidationCountBefore = session.sealedValidationCount
    nextBatch.metadataRowsVisitedBefore =
        session.metadataRowsVisitedAfterSeal
    nextBatch.roundViewLiveBytesBefore = session.roundViewLiveBytes
    nextBatch.roundPeakBytesBefore = session.roundPeakBytes
    nextBatch.roundContextCountBefore = session.roundContextCount
    nextBatch.roundDependencyCountBefore = session.roundDependencyCount
    nextBatch.lastRoundContextCountBefore = session.lastRoundContextCount
    nextBatch.lastRoundDependencyCountBefore =
        session.lastRoundDependencyCount
    var queryLookupCount: int32
    var queryProbeCount: int32
    var queryMetadataScanCount: int32
    typedExprBeginFrozenReadOnlyQueries(session,
                                        queryLookupCount,
                                        queryProbeCount,
                                        queryMetadataScanCount)
    nextBatch.queryLookupCount = queryLookupCount
    nextBatch.queryProbeCount = queryProbeCount
    nextBatch.queryMetadataScanCount = queryMetadataScanCount
    nextBatch.queryWindowActive = true
    nextBatch.stagedSourceTexts =
        typedExprCloneFrozenRoundSourceTexts(sourceTexts)
    var nextSourceIdentityIndex: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(nextBatch.stagedSourceTexts,
                                           nextSourceIdentityIndex,
                                           err):
        typedExprSealedFactsBatchCloseRound(nextBatch)
        nextBatch.session = nil
        return false
    nextBatch.sourceIdentityIndex = nextSourceIdentityIndex
    var dependencySourcePaths: str[]
    var dependencySourceLookup: parser.ParserSourcePathIndexLookup
    if functionSourcePaths.len != functionStartLines.len ||
       functionSourcePaths.len != functionEndLines.len ||
       functionSourcePaths.len != functionSelected.len:
        err = Fmt" typed expr: sealed facts batch function union columns mismatch sources={functionSourcePaths.len} starts={functionStartLines.len} ends={functionEndLines.len} selected={functionSelected.len}"
        typedExprSealedFactsBatchCloseRound(nextBatch)
        nextBatch.session = nil
        return false
    for functionRowIndex in 0..<functionIndexes.len:
        let functionIndex = functionIndexes[functionRowIndex]
        if functionIndex < 0 || functionIndex >= functionSourcePaths.len ||
           functionSourcePaths[functionIndex] == "" ||
           (functionSelectionActive && !functionSelected[functionIndex]):
            err = Fmt" typed expr: sealed facts batch function index invalid row={functionRowIndex} function_index={functionIndex} functions={functionSourcePaths.len}"
            typedExprSealedFactsBatchCloseRound(nextBatch)
            nextBatch.session = nil
            return false
        var sourceTextIndex: int32
        if !TypedExprSourceIdentityIndexFind(
                nextBatch.sourceIdentityIndex,
                functionSourcePaths[functionIndex],
                sourceTextIndex,
                err) || sourceTextIndex < 0:
            err = Fmt" typed expr: sealed facts batch function source missing row={functionRowIndex} function_index={functionIndex} source={functionSourcePaths[functionIndex]}: {err}"
            typedExprSealedFactsBatchCloseRound(nextBatch)
            nextBatch.session = nil
            return false
        typedExprFrozenAppendUniqueRoundPathIndexed(
            nextBatch.activeSourcePaths,
            nextBatch.activeSourceLookup,
            nextBatch.stagedSourceTexts[sourceTextIndex].sourcePath)
    for exprIndex in 0..<exprLayer.exprs.len:
        var sourceTextIndex: int32
        if !TypedExprSourceIdentityIndexFind(
                nextBatch.sourceIdentityIndex,
                exprLayer.exprs[exprIndex].sourcePath,
                sourceTextIndex,
                err) || sourceTextIndex < 0:
            err = Fmt" typed expr: sealed facts batch source missing expr_index={exprIndex} source={exprLayer.exprs[exprIndex].sourcePath}: {err}"
            typedExprSealedFactsBatchCloseRound(nextBatch)
            nextBatch.session = nil
            return false
        typedExprFrozenAppendUniqueRoundPathIndexed(
            nextBatch.activeSourcePaths,
            nextBatch.activeSourceLookup,
            nextBatch.stagedSourceTexts[sourceTextIndex].sourcePath)
        typedExprFrozenAppendUniqueRoundPathIndexed(
            dependencySourcePaths,
            dependencySourceLookup,
            exprLayer.exprs[exprIndex].callTargetSourcePath)
    var roundScopeRows: int32[]
    if !typedExprFrozenScopeRowsForFunctionIndexes(
            session,
            functionIndexes,
            functionSourcePaths,
            functionStartLines,
            functionEndLines,
            functionSelected,
            functionSelectionActive,
            roundScopeRows,
            err):
        typedExprSealedFactsBatchCloseRound(nextBatch)
        nextBatch.session = nil
        return false
    if !typedExprFrozenBuildRoundViews(session,
                                       nextBatch.activeSourcePaths,
                                       dependencySourcePaths,
                                       true,
                                       roundScopeRows,
                                       nextBatch.roundContexts,
                                       err):
        typedExprSealedFactsBatchCloseRound(nextBatch)
        nextBatch.session = nil
        return false
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8BRVBACK")
    if !TypedExprBuildSourceContextExactIndex(nextBatch.roundContexts,
                                               nextBatch.contextLookup,
                                               err):
        typedExprSealedFactsBatchCloseRound(nextBatch)
        nextBatch.session = nil
        return false
    for sourceIndex in 0..<nextBatch.activeSourcePaths.len:
        add(nextBatch.activeFunctionStarts, 0)
        add(nextBatch.activeFunctionCounts, 0)
    for functionRowIndex in 0..<functionIndexes.len:
        let functionIndex = functionIndexes[functionRowIndex]
        let activeSourceIndex =
            parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                nextBatch.activeSourceLookup,
                parser.ParserNormalizePath(functionSourcePaths[functionIndex]))
        if activeSourceIndex < 0:
            continue
        nextBatch.activeFunctionCounts[activeSourceIndex] =
            nextBatch.activeFunctionCounts[activeSourceIndex] + 1
    var activeFunctionRowCount: int32
    for sourceIndex in 0..<nextBatch.activeSourcePaths.len:
        nextBatch.activeFunctionStarts[sourceIndex] = activeFunctionRowCount
        activeFunctionRowCount = activeFunctionRowCount +
            nextBatch.activeFunctionCounts[sourceIndex]
    var activeFunctionWriteCounts: int32[]
    for rowIndex in 0..<activeFunctionRowCount:
        add(nextBatch.sourceScopedFunctionIndexes, -1)
    for sourceIndex in 0..<nextBatch.activeSourcePaths.len:
        add(activeFunctionWriteCounts, 0)
    for functionRowIndex in 0..<functionIndexes.len:
        let functionIndex = functionIndexes[functionRowIndex]
        let activeSourceIndex =
            parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
                nextBatch.activeSourceLookup,
                parser.ParserNormalizePath(functionSourcePaths[functionIndex]))
        if activeSourceIndex < 0:
            continue
        let writeIndex = nextBatch.activeFunctionStarts[activeSourceIndex] +
            activeFunctionWriteCounts[activeSourceIndex]
        nextBatch.sourceScopedFunctionIndexes[writeIndex] = functionIndex
        activeFunctionWriteCounts[activeSourceIndex] =
            activeFunctionWriteCounts[activeSourceIndex] + 1
    # Expected rows are derived in an independent pass from the frozen
    # projection before any consumer visit is staged.
    for sourceIndex in 0..<nextBatch.activeSourcePaths.len:
        let expectedMetadataContextIndex =
            typedExprFrozenContextIndex(session,
                                        nextBatch.activeSourcePaths[sourceIndex])
        if expectedMetadataContextIndex < 0 ||
           expectedMetadataContextIndex >=
               session.projection.contextMetadataRowCounts.len:
            err = Fmt" typed expr: sealed facts batch expected metadata context missing source={nextBatch.activeSourcePaths[sourceIndex]}"
            typedExprSealedFactsBatchCloseRound(nextBatch)
            nextBatch.session = nil
            return false
        nextBatch.metadataContextCountExpected =
            nextBatch.metadataContextCountExpected + 1
        # Header authorization touches zero canonical semantic rows.
    for sourceIndex in 0..<nextBatch.activeSourcePaths.len:
        let metadataContextIndex =
            typedExprFrozenContextIndex(session,
                                        nextBatch.activeSourcePaths[sourceIndex])
        if metadataContextIndex < 0:
            err = Fmt" typed expr: sealed facts batch metadata context missing source={nextBatch.activeSourcePaths[sourceIndex]}"
            typedExprSealedFactsBatchCloseRound(nextBatch)
            nextBatch.session = nil
            return false
        typedExprStageFrozenMetadataContextVisit(
            session,
            metadataContextIndex,
            nextBatch.metadataRowsVisited)
        nextBatch.metadataContextCountObserved =
            nextBatch.metadataContextCountObserved + 1
        if nextBatch.activeFunctionCounts[sourceIndex] <= 0:
            err = Fmt" typed expr: sealed facts batch function union missing source={nextBatch.activeSourcePaths[sourceIndex]}"
            typedExprSealedFactsBatchCloseRound(nextBatch)
            nextBatch.session = nil
            return false
    for functionIndex in 0..<functionSourcePaths.len:
        add(nextBatch.functionSourcePaths,
            share(functionSourcePaths[functionIndex]))
        add(nextBatch.functionStartLines, functionStartLines[functionIndex])
        add(nextBatch.functionEndLines, functionEndLines[functionIndex])
        add(nextBatch.functionSelected, functionSelected[functionIndex])
    nextBatch.functionSelectionActive = functionSelectionActive
    if !TypedExprMetadataVisitReceiptExact(
            nextBatch.metadataContextCountExpected,
            nextBatch.metadataContextCountObserved,
            nextBatch.metadataRowsExpected,
            nextBatch.metadataRowsVisited):
        err = Fmt" typed expr: sealed facts batch metadata conservation mismatch contexts_expected={nextBatch.metadataContextCountExpected} contexts_observed={nextBatch.metadataContextCountObserved} rows_expected={nextBatch.metadataRowsExpected} rows_observed={nextBatch.metadataRowsVisited}"
        typedExprSealedFactsBatchCloseRound(nextBatch)
        nextBatch.session = nil
        return false
    batch = nextBatch
    err = ""
    return true

@borrows
fn typedExprSealedFactsBatchEnsureReusableContext(
        batch: var TypedExprSealedFactsBatch,
        sourcePath: str,
        err: var str): bool =
    let activeSourceIndex =
        parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
            batch.activeSourceLookup,
            parser.ParserNormalizePath(sourcePath))
    if activeSourceIndex < 0 ||
       activeSourceIndex >= batch.activeSourcePaths.len ||
       activeSourceIndex >= batch.activeFunctionStarts.len ||
       activeSourceIndex >= batch.activeFunctionCounts.len:
        err = Fmt" typed expr: sealed facts batch reusable source missing source={sourcePath}"
        return false
    if batch.reusableSourceIndex == activeSourceIndex:
        if batch.reusableContextOwnerCount != 1:
            panic("typed expr: sealed facts reusable context owner lost")
        err = ""
        return true
    if batch.reusableSourceIndex > activeSourceIndex:
        err = Fmt" typed expr: sealed facts batch source order regressed source={sourcePath} source_index={activeSourceIndex} previous={batch.reusableSourceIndex}"
        return false
    if batch.reusableSourceIndex >= 0:
        if batch.reusableContextOwnerCount != 1:
            panic("typed expr: sealed facts reusable context owner overlap")
        TypedExprReleaseReusableFactsSourceContext(batch.reusableContext)
        batch.reusableSourceIndex = -1
        batch.reusableContextOwnerCount = 0
    var sourceTextIndex: int32
    if !TypedExprSourceIdentityIndexFind(batch.sourceIdentityIndex,
                                         sourcePath,
                                         sourceTextIndex,
                                         err) || sourceTextIndex < 0:
        err = Fmt" typed expr: sealed facts batch reusable source text missing source={sourcePath}: {err}"
        return false
    let functionRangeStart = batch.activeFunctionStarts[activeSourceIndex]
    let functionRangeEnd = functionRangeStart +
        batch.activeFunctionCounts[activeSourceIndex]
    if functionRangeStart < 0 || functionRangeEnd <= functionRangeStart ||
       functionRangeEnd > batch.sourceScopedFunctionIndexes.len:
        err = Fmt" typed expr: sealed facts batch reusable function union invalid source={sourcePath} start={functionRangeStart} end={functionRangeEnd} rows={batch.sourceScopedFunctionIndexes.len}"
        return false
    var nextReusableContext: TypedExprSourceContext
    if !TypedExprBuildReusableFactsSourceContext(
            batch.stagedSourceTexts,
            sourceTextIndex,
            batch.roundContexts,
            batch.contextLookup,
            batch.sourceScopedFunctionIndexes,
            batch.functionSourcePaths,
            batch.functionStartLines,
            batch.functionEndLines,
            batch.functionSelected,
            batch.functionSelectionActive,
            functionRangeStart,
            functionRangeEnd,
            nextReusableContext,
            err):
        return false
    batch.fullSourceRescanCount = batch.fullSourceRescanCount +
        nextReusableContext.factsFullSourceRescanCount
    batch.indexProducerFullTraversalCount =
        batch.indexProducerFullTraversalCount +
            nextReusableContext.sourceIndexProducerFullTraversalCount
    batch.selectedLineVisitCount = batch.selectedLineVisitCount +
        nextReusableContext.factsSelectedLineVisitCount
    batch.selectedLineBytes = typedExprCheckedAdd64(
        batch.selectedLineBytes,
        nextReusableContext.factsSelectedLineBytes,
        "sealed_batch_selected_line_bytes")
    batch.selectedScopeVisitCount = batch.selectedScopeVisitCount +
        nextReusableContext.factsSelectedScopeVisitCount
    batch.selectedBindingVisitCount = batch.selectedBindingVisitCount +
        nextReusableContext.factsSelectedBindingVisitCount
    batch.globalBindingVisitCount = batch.globalBindingVisitCount +
        nextReusableContext.factsGlobalBindingVisitCount
    if nextReusableContext.lines.len > batch.peakPackedLineCount:
        batch.peakPackedLineCount = nextReusableContext.lines.len
    if nextReusableContext.sourceLineCount > batch.sourceLineDomainPeak:
        batch.sourceLineDomainPeak = nextReusableContext.sourceLineCount
    if nextReusableContext.factsSelectedLineBytes >
       batch.peakPackedLineBytes:
        batch.peakPackedLineBytes =
            nextReusableContext.factsSelectedLineBytes
    TypedExprSourceContextMoveInto(batch.reusableContext,
                                   nextReusableContext)
    batch.reusableSourceIndex = activeSourceIndex
    batch.reusableContextOwnerCount = 1
    if batch.reusableContextOwnerPeak < batch.reusableContextOwnerCount:
        batch.reusableContextOwnerPeak = batch.reusableContextOwnerCount
    batch.functionRangeUnionBuildCount =
        batch.functionRangeUnionBuildCount + 1
    err = ""
    return true

fn TypedExprSealedFactsBatchBuildSlice(
        batch: var TypedExprSealedFactsBatch,
        sourcePath: str,
        sourceExprLayer: var parser.NormalizedExprLayer,
        facts: var TypedExprFactTable,
        err: var str): bool =
    if batch == nil || !batch.active || batch.session == nil:
        panic("typed expr: sealed facts batch slice outside active transaction")
    if !typedExprSealedFactsBatchEnsureReusableContext(batch,
                                                        sourcePath,
                                                        err):
        return false
    var sourceTextIndex: int32
    if !TypedExprSourceIdentityIndexFind(batch.sourceIdentityIndex,
                                         sourcePath,
                                         sourceTextIndex,
                                         err) || sourceTextIndex < 0:
        err = Fmt" typed expr: sealed facts batch slice source missing source={sourcePath}: {err}"
        return false
    for exprIndex in 0..<sourceExprLayer.exprs.len:
        var itemSourceTextIndex: int32
        if !TypedExprSourceIdentityIndexFind(
                batch.sourceIdentityIndex,
                sourceExprLayer.exprs[exprIndex].sourcePath,
                itemSourceTextIndex,
                err) || itemSourceTextIndex != sourceTextIndex:
            err = Fmt" typed expr: sealed facts batch slice crosses source boundary expr_index={exprIndex} source={sourceExprLayer.exprs[exprIndex].sourcePath}"
            return false
    if sourceExprLayer.exprs.len <= 0:
        TypedExprFactTableReset(facts)
        typedExprFactTableRequireExactPreparedBuild(facts)
        err = ""
        return true
    return TypedExprBuildFactsAppendSourceExprLayerWithContext(
        batch.stagedSourceTexts,
        batch.roundContexts,
        batch.sourceIdentityIndex,
        batch.contextLookup,
        sourceExprLayer,
        batch.reusableContext,
        facts,
        err)

@borrows
fn TypedExprSealedFactsBatchMetadataRowsVisited(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch metadata queried outside active transaction")
    return batch.metadataRowsVisited

@borrows
fn TypedExprSealedFactsBatchMetadataContextCountExpected(
        batch: TypedExprSealedFactsBatch): int32 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch metadata queried outside active transaction")
    return batch.metadataContextCountExpected

@borrows
fn TypedExprSealedFactsBatchMetadataContextCountObserved(
        batch: TypedExprSealedFactsBatch): int32 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch metadata queried outside active transaction")
    return batch.metadataContextCountObserved

@borrows
fn TypedExprSealedFactsBatchMetadataRowsExpected(
        batch: TypedExprSealedFactsBatch): int64 =
    if batch == nil || !batch.active:
        panic("typed expr: sealed facts batch metadata queried outside active transaction")
    return batch.metadataRowsExpected

@borrows
