        return true
    if typedExprSharedMetadataColumnInto(
           ctx.enumValueNames, 21, "enumValueNames",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.enumValueTypes, 22, "enumValueTypes",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.enumValueOrdinals, 23, "enumValueOrdinals",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.exprLineColumnHeads, 24, "exprLineColumnHeads",
