@borrows
fn TypedExprColdCsgTypeRowClone(row: TypedExprColdCsgTypeRow): TypedExprColdCsgTypeRow =
    var out: TypedExprColdCsgTypeRow
    out.sourcePath = share(row.sourcePath)
    out.rowKind = row.rowKind
    out.typeName = share(row.typeName)
    out.specs = share(row.specs)
    out.typeParams = share(row.typeParams)
    return out

@borrows
fn TypedExprColdCsgStatementRowClone(row: TypedExprColdCsgStatementRow): TypedExprColdCsgStatementRow =
    var out: TypedExprColdCsgStatementRow
    out.sourcePath = share(row.sourcePath)
    out.functionName = share(row.functionName)
    out.lineNumber = row.lineNumber
    out.lineIndent = row.lineIndent
    out.kind = row.kind
    out.payloadText = share(row.payloadText)
    return out

@borrows
fn TypedExprIrFunctions2ShapeComplete(ir: TypedExprIr): bool =
    let n = ir.functions2_sourcePathIds.len
    return ir.functions2_functionNameIds.len == n &&
           ir.functions2_signatureLineNumbers.len == n &&
           ir.functions2_endLineNumbers.len == n &&
           ir.functions2_bodyLineNumbers.len == n &&
           ir.functions2_returnTypeIds.len == n &&
           ir.functions2_resultExprClasses.len == n &&
           ir.functions2_borrowsArguments.len == n &&
           ir.functions2_manualConsumePresents.len == n &&
           ir.functions2_manualConsumeFunctionDeclarationRows.len == n &&
           ir.functions2_manualConsumeTargetParameterOrdinals.len == n &&
           ir.functions2_manualConsumeSourceParameterOrdinals.len == n &&
           ir.functions2_manualConsumeTargetParameterDeclarationRows.len == n &&
           ir.functions2_manualConsumeSourceParameterDeclarationRows.len == n &&
           ir.functions2_manualConsumeTargetTypeIds.len == n &&
           ir.functions2_manualConsumeSourceTypeIds.len == n &&
           ir.functions2_manualConsumeEffectCids.len == n &&
           ir.functions2_returnExprIds.len == n &&
           ir.functions2_statementStarts.len == n &&
           ir.functions2_statementCounts.len == n &&
           ir.functions2_scopeStarts.len == n &&
           ir.functions2_scopeCounts.len == n &&
           ir.functions2_nodeStarts.len == n &&
           ir.functions2_nodeCounts.len == n &&
           ir.functions2_returnNodeIndexs.len == n &&
           ir.functions2_valueDefinitionStarts.len == n &&
           ir.functions2_valueDefinitionCounts.len == n &&
           ir.functions2_valueDefinitionGroupStarts.len == n &&
           ir.functions2_valueDefinitionGroupCounts.len == n

@borrows
fn TypedExprIrScopes2ShapeComplete(ir: TypedExprIr): bool =
    let n = ir.scopes2_scopeIds.len
    return ir.scopes2_parentScopeIds.len == n &&
           ir.scopes2_kinds.len == n &&
           ir.scopes2_ownerStatementOrdinals.len == n &&
           ir.scopes2_lexicalOrdinals.len == n &&
           ir.scopes2_startLineNumbers.len == n &&
           ir.scopes2_startColumnNumbers.len == n &&
           ir.scopes2_endLineNumbers.len == n &&
           ir.scopes2_endColumnNumbers.len == n

fn TypedExprIrAppendScope(ir: var TypedExprIr,
                             scopeId: int32,
                             parentScopeId: int32,
                             kind: parser.NormalizedScopeKind,
                             ownerStatementOrdinal: int32,
                             lexicalOrdinal: int32,
                             startLineNumber: int32,
                             startColumnNumber: int32,
                             endLineNumber: int32,
                             endColumnNumber: int32) =
    if !TypedExprIrScopes2ShapeComplete(ir):
        panic("typed expr: scopes2 columns incomplete before append")
    if scopeId < 0:
        panic("typed expr: function-local scope id is negative")
    if parentScopeId >= scopeId:
        panic("typed expr: function-local scope parent is not prior")
    if !TypedExprNormalizedSpanValid(startLineNumber,
                                     startColumnNumber,
                                     endLineNumber,
                                     endColumnNumber):
        panic("typed expr: function-local scope span is invalid")
    if ir.arena.capacityBytes <= 0:
        ir.arena = arenamod.ArenaInitDefault(1048576)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_scopeIds, scopeId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_parentScopeIds, parentScopeId)
    add(ir.scopes2_kinds, kind)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_ownerStatementOrdinals, ownerStatementOrdinal)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_lexicalOrdinals, lexicalOrdinal)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_startLineNumbers, startLineNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_startColumnNumbers, startColumnNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_endLineNumbers, endLineNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.scopes2_endColumnNumbers, endColumnNumber)
    if !TypedExprIrScopes2ShapeComplete(ir):
        panic("typed expr: scopes2 columns incomplete after append")

fn TypedExprIrInternText(ir: var TypedExprIr, text: str): langintern.InternId =
    return langintern.Intern(share(ir.internPool), text)

fn TypedExprFactTableInternText(table: var TypedExprFactTable, text: str): langintern.InternId =
    return langintern.Intern(share(table.internPool), text)

@borrows
fn TypedExprFrozenMetadataProjectionInternText(internPool: langintern.InternPool, text: str): langintern.InternId =
    return langintern.Intern(internPool, text)

fn TypedExprIrAppendFunction(ir: var TypedExprIr, fnIr: TypedExprIrFunction) =
    if !TypedExprIrFunctions2ShapeComplete(ir):
        panic("typed expr: functions2 columns incomplete before append")
    if fnIr.scopeStart < 0 || fnIr.scopeCount <= 0 ||
       fnIr.scopeStart + fnIr.scopeCount > ir.scopes2_scopeIds.len:
        panic("typed expr: function scope range is invalid")
    if fnIr.resultExprClass != TypedExprExprOwned &&
       fnIr.resultExprClass != TypedExprExprBorrowed:
        panic("typed expr: function result expression class is invalid")
    let typedFunctionIndex = ir.functions2_functionNameIds.len
    if fnIr.valueDefinitionStart < 0 ||
       fnIr.valueDefinitionCount < 0 ||
       fnIr.valueDefinitionStart + fnIr.valueDefinitionCount !=
           TypedExprValueDefinitionAuthorityCount(ir):
        panic("typed expr value definition: function value range is invalid")
    for definitionOffset in 0..<fnIr.valueDefinitionCount:
        let definitionRow =
            fnIr.valueDefinitionStart + definitionOffset
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_typedFunctionIndexes,
               definitionRow) != typedFunctionIndex:
            panic("typed expr value definition: function value row escaped range")
    if fnIr.valueDefinitionGroupStart < 0 ||
       fnIr.valueDefinitionGroupCount < 0 ||
       fnIr.valueDefinitionGroupStart +
           fnIr.valueDefinitionGroupCount !=
           TypedExprValueDefinitionGroupAuthorityCount(ir):
        panic("typed expr value definition: function group range is invalid")
    for groupOffset in 0..<fnIr.valueDefinitionGroupCount:
        let groupRow = fnIr.valueDefinitionGroupStart + groupOffset
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_typedFunctionIndexes,
               groupRow) != typedFunctionIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_consumedFlags,
               groupRow) != 1 ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_definitionRows,
               groupRow) < 0:
            panic("typed expr value definition: function group was not consumed exactly once")
    let sourcePathId = TypedExprIrInternText(
        ir, strings.CloneStr(fnIr.sourcePath))
    add(ir.functions2_sourcePathIds, sourcePathId)
    let functionNameId = TypedExprIrInternText(
        ir, strings.CloneStr(fnIr.functionName))
    add(ir.functions2_functionNameIds, functionNameId)
    if ir.arena.capacityBytes <= 0:
        ir.arena = arenamod.ArenaInitDefault(1048576)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_signatureLineNumbers, fnIr.signatureLineNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_endLineNumbers, fnIr.endLineNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_bodyLineNumbers, fnIr.bodyLineNumber)
    let returnTypeId = TypedExprIrInternText(
        ir, strings.CloneStr(fnIr.returnType))
    add(ir.functions2_returnTypeIds, returnTypeId)
    add(ir.functions2_resultExprClasses, fnIr.resultExprClass)
    add(ir.functions2_borrowsArguments, fnIr.borrowsArguments)
    if fnIr.manualConsumePresent:
        if fnIr.manualConsumeFunctionDeclarationRow < 0 ||
           fnIr.manualConsumeTargetParameterOrdinal < 0 ||
           fnIr.manualConsumeSourceParameterOrdinal < 0 ||
           fnIr.manualConsumeTargetParameterOrdinal ==
               fnIr.manualConsumeSourceParameterOrdinal ||
           fnIr.manualConsumeTargetParameterDeclarationRow < 0 ||
           fnIr.manualConsumeSourceParameterDeclarationRow < 0 ||
           fnIr.manualConsumeTargetParameterDeclarationRow ==
               fnIr.manualConsumeSourceParameterDeclarationRow ||
           fnIr.manualConsumeTargetTypeId < 0 ||
           fnIr.manualConsumeSourceTypeId < 0 ||
           fnIr.manualConsumeTargetTypeId ==
               fnIr.manualConsumeSourceTypeId ||
           layout.FixedBytes32Equal(
               fnIr.manualConsumeEffectCid, layout.FixedBytes32()):
            panic("typed expr: function manual-consume effect invalid")
    elif !typedExprManualConsumeEffectAbsent(
             fnIr.manualConsumePresent,
             fnIr.manualConsumeFunctionDeclarationRow,
             fnIr.manualConsumeTargetParameterOrdinal,
             fnIr.manualConsumeSourceParameterOrdinal,
             fnIr.manualConsumeTargetParameterDeclarationRow,
             fnIr.manualConsumeSourceParameterDeclarationRow,
             fnIr.manualConsumeTargetTypeId,
             fnIr.manualConsumeSourceTypeId,
             fnIr.manualConsumeEffectCid):
        panic("typed expr: absent function manual-consume effect is non-empty")
    add(ir.functions2_manualConsumePresents,
        fnIr.manualConsumePresent)
    add(ir.functions2_manualConsumeFunctionDeclarationRows,
        fnIr.manualConsumeFunctionDeclarationRow)
    add(ir.functions2_manualConsumeTargetParameterOrdinals,
        fnIr.manualConsumeTargetParameterOrdinal)
    add(ir.functions2_manualConsumeSourceParameterOrdinals,
        fnIr.manualConsumeSourceParameterOrdinal)
    add(ir.functions2_manualConsumeTargetParameterDeclarationRows,
        fnIr.manualConsumeTargetParameterDeclarationRow)
    add(ir.functions2_manualConsumeSourceParameterDeclarationRows,
        fnIr.manualConsumeSourceParameterDeclarationRow)
    add(ir.functions2_manualConsumeTargetTypeIds,
        fnIr.manualConsumeTargetTypeId)
    add(ir.functions2_manualConsumeSourceTypeIds,
        fnIr.manualConsumeSourceTypeId)
    add(ir.functions2_manualConsumeEffectCids,
        layout.FixedBytes32Copy(fnIr.manualConsumeEffectCid))
    let returnExprId = TypedExprIrInternText(
        ir, strings.CloneStr(fnIr.returnExpr))
    add(ir.functions2_returnExprIds, returnExprId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_statementStarts, fnIr.statementStart)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_statementCounts, fnIr.statementCount)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_scopeStarts, fnIr.scopeStart)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_scopeCounts, fnIr.scopeCount)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_nodeStarts, fnIr.nodeStart)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_nodeCounts, fnIr.nodeCount)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.functions2_returnNodeIndexs, fnIr.returnNodeIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.functions2_valueDefinitionStarts,
        fnIr.valueDefinitionStart)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.functions2_valueDefinitionCounts,
        fnIr.valueDefinitionCount)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.functions2_valueDefinitionGroupStarts,
        fnIr.valueDefinitionGroupStart)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.functions2_valueDefinitionGroupCounts,
        fnIr.valueDefinitionGroupCount)
    if !TypedExprIrFunctions2ShapeComplete(ir):
        panic("typed expr: functions2 columns incomplete after append")

fn TypedExprExprClassText(value: TypedExprExprClass): str =
    if value == TypedExprExprOwned:
        return "Owned"
    if value == TypedExprExprBorrowed:
        return "Borrowed"
    if value == TypedExprExprUnmanaged:
        return "Unmanaged"
    return "Unknown"

@borrows
fn TypedExprIrExprClassForResultTypeExact(
        ir: var TypedExprIr,
        sourcePath: str,
        resultTypeRaw: str,
        managedClass: TypedExprExprClass): TypedExprExprClass =
    let resultType = TypedExprNormalizeTypeText(
        TypedExprStripVarType(strings.CloneStr(resultTypeRaw)))
    if resultType == "" || resultType == "unknown":
        return TypedExprExprUnknown
    if resultType == "void":
        return TypedExprExprUnmanaged
    var hasManaged: bool
    if !TypedExprIrTypeContainsManagedStorage(ir,
                                               strings.CloneStr(sourcePath),
                                               resultType,
                                               hasManaged):
        return TypedExprExprUnknown
    if !hasManaged:
        return TypedExprExprUnmanaged
    if managedClass != TypedExprExprOwned &&
       managedClass != TypedExprExprBorrowed:
        panic("typed expr: managed result class request is invalid")
    return managedClass

@borrows
fn typedExprNodeExprClassExact(ir: var TypedExprIr,
                               node: TypedExprIrNode): TypedExprExprClass =
    # A declaration row supplies the transfer premise only for managed
    # results. The exact result type decides whether ownership exists at all.
    if node.opKind == TypedExprIrOpCallExpr &&
       node.callDeclarationIndex >= 0:
        let declarationOwner = typedExprIrCallDeclarationOwnerIndex(ir)
        if declarationOwner == nil || declarationOwner.released ||
           node.callDeclarationIndex >=
               typedExprBuildIndexCallDeclarationCount(declarationOwner) ||
           node.callDeclarationIndex >=
               declarationOwner.callDeclarationResultExprClasses.len:
            panic("typed expr: CallExpr declaration ownership row unavailable")
        let declarationClass =
            declarationOwner.callDeclarationResultExprClasses[
                node.callDeclarationIndex]
        return TypedExprIrExprClassForResultTypeExact(
            ir,
            node.sourcePath,
            node.resultType,
            declarationClass)
    let resultType = TypedExprNormalizeTypeText(
        TypedExprStripVarType(strings.CloneStr(node.resultType)))
    if resultType == "" || resultType == "unknown":
        return TypedExprExprUnknown
    if resultType == "void":
        return TypedExprExprUnmanaged
    var hasManaged: bool
    if !TypedExprIrTypeContainsManagedStorage(ir,
                                               strings.CloneStr(node.sourcePath),
                                               resultType,
                                               hasManaged):
        return TypedExprExprUnknown
    if !hasManaged:
        return TypedExprExprUnmanaged
    if node.opKind == TypedExprIrOpArgLink:
        # Spine only. Ownership is the value operand's already-recorded class.
        if node.operand0NodeIndex < 0:
            return TypedExprExprUnknown
        return TypedExprIrNodeExprClassAt(ir, node.operand0NodeIndex)
    if node.opKind == TypedExprIrOpParamRef ||
       node.opKind == TypedExprIrOpLocalRef ||
       node.opKind == TypedExprIrOpFieldGet ||
       node.opKind == TypedExprIrOpIndexGet ||
       node.opKind == TypedExprIrOpAddrOf:
        return TypedExprExprBorrowed
    if node.opKind == TypedExprIrOpCallExpr:
        if node.exprClass == TypedExprExprOwned ||
           node.exprClass == TypedExprExprBorrowed:
            return node.exprClass
        if node.exprClass == TypedExprExprUnmanaged:
            panic("typed expr: managed call carries Unmanaged expression class")
        return TypedExprExprUnknown
    if node.opKind == TypedExprIrOpStrLit ||
       node.opKind == TypedExprIrOpReturnStrLiteral ||
       node.opKind == TypedExprIrOpCstringToStrCopy ||
       node.opKind == TypedExprIrOpEmptySeqInit ||
       node.opKind == TypedExprIrOpSeqLiteral ||
       node.opKind == TypedExprIrOpLocalBoolEnumTernary ||
       node.opKind == TypedExprIrOpNilPtr ||
       node.opKind == TypedExprIrOpFmt ||
       node.opKind == TypedExprIrOpStrAdd:
        # LocalBoolEnumTernary 属 Owned 族(托管结果的三元/行内-if 产出物,
        # 与 Fmt/StrAdd 同一语义; 到达此分支时 hasManaged 已证结果托管)。
        # [w24] NilPtr 同族: nil-able 上下文的新产空引用值(裸 `var n: Node`
        # 零值定义模板 / `= nil` 字面量)。此前托管 NilPtr 落 Unknown 必死
        # node value/share 审计, 从无可存活的托管 NilPtr 节点, 清单补齐零
        # 回归面; 非托管(ptr 族)在 !hasManaged 分支先行返回, 不经本清单。
        return TypedExprExprOwned
    if node.opKind == TypedExprIrOpClosure &&
       (node.exprClass == TypedExprExprOwned ||
        node.exprClass == TypedExprExprBorrowed):
        return node.exprClass
    return TypedExprExprUnknown

@borrows
fn TypedExprIrNodeExprClassAt(ir: TypedExprIr,
                              nodeIndex: int32): TypedExprExprClass =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len ||
       nodeIndex >= ir.nodes2_exprClasses.len:
        panic(Fmt"typed expr: expr class node out of range node={nodeIndex}")
    return ir.nodes2_exprClasses[nodeIndex]

@borrows
fn TypedExprIrNodeOpKindAt(ir: TypedExprIr,
                           nodeIndex: int32): TypedExprIrOpKind =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len ||
       nodeIndex >= ir.nodes2_opKinds.len:
        panic(Fmt"typed expr: op kind node out of range node={nodeIndex}")
    return ir.nodes2_opKinds[nodeIndex]

@borrows
fn TypedExprIrNodeOperand0At(ir: TypedExprIr,
                             nodeIndex: int32): int32 =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len ||
       nodeIndex >= ir.nodes2_operand0NodeIndexs.len:
        panic(Fmt"typed expr: operand0 node out of range node={nodeIndex}")
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.nodes2_operand0NodeIndexs, nodeIndex)

fn typedExprSnapshotValueKindForOp(
        opKind: TypedExprIrOpKind): TypedExprSnapshotValueKind =
    if opKind == TypedExprIrOpUnsupported:
        return TypedExprSnapshotValueUnknown
    if opKind == TypedExprIrOpFuncRef:
        return TypedExprSnapshotValueFunctionAddress
    if opKind == TypedExprIrOpClosure:
        return TypedExprSnapshotValueClosure
    return TypedExprSnapshotValueOrdinary

fn typedExprSnapshotShareKindForNode(
        exprClass: TypedExprExprClass,
        managed: bool,
        send: bool,
        sync: bool): TypedExprSnapshotShareKind =
    if !managed:
        return TypedExprSnapshotShareNone
    if exprClass == TypedExprExprBorrowed:
        return TypedExprSnapshotShareLocal
    if exprClass != TypedExprExprOwned:
        return TypedExprSnapshotShareUnknown
    if send && sync:
        return TypedExprSnapshotShareThreadSafe
    return TypedExprSnapshotShareLocal

fn typedExprSnapshotShareProofKind(
        shareKind: TypedExprSnapshotShareKind): TypedExprSnapshotValueProofKind =
    if shareKind == TypedExprSnapshotShareNone:
        return TypedExprSnapshotValueProofTypeTrait
    if shareKind == TypedExprSnapshotShareLocal:
        return TypedExprSnapshotValueProofFlow
    if shareKind == TypedExprSnapshotShareThreadSafe:
        return TypedExprSnapshotValueProofBoundary
    return TypedExprSnapshotValueProofUnknown

@borrows
fn TypedExprIrNodes2ShapeComplete(ir: TypedExprIr): bool =
    let n = ir.nodes2_nodeIndexs.len
    return ir.nodes2_sourcePathIds.len == n &&
           ir.nodes2_functionNameIds.len == n &&
           ir.nodes2_lineNumbers.len == n &&
           ir.nodes2_originParserNodeIds.len == n &&
           ir.nodes2_syntheticOriginKinds.len == n &&
           ir.nodes2_spanAuthorityKinds.len == n &&
           ir.nodes2_opKinds.len == n &&
           ir.nodes2_exprClasses.len == n &&
           ir.nodes2_resultTypeProofKinds.len == n &&
           ir.nodes2_resultTypeManagedFlags.len == n &&
           ir.nodes2_resultTypeSendFlags.len == n &&
           ir.nodes2_resultTypeSyncFlags.len == n &&
           ir.nodes2_valueKinds.len == n &&
           ir.nodes2_shareKinds.len == n &&
           ir.nodes2_shareProofKinds.len == n &&
           ir.nodes2_captureStarts.len == n &&
           ir.nodes2_captureCounts.len == n &&
           ir.nodes2_lastUseMoveValueDefIds.len == n &&
           ir.nodes2_structuralTypeIds.len == n &&
           ir.nodes2_resultTypeIds.len == n &&
           ir.nodes2_surfaceTextIds.len == n &&
           ir.nodes2_paramSlots.len == n &&
           ir.nodes2_paramNameIds.len == n &&
           ir.nodes2_paramMutableFlags.len == n &&
           ir.nodes2_operand0NodeIndexs.len == n &&
           ir.nodes2_operand1NodeIndexs.len == n &&
           ir.nodes2_operand2NodeIndexs.len == n &&
           ir.nodes2_literalTextIds.len == n &&
           ir.nodes2_callTargetIds.len == n &&
           ir.nodes2_callTargetSourcePathIds.len == n &&
           ir.nodes2_callTargetSignatureLineNumbers.len == n &&
           ir.nodes2_callTargetImportcs.len == n &&
           ir.nodes2_callKinds.len == n &&
           ir.nodes2_callDeclarationIndexes.len == n &&
           ir.nodes2_funcRefTargetDomains.len == n &&
           ir.nodes2_funcRefCallDeclarationRows.len == n &&
           ir.nodes2_fieldTypeSourcePathIds.len == n &&
           ir.nodes2_fieldOffsetBytes.len == n &&
           ir.nodes2_fieldSizeBytes.len == n &&
           ir.nodes2_fieldAlignBytes.len == n &&
           ir.nodes2_fieldProducerSourceIndexes.len == n &&
           ir.nodes2_fieldOwnerDeclarationSourceLocalRows.len == n &&
           ir.nodes2_fieldDeclarationSourceLocalRows.len == n &&
           ir.nodes2_fieldOrdinals.len == n &&
           ir.nodes2_fieldBuiltinKinds.len == n &&
           ir.nodes2_elemSizeBytes.len == n &&
           ir.nodes2_bindingParserNodeIndexes.len == n &&
           ir.nodes2_bindingParserForestNodeIndexes.len == n &&
           ir.nodes2_bindingParserProducerSourceIndexes.len == n &&
           ir.nodes2_bindingDeclarationSourceLocalRows.len == n &&
           ir.nodes2_bindingPatternSourceLocalRows.len == n &&
           ir.nodes2_bindingValueDefinitionRows.len == n &&
           ir.nodes2_producedValueDefinitionRows.len == n &&
           ir.nodes2_ownerStatementIndexes.len == n &&
           ir.nodes2_exactTypeArenaIds.len == n &&
           ir.nodes2_ownerProducerSourceIndexes.len == n &&
           ir.nodes2_ownerDeclarationSourceLocalRows.len == n &&
           ir.nodes2_ownershipPremiseKinds.len == n &&
           ir.nodes2_captureCompletionKinds.len == n

@borrows
fn TypedExprIdentifierBindingAuthorityStrictValidateInto(
        ir: TypedExprIr,
        err: var str): bool =
    err = ""
    if !TypedExprIrNodes2ShapeComplete(ir) ||
       !TypedExprValueDefinitionAuthorityShapeComplete(ir) ||
       !TypedExprValueDefinitionGroupAuthorityShapeComplete(ir):
        err = " typed expr binding: SoA shape mismatch"
        return false
    let definitionCount = TypedExprValueDefinitionAuthorityCount(ir)
    let groupCount = TypedExprValueDefinitionGroupAuthorityCount(ir)
    for definitionRow in 0..<definitionCount:
        let originKind = TypedExprValueDefinitionOriginKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_originKinds,
                definitionRow))
        let groupRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_groupRows,
            definitionRow)
        if (originKind ==
                TypedExprValueDefinitionOriginBindingInitializer &&
            (groupRow < 0 || groupRow >= groupCount ||
             arenamod.ArenaArrayInt32Get(
                 ir.arena,
                 ir.valueDefinitionGroups_definitionRows,
                 groupRow) != definitionRow)) ||
           (originKind !=
                TypedExprValueDefinitionOriginBindingInitializer &&
            groupRow != -1):
            err = " typed expr binding: value-definition reverse group edge invalid"
            return false
    for groupRow in 0..<groupCount:
        let definitionRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_definitionRows,
            groupRow)
        if definitionRow < 0 || definitionRow >= definitionCount ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_groupRows,
               definitionRow) != groupRow:
            err = " typed expr binding: value-definition group/reverse edge split"
            return false
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        let parserNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_bindingParserNodeIndexes,
            nodeIndex)
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_bindingParserProducerSourceIndexes,
            nodeIndex)
        let declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_bindingDeclarationSourceLocalRows,
            nodeIndex)
        let patternSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_bindingPatternSourceLocalRows,
            nodeIndex)
        let valueDefinitionRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_bindingValueDefinitionRows,
            nodeIndex)
        if (parserNodeIndex == -1) !=
           (arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_bindingParserForestNodeIndexes,
                nodeIndex) == -1):
            err = Fmt" typed expr binding: binding parser projection pair split node={nodeIndex}"
            return false
        let opKind = ir.nodes2_opKinds[nodeIndex]
        if opKind != TypedExprIrOpParamRef &&
           ir.nodes2_paramMutableFlags[nodeIndex]:
            err = Fmt" typed expr binding: non-parameter mutable authority node={nodeIndex}"
            return false
        let originParserNodeId = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_originParserNodeIds,
            nodeIndex)
        if parserNodeIndex == -1 &&
           producerSourceIndex == -1 &&
           declarationSourceLocalRow == -1 &&
           patternSourceLocalRow == -1 &&
           valueDefinitionRow == -1:
            if originParserNodeId >= 0 &&
               (opKind == TypedExprIrOpParamRef ||
                opKind == TypedExprIrOpLocalRef):
                err = Fmt" typed expr binding: source-backed reference identity missing node={nodeIndex}"
                return false
            continue
        if (opKind != TypedExprIrOpParamRef &&
            opKind != TypedExprIrOpLocalRef) ||
           parserNodeIndex < 0 ||
           producerSourceIndex < 0 ||
           declarationSourceLocalRow < 0 ||
           originParserNodeId < 0 ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_syntheticOriginKinds,
               nodeIndex) != TypedExprSyntheticOriginNone ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_spanAuthorityKinds,
               nodeIndex) != TypedExprSpanAuthorityParserNode:
            err = Fmt" typed expr binding: exact origin invalid node={nodeIndex}"
            return false
        if opKind == TypedExprIrOpParamRef:
            if patternSourceLocalRow != -1 ||
               valueDefinitionRow < 0 ||
               valueDefinitionRow >= definitionCount ||
               TypedExprValueDefinitionOriginKind(
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitions_originKinds,
                       valueDefinitionRow)) !=
                   TypedExprValueDefinitionOriginParameter ||
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_producerSourceIndexes,
                   valueDefinitionRow) != producerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_declarationSourceLocalRows,
                   valueDefinitionRow) != declarationSourceLocalRow:
                err = Fmt" typed expr binding: parameter value-definition edge invalid node={nodeIndex}"
                return false
            continue
        if opKind != TypedExprIrOpLocalRef ||
           patternSourceLocalRow < 0 ||
           valueDefinitionRow < 0 ||
           valueDefinitionRow >= definitionCount:
            err = Fmt" typed expr binding: local identity invalid node={nodeIndex}"
            return false
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_declarationSourceLocalRows,
               valueDefinitionRow) != declarationSourceLocalRow ||
           TypedExprValueDefinitionOriginKind(
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_originKinds,
                   valueDefinitionRow)) !=
               TypedExprValueDefinitionOriginBindingInitializer ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_patternSourceLocalRows,
               valueDefinitionRow) != patternSourceLocalRow:
            err = Fmt" typed expr binding: local value-definition coordinate drift node={nodeIndex}"
            return false
        let matchingGroupRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_groupRows,
            valueDefinitionRow)
        if matchingGroupRow < 0 ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_parserProducerSourceIndexes,
               matchingGroupRow) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_declarationSourceLocalRows,
               matchingGroupRow) != declarationSourceLocalRow ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_patternSourceLocalRows,
               matchingGroupRow) != patternSourceLocalRow ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_consumedFlags,
               matchingGroupRow) != 1:
            err = Fmt" typed expr binding: local parser/value-definition join drift node={nodeIndex}"
            return false
    return true

@borrows
fn TypedExprIdentifierBindingAuthorityStrictValidateParserTreeInto(
        ir: var TypedExprIr,
        tree: parser.ParserValueExprTree,
        nodeStart: int32,
        err: var str): bool =
    if !TypedExprIdentifierBindingAuthorityStrictValidateInto(ir, err):
        return false
    if tree == nil ||
       !parser.ParserValueExprTreeLexicalBindingAuthoritySealed(tree) ||
       nodeStart < 0 || nodeStart > ir.nodes2_nodeIndexs.len:
        err = " typed expr binding: sealed parser authority unavailable"
        return false
    for typedNodeIndex in nodeStart..<ir.nodes2_nodeIndexs.len:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_bindingParserProducerSourceIndexes,
            typedNodeIndex)
        if producerSourceIndex < 0:
            continue
        let parserNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_bindingParserForestNodeIndexes,
            typedNodeIndex)
        let originSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_originParserNodeIds,
            typedNodeIndex)
        var lexicalScopeRow: int32
        var resolutionKind =
            parser.ParserValueExprBindingResolutionNone
        var declarationRow: int32
        var patternRow: int32
        if parserNodeIndex < 0 ||
           parserNodeIndex >=
               parser.ParserValueExprTreeNodeCount(tree) ||
           parser.ParserValueExprNodeProducerSourceIndexAt(
               tree, parserNodeIndex) != producerSourceIndex ||
           parser.ParserValueExprNodeSourceLocalIndexAt(
               tree, parserNodeIndex) != originSourceLocalRow ||
           !parser.ParserValueExprNodeBindingResolutionAt(
               tree,
               parserNodeIndex,
               lexicalScopeRow,
               resolutionKind,
               declarationRow,
               patternRow) ||
           declarationRow < 0 ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationProducerSourceIndexes,
               declarationRow) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationSourceLocalRows,
               declarationRow) !=
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_bindingDeclarationSourceLocalRows,
                   typedNodeIndex):
            err = Fmt" typed expr binding: parser declaration drift node={typedNodeIndex}"
            return false
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_bindingParserNodeIndexes,
               typedNodeIndex) !=
               parser.ParserValueExprNodeSourceLocalIndexAt(
                   tree, parserNodeIndex):
            err = Fmt" typed expr binding: parser source-local projection drift node={typedNodeIndex}"
            return false
        let opKind = ir.nodes2_opKinds[typedNodeIndex]
        if resolutionKind ==
               parser.ParserValueExprBindingResolutionParameter:
            if opKind != TypedExprIrOpParamRef || patternRow != -1:
                err = Fmt" typed expr binding: parser parameter kind drift node={typedNodeIndex}"
                return false
        elif resolutionKind ==
                 parser.ParserValueExprBindingResolutionPattern:
            if opKind != TypedExprIrOpLocalRef || patternRow < 0 ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternProducerSourceIndexes,
                   patternRow) != producerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternSourceLocalRows,
                   patternRow) !=
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.nodes2_bindingPatternSourceLocalRows,
                       typedNodeIndex):
                err = Fmt" typed expr binding: parser Pattern drift node={typedNodeIndex}"
                return false
        else:
            err = Fmt" typed expr binding: resolved node lost parser kind node={typedNodeIndex}"
            return false
    err = ""
    return true

fn TypedExprNodeCaptureCompletionValid(
        valueKind: int32,
        captureCount: int32,
        completionKind: int32): bool =
    if valueKind <= Int32(TypedExprSnapshotValueUnknown) ||
       valueKind > Int32(TypedExprSnapshotValueClosure) ||
       captureCount < 0:
        return false
    if captureCount == 0:
        return completionKind == Int32(TypedExprNodeCaptureExactEmpty)
    return valueKind == Int32(TypedExprSnapshotValueClosure) &&
           completionKind == Int32(TypedExprNodeCaptureExactRows)

@borrows
fn TypedExprNodeAuthorityStrictValidateInto(
        ir: TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        err: var str): bool =
    err = ""
    var typeArenaErr: str
    if typeArena == nil ||
       !typearena.TypedExprTypeArenaStrictValidateInto(
           typeArena, typeArenaErr):
        err = typeArenaErr == "" ?
            " typed expr: node authority TypeArena missing" :
            typeArenaErr
        return false
    let typeCount = typearena.TypedExprTypeArenaTypeCount(typeArena)
    if !TypedExprIrNodes2ShapeComplete(ir) ||
       !TypedExprValueDefinitionAuthorityShapeComplete(ir):
        err = " typed expr: node authority SoA shape mismatch"
        return false
    let artifactEmpty = layout.FixedBytes32Equal(
        ir.nodeAuthorityTypeArenaArtifactCid, layout.FixedBytes32())
    if !ir.nodeAuthorityTypeArenaBound || artifactEmpty || typeCount <= 0 ||
       !layout.FixedBytes32Equal(
           ir.nodeAuthorityTypeArenaArtifactCid,
           typeArena.artifactRaw32):
        err = " typed expr: node authority TypeArena binding missing"
        return false
    if !ir.valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           ir.valueDefinitionTypeArenaArtifactCid,
           typeArena.artifactRaw32):
        err = " typed expr: value-definition TypeArena binding missing"
        return false
    let totalCaptureCount = ir.captures2_valueDefinitionRows.len
    if ir.captures2_ownerTypedNodeIndexes.len != totalCaptureCount ||
       ir.captures2_exactTypeIds.len != totalCaptureCount ||
       ir.captures2_ownerships.len != totalCaptureCount:
        err = " typed expr: node capture authority shape mismatch"
        return false
    var captureCursor: int32
    let definitionCount = TypedExprValueDefinitionAuthorityCount(ir)
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        let exactTypeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_exactTypeArenaIds, nodeIndex)
        let valueKind = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_valueKinds, nodeIndex)
        let ownerSource = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_ownerProducerSourceIndexes, nodeIndex)
        let ownerDeclaration = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerDeclarationSourceLocalRows,
            nodeIndex)
        let premise = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_ownershipPremiseKinds, nodeIndex)
        let captureStart = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_captureStarts, nodeIndex)
        let captureCount = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_captureCounts, nodeIndex)
        let captureCompletion = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_captureCompletionKinds, nodeIndex)
        let opKind = ir.nodes2_opKinds[nodeIndex]
        if opKind != TypedExprIrOpParamRef &&
           ir.nodes2_paramMutableFlags[nodeIndex]:
            err = Fmt" typed expr: non-parameter mutable authority node={nodeIndex}"
            return false
        let expectedValueKind =
            typedExprSnapshotValueKindForOp(opKind)
        let exprClass = ir.nodes2_exprClasses[nodeIndex]
        var expectedPremise =
            TypedExprNodeOwnershipPremiseInvalid
        if exprClass == TypedExprExprOwned:
            expectedPremise = TypedExprNodeOwnershipPremiseOwned
        elif exprClass == TypedExprExprBorrowed:
            expectedPremise = TypedExprNodeOwnershipPremiseBorrowed
        elif exprClass == TypedExprExprUnmanaged:
            expectedPremise = TypedExprNodeOwnershipPremiseUnmanaged
        let shareKind = TypedExprSnapshotShareKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_shareKinds, nodeIndex))
        let shareProofKind = TypedExprSnapshotValueProofKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_shareProofKinds, nodeIndex))
        if arenamod.ArenaArrayInt32Get(
               ir.arena, ir.nodes2_nodeIndexs, nodeIndex) != nodeIndex ||
           (exactTypeId < 0 && opKind != TypedExprIrOpNilPtr) ||
           exactTypeId >= typeCount ||
           valueKind <= Int32(TypedExprSnapshotValueUnknown) ||
           valueKind > Int32(TypedExprSnapshotValueClosure) ||
           valueKind != Int32(expectedValueKind) ||
           ownerSource < 0 || ownerDeclaration < 0 ||
           premise <= Int32(TypedExprNodeOwnershipPremiseInvalid) ||
           premise > Int32(TypedExprNodeOwnershipPremiseUnmanaged) ||
           premise != Int32(expectedPremise) ||
           captureStart != captureCursor || captureCount < 0 ||
           captureCount > totalCaptureCount - captureCursor ||
           !TypedExprNodeCaptureCompletionValid(
               valueKind, captureCount, captureCompletion):
            err = Fmt" typed expr: node authority row invalid node={nodeIndex}"
            return false
        # [np3-nilptr] 节点级 exactTypeArenaIds 域: -1 = NilPtr 证类无行合法
        # 态(plain nil 字面量铸造恒 -1, append 原值即 -1; w24/w34 零值模板
        # 载体已盖真实行不走本臂, 值定义域 >=0 硬门逐字保留零弱化)。三旗按
        # NilPtr 生产者拼写恒 false(NodeNew 零值 + bind 无行 no-op), 与
        # [np-nilptr] 提交环刀同口径; 非 NilPtr 的 <0 与一切 >=typeCount
        # 在上方守卫原样 hard-fail, 访问器内部界检对其他调用点原样。
        var valueSend = false
        var valueSync = false
        if exactTypeId >= 0:
            valueSend =
                typearena.TypedExprTypeArenaSendAt(
                    typeArena, exactTypeId)
            valueSync =
                typearena.TypedExprTypeArenaSyncAt(
                    typeArena, exactTypeId)
        if opKind == TypedExprIrOpClosure:
            valueSend = true
            valueSync = true
        for offset in 0..<captureCount:
            let captureRow = captureStart + offset
            let captureOwner = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.captures2_ownerTypedNodeIndexes,
                captureRow)
            let definitionRow = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.captures2_valueDefinitionRows,
                captureRow)
            let captureTypeId = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.captures2_exactTypeIds,
                captureRow)
            let captureOwnership = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.captures2_ownerships,
                captureRow)
            if captureOwner != nodeIndex ||
               definitionRow < 0 || definitionRow >= definitionCount:
                err = Fmt" typed expr: node capture authority invalid node={nodeIndex} capture={captureRow}"
                return false
            let definitionNode = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_definingTypedNodeIndexes,
                definitionRow)
            let definitionTypeId = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_exactTypeIds,
                definitionRow)
            let definitionOwnership = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_ownerships,
                definitionRow)
            let definitionOriginKind =
                TypedExprValueDefinitionOriginKind(
                    arenamod.ArenaArrayInt32Get(
                        ir.arena,
                        ir.valueDefinitions_originKinds,
                        definitionRow))
            let definitionFunctionIndex = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_typedFunctionIndexes,
                definitionRow)
            if definitionNode < 0 ||
               definitionNode >= ir.nodes2_nodeIndexs.len ||
               captureTypeId < 0 || captureTypeId >= typeCount ||
               captureTypeId != definitionTypeId ||
               definitionTypeId != TypedExprIrNodeStructuralTypeIdAt(
                   ir, definitionNode) ||
               captureOwnership <= Int32(TypedExprExprUnknown) ||
               captureOwnership > Int32(TypedExprExprUnmanaged) ||
               captureOwnership != definitionOwnership ||
               !typedExprIrValueDefinitionOwnershipMatchesNode(
                   ir,
                   definitionOriginKind,
                   definitionFunctionIndex,
                   definitionNode,
                   definitionOwnership) ||
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_producerSourceIndexes,
                   definitionRow) < 0 ||
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_declarationSourceLocalRows,
                   definitionRow) < 0:
                err = Fmt" typed expr: node capture authority invalid node={nodeIndex} capture={captureRow}"
                return false
            for priorOffset in 0..<offset:
                if arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.captures2_valueDefinitionRows,
                       captureStart + priorOffset) == definitionRow:
                    err = Fmt" typed expr: duplicate node capture definition node={nodeIndex} definition={definitionRow}"
                    return false
            if captureOwnership == Int32(TypedExprExprBorrowed):
                valueSend = false
                valueSync = false
            else:
                valueSend =
                    valueSend &&
                    typearena.TypedExprTypeArenaSendAt(
                        typeArena, captureTypeId)
                valueSync =
                    valueSync &&
                    typearena.TypedExprTypeArenaSyncAt(
                        typeArena, captureTypeId)
        var valueManaged = false
        if exactTypeId >= 0:
            valueManaged =
                typearena.TypedExprTypeArenaManagedAt(
                    typeArena, exactTypeId)
        if opKind == TypedExprIrOpClosure:
            valueManaged = true
        let expectedShareKind =
            typedExprSnapshotShareKindForNode(
                exprClass,
                valueManaged,
                valueSend,
                valueSync)
        if shareKind != expectedShareKind ||
           shareProofKind !=
               typedExprSnapshotShareProofKind(expectedShareKind):
            err = Fmt" typed expr: node share authority invalid node={nodeIndex}"
            return false
        captureCursor = captureCursor + captureCount
    if captureCursor != totalCaptureCount:
        err = " typed expr: node capture authority has unreachable rows"
        return false
    return true

@borrows
fn TypedExprIrCaptureAuthorityStrictValidateInto(
        ir: TypedExprIr,
        err: var str): bool =
    err = ""
    if !TypedExprIrNodes2ShapeComplete(ir) ||
       !TypedExprValueDefinitionAuthorityShapeComplete(ir):
        err = " typed expr capture: SoA shape mismatch"
        return false
    let captureCount = ir.captures2_ownerTypedNodeIndexes.len
    if ir.captures2_valueDefinitionRows.len != captureCount ||
       ir.captures2_exactTypeIds.len != captureCount ||
       ir.captures2_ownerships.len != captureCount:
        err = " typed expr capture: capture columns mismatch"
        return false
    var captureCursor: int32
    let definitionCount = TypedExprValueDefinitionAuthorityCount(ir)
    for nodePosition in 0..<ir.nodes2_nodeIndexs.len:
        let opKind = ir.nodes2_opKinds[nodePosition]
        let exprClass = ir.nodes2_exprClasses[nodePosition]
        let valueKind = TypedExprSnapshotValueKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_valueKinds, nodePosition))
        let shareKind = TypedExprSnapshotShareKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_shareKinds, nodePosition))
        let shareProofKind = TypedExprSnapshotValueProofKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_shareProofKinds, nodePosition))
        let nodeCaptureStart = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_captureStarts, nodePosition)
        let nodeCaptureCount = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_captureCounts, nodePosition)
        let expectedValueKind =
            typedExprSnapshotValueKindForOp(opKind)
        if valueKind != expectedValueKind ||
           valueKind == TypedExprSnapshotValueUnknown ||
           shareKind == TypedExprSnapshotShareUnknown ||
           shareProofKind == TypedExprSnapshotValueProofUnknown ||
           nodeCaptureStart != captureCursor ||
           nodeCaptureCount < 0 ||
           nodeCaptureCount > captureCount - captureCursor ||
           (opKind != TypedExprIrOpClosure && nodeCaptureCount != 0):
            err = Fmt" typed expr capture: node authority invalid node={nodePosition}"
            return false
        let ownerTypedNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_nodeIndexs, nodePosition)
        var valueSend = ir.nodes2_resultTypeSendFlags[nodePosition]
        var valueSync = ir.nodes2_resultTypeSyncFlags[nodePosition]
        if opKind == TypedExprIrOpClosure:
            valueSend = true
            valueSync = true
        for offset in 0..<nodeCaptureCount:
            let captureRow = captureCursor + offset
            let captureOwner = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.captures2_ownerTypedNodeIndexes,
                captureRow)
            let definitionRow = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.captures2_valueDefinitionRows,
                captureRow)
            let exactTypeId = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.captures2_exactTypeIds, captureRow)
            let ownership = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.captures2_ownerships, captureRow)
            if !ir.valueDefinitionTypeArenaBound ||
               captureOwner != ownerTypedNodeIndex ||
               definitionRow < 0 ||
               definitionRow >= definitionCount ||
               exactTypeId < 0 ||
               exactTypeId >=
                   typearena.TypedExprTypeArenaTypeCount(
                       ir.exactTypeArena) ||
               exactTypeId != arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_exactTypeIds,
                   definitionRow) ||
               ownership != arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_ownerships,
                   definitionRow):
                err = Fmt" typed expr capture: value-definition identity drift row={captureRow}"
                return false
            if opKind == TypedExprIrOpClosure:
                if ownership == Int32(TypedExprExprBorrowed):
                    valueSend = false
                    valueSync = false
                else:
                    valueSend =
                        valueSend &&
                        typearena.TypedExprTypeArenaSendAt(
                            ir.exactTypeArena, exactTypeId)
                    valueSync =
                        valueSync &&
                        typearena.TypedExprTypeArenaSyncAt(
                            ir.exactTypeArena, exactTypeId)
            for priorOffset in 0..<offset:
                if arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.captures2_valueDefinitionRows,
                       captureCursor + priorOffset) == definitionRow:
                    err = Fmt" typed expr capture: duplicate value-definition row={definitionRow}"
                    return false
        let expectedShareKind =
            typedExprSnapshotShareKindForNode(
                exprClass,
                ir.nodes2_resultTypeManagedFlags[nodePosition] ||
                    opKind == TypedExprIrOpClosure,
                valueSend,
                valueSync)
        if shareKind != expectedShareKind ||
           shareProofKind !=
               typedExprSnapshotShareProofKind(expectedShareKind):
            err = Fmt" typed expr capture: share authority drift node={nodePosition}"
            return false
        captureCursor = captureCursor + nodeCaptureCount
    if captureCursor != captureCount:
        err = " typed expr capture: coverage mismatch"
        return false
    return true

@borrows
fn TypedExprValueDefinitionAuthorityCount(ir: TypedExprIr): int32 =
    return ir.valueDefinitions_producerSourceIndexes.len

fn TypedExprIrOpIsExactManagedTemporaryProducer(
        opKind: TypedExprIrOpKind): bool =
    if opKind == TypedExprIrOpStrLit:
        return true
    if opKind == TypedExprIrOpReturnStrLiteral:
        return true
    if opKind == TypedExprIrOpCstringToStrCopy:
        return true
    if opKind == TypedExprIrOpFmt:
        return true
    if opKind == TypedExprIrOpStrAdd:
        return true
    if opKind == TypedExprIrOpSeqLiteral:
        return true
    if opKind == TypedExprIrOpEmptySeqInit:
        return true
    if opKind == TypedExprIrOpClosure:
        return true
    return false

@borrows
fn TypedExprValueDefinitionAuthorityShapeComplete(
        ir: TypedExprIr): bool =
    let count = TypedExprValueDefinitionAuthorityCount(ir)
    return ir.valueDefinitions_originKinds.len == count &&
           ir.valueDefinitions_sourceLocalNodeIndexes.len == count &&
           ir.valueDefinitions_declarationSourceLocalRows.len == count &&
           ir.valueDefinitions_patternSourceLocalRows.len == count &&
           ir.valueDefinitions_typedFunctionIndexes.len == count &&
           ir.valueDefinitions_definingTypedNodeIndexes.len == count &&
           ir.valueDefinitions_exactTypeIds.len == count &&
           ir.valueDefinitions_ownerships.len == count &&
           ir.valueDefinitions_borrowOwnerValueDefinitionRows.len == count &&
           ir.valueDefinitions_proofKinds.len == count &&
           ir.valueDefinitions_groupRows.len == count

@borrows
fn TypedExprValueDefinitionGroupAuthorityCount(
        ir: TypedExprIr): int32 =
    return ir.valueDefinitionGroups_producerSourceIndexes.len

@borrows
fn TypedExprValueDefinitionGroupAuthorityShapeComplete(
        ir: TypedExprIr): bool =
    let count = TypedExprValueDefinitionGroupAuthorityCount(ir)
    return ir.valueDefinitionGroups_parserProducerSourceIndexes.len ==
               count &&
           ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes.len ==
               count &&
           ir.valueDefinitionGroups_bindingOffsets.len == count &&
           ir.valueDefinitionGroups_bindingCounts.len == count &&
           ir.valueDefinitionGroups_typedFunctionIndexes.len == count &&
           ir.valueDefinitionGroups_declarationSourceLocalRows.len == count &&
           ir.valueDefinitionGroups_patternSourceLocalRows.len == count &&
           ir.valueDefinitionGroups_definitionRows.len == count &&
           ir.valueDefinitionGroups_consumedFlags.len == count

fn typedExprValueDefinitionCoordinateBucket(
        producerSourceIndex: int32,
        sourceLocalRow: int32,
        bucketCount: int32): int32 =
    if producerSourceIndex < 0 || sourceLocalRow < 0 ||
       bucketCount <= 0:
        return -1
    let hash = (Int64(producerSourceIndex) * 1000003 +
                Int64(sourceLocalRow) * 9176 + 97) %
               Int64(bucketCount)
    return Int32(hash)

@borrows
fn typedExprIrNodeOwnerRootValidateInto(
        ir: TypedExprIr,
        statementIndex: int32,
        rootNodeIndex: int32,
        rootObserved: var bool[],
        err: var str): bool =
    if rootNodeIndex == -1:
        return true
    if rootNodeIndex < 0 ||
       rootNodeIndex >= ir.nodes2_nodeIndexs.len ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.nodes2_ownerStatementIndexes,
           rootNodeIndex) != statementIndex:
        err = Fmt" typed expr: statement root owner drift statement={statementIndex} root={rootNodeIndex}"
        return false
    rootObserved[rootNodeIndex] = true
    return true

@borrows
fn TypedExprIrNodeOwnerStatementAuthorityStrictValidateInto(
        ir: TypedExprIr,
        err: var str): bool =
    if !TypedExprIrNodes2ShapeComplete(ir) ||
       !TypedExprIrStatements2ShapeComplete(ir):
        err = " typed expr: node owner statement SoA shape mismatch"
        return false
    let nodeCount = ir.nodes2_nodeIndexs.len
    let statementCount = ir.statements2_statementIndexs.len
    var rootObserved: bool[]
    var hasParentWithinOwner: bool[]
    setLen(rootObserved, nodeCount)
    setLen(hasParentWithinOwner, nodeCount)
    for statementIndex in 0..<statementCount:
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.statements2_statementIndexs,
               statementIndex) != statementIndex ||
           !typedExprIrNodeOwnerRootValidateInto(
               ir,
               statementIndex,
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.statements2_rhsNodeIndexs,
                   statementIndex),
               rootObserved,
               err) ||
           !typedExprIrNodeOwnerRootValidateInto(
               ir,
               statementIndex,
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.statements2_callArgNodeStarts,
                   statementIndex),
               rootObserved,
               err) ||
           !typedExprIrNodeOwnerRootValidateInto(
               ir,
               statementIndex,
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.statements2_forStartNodeIndexs,
                   statementIndex),
               rootObserved,
               err) ||
           !typedExprIrNodeOwnerRootValidateInto(
               ir,
               statementIndex,
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.statements2_assignLvalueNodeIndexs,
                   statementIndex),
               rootObserved,
               err) ||
           !typedExprIrNodeOwnerRootValidateInto(
               ir,
               statementIndex,
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.statements2_assignIndexNodeIndexs,
                   statementIndex),
               rootObserved,
               err):
            if err == "":
                err = " typed expr: statement row identity drift"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
    for nodeIndex in 0..<nodeCount:
        let ownerStatementIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerStatementIndexes,
            nodeIndex)
        if ownerStatementIndex < -1 ||
           ownerStatementIndex >= statementCount:
            err = Fmt" typed expr: node owner statement out of range node={nodeIndex} owner={ownerStatementIndex}"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
        if ownerStatementIndex >= 0 &&
           (ir.nodes2_sourcePathIds[nodeIndex] !=
                ir.statements2_sourcePathIds[ownerStatementIndex] ||
            ir.nodes2_functionNameIds[nodeIndex] !=
                ir.statements2_functionNameIds[ownerStatementIndex]):
            err = Fmt" typed expr: node owner statement identity drift node={nodeIndex} owner={ownerStatementIndex}"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
        let operand0 = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand0NodeIndexs, nodeIndex)
        let operand1 = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand1NodeIndexs, nodeIndex)
        let operand2 = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand2NodeIndexs, nodeIndex)
        if operand0 < -1 || operand0 >= nodeIndex ||
           operand1 < -1 || operand1 >= nodeIndex ||
           operand2 < -1 || operand2 >= nodeIndex ||
           (operand0 >= 0 &&
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_ownerStatementIndexes,
                operand0) != ownerStatementIndex) ||
           (operand1 >= 0 &&
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_ownerStatementIndexes,
                operand1) != ownerStatementIndex) ||
           (operand2 >= 0 &&
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_ownerStatementIndexes,
                operand2) != ownerStatementIndex):
            err = Fmt" typed expr: node operand crosses statement owner node={nodeIndex} owner={ownerStatementIndex}"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
        if operand0 >= 0:
            hasParentWithinOwner[operand0] = true
        if operand1 >= 0:
            hasParentWithinOwner[operand1] = true
        if operand2 >= 0:
            hasParentWithinOwner[operand2] = true
    for nodeIndex in 0..<nodeCount:
        let ownerStatementIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerStatementIndexes,
            nodeIndex)
        if ownerStatementIndex >= 0 &&
           !rootObserved[nodeIndex] &&
           !hasParentWithinOwner[nodeIndex]:
            err = Fmt" typed expr: owned node is disconnected from statement roots node={nodeIndex} owner={ownerStatementIndex}"
            seqs.FreeSeq(rootObserved)
            seqs.FreeSeq(hasParentWithinOwner)
            return false
    seqs.FreeSeq(rootObserved)
    seqs.FreeSeq(hasParentWithinOwner)
    err = ""
    return true

@borrows
fn TypedExprValueDefinitionAuthorityStrictValidateInto(
        ir: TypedExprIr,
        err: var str): bool =
    err = ""
    if !TypedExprValueDefinitionAuthorityShapeComplete(ir) ||
       !TypedExprIrNodes2ShapeComplete(ir) ||
       !TypedExprIrCaptureAuthorityStrictValidateInto(ir, err) ||
       !TypedExprIrFunctions2ShapeComplete(ir) ||
       !TypedExprIrNodeOwnerStatementAuthorityStrictValidateInto(
           ir, err) ||
       !TypedExprIdentifierBindingAuthorityStrictValidateInto(ir, err):
        if err == "":
            err = " typed expr value definition: SoA shape mismatch"
        return false
    let emptyTypeArenaArtifact = layout.FixedBytes32Equal(
        ir.valueDefinitionTypeArenaArtifactCid,
        layout.FixedBytes32())
    if (ir.valueDefinitionTypeArenaBound && emptyTypeArenaArtifact) ||
       (!ir.valueDefinitionTypeArenaBound && !emptyTypeArenaArtifact):
        err = " typed expr value definition: TypeArena binding state split"
        return false
    let count = TypedExprValueDefinitionAuthorityCount(ir)
    var definitionCursor: int32
    for functionIndex in 0..<ir.functions2_functionNameIds.len:
        let functionDefinitionStart = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_valueDefinitionStarts,
            functionIndex)
        let functionDefinitionCount = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_valueDefinitionCounts,
            functionIndex)
        if functionDefinitionStart != definitionCursor ||
           functionDefinitionCount < 0 ||
           functionDefinitionStart >
               count - functionDefinitionCount:
            err = Fmt" typed expr value definition: function value CSR drift function={functionIndex}"
            return false
        for offset in 0..<functionDefinitionCount:
            if arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_typedFunctionIndexes,
                   functionDefinitionStart + offset) != functionIndex:
                err = Fmt" typed expr value definition: cross-function value row function={functionIndex}"
                return false
        definitionCursor =
            definitionCursor + functionDefinitionCount
    if definitionCursor != count:
        err = " typed expr value definition: function value coverage incomplete"
        return false
    let bucketCount = TypedExprBuildIndexBucketCount(count)
    var declarationBucketHeads: int32[]
    var declarationNext: int32[]
    var patternBucketHeads: int32[]
    var patternNext: int32[]
    setLen(declarationBucketHeads, bucketCount)
    setLen(patternBucketHeads, bucketCount)
    setLen(declarationNext, count)
    setLen(patternNext, count)
    for bucket in 0..<bucketCount:
        declarationBucketHeads[bucket] = -1
        patternBucketHeads[bucket] = -1
    for row in 0..<count:
        declarationNext[row] = -1
        patternNext[row] = -1
    for row in 0..<count:
        let originKind = TypedExprValueDefinitionOriginKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_originKinds,
                row))
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_producerSourceIndexes,
            row)
        let sourceLocalNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_sourceLocalNodeIndexes,
            row)
        let declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_declarationSourceLocalRows,
            row)
        let patternSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_patternSourceLocalRows,
            row)
        let typedFunctionIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_typedFunctionIndexes,
            row)
        let definingTypedNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_definingTypedNodeIndexes,
            row)
        let exactTypeId = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_exactTypeIds,
            row)
        let ownership = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_ownerships,
            row)
        let borrowOwnerValueDefinitionRow =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_borrowOwnerValueDefinitionRows,
                row)
        let proofKind = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_proofKinds,
            row)
        let parameterOrigin =
            originKind == TypedExprValueDefinitionOriginParameter
        let bindingOrigin =
            originKind ==
                TypedExprValueDefinitionOriginBindingInitializer
        let callResultOrigin =
            originKind == TypedExprValueDefinitionOriginCallResult
        let managedTemporaryOrigin =
            originKind ==
                TypedExprValueDefinitionOriginManagedTemporary
        if producerSourceIndex < 0 ||
           (!parameterOrigin && !bindingOrigin && !callResultOrigin &&
            !managedTemporaryOrigin) ||
           (parameterOrigin &&
            (sourceLocalNodeIndex != -1 ||
             declarationSourceLocalRow < 0 ||
             patternSourceLocalRow != -1)) ||
           (bindingOrigin &&
            (sourceLocalNodeIndex < 0 ||
             declarationSourceLocalRow < 0 ||
             patternSourceLocalRow < 0)) ||
           (callResultOrigin &&
            (sourceLocalNodeIndex < 0 ||
             declarationSourceLocalRow != -1 ||
             patternSourceLocalRow != -1)) ||
           (managedTemporaryOrigin &&
            (sourceLocalNodeIndex < 0 ||
             declarationSourceLocalRow != -1 ||
             patternSourceLocalRow != -1)) ||
           typedFunctionIndex < 0 ||
           typedFunctionIndex >= ir.functions2_functionNameIds.len ||
           definingTypedNodeIndex < 0 ||
           definingTypedNodeIndex >= ir.nodes2_nodeIndexs.len ||
           (ir.valueDefinitionTypeArenaBound && exactTypeId < 0) ||
           (!ir.valueDefinitionTypeArenaBound && exactTypeId != -1) ||
           ownership <= Int32(TypedExprExprUnknown) ||
           ownership > Int32(TypedExprExprUnmanaged) ||
           proofKind < TypedExprSnapshotTypeProofNone ||
           proofKind > TypedExprSnapshotTypeProofAggregate:
            err = Fmt" typed expr value definition: row domain invalid row={row}"
            return false
        let managed =
            ir.nodes2_resultTypeManagedFlags[definingTypedNodeIndex]
        let borrowedManaged =
            managed &&
            ownership == Int32(TypedExprExprBorrowed)
        if borrowedManaged:
            if borrowOwnerValueDefinitionRow < 0 ||
               borrowOwnerValueDefinitionRow > row:
                err = Fmt" typed expr value definition: borrow owner row invalid row={row} owner={borrowOwnerValueDefinitionRow}"
                return false
            let ownerOwnership = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_ownerships,
                borrowOwnerValueDefinitionRow)
            let ownerFunctionIndex = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_typedFunctionIndexes,
                borrowOwnerValueDefinitionRow)
            let ownerOriginKind = TypedExprValueDefinitionOriginKind(
                arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.valueDefinitions_originKinds,
                    borrowOwnerValueDefinitionRow))
            if ownerFunctionIndex != typedFunctionIndex ||
               (borrowOwnerValueDefinitionRow == row &&
                !parameterOrigin) ||
               (borrowOwnerValueDefinitionRow != row &&
                ownerOwnership != Int32(TypedExprExprOwned) &&
                !(ownerOwnership == Int32(TypedExprExprBorrowed) &&
                  ownerOriginKind ==
                      TypedExprValueDefinitionOriginParameter &&
                  arenamod.ArenaArrayInt32Get(
                      ir.arena,
                      ir.valueDefinitions_borrowOwnerValueDefinitionRows,
                      borrowOwnerValueDefinitionRow) ==
                          borrowOwnerValueDefinitionRow)):
                err = Fmt" typed expr value definition: borrow owner authority drift row={row} owner={borrowOwnerValueDefinitionRow}"
                return false
        elif borrowOwnerValueDefinitionRow != -1:
            err = Fmt" typed expr value definition: non-borrow row carries owner row={row} owner={borrowOwnerValueDefinitionRow}"
            return false
        if managedTemporaryOrigin &&
           (!TypedExprIrOpIsExactManagedTemporaryProducer(
                ir.nodes2_opKinds[definingTypedNodeIndex]) ||
            ir.nodes2_exprClasses[definingTypedNodeIndex] !=
                TypedExprExprOwned ||
            !ir.nodes2_resultTypeManagedFlags[
                definingTypedNodeIndex] ||
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_originParserNodeIds,
                definingTypedNodeIndex) != sourceLocalNodeIndex ||
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_syntheticOriginKinds,
                definingTypedNodeIndex) !=
                TypedExprSyntheticOriginNone):
            err = Fmt" typed expr value definition: managed temporary authority drift row={row}"
            return false
        if ir.nodes2_resultTypeManagedFlags[definingTypedNodeIndex] &&
           proofKind == TypedExprSnapshotTypeProofNone:
            err = Fmt" typed expr value definition: managed ownership proof missing row={row}"
            return false
        let ownerStatementIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerStatementIndexes,
            definingTypedNodeIndex)
        let functionNodeStart = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_nodeStarts,
            typedFunctionIndex)
        let functionNodeCount = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_nodeCounts,
            typedFunctionIndex)
        let functionStatementStart = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_statementStarts,
            typedFunctionIndex)
        let functionStatementCount = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_statementCounts,
            typedFunctionIndex)
        # [w34] decl-local 零值定义模板（w24 detached NilPtr 载体，裸
        # `var n: Node` 家族的声明性定义）是离语句载体：定义于声明语句
        # 本身而非任何表达式求值，函数体内不存在也不应有可达 defining
        # 节点——与参数行同族（parameterOrigin 豁免臂的声明性对应物）。
        # 放行臂由载体拼写全列联立自证：BindingInitializer origin +
        # owner=-1 + NilPtr + parser origin=-1 + Desugared + NoSource；
        # 任一列不符仍走语句区间臂，parser-backed 的 builder 弃子
        # （owner=-1 的真孤儿节点）不放行。下游联证：
        # typedExprIrExactLocalValueDefinitionRow 只按组坐标取行、消费
        # 类型/证明列；owner 列读点仅在节点图审计，owner=-1 本就跳过
        # disconnected 遍历，无消费方依赖本臂之外的 owner 语义。
        let detachedZeroDeclarationTemplate =
            bindingOrigin &&
            ownerStatementIndex == -1 &&
            ir.nodes2_opKinds[definingTypedNodeIndex] ==
                TypedExprIrOpNilPtr &&
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_originParserNodeIds,
                definingTypedNodeIndex) == -1 &&
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_syntheticOriginKinds,
                definingTypedNodeIndex) ==
                TypedExprSyntheticOriginDesugared &&
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_spanAuthorityKinds,
                definingTypedNodeIndex) ==
                TypedExprSpanAuthorityNoSource
        if definingTypedNodeIndex < functionNodeStart ||
           definingTypedNodeIndex >= functionNodeStart + functionNodeCount ||
           (parameterOrigin && ownerStatementIndex != -1) ||
           (!parameterOrigin &&
            !detachedZeroDeclarationTemplate &&
            (ownerStatementIndex < functionStatementStart ||
             ownerStatementIndex >=
                 functionStatementStart + functionStatementCount)) ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_producedValueDefinitionRows,
               definingTypedNodeIndex) != row ||
           exactTypeId !=
               TypedExprIrNodeStructuralTypeIdAt(
                   ir, definingTypedNodeIndex) ||
           !typedExprIrValueDefinitionOwnershipMatchesNode(
               ir,
               originKind,
               typedFunctionIndex,
               definingTypedNodeIndex,
               ownership) ||
           proofKind != arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_resultTypeProofKinds,
               definingTypedNodeIndex):
            err = Fmt" typed expr value definition: typed authority drift row={row} function={typedFunctionIndex} node={definingTypedNodeIndex} function_node_start={functionNodeStart} function_node_count={functionNodeCount} owner_statement={ownerStatementIndex} function_statement_start={functionStatementStart} function_statement_count={functionStatementCount} produced_row={arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_producedValueDefinitionRows, definingTypedNodeIndex)} exact_type={exactTypeId} node_type={TypedExprIrNodeStructuralTypeIdAt(ir, definingTypedNodeIndex)} ownership={ownership} node_ownership={Int32(ir.nodes2_exprClasses[definingTypedNodeIndex])} proof={proofKind} node_proof={arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_resultTypeProofKinds, definingTypedNodeIndex)} parameter={parameterOrigin}"
            return false
        if parameterOrigin || bindingOrigin:
            let declarationBucket =
                typedExprValueDefinitionCoordinateBucket(
                    producerSourceIndex,
                    declarationSourceLocalRow,
                    bucketCount)
            var previous = declarationBucketHeads[declarationBucket]
            while previous >= 0:
                if arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitions_producerSourceIndexes,
                       previous) == producerSourceIndex &&
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitions_declarationSourceLocalRows,
                       previous) == declarationSourceLocalRow:
                    err = Fmt" typed expr value definition: duplicate declaration authority row={row} previous={previous}"
                    return false
                previous = declarationNext[previous]
            declarationNext[row] =
                declarationBucketHeads[declarationBucket]
            declarationBucketHeads[declarationBucket] = row
        if bindingOrigin:
            let patternBucket =
                typedExprValueDefinitionCoordinateBucket(
                    producerSourceIndex,
                    patternSourceLocalRow,
                    bucketCount)
            var previous = patternBucketHeads[patternBucket]
            while previous >= 0:
                if arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitions_producerSourceIndexes,
                       previous) == producerSourceIndex &&
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitions_patternSourceLocalRows,
                       previous) == patternSourceLocalRow:
                    err = Fmt" typed expr value definition: duplicate Pattern authority row={row} previous={previous}"
                    return false
                previous = patternNext[previous]
            patternNext[row] = patternBucketHeads[patternBucket]
            patternBucketHeads[patternBucket] = row
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        let definitionRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_lastUseMoveValueDefIds,
            nodeIndex)
        # Positive rows require both an exact LocalRef -> value-definition
        # binding edge and a CFG liveness proof. Neither canonical producer is
        # connected yet, so accepting any positive row would be fabrication.
        if definitionRow != -1:
            err = Fmt" typed expr value definition: last-use move producer unavailable node={nodeIndex} definition={definitionRow}"
            return false
    if !TypedExprValueDefinitionGroupAuthorityStrictValidateInto(
            ir, err):
        return false
    err = ""
    return true

@borrows
fn TypedExprValueDefinitionGroupAuthorityStrictValidateInto(
        ir: TypedExprIr,
        err: var str): bool =
    err = ""
    if !TypedExprValueDefinitionGroupAuthorityShapeComplete(ir) ||
       !TypedExprValueDefinitionAuthorityShapeComplete(ir) ||
       !TypedExprIrFunctions2ShapeComplete(ir):
        err = " typed expr value definition: coverage SoA shape mismatch"
        return false
    let groupCount =
        TypedExprValueDefinitionGroupAuthorityCount(ir)
    let definitionCount =
        TypedExprValueDefinitionAuthorityCount(ir)
    if definitionCount < groupCount:
        err = " typed expr value definition: group coverage exceeds definitions"
        return false
    var groupCursor: int32
    for functionIndex in 0..<ir.functions2_functionNameIds.len:
        let functionGroupStart = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_valueDefinitionGroupStarts,
            functionIndex)
        let functionGroupCount = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_valueDefinitionGroupCounts,
            functionIndex)
        if functionGroupStart != groupCursor ||
           functionGroupCount < 0 ||
           functionGroupStart + functionGroupCount > groupCount:
            err = Fmt" typed expr value definition: function coverage range drift function={functionIndex}"
            return false
        var previousInitializerRootSourceLocalNodeIndex: int32 = -1
        var previousPatternSourceLocalRow: int32 = -1
        var previousBindingOffset: int32 = -1
        var previousBindingCount: int32
        for groupOffset in 0..<functionGroupCount:
            let groupRow = functionGroupStart + groupOffset
            let initializerRootSourceLocalNodeIndex =
                arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
                    groupRow)
            let patternSourceLocalRow =
                arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.valueDefinitionGroups_patternSourceLocalRows,
                    groupRow)
            let bindingOffset = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_bindingOffsets,
                groupRow)
            let bindingCount = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_bindingCounts,
                groupRow)
            if arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitionGroups_typedFunctionIndexes,
                   groupRow) != functionIndex:
                err = Fmt" typed expr value definition: cross-function group remap function={functionIndex}"
                return false
            if initializerRootSourceLocalNodeIndex <
                   previousInitializerRootSourceLocalNodeIndex ||
               bindingOffset < 0 || bindingCount <= 0 ||
               bindingOffset >= bindingCount ||
               (initializerRootSourceLocalNodeIndex ==
                    previousInitializerRootSourceLocalNodeIndex &&
                (patternSourceLocalRow <= previousPatternSourceLocalRow ||
                 bindingOffset != previousBindingOffset + 1 ||
                 bindingCount != previousBindingCount)) ||
               (initializerRootSourceLocalNodeIndex >
                    previousInitializerRootSourceLocalNodeIndex &&
                (bindingOffset != 0 ||
                 (previousInitializerRootSourceLocalNodeIndex >= 0 &&
                  previousBindingOffset != previousBindingCount - 1))):
                err = Fmt" typed expr value definition: function root CSR invalid function={functionIndex}"
                return false
            previousInitializerRootSourceLocalNodeIndex =
                initializerRootSourceLocalNodeIndex
            previousPatternSourceLocalRow = patternSourceLocalRow
            previousBindingOffset = bindingOffset
            previousBindingCount = bindingCount
        if functionGroupCount > 0 &&
           previousBindingOffset != previousBindingCount - 1:
            err = Fmt" typed expr value definition: function root CSR incomplete function={functionIndex}"
            return false
        groupCursor = groupCursor + functionGroupCount
    if groupCursor != groupCount:
        err = " typed expr value definition: function coverage is incomplete"
        return false
    for groupRow in 0..<groupCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_producerSourceIndexes,
            groupRow)
        let parserProducerSourceIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_parserProducerSourceIndexes,
            groupRow)
        let initializerRootSourceLocalNodeIndex =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
                groupRow)
        let bindingOffset = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_bindingOffsets,
            groupRow)
        let bindingCount = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_bindingCounts,
            groupRow)
        let typedFunctionIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_typedFunctionIndexes,
            groupRow)
        let declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_declarationSourceLocalRows,
            groupRow)
        let patternSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_patternSourceLocalRows,
            groupRow)
        let definitionRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_definitionRows,
            groupRow)
        let consumed = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_consumedFlags,
            groupRow)
        if producerSourceIndex < 0 ||
           parserProducerSourceIndex < 0 ||
           initializerRootSourceLocalNodeIndex < 0 ||
           bindingOffset < 0 || bindingCount <= 0 ||
           bindingOffset >= bindingCount ||
           typedFunctionIndex < 0 ||
           typedFunctionIndex >= ir.functions2_functionNameIds.len ||
           declarationSourceLocalRow < 0 ||
           patternSourceLocalRow < 0 ||
           definitionRow < 0 ||
           definitionRow >= definitionCount ||
           consumed != 1 ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_groupRows,
               definitionRow) != groupRow ||
           TypedExprValueDefinitionOriginKind(
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_originKinds,
                   definitionRow)) !=
               TypedExprValueDefinitionOriginBindingInitializer:
            err = Fmt" typed expr value definition: coverage row invalid group={groupRow}"
            return false
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_producerSourceIndexes,
               definitionRow) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_typedFunctionIndexes,
               definitionRow) != typedFunctionIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_declarationSourceLocalRows,
               definitionRow) != declarationSourceLocalRow ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_patternSourceLocalRows,
               definitionRow) != patternSourceLocalRow:
            err = Fmt" typed expr value definition: coverage join drift group={groupRow}"
            return false
    for definitionRow in 0..<definitionCount:
        let originKind = TypedExprValueDefinitionOriginKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_originKinds,
                definitionRow))
        let groupRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_groupRows,
            definitionRow)
        if (originKind ==
                TypedExprValueDefinitionOriginBindingInitializer &&
            (groupRow < 0 || groupRow >= groupCount ||
             arenamod.ArenaArrayInt32Get(
                 ir.arena,
                 ir.valueDefinitionGroups_definitionRows,
                 groupRow) != definitionRow)) ||
           (originKind !=
                TypedExprValueDefinitionOriginBindingInitializer &&
            groupRow != -1):
            err = Fmt" typed expr value definition: unclaimed definition row={definitionRow}"
            return false
    err = ""
    return true

fn TypedExprValueDefinitionAuthorityStrictValidateParserSourceInto(
        ir: var TypedExprIr,
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        parserProducerSourceIndex: int32,
        err: var str): bool =
    if !TypedExprValueDefinitionAuthorityStrictValidateInto(ir, err):
        return false
    if tree == nil || producerSourceIndex < 0 ||
       parserProducerSourceIndex < 0:
        err = " typed expr value definition: parser source domain invalid"
        return false
    var parserErr: str
    if !parser.ParserValueExprTreeDeclarationsStrictValidateInto(
           share(tree), parserErr) ||
       !parser.ParserValueExprTreeAnnotationsStrictValidateInto(
           share(tree), parserErr) ||
       !parser.ParserValueExprTreePatternsStrictValidateInto(
           share(tree), parserErr):
        err = Fmt" typed expr value definition: parser authority invalid: {parserErr}"
        return false
    let bucketCount = TypedExprBuildIndexBucketCount(
        tree.declarationCount + tree.patternCount)
    var declarationBucketHeads: int32[]
    var declarationNext: int32[]
    var patternBucketHeads: int32[]
    var patternNext: int32[]
    setLen(declarationBucketHeads, bucketCount)
    setLen(patternBucketHeads, bucketCount)
    setLen(declarationNext, tree.declarationCount)
    setLen(patternNext, tree.patternCount)
    for bucket in 0..<bucketCount:
        declarationBucketHeads[bucket] = -1
        patternBucketHeads[bucket] = -1
    for candidate in 0..<tree.declarationCount:
        let candidateProducer = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            candidate)
        let candidateLocal = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationSourceLocalRows,
            candidate)
        let bucket = typedExprValueDefinitionCoordinateBucket(
            candidateProducer, candidateLocal, bucketCount)
        var previous = declarationBucketHeads[bucket]
        while previous >= 0:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationProducerSourceIndexes,
                   previous) == candidateProducer &&
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationSourceLocalRows,
                   previous) == candidateLocal:
                err = " typed expr value definition: declaration coordinate is not unique"
                return false
            previous = declarationNext[previous]
        declarationNext[candidate] = declarationBucketHeads[bucket]
        declarationBucketHeads[bucket] = candidate
    for candidate in 0..<tree.patternCount:
        let candidateProducer = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternProducerSourceIndexes,
            candidate)
        let candidateLocal = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternSourceLocalRows,
            candidate)
        let bucket = typedExprValueDefinitionCoordinateBucket(
            candidateProducer, candidateLocal, bucketCount)
        var previous = patternBucketHeads[bucket]
        while previous >= 0:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternProducerSourceIndexes,
                   previous) == candidateProducer &&
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternSourceLocalRows,
                   previous) == candidateLocal:
                err = " typed expr value definition: Pattern coordinate is not unique"
                return false
            previous = patternNext[previous]
        patternNext[candidate] = patternBucketHeads[bucket]
        patternBucketHeads[bucket] = candidate
    let count = TypedExprValueDefinitionAuthorityCount(ir)
    for row in 0..<count:
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_producerSourceIndexes,
               row) != producerSourceIndex:
            continue
        let originKind = TypedExprValueDefinitionOriginKind(
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_originKinds,
                row))
        if originKind ==
               TypedExprValueDefinitionOriginCallResult ||
           originKind ==
               TypedExprValueDefinitionOriginManagedTemporary:
            let definingNodeIndex = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_definingTypedNodeIndexes,
                row)
            if definingNodeIndex < 0 ||
               definingNodeIndex >= ir.nodes2_nodeIndexs.len ||
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitions_sourceLocalNodeIndexes,
                   row) !=
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.nodes2_originParserNodeIds,
                       definingNodeIndex):
                err = Fmt" typed expr value definition: parser value producer origin drift row={row}"
                return false
            continue
        let declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_declarationSourceLocalRows,
            row)
        let patternSourceLocalRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_patternSourceLocalRows,
            row)
        let declarationBucket =
            typedExprValueDefinitionCoordinateBucket(
                parserProducerSourceIndex,
                declarationSourceLocalRow,
                bucketCount)
        var declarationRow: int32 = -1
        var candidate = declarationBucketHeads[declarationBucket]
        while candidate >= 0:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationProducerSourceIndexes,
                   candidate) == parserProducerSourceIndex &&
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationSourceLocalRows,
                   candidate) == declarationSourceLocalRow:
                declarationRow = candidate
                break
            candidate = declarationNext[candidate]
        if originKind == TypedExprValueDefinitionOriginParameter:
            if declarationRow < 0 ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationKinds,
                   declarationRow) !=
                   Int32(parser.ParserDeclarationParameter):
                err = Fmt" typed expr value definition: parser parameter join drift row={row}"
                return false
            continue
        let patternBucket =
            typedExprValueDefinitionCoordinateBucket(
                parserProducerSourceIndex,
                patternSourceLocalRow,
                bucketCount)
        var patternRow: int32 = -1
        candidate = patternBucketHeads[patternBucket]
        while candidate >= 0:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternProducerSourceIndexes,
                   candidate) == parserProducerSourceIndex &&
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternSourceLocalRows,
                   candidate) == patternSourceLocalRow:
                patternRow = candidate
                break
            candidate = patternNext[candidate]
        if declarationRow < 0 || patternRow < 0 ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.patternBindingDeclarationRows,
               patternRow) != declarationRow:
            err = Fmt" typed expr value definition: parser binding join drift row={row}"
            return false
    err = ""
    return true

@borrows
fn TypedExprValueDefinitionProducerSourceIndexAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_producerSourceIndexes, row)

@borrows
fn TypedExprValueDefinitionOriginKindAt(
        ir: TypedExprIr,
        row: int32): TypedExprValueDefinitionOriginKind =
    return TypedExprValueDefinitionOriginKind(
        arenamod.ArenaArrayInt32Get(
            ir.arena, ir.valueDefinitions_originKinds, row))

@borrows
fn TypedExprValueDefinitionSourceLocalNodeIndexAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_sourceLocalNodeIndexes, row)

@borrows
fn TypedExprValueDefinitionDeclarationSourceLocalRowAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_declarationSourceLocalRows, row)

@borrows
fn TypedExprValueDefinitionPatternSourceLocalRowAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_patternSourceLocalRows, row)

@borrows
fn TypedExprValueDefinitionTypedFunctionIndexAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_typedFunctionIndexes, row)

@borrows
fn TypedExprValueDefinitionDefiningTypedNodeIndexAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_definingTypedNodeIndexes, row)

@borrows
fn TypedExprValueDefinitionExactTypeIdAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_exactTypeIds, row)

@borrows
fn TypedExprIrNodeStructuralTypeIdAt(
        ir: TypedExprIr,
        nodeIndex: int32): int32 =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len:
        panic("typed expr: node structural TypeId coordinate invalid")
    return arenamod.ArenaArrayInt32Get(
        ir.arena, ir.nodes2_structuralTypeIds, nodeIndex)

fn TypedExprIrBindExactTypeArena(
        ir: var TypedExprIr,
        arena: var typearena.TypedExprTypeArena,
        err: var str): bool =
    if arena == nil || !typearena.TypedExprTypeArenaComplete(arena) ||
       ir.exactTypeArena != nil ||
       ir.valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           ir.valueDefinitionTypeArenaArtifactCid,
           layout.FixedBytes32()) ||
       ir.nodes2_nodeIndexs.len != 0 ||
       TypedExprValueDefinitionAuthorityCount(ir) != 0:
        err = " typed expr: exact TypeArena bind state invalid"
        return false
    var arenaErr: str
    if !typearena.TypedExprTypeArenaStrictValidateInto(arena, arenaErr):
        err = arenaErr
        return false
    ir.valueDefinitionTypeArenaArtifactCid = arena.artifactRaw32
    ir.exactTypeArena = arena
    arena = nil
    ir.valueDefinitionTypeArenaBound = true
    err = ""
    return true

fn TypedExprIrSealExactTypeArena(
        ir: var TypedExprIr,
        arenaOut: var typearena.TypedExprTypeArena,
        err: var str): bool =
    if arenaOut != nil || ir.exactTypeArena == nil ||
       !ir.valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           ir.valueDefinitionTypeArenaArtifactCid,
           ir.exactTypeArena.artifactRaw32) ||
       !TypedExprValueDefinitionAuthorityStrictValidateInto(ir, err):
        if err == "":
            err = " typed expr: exact TypeArena seal state invalid"
        return false
    for definitionRow in 0..<
            TypedExprValueDefinitionAuthorityCount(ir):
        let definingNodeIndex =
            TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                ir, definitionRow)
        if TypedExprValueDefinitionExactTypeIdAt(
               ir, definitionRow) !=
               TypedExprIrNodeStructuralTypeIdAt(
                   ir, definingNodeIndex):
            err = " typed expr: value-definition structural TypeId drift"
            return false
    arenaOut = ir.exactTypeArena
    ir.exactTypeArena = nil
    err = ""
    return true

fn typedExprIrReservedScalarTypeId(
        ir: var TypedExprIr,
        scalarKind: typearena.TypedExprStructuralScalarKind): int32 =
    if ir.exactTypeArena == nil:
        return -1
    return typearena.TypedExprTypeArenaReservedScalarTypeId(
        ir.exactTypeArena, scalarKind)

@borrows
fn typedExprIrReservedScalarKindForRuntimeType(
        typeTextRaw: str): typearena.TypedExprStructuralScalarKind =
    let typeText = TypedExprNormalizeTypeText(typeTextRaw)
    if typeText == "void":
        return typearena.TypedExprStructuralScalarVoid
    if typeText == "bool":
        return typearena.TypedExprStructuralScalarBool
    if typeText == "char":
        return typearena.TypedExprStructuralScalarChar
    if typeText == "int8":
        return typearena.TypedExprStructuralScalarInt8
    if typeText == "uint8" || typeText == "u8":
        return typearena.TypedExprStructuralScalarUInt8
    if typeText == "int16":
        return typearena.TypedExprStructuralScalarInt16
    if typeText == "uint16" || typeText == "u16":
        return typearena.TypedExprStructuralScalarUInt16
    if typeText == "int32":
        return typearena.TypedExprStructuralScalarInt32
    if typeText == "uint32" || typeText == "u32":
        return typearena.TypedExprStructuralScalarUInt32
    if typeText == "int64":
        return typearena.TypedExprStructuralScalarInt64
    if typeText == "uint64" || typeText == "u64":
        return typearena.TypedExprStructuralScalarUInt64
    if typeText == "float32":
        return typearena.TypedExprStructuralScalarFloat32
    if typeText == "float64":
        return typearena.TypedExprStructuralScalarFloat64
    if typeText == "str":
        return typearena.TypedExprStructuralScalarStr
    if typeText == "cstring":
        return typearena.TypedExprStructuralScalarCString
    return typearena.TypedExprStructuralScalarInvalid

@borrows
fn typedExprIrReservedScalarTypeIdForRuntimeType(
        ir: var TypedExprIr,
        typeTextRaw: str): int32 =
    let scalarKind = typedExprIrReservedScalarKindForRuntimeType(typeTextRaw)
    if scalarKind <= typearena.TypedExprStructuralScalarInvalid ||
       scalarKind == typearena.TypedExprStructuralScalarInt ||
       scalarKind == typearena.TypedExprStructuralScalarUInt:
        return -1
    return typedExprIrReservedScalarTypeId(ir, scalarKind)

# [op73] 文本路径 AddrOf(&place / &FunctionName)的结构 TypeId 读路由:
# 取址节点 resultType 恒 "ptr", 而 reserved 标量文本表(typedExprIr-
# ReservedScalarKindForRuntimeType)无 "ptr" 项, TypeArena 保留标量播种
# (Void..CString)与保留标量权威(ReservedScalarTypeId 对 Ptr 显式 panic,
# [nn2] 同款在案理由)都不发 ptr 行。但 ptr 拼写行(参数/函数返回经
# TypeSyntax root 由 TypedExprTypeArenaTypeIdForTypeSyntax 铸造,
# ParserSyntax origin)早已是本编译集 ptr 值的现行权威
# (typedExprIrParamStructuralTypeIdsExact / typedExprIrExactCallReturn-
# TypeId 同源消费)。本臂按精确结构身份(Kind==Scalar 且 scalarKind==Ptr,
# 与 intern 结构去重同一键, 非文本近似键)扫唯一行; 无行(编译集无任何
# ptr 拼写)或多行(intern 去重下不可能)一律 -1。fail-closed: arena 未绑
# / 行不存在 / 命中不唯一 -> -1, bind 对 -1 是 no-op, 下游 exact
# producer TypeId 权威门原样 hard-fail, 零弱化。
@borrows
fn typedExprIrAddrOfPointerStructuralTypeId(
        arena: typearena.TypedExprTypeArena): int32 =
    var pointerHits: int32
    var pointerTypeId: int32 = -1
    let typeCount = typearena.TypedExprTypeArenaTypeCount(arena)
    for typeId in 0..<typeCount:
        if typearena.TypedExprTypeArenaKindAt(arena, typeId) !=
               typearena.TypedExprStructuralTypeScalar:
            continue
        if typearena.TypedExprStructuralScalarKind(
               arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.scalarKinds,
                   typeId)) !=
               typearena.TypedExprStructuralScalarPtr:
            continue
        pointerHits = pointerHits + 1
        pointerTypeId = typeId
    if pointerHits != 1:
        return -1
    return pointerTypeId

fn typedExprIrBindNodeStructuralType(
        ir: var TypedExprIr,
        node: var TypedExprIrNode,
        structuralTypeId: int32) =
    if structuralTypeId < 0:
        return
    if ir.exactTypeArena == nil ||
       structuralTypeId >=
           typearena.TypedExprTypeArenaTypeCount(ir.exactTypeArena):
        panic("typed expr: node structural TypeId bind domain invalid")
    node.resultStructuralTypeId = structuralTypeId
    node.resultTypeManaged =
        typearena.TypedExprTypeArenaManagedAt(
            ir.exactTypeArena, structuralTypeId)
    node.resultTypeSend =
        typearena.TypedExprTypeArenaSendAt(
            ir.exactTypeArena, structuralTypeId)
    node.resultTypeSync =
        typearena.TypedExprTypeArenaSyncAt(
            ir.exactTypeArena, structuralTypeId)
    node.resultTypeProofKind =
        TypedExprSnapshotTypeProofKindForTypeArenaAt(
            ir.exactTypeArena, structuralTypeId)

@borrows
fn TypedExprSnapshotTypeProofKindForTypeArenaAt(
        arena: typearena.TypedExprTypeArena,
        typeId: int32): int32 =
    if arena == nil || typeId < 0 ||
       typeId >= typearena.TypedExprTypeArenaTypeCount(arena):
        panic("typed expr: TypeArena proof coordinate invalid")
    let structuralKind =
        typearena.TypedExprTypeArenaKindAt(arena, typeId)
    if structuralKind ==
           typearena.TypedExprStructuralTypeScalar:
        return typearena.TypedExprTypeArenaManagedAt(arena, typeId) ?
            TypedExprSnapshotTypeProofManagedValue :
            TypedExprSnapshotTypeProofScalar
    if structuralKind ==
           typearena.TypedExprStructuralTypeBorrow ||
       structuralKind ==
           typearena.TypedExprStructuralTypeRefObject:
        return TypedExprSnapshotTypeProofReference
    if structuralKind ==
           typearena.TypedExprStructuralTypeSequence ||
       structuralKind ==
           typearena.TypedExprStructuralTypeFixedArray:
        return TypedExprSnapshotTypeProofSequence
    return TypedExprSnapshotTypeProofAggregate

@borrows
fn TypedExprValueDefinitionOwnershipAt(
        ir: TypedExprIr,
        row: int32): TypedExprExprClass =
    return TypedExprExprClass(
        arenamod.ArenaArrayInt32Get(
            ir.arena, ir.valueDefinitions_ownerships, row))

@borrows
fn TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
        ir: TypedExprIr,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueDefinitions_borrowOwnerValueDefinitionRows,
        row)

