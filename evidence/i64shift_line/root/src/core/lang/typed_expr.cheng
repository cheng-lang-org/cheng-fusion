    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_scopeStarts)
    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_scopeCounts)
    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_nodeStarts)
    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_nodeCounts)
