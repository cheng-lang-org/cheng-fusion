@borrows
fn TypedExprIrNodeBindingParserForestNodeIndexAt(
        ir: TypedExprIr,
        nodeIndex: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_bindingParserForestNodeIndexes,
        nodeIndex)

# Parameter place ParamRef produces the origin row; use-site ParamRefs
# bind that same row. SeedParamSlots must not demand a binding row on
# the synthetic place (that is a parser Identifier edge, not the def).
@borrows
fn TypedExprIrParameterValueDefinitionRowExact(
        ir: TypedExprIr,
        typedFn: TypedExprIrFunction,
        parameterOrdinal: int32): int32 =
    if parameterOrdinal < 0:
        panic("typed expr parameter binding: ordinal invalid")
    var nodeEnd = typedFn.nodeStart + typedFn.nodeCount
    if typedFn.nodeStart < 0 || nodeEnd < typedFn.nodeStart ||
       nodeEnd > ir.nodes2_nodeIndexs.len:
        panic("typed expr parameter binding: node range invalid")
    var definitionRow: int32 = -1
    for nodeIndex in typedFn.nodeStart..<nodeEnd:
        if ir.nodes2_opKinds[nodeIndex] != TypedExprIrOpParamRef ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_paramSlots,
               nodeIndex) != parameterOrdinal:
            continue
        let produced =
            TypedExprIrNodeProducedValueDefinitionRowAt(ir, nodeIndex)
        let binding =
            TypedExprIrNodeBindingValueDefinitionRowAt(ir, nodeIndex)
        var candidate: int32 = -1
        if produced >= 0:
            if TypedExprValueDefinitionOriginKindAt(ir, produced) !=
                   TypedExprValueDefinitionOriginParameter:
                panic("typed expr parameter binding: produced origin invalid")
            candidate = produced
        elif binding >= 0:
            if TypedExprValueDefinitionOriginKindAt(ir, binding) !=
                   TypedExprValueDefinitionOriginParameter:
                panic("typed expr parameter binding: binding origin invalid")
            candidate = binding
        else:
            continue
        if definitionRow >= 0 && definitionRow != candidate:
            panic("typed expr parameter binding: definition split")
        definitionRow = candidate
    if definitionRow < 0:
        panic("typed expr parameter binding: definition missing")
    return definitionRow

@borrows
fn TypedExprIrNodeOwnerStatementIndexAt(
        ir: TypedExprIr,
        nodeIndex: int32): int32 =
    return arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_ownerStatementIndexes,
        nodeIndex)

@borrows
fn typedExprIrBuildParameterOrdinalAuthority(
        ir: var TypedExprIr,
        tree: parser.ParserValueExprTree) =
    ir.valueExprTransactionParameterOrdinalsByDeclarationRow.len = 0
    for declarationRow in 0..<tree.declarationCount:
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueExprTransactionParameterOrdinalsByDeclarationRow,
            -1)
    ir.valueExprTransactionParameterCountsByFunctionRow.len = 0
    for functionRow in 0..<tree.declarationFunctionCount:
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueExprTransactionParameterCountsByFunctionRow,
            0)
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationParameter):
            continue
        let functionRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationFunctionRows,
            declarationRow)
        if functionRow < 0 ||
           functionRow >= tree.declarationFunctionCount:
            panic("typed expr binding: parameter function identity unavailable")
        let ordinal = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueExprTransactionParameterCountsByFunctionRow,
            functionRow)
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.valueExprTransactionParameterOrdinalsByDeclarationRow,
            declarationRow,
            ordinal)
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.valueExprTransactionParameterCountsByFunctionRow,
            functionRow,
            ordinal + 1)
    ir.valueExprTransactionParameterOrdinalLookupCount = 0

@borrows
fn typedExprIrValueDefinitionPatternAuthorityMatchesTree(
        ir: TypedExprIr,
        tree: parser.ParserValueExprTree): bool =
    if tree == nil ||
       !tree.structuralValidationPassed ||
       !tree.lexicalBindingAuthoritySealed ||
       tree.lifecycleState != parser.ParserValueExprOwnerActive:
        return false
    if ir.valueExprPatternParentRows.len != tree.patternCount ||
       ir.valueExprPatternRootRows.len != tree.patternCount ||
       ir.valueExprPatternRootBindingCounts.len != tree.patternCount ||
       ir.valueExprDeclarationBindingPatternRows.len !=
           tree.declarationCount ||
       ir.valueExprBindingInitializerStatementRootRows.len !=
           parser.ParserValueExprTreeNodeCount(tree):
        return false
    if tree.patternCount <= 0:
        return true
    let lastPatternRow = tree.patternCount - 1
    let childStart = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.patternChildStarts, lastPatternRow)
    let childCount = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.patternChildCounts, lastPatternRow)
    if childCount <= 0:
        return ir.valueExprPatternRootRows[lastPatternRow] == lastPatternRow ||
               ir.valueExprPatternParentRows[lastPatternRow] >= 0
    let childRow = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.patternChildNodeIndexes,
        childStart)
    return childRow >= 0 &&
           childRow < tree.patternCount &&
           ir.valueExprPatternParentRows[childRow] == lastPatternRow

@borrows
fn typedExprIrBuildValueDefinitionPatternAuthority(
        ir: var TypedExprIr,
        tree: parser.ParserValueExprTree) =
    if typedExprIrValueDefinitionPatternAuthorityMatchesTree(ir, tree):
        ir.valueExprTransactionDeclarationLocalGroupRows = []
        setLen(ir.valueExprTransactionDeclarationLocalGroupRows,
               tree.declarationCount)
        for declarationRow in 0..<tree.declarationCount:
            ir.valueExprTransactionDeclarationLocalGroupRows[declarationRow] = -1
        return
    var parserErr: str
    if tree == nil ||
       (!tree.structuralValidationPassed &&
        (!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
            tree, parserErr) ||
         !parser.ParserValueExprTreeAnnotationsStrictValidateInto(
             tree, parserErr) ||
         !parser.ParserValueExprTreePatternsStrictValidateInto(
             tree, parserErr))):
        panic(Fmt"typed expr value definition: parser authority invalid: {parserErr}")
    ir.valueExprPatternParentRows = []
    ir.valueExprPatternRootRows = []
    ir.valueExprPatternRootBindingCounts = []
    ir.valueExprDeclarationBindingPatternRows = []
    ir.valueExprBindingInitializerStatementRootRows = []
    setLen(ir.valueExprPatternParentRows, tree.patternCount)
    setLen(ir.valueExprPatternRootRows, tree.patternCount)
    setLen(ir.valueExprPatternRootBindingCounts, tree.patternCount)
    setLen(ir.valueExprDeclarationBindingPatternRows,
           tree.declarationCount)
    setLen(ir.valueExprBindingInitializerStatementRootRows,
           parser.ParserValueExprTreeNodeCount(tree))
    ir.valueExprTransactionDeclarationLocalGroupRows = []
    setLen(ir.valueExprTransactionDeclarationLocalGroupRows,
           tree.declarationCount)
    for declarationRow in 0..<tree.declarationCount:
        ir.valueExprTransactionDeclarationLocalGroupRows[declarationRow] = -1
    for patternRow in 0..<tree.patternCount:
        ir.valueExprPatternParentRows[patternRow] = -1
        ir.valueExprPatternRootRows[patternRow] = -1
    for declarationRow in 0..<tree.declarationCount:
        ir.valueExprDeclarationBindingPatternRows[declarationRow] = -1
    for nodeIndex in 0..<ir.valueExprBindingInitializerStatementRootRows.len:
        ir.valueExprBindingInitializerStatementRootRows[nodeIndex] = -1
    for statementRootRow in 0..<tree.statementRootCount:
        if parser.ParserValueExprStatementRootRoleAt(
               tree, statementRootRow) !=
               parser.ParserValueExprStatementBindingInitializer:
            continue
        let rootNodeIndex =
            parser.ParserValueExprStatementRootNodeAt(
                tree, statementRootRow)
        if rootNodeIndex < 0 ||
           rootNodeIndex >=
               ir.valueExprBindingInitializerStatementRootRows.len ||
           ir.valueExprBindingInitializerStatementRootRows[
               rootNodeIndex] >= 0:
            panic("typed expr value definition: initializer root is not unique")
        ir.valueExprBindingInitializerStatementRootRows[
            rootNodeIndex] = statementRootRow
    for patternRow in 0..<tree.patternCount:
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternChildStarts, patternRow)
        let childCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternChildCounts, patternRow)
        for childOffset in 0..<childCount:
            let childRow = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.patternChildNodeIndexes,
                childStart + childOffset)
            if childRow < 0 || childRow >= patternRow ||
               ir.valueExprPatternParentRows[childRow] >= 0:
                panic("typed expr value definition: Pattern child CSR is not a forest")
            ir.valueExprPatternParentRows[childRow] = patternRow
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternBindingDeclarationRows,
            patternRow)
        if declarationRow >= 0:
            if declarationRow >= tree.declarationCount ||
               ir.valueExprDeclarationBindingPatternRows[
                   declarationRow] >= 0:
                panic("typed expr value definition: PatternBinding declaration is not unique")
            ir.valueExprDeclarationBindingPatternRows[
                declarationRow] = patternRow
    for reverseOffset in 0..<tree.patternCount:
        let patternRow = tree.patternCount - 1 - reverseOffset
        let parentRow = ir.valueExprPatternParentRows[patternRow]
        if parentRow < 0:
            ir.valueExprPatternRootRows[patternRow] = patternRow
        else:
            let rootRow = ir.valueExprPatternRootRows[parentRow]
            if rootRow < 0:
                panic("typed expr value definition: Pattern root order invalid")
            ir.valueExprPatternRootRows[patternRow] = rootRow
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternBindingDeclarationRows,
            patternRow)
        if declarationRow >= 0:
            let rootRow = ir.valueExprPatternRootRows[patternRow]
            ir.valueExprPatternRootBindingCounts[rootRow] =
                ir.valueExprPatternRootBindingCounts[rootRow] + 1

@borrows
fn typedExprValueDefinitionLeafCoordinates(
        ir: TypedExprIr,
        tree: parser.ParserValueExprTree,
        initializerRootNodeIndex: int32,
        bindingOffset: int32,
        bindingPatternRowOut: var int32,
        parserProducerSourceIndex: var int32,
        declarationSourceLocalRow: var int32,
        patternSourceLocalRow: var int32) =
    if initializerRootNodeIndex < 0 ||
       initializerRootNodeIndex >=
           ir.valueExprBindingInitializerStatementRootRows.len:
        panic("typed expr value definition: initializer root is out of range")
    let statementRootRow =
        ir.valueExprBindingInitializerStatementRootRows[
            initializerRootNodeIndex]
    if statementRootRow < 0:
        panic("typed expr value definition: initializer statement authority missing")
    let declarationStart =
        parser.ParserValueExprStatementRootBindingDeclarationStartAt(
            tree, statementRootRow)
    let declarationCount =
        parser.ParserValueExprStatementRootBindingDeclarationCountAt(
            tree, statementRootRow)
    if declarationStart < 0 || declarationCount <= 0 ||
       declarationStart > tree.declarationCount - declarationCount:
        panic("typed expr value definition: initializer declaration range invalid")
    if bindingOffset < 0 || bindingOffset >= declarationCount:
        panic("typed expr value definition: PatternBinding offset is out of range")
    let declarationRow = declarationStart + bindingOffset
    let bindingPatternRow =
        ir.valueExprDeclarationBindingPatternRows[declarationRow]
    let firstBindingPatternRow =
        ir.valueExprDeclarationBindingPatternRows[declarationStart]
    var rootPatternRow: int32 = -1
    if bindingPatternRow >= 0:
        rootPatternRow = ir.valueExprPatternRootRows[bindingPatternRow]
    var statementRootPatternRow: int32 = -1
    if firstBindingPatternRow >= 0:
        statementRootPatternRow =
            ir.valueExprPatternRootRows[firstBindingPatternRow]
    if bindingPatternRow < 0 ||
       rootPatternRow < 0 ||
       rootPatternRow != statementRootPatternRow ||
       ir.valueExprPatternRootBindingCounts[rootPatternRow] !=
           declarationCount ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.patternKinds,
           bindingPatternRow) != Int32(parser.ParserPatternBinding):
        panic("typed expr value definition: PatternBinding leaf authority invalid")
    bindingPatternRowOut = bindingPatternRow
    parserProducerSourceIndex =
        parser.ParserValueExprNodeProducerSourceIndexAt(
            tree, initializerRootNodeIndex)
    if parserProducerSourceIndex < 0 ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationProducerSourceIndexes,
           declarationRow) != parserProducerSourceIndex ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.patternProducerSourceIndexes,
           bindingPatternRow) != parserProducerSourceIndex ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.patternBindingDeclarationRows,
           bindingPatternRow) != declarationRow:
        panic("typed expr value definition: producer source authority split")
    declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationSourceLocalRows,
        declarationRow)
    patternSourceLocalRow = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.patternSourceLocalRows,
        bindingPatternRow)

@borrows
fn TypedExprIrRegisterValueDefinitionFunctionGroups(
        ir: var TypedExprIr,
        exprLayer: var parser.NormalizedExprLayer,
        exprStartIndex: int32,
        exprEndIndex: int32,
        scope: TypedExprFunctionScope,
        typedFunctionIndex: int32,
        groupStart: var int32,
        groupCount: var int32) =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil ||
       exprStartIndex < 0 || exprEndIndex < exprStartIndex ||
       exprEndIndex > exprLayer.exprs.len ||
       typedFunctionIndex != ir.functions2_functionNameIds.len ||
       !TypedExprValueDefinitionGroupAuthorityShapeComplete(ir):
        panic("typed expr value definition: group registration domain invalid")
    groupStart = TypedExprValueDefinitionGroupAuthorityCount(ir)
    groupCount = 0
    if ir.arena.capacityBytes <= 0:
        ir.arena = arenamod.ArenaInitDefault(1048576)
    for exprIndex in exprStartIndex..<exprEndIndex:
        let expr = exprLayer.exprs[exprIndex]
        if expr.valueExprStatementRole !=
               parser.ParserValueExprStatementBindingInitializer:
            continue
        let initializerRootNodeIndex = expr.valueExprRootNodeIndex
        if initializerRootNodeIndex < 0 ||
           initializerRootNodeIndex >=
               ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len ||
           initializerRootNodeIndex >=
               ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex.len:
            panic("typed expr value definition: parser initializer root index unavailable")
        let registeredGroupStart =
            ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex[
                initializerRootNodeIndex]
        let registeredGroupCount =
            ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex[
                initializerRootNodeIndex]
        let statementRootRow =
            ir.valueExprBindingInitializerStatementRootRows[
                initializerRootNodeIndex]
        if statementRootRow < 0:
            panic("typed expr value definition: initializer statement authority missing")
        let declarationCount =
            parser.ParserValueExprStatementRootBindingDeclarationCountAt(
                ir.valueExprTree, statementRootRow)
        if declarationCount <= 0:
            panic("typed expr value definition: initializer declaration range invalid")
        if registeredGroupStart >= 0:
            if registeredGroupCount != declarationCount ||
               registeredGroupStart <
                   ir.valueExprTransactionDefinitionGroupStart ||
               registeredGroupStart >
                   TypedExprValueDefinitionGroupAuthorityCount(ir) -
                   registeredGroupCount:
                panic("typed expr value definition: parser initializer root range escaped transaction")
            for bindingOffset in 0..<registeredGroupCount:
                var bindingPatternRow: int32
                var parserProducerSourceIndex: int32
                var declarationSourceLocalRow: int32
                var patternSourceLocalRow: int32
                typedExprValueDefinitionLeafCoordinates(
                    ir,
                    ir.valueExprTree,
                    initializerRootNodeIndex,
                    bindingOffset,
                    bindingPatternRow,
                    parserProducerSourceIndex,
                    declarationSourceLocalRow,
                    patternSourceLocalRow)
                var producerSourceIndex =
                    ir.valueExprTransactionProducerSourceIndex
                if producerSourceIndex < 0:
                    producerSourceIndex = parserProducerSourceIndex
                let initializerRootSourceLocalNodeIndex =
                    parser.ParserValueExprNodeSourceLocalIndexAt(
                        ir.valueExprTree,
                        initializerRootNodeIndex)
                let registeredGroupRow =
                    registeredGroupStart + bindingOffset
                if bindingPatternRow < 0 ||
                   bindingPatternRow >=
                       arenamod.ArenaArrayInt32Len(
                           ir.arena,
                           ir.valueExprTransactionDefinitionGroupRowsByPatternRow) ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
                       bindingPatternRow) != registeredGroupRow:
                    panic("typed expr value definition: parser Pattern group index split")
                if producerSourceIndex < 0 ||
                   initializerRootSourceLocalNodeIndex < 0 ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_producerSourceIndexes,
                       registeredGroupRow) != producerSourceIndex ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_parserProducerSourceIndexes,
                       registeredGroupRow) != parserProducerSourceIndex ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
                       registeredGroupRow) !=
                       initializerRootSourceLocalNodeIndex ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_bindingOffsets,
                       registeredGroupRow) != bindingOffset ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_bindingCounts,
                       registeredGroupRow) != registeredGroupCount ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_typedFunctionIndexes,
                       registeredGroupRow) != typedFunctionIndex ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_declarationSourceLocalRows,
                       registeredGroupRow) != declarationSourceLocalRow ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.valueDefinitionGroups_patternSourceLocalRows,
                       registeredGroupRow) != patternSourceLocalRow:
                    panic("typed expr value definition: parser initializer root authority split")
            continue
        if registeredGroupCount != 0:
            panic("typed expr value definition: parser initializer root range is torn")
        let newGroupStart =
            TypedExprValueDefinitionGroupAuthorityCount(ir)
        ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex[
            initializerRootNodeIndex] = newGroupStart
        ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex[
            initializerRootNodeIndex] = declarationCount
        for bindingOffset in 0..<declarationCount:
            var bindingPatternRow: int32
            var parserProducerSourceIndex: int32
            var declarationSourceLocalRow: int32
            var patternSourceLocalRow: int32
            typedExprValueDefinitionLeafCoordinates(
                ir,
                ir.valueExprTree,
                initializerRootNodeIndex,
                bindingOffset,
                bindingPatternRow,
                parserProducerSourceIndex,
                declarationSourceLocalRow,
                patternSourceLocalRow)
            var producerSourceIndex =
                ir.valueExprTransactionProducerSourceIndex
            if producerSourceIndex < 0:
                producerSourceIndex = parserProducerSourceIndex
            let initializerRootSourceLocalNodeIndex =
                parser.ParserValueExprNodeSourceLocalIndexAt(
                    ir.valueExprTree,
                    initializerRootNodeIndex)
            if producerSourceIndex < 0 ||
               initializerRootSourceLocalNodeIndex < 0:
                panic("typed expr value definition: group source coordinate invalid")
            if bindingPatternRow < 0 ||
               bindingPatternRow >=
                   arenamod.ArenaArrayInt32Len(
                       ir.arena,
                       ir.valueExprTransactionDefinitionGroupRowsByPatternRow) ||
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
                   bindingPatternRow) != -1:
                panic("typed expr value definition: parser Pattern group is not unique")
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_producerSourceIndexes,
                producerSourceIndex)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_parserProducerSourceIndexes,
                parserProducerSourceIndex)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
                initializerRootSourceLocalNodeIndex)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_bindingOffsets,
                bindingOffset)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_bindingCounts,
                declarationCount)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_typedFunctionIndexes,
                typedFunctionIndex)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_declarationSourceLocalRows,
                declarationSourceLocalRow)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_patternSourceLocalRows,
                patternSourceLocalRow)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_definitionRows,
                -1)
            arenamod.ArenaArrayInt32Add(
                ir.arena,
                ir.valueDefinitionGroups_consumedFlags,
                0)
            let newGroupRow =
                TypedExprValueDefinitionGroupAuthorityCount(ir) - 1
            if newGroupRow != newGroupStart + bindingOffset:
                panic("typed expr value definition: PatternBinding group range is not dense")
            arenamod.ArenaArrayInt32Set(
                ir.arena,
                ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
                bindingPatternRow,
                newGroupRow)
            let transactionGroupOffset =
                newGroupRow - ir.valueExprTransactionDefinitionGroupStart
            if transactionGroupOffset !=
                   ir.valueExprTransactionDefinitionGroupRootNodeIndexes.len:
                panic("typed expr value definition: transaction group root map is not dense")
            add(
                ir.valueExprTransactionDefinitionGroupRootNodeIndexes,
                initializerRootNodeIndex)
            groupCount = groupCount + 1
    typedExprIrRegisterDeclarationLocalGroups(
        ir, scope, typedFunctionIndex, groupCount)
    if groupStart + groupCount !=
           TypedExprValueDefinitionGroupAuthorityCount(ir) ||
       ir.valueExprTransactionDefinitionGroupRootNodeIndexes.len !=
           TypedExprValueDefinitionGroupAuthorityCount(ir) -
           ir.valueExprTransactionDefinitionGroupStart ||
       !TypedExprValueDefinitionGroupAuthorityShapeComplete(ir):
        panic("typed expr value definition: group registration shape drift")

@borrows
fn typedExprIrDeclarationIntroductionKind(
        tree: parser.ParserValueExprTree,
        declarationRow: int32): parser.ParserLexicalBindingIntroductionKind =
    if tree == nil || declarationRow < 0:
        return parser.ParserLexicalBindingIntroductionInvalid
    for bindingRow in 0..<tree.lexicalBindingCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.lexicalBindingDeclarationRows,
               bindingRow) != declarationRow:
            continue
        return parser.ParserLexicalBindingIntroductionKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.lexicalBindingIntroductionKinds,
                bindingRow))
    return parser.ParserLexicalBindingIntroductionInvalid

@borrows
fn typedExprIrRegisterDeclarationLocalGroups(
        ir: var TypedExprIr,
        scope: TypedExprFunctionScope,
        typedFunctionIndex: int32,
        groupCount: var int32) =
    let tree = ir.valueExprTree
    if tree == nil ||
       ir.valueExprTransactionDeclarationLocalGroupRows.len !=
           tree.declarationCount:
        panic("typed expr value definition: declaration-local group index missing")
    var parserProducerSourceIndex: int32
    var parserFunctionRow: int32
    let _ = typedExprIrScopeParserFunctionIdentityExact(
        ir, scope, parserProducerSourceIndex, parserFunctionRow)
    let nodeCount = parser.ParserValueExprTreeNodeCount(tree)
    var producerSourceIndex = ir.valueExprTransactionProducerSourceIndex
    if producerSourceIndex < 0:
        producerSourceIndex = parserProducerSourceIndex
    if producerSourceIndex < 0:
        panic("typed expr value definition: declaration-local producer missing")
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationLocal):
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationFunctionRows,
               declarationRow) != parserFunctionRow:
            continue
        if typedExprIrDeclarationIntroductionKind(tree, declarationRow) !=
               parser.ParserLexicalBindingIntroductionDeclaration:
            continue
        let bindingPatternRow =
            ir.valueExprDeclarationBindingPatternRows[declarationRow]
        if bindingPatternRow < 0 ||
           bindingPatternRow >=
               arenamod.ArenaArrayInt32Len(
                   ir.arena,
                   ir.valueExprTransactionDefinitionGroupRowsByPatternRow):
            panic("typed expr value definition: declaration-local Pattern missing")
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
               bindingPatternRow) >= 0 ||
           ir.valueExprTransactionDeclarationLocalGroupRows[declarationRow] >= 0:
            panic("typed expr value definition: declaration-local group already registered")
        let declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationSourceLocalRows,
            declarationRow)
        let patternSourceLocalRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternSourceLocalRows,
            bindingPatternRow)
        let parserDeclProducer = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        # Disjoint from parser value-expr node source-locals so the
        # function-level group CSR stays monotonic.
        let declarationRootKey = nodeCount + 1 + declarationRow
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_producerSourceIndexes,
            producerSourceIndex)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_parserProducerSourceIndexes,
            parserDeclProducer)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
            declarationRootKey)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_bindingOffsets,
            0)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_bindingCounts,
            1)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_typedFunctionIndexes,
            typedFunctionIndex)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_declarationSourceLocalRows,
            declarationSourceLocalRow)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_patternSourceLocalRows,
            patternSourceLocalRow)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_definitionRows,
            -1)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueDefinitionGroups_consumedFlags,
            0)
        let newGroupRow =
            TypedExprValueDefinitionGroupAuthorityCount(ir) - 1
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
            bindingPatternRow,
            newGroupRow)
        ir.valueExprTransactionDeclarationLocalGroupRows[declarationRow] =
            newGroupRow
        let transactionGroupOffset =
            newGroupRow - ir.valueExprTransactionDefinitionGroupStart
        if transactionGroupOffset !=
               ir.valueExprTransactionDefinitionGroupRootNodeIndexes.len:
            panic("typed expr value definition: declaration-local group root map is not dense")
        add(ir.valueExprTransactionDefinitionGroupRootNodeIndexes, -1)
        groupCount = groupCount + 1

@borrows
fn TypedExprIrConsumeDeclarationLocalValueDefinition(
        ir: var TypedExprIr,
        bindingNameRaw: str,
        definingTypedNodeIndex: int32): int32 =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil:
        return -1
    if definingTypedNodeIndex < 0 ||
       definingTypedNodeIndex >= ir.nodes2_nodeIndexs.len:
        panic("typed expr value definition: declaration-local defining node invalid")
    let tree = ir.valueExprTree
    let bindingName = parser.ParserIdentPrefix(chengpath.PathTrim(bindingNameRaw))
    if bindingName == "" ||
       ir.valueExprCurrentParserFunctionRow < 0 ||
       ir.valueExprTransactionDeclarationLocalGroupRows.len !=
           tree.declarationCount:
        panic("typed expr value definition: declaration-local consume domain invalid")
    var hits: int32
    var foundDeclarationRow: int32
    hits = 0
    foundDeclarationRow = -1
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationLocal):
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationFunctionRows,
               declarationRow) != ir.valueExprCurrentParserFunctionRow:
            continue
        if typedExprIrDeclarationIntroductionKind(tree, declarationRow) !=
               parser.ParserLexicalBindingIntroductionDeclaration:
            continue
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        if parser.ParserValueExprTokenText(tree, nameToken) != bindingName:
            continue
        hits = hits + 1
        foundDeclarationRow = declarationRow
    if hits != 1 || foundDeclarationRow < 0:
        panic(Fmt"typed expr value definition: declaration-local identity is not unique name={bindingName} hits={hits}")
    let groupRow =
        ir.valueExprTransactionDeclarationLocalGroupRows[foundDeclarationRow]
    if groupRow < ir.valueExprTransactionDefinitionGroupStart ||
       groupRow >= TypedExprValueDefinitionGroupAuthorityCount(ir):
        panic("typed expr value definition: declaration-local group was not registered")
    if arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_consumedFlags,
           groupRow) != 0:
        panic("typed expr value definition: declaration-local group consumed twice")
    let bindingPatternRow =
        ir.valueExprDeclarationBindingPatternRows[foundDeclarationRow]
    let declarationSourceLocalRow = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationSourceLocalRows,
        foundDeclarationRow)
    let patternSourceLocalRow = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.patternSourceLocalRows,
        bindingPatternRow)
    var producerSourceIndex = ir.valueExprTransactionProducerSourceIndex
    if producerSourceIndex < 0:
        producerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            foundDeclarationRow)
    let definitionRow = typedExprIrAppendValueDefinitionExact(
        ir,
        TypedExprValueDefinitionOriginBindingInitializer,
        producerSourceIndex,
        declarationSourceLocalRow,
        declarationSourceLocalRow,
        patternSourceLocalRow,
        ir.functions2_functionNameIds.len,
        definingTypedNodeIndex,
        groupRow,
        ir.nodes2_exprClasses[definingTypedNodeIndex])
    arenamod.ArenaArrayInt32Set(
        ir.arena,
        ir.valueDefinitionGroups_definitionRows,
        groupRow,
        definitionRow)
    arenamod.ArenaArrayInt32Set(
        ir.arena,
        ir.valueDefinitionGroups_consumedFlags,
        groupRow,
        1)
    return definitionRow

@borrows
fn typedExprIrCanonicalBorrowOwnerForDefinitionRow(
        ir: TypedExprIr,
        definitionRow: int32,
        typedFunctionIndex: int32): int32 =
    let definitionCount =
        TypedExprValueDefinitionAuthorityCount(ir)
    if definitionRow < 0 || definitionRow >= definitionCount ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitions_typedFunctionIndexes,
           definitionRow) != typedFunctionIndex:
        return -1
    let ownership = TypedExprValueDefinitionOwnershipAt(
        ir, definitionRow)
    if ownership == TypedExprExprOwned:
        return definitionRow
    if ownership != TypedExprExprBorrowed:
        return -1
    let ownerRow =
        TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
            ir, definitionRow)
    if ownerRow < 0 || ownerRow > definitionRow:
        return -1
    if ownerRow == definitionRow:
        if TypedExprValueDefinitionOriginKindAt(
               ir, definitionRow) !=
               TypedExprValueDefinitionOriginParameter:
            return -1
        return ownerRow
    let ownerOwnership =
        TypedExprValueDefinitionOwnershipAt(ir, ownerRow)
    if ownerOwnership == TypedExprExprOwned:
        return ownerRow
    if ownerOwnership == TypedExprExprBorrowed &&
       TypedExprValueDefinitionOriginKindAt(ir, ownerRow) ==
           TypedExprValueDefinitionOriginParameter &&
       TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
           ir, ownerRow) == ownerRow:
        return ownerRow
    return -1

@borrows
fn typedExprIrBorrowOwnerForNodeExact(
        ir: TypedExprIr,
        nodeIndex: int32,
        typedFunctionIndex: int32): int32 =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len ||
       !ir.nodes2_resultTypeManagedFlags[nodeIndex] ||
       ir.nodes2_exprClasses[nodeIndex] != TypedExprExprBorrowed:
        return -1
    let bindingDefinitionRow = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_bindingValueDefinitionRows,
        nodeIndex)
    if bindingDefinitionRow >= 0:
        return typedExprIrCanonicalBorrowOwnerForDefinitionRow(
            ir, bindingDefinitionRow, typedFunctionIndex)
    let opKind = ir.nodes2_opKinds[nodeIndex]
    if opKind == TypedExprIrOpFieldGet ||
       opKind == TypedExprIrOpIndexGet ||
       opKind == TypedExprIrOpAddrOf ||
       opKind == TypedExprIrOpArgLink:
        return typedExprIrBorrowOwnerForNodeExact(
            ir,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_operand0NodeIndexs,
                nodeIndex),
            typedFunctionIndex)
    if opKind != TypedExprIrOpCallExpr:
        return -1
    var linkNodeIndex = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_operand0NodeIndexs,
        nodeIndex)
    var ownerRow: int32 = -1
    var linkCount: int32
    while linkNodeIndex >= 0:
        if linkNodeIndex >= nodeIndex ||
           linkNodeIndex >= ir.nodes2_nodeIndexs.len ||
           ir.nodes2_opKinds[linkNodeIndex] != TypedExprIrOpArgLink ||
           linkCount >= ir.nodes2_nodeIndexs.len:
            return -1
        let valueNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_operand0NodeIndexs,
            linkNodeIndex)
        if valueNodeIndex >= 0 &&
           valueNodeIndex < ir.nodes2_nodeIndexs.len &&
           ir.nodes2_resultTypeManagedFlags[valueNodeIndex]:
            # A borrow-result may escape only through an already borrowed
            # actual value. An Owned temporary actual would die at the call.
            if ir.nodes2_exprClasses[valueNodeIndex] !=
                   TypedExprExprBorrowed:
                return -1
            let candidateOwner = typedExprIrBorrowOwnerForNodeExact(
                ir, valueNodeIndex, typedFunctionIndex)
            if candidateOwner < 0:
                return -1
            if ownerRow < 0:
                ownerRow = candidateOwner
            elif ownerRow != candidateOwner:
                # @borrow_result names no parameter. Multiple distinct roots
                # therefore have no exact owner identity and remain HARD_RED.
                return -1
        linkNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_operand1NodeIndexs,
            linkNodeIndex)
        linkCount = linkCount + 1
    return ownerRow

@borrows
fn typedExprIrParameterDefinitionOwnershipExact(
        ir: TypedExprIr,
        nodeIndex: int32,
        borrowsArguments: bool): TypedExprExprClass =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len ||
       ir.nodes2_opKinds[nodeIndex] != TypedExprIrOpParamRef:
        panic("typed expr value definition: parameter node identity invalid")
    let nodeOwnership = ir.nodes2_exprClasses[nodeIndex]
    let managed = ir.nodes2_resultTypeManagedFlags[nodeIndex]
    let mutableFlag = ir.nodes2_paramMutableFlags[nodeIndex]
    if nodeOwnership == TypedExprExprUnmanaged:
        if managed:
            panic("typed expr value definition: managed parameter read view is unmanaged")
        return TypedExprExprUnmanaged
    if nodeOwnership != TypedExprExprBorrowed:
        panic("typed expr value definition: parameter read view is not borrowed")
    if mutableFlag || borrowsArguments:
        return TypedExprExprBorrowed
    if !managed:
        panic("typed expr value definition: immutable borrowed parameter has no managed type")
    # ParamRef is always a borrowed read view.  The immutable binding itself
    # owns the incoming managed value unless the declaration says @borrows.
    return TypedExprExprOwned

@borrows
fn typedExprIrValueDefinitionOwnershipMatchesNode(
        ir: TypedExprIr,
        originKind: TypedExprValueDefinitionOriginKind,
        typedFunctionIndex: int32,
        definingTypedNodeIndex: int32,
        ownership: int32): bool =
    if definingTypedNodeIndex < 0 ||
       definingTypedNodeIndex >= ir.nodes2_nodeIndexs.len:
        return false
    if originKind != TypedExprValueDefinitionOriginParameter:
        return ownership ==
            Int32(ir.nodes2_exprClasses[definingTypedNodeIndex])
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= ir.functions2_borrowsArguments.len:
        return false
    return ownership == Int32(
        typedExprIrParameterDefinitionOwnershipExact(
            ir,
            definingTypedNodeIndex,
            ir.functions2_borrowsArguments[typedFunctionIndex]))

@borrows
fn TypedExprValueDefinitionOwnershipMatchesNodeAt(
        ir: TypedExprIr,
        definitionRow: int32): bool =
    if definitionRow < 0 ||
       definitionRow >= TypedExprValueDefinitionAuthorityCount(ir):
        return false
    let originKind = TypedExprValueDefinitionOriginKind(
        arenamod.ArenaArrayInt32Get(
            ir.arena, ir.valueDefinitions_originKinds, definitionRow))
    let typedFunctionIndex = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueDefinitions_typedFunctionIndexes,
        definitionRow)
    let definingTypedNodeIndex = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueDefinitions_definingTypedNodeIndexes,
        definitionRow)
    let ownership = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.valueDefinitions_ownerships, definitionRow)
    return typedExprIrValueDefinitionOwnershipMatchesNode(
        ir,
        originKind,
        typedFunctionIndex,
        definingTypedNodeIndex,
        ownership)

fn typedExprIrAppendValueDefinitionExact(
        ir: var TypedExprIr,
        originKind: TypedExprValueDefinitionOriginKind,
        producerSourceIndex: int32,
        sourceLocalNodeIndex: int32,
        declarationSourceLocalRow: int32,
        patternSourceLocalRow: int32,
        typedFunctionIndex: int32,
        definingTypedNodeIndex: int32,
        groupRow: int32,
        definitionOwnership: TypedExprExprClass): int32 =
    if originKind == TypedExprValueDefinitionOriginInvalid ||
       producerSourceIndex < 0 || typedFunctionIndex < 0 ||
       definingTypedNodeIndex < 0 ||
       definingTypedNodeIndex >= ir.nodes2_nodeIndexs.len ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.nodes2_producedValueDefinitionRows,
           definingTypedNodeIndex) != -1:
        panic("typed expr value definition: producer coordinate invalid")
    let parameterOrigin =
        originKind == TypedExprValueDefinitionOriginParameter
    let bindingOrigin =
        originKind == TypedExprValueDefinitionOriginBindingInitializer
    let callResultOrigin =
        originKind == TypedExprValueDefinitionOriginCallResult
    let managedTemporaryOrigin =
        originKind ==
            TypedExprValueDefinitionOriginManagedTemporary
    if (parameterOrigin &&
        (sourceLocalNodeIndex != -1 ||
         declarationSourceLocalRow < 0 ||
         patternSourceLocalRow != -1 || groupRow != -1)) ||
       (bindingOrigin &&
        (sourceLocalNodeIndex < 0 ||
         declarationSourceLocalRow < 0 ||
         patternSourceLocalRow < 0 || groupRow < 0)) ||
       (callResultOrigin &&
        (sourceLocalNodeIndex < 0 ||
         declarationSourceLocalRow != -1 ||
         patternSourceLocalRow != -1 || groupRow != -1)) ||
       (managedTemporaryOrigin &&
        (sourceLocalNodeIndex < 0 ||
         declarationSourceLocalRow != -1 ||
         patternSourceLocalRow != -1 || groupRow != -1)) ||
       (!parameterOrigin && !bindingOrigin && !callResultOrigin &&
        !managedTemporaryOrigin):
        panic("typed expr value definition: origin shape invalid")
    if callResultOrigin &&
       ir.nodes2_opKinds[definingTypedNodeIndex] !=
           TypedExprIrOpCallExpr:
        panic("typed expr value definition: CallResult producer is not CallExpr")
    if managedTemporaryOrigin &&
       (!TypedExprIrOpIsExactManagedTemporaryProducer(
            ir.nodes2_opKinds[definingTypedNodeIndex]) ||
        ir.nodes2_exprClasses[definingTypedNodeIndex] !=
            TypedExprExprOwned ||
        !ir.nodes2_resultTypeManagedFlags[
            definingTypedNodeIndex] ||
        arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_originParserNodeIds,
            definingTypedNodeIndex) != sourceLocalNodeIndex ||
        arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_syntheticOriginKinds,
            definingTypedNodeIndex) !=
            TypedExprSyntheticOriginNone):
        panic("typed expr value definition: managed temporary producer is not exact")
    let ownership = Int32(definitionOwnership)
    let exactTypeId = TypedExprIrNodeStructuralTypeIdAt(
        ir, definingTypedNodeIndex)
    let proofKind = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_resultTypeProofKinds,
        definingTypedNodeIndex)
    if !ir.valueDefinitionTypeArenaBound ||
       ir.exactTypeArena == nil ||
       exactTypeId < 0 ||
       exactTypeId >=
           typearena.TypedExprTypeArenaTypeCount(ir.exactTypeArena) ||
       ownership <= Int32(TypedExprExprUnknown) ||
       ownership > Int32(TypedExprExprUnmanaged) ||
       (!parameterOrigin &&
        ownership !=
            Int32(ir.nodes2_exprClasses[definingTypedNodeIndex])) ||
       proofKind < TypedExprSnapshotTypeProofNone ||
       proofKind > TypedExprSnapshotTypeProofAggregate ||
       (ir.nodes2_resultTypeManagedFlags[definingTypedNodeIndex] &&
        proofKind == TypedExprSnapshotTypeProofNone):
        panic("typed expr value definition: producer lacks exact type or ownership proof")
    let definitionRow = TypedExprValueDefinitionAuthorityCount(ir)
    var borrowOwnerValueDefinitionRow: int32 = -1
    if ir.nodes2_resultTypeManagedFlags[definingTypedNodeIndex] &&
       ownership == Int32(TypedExprExprBorrowed):
        if parameterOrigin:
            borrowOwnerValueDefinitionRow = definitionRow
        else:
            borrowOwnerValueDefinitionRow =
                typedExprIrBorrowOwnerForNodeExact(
                    ir, definingTypedNodeIndex, typedFunctionIndex)
        if borrowOwnerValueDefinitionRow < 0 ||
           borrowOwnerValueDefinitionRow > definitionRow:
            panic("typed expr value definition: borrowed managed producer lacks exact owner value-definition")
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.valueDefinitions_originKinds, Int32(originKind))
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.valueDefinitions_producerSourceIndexes,
        producerSourceIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.valueDefinitions_sourceLocalNodeIndexes,
        sourceLocalNodeIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.valueDefinitions_declarationSourceLocalRows,
        declarationSourceLocalRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.valueDefinitions_patternSourceLocalRows,
        patternSourceLocalRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.valueDefinitions_typedFunctionIndexes,
        typedFunctionIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.valueDefinitions_definingTypedNodeIndexes,
        definingTypedNodeIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.valueDefinitions_exactTypeIds, exactTypeId)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.valueDefinitions_ownerships, ownership)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.valueDefinitions_borrowOwnerValueDefinitionRows,
        borrowOwnerValueDefinitionRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.valueDefinitions_proofKinds, proofKind)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.valueDefinitions_groupRows, groupRow)
    arenamod.ArenaArrayInt32Set(
        ir.arena,
        ir.nodes2_producedValueDefinitionRows,
        definingTypedNodeIndex,
        definitionRow)
    if !TypedExprValueDefinitionAuthorityShapeComplete(ir):
        panic("typed expr value definition: SoA incomplete after append")
    return definitionRow

@borrows
fn TypedExprIrAppendValueDefinitionsForBindingInitializer(
        ir: var TypedExprIr,
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        typedFunctionIndex: int32,
        initializerRootNodeIndex: int32,
        definingTypedNodeIndex: int32) =
    if producerSourceIndex < 0 || typedFunctionIndex < 0 ||
       definingTypedNodeIndex < 0 ||
       definingTypedNodeIndex >= ir.nodes2_nodeIndexs.len ||
       !TypedExprIrNodes2ShapeComplete(ir) ||
       !TypedExprValueDefinitionAuthorityShapeComplete(ir) ||
       !TypedExprValueDefinitionGroupAuthorityShapeComplete(ir):
        panic("typed expr value definition: initializer coordinate invalid")
    var parserProducerSourceIndex: int32
    var bindingPatternRow: int32
    var declarationSourceLocalRow: int32
    var patternSourceLocalRow: int32
    typedExprValueDefinitionLeafCoordinates(
        ir,
        share(tree),
        initializerRootNodeIndex,
        0,
        bindingPatternRow,
        parserProducerSourceIndex,
        declarationSourceLocalRow,
        patternSourceLocalRow)
    let initializerRootSourceLocalNodeIndex =
        parser.ParserValueExprNodeSourceLocalIndexAt(
            tree, initializerRootNodeIndex)
    if initializerRootNodeIndex < 0 ||
       initializerRootNodeIndex >=
           ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len ||
       initializerRootNodeIndex >=
           ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex.len:
        panic("typed expr value definition: initializer root index unavailable")
    let groupCount =
        ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex[
            initializerRootNodeIndex]
    if groupCount != 1:
        panic("typed expr value definition: compound Pattern exact per-binding TypedExpr projection unavailable")
    let groupRow =
        ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex[
            initializerRootNodeIndex]
    let groupAuthorityCount =
        TypedExprValueDefinitionGroupAuthorityCount(ir)
    if bindingPatternRow < 0 ||
       bindingPatternRow >=
           arenamod.ArenaArrayInt32Len(
               ir.arena,
               ir.valueExprTransactionDefinitionGroupRowsByPatternRow) ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
           bindingPatternRow) != groupRow ||
       groupRow < ir.valueExprTransactionDefinitionGroupStart ||
       groupRow >= groupAuthorityCount:
        panic("typed expr value definition: initializer group was not registered")
    if arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_producerSourceIndexes,
           groupRow) != producerSourceIndex ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_parserProducerSourceIndexes,
           groupRow) != parserProducerSourceIndex ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
           groupRow) != initializerRootSourceLocalNodeIndex ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_bindingOffsets,
           groupRow) != 0 ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_bindingCounts,
           groupRow) != 1 ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_typedFunctionIndexes,
           groupRow) != typedFunctionIndex:
        panic("typed expr value definition: initializer group index authority drift")
    if arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_consumedFlags,
           groupRow) != 0:
        panic("typed expr value definition: initializer group consumed twice")
    if arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_declarationSourceLocalRows,
           groupRow) != declarationSourceLocalRow ||
       arenamod.ArenaArrayInt32Get(
           ir.arena,
           ir.valueDefinitionGroups_patternSourceLocalRows,
           groupRow) != patternSourceLocalRow:
        panic("typed expr value definition: registered Pattern coordinate drift")
    let sourceLocalNodeIndex =
        parser.ParserValueExprNodeSourceLocalIndexAt(
            tree, initializerRootNodeIndex)
    # [phaseB-parser] 入口聚合构造占位节点的精确 TypeId 绑定：命名构造
    # 产线的 CallExpr 占位节点无声明坐标可回填 TypeId，而其 resultType
    # 精确等于本源 ParserDeclarationType 的声明名。按 producer + 名称
    # token 唯一命中声明行，经声明行 TypeSyntax root 从 exact TypeArena
    # 取 TypeId（非托管结果），补齐 value definition 的 exact type
    # proof；名称非唯一命中保持 -1 的 fail-closed 语义。
    if ir.nodes2_opKinds[definingTypedNodeIndex] ==
           TypedExprIrOpCallExpr &&
       TypedExprIrNodeStructuralTypeIdAt(ir, definingTypedNodeIndex) < 0 &&
       ir.exactTypeArena != nil &&
       ir.valueDefinitionTypeArenaBound:
        let resultTypeIdIntern =
            ir.nodes2_resultTypeIds[definingTypedNodeIndex]
        var matchedDeclarationRow: int32 = -1
        var matchedDeclarationCount: int32
        for declarationRow in 0..<tree.declarationCount:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationKinds,
                   declarationRow) !=
                   Int32(parser.ParserDeclarationType) ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationProducerSourceIndexes,
                   declarationRow) != producerSourceIndex:
                continue
            let declarationNameToken =
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationNameTokenIndexes,
                    declarationRow)
            let declarationName = parser.ParserValueExprTokenText(
                tree, declarationNameToken)
            if TypedExprIrInternText(ir, declarationName) ==
                   resultTypeIdIntern:
                matchedDeclarationCount = matchedDeclarationCount + 1
                matchedDeclarationRow = declarationRow
        if matchedDeclarationCount == 1 && matchedDeclarationRow >= 0:
            let typeSyntaxRoot =
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationTypeSyntaxRootIndexes,
                    matchedDeclarationRow)
            let constructorTypeId =
                typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                    ir.exactTypeArena, typeSyntaxRoot)
            if constructorTypeId >= 0 &&
               !typearena.TypedExprTypeArenaManagedAt(
                   ir.exactTypeArena, constructorTypeId):
                arenamod.ArenaArrayInt32Set(
                    ir.arena,
                    ir.nodes2_structuralTypeIds,
                    definingTypedNodeIndex,
                    constructorTypeId)
                ir.nodes2_resultTypeSendFlags[definingTypedNodeIndex] =
                    typearena.TypedExprTypeArenaSendAt(
                        ir.exactTypeArena, constructorTypeId)
                ir.nodes2_resultTypeSyncFlags[definingTypedNodeIndex] =
                    typearena.TypedExprTypeArenaSyncAt(
                        ir.exactTypeArena, constructorTypeId)
                arenamod.ArenaArrayInt32Set(
                    ir.arena,
                    ir.nodes2_resultTypeProofKinds,
                    definingTypedNodeIndex,
                    TypedExprSnapshotTypeProofKindForTypeArenaAt(
                        ir.exactTypeArena, constructorTypeId))
    let definitionRow = typedExprIrAppendValueDefinitionExact(
        ir,
        TypedExprValueDefinitionOriginBindingInitializer,
        producerSourceIndex,
        sourceLocalNodeIndex,
        declarationSourceLocalRow,
        patternSourceLocalRow,
        typedFunctionIndex,
        definingTypedNodeIndex,
        groupRow,
        ir.nodes2_exprClasses[definingTypedNodeIndex])
    arenamod.ArenaArrayInt32Set(
        ir.arena,
        ir.valueDefinitionGroups_definitionRows,
        groupRow,
        definitionRow)
    arenamod.ArenaArrayInt32Set(
        ir.arena,
        ir.valueDefinitionGroups_consumedFlags,
        groupRow,
        1)
    if !TypedExprValueDefinitionAuthorityShapeComplete(ir):
        panic("typed expr value definition: SoA incomplete after append")

@borrows
fn TypedExprIrOriginProofStrictValidateInto(ir: TypedExprIr,
                                             err: var str): bool =
    if !TypedExprIrNodes2ShapeComplete(ir):
        err = " typed expr: node origin proof columns are incomplete"
        return false
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        let parserNodeId = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_originParserNodeIds,
            nodeIndex)
        let syntheticKind = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_syntheticOriginKinds,
            nodeIndex)
        let spanAuthority = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_spanAuthorityKinds,
            nodeIndex)
        let parserOrigin = parserNodeId >= 0 &&
            syntheticKind == TypedExprSyntheticOriginNone &&
            spanAuthority == TypedExprSpanAuthorityParserNode
        let syntheticOrigin = parserNodeId == -1 &&
            syntheticKind > TypedExprSyntheticOriginNone &&
            syntheticKind <= TypedExprSyntheticOriginRuntimeIntrinsic &&
            spanAuthority == TypedExprSpanAuthorityNoSource
        if !parserOrigin && !syntheticOrigin:
            err = Fmt" typed expr: node origin proof invalid node={nodeIndex} parser_node={parserNodeId} synthetic={syntheticKind} span_authority={spanAuthority}"
            return false
    err = ""
    return true

@borrows
@borrow_result
fn typedExprIrCallDeclarationOwnerIndex(ir: TypedExprIr): TypedExprBuildIndex =
    # During a frozen metadata session the call declaration rows still live in
    # the sealed canonical index; they move verbatim (row order preserved) into
    # the derived IR index only at close. Nodes appended inside the session
    # window therefore validate against the canonical owner.
    let session = ir.typedExprMetadataSession
    if session != nil && !session.closed && !session.released &&
       session.index != nil && !session.index.released:
        return session.index
    return ir.buildIndex

@borrows
@borrow_result
fn TypedExprIrCallDeclarationBuildIndex(ir: TypedExprIr): TypedExprBuildIndex =
    return typedExprIrCallDeclarationOwnerIndex(ir)

fn TypedExprIrAppendNode(ir: var TypedExprIr, node: TypedExprIrNode) =
    if !TypedExprIrNodes2ShapeComplete(ir):
        panic("typed expr: nodes2 columns incomplete before append")
    if (node.callTarget == "") != (node.callTargetSourcePath == ""):
        panic("typed expr: node call target/source pair is incomplete")
    if node.callTargetSignatureLineNumber < 0 ||
       (node.callTarget == "" && node.callTargetSignatureLineNumber != 0) ||
       (node.callTargetImportc && node.callTargetSignatureLineNumber != 0):
        panic("typed expr: node call declaration identity is invalid")
    if node.opKind != TypedExprIrOpCallExpr &&
       (node.callTarget != "" || node.callTargetSourcePath != "" ||
        node.callTargetSignatureLineNumber != 0 || node.callTargetImportc ||
        node.callKind != TypedExprCallNone ||
        node.callDeclarationIndex != -1):
        panic("typed expr: non-call node carries call authority")
    if node.callKind != TypedExprCallNone &&
       node.callKind != TypedExprCallBuiltin &&
       node.callKind != TypedExprCallResultIntrinsic &&
       node.callKind != TypedExprCallProjection:
        panic("typed expr: node call kind is invalid")
    var originParserNodeId = node.originParserNodeId
    var syntheticOriginKind = node.syntheticOriginKind
    if originParserNodeId < 0 &&
       syntheticOriginKind == TypedExprSyntheticOriginNone &&
       ir.originParserNodeStack.len > 0:
        originParserNodeId = ir.originParserNodeStack[
            ir.originParserNodeStack.len - 1]
    let parserOrigin = originParserNodeId >= 0 &&
        syntheticOriginKind == TypedExprSyntheticOriginNone
    let syntheticOrigin = originParserNodeId == -1 &&
        syntheticOriginKind > TypedExprSyntheticOriginNone &&
        syntheticOriginKind <= TypedExprSyntheticOriginRuntimeIntrinsic
    if !parserOrigin && !syntheticOrigin:
        panic(Fmt"typed expr: node origin proof is missing or contradictory fn={node.functionName} line={node.lineNumber} op={Int32(node.opKind)} parser_node={originParserNodeId} synthetic={syntheticOriginKind} origin_stack={ir.originParserNodeStack.len} surface={node.surfaceText}")
    var spanAuthorityKind = node.spanAuthorityKind
    if parserOrigin && spanAuthorityKind == TypedExprSpanAuthorityNone:
        spanAuthorityKind = TypedExprSpanAuthorityParserNode
    if (parserOrigin &&
        spanAuthorityKind != TypedExprSpanAuthorityParserNode) ||
       (syntheticOrigin &&
        spanAuthorityKind != TypedExprSpanAuthorityNoSource):
        panic("typed expr: node source-span authority is missing or contradictory")
    if node.callDeclarationIndex < -1:
        panic("typed expr: node call declaration row is invalid")
    if node.callDeclarationIndex >= 0:
        if node.callKind != TypedExprCallNone:
            panic("typed expr: declaration CallExpr carries intrinsic kind")
        let declarationOwner = typedExprIrCallDeclarationOwnerIndex(ir)
        if node.opKind != TypedExprIrOpCallExpr || declarationOwner == nil ||
           declarationOwner.released || !declarationOwner.callDeclarationSealed ||
           node.callDeclarationIndex >=
               typedExprBuildIndexCallDeclarationCount(declarationOwner) ||
           node.callDeclarationIndex >=
               declarationOwner.callDeclarationSignatureLineNumbers.len ||
           node.callDeclarationIndex >=
               declarationOwner.callDeclarationKinds.len:
            var diagIndexState = "ok"
            if declarationOwner == nil:
                diagIndexState = "nil"
            elif declarationOwner.released:
                diagIndexState = "released"
            elif !declarationOwner.callDeclarationSealed:
                diagIndexState = "unsealed"
            var diagCount: int32 = -1
            if declarationOwner != nil && !declarationOwner.released:
                diagCount = typedExprBuildIndexCallDeclarationCount(declarationOwner)
            panic(Fmt"typed expr: node call declaration row unavailable row={node.callDeclarationIndex} indexState={diagIndexState} count={diagCount} target={node.callTarget} tsource={node.callTargetSourcePath} sig={node.callTargetSignatureLineNumber} fn={node.functionName} line={node.lineNumber} surface={node.surfaceText}")
        let declarationSource = parser.ParserNormalizePath(
            typedExprBuildIndexCallSourcePath(declarationOwner,
                                              node.callDeclarationIndex))
        # [ia1 alias-family] The canonical identity of a call node's
        # callTarget is the declaration row's registered name.  The
        # targetSymbols column (the @importc C symbol) is a link payload
        # the backend derives at lowering time via
        # TypedExprIrLookupImportcTargetSymbol; it is not node identity.
        # Function rows store name == target symbol, so this comparison
        # is value-identical for every pre-existing shape; only
        # alias-shaped importc rows (declared name != C symbol) align
        # from symbol to name.
        let declarationTarget = typedExprBuildIndexCallName(
            declarationOwner, node.callDeclarationIndex)
        let declarationImportc =
            declarationOwner.callDeclarationKinds[node.callDeclarationIndex] ==
                TypedExprCallDeclarationImportc
        if declarationSource !=
               parser.ParserNormalizePath(node.callTargetSourcePath) ||
           declarationTarget != node.callTarget ||
           declarationOwner.callDeclarationSignatureLineNumbers[
               node.callDeclarationIndex] !=
               node.callTargetSignatureLineNumber ||
           declarationImportc != node.callTargetImportc:
            panic("typed expr: node call declaration row identity drift")
    let funcRefDomain = node.funcRefTargetDomain
    let funcRefDeclarationRow = node.funcRefCallDeclarationRow
    if node.opKind == TypedExprIrOpFuncRef:
        let declarationOwner = typedExprIrCallDeclarationOwnerIndex(ir)
        if funcRefDomain !=
               Int32(TypedExprFuncRefTargetDomainCallDeclaration) ||
           funcRefDeclarationRow < 0 ||
           declarationOwner == nil || declarationOwner.released ||
           !declarationOwner.callDeclarationSealed ||
           funcRefDeclarationRow >=
               typedExprBuildIndexCallDeclarationCount(declarationOwner) ||
           funcRefDeclarationRow >=
               declarationOwner.callDeclarationKinds.len ||
           declarationOwner.callDeclarationKinds[
               funcRefDeclarationRow] !=
               TypedExprCallDeclarationFunction:
            panic("typed expr: FuncRef exact CallDeclaration identity is unavailable")
    elif funcRefDomain != Int32(TypedExprFuncRefTargetDomainNone) ||
         funcRefDeclarationRow != -1:
        panic("typed expr: non-FuncRef node carries function target authority")
    if node.opKind == TypedExprIrOpFieldGet &&
       (node.fieldTypeSourcePath == "" || node.fieldOffsetBytes < 0 ||
        node.fieldSizeBytes <= 0 ||
        node.fieldAlignBytes <= 0 ||
        node.fieldProducerSourceIndex < 0 ||
        node.fieldOrdinal < 0 ||
        node.fieldBuiltinKind <
            Int32(TypedExprLayoutBuiltinNone) ||
        node.fieldBuiltinKind >
            Int32(TypedExprLayoutBuiltinOptional) ||
        ((node.fieldBuiltinKind ==
              Int32(TypedExprLayoutBuiltinNone)) !=
         (node.fieldOwnerDeclarationSourceLocalRow >= 0 &&
          node.fieldDeclarationSourceLocalRow >= 0))):
        panic("typed expr: field node layout authority is incomplete")
    if node.opKind != TypedExprIrOpFieldGet &&
       (node.fieldTypeSourcePath != "" ||
        node.fieldProducerSourceIndex != -1 ||
        node.fieldOwnerDeclarationSourceLocalRow != -1 ||
        node.fieldDeclarationSourceLocalRow != -1 ||
        node.fieldOrdinal != -1 ||
        node.fieldBuiltinKind !=
            Int32(TypedExprLayoutBuiltinNone)):
        panic(Fmt"typed expr: non-field node carries field identity node={node.nodeIndex} op={Int32(node.opKind)} source={node.sourcePath} fn={node.functionName} line={node.lineNumber} field_source={node.fieldTypeSourcePath} producer={node.fieldProducerSourceIndex} owner_row={node.fieldOwnerDeclarationSourceLocalRow} field_row={node.fieldDeclarationSourceLocalRow} ordinal={node.fieldOrdinal} builtin={node.fieldBuiltinKind}")
    if node.opKind == TypedExprIrOpArgLink &&
       (node.operand1NodeIndex < -1 ||
        node.operand1NodeIndex >= ir.nodes2_nodeIndexs.len):
        panic("typed expr: ArgLink next edge must be -1 or a prior node")
    let nodeSourcePathId = TypedExprIrInternText(
        ir, strings.CloneStr(node.sourcePath))
    add(ir.nodes2_sourcePathIds, nodeSourcePathId)
    let nodeFunctionNameId = TypedExprIrInternText(
        ir, strings.CloneStr(node.functionName))
    add(ir.nodes2_functionNameIds, nodeFunctionNameId)
    # 尾块追踪: (sourcePath,functionName) 换属主时记新段首。intern id 整数比对, O(1)。
    if nodeSourcePathId != ir.nodesTailOwnerSourcePathId ||
       nodeFunctionNameId != ir.nodesTailOwnerFunctionNameId ||
       ir.nodes2_sourcePathIds.len <= 1:
        ir.nodesTailOwnerSourcePathId = nodeSourcePathId
        ir.nodesTailOwnerFunctionNameId = nodeFunctionNameId
        ir.nodesTailBlockStartNodeIndex = ir.nodes2_sourcePathIds.len - 1
    if ir.arena.capacityBytes <= 0:
        ir.arena = arenamod.ArenaInitDefault(1048576)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_nodeIndexs, node.nodeIndex)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_lineNumbers, node.lineNumber)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_originParserNodeIds, originParserNodeId)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_syntheticOriginKinds, syntheticOriginKind)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_spanAuthorityKinds, spanAuthorityKind)
    add(ir.nodes2_opKinds, node.opKind)
    let nodeExprClass = typedExprNodeExprClassExact(ir, node)
    if node.exprClass != TypedExprExprUnknown &&
       node.exprClass != nodeExprClass:
        panic(Fmt"typed expr: node expr class producer drift node={node.nodeIndex} caller={TypedExprExprClassText(node.exprClass)} exact={TypedExprExprClassText(nodeExprClass)} surface={node.surfaceText} resultType={node.resultType} fn={node.functionName} line={node.lineNumber}")
    add(ir.nodes2_exprClasses, nodeExprClass)
    let typeProofKind = node.resultTypeProofKind
    let typeManaged = node.resultTypeManaged
    let typeSend = node.resultTypeSend
    let typeSync = node.resultTypeSync
    if typeProofKind < TypedExprSnapshotTypeProofNone ||
       typeProofKind > TypedExprSnapshotTypeProofAggregate ||
       (typeProofKind == TypedExprSnapshotTypeProofNone &&
        (typeManaged || typeSend || typeSync)):
        panic("typed expr: node type proof is contradictory")
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_resultTypeProofKinds, typeProofKind)
    add(ir.nodes2_resultTypeManagedFlags, typeManaged)
    add(ir.nodes2_resultTypeSendFlags, typeSend)
    add(ir.nodes2_resultTypeSyncFlags, typeSync)
    let valueKind =
        typedExprSnapshotValueKindForOp(node.opKind)
    var valueSend = typeSend
    var valueSync = typeSync
    if node.opKind == TypedExprIrOpClosure:
        valueSend = true
        valueSync = true
        for captureOffset in 0..<node.captureValueDefinitionRows.len:
            let definitionRow =
                node.captureValueDefinitionRows[captureOffset]
            if !ir.valueDefinitionTypeArenaBound ||
               definitionRow < 0 ||
               definitionRow >=
                   TypedExprValueDefinitionAuthorityCount(ir):
                panic("typed expr: closure capture value-definition row unavailable")
            let exactTypeId = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_exactTypeIds,
                definitionRow)
            let ownership = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_ownerships,
                definitionRow)
            if exactTypeId < 0 ||
               exactTypeId >=
                   typearena.TypedExprTypeArenaTypeCount(
                       ir.exactTypeArena):
                panic("typed expr: closure capture type identity missing")
            if ownership == Int32(TypedExprExprBorrowed):
                valueSend = false
                valueSync = false
            else:
                valueSend =
                    valueSend &&
                    typearena.TypedExprTypeArenaSendAt(
                        ir.exactTypeArena, exactTypeId)
                valueSync =
                    valueSync &&
                    typearena.TypedExprTypeArenaSyncAt(
                        ir.exactTypeArena, exactTypeId)
    let shareKind =
        typedExprSnapshotShareKindForNode(
            nodeExprClass,
            typeManaged || node.opKind == TypedExprIrOpClosure,
            valueSend,
            valueSync)
    let shareProofKind =
        typedExprSnapshotShareProofKind(shareKind)
    if valueKind == TypedExprSnapshotValueUnknown ||
       shareKind == TypedExprSnapshotShareUnknown ||
       shareProofKind == TypedExprSnapshotValueProofUnknown ||
       (node.opKind != TypedExprIrOpClosure &&
        node.captureValueDefinitionRows.len != 0):
        panic("typed expr: node value/share authority is incomplete")
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_valueKinds, Int32(valueKind))
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_shareKinds, Int32(shareKind))
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_shareProofKinds,
        Int32(shareProofKind))
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_captureStarts,
        ir.captures2_valueDefinitionRows.len)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_captureCounts,
        node.captureValueDefinitionRows.len)
    # CFG liveness is the only legal positive producer. TypedExpr construction
    # records absence until that proof is available.
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_lastUseMoveValueDefIds,
        -1)
    for captureOffset in 0..<node.captureValueDefinitionRows.len:
        let definitionRow =
            node.captureValueDefinitionRows[captureOffset]
        if !ir.valueDefinitionTypeArenaBound ||
           definitionRow < 0 ||
           definitionRow >=
               TypedExprValueDefinitionAuthorityCount(ir):
            panic("typed expr: closure capture value-definition row unavailable")
        for priorOffset in 0..<captureOffset:
            if node.captureValueDefinitionRows[priorOffset] ==
                   definitionRow:
                panic("typed expr: duplicate closure capture value-definition row")
        let exactTypeId = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_exactTypeIds,
            definitionRow)
        let ownership = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_ownerships,
            definitionRow)
        if exactTypeId < 0 ||
           exactTypeId >=
               typearena.TypedExprTypeArenaTypeCount(
                   ir.exactTypeArena) ||
           ownership <= Int32(TypedExprExprUnknown) ||
           ownership > Int32(TypedExprExprUnmanaged):
            panic("typed expr: closure capture value-definition proof missing")
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.captures2_ownerTypedNodeIndexes,
            node.nodeIndex)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.captures2_valueDefinitionRows,
            definitionRow)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.captures2_exactTypeIds,
            exactTypeId)
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.captures2_ownerships,
            ownership)
    if node.resultStructuralTypeId < -1 ||
       (node.resultStructuralTypeId >= 0 &&
        (ir.exactTypeArena == nil ||
         node.resultStructuralTypeId >=
             typearena.TypedExprTypeArenaTypeCount(
                 ir.exactTypeArena))):
        panic("typed expr: node structural TypeId authority invalid")
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_structuralTypeIds,
        node.resultStructuralTypeId)
    let nodeResultTypeId = TypedExprIrInternText(
        ir, strings.CloneStr(node.resultType))
    add(ir.nodes2_resultTypeIds, nodeResultTypeId)
    let nodeSurfaceTextId = TypedExprIrInternText(
        ir, strings.CloneStr(node.surfaceText))
    add(ir.nodes2_surfaceTextIds, nodeSurfaceTextId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_paramSlots, node.paramSlot)
    let nodeParamNameId = TypedExprIrInternText(
        ir, strings.CloneStr(node.paramName))
    add(ir.nodes2_paramNameIds, nodeParamNameId)
    add(ir.nodes2_paramMutableFlags, node.paramMutableFlag)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_operand0NodeIndexs, node.operand0NodeIndex)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_operand1NodeIndexs, node.operand1NodeIndex)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_operand2NodeIndexs, node.operand2NodeIndex)
    let nodeLiteralTextId = TypedExprIrInternText(
        ir, strings.CloneStr(node.literalText))
    add(ir.nodes2_literalTextIds, nodeLiteralTextId)
    add(ir.nodes2_callTargetIds,
        TypedExprIrInternText(
            ir, strings.CloneStr(node.callTarget)))
    add(ir.nodes2_callTargetSourcePathIds,
        TypedExprIrInternText(
            ir, strings.CloneStr(node.callTargetSourcePath)))
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_callTargetSignatureLineNumbers,
        node.callTargetSignatureLineNumber)
    add(ir.nodes2_callTargetImportcs, node.callTargetImportc)
    add(ir.nodes2_callKinds, node.callKind)
    arenamod.ArenaArrayInt32Add(ir.arena,
                                ir.nodes2_callDeclarationIndexes,
                                node.callDeclarationIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_funcRefTargetDomains,
        node.funcRefTargetDomain)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_funcRefCallDeclarationRows,
        node.funcRefCallDeclarationRow)
    add(ir.nodes2_fieldTypeSourcePathIds,
        TypedExprIrInternText(
            ir, strings.CloneStr(node.fieldTypeSourcePath)))
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_fieldOffsetBytes, node.fieldOffsetBytes)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_fieldSizeBytes, node.fieldSizeBytes)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_fieldAlignBytes, node.fieldAlignBytes)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_fieldProducerSourceIndexes,
        node.fieldProducerSourceIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_fieldOwnerDeclarationSourceLocalRows,
        node.fieldOwnerDeclarationSourceLocalRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_fieldDeclarationSourceLocalRows,
        node.fieldDeclarationSourceLocalRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_fieldOrdinals, node.fieldOrdinal)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_fieldBuiltinKinds, node.fieldBuiltinKind)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_elemSizeBytes, node.elemSizeBytes)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_bindingParserNodeIndexes,
        node.bindingParserNodeIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_bindingParserForestNodeIndexes,
        node.bindingParserForestNodeIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_bindingParserProducerSourceIndexes,
        node.bindingParserProducerSourceIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_bindingDeclarationSourceLocalRows,
        node.bindingDeclarationSourceLocalRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_bindingPatternSourceLocalRows,
        node.bindingPatternSourceLocalRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_bindingValueDefinitionRows,
        node.bindingValueDefinitionRow)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_producedValueDefinitionRows,
        -1)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_ownerStatementIndexes,
        -1)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_exactTypeArenaIds, -1)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_ownerProducerSourceIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_ownerDeclarationSourceLocalRows,
        -1)
    arenamod.ArenaArrayInt32Add(
        ir.arena, ir.nodes2_ownershipPremiseKinds, 0)
    let captureCompletionKind =
        node.captureValueDefinitionRows.len == 0 ?
            TypedExprNodeCaptureExactEmpty :
            TypedExprNodeCaptureExactRows
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.nodes2_captureCompletionKinds,
        Int32(captureCompletionKind))
    if !TypedExprIrNodes2ShapeComplete(ir):
        panic("typed expr: nodes2 columns incomplete after append")

@borrows
fn TypedExprIrStatements2ShapeComplete(ir: TypedExprIr): bool =
    let n = ir.statements2_statementIndexs.len
    return ir.statements2_sourcePathIds.len == n &&
           ir.statements2_functionNameIds.len == n &&
           ir.statements2_lineNumbers.len == n &&
           ir.statements2_columnNumbers.len == n &&
           ir.statements2_endLineNumbers.len == n &&
           ir.statements2_endColumnNumbers.len == n &&
           ir.statements2_lexicalScopeIds.len == n &&
           ir.statements2_suiteScopeIds.len == n &&
           ir.statements2_statementOrdinals.len == n &&
           ir.statements2_lexicalOrdinals.len == n &&
           ir.statements2_deferOwnerStatementOrdinals.len == n &&
           ir.statements2_lineIndents.len == n &&
           ir.statements2_enclosingIfLineNumbers.len == n &&
           ir.statements2_enclosingIfConditionTextIds.len == n &&
           ir.statements2_exprIdIds.len == n &&
           ir.statements2_kinds.len == n &&
           ir.statements2_callKinds.len == n &&
           ir.statements2_detailKinds.len == n &&
           ir.statements2_surfaceTextIds.len == n &&
           ir.statements2_bindingNameIds.len == n &&
           ir.statements2_resultTypeIds.len == n &&
           ir.statements2_conditionKinds.len == n &&
           ir.statements2_conditionLhsTextIds.len == n &&
           ir.statements2_conditionRhsTextIds.len == n &&
           ir.statements2_conditionLiteralTextIds.len == n &&
           ir.statements2_assignRootNameIds.len == n &&
           ir.statements2_assignRootTypeIds.len == n &&
           ir.statements2_assignRootSourcePathIds.len == n &&
           ir.statements2_assignRootGlobalFlags.len == n &&
           ir.statements2_assignPlaceKinds.len == n &&
           ir.statements2_assignFieldNameIds.len == n &&
           ir.statements2_assignFieldTypeIds.len == n &&
           ir.statements2_assignFieldOffsetBytes.len == n &&
           ir.statements2_assignFieldSizeBytes.len == n &&
           ir.statements2_assignFieldAlignBytes.len == n &&
           ir.statements2_assignValueRootNameIds.len == n &&
           ir.statements2_assignValueRootTypeIds.len == n &&
           ir.statements2_assignValueFieldNameIds.len == n &&
           ir.statements2_assignValueFieldTypeIds.len == n &&
           ir.statements2_assignValueFieldOffsetBytes.len == n &&
           ir.statements2_assignValueFieldSizeBytes.len == n &&
           ir.statements2_assignValueFieldAlignBytes.len == n &&
           ir.statements2_assignValueOpKinds.len == n &&
           ir.statements2_assignValueLhsTextIds.len == n &&
           ir.statements2_assignValueRhsTextIds.len == n &&
           ir.statements2_assignValueRhsConsts.len == n &&
           ir.statements2_assignValueRhsHasConsts.len == n &&
           ir.statements2_callQualifierIds.len == n &&
           ir.statements2_callCalleeIds.len == n &&
           ir.statements2_callTargetIds.len == n &&
           ir.statements2_callTargetSourcePathIds.len == n &&
           ir.statements2_callTargetSignatureLineNumbers.len == n &&
           ir.statements2_callTargetImportcs.len == n &&
           ir.statements2_callArgCounts.len == n &&
           ir.statements2_callArgsTextIds.len == n &&
           ir.statements2_callArgTypesTextIds.len == n &&
           ir.statements2_valueExprCallNodeIndexes.len == n &&
           ir.statements2_valueExprArgRootStarts.len == n &&
           ir.statements2_valueExprArgRootCounts.len == n &&
           ir.statements2_valueExprRootNodeIndexes.len == n &&
           ir.statements2_valueExprSpanStarts.len == n &&
           ir.statements2_valueExprSpanEnds.len == n &&
           ir.statements2_valueExprStatementRoles.len == n &&
           ir.statements2_callArgNodeStarts.len == n &&
           ir.statements2_callArgNodeCounts.len == n &&
           ir.statements2_rhsNodeIndexs.len == n &&
           ir.statements2_rhsBailReasons.len == n &&
           ir.statements2_callSurfaceKinds.len == n &&
           ir.statements2_forStartNodeIndexs.len == n &&
           ir.statements2_assignLvalueNodeIndexs.len == n &&
           ir.statements2_assignIndexNodeIndexs.len == n &&
           ir.statements2_bindingTargetDefinitionRows.len == n &&
           ir.statements2_loweringModes.len == n &&
           ir.statements2_returnKinds.len == n &&
           ir.statements2_returnRoots.len == n

@borrows
fn typedExprIrClaimStatementNodeOwnersExact(
        ir: var TypedExprIr,
        stmt: TypedExprIrStatement,
        statementIndex: int32) =
    var pending: int32[]
    if stmt.rhsNodeIndex >= 0:
        add(pending, stmt.rhsNodeIndex)
    # valueExprRootNodeIndex/valueExprCallNodeIndex are physical rows in the
    # currently borrowed parser forest, not TypedIR node indexes.
    if stmt.callArgNodeStart >= 0:
        add(pending, stmt.callArgNodeStart)
    if stmt.forStartNodeIndex >= 0:
        add(pending, stmt.forStartNodeIndex)
    if stmt.assignLvalueNodeIndex >= 0:
        add(pending, stmt.assignLvalueNodeIndex)
    if stmt.assignIndexNodeIndex >= 0:
        add(pending, stmt.assignIndexNodeIndex)
    while pending.len > 0:
        let nodeIndex = pending[pending.len - 1]
        pending.len = pending.len - 1
        if nodeIndex < 0 ||
           nodeIndex >= ir.nodes2_nodeIndexs.len:
            panic("typed expr: statement owner root escapes node arena")
        let nodeSourceResult =
            langintern.LookupIntern(
                ir.internPool, ir.nodes2_sourcePathIds[nodeIndex])
        let nodeFunctionResult =
            langintern.LookupIntern(
                ir.internPool, ir.nodes2_functionNameIds[nodeIndex])
        if !IsOk(nodeSourceResult) ||
           !IsOk(nodeFunctionResult) ||
           Value(nodeSourceResult) != stmt.sourcePath ||
           Value(nodeFunctionResult) != stmt.functionName:
            var actualSource = "<invalid>"
            if IsOk(nodeSourceResult):
                actualSource = Value(nodeSourceResult)
            var actualFunction = "<invalid>"
            if IsOk(nodeFunctionResult):
                actualFunction = Value(nodeFunctionResult)
            panic(Fmt"typed expr: statement owner crosses function identity statement={statementIndex} node={nodeIndex} expected_source={stmt.sourcePath} expected_function={stmt.functionName} actual_source={actualSource} actual_function={actualFunction} rhs={stmt.rhsNodeIndex} root={stmt.valueExprRootNodeIndex}")
        let existingOwner = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerStatementIndexes,
            nodeIndex)
        if existingOwner == statementIndex:
            continue
        if existingOwner != -1:
            panic("typed expr: expression node belongs to two statements")
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.nodes2_ownerStatementIndexes,
            nodeIndex,
            statementIndex)
        let operand0 = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand0NodeIndexs, nodeIndex)
        let operand1 = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand1NodeIndexs, nodeIndex)
        let operand2 = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand2NodeIndexs, nodeIndex)
        if operand0 >= 0:
            add(pending, operand0)
        if operand1 >= 0:
            add(pending, operand1)
        if operand2 >= 0:
            add(pending, operand2)
    seqs.FreeSeq(pending)

fn TypedExprIrAppendStatement(ir: var TypedExprIr, stmt: TypedExprIrStatement) =
    if !TypedExprIrStatements2ShapeComplete(ir):
        panic("typed expr: statements2 columns incomplete before append")
    if stmt.kind == TypedExprIrStmtAssign:
        if stmt.assignLvalueNodeIndex < 0 ||
           stmt.assignLvalueNodeIndex >= ir.nodes2_nodeIndexs.len ||
           !TypedExprIrNodeIsWritableLvalue(
               ir, stmt.assignLvalueNodeIndex):
            panic("typed expr: assign statement has no exact writable lvalue authority")
    elif stmt.assignLvalueNodeIndex != -1:
        panic("typed expr: non-assign statement carries lvalue authority")
    if (stmt.callTarget == "") != (stmt.callTargetSourcePath == "") ||
       (stmt.callTargetImportc && stmt.callTarget == ""):
        panic("typed expr: statement call target/source authority incomplete")
    if stmt.callTargetSignatureLineNumber < 0 ||
       (stmt.callTarget == "" &&
        stmt.callTargetSignatureLineNumber != 0) ||
       (stmt.callTargetImportc &&
        stmt.callTargetSignatureLineNumber != 0):
        panic("typed expr: statement call declaration identity invalid")
    var rhsIsDirectCall = false
    if stmt.rhsNodeIndex >= 0:
        if stmt.rhsNodeIndex >= ir.nodes2_nodeIndexs.len:
            panic("typed expr: statement rhs node out of bounds")
        rhsIsDirectCall =
            ir.nodes2_opKinds[stmt.rhsNodeIndex] == TypedExprIrOpCallExpr
    if rhsIsDirectCall:
        let nodeTargetResult = langintern.LookupIntern(
            ir.internPool, ir.nodes2_callTargetIds[stmt.rhsNodeIndex])
        let nodeSourceResult = langintern.LookupIntern(
            ir.internPool,
            ir.nodes2_callTargetSourcePathIds[stmt.rhsNodeIndex])
        if !IsOk(nodeTargetResult) || !IsOk(nodeSourceResult) ||
           stmt.callTarget != Value(nodeTargetResult) ||
           stmt.callTargetSourcePath != Value(nodeSourceResult) ||
           stmt.callTargetSignatureLineNumber !=
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_callTargetSignatureLineNumbers,
                   stmt.rhsNodeIndex) ||
           stmt.callTargetImportc !=
               ir.nodes2_callTargetImportcs[stmt.rhsNodeIndex]:
            var diagStmtTarget = "<none>"
            if IsOk(nodeTargetResult):
                diagStmtTarget = Value(nodeTargetResult)
            var diagStmtSource = "<none>"
            if IsOk(nodeSourceResult):
                diagStmtSource = Value(nodeSourceResult)
            panic(Fmt"typed expr: statement/direct-call node authority differs kind={stmt.kind} line={stmt.lineNumber} surface={stmt.surfaceText} stmtTarget={stmt.callTarget} nodeTarget={diagStmtTarget} nodeSource={diagStmtSource} rhsNode={stmt.rhsNodeIndex}")
    elif (stmt.kind == TypedExprIrStmtLocalDecl ||
          stmt.kind == TypedExprIrStmtAssign ||
          stmt.kind == TypedExprIrStmtReturn) &&
         (stmt.callTarget != "" || stmt.callTargetSourcePath != "" ||
          stmt.callTargetSignatureLineNumber != 0 ||
          stmt.callTargetImportc):
        panic("typed expr: non-call value statement carries direct call authority")
    if stmt.statementIndex != ir.statements2_statementIndexs.len:
        panic("typed expr: statement row identity is not dense")
    typedExprIrClaimStatementNodeOwnersExact(
        ir, stmt, stmt.statementIndex)
    let stmtSourcePathId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.sourcePath))
    add(ir.statements2_sourcePathIds, stmtSourcePathId)
    let stmtFunctionNameId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.functionName))
    add(ir.statements2_functionNameIds, stmtFunctionNameId)
    if ir.arena.capacityBytes <= 0:
        ir.arena = arenamod.ArenaInitDefault(1048576)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_statementIndexs, stmt.statementIndex)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_lineNumbers, stmt.lineNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_columnNumbers, stmt.columnNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_endLineNumbers, stmt.endLineNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_endColumnNumbers, stmt.endColumnNumber)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_lexicalScopeIds, stmt.lexicalScopeId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_suiteScopeIds, stmt.suiteScopeId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_statementOrdinals, stmt.statementOrdinal)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_lexicalOrdinals, stmt.lexicalOrdinal)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_deferOwnerStatementOrdinals, stmt.deferOwnerStatementOrdinal)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_lineIndents, stmt.lineIndent)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_enclosingIfLineNumbers, stmt.enclosingIfLineNumber)
    let stmtEnclosingIfConditionTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.enclosingIfConditionText))
    add(ir.statements2_enclosingIfConditionTextIds, stmtEnclosingIfConditionTextId)
    let stmtExprIdId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.exprId))
    add(ir.statements2_exprIdIds, stmtExprIdId)
    add(ir.statements2_kinds, stmt.kind)
    add(ir.statements2_callKinds, stmt.callKind)
    add(ir.statements2_detailKinds, stmt.detailKind)
    let stmtSurfaceTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.surfaceText))
    add(ir.statements2_surfaceTextIds, stmtSurfaceTextId)
    let stmtBindingNameId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.bindingName))
    add(ir.statements2_bindingNameIds, stmtBindingNameId)
    let stmtResultTypeId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.resultType))
    add(ir.statements2_resultTypeIds, stmtResultTypeId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_conditionKinds, stmt.conditionKind)
    let stmtConditionLhsTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.conditionLhsText))
    add(ir.statements2_conditionLhsTextIds, stmtConditionLhsTextId)
    let stmtConditionRhsTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.conditionRhsText))
    add(ir.statements2_conditionRhsTextIds, stmtConditionRhsTextId)
    let stmtConditionLiteralTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.conditionLiteralText))
    add(ir.statements2_conditionLiteralTextIds, stmtConditionLiteralTextId)
    let stmtAssignRootNameId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignRootName))
    add(ir.statements2_assignRootNameIds, stmtAssignRootNameId)
    let stmtAssignRootTypeId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignRootType))
    add(ir.statements2_assignRootTypeIds, stmtAssignRootTypeId)
    let stmtAssignRootSourcePathId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignRootSourcePath))
    add(ir.statements2_assignRootSourcePathIds, stmtAssignRootSourcePathId)
    add(ir.statements2_assignRootGlobalFlags, stmt.assignRootGlobalFlag)
    add(ir.statements2_assignPlaceKinds, stmt.assignPlaceKind)
    let stmtAssignFieldNameId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignFieldName))
    add(ir.statements2_assignFieldNameIds, stmtAssignFieldNameId)
    let stmtAssignFieldTypeId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignFieldType))
    add(ir.statements2_assignFieldTypeIds, stmtAssignFieldTypeId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignFieldOffsetBytes, stmt.assignFieldOffsetBytes)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignFieldSizeBytes, stmt.assignFieldSizeBytes)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignFieldAlignBytes, stmt.assignFieldAlignBytes)
    let stmtAssignValueRootNameId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignValueRootName))
    add(ir.statements2_assignValueRootNameIds, stmtAssignValueRootNameId)
    let stmtAssignValueRootTypeId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignValueRootType))
    add(ir.statements2_assignValueRootTypeIds, stmtAssignValueRootTypeId)
    let stmtAssignValueFieldNameId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignValueFieldName))
    add(ir.statements2_assignValueFieldNameIds, stmtAssignValueFieldNameId)
    let stmtAssignValueFieldTypeId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignValueFieldType))
    add(ir.statements2_assignValueFieldTypeIds, stmtAssignValueFieldTypeId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignValueFieldOffsetBytes, stmt.assignValueFieldOffsetBytes)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignValueFieldSizeBytes, stmt.assignValueFieldSizeBytes)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignValueFieldAlignBytes, stmt.assignValueFieldAlignBytes)
    add(ir.statements2_assignValueOpKinds, stmt.assignValueOpKind)
    let stmtAssignValueLhsTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignValueLhsText))
    add(ir.statements2_assignValueLhsTextIds, stmtAssignValueLhsTextId)
    let stmtAssignValueRhsTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.assignValueRhsText))
    add(ir.statements2_assignValueRhsTextIds, stmtAssignValueRhsTextId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignValueRhsConsts, stmt.assignValueRhsConst)
    add(ir.statements2_assignValueRhsHasConsts, stmt.assignValueRhsHasConst)
    let stmtCallQualifierId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.callQualifier))
    add(ir.statements2_callQualifierIds, stmtCallQualifierId)
    let stmtCallCalleeId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.callCallee))
    add(ir.statements2_callCalleeIds, stmtCallCalleeId)
    let stmtCallTargetId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.callTarget))
    add(ir.statements2_callTargetIds, stmtCallTargetId)
    let stmtCallTargetSourcePathId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.callTargetSourcePath))
    add(ir.statements2_callTargetSourcePathIds, stmtCallTargetSourcePathId)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.statements2_callTargetSignatureLineNumbers,
        stmt.callTargetSignatureLineNumber)
    add(ir.statements2_callTargetImportcs, stmt.callTargetImportc)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_callArgCounts, stmt.callArgCount)
    let stmtCallArgsTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.callArgsText))
    add(ir.statements2_callArgsTextIds, stmtCallArgsTextId)
    let stmtCallArgTypesTextId = TypedExprIrInternText(
        ir, strings.CloneStr(stmt.callArgTypesText))
    add(ir.statements2_callArgTypesTextIds, stmtCallArgTypesTextId)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_valueExprCallNodeIndexes, stmt.valueExprCallNodeIndex)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_valueExprArgRootStarts, stmt.valueExprArgRootStart)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_valueExprArgRootCounts, stmt.valueExprArgRootCount)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_valueExprRootNodeIndexes, stmt.valueExprRootNodeIndex)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_valueExprSpanStarts, stmt.valueExprSpanStart)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_valueExprSpanEnds, stmt.valueExprSpanEnd)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_valueExprStatementRoles, Int32(stmt.valueExprStatementRole))
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_callArgNodeStarts, stmt.callArgNodeStart)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_callArgNodeCounts, stmt.callArgNodeCount)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_rhsNodeIndexs, stmt.rhsNodeIndex)
    add(ir.statements2_rhsBailReasons, stmt.rhsBailReason)
    add(ir.statements2_callSurfaceKinds, stmt.callSurfaceKind)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_forStartNodeIndexs, stmt.forStartNodeIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.statements2_assignLvalueNodeIndexs,
        stmt.assignLvalueNodeIndex)
    arenamod.ArenaArrayInt32Add(ir.arena, ir.statements2_assignIndexNodeIndexs, stmt.assignIndexNodeIndex)
    arenamod.ArenaArrayInt32Add(
        ir.arena,
        ir.statements2_bindingTargetDefinitionRows,
        stmt.bindingTargetDefinitionRow)
    add(ir.statements2_loweringModes, stmt.loweringMode)
    add(ir.statements2_returnKinds, stmt.returnKind)
    add(ir.statements2_returnRoots, stmt.returnRoot)
    if !TypedExprIrStatements2ShapeComplete(ir):
        panic("typed expr: statements2 columns incomplete after append")
    if TypedExprIrRhsNodeTraceEnabled():
        # P1 consumer expand: 4-case → 15-case label dispatch via helper.
        # 暗协议 30 站 fall-back 真根因写 trace; env-gate stderr only, 0
        # 控制流改动.  Frontend/postmortem 凭 label 区分 ctor-fail /
        # target missing / ambiguous / indexed-member / receiver-chain /
        # tail-leaf 五大根因簇.
        let reasonLabel = TypedExprIrRhsBailReasonLabel(stmt.rhsBailReason)
        os.WriteLine(os.Get_stderr(),
                     Fmt"phase=rhs_bail_reason_append fn={stmt.functionName} line={stmt.lineNumber} reason={int32(stmt.rhsBailReason)} label={reasonLabel}")

@borrows
fn TypedExprIrStatementAt(ir: TypedExprIr,
                             statementIndex: int32): TypedExprIrStatement =
    if !TypedExprIrStatements2ShapeComplete(ir):
        panic("typed expr: statements2 columns incomplete at read")
    if statementIndex < 0 || statementIndex >= ir.statements2_statementIndexs.len:
        panic("typed expr: statement index out of range")
    let sourcePath = Value(langintern.LookupIntern(ir.internPool, ir.statements2_sourcePathIds[statementIndex]))
    let functionName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_functionNameIds[statementIndex]))
    let enclosingIfConditionText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_enclosingIfConditionTextIds[statementIndex]))
    let exprId = Value(langintern.LookupIntern(ir.internPool, ir.statements2_exprIdIds[statementIndex]))
    let surfaceText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_surfaceTextIds[statementIndex]))
    let bindingName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_bindingNameIds[statementIndex]))
    let resultType = Value(langintern.LookupIntern(ir.internPool, ir.statements2_resultTypeIds[statementIndex]))
    let conditionLhsText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_conditionLhsTextIds[statementIndex]))
    let conditionRhsText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_conditionRhsTextIds[statementIndex]))
    let conditionLiteralText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_conditionLiteralTextIds[statementIndex]))
    let assignRootName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignRootNameIds[statementIndex]))
    let assignRootType = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignRootTypeIds[statementIndex]))
    let assignRootSourcePath = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignRootSourcePathIds[statementIndex]))
    let assignFieldName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignFieldNameIds[statementIndex]))
    let assignFieldType = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignFieldTypeIds[statementIndex]))
    let assignValueRootName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignValueRootNameIds[statementIndex]))
    let assignValueRootType = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignValueRootTypeIds[statementIndex]))
    let assignValueFieldName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignValueFieldNameIds[statementIndex]))
    let assignValueFieldType = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignValueFieldTypeIds[statementIndex]))
    let assignValueLhsText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignValueLhsTextIds[statementIndex]))
    let assignValueRhsText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_assignValueRhsTextIds[statementIndex]))
    let callQualifier = Value(langintern.LookupIntern(ir.internPool, ir.statements2_callQualifierIds[statementIndex]))
    let callCallee = Value(langintern.LookupIntern(ir.internPool, ir.statements2_callCalleeIds[statementIndex]))
    let callTarget = Value(langintern.LookupIntern(ir.internPool, ir.statements2_callTargetIds[statementIndex]))
    let callTargetSourcePath = Value(langintern.LookupIntern(ir.internPool, ir.statements2_callTargetSourcePathIds[statementIndex]))
    let callArgsText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_callArgsTextIds[statementIndex]))
    let callArgTypesText = Value(langintern.LookupIntern(ir.internPool, ir.statements2_callArgTypesTextIds[statementIndex]))
    let statementIndexValue = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_statementIndexs, statementIndex)
    let lineNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, statementIndex)
    let columnNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_columnNumbers, statementIndex)
    let endLineNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_endLineNumbers, statementIndex)
    let endColumnNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_endColumnNumbers, statementIndex)
    let lexicalScopeId = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lexicalScopeIds, statementIndex)
    let suiteScopeId = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_suiteScopeIds, statementIndex)
    let statementOrdinal = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_statementOrdinals, statementIndex)
    let lexicalOrdinal = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lexicalOrdinals, statementIndex)
    let deferOwnerStatementOrdinal = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_deferOwnerStatementOrdinals, statementIndex)
    let lineIndent = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineIndents, statementIndex)
    let enclosingIfLineNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_enclosingIfLineNumbers, statementIndex)
    let conditionKind = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_conditionKinds, statementIndex)
    let assignFieldOffsetBytes = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignFieldOffsetBytes, statementIndex)
    let assignFieldSizeBytes = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignFieldSizeBytes, statementIndex)
    let assignFieldAlignBytes = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignFieldAlignBytes, statementIndex)
    let assignValueFieldOffsetBytes = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueFieldOffsetBytes, statementIndex)
    let assignValueFieldSizeBytes = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueFieldSizeBytes, statementIndex)
    let assignValueFieldAlignBytes = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueFieldAlignBytes, statementIndex)
    let assignValueRhsConst = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueRhsConsts, statementIndex)
    let callTargetSignatureLineNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_callTargetSignatureLineNumbers, statementIndex)
    let callArgCount = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_callArgCounts, statementIndex)
    let valueExprCallNodeIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_valueExprCallNodeIndexes, statementIndex)
    let valueExprArgRootStart = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_valueExprArgRootStarts, statementIndex)
    let valueExprArgRootCount = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_valueExprArgRootCounts, statementIndex)
    let valueExprRootNodeIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_valueExprRootNodeIndexes, statementIndex)
    let valueExprSpanStart = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_valueExprSpanStarts, statementIndex)
    let valueExprSpanEnd = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_valueExprSpanEnds, statementIndex)
    let valueExprStatementRoleRaw = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_valueExprStatementRoles, statementIndex)
    let valueExprStatementRole = parser.ParserValueExprStatementRole(valueExprStatementRoleRaw)
    let callArgNodeStart = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_callArgNodeStarts, statementIndex)
    let callArgNodeCount = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_callArgNodeCounts, statementIndex)
    let rhsNodeIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_rhsNodeIndexs, statementIndex)
    let forStartNodeIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_forStartNodeIndexs, statementIndex)
    let assignLvalueNodeIndex = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.statements2_assignLvalueNodeIndexs,
        statementIndex)
    let assignIndexNodeIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignIndexNodeIndexs, statementIndex)
    let bindingTargetDefinitionRow = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.statements2_bindingTargetDefinitionRows,
        statementIndex)
    let kind = ir.statements2_kinds[statementIndex]
    let callKind = ir.statements2_callKinds[statementIndex]
    let detailKind = ir.statements2_detailKinds[statementIndex]
    let assignRootGlobalFlag = ir.statements2_assignRootGlobalFlags[statementIndex]
    let assignPlaceKind = ir.statements2_assignPlaceKinds[statementIndex]
    let assignValueOpKind = ir.statements2_assignValueOpKinds[statementIndex]
    let assignValueRhsHasConst = ir.statements2_assignValueRhsHasConsts[statementIndex]
    let callTargetImportc = ir.statements2_callTargetImportcs[statementIndex]
    let rhsBailReason = ir.statements2_rhsBailReasons[statementIndex]
    let callSurfaceKind = ir.statements2_callSurfaceKinds[statementIndex]
    let loweringMode = ir.statements2_loweringModes[statementIndex]
    let returnKind = ir.statements2_returnKinds[statementIndex]
    let returnRoot = ir.statements2_returnRoots[statementIndex]
    return TypedExprIrStatement(
        sourcePath: sourcePath,
        functionName: functionName,
        statementIndex: statementIndexValue,
        lineNumber: lineNumber,
        columnNumber: columnNumber,
        endLineNumber: endLineNumber,
        endColumnNumber: endColumnNumber,
        lexicalScopeId: lexicalScopeId,
        suiteScopeId: suiteScopeId,
        statementOrdinal: statementOrdinal,
        lexicalOrdinal: lexicalOrdinal,
        deferOwnerStatementOrdinal: deferOwnerStatementOrdinal,
        lineIndent: lineIndent,
        enclosingIfLineNumber: enclosingIfLineNumber,
        enclosingIfConditionText: enclosingIfConditionText,
        exprId: exprId,
        kind: kind,
        callKind: callKind,
        detailKind: detailKind,
        surfaceText: surfaceText,
        bindingName: bindingName,
        resultType: resultType,
        conditionKind: conditionKind,
        conditionLhsText: conditionLhsText,
        conditionRhsText: conditionRhsText,
        conditionLiteralText: conditionLiteralText,
        assignRootName: assignRootName,
        assignRootType: assignRootType,
        assignRootSourcePath: assignRootSourcePath,
        assignRootGlobalFlag: assignRootGlobalFlag,
        assignPlaceKind: assignPlaceKind,
        assignFieldName: assignFieldName,
        assignFieldType: assignFieldType,
        assignFieldOffsetBytes: assignFieldOffsetBytes,
        assignFieldSizeBytes: assignFieldSizeBytes,
        assignFieldAlignBytes: assignFieldAlignBytes,
        assignValueRootName: assignValueRootName,
        assignValueRootType: assignValueRootType,
        assignValueFieldName: assignValueFieldName,
        assignValueFieldType: assignValueFieldType,
        assignValueFieldOffsetBytes: assignValueFieldOffsetBytes,
        assignValueFieldSizeBytes: assignValueFieldSizeBytes,
        assignValueFieldAlignBytes: assignValueFieldAlignBytes,
        assignValueOpKind: assignValueOpKind,
        assignValueLhsText: assignValueLhsText,
        assignValueRhsText: assignValueRhsText,
        assignValueRhsConst: assignValueRhsConst,
        assignValueRhsHasConst: assignValueRhsHasConst,
        callQualifier: callQualifier,
        callCallee: callCallee,
        callTarget: callTarget,
        callTargetSourcePath: callTargetSourcePath,
        callTargetSignatureLineNumber: callTargetSignatureLineNumber,
        callTargetImportc: callTargetImportc,
        callArgCount: callArgCount,
        callArgsText: callArgsText,
        callArgTypesText: callArgTypesText,
        valueExprCallNodeIndex: valueExprCallNodeIndex,
        valueExprArgRootStart: valueExprArgRootStart,
        valueExprArgRootCount: valueExprArgRootCount,
        valueExprRootNodeIndex: valueExprRootNodeIndex,
        valueExprSpanStart: valueExprSpanStart,
        valueExprSpanEnd: valueExprSpanEnd,
        valueExprStatementRole: valueExprStatementRole,
        callArgNodeStart: callArgNodeStart,
        callArgNodeCount: callArgNodeCount,
        rhsNodeIndex: rhsNodeIndex,
        rhsBailReason: rhsBailReason,
        callSurfaceKind: callSurfaceKind,
        forStartNodeIndex: forStartNodeIndex,
        assignLvalueNodeIndex: assignLvalueNodeIndex,
        assignIndexNodeIndex: assignIndexNodeIndex,
        bindingTargetDefinitionRow: bindingTargetDefinitionRow,
        loweringMode: loweringMode,
        returnKind: returnKind,
        returnRoot: returnRoot
    )

fn TypedExprIrBeginValueExprBorrow(
        ir: var TypedExprIr,
        exprLayer: var parser.NormalizedExprLayer) =
    if ir.valueExprTree != nil || ir.valueExprTreeBorrowLease:
        panic("typed expr: nested parser value-tree transaction")
    if exprLayer.valueExprTree == nil:
        return
    var originErr: str
    if !exprLayer.valueExprTree.structuralValidationPassed &&
       (!parser.ParserValueExprTreeNodeOriginsStrictValidateInto(
            exprLayer.valueExprTree, originErr) ||
        !parser.ParserValueExprTreeStatementRootsStrictValidateInto(
            exprLayer.valueExprTree, originErr)):
        panic(Fmt"typed expr: parser node/root authority invalid: {originErr}")
    ir.valueExprTree = parser.ParserValueExprTreeBorrow(
        exprLayer.valueExprTree)
    ir.valueExprTreeBorrowLease = true
    ir.valueExprTransactionNodeStart = ir.nodes2_nodeIndexs.len
    ir.valueExprTransactionParserProducerSourceIndex = -1
    ir.valueExprTransactionProducerSourceIndex = -1
    ir.valueExprTransactionDefinitionGroupStart =
        TypedExprValueDefinitionGroupAuthorityCount(ir)
    ir.valueExprTransactionDefinitionGroupRootNodeIndexes = []
    ir.valueExprCurrentParamDefinitionNodeIndexes = []
    ir.valueExprCurrentParamValueDefinitionRows = []
    ir.valueExprCurrentParserFunctionRow = -1
    setLen(
        ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex,
        parser.ParserValueExprTreeNodeCount(ir.valueExprTree))
    setLen(
        ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex,
        parser.ParserValueExprTreeNodeCount(ir.valueExprTree))
    for nodeIndex in 0..<ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len:
        ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex[
            nodeIndex] = -1
        ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex[
            nodeIndex] = 0
    if ir.arena.capacityBytes <= 0:
        ir.arena = arenamod.ArenaInitDefault(1048576)
    ir.valueExprTransactionDefinitionGroupRowsByPatternRow.len = 0
    for patternRow in 0..<ir.valueExprTree.patternCount:
        arenamod.ArenaArrayInt32Add(
            ir.arena,
            ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
            -1)
    typedExprIrBuildParameterOrdinalAuthority(
        ir, ir.valueExprTree)
    typedExprIrBuildValueDefinitionPatternAuthority(
        ir, ir.valueExprTree)

fn TypedExprIrSetValueDefinitionProducerSourceIndex(
        ir: var TypedExprIr,
        parserProducerSourceIndex: int32,
        producerSourceIndex: int32) =
    if !ir.valueExprTreeBorrowLease || ir.valueExprTree == nil ||
       parserProducerSourceIndex < 0 ||
       parserProducerSourceIndex >= ir.valueExprTree.producerSourceCount ||
       producerSourceIndex < 0 ||
       (ir.exactLayoutIndexSourceStarts.len > 0 &&
        producerSourceIndex >= ir.exactLayoutIndexSourceStarts.len - 1):
        panic("typed expr value definition: source transaction invalid")
    ir.valueExprTransactionParserProducerSourceIndex =
        parserProducerSourceIndex
    ir.valueExprTransactionProducerSourceIndex = producerSourceIndex

fn TypedExprIrPrepareValueExprCallMetadata(
        ir: var TypedExprIr,
        facts: var TypedExprFactTable) =
    # Prepare is the common transaction entry even for a nil/empty parser
    # tree. Do not rely on aggregate field defaults for this sentinel: the
    # zero-function metadata-only path has no Begin/End borrow pair.
    ir.valueExprTransactionParserProducerSourceIndex = -1
    ir.valueExprTransactionProducerSourceIndex = -1
    ir.valueExprCallMetaResultTypeIds = []
    ir.valueExprCallMetaOriginParserNodeIds = []
    if ir.internPool == nil:
        ir.internPool = langintern.InternPoolNew()
    let nodeCount = parser.ParserValueExprTreeNodeCount(ir.valueExprTree)
    setLen(ir.valueExprCallMetaResultTypeIds, nodeCount)
    setLen(ir.valueExprCallMetaOriginParserNodeIds, nodeCount)
    for nodeIndex in 0..<nodeCount:
        ir.valueExprCallMetaResultTypeIds[nodeIndex] =
            langintern.InvalidInternId()
        ir.valueExprCallMetaOriginParserNodeIds[nodeIndex] = -1
    for factIndex in 0..<facts.count:
        let fact = TypedExprFactAt(facts, factIndex)
        if fact.valueExprCallNodeIndex < 0:
            continue
        if fact.valueExprCallNodeIndex >= nodeCount:
            panic("typed expr: value-call fact node index out of bounds")
        if ir.valueExprCallMetaResultTypeIds[
               fact.valueExprCallNodeIndex] >= 0:
            panic("typed expr: duplicate value-call fact node index")
        if fact.typeText == "":
            panic("typed expr: value-call fact has no result type")
        if fact.originParserNodeId < 0:
            panic("typed expr: value-call fact has no source-local parser identity")
        ir.valueExprCallMetaResultTypeIds[fact.valueExprCallNodeIndex] =
            TypedExprIrInternText(
                ir, strings.CloneStr(fact.typeText))
        ir.valueExprCallMetaOriginParserNodeIds[
            fact.valueExprCallNodeIndex] = fact.originParserNodeId

fn TypedExprIrValueExprCallOriginParserNodeId(
        ir: var TypedExprIr,
        nodeIndex: int32,
        parserExprOrigin: int32): int32 =
    let treeNodeCount = parser.ParserValueExprTreeNodeCount(
        ir.valueExprTree)
    if nodeIndex < 0 || nodeIndex >= treeNodeCount:
        panic(Fmt"typed expr: value-call aggregate parser identity unavailable aggregate_node={nodeIndex} parser_origin={parserExprOrigin} metadata_domain={ir.valueExprCallMetaOriginParserNodeIds.len} tree_nodes={treeNodeCount}")
    let producerSourceIndex =
        parser.ParserValueExprNodeProducerSourceIndexAt(
            ir.valueExprTree, nodeIndex)
    let sourceLocalNodeId =
        parser.ParserValueExprNodeSourceLocalIndexAt(
            ir.valueExprTree, nodeIndex)
    if producerSourceIndex < 0 || sourceLocalNodeId < 0:
        panic(Fmt"typed expr: value-call source-local parser identity unavailable aggregate_node={nodeIndex} producer_source={producerSourceIndex} source_local_node={sourceLocalNodeId} parser_origin={parserExprOrigin} metadata_domain={ir.valueExprCallMetaOriginParserNodeIds.len} tree_nodes={treeNodeCount}")
    if nodeIndex < ir.valueExprCallMetaOriginParserNodeIds.len:
        let metadataOrigin =
            ir.valueExprCallMetaOriginParserNodeIds[nodeIndex]
        if metadataOrigin >= 0 && metadataOrigin != sourceLocalNodeId:
            panic(Fmt"typed expr: value-call metadata/tree origin authority drift aggregate_node={nodeIndex} producer_source={producerSourceIndex} source_local_node={sourceLocalNodeId} metadata={metadataOrigin}")
    if parserExprOrigin >= 0 && parserExprOrigin != sourceLocalNodeId:
        panic(Fmt"typed expr: value-call parser/tree origin authority drift aggregate_node={nodeIndex} producer_source={producerSourceIndex} source_local_node={sourceLocalNodeId} parser={parserExprOrigin}")
    return sourceLocalNodeId

fn TypedExprIrValueExprCallResultType(
        ir: var TypedExprIr,
        nodeIndex: int32): str =
    if nodeIndex < 0 ||
       nodeIndex >= ir.valueExprCallMetaResultTypeIds.len:
        return ""
    let result = langintern.LookupIntern(
        ir.internPool,
        ir.valueExprCallMetaResultTypeIds[nodeIndex])
    if !IsOk(result):
        return ""
    return Value(result)

@borrows
fn TypedExprIrRegisterValueExprCallResultType(
        ir: var TypedExprIr,
        nodeIndex: int32,
        resultType: str) =
    if nodeIndex < 0:
        return
    let existing = TypedExprIrValueExprCallResultType(ir, nodeIndex)
    if existing != "":
        return
    if nodeIndex >= ir.valueExprCallMetaResultTypeIds.len:
        panic(Fmt"typed expr: incremental value-call node index out of bounds node={nodeIndex} domain={ir.valueExprCallMetaResultTypeIds.len}")
    if resultType == "":
        panic("typed expr: incremental value-call result type missing")
    ir.valueExprCallMetaResultTypeIds[nodeIndex] =
        TypedExprIrInternText(ir, share(resultType))

@borrows
fn typedExprIrValidateCallNodeAuthorityRangeRows(
        ir: var TypedExprIr,
        startNodeIndex: int32,
        declarationOwner: TypedExprBuildIndex) =
    for nodeIndex in startNodeIndex..<ir.nodes2_nodeIndexs.len:
        let targetResult = langintern.LookupIntern(
            ir.internPool, ir.nodes2_callTargetIds[nodeIndex])
        let sourceResult = langintern.LookupIntern(
            ir.internPool, ir.nodes2_callTargetSourcePathIds[nodeIndex])
        if !IsOk(targetResult) || !IsOk(sourceResult):
            panic("typed expr: call-node authority intern id invalid")
        let target = Value(targetResult)
        let targetSource = Value(sourceResult)
        let targetSignatureLineNumber = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_callTargetSignatureLineNumbers,
            nodeIndex)
        let declarationIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_callDeclarationIndexes,
            nodeIndex)
        let funcRefDomain = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_funcRefTargetDomains,
            nodeIndex)
        let funcRefDeclarationRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_funcRefCallDeclarationRows,
            nodeIndex)
        if (target == "") != (targetSource == ""):
            panic("typed expr: call-node target/source authority incomplete")
        if targetSignatureLineNumber < 0 ||
           (target == "" && targetSignatureLineNumber != 0) ||
           (ir.nodes2_callTargetImportcs[nodeIndex] &&
            targetSignatureLineNumber != 0):
            panic("typed expr: call-node declaration identity invalid")
        if ir.nodes2_opKinds[nodeIndex] != TypedExprIrOpCallExpr:
            if target != "" || targetSource != "" ||
               targetSignatureLineNumber != 0 ||
               ir.nodes2_callTargetImportcs[nodeIndex] ||
               ir.nodes2_callKinds[nodeIndex] != TypedExprCallNone ||
               declarationIndex != -1:
                panic("typed expr: non-call node carries call authority")
            if ir.nodes2_opKinds[nodeIndex] == TypedExprIrOpFuncRef:
                if funcRefDomain !=
                       Int32(TypedExprFuncRefTargetDomainCallDeclaration) ||
                   funcRefDeclarationRow < 0 ||
                   declarationOwner == nil || declarationOwner.released ||
                   !declarationOwner.callDeclarationSealed ||
                   funcRefDeclarationRow >=
                       declarationOwner.callDeclarationKinds.len ||
                   declarationOwner.callDeclarationKinds[
                       funcRefDeclarationRow] !=
                       TypedExprCallDeclarationFunction:
                    panic("typed expr: frozen FuncRef declaration authority invalid")
            elif funcRefDomain !=
                     Int32(TypedExprFuncRefTargetDomainNone) ||
                 funcRefDeclarationRow != -1:
                panic("typed expr: frozen non-FuncRef carries function target authority")
            continue
        if funcRefDomain != Int32(TypedExprFuncRefTargetDomainNone) ||
           funcRefDeclarationRow != -1:
            panic("typed expr: CallExpr carries FuncRef target authority")
        let callKind = ir.nodes2_callKinds[nodeIndex]
        if callKind != TypedExprCallNone &&
           callKind != TypedExprCallBuiltin &&
           callKind != TypedExprCallResultIntrinsic &&
           callKind != TypedExprCallProjection:
            panic("typed expr: CallExpr call kind invalid")
        if declarationIndex < -1:
            panic("typed expr: call-node declaration row is invalid")
        if declarationIndex >= 0:
            if callKind != TypedExprCallNone:
                panic("typed expr: declaration CallExpr carries intrinsic kind")
            if declarationOwner == nil || declarationOwner.released ||
               !declarationOwner.callDeclarationSealed ||
               declarationIndex >=
                   typedExprBuildIndexCallDeclarationCount(declarationOwner) ||
               declarationIndex >=
                   declarationOwner.callDeclarationSignatureLineNumbers.len ||
               declarationIndex >= declarationOwner.callDeclarationKinds.len:
                panic("typed expr: call-node declaration row unavailable")
            let declarationImportc =
                declarationOwner.callDeclarationKinds[declarationIndex] ==
                    TypedExprCallDeclarationImportc
            # [ia1 alias-family] Frozen-node audit compares the same
            # canonical identity: the declaration row's registered name.
            if parser.ParserNormalizePath(
                   typedExprBuildIndexCallSourcePath(declarationOwner,
                                                     declarationIndex)) !=
                   parser.ParserNormalizePath(targetSource) ||
               typedExprBuildIndexCallName(declarationOwner,
                                           declarationIndex) != target ||
               declarationOwner.callDeclarationSignatureLineNumbers[
                   declarationIndex] != targetSignatureLineNumber ||
               declarationImportc != ir.nodes2_callTargetImportcs[nodeIndex]:
                panic("typed expr: call-node declaration identity drift")
            var manualTargetOrdinal: int32
            var manualSourceOrdinal: int32
            var manualTargetDeclarationRow: int32
            var manualSourceDeclarationRow: int32
            var manualTargetTypeId: int32
            var manualSourceTypeId: int32
            var manualEffectCid: layout.FixedBytes32
            let _manualConsumePresent =
                TypedExprIrCallManualConsumeEffectInto(
                    ir,
                    nodeIndex,
                    manualTargetOrdinal,
                    manualSourceOrdinal,
                    manualTargetDeclarationRow,
                    manualSourceDeclarationRow,
                    manualTargetTypeId,
                    manualSourceTypeId,
                    manualEffectCid)
            continue
        let calleeNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand2NodeIndexs, nodeIndex)
        if target == "" && callKind == TypedExprCallNone &&
           calleeNodeIndex >= 0:
            if calleeNodeIndex >= nodeIndex ||
               ir.nodes2_opKinds[calleeNodeIndex] !=
                   TypedExprIrOpFieldGet ||
               typedExprIrPhysicalFunctionTypeId(
                   ir,
                   TypedExprIrNodeStructuralTypeIdAt(
                       ir, calleeNodeIndex)) < 0:
                panic("typed expr: indirect field CallExpr authority invalid")
            continue
        if target != "":
            if callKind != TypedExprCallNone:
                panic("typed expr: constructor CallExpr carries intrinsic kind")
            if !ir.nodes2_callTargetImportcs[nodeIndex] &&
               targetSignatureLineNumber == 0 &&
               TypedExprIrLookupTypeLayoutRow(ir,
                                              targetSource,
                                              target) >= 0:
                continue
            panic(Fmt"typed expr: real CallExpr has no exact declaration row node={nodeIndex} target={target}")
        if callKind == TypedExprCallBuiltin ||
           callKind == TypedExprCallResultIntrinsic ||
           callKind == TypedExprCallProjection:
            continue
        panic(Fmt"typed expr: real CallExpr has no exact declaration or intrinsic identity node={nodeIndex}")

@borrows
fn TypedExprIrCallNodeMinusOneDeclarationStateValidAt(
        ir: TypedExprIr,
        nodeIndex: int32): bool =
    # Canonical CallExpr state with callDeclarationIndex == -1, mirroring the
    # sealed call-node authority validator arms above: intrinsic callKind
    # (builtin / result intrinsic / projection), an indirect field call
    # (callKind none, empty interned target, FieldGet callee carrying a
    # physical function type, back-referencing operand), or — [phaseB-csg] —
    # a named aggregate constructor placeholder (callKind none, interned
    # target = the declaring type leaf, no callee node, no signature line,
    # structural TypeId bound by the value-definition binding arm).  Lowering
    # consumes the same contract; this predicate is its single authority.
    let callKind = ir.nodes2_callKinds[nodeIndex]
    if callKind == TypedExprCallBuiltin ||
       callKind == TypedExprCallResultIntrinsic ||
       callKind == TypedExprCallProjection:
        return true
    if callKind != TypedExprCallNone:
        return false
    let targetResult = langintern.LookupIntern(
        ir.internPool, ir.nodes2_callTargetIds[nodeIndex])
    if IsOk(targetResult) && Value(targetResult) != "":
        # [phaseB-csg] 非空 target 的 -1 声明态唯一是命名聚合构造占位：
        # 无 importc、无签名行、无 callee 节点，且 structuralTypeId 已由
        # value-def 绑定臂经本源声明行唯一命中精确绑定（绑定即证明）。
        # 不查 exactTypeArena：lowering 消费本谓词时该 arena 指针已被
        # compiler csg seal 出 typed IR，structuralTypeId 列是唯一在场
        # 的绑定证据；未绑定（<0）保持 fail-closed。
        if ir.nodes2_callTargetImportcs[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_callTargetSignatureLineNumbers,
               nodeIndex) != 0:
            return false
        let constructorCalleeNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand2NodeIndexs, nodeIndex)
        if constructorCalleeNodeIndex >= 0:
            return false
        return TypedExprIrNodeStructuralTypeIdAt(ir, nodeIndex) >= 0
    if !IsOk(targetResult) || Value(targetResult) != "":
        return false
    let calleeNodeIndex = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.nodes2_operand2NodeIndexs, nodeIndex)
    if calleeNodeIndex < 0 || calleeNodeIndex >= nodeIndex:
        return false
    if ir.nodes2_opKinds[calleeNodeIndex] != TypedExprIrOpFieldGet:
        return false
    # Read-only mirror of the sealed function-field TypeId walk: the FieldGet
    # callee must carry a physical function type through the
    # alias/borrow/apply chain.
    let arena = ir.exactTypeArena
    if arena == nil || !arena.complete:
        return false
    var typeId = TypedExprIrNodeStructuralTypeIdAt(ir, calleeNodeIndex)
    var chainLength: int32
    while true:
        if typeId < 0 || typeId >= arena.typeCount:
            return false
        chainLength = chainLength + 1
        if chainLength > arena.typeCount:
            panic("typed expr: function field TypeId chain invalid")
        let kind = typearena.TypedExprTypeArenaKindAt(arena, typeId)
        if kind == typearena.TypedExprStructuralTypeFunction:
            return true
        if kind != typearena.TypedExprStructuralTypeAlias &&
           kind != typearena.TypedExprStructuralTypeBorrow &&
           kind != typearena.TypedExprStructuralTypeApply:
            return false
        let childStart = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childStarts, typeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childCounts, typeId)
        if childCount <= 0:
            panic("typed expr: function field TypeId chain child missing")
        typeId = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childTypeIds, childStart)

fn TypedExprIrValidateCallNodeAuthorityRange(ir: var TypedExprIr,
                                              startRaw: int32) =
    var start = startRaw
    if start < 0:
        start = 0
    # The @borrow_result owner forward requires the pristine incoming var
    # root; every later var-boundary call in this body re-seats it.  The
    # owner only depends on ir (never on nodeIndex), so bind it first.
    let declarationOwner = typedExprIrCallDeclarationOwnerIndex(ir)
    if start > ir.nodes2_nodeIndexs.len || !TypedExprIrNodes2ShapeComplete(ir):
        panic("typed expr: call-node authority validation range invalid")
    typedExprIrValidateCallNodeAuthorityRangeRows(
        ir, start, declarationOwner)

fn TypedExprIrEndValueExprBorrow(ir: var TypedExprIr) =
    ir.valueExprCallMetaResultTypeIds = []
    ir.valueExprCallMetaOriginParserNodeIds = []
    if !ir.valueExprTreeBorrowLease:
        if ir.valueExprTree != nil:
            panic("typed expr: raw parser value-tree alias without lease")
        ir.valueExprTransactionDeclarationLocalGroupRows = []
        ir.valueExprTransactionParserProducerSourceIndex = -1
        ir.valueExprTransactionProducerSourceIndex = -1
        ir.valueExprTransactionDefinitionGroupStart = 0
        ir.valueExprTransactionDefinitionGroupRootNodeIndexes = []
        ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex = []
        ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex = []
        ir.valueExprTransactionDefinitionGroupRowsByPatternRow.len = 0
        ir.valueExprTransactionParameterOrdinalsByDeclarationRow.len = 0
        ir.valueExprTransactionParameterCountsByFunctionRow.len = 0
        ir.valueExprTransactionParameterOrdinalLookupCount = 0
        ir.valueExprCurrentParamDefinitionNodeIndexes = []
        ir.valueExprCurrentParamValueDefinitionRows = []
        ir.valueExprCurrentParserFunctionRow = -1
        return
    TypedExprIrValidateCallNodeAuthorityRange(
        ir, ir.valueExprTransactionNodeStart)
    var valueDefinitionErr: str
    if !TypedExprValueDefinitionAuthorityStrictValidateInto(
            ir, valueDefinitionErr) ||
       !TypedExprIdentifierBindingAuthorityStrictValidateParserTreeInto(
            ir,
            ir.valueExprTree,
            ir.valueExprTransactionNodeStart,
            valueDefinitionErr):
        panic(valueDefinitionErr)
    let transactionGroupCount =
        TypedExprValueDefinitionGroupAuthorityCount(ir) -
        ir.valueExprTransactionDefinitionGroupStart
    if transactionGroupCount !=
           ir.valueExprTransactionDefinitionGroupRootNodeIndexes.len:
        panic("typed expr value definition: transaction coverage cardinality drift")
    if ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len !=
           ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex.len:
        panic("typed expr value definition: transaction root CSR shape drift")
    var indexedGroups: bool[]
    setLen(indexedGroups, transactionGroupCount)
    var indexedGroupCount: int32
    for rootNodeIndex in 0..<ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len:
        let indexedGroupStart =
            ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex[
                rootNodeIndex]
        let indexedRootGroupCount =
            ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex[
                rootNodeIndex]
        if indexedGroupStart < 0:
            if indexedGroupStart != -1 || indexedRootGroupCount != 0:
                panic("typed expr value definition: transaction root CSR sentinel drift")
            continue
        if indexedRootGroupCount <= 0 ||
           indexedGroupStart <
               ir.valueExprTransactionDefinitionGroupStart ||
           indexedGroupStart >
               TypedExprValueDefinitionGroupAuthorityCount(ir) -
               indexedRootGroupCount:
            panic("typed expr value definition: transaction group range escaped authority")
        for indexedGroupOffset in 0..<indexedRootGroupCount:
            let indexedGroupRow =
                indexedGroupStart + indexedGroupOffset
            let transactionGroupOffset =
                indexedGroupRow -
                ir.valueExprTransactionDefinitionGroupStart
            if transactionGroupOffset < 0 ||
               transactionGroupOffset >= transactionGroupCount ||
               indexedGroups[transactionGroupOffset] ||
               ir.valueExprTransactionDefinitionGroupRootNodeIndexes[
                   transactionGroupOffset] != rootNodeIndex:
                panic("typed expr value definition: transaction root CSR overlap")
            indexedGroups[transactionGroupOffset] = true
            indexedGroupCount = indexedGroupCount + 1
    for declarationRow in 0..<ir.valueExprTransactionDeclarationLocalGroupRows.len:
        let declarationGroupRow =
            ir.valueExprTransactionDeclarationLocalGroupRows[declarationRow]
        if declarationGroupRow < 0:
            continue
        let transactionGroupOffset =
            declarationGroupRow - ir.valueExprTransactionDefinitionGroupStart
        if transactionGroupOffset < 0 ||
           transactionGroupOffset >= transactionGroupCount ||
           indexedGroups[transactionGroupOffset] ||
           ir.valueExprTransactionDefinitionGroupRootNodeIndexes[
               transactionGroupOffset] != -1:
            panic("typed expr value definition: declaration-local group index overlap")
        indexedGroups[transactionGroupOffset] = true
        indexedGroupCount = indexedGroupCount + 1
    if indexedGroupCount != transactionGroupCount:
        panic("typed expr value definition: transaction group index cardinality drift")
    for transactionGroupOffset in 0..<ir.valueExprTransactionDefinitionGroupRootNodeIndexes.len:
        let groupRow =
            ir.valueExprTransactionDefinitionGroupStart +
            transactionGroupOffset
        let initializerRootNodeIndex =
            ir.valueExprTransactionDefinitionGroupRootNodeIndexes[
                transactionGroupOffset]
        if initializerRootNodeIndex < 0:
            if initializerRootNodeIndex != -1:
                panic("typed expr value definition: transaction group root sentinel drift")
            continue
        if initializerRootNodeIndex >=
               ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len:
            panic("typed expr value definition: transaction group root index drift")
        let rootGroupStart =
            ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex[
                initializerRootNodeIndex]
        let rootGroupCount =
            ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex[
                initializerRootNodeIndex]
        if rootGroupStart < ir.valueExprTransactionDefinitionGroupStart ||
           rootGroupCount <= 0 ||
           groupRow < rootGroupStart ||
           groupRow >= rootGroupStart + rootGroupCount:
            panic("typed expr value definition: transaction group root range drift")
        let bindingOffset = groupRow - rootGroupStart
        var bindingPatternRow: int32
        var parserProducerSourceIndex: int32
        var declarationSourceLocalRow: int32
        var patternSourceLocalRow: int32
        typedExprValueDefinitionLeafCoordinates(
            ir,
            ir.valueExprTree,
            initializerRootNodeIndex,
            bindingOffset,
            bindingPatternRow,
            parserProducerSourceIndex,
            declarationSourceLocalRow,
            patternSourceLocalRow)
        let initializerRootSourceLocalNodeIndex =
            parser.ParserValueExprNodeSourceLocalIndexAt(
                ir.valueExprTree,
                initializerRootNodeIndex)
        let producerSourceIndex =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_producerSourceIndexes,
                groupRow)
        if bindingPatternRow < 0 ||
           bindingPatternRow >=
               arenamod.ArenaArrayInt32Len(
                   ir.arena,
                   ir.valueExprTransactionDefinitionGroupRowsByPatternRow) ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueExprTransactionDefinitionGroupRowsByPatternRow,
               bindingPatternRow) != groupRow ||
           producerSourceIndex < 0 ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_parserProducerSourceIndexes,
               groupRow) != parserProducerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
               groupRow) != initializerRootSourceLocalNodeIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_bindingOffsets,
               groupRow) != bindingOffset ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_bindingCounts,
               groupRow) != rootGroupCount ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_declarationSourceLocalRows,
               groupRow) != declarationSourceLocalRow ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitionGroups_patternSourceLocalRows,
               groupRow) != patternSourceLocalRow:
            panic("typed expr value definition: transaction parser coverage drift")
    parser.ParserValueExprTreeReleaseBorrow(ir.valueExprTree)
    ir.valueExprTree = nil
    ir.valueExprTreeBorrowLease = false
    ir.valueExprTransactionNodeStart = 0
    ir.valueExprTransactionDeclarationLocalGroupRows = []
    ir.valueExprTransactionParserProducerSourceIndex = -1
    ir.valueExprTransactionProducerSourceIndex = -1
    ir.valueExprTransactionDefinitionGroupStart = 0
    ir.valueExprTransactionDefinitionGroupRootNodeIndexes = []
    ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex = []
    ir.valueExprTransactionDefinitionGroupCountsByRootNodeIndex = []
    ir.valueExprTransactionDefinitionGroupRowsByPatternRow.len = 0
    ir.valueExprTransactionParameterOrdinalsByDeclarationRow.len = 0
    ir.valueExprTransactionParameterCountsByFunctionRow.len = 0
    ir.valueExprTransactionParameterOrdinalLookupCount = 0
    ir.valueExprCurrentParamDefinitionNodeIndexes = []
    ir.valueExprCurrentParamValueDefinitionRows = []
    ir.valueExprCurrentParserFunctionRow = -1

fn TypedExprIrReleasePayload(ir: var TypedExprIr) =
    TypedExprIrEndValueExprBorrow(ir)
    TypedExprIrReleaseBuildIndex(ir)
    arenamod.ArenaRelease(ir.arena)
    langintern.InternPoolRelease(ir.internPool)
    ir = TypedExprIr()
    # TypeDefault lowers aggregate storage to zero bytes; restore the one
    # non-zero neutral transaction sentinel explicitly at the lifecycle edge.
    ir.valueExprTransactionParserProducerSourceIndex = -1
    ir.valueExprTransactionProducerSourceIndex = -1
    ir.valueExprCurrentParserFunctionRow = -1

# Ownership audit inventory: these are all 66 ordinary dynamic SoA columns in
# TypedExprIr after the dead ArgSurface schema was removed. ArenaArray columns
# are descriptors into the separately cloned Arena and are intentionally not in
# this list. Keep every ordinary column as an explicit loop so a field-lifecycle
# check can prove that no backing sequence is shared by Clone/AssignInto.
fn TypedExprIrOrdinarySoAColumnCount(): int32 =
    return 66

fn TypedExprIrCloneOrdinarySoAColumns(out: var TypedExprIr,
                                      ir: var TypedExprIr) =
    for i in 0..<ir.functions2_sourcePathIds.len:
        add(out.functions2_sourcePathIds, ir.functions2_sourcePathIds[i])
    for i in 0..<ir.functions2_functionNameIds.len:
        add(out.functions2_functionNameIds, ir.functions2_functionNameIds[i])
    for i in 0..<ir.functions2_returnTypeIds.len:
        add(out.functions2_returnTypeIds, ir.functions2_returnTypeIds[i])
    for i in 0..<ir.functions2_resultExprClasses.len:
        add(out.functions2_resultExprClasses,
            ir.functions2_resultExprClasses[i])
    for i in 0..<ir.functions2_borrowsArguments.len:
        add(out.functions2_borrowsArguments,
            ir.functions2_borrowsArguments[i])
    for i in 0..<ir.functions2_manualConsumePresents.len:
        add(out.functions2_manualConsumePresents,
            ir.functions2_manualConsumePresents[i])
    for i in 0..<ir.functions2_manualConsumeFunctionDeclarationRows.len:
        add(out.functions2_manualConsumeFunctionDeclarationRows,
            ir.functions2_manualConsumeFunctionDeclarationRows[i])
    for i in 0..<ir.functions2_manualConsumeTargetParameterOrdinals.len:
        add(out.functions2_manualConsumeTargetParameterOrdinals,
            ir.functions2_manualConsumeTargetParameterOrdinals[i])
    for i in 0..<ir.functions2_manualConsumeSourceParameterOrdinals.len:
        add(out.functions2_manualConsumeSourceParameterOrdinals,
            ir.functions2_manualConsumeSourceParameterOrdinals[i])
    for i in 0..<ir.functions2_manualConsumeTargetParameterDeclarationRows.len:
        add(out.functions2_manualConsumeTargetParameterDeclarationRows,
            ir.functions2_manualConsumeTargetParameterDeclarationRows[i])
    for i in 0..<ir.functions2_manualConsumeSourceParameterDeclarationRows.len:
        add(out.functions2_manualConsumeSourceParameterDeclarationRows,
            ir.functions2_manualConsumeSourceParameterDeclarationRows[i])
    for i in 0..<ir.functions2_manualConsumeTargetTypeIds.len:
        add(out.functions2_manualConsumeTargetTypeIds,
            ir.functions2_manualConsumeTargetTypeIds[i])
    for i in 0..<ir.functions2_manualConsumeSourceTypeIds.len:
        add(out.functions2_manualConsumeSourceTypeIds,
            ir.functions2_manualConsumeSourceTypeIds[i])
    for i in 0..<ir.functions2_manualConsumeEffectCids.len:
        add(out.functions2_manualConsumeEffectCids,
            layout.FixedBytes32Copy(
                ir.functions2_manualConsumeEffectCids[i]))
    for i in 0..<ir.functions2_returnExprIds.len:
        add(out.functions2_returnExprIds, ir.functions2_returnExprIds[i])
    for i in 0..<ir.scopes2_kinds.len:
        add(out.scopes2_kinds, ir.scopes2_kinds[i])
    for i in 0..<ir.statements2_sourcePathIds.len:
        add(out.statements2_sourcePathIds, ir.statements2_sourcePathIds[i])
    for i in 0..<ir.statements2_functionNameIds.len:
        add(out.statements2_functionNameIds, ir.statements2_functionNameIds[i])
    for i in 0..<ir.statements2_enclosingIfConditionTextIds.len:
        add(out.statements2_enclosingIfConditionTextIds, ir.statements2_enclosingIfConditionTextIds[i])
    for i in 0..<ir.statements2_exprIdIds.len:
        add(out.statements2_exprIdIds, ir.statements2_exprIdIds[i])
    for i in 0..<ir.statements2_kinds.len:
        add(out.statements2_kinds, ir.statements2_kinds[i])
    for i in 0..<ir.statements2_callKinds.len:
        add(out.statements2_callKinds, ir.statements2_callKinds[i])
    for i in 0..<ir.statements2_detailKinds.len:
        add(out.statements2_detailKinds, ir.statements2_detailKinds[i])
    for i in 0..<ir.statements2_surfaceTextIds.len:
        add(out.statements2_surfaceTextIds, ir.statements2_surfaceTextIds[i])
    for i in 0..<ir.statements2_bindingNameIds.len:
        add(out.statements2_bindingNameIds, ir.statements2_bindingNameIds[i])
    for i in 0..<ir.statements2_resultTypeIds.len:
        add(out.statements2_resultTypeIds, ir.statements2_resultTypeIds[i])
    for i in 0..<ir.statements2_conditionLhsTextIds.len:
        add(out.statements2_conditionLhsTextIds, ir.statements2_conditionLhsTextIds[i])
    for i in 0..<ir.statements2_conditionRhsTextIds.len:
        add(out.statements2_conditionRhsTextIds, ir.statements2_conditionRhsTextIds[i])
    for i in 0..<ir.statements2_conditionLiteralTextIds.len:
        add(out.statements2_conditionLiteralTextIds, ir.statements2_conditionLiteralTextIds[i])
    for i in 0..<ir.statements2_assignRootNameIds.len:
        add(out.statements2_assignRootNameIds, ir.statements2_assignRootNameIds[i])
    for i in 0..<ir.statements2_assignRootTypeIds.len:
        add(out.statements2_assignRootTypeIds, ir.statements2_assignRootTypeIds[i])
    for i in 0..<ir.statements2_assignRootSourcePathIds.len:
        add(out.statements2_assignRootSourcePathIds, ir.statements2_assignRootSourcePathIds[i])
    for i in 0..<ir.statements2_assignRootGlobalFlags.len:
        add(out.statements2_assignRootGlobalFlags, ir.statements2_assignRootGlobalFlags[i])
    for i in 0..<ir.statements2_assignPlaceKinds.len:
        add(out.statements2_assignPlaceKinds, ir.statements2_assignPlaceKinds[i])
    for i in 0..<ir.statements2_assignFieldNameIds.len:
        add(out.statements2_assignFieldNameIds, ir.statements2_assignFieldNameIds[i])
    for i in 0..<ir.statements2_assignFieldTypeIds.len:
        add(out.statements2_assignFieldTypeIds, ir.statements2_assignFieldTypeIds[i])
    for i in 0..<ir.statements2_assignValueRootNameIds.len:
        add(out.statements2_assignValueRootNameIds, ir.statements2_assignValueRootNameIds[i])
    for i in 0..<ir.statements2_assignValueRootTypeIds.len:
        add(out.statements2_assignValueRootTypeIds, ir.statements2_assignValueRootTypeIds[i])
    for i in 0..<ir.statements2_assignValueFieldNameIds.len:
        add(out.statements2_assignValueFieldNameIds, ir.statements2_assignValueFieldNameIds[i])
    for i in 0..<ir.statements2_assignValueFieldTypeIds.len:
        add(out.statements2_assignValueFieldTypeIds, ir.statements2_assignValueFieldTypeIds[i])
    for i in 0..<ir.statements2_assignValueOpKinds.len:
        add(out.statements2_assignValueOpKinds, ir.statements2_assignValueOpKinds[i])
    for i in 0..<ir.statements2_assignValueLhsTextIds.len:
        add(out.statements2_assignValueLhsTextIds, ir.statements2_assignValueLhsTextIds[i])
    for i in 0..<ir.statements2_assignValueRhsTextIds.len:
        add(out.statements2_assignValueRhsTextIds, ir.statements2_assignValueRhsTextIds[i])
    for i in 0..<ir.statements2_assignValueRhsHasConsts.len:
        add(out.statements2_assignValueRhsHasConsts, ir.statements2_assignValueRhsHasConsts[i])
    for i in 0..<ir.statements2_callQualifierIds.len:
        add(out.statements2_callQualifierIds, ir.statements2_callQualifierIds[i])
    for i in 0..<ir.statements2_callCalleeIds.len:
        add(out.statements2_callCalleeIds, ir.statements2_callCalleeIds[i])
    for i in 0..<ir.statements2_callTargetIds.len:
        add(out.statements2_callTargetIds, ir.statements2_callTargetIds[i])
    for i in 0..<ir.statements2_callTargetSourcePathIds.len:
        add(out.statements2_callTargetSourcePathIds, ir.statements2_callTargetSourcePathIds[i])
    for i in 0..<ir.statements2_callTargetImportcs.len:
        add(out.statements2_callTargetImportcs, ir.statements2_callTargetImportcs[i])
    for i in 0..<ir.statements2_callArgsTextIds.len:
        add(out.statements2_callArgsTextIds, ir.statements2_callArgsTextIds[i])
    for i in 0..<ir.statements2_callArgTypesTextIds.len:
        add(out.statements2_callArgTypesTextIds, ir.statements2_callArgTypesTextIds[i])
    for i in 0..<ir.statements2_rhsBailReasons.len:
        add(out.statements2_rhsBailReasons, ir.statements2_rhsBailReasons[i])
    for i in 0..<ir.statements2_callSurfaceKinds.len:
        add(out.statements2_callSurfaceKinds, ir.statements2_callSurfaceKinds[i])
    for i in 0..<ir.statements2_loweringModes.len:
        add(out.statements2_loweringModes, ir.statements2_loweringModes[i])
    for i in 0..<ir.statements2_returnKinds.len:
        add(out.statements2_returnKinds, ir.statements2_returnKinds[i])
    for i in 0..<ir.statements2_returnRoots.len:
        add(out.statements2_returnRoots, ir.statements2_returnRoots[i])
    for i in 0..<ir.nodes2_sourcePathIds.len:
        add(out.nodes2_sourcePathIds, ir.nodes2_sourcePathIds[i])
    for i in 0..<ir.nodes2_functionNameIds.len:
        add(out.nodes2_functionNameIds, ir.nodes2_functionNameIds[i])
    for i in 0..<ir.nodes2_opKinds.len:
        add(out.nodes2_opKinds, ir.nodes2_opKinds[i])
    for i in 0..<ir.nodes2_exprClasses.len:
        add(out.nodes2_exprClasses, ir.nodes2_exprClasses[i])
    for i in 0..<ir.nodes2_resultTypeManagedFlags.len:
        add(out.nodes2_resultTypeManagedFlags,
            ir.nodes2_resultTypeManagedFlags[i])
    for i in 0..<ir.nodes2_resultTypeSendFlags.len:
        add(out.nodes2_resultTypeSendFlags,
            ir.nodes2_resultTypeSendFlags[i])
    for i in 0..<ir.nodes2_resultTypeSyncFlags.len:
        add(out.nodes2_resultTypeSyncFlags,
            ir.nodes2_resultTypeSyncFlags[i])
    for i in 0..<ir.nodes2_resultTypeIds.len:
        add(out.nodes2_resultTypeIds, ir.nodes2_resultTypeIds[i])
    for i in 0..<ir.nodes2_surfaceTextIds.len:
        add(out.nodes2_surfaceTextIds, ir.nodes2_surfaceTextIds[i])
    for i in 0..<ir.nodes2_paramNameIds.len:
        add(out.nodes2_paramNameIds, ir.nodes2_paramNameIds[i])
    for i in 0..<ir.nodes2_paramMutableFlags.len:
        add(out.nodes2_paramMutableFlags, ir.nodes2_paramMutableFlags[i])
    for i in 0..<ir.nodes2_literalTextIds.len:
        add(out.nodes2_literalTextIds, ir.nodes2_literalTextIds[i])
    for i in 0..<ir.nodes2_callTargetIds.len:
        add(out.nodes2_callTargetIds, ir.nodes2_callTargetIds[i])
    for i in 0..<ir.nodes2_callTargetSourcePathIds.len:
        add(out.nodes2_callTargetSourcePathIds,
            ir.nodes2_callTargetSourcePathIds[i])
    for i in 0..<ir.nodes2_callTargetImportcs.len:
        add(out.nodes2_callTargetImportcs, ir.nodes2_callTargetImportcs[i])
    for i in 0..<ir.nodes2_fieldTypeSourcePathIds.len:
        add(out.nodes2_fieldTypeSourcePathIds,
            ir.nodes2_fieldTypeSourcePathIds[i])

fn TypedExprIrArenaArrayInt32LogicalBytes(values: arenamod.ArenaArrayInt32): int64 =
    return Int64(values.len) * 4

# Descriptor length is the semantic authority. Arena used/capacity can include
# superseded column buffers and unrelated tail allocations, so neither is a
# valid live-byte measure.
@borrows
fn TypedExprIrArenaLogicalLiveBytes(ir: var TypedExprIr): int64 =
    var total: int64
    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_signatureLineNumbers)
    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_endLineNumbers)
    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_bodyLineNumbers)
    total = total + TypedExprIrArenaArrayInt32LogicalBytes(ir.functions2_statementStarts)
