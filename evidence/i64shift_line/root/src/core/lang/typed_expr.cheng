fn TypedExprIrReportText(ir: TypedExprIr): str =
    var out = ""
    TypedExprReportAppendLine(out, "typed_ir_function_count", IntToStr(ir.functions2_functionNameIds.len))
    TypedExprReportAppendLine(out, "typed_ir_function2_count", IntToStr(ir.functions2_sourcePathIds.len))
    TypedExprReportAppendLine(out, "typed_ir_statement_count", IntToStr(ir.statements2_statementIndexs.len))
    TypedExprReportAppendLine(out, "typed_ir_cold_csg_type_row_count", IntToStr(ir.coldCsgTypeRows.len))
    TypedExprReportAppendLine(out, "typed_ir_cold_csg_statement_row_count", IntToStr(ir.coldCsgStatementRows.len))
    TypedExprReportAppendLine(out, "typed_ir_cold_csg_match_statement_count", IntToStr(TypedExprIrCountColdCsgStatementKind(ir, "match")))
    TypedExprReportAppendLine(out, "typed_ir_cold_csg_case_statement_count", IntToStr(TypedExprIrCountColdCsgStatementKind(ir, "case")))
    TypedExprReportAppendLine(out, "typed_ir_global_count", IntToStr(ir.globalNames.len))
    TypedExprReportAppendLine(out, "typed_ir_local_binding_count", IntToStr(ir.localBindingNames.len))
    TypedExprReportAppendLine(out, "typed_ir_type_def_alias_count", IntToStr(ir.typeDefAliasNames.len))
    TypedExprReportAppendLine(out, "typed_ir_local_decl_statement_count", IntToStr(TypedExprIrCountStatementKind(ir, TypedExprIrStmtLocalDecl)))
