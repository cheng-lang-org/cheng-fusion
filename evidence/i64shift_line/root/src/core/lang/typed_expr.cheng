fn TypedExprSurfaceCallCount(facts: var TypedExprFactTable): int32 =
    var count: int32
    for i in 0..<facts.count:
        if TypedExprFactAt(facts, i).kind == parser.NormalizedExprCall:
            count = count + 1
    return count

