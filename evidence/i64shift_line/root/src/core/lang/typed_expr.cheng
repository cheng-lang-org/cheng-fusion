    if typedExprSharedMetadataColumnInto(
           ctx.sourceLineByteLengths, 3, "sourceLineByteLengths",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.sourceLineOverrideIndexes, 4, "sourceLineOverrideIndexes",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.sourceLineOverrideTexts, 5, "sourceLineOverrideTexts",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.scopes, 6, "scopes", columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.signatureScopes, 7, "signatureScopes",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.bindings, 8, "bindings", columnId, columnName, refCount):
