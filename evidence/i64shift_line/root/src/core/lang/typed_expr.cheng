                                            reason: parser.NormalizedExprCallReason): int32 =
    return TypedExprFactCountCallReason(facts, TypedExprCallReasonFromParser(reason))

fn TypedExprFactsForSource(facts: var TypedExprFactTable,
                             sourcePathRaw: str): TypedExprFactTable =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    var out: TypedExprFactTable
    var sourceRowCount: int32
    for i in 0..<facts.count:
        if TypedExprFactSourcePath(facts, i) == sourcePath:
            sourceRowCount = sourceRowCount + 1
    if !TypedExprFactTablePrepareEmptyRows(out, sourceRowCount):
        panic("typed expr fact table: source projection storage overflow")
    for i in 0..<facts.count:
        if TypedExprFactSourcePath(facts, i) != sourcePath:
            continue
        TypedExprFactTableAppendPrepared(out, TypedExprFactAt(facts, i))
    typedExprFactTableRequireExactPreparedBuild(out)
    return out

fn TypedExprSourceRangeIndexAdd(index: var TypedExprSourceRangeIndex,
                                 sourcePathRaw: str,
                                 startIndex: int32,
                                 endIndex: int32) =
    var sourcePath: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, pathErr):
        panic(pathErr)
    if startIndex < 0 || endIndex < startIndex:
        panic(Fmt"typed expr: source range invalid source={sourcePath} start={startIndex} end={endIndex}")
    let existingIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.lookup,
                                                                                     sourcePath)
    if existingIndex >= 0:
        panic(Fmt"typed expr: source range is not contiguous source={sourcePath} first_range={existingIndex} next_start={startIndex}")
    let rangeIndex = index.sourcePaths.len
    add(index.starts, startIndex)
    add(index.ends, endIndex)
    add(index.sourcePaths, share(sourcePath))
    parser.ParserSourcePathIndexLookupInsertExact(index.lookup,
                                                  parser.ParserOwnedText(sourcePath),
                                                  rangeIndex)

@borrows
fn TypedExprSourceRangeIndexFind(index: var TypedExprSourceRangeIndex,
                                  sourcePathRaw: str): int32 =
    var sourcePath: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, pathErr):
        return -1
    return parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.lookup,
                                                                        sourcePath)

@borrows
fn TypedExprSourceRangeIndexBuildFromFacts(facts: var TypedExprFactTable): TypedExprSourceRangeIndex =
    var index: TypedExprSourceRangeIndex
    index.sourcePaths = []
    index.starts = []
    index.ends = []
    index.lookup = parser.ParserSourcePathIndexLookupInit(32)
    var cursor: int32
    while cursor < facts.count:
        var sourcePath: str
        var pathErr: str
        if !TypedExprLexicalSourcePath(TypedExprFactAt(facts, cursor).sourcePath,
                                       sourcePath,
                                       pathErr):
            panic(pathErr)
        if TypedExprFactAt(facts, cursor).sourcePath != sourcePath:
            panic(Fmt"typed expr: fact source producer emitted noncanonical identity source={TypedExprFactAt(facts, cursor).sourcePath} canonical={sourcePath} index={cursor}")
        var endIndex = cursor + 1
        while endIndex < facts.count:
            if TypedExprFactAt(facts, endIndex).sourcePath != sourcePath:
                break
            endIndex = endIndex + 1
        TypedExprSourceRangeIndexAdd(index, sourcePath, cursor, endIndex)
        cursor = endIndex
    return index

@borrows
fn TypedExprFactUsesImportBuffer(fact: TypedExprFact): bool =
    if fact.loweringMode != TypedExprLowerImportBuffer:
        return false
    if fact.returnKind != TypedExprReturnImportBuffer:
        return false
    return true

@borrows
fn TypedExprImportcFactRequiresImportBuffer(fact: TypedExprFact): bool =
    if !fact.callTargetImportc:
        return false
    if fact.abiClass == TypedExprAbiComposite:
        return true
    let typeText = TypedExprNormalizeTypeText(fact.typeText)
    return typeText == "str" ||
           typeText == "cstring" ||
           typeText == "owned_cstring"

@borrows
fn TypedExprFactUsesLocalAddressCompositeLocal(fact: TypedExprFact): bool =
    if fact.loweringMode != TypedExprLowerLocalAddress:
        return false
    if fact.returnKind != TypedExprReturnCompositeLocal:
        return false
    return true

@borrows
fn TypedExprFactUsesRegReturnReg(fact: TypedExprFact): bool =
    if fact.loweringMode != TypedExprLowerReg:
        return false
    if fact.returnKind != TypedExprReturnReg:
        return false
    return true

@borrows
fn TypedExprFactUsesTypeCallMaterialize(fact: TypedExprFact): bool =
    if fact.typeCallKind == TypedExprTypeCallDefaultInit:
        return true
    if fact.typeCallKind == TypedExprTypeCallConstructor:
        return true
    return false

@borrows
fn TypedExprFactAbiIsPolymorphic(fact: TypedExprFact): bool =
    return fact.abiClass == TypedExprAbiPolymorphic

@borrows
fn TypedExprTypeTextIsConcrete(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return false
    if typeText == "unknown" ||
       typeText == "default_init_expr" ||
       typeText == "constructor_expr" ||
       typeText == "call_expr" ||
       typeText == "branch_join" ||
       typeText == "result_projection":
        return false
    # 裸泛型类型参数（单大写字母 T/U/...）不是具体类型：把它当成具体会让
    # `let v = Value(r)` 这类调用的 LocalDecl 孪生采纳泛型模板返回类型 T，
    # 据此把 v 槽误建成 ptr（首字母大写→PtrTag），与标量投影宽度不符而
    # miscompile。与下方同名定义口径一致。
    if typeText.len == 1 &&
       typeText[0] >= 'A' &&
       typeText[0] <= 'Z':
        return false
    return parser.ParserFindText(typeText, "unknown") < 0

fn TypedExprFactValidateTypeCallMaterialize(fact: TypedExprFact,
                                              err: var str): bool =
    if fact.typeCallKind == TypedExprTypeCallNone:
        return true
    if fact.kind != parser.NormalizedExprDefaultInit &&
       fact.kind != parser.NormalizedExprConstructor:
        err = Fmt" typed expr: type-call fact kind drift at {fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.callKind != TypedExprCallNone:
        err = Fmt" typed expr: type-call fact leaked ordinary call kind at {fact.sourcePath}:{fact.lineNumber}"
        return false
    if !TypedExprTypeTextIsConcrete(fact.typeText):
        err = Fmt" typed expr: type-call fact missing concrete type at {fact.sourcePath}:{fact.lineNumber} type={fact.typeText} args={fact.callArgsText}"
        return false
    if fact.typeCallKind == TypedExprTypeCallIdentity:
        if fact.kind != parser.NormalizedExprConstructor ||
           fact.callArgCount != 1 || fact.callArgsText == "":
            err = Fmt" typed expr: identity type-call fact surface drift at {fact.sourcePath}:{fact.lineNumber}"
            return false
        err = ""
        return true
    if fact.abiClass == TypedExprAbiScalar || fact.abiClass == TypedExprAbiPointerLike:
        if fact.abiClass == TypedExprAbiScalar && fact.valueKind != TypedExprValueScalar:
            err = Fmt" typed expr: type-call scalar conversion value drift at {fact.sourcePath}:{fact.lineNumber}"
            return false
        if fact.abiClass == TypedExprAbiPointerLike && fact.valueKind != TypedExprValuePointerLike:
            err = Fmt" typed expr: type-call pointer conversion value drift at {fact.sourcePath}:{fact.lineNumber}"
            return false
        if fact.placeKind == TypedExprPlaceCallResult:
            err = Fmt" typed expr: type-call conversion cannot use call-result place at {fact.sourcePath}:{fact.lineNumber}"
            return false
        if fact.loweringMode != TypedExprLowerReg:
            err = Fmt" typed expr: type-call conversion lowering drift at {fact.sourcePath}:{fact.lineNumber} lowering={TypedExprLoweringModeText(fact.loweringMode)}"
            return false
        if fact.returnKind != TypedExprReturnReg:
            err = Fmt" typed expr: type-call conversion return drift at {fact.sourcePath}:{fact.lineNumber} return={TypedExprReturnKindText(fact.returnKind)}"
            return false
        err = ""
        return true
    if fact.abiClass != TypedExprAbiComposite ||
       fact.valueKind != TypedExprValueComposite:
        err = Fmt" typed expr: type-call fact must materialize composite at {fact.sourcePath}:{fact.lineNumber} type={fact.typeText} abi={TypedExprAbiClassText(fact.abiClass)} value={TypedExprValueKindText(fact.valueKind)}"
        return false
    if fact.placeKind == TypedExprPlaceCallResult:
        err = Fmt" typed expr: type-call fact cannot use call-result place at {fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.loweringMode != TypedExprLowerLocalAddress &&
       fact.loweringMode != TypedExprLowerSret:
        err = Fmt" typed expr: type-call fact missing address lowering at {fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.loweringMode == TypedExprLowerLocalAddress &&
       fact.returnKind != TypedExprReturnCompositeLocal:
        err = Fmt" typed expr: type-call fact local-address return drift at {fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.loweringMode == TypedExprLowerSret &&
       fact.returnKind != TypedExprReturnSret:
        err = Fmt" typed expr: type-call fact sret return drift at {fact.sourcePath}:{fact.lineNumber}"
        return false
    err = ""
    return true

fn TypedExprFactsHasLineUsingImportBuffer(facts: var TypedExprFactTable,
                                            sourcePathRaw: str,
                                            lineNumber: int32): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    for i in 0..<facts.count:
        if TypedExprFactSourcePath(facts, i) != sourcePath || TypedExprFactLineNumber(facts, i) != lineNumber:
            continue
        if TypedExprFactUsesImportBuffer(TypedExprFactAt(facts, i)):
            return true
    return false

fn TypedExprFactsHasLineUsingLocalAddressCompositeLocal(facts: var TypedExprFactTable,
                                                          sourcePathRaw: str,
                                                          lineNumber: int32): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    for i in 0..<facts.count:
        if TypedExprFactSourcePath(facts, i) != sourcePath || TypedExprFactLineNumber(facts, i) != lineNumber:
            continue
        if TypedExprFactUsesLocalAddressCompositeLocal(TypedExprFactAt(facts, i)):
            return true
    return false

fn TypedExprFactsHasLineUsingRegReturnReg(facts: var TypedExprFactTable,
                                            sourcePathRaw: str,
                                            lineNumber: int32): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    for i in 0..<facts.count:
        if TypedExprFactSourcePath(facts, i) != sourcePath || TypedExprFactLineNumber(facts, i) != lineNumber:
            continue
        if TypedExprFactUsesRegReturnReg(TypedExprFactAt(facts, i)):
            return true
    return false

@borrows
fn TypedExprTypeIsBareGenericPlaceholder(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    if typeText.len == 1 && typeText[0] >= 'A' && typeText[0] <= 'Z':
        return true
    return false

@borrows
fn TypedExprTypeIsGenericPlaceholder(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    if TypedExprTypeIsBareGenericPlaceholder(typeText):
        return true
    if typeText.len != 4:
        return false
    let prefix = chengpath.TextSlice(typeText, 0, 3)
    if prefix != "ref" && prefix != "var":
        return false
    if typeText[3] < 'A' || typeText[3] > 'Z':
        return false
    return true

fn TypedExprTypeContainsGenericPlaceholder(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if TypedExprTypeIsGenericPlaceholder(typeText):
        return true
    if typeText.len > 0 && typeText[typeText.len - 1] == '*':
        return TypedExprTypeContainsGenericPlaceholder(
            chengpath.TextSlice(typeText, 0, typeText.len - 1))
    if typeText.len >= 2 &&
       TypedExprTextAt(typeText, typeText.len - 2, "[]"):
        return TypedExprTypeContainsGenericPlaceholder(
            chengpath.TextSlice(typeText, 0, typeText.len - 2))
    let openPos = TypedExprFindTopLevelToken(typeText, "[")
    if openPos <= 0:
        return false
    let closePos = TypedExprFindMatchingBracket(typeText, openPos)
    if closePos <= openPos || closePos + 1 != typeText.len:
        return false
    let args = TypedExprSplitTopLevelCsv(chengpath.TextSlice(
        typeText,
        openPos + 1,
        closePos - openPos - 1))
    for arg in args:
        if TypedExprTypeContainsGenericPlaceholder(arg):
            return true
    return false

fn TypedExprSubstituteTypeParams(typeText: str,
                                  genericNames: str[],
                                  genericTypes: str[]): str =
    if genericNames.len <= 0:
        return typeText
    let normalized = TypedExprNormalizeTypeText(share(typeText))
    
    # Exact match: a single generic parameter (T → int32)
    for i in 0..<genericNames.len:
        if i >= genericTypes.len: break
        let paramName = chengpath.PathTrim(genericNames[i])
        if normalized == paramName:
            return genericTypes[i]
    
    if normalized.len > 0 && normalized[normalized.len - 1] == '*':
        let inner = TypedExprSubstituteTypeParams(
            chengpath.TextSlice(normalized, 0, normalized.len - 1),
            genericNames,
            genericTypes)
        return Fmt"{inner}*"
    if normalized.len >= 2 &&
       TypedExprTextAt(normalized, normalized.len - 2, "[]"):
        let inner = TypedExprSubstituteTypeParams(
            chengpath.TextSlice(normalized, 0, normalized.len - 2),
            genericNames,
            genericTypes)
        return Fmt"{inner}[]"

    # Ownership wrappers preserve their shape while substituting the inner
    # declared parameter. They are not aliases for an arbitrary sink type.
    for i in 0..<genericNames.len:
        if i >= genericTypes.len: break
        let paramName = chengpath.PathTrim(genericNames[i])
        let prefixLen = 3
        if normalized.len == prefixLen + paramName.len:
            if TypedExprTextAt(normalized, 0, Fmt"ref{paramName}"):
                return Fmt"ref{genericTypes[i]}"
            if TypedExprTextAt(normalized, 0, Fmt"var{paramName}"):
                return Fmt"var{genericTypes[i]}"
    
    # Bracket-delimited type arguments: Result[T], Map[T,U], Array[T]
    let openPos = TypedExprFindTopLevelToken(normalized, "[")
    if openPos > 0:
        let closePos = TypedExprFindMatchingBracket(normalized, openPos)
        if closePos > openPos:
            let prefix = chengpath.TextSlice(normalized, 0, openPos)
            let inner = chengpath.TextSlice(normalized, openPos + 1, closePos - openPos - 1)
            let suffix = chengpath.TextSlice(normalized, closePos + 1, normalized.len - closePos - 1)
            let substitutedInner = TypedExprSubstituteTypeParamsInList(inner,
                                                                        genericNames,
                                                                        genericTypes)
            var result = Fmt"{prefix}[{substitutedInner}]"
            if suffix != "":
                result = Fmt"{result}{suffix}"
            return result
    
    return typeText

fn TypedExprSubstituteTypeParamsInList(typeList: str,
                                         genericNames: str[],
                                         genericTypes: str[]): str =
    # Split a comma-separated type-arg list at bracket-depth 0,
    # substitute each part, then rejoin.
    if typeList == "":
        return ""
    var parts: str[]
    var currentBuf = buffer.NewByteBuffer()
    var bracketDepth: int32
    for i in 0..<typeList.len:
        let ch = chengpath.TextSlice(typeList, i, 1)
        if ch == "," && bracketDepth == 0:
            let part = chengpath.PathTrim(rawbytes.BytesToString(buffer.ToBytes(currentBuf)))
            if part != "":
                let subbed = TypedExprSubstituteTypeParams(part,
                                                            share(genericNames),
                                                            share(genericTypes))
                add(parts, subbed)
            else:
                add(parts, "")
            currentBuf = buffer.NewByteBuffer()
        else:
            if ch == "[":
                bracketDepth = bracketDepth + 1
            elif ch == "]":
                bracketDepth = bracketDepth - 1
            buffer.AppendText(currentBuf, ch)
    
    # Last part after final comma (or the only part)
    let lastPart = chengpath.PathTrim(rawbytes.BytesToString(buffer.ToBytes(currentBuf)))
    if lastPart != "":
        let subbed = TypedExprSubstituteTypeParams(lastPart,
                                                    share(genericNames),
                                                    share(genericTypes))
        add(parts, subbed)
    else:
        add(parts, "")
    
    # Join back with commas
    if parts.len <= 0:
        return ""
    var out = parts[0]
    for j in 1..<parts.len:
        out = Fmt"{out},{parts[j]}"
    return out

# gapB Bug2 根修: 结构化匹配一个可能含未具体化类型形参 (裸占位符 `T`, 后缀数组/
# 指针包装 `T[]`/`T[]*`, 或括号容器实例化 `set[T]`/`Result[T]`) 的候选形参类型
# 文本 `templateRaw`, 与调用点具体实参类型文本 `concreteRaw` 做逐层拆解比对,
# 边比对边把占位符绑定写入 `boundNames`/`boundTypes` (调用方在同一候选的多个
# 形参间共享同一对数组, 使同一 `T` 在该候选内的每次出现都被要求解出同一具体
# 类型——`Add(var T[], T)` 这类签名靠这个共享状态阻止"数组元素 T 绑成 int32
# 但标量 T 绑成 str"这种自相矛盾的假匹配)。任何结构不符 (包装层数/种类不同、
# 容器名不同、非占位符处字面不等、括号实参个数不同) 立即返回 false——没有
# "退而求其次"的宽松匹配, 绑定失败与文本字面不等对调用方而言是同一件事:
# 该候选出局, 交由上层判 0/2+ 存活, 最终仍可能落到编译期硬失败, 绝不臆猜。
@borrows
fn TypedExprDeclaredGenericNameIndex(genericNames: str[],
                                      nameRaw: str): int32 =
    let name = chengpath.PathTrim(nameRaw)
    for nameIndex in 0..<genericNames.len:
        if chengpath.PathTrim(genericNames[nameIndex]) == name:
            return nameIndex
    return -1

@borrows
fn TypedExprUnifyGenericParamType(templateRaw: str,
                                   concreteRaw: str,
                                   declaredGenericNames: str[],
                                   boundNames: var str[],
                                   boundTypes: var str[]): bool =
    var tmpl = TypedExprNormalizeTypeText(templateRaw)
    var conc = TypedExprNormalizeTypeText(concreteRaw)
    if tmpl == "" || conc == "":
        return false
    while true:
        if TypedExprDeclaredGenericNameIndex(declaredGenericNames, tmpl) >= 0:
            for i in 0..<boundNames.len:
                if boundNames[i] == tmpl:
                    return boundTypes[i] == conc
            add(boundNames, strings.CloneStr(tmpl))
            add(boundTypes, strings.CloneStr(conc))
            return true
        if tmpl.len > 0 && tmpl[tmpl.len - 1] == '*':
            if conc.len <= 0 || conc[conc.len - 1] != '*':
                return false
            tmpl = chengpath.TextSlice(tmpl, 0, tmpl.len - 1)
            conc = chengpath.TextSlice(conc, 0, conc.len - 1)
            continue
        if tmpl.len >= 2 && TypedExprTextAt(tmpl, tmpl.len - 2, "[]"):
            if conc.len < 2 || !TypedExprTextAt(conc, conc.len - 2, "[]"):
                return false
            tmpl = chengpath.TextSlice(tmpl, 0, tmpl.len - 2)
            conc = chengpath.TextSlice(conc, 0, conc.len - 2)
            continue
        break
    if tmpl.len > 3 && conc.len > 3:
        let tmplPrefix = chengpath.TextSlice(tmpl, 0, 3)
        let concPrefix = chengpath.TextSlice(conc, 0, 3)
        if (tmplPrefix == "ref" || tmplPrefix == "var") &&
           tmplPrefix == concPrefix:
            return TypedExprUnifyGenericParamType(
                chengpath.TextSlice(tmpl, 3, tmpl.len - 3),
                chengpath.TextSlice(conc, 3, conc.len - 3),
                declaredGenericNames,
                boundNames,
                boundTypes)
    let openPos = TypedExprFindTopLevelToken(tmpl, "[")
    if openPos > 0:
        let closePos = TypedExprFindMatchingBracket(tmpl, openPos)
        if closePos <= openPos || closePos + 1 != tmpl.len:
            return false
        let tmplContainer = chengpath.TextSlice(tmpl, 0, openPos)
        let concOpen = TypedExprFindTopLevelToken(conc, "[")
        if concOpen <= 0:
            return false
        let concClose = TypedExprFindMatchingBracket(conc, concOpen)
        if concClose <= concOpen || concClose + 1 != conc.len:
            return false
        let concContainer = chengpath.TextSlice(conc, 0, concOpen)
        if tmplContainer != concContainer:
            return false
        let tmplArgs = TypedExprSplitTopLevelCsv(chengpath.TextSlice(tmpl, openPos + 1, closePos - openPos - 1))
        let concArgs = TypedExprSplitTopLevelCsv(chengpath.TextSlice(conc, concOpen + 1, concClose - concOpen - 1))
        if tmplArgs.len != concArgs.len:
            return false
        for i in 0..<tmplArgs.len:
            if !TypedExprUnifyGenericParamType(tmplArgs[i],
                                                concArgs[i],
                                                declaredGenericNames,
                                                boundNames,
                                                boundTypes):
                return false
        return true
    return tmpl == conc

@borrows
fn TypedExprTopLevelDeclarationExportedByCase(name: str): bool =
    if Len(name) <= 0:
        return false
    let ch = name[0]
    return ch >= 'A' && ch <= 'Z'


@borrows
fn TypedExprSymbolExportedByCase(name: str): bool =
    if Len(name) <= 0:
        return false
    let ch = name[0]
    if ch >= 'A' && ch <= 'Z':
        return true
    if name == "assert": return true
    if name == "panic": return true
    if name == "echo": return true
    if name == "typeof": return true
    if name == "len" || name == "Len": return true
    if name == "IntToStr" || name == "Int64ToStr": return true
    if name == "memRefCount": return true
    if name == "memRetainAtomic": return true
    if name == "memReleaseAtomic": return true
    if name == "memRefCountAtomic": return true
    if name == "memRetainCount": return true
    if name == "memReleaseCount": return true
    if name == "os_exit_bridge": return true
    if name == "memFreeCount": return true
    if name == "c_strlen": return true
    if name == "system_ptr_add": return true
    # [N3 判点②] system.cheng ptr-bridge 原语 load 与上方 system_ptr_add
    # 同族（cold bootstrap 一直接受的跨层小写兼容面）。hashmaps.cheng:253/263
    # `load[uint8](...)` 跨层直调被 ByCase 可见性拒为 Missing → uint64 转换
    # 操作数定型落空（r6_op_min/cold_hashmap 判词根因，probe_d/probe_h 钉位）。
    if name == "load": return true
    if name == "cmpMem": return true
    if name == "memCopyCompat": return true
    if name == "memRetain": return true
    if name == "free": return true
    return false

@borrows
fn typedExprContextArrayIndexForBuildIndex(
        sourceContexts: TypedExprSourceContext[],
        buildIndexContextIndex: int32): int32 =
    if buildIndexContextIndex < 0:
        return -1
    if sourceContexts.len > 0 &&
       sourceContexts[0].frozenMetadataProjection != nil:
        # BuildRoundViews emits frozen headers in canonical context-index
        # order. Binary identity projection avoids a package-wide scan at
        # every type/field query.
        var low: int32
        var high = sourceContexts.len
        while low < high:
            let middle = low + (high - low) / 2
            let candidate =
                sourceContexts[middle].frozenMetadataContextIndex
            if candidate < buildIndexContextIndex:
                low = middle + 1
            else:
                high = middle
        if low < sourceContexts.len &&
           sourceContexts[low].frozenMetadataContextIndex ==
               buildIndexContextIndex:
            return low
        return -1
    if buildIndexContextIndex >= sourceContexts.len:
        return -1
    return buildIndexContextIndex

@borrows
fn TypedExprSourceContextExactIndex(sourceContexts: var TypedExprSourceContext[],
                                     sourcePathRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    if sourceContexts.len > 0 && sourceContexts[0].buildIndex != nil:
        var contextIndex: int32
        let state = TypedExprBuildIndexLookup(sourceContexts[0].buildIndex,
                                               "ctx_source",
                                               sourcePath,
                                               "",
                                               "",
                                               contextIndex)
        if state == TypedExprBuildIndexUnique:
            return typedExprContextArrayIndexForBuildIndex(sourceContexts,
                                                            contextIndex)
        if state == TypedExprBuildIndexAmbiguous:
            return -2
        return -1
    var found: int32 = -1
    for contextIndex in 0..<sourceContexts.len:
        var candidate = sourceContexts[contextIndex].normalizedSourcePath
        if candidate == "":
            candidate = parser.ParserNormalizePath(sourceContexts[contextIndex].sourcePath)
        if candidate != sourcePath:
            continue
        if found >= 0:
            return -2
        found = contextIndex
    return found

fn TypedExprSourcesSharePackage(sourceContexts: var TypedExprSourceContext[],
                                 leftSourcePath: str,
                                 rightSourcePath: str): bool =
    let leftIndex = TypedExprSourceContextExactIndex(sourceContexts,
                                                      leftSourcePath)
    let rightIndex = TypedExprSourceContextExactIndex(sourceContexts,
                                                       rightSourcePath)
    if leftIndex >= 0 && rightIndex >= 0:
        let leftOwner = sourceContexts[leftIndex].packageOwnerKey
        let rightOwner = sourceContexts[rightIndex].packageOwnerKey
        return leftOwner != "" && leftOwner == rightOwner
    var projection: typedExprFrozenMetadataProjection
    for contextIndex in 0..<sourceContexts.len:
        if sourceContexts[contextIndex].frozenMetadataProjection != nil:
            projection = sourceContexts[contextIndex].frozenMetadataProjection
            break
    if projection == nil || projection.released:
        return false
    var leftPath: str
    var rightPath: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(leftSourcePath, leftPath, pathErr) ||
       !TypedExprLexicalSourcePath(rightSourcePath, rightPath, pathErr):
        return false
    let leftContextIndex = typedExprFrozenContextIndexForPath(projection,
                                                               leftPath)
    let rightContextIndex = typedExprFrozenContextIndexForPath(projection,
                                                                rightPath)
    if leftContextIndex < 0 || rightContextIndex < 0 ||
       leftContextIndex >= projection.packageOwnerIds.len ||
       rightContextIndex >= projection.packageOwnerIds.len:
        return false
    let leftOwnerId = projection.packageOwnerIds[leftContextIndex]
    if leftOwnerId != projection.packageOwnerIds[rightContextIndex]:
        return false
    let ownerResult: Result[str] =
        langintern.LookupIntern(projection.internPool, leftOwnerId)
    return IsOk(ownerResult) && Value(ownerResult) != ""

fn typedExprSliceResolutionScratchClear(
        scratch: var TypedExprSliceResolutionScratch) =
    setLen(scratch.aggregateCtorTypes, 0)
    setLen(scratch.zeroArgCtorTypes, 0)
    setLen(scratch.resolveReturnTypes, 0)
    setLen(scratch.resolveSourcePaths, 0)
    setLen(scratch.resolveTargetNames, 0)
    setLen(scratch.resolveSignatureLines, 0)
    setLen(scratch.resolveFlags, 0)
    scratch.exprCount = 0

# Always collapse to zero first: a same-length slice must never observe the
# previous slice's verdict strings through the retained capacity.
fn typedExprSliceResolutionScratchPrepare(
        scratch: var TypedExprSliceResolutionScratch,
        exprCount: int32) =
    typedExprSliceResolutionScratchClear(scratch)
    if exprCount > 0:
        setLen(scratch.aggregateCtorTypes, exprCount)
        setLen(scratch.zeroArgCtorTypes, exprCount)
        setLen(scratch.resolveReturnTypes, exprCount)
        setLen(scratch.resolveSourcePaths, exprCount)
        setLen(scratch.resolveTargetNames, exprCount)
        setLen(scratch.resolveSignatureLines, exprCount)
        setLen(scratch.resolveFlags, exprCount)
        scratch.exprCount = exprCount

fn TypedExprFactsValidateCallResolutionRangeWithPreparedContext(
        exprLayer: var parser.NormalizedExprLayer,
        sourceContexts: var TypedExprSourceContext[],
        preparedSourceContext: var TypedExprSourceContext,
        facts: var TypedExprFactTable,
        exprStartIndexRaw: int32,
        exprEndIndexRaw: int32,
        factStartIndexRaw: int32,
        factEndIndexRaw: int32,
        sliceScratch: var TypedExprSliceResolutionScratch,
        err: var str): bool =
    let subTime = TypedExprSubTimeEnabled()
    var vaT0: int64
    var exprStartIndex = exprStartIndexRaw
    if exprStartIndex < 0:
        exprStartIndex = 0
    if exprStartIndex > exprLayer.exprs.len:
        exprStartIndex = exprLayer.exprs.len
    var exprEndIndex = exprEndIndexRaw
    if exprEndIndex < 0 || exprEndIndex > exprLayer.exprs.len:
        exprEndIndex = exprLayer.exprs.len
    var factStartIndex = factStartIndexRaw
    if factStartIndex < 0:
        factStartIndex = 0
    if factStartIndex > facts.count:
        factStartIndex = facts.count
    var factEndIndex = factEndIndexRaw
    if factEndIndex < 0 || factEndIndex > facts.count:
        factEndIndex = facts.count
    if preparedSourceContext.sourcePath != "":
        TypedExprBindingNameIndexPrepare(preparedSourceContext)
    var factCursor = factStartIndex
    for i in exprStartIndex..<exprEndIndex:
        let expr = exprLayer.exprs[i]
        if !TypedExprExprRequiresPersistentFact(expr):
            continue
        if factCursor >= factEndIndex:
            err = Fmt" typed expr: missing persistent fact at {expr.sourcePath}:{expr.lineNumber}"
            return false
        var fact = TypedExprFactAt(facts, factCursor)
        factCursor = factCursor + 1
        let expectedTypeCallKind = TypedExprTypeCallKindForExpr(expr)
        let expectedExprId = TypedExprExprStableId(expr)
        if expectedExprId != fact.exprId:
            err = " typed expr: expr id mismatch"
            return false
        if expr.kind != fact.kind:
            err = " typed expr: expr kind mismatch"
            return false
        if expr.kind == parser.NormalizedExprResultIntrinsic:
            if fact.callKind != TypedExprCallResultIntrinsic:
                err = Fmt" typed expr: result intrinsic fact lost call kind at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if fact.callCallee != expr.surfaceText:
                err = Fmt" typed expr: result intrinsic callee drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if fact.callPrefixStyle != expr.callPrefixStyle ||
               fact.callArgCount != expr.callArgCount ||
               fact.callArgsText != expr.callArgsText ||
               fact.valueExprCallNodeIndex != expr.valueExprCallNodeIndex ||
               fact.originParserNodeId != expr.originParserNodeId ||
               fact.valueExprArgRootStart != expr.callArgValueRootStart ||
               fact.valueExprArgRootCount != expr.callArgValueRootCount:
                err = Fmt" typed expr: result intrinsic structured call drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if fact.callResolved ||
               fact.callTarget != "" ||
               fact.callTargetSourcePath != "" ||
               fact.callTargetImportc:
                err = Fmt" typed expr: result intrinsic leaked resolved target at {expr.sourcePath}:{expr.lineNumber}"
                return false
            continue
        if expr.kind != parser.NormalizedExprCall:
            if fact.surfaceCallKind != TypedExprSurfaceCallNone ||
               fact.callResolved ||
               fact.callReason != TypedExprCallReasonNone ||
               fact.callQualifier != "" ||
               fact.callCallee != "" ||
               fact.callTarget != "" ||
               fact.callTargetSourcePath != "" ||
               fact.callTargetImportc:
                err = Fmt" typed expr: non-call fact leaked call resolution at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if fact.typeCallKind != expectedTypeCallKind &&
               !(expectedTypeCallKind == TypedExprTypeCallConstructor &&
                 fact.typeCallKind == TypedExprTypeCallIdentity):
                err = Fmt" typed expr: non-call fact leaked type-call drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if expectedTypeCallKind != TypedExprTypeCallNone:
                if fact.callPrefixStyle != expr.callPrefixStyle ||
                   fact.callArgCount != expr.callArgCount ||
                   fact.callArgsText != expr.callArgsText:
                    err = Fmt" typed expr: type-call fact args drift at {expr.sourcePath}:{expr.lineNumber}"
                    return false
                if !TypedExprFactValidateTypeCallMaterialize(fact, err):
                    return false
            elif fact.callPrefixStyle ||
                 fact.callArgCount != 0 ||
                 fact.callArgsText != "":
                err = Fmt" typed expr: non-call fact leaked call args at {expr.sourcePath}:{expr.lineNumber}"
                return false
            continue
        if fact.typeCallKind != TypedExprTypeCallNone:
            err = Fmt" typed expr: call fact leaked type-call kind at {expr.sourcePath}:{expr.lineNumber}"
            return false
        # Snapshot metadata deliberately owns no source lines.  Revalidation
        # of the active source must therefore use the prepared full-source
        # context; only cross-source declaration reads stay on frozen metadata.
        var exprContext = TypedExprSourceContextForPathOrCurrent(
            preparedSourceContext, sourceContexts, expr.sourcePath)
        # BorrowedView copies the owner including a stale/poisoned name index
        # (builtCount=-1 after attach or overlay rebuild). Resolve types call
        # args through AssignStatementType → Indexed; rebuild the derived
        # index on this local var before any immutable query.
        TypedExprBindingNameIndexPrepare(exprContext)
        let exprContextPath = parser.ParserNormalizePath(exprContext.sourcePath)
        if exprContextPath == parser.ParserNormalizePath(expr.sourcePath):
            if subTime:
                vaT0 = TypedExprSubTimeNowNs()
            var namedAggregateConstructorType = ""
            if sliceScratch.exprCount == exprLayer.exprs.len:
                # [d2 M2] Producer verdict replay. The derivation reads only
                # the sealed type index (bindings-independent), so the stored
                # value equals a fresh derivation bit for bit.
                namedAggregateConstructorType = sliceScratch.aggregateCtorTypes[i]
            else:
                let constructorHead = TypedExprQualifiedCallSurface(expr.callQualifier,
                                                                     expr.callCallee)
                namedAggregateConstructorType =
                    TypedExprNamedAggregateConstructorTypeInContext(
                        exprContext,
                        sourceContexts,
                        constructorHead,
                        expr.callArgsText)
            if subTime:
                TypedExprSubTimeAccum(TypedExprSubTimeVaAgg, vaT0)
            if namedAggregateConstructorType != "":
                if fact.surfaceCallKind != TypedExprSurfaceCallNone ||
                   fact.callResolved ||
                   fact.callReason != TypedExprCallReasonNone ||
                   fact.callQualifier != "" ||
                   fact.callCallee != "" ||
                   fact.callTarget != "" ||
                   fact.callTargetSourcePath != "" ||
                   fact.callTargetImportc ||
                   fact.callKind != TypedExprCallNone ||
                   fact.callPrefixStyle != expr.callPrefixStyle ||
                   fact.callArgCount != expr.callArgCount ||
                   fact.callArgsText != expr.callArgsText ||
                   fact.typeText != namedAggregateConstructorType ||
                   fact.abiClass == TypedExprAbiPolymorphic ||
                   fact.loweringMode == TypedExprLowerDeferred ||
                   fact.returnKind == TypedExprReturnDeferred:
                    err = Fmt" typed expr: named aggregate constructor drift at {expr.sourcePath}:{expr.lineNumber} surface={fact.surfaceCallKind} resolved={fact.callResolved} reason={fact.callReason} qualifier={fact.callQualifier} callee={fact.callCallee} target={fact.callTarget} target_source={fact.callTargetSourcePath} kind={TypedExprCallKindText(fact.callKind)} prefix={fact.callPrefixStyle} argc={fact.callArgCount} args={fact.callArgsText} expr_prefix={expr.callPrefixStyle} expr_argc={expr.callArgCount} expr_args={expr.callArgsText} type={fact.typeText} want_type={namedAggregateConstructorType} abi={TypedExprAbiClassText(fact.abiClass)} lower={TypedExprLoweringModeText(fact.loweringMode)} return={TypedExprReturnKindText(fact.returnKind)}"
                    return false
                continue
        let surfaceKind = TypedExprSurfaceCallKindFromParser(expr.callSurfaceKind)
        var resolved = expr.callResolved
        var reason = TypedExprCallReasonFromParser(expr.callReason)
        let qualifier = expr.callQualifier
        let callee = expr.callCallee
        var target = expr.callTarget
        var targetSourcePath = expr.callTargetSourcePath
        var targetSignatureLineNumber: int32
        var targetImportc = expr.callTargetImportc
        if surfaceKind == TypedExprSurfaceCallExternal &&
           qualifier != "" &&
           expr.callArgCount <= 0 &&
           expr.callReason == parser.NormalizedExprCallReasonUnknownQualifiedTarget &&
           TypedExprSymbolExportedByCase(callee):
            if exprContextPath != parser.ParserNormalizePath(expr.sourcePath):
                err = Fmt" typed expr: missing source context for qualified type constructor at {expr.sourcePath}:{expr.lineNumber}"
                return false
            let typeSourcePath = TypedExprLookupQualifiedModuleSourcePath(exprContext,
                                                                          sourceContexts,
                                                                          qualifier)
            let typeSourceIndex = TypedExprSourceContextLookup(sourceContexts, typeSourcePath)
            if typeSourceIndex >= 0 &&
               TypedExprSourceHasDeclaredType(sourceContexts[typeSourceIndex], callee):
                let qualifiedType = TypedExprNormalizeTypeText(Fmt"{qualifier}.{callee}")
                if fact.surfaceCallKind != TypedExprSurfaceCallNone ||
                   fact.callResolved ||
                   fact.callReason != TypedExprCallReasonNone ||
                   fact.callQualifier != "" ||
                   fact.callCallee != "" ||
                   fact.callTarget != "" ||
                   fact.callTargetSourcePath != "" ||
                   fact.callTargetImportc ||
                   fact.callKind != TypedExprCallNone ||
                   fact.typeText != qualifiedType ||
                   fact.abiClass == TypedExprAbiPolymorphic ||
                   fact.loweringMode == TypedExprLowerDeferred ||
                   fact.returnKind == TypedExprReturnDeferred:
                    err = Fmt" typed expr: qualified type constructor drift at {expr.sourcePath}:{expr.lineNumber} surface={fact.surfaceCallKind} resolved={fact.callResolved} reason={fact.callReason} qualifier={fact.callQualifier} callee={fact.callCallee} target={fact.callTarget} target_source={fact.callTargetSourcePath} kind={TypedExprCallKindText(fact.callKind)} type={fact.typeText} want_type={qualifiedType} abi={TypedExprAbiClassText(fact.abiClass)} lower={TypedExprLoweringModeText(fact.loweringMode)} return={TypedExprReturnKindText(fact.returnKind)}"
                    return false
                continue
        # [zero-arg-ctor] Same predicate as the producer: a zero-argument
        # call whose callee names a declared type is a construction, and the
        # producer recorded it with `surfaceCallKind == None` and the type
        # applied.  The branch above only covers the qualified half of that
        # shape, so every same-source `T()` -- `var out = LsmrAddress()` at
        # binary_types.cheng:92 -- fell through to the general surface
        # comparison and was reported as `call surface kind drift`.
        if subTime:
            vaT0 = TypedExprSubTimeNowNs()
        var zeroArgConstructorType = ""
        if exprContextPath == parser.ParserNormalizePath(expr.sourcePath) &&
           sliceScratch.exprCount == exprLayer.exprs.len:
            zeroArgConstructorType = sliceScratch.zeroArgCtorTypes[i]
        else:
            zeroArgConstructorType =
                TypedExprZeroArgTypeConstructorTypeName(
                    exprContext, sourceContexts, expr)
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeVaZero, vaT0)
        if zeroArgConstructorType != "":
            if exprContextPath != parser.ParserNormalizePath(expr.sourcePath):
                err = Fmt" typed expr: missing source context for zero-arg type constructor at {expr.sourcePath}:{expr.lineNumber}"
                return false
            let zeroArgType =
                TypedExprNormalizeTypeText(zeroArgConstructorType)
            if fact.surfaceCallKind != TypedExprSurfaceCallNone ||
               fact.callResolved ||
               fact.callReason != TypedExprCallReasonNone ||
               fact.callQualifier != "" ||
               fact.callCallee != "" ||
               fact.callTarget != "" ||
               fact.callTargetSourcePath != "" ||
               fact.callTargetImportc ||
               fact.callKind != TypedExprCallNone ||
               fact.typeText != zeroArgType ||
               fact.abiClass == TypedExprAbiPolymorphic ||
               fact.loweringMode == TypedExprLowerDeferred ||
               fact.returnKind == TypedExprReturnDeferred:
                err = Fmt" typed expr: zero-arg type constructor drift at {expr.sourcePath}:{expr.lineNumber} surface={fact.surfaceCallKind} resolved={fact.callResolved} reason={fact.callReason} qualifier={fact.callQualifier} callee={fact.callCallee} target={fact.callTarget} target_source={fact.callTargetSourcePath} kind={TypedExprCallKindText(fact.callKind)} type={fact.typeText} want_type={zeroArgType} abi={TypedExprAbiClassText(fact.abiClass)} lower={TypedExprLoweringModeText(fact.loweringMode)} return={TypedExprReturnKindText(fact.returnKind)}"
                return false
            continue
        if qualifier != "" &&
           targetSourcePath == "" &&
           surfaceKind != TypedExprSurfaceCallMember:
            if exprContextPath != parser.ParserNormalizePath(expr.sourcePath):
                var contextDiag = ""
                for contextDiagIndex in 0..<sourceContexts.len:
                    if contextDiagIndex >= 20:
                        break
                    if contextDiag != "":
                        contextDiag = Fmt"{contextDiag},"
                    contextDiag = Fmt"{contextDiag}{sourceContexts[contextDiagIndex].sourcePath}|norm={sourceContexts[contextDiagIndex].normalizedSourcePath}"
                var rangeStartSource = ""
                if exprStartIndex >= 0 && exprStartIndex < exprLayer.exprs.len:
                    rangeStartSource = exprLayer.exprs[exprStartIndex].sourcePath
                err = Fmt" typed expr: missing source context for qualified call at {expr.sourcePath}:{expr.lineNumber} source_count={sourceContexts.len} range_start={exprStartIndex} range_end={exprEndIndex} expr_index={i} range_source={rangeStartSource} contexts={contextDiag}"
                return false
            if subTime:
                vaT0 = TypedExprSubTimeNowNs()
            var resolvedSourcePath = ""
            var resolvedTargetName = ""
            var resolvedTargetSignatureLineNumber: int32
            var resolvedImportc = false
            let qualifiedReturnType = TypedExprResolveQualifiedCallTargetReturnType(exprContext,
                                                                                    sourceContexts,
                                                                                    qualifier,
                                                                                    callee,
                                                                                    expr.callTarget,
                                                                                    expr.callArgsText,
                                                                                    expr.lineNumber,
                                                                                    resolvedSourcePath,
                                                                                    resolvedTargetName,
                                                                                    resolvedTargetSignatureLineNumber,
                                                                                    resolvedImportc)
            if subTime:
                TypedExprSubTimeAccum(TypedExprSubTimeVaQual, vaT0)
            if qualifiedReturnType == "":
                if qualifier != "" && targetSourcePath != "" && target != "":
                    resolved = true
                    reason = TypedExprCallReasonNone
                elif qualifier != "":
                    resolved = false
                    reason = TypedExprCallReasonUnknownQualifiedTarget
                    target = ""
                    targetSourcePath = ""
                    targetSignatureLineNumber = 0
                    targetImportc = false
                elif !expr.callResolved && expr.callReason != parser.NormalizedExprCallReasonNone:
                    targetSourcePath = ""
                    targetImportc = false
                else:
                    err = Fmt" typed expr: unknown_qualified_target:{qualifier}:{callee}"
                    return false
            else:
                resolved = true
                reason = TypedExprCallReasonNone
                if target == "":
                    target = resolvedTargetName
                targetSourcePath = resolvedSourcePath
                targetSignatureLineNumber =
                    resolvedTargetSignatureLineNumber
                targetImportc = resolvedImportc
        if TypedExprExprIsBuiltinCall(expr) && fact.callKind == TypedExprCallBuiltin:
            if fact.surfaceCallKind != surfaceKind:
                err = Fmt" typed expr: builtin call surface kind drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if !fact.callResolved || fact.callReason != TypedExprCallReasonNone:
                err = Fmt" typed expr: builtin call resolution drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if fact.callQualifier != qualifier || fact.callCallee != callee:
                err = Fmt" typed expr: builtin call callee drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if !fact.callTargetImportc &&
               (fact.callTarget != "" ||
                fact.callTargetSourcePath != "" ||
                fact.callTargetSignatureLineNumber != 0):
                let importcText = if fact.callTargetImportc: "1" else: "0"
                err = Fmt" typed expr: builtin call leaked runtime target at {expr.sourcePath}:{expr.lineNumber} callee={fact.callCallee} kind={TypedExprCallKindText(fact.callKind)} target={fact.callTarget} target_source={fact.callTargetSourcePath} importc={importcText}"
                return false
            if fact.callPrefixStyle != expr.callPrefixStyle ||
               fact.callArgCount != expr.callArgCount:
                err = Fmt" typed expr: builtin call args drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if fact.callArgsText != expr.callArgsText:
                if !(fact.callArgsText == "" && TypedExprBuiltinFactCanDropArgsText(fact)):
                    err = Fmt" typed expr: builtin call args drift at {expr.sourcePath}:{expr.lineNumber}"
                    return false
            let builtinTypeText = TypedExprBuiltinTypeCallResult(expr)
            var expectedTypeText = "str"
            if builtinTypeText != "":
                expectedTypeText = builtinTypeText
            if fact.callKind != TypedExprCallBuiltin ||
               fact.typeText != expectedTypeText ||
               fact.abiClass == TypedExprAbiPolymorphic ||
               fact.loweringMode == TypedExprLowerDeferred ||
               fact.returnKind == TypedExprReturnDeferred:
                err = Fmt" typed expr: builtin call type drift at {expr.sourcePath}:{expr.lineNumber}"
                return false
            continue
        if targetSourcePath == "" ||
           (!targetImportc && targetSignatureLineNumber <= 0):
            if exprContextPath != parser.ParserNormalizePath(expr.sourcePath):
                err = Fmt" typed expr: missing source context for call target at {expr.sourcePath}:{expr.lineNumber}"
                return false
            # [d2 M3] Replay the producer's first resolution when every input
            # and every state reader is provably identical: plain/member shape
            # (no qualifier delegation on either side), the resolution
            # succeeded at build time, and this fact registered no own binding
            # after its build (same-line self-shadow eligibility would differ).
            # The raw outputs are replayed, not the fact row: canonicalization
            # rewrites fact.callTarget after the build and must stay visible to
            # the comparisons below exactly as before. Reaching this point
            # already proves the same-source gate, so the replayed derivation
            # context equals the build context.
            var replayedResolution = false
            if sliceScratch.exprCount == exprLayer.exprs.len:
                let resolveFlags = sliceScratch.resolveFlags[i]
                if (resolveFlags & 7) == 3:
                    resolved = true
                    reason = TypedExprCallReasonNone
                    target = sliceScratch.resolveTargetNames[i]
                    targetSourcePath = sliceScratch.resolveSourcePaths[i]
                    targetSignatureLineNumber =
                        sliceScratch.resolveSignatureLines[i]
                    targetImportc = (resolveFlags & 8) != 0
                    replayedResolution = true
            if !replayedResolution:
                var resolvedSourcePath = ""
                var resolvedTargetName = ""
                var resolvedTargetSignatureLineNumber: int32
                var resolvedImportc = false
                if subTime:
                    vaT0 = TypedExprSubTimeNowNs()
                let resolvedReturnType = TypedExprResolveCallTargetReturnType(exprContext,
                                                                              sourceContexts,
                                                                              qualifier,
                                                                              callee,
                                                                              target,
                                                                              expr.callArgsText,
                                                                              expr.lineNumber,
                                                                              surfaceKind,
                                                                              resolvedSourcePath,
                                                                              resolvedTargetName,
                                                                              resolvedTargetSignatureLineNumber,
                                                                              resolvedImportc)
                if subTime:
                    TypedExprSubTimeAccum(TypedExprSubTimeVaReresolve, vaT0)
                if resolvedReturnType != "":
                    resolved = true
                    reason = TypedExprCallReasonNone
                    target = resolvedTargetName
                    targetSourcePath = resolvedSourcePath
                    targetSignatureLineNumber =
                        resolvedTargetSignatureLineNumber
                    targetImportc = resolvedImportc
                else:
                    # Sparse prepared overlays can miss text-path resolution.
                    # Revalidate against the owner prepared context's buildIndex
                    # and keep the looked-up signature line off the fact row.
                    var preresolvedSignatureLine: int32
                    let preresolvedReturnType =
                        TypedExprLookupPreresolvedCallTargetSignatureFromFact(
                            preparedSourceContext,
                            sourceContexts,
                            fact,
                            preresolvedSignatureLine)
                    if preresolvedReturnType != "":
                        resolved = true
                        reason = TypedExprCallReasonNone
                        target = fact.callTarget
                        targetSourcePath = fact.callTargetSourcePath
                        targetSignatureLineNumber = preresolvedSignatureLine
                        targetImportc = fact.callTargetImportc
        if fact.surfaceCallKind != surfaceKind:
            err = Fmt" typed expr: call surface kind drift at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callResolved != resolved:
            let factResolvedText = if fact.callResolved: "1" else: "0"
            let expectedResolvedText = if resolved: "1" else: "0"
            err = Fmt" typed expr: call resolved drift at {expr.sourcePath}:{expr.lineNumber} fact={factResolvedText} expected={expectedResolvedText} qualifier={qualifier} callee={callee} fact_target={fact.callTarget} expected_target={target} fact_source={fact.callTargetSourcePath} expected_source={targetSourcePath}"
            return false
        if fact.callReason != reason:
            err = Fmt" typed expr: call reason drift at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callQualifier != qualifier:
            err = Fmt" typed expr: call qualifier drift at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callTargetImportc != targetImportc:
            err = Fmt" typed expr: call importc drift at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callTargetSignatureLineNumber !=
           targetSignatureLineNumber:
            err = Fmt" typed expr: call declaration identity drift at {expr.sourcePath}:{expr.lineNumber} fact_signature_line={fact.callTargetSignatureLineNumber} expected_signature_line={targetSignatureLineNumber}"
            return false
        if fact.callPrefixStyle != expr.callPrefixStyle:
            err = Fmt" typed expr: call prefix style drift at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callArgCount != expr.callArgCount:
            err = Fmt" typed expr: call arg count drift at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callArgsText != expr.callArgsText:
            err = Fmt" typed expr: call args text drift at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callResolved:
            if fact.callReason != TypedExprCallReasonNone:
                err = Fmt" typed expr: resolved call keeps unknown reason at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if fact.callTargetSourcePath == "":
                err = Fmt" typed expr: resolved call missing target source at {expr.sourcePath}:{expr.lineNumber}"
                return false
            if (fact.callTargetImportc &&
                fact.callTargetSignatureLineNumber != 0) ||
               (!fact.callTargetImportc &&
                fact.callTargetSignatureLineNumber <= 0):
                err = Fmt" typed expr: resolved call declaration identity invalid at {expr.sourcePath}:{expr.lineNumber} target={fact.callTarget} signature_line={fact.callTargetSignatureLineNumber}"
                return false
            if fact.surfaceCallKind == TypedExprSurfaceCallExternal:
                let symbolExported = TypedExprSymbolExportedByCase(fact.callCallee)
                if !symbolExported:
                    let ownerLeftIndex = TypedExprSourceContextExactIndex(
                        sourceContexts, expr.sourcePath)
                    let ownerRightIndex = TypedExprSourceContextExactIndex(
                        sourceContexts, fact.callTargetSourcePath)
                    if ownerLeftIndex < 0 || ownerRightIndex < 0:
                        err = Fmt" typed expr: private call missing package owner context at {expr.sourcePath}:{expr.lineNumber} target_source={fact.callTargetSourcePath}"
                        return false
                    let ownerLeft = sourceContexts[ownerLeftIndex].packageOwnerKey
                    let ownerRight = sourceContexts[ownerRightIndex].packageOwnerKey
                    if ownerLeft == "" || ownerRight == "":
                        err = Fmt" typed expr: private call missing package owner identity at {expr.sourcePath}:{expr.lineNumber} target_source={fact.callTargetSourcePath}"
                        return false
                    if ownerLeft != ownerRight:
                        err = Fmt" typed expr: imported private symbol '{fact.callCallee}' is not exported at {expr.sourcePath}:{expr.lineNumber} target_source={fact.callTargetSourcePath}"
                        return false
            if fact.typeText == "" || fact.typeText == "unknown" ||
               fact.typeText == "call_expr":
                let importcText = if fact.callTargetImportc: "1" else: "0"
                err = Fmt" typed expr: resolved call missing concrete type at {expr.sourcePath}:{expr.lineNumber} target={fact.callTarget} target_source={fact.callTargetSourcePath} importc={importcText} type={fact.typeText} qualifier={fact.callQualifier} callee={fact.callCallee}"
                return false
            if !TypedExprTypeIsGenericPlaceholder(fact.typeText) &&
               (fact.abiClass == TypedExprAbiPolymorphic ||
                fact.loweringMode == TypedExprLowerDeferred ||
                fact.returnKind == TypedExprReturnDeferred):
                if exprContextPath != parser.ParserNormalizePath(expr.sourcePath):
                    err = Fmt" typed expr: missing source context for call validation at {expr.sourcePath}:{expr.lineNumber}"
                    return false
                err = Fmt" typed expr: resolved call fell back to deferred at {expr.sourcePath}:{expr.lineNumber} target={fact.callTarget} type={fact.typeText} abi={TypedExprAbiClassText(fact.abiClass)} lower={TypedExprLoweringModeText(fact.loweringMode)} return={TypedExprReturnKindText(fact.returnKind)} target_source={fact.callTargetSourcePath} qualifier={fact.callQualifier} callee={fact.callCallee} surfaceKind={fact.surfaceCallKind}"
                return false
            if TypedExprImportcFactRequiresImportBuffer(fact) &&
               (fact.loweringMode != TypedExprLowerImportBuffer ||
                fact.returnKind != TypedExprReturnImportBuffer):
                err = Fmt" typed expr: imported composite call missing import buffer at {expr.sourcePath}:{expr.lineNumber}"
                return false
            continue
        if fact.callReason == TypedExprCallReasonNone:
            err = Fmt" typed expr: unresolved call missing reason at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callTargetSourcePath != "":
            err = Fmt" typed expr: unresolved call keeps target source at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callTargetImportc:
            err = Fmt" typed expr: unresolved call keeps importc target at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.callTargetSignatureLineNumber != 0:
            err = Fmt" typed expr: unresolved call keeps declaration identity at {expr.sourcePath}:{expr.lineNumber}"
            return false
        if fact.surfaceCallKind == TypedExprSurfaceCallExternal &&
           fact.callQualifier != "" &&
           !TypedExprSymbolExportedByCase(fact.callCallee):
            err = Fmt" typed expr: unknown_qualified_target:{fact.callQualifier}:{fact.callCallee}"
            return false
    if factCursor != factEndIndex:
        err = Fmt" typed expr: extra persistent fact count={factEndIndex - factStartIndex} matched={factCursor - factStartIndex}"
        return false
    err = ""
    return true

fn TypedExprFactsValidateCallResolutionRange(exprLayer: var parser.NormalizedExprLayer,
                                               sourceContexts: var TypedExprSourceContext[],
                                               facts: var TypedExprFactTable,
                                               exprStartIndexRaw: int32,
                                               exprEndIndexRaw: int32,
                                               factStartIndexRaw: int32,
                                               factEndIndexRaw: int32,
                                               err: var str): bool =
    var noPreparedSourceContext: TypedExprSourceContext
    var noScratch: TypedExprSliceResolutionScratch
    return TypedExprFactsValidateCallResolutionRangeWithPreparedContext(
        exprLayer,
        sourceContexts,
        noPreparedSourceContext,
        facts,
        exprStartIndexRaw,
        exprEndIndexRaw,
        factStartIndexRaw,
        factEndIndexRaw,
        noScratch,
        err)

fn TypedExprFactsValidateCallResolution(exprLayer: var parser.NormalizedExprLayer,
                                          sourceContexts: var TypedExprSourceContext[],
                                          facts: var TypedExprFactTable,
                                          err: var str): bool =
    return TypedExprFactsValidateCallResolutionRange(exprLayer,
                                                     sourceContexts,
                                                     facts,
                                                     0,
                                                     exprLayer.exprs.len,
                                                     0,
                                                     facts.count,
                                                     err)

@borrows
fn TypedExprLoweringRuleFillFromFact(fact: TypedExprFact,
                                      out: var TypedExprLoweringRule) =
    let argPassKind = TypedExprArgPassKindForResolved(fact.abiClass, fact.placeKind, fact.loweringMode)
    let resultPassKind = TypedExprResultPassKindForResolved(fact.returnKind)
    var materializeKind = TypedExprMaterializeKindForResolved(fact.valueKind, fact.placeKind, fact.loweringMode)
    var copyKind = TypedExprCopyKindForResolved(fact.valueKind, fact.abiClass)
    if fact.typeCallKind == TypedExprTypeCallIdentity:
        materializeKind = TypedExprMaterializeNone
        copyKind = TypedExprCopyNone
    let importKind = TypedExprImportKindForResolved(fact.callKind, fact.abiClass, fact.loweringMode, fact.returnKind)
    out.exprId = share(fact.exprId)
    out.sourcePath = share(fact.sourcePath)
    out.lineNumber = fact.lineNumber
    out.columnNumber = fact.columnNumber
    out.surfaceCallKind = fact.surfaceCallKind
    out.callResolved = fact.callResolved
    out.callReason = fact.callReason
    out.callQualifier = share(fact.callQualifier)
    out.callCallee = share(fact.callCallee)
    out.callTarget = share(fact.callTarget)
    out.callTargetSourcePath = share(fact.callTargetSourcePath)
    out.callTargetSignatureLineNumber =
        fact.callTargetSignatureLineNumber
    out.callTargetImportc = fact.callTargetImportc
    out.callPrefixStyle = fact.callPrefixStyle
    out.callArgCount = fact.callArgCount
    out.callArgsText = share(fact.callArgsText)
    out.typeText = TypedExprNormalizeTypeText(fact.typeText)
    out.abiClass = fact.abiClass
    out.valueKind = fact.valueKind
    out.placeKind = fact.placeKind
    out.loweringMode = fact.loweringMode
    out.callKind = fact.callKind
    out.typeCallKind = fact.typeCallKind
    out.returnKind = fact.returnKind
    out.returnRoot = fact.returnRoot
    out.argPassKind = argPassKind
    out.resultPassKind = resultPassKind
    out.materializeKind = materializeKind
    out.copyKind = copyKind
    out.importKind = importKind

@borrows
fn TypedExprLoweringRuleClone(rule: TypedExprLoweringRule): TypedExprLoweringRule =
    var out: TypedExprLoweringRule
    out.exprId = strings.CloneStr(rule.exprId)
    out.sourcePath = strings.CloneStr(rule.sourcePath)
    out.lineNumber = rule.lineNumber
    out.columnNumber = rule.columnNumber
    out.surfaceCallKind = rule.surfaceCallKind
    out.callResolved = rule.callResolved
    out.callReason = rule.callReason
    out.callQualifier = strings.CloneStr(rule.callQualifier)
    out.callCallee = strings.CloneStr(rule.callCallee)
    out.callTarget = strings.CloneStr(rule.callTarget)
    out.callTargetSourcePath = strings.CloneStr(rule.callTargetSourcePath)
    out.callTargetSignatureLineNumber =
        rule.callTargetSignatureLineNumber
    out.callTargetImportc = rule.callTargetImportc
    out.callPrefixStyle = rule.callPrefixStyle
    out.callArgCount = rule.callArgCount
    out.callArgsText = strings.CloneStr(rule.callArgsText)
    out.typeText = strings.CloneStr(rule.typeText)
    out.abiClass = rule.abiClass
    out.valueKind = rule.valueKind
    out.placeKind = rule.placeKind
    out.loweringMode = rule.loweringMode
    out.callKind = rule.callKind
    out.typeCallKind = rule.typeCallKind
    out.returnKind = rule.returnKind
    out.returnRoot = rule.returnRoot
    out.argPassKind = rule.argPassKind
    out.resultPassKind = rule.resultPassKind
    out.materializeKind = rule.materializeKind
    out.copyKind = rule.copyKind
    out.importKind = rule.importKind
    return out

@borrows
fn TypedExprLoweringRulesClone(rules: TypedExprLoweringRule[]): TypedExprLoweringRule[] =
    var out: TypedExprLoweringRule[]
    for i in 0..<rules.len:
        add(out, TypedExprLoweringRuleClone(rules[i]))
    return out

fn TypedExprLoweringRuleEqual(lhs: TypedExprLoweringRule,
                                rhs: TypedExprLoweringRule): bool =
    if lhs.exprId != rhs.exprId:
        return false
    if lhs.sourcePath != rhs.sourcePath:
        return false
    if lhs.lineNumber != rhs.lineNumber:
        return false
    if lhs.columnNumber != rhs.columnNumber:
        return false
    if lhs.surfaceCallKind != rhs.surfaceCallKind:
        return false
    if lhs.callResolved != rhs.callResolved:
        return false
    if lhs.callReason != rhs.callReason:
        return false
    if lhs.callQualifier != rhs.callQualifier:
        return false
    if lhs.callCallee != rhs.callCallee:
        return false
    if lhs.callTarget != rhs.callTarget:
        return false
    if lhs.callTargetSourcePath != rhs.callTargetSourcePath:
        return false
    if lhs.callTargetSignatureLineNumber !=
       rhs.callTargetSignatureLineNumber:
        return false
    if lhs.callTargetImportc != rhs.callTargetImportc:
        return false
    if lhs.callPrefixStyle != rhs.callPrefixStyle:
        return false
    if lhs.callArgCount != rhs.callArgCount:
        return false
    if lhs.callArgsText != rhs.callArgsText:
        return false
    if lhs.typeText != rhs.typeText:
        return false
    if lhs.abiClass != rhs.abiClass:
        return false
    if lhs.valueKind != rhs.valueKind:
        return false
    if lhs.placeKind != rhs.placeKind:
        return false
    if lhs.loweringMode != rhs.loweringMode:
        return false
    if lhs.callKind != rhs.callKind:
        return false
    if lhs.callKind == TypedExprCallResultIntrinsic &&
       lhs.callCallee != rhs.callCallee:
        return false
    if lhs.typeCallKind != rhs.typeCallKind:
        return false
    if lhs.returnKind != rhs.returnKind:
        return false
    if lhs.returnRoot != rhs.returnRoot:
        return false
    if lhs.argPassKind != rhs.argPassKind:
        return false
    if lhs.resultPassKind != rhs.resultPassKind:
        return false
    if lhs.materializeKind != rhs.materializeKind:
        return false
    if lhs.copyKind != rhs.copyKind:
        return false
    if lhs.importKind != rhs.importKind:
        return false
    return true

fn TypedExprLoweringRuleShapeEqual(lhs: TypedExprLoweringRule,
                                     rhs: TypedExprLoweringRule): bool =
    if lhs.typeText != rhs.typeText:
        return false
    if lhs.abiClass != rhs.abiClass:
        return false
    if lhs.valueKind != rhs.valueKind:
        return false
    if lhs.placeKind != rhs.placeKind:
        return false
    if lhs.loweringMode != rhs.loweringMode:
        return false
    if lhs.callKind != rhs.callKind:
        return false
    if lhs.typeCallKind != rhs.typeCallKind:
        return false
    if lhs.returnKind != rhs.returnKind:
        return false
    if lhs.returnRoot != rhs.returnRoot:
        return false
    if lhs.argPassKind != rhs.argPassKind:
        return false
    if lhs.resultPassKind != rhs.resultPassKind:
        return false
    if lhs.materializeKind != rhs.materializeKind:
        return false
    if lhs.copyKind != rhs.copyKind:
        return false
    return lhs.importKind == rhs.importKind

fn TypedExprLoweringRuleKey(rule: TypedExprLoweringRule): str =
    var out = ""
    out = strutil.Join([out, "type=", TypedExprNormalizeTypeText(rule.typeText)], "")
    out = strutil.Join([out, ";abi=", TypedExprAbiClassText(rule.abiClass)], "")
    out = strutil.Join([out, ";value=", TypedExprValueKindText(rule.valueKind)], "")
    out = strutil.Join([out, ";place=", TypedExprPlaceKindText(rule.placeKind)], "")
    out = strutil.Join([out, ";lower=", TypedExprLoweringModeText(rule.loweringMode)], "")
    out = strutil.Join([out, ";call=", TypedExprCallKindText(rule.callKind)], "")
    if rule.callKind == TypedExprCallResultIntrinsic:
        out = strutil.Join([out, ";result_intrinsic=", rule.callCallee], "")
        out = strutil.Join([out, ";result_detail=", IntToStr(parser.NormalizedExprDetailKindCode(parser.ParserResultIntrinsicDetailKind(rule.callCallee)))], "")
    out = strutil.Join([out, ";type_call=", TypedExprTypeCallKindText(rule.typeCallKind)], "")
    out = strutil.Join([out, ";return=", TypedExprReturnKindText(rule.returnKind)], "")
    var returnRootText = "0"
    if rule.returnRoot:
        returnRootText = "1"
    out = strutil.Join([out, ";return_root=", returnRootText], "")
    out = strutil.Join([out, ";arg=", TypedExprArgPassKindText(rule.argPassKind)], "")
    out = strutil.Join([out, ";result=", TypedExprResultPassKindText(rule.resultPassKind)], "")
    out = strutil.Join([out, ";materialize=", TypedExprMaterializeKindText(rule.materializeKind)], "")
    out = strutil.Join([out, ";copy=", TypedExprCopyKindText(rule.copyKind)], "")
    out = strutil.Join([out, ";import=", TypedExprImportKindText(rule.importKind)], "")
    return out

fn TypedExprLoweringRuleEntryText(rule: TypedExprLoweringRule): str =
    var out = ""
    let callReasonText = TypedExprCallReasonText(rule.callReason)
    out = strutil.Join([out, "source=", rule.sourcePath], "")
    out = strutil.Join([out, ";line=", IntToStr(rule.lineNumber)], "")
    out = strutil.Join([out, ";column=", IntToStr(rule.columnNumber)], "")
    out = strutil.Join([out, ";expr=", rule.exprId], "")
    out = strutil.Join([out, ";surface_call=", TypedExprSurfaceCallKindText(rule.surfaceCallKind)], "")
    out = strutil.Join([out, ";type_call=", TypedExprTypeCallKindText(rule.typeCallKind)], "")
    var resolvedText = "0"
    if rule.callResolved:
        resolvedText = "1"
    out = strutil.Join([out, ";resolved=", resolvedText], "")
    if callReasonText != "":
        out = strutil.Join([out, ";reason=", callReasonText], "")
    if rule.callQualifier != "":
        out = strutil.Join([out, ";qualifier=", rule.callQualifier], "")
    if rule.callCallee != "":
        out = strutil.Join([out, ";callee=", rule.callCallee], "")
    if rule.callTarget != "":
        out = strutil.Join([out, ";target=", rule.callTarget], "")
    if rule.callTargetSourcePath != "":
        out = strutil.Join([out, ";target_source=", rule.callTargetSourcePath], "")
    if rule.callTargetSignatureLineNumber > 0:
        out = strutil.Join([out,
                            ";target_signature_line=",
                            IntToStr(rule.callTargetSignatureLineNumber)], "")
    if rule.callTargetImportc:
        out = strutil.Join([out, ";target_importc=1"], "")
    if rule.callPrefixStyle:
        out = strutil.Join([out, ";prefix_style=1"], "")
    if rule.callArgCount > 0:
        out = strutil.Join([out, ";arg_count=", IntToStr(rule.callArgCount)], "")
    if rule.returnRoot:
        out = strutil.Join([out, ";return_root=1"], "")
    out = strutil.Join([out, ";key=", TypedExprLoweringRuleKey(rule)], "")
    return out

fn TypedExprLoweringRulesEqual(lhs: TypedExprLoweringRule[],
                                 rhs: TypedExprLoweringRule[]): bool =
    if lhs.len != rhs.len:
        return false
    for i in 0..<lhs.len:
        if !TypedExprLoweringRuleEqual(lhs[i], rhs[i]):
            return false
    return true

fn TypedExprLoweringRulesFromFacts(facts: var TypedExprFactTable): TypedExprLoweringRule[] =
    var out: TypedExprLoweringRule[]
    for i in 0..<facts.count:
        var rule: TypedExprLoweringRule
        TypedExprLoweringRuleFillFromFact(TypedExprFactAt(facts, i), rule)
        add(out, rule)
    return out

fn TypedExprLoweringRuleUniqueShapeCount(rules: TypedExprLoweringRule[]): int32 =
    var count: int32
    var uniqueRules: TypedExprLoweringRule[]
    for i in 0..<rules.len:
        var seen = false
        for j in 0..<uniqueRules.len:
            if TypedExprLoweringRuleShapeEqual(uniqueRules[j], rules[i]):
                seen = true
                break
        if seen:
            continue
        add(uniqueRules, TypedExprLoweringRuleClone(rules[i]))
        count = count + 1
    return count

fn TypedExprLoweringRuleUniqueKeyCount(rules: TypedExprLoweringRule[]): int32 =
    var count: int32
    var keys: str[]
    for i in 0..<rules.len:
        let key = TypedExprLoweringRuleKey(rules[i])
        if parser.ParserStringSeqContainsExact(keys, key):
            continue
        add(keys, key)
        count = count + 1
    return count

fn TypedExprLoweringRuleCountArgPassKind(rules: TypedExprLoweringRule[],
                                           kind: TypedExprArgPassKind): int32 =
    var count: int32
    for i in 0..<rules.len:
        if rules[i].argPassKind == kind:
            count = count + 1
    return count

fn TypedExprLoweringRuleCountResultPassKind(rules: TypedExprLoweringRule[],
                                              kind: TypedExprResultPassKind): int32 =
    var count: int32
    for i in 0..<rules.len:
        if rules[i].resultPassKind == kind:
            count = count + 1
    return count

fn TypedExprLoweringRuleCountMaterializeKind(rules: TypedExprLoweringRule[],
                                               kind: TypedExprMaterializeKind): int32 =
    var count: int32
    for i in 0..<rules.len:
        if rules[i].materializeKind == kind:
            count = count + 1
    return count

fn TypedExprLoweringRuleCountCopyKind(rules: TypedExprLoweringRule[],
                                        kind: TypedExprCopyKind): int32 =
    var count: int32
    for i in 0..<rules.len:
        if rules[i].copyKind == kind:
            count = count + 1
    return count

fn TypedExprLoweringRuleCountImportKind(rules: TypedExprLoweringRule[],
                                          kind: TypedExprImportKind): int32 =
    var count: int32
    for i in 0..<rules.len:
        if rules[i].importKind == kind:
            count = count + 1
    return count

fn TypedExprLoweringRuleCountTypeCallKind(rules: TypedExprLoweringRule[],
                                            typeCallKind: TypedExprTypeCallKind): int32 =
    var count: int32
    for i in 0..<rules.len:
        if rules[i].typeCallKind == typeCallKind:
            count = count + 1
    return count

fn TypedExprLoweringRuleReturnRootCount(rules: TypedExprLoweringRule[]): int32 =
    var count: int32
    for i in 0..<rules.len:
        if rules[i].returnRoot:
            count = count + 1
    return count

fn TypedExprReportAppendLine(out: var str,
                              key: str,
                              value: str) =
    out = strutil.Join(
        [strings.CloneStr(out),
         strings.CloneStr(key),
         "=",
         strings.CloneStr(value),
         "\n"],
        "")

