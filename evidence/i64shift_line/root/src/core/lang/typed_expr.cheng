fn TypedExprFactCountSurfaceCallKind(facts: var TypedExprFactTable,
                                       kind: TypedExprSurfaceCallKind): int32 =
    var count: int32
    for i in 0..<facts.count:
        if TypedExprFactAt(facts, i).surfaceCallKind == kind:
            count = count + 1
    return count

fn TypedExprFactCountCallResolved(facts: var TypedExprFactTable): int32 =
    var count: int32
    for i in 0..<facts.count:
        let factRowI = TypedExprFactAt(facts, i)
        if factRowI.kind != parser.NormalizedExprCall:
            continue
        if factRowI.callResolved:
            count = count + 1
    return count

fn TypedExprFactCountCallUnresolved(facts: var TypedExprFactTable): int32 =
    var count: int32
    for i in 0..<facts.count:
        let factRowI = TypedExprFactAt(facts, i)
        if factRowI.kind != parser.NormalizedExprCall:
            continue
        if !factRowI.callResolved:
            count = count + 1
    return count

fn TypedExprFactCountCallReason(facts: var TypedExprFactTable,
                                  reason: TypedExprCallReason): int32 =
    var count: int32
    for i in 0..<facts.count:
        if TypedExprFactAt(facts, i).callReason != reason:
            continue
        count = count + 1
    return count

fn TypedExprFactCountCallTargetImportc(facts: var TypedExprFactTable): int32 =
    var count: int32
    for i in 0..<facts.count:
        if TypedExprFactAt(facts, i).callTargetImportc:
            count = count + 1
    return count

