fn TypedExprFactCountAbiClass(facts: var TypedExprFactTable,
                                abiClass: TypedExprAbiClass): int32 =
    var count: int32
    for i in 0..<facts.count:
        if TypedExprFactAt(facts, i).abiClass == abiClass:
            count = count + 1
    return count

