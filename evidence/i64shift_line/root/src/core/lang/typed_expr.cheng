    out.canonicalMetadataTransferred = index.canonicalMetadataTransferred
    out.hardError = index.hardError
    return out

@borrows
fn TypedExprBuildIndexRelease(index: TypedExprBuildIndex) =
    if index == nil:
        return
    if index.released:
        panic("typed expr: build index released more than once")
    if index.released:
        panic("typed expr: build index released more than once")
    # [orcd9-inst] 步进标记：O8B=n = 本函数第 n 个托管释放动作（共 140），
    # registry_miss 前最后一条 O8B 编号 = 致命动作。
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(),
                     Fmt"O8BENTER entries={index.entryKinds.len} names={index.entryNames.len} ctxPaths={index.contextSourcePaths.len} rel={index.releaseCount}")
    # [D-B2a] the intern pool is owned by the index; every column shared
    # handle dies with it (released shell keeps no live column).
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=1")
    langintern.InternPoolRelease(index.internPool)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=2")
    index.internPool = nil
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=3")
    index.canonicalProjection = nil
    index.compactCanonical = false
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=4")
    index.entryKindIds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=5")
    index.entrySourcePathIds = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8B=6")
