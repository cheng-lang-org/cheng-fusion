fn TypedExprIrCompactForBackend(ir: var TypedExprIr) =
    # combo C Phase1: this compaction mutated only the AoS statements[] (exprId/
    # callTarget dedup). Consumers now read the parallel SoA columns, which this
    # loop never touched, so the work was already dead for output. AoS producer
    # writes have been removed (statements[] stays empty). The remaining backend
    # compaction is the intern lookup index: after TypedIR construction, consumers
    # only need InternId -> text lookup, so the text -> InternId index is released.
    if !TypedExprIrLocalBindingIndexComplete(ir):
        panic("typed expr: local-binding index incomplete before backend handoff")
    if ir.typedExprMetadataSession != nil:
        if !ir.typedExprMetadataSession.closed:
            panic("typed expr: backend compaction requires frozen metadata session close")
        typedExprIrDisposeFrozenMetadataSession(ir)
    ir.localBindingNameIndexSealed = true
    TypedExprIrClearTransientIndexes(ir)
    TypedExprBuildIndexReleaseContentCache(ir.buildIndex)
    langintern.InternPoolReleaseIndex(ir.internPool)

fn TypedExprIrReleaseInternIndex(ir: var TypedExprIr) =
    langintern.InternPoolReleaseIndex(ir.internPool)

@borrows
@borrow_result
fn TypedExprIrBuildIndex(ir: var TypedExprIr): TypedExprBuildIndex =
    return ir.buildIndex

fn TypedExprIrReleaseBuildIndex(ir: var TypedExprIr) =
    typedExprIrDisposeFrozenMetadataSession(ir)
    if ir.buildIndex == nil:
        return
    if ir.buildIndex.released:
        panic("typed expr: IR owner holds released build index")
    var ownedBuildIndex: TypedExprBuildIndex
    ownedBuildIndex = ir.buildIndex
    ir.buildIndex = nil
    TypedExprBuildIndexRelease(ownedBuildIndex)

fn TypedExprIrClearTransientIndexes(ir: var TypedExprIr) =
    # Local-binding lookup remains live through primary/backend2. Clearing it
    # here forced every backend query back to a full binding-table scan.
    ir.sourceContextIndexSourcePaths = []
    ir.sourceContextIndexBucketHeads = []
    ir.sourceContextIndexEntryNext = []
    ir.sourceContextIndexEntryIndexes = []
    ir.statementFunctionIndexBucketHeads = []
    ir.statementFunctionIndexEntryNext = []
    ir.statementFunctionIndexEntryStatementIndexes = []
    ir.statementFunctionIndexEntryNames = []
    ir.statementFnBindingIndexBucketHeads = []
    ir.statementFnBindingIndexEntryNext = []
    ir.statementFnBindingIndexEntryStatementIndexes = []
    ir.statementFnBindingIndexEntryFunctionNames = []
    ir.statementFnBindingIndexEntryBindingNames = []
    ir.paramRefIndexBucketHeads = []
    ir.paramRefIndexEntryNext = []
    ir.paramRefIndexEntryNodeIndexes = []
    ir.paramRefIndexEntrySourcePaths = []
    ir.paramRefIndexEntryFunctionNames = []
    ir.paramRefIndexEntryParamNames = []
    ir.nodesTailOwnerSourcePathId = 0
    ir.nodesTailOwnerFunctionNameId = 0
    ir.nodesTailBlockStartNodeIndex = 0

fn TypedExprReturnOpFactClone(fact: TypedExprReturnOpFact): TypedExprReturnOpFact =
    var out: TypedExprReturnOpFact
    out.sourcePath = fact.sourcePath
    out.functionName = fact.functionName
    out.signatureLineNumber = fact.signatureLineNumber
    out.bodyLineNumber = fact.bodyLineNumber
    out.opKind = fact.opKind
    out.returnType = fact.returnType
    out.lhsName = fact.lhsName
    out.lhsType = fact.lhsType
    out.rhsName = fact.rhsName
    out.rhsType = fact.rhsType
    out.accName = fact.accName
    out.accType = fact.accType
    out.returnExpr = fact.returnExpr
    return out

fn TypedExprReturnOpFactsClone(facts: TypedExprReturnOpFact[]): TypedExprReturnOpFact[] =
    var out: TypedExprReturnOpFact[]
    for i in 0..<facts.len:
        add(out, TypedExprReturnOpFactClone(facts[i]))
    return out

@borrows
fn TypedExprReturnOpFactsCountKind(facts: TypedExprReturnOpFact[],
                                    kind: TypedExprReturnOpKind): int32 =
    var count: int32
    for i in 0..<facts.len:
        if facts[i].opKind == kind:
            count = count + 1
    return count

@borrows
fn TypedExprReturnOpFactsKindListText(facts: TypedExprReturnOpFact[]): str =
    if facts.len <= 0:
        return "-"
    var out = ""
    for i in 0..<facts.len:
        if i > 0:
            out = strutil.Join([out, ","], "")
        out = strutil.Join([out, TypedExprReturnOpKindText(facts[i].opKind)], "")
    return out

@borrows
fn TypedExprIrCountOpKind(ir: TypedExprIr,
                           kind: TypedExprIrOpKind): int32 =
    var count: int32
    for i in 0..<ir.nodes2_opKinds.len:
        if ir.nodes2_opKinds[i] == kind:
            count = count + 1
    return count

@borrows
fn TypedExprIrCountStatementKind(ir: TypedExprIr,
                                  kind: TypedExprIrStatementKind): int32 =
    var count: int32
    for i in 0..<ir.statements2_kinds.len:
        if ir.statements2_kinds[i] == kind:
            count = count + 1
    return count

@borrows
fn TypedExprIrCountColdCsgStatementKind(ir: TypedExprIr,
                                         kind: str): int32 =
    var count: int32
    for i in 0..<ir.coldCsgStatementRows.len:
        if ir.coldCsgStatementRows[i].kind == kind:
            count = count + 1
    return count

@borrows
fn TypedExprIrReturnCountOpKind(ir: TypedExprIr,
                                 kind: TypedExprIrOpKind): int32 =
    var count: int32
    for i in 0..<ir.functions2_returnNodeIndexs.len:
        let returnIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_returnNodeIndexs, i)
        if returnIndex < 0 || returnIndex >= ir.nodes2_opKinds.len:
            continue
        if ir.nodes2_opKinds[returnIndex] == kind:
            count = count + 1
    return count

@borrows
fn TypedExprBootstrapContractTextStable(text: str): bool =
    for i in 0..<text.len:
        if text[i] < Char(32) || text[i] > Char(126):
            return false
    return true

@borrows
fn TypedExprBootstrapContractTypeOk(typeRaw: str): bool =
    var typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        typeText = "void"
    if typeText == "unknown":
        return false
    if !TypedExprBootstrapContractTextStable(typeText):
        return false
    return parser.ParserFindText(typeText, "unknown") < 0

@borrows
fn TypedExprBootstrapContractFail(functionName: str,
                                  lineNumber: int32,
                                  detailCode: int32,
                                  detailOut: var int32,
                                  reasonOut: var str,
                                  reason: str): bool =
    detailOut = detailCode
    reasonOut = Fmt"typed_ir_contract function={functionName} line={lineNumber} reason={reason}"
    return false

@borrows
fn TypedExprBootstrapContractValidateWholeCall(functionName: str,
                                                lineNumber: int32,
                                                textRaw: str,
                                                detailOut: var int32,
                                                reasonOut: var str): bool =
    var text = chengpath.PathTrim(textRaw)
    if parser.ParserStartsWith(text, "return "):
        text = chengpath.PathTrim(chengpath.TextSlice(text, 7, text.len - 7))
    let openPos = TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0:
        return true
    let closePos = TypedExprFindMatchingParen(text, openPos)
    if closePos <= openPos:
        return TypedExprBootstrapContractFail(functionName,
                                             lineNumber,
                                             150,
                                             detailOut,
                                             reasonOut,
                                             "malformed_whole_call_surface")
    let callHead = chengpath.PathTrim(chengpath.TextSlice(text, 0, openPos))
    if !TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        # 位运算/复合表达式（如 b0 | (b1 << 8)）里第一个 '(' 属于子表达式，
        # 不是整行函数调用 —— 契约只约束「整行调用」，此类应放行。
        # 判断：第一个 '(' 必须紧跟在第一个 token 之后才是真调用头
        # （token 与 '(' 之间只能有泛型/点分续段，不能有运算符）。
        let firstToken = parser.ParserFirstToken(text)
        let firstTokenEnd = strings.Len(firstToken)
        if firstToken == "" || firstTokenEnd != openPos:
            return true
        return TypedExprBootstrapContractFail(functionName,
                                             lineNumber,
                                             151,
                                             detailOut,
                                             reasonOut,
                                             "invalid_whole_call_head")
    if closePos + 1 != text.len:
        return true
    return true

fn TypedExprBootstrapContractValidateFunction(ir: var TypedExprIr,
                                              typedFnIndex: int32,
                                              detailOut: var int32,
                                              reasonOut: var str): bool =
    detailOut = 0
    reasonOut = ""
    if typedFnIndex < 0 || typedFnIndex >= ir.functions2_functionNameIds.len:
        return TypedExprBootstrapContractFail("",
                                             0,
                                             100,
                                             detailOut,
                                             reasonOut,
                                             "function_index_out_of_range")
    let functionNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[typedFnIndex])
    if !IsOk(functionNameRes):
        return TypedExprBootstrapContractFail("",
                                             arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, typedFnIndex),
                                             199,
                                             detailOut,
                                             reasonOut,
                                             "function_name_lookup_miss")
    let functionName = Value(functionNameRes)
    if !TypedExprBootstrapContractTextStable(functionName):
        return TypedExprBootstrapContractFail(functionName,
                                             arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, typedFnIndex),
                                             101,
                                             detailOut,
                                             reasonOut,
                                             "unstable_function_name")
    let returnTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_returnTypeIds[typedFnIndex])
    if !IsOk(returnTypeRes):
        return TypedExprBootstrapContractFail(functionName,
                                             arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, typedFnIndex),
                                             199,
                                             detailOut,
                                             reasonOut,
                                             "return_type_lookup_miss")
    if !TypedExprBootstrapContractTypeOk(Value(returnTypeRes)):
        return TypedExprBootstrapContractFail(functionName,
                                             arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, typedFnIndex),
                                             102,
                                             detailOut,
                                             reasonOut,
                                             "unstable_return_type")
    var nodeEnd = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, typedFnIndex) + arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeCounts, typedFnIndex)
    if arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, typedFnIndex) < 0 || arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, typedFnIndex) > ir.nodes2_nodeIndexs.len:
        return TypedExprBootstrapContractFail(functionName,
                                             arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, typedFnIndex),
                                             103,
                                             detailOut,
                                             reasonOut,
                                             "node_range_start_invalid")
    if nodeEnd > ir.nodes2_nodeIndexs.len:
        nodeEnd = ir.nodes2_nodeIndexs.len
    for nodeIndex in arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, typedFnIndex)..<nodeEnd:
        if ir.nodes2_opKinds[nodeIndex] == TypedExprIrOpUnsupported:
            return TypedExprBootstrapContractFail(functionName,
                                                 arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_lineNumbers, nodeIndex),
                                                 110,
                                                 detailOut,
                                                 reasonOut,
                                                 "unsupported_node")
        if ir.nodes2_opKinds[nodeIndex] == TypedExprIrOpParamRef:
            let nodeResultTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[nodeIndex])
            if !IsOk(nodeResultTypeRes):
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_lineNumbers, nodeIndex),
                                                     199,
                                                     detailOut,
                                                     reasonOut,
                                                     "node_result_type_lookup_miss")
            if !TypedExprBootstrapContractTypeOk(Value(nodeResultTypeRes)):
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_lineNumbers, nodeIndex),
                                                     111,
                                                     detailOut,
                                                     reasonOut,
                                                     "unstable_param_type")
    var stmtEnd = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, typedFnIndex) + arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementCounts, typedFnIndex)
    if arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, typedFnIndex) < 0 || arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, typedFnIndex) > ir.statements2_statementIndexs.len:
        return TypedExprBootstrapContractFail(functionName,
                                             arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, typedFnIndex),
                                             120,
                                             detailOut,
                                             reasonOut,
                                             "statement_range_start_invalid")
    if stmtEnd > ir.statements2_statementIndexs.len:
        stmtEnd = ir.statements2_statementIndexs.len
    for stmtIndex in arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, typedFnIndex)..<stmtEnd:
        let statementSurfaceRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_surfaceTextIds[stmtIndex])
        if !IsOk(statementSurfaceRes):
            return TypedExprBootstrapContractFail(functionName,
                                                 arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                 199,
                                                 detailOut,
                                                 reasonOut,
                                                 "statement_surface_lookup_miss")
        let statementSurface = chengpath.PathTrim(Value(statementSurfaceRes))
        let statementResultTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_resultTypeIds[stmtIndex])
        if !IsOk(statementResultTypeRes):
            return TypedExprBootstrapContractFail(functionName,
                                                 arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                 199,
                                                 detailOut,
                                                 reasonOut,
                                                 "statement_result_type_lookup_miss")
        let statementResultType = Value(statementResultTypeRes)
        if ir.statements2_kinds[stmtIndex] == TypedExprIrStmtUnsupported:
            if statementSurface != "break" && statementSurface != "continue":
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                     130,
                                                     detailOut,
                                                     reasonOut,
                                                     "unsupported_statement")
        var bareVoidReturn: bool
        if ir.statements2_kinds[stmtIndex] == TypedExprIrStmtReturn:
            if statementSurface == "":
                bareVoidReturn = true
            elif statementSurface == "return":
                bareVoidReturn = true
        if len(statementResultType) > 0:
            if !bareVoidReturn:
                if !TypedExprBootstrapContractTypeOk(statementResultType):
                    let typeFail = TypedExprBootstrapContractFail(functionName,
                                                                  arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                                  131,
                                                                  detailOut,
                                                                  reasonOut,
                                                                  "unstable_statement_type")
                    return typeFail
        var statementCarriesCall: bool
        if ir.statements2_kinds[stmtIndex] == TypedExprIrStmtLetCall:
            statementCarriesCall = true
        elif ir.statements2_kinds[stmtIndex] == TypedExprIrStmtCall:
            statementCarriesCall = true
        elif ir.statements2_kinds[stmtIndex] == TypedExprIrStmtIfCall:
            statementCarriesCall = true
        if statementCarriesCall:
            let callTargetRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_callTargetIds[stmtIndex])
            if !IsOk(callTargetRes):
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                     199,
                                                     detailOut,
                                                     reasonOut,
                                                     "call_target_lookup_miss")
            let callTarget = Value(callTargetRes)
            if callTarget == "":
                # [wall133] builtin echo 语句臂豁免（wall113 合法现状镜像，wall132 spec）：
                # echo/Echo 是 parser builtin，typed 结构解析对其早退，语句列
                # callTarget="" 是既有列契约（7052-7057 两列同序落列）；primary
                # :54883 wall113 自足发射臂以同一谓词消费
                # （len(target)==0 && callee∈{echo,Echo}），kernel 链 typed 契约
                # 门是三链中唯一未对齐该现状的消费者。仅放行 callee∈{echo,Echo}
                # 的空 target 行，其余空 target 仍 140 fail-closed 零弱化；
                # 141/142 原样落穿（空串 TextStable=true，echo resultType=void
                # TypeOk=true）。
                let callCalleeLookup: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_callCalleeIds[stmtIndex])
                var echoBuiltinArm = false
                if IsOk(callCalleeLookup):
                    let callCalleeText = Value(callCalleeLookup)
                    if callCalleeText == "echo" || callCalleeText == "Echo":
                        echoBuiltinArm = true
                if !echoBuiltinArm:
                    return TypedExprBootstrapContractFail(functionName,
                                                         arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                         140,
                                                         detailOut,
                                                         reasonOut,
                                                         "missing_call_target")
            if !TypedExprBootstrapContractTextStable(callTarget):
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                     141,
                                                     detailOut,
                                                     reasonOut,
                                                     "unstable_call_target")
            if !TypedExprBootstrapContractTypeOk(statementResultType):
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                     142,
                                                     detailOut,
                                                     reasonOut,
                                                     "unstable_call_result_type")
        if ir.statements2_kinds[stmtIndex] == TypedExprIrStmtResultIntrinsic:
            let callCalleeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_callCalleeIds[stmtIndex])
            if !IsOk(callCalleeRes):
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                     199,
                                                     detailOut,
                                                     reasonOut,
                                                     "call_callee_lookup_miss")
            let callCallee = Value(callCalleeRes)
            if callCallee == "":
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                     143,
                                                     detailOut,
                                                     reasonOut,
                                                     "missing_result_intrinsic")
            if !TypedExprBootstrapContractTextStable(callCallee):
                return TypedExprBootstrapContractFail(functionName,
                                                     arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                     144,
                                                     detailOut,
                                                     reasonOut,
                                                     "unstable_result_intrinsic")
        if ir.statements2_kinds[stmtIndex] == TypedExprIrStmtReturn:
            if TypedExprFactsStderrTraceEnabled():
                let bailReason = ir.statements2_rhsBailReasons[stmtIndex]
                TypedExprFactsStderrTrace(Fmt"d3_validate_whole_call_atomic fn={functionName} stmt={stmtIndex} rhs_bail_reason={int32(bailReason)}")
            if !TypedExprBootstrapContractValidateWholeCall(functionName,
                                                           arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, stmtIndex),
                                                           statementSurface,
                                                           detailOut,
                                                           reasonOut):
                return false
    return true
    return true

@borrows
fn TypedExprIrReturnKindListText(ir: TypedExprIr): str =
    var out = ""
    for i in 0..<ir.functions2_returnNodeIndexs.len:
        let returnIndex = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_returnNodeIndexs, i)
        if returnIndex < 0 || returnIndex >= ir.nodes2_opKinds.len:
            continue
        let kind = ir.nodes2_opKinds[returnIndex]
        if kind == TypedExprIrOpUnsupported || kind == TypedExprIrOpParamRef:
            continue
        if Len(out) > 0:
            out = strutil.Join([out, ","], "")
        out = strutil.Join([out, TypedExprIrOpKindText(kind)], "")
    if Len(out) <= 0:
        return "-"
    return out

fn TypedExprImportKindForResolved(callKind: TypedExprCallKind,
                                    abiClass: TypedExprAbiClass,
                                    loweringMode: TypedExprLoweringMode,
                                    returnKind: TypedExprReturnKind): TypedExprImportKind =
    if loweringMode == TypedExprLowerDeferred || abiClass == TypedExprAbiPolymorphic:
        return TypedExprImportDeferred
    if loweringMode == TypedExprLowerImportBuffer || returnKind == TypedExprReturnImportBuffer:
        return TypedExprImportImportBuffer
    if callKind == TypedExprCallBuiltin:
        if abiClass == TypedExprAbiComposite:
            return TypedExprImportBuiltinAddressSlot
        return TypedExprImportBuiltinValueSlot
    if abiClass == TypedExprAbiComposite:
        return TypedExprImportI32AddressSlot
    return TypedExprImportI32ValueSlot

@borrows
fn TypedExprExprIsBuiltinStringifyCall(expr: parser.NormalizedExpr): bool =
    if expr.kind != parser.NormalizedExprCall:
        return false
    if expr.callCallee == "$" || expr.callTarget == "$":
        return true
    return false

@borrows
fn TypedExprExprIsBuiltinSeqAddCall(expr: parser.NormalizedExpr): bool =
    if expr.kind != parser.NormalizedExprCall:
        return false
    if chengpath.PathTrim(expr.callQualifier) != "":
        return false
    let callee = chengpath.PathTrim(expr.callCallee)
    if callee != "add":
        return false
    if expr.callArgCount != 2:
        return false
    return true

@borrows
fn TypedExprBuiltinCalleeIsSideEffectStatement(calleeRaw: str): bool =
    let callee = chengpath.PathTrim(calleeRaw)
    if callee == "memRetain" || callee == "memRelease":
        return true
    if callee == "add" || callee == "assert":
        return true
    if callee == "echo" || callee == "Echo":
        return true
    if callee == "setLen" || callee == "reserve" || callee == "clear":
        return true
    if callee == "BytesSet" || callee == "BytesFree" || callee == "BytesCopyInto":
        return true
    if callee == "RawmemCopy" || callee == "RawmemSet" ||
       callee == "RawmemWriteI8" || callee == "RawmemWriteChar":
        return true
    return false

@borrows
fn TypedExprExprRequiresPersistentFact(expr: parser.NormalizedExpr): bool =
    if expr.kind == parser.NormalizedExprResultIntrinsic:
        return true
    if expr.kind == parser.NormalizedExprTry:
        return true
    if expr.kind == parser.NormalizedExprDefaultInit:
        return true
    if expr.kind == parser.NormalizedExprConstructor:
        return true
    if expr.kind != parser.NormalizedExprCall:
        return false
    if expr.surfaceText == "":
        return false
    return true

@borrows
fn TypedExprFactIsBuiltinSeqAddCall(fact: TypedExprFact): bool =
    if fact.kind != parser.NormalizedExprCall:
        return false
    if fact.callKind != TypedExprCallBuiltin:
        return false
    if chengpath.PathTrim(fact.callQualifier) != "":
        return false
    let callee = chengpath.PathTrim(fact.callCallee)
    if callee != "add":
        return false
    if fact.callArgCount != 2:
        return false
    return true

@borrows
fn TypedExprBuiltinFactCanDropArgsText(fact: TypedExprFact): bool =
    if fact.kind != parser.NormalizedExprCall:
        return false
    if fact.callKind != TypedExprCallBuiltin:
        return false
    if TypedExprFactIsBuiltinSeqAddCall(fact):
        return false
    if TypedExprBuiltinCalleeIsSideEffectStatement(fact.callCallee):
        return false
    return true

@borrows
fn TypedExprBuiltinCalleeReturnType(calleeRaw: str,
                                    argsTextRaw: str,
                                    argCount: int32): str =
    let callee = chengpath.PathTrim(calleeRaw)
    if callee == "add" && argCount == 2:
        return "void"
    if callee == "assert" && argCount >= 1:
        return "void"
    if (callee == "echo" || callee == "Echo") && argCount == 1:
        return "void"
    if callee == "setLen" || callee == "reserve" || callee == "clear":
        return "void"
    if callee == "len" || callee == "Len":
        return "int32"
    if callee == "sizeof":
        return "int32"
    if callee == "NewStringAlloc" || callee == "NewStringCopy":
        return "str"
    if callee == "StrDataPtr":
        return "ptr"
    if callee == "BytesAlloc":
        return "rawbytes.Bytes"
    if callee == "BytesLen" || callee == "BytesGet":
        return "int32"
    if callee == "BytesSet" || callee == "BytesFree" || callee == "BytesCopyInto":
        return "void"
    if callee == "RawmemCopy" || callee == "RawmemSet" ||
       callee == "RawmemWriteI8" || callee == "RawmemWriteChar":
        return "void"
    if callee == "memRetain" || callee == "memRelease":
        return "void"
    if callee == "memAllocCount":
        return "int64"
    if callee == "bool" ||
       callee == "char" ||
       callee == "int8" ||
       callee == "Int8" ||
       callee == "int16" ||
       callee == "Int16" ||
       callee == "int32" ||
       callee == "Int32" ||
       callee == "int64" ||
       callee == "Int64" ||
       callee == "uint8" ||
       callee == "UInt8" ||
       callee == "uint16" ||
       callee == "UInt16" ||
       callee == "uint32" ||
       callee == "UInt32" ||
       callee == "uint64" ||
       callee == "UInt64" ||
       callee == "float32" ||
       callee == "float64" ||
       callee == "str" ||
       callee == "ptr" ||
       callee == "cstring" ||
       callee == "utf8_view" ||
       callee == "bytes_view" ||
       callee == "owned_cstring":
        if callee == "Int8":
            return "int8"
        if callee == "Int16":
            return "int16"
        if callee == "Int32":
            return "int32"
        if callee == "Int64":
            return "int64"
        if callee == "UInt8":
            return "uint8"
        if callee == "UInt16":
            return "uint16"
        if callee == "UInt32":
            return "uint32"
        if callee == "UInt64":
            return "uint64"
        return callee
    if callee == "new" && argCount == 1:
        let typeText = TypedExprNormalizeTypeText(argsTextRaw)
        if typeText != "":
            return Fmt"ref{typeText}"
    return ""

@borrows
fn TypedExprBuiltinTypeCallResult(expr: parser.NormalizedExpr): str =
    if expr.kind != parser.NormalizedExprCall:
        return ""
    if chengpath.PathTrim(share(expr.callQualifier)) != "":
        return ""
    return TypedExprBuiltinCalleeReturnType(share(expr.callCallee),
                                           share(expr.callArgsText),
                                           expr.callArgCount)

@borrows
fn TypedExprKnownQualifiedCallReturnType(qualifierRaw: str,
                                         calleeRaw: str): str =
    let qualifier = chengpath.PathTrim(qualifierRaw)
    let callee = chengpath.PathTrim(calleeRaw)
    if qualifier == "strutil":
        if callee == "Strip" || callee == "Join":
            return "str"
        if callee == "Contains" || callee == "StartsWith":
            return "bool"
        if callee == "ParseInt":
            return "int64"
    if qualifier == "strings":
        if callee == "IntToStr":
            return "str"
    if qualifier == "os":
        if callee == "GetEnv" || callee == "GetCurrentDir" || callee == "ReadFile":
            return "str"
        if callee == "FileExists" || callee == "DirExists" || callee == "MakeDir" || callee == "RemoveFile":
            return "bool"
        if callee == "WriteLine" || callee == "WriteFile" || callee == "SetEnv":
            return "void"
    if qualifier == "ccsg":
        if callee == "CompilerExportSurfaceFromCsgInto" ||
           callee == "CompilerCsgReleaseBackendInputPayload":
            return "void"
    if qualifier == "lower":
        if callee == "LoweringPlanReleasePrePrimaryObjectPayload" ||
           callee == "LoweringPlanReleaseAfterPrimaryObjectPlan":
            return "void"
    if qualifier == "pobj":
        if callee == "BuildPrimaryObjectPlanInto":
            return "void"
    if qualifier == "layout":
        if callee == "ByteBufAppendByte" || callee == "ByteBufAppendBytes":
            return "void"
    if qualifier == "rawbytes":
        if callee == "BytesFree" || callee == "BytesCopyInto":
            return "void"
    if qualifier == "rawmem_support":
        if callee == "RawmemCopy" || callee == "RawmemSet" ||
           callee == "RawmemWriteI8" || callee == "RawmemWriteChar":
            return "void"
    if qualifier == "atomic":
        if callee == "LoadI32" || callee == "FetchAddI32" || callee == "AddI32":
            return "int32"
        if callee == "CasI32":
            return "bool"
        if callee == "StoreI32":
            return "void"
    if qualifier == "seqs":
        if callee == "Add" || callee == "SetLen" || callee == "Reserve":
            return "void"
    if qualifier == "cmdline":
        if callee == "ParamCount":
            return "int32"
        if callee == "ParamStr" || callee == "ProgramName":
            return "str"
        if callee == "CaptureCmdLine":
            return "void"
    if qualifier == "chengpath":
        if callee == "PathAbsolute" ||
           callee == "PathJoin" ||
           callee == "PathTrim" ||
           callee == "ReadTextFile" ||
           callee == "PathParentDir" ||
           callee == "PathFileSizeDiagnostic":
            return "str"
        if callee == "WriteTextFile" ||
           callee == "WriteTextFileWithHandleHostBridge" ||
           callee == "FileExistsNonEmpty" ||
           callee == "PathFileNonEmpty" ||
           callee == "PathFileExists" ||
           callee == "PathDirExists" ||
           callee == "PathLooksAbsolute" ||
           callee == "MkdirP":
            return "bool"
    return ""

@borrows
fn TypedExprExprIsBuiltinCall(expr: parser.NormalizedExpr): bool =
    if TypedExprExprIsBuiltinStringifyCall(expr):
        return true
    return TypedExprBuiltinTypeCallResult(expr) != ""

@borrows
fn TypedExprExprResolvesToSourceFunction(expr: parser.NormalizedExpr,
                                         currentCtx: var TypedExprSourceContext,
                                         sourceContexts: var TypedExprSourceContext[]): bool =
    if expr.kind != parser.NormalizedExprCall:
        return false
    var targetSourcePath: str
    var targetName: str
    var targetSignatureLineNumber: int32
    var targetImportc: bool
    let returnType = TypedExprResolveCallTargetReturnType(currentCtx,
                                                          sourceContexts,
                                                          expr.callQualifier,
                                                          expr.callCallee,
                                                          expr.callTarget,
                                                          expr.callArgsText,
                                                          expr.lineNumber,
                                                          TypedExprSurfaceCallKindFromParser(expr.callSurfaceKind),
                                                          targetSourcePath,
                                                          targetName,
                                                          targetSignatureLineNumber,
                                                          targetImportc)
    return returnType != "" && targetSourcePath != "" && !targetImportc

@borrows
fn TypedExprCallKindForExpr(expr: parser.NormalizedExpr): TypedExprCallKind =
    if expr.kind == parser.NormalizedExprStrFormat:
        return TypedExprCallBuiltin
    if TypedExprExprIsBuiltinCall(expr):
        return TypedExprCallBuiltin
    if expr.kind == parser.NormalizedExprResultIntrinsic:
        return TypedExprCallResultIntrinsic
    if expr.kind == parser.NormalizedExprTry:
        return TypedExprCallProjection
    return TypedExprCallNone

@borrows
fn TypedExprTypeCallKindForExpr(expr: parser.NormalizedExpr): TypedExprTypeCallKind =
    if expr.kind == parser.NormalizedExprDefaultInit:
        return TypedExprTypeCallDefaultInit
    if expr.kind == parser.NormalizedExprConstructor:
        return TypedExprTypeCallConstructor
    return TypedExprTypeCallNone

fn TypedExprReturnKindForResolved(abiClass: TypedExprAbiClass,
                                    loweringMode: TypedExprLoweringMode): TypedExprReturnKind =
    if loweringMode == TypedExprLowerSret:
        return TypedExprReturnSret
    if loweringMode == TypedExprLowerImportBuffer:
        return TypedExprReturnImportBuffer
    if loweringMode == TypedExprLowerDeferred || abiClass == TypedExprAbiPolymorphic:
        return TypedExprReturnDeferred
    if abiClass == TypedExprAbiComposite:
        return TypedExprReturnCompositeLocal
    return TypedExprReturnReg

fn TypedExprFactClone(fact: TypedExprFact): TypedExprFact =
    var out: TypedExprFact
    out.exprId = fact.exprId
    out.sourcePath = fact.sourcePath
    out.lineNumber = fact.lineNumber
    out.columnNumber = fact.columnNumber
    out.endLineNumber = fact.endLineNumber
    out.endColumnNumber = fact.endColumnNumber
    out.lexicalScopeId = fact.lexicalScopeId
    out.suiteScopeId = fact.suiteScopeId
    out.statementOrdinal = fact.statementOrdinal
    out.lexicalOrdinal = fact.lexicalOrdinal
    out.deferOwnerStatementOrdinal = fact.deferOwnerStatementOrdinal
    out.kind = fact.kind
    out.surfaceCallKind = fact.surfaceCallKind
    out.callResolved = fact.callResolved
    out.callReason = fact.callReason
    out.callQualifier = fact.callQualifier
    out.callCallee = fact.callCallee
    out.callTarget = fact.callTarget
    out.callTargetSourcePath = fact.callTargetSourcePath
    out.callTargetSignatureLineNumber = fact.callTargetSignatureLineNumber
    out.callTargetImportc = fact.callTargetImportc
    out.callPrefixStyle = fact.callPrefixStyle
    out.callArgCount = fact.callArgCount
    out.callArgsText = fact.callArgsText
    out.valueExprCallNodeIndex = fact.valueExprCallNodeIndex
    out.originParserNodeId = fact.originParserNodeId
    out.valueExprArgRootStart = fact.valueExprArgRootStart
    out.valueExprArgRootCount = fact.valueExprArgRootCount
    out.valueExprRootNodeIndex = fact.valueExprRootNodeIndex
    out.valueExprSpanStart = fact.valueExprSpanStart
    out.valueExprSpanEnd = fact.valueExprSpanEnd
    out.valueExprStatementRole = fact.valueExprStatementRole
    out.typeText = fact.typeText
    out.abiClass = fact.abiClass
    out.valueKind = fact.valueKind
    out.placeKind = fact.placeKind
    out.hasSink = fact.hasSink
    out.sinkPlaceKind = fact.sinkPlaceKind
    out.loweringMode = fact.loweringMode
    out.callKind = fact.callKind
    out.typeCallKind = fact.typeCallKind
    out.returnKind = fact.returnKind
    out.returnRoot = fact.returnRoot
    return out

fn TypedExprFactEqual(lhs: TypedExprFact,
                        rhs: TypedExprFact): bool =
    if lhs.exprId != rhs.exprId:
        return false
    if lhs.sourcePath != rhs.sourcePath:
        return false
    if lhs.lineNumber != rhs.lineNumber:
        return false
    if lhs.columnNumber != rhs.columnNumber:
        return false
    if lhs.endLineNumber != rhs.endLineNumber:
        return false
    if lhs.endColumnNumber != rhs.endColumnNumber:
        return false
    if lhs.lexicalScopeId != rhs.lexicalScopeId:
        return false
    if lhs.suiteScopeId != rhs.suiteScopeId:
        return false
    if lhs.statementOrdinal != rhs.statementOrdinal:
        return false
    if lhs.lexicalOrdinal != rhs.lexicalOrdinal:
        return false
    if lhs.deferOwnerStatementOrdinal != rhs.deferOwnerStatementOrdinal:
        return false
    if lhs.kind != rhs.kind:
        return false
    if lhs.surfaceCallKind != rhs.surfaceCallKind:
        return false
    if lhs.callResolved != rhs.callResolved:
        return false
    if lhs.callReason != rhs.callReason:
        return false
    if lhs.callQualifier != rhs.callQualifier:
        return false
    if lhs.callCallee != rhs.callCallee:
        return false
    if lhs.callTarget != rhs.callTarget:
        return false
    if lhs.callTargetSourcePath != rhs.callTargetSourcePath:
        return false
    if lhs.callTargetSignatureLineNumber !=
       rhs.callTargetSignatureLineNumber:
        return false
    if lhs.callTargetImportc != rhs.callTargetImportc:
        return false
    if lhs.callPrefixStyle != rhs.callPrefixStyle:
        return false
    if lhs.callArgCount != rhs.callArgCount:
        return false
    if lhs.callArgsText != rhs.callArgsText:
        return false
    if lhs.valueExprCallNodeIndex != rhs.valueExprCallNodeIndex ||
       lhs.originParserNodeId != rhs.originParserNodeId ||
       lhs.valueExprArgRootStart != rhs.valueExprArgRootStart ||
       lhs.valueExprArgRootCount != rhs.valueExprArgRootCount:
        return false
    if lhs.valueExprRootNodeIndex != rhs.valueExprRootNodeIndex ||
       lhs.valueExprSpanStart != rhs.valueExprSpanStart ||
       lhs.valueExprSpanEnd != rhs.valueExprSpanEnd ||
       lhs.valueExprStatementRole != rhs.valueExprStatementRole:
        return false
    if lhs.typeText != rhs.typeText:
        return false
    if lhs.abiClass != rhs.abiClass:
        return false
    if lhs.valueKind != rhs.valueKind:
        return false
    if lhs.placeKind != rhs.placeKind:
        return false
    if lhs.hasSink != rhs.hasSink:
        return false
    if lhs.sinkPlaceKind != rhs.sinkPlaceKind:
        return false
    if lhs.loweringMode != rhs.loweringMode:
        return false
    if lhs.callKind != rhs.callKind:
        return false
    if lhs.typeCallKind != rhs.typeCallKind:
        return false
    if lhs.returnKind != rhs.returnKind:
        return false
    return lhs.returnRoot == rhs.returnRoot

# ---- C5 TypedExprFactTable: SoA columns + intern pool + arena backing ----

fn typedExprFactBoolCode(value: bool): int32 =
    if value:
        return 1
    return 0

@borrows
fn typedExprFactPackedBoolFlags(fact: TypedExprFact): int32 =
    var flags: int32
    if fact.callPrefixStyle:
        flags = flags | 1
    if fact.hasSink:
        flags = flags | 2
    if fact.returnRoot:
        flags = flags | 4
    return flags

@borrows
fn typedExprFactPackedFlag(table: TypedExprFactTable,
                            index: int32,
                            mask: int32): bool =
    if index < 0:
        return false
    if arenamod.ArenaArrayU8Len(table.arena, table.callPrefixStyles) <= index:
        return false
    return (arenamod.ArenaArrayU8Get(table.arena, table.callPrefixStyles, index) & mask) != 0

fn typedExprFactU8ValueValid(value: int32): bool =
    return value >= 0 && value <= 255

@borrows
fn typedExprFactRequireU8Fields(fact: TypedExprFact) =
    if !typedExprFactU8ValueValid(Int32(fact.kind)) ||
       !typedExprFactU8ValueValid(Int32(fact.surfaceCallKind)) ||
       !typedExprFactU8ValueValid(Int32(fact.callReason)) ||
       !typedExprFactU8ValueValid(Int32(fact.abiClass)) ||
       !typedExprFactU8ValueValid(Int32(fact.valueKind)) ||
       !typedExprFactU8ValueValid(Int32(fact.placeKind)) ||
       !typedExprFactU8ValueValid(Int32(fact.sinkPlaceKind)) ||
       !typedExprFactU8ValueValid(Int32(fact.loweringMode)) ||
       !typedExprFactU8ValueValid(Int32(fact.callKind)) ||
       !typedExprFactU8ValueValid(Int32(fact.typeCallKind)) ||
       !typedExprFactU8ValueValid(Int32(fact.returnKind)) ||
       !typedExprFactU8ValueValid(Int32(fact.valueExprStatementRole)) ||
       !typedExprFactU8ValueValid(typedExprFactPackedBoolFlags(fact)):
        panic("typed expr fact table: u8 fact field out of range")

@borrows
fn typedExprFactTableText(table: TypedExprFactTable, id: int32): str =
    let res: Result[str] = langintern.LookupIntern(table.internPool, id)
    if !IsOk(res):
        panic(" typed expr fact table: intern miss")
    return Value(res)

fn TypedExprFactTableScratchRetainedArenaBytes(): int32 =
    return 16384

fn TypedExprFactTablePhysicalColumnCount(): int32 =
    return 41

fn TypedExprFactTablePhysicalInt32ColumnCount(): int32 =
    return 26

fn TypedExprFactTablePhysicalU8ColumnCount(): int32 =
    return 15

fn TypedExprFactTablePhysicalRowBytes(): int32 =
    return TypedExprFactTablePhysicalInt32ColumnCount() * sizeof(int32) +
           TypedExprFactTablePhysicalU8ColumnCount()

fn TypedExprFactTableDefaultPreparedRows(): int32 =
    return 64

fn TypedExprFactTableStorageBytesForRows(rowCount: int32): int64 =
    if rowCount < 0:
        return Int64(-1)
    let bytes = Int64(rowCount) *
                Int64(TypedExprFactTablePhysicalRowBytes())
    if bytes > Int64(2147483647):
        return Int64(-1)
    return bytes

fn TypedExprFactTableScratchRetainedInternEntryLimit(): int32 =
    # Unprepared hand-built tables receive one 64-row lockstep reservation.
    # Eight intern-id columns can therefore contribute at most 512 distinct
    # strings before the table performs a whole-table compact grow.
    let internColumnCount: int32 = 8
    return TypedExprFactTableDefaultPreparedRows() * internColumnCount

fn typedExprFactTableEnsureStorage(table: var TypedExprFactTable) =
    if table.internPool == nil:
        table.internPool = langintern.InternPoolNew()

@borrows
fn typedExprFactTableColumnMatchesExpected(
        table: TypedExprFactTable,
        column: arenamod.ArenaArrayInt32,
        rowCapacity: int32,
        columnOrdinal: int32,
        columnBytes: int64): bool =
    if column.len != table.count || column.capacity != rowCapacity:
        return false
    if rowCapacity == 0:
        return column.offset == 0 && column.generation == 0
    var physicalOrdinal = columnOrdinal
    if columnOrdinal >= 32 && columnOrdinal <= 38:
        physicalOrdinal = 18 + columnOrdinal - 32
    elif columnOrdinal == 40:
        physicalOrdinal = 25
    elif columnOrdinal < 0 || columnOrdinal > 17:
        return false
    if physicalOrdinal < 0 ||
       physicalOrdinal >= TypedExprFactTablePhysicalInt32ColumnCount():
        return false
    if column.generation != table.arena.generation:
        return false
    let expectedOffset = Int64(physicalOrdinal) * columnBytes
    let expectedEnd = expectedOffset + columnBytes
    if expectedOffset < 0 || expectedOffset > Int64(2147483647):
        return false
    if expectedEnd < expectedOffset ||
       expectedEnd > Int64(table.arena.usedBytes) ||
       expectedEnd > Int64(table.arena.capacityBytes):
        return false
    if column.offset != Int32(expectedOffset) || column.offset % 4 != 0:
        return false
    return true

@borrows
fn typedExprFactTableU8ColumnMatchesExpected(
        table: TypedExprFactTable,
        column: arenamod.ArenaArrayU8,
        rowCapacity: int32,
        columnOrdinal: int32,
        columnBytes: int64): bool =
    if column.len != table.count || column.capacity != rowCapacity:
        return false
    if rowCapacity == 0:
        return column.offset == 0 && column.generation == 0
    var physicalOrdinal = columnOrdinal - 18
    if columnOrdinal == 39:
        physicalOrdinal = 14
    elif columnOrdinal < 18 || columnOrdinal > 31:
        return false
    if physicalOrdinal < 0 ||
       physicalOrdinal >= TypedExprFactTablePhysicalU8ColumnCount():
        return false
    if column.generation != table.arena.generation:
        return false
    let int32StorageBytes =
        Int64(rowCapacity) *
        Int64(TypedExprFactTablePhysicalInt32ColumnCount()) *
        Int64(sizeof(int32))
    let expectedOffset = int32StorageBytes +
                         Int64(physicalOrdinal) * Int64(rowCapacity)
    let expectedEnd = expectedOffset + Int64(rowCapacity)
    if expectedOffset < 0 || expectedOffset > Int64(2147483647):
        return false
    if expectedEnd < expectedOffset ||
       expectedEnd > Int64(table.arena.usedBytes) ||
       expectedEnd > Int64(table.arena.capacityBytes):
        return false
    return column.offset == Int32(expectedOffset)

@borrows
fn TypedExprFactTableColumnsLockstep(table: TypedExprFactTable): bool =
    if table.count < 0:
        return false
    let rowCapacity = table.exprIdIds.capacity
    if rowCapacity < table.count:
        return false
    let storageBytes = TypedExprFactTableStorageBytesForRows(rowCapacity)
    if storageBytes < 0:
        return false
    if rowCapacity == 0:
        if table.arena.usedBytes != 0 || table.arena.capacityBytes < 0:
            return false
        if table.arena.capacityBytes == 0:
            if table.arena.basePtr != nil ||
               table.arena.alignmentBytes != 0 ||
               table.arena.generation != 0:
                return false
        else:
            if table.arena.basePtr == nil ||
               table.arena.alignmentBytes < 4 ||
               table.arena.alignmentBytes % 4 != 0 ||
               table.arena.generation <= 0:
                return false
    else:
        if table.arena.basePtr == nil || table.arena.capacityBytes <= 0 ||
           table.arena.usedBytes != Int32(storageBytes) ||
           table.arena.usedBytes > table.arena.capacityBytes ||
           table.arena.alignmentBytes < 4 ||
           table.arena.alignmentBytes % 4 != 0 ||
           table.arena.generation <= 0:
            return false
    let columnBytes = Int64(rowCapacity) * Int64(sizeof(int32))
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.exprIdIds,
                                                 rowCapacity,
                                                 0,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.sourcePathIds,
                                                 rowCapacity,
                                                 1,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.callQualifierIds,
                                                 rowCapacity,
                                                 2,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.callCalleeIds,
                                                 rowCapacity,
                                                 3,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.callTargetIds,
                                                 rowCapacity,
                                                 4,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.callTargetSourcePathIds,
                                                 rowCapacity,
                                                 5,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.callArgsTextIds,
                                                 rowCapacity,
                                                 6,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.typeTextIds,
                                                 rowCapacity,
                                                 7,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.lineNumbers,
                                                 rowCapacity,
                                                 8,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.columnNumbers,
                                                 rowCapacity,
                                                 9,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.endLineNumbers,
                                                 rowCapacity,
                                                 10,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.endColumnNumbers,
                                                 rowCapacity,
                                                 11,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.lexicalScopeIds,
                                                 rowCapacity,
                                                 12,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.suiteScopeIds,
                                                 rowCapacity,
                                                 13,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.statementOrdinals,
                                                 rowCapacity,
                                                 14,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.lexicalOrdinals,
                                                 rowCapacity,
                                                 15,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.deferOwnerStatementOrdinals,
                                                 rowCapacity,
                                                 16,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.callArgCounts,
                                                 rowCapacity,
                                                 17,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.kinds,
                                                 rowCapacity,
                                                 18,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.surfaceCallKinds,
                                                 rowCapacity,
                                                 19,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.callReasons,
                                                 rowCapacity,
                                                 20,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.abiClasses,
                                                 rowCapacity,
                                                 21,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.valueKinds,
                                                 rowCapacity,
                                                 22,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.placeKinds,
                                                 rowCapacity,
                                                 23,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.sinkPlaceKinds,
                                                 rowCapacity,
                                                 24,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.loweringModes,
                                                 rowCapacity,
                                                 25,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.callKinds,
                                                 rowCapacity,
                                                 26,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.typeCallKinds,
                                                 rowCapacity,
                                                 27,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.returnKinds,
                                                 rowCapacity,
                                                 28,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.callResolveds,
                                                 rowCapacity,
                                                 29,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.callTargetImportcs,
                                                 rowCapacity,
                                                 30,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.callPrefixStyles,
                                                 rowCapacity,
                                                 31,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.valueExprCallNodeIndexes,
                                                 rowCapacity,
                                                 32,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.originParserNodeIds,
                                                 rowCapacity,
                                                 33,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.valueExprArgRootStarts,
                                                 rowCapacity,
                                                 34,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.valueExprArgRootCounts,
                                                 rowCapacity,
                                                 35,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.valueExprRootNodeIndexes,
                                                 rowCapacity,
                                                 36,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.valueExprSpanStarts,
                                                 rowCapacity,
                                                 37,
                                                 columnBytes):
        return false
    if !typedExprFactTableColumnMatchesExpected(table,
                                                 table.valueExprSpanEnds,
                                                 rowCapacity,
                                                 38,
                                                 columnBytes):
        return false
    if !typedExprFactTableU8ColumnMatchesExpected(table,
                                                   table.valueExprStatementRoles,
                                                 rowCapacity,
                                                 39,
                                                 columnBytes):
        return false
    return typedExprFactTableColumnMatchesExpected(
        table,
        table.callTargetSignatureLineNumbers,
        rowCapacity,
        40,
        columnBytes)

@borrows
fn TypedExprFactTablePreparedRowCapacity(table: TypedExprFactTable): int32 =
    if !TypedExprFactTableColumnsLockstep(table):
        panic("typed expr fact table: columns are not lockstep")
    return table.exprIdIds.capacity

fn typedExprFactTableReserveEmptyColumns(table: var TypedExprFactTable,
                                          rowCount: int32): bool =
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.exprIdIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.sourcePathIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.callQualifierIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.callCalleeIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.callTargetIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.callTargetSourcePathIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.callArgsTextIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.typeTextIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.lineNumbers, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.columnNumbers, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.endLineNumbers, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.endColumnNumbers, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.lexicalScopeIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.suiteScopeIds, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.statementOrdinals, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.lexicalOrdinals, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.deferOwnerStatementOrdinals, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena, table.callArgCounts, rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena,
                                              table.valueExprCallNodeIndexes,
                                              rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena,
                                              table.originParserNodeIds,
                                              rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena,
                                              table.valueExprArgRootStarts,
                                              rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena,
                                              table.valueExprArgRootCounts,
                                              rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena,
                                              table.valueExprRootNodeIndexes,
                                              rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena,
                                              table.valueExprSpanStarts,
                                              rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(table.arena,
                                              table.valueExprSpanEnds,
                                              rowCount):
        return false
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.callTargetSignatureLineNumbers, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.kinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.surfaceCallKinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.callReasons, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.abiClasses, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.valueKinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.placeKinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.sinkPlaceKinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.loweringModes, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.callKinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.typeCallKinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.returnKinds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.callResolveds, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena, table.callTargetImportcs, rowCount):
        return false
    if !arenamod.ArenaArrayU8ReserveEmpty(table.arena,
                                          table.callPrefixStyles,
                                          rowCount):
        return false
    return arenamod.ArenaArrayU8ReserveEmpty(
        table.arena, table.valueExprStatementRoles, rowCount)

fn TypedExprFactTablePrepareEmptyRows(table: var TypedExprFactTable,
                                       rowCount: int32): bool =
    if table.count != 0 || !TypedExprFactTableColumnsLockstep(table) ||
       table.exprIdIds.capacity != 0:
        panic("typed expr fact table: prepare requires an empty unprepared table")
    let storageBytes = TypedExprFactTableStorageBytesForRows(rowCount)
    if storageBytes < 0:
        return false
    typedExprFactTableEnsureStorage(table)
    if rowCount == 0:
        return true
    if table.arena.capacityBytes > 0 && table.arena.usedBytes != 0:
        panic("typed expr fact table: prepare requires an empty arena")
    if table.arena.capacityBytes > 0 &&
       Int64(table.arena.capacityBytes) < storageBytes:
        arenamod.ArenaRelease(table.arena)
    if table.arena.capacityBytes <= 0:
        table.arena = arenamod.ArenaInitDefault(Int32(storageBytes))
    if !typedExprFactTableReserveEmptyColumns(table, rowCount):
        return false
    if !TypedExprFactTableColumnsLockstep(table):
        panic("typed expr fact table: prepared columns are not lockstep")
    return true

fn typedExprFactTableCompactGrow(table: var TypedExprFactTable,
                                  minimumRowCapacity: int32): bool =
    if !TypedExprFactTableColumnsLockstep(table):
        panic("typed expr fact table: cannot grow non-lockstep columns")
    if minimumRowCapacity <= table.count:
        return true
    var nextCapacity = TypedExprFactTableDefaultPreparedRows()
    let currentCapacity = table.exprIdIds.capacity
    if currentCapacity > 0:
        if currentCapacity <= 1073741823:
            nextCapacity = currentCapacity * 2
        else:
            nextCapacity = minimumRowCapacity
    if nextCapacity < minimumRowCapacity:
        nextCapacity = minimumRowCapacity
    if table.compactGrowCount >= 2147483647:
        panic("typed expr fact table: compact grow count overflow")
    let nextCompactGrowCount = table.compactGrowCount + 1
    var grown: TypedExprFactTable
    if !TypedExprFactTablePrepareEmptyRows(grown, nextCapacity):
        return false
    for rowIndex in 0..<table.count:
        TypedExprFactTableAppendPrepared(grown,
                                         TypedExprFactAt(table, rowIndex))
    if grown.compactGrowCount != 0:
        panic("typed expr fact table: prepared compact target grew")
    TypedExprFactTableRelease(table)
    TypedExprFactTableMoveInto(table, grown)
    table.compactGrowCount = nextCompactGrowCount
    return true

fn typedExprFactTableEnsureRowCapacity(table: var TypedExprFactTable,
                                        minimumRowCapacity: int32): bool =
    if minimumRowCapacity < table.count:
        return false
    if !TypedExprFactTableColumnsLockstep(table):
        panic("typed expr fact table: capacity check found non-lockstep columns")
    let currentCapacity = table.exprIdIds.capacity
    if currentCapacity >= minimumRowCapacity:
        return true
    if currentCapacity == 0 && table.count == 0:
        return TypedExprFactTablePrepareEmptyRows(table, minimumRowCapacity)
    return typedExprFactTableCompactGrow(table, minimumRowCapacity)

@borrows
fn TypedExprFactTableCount(table: TypedExprFactTable): int32 =
    return table.count

@borrows
fn TypedExprFactTableCompactGrowCount(table: TypedExprFactTable): int32 =
    return table.compactGrowCount

@borrows
fn TypedExprPersistentFactCountForRange(exprLayer: parser.NormalizedExprLayer,
                                         exprStart: int32,
                                         exprEnd: int32): int32 =
    if exprStart < 0 || exprEnd < exprStart || exprEnd > exprLayer.exprs.len:
        panic("typed expr fact table: persistent fact range out of bounds")
    var rowCount: int32
    for exprIndex in exprStart..<exprEnd:
        if TypedExprExprRequiresPersistentFact(exprLayer.exprs[exprIndex]):
            rowCount = rowCount + 1
    return rowCount

@borrows
fn typedExprFactTablePrepareEmptyExprRange(
        table: var TypedExprFactTable,
        exprLayer: parser.NormalizedExprLayer,
        exprStart: int32,
        exprEnd: int32) =
    let rowCount = TypedExprPersistentFactCountForRange(exprLayer,
                                                        exprStart,
                                                        exprEnd)
    if !TypedExprFactTablePrepareEmptyRows(table, rowCount):
        panic("typed expr fact table: persistent fact storage overflow")
    if TypedExprFactTablePreparedRowCapacity(table) != rowCount ||
       table.compactGrowCount != 0:
        panic("typed expr fact table: persistent fact prepare is not exact")

@borrows
fn typedExprFactTableRequireExactPreparedBuild(
        table: TypedExprFactTable) =
    if !TypedExprFactTableColumnsLockstep(table):
        panic("typed expr fact table: exact build columns are not lockstep")
    if table.compactGrowCount != 0:
        panic("typed expr fact table: exact build used compact grow")
    if table.exprIdIds.capacity != table.count:
        panic("typed expr fact table: exact build capacity differs from count")

@borrows
fn typedExprFactTableEnsureExprRangeCapacity(
        table: var TypedExprFactTable,
        exprLayer: parser.NormalizedExprLayer,
        exprStart: int32,
        exprEnd: int32) =
    let additionalRows = TypedExprPersistentFactCountForRange(exprLayer,
                                                               exprStart,
                                                               exprEnd)
    if additionalRows > 2147483647 - table.count:
        panic("typed expr fact table: persistent fact count overflow")
    if !TypedExprFactTableColumnsLockstep(table):
        panic("typed expr fact table: persistent fact columns are not lockstep")
    if table.exprIdIds.capacity < table.count + additionalRows:
        panic("typed expr fact table: exact persistent fact capacity exhausted")

@borrows
fn typedExprFactTableAppendReserved(table: var TypedExprFactTable,
                                     fact: TypedExprFact) =
    typedExprFactRequireU8Fields(fact)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.exprIdIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.exprId)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.sourcePathIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.sourcePath)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.callQualifierIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.callQualifier)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.callCalleeIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.callCallee)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.callTargetIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.callTarget)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.callTargetSourcePathIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.callTargetSourcePath)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.callArgsTextIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.callArgsText)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.typeTextIds, TypedExprFactTableInternText(table, strings.CloneStr(fact.typeText)))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.lineNumbers, fact.lineNumber)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.columnNumbers, fact.columnNumber)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.endLineNumbers, fact.endLineNumber)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.endColumnNumbers, fact.endColumnNumber)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.lexicalScopeIds, fact.lexicalScopeId)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.suiteScopeIds, fact.suiteScopeId)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.statementOrdinals, fact.statementOrdinal)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.lexicalOrdinals, fact.lexicalOrdinal)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.deferOwnerStatementOrdinals, fact.deferOwnerStatementOrdinal)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.callArgCounts, fact.callArgCount)
    arenamod.ArenaArrayU8AddReserved(table.arena, table.kinds, Int32(fact.kind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.surfaceCallKinds, Int32(fact.surfaceCallKind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.callReasons, Int32(fact.callReason))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.abiClasses, Int32(fact.abiClass))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.valueKinds, Int32(fact.valueKind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.placeKinds, Int32(fact.placeKind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.sinkPlaceKinds, Int32(fact.sinkPlaceKind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.loweringModes, Int32(fact.loweringMode))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.callKinds, Int32(fact.callKind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.typeCallKinds, Int32(fact.typeCallKind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.returnKinds, Int32(fact.returnKind))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.callResolveds, typedExprFactBoolCode(fact.callResolved))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.callTargetImportcs, typedExprFactBoolCode(fact.callTargetImportc))
    arenamod.ArenaArrayU8AddReserved(table.arena, table.callPrefixStyles, typedExprFactPackedBoolFlags(fact))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.valueExprCallNodeIndexes, fact.valueExprCallNodeIndex)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.originParserNodeIds, fact.originParserNodeId)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.valueExprArgRootStarts, fact.valueExprArgRootStart)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.valueExprArgRootCounts, fact.valueExprArgRootCount)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.valueExprRootNodeIndexes, fact.valueExprRootNodeIndex)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.valueExprSpanStarts, fact.valueExprSpanStart)
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.valueExprSpanEnds, fact.valueExprSpanEnd)
    arenamod.ArenaArrayU8AddReserved(table.arena, table.valueExprStatementRoles, Int32(fact.valueExprStatementRole))
    arenamod.ArenaArrayInt32AddReserved(table.arena, table.callTargetSignatureLineNumbers, fact.callTargetSignatureLineNumber)
    table.count = table.count + 1

@borrows
fn TypedExprFactTableAppendPrepared(table: var TypedExprFactTable,
                                     fact: TypedExprFact) =
    if !TypedExprFactTableColumnsLockstep(table):
        panic("typed expr fact table: prepared append columns are not lockstep")
    if table.internPool == nil:
        panic("typed expr fact table: prepared append requires prepared storage")
    if table.count >= table.exprIdIds.capacity:
        panic("typed expr fact table: prepared capacity exhausted")
    typedExprFactTableAppendReserved(table, fact)

# Explicit fixture/manual-table boundary. This is the only public append that
# may allocate or perform a whole-table compact grow.
@borrows
fn TypedExprFactTableAppendHandBuilt(table: var TypedExprFactTable,
                                     fact: TypedExprFact) =
    typedExprFactTableEnsureStorage(table)
    if table.count >= 2147483647:
        panic("typed expr fact table: row count overflow")
    let requiredRows = table.count + 1
    var preparedRows = requiredRows
    if table.count == 0 && table.exprIdIds.capacity == 0:
        preparedRows = TypedExprFactTableDefaultPreparedRows()
    if !typedExprFactTableEnsureRowCapacity(table, preparedRows):
        panic("typed expr fact table: hand-built row capacity overflow")
    typedExprFactTableAppendReserved(table, fact)

@borrows
fn TypedExprFactTableAppend(table: var TypedExprFactTable,
                             fact: TypedExprFact) =
    TypedExprFactTableAppendPrepared(table, fact)

@borrows
fn TypedExprFactAt(table: TypedExprFactTable, index: int32): TypedExprFact =
    if index < 0 || index >= table.count:
        panic(" typed expr fact table: index out of bounds")
    var out: TypedExprFact
    out.exprId = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.exprIdIds, index))
    out.sourcePath = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.sourcePathIds, index))
    out.callQualifier = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.callQualifierIds, index))
    out.callCallee = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.callCalleeIds, index))
    out.callTarget = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.callTargetIds, index))
    out.callTargetSourcePath = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.callTargetSourcePathIds, index))
    out.callTargetSignatureLineNumber = arenamod.ArenaArrayInt32Get(table.arena, table.callTargetSignatureLineNumbers, index)
    out.callArgsText = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.callArgsTextIds, index))
    out.typeText = typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.typeTextIds, index))
    out.lineNumber = arenamod.ArenaArrayInt32Get(table.arena, table.lineNumbers, index)
    out.columnNumber = arenamod.ArenaArrayInt32Get(table.arena, table.columnNumbers, index)
    out.endLineNumber = arenamod.ArenaArrayInt32Get(table.arena, table.endLineNumbers, index)
    out.endColumnNumber = arenamod.ArenaArrayInt32Get(table.arena, table.endColumnNumbers, index)
    out.lexicalScopeId = arenamod.ArenaArrayInt32Get(table.arena, table.lexicalScopeIds, index)
    out.suiteScopeId = arenamod.ArenaArrayInt32Get(table.arena, table.suiteScopeIds, index)
    out.statementOrdinal = arenamod.ArenaArrayInt32Get(table.arena, table.statementOrdinals, index)
    out.lexicalOrdinal = arenamod.ArenaArrayInt32Get(table.arena, table.lexicalOrdinals, index)
    out.deferOwnerStatementOrdinal = arenamod.ArenaArrayInt32Get(table.arena, table.deferOwnerStatementOrdinals, index)
    out.callArgCount = arenamod.ArenaArrayInt32Get(table.arena, table.callArgCounts, index)
    out.valueExprCallNodeIndex = arenamod.ArenaArrayInt32Get(table.arena, table.valueExprCallNodeIndexes, index)
    out.originParserNodeId = arenamod.ArenaArrayInt32Get(table.arena, table.originParserNodeIds, index)
    out.valueExprArgRootStart = arenamod.ArenaArrayInt32Get(table.arena, table.valueExprArgRootStarts, index)
    out.valueExprArgRootCount = arenamod.ArenaArrayInt32Get(table.arena, table.valueExprArgRootCounts, index)
    out.valueExprRootNodeIndex = arenamod.ArenaArrayInt32Get(table.arena, table.valueExprRootNodeIndexes, index)
    out.valueExprSpanStart = arenamod.ArenaArrayInt32Get(table.arena, table.valueExprSpanStarts, index)
    out.valueExprSpanEnd = arenamod.ArenaArrayInt32Get(table.arena, table.valueExprSpanEnds, index)
    out.valueExprStatementRole = parser.ParserValueExprStatementRole(arenamod.ArenaArrayU8Get(table.arena, table.valueExprStatementRoles, index))
    out.kind = parser.NormalizedExprKind(arenamod.ArenaArrayU8Get(table.arena, table.kinds, index))
    out.surfaceCallKind = TypedExprSurfaceCallKind(arenamod.ArenaArrayU8Get(table.arena, table.surfaceCallKinds, index))
    out.callReason = TypedExprCallReason(arenamod.ArenaArrayU8Get(table.arena, table.callReasons, index))
    out.abiClass = TypedExprAbiClass(arenamod.ArenaArrayU8Get(table.arena, table.abiClasses, index))
    out.valueKind = TypedExprValueKind(arenamod.ArenaArrayU8Get(table.arena, table.valueKinds, index))
    out.placeKind = TypedExprPlaceKind(arenamod.ArenaArrayU8Get(table.arena, table.placeKinds, index))
    out.sinkPlaceKind = TypedExprPlaceKind(arenamod.ArenaArrayU8Get(table.arena, table.sinkPlaceKinds, index))
    out.loweringMode = TypedExprLoweringMode(arenamod.ArenaArrayU8Get(table.arena, table.loweringModes, index))
    out.callKind = TypedExprCallKind(arenamod.ArenaArrayU8Get(table.arena, table.callKinds, index))
    out.typeCallKind = TypedExprTypeCallKind(arenamod.ArenaArrayU8Get(table.arena, table.typeCallKinds, index))
    out.returnKind = TypedExprReturnKind(arenamod.ArenaArrayU8Get(table.arena, table.returnKinds, index))
    out.callResolved = arenamod.ArenaArrayU8Get(table.arena, table.callResolveds, index) != 0
    out.callTargetImportc = arenamod.ArenaArrayU8Get(table.arena, table.callTargetImportcs, index) != 0
    out.callPrefixStyle = typedExprFactPackedFlag(table, index, 1)
    out.hasSink = typedExprFactPackedFlag(table, index, 2)
    out.returnRoot = typedExprFactPackedFlag(table, index, 4)
    return out

@borrows
fn TypedExprFactTableSet(table: var TypedExprFactTable,
                          index: int32,
                          fact: TypedExprFact) =
    if index < 0 || index >= table.count:
        panic(" typed expr fact table: set out of bounds")
    typedExprFactRequireU8Fields(fact)
    arenamod.ArenaArrayInt32Set(table.arena, table.exprIdIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.exprId)))
    arenamod.ArenaArrayInt32Set(table.arena, table.sourcePathIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.sourcePath)))
    arenamod.ArenaArrayInt32Set(table.arena, table.callQualifierIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.callQualifier)))
    arenamod.ArenaArrayInt32Set(table.arena, table.callCalleeIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.callCallee)))
    arenamod.ArenaArrayInt32Set(table.arena, table.callTargetIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.callTarget)))
    arenamod.ArenaArrayInt32Set(table.arena, table.callTargetSourcePathIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.callTargetSourcePath)))
    arenamod.ArenaArrayInt32Set(table.arena, table.callArgsTextIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.callArgsText)))
    arenamod.ArenaArrayInt32Set(table.arena, table.typeTextIds, index, TypedExprFactTableInternText(table, strings.CloneStr(fact.typeText)))
    arenamod.ArenaArrayInt32Set(table.arena, table.lineNumbers, index, fact.lineNumber)
    arenamod.ArenaArrayInt32Set(table.arena, table.columnNumbers, index, fact.columnNumber)
    arenamod.ArenaArrayInt32Set(table.arena, table.endLineNumbers, index, fact.endLineNumber)
    arenamod.ArenaArrayInt32Set(table.arena, table.endColumnNumbers, index, fact.endColumnNumber)
    arenamod.ArenaArrayInt32Set(table.arena, table.lexicalScopeIds, index, fact.lexicalScopeId)
    arenamod.ArenaArrayInt32Set(table.arena, table.suiteScopeIds, index, fact.suiteScopeId)
    arenamod.ArenaArrayInt32Set(table.arena, table.statementOrdinals, index, fact.statementOrdinal)
    arenamod.ArenaArrayInt32Set(table.arena, table.lexicalOrdinals, index, fact.lexicalOrdinal)
    arenamod.ArenaArrayInt32Set(table.arena, table.deferOwnerStatementOrdinals, index, fact.deferOwnerStatementOrdinal)
    arenamod.ArenaArrayInt32Set(table.arena, table.callArgCounts, index, fact.callArgCount)
    arenamod.ArenaArrayU8Set(table.arena, table.kinds, index, Int32(fact.kind))
    arenamod.ArenaArrayU8Set(table.arena, table.surfaceCallKinds, index, Int32(fact.surfaceCallKind))
    arenamod.ArenaArrayU8Set(table.arena, table.callReasons, index, Int32(fact.callReason))
    arenamod.ArenaArrayU8Set(table.arena, table.abiClasses, index, Int32(fact.abiClass))
    arenamod.ArenaArrayU8Set(table.arena, table.valueKinds, index, Int32(fact.valueKind))
    arenamod.ArenaArrayU8Set(table.arena, table.placeKinds, index, Int32(fact.placeKind))
    arenamod.ArenaArrayU8Set(table.arena, table.sinkPlaceKinds, index, Int32(fact.sinkPlaceKind))
    arenamod.ArenaArrayU8Set(table.arena, table.loweringModes, index, Int32(fact.loweringMode))
    arenamod.ArenaArrayU8Set(table.arena, table.callKinds, index, Int32(fact.callKind))
    arenamod.ArenaArrayU8Set(table.arena, table.typeCallKinds, index, Int32(fact.typeCallKind))
    arenamod.ArenaArrayU8Set(table.arena, table.returnKinds, index, Int32(fact.returnKind))
    arenamod.ArenaArrayU8Set(table.arena, table.callResolveds, index, typedExprFactBoolCode(fact.callResolved))
    arenamod.ArenaArrayU8Set(table.arena, table.callTargetImportcs, index, typedExprFactBoolCode(fact.callTargetImportc))
    arenamod.ArenaArrayU8Set(table.arena, table.callPrefixStyles, index, typedExprFactPackedBoolFlags(fact))
    arenamod.ArenaArrayInt32Set(table.arena, table.valueExprCallNodeIndexes, index, fact.valueExprCallNodeIndex)
    arenamod.ArenaArrayInt32Set(table.arena, table.originParserNodeIds, index, fact.originParserNodeId)
    arenamod.ArenaArrayInt32Set(table.arena, table.valueExprArgRootStarts, index, fact.valueExprArgRootStart)
    arenamod.ArenaArrayInt32Set(table.arena, table.valueExprArgRootCounts, index, fact.valueExprArgRootCount)
    arenamod.ArenaArrayInt32Set(table.arena, table.valueExprRootNodeIndexes, index, fact.valueExprRootNodeIndex)
    arenamod.ArenaArrayInt32Set(table.arena, table.valueExprSpanStarts, index, fact.valueExprSpanStart)
    arenamod.ArenaArrayInt32Set(table.arena, table.valueExprSpanEnds, index, fact.valueExprSpanEnd)
    arenamod.ArenaArrayU8Set(table.arena, table.valueExprStatementRoles, index, Int32(fact.valueExprStatementRole))
    arenamod.ArenaArrayInt32Set(table.arena, table.callTargetSignatureLineNumbers, index, fact.callTargetSignatureLineNumber)

fn TypedExprFactTableRelease(table: var TypedExprFactTable) =
    if table.arena.capacityBytes > 0:
        arenamod.ArenaRelease(table.arena)
    langintern.InternPoolRelease(table.internPool)
    table.internPool = nil
    table.count = 0
    table.compactGrowCount = 0
    table.exprIdIds = arenamod.ArenaArrayInt32Init()
    table.sourcePathIds = arenamod.ArenaArrayInt32Init()
    table.callQualifierIds = arenamod.ArenaArrayInt32Init()
    table.callCalleeIds = arenamod.ArenaArrayInt32Init()
    table.callTargetIds = arenamod.ArenaArrayInt32Init()
    table.callTargetSourcePathIds = arenamod.ArenaArrayInt32Init()
    table.callTargetSignatureLineNumbers = arenamod.ArenaArrayInt32Init()
    table.callArgsTextIds = arenamod.ArenaArrayInt32Init()
    table.typeTextIds = arenamod.ArenaArrayInt32Init()
    table.lineNumbers = arenamod.ArenaArrayInt32Init()
    table.columnNumbers = arenamod.ArenaArrayInt32Init()
    table.endLineNumbers = arenamod.ArenaArrayInt32Init()
    table.endColumnNumbers = arenamod.ArenaArrayInt32Init()
    table.lexicalScopeIds = arenamod.ArenaArrayInt32Init()
    table.suiteScopeIds = arenamod.ArenaArrayInt32Init()
    table.statementOrdinals = arenamod.ArenaArrayInt32Init()
    table.lexicalOrdinals = arenamod.ArenaArrayInt32Init()
    table.deferOwnerStatementOrdinals = arenamod.ArenaArrayInt32Init()
    table.callArgCounts = arenamod.ArenaArrayInt32Init()
    table.kinds = arenamod.ArenaArrayU8Init()
    table.surfaceCallKinds = arenamod.ArenaArrayU8Init()
    table.callReasons = arenamod.ArenaArrayU8Init()
    table.abiClasses = arenamod.ArenaArrayU8Init()
    table.valueKinds = arenamod.ArenaArrayU8Init()
    table.placeKinds = arenamod.ArenaArrayU8Init()
    table.sinkPlaceKinds = arenamod.ArenaArrayU8Init()
    table.loweringModes = arenamod.ArenaArrayU8Init()
    table.callKinds = arenamod.ArenaArrayU8Init()
    table.typeCallKinds = arenamod.ArenaArrayU8Init()
    table.returnKinds = arenamod.ArenaArrayU8Init()
    table.callResolveds = arenamod.ArenaArrayU8Init()
    table.callTargetImportcs = arenamod.ArenaArrayU8Init()
    table.callPrefixStyles = arenamod.ArenaArrayU8Init()
    table.valueExprCallNodeIndexes = arenamod.ArenaArrayInt32Init()
    table.originParserNodeIds = arenamod.ArenaArrayInt32Init()
    table.valueExprArgRootStarts = arenamod.ArenaArrayInt32Init()
    table.valueExprArgRootCounts = arenamod.ArenaArrayInt32Init()
    table.valueExprRootNodeIndexes = arenamod.ArenaArrayInt32Init()
    table.valueExprSpanStarts = arenamod.ArenaArrayInt32Init()
    table.valueExprSpanEnds = arenamod.ArenaArrayInt32Init()
    table.valueExprStatementRoles = arenamod.ArenaArrayU8Init()

fn TypedExprFactTableResetWithProbe(table: var TypedExprFactTable,
                                    probe: var TypedExprFactTableResetProbe) =
    probe.arenaCapacityBefore = 0
    probe.arenaCapacityAfter = 0
    probe.arenaStorageReleased = false
    probe.arenaCapacityBefore = table.arena.capacityBytes
    if table.arena.capacityBytes >
       TypedExprFactTableScratchRetainedArenaBytes():
        arenamod.ArenaRelease(table.arena)
        probe.arenaStorageReleased = true
    elif table.arena.capacityBytes > 0:
        arenamod.ArenaReset(table.arena)
    langintern.InternPoolResetBoundedWithProbe(
        table.internPool,
        TypedExprFactTableScratchRetainedInternEntryLimit(),
        probe.internReset)
    probe.arenaCapacityAfter = table.arena.capacityBytes
    table.count = 0
    table.compactGrowCount = 0
    table.exprIdIds = arenamod.ArenaArrayInt32Init()
    table.sourcePathIds = arenamod.ArenaArrayInt32Init()
    table.callQualifierIds = arenamod.ArenaArrayInt32Init()
    table.callCalleeIds = arenamod.ArenaArrayInt32Init()
    table.callTargetIds = arenamod.ArenaArrayInt32Init()
    table.callTargetSourcePathIds = arenamod.ArenaArrayInt32Init()
    table.callTargetSignatureLineNumbers = arenamod.ArenaArrayInt32Init()
    table.callArgsTextIds = arenamod.ArenaArrayInt32Init()
    table.typeTextIds = arenamod.ArenaArrayInt32Init()
    table.lineNumbers = arenamod.ArenaArrayInt32Init()
    table.columnNumbers = arenamod.ArenaArrayInt32Init()
    table.endLineNumbers = arenamod.ArenaArrayInt32Init()
    table.endColumnNumbers = arenamod.ArenaArrayInt32Init()
    table.lexicalScopeIds = arenamod.ArenaArrayInt32Init()
    table.suiteScopeIds = arenamod.ArenaArrayInt32Init()
    table.statementOrdinals = arenamod.ArenaArrayInt32Init()
    table.lexicalOrdinals = arenamod.ArenaArrayInt32Init()
    table.deferOwnerStatementOrdinals = arenamod.ArenaArrayInt32Init()
    table.callArgCounts = arenamod.ArenaArrayInt32Init()
    table.kinds = arenamod.ArenaArrayU8Init()
    table.surfaceCallKinds = arenamod.ArenaArrayU8Init()
    table.callReasons = arenamod.ArenaArrayU8Init()
    table.abiClasses = arenamod.ArenaArrayU8Init()
    table.valueKinds = arenamod.ArenaArrayU8Init()
    table.placeKinds = arenamod.ArenaArrayU8Init()
    table.sinkPlaceKinds = arenamod.ArenaArrayU8Init()
    table.loweringModes = arenamod.ArenaArrayU8Init()
    table.callKinds = arenamod.ArenaArrayU8Init()
    table.typeCallKinds = arenamod.ArenaArrayU8Init()
    table.returnKinds = arenamod.ArenaArrayU8Init()
    table.callResolveds = arenamod.ArenaArrayU8Init()
    table.callTargetImportcs = arenamod.ArenaArrayU8Init()
    table.callPrefixStyles = arenamod.ArenaArrayU8Init()
    table.valueExprCallNodeIndexes = arenamod.ArenaArrayInt32Init()
    table.originParserNodeIds = arenamod.ArenaArrayInt32Init()
    table.valueExprArgRootStarts = arenamod.ArenaArrayInt32Init()
    table.valueExprArgRootCounts = arenamod.ArenaArrayInt32Init()
    table.valueExprRootNodeIndexes = arenamod.ArenaArrayInt32Init()
    table.valueExprSpanStarts = arenamod.ArenaArrayInt32Init()
    table.valueExprSpanEnds = arenamod.ArenaArrayInt32Init()
    table.valueExprStatementRoles = arenamod.ArenaArrayU8Init()

fn TypedExprFactTableReset(table: var TypedExprFactTable) =
    var probe: TypedExprFactTableResetProbe
    TypedExprFactTableResetWithProbe(table, probe)

@borrows
fn TypedExprFactTableReleasedEmpty(table: TypedExprFactTable): bool =
    if !TypedExprFactTableColumnsLockstep(table):
        return false
    return table.count == 0 && table.compactGrowCount == 0 &&
           table.exprIdIds.capacity == 0 && table.internPool == nil &&
           table.arena.basePtr == nil && table.arena.usedBytes == 0 &&
           table.arena.capacityBytes == 0

fn TypedExprFactTableMoveInto(out: var TypedExprFactTable,
                               src: var TypedExprFactTable) =
    if !TypedExprFactTableReleasedEmpty(out):
        panic("typed expr fact table: move target must be released empty")
    if !TypedExprFactTableColumnsLockstep(src):
        panic("typed expr fact table: move source columns are not lockstep")
    out = src
    src = TypedExprFactTable()

@borrows
fn TypedExprFactTableClone(table: TypedExprFactTable): TypedExprFactTable =
    let clonedInternPool = langintern.InternPoolClone(table.internPool)
    let cloneArena = table.arena.capacityBytes > 0
    var clonedArena: arenamod.Arena
    if cloneArena:
        clonedArena = arenamod.ArenaClone(table.arena)
    # Split decl/assign: `var out = table` has produced Aggregate slot size=4
    # (too small for internPool FieldStore @24/8 → bail=2). Empty-typed local
    # then whole-value assign forces full TypedExprFactTable frame.
    var out: TypedExprFactTable
    out = share(table)
    # Fact tables have independent release lifetimes. Preserve positional ids
    # while deep-cloning the pool so releasing either table cannot invalidate
    # the other.
    out.internPool = clonedInternPool
    if cloneArena:
        out.arena = clonedArena
    return out

@borrows
fn TypedExprFactTablesEqual(lhs: TypedExprFactTable,
                             rhs: TypedExprFactTable): bool =
    if lhs.count != rhs.count:
        return false
    for i in 0..<lhs.count:
        if !TypedExprFactEqual(TypedExprFactAt(lhs, i), TypedExprFactAt(rhs, i)):
            return false
    return true

fn TypedExprFactExprId(table: TypedExprFactTable, index: int32): str =
    if index < 0 || index >= table.count:
        panic(" typed expr fact table: index out of bounds")
    return typedExprFactTableText(table, arenamod.ArenaArrayInt32Get(table.arena, table.exprIdIds, index))

