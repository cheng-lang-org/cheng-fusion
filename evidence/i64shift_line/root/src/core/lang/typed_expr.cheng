        importcsFfiOwnedResultFreeIds: langintern.InternId[]
        importStarts: int32[]
        importCounts: int32[]
        importQualifierIds: langintern.InternId[]
        importTargetSourcePathIds: langintern.InternId[]
        importAllowsUnqualifiedCalls: bool[]
        importBuildEntryIndexes: int32[]
        importTargetBuildEntryIndexes: int32[]
        declaredStarts: int32[]
        declaredCounts: int32[]
        declaredTypeIds: langintern.InternId[]
        declaredTypeProducerSourceIndexes: int32[]
        declaredTypeDeclarationSourceLocalRows: int32[]
        declaredTypeBuiltinKinds: int32[]
        declaredBuildEntryIndexes: int32[]
        refStarts: int32[]
        refCounts: int32[]
        refTypeIds: langintern.InternId[]
        refBuildEntryIndexes: int32[]
        aliasStarts: int32[]
        aliasCounts: int32[]
        aliasNameIds: langintern.InternId[]
        aliasTargetTypeIds: langintern.InternId[]
        aliasBuildEntryIndexes: int32[]
        fieldStarts: int32[]
        fieldCounts: int32[]
        fieldOwnerTypeIds: langintern.InternId[]
        fieldNameIds: langintern.InternId[]
        fieldTypeIds: langintern.InternId[]
        fieldOffsetBytes: int32[]
        fieldSizeBytes: int32[]
        fieldAlignBytes: int32[]
        fieldProducerSourceIndexes: int32[]
        fieldOwnerDeclarationSourceLocalRows: int32[]
        fieldDeclarationSourceLocalRows: int32[]
        fieldOrdinals: int32[]
        fieldBuiltinKinds: int32[]
        fieldBuildEntryIndexes: int32[]
        fieldBuildNodeIndexes: int32[]
        enumStarts: int32[]
        enumCounts: int32[]
        enumNameIds: langintern.InternId[]
        enumTypeIds: langintern.InternId[]
        enumOrdinals: int32[]
        enumNameBuildEntryIndexes: int32[]
        enumTypeBuildEntryIndexes: int32[]
        moduleConstStarts: int32[]
        moduleConstCounts: int32[]
        moduleConstNameIds: langintern.InternId[]
        moduleConstLiteralIds: langintern.InternId[]
        moduleConstBuildEntryIndexes: int32[]
        contextMetadataRowCounts: int32[]

    # Module-private fixed-point authority. External modules can neither name nor
    # construct this type; they can only ask a TypedExprIr to seal/use/close it.
    # The compact projection and every whole-metadata lookup are built once at seal.
    typedExprFrozenMetadataSession = ref object
        projection: typedExprFrozenMetadataProjection
        index: TypedExprBuildIndex
        buildGeneration: int32
        sessionGeneration: int32
        buildCount: int32
        contextCount: int32
        fullContextCount: int32
        scopeCount: int32
        importcCount: int32
        metadataRowCount: int32
        validationEpochAtSeal: int32
        reuseCountAtSeal: int32
        sealedValidationCount: int32
        metadataRowsVisitedAfterSeal: int64
        canonicalDigestFirst: int64
        canonicalDigestSecond: int64
        canonicalIndexBytes: int64
        canonicalStoreBytes: int64
        preSealFullIndexBytes: int64
        duplicatedSemanticTextBytes: int64
        derivedIrSemanticTextBytes: int64
        derivedIrCanonicalTextOverlapBytes: int64
        roundViewLiveBytes: int64
        roundPeakBytes: int64
        roundContextCount: int32
        roundDependencyCount: int32
        lastRoundContextCount: int32
        lastRoundDependencyCount: int32
        lateFailureAfterScopeCount: int32
        lateFailureObserved: bool
        fullValidationCount: int32
        finalValidationEpoch: int32
        fullValidationActive: bool
        closed: bool
        released: bool
        # Round-view reuse cache: the projection is immutable after seal, so
        # a round view is a pure function of (contextIndex, includeMetadata,
        # selected scope window).  Parking the latest round's views here and
        # taking them back on an exact key match replaces the per-round
        # re-materialization that dominates the facts segment.  MoveInto/
        # TakeAt transfer ownership; a tombstoned key slot is skipped.
        roundParkKeys: int32[]
        roundParkMetadata: bool[]
        roundParkScopeStarts: int32[]
        roundParkScopeEnds: int32[]
        roundParkRowIds: int32[]
        roundParkRowStarts: int32[]
        roundParkFullMaterialize: bool[]
        roundCacheKeys: int32[]
        roundCacheMetadata: bool[]
        roundCacheScopeStarts: int32[]
        roundCacheScopeEnds: int32[]
        roundCacheRowIds: int32[]
        roundCacheRowStarts: int32[]
        roundCacheFullMaterialize: bool[]
        roundCacheContexts: TypedExprSourceContext[]

    typedExprSparseContextSelection =
        bucketHeads: int32[]
        next: int32[]
        contextIndexes: int32[]
        includeMetadata: bool[]

    typedExprFrozenExpectedEntryAudit =
        seen: bool[]
        states: TypedExprBuildIndexLookupState[]
        valueIndexes: int32[]
        originIds: langintern.InternId[]
        fingerprintIds: langintern.InternId[]

    typedExprFrozenExpectedVisibilityAudit =
        seen: bool[]

    TypedExprReturnOpFact =
        sourcePath: str
        functionName: str
        signatureLineNumber: int32
        bodyLineNumber: int32
        opKind: TypedExprReturnOpKind
        returnType: str
        lhsName: str
        lhsType: str
        rhsName: str
        rhsType: str
        accName: str
        accType: str
        returnExpr: str

    TypedExprIrNode =
        sourcePath: str
        functionName: str
        nodeIndex: int32
        lineNumber: int32
        originParserNodeId: int32 = -1
        syntheticOriginKind: int32
        spanAuthorityKind: int32
        opKind: TypedExprIrOpKind
        exprClass: TypedExprExprClass
        resultType: str
        resultTypeProofKind: int32
        resultTypeManaged: bool
        resultTypeSend: bool
        resultTypeSync: bool
        # Canonical TypeArena row selected by the semantic producer. -1 is
        # allowed only for nodes outside the currently closed semantic subset.
        resultStructuralTypeId: int32 = -1
        surfaceText: str
        paramSlot: int32
        paramName: str
        paramMutableFlag: bool
        operand0NodeIndex: int32
        operand1NodeIndex: int32
        operand2NodeIndex: int32
        literalText: str
        callTarget: str
        callTargetSourcePath: str
        callTargetSignatureLineNumber: int32
        callTargetImportc: bool
        callKind: TypedExprCallKind = TypedExprCallNone
        callDeclarationIndex: int32 = -1
        funcRefTargetDomain: int32
        funcRefCallDeclarationRow: int32 = -1
        fieldTypeSourcePath: str
        fieldOffsetBytes: int32
        fieldSizeBytes: int32
        fieldAlignBytes: int32
        fieldProducerSourceIndex: int32 = -1
        fieldOwnerDeclarationSourceLocalRow: int32 = -1
        fieldDeclarationSourceLocalRow: int32 = -1
        fieldOrdinal: int32 = -1
        fieldBuiltinKind: int32
        elemSizeBytes: int32
        # Exact parser lexical-binding identity. The durable column carries
        # the source-stable source-local parser node row (the snapshot
        # bindingParserSourceLocalNodeRows contract domain, stable when
        # parser forests are appended); the sealed forest-global row lives
        # in bindingParserForestNodeIndexes and is valid only against the
        # same sealed parser tree.
        bindingParserNodeIndex: int32 = -1
        bindingParserForestNodeIndex: int32 = -1
        bindingParserProducerSourceIndex: int32 = -1
        bindingDeclarationSourceLocalRow: int32 = -1
        bindingPatternSourceLocalRow: int32 = -1
        # ParamRef and LocalRef name the exact immutable source definition row.
        bindingValueDefinitionRow: int32 = -1
        # Exact value-definition authority rows captured by a closure node.
        # Empty for every non-closure op and for a non-capturing closure.
        captureValueDefinitionRows: int32[]

    TypedExprIrStatement =
        sourcePath: str
        functionName: str
        statementIndex: int32
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        lexicalScopeId: int32
        suiteScopeId: int32
        statementOrdinal: int32
        lexicalOrdinal: int32
        deferOwnerStatementOrdinal: int32
        lineIndent: int32
        enclosingIfLineNumber: int32
        enclosingIfConditionText: str
        exprId: str
        kind: TypedExprIrStatementKind
        callKind: TypedExprCallKind
        detailKind: parser.NormalizedExprDetailKind
        surfaceText: str
        bindingName: str
        resultType: str
        conditionKind: int32
        conditionLhsText: str
        conditionRhsText: str
        conditionLiteralText: str
        assignRootName: str
        assignRootType: str
        assignRootSourcePath: str
        assignRootGlobalFlag: bool
        assignPlaceKind: TypedExprPlaceKind
        assignFieldName: str
        assignFieldType: str
        assignFieldOffsetBytes: int32
        assignFieldSizeBytes: int32
        assignFieldAlignBytes: int32
        assignValueRootName: str
        assignValueRootType: str
        assignValueFieldName: str
        assignValueFieldType: str
        assignValueFieldOffsetBytes: int32
        assignValueFieldSizeBytes: int32
        assignValueFieldAlignBytes: int32
        assignValueOpKind: TypedExprIrOpKind
        assignValueLhsText: str
        assignValueRhsText: str
        assignValueRhsConst: int32
        assignValueRhsHasConst: bool
        callQualifier: str
        callCallee: str
        callTarget: str
        callTargetSourcePath: str
        callTargetSignatureLineNumber: int32
        callTargetImportc: bool
        callArgCount: int32
        callArgsText: str
        callArgTypesText: str
        valueExprCallNodeIndex: int32
        # Immutable source-local parser call identity. This is deliberately
        # separate from valueExprCallNodeIndex, whose structural row can be
        # rebased when a parser tree is appended into a frontier forest.
        originParserNodeId: int32 = -1
        valueExprArgRootStart: int32
        valueExprArgRootCount: int32
        valueExprRootNodeIndex: int32
        valueExprSpanStart: int32
        valueExprSpanEnd: int32
        valueExprStatementRole: parser.ParserValueExprStatementRole
        callArgNodeStart: int32
        callArgNodeCount: int32
        rhsNodeIndex: int32
        rhsBailReason: RhsBailReason
        callSurfaceKind: CallSurfaceKind
        forStartNodeIndex: int32
        # Exact complete assignment place.  This is a TypedExpr node identity,
        # not text reconstructed by lowering; FieldGet/IndexGet parents retain
        # every TypeArena projection hop.
        assignLvalueNodeIndex: int32
        assignIndexNodeIndex: int32
        # [wall72] 语句级「绑定目标定义行」。赋值目标 LHS 是文本降级拼写，树内
        # 无 identifier 节点、无 Pattern 行、无可解析绑定身份（w31 重证契约，
        # Desugared+NoSource），故节点五列绑定通道对 LHS 按设计恒缺；本列把
        # 该语句绑定目标的权威 valueDefinitions 定义行（声明组唯一
        # definitionRows，消费时一次写定）挂在语句坐标上。-1=本语句无绑定
        # 目标定义身份（非声明/未消费），消费端不得据此盖章。精确身份禁令
        # 不破：本列只搬运 typed-ir 权威域既有的精确行坐标，零名字查行。
        bindingTargetDefinitionRow: int32 = -1
        loweringMode: TypedExprLoweringMode
        returnKind: TypedExprReturnKind
        returnRoot: bool

    TypedExprIrFunction =
        sourcePath: str
        functionName: str
        signatureLineNumber: int32
        endLineNumber: int32
        bodyLineNumber: int32
        returnType: str
        resultExprClass: TypedExprExprClass
        borrowsArguments: bool
        returnExpr: str
        statementStart: int32
        statementCount: int32
        scopeStart: int32
        scopeCount: int32
        nodeStart: int32
        nodeCount: int32
        returnNodeIndex: int32
        valueDefinitionStart: int32
        valueDefinitionCount: int32
        valueDefinitionGroupStart: int32
        valueDefinitionGroupCount: int32
        manualConsumePresent: bool
        manualConsumeFunctionDeclarationRow: int32 = -1
        manualConsumeTargetParameterOrdinal: int32 = -1
        manualConsumeSourceParameterOrdinal: int32 = -1
        manualConsumeTargetParameterDeclarationRow: int32 = -1
        manualConsumeSourceParameterDeclarationRow: int32 = -1
        manualConsumeTargetTypeId: int32 = -1
        manualConsumeSourceTypeId: int32 = -1
        manualConsumeEffectCid: layout.FixedBytes32

    TypedExprColdCsgTypeRow =
        sourcePath: str
        rowKind: TypedExprColdCsgTypeRowKind
        typeName: str
        specs: str
        typeParams: str

    TypedExprColdCsgStatementRow =
        sourcePath: str
        functionName: str
        lineNumber: int32
        lineIndent: int32
        kind: str
        payloadText: str

    TypedExprIr =
        buildIndex: TypedExprBuildIndex
        buildIndexGeneration: int32
        typedExprMetadataSession: typedExprFrozenMetadataSession
        typedExprMetadataSessionGeneration: int32
        typedExprGlobalMetadataReady: bool
        # combo B-3: Arena for ArenaArrayInt32-backed columns (per-column incremental
        # migration int32[]→ArenaArrayInt32; arena unused until columns migrate).
        arena: arenamod.Arena
        # Transient immutable parser-tree view used only while one IR build
        # transaction consumes statement/fact valueExpr* ids.  This is an
        # explicit lease, never a deep clone and never persisted across calls.
        valueExprTree: parser.ParserValueExprTree
        valueExprTreeBorrowLease: bool
        valueExprTransactionNodeStart: int32
        # Sealed-forest Pattern indexes.  Built once from the parser child CSR
        # and PatternBinding declaration map; reused across value-tree borrow
        # rounds while the tree stays structurally sealed.  No source text,
        # span, line, name, or function signature participates.
        valueExprPatternParentRows: int32[]
        valueExprPatternRootRows: int32[]
        valueExprPatternRootBindingCounts: int32[]
        valueExprDeclarationBindingPatternRows: int32[]
        valueExprBindingInitializerStatementRootRows: int32[]
        # Transaction-only exact Local+Declaration row -> group row.
        # `var acc: int32` has no BindingInitializer root; Identifier
        # Pattern lookup still needs a consumed group.
        valueExprTransactionDeclarationLocalGroupRows: int32[]
        # Parser forests are rebuilt per reachability round, so their producer
        # coordinate is round-local. Persistent value-def identity uses the
        # package-wide metadata producer coordinate below; never conflate them.
        valueExprTransactionParserProducerSourceIndex: int32 = -1
        valueExprTransactionProducerSourceIndex: int32 = -1
        valueExprTransactionDefinitionGroupStart: int32
        # Dense transaction group offset -> exact BindingInitializer parser
        # root. Declaration-only locals use -1 and are joined through the
        # exact declaration-row map above; no group ordering is assumed.
        valueExprTransactionDefinitionGroupRootNodeIndexes: int32[]
        # Transaction-only exact parser aggregate-root -> persistent group
        # range. One BindingInitializer root owns one dense row per exact
        # PatternBinding leaf. -1/0 means the root is not registered.
        valueExprTransactionDefinitionGroupStartsByRootNodeIndex: int32[]
        valueExprTransactionDefinitionGroupCountsByRootNodeIndex: int32[]
        # Transaction-only exact parser Pattern row -> persistent group row.
        # This makes every LocalRef lookup O(1) without a text/span scan.
        valueExprTransactionDefinitionGroupRowsByPatternRow: arenamod.ArenaArrayInt32
        # Transaction-only exact declaration row -> parameter ABI ordinal,
        # plus per-parser-function cardinality. Both are built once from the
        # sealed parser declaration SoA and make every ParamRef lookup O(1).
        valueExprTransactionParameterOrdinalsByDeclarationRow: arenamod.ArenaArrayInt32
        valueExprTransactionParameterCountsByFunctionRow: arenamod.ArenaArrayInt32
        valueExprTransactionParameterOrdinalLookupCount: int32
        # Current-function parameter definition nodes in ABI slot order.
        # Exact parser declaration rows select this table by structural
        # parameter ordinal, never by name, span, or source line.
        valueExprCurrentParamDefinitionNodeIndexes: int32[]
        valueExprCurrentParamValueDefinitionRows: int32[]
        valueExprCurrentParserFunctionRow: int32 = -1
        valueExprCallMetaResultTypeIds: langintern.InternId[]
        # Structural call row -> immutable source-local parser producer id.
        # This survives frontier-tree rebasing independently of the tree row.
        valueExprCallMetaOriginParserNodeIds: int32[]
        # Canonical functions SoA columns (combo C Phase2, 2026-06-28; legacy AoS
        # `functions: TypedExprIrFunction[]` removed — producers write only SoA).
        functions2_sourcePathIds: langintern.InternId[]
        functions2_functionNameIds: langintern.InternId[]
        functions2_signatureLineNumbers: arenamod.ArenaArrayInt32
        functions2_endLineNumbers: arenamod.ArenaArrayInt32
        functions2_bodyLineNumbers: arenamod.ArenaArrayInt32
        functions2_returnTypeIds: langintern.InternId[]
        functions2_resultExprClasses: TypedExprExprClass[]
        functions2_borrowsArguments: bool[]
        functions2_manualConsumePresents: bool[]
        functions2_manualConsumeFunctionDeclarationRows: int32[]
        functions2_manualConsumeTargetParameterOrdinals: int32[]
        functions2_manualConsumeSourceParameterOrdinals: int32[]
        functions2_manualConsumeTargetParameterDeclarationRows: int32[]
        functions2_manualConsumeSourceParameterDeclarationRows: int32[]
        functions2_manualConsumeTargetTypeIds: int32[]
        functions2_manualConsumeSourceTypeIds: int32[]
        functions2_manualConsumeEffectCids: layout.FixedBytes32[]
        # combo B final: str[] column removed; values live in internPool, read via id lookup.
        functions2_returnExprIds: langintern.InternId[]
        functions2_statementStarts: arenamod.ArenaArrayInt32
        functions2_statementCounts: arenamod.ArenaArrayInt32
        functions2_scopeStarts: arenamod.ArenaArrayInt32
        functions2_scopeCounts: arenamod.ArenaArrayInt32
        functions2_nodeStarts: arenamod.ArenaArrayInt32
        functions2_nodeCounts: arenamod.ArenaArrayInt32
        functions2_returnNodeIndexs: arenamod.ArenaArrayInt32
        functions2_valueDefinitionStarts: arenamod.ArenaArrayInt32
        functions2_valueDefinitionCounts: arenamod.ArenaArrayInt32
        functions2_valueDefinitionGroupStarts: arenamod.ArenaArrayInt32
        functions2_valueDefinitionGroupCounts: arenamod.ArenaArrayInt32
        # Function-local dense lexical scope tree. Function scopeStart/scopeCount
        # owns each contiguous range; parent ids are local to that function.
        scopes2_scopeIds: arenamod.ArenaArrayInt32
        scopes2_parentScopeIds: arenamod.ArenaArrayInt32
        scopes2_kinds: parser.NormalizedScopeKind[]
        scopes2_ownerStatementOrdinals: arenamod.ArenaArrayInt32
        scopes2_lexicalOrdinals: arenamod.ArenaArrayInt32
        scopes2_startLineNumbers: arenamod.ArenaArrayInt32
        scopes2_startColumnNumbers: arenamod.ArenaArrayInt32
        scopes2_endLineNumbers: arenamod.ArenaArrayInt32
        scopes2_endColumnNumbers: arenamod.ArenaArrayInt32
        # Canonical statements SoA columns (combo C Phase2, 2026-06-28; legacy AoS
        # `statements: TypedExprIrStatement[]` removed — producers write only SoA).
        # Within every functions2_statementStarts/counts range, scope ids,
        # statement ordinals, lexical ordinals, and defer owners are function-local.
        # Source-wide identities remain in NormalizedExprLayer and never cross this boundary.
        statements2_sourcePathIds: langintern.InternId[]
        statements2_functionNameIds: langintern.InternId[]
        statements2_statementIndexs: arenamod.ArenaArrayInt32
        statements2_lineNumbers: arenamod.ArenaArrayInt32
        statements2_columnNumbers: arenamod.ArenaArrayInt32
        statements2_endLineNumbers: arenamod.ArenaArrayInt32
        statements2_endColumnNumbers: arenamod.ArenaArrayInt32
        statements2_lexicalScopeIds: arenamod.ArenaArrayInt32
        statements2_suiteScopeIds: arenamod.ArenaArrayInt32
        statements2_statementOrdinals: arenamod.ArenaArrayInt32
        statements2_lexicalOrdinals: arenamod.ArenaArrayInt32
        statements2_deferOwnerStatementOrdinals: arenamod.ArenaArrayInt32
        statements2_lineIndents: arenamod.ArenaArrayInt32
        statements2_enclosingIfLineNumbers: arenamod.ArenaArrayInt32
        statements2_enclosingIfConditionTextIds: langintern.InternId[]
        statements2_exprIdIds: langintern.InternId[]
        statements2_kinds: TypedExprIrStatementKind[]
        statements2_callKinds: TypedExprCallKind[]
        statements2_detailKinds: parser.NormalizedExprDetailKind[]
        statements2_surfaceTextIds: langintern.InternId[]
        statements2_bindingNameIds: langintern.InternId[]
        statements2_resultTypeIds: langintern.InternId[]
        statements2_conditionKinds: arenamod.ArenaArrayInt32
        statements2_conditionLhsTextIds: langintern.InternId[]
        statements2_conditionRhsTextIds: langintern.InternId[]
        statements2_conditionLiteralTextIds: langintern.InternId[]
        statements2_assignRootNameIds: langintern.InternId[]
        statements2_assignRootTypeIds: langintern.InternId[]
        statements2_assignRootSourcePathIds: langintern.InternId[]
        statements2_assignRootGlobalFlags: bool[]
        statements2_assignPlaceKinds: TypedExprPlaceKind[]
        statements2_assignFieldNameIds: langintern.InternId[]
        statements2_assignFieldTypeIds: langintern.InternId[]
        statements2_assignFieldOffsetBytes: arenamod.ArenaArrayInt32
        statements2_assignFieldSizeBytes: arenamod.ArenaArrayInt32
        statements2_assignFieldAlignBytes: arenamod.ArenaArrayInt32
        statements2_assignValueRootNameIds: langintern.InternId[]
        statements2_assignValueRootTypeIds: langintern.InternId[]
        statements2_assignValueFieldNameIds: langintern.InternId[]
        statements2_assignValueFieldTypeIds: langintern.InternId[]
        statements2_assignValueFieldOffsetBytes: arenamod.ArenaArrayInt32
        statements2_assignValueFieldSizeBytes: arenamod.ArenaArrayInt32
        statements2_assignValueFieldAlignBytes: arenamod.ArenaArrayInt32
        statements2_assignValueOpKinds: TypedExprIrOpKind[]
        statements2_assignValueLhsTextIds: langintern.InternId[]
        statements2_assignValueRhsTextIds: langintern.InternId[]
        statements2_assignValueRhsConsts: arenamod.ArenaArrayInt32
        statements2_assignValueRhsHasConsts: bool[]
        statements2_callQualifierIds: langintern.InternId[]
        statements2_callCalleeIds: langintern.InternId[]
        statements2_callTargetIds: langintern.InternId[]
        statements2_callTargetSourcePathIds: langintern.InternId[]
        statements2_callTargetSignatureLineNumbers: arenamod.ArenaArrayInt32
        statements2_callTargetImportcs: bool[]
        statements2_callArgCounts: arenamod.ArenaArrayInt32
        statements2_callArgsTextIds: langintern.InternId[]
        statements2_callArgTypesTextIds: langintern.InternId[]
        statements2_valueExprCallNodeIndexes: arenamod.ArenaArrayInt32
        statements2_valueExprArgRootStarts: arenamod.ArenaArrayInt32
        statements2_valueExprArgRootCounts: arenamod.ArenaArrayInt32
        statements2_valueExprRootNodeIndexes: arenamod.ArenaArrayInt32
        statements2_valueExprSpanStarts: arenamod.ArenaArrayInt32
        statements2_valueExprSpanEnds: arenamod.ArenaArrayInt32
        statements2_valueExprStatementRoles: arenamod.ArenaArrayInt32
        statements2_callArgNodeStarts: arenamod.ArenaArrayInt32
        statements2_callArgNodeCounts: arenamod.ArenaArrayInt32
        statements2_rhsNodeIndexs: arenamod.ArenaArrayInt32
        statements2_rhsBailReasons: RhsBailReason[]
        statements2_callSurfaceKinds: CallSurfaceKind[]
        statements2_forStartNodeIndexs: arenamod.ArenaArrayInt32
        statements2_assignLvalueNodeIndexs: arenamod.ArenaArrayInt32
        statements2_assignIndexNodeIndexs: arenamod.ArenaArrayInt32
        # [wall72] 语句级绑定目标定义行（见 TypedExprIrStatement 同名字段注释）。
        statements2_bindingTargetDefinitionRows: arenamod.ArenaArrayInt32
        statements2_loweringModes: TypedExprLoweringMode[]
        statements2_returnKinds: TypedExprReturnKind[]
        statements2_returnRoots: bool[]
        # Canonical nodes SoA columns (combo C Phase2, 2026-06-28; legacy AoS
        # `nodes: TypedExprIrNode[]` removed — producers write only SoA).
        nodes2_sourcePathIds: langintern.InternId[]
        nodes2_functionNameIds: langintern.InternId[]
        nodes2_nodeIndexs: arenamod.ArenaArrayInt32
        nodes2_lineNumbers: arenamod.ArenaArrayInt32
        nodes2_originParserNodeIds: arenamod.ArenaArrayInt32
        nodes2_syntheticOriginKinds: arenamod.ArenaArrayInt32
        nodes2_spanAuthorityKinds: arenamod.ArenaArrayInt32
        nodes2_opKinds: TypedExprIrOpKind[]
        nodes2_exprClasses: TypedExprExprClass[]
        nodes2_resultTypeProofKinds: arenamod.ArenaArrayInt32
        nodes2_resultTypeManagedFlags: bool[]
        nodes2_resultTypeSendFlags: bool[]
        nodes2_resultTypeSyncFlags: bool[]
        nodes2_valueKinds: arenamod.ArenaArrayInt32
        nodes2_shareKinds: arenamod.ArenaArrayInt32
        nodes2_shareProofKinds: arenamod.ArenaArrayInt32
        nodes2_captureStarts: arenamod.ArenaArrayInt32
        nodes2_captureCounts: arenamod.ArenaArrayInt32
        # Optional CFG/liveness fact. -1 means absent; otherwise the value is
        # the exact current-function valueDefinitions row that this managed
        # borrowed use may consume as a true move.
        nodes2_lastUseMoveValueDefIds: arenamod.ArenaArrayInt32
        nodes2_structuralTypeIds: arenamod.ArenaArrayInt32
        nodes2_resultTypeIds: langintern.InternId[]
        nodes2_surfaceTextIds: langintern.InternId[]
        nodes2_paramSlots: arenamod.ArenaArrayInt32
        nodes2_paramNameIds: langintern.InternId[]
        nodes2_paramMutableFlags: bool[]
        nodes2_operand0NodeIndexs: arenamod.ArenaArrayInt32
        nodes2_operand1NodeIndexs: arenamod.ArenaArrayInt32
        nodes2_operand2NodeIndexs: arenamod.ArenaArrayInt32
        nodes2_literalTextIds: langintern.InternId[]
        nodes2_callTargetIds: langintern.InternId[]
        nodes2_callTargetSourcePathIds: langintern.InternId[]
        nodes2_callTargetSignatureLineNumbers: arenamod.ArenaArrayInt32
        nodes2_callTargetImportcs: bool[]
        nodes2_callKinds: TypedExprCallKind[]
        nodes2_callDeclarationIndexes: arenamod.ArenaArrayInt32
        # Immutable FuncRef identity. The row is meaningful only in the exact
        # CallDeclaration domain; literal/name columns remain diagnostics.
        nodes2_funcRefTargetDomains: arenamod.ArenaArrayInt32
        nodes2_funcRefCallDeclarationRows: arenamod.ArenaArrayInt32
        nodes2_fieldTypeSourcePathIds: langintern.InternId[]
        nodes2_fieldOffsetBytes: arenamod.ArenaArrayInt32
        nodes2_fieldSizeBytes: arenamod.ArenaArrayInt32
        nodes2_fieldAlignBytes: arenamod.ArenaArrayInt32
        nodes2_fieldProducerSourceIndexes: arenamod.ArenaArrayInt32
        nodes2_fieldOwnerDeclarationSourceLocalRows: arenamod.ArenaArrayInt32
        nodes2_fieldDeclarationSourceLocalRows: arenamod.ArenaArrayInt32
        nodes2_fieldOrdinals: arenamod.ArenaArrayInt32
        nodes2_fieldBuiltinKinds: arenamod.ArenaArrayInt32
        nodes2_elemSizeBytes: arenamod.ArenaArrayInt32
        nodes2_bindingParserNodeIndexes: arenamod.ArenaArrayInt32
        nodes2_bindingParserForestNodeIndexes: arenamod.ArenaArrayInt32
        nodes2_bindingParserProducerSourceIndexes: arenamod.ArenaArrayInt32
        nodes2_bindingDeclarationSourceLocalRows: arenamod.ArenaArrayInt32
        nodes2_bindingPatternSourceLocalRows: arenamod.ArenaArrayInt32
        nodes2_bindingValueDefinitionRows: arenamod.ArenaArrayInt32
        # Exact value-definition produced by this node. References keep their
        # source edge in bindingValueDefinitionRows; producer and source rows
        # are separate immutable coordinates.
        nodes2_producedValueDefinitionRows: arenamod.ArenaArrayInt32
        # Exact global statements2 row owning this node's expression DAG.
        # Parameter declaration producers and other non-statement nodes carry
        # -1. Consumers must use this row instead of source lines or DAG scans.
        nodes2_ownerStatementIndexes: arenamod.ArenaArrayInt32
        # Closure capture rows retain exact producer identities. A
        # value-definition row is the identity; type and ownership are frozen
        # redundantly so replay detects producer drift without name lookup.
        captures2_ownerTypedNodeIndexes: arenamod.ArenaArrayInt32
        captures2_valueDefinitionRows: arenamod.ArenaArrayInt32
        captures2_exactTypeIds: arenamod.ArenaArrayInt32
        captures2_ownerships: arenamod.ArenaArrayInt32
        # CompilerCSG-sealed all-node authority. Every coordinate is an exact
        # Arena/SoA row, never a name, source line or pointer identity.
        nodes2_exactTypeArenaIds: arenamod.ArenaArrayInt32
        nodes2_ownerProducerSourceIndexes: arenamod.ArenaArrayInt32
        nodes2_ownerDeclarationSourceLocalRows: arenamod.ArenaArrayInt32
        nodes2_ownershipPremiseKinds: arenamod.ArenaArrayInt32
        nodes2_captureCompletionKinds: arenamod.ArenaArrayInt32
        nodeAuthorityTypeArenaArtifactCid: layout.FixedBytes32
        nodeAuthorityTypeArenaBound: bool
        # Immutable value-definition authority.  Every row is selected from a
        # parser declaration or source-backed CallExpr and freezes the exact
        # typed producer node's TypeId, ownership and type-proof columns.
        valueDefinitions_originKinds: arenamod.ArenaArrayInt32
        valueDefinitions_producerSourceIndexes: arenamod.ArenaArrayInt32
        # Source-local parser value node. Parameter rows use -1 because their
        # exact declaration row is the producer; source-backed initializer and
        # CallResult rows require a non-negative parser node identity.
        valueDefinitions_sourceLocalNodeIndexes: arenamod.ArenaArrayInt32
        valueDefinitions_declarationSourceLocalRows: arenamod.ArenaArrayInt32
        valueDefinitions_patternSourceLocalRows: arenamod.ArenaArrayInt32
        valueDefinitions_typedFunctionIndexes: arenamod.ArenaArrayInt32
        valueDefinitions_definingTypedNodeIndexes: arenamod.ArenaArrayInt32
        # Snapshot-local structural TypeId frozen by the TypedExpr producer
        # from the defining node. An explicit declaration TypeSyntax is only
        # an equality constraint checked later by CompilerCSG.
        valueDefinitions_exactTypeIds: arenamod.ArenaArrayInt32
        valueDefinitions_ownerships: arenamod.ArenaArrayInt32
        # Canonical lifetime root for a Borrowed managed definition.  This is
        # an exact valueDefinitions row in the same function: parameter roots
        # point to themselves, while every other borrow points directly to an
        # Owned root or to that parameter root. Non-borrowed rows carry -1.
        valueDefinitions_borrowOwnerValueDefinitionRows:
            arenamod.ArenaArrayInt32
        valueDefinitions_proofKinds: arenamod.ArenaArrayInt32
        # Exact reverse edge into valueDefinitionGroups.  The producer writes
        # both directions atomically; strict validation never rebuilds this
        # identity with a GC scratch index.
        valueDefinitions_groupRows: arenamod.ArenaArrayInt32
        valueDefinitionTypeArenaArtifactCid: layout.FixedBytes32
        valueDefinitionTypeArenaBound: bool
        # Producer-only immutable borrow. CompilerCSG binds it before TypedIR
        # production and clears it after every value-definition row has frozen
        # its exact structural TypeId.
        exactTypeArena: typearena.TypedExprTypeArena
        # Persistent coverage ledger. One row is registered for every exact
        # PatternBinding leaf before statement production. The defining row is
        # consumed exactly once by the real initializer path.
        valueDefinitionGroups_producerSourceIndexes: arenamod.ArenaArrayInt32
        valueDefinitionGroups_parserProducerSourceIndexes: arenamod.ArenaArrayInt32
        valueDefinitionGroups_initializerRootSourceLocalNodeIndexes: arenamod.ArenaArrayInt32
        # Persistent initializer-root CSR coordinates. Rows sharing one root
        # carry offsets 0..<bindingCount in parser declaration order.
        valueDefinitionGroups_bindingOffsets: arenamod.ArenaArrayInt32
        valueDefinitionGroups_bindingCounts: arenamod.ArenaArrayInt32
        valueDefinitionGroups_typedFunctionIndexes: arenamod.ArenaArrayInt32
        valueDefinitionGroups_declarationSourceLocalRows: arenamod.ArenaArrayInt32
        valueDefinitionGroups_patternSourceLocalRows: arenamod.ArenaArrayInt32
        valueDefinitionGroups_definitionRows: arenamod.ArenaArrayInt32
        valueDefinitionGroups_consumedFlags: arenamod.ArenaArrayInt32
        # Producer-only traversal context. It never enters a snapshot/hash;
        # each appended node freezes the current parser node into the SoA.
        originParserNodeStack: int32[]
        coldCsgTypeRows: TypedExprColdCsgTypeRow[]
        coldCsgStatementRows: TypedExprColdCsgStatementRow[]
        globalSourcePaths: str[]
        globalNames: str[]
        globalTypes: str[]
        # Parser-owned semantic identity. Both columns are parallel to
        # globalNames and are populated before CompilerCSG starts TypedIR
        # production. A legacy/text-only producer leaves -1 and is rejected by
        # the CompilerCSG production admission path.
        globalProducerSourceIndexes: int32[]
        globalDeclarationSourceLocalRows: int32[]
        # Parallel to globalNames: the verbatim RHS literal text of a global's
        # initializer (e.g. "42"), or "" when the global is zero-initialized.
        # The backend emits this into the global's __data slot.
        globalInitValues: str[]
        localBindingSourcePaths: str[]
        localBindingFunctionNames: str[]
        localBindingLineNumbers: int32[]
        localBindingNames: str[]
        localBindingTypes: str[]
        localBindingNameIndexBucketHeads: int32[]
        localBindingNameIndexEntryNext: int32[]
        localBindingNameIndexEntryBindingIndexes: int32[]
        localBindingNameIndexEntryNames: str[]
        localBindingNameIndexSealed: bool
        importcSourcePaths: str[]
        importcNames: str[]
        importcReturnTypes: str[]
        importcTargetSymbols: str[]
        # Declared param types per importc decl, joined with ";;" (empty when
        # the decl has no params). Parallel to importcNames. Used by the
        # backend for Darwin AArch64 packed stack-arg ABI sizing.
        importcParamTypeJoins: str[]
        typeLayoutSourcePaths: str[]
        typeLayoutNames: str[]
        typeLayoutSizeBytes: int32[]
        typeLayoutAlignBytes: int32[]
        typeLayoutFieldCounts: int32[]
        typeLayoutProducerSourceIndexes: int32[]
        typeLayoutDeclarationSourceLocalRows: int32[]
        typeLayoutBuiltinKinds: int32[]
        typeFieldSourcePaths: str[]
        typeFieldOwnerTypes: str[]
        typeFieldNames: str[]
        typeFieldTypes: str[]
        typeFieldOffsetBytes: int32[]
        typeFieldSizeBytes: int32[]
        typeFieldAlignBytes: int32[]
        typeFieldProducerSourceIndexes: int32[]
        typeFieldOwnerDeclarationSourceLocalRows: int32[]
        typeFieldDeclarationSourceLocalRows: int32[]
        typeFieldOrdinals: int32[]
        typeFieldBuiltinKinds: int32[]
        exactLayoutIndexSourceStarts: int32[]
        # Parser TypeSyntax/TypeArena authority for each exact declaration
        # coordinate. State 0 is a non-type/unbound declaration, 1 is a type
        # whose physical layout is intentionally absent (for example an
        # uninstantiated generic), and 2 carries an exact concrete layout.
        exactLayoutDeclarationAuthorityStates: int32[]
        exactLayoutDeclarationTypeArenaIds: int32[]
        exactLayoutDeclarationSizeBytes: int32[]
        exactLayoutDeclarationAlignBytes: int32[]
        exactLayoutDeclarationGenericSymbolCounts: int32[]
        exactLayoutTypeDeclarationRows: int32[]
        exactLayoutTypeBuiltinRows: int32[]
        exactLayoutFieldDeclarationRows: int32[]
        exactLayoutFieldBuiltinRows: int32[]
        exactLayoutOwnerDeclarationFieldCounts: int32[]
        exactLayoutOwnerBuiltinFieldCounts: int32[]
        typeDefAliasSourcePaths: str[]
        typeDefAliasNames: str[]
        typeDefAliasTargetTypes: str[]
        typeAliasSourcePaths: str[]
        typeAliasQualifiers: str[]
        typeAliasTargetSourcePaths: str[]
        enumValueSourcePaths: str[]
        enumValueNames: str[]
        enumValueTypes: str[]
        enumValueOrdinals: int32[]
        # ref-object types (`Name = ref`) lower as 8-byte pointers. The
        # backend type-shape resolver has only IR access, so the per-source
        # ref-type leaf names are mirrored here parallel to enum data.
        refObjectSourcePaths: str[]
        refObjectTypeNames: str[]
        sourceContextIndexSourcePaths: str[]
        sourceContextIndexBucketHeads: int32[]
        sourceContextIndexEntryNext: int32[]
        sourceContextIndexEntryIndexes: int32[]
        statementFunctionIndexBucketHeads: int32[]
        statementFunctionIndexEntryNext: int32[]
        statementFunctionIndexEntryStatementIndexes: int32[]
        statementFunctionIndexEntryNames: str[]
        # (functionName,bindingName) 语句索引: statementFunctionIndex 的键细化,
        # 同 register 点 (TypedExprStatementFunctionIndexRegister 内联注册,
        # 全部 statements2 append 点覆盖), 查询 = TypedExprIrPriorBindingType
        # (桶内收集候选升序排序后跑原选优, 替换 [min,max] 区间线性扫)。
        statementFnBindingIndexBucketHeads: int32[]
        statementFnBindingIndexEntryNext: int32[]
        statementFnBindingIndexEntryStatementIndexes: int32[]
        statementFnBindingIndexEntryFunctionNames: str[]
        statementFnBindingIndexEntryBindingNames: str[]
        # ParamRef 节点索引: key=(sourcePath,functionName,paramName)->nodeIndex,
        # 开放寻址桶+LIFO 链 (statementFunctionIndex 同范式)。register 点 =
        # TypedExprIrAddParamNode (ParamRef 唯一创建点); 查询 =
        # TypedExprIrBuildRhsIdentNode (替换 nodes2 尾块逆扫)。
        paramRefIndexBucketHeads: int32[]
        paramRefIndexEntryNext: int32[]
        paramRefIndexEntryNodeIndexes: int32[]
        paramRefIndexEntrySourcePaths: str[]
        paramRefIndexEntryFunctionNames: str[]
        paramRefIndexEntryParamNames: str[]
        # nodes2 尾块追踪: 最新连续同 (sourcePath,functionName) 段的属主 intern id
        # 与段首 nodeIndex, TypedExprIrAppendNode 每次追加时推进。用于复刻
        # BuildRhsIdentNode 原逆扫的 break-on-foreign-node 边界 (只认尾块内 ParamRef)。
        nodesTailOwnerSourcePathId: int32
        nodesTailOwnerFunctionNameId: int32
        nodesTailBlockStartNodeIndex: int32
        # combo B (task 12): string-interning pool shared by the str columns.
        # InternPool is a ref; producers Intern() text -> InternId (int32),
        # consumers LookupIntern()/texts[id] to read back. Owned in-memory by
        # the IR struct; travels with Clone/MoveInto, no cross-process serialize.
        internPool: langintern.InternPool

    TypedExprFunctionScope =
        sourcePath: str
        name: str
        # Source-local NormalizedFunctionDecl / all-Function dense ordinal.
        producerDeclarationOrdinal: int32 = -1
        startLine: int32
        endLine: int32
        returnType: str
        # Metadata/snapshot contexts release source lines before the shared
        # declaration index is built. Keep the parsed signature payload with
        # the scope; the index immediately expands it into structured columns.
        genericNameJoin: str
        genericNamesComplete: bool
        # Runtime types plus a source-impossible internal borrow marker for
        # mutable parameters. The marker is consumed only by call resolution.
        paramTypeJoin: str
        paramTypesComplete: bool
        borrowResult: bool
        # Function-level @borrows changes parameter transfer semantics, not
        # ParamRef read-view ownership.  It must survive metadata freezing so
        # call declarations and value-definition rows consume one authority.
        borrowsArguments: bool
        manualConsumePresent: bool
        manualConsumeFunctionDeclarationRow: int32 = -1
        manualConsumeTargetParameterOrdinal: int32 = -1
        manualConsumeSourceParameterOrdinal: int32 = -1
        manualConsumeTargetParameterDeclarationRow: int32 = -1
        manualConsumeSourceParameterDeclarationRow: int32 = -1
        manualConsumeTargetTypeId: int32 = -1
        manualConsumeSourceTypeId: int32 = -1
        manualConsumeEffectCid: layout.FixedBytes32
        # Per-scope loop-variable table (for-header rows) built once from
        # ctx.lines. lineEnclosingForRecordIndexes is indexed by
        # (lineNumber - startLine - 1) and stores the first less-indented
        # `for` row found by the original reverse scan.
        loopVarTableBuilt: bool
        loopVarRecordNames: str[]
        loopVarRecordLineNumbers: int32[]
        loopVarRecordIndents: int32[]
        loopVarRecordRangeFlags: bool[]
        loopVarRecordIterableTexts: str[]
        loopVarRecordNext: int32[]
        loopVarNameBucketHeads: int32[]
        loopVarLineEnclosingForRecordIndexes: int32[]

    # T79: one shared structured whole-call statement result for both
    # unrepresented-call synthesis and seq-builtin subexpr suppression.
    # Consumers must not re-implement multi-line join / bare Contains spans.
    TypedExprWholeCallStatement =
        ok: bool
        # Parser-joined source line with original leading indentation. All
        # span coordinates below and in TypedExprFact are byte offsets in this
        # one logical line, even when it came from several physical lines.
        joinedRaw: str
        text: str
        callHead: str
        argsText: str
        startLine: int32
        endLine: int32
        trimStart0: int32
        # Zero-based offsets in text. Add trimStart0 before comparing with
        # TypedExprFact spans, which are absolute in joinedRaw.
        openPos: int32
        closePos: int32

    TypedExprParam =
        name: str
        typeText: str
        mutableFlag: bool

    TypedExprBinding =
        sourcePath: str
        functionName: str
        globalFlag: bool
        mutableFlag: bool
        producerSourceIndex: int32 = -1
        declarationSourceLocalRow: int32 = -1
        lineNumber: int32
        name: str
        typeText: str
        # Verbatim RHS literal text for a global initializer (e.g. "42"), or ""
        # when the binding has no literal initializer. Only globals carry this.
        initValueText: str

    TypedExprTypeFieldDecl =
        ownerType: str
        fieldName: str
        fieldType: str
        producerSourceIndex: int32 = -1
        ownerDeclarationSourceLocalRow: int32 = -1
        fieldDeclarationSourceLocalRow: int32 = -1
        ordinal: int32 = -1
        builtinKind: TypedExprLayoutBuiltinKind
        offsetBytes: int32
        sizeBytes: int32
        alignBytes: int32

    TypedExprImportcFunction =
        sourcePath: str
        name: str
        # Source-local NormalizedFunctionDecl / all-Function dense ordinal.
        producerDeclarationOrdinal: int32 = -1
        importName: str
        returnType: str
        # Declared call-signature types joined with ";;". Mutable parameters
        # carry the internal borrow marker; IR registration strips it before
        # backend ABI sizing.
        paramTypeJoin: str
        ffiMapPtrArg: int32
        ffiMapLenArg: int32
        ffiOutPtrArgs: str
        abiInternal: bool
        ffiOwnedResultPresent: bool
        ffiOwnedResultFree: str

    TypedExprImportedModule =
        qualifier: str
        targetSourcePath: str
        # Parser import-edge contract carrier (parser: allowsUnqualifiedCall =
        # importAlias == ""). Alias-import targets stay resolvable through the
        # qualified face but never enter unqualified (bare-name) candidate
        # faces.
        allowsUnqualifiedCall: bool

    # [d2] Per-slice resolution scratch (T-B knife 2). One row per expr of the
    # slice, filled once by the fact builder and consumed by the re-validating
    # pass within the same TypedExprBuildFactsAppendSourceExprLayerWithContext
    # call. SoA columns; exprCount == 0 means "absent" and every consumer then
    # falls back to its original derivation, so the generic (non-paired) paths
    # keep their exact former behaviour.
    TypedExprSliceResolutionScratch =
        aggregateCtorTypes: str[]
        zeroArgCtorTypes: str[]
        resolveReturnTypes: str[]
        resolveSourcePaths: str[]
        resolveTargetNames: str[]
        resolveSignatureLines: int32[]
        resolveFlags: int32[]
        exprCount: int32

    # Opaque cross-module cursor for the frozen exact-owner field chain.
    # Consumers receive row indexes only through Head/Next and cannot access
    # the backing build index or its fieldRowNext storage.
    TypedExprFrozenFieldOwnerCursor =
        ownerSourcePath: str
        ownerType: str
        currentRow: int32
        remainingRows: int32
        buildGeneration: int32
        active: bool

    TypedExprSourceContext =
        buildIndex: TypedExprBuildIndex
        # Exactly one SourceContext may own a standalone index. Contexts
        # attached to TypedIR or metadata snapshots borrow that owner's index.
        buildIndexOwned: bool
        # Sealed operations use a bounded, current-round view. Metadata arrays
        # are decoded only for active sources; all cross-source reads use this
        # immutable projection and its stable context index.
        frozenMetadataProjection: typedExprFrozenMetadataProjection
        frozenMetadataContextIndex: int32
        sourcePath: str
        normalizedSourcePath: str
        packageOwnerKey: str
        snapshotOnly: bool
        factsFunctionRangeUnionBuildCount: int32
        factsFullSourceRescanCount: int32
        # Empty lineNumbers means the traditional dense line table. Reusable
        # facts contexts use sorted original line numbers with packed text;
        # sourceLineCount keeps the original coordinate domain.
        lineNumbers: int32[]
        sourceLineCount: int32
        # Metadata-producer-only source snapshot index.  It contains no dense
        # line strings: raw lines are addressed by byte range and rewritten
        # multiline rows use sparse overrides only.
        sourceByteLength: int32
        sourceLineByteStarts: int32[]
        sourceLineByteLengths: int32[]
        sourceLineOverrideIndexes: int32[]
        sourceLineOverrideTexts: str[]
        sourceIndexProducerFullTraversalCount: int32
        factsSelectedLineVisitCount: int64
        factsSelectedLineBytes: int64
        factsSelectedScopeVisitCount: int64
        factsSelectedBindingVisitCount: int64
        factsGlobalBindingVisitCount: int64
        lines: str[]
        scopes: TypedExprFunctionScope[]
        # exe 可达裁剪轮次的全量同文件函数签名表（name/params/returnType/行程）。
        # 过滤轮 ctx.scopes 只含本轮函数，同文件 helper 返回型查询需在此兜底；
        # 非过滤路径恒为空，行为不变。
        signatureScopes: TypedExprFunctionScope[]
        bindings: TypedExprBinding[]
        importcFunctions: TypedExprImportcFunction[]
        importedModules: TypedExprImportedModule[]
        declaredTypes: str[]
        # Parser-receipt authority is bound once at the compiler producer
        # boundary before metadata freezing. The counts define the complete
        # source/declaration coordinate domain, including empty tail sources.
        exactLayoutProducerSourceCount: int32
        exactLayoutDeclarationSourceCount: int32
        exactLayoutParserIdentityBound: bool
        declaredTypeProducerSourceIndexes: int32[]
        declaredTypeDeclarationSourceLocalRows: int32[]
        declaredTypeBuiltinKinds: int32[]
        refTypes: str[]
        typeDefAliasNames: str[]
        typeDefAliasTargetTypes: str[]
        typeFields: TypedExprTypeFieldDecl[]
        coldCsgTypeRows: TypedExprColdCsgTypeRow[]
        coldCsgStatementRows: TypedExprColdCsgStatementRow[]
        enumValueNames: str[]
        enumValueTypes: str[]
        enumValueOrdinals: int32[]
        # Per-line expression columns use a flat intrusive list. The previous
        # `int32[]` per source line allocated one tiny heap object for every
        # touched line in every function slice. These three SoA columns keep
        # the exact same set of columns while bounding storage by the largest
        # active slice.
        exprLineColumnHeads: int32[]
        exprLineColumnValues: int32[]
        exprLineColumnNext: int32[]
        bindingNameIndexBucketHeads: int32[]
        bindingNameIndexEntryNames: str[]
        bindingNameIndexEntryBindingIndexes: int32[]
        bindingNameIndexEntryNext: int32[]
        bindingNameIndexBuiltCount: int32
        # scope name -> scopeIndex 懒建索引 (bindingNameIndex 同范式, BuiltCount
        # 失配即重建; 尾插保链序 = scopes 数组升序, 首个链命中 = 原线性扫首匹配)。
        scopeNameIndexBucketHeads: int32[]
        scopeNameIndexEntryNames: str[]
        scopeNameIndexEntryScopeIndexes: int32[]
        scopeNameIndexEntryNext: int32[]
        scopeNameIndexBuiltCount: int32
        # Source-content caches are owned by this build context. A new context
        # for the same physical path starts empty and cannot observe old text.
        moduleConstScanned: bool
        moduleConstLookup: parser.ParserSourcePathIndexLookup
        moduleConstNames: str[]
        moduleConstLiterals: str[]
        moduleConstLookupTransientPeakBytes: int64
        moduleConstLookupFinalized: bool
        functionHeaderScanned: bool
        functionHeaderLookup: parser.ParserSourcePathIndexLookup
        functionHeaderNames: str[]
        functionHeaderReturnTypes: str[]

    # One sealed facts transaction spans a complete CompilerCSG frontier round.
    # The ref is opaque outside this module: callers can only Begin, consume
    # source-local slices, then Finish or Abort.
    TypedExprSealedFactsBatch = ref object
        session: typedExprFrozenMetadataSession
        stagedSourceTexts: TypedExprSourceText[]
        roundContexts: TypedExprSourceContext[]
        sourceIdentityIndex: TypedExprSourceIdentityIndex
        contextLookup: parser.ParserSourcePathIndexLookup
        activeSourcePaths: str[]
        activeSourceLookup: parser.ParserSourcePathIndexLookup
        activeFunctionStarts: int32[]
        activeFunctionCounts: int32[]
        sourceScopedFunctionIndexes: int32[]
        functionSourcePaths: str[]
        functionStartLines: int32[]
        functionEndLines: int32[]
        functionSelected: bool[]
        functionSelectionActive: bool
        reusableContext: TypedExprSourceContext
        reusableSourceIndex: int32
        reusableContextOwnerCount: int32
        reusableContextOwnerPeak: int32
        functionRangeUnionBuildCount: int32
        indexProducerFullTraversalCount: int32
        fullSourceRescanCount: int32
        selectedLineVisitCount: int64
        selectedLineBytes: int64
        selectedScopeVisitCount: int64
        selectedBindingVisitCount: int64
        globalBindingVisitCount: int64
        peakPackedLineCount: int32
        peakPackedLineBytes: int64
        sourceLineDomainPeak: int32
        queryLookupCount: int32
        queryProbeCount: int32
        queryMetadataScanCount: int32
        metadataContextCountExpected: int32
        metadataContextCountObserved: int32
        metadataRowsExpected: int64
        metadataRowsVisited: int64
        sealedValidationCountBefore: int32
        metadataRowsVisitedBefore: int64
        roundViewLiveBytesBefore: int64
        roundPeakBytesBefore: int64
        roundContextCountBefore: int32
        roundDependencyCountBefore: int32
        lastRoundContextCountBefore: int32
        lastRoundDependencyCountBefore: int32
        telemetryCommitted: bool
        queryWindowActive: bool
        active: bool

    TypedExprSinkInfo =
        sinkType: str
        sinkPlaceKind: TypedExprPlaceKind
        hasSink: bool
        returnRoot: bool
        functionReturnType: str

const
    TypedExprSyntheticOriginNone = 0
    TypedExprSyntheticOriginParameter = 1
    TypedExprSyntheticOriginStructuralLink = 2
    TypedExprSyntheticOriginDesugared = 3
    TypedExprSyntheticOriginImplicitControl = 4
    TypedExprSyntheticOriginRuntimeIntrinsic = 5
    TypedExprSpanAuthorityNone = 0
    TypedExprSpanAuthorityParserNode = 1
    TypedExprSpanAuthorityNoSource = 2
    TypedExprSnapshotTypeProofNone = 0
    TypedExprSnapshotTypeProofScalar = 1
    TypedExprSnapshotTypeProofManagedValue = 2
    TypedExprSnapshotTypeProofReference = 3
    TypedExprSnapshotTypeProofSequence = 4
    TypedExprSnapshotTypeProofAggregate = 5
    BodyKindReturnVoid = "return_void"
    BodyKindReturnZeroI32 = "return_zero_i32"
    BodyKindReturnI32ConstPrefix = "return_i32_const_"
    BodyKindReturnU64Arg0AndConst4NotZero = "return_u64_arg0_and_const_4_not_zero"
    BodyKindReturnU64Arg0OrConst4 = "return_u64_arg0_or_const_4"
    BodyKindReturnF64MulArgs = "return_f64_mul_args"
    BodyKindStrLenFastI32 = "str_len_fast_i32"
    BodyKindReturnI64FromI32Arg0 = "return_i64_from_i32_arg0"
    BodyKindReturnI64Arg0 = "return_i64_arg0"
    BodyKindReturnF64Arg0 = "return_f64_arg0"
    BodyKindReturnF64FromI32Arg0 = "return_f64_from_i32_arg0"
    BodyKindReturnF64FromI64Arg0 = "return_f64_from_i64_arg0"
    BodyKindReturnBoolI32Arg0Range0To31 = "return_bool_i32_arg0_range_0_31"
    BodyKindReturnStrEmpty = "return_str_empty"
    BodyKindReturnStrLiteral = "return_str_literal"
    BodyKindMainF64MulCheckExit = "main_f64_mul_check_exit"
    TypedExprManualConsumeEffectDomain = "cheng.typed_expr.manual_consume_effect"
    BodyKindReturnCallArg0I32 = "return_call_arg0_i32"
    BodyKindReturnCallNoargPassthrough = "return_call_noarg_passthrough"
    BodyKindReturnCallArg0Passthrough = "return_call_arg0_passthrough"
    BodyKindReturnCallArg0Arg1Passthrough = "return_call_arg0_arg1_passthrough"
    BodyKindReturnCallArg0Arg1Arg2Passthrough = "return_call_arg0_arg1_arg2_passthrough"
    BodyKindReturnCallArg0TruePassthrough = "return_call_arg0_true_passthrough"
    BodyKindReturnCallArg0Arg1TruePassthrough = "return_call_arg0_arg1_true_passthrough"
    BodyKindEntryBridge = "entry_bridge"
    BodyKindRuntimeSetCmdLine = "runtime_set_cmd_line"
    BodyKindRuntimeParamCount = "runtime_param_count"
    BodyKindRuntimeParamStrCopyBridge = "runtime_param_str_copy_bridge"
    BodyKindBackendDriverRootFromCmdline = "backend_driver_root_from_cmdline"
    BodyKindBackendDriverCommandDispatch = "backend_driver_command_dispatch"
    BodyKindBackendDriverCommandCode = "backend_driver_command_code"
    BodyKindBackendDriverRunCommand = "backend_driver_run_command"
    BodyKindResultRequestDispatch = "result_request_dispatch"
    BodyKindStatementSequence = "statement_sequence"
    BodyKindUnsupported = "unsupported"
    BodyKindLetCallReturnI32ConstPrefix = "let_call_return_i32_const_"
    BodyKindLetCallReturnI32ConstPrefixLen = 26
    BodyKindLetCallNoargReturnI32ConstPrefix = "let_call_noarg_return_i32_const_"
    BodyKindLetCallStrThenCallArg0ReturnI32Const0 = "let_call_str_then_call_arg0_return_i32_const_0"
    BodyKindCallArg0Const0ReturnI32Const0 = "call_arg0_const_0_return_i32_const_0"
    BodyKindCstringToStrCopy = "cstring_to_str_copy"
    BodyKindIfArg0LeZeroReturnI32Const0ElseI32Const7 = "if_arg0_le_zero_return_i32_const_0_else_i32_const_7"
    BodyKindReturnI32ConstMax = 65535
    BodyKindEntryBridgeWordCount = 17
    StatementReturnModeNone = 0
    StatementReturnModeI32Const = 1
    StatementReturnModeCallResultI32 = 2
    StatementReturnModeI32GuardResultLeZero = 3
    StatementReturnModeStrLen = 4
    StatementReturnModeStrThenCallReturnI32Const0 = 5
    StatementReturnModeCstringLiteralCallsReturnI32Const0 = 6
    TypedExprIrCondNone = 0
    TypedExprIrCondStrEqLiteral = 1
    TypedExprIrCondStrNeLiteral = 2
    TypedExprIrCondStrEqLocal = 3
    TypedExprIrCondStrNeLocal = 4

fn typedExprManualConsumeAppendI32(buf: var layout.ByteBuf, value: int32) =
    var raw = Int64(value)
    if raw < 0:
        raw = raw + Int64(4294967296)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))
    raw = raw / Int64(256)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))
    raw = raw / Int64(256)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))
    raw = raw / Int64(256)
    layout.ByteBufAppendByte(buf, Int32(raw % Int64(256)))

@borrows
fn typedExprManualConsumeAppendText(buf: var layout.ByteBuf, value: str) =
    typedExprManualConsumeAppendI32(buf, value.len)
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[byteIndex]) & 255)

@borrows
fn typedExprManualConsumeEffectCid(
        typeArenaArtifactCid: layout.FixedBytes32,
        producerSourceIndex: int32,
        producerDeclarationOrdinal: int32,
        producerFunctionRow: int32,
        functionDeclarationRow: int32,
        targetParameterOrdinal: int32,
        sourceParameterOrdinal: int32,
        targetParameterDeclarationRow: int32,
        sourceParameterDeclarationRow: int32,
        targetTypeId: int32,
        sourceTypeId: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    typedExprManualConsumeAppendText(
        buf, TypedExprManualConsumeEffectDomain)
    layout.ByteBufAppendFixed32(buf, typeArenaArtifactCid)
    typedExprManualConsumeAppendI32(buf, producerSourceIndex)
    typedExprManualConsumeAppendI32(buf, producerDeclarationOrdinal)
    typedExprManualConsumeAppendI32(buf, producerFunctionRow)
    typedExprManualConsumeAppendI32(
        buf, functionDeclarationRow)
    typedExprManualConsumeAppendI32(buf, targetParameterOrdinal)
    typedExprManualConsumeAppendI32(buf, sourceParameterOrdinal)
    typedExprManualConsumeAppendI32(
        buf, targetParameterDeclarationRow)
    typedExprManualConsumeAppendI32(
        buf, sourceParameterDeclarationRow)
    typedExprManualConsumeAppendI32(buf, targetTypeId)
    typedExprManualConsumeAppendI32(buf, sourceTypeId)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn typedExprManualConsumeEffectAbsent(
        present: bool,
        functionDeclarationRow: int32,
        targetParameterOrdinal: int32,
        sourceParameterOrdinal: int32,
        targetParameterDeclarationRow: int32,
        sourceParameterDeclarationRow: int32,
        targetTypeId: int32,
        sourceTypeId: int32,
        effectCid: layout.FixedBytes32): bool =
    return !present && functionDeclarationRow == -1 &&
           targetParameterOrdinal == -1 &&
           sourceParameterOrdinal == -1 &&
           targetParameterDeclarationRow == -1 &&
           sourceParameterDeclarationRow == -1 &&
           targetTypeId == -1 && sourceTypeId == -1 &&
           layout.FixedBytes32Equal(effectCid, layout.FixedBytes32())

@borrows
fn typedExprManualConsumeTypeIdsExact(
        arena: typearena.TypedExprTypeArena,
        targetTypeId: int32,
        sourceTypeId: int32): bool =
    if arena == nil || !arena.complete ||
       targetTypeId < 0 || sourceTypeId < 0 ||
       targetTypeId == sourceTypeId ||
       targetTypeId >= typearena.TypedExprTypeArenaTypeCount(arena) ||
       sourceTypeId >= typearena.TypedExprTypeArenaTypeCount(arena):
        return false
    return typearena.TypedExprTypeArenaUnaryChildTypeId(
               arena,
               targetTypeId,
               typearena.TypedExprStructuralTypeBorrow,
               typearena.TypedExprStructuralTypeBorrow) == sourceTypeId &&
           typearena.TypedExprTypeArenaKindAt(
               arena, sourceTypeId) ==
               typearena.TypedExprStructuralTypeSequence &&
           typearena.TypedExprTypeArenaManagedAt(arena, sourceTypeId)

@borrows
fn TypedExprBuildStructuredTypeArenaFromParserTreeInto(
        tree: parser.ParserValueExprTree,
        authority: typearena.TypedExprTypeResolutionAuthority,
        out: var typearena.TypedExprTypeArena,
        err: var str): bool =
    # TypedExpr consumes parser TypeSyntax through this one structural entry.
    # Type text and caller-supplied trait flags are not accepted as authority.
    return typearena.TypedExprTypeArenaBuildFromParserTreeInto(
        tree, authority, out, err)

fn TypedExprTraceInit() =
    typedExprTraceInitialized = true
    typedExprTraceStdout = false
    typedExprTracePath = ""

fn TypedExprTraceLine(text: str) =
    typedExprTraceInitialized = true

fn TypedExprTraceStderrLine(enabled: bool,
                             text: str) =
    if enabled:
        os.WriteLine(os.Get_stderr(), text)

fn TypedExprProgress(text: str) =
    typedExprTraceInitialized = true

fn TypedExprFactsContextTrace(text: str) =
    typedExprTraceInitialized = true

fn TypedExprSourceContextTrace(text: str) =
    typedExprSourceContextTraceInitialized = true

fn TypedExprSetFactsTraceStderr(enabled: bool) =
    typedExprFactsTraceStderr = enabled

var typedExprScopeDebugEnvReady: bool
var typedExprScopeDebugEnvValue: str
var typedExprFilterDebugEnvReady: bool
var typedExprFilterDebugEnvValue: str

# CHENG_TYPED_IR_SCOPE_DEBUG / CHENG_TYPED_FILTER_DEBUG are compared against
# scope.name once per function scope; cache the env values so scope builds do
# not re-run os.GetEnv (~32B per probe) for every function.
fn TypedExprScopeDebugEnvName(): str =
    if !typedExprScopeDebugEnvReady:
        typedExprScopeDebugEnvValue = os.GetEnv("CHENG_TYPED_IR_SCOPE_DEBUG")
        typedExprScopeDebugEnvReady = true
    return typedExprScopeDebugEnvValue

fn TypedExprFilterDebugEnvName(): str =
    if !typedExprFilterDebugEnvReady:
        typedExprFilterDebugEnvValue = os.GetEnv("CHENG_TYPED_FILTER_DEBUG")
        typedExprFilterDebugEnvReady = true
    return typedExprFilterDebugEnvValue

var typedExprTypeFieldDedupTraceReady: bool
var typedExprTypeFieldDedupTraceFlag: bool

fn TypedExprTypeFieldDedupTraceEnabled(): bool =
    if !typedExprTypeFieldDedupTraceReady:
        typedExprTypeFieldDedupTraceFlag = os.GetEnv("CHENG_TYPE_FIELD_DEDUP_TRACE") == "1"
        typedExprTypeFieldDedupTraceReady = true
    return typedExprTypeFieldDedupTraceFlag

var typedExprFactsTraceEnvReady: bool
var typedExprFactsTraceEnvEnabled: bool

# Cache the env probe: this predicate runs in per-statement validator loops,
# and per-call os.GetEnv allocates ~32B per probe.
fn TypedExprFactsStderrTraceEnabled(): bool =
    if typedExprFactsTraceStderr:
        return true
    if !typedExprFactsTraceEnvReady:
        typedExprFactsTraceEnvEnabled = os.GetEnv("CHENG_TYPED_FACTS_STDERR") == "1"
        typedExprFactsTraceEnvReady = true
    return typedExprFactsTraceEnvEnabled

fn TypedExprFactsStderrTrace(text: str) =
    if TypedExprFactsStderrTraceEnabled():
        os.WriteLine(os.Get_stderr(), text)

@borrows
fn TypedExprIsReturnCallBodyKind(bodyKind: str): bool =
    if bodyKind == BodyKindReturnCallArg0I32:
        return true
    if bodyKind == BodyKindReturnCallNoargPassthrough:
        return true
    if bodyKind == BodyKindReturnCallArg0Passthrough:
        return true
    if bodyKind == BodyKindReturnCallArg0Arg1Passthrough:
        return true
    if bodyKind == BodyKindReturnCallArg0Arg1Arg2Passthrough:
        return true
    if bodyKind == BodyKindReturnCallArg0TruePassthrough:
        return true
    if bodyKind == BodyKindReturnCallArg0Arg1TruePassthrough:
        return true
    return false

@borrows
fn TypedExprIsCallRelocBodyKind(bodyKind: str): bool =
    if TypedExprIsReturnCallBodyKind(bodyKind):
        return true
    if bodyKind == BodyKindCallArg0Const0ReturnI32Const0:
        return true
    if bodyKind == BodyKindBackendDriverCommandDispatch:
        return true
    if bodyKind == BodyKindBackendDriverRunCommand:
        return true
    if bodyKind == BodyKindResultRequestDispatch:
        return true
    return false

fn TypedExprAbiClassText(abiClass: TypedExprAbiClass): str =
    if abiClass == TypedExprAbiScalar:
        return "scalar"
    if abiClass == TypedExprAbiComposite:
        return "composite"
    if abiClass == TypedExprAbiPointerLike:
        return "pointer_like"
    return "polymorphic"

fn TypedExprValueKindText(valueKind: TypedExprValueKind): str =
    if valueKind == TypedExprValueScalar:
        return "scalar"
    if valueKind == TypedExprValueComposite:
        return "composite"
    if valueKind == TypedExprValuePointerLike:
        return "pointer_like"
    return "polymorphic"

fn TypedExprPlaceKindText(placeKind: TypedExprPlaceKind): str =
    if placeKind == TypedExprPlaceLocal:
        return "local"
    if placeKind == TypedExprPlaceGlobal:
        return "global"
    if placeKind == TypedExprPlaceField:
        return "field"
    if placeKind == TypedExprPlaceCallResult:
        return "call_result"
    return "temporary"

fn TypedExprLoweringModeText(loweringMode: TypedExprLoweringMode): str =
    if loweringMode == TypedExprLowerReg:
        return "reg"
    if loweringMode == TypedExprLowerLocalAddress:
        return "local_address"
    if loweringMode == TypedExprLowerSret:
        return "sret"
    if loweringMode == TypedExprLowerImportBuffer:
        return "import_buffer"
    return "deferred"

fn TypedExprCallKindText(callKind: TypedExprCallKind): str =
    if callKind == TypedExprCallBuiltin:
        return "builtin"
    if callKind == TypedExprCallResultIntrinsic:
        return "result_intrinsic"
    if callKind == TypedExprCallProjection:
        return "projection"
    return "none"

fn TypedExprTypeCallKindText(typeCallKind: TypedExprTypeCallKind): str =
    if typeCallKind == TypedExprTypeCallDefaultInit:
        return "default_init"
    if typeCallKind == TypedExprTypeCallConstructor:
        return "constructor"
    if typeCallKind == TypedExprTypeCallIdentity:
        return "identity"
    return "none"

fn TypedExprSurfaceCallKindText(kind: TypedExprSurfaceCallKind): str =
    if kind == TypedExprSurfaceCallLocal:
        return "local_call"
    if kind == TypedExprSurfaceCallExternal:
        return "external_call"
    if kind == TypedExprSurfaceCallImportc:
        return "importc_call"
    if kind == TypedExprSurfaceCallMember:
        return "member_call"
    return "none"

fn TypedExprCallReasonText(reason: TypedExprCallReason): str =
    if reason == TypedExprCallReasonUnknownQualifiedTarget:
        return "unknown_qualified_target"
    if reason == TypedExprCallReasonShadowedQualifiedTarget:
        return "shadowed_qualified_target"
    if reason == TypedExprCallReasonAmbiguousExternalTarget:
        return "ambiguous_external_target"
    if reason == TypedExprCallReasonAmbiguousQualifiedTarget:
        return "ambiguous_qualified_target"
    if reason == TypedExprCallReasonUnknownExternalTarget:
        return "unknown_external_target"
    if reason == TypedExprCallReasonUnknownCallTarget:
        return "unknown_call_target"
    return ""

fn TypedExprSurfaceCallKindFromParser(kind: parser.NormalizedExprSurfaceCallKind): TypedExprSurfaceCallKind =
    if kind == parser.NormalizedExprSurfaceCallLocal:
        return TypedExprSurfaceCallLocal
    if kind == parser.NormalizedExprSurfaceCallExternal:
        return TypedExprSurfaceCallExternal
    if kind == parser.NormalizedExprSurfaceCallImportc:
        return TypedExprSurfaceCallImportc
    if kind == parser.NormalizedExprSurfaceCallMember:
        return TypedExprSurfaceCallMember
    return TypedExprSurfaceCallNone

fn TypedExprCallReasonFromParser(reason: parser.NormalizedExprCallReason): TypedExprCallReason =
    if reason == parser.NormalizedExprCallReasonUnknownQualifiedTarget:
        return TypedExprCallReasonUnknownQualifiedTarget
    if reason == parser.NormalizedExprCallReasonShadowedQualifiedTarget:
        return TypedExprCallReasonShadowedQualifiedTarget
    if reason == parser.NormalizedExprCallReasonAmbiguousExternalTarget:
        return TypedExprCallReasonAmbiguousExternalTarget
    if reason == parser.NormalizedExprCallReasonAmbiguousQualifiedTarget:
        return TypedExprCallReasonAmbiguousQualifiedTarget
    if reason == parser.NormalizedExprCallReasonUnknownExternalTarget:
        return TypedExprCallReasonUnknownExternalTarget
    if reason == parser.NormalizedExprCallReasonUnknownCallTarget:
        return TypedExprCallReasonUnknownCallTarget
    return TypedExprCallReasonNone

fn TypedExprReturnKindText(returnKind: TypedExprReturnKind): str =
    if returnKind == TypedExprReturnReg:
        return "reg"
    if returnKind == TypedExprReturnCompositeLocal:
        return "composite_local"
    if returnKind == TypedExprReturnSret:
        return "sret"
    if returnKind == TypedExprReturnImportBuffer:
        return "import_buffer"
    return "deferred"

fn TypedExprArgPassKindText(kind: TypedExprArgPassKind): str =
    if kind == TypedExprArgPassValue:
        return "value"
    if kind == TypedExprArgPassAddress:
        return "address"
    if kind == TypedExprArgPassCallResultAddress:
        return "call_result_address"
    return "deferred"

fn TypedExprArgPassKindForResolved(abiClass: TypedExprAbiClass,
                                     placeKind: TypedExprPlaceKind,
                                     loweringMode: TypedExprLoweringMode): TypedExprArgPassKind =
    if loweringMode == TypedExprLowerDeferred || abiClass == TypedExprAbiPolymorphic:
        return TypedExprArgPassDeferred
    if abiClass == TypedExprAbiComposite:
        if placeKind == TypedExprPlaceCallResult:
            return TypedExprArgPassCallResultAddress
        return TypedExprArgPassAddress
    return TypedExprArgPassValue

fn TypedExprResultPassKindText(kind: TypedExprResultPassKind): str =
    if kind == TypedExprResultPassReg:
        return "reg"
    if kind == TypedExprResultPassLocalAddress:
        return "local_address"
    if kind == TypedExprResultPassSret:
        return "sret"
    if kind == TypedExprResultPassImportBuffer:
        return "import_buffer"
    return "deferred"

fn TypedExprResultPassKindForResolved(returnKind: TypedExprReturnKind): TypedExprResultPassKind =
    if returnKind == TypedExprReturnReg:
        return TypedExprResultPassReg
    if returnKind == TypedExprReturnCompositeLocal:
        return TypedExprResultPassLocalAddress
    if returnKind == TypedExprReturnSret:
        return TypedExprResultPassSret
    if returnKind == TypedExprReturnImportBuffer:
        return TypedExprResultPassImportBuffer
    return TypedExprResultPassDeferred

fn TypedExprMaterializeKindText(kind: TypedExprMaterializeKind): str =
    if kind == TypedExprMaterializeDestAddress:
        return "dest_address"
    if kind == TypedExprMaterializeImportBuffer:
        return "import_buffer"
    if kind == TypedExprMaterializeCallResultLocal:
        return "call_result_local"
    if kind == TypedExprMaterializeLocalSlot:
        return "local_slot"
    if kind == TypedExprMaterializeRegister:
        return "register"
    if kind == TypedExprMaterializeDeferred:
        return "deferred"
    return "none"

fn TypedExprMaterializeKindForResolved(valueKind: TypedExprValueKind,
                                         placeKind: TypedExprPlaceKind,
                                         loweringMode: TypedExprLoweringMode): TypedExprMaterializeKind =
    if loweringMode == TypedExprLowerDeferred || valueKind == TypedExprValuePolymorphic:
        return TypedExprMaterializeDeferred
    if loweringMode == TypedExprLowerSret:
        return TypedExprMaterializeDestAddress
    if loweringMode == TypedExprLowerImportBuffer:
        return TypedExprMaterializeImportBuffer
    if valueKind == TypedExprValueComposite:
        if placeKind == TypedExprPlaceCallResult:
            return TypedExprMaterializeCallResultLocal
        return TypedExprMaterializeLocalSlot
    if loweringMode == TypedExprLowerReg:
        return TypedExprMaterializeRegister
    return TypedExprMaterializeNone

fn TypedExprCopyKindText(kind: TypedExprCopyKind): str =
    if kind == TypedExprCopyRegionCopy:
        return "region_copy"
    if kind == TypedExprCopyScalarStore:
        return "scalar_store"
    if kind == TypedExprCopyDeferred:
        return "deferred"
    return "none"

fn TypedExprCopyKindForResolved(valueKind: TypedExprValueKind,
                                  abiClass: TypedExprAbiClass): TypedExprCopyKind =
    if abiClass == TypedExprAbiPolymorphic || valueKind == TypedExprValuePolymorphic:
        return TypedExprCopyDeferred
    if valueKind == TypedExprValueComposite:
        return TypedExprCopyRegionCopy
    if valueKind == TypedExprValueScalar || valueKind == TypedExprValuePointerLike:
        return TypedExprCopyScalarStore
    return TypedExprCopyNone

