var typedExprTraceInitialized: bool
var typedExprTraceStdout: bool
var typedExprTracePath: str
var typedExprFactsTraceStderr: bool
var typedExprSourceContextTraceInitialized: bool
var typedExprSourceContextTracePath: str
var typedExprSourceContextTraceSourceFilter: str
var typedExprSourceContextTraceDeclFilter: str
# [orcd8-inst] env-gated 诊断探针（默认零行为差）：O8CLEAR/O8FORCE 记录每个
# context 清释点的 source 身份与列长，用于 ORCM@13 首释放者归因
# （mc_line MC_CLEAR 同款方法论）。诊断轮专用，非生产路径。
var orcd8TraceArmed: bool
var orcd8TraceChecked: bool

fn orcd8TraceEnabled(): bool =
    if !orcd8TraceChecked:
        orcd8TraceChecked = true
        orcd8TraceArmed = os.GetEnv("CHENG_ORCD8_TRACE") != ""
    return orcd8TraceArmed
type
    TypedExprLayoutBuiltinKind = enum TypedExprLayoutBuiltinNone, TypedExprLayoutBuiltinStr, TypedExprLayoutBuiltinSequence, TypedExprLayoutBuiltinOptional
    TypedExprAbiClass = enum TypedExprAbiScalar, TypedExprAbiComposite, TypedExprAbiPointerLike, TypedExprAbiPolymorphic

    TypedExprValueKind = enum TypedExprValueScalar, TypedExprValueComposite, TypedExprValuePointerLike, TypedExprValuePolymorphic

    # Immutable value-expression ownership classification.  Unknown is a hard
    # boundary for managed lowering; backends must never reconstruct ownership
    # from slot names, call text, or local-slot mutation.
    TypedExprExprClass = enum
        TypedExprExprUnknown
        TypedExprExprOwned
        TypedExprExprBorrowed
        TypedExprExprUnmanaged

    # Snapshot-facing value/share authority is produced with the TypedExpr
    # node. Consumers may hash or remap these numeric conclusions, but may not
    # reconstruct them from op names, source text, or mutable local slots.
    TypedExprSnapshotValueKind = enum
        TypedExprSnapshotValueUnknown
        TypedExprSnapshotValueOrdinary
        TypedExprSnapshotValueFunctionAddress
        TypedExprSnapshotValueClosure

    TypedExprSnapshotShareKind = enum
        TypedExprSnapshotShareUnknown
        TypedExprSnapshotShareNone
        TypedExprSnapshotShareLocal
        TypedExprSnapshotShareThreadSafe

    TypedExprSnapshotValueProofKind = enum
        TypedExprSnapshotValueProofUnknown
        TypedExprSnapshotValueProofTypeTrait
        TypedExprSnapshotValueProofFlow
        TypedExprSnapshotValueProofBoundary

    TypedExprNodeOwnershipPremiseKind = enum
        TypedExprNodeOwnershipPremiseInvalid
        TypedExprNodeOwnershipPremiseOwned
        TypedExprNodeOwnershipPremiseBorrowed
        TypedExprNodeOwnershipPremiseUnmanaged

    TypedExprNodeCaptureCompletionKind = enum
        TypedExprNodeCaptureInvalid
        TypedExprNodeCaptureExactEmpty
        TypedExprNodeCaptureExactRows

    TypedExprValueDefinitionOriginKind = enum
        TypedExprValueDefinitionOriginInvalid
        TypedExprValueDefinitionOriginParameter
        TypedExprValueDefinitionOriginBindingInitializer
        TypedExprValueDefinitionOriginCallResult
        TypedExprValueDefinitionOriginManagedTemporary

    TypedExprPlaceKind = enum TypedExprPlaceLocal, TypedExprPlaceGlobal, TypedExprPlaceField, TypedExprPlaceTemporary, TypedExprPlaceCallResult

    TypedExprLoweringMode = enum TypedExprLowerReg, TypedExprLowerLocalAddress, TypedExprLowerSret, TypedExprLowerImportBuffer, TypedExprLowerDeferred

    # P1 schema extension (atomic w/ producers + consumers below):
    # 8 new cases split the ~30 暗协议 fall-back gates (currently squashed into
    # WholeCallNoTrace / Unknown catch-all) into 4 root-cause clusters:
    #   - ctor-fail (Ok/Err NoTrace inner build / type-shape ctor)
    #   - call target resolution (missing / ambiguous / qualifier split)
    #   - binary IR & generic pass-through (surface unresolved / typed param)
    #   - indexed-member / receiver-chain / tail-leaf split
    # Consumer FAIL_TRACE dispatch sites (typed_expr.cheng:1232,
    # primary_object_plan.cheng:15273/18169/18309/23662,
    # backend_driver_dispatch_min.cheng:1808/4127) translate each into a
    # frontend-readable label; 0 lowering control-flow impact.
    RhsBailReason = enum RhsBailNone, RhsBailBare, RhsBailWholeCallNoTrace, RhsBailFmt, RhsBailRange, RhsBailBadToken, RhsBailUnknown, RhsBailAggregateCtorFail, RhsBailCallTargetMissing, RhsBailCallTargetAmbiguous, RhsBailCallSurfaceUnresolved, RhsBailGenericReturn, RhsBailIndexedMember, RhsBailReceiverChainEmpty, RhsBailTailLeafSplitFail

    # Parser kinds that deliberately have no real TypedIR value op yet.  The
    # structural consumer reports one exact case and stops; it never reparses
    # source text or fabricates a weaker lowering.
    TypedExprStructuredValueUnsupportedKind = enum
        TypedExprStructuredValueSupported
        TypedExprStructuredValueInvalid
        TypedExprStructuredValueSpaceCall
        TypedExprStructuredValueTupleLiteral
        TypedExprStructuredValueBraceLiteral
        TypedExprStructuredValueSlice
        TypedExprStructuredValueTry
        TypedExprStructuredValueIf
        TypedExprStructuredValueWhen
        TypedExprStructuredValueCase
        TypedExprStructuredValueCaseBranch
        TypedExprStructuredValueComprehension
        TypedExprStructuredValueFunctionLiteral
        TypedExprStructuredValueIteratorLiteral

    # P2 schema extension (sibling of RhsBailReason): 10-case explicit
    # call-target resolution status, sealed-state replacement of the silent
    # 3-level fall-back in PrimaryBodyIrTargetFunctionIndex (foundQualifiedAnySource
    # {-1/-2/>=0} + PrimaryFunctionTargetCountAnySource {0/1/>=2} + 17 tail-name
    # silent split fail). Producer = primary_object_plan.cheng PrimaryBodyIrTargetFunctionIndex.
    # Consumer = PrimaryObjectError + PrimaryObjectIrStatement + dispatch_min
    # output. Two-tier (rhsBailReason 二元 + resolutionKind detail) lets frontend
    # distinguish DeadOverload from plain Missing without count-阈值 reverse guess.
    CallTargetResolutionKind = enum CallTargetUnresolved, CallTargetSameSourceUnique, CallTargetSameSourceAmbiguous, CallTargetQualifiedCrossSourceUnique, CallTargetQualifiedCrossSourceAmbiguous, CallTargetGlobalUnique, CallTargetGlobalAmbiguous, CallTargetMissing, CallTargetTailLeafSplitFail, CallTargetDeadOverload

    # P4 schema (atomic w/ producer at TypedExprIrAddCallStatement +
    # TypedExprIrAddCallStatementFromExpr, consumer = diagnostic stderr trace
    # in primary_object_plan/lowering_plan): explicit 9-case call-surface
    # classification, replaces strutil.Contains substring matching on
    # surfaceText for whole-call/partial-call/builtin/ffi detection.
    CallSurfaceKind = enum CallSurfaceUnknown, CallSurfaceWholeCall, CallSurfacePartialCall, CallSurfaceFnPtr, CallSurfaceBuiltin, CallSurfaceFfi, CallSurfaceBareIdent, CallSurfaceIndexed, CallSurfaceFieldAccess

    TypedExprCallKind = enum TypedExprCallNone, TypedExprCallBuiltin, TypedExprCallResultIntrinsic, TypedExprCallProjection

    TypedExprTypeCallKind = enum TypedExprTypeCallNone, TypedExprTypeCallDefaultInit, TypedExprTypeCallConstructor, TypedExprTypeCallIdentity

    TypedExprExplicitTypeConversionKind = enum
        TypedExprExplicitTypeConversionNone
        TypedExprExplicitTypeConversionDeferred
        TypedExprExplicitTypeConversionIdentity
        TypedExprExplicitTypeConversionBorrow
        TypedExprExplicitTypeConversionScalar

    TypedExprExplicitTypeConversionPlaceState = enum
        TypedExprExplicitTypeConversionPlaceUnknown
        TypedExprExplicitTypeConversionPlaceWritable
        TypedExprExplicitTypeConversionPlaceNotWritable

    TypedExprSurfaceCallKind = enum TypedExprSurfaceCallNone, TypedExprSurfaceCallLocal, TypedExprSurfaceCallExternal, TypedExprSurfaceCallImportc, TypedExprSurfaceCallMember

    TypedExprCallReason = enum TypedExprCallReasonNone, TypedExprCallReasonUnknownQualifiedTarget, TypedExprCallReasonShadowedQualifiedTarget, TypedExprCallReasonAmbiguousExternalTarget, TypedExprCallReasonAmbiguousQualifiedTarget, TypedExprCallReasonUnknownExternalTarget, TypedExprCallReasonUnknownCallTarget

    TypedExprReturnKind = enum TypedExprReturnReg, TypedExprReturnCompositeLocal, TypedExprReturnSret, TypedExprReturnImportBuffer, TypedExprReturnDeferred

    TypedExprReturnOpKind = enum TypedExprReturnOpUnsupported, TypedExprReturnOpI32AddArgs, TypedExprReturnOpI32SubArgs, TypedExprReturnOpI32MulArgs, TypedExprReturnOpI32AsrArgs, TypedExprReturnOpI32MaddArgs, TypedExprReturnOpF64MulArgs

    TypedExprIrOpKind = enum TypedExprIrOpUnsupported, TypedExprIrOpParamRef, TypedExprIrOpReturnStrArg0, TypedExprIrOpReturnComposite16Arg0, TypedExprIrOpReturnComposite16Field0Arg0, TypedExprIrOpReturnSeqLenArg0, TypedExprIrOpReturnBytesLenArg0, TypedExprIrOpReturnCharArg0, TypedExprIrOpReturnI64FromI32Arg0, TypedExprIrOpReturnBoolI32Arg0Range0To31, TypedExprIrOpI32Const, TypedExprIrOpI32Add, TypedExprIrOpI32Sub, TypedExprIrOpI32Mul, TypedExprIrOpI32Asr, TypedExprIrOpI32Madd, TypedExprIrOpU64Arg0AndConst4NotZero, TypedExprIrOpI32Arg0GeZeroAndLeConst, TypedExprIrOpI32Arg0XorConst, TypedExprIrOpI32Sdiv, TypedExprIrOpI64Sdiv, TypedExprIrOpU32Arg0AndArg1ShlArg2, TypedExprIrOpU64OrArg0Const4, TypedExprIrOpI32IfArg0LeZeroConstElseConst, TypedExprIrOpF64Mul, TypedExprIrOpStrLenFast, TypedExprIrOpMainF64MulCheckExit, TypedExprIrOpLetCall, TypedExprIrOpStrEmptyReturn, TypedExprIrOpReturnStrLiteral, TypedExprIrOpCstringToStrCopy, TypedExprIrOpIfCall, TypedExprIrOpLocalBoolEnumTernary, TypedExprIrOpI32BitAnd, TypedExprIrOpI32BitOr, TypedExprIrOpI32BitXor, TypedExprIrOpI32Lsl, TypedExprIrOpI32Lsr, TypedExprIrOpLocalRef, TypedExprIrOpStrLit, TypedExprIrOpBoolLit, TypedExprIrOpCharLit, TypedExprIrOpI64Const, TypedExprIrOpFieldGet, TypedExprIrOpIndexGet, TypedExprIrOpCmpEq, TypedExprIrOpCmpNe, TypedExprIrOpCmpLt, TypedExprIrOpCmpLe, TypedExprIrOpCmpGt, TypedExprIrOpCmpGe, TypedExprIrOpLogAnd, TypedExprIrOpLogOr, TypedExprIrOpLogNot, TypedExprIrOpNeg, TypedExprIrOpI64Add, TypedExprIrOpI64Sub, TypedExprIrOpI64Mul, TypedExprIrOpI64BitAnd, TypedExprIrOpI64BitOr, TypedExprIrOpI64BitXor, TypedExprIrOpI64Lsl, TypedExprIrOpI64Asr, TypedExprIrOpI32Mod, TypedExprIrOpI64Mod, TypedExprIrOpArgLink, TypedExprIrOpCallExpr, TypedExprIrOpEmptySeqInit, TypedExprIrOpNilPtr, TypedExprIrOpFmt, TypedExprIrOpF64Const, TypedExprIrOpStrAdd, TypedExprIrOpSeqLiteral, TypedExprIrOpAddrOf, TypedExprIrOpI32Udiv, TypedExprIrOpI64Udiv, TypedExprIrOpI32Umod, TypedExprIrOpI64Umod, TypedExprIrOpI64Lsr, TypedExprIrOpFuncRef, TypedExprIrOpF64Add, TypedExprIrOpF64Sub, TypedExprIrOpF64Div, TypedExprIrOpClosure

    TypedExprIrStatementKind = enum TypedExprIrStmtUnsupported, TypedExprIrStmtLocalDecl, TypedExprIrStmtLetCall, TypedExprIrStmtIfCall, TypedExprIrStmtCall, TypedExprIrStmtResultIntrinsic, TypedExprIrStmtReturn, TypedExprIrStmtAssign, TypedExprIrStmtIf, TypedExprIrStmtElif, TypedExprIrStmtElse, TypedExprIrStmtFor, TypedExprIrStmtMatch, TypedExprIrStmtCase, TypedExprIrStmtWhile, TypedExprIrStmtDefer, TypedExprIrStmtBreak, TypedExprIrStmtContinue

    TypedExprColdCsgTypeRowKind = enum TypedExprColdCsgTypeAdt, TypedExprColdCsgTypeObject

    TypedExprArgPassKind = enum TypedExprArgPassValue, TypedExprArgPassAddress, TypedExprArgPassCallResultAddress, TypedExprArgPassDeferred

    TypedExprResultPassKind = enum TypedExprResultPassReg, TypedExprResultPassLocalAddress, TypedExprResultPassSret, TypedExprResultPassImportBuffer, TypedExprResultPassDeferred

    TypedExprMaterializeKind = enum TypedExprMaterializeNone, TypedExprMaterializeRegister, TypedExprMaterializeLocalSlot, TypedExprMaterializeCallResultLocal, TypedExprMaterializeDestAddress, TypedExprMaterializeImportBuffer, TypedExprMaterializeDeferred

    TypedExprCopyKind = enum TypedExprCopyNone, TypedExprCopyScalarStore, TypedExprCopyRegionCopy, TypedExprCopyDeferred

    TypedExprImportKind = enum TypedExprImportI32ValueSlot, TypedExprImportI32AddressSlot, TypedExprImportBuiltinValueSlot, TypedExprImportBuiltinAddressSlot, TypedExprImportImportBuffer, TypedExprImportDeferred

    TypedExprFact =
        exprId: str
        sourcePath: str
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        lexicalScopeId: int32
        suiteScopeId: int32
        statementOrdinal: int32
        lexicalOrdinal: int32
        deferOwnerStatementOrdinal: int32
        kind: parser.NormalizedExprKind
        surfaceCallKind: TypedExprSurfaceCallKind
        callResolved: bool
        callReason: TypedExprCallReason
        callQualifier: str
        callCallee: str
        callTarget: str
        callTargetSourcePath: str
        callTargetSignatureLineNumber: int32
        callTargetImportc: bool
        callPrefixStyle: bool
        callArgCount: int32
        callArgsText: str
        valueExprCallNodeIndex: int32
        originParserNodeId: int32
        valueExprArgRootStart: int32
        valueExprArgRootCount: int32
        valueExprRootNodeIndex: int32
        valueExprSpanStart: int32
        valueExprSpanEnd: int32
        valueExprStatementRole: parser.ParserValueExprStatementRole
        typeText: str
        abiClass: TypedExprAbiClass
        valueKind: TypedExprValueKind
        placeKind: TypedExprPlaceKind
        hasSink: bool
        sinkPlaceKind: TypedExprPlaceKind
        loweringMode: TypedExprLoweringMode
        callKind: TypedExprCallKind
        typeCallKind: TypedExprTypeCallKind
        returnKind: TypedExprReturnKind
        returnRoot: bool

    # C5 SoA fact storage: replaces the bare `TypedExprFact[]` seq carrier.
    # The 8 string fields are intern ids. Exact identity/range fields use 26
    # int32 columns; bounded enums and booleans use 15 U8 columns (three
    # booleans share callPrefixStyles), for 41 physical columns in one arena.
    # TypedExprFact remains the row carrier.
    TypedExprFactTable =
        arena: arenamod.Arena
        internPool: langintern.InternPool
        count: int32
        compactGrowCount: int32
        exprIdIds: arenamod.ArenaArrayInt32
        sourcePathIds: arenamod.ArenaArrayInt32
        callQualifierIds: arenamod.ArenaArrayInt32
        callCalleeIds: arenamod.ArenaArrayInt32
        callTargetIds: arenamod.ArenaArrayInt32
        callTargetSourcePathIds: arenamod.ArenaArrayInt32
        callTargetSignatureLineNumbers: arenamod.ArenaArrayInt32
        callArgsTextIds: arenamod.ArenaArrayInt32
        typeTextIds: arenamod.ArenaArrayInt32
        lineNumbers: arenamod.ArenaArrayInt32
        columnNumbers: arenamod.ArenaArrayInt32
        endLineNumbers: arenamod.ArenaArrayInt32
        endColumnNumbers: arenamod.ArenaArrayInt32
        lexicalScopeIds: arenamod.ArenaArrayInt32
        suiteScopeIds: arenamod.ArenaArrayInt32
        statementOrdinals: arenamod.ArenaArrayInt32
        lexicalOrdinals: arenamod.ArenaArrayInt32
        deferOwnerStatementOrdinals: arenamod.ArenaArrayInt32
        callArgCounts: arenamod.ArenaArrayInt32
        kinds: arenamod.ArenaArrayU8
        surfaceCallKinds: arenamod.ArenaArrayU8
        callReasons: arenamod.ArenaArrayU8
        abiClasses: arenamod.ArenaArrayU8
        valueKinds: arenamod.ArenaArrayU8
        placeKinds: arenamod.ArenaArrayU8
        sinkPlaceKinds: arenamod.ArenaArrayU8
        loweringModes: arenamod.ArenaArrayU8
        callKinds: arenamod.ArenaArrayU8
        typeCallKinds: arenamod.ArenaArrayU8
        returnKinds: arenamod.ArenaArrayU8
        callResolveds: arenamod.ArenaArrayU8
        callTargetImportcs: arenamod.ArenaArrayU8
        callPrefixStyles: arenamod.ArenaArrayU8
        valueExprCallNodeIndexes: arenamod.ArenaArrayInt32
        originParserNodeIds: arenamod.ArenaArrayInt32
        valueExprArgRootStarts: arenamod.ArenaArrayInt32
        valueExprArgRootCounts: arenamod.ArenaArrayInt32
        valueExprRootNodeIndexes: arenamod.ArenaArrayInt32
        valueExprSpanStarts: arenamod.ArenaArrayInt32
        valueExprSpanEnds: arenamod.ArenaArrayInt32
        valueExprStatementRoles: arenamod.ArenaArrayU8

    TypedExprFactTableResetProbe =
        arenaCapacityBefore: int32
        arenaCapacityAfter: int32
        arenaStorageReleased: bool
        internReset: langintern.InternPoolResetProbe

    TypedExprLoweringRule =
        exprId: str
        sourcePath: str
        lineNumber: int32
        columnNumber: int32
        surfaceCallKind: TypedExprSurfaceCallKind
        callResolved: bool
        callReason: TypedExprCallReason
        callQualifier: str
        callCallee: str
        callTarget: str
        callTargetSourcePath: str
        callTargetSignatureLineNumber: int32
        callTargetImportc: bool
        callPrefixStyle: bool
        callArgCount: int32
        callArgsText: str
        typeText: str
        abiClass: TypedExprAbiClass
        valueKind: TypedExprValueKind
        placeKind: TypedExprPlaceKind
        loweringMode: TypedExprLoweringMode
        callKind: TypedExprCallKind
        typeCallKind: TypedExprTypeCallKind
        returnKind: TypedExprReturnKind
        returnRoot: bool
        argPassKind: TypedExprArgPassKind
        resultPassKind: TypedExprResultPassKind
        materializeKind: TypedExprMaterializeKind
        copyKind: TypedExprCopyKind
        importKind: TypedExprImportKind

    TypedExprSourceText =
        workspaceRoot: str
        packageRoot: str
        packageId: str
        packageChannel: str
        externalPackageRoots: parser.ParserExternalPackageRoot[]
        sourcePath: str
        text: str
        textLoaded: bool
        snapshotOnly: bool
        # Explicit migration parser admission. This is set by the CSG plan
        # mode and never inferred from source spelling or path.
        migrationSourceSyntax: bool

    TypedExprSourceRangeIndex =
        sourcePaths: str[]
        starts: int32[]
        ends: int32[]
        lookup: parser.ParserSourcePathIndexLookup

    # Bounded TypedIR input owned by typed_expr. It intentionally mirrors only
    # scalar/range facts and has no dependency on FunctionSourceSliceIndex.
    # exprPhysicalStart/factPhysicalStart are absolute indexes in the physically
    # concatenated input carriers. They are deliberately not source-local slice
    # starts. scopeStart/statementStart remain source-wide semantic identities;
    # projection converts those identities to function-local dense ids.
    TypedExprFunctionSourceRangeSet =
        sourcePaths: str[]
        functionNames: str[]
        functionStartLines: int32[]
        functionEndLines: int32[]
        sourceContextIndexes: int32[]
        functionScopeIndexes: int32[]
        sourceScopeRootIndexes: int32[]
        exprPhysicalStarts: int32[]
        exprCounts: int32[]
        factPhysicalStarts: int32[]
        factCounts: int32[]
        scopeStarts: int32[]
        scopeCounts: int32[]
        statementStarts: int32[]
        statementCounts: int32[]
        expectedRowCount: int32
        sealed: bool

    TypedExprFunctionSourceRangeBuildReport =
        rowCount: int32
        preflightRowVisitCount: int64
        preflightRangeMetadataVisitCount: int64
        preflightExprVisitCount: int64
        preflightFactVisitCount: int64
        preflightScopeVisitCount: int64
        preflightStatementVisitCount: int64
        preflightDeferContractExprVisitCount: int64
        commitRowVisitCount: int64
        commitExprVisitCount: int64
        commitFactVisitCount: int64
        commitScopeVisitCount: int64
        commitStatementVisitCount: int64
        bindingIndexBuildVisitCount: int64
        bindingIndexFillVisitCount: int64
        sourceBindingIndexBuildCount: int32
        contextIndexBuildVisitCount: int64
        contextIndexLookupCount: int64
        sealedMetadataContextCountExpected: int32
        sealedMetadataContextCountObserved: int32
        sealedMetadataRowsExpected: int64
        sealedMetadataRowsVisited: int64
        commitBindingVisitCount: int64
        inferredBindingCandidateVisitCount: int64
        inferredBindingDuplicateVisitCount: int64
        inferredBindingDeltaVisitCount: int64
        activeRangeCount: int32
        activeRangePeak: int32
        fullSourceScopeRescanCount: int32
        fullSourceLineRescanCount: int32
        functionLineVisitCount: int64
        perRowFullSourceBindingRescanCount: int32
        exprScratchPeakCapacity: int32
        scopeScratchPeakCapacity: int32
        factScratchPeakRowCapacity: int32
        childCountScratchPeakCapacity: int32
        normalizedScopeIndexScratchPeakCapacity: int32
        sealedRoundViewUsed: bool
        sealedRoundContextCount: int32
        sealedRoundDependencyCount: int32
        functionCountBefore: int32
        functionCountAfter: int32
        statementCountBefore: int32
        statementCountAfter: int32
        nodeCountBefore: int32
        nodeCountAfter: int32

    typedExprFunctionBindingPlan =
        rowStarts: int32[]
        rowCounts: int32[]
        contextIndexes: int32[]
        bindingIndexes: int32[]
        identityLookup: parser.ParserSourcePathIndexLookup
        stableBindingCount: int32

    TypedExprNormalizedScopeIndex =
        sourcePaths: str[]
        starts: int32[]
        counts: int32[]
        lookup: parser.ParserSourcePathIndexLookup

    TypedExprFunctionOrdinalMap =
        keys: int32[]
        localOrdinals: int32[]
        count: int32
        probeVisitCount: int32

    TypedExprDensePairIndex =
        groupStarts: int32[]
        seen: bool[]
        count: int32
        visitCount: int32

    TypedExprSourceIdentityIndex =
        roots: str[]
        rootOwnerKeys: str[]
        rootKinds: int32[]
        rootLookup: parser.ParserSourcePathIndexLookup
        workspaceRoot: str
        currentPackageRoot: str
        currentPackageId: str
        currentPackageChannel: str
        externalOwnerCount: int32
        sourcePhysicalPaths: str[]
        sourceOwnerKeys: str[]
        lookup: parser.ParserSourcePathIndexLookup
        sealedClosurePaths: str[]

    TypedExprBuildIndexLookupState = enum TypedExprBuildIndexMissing, TypedExprBuildIndexUnique, TypedExprBuildIndexAmbiguous

    TypedExprStructuredMatchState = enum TypedExprStructuredMismatch, TypedExprStructuredMatch, TypedExprStructuredDeferred

    TypedExprCallDeclarationKind = enum TypedExprCallDeclarationFunction, TypedExprCallDeclarationImportc

    # FuncRef target rows are exact only inside the sealed CallDeclaration
    # arena.  None is the absent sentinel for every non-FuncRef node.
    TypedExprFuncRefTargetDomain = enum TypedExprFuncRefTargetDomainNone, TypedExprFuncRefTargetDomainCallDeclaration

    TypedExprCallDeclarationKindSet = enum TypedExprCallDeclarationFunctionOnly, TypedExprCallDeclarationImportcOnly, TypedExprCallDeclarationFunctionOrImportc

    # One explicit owner per typed-expression build. Keys stay in structured
    # columns so register/query never allocate a joined temporary string.
    TypedExprBuildIndex = ref object
        # Frozen metadata mode owns no semantic text. These integer columns are
        # row keys into canonicalProjection's single intern pool; the ordinary
        # string columns below are empty after compaction.
        canonicalProjection: typedExprFrozenMetadataProjection
        compactCanonical: bool
        entryKindIds: langintern.InternId[]
        entrySourcePathIds: langintern.InternId[]
        entryNameIds: langintern.InternId[]
        entryDetailIds: langintern.InternId[]
        entryOriginIds: langintern.InternId[]
        entryFingerprintIds: langintern.InternId[]
        visibilityKindIds: langintern.InternId[]
        visibilitySourcePathIds: langintern.InternId[]
        visibilityNameIds: langintern.InternId[]
        visibilityDetailIds: langintern.InternId[]
        visibilityFingerprintIds: langintern.InternId[]
        importOwnerSourcePathIds: langintern.InternId[]
        contentCacheKindIds: langintern.InternId[]
        contentCacheSourcePathIds: langintern.InternId[]
        contentCacheNameIds: langintern.InternId[]
        contentCacheValueIds: langintern.InternId[]
        callDeclarationSourcePathIds: langintern.InternId[]
        callDeclarationNameIds: langintern.InternId[]
        callDeclarationGenericNameIds: langintern.InternId[]
        callDeclarationParamTypeIds: langintern.InternId[]
        callDeclarationReturnTypeIds: langintern.InternId[]
        callDeclarationTargetSymbolIds: langintern.InternId[]
        contextSourcePathIds: langintern.InternId[]
        contextFieldOwnerSourcePathIds: langintern.InternId[]
        contextFieldOwnerTypeIds: langintern.InternId[]
        # Derived IR indexes use these optional ids to borrow canonical text.
        # A negative id means the corresponding ordinary string owns IR-only
        # text; compact canonical indexes do not populate these IR domains.
        fieldOwnerSourcePathIds: langintern.InternId[]
        fieldOwnerTypeIds: langintern.InternId[]
        layoutSourcePathIds: langintern.InternId[]
        layoutTypeNameIds: langintern.InternId[]
        entryBucketHeads: int32[]
        entryNext: int32[]
        entryHashes: int32[]
        entryKinds: str[]
        entrySourcePaths: str[]
        entryNames: str[]
        entryDetails: str[]
        entryStates: TypedExprBuildIndexLookupState[]
        entryValueIndexes: int32[]
        entryOrigins: str[]
        # Legacy name: these are complete semantic payload strings, not hashes.
        entryFingerprints: str[]
        # Reuse validation marks exact structured entries. Hashes only select a
        # bucket; complete keys and values remain the equality authority.
        entryValidationMarks: int32[]
        # Declaration rows are registered once. Import visibility intersects
        # these name buckets with direct import edges at query time, avoiding
        # the old import-edge x target-metadata expansion.
        visibilityBucketHeads: int32[]
        visibilityNext: int32[]
        visibilityHashes: int32[]
        visibilityKinds: str[]
        visibilitySourcePaths: str[]
        visibilityNames: str[]
        visibilityDetails: str[]
        visibilityValueIndexes: int32[]
        visibilityFingerprints: str[]
        # Exact owner -> import-target adjacency. Target nodes reference the
        # canonical ctx_import_target entry, so target strings are not copied.
        importOwnerBucketHeads: int32[]
        importOwnerNext: int32[]
        importOwnerHashes: int32[]
        importOwnerSourcePaths: str[]
        importOwnerTargetHeads: int32[]
        importTargetNext: int32[]
        importTargetEntryIndexes: int32[]
        # Exact owner-scoped memo for imported visibility. Hashes select only a
        # bucket; all four key columns are compared before a cached state/value
        # is accepted.
        visibilityQueryBucketHeads: int32[]
        visibilityQueryNext: int32[]
        visibilityQueryHashes: int32[]
        visibilityQueryOwnerSourcePaths: str[]
        visibilityQueryKinds: str[]
        visibilityQueryNames: str[]
        visibilityQueryDetails: str[]
        visibilityQueryStates: TypedExprBuildIndexLookupState[]
        visibilityQueryValueIndexes: int32[]
        visibilityQueryFingerprints: str[]
        # Function-header scan cache is valid only while TypedIR is being built.
        # Module consts remain in the metadata index because primary layout
        # resolution still consumes symbolic fixed-array lengths.
        contentCacheBucketHeads: int32[]
        contentCacheNext: int32[]
        contentCacheHashes: int32[]
        contentCacheKinds: str[]
        contentCacheSourcePaths: str[]
        contentCacheNames: str[]
        contentCacheValues: str[]
        # Function/importc declarations use a structured key. Rows retain
        # owner/name/arity and a range into the flat parameter-type column;
        # sortedRows is ordered by owner/name/arity/declaration-kind/parameter
        # types. Return type and import target are payload, never part of a
        # joined text key.
        callDeclarationSortedRows: int32[]
        callDeclarationSourcePaths: str[]
        callDeclarationNames: str[]
        callDeclarationArities: int32[]
        callDeclarationGenericStarts: int32[]
        callDeclarationGenericCounts: int32[]
        callDeclarationGenericNames: str[]
        callDeclarationParamStarts: int32[]
        callDeclarationParamCounts: int32[]
        callDeclarationParamTypes: str[]
        callDeclarationReturnTypes: str[]
        callDeclarationTargetSymbols: str[]
        callDeclarationSignatureLineNumbers: int32[]
        callDeclarationKinds: TypedExprCallDeclarationKind[]
        callDeclarationResultExprClasses: TypedExprExprClass[]
        # Exact declaration provenance. Source indexes address the frozen
        # parser/metadata source domain; declaration ordinals address that
        # source's declaration domain. Function rows address the executable
        # parser Function subset directly; importc carries -1.
        callDeclarationProducerSourceIndexes: int32[]
        callDeclarationProducerDeclarationOrdinals: int32[]
        callDeclarationProducerFunctionRows: int32[]
        # Structured linear consume-and-reinitialize effect.  Parser rows and
        # parameter ordinals are frozen with the declaration; exact TypeIds
        # and the effect CID are bound once from the parser forest plus the
        # canonical TypeArena.  No callee spelling or parameter name is an
        # identity input.
        callDeclarationManualConsumePresents: bool[]
        callDeclarationManualConsumeFunctionDeclarationRows: int32[]
        callDeclarationManualConsumeTargetParameterOrdinals: int32[]
        callDeclarationManualConsumeSourceParameterOrdinals: int32[]
        callDeclarationManualConsumeTargetParameterDeclarationRows: int32[]
        callDeclarationManualConsumeSourceParameterDeclarationRows: int32[]
        callDeclarationManualConsumeTargetTypeIds: int32[]
        callDeclarationManualConsumeSourceTypeIds: int32[]
        callDeclarationManualConsumeEffectCids: layout.FixedBytes32[]
        callDeclarationManualConsumeTypeArenaBound: bool
        callDeclarationSealed: bool
        contextSourcePaths: str[]
        # Eight counts per context: import, declared, ref, alias, enum, field,
        # call-declaration rows, call-declaration parameter rows. The rows
        # themselves already live in exact structured entry columns.
        contextMetadataDomainCounts: int32[]
        contextFieldOwnerBucketHeads: int32[]
        contextFieldOwnerNext: int32[]
        contextFieldOwnerHashes: int32[]
        contextFieldOwnerSourcePaths: str[]
        contextFieldOwnerTypes: str[]
        contextFieldOwnerHeads: int32[]
        contextFieldOwnerTails: int32[]
        contextFieldNodeNext: int32[]
        contextFieldNodeContextIndexes: int32[]
        contextFieldNodeRowIndexes: int32[]
        contextFieldNodeDeclaredOffsetBytes: int32[]
        contextFieldNodeDeclaredSizeBytes: int32[]
        contextFieldNodeDeclaredAlignBytes: int32[]
        contextFieldNodeOffsetBytes: int32[]
        contextFieldNodeSizeBytes: int32[]
        contextFieldNodeAlignBytes: int32[]
        contextFieldNodeLayoutReady: bool[]
        fieldOwnerBucketHeads: int32[]
        fieldOwnerNext: int32[]
        fieldOwnerHashes: int32[]
        fieldOwnerSourcePaths: str[]
        fieldOwnerTypes: str[]
        fieldOwnerHeads: int32[]
        fieldOwnerTails: int32[]
        fieldRowNext: int32[]
        layoutBucketHeads: int32[]
        layoutNext: int32[]
        layoutHashes: int32[]
        layoutSourcePaths: str[]
        layoutTypeNames: str[]
        layoutStates: int32[]
        layoutSizeBytes: int32[]
        layoutAlignBytes: int32[]
        buildCount: int32
        reuseCount: int32
        contextCount: int32
        metadataDeclarationCount: int32
        visibilityEdgeCount: int32
        registerCount: int32
        registerProbeCount: int32
        rehashEntryVisitCount: int32
        queryLookupCount: int32
        queryProbeCount: int32
        queryMetadataScanCount: int32
        # Once set, this index is a read-only metadata query structure for the
        # rest of its lifetime.  Fixed-point IR rows are written to a distinct
        # derived index, so no public alias can mutate the sealed authority.
        permanentlySealed: bool
        frozenReadOnlyQueries: bool
        # Exact post-close state: canonical metadata domains are released,
        # while the derived index retains only the source identities and rows
        # required by backend module-const resolution.
        canonicalMetadataTransferred: bool
        validationEpoch: int32
        buildGeneration: int32
        releaseCount: int32
        released: bool
        contentCacheReleased: bool
        # [p1phase1] Deferred-core state: set by the streaming deferred-core
        # builder, cleared by the deferred finish.  A premature finish or a
        # post-finish deferred append must panic instead of silently
        # reordering the metadata registration.
        coreMetadataDeferredPending: bool
        hardError: str
        # [D-B2a] Streaming-core canonical intern store for the low-cardinality
        # identity columns (kinds, source paths, origins). Ordinary-mode slots
        # in those columns hold shared handles into this pool instead of a
        # per-row owned clone, so duplicate identity payloads keep exactly one
        # owned instance; high-cardinality payload columns (names, details,
        # fingerprints) stay per-row owned clones because interning them adds
        # per-distinct pool overhead without dedup gain (v1 measured). The
        # pool is created lazily on the first interned append, is owned by the
        # index and released with it, which keeps every shared handle's
        # lifetime inside the pool's (the documented LookupInternShared store
        # idiom). Compact-canonical mode interns through canonicalProjection
        # instead and never touches this pool.
        internPool: langintern.InternPool

    TypedExprBuildIndexLiveByteReport =
        objectBytes: int64
        bucketBytes: int64
        entryBytes: int64
        keyBytes: int64
        rootBytes: int64
        cacheBytes: int64
        contentCacheBytes: int64
        internPoolBytes: int64
        totalBytes: int64

    TypedExprFunctionFilterIndex =
        active: bool
        sourceIdentity: TypedExprSourceIdentityIndex
        selectedSources: bool[]
        functions: parser.ParserSourcePathIndexLookup

    TypedExprSnapshotContextIndex =
        sources: parser.ParserSourcePathIndexLookup
        functions: parser.ParserSourcePathIndexLookup
        signatures: parser.ParserSourcePathIndexLookup
        importcs: parser.ParserSourcePathIndexLookup

    typedExprFrozenScopeSoA =
        contextStarts: int32[]
        contextCounts: int32[]
        nameIds: langintern.InternId[]
        producerDeclarationOrdinals: int32[]
        startLines: int32[]
        endLines: int32[]
        returnTypeIds: langintern.InternId[]
        borrowResults: bool[]
        borrowsArguments: bool[]
        manualConsumePresents: bool[]
        manualConsumeFunctionDeclarationRows: int32[]
        manualConsumeTargetParameterOrdinals: int32[]
        manualConsumeSourceParameterOrdinals: int32[]
        manualConsumeTargetParameterDeclarationRows: int32[]
        manualConsumeSourceParameterDeclarationRows: int32[]
        manualConsumeTargetTypeIds: int32[]
        manualConsumeSourceTypeIds: int32[]
        manualConsumeEffectCids: layout.FixedBytes32[]
        genericStarts: int32[]
        genericCounts: int32[]
        genericNameIds: langintern.InternId[]
        paramStarts: int32[]
        paramCounts: int32[]
        paramTypeIds: langintern.InternId[]

    typedExprFrozenImportcSoA =
        contextStarts: int32[]
        contextCounts: int32[]
        nameIds: langintern.InternId[]
        producerDeclarationOrdinals: int32[]
        targetIds: langintern.InternId[]
        returnTypeIds: langintern.InternId[]
        paramStarts: int32[]
        paramCounts: int32[]
        paramTypeIds: langintern.InternId[]
        ffiMapPtrArgs: int32[]
        ffiMapLenArgs: int32[]
        ffiOutPtrArgIds: langintern.InternId[]
        abiInternals: bool[]
        ffiOwnedResultPresents: bool[]
        ffiOwnedResultFreeIds: langintern.InternId[]

    # Single canonical post-seal metadata store. Every string is represented by
    # an intern id and every semantic domain is range-addressed. The compact
    # BuildIndex owns only bucket/row ids that borrow this store; round views hold
    # only context ids and borrowed ranges, never a second semantic copy.
    typedExprFrozenMetadataProjection = ref object
        internPool: langintern.InternPool
        contextBucketHeads: int32[]
        contextNext: int32[]
        contextHashes: int32[]
        rawSourcePathIds: langintern.InternId[]
        normalizedSourcePathIds: langintern.InternId[]
        packageOwnerIds: langintern.InternId[]
        snapshotOnly: bool[]
        contextBuildEntryIndexes: int32[]
        contextMetadataRowCounts: int32[]
        sourceIndexProducerFullTraversalCounts: int32[]
        # One immutable random-access index over each source snapshot.  The
        # flat rows address the caller-owned raw bytes; only lines changed by
        # multiline-string normalization own a sparse override string.
        sourceByteLengths: int32[]
        sourceLineStarts: int32[]
        sourceLineCounts: int32[]
        sourceLineByteStarts: int32[]
        sourceLineByteLengths: int32[]
        sourceLineOverrideIndexes: int32[]
        sourceLineOverrideTexts: str[]
        globalBindingStarts: int32[]
        globalBindingCounts: int32[]
        globalBindingLineNumbers: int32[]
        globalBindingNameIds: langintern.InternId[]
        globalBindingTypeIds: langintern.InternId[]
        globalBindingProducerSourceIndexes: int32[]
        globalBindingDeclarationSourceLocalRows: int32[]
        globalBindingMutableFlags: bool[]
        globalBindingInitValueIds: langintern.InternId[]
        # Exact immutable (contextIndex, name) lookup. Rows remain in the
        # canonical context ranges above; these three int32 columns are the
        # only derived identity and never copy semantic payloads.
        globalBindingBucketHeads: int32[]
        globalBindingNext: int32[]
        globalBindingHashes: int32[]
        scopes: typedExprFrozenScopeSoA
        signatures: typedExprFrozenScopeSoA
        scopeBucketHeads: int32[]
        scopeNext: int32[]
        scopeHashes: int32[]
        signatureBucketHeads: int32[]
        signatureNext: int32[]
        signatureHashes: int32[]
        snapshotFunctionBucketHeads: int32[]
        snapshotFunctionNext: int32[]
        snapshotFunctionHashes: int32[]
        snapshotImportcBucketHeads: int32[]
        snapshotImportcNext: int32[]
        snapshotImportcHashes: int32[]
        snapshotImportcContextIndexes: int32[]
        snapshotImportcNameIds: langintern.InternId[]
        snapshotImportcRowIndexes: int32[]
        importcs: typedExprFrozenImportcSoA
        importStarts: int32[]
        importCounts: int32[]
        importQualifierIds: langintern.InternId[]
        importTargetSourcePathIds: langintern.InternId[]
        importAllowsUnqualifiedCalls: bool[]
        importBuildEntryIndexes: int32[]
        importTargetBuildEntryIndexes: int32[]
        declaredStarts: int32[]
        declaredCounts: int32[]
        declaredTypeIds: langintern.InternId[]
        declaredTypeProducerSourceIndexes: int32[]
        declaredTypeDeclarationSourceLocalRows: int32[]
        declaredTypeBuiltinKinds: int32[]
        declaredBuildEntryIndexes: int32[]
        refStarts: int32[]
        refCounts: int32[]
        refTypeIds: langintern.InternId[]
        refBuildEntryIndexes: int32[]
        aliasStarts: int32[]
        aliasCounts: int32[]
        aliasNameIds: langintern.InternId[]
        aliasTargetTypeIds: langintern.InternId[]
        aliasBuildEntryIndexes: int32[]
        fieldStarts: int32[]
        fieldCounts: int32[]
        fieldOwnerTypeIds: langintern.InternId[]
        fieldNameIds: langintern.InternId[]
        fieldTypeIds: langintern.InternId[]
        fieldOffsetBytes: int32[]
        fieldSizeBytes: int32[]
        fieldAlignBytes: int32[]
        fieldProducerSourceIndexes: int32[]
        fieldOwnerDeclarationSourceLocalRows: int32[]
        fieldDeclarationSourceLocalRows: int32[]
        fieldOrdinals: int32[]
        fieldBuiltinKinds: int32[]
        fieldBuildEntryIndexes: int32[]
        fieldBuildNodeIndexes: int32[]
        enumStarts: int32[]
        enumCounts: int32[]
        enumNameIds: langintern.InternId[]
        enumTypeIds: langintern.InternId[]
        enumOrdinals: int32[]
        enumNameBuildEntryIndexes: int32[]
        enumTypeBuildEntryIndexes: int32[]
        moduleConstStarts: int32[]
        moduleConstCounts: int32[]
        moduleConstNameIds: langintern.InternId[]
        moduleConstLiteralIds: langintern.InternId[]
        moduleConstBuildEntryIndexes: int32[]
        joinedLookupKeyBytes: int64
        released: bool

    typedExprFrozenProjPass2Acc = ref object
        claimed: bool[]
        importcsContextStarts: int32[]
        importcsContextCounts: int32[]
        importcsNameIds: langintern.InternId[]
        importcsProducerDeclarationOrdinals: int32[]
        importcsTargetIds: langintern.InternId[]
        importcsReturnTypeIds: langintern.InternId[]
        importcsParamStarts: int32[]
