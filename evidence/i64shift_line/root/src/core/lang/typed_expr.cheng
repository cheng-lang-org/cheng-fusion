fn TypedExprBuildIndexEmptyBuckets(itemCount: int32): int32[] =
    var out: int32[]
    let bucketCount = TypedExprBuildIndexBucketCount(itemCount)
    for i in 0..<bucketCount:
        add(out, -1)
    return out

# [D-B2b] Same table as TypedExprBuildIndexEmptyBuckets but built with one
# exact setLen allocation instead of append-doubling, so the pass-1 reserve
# window pays neither growth transients nor retained slack for the bucket
# directory itself.
fn typedExprBuildIndexExactBuckets(itemCount: int32): int32[] =
    var out: int32[]
    let bucketCount = TypedExprBuildIndexBucketCount(itemCount)
    seqs.SetLen(out, bucketCount)
    for i in 0..<bucketCount:
        out[i] = -1
    return out

fn TypedExprBuildIndexBucket(hashValue: int32, bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    return hashValue & (bucketCount - 1)

fn TypedExprBuildIndexNew(minCap: int32): TypedExprBuildIndex =
    if minCap < 0:
        panic("typed expr: negative build-index minimum capacity")
    var out: TypedExprBuildIndex = new(TypedExprBuildIndex)
    let entryCap = typedExprCheckedAddInt32(minCap, 16,
                                            "build_index_entry_capacity")
    let ownerCap = typedExprCheckedAddInt32(minCap, 8,
                                            "build_index_owner_capacity")
    out.entryBucketHeads = TypedExprBuildIndexEmptyBuckets(entryCap)
    out.visibilityBucketHeads = TypedExprBuildIndexEmptyBuckets(entryCap)
    out.importOwnerBucketHeads = TypedExprBuildIndexEmptyBuckets(entryCap)
    out.visibilityQueryBucketHeads = TypedExprBuildIndexEmptyBuckets(16)
    out.contextFieldOwnerBucketHeads = TypedExprBuildIndexEmptyBuckets(ownerCap)
    out.fieldOwnerBucketHeads = TypedExprBuildIndexEmptyBuckets(ownerCap)
    out.layoutBucketHeads = TypedExprBuildIndexEmptyBuckets(ownerCap)
    out.buildCount = 1
    return out

@borrows
fn typedExprBuildIndexRequireMutable(index: TypedExprBuildIndex,
                                     operation: str) =
    if index == nil:
        panic(Fmt"typed expr: build index unavailable operation={operation} state=nil")
    if index.released:
        panic(Fmt"typed expr: build index unavailable operation={operation} state=released build_count={index.buildCount} generation={index.buildGeneration} sealed={index.callDeclarationSealed} permanently_sealed={index.permanentlySealed}")
    if index.permanentlySealed:
        panic(Fmt"typed expr: sealed build index mutation forbidden operation={operation}")

@borrows
fn typedExprFrozenSealDiagnostic(code: str, detail: str): str =
    return Fmt" typed expr: frozen metadata seal code={code} detail={detail}"

@borrows
fn TypedExprCallDeclarationTextCompare(left: str, right: str): int32 =
    let commonLen = left.len < right.len ? left.len : right.len
    for i in 0..<commonLen:
        let leftByte = int32(left[i])
        let rightByte = int32(right[i])
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn typedExprCallDeclarationVarargsElementType(typeRaw: str,
                                               elementTypeOut: var str): bool =
    elementTypeOut = ""
    let typeText = TypedExprNormalizeTypeText(parser.ParserOwnedText(typeRaw))
    if typeText.len <= 9 ||
       !parser.ParserStartsWith(typeText, "varargs[") ||
       TypedExprFindMatchingBracket(typeText, 7) != typeText.len - 1:
        return false
    elementTypeOut = TypedExprNormalizeTypeText(
        chengpath.TextSlice(typeText, 8, typeText.len - 9))
    return elementTypeOut != "" &&
           elementTypeOut != "varargs" &&
           !parser.ParserStartsWith(elementTypeOut, "varargs[")

@borrows
fn typedExprCallDeclarationRequireValidVarargsParam(
        paramType: str,
        paramIndex: int32,
        paramCount: int32,
        declarationKind: TypedExprCallDeclarationKind,
        sourcePath: str,
        name: str,
        variadicParamIndex: var int32) =
    let runtimeParamType = TypedExprCallRuntimeType(
        parser.ParserOwnedText(paramType))
    if TypedExprCallArgumentHasExplicitBorrow(paramType) &&
       (runtimeParamType == "varargs" ||
        parser.ParserStartsWith(runtimeParamType, "varargs[")):
        panic(Fmt"typed expr: variadic parameter cannot be mutable source={sourcePath} name={name} index={paramIndex}")
    var elementType = ""
    if typedExprCallDeclarationVarargsElementType(runtimeParamType, elementType):
        if declarationKind != TypedExprCallDeclarationImportc:
            panic(Fmt"typed expr: variadic marker requires importc declaration source={sourcePath} name={name} index={paramIndex}")
        if variadicParamIndex >= 0:
            panic(Fmt"typed expr: duplicate variadic parameter source={sourcePath} name={name} index={paramIndex}")
        if paramIndex != paramCount - 1:
            panic(Fmt"typed expr: non-final variadic parameter source={sourcePath} name={name} index={paramIndex}")
        variadicParamIndex = paramIndex
        return
    if runtimeParamType == "varargs" ||
       parser.ParserStartsWith(runtimeParamType, "varargs["):
        panic(Fmt"typed expr: malformed variadic parameter source={sourcePath} name={name} index={paramIndex}")

@borrows
fn typedExprBuildIndexAddCallDeclarationWithProducer(
                                           index: var TypedExprBuildIndex,
                                           sourcePathRaw: str,
                                           nameRaw: str,
                                           genericNames: str[],
                                           paramTypes: str[],
                                           returnTypeRaw: str,
                                           declarationKind: TypedExprCallDeclarationKind,
                                           targetSymbolRaw: str,
                                           signatureLineNumber: int32,
                                           resultExprClass: TypedExprExprClass,
                                           producerSourceIndex: int32,
                                           producerDeclarationOrdinal: int32,
                                           producerFunctionRow: int32) =
    typedExprBuildIndexRequireMutable(index, "call_declaration_register")
    if index.callDeclarationSealed:
        panic("typed expr: call declaration register after seal")
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let trimmedName = chengpath.PathTrim(nameRaw)
    var name = parser.ParserIdentPrefix(trimmedName)
    if name == "":
        name = trimmedName
    if sourcePath == "" || name == "":
        panic("typed expr: call declaration identity missing")
    if (declarationKind == TypedExprCallDeclarationFunction &&
        signatureLineNumber <= 0) ||
       (declarationKind == TypedExprCallDeclarationImportc &&
        signatureLineNumber != 0):
        panic(Fmt"typed expr: call declaration signature identity invalid source={sourcePath} name={name} line={signatureLineNumber}")
    if declarationKind == TypedExprCallDeclarationFunction &&
       resultExprClass != TypedExprExprOwned &&
       resultExprClass != TypedExprExprBorrowed:
        panic(Fmt"typed expr: Cheng call declaration result ownership missing source={sourcePath} name={name}")
    if declarationKind == TypedExprCallDeclarationImportc &&
       resultExprClass != TypedExprExprUnknown &&
       resultExprClass != TypedExprExprOwned:
        panic(Fmt"typed expr: importc call declaration result ownership invalid source={sourcePath} name={name}")
    if producerSourceIndex < -1 || producerFunctionRow < -1 ||
       producerDeclarationOrdinal < -1 ||
       (producerSourceIndex < 0 && producerFunctionRow >= 0) ||
       (producerSourceIndex < 0 && producerDeclarationOrdinal >= 0) ||
       (producerSourceIndex >= 0 && producerDeclarationOrdinal < 0) ||
       (declarationKind == TypedExprCallDeclarationFunction &&
        producerSourceIndex >= 0 && producerFunctionRow < 0) ||
       (declarationKind == TypedExprCallDeclarationImportc &&
        producerFunctionRow != -1):
        panic(Fmt"typed expr: call declaration producer coordinate invalid source={sourcePath} name={name} producer_source={producerSourceIndex} producer_declaration_ordinal={producerDeclarationOrdinal} producer_function_row={producerFunctionRow}")
    let genericStart = index.callDeclarationGenericNames.len
    for i in 0..<genericNames.len:
        let genericName = chengpath.PathTrim(share(genericNames[i]))
        if genericName == "" || parser.ParserIdentPrefix(genericName) != genericName:
            panic(Fmt"typed expr: call declaration generic name invalid source={sourcePath} name={name} index={i}")
        for priorIndex in 0..<i:
            if chengpath.PathTrim(share(genericNames[priorIndex])) == genericName:
                panic(Fmt"typed expr: call declaration generic name duplicate source={sourcePath} name={name} generic={genericName}")
        add(index.callDeclarationGenericNames, parser.ParserOwnedText(genericName))
    let paramStart = index.callDeclarationParamTypes.len
    var variadicParamIndex: int32 = -1
    for i in 0..<paramTypes.len:
        let paramType = TypedExprNormalizeTypeText(share(paramTypes[i]))
        if paramType == "":
            panic(Fmt"typed expr: call declaration parameter type missing source={sourcePath} name={name} index={i}")
        typedExprCallDeclarationRequireValidVarargsParam(paramType,
                                                         i,
                                                         paramTypes.len,
                                                         declarationKind,
                                                         sourcePath,
                                                         name,
                                                         variadicParamIndex)
        add(index.callDeclarationParamTypes, parser.ParserOwnedText(paramType))
    var returnType = TypedExprNormalizeTypeText(returnTypeRaw)
    if returnType == "":
        returnType = "void"
    returnType = parser.ParserOwnedText(returnType)
    var targetSymbol = chengpath.PathTrim(targetSymbolRaw)
    if targetSymbol == "":
        targetSymbol = share(name)
    targetSymbol = parser.ParserOwnedText(targetSymbol)
    let rowIndex = index.callDeclarationSourcePaths.len
    add(index.callDeclarationSourcePaths, parser.ParserOwnedText(sourcePath))
    add(index.callDeclarationNames, parser.ParserOwnedText(name))
    add(index.callDeclarationArities, paramTypes.len)
    add(index.callDeclarationGenericStarts, genericStart)
    add(index.callDeclarationGenericCounts, genericNames.len)
    add(index.callDeclarationParamStarts, paramStart)
    add(index.callDeclarationParamCounts, paramTypes.len)
    add(index.callDeclarationReturnTypes, returnType)
    add(index.callDeclarationTargetSymbols, targetSymbol)
    add(index.callDeclarationSignatureLineNumbers, signatureLineNumber)
    add(index.callDeclarationKinds, declarationKind)
    add(index.callDeclarationResultExprClasses, resultExprClass)
    add(index.callDeclarationProducerSourceIndexes, producerSourceIndex)
    add(index.callDeclarationProducerDeclarationOrdinals,
        producerDeclarationOrdinal)
    add(index.callDeclarationProducerFunctionRows,
        producerFunctionRow)
    add(index.callDeclarationManualConsumePresents, false)
    add(index.callDeclarationManualConsumeFunctionDeclarationRows,
        -1)
    add(index.callDeclarationManualConsumeTargetParameterOrdinals, -1)
    add(index.callDeclarationManualConsumeSourceParameterOrdinals, -1)
    add(index.callDeclarationManualConsumeTargetParameterDeclarationRows,
        -1)
    add(index.callDeclarationManualConsumeSourceParameterDeclarationRows,
        -1)
    add(index.callDeclarationManualConsumeTargetTypeIds, -1)
    add(index.callDeclarationManualConsumeSourceTypeIds, -1)
    add(index.callDeclarationManualConsumeEffectCids, layout.FixedBytes32())
    if declarationKind == TypedExprCallDeclarationFunction:
        TypedExprBuildIndexRegister(index,
                                    "ctx_function_decl_name_source",
                                    sourcePath,
                                    name,
                                    "",
                                    rowIndex,
                                    sourcePath,
                                    name,
                                    false)

fn TypedExprBuildIndexAddCallDeclaration(index: var TypedExprBuildIndex,
                                           sourcePathRaw: str,
                                           nameRaw: str,
                                           genericNames: str[],
                                           paramTypes: str[],
                                           returnTypeRaw: str,
                                           declarationKind: TypedExprCallDeclarationKind,
                                           targetSymbolRaw: str,
                                           signatureLineNumber: int32,
                                           resultExprClass: TypedExprExprClass) =
    typedExprBuildIndexAddCallDeclarationWithProducer(
        index, sourcePathRaw, nameRaw, genericNames, paramTypes,
        returnTypeRaw, declarationKind, targetSymbolRaw,
        signatureLineNumber, resultExprClass, -1, -1, -1)

@borrows
fn TypedExprScopeCallDeclarationInto(ctx: var TypedExprSourceContext,
                                      scope: TypedExprFunctionScope,
                                      genericNames: var str[],
                                      paramTypes: var str[],
                                      returnType: var str) =
    let header = TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine)
    genericNames = []
    paramTypes = []
    if scope.paramTypesComplete:
        paramTypes = TypedExprSplitParamTypeJoin(scope.paramTypeJoin)
    elif header != "":
        var params: TypedExprParam[]
        TypedExprFunctionParamsInto(share(header), params)
        for i in 0..<params.len:
            add(paramTypes, TypedExprCallParamType(params[i]))
    else:
        panic(Fmt"typed expr: function declaration signature missing source={ctx.sourcePath} name={scope.name} line={scope.startLine}")
    if header != "":
        var headerParams: TypedExprParam[]
        TypedExprFunctionParamsInto(share(header), headerParams)
        if headerParams.len != paramTypes.len:
            panic(Fmt"typed expr: function declaration signature arity drift source={ctx.sourcePath} name={scope.name}")
        for i in 0..<headerParams.len:
            if TypedExprCallParamType(headerParams[i]) !=
               TypedExprNormalizeTypeText(share(paramTypes[i])):
                panic(Fmt"typed expr: function declaration signature type drift source={ctx.sourcePath} name={scope.name} index={i}")
    if scope.borrowsArguments:
        for paramIndex in 0..<paramTypes.len:
            if !TypedExprCallArgumentHasExplicitBorrow(paramTypes[paramIndex]):
                paramTypes[paramIndex] = TypedExprCallBorrowModeType(
                    share(paramTypes[paramIndex]))
    returnType = scope.returnType
    if returnType == "":
        returnType = TypedExprParseFunctionReturnType(share(header))
    returnType = TypedExprNormalizeTypeText(strings.CloneStr(returnType))
    if returnType == "":
        returnType = "void"
    if scope.genericNamesComplete:
        genericNames = TypedExprSplitGenericNameJoin(scope.genericNameJoin)
    else:
        var genericParamTypes: str[]
        for paramIndex in 0..<paramTypes.len:
            add(genericParamTypes,
                TypedExprCallRuntimeType(share(paramTypes[paramIndex])))
        var genericErr: str
        if !TypedExprFunctionGenericNamesInto(ctx,
                                               share(header),
                                               genericParamTypes,
                                               strings.CloneStr(returnType),
                                               genericNames,
                                               genericErr):
            panic(Fmt"{genericErr} source={ctx.sourcePath} name={scope.name} line={scope.startLine}")
    if header != "":
        var headerGenericParamTypes: str[]
        for paramIndex in 0..<paramTypes.len:
            add(headerGenericParamTypes,
                TypedExprCallRuntimeType(share(paramTypes[paramIndex])))
        var headerGenericNames: str[]
        var headerGenericErr: str
        if !TypedExprFunctionGenericNamesInto(ctx,
                                               share(header),
                                               headerGenericParamTypes,
                                               strings.CloneStr(returnType),
                                               headerGenericNames,
                                               headerGenericErr):
            panic(Fmt"{headerGenericErr} source={ctx.sourcePath} name={scope.name} line={scope.startLine}")
        if headerGenericNames.len != genericNames.len:
            panic(Fmt"typed expr: function declaration generic count drift source={ctx.sourcePath} name={scope.name}")
        for genericIndex in 0..<genericNames.len:
            if headerGenericNames[genericIndex] != genericNames[genericIndex]:
                panic(Fmt"typed expr: function declaration generic name drift source={ctx.sourcePath} name={scope.name} index={genericIndex}")

@borrows
fn TypedExprBuildIndexAddScopeCallDeclaration(index: var TypedExprBuildIndex,
                                                ctx: var TypedExprSourceContext,
                                                scope: TypedExprFunctionScope,
                                                producerSourceIndex: int32,
                                                producerDeclarationOrdinal: int32,
                                                producerFunctionRow: int32) =
    var genericNames: str[]
    var paramTypes: str[]
    var returnType: str
    TypedExprScopeCallDeclarationInto(ctx,
                                      share(scope),
                                      genericNames,
                                      paramTypes,
                                      returnType)
    typedExprBuildIndexAddCallDeclarationWithProducer(
        index,
        share(ctx.sourcePath),
        share(scope.name),
        genericNames,
        paramTypes,
        returnType,
        TypedExprCallDeclarationFunction,
        scope.name,
        scope.startLine,
        scope.borrowResult ? TypedExprExprBorrowed : TypedExprExprOwned,
        producerSourceIndex,
        producerDeclarationOrdinal,
        producerFunctionRow)
    let row = index.callDeclarationSourcePaths.len - 1
    index.callDeclarationManualConsumePresents[row] =
        scope.manualConsumePresent
    index.callDeclarationManualConsumeFunctionDeclarationRows[row] =
        scope.manualConsumeFunctionDeclarationRow
    index.callDeclarationManualConsumeTargetParameterOrdinals[row] =
        scope.manualConsumeTargetParameterOrdinal
    index.callDeclarationManualConsumeSourceParameterOrdinals[row] =
        scope.manualConsumeSourceParameterOrdinal
    index.callDeclarationManualConsumeTargetParameterDeclarationRows[row] =
        scope.manualConsumeTargetParameterDeclarationRow
    index.callDeclarationManualConsumeSourceParameterDeclarationRows[row] =
        scope.manualConsumeSourceParameterDeclarationRow

@borrows
fn typedExprManualConsumeTreeFunctionRowExact(
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        declarationRow: int32): int32 =
    if tree == nil || producerSourceIndex < 0 || declarationRow < 0:
        return -1
    var matchedFunctionRow: int32 = -1
    for row in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               row) != Int32(parser.ParserDeclarationFunction) ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationProducerSourceIndexes,
               row) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationSourceLocalRows,
               row) != declarationRow:
            continue
        let functionRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationFunctionRows,
            row)
        if functionRow < 0 || matchedFunctionRow >= 0:
            return -1
        matchedFunctionRow = functionRow
    return matchedFunctionRow

@borrows
fn typedExprBuildIndexAddImportcCallDeclarationsRec(
        index: var TypedExprBuildIndex,
        ctx: var TypedExprSourceContext,
        producerSourceIndex: int32,
        sourcePath: str,
        i: int32) =
    while true:
        if i >= ctx.importcFunctions.len:
            return
        let importcFn = ctx.importcFunctions[i]
        let paramTypes = TypedExprSplitParamTypeJoin(importcFn.paramTypeJoin)
        var targetSymbol = importcFn.importName
        if targetSymbol == "":
            targetSymbol = importcFn.name
        typedExprBuildIndexAddCallDeclarationWithProducer(
            index,
            share(sourcePath),
            importcFn.name,
            [],
            paramTypes,
            importcFn.returnType,
            TypedExprCallDeclarationImportc,
            targetSymbol,
            0,
            importcFn.ffiOwnedResultPresent ?
                TypedExprExprOwned : TypedExprExprUnknown,
            producerSourceIndex,
            importcFn.producerDeclarationOrdinal,
            -1)
        i = i + 1
        continue

@borrows
fn typedExprBuildIndexAddPlainScopeCallDeclarationsRec(
        index: var TypedExprBuildIndex,
        ctx: var TypedExprSourceContext,
        producerSourceIndex: int32,
        useSignatureScopes: bool,
        i: int32) =
    while true:
        let scopeCount = if useSignatureScopes: ctx.signatureScopes.len else: ctx.scopes.len
        if i >= scopeCount:
            return
        if useSignatureScopes:
            TypedExprBuildIndexAddScopeCallDeclaration(
                index, ctx, ctx.signatureScopes[i], producerSourceIndex,
                ctx.signatureScopes[i].producerDeclarationOrdinal, i)
        else:
            TypedExprBuildIndexAddScopeCallDeclaration(
                index, ctx, ctx.scopes[i], producerSourceIndex,
                ctx.scopes[i].producerDeclarationOrdinal, i)
        i = i + 1
        continue

# [S1b step-3 (6)] `producerSourceIndex` is the GLOBAL recorded identity;
# `treeProducerSourceIndex` is the same source as the resident tree numbers
# itself.  A merged forest numbers sources globally, so the two are equal
# there; a single-source tree numbers its own source 0, so the streaming
# driver passes 0 and the recorded rows stay global.  Without the split the
# streaming driver would find no declaration row at all and panic on the
# `producerFunctionRow < producerFunctionBase` identity guard.
# `@borrows` must sit on the line directly above `fn`: a comment between them
# detaches the attribute and the compiler then treats every managed formal as
# consumed.
@borrows
fn typedExprBuildIndexAddManualScopeCallDeclarationsRec(
        index: var TypedExprBuildIndex,
        ctx: var TypedExprSourceContext,
        producerSourceIndex: int32,
        treeProducerSourceIndex: int32,
        manualTree: parser.ParserValueExprTree,
        producerFunctionBase: int32,
        useSignatureScopes: bool,
        i: int32) =
    while true:
        let scopeCount = if useSignatureScopes: ctx.signatureScopes.len else: ctx.scopes.len
        if i >= scopeCount:
            return
        var producerFunctionRow = i
        if useSignatureScopes:
            if ctx.signatureScopes[i].manualConsumePresent:
                producerFunctionRow =
                    producerFunctionBase +
                    typedExprManualConsumeTreeFunctionRowExact(
                        manualTree,
                        treeProducerSourceIndex,
                        ctx.signatureScopes[
                            i].manualConsumeFunctionDeclarationRow)
                if producerFunctionRow < producerFunctionBase:
                    panic("typed expr: manual-consume constructor function identity missing")
            TypedExprBuildIndexAddScopeCallDeclaration(
                index, ctx, ctx.signatureScopes[i], producerSourceIndex,
                ctx.signatureScopes[i].producerDeclarationOrdinal,
                producerFunctionRow)
        else:
            if ctx.scopes[i].manualConsumePresent:
                producerFunctionRow =
                    producerFunctionBase +
                    typedExprManualConsumeTreeFunctionRowExact(
                        manualTree,
                        treeProducerSourceIndex,
                        ctx.scopes[
                            i].manualConsumeFunctionDeclarationRow)
                if producerFunctionRow < producerFunctionBase:
                    panic("typed expr: manual-consume constructor function identity missing")
            TypedExprBuildIndexAddScopeCallDeclaration(
                index, ctx, ctx.scopes[i], producerSourceIndex,
                ctx.scopes[i].producerDeclarationOrdinal,
                producerFunctionRow)
        i = i + 1
        continue

# [S1b-0d] `producerFunctionBase` is the running forest function-row base of
# this producer source (`ParserValueExprTreeAppendFromImpl` rebases function
# rows by functionOffset + local row).  Driving the whole forest passes 0, so
# the recorded row is the forest row exactly as before; driving one source at
# a time passes the source's base, so the recorded row is the same forest row
# while only the single-source tree is resident.  Without this parameter the
# streaming driver would silently record source-local rows and break the
# call-declaration identity chain.
@borrows
fn typedExprBuildIndexAddContextCallDeclarationsWithManualAuthority(
        index: var TypedExprBuildIndex,
        ctx: var TypedExprSourceContext,
        producerSourceIndex: int32,
        treeProducerSourceIndex: int32,
        manualTree: parser.ParserValueExprTree,
        producerFunctionBase: int32) =
    if manualTree == nil:
        panic("typed expr: manual-consume constructor parser authority missing")
    typedExprBuildIndexAddManualScopeCallDeclarationsRec(
        index, ctx, producerSourceIndex, treeProducerSourceIndex, manualTree,
        producerFunctionBase,
        ctx.signatureScopes.len > 0, 0)
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    typedExprBuildIndexAddImportcCallDeclarationsRec(
        index, ctx, producerSourceIndex, sourcePath, 0)

fn TypedExprBuildIndexAddContextCallDeclarations(
        index: var TypedExprBuildIndex,
        ctx: var TypedExprSourceContext,
        producerSourceIndex: int32) =
    typedExprBuildIndexAddPlainScopeCallDeclarationsRec(
        index, ctx, producerSourceIndex, ctx.signatureScopes.len > 0, 0)
    let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
    typedExprBuildIndexAddImportcCallDeclarationsRec(
        index, ctx, producerSourceIndex, sourcePath, 0)

@borrows
fn TypedExprCallDeclarationRowPrefixCompare(index: TypedExprBuildIndex,
                                             leftRow: int32,
                                             rightRow: int32): int32 =
    var result = TypedExprCallDeclarationTextCompare(
        typedExprBuildIndexCallSourcePath(index, leftRow),
        typedExprBuildIndexCallSourcePath(index, rightRow))
    if result != 0:
        return result
    result = TypedExprCallDeclarationTextCompare(
        typedExprBuildIndexCallName(index, leftRow),
        typedExprBuildIndexCallName(index, rightRow))
    if result != 0:
        return result
    if index.callDeclarationArities[leftRow] < index.callDeclarationArities[rightRow]:
        return -1
    if index.callDeclarationArities[leftRow] > index.callDeclarationArities[rightRow]:
        return 1
    if index.callDeclarationKinds[leftRow] != index.callDeclarationKinds[rightRow]:
        if index.callDeclarationKinds[leftRow] == TypedExprCallDeclarationFunction:
            return -1
        return 1
    return 0

@borrows
fn TypedExprCallDeclarationRowCompare(index: TypedExprBuildIndex,
                                       leftRow: int32,
                                       rightRow: int32): int32 =
    let prefix = TypedExprCallDeclarationRowPrefixCompare(index, leftRow, rightRow)
    if prefix != 0:
        return prefix
    let leftStart = index.callDeclarationParamStarts[leftRow]
    let rightStart = index.callDeclarationParamStarts[rightRow]
    let paramCount = index.callDeclarationParamCounts[leftRow]
    for i in 0..<paramCount:
        let result = TypedExprCallDeclarationTextCompare(
            TypedExprCallDeclarationComparableType(
                typedExprBuildIndexCallParamType(index, leftStart + i)),
            TypedExprCallDeclarationComparableType(
                typedExprBuildIndexCallParamType(index, rightStart + i)))
        if result != 0:
            return result
        let leftBorrow = TypedExprCallArgumentHasExplicitBorrow(
            typedExprBuildIndexCallParamType(index, leftStart + i))
        let rightBorrow = TypedExprCallArgumentHasExplicitBorrow(
            typedExprBuildIndexCallParamType(index, rightStart + i))
        if leftBorrow != rightBorrow:
            return leftBorrow ? 1 : -1
    return 0

fn TypedExprBuildIndexSealCallDeclarations(index: var TypedExprBuildIndex) =
    typedExprBuildIndexRequireMutable(index, "call_declaration_seal")
    if index.callDeclarationSealed:
        panic("typed expr: call declaration index sealed more than once")
    let rowCount = index.callDeclarationSourcePaths.len
    if rowCount != index.callDeclarationNames.len ||
       rowCount != index.callDeclarationArities.len ||
       rowCount != index.callDeclarationGenericStarts.len ||
       rowCount != index.callDeclarationGenericCounts.len ||
       rowCount != index.callDeclarationParamStarts.len ||
       rowCount != index.callDeclarationParamCounts.len ||
       rowCount != index.callDeclarationReturnTypes.len ||
       rowCount != index.callDeclarationTargetSymbols.len ||
       rowCount != index.callDeclarationSignatureLineNumbers.len ||
       rowCount != index.callDeclarationKinds.len ||
       rowCount != index.callDeclarationResultExprClasses.len ||
       rowCount != index.callDeclarationProducerSourceIndexes.len ||
       rowCount !=
           index.callDeclarationProducerDeclarationOrdinals.len ||
       rowCount != index.callDeclarationProducerFunctionRows.len ||
       rowCount != index.callDeclarationManualConsumePresents.len ||
       rowCount !=
           index.callDeclarationManualConsumeFunctionDeclarationRows.len ||
       rowCount !=
           index.callDeclarationManualConsumeTargetParameterOrdinals.len ||
       rowCount !=
           index.callDeclarationManualConsumeSourceParameterOrdinals.len ||
       rowCount !=
           index.callDeclarationManualConsumeTargetParameterDeclarationRows.len ||
       rowCount !=
           index.callDeclarationManualConsumeSourceParameterDeclarationRows.len ||
       rowCount != index.callDeclarationManualConsumeTargetTypeIds.len ||
       rowCount != index.callDeclarationManualConsumeSourceTypeIds.len ||
       rowCount != index.callDeclarationManualConsumeEffectCids.len:
        panic("typed expr: call declaration columns mismatch before seal")
    var genericCursor: int32
    var paramCursor: int32
    for rowIndex in 0..<rowCount:
        let genericStart = index.callDeclarationGenericStarts[rowIndex]
        let genericCount = index.callDeclarationGenericCounts[rowIndex]
        let paramStart = index.callDeclarationParamStarts[rowIndex]
        let paramCount = index.callDeclarationParamCounts[rowIndex]
        let producerSourceIndex =
            index.callDeclarationProducerSourceIndexes[rowIndex]
        let producerDeclarationOrdinal =
            index.callDeclarationProducerDeclarationOrdinals[rowIndex]
        let producerFunctionRow =
            index.callDeclarationProducerFunctionRows[rowIndex]
        let declarationKind =
            index.callDeclarationKinds[rowIndex]
        let manualConsumePresent =
            index.callDeclarationManualConsumePresents[rowIndex]
        let manualConsumeTargetOrdinal =
            index.callDeclarationManualConsumeTargetParameterOrdinals[rowIndex]
        let manualConsumeSourceOrdinal =
            index.callDeclarationManualConsumeSourceParameterOrdinals[rowIndex]
        let manualConsumeTargetRow =
            index.callDeclarationManualConsumeTargetParameterDeclarationRows[
                rowIndex]
        let manualConsumeSourceRow =
            index.callDeclarationManualConsumeSourceParameterDeclarationRows[
                rowIndex]
        let manualConsumeFunctionDeclarationRow =
            index.callDeclarationManualConsumeFunctionDeclarationRows[
                rowIndex]
        if manualConsumePresent:
            if declarationKind != TypedExprCallDeclarationFunction ||
               producerSourceIndex < 0 || producerFunctionRow < 0 ||
               manualConsumeFunctionDeclarationRow < 0 ||
               manualConsumeTargetOrdinal < 0 ||
               manualConsumeTargetOrdinal >= paramCount ||
               manualConsumeSourceOrdinal < 0 ||
               manualConsumeSourceOrdinal >= paramCount ||
               manualConsumeTargetOrdinal == manualConsumeSourceOrdinal ||
               manualConsumeTargetRow < 0 ||
               manualConsumeSourceRow < 0 ||
               manualConsumeTargetRow == manualConsumeSourceRow ||
               index.callDeclarationManualConsumeTargetTypeIds[rowIndex] != -1 ||
               index.callDeclarationManualConsumeSourceTypeIds[rowIndex] != -1 ||
               !layout.FixedBytes32Equal(
                   index.callDeclarationManualConsumeEffectCids[rowIndex],
                   layout.FixedBytes32()):
                panic("typed expr: unbound call declaration manual-consume effect invalid")
        elif !typedExprManualConsumeEffectAbsent(
                 manualConsumePresent,
                 manualConsumeFunctionDeclarationRow,
                 manualConsumeTargetOrdinal,
                 manualConsumeSourceOrdinal,
                 manualConsumeTargetRow,
                 manualConsumeSourceRow,
                 index.callDeclarationManualConsumeTargetTypeIds[rowIndex],
                 index.callDeclarationManualConsumeSourceTypeIds[rowIndex],
                 index.callDeclarationManualConsumeEffectCids[rowIndex]):
            panic("typed expr: absent call declaration manual-consume effect non-empty")
        if producerSourceIndex < -1 ||
           producerFunctionRow < -1 ||
           producerDeclarationOrdinal < -1 ||
           (producerSourceIndex < 0 &&
            producerFunctionRow >= 0) ||
           (producerSourceIndex < 0 &&
            producerDeclarationOrdinal >= 0) ||
           (producerSourceIndex >= 0 &&
            producerDeclarationOrdinal < 0) ||
           (declarationKind == TypedExprCallDeclarationFunction &&
            producerSourceIndex >= 0 && producerFunctionRow < 0) ||
           (declarationKind == TypedExprCallDeclarationImportc &&
            producerFunctionRow != -1):
            panic("typed expr: call declaration producer coordinate corrupt before seal")
        if genericStart != genericCursor || genericCount < 0 ||
           genericStart > index.callDeclarationGenericNames.len - genericCount:
            panic("typed expr: call declaration generic range corrupt before seal")
        if paramStart != paramCursor || paramCount < 0 ||
           paramStart > index.callDeclarationParamTypes.len - paramCount ||
           paramCount != index.callDeclarationArities[rowIndex]:
            panic("typed expr: call declaration parameter range corrupt before seal")
        var fixedParamCount: int32
        var variadicElementType: str
        typedExprCallDeclarationVarargsInfo(index,
                                            rowIndex,
                                            fixedParamCount,
                                            variadicElementType)
        genericCursor = genericCursor + genericCount
        paramCursor = paramCursor + paramCount
        add(index.callDeclarationSortedRows, rowIndex)
    if genericCursor != index.callDeclarationGenericNames.len ||
       paramCursor != index.callDeclarationParamTypes.len:
        panic("typed expr: call declaration flat columns have unreachable tail")
    var tempRows: int32[]
    for i in 0..<rowCount:
        add(tempRows, 0)
    var width: int32 = 1
    while width < rowCount:
        var left: int32
        while left < rowCount:
            var middle = left + width
            if middle > rowCount:
                middle = rowCount
            var right = middle + width
            if right > rowCount:
                right = rowCount
            var leftCursor = left
            var rightCursor = middle
            var writeCursor = left
            while writeCursor < right:
                if rightCursor >= right ||
                   (leftCursor < middle &&
                    TypedExprCallDeclarationRowCompare(index,
                                                       index.callDeclarationSortedRows[leftCursor],
                                                       index.callDeclarationSortedRows[rightCursor]) <= 0):
                    tempRows[writeCursor] = index.callDeclarationSortedRows[leftCursor]
                    leftCursor = leftCursor + 1
                else:
                    tempRows[writeCursor] = index.callDeclarationSortedRows[rightCursor]
                    rightCursor = rightCursor + 1
                writeCursor = writeCursor + 1
            left = right
        for i in 0..<rowCount:
            index.callDeclarationSortedRows[i] = tempRows[i]
        width = typedExprCheckedInt32Capacity(
            typedExprCheckedMul64(Int64(width), 2,
                                  "call_declaration_sort_width"),
            "call_declaration_sort_width")
    var visitedRows: bool[]
    for rowIndex in 0..<rowCount:
        add(visitedRows, false)
    for sortedIndex in 0..<rowCount:
        let rowIndex = index.callDeclarationSortedRows[sortedIndex]
        if rowIndex < 0 || rowIndex >= rowCount || visitedRows[rowIndex]:
            panic("typed expr: call declaration sorted permutation invalid after seal")
        visitedRows[rowIndex] = true
        if sortedIndex > 0 &&
           TypedExprCallDeclarationRowCompare(
               index,
               index.callDeclarationSortedRows[sortedIndex - 1],
               rowIndex) > 0:
            panic("typed expr: call declaration sorted order invalid after seal")
    index.callDeclarationSealed = true

@borrows
fn typedExprCallDeclarationRowOwnerNameCompare(index: TypedExprBuildIndex,
                                                rowIndex: int32,
                                                sourcePath: str,
                                                name: str): int32 =
    var result = TypedExprCallDeclarationTextCompare(
        typedExprBuildIndexCallSourcePath(index, rowIndex), sourcePath)
    if result != 0:
        return result
    return TypedExprCallDeclarationTextCompare(
        typedExprBuildIndexCallName(index, rowIndex), name)

@borrows
fn TypedExprCallDeclarationRowKeyCompare(index: TypedExprBuildIndex,
                                          rowIndex: int32,
                                          sourcePath: str,
                                          name: str,
                                          arity: int32,
                                          declarationKind: TypedExprCallDeclarationKind): int32 =
    let result = typedExprCallDeclarationRowOwnerNameCompare(index,
                                                             rowIndex,
                                                             sourcePath,
                                                             name)
    if result != 0:
        return result
    if index.callDeclarationArities[rowIndex] < arity:
        return -1
    if index.callDeclarationArities[rowIndex] > arity:
        return 1
    if index.callDeclarationKinds[rowIndex] != declarationKind:
        if index.callDeclarationKinds[rowIndex] == TypedExprCallDeclarationFunction:
            return -1
        return 1
    return 0

@borrows
fn TypedExprCallDeclarationRowFullKeyCompare(index: TypedExprBuildIndex,
                                              rowIndex: int32,
                                              sourcePath: str,
                                              name: str,
                                              declarationKind: TypedExprCallDeclarationKind,
                                              argTypes: str[]): int32 =
    let prefix = TypedExprCallDeclarationRowKeyCompare(share(index),
                                                       rowIndex,
                                                       sourcePath,
                                                       name,
                                                       argTypes.len,
                                                       declarationKind)
    if prefix != 0:
        return prefix
    let paramStart = index.callDeclarationParamStarts[rowIndex]
    for i in 0..<argTypes.len:
        let result = TypedExprCallDeclarationTextCompare(
            TypedExprCallDeclarationComparableType(
                typedExprBuildIndexCallParamType(index, paramStart + i)),
            TypedExprCallDeclarationComparableType(argTypes[i]))
        if result != 0:
            return result
        let rowBorrow = TypedExprCallArgumentHasExplicitBorrow(
            typedExprBuildIndexCallParamType(index, paramStart + i))
        let argBorrow = TypedExprCallArgumentHasExplicitBorrow(argTypes[i])
        if rowBorrow != argBorrow:
            return rowBorrow ? 1 : -1
    return 0

@borrows
fn typedExprBuildIndexLookupExactCallDeclarationRow(
        index: TypedExprBuildIndex,
        sourcePath: str,
        name: str,
        declarationKind: TypedExprCallDeclarationKind,
        paramTypes: str[],
        rowIndexOut: var int32): TypedExprBuildIndexLookupState =
    rowIndexOut = -1
    var low: int32
    var high = index.callDeclarationSortedRows.len
    while low < high:
        let middle = low + (high - low) / 2
        let rowIndex = index.callDeclarationSortedRows[middle]
        if TypedExprCallDeclarationRowFullKeyCompare(share(index),
                                                     rowIndex,
                                                     share(sourcePath),
                                                     share(name),
                                                     declarationKind,
                                                     share(paramTypes)) < 0:
            low = middle + 1
        else:
            high = middle
    let rangeStart = low
    high = index.callDeclarationSortedRows.len
    while low < high:
        let middle = low + (high - low) / 2
        let rowIndex = index.callDeclarationSortedRows[middle]
        if TypedExprCallDeclarationRowFullKeyCompare(share(index),
                                                     rowIndex,
                                                     share(sourcePath),
                                                     share(name),
                                                     declarationKind,
                                                     share(paramTypes)) <= 0:
            low = middle + 1
        else:
            high = middle
    let rangeCount = low - rangeStart
    if rangeCount <= 0:
        return TypedExprBuildIndexMissing
    if rangeCount != 1:
        return TypedExprBuildIndexAmbiguous
    rowIndexOut = index.callDeclarationSortedRows[rangeStart]
    return TypedExprBuildIndexUnique

@borrows
fn TypedExprCallDeclarationComparableType(typeRaw: str): str =
    let typeText = TypedExprCallRuntimeType(parser.ParserOwnedText(typeRaw))
    if typeText == "varargs" ||
       parser.ParserStartsWith(typeText, "varargs["):
        var elementType: str
        if !typedExprCallDeclarationVarargsElementType(typeText, elementType):
            panic(Fmt"typed expr: malformed variadic type={typeText}")
        let comparableElement = TypedExprCallDeclarationComparableType(elementType)
        if comparableElement == "" ||
           comparableElement == "varargs" ||
           parser.ParserStartsWith(comparableElement, "varargs["):
            panic(Fmt"typed expr: malformed variadic element type={typeText}")
        return Fmt"varargs[{comparableElement}]"
    return typeText

@borrows
fn TypedExprCallArgumentHasExplicitBorrow(typeRaw: str): bool =
    var innerType = ""
    return TypedExprCallBorrowModeInner(
        parser.ParserOwnedText(typeRaw), innerType)

@borrows
fn typedExprCallDeclarationVarargsInfo(index: TypedExprBuildIndex,
                                        rowIndex: int32,
                                        fixedParamCountOut: var int32,
                                        elementTypeOut: var str): bool =
    fixedParamCountOut = 0
    elementTypeOut = ""
    if index == nil || index.released ||
       rowIndex < 0 ||
       rowIndex >= typedExprBuildIndexCallDeclarationCount(index) ||
       rowIndex >= index.callDeclarationParamStarts.len ||
       rowIndex >= index.callDeclarationParamCounts.len ||
       rowIndex >= index.callDeclarationKinds.len:
        panic("typed expr: variadic call declaration row unavailable")
    let paramStart = index.callDeclarationParamStarts[rowIndex]
    let paramCount = index.callDeclarationParamCounts[rowIndex]
    if paramStart < 0 || paramCount < 0 ||
       paramStart > typedExprBuildIndexCallParamCount(index) - paramCount:
        panic("typed expr: variadic call declaration parameter range corrupt")
    fixedParamCountOut = paramCount
    var variadicParamIndex: int32 = -1
    for paramIndex in 0..<paramCount:
        let paramType = typedExprBuildIndexCallParamType(index,
                                                         paramStart + paramIndex)
        var candidateElementType: str
        let variadic = typedExprCallDeclarationVarargsElementType(
            paramType,
            candidateElementType)
        typedExprCallDeclarationRequireValidVarargsParam(
            paramType,
            paramIndex,
            paramCount,
            index.callDeclarationKinds[rowIndex],
            typedExprBuildIndexCallSourcePath(index, rowIndex),
            typedExprBuildIndexCallName(index, rowIndex),
            variadicParamIndex)
        if variadic:
            fixedParamCountOut = paramIndex
            elementTypeOut = candidateElementType
    return variadicParamIndex >= 0

@borrows
fn TypedExprCallDeclarationGenericNamesInto(index: TypedExprBuildIndex,
                                             rowIndex: int32,
                                             genericNamesOut: var str[]) =
    genericNamesOut = []
    if index == nil || index.released || !index.callDeclarationSealed:
        panic("typed expr: call declaration generic query on unavailable index")
    if rowIndex < 0 || rowIndex >= typedExprBuildIndexCallDeclarationCount(index) ||
       rowIndex >= index.callDeclarationGenericStarts.len ||
       rowIndex >= index.callDeclarationGenericCounts.len:
        panic("typed expr: call declaration generic row out of bounds")
    let genericStart = index.callDeclarationGenericStarts[rowIndex]
    let genericCount = index.callDeclarationGenericCounts[rowIndex]
    if genericStart < 0 || genericCount < 0 ||
       genericStart > typedExprBuildIndexCallGenericNameCount(index) - genericCount:
        panic("typed expr: call declaration generic range corrupt")
    for genericIndex in 0..<genericCount:
        add(genericNamesOut, parser.ParserOwnedText(
            typedExprBuildIndexCallGenericName(
                index, genericStart + genericIndex)))

@borrows
fn TypedExprCallTypeOwnerForKind(index: TypedExprBuildIndex,
                                  kind: str,
                                  ownerSourcePathRaw: str,
                                  leafRaw: str,
                                  sourcePathOut: var str): bool =
    sourcePathOut = ""
    let ownerSourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(ownerSourcePathRaw))
    let leaf = TypedExprTypeLeafName(parser.ParserOwnedText(leafRaw))
    if index == nil || ownerSourcePath == "" || leaf == "":
        return false
    var contextIndex: int32
    let state = TypedExprBuildIndexLookup(index,
                                           kind,
                                           ownerSourcePath,
                                           leaf,
                                           "",
                                           contextIndex)
    if state != TypedExprBuildIndexUnique:
        return false
    sourcePathOut = parser.ParserOwnedText(
        TypedExprBuildIndexContextSourcePath(index, contextIndex))
    return sourcePathOut != ""

@borrows
fn TypedExprCallTypeOwner(index: TypedExprBuildIndex,
                           ownerSourcePathRaw: str,
                           typeRaw: str,
                           sourcePathOut: var str,
                           leafOut: var str): bool =
    sourcePathOut = ""
    leafOut = ""
    let ownerSourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(ownerSourcePathRaw))
    let typeText = TypedExprNormalizeTypeText(
        TypedExprStripVarType(parser.ParserOwnedText(typeRaw)))
    let leaf = TypedExprTypeLeafName(typeText)
    if index == nil || ownerSourcePath == "" || leaf == "":
        return false
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(typeText, 0, dotPos))
        if qualifier == "":
            return false
        var targetContextIndex: int32
        if TypedExprBuildIndexLookup(index,
                                     "ctx_import_alias",
                                     ownerSourcePath,
                                     qualifier,
                                     "",
                                     targetContextIndex) != TypedExprBuildIndexUnique:
            return false
        let targetSourcePath = TypedExprBuildIndexContextSourcePath(index,
                                                                    targetContextIndex)
        if targetSourcePath == "":
            return false
        var declaredContextIndex: int32
        var declared = TypedExprBuildIndexLookup(index,
                                                  "ctx_declared_source",
                                                  targetSourcePath,
                                                  leaf,
                                                  "",
                                                  declaredContextIndex) == TypedExprBuildIndexUnique
        if !declared:
            declared = TypedExprBuildIndexLookup(index,
                                                  "ctx_ref_source",
                                                  targetSourcePath,
                                                  leaf,
                                                  "",
                                                  declaredContextIndex) == TypedExprBuildIndexUnique
        if !declared:
            declared = TypedExprBuildIndexLookup(index,
                                                  "ctx_enum_type_source",
                                                  targetSourcePath,
                                                  leaf,
                                                  "",
                                                  declaredContextIndex) == TypedExprBuildIndexUnique
        if !declared:
            declared = TypedExprBuildIndexLookup(index,
                                                  "ctx_alias_source",
                                                  targetSourcePath,
                                                  leaf,
                                                  "",
                                                  declaredContextIndex) == TypedExprBuildIndexUnique
        if !declared:
            return false
        sourcePathOut = parser.ParserOwnedText(targetSourcePath)
        leafOut = leaf
        return true
    var localOwner = ""
    if TypedExprCallTypeOwnerForKind(index,
                                      "ctx_declared_source",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner) ||
       TypedExprCallTypeOwnerForKind(index,
                                      "ctx_ref_source",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner) ||
       TypedExprCallTypeOwnerForKind(index,
                                      "ctx_enum_type_source",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner) ||
       TypedExprCallTypeOwnerForKind(index,
                                      "ctx_alias_source",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner):
        sourcePathOut = localOwner
        leafOut = leaf
        return true
    if TypedExprCallTypeOwnerForKind(index,
                                      "ctx_import_declared",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner) ||
       TypedExprCallTypeOwnerForKind(index,
                                      "ctx_import_ref",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner) ||
       TypedExprCallTypeOwnerForKind(index,
                                      "ctx_import_enum_type",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner) ||
       TypedExprCallTypeOwnerForKind(index,
                                      "ctx_import_alias_def",
                                      ownerSourcePath,
                                      leaf,
                                      localOwner):
        sourcePathOut = localOwner
        leafOut = leaf
        return true
    return false

@borrows
fn TypedExprCallAliasTarget(index: TypedExprBuildIndex,
                              ownerSourcePathRaw: str,
                              typeRaw: str,
                              visitedOwners: var str[],
                              visitedNames: var str[],
                              targetOwnerSourcePathOut: var str,
                              targetTypeOut: var str,
                              cycleOut: var bool): bool =
    targetOwnerSourcePathOut = ""
    targetTypeOut = ""
    cycleOut = false
    if index == nil || index.released:
        return false
    let ownerSourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(ownerSourcePathRaw))
    let typeText = TypedExprNormalizeTypeText(
        parser.ParserOwnedText(typeRaw))
    if ownerSourcePath == "" || typeText == "":
        return false
    var aliasOwnerSourcePath = share(ownerSourcePath)
    var aliasName = share(typeText)
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(
            chengpath.TextSlice(typeText, 0, dotPos))
        aliasName = parser.ParserOwnedText(chengpath.PathTrim(
            chengpath.TextSlice(typeText,
                                dotPos + 1,
                                typeText.len - dotPos - 1)))
        if qualifier == "" ||
           parser.ParserIdentPrefix(parser.ParserOwnedText(qualifier)) !=
               qualifier ||
           aliasName == "" ||
           parser.ParserIdentPrefix(parser.ParserOwnedText(aliasName)) !=
               aliasName:
            return false
        var targetContextIndex: int32
        if TypedExprBuildIndexLookup(index,
                                     "ctx_import_alias",
                                     ownerSourcePath,
                                     qualifier,
                                     "",
                                     targetContextIndex) !=
           TypedExprBuildIndexUnique:
            return false
        aliasOwnerSourcePath = parser.ParserOwnedText(
            TypedExprBuildIndexContextSourcePath(
                index, targetContextIndex))
        if aliasOwnerSourcePath == "":
            return false
        if TypedExprBuildIndexLookupFingerprint(index,
                                                 "ctx_alias_source",
                                                 aliasOwnerSourcePath,
                                                 aliasName,
                                                 "",
                                                 targetTypeOut) !=
           TypedExprBuildIndexUnique:
            targetTypeOut = ""
            return false
    else:
        if parser.ParserIdentPrefix(parser.ParserOwnedText(aliasName)) !=
           aliasName:
            return false
        var state = TypedExprBuildIndexLookupFingerprint(index,
                                                          "ctx_alias_source",
                                                          ownerSourcePath,
                                                          aliasName,
                                                          "",
                                                          targetTypeOut)
        if state == TypedExprBuildIndexMissing:
            state = TypedExprBuildIndexLookupFingerprint(index,
                                                          "ctx_import_alias_def",
                                                          ownerSourcePath,
                                                          aliasName,
                                                          "",
                                                          targetTypeOut)
            if state == TypedExprBuildIndexUnique:
                var targetContextIndex: int32
                if TypedExprBuildIndexLookup(index,
                                             "ctx_import_alias_def",
                                             ownerSourcePath,
                                             aliasName,
                                             "",
                                             targetContextIndex) !=
                   TypedExprBuildIndexUnique:
                    targetTypeOut = ""
                    return false
                aliasOwnerSourcePath = parser.ParserOwnedText(
                    TypedExprBuildIndexContextSourcePath(
                        index, targetContextIndex))
        if state != TypedExprBuildIndexUnique ||
           aliasOwnerSourcePath == "":
            targetTypeOut = ""
            return false
    targetTypeOut = TypedExprNormalizeTypeText(targetTypeOut)
    if targetTypeOut == "":
        return false
    for visitIndex in 0..<visitedOwners.len:
        if visitIndex < visitedNames.len &&
           visitedOwners[visitIndex] == aliasOwnerSourcePath &&
           visitedNames[visitIndex] == aliasName:
            targetTypeOut = ""
            cycleOut = true
            return false
    add(visitedOwners, parser.ParserOwnedText(aliasOwnerSourcePath))
    add(visitedNames, parser.ParserOwnedText(aliasName))
    targetOwnerSourcePathOut = aliasOwnerSourcePath
    return true

@borrows
fn TypedExprCallConstInt64Literal(textRaw: str,
                                   valueOut: var int64): bool =
    valueOut = 0
    let text = TypedExprNormalizeTypeText(textRaw)
    if text == "":
        return false
    var negative = false
    var cursor: int32
    if text[0] == '-' || text[0] == '+':
        negative = text[0] == '-'
        cursor = 1
        if cursor >= text.len:
            return false
    var radix: int32 = 10
    if cursor + 2 <= text.len && text[cursor] == '0' &&
       (text[cursor + 1] == 'x' || text[cursor + 1] == 'X'):
        radix = 16
        cursor = cursor + 2
        if cursor >= text.len:
            return false
    var magnitude: uint64
    var limit = uint64(9223372036854775807)
    if negative:
        limit = limit + uint64(1)
    for digitIndex in cursor..<text.len:
        let ch = text[digitIndex]
        var digit: int32 = -1
        if ch >= '0' && ch <= '9':
            digit = int32(ch) - int32('0')
        elif radix == 16 && ch >= 'a' && ch <= 'f':
            digit = int32(ch) - int32('a') + 10
        elif radix == 16 && ch >= 'A' && ch <= 'F':
            digit = int32(ch) - int32('A') + 10
        if digit < 0 || digit >= radix:
            return false
        let digitValue = uint64(digit)
        let radixValue = uint64(radix)
        if magnitude > (limit - digitValue) / radixValue:
            return false
        magnitude = magnitude * radixValue + digitValue
    if negative:
        if magnitude == uint64(9223372036854775807) + uint64(1):
            valueOut = Int64(-9223372036854775807) - Int64(1)
        else:
            valueOut = -Int64(magnitude)
        return true
    valueOut = Int64(magnitude)
    return true

@borrows
fn TypedExprCallConstBinaryOpPos(text: str,
                                  additive: bool): int32 =
    var parenDepth: int32
    var bracketDepth: int32
    var lastPos: int32 = -1
    for i in 0..<text.len:
        let ch = text[i]
        if ch == '(':
            parenDepth = parenDepth + 1
            continue
        if ch == ')':
            parenDepth = parenDepth - 1
            if parenDepth < 0:
                return -1
            continue
        if ch == '[':
            bracketDepth = bracketDepth + 1
            continue
        if ch == ']':
            bracketDepth = bracketDepth - 1
            if bracketDepth < 0:
                return -1
            continue
        if parenDepth != 0 || bracketDepth != 0:
            continue
        if additive:
            if ch != '+' && ch != '-':
                continue
            if i == 0:
                continue
            let previous = text[i - 1]
            if previous == '+' || previous == '-' || previous == '*' ||
               previous == '/' || previous == '%' || previous == '(':
                continue
            lastPos = i
        elif ch == '*' || ch == '/' || ch == '%':
            lastPos = i
    if parenDepth != 0 || bracketDepth != 0:
        return -1
    return lastPos

@borrows
fn TypedExprCallConstTarget(index: TypedExprBuildIndex,
                             ownerSourcePathRaw: str,
                             nameRaw: str,
                             visitedOwners: var str[],
                             visitedNames: var str[],
                             targetOwnerSourcePathOut: var str,
                             literalOut: var str,
                             foundOut: var bool,
                             cycleOut: var bool): bool =
    targetOwnerSourcePathOut = ""
    literalOut = ""
    foundOut = false
    cycleOut = false
    if index == nil || index.released:
        return false
    let ownerSourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(ownerSourcePathRaw))
    let nameText = TypedExprNormalizeTypeText(
        parser.ParserOwnedText(nameRaw))
    if ownerSourcePath == "" || nameText == "":
        return false
    var constOwnerSourcePath = share(ownerSourcePath)
    var constName = share(nameText)
    var literalState = TypedExprBuildIndexMissing
    let dotPos = TypedExprQualifiedTypeDot(nameText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(
            chengpath.TextSlice(nameText, 0, dotPos))
        constName = parser.ParserOwnedText(chengpath.PathTrim(
            chengpath.TextSlice(nameText,
                                dotPos + 1,
                                nameText.len - dotPos - 1)))
        if qualifier == "" ||
           parser.ParserIdentPrefix(parser.ParserOwnedText(qualifier)) !=
               qualifier ||
           constName == "" ||
           parser.ParserIdentPrefix(parser.ParserOwnedText(constName)) !=
               constName:
            return false
        var targetContextIndex: int32
        let importState = TypedExprBuildIndexLookup(index,
                                                     "ctx_import_alias",
                                                     ownerSourcePath,
                                                     qualifier,
                                                     "",
                                                     targetContextIndex)
        if importState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: ambiguous const import alias source={ownerSourcePath} qualifier={qualifier} name={constName}")
        if importState != TypedExprBuildIndexUnique:
            return false
        constOwnerSourcePath = parser.ParserOwnedText(
            TypedExprBuildIndexContextSourcePath(
                index, targetContextIndex))
        if !TypedExprTopLevelDeclarationExportedByCase(constName):
            panic(Fmt"typed expr: private qualified module const source={ownerSourcePath} qualifier={qualifier} name={constName} target_source={constOwnerSourcePath}")
    elif parser.ParserIdentPrefix(parser.ParserOwnedText(constName)) !=
         constName:
        return false
    if constOwnerSourcePath == "":
        return false
    literalState = TypedExprBuildIndexLookupFingerprint(index,
                                                         "ctx_module_const_source",
                                                         constOwnerSourcePath,
                                                         constName,
                                                         "",
                                                         literalOut)
    if literalState == TypedExprBuildIndexAmbiguous:
        panic(Fmt"typed expr: ambiguous module const source={constOwnerSourcePath} name={constName}")
    if literalState == TypedExprBuildIndexMissing && dotPos < 0 &&
       TypedExprTopLevelDeclarationExportedByCase(constName):
        var visibleContextIndex: int32
        literalState = TypedExprBuildIndexVisibleLookup(
            index,
            "ctx_import_module_const",
            share(ownerSourcePath),
            share(constName),
            "",
            visibleContextIndex,
            literalOut)
        if literalState == TypedExprBuildIndexAmbiguous:
            panic(Fmt"typed expr: ambiguous visible module const source={ownerSourcePath} name={constName}")
        if literalState == TypedExprBuildIndexUnique:
            constOwnerSourcePath = parser.ParserOwnedText(
                TypedExprBuildIndexContextSourcePath(
                    index, visibleContextIndex))
            if constOwnerSourcePath == "":
                panic(Fmt"typed expr: visible module const owner missing source={ownerSourcePath} name={constName}")
    if literalState != TypedExprBuildIndexUnique:
        literalOut = ""
        return false
    foundOut = true
    let literalTrimmed = chengpath.PathTrim(parser.ParserOwnedText(literalOut))
    literalOut = literalTrimmed
    if literalOut == "":
        return false
    for visitIndex in 0..<visitedOwners.len:
        if visitIndex < visitedNames.len &&
           visitedOwners[visitIndex] == constOwnerSourcePath &&
           visitedNames[visitIndex] == constName:
            literalOut = ""
            cycleOut = true
            return false
    add(visitedOwners, parser.ParserOwnedText(constOwnerSourcePath))
    add(visitedNames, parser.ParserOwnedText(constName))
    targetOwnerSourcePathOut = constOwnerSourcePath
    return true

fn TypedExprCallConstApplyBinary(left: int64,
                                  right: int64,
                                  op: int32,
                                  valueOut: var int64): bool =
    valueOut = 0
    let minValue = Int64(-9223372036854775807) - Int64(1)
    let maxValue = Int64(9223372036854775807)
    if op == int32('+'):
        if (right > 0 && left > maxValue - right) ||
           (right < 0 && left < minValue - right):
            return false
        valueOut = left + right
    elif op == int32('-'):
        if (right > 0 && left < minValue + right) ||
           (right < 0 && left > maxValue + right):
            return false
        valueOut = left - right
    elif op == int32('*'):
        if left > 0:
            if (right > 0 && left > maxValue / right) ||
               (right < 0 && right < minValue / left):
                return false
        elif left < 0:
            if (right > 0 && left < minValue / right) ||
               (right < 0 && right < maxValue / left):
                return false
        valueOut = left * right
    elif op == int32('/'):
        if right == 0:
            return false
        if left == minValue && right == -1:
            return false
        valueOut = left / right
    elif op == int32('%'):
        if right == 0:
            return false
        if left == minValue && right == -1:
            valueOut = 0
            return true
        valueOut = left % right
    else:
        return false
    return true

fn TypedExprCallConstCastValue(castName: str,
                                value: int64,
                                valueOut: var int64): bool =
    valueOut = 0
    if castName == "int8":
        if value < Int64(-128) || value > Int64(127):
            return false
    elif castName == "uint8":
        if value < 0 || value > Int64(255):
            return false
    elif castName == "int16":
        if value < Int64(-32768) || value > Int64(32767):
            return false
    elif castName == "uint16":
        if value < 0 || value > Int64(65535):
            return false
    elif castName == "int32":
        if value < Int64(-2147483648) || value > Int64(2147483647):
            return false
    elif castName == "uint32":
        if value < 0 || value > Int64(4294967295):
            return false
    elif castName == "uint64":
        if value < 0:
            return false
    elif castName != "int64":
        return false
    valueOut = value
    return true

@borrows
fn TypedExprCallConstNumericSurface(text: str): bool =
    if text == "":
        return false
    var cursor: int32
    if text[0] == '+' || text[0] == '-':
        cursor = 1
        if cursor >= text.len:
            return false
    return text[cursor] >= '0' && text[cursor] <= '9'

@borrows
fn TypedExprCallConstUnsupportedIntegerOperator(text: str): bool =
    return TypedExprFindTopLevelTextToken(text, "<<") >= 0 ||
           TypedExprFindTopLevelTextToken(text, ">>") >= 0 ||
           TypedExprFindTopLevelTextToken(text, "&") >= 0 ||
           TypedExprFindTopLevelTextToken(text, "|") >= 0 ||
           TypedExprFindTopLevelTextToken(text, "^") >= 0 ||
           TypedExprFindTopLevelTextToken(text, "~") >= 0

@borrows
fn TypedExprCallConstIntValue(index: TypedExprBuildIndex,
                               ownerSourcePathRaw: str,
                               textRaw: str,
                               visitedOwners: var str[],
                               visitedNames: var str[],
                               recognizedOut: var bool,
                               valueOut: var int64): bool =
    recognizedOut = false
    valueOut = 0
    let text = TypedExprNormalizeTypeText(textRaw)
    if text == "":
        return false
    if TypedExprCallConstInt64Literal(text, valueOut):
        recognizedOut = true
        return true
    if TypedExprCallConstNumericSurface(text):
        recognizedOut = true
    if text[0] == '(' &&
       TypedExprFindMatchingParen(text, 0) == text.len - 1:
        return TypedExprCallConstIntValue(
            index,
            ownerSourcePathRaw,
            chengpath.TextSlice(text, 1, text.len - 2),
            visitedOwners,
            visitedNames,
            recognizedOut,
            valueOut)
    var opPos = TypedExprCallConstBinaryOpPos(text, true)
    if opPos < 0:
        opPos = TypedExprCallConstBinaryOpPos(text, false)
    if opPos > 0 && opPos + 1 < text.len:
        recognizedOut = true
        var leftValue: int64
        var rightValue: int64
        var leftRecognized = false
        var rightRecognized = false
        if !TypedExprCallConstIntValue(
                index,
                ownerSourcePathRaw,
                chengpath.TextSlice(text, 0, opPos),
                visitedOwners,
                visitedNames,
                leftRecognized,
                leftValue) ||
           !TypedExprCallConstIntValue(
                index,
                ownerSourcePathRaw,
                chengpath.TextSlice(text,
                                    opPos + 1,
                                    text.len - opPos - 1),
                visitedOwners,
                visitedNames,
                rightRecognized,
                rightValue):
            return false
        if !leftRecognized || !rightRecognized:
            return false
        return TypedExprCallConstApplyBinary(leftValue,
                                              rightValue,
                                              int32(text[opPos]),
                                              valueOut)
    if TypedExprCallConstUnsupportedIntegerOperator(text):
        recognizedOut = true
        return false
    if text.len > 1 && (text[0] == '+' || text[0] == '-'):
        recognizedOut = true
        var innerValue: int64
        var innerRecognized = false
        if !TypedExprCallConstIntValue(
                index,
                ownerSourcePathRaw,
                chengpath.TextSlice(text, 1, text.len - 1),
                visitedOwners,
                visitedNames,
                innerRecognized,
                innerValue):
            return false
        if !innerRecognized:
            return false
        if text[0] == '+':
            valueOut = innerValue
            return true
        if innerValue == Int64(-9223372036854775807) - Int64(1):
            return false
        valueOut = -innerValue
        return true
    let castOpen = TypedExprFindTopLevelToken(text, "(")
    if castOpen > 0 &&
       TypedExprFindMatchingParen(text, castOpen) == text.len - 1:
        let castName = chengpath.TextSlice(text, 0, castOpen)
        if castName == "int8" || castName == "uint8" ||
           castName == "int16" || castName == "uint16" ||
           castName == "int32" || castName == "uint32" ||
           castName == "int64" || castName == "uint64":
            recognizedOut = true
            var castInput: int64
            var castRecognized = false
            if !TypedExprCallConstIntValue(
                index,
                ownerSourcePathRaw,
                chengpath.TextSlice(text,
                                    castOpen + 1,
                                    text.len - castOpen - 2),
                visitedOwners,
                visitedNames,
                castRecognized,
                castInput):
                return false
            if !castRecognized:
                return false
            return TypedExprCallConstCastValue(castName,
                                                castInput,
                                                valueOut)
    let visitedOwnerCount = visitedOwners.len
    let visitedNameCount = visitedNames.len
    var targetOwnerSourcePath = ""
    var literal = ""
    var constFound = false
    var cycle = false
    if !TypedExprCallConstTarget(index,
                                 ownerSourcePathRaw,
                                 text,
                                 visitedOwners,
                                 visitedNames,
                                 targetOwnerSourcePath,
                                 literal,
                                 constFound,
                                 cycle):
        if cycle:
            panic(Fmt"typed expr: module const cycle source={ownerSourcePathRaw} name={text}")
        if constFound:
            recognizedOut = true
        return false
    recognizedOut = true
    var literalRecognized = false
    let resolved = TypedExprCallConstIntValue(index,
                                               targetOwnerSourcePath,
                                               literal,
                                               visitedOwners,
                                               visitedNames,
                                               literalRecognized,
                                               valueOut)
    setLen(visitedOwners, visitedOwnerCount)
    setLen(visitedNames, visitedNameCount)
    return resolved && literalRecognized

fn TypedExprCallTrailingBracketOpen(typeText: str): int32 =
    var bracketDepth: int32
    var parenDepth: int32
    var trailingOpen: int32 = -1
    for i in 0..<typeText.len:
        let ch = typeText[i]
        if ch == '(':
            parenDepth = parenDepth + 1
            continue
        if ch == ')':
            parenDepth = parenDepth - 1
            if parenDepth < 0:
                return -1
            continue
        if ch == '[':
            if bracketDepth == 0 && parenDepth == 0:
                trailingOpen = i
            bracketDepth = bracketDepth + 1
            continue
        if ch == ']':
            bracketDepth = bracketDepth - 1
            if bracketDepth < 0:
                return -1
    if bracketDepth != 0 || parenDepth != 0 || trailingOpen <= 0 ||
       TypedExprFindMatchingBracket(typeText, trailingOpen) != typeText.len - 1:
        return -1
    return trailingOpen

fn TypedExprCallBuiltinScalarType(typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    return typeText == "void" || typeText == "bool" ||
           typeText == "char" || typeText == "str" ||
           typeText == "cstring" || typeText == "ptr" ||
           typeText == "int8" || typeText == "int16" ||
           typeText == "int32" || typeText == "int64" ||
           typeText == "int" || typeText == "uint8" ||
           typeText == "uint16" || typeText == "uint32" ||
           typeText == "uint64" || typeText == "uint" ||
           typeText == "float32" || typeText == "float64"

@borrows
fn TypedExprCallTypeIdentityEqualImpl(
        index: TypedExprBuildIndex,
        leftOwnerSourcePath: str,
        leftTypeRaw: str,
        rightOwnerSourcePath: str,
        rightTypeRaw: str,
        leftVisitedOwners: var str[],
        leftVisitedNames: var str[],
        rightVisitedOwners: var str[],
        rightVisitedNames: var str[]): bool =
    let leftType = TypedExprCallDeclarationComparableType(leftTypeRaw)
    let rightType = TypedExprCallDeclarationComparableType(rightTypeRaw)
    if leftType == "" || rightType == "":
        return false
    if leftType == rightType:
        return true
    var leftSourcePath = ""
    var leftLeaf = ""
    var rightSourcePath = ""
    var rightLeaf = ""
    if !TypedExprCallTypeOwner(index,
                               leftOwnerSourcePath,
                               leftType,
                               leftSourcePath,
                               leftLeaf) ||
       !TypedExprCallTypeOwner(index,
                               rightOwnerSourcePath,
                               rightType,
                               rightSourcePath,
                               rightLeaf):
        return false
    return leftLeaf == rightLeaf &&
           TypedExprSourcePathsEquivalent(leftSourcePath, rightSourcePath)

@borrows
fn TypedExprCallTypeIdentityEqual(index: TypedExprBuildIndex,
                                   leftOwnerSourcePath: str,
                                   leftTypeRaw: str,
                                   rightOwnerSourcePath: str,
                                   rightTypeRaw: str): bool =
    var leftVisitedOwners: str[]
    var leftVisitedNames: str[]
    var rightVisitedOwners: str[]
    var rightVisitedNames: str[]
    return TypedExprCallTypeIdentityEqualImpl(
        index,
        leftOwnerSourcePath,
        leftTypeRaw,
        rightOwnerSourcePath,
        rightTypeRaw,
        leftVisitedOwners,
        leftVisitedNames,
        rightVisitedOwners,
        rightVisitedNames)


@borrows
fn TypedExprUnifyGenericParamTypeInSources(index: TypedExprBuildIndex,
                                            templateOwnerSourcePath: str,
                                            templateRaw: str,
                                            concreteOwnerSourcePath: str,
                                            concreteRaw: str,
                                            declaredGenericNames: var str[],
                                            boundNames: var str[],
                                            boundTypes: var str[]): bool =
    var tmpl = TypedExprNormalizeTypeText(
        parser.ParserOwnedText(templateRaw))
    var conc = TypedExprNormalizeTypeText(
        parser.ParserOwnedText(concreteRaw))
    if tmpl == "" || conc == "":
        return false
    while true:
        if TypedExprDeclaredGenericNameIndex(declaredGenericNames, tmpl) >= 0:
            for i in 0..<boundNames.len:
                if boundNames[i] == tmpl:
                    return TypedExprCallTypeIdentityEqual(index,
                                                           concreteOwnerSourcePath,
                                                           boundTypes[i],
                                                           concreteOwnerSourcePath,
                                                           conc)
            add(boundNames, tmpl)
            add(boundTypes, conc)
            return true
        if tmpl.len > 0 && tmpl[tmpl.len - 1] == '*':
            if conc.len <= 0 || conc[conc.len - 1] != '*':
                return false
            tmpl = chengpath.TextSlice(tmpl, 0, tmpl.len - 1)
            conc = chengpath.TextSlice(conc, 0, conc.len - 1)
            continue
        if tmpl.len >= 2 && TypedExprTextAt(tmpl, tmpl.len - 2, "[]"):
            if conc.len < 2 || !TypedExprTextAt(conc, conc.len - 2, "[]"):
                return false
            tmpl = chengpath.TextSlice(tmpl, 0, tmpl.len - 2)
            conc = chengpath.TextSlice(conc, 0, conc.len - 2)
            continue
        break
    if tmpl.len > 3 && conc.len > 3:
        let tmplPrefix = chengpath.TextSlice(tmpl, 0, 3)
        let concPrefix = chengpath.TextSlice(conc, 0, 3)
        if (tmplPrefix == "ref" || tmplPrefix == "var") &&
           tmplPrefix == concPrefix:
            return TypedExprUnifyGenericParamTypeInSources(
                index,
                templateOwnerSourcePath,
                chengpath.TextSlice(tmpl, 3, tmpl.len - 3),
                concreteOwnerSourcePath,
                chengpath.TextSlice(conc, 3, conc.len - 3),
                declaredGenericNames,
                boundNames,
                boundTypes)
    let openPos = TypedExprFindTopLevelToken(tmpl, "[")
    if openPos > 0:
        let closePos = TypedExprFindMatchingBracket(tmpl, openPos)
        let concOpen = TypedExprFindTopLevelToken(conc, "[")
        if closePos <= openPos || closePos + 1 != tmpl.len || concOpen <= 0:
            return false
        let concClose = TypedExprFindMatchingBracket(conc, concOpen)
        if concClose <= concOpen || concClose + 1 != conc.len:
            return false
        let tmplContainer = chengpath.TextSlice(tmpl, 0, openPos)
        let concContainer = chengpath.TextSlice(conc, 0, concOpen)
        if !TypedExprCallTypeIdentityEqual(index,
                                           templateOwnerSourcePath,
                                           tmplContainer,
                                           concreteOwnerSourcePath,
                                           concContainer):
            return false
        let tmplArgs = TypedExprSplitTopLevelCsv(chengpath.TextSlice(tmpl,
                                                                     openPos + 1,
                                                                     closePos - openPos - 1))
        let concArgs = TypedExprSplitTopLevelCsv(chengpath.TextSlice(conc,
                                                                     concOpen + 1,
                                                                     concClose - concOpen - 1))
        if tmplArgs.len != concArgs.len:
            return false
        for i in 0..<tmplArgs.len:
            if !TypedExprUnifyGenericParamTypeInSources(index,
                                                         templateOwnerSourcePath,
                                                         tmplArgs[i],
                                                         concreteOwnerSourcePath,
                                                         concArgs[i],
                                                         declaredGenericNames,
                                                         boundNames,
                                                         boundTypes):
                return false
        return true
    return TypedExprCallTypeIdentityEqual(index,
                                           templateOwnerSourcePath,
                                           tmpl,
                                           concreteOwnerSourcePath,
                                           conc)

@borrows
fn TypedExprCallDeclarationBindTypes(index: TypedExprBuildIndex,
                                      rowIndex: int32,
                                      argOwnerSourcePath: str,
                                      argTypes: str[],
                                      explicitGenericTypes: str[],
                                      explicitGenericPresent: bool,
                                      boundNames: var str[],
                                      boundTypes: var str[]): bool =
    boundNames = []
    boundTypes = []
    var declaredGenericNames: str[]
    TypedExprCallDeclarationGenericNamesInto(index,
                                              rowIndex,
                                              declaredGenericNames)
    if explicitGenericPresent:
        if declaredGenericNames.len <= 0 ||
           explicitGenericTypes.len != declaredGenericNames.len:
            return false
        for genericIndex in 0..<declaredGenericNames.len:
            let concreteType = TypedExprNormalizeTypeText(
                parser.ParserOwnedText(
                    explicitGenericTypes[genericIndex]))
            if concreteType == "" || concreteType == "unknown":
                return false
            add(boundNames, parser.ParserOwnedText(
                declaredGenericNames[genericIndex]))
            add(boundTypes, concreteType)
    elif explicitGenericTypes.len != 0:
        panic("typed expr: explicit generic payload without presence flag")
    let paramStart = index.callDeclarationParamStarts[rowIndex]
    let paramCount = index.callDeclarationParamCounts[rowIndex]
    var fixedParamCount: int32
    var variadicElementType: str
    let variadic = typedExprCallDeclarationVarargsInfo(index,
                                                       rowIndex,
                                                       fixedParamCount,
                                                       variadicElementType)
    if (!variadic && paramCount != argTypes.len) ||
       (variadic && argTypes.len < fixedParamCount):
        return false
    # importc (C ABI) 声明的整数值实参允许安全宽化匹配: 整数字面量/int32 值
    # 传 int64/uint64 参数是 cold 一贯的调用语义 (raw_libc_fseek(fp, 0, ..)
    # 的 `0` 匹配 int64 offset), C ABI 按宽度传参天然兼容; 严格 identity
    # unify 会把这类 importc 调用误判无匹配 → fact 占位 call_expr →
    # resolved call missing concrete type。仅限 importc 声明, 用户 Cheng
    # 函数维持严格 identity。
    let declIsImportc = index.callDeclarationKinds[rowIndex] == TypedExprCallDeclarationImportc
    for argIndex in 0..<argTypes.len:
        var paramType = share(variadicElementType)
        if !variadic || argIndex < fixedParamCount:
            paramType = typedExprBuildIndexCallParamType(index,
                                                         paramStart + argIndex)
        let paramComparable = TypedExprCallDeclarationComparableType(paramType)
        let argComparable = TypedExprCallDeclarationComparableType(argTypes[argIndex])
        if declIsImportc &&
           (paramComparable == "int64" || paramComparable == "uint64") &&
           (argComparable == "int32" || argComparable == "uint32"):
            continue
        # importc 的 str 字面量实参按 cstring 求值 (cold 语义: 字符串字面量在
        # C ABI ptr/cstring 参数位就是数据指针, 如 libc_dlopen_native("...")),
        # 定型层不知 importc 上下文而记 "str" — 声明匹配放行; str 聚合变量传
        # ptr 仍由值侧拒绝 (ABI 不兼容), 不受影响。
        if declIsImportc &&
           (paramComparable == "ptr" || paramComparable == "cstring") &&
           argComparable == "str":
            continue
        # [c6-ptr2cstring] importc 的 ptr 数据指针实参传 cstring 形参
        # (cold 语义: cstring 形参在 C ABI 位就是数据指针, 上方 str 臂的
        # 镜像向; 实证 std/cmdline.cheng:178 StrDataPtr(arg):ptr 传
        # __cheng_cstrlen(raw: cstring): int32)。矩阵缺臂 → BindTypes
        # 回退被拒 → fact 保留身份但类型落占位 → 'resolved call missing
        # concrete type' (branchb c6 判词)。仅限 importc 声明, 用户
        # Cheng 函数维持严格 identity; cstring→ptr 反向不在臂内。
        if declIsImportc &&
           paramComparable == "cstring" &&
           argComparable == "ptr":
            continue
        if !TypedExprUnifyGenericParamTypeInSources(
                index,
                typedExprBuildIndexCallSourcePath(index, rowIndex),
                paramComparable,
                argOwnerSourcePath,
                argComparable,
                declaredGenericNames,
                boundNames,
                boundTypes):
            return false
    return true

@borrows
fn TypedExprCallDeclarationMatchRank(index: TypedExprBuildIndex,
                                      rowIndex: int32,
                                      argOwnerSourcePath: str,
                                      argTypes: str[],
                                      explicitGenericTypes: str[],
                                      explicitGenericPresent: bool): int32 =
    let paramStart = index.callDeclarationParamStarts[rowIndex]
    var borrowFixedParamCount: int32
    var borrowVariadicElementType: str
    let borrowVariadic = typedExprCallDeclarationVarargsInfo(
        index,
        rowIndex,
        borrowFixedParamCount,
        borrowVariadicElementType)
    for argIndex in 0..<argTypes.len:
        var borrowParamType = share(borrowVariadicElementType)
        if !borrowVariadic || argIndex < borrowFixedParamCount:
            borrowParamType = typedExprBuildIndexCallParamType(
                index,
                paramStart + argIndex)
        if TypedExprCallArgumentHasExplicitBorrow(argTypes[argIndex]) &&
           !TypedExprCallArgumentHasExplicitBorrow(borrowParamType):
            return 0
    var boundNames: str[]
    var boundTypes: str[]
    if !TypedExprCallDeclarationBindTypes(index,
                                           rowIndex,
                                           argOwnerSourcePath,
                                           argTypes,
                                           explicitGenericTypes,
                                           explicitGenericPresent,
                                           boundNames,
                                           boundTypes):
        return 0
    var fixedParamCount: int32
    var variadicElementType: str
    let variadic = typedExprCallDeclarationVarargsInfo(index,
                                                       rowIndex,
                                                       fixedParamCount,
                                                       variadicElementType)
    var exact = true
    for argIndex in 0..<argTypes.len:
        var paramType = share(variadicElementType)
        if !variadic || argIndex < fixedParamCount:
            paramType = typedExprBuildIndexCallParamType(index,
                                                         paramStart + argIndex)
        # Exactness compares runtime type identity only. Borrow-ness is a
        # separate gate above (an explicitly borrowed argument never matches a
        # non-borrow parameter); folding it into exactness demotes every
        # concrete `var T[]` overload to the generic row's rank and manufactures
        # false ambiguity (seqs.Add(str[], str) vs Add(T[], T)).
        if !TypedExprCallTypeIdentityEqual(index,
                                            typedExprBuildIndexCallSourcePath(index,
                                                                              rowIndex),
                                            paramType,
                                            argOwnerSourcePath,
                                            argTypes[argIndex]):
            exact = false
            break
    if exact:
        return 2
    return 1

@borrows
fn TypedExprBuildIndexLookupCallDeclarationInSourceForArgOwner(
        index: TypedExprBuildIndex,
        sourcePathRaw: str,
        nameRaw: str,
        declarationKind: TypedExprCallDeclarationKind,
        argOwnerSourcePath: str,
        argTypes: str[],
                                                      explicitGenericTypes: str[],
                                                      explicitGenericPresent: bool,
                                                      rowIndexOut: var int32,
                                                      matchRankOut: var int32,
                                                      explicitContractMismatchOut: var bool): TypedExprBuildIndexLookupState =
    rowIndexOut = -1
    matchRankOut = 0
    explicitContractMismatchOut = false
    if index == nil || index.released:
        panic("typed expr: call declaration query on unavailable build index")
    if !index.callDeclarationSealed:
        panic("typed expr: call declaration query before seal")
    let sourcePath = parser.ParserNormalizePath(
        parser.ParserOwnedText(sourcePathRaw))
    let trimmedName = chengpath.PathTrim(parser.ParserOwnedText(nameRaw))
    var name = parser.ParserIdentPrefix(trimmedName)
    if name == "":
        name = trimmedName
    if sourcePath == "" || name == "":
        return TypedExprBuildIndexMissing
    for i in 0..<argTypes.len:
        if TypedExprCallDeclarationComparableType(argTypes[i]) == "":
            return TypedExprBuildIndexMissing
    var low: int32
    var high = index.callDeclarationSortedRows.len
    while low < high:
        let middle = low + (high - low) / 2
        let rowIndex = index.callDeclarationSortedRows[middle]
        if typedExprCallDeclarationRowOwnerNameCompare(index,
                                                       rowIndex,
                                                       sourcePath,
                                                       name) < 0:
            low = middle + 1
        else:
            high = middle
    let rangeStart = low
    high = index.callDeclarationSortedRows.len
    while low < high:
        let middle = low + (high - low) / 2
        let rowIndex = index.callDeclarationSortedRows[middle]
        if typedExprCallDeclarationRowOwnerNameCompare(index,
                                                       rowIndex,
                                                       sourcePath,
                                                       name) <= 0:
            low = middle + 1
        else:
            high = middle
    let rangeEnd = low
    var state = TypedExprBuildIndexMissing
    for sortedIndex in rangeStart..<rangeEnd:
        let rowIndex = index.callDeclarationSortedRows[sortedIndex]
        if index.callDeclarationKinds[rowIndex] != declarationKind:
            continue
        let rank = TypedExprCallDeclarationMatchRank(index,
                                                       rowIndex,
                                                       argOwnerSourcePath,
                                                       argTypes,
                                                       explicitGenericTypes,
                                                       explicitGenericPresent)
        if rank <= 0:
            if explicitGenericPresent:
                explicitContractMismatchOut = true
            continue
        if rank > matchRankOut:
            rowIndexOut = rowIndex
            matchRankOut = rank
            state = TypedExprBuildIndexUnique
            continue
        if rank == matchRankOut && rowIndexOut != rowIndex:
            state = TypedExprBuildIndexAmbiguous
    return state

# Public same-source query contract retained for backend semantic validation.
# Cross-source call resolution uses the owner-aware private entry above.
@borrows
fn TypedExprBuildIndexLookupCallDeclarationInSource(
        index: TypedExprBuildIndex,
        sourcePathRaw: str,
        nameRaw: str,
        declarationKind: TypedExprCallDeclarationKind,
        argTypes: str[],
        explicitGenericTypes: str[],
        explicitGenericPresent: bool,
        rowIndexOut: var int32,
        matchRankOut: var int32,
        explicitContractMismatchOut: var bool): TypedExprBuildIndexLookupState =
    return TypedExprBuildIndexLookupCallDeclarationInSourceForArgOwner(
        index,
        sourcePathRaw,
        nameRaw,
        declarationKind,
        sourcePathRaw,
        argTypes,
        explicitGenericTypes,
        explicitGenericPresent,
        rowIndexOut,
        matchRankOut,
        explicitContractMismatchOut)

@borrows
fn TypedExprCallDeclarationResolvedReturnTypeForArgOwner(
        index: TypedExprBuildIndex,
        rowIndex: int32,
        argOwnerSourcePath: str,
        argTypes: str[],
        explicitGenericTypes: str[],
        explicitGenericPresent: bool): str =
    var boundNames: str[]
    var boundTypes: str[]
    if !TypedExprCallDeclarationBindTypes(index,
                                           rowIndex,
                                           argOwnerSourcePath,
                                           argTypes,
                                           explicitGenericTypes,
                                           explicitGenericPresent,
                                           boundNames,
                                           boundTypes):
        panic("typed expr: selected call declaration no longer matches generic binding")
    return TypedExprSubstituteTypeParams(
                                         parser.ParserOwnedText(
                                             typedExprBuildIndexCallReturnType(
                                                 index, rowIndex)),
                                         boundNames,
                                         boundTypes)

@borrows
fn TypedExprCallDeclarationResolvedReturnType(
        index: TypedExprBuildIndex,
        rowIndex: int32,
        argTypes: str[],
        explicitGenericTypes: str[],
        explicitGenericPresent: bool): str =
    return TypedExprCallDeclarationResolvedReturnTypeForArgOwner(
        index,
        rowIndex,
        typedExprBuildIndexCallSourcePath(index, rowIndex),
        argTypes,
        explicitGenericTypes,
        explicitGenericPresent)

@borrows
fn TypedExprCallDeclarationResolvedParamTypeForArgOwner(
        index: TypedExprBuildIndex,
        rowIndex: int32,
        argOwnerSourcePath: str,
        argTypes: str[],
        explicitGenericTypes: str[],
        explicitGenericPresent: bool,
        argIndex: int32): str =
    if argIndex < 0 || argIndex >= argTypes.len:
        return ""
    var boundNames: str[]
    var boundTypes: str[]
    if !TypedExprCallDeclarationBindTypes(index,
                                           rowIndex,
                                           argOwnerSourcePath,
                                           argTypes,
                                           explicitGenericTypes,
                                           explicitGenericPresent,
                                           boundNames,
                                           boundTypes):
        panic("typed expr: selected call parameter no longer matches generic binding")
    var fixedParamCount: int32
    var variadicElementType: str
    let variadic = typedExprCallDeclarationVarargsInfo(index,
                                                       rowIndex,
                                                       fixedParamCount,
                                                       variadicElementType)
    var paramType = variadicElementType
    if !variadic || argIndex < fixedParamCount:
        paramType = typedExprBuildIndexCallParamType(
            index,
            index.callDeclarationParamStarts[rowIndex] + argIndex)
    return TypedExprSubstituteTypeParams(
        TypedExprCallRuntimeType(parser.ParserOwnedText(paramType)),
        boundNames,
        boundTypes)

@borrows
fn TypedExprCallDeclarationResolvedParamType(
        index: TypedExprBuildIndex,
        rowIndex: int32,
        argTypes: str[],
        explicitGenericTypes: str[],
        explicitGenericPresent: bool,
        argIndex: int32): str =
    return TypedExprCallDeclarationResolvedParamTypeForArgOwner(
        index,
        rowIndex,
        typedExprBuildIndexCallSourcePath(index, rowIndex),
        argTypes,
        explicitGenericTypes,
        explicitGenericPresent,
        argIndex)

@borrows
@borrow_result
fn TypedExprCallDeclarationParamType(index: TypedExprBuildIndex,
                                      rowIndex: int32,
                                      argIndex: int32): str =
    if index == nil || index.released || !index.callDeclarationSealed:
        panic("typed expr: call declaration parameter query on unavailable index")
    if rowIndex < 0 || rowIndex >= typedExprBuildIndexCallDeclarationCount(index):
        panic("typed expr: call declaration row out of bounds")
    let paramCount = index.callDeclarationParamCounts[rowIndex]
    if argIndex < 0 || argIndex >= paramCount:
        panic("typed expr: call declaration parameter index out of bounds")
    return typedExprBuildIndexCallParamType(
        index, index.callDeclarationParamStarts[rowIndex] + argIndex)

@borrows
fn TypedExprCallDeclarationVisibleFromImport(nameRaw: str): bool =
    let name = chengpath.PathTrim(parser.ParserOwnedText(nameRaw))
    if TypedExprSymbolExportedByCase(name):
        return true
    # Symbolic operator declarations have no identifier case and remain
    # eligible for static overload resolution across a direct import.
    return name != "" && parser.ParserIdentPrefix(name) == ""

fn TypedExprCallDeclarationKindAllowed(kindSet: TypedExprCallDeclarationKindSet,
                                       declarationKind: TypedExprCallDeclarationKind): bool =
    if kindSet == TypedExprCallDeclarationFunctionOrImportc:
        return true
    if kindSet == TypedExprCallDeclarationFunctionOnly:
        return declarationKind == TypedExprCallDeclarationFunction
    return declarationKind == TypedExprCallDeclarationImportc

@borrows
fn TypedExprResolveCallDeclarationKind(currentCtx: TypedExprSourceContext,
                                        qualifierRaw: str,
                                        nameRaw: str,
                                        declarationKind: TypedExprCallDeclarationKind,
                                        argTypes: str[],
                                        explicitGenericTypes: str[],
                                        explicitGenericPresent: bool,
                                        rowIndexOut: var int32,
                                        matchRankOut: var int32,
                                        explicitContractMismatchOut: var bool): TypedExprBuildIndexLookupState =
    rowIndexOut = -1
    matchRankOut = 0
    explicitContractMismatchOut = false
    let index = currentCtx.buildIndex
    let qualifier = chengpath.PathTrim(parser.ParserOwnedText(qualifierRaw))
    if qualifier != "":
        if TypedExprQualifiedCallDot(qualifier) >= 0 ||
           !TypedExprCallDeclarationVisibleFromImport(nameRaw):
            return TypedExprBuildIndexMissing
        let targetSourcePath = TypedExprLookupImportedModuleSourcePath(currentCtx, qualifier)
        if targetSourcePath == "":
            return TypedExprBuildIndexMissing
        return TypedExprBuildIndexLookupCallDeclarationInSourceForArgOwner(index,
                                                                 targetSourcePath,
                                                                 nameRaw,
                                                                 declarationKind,
                                                                 currentCtx.sourcePath,
                                                                 argTypes,
                                                                 explicitGenericTypes,
                                                                 explicitGenericPresent,
                                                                 rowIndexOut,
                                                                 matchRankOut,
                                                                 explicitContractMismatchOut)

    if !TypedExprCallDeclarationVisibleFromImport(nameRaw):
        return TypedExprBuildIndexMissing
    var bestRank: int32
    var bestRow: int32 = -1
    var anyExplicitMismatch = false
    for importIndex in 0..<TypedExprContextImportCount(currentCtx):
        # Parser import contract (parser: allowsUnqualifiedCall =
        # importAlias == ""): alias-import targets never join the unqualified
        # bare-name candidate face. Qualified-by-alias resolution is a
        # separate face and stays untouched.
        if !TypedExprContextImportAllowsUnqualifiedCallAt(currentCtx, importIndex):
            continue
        let importedSourcePath = parser.ParserNormalizePath(
            parser.ParserOwnedText(TypedExprContextImportTargetAt(
                currentCtx, importIndex)))
        var importedRow: int32
        var importedRank: int32
        var importedExplicitMismatch = false
        let importedState = TypedExprBuildIndexLookupCallDeclarationInSourceForArgOwner(index,
                                                                              importedSourcePath,
                                                                              nameRaw,
                                                                              declarationKind,
                                                                              currentCtx.sourcePath,
                                                                              argTypes,
                                                                              explicitGenericTypes,
                                                                              explicitGenericPresent,
                                                                              importedRow,
                                                                              importedRank,
                                                                              importedExplicitMismatch)
        if importedExplicitMismatch:
            anyExplicitMismatch = true
        if importedState == TypedExprBuildIndexAmbiguous:
            return TypedExprBuildIndexAmbiguous
        if importedState != TypedExprBuildIndexUnique:
            continue
        if importedRank > bestRank:
            bestRank = importedRank
            bestRow = importedRow
            continue
        if importedRank == bestRank && bestRow != importedRow:
            return TypedExprBuildIndexAmbiguous
    if bestRow < 0:
        explicitContractMismatchOut = anyExplicitMismatch
        return TypedExprBuildIndexMissing
    rowIndexOut = bestRow
    matchRankOut = bestRank
    return TypedExprBuildIndexUnique

@borrows
fn TypedExprResolveCallDeclarationWithExplicit(
        currentCtx: TypedExprSourceContext,
        qualifierRaw: str,
        nameRaw: str,
        argTypesRaw: str[],
        explicitGenericTypesRaw: str[],
        explicitGenericPresent: bool,
        kindSet: TypedExprCallDeclarationKindSet,
        sourcePathOut: var str,
        returnTypeOut: var str,
        targetSymbolOut: var str,
        importcOut: var bool,
        rowIndexOut: var int32,
        explicitContractMismatchOut: var bool): TypedExprBuildIndexLookupState =
    sourcePathOut = ""
    returnTypeOut = ""
    targetSymbolOut = ""
    importcOut = false
    rowIndexOut = -1
    explicitContractMismatchOut = false
    let index = currentCtx.buildIndex
    if index == nil || index.released || !index.callDeclarationSealed:
        panic("typed expr: structured call declaration index unavailable")
    var argTypes: str[]
    for i in 0..<argTypesRaw.len:
        let argType = TypedExprNormalizeTypeText(argTypesRaw[i])
        if TypedExprCallDeclarationComparableType(argType) == "":
            return TypedExprBuildIndexMissing
        add(argTypes, argType)
    var explicitGenericTypes: str[]
    for genericIndex in 0..<explicitGenericTypesRaw.len:
        let genericType = TypedExprNormalizeTypeText(
            explicitGenericTypesRaw[genericIndex])
        if genericType == "" || genericType == "unknown":
            explicitContractMismatchOut = explicitGenericPresent
            return TypedExprBuildIndexMissing
        add(explicitGenericTypes, genericType)
    if !explicitGenericPresent && explicitGenericTypes.len != 0:
        panic("typed expr: explicit generic payload without presence flag")
    var rowIndex: int32
    var matchRank: int32
    var state = TypedExprBuildIndexMissing
    var explicitMismatch = false
    let qualifier = chengpath.PathTrim(qualifierRaw)
    if qualifier == "":
        let currentSourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
        if TypedExprCallDeclarationKindAllowed(kindSet, TypedExprCallDeclarationFunction):
            state = TypedExprBuildIndexLookupCallDeclarationInSourceForArgOwner(index,
                                                                     currentSourcePath,
                                                                     nameRaw,
                                                                     TypedExprCallDeclarationFunction,
                                                                     currentCtx.sourcePath,
                                                                     argTypes,
                                                                     explicitGenericTypes,
                                                                     explicitGenericPresent,
                                                                     rowIndex,
                                                                     matchRank,
                                                                     explicitMismatch)
            if state == TypedExprBuildIndexMissing && explicitMismatch:
                explicitContractMismatchOut = true
                return state
        if state == TypedExprBuildIndexMissing &&
           TypedExprCallDeclarationKindAllowed(kindSet, TypedExprCallDeclarationImportc):
            explicitMismatch = false
            state = TypedExprBuildIndexLookupCallDeclarationInSourceForArgOwner(index,
                                                                     currentSourcePath,
                                                                     nameRaw,
                                                                     TypedExprCallDeclarationImportc,
                                                                     currentCtx.sourcePath,
                                                                     argTypes,
                                                                     explicitGenericTypes,
                                                                     explicitGenericPresent,
                                                                     rowIndex,
                                                                     matchRank,
                                                                     explicitMismatch)
            if state == TypedExprBuildIndexMissing && explicitMismatch:
                explicitContractMismatchOut = true
                return state
    # Keep lexical precedence: declarations in the current source win. Only a
    # complete local miss opens direct-import visibility.
    if state == TypedExprBuildIndexMissing &&
       TypedExprCallDeclarationKindAllowed(kindSet, TypedExprCallDeclarationFunction):
        explicitMismatch = false
        state = TypedExprResolveCallDeclarationKind(currentCtx,
                                                    qualifierRaw,
                                                    nameRaw,
                                                    TypedExprCallDeclarationFunction,
                                                    argTypes,
                                                    explicitGenericTypes,
                                                    explicitGenericPresent,
                                                    rowIndex,
                                                    matchRank,
                                                    explicitMismatch)
        if state == TypedExprBuildIndexMissing && explicitMismatch:
            explicitContractMismatchOut = true
            return state
    # Function and importc declarations are distinct domains within the same
    # lexical tier. A function match prevents a cross-kind false ambiguity; only
    # a miss in that domain opens importc declarations in the same tier.
    if state == TypedExprBuildIndexMissing &&
       TypedExprCallDeclarationKindAllowed(kindSet, TypedExprCallDeclarationImportc):
        explicitMismatch = false
        state = TypedExprResolveCallDeclarationKind(currentCtx,
                                                    qualifierRaw,
                                                    nameRaw,
                                                    TypedExprCallDeclarationImportc,
                                                    argTypes,
                                                    explicitGenericTypes,
                                                    explicitGenericPresent,
                                                    rowIndex,
                                                    matchRank,
                                                    explicitMismatch)
        if state == TypedExprBuildIndexMissing && explicitMismatch:
            explicitContractMismatchOut = true
            return state
    if state != TypedExprBuildIndexUnique:
        return state
    sourcePathOut = parser.ParserOwnedText(
        typedExprBuildIndexCallSourcePath(index, rowIndex))
    returnTypeOut = TypedExprCallDeclarationResolvedReturnTypeForArgOwner(
        index,
        rowIndex,
        currentCtx.sourcePath,
        argTypes,
        explicitGenericTypes,
        explicitGenericPresent)
    targetSymbolOut = parser.ParserOwnedText(
        typedExprBuildIndexCallTargetSymbol(index, rowIndex))
    importcOut = index.callDeclarationKinds[rowIndex] == TypedExprCallDeclarationImportc
    rowIndexOut = rowIndex
    return TypedExprBuildIndexUnique

@borrows
fn TypedExprResolveCallDeclaration(currentCtx: TypedExprSourceContext,
                                    qualifierRaw: str,
                                    nameRaw: str,
                                    argTypesRaw: str[],
                                    kindSet: TypedExprCallDeclarationKindSet,
                                    sourcePathOut: var str,
                                    returnTypeOut: var str,
                                    targetSymbolOut: var str,
                                    importcOut: var bool,
                                    rowIndexOut: var int32): TypedExprBuildIndexLookupState =
    var explicitGenericTypes: str[]
    var explicitContractMismatch = false
    return TypedExprResolveCallDeclarationWithExplicit(currentCtx,
                                                        qualifierRaw,
                                                        nameRaw,
                                                        argTypesRaw,
                                                        explicitGenericTypes,
                                                        false,
                                                        kindSet,
                                                        sourcePathOut,
                                                        returnTypeOut,
                                                        targetSymbolOut,
                                                        importcOut,
                                                        rowIndexOut,
                                                        explicitContractMismatch)

@borrows
fn typedExprCloneI32ColRec(dst: var int32[], src: int32[], i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, src[i])
        i = i + 1
        continue

@borrows
fn typedExprCloneStrColRec(dst: var str[], src: str[], i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, strings.CloneStr(src[i]))
        i = i + 1
        continue

@borrows
fn typedExprCloneInternIdColRec(dst: var langintern.InternId[],
                                src: langintern.InternId[],
                                i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, src[i])
        i = i + 1
        continue

@borrows
fn typedExprCloneLookupStateColRec(
        dst: var TypedExprBuildIndexLookupState[],
        src: TypedExprBuildIndexLookupState[],
        i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, src[i])
        i = i + 1
        continue

@borrows
fn typedExprCloneCallDeclKindColRec(
        dst: var TypedExprCallDeclarationKind[],
        src: TypedExprCallDeclarationKind[],
        i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, src[i])
        i = i + 1
        continue

@borrows
fn typedExprCloneExprClassColRec(
        dst: var TypedExprExprClass[],
        src: TypedExprExprClass[],
        i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, src[i])
        i = i + 1
        continue

@borrows
fn typedExprCloneBoolColRec(dst: var bool[], src: bool[], i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, src[i])
        i = i + 1
        continue

@borrows
fn typedExprCloneFixedBytes32ColRec(
        dst: var layout.FixedBytes32[],
        src: layout.FixedBytes32[],
        i: int32) =
    while true:
        if i >= src.len:
            return
        add(dst, layout.FixedBytes32Copy(src[i]))
        i = i + 1
        continue

@borrows
fn typedExprCloneI32ZerosRec(dst: var int32[], count: int32, i: int32) =
    while true:
        if i >= count:
            return
        add(dst, 0)
        i = i + 1
        continue

@borrows
fn typedExprFrozenClaimedFalseRec(dst: var bool[], count: int32, i: int32) =
    while true:
        if i >= count:
            return
        add(dst, false)
        i = i + 1
        continue

@borrows
fn typedExprCloneLayoutRowsRec(out: TypedExprBuildIndex,
                               index: TypedExprBuildIndex,
                               i: int32) =
    while true:
        if i >= index.layoutSourcePaths.len:
            return
        if index.layoutStates[i] == 1:
            panic("typed expr: cannot clone build index during layout computation")
        add(out.layoutNext, index.layoutNext[i])
        add(out.layoutHashes, index.layoutHashes[i])
        add(out.layoutSourcePaths, strings.CloneStr(index.layoutSourcePaths[i]))
        add(out.layoutTypeNames, strings.CloneStr(index.layoutTypeNames[i]))
        add(out.layoutStates, index.layoutStates[i])
        add(out.layoutSizeBytes, index.layoutSizeBytes[i])
        add(out.layoutAlignBytes, index.layoutAlignBytes[i])
        if index.layoutSourcePathIds.len > 0:
            add(out.layoutSourcePathIds, index.layoutSourcePathIds[i])
            add(out.layoutTypeNameIds, index.layoutTypeNameIds[i])
        i = i + 1
        continue

@borrows
fn TypedExprBuildIndexClone(index: TypedExprBuildIndex): TypedExprBuildIndex =
    if index == nil || index.released:
        return nil
    if index.permanentlySealed:
        panic("typed expr: canonical sealed build index cannot be cloned")
    if index.canonicalProjection != nil &&
       (index.entryKindIds.len != index.entryKinds.len ||
        index.entrySourcePathIds.len != index.entryKinds.len ||
        index.entryNameIds.len != index.entryKinds.len ||
        index.entryDetailIds.len != index.entryKinds.len ||
        index.entryOriginIds.len != index.entryKinds.len ||
        index.entryFingerprintIds.len != index.entryKinds.len ||
        index.fieldOwnerSourcePathIds.len !=
            index.fieldOwnerSourcePaths.len ||
        index.fieldOwnerTypeIds.len != index.fieldOwnerSourcePaths.len ||
        index.layoutSourcePathIds.len != index.layoutSourcePaths.len ||
        index.layoutTypeNameIds.len != index.layoutSourcePaths.len):
        panic("typed expr: corrupt canonical-borrowed build index clone source")
    let callDeclarationCount = index.callDeclarationSourcePaths.len
    if callDeclarationCount != index.callDeclarationNames.len ||
       callDeclarationCount != index.callDeclarationArities.len ||
       callDeclarationCount != index.callDeclarationGenericStarts.len ||
       callDeclarationCount != index.callDeclarationGenericCounts.len ||
       callDeclarationCount != index.callDeclarationParamStarts.len ||
       callDeclarationCount != index.callDeclarationParamCounts.len ||
       callDeclarationCount != index.callDeclarationReturnTypes.len ||
       callDeclarationCount != index.callDeclarationTargetSymbols.len ||
       callDeclarationCount != index.callDeclarationSignatureLineNumbers.len ||
       callDeclarationCount != index.callDeclarationKinds.len ||
       callDeclarationCount != index.callDeclarationResultExprClasses.len ||
       callDeclarationCount !=
           index.callDeclarationProducerSourceIndexes.len ||
       callDeclarationCount !=
           index.callDeclarationProducerDeclarationOrdinals.len ||
       callDeclarationCount !=
           index.callDeclarationProducerFunctionRows.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumePresents.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeFunctionDeclarationRows.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeTargetParameterOrdinals.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeSourceParameterOrdinals.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeTargetParameterDeclarationRows.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeSourceParameterDeclarationRows.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeTargetTypeIds.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeSourceTypeIds.len ||
       callDeclarationCount !=
           index.callDeclarationManualConsumeEffectCids.len ||
       callDeclarationCount != index.callDeclarationSortedRows.len:
        panic(Fmt"typed expr: corrupt build index call declaration columns rows={callDeclarationCount} names={index.callDeclarationNames.len} arities={index.callDeclarationArities.len} generic_starts={index.callDeclarationGenericStarts.len} generic_counts={index.callDeclarationGenericCounts.len} param_starts={index.callDeclarationParamStarts.len} param_counts={index.callDeclarationParamCounts.len} returns={index.callDeclarationReturnTypes.len} targets={index.callDeclarationTargetSymbols.len} signature_lines={index.callDeclarationSignatureLineNumbers.len} kinds={index.callDeclarationKinds.len} result_classes={index.callDeclarationResultExprClasses.len} producer_sources={index.callDeclarationProducerSourceIndexes.len} producer_declaration_ordinals={index.callDeclarationProducerDeclarationOrdinals.len} sorted={index.callDeclarationSortedRows.len}")
    let entryCount = index.entryKinds.len
    if entryCount != index.entryStates.len ||
       entryCount != index.entrySourcePaths.len ||
       entryCount != index.entryNames.len ||
       entryCount != index.entryDetails.len ||
       entryCount != index.entryNext.len ||
       entryCount != index.entryHashes.len ||
       entryCount != index.entryValueIndexes.len ||
       entryCount != index.entryOrigins.len ||
       entryCount != index.entryFingerprints.len ||
       entryCount != index.entryValidationMarks.len:
        panic(Fmt"typed expr: corrupt build index entry columns rows={entryCount} states={index.entryStates.len} sources={index.entrySourcePaths.len} names={index.entryNames.len} details={index.entryDetails.len} next={index.entryNext.len} hashes={index.entryHashes.len} values={index.entryValueIndexes.len} origins={index.entryOrigins.len} fingerprints={index.entryFingerprints.len} validation={index.entryValidationMarks.len}")
    let visibilityCount = index.visibilityKinds.len
    if visibilityCount != index.visibilitySourcePaths.len ||
       visibilityCount != index.visibilityNames.len ||
       visibilityCount != index.visibilityDetails.len ||
       visibilityCount != index.visibilityNext.len ||
       visibilityCount != index.visibilityHashes.len ||
       visibilityCount != index.visibilityValueIndexes.len ||
       visibilityCount != index.visibilityFingerprints.len:
        panic(Fmt"typed expr: corrupt build index visibility columns rows={visibilityCount} sources={index.visibilitySourcePaths.len} names={index.visibilityNames.len} details={index.visibilityDetails.len} next={index.visibilityNext.len} hashes={index.visibilityHashes.len} values={index.visibilityValueIndexes.len} fingerprints={index.visibilityFingerprints.len}")
    let importOwnerCount = index.importOwnerSourcePaths.len
    if importOwnerCount != index.importOwnerNext.len ||
       importOwnerCount != index.importOwnerHashes.len ||
       importOwnerCount != index.importOwnerTargetHeads.len ||
       index.importTargetNext.len != index.importTargetEntryIndexes.len ||
       index.importTargetNext.len != index.visibilityEdgeCount:
        panic(Fmt"typed expr: corrupt build index import columns owners={importOwnerCount} owner_next={index.importOwnerNext.len} owner_hashes={index.importOwnerHashes.len} owner_targets={index.importOwnerTargetHeads.len} target_next={index.importTargetNext.len} target_entries={index.importTargetEntryIndexes.len} visibility_edges={index.visibilityEdgeCount}")
    let visibilityQueryCount = index.visibilityQueryKinds.len
    if visibilityQueryCount != index.visibilityQueryOwnerSourcePaths.len ||
       visibilityQueryCount != index.visibilityQueryNames.len ||
       visibilityQueryCount != index.visibilityQueryDetails.len ||
       visibilityQueryCount != index.visibilityQueryNext.len ||
       visibilityQueryCount != index.visibilityQueryHashes.len ||
       visibilityQueryCount != index.visibilityQueryStates.len ||
       visibilityQueryCount != index.visibilityQueryValueIndexes.len ||
       visibilityQueryCount != index.visibilityQueryFingerprints.len:
        panic(Fmt"typed expr: corrupt build index visibility query columns rows={visibilityQueryCount} owners={index.visibilityQueryOwnerSourcePaths.len} names={index.visibilityQueryNames.len} details={index.visibilityQueryDetails.len} next={index.visibilityQueryNext.len} hashes={index.visibilityQueryHashes.len} states={index.visibilityQueryStates.len} values={index.visibilityQueryValueIndexes.len} fingerprints={index.visibilityQueryFingerprints.len}")
    let contentCacheCount = index.contentCacheKinds.len
    if contentCacheCount != index.contentCacheSourcePaths.len ||
       contentCacheCount != index.contentCacheNames.len ||
       contentCacheCount != index.contentCacheValues.len ||
       contentCacheCount != index.contentCacheNext.len ||
       contentCacheCount != index.contentCacheHashes.len:
        panic(Fmt"typed expr: corrupt build index content cache columns rows={contentCacheCount} sources={index.contentCacheSourcePaths.len} names={index.contentCacheNames.len} values={index.contentCacheValues.len} next={index.contentCacheNext.len} hashes={index.contentCacheHashes.len}")
    let contextFieldOwnerCount = index.contextFieldOwnerSourcePaths.len
    let contextFieldNodeCount = index.contextFieldNodeNext.len
    let expectedContextDomainCount = index.canonicalMetadataTransferred ?
        0 : typedExprContextDomainColumnCount(index.contextSourcePaths.len)
    if index.contextMetadataDomainCounts.len != expectedContextDomainCount ||
       (index.canonicalMetadataTransferred &&
        (index.canonicalProjection != nil || index.compactCanonical ||
         index.contextSourcePaths.len != index.contextCount)) ||
       contextFieldOwnerCount != index.contextFieldOwnerTypes.len ||
       contextFieldOwnerCount != index.contextFieldOwnerHeads.len ||
       contextFieldOwnerCount != index.contextFieldOwnerTails.len ||
       contextFieldOwnerCount != index.contextFieldOwnerNext.len ||
       contextFieldOwnerCount != index.contextFieldOwnerHashes.len ||
       contextFieldNodeCount != index.contextFieldNodeContextIndexes.len ||
       contextFieldNodeCount != index.contextFieldNodeRowIndexes.len ||
       contextFieldNodeCount != index.contextFieldNodeDeclaredOffsetBytes.len ||
       contextFieldNodeCount != index.contextFieldNodeDeclaredSizeBytes.len ||
       contextFieldNodeCount != index.contextFieldNodeDeclaredAlignBytes.len ||
       contextFieldNodeCount != index.contextFieldNodeOffsetBytes.len ||
       contextFieldNodeCount != index.contextFieldNodeSizeBytes.len ||
       contextFieldNodeCount != index.contextFieldNodeAlignBytes.len ||
       contextFieldNodeCount != index.contextFieldNodeLayoutReady.len:
        panic(Fmt"typed expr: corrupt build index context field columns transferred={index.canonicalMetadataTransferred} contexts={index.contextSourcePaths.len}/{index.contextCount} domains={index.contextMetadataDomainCounts.len}/{expectedContextDomainCount} owners={contextFieldOwnerCount} owner_types={index.contextFieldOwnerTypes.len} owner_heads={index.contextFieldOwnerHeads.len} owner_tails={index.contextFieldOwnerTails.len} owner_next={index.contextFieldOwnerNext.len} owner_hashes={index.contextFieldOwnerHashes.len} nodes={contextFieldNodeCount} node_contexts={index.contextFieldNodeContextIndexes.len} node_rows={index.contextFieldNodeRowIndexes.len} declared_offsets={index.contextFieldNodeDeclaredOffsetBytes.len} declared_sizes={index.contextFieldNodeDeclaredSizeBytes.len} declared_aligns={index.contextFieldNodeDeclaredAlignBytes.len} offsets={index.contextFieldNodeOffsetBytes.len} sizes={index.contextFieldNodeSizeBytes.len} aligns={index.contextFieldNodeAlignBytes.len} ready={index.contextFieldNodeLayoutReady.len}")
    let fieldOwnerCount = index.fieldOwnerSourcePaths.len
    let layoutCount = index.layoutSourcePaths.len
    if fieldOwnerCount != index.fieldOwnerTypes.len ||
       fieldOwnerCount != index.fieldOwnerHeads.len ||
       fieldOwnerCount != index.fieldOwnerTails.len ||
       fieldOwnerCount != index.fieldOwnerNext.len ||
       fieldOwnerCount != index.fieldOwnerHashes.len ||
       layoutCount != index.layoutTypeNames.len ||
       layoutCount != index.layoutStates.len ||
       layoutCount != index.layoutSizeBytes.len ||
       layoutCount != index.layoutAlignBytes.len ||
       layoutCount != index.layoutNext.len ||
       layoutCount != index.layoutHashes.len:
        panic(Fmt"typed expr: corrupt build index field/layout columns field_owners={fieldOwnerCount} field_types={index.fieldOwnerTypes.len} field_heads={index.fieldOwnerHeads.len} field_tails={index.fieldOwnerTails.len} field_next={index.fieldOwnerNext.len} field_hashes={index.fieldOwnerHashes.len} layouts={layoutCount} layout_types={index.layoutTypeNames.len} layout_states={index.layoutStates.len} layout_sizes={index.layoutSizeBytes.len} layout_aligns={index.layoutAlignBytes.len} layout_next={index.layoutNext.len} layout_hashes={index.layoutHashes.len}")
    let cloneRows = typedExprCheckedAdd64(Int64(index.entryKinds.len),
                                          Int64(index.visibilityKinds.len),
                                          "build_index_clone_rows")
    let out = TypedExprBuildIndexNew(typedExprCheckedInt32Capacity(
        typedExprCheckedAdd64(cloneRows, 8, "build_index_clone_rows"),
        "build_index_clone_rows"))
    out.canonicalProjection = index.canonicalProjection
    out.entryBucketHeads = []
    typedExprCloneI32ColRec(out.entryBucketHeads, index.entryBucketHeads, 0)
    typedExprCloneI32ColRec(out.entryNext, index.entryNext, 0)
    typedExprCloneI32ColRec(out.entryHashes, index.entryHashes, 0)
    typedExprCloneStrColRec(out.entryKinds, index.entryKinds, 0)
    typedExprCloneStrColRec(out.entrySourcePaths, index.entrySourcePaths, 0)
    typedExprCloneStrColRec(out.entryNames, index.entryNames, 0)
    typedExprCloneStrColRec(out.entryDetails, index.entryDetails, 0)
    typedExprCloneLookupStateColRec(out.entryStates, index.entryStates, 0)
    typedExprCloneI32ColRec(out.entryValueIndexes, index.entryValueIndexes, 0)
    typedExprCloneStrColRec(out.entryOrigins, index.entryOrigins, 0)
    typedExprCloneStrColRec(out.entryFingerprints, index.entryFingerprints, 0)
    typedExprCloneI32ZerosRec(out.entryValidationMarks, index.entryKinds.len, 0)
    if index.entryKindIds.len > 0:
        typedExprCloneInternIdColRec(out.entryKindIds, index.entryKindIds, 0)
        typedExprCloneInternIdColRec(out.entrySourcePathIds, index.entrySourcePathIds, 0)
        typedExprCloneInternIdColRec(out.entryNameIds, index.entryNameIds, 0)
        typedExprCloneInternIdColRec(out.entryDetailIds, index.entryDetailIds, 0)
        typedExprCloneInternIdColRec(out.entryOriginIds, index.entryOriginIds, 0)
        typedExprCloneInternIdColRec(out.entryFingerprintIds, index.entryFingerprintIds, 0)
    out.visibilityBucketHeads = []
    typedExprCloneI32ColRec(out.visibilityBucketHeads, index.visibilityBucketHeads, 0)
    typedExprCloneI32ColRec(out.visibilityNext, index.visibilityNext, 0)
    typedExprCloneI32ColRec(out.visibilityHashes, index.visibilityHashes, 0)
    typedExprCloneStrColRec(out.visibilityKinds, index.visibilityKinds, 0)
    typedExprCloneStrColRec(out.visibilitySourcePaths, index.visibilitySourcePaths, 0)
    typedExprCloneStrColRec(out.visibilityNames, index.visibilityNames, 0)
    typedExprCloneStrColRec(out.visibilityDetails, index.visibilityDetails, 0)
    typedExprCloneI32ColRec(out.visibilityValueIndexes, index.visibilityValueIndexes, 0)
    typedExprCloneStrColRec(out.visibilityFingerprints, index.visibilityFingerprints, 0)
    out.importOwnerBucketHeads = []
    typedExprCloneI32ColRec(out.importOwnerBucketHeads, index.importOwnerBucketHeads, 0)
    typedExprCloneI32ColRec(out.importOwnerNext, index.importOwnerNext, 0)
    typedExprCloneI32ColRec(out.importOwnerHashes, index.importOwnerHashes, 0)
    typedExprCloneStrColRec(out.importOwnerSourcePaths, index.importOwnerSourcePaths, 0)
    typedExprCloneI32ColRec(out.importOwnerTargetHeads, index.importOwnerTargetHeads, 0)
    typedExprCloneI32ColRec(out.importTargetNext, index.importTargetNext, 0)
    typedExprCloneI32ColRec(out.importTargetEntryIndexes, index.importTargetEntryIndexes, 0)
    out.visibilityQueryBucketHeads = []
    typedExprCloneI32ColRec(out.visibilityQueryBucketHeads, index.visibilityQueryBucketHeads, 0)
    typedExprCloneI32ColRec(out.visibilityQueryNext, index.visibilityQueryNext, 0)
    typedExprCloneI32ColRec(out.visibilityQueryHashes, index.visibilityQueryHashes, 0)
    typedExprCloneStrColRec(out.visibilityQueryOwnerSourcePaths, index.visibilityQueryOwnerSourcePaths, 0)
    typedExprCloneLookupStateColRec(out.visibilityQueryStates, index.visibilityQueryStates, 0)
    typedExprCloneStrColRec(out.visibilityQueryKinds, index.visibilityQueryKinds, 0)
    typedExprCloneStrColRec(out.visibilityQueryNames, index.visibilityQueryNames, 0)
    typedExprCloneStrColRec(out.visibilityQueryDetails, index.visibilityQueryDetails, 0)
