fn typedExprCanonicalDigestStep(first: var int64,
                                second: var int64,
                                valueRaw: int64) =
    var value = valueRaw % 2147483629
    if value < 0:
        value = value + 2147483629
    first = (first * 1000003 + value + 17) % 2147483647
    second = (second * 1000033 + value + 31) % 2147483629

@borrows
fn typedExprCanonicalDigestText(first: var int64,
                                second: var int64,
                                value: str) =
    typedExprCanonicalDigestStep(first, second, Int64(value.len))
    for byteIndex in 0..<value.len:
        typedExprCanonicalDigestStep(first, second,
                                     Int64(int32(value[byteIndex])))

@borrows
fn typedExprCanonicalDigestInts(first: var int64,
                                second: var int64,
                                values: int32[]) =
    typedExprCanonicalDigestStep(first, second, Int64(values.len))
    for valueIndex in 0..<values.len:
        typedExprCanonicalDigestStep(first, second,
                                     Int64(values[valueIndex]))

@borrows
fn typedExprCanonicalDigestBools(first: var int64,
                                 second: var int64,
                                 values: bool[]) =
    typedExprCanonicalDigestStep(first, second, Int64(values.len))
    for valueIndex in 0..<values.len:
        typedExprCanonicalDigestStep(first, second,
                                     values[valueIndex] ? 1 : 0)

@borrows
fn typedExprCanonicalDigestFixedBytes32s(
        first: var int64,
        second: var int64,
        values: layout.FixedBytes32[]) =
    typedExprCanonicalDigestStep(first, second, Int64(values.len))
    for valueIndex in 0..<values.len:
        for byteIndex in 0..<layout.FixedBytes32Size:
            typedExprCanonicalDigestStep(
                first,
                second,
                Int64(values[valueIndex].data[byteIndex]))

@borrows
fn typedExprCanonicalDigestTexts(first: var int64,
                                 second: var int64,
                                 values: str[]) =
    typedExprCanonicalDigestStep(first, second, Int64(values.len))
    for valueIndex in 0..<values.len:
        typedExprCanonicalDigestText(first, second, values[valueIndex])

@borrows
fn typedExprCanonicalDigestScope(first: var int64,
                                 second: var int64,
                                 rows: typedExprFrozenScopeSoA) =
    typedExprCanonicalDigestInts(first, second, rows.contextStarts)
    typedExprCanonicalDigestInts(first, second, rows.contextCounts)
    typedExprCanonicalDigestInts(first, second, rows.nameIds)
