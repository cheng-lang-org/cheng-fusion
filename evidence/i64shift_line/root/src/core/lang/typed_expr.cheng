        first, second, rows.manualConsumePresents)
    typedExprCanonicalDigestInts(
        first, second, rows.manualConsumeFunctionDeclarationRows)
    typedExprCanonicalDigestInts(
        first, second, rows.manualConsumeTargetParameterOrdinals)
    typedExprCanonicalDigestInts(
        first, second, rows.manualConsumeSourceParameterOrdinals)
    typedExprCanonicalDigestInts(
