fn TypedExprClearSourceTextAllFields(source: var TypedExprSourceText) =
    source.workspaceRoot = ""
    source.packageRoot = ""
    source.packageId = ""
    source.packageChannel = ""
    source.externalPackageRoots = []
    source.sourcePath = ""
    source.text = ""
    source.textLoaded = false
    source.snapshotOnly = false
    source.migrationSourceSyntax = false

fn TypedExprSourceIdentityIsSeparator(value: char): bool =
    return value == '/' || value == '\\'

@borrows
fn TypedExprLexicalSourcePath(pathRaw: str,
                              out: var str,
                              err: var str): bool =
    out = ""
    if pathRaw == "":
        err = " typed expr: source identity path missing"
        return false
    let absolute = TypedExprSourceIdentityIsSeparator(pathRaw[0])
    var parts: str[]
    var cursor: int32
    while cursor < pathRaw.len:
        while cursor < pathRaw.len && TypedExprSourceIdentityIsSeparator(pathRaw[cursor]):
            cursor = cursor + 1
        if cursor >= pathRaw.len:
            break
        let partStart = cursor
        while cursor < pathRaw.len && !TypedExprSourceIdentityIsSeparator(pathRaw[cursor]):
            cursor = cursor + 1
        let part = chengpath.TextSlice(pathRaw, partStart, cursor - partStart)
        if part == "" || part == ".":
            continue
        if part == "..":
            if parts.len <= 0:
                err = Fmt" typed expr: source identity escapes root path={pathRaw}"
                return false
            setLen(parts, parts.len - 1)
            continue
        add(parts, part)
    let joined = strutil.Join(parts, "/")
    if absolute:
        if joined == "":
            out = strings.CloneStr("/")
        else:
            out = strings.CloneStr(strutil.Join(["/", joined], ""))
    else:
        out = strings.CloneStr(joined)
    if out == "":
        err = Fmt" typed expr: source identity path empty after normalization path={pathRaw}"
        return false
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityPathWithinRoot(path: str, root: str): bool =
    if path == root:
        return true
    if root == "/":
        return path.len > 0 && path[0] == '/'
    if path.len <= root.len || path[root.len] != '/':
        return false
    for i in 0..<root.len:
        if path[i] != root[i]:
            return false
    return true

@borrows
fn TypedExprSourceIdentityAppendRoot(roots: var str[],
                                     rootRaw: str,
                                     err: var str): bool =
    if rootRaw == "":
        return true
    var root: str
    if !TypedExprLexicalSourcePath(rootRaw, root, err):
        return false
    if root[0] != '/':
        err = Fmt" typed expr: source identity root is not absolute root={rootRaw} normalized={root}"
        return false
    for i in 0..<roots.len:
        if roots[i] == root:
            return true
    add(roots, root)
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityRoots(workspaceRoot: str,
                                packageRoot: str,
                                externalPackageRoots: parser.ParserExternalPackageRoot[],
                                roots: var str[],
                                err: var str): bool =
    roots = []
    if !TypedExprSourceIdentityAppendRoot(roots, workspaceRoot, err):
        return false
    if !TypedExprSourceIdentityAppendRoot(roots, packageRoot, err):
        return false
    for i in 0..<externalPackageRoots.len:
        if !TypedExprSourceIdentityAppendRoot(roots,
                                              externalPackageRoots[i].packageRoot,
                                              err):
            return false
    if roots.len <= 0:
        err = " typed expr: source identity roots missing"
        return false
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityKeyFromRoots(roots: str[],
                                       relativeRootRaw: str,
                                       sourcePathRaw: str,
                                       out: var str,
                                       err: var str): bool =
    var sourcePath: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, err):
        return false
    if sourcePath[0] == '/':
        var withinKnownRoot = false
        for i in 0..<roots.len:
            if TypedExprSourceIdentityPathWithinRoot(sourcePath, roots[i]):
                withinKnownRoot = true
        if !withinKnownRoot:
            err = Fmt" typed expr: source identity outside known roots source={sourcePath} root_count={roots.len}"
            return false
        out = sourcePath
        err = ""
        return true
    var relativeRoot: str
    if !TypedExprLexicalSourcePath(relativeRootRaw, relativeRoot, err):
        return false
    var relativeRootKnown = false
    for i in 0..<roots.len:
        if roots[i] == relativeRoot:
            relativeRootKnown = true
    if !relativeRootKnown:
        err = Fmt" typed expr: source identity relative root unknown root={relativeRoot} source={sourcePath}"
        return false
    let ownedSourcePath = parser.ParserOwnedText(sourcePath)
    if relativeRoot == "/":
        out = parser.ParserConcat2("/", ownedSourcePath)
    else:
        let ownedRelativeRoot = parser.ParserOwnedText(relativeRoot)
        out = parser.ParserConcat3(ownedRelativeRoot, "/", ownedSourcePath)
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityKeyUnderRoot(roots: str[],
                                       selectedRootRaw: str,
                                       sourcePathRaw: str,
                                       out: var str,
                                       err: var str): bool =
    var selectedRoot: str
    if !TypedExprLexicalSourcePath(selectedRootRaw, selectedRoot, err):
        return false
    var knownRoot = false
    for i in 0..<roots.len:
        if roots[i] == selectedRoot:
            knownRoot = true
            break
    if !knownRoot:
        err = Fmt" typed expr: source identity selected root unknown root={selectedRoot}"
        return false
    var sourcePath: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, err):
        return false
    if sourcePath[0] == '/':
        if !TypedExprSourceIdentityPathWithinRoot(sourcePath, selectedRoot):
            err = Fmt" typed expr: source identity absolute path outside selected root source={sourcePath} root={selectedRoot}"
            return false
        out = sourcePath
        err = ""
        return true
    let ownedSourcePath = parser.ParserOwnedText(sourcePath)
    if selectedRoot == "/":
        out = parser.ParserConcat2("/", ownedSourcePath)
    else:
        let ownedSelectedRoot = parser.ParserOwnedText(selectedRoot)
        out = parser.ParserConcat3(ownedSelectedRoot, "/", ownedSourcePath)
    err = ""
    return true

@borrows
fn TypedExprSourcePathsEquivalent(leftRaw: str, rightRaw: str): bool =
    var left: str
    var right: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(leftRaw, left, pathErr):
        return false
    if !TypedExprLexicalSourcePath(rightRaw, right, pathErr):
        return false
    return left == right

@borrows
fn TypedExprSourceIdentityAddOwnerRoot(index: var TypedExprSourceIdentityIndex,
                                        rootRaw: str,
                                        ownerKey: str,
                                        kind: int32,
                                        err: var str): bool =
    if rootRaw == "":
        return true
    var root: str
    if !TypedExprLexicalSourcePath(rootRaw, root, err):
        return false
    if root[0] != '/':
        err = Fmt" typed expr: semantic owner root is not absolute root={rootRaw}"
        return false
    let existingIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.rootLookup,
                                                                                     root)
    if existingIndex >= 0:
        if existingIndex >= index.rootOwnerKeys.len || existingIndex >= index.rootKinds.len:
            err = " typed expr: corrupt semantic owner root index"
            return false
        if index.rootOwnerKeys[existingIndex] == ownerKey:
            return true
        if index.rootKinds[existingIndex] == 0 && kind > 0:
            var ownerKeys = index.rootOwnerKeys
            var kinds = index.rootKinds
            ownerKeys[existingIndex] = share(ownerKey)
            kinds[existingIndex] = kind
            index.rootOwnerKeys = ownerKeys
            index.rootKinds = kinds
            return true
        if kind == 0 && index.rootKinds[existingIndex] > 0:
            return true
        err = Fmt" typed expr: physical package root has conflicting semantic owners root={root} first={index.rootOwnerKeys[existingIndex]} next={ownerKey}"
        return false
    let rootIndex = index.roots.len
    add(index.roots, share(root))
    add(index.rootOwnerKeys, share(ownerKey))
    add(index.rootKinds, kind)
    parser.ParserSourcePathIndexLookupInsertExact(index.rootLookup, root, rootIndex)
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityOwnerKey(workspaceRoot: str,
                                   packageId: str,
                                   channel: str,
                                   physicalRoot: str): str =
    return strutil.Join(["workspace=", share(workspaceRoot),
                         "\npackageId=", share(packageId),
                         "\nchannel=", share(channel),
                         "\nroot=", share(physicalRoot)], "")

@borrows
fn TypedExprExternalSemanticPackageId(packageRoot: str,
                                      canonicalPackageIdRaw: str,
                                      err: var str): str =
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(
        canonicalPackageIdRaw)
    if canonicalPackageId == "":
        err = Fmt" typed expr: external package owner certificate missing packageId root={packageRoot}"
        return ""
    err = ""
    return canonicalPackageId

@borrows
fn TypedExprBuildSourceIdentityOwnerRoots(source: TypedExprSourceText,
                                           index: var TypedExprSourceIdentityIndex,
                                           err: var str): bool =
    index.roots = []
    index.rootOwnerKeys = []
    index.rootKinds = []
    index.rootLookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(
                    Int64(source.externalPackageRoots.len), 2,
                    "source_identity_root_capacity"),
                16, "source_identity_root_capacity"),
            "source_identity_root_capacity"))
    index.workspaceRoot = ""
    index.currentPackageRoot = ""
    index.currentPackageId = ""
    index.currentPackageChannel = ""
    index.externalOwnerCount = source.externalPackageRoots.len
    var workspaceRoot = ""
    if source.workspaceRoot != "" &&
       !TypedExprLexicalSourcePath(source.workspaceRoot, workspaceRoot, err):
        return false
    index.workspaceRoot = share(workspaceRoot)
    if workspaceRoot != "" &&
       !TypedExprSourceIdentityAddOwnerRoot(index,
                                            workspaceRoot,
                                            TypedExprSourceIdentityOwnerKey(workspaceRoot,
                                                                            "workspace",
                                                                            "",
                                                                            workspaceRoot),
                                            0,
                                            err):
        return false
    var packageRoot = ""
    if source.packageRoot != "" &&
       !TypedExprLexicalSourcePath(source.packageRoot, packageRoot, err):
        return false
    if packageRoot != "":
        let currentPackageId = parser.ParserManifestNormalizePackageId(source.packageId)
        let currentPackageChannel = parser.ParserManifestValidatedChannel(source.packageChannel,
                                                                           currentPackageId)
        if currentPackageId == "":
            err = Fmt" typed expr: current package owner missing packageId root={packageRoot}"
            return false
        index.currentPackageRoot = share(packageRoot)
        index.currentPackageId = share(currentPackageId)
        index.currentPackageChannel = share(currentPackageChannel)
        if !TypedExprSourceIdentityAddOwnerRoot(index,
                                                packageRoot,
                                                TypedExprSourceIdentityOwnerKey(workspaceRoot,
                                                                                currentPackageId,
                                                                                currentPackageChannel,
                                                                                packageRoot),
                                                1,
                                                err):
            return false
    for i in 0..<source.externalPackageRoots.len:
        let channel = chengpath.PathTrim(
            share(source.externalPackageRoots[i].channel))
        var packageRoot: str
        if !TypedExprLexicalSourcePath(source.externalPackageRoots[i].packageRoot,
                                       packageRoot,
                                       err):
            return false
        let packageId = TypedExprExternalSemanticPackageId(
            packageRoot,
            source.externalPackageRoots[i].canonicalPackageId,
            err)
        if packageId == "":
            return false
        let ownerKey = TypedExprSourceIdentityOwnerKey(workspaceRoot,
                                                       packageId,
                                                       channel,
                                                       packageRoot)
        if !TypedExprSourceIdentityAddOwnerRoot(index,
                                                packageRoot,
                                                ownerKey,
                                                2,
                                                err):
            return false
    if index.roots.len <= 0:
        err = " typed expr: source semantic owner roots missing"
        return false
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityFactsMatch(index: TypedExprSourceIdentityIndex,
                                      source: TypedExprSourceText,
                                      err: var str): bool =
    var workspaceRoot = ""
    if source.workspaceRoot != "" &&
       !TypedExprLexicalSourcePath(source.workspaceRoot, workspaceRoot, err):
        return false
    var packageRoot = ""
    if source.packageRoot != "" &&
       !TypedExprLexicalSourcePath(source.packageRoot, packageRoot, err):
        return false
    let packageId = parser.ParserManifestNormalizePackageId(source.packageId)
    let packageChannel = parser.ParserManifestValidatedChannel(source.packageChannel,
                                                                packageId)
    if workspaceRoot != index.workspaceRoot ||
       packageRoot != index.currentPackageRoot ||
       packageId != index.currentPackageId ||
       packageChannel != index.currentPackageChannel ||
       source.externalPackageRoots.len != index.externalOwnerCount:
        err = Fmt" typed expr: source package facts differ workspace={workspaceRoot} package_root={packageRoot} package_id={packageId} channel={packageChannel}"
        return false
    var externalLookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(
                    Int64(source.externalPackageRoots.len), 2,
                    "external_owner_lookup_capacity"),
                8, "external_owner_lookup_capacity"),
            "external_owner_lookup_capacity"))
    for externalIndex in 0..<source.externalPackageRoots.len:
        var externalRoot: str
        if !TypedExprLexicalSourcePath(source.externalPackageRoots[externalIndex].packageRoot,
                                       externalRoot,
                                       err):
            return false
        let externalPackageId = TypedExprExternalSemanticPackageId(
            externalRoot,
            source.externalPackageRoots[externalIndex].canonicalPackageId,
            err)
        if externalPackageId == "":
            return false
        let externalChannel = parser.ParserManifestValidatedChannel(source.externalPackageRoots[externalIndex].channel,
                                                                     externalPackageId)
        let expectedOwner = TypedExprSourceIdentityOwnerKey(workspaceRoot,
                                                            externalPackageId,
                                                            externalChannel,
                                                            externalRoot)
        let rootIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.rootLookup,
                                                                                     externalRoot)
        if rootIndex < 0 || rootIndex >= index.rootOwnerKeys.len ||
           rootIndex >= index.rootKinds.len || index.rootKinds[rootIndex] != 2 ||
           index.rootOwnerKeys[rootIndex] != expectedOwner:
            err = Fmt" typed expr: external semantic owner differs root={externalRoot}"
            return false
        let priorExternal = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(externalLookup,
                                                                                         externalRoot)
        if priorExternal < 0:
            parser.ParserSourcePathIndexLookupInsertExact(externalLookup,
                                                          externalRoot,
                                                          externalIndex)
    for rootIndex in 0..<index.roots.len:
        if index.rootKinds[rootIndex] != 2:
            continue
        if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(externalLookup,
                                                                        index.roots[rootIndex]) < 0:
            err = Fmt" typed expr: source omits external semantic owner root={index.roots[rootIndex]}"
            return false
    err = ""
    return true

@borrows
fn typedExprExactTextEqual(lhs: str, rhs: str): bool =
    if lhs.len != rhs.len:
        return false
    for index in 0..<lhs.len:
        if lhs[index] != rhs[index]:
            return false
    return true

@borrows
fn typedExprOwnedPrefix(text: str, count: int32): str =
    if count <= 0:
        return strings.stringsEmpty()
    if count > text.len:
        count = text.len
    return strings.CloneStrRange(text, 0, count)

@borrows
fn TypedExprSourceIdentityResolve(index: TypedExprSourceIdentityIndex,
                                   sourcePathRaw: str,
                                   physicalPath: var str,
                                   ownerKey: var str,
                                   err: var str): bool =
    physicalPath = ""
    ownerKey = ""
    var sourcePath: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, err):
        return false
    if sourcePath.len <= 0:
        err = " typed expr: source identity path empty after lexical normalize"
        return false
    if sourcePath[0] != '/':
        if index.currentPackageRoot.len == 0:
            err = Fmt" typed expr: relative source has no current-package owner source={parser.ParserOwnedText(sourcePath)}"
            return false
        physicalPath = strings.CloneStr(strutil.Join(
            [parser.ParserOwnedText(index.currentPackageRoot), "/",
             parser.ParserOwnedText(sourcePath)],
            ""))
    else:
        physicalPath = strings.CloneStr(sourcePath)
    var selected = -1
    var walkLen = physicalPath.len
    while walkLen > 0:
        let prefix = typedExprOwnedPrefix(physicalPath, walkLen)
        selected = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(
            index.rootLookup, prefix)
        if selected >= 0:
            break
        let lastSep = chengpath.PathLastSep(prefix)
        if lastSep <= 0 || lastSep >= walkLen:
            break
        walkLen = lastSep
    if selected < 0:
        # 裁定: 单一权威=plan 封缄身份。root 外文件核对 sealed closure 成员白名单
        # (sourceTexts 即当前封缄闭包文件集合, 精确路径匹配), 在 closure 内即按
        # 绝对路径直通作身份键, 不再要 root 锚点; 不在才报错。
        let reqNorm = parser.ParserNormalizePath(physicalPath)
        var sealedHit: bool
        for cloI in 0..<index.sealedClosurePaths.len:
            if typedExprExactTextEqual(index.sealedClosurePaths[cloI], reqNorm):
                sealedHit = true
                break
        if sealedHit:
            ownerKey = parser.ParserOwnedText(physicalPath)
            err = ""
            return true
        err = Fmt" typed expr: source outside semantic owner roots source={parser.ParserOwnedText(physicalPath)}"
        return false
    ownerKey = parser.ParserOwnedText(index.rootOwnerKeys[selected])
    err = ""
    return true

@borrows
fn TypedExprBuildSourceIdentityIndex(sourceTexts: TypedExprSourceText[],
                                      index: var TypedExprSourceIdentityIndex,
                                      err: var str): bool =
    index = TypedExprSourceIdentityIndex()
    index.lookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(sourceTexts.len), 2,
                                      "source_identity_lookup_capacity"),
                8, "source_identity_lookup_capacity"),
            "source_identity_lookup_capacity"))
    if sourceTexts.len <= 0:
        err = " typed expr: source identity index roots missing"
        return false
    # 裁定: 单一权威=plan 封缄身份。sealed closure 成员路径(sourceTexts 的
    # sourcePath, 即当前封缄闭包文件集合)预存白名单, root 外成员 Resolve 直通依据。
    for cloI in 0..<sourceTexts.len:
        add(index.sealedClosurePaths,
            parser.ParserNormalizePath(sourceTexts[cloI].sourcePath))
    if !TypedExprBuildSourceIdentityOwnerRoots(sourceTexts[0],
                                               index,
                                               err):
        return false
    for sourceIndex in 0..<sourceTexts.len:
        if !TypedExprSourceIdentityFactsMatch(index,
                                              sourceTexts[sourceIndex],
                                              err):
            err = Fmt" typed expr: source identity roots invalid index={sourceIndex}: {err}"
            return false
        var sourcePath: str
        var ownerKey: str
        if !TypedExprSourceIdentityResolve(index,
                                           sourceTexts[sourceIndex].sourcePath,
                                           sourcePath,
                                           ownerKey,
                                           err):
            err = Fmt" typed expr: source identity invalid index={sourceIndex}: {err}"
            return false
        let existingIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.lookup,
                                                                                          share(sourcePath))
        if existingIndex >= 0:
            err = Fmt" typed expr: duplicate source identity owner={ownerKey} source={sourcePath} first_index={existingIndex} next_index={sourceIndex}"
            return false
        add(index.sourcePhysicalPaths, share(sourcePath))
        add(index.sourceOwnerKeys, ownerKey)
        parser.ParserSourcePathIndexLookupInsertExact(index.lookup,
                                                      sourcePath,
                                                      sourceIndex)
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityIndexFind(index: TypedExprSourceIdentityIndex,
                                     sourcePathRaw: str,
                                     sourceIndex: var int32,
                                     err: var str): bool =
    sourceIndex = -1
    var sourcePath: str
    var ownerKey: str
    if !TypedExprSourceIdentityResolve(index,
                                       sourcePathRaw,
                                       sourcePath,
                                       ownerKey,
                                       err):
        return false
    sourceIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.lookup,
                                                                               sourcePath)
    err = ""
    return true

@borrows
fn TypedExprSourceIdentityIndexOwnerForPath(index: TypedExprSourceIdentityIndex,
                                             sourcePathRaw: str,
                                             physicalPath: var str,
                                             ownerKey: var str,
                                             err: var str): bool =
    return TypedExprSourceIdentityResolve(index,
                                          sourcePathRaw,
                                          physicalPath,
                                          ownerKey,
                                          err)

@borrows
fn TypedExprFunctionFilterKey(sourceIndex: int32,
                               functionName: str,
                               startLine: int32): str =
    return Fmt"{sourceIndex}:{startLine}:{functionName}"

@borrows
fn TypedExprBuildFunctionFilterIndex(sourceTexts: var TypedExprSourceText[],
                                      active: bool,
                                      sourcePaths: str[],
                                      functionNames: str[],
                                      startLines: int32[],
                                      index: var TypedExprFunctionFilterIndex,
                                      err: var str): bool =
    index = TypedExprFunctionFilterIndex()
    index.active = active
    if !TypedExprBuildSourceIdentityIndex(sourceTexts, index.sourceIdentity, err):
        return false
    for sourceIndex in 0..<sourceTexts.len:
        add(index.selectedSources, !active)
    index.functions = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(functionNames.len), 2,
                                      "function_filter_capacity"),
                8, "function_filter_capacity"),
            "function_filter_capacity"))
    if !active:
        err = ""
        return true
    if sourcePaths.len != functionNames.len || startLines.len != functionNames.len:
        err = Fmt" typed expr: function filter columns mismatch sources={sourcePaths.len} functions={functionNames.len} starts={startLines.len}"
        return false
    for filterIndex in 0..<functionNames.len:
        if functionNames[filterIndex] == "" || startLines[filterIndex] <= 0:
            err = Fmt" typed expr: function filter row invalid index={filterIndex} function={functionNames[filterIndex]} start={startLines[filterIndex]}"
            return false
        var sourceIndex: int32
        if !TypedExprSourceIdentityIndexFind(index.sourceIdentity,
                                             sourcePaths[filterIndex],
                                             sourceIndex,
                                             err):
            err = Fmt" typed expr: function filter source identity invalid index={filterIndex}: {err}"
            return false
        if sourceIndex < 0 || sourceIndex >= index.selectedSources.len:
            err = Fmt" typed expr: function filter source missing index={filterIndex} source={sourcePaths[filterIndex]}"
            return false
        index.selectedSources[sourceIndex] = true
        let key = TypedExprFunctionFilterKey(sourceIndex,
                                             functionNames[filterIndex],
                                             startLines[filterIndex])
        let existingIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.functions,
                                                                                          key)
        if existingIndex >= 0:
            err = Fmt" typed expr: duplicate function filter row first_index={existingIndex} next_index={filterIndex} source={sourcePaths[filterIndex]} function={functionNames[filterIndex]} start={startLines[filterIndex]}"
            return false
        parser.ParserSourcePathIndexLookupInsertExact(index.functions, key, filterIndex)
    err = ""
    return true

@borrows
fn TypedExprFunctionFilterSourceIndex(index: TypedExprFunctionFilterIndex,
                                       sourcePathRaw: str): int32 =
    var sourceIndex: int32
    var pathErr: str
    if !TypedExprSourceIdentityIndexFind(index.sourceIdentity,
                                         sourcePathRaw,
                                         sourceIndex,
                                         pathErr):
        panic(pathErr)
    return sourceIndex

@borrows
fn TypedExprFunctionFilterHasSource(index: TypedExprFunctionFilterIndex,
                                     sourcePathRaw: str): bool =
    let sourceIndex = TypedExprFunctionFilterSourceIndex(index, sourcePathRaw)
    if sourceIndex < 0 || sourceIndex >= index.selectedSources.len:
        return false
    return index.selectedSources[sourceIndex]

@borrows
fn TypedExprFunctionFilterAllows(index: TypedExprFunctionFilterIndex,
                                  sourcePathRaw: str,
                                  functionName: str,
                                  startLine: int32): bool =
    if !index.active:
        return true
    let sourceIndex = TypedExprFunctionFilterSourceIndex(index, sourcePathRaw)
    if sourceIndex < 0 || sourceIndex >= index.selectedSources.len ||
       !index.selectedSources[sourceIndex]:
        return false
    let key = TypedExprFunctionFilterKey(sourceIndex, functionName, startLine)
    return parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.functions,
                                                                        key) >= 0

@borrows
fn TypedExprSourceTextsSnapshotOnly(sourceTexts: var TypedExprSourceText[]): bool =
    for sourceIndex in 0..<sourceTexts.len:
        if sourceTexts[sourceIndex].snapshotOnly:
            return true
    return false

fn TypedExprEnsureSourceTextsCoverExprLayer(sourceTexts: var TypedExprSourceText[],
                                             exprLayer: var parser.NormalizedExprLayer,
                                             err: var str): bool =
    var sourceIndexLookup: TypedExprSourceIdentityIndex
    if !TypedExprBuildSourceIdentityIndex(sourceTexts, sourceIndexLookup, err):
        return false
    var workspaceRoot = ""
    var packageRoot = ""
    var packageId = ""
    var packageChannel = ""
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    if sourceTexts.len > 0:
        workspaceRoot = sourceTexts[0].workspaceRoot
        packageRoot = sourceTexts[0].packageRoot
        packageId = sourceTexts[0].packageId
        packageChannel = sourceTexts[0].packageChannel
        externalPackageRoots = sourceTexts[0].externalPackageRoots
    let snapshotOnly = TypedExprSourceTextsSnapshotOnly(sourceTexts)
    for i in 0..<exprLayer.exprs.len:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        var sourceIndex: int32
        if !TypedExprSourceIdentityIndexFind(sourceIndexLookup,
                                             exprLayer.exprs[i].sourcePath,
                                             sourceIndex,
                                             err):
            err = Fmt" typed expr: expr source identity invalid expr_index={i}: {err}"
            return false
        if sourceIndex >= 0:
            exprLayer.exprs[i].sourcePath = sourceTexts[sourceIndex].sourcePath
            continue
        var sourcePath: str
        var ownerKey: str
        if !TypedExprSourceIdentityResolve(sourceIndexLookup,
                                           exprLayer.exprs[i].sourcePath,
                                           sourcePath,
                                           ownerKey,
                                           err):
            return false
        if snapshotOnly:
            err = Fmt" typed expr: snapshot-only source row missing for expr source={sourcePath} line={exprLayer.exprs[i].lineNumber}"
            return false
        var text = chengpath.ReadTextFile("", sourcePath)
        if text == "":
            text = os.ReadFile(chengpath.PathProviderFilePath(sourcePath))
        if text == "":
            err = Fmt" typed expr: missing source text for expr source={sourcePath} line={exprLayer.exprs[i].lineNumber}"
            return false
        add(sourceTexts, TypedExprSourceTextNewWithPackageFacts(strings.CloneStr(workspaceRoot),
                                                                 strings.CloneStr(packageRoot),
                                                                 strings.CloneStr(packageId),
                                                                 strings.CloneStr(packageChannel),
                                                                 parser.ParserExternalPackageRootsClone(externalPackageRoots),
                                                                 strings.CloneStr(sourcePath),
                                                                 text))
        add(sourceIndexLookup.sourcePhysicalPaths, strings.CloneStr(sourcePath))
        add(sourceIndexLookup.sourceOwnerKeys, strings.CloneStr(ownerKey))
        parser.ParserSourcePathIndexLookupInsertExact(sourceIndexLookup.lookup,
                                                      strings.CloneStr(sourcePath),
                                                      sourceTexts.len - 1)
        exprLayer.exprs[i].sourcePath = sourcePath
    err = ""
    return true

fn TypedExprPrepareSourceExprLineColumns(ctx: var TypedExprSourceContext) =
    ctx.exprLineColumnHeads = []
    for lineIndex in 0..<ctx.lines.len:
        add(ctx.exprLineColumnHeads, -1)
    setLen(ctx.exprLineColumnValues, 0)
    setLen(ctx.exprLineColumnNext, 0)

fn TypedExprClearSourceExprLineColumns(ctx: var TypedExprSourceContext) =
    ctx.exprLineColumnHeads = []
    ctx.exprLineColumnValues = []
    ctx.exprLineColumnNext = []

@borrows
fn TypedExprAnnotationQuotedValue(lineRaw: str,
                                   annotationName: str): str =
    let trimmed = chengpath.PathTrim(lineRaw)
    let prefix = Fmt"@{annotationName}(\""
    if !parser.ParserStartsWith(trimmed, prefix):
        return ""
    let start = len(prefix)
    for i in start..<len(trimmed):
        if trimmed[i] == '"':
            return chengpath.TextSlice(trimmed, start, i - start)
    return ""

@borrows
fn TypedExprImportcAnnotationNameForDecl(lines: str[],
                                          lineIndex: int32): str =
    if lineIndex <= 1 || lineIndex > lines.len:
        return ""
    var cursor = lineIndex - 1
    while cursor >= 1:
        let trimmed = chengpath.PathTrim(lines[cursor - 1])
        if trimmed == "":
            cursor = cursor - 1
            continue
        let importName = TypedExprAnnotationQuotedValue(trimmed, "importc")
        if importName != "":
            return importName
        if parser.ParserStartsWith(trimmed, "@"):
            cursor = cursor - 1
            continue
        return ""
    return ""

@borrows
fn TypedExprSourceContextIndexHash(sourcePath: str,
                                    bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(sourcePath):
        h = h * 31 + int32(sourcePath[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

@borrows
fn TypedExprSourceContextBindingIndexHash(name: str,
                                           functionKey: str,
                                           bucketCount: int32): int32 =
    # (name, fn|global) 组合键: 只按 name 建链时跨函数同名绑定 (i/acc/out...)
    # 把链拉成 O(函数数) → 每查询线性; 组合键后链长回落到同函数 shadow 数。
    # global 绑定键 = (name, ""), 查询侧双链归并 (见 LookupBindingType)。
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(name):
        h = h * 31 + int32(name[i])
    h = h * 31 + 10
    for i in 0..<len(functionKey):
        h = h * 31 + int32(functionKey[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

fn TypedExprScopeNameIndexPrepare(ctx: var TypedExprSourceContext) =
    if ctx.scopeNameIndexBuiltCount == ctx.scopes.len &&
       ctx.scopeNameIndexBucketHeads.len > 0:
        return
    let shapeOk =
        ctx.scopeNameIndexBuiltCount >= 0 &&
        ctx.scopeNameIndexBucketHeads.len > 0 &&
        ctx.scopeNameIndexEntryNames.len == ctx.scopeNameIndexBuiltCount &&
        ctx.scopeNameIndexEntryScopeIndexes.len ==
            ctx.scopeNameIndexBuiltCount &&
        ctx.scopeNameIndexEntryNext.len == ctx.scopeNameIndexBuiltCount
    if !shapeOk || ctx.scopeNameIndexBuiltCount > ctx.scopes.len:
        ctx.scopeNameIndexBucketHeads = []
        ctx.scopeNameIndexEntryNames = []
        ctx.scopeNameIndexEntryScopeIndexes = []
        ctx.scopeNameIndexEntryNext = []
        var bucketTails: int32[]
        for bucketIndex in 0..<1024:
            add(ctx.scopeNameIndexBucketHeads, -1)
            add(bucketTails, -1)
        for i in 0..<ctx.scopes.len:
            let scopeName = ctx.scopes[i].name
            let bucket = TypedExprSourceContextIndexHash(scopeName,
                                                         ctx.scopeNameIndexBucketHeads.len)
            if bucket < 0:
                continue
            let entryIndex = ctx.scopeNameIndexEntryScopeIndexes.len
            add(ctx.scopeNameIndexEntryScopeIndexes, i)
            add(ctx.scopeNameIndexEntryNames, share(scopeName))
            add(ctx.scopeNameIndexEntryNext, -1)
            if ctx.scopeNameIndexBucketHeads[bucket] < 0:
                ctx.scopeNameIndexBucketHeads[bucket] = entryIndex
            else:
                let tail = bucketTails[bucket]
                ctx.scopeNameIndexEntryNext[tail] = entryIndex
            bucketTails[bucket] = entryIndex
        ctx.scopeNameIndexBuiltCount = ctx.scopes.len
        return
    for i in ctx.scopeNameIndexBuiltCount..<ctx.scopes.len:
        let scopeName = ctx.scopes[i].name
        let bucket = TypedExprSourceContextIndexHash(scopeName,
                                                     ctx.scopeNameIndexBucketHeads.len)
        if bucket < 0:
            continue
        let entryIndex = ctx.scopeNameIndexEntryScopeIndexes.len
        add(ctx.scopeNameIndexEntryScopeIndexes, i)
        add(ctx.scopeNameIndexEntryNames, share(scopeName))
        add(ctx.scopeNameIndexEntryNext, -1)
        if ctx.scopeNameIndexBucketHeads[bucket] < 0:
            ctx.scopeNameIndexBucketHeads[bucket] = entryIndex
        else:
            var tail = ctx.scopeNameIndexBucketHeads[bucket]
            while ctx.scopeNameIndexEntryNext[tail] >= 0:
                tail = ctx.scopeNameIndexEntryNext[tail]
            ctx.scopeNameIndexEntryNext[tail] = entryIndex
    ctx.scopeNameIndexBuiltCount = ctx.scopes.len

@borrows
fn TypedExprScopeIndexByName(ctx: var TypedExprSourceContext,
                              name: str): int32 =
    # 返回首个 name 匹配的 scopeIndex (原 `for i in 0..<scopes.len` 首匹配), 无 = -1。
    if name == "":
        return -1
    TypedExprScopeNameIndexPrepare(ctx)
    let bucket = TypedExprSourceContextIndexHash(name,
                                                 ctx.scopeNameIndexBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = ctx.scopeNameIndexBucketHeads[bucket]
    while entryIndex >= 0:
        if ctx.scopeNameIndexEntryNames[entryIndex] == name:
            return ctx.scopeNameIndexEntryScopeIndexes[entryIndex]
        entryIndex = ctx.scopeNameIndexEntryNext[entryIndex]
    return -1

fn TypedExprBindingNameIndexPrepare(ctx: var TypedExprSourceContext) =
    if ctx.bindingNameIndexBuiltCount == ctx.bindings.len &&
       ctx.bindingNameIndexBucketHeads.len > 0:
        return
    let shapeOk =
        ctx.bindingNameIndexBuiltCount >= 0 &&
        ctx.bindingNameIndexBucketHeads.len > 0 &&
        ctx.bindingNameIndexEntryNames.len ==
            ctx.bindingNameIndexBuiltCount &&
        ctx.bindingNameIndexEntryBindingIndexes.len ==
            ctx.bindingNameIndexBuiltCount &&
        ctx.bindingNameIndexEntryNext.len ==
            ctx.bindingNameIndexBuiltCount
    if !shapeOk || ctx.bindingNameIndexBuiltCount > ctx.bindings.len:
        ctx.bindingNameIndexBucketHeads = []
        ctx.bindingNameIndexEntryNames = []
        ctx.bindingNameIndexEntryBindingIndexes = []
        ctx.bindingNameIndexEntryNext = []
        var bucketTails: int32[]
        for bucketIndex in 0..<1024:
            add(ctx.bindingNameIndexBucketHeads, -1)
            add(bucketTails, -1)
        for i in 0..<ctx.bindings.len:
            let bindingName = ctx.bindings[i].name
            var bindingFunctionKey = ""
            if !ctx.bindings[i].globalFlag:
                bindingFunctionKey = ctx.bindings[i].functionName
            let bucket = TypedExprSourceContextBindingIndexHash(bindingName,
                                                                bindingFunctionKey,
                                                                ctx.bindingNameIndexBucketHeads.len)
            if bucket < 0:
                continue
            let entryIndex = ctx.bindingNameIndexEntryBindingIndexes.len
            add(ctx.bindingNameIndexEntryBindingIndexes, i)
            add(ctx.bindingNameIndexEntryNames, share(bindingName))
            add(ctx.bindingNameIndexEntryNext, -1)
            if ctx.bindingNameIndexBucketHeads[bucket] < 0:
                ctx.bindingNameIndexBucketHeads[bucket] = entryIndex
            else:
                let tail = bucketTails[bucket]
                ctx.bindingNameIndexEntryNext[tail] = entryIndex
            bucketTails[bucket] = entryIndex
        ctx.bindingNameIndexBuiltCount = ctx.bindings.len
        return
    for i in ctx.bindingNameIndexBuiltCount..<ctx.bindings.len:
        let bindingName = ctx.bindings[i].name
        var bindingFunctionKey = ""
        if !ctx.bindings[i].globalFlag:
            bindingFunctionKey = ctx.bindings[i].functionName
        let bucket = TypedExprSourceContextBindingIndexHash(bindingName,
                                                            bindingFunctionKey,
                                                            ctx.bindingNameIndexBucketHeads.len)
        if bucket < 0:
            continue
        let entryIndex = ctx.bindingNameIndexEntryBindingIndexes.len
        add(ctx.bindingNameIndexEntryBindingIndexes, i)
        add(ctx.bindingNameIndexEntryNames, share(bindingName))
        add(ctx.bindingNameIndexEntryNext, -1)
        if ctx.bindingNameIndexBucketHeads[bucket] < 0:
            ctx.bindingNameIndexBucketHeads[bucket] = entryIndex
        else:
            var tail = ctx.bindingNameIndexBucketHeads[bucket]
            while ctx.bindingNameIndexEntryNext[tail] >= 0:
                tail = ctx.bindingNameIndexEntryNext[tail]
            ctx.bindingNameIndexEntryNext[tail] = entryIndex
    ctx.bindingNameIndexBuiltCount = ctx.bindings.len

@borrows
fn TypedExprLookupBindingBestIndexIndexed(ctx: TypedExprSourceContext,
                                           scopeIndex: int32,
                                           lineNumber: int32,
                                           nameRaw: str): int32 =
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return -1
    if ctx.bindingNameIndexBuiltCount != ctx.bindings.len ||
       ctx.bindingNameIndexBucketHeads.len <= 0 ||
       ctx.bindingNameIndexEntryNames.len !=
           ctx.bindingNameIndexEntryBindingIndexes.len ||
       ctx.bindingNameIndexEntryNames.len !=
           ctx.bindingNameIndexEntryNext.len:
        panic("typed expr: immutable binding query requires exact prepared index")
    var bestLine: int32
    var bestIndex: int32
    bestLine = -1
    bestIndex = -1
    var scopeName = ""
    if scopeIndex >= 0:
        scopeName = ctx.scopes[scopeIndex].name
    # (name,scopeName) 与 (name,"") 两链按 bindingIndex 归并走原选优 —— 选优对
    # local/global 交错顺序敏感 (bestLine<0 才收 global), 两链各自尾插升序,
    # 归并即复刻原 name 单链的数组序; 同桶时单指针防条目重复。
    var localEntry: int32
    var globalEntry: int32
    localEntry = -1
    globalEntry = -1
    let globalBucket = TypedExprSourceContextBindingIndexHash(name,
                                                              "",
                                                              ctx.bindingNameIndexBucketHeads.len)
    if globalBucket >= 0:
        globalEntry = ctx.bindingNameIndexBucketHeads[globalBucket]
    if scopeName != "":
        let localBucket = TypedExprSourceContextBindingIndexHash(name,
                                                                 scopeName,
                                                                 ctx.bindingNameIndexBucketHeads.len)
        if localBucket >= 0 && localBucket != globalBucket:
            localEntry = ctx.bindingNameIndexBucketHeads[localBucket]
    while localEntry >= 0 || globalEntry >= 0:
        var takeLocal = false
        if localEntry >= 0 && globalEntry >= 0:
            takeLocal = ctx.bindingNameIndexEntryBindingIndexes[localEntry] <
                        ctx.bindingNameIndexEntryBindingIndexes[globalEntry]
        elif localEntry >= 0:
            takeLocal = true
        var entryIndex: int32
        if takeLocal:
            entryIndex = localEntry
            localEntry = ctx.bindingNameIndexEntryNext[localEntry]
        else:
            entryIndex = globalEntry
            globalEntry = ctx.bindingNameIndexEntryNext[globalEntry]
        if ctx.bindingNameIndexEntryNames[entryIndex] != name:
            continue
        let bindingIndex = ctx.bindingNameIndexEntryBindingIndexes[entryIndex]
        let binding = ctx.bindings[bindingIndex]
        if binding.typeText == "":
            continue
        if binding.lineNumber > lineNumber && !binding.globalFlag:
            continue
        if scopeName != "":
            if !binding.globalFlag && binding.functionName == scopeName && binding.lineNumber >= bestLine:
                bestLine = binding.lineNumber
                bestIndex = bindingIndex
                continue
            if binding.globalFlag && bestLine < 0:
                bestLine = binding.lineNumber
                bestIndex = bindingIndex
            continue
        if !binding.globalFlag:
            continue
        if binding.lineNumber >= bestLine:
            bestLine = binding.lineNumber
            bestIndex = bindingIndex
    return bestIndex

@borrows
fn TypedExprBindingNameIndexIsPrepared(ctx: TypedExprSourceContext): bool =
    return ctx.bindingNameIndexBuiltCount == ctx.bindings.len &&
           ctx.bindingNameIndexBucketHeads.len > 0 &&
           ctx.bindingNameIndexEntryNames.len ==
               ctx.bindingNameIndexEntryBindingIndexes.len &&
           ctx.bindingNameIndexEntryNames.len ==
               ctx.bindingNameIndexEntryNext.len

@borrows
fn TypedExprLookupBindingBestIndexLinear(ctx: TypedExprSourceContext,
                                          scopeIndex: int32,
                                          lineNumber: int32,
                                          nameRaw: str): int32 =
    # Same selection as Indexed: walk bindings in array order (the order
    # the hash chains replay). Authority is the bindings table, not the
    # derived name index.
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return -1
    var bestLine: int32
    var bestIndex: int32
    bestLine = -1
    bestIndex = -1
    var scopeName = ""
    if scopeIndex >= 0:
        scopeName = ctx.scopes[scopeIndex].name
    for bindingIndex in 0..<ctx.bindings.len:
        let binding = ctx.bindings[bindingIndex]
        if binding.typeText == "":
            continue
        if binding.name != name:
            continue
        if binding.lineNumber > lineNumber && !binding.globalFlag:
            continue
        if scopeName != "":
            if !binding.globalFlag && binding.functionName == scopeName &&
               binding.lineNumber >= bestLine:
                bestLine = binding.lineNumber
                bestIndex = bindingIndex
                continue
            if binding.globalFlag && bestLine < 0:
                bestLine = binding.lineNumber
                bestIndex = bindingIndex
            continue
        if !binding.globalFlag:
            continue
        if binding.lineNumber >= bestLine:
            bestLine = binding.lineNumber
            bestIndex = bindingIndex
    return bestIndex

@borrows
fn TypedExprLookupBindingBestIndex(ctx: TypedExprSourceContext,
                                    scopeIndex: int32,
                                    lineNumber: int32,
                                    nameRaw: str): int32 =
    if TypedExprBindingNameIndexIsPrepared(ctx):
        return TypedExprLookupBindingBestIndexIndexed(
            ctx, scopeIndex, lineNumber, nameRaw)
    return TypedExprLookupBindingBestIndexLinear(
        ctx, scopeIndex, lineNumber, nameRaw)

@borrows
fn TypedExprLookupBindingTypeIndexed(ctx: TypedExprSourceContext,
                                     scopeIndex: int32,
                                     lineNumber: int32,
                                     nameRaw: str): str =
    let bindingIndex = TypedExprLookupBindingBestIndexIndexed(
        ctx, scopeIndex, lineNumber, nameRaw)
    if bindingIndex >= 0:
        return ctx.bindings[bindingIndex].typeText
    if ctx.frozenMetadataProjection == nil ||
       ctx.frozenMetadataContextIndex < 0:
        return ""
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    let rowIndex = typedExprFrozenGlobalBindingRowLookup(
        ctx.frozenMetadataProjection,
        ctx.frozenMetadataContextIndex,
        name)
    if rowIndex < 0:
        return ""
    return typedExprFrozenProjectionText(
        ctx.frozenMetadataProjection,
        ctx.frozenMetadataProjection.globalBindingTypeIds[rowIndex])

@borrows
fn TypedExprStaticLetCallResultType(ctx: TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     scope: TypedExprFunctionScope,
                                     lineNumber: int32,
                                     nameRaw: str): str =
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return ""
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
    let bindingIndex = TypedExprLookupBindingBestIndex(
        ctx, scopeIndex, lineNumber, name)
    var defLineNumber: int32
    var rhsText = ""
    if bindingIndex >= 0:
        let storedType = TypedExprNormalizeTypeText(ctx.bindings[bindingIndex].typeText)
        if storedType != "":
            return storedType
        defLineNumber = ctx.bindings[bindingIndex].lineNumber
        let defLine = TypedExprSourceContextLineText(ctx, defLineNumber)
        let parsed = TypedExprParseBindingLineOwned(defLine)
        if parsed.ok && parsed.rhsStartColumn > 0:
            rhsText = TypedExprBindingRhsText(defLine, parsed.rhsStartColumn)
    elif ctx.frozenMetadataProjection != nil:
        let projectedType = TypedExprNormalizeTypeText(
            TypedExprLookupBindingTypeIndexed(ctx,
                                              scopeIndex,
                                              lineNumber,
                                              name))
        if projectedType != "":
            return projectedType
    if rhsText == "":
        var scanLine = scope.startLine
        if scanLine < 1:
            scanLine = 1
        while scanLine < lineNumber &&
              (scope.endLine <= 0 || scanLine <= scope.endLine):
            let rawLine = TypedExprSourceContextLineText(ctx, scanLine)
            let parsed = TypedExprParseBindingLineOwned(rawLine)
            if parsed.ok && parsed.name == name && parsed.rhsStartColumn > 0:
                defLineNumber = scanLine
                rhsText = TypedExprBindingRhsText(rawLine, parsed.rhsStartColumn)
            scanLine = scanLine + 1
    if rhsText == "":
        return ""
    let callType = TypedExprNormalizeTypeText(
        TypedExprBindingRhsCallReturnType(
            ctx, sourceContexts, defLineNumber, rhsText))
    if callType != "":
        return callType
    return TypedExprNormalizeTypeText(
        TypedExprStaticUniqueCalleeReturnType(ctx, rhsText))

@borrows
fn TypedExprStaticUniqueCalleeIdentity(ctx: TypedExprSourceContext,
                                        calleeRaw: str,
                                        returnTypeOut: var str,
                                        signatureLineOut: var int32): bool =
    returnTypeOut = ""
    signatureLineOut = 0
    let callee = parser.ParserIdentPrefix(chengpath.PathTrim(calleeRaw))
    if callee == "":
        return false
    if ctx.buildIndex != nil && ctx.buildIndex.callDeclarationSealed:
        var declarationRow: int32
        let declarationState = typedExprLocalFunctionNameRow(
            ctx, callee, declarationRow)
        if declarationState != TypedExprBuildIndexUnique:
            return false
        returnTypeOut = parser.ParserOwnedText(
            typedExprBuildIndexCallReturnType(ctx.buildIndex,
                                              declarationRow))
        signatureLineOut = typedExprBuildIndexCallSignatureLineNumber(
            ctx.buildIndex, declarationRow)
        return signatureLineOut > 0
    var foundReturn = ""
    var foundLine: int32
    var hits: int32
    foundLine = 0
    hits = 0
    for i in 0..<ctx.signatureScopes.len:
        if ctx.signatureScopes[i].name == callee:
            hits = hits + 1
            foundReturn = ctx.signatureScopes[i].returnType
            foundLine = ctx.signatureScopes[i].startLine
    if hits == 0:
        for i in 0..<ctx.scopes.len:
            if ctx.scopes[i].name == callee:
                hits = hits + 1
                foundReturn = ctx.scopes[i].returnType
                foundLine = ctx.scopes[i].startLine
    if hits != 1 || foundLine <= 0:
        return false
    returnTypeOut = foundReturn
    signatureLineOut = foundLine
    return true

@borrows
fn TypedExprStaticUniqueCalleeReturnType(ctx: TypedExprSourceContext,
                                          rhsText: str): str =
    let callHead = TypedExprBindingRhsCallHead(rhsText)
    if callHead == "" || TypedExprQualifiedCallQualifier(callHead) != "":
        return ""
    let callee = TypedExprQualifiedCallLeaf(callHead)
    var returnType = ""
    var signatureLine: int32
    if !TypedExprStaticUniqueCalleeIdentity(ctx,
                                            callee,
                                            returnType,
                                            signatureLine):
        return ""
    return returnType

@borrows
fn TypedExprLookupBindingType(ctx: var TypedExprSourceContext,
                               scopeIndex: int32,
                               lineNumber: int32,
                               nameRaw: str): str =
    TypedExprBindingNameIndexPrepare(ctx)
    return TypedExprLookupBindingTypeIndexed(
        ctx,
        scopeIndex,
        lineNumber,
        nameRaw)

@borrows
fn TypedExprLookupBindingMeta(ctx: TypedExprSourceContext,
                               scopeIndex: int32,
                               lineNumber: int32,
                               nameRaw: str,
                               typeOut: var str,
                               sourcePathOut: var str,
                               globalFlagOut: var bool,
                               mutableFlagOut: var bool): bool =
    typeOut = ""
    sourcePathOut = ""
    globalFlagOut = false
    mutableFlagOut = false
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return false
    var bestLine: int32 = -1
    var scopeName = ""
    if scopeIndex >= 0:
        scopeName = ctx.scopes[scopeIndex].name
    if ctx.bindingNameIndexBuiltCount != ctx.bindings.len ||
       ctx.bindingNameIndexBucketHeads.len <= 0 ||
       ctx.bindingNameIndexEntryNames.len !=
           ctx.bindingNameIndexEntryBindingIndexes.len ||
       ctx.bindingNameIndexEntryNames.len !=
           ctx.bindingNameIndexEntryNext.len:
        panic("typed expr: immutable binding metadata query requires exact prepared index")
    # 双链归并同 TypedExprLookupBindingType (顺序敏感语义见彼处注释)。
    var localEntry: int32 = -1
    var globalEntry: int32 = -1
    let globalBucket = TypedExprSourceContextBindingIndexHash(name,
                                                              "",
                                                              ctx.bindingNameIndexBucketHeads.len)
    if globalBucket >= 0:
        globalEntry = ctx.bindingNameIndexBucketHeads[globalBucket]
    if scopeName != "":
        let localBucket = TypedExprSourceContextBindingIndexHash(name,
                                                                 scopeName,
                                                                 ctx.bindingNameIndexBucketHeads.len)
        if localBucket >= 0 && localBucket != globalBucket:
            localEntry = ctx.bindingNameIndexBucketHeads[localBucket]
    while localEntry >= 0 || globalEntry >= 0:
        var takeLocal = false
        if localEntry >= 0 && globalEntry >= 0:
            takeLocal = ctx.bindingNameIndexEntryBindingIndexes[localEntry] <
                        ctx.bindingNameIndexEntryBindingIndexes[globalEntry]
        elif localEntry >= 0:
            takeLocal = true
        var entryIndex: int32
        if takeLocal:
            entryIndex = localEntry
            localEntry = ctx.bindingNameIndexEntryNext[localEntry]
        else:
            entryIndex = globalEntry
            globalEntry = ctx.bindingNameIndexEntryNext[globalEntry]
        if ctx.bindingNameIndexEntryNames[entryIndex] != name:
            continue
        let bindingIndex = ctx.bindingNameIndexEntryBindingIndexes[entryIndex]
        let binding = ctx.bindings[bindingIndex]
        if binding.typeText == "":
            continue
        if binding.lineNumber > lineNumber && !binding.globalFlag:
            continue
        if scopeName != "":
            if !binding.globalFlag && binding.functionName == scopeName && binding.lineNumber >= bestLine:
                bestLine = binding.lineNumber
                typeOut = binding.typeText
                sourcePathOut = binding.sourcePath
                globalFlagOut = false
                mutableFlagOut = binding.mutableFlag
                continue
            if binding.globalFlag && bestLine < 0:
                bestLine = binding.lineNumber
                typeOut = binding.typeText
                sourcePathOut = binding.sourcePath
                globalFlagOut = true
                mutableFlagOut = binding.mutableFlag
            continue
        if !binding.globalFlag:
            continue
        if binding.lineNumber >= bestLine:
            bestLine = binding.lineNumber
            typeOut = binding.typeText
            sourcePathOut = binding.sourcePath
            globalFlagOut = true
            mutableFlagOut = binding.mutableFlag
    if typeOut != "":
        return true
    if ctx.frozenMetadataProjection == nil ||
       ctx.frozenMetadataContextIndex < 0:
        return false
    let rowIndex = typedExprFrozenGlobalBindingRowLookup(
        ctx.frozenMetadataProjection,
        ctx.frozenMetadataContextIndex,
        name)
    if rowIndex < 0:
        return false
    typeOut = typedExprFrozenProjectionTextShared(ctx.frozenMetadataProjection, ctx.frozenMetadataProjection.globalBindingTypeIds[rowIndex])
    sourcePathOut = parser.ParserOwnedText(ctx.sourcePath)
    globalFlagOut = true
    mutableFlagOut =
        ctx.frozenMetadataProjection.globalBindingMutableFlags[rowIndex]
    return typeOut != ""

@borrows
fn TypedExprJoinParamTypes(params: TypedExprParam[]): str =
    var joined = ""
    for i in 0..<params.len:
        let paramType = TypedExprCallParamType(params[i])
        if i > 0:
            joined = Fmt"{joined};;{paramType}"
        else:
            joined = paramType
    return joined

@borrows
fn TypedExprJoinGenericNames(genericNames: str[]): str =
    var joined = ""
    for i in 0..<genericNames.len:
        if i > 0:
            joined = Fmt"{joined};;{genericNames[i]}"
        else:
            joined = genericNames[i]
    return joined

@borrows
fn TypedExprSplitParamTypeJoin(joined: str): str[] =
    var out: str[]
    out = []
    if len(joined) <= 0:
        return out
    var start: int32
    var i: int32
    while i + 1 < len(joined):
        if joined[i] == ';' && joined[i + 1] == ';':
            add(out, strings.CloneStrRange(joined, start, i - start))
            start = i + 2
            i = i + 2
        else:
            i = i + 1
    add(out, strings.CloneStrRange(joined, start, len(joined) - start))
    return out

@borrows
fn TypedExprRuntimeParamTypeJoin(joined: str): str =
    let paramTypes = TypedExprSplitParamTypeJoin(joined)
    var runtimeJoin = ""
    for i in 0..<paramTypes.len:
        let runtimeType = TypedExprCallRuntimeType(paramTypes[i])
        if i > 0:
            runtimeJoin = Fmt"{runtimeJoin};;{runtimeType}"
        else:
            runtimeJoin = runtimeType
    return runtimeJoin

@borrows
fn TypedExprSplitGenericNameJoin(joined: str): str[] =
    return TypedExprSplitParamTypeJoin(joined)

fn TypedExprIrAddImportcReturnType(ir: var TypedExprIr,
                                    sourcePathRaw: str,
                                    nameRaw: str,
                                    returnTypeRaw: str,
                                    targetSymbolRaw: str) =
    TypedExprIrAddImportcDecl(ir, sourcePathRaw, nameRaw, returnTypeRaw, targetSymbolRaw, "")

@borrows
fn TypedExprIrAddImportcDecl(ir: var TypedExprIr,
                              sourcePathRaw: str,
                              nameRaw: str,
                              returnTypeRaw: str,
                              targetSymbolRaw: str,
                              paramTypeJoin: str) =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let runtimeParamTypeJoin = TypedExprRuntimeParamTypeJoin(paramTypeJoin)
    let name = parser.ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    var returnType = TypedExprNormalizeTypeText(returnTypeRaw)
    if returnType == "":
        returnType = "void"
    var targetSymbol = chengpath.PathTrim(targetSymbolRaw)
    if targetSymbol == "":
        targetSymbol = share(name)
    if sourcePath == "" || name == "":
        return
    for i in 0..<ir.importcNames.len:
        if i >= ir.importcSourcePaths.len:
            continue
        if TypedExprSourcePathsEquivalent(ir.importcSourcePaths[i], sourcePath) &&
           ir.importcNames[i] == name:
            if targetSymbol != "" && i < ir.importcTargetSymbols.len && ir.importcTargetSymbols[i] == "":
                ir.importcTargetSymbols[i] = targetSymbol
            if runtimeParamTypeJoin != "" && i < ir.importcParamTypeJoins.len && ir.importcParamTypeJoins[i] == "":
                ir.importcParamTypeJoins[i] = runtimeParamTypeJoin
            return
    add(ir.importcSourcePaths, sourcePath)
    add(ir.importcNames, name)
    add(ir.importcReturnTypes, returnType)
    add(ir.importcTargetSymbols, targetSymbol)
    add(ir.importcParamTypeJoins, runtimeParamTypeJoin)

fn TypedExprIrAppendImportcFunctionsFromContext(ir: var TypedExprIr,
                                                 ctx: var TypedExprSourceContext) =
    for i in 0..<ctx.importcFunctions.len:
        var targetSymbol = ctx.importcFunctions[i].importName
        if targetSymbol.len <= 0:
            targetSymbol = ctx.importcFunctions[i].name
        TypedExprIrAddImportcDecl(ir,
                                  ctx.sourcePath,
                                  ctx.importcFunctions[i].name,
                                  ctx.importcFunctions[i].returnType,
                                  targetSymbol,
                                  ctx.importcFunctions[i].paramTypeJoin)
        # importName 撞名让位:仅当同 ctx 无同名 Cheng fn 时才把 importName 也注册成 IR
        # importc 键。fs.cheng 同时有 `@importc("chmod") fn libc_chmod` 和 `fn chmod():
        # Result[bool]` 时,若注册 importName "chmod",节点建型(TypedExprIrLookupImportcReturnType
        # 13668)会按 importName 把 chmod(...) 调用劫持成 importc int32 → whole-call-return
        # 聚合形误判 → call_ret_shape skip。源码写 chmod(...) 在 Cheng 语义恒指本地 fn(调
        # importc 真身写 libc_chmod),故同名本地 fn 存在即不注册 importName 键。fn 名键
        # (libc_chmod,13654)照常注册,真 importc 调用字节不变。
        var importNameFunctionReturnType = ""
        if ctx.snapshotOnly:
            importNameFunctionReturnType =
                TypedExprLookupLocalFunctionReturnTypeFromMetadata(
                    ctx, ctx.importcFunctions[i].importName)
        else:
            importNameFunctionReturnType = TypedExprLookupLocalFunctionReturnType(
                ctx, ctx.importcFunctions[i].importName)
        if ctx.importcFunctions[i].importName.len > 0 &&
           importNameFunctionReturnType == "":
            TypedExprIrAddImportcDecl(ir,
                                      ctx.sourcePath,
                                      ctx.importcFunctions[i].importName,
                                      ctx.importcFunctions[i].returnType,
                                      targetSymbol,
                                      ctx.importcFunctions[i].paramTypeJoin)

@borrows
fn TypedExprIrLookupImportcReturnType(ir: TypedExprIr,
                                       sourcePathRaw: str,
                                       nameRaw: str): str =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let trimmedName = chengpath.PathTrim(nameRaw)
    # nameRaw may be a cross-module qualified call target ("qualifier.Fn"), but
    # ir.importcNames only ever stores the bare declaration name (T70): use the
    # qualified-call leaf extractor (dot-aware) instead of a plain identifier
    # prefix scan (which stops at the first '.' and would yield the qualifier,
    # not the function name) so qualified and unqualified callers match alike.
    let name = TypedExprQualifiedCallLeaf(trimmedName)
    if sourcePath == "" || (name == "" && trimmedName == ""):
        return ""
    var found = ""
    for i in 0..<ir.importcNames.len:
        if i >= ir.importcSourcePaths.len || i >= ir.importcReturnTypes.len:
            continue
        if ir.importcNames[i] != name && ir.importcNames[i] != trimmedName:
            continue
        if !TypedExprSourcePathsEquivalent(ir.importcSourcePaths[i], sourcePath):
            continue
        if found != "" && found != ir.importcReturnTypes[i]:
            return ""
        found = ir.importcReturnTypes[i]
    return found

@borrows
fn TypedExprIrLookupImportcParamTypeJoin(ir: TypedExprIr,
                                          sourcePathRaw: str,
                                          nameRaw: str): str =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let trimmedName = chengpath.PathTrim(nameRaw)
    # See TypedExprIrLookupImportcReturnType above: strip a qualifier prefix via
    # the dot-aware leaf extractor, not a plain identifier-prefix scan (T70).
    let name = TypedExprQualifiedCallLeaf(trimmedName)
    if sourcePath == "" || (name == "" && trimmedName == ""):
        return ""
    var found = ""
    var foundSet = false
    for i in 0..<ir.importcNames.len:
        if i >= ir.importcSourcePaths.len || i >= ir.importcParamTypeJoins.len:
            continue
        if ir.importcNames[i] != name && ir.importcNames[i] != trimmedName:
            continue
        if !TypedExprSourcePathsEquivalent(ir.importcSourcePaths[i], sourcePath):
            continue
        if foundSet && found != ir.importcParamTypeJoins[i]:
            return ""
        found = ir.importcParamTypeJoins[i]
        foundSet = true
    return found

@borrows
fn TypedExprIrLookupImportcTargetSymbol(ir: TypedExprIr,
                                         sourcePathRaw: str,
                                         nameRaw: str): str =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let trimmedName = chengpath.PathTrim(nameRaw)
    # See TypedExprIrLookupImportcReturnType above: strip a qualifier prefix via
    # the dot-aware leaf extractor, not a plain identifier-prefix scan (T70).
    # This is the callTargetImportc symbol lookup the backend uses to pick the
    # emitted link symbol for a call — a cross-module qualified call target
    # (e.g. "qualifier.Fn") must resolve to the same row an unqualified same-
    # module call to "Fn" would.
    let name = TypedExprQualifiedCallLeaf(trimmedName)
    if sourcePath == "" || (name == "" && trimmedName == ""):
        return ""
    var found = ""
    for i in 0..<ir.importcNames.len:
        if i >= ir.importcSourcePaths.len:
            continue
        if ir.importcNames[i] != name && ir.importcNames[i] != trimmedName:
            continue
        var symbol = ""
        if i < ir.importcTargetSymbols.len:
            symbol = ir.importcTargetSymbols[i]
        if symbol == "":
            symbol = ir.importcNames[i]
        if !TypedExprSourcePathsEquivalent(ir.importcSourcePaths[i], sourcePath):
            continue
        if found != "" && found != symbol:
            return ""
        found = symbol
    return found

@borrows
fn TypedExprQualifiedCallDot(nameRaw: str): int32 =
    let name = chengpath.PathTrim(share(nameRaw))
    var dotPos: int32 = -1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    for i in 0..<name.len:
        if name[i] == '[':
            bracketDepth = bracketDepth + 1
        elif name[i] == ']':
            bracketDepth = bracketDepth - 1
        elif name[i] == '(':
            parenDepth = parenDepth + 1
        elif name[i] == ')':
            parenDepth = parenDepth - 1
        elif name[i] == '{':
            braceDepth = braceDepth + 1
        elif name[i] == '}':
            braceDepth = braceDepth - 1
        elif name[i] == '.' && bracketDepth == 0 &&
             parenDepth == 0 && braceDepth == 0:
            dotPos = i
    return dotPos

@borrows
fn TypedExprQualifiedCallQualifier(nameRaw: str): str =
    let name = chengpath.PathTrim(share(nameRaw))
    let dotPos = TypedExprQualifiedCallDot(name)
    if dotPos <= 0:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(name, 0, dotPos))

@borrows
fn TypedExprQualifiedCallLeaf(nameRaw: str): str =
    let name = chengpath.PathTrim(share(nameRaw))
    let dotPos = TypedExprQualifiedCallDot(name)
    if dotPos < 0:
        return parser.ParserIdentPrefix(name)
    if dotPos + 1 >= name.len:
        return ""
    # 点尾续行的树跨度文本在点后携带原始换行/缩进(WA1 U1 合法表面), 叶名
    # 提取前剥首尾空白; 无空白输入恒等, 既有语料零行为差。
    return parser.ParserIdentPrefix(chengpath.PathTrim(chengpath.TextSlice(name, dotPos + 1, name.len - dotPos - 1)))

@borrows
fn TypedExprQualifiedCallSurface(qualifierRaw: str,
                                  calleeRaw: str): str =
    let callee = chengpath.PathTrim(calleeRaw)
    if callee == "":
        return ""
    let qualifier = chengpath.PathTrim(qualifierRaw)
    if qualifier == "":
        return callee
    return Fmt"{qualifier}.{callee}"

# (801 解封) 精简模式 selected-scopes 只保留含 persistent-fact 表达式的函数;
# 被调用但自身不含此类表达式的函数 (如 rsa.cheng rsaBytesXorExact) 不进 scope
# 表, 返回型查询落空 → 调用方 payload 整树拒建 (rhsNodeIndex=-1) → bail 801。
# scope 表有散失但源文件仍是唯一事实源。缓存归当前 source context 所有，
# 同一路径的新构建不会复用旧内容；每个 build context 最多扫描一次。
fn TypedExprFunctionHeaderScanContext(ctx: var TypedExprSourceContext) =
    let indexed = ctx.buildIndex != nil
    let persistIndexed = indexed && !ctx.buildIndex.frozenReadOnlyQueries
    if indexed && ctx.buildIndex.released:
        panic("typed expr: function header scan on released build index")
    if !persistIndexed && ctx.functionHeaderScanned:
        return
    if indexed:
        var scannedValue: str
        if TypedExprBuildIndexLookupContentCache(ctx.buildIndex,
                                                  "function_header_scanned",
                                                  parser.ParserNormalizePath(ctx.sourcePath),
                                                  "",
                                                  scannedValue) == TypedExprBuildIndexUnique:
            return
    var scanSplit: str[]
    if ctx.lines.len > 0:
        scanSplit = ctx.lines
    else:
        var scanSourceText = chengpath.ReadTextFile("", ctx.sourcePath)
        if scanSourceText == "":
            scanSourceText = os.ReadFile(chengpath.PathProviderFilePath(ctx.sourcePath))
        if scanSourceText == "":
            return
        # byte-loop line split (10 = newline); avoids char literals entirely.
        var scanLineStart = 0
        for scanPos in 0..<scanSourceText.len:
            if int32(scanSourceText[scanPos]) == 10:
                add(scanSplit, chengpath.TextSlice(scanSourceText, scanLineStart, scanPos - scanLineStart))
                scanLineStart = scanPos + 1
        if scanLineStart < scanSourceText.len:
            add(scanSplit, chengpath.TextSlice(scanSourceText, scanLineStart, scanSourceText.len - scanLineStart))
    if !persistIndexed:
        ctx.functionHeaderLookup = parser.ParserSourcePathIndexLookupInit(
            typedExprCheckedAddInt32(scanSplit.len, 8,
                                     "function_header_lookup_capacity"))
        ctx.functionHeaderNames = []
        ctx.functionHeaderReturnTypes = []
    for scanI in 0..<scanSplit.len:
        let scanLine = scanSplit[scanI]
        if !parser.ParserStartsWith(scanLine, "fn "):
            continue
        let scanName = parser.ParserIdentPrefix(chengpath.TextSlice(scanLine, 3, scanLine.len - 3))
        if scanName == "":
            continue
        let scanHeader = TypedExprFunctionDeclHeaderText(scanSplit, scanI + 1)
        if scanHeader == "":
            continue
        let returnType = TypedExprParseFunctionReturnType(scanHeader)
        if persistIndexed:
            TypedExprBuildIndexRegisterContentCache(share(ctx.buildIndex),
                                                     "function_header_return",
                                                     parser.ParserNormalizePath(ctx.sourcePath),
                                                     scanName,
                                                     returnType)
            continue
        if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(ctx.functionHeaderLookup,
                                                                       scanName) >= 0:
            continue
        let entryIndex = ctx.functionHeaderNames.len
        add(ctx.functionHeaderNames, share(scanName))
        add(ctx.functionHeaderReturnTypes, returnType)
        parser.ParserSourcePathIndexLookupInsertExact(ctx.functionHeaderLookup,
                                                      parser.ParserOwnedText(scanName),
                                                      entryIndex)
    if persistIndexed:
        let sourcePath = parser.ParserNormalizePath(ctx.sourcePath)
        TypedExprBuildIndexRegisterContentCache(share(ctx.buildIndex),
                                                 "function_header_scanned",
                                                 share(sourcePath),
                                                 "",
                                                 sourcePath)
    else:
        ctx.functionHeaderScanned = true

@borrows
fn TypedExprScanSourceFunctionReturnType(ctx: var TypedExprSourceContext,
                                          name: str): str =
    if name == "" || ctx.sourcePath == "":
        return ""
    if ctx.snapshotOnly:
        panic(Fmt"typed expr: snapshot-only function signature missing source={ctx.sourcePath} function={name}")
    TypedExprFunctionHeaderScanContext(ctx)
    if ctx.buildIndex != nil:
        var returnType: str
        let state = TypedExprBuildIndexLookupContentCache(ctx.buildIndex,
                                                           "function_header_return",
                                                           parser.ParserNormalizePath(ctx.sourcePath),
                                                           name,
                                                           returnType)
        if state == TypedExprBuildIndexUnique:
            return share(returnType)
        if !ctx.buildIndex.frozenReadOnlyQueries ||
           !ctx.functionHeaderScanned:
            return ""
    let entryIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(ctx.functionHeaderLookup,
                                                                                  name)
    if entryIndex < 0:
        return ""
    if entryIndex >= ctx.functionHeaderReturnTypes.len:
        panic("typed expr: corrupt function header build cache")
    return share(ctx.functionHeaderReturnTypes[entryIndex])

@borrows
fn typedExprLocalFunctionLookupNameOwned(nameRaw: str): str =
    let nameInput = parser.ParserOwnedText(nameRaw)
    let trimmed = chengpath.PathTrim(nameInput)
    var name = parser.ParserIdentPrefix(trimmed)
    if name == "":
        # Operator/backtick function names (e.g. "[]=", "[]", "%") are not
        # valid identifiers; fall back to an exact-match lookup so they can
        # be resolved after the parser registers them in scopes.
        name = trimmed
    return name

@borrows
fn typedExprLookupLocalFunctionReturnTypeFromNormalizedMetadata(
        ctx: var TypedExprSourceContext,
        name: str): str =
    if name == "":
        return ""
    if ctx.buildIndex != nil && ctx.buildIndex.callDeclarationSealed:
        var declarationRow: int32
        let declarationState = typedExprLocalFunctionNameRow(
            ctx, name, declarationRow)
        if declarationState == TypedExprBuildIndexUnique:
            let returnType = typedExprBuildIndexCallReturnType(
                ctx.buildIndex, declarationRow)
            if returnType == "":
                return "void"
            return parser.ParserOwnedText(returnType)
        if declarationState == TypedExprBuildIndexAmbiguous:
            return ""
    let namedScopeIndex = TypedExprScopeIndexByName(ctx, name)
    if namedScopeIndex >= 0:
        if ctx.scopes[namedScopeIndex].returnType == "":
            return "void"
        return share(ctx.scopes[namedScopeIndex].returnType)
    # exe 可达裁剪轮次兜底：过滤轮 ctx.scopes 只含本轮函数，全量签名表见
    # signatureScopes（AttachStableMetadataToRebuildContext 挂载；非过滤路径恒空）。
    for i in 0..<ctx.signatureScopes.len:
        if ctx.signatureScopes[i].name == name:
            if ctx.signatureScopes[i].returnType == "":
                return "void"
            return share(ctx.signatureScopes[i].returnType)
    return ""

@borrows
fn TypedExprLookupLocalFunctionReturnTypeFromMetadata(
        ctx: var TypedExprSourceContext,
        nameRaw: str): str =
    let name = typedExprLocalFunctionLookupNameOwned(nameRaw)
    return typedExprLookupLocalFunctionReturnTypeFromNormalizedMetadata(
        ctx, name)

@borrows
fn TypedExprLookupLocalFunctionReturnType(ctx: var TypedExprSourceContext,
                                            nameRaw: str): str =
    let name = typedExprLocalFunctionLookupNameOwned(nameRaw)
    let metadataReturnType =
        typedExprLookupLocalFunctionReturnTypeFromNormalizedMetadata(ctx, name)
    if metadataReturnType != "":
        return metadataReturnType
    # (801) 非过滤路径 signatureScopes 恒空; selected-scopes 散失的函数 (rsa.cheng
    # rsaBytesXorExact 形态) 最终兜底 = 懒扫源文件 fn 头缓存 (见上方 helper)。
    return TypedExprScanSourceFunctionReturnType(ctx, name)

@borrows
fn TypedExprLocalFunctionNamePrefixCompare(index: TypedExprBuildIndex,
                                             rowIndex: int32,
                                             sourcePath: str,
                                             name: str): int32 =
    var result = TypedExprCallDeclarationTextCompare(
        typedExprBuildIndexCallSourcePath(index, rowIndex), sourcePath)
    if result != 0:
        return result
    return TypedExprCallDeclarationTextCompare(
        typedExprBuildIndexCallName(index, rowIndex), name)


@borrows
fn typedExprLocalFunctionNameRow(ctx: TypedExprSourceContext,
                                 nameRaw: str,
                                 rowOut: var int32): TypedExprBuildIndexLookupState =
    rowOut = -1
    let trimmed = chengpath.PathTrim(nameRaw)
    var name = parser.ParserIdentPrefix(trimmed)
    if name == "":
        # Backtick operator declarations store their unquoted operator token.
        name = trimmed
    var sourcePathRaw = ctx.normalizedSourcePath
    if sourcePathRaw == "":
        sourcePathRaw = ctx.sourcePath
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    if sourcePath == "" || name == "":
        return TypedExprBuildIndexMissing
    let index = ctx.buildIndex
    if index == nil:
        panic(Fmt"typed expr: local function name query without build index source={sourcePath} function={name}")
    if index.released:
        panic(Fmt"typed expr: local function name query on released build index source={sourcePath} function={name}")
    if !index.callDeclarationSealed:
        panic(Fmt"typed expr: local function name query before declaration seal source={sourcePath} function={name}")
    let rowCount = typedExprBuildIndexCallDeclarationCount(index)
    if index.callDeclarationSortedRows.len != rowCount ||
       index.callDeclarationKinds.len != rowCount ||
       index.callDeclarationResultExprClasses.len != rowCount:
        panic("typed expr: local function name query declaration columns mismatch")
    var low: int32
    var high = rowCount
    while low < high:
        let middle = low + (high - low) / 2
        let rowIndex = index.callDeclarationSortedRows[middle]
        if rowIndex < 0 || rowIndex >= rowCount:
            panic("typed expr: local function name query sorted row corrupt")
        if TypedExprLocalFunctionNamePrefixCompare(index,
                                                    rowIndex,
                                                    sourcePath,
                                                    name) < 0:
            low = middle + 1
        else:
            high = middle
    var cursor = low
    var found = false
    while cursor < rowCount:
        let rowIndex = index.callDeclarationSortedRows[cursor]
        if rowIndex < 0 || rowIndex >= rowCount:
            panic("typed expr: local function name query sorted row corrupt")
        if TypedExprLocalFunctionNamePrefixCompare(index,
                                                    rowIndex,
                                                    sourcePath,
                                                    name) != 0:
            break
        if index.callDeclarationKinds[rowIndex] ==
           TypedExprCallDeclarationFunction:
            if found:
                rowOut = -1
                return TypedExprBuildIndexAmbiguous
            found = true
            rowOut = rowIndex
        cursor = cursor + 1
    if found:
        return TypedExprBuildIndexUnique
    rowOut = -1
    return TypedExprBuildIndexMissing

@borrows
fn TypedExprLocalFunctionNameState(ctx: TypedExprSourceContext,
                                    nameRaw: str): TypedExprBuildIndexLookupState =
    var rowIndex: int32
    return typedExprLocalFunctionNameRow(ctx, nameRaw, rowIndex)


@borrows
fn TypedExprContextImportAllowsUnqualifiedCallAt(ctx: TypedExprSourceContext,
                                                  localIndex: int32): bool =
    if ctx.frozenMetadataProjection != nil:
        let contextIndex = ctx.frozenMetadataContextIndex
        if contextIndex < 0 ||
           contextIndex >= ctx.frozenMetadataProjection.importStarts.len ||
           contextIndex >= ctx.frozenMetadataProjection.importCounts.len ||
           localIndex < 0 ||
           localIndex >= ctx.frozenMetadataProjection.importCounts[contextIndex]:
            panic("typed expr: frozen import row out of range")
        let rowIndex =
            ctx.frozenMetadataProjection.importStarts[contextIndex] +
            localIndex
        return ctx.frozenMetadataProjection.importAllowsUnqualifiedCalls[rowIndex]
    if localIndex < 0 || localIndex >= ctx.importedModules.len:
        panic("typed expr: import row out of range")
    return ctx.importedModules[localIndex].allowsUnqualifiedCall


fn TypedExprLocalFunctionNameExists(ctx: var TypedExprSourceContext,
                                     nameRaw: str): bool =
    let state = TypedExprLocalFunctionNameState(ctx, nameRaw)
    return state == TypedExprBuildIndexUnique ||
           state == TypedExprBuildIndexAmbiguous

@borrows
fn TypedExprContextImportCount(ctx: TypedExprSourceContext): int32 =
    if ctx.frozenMetadataProjection != nil:
        let contextIndex = ctx.frozenMetadataContextIndex
        if contextIndex < 0 ||
           contextIndex >= ctx.frozenMetadataProjection.importCounts.len:
            panic("typed expr: frozen import context identity missing")
        return ctx.frozenMetadataProjection.importCounts[contextIndex]
    return ctx.importedModules.len

@borrows
fn TypedExprContextImportTargetAt(ctx: TypedExprSourceContext,
                                  localIndex: int32): str =
    if ctx.frozenMetadataProjection != nil:
        let contextIndex = ctx.frozenMetadataContextIndex
        if contextIndex < 0 ||
           contextIndex >= ctx.frozenMetadataProjection.importStarts.len ||
           contextIndex >= ctx.frozenMetadataProjection.importCounts.len ||
           localIndex < 0 ||
           localIndex >= ctx.frozenMetadataProjection.importCounts[contextIndex]:
            panic("typed expr: frozen import row out of range")
        let rowIndex =
            ctx.frozenMetadataProjection.importStarts[contextIndex] +
            localIndex
        return typedExprFrozenProjectionText(
            ctx.frozenMetadataProjection,
            ctx.frozenMetadataProjection.importTargetSourcePathIds[rowIndex])
    if localIndex < 0 || localIndex >= ctx.importedModules.len:
        panic("typed expr: import row out of range")
    return ctx.importedModules[localIndex].targetSourcePath


@borrows
fn TypedExprLookupImportedModuleSourcePath(ctx: TypedExprSourceContext,
                                             qualifierRaw: str): str =
    let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(share(qualifierRaw)))
    if qualifier == "":
        return ""
    var targetSourcePath: str
    let state = TypedExprBuildIndexLookupFingerprint(ctx.buildIndex,
                                                      "ctx_import_alias",
                                                      parser.ParserNormalizePath(parser.ParserOwnedText(ctx.sourcePath)),
                                                      qualifier,
                                                      "",
                                                      targetSourcePath)
    if state != TypedExprBuildIndexUnique:
        return ""
    return targetSourcePath

@borrows
fn TypedExprLookupQualifiedModuleSourcePath(currentCtx: TypedExprSourceContext,
                                              sourceContexts: TypedExprSourceContext[],
                                              qualifierChainRaw: str): str =
    let qualifierChain = chengpath.PathTrim(share(qualifierChainRaw))
    if qualifierChain == "":
        return ""
    let qualifierParts = parser.ParserSplitChar(qualifierChain, '.')
    var contextIndex: int32 = -1
    var targetSourcePath = ""
    for i in 0..<qualifierParts.len:
        let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(share(qualifierParts[i])))
        if qualifier == "":
            return ""
        if contextIndex < 0:
            targetSourcePath = TypedExprLookupImportedModuleSourcePath(currentCtx, qualifier)
        else:
            targetSourcePath = TypedExprLookupImportedModuleSourcePath(sourceContexts[contextIndex],
                                                                        qualifier)
        if targetSourcePath == "":
            return ""
        if i + 1 >= qualifierParts.len:
            return targetSourcePath
        let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetSourcePath)
        if targetIndex < 0:
            return ""
        contextIndex = targetIndex
    return targetSourcePath

fn TypedExprLookupQualifiedModuleSourcePathWithContextFallback(currentCtx: var TypedExprSourceContext,
                                                                sourceContexts: var TypedExprSourceContext[],
                                                                qualifierChainRaw: str): str =
    let targetSourcePath = TypedExprLookupQualifiedModuleSourcePath(currentCtx,
                                                                    sourceContexts,
                                                                    qualifierChainRaw)
    if targetSourcePath != "":
        return targetSourcePath
    let currentSourceContextIndex = TypedExprSourceContextLookup(sourceContexts,
                                                                 currentCtx.sourcePath)
    if currentSourceContextIndex < 0 ||
       currentSourceContextIndex >= sourceContexts.len:
        return ""
    return TypedExprLookupQualifiedModuleSourcePath(sourceContexts[currentSourceContextIndex],
                                                   sourceContexts,
                                                   qualifierChainRaw)

fn TypedExprLoadSourceContextWithScopes(sourcePathRaw: str,
                                         ctxOut: var TypedExprSourceContext,
                                         err: var str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    if sourcePath == "":
        err = " typed expr: empty scoped source context path"
        return false
    var sourceText = chengpath.ReadTextFile("", sourcePath)
    if sourceText == "":
        sourceText = os.ReadFile(chengpath.PathProviderFilePath(sourcePath))
    if sourceText == "":
        err = Fmt" typed expr: missing scoped source context text source={sourcePath}"
        return false
    var sourceForContext = TypedExprSourceTextNew("", "", sourcePath, sourceText)
    if !TypedExprBuildSourceContextBorrowed(sourceForContext,
                                            ctxOut,
                                            true,
                                            false,
                                            true,
                                            TypedExprFunctionFilterIndex(),
                                            err):
        if err != "":
            err = strutil.Join(
                [" typed expr: scoped source context failed: ",
                 strings.CloneStr(err)], "")
        else:
            err = " typed expr: scoped source context failed"
        return false
    return ctxOut.scopes.len > 0

@borrows
fn TypedExprSourceHasDeclaredType(ctx: TypedExprSourceContext,
                                    typeNameRaw: str): bool =
    let typeName = TypedExprTypeLeafName(typeNameRaw)
    if typeName == "":
        return false
    var contextIndex: int32
    return TypedExprBuildIndexLookup(ctx.buildIndex,
                                     "ctx_declared_source",
                                     parser.ParserNormalizePath(ctx.sourcePath),
                                     typeName,
                                     "",
                                     contextIndex) == TypedExprBuildIndexUnique

@borrows
fn TypedExprSourceHasRefType(ctx: TypedExprSourceContext,
                              typeNameRaw: str): bool =
    let typeName = TypedExprTypeLeafName(typeNameRaw)
    if typeName == "":
        return false
    var contextIndex: int32
    return TypedExprBuildIndexLookup(ctx.buildIndex,
                                     "ctx_ref_source",
                                     parser.ParserNormalizePath(ctx.sourcePath),
                                     typeName,
                                     "",
                                     contextIndex) == TypedExprBuildIndexUnique

@borrows
fn TypedExprQualifiedTypeDot(typeRaw: str): int32 =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    var dotPos: int32 = -1
    for i in 0..<typeText.len:
        if typeText[i] == '.':
            dotPos = i
    return dotPos

@borrows
fn TypedExprTypeIsNamedCompositeInAnyContext(sourceContexts: TypedExprSourceContext[],
                                              typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return false
    let leaf = TypedExprTypeLeafName(typeText)
    if leaf == "":
        return false
    var contextIndex: int32
    let index = TypedExprContextsBuildIndex(sourceContexts)
    let declaredState = TypedExprBuildIndexLookup(index,
                                                   "ctx_declared_global", "", leaf, "", contextIndex)
    if declaredState != TypedExprBuildIndexMissing:
        return true
    return TypedExprBuildIndexLookup(index,
                                     "ctx_field_owner_global", "", leaf, "", contextIndex) != TypedExprBuildIndexMissing

@borrows
fn TypedExprTypeIsNamedCompositeInContext(currentCtx: TypedExprSourceContext,
                                            sourceContexts: TypedExprSourceContext[],
                                            typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return false
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(typeText, 0, dotPos))
        let leaf = chengpath.PathTrim(chengpath.TextSlice(typeText, dotPos + 1, typeText.len - dotPos - 1))
        if qualifier == "" || leaf == "":
            return false
        let targetSourcePath = TypedExprLookupQualifiedModuleSourcePath(currentCtx, sourceContexts, qualifier)
        let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetSourcePath)
        if targetIndex < 0:
            return false
        return TypedExprSourceHasDeclaredType(sourceContexts[targetIndex], leaf) ||
               TypedExprContextHasTypeField(sourceContexts[targetIndex], leaf)
    if TypedExprSourceHasDeclaredType(currentCtx, typeText):
        return true
    if TypedExprContextHasTypeField(currentCtx, typeText):
        return true
    var importedContextIndex: int32
    return TypedExprBuildIndexLookup(currentCtx.buildIndex,
                                     "ctx_import_composite",
                                     parser.ParserNormalizePath(currentCtx.sourcePath),
                                     TypedExprTypeLeafName(typeText),
                                     "",
                                     importedContextIndex) == TypedExprBuildIndexUnique

# `T(field: value, ...)` is an object-constructor surface when `T` resolves to
# a real composite and every supplied field exists in that composite layout.
# Field values are deliberately not typed here: nested calls belong to the
# constructor expression and may not have standalone static types yet.
@borrows
fn TypedExprNamedAggregateFieldExistsInOwner(
        ownerCtx: TypedExprSourceContext,
        ownerTypeRaw: str,
        fieldNameRaw: str): bool =
    let ownerType = TypedExprTypeLeafName(ownerTypeRaw)
    let fieldName = parser.ParserIdentPrefix(
        chengpath.PathTrim(fieldNameRaw))
    if ownerType == "" || fieldName == "":
        return false
    # [phaseB-parser] 入口源文件命名构造通道根修（分类层精确直查）：
    # build-index/投影节点查找通道之外，owner ctx 自身的 typeFields 精确
    # 坐标列（compiler csg BindMetadataExactLayout 绑定，冻结 ctx 经
    # typedExprContextFieldAt 读投影列）是同一份权威数据的直接视图。
    # 本臂按 (ownerType, fieldName) 精确配对直查，坐标判据与索引通道完全
    # 一致（producerSourceIndex >= 0 && ordinal >= 0）；已工作形状在索引
    # 通道命中，零改动。
    var directRowCount: int32
    if ownerCtx.frozenMetadataProjection != nil:
        let projectionContextIndex = ownerCtx.frozenMetadataContextIndex
        if projectionContextIndex < 0 ||
           projectionContextIndex >=
               ownerCtx.frozenMetadataProjection.fieldCounts.len:
            return false
        directRowCount =
            ownerCtx.frozenMetadataProjection.fieldCounts[
                projectionContextIndex]
    else:
        directRowCount = ownerCtx.typeFields.len
    var directField: TypedExprTypeFieldDecl
    for directIndex in 0..<directRowCount:
        if !typedExprContextFieldAt(ownerCtx, directIndex, directField):
            continue
        if TypedExprTypeLeafName(directField.ownerType) == ownerType &&
           directField.fieldName == fieldName:
            return directField.producerSourceIndex >= 0 &&
                   directField.ordinal >= 0
    if ownerCtx.buildIndex == nil ||
       !ownerCtx.buildIndex.frozenReadOnlyQueries:
        return false
    var nodeIndex: int32
    let state = TypedExprBuildIndexLookup(
        ownerCtx.buildIndex,
        "ctx_field_source",
        parser.ParserNormalizePath(ownerCtx.sourcePath),
        ownerType,
        fieldName,
        nodeIndex)
    var contextIndex: int32
    var rowIndex: int32
    if state != TypedExprBuildIndexUnique ||
       !TypedExprBuildIndexContextFieldNode(
           ownerCtx.buildIndex,
           nodeIndex,
           contextIndex,
           rowIndex):
        return false
    var field: TypedExprTypeFieldDecl
    if !typedExprContextFieldAt(ownerCtx, rowIndex, field):
        return false
    return TypedExprTypeLeafName(field.ownerType) == ownerType &&
           field.fieldName == fieldName &&
           field.producerSourceIndex >= 0 &&
           field.ordinal >= 0

@borrows
fn TypedExprNamedAggregateFieldExists(
        currentCtx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        ownerType: str,
        fieldName: str): bool =
    let contextIndex = TypedExprFieldContextLookup(
        currentCtx,
        sourceContexts,
        ownerType)
    if contextIndex == -2:
        return TypedExprNamedAggregateFieldExistsInOwner(
            currentCtx,
            ownerType,
            fieldName)
    if contextIndex < 0 || contextIndex >= sourceContexts.len:
        return false
    return TypedExprNamedAggregateFieldExistsInOwner(
        sourceContexts[contextIndex],
        ownerType,
        fieldName)

@borrows
fn TypedExprNamedAggregateConstructorTypeInContext(
        currentCtx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        constructorHeadRaw: str,
        argsTextRaw: str): str =
    let constructorType = TypedExprNormalizeTypeText(constructorHeadRaw)
    if constructorType == "":
        return ""
    var fieldNames: str[]
    var invalidReason: str
    let validNamedSurface = TypedExprConstructorNamedFieldsInto(argsTextRaw,
                                                                 fieldNames,
                                                                 invalidReason)
    if !validNamedSurface && invalidReason == "":
        return ""
    var typeCtx = TypedExprSourceContextBorrowedView(currentCtx)
    let metadataContextIndex = TypedExprSourceContextLookup(sourceContexts,
                                                             currentCtx.sourcePath)
    if metadataContextIndex >= 0:
        typeCtx = TypedExprSourceContextBorrowedView(
            sourceContexts[metadataContextIndex])
    var typeState = TypedExprBuildIndexMissing
    if TypedExprQualifiedTypeDot(constructorType) > 0:
        if TypedExprTypeIsNamedCompositeInContext(typeCtx,
                                                   sourceContexts,
                                                   constructorType):
            typeState = TypedExprBuildIndexUnique
    elif TypedExprSourceHasDeclaredType(typeCtx, constructorType) ||
         TypedExprContextHasTypeField(typeCtx, constructorType):
        typeState = TypedExprBuildIndexUnique
    else:
        var importedContextIndex: int32
        typeState = TypedExprBuildIndexLookup(
            typeCtx.buildIndex,
            "ctx_import_composite",
            parser.ParserNormalizePath(typeCtx.sourcePath),
            TypedExprTypeLeafName(constructorType),
            "",
            importedContextIndex)
    if typeState == TypedExprBuildIndexAmbiguous:
        panic("ambiguous object constructor type")
    if typeState != TypedExprBuildIndexUnique:
        return ""
    if !validNamedSurface:
        panic(invalidReason)
    for fieldIndex in 0..<fieldNames.len:
        if !TypedExprNamedAggregateFieldExists(
                typeCtx,
                sourceContexts,
                constructorType,
                fieldNames[fieldIndex]):
            panic("unknown object constructor field")
    return constructorType

@borrows
fn TypedExprNamedAggregateConstructorBindingTypeInContext(
        currentCtx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        rhsRaw: str): str =
    var constructorHead: str
    var argsText: str
    var parenthesized: bool
    if !TypedExprConstructorBindingSurface(rhsRaw,
                                            constructorHead,
                                            argsText,
                                            parenthesized):
        return ""
    return TypedExprNamedAggregateConstructorTypeInContext(currentCtx,
                                                            sourceContexts,
                                                            constructorHead,
                                                            argsText)

@borrows
fn TypedExprTypeIsRefObjectInContext(currentCtx: TypedExprSourceContext,
                                      sourceContexts: TypedExprSourceContext[],
                                      typeRaw: str): bool =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    if typeText == "":
        return false
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(share(typeText), 0, dotPos))
        let leaf = chengpath.PathTrim(chengpath.TextSlice(share(typeText), dotPos + 1, typeText.len - dotPos - 1))
        if qualifier == "" || leaf == "":
            return false
        let targetSourcePath = TypedExprLookupQualifiedModuleSourcePath(currentCtx, sourceContexts, qualifier)
        let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetSourcePath)
        if targetIndex < 0:
            return false
        return TypedExprSourceHasRefType(sourceContexts[targetIndex], leaf)
    if TypedExprSourceHasRefType(currentCtx, typeText):
        return true
    var importedContextIndex: int32
    return TypedExprBuildIndexLookup(currentCtx.buildIndex,
                                     "ctx_import_ref",
                                     parser.ParserNormalizePath(currentCtx.sourcePath),
                                     TypedExprTypeLeafName(typeText),
                                     "",
                                     importedContextIndex) == TypedExprBuildIndexUnique

@borrows
fn TypedExprLookupTypeAliasTargetInContext(currentCtx: TypedExprSourceContext,
                                            sourceContexts: TypedExprSourceContext[],
                                            typeRaw: str): str =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return ""
    let dotPos = TypedExprQualifiedTypeDot(typeText)
    var leafName = share(typeText)
    if dotPos > 0:
        let qualifier = chengpath.PathTrim(chengpath.TextSlice(typeText, 0, dotPos))
        leafName = chengpath.PathTrim(chengpath.TextSlice(typeText, dotPos + 1, typeText.len - dotPos - 1))
        if qualifier == "" || leafName == "":
            return ""
        let targetSourcePath = TypedExprLookupQualifiedModuleSourcePath(currentCtx, sourceContexts, qualifier)
        let targetIndex = TypedExprSourceContextLookup(sourceContexts, targetSourcePath)
        if targetIndex < 0:
            return ""
        let aliasName = parser.ParserIdentPrefix(leafName)
        return TypedExprNormalizeTypeText(TypedExprContextTypeDefAliasTarget(sourceContexts[targetIndex], aliasName))
    let aliasName = parser.ParserIdentPrefix(leafName)
    let currentTarget = TypedExprContextTypeDefAliasTarget(currentCtx, aliasName)
    if currentTarget != "":
        return TypedExprNormalizeTypeText(currentTarget)
    var targetType: str
    let currentSourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
    let state = TypedExprBuildIndexLookupFingerprint(currentCtx.buildIndex,
                                                      "ctx_import_alias_def", currentSourcePath, aliasName, "", targetType)
    if state != TypedExprBuildIndexUnique:
        return ""
    return TypedExprNormalizeTypeText(targetType)

# Enum types lower as int32-class scalars. The per-context enum tables hold
# the unqualified enum type name, so match on the qualifier-stripped leaf.
@borrows
fn TypedExprTypeIsEnumInContexts(currentCtx: TypedExprSourceContext,
                                  sourceContexts: TypedExprSourceContext[],
                                  typeRaw: str): bool =
    let leafName = TypedExprTypeLeafName(typeRaw)
    if leafName == "":
        return false
    var rowIndex: int32
    let currentState = TypedExprBuildIndexLookup(currentCtx.buildIndex,
                                                  "ctx_enum_type_source",
                                                  parser.ParserNormalizePath(currentCtx.sourcePath),
                                                  leafName,
                                                  "",
                                                  rowIndex)
    if currentState == TypedExprBuildIndexUnique:
        return true
    if currentState == TypedExprBuildIndexAmbiguous:
        return false
    # [b11 本源 ctx 列臂] 枚举类型存在性的本源权威列（metadata 构建收集，
    # 重建 context 由 AttachStableMetadataToRebuildContext 克隆）。索引缺席
    # 的相（单源 metadata 相 buildIndex=nil）此前对该列无任何类型名读者
    # （B9 缺口 C 同域：既有枚举臂只查 build index）。
    for enumTypeScan in 0..<currentCtx.enumValueTypes.len:
        if TypedExprTypeLeafName(
                   currentCtx.enumValueTypes[enumTypeScan]) == leafName:
            return true
    let importedState = TypedExprBuildIndexLookup(currentCtx.buildIndex,
                                                   "ctx_import_enum_type",
                                                   parser.ParserNormalizePath(currentCtx.sourcePath),
                                                   leafName,
                                                   "",
                                                   rowIndex)
    if importedState == TypedExprBuildIndexUnique:
        return true
    # [b11 流式相跨模块枚举回退] 跳2 的 visibility 合同依赖索引内
    # ctx_import_target 导入边；边的 Core 登记要求目标 context 在索引内，
    # 流式相不可能成立，跳2 在该相恒 Missing。回退本源 importedModules 表
    # （metadata 构建收集、重建 context 由 AttachStableMetadataToRebuild-
    # Context 克隆；B9 限定臂同款权威）作可见性边：只查消费方声明导入的
    # 目标源的 ctx_enum_type_source 精确登记行。唯一命中→true，多目标命中
    # →false（fail-closed，与 VisibleLookup 的 Unique/Ambiguous 语义一致），
    # 零命中→落回原门。查询仍是提供方精确登记行，非放宽。
    var enumImportHits: int32
    var enumIndexHandle = TypedExprContextsBuildIndex(sourceContexts)
    if enumIndexHandle == nil:
        enumIndexHandle = currentCtx.buildIndex
    if enumIndexHandle != nil:
        let ownEnumSourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
        for importedScan in 0..<currentCtx.importedModules.len:
            let importedTargetPath = parser.ParserNormalizePath(
                currentCtx.importedModules[importedScan].targetSourcePath)
            if importedTargetPath == "" ||
               importedTargetPath == ownEnumSourcePath:
                continue
            var enumHitRowIndex: int32
            let importedEnumState = TypedExprBuildIndexLookup(
                enumIndexHandle,
                "ctx_enum_type_source",
                importedTargetPath,
                leafName,
                "",
                enumHitRowIndex)
            if importedEnumState == TypedExprBuildIndexUnique:
                enumImportHits = enumImportHits + 1
            elif importedEnumState == TypedExprBuildIndexAmbiguous:
                enumImportHits = enumImportHits + 2
        if enumImportHits == 1:
            return true
        if enumImportHits > 1:
            return false
    if parser.ParserNormalizePath(currentCtx.sourcePath) != "":
        return false
    return TypedExprBuildIndexLookup(TypedExprContextsBuildIndex(sourceContexts),
                                     "ctx_enum_type_global", "", leafName, "", rowIndex) == TypedExprBuildIndexUnique

@borrows
fn TypedExprAbiClassForTypeInContext(currentCtx: TypedExprSourceContext,
                                       sourceContexts: TypedExprSourceContext[],
                                       typeRaw: str): TypedExprAbiClass =
    let abiClass = TypedExprAbiClassForType(typeRaw)
    if abiClass != TypedExprAbiPolymorphic:
        return abiClass
    # Enum check precedes alias chasing: `Name = enum` is recorded as a
    # degenerate alias to "enum", which would otherwise recurse to nothing.
    if TypedExprTypeIsEnumInContexts(currentCtx, sourceContexts, typeRaw):
        return TypedExprAbiScalar
    # [phaseB-csg] 本源值聚合字段行直查（先于别名跳）：`type N = object` /
    # alias(Tuple) 声明头会登记成伪别名（alias[N]="object" 形状关键字，非
    # 真实别名目标；与 TypedExprIrCanonicalFieldMetaState 字段行直查调序
    # 修复同一病灶族），别名优先把本源 object 类型劫持到形状关键字文本，
    # ABI 判定随之落 Polymorphic。ctx.typeFields 精确坐标列（compiler csg
    # exact-layout 绑定）是值聚合布局存在的直接证明：ownerType leaf 精确
    # 配对且坐标已绑定（producer>=0 ∧ ordinal>=0）→ Composite。ref object
    # 先经既有 ref 判定排除（值是指针句柄）；普通别名无字段行，零改动。
    if !TypedExprTypeIsRefObjectInContext(currentCtx, sourceContexts, typeRaw):
        let aggregateLeaf = TypedExprTypeLeafName(typeRaw)
        if aggregateLeaf != "":
            for aggregateFieldIndex in 0..<currentCtx.typeFields.len:
                if TypedExprTypeLeafName(
                           currentCtx.typeFields[aggregateFieldIndex].ownerType) ==
                       aggregateLeaf &&
                       currentCtx.typeFields[aggregateFieldIndex].producerSourceIndex >= 0 &&
                       currentCtx.typeFields[aggregateFieldIndex].ordinal >= 0:
                    return TypedExprAbiComposite
    let aliasTarget = TypedExprLookupTypeAliasTargetInContext(currentCtx, sourceContexts, share(typeRaw))
    if aliasTarget != "" && aliasTarget != typeRaw:
        return TypedExprAbiClassForTypeInContext(currentCtx, sourceContexts, aliasTarget)
    if TypedExprPointerPointeeType(currentCtx, sourceContexts, typeRaw) != "":
        return TypedExprAbiPointerLike
    if TypedExprTypeIsRefObjectInContext(currentCtx, sourceContexts, typeRaw):
        return TypedExprAbiPointerLike
    if TypedExprTypeIsNamedCompositeInContext(currentCtx, sourceContexts, share(typeRaw)):
        return TypedExprAbiComposite
    if TypedExprTypeIsNamedCompositeInAnyContext(sourceContexts, share(typeRaw)):
        return TypedExprAbiComposite
    return TypedExprAbiPolymorphic

@borrows
fn TypedExprLookupUnqualifiedImportedFunctionReturnType(currentCtx: TypedExprSourceContext,
                                                          sourceContexts: TypedExprSourceContext[],
                                                          nameRaw: str,
                                                          argsTextRaw: str,
                                                          lineNumber: int32,
                                                          targetSourcePathOut: var str,
                                                          targetImportcOut: var bool): str =
    targetSourcePathOut = ""
    targetImportcOut = false
    var returnType: str
    var targetSymbol: str
    var declarationRow: int32
    let state = TypedExprResolveCallDeclarationFromText(currentCtx,
                                                        sourceContexts,
                                                        "",
                                                        nameRaw,
                                                        nameRaw,
                                                        argsTextRaw,
                                                        lineNumber,
                                                        targetSourcePathOut,
                                                        returnType,
                                                        targetSymbol,
                                                        targetImportcOut,
                                                        declarationRow)
    if state != TypedExprBuildIndexUnique:
        return ""
    if TypedExprSourcePathsEquivalent(targetSourcePathOut, currentCtx.sourcePath):
        targetSourcePathOut = ""
        targetImportcOut = false
        return ""
    return returnType

@borrows
fn TypedExprResolveQualifiedCallTargetReturnType(currentCtx: TypedExprSourceContext,
                                                  sourceContexts: TypedExprSourceContext[],
                                                  qualifierRaw: str,
                                                  calleeRaw: str,
                                                  targetRaw: str,
                                                  argsTextRaw: str,
                                                  lineNumber: int32,
                                                  targetSourcePathOut: var str,
                                                  targetNameOut: var str,
                                                  targetSignatureLineNumberOut: var int32,
                                                  targetImportcOut: var bool): str =
    targetSourcePathOut = ""
    targetNameOut = ""
    targetSignatureLineNumberOut = 0
    targetImportcOut = false
    var qualifier = chengpath.PathTrim(qualifierRaw)
    let target = chengpath.PathTrim(targetRaw)
    if qualifier == "" && target != "":
        qualifier = TypedExprQualifiedCallQualifier(target)
    var callee = TypedExprQualifiedCallLeaf(chengpath.PathTrim(calleeRaw))
    if callee == "" && target != "":
        callee = TypedExprQualifiedCallLeaf(target)
    if qualifier == "" || callee == "":
        return ""
    if sourceContexts.len <= 0 && qualifier == "os":
        targetSourcePathOut = currentCtx.sourcePath
        targetImportcOut = true
        var osReturnType = ""
        if callee == "WriteLine":
            osReturnType = "void"
        elif callee == "GetCurrentDir":
            osReturnType = "str"
        elif callee == "Get_stdout" || callee == "Get_stderr" || callee == "Get_stdin":
            osReturnType = "int32"
        if osReturnType != "":
            targetNameOut = callee
            return osReturnType
        targetSourcePathOut = ""
        return ""
    if sourceContexts.len <= 0:
        let knownReturnType = TypedExprKnownQualifiedCallReturnType(
            share(qualifier), share(callee))
        if knownReturnType != "":
            targetSourcePathOut = currentCtx.sourcePath
            targetNameOut = callee
            return knownReturnType
    var returnType: str
    var targetSymbol: str
    var declarationRow: int32
    let state = TypedExprResolveCallDeclarationFromText(currentCtx,
                                                        sourceContexts,
                                                        qualifier,
                                                        share(callee),
                                                        target,
                                                        argsTextRaw,
                                                        lineNumber,
                                                        targetSourcePathOut,
                                                        returnType,
                                                        targetSymbol,
                                                        targetImportcOut,
                                                        declarationRow)
    if state != TypedExprBuildIndexUnique:
        return ""
    targetNameOut = callee
    targetSignatureLineNumberOut =
        typedExprBuildIndexCallSignatureLineNumber(currentCtx.buildIndex,
                                                    declarationRow)
    return returnType

@borrows
fn TypedExprResolveCallTargetReturnType(currentCtx: TypedExprSourceContext,
                                         sourceContexts: TypedExprSourceContext[],
                                         qualifierRaw: str,
                                         calleeRaw: str,
                                         targetRaw: str,
                                         argsTextRaw: str,
                                         lineNumber: int32,
                                         surfaceCallKind: TypedExprSurfaceCallKind,
                                         targetSourcePathOut: var str,
                                         targetNameOut: var str,
                                         targetSignatureLineNumberOut: var int32,
                                         targetImportcOut: var bool): str =
    targetSourcePathOut = ""
    targetNameOut = ""
    targetSignatureLineNumberOut = 0
    targetImportcOut = false
    let qualifier = chengpath.PathTrim(qualifierRaw)
    let callee = TypedExprQualifiedCallLeaf(chengpath.PathTrim(calleeRaw))
    var targetName = share(callee)
    if targetName == "":
        targetName = TypedExprQualifiedCallLeaf(targetRaw)
    if callee == "" && targetName == "":
        return ""
    if qualifier != "" && surfaceCallKind != TypedExprSurfaceCallMember:
        return TypedExprResolveQualifiedCallTargetReturnType(currentCtx,
                                                             sourceContexts,
                                                             qualifier,
                                                             callee,
                                                             targetRaw,
                                                             argsTextRaw,
                                                             lineNumber,
                                                             targetSourcePathOut,
                                                             targetNameOut,
                                                             targetSignatureLineNumberOut,
                                                             targetImportcOut)
    var returnType: str
    var targetSymbol: str
    var declarationRow: int32
    let state = TypedExprResolveCallDeclarationFromText(currentCtx,
                                                        sourceContexts,
                                                        "",
                                                        share(targetName),
                                                        targetRaw,
                                                        argsTextRaw,
                                                        lineNumber,
                                                        targetSourcePathOut,
                                                        returnType,
                                                        targetSymbol,
                                                        targetImportcOut,
                                                        declarationRow)
    if state != TypedExprBuildIndexUnique:
        var uniqueReturn = ""
        var uniqueLine: int32
        uniqueLine = 0
        targetNameOut = strings.CloneStr(callee)
        if TypedExprStaticUniqueCalleeIdentity(currentCtx,
                                               callee,
                                               uniqueReturn,
                                               uniqueLine):
            targetSourcePathOut = parser.ParserNormalizePath(currentCtx.sourcePath)
            targetSignatureLineNumberOut = uniqueLine
            return uniqueReturn
        targetNameOut = ""
        return ""
    targetNameOut = strings.CloneStr(callee)
    targetSignatureLineNumberOut =
        typedExprBuildIndexCallSignatureLineNumber(currentCtx.buildIndex,
                                                    declarationRow)
    if targetSignatureLineNumberOut <= 0:
        var uniqueReturn = ""
        var uniqueLine: int32
        uniqueLine = 0
        if TypedExprStaticUniqueCalleeIdentity(currentCtx,
                                               callee,
                                               uniqueReturn,
                                               uniqueLine):
            targetSignatureLineNumberOut = uniqueLine
    return returnType

@borrows
fn TypedExprLookupPreresolvedCallTargetSignatureFromFact(
        currentCtx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        fact: var TypedExprFact,
        targetSignatureLineNumberOut: var int32): str =
    targetSignatureLineNumberOut = 0
    if !fact.callResolved || fact.callTargetSourcePath == "" ||
       fact.callTarget == "":
        return ""
    if currentCtx.buildIndex == nil:
        panic("typed expr: preresolved call query without structured index")
    # Same unique (source, target) row the fact builder uses.  Arg-type
    # ranking stays below for overloads; do not write the looked-up line
    # back onto the fact.
    var nameSourceRow: int32
    # The fact may still carry the parser's qualified call surface
    # (`layout.ByteBufAppendByte`) when reached from the fact builder, while
    # declaration rows are keyed by the leaf name the post-build target
    # canonicalization stores.  Look up by that leaf; an unqualified target
    # is already a leaf and is unchanged.  (source, leaf) uniqueness keeps
    # this an exact identity read, never a synthesis.
    var nameSourceLookupName = TypedExprQualifiedCallLeaf(fact.callTarget)
    if nameSourceLookupName == "":
        nameSourceLookupName = fact.callTarget
    let nameSourceState = TypedExprBuildIndexLookup(
        currentCtx.buildIndex,
        "ctx_function_decl_name_source",
        parser.ParserNormalizePath(fact.callTargetSourcePath),
        nameSourceLookupName,
        "",
        nameSourceRow)
    if nameSourceState == TypedExprBuildIndexUnique:
        targetSignatureLineNumberOut =
            typedExprBuildIndexCallSignatureLineNumber(currentCtx.buildIndex,
                                                       nameSourceRow)
        return TypedExprCallRuntimeType(
            parser.ParserOwnedText(
                typedExprBuildIndexCallReturnType(currentCtx.buildIndex,
                                                  nameSourceRow)))
    var scopeIndex = TypedExprScopeIndexForLine(currentCtx.scopes,
                                                fact.lineNumber)
    var scope: TypedExprFunctionScope
    if scopeIndex >= 0:
        scope = currentCtx.scopes[scopeIndex]
    else:
        scopeIndex = TypedExprScopeIndexForLine(currentCtx.signatureScopes,
                                                fact.lineNumber)
        if scopeIndex >= 0:
            scope = currentCtx.signatureScopes[scopeIndex]
        else:
            scope.sourcePath = currentCtx.sourcePath
            scope.name = ""
            scope.startLine = 1
            scope.endLine = currentCtx.lines.len
            scope.genericNamesComplete = true
    var explicitGenericTypes: str[]
    var explicitGenericPresent = false
    var baseCallHead: str
    var genericErr: str
    let callHead = TypedExprQualifiedCallSurface(fact.callQualifier,
                                                  fact.callCallee)
    if !TypedExprCallHeadGenericTypesInto(callHead,
                                           explicitGenericTypes,
                                           explicitGenericPresent,
                                           baseCallHead,
                                           genericErr):
        panic(Fmt"{genericErr} source={currentCtx.sourcePath} line={fact.lineNumber}")
    var argTypes: str[]
    TypedExprBindingNameIndexPrepare(currentCtx)
    if !TypedExprCallStaticArgTypesInto(currentCtx,
                                         sourceContexts,
                                         scope,
                                         fact.lineNumber,
                                         fact.callArgsText,
                                         argTypes):
        return ""
    if currentCtx.buildIndex == nil:
        panic("typed expr: preresolved call query without structured index")
    var declarationRow: int32
    var matchRank: int32
    var explicitContractMismatch = false
    var declarationKind = TypedExprCallDeclarationFunction
    if fact.callTargetImportc:
        declarationKind = TypedExprCallDeclarationImportc
    let state = TypedExprBuildIndexLookupCallDeclarationInSourceForArgOwner(
        currentCtx.buildIndex,
        fact.callTargetSourcePath,
        fact.callTarget,
        declarationKind,
        currentCtx.sourcePath,
        argTypes,
        explicitGenericTypes,
        explicitGenericPresent,
        declarationRow,
        matchRank,
        explicitContractMismatch)
    if explicitContractMismatch:
        panic(Fmt"typed expr: preresolved call generic contract drift source={currentCtx.sourcePath} target_source={fact.callTargetSourcePath} target={fact.callTarget} line={fact.lineNumber}")
    if state == TypedExprBuildIndexAmbiguous:
        panic(Fmt"typed expr: preresolved call declaration ambiguous source={currentCtx.sourcePath} target_source={fact.callTargetSourcePath} target={fact.callTarget} line={fact.lineNumber}")
    if state != TypedExprBuildIndexUnique:
        return ""
    targetSignatureLineNumberOut =
        typedExprBuildIndexCallSignatureLineNumber(currentCtx.buildIndex,
                                                   declarationRow)
    if targetSignatureLineNumberOut <= 0:
        var uniqueReturn = ""
        var uniqueLine: int32
        uniqueLine = 0
        if TypedExprStaticUniqueCalleeIdentity(currentCtx,
                                               fact.callTarget,
                                               uniqueReturn,
                                               uniqueLine):
            targetSignatureLineNumberOut = uniqueLine
    return TypedExprCallDeclarationResolvedReturnTypeForArgOwner(
        currentCtx.buildIndex,
        declarationRow,
        currentCtx.sourcePath,
        argTypes,
        explicitGenericTypes,
        explicitGenericPresent)

@borrows
fn TypedExprLookupPreresolvedCallTargetReturnTypeFromFact(
        currentCtx: var TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        fact: var TypedExprFact): str =
    var signatureLine: int32
    let returnType = TypedExprLookupPreresolvedCallTargetSignatureFromFact(
        currentCtx, sourceContexts, fact, signatureLine)
    if returnType != "":
        fact.callTargetSignatureLineNumber = signatureLine
    return returnType

@borrows
fn TypedExprLookupCallTargetReturnTypeFromFact(currentCtx: var TypedExprSourceContext,
                                                sourceContexts: TypedExprSourceContext[],
                                                 fact: var TypedExprFact): str =
    var resolvedSourcePath = ""
    var resolvedTargetName = ""
    var resolvedTargetSignatureLineNumber: int32
    var resolvedImportc = false
    let resolvedReturnType = TypedExprResolveCallTargetReturnType(currentCtx,
                                                                  sourceContexts,
                                                                  fact.callQualifier,
                                                                  fact.callCallee,
                                                                  fact.callTarget,
                                                                  fact.callArgsText,
                                                                  fact.lineNumber,
                                                                  fact.surfaceCallKind,
                                                                  resolvedSourcePath,
                                                                  resolvedTargetName,
                                                                  resolvedTargetSignatureLineNumber,
                                                                  resolvedImportc)
    if resolvedReturnType != "":
        fact.callResolved = true
        fact.callReason = TypedExprCallReasonNone
        fact.callTarget = resolvedTargetName
        fact.callTargetSourcePath = resolvedSourcePath
        fact.callTargetSignatureLineNumber =
            resolvedTargetSignatureLineNumber
        fact.callTargetImportc = resolvedImportc
        return resolvedReturnType
    return TypedExprLookupPreresolvedCallTargetReturnTypeFromFact(
        currentCtx, sourceContexts, fact)

@borrows
fn TypedExprCountFunctionParams(lineRaw: str): int32 =
    let line = chengpath.PathTrim(lineRaw)
    let openPos = parser.ParserFindText(line, "(")
    if openPos < 0:
        return 0
    let closePos = TypedExprFindMatchingParen(line, openPos)
    if closePos <= openPos:
        return 0
    let paramsText = chengpath.TextSlice(line, openPos + 1, closePos - openPos - 1)
    let trimmed = chengpath.PathTrim(paramsText)
    if trimmed == "":
        return 0
    let params = TypedExprSplitTopLevelCsv(trimmed)
    return params.len

@borrows
fn TypedExprTypeContainsIdentifier(typeTextRaw: str,
                                    ident: str): bool =
    let typeText = TypedExprNormalizeTypeText(typeTextRaw)
    if typeText == "" || ident == "":
        return false
    var searchStart: int32
    while searchStart < typeText.len:
        let pos = parser.ParserFindText(chengpath.TextSlice(typeText,
                                                             searchStart,
                                                             typeText.len - searchStart),
                                        ident)
        if pos < 0:
            return false
        let absPos = searchStart + pos
        var before: char
        if absPos > 0:
            before = typeText[absPos - 1]
        let afterPos = absPos + ident.len
        var after: char
        if afterPos < typeText.len:
            after = typeText[afterPos]
        var beforeIdent: bool
        if before >= 'a' && before <= 'z':
            beforeIdent = true
        elif before >= 'A' && before <= 'Z':
            beforeIdent = true
        elif before >= '0' && before <= '9':
            beforeIdent = true
        elif before == '_':
            beforeIdent = true
        var afterIdent: bool
        if after >= 'a' && after <= 'z':
            afterIdent = true
        elif after >= 'A' && after <= 'Z':
            afterIdent = true
        elif after >= '0' && after <= '9':
            afterIdent = true
        elif after == '_':
            afterIdent = true
        if !beforeIdent && !afterIdent:
            return true
        searchStart = absPos + ident.len
    return false

@borrows
fn TypedExprTypeContainsSabiBoundary(typeTextRaw: str): bool =
    if TypedExprTypeContainsIdentifier(typeTextRaw, "utf8_view"):
        return true
    if TypedExprTypeContainsIdentifier(typeTextRaw, "bytes_view"):
        return true
    if TypedExprTypeContainsIdentifier(typeTextRaw, "owned_cstring"):
        return true
    return false

@borrows
fn TypedExprTypeContainsSabiView(typeTextRaw: str): bool =
    if TypedExprTypeContainsIdentifier(typeTextRaw, "utf8_view"):
        return true
    if TypedExprTypeContainsIdentifier(typeTextRaw, "bytes_view"):
        return true
    return false

@borrows
fn TypedExprTypeContainsOwnedCString(typeTextRaw: str): bool =
    return TypedExprTypeContainsIdentifier(typeTextRaw, "owned_cstring")

@borrows
fn TypedExprFfiMapParamIsSlice(typeTextRaw: str): bool =
    # @ffi_map is the ZRPC boundary transform for a Cheng dynamic slice.  A
    # fixed array or an arbitrary composite is not layout-compatible with the
    # physical (ptr,len) pair and must not be accepted by shape coincidence.
    return TypedExprIrTypeTextIsSeq(typeTextRaw)

@borrows
fn TypedExprValidateFfiAnnotations(decl: parser.NormalizedFunctionDecl,
                                    paramCount: int32,
                                    params: TypedExprParam[],
                                    returnType: str,
                                    isCAbi: bool): str[] =
    var errors: str[]
    # pure selfhost: `str != ""` on empty {data:null,len:0} has been observed
    # true (enter ffiOutPtrArgs arm, SplitCsv/PathTrim OOB). Gate on .len and
    # i32/bool fields only for the empty/default path.
    let hasFfiMap = decl.ffiMapPtrArg >= 0 || decl.ffiMapLenArg >= 0
    let hasFfiOut = decl.ffiOutPtrArgs.len > 0
    let hasOwned = decl.ffiOwnedResultPresent
    if !decl.abiInternal && !hasFfiMap && !hasFfiOut && !hasOwned:
        if isCAbi && TypedExprTypeContainsOwnedCString(returnType):
            add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: owned_cstring return requires @ffi_owned_result(free=symbol)")
        return errors
    if decl.abiInternal && !isCAbi:
        add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: @abi_internal requires @importc or @exportc")
    if hasFfiMap:
        if !isCAbi:
            add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: @ffi_map requires @importc or @exportc")
        if decl.ffiMapPtrArg < 0 || decl.ffiMapLenArg < 0:
            add(errors, Fmt"@{decl.name}: @ffi_map requires both ptr and len args")
        var pi: int32
        pi = 0
        while pi < params.len:
            if TypedExprTypeContainsStrAbiValue(params[pi].typeText):
                add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: @ffi_map(str) is forbidden; use utf8_view or cstring")
            pi = pi + 1
        if decl.ffiMapPtrArg >= 0 && decl.ffiMapLenArg >= 0:
            # argN names physical C-ABI positions, not logical Cheng
            # parameters.  A slice contributes exactly (ptr,len); every other
            # logical parameter contributes one physical position.
            var physicalParamCount: int32
            var sliceCount: int32
            var expectedPtrArg: int32 = -1
            var expectedLenArg: int32 = -1
            pi = 0
            while pi < params.len:
                if TypedExprFfiMapParamIsSlice(params[pi].typeText):
                    if sliceCount == 0:
                        expectedPtrArg = physicalParamCount
                        expectedLenArg = physicalParamCount + 1
                    sliceCount = sliceCount + 1
                    physicalParamCount = physicalParamCount + 2
                else:
                    physicalParamCount = physicalParamCount + 1
                pi = pi + 1
            if sliceCount != 1:
                add(errors, Fmt"ZRPC violation at @{decl.name}: @ffi_map requires exactly one dynamic slice parameter (found={sliceCount})")
            elif decl.ffiMapPtrArg >= physicalParamCount ||
                 decl.ffiMapLenArg >= physicalParamCount:
                add(errors, Fmt"@{decl.name}: @ffi_map physical arg index out of range (physical param count={physicalParamCount})")
            elif decl.ffiMapPtrArg != expectedPtrArg ||
                 decl.ffiMapLenArg != expectedLenArg:
                add(errors, Fmt"ZRPC violation at @{decl.name}: @ffi_map layout mismatch expected ptr=arg{expectedPtrArg} len=arg{expectedLenArg} actual ptr=arg{decl.ffiMapPtrArg} len=arg{decl.ffiMapLenArg}")
    if hasFfiOut:
        if !isCAbi:
            add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: @ffi_out_ptrs requires @importc or @exportc")
        let parts = TypedExprSplitTopLevelCsv(decl.ffiOutPtrArgs)
        var i: int32
        i = 0
        while i < parts.len:
            let part = chengpath.PathTrim(parts[i])
            if part.len <= 0:
                i = i + 1
                continue
            var idx: int32
            var j: int32
            j = 0
            while j < part.len:
                let ch = part[j]
                if ch >= '0' && ch <= '9':
                    idx = idx * 10 + Int32(ch - '0')
                j = j + 1
            if idx < 0 || idx >= paramCount:
                add(errors, Fmt"@{decl.name}: @ffi_out_ptrs arg index {idx} out of range (param count={paramCount})")
            i = i + 1
    if hasOwned:
        if decl.ffiOwnedResultFree.len <= 0:
            add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: @ffi_owned_result requires free=symbol")
        if !isCAbi:
            add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: @ffi_owned_result requires @importc or @exportc")
        if !TypedExprTypeContainsOwnedCString(returnType):
            add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: @ffi_owned_result requires owned_cstring return")
    if isCAbi:
        if TypedExprTypeContainsOwnedCString(returnType):
            if !hasOwned:
                add(errors, Fmt"ZRPC/SABI violation at @{decl.name}: owned_cstring return requires @ffi_owned_result(free=symbol)")
    return errors

@borrows
fn TypedExprTypeContainsStrAbiValue(typeTextRaw: str): bool =
    return TypedExprTypeContainsIdentifier(typeTextRaw, "str")

@borrows
fn TypedExprDeclHasExportcAnnotation(
        decl: parser.NormalizedFunctionDecl): bool =
    return decl.explicitExportName != ""

@borrows
fn TypedExprValidateStrCAbiBridge(sourcePath: str,
                                  decl: parser.NormalizedFunctionDecl,
                                  declHeader: str,
                                  params: TypedExprParam[],
                                  returnType: str,
                                  exportc: bool): str[] =
    # [ledgerwalk-1] params/returnType 改由调用方传入（四处调用点全部已持有
    # 同一 declHeader 的解析结果）。原先每 decl 第三次全量
    # FunctionParamsInto+ParseFunctionReturnType 的暂存分配（诊断梯子 valid
    # 站点 28.4%，145802 活块/全仓）就此消失；解析函数与输入行不变，
    # 结果逐字节恒等。
    TypedExprTraceLine("typed_str_cabi:enter")
    var errors: str[]
    let isCAbi = decl.importc || exportc
    if decl.abiInternal:
        TypedExprTraceLine("typed_str_cabi:abi_internal")
        if !isCAbi:
            add(errors, Fmt"ZRPC/SABI violation at {sourcePath}:{decl.lineIndex}: @abi_internal requires @importc or @exportc")
        return errors
    if !isCAbi:
        TypedExprTraceLine("typed_str_cabi:non_cabi")
        for i in 0..<params.len:
            TypedExprTraceLine("typed_str_cabi:non_cabi_param_loop")
            if TypedExprTypeContainsSabiBoundary(params[i].typeText):
                add(errors, Fmt"ZRPC/SABI violation at {sourcePath}:{decl.lineIndex}: SABI boundary type `{params[i].typeText}` is only valid at @importc/@exportc boundaries")
        TypedExprTraceLine("typed_str_cabi:non_cabi_before_return_check")
        if TypedExprTypeContainsSabiBoundary(returnType):
            add(errors, Fmt"ZRPC/SABI violation at {sourcePath}:{decl.lineIndex}: SABI boundary return `{returnType}` is only valid at @importc/@exportc boundaries")
        TypedExprTraceLine("typed_str_cabi:non_cabi_done")
        return errors
    TypedExprTraceLine("typed_str_cabi:cabi")
    for i in 0..<params.len:
        TypedExprTraceLine("typed_str_cabi:cabi_param_loop")
        if TypedExprTypeContainsStrAbiValue(params[i].typeText):
            add(errors, Fmt"ZRPC/SABI violation at {sourcePath}:{decl.lineIndex}: C ABI function {decl.name} exposes Cheng str parameter `{params[i].name}` directly. Use utf8_view or cstring.")
        if TypedExprTypeContainsOwnedCString(params[i].typeText):
            add(errors, Fmt"ZRPC/SABI violation at {sourcePath}:{decl.lineIndex}: owned_cstring is only valid as a C ABI return boundary")
    TypedExprTraceLine("typed_str_cabi:cabi_after_params")
    if TypedExprTypeContainsSabiView(returnType):
        add(errors, Fmt"ZRPC/SABI violation at {sourcePath}:{decl.lineIndex}: {returnType} is only valid as a C ABI parameter boundary")
    TypedExprTraceLine("typed_str_cabi:cabi_after_view_return")
    if TypedExprTypeContainsStrAbiValue(returnType):
        if decl.ffiOutPtrArgs == "":
            add(errors, Fmt"ZRPC/SABI violation at {sourcePath}:{decl.lineIndex}: C ABI function {decl.name} exposes Cheng str return value directly. Use owned_cstring with @ffi_owned_result or explicit cstring.")
    TypedExprTraceLine("typed_str_cabi:done")
    return errors

fn TypedExprFirstExprColumnAfter(ctx: var TypedExprSourceContext,
                                   lineNumber: int32,
                                   minColumn: int32): int32 =
    let lineIndex = TypedExprSourceContextLineIndex(ctx, lineNumber)
    if lineIndex < 0 || lineIndex >= ctx.exprLineColumnHeads.len:
        return -1
    var bestColumn: int32 = -1
    var columnIndex = ctx.exprLineColumnHeads[lineIndex]
    var visited: int32
    while columnIndex >= 0:
        assert(columnIndex < ctx.exprLineColumnValues.len &&
               columnIndex < ctx.exprLineColumnNext.len,
               "typed expr: corrupt line-column chain")
        let exprColumnNumber = ctx.exprLineColumnValues[columnIndex]
        if exprColumnNumber < minColumn:
            columnIndex = ctx.exprLineColumnNext[columnIndex]
            visited = visited + 1
            assert(visited <= ctx.exprLineColumnValues.len,
                   "typed expr: cyclic line-column chain")
            continue
        if bestColumn < 0 || exprColumnNumber < bestColumn:
            bestColumn = exprColumnNumber
        columnIndex = ctx.exprLineColumnNext[columnIndex]
        visited = visited + 1
        assert(visited <= ctx.exprLineColumnValues.len,
               "typed expr: cyclic line-column chain")
    return bestColumn

@borrows
fn TypedExprLineHasRootReturn(lineRaw: str,
                                ctx: var TypedExprSourceContext,
                                expr: parser.NormalizedExpr): bool =
    let firstToken = parser.ParserFirstToken(chengpath.PathTrim(lineRaw))
    if firstToken != "return":
        return false
    let returnPos = parser.ParserFindText(lineRaw, "return")
    if returnPos < 0:
        return false
    let exprStart = returnPos + Len("return") + 1
    let rootExprColumn = TypedExprFirstExprColumnAfter(ctx,
                                                         expr.lineNumber,
                                                         exprStart)
    return rootExprColumn == expr.columnNumber

@borrows
fn TypedExprSourceContextForPathOrCurrent(currentCtx: TypedExprSourceContext,
                                            sourceContexts: TypedExprSourceContext[],
                                            sourcePathRaw: str): TypedExprSourceContext =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    if sourcePath == "":
        return TypedExprSourceContextBorrowedView(currentCtx)
    let currentSourcePath = parser.ParserNormalizePath(currentCtx.sourcePath)
    if sourcePath == currentCtx.normalizedSourcePath || sourcePath == currentSourcePath:
        return TypedExprSourceContextBorrowedView(currentCtx)
    let ctxIndex = TypedExprSourceContextLookup(sourceContexts, sourcePath)
    if ctxIndex < 0:
        return TypedExprSourceContextBorrowedView(currentCtx)
    return TypedExprSourceContextBorrowedView(sourceContexts[ctxIndex])

@borrows
fn TypedExprComprehensionFilterIf(lineRaw: str,
                                    expr: parser.NormalizedExpr): bool =
    if expr.kind != parser.NormalizedExprIf ||
       expr.detailKind != parser.NormalizedExprDetailIfKeyword:
        return false
    let exprPos = expr.columnNumber - 1
    for openPos in 0..<lineRaw.len:
        if lineRaw[openPos] != '[':
            continue
        var itemText = ""
        var bindingText = ""
        var sourceText = ""
        var filterText = ""
        var filterColumn = -1
        var endColumn = -1
        if !parser.ParserParseListComprehensionAt(lineRaw,
                                                    openPos,
                                                    itemText,
                                                    bindingText,
                                                    sourceText,
                                                    filterText,
                                                    filterColumn,
                                                    endColumn):
            continue
        if filterColumn == expr.columnNumber:
            return true
        if filterColumn > 0 && filterColumn - 1 == exprPos:
            return true
    return false

@borrows
fn TypedExprExtractTypeGenericArg(typeRaw: str): str =
    let typeText = TypedExprNormalizeTypeText(typeRaw)
    let openPos = TypedExprFindTopLevelToken(typeText, "[")
    if openPos < 0 || openPos + 1 >= typeText.len:
        return ""
    let closePos = TypedExprFindMatchingBracket(typeText, openPos)
    if closePos <= openPos || closePos + 1 != typeText.len:
        return ""
    return TypedExprNormalizeTypeText(chengpath.TextSlice(typeText, openPos + 1, closePos - openPos - 1))

@borrows
fn TypedExprInferredResultInputType(ctx: var TypedExprSourceContext,
                                      scopeIndex: int32,
                                      expr: parser.NormalizedExpr): str =
    if expr.kind == parser.NormalizedExprTry:
        let lineRaw = TypedExprSourceLine(ctx, expr.lineNumber)
        if lineRaw == "":
            return ""
        let token = parser.ParserPreviousToken(lineRaw, expr.columnNumber - 1)
        return TypedExprLookupBindingType(ctx, scopeIndex, expr.lineNumber, token)
    if expr.kind != parser.NormalizedExprResultIntrinsic:
        return ""
    if expr.callArgCount <= 0:
        return ""
    let args = TypedExprSplitTopLevelCsv(expr.callArgsText)
    if args.len != expr.callArgCount:
        panic(Fmt"typed expr: Result intrinsic structured argument cardinality drift source={ctx.sourcePath} line={expr.lineNumber} count={expr.callArgCount} text={expr.callArgsText}")
    let argText = chengpath.PathTrim(args[0])
    let argName = parser.ParserIdentPrefix(argText)
    if argName == "":
        return ""
    return TypedExprLookupBindingType(ctx, scopeIndex, expr.lineNumber, argName)

@borrows
fn TypedExprSinkForExpr(ctx: var TypedExprSourceContext,
                          expr: parser.NormalizedExpr): TypedExprSinkInfo =
    var sink: TypedExprSinkInfo
    sink.sinkType = ""
    sink.sinkPlaceKind = TypedExprPlaceTemporary
    sink.hasSink = false
    sink.returnRoot = false
    sink.functionReturnType = ""
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, expr.lineNumber)
    if scopeIndex >= 0:
        sink.functionReturnType = ctx.scopes[scopeIndex].returnType
    let lineRaw = TypedExprSourceLine(ctx, expr.lineNumber)
    if lineRaw == "":
        return sink
    var bindingName = ""
    var bindingType = ""
    var rhsStartColumn: int32 = -1
    if TypedExprParseBindingLine(lineRaw, bindingName, bindingType, rhsStartColumn):
        let bindingRoot = TypedExprFirstExprColumnAfter(ctx,
                                                          expr.lineNumber,
                                                          rhsStartColumn)
        if bindingRoot == expr.columnNumber:
            sink.sinkType = bindingType
            sink.sinkPlaceKind = TypedExprPlaceGlobal
            if scopeIndex >= 0:
                sink.sinkPlaceKind = TypedExprPlaceLocal
            sink.hasSink = true
    var returnRoot = TypedExprLineHasRootReturn(lineRaw, ctx, expr)
    if !returnRoot:
        if scopeIndex >= 0:
            if ctx.scopes[scopeIndex].startLine == expr.lineNumber:
                let eqPos = TypedExprFindTopLevelTextToken(lineRaw, "=")
                if eqPos >= 0:
                    let inlineRootColumn = TypedExprFirstExprColumnAfter(ctx,
                                                                         expr.lineNumber,
                                                                         eqPos + 2)
                    returnRoot = inlineRootColumn == expr.columnNumber
    if returnRoot:
        if sink.functionReturnType != "":
            sink.sinkType = sink.functionReturnType
            sink.sinkPlaceKind = TypedExprPlaceTemporary
            sink.hasSink = true
            sink.returnRoot = true
    return sink

@borrows
fn TypedExprApplyResolvedType(fact: var TypedExprFact,
                                abiCtx: var TypedExprSourceContext,
                                sourceContexts: var TypedExprSourceContext[],
                                typeRaw: str,
                                sink: TypedExprSinkInfo,
                                forceCallResult: bool) =
    let typeText = TypedExprNormalizeTypeText(share(typeRaw))
    if typeText == "":
        return
    fact.typeText = share(typeText)
    fact.abiClass = TypedExprAbiClassForTypeInContext(abiCtx, sourceContexts, typeText)
    fact.valueKind = TypedExprValueKindForAbiClass(fact.abiClass)
    if forceCallResult:
        fact.placeKind = TypedExprPlaceCallResult
    elif sink.hasSink:
        fact.placeKind = sink.sinkPlaceKind
    else:
        fact.placeKind = TypedExprPlaceTemporary
    if fact.abiClass == TypedExprAbiPolymorphic:
        fact.loweringMode = TypedExprLowerDeferred
        fact.returnKind = TypedExprReturnDeferred
        return
    if fact.abiClass == TypedExprAbiScalar || fact.abiClass == TypedExprAbiPointerLike:
        fact.loweringMode = TypedExprLowerReg
        fact.returnKind = TypedExprReturnReg
        return
    if sink.returnRoot && sink.sinkType == typeText:
        fact.loweringMode = TypedExprLowerReg
        if fact.abiClass == TypedExprAbiComposite:
            fact.loweringMode = TypedExprLowerSret
        fact.returnKind = TypedExprReturnKindForResolved(fact.abiClass, fact.loweringMode)
        return
    if fact.abiClass == TypedExprAbiComposite:
        fact.loweringMode = TypedExprLowerLocalAddress
        fact.returnKind = TypedExprReturnKindForResolved(fact.abiClass, fact.loweringMode)
        return
    fact.loweringMode = TypedExprLowerReg
    fact.returnKind = TypedExprReturnKindForResolved(fact.abiClass, fact.loweringMode)

# [zero-arg-ctor] THE one predicate for "this call is a zero-argument
# construction of a declared type".  It answers with the exact type text the
# construction names, or "" when the call is not that shape.  Both the fact
# producer (`TypedExprBuildFactInto`) and the re-validating pass
# (`TypedExprFactsValidateCallResolutionRangeWithPreparedContext`) call it:
# the producer leaves `surfaceCallKind` at None for exactly this shape, and
# the re-validator must recognise exactly the same shape or the two disagree
# and the build dies with `call surface kind drift` -- which is what an
# unqualified `T()` (e.g. `var out = LsmrAddress()`) used to do, because the
# re-validator only knew the qualified half of the shape.
@borrows
fn TypedExprZeroArgTypeConstructorTypeName(
        ctx: TypedExprSourceContext,
        sourceContexts: TypedExprSourceContext[],
        expr: parser.NormalizedExpr): str =
    if expr.callArgCount > 0 ||
       !TypedExprSymbolExportedByCase(expr.callCallee):
        return ""
    if expr.callQualifier != "":
        let typeSourcePath = TypedExprLookupQualifiedModuleSourcePath(
            ctx, sourceContexts, expr.callQualifier)
        let typeSourceIndex = TypedExprSourceContextLookup(
            sourceContexts, typeSourcePath)
        if typeSourceIndex >= 0 &&
           TypedExprSourceHasDeclaredType(
               sourceContexts[typeSourceIndex], expr.callCallee):
            return Fmt"{expr.callQualifier}.{expr.callCallee}"
        return ""
    if TypedExprSourceHasDeclaredType(ctx, expr.callCallee):
        return share(expr.callCallee)
    return ""

@borrows
fn TypedExprStableExprId(sourcePath: str,
                          lineNumber: int32,
                          columnNumber: int32,
                          kind: parser.NormalizedExprKind,
                          detailKind: parser.NormalizedExprDetailKind): str =
    let _ = sourcePath
    return Fmt"{IntToStr(lineNumber)}:{IntToStr(columnNumber)}:{IntToStr(parser.NormalizedExprKindCode(kind))}:{IntToStr(parser.NormalizedExprDetailKindCode(detailKind))}"

@borrows
fn TypedExprExprStableId(expr: parser.NormalizedExpr): str =
    if expr.exprId != "":
        return share(expr.exprId)
    return TypedExprStableExprId(expr.sourcePath,
                                  expr.lineNumber,
                                  expr.columnNumber,
                                  expr.kind,
                                  expr.detailKind)

@borrows
fn TypedExprBuildFactInto(ctx: var TypedExprSourceContext,
                            sourceContexts: var TypedExprSourceContext[],
                            valueExprTree: parser.ParserValueExprTree,
                            expr: parser.NormalizedExpr,
                            fact: var TypedExprFact,
                            sliceScratch: var TypedExprSliceResolutionScratch,
                            exprIndex: int32) =
    let subTime = TypedExprSubTimeEnabled()
    var bfT0: int64
    if subTime:
        typedExprSubTimeLastPreflight = 0
        typedExprSubTimeLastResolve = 0
    fact = TypedExprFact()
    if subTime:
        bfT0 = TypedExprSubTimeNowNs()
    fact.exprId = TypedExprExprStableId(expr)
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeBfStableId, bfT0)
    fact.sourcePath = ctx.sourcePath
    fact.lineNumber = expr.lineNumber
    fact.columnNumber = expr.columnNumber
    fact.endLineNumber = expr.endLineNumber
    fact.endColumnNumber = expr.endColumnNumber
    fact.lexicalScopeId = expr.lexicalScopeId
    fact.suiteScopeId = expr.suiteScopeId
    fact.statementOrdinal = expr.statementOrdinal
    fact.lexicalOrdinal = expr.lexicalOrdinal
    fact.deferOwnerStatementOrdinal = expr.deferOwnerStatementOrdinal
    fact.kind = expr.kind
    fact.surfaceCallKind = TypedExprSurfaceCallNone
    fact.callResolved = false
    fact.callReason = TypedExprCallReasonNone
    fact.callQualifier = ""
    fact.callCallee = ""
    fact.callTarget = ""
    fact.callTargetSourcePath = ""
    fact.callTargetImportc = false
    fact.callPrefixStyle = false
    fact.callArgCount = 0
    fact.callArgsText = ""
    fact.valueExprCallNodeIndex = expr.valueExprCallNodeIndex
    fact.originParserNodeId = expr.originParserNodeId
    fact.valueExprArgRootStart = expr.callArgValueRootStart
    fact.valueExprArgRootCount = expr.callArgValueRootCount
    fact.valueExprRootNodeIndex = expr.valueExprRootNodeIndex
    fact.valueExprSpanStart = expr.valueExprSpanStart
    fact.valueExprSpanEnd = expr.valueExprSpanEnd
    fact.valueExprStatementRole = expr.valueExprStatementRole
    fact.typeText = "unknown"
    fact.abiClass = TypedExprAbiPolymorphic
    fact.valueKind = TypedExprValuePolymorphic
    fact.placeKind = TypedExprPlaceTemporary
    fact.loweringMode = TypedExprLowerDeferred
    fact.callKind = TypedExprCallKindForExpr(expr)
    fact.typeCallKind = TypedExprTypeCallKindForExpr(expr)
    fact.returnKind = TypedExprReturnDeferred
    if subTime:
        bfT0 = TypedExprSubTimeNowNs()
    let sink = TypedExprSinkForExpr(ctx, expr)
    if subTime:
        TypedExprSubTimeAccum(TypedExprSubTimeBfSink, bfT0)
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, expr.lineNumber)
    if valueExprTree != nil && expr.valueExprRootNodeIndex >= 0:
        var conversionScope: TypedExprFunctionScope
        if scopeIndex >= 0:
            conversionScope = ctx.scopes[scopeIndex]
        if subTime:
            bfT0 = TypedExprSubTimeNowNs()
        TypedExprValueExprValidateConversionsPreflight(
            ctx,
            sourceContexts,
            conversionScope,
            expr.lineNumber,
            valueExprTree,
            expr.valueExprRootNodeIndex)
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeBfPreflight, bfT0)
            typedExprSubTimeLastPreflight = TypedExprSubTimeNowNs() - bfT0
    let sourceResultType = TypedExprInferredResultInputType(ctx, scopeIndex, expr)
    var namedAggregateConstructorType = ""
    if expr.kind == parser.NormalizedExprCall:
        let constructorHead = TypedExprQualifiedCallSurface(expr.callQualifier,
                                                             expr.callCallee)
        if subTime:
            bfT0 = TypedExprSubTimeNowNs()
        namedAggregateConstructorType =
            TypedExprNamedAggregateConstructorTypeInContext(ctx,
                                                             sourceContexts,
                                                             constructorHead,
                                                             expr.callArgsText)
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeBfAggregate, bfT0)
    var resolvedSourceFunction = false
    var resolvedReturnType = ""
    var resolvedTargetSourcePath = ""
    var resolvedTargetName = ""
    var resolvedTargetSignatureLineNumber: int32
    var resolvedTargetImportc = false
    let scratchActive = sliceScratch.exprCount > exprIndex
    # [d2 M1] The ExprResolvesToSourceFunction probe resolved the identical
    # input tuple only to derive one boolean. Inline the resolution and keep
    # the full outputs for the lookup_main consumer below.
    if expr.kind == parser.NormalizedExprCall && namedAggregateConstructorType == "":
        if subTime:
            bfT0 = TypedExprSubTimeNowNs()
        resolvedReturnType = TypedExprResolveCallTargetReturnType(ctx,
                                                                   sourceContexts,
                                                                   expr.callQualifier,
                                                                   expr.callCallee,
                                                                   expr.callTarget,
                                                                   expr.callArgsText,
                                                                   expr.lineNumber,
                                                                   TypedExprSurfaceCallKindFromParser(expr.callSurfaceKind),
                                                                   resolvedTargetSourcePath,
                                                                   resolvedTargetName,
                                                                   resolvedTargetSignatureLineNumber,
                                                                   resolvedTargetImportc)
        resolvedSourceFunction = resolvedReturnType != "" &&
                                 resolvedTargetSourcePath != "" &&
                                 !resolvedTargetImportc
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeBfResolve, bfT0)
            typedExprSubTimeLastResolve = TypedExprSubTimeNowNs() - bfT0
    if scratchActive:
        sliceScratch.aggregateCtorTypes[exprIndex] = share(namedAggregateConstructorType)
        sliceScratch.zeroArgCtorTypes[exprIndex] = ""
        sliceScratch.resolveReturnTypes[exprIndex] = share(resolvedReturnType)
        sliceScratch.resolveSourcePaths[exprIndex] = share(resolvedTargetSourcePath)
        sliceScratch.resolveTargetNames[exprIndex] = share(resolvedTargetName)
        sliceScratch.resolveSignatureLines[exprIndex] = resolvedTargetSignatureLineNumber
        var resolveFlags: int32
        if resolvedReturnType != "":
            resolveFlags = resolveFlags | 2
        if resolvedTargetImportc:
            resolveFlags = resolveFlags | 8
        if expr.kind == parser.NormalizedExprCall &&
           (expr.callQualifier == "" ||
            TypedExprSurfaceCallKindFromParser(expr.callSurfaceKind) ==
                TypedExprSurfaceCallMember):
            # bit0: the resolution ran in the plain/member shape, so the
            # re-validator's general arm would pass the identical input tuple.
            resolveFlags = resolveFlags | 1
        sliceScratch.resolveFlags[exprIndex] = resolveFlags
    if resolvedSourceFunction && fact.callKind == TypedExprCallBuiltin:
        fact.callKind = TypedExprCallNone
    fact.hasSink = sink.hasSink
    fact.sinkPlaceKind = sink.sinkPlaceKind
    fact.returnRoot = sink.returnRoot
    if expr.kind == parser.NormalizedExprRange:
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, "range", sink, false)
        return
    if expr.kind == parser.NormalizedExprComprehension:
        let sinkType = sink.sinkType
        if parser.ParserStartsWith(sinkType, "seq[") || (sinkType.len >= 2 && chengpath.TextSlice(sinkType, sinkType.len - 2, 2) == "[]"):
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, sinkType, sink, false)
            return
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, "seq[unknown]", sink, false)
        return
    if expr.kind == parser.NormalizedExprStrFormat:
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, "str", sink, false)
        return
    if expr.kind == parser.NormalizedExprIf:
        if sink.hasSink && sink.sinkType != "":
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, sink.sinkType, sink, false)
            return
        let lineRaw = TypedExprSourceLine(ctx, expr.lineNumber)
        let trimmed = chengpath.PathTrim(lineRaw)
        if parser.ParserStartsWith(trimmed, "if ") || TypedExprComprehensionFilterIf(lineRaw, expr):
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, "bool", sink, false)
            return
        fact.typeText = "branch_join"
        return
    if expr.kind == parser.NormalizedExprTry:
        let innerType = TypedExprResultSuccessType(sourceResultType)
        if innerType != "":
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, innerType, sink, true)
            return
        let returnInnerType = TypedExprResultSuccessType(sink.functionReturnType)
        if returnInnerType != "":
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, returnInnerType, sink, true)
            return
        if sink.hasSink && sink.sinkType != "":
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, sink.sinkType, sink, true)
            return
        fact.typeText = "result_projection"
        fact.placeKind = TypedExprPlaceCallResult
        return
    let isResultIntrinsic = expr.kind == parser.NormalizedExprResultIntrinsic
    var resultArgsText = ""
    var resultGenericInner = ""
    var resultInnerType = ""
    if isResultIntrinsic:
        if valueExprTree == nil || expr.valueExprCallNodeIndex < 0 ||
           parser.ParserValueExprNodeKindAt(valueExprTree,
                                             expr.valueExprCallNodeIndex) !=
               parser.ParserValueExprCall:
            var callNodeKind = -1
            if valueExprTree != nil && expr.valueExprCallNodeIndex >= 0:
                callNodeKind = parser.ParserValueExprNodeKindAt(
                    valueExprTree, expr.valueExprCallNodeIndex)
            panic(Fmt"typed expr: Result intrinsic parser Call authority missing source={ctx.sourcePath} line={expr.lineNumber} column={expr.columnNumber} tree_nil={valueExprTree == nil} call_node_index={expr.valueExprCallNodeIndex} call_node_kind={callNodeKind}")
        let treeCallee = parser.ParserValueExprNodeNameText(
            valueExprTree, expr.valueExprCallNodeIndex)
        if treeCallee != expr.surfaceText:
            panic(Fmt"typed expr: Result intrinsic parser callee drift source={ctx.sourcePath} line={expr.lineNumber} fact={expr.surfaceText} tree={treeCallee}")
        let treeArgCount = parser.ParserValueExprNodeArgumentRootCount(
            valueExprTree, expr.valueExprCallNodeIndex)
        let treeArgRootStart = parser.ParserValueExprNodeArgumentRootStart(
            valueExprTree, expr.valueExprCallNodeIndex)
        let treeArgsText = parser.ParserValueExprNodeCallArgsText(
            valueExprTree, expr.valueExprCallNodeIndex)
        if expr.callArgCount != treeArgCount ||
           expr.callArgValueRootStart != treeArgRootStart ||
           expr.callArgValueRootCount != treeArgCount ||
           expr.callArgsText != treeArgsText ||
           parser.ParserCountTopLevelArgs(treeArgsText) != treeArgCount ||
           (treeArgCount > 0 &&
            (treeArgsText == "" || expr.callArgValueRootStart < 0)):
            panic(Fmt"typed expr: Result intrinsic structured argument authority drift source={ctx.sourcePath} line={expr.lineNumber} fact_count={expr.callArgCount} tree_count={treeArgCount} fact_args={expr.callArgsText} tree_args={treeArgsText}")
        resultArgsText = treeArgsText
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=te_result_args_text line=",
                                                       strings.IntToStr(expr.lineNumber),
                                                       " col=", strings.IntToStr(expr.columnNumber),
                                                       " callName=", strings.CloneStr(expr.surfaceText),
                                                       " len=", strings.IntToStr(resultArgsText.len),
                                                       " text=", strings.CloneStr(resultArgsText)], ""))
        let resultGenericCount =
            parser.ParserValueExprNodeExplicitGenericCount(
                valueExprTree, expr.valueExprCallNodeIndex)
        if resultGenericCount > 1:
            panic(Fmt"typed expr: Result intrinsic generic arity invalid source={ctx.sourcePath} line={expr.lineNumber} count={resultGenericCount}")
        if resultGenericCount == 1:
            resultGenericInner = TypedExprNormalizeTypeText(
                parser.ParserValueExprNodeExplicitGenericText(
                    valueExprTree, expr.valueExprCallNodeIndex, 0))
            if resultGenericInner == "":
                panic(Fmt"typed expr: Result intrinsic generic type missing source={ctx.sourcePath} line={expr.lineNumber}")
        resultInnerType = TypedExprResultSuccessType(sourceResultType)
        fact.callCallee = expr.surfaceText
        fact.callPrefixStyle = expr.callPrefixStyle
        fact.callArgsText = resultArgsText
        fact.callArgCount = treeArgCount
    var isResultCtorIntrinsic = false
    if isResultIntrinsic && expr.detailKind == parser.NormalizedExprDetailResultOk:
        isResultCtorIntrinsic = true
    if isResultIntrinsic && expr.detailKind == parser.NormalizedExprDetailResultErr:
        isResultCtorIntrinsic = true
    if isResultCtorIntrinsic && resultGenericInner != "":
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, TypedExprResultType(resultGenericInner), sink, false)
        return
    if isResultCtorIntrinsic && sink.hasSink && parser.ParserStartsWith(sink.sinkType, "Result["):
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, sink.sinkType, sink, false)
        return
    if isResultCtorIntrinsic && parser.ParserStartsWith(sink.functionReturnType, "Result["):
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, sink.functionReturnType, sink, false)
        return
    if isResultCtorIntrinsic:
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, "Result[unknown]", sink, false)
        return
    var isResultBoolProjection = false
    if isResultIntrinsic && expr.detailKind == parser.NormalizedExprDetailResultIsOk:
        isResultBoolProjection = true
    if isResultIntrinsic && expr.detailKind == parser.NormalizedExprDetailResultIsErr:
        isResultBoolProjection = true
    if isResultBoolProjection:
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, "bool", sink, true)
        return
    if isResultIntrinsic && expr.detailKind == parser.NormalizedExprDetailResultError:
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, "str", sink, true)
        return
    if isResultIntrinsic && expr.detailKind == parser.NormalizedExprDetailResultErrorInfoOf:
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, "ErrorInfo", sink, true)
        return
    if isResultIntrinsic && resultGenericInner != "":
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, resultGenericInner, sink, true)
        return
    if isResultIntrinsic && resultInnerType != "":
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, resultInnerType, sink, true)
        return
    if isResultIntrinsic && sink.hasSink && sink.sinkType != "":
        TypedExprApplyResolvedType(fact, ctx, sourceContexts, sink.sinkType, sink, true)
        return
    if isResultIntrinsic:
        fact.typeText = "result_projection"
        fact.placeKind = TypedExprPlaceCallResult
        return
    if expr.kind == parser.NormalizedExprDefaultInit:
        fact.callPrefixStyle = expr.callPrefixStyle
        fact.callArgCount = expr.callArgCount
        fact.callArgsText = expr.callArgsText
        let defaultInitType = parser.NormalizedExprDefaultInitType(expr)
        if defaultInitType != "":
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, defaultInitType, sink, false)
            return
        fact.typeText = "default_init_expr"
        return
    if expr.kind == parser.NormalizedExprConstructor:
        fact.callPrefixStyle = expr.callPrefixStyle
        fact.callArgCount = expr.callArgCount
        fact.callArgsText = expr.callArgsText
        let constructorType = parser.NormalizedExprConstructorType(expr)
        if constructorType != "" && expr.callArgCount == 1 &&
           valueExprTree != nil && expr.valueExprCallNodeIndex >= 0 &&
           parser.ParserValueExprNodeKindAt(valueExprTree,
                                             expr.valueExprCallNodeIndex) ==
               parser.ParserValueExprCall &&
           parser.ParserValueExprNodeArgumentRootCount(
               valueExprTree, expr.valueExprCallNodeIndex) == 1:
            let conversionRootStart =
                parser.ParserValueExprNodeArgumentRootStart(
                    valueExprTree, expr.valueExprCallNodeIndex)
            let conversionRoot = parser.ParserValueExprRootNodeAt(
                valueExprTree, conversionRootStart)
            if parser.ParserValueExprNodeArgumentName(valueExprTree,
                                                       conversionRoot) == "":
                let conversionTarget = TypedExprIrValueExprCallHead(
                    valueExprTree, expr.valueExprCallNodeIndex)
                let conversionOperand = parser.ParserValueExprNodeText(
                    valueExprTree, conversionRoot)
                var conversionScope: TypedExprFunctionScope
                if scopeIndex >= 0:
                    conversionScope = ctx.scopes[scopeIndex]
                TypedExprBindingNameIndexPrepare(ctx)
                let conversionOperandType =
                    TypedExprStaticExprTypeAtLevel(ctx,
                                                   sourceContexts,
                                                   conversionScope,
                                                   expr.lineNumber,
                                                   conversionOperand,
                                                   0)
                let conversionKind =
                    TypedExprExplicitTypeConversionClassify(
                        ctx,
                        sourceContexts,
                        ctx.sourcePath,
                        conversionTarget,
                        ctx.sourcePath,
                        conversionOperandType,
                        false,
                        TypedExprExplicitTypeConversionPlaceUnknown)
                if conversionKind ==
                   TypedExprExplicitTypeConversionIdentity:
                    fact.typeCallKind = TypedExprTypeCallIdentity
                    TypedExprApplyResolvedType(fact,
                                               ctx,
                                               sourceContexts,
                                               constructorType,
                                               sink,
                                               false)
                    return
        let constructorName = parser.ParserIdentPrefix(constructorType)
        if constructorName == "Ok" || constructorName == "Err":
            let genericInner = TypedExprExtractTypeGenericArg(constructorType)
            if genericInner != "":
                TypedExprApplyResolvedType(fact, ctx, sourceContexts, TypedExprResultType(genericInner), sink, false)
                return
            if sink.hasSink && parser.ParserStartsWith(sink.sinkType, "Result["):
                TypedExprApplyResolvedType(fact, ctx, sourceContexts, sink.sinkType, sink, false)
                return
            if parser.ParserStartsWith(sink.functionReturnType, "Result["):
                TypedExprApplyResolvedType(fact, ctx, sourceContexts, sink.functionReturnType, sink, false)
                return
            # P1 producer: Ok/Err 内型全部回退到 Result[unknown] 即 ctor
            # type-shape 推断真失败 (genericInner='' && sink 无 Result[).
            # 写入 hint, 上游 stmt-aware caller 看到此 fact 失败链时按
            # aggregate_ctor_fail 分类; constructorType 带 brackets 但
            # extract 不出内型 → leaf 切错的 generic_return 路径.
            if parser.ParserFindText(constructorType, "[") > 0:
                TypedExprIrSetRhsBailHint("generic_return")
            else:
                TypedExprIrSetRhsBailHint("aggregate_ctor_fail")
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, "Result[unknown]", sink, false)
            return
        if constructorType != "":
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, constructorType, sink, false)
            return
        fact.typeText = "constructor_expr"
        return
    if expr.kind == parser.NormalizedExprCall:
        if namedAggregateConstructorType != "":
            fact.callPrefixStyle = expr.callPrefixStyle
            fact.callArgCount = expr.callArgCount
            fact.callArgsText = expr.callArgsText
            fact.callKind = TypedExprCallNone
            # Parser preserves this surface as NormalizedExprCall. Keep the
            # fact's call/type-call discriminator aligned with that stable
            # parser kind; the validated aggregate type below carries the
            # constructor semantics without leaking a runtime call target.
            fact.typeCallKind = TypedExprTypeCallNone
            TypedExprApplyResolvedType(fact,
                                       ctx,
                                       sourceContexts,
                                       namedAggregateConstructorType,
                                       sink,
                                       false)
            return
        let zeroArgConstructorType =
            TypedExprZeroArgTypeConstructorTypeName(
                ctx, sourceContexts, expr)
        if scratchActive:
            sliceScratch.zeroArgCtorTypes[exprIndex] = share(zeroArgConstructorType)
        if zeroArgConstructorType != "":
            TypedExprApplyResolvedType(fact, ctx, sourceContexts,
                                       zeroArgConstructorType, sink, false)
            return
        fact.surfaceCallKind = TypedExprSurfaceCallKindFromParser(expr.callSurfaceKind)
        fact.callResolved = expr.callResolved
        fact.callReason = TypedExprCallReasonFromParser(expr.callReason)
        fact.callQualifier = expr.callQualifier
        fact.callCallee = expr.callCallee
        fact.callTarget = expr.callTarget
        fact.callTargetSourcePath = expr.callTargetSourcePath
        fact.callTargetImportc = expr.callTargetImportc
        fact.callPrefixStyle = expr.callPrefixStyle
        fact.callArgCount = expr.callArgCount
        fact.callArgsText = expr.callArgsText
        # The parser's preresolved call identity carries no signature line (the
        # NormalizedExpr schema has no such field).  Recover the exact row
        # identity from the sealed declaration index when (source, target) is
        # unique; overloaded names stay absent and fall back to the textual
        # path.  Importc declarations legitimately keep line 0, and builtin
        # calls (primitive conversions like `int32(...)`, stringify) are not
        # declarations at all — the index row for a same-named generic
        # (e.g. std/system.cheng `fn int32(x: T)`) must never leak onto them.
        if !TypedExprExprIsBuiltinCall(expr) &&
           fact.callResolved && !fact.callTargetImportc &&
           fact.callTargetSignatureLineNumber <= 0 &&
           fact.callTarget != "" && fact.callTargetSourcePath != "" &&
           ctx.buildIndex != nil && ctx.buildIndex.callDeclarationSealed:
            var preresolvedDeclRow: int32
            # The parser's preresolved target keeps the qualified call
            # surface (`layout.ByteBufAppendByte`), while declaration rows
            # are keyed by the leaf name (`ByteBufAppendByte`) that the
            # post-build target canonicalization stores.  Normalize before
            # the exact (source, name) identity lookup; without this the
            # recovery arm can never fire for a qualified call and the fact
            # row keeps signature line 0, which the validator then reports
            # as a call declaration identity drift.
            var preresolvedDeclName = TypedExprQualifiedCallLeaf(
                fact.callTarget)
            if preresolvedDeclName == "":
                preresolvedDeclName = fact.callTarget
            let preresolvedDeclState = TypedExprBuildIndexLookup(
                ctx.buildIndex,
                "ctx_function_decl_name_source",
                parser.ParserNormalizePath(fact.callTargetSourcePath),
                preresolvedDeclName,
                "",
                preresolvedDeclRow)
            if preresolvedDeclState == TypedExprBuildIndexUnique:
                fact.callTargetSignatureLineNumber =
                    typedExprBuildIndexCallSignatureLineNumber(
                        ctx.buildIndex, preresolvedDeclRow)
        if TypedExprExprIsBuiltinCall(expr) && !resolvedSourceFunction:
            fact.callResolved = true
            fact.callReason = TypedExprCallReasonNone
            if !expr.callTargetImportc:
                fact.callTarget = ""
                fact.callTargetSourcePath = ""
                fact.callTargetImportc = false
            var builtinTypeText = TypedExprBuiltinTypeCallResult(expr)
            if builtinTypeText == "":
                builtinTypeText = "str"
            TypedExprApplyResolvedType(fact, ctx, sourceContexts, builtinTypeText, sink, true)
            return
        var qualClearedTarget = false
        if fact.callQualifier != "" &&
           fact.surfaceCallKind != TypedExprSurfaceCallMember:
            var qualifiedTargetSourcePath = ""
            var qualifiedTargetName = ""
            var qualifiedTargetSignatureLineNumber: int32
            var qualifiedTargetImportc = false
            if subTime:
                bfT0 = TypedExprSubTimeNowNs()
            let qualifiedReturnType = TypedExprResolveQualifiedCallTargetReturnType(ctx,
                                                                                   sourceContexts,
                                                                                   fact.callQualifier,
                                                                                   fact.callCallee,
                                                                                   fact.callTarget,
                                                                                   fact.callArgsText,
                                                                                   fact.lineNumber,
                                                                                   qualifiedTargetSourcePath,
                                                                                   qualifiedTargetName,
                                                                                   qualifiedTargetSignatureLineNumber,
                                                                                   qualifiedTargetImportc)
            if subTime:
                TypedExprSubTimeAccum(TypedExprSubTimeBfQual, bfT0)
            if qualifiedReturnType != "" && qualifiedTargetSourcePath != "":
                var qualifiedTargetCtx = TypedExprSourceContextForPathOrCurrent(ctx,
                                                                                sourceContexts,
                                                                                qualifiedTargetSourcePath)
                fact.callResolved = true
                fact.callReason = TypedExprCallReasonNone
                fact.callTarget = qualifiedTargetName
                fact.callTargetSourcePath = qualifiedTargetSourcePath
                fact.callTargetSignatureLineNumber =
                    qualifiedTargetSignatureLineNumber
                fact.callTargetImportc = qualifiedTargetImportc
                TypedExprApplyResolvedType(fact, qualifiedTargetCtx, sourceContexts, qualifiedReturnType, sink, true)
                if TypedExprImportcFactRequiresImportBuffer(fact):
                    fact.loweringMode = TypedExprLowerImportBuffer
                    fact.returnKind = TypedExprReturnImportBuffer
                return
            if fact.callTargetSourcePath == "":
                fact.callResolved = false
                if fact.callReason == TypedExprCallReasonNone:
                    fact.callReason = TypedExprCallReasonUnknownQualifiedTarget
                fact.callTarget = ""
                fact.callTargetImportc = false
                qualClearedTarget = true
        if subTime:
            bfT0 = TypedExprSubTimeNowNs()
        var detailReturnType = ""
        if qualClearedTarget:
            # [d2 M1] The qual arm rewrote the fact surface (target cleared),
            # so the lookup inputs no longer match the first resolution. Keep
            # the original second-resolution path verbatim for this shape.
            detailReturnType = TypedExprLookupCallTargetReturnTypeFromFact(ctx, sourceContexts, fact)
        elif resolvedReturnType != "":
            # [d2 M1] Single-resolution replay: with the target intact every
            # lookup input equals the first resolution's input tuple and no
            # state mutation happened in between, so its outputs are replayed
            # field by field instead of paying a second full resolution. The
            # judgement flow below consumes the fact exactly as before.
            fact.callResolved = true
            fact.callReason = TypedExprCallReasonNone
            fact.callTarget = resolvedTargetName
            fact.callTargetSourcePath = resolvedTargetSourcePath
            fact.callTargetSignatureLineNumber = resolvedTargetSignatureLineNumber
            fact.callTargetImportc = resolvedTargetImportc
            detailReturnType = resolvedReturnType
        else:
            detailReturnType = TypedExprLookupPreresolvedCallTargetReturnTypeFromFact(ctx, sourceContexts, fact)
        if subTime:
            TypedExprSubTimeAccum(TypedExprSubTimeBfLookupMain, bfT0)
        if detailReturnType != "":
            var targetCtx = TypedExprSourceContextForPathOrCurrent(ctx,
                                                                     sourceContexts,
                                                                     fact.callTargetSourcePath)
            fact.callResolved = true
            fact.callReason = TypedExprCallReasonNone
            if fact.callTarget == "":
                fact.callTarget = fact.callCallee
            TypedExprApplyResolvedType(fact, targetCtx, sourceContexts, detailReturnType, sink, true)
            if TypedExprImportcFactRequiresImportBuffer(fact):
                fact.loweringMode = TypedExprLowerImportBuffer
                fact.returnKind = TypedExprReturnImportBuffer
            return
        fact.typeText = "call_expr"
        fact.placeKind = TypedExprPlaceCallResult
        return
    return

@borrows
fn TypedExprFunctionScopeEndLine(lines: str[],
                                  startLine: int32,
                                  nextDeclLine: int32): int32 =
    if startLine <= 0 || startLine > lines.len:
        return startLine
    var upper = lines.len
    if nextDeclLine > startLine:
        upper = nextDeclLine - 1
    if upper < startLine:
        return startLine
    var endLine = startLine
    # 多行签名约定:参数逐行缩进,闭合行 `): RetType =` 顶格(无缩进)。括号未平衡
    # (parenDepth>0)时仍在签名内,顶格闭合行属于签名,不能当 scope 终止。先用起始
    # `fn ...(` 行播种 parenDepth,扫描时对每行计入 '(' ')';只在括号已平衡后遇无缩进
    # 行才停(下一顶层声明)。否则 6 行签名的顶格 `): T =` 会被当 scope 边界提前终止,
    # endLine 停在末参数行 → bodyStartIndex>=lineEnd → body 扫描空区间 → bodyLineNumber=0
    # → typed-pass 把该函数当前向声明丢弃 → missing_call_target。镜像
    # TypedExprFunctionDeclHeaderText / TypedExprFunctionDeclBodyStartIndex 的同款补丁。
    var parenDepth: int32
    let firstLine = chengpath.PathTrim(lines[startLine - 1])
    for i in 0..<firstLine.len:
        if firstLine[i] == '(':
            parenDepth = parenDepth + 1
        elif firstLine[i] == ')':
            parenDepth = parenDepth - 1
    if startLine + 1 > upper:
        return endLine
    for lineNumber in (startLine + 1)..upper:
        let rawLine = lines[lineNumber - 1]
        # `//`-aware 剥注释(见 ParserStripLineCommentSlashAware 定义处注释): 纯
        # '//' 注释行会原样当代码文本存活, 其杂散括号被下面逐字符扫描累加进
        # parenDepth, 且该累加跨越整个函数体扫描区间永久生效不会自愈, 会让签名
        # 闭合判定(顶格行 + parenDepth<=0)永久失衡, 误判函数 scope 结束行(同族,
        # 控制头续行第 5 处旁的函数 scope 边界消费点)。
        let trimmed = chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(share(rawLine)))
        if trimmed == "":
            continue
        if !parser.ParserHasLeadingIndent(rawLine) && parenDepth <= 0:
            return endLine
        for j in 0..<trimmed.len:
            if trimmed[j] == '(':
                parenDepth = parenDepth + 1
            elif trimmed[j] == ')':
                parenDepth = parenDepth - 1
        endLine = lineNumber
    return endLine

@borrows
fn TypedExprNextTopLevelDeclLine(lines: str[],
                                  decls: parser.NormalizedFunctionDecl[],
                                  currentDeclIndex: int32): int32 =
    var i = currentDeclIndex + 1
    while i < decls.len:
        let lineIndex = decls[i].lineIndex
        if lineIndex <= 0 || lineIndex > lines.len:
            i = i + 1
            continue
        let rawLine = lines[lineIndex - 1]
        let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(rawLine))
        if trimmed != "" && !parser.ParserHasLeadingIndent(rawLine):
            return lineIndex
        i = i + 1
    return 0

@borrows
fn TypedExprColdCsgAddTypeRow(ctx: var TypedExprSourceContext,
                               rowKind: TypedExprColdCsgTypeRowKind,
                               typeNameRaw: str,
                               specsRaw: str) =
    let typeHead = chengpath.PathTrim(typeNameRaw)
    let typeName = parser.ParserIdentPrefix(typeHead)
    let typeParams = TypedExprColdCsgTypeParamsFromHead(typeHead)
    let specs = chengpath.PathTrim(specsRaw)
    if typeName == "" || specs == "":
        return
    for i in 0..<ctx.coldCsgTypeRows.len:
        if ctx.coldCsgTypeRows[i].rowKind == rowKind &&
           ctx.coldCsgTypeRows[i].typeName == typeName &&
           ctx.coldCsgTypeRows[i].typeParams == typeParams:
            return
    var row: TypedExprColdCsgTypeRow
    row.sourcePath = strings.CloneStr(ctx.sourcePath)
    row.rowKind = rowKind
    row.typeName = typeName
    row.specs = specs
    row.typeParams = typeParams
    add(ctx.coldCsgTypeRows, row)

@borrows
fn TypedExprColdCsgAppendTypeEntryRowsToContext(ctx: var TypedExprSourceContext,
                                                 entryIndex: int32,
                                                 entryIndent: int32,
                                                 typeName: str,
                                                 rhs: str,
                                                 nextIndex: var int32): bool =
    nextIndex = entryIndex + 1
    if parser.ParserStartsWith(rhs, "object"):
        let fieldStart = nextIndex
        var fieldEnd = nextIndex
        while nextIndex < ctx.lines.len:
            let fieldLine = ctx.lines[nextIndex]
            let fieldTrimmed = chengpath.PathTrim(fieldLine)
            if fieldTrimmed == "":
                nextIndex = nextIndex + 1
                continue
            if TypedExprColdCsgLineTopLevel(fieldLine) ||
               TypedExprLineIndentWidth(fieldLine) <= entryIndent:
                break
            fieldEnd = nextIndex + 1
            nextIndex = nextIndex + 1
        let specs = TypedExprColdCsgObjectSpecsFromLines(ctx, fieldStart, fieldEnd)
        if specs == "":
            return false
        TypedExprColdCsgAddTypeRow(ctx, TypedExprColdCsgTypeObject, typeName, specs)
        return true
    if parser.ParserStartsWith(rhs, "tuple["):
        let specs = TypedExprColdCsgTupleObjectSpecs(rhs)
        if specs == "":
            return false
        TypedExprColdCsgAddTypeRow(ctx, TypedExprColdCsgTypeObject, typeName, specs)
        return true
    var variants = rhs
    if variants == "":
        let variantStart = nextIndex
        var variantEnd = nextIndex
        while nextIndex < ctx.lines.len:
            let variantLine = ctx.lines[nextIndex]
            let variantTrimmed = chengpath.PathTrim(variantLine)
            if variantTrimmed == "":
                nextIndex = nextIndex + 1
                continue
            if TypedExprColdCsgLineTopLevel(variantLine) ||
               TypedExprLineIndentWidth(variantLine) <= entryIndent:
                break
            variantEnd = nextIndex + 1
            nextIndex = nextIndex + 1
        variants = TypedExprColdCsgJoinIndentedLines(ctx, variantStart, variantEnd)
    let specs = TypedExprColdCsgVariantSpecsFromText(chengpath.PathTrim(variants))
    if specs == "":
        return false
    TypedExprColdCsgAddTypeRow(ctx, TypedExprColdCsgTypeAdt, typeName, specs)
    return true

@borrows
fn TypedExprColdCsgAppendTypeBlockRec(ctx: var TypedExprSourceContext,
                                       i: int32,
                                       blockIndent: int32) =
    if i >= ctx.lines.len:
        return
    let entryRaw = ctx.lines[i]
    let entryTrimmed = chengpath.PathTrim(parser.ParserStripLineComment(entryRaw))
    if entryTrimmed == "":
        TypedExprColdCsgAppendTypeBlockRec(ctx, i + 1, blockIndent)
        return
    if TypedExprColdCsgLineTopLevel(entryRaw):
        TypedExprColdCsgAppendTypeRowsRec(ctx, false, i)
        return
    let entryIndent = TypedExprLineIndentWidth(entryRaw)
    var nextBlockIndent = blockIndent
    if nextBlockIndent < 0:
        nextBlockIndent = entryIndent
    if entryIndent > nextBlockIndent:
        TypedExprColdCsgAppendTypeBlockRec(ctx, i + 1, nextBlockIndent)
        return
    var typeName = ""
    var rhs = ""
    if !TypedExprColdCsgTypeEntryParts(entryTrimmed, typeName, rhs):
        TypedExprColdCsgAppendTypeBlockRec(ctx, i + 1, nextBlockIndent)
        return
    var nextIndex = i + 1
    if !TypedExprColdCsgAppendTypeEntryRowsToContext(ctx,
                                                      i,
                                                      entryIndent,
                                                      typeName,
                                                      rhs,
                                                      nextIndex):
        TypedExprColdCsgAppendTypeBlockRec(ctx, i + 1, nextBlockIndent)
        return
    TypedExprColdCsgAppendTypeBlockRec(ctx, nextIndex, nextBlockIndent)

@borrows
fn TypedExprColdCsgAppendTypeRowsRec(ctx: var TypedExprSourceContext,
                                      inTriple: bool,
                                      i: int32) =
    if i >= ctx.lines.len:
        return
    let rawLine = ctx.lines[i]
    if inTriple:
        if TypedExprColdCsgLineHasTripleQuote(rawLine):
            TypedExprColdCsgAppendTypeRowsRec(ctx, false, i + 1)
            return
        TypedExprColdCsgAppendTypeRowsRec(ctx, true, i + 1)
        return
    let line = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
    if line == "":
        TypedExprColdCsgAppendTypeRowsRec(ctx, false, i + 1)
        return
    if !TypedExprColdCsgLineTopLevel(rawLine):
        TypedExprColdCsgAppendTypeRowsRec(ctx,
                                           TypedExprColdCsgLineHasTripleQuote(rawLine),
                                           i + 1)
        return
    if line == "type":
        TypedExprColdCsgAppendTypeBlockRec(ctx, i + 1, -1)
        return
    if !parser.ParserStartsWith(line, "type "):
        TypedExprColdCsgAppendTypeRowsRec(ctx,
                                           TypedExprColdCsgLineHasTripleQuote(rawLine),
                                           i + 1)
        return
    let tail = chengpath.PathTrim(chengpath.TextSlice(line, 5, line.len - 5))
    var typeName = ""
    var rhs = ""
    if !TypedExprColdCsgTypeEntryParts(tail, typeName, rhs):
        TypedExprColdCsgAppendTypeRowsRec(ctx, false, i + 1)
        return
    var nextIndex = i + 1
    if TypedExprColdCsgAppendTypeEntryRowsToContext(ctx,
                                                     i,
                                                     TypedExprLineIndentWidth(rawLine),
                                                     typeName,
                                                     rhs,
                                                     nextIndex):
        TypedExprColdCsgAppendTypeRowsRec(ctx, false, nextIndex)
        return
    TypedExprColdCsgAppendTypeRowsRec(ctx, false, i + 1)

fn TypedExprColdCsgAppendTypeRowsToContext(ctx: var TypedExprSourceContext) =
    TypedExprColdCsgAppendTypeRowsRec(ctx, false, 0)

fn TypedExprColdCsgAddStatementRow(ctx: var TypedExprSourceContext,
                                    functionName: str,
                                    lineNumber: int32,
                                    lineIndent: int32,
                                    kind: str,
                                    payloadText: str) =
    if functionName == "" || kind == "":
        return
    var row: TypedExprColdCsgStatementRow
    row.sourcePath = ctx.sourcePath
    row.functionName = functionName
    row.lineNumber = lineNumber
    row.lineIndent = lineIndent
    row.kind = kind
    row.payloadText = payloadText
    add(ctx.coldCsgStatementRows, row)

@borrows
fn TypedExprColdCsgUnsupportedRow(ctx: var TypedExprSourceContext,
                                   functionName: str,
                                   lineNumber: int32,
                                   lineIndent: int32,
                                   text: str) =
    TypedExprColdCsgAddStatementRow(ctx,
                                    share(functionName),
                                    lineNumber,
                                    lineIndent,
                                    "unsupported",
                                    Fmt"unsupported\t{share(text)}")

fn TypedExprColdCsgFindAssignEq(text: str): int32 =
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    for i in 0..<text.len:
        let ch = text[i]
        if ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
        elif ch == '=' && bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            if i + 1 < text.len && text[i + 1] == '=':
                continue
            if i > 0:
                let prev = text[i - 1]
                if prev == '<' || prev == '>' || prev == '!' || prev == '=':
                    continue
            return i
    return -1

fn TypedExprColdCsgBindingNameFromHead(headRaw: str): str =
    return parser.ParserIdentPrefix(parser.ParserFirstToken(chengpath.PathTrim(headRaw)))

fn TypedExprColdCsgBindingTypeFromHead(headRaw: str): str =
    let head = chengpath.PathTrim(headRaw)
    let colon = parser.ParserFindText(head, ":")
    if colon <= 0:
        return ""
    return TypedExprNormalizeTypeText(chengpath.TextSlice(head, colon + 1, head.len - colon - 1))

fn TypedExprColdCsgExprHasQuestionSuffix(exprRaw: str,
                                          stripped: var str): bool =
    stripped = chengpath.PathTrim(exprRaw)
    if stripped.len <= 1 || stripped[stripped.len - 1] != '?':
        return false
    var depth = 0
    for i in 0..<(stripped.len - 1):
        if stripped[i] == '(':
            depth = depth + 1
        elif stripped[i] == ')':
            depth = depth - 1
    if depth != 0:
        return false
    stripped = chengpath.PathTrim(chengpath.TextSlice(stripped, 0, stripped.len - 1))
    return true

fn TypedExprColdCsgAppendSourceStatementRowToContext(ctx: var TypedExprSourceContext,
                                                      functionName: str,
                                                      lineNumber: int32,
                                                      indent: int32,
                                                      trimmedRaw: str) =
    let trimmed = chengpath.PathTrim(trimmedRaw)
    if trimmed == "" || trimmed == "{" || trimmed == "}":
        return
    let arrow = parser.ParserFindText(trimmed, "=>")
    if arrow > 0:
        let arm = chengpath.PathTrim(chengpath.TextSlice(trimmed, 0, arrow))
        let body = chengpath.PathTrim(chengpath.TextSlice(trimmed,
                                                          arrow + 2,
                                                          trimmed.len - arrow - 2))
        var variant = arm
        var bind = ""
        let open = parser.ParserFindText(arm, "(")
        if open > 0:
            if arm.len <= open + 1 || arm[arm.len - 1] != ')':
                TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
                return
            variant = chengpath.PathTrim(chengpath.TextSlice(arm, 0, open))
            bind = chengpath.PathTrim(chengpath.TextSlice(arm, open + 1, arm.len - open - 2))
        if !TypedExprColdCsgTextIsFactSafe(variant) || !TypedExprColdCsgTextIsFactSafe(bind):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx,
                                        functionName,
                                        lineNumber,
                                        indent,
                                        "case",
                                        Fmt"case\t{variant}\t{bind}")
        if body != "":
            TypedExprColdCsgAppendSourceStatementRowToContext(ctx,
                                                              functionName,
                                                              lineNumber,
                                                              indent + 4,
                                                              body)
        return
    if parser.ParserStartsWith(trimmed, "match "):
        let restRaw = chengpath.PathTrim(chengpath.TextSlice(trimmed, 6, trimmed.len - 6))
        let target = TypedExprColdCsgStripTrailingColon(TypedExprColdCsgStripTrailingOpenBrace(restRaw))
        if target == "" || !TypedExprColdCsgTextIsFactSafe(target):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, "match", Fmt"match\t{target}")
        return
    if parser.ParserStartsWith(trimmed, "return "):
        let expr = chengpath.PathTrim(chengpath.TextSlice(trimmed, 7, trimmed.len - 7))
        var qExpr = ""
        if TypedExprColdCsgExprHasQuestionSuffix(expr, qExpr) ||
           expr == "" ||
           !TypedExprColdCsgTextIsFactSafe(expr):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, "return", Fmt"return\t{expr}")
        return
    var bindingPrefixLen = 0
    if parser.ParserStartsWith(trimmed, "let ") || parser.ParserStartsWith(trimmed, "var "):
        bindingPrefixLen = 4
    elif parser.ParserStartsWith(trimmed, "const "):
        bindingPrefixLen = 6
    if bindingPrefixLen > 0:
        let rest = chengpath.PathTrim(chengpath.TextSlice(trimmed,
                                                          bindingPrefixLen,
                                                          trimmed.len - bindingPrefixLen))
        let eq = TypedExprColdCsgFindAssignEq(rest)
        if eq <= 0:
            let colon = parser.ParserFindText(rest, ":")
            if colon <= 0:
                TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
                return
            let name = TypedExprColdCsgBindingNameFromHead(chengpath.TextSlice(rest, 0, colon))
            let typeText = TypedExprNormalizeTypeText(chengpath.TextSlice(rest,
                                                                          colon + 1,
                                                                          rest.len - colon - 1))
            if name == "" || typeText == "" ||
               !TypedExprColdCsgTextIsFactSafe(name) ||
               !TypedExprColdCsgTextIsFactSafe(typeText):
                TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
                return
            TypedExprColdCsgAddStatementRow(ctx,
                                            functionName,
                                            lineNumber,
                                            indent,
                                            "default",
                                            Fmt"default\t{name}\t{typeText}")
            return
        let head = chengpath.TextSlice(rest, 0, eq)
        let name = TypedExprColdCsgBindingNameFromHead(head)
        let typeText = TypedExprColdCsgBindingTypeFromHead(head)
        var expr = chengpath.PathTrim(chengpath.TextSlice(rest, eq + 1, rest.len - eq - 1))
        var qExpr = ""
        var kind = "var"
        if TypedExprColdCsgExprHasQuestionSuffix(expr, qExpr):
            expr = qExpr
            kind = "let_q"
        if typeText != "":
            if kind == "var":
                kind = "var_t"
            else:
                kind = "let_q_t"
        if name == "" || expr == "" ||
           !TypedExprColdCsgTextIsFactSafe(name) ||
           !TypedExprColdCsgTextIsFactSafe(expr) ||
           !TypedExprColdCsgTextIsFactSafe(typeText):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        if typeText != "":
            TypedExprColdCsgAddStatementRow(ctx,
                                            functionName,
                                            lineNumber,
                                            indent,
                                            kind,
                                            Fmt"{kind}\t{name}\t{typeText}\t{expr}")
        else:
            TypedExprColdCsgAddStatementRow(ctx,
                                            functionName,
                                            lineNumber,
                                            indent,
                                            kind,
                                            Fmt"{kind}\t{name}\t{expr}")
        return
    if parser.ParserStartsWith(trimmed, "if "):
        let condition = TypedExprColdCsgControlPayload(trimmed, "if")
        if condition == "" || !TypedExprColdCsgTextIsFactSafe(condition):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, "if", Fmt"if\t{condition}")
        return
    if parser.ParserStartsWith(trimmed, "elif "):
        let condition = TypedExprColdCsgControlPayload(trimmed, "elif")
        if condition == "" || !TypedExprColdCsgTextIsFactSafe(condition):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, "elif", Fmt"elif\t{condition}")
        return
    if TypedExprColdCsgStripTrailingColon(trimmed) == "else":
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, "else", "else")
        return
    if parser.ParserStartsWith(trimmed, "while "):
        let condition = TypedExprColdCsgControlPayload(trimmed, "while")
        if condition == "" || !TypedExprColdCsgTextIsFactSafe(condition):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, "while", Fmt"while\t{condition}")
        return
    if parser.ParserStartsWith(trimmed, "for "):
        let payload = TypedExprColdCsgControlPayload(trimmed, "for")
        let inPos = parser.ParserFindText(payload, " in ")
        if inPos <= 0:
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        let iterName = chengpath.PathTrim(chengpath.TextSlice(payload, 0, inPos))
        let rangeText = chengpath.PathTrim(chengpath.TextSlice(payload,
                                                               inPos + 4,
                                                               payload.len - inPos - 4))
        var startExpr = ""
        var endExpr = ""
        var inclusive = false
        if !parser.ParserParseRangeExpr(rangeText, startExpr, endExpr, inclusive):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        var mode = "lt"
        if inclusive:
            mode = "le"
        if !TypedExprColdCsgTextIsFactSafe(iterName) ||
           !TypedExprColdCsgTextIsFactSafe(startExpr) ||
           !TypedExprColdCsgTextIsFactSafe(endExpr):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx,
                                        functionName,
                                        lineNumber,
                                        indent,
                                        "for_range",
                                        Fmt"for_range\t{iterName}\t{startExpr}\t{endExpr}\t{mode}")
        return
    if trimmed == "break" || trimmed == "continue":
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, trimmed, trimmed)
        return
    let eq = TypedExprColdCsgFindAssignEq(trimmed)
    if eq > 0:
        let name = chengpath.PathTrim(chengpath.TextSlice(trimmed, 0, eq))
        let expr = chengpath.PathTrim(chengpath.TextSlice(trimmed, eq + 1, trimmed.len - eq - 1))
        if name == "" || expr == "" ||
           !TypedExprColdCsgTextIsFactSafe(name) ||
           !TypedExprColdCsgTextIsFactSafe(expr):
            TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
            return
        TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, "assign", Fmt"assign\t{name}\t{expr}")
        return
    let open = parser.ParserFindText(trimmed, "(")
    if open > 0 && trimmed.len > open + 1:
        var close = trimmed.len - 1
        var kind = "call"
        if trimmed[close] == '?':
            kind = "call_q"
            close = close - 1
        if close > open && trimmed[close] == ')':
            let callee = chengpath.PathTrim(chengpath.TextSlice(trimmed, 0, open))
            let args = chengpath.PathTrim(chengpath.TextSlice(trimmed, open + 1, close - open - 1))
            if callee == "" || !TypedExprColdCsgTextIsFactSafe(callee) || !TypedExprColdCsgTextIsFactSafe(args):
                TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)
                return
            TypedExprColdCsgAddStatementRow(ctx, functionName, lineNumber, indent, kind, Fmt"{kind}\t{callee}\t{args}")
            return
    TypedExprColdCsgUnsupportedRow(ctx, functionName, lineNumber, indent, trimmed)

fn TypedExprColdCsgAppendStatementRowsToContext(ctx: var TypedExprSourceContext) =
    for scopeIndex in 0..<ctx.scopes.len:
        let scope = ctx.scopes[scopeIndex]
        if scope.startLine + 1 > scope.endLine:
            continue
        var inTriple = false
        for lineNumber in (scope.startLine + 1)..scope.endLine:
            let rawLine = ctx.lines[lineNumber - 1]
            if inTriple:
                if TypedExprColdCsgLineHasTripleQuote(rawLine):
                    inTriple = false
                continue
            if TypedExprColdCsgLineTopLevel(rawLine):
                if TypedExprColdCsgLineHasTripleQuote(rawLine):
                    inTriple = true
                continue
            let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
            if trimmed == "" ||
               parser.ParserStartsWith(trimmed, "#") ||
               parser.ParserStartsWith(trimmed, "//"):
                continue
            let indent = TypedExprLineIndentWidth(rawLine)
            TypedExprColdCsgAppendSourceStatementRowToContext(ctx,
                                                              scope.name,
                                                              lineNumber,
                                                              indent,
                                                              trimmed)

fn TypedExprEnsureSourceTextLoaded(source: var TypedExprSourceText) =
    if source.text != "":
        source.textLoaded = true
    if source.snapshotOnly:
        if !source.textLoaded:
            panic(Fmt"typed expr: snapshot-only source text missing source={source.sourcePath}")
        return
    if source.textLoaded || source.sourcePath == "":
        return
    if os.FileExists(source.sourcePath):
        source.text = chengpath.ReadTextFile("", source.sourcePath)
        source.textLoaded = true
        return
    if source.packageRoot != "":
        let packagePath = chengpath.PathAbsolute(source.packageRoot,
                                                  source.sourcePath)
        if os.FileExists(packagePath):
            source.text = chengpath.ReadTextFile("", packagePath)
            source.textLoaded = true
            return
    if source.workspaceRoot != "":
        let workspacePath = chengpath.PathAbsolute(source.workspaceRoot,
                                                    source.sourcePath)
        if os.FileExists(workspacePath):
            source.text = chengpath.ReadTextFile("", workspacePath)
            source.textLoaded = true
            return
    let providerPath = chengpath.PathProviderFilePath(source.sourcePath)
    if os.FileExists(providerPath):
        source.text = os.ReadFile(providerPath)
        source.textLoaded = true

fn TypedExprRequireSourceTextSnapshot(source: var TypedExprSourceText) =
    if !source.textLoaded:
        panic(Fmt"typed expr: source snapshot body missing source={source.sourcePath}")


fn TypedExprClearSourceTextBody(source: var TypedExprSourceText) =
    source.text = ""
    source.textLoaded = false

@borrows
fn typedExprCloneFrozenRoundSourceTexts(
        sourceTexts: var TypedExprSourceText[]): TypedExprSourceText[] =
    var out: TypedExprSourceText[]
    for sourceIndex in 0..<sourceTexts.len:
        add(out, share(sourceTexts[sourceIndex]))
    return out

fn typedExprMoveFrozenRoundSourceTexts(out: var TypedExprSourceText[],
                                       sourceTexts: var TypedExprSourceText[]) =
    out = sourceTexts
    sourceTexts = []

fn TypedExprNormalizedSourceTextForContext(source: var TypedExprSourceText,
                                           normalizedText: var str,
                                           err: var str): bool =
    TypedExprEnsureSourceTextLoaded(source)
    if !source.textLoaded:
        err = Fmt" typed expr: missing source text for IR body source={source.sourcePath}"
        return false
    if parser.ParserSourceHasMultilineString(source.text):
        if !parser.ParserRewriteMultilineStringSourceText(source.text, normalizedText, err):
            return false
    else:
        normalizedText = source.text
    err = ""
    return true

fn TypedExprLineCountInSourceText(text: str): int32 =
    if len(text) <= 0:
        return 0
    var count: int32 = 1
    for i in 0..<len(text):
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if text[i] == '\n':
            count = count + 1
    return count

@borrows
fn TypedExprSourceLineHasLeadingIndent(text: str,
                                       start: int32,
                                       lineLen: int32): bool =
    if lineLen <= 0:
        return false
    if start < 0 || start >= len(text):
        return false
    return text[start] == ' ' || text[start] == '\t'

@borrows
fn TypedExprAppendSelectedSourceLines(text: str,
                                      selectedLineStarts: int32[],
                                      selectedLineCounts: int32[],
                                      lineNumbers: var int32[],
                                      lines: var str[],
                                      selectedLineVisitCount: var int64,
                                      sourceLineCount: var int32) =
    if selectedLineStarts.len != selectedLineCounts.len:
        panic("typed expr: selected source range CSR shape mismatch")
    lineNumbers = []
    lines = []
    selectedLineVisitCount = Int64(0)
    sourceLineCount = 0
    var start: int32
    var lineNumber: int32 = 1
    var i: int32
    var inGlobalVarBlock = false
    var rangeIndex: int32
    while i <= len(text):
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if i < len(text) && text[i] != '\n':
            i = i + 1
            continue
        let lineLen = i - start
        let hasLeadingIndent = TypedExprSourceLineHasLeadingIndent(text, start, lineLen)
        while rangeIndex < selectedLineStarts.len &&
              lineNumber >= selectedLineStarts[rangeIndex] +
                  selectedLineCounts[rangeIndex]:
            rangeIndex = rangeIndex + 1
        var keepLine = rangeIndex < selectedLineStarts.len &&
                       lineNumber >= selectedLineStarts[rangeIndex] &&
                       lineNumber < selectedLineStarts[rangeIndex] +
                           selectedLineCounts[rangeIndex]
        var line = ""
        if !hasLeadingIndent:
            if lineLen > 0:
                line = chengpath.TextSlice(text, start, lineLen)
            let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(line))
            if trimmed != "":
                inGlobalVarBlock = trimmed == "var"
            keepLine = keepLine || inGlobalVarBlock ||
                       parser.ParserStartsWithExact(trimmed, "let ") ||
                       parser.ParserStartsWithExact(trimmed, "var ") ||
                       parser.ParserStartsWithExact(trimmed, "const ")
        elif inGlobalVarBlock:
            keepLine = true
        if keepLine:
            if line == "" && lineLen > 0:
                line = chengpath.TextSlice(text, start, lineLen)
            add(lineNumbers, lineNumber)
            add(lines, strings.CloneStr(line))
            selectedLineVisitCount = selectedLineVisitCount + Int64(1)
        line = ""
        i = i + 1
        start = i
        lineNumber = lineNumber + 1
    if len(text) > 0:
        sourceLineCount = lineNumber - 1

@borrows
fn TypedExprAppendSelectedSealedSourceLines(
        source: var TypedExprSourceText,
        metadataCtx: TypedExprSourceContext,
        selectedLineStarts: int32[],
        selectedLineCounts: int32[],
        lineNumbers: var int32[],
        lines: var str[],
        selectedLineVisitCount: var int64,
        selectedLineBytes: var int64,
        sourceLineCount: var int32,
        err: var str): bool =
    lineNumbers = []
    lines = []
    selectedLineVisitCount = Int64(0)
    selectedLineBytes = Int64(0)
    sourceLineCount = 0
    if selectedLineStarts.len != selectedLineCounts.len:
        err = " typed expr: sealed selected source range CSR shape mismatch"
        return false
    let projection = metadataCtx.frozenMetadataProjection
    let contextIndex = metadataCtx.frozenMetadataContextIndex
    var lineBase: int32
    var lineCount: int32
    var sourceByteLength: int32
    if projection != nil:
        if projection.released || contextIndex < 0 ||
           contextIndex >= projection.sourceByteLengths.len ||
           contextIndex >= projection.sourceLineStarts.len ||
           contextIndex >= projection.sourceLineCounts.len:
            err = Fmt" typed expr: frozen selected source line index unavailable source={source.sourcePath}"
            return false
        lineBase = projection.sourceLineStarts[contextIndex]
        lineCount = projection.sourceLineCounts[contextIndex]
        sourceByteLength = projection.sourceByteLengths[contextIndex]
    else:
        if contextIndex >= 0 || metadataCtx.sourceLineCount <= 0 ||
           metadataCtx.sourceLineByteStarts.len !=
               metadataCtx.sourceLineCount ||
           (metadataCtx.sourceLineByteLengths.len != 0 &&
            metadataCtx.sourceLineByteLengths.len !=
                metadataCtx.sourceLineCount) ||
           (metadataCtx.sourceLineOverrideTexts.len == 0 &&
            metadataCtx.sourceLineOverrideIndexes.len != 0) ||
           (metadataCtx.sourceLineOverrideTexts.len > 0 &&
            metadataCtx.sourceLineOverrideIndexes.len !=
                metadataCtx.sourceLineCount):
            err = Fmt" typed expr: pre-seal selected source line index unavailable source={source.sourcePath}"
            return false
        lineCount = metadataCtx.sourceLineCount
        sourceByteLength = metadataCtx.sourceByteLength
    if !source.textLoaded || source.text.len != sourceByteLength:
        err = Fmt" typed expr: selected source snapshot length mismatch source={source.sourcePath} bytes={source.text.len}/{sourceByteLength}"
        return false
    sourceLineCount = lineCount
    var previousEnd: int32
    for selectedIndex in 0..<selectedLineStarts.len:
        let selectedStart = selectedLineStarts[selectedIndex]
        let selectedCount = selectedLineCounts[selectedIndex]
        if selectedStart <= 0 || selectedCount <= 0 ||
           selectedStart > lineCount ||
           selectedCount > lineCount - selectedStart + 1 ||
           (selectedIndex > 0 && selectedStart <= previousEnd):
            err = Fmt" typed expr: sealed selected source range invalid source={source.sourcePath} row={selectedIndex} start={selectedStart} count={selectedCount} source_lines={lineCount} previous_end={previousEnd}"
            return false
        let selectedEnd = selectedStart + selectedCount - 1
        for lineNumber in selectedStart..selectedEnd:
            let rowIndex = lineBase + lineNumber - 1
            var byteStart: int32
            var byteLength: int32
            var overrideIndex: int32
            var overrideCount: int32
            if projection != nil:
                if rowIndex < 0 ||
                   rowIndex >= projection.sourceLineByteStarts.len ||
                   rowIndex >= projection.sourceLineByteLengths.len ||
                   (projection.sourceLineOverrideIndexes.len > 0 &&
                    rowIndex >= projection.sourceLineOverrideIndexes.len):
                    err = Fmt" typed expr: frozen selected source line row out of range source={source.sourcePath} line={lineNumber}"
                    return false
                byteStart = projection.sourceLineByteStarts[rowIndex]
                byteLength = projection.sourceLineByteLengths[rowIndex]
                overrideIndex = -1
                if projection.sourceLineOverrideIndexes.len > 0:
                    overrideIndex =
                        projection.sourceLineOverrideIndexes[rowIndex]
                overrideCount = projection.sourceLineOverrideTexts.len
            else:
                if rowIndex < 0 ||
                   rowIndex >= metadataCtx.sourceLineByteStarts.len ||
                   (metadataCtx.sourceLineByteLengths.len > 0 &&
                    rowIndex >= metadataCtx.sourceLineByteLengths.len) ||
                   (metadataCtx.sourceLineOverrideIndexes.len > 0 &&
                    rowIndex >= metadataCtx.sourceLineOverrideIndexes.len):
                    err = Fmt" typed expr: pre-seal selected source line row out of range source={source.sourcePath} line={lineNumber}"
                    return false
                byteStart = metadataCtx.sourceLineByteStarts[rowIndex]
                byteLength =
                    TypedExprSourceContextLineByteLength(metadataCtx,
                                                         rowIndex)
                overrideIndex = -1
                if metadataCtx.sourceLineOverrideIndexes.len > 0:
                    overrideIndex =
                        metadataCtx.sourceLineOverrideIndexes[rowIndex]
                overrideCount = metadataCtx.sourceLineOverrideTexts.len
            if byteStart < 0 || byteLength < 0 ||
               byteStart > source.text.len ||
               byteLength > source.text.len - byteStart ||
               overrideIndex < -1 || overrideIndex >= overrideCount:
                err = Fmt" typed expr: selected source line byte range invalid source={source.sourcePath} line={lineNumber} start={byteStart} length={byteLength} override={overrideIndex}"
                return false
            var line = ""
            if overrideIndex >= 0:
                if projection != nil:
                    line = projection.sourceLineOverrideTexts[overrideIndex]
                else:
                    line = metadataCtx.sourceLineOverrideTexts[overrideIndex]
            else:
                line = chengpath.TextSlice(
                    source.text, byteStart, byteLength)
            selectedLineBytes = typedExprCheckedAdd64(
                selectedLineBytes,
                Int64(line.len),
                "selected_source_line_bytes")
            add(lineNumbers, lineNumber)
            add(lines, line)
            selectedLineVisitCount =
                selectedLineVisitCount + Int64(1)
        previousEnd = selectedEnd
    err = ""
    return true

fn TypedExprEnsureSourceContextLinesLoaded(source: var TypedExprSourceText,
                                           ctx: var TypedExprSourceContext,
                                           err: var str): bool =
    if ctx.lines.len > 0:
        return true
    var normalizedText = ""
    if !TypedExprNormalizedSourceTextForContext(source, normalizedText, err):
        return false
    ctx.lines = parser.ParserSplitChar(normalizedText, '\n')
    normalizedText = ""
    if ctx.lines.len <= 0:
        err = Fmt" typed expr: empty source lines for IR body source={source.sourcePath}"
        return false
    return true

@borrows
fn TypedExprFunctionFilterAllowsDecl(index: TypedExprFunctionFilterIndex,
                                      sourcePathRaw: str,
                                      functionName: str,
                                      startLine: int32): bool =
    return TypedExprFunctionFilterAllows(index,
                                         sourcePathRaw,
                                         functionName,
                                         startLine)

@borrows
fn TypedExprSourceContextLineInScopes(scopes: TypedExprFunctionScope[],
                                      lineNumber: int32): bool =
    # scopes 升序非重叠 (TypedExprScopeIndexForLine 同一不变量), 二分找
    # startLine<=line 的最大下标再验区间。原线性含 malformed 防御跳过
    # (startLine<=0 / endLine<startLine) — 构造侧保证不产 malformed 行
    # (FunctionScopeEndLine 恒 >= startLine, decl.lineIndex 恒 > 0), 二分对
    # 候选做同判定。逐行调用 (TrimSourceContextLinesToScopes), O(F)->O(log F)。
    var lo: int32
    var hi = scopes.len
    while lo < hi:
        let mid = lo + (hi - lo) / 2
        if scopes[mid].startLine <= lineNumber:
            lo = mid + 1
        else:
            hi = mid
    if lo <= 0:
        return false
    let scope = scopes[lo - 1]
    if scope.startLine <= 0 || scope.endLine < scope.startLine:
        return false
    return lineNumber >= scope.startLine && lineNumber <= scope.endLine

fn TypedExprTrimSourceContextLinesToScopes(ctx: var TypedExprSourceContext,
                                           active: bool) =
    if !active:
        return
    if ctx.lines.len <= 0 || ctx.scopes.len <= 0:
        return
    # bail=44 C4 根修: 模块 const 块行必须保留。TypedExprModuleConstLiteralForContext
    # 的懒扫描在节点构建期读 ctx.lines; 此前 const 块(不在任何 fn scope 内)被整块
    # 置空 → 同模块裸 const 引用(及经其推导的绑定类型链)建不出节点 → Fmt piece/
    # call-arg 落 bail_44。状态机与 const 扫描器同口径: 顶层非空行更新块态,
    # 空行不重置。
    var inConstBlock = false
    for i in 0..<ctx.lines.len:
        if i % 512 == 0:
            os.ProcessResourceGuardCheck()
        let lineNumber = i + 1
        let rawLine = ctx.lines[i]
        var lineIsTopLevelConstEntry = false
        if !parser.ParserHasLeadingIndent(rawLine):
            let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
            if trimmed != "":
                inConstBlock = trimmed == "const"
                lineIsTopLevelConstEntry = parser.ParserStartsWith(trimmed, "const ")
        if TypedExprSourceContextLineInScopes(ctx.scopes, lineNumber):
            continue
        if inConstBlock || lineIsTopLevelConstEntry:
            continue
        ctx.lines[i] = ""

fn TypedExprTrimSourceContextLinesForFilteredBindings(ctx: var TypedExprSourceContext,
                                                      active: bool) =
    if !active:
        return
    if ctx.lines.len <= 0 || ctx.scopes.len <= 0:
        return
    var inGlobalVarBlock = false
    for i in 0..<ctx.lines.len:
        if i % 512 == 0:
            os.ProcessResourceGuardCheck()
        let lineNumber = i + 1
        let rawLine = ctx.lines[i]
        if TypedExprSourceContextLineInScopes(ctx.scopes, lineNumber):
            continue
        let hasLeadingIndent = parser.ParserHasLeadingIndent(rawLine)
        if !hasLeadingIndent:
            let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
            if trimmed != "":
                # bail=44 C4 根修: 与 ToScopes 同理, 模块 const 块条目行同样保留
                # (const 懒扫描后置于本裁剪之后)。
                inGlobalVarBlock = trimmed == "var" || trimmed == "const"
            continue
        if inGlobalVarBlock:
            continue
        ctx.lines[i] = ""

@borrows
fn TypedExprBuildSourceContextBorrowed(source: var TypedExprSourceText,
                                         ctx: var TypedExprSourceContext,
                                         includeBindings: bool,
                                         includeColdCsgRows: bool,
                                         includeTypeFields: bool,
                                         filterIndex: TypedExprFunctionFilterIndex,
                                         err: var str): bool =
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SITE=borrowed_init")
    TypedExprClearSourceContextAllFields(ctx)
    ctx.sourcePath = source.sourcePath
    ctx.normalizedSourcePath = parser.ParserNormalizePath(source.sourcePath)
    if source.workspaceRoot != "" || source.packageRoot != "" ||
       source.externalPackageRoots.len > 0:
        var sourceIdentity: TypedExprSourceIdentityIndex
        if !TypedExprBuildSourceIdentityOwnerRoots(source,
                                                   sourceIdentity,
                                                   err):
            return false
        # The source is definitionally a sealed closure member
        # (typedSourceTexts is the plan-sealed snapshot), so a root-out
        # member resolves through the exact absolute-path whitelist arm.
        add(sourceIdentity.sealedClosurePaths,
            parser.ParserNormalizePath(source.sourcePath))
        var physicalPath: str
        if !TypedExprSourceIdentityResolve(sourceIdentity,
                                           source.sourcePath,
                                           physicalPath,
                                           ctx.packageOwnerKey,
                                           err):
            return false
    ctx.snapshotOnly = source.snapshotOnly
    var normalizedText = ""
    if !parser.ParserRewriteMultilineStringSourceText(source.text, normalizedText, err):
        return false
    ctx.lines = parser.ParserSplitChar(normalizedText, '\n')
    normalizedText = ""
    ctx.scopes = []
    ctx.signatureScopes = []
    ctx.bindings = []
    ctx.bindingNameIndexBuiltCount = -1
    ctx.importcFunctions = []
    ctx.importedModules = []
    ctx.declaredTypes = []
    ctx.declaredTypeProducerSourceIndexes = []
    ctx.declaredTypeDeclarationSourceLocalRows = []
    ctx.declaredTypeBuiltinKinds = []
    ctx.refTypes = []
    ctx.typeDefAliasNames = []
    ctx.typeDefAliasTargetTypes = []
    ctx.typeFields = []
    ctx.coldCsgTypeRows = []
    ctx.coldCsgStatementRows = []
    ctx.enumValueNames = []
    ctx.enumValueTypes = []
    ctx.enumValueOrdinals = []
    ctx.exprLineColumnHeads = []
    ctx.exprLineColumnValues = []
    ctx.exprLineColumnNext = []
    var decls: parser.NormalizedFunctionDecl[]
    var allScopes: TypedExprFunctionScope[]
    var allDeclarationScopes: TypedExprFunctionScope[]
    if !TypedExprReadFunctionDeclsLinesInto(ctx.lines,
                                            source.migrationSourceSyntax,
                                            decls,
                                            err):
        return false
    TypedExprCollectDeclaredTypeNames(ctx.lines, ctx.declaredTypes)
    setLen(ctx.declaredTypeProducerSourceIndexes,
           ctx.declaredTypes.len)
    setLen(ctx.declaredTypeDeclarationSourceLocalRows,
           ctx.declaredTypes.len)
    setLen(ctx.declaredTypeBuiltinKinds, ctx.declaredTypes.len)
    for declaredTypeIndex in 0..<ctx.declaredTypes.len:
        ctx.declaredTypeProducerSourceIndexes[declaredTypeIndex] = -1
        ctx.declaredTypeDeclarationSourceLocalRows[declaredTypeIndex] = -1
    TypedExprTraceLine("typed_source_context:source_ready")
    for i in 0..<decls.len:
        TypedExprTraceLine("typed_source_context:decl_loop_top")
        if i < 8:
            TypedExprTraceLine("typed_source_context:decl_sample")
        if decls[i].importc:
            TypedExprTraceLine("typed_source_context:importc_branch")
            if decls[i].lineIndex > 0 && decls[i].lineIndex <= ctx.lines.len:
                TypedExprTraceLine("typed_source_context:before_importc_header")
                let declHeader = TypedExprFunctionDeclHeaderTextForContext(ctx, decls[i].lineIndex)
                TypedExprTraceLine("typed_source_context:after_importc_header")
                var importcFn: TypedExprImportcFunction
                importcFn.sourcePath = strings.CloneStr(source.sourcePath)
                importcFn.name = strings.CloneStr(decls[i].name)
                importcFn.producerDeclarationOrdinal = i
                TypedExprTraceLine("typed_source_context:before_importc_annotation")
                importcFn.importName = TypedExprImportcAnnotationNameForDecl(ctx.lines, decls[i].lineIndex)
                TypedExprTraceLine("typed_source_context:after_importc_annotation")
                TypedExprTraceLine("typed_source_context:before_importc_return")
                importcFn.returnType = TypedExprParseFunctionReturnType(declHeader)
                TypedExprTraceLine("typed_source_context:after_importc_return")
                importcFn.ffiMapPtrArg = decls[i].ffiMapPtrArg
                importcFn.ffiMapLenArg = decls[i].ffiMapLenArg
                importcFn.ffiOutPtrArgs = decls[i].ffiOutPtrArgs
                importcFn.abiInternal = decls[i].abiInternal
                importcFn.ffiOwnedResultPresent = decls[i].ffiOwnedResultPresent
                importcFn.ffiOwnedResultFree = decls[i].ffiOwnedResultFree
                TypedExprTraceLine("typed_source_context:before_importc_param_count")
                let paramCount = TypedExprCountFunctionParams(declHeader)
                TypedExprTraceLine("typed_source_context:after_importc_param_count")
                TypedExprTraceLine("typed_source_context:before_importc_params")
                let params = TypedExprFunctionParamsOwned(declHeader)
                TypedExprTraceLine("typed_source_context:after_importc_params")
                importcFn.paramTypeJoin = TypedExprJoinParamTypes(params)
                TypedExprTraceLine("typed_source_context:before_importc_add")
                add(ctx.importcFunctions, importcFn)
                TypedExprTraceLine("typed_source_context:after_importc_add")
                TypedExprTraceLine("typed_source_context:before_importc_return_again")
                let returnType = TypedExprParseFunctionReturnType(declHeader)
                TypedExprTraceLine("typed_source_context:after_importc_return_again")
                TypedExprTraceLine("typed_source_context:before_importc_ffi_validate")
                let ffiErrors = TypedExprValidateFfiAnnotations(decls[i],
                                                                 paramCount,
                                                                 params,
                                                                 returnType,
                                                                 true)
                TypedExprTraceLine("typed_source_context:after_importc_ffi_validate")
                if ffiErrors.len > 0:
                    err = ffiErrors[0]
                    return false
                TypedExprTraceLine("typed_source_context:before_importc_str_abi")
                let strAbiErrors: str[] = TypedExprValidateStrCAbiBridge(source.sourcePath,
                                                                         decls[i],
                                                                         declHeader,
                                                                         params,
                                                                         returnType,
                                                                         false)
                TypedExprTraceLine("typed_source_context:after_importc_str_abi")
                if strAbiErrors.len > 0:
                    err = strAbiErrors[0]
                    return false
            continue
        TypedExprTraceLine("typed_source_context:local_decl_branch")
        if decls[i].lineIndex <= 0 || decls[i].lineIndex > ctx.lines.len:
            continue
        TypedExprTraceLine("typed_source_context:local_decl_valid_line")
        var scope: TypedExprFunctionScope
        scope.sourcePath = strings.CloneStr(source.sourcePath)
        scope.name = strings.CloneStr(decls[i].name)
        scope.producerDeclarationOrdinal = i
        scope.startLine = decls[i].lineIndex
        scope.borrowResult = decls[i].borrowResult
        scope.borrowsArguments = decls[i].borrows
        scope.manualConsumePresent = decls[i].manualConsumePresent
        scope.manualConsumeFunctionDeclarationRow =
            decls[i].manualConsumeFunctionDeclarationRow
        scope.manualConsumeTargetParameterOrdinal =
            decls[i].manualConsumeTargetParameterOrdinal
        scope.manualConsumeSourceParameterOrdinal =
            decls[i].manualConsumeSourceParameterOrdinal
        scope.manualConsumeTargetParameterDeclarationRow =
            decls[i].manualConsumeTargetParameterDeclarationRow
        scope.manualConsumeSourceParameterDeclarationRow =
            decls[i].manualConsumeSourceParameterDeclarationRow
        TypedExprTraceLine("typed_source_context:local_decl_scope_init")
        let nextDeclLine = TypedExprNextTopLevelDeclLine(ctx.lines, decls, i)
        TypedExprTraceLine("typed_source_context:local_decl_before_scope_end")
        scope.endLine = TypedExprFunctionScopeEndLine(ctx.lines,
                                                      scope.startLine,
                                                      nextDeclLine)
        TypedExprTraceLine("typed_source_context:local_decl_after_scope_end")
        TypedExprTraceLine("typed_source_context:local_decl_before_header")
        let declHeader = TypedExprFunctionDeclHeaderTextForContext(ctx, decls[i].lineIndex)
        TypedExprTraceLine("typed_source_context:local_decl_after_header")
        # 前向声明桩(仅签名无 `=`, 供互递归调用先行可见, 如 json.cheng 的
        # jsonParseValue/jsonParseArray)不注册为独立 codegen 目标——同名的真实定义
        # (带顶层 `=`)会稍后作为 decls[] 的另一条目正常走到这里注册。多行签名约定
        # 强制闭合行含 `= `(TypedExprFunctionDeclHeaderText 已拼好整段), 无顶层 `=`
        # 即可判定该行不可能有函数体, 判定安全且无需额外读取正文。
        if TypedExprFindTopLevelTextToken(declHeader, "=") < 0:
            if includeBindings:
                add(allScopes, typedExprFunctionScopeCloneOwned(scope))
            continue
        TypedExprTraceLine("typed_source_context:local_decl_before_return")
        scope.returnType = TypedExprParseFunctionReturnType(declHeader)
        # 无 `:`/`->` 返回类型标记的合法签名 = void 函数，必须落 canonical
        # "void" 权威文本（与 TypedExprScopeCallDeclarationInto、
        # typedExprLookupLocalFunctionReturnTypeFromNormalizedMetadata 及
        # typed_expr_type_arena 的 semantic builtin void scalar 同一契约）。
        # scope.returnType 经 fnIr.returnType intern 进 functions2 后由
        # TypedExprIrFunctionFragmentValidate 强制非空；"" 旧约定在 codec 面非法。
        if scope.returnType == "":
            scope.returnType = "void"
        TypedExprTraceLine("typed_source_context:local_decl_after_return")
        let params = TypedExprFunctionParamsOwned(declHeader)
        var paramTypesForGenerics: str[]
        for paramIndex in 0..<params.len:
            add(paramTypesForGenerics, strings.CloneStr(params[paramIndex].typeText))
        let genericRes = TypedExprFunctionGenericNameJoinOwned(ctx,
                                                               declHeader,
                                                               paramTypesForGenerics,
                                                               scope.returnType)
        if !genericRes.ok:
            err = Fmt"{genericRes.err} source={source.sourcePath} name={scope.name} line={scope.startLine}"
            return false
        scope.genericNameJoin = genericRes.join
        scope.genericNamesComplete = true
        scope.paramTypeJoin = TypedExprJoinParamTypes(params)
        scope.paramTypesComplete = true
        if includeBindings:
            add(allScopes, typedExprFunctionScopeCloneOwned(scope))
            add(allDeclarationScopes, typedExprFunctionScopeCloneOwned(scope))
        if !TypedExprFunctionFilterAllowsDecl(filterIndex,
                                              source.sourcePath,
                                              decls[i].name,
                                              decls[i].lineIndex):
            continue
        TypedExprTraceLine("typed_source_context:local_decl_before_exportc")
        let exportc = TypedExprDeclHasExportcAnnotation(decls[i])
        TypedExprTraceLine("typed_source_context:local_decl_after_exportc")
        TypedExprTraceLine("typed_source_context:local_decl_before_param_count")
        let paramCount = params.len
        TypedExprTraceLine("typed_source_context:local_decl_after_param_count")
        TypedExprTraceLine("typed_source_context:local_decl_before_ffi_validate")
        let ffiErrors = TypedExprValidateFfiAnnotations(decls[i],
                                                         paramCount,
                                                         params,
                                                         scope.returnType,
                                                         exportc)
        TypedExprTraceLine("typed_source_context:local_decl_after_ffi_validate")
        if ffiErrors.len > 0:
            err = ffiErrors[0]
            return false
        TypedExprTraceLine("typed_source_context:local_decl_before_str_abi")
        let strAbiErrors: str[] = TypedExprValidateStrCAbiBridge(source.sourcePath,
                                                                 decls[i],
                                                                 declHeader,
                                                                 params,
                                                                 scope.returnType,
                                                                 exportc)
        TypedExprTraceLine("typed_source_context:local_decl_after_str_abi")
        if strAbiErrors.len > 0:
            err = strAbiErrors[0]
            return false
        TypedExprTraceLine("typed_source_context:local_decl_before_scope_add")
        if includeBindings:
            add(ctx.scopes, typedExprFunctionScopeCloneOwned(scope))
            TypedExprTraceLine("typed_source_context:local_decl_before_param_bindings")
            TypedExprAppendParamBindings(ctx.bindings, scope, declHeader)
            TypedExprTraceLine("typed_source_context:local_decl_after_param_bindings")
        else:
            add(ctx.scopes, typedExprFunctionScopeCloneOwned(scope))
        TypedExprTraceLine("typed_source_context:local_decl_after_scope_add")
    TypedExprTraceLine("typed_source_context:scope_loop_done")
    var bindingCallDeclarationIndex: TypedExprBuildIndex
    var bindingSourceContexts: TypedExprSourceContext[]
    var priorBindingBuildIndex: TypedExprBuildIndex
    var priorBindingBuildIndexOwned: bool
    if includeBindings:
        TypedExprSourceContextTakeBuildIndex(ctx,
                                             priorBindingBuildIndex,
                                             priorBindingBuildIndexOwned)
        var bindingDeclarationCtx = TypedExprSourceContextBorrowedView(ctx)
        bindingDeclarationCtx.signatureScopes = share(allDeclarationScopes)
        let declarationCapacity = typedExprCheckedAdd64(
            Int64(allDeclarationScopes.len), Int64(ctx.importcFunctions.len),
            "binding_call_declaration_capacity")
        bindingCallDeclarationIndex = TypedExprBuildIndexNew(
            typedExprCheckedInt32Capacity(typedExprCheckedAdd64(
                declarationCapacity, 8, "binding_call_declaration_capacity"),
                "binding_call_declaration_capacity"))
        if bindingCallDeclarationIndex == nil:
            panic(Fmt"typed expr: source binding call declaration index allocation returned nil source={source.sourcePath} declarations={allDeclarationScopes.len} importc={ctx.importcFunctions.len} prior_index_nil={priorBindingBuildIndex == nil} prior_owned={priorBindingBuildIndexOwned}")
        typedExprBuildIndexRequireMutable(
            bindingCallDeclarationIndex,
            "source_binding_call_declarations")
        TypedExprBuildIndexAddContextCallDeclarations(bindingCallDeclarationIndex,
                                                      bindingDeclarationCtx,
                                                      0)
        TypedExprBuildIndexSealCallDeclarations(bindingCallDeclarationIndex)
        TypedExprSourceContextSetOwnedBuildIndex(ctx, bindingCallDeclarationIndex)
    TypedExprTraceLine("typed_source_context:before_decls_clear")
    decls = []
    TypedExprTraceLine("typed_source_context:after_decls_clear")
    if filterIndex.active && !includeTypeFields && !includeColdCsgRows:
        TypedExprTrimSourceContextLinesForFilteredBindings(ctx, true)
    TypedExprScopeLoopVarTablePrepare(ctx)
    # Type metadata (declared types, ref types, aliases, enum values and
    # declared field rows) is a pure function of the source lines. Scan it
    # BEFORE the binding loop: binding-initializer call resolution types
    # `param.field` arguments through TypedExprAssignStatementType, which
    # reads the declared field rows; scanning after the loop left every
    # local field unknown during binding typing (call declaration static
    # argument type unavailable).
    var inTypeBlock = false
    var currentTypeName = ""
    var currentTypeIndent: int32
    var currentTypeIsEnum = false
    var currentEnumOrdinal: int32
    TypedExprTraceLine("typed_source_context:type_loop_begin")
    for i in 0..<ctx.lines.len:
        if !includeTypeFields && !includeColdCsgRows:
            break
        if i % 128 == 0:
            TypedExprTraceLine("typed_source_context:type_loop_chunk")
        let rawLine = ctx.lines[i]
        let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
        if !parser.ParserHasLeadingIndent(rawLine):
            if trimmed == "":
                continue
            currentTypeName = ""
            currentTypeIndent = 0
            currentTypeIsEnum = false
            currentEnumOrdinal = 0
            inTypeBlock = trimmed == "type"
            let inlineTypeTail = TypedExprInlineTypeDeclTail(trimmed)
            if inlineTypeTail != "":
                inTypeBlock = true
                let inlineRes = TypedExprContextProcessTypeDeclLineOwned(ctx.sourcePath,
                                                                         ctx.typeDefAliasNames,
                                                                         ctx.typeDefAliasTargetTypes,
                                                                         ctx.refTypes,
                                                                         ctx.enumValueNames,
                                                                         ctx.enumValueTypes,
                                                                         ctx.enumValueOrdinals,
                                                                         ctx.declaredTypes,
                                                                         ctx.declaredTypeProducerSourceIndexes,
                                                                         ctx.declaredTypeDeclarationSourceLocalRows,
                                                                         ctx.declaredTypeBuiltinKinds,
                                                                         inlineTypeTail,
                                                                         0,
                                                                         includeTypeFields,
                                                                         currentTypeName,
                                                                         currentTypeIndent,
                                                                         currentTypeIsEnum,
                                                                         currentEnumOrdinal,
                                                                         i + 1)
                ctx.typeDefAliasNames = inlineRes.typeDefAliasNames
                ctx.typeDefAliasTargetTypes = inlineRes.typeDefAliasTargetTypes
                ctx.refTypes = inlineRes.refTypes
                ctx.enumValueNames = inlineRes.enumValueNames
                ctx.enumValueTypes = inlineRes.enumValueTypes
                ctx.enumValueOrdinals = inlineRes.enumValueOrdinals
                ctx.declaredTypes = inlineRes.declaredTypes
                ctx.declaredTypeProducerSourceIndexes = inlineRes.declaredTypeProducerSourceIndexes
                ctx.declaredTypeDeclarationSourceLocalRows = inlineRes.declaredTypeDeclarationSourceLocalRows
                ctx.declaredTypeBuiltinKinds = inlineRes.declaredTypeBuiltinKinds
                currentTypeName = inlineRes.currentTypeName
                currentTypeIndent = inlineRes.currentTypeIndent
                currentTypeIsEnum = inlineRes.currentTypeIsEnum
                currentEnumOrdinal = inlineRes.currentEnumOrdinal
                if inlineRes.err != "":
                    err = inlineRes.err
                    return false
                # [phaseB-parser] inline tuple 具名元素登记 ctx 字段行
                # （includeTypeFields 口径与缩进字段登记一致）
                if includeTypeFields:
                    var inlineTupleFieldErr: str
                    TypedExprContextAddInlineTupleTypeFields(
                        ctx.typeFields,
                        inlineRes.currentTypeName,
                        TypedExprParseTypeDeclRhs(trimmed),
                        ctx.sourcePath,
                        i + 1,
                        inlineTupleFieldErr)
                    if inlineTupleFieldErr != "":
                        err = inlineTupleFieldErr
                        return false
            continue
        if !inTypeBlock:
            continue
        let lineIndent = TypedExprLineIndentWidth(rawLine)
        # Enum value lines may carry explicit ordinals (`Name = 0`); the type
        # decl parser below would misread them as sibling `Name = alias`
        # decls, hijacking currentTypeName and dropping all the enum values.
        if currentTypeIsEnum && currentTypeName != "" && lineIndent > currentTypeIndent:
            TypedExprTraceLine("typed_source_context:enum_value_check")
            if includeTypeFields:
                # bail=44 C4 根修: 多值一行的枚举值行 (`pcFile, pcDir, ...`) 此前只
                # 取首个 ident, 其余成员在枚举表缺失 → 跨模块限定成员建不出节点。
                # 按逗号切分逐个登记, 与 inline `= enum A, B, C` 路径同口径。
                let enumPieces = parser.ParserSplitChar(trimmed, ',')
                for enumPieceIndex in 0..<enumPieces.len:
                    let enumPiece = chengpath.PathTrim(enumPieces[enumPieceIndex])
                    let enumName = parser.ParserIdentPrefix(enumPiece)
                    if enumName != "":
                        let enumOrdinal = TypedExprEnumValueLineOrdinal(enumPiece, currentEnumOrdinal)
                        add(ctx.enumValueNames, enumName)
                        add(ctx.enumValueTypes, share(currentTypeName))
                        add(ctx.enumValueOrdinals, enumOrdinal)
                        currentEnumOrdinal = enumOrdinal + 1
            continue
        let typeRes = TypedExprContextProcessTypeDeclLineOwned(ctx.sourcePath,
                                                               ctx.typeDefAliasNames,
                                                               ctx.typeDefAliasTargetTypes,
                                                               ctx.refTypes,
                                                               ctx.enumValueNames,
                                                               ctx.enumValueTypes,
                                                               ctx.enumValueOrdinals,
                                                               ctx.declaredTypes,
                                                               ctx.declaredTypeProducerSourceIndexes,
                                                               ctx.declaredTypeDeclarationSourceLocalRows,
                                                               ctx.declaredTypeBuiltinKinds,
                                                               trimmed,
                                                               lineIndent,
                                                               includeTypeFields,
                                                               currentTypeName,
                                                               currentTypeIndent,
                                                               currentTypeIsEnum,
                                                               currentEnumOrdinal,
                                                               i + 1)
        ctx.typeDefAliasNames = typeRes.typeDefAliasNames
        ctx.typeDefAliasTargetTypes = typeRes.typeDefAliasTargetTypes
        ctx.refTypes = typeRes.refTypes
        ctx.enumValueNames = typeRes.enumValueNames
        ctx.enumValueTypes = typeRes.enumValueTypes
        ctx.enumValueOrdinals = typeRes.enumValueOrdinals
        ctx.declaredTypes = typeRes.declaredTypes
        ctx.declaredTypeProducerSourceIndexes = typeRes.declaredTypeProducerSourceIndexes
        ctx.declaredTypeDeclarationSourceLocalRows = typeRes.declaredTypeDeclarationSourceLocalRows
        ctx.declaredTypeBuiltinKinds = typeRes.declaredTypeBuiltinKinds
        currentTypeName = typeRes.currentTypeName
        currentTypeIndent = typeRes.currentTypeIndent
        currentTypeIsEnum = typeRes.currentTypeIsEnum
        currentEnumOrdinal = typeRes.currentEnumOrdinal
        if typeRes.err != "":
            err = typeRes.err
            return false
        # [phaseB-parser] 缩进式 `Name = tuple[...]` 声明行的具名元素同口径
        # 登记（includeTypeFields 口径一致）
        if typeRes.declaredType != "" && includeTypeFields:
            var inlineTupleFieldErr: str
            TypedExprContextAddInlineTupleTypeFields(
                ctx.typeFields,
                typeRes.declaredType,
                TypedExprParseTypeDeclRhs(trimmed),
                ctx.sourcePath,
                i + 1,
                inlineTupleFieldErr)
            if inlineTupleFieldErr != "":
                err = inlineTupleFieldErr
                return false
        if typeRes.declaredType != "":
            TypedExprTraceLine("typed_source_context:type_decl")
            continue
        if currentTypeName == "" || lineIndent <= currentTypeIndent:
            continue
        let fieldParse = TypedExprParseTypeFieldLineOwned(trimmed)
        if fieldParse.ok:
            if !includeTypeFields:
                continue
            TypedExprTraceLine("typed_source_context:type_field")
            TypedExprTraceLine("typed_source_context:type_field_before_sabi")
            if TypedExprTypeContainsSabiBoundary(fieldParse.fieldType):
                err = Fmt"ZRPC/SABI violation at {source.sourcePath}:{i + 1}: SABI boundary type `{fieldParse.fieldType}` cannot be used as an object field"
                return false
            TypedExprTraceLine("typed_source_context:type_field_after_sabi")
            TypedExprTraceLine("typed_source_context:type_field_before_add")
            TypedExprAddTypeFieldDeclInPlace(ctx.typeFields,
                                             currentTypeName,
                                             fieldParse.fieldName,
                                             fieldParse.fieldType)
            TypedExprTraceLine("typed_source_context:type_field_after_add")
    TypedExprTraceLine("typed_source_context:type_loop_done")
    if includeBindings:
        var inGlobalVarBlock = false
        var inGlobalConstBlock = false
        for i in 0..<ctx.lines.len:
            TypedExprTraceLine("typed_source_context:binding_loop_row")
            let lineNumber = i + 1
            var scopeIndex = -1
            var allScopeIndex = -1
            let rawLineForBinding = ctx.lines[i]
            let trimmedForBinding = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLineForBinding)))
            if !parser.ParserHasLeadingIndent(rawLineForBinding):
                if trimmedForBinding != "":
                    inGlobalVarBlock = trimmedForBinding == "var"
                    inGlobalConstBlock = trimmedForBinding == "const"
            if filterIndex.active:
                allScopeIndex = TypedExprScopeIndexForLine(allScopes, lineNumber)
                if allScopeIndex >= 0:
                    scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
                    if scopeIndex < 0:
                        continue
            else:
                scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
            let bindingParse = TypedExprParseBindingLineOwned(rawLineForBinding)
            var bindingName = bindingParse.name
            var bindingType = bindingParse.typeText
            let rhsStartColumn = bindingParse.rhsStartColumn
            if !bindingParse.ok:
                if (inGlobalVarBlock || inGlobalConstBlock) &&
                   parser.ParserHasLeadingIndent(rawLineForBinding):
                    let fieldParse = TypedExprParseTypeFieldLineOwned(rawLineForBinding)
                    var constName = ""
                    var constType = ""
                    var constInit = ""
                    if fieldParse.ok:
                        if TypedExprTypeContainsSabiBoundary(fieldParse.fieldType):
                            err = Fmt"ZRPC/SABI violation at {source.sourcePath}:{i + 1}: SABI boundary type `{fieldParse.fieldType}` cannot be used as a global value"
                            break
                        TypedExprMaybeAddBinding(ctx.bindings,
                                                source.sourcePath,
                                                "",
                                                true,
                                                inGlobalVarBlock,
                                                i + 1,
                                                fieldParse.fieldName,
                                                fieldParse.fieldType)
                    elif inGlobalConstBlock &&
                         TypedExprConstBlockEntryBinding(rawLineForBinding,
                                                         constName,
                                                         constType,
                                                         constInit):
                        if TypedExprTypeContainsSabiBoundary(constType):
                            err = Fmt"ZRPC/SABI violation at {source.sourcePath}:{i + 1}: SABI boundary type `{constType}` cannot be used as a global value"
                            break
                        TypedExprMaybeAddBindingInit(ctx.bindings,
                                                     source.sourcePath,
                                                     "",
                                                     true,
                                                     false,
                                                     i + 1,
                                                     constName,
                                                     constType,
                                                     constInit)
                continue
            if TypedExprTypeContainsSabiBoundary(bindingType):
                err = Fmt"ZRPC/SABI violation at {source.sourcePath}:{lineNumber}: SABI boundary type `{bindingType}` cannot be used as a local/global value"
                return false
            if bindingType == "" && rhsStartColumn > 0:
                bindingType = TypedExprBindingRhsBoolExprType(TypedExprBindingRhsText(rawLineForBinding,
                                                                                         rhsStartColumn))
                if bindingType == "" && rhsStartColumn > 0:
                    bindingType = TypedExprLiteralBindingType(TypedExprBindingRhsText(rawLineForBinding,
                                                                                      rhsStartColumn))
                if filterIndex.active && allScopeIndex >= 0 && scopeIndex < 0:
                    continue
                if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
                    bindingType = TypedExprInferLocalDeclTypeFromIdentRhs(ctx.bindings,
                                                                          ctx.scopes[scopeIndex].name,
                                                                          lineNumber,
                                                                          TypedExprBindingRhsText(rawLineForBinding,
                                                                                                  rhsStartColumn))
                if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
                    bindingType = TypedExprBindingRhsForRangeI32Type(ctx,
                                                                     ctx.scopes[scopeIndex],
                                                                     lineNumber,
                                                                     TypedExprBindingRhsText(rawLineForBinding,
                                                                                             rhsStartColumn))
                # `var/let out = new(T)`:堆分配内征,按类型实参单态化成 ref{T}。必须抢在
                # 下面 LocalFn 返回类型查询之前 —— 否则 system.cheng `fn new(): ref T`
                # 被解析成未替换的裸 `ref T`→记 refT 进 ctx.bindings,而 ctx.bindings 是
                # TypedExprBindingRhsLocalRefType 的首选源(短路 prior),使 out.data 字段
                # 解析 root_type=refT 失败 → whole-call no_node。镜像 whole-call 节点
                # builder 10042;后端 new 分配按 surfaceText 不依赖此类型,纯修正。
                if bindingType == "" && rhsStartColumn > 0:
                    let newDeclRhs = TypedExprBindingRhsTextWithContinuation(ctx, i, rhsStartColumn)
                    let newDeclHead = TypedExprBindingRhsCallHead(newDeclRhs)
                    if TypedExprQualifiedCallLeaf(newDeclHead) == "new":
                        let newDeclOpen = TypedExprFindWholeCallOpenParen(newDeclRhs)
                        let newDeclClose = TypedExprFindMatchingParen(newDeclRhs, newDeclOpen)
                        if newDeclOpen > 0 && newDeclClose > newDeclOpen:
                            let newDeclArg = chengpath.PathTrim(chengpath.TextSlice(newDeclRhs,
                                                                                   newDeclOpen + 1,
                                                                                   newDeclClose - newDeclOpen - 1))
                            if newDeclArg != "" && TypedExprFindTopLevelToken(newDeclArg, ",") < 0:
                                let newDeclRef = TypedExprNormalizeTypeText(Fmt"ref{newDeclArg}")
                                if TypedExprTypeTextIsConcrete(newDeclRef):
                                    bindingType = newDeclRef
                # `let x = LocalFn(...)` with no explicit type: infer x's type from the
                # callee's declared return type. The ident-RHS / bool-expr / literal
                # inferers above don't cover a bare unqualified local-function call, so
                # without this the binding has no recorded type and any later use of `x`
                # as a node leaf (e.g. the rhs of `A != "" && x`) can't resolve its type
                # and leaves the condition node unbuilt. The RHS may live on continuation
                # lines (`let x =` newline `Fn(...)`), so gather it continuation-aware.
                # Unqualified local calls resolve from ctx.scopes alone (no sourceContexts
                # needed); void returns are not value bindings so they stay unrecorded.
                if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
                    let bindingRhsCallText = TypedExprBindingRhsTextWithContinuation(ctx,
                                                                                     i,
                                                                                     rhsStartColumn)
                    bindingType = TypedExprNamedAggregateConstructorDeclaredTypeLock(
                        ctx,
                        bindingRhsCallText)
                    # Imported type layouts are not available in this first,
                    # source-local metadata pass. A named surface must therefore
                    # remain deferred unless a local declared type locked it above;
                    # entering the value-call resolver here would try to type the
                    # raw `field: value` item and fail before the full metadata pass
                    # can apply the imported type namespace.
                    if bindingType == "" &&
                       !TypedExprBindingRhsUsesNamedArgumentSurface(bindingRhsCallText):
                        let bindingRhsCallHead = TypedExprBindingRhsCallHead(bindingRhsCallText)
                        if bindingRhsCallHead != "" &&
                           TypedExprQualifiedCallQualifier(bindingRhsCallHead) == "":
                            TypedExprBindingNameIndexPrepare(ctx)
                            let bindingLocalCallReturnType = TypedExprBindingRhsCallReturnType(ctx,
                                                                                               bindingSourceContexts,
                                                                                               lineNumber,
                                                                                               bindingRhsCallText)
                            if bindingLocalCallReturnType != "" && bindingLocalCallReturnType != "void":
                                bindingType = bindingLocalCallReturnType
                # Source-order value typing must exist before facts choose overloaded
                # call declarations.  Infer a still-untyped binding from its complete
                # RHS with the same precedence/result rules used by value IR; unknown
                # or illegal expressions remain absent and fail at their first use.
                if bindingType == "" && rhsStartColumn > 0 && scopeIndex >= 0:
                    let bindingRhsStaticText = TypedExprBindingRhsTextWithContinuation(ctx,
                                                                                       i,
                                                                                       rhsStartColumn)
                    # This is still the source-local pass: an imported named
                    # aggregate has no layout here. Keep the whole `T(field: v)`
                    # surface deferred instead of recursively treating `field: v`
                    # as a value-call argument; the metadata/facts pass owns it
                    # once the imported type namespace is frozen.
                    if !TypedExprBindingRhsUsesNamedArgumentSurface(
                            bindingRhsStaticText):
                        # Static typing below reads previous local/parameter bindings
                        # through TypedExprLookupBindingTypeIndexed. The context is still
                        # being built line-by-line, so refresh the immutable name index
                        # immediately before this read-only query.
                        TypedExprBindingNameIndexPrepare(ctx)
                        bindingType = TypedExprStaticExprTypeAtLevel(ctx,
                                                                      bindingSourceContexts,
                                                                      ctx.scopes[scopeIndex],
                                                                      lineNumber,
                                                                      bindingRhsStaticText,
                                                                      0)
            if scopeIndex >= 0:
                TypedExprMaybeAddBinding(ctx.bindings,
                                         source.sourcePath,
                                         ctx.scopes[scopeIndex].name,
                                         false,
                                         parser.ParserBindingDeclarationIsMutable(
                                             rawLineForBinding),
                                         lineNumber,
                                         bindingName,
                                         bindingType)
            else:
                var globalInitText = ""
                if rhsStartColumn > 0:
                    globalInitText = TypedExprBindingRhsText(rawLineForBinding,
                                                             rhsStartColumn)
                TypedExprMaybeAddBindingInit(ctx.bindings,
                                             source.sourcePath,
                                             "",
                                             true,
                                             parser.ParserBindingDeclarationIsMutable(
                                                 rawLineForBinding),
                                             lineNumber,
                                             bindingName,
                                             bindingType,
                                             globalInitText)
        TypedExprSourceContextReleaseBuildIndex(ctx)
        TypedExprSourceContextRestoreBuildIndex(ctx,
                                               priorBindingBuildIndex,
                                               priorBindingBuildIndexOwned)
        if err != "":
            return false
        allScopes = []
        allDeclarationScopes = []
    TypedExprBindingNameIndexPrepare(ctx)
    TypedExprTraceLine("typed_source_context:binding_loop_done")
    var importWorkspaceRoot = source.workspaceRoot
    var importPackageRoot = source.packageRoot
    if importWorkspaceRoot == "" || importPackageRoot == "":
        let normalizedSourcePathForImports = parser.ParserNormalizePath(source.sourcePath)
        let srcMarkerPos = parser.ParserFindText(normalizedSourcePathForImports, "/src/")
        if srcMarkerPos > 0:
            let inferredPackageRoot = chengpath.TextSlice(normalizedSourcePathForImports,
                                                          0,
                                                          srcMarkerPos)
            if importWorkspaceRoot == "":
                if importPackageRoot == "":
                    importWorkspaceRoot = share(inferredPackageRoot)
                    importPackageRoot = inferredPackageRoot
                else:
                    importWorkspaceRoot = inferredPackageRoot
            else:
                importPackageRoot = inferredPackageRoot
    if includeTypeFields && importWorkspaceRoot != "" && importPackageRoot != "":
        TypedExprTraceLine("typed_source_context:before_import_edges")
        let ownerModulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(importWorkspaceRoot,
                                                                                          importPackageRoot,
                                                                                          source.externalPackageRoots,
                                                                                          source.sourcePath)
        var importEdges: parser.ImportEdge[]
        if !parser.ParserReadImportEdgesLinesWithExternalPackageRoots(importWorkspaceRoot,
                                                                      importPackageRoot,
                                                                      source.externalPackageRoots,
                                                                      ownerModulePath,
                                                                      ctx.lines,
                                                                      importEdges,
                                                                      err):
            return false
        TypedExprTraceLine("typed_source_context:after_import_edges_read")
        for i in 0..<importEdges.len:
            TypedExprTraceLine("typed_source_context:import_edge_loop")
            if !importEdges[i].resolved:
                continue
            let qualifier = parser.ParserImportEdgeQualifier(importEdges[i])
            if qualifier == "":
                continue
            var importedModule: TypedExprImportedModule
            importedModule.qualifier = qualifier
            importedModule.allowsUnqualifiedCall = importEdges[i].allowsUnqualifiedCall
            let importedSourcePathNorm = parser.ParserNormalizePath(importEdges[i].targetSourcePath)
            var importedOwnedPath = strings.stringsNewStringCopy(importedSourcePathNorm.data, importedSourcePathNorm.len)
            importedOwnedPath.flags = 0
            importedModule.targetSourcePath = importedOwnedPath
            add(ctx.importedModules, importedModule)
        TypedExprTraceLine("typed_source_context:import_edges_done")
    if includeColdCsgRows:
        TypedExprTraceLine("typed_source_context:before_cold_csg_rows")
        TypedExprColdCsgAppendTypeRowsToContext(ctx)
        TypedExprTraceLine("typed_source_context:after_cold_csg_rows")
    TypedExprTrimSourceContextLinesToScopes(ctx, filterIndex.active)
    err = ""
    return true

@borrows
fn typedExprSourceLineEqualsSnapshot(text: str,
                                      start: int32,
                                      count: int32,
                                      line: str): bool =
    if start < 0 || count < 0 || start > text.len ||
       count > text.len - start ||
       count != line.len:
        return false
    for byteIndex in 0..<count:
        if text[start + byteIndex] != line[byteIndex]:
            return false
    return true

fn typedExprBuildSealedSourceLineIndex(
        source: var TypedExprSourceText,
        normalizedLines: var str[],
        ctx: var TypedExprSourceContext,
        err: var str): bool =
    ctx.sourceByteLength = 0
    ctx.sourceLineByteStarts = []
    ctx.sourceLineByteLengths = []
    ctx.sourceLineOverrideIndexes = []
    ctx.sourceLineOverrideTexts = []
    ctx.sourceIndexProducerFullTraversalCount = 0
    if !source.textLoaded:
        err = Fmt" typed expr: sealed source line index snapshot missing source={source.sourcePath}"
        return false
    if parser.ParserNormalizePath(source.sourcePath) != ctx.normalizedSourcePath:
        err = Fmt" typed expr: sealed source line index identity mismatch source={source.sourcePath} metadata={ctx.sourcePath}"
        return false
    ctx.sourceByteLength = source.text.len
    # Pre-size the retained per-line start column to the exact normalized line
    # count. Repeated add() growth leaves up to ~2x capacity per source live
    # through metadata/typed IR; the loop below fills every slot by index.
    seqs.setLen(ctx.sourceLineByteStarts, normalizedLines.len)
    var start: int32
    var lineIndex: int32
    for cursor in 0..source.text.len:
        if cursor % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if cursor < source.text.len && source.text[cursor] != '\n':
            continue
        if lineIndex >= normalizedLines.len:
            err = Fmt" typed expr: sealed source line index raw line overflow source={source.sourcePath} line={lineIndex + 1} normalized_lines={normalizedLines.len}"
            return false
        let lineLength = cursor - start
        ctx.sourceLineByteStarts[lineIndex] = start
        if typedExprSourceLineEqualsSnapshot(source.text,
                                              start,
                                              lineLength,
                                              normalizedLines[lineIndex]):
            if ctx.sourceLineOverrideIndexes.len > 0:
                ctx.sourceLineOverrideIndexes[lineIndex] = -1
        else:
            if ctx.sourceLineOverrideIndexes.len == 0:
                # First override: allocate the exact column once and backfill
                # the preceding all-(-1) rows. No-override sources never
                # allocate this column at all.
                seqs.setLen(ctx.sourceLineOverrideIndexes,
                            normalizedLines.len)
                for fillIndex in 0..<lineIndex:
                    ctx.sourceLineOverrideIndexes[fillIndex] = -1
            ctx.sourceLineOverrideIndexes[lineIndex] =
                ctx.sourceLineOverrideTexts.len
            add(ctx.sourceLineOverrideTexts,
                share(normalizedLines[lineIndex]))
        lineIndex = lineIndex + 1
        if cursor < source.text.len:
            start = cursor + 1
    # An all-(-1) override column is pure overhead: readers synthesize -1 when
    # the column is absent and the override text table is empty. Release it
    # before the context enters the retained metadata set.
    if ctx.sourceLineOverrideTexts.len == 0:
        seqs.freeSeq_int32(ctx.sourceLineOverrideIndexes)
        ctx.sourceLineOverrideIndexes = []
    if lineIndex != normalizedLines.len ||
       ctx.sourceLineByteStarts.len != normalizedLines.len ||
       (ctx.sourceLineByteLengths.len != 0 &&
        ctx.sourceLineByteLengths.len != normalizedLines.len) ||
       (ctx.sourceLineOverrideTexts.len == 0 &&
        ctx.sourceLineOverrideIndexes.len != 0) ||
       (ctx.sourceLineOverrideTexts.len > 0 &&
        ctx.sourceLineOverrideIndexes.len != normalizedLines.len):
        err = Fmt" typed expr: sealed source line index cardinality mismatch source={source.sourcePath} raw_lines={lineIndex} normalized_lines={normalizedLines.len}"
        return false
    ctx.sourceLineCount = lineIndex
    ctx.sourceIndexProducerFullTraversalCount = 1
    err = ""
    return true

# [t8-knifeA] Zero-alloc view twin of TypedExprInlineTypeDeclTail, valid only
# for already-trimmed line views (the only form the profile-metadata declared
# type scan feeds it). Byte-equivalent: the input is PathTrim-clean, so the
# twin's function-local PathTrim is an identity clone; ParserStartsWith
# (text-side trim + prefix compare) reduces to ParserStartsWithExact; and the
# PathTrim(TextSlice(...)) tail is exactly the trim range of the same byte
# window taken as a borrowed view. Keeps the ParseTypeDeclName(tail) != ""
# admission check so "tail non-empty" means the same thing on both sides.
@borrows
@borrow_result
fn typedExprInlineTypeDeclTailView(trimmedView: str): str =
    if !parser.ParserStartsWithExact(trimmedView, "type "):
        return ""
    let tailWindow = parser.ParserTextSliceFast(trimmedView, 5, trimmedView.len - 5)
    var tailStart: int32
    var tailStop: int32
    if !parser.ParserTrimmedLineRange(tailWindow, tailStart, tailStop):
        return ""
    let tailView = parser.ParserTextSliceFast(tailWindow, tailStart, tailStop - tailStart)
    if TypedExprParseTypeDeclName(tailView) == "":
        return ""
    return tailView

# [t8-knifeA] T4 刀A 交割：sealed 源行索引与 declaredTypes 收集融合为单遍
# 行扫描。行索引臂与 typedExprBuildSealedSourceLineIndex 逐语句同码；每行
# 等值判定（常态：无 override）直接在 raw 行切片 view 上跑
# TypedExprCollectDeclaredTypeNames 的状态机（零分配：TrimmedLineView/
# StartsWithExact/FindText/行切片全是借位视图，inline type 头走
# typedExprInlineTypeDeclTailView），override 行退回 normalizedLines 原行，
# 与旧第二遍同输入。唯一调用点 TypedExprBuildMetadataContextFromProfile；
# 等价性由 CHENG_T8_EQUIV_DUMP 门控对拍轮证明（旧两遍在 scratch ctx 重跑
# 逐字段对拍，任一字段不等硬失败）。
fn typedExprBuildSealedSourceLineIndexAndDeclaredTypes(
        source: var TypedExprSourceText,
        normalizedLines: var str[],
        ctx: var TypedExprSourceContext,
        err: var str): bool =
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "LINEIDX-IN")
    # declaredTypes 状态机局部态（镜像 TypedExprCollectDeclaredTypeNames）
    var dtInTypeBlock = false
    var dtCurrentTypeName = ""
    var dtCurrentTypeIndent: int32
    var dtCurrentTypeIsEnum = false
    ctx.declaredTypes = []
    ctx.sourceByteLength = 0
    ctx.sourceLineByteStarts = []
    ctx.sourceLineByteLengths = []
    ctx.sourceLineOverrideIndexes = []
    ctx.sourceLineOverrideTexts = []
    ctx.sourceIndexProducerFullTraversalCount = 0
    if !source.textLoaded:
        err = Fmt" typed expr: sealed source line index snapshot missing source={source.sourcePath}"
        return false
    if parser.ParserNormalizePath(source.sourcePath) != ctx.normalizedSourcePath:
        err = Fmt" typed expr: sealed source line index identity mismatch source={source.sourcePath} metadata={ctx.sourcePath}"
        return false
    ctx.sourceByteLength = source.text.len
    # Pre-size the retained per-line start column to the exact normalized line
    # count. Repeated add() growth leaves up to ~2x capacity per source live
    # through metadata/typed IR; the loop below fills every slot by index.
    seqs.setLen(ctx.sourceLineByteStarts, normalizedLines.len)
    var start: int32
    var lineIndex: int32
    for cursor in 0..source.text.len:
        if cursor % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if cursor < source.text.len && source.text[cursor] != '\n':
            continue
        if lineIndex >= normalizedLines.len:
            err = Fmt" typed expr: sealed source line index raw line overflow source={source.sourcePath} line={lineIndex + 1} normalized_lines={normalizedLines.len}"
            return false
        let lineLength = cursor - start
        ctx.sourceLineByteStarts[lineIndex] = start
        var lineMatchesSnapshot = false
        if typedExprSourceLineEqualsSnapshot(source.text,
                                              start,
                                              lineLength,
                                              normalizedLines[lineIndex]):
            lineMatchesSnapshot = true
            if ctx.sourceLineOverrideIndexes.len > 0:
                ctx.sourceLineOverrideIndexes[lineIndex] = -1
        else:
            if ctx.sourceLineOverrideIndexes.len == 0:
                # First override: allocate the exact column once and backfill
                # the preceding all-(-1) rows. No-override sources never
                # allocate this column at all.
                seqs.setLen(ctx.sourceLineOverrideIndexes,
                            normalizedLines.len)
                for fillIndex in 0..<lineIndex:
                    ctx.sourceLineOverrideIndexes[fillIndex] = -1
            ctx.sourceLineOverrideIndexes[lineIndex] =
                ctx.sourceLineOverrideTexts.len
            add(ctx.sourceLineOverrideTexts,
                share(normalizedLines[lineIndex]))
        # ---- declaredTypes 状态机（本行）：等值行走 raw 切片 view ----
        var dtRawLine: str
        if lineMatchesSnapshot:
            dtRawLine = parser.ParserTextSliceFast(source.text, start, lineLength)
        else:
            dtRawLine = normalizedLines[lineIndex]
        let dtTrimmed = TypedExprTrimmedLineView(dtRawLine)
        if !parser.ParserHasLeadingIndent(dtRawLine):
            if dtTrimmed != "":
                dtCurrentTypeName = ""
                dtCurrentTypeIndent = 0
                dtCurrentTypeIsEnum = false
                dtInTypeBlock = dtTrimmed == "type"
                let dtInlineTail = typedExprInlineTypeDeclTailView(dtTrimmed)
                if dtInlineTail != "":
                    dtInTypeBlock = true
                    let dtDeclared = TypedExprParseTypeDeclName(dtInlineTail)
                    if dtDeclared != "":
                        if !parser.ParserStringSeqContainsExact(
                                ctx.declaredTypes, dtDeclared):
                            add(ctx.declaredTypes, share(dtDeclared))
                        dtCurrentTypeName = dtDeclared
                        dtCurrentTypeIsEnum = parser.ParserFindText(
                            dtInlineTail, "enum") >= 0
        elif dtInTypeBlock:
            let dtLineIndent = TypedExprLineIndentWidth(dtRawLine)
            if !(dtCurrentTypeIsEnum && dtCurrentTypeName != "" &&
                 dtLineIndent > dtCurrentTypeIndent):
                let dtDeclared = TypedExprParseTypeDeclName(dtTrimmed)
                if dtDeclared != "":
                    if !parser.ParserStringSeqContainsExact(
                            ctx.declaredTypes, dtDeclared):
                        add(ctx.declaredTypes, share(dtDeclared))
                    dtCurrentTypeName = dtDeclared
                    dtCurrentTypeIndent = dtLineIndent
                    dtCurrentTypeIsEnum = parser.ParserFindText(
                        dtTrimmed, "enum") >= 0
        lineIndex = lineIndex + 1
        if cursor < source.text.len:
            start = cursor + 1
    # An all-(-1) override column is pure overhead: readers synthesize -1 when
    # the column is absent and the override text table is empty. Release it
    # before the context enters the retained metadata set.
    if ctx.sourceLineOverrideTexts.len == 0:
        seqs.freeSeq_int32(ctx.sourceLineOverrideIndexes)
        ctx.sourceLineOverrideIndexes = []
    if lineIndex != normalizedLines.len ||
       ctx.sourceLineByteStarts.len != normalizedLines.len ||
       (ctx.sourceLineByteLengths.len != 0 &&
        ctx.sourceLineByteLengths.len != normalizedLines.len) ||
       (ctx.sourceLineOverrideTexts.len == 0 &&
        ctx.sourceLineOverrideIndexes.len != 0) ||
       (ctx.sourceLineOverrideTexts.len > 0 &&
        ctx.sourceLineOverrideIndexes.len != normalizedLines.len):
        err = Fmt" typed expr: sealed source line index cardinality mismatch source={source.sourcePath} raw_lines={lineIndex} normalized_lines={normalizedLines.len}"
        return false
    ctx.sourceLineCount = lineIndex
    ctx.sourceIndexProducerFullTraversalCount = 1
    err = ""
    return true

fn typedExprBuildSealedGlobalBindings(
        profile: var parser.NormalizedExprCallProfile,
        ctx: var TypedExprSourceContext,
        err: var str): bool =
    ctx.bindings = []
    # Borrow the producer's normalized rows only while deriving compact global
    # binding records.  The successful metadata context retains no dense line
    # sequence.
    ctx.lines = profile.lines
    var inGlobalVarBlock = false
    var inGlobalConstBlock = false
    for lineIndex in 0..<profile.lines.len:
        let lineNumber = lineIndex + 1
        let rawLine = profile.lines[lineIndex]
        # [ledgerwalk-3] 0 分配候选预检：剥注释+trim 走 view（type 块循环同款
        # TypedExprTrimmedLineView），只有 let/var/const 候选行与 var 块内缩进
        # 行才进原解析路径。候选判定与 TypedExprParseBindingLine 的 prefix
        # 早退条件逐字节等价（同一剥注释/trim 语义；ParserStartsWithExact 对
        # 已 trim 的 view 与 ParserStartsWith 对 trimmed 恒等），其余行在原
        # 路径同样于 ParseBindingLine prefix 检查处 0 效果早退——每行 2-4 个
        # trim CloneStr 暂存分配（诊断梯子 globals 域 ~1.15 块/行、全仓
        # 667349 活块的来源）就此消失。
        let trimmedView = TypedExprTrimmedLineView(rawLine)
        let bindingCandidate =
            parser.ParserStartsWithExact(trimmedView, "let ") ||
            parser.ParserStartsWithExact(trimmedView, "var ") ||
            parser.ParserStartsWithExact(trimmedView, "const ")
        let hasLeadingIndent = parser.ParserHasLeadingIndent(rawLine)
        if !hasLeadingIndent && trimmedView.len > 0:
            inGlobalVarBlock = trimmedView == "var"
            inGlobalConstBlock = trimmedView == "const"
        if (inGlobalVarBlock || inGlobalConstBlock) && hasLeadingIndent:
            var globalName = ""
            var globalType = ""
            var globalInit = ""
            if TypedExprParseTypeFieldLine(rawLine, globalName, globalType):
                if TypedExprTypeContainsSabiBoundary(globalType):
                    ctx.lines = []
                    err = Fmt"ZRPC/SABI violation at {profile.sourcePath}:{lineNumber}: SABI boundary type `{globalType}` cannot be used as a global value"
                    return false
                TypedExprMaybeAddBinding(ctx.bindings,
                                          profile.sourcePath,
                                          "",
                                          true,
                                          inGlobalVarBlock,
                                          lineNumber,
                                          globalName,
                                          globalType)
            elif inGlobalConstBlock &&
                 TypedExprConstBlockEntryBinding(rawLine,
                                                 globalName,
                                                 globalType,
                                                 globalInit):
                if TypedExprTypeContainsSabiBoundary(globalType):
                    ctx.lines = []
                    err = Fmt"ZRPC/SABI violation at {profile.sourcePath}:{lineNumber}: SABI boundary type `{globalType}` cannot be used as a global value"
                    return false
                TypedExprMaybeAddBindingInit(ctx.bindings,
                                             profile.sourcePath,
                                             "",
                                             true,
                                             false,
                                             lineNumber,
                                             globalName,
                                             globalType,
                                             globalInit)
            continue
        if !bindingCandidate:
            continue
        var bindingName = ""
        var bindingType = ""
        var rhsStartColumn: int32 = -1
        if !TypedExprParseBindingLine(rawLine,
                                      bindingName,
                                      bindingType,
                                      rhsStartColumn) ||
           TypedExprScopeIndexForLine(ctx.scopes, lineNumber) >= 0:
            continue
        if TypedExprTypeContainsSabiBoundary(bindingType):
            ctx.lines = []
            err = Fmt"ZRPC/SABI violation at {profile.sourcePath}:{lineNumber}: SABI boundary type `{bindingType}` cannot be used as a global value"
            return false
        if bindingType == "" && rhsStartColumn > 0:
            bindingType = TypedExprBindingRhsBoolExprType(
                TypedExprBindingRhsText(rawLine, rhsStartColumn))
        if bindingType == "" && rhsStartColumn > 0:
            bindingType = TypedExprLiteralBindingType(
                TypedExprBindingRhsText(rawLine, rhsStartColumn))
        if bindingType == "" && rhsStartColumn > 0:
            let rhsText = TypedExprBindingRhsTextWithContinuation(
                ctx, lineIndex, rhsStartColumn)
            let callHead = TypedExprBindingRhsCallHead(rhsText)
            if TypedExprQualifiedCallLeaf(callHead) == "new":
                let openPos = TypedExprFindWholeCallOpenParen(rhsText)
                let closePos = TypedExprFindMatchingParen(rhsText, openPos)
                if openPos > 0 && closePos > openPos:
                    let arg = chengpath.PathTrim(chengpath.TextSlice(
                        rhsText,
                        openPos + 1,
                        closePos - openPos - 1))
                    if arg != "" &&
                       TypedExprFindTopLevelToken(arg, ",") < 0:
                        let refType = TypedExprNormalizeTypeText(Fmt"ref{arg}")
                        if TypedExprTypeTextIsConcrete(refType):
                            bindingType = refType
        var initValueText = ""
        if rhsStartColumn > 0:
            initValueText = TypedExprBindingRhsText(rawLine,
                                                     rhsStartColumn)
        TypedExprMaybeAddBindingInit(
            ctx.bindings,
            profile.sourcePath,
            "",
            true,
            parser.ParserBindingDeclarationIsMutable(rawLine),
            lineNumber,
            bindingName,
            bindingType,
            initValueText)
    ctx.lines = []
    err = ""
    return true

fn TypedExprBuildMetadataContextFromProfile(profile: var parser.NormalizedExprCallProfile,
                                             source: var TypedExprSourceText,
                                             ctx: var TypedExprSourceContext,
                                             err: var str): bool =
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SITE=meta_from_profile")
    TypedExprClearSourceContextAllFields(ctx)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "MF1")
    ctx.sourcePath = profile.sourcePath
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "MF2")
    ctx.normalizedSourcePath = parser.ParserNormalizePath(profile.sourcePath)
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "MF3")
    if source.workspaceRoot != "" || source.packageRoot != "" ||
       source.externalPackageRoots.len > 0:
        var sourceIdentity: TypedExprSourceIdentityIndex
        if !TypedExprBuildSourceIdentityOwnerRoots(source,
                                                   sourceIdentity,
                                                   err):
            return false
        # The source is definitionally a sealed closure member
        # (typedSourceTexts is the plan-sealed snapshot), so a root-out
        # member resolves through the exact absolute-path whitelist arm.
        add(sourceIdentity.sealedClosurePaths,
            parser.ParserNormalizePath(source.sourcePath))
        var physicalPath: str
        if !TypedExprSourceIdentityResolve(sourceIdentity,
                                           source.sourcePath,
                                           physicalPath,
                                           ctx.packageOwnerKey,
                                           err):
            return false
            if orcd8TraceEnabled():
                os.WriteLine(os.Get_stderr(), "MF4")
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "MF5")
    ctx.snapshotOnly = source.snapshotOnly
    ctx.lines = []
    ctx.scopes = []
    ctx.signatureScopes = []
    ctx.bindings = []
    ctx.bindingNameIndexBuiltCount = -1
    ctx.importcFunctions = []
    ctx.importedModules = []
    ctx.declaredTypes = []
    ctx.declaredTypeProducerSourceIndexes = []
    ctx.declaredTypeDeclarationSourceLocalRows = []
    ctx.declaredTypeBuiltinKinds = []
    ctx.refTypes = []
    ctx.typeDefAliasNames = []
    ctx.typeDefAliasTargetTypes = []
    ctx.typeFields = []
    ctx.coldCsgTypeRows = []
    ctx.coldCsgStatementRows = []
    ctx.enumValueNames = []
    ctx.enumValueTypes = []
    ctx.enumValueOrdinals = []
    ctx.exprLineColumnHeads = []
    ctx.exprLineColumnValues = []
    ctx.exprLineColumnNext = []
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "MF6")
    if !typedExprBuildSealedSourceLineIndexAndDeclaredTypes(source,
                                             profile.lines,
                                             ctx,
                                             err):
        if orcd8TraceEnabled():
            os.WriteLine(os.Get_stderr(), "MF7FAIL")
        return false
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "MF7")
    # [t8-equiv] env 门控逐字段对拍：旧两遍路径在 scratch ctx 上重跑，与融合
    # 产出逐字段比对；任一字段不等 → 硬失败（let-it-crash，无兜底）。默认
    # 门关 = 每源一次 GetEnv + 单布尔判，零 I/O 零行为差。
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "E0")
    let t8EquivArmed = os.GetEnv("CHENG_T8_EQUIV_DUMP")
    if t8EquivArmed != "":
        var t8Scratch: TypedExprSourceContext
        var t8Err: str
        # 旧路径的 identity 检查读 ctx.normalizedSourcePath；scratch 需继承
        # 与融合路径同一身份字段（fused 内同一检查已对真 ctx 通过）。
        t8Scratch.sourcePath = ctx.sourcePath
        t8Scratch.normalizedSourcePath = ctx.normalizedSourcePath
        if !typedExprBuildSealedSourceLineIndex(source,
                                                profile.lines,
                                                t8Scratch,
                                                t8Err):
            err = Fmt"t8_equiv: legacy line index failed source={profile.sourcePath} err={t8Err}"
            return false
        TypedExprCollectDeclaredTypeNames(profile.lines, t8Scratch.declaredTypes)
        var t8Mismatch = ""
        if t8Scratch.sourceByteLength != ctx.sourceByteLength:
            t8Mismatch = "sourceByteLength"
        elif t8Scratch.sourceLineByteLengths.len != ctx.sourceLineByteLengths.len:
            t8Mismatch = "sourceLineByteLengths.len"
        elif t8Scratch.sourceLineCount != ctx.sourceLineCount:
            t8Mismatch = "sourceLineCount"
        elif t8Scratch.sourceIndexProducerFullTraversalCount != ctx.sourceIndexProducerFullTraversalCount:
            t8Mismatch = "sourceIndexProducerFullTraversalCount"
        elif t8Scratch.sourceLineByteStarts.len != ctx.sourceLineByteStarts.len:
            t8Mismatch = "sourceLineByteStarts.len"
        elif t8Scratch.sourceLineOverrideIndexes.len != ctx.sourceLineOverrideIndexes.len:
            t8Mismatch = "sourceLineOverrideIndexes.len"
        elif t8Scratch.sourceLineOverrideTexts.len != ctx.sourceLineOverrideTexts.len:
            t8Mismatch = "sourceLineOverrideTexts.len"
        elif t8Scratch.declaredTypes.len != ctx.declaredTypes.len:
            t8Mismatch = "declaredTypes.len"
        if t8Mismatch == "":
            var t8I: int32
            while t8I < ctx.sourceLineByteStarts.len:
                if t8Scratch.sourceLineByteStarts[t8I] != ctx.sourceLineByteStarts[t8I]:
                    t8Mismatch = Fmt"sourceLineByteStarts[{t8I}]"
                    break
                t8I = t8I + 1
        if t8Mismatch == "":
            var t8J: int32
            while t8J < ctx.sourceLineOverrideIndexes.len:
                if t8Scratch.sourceLineOverrideIndexes[t8J] != ctx.sourceLineOverrideIndexes[t8J]:
                    t8Mismatch = Fmt"sourceLineOverrideIndexes[{t8J}]"
                    break
                t8J = t8J + 1
        if t8Mismatch == "":
            var t8K: int32
            while t8K < ctx.sourceLineOverrideTexts.len:
                if t8Scratch.sourceLineOverrideTexts[t8K] != ctx.sourceLineOverrideTexts[t8K]:
                    t8Mismatch = Fmt"sourceLineOverrideTexts[{t8K}]"
                    break
                t8K = t8K + 1
        if t8Mismatch == "":
            var t8M: int32
            while t8M < ctx.declaredTypes.len:
                if t8Scratch.declaredTypes[t8M] != ctx.declaredTypes[t8M]:
                    t8Mismatch = Fmt"declaredTypes[{t8M}]"
                    break
                t8M = t8M + 1
        if t8Mismatch != "":
            err = Fmt"t8_equiv mismatch source={profile.sourcePath} field={t8Mismatch} fused_declared={ctx.declaredTypes.len} legacy_declared={t8Scratch.declaredTypes.len}"
            return false
        os.WriteLine(os.Get_stderr(),
                     Fmt"t8_equiv_ok source={profile.sourcePath} lines={ctx.sourceLineCount} declared={ctx.declaredTypes.len} overrides={ctx.sourceLineOverrideTexts.len}")
    setLen(ctx.declaredTypeProducerSourceIndexes,
           ctx.declaredTypes.len)
    setLen(ctx.declaredTypeDeclarationSourceLocalRows,
           ctx.declaredTypes.len)
    setLen(ctx.declaredTypeBuiltinKinds, ctx.declaredTypes.len)
    for declaredTypeIndex in 0..<ctx.declaredTypes.len:
        ctx.declaredTypeProducerSourceIndexes[declaredTypeIndex] = -1
        ctx.declaredTypeDeclarationSourceLocalRows[declaredTypeIndex] = -1
    let declTraceFilter = os.GetEnv("CHENG_TYPED_DECL_TRACE")
    let declTrace = declTraceFilter != "" && parser.ParserFindText(profile.sourcePath, declTraceFilter) >= 0
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "E1")
    for i in 0..<profile.decls.len:
        let decl = profile.decls[i]
        if orcd8TraceEnabled():
            var o9Imp: int32 = 0
            if decl.importc:
                o9Imp = 1
            os.WriteLine(os.Get_stderr(), Fmt"O8DL n={i} imp={o9Imp}")
        if declTrace:
            TypedExprTraceStderrLine(true, Fmt"decl_trace name={decl.name} line={decl.lineIndex} importc={decl.importc}")
        if decl.importc:
            var importcFn: TypedExprImportcFunction
            importcFn.sourcePath = profile.sourcePath
            importcFn.name = decl.name
            importcFn.producerDeclarationOrdinal = i
            if decl.lineIndex > 0 && decl.lineIndex <= profile.lines.len:
                let declHeader = TypedExprFunctionDeclHeaderText(profile.lines, decl.lineIndex)
                importcFn.importName = TypedExprImportcAnnotationNameForDecl(profile.lines, decl.lineIndex)
                importcFn.returnType = TypedExprParseFunctionReturnType(declHeader)
                importcFn.ffiMapPtrArg = decl.ffiMapPtrArg
                importcFn.ffiMapLenArg = decl.ffiMapLenArg
                importcFn.ffiOutPtrArgs = decl.ffiOutPtrArgs
                importcFn.abiInternal = decl.abiInternal
                importcFn.ffiOwnedResultPresent = decl.ffiOwnedResultPresent
                importcFn.ffiOwnedResultFree = decl.ffiOwnedResultFree
                let paramCount = TypedExprCountFunctionParams(declHeader)
                var params: TypedExprParam[]
                TypedExprFunctionParamsInto(declHeader, params)
                importcFn.paramTypeJoin = TypedExprJoinParamTypes(params)
                # [ledgerwalk-1] 二次 ParseFunctionReturnType(declHeader) 复用
                # importcFn.returnType（同一 declHeader 同一函数，逐字节恒等）。
                let returnType = share(importcFn.returnType)
                let ffiErrors = TypedExprValidateFfiAnnotations(decl,
                                                                 paramCount,
                                                                 params,
                                                                 returnType,
                                                                 true)
                if ffiErrors.len > 0:
                    err = ffiErrors[0]
                    return false
                let strAbiErrors: str[] = TypedExprValidateStrCAbiBridge(profile.sourcePath,
                                                                         decl,
                                                                         declHeader,
                                                                         params,
                                                                         returnType,
                                                                         false)
                if strAbiErrors.len > 0:
                    err = strAbiErrors[0]
                    return false
            add(ctx.importcFunctions, importcFn)
            continue
        if decl.lineIndex <= 0 || decl.lineIndex > profile.lines.len:
            continue
        var scope: TypedExprFunctionScope
        scope.sourcePath = ""
        scope.name = decl.name
        scope.producerDeclarationOrdinal = i
        scope.startLine = decl.lineIndex
        scope.borrowResult = decl.borrowResult
        scope.borrowsArguments = decl.borrows
        scope.manualConsumePresent = decl.manualConsumePresent
        scope.manualConsumeFunctionDeclarationRow =
            decl.manualConsumeFunctionDeclarationRow
        scope.manualConsumeTargetParameterOrdinal =
            decl.manualConsumeTargetParameterOrdinal
        scope.manualConsumeSourceParameterOrdinal =
            decl.manualConsumeSourceParameterOrdinal
        scope.manualConsumeTargetParameterDeclarationRow =
            decl.manualConsumeTargetParameterDeclarationRow
        scope.manualConsumeSourceParameterDeclarationRow =
            decl.manualConsumeSourceParameterDeclarationRow
        let nextDeclLine = TypedExprNextTopLevelDeclLine(profile.lines, profile.decls, i)
        scope.endLine = TypedExprFunctionScopeEndLine(profile.lines,
                                                      scope.startLine,
                                                      nextDeclLine)
        let declHeader = TypedExprFunctionDeclHeaderText(profile.lines, decl.lineIndex)
        # 镜像 TypedExprBuildSourceContextBorrowed 的前向声明桩跳过(同一 duplicate-scope
        # 缺陷在 profile 元数据路径的另一构造点): 无顶层 `=` 即无函数体, 不注册。
        if TypedExprFindTopLevelTextToken(declHeader, "=") < 0:
            continue
        scope.returnType = TypedExprParseFunctionReturnType(declHeader)
        # 镜像 TypedExprBuildSourceContextBorrowed 的 canonical void 权威文本
        # 契约（同注释机理）：void 签名此处必须落 "void" 而非 ""，frozen 投影
        # intern 与 fnIr intern 共用本值，codec 非空校验才可全程一致。
        if scope.returnType == "":
            scope.returnType = "void"
        let exportc = TypedExprDeclHasExportcAnnotation(decl)
        var params: TypedExprParam[]
        TypedExprFunctionParamsInto(declHeader, params)
        var genericNames: str[]
        var genericErr: str
        var paramTypesForGenerics: str[]
        for paramIndex in 0..<params.len:
            add(paramTypesForGenerics, share(params[paramIndex].typeText))
        if !TypedExprFunctionGenericNamesInto(ctx,
                                               declHeader,
                                               paramTypesForGenerics,
                                               scope.returnType,
                                               genericNames,
                                               genericErr):
            err = Fmt"{genericErr} source={profile.sourcePath} name={scope.name} line={scope.startLine}"
            return false
        scope.genericNameJoin = TypedExprJoinGenericNames(genericNames)
        scope.genericNamesComplete = true
        scope.paramTypeJoin = TypedExprJoinParamTypes(params)
        scope.paramTypesComplete = true
        let paramCount = params.len
        let ffiErrors = TypedExprValidateFfiAnnotations(decl,
                                                         paramCount,
                                                         params,
                                                         scope.returnType,
                                                         exportc)
        if ffiErrors.len > 0:
            err = ffiErrors[0]
            return false
        let strAbiErrors: str[] = TypedExprValidateStrCAbiBridge(profile.sourcePath,
                                                                 decl,
                                                                 declHeader,
                                                                 params,
                                                                 scope.returnType,
                                                                 exportc)
        if strAbiErrors.len > 0:
            err = strAbiErrors[0]
            return false
        add(ctx.scopes, scope)
    var inTypeBlock = false
    var currentTypeName = ""
    var currentTypeIndent: int32
    var currentTypeIsEnum = false
    var currentEnumOrdinal: int32
    for i in 0..<profile.lines.len:
        let rawLine = profile.lines[i]
        let trimmed = TypedExprTrimmedLineView(rawLine)
        if !parser.ParserHasLeadingIndent(rawLine):
            if trimmed == "":
                continue
            currentTypeName = ""
            currentTypeIndent = 0
            currentTypeIsEnum = false
            currentEnumOrdinal = 0
            inTypeBlock = trimmed == "type"
            let inlineTypeTail = TypedExprInlineTypeDeclTail(trimmed)
            if inlineTypeTail != "":
                inTypeBlock = true
                let inlineRes = TypedExprContextProcessTypeDeclLineOwned(ctx.sourcePath,
                                                                         ctx.typeDefAliasNames,
                                                                         ctx.typeDefAliasTargetTypes,
                                                                         ctx.refTypes,
                                                                         ctx.enumValueNames,
                                                                         ctx.enumValueTypes,
                                                                         ctx.enumValueOrdinals,
                                                                         ctx.declaredTypes,
                                                                         ctx.declaredTypeProducerSourceIndexes,
                                                                         ctx.declaredTypeDeclarationSourceLocalRows,
                                                                         ctx.declaredTypeBuiltinKinds,
                                                                         inlineTypeTail,
                                                                         0,
                                                                         true,
                                                                         currentTypeName,
                                                                         currentTypeIndent,
                                                                         currentTypeIsEnum,
                                                                         currentEnumOrdinal,
                                                                         i + 1)
                ctx.typeDefAliasNames = inlineRes.typeDefAliasNames
                ctx.typeDefAliasTargetTypes = inlineRes.typeDefAliasTargetTypes
                ctx.refTypes = inlineRes.refTypes
                ctx.enumValueNames = inlineRes.enumValueNames
                ctx.enumValueTypes = inlineRes.enumValueTypes
                ctx.enumValueOrdinals = inlineRes.enumValueOrdinals
                ctx.declaredTypes = inlineRes.declaredTypes
                ctx.declaredTypeProducerSourceIndexes = inlineRes.declaredTypeProducerSourceIndexes
                ctx.declaredTypeDeclarationSourceLocalRows = inlineRes.declaredTypeDeclarationSourceLocalRows
                ctx.declaredTypeBuiltinKinds = inlineRes.declaredTypeBuiltinKinds
                currentTypeName = inlineRes.currentTypeName
                currentTypeIndent = inlineRes.currentTypeIndent
                currentTypeIsEnum = inlineRes.currentTypeIsEnum
                currentEnumOrdinal = inlineRes.currentEnumOrdinal
                if inlineRes.err != "":
                    err = inlineRes.err
                    return false
                # [phaseB-parser] inline tuple 具名元素登记 ctx 字段行
                # （profile 元数据路径，字段登记恒开）
                var inlineTupleFieldErr: str
                TypedExprContextAddInlineTupleTypeFields(
                    ctx.typeFields,
                    inlineRes.currentTypeName,
                    TypedExprParseTypeDeclRhs(trimmed),
                    ctx.sourcePath,
                    i + 1,
                    inlineTupleFieldErr)
                if inlineTupleFieldErr != "":
                    err = inlineTupleFieldErr
                    return false
            continue
        if !inTypeBlock:
            continue
        let lineIndent = TypedExprLineIndentWidth(rawLine)
        # Enum value lines may carry explicit ordinals (`Name = 0`); the type
        # decl parser below would misread them as sibling `Name = alias`
        # decls, hijacking currentTypeName and dropping all the enum values.
        if currentTypeIsEnum && currentTypeName != "" && lineIndent > currentTypeIndent:
            # bail=44 C4 根修: 与 BuildSourceContextBorrowed 的枚举值行走查同口径,
            # 多值一行按逗号切分逐个登记 (此前只取首 ident, pcDir 等成员缺失)。
            let enumPieces = parser.ParserSplitChar(trimmed, ',')
            for enumPieceIndex in 0..<enumPieces.len:
                let enumPiece = chengpath.PathTrim(enumPieces[enumPieceIndex])
                let enumName = parser.ParserIdentPrefix(enumPiece)
                if enumName != "":
                    let enumOrdinal = TypedExprEnumValueLineOrdinal(enumPiece, currentEnumOrdinal)
                    add(ctx.enumValueNames, enumName)
                    add(ctx.enumValueTypes, share(currentTypeName))
                    add(ctx.enumValueOrdinals, enumOrdinal)
                    currentEnumOrdinal = enumOrdinal + 1
            continue
        let typeRes = TypedExprContextProcessTypeDeclLineOwned(ctx.sourcePath,
                                                               ctx.typeDefAliasNames,
                                                               ctx.typeDefAliasTargetTypes,
                                                               ctx.refTypes,
                                                               ctx.enumValueNames,
                                                               ctx.enumValueTypes,
                                                               ctx.enumValueOrdinals,
                                                               ctx.declaredTypes,
                                                               ctx.declaredTypeProducerSourceIndexes,
                                                               ctx.declaredTypeDeclarationSourceLocalRows,
                                                               ctx.declaredTypeBuiltinKinds,
                                                               trimmed,
                                                               lineIndent,
                                                               true,
                                                               currentTypeName,
                                                               currentTypeIndent,
                                                               currentTypeIsEnum,
                                                               currentEnumOrdinal,
                                                               i + 1)
        ctx.typeDefAliasNames = typeRes.typeDefAliasNames
        ctx.typeDefAliasTargetTypes = typeRes.typeDefAliasTargetTypes
        ctx.refTypes = typeRes.refTypes
        ctx.enumValueNames = typeRes.enumValueNames
        ctx.enumValueTypes = typeRes.enumValueTypes
        ctx.enumValueOrdinals = typeRes.enumValueOrdinals
        ctx.declaredTypes = typeRes.declaredTypes
        ctx.declaredTypeProducerSourceIndexes = typeRes.declaredTypeProducerSourceIndexes
        ctx.declaredTypeDeclarationSourceLocalRows = typeRes.declaredTypeDeclarationSourceLocalRows
        ctx.declaredTypeBuiltinKinds = typeRes.declaredTypeBuiltinKinds
        currentTypeName = typeRes.currentTypeName
        currentTypeIndent = typeRes.currentTypeIndent
        currentTypeIsEnum = typeRes.currentTypeIsEnum
        currentEnumOrdinal = typeRes.currentEnumOrdinal
        if typeRes.err != "":
            err = typeRes.err
            return false
        # [phaseB-parser] 缩进式 `Name = tuple[...]` 声明行的具名元素同口径
        # 登记（profile 元数据路径，字段登记恒开）
        if typeRes.declaredType != "":
            var inlineTupleFieldErr: str
            TypedExprContextAddInlineTupleTypeFields(
                ctx.typeFields,
                typeRes.declaredType,
                TypedExprParseTypeDeclRhs(trimmed),
                ctx.sourcePath,
                i + 1,
                inlineTupleFieldErr)
            if inlineTupleFieldErr != "":
                err = inlineTupleFieldErr
                return false
            continue
        if currentTypeName == "" || lineIndent <= currentTypeIndent:
            continue
        let fieldParse = TypedExprParseTypeFieldLineOwned(trimmed)
        if fieldParse.ok:
            if TypedExprTypeContainsSabiBoundary(fieldParse.fieldType):
                err = Fmt"ZRPC/SABI violation at {profile.sourcePath}:{i + 1}: SABI boundary type `{fieldParse.fieldType}` cannot be used as an object field"
                return false
            TypedExprAddTypeFieldDeclInPlace(ctx.typeFields,
                                             currentTypeName,
                                             fieldParse.fieldName,
                                             fieldParse.fieldType)
    for i in 0..<profile.importEdges.len:
        if !profile.importEdges[i].resolved:
            continue
        let qualifier = parser.ParserImportEdgeQualifier(profile.importEdges[i])
        if qualifier == "":
            continue
        var importedModule: TypedExprImportedModule
        importedModule.qualifier = qualifier
        importedModule.allowsUnqualifiedCall = profile.importEdges[i].allowsUnqualifiedCall
        let importedSourcePathNorm = parser.ParserNormalizePath(profile.importEdges[i].targetSourcePath)
        var importedOwnedPath = strings.stringsNewStringCopy(importedSourcePathNorm.data, importedSourcePathNorm.len)
        importedOwnedPath.flags = 0
        importedModule.targetSourcePath = importedOwnedPath
        add(ctx.importedModules, importedModule)
    # 元数据 context 的 lines 在 profile 构建后即释放(上面 ctx.lines=[]),
    # 模块 const 只能在 profile.lines 还活着时捕获 — 扫描进 context 本地
    # 表, 索引构建时从这里登记 (lines=0 的 context 无法重扫)。
    TypedExprModuleConstScanContext(ctx, profile.lines, ctx.sourcePath)
    if !typedExprBuildSealedGlobalBindings(profile, ctx, err):
        return false
    err = ""
    return true

fn TypedExprBuildSourceContext(source: TypedExprSourceText,
                                 ctx: var TypedExprSourceContext,
                                 err: var str): bool =
    var borrowedSource = source
    var builtContext: TypedExprSourceContext
    if orcd8TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SITE=build_src_fail")
    if !TypedExprBuildSourceContextBorrowed(borrowedSource,
                                            builtContext,
                                            true,
                                            true,
                                            true,
                                            TypedExprFunctionFilterIndex(),
                                            err):
        TypedExprClearSourceContextAllFields(ctx)
        return false
    var contexts: TypedExprSourceContext[]
    TypedExprSourceContextAppendMove(contexts, builtContext)
    let buildIndex = TypedExprBuildIndexForContexts(contexts, 64)
    TypedExprSourceContextSetOwnedBuildIndex(contexts[0], buildIndex)
    TypedExprSourceContextMoveInto(ctx, contexts[0])
    err = ""
    return true

@borrows
fn TypedExprLineIndentWidth(lineRaw: str): int32 =
    var width: int32
    for i in 0..<lineRaw.len:
        if lineRaw[i] == ' ':
            width = width + 1
        elif lineRaw[i] == '\t':
            width = width + 4
        else:
            return width
    return width

fn TypedExprIfConditionTextFromLine(lineRaw: str): str =
    let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(lineRaw))
    if !parser.ParserStartsWith(trimmed, "if "):
        return ""
    if trimmed.len <= 4:
        return ""
    if trimmed[trimmed.len - 1] != ':':
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(trimmed, 3, trimmed.len - 4))

@borrows
fn TypedExprIrConditionTextFromSurface(textRaw: str): str =
    var text = chengpath.PathTrim(share(textRaw))
    if parser.ParserStartsWith(text, "if "):
        text = chengpath.PathTrim(chengpath.TextSlice(text, 3, text.len - 3))
    elif parser.ParserStartsWith(text, "elif "):
        text = chengpath.PathTrim(chengpath.TextSlice(text, 5, text.len - 5))
    if text.len > 0 && text[text.len - 1] == ':':
        text = chengpath.PathTrim(chengpath.TextSlice(text, 0, text.len - 1))
    return text

# 批次6e：if/elif/while 语句条件节点化的统一取条件文本（前缀可缺省，
# 与后端 PrimaryBodyIrConditionText 同语义）。
@borrows
fn TypedExprIrStatementConditionNodeText(textRaw: str): str =
    var text = chengpath.PathTrim(share(textRaw))
    # 关键字判定必须用 Exact（保留尾随空格）：ParserStartsWith 会 PathTrim
    # 掉前缀的尾空格，使 "if " 误配 "ifPos..."、"while " 误配 "whileFoo"，
    # 把已被 parser 剥过关键字的 payload（如 "ifPos >= 0"）二次截断成
    # "Pos >= 0"，cmp 节点建不出 → if_cond no_node。Exact 仅在真有
    # "if "/"elif "/"while " 关键字（后跟空格）时才剥，标识符前缀不误伤。
    if parser.ParserStartsWithExact(text, "if "):
        text = chengpath.PathTrim(chengpath.TextSlice(text, 3, text.len - 3))
    elif parser.ParserStartsWithExact(text, "elif "):
        text = chengpath.PathTrim(chengpath.TextSlice(text, 5, text.len - 5))
    elif parser.ParserStartsWithExact(text, "while "):
        text = chengpath.PathTrim(chengpath.TextSlice(text, 6, text.len - 6))
    if text.len > 0 && text[text.len - 1] == ':':
        text = chengpath.PathTrim(chengpath.TextSlice(text, 0, text.len - 1))
    return text

@borrows
fn TypedExprIrSimpleBindingName(textRaw: str): str =
    let text = chengpath.PathTrim(textRaw)
    let name = parser.ParserIdentPrefix(text)
    if name == "" || name.len != text.len:
        return ""
    return name

@borrows
fn TypedExprIrShortStringLiteralPayload(textRaw: str,
                                         payload: var str): bool =
    payload = ""
    # Fmt 洞转义引号形 `\\"…\\"` 优先按外层转义语义解码 (lowering_plan
    # 行内 if 插值族; 精确形谓词在 parser 词法权威, 普通串首字符为引号
    # 永不误入本分支)。
    var escapedPayload = ""
    if parser.ParserValueExprFmtEscapedQuotedPayload(textRaw, escapedPayload):
        payload = escapedPayload
        return true
    let text = chengpath.PathTrim(textRaw)
    if text.len < 2 || text[0] != '"' || text[text.len - 1] != '"':
        return false
    # The outer quotes must be the *only* pair: reject a body that contains
    # another unescaped `"`. Without this, a multi-clause OR text like
    # `"err" || fieldName == "error"` (first/last char both happen to be
    # quotes) is misread as one 27-byte literal spanning both clauses,
    # turning the intended second comparison into permanently-false dead
    # code (T65-a-v3).
    for i in 1..<(text.len - 1):
        if text[i] == '\\' || text[i] == '"':
            return false
    payload = chengpath.TextSlice(text, 1, text.len - 2)
    return true

@borrows
fn TypedExprStatementFunctionIndexHash(functionName: str, bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(functionName):
        h = h * 31 + int32(functionName[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

@borrows
fn TypedExprStatementFnBindingIndexHash(functionName: str,
                                         bindingName: str,
                                         bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(functionName):
        h = h * 31 + int32(functionName[i])
    h = h * 31 + 10
    for i in 0..<len(bindingName):
        h = h * 31 + int32(bindingName[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

fn TypedExprStatementFnBindingIndexRegister(ir: var TypedExprIr,
                                             statementIndex: int32) =
    if statementIndex < 0 || statementIndex >= ir.statements2_statementIndexs.len:
        return
    if ir.statementFnBindingIndexBucketHeads.len <= 0:
        for bucketIndex in 0..<16384:
            add(ir.statementFnBindingIndexBucketHeads, -1)
    let sfbNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_functionNameIds[statementIndex])
    let functionName = if IsOk(sfbNameRes): Value(sfbNameRes) else: ""
    let sfbBindingRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_bindingNameIds[statementIndex])
    let bindingName = if IsOk(sfbBindingRes): Value(sfbBindingRes) else: ""
    let bucket = TypedExprStatementFnBindingIndexHash(functionName,
                                                      bindingName,
                                                      ir.statementFnBindingIndexBucketHeads.len)
    if bucket < 0:
        return
    let entryIndex = ir.statementFnBindingIndexEntryStatementIndexes.len
    add(ir.statementFnBindingIndexEntryStatementIndexes, statementIndex)
    add(ir.statementFnBindingIndexEntryFunctionNames, functionName)
    add(ir.statementFnBindingIndexEntryBindingNames, bindingName)
    add(ir.statementFnBindingIndexEntryNext, ir.statementFnBindingIndexBucketHeads[bucket])
    ir.statementFnBindingIndexBucketHeads[bucket] = entryIndex

fn TypedExprStatementFunctionIndexRegister(ir: var TypedExprIr,
                                            statementIndex: int32) =
    TypedExprStatementFnBindingIndexRegister(ir, statementIndex)
    if statementIndex < 0 || statementIndex >= ir.statements2_statementIndexs.len:
        return
    if ir.statementFunctionIndexBucketHeads.len <= 0:
        for bucketIndex in 0..<16384:
            add(ir.statementFunctionIndexBucketHeads, -1)
    let sfiNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.statements2_functionNameIds[statementIndex])
    let functionName = if IsOk(sfiNameRes): Value(sfiNameRes) else: ""
    let bucket = TypedExprStatementFunctionIndexHash(functionName,
                                                     ir.statementFunctionIndexBucketHeads.len)
    if bucket < 0:
        return
    let entryIndex = ir.statementFunctionIndexEntryStatementIndexes.len
    add(ir.statementFunctionIndexEntryStatementIndexes, statementIndex)
    add(ir.statementFunctionIndexEntryNames, functionName)
    add(ir.statementFunctionIndexEntryNext, ir.statementFunctionIndexBucketHeads[bucket])
    ir.statementFunctionIndexBucketHeads[bucket] = entryIndex

@borrows
fn TypedExprIrPriorBindingType(ir: TypedExprIr,
                                sourcePath: str,
                                functionName: str,
                                lineNumber: int32,
                                bindingName: str): str =
    # 按源行号取最近的前置声明(bestLine),不是按 statement 插入序取最后一个。
    # 跨 pass 插入序问题:for-loop 变量在控制 pass(晚)添加,statement index 比
    # local-decl pass(早)的同名 let 高;原"扫到的最后一个(最高 index)胜"会让
    # 远处 for-loop 变量(源行更前)错误盖过近处同名 let —— 如
    # PrimaryBodyIrPrepareA64LayoutMetricsInPlace:外层 `for termIndex`(range)
    # 盖过内层 `let termIndex = block.termIndex`(int32),致 `termIndex < 0` 比较
    # 操作数型 range≠int32 被拒 → if_cond no_node。最近前置声明(最大 line)才是
    # 当前作用域内的有效绑定。
    var foundType = ""
    var foundLine: int32 = -1
    var foundIsDecl = false
    if ir.statementFnBindingIndexBucketHeads.len <= 0:
        if ir.statements2_statementIndexs.len > 0:
            panic("typed expr: prior binding type requires statement fn/binding index")
        return ""
    # (fn,binding) 索引路径: 桶内收集该键全部 statementIndex, 升序排序后跑
    # 原选优逻辑。选优 tie-break 顺序敏感 (同行 last-wins + decl 优先),
    # 链是 LIFO 逆序, 必须排序复刻原升序数组位扫。候选逐条过全谓词复验
    # (界内 + fn/binding 等值), 跨可达轮 stale 条目 (compiler_csg 轮间清
    # statements2 不清 IR 索引列) 被谓词滤除或与新条目重复 (选优幂等)。
    let bucket = TypedExprStatementFnBindingIndexHash(functionName,
                                                      bindingName,
                                                      ir.statementFnBindingIndexBucketHeads.len)
    var candidateIndexes: int32[]
    var entryIndex = ir.statementFnBindingIndexBucketHeads[bucket]
    while entryIndex >= 0:
        if ir.statementFnBindingIndexEntryFunctionNames[entryIndex] == functionName &&
           ir.statementFnBindingIndexEntryBindingNames[entryIndex] == bindingName:
            add(candidateIndexes, ir.statementFnBindingIndexEntryStatementIndexes[entryIndex])
        entryIndex = ir.statementFnBindingIndexEntryNext[entryIndex]
    for sortPos in 1..<candidateIndexes.len:
        let sortKey = candidateIndexes[sortPos]
        var probePos = sortPos - 1
        while probePos >= 0 && candidateIndexes[probePos] > sortKey:
            candidateIndexes[probePos + 1] = candidateIndexes[probePos]
            probePos = probePos - 1
        candidateIndexes[probePos + 1] = sortKey
    for candidatePos in 0..<candidateIndexes.len:
        let i = candidateIndexes[candidatePos]
        if i >= 0 && i < ir.statements2_statementIndexs.len:
            TypedExprIrPriorBindingTypeConsider(ir,
                                                sourcePath,
                                                functionName,
                                                lineNumber,
                                                bindingName,
                                                i,
                                                foundLine,
                                                foundType,
                                                foundIsDecl)
    return foundType

@borrows
fn TypedExprIrPriorBindingTypeConsider(ir: TypedExprIr,
                                        sourcePath: str,
                                        functionName: str,
                                        lineNumber: int32,
                                        bindingName: str,
                                        i: int32,
                                        foundLine: var int32,
                                        foundType: var str,
                                        foundIsDecl: var bool) =
    # 谓词前置(纯重排): 4 个过滤字段直读 SoA + fail-fast, 全 45 字段结构体
    # 延到 4 谓词通过后再原样物化。省下被丢弃 stmt 的 ~42 字段 intern/arena。
    # sourcePath 与 functionName 组成复合键: 函数名跨源重名(如 backend2_lower*
    # 四文件同名 helper)时, 若只按 functionName+bindingName+lineNumber 过滤,
    # 候选桶按 (functionName,bindingName) 哈希收集, 会把另一源文件里同名同行
    # 的绑定记录当作候选纳入排序/选优, 回退查找因此可能跨源误配 prior binding
    # type (CommitB 前置定谳反例)。
    let prevSourcePath = Value(langintern.LookupIntern(ir.internPool, ir.statements2_sourcePathIds[i]))
    if prevSourcePath != sourcePath:
        return
    let prevFunctionName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_functionNameIds[i]))
    if prevFunctionName != functionName:
        return
    let prevLineNumber = arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, i)
    if prevLineNumber >= lineNumber:
        return
    let prevBindingName = Value(langintern.LookupIntern(ir.internPool, ir.statements2_bindingNameIds[i]))
    if prevBindingName != bindingName:
        return
    if prevLineNumber < foundLine:
        return
    let prev = TypedExprIrStatementAt(ir, i)
    var candidateType = ""
    if prev.resultType != "" && prev.resultType != "unknown" && prev.resultType != "call_expr":
        candidateType = prev.resultType
    if candidateType == "":
        let nodeInferredType = TypedExprIrDeclInferredResultType(ir, prev.rhsNodeIndex, "")
        if nodeInferredType != "":
            candidateType = nodeInferredType
    if candidateType == "":
        var sourcePath = prev.callTargetSourcePath
        if sourcePath == "":
            sourcePath = prev.sourcePath
        let importcReturnType = TypedExprIrLookupImportcReturnType(ir, sourcePath, prev.callTarget)
        if importcReturnType != "":
            candidateType = importcReturnType
    if candidateType != "":
        # bail=709 (R-H) 根因: `let prev = Ctor(f: call(...))` 的 ctor 实参
        # feeder 行 (kind=let_call, binding 同名 prev, resultType=被调返回型)
        # 与真 decl 行 (kind=local_decl, resultType=Ctor 类型) 同行同名;
        # feeder 行按 pass 序可晚于 decl 行入表, "扫到的最后一个胜" 让
        # feeder 的 int32/str 盖过真类型 → `x = prev.field` FieldGet 建节点
        # 失败 → rhsNodeIndex=-1 → 后端 709。同行多行时 local_decl 行优先,
        # 已采纳的 local_decl 型不被同行非 decl 行覆盖; 跨行仍是最近声明胜。
        let candidateIsDecl = prev.kind == TypedExprIrStmtLocalDecl
        if prev.lineNumber == foundLine && foundIsDecl && !candidateIsDecl:
            return
        foundLine = prev.lineNumber
        foundType = candidateType
        foundIsDecl = candidateIsDecl

@borrows
fn TypedExprIrPopulateConditionMeta(stmt: var TypedExprIrStatement,
                                     ir: var TypedExprIr,
                                     ctx: TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     lineNumber: int32) =
    stmt.conditionKind = TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    if stmt.kind != TypedExprIrStmtIf && stmt.kind != TypedExprIrStmtElif:
        return
    let conditionText = TypedExprIrConditionTextFromSurface(stmt.surfaceText)
    if conditionText == "":
        return
    var opPos = TypedExprFindTopLevelTextToken(conditionText, "==")
    var conditionKind = TypedExprIrCondStrEqLiteral
    if opPos < 0:
        opPos = TypedExprFindTopLevelTextToken(conditionText, "!=")
        conditionKind = TypedExprIrCondStrNeLiteral
    if opPos < 0:
        return
    # This fast path only models a single `value <op> literal` comparison.
    # A top-level `||`/`&&` means the condition is a compound boolean
    # expression (e.g. `fieldName == "err" || fieldName == "error"`); taking
    # everything after the first `==` as one literal candidate would let a
    # later clause's closing quote masquerade as this literal's own closing
    # quote. Bail to the general token-eval path instead (T65-a-v3). String-
    # aware search so `x == "a||b"` (literal content, not a real combinator)
    # is not mistaken for a compound condition.
    if TypedExprFindTopLevelTextTokenStringAware(conditionText, "||") >= 0 ||
       TypedExprFindTopLevelTextTokenStringAware(conditionText, "&&") >= 0:
        return
    let lhsText = chengpath.PathTrim(chengpath.TextSlice(conditionText, 0, opPos))
    let rhsText = chengpath.PathTrim(chengpath.TextSlice(conditionText,
                                                         opPos + 2,
                                                         conditionText.len - opPos - 2))
    var literalPayload = ""
    var valueName = TypedExprIrSimpleBindingName(lhsText)
    var literalSide = share(rhsText)
    if valueName == "" || !TypedExprIrShortStringLiteralPayload(literalSide, literalPayload):
        valueName = TypedExprIrSimpleBindingName(rhsText)
        literalSide = lhsText
        if valueName == "" || !TypedExprIrShortStringLiteralPayload(literalSide, literalPayload):
            return
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
    var valueType = TypedExprNormalizeTypeText(
        TypedExprLookupBindingTypeIndexed(ctx,
                                           scopeIndex,
                                           lineNumber,
                                           valueName))
    if valueType != "str":
        let priorType = TypedExprNormalizeTypeText(TypedExprIrPriorBindingType(ir,
                                                                               ctx.sourcePath,
                                                                               stmt.functionName,
                                                                               lineNumber,
                                                                               valueName))
        if priorType != "":
            valueType = priorType
    if valueType != "str":
        return
    stmt.conditionKind = conditionKind
    stmt.conditionLhsText = valueName
    stmt.conditionRhsText = literalSide
    stmt.conditionLiteralText = literalPayload

@borrows
fn TypedExprNearestEnclosingIf(ctx: TypedExprSourceContext,
                                scope: TypedExprFunctionScope,
                                lineNumber: int32,
                                lineIndent: int32,
                                outLineNumber: var int32,
                                outConditionText: var str) =
    outLineNumber = 0
    outConditionText = ""
    if lineNumber <= scope.startLine:
        return
    var bestIndent: int32 = -1
    for sourceLineNumber in scope.startLine..<lineNumber:
        if sourceLineNumber <= 0 ||
           sourceLineNumber > TypedExprSourceContextLineCount(ctx):
            continue
        let rawLine = TypedExprSourceContextLineText(ctx, sourceLineNumber)
        let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
        if trimmed == "":
            continue
        if !parser.ParserHasLeadingIndent(rawLine):
            continue
        let indent = TypedExprLineIndentWidth(rawLine)
        if indent >= lineIndent:
            continue
        let conditionText = TypedExprIfConditionTextFromLine(rawLine)
        if conditionText == "":
            continue
        if indent >= bestIndent:
            bestIndent = indent
            outLineNumber = sourceLineNumber
            outConditionText = conditionText

@borrows
fn TypedExprLineIsControlHeader(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "else" || text == "else:":
        return true
    var keywordLen: int32 = -1
    if parser.ParserStartsWith(text, "if "):
        keywordLen = 2
    elif parser.ParserStartsWith(text, "elif "):
        keywordLen = 4
    elif parser.ParserStartsWith(text, "while "):
        keywordLen = 5
    elif parser.ParserStartsWith(text, "for "):
        keywordLen = 3
    if keywordLen < 0:
        return false
    return parser.ParserFindTopLevelTokenRange(text, 0, text.len, ":") > keywordLen

@borrows
fn TypedExprStatementCallSurfaceKind(ctx: TypedExprSourceContext,
                                      scope: TypedExprFunctionScope,
                                      lineNumber: int32,
                                      callKind: TypedExprCallKind,
                                      parserSurfaceKind: TypedExprSurfaceCallKind,
                                      callCallee: str,
                                      callTarget: str,
                                      callTargetImportc: bool): CallSurfaceKind =
    if callKind == TypedExprCallBuiltin ||
       callKind == TypedExprCallResultIntrinsic ||
       callKind == TypedExprCallProjection:
        return CallSurfaceBuiltin
    if callTargetImportc:
        return CallSurfaceFfi
    if parserSurfaceKind == TypedExprSurfaceCallMember:
        return CallSurfaceFieldAccess
    if callTarget != "":
        return CallSurfaceWholeCall
    if callCallee != "" && callTarget == "":
        let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
        let bindingType = TypedExprLookupBindingTypeIndexed(
            ctx, scopeIndex, lineNumber, callCallee)
        if TypedExprTypeTextIsFnPtr(bindingType):
            return CallSurfaceFnPtr
        return CallSurfacePartialCall
    if parserSurfaceKind == TypedExprSurfaceCallLocal ||
       parserSurfaceKind == TypedExprSurfaceCallExternal ||
       parserSurfaceKind == TypedExprSurfaceCallImportc:
        return CallSurfaceWholeCall
    if callCallee != "":
        return CallSurfacePartialCall
    return CallSurfaceUnknown

@borrows
fn TypedExprNearestEnclosingControlLineNumber(ctx: TypedExprSourceContext,
                                               scope: TypedExprFunctionScope,
                                               lineNumber: int32,
                                               lineIndent: int32): int32 =
    if lineNumber <= scope.startLine:
        return 0
    var bestIndent: int32 = -1
    var bestLineNumber: int32
    for sourceLineNumber in scope.startLine..<lineNumber:
        if sourceLineNumber <= 0 ||
           sourceLineNumber > TypedExprSourceContextLineCount(ctx):
            continue
        let rawLine = TypedExprSourceContextLineText(ctx, sourceLineNumber)
        if !parser.ParserHasLeadingIndent(rawLine):
            continue
        let trimmed = chengpath.PathTrim(parser.ParserStripLineComment(share(rawLine)))
        if trimmed == "":
            continue
        let indent = TypedExprLineIndentWidth(rawLine)
        if indent >= lineIndent:
            continue
        if !TypedExprLineIsControlHeader(trimmed):
            continue
        if indent >= bestIndent:
            bestIndent = indent
            bestLineNumber = sourceLineNumber
    return bestLineNumber

@borrows
fn TypedExprIrSetStatementLocationFromExpr(stmt: var TypedExprIrStatement,
                                            expr: parser.NormalizedExpr) =
    stmt.lineNumber = expr.lineNumber
    stmt.columnNumber = expr.columnNumber
    stmt.endLineNumber = expr.endLineNumber
    stmt.endColumnNumber = expr.endColumnNumber
    stmt.lexicalScopeId = expr.lexicalScopeId
    stmt.suiteScopeId = expr.suiteScopeId
    stmt.statementOrdinal = expr.statementOrdinal
    stmt.lexicalOrdinal = expr.lexicalOrdinal
    stmt.deferOwnerStatementOrdinal = expr.deferOwnerStatementOrdinal
    stmt.valueExprCallNodeIndex = expr.valueExprCallNodeIndex
    stmt.originParserNodeId = expr.originParserNodeId
    stmt.valueExprArgRootStart = expr.callArgValueRootStart
    stmt.valueExprArgRootCount = expr.callArgValueRootCount
    stmt.valueExprRootNodeIndex = expr.valueExprRootNodeIndex
    stmt.valueExprSpanStart = expr.valueExprSpanStart
    stmt.valueExprSpanEnd = expr.valueExprSpanEnd
    stmt.valueExprStatementRole = expr.valueExprStatementRole

@borrows
fn TypedExprIrSetStatementLocationFromFact(stmt: var TypedExprIrStatement,
                                            fact: TypedExprFact) =
    var expr: parser.NormalizedExpr
    expr.lineNumber = fact.lineNumber
    expr.columnNumber = fact.columnNumber
    expr.endLineNumber = fact.endLineNumber
    expr.endColumnNumber = fact.endColumnNumber
    expr.lexicalScopeId = fact.lexicalScopeId
    expr.suiteScopeId = fact.suiteScopeId
    expr.statementOrdinal = fact.statementOrdinal
    expr.lexicalOrdinal = fact.lexicalOrdinal
    expr.deferOwnerStatementOrdinal = fact.deferOwnerStatementOrdinal
    expr.valueExprCallNodeIndex = fact.valueExprCallNodeIndex
    expr.originParserNodeId = fact.originParserNodeId
    expr.callArgValueRootStart = fact.valueExprArgRootStart
    expr.callArgValueRootCount = fact.valueExprArgRootCount
    expr.valueExprRootNodeIndex = fact.valueExprRootNodeIndex
    expr.valueExprSpanStart = fact.valueExprSpanStart
    expr.valueExprSpanEnd = fact.valueExprSpanEnd
    expr.valueExprStatementRole = fact.valueExprStatementRole
    TypedExprIrSetStatementLocationFromExpr(stmt, expr)

fn TypedExprIrSetStatementDefaultLocation(stmt: var TypedExprIrStatement,
                                           lineNumber: int32,
                                           columnNumber: int32,
                                           endLineNumber: int32,
                                           endColumnNumber: int32) =
    var expr: parser.NormalizedExpr
    expr.lineNumber = lineNumber
    expr.columnNumber = columnNumber
    expr.endLineNumber = endLineNumber
    expr.endColumnNumber = endColumnNumber
    expr.lexicalScopeId = -1
    expr.suiteScopeId = -1
    expr.statementOrdinal = -1
    expr.lexicalOrdinal = -1
    expr.deferOwnerStatementOrdinal = -1
    expr.valueExprCallNodeIndex = -1
    expr.originParserNodeId = -1
    expr.callArgValueRootStart = -1
    expr.callArgValueRootCount = 0
    expr.valueExprRootNodeIndex = -1
    expr.valueExprSpanStart = -1
    expr.valueExprSpanEnd = -1
    expr.valueExprStatementRole = parser.ParserValueExprStatementInvalid
    TypedExprIrSetStatementLocationFromExpr(stmt, expr)

@borrows
fn TypedExprIrAddCallStatement(ir: var TypedExprIr,
                                ctx: var TypedExprSourceContext,
                                sourceContexts: TypedExprSourceContext[],
                                scope: TypedExprFunctionScope,
                                fact: TypedExprFact,
                                kind: TypedExprIrStatementKind,
                                bindingName: str,
                                resultType: str,
                                lineIndent: int32,
                                enclosingIfLineNumber: int32,
                                enclosingIfConditionText: str): int32 =
    var stmt: TypedExprIrStatement
    stmt.rhsNodeIndex = -1
    stmt.rhsBailReason = RhsBailNone
    # P1 hint hygiene: 入 stmt 前清空 hint, 防止上一个 stmt 的 5680/16001
    # 失败信号污染当前 stmt 分类.  17946/21454 的 ConsumeHint 才反映本
    # stmt 周期内真新写入的信号.
    let _ = TypedExprIrConsumeRhsBailHint()
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.bindingTargetDefinitionRow = -1
    stmt.assignIndexNodeIndex = -1
    stmt.sourcePath = strings.CloneStr(fact.sourcePath)
    stmt.functionName = strings.CloneStr(scope.name)
    stmt.statementIndex = ir.statements2_statementIndexs.len
    TypedExprIrSetStatementLocationFromFact(stmt, fact)
    stmt.lineIndent = lineIndent
    stmt.enclosingIfLineNumber = enclosingIfLineNumber
    stmt.enclosingIfConditionText = strings.CloneStr(enclosingIfConditionText)
    stmt.exprId = fact.exprId
    stmt.kind = kind
    stmt.callKind = fact.callKind
    stmt.detailKind = parser.NormalizedExprDetailNone
    stmt.surfaceText = TypedExprQualifiedCallSurface(fact.callQualifier, fact.callCallee)
    if fact.callKind == TypedExprCallResultIntrinsic:
        stmt.detailKind = parser.ParserResultIntrinsicDetailKind(fact.callCallee)
    stmt.bindingName = strings.CloneStr(bindingName)
    stmt.resultType = strings.CloneStr(resultType)
    if stmt.resultType == "":
        stmt.resultType = "unknown"
    stmt.conditionKind = TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignFieldAlignBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueFieldAlignBytes = 0
    stmt.assignValueOpKind = TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.assignValueRhsConst = 0
    stmt.assignValueRhsHasConst = false
    stmt.callQualifier = strings.CloneStr(fact.callQualifier)
    stmt.callCallee = strings.CloneStr(fact.callCallee)
    # The statement's call identity starts from the fact's preresolved
    # authority (parser preresolution carries cross-module targets the
    # declaration index hides behind the export-visibility gate); the node
    # authority below may overwrite it only with an exact resolved row.
    stmt.callTarget = strings.CloneStr(fact.callTarget)
    stmt.callTargetSourcePath = strings.CloneStr(fact.callTargetSourcePath)
    stmt.callTargetSignatureLineNumber = fact.callTargetSignatureLineNumber
    stmt.callTargetImportc = fact.callTargetImportc
    if TypedExprFactIsBuiltinSeqAddCall(fact):
        stmt.callTarget = ""
        stmt.callTargetSourcePath = ""
        stmt.callTargetImportc = false
        stmt.resultType = "void"
    stmt.callArgCount = fact.callArgCount
    stmt.callArgsText = strings.CloneStr(fact.callArgsText)
    stmt.callArgTypesText = ""
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    TypedExprIrRegisterValueExprCallResultType(
        ir, stmt.valueExprCallNodeIndex, stmt.resultType)
    TypedExprIrPopulateCallArgNodeChain(ir,
                                        ctx,
                                        sourceContexts,
                                        scope,
                                        fact.lineNumber,
                                        stmt)
    if fact.kind == parser.NormalizedExprCall &&
       stmt.surfaceText != "":
        stmt.rhsNodeIndex = TypedExprIrBuildStatementCallRoot(
            ir, ctx, sourceContexts, scope, stmt)
    TypedExprIrBindDirectCallAuthorityFromRhsNode(ir, stmt)
    if fact.kind == parser.NormalizedExprCall &&
       (stmt.callTarget == "" ||
        stmt.callTargetSourcePath == "" ||
        (fact.callQualifier != "" &&
         fact.surfaceCallKind != TypedExprSurfaceCallMember &&
         !stmt.callTargetImportc)):
        var resolvedSourcePath = ""
        var resolvedTargetName = ""
        var resolvedSignatureLineNumber: int32
        var resolvedImportc = false
        let resolvedReturnType = TypedExprResolveCallTargetReturnType(ctx,
                                                                      sourceContexts,
                                                                      fact.callQualifier,
                                                                      fact.callCallee,
                                                                      stmt.callTarget,
                                                                      fact.callArgsText,
                                                                      fact.lineNumber,
                                                                      fact.surfaceCallKind,
                                                                      resolvedSourcePath,
                                                                      resolvedTargetName,
                                                                      resolvedSignatureLineNumber,
                                                                      resolvedImportc)
        if resolvedReturnType != "":
            stmt.callTarget = resolvedTargetName
            stmt.callTargetSourcePath = resolvedSourcePath
            stmt.callTargetSignatureLineNumber = resolvedSignatureLineNumber
            stmt.callTargetImportc = resolvedImportc
            if stmt.resultType == "" || stmt.resultType == "unknown" ||
               stmt.resultType == "call_expr":
                stmt.resultType = resolvedReturnType
    if TypedExprFactIsBuiltinSeqAddCall(fact):
        stmt.callSurfaceKind = CallSurfaceBuiltin
    else:
        stmt.callSurfaceKind = TypedExprStatementCallSurfaceKind(ctx,
                                                                 scope,
                                                                 fact.lineNumber,
                                                                 stmt.callKind,
                                                                 fact.surfaceCallKind,
                                                                 stmt.callCallee,
                                                                 stmt.callTarget,
                                                                 stmt.callTargetImportc)
    stmt.loweringMode = fact.loweringMode
    stmt.returnKind = fact.returnKind
    stmt.returnRoot = fact.returnRoot
    let statementIndex = stmt.statementIndex
    TypedExprIrAppendStatement(ir, stmt)
    TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
    return statementIndex

@borrows
fn TypedExprIrAddUnsupportedStatement(ir: var TypedExprIr,
                                       ctx: var TypedExprSourceContext,
                                       sourceContexts: TypedExprSourceContext[],
                                       scope: TypedExprFunctionScope,
                                       lineNumber: int32,
                                       lineIndent: int32,
                                       surfaceText: str): int32 =
    var stmt: TypedExprIrStatement
    stmt.rhsNodeIndex = -1
    stmt.rhsBailReason = RhsBailNone
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.bindingTargetDefinitionRow = -1
    stmt.assignIndexNodeIndex = -1
    stmt.sourcePath = share(ctx.sourcePath)
    stmt.functionName = share(scope.name)
    stmt.statementIndex = ir.statements2_statementIndexs.len
    var unsupportedEndColumn =
        TypedExprSourceContextLineText(ctx, lineNumber).len
    if unsupportedEndColumn <= lineIndent:
        unsupportedEndColumn = lineIndent + 1
    TypedExprIrSetStatementDefaultLocation(stmt,
                                           lineNumber,
                                           lineIndent + 1,
                                           lineNumber,
                                           unsupportedEndColumn)
    stmt.lineIndent = lineIndent
    stmt.enclosingIfLineNumber = -1
    stmt.enclosingIfConditionText = ""
    stmt.exprId = ""
    stmt.kind = TypedExprIrStmtUnsupported
    let trimmedSurface = chengpath.PathTrim(share(surfaceText))
    if parser.ParserStartsWith(trimmedSurface, "if "):
        stmt.kind = TypedExprIrStmtIf
    elif parser.ParserStartsWith(trimmedSurface, "elif "):
        stmt.kind = TypedExprIrStmtElif
    elif parser.ParserStartsWith(trimmedSurface, "else"):
        stmt.kind = TypedExprIrStmtElse
    elif parser.ParserStartsWith(trimmedSurface, "for "):
        stmt.kind = TypedExprIrStmtFor
    elif parser.ParserStartsWith(trimmedSurface, "while "):
        stmt.kind = TypedExprIrStmtWhile
    elif parser.ParserStartsWith(trimmedSurface, "match "):
        stmt.kind = TypedExprIrStmtMatch
    elif parser.ParserStartsWith(trimmedSurface, "case "):
        stmt.kind = TypedExprIrStmtCase
    elif trimmedSurface == "return":
        stmt.kind = TypedExprIrStmtReturn
    stmt.callKind = TypedExprCallNone
    stmt.detailKind = parser.NormalizedExprDetailNone
    stmt.surfaceText = share(surfaceText)
    stmt.bindingName = ""
    stmt.resultType = ""
    if stmt.kind == TypedExprIrStmtIf || stmt.kind == TypedExprIrStmtElif:
        stmt.resultType = "bool"
    elif stmt.kind == TypedExprIrStmtFor:
        stmt.bindingName = TypedExprForBindingNameFromHeader(trimmedSurface)
        stmt.resultType = "range"
    stmt.conditionKind = TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignFieldAlignBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueFieldAlignBytes = 0
    stmt.assignValueOpKind = TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.assignValueRhsConst = 0
    stmt.assignValueRhsHasConst = false
    stmt.callQualifier = ""
    stmt.callCallee = ""
    stmt.callTarget = ""
    stmt.callTargetSourcePath = ""
    stmt.callTargetImportc = false
    stmt.callArgCount = 0
    stmt.callArgsText = ""
    stmt.callArgTypesText = ""
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    stmt.loweringMode = TypedExprLowerDeferred
    stmt.returnKind = TypedExprReturnDeferred
    stmt.returnRoot = false
    let statementIndex = stmt.statementIndex
    TypedExprIrAppendStatement(ir, stmt)
    TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
    return statementIndex

fn TypedExprIrStatementLineExists(ir: var TypedExprIr,
                                   statementStart: int32,
                                   statementEndRaw: int32,
                                   lineNumber: int32): bool =
    var statementEnd = statementEndRaw
    if statementEnd > ir.statements2_statementIndexs.len:
        statementEnd = ir.statements2_statementIndexs.len
    if statementStart < 0 || statementStart >= statementEnd:
        return false
    for i in statementStart..<statementEnd:
        if arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, i) == lineNumber:
            return true
    return false

fn TypedExprIrUnsupportedStatementLineIndex(ir: var TypedExprIr,
                                             statementStart: int32,
                                             statementEndRaw: int32,
                                             lineNumber: int32): int32 =
    var statementEnd = statementEndRaw
    if statementEnd > ir.statements2_statementIndexs.len:
        statementEnd = ir.statements2_statementIndexs.len
    if statementStart < 0 || statementStart >= statementEnd:
        return -1
    for i in statementStart..<statementEnd:
        if arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, i) != lineNumber:
            continue
        if ir.statements2_kinds[i] == TypedExprIrStmtUnsupported:
            return i
    return -1

@borrows
fn TypedExprWholeCallTrimStart0(text: str): int32 =
    var start: int32
    while start < text.len:
        let ch = text[start]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        start = start + 1
    return start

# Exact single-line projection of ParserPrepareCodeLines followed by
# ParserJoinContinuationLines, bounded to the current function. Keeping this
# in the shared whole-call resolver prevents its two consumers from inventing
# different continuation semantics while avoiding an O(function-size) slice
# allocation for every call fact.
@borrows
fn TypedExprParserJoinedSourceLine(ctx: TypedExprSourceContext,
                                    startLine: int32,
                                    endLineLimit: int32): str =
    if startLine <= 0 ||
       startLine > TypedExprSourceContextLineCount(ctx):
        return ""
    var endLine = TypedExprSourceContextLineCount(ctx)
    if endLineLimit > 0 && endLineLimit < endLine:
        endLine = endLineLimit
    if startLine > endLine:
        return ""
    var line = parser.ParserOwnedText(parser.ParserStripLineCommentSlashAware(
        TypedExprSourceContextLineText(ctx, startLine)))
    if !parser.ParserHasNonTrimChar(line) ||
       !parser.ParserLineNeedsContinuation(
           parser.ParserStripLineCommentSlashAware(line)):
        return line
    var scanLine = startLine + 1
    while scanLine <= endLine &&
          parser.ParserLineNeedsContinuation(
              parser.ParserStripLineCommentSlashAware(line)):
        let rawNext = parser.ParserOwnedText(TypedExprSourceContextLineText(ctx, scanLine))
        # A physically blank line terminates the statement. A nonblank line
        # whose comment-stripped form is empty is only a comment and must be
        # skipped while continuation remains open.
        if !parser.ParserHasNonTrimChar(rawNext):
            break
        let strippedNext =
            parser.ParserStripLineCommentSlashAware(rawNext)
        if !parser.ParserHasNonTrimChar(strippedNext):
            scanLine = scanLine + 1
            continue
        let contTrim = parser.ParserOwnedText(
            parser.ParserTrimmedLineWithoutCommentQuoteAwareSlashAware(
                rawNext))
        line = parser.ParserConcat3(parser.ParserOwnedText(line), " ", contTrim)
        scanLine = scanLine + 1
    return line

fn TypedExprWholeCallStatementFromJoinedRaw(
        joinedRaw: str,
        startLine: int32): TypedExprWholeCallStatement =
    var out: TypedExprWholeCallStatement
    out.ok = false
    out.startLine = startLine
    out.endLine = startLine
    out.joinedRaw = share(joinedRaw)
    out.trimStart0 = TypedExprWholeCallTrimStart0(joinedRaw)
    out.openPos = -1
    out.closePos = -1
    let surfaceText = chengpath.PathTrim(joinedRaw)
    if surfaceText == "":
        return out
    let openPos = TypedExprFindWholeCallOpenParen(surfaceText)
    if openPos <= 0:
        return out
    let closePos = TypedExprFindMatchingParen(surfaceText, openPos)
    if closePos <= openPos || closePos + 1 != surfaceText.len:
        return out
    let callHead = chengpath.PathTrim(chengpath.TextSlice(surfaceText, 0, openPos))
    let argsText = chengpath.PathTrim(chengpath.TextSlice(surfaceText,
                                                          openPos + 1,
                                                          closePos - openPos - 1))
    out.ok = true
    out.text = surfaceText
    out.callHead = callHead
    out.argsText = argsText
    out.openPos = openPos
    out.closePos = closePos
    return out

# T79 shared source resolver. Parser joins continuation text onto the first
# physical line, so line/endLine remain that first line and columns address
# joinedRaw. endLine is deliberately not the last physical continuation line.
@borrows
fn TypedExprResolveWholeCallStatementAtLine(
        ctx: TypedExprSourceContext,
        startLine: int32,
        endLineLimit: int32): TypedExprWholeCallStatement =
    let joinedRaw = TypedExprParserJoinedSourceLine(ctx,
                                                     startLine,
                                                     endLineLimit)
    return TypedExprWholeCallStatementFromJoinedRaw(joinedRaw, startLine)

@borrows
fn TypedExprLineHasSimpleComparisonControl(lineRaw: str): bool =
    let line = chengpath.PathTrim(lineRaw)
    var isControl = false
    var prefixLen: int32
    if parser.ParserStartsWith(line, "if "):
        isControl = true
        prefixLen = 3
    elif parser.ParserStartsWith(line, "while "):
        isControl = true
        prefixLen = 6
    if !isControl:
        return false
    var stop = line.len
    if stop > 0 && line[stop - 1] == ':':
        stop = stop - 1
    if stop <= prefixLen:
        return false
    let condition = chengpath.PathTrim(chengpath.TextSlice(line, prefixLen, stop - prefixLen))
    if parser.ParserFindText(line, " <= ") >= 0:
        return true
    if parser.ParserFindText(line, " >= ") >= 0:
        return true
    if parser.ParserFindText(line, " < ") >= 0:
        return true
    if parser.ParserFindText(line, " > ") >= 0:
        return true
    if TypedExprConditionIsSimpleEquality(condition):
        return true
    if TypedExprConditionIsUInt8PtrZeroComparison(condition):
        return true
    return false

@borrows
fn TypedExprTextIsSimpleIdent(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return false
    return parser.ParserIdentPrefix(text) == text

@borrows
fn TypedExprTextIsSimpleEqualityOperand(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return false
    if text.len >= 2 && text[0] == '"' && text[text.len - 1] == '"':
        return true
    if text == "nil":
        return true
    if TypedExprTextIsSimpleIdent(text):
        return true
    if TypedExprTextIsSimpleFieldPath(text):
        return true
    return false

@borrows
fn TypedExprConditionIsSimpleEquality(conditionRaw: str): bool =
    let condition = chengpath.PathTrim(conditionRaw)
    var opPos = TypedExprFindTopLevelTextToken(condition, "==")
    if opPos < 0:
        opPos = TypedExprFindTopLevelTextToken(condition, "!=")
    if opPos < 0:
        return false
    let lhsText = chengpath.PathTrim(chengpath.TextSlice(condition, 0, opPos))
    let rhsText = chengpath.PathTrim(chengpath.TextSlice(condition,
                                                         opPos + 2,
                                                         condition.len - opPos - 2))
    if !TypedExprTextIsSimpleEqualityOperand(lhsText):
        return false
    if !TypedExprTextIsSimpleEqualityOperand(rhsText):
        return false
    return true

@borrows
fn TypedExprTextIsUInt8ZeroLiteral(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "uint8(0)":
        return true
    if text == "UInt8(0)":
        return true
    return false

@borrows
fn TypedExprTextIsUInt8PtrDeref(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text.len <= 4:
        return false
    if text[0] != '*':
        return false
    if text[1] != '(':
        return false
    if text[text.len - 1] != ')':
        return false
    let closePos = TypedExprFindMatchingParen(text, 1)
    if closePos != text.len - 1:
        return false
    let inner = chengpath.PathTrim(chengpath.TextSlice(text, 2, text.len - 3))
    let openPos = TypedExprFindWholeCallOpenParen(inner)
    if openPos <= 0:
        return false
    let head = chengpath.PathTrim(chengpath.TextSlice(inner, 0, openPos))
    if head != "UInt8Ptr":
        return false
    let innerClosePos = TypedExprFindMatchingParen(inner, openPos)
    return innerClosePos + 1 == inner.len

@borrows
fn TypedExprConditionIsUInt8PtrZeroComparison(conditionRaw: str): bool =
    let condition = chengpath.PathTrim(conditionRaw)
    var opPos = TypedExprFindTopLevelTextToken(condition, "!=")
    if opPos < 0:
        opPos = TypedExprFindTopLevelTextToken(condition, "==")
    if opPos < 0:
        return false
    let lhsText = chengpath.PathTrim(chengpath.TextSlice(condition, 0, opPos))
    let rhsText = chengpath.PathTrim(chengpath.TextSlice(condition,
                                                         opPos + 2,
                                                         condition.len - opPos - 2))
    if TypedExprTextIsUInt8PtrDeref(lhsText):
        return TypedExprTextIsUInt8ZeroLiteral(rhsText)
    if TypedExprTextIsUInt8PtrDeref(rhsText):
        return TypedExprTextIsUInt8ZeroLiteral(lhsText)
    return false

fn TypedExprAssignmentIsSelfDelta(lhsRaw: str,
                                  rhsRaw: str): bool =
    let lhsText = chengpath.PathTrim(lhsRaw)
    let rhsText = chengpath.PathTrim(rhsRaw)
    if !TypedExprTextIsSimpleIdent(lhsText):
        return false
    var opPos = TypedExprFindTopLevelTextToken(rhsText, "+")
    if opPos < 0:
        opPos = TypedExprFindTopLevelTextToken(rhsText, "-")
    if opPos < 0:
        return false
    let leftText = chengpath.PathTrim(chengpath.TextSlice(rhsText, 0, opPos))
    let rightText = chengpath.PathTrim(chengpath.TextSlice(rhsText,
                                                           opPos + 1,
                                                           rhsText.len - opPos - 1))
    if leftText != lhsText:
        return false
    if !TypedExprIrIsI32ConstLiteral(rightText):
        return false
    return true

@borrows
fn TypedExprLineNeedsContinuation(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return false
    var parenDepth = 0
    var inString = false
    var ci = 0
    while ci < len(text):
        let ch = text[ci]
        if inString:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '(' || ch == '[':
            parenDepth = parenDepth + 1
        elif ch == ')' || ch == ']':
            parenDepth = parenDepth - 1
        ci = ci + 1
    if inString:
        return false
    if parenDepth > 0:
        return true
    # a match-arm header `Label =>` legitimately ends in `>` (the arrow) and owns
    # an indented body suite below it — it is NOT a dangling binary operator that
    # needs the next line joined.
    if len(text) >= 2 && text[len(text) - 1] == '>' && text[len(text) - 2] == '=':
        return false
    let lastCh = text[len(text) - 1]
    if lastCh == '|' || lastCh == '&' || lastCh == '+' || lastCh == '*' ||
       lastCh == '/' || lastCh == ',' || lastCh == '<' || lastCh == '>':
        return true
    if lastCh == '=' && len(text) > 1 && text[len(text) - 2] != '=':
        return true
    # 行尾成员访问点(`root.`): 触发续行(WA1 U1 body-fold 形)。输入已由两个
    # 调用点 SlashAware 剥注释; 排除规则见 TypedExprRhsTextEndsWithMemberDot。
    if TypedExprRhsTextEndsWithMemberDot(text):
        return true
    return false

@borrows
fn TypedExprBodyExprIsImplicitReturn(text: str): bool =
    if text == "":
        return false
    if parser.ParserStartsWith(text, "return ") ||
       parser.ParserStartsWith(text, "let ") ||
       parser.ParserStartsWith(text, "var ") ||
       parser.ParserStartsWith(text, "const ") ||
       parser.ParserStartsWith(text, "if ") ||
       parser.ParserStartsWith(text, "elif ") ||
       parser.ParserStartsWith(text, "else") ||
       parser.ParserStartsWith(text, "for ") ||
       parser.ParserStartsWith(text, "while ") ||
       parser.ParserStartsWith(text, "case ") ||
       parser.ParserStartsWith(text, "match ") ||
       parser.ParserStartsWith(text, "yield ") ||
       parser.ParserStartsWith(text, "break") ||
       parser.ParserStartsWith(text, "continue"):
        return false
    # A top-level assignment `=` (not `==`/`!=`/`<=`/`>=`/`=>`) makes this a
    # store, not a returnable value.
    if parser.ParserFindTopLevelAssignmentEq(text) >= 0:
        return false
    return true

# Trailing bare-expression tail of a `fn f(...): T =` body with no `return`
# keyword (Cheng's trailing-expression-is-return rule): the indented-body walk
# classifies that bare value-expression as `Unsupported`, driving the function
# to cold. Fold the LAST top-level body line to a return here so it takes the
# robust statement_sequence return lowering, exactly as the inline `= <expr>`
# single-line form already does. Only fires for a non-void function. Returns
# true when it synthesized the return.
@borrows
fn TypedExprFoldSingleBodyExprReturn(ir: var TypedExprIr,
                                     ctx: var TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     scope: TypedExprFunctionScope,
                                     statementStart: int32): bool =
    if scope.returnType == "" || scope.returnType == "void":
        return false
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    let bodyStartIndex = TypedExprSourceContextLineIndex(ctx, bodyStartLine)
    let bodyEndIndex = TypedExprSourceContextLineIndex(ctx, scope.endLine)
    if bodyStartIndex < 0 || bodyEndIndex < bodyStartIndex:
        return false
    let lineEnd = bodyEndIndex + 1
    var bodyLineCount = 0
    var bodyLineNumber: int32 = -1
    var bodyLineText = ""
    var i = bodyStartIndex
    while i < lineEnd:
        if i < 0 || i >= ctx.lines.len:
            break
        let bodyRaw = parser.ParserOwnedText(ctx.lines[i])
        # `//`-aware 剥注释(见 ParserStripLineCommentSlashAware 定义处注释):
        # ParserStripLineComment 只认 '#', 纯 '//' 注释行剥不掉、原样当代码文本
        # 存活, 会被下面的续行深度扫描按其英文引号内的杂散 '('/'[' 误判成
        # "没写完", 把注释行之后整个函数体拼成一条巨型伪语句 (bail=801)。
        let bodyTrim = parser.ParserOwnedText(chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(bodyRaw)))
        let thisBodyLineNumber = TypedExprSourceContextStoredLineNumber(ctx, i)
        i = i + 1
        if bodyTrim == "" || bodyTrim == "{" || bodyTrim == "}":
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        # Join continuation lines (`d.ns /` newline `1000000`) into one expr.
        var joinedTrim = bodyTrim
        while i < lineEnd && TypedExprLineNeedsContinuation(joinedTrim):
            if i < 0 || i >= ctx.lines.len:
                break
            let contRaw = parser.ParserOwnedText(ctx.lines[i])
            let contTrim = parser.ParserOwnedText(chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(contRaw)))
            if contTrim == "":
                break
            # 点边界无空格粘合(同 ParserJoinContinuationLineAt): 括号臂/二元
            # 臂边界维持单空格, 既有文本逐字节不变。
            if TypedExprRhsTextEndsWithMemberDot(joinedTrim):
                joinedTrim = parser.ParserConcat2(parser.ParserOwnedText(joinedTrim), parser.ParserOwnedText(contTrim))
            else:
                joinedTrim = parser.ParserConcat3(parser.ParserOwnedText(joinedTrim), " ", contTrim)
            i = i + 1
        bodyLineCount = bodyLineCount + 1
        # Keep only the LAST top-level line; earlier ones (call statements,
        # control headers, nested-block bodies) are handled by their own
        # normal statement paths and are never referenced again once
        # overwritten here.
        bodyLineNumber = thisBodyLineNumber
        bodyLineText = joinedTrim
    if bodyLineCount <= 0 || bodyLineNumber <= 0:
        return false
    var foldBodyText = ""
    let ownedBodyLineText = parser.ParserOwnedText(bodyLineText)
    if parser.ParserStartsWith(ownedBodyLineText, "return "):
        foldBodyText = ownedBodyLineText
    else:
        # Bare trailing expression (implicit return) is the only other shape
        # this fold may claim; anything else belongs to a real statement.
        if !TypedExprBodyExprIsImplicitReturn(ownedBodyLineText):
            return false
        foldBodyText = parser.ParserConcat2("return ", ownedBodyLineText)
    if TypedExprIrStatementLineExists(ir, statementStart, ir.statements2_statementIndexs.len, bodyLineNumber):
        return false
    var foldReturnLayer: parser.NormalizedExprLayer
    parser.ParserAppendReturnStmtExprsLine(share(ctx.sourcePath),
                                           bodyLineNumber,
                                           foldBodyText,
                                           foldReturnLayer)
    for foldReturnIndex in 0..<foldReturnLayer.exprs.len:
        let foldReturnExpr = foldReturnLayer.exprs[foldReturnIndex]
        if foldReturnExpr.kind != parser.NormalizedExprReturn:
            continue
        let foldReturnStmtIndex = TypedExprIrAddCallStatementFromExpr(ir,
                                                                      ctx,
                                                                      sourceContexts,
                                                                      share(scope),
                                                                      share(foldReturnExpr),
                                                                      TypedExprIrStmtReturn,
                                                                      "",
                                                                      share(scope.returnType),
                                                                      0,
                                                                      -1,
                                                                      "",
                                                                      true)
        if foldReturnStmtIndex >= 0:
            return true
    return false

@borrows
fn TypedExprIrAppendRepairDeclStatement(ir: var TypedExprIr,
                                        ctx: var TypedExprSourceContext,
                                        sourceContexts: TypedExprSourceContext[],
                                        scope: TypedExprFunctionScope,
                                        lineNumber: int32,
                                        lineIndent: int32,
                                        enclosingIfLineNumber: int32,
                                        enclosingIfConditionText: str): bool =
    # 未被任何生产者覆盖的 let/var/const 声明行(非调用 RHS:字面量、内征转换
    # 等 — 无 call fact 且当前 value-expr 层无 assign 行):repair 扫描是最后
    # 一道,直接按 BindingInitializer 语义构建 LocalDecl,而非落 Unsupported。
    let lineRaw = TypedExprSourceContextLineText(ctx, lineNumber)
    let trimmed = chengpath.PathTrim(lineRaw)
    if !parser.ParserStartsWithExact(trimmed, "let ") &&
       !parser.ParserStartsWithExact(trimmed, "var ") &&
       !parser.ParserStartsWithExact(trimmed, "const "):
        return false
    var bindingName = ""
    var bindingType = ""
    var rhsStartColumn: int32 = -1
    if !TypedExprParseBindingLine(lineRaw, bindingName, bindingType, rhsStartColumn) ||
       rhsStartColumn < 0:
        return false
    let rhsSlice = chengpath.PathTrim(chengpath.TextSlice(lineRaw,
                                                          rhsStartColumn - 1,
                                                          lineRaw.len - rhsStartColumn + 1))
    let rhsText = TypedExprAssignRhsTextWithContinuation(ctx,
                                                         lineNumber,
                                                         rhsSlice)
    if rhsText == "":
        return false
    var stmt: TypedExprIrStatement
    stmt.rhsNodeIndex = -1
    stmt.rhsBailReason = RhsBailNone
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.bindingTargetDefinitionRow = -1
    stmt.assignIndexNodeIndex = -1
    stmt.sourcePath = share(ctx.sourcePath)
    stmt.functionName = share(scope.name)
    stmt.statementIndex = ir.statements2_statementIndexs.len
    var localEndColumn = lineRaw.len
    if localEndColumn <= lineIndent:
        localEndColumn = lineIndent + 1
    TypedExprIrSetStatementDefaultLocation(stmt,
                                           lineNumber,
                                           lineIndent + 1,
                                           lineNumber,
                                           localEndColumn)
    stmt.lineIndent = lineIndent
    stmt.enclosingIfLineNumber = enclosingIfLineNumber
    stmt.enclosingIfConditionText = share(enclosingIfConditionText)
    stmt.exprId = ""
    stmt.kind = TypedExprIrStmtLocalDecl
    stmt.callKind = TypedExprCallNone
    stmt.detailKind = parser.NormalizedExprDetailNone
    stmt.surfaceText = rhsText
    stmt.bindingName = bindingName
    stmt.resultType = bindingType
    stmt.conditionKind = TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignFieldAlignBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueFieldAlignBytes = 0
    stmt.assignValueOpKind = TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.assignValueRhsConst = 0
    stmt.assignValueRhsHasConst = false
    stmt.callQualifier = ""
    stmt.callCallee = ""
    stmt.callTarget = ""
    stmt.callTargetSourcePath = ""
    stmt.callTargetImportc = false
    stmt.callArgCount = 0
    stmt.callArgsText = ""
    stmt.callArgTypesText = ""
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    stmt.loweringMode = TypedExprLowerDeferred
    stmt.returnKind = TypedExprReturnDeferred
    stmt.returnRoot = false
    stmt.rhsNodeIndex = TypedExprIrBuildStatementValueRoot(
        ir, ctx, sourceContexts, share(scope), stmt, share(stmt.resultType))
    TypedExprIrPopulateAssignValueFieldMetaFromRhsNode(stmt, ir)
    TypedExprIrBindDirectCallAuthorityFromRhsNode(ir, stmt)
    if stmt.resultType == "" || stmt.resultType == "unknown":
        stmt.resultType = TypedExprIrDeclInferredResultType(
            ir, stmt.rhsNodeIndex, share(stmt.resultType))
        if stmt.resultType == "" || stmt.resultType == "unknown":
            panic(Fmt"typed expr: structural binding initializer type unavailable source={ctx.sourcePath} line={lineNumber}")
    TypedExprIrAppendStatement(ir, stmt)
    TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
    return true

@borrows
fn TypedExprIrAppendUnrepresentedTopLevelBodyStatements(ir: var TypedExprIr,
                                                         ctx: var TypedExprSourceContext,
                                                         sourceContexts: TypedExprSourceContext[],
                                                         scope: TypedExprFunctionScope,
                                                         statementStart: int32,
                                                         returnLineNumber: int32) =
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return
    var params: TypedExprParam[]
    TypedExprFunctionParamsInto(TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine), params)
    if TypedExprScopeHasDirectLeafControlBody(ctx, scope, params):
        return
    # Inline single-line body `fn f(...): T = <stmt>`: the statement lives on the
    # decl line, so the indented-body walk below (starting past the decl line)
    # never sees it. Collect it here as a return statement so the function takes
    # the robust statement_sequence lowering path instead of the fragile leaf
    # special-pattern matcher. Both `= return <expr>` and bare `= <expr>` (the
    # latter an implicit return for a non-void function) are folded to a return.
    let inlineBodyText = chengpath.PathTrim(TypedExprBodyTextAfterEquals(TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine)))
    var inlineReturnStmtText = ""
    if parser.ParserStartsWith(inlineBodyText, "return "):
        inlineReturnStmtText = inlineBodyText
    elif inlineBodyText != "" &&
         scope.returnType != "" &&
         scope.returnType != "void" &&
         !parser.ParserStartsWith(inlineBodyText, "let ") &&
         !parser.ParserStartsWith(inlineBodyText, "var ") &&
         !parser.ParserStartsWith(inlineBodyText, "const ") &&
         !parser.ParserStartsWith(inlineBodyText, "if ") &&
         !parser.ParserStartsWith(inlineBodyText, "elif ") &&
         !parser.ParserStartsWith(inlineBodyText, "else") &&
         !parser.ParserStartsWith(inlineBodyText, "for ") &&
         !parser.ParserStartsWith(inlineBodyText, "while ") &&
         !parser.ParserStartsWith(inlineBodyText, "case ") &&
         !parser.ParserStartsWith(inlineBodyText, "yield ") &&
         !parser.ParserStartsWith(inlineBodyText, "break") &&
         !parser.ParserStartsWith(inlineBodyText, "continue"):
        inlineReturnStmtText = parser.ParserConcat2("return ", parser.ParserOwnedText(inlineBodyText))
    if inlineReturnStmtText != "" &&
       !TypedExprIrStatementLineExists(ir, statementStart, ir.statements2_statementIndexs.len, scope.startLine):
        var inlineReturnLayer: parser.NormalizedExprLayer
        parser.ParserAppendReturnStmtExprsLine(share(ctx.sourcePath),
                                               scope.startLine,
                                               share(inlineReturnStmtText),
                                               inlineReturnLayer)
        for inlineReturnIndex in 0..<inlineReturnLayer.exprs.len:
            # Inline Form-B 单行体只存在于 parser token tree：normalized
            # layer 无其 return 行（AppendReturnStmtExprsLine 只认行首/
            # `:`/`;`/`=>` 前缀），此行是文本再扫描产物，root/role 为空。
            # value-expr tree 对该 return 持有精确 statement root event
            # （ProcessRoutineRange 经 ProcessSuiteRange 解析 `=` 后的单语
            # 句 suite），按 role+anchor line+节点文本唯一认领并绑定
            # root/spans/role（call 根再经 BindRootCallIdentity 贯穿 call
            # 身份），使本行与 layer 产 return 行满足同一 parser 身份契约
            # ——:58710 守卫与 BuildStatementValueRoot 的 tree-root 消费
            # 都以它为权威。零匹配或多匹配不绑，交给既有守卫 panic。
            var boundReturnExpr = inlineReturnLayer.exprs[inlineReturnIndex]
            if boundReturnExpr.kind != parser.NormalizedExprReturn:
                continue
            if ir.valueExprTree != nil && ir.valueExprTreeBorrowLease &&
               boundReturnExpr.valueExprRootNodeIndex < 0:
                let inlineTree = ir.valueExprTree
                var matchedRootNode = -1
                var matchedRootCount = 0
                for rootEventIndex in 0..<inlineTree.statementRootCount:
                    if parser.ParserValueExprStatementRootRoleAt(
                           inlineTree, rootEventIndex) !=
                           parser.ParserValueExprStatementReturnValue:
                        continue
                    if parser.ParserValueExprStatementRootAnchorLineAt(
                           inlineTree, rootEventIndex) !=
                           boundReturnExpr.lineNumber:
                        continue
                    let rootNodeIndex =
                        parser.ParserValueExprStatementRootNodeAt(
                            inlineTree, rootEventIndex)
                    if rootNodeIndex < 0 ||
                       parser.ParserValueExprNodeText(
                           inlineTree, rootNodeIndex) !=
                           boundReturnExpr.surfaceText:
                        continue
                    matchedRootCount = matchedRootCount + 1
                    matchedRootNode = rootNodeIndex
                if matchedRootCount == 1 && matchedRootNode >= 0:
                    boundReturnExpr.valueExprRootNodeIndex = matchedRootNode
                    boundReturnExpr.valueExprSpanStart =
                        parser.ParserValueExprNodeSpanStartAt(
                            inlineTree, matchedRootNode)
                    boundReturnExpr.valueExprSpanEnd =
                        parser.ParserValueExprNodeSpanEndAt(
                            inlineTree, matchedRootNode)
                    boundReturnExpr.valueExprStatementRole =
                        parser.ParserValueExprStatementReturnValue
                    parser.ParserValueExprBindRootCallIdentity(
                        inlineTree, matchedRootNode, boundReturnExpr)
            let inlineReturnStmtIndex = TypedExprIrAddCallStatementFromExpr(ir,
                                                                           ctx,
                                                                           sourceContexts,
                                                                           share(scope),
                                                                           share(boundReturnExpr),
                                                                           TypedExprIrStmtReturn,
                                                                           "",
                                                                           share(scope.returnType),
                                                                           0,
                                                                           -1,
                                                                           "",
                                                                           true)
            if inlineReturnStmtIndex >= 0:
                break
    # Multi-line single-expression body (`fn f(...): T =` with the lone body
    # expression on the next indented line): the inline `= <expr>` fold above
    # saw nothing after `=`, so fold the trailing body expression to a return
    # here, keeping the same statement_sequence return lowering.
    if inlineReturnStmtText == "":
        let _ = TypedExprFoldSingleBodyExprReturn(
            ir, ctx, sourceContexts, share(scope), statementStart)
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    let bodyStartIndex = TypedExprSourceContextLineIndex(ctx, bodyStartLine)
    let bodyEndIndex = TypedExprSourceContextLineIndex(ctx, scope.endLine)
    if bodyStartIndex < 0 || bodyEndIndex < bodyStartIndex:
        return
    let lineEnd = bodyEndIndex + 1
    var bodyIndent: int32 = -1
    var repairedControlLineNumbers: int32[]
    var controlJoinConsumedLineNumbers: int32[]
    let lineDebug = TypedExprScopeDebugEnvName() == scope.name
    var joinSkipUntil = -1
    for i in bodyStartIndex..<lineEnd:
        if i < joinSkipUntil:
            continue
        if i < 0 || i >= ctx.lines.len:
            break
        let lineNumber = TypedExprSourceContextStoredLineNumber(ctx, i)
        var bodyRaw = parser.ParserOwnedText(ctx.lines[i])
        # `//`-aware 剥注释(见 ParserStripLineCommentSlashAware 定义处注释):
        # ParserStripLineComment 只认 '#', 纯 '//' 注释行剥不掉、原样当代码文本
        # 存活, 会被下面的续行深度扫描按其英文引号内的杂散 '('/'[' 误判成
        # "没写完", 把注释行之后整个函数体拼成一条巨型伪语句, 命中拼接文本里
        # 某处真实的 return 关键字炸出畸形返回语句 (bail=801, jsonParseArray 一类)。
        var bodyTrim = parser.ParserOwnedText(chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(bodyRaw)))
        # Call-site gate: ungated, the Fmt arg plus the ProcessRssBytes call
        # ran for every body line even with the debug env unset.
        if lineDebug:
            TypedExprTraceStderrLine(true, Fmt"line_dbg:{lineNumber} rss={os.ProcessRssBytes()}")
        if bodyTrim == "":
            continue
        if bodyTrim == "{" || bodyTrim == "}":
            continue
        if !parser.ParserHasLeadingIndent(bodyRaw):
            break
        var joinScan = i + 1
        while joinScan < lineEnd && TypedExprLineNeedsContinuation(bodyTrim):
            if joinScan < 0 || joinScan >= ctx.lines.len:
                break
            let joinContRaw = parser.ParserOwnedText(ctx.lines[joinScan])
            let joinContTrim = parser.ParserOwnedText(chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(joinContRaw)))
            if joinContTrim == "":
                break
            # 点边界无空格粘合(同 ParserJoinContinuationLineAt): 括号臂/二元
            # 臂边界维持单空格, 既有文本逐字节不变。
            if TypedExprRhsTextEndsWithMemberDot(bodyTrim):
                bodyRaw = parser.ParserConcat2(parser.ParserOwnedText(bodyRaw), joinContTrim)
                bodyTrim = parser.ParserConcat2(parser.ParserOwnedText(bodyTrim), parser.ParserOwnedText(joinContTrim))
            else:
                bodyRaw = parser.ParserConcat3(parser.ParserOwnedText(bodyRaw), " ", joinContTrim)
                bodyTrim = parser.ParserConcat3(parser.ParserOwnedText(bodyTrim), " ", parser.ParserOwnedText(joinContTrim))
            joinScan = joinScan + 1
        if joinScan > i + 1:
            joinSkipUntil = joinScan
        let lineIndent = TypedExprLineIndentWidth(bodyRaw)
        if bodyIndent < 0:
            bodyIndent = lineIndent
        var lineConsumedByControlJoin = false
        for consumedIndex in 0..<controlJoinConsumedLineNumbers.len:
            if controlJoinConsumedLineNumbers[consumedIndex] == lineNumber:
                lineConsumedByControlJoin = true
                break
        if lineConsumedByControlJoin:
            continue
        # multiline control headers: the per-line parsers need the full
        # condition text up to the top-level colon, so join continuation
        # lines and skip them in later iterations
        var controlIsHeader = false
        if parser.ParserStartsWith(bodyTrim, "if ") ||
           parser.ParserStartsWith(bodyTrim, "elif ") ||
           parser.ParserStartsWith(bodyTrim, "while "):
            controlIsHeader = true
        if controlIsHeader &&
           parser.ParserFindTopLevelTokenRange(bodyTrim, 0, bodyTrim.len, ":") < 0:
            var controlJoinedText = share(bodyTrim)
            var controlJoinCandidates: int32[]
            var controlJoinScan = i
            var controlJoinFoundColon = false
            while controlJoinScan + 1 < lineEnd &&
                  controlJoinScan - i < 24:
                controlJoinScan = controlJoinScan + 1
                # `//`-aware 剥注释(见 ParserStripLineCommentSlashAware 定义处注释):
                # ParserStripLineComment 只认 '#', 纯 '//' 注释行剥不掉、原样当代码
                # 文本存活, 若注释文本里碰巧含冒号(如 `// note: ...`), 会被下面的
                # 顶层冒号扫描误判成"控制头条件已闭合", 提前截断多行 if/elif/while
                # 条件拼接, 真实续行(含真正的顶层冒号)反而落穿成独立畸形语句
                # (同 bail=801/jsonParseArray 一族, 控制头续行分支的第 5 处消费点)。
                let controlJoinNext = parser.ParserOwnedText(chengpath.PathTrim(parser.ParserStripLineCommentSlashAware(parser.ParserOwnedText(ctx.lines[controlJoinScan]))))
                if controlJoinNext == "":
                    break
                controlJoinedText = parser.ParserConcat3(parser.ParserOwnedText(controlJoinedText), " ", controlJoinNext)
                add(controlJoinCandidates,
                    TypedExprSourceContextStoredLineNumber(
                        ctx, controlJoinScan))
                if parser.ParserFindTopLevelTokenRange(controlJoinedText,
                                                       0,
                                                       controlJoinedText.len,
                                                       ":") >= 0:
                    controlJoinFoundColon = true
                    break
            if controlJoinFoundColon:
                bodyTrim = controlJoinedText
                for candidateIndex in 0..<controlJoinCandidates.len:
                    add(controlJoinConsumedLineNumbers, controlJoinCandidates[candidateIndex])
        let existingUnsupportedIndex = TypedExprIrUnsupportedStatementLineIndex(ir,
                                                                               statementStart,
                                                                               ir.statements2_statementIndexs.len,
                                                                               lineNumber)
        let existingLineHasStatement = TypedExprIrStatementLineExists(ir,
                                                                      statementStart,
                                                                      ir.statements2_statementIndexs.len,
                                                                      lineNumber)
        if existingLineHasStatement && existingUnsupportedIndex < 0:
            if TypedExprLineIsControlHeader(bodyTrim):
                add(repairedControlLineNumbers, lineNumber)
            continue
        var enclosingIfLineNumber: int32
        var enclosingIfConditionText = ""
        TypedExprNearestEnclosingIf(ctx,
                                    scope,
                                    lineNumber,
                                    lineIndent,
                                    enclosingIfLineNumber,
                                    enclosingIfConditionText)
        var lineUnderRepairedControl = false
        if lineIndent != bodyIndent:
            let enclosingControlLineNumber = TypedExprNearestEnclosingControlLineNumber(ctx,
                                                                                        scope,
                                                                                        lineNumber,
                                                                                        lineIndent)
            for repairIndex in 0..<repairedControlLineNumbers.len:
                if repairedControlLineNumbers[repairIndex] == enclosingControlLineNumber:
                    lineUnderRepairedControl = true
                    break
            if lineDebug:
                TypedExprTraceStderrLine(true,
                                         Fmt"repair_dbg line={lineNumber} indent={lineIndent} bodyIndent={bodyIndent} enclosing={enclosingControlLineNumber} under={lineUnderRepairedControl} exists={existingLineHasStatement} unsupported={existingUnsupportedIndex} text={bodyTrim}")
            if !lineUnderRepairedControl:
                continue
        var appendedControl = false
        var canRepairControl = lineUnderRepairedControl
        if lineIndent == bodyIndent:
            if parser.ParserFindText(bodyTrim, "||") >= 0 ||
               parser.ParserFindText(bodyTrim, "&&") >= 0:
                canRepairControl = true
            elif parser.ParserFindText(bodyTrim, " == nil") >= 0 ||
                 parser.ParserFindText(bodyTrim, " != nil") >= 0:
                canRepairControl = true
            elif bodyTrim == "else" ||
                 bodyTrim == "else:":
                canRepairControl = true
            elif TypedExprLineHasSimpleComparisonControl(bodyTrim):
                canRepairControl = true
            else:
                canRepairControl = false
        if canRepairControl:
            var controlLayer: parser.NormalizedExprLayer
            parser.ParserAppendControlStmtExprsLine(share(ctx.sourcePath),
                                                    lineNumber,
                                                    share(bodyTrim),
                                                    controlLayer)
            for controlIndex in 0..<controlLayer.exprs.len:
                let controlExpr = controlLayer.exprs[controlIndex]
                let controlStmtIndex = TypedExprIrAddControlStatementFromExpr(ir,
                                                                              ctx,
                                                                              sourceContexts,
                                                                              share(scope),
                                                                              share(controlExpr),
                                                                              lineIndent,
                                                                              enclosingIfLineNumber,
                                                                              share(enclosingIfConditionText))
                if controlStmtIndex >= 0:
                    appendedControl = true
                    break
            if appendedControl || TypedExprLineIsControlHeader(bodyTrim):
                add(repairedControlLineNumbers, lineNumber)
        if appendedControl:
            continue
        if lineIndent != bodyIndent:
            continue
        if !TypedExprIrAppendRepairDeclStatement(ir,
                                                 ctx,
                                                 sourceContexts,
                                                 share(scope),
                                                 lineNumber,
                                                 lineIndent,
                                                 enclosingIfLineNumber,
                                                 share(enclosingIfConditionText)):
            let _ = TypedExprIrAddUnsupportedStatement(ir,
                                                       ctx,
                                                       sourceContexts,
                                                       share(scope),
                                                       lineNumber,
                                                       lineIndent,
                                                       share(bodyTrim))

@borrows
fn TypedExprIrAppendControlTransferStatementsForScope(ir: var TypedExprIr,
                                                       ctx: var TypedExprSourceContext,
                                                       scope: TypedExprFunctionScope,
                                                       statementStart: int32) =
    if scope.startLine <= 0 || scope.endLine <= scope.startLine:
        return
    let bodyStartLine = TypedExprFunctionDeclBodyStartLineForContext(
        ctx, scope.startLine)
    let bodyStartIndex = TypedExprSourceContextLineIndex(ctx, bodyStartLine)
    let bodyEndIndex = TypedExprSourceContextLineIndex(ctx, scope.endLine)
    if bodyStartIndex < 0 || bodyEndIndex < bodyStartIndex:
        return
    for i in bodyStartIndex..bodyEndIndex:
        let lineRaw = ctx.lines[i]
        if !parser.ParserHasLeadingIndent(lineRaw):
            continue
        let bodyTrim = chengpath.PathTrim(parser.ParserStripLineComment(lineRaw))
        if bodyTrim != "break" && bodyTrim != "continue":
            continue
        let lineNumber = TypedExprSourceContextStoredLineNumber(ctx, i)
        if TypedExprIrStatementLineExists(ir, statementStart, ir.statements2_statementIndexs.len, lineNumber):
            continue
        var controlTransferSourceContexts: TypedExprSourceContext[]
        let _ = TypedExprIrAddUnsupportedStatement(ir,
                                                   ctx,
                                                   controlTransferSourceContexts,
                                                   share(scope),
                                                   lineNumber,
                                                   TypedExprLineIndentWidth(lineRaw),
                                                   bodyTrim)

# T38B: currentLineHasIf 只表示"这一行上出现过 if 关键字的 fact" (既可能是
# 语句级 if/elif/while 头部本身, 也可能是三元 if-表达式绑定行, 见
# ParserAppendSimpleSurfaceExprsLine 对 "if" identifier 的无差别扫描), 不
# 区分同行调用是落在头部条件里 (真正的条件内嵌调用 feeder, 该分类成
# TypedExprIrStmtIfCall) 还是落在单行控制头 suite 的内联语句体里 (如
# `if v > 3: Bump()` 的 `Bump()`, 该按普通语句处理——否则被当成"已被条件
# 求值消费的 feeder" 由 PrimaryBodyIrIfBodyEnd/PrimaryBodyIrConsumeHeaderConditionCallFeeders
# 排除出 then 体, 调用永远不执行, 静默丢副作用)。行首不是控制关键字时 (如
# 三元绑定行 `let x = if c: a else: b`) ParserControlHeaderInlineBodyColumn
# 返回 0, 本函数原样返回 false, 保留既有 IfCall 分类, 不改变已验证正确的
# 三元路径。
@borrows
fn TypedExprCallIsInlineSuiteBodyStatement(ctx: TypedExprSourceContext,
                                             lineNumber: int32,
                                             columnNumber: int32): bool =
    let bodyColumn = parser.ParserControlHeaderInlineBodyColumn(
        TypedExprSourceContextLineText(ctx, lineNumber))
    return bodyColumn > 0 && columnNumber >= bodyColumn

# `NormalizedExprIf` facts are appended by the parser for two distinct source
# shapes that share the same fact `kind` (see parser.cheng's
# NormalizedExprLayerAppend call sites for `?` vs the "if" identifier): a real
# if/elif/while statement keyword (detailKind=NormalizedExprDetailIfKeyword)
# and a ternary `cond ? a : b` operator's `?` mark
# (detailKind=NormalizedExprDetailIfTernary). `TypedExprFact` — the SoA-backed
# fact row consumed by the scan below — does not carry a detailKind column, so
# recover the same discriminator directly from the source byte at the fact's
# column (both append sites store columnNumber = charIndex + 1, i.e. pointing
# at the trigger character itself: '?' for the ternary, 'i' of "if" for the
# keyword). Without this, a bare trailing call statement whose only same-line
# "if"-shaped fact is a ternary nested inside one of its own call arguments
# (e.g. `f(g(x + (c ? 1 : 0)), y, z)`) gets misread as `currentLineHasIf=true`
# and misclassified as an orphaned TypedExprIrStmtIfCall condition-feeder
# further down — which is never independently emitted, silently dropping the
# whole statement from codegen.
@borrows
fn TypedExprLineHasIfKeywordFact(lineRaw: str, factColumnNumber: int32): bool =
    let col0 = factColumnNumber - 1
    if col0 < 0 || col0 >= lineRaw.len:
        return true
    return lineRaw[col0] != '?'

@borrows
fn TypedExprFactNeedsStructuredStatementConsumer(
        fact: TypedExprFact): bool =
    if fact.valueExprCallNodeIndex >= 0 &&
       fact.valueExprRootNodeIndex >= 0 &&
       fact.valueExprCallNodeIndex != fact.valueExprRootNodeIndex:
        return false
    return fact.valueExprStatementRole ==
               parser.ParserValueExprStatementBindingInitializer ||
           fact.valueExprStatementRole ==
               parser.ParserValueExprStatementAssignmentRhs ||
           fact.valueExprStatementRole ==
               parser.ParserValueExprStatementReturnValue ||
           fact.valueExprStatementRole ==
               parser.ParserValueExprStatementImplicitReturnValue

# [c3-loopsource] for 头 iterable 直根 call fact 守卫。parser 只在 for
# 语句解析位发 role=LoopSource 语句根事件 (ParserValueExprAppend
# StatementRoot 的 LoopSource 唯一产出点), iterable 自身是 call 时其
# 节点即该事件的根节点 (BindRootCallIdentity: callNode==rootNode),
# 语句根绑定把 role 写进 fact。该 call 的语义所有权人 = for 语句自己
# 的 TypedExprForHeaderRangeBounds 文本边界构建器 (ForStmt expr 行 →
# start/end 节点); 语句构建器若不认领此 role, range(...) 会被当孤儿
# 调用提升成独立 TypedExprIrStmtCall, typing 撞 'unresolved structural
# Call callee=range' (branchb c3 判词)。仅认直根形 (镜像
# TypedExprFactIsDirectStructuredCallRoot 结构): iterable 内嵌调用
# (callNode!=rootNode) 仍走既有 nested-under 消费路; 非 for 头事实
# 永不携带该 role → 守卫零增量。
@borrows
fn TypedExprFactIsLoopSourceIterableCall(fact: TypedExprFact): bool =
    return fact.kind == parser.NormalizedExprCall &&
           fact.valueExprCallNodeIndex >= 0 &&
           fact.valueExprCallNodeIndex == fact.valueExprRootNodeIndex &&
           fact.valueExprStatementRole ==
               parser.ParserValueExprStatementLoopSource

@borrows
fn TypedExprFactIsDirectStructuredCallRoot(
        fact: TypedExprFact): bool =
    return fact.valueExprStatementRole ==
               parser.ParserValueExprStatementExpression &&
           fact.valueExprCallNodeIndex >= 0 &&
           fact.valueExprCallNodeIndex == fact.valueExprRootNodeIndex

@borrows
fn TypedExprFactIsNestedUnderStructuredStatementRoot(
        ir: TypedExprIr,
        fact: TypedExprFact): bool =
    if fact.valueExprStatementRole ==
           parser.ParserValueExprStatementInvalid ||
       fact.valueExprCallNodeIndex < 0 ||
       fact.valueExprRootNodeIndex < 0 ||
       fact.valueExprCallNodeIndex == fact.valueExprRootNodeIndex:
        return false
    if ir.valueExprTree == nil || !ir.valueExprTreeBorrowLease:
        panic("typed expr: structured call ownership has no parser lease")
    if parser.ParserValueExprNodeEnclosingStatementRootNodeAt(
           ir.valueExprTree,
           fact.valueExprCallNodeIndex) != fact.valueExprRootNodeIndex ||
       parser.ParserValueExprNodeEnclosingStatementRoleAt(
           ir.valueExprTree,
           fact.valueExprCallNodeIndex) != fact.valueExprStatementRole:
        panic("typed expr: nested call statement authority drift")
    return true

@borrows
fn TypedExprIrAppendStatementsForScope(ir: var TypedExprIr,
                                        ctx: var TypedExprSourceContext,
                                        sourceContexts: TypedExprSourceContext[],
                                        scope: TypedExprFunctionScope,
                                        facts: var TypedExprFactTable,
                                        startIndex: int32,
                                        endIndexRaw: int32) =
    var cursor = startIndex
    if cursor < 0:
        cursor = 0
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > facts.count:
        endIndex = facts.count
    if cursor >= endIndex:
        return
    var currentLineNumber: int32 = -1
    var currentLineHasIf = false
    var currentLineBindingName = ""
    var currentLineBindingType = ""
    var currentLineBindingRootColumn: int32 = -1
    var currentLineBindingRhsStartColumn: int32 = -1
    var currentLineBindingIsTernary = false
    var currentLineBindingIsBinary = false
    var currentLineBindingIsSeqLiteral = false
    var currentLineBindingIsBoolExpr = false
    var currentLineBindingIsAggregateCtor = false
    var activeAggregateCtorEndLine: int32 = -1
    var currentLineIsBareAggregateCtorTail = false
    var currentLineIndent: int32
    var currentLineEnclosingIfLineNumber: int32
    var currentLineEnclosingIfConditionText = ""
    for i in cursor..<endIndex:
        let factRowI = TypedExprFactAt(facts, i)
        if (factRowI.lineNumber <= scope.startLine &&
            !TypedExprFactIsScopeStartReturn(factRowI, scope)) ||
           factRowI.lineNumber > scope.endLine:
            if factRowI.lineNumber > scope.endLine:
                break
            continue
        if factRowI.lineNumber != currentLineNumber:
            currentLineNumber = factRowI.lineNumber
            let lineContinuesAggregateCtor =
                currentLineNumber <= activeAggregateCtorEndLine
            if !lineContinuesAggregateCtor:
                activeAggregateCtorEndLine = -1
            currentLineHasIf = false
            currentLineBindingName = ""
            currentLineBindingType = ""
            currentLineBindingRootColumn = -1
            currentLineBindingRhsStartColumn = -1
            currentLineBindingIsTernary = false
            currentLineBindingIsBinary = false
            currentLineBindingIsSeqLiteral = false
            currentLineBindingIsBoolExpr = false
            currentLineBindingIsAggregateCtor = false
            if lineContinuesAggregateCtor:
                currentLineBindingRhsStartColumn = 1
                currentLineBindingIsAggregateCtor = true
            currentLineIsBareAggregateCtorTail = false
            let lineRaw = TypedExprSourceContextLineText(
                ctx, currentLineNumber)
            currentLineIndent = TypedExprLineIndentWidth(lineRaw)
            TypedExprNearestEnclosingIf(ctx,
                                        scope,
                                        currentLineNumber,
                                        currentLineIndent,
                                        currentLineEnclosingIfLineNumber,
                                        currentLineEnclosingIfConditionText)
            let trimmedLine = chengpath.PathTrim(lineRaw)
            var isBindingLine = false
            if parser.ParserStartsWith(trimmedLine, "let "):
                isBindingLine = true
            elif parser.ParserStartsWith(trimmedLine, "var "):
                isBindingLine = true
            elif parser.ParserStartsWith(trimmedLine, "const "):
                isBindingLine = true
            # Bare (non-binding) implicit-return tail expression whose whole
            # top-level shape is `TypeName( field: value, ... )` — an
            # aggregate constructor, not a plain function call. Every fact on
            # this line (e.g. a call nested in a field value like
            # `buffer: newBufferStream()`) is a piece of the constructor's
            # argument list, never the line's own top-level statement value.
            # Without this guard the nested call fact gets promoted below to
            # an independent `TypedExprIrStmtCall` statement that discards
            # the surrounding parser-owned implicit-return root entirely.
            # Only fires when the leading head is
            # a known aggregate type AND not a visible function (function
            # resolution takes precedence, mirroring
            # `PrimaryBodyIrAppendAggregateConstructorToSlot`'s own ctor-vs-
            # function gate) — any other shape (plain call, control header,
            # binding) is left completely untouched.
            var currentLineBareCtorHeadCandidate = ""
            if !isBindingLine:
                let bareCtorOpenPos = TypedExprFindWholeCallOpenParen(trimmedLine)
                if bareCtorOpenPos > 0:
                    currentLineBareCtorHeadCandidate = chengpath.PathTrim(chengpath.TextSlice(trimmedLine,
                                                                                               0,
                                                                                               bareCtorOpenPos))
            if currentLineBareCtorHeadCandidate != "" &&
               TypedExprCallHeadIsPlainQualifiedIdent(currentLineBareCtorHeadCandidate):
                var bareCtorSizeBytes: int32
                var bareCtorAlignBytes: int32
                var bareCtorFieldCount: int32
                if TypedExprIrLookupTypeLayout(ir,
                                               ctx.sourcePath,
                                               currentLineBareCtorHeadCandidate,
                                               bareCtorSizeBytes,
                                               bareCtorAlignBytes,
                                               bareCtorFieldCount) &&
                   bareCtorFieldCount > 0:
                    # Only a proven aggregate needs the same-name function
                    # precedence query. Statement heads such as `return (`
                    # are valid identifiers lexically but are not types and
                    # must never force a snapshot source-signature scan.
                    if TypedExprLocalFunctionNameState(
                            ctx, currentLineBareCtorHeadCandidate) ==
                       TypedExprBuildIndexMissing:
                        currentLineIsBareAggregateCtorTail = true
            if isBindingLine:
                currentLineBindingName = TypedExprLetCallBindingNameFromBody(share(trimmedLine))
                var bindingName = ""
                var bindingType = ""
                var bindingRhsColumn: int32 = -1
                if TypedExprParseBindingLine(lineRaw, bindingName, bindingType, bindingRhsColumn):
                    currentLineBindingName = bindingName
                    currentLineBindingType = bindingType
                let eqPos = TypedExprFindTopLevelTextToken(lineRaw, "=")
                if eqPos >= 0:
                    var rhsStartColumn = eqPos + 2
                    for column in rhsStartColumn..lineRaw.len:
                        if parser.ParserIsInlineSpace(lineRaw[column - 1]):
                            rhsStartColumn = column + 1
                        else:
                            rhsStartColumn = column
                            break
                    currentLineBindingRhsStartColumn = rhsStartColumn
                    var bindingRhsEndLine: int32
                    let bindingRhsText = TypedExprBindingRhsTextWithContinuationSpan(
                        ctx,
                        currentLineNumber - 1,
                        rhsStartColumn,
                        bindingRhsEndLine)
                    currentLineBindingIsTernary = TypedExprBindingRhsIsTopLevelTernary(bindingRhsText)
                    currentLineBindingIsBinary = TypedExprBindingRhsHasTopLevelBinaryOperator(bindingRhsText)
                    currentLineBindingIsSeqLiteral = TypedExprBindingRhsIsSeqLiteral(bindingRhsText)
                    currentLineBindingIsBoolExpr = TypedExprBindingRhsBoolExprType(bindingRhsText) != ""
                    currentLineBindingIsAggregateCtor =
                        TypedExprBindingRhsIsAggregateConstructor(ir,
                                                                  ctx,
                                                                  bindingRhsText)
                    if currentLineBindingIsAggregateCtor:
                        activeAggregateCtorEndLine = bindingRhsEndLine
            for j in i..<endIndex:
                let factRowJ = TypedExprFactAt(facts, j)
                if factRowJ.lineNumber != currentLineNumber:
                    if factRowJ.lineNumber > currentLineNumber:
                        break
                    continue
                if factRowJ.kind == parser.NormalizedExprIf:
                    if !TypedExprLineHasIfKeywordFact(lineRaw, factRowJ.columnNumber):
                        continue
                    currentLineHasIf = true
                    break
                if currentLineBindingRhsStartColumn > 0 &&
                   (factRowJ.kind == parser.NormalizedExprCall ||
                    factRowJ.kind == parser.NormalizedExprResultIntrinsic) &&
                   factRowJ.columnNumber >= currentLineBindingRhsStartColumn:
                    if currentLineBindingRootColumn < 0 ||
                       factRowJ.columnNumber < currentLineBindingRootColumn:
                        currentLineBindingRootColumn = factRowJ.columnNumber
        let isResultIntrinsic = factRowI.kind == parser.NormalizedExprResultIntrinsic
        let isNormalCall = factRowI.kind == parser.NormalizedExprCall
        if !isNormalCall && !isResultIntrinsic:
            continue
        if TypedExprFactNeedsStructuredStatementConsumer(factRowI):
            panic("typed expr: parser-owned value statement requires normalized expression consumer")
        if TypedExprFactIsNestedUnderStructuredStatementRoot(ir, factRowI):
            continue
        if currentLineIsBareAggregateCtorTail:
            continue
        if currentLineBindingIsAggregateCtor &&
           currentLineBindingRhsStartColumn > 0 &&
           factRowI.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        if isNormalCall &&
           factRowI.callKind == TypedExprCallBuiltin &&
           !TypedExprFactIsBuiltinSeqAddCall(factRowI) &&
           !TypedExprBuiltinCalleeIsSideEffectStatement(factRowI.callCallee):
            continue
        if isNormalCall && factRowI.callCallee == "" && factRowI.callTarget == "":
            continue
        # `let x = (<cond> ? <a> : <b>)` whose condition/arms contain calls: the
        # calls are sub-expressions of a top-level ternary, NOT the binding's
        # value. Promoting the first one to a let-call binds x to that call's
        # result and skips the conditional entirely. Leave the whole RHS to the
        # LocalDecl twin, which lowers it through the cbr ternary path (only the
        # selected arm's call runs, after the condition is evaluated).
        if isNormalCall &&
           currentLineBindingIsTernary &&
           currentLineBindingRhsStartColumn > 0 &&
           factRowI.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        # `let x = <call> <binop> <...>` — same shape as the ternary guard above:
        # the call is a sub-expression of a top-level binary, not the binding's
        # value. The LocalDecl twin's binary-with-call decomposer owns it.
        if isNormalCall &&
           currentLineBindingIsBinary &&
           currentLineBindingRhsStartColumn > 0 &&
           factRowI.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        # `let xs = [call(), ...]`: calls are element producers inside the seq
        # literal. The LocalDecl SeqLiteral node owns the full RHS and preserves
        # element order; promoting the first call would bind `xs` to one element.
        if isNormalCall &&
           currentLineBindingIsSeqLiteral &&
           currentLineBindingRhsStartColumn > 0 &&
           factRowI.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        # `let b = <call> <cmp> <...>` (e.g. `os.GetEnv("X") != ""`): the call is a
        # sub-expression feeding a top-level comparison, so the binding value is
        # bool, not the call's return type. Promoting the call to a let-call binds
        # `b` to the call result (str) and locks the IR binding store, so `if b:`
        # cannot resolve its condition node (cond_shape gap). Leave the line to the
        # LocalDecl twin, which carries the bool type inferred from the comparison.
        if isNormalCall &&
           currentLineBindingIsBoolExpr &&
           currentLineBindingRhsStartColumn > 0 &&
           factRowI.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        var statementKind = TypedExprIrStmtCall
        if isResultIntrinsic:
            statementKind = TypedExprIrStmtResultIntrinsic
        else:
            if factRowI.hasSink &&
               (factRowI.sinkPlaceKind == TypedExprPlaceLocal ||
                factRowI.sinkPlaceKind == TypedExprPlaceGlobal):
                statementKind = TypedExprIrStmtLetCall
            elif currentLineBindingRootColumn == factRowI.columnNumber:
                statementKind = TypedExprIrStmtLetCall
            elif currentLineHasIf &&
                 !TypedExprCallIsInlineSuiteBodyStatement(ctx, factRowI.lineNumber, factRowI.columnNumber):
                statementKind = TypedExprIrStmtIfCall
        var statementBindingName = ""
        if statementKind == TypedExprIrStmtLetCall ||
           (statementKind == TypedExprIrStmtResultIntrinsic &&
            (factRowI.hasSink || currentLineBindingRootColumn == factRowI.columnNumber)):
            statementBindingName = currentLineBindingName
        var statementFact = factRowI
        var statementLocalImportcReturnType = ""
        if statementFact.kind == parser.NormalizedExprCall:
            var importcSourcePath: str
            var importcTargetName: str
            var importcTargetSignatureLineNumber: int32
            var importcResolved: bool
            let exactReturnType = TypedExprResolveCallTargetReturnType(ctx,
                                                                       sourceContexts,
                                                                       statementFact.callQualifier,
                                                                       statementFact.callCallee,
                                                                       statementFact.callTarget,
                                                                       statementFact.callArgsText,
                                                                       statementFact.lineNumber,
                                                                       statementFact.surfaceCallKind,
                                                                       importcSourcePath,
                                                                       importcTargetName,
                                                                       importcTargetSignatureLineNumber,
                                                                       importcResolved)
            if exactReturnType != "":
                statementFact.callTarget = importcTargetName
                statementFact.callTargetSourcePath = importcSourcePath
                statementFact.callTargetSignatureLineNumber =
                    importcTargetSignatureLineNumber
                statementFact.callTargetImportc = importcResolved
                if importcResolved:
                    statementLocalImportcReturnType = exactReturnType
        if statementFact.kind == parser.NormalizedExprCall &&
           (statementFact.callTarget == "" || statementFact.callTargetSourcePath == ""):
            var resolvedSourcePath = ""
            var resolvedTargetName = ""
            var resolvedTargetSignatureLineNumber: int32
            var resolvedImportc = false
            let resolvedReturnType = TypedExprResolveCallTargetReturnType(ctx,
                                                                          sourceContexts,
                                                                          statementFact.callQualifier,
                                                                          statementFact.callCallee,
                                                                          statementFact.callTarget,
                                                                          statementFact.callArgsText,
                                                                          statementFact.lineNumber,
                                                                          statementFact.surfaceCallKind,
                                                                          resolvedSourcePath,
                                                                          resolvedTargetName,
                                                                          resolvedTargetSignatureLineNumber,
                                                                          resolvedImportc)
            if resolvedReturnType != "":
                statementFact.callTarget = resolvedTargetName
                statementFact.callTargetSourcePath = resolvedSourcePath
                statementFact.callTargetSignatureLineNumber =
                    resolvedTargetSignatureLineNumber
                statementFact.callTargetImportc = resolvedImportc
        var statementResultType = statementFact.typeText
        if statementLocalImportcReturnType != "":
            statementResultType = statementLocalImportcReturnType
        if (statementKind == TypedExprIrStmtLetCall ||
            statementKind == TypedExprIrStmtResultIntrinsic) &&
           Len(currentLineBindingType) > 0:
            statementResultType = currentLineBindingType
        let _ = TypedExprIrAddCallStatement(ir,
                                            ctx,
                                            sourceContexts,
                                            share(scope),
                                            statementFact,
                                            statementKind,
                                            statementBindingName,
                                            statementResultType,
                                            currentLineIndent,
                                            currentLineEnclosingIfLineNumber,
                                            currentLineEnclosingIfConditionText)

@borrows
fn TypedExprFactIsIrCallStatementCandidate(fact: TypedExprFact): bool =
    let isResultIntrinsic = fact.kind == parser.NormalizedExprResultIntrinsic
    let isNormalCall = fact.kind == parser.NormalizedExprCall
    if !isNormalCall && !isResultIntrinsic:
        return false
    if isNormalCall &&
       fact.callKind == TypedExprCallBuiltin &&
       !TypedExprFactIsBuiltinSeqAddCall(fact) &&
       !TypedExprBuiltinCalleeIsSideEffectStatement(fact.callCallee):
        return false
    if isNormalCall && fact.callCallee == "" && fact.callTarget == "":
        return false
    return true

@borrows
fn TypedExprProcessedFactContains(processedFactIndexes: int32[],
                                    factIndex: int32): bool =
    for i in 0..<processedFactIndexes.len:
        if processedFactIndexes[i] == factIndex:
            return true
    return false

@borrows
fn TypedExprTextRangeEquals(text: str,
                             start0: int32,
                             endExclusive: int32,
                             expected: str): bool =
    if start0 < 0 || endExclusive < start0 || endExclusive > text.len:
        return false
    if endExclusive - start0 != expected.len:
        return false
    for offset in 0..<expected.len:
        if text[start0 + offset] != expected[offset]:
            return false
    return true

@borrows
fn TypedExprTextRangeStartsAtCodeToken(text: str,
                                        start0: int32): bool =
    if start0 < 0 || start0 >= text.len:
        return false
    if start0 > 0:
        let previous = text[start0 - 1]
        if parser.ParserIsIdentChar(previous) || previous == '.':
            return false
    var inString = false
    var inChar = false
    var i: int32
    while i < start0:
        let ch = text[i]
        if !inChar && ch == '"' && !parser.ParserQuoteIsEscaped(text, i):
            inString = !inString
        elif !inString && ch == '\'' && !parser.ParserQuoteIsEscaped(text, i):
            inChar = !inChar
        elif !inString && !inChar && ch == '#':
            return false
        elif !inString && !inChar && ch == '/' &&
             i + 1 < text.len && text[i + 1] == '/':
            return false
        i = i + 1
    return !inString && !inChar

@borrows
fn TypedExprFactFullCallMatchesAt(fact: TypedExprFact,
                                   text: str,
                                   start0: int32,
                                   openPos0Out: var int32): bool =
    openPos0Out = -1
    let surface = TypedExprQualifiedCallSurface(fact.callQualifier,
                                                 fact.callCallee)
    if surface == "" || start0 < 0 || fact.endColumnNumber <= start0:
        return false
    if !TypedExprTextRangeStartsAtCodeToken(text, start0):
        return false
    let surfaceEnd0 = start0 + surface.len
    if !TypedExprTextRangeEquals(text, start0, surfaceEnd0, surface):
        return false
    var openPos0 = surfaceEnd0
    while openPos0 < fact.endColumnNumber &&
          parser.ParserIsInlineSpace(text[openPos0]):
        openPos0 = openPos0 + 1
    if openPos0 >= fact.endColumnNumber || text[openPos0] != '(':
        return false
    let closePos0 = TypedExprFindMatchingParen(text, openPos0)
    if closePos0 <= openPos0 || closePos0 + 1 != fact.endColumnNumber:
        return false
    if !TypedExprTextRangeEquals(text,
                                 openPos0 + 1,
                                 closePos0,
                                 fact.callArgsText):
        return false
    if parser.ParserCountTopLevelArgs(fact.callArgsText) != fact.callArgCount:
        return false
    openPos0Out = openPos0
    return true

# Parser call producers use one of two exact column contracts for a qualified
# call: the full surface start or the leaf-callee start. Normalize only those
# documented coordinates by exact source equality and the canonical end span.
@borrows
fn TypedExprFactFullCallRangeInText(fact: TypedExprFact,
                                     text: str,
                                     start0Out: var int32,
                                     openPos0Out: var int32): bool =
    start0Out = -1
    openPos0Out = -1
    let surface = TypedExprQualifiedCallSurface(fact.callQualifier,
                                                 fact.callCallee)
    let callee = chengpath.PathTrim(fact.callCallee)
    if surface == "" || callee == "" ||
       fact.columnNumber <= 0 || fact.endColumnNumber <= 0:
        return false
    let surfaceStart0 = fact.columnNumber - 1
    let qualifierWidth = surface.len - callee.len
    if qualifierWidth < 0:
        return false
    let leafAdjustedStart0 = surfaceStart0 - qualifierWidth
    var matchedStart0: int32 = -1
    var matchedOpenPos0: int32 = -1
    var candidateOpenPos0: int32
    if TypedExprFactFullCallMatchesAt(fact,
                                      text,
                                      leafAdjustedStart0,
                                      candidateOpenPos0):
        matchedStart0 = leafAdjustedStart0
        matchedOpenPos0 = candidateOpenPos0
    if surfaceStart0 != leafAdjustedStart0 &&
       TypedExprFactFullCallMatchesAt(fact,
                                      text,
                                      surfaceStart0,
                                      candidateOpenPos0):
        if matchedStart0 >= 0:
            return false
        matchedStart0 = surfaceStart0
        matchedOpenPos0 = candidateOpenPos0
    if matchedStart0 < 0:
        return false
    start0Out = matchedStart0
    openPos0Out = matchedOpenPos0
    return true

@borrows
fn TypedExprFactCallArgsContainFact(joinedRaw: str,
                                      rootFact: TypedExprFact,
                                      dependencyFact: TypedExprFact): bool =
    if rootFact.lineNumber != dependencyFact.lineNumber:
        return false
    if rootFact.endLineNumber != rootFact.lineNumber ||
       dependencyFact.endLineNumber != dependencyFact.lineNumber:
        return false
    var rootStart0: int32
    var rootOpenPos0: int32
    var dependencyStart0: int32
    var dependencyOpenPos0: int32
    if !TypedExprFactFullCallRangeInText(rootFact,
                                         joinedRaw,
                                         rootStart0,
                                         rootOpenPos0) ||
       !TypedExprFactFullCallRangeInText(dependencyFact,
                                         joinedRaw,
                                         dependencyStart0,
                                         dependencyOpenPos0):
        return false
    let rootEndExclusive = rootFact.endColumnNumber
    let dependencyEndExclusive = dependencyFact.endColumnNumber
    if rootStart0 < 0 || dependencyStart0 < 0 ||
       rootEndExclusive <= rootStart0 ||
       dependencyEndExclusive <= dependencyStart0:
        return false
    let argsStart0 = rootOpenPos0 + 1
    let argsEndExclusive = rootEndExclusive - 1
    if dependencyOpenPos0 <= dependencyStart0 ||
       argsStart0 > argsEndExclusive:
        return false
    if dependencyStart0 < argsStart0 ||
       dependencyEndExclusive > argsEndExclusive:
        return false
    return true

# `add(seq, helper(...))` / `setLen(seq, helper(...))` — the seq side-effect
# builtin head is NOT itself a fact (builtins yield no resolved-call fact), so
# the unrepresented-top-level-statement synthesis owns the whole line and
# lowers the inner call as the element feeder. But the inner `helper(...)` call
# DOES produce a resolved-call fact; if that fact is promoted to a standalone
# top-level statement it (a) occupies the line (TypedExprIrStatementLineExists
# becomes true) so the synthesis skips the `add`, dropping the grow+store, and
# (b) the line then lowers as a bare discard-call of the element. Detect this
# shape from the source line: a top-level whole-call statement whose head is a
# side-effect seq builtin and whose args contain this fact's call text. Such a
# fact is a sub-expression, not a statement, and must be suppressed here so the
# synthesis path owns the line.
@borrows
fn TypedExprFactIsSeqSideEffectBuiltinSubExpr(ctx: TypedExprSourceContext,
                                               scope: TypedExprFunctionScope,
                                               fact: TypedExprFact): bool =
    if fact.kind != parser.NormalizedExprCall:
        return false
    if fact.lineNumber <= 0:
        return false
    # Same parser-isomorphic join as unrepresented-call synthesis (T79).
    let wholeCall = TypedExprResolveWholeCallStatementAtLine(ctx,
                                                             fact.lineNumber,
                                                             scope.endLine)
    if !wholeCall.ok:
        return false
    let callHead = wholeCall.callHead
    if !TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return false
    if chengpath.PathTrim(TypedExprQualifiedCallQualifier(callHead)) != "":
        return false
    # Restrict to the seq grow/element builtins whose lowering materializes the
    # 2nd argument as the element value (so an inner call element is handled as a
    # feeder). Other side-effect builtins (assert / memRetain / Bytes*) keep
    # their existing standalone-arg-call statement handling.
    if callHead != "add" && callHead != "setLen" && callHead != "reserve":
        return false
    # the fact must not BE the builtin head call itself (different callee) and
    # must appear inside the builtin's argument list.
    if fact.callCallee == callHead:
        return false
    let argsText = wholeCall.argsText
    if argsText == "":
        return false
    if fact.lineNumber != wholeCall.startLine ||
       fact.endLineNumber != wholeCall.endLine:
        return false
    var factStart0: int32
    var factOpenPos0: int32
    if !TypedExprFactFullCallRangeInText(fact,
                                         wholeCall.joinedRaw,
                                         factStart0,
                                         factOpenPos0):
        return false
    let factEndExclusive = fact.endColumnNumber
    let argsStart0 = wholeCall.trimStart0 + wholeCall.openPos + 1
    let argsEndExclusive = wholeCall.trimStart0 + wholeCall.closePos
    if factOpenPos0 <= factStart0 ||
       factStart0 < argsStart0 || factEndExclusive > argsEndExclusive ||
       factEndExclusive <= factStart0:
        return false
    return true

@borrows
fn TypedExprIrAppendFactStatementForScope(ir: var TypedExprIr,
                                           ctx: var TypedExprSourceContext,
                                           sourceContexts: TypedExprSourceContext[],
                                           scope: TypedExprFunctionScope,
                                           fact: TypedExprFact,
                                           currentLineHasIf: bool,
                                           currentLineBindingName: str,
                                           currentLineBindingType: str,
                                           currentLineBindingRootColumn: int32,
                                           currentLineIndent: int32,
                                           currentLineEnclosingIfLineNumber: int32,
                                           currentLineEnclosingIfConditionText: str): int32 =
    var statementKind = TypedExprIrStmtCall
    if fact.kind == parser.NormalizedExprResultIntrinsic:
        statementKind = TypedExprIrStmtResultIntrinsic
    else:
        if fact.hasSink &&
           (fact.sinkPlaceKind == TypedExprPlaceLocal ||
            fact.sinkPlaceKind == TypedExprPlaceGlobal):
            statementKind = TypedExprIrStmtLetCall
        elif currentLineBindingRootColumn == fact.columnNumber:
            statementKind = TypedExprIrStmtLetCall
        elif currentLineHasIf &&
             !TypedExprCallIsInlineSuiteBodyStatement(ctx, fact.lineNumber, fact.columnNumber):
            statementKind = TypedExprIrStmtIfCall
    var statementBindingName = ""
    if statementKind == TypedExprIrStmtLetCall ||
       (statementKind == TypedExprIrStmtResultIntrinsic &&
        (fact.hasSink || currentLineBindingRootColumn == fact.columnNumber)):
        statementBindingName = currentLineBindingName
    var statementResultType = fact.typeText
    if (statementKind == TypedExprIrStmtLetCall ||
        statementKind == TypedExprIrStmtResultIntrinsic) &&
       Len(currentLineBindingType) > 0:
        statementResultType = currentLineBindingType
    return TypedExprIrAddCallStatement(ir,
                                       ctx,
                                       sourceContexts,
                                       scope,
                                       fact,
                                       statementKind,
                                       statementBindingName,
                                       statementResultType,
                                       currentLineIndent,
                                       currentLineEnclosingIfLineNumber,
                                       currentLineEnclosingIfConditionText)

@borrows
fn TypedExprIrAppendFactDependenciesForScope(ir: var TypedExprIr,
                                              ctx: var TypedExprSourceContext,
                                              sourceContexts: TypedExprSourceContext[],
                                              scope: TypedExprFunctionScope,
                                              facts: var TypedExprFactTable,
                                              rootFactIndex: int32,
                                              factStartIndex: int32,
                                              factEndIndex: int32,
                                              processedFactIndexes: var int32[],
                                              currentLineHasIf: bool,
                                              currentLineBindingName: str,
                                              currentLineBindingType: str,
                                              currentLineBindingRootColumn: int32,
                                              currentLineIndent: int32,
                                              currentLineEnclosingIfLineNumber: int32,
                                              currentLineEnclosingIfConditionText: str) =
    TypedExprTraceLine( "typed_ir_fact_deps:enter")
    if rootFactIndex < 0 || rootFactIndex >= facts.count:
        return
    TypedExprTraceLine( "typed_ir_fact_deps:after_guard")
    let rootFact = TypedExprFactAt(facts, rootFactIndex)
    if TypedExprFactIsDirectStructuredCallRoot(rootFact):
        return
    let joinedRaw = TypedExprParserJoinedSourceLine(ctx,
                                                     rootFact.lineNumber,
                                                     scope.endLine)
    if joinedRaw == "":
        return
    for depIndex in factStartIndex..<factEndIndex:
        let factRowDepIndex = TypedExprFactAt(facts, depIndex)
        TypedExprTraceLine( "typed_ir_fact_deps:loop_top")
        if depIndex == rootFactIndex:
            continue
        if TypedExprProcessedFactContains(processedFactIndexes, depIndex):
            continue
        TypedExprTraceLine( "typed_ir_fact_deps:before_line_compare")
        if factRowDepIndex.lineNumber < rootFact.lineNumber:
            continue
        if factRowDepIndex.lineNumber > rootFact.lineNumber:
            break
        TypedExprTraceLine( "typed_ir_fact_deps:before_candidate")
        if !TypedExprFactIsIrCallStatementCandidate(factRowDepIndex):
            continue
        if TypedExprFactNeedsStructuredStatementConsumer(factRowDepIndex) ||
           TypedExprFactIsNestedUnderStructuredStatementRoot(
               ir, factRowDepIndex):
            add(processedFactIndexes, depIndex)
            continue
        # [c3-loopsource] for 头 iterable call 是 for 语句的依赖位, 不是
        # 独立语句; 认领后不进下方依赖物化 (与上行守卫同判据族)。
        if TypedExprFactIsLoopSourceIterableCall(factRowDepIndex):
            add(processedFactIndexes, depIndex)
            continue
        TypedExprTraceLine( "typed_ir_fact_deps:before_contains")
        if !TypedExprFactCallArgsContainFact(joinedRaw,
                                              rootFact,
                                              factRowDepIndex):
            continue
        TypedExprTraceLine( "typed_ir_fact_deps:before_recurse")
        TypedExprIrAppendFactDependenciesForScope(ir,
                                                  ctx,
                                                  sourceContexts,
                                                  scope,
                                                  facts,
                                                  depIndex,
                                                  factStartIndex,
                                                  factEndIndex,
                                                  processedFactIndexes,
                                                  currentLineHasIf,
                                                  currentLineBindingName,
                                                  currentLineBindingType,
                                                  currentLineBindingRootColumn,
                                                  currentLineIndent,
                                                  currentLineEnclosingIfLineNumber,
                                                  currentLineEnclosingIfConditionText)
        TypedExprTraceLine( "typed_ir_fact_deps:after_recurse")
        TypedExprTraceLine( "typed_ir_fact_deps:before_append_stmt")
        let _ = TypedExprIrAppendFactStatementForScope(ir,
                                                       ctx,
                                                       sourceContexts,
                                                       share(scope),
                                                       share(factRowDepIndex),
                                                       currentLineHasIf,
                                                       share(currentLineBindingName),
                                                       share(currentLineBindingType),
                                                       currentLineBindingRootColumn,
                                                       currentLineIndent,
                                                       currentLineEnclosingIfLineNumber,
                                                       share(currentLineEnclosingIfConditionText))
        add(processedFactIndexes, depIndex)
        TypedExprTraceLine( "typed_ir_fact_deps:after_append_stmt")
    TypedExprTraceLine( "typed_ir_fact_deps:exit")

@borrows
fn TypedExprExprIsStructuredStatement(expr: parser.NormalizedExpr): bool =
    if expr.kind == parser.NormalizedExprReturn:
        return true
    if expr.kind == parser.NormalizedExprAssign:
        return true
    if expr.kind == parser.NormalizedExprIfStmt ||
       expr.kind == parser.NormalizedExprElifStmt ||
       expr.kind == parser.NormalizedExprElseStmt ||
       expr.kind == parser.NormalizedExprForStmt ||
       expr.kind == parser.NormalizedExprMatchStmt ||
       expr.kind == parser.NormalizedExprCaseStmt ||
       expr.kind == parser.NormalizedExprWhileStmt ||
       expr.kind == parser.NormalizedExprDeferStmt ||
       expr.kind == parser.NormalizedExprBreakStmt ||
       expr.kind == parser.NormalizedExprContinueStmt:
        return true
    return false

@borrows
fn TypedExprExprIsScopeStartReturn(expr: parser.NormalizedExpr,
                                    scope: TypedExprFunctionScope): bool =
    if expr.lineNumber != scope.startLine ||
       expr.kind != parser.NormalizedExprReturn:
        return false
    return expr.valueExprStatementRole ==
               parser.ParserValueExprStatementReturnValue ||
           expr.valueExprStatementRole ==
               parser.ParserValueExprStatementImplicitReturnValue

@borrows
fn TypedExprFactIsScopeStartReturn(fact: TypedExprFact,
                                    scope: TypedExprFunctionScope): bool =
    if fact.lineNumber != scope.startLine ||
       fact.kind != parser.NormalizedExprReturn:
        return false
    return fact.valueExprStatementRole ==
               parser.ParserValueExprStatementReturnValue ||
           fact.valueExprStatementRole ==
               parser.ParserValueExprStatementImplicitReturnValue

fn TypedExprNormalizedScopeIndexBuild(layer: var parser.NormalizedExprLayer): TypedExprNormalizedScopeIndex =
    var index: TypedExprNormalizedScopeIndex
    index.lookup = parser.ParserSourcePathIndexLookupInit(32)
    var currentSource = ""
    var currentSourceIndex: int32 = -1
    var childCounts: int32[]
    setLen(childCounts, layer.scopes.len)
    for scopeIndex in 0..<layer.scopes.len:
        let scope = layer.scopes[scopeIndex]
        if scope.sourcePath == "":
            panic("typed expr: normalized scope source is empty")
        if !TypedExprNormalizedSpanValid(scope.startLineNumber,
                                         scope.startColumnNumber,
                                         scope.endLineNumber,
                                         scope.endColumnNumber):
            panic("typed expr: normalized scope span is invalid")
        if scope.sourcePath != currentSource:
            if scope.scopeId != 0:
                panic("typed expr: normalized scope source does not start at scope zero")
            if parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.lookup,
                                                                            scope.sourcePath) >= 0:
                panic("typed expr: normalized scope source is not contiguous")
            currentSource = strings.CloneStr(scope.sourcePath)
            currentSourceIndex = index.sourcePaths.len
            add(index.sourcePaths, strings.CloneStr(scope.sourcePath))
            add(index.starts, scopeIndex)
            add(index.counts, 0)
            parser.ParserSourcePathIndexLookupInsertExact(index.lookup,
                                                          strings.CloneStr(scope.sourcePath),
                                                          currentSourceIndex)
        if currentSourceIndex < 0 || scope.scopeId != index.counts[currentSourceIndex]:
            panic("typed expr: normalized scope ids are not contiguous")
        if scope.scopeId == 0:
            if scope.parentScopeId != -1 ||
               scope.kind != parser.NormalizedScopeRoot ||
               scope.lexicalOrdinal != 0:
                panic("typed expr: normalized root scope contract is invalid")
        else:
            if scope.parentScopeId < 0 || scope.parentScopeId >= scope.scopeId ||
               scope.lexicalOrdinal < 0:
                panic("typed expr: normalized child scope contract is invalid")
            let parentGlobalIndex = index.starts[currentSourceIndex] + scope.parentScopeId
            if parentGlobalIndex < 0 || parentGlobalIndex >= scopeIndex:
                panic("typed expr: normalized child scope parent is missing")
            if scope.lexicalOrdinal != childCounts[parentGlobalIndex]:
                panic("typed expr: normalized child scope lexical ordinal is not dense")
            childCounts[parentGlobalIndex] = childCounts[parentGlobalIndex] + 1
            let parentScope = layer.scopes[parentGlobalIndex]
            if !TypedExprPositionAtOrBefore(parentScope.startLineNumber,
                                             parentScope.startColumnNumber,
                                             scope.startLineNumber,
                                             scope.startColumnNumber) ||
               !TypedExprPositionAtOrBefore(scope.endLineNumber,
                                             scope.endColumnNumber,
                                             parentScope.endLineNumber,
                                             parentScope.endColumnNumber):
                panic("typed expr: normalized child scope escapes parent span")
        index.counts[currentSourceIndex] = index.counts[currentSourceIndex] + 1
    return index

@borrows
fn TypedExprNormalizedScopeSourceIndex(index: var TypedExprNormalizedScopeIndex,
                                        sourcePath: str): int32 =
    # Bounded function projection owns exactly one source and therefore needs
    # no hash lookup allocation. Ordinary multi-source indexes still use the
    # canonical lookup below.
    if index.sourcePaths.len == 1 && index.sourcePaths[0] == sourcePath:
        return 0
    return parser.ParserProfileIndexLookupForNormalizedSourcePathExact(index.lookup,
                                                                        sourcePath)

fn TypedExprNormalizedScopeGlobalIndex(layer: var parser.NormalizedExprLayer,
                                        index: var TypedExprNormalizedScopeIndex,
                                        sourceIndex: int32,
                                        scopeId: int32): int32 =
    if sourceIndex < 0 || sourceIndex >= index.sourcePaths.len:
        panic("typed expr: normalized scope source index out of range")
    if scopeId < 0 || scopeId >= index.counts[sourceIndex]:
        panic("typed expr: normalized scope id out of range")
    let globalIndex = index.starts[sourceIndex] + scopeId
    if globalIndex < 0 || globalIndex >= layer.scopes.len:
        panic("typed expr: normalized scope global index out of range")
    let scope = layer.scopes[globalIndex]
    if scope.sourcePath != index.sourcePaths[sourceIndex] || scope.scopeId != scopeId:
        panic("typed expr: normalized scope index identity mismatch")
    return globalIndex

fn TypedExprPositionAtOrBefore(lhsLine: int32,
                                lhsColumn: int32,
                                rhsLine: int32,
                                rhsColumn: int32): bool =
    if lhsLine < rhsLine:
        return true
    if lhsLine > rhsLine:
        return false
    return lhsColumn <= rhsColumn

fn TypedExprNormalizedSpanValid(lineNumber: int32,
                                 columnNumber: int32,
                                 endLineNumber: int32,
                                 endColumnNumber: int32): bool =
    if lineNumber <= 0 || columnNumber <= 0 ||
       endLineNumber <= 0 || endColumnNumber <= 0:
        return false
    return TypedExprPositionAtOrBefore(lineNumber,
                                       columnNumber,
                                       endLineNumber,
                                       endColumnNumber)

@borrows
fn TypedExprScopeContainsNormalizedExpr(scope: parser.NormalizedScopeFact,
                                         expr: parser.NormalizedExpr): bool =
    return TypedExprPositionAtOrBefore(scope.startLineNumber,
                                       scope.startColumnNumber,
                                       expr.lineNumber,
                                       expr.columnNumber) &&
           TypedExprPositionAtOrBefore(expr.endLineNumber,
                                       expr.endColumnNumber,
                                       scope.endLineNumber,
                                       scope.endColumnNumber)

fn TypedExprNormalizedOwningDeferSuiteGlobalIndex(
        layer: var parser.NormalizedExprLayer,
        index: var TypedExprNormalizedScopeIndex,
        sourceIndex: int32,
        lexicalScopeId: int32): int32 =
    var scopeId = lexicalScopeId
    while scopeId >= 0:
        let globalIndex = TypedExprNormalizedScopeGlobalIndex(layer,
                                                               index,
                                                               sourceIndex,
                                                               scopeId)
        let scope = layer.scopes[globalIndex]
        if scope.kind == parser.NormalizedScopeDeferSuite:
            return globalIndex
        scopeId = scope.parentScopeId
    return -1

fn TypedExprDensePairIndexInit(groupCounts: var int32[]): TypedExprDensePairIndex =
    var out: TypedExprDensePairIndex
    setLen(out.groupStarts, groupCounts.len + 1)
    var totalCount: int32
    for groupIndex in 0..<groupCounts.len:
        let groupCount = groupCounts[groupIndex]
        if groupCount < 0 || groupCount > 2147483647 - totalCount:
            panic("typed expr: dense pair index size is invalid")
        out.groupStarts[groupIndex] = totalCount
        totalCount = totalCount + groupCount
    out.groupStarts[groupCounts.len] = totalCount
    setLen(out.seen, totalCount)
    return out

fn TypedExprDensePairIndexInsert(index: var TypedExprDensePairIndex,
                                  firstKey: int32,
                                  secondKey: int32): bool =
    if firstKey < 0 || index.groupStarts.len <= 0 ||
       firstKey >= index.groupStarts.len - 1 || secondKey < 0:
        panic("typed expr: invalid pair index key")
    let groupStart = index.groupStarts[firstKey]
    let groupEnd = index.groupStarts[firstKey + 1]
    if secondKey >= groupEnd - groupStart:
        panic("typed expr: pair index ordinal is outside dense group")
    index.visitCount = index.visitCount + 1
    let slotIndex = groupStart + secondKey
    if index.seen[slotIndex]:
        return false
    index.seen[slotIndex] = true
    index.count = index.count + 1
    return true

fn TypedExprValidateNormalizedDeferFacts(layer: var parser.NormalizedExprLayer) =
    var hasRelevantFact = false
    var relevantFactCount: int32
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.kind == parser.NormalizedExprIfStmt ||
           expr.kind == parser.NormalizedExprElifStmt ||
           expr.kind == parser.NormalizedExprElseStmt ||
           expr.kind == parser.NormalizedExprForStmt ||
           expr.kind == parser.NormalizedExprMatchStmt ||
           expr.kind == parser.NormalizedExprCaseStmt ||
           expr.kind == parser.NormalizedExprWhileStmt ||
           expr.kind == parser.NormalizedExprDeferStmt ||
           expr.kind == parser.NormalizedExprBreakStmt ||
           expr.kind == parser.NormalizedExprContinueStmt ||
           expr.deferOwnerStatementOrdinal >= 0:
            hasRelevantFact = true
            relevantFactCount = relevantFactCount + 1
    if !hasRelevantFact:
        return
    if layer.scopes.len <= 0:
        panic("typed expr: structured facts have no normalized scope table")
    var scopeIndex = TypedExprNormalizedScopeIndexBuild(layer)
    var seenOwnedSuiteScopes: bool[]
    setLen(seenOwnedSuiteScopes, layer.scopes.len)
    var seenDeferSuiteScopes: bool[]
    setLen(seenDeferSuiteScopes, layer.scopes.len)
    var statementCounts: int32[]
    setLen(statementCounts, scopeIndex.sourcePaths.len)
    var lexicalCounts: int32[]
    setLen(lexicalCounts, layer.scopes.len)
    var structuredOrdinalCount: int32
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        let ownsStructuredOrdinal =
            expr.kind == parser.NormalizedExprIfStmt ||
            expr.kind == parser.NormalizedExprElifStmt ||
            expr.kind == parser.NormalizedExprElseStmt ||
            expr.kind == parser.NormalizedExprForStmt ||
            expr.kind == parser.NormalizedExprMatchStmt ||
            expr.kind == parser.NormalizedExprCaseStmt ||
            expr.kind == parser.NormalizedExprWhileStmt ||
            expr.kind == parser.NormalizedExprDeferStmt ||
            expr.kind == parser.NormalizedExprBreakStmt ||
            expr.kind == parser.NormalizedExprContinueStmt
        if !ownsStructuredOrdinal:
            continue
        let sourceIndex = TypedExprNormalizedScopeSourceIndex(scopeIndex,
                                                               expr.sourcePath)
        if sourceIndex < 0:
            panic("typed expr: normalized structured statement source has no scope table")
        if expr.statementOrdinal < 0 || expr.lexicalOrdinal < 0:
            panic("typed expr: malformed structured statement ordinal")
        let lexicalGlobalIndex = TypedExprNormalizedScopeGlobalIndex(layer,
                                                                      scopeIndex,
                                                                      sourceIndex,
                                                                      expr.lexicalScopeId)
        statementCounts[sourceIndex] = statementCounts[sourceIndex] + 1
        lexicalCounts[lexicalGlobalIndex] = lexicalCounts[lexicalGlobalIndex] + 1
        structuredOrdinalCount = structuredOrdinalCount + 1
    if structuredOrdinalCount <= 0 || structuredOrdinalCount > relevantFactCount:
        panic("typed expr: structured statement count is invalid")
    var statementSeen = TypedExprDensePairIndexInit(statementCounts)
    var lexicalSeen = TypedExprDensePairIndexInit(lexicalCounts)
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        let ownsOrdinarySuite =
            expr.kind == parser.NormalizedExprIfStmt ||
            expr.kind == parser.NormalizedExprElifStmt ||
            expr.kind == parser.NormalizedExprElseStmt ||
            expr.kind == parser.NormalizedExprForStmt ||
            expr.kind == parser.NormalizedExprMatchStmt ||
            expr.kind == parser.NormalizedExprCaseStmt ||
            expr.kind == parser.NormalizedExprWhileStmt
        let ownsStructuredOrdinal = ownsOrdinarySuite ||
            expr.kind == parser.NormalizedExprDeferStmt ||
            expr.kind == parser.NormalizedExprBreakStmt ||
            expr.kind == parser.NormalizedExprContinueStmt
        if !ownsStructuredOrdinal:
            continue
        let sourceIndex = TypedExprNormalizedScopeSourceIndex(scopeIndex,
                                                               expr.sourcePath)
        if sourceIndex < 0:
            panic("typed expr: normalized structured statement source has no scope table")
        if !TypedExprNormalizedSpanValid(expr.lineNumber,
                                         expr.columnNumber,
                                         expr.endLineNumber,
                                         expr.endColumnNumber):
            panic("typed expr: malformed structured statement span")
        if expr.statementOrdinal < 0 || expr.lexicalOrdinal < 0:
            panic("typed expr: malformed structured statement ordinal")
        let lexicalGlobalIndex = TypedExprNormalizedScopeGlobalIndex(layer,
                                                                      scopeIndex,
                                                                      sourceIndex,
                                                                      expr.lexicalScopeId)
        let lexicalScope = layer.scopes[lexicalGlobalIndex]
        if !TypedExprScopeContainsNormalizedExpr(lexicalScope, expr):
            panic("typed expr: structured statement escapes lexical scope")
        if expr.statementOrdinal >= statementCounts[sourceIndex]:
            panic("typed expr: structured statement ordinals are not dense")
        if !TypedExprDensePairIndexInsert(statementSeen,
                                          sourceIndex,
                                          expr.statementOrdinal):
            panic("typed expr: duplicate structured statement ordinal")
        if expr.lexicalOrdinal >= lexicalCounts[lexicalGlobalIndex]:
            panic("typed expr: structured lexical ordinals are not dense")
        if !TypedExprDensePairIndexInsert(lexicalSeen,
                                          lexicalGlobalIndex,
                                          expr.lexicalOrdinal):
            panic("typed expr: duplicate structured lexical ordinal")
        if ownsOrdinarySuite && expr.suiteScopeId < 0:
            panic("typed expr: ordinary control suite fact is missing")
        if expr.suiteScopeId >= 0:
            let suiteGlobalIndex = TypedExprNormalizedScopeGlobalIndex(layer,
                                                                        scopeIndex,
                                                                        sourceIndex,
                                                                        expr.suiteScopeId)
            let suiteScope = layer.scopes[suiteGlobalIndex]
            if suiteScope.kind == parser.NormalizedScopeRoot ||
               suiteScope.parentScopeId != expr.lexicalScopeId ||
               suiteScope.ownerStatementOrdinal != expr.statementOrdinal:
                panic("typed expr: structured suite owner fact is mismatched")
            if seenOwnedSuiteScopes[suiteGlobalIndex]:
                panic("typed expr: duplicate structured suite owner")
            seenOwnedSuiteScopes[suiteGlobalIndex] = true
        if expr.kind != parser.NormalizedExprDeferStmt:
            continue
        if expr.deferOwnerStatementOrdinal != -1 ||
           TypedExprNormalizedOwningDeferSuiteGlobalIndex(layer,
                                                           scopeIndex,
                                                           sourceIndex,
                                                           expr.lexicalScopeId) >= 0:
            panic("typed expr: nested defer fact is invalid")
        let suiteGlobalIndex = TypedExprNormalizedScopeGlobalIndex(layer,
                                                                    scopeIndex,
                                                                    sourceIndex,
                                                                    expr.suiteScopeId)
        let suiteScope = layer.scopes[suiteGlobalIndex]
        if suiteScope.kind != parser.NormalizedScopeDeferSuite ||
           suiteScope.parentScopeId != expr.lexicalScopeId ||
           suiteScope.ownerStatementOrdinal != expr.statementOrdinal ||
           suiteScope.endLineNumber != expr.endLineNumber ||
           suiteScope.endColumnNumber != expr.endColumnNumber:
            panic("typed expr: malformed defer suite scope")
        if seenDeferSuiteScopes[suiteGlobalIndex] ||
           !seenOwnedSuiteScopes[suiteGlobalIndex]:
            panic("typed expr: duplicate defer suite owner")
        seenDeferSuiteScopes[suiteGlobalIndex] = true

    if statementSeen.count != structuredOrdinalCount ||
       lexicalSeen.count != structuredOrdinalCount ||
       statementSeen.visitCount != structuredOrdinalCount ||
       lexicalSeen.visitCount != structuredOrdinalCount ||
       statementSeen.seen.len != structuredOrdinalCount ||
       lexicalSeen.seen.len != structuredOrdinalCount:
        panic("typed expr: structured ordinal validation visit bound violated")

    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        let isTransfer = expr.kind == parser.NormalizedExprBreakStmt ||
                         expr.kind == parser.NormalizedExprContinueStmt
        let isDeferredBody = expr.deferOwnerStatementOrdinal >= 0
        if !isTransfer && !isDeferredBody &&
           expr.kind != parser.NormalizedExprDeferStmt:
            continue
        if !TypedExprNormalizedSpanValid(expr.lineNumber,
                                         expr.columnNumber,
                                         expr.endLineNumber,
                                         expr.endColumnNumber):
            panic("typed expr: malformed structured statement span")
        let sourceIndex = TypedExprNormalizedScopeSourceIndex(scopeIndex,
                                                               expr.sourcePath)
        if sourceIndex < 0:
            panic("typed expr: normalized expression source has no scope table")
        let lexicalGlobalIndex = TypedExprNormalizedScopeGlobalIndex(layer,
                                                                      scopeIndex,
                                                                      sourceIndex,
                                                                      expr.lexicalScopeId)
        let lexicalScope = layer.scopes[lexicalGlobalIndex]
        let owningDeferSuiteGlobalIndex =
            TypedExprNormalizedOwningDeferSuiteGlobalIndex(layer,
                                                           scopeIndex,
                                                           sourceIndex,
                                                           expr.lexicalScopeId)
        if isTransfer:
            if expr.statementOrdinal < 0 || expr.lexicalOrdinal < 0 ||
               expr.suiteScopeId != -1 || expr.deferOwnerStatementOrdinal != -1 ||
               owningDeferSuiteGlobalIndex >= 0 ||
               !TypedExprScopeContainsNormalizedExpr(lexicalScope, expr):
                panic("typed expr: malformed break or continue fact")
        elif isDeferredBody:
            if owningDeferSuiteGlobalIndex < 0 ||
               layer.scopes[owningDeferSuiteGlobalIndex].ownerStatementOrdinal !=
                   expr.deferOwnerStatementOrdinal ||
               !seenDeferSuiteScopes[owningDeferSuiteGlobalIndex] ||
               !TypedExprScopeContainsNormalizedExpr(lexicalScope, expr) ||
               !TypedExprScopeContainsNormalizedExpr(
                    layer.scopes[owningDeferSuiteGlobalIndex], expr):
                panic("typed expr: malformed defer body owner")

@borrows
fn TypedExprScopeHasDirectLeafControlBody(ctx: TypedExprSourceContext,
                                           scope: TypedExprFunctionScope,
                                           params: TypedExprParam[]): bool =
    var bodyLineNumber: int32
    var thenConst = ""
    var elseConst = ""
    if TypedExprFunctionBodyIsI32IfArg0LeZeroConstElseConst(ctx,
                                                            scope,
                                                            params,
                                                            bodyLineNumber,
                                                            thenConst,
                                                            elseConst):
        return true
    if TypedExprFunctionBodyMatchesF64MulCheckExit(ctx, scope):
        return true
    if TypedExprFunctionBodyMatchesStrLenFast(ctx, scope, params):
        return true
    return false

@borrows
fn TypedExprTextIsI32Zero(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "0":
        return true
    if text == "int32(0)":
        return true
    return false

@borrows
fn TypedExprScopeNeedsStructuredStatements(ctx: TypedExprSourceContext,
                                            scope: TypedExprFunctionScope,
                                            params: TypedExprParam[],
                                            returnExpr: str,
                                            facts: var TypedExprFactTable,
                                            factStartIndex: int32,
                                            factEndIndexRaw: int32,
                                            exprLayer: var parser.NormalizedExprLayer,
                                            exprStartIndex: int32,
                                            exprEndIndexRaw: int32): bool =
    var exprEndIndex = exprEndIndexRaw
    if exprEndIndex < 0 || exprEndIndex > exprLayer.exprs.len:
        exprEndIndex = exprLayer.exprs.len
    var hasControlStatement = false
    var hasAssignStatement = false
    var hasForStatement = false
    var hasReturnStatement = false
    for i in exprStartIndex..<exprEndIndex:
        let expr = exprLayer.exprs[i]
        if (expr.lineNumber <= scope.startLine &&
            !TypedExprExprIsScopeStartReturn(expr, scope)) ||
           expr.lineNumber > scope.endLine:
            if expr.lineNumber > scope.endLine:
                break
            continue
        if expr.kind == parser.NormalizedExprAssign:
            hasAssignStatement = true
        elif expr.kind == parser.NormalizedExprReturn:
            hasReturnStatement = true
        elif expr.kind == parser.NormalizedExprForStmt:
            hasForStatement = true
            hasControlStatement = true
        elif expr.kind == parser.NormalizedExprWhileStmt:
            hasControlStatement = true
        elif expr.kind == parser.NormalizedExprDeferStmt ||
             expr.kind == parser.NormalizedExprBreakStmt ||
             expr.kind == parser.NormalizedExprContinueStmt:
            hasControlStatement = true
        elif expr.kind == parser.NormalizedExprIfStmt ||
             expr.kind == parser.NormalizedExprElifStmt ||
             expr.kind == parser.NormalizedExprElseStmt ||
             expr.kind == parser.NormalizedExprMatchStmt ||
             expr.kind == parser.NormalizedExprCaseStmt ||
             expr.kind == parser.NormalizedExprWhileStmt:
            hasControlStatement = true
    if hasAssignStatement || hasForStatement || hasReturnStatement:
        return true
    if hasControlStatement:
        if scope.returnType == "" || scope.returnType == "void":
            return true
        if !TypedExprScopeHasDirectLeafControlBody(ctx, scope, params):
            return true
    var factEndIndex = factEndIndexRaw
    if factEndIndex < 0 || factEndIndex > facts.count:
        factEndIndex = facts.count
    var callCount: int32
    var onlyCallIndex: int32 = -1
    for i in factStartIndex..<factEndIndex:
        let factRowI = TypedExprFactAt(facts, i)
        if (factRowI.lineNumber <= scope.startLine &&
            !TypedExprFactIsScopeStartReturn(factRowI, scope)) ||
           factRowI.lineNumber > scope.endLine:
            if factRowI.lineNumber > scope.endLine:
                break
            continue
        if !TypedExprFactIsIrCallStatementCandidate(factRowI):
            continue
        callCount = callCount + 1
        onlyCallIndex = i
        if callCount > 1:
            return true
    if callCount <= 0:
        return false
    let onlyCallFact = TypedExprFactAt(facts, onlyCallIndex)
    if onlyCallFact.returnRoot && !onlyCallFact.hasSink:
        return false
    if onlyCallFact.kind == parser.NormalizedExprCall &&
       !onlyCallFact.returnRoot &&
       !onlyCallFact.hasSink &&
       onlyCallFact.callArgCount == 1 &&
       TypedExprTextIsI32Zero(onlyCallFact.callArgsText) &&
       TypedExprTextIsI32Zero(returnExpr):
        return false
    return true

@borrows
fn TypedExprNextStructuredStatementExprIndex(exprLayer: var parser.NormalizedExprLayer,
                                              cursorRaw: int32,
                                              endIndexRaw: int32,
                                              scope: TypedExprFunctionScope): int32 =
    var cursor = cursorRaw
    if cursor < 0:
        cursor = 0
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > exprLayer.exprs.len:
        endIndex = exprLayer.exprs.len
    for i in cursor..<endIndex:
        let expr = exprLayer.exprs[i]
        if expr.lineNumber <= scope.startLine &&
           !TypedExprExprIsScopeStartReturn(expr, scope):
            continue
        if expr.lineNumber > scope.endLine:
            return -1
        if TypedExprExprIsStructuredStatement(expr):
            return i
    return -1

@borrows
fn TypedExprNextCallStatementFactIndex(facts: var TypedExprFactTable,
                                        cursorRaw: int32,
                                        endIndexRaw: int32,
                                        scope: TypedExprFunctionScope,
                                        processedFactIndexes: int32[]): int32 =
    var cursor = cursorRaw
    if cursor < 0:
        cursor = 0
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > facts.count:
        endIndex = facts.count
    for i in cursor..<endIndex:
        let factRowI = TypedExprFactAt(facts, i)
        if factRowI.lineNumber <= scope.startLine &&
           !TypedExprFactIsScopeStartReturn(factRowI, scope):
            continue
        if factRowI.lineNumber > scope.endLine:
            return -1
        if TypedExprProcessedFactContains(processedFactIndexes, i):
            continue
        if TypedExprFactIsIrCallStatementCandidate(factRowI):
            return i
    return -1

@borrows
fn TypedExprStructuredExprComesBeforeFact(expr: parser.NormalizedExpr,
                                           fact: TypedExprFact): bool =
    if expr.lineNumber < fact.lineNumber:
        return true
    if expr.lineNumber > fact.lineNumber:
        return false
    return expr.columnNumber <= fact.columnNumber

# T59 根修: `ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCached`
# 对每一行分别用 local/external/importc 三张互不保证互斥的调用名表各扫一遍
# `ParserAppendCallExprsLine`——同一个标识符 (如同文件本地函数 `helper`) 若同时
# 命中其中两张表 (跨表未去重, 上游分类语义各自独立), 同一处物理调用会在
# `exprLayer.exprs` 里被追加两条内容完全相同的 NormalizedExprCall 节点, 继而
# `TypedExprBuildFactsAppendSourceRangeFacts` 逐条转换后在 facts 表里产生两条
# 完全相同的 fact (kind/columnNumber/callCallee/callArgsText 全等)。
#
# facts 表不能在构建期去重——`TypedExprFactsValidateCallResolutionRange` 强制
# facts 与 exprLayer.exprs (过滤 TypedExprExprRequiresPersistentFact 后) 逐条
# 一一对应 (expr_id/kind 双重校验), 丢弃任一条都会让下标错位, 触发
# "expr id mismatch"/"missing persistent fact" 校验失败——重复必须原样留在表里,
# 只能在这里 (语句物化循环) 让第二条不再独立产生语句。
#
# 消费判据 (T52-v5 全文相等) 对 `return <bare call>` 这种形状恰好让两条重复 fact
# 都满足"fact 全文==return RHS 全文"而双双被消费掉 (表面无恙, 只是白白多判一次);
# 但只要 return 的值不是裸调用本身 (cast/binop/ternary/…包裹, T58
# `return float64(helper())` 实证), 两条重复 fact 全部落回下方 fact-fallback
# 兜底路径各自独立物化成一条语句, 该调用在最终机器码里被物理执行两遍。这不是
# "消费判据形状覆盖不全"能修的——判据补得再全, 消费的仍是一张本不该有重复项的
# fact 表。
#
# 真根因 = 同一物理调用位置 (sourcePath+lineNumber+columnNumber+kind 四元组在
# 源文本里唯一标识一个语法 token, 不可能有两个不同的调用共享同一起始字符位置)
# 被记录了两次。只让第一次出现的 fact 走正常消费/物化流程, 后续同位置重复项
# 一律视为已被第一条覆盖, 直接抑制 (计入 processedFactIndexes, 不再单独产生
# 语句)。向后有限回扫 (facts 按源码行号单调追加, 一旦行号变小立即停止), 每行
# 调用数远小于文件总 fact 数, 不会退化成扫全文件的 O(n²)。
@borrows
fn TypedExprFactHasEarlierDuplicateOnLine(facts: var TypedExprFactTable,
                                           factIndex: int32,
                                           candidate: TypedExprFact): bool =
    var k = factIndex - 1
    while k >= 0:
        let prior = TypedExprFactAt(facts, k)
        if prior.lineNumber != candidate.lineNumber:
            break
        if prior.columnNumber == candidate.columnNumber &&
           prior.kind == candidate.kind &&
           prior.sourcePath == candidate.sourcePath:
            return true
        k = k - 1
    return false

@borrows
fn TypedExprIrAppendStatementsForScopeWithFactsAndExprLayer(ir: var TypedExprIr,
                                                             ctx: var TypedExprSourceContext,
                                                             sourceContexts: TypedExprSourceContext[],
                                                             scope: TypedExprFunctionScope,
                                                             facts: var TypedExprFactTable,
                                                             factStartIndex: int32,
                                                             factEndIndexRaw: int32,
                                                             exprLayer: var parser.NormalizedExprLayer,
                                                             exprStartIndex: int32,
                                                             exprEndIndexRaw: int32,
                                                             includeStructuredStatements: bool) =
    TypedExprTraceLine( "typed_ir_append:enter")
    var factCursor = factStartIndex
    if factCursor < 0:
        factCursor = 0
    var factEndIndex = factEndIndexRaw
    if factEndIndex < 0 || factEndIndex > facts.count:
        factEndIndex = facts.count
    var exprCursor = exprStartIndex
    if exprCursor < 0:
        exprCursor = 0
    var exprEndIndex = exprEndIndexRaw
    if exprEndIndex < 0 || exprEndIndex > exprLayer.exprs.len:
        exprEndIndex = exprLayer.exprs.len
    var currentLineNumber: int32 = -1
    var currentLineHasIf = false
    var currentLineBindingName = ""
    var currentLineBindingType = ""
    var currentLineBindingRootColumn: int32 = -1
    var currentLineBindingRhsStartColumn: int32 = -1
    var currentLineBindingIsTernary = false
    var currentLineBindingIsBinary = false
    var currentLineBindingIsSeqLiteral = false
    var currentLineBindingIsBoolExpr = false
    var currentLineBindingIsAggregateCtor = false
    var activeAggregateCtorEndLine: int32 = -1
    var currentLineReturnRootColumn: int32 = -1
    var currentLineReturnExprStartColumn: int32 = -1
    var currentLineReturnIsTernary = false
    var currentLineReturnIsBinary = false
    var currentLineReturnIsSeqLiteral = false
    var currentLineReturnIsBoolExpr = false
    var currentLineIsBareAggregateCtorTail = false
    var currentLineIndent: int32
    var currentLineEnclosingIfLineNumber: int32
    var currentLineEnclosingIfConditionText = ""
    var processedFactIndexes: int32[]
    TypedExprTraceLine( "typed_ir_append:before_loop")
    while true:
        TypedExprTraceLine( "typed_ir_append:loop_top")
        var exprIndex: int32 = -1
        if includeStructuredStatements:
            TypedExprTraceLine( "typed_ir_append:before_next_expr")
            exprIndex = TypedExprNextStructuredStatementExprIndex(exprLayer,
                                                                  exprCursor,
                                                                  exprEndIndex,
                                                                  scope)
            TypedExprTraceLine( "typed_ir_append:after_next_expr")
        TypedExprTraceLine( "typed_ir_append:before_next_fact")
        let factIndex = TypedExprNextCallStatementFactIndex(facts,
                                                            factCursor,
                                                            factEndIndex,
                                                            scope,
                                                            processedFactIndexes)
        TypedExprTraceLine( "typed_ir_append:after_next_fact")
        if exprIndex < 0 && factIndex < 0:
            break
        var useExpr = false
        if exprIndex >= 0:
            if factIndex < 0:
                useExpr = true
            else:
                TypedExprTraceLine( "typed_ir_append:before_compare_expr_fact")
                useExpr = TypedExprStructuredExprComesBeforeFact(exprLayer.exprs[exprIndex],
                                                                 TypedExprFactAt(facts, factIndex))
                TypedExprTraceLine( "typed_ir_append:after_compare_expr_fact")
        var lineNumber: int32
        if useExpr:
            TypedExprTraceLine( "typed_ir_append:before_line_expr")
            lineNumber = exprLayer.exprs[exprIndex].lineNumber
            TypedExprTraceLine( "typed_ir_append:after_line_expr")
        else:
            TypedExprTraceLine( "typed_ir_append:before_line_fact")
            lineNumber = TypedExprFactAt(facts, factIndex).lineNumber
            TypedExprTraceLine( "typed_ir_append:after_line_fact")
        if lineNumber != currentLineNumber:
            TypedExprTraceLine( "typed_ir_append:before_line_context")
            currentLineNumber = lineNumber
            let lineContinuesAggregateCtor =
                currentLineNumber <= activeAggregateCtorEndLine
            if !lineContinuesAggregateCtor:
                activeAggregateCtorEndLine = -1
            currentLineHasIf = false
            currentLineBindingName = ""
            currentLineBindingType = ""
            currentLineBindingRootColumn = -1
            currentLineBindingRhsStartColumn = -1
            currentLineBindingIsTernary = false
            currentLineBindingIsBinary = false
            currentLineBindingIsSeqLiteral = false
            currentLineBindingIsBoolExpr = false
            currentLineBindingIsAggregateCtor = false
            if lineContinuesAggregateCtor:
                currentLineBindingRhsStartColumn = 1
                currentLineBindingIsAggregateCtor = true
            currentLineReturnRootColumn = -1
            currentLineReturnExprStartColumn = -1
            currentLineReturnIsTernary = false
            currentLineReturnIsBinary = false
            currentLineReturnIsSeqLiteral = false
            currentLineReturnIsBoolExpr = false
            currentLineIsBareAggregateCtorTail = false
            let lineRaw = TypedExprSourceContextLineText(ctx, currentLineNumber)
            currentLineIndent = TypedExprLineIndentWidth(lineRaw)
            TypedExprNearestEnclosingIf(ctx,
                                        scope,
                                        currentLineNumber,
                                        currentLineIndent,
                                        currentLineEnclosingIfLineNumber,
                                        currentLineEnclosingIfConditionText)
            let trimmedLine = chengpath.PathTrim(lineRaw)
            var isBindingLine = false
            if parser.ParserStartsWith(trimmedLine, "let "):
                isBindingLine = true
            elif parser.ParserStartsWith(trimmedLine, "var "):
                isBindingLine = true
            elif parser.ParserStartsWith(trimmedLine, "const "):
                isBindingLine = true
            if isBindingLine:
                currentLineBindingName = TypedExprLetCallBindingNameFromBody(share(trimmedLine))
                var bindingName = ""
                var bindingType = ""
                var bindingRhsColumn: int32 = -1
                if TypedExprParseBindingLine(lineRaw, bindingName, bindingType, bindingRhsColumn):
                    currentLineBindingName = bindingName
                    currentLineBindingType = bindingType
                let eqPos = TypedExprFindTopLevelTextToken(lineRaw, "=")
                if eqPos >= 0:
                    var rhsStartColumn = eqPos + 2
                    for column in rhsStartColumn..lineRaw.len:
                        if parser.ParserIsInlineSpace(lineRaw[column - 1]):
                            rhsStartColumn = column + 1
                        else:
                            rhsStartColumn = column
                            break
                    currentLineBindingRhsStartColumn = rhsStartColumn
                    var bindingRhsEndLine: int32
                    let bindingRhsText = TypedExprBindingRhsTextWithContinuationSpan(
                        ctx,
                        currentLineNumber - 1,
                        rhsStartColumn,
                        bindingRhsEndLine)
                    currentLineBindingIsTernary = TypedExprBindingRhsIsTopLevelTernary(bindingRhsText)
                    currentLineBindingIsBinary = TypedExprBindingRhsHasTopLevelBinaryOperator(bindingRhsText)
                    currentLineBindingIsSeqLiteral = TypedExprBindingRhsIsSeqLiteral(bindingRhsText)
                    currentLineBindingIsBoolExpr = TypedExprBindingRhsBoolExprType(bindingRhsText) != ""
                    currentLineBindingIsAggregateCtor =
                        TypedExprBindingRhsIsAggregateConstructor(ir,
                                                                  ctx,
                                                                  bindingRhsText)
                    if currentLineBindingIsAggregateCtor:
                        activeAggregateCtorEndLine = bindingRhsEndLine
            # Bare (non-binding) implicit-return tail expression whose whole
            # top-level shape is `TypeName( field: value, ... )` — an
            # aggregate constructor, not a plain function call. Every fact on
            # this line (e.g. a call nested in a field value like
            # `buffer: newBufferStream()`) is a piece of the constructor's
            # argument list, never the line's own top-level statement value.
            # Without this guard the nested call fact gets promoted below
            # (`TypedExprIrAppendFactStatementForScope`) to an independent
            # `TypedExprIrStmtCall` statement that discards the surrounding
            # constructor entirely, starving the parser-owned implicit-return
            # root. `TypedExprCallHeadIsPlainQualifiedIdent`
            # already rejects any head containing whitespace, so genuine
            # Only fires when the leading head is a known aggregate type AND
            # not a visible function (function resolution takes precedence,
            # mirroring
            # `PrimaryBodyIrAppendAggregateConstructorToSlot`'s own ctor-vs-
            # function gate).
            var currentLineBareCtorHeadCandidate = ""
            if !isBindingLine:
                let bareCtorOpenPos = TypedExprFindWholeCallOpenParen(trimmedLine)
                if bareCtorOpenPos > 0:
                    currentLineBareCtorHeadCandidate = chengpath.PathTrim(chengpath.TextSlice(trimmedLine,
                                                                                               0,
                                                                                               bareCtorOpenPos))
            if currentLineBareCtorHeadCandidate != "" &&
               TypedExprCallHeadIsPlainQualifiedIdent(currentLineBareCtorHeadCandidate):
                var bareCtorSizeBytes: int32
                var bareCtorAlignBytes: int32
                var bareCtorFieldCount: int32
                if TypedExprIrLookupTypeLayout(ir,
                                               ctx.sourcePath,
                                               currentLineBareCtorHeadCandidate,
                                               bareCtorSizeBytes,
                                               bareCtorAlignBytes,
                                               bareCtorFieldCount) &&
                   bareCtorFieldCount > 0:
                    if TypedExprLocalFunctionNameState(
                            ctx, currentLineBareCtorHeadCandidate) ==
                       TypedExprBuildIndexMissing:
                        currentLineIsBareAggregateCtorTail = true
            let firstToken = parser.ParserFirstToken(chengpath.PathTrim(lineRaw))
            if firstToken == "return":
                let returnPos = parser.ParserFindText(lineRaw, "return")
                currentLineReturnExprStartColumn = returnPos + 7
            elif scope.startLine == currentLineNumber:
                let inlineEqPos = TypedExprFindTopLevelTextToken(lineRaw, "=")
                if inlineEqPos >= 0:
                    currentLineReturnExprStartColumn = inlineEqPos + 2
                else:
                    currentLineReturnExprStartColumn = -1
            # T52-v3.1 收窄: 与绑定侧 currentLineBindingIsTernary/IsBinary/
            # IsSeqLiteral/IsBoolExpr 完全对称 —— 在判定"return 的根调用是否等于
            # 整个 return 表达式"之前, 先用同一组久经验证的顶层形状探测器分析
            # return 自己的 RHS 文本 (多行续行同一套 TypedExprBindingRhsTextWithContinuation)。
            # `return 4 + 4 + strings.Len(s)` 这类 binop-return: 表达式里唯一的调用
            # fact (`strings.Len`) 天然是"整行里列号最小的调用"(currentLineReturnRootColumn
            # 只看"最靠左"), 但它并不在 currentLineReturnExprStartColumn 处起笔——旧判据
            # 漏查了这一点, 把它当成"return 就是这个调用"错误消费掉 (chain25 GEN2 满炉
            # 自烤实测: backend2FragCodecStrSize 反汇编级确认 Len 的 fact 被吞, 探针
            # T52DBG 逐行打点复现 factCol=28 retStart=11 仍被 CONSUMED)。四个形状标志
            # 任一为真都说明 return 的值不是"裸调用"本身, 一律不消费。
            if currentLineReturnExprStartColumn > 0:
                let returnRhsText = TypedExprBindingRhsTextWithContinuation(ctx,
                                                                             currentLineNumber - 1,
                                                                             currentLineReturnExprStartColumn)
                currentLineReturnIsTernary = TypedExprBindingRhsIsTopLevelTernary(returnRhsText)
                currentLineReturnIsBinary = TypedExprBindingRhsHasTopLevelBinaryOperator(returnRhsText)
                currentLineReturnIsSeqLiteral = TypedExprBindingRhsIsSeqLiteral(returnRhsText)
                currentLineReturnIsBoolExpr = TypedExprBindingRhsBoolExprType(returnRhsText) != ""
            for j in exprStartIndex..<exprEndIndex:
                let lineExpr = exprLayer.exprs[j]
                if lineExpr.lineNumber != currentLineNumber:
                    if lineExpr.lineNumber > currentLineNumber:
                        break
                    continue
                if lineExpr.kind == parser.NormalizedExprIf:
                    # See TypedExprLineHasIfKeywordFact: a ternary `?` mark
                    # shares NormalizedExprIf's fact kind with a real
                    # if/elif/while keyword. This exprLayer entry carries
                    # detailKind directly, so check it instead of re-deriving
                    # from the source byte.
                    if lineExpr.detailKind == parser.NormalizedExprDetailIfTernary:
                        continue
                    currentLineHasIf = true
                    break
            for j in factStartIndex..<factEndIndex:
                let lineFact = TypedExprFactAt(facts, j)
                if lineFact.lineNumber != currentLineNumber:
                    if lineFact.lineNumber > currentLineNumber:
                        break
                    continue
                # `let x = if IsOk(r): Value(r) else: default` (mirror for IsErr):
                # IsOk/IsErr is the if-expression's CONDITION test, never the
                # value-producing arm, yet it lexically precedes the then-arm's
                # Value/Error/ErrorInfoOf payload projection. The plain
                # leftmost-column heuristic below picks IsOk/IsErr as the binding
                # root, so TypedExprIrAppendFactStatementForScope attaches the
                # let's binding to the condition's boolean instead of the arm's
                # payload. That silently reads back correct only when the payload
                # type IS bool (IsOk's flag and Value(r):bool share the numeric
                # identity 0/1); for int32/str/... it materializes the wrong value
                # (t25_repro6: `iv` got IsOk(ri)'s flag=1, not Value(ri)=7).
                # currentLineHasIf (set above from the exprLayer's `if`-keyword
                # fact) reliably marks "this line's RHS is an if-expression" —
                # exclude the predicate-only intrinsics from root-column
                # candidacy so the later payload intrinsic (or ordinary call) in
                # the arm wins instead. A standalone `let ok = IsOk(r)` (no `if`
                # keyword text on the line) is unaffected since currentLineHasIf
                # stays false for it.
                let lineFactIsIfCondPredicate = currentLineHasIf &&
                                                 lineFact.kind == parser.NormalizedExprResultIntrinsic &&
                                                 (lineFact.callCallee == "IsOk" ||
                                                  lineFact.callCallee == "IsErr" ||
                                                  lineFact.callCallee == "result.IsOk" ||
                                                  lineFact.callCallee == "result.IsErr")
                if currentLineBindingRhsStartColumn > 0 &&
                   !lineFactIsIfCondPredicate &&
                   (lineFact.kind == parser.NormalizedExprCall ||
                    lineFact.kind == parser.NormalizedExprResultIntrinsic) &&
                   lineFact.columnNumber >= currentLineBindingRhsStartColumn:
                    if currentLineBindingRootColumn < 0 ||
                       lineFact.columnNumber < currentLineBindingRootColumn:
                        currentLineBindingRootColumn = lineFact.columnNumber
                if currentLineReturnExprStartColumn > 0 &&
                   !lineFactIsIfCondPredicate &&
                   (lineFact.kind == parser.NormalizedExprCall ||
                    lineFact.kind == parser.NormalizedExprResultIntrinsic) &&
                   lineFact.columnNumber >= currentLineReturnExprStartColumn:
                    if currentLineReturnRootColumn < 0 ||
                       lineFact.columnNumber < currentLineReturnRootColumn:
                        currentLineReturnRootColumn = lineFact.columnNumber
            TypedExprTraceLine( "typed_ir_append:after_line_context")
        if useExpr:
            TypedExprTraceLine( "typed_ir_append:before_expr_copy")
            let expr = exprLayer.exprs[exprIndex]
            TypedExprTraceLine( "typed_ir_append:after_expr_copy")
            if expr.kind == parser.NormalizedExprReturn:
                TypedExprTraceLine( "typed_ir_append:before_return_expr_stmt")
                let _ = TypedExprIrAddCallStatementFromExpr(ir,
                                                            ctx,
                                                            sourceContexts,
                                                            share(scope),
                                                            share(expr),
                                                            TypedExprIrStmtReturn,
                                                            "",
                                                            share(scope.returnType),
                                                            currentLineIndent,
                                                            currentLineEnclosingIfLineNumber,
                                                            share(currentLineEnclosingIfConditionText),
                                                            true)
                TypedExprTraceLine( "typed_ir_append:after_return_expr_stmt")
            elif expr.kind == parser.NormalizedExprAssign:
                TypedExprTraceLine( "typed_ir_append:before_assign_expr_stmt")
                let _ = TypedExprIrAddAssignStatementFromExpr(ir,
                                                              ctx,
                                                              sourceContexts,
                                                              share(scope),
                                                              share(expr),
                                                              currentLineIndent,
                                                              currentLineEnclosingIfLineNumber,
                                                              share(currentLineEnclosingIfConditionText))
                TypedExprTraceLine( "typed_ir_append:after_assign_expr_stmt")
            else:
                TypedExprTraceLine( "typed_ir_append:before_control_expr_stmt")
                let _ = TypedExprIrAddControlStatementFromExpr(ir,
                                                               ctx,
                                                               sourceContexts,
                                                               share(scope),
                                                               share(expr),
                                                               currentLineIndent,
                                                               currentLineEnclosingIfLineNumber,
                                                               share(currentLineEnclosingIfConditionText))
                TypedExprTraceLine( "typed_ir_append:after_control_expr_stmt")
            exprCursor = exprIndex + 1
            continue
        TypedExprTraceLine( "typed_ir_append:before_fact_deps")
        let currentFact = TypedExprFactAt(facts, factIndex)
        # T59 根修 (完整论证见 TypedExprFactHasEarlierDuplicateOnLine 定义处):
        # 上游 local/external/importc 三张调用名表交叉命中会让同一物理调用位置
        # 在 facts 表里出现两条内容完全相同的项——第二条若不被抑制, 会在下方
        # (无论是被本函数消费还是落到 fact-fallback 兜底) 独立再产生一条语句,
        # 该调用物理执行两遍 (T58 `return float64(helper())` 实证)。facts 表本身
        # 不能去重 (与 exprLayer.exprs 强制逐条对应, 见该函数定义处校验器说明),
        # 只在这里让同位置的非首次出现直接抑制, 把"是否消费/如何物化"完全交给
        # 首次出现的那一条决定。
        if TypedExprFactHasEarlierDuplicateOnLine(facts, factIndex, currentFact):
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        if TypedExprFactNeedsStructuredStatementConsumer(currentFact) ||
           TypedExprFactIsNestedUnderStructuredStatementRoot(ir, currentFact):
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # [c3-loopsource] for 头 iterable call 由 for 语句消费
        # (TypedExprForHeaderRangeBounds 所有权); 不认领则被下方兜底
        # 提升成孤儿 call 语句, typing 撞 unresolved structural Call
        # callee=range (branchb c3 判词)。
        if TypedExprFactIsLoopSourceIterableCall(currentFact):
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # The complete LocalDecl RHS is an aggregate constructor.  Calls in
        # named field values are dependencies of that constructor, never
        # independent statements and never the binding root.  Consume them
        # before dependency expansion; doing this after AppendFactDependencies
        # is too late because a nested dependency has already occupied the line.
        if currentLineBindingIsAggregateCtor &&
           currentLineBindingRhsStartColumn > 0 &&
           (currentFact.kind == parser.NormalizedExprCall ||
            currentFact.kind == parser.NormalizedExprResultIntrinsic) &&
           currentFact.columnNumber >= currentLineBindingRhsStartColumn:
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # T33 根修: `add(seq, outer(inner(x)))` (2+ 层嵌套调用当 add()/setLen()/
        # reserve() 的 value 实参) 静默丢弃 append —— 根 fact (outer) 在这里被
        # TypedExprIrAppendFactDependenciesForScope 无条件材料化它自己的嵌套
        # 依赖 (inner) 成独立语句 (递归 feeder 惯例, 服务于"root fact 自己就是
        # 顶层语句"的一般情形), 而下面 (TypedExprFactIsSeqSideEffectBuiltinSubExpr)
        # 检查 root fact 自身是不是 seq 内建的子表达式并抑制它, 发生在依赖材料化
        # 之后——太迟了: inner 已被拍平成孤儿语句 (结果被丢弃), 而 add(...) 这一行
        # 因为"已经有语句占了这一行" (TypedExprIrStatementLineExists 变真) 会让
        # parser-owned add() 根 fact 失去语句所有权, 导致 seq 恒不增长 (1 层嵌套
        # `add(seq, inner(x))` 时 inner 本身就是
        # 直接实参/root fact, 没有更深依赖可材料化, 不触发这条时序竞争, 故只有
        # 2 层及以上嵌套才复现)。在材料化依赖之前先做同一项检查: root fact 自己是
        # seq 内建子表达式时, 直接跳过依赖材料化和常规提升, 把整条语句留给
        # parser-owned builtin Call 根。下方原有的同一检查
        # (TypedExprFactIsSeqSideEffectBuiltinSubExpr,
        # ~100 行之后) 对其它到达该点而未被本守卫提前拦截的 fact 保持不变, 不删除。
        if TypedExprFactIsSeqSideEffectBuiltinSubExpr(ctx, scope, currentFact):
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        TypedExprIrAppendFactDependenciesForScope(ir,
                                                  ctx,
                                                  sourceContexts,
                                                  scope,
                                                  facts,
                                                  factIndex,
                                                  factStartIndex,
                                                  factEndIndex,
                                                  processedFactIndexes,
                                                  currentLineHasIf,
                                                  currentLineBindingName,
                                                  currentLineBindingType,
                                                  currentLineBindingRootColumn,
                                                  currentLineIndent,
                                                  currentLineEnclosingIfLineNumber,
                                                  currentLineEnclosingIfConditionText)
        TypedExprTraceLine( "typed_ir_append:after_fact_deps")
        # `let x = (<cond> ? <a> : <b>)` whose condition/arms contain calls: the
        # calls are sub-expressions of a top-level ternary, NOT the binding's
        # value. Promoting the leftmost one to a let-call binds x to that call's
        # result and discards the conditional. Leave the whole RHS to the
        # LocalDecl twin (lowered through the cbr ternary path); consume the fact
        # so it does not fall through to an unconditional call statement.
        if currentLineBindingIsTernary &&
           currentLineBindingRhsStartColumn > 0 &&
           currentFact.kind == parser.NormalizedExprCall &&
           currentFact.columnNumber >= currentLineBindingRhsStartColumn:
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # BACKFILL-2/T25C (f24 33f086d, 缺口①): `let x = if <cond>: <a> else: <b>`
        # — the if/else *text* form of the ternary above (mirror of the `?`/`:`
        # guard just above, keyed off currentLineHasIf instead of
        # currentLineBindingIsTernary since this syntax has no `?`). COND/THEN/
        # ELSE calls are sub-expressions of a top-level if-expression, not the
        # binding's value on their own: the leftmost-column heuristic elsewhere
        # in this loop would bind x to whichever call is textually first
        # (usually COND's), and even a correctly-chosen arm call has nothing
        # here making the *other* arm conditionally NOT execute. Leave the whole
        # RHS to the LocalDecl twin instead: primary_object_plan's
        # PrimaryBodyIrAppendScalarTernaryBlockValue already lowers a scalar
        # `cond ? then : else` (i32/i64) through a real cbr where only the
        # selected arm's call executes; the backend converts this if/else text
        # form to that `?` form (PrimaryBodyIrIfExprToTernaryText) before
        # handing it over. Only NormalizedExprCall matches — ResultIntrinsic
        # facts (IsOk/IsErr/Value/Error/ErrorInfoOf) are a different kind, so
        # T25B's Result-projection ternary handling is untouched.
        # SCOPE NOTE (main-repo adaptation): this backfill deliberately does
        # NOT port f24's two "附带" (incidental) nested/chained-ternary items
        # (PrimaryBodyIrAppendScalarTernaryArmValue's recursive if/else->`?`
        # conversion + TypedExprBindingOperandType's nested if/else mirror).
        # f24's tree can lower a nested ternary arm safely only because an
        # UNRELATED later campaign there ("层B", short-circuit &&/|| condition
        # support) also replaced PrimaryBodyIrAppendScalarTernaryBlockValue's
        # fixed cbrBlock+3 join-block-index arithmetic with a dynamic
        # end-of-blocks backpatch. Main repo's ScalarTernaryBlockValue still
        # hardcodes the join block as cbrBlock+3; verified empirically that
        # porting the ArmValue nested-conversion here alone (without that
        # prerequisite) makes a chained ternary arm recurse into a second cbr
        # chain, invalidating the outer's fixed-offset join block and
        # producing a genuine infinite loop at runtime (confirmed via
        # `nested_ternary_repro.cheng`, times out under this patch,
        # terminates — with a pre-existing wrong value, not a new defect — on
        # unpatched HEAD). Single-level ternaries (this guard's actual target,
        # and T25C's original defect report) are unaffected and fixed below;
        # chained/nested ternaries remain the same pre-existing, terminating,
        # not-yet-fixed limitation they were before this patch.
        if currentLineHasIf &&
           currentLineBindingRhsStartColumn > 0 &&
           currentFact.kind == parser.NormalizedExprCall &&
           currentFact.columnNumber >= currentLineBindingRhsStartColumn:
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # `let x = <call> <binop> <...>` — call is a sub-expression of a top-level
        # binary, not the binding's value. Same suppression as the ternary guard;
        # the LocalDecl twin's binary-with-call decomposer owns the whole RHS.
        if currentLineBindingIsBinary &&
           currentLineBindingRhsStartColumn > 0 &&
           currentFact.kind == parser.NormalizedExprCall &&
           currentFact.columnNumber >= currentLineBindingRhsStartColumn:
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # `let xs = [call(), ...]`: calls belong to the seq literal initializer.
        # Let the LocalDecl SeqLiteral node consume the full RHS, including all
        # element calls, instead of promoting the leftmost element call.
        if currentLineBindingIsSeqLiteral &&
           currentLineBindingRhsStartColumn > 0 &&
           currentFact.kind == parser.NormalizedExprCall &&
           currentFact.columnNumber >= currentLineBindingRhsStartColumn:
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # `let b = <call> <cmp> <...>` — call feeds a top-level comparison, so the
        # binding value is bool, not the call's return type. Suppress let-call
        # promotion (which would lock the IR binding store to the call return type
        # and leave `if b:` unresolved → cond_shape); the LocalDecl twin carries
        # the bool type inferred from the comparison.
        if currentLineBindingIsBoolExpr &&
           currentLineBindingRhsStartColumn > 0 &&
           currentFact.kind == parser.NormalizedExprCall &&
           currentFact.columnNumber >= currentLineBindingRhsStartColumn:
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # `add(seq, helper(...))` / `setLen(seq, helper(...))`: the inner helper
        # call is a sub-expression of a top-level seq side-effect builtin whose
        # head is not itself a fact. Promoting the inner call to a standalone
        # statement occupies the line and suppresses the builtin's synthesis
        # (the grow+store is dropped). Consume the fact so the
        # unrepresented-top-level-statement synthesis owns the whole line and
        # lowers the inner call as the element feeder.
        if TypedExprFactIsSeqSideEffectBuiltinSubExpr(ctx, scope, currentFact):
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        if currentLineIsBareAggregateCtorTail &&
           (currentFact.kind == parser.NormalizedExprCall ||
            currentFact.kind == parser.NormalizedExprResultIntrinsic):
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        # T52-v3 根修: `return <call>` (含 var/by-ref 实参形, 如
        # `return cheng_pty_wait_runtime(pid, outExitCode)`) 的调用已经在上面
        # useExpr 分支处理 return 语句时 (TypedExprIrAddCallStatementFromExpr,
        # kind=Return) 一并登记为一条语句。currentLineReturnExprStartColumn/
        # currentLineReturnRootColumn 在本函数里一直被计算 (与
        # currentLineBindingRhsStartColumn/currentLineBindingRootColumn 对称),
        # 但从未消费掉这个"return 表达式自己的根调用" fact —— 于是这个 fact 又被
        # 下方通用 fact-statement 兜底路径重复物化成第二条独立语句, 该 call 在
        # 最终发射的机器码里被调用两次 (真实副作用/返回值被第二次调用的结果覆盖
        # 或吞没; 案例: cheng_pty_wait_bridge 对 cheng_pty_wait_runtime 的
        # waitpid 由此被物理执行两遍, 第二遍对已收割 pid 必得 ECHILD, GEN2
        # provider 编排因此把成功的 provider 编译误判为失败)。
        #
        # 只消费根调用本身 (列号严格等于 currentLineReturnRootColumn, 即 return
        # 表达式里最靠左的那个调用), 不用 ">=" 覆盖整个 return 表达式列范围。
        # 且实参文本里不能含嵌套调用 ("(" ): `return outer(inner(x))` 这类形
        # (如 src/std/system.cheng:panicCString 的
        # `return driver_c_new_string_copy_n(dataPtr0, strLenFast(msg))`) 里,
        # 后端 PrimaryBodyIrAppendReturnWholeCall 对含嵌套调用实参的根调用另有
        # 一条依赖前端 fact 物化的独立路径 (实测: 无条件消费根调用会让
        # panicCString 退化成 bail=801 unsupported); 只在实参是纯值/标识符
        # (无嵌套调用) 时消费, 这正是本案 (`cheng_pty_wait_runtime(pid,
        # outExitCode)` 一类 var/by-ref 实参但无嵌套调用) 的形状。
        #
        # T52-v3.1 收窄: 上面的"列号等于 currentLineReturnRootColumn"判据不够——
        # currentLineReturnRootColumn 是"整行里列号最小的调用 fact", 对
        # `return 4 + 4 + strings.Len(s)` 这种 binop-return, `strings.Len` 是
        # 该行*唯一*的调用 fact, 天然拿到"列号最小"资格, 却根本不在
        # currentLineReturnExprStartColumn (return 表达式真正的起笔列) 处——
        # 旧判据把它当成"return 就是这个调用"错误消费 (chain25 GEN2 满炉自烤
        # 实测复现: backend2FragCodecStrSize 的 Len fact 被吞, T52DBG 逐行打点
        # 确认 factCol=28 retStart=11 仍被 CONSUMED; body_ir_call_empty_reloc_target
        # detail=Len 正是这条 fact 消失后 body-IR 里找不到匹配调用目标的直接后果)。
        # 结构性修法与绑定侧完全对称: 复用同一组久经验证的顶层形状探测器
        # (TypedExprBindingRhsIsTopLevelTernary/HasTopLevelBinaryOperator/
        # IsSeqLiteral/BoolExprType) 分析 return 自己的 RHS 文本——只要这四个
        # 探测器任一命中, 说明 return 的值不是"裸调用"本身 (调用只是子表达式),
        # 一律不消费。
        #
        # T52-v3.2 收窄: 消费这条 fact 会让 useExpr 分支 (TypedExprIrAddCallStatementFromExpr,
        # kind=Return) 成为该调用目标唯一的登记入口——但那条路径对 expr.kind==Return 走的是
        # 弱化解析 (只透传 expr.callTarget/callTargetSourcePath 原始字段, 不经
        # TypedExprResolveQualifiedCallTargetReturnType 的限定跨源解析)。当 callee 带模块
        # 限定符 (`ops.Foo(...)`) 且该裸名 (`Foo`) 在全程序里存在同名重复定义 (真实撞名实测:
        # `PrimaryBodyIRFillBlockTermReturn` 同时定义于 primary_object_plan.cheng 与
        # backend2_emit_ops.cheng) 时, 消费掉限定符携带者 (fact) 后, Return 语句自己的目标
        # 解析退化为不带限定符的全局裸名扫描, 命中 ≥2 个候选 → CallTargetGlobalAmbiguous
        # → missing_call_target (实测: backend2FillBlockTerm 对
        # `return ops.PrimaryBodyIRFillBlockTermReturn(...)` 满炉复现,
        # resolution_kind=6/global_ambiguous; 最小 repro case4_qualified_dup 逐字节复现同一
        # resolution_kind, 且 A/B 证实只有限定符非空时才失败)。qualifier=="" 的调用 (本案
        # `cheng_pty_wait_runtime`/v3.1 三个 binop 形) 从未走限定跨源解析, 消费前后行为不变,
        # 不受影响——只在 callee 带限定符时不消费, 交还给下方 fact-statement 兜底路径 (那里
        # 走的是完整的 TypedExprResolveQualifiedCallTargetReturnType, 解析结果正确)。
        if currentLineReturnRootColumn > 0 &&
           currentFact.kind == parser.NormalizedExprCall &&
           currentFact.columnNumber == currentLineReturnRootColumn &&
           !currentLineReturnIsTernary &&
           !currentLineReturnIsBinary &&
           !currentLineReturnIsSeqLiteral &&
           !currentLineReturnIsBoolExpr &&
           currentFact.callQualifier == "" &&
           !strutil.Contains(currentFact.callArgsText, "("):
            add(processedFactIndexes, factIndex)
            factCursor = factIndex + 1
            continue
        if !TypedExprProcessedFactContains(processedFactIndexes, factIndex):
            TypedExprTraceLine( "typed_ir_append:before_fact_stmt")
            let _ = TypedExprIrAppendFactStatementForScope(ir,
                                                           ctx,
                                                           sourceContexts,
                                                           share(scope),
                                                           share(currentFact),
                                                           currentLineHasIf,
                                                           share(currentLineBindingName),
                                                           share(currentLineBindingType),
                                                           currentLineBindingRootColumn,
                                                           currentLineIndent,
                                                           currentLineEnclosingIfLineNumber,
                                                           share(currentLineEnclosingIfConditionText))
            add(processedFactIndexes, factIndex)
            TypedExprTraceLine( "typed_ir_append:after_fact_stmt")
        factCursor = factIndex + 1
    TypedExprTraceLine( "typed_ir_append:exit")

@borrows
fn TypedExprLookupCallTargetReturnTypeFromExpr(currentCtx: var TypedExprSourceContext,
                                                sourceContexts: var TypedExprSourceContext[],
                                                expr: parser.NormalizedExpr): str =
    var resolvedSourcePath: str
    var resolvedTargetName: str
    var resolvedTargetSignatureLineNumber: int32
    var resolvedImportc: bool
    return TypedExprResolveCallTargetReturnType(currentCtx,
                                                sourceContexts,
                                                expr.callQualifier,
                                                expr.callCallee,
                                                expr.callTarget,
                                                expr.callArgsText,
                                                expr.lineNumber,
                                                TypedExprSurfaceCallKindFromParser(expr.callSurfaceKind),
                                                resolvedSourcePath,
                                                resolvedTargetName,
                                                resolvedTargetSignatureLineNumber,
                                                resolvedImportc)

fn TypedExprResultIntrinsicTypeFromExpr(ctx: var TypedExprSourceContext,
                                         expr: parser.NormalizedExpr,
                                         sink: TypedExprSinkInfo): str =
    if expr.detailKind == parser.NormalizedExprDetailResultIsOk ||
       expr.detailKind == parser.NormalizedExprDetailResultIsErr:
        return "bool"
    if expr.detailKind == parser.NormalizedExprDetailResultError:
        return "str"
    if expr.detailKind == parser.NormalizedExprDetailResultErrorInfoOf:
        return "ErrorInfo"
    if sink.hasSink && sink.sinkType != "":
        return sink.sinkType
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, expr.lineNumber)
    let sourceResultType = TypedExprInferredResultInputType(ctx, scopeIndex, expr)
    let innerType = TypedExprResultSuccessType(sourceResultType)
    if innerType != "":
        return innerType
    return "result_projection"

# Find the first field separator (`.` or `->`) that sits at bracket/paren
# depth 0. Dots inside an index expression (`refCount[op.target]`) belong to
# the index, not to a struct field path, so they must be skipped. Writes the
# separator length (1 for `.`, 2 for `->`) into sepLen and returns the
# position, or -1 when there is no top-level separator.
@borrows
fn TypedExprAssignTopLevelSepPos(text: str, sepLen: var int32): int32 =
    var depth = 0
    var i = 0
    while i < text.len:
        let ch = text[i]
        if ch == '[' || ch == '(':
            depth = depth + 1
        elif ch == ']' || ch == ')':
            if depth > 0:
                depth = depth - 1
        elif depth == 0:
            if ch == '-' && i + 1 < text.len && text[i + 1] == '>':
                sepLen = 2
                return i
            if ch == '.':
                sepLen = 1
                return i
        i = i + 1
    sepLen = 1
    return -1

@borrows
fn TypedExprAssignLhsRootName(lhsRaw: str): str =
    let lhs = chengpath.PathTrim(share(lhsRaw))
    if lhs == "":
        return ""
    var sepLen = 1
    let dotPos = TypedExprAssignTopLevelSepPos(lhs, sepLen)
    if dotPos > 0:
        return parser.ParserIdentPrefix(chengpath.TextSlice(lhs, 0, dotPos))
    return parser.ParserIdentPrefix(lhs)

@borrows
fn TypedExprAssignFieldName(lhsRaw: str): str =
    let lhs = chengpath.PathTrim(share(lhsRaw))
    var sepLen = 1
    let dotPos = TypedExprAssignTopLevelSepPos(lhs, sepLen)
    if dotPos < 0 || dotPos + 1 >= lhs.len:
        return ""
    return parser.ParserIdentPrefix(chengpath.TextSlice(lhs,
                                                       dotPos + sepLen,
                                                       lhs.len - dotPos - sepLen))

@borrows
fn TypedExprAssignFieldPath(lhsRaw: str): str =
    let lhs = chengpath.PathTrim(share(lhsRaw))
    var sepLen = 1
    let dotPos = TypedExprAssignTopLevelSepPos(lhs, sepLen)
    if dotPos < 0 || dotPos + 1 >= lhs.len:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(lhs,
                                                  dotPos + sepLen,
                                                  lhs.len - dotPos - sepLen))

# Indexed-root field LHS detection: `root[idx].field`. The segment before the
# top-level field `.` is the subscripted root `root[idx]`; when it carries a
# subscript the field path is resolved against the *element* type of the seq /
# array, not the seq type itself. Returns true and sets the element type when
# the root segment is exactly `<ident>[<index>]`.
@borrows
fn TypedExprAssignLhsRootIsIndexed(lhsRaw: str): bool =
    let lhs = chengpath.PathTrim(share(lhsRaw))
    var sepLen = 1
    let dotPos = TypedExprAssignTopLevelSepPos(lhs, sepLen)
    if dotPos <= 0:
        return false
    let rootSegment = chengpath.PathTrim(chengpath.TextSlice(lhs, 0, dotPos))
    if rootSegment == "" || rootSegment.len < 3:
        return false
    if rootSegment[rootSegment.len - 1] != ']':
        return false
    var depth = 0
    var bracketPos = -1
    var i = 0
    while i < rootSegment.len:
        let ch = rootSegment[i]
        if ch == '[':
            if depth == 0 && bracketPos < 0:
                bracketPos = i
            depth = depth + 1
        elif ch == ']':
            if depth > 0:
                depth = depth - 1
        elif ch == '.' && depth == 0:
            # a dotted root segment (`a.b[i]`) is a chained path, not the
            # surgical `<ident>[<index>]` form handled here.
            return false
        i = i + 1
    return bracketPos > 0

# Strip one level of seq / fixed-array suffix to obtain the element type:
# `Row[]` -> `Row`, `seq[Row]` -> `Row`, `Elem[4]` -> `Elem`. Returns "" when
# the type is not an indexable container.
@borrows
fn TypedExprSeqArrayElementType(typeRaw: str): str =
    let norm = TypedExprNormalizeTypeText(TypedExprStripVarType(typeRaw))
    if norm == "":
        return ""
    if parser.ParserStartsWith(norm, "seq[") &&
       norm.len > 5 &&
       norm[norm.len - 1] == ']':
        return chengpath.PathTrim(chengpath.TextSlice(norm, 4, norm.len - 5))
    if norm.len >= 3 && norm[norm.len - 1] == ']':
        var depth = 0
        var openPos = -1
        var i = 0
        while i < norm.len:
            let ch = norm[i]
            if ch == '[':
                if depth == 0:
                    openPos = i
                depth = depth + 1
            elif ch == ']':
                if depth > 0:
                    depth = depth - 1
            i = i + 1
        if openPos > 0:
            return chengpath.PathTrim(chengpath.TextSlice(norm, 0, openPos))
    return ""

# Chained-dot indexed field path detection: `root.seqfield[idx].elemfield` ->
# the field path passed to ResolveFieldPathMeta is `seqfield[idx].elemfield`
# (rootName=`root` already consumed the root segment). The first top-level
# segment (before the first bracket-aware `.`) is `<seqfield>[<idx>]`; the
# remainder is the element-member path `elemfield`. The seq field layer must be
# resolved against the root struct (to get the seq type), then stripped to the
# element type, and `elemfield` resolved against that element type. Returns true
# and fills seqFieldName / elemFieldPath when the field path has this shape;
# seqFieldIndexText carries the raw `[<idx>]` text (kept verbatim, bracket-aware
# split already excluded its inner `.`). Mirrors LhsRootIsIndexed but for the
# field-path tail of a chained-dot indexed store (bail_711 trigger:
# outline.points[idx].endContour / s.items[idx].flag).
fn TypedExprAssignLhsFieldPathIndexedRoot(fieldPathRaw: str,
                                          seqFieldName: var str,
                                          seqFieldIndexText: var str,
                                          elemFieldPath: var str): bool =
    seqFieldName = ""
    seqFieldIndexText = ""
    elemFieldPath = ""
    let fieldPath = chengpath.PathTrim(fieldPathRaw)
    if fieldPath == "" || fieldPath.len < 4:
        return false
    # Bracket-aware scan: the first `.` at bracket depth 0 separates the
    # indexed seq-field segment from the element-member tail.
    var depth = 0
    var dotPos = -1
    var i = 0
    while i < fieldPath.len:
        let ch = fieldPath[i]
        if ch == '[' || ch == '(':
            depth = depth + 1
        elif ch == ']' || ch == ')':
            if depth > 0:
                depth = depth - 1
        elif ch == '.' && depth == 0:
            dotPos = i
            break
        i = i + 1
    if dotPos <= 0:
        return false
    let indexedSegment = chengpath.PathTrim(chengpath.TextSlice(fieldPath, 0, dotPos))
    elemFieldPath = chengpath.PathTrim(chengpath.TextSlice(fieldPath,
                                                            dotPos + 1,
                                                            fieldPath.len - dotPos - 1))
    if indexedSegment == "" || elemFieldPath == "":
        return false
    if indexedSegment[indexedSegment.len - 1] != ']':
        return false
    # Locate the first `[` that opens the subscript; the prefix is the seq
    # field name, the bracket contents are the index text.
    var openPos = -1
    var d = 0
    var j = 0
    while j < indexedSegment.len:
        let ch = indexedSegment[j]
        if ch == '[':
            if d == 0 && openPos < 0:
                openPos = j
            d = d + 1
        elif ch == ']':
            if d > 0:
                d = d - 1
        j = j + 1
    if openPos <= 0 || d != 0:
        return false
    seqFieldName = parser.ParserIdentPrefix(chengpath.TextSlice(indexedSegment, 0, openPos))
    if seqFieldName == "":
        return false
    seqFieldIndexText = chengpath.PathTrim(chengpath.TextSlice(indexedSegment,
                                                                openPos,
                                                                indexedSegment.len - openPos))
    return true

@borrows
fn TypedExprTextIsSimpleFieldPath(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text == "":
        return false
    let arrowPos = parser.ParserFindText(text, "->")
    let dotPos = parser.ParserFindText(text, ".")
    if arrowPos <= 0 && dotPos <= 0:
        return false
    if parser.ParserFindText(text, "(") >= 0 ||
       parser.ParserFindText(text, ")") >= 0 ||
       parser.ParserFindText(text, "[") >= 0 ||
       parser.ParserFindText(text, "]") >= 0 ||
       parser.ParserFindText(text, "{") >= 0 ||
       parser.ParserFindText(text, "}") >= 0 ||
       parser.ParserFindText(text, " ") >= 0 ||
       parser.ParserFindText(text, "+") >= 0 ||
       (parser.ParserFindText(text, "-") >= 0 && arrowPos < 0) ||
       parser.ParserFindText(text, "*") >= 0 ||
       parser.ParserFindText(text, "/") >= 0 ||
       parser.ParserFindText(text, "?") >= 0 ||
       parser.ParserFindText(text, ":") >= 0 ||
       parser.ParserFindText(text, "!") >= 0 ||
       parser.ParserFindText(text, ",") >= 0 ||
       parser.ParserFindText(text, "\"") >= 0:
        return false
    return true

fn TypedExprTextIsSimpleDerefPath(textRaw: str): bool =
    let text = chengpath.PathTrim(textRaw)
    if text.len <= 1 || text[0] != '*':
        return false
    let inner = chengpath.PathTrim(chengpath.TextSlice(text, 1, text.len - 1))
    if inner == "":
        return false
    return parser.ParserIdentPrefix(inner) == inner

fn TypedExprAssignFieldType(rootTypeRaw: str,
                             fieldNameRaw: str): str =
    # Field access reads through a `var T` borrow and therefore resolves members
    # on T itself.  Keeping the borrow qualifier here makes generic `var Result[T]`
    # miss its fixed `ok/value/err` field types whenever full layout is deferred.
    let rootType = TypedExprNormalizeTypeText(TypedExprStripVarType(rootTypeRaw))
    let fieldName = parser.ParserIdentPrefix(chengpath.PathTrim(fieldNameRaw))
    if fieldName == "":
        return ""
    if fieldName == "len":
        return "int32"
    if rootType == "Bytes" || rootType == "rawbytes.Bytes":
        if fieldName == "data":
            return "ptr"
        if fieldName == "len":
            return "int32"
    let resultInner = TypedExprResultSuccessType(rootType)
    if resultInner != "":
        if fieldName == "ok":
            return "bool"
        if fieldName == "value":
            return resultInner
        if fieldName == "err":
            return "ErrorInfo"
    return ""

@borrows
fn TypedExprAssignStatementType(ctx: TypedExprSourceContext,
                                 sourceContexts: TypedExprSourceContext[],
                                 scope: TypedExprFunctionScope,
                                 lineNumber: int32,
                                 lhsRaw: str): str =
    let rootName = TypedExprAssignLhsRootName(lhsRaw)
    if rootName == "":
        return ""
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
    var rootType = ""
    let bindingIndex = TypedExprLookupBindingBestIndex(
        ctx, scopeIndex, lineNumber, rootName)
    if bindingIndex >= 0:
        rootType = ctx.bindings[bindingIndex].typeText
    if rootType == "":
        # Parameters are signature facts, not source-order local bindings.
        # Static call-argument typing must still resolve `param.field` before
        # overload selection (for example `Len(e.msg)` in result.IsError).
        rootType = TypedExprFunctionParamTypeInHeader(
            TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine),
            rootName)
    let fieldName = TypedExprAssignFieldName(lhsRaw)
    if fieldName == "":
        return rootType
    if rootType == "":
        return ""
    let fieldPath = TypedExprAssignFieldPath(lhsRaw)
    var fieldRootType = rootType
    if parser.ParserFindText(lhsRaw, "->") > 0:
        fieldRootType = TypedExprPointerPointeeType(ctx,
                                                    sourceContexts,
                                                    fieldRootType)
        if fieldRootType == "":
            return ""
    # Direct member typing does not require the owner's complete byte layout.
    # Overload resolution only needs the immutable declared field type; forcing
    # every sibling field to have a realizable layout makes a valid argument
    # such as `pool.index` fail before its exact declaration row is read.
    # Query the frozen declaration index first for a single direct member.
    if parser.ParserFindText(fieldPath, ".") < 0 &&
       parser.ParserFindText(fieldPath, "->") < 0:
        var declaredFieldRootType = TypedExprStripVarType(fieldRootType)
        if parser.ParserStartsWith(declaredFieldRootType, "ref") &&
           declaredFieldRootType.len > 3:
            let declaredPointee = chengpath.TextSlice(
                declaredFieldRootType, 3, declaredFieldRootType.len - 3)
            if TypedExprFieldContextLookup(ctx,
                                           sourceContexts,
                                           declaredPointee) != -1:
                declaredFieldRootType = declaredPointee
        let declaredContextIndex = TypedExprFieldContextLookup(
            ctx, sourceContexts, declaredFieldRootType)
        var declaredField: TypedExprTypeFieldDecl
        var declaredFieldFound = false
        if declaredContextIndex == -2:
            declaredFieldFound = TypedExprFindTypeFieldDecl(
                ctx, declaredFieldRootType, fieldPath, declaredField)
        elif declaredContextIndex >= 0:
            declaredFieldFound = TypedExprFindTypeFieldDecl(
                sourceContexts[declaredContextIndex],
                declaredFieldRootType,
                fieldPath,
                declaredField)
        if declaredFieldFound:
            return declaredField.fieldType
        if declaredContextIndex == -1:
            # Contexts typed through the binding-declaration index path
            # (TypedExprBuildSourceContextBorrowed) carry the immutable declared
            # field rows in ctx.typeFields while their owned build index holds
            # only call declarations, so the ctx_field_source lookup above
            # misses every local field and `param.field` static argument typing
            # fails closed (call declaration static argument type unavailable).
            # Read the same declaration rows directly: exact owner leaf +
            # field ident, and only a single distinct declared type qualifies.
            let directOwnerLeaf = TypedExprTypeLeafName(declaredFieldRootType)
            var directFieldType = ""
            var directFieldTypeSeen = false
            var directMatchAmbiguous = false
            for directFieldRowIndex in 0..<ctx.typeFields.len:
                let directFieldRow = ctx.typeFields[directFieldRowIndex]
                if TypedExprTypeLeafName(directFieldRow.ownerType) !=
                       directOwnerLeaf:
                    continue
                if parser.ParserIdentPrefix(
                       chengpath.PathTrim(directFieldRow.fieldName)) !=
                       fieldPath:
                    continue
                let directRowType =
                    TypedExprNormalizeTypeText(directFieldRow.fieldType)
                if !directFieldTypeSeen:
                    directFieldType = directRowType
                    directFieldTypeSeen = true
                elif directRowType != directFieldType:
                    directMatchAmbiguous = true
                    break
            if directFieldTypeSeen && !directMatchAmbiguous &&
               directFieldType != "":
                return directFieldType
    var resolvedFieldType = ""
    var resolvedOffset: int32
    var resolvedSize: int32
    var resolvedAlign: int32
    if TypedExprResolveFieldPathMeta(ctx,
                                     sourceContexts,
                                     fieldRootType,
                                     fieldPath,
                                     resolvedFieldType,
                                     resolvedOffset,
                                     resolvedSize,
                                     resolvedAlign):
        return resolvedFieldType
    # Fixed Result fields cover one member only.  Applying this fallback to a
    # deeper path such as `r.err.msg` would type the whole path as ErrorInfo.
    if parser.ParserFindText(fieldPath, ".") >= 0 ||
       parser.ParserFindText(fieldPath, "->") >= 0:
        return ""
    let fieldType = TypedExprAssignFieldType(fieldRootType, fieldName)
    if fieldType != "":
       return fieldType
    return ""

@borrows
fn TypedExprIrPopulateAssignLhsMeta(stmt: var TypedExprIrStatement,
                                     ctx: TypedExprSourceContext,
                                     sourceContexts: TypedExprSourceContext[],
                                     scope: TypedExprFunctionScope,
                                     lineNumber: int32,
    lhsRaw: str): str =
    let rootName = TypedExprAssignLhsRootName(lhsRaw)
    stmt.assignRootName = share(rootName)
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignFieldAlignBytes = 0
    if rootName == "":
        return ""
    let earlyFieldPath = TypedExprAssignFieldPath(lhsRaw)
    if sourceContexts.len <= 0 && earlyFieldPath != "":
        stmt.assignRootType = ""
        stmt.assignRootSourcePath = ctx.sourcePath
        stmt.assignRootGlobalFlag = false
        stmt.assignPlaceKind = TypedExprPlaceField
        stmt.assignFieldName = earlyFieldPath
        return ""
    let scopeIndex = TypedExprScopeIndexForLine(ctx.scopes, lineNumber)
    var rootType = ""
    var rootSourcePath = ""
    var rootGlobalFlag = false
    var rootMutableFlag = false
    var hasRootMeta = false
    let paramRootType = TypedExprFunctionParamTypeInHeader(TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine),
                                                           rootName)
    if paramRootType != "":
        rootType = paramRootType
        rootSourcePath = ctx.sourcePath
        rootGlobalFlag = false
        hasRootMeta = true
    if !hasRootMeta:
        hasRootMeta = TypedExprLookupBindingMeta(ctx,
                                                 scopeIndex,
                                                 lineNumber,
                                                 rootName,
                                                 rootType,
                                                 rootSourcePath,
                                                 rootGlobalFlag,
                                                 rootMutableFlag)
    if !hasRootMeta:
        rootType = TypedExprLookupBindingTypeIndexed(
            ctx, scopeIndex, lineNumber, rootName)
    stmt.assignRootType = share(rootType)
    stmt.assignRootSourcePath = rootSourcePath
    stmt.assignRootGlobalFlag = rootGlobalFlag
    if hasRootMeta:
        if rootGlobalFlag:
            stmt.assignPlaceKind = TypedExprPlaceGlobal
        else:
            stmt.assignPlaceKind = TypedExprPlaceLocal
    let fieldPath = TypedExprAssignFieldPath(lhsRaw)
    if fieldPath == "":
        return rootType
    stmt.assignFieldName = share(fieldPath)
    stmt.assignPlaceKind = TypedExprPlaceField
    var fieldRootType = share(rootType)
    # Indexed-root field LHS (`xs[i].field`): the field path is a member of the
    # *element* type, not of the seq/array root type. Resolving `field` against
    # `Row[]` misses (no struct named `Row[]`), leaving the field meta unset ->
    # the backend bails (bail_711). Strip to the element type so the field meta
    # (type/offset/size) resolves and the indexed element-address store fires.
    if TypedExprAssignLhsRootIsIndexed(lhsRaw):
        let elementRootType = TypedExprSeqArrayElementType(share(rootType))
        if elementRootType != "":
            fieldRootType = elementRootType
    if parser.ParserFindText(lhsRaw, "->") > 0:
        fieldRootType = TypedExprPointerPointeeType(
            ctx, sourceContexts, share(rootType))
    if fieldRootType == "":
        return ""
    var fieldType = ""
    var fieldOffset: int32
    var fieldSize: int32
    var fieldAlign: int32
    # Chained-dot indexed store `root.seqfield[idx].elemfield`: the fieldPath is
    # `seqfield[idx].elemfield`; the elem member resolves against the seq
    # *element* type, not the root struct. Resolve the seq field against rootType
    # to get the seq type, strip to the element type, then resolve elemfield
    # against that. The backend re-derives seqField offset + element-address
    # arithmetic from the unchanged assignFieldName (`seqfield[idx].elemfield`),
    # so no new stmt channel is needed; we only fill elemField type/offset/size
    # here so the 711 type-stable guard passes and the backend indexed-element
    # branch fires (bail_711 trigger: outline.points[idx].endContour).
    var resolvedFieldPath = share(fieldPath)
    var chainedSeqFieldName = ""
    var chainedSeqIndexText = ""
    var chainedElemFieldPath = ""
    if TypedExprAssignLhsFieldPathIndexedRoot(fieldPath,
                                              chainedSeqFieldName,
                                              chainedSeqIndexText,
                                              chainedElemFieldPath):
        var seqFieldType = ""
        var seqFieldOffset: int32
        var seqFieldSize: int32
        var seqFieldAlign: int32
        if TypedExprResolveFieldPathMeta(ctx,
                                         sourceContexts,
                                         rootType,
                                         chainedSeqFieldName,
                                         seqFieldType,
                                         seqFieldOffset,
                                         seqFieldSize,
                                         seqFieldAlign):
            let chainedElementType = TypedExprSeqArrayElementType(seqFieldType)
            if chainedElementType != "":
                fieldRootType = chainedElementType
                resolvedFieldPath = chainedElemFieldPath
    # Poison-on-miss: a bracket-indexed hop with a *trailing subfield*
    # surviving in resolvedFieldPath (`cols[j].a` behind an already-stripped
    # `rows[i].` hop, or behind a plain non-indexed prefix like
    # `row.cols[j].a`) cannot be resolved by the flat dotted-path walker
    # below -- it strips bracket suffixes per-segment via ParserIdentPrefix
    # and silently descends into the array's *element* type without ever
    # applying the index, which would return a valid-looking offset that
    # always targets element 0 (a silent miscompile: the write lands at a
    # constant offset regardless of the real runtime index). Refuse here so
    # assignFieldType stays "" and the backend's indexed-element recovery (or
    # its bail_711 poison) fires instead of this flat resolver's wrong
    # answer. Scoped to the *trailing-subfield* shape only (path does not end
    # in `]`) -- a bare indexed-element store with no subfield tail, e.g.
    # `out.x.limbs[i]` (bigint limb store), ends in `]` and is left alone:
    # it is not this bug (no dropped index to hide) and is already handled
    # correctly by the existing indexed-element-store path downstream.
    if parser.ParserFindText(resolvedFieldPath, "[") >= 0 &&
       resolvedFieldPath[resolvedFieldPath.len - 1] != ']':
        return ""
    if TypedExprResolveFieldPathMeta(ctx,
                                     sourceContexts,
                                     fieldRootType,
                                     resolvedFieldPath,
                                     fieldType,
                                     fieldOffset,
                                     fieldSize,
                                     fieldAlign):
        stmt.assignFieldType = share(fieldType)
        stmt.assignFieldOffsetBytes = fieldOffset
        stmt.assignFieldSizeBytes = fieldSize
        stmt.assignFieldAlignBytes = fieldAlign
        return fieldType
    fieldType = TypedExprAssignFieldType(fieldRootType, TypedExprAssignFieldName(lhsRaw))
    if fieldType != "":
        stmt.assignFieldType = share(fieldType)
        var sizeBytes: int32
        var alignBytes: int32
        if TypedExprTypeLayout(ctx, sourceContexts, fieldType, sizeBytes, alignBytes):
            stmt.assignFieldSizeBytes = sizeBytes
            stmt.assignFieldAlignBytes = alignBytes
        return fieldType
    return ""

@borrows
fn TypedExprIrFieldHopIsInlineAggregate(
    ir: TypedExprIr,
    ownerSourcePath: str,
    typeRaw: str,
    expectedSizeBytes: int32,
    expectedAlignBytes: int32
): bool =
    let typeText = TypedExprNormalizeTypeText(TypedExprStripVarType(typeRaw))
    if typeText == "" || expectedSizeBytes <= 0 || expectedAlignBytes <= 0:
        return false
    if (typeText.len >= 2 &&
        chengpath.TextSlice(typeText, typeText.len - 2, 2) == "[]") ||
       parser.ParserStartsWith(typeText, "seq[") ||
       parser.ParserStartsWith(typeText, "array[") ||
       parser.ParserStartsWith(typeText, "ref ") ||
       parser.ParserStartsWith(typeText, "ref[") ||
       parser.ParserStartsWith(typeText, "ptr[") ||
       parser.ParserStartsWith(typeText, "pointer[") ||
       typeText == "ptr" || typeText == "cstring" || typeText == "owned_cstring" ||
       (typeText.len > 0 && typeText[typeText.len - 1] == '*') ||
       TypedExprIrTypeIsRef(ir, ownerSourcePath, typeText):
        return false
    let aliasTarget = TypedExprIrLookupTypeDefAliasTargetType(
        ir, ownerSourcePath, typeText)
    if aliasTarget != "" &&
       TypedExprNormalizeTypeText(aliasTarget) != typeText:
        return TypedExprIrFieldHopIsInlineAggregate(ir,
                                                     ownerSourcePath,
                                                     aliasTarget,
                                                     expectedSizeBytes,
                                                     expectedAlignBytes)
    var layoutSize: int32
    var layoutAlign: int32
    var layoutFieldCount: int32
    return TypedExprIrLookupTypeLayout(ir,
                                       ownerSourcePath,
                                       typeText,
                                       layoutSize,
                                       layoutAlign,
                                       layoutFieldCount) &&
           layoutFieldCount > 0 &&
           layoutSize == expectedSizeBytes &&
           layoutAlign == expectedAlignBytes

# Populate RHS field authority from the already-built value-node graph. Offset
# folding is legal only while every intermediate field is an inline aggregate
# in the same base allocation; ref/pointer/sequence hops require structured
# evaluation and are rejected here instead of being flattened.
fn TypedExprIrPopulateAssignValueFieldMetaFromRhsNode(
    stmt: var TypedExprIrStatement,
    ir: var TypedExprIr
) =
    let fieldNodeIndex = stmt.rhsNodeIndex
    if fieldNodeIndex < 0 || fieldNodeIndex >= ir.nodes2_nodeIndexs.len ||
       ir.nodes2_opKinds[fieldNodeIndex] != TypedExprIrOpFieldGet:
        return
    let fieldTypeRes: Result[str] = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_resultTypeIds[fieldNodeIndex])
    if !IsOk(fieldTypeRes):
        panic("typed expr: RHS field result type unavailable")
    let fieldType = Value(fieldTypeRes)
    let fieldSize = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_fieldSizeBytes,
        fieldNodeIndex)
    let fieldAlign = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.nodes2_fieldAlignBytes,
        fieldNodeIndex)
    if fieldType == "" || fieldSize <= 0 || fieldAlign <= 0:
        panic(Fmt"typed expr: RHS field layout unavailable source={stmt.sourcePath} line={stmt.lineNumber} type={fieldType} node_size={fieldSize} node_align={fieldAlign}")
    var fieldParts: str[]
    var visitedFieldNodes: int32[]
    var hopNodeIndex = fieldNodeIndex
    var totalOffset: int64
    var outermostHop = true
    while hopNodeIndex >= 0 && hopNodeIndex < ir.nodes2_nodeIndexs.len &&
          ir.nodes2_opKinds[hopNodeIndex] == TypedExprIrOpFieldGet:
        for visitedIndex in 0..<visitedFieldNodes.len:
            if visitedFieldNodes[visitedIndex] == hopNodeIndex:
                panic(Fmt"typed expr: cyclic RHS field graph source={stmt.sourcePath} line={stmt.lineNumber}")
        add(visitedFieldNodes, hopNodeIndex)
        let hopOffset = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_fieldOffsetBytes,
            hopNodeIndex)
        let hopSize = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_fieldSizeBytes,
            hopNodeIndex)
        let hopAlign = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_fieldAlignBytes,
            hopNodeIndex)
        let hopNameRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.nodes2_literalTextIds[hopNodeIndex])
        if hopOffset < 0 || hopSize <= 0 || hopAlign <= 0 || !IsOk(hopNameRes) ||
           Value(hopNameRes) == "":
            panic(Fmt"typed expr: RHS field hop authority invalid source={stmt.sourcePath} line={stmt.lineNumber}")
        if !outermostHop:
            let hopTypeRes: Result[str] = langintern.LookupIntern(
                ir.internPool,
                ir.nodes2_resultTypeIds[hopNodeIndex])
            let hopTypeSourceRes: Result[str] = langintern.LookupIntern(
                ir.internPool,
                ir.nodes2_fieldTypeSourcePathIds[hopNodeIndex])
            if !IsOk(hopTypeRes) || !IsOk(hopTypeSourceRes) ||
               !TypedExprIrFieldHopIsInlineAggregate(
                   ir,
                   Value(hopTypeSourceRes),
                   Value(hopTypeRes),
                   hopSize,
                   hopAlign):
                return
        totalOffset = totalOffset + int64(hopOffset)
        if totalOffset > int64(2147483647):
            panic(Fmt"typed expr: RHS field offset overflow source={stmt.sourcePath} line={stmt.lineNumber}")
        add(fieldParts, Value(hopNameRes))
        hopNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_operand0NodeIndexs,
            hopNodeIndex)
        outermostHop = false
    if hopNodeIndex < 0 || hopNodeIndex >= ir.nodes2_nodeIndexs.len ||
       (ir.nodes2_opKinds[hopNodeIndex] != TypedExprIrOpLocalRef &&
        ir.nodes2_opKinds[hopNodeIndex] != TypedExprIrOpParamRef):
        return
    let rootNameRes: Result[str] = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_paramNameIds[hopNodeIndex])
    let rootSurfaceRes: Result[str] = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_surfaceTextIds[hopNodeIndex])
    let rootTypeRes: Result[str] = langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_resultTypeIds[hopNodeIndex])
    if !IsOk(rootNameRes) || !IsOk(rootSurfaceRes) || !IsOk(rootTypeRes):
        panic(Fmt"typed expr: RHS field root authority unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
    var rootName = Value(rootNameRes)
    if rootName == "":
        rootName = chengpath.PathTrim(Value(rootSurfaceRes))
    let rootType = Value(rootTypeRes)
    if rootName == "" || rootType == "":
        panic(Fmt"typed expr: RHS field root identity missing source={stmt.sourcePath} line={stmt.lineNumber}")
    var fieldPath = ""
    var partIndex = fieldParts.len - 1
    while partIndex >= 0:
        if fieldPath == "":
            fieldPath = fieldParts[partIndex]
        else:
            fieldPath = Fmt"{fieldPath}.{fieldParts[partIndex]}"
        partIndex = partIndex - 1
    stmt.assignValueRootName = rootName
    stmt.assignValueRootType = rootType
    stmt.assignValueFieldName = fieldPath
    stmt.assignValueFieldType = fieldType
    stmt.assignValueFieldOffsetBytes = int32(totalOffset)
    stmt.assignValueFieldSizeBytes = fieldSize
    stmt.assignValueFieldAlignBytes = fieldAlign

@borrows
fn TypedExprControlStatementKindFromExpr(expr: parser.NormalizedExpr): TypedExprIrStatementKind =
    if expr.kind == parser.NormalizedExprIfStmt:
        return TypedExprIrStmtIf
    if expr.kind == parser.NormalizedExprElifStmt:
        return TypedExprIrStmtElif
    if expr.kind == parser.NormalizedExprElseStmt:
        return TypedExprIrStmtElse
    if expr.kind == parser.NormalizedExprForStmt:
        return TypedExprIrStmtFor
    if expr.kind == parser.NormalizedExprMatchStmt:
        return TypedExprIrStmtMatch
    if expr.kind == parser.NormalizedExprCaseStmt:
        return TypedExprIrStmtCase
    if expr.kind == parser.NormalizedExprWhileStmt:
        return TypedExprIrStmtWhile
    if expr.kind == parser.NormalizedExprDeferStmt:
        return TypedExprIrStmtDefer
    if expr.kind == parser.NormalizedExprBreakStmt:
        return TypedExprIrStmtBreak
    if expr.kind == parser.NormalizedExprContinueStmt:
        return TypedExprIrStmtContinue
    return TypedExprIrStmtUnsupported

@borrows
fn TypedExprForBindingNameFromHeader(headerRaw: str): str =
    var header = chengpath.PathTrim(share(headerRaw))
    if parser.ParserStartsWith(header, "for "):
        header = chengpath.PathTrim(chengpath.TextSlice(header, 4, header.len - 4))
    let inPos = parser.ParserFindText(header, " in ")
    if inPos <= 0:
        return ""
    return parser.ParserIdentPrefix(chengpath.PathTrim(chengpath.TextSlice(header,
                                                                           0,
                                                                           inPos)))

@borrows
fn TypedExprForHeaderRangeBounds(headerRaw: str,
                                  startText: var str,
                                  endText: var str): bool =
    startText = ""
    endText = ""
    var header = chengpath.PathTrim(share(headerRaw))
    if header.len > 0 && header[header.len - 1] == ':':
        header = chengpath.PathTrim(chengpath.TextSlice(header, 0, header.len - 1))
    let inPos = parser.ParserFindText(header, " in ")
    if inPos <= 0:
        return false
    let rangeText = chengpath.PathTrim(chengpath.TextSlice(header,
                                                           inPos + 4,
                                                           header.len - inPos - 4))
    let rangeOpenPos = TypedExprFindWholeCallOpenParen(rangeText)
    if rangeOpenPos > 0 &&
       TypedExprFindMatchingParen(rangeText, rangeOpenPos) == rangeText.len - 1:
        let rangeHead = chengpath.PathTrim(chengpath.TextSlice(rangeText, 0, rangeOpenPos))
        if rangeHead == "range":
            let argsText = TypedExprSliceTrim(rangeText,
                                              rangeOpenPos + 1,
                                              rangeText.len - rangeOpenPos - 2)
            let args = TypedExprSplitTopLevelCsv(argsText)
            if args.len == 1:
                startText = "0"
                endText = chengpath.PathTrim(share(args[0]))
                return endText != ""
            if args.len == 2:
                startText = chengpath.PathTrim(share(args[0]))
                endText = chengpath.PathTrim(share(args[1]))
                return startText != "" && endText != ""
            return false
    var dotPos = parser.ParserFindText(rangeText, "..<")
    var dotLen = 3
    if dotPos < 0:
        dotPos = parser.ParserFindText(rangeText, "..")
        dotLen = 2
    if dotPos <= 0:
        return false
    startText = chengpath.PathTrim(chengpath.TextSlice(rangeText, 0, dotPos))
    endText = chengpath.PathTrim(chengpath.TextSlice(rangeText,
                                                     dotPos + dotLen,
                                                     rangeText.len - dotPos - dotLen))
    return startText != "" && endText != ""

# match/case lowering: a `match scrutinee:` arm `Label => body` is semantically
# `if scrutinee == Label: body` (subsequent arms become elif). The pure-node
# backend has no match-statement dispatch (the if/elif chain on the enum
# discriminant IS the dispatch), so we rewrite case headers into if/elif at IR
# construction time. The first arm under a given match becomes `if`, the rest
# `elif`. The match scrutinee is found by scanning back to the nearest enclosing
# (shallower-indent) Match statement; an earlier sibling case at the same indent
# under that match means this case is an elif.
#
# Returns the rewritten condition text `scrutinee == Label` and sets isFirstArm.
# Returns "" when this case is not a plain no-payload enum arm under a match
# (payload-binding patterns `Some(x) =>` are left as Case for honest STOP, never
# silently miscompiled into a discriminant compare that drops the binding).
fn TypedExprIrMatchCaseRewriteCondition(ir: var TypedExprIr,
                                         caseLabelRaw: str,
                                         caseIndent: int32,
                                         isFirstArm: var bool): str =
    isFirstArm = true
    let caseLabel = chengpath.PathTrim(caseLabelRaw)
    if caseLabel == "":
        return ""
    # default arm (`_`/`else`) is not an equality compare; leave it unhandled
    # rather than synthesize a bogus `scrutinee == _` test.
    if caseLabel == "_" || caseLabel == "else":
        return ""
    # payload-binding arm (`Variant(bind)`) is not a discriminant-only compare;
    # leave it unhandled rather than drop the binding.
    if parser.ParserFindText(caseLabel, "(") >= 0:
        return ""
    if !TypedExprIrStatements2ShapeComplete(ir):
        panic("typed expr: match/case statement index shape incomplete")
    var scrutinee = ""
    var scanI = ir.statements2_statementIndexs.len - 1
    while scanI >= 0:
        let scanIndent = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_lineIndents, scanI)
        let scanKind = ir.statements2_kinds[scanI]
        if scanIndent >= caseIndent:
            # a prior arm of the same match is itself a sibling at >= our indent
            # only when at the exact case indent and already rewritten to if/elif;
            # but to find the match we only care about shallower-indent rows, so
            # skip equal/deeper rows here and keep scanning outward.
            if scanIndent == caseIndent &&
               (scanKind == TypedExprIrStmtIf ||
                scanKind == TypedExprIrStmtElif):
                let resultType = langintern.LookupIntern(
                    ir.internPool, ir.statements2_resultTypeIds[scanI])
                if !IsOk(resultType):
                    panic("typed expr: match/case result type unavailable")
                if Value(resultType) == "bool":
                    # an earlier sibling arm (already rewritten) => this is an elif,
                    # but only if it belongs to the same match (no intervening
                    # shallower-indent Match boundary). Mark tentatively; the match
                    # scan below confirms the scrutinee.
                    isFirstArm = false
            scanI = scanI - 1
            continue
        # first shallower-indent row: must be the enclosing Match.
        if scanKind == TypedExprIrStmtMatch:
            let surfaceText = langintern.LookupIntern(
                ir.internPool, ir.statements2_surfaceTextIds[scanI])
            if !IsOk(surfaceText):
                panic("typed expr: match/case surface text unavailable")
            scrutinee = chengpath.PathTrim(
                strings.CloneStr(Value(surfaceText)))
        break
    if scrutinee == "":
        return ""
    return parser.ParserConcat3(parser.ParserOwnedText(scrutinee),
                                " == ",
                                parser.ParserOwnedText(caseLabel))

@borrows
fn TypedExprIrAddControlStatementFromExpr(ir: var TypedExprIr,
                                           ctx: var TypedExprSourceContext,
                                           sourceContexts: TypedExprSourceContext[],
                                           scope: TypedExprFunctionScope,
                                           expr: parser.NormalizedExpr,
                                           lineIndent: int32,
                                           enclosingIfLineNumber: int32,
                                           enclosingIfConditionText: str): int32 =
    var statementKind = TypedExprControlStatementKindFromExpr(expr)
    var caseRewriteCondition = ""
    var caseRewriteIsFirstArm = true
    if statementKind == TypedExprIrStmtCase:
        caseRewriteCondition = TypedExprIrMatchCaseRewriteCondition(ir,
                                                                    chengpath.PathTrim(expr.surfaceText),
                                                                    lineIndent,
                                                                    caseRewriteIsFirstArm)
        if caseRewriteCondition != "":
            if caseRewriteIsFirstArm:
                statementKind = TypedExprIrStmtIf
            else:
                statementKind = TypedExprIrStmtElif
    if statementKind == TypedExprIrStmtUnsupported:
        return -1
    var stmt: TypedExprIrStatement
    stmt.rhsNodeIndex = -1
    stmt.rhsBailReason = RhsBailNone
    # P1 hint hygiene mirror (sibling of 17946): 清空 hint 防上一个 stmt
    # 的 5680/16001 producer 信号污染本 stmt 分类.
    let _21454hint = TypedExprIrConsumeRhsBailHint()
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.bindingTargetDefinitionRow = -1
    stmt.assignIndexNodeIndex = -1
    stmt.sourcePath = share(expr.sourcePath)
    stmt.functionName = share(scope.name)
    stmt.statementIndex = ir.statements2_statementIndexs.len
    TypedExprIrSetStatementLocationFromExpr(stmt, expr)
    stmt.lineIndent = lineIndent
    stmt.enclosingIfLineNumber = enclosingIfLineNumber
    stmt.enclosingIfConditionText = share(enclosingIfConditionText)
    stmt.exprId = TypedExprExprStableId(expr)
    stmt.kind = statementKind
    stmt.callKind = TypedExprCallNone
    stmt.detailKind = expr.detailKind
    stmt.surfaceText = chengpath.PathTrim(expr.surfaceText)
    if caseRewriteCondition != "":
        # case arm rewritten to if/elif: surface the synthesized condition so the
        # node-condition builder below sees `scrutinee == Label`.
        if statementKind == TypedExprIrStmtElif:
            stmt.surfaceText = parser.ParserConcat2("elif ", parser.ParserOwnedText(caseRewriteCondition))
        else:
            stmt.surfaceText = parser.ParserConcat2("if ", parser.ParserOwnedText(caseRewriteCondition))
    stmt.bindingName = ""
    if statementKind == TypedExprIrStmtFor:
        stmt.bindingName = TypedExprForBindingNameFromHeader(stmt.surfaceText)
    stmt.resultType = ""
    if statementKind == TypedExprIrStmtIf ||
       statementKind == TypedExprIrStmtElif ||
       statementKind == TypedExprIrStmtWhile:
        stmt.resultType = "bool"
    elif statementKind == TypedExprIrStmtFor:
        stmt.resultType = "range"
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignFieldAlignBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueFieldAlignBytes = 0
    stmt.assignValueOpKind = TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.assignValueRhsConst = 0
    stmt.assignValueRhsHasConst = false
    stmt.callQualifier = ""
    stmt.callCallee = ""
    stmt.callTarget = ""
    stmt.callTargetSourcePath = ""
    stmt.callTargetImportc = false
    stmt.callArgCount = 0
    stmt.callArgsText = ""
    stmt.callArgTypesText = ""
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    stmt.loweringMode = TypedExprLowerDeferred
    stmt.returnKind = TypedExprReturnDeferred
    stmt.returnRoot = false
    TypedExprIrPopulateConditionMeta(stmt, ir, ctx, sourceContexts, expr.lineNumber)
    if statementKind == TypedExprIrStmtIf ||
       statementKind == TypedExprIrStmtElif ||
       statementKind == TypedExprIrStmtWhile:
        # Real if/elif/while conditions own a parser Condition root (Binary
        # `==` with Identifier children). Build from that tree so LocalRef
        # carries parser origin. Case-rewritten surfaces stay on the text
        # path: they have no Identifier for the synthesized comparison.
        if caseRewriteCondition == "" &&
           stmt.valueExprRootNodeIndex >= 0 &&
           stmt.valueExprStatementRole ==
               parser.ParserValueExprStatementCondition:
            stmt.rhsNodeIndex = TypedExprIrBuildStatementValueRoot(
                ir,
                ctx,
                sourceContexts,
                share(scope),
                stmt,
                share(stmt.resultType))
        elif caseRewriteCondition == "" &&
             stmt.valueExprRootNodeIndex >= 0:
            # B16 包含绑定把表达式位的 if/elif/while 关键字种子
            # (NormalizedExprIfStmt 在三元/绑定初式内) 绑到外围语句根事件,
            # 取得外围 role(BindingInitializer/AssignmentRhs/ReturnValue) 与
            # root>=0 而 role!=Condition。该 if 不是独立控制语句 —— 外围语句
            # 已结构化构建整棵表达式树; 文本回退会以空 originParserNodeStack
            # 追加 LocalRef 节点, 撞 TypedExprIrAppendNode 的 origin 硬审计
            # (typed_expr.cheng:6432)。此处不追加语句、不落节点, 返回 -1
            # (fail-closed, 不放宽 origin 审计)。
            return -1
        else:
            let conditionNodeText = TypedExprIrStatementConditionNodeText(stmt.surfaceText)
            if conditionNodeText != "":
                stmt.rhsNodeIndex = TypedExprIrBuildExprNodeWithExpectedType(ir,
                                                                             ctx,
                                                                             sourceContexts,
                                                                             share(scope),
                                                                             expr.lineNumber,
                                                                             conditionNodeText,
                                                                             "bool")
    elif statementKind == TypedExprIrStmtFor:
        var forStartText = ""
        var forEndText = ""
        if TypedExprForHeaderRangeBounds(stmt.surfaceText, forStartText, forEndText):
            stmt.rhsNodeIndex = TypedExprIrBuildExprNodeWithExpectedType(ir,
                                                                         ctx,
                                                                         sourceContexts,
                                                                         share(scope),
                                                                         expr.lineNumber,
                                                                         forEndText,
                                                                         "int32")
            stmt.forStartNodeIndex = TypedExprIrBuildExprNodeWithExpectedType(ir,
                                                                              ctx,
                                                                              sourceContexts,
                                                                              share(scope),
                                                                              expr.lineNumber,
                                                                              forStartText,
                                                                              "int32")
    TypedExprIrBindDirectCallAuthorityFromRhsNode(ir, stmt)
    let statementIndex = stmt.statementIndex
    TypedExprIrAppendStatement(ir, stmt)
    TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
    return statementIndex

@borrows
fn TypedExprAssignRhsTextWithContinuation(ctx: TypedExprSourceContext,
                                           lineNumber: int32,
                                           rhsTextRaw: str): str =
    let rhsText = chengpath.PathTrim(rhsTextRaw)
    if !TypedExprRhsTextHasTrailingBinaryOperator(rhsText):
        return rhsText
    if lineNumber <= 0 ||
       lineNumber > TypedExprSourceContextLineCount(ctx):
        return rhsText
    let lineRaw = TypedExprSourceContextLineText(ctx, lineNumber)
    var bindingName = ""
    var bindingType = ""
    var rhsStartColumn: int32 = -1
    if !TypedExprParseBindingLine(lineRaw, bindingName, bindingType, rhsStartColumn):
        return rhsText
    let packedLineIndex = TypedExprSourceContextLineIndex(ctx, lineNumber)
    if packedLineIndex < 0:
        return rhsText
    let joined = TypedExprBindingRhsTextWithContinuation(
        ctx, packedLineIndex, rhsStartColumn)
    if joined == "" || TypedExprRhsTextHasTrailingBinaryOperator(joined):
        return rhsText
    return joined

@borrows
fn TypedExprIrAddAssignStatementFromExpr(ir: var TypedExprIr,
                                          ctx: var TypedExprSourceContext,
                                          sourceContexts: TypedExprSourceContext[],
                                          scope: TypedExprFunctionScope,
                                          expr: parser.NormalizedExpr,
                                          lineIndent: int32,
                                          enclosingIfLineNumber: int32,
                                          enclosingIfConditionText: str): int32 =
    TypedExprTraceLine("typed_ir_assign:enter")
    let isBindingInitializer = expr.valueExprStatementRole ==
        parser.ParserValueExprStatementBindingInitializer
    if isBindingInitializer &&
       !TypedExprAssignLhsHasDeclPrefix(expr.surfaceText):
        panic("typed expr: binding initializer has no declaration lhs")
    TypedExprTraceLine("typed_ir_assign:before_lhs")
    let lhsText = TypedExprAssignCanonicalLhsText(share(expr.surfaceText))
    TypedExprTraceLine("typed_ir_assign:after_lhs")
    TypedExprTraceLine("typed_ir_assign:before_rhs")
    var rhsText = ""
    if ir.valueExprTree != nil && ir.valueExprTreeBorrowLease:
        if expr.valueExprRootNodeIndex < 0 ||
           expr.valueExprStatementRole ==
               parser.ParserValueExprStatementInvalid:
            panic(Fmt"typed expr: assignment parser root missing source={ctx.sourcePath} function={scope.name} line={expr.lineNumber} lhs={expr.surfaceText}")
        rhsText = TypedExprIrStatementValueRootText(
            ir,
            expr.valueExprRootNodeIndex,
            expr.valueExprSpanStart,
            expr.valueExprSpanEnd,
            expr.valueExprStatementRole)
    else:
        # Treeless layer: the parser stores the assignment RHS text in
        # callArgsText; keep the exact pre-migration continuation behavior.
        rhsText = TypedExprAssignRhsTextWithContinuation(ctx,
                                                         expr.lineNumber,
                                                         share(expr.callArgsText))
    TypedExprTraceLine("typed_ir_assign:after_rhs")
    if lhsText == "" || rhsText == "":
        TypedExprTraceLine("typed_ir_assign:empty")
        return -1
    # Desugar non-integer-key subscript assignment `root[key] = val` into a
    # call to the `[]=` operator: `\`[]=\`(root, key, val)`.  The integer-key
    # path (e.g. `arr[i] = v`) is left as a plain assign for the backend's
    # IndexedStore lowering.  Only attempt when sourceContexts are present so
    # the operator can be resolved across imported modules (e.g. json.cheng).
    if sourceContexts.len > 0 &&
       lhsText.len >= 4 &&
       lhsText[lhsText.len - 1] == ']':
        # Find the outermost `[` in lhsText (not inside parens or nested brackets)
        var subOpen: int32 = -1
        var subDepth: int32
        var subParenDepth: int32
        for subScan in 0..<lhsText.len:
            let subCh = lhsText[subScan]
            if subCh == '(':
                subParenDepth = subParenDepth + 1
            elif subCh == ')':
                subParenDepth = subParenDepth - 1
            elif subParenDepth == 0:
                if subCh == '[':
                    if subDepth == 0 && subOpen < 0:
                        subOpen = subScan
                    subDepth = subDepth + 1
                elif subCh == ']':
                    subDepth = subDepth - 1
        if subOpen > 0 &&
           subDepth == 0:
            let subRoot = chengpath.PathTrim(chengpath.TextSlice(lhsText, 0, subOpen))
            let subIndex = chengpath.PathTrim(chengpath.TextSlice(lhsText,
                                                                   subOpen + 1,
                                                                   lhsText.len - subOpen - 2))
            if subRoot != "" && subIndex != "" &&
               !TypedExprIrIsI32ConstLiteral(subIndex):
                # Check if index is a string literal or a str-typed variable
                let subIndexIsStr = TypedExprIrRhsTextIsStringLiteral(subIndex) ||
                                    TypedExprLookupBindingTypeIndexed(
                                        ctx,
                                        TypedExprScopeIndexForLine(
                                            ctx.scopes, expr.lineNumber),
                                        expr.lineNumber,
                                        subIndex) == "str"
                if subIndexIsStr:
                    # Look up `[]=` in imported modules
                    var setBrackSourcePath = ""
                    var setBrackImportc = false
                    let setBrackArgsText = parser.ParserConcat3(
                        parser.ParserConcat3(parser.ParserOwnedText(subRoot),
                                             ", ",
                                             parser.ParserOwnedText(subIndex)),
                        ", ",
                        parser.ParserOwnedText(rhsText))
                    let _ = TypedExprLookupUnqualifiedImportedFunctionReturnType(ctx,
                                                                                       sourceContexts,
                                                                                       "[]=",
                                                                                       setBrackArgsText,
                                                                                       expr.lineNumber,
                                                                                       setBrackSourcePath,
                                                                                       setBrackImportc)
                    if setBrackSourcePath != "" && !setBrackImportc:
                        # Emit a Call statement to `[]=`(root, key, val)
                        var callStmt: TypedExprIrStatement
                        callStmt.rhsNodeIndex = -1
                        callStmt.forStartNodeIndex = -1
                        callStmt.assignLvalueNodeIndex = -1
                        callStmt.assignIndexNodeIndex = -1
                        callStmt.bindingTargetDefinitionRow = -1
                        callStmt.sourcePath = share(expr.sourcePath)
                        callStmt.functionName = share(scope.name)
                        callStmt.statementIndex = ir.statements2_statementIndexs.len
                        TypedExprIrSetStatementLocationFromExpr(callStmt, expr)
                        callStmt.lineIndent = lineIndent
                        callStmt.enclosingIfLineNumber = enclosingIfLineNumber
                        callStmt.enclosingIfConditionText = share(enclosingIfConditionText)
                        callStmt.exprId = TypedExprExprStableId(expr)
                        callStmt.kind = TypedExprIrStmtCall
                        callStmt.callKind = TypedExprCallNone
                        callStmt.detailKind = parser.NormalizedExprDetailNone
                        callStmt.surfaceText = "[]="
                        callStmt.bindingName = ""
                        callStmt.resultType = "void"
                        callStmt.conditionKind = TypedExprIrCondNone
                        callStmt.conditionLhsText = ""
                        callStmt.conditionRhsText = ""
                        callStmt.conditionLiteralText = ""
                        callStmt.assignRootName = ""
                        callStmt.assignRootType = ""
                        callStmt.assignRootSourcePath = ""
                        callStmt.assignRootGlobalFlag = false
                        callStmt.assignPlaceKind = TypedExprPlaceTemporary
                        callStmt.assignFieldName = ""
                        callStmt.assignFieldType = ""
                        callStmt.assignFieldOffsetBytes = 0
                        callStmt.assignFieldSizeBytes = 0
                        callStmt.assignFieldAlignBytes = 0
                        callStmt.assignValueRootName = ""
                        callStmt.assignValueRootType = ""
                        callStmt.assignValueFieldName = ""
                        callStmt.assignValueFieldType = ""
                        callStmt.assignValueFieldOffsetBytes = 0
                        callStmt.assignValueFieldSizeBytes = 0
                        callStmt.assignValueFieldAlignBytes = 0
                        callStmt.assignValueOpKind = TypedExprIrOpUnsupported
                        callStmt.assignValueLhsText = ""
                        callStmt.assignValueRhsText = ""
                        callStmt.assignValueRhsConst = 0
                        callStmt.assignValueRhsHasConst = false
                        callStmt.callQualifier = ""
                        callStmt.callCallee = "[]="
                        callStmt.callTarget = "[]="
                        callStmt.callTargetSourcePath = setBrackSourcePath
                        callStmt.callTargetImportc = false
                        callStmt.callSurfaceKind = CallSurfaceIndexed
                        callStmt.callArgCount = 3
                        callStmt.callArgsText = setBrackArgsText
                        callStmt.callArgTypesText = ""
                        callStmt.callArgNodeStart = -1
                        callStmt.callArgNodeCount = 0
                        callStmt.loweringMode = TypedExprLowerLocalAddress
                        callStmt.returnKind = TypedExprReturnDeferred
                        callStmt.returnRoot = false
                        let callStatementIndex = callStmt.statementIndex
                        TypedExprIrAppendStatement(ir, callStmt)
                        TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
                        return callStatementIndex
    TypedExprTraceLine("typed_ir_assign:before_stmt_init")
    var stmt: TypedExprIrStatement
    stmt.rhsNodeIndex = -1
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.bindingTargetDefinitionRow = -1
    stmt.assignIndexNodeIndex = -1
    stmt.sourcePath = share(expr.sourcePath)
    stmt.functionName = share(scope.name)
    stmt.statementIndex = ir.statements2_statementIndexs.len
    TypedExprIrSetStatementLocationFromExpr(stmt, expr)
    stmt.lineIndent = lineIndent
    stmt.enclosingIfLineNumber = enclosingIfLineNumber
    stmt.enclosingIfConditionText = share(enclosingIfConditionText)
    stmt.exprId = TypedExprExprStableId(expr)
    if isBindingInitializer:
        stmt.kind = TypedExprIrStmtLocalDecl
    else:
        stmt.kind = TypedExprIrStmtAssign
    stmt.callKind = TypedExprCallNone
    stmt.detailKind = expr.detailKind
    stmt.surfaceText = rhsText
    stmt.bindingName = share(lhsText)
    stmt.conditionKind = TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    TypedExprTraceLine("typed_ir_assign:before_lhs_meta")
    if isBindingInitializer:
        stmt.resultType = TypedExprBindingDeclaredTypeFromLhs(
            expr.surfaceText)
        if stmt.resultType == "":
            stmt.resultType = TypedExprLookupBindingTypeIndexed(
                ctx,
                TypedExprScopeIndexForLine(ctx.scopes, expr.lineNumber),
                expr.lineNumber,
                lhsText)
        stmt.assignPlaceKind = TypedExprPlaceTemporary
    else:
        stmt.resultType = TypedExprIrPopulateAssignLhsMeta(stmt,
                                                           ctx,
                                                           sourceContexts,
                                                           share(scope),
                                                           expr.lineNumber,
                                                           share(lhsText))
    if stmt.resultType == "":
        let localBindingType = TypedExprIrLookupLocalBindingType(ir,
                                                                 expr.sourcePath,
                                                                 scope.name,
                                                                 expr.lineNumber + 1,
                                                                 lhsText)
        if localBindingType != "":
            stmt.resultType = share(localBindingType)
            stmt.assignRootType = localBindingType
            stmt.assignRootSourcePath = share(expr.sourcePath)
            stmt.assignRootGlobalFlag = false
            stmt.assignPlaceKind = TypedExprPlaceLocal
    TypedExprTraceLine("typed_ir_assign:after_lhs_meta")
    if stmt.resultType == "":
        stmt.resultType = "unknown"
    if !isBindingInitializer:
        # The assignment LHS is built from the canonical LHS text, not by
        # walking the value-expr tree, so — unlike the RHS statement-root
        # builder — it runs with an empty originParserNodeStack and every
        # appended LHS node (LocalRef root and FieldGet hops alike) fails the
        # TypedExprIrAppendNode parser-origin audit. While the tree lease is
        # held, push the assignment statement's in-tree root (role
        # AssignmentRhs; the parser-root guard above pins it non-negative) so
        # LHS nodes carry the exact same source-local parser identity the RHS
        # path pushes at the statement-root builder. Treeless sessions keep
        # the pre-migration behavior unchanged.
        let pushLhsOrigin = ir.valueExprTree != nil &&
            ir.valueExprTreeBorrowLease
        let lhsBuildNodeStart = ir.nodes2_nodeIndexs.len
        if pushLhsOrigin:
            add(ir.originParserNodeStack,
                parser.ParserValueExprNodeSourceLocalIndexAt(
                    ir.valueExprTree, expr.valueExprRootNodeIndex))
        # wall31: tree 会话 LHS 构建窗口内, 参数名读发 fresh 引用副本
        # (见 typedExprIrAddLhsFreshParamRefNode); treeless 会话保持
        # 迁移前逐字节行为。
        typedExprLhsFreshParamRefActive = pushLhsOrigin
        stmt.assignLvalueNodeIndex =
            TypedExprIrBuildExprNodeWithExpectedType(
                ir,
                ctx,
                sourceContexts,
                share(scope),
                expr.lineNumber,
                share(lhsText),
                share(stmt.resultType))
        typedExprLhsFreshParamRefActive = false
        if pushLhsOrigin:
            setLen(ir.originParserNodeStack,
                   ir.originParserNodeStack.len - 1)
        # The canonical LHS text is a desugared surface, not a parser value
        # expression: the assignment statement root is the RHS expression
        # only (role AssignmentRhs), so the LHS identifier has no in-tree
        # node, no Pattern row and no resolvable binding identity. wall20's
        # origin push stamped such LocalRef nodes with the RHS root's
        # source-local identity, which the strict binding audit
        # (TypedExprIdentifierBindingAuthorityStrictValidateInto) rightly
        # rejects: a source-backed LocalRef must carry its exact binding
        # identity, and none exists to fill. The honest proof for a
        # text-built LocalRef is the synthetic desugared spelling (same
        # contract as TypedExprIrAddDesugaredLeafNode): no parser origin,
        # Desugared synthetic kind, NoSource span authority. Every node
        # appended inside this LHS build window is re-proofed — the builder
        # falls back across text shapes, so retry orphans as well as the
        # final root must stop claiming a parser identity they cannot
        # back. Exact-binding nodes (ParamRef shared definition nodes, or
        # any LocalRef that already carries binding identity) stay
        # untouched.
        if pushLhsOrigin:
            var lhsNodeScan = lhsBuildNodeStart
            while lhsNodeScan < ir.nodes2_nodeIndexs.len:
                if ir.nodes2_opKinds[lhsNodeScan] ==
                       TypedExprIrOpLocalRef &&
                       arenamod.ArenaArrayInt32Get(
                           ir.arena,
                           ir.nodes2_bindingParserNodeIndexes,
                           lhsNodeScan) == -1 &&
                       arenamod.ArenaArrayInt32Get(
                           ir.arena,
                           ir.nodes2_bindingParserProducerSourceIndexes,
                           lhsNodeScan) == -1 &&
                       arenamod.ArenaArrayInt32Get(
                           ir.arena,
                           ir.nodes2_bindingDeclarationSourceLocalRows,
                           lhsNodeScan) == -1 &&
                       arenamod.ArenaArrayInt32Get(
                           ir.arena,
                           ir.nodes2_bindingPatternSourceLocalRows,
                           lhsNodeScan) == -1 &&
                       arenamod.ArenaArrayInt32Get(
                           ir.arena,
                           ir.nodes2_bindingValueDefinitionRows,
                           lhsNodeScan) == -1:
                    arenamod.ArenaArrayInt32Set(
                        ir.arena,
                        ir.nodes2_originParserNodeIds,
                        lhsNodeScan,
                        -1)
                    arenamod.ArenaArrayInt32Set(
                        ir.arena,
                        ir.nodes2_syntheticOriginKinds,
                        lhsNodeScan,
                        Int32(TypedExprSyntheticOriginDesugared))
                    arenamod.ArenaArrayInt32Set(
                        ir.arena,
                        ir.nodes2_spanAuthorityKinds,
                        lhsNodeScan,
                        Int32(TypedExprSpanAuthorityNoSource))
                lhsNodeScan = lhsNodeScan + 1
        if stmt.assignLvalueNodeIndex < 0 ||
           !TypedExprIrNodeIsWritableLvalue(
               ir, stmt.assignLvalueNodeIndex):
            panic(Fmt"typed expr: assignment lvalue authority unavailable source={expr.sourcePath} function={scope.name} line={expr.lineNumber} lhs={lhsText}")
        if ir.nodes2_opKinds[stmt.assignLvalueNodeIndex] ==
               TypedExprIrOpIndexGet:
            stmt.assignIndexNodeIndex =
                arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.nodes2_operand1NodeIndexs,
                    stmt.assignLvalueNodeIndex)
            if stmt.assignIndexNodeIndex < 0:
                panic("typed expr: indexed lvalue has no exact index node")
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueFieldAlignBytes = 0
    stmt.assignValueOpKind = TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.assignValueRhsConst = 0
    stmt.assignValueRhsHasConst = false
    stmt.callQualifier = ""
    stmt.callCallee = ""
    stmt.callTarget = ""
    stmt.callTargetSourcePath = ""
    stmt.callTargetImportc = false
    stmt.callArgCount = 0
    stmt.callArgsText = ""
    stmt.callArgTypesText = ""
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    stmt.rhsNodeIndex = TypedExprIrBuildStatementValueRoot(
        ir, ctx, sourceContexts, share(scope), stmt, stmt.resultType)
    TypedExprIrPopulateAssignValueFieldMetaFromRhsNode(stmt, ir)
    TypedExprIrBindDirectCallAuthorityFromRhsNode(ir, stmt)
    stmt.callSurfaceKind = TypedExprStatementCallSurfaceKind(
        ctx,
        scope,
        expr.lineNumber,
        stmt.callKind,
        TypedExprSurfaceCallNone,
        stmt.callCallee,
        stmt.callTarget,
        stmt.callTargetImportc)
    if isBindingInitializer &&
       (stmt.resultType == "" || stmt.resultType == "unknown"):
        stmt.resultType = TypedExprIrDeclInferredResultType(
            ir, stmt.rhsNodeIndex, share(stmt.resultType))
        if stmt.resultType == "" || stmt.resultType == "unknown":
            panic("typed expr: structural binding initializer type unavailable")
    stmt.loweringMode = TypedExprLowerLocalAddress
    stmt.returnKind = TypedExprReturnDeferred
    stmt.returnRoot = false
    if !isBindingInitializer:
        # [wall78] plain assign 端语句列供给（wall74 移交 2）：LHS 绑定
        # 目标声明组定义行读回填列——primary new(T) alloc 定义盖章臂
        # （语句列行守卫）由此取行；不可得时列保持 -1，行守卫原样
        # hard-fail（零弱化）。
        stmt.bindingTargetDefinitionRow =
            typedExprIrAssignBindingTargetDefinitionRow(ir, lhsText)
    if isBindingInitializer &&
       ir.valueExprTree != nil && ir.valueExprTreeBorrowLease:
        var producerSourceIndex =
            ir.valueExprTransactionProducerSourceIndex
        if producerSourceIndex < 0:
            producerSourceIndex =
                parser.ParserValueExprNodeProducerSourceIndexAt(
                    ir.valueExprTree,
                    expr.valueExprRootNodeIndex)
        TypedExprIrAppendValueDefinitionsForBindingInitializer(
            ir,
            ir.valueExprTree,
            producerSourceIndex,
            ir.functions2_functionNameIds.len,
            expr.valueExprRootNodeIndex,
            stmt.rhsNodeIndex)
        # [wall78] decl-init（`var t = ...`）端语句列供给：初始化根组在
        # 上方消费后按根节点组映射读回定义行填列（AppendLocalDeclInitializer
        # 文本 new 臂同读此列）；不可得时列保持 -1，行守卫原样 hard-fail。
        if expr.valueExprRootNodeIndex >= 0 &&
           expr.valueExprRootNodeIndex <
               ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex.len:
            let initializerGroupRow =
                ir.valueExprTransactionDefinitionGroupStartsByRootNodeIndex[
                    expr.valueExprRootNodeIndex]
            if initializerGroupRow >= 0 &&
               initializerGroupRow <
                   TypedExprValueDefinitionGroupAuthorityCount(ir):
                let initializerDefinitionRow = arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.valueDefinitionGroups_definitionRows,
                    initializerGroupRow)
                if initializerDefinitionRow >= 0 &&
                   initializerDefinitionRow <
                       TypedExprValueDefinitionAuthorityCount(ir):
                    stmt.bindingTargetDefinitionRow = initializerDefinitionRow
    TypedExprTraceLine("typed_ir_assign:before_add")
    let statementIndex = stmt.statementIndex
    var localBindingResultType = ""
    if isBindingInitializer:
        localBindingResultType = share(stmt.resultType)
    TypedExprIrAppendStatement(ir, stmt)
    TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
    if isBindingInitializer:
        TypedExprIrAppendLocalBinding(ir,
                                      share(expr.sourcePath),
                                      share(scope.name),
                                      expr.lineNumber,
                                      lhsText,
                                      localBindingResultType)
    TypedExprTraceLine("typed_ir_assign:after_add")
    return statementIndex

@borrows
fn TypedExprIrDeclInferredResultType(ir: TypedExprIr,
                                      nodeIndex: int32,
                                      fallback: str): str =
    if nodeIndex < 0 || nodeIndex >= ir.nodes2_nodeIndexs.len:
        return fallback
    let inferred = Value(langintern.LookupIntern(
        ir.internPool,
        ir.nodes2_resultTypeIds[nodeIndex]))
    if inferred == "" || inferred == "unknown":
        return fallback
    return inferred

@borrows
fn TypedExprIrAddCallStatementFromExpr(ir: var TypedExprIr,
                                        ctx: var TypedExprSourceContext,
                                        sourceContexts: TypedExprSourceContext[],
                                        scope: TypedExprFunctionScope,
                                        expr: parser.NormalizedExpr,
                                        kind: TypedExprIrStatementKind,
                                        bindingName: str,
                                        resultTypeRaw: str,
                                        lineIndent: int32,
                                        enclosingIfLineNumber: int32,
                                        enclosingIfConditionText: str,
                                        returnRoot: bool): int32 =
    if expr.valueExprStatementRole ==
           parser.ParserValueExprStatementImplicitReturnValue:
        if expr.kind != parser.NormalizedExprReturn:
            panic("typed expr: implicit-return root is not a return statement")
        if scope.returnType == "" || scope.returnType == "void":
            # void 函数的 implicit-return 候选只是普通副作用语句: 求值
            # (call/表达式副作用)必须保留——降级为 call 语句, 不建 return
            # 语义。此前整体 return -1 丢弃: 副作用丢失且 resolved-call
            # 表找不到 TypedIR call 行(no exact TypedIR call)。
            kind = TypedExprIrStmtCall
        elif kind != TypedExprIrStmtReturn:
            panic("typed expr: implicit-return root is not a return statement")
    var stmt: TypedExprIrStatement
    stmt.rhsNodeIndex = -1
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.bindingTargetDefinitionRow = -1
    stmt.assignIndexNodeIndex = -1
    stmt.sourcePath = share(expr.sourcePath)
    stmt.functionName = share(scope.name)
    stmt.statementIndex = ir.statements2_statementIndexs.len
    TypedExprIrSetStatementLocationFromExpr(stmt, expr)
    stmt.lineIndent = lineIndent
    stmt.enclosingIfLineNumber = enclosingIfLineNumber
    stmt.enclosingIfConditionText = share(enclosingIfConditionText)
    stmt.exprId = TypedExprExprStableId(expr)
    stmt.kind = kind
    stmt.callKind = TypedExprCallKindForExpr(expr)
    stmt.detailKind = expr.detailKind
    stmt.surfaceText = share(expr.surfaceText)
    if kind == TypedExprIrStmtReturn &&
       ir.valueExprTree != nil && ir.valueExprTreeBorrowLease:
        if stmt.valueExprRootNodeIndex < 0 ||
           stmt.valueExprStatementRole ==
               parser.ParserValueExprStatementInvalid:
            panic(Fmt"typed expr: return parser root missing source={ctx.sourcePath} function={scope.name} line={stmt.lineNumber} surface={stmt.surfaceText}")
        stmt.surfaceText = share(TypedExprIrStatementValueRootText(
            ir,
            stmt.valueExprRootNodeIndex,
            stmt.valueExprSpanStart,
            stmt.valueExprSpanEnd,
            stmt.valueExprStatementRole))
    if expr.kind == parser.NormalizedExprCall &&
       kind != TypedExprIrStmtReturn:
        stmt.surfaceText = TypedExprQualifiedCallSurface(expr.callQualifier, expr.callCallee)
    stmt.bindingName = share(bindingName)
    stmt.resultType = share(resultTypeRaw)
    if stmt.resultType == "":
        stmt.resultType = "unknown"
    stmt.conditionKind = TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignFieldAlignBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueFieldAlignBytes = 0
    stmt.assignValueOpKind = TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.assignValueRhsConst = 0
    stmt.assignValueRhsHasConst = false
    stmt.callQualifier = share(expr.callQualifier)
    stmt.callCallee = share(expr.callCallee)
    stmt.callTarget = ""
    stmt.callTargetSourcePath = ""
    stmt.callTargetImportc = false
    stmt.callArgCount = expr.callArgCount
    stmt.callArgsText = share(expr.callArgsText)
    stmt.callArgTypesText = ""
    stmt.callArgNodeStart = -1
    stmt.callArgNodeCount = 0
    TypedExprIrRegisterValueExprCallResultType(
        ir, stmt.valueExprCallNodeIndex, stmt.resultType)
    stmt.loweringMode = TypedExprLowerDeferred
    stmt.returnKind = TypedExprReturnDeferred
    stmt.returnRoot = returnRoot
    if kind == TypedExprIrStmtReturn:
        stmt.rhsNodeIndex = TypedExprIrBuildStatementValueRoot(
            ir, ctx, sourceContexts, scope, stmt, stmt.resultType)
        typedExprIrProjectStatementCallArgsFromBuiltRoot(ir, stmt)
    else:
        TypedExprIrPopulateCallArgNodeChain(ir,
                                            ctx,
                                            sourceContexts,
                                            share(scope),
                                            expr.lineNumber,
                                            stmt)
    if kind != TypedExprIrStmtReturn &&
       (expr.kind == parser.NormalizedExprCall ||
        expr.valueExprCallNodeIndex >= 0) &&
       stmt.surfaceText != "":
        # implicit-return 降级的 call 语句: expr.kind 是 NormalizedExprReturn
        # (AppendImplicitReturnFacts 建条目口径), 语句本体经
        # BindRootCallIdentity 带 valueExprCallNodeIndex——与 NormalizedExprCall
        # 同构, 走同一 BuildStatementCallRoot 建 CallExpr。
        stmt.rhsNodeIndex = TypedExprIrBuildStatementCallRoot(
            ir, ctx, sourceContexts, share(scope), stmt)
    TypedExprIrBindDirectCallAuthorityFromRhsNode(ir, stmt)
    if stmt.valueExprRootNodeIndex >= 0:
        let tree = ir.valueExprTree
        if tree == nil || !ir.valueExprTreeBorrowLease:
            panic("typed expr: statement call classification has no parser lease")
        if parser.ParserValueExprNodeKindAt(
               tree, stmt.valueExprRootNodeIndex) ==
           parser.ParserValueExprCall:
            stmt.callQualifier = share(parser.ParserValueExprNodeOwnerText(
                tree, stmt.valueExprRootNodeIndex))
            stmt.callCallee = share(parser.ParserValueExprNodeNameText(
                tree, stmt.valueExprRootNodeIndex))
            if parser.ParserResultIntrinsicDetailKind(stmt.callCallee) !=
                   parser.NormalizedExprDetailNone:
                stmt.callKind = TypedExprCallResultIntrinsic
            elif parser.ParserCallNameIsBuiltinCallee(stmt.callCallee) ||
                 parser.ParserCallNameIsBuiltinPrimitiveConversion(
                     stmt.callCallee):
                stmt.callKind = TypedExprCallBuiltin
    if TypedExprExprIsBuiltinSeqAddCall(expr) ||
       stmt.callKind == TypedExprCallBuiltin ||
       stmt.callKind == TypedExprCallResultIntrinsic:
        stmt.callSurfaceKind = CallSurfaceBuiltin
    else:
        stmt.callSurfaceKind = TypedExprStatementCallSurfaceKind(
            ctx,
            scope,
            expr.lineNumber,
            stmt.callKind,
            TypedExprSurfaceCallKindFromParser(expr.callSurfaceKind),
            stmt.callCallee,
            stmt.callTarget,
            stmt.callTargetImportc)
    let statementIndex = stmt.statementIndex
    TypedExprIrAppendStatement(ir, stmt)
    TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)
    return statementIndex

fn TypedExprIrAppendStatementsForScopeFromExprLayer(ir: var TypedExprIr,
                                                     ctx: var TypedExprSourceContext,
                                                     sourceContexts: var TypedExprSourceContext[],
                                                     scope: TypedExprFunctionScope,
                                                     exprLayer: var parser.NormalizedExprLayer,
                                                     startIndex: int32,
                                                     endIndexRaw: int32) =
    var cursor = startIndex
    if cursor < 0:
        cursor = 0
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > exprLayer.exprs.len:
        endIndex = exprLayer.exprs.len
    if cursor >= endIndex:
        return
    var currentLineNumber: int32 = -1
    var currentLineHasIf = false
    var currentLineBindingName = ""
    var currentLineBindingType = ""
    var currentLineBindingRootColumn: int32 = -1
    var currentLineBindingRhsStartColumn: int32 = -1
    var currentLineBindingIsTernary = false
    var currentLineBindingIsBinary = false
    var currentLineBindingIsBoolExpr = false
    var currentLineBindingIsAggregateCtor = false
    var activeAggregateCtorEndLine: int32 = -1
    var currentLineReturnRootColumn: int32 = -1
    var currentLineReturnExprStartColumn: int32 = -1
    var currentLineIndent: int32
    var currentLineEnclosingIfLineNumber: int32
    var currentLineEnclosingIfConditionText = ""
    for i in cursor..<endIndex:
        let expr = exprLayer.exprs[i]
        if (expr.lineNumber <= scope.startLine &&
            !TypedExprExprIsScopeStartReturn(expr, scope)) ||
           expr.lineNumber > scope.endLine:
            if expr.lineNumber > scope.endLine:
                break
            continue
        if expr.lineNumber != currentLineNumber:
            currentLineNumber = expr.lineNumber
            let lineContinuesAggregateCtor =
                currentLineNumber <= activeAggregateCtorEndLine
            if !lineContinuesAggregateCtor:
                activeAggregateCtorEndLine = -1
            currentLineHasIf = false
            currentLineBindingName = ""
            currentLineBindingType = ""
            currentLineBindingRootColumn = -1
            currentLineBindingRhsStartColumn = -1
            currentLineBindingIsTernary = false
            currentLineBindingIsBinary = false
            currentLineBindingIsBoolExpr = false
            currentLineBindingIsAggregateCtor = false
            if lineContinuesAggregateCtor:
                currentLineBindingRhsStartColumn = 1
                currentLineBindingIsAggregateCtor = true
            currentLineReturnRootColumn = -1
            currentLineReturnExprStartColumn = -1
            let lineRaw = TypedExprSourceLine(ctx, currentLineNumber)
            currentLineIndent = TypedExprLineIndentWidth(lineRaw)
            TypedExprNearestEnclosingIf(ctx,
                                        scope,
                                        currentLineNumber,
                                        currentLineIndent,
                                        currentLineEnclosingIfLineNumber,
                                        currentLineEnclosingIfConditionText)
            let trimmedLine = chengpath.PathTrim(lineRaw)
            var isBindingLine = false
            if parser.ParserStartsWith(trimmedLine, "let "):
                isBindingLine = true
            elif parser.ParserStartsWith(trimmedLine, "var "):
                isBindingLine = true
            elif parser.ParserStartsWith(trimmedLine, "const "):
                isBindingLine = true
            if isBindingLine:
                currentLineBindingName = TypedExprLetCallBindingNameFromBody(share(trimmedLine))
                var bindingName = ""
                var bindingType = ""
                var bindingRhsColumn: int32 = -1
                if TypedExprParseBindingLine(lineRaw, bindingName, bindingType, bindingRhsColumn):
                    currentLineBindingName = bindingName
                    currentLineBindingType = bindingType
                let eqPos = TypedExprFindTopLevelTextToken(lineRaw, "=")
                if eqPos >= 0:
                    var rhsStartColumn = eqPos + 2
                    for column in rhsStartColumn..lineRaw.len:
                        if parser.ParserIsInlineSpace(lineRaw[column - 1]):
                            rhsStartColumn = column + 1
                        else:
                            rhsStartColumn = column
                            break
                    currentLineBindingRhsStartColumn = rhsStartColumn
                    let bindingRhsText = chengpath.PathTrim(chengpath.TextSlice(lineRaw,
                                                                               rhsStartColumn - 1,
                                                                               lineRaw.len - rhsStartColumn + 1))
                    currentLineBindingIsTernary = TypedExprBindingRhsIsTopLevelTernary(bindingRhsText)
                    currentLineBindingIsBinary = TypedExprBindingRhsHasTopLevelBinaryOperator(bindingRhsText)
                    currentLineBindingIsBoolExpr = TypedExprBindingRhsBoolExprType(bindingRhsText) != ""
                    var bindingRhsEndLine: int32
                    let bindingRhsFullText = TypedExprBindingRhsTextWithContinuationSpan(
                        ctx,
                        currentLineNumber - 1,
                        rhsStartColumn,
                        bindingRhsEndLine)
                    currentLineBindingIsAggregateCtor =
                        TypedExprBindingRhsIsAggregateConstructor(ir,
                                                                  ctx,
                                                                  bindingRhsFullText)
                    if currentLineBindingIsAggregateCtor:
                        activeAggregateCtorEndLine = bindingRhsEndLine
            let firstToken = parser.ParserFirstToken(chengpath.PathTrim(lineRaw))
            if firstToken == "return":
                let returnPos = parser.ParserFindText(lineRaw, "return")
                currentLineReturnExprStartColumn = returnPos + 7
            elif scope.startLine == currentLineNumber:
                let inlineEqPos = TypedExprFindTopLevelTextToken(lineRaw, "=")
                if inlineEqPos >= 0:
                    currentLineReturnExprStartColumn = inlineEqPos + 2
                else:
                    currentLineReturnExprStartColumn = -1
            for j in i..<endIndex:
                let lineExpr = exprLayer.exprs[j]
                if lineExpr.lineNumber != currentLineNumber:
                    if lineExpr.lineNumber > currentLineNumber:
                        break
                    continue
                if lineExpr.kind == parser.NormalizedExprIf:
                    # See TypedExprLineHasIfKeywordFact: a ternary `?` mark
                    # shares NormalizedExprIf's fact kind with a real
                    # if/elif/while keyword. This exprLayer entry carries
                    # detailKind directly, so check it instead of re-deriving
                    # from the source byte.
                    if lineExpr.detailKind == parser.NormalizedExprDetailIfTernary:
                        continue
                    currentLineHasIf = true
                    break
                if currentLineBindingRhsStartColumn > 0 &&
                   (lineExpr.kind == parser.NormalizedExprCall ||
                    lineExpr.kind == parser.NormalizedExprResultIntrinsic) &&
                   lineExpr.columnNumber >= currentLineBindingRhsStartColumn:
                    if currentLineBindingRootColumn < 0 ||
                       lineExpr.columnNumber < currentLineBindingRootColumn:
                        currentLineBindingRootColumn = lineExpr.columnNumber
                if currentLineReturnExprStartColumn > 0 &&
                   (lineExpr.kind == parser.NormalizedExprCall ||
                    lineExpr.kind == parser.NormalizedExprResultIntrinsic) &&
                   lineExpr.columnNumber >= currentLineReturnExprStartColumn:
                    if currentLineReturnRootColumn < 0 ||
                       lineExpr.columnNumber < currentLineReturnRootColumn:
                        currentLineReturnRootColumn = lineExpr.columnNumber
        let isResultIntrinsic = expr.kind == parser.NormalizedExprResultIntrinsic
        let isNormalCall = expr.kind == parser.NormalizedExprCall
        if expr.kind == parser.NormalizedExprReturn:
            let _ = TypedExprIrAddCallStatementFromExpr(ir,
                                                        ctx,
                                                        sourceContexts,
                                                        share(scope),
                                                        share(expr),
                                                        TypedExprIrStmtReturn,
                                                        "",
                                                        share(scope.returnType),
                                                        currentLineIndent,
                                                        currentLineEnclosingIfLineNumber,
                                                        share(currentLineEnclosingIfConditionText),
                                                        true)
            continue
        if expr.kind == parser.NormalizedExprAssign:
            let _ = TypedExprIrAddAssignStatementFromExpr(ir,
                                                          ctx,
                                                          sourceContexts,
                                                          share(scope),
                                                          share(expr),
                                                          currentLineIndent,
                                                          currentLineEnclosingIfLineNumber,
                                                          share(currentLineEnclosingIfConditionText))
            continue
        if expr.kind == parser.NormalizedExprIfStmt ||
           expr.kind == parser.NormalizedExprElifStmt ||
           expr.kind == parser.NormalizedExprElseStmt ||
           expr.kind == parser.NormalizedExprForStmt ||
           expr.kind == parser.NormalizedExprMatchStmt ||
           expr.kind == parser.NormalizedExprCaseStmt ||
           expr.kind == parser.NormalizedExprWhileStmt ||
           expr.kind == parser.NormalizedExprDeferStmt ||
           expr.kind == parser.NormalizedExprBreakStmt ||
           expr.kind == parser.NormalizedExprContinueStmt:
            let _ = TypedExprIrAddControlStatementFromExpr(ir,
                                                           ctx,
                                                           sourceContexts,
                                                           share(scope),
                                                           share(expr),
                                                           currentLineIndent,
                                                           currentLineEnclosingIfLineNumber,
                                                           share(currentLineEnclosingIfConditionText))
            continue
        if !isNormalCall && !isResultIntrinsic:
            continue
        if currentLineBindingIsAggregateCtor &&
           currentLineBindingRhsStartColumn > 0 &&
           expr.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        if isNormalCall && TypedExprExprIsBuiltinStringifyCall(expr):
            continue
        if isNormalCall && expr.callCallee == "" && expr.callTarget == "":
            continue
        # `let x = <call> <binop> <...>` — call is a sub-expression of a top-level
        # binary, not the binding's value. Promoting it binds x to a single call
        # and drops the operator + other operand (net-audit r13). Leave the whole
        # RHS to the LocalDecl twin's binary-with-call decomposer.
        if isNormalCall &&
           currentLineBindingIsBinary &&
           currentLineBindingRhsStartColumn > 0 &&
           expr.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        # `let b = <call> <cmp> <...>` — call feeds a top-level comparison; the
        # binding value is bool, not the call's return type. Suppress let-call
        # promotion so the LocalDecl twin carries the inferred bool type and `if b:`
        # resolves its condition node (else cond_shape gap).
        if isNormalCall &&
           currentLineBindingIsBoolExpr &&
           currentLineBindingRhsStartColumn > 0 &&
           expr.columnNumber >= currentLineBindingRhsStartColumn:
            continue
        var sink: TypedExprSinkInfo
        sink.sinkType = ""
        sink.sinkPlaceKind = TypedExprPlaceTemporary
        sink.hasSink = false
        sink.returnRoot = false
        sink.functionReturnType = scope.returnType
        if currentLineBindingRootColumn == expr.columnNumber:
            sink.sinkType = currentLineBindingType
            sink.sinkPlaceKind = TypedExprPlaceLocal
            sink.hasSink = true
        if currentLineReturnRootColumn == expr.columnNumber && scope.returnType != "":
            sink.sinkType = scope.returnType
            sink.sinkPlaceKind = TypedExprPlaceTemporary
            sink.hasSink = true
            sink.returnRoot = true
        var statementKind = TypedExprIrStmtCall
        if isResultIntrinsic:
            statementKind = TypedExprIrStmtResultIntrinsic
        else:
            if sink.hasSink &&
               (sink.sinkPlaceKind == TypedExprPlaceLocal ||
                sink.sinkPlaceKind == TypedExprPlaceGlobal):
                statementKind = TypedExprIrStmtLetCall
            elif currentLineBindingRootColumn == expr.columnNumber:
                statementKind = TypedExprIrStmtLetCall
            elif currentLineHasIf &&
                 !TypedExprCallIsInlineSuiteBodyStatement(ctx, expr.lineNumber, expr.columnNumber):
                statementKind = TypedExprIrStmtIfCall
        var statementBindingName = ""
        if statementKind == TypedExprIrStmtLetCall ||
           (statementKind == TypedExprIrStmtResultIntrinsic &&
            (sink.hasSink || currentLineBindingRootColumn == expr.columnNumber)):
            statementBindingName = currentLineBindingName
        var statementResultType = "unknown"
        if isResultIntrinsic:
            statementResultType = TypedExprResultIntrinsicTypeFromExpr(ctx, expr, sink)
        elif isNormalCall:
            statementResultType = TypedExprLookupCallTargetReturnTypeFromExpr(ctx, sourceContexts, expr)
        if (statementKind == TypedExprIrStmtLetCall ||
            statementKind == TypedExprIrStmtResultIntrinsic) &&
           Len(currentLineBindingType) > 0:
            statementResultType = currentLineBindingType
        let _ = TypedExprIrAddCallStatementFromExpr(ir,
                                                    ctx,
                                                    sourceContexts,
                                                    share(scope),
                                                    share(expr),
                                                    statementKind,
                                                    statementBindingName,
                                                    statementResultType,
                                                    currentLineIndent,
                                                    currentLineEnclosingIfLineNumber,
                                                    share(currentLineEnclosingIfConditionText),
                                                    sink.returnRoot)

fn TypedExprIrFirstBindingCallFactIndex(facts: var TypedExprFactTable,
                                         lineNumber: int32,
                                         startIndex: int32,
                                         endIndexRaw: int32): int32 =
    if lineNumber <= 0:
        return -1
    var cursor = startIndex
    if cursor < 0:
        cursor = 0
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > facts.count:
        endIndex = facts.count
    if cursor >= endIndex:
        return -1
    for i in cursor..<endIndex:
        let factRowI = TypedExprFactAt(facts, i)
        if factRowI.lineNumber != lineNumber:
            if factRowI.lineNumber > lineNumber:
                break
            continue
        if factRowI.kind != parser.NormalizedExprCall:
            continue
        if factRowI.callKind == TypedExprCallBuiltin:
            continue
        if !factRowI.callResolved || factRowI.callTarget == "":
            continue
        if !factRowI.hasSink:
            continue
        if factRowI.sinkPlaceKind != TypedExprPlaceLocal &&
           factRowI.sinkPlaceKind != TypedExprPlaceGlobal:
            continue
        return i
    return -1

fn TypedExprIrAnnotateGeneratedStatementSourceScopes(
        ir: var TypedExprIr,
        layer: var parser.NormalizedExprLayer,
        scopeIndex: var TypedExprNormalizedScopeIndex,
        sourceIndex: int32,
        statementStart: int32,
        statementEnd: int32) =
    if statementStart >= statementEnd:
        return
    let sourceScopeStart = scopeIndex.starts[sourceIndex]
    let sourceScopeCount = scopeIndex.counts[sourceIndex]
    var activeScopeIds: int32[]
    var sourceScopeCursor: int32
    var previousLine: int32 = -1
    var previousColumn: int32 = -1
    for statementIndex in statementStart..<statementEnd:
        let existingScopeId = arenamod.ArenaArrayInt32Get(ir.arena,
                                                           ir.statements2_lexicalScopeIds,
                                                           statementIndex)
        if existingScopeId >= 0:
            continue
        let lineNumber = arenamod.ArenaArrayInt32Get(ir.arena,
                                                      ir.statements2_lineNumbers,
                                                      statementIndex)
        let columnNumber = arenamod.ArenaArrayInt32Get(ir.arena,
                                                        ir.statements2_columnNumbers,
                                                        statementIndex)
        if previousLine > lineNumber ||
           (previousLine == lineNumber && previousColumn > columnNumber):
            panic("typed expr: generated statements are not in source order")
        previousLine = lineNumber
        previousColumn = columnNumber
        while sourceScopeCursor < sourceScopeCount:
            let candidate = layer.scopes[sourceScopeStart + sourceScopeCursor]
            if !TypedExprPositionAtOrBefore(candidate.startLineNumber,
                                             candidate.startColumnNumber,
                                             lineNumber,
                                             columnNumber):
                break
            # Inline defer scopes are appended after the physical scope pass and
            # can precede the cursor in source position. Generated local rows do
            # not originate inside an inline defer; direct parser facts own that
            # path, so only monotonic physical/block scopes enter this stack.
            if candidate.kind != parser.NormalizedScopeInlineSuite:
                while activeScopeIds.len > 0:
                    let active = layer.scopes[sourceScopeStart +
                                               activeScopeIds[activeScopeIds.len - 1]]
                    if TypedExprPositionAtOrBefore(lineNumber,
                                                    columnNumber,
                                                    active.endLineNumber,
                                                    active.endColumnNumber):
                        break
                    setLen(activeScopeIds, activeScopeIds.len - 1)
                add(activeScopeIds, candidate.scopeId)
            sourceScopeCursor = sourceScopeCursor + 1
        while activeScopeIds.len > 0:
            let active = layer.scopes[sourceScopeStart +
                                       activeScopeIds[activeScopeIds.len - 1]]
            if TypedExprPositionAtOrBefore(lineNumber,
                                            columnNumber,
                                            active.endLineNumber,
                                            active.endColumnNumber):
                break
            setLen(activeScopeIds, activeScopeIds.len - 1)
        var lexicalScopeId: int32
        if activeScopeIds.len > 0:
            lexicalScopeId = activeScopeIds[activeScopeIds.len - 1]
        arenamod.ArenaArrayInt32Set(ir.arena,
                                    ir.statements2_lexicalScopeIds,
                                    statementIndex,
                                    lexicalScopeId)
        let owningDeferGlobal = TypedExprNormalizedOwningDeferSuiteGlobalIndex(
            layer,
            scopeIndex,
            sourceIndex,
            lexicalScopeId)
        if owningDeferGlobal >= 0:
            arenamod.ArenaArrayInt32Set(
                ir.arena,
                ir.statements2_deferOwnerStatementOrdinals,
                statementIndex,
                layer.scopes[owningDeferGlobal].ownerStatementOrdinal)

fn TypedExprFunctionOrdinalMapInit(expectedCount: int32): TypedExprFunctionOrdinalMap =
    var out: TypedExprFunctionOrdinalMap
    if expectedCount < 0 || expectedCount > 536870911:
        panic("typed expr: function ordinal mapping size is invalid")
    var capacity: int32 = 1
    let requiredCapacity = expectedCount * 2 + 1
    while capacity < requiredCapacity:
        capacity = capacity * 2
    setLen(out.keys, capacity)
    setLen(out.localOrdinals, capacity)
    for slotIndex in 0..<capacity:
        out.keys[slotIndex] = -1
        out.localOrdinals[slotIndex] = -1
    return out

fn TypedExprFunctionOrdinalMapFind(index: var TypedExprFunctionOrdinalMap,
                                    sourceOrdinal: int32): int32 =
    if sourceOrdinal < 0 || index.keys.len <= 0:
        return -1
    var slotIndex = sourceOrdinal % index.keys.len
    var visited: int32
    while visited < index.keys.len:
        index.probeVisitCount = index.probeVisitCount + 1
        let key = index.keys[slotIndex]
        if key < 0:
            return -1
        if key == sourceOrdinal:
            return index.localOrdinals[slotIndex]
        slotIndex = slotIndex + 1
        if slotIndex >= index.keys.len:
            slotIndex = 0
        visited = visited + 1
    return -1

fn TypedExprFunctionOrdinalMapInsert(index: var TypedExprFunctionOrdinalMap,
                                      sourceOrdinal: int32,
                                      localOrdinal: int32) =
    if sourceOrdinal < 0 || localOrdinal < 0 || index.keys.len <= 0:
        panic("typed expr: invalid function ordinal mapping")
    if index.count * 2 >= index.keys.len:
        panic("typed expr: function ordinal mapping capacity exhausted")
    var slotIndex = sourceOrdinal % index.keys.len
    var visited: int32
    while visited < index.keys.len:
        index.probeVisitCount = index.probeVisitCount + 1
        if index.keys[slotIndex] < 0:
            index.keys[slotIndex] = sourceOrdinal
            index.localOrdinals[slotIndex] = localOrdinal
            index.count = index.count + 1
            return
        if index.keys[slotIndex] == sourceOrdinal:
            panic("typed expr: duplicate function statement ordinal")
        slotIndex = slotIndex + 1
        if slotIndex >= index.keys.len:
            slotIndex = 0
        visited = visited + 1
    panic("typed expr: function ordinal mapping insert failed")

@borrows
fn TypedExprIrMaterializeFunctionScopes(
        ir: var TypedExprIr,
        ctx: TypedExprSourceContext,
        functionScope: TypedExprFunctionScope,
        layer: var parser.NormalizedExprLayer,
        scopeIndex: var TypedExprNormalizedScopeIndex,
        generatedStatementStart: int32,
        generatedStatementEnd: int32,
        statementStart: int32,
        statementEnd: int32,
        fnIr: var TypedExprIrFunction) =
    fnIr.scopeStart = ir.scopes2_scopeIds.len
    var functionStartLine = functionScope.startLine
    if functionStartLine <= 0:
        functionStartLine = 1
    var functionEndLine = functionScope.endLine
    if functionEndLine < functionStartLine:
        functionEndLine = functionStartLine
    var functionEndColumn: int32 = 1
    if functionEndLine > 0 &&
       functionEndLine <= TypedExprSourceContextLineCount(ctx):
        functionEndColumn =
            TypedExprSourceContextLineText(ctx, functionEndLine).len
        if functionEndColumn <= 0:
            functionEndColumn = 1
    TypedExprIrAppendScope(ir,
                             0,
                             -1,
                             parser.NormalizedScopeRoot,
                             -1,
                             0,
                             functionStartLine,
                             1,
                             functionEndLine,
                             functionEndColumn)
    let sourceIndex = TypedExprNormalizedScopeSourceIndex(scopeIndex,
                                                           ctx.sourcePath)
    if sourceIndex < 0:
        for statementIndex in statementStart..<statementEnd:
            let suiteScopeId = arenamod.ArenaArrayInt32Get(ir.arena,
                                                            ir.statements2_suiteScopeIds,
                                                            statementIndex)
            let statementOrdinal = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_statementOrdinals,
                statementIndex)
            if suiteScopeId >= 0 || statementOrdinal >= 0:
                panic("typed expr: structured statement has no normalized scope table")
            arenamod.ArenaArrayInt32Set(ir.arena,
                                        ir.statements2_lexicalScopeIds,
                                        statementIndex,
                                        0)
        fnIr.scopeCount = 1
        return
    TypedExprIrAnnotateGeneratedStatementSourceScopes(ir,
                                                       layer,
                                                       scopeIndex,
                                                       sourceIndex,
                                                       generatedStatementStart,
                                                       generatedStatementEnd)
    let sourceScopeStart = scopeIndex.starts[sourceIndex]
    let sourceScopeCount = scopeIndex.counts[sourceIndex]
    var selected: bool[]
    var sourceToLocal: int32[]
    var resolvedOwners: int32[]
    setLen(selected, sourceScopeCount)
    setLen(sourceToLocal, sourceScopeCount)
    setLen(resolvedOwners, sourceScopeCount)
    for sourceScopeId in 0..<sourceScopeCount:
        sourceToLocal[sourceScopeId] = -1
        resolvedOwners[sourceScopeId] =
            layer.scopes[sourceScopeStart + sourceScopeId].ownerStatementOrdinal
    selected[0] = true
    sourceToLocal[0] = 0
    # Materialize the scope closure actually referenced by the emitted IR.
    # Source-span selection also retained suites whose control statements were
    # deliberately folded into a single leaf node (for example strLenFast),
    # leaving an owner scope without any owner statement row. Every live suite
    # is already named by a statement's lexicalScopeId or suiteScopeId; closing
    # those identities over parents preserves empty suites and nested bodies
    # without inventing scopes for statements absent from this function IR.
    for statementIndex in statementStart..<statementEnd:
        let statementLexicalScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_lexicalScopeIds, statementIndex)
        if statementLexicalScopeId >= sourceScopeCount:
            panic("typed expr: statement lexical scope is outside source table")
        var markScopeId = statementLexicalScopeId
        while markScopeId > 0 && !selected[markScopeId]:
            selected[markScopeId] = true
            markScopeId = layer.scopes[sourceScopeStart + markScopeId].parentScopeId
        let statementSuiteScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_suiteScopeIds, statementIndex)
        if statementSuiteScopeId >= sourceScopeCount:
            panic("typed expr: statement suite scope is outside source table")
        markScopeId = statementSuiteScopeId
        while markScopeId > 0 && !selected[markScopeId]:
            selected[markScopeId] = true
            markScopeId = layer.scopes[sourceScopeStart + markScopeId].parentScopeId

    var structuredStatementCount: int32
    for statementIndex in statementStart..<statementEnd:
        let statementOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_statementOrdinals, statementIndex)
        if statementOrdinal >= 0:
            structuredStatementCount = structuredStatementCount + 1
    var statementOrdinalMap = TypedExprFunctionOrdinalMapInit(structuredStatementCount)
    var statementRowsByLocalOrdinal: int32[]
    setLen(statementRowsByLocalOrdinal, structuredStatementCount)
    var nextLocalStatementOrdinal: int32
    var previousSourceStatementOrdinal: int32 = -1
    for statementIndex in statementStart..<statementEnd:
        let sourceStatementOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_statementOrdinals, statementIndex)
        if sourceStatementOrdinal < 0:
            continue
        if sourceStatementOrdinal <= previousSourceStatementOrdinal:
            let statementLineNumber = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.statements2_lineNumbers, statementIndex)
            let statementColumnNumber = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.statements2_columnNumbers, statementIndex)
            panic(Fmt"typed expr: function structured statements are not in parser order source={ctx.sourcePath} function={functionScope.name} row={statementIndex} line={statementLineNumber} column={statementColumnNumber} statement={sourceStatementOrdinal} previous={previousSourceStatementOrdinal}")
        previousSourceStatementOrdinal = sourceStatementOrdinal
        TypedExprFunctionOrdinalMapInsert(statementOrdinalMap,
                                           sourceStatementOrdinal,
                                           nextLocalStatementOrdinal)
        statementRowsByLocalOrdinal[nextLocalStatementOrdinal] = statementIndex
        nextLocalStatementOrdinal = nextLocalStatementOrdinal + 1
        let suiteScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_suiteScopeIds, statementIndex)
        if suiteScopeId < 0:
            continue
        if suiteScopeId >= sourceScopeCount || !selected[suiteScopeId]:
            panic("typed expr: statement suite scope is outside function")
        let suiteOwner = resolvedOwners[suiteScopeId]
        if suiteOwner < 0 || suiteOwner != sourceStatementOrdinal:
            panic("typed expr: statement suite owner fact is missing or mismatched")
    if nextLocalStatementOrdinal != structuredStatementCount ||
       statementOrdinalMap.count != structuredStatementCount:
        panic("typed expr: function statement ordinal mapping is incomplete")
    var localOwners: int32[]
    setLen(localOwners, sourceScopeCount)
    for sourceScopeId in 0..<sourceScopeCount:
        localOwners[sourceScopeId] = -1
    for sourceScopeId in 1..<sourceScopeCount:
        if !selected[sourceScopeId] || resolvedOwners[sourceScopeId] < 0:
            continue
        let ownerOrdinal = TypedExprFunctionOrdinalMapFind(statementOrdinalMap,
                                                            resolvedOwners[sourceScopeId])
        if ownerOrdinal < 0 || ownerOrdinal >= statementRowsByLocalOrdinal.len:
            panic(Fmt"typed expr: lexical suite owner statement is missing source={ctx.sourcePath} function={functionScope.name} source_scope={sourceScopeId} owner={resolvedOwners[sourceScopeId]} structured={structuredStatementCount}")
        let ownerStatementRow = statementRowsByLocalOrdinal[ownerOrdinal]
        if arenamod.ArenaArrayInt32Get(ir.arena,
                                       ir.statements2_suiteScopeIds,
                                       ownerStatementRow) != sourceScopeId:
            panic("typed expr: lexical suite owner does not point back to scope")
        localOwners[sourceScopeId] = ownerOrdinal

    var nextLocalScopeId: int32 = 1
    for sourceScopeId in 1..<sourceScopeCount:
        if !selected[sourceScopeId]:
            continue
        sourceToLocal[sourceScopeId] = nextLocalScopeId
        nextLocalScopeId = nextLocalScopeId + 1
    var localScopeChildCounts: int32[]
    setLen(localScopeChildCounts, nextLocalScopeId)
    for sourceScopeId in 1..<sourceScopeCount:
        if !selected[sourceScopeId]:
            continue
        let normalizedScope = layer.scopes[sourceScopeStart + sourceScopeId]
        var parentLocalScopeId: int32
        if normalizedScope.parentScopeId > 0:
            parentLocalScopeId = sourceToLocal[normalizedScope.parentScopeId]
            if parentLocalScopeId < 0:
                panic("typed expr: selected function scope parent is missing")
        let localScopeId = sourceToLocal[sourceScopeId]
        let localLexicalOrdinal = localScopeChildCounts[parentLocalScopeId]
        localScopeChildCounts[parentLocalScopeId] = localLexicalOrdinal + 1
        TypedExprIrAppendScope(ir,
                                 localScopeId,
                                 parentLocalScopeId,
                                 normalizedScope.kind,
                                 localOwners[sourceScopeId],
                                 localLexicalOrdinal,
                                 normalizedScope.startLineNumber,
                                 normalizedScope.startColumnNumber,
                                 normalizedScope.endLineNumber,
                                 normalizedScope.endColumnNumber)

    var localStatementCountsByScope: int32[]
    setLen(localStatementCountsByScope, nextLocalScopeId)
    for statementIndex in statementStart..<statementEnd:
        let sourceStatementOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_statementOrdinals, statementIndex)
        if sourceStatementOrdinal >= 0:
            let localStatementOrdinal = TypedExprFunctionOrdinalMapFind(
                statementOrdinalMap,
                sourceStatementOrdinal)
            if localStatementOrdinal < 0:
                panic("typed expr: function statement ordinal remap is missing")
            arenamod.ArenaArrayInt32Set(ir.arena,
                                        ir.statements2_statementOrdinals,
                                        statementIndex,
                                        localStatementOrdinal)
        let sourceDeferOwnerOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.statements2_deferOwnerStatementOrdinals,
            statementIndex)
        if sourceDeferOwnerOrdinal >= 0:
            let localDeferOwnerOrdinal = TypedExprFunctionOrdinalMapFind(
                statementOrdinalMap,
                sourceDeferOwnerOrdinal)
            if localDeferOwnerOrdinal < 0:
                panic("typed expr: defer owner statement is outside function")
            arenamod.ArenaArrayInt32Set(
                ir.arena,
                ir.statements2_deferOwnerStatementOrdinals,
                statementIndex,
                localDeferOwnerOrdinal)
        let sourceLexicalScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_lexicalScopeIds, statementIndex)
        var localLexicalScopeId: int32
        if sourceLexicalScopeId > 0:
            if sourceLexicalScopeId >= sourceToLocal.len ||
               sourceToLocal[sourceLexicalScopeId] < 0:
                panic("typed expr: statement lexical scope is outside function")
            localLexicalScopeId = sourceToLocal[sourceLexicalScopeId]
        arenamod.ArenaArrayInt32Set(ir.arena,
                                    ir.statements2_lexicalScopeIds,
                                    statementIndex,
                                    localLexicalScopeId)
        let sourceLexicalOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_lexicalOrdinals, statementIndex)
        if sourceLexicalOrdinal >= 0:
            let localLexicalOrdinal = localStatementCountsByScope[localLexicalScopeId]
            localStatementCountsByScope[localLexicalScopeId] = localLexicalOrdinal + 1
            arenamod.ArenaArrayInt32Set(ir.arena,
                                        ir.statements2_lexicalOrdinals,
                                        statementIndex,
                                        localLexicalOrdinal)
        let sourceSuiteScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_suiteScopeIds, statementIndex)
        var localSuiteScopeId: int32 = -1
        if sourceSuiteScopeId >= 0:
            if sourceSuiteScopeId >= sourceToLocal.len ||
               sourceToLocal[sourceSuiteScopeId] < 0:
                panic("typed expr: statement suite scope is outside function")
            localSuiteScopeId = sourceToLocal[sourceSuiteScopeId]
        arenamod.ArenaArrayInt32Set(ir.arena,
                                    ir.statements2_suiteScopeIds,
                                    statementIndex,
                                    localSuiteScopeId)
    fnIr.scopeCount = ir.scopes2_scopeIds.len - fnIr.scopeStart
    if fnIr.scopeCount <= 0 || !TypedExprIrScopes2ShapeComplete(ir):
        panic("typed expr: function scope tree materialization failed")

@borrows
fn TypedExprBuildIrForScope(ctx: var TypedExprSourceContext,
                             sourceContexts: TypedExprSourceContext[],
                             scope: TypedExprFunctionScope,
                             facts: var TypedExprFactTable,
                             factStartIndex: int32,
                             factEndIndex: int32,
                             ir: var TypedExprIr) =
    let nodeStart = ir.nodes2_nodeIndexs.len
    let statementStart = ir.statements2_statementIndexs.len
    var fnIr: TypedExprIrFunction
    fnIr.sourcePath = strings.CloneStr(ctx.sourcePath)
    fnIr.functionName = strings.CloneStr(scope.name)
    fnIr.signatureLineNumber = scope.startLine
    fnIr.endLineNumber = scope.endLine
    fnIr.returnType = strings.CloneStr(scope.returnType)
    fnIr.resultExprClass = scope.borrowResult ?
        TypedExprExprBorrowed : TypedExprExprOwned
    fnIr.borrowsArguments = scope.borrowsArguments
    fnIr.nodeStart = nodeStart
    fnIr.statementStart = statementStart
    fnIr.returnNodeIndex = -1
    fnIr.valueDefinitionStart =
        TypedExprValueDefinitionAuthorityCount(ir)
    fnIr.valueDefinitionCount = 0
    fnIr.valueDefinitionGroupStart =
        TypedExprValueDefinitionGroupAuthorityCount(ir)
    fnIr.valueDefinitionGroupCount = 0
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        return
    var bodyLineNumber: int32
    let bodyText = TypedExprFunctionBodyLine(ctx, scope, bodyLineNumber)
    var returnExpr = TypedExprReturnExprFromBody(bodyText)
    var returnLineNumber = bodyLineNumber
    let bodyTrim = chengpath.PathTrim(bodyText)
    # T38B: `fn f(...) = if c: STMT` 单行函数体糖——STMT 恰好是控制头 suite
    # 时, "if " 前缀原先无条件排除出下面这条分支, 整段文本原样交给
    # TypedExprReturnExprFromBody 当返回表达式 (只在函数确有返回值类型、
    # body 是 `if c: a else: b` 三元 if-表达式时才是对的)。但 void 函数的
    # "if " 单行体只可能是控制语句形态 (`if c: 赋值/调用`, suite ::= statement
    # 钦定合法, 见 docs/cheng-formal-spec.md:247), 必须放行到下面的
    # singleExpr 判定 (TypedExprFunctionSingleExpressionBodyExpr 对 void 已
    # 正确返回 "") 走内联语句体回落, 而不是被当成三元表达式囫囵吞掉、连一个
    # 语句都不构建。非 void 函数的排除判定保持不变 (仍可能是三元 if-表达式)。
    let bodyLooksLikeIfExpr = parser.ParserStartsWith(bodyTrim, "if ") &&
                              scope.returnType != "" &&
                              scope.returnType != "void"
    if !parser.ParserStartsWith(bodyTrim, "return ") &&
       !bodyLooksLikeIfExpr:
        let topLevelReturnExpr = TypedExprFunctionTopLevelReturnExpr(ctx,
                                                                    scope,
                                                                    returnLineNumber)
        if topLevelReturnExpr != "":
            returnExpr = topLevelReturnExpr
        else:
            let singleExpr = TypedExprFunctionSingleExpressionBodyExpr(ctx,
                                                                       scope,
                                                                       returnLineNumber)
            returnExpr = singleExpr
            let singleExprEmpty = returnExpr == ""
            if singleExprEmpty && bodyLineNumber == scope.startLine && bodyTrim != "":
                # 单行函数体糖 `fn f(x) = STMT` (STMT 非 return/if, 函数无返回值
                # 故 TypedExprFunctionSingleExpressionBodyExpr 对 void 正确拒绝
                # 把它当表达式体, singleExpr==""): bodyText 与函数签名同一行。
                # returnExpr 到这里已被清空丢弃, 而通用逐行语句扫描器
                # (TypedExprIrAppendStatementsForScope) 把 <= scope.startLine 的
                # 行整体当函数签名排除 (多行函数体永远在 startLine+1 起, 该排除
                # 对多行是对的) —— 两头都不认领, STMT 的副作用(赋值/调用)静默
                # 丢失。复用同一通用扫描器, 只把范围收窄成"仅 startLine 这一
                # 行", 不引入新判定标准、不改变多行函数体的既有行为。
                var inlineBodyScope: TypedExprFunctionScope
                inlineBodyScope.sourcePath = strings.CloneStr(scope.sourcePath)
                inlineBodyScope.name = strings.CloneStr(scope.name)
                inlineBodyScope.producerDeclarationOrdinal =
                    scope.producerDeclarationOrdinal
                inlineBodyScope.startLine = scope.startLine
                inlineBodyScope.endLine = scope.endLine
                inlineBodyScope.returnType = strings.CloneStr(scope.returnType)
                inlineBodyScope.genericNameJoin =
                    strings.CloneStr(scope.genericNameJoin)
                inlineBodyScope.genericNamesComplete = scope.genericNamesComplete
                inlineBodyScope.paramTypeJoin = strings.CloneStr(scope.paramTypeJoin)
                inlineBodyScope.paramTypesComplete = scope.paramTypesComplete
                inlineBodyScope.borrowResult = scope.borrowResult
                inlineBodyScope.borrowsArguments = scope.borrowsArguments
                inlineBodyScope.manualConsumePresent = scope.manualConsumePresent
                inlineBodyScope.manualConsumeFunctionDeclarationRow =
                    scope.manualConsumeFunctionDeclarationRow
                inlineBodyScope.manualConsumeTargetParameterOrdinal =
                    scope.manualConsumeTargetParameterOrdinal
                inlineBodyScope.manualConsumeSourceParameterOrdinal =
                    scope.manualConsumeSourceParameterOrdinal
                inlineBodyScope.manualConsumeTargetParameterDeclarationRow =
                    scope.manualConsumeTargetParameterDeclarationRow
                inlineBodyScope.manualConsumeSourceParameterDeclarationRow =
                    scope.manualConsumeSourceParameterDeclarationRow
                inlineBodyScope.manualConsumeTargetTypeId =
                    scope.manualConsumeTargetTypeId
                inlineBodyScope.manualConsumeSourceTypeId =
                    scope.manualConsumeSourceTypeId
                inlineBodyScope.manualConsumeEffectCid =
                    scope.manualConsumeEffectCid
                inlineBodyScope.startLine = scope.startLine - 1
                inlineBodyScope.endLine = scope.startLine
                TypedExprIrAppendStatementsForScope(ir,
                                                    ctx,
                                                    sourceContexts,
                                                    inlineBodyScope,
                                                    facts,
                                                    factStartIndex,
                                                    factEndIndex)
    var params: TypedExprParam[]
    TypedExprFunctionParamsInto(TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine), params)
    var paramNodeIndices: int32[]
    TypedExprIrAddParamNodes(ir,
                             scope,
                             params,
                             paramNodeIndices)
    if ir.valueExprTreeBorrowLease:
        TypedExprIrAppendParameterValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len)
    let generatedStatementStart = ir.statements2_statementIndexs.len
    TypedExprIrAppendLocalDeclStatementsForScope(ir, ctx, sourceContexts, scope)
    let generatedStatementEnd = ir.statements2_statementIndexs.len
    TypedExprIrAppendStatementsForScope(ir, ctx, sourceContexts, share(scope), facts, factStartIndex, factEndIndex)
    TypedExprIrAppendUnrepresentedTopLevelBodyStatements(ir,
                                                         ctx,
                                                         sourceContexts,
                                                         scope,
                                                         statementStart,
                                                         returnLineNumber)
    TypedExprIrAppendControlTransferStatementsForScope(ir, ctx, scope, statementStart)
    let firstBindingCallFactIndex: int32 = TypedExprIrFirstBindingCallFactIndex(facts,
                                                                                bodyLineNumber,
                                                                                factStartIndex,
                                                                                factEndIndex)
    if firstBindingCallFactIndex >= 0:
        let _ = TypedExprIrAddLetCallNode(ir,
                                          share(ctx.sourcePath),
                                          share(scope.name),
                                          bodyLineNumber,
                                          share(TypedExprFactAt(
                                              facts,
                                              firstBindingCallFactIndex).exprId))
    let returnNodeIndex = TypedExprIrBuildReturnNode(ir,
                                                     ctx,
                                                     scope,
                                                     returnLineNumber,
                                                     returnExpr,
                                                     params,
                                                     paramNodeIndices)
    var legacyExprLayer: parser.NormalizedExprLayer
    var legacyScopeIndex: TypedExprNormalizedScopeIndex
    legacyScopeIndex.lookup = parser.ParserSourcePathIndexLookupInit(8)
    TypedExprIrMaterializeFunctionScopes(ir,
                                         ctx,
                                         scope,
                                         legacyExprLayer,
                                         legacyScopeIndex,
                                         generatedStatementStart,
                                         generatedStatementEnd,
                                         statementStart,
                                         ir.statements2_statementIndexs.len,
                                         fnIr)
    fnIr.bodyLineNumber = bodyLineNumber
    fnIr.returnExpr = returnExpr
    fnIr.returnNodeIndex = returnNodeIndex
    fnIr.statementCount = ir.statements2_statementIndexs.len - statementStart
    fnIr.nodeCount = ir.nodes2_nodeIndexs.len - nodeStart
    if ir.valueExprTreeBorrowLease:
        TypedExprIrAppendMissingCallResultValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len, nodeStart)
        TypedExprIrAppendMissingManagedTemporaryValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len, nodeStart)
    fnIr.valueDefinitionCount =
        TypedExprValueDefinitionAuthorityCount(ir) -
        fnIr.valueDefinitionStart
    typedExprIrBindFunctionManualConsumeEffect(ir, scope, fnIr)
    TypedExprIrAppendFunction(ir, fnIr)

@borrows
fn TypedExprBuildIrForScopeWithFactsAndExprLayer(ctx: var TypedExprSourceContext,
                                                  sourceContexts: TypedExprSourceContext[],
                                                  scope: TypedExprFunctionScope,
                                                  facts: var TypedExprFactTable,
                                                  factStartIndex: int32,
                                                  factEndIndex: int32,
                                                  exprLayer: var parser.NormalizedExprLayer,
                                                  normalizedScopeIndex: var TypedExprNormalizedScopeIndex,
                                                  exprStartIndex: int32,
                                                  exprEndIndex: int32,
                                                  ir: var TypedExprIr) =
    TypedExprTraceLine( "typed_ir_scope_build:enter")
    let scopeDebug = TypedExprScopeDebugEnvName() == scope.name ||
                     TypedExprFilterDebugEnvName() == scope.name
    let nodeStart = ir.nodes2_nodeIndexs.len
    let statementStart = ir.statements2_statementIndexs.len
    var fnIr: TypedExprIrFunction
    TypedExprTraceLine( "typed_ir_scope_build:before_header")
    fnIr.sourcePath = share(ctx.sourcePath)
    fnIr.functionName = share(scope.name)
    fnIr.signatureLineNumber = scope.startLine
    fnIr.endLineNumber = scope.endLine
    fnIr.returnType = share(scope.returnType)
    fnIr.resultExprClass = scope.borrowResult ?
        TypedExprExprBorrowed : TypedExprExprOwned
    fnIr.borrowsArguments = scope.borrowsArguments
    fnIr.nodeStart = nodeStart
    fnIr.statementStart = statementStart
    fnIr.returnNodeIndex = -1
    fnIr.valueDefinitionStart =
        TypedExprValueDefinitionAuthorityCount(ir)
    fnIr.valueDefinitionCount = 0
    fnIr.valueDefinitionGroupStart =
        TypedExprValueDefinitionGroupAuthorityCount(ir)
    fnIr.valueDefinitionGroupCount = 0
    if ir.valueExprTreeBorrowLease:
        TypedExprIrRegisterValueDefinitionFunctionGroups(
            ir,
            exprLayer,
            exprStartIndex,
            exprEndIndex,
            scope,
            ir.functions2_functionNameIds.len,
            fnIr.valueDefinitionGroupStart,
            fnIr.valueDefinitionGroupCount)
    if scopeDebug:
        TypedExprTraceStderrLine(true,
                                 Fmt"scope_dbg:entry name={scope.name} start={scope.startLine} end={scope.endLine} lines={ctx.lines.len} source={ctx.sourcePath}")
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        TypedExprIrMaterializeFunctionScopes(ir,
                                             ctx,
                                             scope,
                                             exprLayer,
                                             normalizedScopeIndex,
                                             statementStart,
                                             statementStart,
                                             statementStart,
                                             statementStart,
                                             fnIr)
        typedExprIrBindFunctionManualConsumeEffect(ir, scope, fnIr)
        TypedExprIrAppendFunction(ir, fnIr)
        return
    var bodyLineNumber: int32
    TypedExprTraceLine( "typed_ir_scope_build:before_body")
    let bodyText = TypedExprFunctionBodyLine(ctx, scope, bodyLineNumber)
    if scopeDebug:
        TypedExprTraceStderrLine(true,
                                 Fmt"scope_dbg:body name={scope.name} body_line={bodyLineNumber} body_text={bodyText}")
    TypedExprTraceLine( "typed_ir_scope_build:after_body")
    var returnExpr = TypedExprReturnExprFromBody(bodyText)
    var returnLineNumber = bodyLineNumber
    let bodyTrim = chengpath.PathTrim(bodyText)
    TypedExprTraceLine( "typed_ir_scope_build:after_trim")
    # T38B: 同款判定, 见 TypedExprBuildIrForScope 的 bodyLooksLikeIfExpr 注释。
    let bodyLooksLikeIfExpr = parser.ParserStartsWith(bodyTrim, "if ") &&
                              scope.returnType != "" &&
                              scope.returnType != "void"
    if !parser.ParserStartsWith(bodyTrim, "return ") &&
       !bodyLooksLikeIfExpr:
        let topLevelReturnExpr = TypedExprFunctionTopLevelReturnExpr(ctx,
                                                                    scope,
                                                                    returnLineNumber)
        if topLevelReturnExpr != "":
            returnExpr = topLevelReturnExpr
        else:
            let singleExpr = TypedExprFunctionSingleExpressionBodyExpr(ctx,
                                                                       scope,
                                                                       returnLineNumber)
            returnExpr = singleExpr
            let singleExprEmpty = returnExpr == ""
            if singleExprEmpty && bodyLineNumber == scope.startLine && bodyTrim != "":
                # 单行函数体糖 `fn f(x) = STMT` (STMT 非 return/if, 函数无返回值):
                # 见 TypedExprBuildIrForScope 同款注释, 同一根因两处独立实现。
                var inlineBodyScope = share(scope)
                inlineBodyScope.startLine = scope.startLine - 1
                inlineBodyScope.endLine = scope.startLine
                TypedExprIrAppendStatementsForScopeWithFactsAndExprLayer(ir,
                                                                         ctx,
                                                                         sourceContexts,
                                                                         inlineBodyScope,
                                                                         facts,
                                                                         factStartIndex,
                                                                         factEndIndex,
                                                                         exprLayer,
                                                                         exprStartIndex,
                                                                         exprEndIndex,
                                                                         true)
    TypedExprTraceLine( "typed_ir_scope_build:before_params")
    var params: TypedExprParam[]
    TypedExprFunctionParamsInto(TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine), params)
    TypedExprTraceLine( "typed_ir_scope_build:after_params")
    var paramNodeIndices: int32[]
    TypedExprTraceLine( "typed_ir_scope_build:before_param_nodes")
    TypedExprIrAddParamNodes(ir,
                             scope,
                             params,
                             paramNodeIndices)
    if ir.valueExprTreeBorrowLease:
        TypedExprIrAppendParameterValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len)
    TypedExprTraceLine( "typed_ir_scope_build:after_param_nodes")
    TypedExprTraceLine( "typed_ir_scope_build:before_locals")
    let generatedStatementStart = ir.statements2_statementIndexs.len
    if scopeDebug:
        TypedExprTraceStderrLine(true, Fmt"scope_dbg:before_locals rss={os.ProcessRssBytes()}")
    TypedExprIrAppendLocalDeclStatementsForScope(ir, ctx, sourceContexts, scope)
    let generatedStatementEnd = ir.statements2_statementIndexs.len
    TypedExprTraceLine( "typed_ir_scope_build:after_locals")
    if scopeDebug:
        TypedExprTraceStderrLine(true, Fmt"scope_dbg:after_locals rss={os.ProcessRssBytes()}")
    TypedExprTraceLine( "typed_ir_scope_build:before_needs_structured")
    let includeStructuredStatements = TypedExprScopeNeedsStructuredStatements(ctx,
                                                                             scope,
                                                                             params,
                                                                             returnExpr,
                                                                             facts,
                                                                             factStartIndex,
                                                                             factEndIndex,
                                                                             exprLayer,
                                                                             exprStartIndex,
                                                                             exprEndIndex)
    if scope.name == "p256ConstBig8":
        os.WriteLine(os.GetStderr(), Fmt"")
    TypedExprTraceLine( "typed_ir_scope_build:after_needs_structured")
    TypedExprTraceLine( "typed_ir_scope_build:before_append_statements")
    if scopeDebug:
        TypedExprTraceStderrLine(true, Fmt"scope_dbg:before_append_statements rss={os.ProcessRssBytes()}")
    TypedExprIrAppendStatementsForScopeWithFactsAndExprLayer(ir,
                                                             ctx,
                                                             sourceContexts,
                                                             share(scope),
                                                             facts,
                                                             factStartIndex,
                                                             factEndIndex,
                                                             exprLayer,
                                                             exprStartIndex,
                                                             exprEndIndex,
                                                             includeStructuredStatements)
    TypedExprTraceLine( "typed_ir_scope_build:after_append_statements")
    TypedExprTraceLine( "typed_ir_scope_build:before_unrepresented")
    if scopeDebug:
        TypedExprTraceStderrLine(true, Fmt"scope_dbg:before_unrepresented rss={os.ProcessRssBytes()}")
    TypedExprIrAppendUnrepresentedTopLevelBodyStatements(ir,
                                                         ctx,
                                                         sourceContexts,
                                                         scope,
                                                         statementStart,
                                                         returnLineNumber)
    TypedExprTraceLine( "typed_ir_scope_build:after_unrepresented")
    if scopeDebug:
        TypedExprTraceStderrLine(true, Fmt"scope_dbg:after_unrepresented rss={os.ProcessRssBytes()}")
    TypedExprTraceLine( "typed_ir_scope_build:before_first_binding")
    let firstBindingCallFactIndex: int32 = TypedExprIrFirstBindingCallFactIndex(facts,
                                                                                bodyLineNumber,
                                                                                factStartIndex,
                                                                                factEndIndex)
    TypedExprTraceLine( "typed_ir_scope_build:after_first_binding")
    if firstBindingCallFactIndex >= 0:
        let _ = TypedExprIrAddLetCallNode(ir,
                                          share(ctx.sourcePath),
                                          share(scope.name),
                                          bodyLineNumber,
                                          share(TypedExprFactAt(
                                              facts,
                                              firstBindingCallFactIndex).exprId))
    TypedExprTraceLine( "typed_ir_scope_build:before_return_node")
    let returnNodeIndex = TypedExprIrBuildReturnNode(ir,
                                                     ctx,
                                                     scope,
                                                     returnLineNumber,
                                                     returnExpr,
                                                     params,
                                                     paramNodeIndices)
    TypedExprIrMaterializeFunctionScopes(ir,
                                         ctx,
                                         scope,
                                         exprLayer,
                                         normalizedScopeIndex,
                                         generatedStatementStart,
                                         generatedStatementEnd,
                                         statementStart,
                                         ir.statements2_statementIndexs.len,
                                         fnIr)
    TypedExprTraceLine( "typed_ir_scope_build:after_return_node")
    fnIr.bodyLineNumber = bodyLineNumber
    fnIr.returnExpr = returnExpr
    fnIr.returnNodeIndex = returnNodeIndex
    fnIr.statementCount = ir.statements2_statementIndexs.len - statementStart
    fnIr.nodeCount = ir.nodes2_nodeIndexs.len - nodeStart
    if ir.valueExprTreeBorrowLease:
        TypedExprIrAppendMissingCallResultValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len, nodeStart)
        TypedExprIrAppendMissingManagedTemporaryValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len, nodeStart)
    fnIr.valueDefinitionCount =
        TypedExprValueDefinitionAuthorityCount(ir) -
        fnIr.valueDefinitionStart
    TypedExprTraceLine( "typed_ir_scope_build:before_add_function")
    typedExprIrBindFunctionManualConsumeEffect(ir, scope, fnIr)
    TypedExprIrAppendFunction(ir, fnIr)
    TypedExprTraceLine( "typed_ir_scope_build:after_add_function")

fn TypedExprBuildIrForScopeFromExprLayer(ctx: var TypedExprSourceContext,
                                          sourceContexts: var TypedExprSourceContext[],
                                          scope: TypedExprFunctionScope,
                                          exprLayer: var parser.NormalizedExprLayer,
                                          normalizedScopeIndex: var TypedExprNormalizedScopeIndex,
                                          exprStartIndex: int32,
                                          exprEndIndex: int32,
                                          ir: var TypedExprIr) =
    let nodeStart = ir.nodes2_nodeIndexs.len
    let statementStart = ir.statements2_statementIndexs.len
    var fnIr: TypedExprIrFunction
    fnIr.sourcePath = ctx.sourcePath
    fnIr.functionName = scope.name
    fnIr.signatureLineNumber = scope.startLine
    fnIr.endLineNumber = scope.endLine
    fnIr.returnType = scope.returnType
    fnIr.resultExprClass = scope.borrowResult ?
        TypedExprExprBorrowed : TypedExprExprOwned
    fnIr.borrowsArguments = scope.borrowsArguments
    fnIr.nodeStart = nodeStart
    fnIr.statementStart = statementStart
    fnIr.returnNodeIndex = -1
    fnIr.valueDefinitionStart =
        TypedExprValueDefinitionAuthorityCount(ir)
    fnIr.valueDefinitionCount = 0
    fnIr.valueDefinitionGroupStart =
        TypedExprValueDefinitionGroupAuthorityCount(ir)
    fnIr.valueDefinitionGroupCount = 0
    if ir.valueExprTreeBorrowLease:
        TypedExprIrRegisterValueDefinitionFunctionGroups(
            ir,
            exprLayer,
            exprStartIndex,
            exprEndIndex,
            scope,
            ir.functions2_functionNameIds.len,
            fnIr.valueDefinitionGroupStart,
            fnIr.valueDefinitionGroupCount)
    if scope.startLine <= 0 ||
       scope.startLine > TypedExprSourceContextLineCount(ctx):
        TypedExprIrMaterializeFunctionScopes(ir,
                                             ctx,
                                             scope,
                                             exprLayer,
                                             normalizedScopeIndex,
                                             statementStart,
                                             statementStart,
                                             statementStart,
                                             statementStart,
                                             fnIr)
        typedExprIrBindFunctionManualConsumeEffect(ir, scope, fnIr)
        TypedExprIrAppendFunction(ir, fnIr)
        return
    var bodyLineNumber: int32
    let bodyText = TypedExprFunctionBodyLine(ctx, scope, bodyLineNumber)
    var returnExpr = TypedExprReturnExprFromBody(bodyText)
    var returnLineNumber = bodyLineNumber
    let bodyTrim = chengpath.PathTrim(bodyText)
    # T38B: `fn f(...) = if c: STMT` 单行函数体糖——STMT 恰好是控制头 suite
    # 时, "if " 前缀原先无条件排除出下面这条分支, 整段文本原样交给
    # TypedExprReturnExprFromBody 当返回表达式 (只在函数确有返回值类型、
    # body 是 `if c: a else: b` 三元 if-表达式时才是对的)。但 void 函数的
    # "if " 单行体只可能是控制语句形态 (`if c: 赋值/调用`, suite ::= statement
    # 钦定合法, 见 docs/cheng-formal-spec.md:247), 必须放行到下面的
    # singleExpr 判定 (TypedExprFunctionSingleExpressionBodyExpr 对 void 已
    # 正确返回 "") 走内联语句体回落, 而不是被当成三元表达式囫囵吞掉、连一个
    # 语句都不构建。非 void 函数的排除判定保持不变 (仍可能是三元 if-表达式)。
    let bodyLooksLikeIfExpr = parser.ParserStartsWith(bodyTrim, "if ") &&
                              scope.returnType != "" &&
                              scope.returnType != "void"
    if !parser.ParserStartsWith(bodyTrim, "return ") &&
       !bodyLooksLikeIfExpr:
        let topLevelReturnExpr = TypedExprFunctionTopLevelReturnExpr(ctx,
                                                                    scope,
                                                                    returnLineNumber)
        if topLevelReturnExpr != "":
            returnExpr = topLevelReturnExpr
        else:
            let singleExpr = TypedExprFunctionSingleExpressionBodyExpr(ctx,
                                                                       scope,
                                                                       returnLineNumber)
            returnExpr = singleExpr
            let singleExprEmpty = returnExpr == ""
            if singleExprEmpty && bodyLineNumber == scope.startLine && bodyTrim != "":
                # 单行函数体糖 `fn f(x) = STMT` (STMT 非 return/if, 函数无返回值):
                # 见 TypedExprBuildIrForScope 同款注释, 同一根因三处独立实现。
                var inlineBodyScope = share(scope)
                inlineBodyScope.startLine = scope.startLine - 1
                inlineBodyScope.endLine = scope.startLine
                TypedExprIrAppendStatementsForScopeFromExprLayer(ir,
                                                                 ctx,
                                                                 sourceContexts,
                                                                 inlineBodyScope,
                                                                 exprLayer,
                                                                 exprStartIndex,
                                                                 exprEndIndex)
    var params: TypedExprParam[]
    TypedExprFunctionParamsInto(TypedExprFunctionDeclHeaderTextForContext(ctx, scope.startLine), params)
    var paramNodeIndices: int32[]
    TypedExprIrAddParamNodes(ir,
                             scope,
                             params,
                             paramNodeIndices)
    if ir.valueExprTreeBorrowLease:
        TypedExprIrAppendParameterValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len)
    let generatedStatementStart = ir.statements2_statementIndexs.len
    TypedExprIrAppendLocalDeclStatementsForScope(ir, ctx, sourceContexts, scope)
    let generatedStatementEnd = ir.statements2_statementIndexs.len
    TypedExprIrAppendStatementsForScopeFromExprLayer(ir,
                                                     ctx,
                                                     sourceContexts,
                                                     share(scope),
                                                     exprLayer,
                                                     exprStartIndex,
                                                     exprEndIndex)
    TypedExprIrAppendUnrepresentedTopLevelBodyStatements(ir,
                                                         ctx,
                                                         sourceContexts,
                                                         scope,
                                                         statementStart,
                                                         returnLineNumber)
    let returnNodeIndex = TypedExprIrBuildReturnNode(ir,
                                                     ctx,
                                                     scope,
                                                     returnLineNumber,
                                                     returnExpr,
                                                     params,
                                                     paramNodeIndices)
    TypedExprIrMaterializeFunctionScopes(ir,
                                         ctx,
                                         scope,
                                         exprLayer,
                                         normalizedScopeIndex,
                                         generatedStatementStart,
                                         generatedStatementEnd,
                                         statementStart,
                                         ir.statements2_statementIndexs.len,
                                         fnIr)
    fnIr.bodyLineNumber = bodyLineNumber
    fnIr.returnExpr = returnExpr
    fnIr.returnNodeIndex = returnNodeIndex
    fnIr.statementCount = ir.statements2_statementIndexs.len - statementStart
    fnIr.nodeCount = ir.nodes2_nodeIndexs.len - nodeStart
    if ir.valueExprTreeBorrowLease:
        TypedExprIrAppendMissingCallResultValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len, nodeStart)
        TypedExprIrAppendMissingManagedTemporaryValueDefinitionsExact(
            ir, scope, ir.functions2_functionNameIds.len, nodeStart)
    fnIr.valueDefinitionCount =
        TypedExprValueDefinitionAuthorityCount(ir) -
        fnIr.valueDefinitionStart
    typedExprIrBindFunctionManualConsumeEffect(ir, scope, fnIr)
    TypedExprIrAppendFunction(ir, fnIr)

@borrows
fn TypedExprExprLayerEndIndexForSource(exprLayer: var parser.NormalizedExprLayer,
                                        sourcePathRaw: str,
                                        startIndex: int32): int32 =
    if startIndex < 0:
        return 0
    var sourcePath: str
    var pathErr: str
    if !TypedExprLexicalSourcePath(sourcePathRaw, sourcePath, pathErr):
        panic(pathErr)
    if sourcePathRaw != sourcePath:
        panic(Fmt"typed expr: expr source range requested with noncanonical identity source={sourcePathRaw} canonical={sourcePath}")
    for i in startIndex..<exprLayer.exprs.len:
        if exprLayer.exprs[i].sourcePath != sourcePath:
            return i
    return exprLayer.exprs.len

fn TypedExprClearExprLayerRange(exprLayer: var parser.NormalizedExprLayer,
                                  startIndexRaw: int32,
                                  endIndexRaw: int32) =
    var startIndex = startIndexRaw
    if startIndex < 0:
        startIndex = 0
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > exprLayer.exprs.len:
        endIndex = exprLayer.exprs.len
    for i in startIndex..<endIndex:
        var emptyExpr: parser.NormalizedExpr
        exprLayer.exprs[i] = emptyExpr

@borrows
fn TypedExprSourceRangeIndexBuildFromExprLayer(exprLayer: var parser.NormalizedExprLayer): TypedExprSourceRangeIndex =
    var index: TypedExprSourceRangeIndex
    index.sourcePaths = []
    index.starts = []
    index.ends = []
    index.lookup = parser.ParserSourcePathIndexLookupInit(
        typedExprCheckedInt32Capacity(
            typedExprCheckedAdd64(
                typedExprCheckedMul64(Int64(exprLayer.sourceCount), 2,
                                      "expr_source_range_capacity"),
                8, "expr_source_range_capacity"),
            "expr_source_range_capacity"))
    var cursor: int32
    while cursor < exprLayer.exprs.len:
        var sourcePath: str
        var pathErr: str
        if !TypedExprLexicalSourcePath(exprLayer.exprs[cursor].sourcePath,
                                       sourcePath,
                                       pathErr):
            panic(pathErr)
        if exprLayer.exprs[cursor].sourcePath != sourcePath:
            panic(Fmt"typed expr: expr source producer emitted noncanonical identity source={exprLayer.exprs[cursor].sourcePath} canonical={sourcePath} index={cursor}")
        var endIndex = cursor + 1
        while endIndex < exprLayer.exprs.len:
            if exprLayer.exprs[endIndex].sourcePath != sourcePath:
                break
            endIndex = endIndex + 1
        TypedExprSourceRangeIndexAdd(index, sourcePath, cursor, endIndex)
        cursor = endIndex
    return index

fn typedExprNormalizedExprLayerTerminalRelease(
        exprLayer: var parser.NormalizedExprLayer) =
    var receipt: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        exprLayer, receipt)

fn TypedExprReadNormalizedExprLayerForSourceTexts(sourceTexts: var TypedExprSourceText[],
                                                   exprLayer: var parser.NormalizedExprLayer,
                                                   err: var str): bool =
    typedExprNormalizedExprLayerTerminalRelease(exprLayer)
    for i in 0..<sourceTexts.len:
        os.ProcessResourceGuardCheck()
        var sourceText = sourceTexts[i].text
        if sourceText == "" && sourceTexts[i].sourcePath != "":
            if sourceTexts[i].snapshotOnly:
                err = Fmt" typed expr: snapshot-only source body missing source={sourceTexts[i].sourcePath} index={i}"
                return false
            sourceText = chengpath.ReadTextFile("", sourceTexts[i].sourcePath)
            if sourceText != "":
                var loadedSourceText = sourceTexts[i]
                loadedSourceText.text = sourceText
                sourceTexts[i] = loadedSourceText
        var sourceExprLayer: parser.NormalizedExprLayer
        if !parser.ParserReadNormalizedExprLayerFromText(sourceTexts[i].sourcePath,
                                                         sourceText,
                                                         sourceExprLayer,
                                                         err):
            typedExprNormalizedExprLayerTerminalRelease(sourceExprLayer)
            typedExprNormalizedExprLayerTerminalRelease(exprLayer)
            return false
        if sourceTexts[i].sourcePath != "":
            TypedExprClearSourceTextBody(sourceTexts[i])
        parser.NormalizedExprLayerAdd(exprLayer, sourceExprLayer)
        typedExprNormalizedExprLayerTerminalRelease(sourceExprLayer)
    err = ""
    return true

@borrows
fn TypedExprIrAppendBindingValue(ir: var TypedExprIr,
                                  binding: TypedExprBinding) =
    if !binding.globalFlag:
        TypedExprIrAppendLocalBinding(ir,
                                      share(binding.sourcePath),
                                      share(binding.functionName),
                                      binding.lineNumber,
                                      share(binding.name),
                                      share(binding.typeText))
        return
    var seenGlobal = false
    for globalIndex in 0..<ir.globalNames.len:
        if globalIndex >= ir.globalSourcePaths.len:
            continue
        if ir.globalSourcePaths[globalIndex] == binding.sourcePath &&
           ir.globalNames[globalIndex] == binding.name:
            seenGlobal = true
            break
    if seenGlobal:
        return
    add(ir.globalSourcePaths, share(binding.sourcePath))
    add(ir.globalNames, share(binding.name))
    add(ir.globalTypes, share(binding.typeText))
    add(ir.globalProducerSourceIndexes,
        binding.producerSourceIndex)
    add(ir.globalDeclarationSourceLocalRows,
        binding.declarationSourceLocalRow)
    add(ir.globalInitValues, share(binding.initValueText))

fn TypedExprIrGlobalParserIdentityComplete(
        ir: var TypedExprIr): bool =
    let count = ir.globalNames.len
    if ir.globalSourcePaths.len != count ||
       ir.globalTypes.len != count ||
       ir.globalInitValues.len != count ||
       ir.globalProducerSourceIndexes.len != count ||
       ir.globalDeclarationSourceLocalRows.len != count:
        return false
    for row in 0..<count:
        if ir.globalProducerSourceIndexes[row] < 0 ||
           ir.globalDeclarationSourceLocalRows[row] < 0:
            return false
    return true

fn TypedExprIrAppendBindingFromContextRow(ir: var TypedExprIr,
                                           ctx: var TypedExprSourceContext,
                                           bindingIndex: int32) =
    if bindingIndex < 0 || bindingIndex >= ctx.bindings.len:
        panic("typed expr: binding row index out of range")
    TypedExprIrAppendBindingValue(ir, share(ctx.bindings[bindingIndex]))

fn TypedExprIrAppendBindingsFromContext(ir: var TypedExprIr,
                                         ctx: var TypedExprSourceContext) =
    for bindingIndex in 0..<ctx.bindings.len:
        TypedExprIrAppendBindingFromContextRow(ir, ctx, bindingIndex)

@borrows
fn TypedExprMetadataContextHasScope(ctx: var TypedExprSourceContext,
                                     scope: TypedExprFunctionScope): bool =
    for i in 0..<ctx.scopes.len:
        if ctx.scopes[i].name != scope.name:
            continue
        if ctx.scopes[i].startLine != scope.startLine:
            continue
        return true
    return false

@borrows
fn TypedExprIrAppendMetadataDefinitionsForFilter(ir: var TypedExprIr,
                                                  metadataContexts: var TypedExprSourceContext[],
                                                  filterIndex: TypedExprFunctionFilterIndex,
                                                  traceTypedIr: bool,
                                                  buildIndexAlreadyValidated: bool) =
    typedExprIrPrepareExactLayoutIndexesFromParserAuthority(
        ir, metadataContexts)
    if !buildIndexAlreadyValidated:
        TypedExprBuildSourceContextIndex(ir, metadataContexts)
    # Enum rows are global scalar metadata (name/type/ordinal/path). Cross-module
    # enum folding (TypedExprIrRuntimeScalarType -> TypedExprIrTypeIsEnum) must see
    # every module's rows BEFORE any batch builds function IR: with reachable-batch
    # filtering the use-site source can be processed ahead of the enum's defining
    # module, and `k == mod.EnumVal` then compares `mod.EnumType` vs int32 at the
    # level==2 cmp gate and the whole node tree bails (bail=44 family). Rows are
    # tiny and the append is dedup-guarded, so they are exempt from the filter.
    for ci in 0..<metadataContexts.len:
        TypedExprIrAppendEnumValuesFromContext(ir, metadataContexts[ci])
    # importc decl rows (name/sourcePath/returnType/C symbol alias) are the same
    # kind of global scalar metadata as enum rows above, and need the same
    # exemption for the same structural reason: reachable-batch filtering decides
    # which source files to visit based on which FUNCTIONS are reachable from the
    # entry point, not which DECLARATIONS a cross-module qualified call references.
    # A call site resolves its C symbol alias from this table at lowering time
    # (TypedExprIrLookupImportcTargetSymbol); if the @importc fn's declaring module
    # is never independently "reachable" in any round, its row never lands here and
    # the alias lookup misses permanently — the raw qualified Cheng name (e.g.
    # "mod.FnName") is then emitted as the link symbol instead of the C alias,
    # producing an unresolved symbol at link time (T70). Rows are tiny and the
    # append is dedup-guarded (TypedExprIrAddImportcDecl matches by sourcePath+
    # name), so they are exempt from the filter too.
    for ci in 0..<metadataContexts.len:
        TypedExprIrAppendImportcFunctionsFromContext(ir, metadataContexts[ci])
    # Module-level global binding rows are declaration authority, the same
    # kind of full-source metadata as the enum/importc/layout rows above. The
    # frozen projection records every context's globalFlag rows (full-source
    # pass), while the IR commit only happened on sources whose own build path
    # reached TypedExprIrAppendBindingValue — a source inside the compilation
    # set with no reachable function left ir<N projection=N and
    # typedExprFrozenIrGlobalsExact failed with global_commit_invalid. Publish
    # every context's globalFlag rows here through the same appender (deduped
    # by sourcePath+name, idempotent across reach rounds) so both sides share
    # one domain. Local (function-scoped) rows keep their own build paths.
    for ci in 0..<metadataContexts.len:
        for bindingIndex in 0..<metadataContexts[ci].bindings.len:
            if !metadataContexts[ci].bindings[bindingIndex].globalFlag:
                continue
            TypedExprIrAppendBindingValue(ir,
                share(metadataContexts[ci].bindings[bindingIndex]))
    # Layout rows are declaration authority, not function-body reachability.
    # A reachable function can name a type owned by an imported source that has
    # no reachable function of its own. Build the complete source domain once,
    # before the metadata index is frozen, so field lowering never depends on
    # which function source happened to enter the first frontier.
    for ci in 0..<metadataContexts.len:
        TypedExprIrAppendRefTypesFromContext(ir, metadataContexts[ci])
        TypedExprIrAppendTypeDefAliasesFromContext(ir,
                                                   metadataContexts[ci])
    for ci in 0..<metadataContexts.len:
        TypedExprTraceLine("typed_ir_stream:metadata_type_defs")
        if traceTypedIr && ci == 0:
            TypedExprTraceStderrLine(true, Fmt"typed_expr_ir_metadata_before_type_layouts scopes={metadataContexts[ci].scopes.len}")
        TypedExprIrAppendTypeLayoutsFromContext(ir, metadataContexts[ci], metadataContexts)
        if traceTypedIr && ci == 0:
            TypedExprTraceStderrLine(true, "typed_expr_ir_metadata_after_type_layouts")
    ir.typedExprGlobalMetadataReady = true

@borrows
fn typedExprIrAppendMetadataDefinitionsForFrozenFrontier(
        ir: var TypedExprIr,
        session: typedExprFrozenMetadataSession,
        metadataContexts: var TypedExprSourceContext[],
        sourceTexts: var TypedExprSourceText[],
        filterIndex: TypedExprFunctionFilterIndex,
        traceTypedIr: bool) =
    if !ir.typedExprGlobalMetadataReady:
        panic("typed expr: frozen metadata append lost first-round global definitions")
    for sourceIndex in 0..<sourceTexts.len:
        if !TypedExprFunctionFilterHasSource(filterIndex,
                                             sourceTexts[sourceIndex].sourcePath):
            continue
        let contextIndex = typedExprFrozenContextIndex(session,
                                                       sourceTexts[sourceIndex].sourcePath)
        let localContextIndex = TypedExprSourceContextLookup(
            metadataContexts,
            sourceTexts[sourceIndex].sourcePath)
        if contextIndex < 0 || localContextIndex < 0:
            panic(Fmt"typed expr: frozen metadata frontier context missing source={sourceTexts[sourceIndex].sourcePath}")
        if metadataContexts[localContextIndex].frozenMetadataProjection != session.projection ||
           metadataContexts[localContextIndex].frozenMetadataContextIndex != contextIndex:
            panic("typed expr: frozen metadata frontier projection view drift")
        if traceTypedIr && sourceIndex == 0:
            TypedExprTraceStderrLine(true,
                                     Fmt"typed_expr_ir_frozen_metadata_context scopes={metadataContexts[localContextIndex].scopes.len}")
        # Ref, alias and layout rows were committed once before seal. The
        # frontier may validate the selected projection identity, but it must
        # never append or clone global metadata again.

@borrows
fn TypedExprFunctionFilterAllowsScope(index: TypedExprFunctionFilterIndex,
                                       sourcePathRaw: str,
                                       scope: TypedExprFunctionScope): bool =
    return TypedExprFunctionFilterAllows(index,
                                         sourcePathRaw,
                                         scope.name,
                                         scope.startLine)

