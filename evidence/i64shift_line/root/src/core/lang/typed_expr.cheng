    projection.snapshotImportcHashes = []
    projection.snapshotImportcContextIndexes = []
    projection.snapshotImportcNameIds = []
    projection.snapshotImportcRowIndexes = []
    projection.importcs = typedExprFrozenImportcSoA()
    projection.importStarts = []
    projection.importCounts = []
    projection.importQualifierIds = []
    projection.importTargetSourcePathIds = []
    projection.importBuildEntryIndexes = []
    projection.importTargetBuildEntryIndexes = []
    projection.declaredStarts = []
    projection.declaredCounts = []
