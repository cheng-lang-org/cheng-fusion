# combo C Phase2: statements-only SoA clear. Lowers peak memory after lowering
# (frees statements; keeps functions2/nodes2 for the primary node evaluator).
# SoA equivalent of the removed `ir.statements = []` intermediate release.
fn TypedExprIrClearSoAStatementsData(ir: var TypedExprIr) =
    # Function-header scans cannot be queried after this handoff. Module const,
    # alias, enum, layout, and field metadata remain live for primary nodes.
    TypedExprBuildIndexReleaseContentCache(ir.buildIndex)
    ir.statements2_sourcePathIds = []
    ir.statements2_functionNameIds = []
    ir.statements2_statementIndexs = arenamod.ArenaArrayInt32Init()
