@borrows
fn typedExprMetadataSessionOwnerCheck(session: typedExprFrozenMetadataSession,
                                      operation: str) =
    if session != nil && memRefCount(session) != 1:
        panic(Fmt"typed expr: frozen metadata session owner is shared by value assignment operation={operation}")

@borrows
@borrow_result
fn typedExprMetadataSessionForTelemetry(ir: TypedExprIr,
                                        operation: str): typedExprFrozenMetadataSession =
    typedExprMetadataSessionOwnerCheck(ir.typedExprMetadataSession, operation)
    return ir.typedExprMetadataSession

fn TypedExprSealedBuildIndexValidationCount(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir, "validation telemetry")
    if session == nil:
        return 0
    return session.sealedValidationCount

fn TypedExprSealedBuildIndexMetadataRowsVisited(ir: var TypedExprIr): int64 =
    let session = typedExprMetadataSessionForTelemetry(ir, "metadata visit telemetry")
    if session == nil:
        return 0
    return session.metadataRowsVisitedAfterSeal

fn TypedExprSealedBuildIndexFullValidationCount(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir, "full validation telemetry")
    if session == nil:
        return 0
    return session.fullValidationCount

fn TypedExprSealedBuildIndexValidationEpoch(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir, "validation epoch telemetry")
    if session == nil:
        return 0
    if session.closed:
        return session.finalValidationEpoch
    return session.validationEpochAtSeal

fn TypedExprSealedBuildIndexMetadataRowCount(ir: var TypedExprIr): int32 =
    let session = typedExprMetadataSessionForTelemetry(ir, "metadata row telemetry")
    if session == nil:
