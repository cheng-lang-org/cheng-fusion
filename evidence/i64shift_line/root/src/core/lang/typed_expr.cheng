        return true
    if typedExprSharedMetadataColumnInto(
           ctx.declaredTypeProducerSourceIndexes, 12,
           "declaredTypeProducerSourceIndexes",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.declaredTypeDeclarationSourceLocalRows, 13,
           "declaredTypeDeclarationSourceLocalRows",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.declaredTypeBuiltinKinds, 14, "declaredTypeBuiltinKinds",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.refTypes, 15, "refTypes",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.typeDefAliasNames, 16, "typeDefAliasNames",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.typeDefAliasTargetTypes, 17, "typeDefAliasTargetTypes",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.typeFields, 18, "typeFields",
           columnId, columnName, refCount):
        return true
    if typedExprSharedMetadataColumnInto(
           ctx.coldCsgTypeRows, 19, "coldCsgTypeRows",
