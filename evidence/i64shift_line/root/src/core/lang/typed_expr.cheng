    projection.globalBindingTypeIds = []
    projection.globalBindingProducerSourceIndexes = []
    projection.globalBindingDeclarationSourceLocalRows = []
    projection.globalBindingMutableFlags = []
    projection.globalBindingInitValueIds = []
    projection.globalBindingBucketHeads = []
    projection.globalBindingNext = []
    projection.globalBindingHashes = []
    projection.scopes = typedExprFrozenScopeSoA()
    projection.signatures = typedExprFrozenScopeSoA()
    projection.scopeBucketHeads = []
    projection.scopeNext = []
    projection.scopeHashes = []
    projection.signatureBucketHeads = []
    projection.signatureNext = []
    projection.signatureHashes = []
    projection.snapshotFunctionBucketHeads = []
    projection.snapshotFunctionNext = []
    projection.snapshotFunctionHashes = []
    projection.snapshotImportcBucketHeads = []
