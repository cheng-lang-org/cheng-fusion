import std/seqs
import std/system
import cheng/core/lang/parser
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const ParserDiagnosticAuthoritySchemaVersionLatest: int32 = 1

# Structural authority exists only for rows backed by a sealed canonical
# parser sidecar. Source/span-only diagnostics remain solely in the portable
# DiagnosticFailureArtifact and must not manufacture parser identity.
const ParserDiagnosticAuthorityKindCanonicalSidecar: int32 = 1

# These values are the canonical parser sidecar anchor domain, not the
# DiagnosticFailureArtifact anchor domain.
const ParserDiagnosticAuthorityAnchorParserNode: int32 = 2
const ParserDiagnosticAuthorityAnchorOwnerDeclaration: int32 = 3
const ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration: int32 = 4

const ParserDiagnosticAuthoritySeverityError: int32 = 1
const ParserDiagnosticAuthoritySeverityWarning: int32 = 2
const ParserDiagnosticAuthoritySeverityInformation: int32 = 3
const ParserDiagnosticAuthoritySeverityHint: int32 = 4

const ParserDiagnosticAuthorityParserProjectionDomain: str = "cheng.compiler.parser_diagnostic_row"
const ParserDiagnosticAuthorityPayloadDomain: str = "cheng.parser.diagnostic_authority.payload"
const ParserDiagnosticAuthorityRowProofDomain: str = "cheng.parser.diagnostic_authority.row"
const ParserDiagnosticAuthorityRootDomain: str = "cheng.parser.diagnostic_authority.root"

type
    # Compact DOD projection of parser-owned failure evidence.  Every cross-row
    # identity is an int32 coordinate.  Paths, names and source lines are never
    # identity. `producerProjectionCids` must be supplied independently by the
    # parser projection point and frozen by the caller's producer receipt.
    ParserDiagnosticAuthority =
        schemaVersion: int32
        authorityKinds: int32[]
        # The parser reads one source tree and therefore emits local source row
        # zero. CompilerCSG later binds that row to a distinct portable global
        # source index; neither coordinate may be substituted for the other.
        parserLocalProducerSourceRows: int32[]
        portableProducerSourceIndexes: int32[]
        producerSourceByteLengths: int32[]
        producerContentCids: layout.FixedBytes32[]
        parserInputCids: layout.FixedBytes32[]
        sourceSidecarCids: layout.FixedBytes32[]
        diagnosticCompletionCids: layout.FixedBytes32[]
        anchorKinds: int32[]
        canonicalParserNodeRows: int32[]
        producerParserNodeRows: int32[]
        parserNodeKinds: int32[]
        parserNodeSpanStartBytes: int32[]
        parserNodeSpanEndBytes: int32[]
        ownerDeclarationSourceLocalRows: int32[]
        ownerDeclarationKinds: int32[]
        ownerDeclarationSpanStartBytes: int32[]
        ownerDeclarationSpanEndBytes: int32[]
        diagnosticSpanIds: int32[]
        diagnosticSpanStartBytes: int32[]
        diagnosticSpanEndBytes: int32[]
        severities: int32[]
        codes: str[]
        messages: str[]
        producerProjectionCids: layout.FixedBytes32[]
        proofCids: layout.FixedBytes32[]
        authorityRootCid: layout.FixedBytes32

    ParserDiagnosticAuthorityReleaseReceipt =
        hadPayload: bool
        sequenceCapacityBefore: int64
        logicalStringCountBefore: int64
        physicalFreeCount: int64
        orcReleaseCount: int64
        storageReleased: bool

@borrows
fn parserDiagnosticAuthorityCidObserved(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn parserDiagnosticAuthorityTextValid(value: str): bool =
    if value == "":
        return false
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 && value[index] != '\n' &&
           value[index] != '\r' && value[index] != '\t':
            return false
    return true

fn parserDiagnosticAuthorityAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn parserDiagnosticAuthorityAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    parserDiagnosticAuthorityAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn parserDiagnosticAuthorityAppendCid(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

fn parserDiagnosticAuthorityFinishCid(
        buf: var layout.ByteBuf): layout.FixedBytes32 =
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn parserDiagnosticAuthorityCheckedAdd(
        left: int32,
        right: int32,
        reason: str): int32 =
    if left < 0 || right < 0 || left > 2147483647 - right:
        panic(reason)
    return left + right

fn parserDiagnosticAuthorityCheckedMul(
        left: int32,
        right: int32,
        reason: str): int32 =
    if left < 0 || right < 0 ||
       (right != 0 && left > 2147483647 / right):
        panic(reason)
    return left * right

@borrows
fn ParserDiagnosticAuthorityParserProjectionCid(
        sourceIndex: int32,
        producerContentCid: layout.FixedBytes32,
        parserInputCid: layout.FixedBytes32,
        anchorKind: int32,
        canonicalParserNodeRow: int32,
        producerParserNodeRow: int32,
        ownerDeclarationSourceLocalRow: int32,
        ownerDeclarationKind: int32,
        diagnosticSpanId: int32,
        diagnosticSpanStartByte: int32,
        diagnosticSpanEndByte: int32,
        severity: int32,
        code: str,
        message: str): layout.FixedBytes32 =
    let codeCapacity = parserDiagnosticAuthorityCheckedAdd(
        512,
        code.len,
        "parser diagnostic authority: projection capacity overflow")
    let projectionCapacity = parserDiagnosticAuthorityCheckedAdd(
        codeCapacity,
        message.len,
        "parser diagnostic authority: projection capacity overflow")
    var buf = layout.ByteBufInit(projectionCapacity)
    parserDiagnosticAuthorityAppendText(
        buf, ParserDiagnosticAuthorityParserProjectionDomain)
    parserDiagnosticAuthorityAppendU32(buf, sourceIndex)
    parserDiagnosticAuthorityAppendCid(buf, producerContentCid)
    parserDiagnosticAuthorityAppendCid(buf, parserInputCid)
    parserDiagnosticAuthorityAppendU32(buf, anchorKind)
    parserDiagnosticAuthorityAppendU32(buf, canonicalParserNodeRow)
    if canonicalParserNodeRow >= 0:
        parserDiagnosticAuthorityAppendU32(buf, producerParserNodeRow)
    parserDiagnosticAuthorityAppendU32(
        buf, ownerDeclarationSourceLocalRow)
    if ownerDeclarationSourceLocalRow >= 0:
        parserDiagnosticAuthorityAppendU32(buf, ownerDeclarationKind)
    parserDiagnosticAuthorityAppendU32(buf, diagnosticSpanId)
    parserDiagnosticAuthorityAppendU32(buf, diagnosticSpanStartByte)
    parserDiagnosticAuthorityAppendU32(buf, diagnosticSpanEndByte)
    parserDiagnosticAuthorityAppendU32(buf, severity)
    parserDiagnosticAuthorityAppendText(buf, code)
    parserDiagnosticAuthorityAppendText(buf, message)
    return parserDiagnosticAuthorityFinishCid(buf)

fn ParserDiagnosticAuthorityParserProjectionCidAt(
        authority: var ParserDiagnosticAuthority,
        row: int32): layout.FixedBytes32 =
    if row < 0 || row >= authority.authorityKinds.len:
        return layout.FixedBytes32()
    return ParserDiagnosticAuthorityParserProjectionCid(
        authority.portableProducerSourceIndexes[row],
        authority.producerContentCids[row],
        authority.parserInputCids[row],
        authority.anchorKinds[row],
        authority.canonicalParserNodeRows[row],
        authority.producerParserNodeRows[row],
        authority.ownerDeclarationSourceLocalRows[row],
        authority.ownerDeclarationKinds[row],
        authority.diagnosticSpanIds[row],
        authority.diagnosticSpanStartBytes[row],
        authority.diagnosticSpanEndBytes[row],
        authority.severities[row],
        authority.codes[row],
        authority.messages[row])

fn parserDiagnosticAuthorityPayloadCidAt(
        authority: var ParserDiagnosticAuthority,
        row: int32): layout.FixedBytes32 =
    if row < 0 || row >= authority.authorityKinds.len:
        return layout.FixedBytes32()
    let codeCapacity = parserDiagnosticAuthorityCheckedAdd(
        640,
        authority.codes[row].len,
        "parser diagnostic authority: payload capacity overflow")
    let payloadCapacity = parserDiagnosticAuthorityCheckedAdd(
        codeCapacity,
        authority.messages[row].len,
        "parser diagnostic authority: payload capacity overflow")
    var buf = layout.ByteBufInit(payloadCapacity)
    parserDiagnosticAuthorityAppendText(
        buf, ParserDiagnosticAuthorityPayloadDomain)
    parserDiagnosticAuthorityAppendU32(buf, authority.schemaVersion)
    parserDiagnosticAuthorityAppendU32(
        buf, authority.authorityKinds[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.parserLocalProducerSourceRows[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.portableProducerSourceIndexes[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.producerSourceByteLengths[row])
    parserDiagnosticAuthorityAppendCid(
        buf, authority.producerContentCids[row])
    parserDiagnosticAuthorityAppendCid(
        buf, authority.parserInputCids[row])
    parserDiagnosticAuthorityAppendCid(
        buf, authority.sourceSidecarCids[row])
    parserDiagnosticAuthorityAppendCid(
        buf, authority.diagnosticCompletionCids[row])
    parserDiagnosticAuthorityAppendU32(buf, authority.anchorKinds[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.canonicalParserNodeRows[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.producerParserNodeRows[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.parserNodeKinds[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.parserNodeSpanStartBytes[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.parserNodeSpanEndBytes[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.ownerDeclarationSourceLocalRows[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.ownerDeclarationKinds[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.ownerDeclarationSpanStartBytes[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.ownerDeclarationSpanEndBytes[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.diagnosticSpanIds[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.diagnosticSpanStartBytes[row])
    parserDiagnosticAuthorityAppendU32(
        buf, authority.diagnosticSpanEndBytes[row])
    parserDiagnosticAuthorityAppendU32(buf, authority.severities[row])
    parserDiagnosticAuthorityAppendText(buf, authority.codes[row])
    parserDiagnosticAuthorityAppendText(buf, authority.messages[row])
    return parserDiagnosticAuthorityFinishCid(buf)

fn ParserDiagnosticAuthorityRowProofCid(
        authority: var ParserDiagnosticAuthority,
        row: int32): layout.FixedBytes32 =
    if row < 0 || row >= authority.producerProjectionCids.len:
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(288)
    parserDiagnosticAuthorityAppendText(
        buf, ParserDiagnosticAuthorityRowProofDomain)
    parserDiagnosticAuthorityAppendU32(buf, authority.schemaVersion)
    parserDiagnosticAuthorityAppendU32(buf, row)
    parserDiagnosticAuthorityAppendCid(
        buf, authority.sourceSidecarCids[row])
    parserDiagnosticAuthorityAppendCid(
        buf, authority.diagnosticCompletionCids[row])
    parserDiagnosticAuthorityAppendCid(
        buf, authority.producerProjectionCids[row])
    parserDiagnosticAuthorityAppendCid(
        buf, parserDiagnosticAuthorityPayloadCidAt(authority, row))
    return parserDiagnosticAuthorityFinishCid(buf)

fn ParserDiagnosticAuthorityRootCid(
        authority: var ParserDiagnosticAuthority): layout.FixedBytes32 =
    let proofBytes = parserDiagnosticAuthorityCheckedMul(
        authority.proofCids.len,
        layout.FixedBytes32Size,
        "parser diagnostic authority: root capacity overflow")
    let rootCapacity = parserDiagnosticAuthorityCheckedAdd(
        128,
        proofBytes,
        "parser diagnostic authority: root capacity overflow")
    var buf = layout.ByteBufInit(rootCapacity)
    parserDiagnosticAuthorityAppendText(
        buf, ParserDiagnosticAuthorityRootDomain)
    parserDiagnosticAuthorityAppendU32(buf, authority.schemaVersion)
    parserDiagnosticAuthorityAppendU32(buf, authority.proofCids.len)
    for row in 0..<authority.proofCids.len:
        parserDiagnosticAuthorityAppendCid(buf, authority.proofCids[row])
    return parserDiagnosticAuthorityFinishCid(buf)

fn parserDiagnosticAuthorityRowLess(
        authority: var ParserDiagnosticAuthority,
        left: int32,
        right: int32): bool =
    if authority.portableProducerSourceIndexes[left] !=
           authority.portableProducerSourceIndexes[right]:
        return authority.portableProducerSourceIndexes[left] <
               authority.portableProducerSourceIndexes[right]
    if authority.diagnosticSpanStartBytes[left] !=
           authority.diagnosticSpanStartBytes[right]:
        return authority.diagnosticSpanStartBytes[left] <
               authority.diagnosticSpanStartBytes[right]
    if authority.diagnosticSpanEndBytes[left] !=
           authority.diagnosticSpanEndBytes[right]:
        return authority.diagnosticSpanEndBytes[left] <
               authority.diagnosticSpanEndBytes[right]
    if authority.anchorKinds[left] != authority.anchorKinds[right]:
        return authority.anchorKinds[left] < authority.anchorKinds[right]
    if authority.producerParserNodeRows[left] !=
           authority.producerParserNodeRows[right]:
        return authority.producerParserNodeRows[left] <
               authority.producerParserNodeRows[right]
    return authority.ownerDeclarationSourceLocalRows[left] <
           authority.ownerDeclarationSourceLocalRows[right]

fn parserDiagnosticAuthorityColumnsStrictValidateInto(
        authority: var ParserDiagnosticAuthority,
        err: var str): bool =
    let rowCount = authority.authorityKinds.len
    if authority.schemaVersion !=
           ParserDiagnosticAuthoritySchemaVersionLatest ||
       rowCount <= 0 ||
       rowCount != authority.parserLocalProducerSourceRows.len ||
       rowCount != authority.portableProducerSourceIndexes.len ||
       rowCount != authority.producerSourceByteLengths.len ||
       rowCount != authority.producerContentCids.len ||
       rowCount != authority.parserInputCids.len ||
       rowCount != authority.sourceSidecarCids.len ||
       rowCount != authority.diagnosticCompletionCids.len ||
       rowCount != authority.anchorKinds.len ||
       rowCount != authority.canonicalParserNodeRows.len ||
       rowCount != authority.producerParserNodeRows.len ||
       rowCount != authority.parserNodeKinds.len ||
       rowCount != authority.parserNodeSpanStartBytes.len ||
       rowCount != authority.parserNodeSpanEndBytes.len ||
       rowCount != authority.ownerDeclarationSourceLocalRows.len ||
       rowCount != authority.ownerDeclarationKinds.len ||
       rowCount != authority.ownerDeclarationSpanStartBytes.len ||
       rowCount != authority.ownerDeclarationSpanEndBytes.len ||
       rowCount != authority.diagnosticSpanIds.len ||
       rowCount != authority.diagnosticSpanStartBytes.len ||
       rowCount != authority.diagnosticSpanEndBytes.len ||
       rowCount != authority.severities.len ||
       rowCount != authority.codes.len ||
       rowCount != authority.messages.len ||
       rowCount != authority.producerProjectionCids.len ||
       rowCount != authority.proofCids.len:
        err = " parser diagnostic authority: columns split"
        return false
    err = ""
    return true

fn parserDiagnosticAuthorityPayloadStrictValidateInto(
        authority: var ParserDiagnosticAuthority,
        err: var str): bool =
    if !parserDiagnosticAuthorityColumnsStrictValidateInto(authority, err):
        return false
    for row in 0..<authority.authorityKinds.len:
        let authorityKind = authority.authorityKinds[row]
        let anchorKind = authority.anchorKinds[row]
        let needsParser =
            anchorKind == ParserDiagnosticAuthorityAnchorParserNode ||
            anchorKind ==
                ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration
        let needsOwner =
            anchorKind ==
                ParserDiagnosticAuthorityAnchorOwnerDeclaration ||
            anchorKind ==
                ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration
        let sourceByteLength =
            authority.producerSourceByteLengths[row]
        let diagnosticStart =
            authority.diagnosticSpanStartBytes[row]
        let diagnosticEnd =
            authority.diagnosticSpanEndBytes[row]
        if authority.parserLocalProducerSourceRows[row] != 0 ||
           authority.portableProducerSourceIndexes[row] < 0 ||
           sourceByteLength < 0 ||
           !parserDiagnosticAuthorityCidObserved(
               authority.producerContentCids[row]) ||
           !parserDiagnosticAuthorityCidObserved(
               authority.parserInputCids[row]) ||
           authorityKind !=
               ParserDiagnosticAuthorityKindCanonicalSidecar ||
           anchorKind < ParserDiagnosticAuthorityAnchorParserNode ||
           anchorKind >
               ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration ||
           !parserDiagnosticAuthorityCidObserved(
               authority.sourceSidecarCids[row]) ||
           !parserDiagnosticAuthorityCidObserved(
               authority.diagnosticCompletionCids[row]) ||
           authority.diagnosticSpanIds[row] < 0 ||
           diagnosticStart < 0 ||
           diagnosticEnd < diagnosticStart ||
           diagnosticEnd > sourceByteLength ||
           authority.severities[row] !=
               ParserDiagnosticAuthoritySeverityError ||
           !parserDiagnosticAuthorityTextValid(authority.codes[row]) ||
           !parserDiagnosticAuthorityTextValid(authority.messages[row]) ||
           !parserDiagnosticAuthorityCidObserved(
               authority.producerProjectionCids[row]):
            err = " parser diagnostic authority: invalid producer row"
            return false
        if needsParser:
            if authority.canonicalParserNodeRows[row] < 0 ||
               authority.producerParserNodeRows[row] < 0 ||
               authority.parserNodeKinds[row] <= 0 ||
               authority.parserNodeSpanStartBytes[row] < 0 ||
               authority.parserNodeSpanEndBytes[row] <=
                   authority.parserNodeSpanStartBytes[row] ||
               authority.parserNodeSpanStartBytes[row] !=
                   diagnosticStart ||
               authority.parserNodeSpanEndBytes[row] !=
                   diagnosticEnd:
                err = " parser diagnostic authority: parser node span split"
                return false
        elif authority.canonicalParserNodeRows[row] != -1 ||
             authority.producerParserNodeRows[row] != -1 ||
             authority.parserNodeKinds[row] != -1 ||
             authority.parserNodeSpanStartBytes[row] != -1 ||
             authority.parserNodeSpanEndBytes[row] != -1:
            err = " parser diagnostic authority: unexpected parser node"
            return false
        if needsOwner:
            if authority.ownerDeclarationSourceLocalRows[row] < 0 ||
               authority.ownerDeclarationKinds[row] <= 0 ||
               authority.ownerDeclarationSpanStartBytes[row] < 0 ||
               authority.ownerDeclarationSpanEndBytes[row] <=
                   authority.ownerDeclarationSpanStartBytes[row] ||
               diagnosticStart <
                   authority.ownerDeclarationSpanStartBytes[row] ||
               diagnosticEnd >
                   authority.ownerDeclarationSpanEndBytes[row]:
                err = " parser diagnostic authority: owner containment split"
                return false
        elif authority.ownerDeclarationSourceLocalRows[row] != -1 ||
             authority.ownerDeclarationKinds[row] != -1 ||
             authority.ownerDeclarationSpanStartBytes[row] != -1 ||
             authority.ownerDeclarationSpanEndBytes[row] != -1:
            err = " parser diagnostic authority: unexpected owner declaration"
            return false
        if row > 0 &&
           !parserDiagnosticAuthorityRowLess(authority, row - 1, row):
            err = " parser diagnostic authority: rows are not canonical"
            return false
    err = ""
    return true

# `expectedProducerProjectionCids` is deliberately external to the authority.
# Production callers must obtain it from the parser-owned projection receipt
# frozen before artifact/facts/cargo construction. Passing the authority's own
# column back here is not producer evidence.
@borrows
fn ParserDiagnosticAuthorityStrictValidateInto(
        authority: var ParserDiagnosticAuthority,
        expectedProducerProjectionCids: layout.FixedBytes32[],
        err: var str): bool =
    if !parserDiagnosticAuthorityPayloadStrictValidateInto(authority, err):
        return false
    if expectedProducerProjectionCids.len !=
           authority.producerProjectionCids.len:
        err = " parser diagnostic authority: producer projection coverage split"
        return false
    for row in 0..<authority.producerProjectionCids.len:
        if !layout.FixedBytes32Equal(
               ParserDiagnosticAuthorityParserProjectionCidAt(
                   authority, row),
               authority.producerProjectionCids[row]):
            err = " parser diagnostic authority: producer projection payload mismatch"
            return false
        if !layout.FixedBytes32Equal(
               authority.producerProjectionCids[row],
               expectedProducerProjectionCids[row]):
            err = " parser diagnostic authority: producer projection authority split"
            return false
        if !layout.FixedBytes32Equal(
               ParserDiagnosticAuthorityRowProofCid(authority, row),
               authority.proofCids[row]):
            err = " parser diagnostic authority: row proof mismatch"
            return false
    if !layout.FixedBytes32Equal(
           ParserDiagnosticAuthorityRootCid(authority),
           authority.authorityRootCid):
        err = " parser diagnostic authority: root mismatch"
        return false
    err = ""
    return true

fn ParserDiagnosticAuthorityReleased(
        authority: var ParserDiagnosticAuthority): bool =
    return authority.schemaVersion == 0 &&
           authority.authorityKinds.len == 0 &&
           authority.authorityKinds.cap == 0 &&
           authority.parserLocalProducerSourceRows.len == 0 &&
           authority.parserLocalProducerSourceRows.cap == 0 &&
           authority.portableProducerSourceIndexes.len == 0 &&
           authority.portableProducerSourceIndexes.cap == 0 &&
           authority.producerSourceByteLengths.len == 0 &&
           authority.producerSourceByteLengths.cap == 0 &&
           authority.producerContentCids.len == 0 &&
           authority.producerContentCids.cap == 0 &&
           authority.parserInputCids.len == 0 &&
           authority.parserInputCids.cap == 0 &&
           authority.sourceSidecarCids.len == 0 &&
           authority.sourceSidecarCids.cap == 0 &&
           authority.diagnosticCompletionCids.len == 0 &&
           authority.diagnosticCompletionCids.cap == 0 &&
           authority.anchorKinds.len == 0 &&
           authority.anchorKinds.cap == 0 &&
           authority.canonicalParserNodeRows.len == 0 &&
           authority.canonicalParserNodeRows.cap == 0 &&
           authority.producerParserNodeRows.len == 0 &&
           authority.producerParserNodeRows.cap == 0 &&
           authority.parserNodeKinds.len == 0 &&
           authority.parserNodeKinds.cap == 0 &&
           authority.parserNodeSpanStartBytes.len == 0 &&
           authority.parserNodeSpanStartBytes.cap == 0 &&
           authority.parserNodeSpanEndBytes.len == 0 &&
           authority.parserNodeSpanEndBytes.cap == 0 &&
           authority.ownerDeclarationSourceLocalRows.len == 0 &&
           authority.ownerDeclarationSourceLocalRows.cap == 0 &&
           authority.ownerDeclarationKinds.len == 0 &&
           authority.ownerDeclarationKinds.cap == 0 &&
           authority.ownerDeclarationSpanStartBytes.len == 0 &&
           authority.ownerDeclarationSpanStartBytes.cap == 0 &&
           authority.ownerDeclarationSpanEndBytes.len == 0 &&
           authority.ownerDeclarationSpanEndBytes.cap == 0 &&
           authority.diagnosticSpanIds.len == 0 &&
           authority.diagnosticSpanIds.cap == 0 &&
           authority.diagnosticSpanStartBytes.len == 0 &&
           authority.diagnosticSpanStartBytes.cap == 0 &&
           authority.diagnosticSpanEndBytes.len == 0 &&
           authority.diagnosticSpanEndBytes.cap == 0 &&
           authority.severities.len == 0 &&
           authority.severities.cap == 0 &&
           authority.codes.len == 0 &&
           authority.codes.cap == 0 &&
           authority.messages.len == 0 &&
           authority.messages.cap == 0 &&
           authority.producerProjectionCids.len == 0 &&
           authority.producerProjectionCids.cap == 0 &&
           authority.proofCids.len == 0 &&
           authority.proofCids.cap == 0 &&
           !parserDiagnosticAuthorityCidObserved(
               authority.authorityRootCid)

fn ParserDiagnosticAuthorityPhysicalBufferCount(
        authority: var ParserDiagnosticAuthority): int32 =
    var count: int32
    if authority.authorityKinds.cap > 0: count = count + 1
    if authority.parserLocalProducerSourceRows.cap > 0: count = count + 1
    if authority.portableProducerSourceIndexes.cap > 0: count = count + 1
    if authority.producerSourceByteLengths.cap > 0: count = count + 1
    if authority.producerContentCids.cap > 0: count = count + 1
    if authority.parserInputCids.cap > 0: count = count + 1
    if authority.sourceSidecarCids.cap > 0: count = count + 1
    if authority.diagnosticCompletionCids.cap > 0: count = count + 1
    if authority.anchorKinds.cap > 0: count = count + 1
    if authority.canonicalParserNodeRows.cap > 0: count = count + 1
    if authority.producerParserNodeRows.cap > 0: count = count + 1
    if authority.parserNodeKinds.cap > 0: count = count + 1
    if authority.parserNodeSpanStartBytes.cap > 0: count = count + 1
    if authority.parserNodeSpanEndBytes.cap > 0: count = count + 1
    if authority.ownerDeclarationSourceLocalRows.cap > 0:
        count = count + 1
    if authority.ownerDeclarationKinds.cap > 0: count = count + 1
    if authority.ownerDeclarationSpanStartBytes.cap > 0:
        count = count + 1
    if authority.ownerDeclarationSpanEndBytes.cap > 0:
        count = count + 1
    if authority.diagnosticSpanIds.cap > 0: count = count + 1
    if authority.diagnosticSpanStartBytes.cap > 0: count = count + 1
    if authority.diagnosticSpanEndBytes.cap > 0: count = count + 1
    if authority.severities.cap > 0: count = count + 1
    if authority.codes.cap > 0: count = count + 1
    if authority.messages.cap > 0: count = count + 1
    if authority.producerProjectionCids.cap > 0: count = count + 1
    if authority.proofCids.cap > 0: count = count + 1
    return count

fn ParserDiagnosticAuthoritySequenceCapacity(
        authority: var ParserDiagnosticAuthority): int64 =
    return Int64(authority.authorityKinds.cap) +
           Int64(authority.parserLocalProducerSourceRows.cap) +
           Int64(authority.portableProducerSourceIndexes.cap) +
           Int64(authority.producerSourceByteLengths.cap) +
           Int64(authority.producerContentCids.cap) +
           Int64(authority.parserInputCids.cap) +
           Int64(authority.sourceSidecarCids.cap) +
           Int64(authority.diagnosticCompletionCids.cap) +
           Int64(authority.anchorKinds.cap) +
           Int64(authority.canonicalParserNodeRows.cap) +
           Int64(authority.producerParserNodeRows.cap) +
           Int64(authority.parserNodeKinds.cap) +
           Int64(authority.parserNodeSpanStartBytes.cap) +
           Int64(authority.parserNodeSpanEndBytes.cap) +
           Int64(authority.ownerDeclarationSourceLocalRows.cap) +
           Int64(authority.ownerDeclarationKinds.cap) +
           Int64(authority.ownerDeclarationSpanStartBytes.cap) +
           Int64(authority.ownerDeclarationSpanEndBytes.cap) +
           Int64(authority.diagnosticSpanIds.cap) +
           Int64(authority.diagnosticSpanStartBytes.cap) +
           Int64(authority.diagnosticSpanEndBytes.cap) +
           Int64(authority.severities.cap) +
           Int64(authority.codes.cap) +
           Int64(authority.messages.cap) +
           Int64(authority.producerProjectionCids.cap) +
           Int64(authority.proofCids.cap)

fn ParserDiagnosticAuthorityLogicalStringCount(
        authority: var ParserDiagnosticAuthority): int64 =
    var count: int64
    for row in 0..<authority.codes.len:
        if authority.codes[row] != "":
            count = count + Int64(1)
    for row in 0..<authority.messages.len:
        if authority.messages[row] != "":
            count = count + Int64(1)
    return count

fn parserDiagnosticAuthoritySlots(
        length: int32,
        capacity: int32,
        retainedCapacity: bool): int64 =
    return Int64(retainedCapacity ? capacity : length)

fn ParserDiagnosticAuthorityDynamicSequenceBytes(
        authority: var ParserDiagnosticAuthority,
        retainedCapacity: bool): int64 =
    let int32Slots =
        parserDiagnosticAuthoritySlots(
            authority.authorityKinds.len,
            authority.authorityKinds.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.parserLocalProducerSourceRows.len,
            authority.parserLocalProducerSourceRows.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.portableProducerSourceIndexes.len,
            authority.portableProducerSourceIndexes.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.producerSourceByteLengths.len,
            authority.producerSourceByteLengths.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.anchorKinds.len,
            authority.anchorKinds.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.canonicalParserNodeRows.len,
            authority.canonicalParserNodeRows.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.producerParserNodeRows.len,
            authority.producerParserNodeRows.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.parserNodeKinds.len,
            authority.parserNodeKinds.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.parserNodeSpanStartBytes.len,
            authority.parserNodeSpanStartBytes.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.parserNodeSpanEndBytes.len,
            authority.parserNodeSpanEndBytes.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.ownerDeclarationSourceLocalRows.len,
            authority.ownerDeclarationSourceLocalRows.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.ownerDeclarationKinds.len,
            authority.ownerDeclarationKinds.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.ownerDeclarationSpanStartBytes.len,
            authority.ownerDeclarationSpanStartBytes.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.ownerDeclarationSpanEndBytes.len,
            authority.ownerDeclarationSpanEndBytes.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.diagnosticSpanIds.len,
            authority.diagnosticSpanIds.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.diagnosticSpanStartBytes.len,
            authority.diagnosticSpanStartBytes.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.diagnosticSpanEndBytes.len,
            authority.diagnosticSpanEndBytes.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.severities.len,
            authority.severities.cap,
            retainedCapacity)
    let cidSlots =
        parserDiagnosticAuthoritySlots(
            authority.producerContentCids.len,
            authority.producerContentCids.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.parserInputCids.len,
            authority.parserInputCids.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.sourceSidecarCids.len,
            authority.sourceSidecarCids.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.diagnosticCompletionCids.len,
            authority.diagnosticCompletionCids.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.producerProjectionCids.len,
            authority.producerProjectionCids.cap,
            retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.proofCids.len,
            authority.proofCids.cap,
            retainedCapacity)
    let stringSlots =
        parserDiagnosticAuthoritySlots(
            authority.codes.len, authority.codes.cap, retainedCapacity) +
        parserDiagnosticAuthoritySlots(
            authority.messages.len,
            authority.messages.cap,
            retainedCapacity)
    var total = int32Slots * Int64(sizeof(int32)) +
                cidSlots * Int64(sizeof(layout.FixedBytes32)) +
                stringSlots * Int64(sizeof(str))
    for row in 0..<authority.codes.len:
        total = total + Int64(authority.codes[row].len)
    for row in 0..<authority.messages.len:
        total = total + Int64(authority.messages[row].len)
    return total

fn ParserDiagnosticAuthorityScalarBytes(
        authority: var ParserDiagnosticAuthority): int64 =
    let _ = authority
    return Int64(sizeof(ParserDiagnosticAuthority))

fn ParserDiagnosticAuthorityReleaseInto(
        authority: var ParserDiagnosticAuthority,
        receipt: var ParserDiagnosticAuthorityReleaseReceipt) =
    receipt = ParserDiagnosticAuthorityReleaseReceipt()
    receipt.sequenceCapacityBefore =
        ParserDiagnosticAuthoritySequenceCapacity(authority)
    receipt.logicalStringCountBefore =
        ParserDiagnosticAuthorityLogicalStringCount(authority)
    receipt.hadPayload = !ParserDiagnosticAuthorityReleased(authority)
    let physicalBufferCountBefore =
        ParserDiagnosticAuthorityPhysicalBufferCount(authority)
    let freeCountBefore = system.memFreeCount()
    let releaseCountBefore = system.memReleaseCount()
    seqs.freeSeq(authority.authorityKinds)
    seqs.freeSeq(authority.parserLocalProducerSourceRows)
    seqs.freeSeq(authority.portableProducerSourceIndexes)
    seqs.freeSeq(authority.producerSourceByteLengths)
    seqs.freeSeq(authority.producerContentCids)
    seqs.freeSeq(authority.parserInputCids)
    seqs.freeSeq(authority.sourceSidecarCids)
    seqs.freeSeq(authority.diagnosticCompletionCids)
    seqs.freeSeq(authority.anchorKinds)
    seqs.freeSeq(authority.canonicalParserNodeRows)
    seqs.freeSeq(authority.producerParserNodeRows)
    seqs.freeSeq(authority.parserNodeKinds)
    seqs.freeSeq(authority.parserNodeSpanStartBytes)
    seqs.freeSeq(authority.parserNodeSpanEndBytes)
    seqs.freeSeq(authority.ownerDeclarationSourceLocalRows)
    seqs.freeSeq(authority.ownerDeclarationKinds)
    seqs.freeSeq(authority.ownerDeclarationSpanStartBytes)
    seqs.freeSeq(authority.ownerDeclarationSpanEndBytes)
    seqs.freeSeq(authority.diagnosticSpanIds)
    seqs.freeSeq(authority.diagnosticSpanStartBytes)
    seqs.freeSeq(authority.diagnosticSpanEndBytes)
    seqs.freeSeq(authority.severities)
    seqs.freeSeqStrRelease(authority.codes)
    seqs.freeSeqStrRelease(authority.messages)
    seqs.freeSeq(authority.producerProjectionCids)
    seqs.freeSeq(authority.proofCids)
    authority = ParserDiagnosticAuthority()
    receipt.physicalFreeCount =
        system.memFreeCount() - freeCountBefore
    receipt.orcReleaseCount =
        system.memReleaseCount() - releaseCountBefore
    receipt.storageReleased =
        ParserDiagnosticAuthorityReleased(authority)
    if receipt.physicalFreeCount <
           Int64(physicalBufferCountBefore) ||
       !receipt.storageReleased:
        panic("parser diagnostic authority: release incomplete")

fn parserDiagnosticAuthorityDescriptorsAlias(
        out: var ParserDiagnosticAuthority,
        source: var ParserDiagnosticAuthority): bool =
    let sourceSchema = source.schemaVersion
    let marker =
        out.schemaVersion == ParserDiagnosticAuthoritySchemaVersionLatest ?
            0 : ParserDiagnosticAuthoritySchemaVersionLatest
    source.schemaVersion = marker
    let alias = out.schemaVersion == marker
    source.schemaVersion = sourceSchema
    return alias

@borrows
fn ParserDiagnosticAuthorityMoveInto(
        out: var ParserDiagnosticAuthority,
        source: var ParserDiagnosticAuthority,
        expectedProducerProjectionCids: layout.FixedBytes32[],
        err: var str): bool =
    if !ParserDiagnosticAuthorityStrictValidateInto(
           source, expectedProducerProjectionCids, err):
        return false
    if parserDiagnosticAuthorityDescriptorsAlias(out, source):
        err = " parser diagnostic authority: self move"
        return false
    var releaseReceipt: ParserDiagnosticAuthorityReleaseReceipt
    ParserDiagnosticAuthorityReleaseInto(out, releaseReceipt)
    out = source
    source = ParserDiagnosticAuthority()
    if !ParserDiagnosticAuthorityStrictValidateInto(
           out, expectedProducerProjectionCids, err) ||
       !ParserDiagnosticAuthorityReleased(source):
        panic("parser diagnostic authority: move invariant split")
    err = ""
    return true

@borrows
fn ParserDiagnosticAuthorityCloneInto(
        source: var ParserDiagnosticAuthority,
        expectedProducerProjectionCids: layout.FixedBytes32[],
        out: var ParserDiagnosticAuthority,
        err: var str): bool =
    if !ParserDiagnosticAuthorityStrictValidateInto(
           source, expectedProducerProjectionCids, err):
        return false
    var staged: ParserDiagnosticAuthority
    staged.schemaVersion = source.schemaVersion
    for row in 0..<source.authorityKinds.len:
        add(staged.authorityKinds, source.authorityKinds[row])
        add(staged.parserLocalProducerSourceRows,
            source.parserLocalProducerSourceRows[row])
        add(staged.portableProducerSourceIndexes,
            source.portableProducerSourceIndexes[row])
        add(staged.producerSourceByteLengths,
            source.producerSourceByteLengths[row])
        add(staged.producerContentCids, source.producerContentCids[row])
        add(staged.parserInputCids, source.parserInputCids[row])
        add(staged.sourceSidecarCids, source.sourceSidecarCids[row])
        add(staged.diagnosticCompletionCids,
            source.diagnosticCompletionCids[row])
        add(staged.anchorKinds, source.anchorKinds[row])
        add(staged.canonicalParserNodeRows,
            source.canonicalParserNodeRows[row])
        add(staged.producerParserNodeRows,
            source.producerParserNodeRows[row])
        add(staged.parserNodeKinds, source.parserNodeKinds[row])
        add(staged.parserNodeSpanStartBytes,
            source.parserNodeSpanStartBytes[row])
        add(staged.parserNodeSpanEndBytes,
            source.parserNodeSpanEndBytes[row])
        add(staged.ownerDeclarationSourceLocalRows,
            source.ownerDeclarationSourceLocalRows[row])
        add(staged.ownerDeclarationKinds,
            source.ownerDeclarationKinds[row])
        add(staged.ownerDeclarationSpanStartBytes,
            source.ownerDeclarationSpanStartBytes[row])
        add(staged.ownerDeclarationSpanEndBytes,
            source.ownerDeclarationSpanEndBytes[row])
        add(staged.diagnosticSpanIds,
            source.diagnosticSpanIds[row])
        add(staged.diagnosticSpanStartBytes,
            source.diagnosticSpanStartBytes[row])
        add(staged.diagnosticSpanEndBytes,
            source.diagnosticSpanEndBytes[row])
        add(staged.severities, source.severities[row])
        add(staged.codes, parser.ParserOwnedText(source.codes[row]))
        add(staged.messages, parser.ParserOwnedText(source.messages[row]))
        add(staged.producerProjectionCids,
            source.producerProjectionCids[row])
        add(staged.proofCids, source.proofCids[row])
    staged.authorityRootCid = source.authorityRootCid
    if !ParserDiagnosticAuthorityStrictValidateInto(
           staged, expectedProducerProjectionCids, err):
        var releaseReceipt: ParserDiagnosticAuthorityReleaseReceipt
        ParserDiagnosticAuthorityReleaseInto(staged, releaseReceipt)
        return false
    return ParserDiagnosticAuthorityMoveInto(
        out, staged, expectedProducerProjectionCids, err)
