# B3 — var param base type init scaffold (ghost-with-dead-wire).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (lesson e4550c1b5 applied).
# Env gate CHENG_VAR_PARAM_BASE_TYPE_INIT_TRACE=1 default off.
#
# Purpose: walk TypedExprIr ParamRef nodes; for each `var BigInt` /
# `var Bytes` / `var seq[T]` style mutable parameter, strip the `var`
# prefix, extract the leaf type name, classify the base kind, and
# aggregate per-kind counts.  Real apply step writes the classified
# base kind back onto the param slot's metadata so downstream lowering
# can pick the correct constructor/initializer without re-parsing the
# raw type text.
#
# Algorithm:
# 1. For each nodeIndex in 0..<typedIr.nodes2_opKinds.len:
#    a. opKind != TypedExprIrOpParamRef → skip.
#    b. If paramSlotFilter >= 0 and node's paramSlot != paramSlotFilter
#       → skip (caller can scan one slot or all slots via -1).
#    c. Lookup nodes2_resultTypeIds[i] in internPool; miss → skip.
#    d. baseType = TypedExprStripVarType(raw); if unchanged & raw had
#       a `var` prefix that didn't strip cleanly → unstrippedVar++.
#    e. leaf = TypedExprTypeLeafName(baseType); classify against a
#       fixed small table (BigInt / str / Bytes / seq / int32 / int64
#       / other).
# 2. Aggregate per-kind counts on the result struct.

import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/intern as langintern
import cheng/core/runtime/arena as arenamod
import std/os
import std/strings

const
    VarParamBaseTypeKindOther = 0
    VarParamBaseTypeKindBigInt = 1
    VarParamBaseTypeKindStr = 2
    VarParamBaseTypeKindBytes = 3
    VarParamBaseTypeKindSeq = 4
    VarParamBaseTypeKindI32 = 5
    VarParamBaseTypeKindI64 = 6

type
    VarParamBaseTypeInitResult =
        paramSlotQuery: int32
        totalScanned: int32
        matchedParamRefs: int32
        classifiedBigInt: int32
        classifiedStr: int32
        classifiedBytes: int32
        classifiedSeq: int32
        classifiedI32: int32
        classifiedI64: int32
        classifiedOther: int32
        unstrippedVar: int32

fn VarParamBaseTypeClassifyLeaf(leaf: str): int32 =
    if leaf == "BigInt" || leaf == "bigint":
        return VarParamBaseTypeKindBigInt
    if leaf == "str" || leaf == "string":
        return VarParamBaseTypeKindStr
    if leaf == "Bytes" || leaf == "bytes":
        return VarParamBaseTypeKindBytes
    if leaf == "seq":
        return VarParamBaseTypeKindSeq
    if leaf == "int32":
        return VarParamBaseTypeKindI32
    if leaf == "int64":
        return VarParamBaseTypeKindI64
    return VarParamBaseTypeKindOther

fn VarParamBaseTypeInit(typedIr: var texpr.TypedExprIr,
                         paramSlotFilter: int32): VarParamBaseTypeInitResult =
    var out: VarParamBaseTypeInitResult
    out.paramSlotQuery = paramSlotFilter
    out.totalScanned = 0
    out.matchedParamRefs = 0
    out.classifiedBigInt = 0
    out.classifiedStr = 0
    out.classifiedBytes = 0
    out.classifiedSeq = 0
    out.classifiedI32 = 0
    out.classifiedI64 = 0
    out.classifiedOther = 0
    out.unstrippedVar = 0

    for i in 0..<typedIr.nodes2_opKinds.len:
        out.totalScanned = out.totalScanned + 1
        if typedIr.nodes2_opKinds[i] != texpr.TypedExprIrOpParamRef:
            continue
        let slot = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_paramSlots, i)
        if paramSlotFilter >= 0 && slot != paramSlotFilter:
            continue
        out.matchedParamRefs = out.matchedParamRefs + 1
        let typeRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[i])
        if !IsOk(typeRes):
            continue
        let rawType = Value(typeRes)
        let baseType = texpr.TypedExprStripVarType(rawType)
        if rawType.len > 3 && baseType.len == rawType.len && strings.HasPrefix(rawType, "var "):
            out.unstrippedVar = out.unstrippedVar + 1
        let leaf = texpr.TypedExprTypeLeafName(baseType)
        let kind = VarParamBaseTypeClassifyLeaf(leaf)
        if kind == VarParamBaseTypeKindBigInt:
            out.classifiedBigInt = out.classifiedBigInt + 1
        elif kind == VarParamBaseTypeKindStr:
            out.classifiedStr = out.classifiedStr + 1
        elif kind == VarParamBaseTypeKindBytes:
            out.classifiedBytes = out.classifiedBytes + 1
        elif kind == VarParamBaseTypeKindSeq:
            out.classifiedSeq = out.classifiedSeq + 1
        elif kind == VarParamBaseTypeKindI32:
            out.classifiedI32 = out.classifiedI32 + 1
        elif kind == VarParamBaseTypeKindI64:
            out.classifiedI64 = out.classifiedI64 + 1
        else:
            out.classifiedOther = out.classifiedOther + 1

    let _gate = os.GetEnv("CHENG_VAR_PARAM_BASE_TYPE_INIT_TRACE")
    if _gate == "1":
        var _line: str = "[var-param-base-type-init] scanned="
        _line = _line + strings.IntToStr(out.totalScanned)
        _line = _line + " matched="
        _line = _line + strings.IntToStr(out.matchedParamRefs)
        _line = _line + " bigint="
        _line = _line + strings.IntToStr(out.classifiedBigInt)
        _line = _line + " seq="
        _line = _line + strings.IntToStr(out.classifiedSeq)
        _line = _line + " other="
        _line = _line + strings.IntToStr(out.classifiedOther)
        os.WriteLine(os.GetStderr(), _line)

    return out

fn VarParamBaseTypeInitMatched(r: VarParamBaseTypeInitResult): int32 =
    return r.matchedParamRefs
