# lifetime_ledger
#
# 只观测被跟踪结构对象的逻辑所有权与结构字节，不替对象决定释放点；
# close 后由显式 ReleaseStorage 物理释放 ledger 自身全部 Seq 存储。
# 释放回执分两个量：releasedSequenceCount 是结构量（六条 seq 全部走过释放路径，
# 恒为 6），releasedSequenceBufferCount 是物理量（其中确有 buffer 可释放的条数，
# 从不 borrow 的组件合法地小于 6）。两者不可互相顶替。
# category/owner/object/borrow token 都按注册事件顺序分配稳定的稠密 ID。
import std/seqs

type
    LifetimeLedgerMetrics =
        categoryId: int32
        allocated: int64
        live: int64
        peakLive: int64
        allocatedBytes: int64
        liveBytes: int64
        peakLiveBytes: int64
        retained: int64
        released: int64
        releasedBytes: int64
        ownerTransferCount: int64
        borrowReturnCount: int64

    LifetimeLedgerObject =
        objectId: int32
        categoryId: int32
        ownerId: int32
        state: int32
        borrowCount: int32
        byteCount: int64

    LifetimeLedgerBorrow =
        borrowId: int32
        objectId: int32
        borrowerOwnerId: int32
        active: bool

    LifetimeLedgerStorageReleaseReceipt =
        releasedSequenceCount: int32
        releasedSequenceBufferCount: int32
        releasedSequenceCapacityBytes: int64
        storageReleased: bool

    LifetimeLedger =
        categoryNames: str[]
        ownerNames: str[]
        ownerClosed: bool[]
        objects: LifetimeLedgerObject[]
        borrows: LifetimeLedgerBorrow[]
        categoryMetrics: LifetimeLedgerMetrics[]
        totalMetrics: LifetimeLedgerMetrics
        registrationCapacityBoundActive: bool
        categoryCapacityBound: int32
        ownerCapacityBound: int32
        objectCapacityBound: int32
        borrowCapacityBound: int32
        closed: bool
        finalMetricsRead: bool
        storageReleased: bool


const
    LifetimeLedgerStateUninitialized = 0
    LifetimeLedgerStateOwned = 1
    LifetimeLedgerStateReleased = 2

fn lifetimeLedgerFail(message: str) =
    panic(message)

fn lifetimeLedgerRequireOpen(ledger: var LifetimeLedger) =
    if ledger.closed || ledger.storageReleased:
        lifetimeLedgerFail("lifetime_ledger: ledger is closed")

fn LifetimeLedgerInit(ledger: var LifetimeLedger) =
    lifetimeLedgerRequireOpen(ledger)
    if ledger.categoryNames.len != 0 ||
       ledger.ownerNames.len != 0 ||
       ledger.ownerClosed.len != 0 ||
       ledger.objects.len != 0 ||
       ledger.borrows.len != 0 ||
       ledger.categoryMetrics.len != 0 ||
       ledger.totalMetrics.allocated != int64(0) ||
       ledger.totalMetrics.live != int64(0) ||
       ledger.totalMetrics.allocatedBytes != int64(0) ||
       ledger.totalMetrics.liveBytes != int64(0) ||
       ledger.totalMetrics.retained != int64(0) ||
       ledger.totalMetrics.released != int64(0) ||
       ledger.totalMetrics.releasedBytes != int64(0) ||
       ledger.registrationCapacityBoundActive ||
       ledger.categoryCapacityBound != 0 ||
       ledger.ownerCapacityBound != 0 ||
       ledger.objectCapacityBound != 0 ||
       ledger.borrowCapacityBound != 0 ||
       ledger.finalMetricsRead || ledger.storageReleased:
        lifetimeLedgerFail("lifetime_ledger: init requires empty ledger")
    ledger.categoryNames = []
    ledger.ownerNames = []
    ledger.ownerClosed = []
    ledger.objects = []
    ledger.borrows = []
    ledger.categoryMetrics = []
    ledger.totalMetrics = LifetimeLedgerMetrics()
    ledger.closed = false
    ledger.finalMetricsRead = false
    ledger.storageReleased = false

fn LifetimeLedgerReserveExact(
        ledger: var LifetimeLedger,
        categoryCount: int32,
        ownerCount: int32,
        objectCount: int32,
        borrowCount: int32) =
    lifetimeLedgerRequireOpen(ledger)
    if categoryCount < 0 || ownerCount < 0 ||
       objectCount < 0 || borrowCount < 0 ||
       ledger.categoryNames.len != 0 ||
       ledger.ownerNames.len != 0 ||
       ledger.ownerClosed.len != 0 ||
       ledger.objects.len != 0 ||
       ledger.borrows.len != 0 ||
       ledger.categoryMetrics.len != 0:
        lifetimeLedgerFail(
            "lifetime_ledger: exact reserve requires empty ledger")
    seqs.reserve(ledger.categoryNames, categoryCount)
    seqs.reserve(ledger.ownerNames, ownerCount)
    seqs.reserve(ledger.ownerClosed, ownerCount)
    seqs.reserve(ledger.objects, objectCount)
    seqs.reserve(ledger.borrows, borrowCount)
    seqs.reserve(ledger.categoryMetrics, categoryCount)
    ledger.registrationCapacityBoundActive = true
    ledger.categoryCapacityBound = categoryCount
    ledger.ownerCapacityBound = ownerCount
    ledger.objectCapacityBound = objectCount
    ledger.borrowCapacityBound = borrowCount

fn lifetimeLedgerRequireCategoryIndex(ledger: var LifetimeLedger,
                                      categoryId: int32): int32 =
    if categoryId <= 0 || categoryId > ledger.categoryNames.len:
        lifetimeLedgerFail("lifetime_ledger: unknown category id")
    let index = categoryId - 1
    if ledger.categoryMetrics[index].categoryId != categoryId:
        lifetimeLedgerFail("lifetime_ledger: category index corrupt")
    return index

fn lifetimeLedgerRequireOwnerIndex(ledger: var LifetimeLedger,
                                   ownerId: int32): int32 =
    if ownerId <= 0 || ownerId > ledger.ownerNames.len:
        lifetimeLedgerFail("lifetime_ledger: unknown owner id")
    if ledger.ownerClosed.len != ledger.ownerNames.len:
        lifetimeLedgerFail("lifetime_ledger: owner close index corrupt")
    return ownerId - 1

fn lifetimeLedgerRequireOpenOwnerIndex(ledger: var LifetimeLedger,
                                       ownerId: int32): int32 =
    let index = lifetimeLedgerRequireOwnerIndex(ledger, ownerId)
    if ledger.ownerClosed[index]:
        lifetimeLedgerFail("lifetime_ledger: owner is closed")
    return index

fn lifetimeLedgerRequireObjectIndex(ledger: var LifetimeLedger,
                                    objectId: int32): int32 =
    if objectId <= 0 || objectId > ledger.objects.len:
        lifetimeLedgerFail("lifetime_ledger: unknown object id")
    let index = objectId - 1
    if ledger.objects[index].objectId != objectId:
        lifetimeLedgerFail("lifetime_ledger: object index corrupt")
    return index

fn lifetimeLedgerRequireBorrowIndex(ledger: var LifetimeLedger,
                                    borrowId: int32): int32 =
    if borrowId <= 0 || borrowId > ledger.borrows.len:
        lifetimeLedgerFail("lifetime_ledger: unknown borrow id")
    let index = borrowId - 1
    if ledger.borrows[index].borrowId != borrowId:
        lifetimeLedgerFail("lifetime_ledger: borrow index corrupt")
    return index

fn lifetimeLedgerStoreObject(ledger: var LifetimeLedger,
                             index: int32,
                             value: LifetimeLedgerObject) =
    ledger.objects[index] = value

fn lifetimeLedgerStoreBorrow(ledger: var LifetimeLedger,
                             index: int32,
                             value: LifetimeLedgerBorrow) =
    ledger.borrows[index] = value

fn lifetimeLedgerStoreCategoryMetrics(ledger: var LifetimeLedger,
                                      index: int32,
                                      value: LifetimeLedgerMetrics) =
    ledger.categoryMetrics[index] = value

fn lifetimeLedgerRecordAllocate(ledger: var LifetimeLedger,
                                categoryIndex: int32,
                                byteCount: int64) =
    var category = ledger.categoryMetrics[categoryIndex]
    category.allocated = category.allocated + int64(1)
    category.live = category.live + int64(1)
    category.allocatedBytes = category.allocatedBytes + byteCount
    category.liveBytes = category.liveBytes + byteCount
    if category.live > category.peakLive:
        category.peakLive = category.live
    if category.liveBytes > category.peakLiveBytes:
        category.peakLiveBytes = category.liveBytes
    lifetimeLedgerStoreCategoryMetrics(ledger, categoryIndex, category)

    var total = ledger.totalMetrics
    total.allocated = total.allocated + int64(1)
    total.live = total.live + int64(1)
    total.allocatedBytes = total.allocatedBytes + byteCount
    total.liveBytes = total.liveBytes + byteCount
    if total.live > total.peakLive:
        total.peakLive = total.live
    if total.liveBytes > total.peakLiveBytes:
        total.peakLiveBytes = total.liveBytes
    ledger.totalMetrics = total

fn lifetimeLedgerRecordBorrow(ledger: var LifetimeLedger,
                              categoryIndex: int32) =
    var category = ledger.categoryMetrics[categoryIndex]
    category.retained = category.retained + int64(1)
    lifetimeLedgerStoreCategoryMetrics(ledger, categoryIndex, category)

    var total = ledger.totalMetrics
    total.retained = total.retained + int64(1)
    ledger.totalMetrics = total

fn lifetimeLedgerRecordBorrowReturn(ledger: var LifetimeLedger,
                                    categoryIndex: int32) =
    var category = ledger.categoryMetrics[categoryIndex]
    category.borrowReturnCount = category.borrowReturnCount + int64(1)
    lifetimeLedgerStoreCategoryMetrics(ledger, categoryIndex, category)

    var total = ledger.totalMetrics
    total.borrowReturnCount = total.borrowReturnCount + int64(1)
    ledger.totalMetrics = total

fn lifetimeLedgerRecordMove(ledger: var LifetimeLedger,
                            categoryIndex: int32) =
    var category = ledger.categoryMetrics[categoryIndex]
    category.ownerTransferCount = category.ownerTransferCount + int64(1)
    lifetimeLedgerStoreCategoryMetrics(ledger, categoryIndex, category)

    var total = ledger.totalMetrics
    total.ownerTransferCount = total.ownerTransferCount + int64(1)
    ledger.totalMetrics = total

fn lifetimeLedgerRecordRelease(ledger: var LifetimeLedger,
                               categoryIndex: int32,
                               byteCount: int64) =
    var category = ledger.categoryMetrics[categoryIndex]
    if category.live <= int64(0) || category.liveBytes < byteCount:
        lifetimeLedgerFail("lifetime_ledger: category live underflow")
    category.live = category.live - int64(1)
    category.liveBytes = category.liveBytes - byteCount
    category.released = category.released + int64(1)
    category.releasedBytes = category.releasedBytes + byteCount
    lifetimeLedgerStoreCategoryMetrics(ledger, categoryIndex, category)

    var total = ledger.totalMetrics
    if total.live <= int64(0) || total.liveBytes < byteCount:
        lifetimeLedgerFail("lifetime_ledger: total live underflow")
    total.live = total.live - int64(1)
    total.liveBytes = total.liveBytes - byteCount
    total.released = total.released + int64(1)
    total.releasedBytes = total.releasedBytes + byteCount
    ledger.totalMetrics = total

fn LifetimeLedgerRegisterCategory(ledger: var LifetimeLedger,
                                  categoryName: str): int32 =
    lifetimeLedgerRequireOpen(ledger)
    if len(categoryName) == 0:
        lifetimeLedgerFail("lifetime_ledger: empty category name")
    if ledger.registrationCapacityBoundActive &&
       ledger.categoryNames.len >= ledger.categoryCapacityBound:
        lifetimeLedgerFail(
            "lifetime_ledger: category capacity bound exceeded")
    for i in 0..<ledger.categoryNames.len:
        if ledger.categoryNames[i] == categoryName:
            lifetimeLedgerFail("lifetime_ledger: duplicate category name")
    let categoryId = ledger.categoryNames.len + 1
    add(ledger.categoryNames, categoryName)
    add(ledger.categoryMetrics,
        LifetimeLedgerMetrics(categoryId: categoryId))
    return categoryId

fn LifetimeLedgerRegisterOwner(ledger: var LifetimeLedger,
                               ownerName: str): int32 =
    lifetimeLedgerRequireOpen(ledger)
    if len(ownerName) == 0:
        lifetimeLedgerFail("lifetime_ledger: empty owner name")
    if ledger.registrationCapacityBoundActive &&
       ledger.ownerNames.len >= ledger.ownerCapacityBound:
        lifetimeLedgerFail(
            "lifetime_ledger: owner capacity bound exceeded")
    for i in 0..<ledger.ownerNames.len:
        if ledger.ownerNames[i] == ownerName:
            lifetimeLedgerFail("lifetime_ledger: duplicate owner name")
    let ownerId = ledger.ownerNames.len + 1
    add(ledger.ownerNames, ownerName)
    add(ledger.ownerClosed, false)
    return ownerId

fn LifetimeLedgerReserveObject(ledger: var LifetimeLedger,
                               categoryId: int32,
                               byteCount: int64): int32 =
    lifetimeLedgerRequireOpen(ledger)
    lifetimeLedgerRequireCategoryIndex(ledger, categoryId)
    if byteCount <= int64(0):
        lifetimeLedgerFail("lifetime_ledger: object byte count must be positive")
    if ledger.registrationCapacityBoundActive &&
       ledger.objects.len >= ledger.objectCapacityBound:
        lifetimeLedgerFail(
            "lifetime_ledger: object capacity bound exceeded")
    let objectId = ledger.objects.len + 1
    add(ledger.objects,
        LifetimeLedgerObject(objectId: objectId,
                             categoryId: categoryId,
                             byteCount: byteCount,
                             state: LifetimeLedgerStateUninitialized))
    return objectId

fn LifetimeLedgerOwn(ledger: var LifetimeLedger,
                     objectId: int32,
                     ownerId: int32) =
    lifetimeLedgerRequireOpen(ledger)
    let objectIndex = lifetimeLedgerRequireObjectIndex(ledger, objectId)
    lifetimeLedgerRequireOpenOwnerIndex(ledger, ownerId)
    var item = ledger.objects[objectIndex]
    if item.state != LifetimeLedgerStateUninitialized:
        lifetimeLedgerFail("lifetime_ledger: own requires uninitialized object")
    if item.ownerId != 0 || item.borrowCount != 0:
        lifetimeLedgerFail("lifetime_ledger: uninitialized object corrupt")
    let categoryIndex = lifetimeLedgerRequireCategoryIndex(ledger, item.categoryId)
    item.ownerId = ownerId
    item.state = LifetimeLedgerStateOwned
    lifetimeLedgerStoreObject(ledger, objectIndex, item)
    lifetimeLedgerRecordAllocate(ledger, categoryIndex, item.byteCount)

fn LifetimeLedgerBorrow(ledger: var LifetimeLedger,
                        objectId: int32,
                        borrowerOwnerId: int32): int32 =
    lifetimeLedgerRequireOpen(ledger)
    if ledger.registrationCapacityBoundActive &&
       ledger.borrows.len >= ledger.borrowCapacityBound:
        lifetimeLedgerFail(
            "lifetime_ledger: borrow capacity bound exceeded")
    let objectIndex = lifetimeLedgerRequireObjectIndex(ledger, objectId)
    var item = ledger.objects[objectIndex]
    if item.state != LifetimeLedgerStateOwned:
        lifetimeLedgerFail("lifetime_ledger: borrow requires owned object")
    lifetimeLedgerRequireOpenOwnerIndex(ledger, item.ownerId)
    lifetimeLedgerRequireOpenOwnerIndex(ledger, borrowerOwnerId)
    if item.ownerId == borrowerOwnerId:
        lifetimeLedgerFail("lifetime_ledger: owner cannot borrow from itself")
    let categoryIndex = lifetimeLedgerRequireCategoryIndex(ledger, item.categoryId)
    let borrowId = ledger.borrows.len + 1
    add(ledger.borrows,
        LifetimeLedgerBorrow(borrowId: borrowId,
                             objectId: objectId,
                             borrowerOwnerId: borrowerOwnerId,
                             active: true))
    item.borrowCount = item.borrowCount + 1
    lifetimeLedgerStoreObject(ledger, objectIndex, item)
    lifetimeLedgerRecordBorrow(ledger, categoryIndex)
    return borrowId

fn LifetimeLedgerReturnBorrow(ledger: var LifetimeLedger,
                              objectId: int32,
                              borrowId: int32,
                              borrowerOwnerId: int32) =
    lifetimeLedgerRequireOpen(ledger)
    let objectIndex = lifetimeLedgerRequireObjectIndex(ledger, objectId)
    let borrowIndex = lifetimeLedgerRequireBorrowIndex(ledger, borrowId)
    var item = ledger.objects[objectIndex]
    var lease = ledger.borrows[borrowIndex]
    if item.state != LifetimeLedgerStateOwned:
        lifetimeLedgerFail("lifetime_ledger: return borrow requires owned object")
    lifetimeLedgerRequireOpenOwnerIndex(ledger, item.ownerId)
    lifetimeLedgerRequireOpenOwnerIndex(ledger, borrowerOwnerId)
    if !lease.active:
        lifetimeLedgerFail("lifetime_ledger: duplicate borrow return")
    if lease.objectId != objectId || lease.borrowerOwnerId != borrowerOwnerId:
        lifetimeLedgerFail("lifetime_ledger: borrow return identity mismatch")
    if item.borrowCount <= 0:
        lifetimeLedgerFail("lifetime_ledger: borrow count underflow")
    let categoryIndex = lifetimeLedgerRequireCategoryIndex(ledger, item.categoryId)
    item.borrowCount = item.borrowCount - 1
    lease.active = false
    lifetimeLedgerStoreObject(ledger, objectIndex, item)
    lifetimeLedgerStoreBorrow(ledger, borrowIndex, lease)
    lifetimeLedgerRecordBorrowReturn(ledger, categoryIndex)

fn lifetimeLedgerHasActiveBorrow(ledger: var LifetimeLedger,
                                 objectId: int32,
                                 borrowerOwnerId: int32): bool =
    for i in 0..<ledger.borrows.len:
        let lease = ledger.borrows[i]
        if lease.active &&
           lease.objectId == objectId &&
           lease.borrowerOwnerId == borrowerOwnerId:
            return true
    return false

fn LifetimeLedgerRead(ledger: var LifetimeLedger,
                      objectId: int32,
                      readerOwnerId: int32): int32 =
    lifetimeLedgerRequireOpen(ledger)
    let objectIndex = lifetimeLedgerRequireObjectIndex(ledger, objectId)
    let item = ledger.objects[objectIndex]
    if item.state != LifetimeLedgerStateOwned:
        lifetimeLedgerFail("lifetime_ledger: read requires owned object")
    lifetimeLedgerRequireOpenOwnerIndex(ledger, item.ownerId)
    lifetimeLedgerRequireOpenOwnerIndex(ledger, readerOwnerId)
    if item.ownerId == readerOwnerId:
        if item.borrowCount != 0:
            lifetimeLedgerFail("lifetime_ledger: owner read while borrowed")
        return item.categoryId
    if !lifetimeLedgerHasActiveBorrow(ledger, objectId, readerOwnerId):
        lifetimeLedgerFail("lifetime_ledger: read without ownership or borrow")
    return item.categoryId

fn LifetimeLedgerMove(ledger: var LifetimeLedger,
                      objectId: int32,
                      fromOwnerId: int32,
                      toOwnerId: int32) =
    lifetimeLedgerRequireOpen(ledger)
    let objectIndex = lifetimeLedgerRequireObjectIndex(ledger, objectId)
    var item = ledger.objects[objectIndex]
    if item.state != LifetimeLedgerStateOwned:
        lifetimeLedgerFail("lifetime_ledger: move requires owned object")
    lifetimeLedgerRequireOpenOwnerIndex(ledger, item.ownerId)
    lifetimeLedgerRequireOpenOwnerIndex(ledger, fromOwnerId)
    lifetimeLedgerRequireOpenOwnerIndex(ledger, toOwnerId)
    if item.ownerId != fromOwnerId:
        lifetimeLedgerFail("lifetime_ledger: move source owner mismatch")
    if fromOwnerId == toOwnerId:
        lifetimeLedgerFail("lifetime_ledger: move destination equals source")
    if item.borrowCount != 0:
        lifetimeLedgerFail("lifetime_ledger: move while borrowed")
    let categoryIndex = lifetimeLedgerRequireCategoryIndex(ledger, item.categoryId)
    item.ownerId = toOwnerId
    lifetimeLedgerStoreObject(ledger, objectIndex, item)
    lifetimeLedgerRecordMove(ledger, categoryIndex)

fn LifetimeLedgerRelease(ledger: var LifetimeLedger,
                         objectId: int32,
                         ownerId: int32) =
    lifetimeLedgerRequireOpen(ledger)
    let objectIndex = lifetimeLedgerRequireObjectIndex(ledger, objectId)
    var item = ledger.objects[objectIndex]
    if item.state == LifetimeLedgerStateReleased:
        lifetimeLedgerFail("lifetime_ledger: duplicate release")
    if item.state != LifetimeLedgerStateOwned:
        lifetimeLedgerFail("lifetime_ledger: release requires owned object")
    lifetimeLedgerRequireOpenOwnerIndex(ledger, item.ownerId)
    lifetimeLedgerRequireOpenOwnerIndex(ledger, ownerId)
    if item.ownerId != ownerId:
        lifetimeLedgerFail("lifetime_ledger: release owner mismatch")
    if item.borrowCount != 0:
        lifetimeLedgerFail("lifetime_ledger: release while borrowed")
    let categoryIndex = lifetimeLedgerRequireCategoryIndex(ledger, item.categoryId)
    item.ownerId = 0
    item.state = LifetimeLedgerStateReleased
    lifetimeLedgerStoreObject(ledger, objectIndex, item)
    lifetimeLedgerRecordRelease(ledger, categoryIndex, item.byteCount)

fn LifetimeLedgerAssertOwnerClosed(ledger: var LifetimeLedger,
                                   ownerId: int32) =
    lifetimeLedgerRequireOpen(ledger)
    let ownerIndex = lifetimeLedgerRequireOpenOwnerIndex(ledger, ownerId)
    for i in 0..<ledger.objects.len:
        let item = ledger.objects[i]
        if item.state == LifetimeLedgerStateOwned && item.ownerId == ownerId:
            lifetimeLedgerFail("lifetime_ledger: owner ended with owned object")
    for i in 0..<ledger.borrows.len:
        let lease = ledger.borrows[i]
        if lease.active && lease.borrowerOwnerId == ownerId:
            lifetimeLedgerFail("lifetime_ledger: owner ended with active borrow")
    ledger.ownerClosed[ownerIndex] = true

fn LifetimeLedgerAssertClosed(ledger: var LifetimeLedger) =
    if ledger.closed:
        lifetimeLedgerFail("lifetime_ledger: duplicate ledger close")
    if ledger.ownerClosed.len != ledger.ownerNames.len:
        lifetimeLedgerFail("lifetime_ledger: owner close index corrupt")
    for i in 0..<ledger.ownerClosed.len:
        if !ledger.ownerClosed[i]:
            lifetimeLedgerFail("lifetime_ledger: ledger ended with open owner")
    for i in 0..<ledger.objects.len:
        let item = ledger.objects[i]
        if item.state == LifetimeLedgerStateUninitialized:
            lifetimeLedgerFail("lifetime_ledger: ledger ended with uninitialized object")
        if item.state == LifetimeLedgerStateOwned:
            lifetimeLedgerFail("lifetime_ledger: ledger ended with owned object")
        if item.state != LifetimeLedgerStateReleased:
            lifetimeLedgerFail("lifetime_ledger: ledger ended with unknown object state")
    for i in 0..<ledger.borrows.len:
        if ledger.borrows[i].active:
            lifetimeLedgerFail("lifetime_ledger: ledger ended with active borrow")
    if ledger.totalMetrics.live != int64(0):
        lifetimeLedgerFail("lifetime_ledger: closed ledger has live objects")
    if ledger.totalMetrics.liveBytes != int64(0):
        lifetimeLedgerFail("lifetime_ledger: closed ledger has live bytes")
    if ledger.totalMetrics.allocated != ledger.totalMetrics.released:
        lifetimeLedgerFail("lifetime_ledger: allocated released mismatch")
    if ledger.totalMetrics.allocatedBytes != ledger.totalMetrics.releasedBytes:
        lifetimeLedgerFail("lifetime_ledger: allocated released bytes mismatch")
    if ledger.totalMetrics.retained != ledger.totalMetrics.borrowReturnCount:
        lifetimeLedgerFail("lifetime_ledger: borrow retain return mismatch")
    var allocatedSum: int64
    var liveSum: int64
    var peakLiveSum: int64
    var allocatedBytesSum: int64
    var liveBytesSum: int64
    var peakLiveBytesSum: int64
    var retainedSum: int64
    var releasedSum: int64
    var releasedBytesSum: int64
    var transferSum: int64
    var borrowReturnSum: int64
    for i in 0..<ledger.categoryMetrics.len:
        let metrics = ledger.categoryMetrics[i]
        if metrics.categoryId != i + 1:
            lifetimeLedgerFail("lifetime_ledger: category metrics id mismatch")
        if metrics.live != int64(0):
            lifetimeLedgerFail("lifetime_ledger: closed category has live objects")
        if metrics.liveBytes != int64(0):
            lifetimeLedgerFail("lifetime_ledger: closed category has live bytes")
        if metrics.allocated != metrics.released:
            lifetimeLedgerFail("lifetime_ledger: category allocated released mismatch")
        if metrics.allocatedBytes != metrics.releasedBytes:
            lifetimeLedgerFail("lifetime_ledger: category allocated released bytes mismatch")
        if metrics.retained != metrics.borrowReturnCount:
            lifetimeLedgerFail("lifetime_ledger: category borrow retain return mismatch")
        allocatedSum = allocatedSum + metrics.allocated
        liveSum = liveSum + metrics.live
        peakLiveSum = peakLiveSum + metrics.peakLive
        allocatedBytesSum = allocatedBytesSum + metrics.allocatedBytes
        liveBytesSum = liveBytesSum + metrics.liveBytes
        peakLiveBytesSum = peakLiveBytesSum + metrics.peakLiveBytes
        retainedSum = retainedSum + metrics.retained
        releasedSum = releasedSum + metrics.released
        releasedBytesSum = releasedBytesSum + metrics.releasedBytes
        transferSum = transferSum + metrics.ownerTransferCount
        borrowReturnSum = borrowReturnSum + metrics.borrowReturnCount
    if allocatedSum != ledger.totalMetrics.allocated ||
       liveSum != ledger.totalMetrics.live ||
       allocatedBytesSum != ledger.totalMetrics.allocatedBytes ||
       liveBytesSum != ledger.totalMetrics.liveBytes ||
       retainedSum != ledger.totalMetrics.retained ||
       releasedSum != ledger.totalMetrics.released ||
       releasedBytesSum != ledger.totalMetrics.releasedBytes ||
       transferSum != ledger.totalMetrics.ownerTransferCount ||
       borrowReturnSum != ledger.totalMetrics.borrowReturnCount:
        lifetimeLedgerFail("lifetime_ledger: category total metrics mismatch")
    if peakLiveSum < ledger.totalMetrics.peakLive:
        lifetimeLedgerFail("lifetime_ledger: aggregate peak exceeds category peaks")
    if peakLiveBytesSum < ledger.totalMetrics.peakLiveBytes:
        lifetimeLedgerFail("lifetime_ledger: aggregate peak bytes exceeds category peaks")
    ledger.closed = true

fn LifetimeLedgerReadTotalMetrics(ledger: var LifetimeLedger,
                                  outMetrics: var LifetimeLedgerMetrics) =
    if ledger.storageReleased:
        lifetimeLedgerFail("lifetime_ledger: metrics read after storage release")
    outMetrics = ledger.totalMetrics
    if ledger.closed:
        ledger.finalMetricsRead = true

fn LifetimeLedgerReadCategoryMetrics(ledger: var LifetimeLedger,
                                     categoryId: int32,
                                     outMetrics: var LifetimeLedgerMetrics) =
    if ledger.storageReleased:
        lifetimeLedgerFail("lifetime_ledger: category read after storage release")
    let categoryIndex = lifetimeLedgerRequireCategoryIndex(ledger, categoryId)
    outMetrics = ledger.categoryMetrics[categoryIndex]

fn lifetimeLedgerRecordSequenceStorage(capacity: int32,
                                       elementBytes: int32,
                                       receipt: var LifetimeLedgerStorageReleaseReceipt) =
    if capacity < 0 || elementBytes <= 0:
        lifetimeLedgerFail("lifetime_ledger: invalid sequence storage shape")
    receipt.releasedSequenceCount = receipt.releasedSequenceCount + 1
    if capacity > 0:
        receipt.releasedSequenceBufferCount =
            receipt.releasedSequenceBufferCount + 1
        receipt.releasedSequenceCapacityBytes =
            receipt.releasedSequenceCapacityBytes +
            int64(capacity) * int64(elementBytes)

fn LifetimeLedgerReleaseStorage(
        ledger: var LifetimeLedger): LifetimeLedgerStorageReleaseReceipt =
    if !ledger.closed:
        lifetimeLedgerFail("lifetime_ledger: storage release before close")
    if !ledger.finalMetricsRead:
        lifetimeLedgerFail("lifetime_ledger: storage release before final metrics read")
    if ledger.storageReleased:
        lifetimeLedgerFail("lifetime_ledger: duplicate storage release")
    var receipt: LifetimeLedgerStorageReleaseReceipt
    lifetimeLedgerRecordSequenceStorage(
        ledger.categoryNames.cap, sizeof(str), receipt)
    lifetimeLedgerRecordSequenceStorage(
        ledger.ownerNames.cap, sizeof(str), receipt)
    lifetimeLedgerRecordSequenceStorage(
        ledger.ownerClosed.cap, sizeof(bool), receipt)
    lifetimeLedgerRecordSequenceStorage(
        ledger.objects.cap, sizeof(LifetimeLedgerObject), receipt)
    lifetimeLedgerRecordSequenceStorage(
        ledger.borrows.cap, sizeof(LifetimeLedgerBorrow), receipt)
    lifetimeLedgerRecordSequenceStorage(
        ledger.categoryMetrics.cap, sizeof(LifetimeLedgerMetrics), receipt)
    seqs.freeSeqStrRelease(ledger.categoryNames)
    seqs.freeSeqStrRelease(ledger.ownerNames)
    freeSeq(ledger.ownerClosed)
    freeSeq(ledger.objects)
    freeSeq(ledger.borrows)
    freeSeq(ledger.categoryMetrics)
    ledger.totalMetrics = LifetimeLedgerMetrics()
    ledger.storageReleased = true
    receipt.storageReleased = LifetimeLedgerStorageReleased(ledger)
    if !receipt.storageReleased:
        lifetimeLedgerFail("lifetime_ledger: sequence storage release incomplete")
    if (receipt.releasedSequenceBufferCount == 0) !=
       (receipt.releasedSequenceCapacityBytes == int64(0)):
        lifetimeLedgerFail("lifetime_ledger: sequence storage receipt corrupt")
    if receipt.releasedSequenceCount != 6:
        lifetimeLedgerFail("lifetime_ledger: sequence storage release count incomplete")
    if receipt.releasedSequenceBufferCount > receipt.releasedSequenceCount:
        lifetimeLedgerFail("lifetime_ledger: sequence storage buffer count exceeds sequences")
    return receipt

fn LifetimeLedgerStorageReleased(ledger: var LifetimeLedger): bool =
    return ledger.closed && ledger.finalMetricsRead &&
           ledger.storageReleased &&
           ledger.categoryNames.len == 0 &&
           ledger.categoryNames.cap == 0 &&
           ledger.ownerNames.len == 0 &&
           ledger.ownerNames.cap == 0 &&
           ledger.ownerClosed.len == 0 &&
           ledger.ownerClosed.cap == 0 &&
           ledger.objects.len == 0 &&
           ledger.objects.cap == 0 &&
           ledger.borrows.len == 0 &&
           ledger.borrows.cap == 0 &&
           ledger.categoryMetrics.len == 0 &&
           ledger.categoryMetrics.cap == 0
