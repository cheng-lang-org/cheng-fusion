import cheng/core/backend/x86_64_encode as x64
import cheng/core/backend/x86_64_body_emit as x64body
import cheng/core/backend/elf_x86_64_writer as elf_x64
import cheng/core/backend/coff_x86_64_writer as coff_x64
import cheng/core/backend/regalloc_x86_64_adapter as adapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/tooling/compiler_main as compiler

fn main(): int32 =
    if !adapter.RegallocX64CodegenUnitRegister():
        return 70
    if !contract.CodegenCompositionActivateUnit(
           contract.CodegenUnitX64):
        return 71
    return compiler.CompilerMainCompositionProcessEntry()
