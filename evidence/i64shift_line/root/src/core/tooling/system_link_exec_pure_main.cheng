fn PureSystemLinkExecGetEnv(key: str): str =
    return os.GetEnv(key)

@borrows
fn PureSystemLinkExecFlagCode(key: str): int32 =
    if key == "--root":
        return 1
    if key == "--out":
        return 2
    if key == "--in":
        return 3
    if key == "--report-out":
        return 4
    if key == "--target":
        return 5
    if key == "--export-roots":
        return 6
    if key == "--browser-bridge-object":
        return 7
    if key == "--emit":
        return 8
    if key == "--plan-build-probe":
        return 9
    if key == "--symbol-visibility":
        return 10
    if key == "--provider-objects":
        return 11
    if key == "--runtime-provider-bundle":
        return 12
    if key == "--world-head":
        return 13
    if key == "--lock":
        return 14
    if key == "--baseline-surface":
        return 15
    if key == "--channel":
        return 16
    return 0

fn PureSystemLinkExecReadFlagCodeRawLen(code: int32, raw: ptr): int32 =
    var rawLen = PureSystemLinkExecReadFlagCodeRawLenBridge(code)
    if raw != nil:
        let cLen = PureSystemLinkExecCStringLenBridge(raw)
        if cLen > rawLen:
            rawLen = cLen
    return rawLen

fn PureSystemLinkExecRawFlagBridgeEnabled(): bool =
    let raw = PureSystemLinkExecStripBridge(PureSystemLinkExecGetEnv("CHENG_PURE_RAW_FLAG_BRIDGE"))
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

fn PureSystemLinkExecFlagCodeHasValue(code: int32): bool =
    if !PureSystemLinkExecRawFlagBridgeEnabled():
        return false
    let rawLen = PureSystemLinkExecReadFlagCodeRawLenBridge(code)
    if rawLen > 0:
        return true
    return false

@borrows
fn PureSystemLinkExecWriteFdLine(fd: int32, text: str) =
    if len(text) > 0:
        let _ = PureSystemLinkExecWriteFdBridge(fd,
                                                StrDataPtr(text),
                                                int64(len(text)))
    let newline = "\n"
    let _ = PureSystemLinkExecWriteFdBridge(fd,
                                            StrDataPtr(newline),
                                            int64(1))

@borrows
fn PureSystemLinkExecPrintLine(text: str) =
    PureSystemLinkExecWriteFdLine(1, text)

@borrows
fn PureSystemLinkExecPrintErr(text: str) =
    PureSystemLinkExecWriteFdLine(2, text)

fn PureSystemLinkExecProgressStdErrEnabled(): bool =
    let raw = PureSystemLinkExecStripBridge(PureSystemLinkExecGetEnv("CHENG_PROGRESS"))
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

fn PureSystemLinkExecBoolText(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn PureSystemLinkExecReportLine(report: str,
                                line: str): str =
    return Fmt"{report}{line}\n"

@borrows
fn PureSystemLinkExecReportField(report: str,
                                  key: str,
                                  value: str): str =
    return PureSystemLinkExecReportLine(report, Fmt"{key}={value}")

@borrows
fn PureSystemLinkExecReportText(report: str,
                                 text: str): str =
    return Fmt"{report}{text}"

fn PureSystemLinkExecRssBytesText(): str =
    let pid: int64 = PureSystemLinkExecGetPidBridge()
    if pid <= int64(0):
        return "-1"
    let rss = PureSystemLinkExecProcessRssBytesBridge(pid)
    if rss <= int64(0):
        return "-1"
    return PureSystemLinkExecI64ToStrBridge(rss)

@borrows
fn PureSystemLinkExecWriteTextFile(rootDir: str,
                                   raw: str,
                                   text: str): bool =
    if len(raw) <= 0:
        return false
    let rooted = PureSystemLinkExecRootedPath(rootDir, raw)
    if len(rooted) <= 0:
        return false
    PureSystemLinkExecWriteTextFileBridge(rooted, text)
    return true

fn PureSystemLinkExecProgressAppendEnabled(): bool =
    let raw = PureSystemLinkExecStripBridge(PureSystemLinkExecGetEnv("CHENG_PROGRESS_APPEND"))
    return len(raw) > 0 && raw != "0" && raw != "false"

@borrows
fn PureSystemLinkExecProgressPrepare(rootDir: str) =
    let progressPathRaw = PureSystemLinkExecGetEnv("CHENG_PROGRESS_OUT")
    let progressPath = PureSystemLinkExecStripBridge(progressPathRaw)
    if len(progressPath) <= 0:
        return
    if PureSystemLinkExecProgressAppendEnabled():
        return
    let _ = PureSystemLinkExecWriteTextFile(rootDir, progressPath, "")
    os.SetEnv("CHENG_PROGRESS_APPEND", "1")

@borrows
fn PureSystemLinkExecWriteReportOutRawTextFile(text: str): bool =
    var reportPath: str
    if !PureSystemLinkExecReadFlagValueBridge("--report-out", reportPath):
        return false
    if len(reportPath) <= 0:
        return false
    PureSystemLinkExecWriteTextFileBridge(reportPath, text)
    return true

@borrows
fn PureSystemLinkExecProgressEmit(rootDir: str,
                                  phase: str,
                                  status: str) =
    let stderrEnabled = PureSystemLinkExecProgressStdErrEnabled()
    let progressPathRaw = PureSystemLinkExecGetEnv("CHENG_PROGRESS_OUT")
    let progressPath = PureSystemLinkExecStripBridge(progressPathRaw)
    if !stderrEnabled:
        if len(progressPath) <= 0:
            return
    let line = Fmt"compile_progress phase=pure_{phase} status={status}"
    if stderrEnabled:
        PureSystemLinkExecPrintErr(line)
    if len(progressPath) <= 0:
        return
    let _ = chengpath.AppendTextFile(
        rootDir, progressPath, Fmt"{line}\n")

fn PureSystemLinkExecRoot(): str =
    let envRoot = PureSystemLinkExecStripBridge(PureSystemLinkExecGetEnv("CHENG_ROOT"))
    if len(envRoot) > 0:
        return envRoot
    var rootFlag: str
    if PureSystemLinkExecReadFlagValueBridge("--root", rootFlag):
        if len(rootFlag) > 0:
            return rootFlag
    return "."

@borrows
fn PureSystemLinkExecEnsureRootEnv(rootDir: str) =
    if len(PureSystemLinkExecStripBridge(PureSystemLinkExecGetEnv("CHENG_ROOT"))) <= 0:
        if len(rootDir) > 0:
            os.SetEnv("CHENG_ROOT", strings.CloneStr(rootDir))

fn PureSystemLinkExecUsage(rootDir: str) =
    PureSystemLinkExecPrintLine("cheng pure system_link_exec")
    PureSystemLinkExecPrintLine(Fmt"root={rootDir}")
    PureSystemLinkExecPrintLine("commands: status, system_link_exec")

@borrows
fn PureSystemLinkExecCurrentExecutablePath(rootDir: str): str =
    let raw = PureSystemLinkExecStripBridge(cmdline.ProgramName())
    if len(raw) <= 0:
        return ""
    return raw

@borrows
fn PureSystemLinkExecRootedPath(rootDir: str, raw: str): str =
    let text = raw
    if len(text) <= 0:
        return strings.CloneStr(text)
    if text == ".":
        return strings.CloneStr(rootDir)
    if text[0] == '/':
        return strings.CloneStr(text)
    if len(text) >= 3:
        if text[1] == ':':
            if text[2] == '/':
                return strings.CloneStr(text)
            if text[2] == '\\':
                return strings.CloneStr(text)
    let root = rootDir
    if len(root) <= 0:
        return strings.CloneStr(text)
    if root[len(root) - 1] == '/':
        return root + text
    if root[len(root) - 1] == '\\':
        return root + text
    return root + "/" + text

@borrows
fn PureSystemLinkExecCloneStrSeq(items: str[]): str[] =
    var out: str[]
    for i in 0..<items.len:
        add(out, strings.CloneStr(items[i]))
    return out

@borrows
fn PureSystemLinkExecNormalizeRequestInPlace(rootDir: str,
                                             req: var creq.CompilerRequest) =
    var normalizedRoot = PureSystemLinkExecRootedPath(rootDir, req.rootDir)
    if len(normalizedRoot) <= 0:
        normalizedRoot = strings.CloneStr(rootDir)
    let normalizedSource = PureSystemLinkExecRootedPath(normalizedRoot, req.sourcePath)
    let normalizedOutput = PureSystemLinkExecRootedPath(normalizedRoot, req.outputPath)
    let normalizedReport = PureSystemLinkExecRootedPath(normalizedRoot, req.reportPath)
    var normalizedReq = creq.CompilerRequestNew(normalizedRoot,
                                                normalizedSource,
                                                normalizedOutput,
                                                strings.CloneStr(req.targetTriple),
                                                req.emitKind,
                                                normalizedReport)
    normalizedReq = creq.CompilerRequestWithSymbolVisibility(
        normalizedReq,
        strings.CloneStr(req.symbolVisibility))
    normalizedReq = creq.CompilerRequestWithBrowserBridgeObject(
        normalizedReq,
        strings.CloneStr(req.browserBridgeObjectPath))
    normalizedReq = creq.CompilerRequestWithExportRootSymbols(
        normalizedReq,
        PureSystemLinkExecCloneStrSeq(req.exportRootSymbols))
    normalizedReq = creq.CompilerRequestWithProviderObjectPaths(
        normalizedReq,
        PureSystemLinkExecCloneStrSeq(req.providerObjectPaths))
    normalizedReq = creq.CompilerRequestWithRuntimeProviderBundle(
        normalizedReq,
        strings.CloneStr(req.runtimeProviderBundle))
    normalizedReq = creq.CompilerRequestWithMode(
        normalizedReq,
        strings.CloneStr(req.compileMode))
    normalizedReq.backendKind = req.backendKind
    normalizedReq.jobCount = req.jobCount
    normalizedReq.exactFunctionSourcePath =
        strings.CloneStr(req.exactFunctionSourcePath)
    normalizedReq.exactFunctionName = strings.CloneStr(req.exactFunctionName)
    normalizedReq.exactFunctionDriverPath =
        strings.CloneStr(req.exactFunctionDriverPath)
    creq.CompilerRequestSeal(normalizedReq)
    req = normalizedReq

@borrows
fn PureSystemLinkExecStageBlockerDetail(phase: str, blockerId: str, detail: str): str =
    if len(detail) > 0:
        return strings.CloneStr(detail)
    return Fmt" pure system_link_exec: {phase}: {blockerId}"

@borrows
fn PureSystemLinkExecWriteStageBlockerReport(rootDir: str,
                                             reportPath: str,
                                             blockerId: str,
                                             phase: str,
                                             requestMaterialized: bool,
                                             requestNormalized: bool,
                                             sourcePath: str,
                                             outputPath: str,
                                             detail: str): bool =
    if len(reportPath) <= 0:
        return true
    var report = ""
    report = PureSystemLinkExecReportLine(report, "plan_ready_code=0")
    report = PureSystemLinkExecReportLine(report, "plan_not_ready_code=1")
    report = PureSystemLinkExecReportLine(report, "plan_not_ready_detail_code=20")
    report = PureSystemLinkExecReportLine(report, "system_link_exec_runtime_execute=0")
    report = PureSystemLinkExecReportLine(report, "real_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "cold_system_link_exec=0")
    report = PureSystemLinkExecReportLine(report, "full_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "gate_blocked=1")
    report = PureSystemLinkExecReportField(report, "gate_blocker_id", blockerId)
    report = PureSystemLinkExecReportField(report, "gate_blocker_phase", phase)
    let requestMaterializedText = PureSystemLinkExecBoolText(requestMaterialized)
    let requestNormalizedText = PureSystemLinkExecBoolText(requestNormalized)
    report = PureSystemLinkExecReportField(report, "request_materialized", requestMaterializedText)
    report = PureSystemLinkExecReportField(report, "request_normalized", requestNormalizedText)
    report = PureSystemLinkExecReportField(report, "request_source_path", sourcePath)
    report = PureSystemLinkExecReportField(report, "request_output_path", outputPath)
    report = PureSystemLinkExecReportField(report, "request_report_path", reportPath)
    var emitRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--emit", "", emitRaw)
    report = PureSystemLinkExecReportField(report, "request_emit", emitRaw)
    let detailText = PureSystemLinkExecStageBlockerDetail(phase, blockerId, detail)
    report = PureSystemLinkExecReportField(report, "gate_blocker_detail", detailText)
    report = PureSystemLinkExecReportField(report, "error", detailText)
    return PureSystemLinkExecWriteTextFile(rootDir, reportPath, report)

@borrows
fn PureSystemLinkExecWriteReport(rootDir: str,
                                  reportPath: str,
                                  plan: var sexec.SystemLinkExecPlan,
                                  runtimeReport: str): bool =
    if len(reportPath) <= 0:
        return true
    var report = ""
    report = PureSystemLinkExecReportField(report, "plan_ready_code", strings.IntToStr(plan.readyCode))
    report = PureSystemLinkExecReportField(report, "plan_not_ready_code", strings.IntToStr(plan.notReadyCode))
    report = PureSystemLinkExecReportField(report, "plan_not_ready_detail_code", strings.IntToStr(plan.notReadyDetailCode))
    report = PureSystemLinkExecReportField(report, "plan_not_ready_reason", plan.notReadyReason)
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_ir_function_count", strings.IntToStr(plan.compilerCsgTypedIrFunctionCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_ir_node_count", strings.IntToStr(plan.compilerCsgTypedIrNodeCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_ir_statement_count", strings.IntToStr(plan.compilerCsgTypedIrStatementCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_expr_fact_count", strings.IntToStr(plan.compilerCsgTypedExprFactCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_expr_layer_expr_count", strings.IntToStr(plan.compilerCsgExprLayerExprCount))
    report = PureSystemLinkExecReportField(report, "lowering_function_count", strings.IntToStr(plan.loweringFunctionCount))
    report = PureSystemLinkExecReportField(report, "lowering_typed_ir_function_count", strings.IntToStr(plan.loweringTypedIrFunctionCount))
    report = PureSystemLinkExecReportField(report, "lowering_typed_ir_node_count", strings.IntToStr(plan.loweringTypedIrNodeCount))
    report = PureSystemLinkExecReportField(report, "lowering_typed_ir_statement_count", strings.IntToStr(plan.loweringTypedIrStatementCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_item_count", strings.IntToStr(plan.primaryPlanItemCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_reachable_function_count", strings.IntToStr(plan.primaryPlanReachableFunctionCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_instruction_word_count", strings.IntToStr(plan.primaryPlanInstructionWordCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_missing_count", strings.IntToStr(plan.primaryPlanMissingCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_error_body_kind_code", strings.IntToStr(plan.primaryPlanErrorBodyKindCode))
    let loweringRequestedJobs: int32 = plan.loweringRequestedJobCount
    let loweringActiveWorkers: int32 = plan.loweringActiveWorkerCount
    let loweringCompletedWorkers: int32 = plan.loweringCompletedWorkerCount
    let loweringTaskCount: int32 = plan.loweringTaskCount
    var loweringSchedule: str = "none"
    var loweringParallelStatus: str = "none"
    if loweringTaskCount > 0:
        if loweringActiveWorkers > 1:
            if loweringCompletedWorkers == loweringActiveWorkers:
                loweringSchedule = "ws"
                loweringParallelStatus = "active"
            else:
                loweringSchedule = "inactive"
                loweringParallelStatus = "inactive"
        elif loweringActiveWorkers == 1:
            if loweringCompletedWorkers == 1:
                loweringSchedule = "serial"
                loweringParallelStatus = "serial"
            else:
                loweringSchedule = "inactive"
                loweringParallelStatus = "inactive"
        else:
            loweringSchedule = "inactive"
            loweringParallelStatus = "inactive"
    report = PureSystemLinkExecReportField(report, "function_task_job_count", strings.IntToStr(loweringRequestedJobs))
    report = PureSystemLinkExecReportField(report, "function_task_schedule", loweringSchedule)
    report = PureSystemLinkExecReportField(report, "lowering_parallel_status", loweringParallelStatus)
    report = PureSystemLinkExecReportField(report, "lowering_parallel_job_count", strings.IntToStr(loweringActiveWorkers))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_requested_job_count", strings.IntToStr(loweringRequestedJobs))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_active_workers", strings.IntToStr(loweringActiveWorkers))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_completed_workers", strings.IntToStr(loweringCompletedWorkers))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_task_count", strings.IntToStr(loweringTaskCount))
    report = PureSystemLinkExecReportLine(report, "lowering_parallel_merge_order=decl_ordinal")
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_schedule", plan.primaryObjectPlan.wordFillSchedule)
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_requested_job_count", strings.IntToStr(plan.primaryObjectPlan.wordFillRequestedJobCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_worker_count", strings.IntToStr(plan.primaryObjectPlan.wordFillWorkerCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_completed_worker_count", strings.IntToStr(plan.primaryObjectPlan.wordFillCompletedWorkerCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_task_count", strings.IntToStr(plan.primaryObjectPlan.wordFillTaskCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_merge_order", plan.primaryObjectPlan.wordFillMergeOrder)
    report = PureSystemLinkExecReportField(report, "codegen_task_count", strings.IntToStr(plan.primaryObjectPlan.wordFillTaskCount))
    report = PureSystemLinkExecReportField(report, "codegen_worker_count", strings.IntToStr(plan.primaryObjectPlan.wordFillWorkerCount))
    report = PureSystemLinkExecReportField(report, "codegen_schedule", plan.primaryObjectPlan.wordFillSchedule)
    report = PureSystemLinkExecReportField(report, "codegen_deterministic_merge", plan.primaryObjectPlan.wordFillMergeOrder)
    if len(runtimeReport) > 0:
        if len(report) > 0:
            report = PureSystemLinkExecReportText(report, "\n")
        report = PureSystemLinkExecReportLine(report, runtimeReport)
    report = PureSystemLinkExecReportLine(report, "system_link_exec=1")
    report = PureSystemLinkExecReportLine(report, "real_backend_codegen=1")
    report = PureSystemLinkExecReportLine(report, "cold_system_link_exec=0")
    report = PureSystemLinkExecReportLine(report, "system_link_exec_scope=selfhost_runtime_execute")
    report = PureSystemLinkExecReportLine(report, "compiler_class=ordinary_compiler")
    report = PureSystemLinkExecReportLine(report, "backend_driver_candidate=full_backend_codegen")
    report = PureSystemLinkExecReportLine(report, "full_backend_codegen=1")
    return PureSystemLinkExecWriteTextFile(rootDir, reportPath, report)

@borrows
fn PureSystemLinkExecWriteErrorReport(rootDir: str,
                                       reportPath: str,
                                       plan: var sexec.SystemLinkExecPlan,
                                       blockerId: str,
                                       phase: str,
                                       reason: str): bool =
    if len(reportPath) <= 0:
        return true
    var report = ""
    report = PureSystemLinkExecReportField(report, "plan_ready_code", strings.IntToStr(plan.readyCode))
    report = PureSystemLinkExecReportField(report, "plan_not_ready_code", strings.IntToStr(plan.notReadyCode))
    report = PureSystemLinkExecReportField(report, "plan_not_ready_detail_code", strings.IntToStr(plan.notReadyDetailCode))
    report = PureSystemLinkExecReportField(report, "plan_not_ready_reason", plan.notReadyReason)
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_ir_function_count", strings.IntToStr(plan.compilerCsgTypedIrFunctionCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_ir_node_count", strings.IntToStr(plan.compilerCsgTypedIrNodeCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_ir_statement_count", strings.IntToStr(plan.compilerCsgTypedIrStatementCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_typed_expr_fact_count", strings.IntToStr(plan.compilerCsgTypedExprFactCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_expr_layer_expr_count", strings.IntToStr(plan.compilerCsgExprLayerExprCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_signature_line", strings.IntToStr(plan.compilerCsgFirstFunctionSignatureLine))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_body_line", strings.IntToStr(plan.compilerCsgFirstFunctionBodyLine))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_node_count", strings.IntToStr(plan.compilerCsgFirstFunctionNodeCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_statement_count", strings.IntToStr(plan.compilerCsgFirstFunctionStatementCount))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_return_node_index", strings.IntToStr(plan.compilerCsgFirstFunctionReturnNodeIndex))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_return_type_code", strings.IntToStr(plan.compilerCsgFirstFunctionReturnTypeCode))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_return_expr_code", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprCode))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_return_expr_len", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprLen))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_return_expr_first_byte", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprFirstByte))
    report = PureSystemLinkExecReportField(report, "compiler_csg_first_function_return_expr_last_byte", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprLastByte))
    report = PureSystemLinkExecReportField(report, "lowering_function_count", strings.IntToStr(plan.loweringFunctionCount))
    report = PureSystemLinkExecReportField(report, "lowering_typed_ir_function_count", strings.IntToStr(plan.loweringTypedIrFunctionCount))
    report = PureSystemLinkExecReportField(report, "lowering_typed_ir_node_count", strings.IntToStr(plan.loweringTypedIrNodeCount))
    report = PureSystemLinkExecReportField(report, "lowering_typed_ir_statement_count", strings.IntToStr(plan.loweringTypedIrStatementCount))
    report = PureSystemLinkExecReportField(report, "lowering_primary_ir_build_function_count", strings.IntToStr(plan.loweringPrimaryIrBuildFunctionCount))
    report = PureSystemLinkExecReportField(report, "lowering_primary_ir_function_count", strings.IntToStr(plan.loweringPrimaryIrFunctionCount))
    report = PureSystemLinkExecReportField(report, "lowering_primary_ir_skipped_function_count", strings.IntToStr(plan.loweringPrimaryIrSkippedFunctionCount))
    report = PureSystemLinkExecReportField(report, "lowering_primary_ir_entry_typed_function_index", strings.IntToStr(plan.loweringPrimaryIrEntryTypedFunctionIndex))
    report = PureSystemLinkExecReportField(report, "lowering_primary_ir_entry_body_kind_code", strings.IntToStr(plan.loweringPrimaryIrEntryBodyKindCode))
    report = PureSystemLinkExecReportField(report, "lowering_primary_ir_entry_statement_count", strings.IntToStr(plan.loweringPrimaryIrEntryStatementCount))
    report = PureSystemLinkExecReportField(report, "lowering_missing_count", strings.IntToStr(plan.loweringMissingCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_item_count", strings.IntToStr(plan.primaryPlanItemCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_reachable_function_count", strings.IntToStr(plan.primaryPlanReachableFunctionCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_instruction_word_count", strings.IntToStr(plan.primaryPlanInstructionWordCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_missing_count", strings.IntToStr(plan.primaryPlanMissingCount))
    report = PureSystemLinkExecReportField(report, "primary_plan_error_body_kind_code", strings.IntToStr(plan.primaryPlanErrorBodyKindCode))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_function", plan.primaryObjectPlan.error.functionName)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_function_source_path", plan.primaryObjectPlan.error.functionSourcePath)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_kind", plan.primaryObjectPlan.error.bodyKind)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_typed_ir_kind", plan.primaryObjectPlan.error.typedIrKind)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_line_number", strings.IntToStr(plan.primaryObjectPlan.error.lineNumber))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_word_offset", strings.IntToStr(plan.primaryObjectPlan.error.wordOffset))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_word_rel_offset", strings.IntToStr(plan.primaryObjectPlan.error.wordRelOffset))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_word_count", strings.IntToStr(plan.primaryObjectPlan.error.wordCount))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_call_target_ordinal", strings.IntToStr(plan.primaryObjectPlan.error.callTargetOrdinal))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_call_target", plan.primaryObjectPlan.error.callTarget)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_call_target_source_path", plan.primaryObjectPlan.error.callTargetSourcePath)
    # P2 consumer (pure system-link exec report): sealed 10-case resolution
    # kind + label, replaces the (any_source_index, any_source_count) 6-state
    # 旁路. Frontend ad-hoc parsers in pure exec mode read same key as
    # dispatch_min (primary_object_first_missing_call_target_resolution_*).
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_call_target_resolution_kind", strings.IntToStr(int32(plan.primaryObjectPlan.error.callTargetResolutionKind)))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_call_target_resolution_label", texpr.TypedExprIrCallTargetResolutionKindLabel(plan.primaryObjectPlan.error.callTargetResolutionKind))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_statement_trace", plan.primaryObjectPlan.error.statementTrace)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_param_trace", plan.primaryObjectPlan.error.paramTrace)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_op_count", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.opCount))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_term_count", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.termCount))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_block_count", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.blockCount))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_call_count", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.callCount))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_slot_count", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.slotCount))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_frame_bytes", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.frameBytes))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_prologue_word_count", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.prologueWordCount))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_op_index", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroOpIndex))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_op_kind", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroOpKind))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_op_target", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroOpTarget))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_target_slot_name", plan.primaryObjectPlan.error.bodyIrDetail.firstZeroTargetSlotName)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_target_slot_type", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroTargetSlotType))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_target_slot_size", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroTargetSlotSize))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_target_slot_offset", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroTargetSlotOffset))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_op_operand0", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroOpOperand0))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_op_operand1", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroOpOperand1))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_op_operand2", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroOpOperand2))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_op_operand3", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroOpOperand3))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_slot_diag", plan.primaryObjectPlan.error.bodyIrDetail.firstZeroSlotDiag)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_term_index", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroTermIndex))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_term_kind", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroTermKind))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_block_index", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroBlockIndex))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_word_inner_offset", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.firstZeroWordInnerOffset))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_call_target", plan.primaryObjectPlan.error.bodyIrDetail.firstZeroCallTarget)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_zero_call_diag", plan.primaryObjectPlan.error.bodyIrDetail.firstZeroCallDiag)
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_last_call_result_slot", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.lastCallResultSlot))
    report = PureSystemLinkExecReportField(report, "primary_object_first_missing_body_ir_last_call_result_type", strings.IntToStr(plan.primaryObjectPlan.error.bodyIrDetail.lastCallResultType))
    let loweringRequestedJobs: int32 = plan.loweringRequestedJobCount
    let loweringActiveWorkers: int32 = plan.loweringActiveWorkerCount
    let loweringCompletedWorkers: int32 = plan.loweringCompletedWorkerCount
    let loweringTaskCount: int32 = plan.loweringTaskCount
    var loweringSchedule = "none"
    var loweringParallelStatus = "none"
    if loweringTaskCount > 0:
        if loweringActiveWorkers > 1:
            if loweringCompletedWorkers == loweringActiveWorkers:
                loweringSchedule = "ws"
                loweringParallelStatus = "active"
            else:
                loweringSchedule = "inactive"
                loweringParallelStatus = "inactive"
        elif loweringActiveWorkers == 1:
            if loweringCompletedWorkers == 1:
                loweringSchedule = "serial"
                loweringParallelStatus = "serial"
            else:
                loweringSchedule = "inactive"
                loweringParallelStatus = "inactive"
        else:
            loweringSchedule = "inactive"
            loweringParallelStatus = "inactive"
    report = PureSystemLinkExecReportField(report, "function_task_job_count", strings.IntToStr(loweringRequestedJobs))
    report = PureSystemLinkExecReportField(report, "function_task_schedule", loweringSchedule)
    report = PureSystemLinkExecReportField(report, "lowering_parallel_status", loweringParallelStatus)
    report = PureSystemLinkExecReportField(report, "lowering_parallel_job_count", strings.IntToStr(loweringActiveWorkers))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_requested_job_count", strings.IntToStr(loweringRequestedJobs))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_active_workers", strings.IntToStr(loweringActiveWorkers))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_completed_workers", strings.IntToStr(loweringCompletedWorkers))
    report = PureSystemLinkExecReportField(report, "lowering_parallel_task_count", strings.IntToStr(loweringTaskCount))
    report = PureSystemLinkExecReportLine(report, "lowering_parallel_merge_order=decl_ordinal")
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_schedule", plan.primaryObjectPlan.wordFillSchedule)
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_requested_job_count", strings.IntToStr(plan.primaryObjectPlan.wordFillRequestedJobCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_worker_count", strings.IntToStr(plan.primaryObjectPlan.wordFillWorkerCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_completed_worker_count", strings.IntToStr(plan.primaryObjectPlan.wordFillCompletedWorkerCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_task_count", strings.IntToStr(plan.primaryObjectPlan.wordFillTaskCount))
    report = PureSystemLinkExecReportField(report, "primary_object_word_fill_merge_order", plan.primaryObjectPlan.wordFillMergeOrder)
    report = PureSystemLinkExecReportField(report, "codegen_task_count", strings.IntToStr(plan.primaryObjectPlan.wordFillTaskCount))
    report = PureSystemLinkExecReportField(report, "codegen_worker_count", strings.IntToStr(plan.primaryObjectPlan.wordFillWorkerCount))
    report = PureSystemLinkExecReportField(report, "codegen_schedule", plan.primaryObjectPlan.wordFillSchedule)
    report = PureSystemLinkExecReportField(report, "codegen_deterministic_merge", plan.primaryObjectPlan.wordFillMergeOrder)
    report = PureSystemLinkExecReportLine(report, "system_link_exec_runtime_execute=0")
    report = PureSystemLinkExecReportLine(report, "real_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "cold_system_link_exec=0")
    report = PureSystemLinkExecReportLine(report, "full_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "gate_blocked=1")
    report = PureSystemLinkExecReportField(report, "gate_blocker_id", blockerId)
    report = PureSystemLinkExecReportField(report, "gate_blocker_phase", phase)
    if len(reason) > 0:
        report = PureSystemLinkExecReportField(report, "error", reason)
    else:
        report = PureSystemLinkExecReportField(report, "error", Fmt" pure system_link_exec: {phase}: {blockerId}")
    return PureSystemLinkExecWriteTextFile(rootDir, reportPath, report)

@borrows
fn PureSystemLinkExecStartsWith(text: str,
                                prefix: str): bool =
    let prefixLen = len(prefix)
    if prefixLen > len(text):
        return false
    var i = 0
    while i < prefixLen:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

@borrows
fn PureSystemLinkExecReadFlagCandidate(raw: str,
                                       next: str,
                                       key: str,
                                       outValue: var str): bool =
    let keyLen = len(key)
    let rawLen = len(raw)
    if keyLen > 0:
        if rawLen > keyLen:
            if PureSystemLinkExecStartsWith(raw, key):
                let sep: char = raw[keyLen]
                var hasSeparator = false
                if sep == ':':
                    hasSeparator = true
                if sep == '=':
                    hasSeparator = true
                if hasSeparator:
                    let valueLen: int32 = rawLen - keyLen - 1
                    if valueLen <= 0:
                        outValue = ""
                        return true
                    outValue = strings.SliceBytes(raw, keyLen + 1, valueLen)
                    return true
    if raw == key:
        if len(next) > 0:
            outValue = strings.CloneStr(next)
            return true
    return false

@borrows
fn PureSystemLinkExecReadCmdFlagOrDefaultInto(key: str,
                                              defaultValue: str,
                                              outValue: var str) =
    outValue = strings.CloneStr(defaultValue)
    let count = cmdline.ParamCount()
    if count > 1:
        for i in 1..count:
            let current = cmdline.ParamStr(i)
            var next = ""
            if i + 1 <= count:
                next = cmdline.ParamStr(i + 1)
            if PureSystemLinkExecReadFlagCandidate(current, next, key, outValue):
                return
    let code = PureSystemLinkExecFlagCode(key)
    let rawFlagBridgeEnabled = PureSystemLinkExecRawFlagBridgeEnabled()
    if code > 0:
        if rawFlagBridgeEnabled:
            if PureSystemLinkExecReadFlagValueBridge(key, outValue):
                return
            outValue = NewStringAlloc(0)
            return
    if count <= 1:
        return
    for i in 2..count:
        let current = cmdline.ParamStr(i)
        var next: str
        if i < count:
            next = cmdline.ParamStr(i + 1)
        if PureSystemLinkExecReadFlagCandidate(current, next, key, outValue):
            return

fn PureSystemLinkExecRawFlagEqText(raw: ptr, rawLen: int32, text: str): bool =
    if raw == nil:
        return false
    if rawLen != len(text):
        return false
    if rawLen <= 0:
        return true
    let textRaw = StrDataPtr(text)
    let cmp = PureSystemLinkExecMemcmp(raw, textRaw, rawLen)
    if cmp != 0:
        return false
    return true

fn PureSystemLinkExecPlanBuildProbeEnabled(): bool =
    let raw = PureSystemLinkExecReadFlagCodeRawPtrBridge(9)
    let rawLen = PureSystemLinkExecReadFlagCodeRawLen(9, raw)
    if raw != nil:
        if rawLen > 0:
            if PureSystemLinkExecRawFlagEqText(raw, rawLen, "0"):
                return false
            if PureSystemLinkExecRawFlagEqText(raw, rawLen, "false"):
                return false
            return true
    return false

fn PureSystemLinkExecPlanBuildDeepProbeEnabled(): bool =
    let raw = PureSystemLinkExecReadFlagCodeRawPtrBridge(9)
    let rawLen = PureSystemLinkExecReadFlagCodeRawLen(9, raw)
    if raw != nil:
        if rawLen > 0:
            return PureSystemLinkExecRawFlagEqText(raw, rawLen, "deep")
    return false

fn PureSystemLinkExecPlanBuildParseProbeEnabled(): bool =
    let raw = PureSystemLinkExecReadFlagCodeRawPtrBridge(9)
    let rawLen = PureSystemLinkExecReadFlagCodeRawLen(9, raw)
    if raw != nil:
        if rawLen > 0:
            return PureSystemLinkExecRawFlagEqText(raw, rawLen, "parse")
    return false

fn PureSystemLinkExecDebugEnabled(): bool =
    return false

fn PureSystemLinkExecEmitOk(value: creq.CompilerEmit): Result[creq.CompilerEmit] =
    var out: Result[creq.CompilerEmit]
    out.ok = true
    out.value = value
    out.err.code = 0
    out.err.msg = ""
    return out

fn PureSystemLinkExecEmitErr(msg: str): Result[creq.CompilerEmit] =
    var out: Result[creq.CompilerEmit]
    out.ok = false
    out.err.code = 1
    out.err.msg = msg
    return out

fn PureSystemLinkExecStringOk(value: str): Result[str] =
    var out: Result[str]
    out.ok = true
    out.value = value
    out.err.code = 0
    out.err.msg = ""
    return out

fn PureSystemLinkExecStringErr(msg: str): Result[str] =
    var out: Result[str]
    out.ok = false
    out.err.code = 1
    out.err.msg = msg
    return out

fn PureSystemLinkExecBoolOk(value: bool): Result[bool] =
    var out: Result[bool]
    out.ok = true
    out.value = value
    out.err.code = 0
    out.err.msg = ""
    return out

fn PureSystemLinkExecBoolErr(msg: str): Result[bool] =
    var out: Result[bool]
    out.ok = false
    out.err.code = 1
    out.err.msg = msg
    return out

fn PureSystemLinkExecEmitFromRawFlag(raw: ptr, rawLen: int32): Result[creq.CompilerEmit] =
    if rawLen <= 0:
        return PureSystemLinkExecEmitOk(creq.CompilerEmitExeValue())
    if PureSystemLinkExecRawFlagEqText(raw, rawLen, "exe"):
        return PureSystemLinkExecEmitOk(creq.CompilerEmitExeValue())
    if PureSystemLinkExecRawFlagEqText(raw, rawLen, "obj"):
        return PureSystemLinkExecEmitOk(creq.CompilerEmitObjValue())
    if PureSystemLinkExecRawFlagEqText(raw, rawLen, "shared"):
        return PureSystemLinkExecEmitErr(" pure system_link_exec: shared emit not supported")
    return PureSystemLinkExecEmitErr(" pure system_link_exec: unsupported --emit")
@borrows
fn PureSystemLinkExecEmitFromText(raw: str): Result[creq.CompilerEmit] =
    let text = PureSystemLinkExecStripBridge(raw)
    if len(text) <= 0:
        return PureSystemLinkExecEmitOk(creq.CompilerEmitExeValue())
    if text == "exe":
        return PureSystemLinkExecEmitOk(creq.CompilerEmitExeValue())
    if text == "obj":
        return PureSystemLinkExecEmitOk(creq.CompilerEmitObjValue())
    if text == "shared":
        return PureSystemLinkExecEmitErr(" pure system_link_exec: shared emit not supported")
    return PureSystemLinkExecEmitErr(" pure system_link_exec: unsupported --emit")

@borrows
fn PureSystemLinkExecSymbolVisibility(raw: str): Result[str] =
    let text = PureSystemLinkExecStripBridge(raw)
    if len(text) <= 0:
        return PureSystemLinkExecStringOk(creq.CompilerSymbolVisibilityPublic())
    if text == creq.CompilerSymbolVisibilityPublic():
        return PureSystemLinkExecStringOk(strings.CloneStr(text))
    if text == creq.CompilerSymbolVisibilityInternal():
        return PureSystemLinkExecStringOk(strings.CloneStr(text))
    return PureSystemLinkExecStringErr(" pure system_link_exec: unsupported --symbol-visibility")

@borrows
fn PureSystemLinkExecParseRequestInto(rootDir: str,
                                      outReq: var creq.CompilerRequest,
                                      outErr: var str): bool =
    var earlyReportPath: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_report_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--report-out", "", earlyReportPath)
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_report_flag", "done")

    var sourceRaw: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_in_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--in", "", sourceRaw)
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_in_flag", "done")
    let sourcePath = strings.CloneStr(sourceRaw)
    if PureSystemLinkExecDebugEnabled():
        PureSystemLinkExecPrintErr(Fmt"debug_system_link_exec=parse_source_raw len={len(sourceRaw)} value={sourceRaw}")
        PureSystemLinkExecPrintErr(Fmt"debug_system_link_exec=parse_source_path len={len(sourcePath)} value={sourcePath}")
    if len(sourcePath) <= 0:
        outErr = " pure system_link_exec: missing --in"
        return false

    var outputRaw: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_out_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--out", "", outputRaw)
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_out_flag", "done")
    let outputPath = outputRaw
    if len(outputPath) <= 0:
        outErr = " pure system_link_exec: missing --out"
        return false

    var packageRoot = strings.CloneStr(rootDir)
    var targetRaw: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_target_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--target", "", targetRaw)
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_target_flag", "done")
    var targetTriple = targetRaw
    if len(targetTriple) <= 0:
        targetTriple = "arm64-apple-darwin"

    var emitRaw: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_emit_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--emit", "", emitRaw)
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_emit_flag", "done")
    var emitRes = PureSystemLinkExecEmitFromText(emitRaw)
    let emitRawFlagBridgeEnabled = PureSystemLinkExecRawFlagBridgeEnabled()
    if len(emitRaw) <= 0:
        if emitRawFlagBridgeEnabled:
            PureSystemLinkExecProgressEmit(rootDir, "request_parse_emit_raw", "begin")
            let emitPtr = PureSystemLinkExecReadFlagCodeRawPtrBridge(8)
            let emitLen = PureSystemLinkExecReadFlagCodeRawLenBridge(8)
            PureSystemLinkExecProgressEmit(rootDir, "request_parse_emit_raw", "done")
            if emitPtr != nil:
                if emitLen > 0:
                    emitRes = PureSystemLinkExecEmitFromRawFlag(emitPtr, emitLen)
        else:
            PureSystemLinkExecProgressEmit(rootDir, "request_parse_emit_raw", "skipped")
    else:
        PureSystemLinkExecProgressEmit(rootDir, "request_parse_emit_raw", "skipped")
    if !emitRes.ok:
        outErr = emitRes.err.msg
        return false
    var emitKind = emitRes.value

    var symbolRaw: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_symbol_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--symbol-visibility", "", symbolRaw)
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_symbol_flag", "done")
    let symbolVisibilityRes = PureSystemLinkExecSymbolVisibility(symbolRaw)
    if !symbolVisibilityRes.ok:
        outErr = symbolVisibilityRes.err.msg
        return false
    let symbolVisibility = symbolVisibilityRes.value

    var browserBridgeObjectPath: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_browser_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--browser-bridge-object", "", browserBridgeObjectPath)
    var exportRootsText: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_export_roots_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--export-roots", "", exportRootsText)
    var providerObjectsText: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_provider_objects_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--provider-objects", "", providerObjectsText)
    var runtimeProviderBundle: str
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_runtime_bundle_flag", "begin")
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--runtime-provider-bundle", "", runtimeProviderBundle)
    PureSystemLinkExecProgressEmit(rootDir, "request_parse_optional_flags", "done")

    outReq.rootDir = packageRoot
    outReq.sourcePath = sourcePath
    outReq.outputPath = outputPath
    outReq.targetTriple = targetTriple
    outReq.emitKind = emitKind
    outReq.reportPath = PureSystemLinkExecRootedPath(rootDir, earlyReportPath)
    outReq.symbolVisibility = symbolVisibility
    outReq.browserBridgeObjectPath = browserBridgeObjectPath
    if os.GetEnv("CHENG_EXP_DBG") != "":
        os.WriteLine(os.GetStderr(), Fmt"expdbg purearg exportRootsText=[{exportRootsText}]")
    outReq.exportRootSymbols = creq.CompilerExportRootSymbolsFromText(exportRootsText)
    if os.GetEnv("CHENG_EXP_DBG") != "":
        os.WriteLine(os.GetStderr(), Fmt"expdbg purearg rootsLen={strings.IntToStr(outReq.exportRootSymbols.len)}")
    outReq.providerObjectPaths = creq.CompilerProviderObjectPathsFromText(providerObjectsText)
    outReq.runtimeProviderBundle = runtimeProviderBundle
    outReq.compileMode = ""
    outReq.jobCount = 1
    outErr = ""
    return true
@borrows
fn PureSystemLinkExecArgReportPath(rootDir: str): str =
    var raw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--report-out", "", raw)
    if len(raw) <= 0:
        return ""
    return PureSystemLinkExecRootedPath(rootDir, raw)

@borrows
fn PureSystemLinkExecWriteParseErrorReport(rootDir: str,
                                            reason: str): bool =
    let reportPath = PureSystemLinkExecArgReportPath(rootDir)
    if len(reportPath) <= 0:
        return true
    var report = ""
    report = PureSystemLinkExecReportLine(report, "plan_ready_code=0")
    report = PureSystemLinkExecReportLine(report, "plan_not_ready_code=1")
    report = PureSystemLinkExecReportLine(report, "plan_not_ready_detail_code=10")
    report = PureSystemLinkExecReportLine(report, "system_link_exec_runtime_execute=0")
    report = PureSystemLinkExecReportLine(report, "real_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "cold_system_link_exec=0")
    report = PureSystemLinkExecReportLine(report, "full_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "gate_blocked=1")
    report = PureSystemLinkExecReportLine(report, "gate_blocker_id=pure_runtime_system_link_exec_compiler_request_materialization_crashes_after_flag_parse")
    report = PureSystemLinkExecReportLine(report, "gate_blocker_phase=selfhost_request_parse_compiler_request_materialize")
    let count = cmdline.ParamCount()
    var requestArgCount = 0
    if count >= 2:
        requestArgCount = count - 1
    report = PureSystemLinkExecReportField(report, "request_arg_count", strings.IntToStr(requestArgCount))
    if count >= 2:
        var outIndex = 0
        for i in 2..count:
            var argText: str
            PureSystemLinkExecParamStrCopyBridgeInto(i, argText)
            let outIndexText = strings.IntToStr(outIndex)
            report = PureSystemLinkExecReportField(report, Fmt"request_arg_{outIndexText}", argText)
            outIndex = outIndex + 1
    report = PureSystemLinkExecReportField(report, "error", reason)
    return chengpath.WriteTextFileWithHandleHostBridge("", reportPath, report)

@borrows
fn PureSystemLinkExecWriteRunEntryPendingReport(rootDir: str): bool =
    let reportPath = PureSystemLinkExecArgReportPath(rootDir)
    if len(reportPath) <= 0:
        return true
    var sourceRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--in", "", sourceRaw)
    var outputRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--out", "", outputRaw)
    var emitRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--emit", "", emitRaw)
    var targetRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--target", "", targetRaw)
    var report = ""
    report = PureSystemLinkExecReportLine(report, "plan_ready_code=0")
    report = PureSystemLinkExecReportLine(report, "plan_not_ready_code=1")
    report = PureSystemLinkExecReportLine(report, "plan_not_ready_detail_code=20")
    report = PureSystemLinkExecReportLine(report, "system_link_exec_runtime_execute=0")
    report = PureSystemLinkExecReportLine(report, "real_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "cold_system_link_exec=0")
    report = PureSystemLinkExecReportLine(report, "full_backend_codegen=0")
    report = PureSystemLinkExecReportLine(report, "gate_blocked=1")
    report = PureSystemLinkExecReportLine(report, "gate_blocker_id=pure_runtime_system_link_exec_run_entry_pending")
    report = PureSystemLinkExecReportLine(report, "gate_blocker_phase=selfhost_run_entry_pending")
    report = PureSystemLinkExecReportLine(report, "request_materialized=0")
    report = PureSystemLinkExecReportLine(report, "request_normalized=0")
    report = PureSystemLinkExecReportField(report, "request_source_path", sourceRaw)
    report = PureSystemLinkExecReportField(report, "request_output_path", outputRaw)
    report = PureSystemLinkExecReportField(report, "request_report_path", reportPath)
    report = PureSystemLinkExecReportField(report, "request_emit", emitRaw)
    report = PureSystemLinkExecReportField(report, "request_target", targetRaw)
    let count = cmdline.ParamCount()
    var requestArgCount = 0
    if count >= 2:
        requestArgCount = count - 1
    report = PureSystemLinkExecReportField(report, "request_arg_count", strings.IntToStr(requestArgCount))
    if count >= 2:
        var outIndex = 0
        for i in 2..count:
            var argText: str
            PureSystemLinkExecParamStrCopyBridgeInto(i, argText)
            let outIndexText = strings.IntToStr(outIndex)
            report = PureSystemLinkExecReportField(report, Fmt"request_arg_{outIndexText}", argText)
            outIndex = outIndex + 1
    report = PureSystemLinkExecReportLine(report, "gate_blocker_detail= pure system_link_exec: run entry pending before PureSystemLinkExecRunFull")
    report = PureSystemLinkExecReportLine(report, "error= pure system_link_exec: run entry pending before PureSystemLinkExecRunFull")
    return chengpath.WriteTextFileWithHandleHostBridge("", reportPath, report)

fn PureSystemLinkExecPlanReady(plan: var sexec.SystemLinkExecPlan): bool =
    return plan.readyCode == 1

@borrows
fn PureSystemLinkExecValidateMaterialized(rootDir: str,
                                           req: creq.CompilerRequest): Result[bool] =
    if !chengpath.PathFileNonEmpty(req.outputPath):
        let sizeDiag = chengpath.PathFileSizeDiagnostic(req.outputPath)
        var outputErr = Fmt" pure system_link_exec: output missing after runtime execute: {req.outputPath}\n{sizeDiag}"
        return PureSystemLinkExecBoolErr(outputErr)
    if req.emitKind == creq.EmitExe:
        let mapPath = Fmt"{req.outputPath}.map"
        if !chengpath.FileExistsNonEmpty(rootDir, mapPath):
            let mapErr = Fmt" pure system_link_exec: map missing after runtime execute: {mapPath}"
            return PureSystemLinkExecBoolErr(mapErr)
    return PureSystemLinkExecBoolOk(true)

@borrows
fn PureSystemLinkExecFixedOrdinaryReportPath(rootDir: str): str =
    let raw = PureSystemLinkExecStripBridge(PureSystemLinkExecGetEnv("CHENG_PURE_FIXED_PROBE_REPORT"))
    if len(raw) > 0:
        return PureSystemLinkExecRootedPath(rootDir, raw)
    return chengpath.PathJoin(rootDir, ".tmp-exec/normalize_plan_probe/pure_fixed.report.txt")

@borrows
fn PureSystemLinkExecFixedOrdinaryOutputPath(rootDir: str): str =
    let raw = PureSystemLinkExecStripBridge(PureSystemLinkExecGetEnv("CHENG_PURE_FIXED_PROBE_OUT"))
    if len(raw) > 0:
        return PureSystemLinkExecRootedPath(rootDir, raw)
    return chengpath.PathJoin(rootDir, ".tmp-exec/normalize_plan_probe/pure_fixed.o")

@borrows
fn PureSystemLinkExecFixedOrdinaryRequest(rootDir: str): creq.CompilerRequest =
    let sourcePath = chengpath.PathJoin(rootDir, "src/tests/ordinary_zero_exit_fixture.cheng")
    let outputPath = PureSystemLinkExecFixedOrdinaryOutputPath(rootDir)
    let reportPath = PureSystemLinkExecFixedOrdinaryReportPath(rootDir)
    let req = creq.CompilerRequestNew(strings.CloneStr(rootDir),
                                      sourcePath,
                                      outputPath,
                                      "arm64-apple-darwin",
                                      creq.CompilerEmitObjValue(),
                                      reportPath)
    return req

@borrows
fn PureSystemLinkExecRunFixedOrdinaryProbe(rootDir: str): int32 =
    PureSystemLinkExecProgressEmit(rootDir, "fixed_probe", "begin")
    let probeDir = chengpath.PathJoin(rootDir, ".tmp-exec/normalize_plan_probe")
    if !chengpath.MkdirP(rootDir, probeDir):
        PureSystemLinkExecPrintErr(Fmt" pure system_link_exec fixed probe: failed to create dir: {probeDir}")
        return 2
    var req = PureSystemLinkExecFixedOrdinaryRequest(rootDir)
    let _materializedReport = PureSystemLinkExecWriteStageBlockerReport(rootDir,
                                                                        req.reportPath,
                                                                        "pure_runtime_system_link_exec_fixed_probe_before_normalize",
                                                                        "selfhost_fixed_probe_request_materialized",
                                                                        true,
                                                                        false,
                                                                        req.sourcePath,
                                                                        req.outputPath,
                                                                        "")
    PureSystemLinkExecNormalizeRequestInPlace(rootDir, req)
    if !creq.CompilerRequestStrictValidateSealed(req):
        PureSystemLinkExecPrintErr(
            " pure system_link_exec fixed probe: normalized request is not sealed")
        return 2
    let _normalizedReport = PureSystemLinkExecWriteStageBlockerReport(rootDir,
                                                                      req.reportPath,
                                                                      "pure_runtime_system_link_exec_fixed_probe_before_plan_build",
                                                                      "selfhost_fixed_probe_plan_build",
                                                                      true,
                                                                      true,
                                                                      req.sourcePath,
                                                                      req.outputPath,
                                                                      "")
    PureSystemLinkExecProgressEmit(rootDir, "fixed_probe_plan_build", "begin")
    var plan: sexec.SystemLinkExecPlan
    var planErr: str
    let planOk: bool = sexec.BuildSystemLinkExecPlanWithWorldAndChannelInto(rootDir,
                                                                            req,
                                                                            "",
                                                                            "",
                                                                            "",
                                                                            "stable",
                                                                            plan,
                                                                            planErr)
    PureSystemLinkExecProgressEmit(rootDir, "fixed_probe_plan_build", "done")
    if !planOk:
        let reason: str = planErr
        let _ = PureSystemLinkExecWriteStageBlockerReport(rootDir,
                                                          req.reportPath,
                                                          "pure_runtime_system_link_exec_fixed_probe_plan_build_call_error",
                                                          "selfhost_fixed_probe_plan_build_call",
                                                          true,
                                                          true,
                                                          req.sourcePath,
                                                          req.outputPath,
                                                          reason)
        PureSystemLinkExecPrintErr(reason)
        return 2
    if plan.readyCode != 1:
        let reason: str = " pure system_link_exec fixed probe: plan not ready"
        let _ = PureSystemLinkExecWriteErrorReport(rootDir,
                                                    req.reportPath,
                                                    plan,
                                                    "pure_runtime_system_link_exec_fixed_probe_plan_not_ready",
                                                    "selfhost_fixed_probe_plan_ready",
                                                    reason)
        PureSystemLinkExecPrintErr(reason)
        sexecrt.SystemLinkExecRuntimeDiscardPreparedPlan(
            plan,
            reason)
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "fixed_probe_runtime_execute", "begin")
    var execResult: sexecrt.SystemLinkExecRuntimeResult
    var execErr: str
    let execOk: bool =
        sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
            execResult,
            execErr,
            rootDir,
            plan,
            PureSystemLinkExecCurrentExecutablePath(rootDir))
    PureSystemLinkExecProgressEmit(rootDir, "fixed_probe_runtime_execute", "done")
    if !execOk:
        let reason: str = execErr
        let _ = PureSystemLinkExecWriteErrorReport(rootDir,
                                                    req.reportPath,
                                                    plan,
                                                    "pure_runtime_system_link_exec_fixed_probe_runtime_execute_failed",
                                                    "selfhost_fixed_probe_runtime_execute",
                                                    reason)
        PureSystemLinkExecPrintErr(reason)
        return 2
    let validRes: Result[bool] = PureSystemLinkExecValidateMaterialized(rootDir, req)
    if !validRes.ok:
        let reason: str = validRes.err.msg
        let _ = PureSystemLinkExecWriteErrorReport(rootDir,
                                                    req.reportPath,
                                                    plan,
                                                    "pure_runtime_system_link_exec_fixed_probe_materialization_invalid",
                                                    "selfhost_fixed_probe_validate_materialized",
                                                    reason)
        PureSystemLinkExecPrintErr(reason)
        return 2
    let runtimeReport: str = sexecrt.SystemLinkExecRuntimeResultReport(execResult)
    if !PureSystemLinkExecWriteReport(rootDir, req.reportPath, plan, runtimeReport):
        PureSystemLinkExecPrintErr(Fmt" pure system_link_exec fixed probe: failed to write report: {req.reportPath}")
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "fixed_probe", "done")
    return 0

fn PureSystemLinkExecRun(rootDir: str): int32 =
    var reportRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--report-out", "", reportRaw)
    let reportPath = PureSystemLinkExecRootedPath(rootDir, reportRaw)
    var sourceRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--in", "", sourceRaw)
    let sourcePath = sourceRaw
    var outputRaw: str
    PureSystemLinkExecReadCmdFlagOrDefaultInto("--out", "", outputRaw)
    let outputPath = outputRaw
    var reason = " pure system_link_exec: request parse blocked after required flags"
    if len(sourcePath) <= 0:
        reason = " pure system_link_exec: missing --in"
    elif len(outputPath) <= 0:
        reason = " pure system_link_exec: missing --out"
    let _stageReport = PureSystemLinkExecWriteStageBlockerReport(rootDir,
                                                                 reportPath,
                                                                 "pure_runtime_system_link_exec_optional_defaults_crash_after_required_flags",
                                                                 "selfhost_request_parse_required_flags_materialized",
                                                                 false,
                                                                 false,
                                                                 sourcePath,
                                                                 outputPath,
                                                                 reason)
    PureSystemLinkExecPrintErr(reason)
    return 2

fn PureSystemLinkExecRunFull(rootDir: str): int32 =
    PureSystemLinkExecProgressEmit(rootDir, "run", "begin")
    PureSystemLinkExecProgressEmit(rootDir, "request_parse", "begin")
    var parsedReq: creq.CompilerRequest
    var parseErr: str
    if !PureSystemLinkExecParseRequestInto(rootDir, parsedReq, parseErr):
        var reason = parseErr
        if len(reason) <= 0:
            reason = " pure system_link_exec: request parse failed"
        if len(parsedReq.reportPath) <= 0:
            let _ = PureSystemLinkExecWriteParseErrorReport(rootDir, reason)
        PureSystemLinkExecPrintErr(reason)
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "request_parse", "done")
    if len(parsedReq.reportPath) <= 0:
        let fallbackReportPath = PureSystemLinkExecArgReportPath(rootDir)
        var fallbackReq = creq.CompilerRequestNew(strings.CloneStr(parsedReq.rootDir),
                                                  strings.CloneStr(parsedReq.sourcePath),
                                                  strings.CloneStr(parsedReq.outputPath),
                                                  strings.CloneStr(parsedReq.targetTriple),
                                                  parsedReq.emitKind,
                                                  fallbackReportPath)
        fallbackReq = creq.CompilerRequestWithSymbolVisibility(
            fallbackReq,
            strings.CloneStr(parsedReq.symbolVisibility))
        fallbackReq = creq.CompilerRequestWithBrowserBridgeObject(
            fallbackReq,
            strings.CloneStr(parsedReq.browserBridgeObjectPath))
        fallbackReq = creq.CompilerRequestWithExportRootSymbols(
            fallbackReq,
            PureSystemLinkExecCloneStrSeq(parsedReq.exportRootSymbols))
        fallbackReq = creq.CompilerRequestWithProviderObjectPaths(
            fallbackReq,
            PureSystemLinkExecCloneStrSeq(parsedReq.providerObjectPaths))
        fallbackReq = creq.CompilerRequestWithRuntimeProviderBundle(
            fallbackReq,
            strings.CloneStr(parsedReq.runtimeProviderBundle))
        fallbackReq = creq.CompilerRequestWithMode(
            fallbackReq,
            strings.CloneStr(parsedReq.compileMode))
        parsedReq = fallbackReq

    PureSystemLinkExecProgressEmit(rootDir, "request_normalize", "begin")
    PureSystemLinkExecNormalizeRequestInPlace(rootDir, parsedReq)
    PureSystemLinkExecProgressEmit(rootDir, "request_normalize", "done")
    if !creq.CompilerRequestStrictValidateSealed(parsedReq):
        PureSystemLinkExecPrintErr(
            " pure system_link_exec: normalized request is not sealed")
        return 2

    PureSystemLinkExecProgressEmit(rootDir, "plan_build_call", "begin")
    var worldHead: str
    if PureSystemLinkExecFlagCodeHasValue(13):
        PureSystemLinkExecReadCmdFlagOrDefaultInto("--world-head", "", worldHead)
    else:
        worldHead = ""
    var lockPath: str
    if PureSystemLinkExecFlagCodeHasValue(14):
        PureSystemLinkExecReadCmdFlagOrDefaultInto("--lock", "", lockPath)
    else:
        lockPath = ""
    var baselineSurfacePath: str
    if PureSystemLinkExecFlagCodeHasValue(15):
        PureSystemLinkExecReadCmdFlagOrDefaultInto("--baseline-surface", "", baselineSurfacePath)
    else:
        baselineSurfacePath = ""
    var channel: str
    if PureSystemLinkExecFlagCodeHasValue(16):
        PureSystemLinkExecReadCmdFlagOrDefaultInto("--channel", "", channel)
    var plan: sexec.SystemLinkExecPlan
    var planErr: str
    let rssPlanBuildBeginBytes = PureSystemLinkExecRssBytesText()
    let planOk: bool = sexec.BuildSystemLinkExecPlanWithWorldAndChannelInto(rootDir,
                                                                            parsedReq,
                                                                            worldHead,
                                                                            lockPath,
                                                                            baselineSurfacePath,
                                                                            channel,
                                                                            plan,
                                                                            planErr)
    let rssPlanBuildDoneBytes = PureSystemLinkExecRssBytesText()
    PureSystemLinkExecProgressEmit(rootDir, "plan_build_call", "done")
    if !planOk:
        let reason: str = planErr
        let _ = PureSystemLinkExecWriteStageBlockerReport(rootDir,
                                                          parsedReq.reportPath,
                                                          "pure_runtime_system_link_exec_plan_build_call_error",
                                                          "selfhost_plan_build_call",
                                                          true,
                                                          true,
                                                          parsedReq.sourcePath,
                                                          parsedReq.outputPath,
                                                          reason)
        PureSystemLinkExecPrintErr(reason)
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "plan_value", "begin")
    PureSystemLinkExecProgressEmit(rootDir, "plan_value", "done")
    PureSystemLinkExecProgressEmit(rootDir, "plan_ready", "begin")
    if !sexecrt.SystemLinkExecRuntimeCanExecutePlan(plan):
        var reason = " pure system_link_exec: plan not ready"
        PureSystemLinkExecPrintErr(" pure system_link_exec: plan not ready; see report for counters")
        PureSystemLinkExecPrintErr(" pure system_link_exec: primary error detail available in report")
        PureSystemLinkExecPrintErr(" pure system_link_exec: primary bodyir detail available in report")
        PureSystemLinkExecPrintErr(" pure system_link_exec: primary bodyir zero detail available in report")
        PureSystemLinkExecPrintErr(" pure system_link_exec: primary param_trace available in report")
        PureSystemLinkExecPrintErr(" pure system_link_exec: primary statement_trace available in report")
        let _ = PureSystemLinkExecWriteErrorReport(rootDir,
                                                    parsedReq.reportPath,
                                                    plan,
                                                    "pure_runtime_system_link_exec_plan_not_ready",
                                                    "selfhost_plan_ready",
                                                    reason)
        PureSystemLinkExecPrintErr(reason)
        sexecrt.SystemLinkExecRuntimeDiscardPreparedPlan(
            plan,
            reason)
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "plan_ready", "done")
    PureSystemLinkExecProgressEmit(rootDir, "browser_bridge_check", "begin")
    if len(plan.objectPlan.browserBridgeObjectPath) > 0:
        let reason: str = " pure system_link_exec: browser bridge object not yet supported"
        let _ = PureSystemLinkExecWriteErrorReport(rootDir,
                                                    parsedReq.reportPath,
                                                    plan,
                                                    "pure_runtime_system_link_exec_browser_bridge_object_unsupported",
                                                    "selfhost_browser_bridge_check",
                                                    reason)
        PureSystemLinkExecPrintErr(reason)
        sexecrt.SystemLinkExecRuntimeDiscardPreparedPlan(
            plan,
            reason)
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "browser_bridge_check", "done")
    PureSystemLinkExecProgressEmit(rootDir, "current_executable", "begin")
    PureSystemLinkExecProgressEmit(rootDir, "current_executable", "done")
    PureSystemLinkExecProgressEmit(rootDir, "runtime_execute_call", "begin")
    var execResult: sexecrt.SystemLinkExecRuntimeResult
    var execErr: str
    let rssRuntimeExecuteBeginBytes = PureSystemLinkExecRssBytesText()
    let execOk: bool =
        sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
            execResult,
            execErr,
            rootDir,
            plan,
            "")
    let rssRuntimeExecuteDoneBytes = PureSystemLinkExecRssBytesText()
    PureSystemLinkExecProgressEmit(rootDir, "runtime_execute_call", "done")
    if !execOk:
        let reason: str = execErr
        let _ = PureSystemLinkExecWriteErrorReport(rootDir,
                                                    parsedReq.reportPath,
                                                    plan,
                                                    "pure_runtime_system_link_exec_runtime_execute_failed",
                                                    "selfhost_runtime_execute",
                                                    reason)
        PureSystemLinkExecPrintErr(reason)
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "validate_materialized", "begin")
    let validRes: Result[bool] = PureSystemLinkExecValidateMaterialized(rootDir, parsedReq)
    if !validRes.ok:
        let reason: str = validRes.err.msg
        let _ = PureSystemLinkExecWriteErrorReport(rootDir,
                                                    parsedReq.reportPath,
                                                    plan,
                                                    "pure_runtime_system_link_exec_runtime_materialization_invalid",
                                                    "selfhost_validate_materialized",
                                                    reason)
        PureSystemLinkExecPrintErr(reason)
        return 2
    PureSystemLinkExecProgressEmit(rootDir, "validate_materialized", "done")
    PureSystemLinkExecProgressEmit(rootDir, "write_report", "begin")
    var pureRssReport = ""
    pureRssReport = PureSystemLinkExecReportField(pureRssReport, "pure_rss_plan_build_begin_bytes", rssPlanBuildBeginBytes)
    pureRssReport = PureSystemLinkExecReportField(pureRssReport, "pure_rss_plan_build_done_bytes", rssPlanBuildDoneBytes)
    pureRssReport = PureSystemLinkExecReportField(pureRssReport, "pure_rss_runtime_execute_begin_bytes", rssRuntimeExecuteBeginBytes)
    pureRssReport = PureSystemLinkExecReportField(pureRssReport, "pure_rss_runtime_execute_done_bytes", rssRuntimeExecuteDoneBytes)
    let runtimeReport: str = PureSystemLinkExecReportText(pureRssReport, sexecrt.SystemLinkExecRuntimeResultReport(execResult))
    if !PureSystemLinkExecWriteReport(rootDir, parsedReq.reportPath, plan, runtimeReport):
        PureSystemLinkExecPrintErr(
            Fmt" pure system_link_exec: failed to write report: {parsedReq.reportPath}")
        return 2
    if len(parsedReq.reportPath) > 0:
        if !chengpath.FileExistsNonEmpty(rootDir, parsedReq.reportPath):
            PureSystemLinkExecPrintErr(
                Fmt" pure system_link_exec: report missing after runtime execute: {parsedReq.reportPath}")
            return 2
    PureSystemLinkExecProgressEmit(rootDir, "write_report", "done")
    PureSystemLinkExecProgressEmit(rootDir, "run", "done")
    return 0

fn PureSystemLinkExecStatus(rootDir: str) =
    PureSystemLinkExecPrintLine("cheng")
    PureSystemLinkExecPrintLine("execution=argv_control_plane")
    PureSystemLinkExecPrintLine("compiler_entry=src/core/tooling/system_link_exec_pure_main.cheng")
    PureSystemLinkExecPrintLine("ordinary_command=system_link_exec")
    PureSystemLinkExecPrintLine("system_link_exec_scope=selfhost_runtime_execute")

fn PureSystemLinkExecSelfCheck(rootDir: str): int32 =
    PureSystemLinkExecStatus(rootDir)
    PureSystemLinkExecPrintLine("self_check=ok")
    return 0

fn main(argc: int32, argv: ptr): int32 =
    PureSystemLinkExecPrintErr("pure_main_entry")
    cmdline.CaptureCmdLine(argc, argv)
    let rootDir = PureSystemLinkExecRoot()
    PureSystemLinkExecEnsureRootEnv(rootDir)
    PureSystemLinkExecProgressPrepare(rootDir)
    let count = cmdline.ParamCount()
    if count <= 1:
        PureSystemLinkExecUsage(rootDir)
        return 0
    let cmd = cmdline.ParamStr(1)
    if cmd == "help":
        PureSystemLinkExecUsage(rootDir)
        return 0
    if cmd == "--help":
        PureSystemLinkExecUsage(rootDir)
        return 0
    if cmd == "-h":
        PureSystemLinkExecUsage(rootDir)
        return 0
    if cmd == "status":
        PureSystemLinkExecStatus(rootDir)
        return 0
    if cmd == "self-check":
        return PureSystemLinkExecSelfCheck(rootDir)
    if cmd == "system-link-exec":
        # The argv-driven production path (PureSystemLinkExecRunFull) is
        # retired: production execution only exists behind a live held-exec
        # admission delivered by the launcher parent.  No admission -> HARD_RED
        # before any source is touched; an admitted child entry is not wired
        # for this binary, so that shape is HARD_RED too (fail-closed, never
        # fake-green).
        let heldImport = system.RuntimeHeldExecChildImport()
        if heldImport < 0:
            PureSystemLinkExecPrintErr("HARD_RED:production_held_exec_ticket_import_failed")
            return 2
        if heldImport != 1:
            PureSystemLinkExecPrintErr("HARD_RED:production_held_exec_launcher_required")
            return 2
        PureSystemLinkExecPrintErr("HARD_RED:pure_system_link_exec_not_production_entry")
        return 2
    if cmd == "probe-fixed-ordinary":
        return PureSystemLinkExecRunFixedOrdinaryProbe(rootDir)
    PureSystemLinkExecPrintErr(" pure system_link_exec: unsupported command")
    return 2
