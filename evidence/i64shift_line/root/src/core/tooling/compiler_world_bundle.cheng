import std/result
import std/os
import std/monotimes
import std/rawbytes
import std/strings
import std/crypto/sha256 as hash256
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_world_libp2p as cwlp
import cheng/core/backend/system_link_exec as sexec
import cheng/core/lang/parser
import std/strutils as strutil

type
    CompilerWorldBundle =
        bundlePrefix: str
        worldHead: cworld.CompilerWorldHead
        manifest: cworld.CompilerUniverseManifest
        compilerSnapshot: cworld.CompilerPackageSnapshot
        stdSnapshot: cworld.CompilerPackageSnapshot
        runtimeSnapshot: cworld.CompilerPackageSnapshot
        compilerCsgCid: layout.FixedBytes32
        compilerCanonicalCsgCid: layout.FixedBytes32
        exportSurface: ccsg.CsgExportSurface
        sourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
        semanticReceipt: sexec.CompileSemanticReceipt
        receipt: ccsg.CompileReceipt
        evidence: ceq.CompilerMigrationEvidence
        proof: ceq.CompilerMigrationSemanticProof
        compilerMirrorBundle: cwlp.CompilerManagedMirrorBundle
        managedDependencyReceipt: cwlp.CompilerManagedDependencyReceipt
        managedMirrorBundles: cwlp.CompilerManagedMirrorBundle[]
        lock: cworld.CompilerLockSnapshot
        envelopeCid: layout.FixedBytes32

    CompilerWorldBundleAtomicTextFile =
        relativePath: str
        text: str

@borrows
fn CompilerWorldBundleInstalledOutputPrefix(rootDir: str,
                                              prefixRaw: str): str =
    let requestedPrefix = chengpath.PathAbsolute(rootDir, prefixRaw)
    return os.JoinPath(strutil.Join([
        requestedPrefix,
        ".world_bundle"
    ], ""), "output")

@borrows
fn CompilerWorldBundleUniverse(bundle: CompilerWorldBundle): cworld.CompilerLocalUniverse =
    var out: cworld.CompilerLocalUniverse
    out.compilerSnapshot = cworld.CompilerWorldOwnPackageSnapshot(
        bundle.compilerSnapshot)
    out.stdSnapshot = cworld.CompilerWorldOwnPackageSnapshot(
        bundle.stdSnapshot)
    out.runtimeSnapshot = cworld.CompilerWorldOwnPackageSnapshot(
        bundle.runtimeSnapshot)
    out.manifest = cworld.CompilerWorldOwnUniverseManifest(
        bundle.manifest)
    out.worldHead = cworld.CompilerWorldOwnWorldHead(bundle.worldHead)
    return out

@borrows
fn CompilerWorldBundleAtomicReadText(
        handle: os.AtomicTree,
        relativePath: str,
        label: str): Result[str] =
    let bytesRes = os.AtomicTreeReadStable(handle, relativePath)
    if IsErr(bytesRes):
        return Err[str](strutil.Join([
            " compiler world bundle: verified read failed for ",
            strings.CloneStr(label),
            ": ",
            Error(bytesRes)
        ], ""))
    var bytes = Value(bytesRes)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return Ok[str](out)

fn CompilerWorldBundlePortableSourceIdentityReceiptReport(
        receipt: ccsg.PortableSourceIdentityReceipt): str =
    var err = ""
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(receipt, err):
        panic(err)
    var out = ""
    out = strutil.Join([out, "source_snapshot_count=",
                        IntToStr(receipt.sourceSnapshotCount), "\n"], "")
    out = strutil.Join([out, "import_edge_count=",
                        IntToStr(receipt.importEdgeCount), "\n"], "")
    out = strutil.Join([out, "unresolved_import_count=",
                        IntToStr(receipt.unresolvedImportCount), "\n"], "")
    out = strutil.Join([out, "source_package_id_cid=",
                        layout.FixedBytes32Hex(receipt.sourcePackageIdCid),
                        "\n"], "")
    out = strutil.Join([out, "entry_module_path_cid=",
                        layout.FixedBytes32Hex(receipt.entryModulePathCid),
                        "\n"], "")
    out = strutil.Join([out, "source_bundle_cid=",
                        layout.FixedBytes32Hex(receipt.sourceBundleCid),
                        "\n"], "")
    out = strutil.Join([out, "entry_source_cid=",
                        layout.FixedBytes32Hex(receipt.entrySourceCid),
                        "\n"], "")
    out = strutil.Join([out, "import_graph_cid=",
                        layout.FixedBytes32Hex(receipt.importGraphCid),
                        "\n"], "")
    out = strutil.Join([out, "receipt_cid=",
                        layout.FixedBytes32Hex(receipt.receiptCid)], "")
    return out

@borrows
fn CompilerWorldBundleParseInt32Exact(text: str,
                                      key: str,
                                      out: var int32): bool =
    let raw = cworld.CompilerWorldLineValue(text, key)
    if raw == "":
        return false
    let value = int32(strutil.ParseInt(raw))
    if IntToStr(value) != raw:
        return false
    out = value
    return true

@borrows
fn CompilerWorldBundlePortableSourceIdentityReceiptFromReportText(
        text: str,
        out: var ccsg.PortableSourceIdentityReceipt): Result[bool] =
    var snapshotCount: int32
    var importEdgeCount: int32
    var unresolvedImportCount: int32
    if !CompilerWorldBundleParseInt32Exact(text,
                                           "source_snapshot_count",
                                           snapshotCount) ||
       !CompilerWorldBundleParseInt32Exact(text,
                                           "import_edge_count",
                                           importEdgeCount) ||
       !CompilerWorldBundleParseInt32Exact(text,
                                           "unresolved_import_count",
                                           unresolvedImportCount):
        return Err[bool](
            " compiler world bundle: invalid portable source receipt count")
    let packageRes = cworld.CompilerWorldFixed32Value(
        text,
        "source_package_id_cid")
    let entryModuleRes = cworld.CompilerWorldFixed32Value(
        text,
        "entry_module_path_cid")
    let sourceBundleRes = cworld.CompilerWorldFixed32Value(
        text,
        "source_bundle_cid")
    let entrySourceRes = cworld.CompilerWorldFixed32Value(
        text,
        "entry_source_cid")
    let importGraphRes = cworld.CompilerWorldFixed32Value(
        text,
        "import_graph_cid")
    let receiptRes = cworld.CompilerWorldFixed32Value(text, "receipt_cid")
    if IsErr(packageRes) || IsErr(entryModuleRes) || IsErr(sourceBundleRes) ||
       IsErr(entrySourceRes) || IsErr(importGraphRes) || IsErr(receiptRes):
        return Err[bool](
            " compiler world bundle: invalid portable source receipt cid")
    var next: ccsg.PortableSourceIdentityReceipt
    next.sourceSnapshotCount = snapshotCount
    next.importEdgeCount = importEdgeCount
    next.unresolvedImportCount = unresolvedImportCount
    next.sourcePackageIdCid = Value(packageRes)
    next.entryModulePathCid = Value(entryModuleRes)
    next.sourceBundleCid = Value(sourceBundleRes)
    next.entrySourceCid = Value(entrySourceRes)
    next.importGraphCid = Value(importGraphRes)
    next.receiptCid = Value(receiptRes)
    var err = ""
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(next, err):
        return Err[bool](err)
    if text != CompilerWorldBundlePortableSourceIdentityReceiptReport(next):
        return Err[bool](
            " compiler world bundle: portable source receipt is not exact canonical")
    out = next
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleEnvelopeCid(
        bundle: CompilerWorldBundle): layout.FixedBytes32 =
    var parts: str[]
    add(parts, layout.FixedBytes32Hex(bundle.worldHead.headCid))
    add(parts, layout.FixedBytes32Hex(bundle.manifest.manifestCid))
    add(parts, layout.FixedBytes32Hex(bundle.compilerSnapshot.snapshotCid))
    add(parts, layout.FixedBytes32Hex(bundle.stdSnapshot.snapshotCid))
    add(parts, layout.FixedBytes32Hex(bundle.runtimeSnapshot.snapshotCid))
    add(parts, layout.FixedBytes32Hex(bundle.compilerCanonicalCsgCid))
    add(parts, layout.FixedBytes32Hex(bundle.exportSurface.surfaceCid))
    add(parts, layout.FixedBytes32Hex(bundle.sourceIdentityReceipt.receiptCid))
    add(parts, layout.FixedBytes32Hex(bundle.semanticReceipt.receiptCid))
    add(parts, layout.FixedBytes32Hex(bundle.receipt.receiptCid))
    add(parts, layout.FixedBytes32Hex(bundle.receipt.outputDigest))
    add(parts, layout.FixedBytes32Hex(bundle.evidence.evidenceCid))
    add(parts, layout.FixedBytes32Hex(bundle.proof.proofCid))
    add(parts, layout.FixedBytes32Hex(bundle.compilerMirrorBundle.bundleCid))
    add(parts, layout.FixedBytes32Hex(
        bundle.manifest.managedDependencyReceiptCid))
    add(parts, layout.FixedBytes32Hex(
        bundle.managedDependencyReceipt.receiptCid))
    add(parts, IntToStr(bundle.managedMirrorBundles.len))
    for i in 0..<bundle.managedMirrorBundles.len:
        add(parts,
            layout.FixedBytes32Hex(bundle.managedMirrorBundles[i].bundleCid))
    return cworld.CompilerWorldHashText(
        "cheng.compiler.world_bundle_envelope",
        parts)

@borrows
fn CompilerWorldBundleEnvelopeReport(bundle: CompilerWorldBundle): str =
    var out = ""
    out = strutil.Join([out, "world_head_cid=",
                        layout.FixedBytes32Hex(bundle.worldHead.headCid),
                        "\n"], "")
    out = strutil.Join([out, "manifest_cid=",
                        layout.FixedBytes32Hex(bundle.manifest.manifestCid),
                        "\n"], "")
    out = strutil.Join([out, "compiler_snapshot_cid=",
                        layout.FixedBytes32Hex(bundle.compilerSnapshot.snapshotCid),
                        "\n"], "")
    out = strutil.Join([out, "std_snapshot_cid=",
                        layout.FixedBytes32Hex(bundle.stdSnapshot.snapshotCid),
                        "\n"], "")
    out = strutil.Join([out, "runtime_snapshot_cid=",
                        layout.FixedBytes32Hex(bundle.runtimeSnapshot.snapshotCid),
                        "\n"], "")
    out = strutil.Join([out, "canonical_csg_cid=",
                        layout.FixedBytes32Hex(bundle.compilerCanonicalCsgCid),
                        "\n"], "")
    out = strutil.Join([out, "surface_cid=",
                        layout.FixedBytes32Hex(bundle.exportSurface.surfaceCid),
                        "\n"], "")
    out = strutil.Join([out, "source_identity_receipt_cid=",
                        layout.FixedBytes32Hex(
                            bundle.sourceIdentityReceipt.receiptCid),
                        "\n"], "")
    out = strutil.Join([out, "semantic_receipt_cid=",
                        layout.FixedBytes32Hex(bundle.semanticReceipt.receiptCid),
                        "\n"], "")
    out = strutil.Join([out, "compile_receipt_cid=",
                        layout.FixedBytes32Hex(bundle.receipt.receiptCid),
                        "\n"], "")
    out = strutil.Join([out, "output_sha256=",
                        layout.FixedBytes32Hex(bundle.receipt.outputDigest),
                        "\n"], "")
    out = strutil.Join([out, "evidence_cid=",
                        layout.FixedBytes32Hex(bundle.evidence.evidenceCid),
                        "\n"], "")
    out = strutil.Join([out, "proof_cid=",
                        layout.FixedBytes32Hex(bundle.proof.proofCid),
                        "\n"], "")
    out = strutil.Join([out, "compiler_mirror_bundle_cid=",
                        layout.FixedBytes32Hex(
                            bundle.compilerMirrorBundle.bundleCid),
                        "\n"], "")
    out = strutil.Join([out, "managed_dependency_receipt_cid=",
                        layout.FixedBytes32Hex(
                            bundle.manifest.managedDependencyReceiptCid),
                        "\n"], "")
    out = strutil.Join([out, "managed_dependency_payload_receipt_cid=",
                        layout.FixedBytes32Hex(
                            bundle.managedDependencyReceipt.receiptCid),
                        "\n"], "")
    out = strutil.Join([out, "managed_mirror_count=",
                        IntToStr(bundle.managedMirrorBundles.len), "\n"], "")
    for i in 0..<bundle.managedMirrorBundles.len:
        out = strutil.Join([out, "managed_mirror[", IntToStr(i),
                            "].bundle_cid=",
                            layout.FixedBytes32Hex(
                                bundle.managedMirrorBundles[i].bundleCid),
                            "\n"], "")
    out = strutil.Join([out, "envelope_cid=",
                        layout.FixedBytes32Hex(bundle.envelopeCid)], "")
    return out

@borrows
fn CompilerWorldBundleTextLess(left: str, right: str): bool =
    if left == right:
        return false
    let sharedLen = left.len < right.len ? left.len : right.len
    for index in 0..<sharedLen:
        if left[index] == right[index]:
            continue
        return left[index] < right[index]
    return left.len < right.len

@borrows
fn CompilerWorldBundleAtomicTextFileAdd(
        files: var CompilerWorldBundleAtomicTextFile[],
        relativePath: str,
        text: str): Result[bool] =
    var canonicalPath: str
    if !parser.ParserSourceIdentityLexicalPathInto(relativePath,
                                                   canonicalPath) ||
       canonicalPath != relativePath ||
       parser.ParserSourceIdentityPathAbsolute(relativePath) ||
       strutil.Contains(relativePath, "\\"):
        return Err[bool](
            " compiler world bundle: atomic file path is not canonical relative")
    var insertAt = files.len
    while insertAt > 0 && CompilerWorldBundleTextLess(
            relativePath,
            files[insertAt - 1].relativePath):
        insertAt = insertAt - 1
    if (insertAt > 0 &&
        files[insertAt - 1].relativePath == relativePath) ||
       (insertAt < files.len &&
        files[insertAt].relativePath == relativePath):
        return Err[bool](
            " compiler world bundle: duplicate atomic file path")
    var growFile: CompilerWorldBundleAtomicTextFile
    growFile.relativePath = strings.CloneStr(relativePath)
    growFile.text = strings.CloneStr(text)
    var insertFile: CompilerWorldBundleAtomicTextFile
    insertFile.relativePath = strings.CloneStr(relativePath)
    insertFile.text = strings.CloneStr(text)
    add(files, growFile)
    var cursor = files.len - 1
    while cursor > insertAt:
        files[cursor] = files[cursor - 1]
        cursor = cursor - 1
    files[insertAt] = insertFile
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleOwnedBytesFromText(text: str): Bytes =
    var out = rawbytes.BytesAlloc(text.len)
    for index in 0..<text.len:
        rawbytes.BytesSet(out, index, int32(text[index]) & 255)
    return out

@borrows
fn CompilerWorldBundleTextRawSha256(text: str): layout.FixedBytes32 =
    var bytes = CompilerWorldBundleOwnedBytesFromText(text)
    let digest = hash256.Sha256Fixed(layout.ByteSpanFromBytes(bytes))
    rawbytes.BytesFree(bytes)
    return digest

@borrows
fn CompilerWorldBundleAtomicFiles(
        bundle: CompilerWorldBundle,
        compilerCsgText: str,
        out: var CompilerWorldBundleAtomicTextFile[]): Result[bool] =
    var files: CompilerWorldBundleAtomicTextFile[]
    let fixedPaths = [
        "output.compiler.snapshot.txt",
        "output.compiler_mirror.txt",
        "output.csg.txt",
        "output.envelope.txt",
        "output.evidence.txt",
        "output.lock.toml",
        "output.manifest.txt",
        "output.proof.txt",
        "output.receipt.txt",
        "output.runtime.snapshot.txt",
        "output.semantic.receipt.txt",
        "output.source_identity.receipt.txt",
        "output.std.snapshot.txt",
        "output.surface.txt",
        "output.world.txt"
    ]
    let fixedTexts = [
        cworld.CompilerPackageSnapshotReport(bundle.compilerSnapshot),
        cwlp.CompilerWorldManagedMirrorBundleReport(
            bundle.compilerMirrorBundle),
        strings.CloneStr(compilerCsgText),
        CompilerWorldBundleEnvelopeReport(bundle),
        ceq.CompilerMigrationEvidenceReport(bundle.evidence),
        cworld.CompilerLockSnapshotText(bundle.lock),
        cworld.CompilerUniverseManifestReport(bundle.manifest),
        ceq.CompilerMigrationSemanticProofReport(bundle.proof),
        ccsg.CompileReceiptReport(bundle.receipt),
        cworld.CompilerPackageSnapshotReport(bundle.runtimeSnapshot),
        sexec.SystemLinkExecCompileSemanticReceiptReport(
            bundle.semanticReceipt),
        CompilerWorldBundlePortableSourceIdentityReceiptReport(
            bundle.sourceIdentityReceipt),
        cworld.CompilerPackageSnapshotReport(bundle.stdSnapshot),
        ccsg.CompilerExportSurfaceReport(bundle.exportSurface),
        cworld.CompilerWorldHeadReport(bundle.worldHead)
    ]
    for index in 0..<fixedPaths.len:
        let addRes = CompilerWorldBundleAtomicTextFileAdd(
            files,
            fixedPaths[index],
            fixedTexts[index])
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    let packageManifestRes = CompilerWorldBundleAtomicTextFileAdd(
        files,
        "source/cheng-package.toml",
        cwlp.CompilerWorldMirrorPackageManifestText(
            bundle.compilerMirrorBundle.packageId))
    if IsErr(packageManifestRes):
        return Err[bool](Error(packageManifestRes))
    var sourceList = ""
    for sourceIndex in 0..<bundle.compilerMirrorBundle.units.len:
        var sourceRelativePath: str
        let sourcePathRes =
            cwlp.CompilerWorldManagedMirrorSourceRelativePath(
                bundle.compilerMirrorBundle.packageId,
                bundle.compilerMirrorBundle.units[sourceIndex].modulePath,
                sourceRelativePath)
        if IsErr(sourcePathRes):
            return Err[bool](Error(sourcePathRes))
        sourceList = Fmt"{sourceList}{sourceRelativePath}\n"
        let sourceRes = CompilerWorldBundleAtomicTextFileAdd(
            files,
            strutil.Join(["source/", strings.CloneStr(sourceRelativePath)], ""),
            bundle.compilerMirrorBundle.units[sourceIndex].migratedSourceText)
        if IsErr(sourceRes):
            return Err[bool](Error(sourceRes))
    let sourceListRes = CompilerWorldBundleAtomicTextFileAdd(
        files,
        "source/sources.list.txt",
        sourceList)
    if IsErr(sourceListRes):
        return Err[bool](Error(sourceListRes))
    let entryRes = CompilerWorldBundleAtomicTextFileAdd(
        files,
        "source/entry.module.txt",
        bundle.evidence.entryModulePath)
    if IsErr(entryRes):
        return Err[bool](Error(entryRes))
    if bundle.managedDependencyReceipt.dependencyCount > 0:
        let receiptRes = CompilerWorldBundleAtomicTextFileAdd(
            files,
            "output.managed_dependency.receipt.txt",
            cwlp.CompilerWorldManagedDependencyReceiptReport(
                bundle.managedDependencyReceipt))
        if IsErr(receiptRes):
            return Err[bool](Error(receiptRes))
    if bundle.managedMirrorBundles.len > 0:
        var indexText = Fmt"count={IntToStr(bundle.managedMirrorBundles.len)}"
        for index in 0..<bundle.managedMirrorBundles.len:
            let bundlePath = Fmt"output.managed_mirror.{IntToStr(index)}.txt"
            indexText = Fmt"{indexText}\npackage[{IntToStr(index)}].package_id={bundle.managedMirrorBundles[index].packageId}\npackage[{IntToStr(index)}].migration_proof_cid={layout.FixedBytes32Hex(bundle.managedMirrorBundles[index].migrationProofCid)}\npackage[{IntToStr(index)}].bundle_cid={layout.FixedBytes32Hex(bundle.managedMirrorBundles[index].bundleCid)}\npackage[{IntToStr(index)}].bundle_path={bundlePath}"
            let mirrorRes = CompilerWorldBundleAtomicTextFileAdd(
                files,
                bundlePath,
                cwlp.CompilerWorldManagedMirrorBundleReport(
                    bundle.managedMirrorBundles[index]))
            if IsErr(mirrorRes):
                return Err[bool](Error(mirrorRes))
        let indexRes = CompilerWorldBundleAtomicTextFileAdd(
            files,
            "output.managed_mirror.index.txt",
            indexText)
        if IsErr(indexRes):
            return Err[bool](Error(indexRes))
    out = files
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleManifestEntry(manifest: cworld.CompilerUniverseManifest,
                                      packageId: str,
                                      outEntry: var cworld.CompilerUniverseManifestEntry): bool =
    for i in 0..<manifest.entries.len:
        if manifest.entries[i].packageId != packageId:
            continue
        outEntry = cworld.CompilerWorldOwnManifestEntry(
            manifest.entries[i])
        return true
    return false

@borrows
fn CompilerWorldBundleVerifyManifestBinding(manifest: cworld.CompilerUniverseManifest,
                                              snapshot: cworld.CompilerPackageSnapshot): Result[bool] =
    var entry: cworld.CompilerUniverseManifestEntry
    if !CompilerWorldBundleManifestEntry(manifest, snapshot.packageId, entry):
        return Err[bool](strutil.Join([
            " compiler world bundle: manifest missing package: ",
            strings.CloneStr(snapshot.packageId)
        ], ""))
    if !layout.FixedBytes32Equal(entry.snapshotCid, snapshot.snapshotCid):
        return Err[bool](strutil.Join([
            " compiler world bundle: manifest snapshot mismatch: ",
            strings.CloneStr(snapshot.packageId)
        ], ""))
    if !layout.FixedBytes32Equal(entry.syntaxSurfaceCid, snapshot.syntaxSurfaceCid):
        return Err[bool](strutil.Join([
            " compiler world bundle: manifest syntax mismatch: ",
            strings.CloneStr(snapshot.packageId)
        ], ""))
    if !layout.FixedBytes32Equal(entry.migrationProofCid, snapshot.migrationProofCid):
        return Err[bool](strutil.Join([
            " compiler world bundle: manifest proof mismatch: ",
            strings.CloneStr(snapshot.packageId)
        ], ""))
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleExpectedCompilerDeps(bundle: CompilerWorldBundle): layout.FixedBytes32 =
    var depsEntries: cworld.CompilerUniverseManifestEntry[]
    for i in 0..<bundle.manifest.entries.len:
        let entry = bundle.manifest.entries[i]
        if entry.packageId == bundle.compilerSnapshot.packageId:
            continue
        add(depsEntries,
            cworld.CompilerWorldOwnManifestEntry(entry))
    return cworld.CompilerWorldDepsManifestCid(bundle.worldHead.channel, depsEntries)

fn CompilerWorldBundleReadVerified(
        handle: os.AtomicTree,
        prefix: str,
        out: var CompilerWorldBundle,
        outCanonicalCsgText: var str,
        outOutputBytes: var Bytes): Result[bool] =
    let worldTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.world.txt", "world report")
    if IsErr(worldTextRes):
        return Err[bool](Error(worldTextRes))
    let manifestTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.manifest.txt", "manifest report")
    if IsErr(manifestTextRes):
        return Err[bool](Error(manifestTextRes))
    let compilerSnapshotTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.compiler.snapshot.txt", "compiler snapshot")
    if IsErr(compilerSnapshotTextRes):
        return Err[bool](Error(compilerSnapshotTextRes))
    let compilerMirrorTextRes = CompilerWorldBundleAtomicReadText(
        handle,
        "output.compiler_mirror.txt",
        "compiler managed mirror")
    if IsErr(compilerMirrorTextRes):
        return Err[bool](Error(compilerMirrorTextRes))
    let stdSnapshotTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.std.snapshot.txt", "std snapshot")
    if IsErr(stdSnapshotTextRes):
        return Err[bool](Error(stdSnapshotTextRes))
    let runtimeSnapshotTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.runtime.snapshot.txt", "runtime snapshot")
    if IsErr(runtimeSnapshotTextRes):
        return Err[bool](Error(runtimeSnapshotTextRes))
    let csgTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.csg.txt", "csg report")
    if IsErr(csgTextRes):
        return Err[bool](Error(csgTextRes))
    let surfaceTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.surface.txt", "export surface")
    if IsErr(surfaceTextRes):
        return Err[bool](Error(surfaceTextRes))
    let sourceIdentityTextRes = CompilerWorldBundleAtomicReadText(
        handle,
        "output.source_identity.receipt.txt",
        "portable source identity receipt")
    if IsErr(sourceIdentityTextRes):
        return Err[bool](Error(sourceIdentityTextRes))
    let semanticTextRes = CompilerWorldBundleAtomicReadText(
        handle,
        "output.semantic.receipt.txt",
        "compile semantic receipt")
    if IsErr(semanticTextRes):
        return Err[bool](Error(semanticTextRes))
    let receiptTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.receipt.txt", "compile receipt")
    if IsErr(receiptTextRes):
        return Err[bool](Error(receiptTextRes))
    let evidenceTextRes = CompilerWorldBundleAtomicReadText(
        handle,
        "output.evidence.txt",
        "migration evidence")
    if IsErr(evidenceTextRes):
        return Err[bool](Error(evidenceTextRes))
    let proofTextRes = CompilerWorldBundleAtomicReadText(
        handle,
        "output.proof.txt",
        "migration proof")
    if IsErr(proofTextRes):
        return Err[bool](Error(proofTextRes))
    let envelopeTextRes = CompilerWorldBundleAtomicReadText(
        handle,
        "output.envelope.txt",
        "world bundle envelope")
    if IsErr(envelopeTextRes):
        return Err[bool](Error(envelopeTextRes))
    let lockTextRes = CompilerWorldBundleAtomicReadText(
        handle, "output.lock.toml", "lock")
    if IsErr(lockTextRes):
        return Err[bool](Error(lockTextRes))
    var worldHead: cworld.CompilerWorldHead
    let worldRes = cworld.CompilerWorldHeadFromReportText(Value(worldTextRes), worldHead)
    if IsErr(worldRes):
        return Err[bool](Error(worldRes))
    var manifest: cworld.CompilerUniverseManifest
    let manifestRes = cworld.CompilerUniverseManifestFromReportText(Value(manifestTextRes), manifest)
    if IsErr(manifestRes):
        return Err[bool](Error(manifestRes))
    var compilerSnapshot: cworld.CompilerPackageSnapshot
    let compilerSnapshotRes = cworld.CompilerPackageSnapshotFromReportText(Value(compilerSnapshotTextRes), compilerSnapshot)
    if IsErr(compilerSnapshotRes):
        return Err[bool](Error(compilerSnapshotRes))
    var compilerMirrorBundle: cwlp.CompilerManagedMirrorBundle
    let compilerMirrorRes =
        cwlp.CompilerWorldManagedMirrorBundleFromReportText(
            Value(compilerMirrorTextRes),
            compilerMirrorBundle)
    if IsErr(compilerMirrorRes):
        return Err[bool](Error(compilerMirrorRes))
    var stdSnapshot: cworld.CompilerPackageSnapshot
    let stdSnapshotRes = cworld.CompilerPackageSnapshotFromReportText(Value(stdSnapshotTextRes), stdSnapshot)
    if IsErr(stdSnapshotRes):
        return Err[bool](Error(stdSnapshotRes))
    var runtimeSnapshot: cworld.CompilerPackageSnapshot
    let runtimeSnapshotRes = cworld.CompilerPackageSnapshotFromReportText(Value(runtimeSnapshotTextRes), runtimeSnapshot)
    if IsErr(runtimeSnapshotRes):
        return Err[bool](Error(runtimeSnapshotRes))
    let canonicalCsgCidRes = ccsg.CompilerCsgCanonicalGraphCidFromReportText(Value(csgTextRes))
    if IsErr(canonicalCsgCidRes):
        return Err[bool](Error(canonicalCsgCidRes))
    var exportSurface: ccsg.CsgExportSurface
    let exportSurfaceRes = ccsg.CompilerExportSurfaceFromReportText(Value(surfaceTextRes), exportSurface)
    if IsErr(exportSurfaceRes):
        return Err[bool](Error(exportSurfaceRes))
    var sourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
    let sourceIdentityRes =
        CompilerWorldBundlePortableSourceIdentityReceiptFromReportText(
            Value(sourceIdentityTextRes),
            sourceIdentityReceipt)
    if IsErr(sourceIdentityRes):
        return Err[bool](Error(sourceIdentityRes))
    var semanticReceipt: sexec.CompileSemanticReceipt
    let semanticRes =
        sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
            Value(semanticTextRes),
            semanticReceipt)
    if IsErr(semanticRes):
        return Err[bool](Error(semanticRes))
    var receipt: ccsg.CompileReceipt
    let receiptRes = ccsg.CompileReceiptFromReportText(Value(receiptTextRes), receipt)
    if IsErr(receiptRes):
        return Err[bool](Error(receiptRes))
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceFromReportText(
        Value(evidenceTextRes),
        evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofFromReportText(
        Value(proofTextRes),
        proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    var managedDependencyReceipt: cwlp.CompilerManagedDependencyReceipt
    var managedMirrorBundles: cwlp.CompilerManagedMirrorBundle[]
    if !layout.FixedBytes32Equal(manifest.managedDependencyReceiptCid,
                                 layout.FixedBytes32()):
        let dependencyTextRes = CompilerWorldBundleAtomicReadText(
            handle,
            "output.managed_dependency.receipt.txt",
            "managed dependency receipt")
        if IsErr(dependencyTextRes):
            return Err[bool](Error(dependencyTextRes))
        let dependencyRes =
            cwlp.CompilerWorldManagedDependencyReceiptFromReportText(
                Value(dependencyTextRes),
                managedDependencyReceipt)
        if IsErr(dependencyRes):
            return Err[bool](Error(dependencyRes))
        let indexTextRes = CompilerWorldBundleAtomicReadText(
            handle,
            "output.managed_mirror.index.txt",
            "managed mirror index")
        if IsErr(indexTextRes):
            return Err[bool](Error(indexTextRes))
        var packageIds: str[]
        var proofCids: layout.FixedBytes32[]
        var bundleCids: layout.FixedBytes32[]
        let bundlePathsRes =
            cwlp.CompilerWorldManagedMirrorBundlePathsFromIndexText(
                Value(indexTextRes),
                "output",
                packageIds,
                proofCids,
                bundleCids)
        if IsErr(bundlePathsRes):
            return Err[bool](Error(bundlePathsRes))
        let bundlePaths = Value(bundlePathsRes)
        for mirrorIndex in 0..<bundlePaths.len:
            let mirrorTextRes = CompilerWorldBundleAtomicReadText(
                handle,
                bundlePaths[mirrorIndex],
                "managed mirror bundle")
            if IsErr(mirrorTextRes):
                return Err[bool](Error(mirrorTextRes))
            var mirror: cwlp.CompilerManagedMirrorBundle
            let mirrorRes =
                cwlp.CompilerWorldManagedMirrorBundleFromReportText(
                    Value(mirrorTextRes),
                    mirror)
            if IsErr(mirrorRes):
                return Err[bool](Error(mirrorRes))
            if mirror.packageId != packageIds[mirrorIndex] ||
               !layout.FixedBytes32Equal(
                    mirror.migrationProofCid,
                    proofCids[mirrorIndex]) ||
               !layout.FixedBytes32Equal(
                    mirror.bundleCid,
                    bundleCids[mirrorIndex]):
                return Err[bool](
                    " compiler world bundle: managed mirror index binding mismatch")
            add(managedMirrorBundles, mirror)
    let lockRes = cworld.CompilerLockSnapshotFromText(Value(lockTextRes), strutil.Join([strings.CloneStr(prefix), ".lock.toml"], ""))
    if IsErr(lockRes):
        return Err[bool](Error(lockRes))
    out.bundlePrefix = prefix
    out.worldHead = worldHead
    out.manifest = manifest
    out.compilerSnapshot = compilerSnapshot
    out.stdSnapshot = stdSnapshot
    out.runtimeSnapshot = runtimeSnapshot
    out.compilerCsgCid = layout.FixedBytes32()
    out.compilerCanonicalCsgCid = Value(canonicalCsgCidRes)
    out.exportSurface = exportSurface
    out.sourceIdentityReceipt = sourceIdentityReceipt
    out.semanticReceipt = semanticReceipt
    out.receipt = receipt
    out.evidence = evidence
    out.proof = proof
    out.compilerMirrorBundle = compilerMirrorBundle
    out.managedDependencyReceipt = managedDependencyReceipt
    out.managedMirrorBundles = managedMirrorBundles
    out.lock = Value(lockRes)
    let envelopeCidRes = cworld.CompilerWorldFixed32Value(
        Value(envelopeTextRes),
        "envelope_cid")
    if IsErr(envelopeCidRes):
        return Err[bool](Error(envelopeCidRes))
    out.envelopeCid = Value(envelopeCidRes)
    if Value(envelopeTextRes) != CompilerWorldBundleEnvelopeReport(out):
        return Err[bool](
            " compiler world bundle: envelope report is not exact canonical")
    let outputRes = os.AtomicTreeReadStable(handle, "output")
    if IsErr(outputRes):
        return Err[bool](Error(outputRes))
    outCanonicalCsgText = Value(csgTextRes)
    outOutputBytes = Value(outputRes)
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleVerifyWithOutputDigest(
        bundle: CompilerWorldBundle,
        outputSha256: layout.FixedBytes32): Result[bool] =
    var strictErr = ""
    if !cworld.CompilerWorldHeadStrictValidateInto(bundle.worldHead,
                                                     strictErr) ||
       !cworld.CompilerPackageSnapshotStrictValidateInto(
            bundle.compilerSnapshot,
            strictErr) ||
       !cworld.CompilerPackageSnapshotStrictValidateInto(
            bundle.stdSnapshot,
            strictErr) ||
       !cworld.CompilerPackageSnapshotStrictValidateInto(
            bundle.runtimeSnapshot,
            strictErr) ||
       !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            bundle.sourceIdentityReceipt,
            strictErr) ||
       !sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            bundle.semanticReceipt,
            strictErr) ||
       !ccsg.CompileReceiptStrictValidateInto(bundle.receipt, strictErr):
        return Err[bool](strictErr)
    if !layout.FixedBytes32Equal(bundle.compilerCsgCid,
                                 layout.FixedBytes32()):
        return Err[bool](" compiler world bundle: compiler CSG diagnostic identity must be absent")
    if bundle.worldHead.universeId != cworld.CompilerWorldUniverseId():
        return Err[bool](" compiler world bundle: universe id mismatch")
    if bundle.worldHead.channel != bundle.manifest.channel:
        return Err[bool](" compiler world bundle: manifest channel mismatch")
    if bundle.worldHead.channel != bundle.compilerSnapshot.channel:
        return Err[bool](" compiler world bundle: compiler snapshot channel mismatch")
    if bundle.worldHead.channel != bundle.stdSnapshot.channel:
        return Err[bool](" compiler world bundle: std snapshot channel mismatch")
    if bundle.worldHead.channel != bundle.runtimeSnapshot.channel:
        return Err[bool](" compiler world bundle: runtime snapshot channel mismatch")
    if bundle.worldHead.channel != bundle.lock.channel:
        return Err[bool](" compiler world bundle: lock channel mismatch")
    if bundle.compilerSnapshot.packageId != "cheng/compiler":
        return Err[bool](" compiler world bundle: unexpected compiler package id")
    if bundle.stdSnapshot.packageId != "cheng/std":
        return Err[bool](" compiler world bundle: unexpected std package id")
    if bundle.runtimeSnapshot.packageId != "cheng/runtime":
        return Err[bool](" compiler world bundle: unexpected runtime package id")
    if !layout.FixedBytes32Equal(bundle.worldHead.manifestRootCid, bundle.manifest.manifestCid):
        return Err[bool](" compiler world bundle: manifest root mismatch")
    if !layout.FixedBytes32Equal(bundle.worldHead.compilerPkgCid, bundle.compilerSnapshot.snapshotCid):
        return Err[bool](" compiler world bundle: compiler snapshot cid mismatch")
    if !layout.FixedBytes32Equal(bundle.worldHead.stdPkgCid, bundle.stdSnapshot.snapshotCid):
        return Err[bool](" compiler world bundle: std snapshot cid mismatch")
    if !layout.FixedBytes32Equal(bundle.worldHead.runtimePkgCid, bundle.runtimeSnapshot.snapshotCid):
        return Err[bool](" compiler world bundle: runtime snapshot cid mismatch")
    let compilerManifestBindingRes = CompilerWorldBundleVerifyManifestBinding(bundle.manifest, bundle.compilerSnapshot)
    if IsErr(compilerManifestBindingRes):
        return Err[bool](Error(compilerManifestBindingRes))
    let stdManifestBindingRes = CompilerWorldBundleVerifyManifestBinding(bundle.manifest, bundle.stdSnapshot)
    if IsErr(stdManifestBindingRes):
        return Err[bool](Error(stdManifestBindingRes))
    let runtimeManifestBindingRes = CompilerWorldBundleVerifyManifestBinding(bundle.manifest, bundle.runtimeSnapshot)
    if IsErr(runtimeManifestBindingRes):
        return Err[bool](Error(runtimeManifestBindingRes))
    if !layout.FixedBytes32Equal(bundle.compilerSnapshot.csgRootCid, bundle.worldHead.csgRootCid):
        return Err[bool](" compiler world bundle: compiler csg root mismatch")
    if !layout.FixedBytes32Equal(bundle.stdSnapshot.csgRootCid, bundle.worldHead.csgRootCid):
        return Err[bool](" compiler world bundle: std csg root mismatch")
    if !layout.FixedBytes32Equal(bundle.runtimeSnapshot.csgRootCid, bundle.worldHead.csgRootCid):
        return Err[bool](" compiler world bundle: runtime csg root mismatch")
    if !layout.FixedBytes32Equal(bundle.compilerCanonicalCsgCid, bundle.worldHead.csgRootCid):
        return Err[bool](" compiler world bundle: csg report mismatch")
    if !layout.FixedBytes32Equal(bundle.exportSurface.surfaceCid, bundle.compilerSnapshot.exportSurfaceCid):
        return Err[bool](" compiler world bundle: export surface cid mismatch")
    let compilerDepsCid = CompilerWorldBundleExpectedCompilerDeps(bundle)
    if !layout.FixedBytes32Equal(bundle.compilerSnapshot.depsManifestCid, compilerDepsCid):
        return Err[bool](" compiler world bundle: compiler deps manifest mismatch")
    let emptyDepsCid = cworld.CompilerWorldEmptyManifestCid(bundle.worldHead.channel)
    if !layout.FixedBytes32Equal(bundle.stdSnapshot.depsManifestCid, emptyDepsCid):
        return Err[bool](" compiler world bundle: std deps manifest mismatch")
    if !layout.FixedBytes32Equal(bundle.runtimeSnapshot.depsManifestCid, emptyDepsCid):
        return Err[bool](" compiler world bundle: runtime deps manifest mismatch")
    if !layout.FixedBytes32Equal(
            bundle.sourceIdentityReceipt.sourcePackageIdCid,
            ccsg.CompilerCsgPortableSourcePackageIdCid(
                bundle.compilerMirrorBundle.packageId)) ||
       !layout.FixedBytes32Equal(bundle.sourceIdentityReceipt.sourceBundleCid,
                                 bundle.compilerSnapshot.sourceBundleCid):
        return Err[bool](" compiler world bundle: portable source receipt/snapshot mismatch")
    if !layout.FixedBytes32Equal(
            bundle.semanticReceipt.sourceIdentityReceiptCid,
            bundle.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            bundle.semanticReceipt.canonicalCompilerCsgCid,
            bundle.compilerCanonicalCsgCid):
        return Err[bool](" compiler world bundle: semantic predecessor mismatch")
    let targetTripleCid = sexec.SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        bundle.receipt.targetTriple)
    let bootstrapStageCid = sexec.SystemLinkExecSemanticTextCid(
        "cheng.compiler.bootstrap_stage",
        bundle.receipt.bootstrapStage)
    var providerSetCid: layout.FixedBytes32
    if !sexec.SystemLinkExecOrderedProviderSetCidInto(
            bundle.receipt.runtimeProviderSet,
            providerSetCid,
            strictErr):
        return Err[bool](strictErr)
    if !layout.FixedBytes32Equal(bundle.semanticReceipt.targetTripleCid,
                                 targetTripleCid) ||
       !layout.FixedBytes32Equal(bundle.semanticReceipt.bootstrapStageCid,
                                 bootstrapStageCid) ||
       !layout.FixedBytes32Equal(bundle.semanticReceipt.orderedProviderSetCid,
                                 providerSetCid):
        return Err[bool](" compiler world bundle: semantic compile identity mismatch")
    if !layout.FixedBytes32Equal(bundle.receipt.worldHeadCid, bundle.worldHead.headCid):
        return Err[bool](" compiler world bundle: receipt world head mismatch")
    if !layout.FixedBytes32Equal(
            bundle.receipt.sourceIdentityReceiptCid,
            bundle.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(bundle.receipt.semanticReceiptCid,
                                 bundle.semanticReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(bundle.receipt.canonicalOutputDigest,
                                 bundle.semanticReceipt.canonicalOutputDigest):
        return Err[bool](" compiler world bundle: final receipt predecessor mismatch")
    if !layout.FixedBytes32Equal(outputSha256,
                                 bundle.receipt.outputDigest):
        return Err[bool](" compiler world bundle: final output sha256 mismatch")
    if !ceq.CompilerMigrationSemanticProofPassedStable(bundle.proof,
                                                          bundle.evidence) ||
       bundle.proof.packageId != bundle.compilerMirrorBundle.packageId ||
       !layout.FixedBytes32Equal(bundle.proof.proofCid,
                                 bundle.compilerSnapshot.migrationProofCid) ||
       !layout.FixedBytes32Equal(bundle.proof.legacySourceIdentityReceiptCid,
                                 bundle.evidence.legacySourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(bundle.proof.migratedSourceIdentityReceiptCid,
                                 bundle.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(bundle.proof.migratedGraphCid,
                                 bundle.compilerCanonicalCsgCid) ||
       !layout.FixedBytes32Equal(bundle.proof.migratedSurfaceCid,
                                 bundle.exportSurface.surfaceCid) ||
       !layout.FixedBytes32Equal(bundle.proof.migratedSemanticReceiptCid,
                                 bundle.semanticReceipt.receiptCid):
        return Err[bool](" compiler world bundle: migration proof chain mismatch")
    let compilerMirrorVerifyRes =
        cwlp.CompilerWorldManagedMirrorBundleVerify(
            bundle.compilerMirrorBundle)
    if IsErr(compilerMirrorVerifyRes):
        return Err[bool](Error(compilerMirrorVerifyRes))
    var compilerManifestEntry: cworld.CompilerUniverseManifestEntry
    if !CompilerWorldBundleManifestEntry(bundle.manifest,
                                         "cheng/compiler",
                                         compilerManifestEntry) ||
       !layout.FixedBytes32Equal(
            compilerManifestEntry.managedMirrorBundleCid,
            bundle.compilerMirrorBundle.bundleCid) ||
       !layout.FixedBytes32Equal(
            bundle.compilerMirrorBundle.migrationProofCid,
            bundle.proof.proofCid) ||
       !layout.FixedBytes32Equal(
            bundle.compilerMirrorBundle.migratedSourceIdentityReceiptCid,
            bundle.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            bundle.sourceIdentityReceipt.sourcePackageIdCid,
            ccsg.CompilerCsgPortableSourcePackageIdCid(
                bundle.compilerMirrorBundle.packageId)):
        return Err[bool](
            " compiler world bundle: compiler mirror/manifest chain mismatch")
    let hasManagedReceipt = !layout.FixedBytes32Equal(
        bundle.manifest.managedDependencyReceiptCid,
        layout.FixedBytes32())
    if hasManagedReceipt != (bundle.managedMirrorBundles.len > 0):
        return Err[bool](
            " compiler world bundle: managed receipt/mirror presence mismatch")
    if !hasManagedReceipt &&
       (bundle.managedDependencyReceipt.channel != "" ||
        bundle.managedDependencyReceipt.dependencyCount != 0 ||
        bundle.managedDependencyReceipt.entries.len != 0 ||
        !layout.FixedBytes32Equal(
            bundle.managedDependencyReceipt.receiptCid,
            layout.FixedBytes32())):
        return Err[bool](
            " compiler world bundle: absent managed receipt is not empty")
    if hasManagedReceipt:
        if !cwlp.CompilerWorldManagedDependencyReceiptVerify(
                bundle.managedDependencyReceipt) ||
           !layout.FixedBytes32Equal(
                bundle.managedDependencyReceipt.receiptCid,
                bundle.manifest.managedDependencyReceiptCid) ||
           bundle.managedDependencyReceipt.channel != bundle.worldHead.channel ||
           bundle.managedDependencyReceipt.dependencyCount !=
                bundle.managedMirrorBundles.len:
            return Err[bool](
                " compiler world bundle: managed dependency receipt mismatch")
        let authorizedMirrorsRes =
            cwlp.CompilerWorldManagedMirrorBundlesAuthorized(
                bundle.manifest,
                bundle.managedDependencyReceipt,
                bundle.managedMirrorBundles)
        if IsErr(authorizedMirrorsRes):
            return Err[bool](Error(authorizedMirrorsRes))
        let authorizedMirrors = Value(authorizedMirrorsRes)
        for i in 0..<bundle.managedMirrorBundles.len:
            let mirror = bundle.managedMirrorBundles[i]
            let dependency = bundle.managedDependencyReceipt.entries[i]
            if !layout.FixedBytes32Equal(mirror.bundleCid,
                                         authorizedMirrors[i].bundleCid):
                return Err[bool](
                    " compiler world bundle: managed mirror order is not canonical")
            let mirrorVerifyRes =
                cwlp.CompilerWorldManagedMirrorBundleVerify(mirror)
            if IsErr(mirrorVerifyRes):
                return Err[bool](Error(mirrorVerifyRes))
            if mirror.packageId != dependency.canonicalPackageId ||
               !layout.FixedBytes32Equal(mirror.migrationProofCid,
                                         dependency.migrationProofCid):
                return Err[bool](
                    " compiler world bundle: managed receipt/mirror order mismatch")
            var manifestEntry: cworld.CompilerUniverseManifestEntry
            if !CompilerWorldBundleManifestEntry(bundle.manifest,
                                                 mirror.packageId,
                                                 manifestEntry) ||
               !layout.FixedBytes32Equal(manifestEntry.snapshotCid,
                                         dependency.snapshotCid) ||
               !layout.FixedBytes32Equal(manifestEntry.syntaxSurfaceCid,
                                         dependency.syntaxSurfaceCid) ||
               !layout.FixedBytes32Equal(manifestEntry.migrationProofCid,
                                         mirror.migrationProofCid) ||
               !layout.FixedBytes32Equal(manifestEntry.managedMirrorBundleCid,
                                         mirror.bundleCid):
                return Err[bool](
                    " compiler world bundle: manifest managed mirror mismatch")
    let expectedHead = cworld.CompilerWorldHeadMake(bundle.worldHead.channel,
                                                      bundle.worldHead.headEpoch,
                                                      bundle.worldHead.prevHeadCid,
                                                      bundle.manifest,
                                                      bundle.compilerCanonicalCsgCid,
                                                      bundle.compilerSnapshot.snapshotCid,
                                                      bundle.stdSnapshot.snapshotCid,
                                                      bundle.runtimeSnapshot.snapshotCid,
                                                      bundle.worldHead.signature)
    if !layout.FixedBytes32Equal(expectedHead.headCid, bundle.worldHead.headCid):
        return Err[bool](" compiler world bundle: world head cid mismatch")
    if !layout.FixedBytes32Equal(bundle.envelopeCid,
                                 CompilerWorldBundleEnvelopeCid(bundle)):
        return Err[bool](" compiler world bundle: envelope cid mismatch")
    let lockVerifyRes = cworld.CompilerWorldVerifyLock(CompilerWorldBundleUniverse(bundle), bundle.lock)
    if IsErr(lockVerifyRes):
        return Err[bool](Error(lockVerifyRes))
    return Ok[bool](true)

fn CompilerWorldBundleMake(
        originalOutputPrefix: str,
        installedOutputPrefix: str,
        snapshot: sexec.SystemLinkExecPublicationSnapshot,
        receipt: ccsg.CompileReceipt,
        evidence: ceq.CompilerMigrationEvidence,
        proof: ceq.CompilerMigrationSemanticProof,
        compilerMirrorBundle: cwlp.CompilerManagedMirrorBundle,
        managedDependencyReceipt: cwlp.CompilerManagedDependencyReceipt,
        managedMirrorBundles: cwlp.CompilerManagedMirrorBundle[],
        out: var CompilerWorldBundle): Result[bool] =
    var authorizationReceipt: cwlp.CompilerManagedDependencyReceipt
    let authorizationReceiptRes =
        cwlp.CompilerWorldManagedDependencyReceiptFromReportText(
            cwlp.CompilerWorldManagedDependencyReceiptReport(
                managedDependencyReceipt),
            authorizationReceipt)
    if IsErr(authorizationReceiptRes):
        return Err[bool](Error(authorizationReceiptRes))
    let authorizedRes = cwlp.CompilerWorldManagedMirrorBundlesAuthorized(
        cworld.CompilerWorldOwnUniverseManifest(
            snapshot.localUniverse.manifest),
        authorizationReceipt,
        managedMirrorBundles)
    if IsErr(authorizedRes):
        return Err[bool](Error(authorizedRes))
    let ownedInstalledPrefix = strings.CloneStr(installedOutputPrefix)
    let ownedOriginalPrefix = strings.CloneStr(originalOutputPrefix)
    let lockText = cworld.CompilerLockText(snapshot.localUniverse)
    let lockRes = cworld.CompilerLockSnapshotFromText(
        lockText,
        strings.ConcatStr(strings.CloneStr(ownedInstalledPrefix), ".lock.toml"))
    if IsErr(lockRes):
        return Err[bool](Error(lockRes))
    var next: CompilerWorldBundle
    next.bundlePrefix = ownedOriginalPrefix
    next.worldHead = snapshot.localUniverse.worldHead
    next.manifest = snapshot.localUniverse.manifest
    next.compilerSnapshot = snapshot.localUniverse.compilerSnapshot
    next.stdSnapshot = snapshot.localUniverse.stdSnapshot
    next.runtimeSnapshot = snapshot.localUniverse.runtimeSnapshot
    next.compilerCsgCid = layout.FixedBytes32()
    next.compilerCanonicalCsgCid = snapshot.canonicalCsgCid
    next.exportSurface = snapshot.exportSurface
    next.sourceIdentityReceipt = snapshot.sourceIdentityReceipt
    next.semanticReceipt = snapshot.semanticReceipt
    next.receipt = receipt
    next.evidence = evidence
    next.proof = proof
    next.compilerMirrorBundle = compilerMirrorBundle
    next.managedDependencyReceipt = managedDependencyReceipt
    next.managedMirrorBundles = Value(authorizedRes)
    next.lock = Value(lockRes)
    next.envelopeCid = CompilerWorldBundleEnvelopeCid(next)
    let outputDigest = next.receipt.outputDigest
    let verifyRes = CompilerWorldBundleVerifyWithOutputDigest(
        next,
        outputDigest)
    if IsErr(verifyRes):
        return Err[bool](Error(verifyRes))
    next.bundlePrefix = ownedInstalledPrefix
    out = next
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleAtomicFilesWithMarker(
        bundle: CompilerWorldBundle,
        compilerCsgText: str,
        outputBytes: var Bytes,
        outFiles: var CompilerWorldBundleAtomicTextFile[],
        outExpectedDirs: var str[],
        outExpectedPaths: var str[]): Result[bool] =
    var files: CompilerWorldBundleAtomicTextFile[]
    let filesRes = CompilerWorldBundleAtomicFiles(bundle,
                                                     compilerCsgText,
                                                     files)
    if IsErr(filesRes):
        return Err[bool](Error(filesRes))
    let outputDigest = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(outputBytes))
    if !layout.FixedBytes32Equal(outputDigest,
                                 bundle.receipt.outputDigest):
        return Err[bool](
            " compiler world bundle: atomic output sha256 mismatch")
    var marker = strutil.Join([
        "envelope_cid=",
        layout.FixedBytes32Hex(bundle.envelopeCid),
        "\nfile_count=",
        IntToStr(files.len + 1),
        "\nfile[0].path=output\nfile[0].raw_byte_length=",
        IntToStr(rawbytes.BytesLen(outputBytes)),
        "\nfile[0].sha256=",
        layout.FixedBytes32Hex(outputDigest)
    ], "")
    for index in 0..<files.len:
        marker = Fmt"{marker}\nfile[{IntToStr(index + 1)}].path={files[index].relativePath}\nfile[{IntToStr(index + 1)}].raw_byte_length={IntToStr(files[index].text.len)}\nfile[{IntToStr(index + 1)}].sha256={layout.FixedBytes32Hex(CompilerWorldBundleTextRawSha256(files[index].text))}"
    let markerRes = CompilerWorldBundleAtomicTextFileAdd(
        files,
        "output.commit.txt",
        marker)
    if IsErr(markerRes):
        return Err[bool](Error(markerRes))
    var expectedPaths: str[]
    add(expectedPaths, "output")
    for index in 0..<files.len:
        add(expectedPaths, share(files[index].relativePath))
    var expectedDirs: str[]
    for pathIndex in 0..<expectedPaths.len:
        let relativePath = expectedPaths[pathIndex]
        for charIndex in 0..<relativePath.len:
            if relativePath[charIndex] != '/':
                continue
            let dir = strings.CloneStr(chengpath.TextSlice(relativePath, 0, charIndex))
            var present = false
            for dirIndex in 0..<expectedDirs.len:
                if expectedDirs[dirIndex] == dir:
                    present = true
            if present:
                continue
            var insertAt = expectedDirs.len
            while insertAt > 0 && CompilerWorldBundleTextLess(
                    dir,
                    expectedDirs[insertAt - 1]):
                insertAt = insertAt - 1
            add(expectedDirs, strings.CloneStr(dir))
            var cursor = expectedDirs.len - 1
            while cursor > insertAt:
                expectedDirs[cursor] = expectedDirs[cursor - 1]
                cursor = cursor - 1
            expectedDirs[insertAt] = dir
    outFiles = files
    outExpectedDirs = expectedDirs
    outExpectedPaths = expectedPaths
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleAtomicVerifyHandle(
        handle: os.AtomicTree,
        bundle: CompilerWorldBundle,
        files: CompilerWorldBundleAtomicTextFile[],
        expectedDirs: str[],
        expectedPaths: str[]): Result[bool] =
    let exactRes = os.AtomicTreeVerifyExact(handle,
                                            expectedDirs,
                                            expectedPaths)
    if IsErr(exactRes):
        return Err[bool](Error(exactRes))
    let outputRes = os.AtomicTreeReadStable(handle, "output")
    if IsErr(outputRes):
        return Err[bool](Error(outputRes))
    var outputBytes = Value(outputRes)
    let outputDigest = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(outputBytes))
    rawbytes.BytesFree(outputBytes)
    if !layout.FixedBytes32Equal(outputDigest,
                                 bundle.receipt.outputDigest):
        return Err[bool](
            " compiler world bundle: installed output sha256 mismatch")
    for index in 0..<files.len:
        let readRes = os.AtomicTreeReadStable(handle,
                                              files[index].relativePath)
        if IsErr(readRes):
            return Err[bool](Error(readRes))
        var actual = Value(readRes)
        var expected = CompilerWorldBundleOwnedBytesFromText(
            files[index].text)
        let exact = rawbytes.BytesEqual(actual, expected)
        rawbytes.BytesFree(actual)
        rawbytes.BytesFree(expected)
        if !exact:
            return Err[bool](strutil.Join([
                " compiler world bundle: installed atomic file mismatch: ",
                share(files[index].relativePath)
            ], ""))
    return Ok[bool](true)

@borrows
fn CompilerWorldBundleAtomicAbort(
        handle: os.AtomicTree,
        primaryError: str): Result[str] =
    let abortRes = os.AtomicTreeAbort(handle)
    if IsErr(abortRes):
        let abortText = Error(abortRes)
        return Err[str](Fmt"{primaryError}; atomic staging abort failed: {abortText}")
    return Err[str](Fmt"{primaryError}")

fn CompilerWorldBundleInstallAtomic(
        rootDir: str,
        prefixRaw: str,
        snapshot: sexec.SystemLinkExecPublicationSnapshot,
        receipt: ccsg.CompileReceipt,
        evidence: ceq.CompilerMigrationEvidence,
        proof: ceq.CompilerMigrationSemanticProof,
        compilerMirrorBundle: cwlp.CompilerManagedMirrorBundle,
        managedDependencyReceipt: cwlp.CompilerManagedDependencyReceipt,
        managedMirrorBundles: cwlp.CompilerManagedMirrorBundle[]): Result[str] =
    let originalPrefix = chengpath.PathAbsolute(rootDir, prefixRaw)
    let installedPrefix = CompilerWorldBundleInstalledOutputPrefix(
        rootDir,
        prefixRaw)
    let parentPath = os.ParentDir(originalPrefix)
    let outputLeaf = os.ExtractFilename(strings.CloneStr(originalPrefix))
    if outputLeaf == "" || parentPath == "":
        return Err[str](
            " compiler world bundle: trusted atomic parent identity is unavailable")
    let finalName = outputLeaf + ".world_bundle"
    let csgText = strings.CloneStr(snapshot.canonicalCsgText)
    var bundle: CompilerWorldBundle
    let makeRes = CompilerWorldBundleMake(strings.CloneStr(originalPrefix),
                                             strings.CloneStr(installedPrefix),
                                             snapshot,
                                             receipt,
                                             evidence,
                                             proof,
                                             compilerMirrorBundle,
                                             managedDependencyReceipt,
                                             managedMirrorBundles,
                                             bundle)
    if IsErr(makeRes):
        return Err[str](Error(makeRes))
    let outputRes = os.ReadFileBytesResult(originalPrefix)
    if IsErr(outputRes):
        return Err[str](Error(outputRes))
    var outputBytes = Value(outputRes)
    var files: CompilerWorldBundleAtomicTextFile[]
    var expectedDirs: str[]
    var expectedPaths: str[]
    let filesRes = CompilerWorldBundleAtomicFilesWithMarker(
        bundle,
        csgText,
        outputBytes,
        files,
        expectedDirs,
        expectedPaths)
    if IsErr(filesRes):
        rawbytes.BytesFree(outputBytes)
        return Err[str](Error(filesRes))
    let stagingName = ".staging-world-bundle-" + strings.CloneStr(finalName) + "-" +
        IntToStr(os.ProcessId()) + "-" +
        strings.Int64ToStr(monotimes.MonoTimeNs(monotimes.GetMonoTime()))
    let beginRes = os.AtomicTreeBegin(parentPath,
                                      stagingName,
                                      finalName)
    if IsErr(beginRes):
        rawbytes.BytesFree(outputBytes)
        return Err[str](Error(beginRes))
    let handle = Value(beginRes)
    for dirIndex in 0..<expectedDirs.len:
        let mkdirRes = os.AtomicTreeMkdir(handle,
                                          expectedDirs[dirIndex])
        if IsErr(mkdirRes):
            rawbytes.BytesFree(outputBytes)
            return CompilerWorldBundleAtomicAbort(handle,
                                                     Error(mkdirRes))
    let outputWriteRes = os.AtomicTreeWriteExclusiveSync(handle,
                                                         "output",
                                                         outputBytes)
    rawbytes.BytesFree(outputBytes)
    if IsErr(outputWriteRes):
        return CompilerWorldBundleAtomicAbort(handle,
                                                 Error(outputWriteRes))
    for index in 0..<files.len:
        if files[index].relativePath == "output.commit.txt":
            continue
        var textBytes = CompilerWorldBundleOwnedBytesFromText(
            files[index].text)
        let writeRes = os.AtomicTreeWriteExclusiveSync(
            handle,
            files[index].relativePath,
            textBytes)
        rawbytes.BytesFree(textBytes)
        if IsErr(writeRes):
            return CompilerWorldBundleAtomicAbort(handle,
                                                     Error(writeRes))
    var markerText = ""
    for index in 0..<files.len:
        if files[index].relativePath == "output.commit.txt":
            markerText = files[index].text
    if markerText == "":
        return CompilerWorldBundleAtomicAbort(
            handle,
            " compiler world bundle: atomic commit marker missing")
    var markerBytes = CompilerWorldBundleOwnedBytesFromText(markerText)
    let markerWriteRes = os.AtomicTreeWriteExclusiveSync(
        handle,
        "output.commit.txt",
        markerBytes)
    rawbytes.BytesFree(markerBytes)
    if IsErr(markerWriteRes):
        return CompilerWorldBundleAtomicAbort(handle,
                                                 Error(markerWriteRes))
    let stagedVerifyRes = CompilerWorldBundleAtomicVerifyHandle(
        handle,
        bundle,
        files,
        expectedDirs,
        expectedPaths)
    if IsErr(stagedVerifyRes):
        return CompilerWorldBundleAtomicAbort(handle,
                                                 Error(stagedVerifyRes))
    let commitRes = os.AtomicTreeCommitNoReplace(handle)
    if IsErr(commitRes):
        return CompilerWorldBundleAtomicAbort(handle,
                                                 Error(commitRes))
    if Value(commitRes) == os.AtomicTreeCommitted:
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            return Err[str](Error(closeRes))
    elif Value(commitRes) == os.AtomicTreeDestinationExists:
        let abortRes = os.AtomicTreeAbort(handle)
        if IsErr(abortRes):
            return Err[str](Error(abortRes))
    elif Value(commitRes) == os.AtomicTreeCommittedDurabilityUnknown:
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            return Err[str](strutil.Join([
                " compiler world bundle: committed tree durability is unknown; close failed: ",
                Error(closeRes)
            ], ""))
        return Err[str](
            " compiler world bundle: committed tree durability is unknown")
    else:
        panic("compiler world bundle: impossible atomic commit result")
    let openRes = os.AtomicTreeOpenVerified(parentPath, finalName)
    if IsErr(openRes):
        return Err[str](Error(openRes))
    let verified = Value(openRes)
    let installedVerifyRes = CompilerWorldBundleAtomicVerifyHandle(
        verified,
        bundle,
        files,
        expectedDirs,
        expectedPaths)
    let closeRes = os.AtomicTreeClose(verified)
    if IsErr(installedVerifyRes):
        if IsErr(closeRes):
            return Err[str](strutil.Join([
                Error(installedVerifyRes),
                "; verified tree close failed: ",
                Error(closeRes)
            ], ""))
        return Err[str](Error(installedVerifyRes))
    if IsErr(closeRes):
        return Err[str](Error(closeRes))
    return Ok[str](installedPrefix)

@borrows
fn CompilerWorldBundleReadAndVerify(rootDir: str,
                                      prefixRaw: str,
                                      out: var CompilerWorldBundle): Result[bool] =
    let requestedPrefix = chengpath.PathAbsolute(rootDir, prefixRaw)
    let parentPath = os.ParentDir(requestedPrefix)
    let finalName = strutil.Join([
        os.ExtractFilename(strings.CloneStr(requestedPrefix)),
        ".world_bundle"
    ], "")
    let openRes = os.AtomicTreeOpenVerified(parentPath, finalName)
    if IsErr(openRes):
        return Err[bool](Error(openRes))
    let handle = Value(openRes)
    var canonicalCsgText: str
    var outputBytes: Bytes
    let readRes = CompilerWorldBundleReadVerified(
        handle,
        CompilerWorldBundleInstalledOutputPrefix(rootDir, prefixRaw),
        out,
        canonicalCsgText,
        outputBytes)
    if IsErr(readRes):
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            return Err[bool](strutil.Join([
                Error(readRes),
                "; verified tree close failed: ",
                Error(closeRes)
            ], ""))
        return Err[bool](Error(readRes))
    let outputDigest = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(outputBytes))
    let verifyRes = CompilerWorldBundleVerifyWithOutputDigest(
        out,
        outputDigest)
    if IsErr(verifyRes):
        rawbytes.BytesFree(outputBytes)
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            return Err[bool](strutil.Join([
                Error(verifyRes),
                "; verified tree close failed: ",
                Error(closeRes)
            ], ""))
        return Err[bool](Error(verifyRes))
    var files: CompilerWorldBundleAtomicTextFile[]
    var expectedDirs: str[]
    var expectedPaths: str[]
    let filesRes = CompilerWorldBundleAtomicFilesWithMarker(
        out,
        canonicalCsgText,
        outputBytes,
        files,
        expectedDirs,
        expectedPaths)
    rawbytes.BytesFree(outputBytes)
    if IsErr(filesRes):
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            return Err[bool](strutil.Join([
                Error(filesRes),
                "; verified tree close failed: ",
                Error(closeRes)
            ], ""))
        return Err[bool](Error(filesRes))
    let exactRes = CompilerWorldBundleAtomicVerifyHandle(
        handle,
        out,
        files,
        expectedDirs,
        expectedPaths)
    let closeRes = os.AtomicTreeClose(handle)
    if IsErr(exactRes):
        if IsErr(closeRes):
            return Err[bool](strutil.Join([
                Error(exactRes),
                "; verified tree close failed: ",
                Error(closeRes)
            ], ""))
        return Err[bool](Error(exactRes))
    if IsErr(closeRes):
        return Err[bool](Error(closeRes))
    return Ok[bool](true)
