import std/os
import std/result
import std/strings
import std/strformat
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/backend/target_matrix as tmat

type
    CompilerBackendKind = enum
        CompilerBackendPrimary
        CompilerBackend2

    CompilerEmit = enum
        EmitExe
        EmitObj
        EmitShared

    CompilerRequest =
        rootDir: str
        sourcePath: str
        outputPath: str
        targetTriple: str
        emitKind: CompilerEmit
        reportPath: str
        symbolVisibility: str
        browserBridgeObjectPath: str
        exportRootSymbols: str[]
        providerObjectPaths: str[]
        runtimeProviderBundle: str
        compileMode: str
        backendKind: CompilerBackendKind
        jobCount: int32
        exactFunctionSourcePath: str
        exactFunctionName: str
        exactFunctionDriverPath: str
        compositionManifestSchema: str
        compositionManifestSha256: str
        compositionKernelManifestSha256: str
        compositionKind: str
        compositionEntrySource: str
        compositionPluginCanonicalTriple: str
        compositionDeclaredSourcePaths: str[]
        compositionDeclaredSourcesSha256: str
        compositionSourceClosureCount: int32
        compositionSourceClosureSha256: str
        backendRequestActionCid: layout.FixedBytes32
        backendRequestCid: layout.FixedBytes32
        cacheDisabled: bool
        sealed: bool

fn CompilerSymbolVisibilityPublic(): str =
    return "public"

fn CompilerSymbolVisibilityInternal(): str =
    return "internal"

fn CompilerEmitExeValue(): CompilerEmit =
    return EmitExe

fn CompilerEmitObjValue(): CompilerEmit =
    return EmitObj

fn CompilerEmitSharedValue(): CompilerEmit =
    return EmitShared

@borrows
fn CompilerStringOk(value: str): Result[str] =
    return Ok[str](strings.CloneStr(value))

@borrows
fn CompilerSymbolVisibilityFromText(raw: str): Result[str] =
    let trimmed = strutil.Strip(raw)
    if Len(trimmed) <= 0:
        return CompilerStringOk(CompilerSymbolVisibilityPublic())
    if trimmed == CompilerSymbolVisibilityPublic():
        return CompilerStringOk(trimmed)
    if trimmed == CompilerSymbolVisibilityInternal():
        return CompilerStringOk(trimmed)
    let message = Fmt" compiler: unsupported --symbol-visibility: {trimmed}"
    return Err[str](message)

@borrows
fn CompilerRequestNew(rootDir: str,
                        sourcePath: str,
                        outputPath: str,
                        targetTriple: str,
                        emitKind: CompilerEmit,
                        reportPath: str): CompilerRequest =
    let symbolVisibility = CompilerSymbolVisibilityPublic()
    var out: CompilerRequest
    out.rootDir = strings.CloneStr(rootDir)
    out.sourcePath = strings.CloneStr(sourcePath)
    out.outputPath = strings.CloneStr(outputPath)
    out.targetTriple = strings.CloneStr(targetTriple)
    out.emitKind = emitKind
    out.reportPath = strings.CloneStr(reportPath)
    out.symbolVisibility = symbolVisibility
    out.browserBridgeObjectPath = ""
    out.compileMode = ""
    out.backendKind = CompilerBackendPrimary
    out.jobCount = 1
    out.backendRequestActionCid = layout.FixedBytes32()
    out.backendRequestCid = layout.FixedBytes32()
    out.cacheDisabled = false
    out.sealed = false
    return out

@borrows
fn CompilerRequestClone(req: CompilerRequest): CompilerRequest =
    var out: CompilerRequest
    out.rootDir = strings.CloneStr(req.rootDir)
    out.sourcePath = strings.CloneStr(req.sourcePath)
    out.outputPath = strings.CloneStr(req.outputPath)
    out.targetTriple = strings.CloneStr(req.targetTriple)
    out.emitKind = req.emitKind
    out.reportPath = strings.CloneStr(req.reportPath)
    out.symbolVisibility = strings.CloneStr(req.symbolVisibility)
    out.browserBridgeObjectPath = strings.CloneStr(req.browserBridgeObjectPath)
    for i in 0..<req.exportRootSymbols.len:
        add(out.exportRootSymbols,
            strings.CloneStr(req.exportRootSymbols[i]))
    for i in 0..<req.providerObjectPaths.len:
        add(out.providerObjectPaths,
            strings.CloneStr(req.providerObjectPaths[i]))
    out.runtimeProviderBundle = strings.CloneStr(req.runtimeProviderBundle)
    out.compileMode = strings.CloneStr(req.compileMode)
    out.backendKind = req.backendKind
    out.jobCount = req.jobCount
    out.exactFunctionSourcePath = strings.CloneStr(
        req.exactFunctionSourcePath)
    out.exactFunctionName = strings.CloneStr(req.exactFunctionName)
    out.exactFunctionDriverPath = strings.CloneStr(
        req.exactFunctionDriverPath)
    out.compositionManifestSchema = strings.CloneStr(
        req.compositionManifestSchema)
    out.compositionManifestSha256 = strings.CloneStr(
        req.compositionManifestSha256)
    out.compositionKernelManifestSha256 = strings.CloneStr(
        req.compositionKernelManifestSha256)
    out.compositionKind = strings.CloneStr(req.compositionKind)
    out.compositionEntrySource = strings.CloneStr(
        req.compositionEntrySource)
    out.compositionPluginCanonicalTriple = strings.CloneStr(
        req.compositionPluginCanonicalTriple)
    for i in 0..<req.compositionDeclaredSourcePaths.len:
        add(out.compositionDeclaredSourcePaths,
            strings.CloneStr(
                req.compositionDeclaredSourcePaths[i]))
    out.compositionDeclaredSourcesSha256 = strings.CloneStr(
        req.compositionDeclaredSourcesSha256)
    out.compositionSourceClosureCount =
        req.compositionSourceClosureCount
    out.compositionSourceClosureSha256 = strings.CloneStr(
        req.compositionSourceClosureSha256)
    out.backendRequestActionCid = req.backendRequestActionCid
    out.backendRequestCid = req.backendRequestCid
    out.cacheDisabled = req.cacheDisabled
    out.sealed = req.sealed
    return out

@borrows
fn CompilerBackendKindFromText(
        raw: str): Result[CompilerBackendKind] =
    let trimmed = strutil.Strip(raw)
    if trimmed == "primary":
        return Ok[CompilerBackendKind](CompilerBackendPrimary)
    if trimmed == "backend2":
        return Ok[CompilerBackendKind](CompilerBackend2)
    return Err[CompilerBackendKind](
        Fmt" compiler: unsupported --backend: {trimmed}")

fn CompilerBackendKindText(kind: CompilerBackendKind): str =
    if kind == CompilerBackendPrimary:
        return "primary"
    if kind == CompilerBackend2:
        return "backend2"
    panic("compiler request: invalid backend kind")

@borrows
fn CompilerRequestBackendJobsFromText(raw: str): Result[int32] =
    let trimmed = strutil.Strip(raw)
    if Len(trimmed) <= 0:
        return Ok[int32](1)
    let parsed = strutil.ParseInt(trimmed)
    if parsed < 1:
        return Err[int32](Fmt" compiler: unsupported --backend-jobs: {trimmed}")
    return Ok[int32](parsed)

fn CompilerRequestInvalidateSeal(req: var CompilerRequest) =
    req.backendRequestActionCid = layout.FixedBytes32()
    req.backendRequestCid = layout.FixedBytes32()
    req.sealed = false

fn CompilerRequestWithSourcePath(req: CompilerRequest,
                                  sourcePath: str): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.sourcePath = sourcePath
    return out

fn CompilerRequestWithSymbolVisibility(req: CompilerRequest,
                                         symbolVisibility: str): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.symbolVisibility = symbolVisibility
    return out

fn CompilerRequestWithBrowserBridgeObject(req: CompilerRequest,
                                            browserBridgeObjectPath: str): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.browserBridgeObjectPath = strutil.Strip(browserBridgeObjectPath)
    return out

fn CompilerRequestWithExportRootSymbols(req: CompilerRequest,
                                          roots: str[]): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.exportRootSymbols = []
    for i in 0..<roots.len:
        let root = strutil.Strip(roots[i])
        if Len(root) > 0:
            add(out.exportRootSymbols, root)
    return out

fn CompilerRequestWithProviderObjectPaths(req: CompilerRequest,
                                           paths: str[]): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.providerObjectPaths = []
    for i in 0..<paths.len:
        let path = strutil.Strip(paths[i])
        if Len(path) > 0:
            add(out.providerObjectPaths, path)
    return out

fn CompilerRequestWithRuntimeProviderBundle(req: CompilerRequest,
                                             bundle: str): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.runtimeProviderBundle = strutil.Strip(bundle)
    return out

fn CompilerRequestWithMode(req: CompilerRequest,
                            compileMode: str): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.compileMode = strutil.Strip(compileMode)
    return out

fn CompilerRequestWithJobCount(req: CompilerRequest,
                                jobCount: int32): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    if jobCount > 0:
        out.jobCount = jobCount
    else:
        out.jobCount = 1
    return out

fn CompilerRequestWithCacheDisabled(req: CompilerRequest,
                                     disabled: bool): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.cacheDisabled = disabled
    return out

fn CompilerRequestWithCompositionEvidence(
        req: CompilerRequest,
        manifestSchema: str,
        manifestSha256: str,
        kernelManifestSha256: str,
        compositionKind: str,
        entrySource: str,
        pluginCanonicalTriple: str,
        declaredSourcePaths: str[],
        declaredSourcesSha256: str,
        sourceClosureCount: int32,
        sourceClosureSha256: str): CompilerRequest =
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.compositionManifestSchema = manifestSchema
    out.compositionManifestSha256 = manifestSha256
    out.compositionKernelManifestSha256 = kernelManifestSha256
    out.compositionKind = compositionKind
    out.compositionEntrySource = entrySource
    out.compositionPluginCanonicalTriple = pluginCanonicalTriple
    out.compositionDeclaredSourcePaths = declaredSourcePaths
    out.compositionDeclaredSourcesSha256 = declaredSourcesSha256
    out.compositionSourceClosureCount = sourceClosureCount
    out.compositionSourceClosureSha256 = sourceClosureSha256
    return out

@borrows
fn CompilerExactFunctionNormalizePath(rootDir: str,
                                       raw: str): str =
    let trimmed = strutil.Strip(raw)
    if Len(trimmed) <= 0:
        return ""
    for i in 0..<Len(trimmed):
        if trimmed[i] == '\n' || trimmed[i] == '\r' || trimmed[i] == '\0':
            return ""
    let absolute = chengpath.PathAbsolute(rootDir,
                                          chengpath.PathSlashNormalized(trimmed))
    let hostPath = chengpath.PathSlashNormalized(chengpath.PathHostFilePath(absolute))
    var segments: str[]
    var segmentStart: int32
    for i in 0..<(Len(hostPath) + 1):
        if i < Len(hostPath) && hostPath[i] != '/':
            continue
        if i > segmentStart:
            let segment = strings.SliceBytes(hostPath,
                                             segmentStart,
                                             i - segmentStart)
            if segment == "..":
                return ""
            if segment != ".":
                add(segments, strings.CloneStr(segment))
        segmentStart = i + 1
    let joined = strutil.Join(segments, "/")
    if Len(hostPath) > 0 && hostPath[0] == '/':
        return Fmt"/{joined}"
    return joined

@borrows
fn CompilerExactFunctionNormalizeName(raw: str): str =
    let trimmed = strutil.Strip(raw)
    for i in 0..<Len(trimmed):
        if trimmed[i] == '\n' || trimmed[i] == '\r':
            return ""
    return trimmed

fn CompilerRequestWithExactFunction(req: CompilerRequest,
                                     workspaceRoot: str,
                                     sourcePathRaw: str,
                                     functionNameRaw: str,
                                     driverPathRaw: str): Result[CompilerRequest] =
    let sourceText = strutil.Strip(sourcePathRaw)
    let functionText = strutil.Strip(functionNameRaw)
    let driverText = strutil.Strip(driverPathRaw)
    let anyPresent = Len(sourceText) > 0 ||
                     Len(functionText) > 0 ||
                     Len(driverText) > 0
    if !anyPresent:
        return Ok[CompilerRequest](req)
    if Len(sourceText) <= 0:
        return Err[CompilerRequest](" compiler: --exact-function-source is required with exact-function reporting")
    if Len(functionText) <= 0:
        return Err[CompilerRequest](" compiler: --exact-function-name is required with exact-function reporting")
    if Len(driverText) <= 0:
        return Err[CompilerRequest](" compiler: --exact-function-driver is required with exact-function reporting")
    if Len(req.reportPath) <= 0:
        return Err[CompilerRequest](" compiler: --report-out is required with exact-function reporting")
    let sourcePath = CompilerExactFunctionNormalizePath(
        share(workspaceRoot), sourceText)
    if Len(sourcePath) <= 0:
        return Err[CompilerRequest](" compiler: invalid --exact-function-source")
    let functionName = CompilerExactFunctionNormalizeName(functionText)
    if Len(functionName) <= 0:
        return Err[CompilerRequest](" compiler: invalid --exact-function-name")
    let driverPath = CompilerExactFunctionNormalizePath(workspaceRoot, driverText)
    if Len(driverPath) <= 0:
        return Err[CompilerRequest](" compiler: invalid --exact-function-driver")
    var out = req
    CompilerRequestInvalidateSeal(out)
    out.exactFunctionSourcePath = sourcePath
    out.exactFunctionName = functionName
    out.exactFunctionDriverPath = driverPath
    return Ok[CompilerRequest](out)

@borrows
fn CompilerRequestExactFunctionEnabled(req: CompilerRequest): bool =
    return Len(req.exactFunctionSourcePath) > 0 &&
           Len(req.exactFunctionName) > 0 &&
           Len(req.exactFunctionDriverPath) > 0

@borrows
@borrow_result
fn CompilerRequestExactFunctionSourcePath(req: CompilerRequest): str =
    return req.exactFunctionSourcePath

@borrows
@borrow_result
fn CompilerRequestExactFunctionName(req: CompilerRequest): str =
    return req.exactFunctionName

@borrows
@borrow_result
fn CompilerRequestExactFunctionDriverPath(req: CompilerRequest): str =
    return req.exactFunctionDriverPath

@borrows
fn CompilerExportRootSymbolsFromText(raw: str): str[] =
    var out: str[]
    let trimmed = strutil.Strip(raw)
    let n = Len(trimmed)
    if n <= 0:
        return out
    var start: int32
    var i: int32
    while i <= n:
        var boundary = false
        if i == n:
            boundary = true
        elif trimmed[i] == ',':
            boundary = true
        if boundary:
            if i > start:
                let item = strutil.Strip(strings.SliceBytes(trimmed, start, i - start))
                if Len(item) > 0:
                    add(out, item)
            start = i + 1
        i = i + 1
    return out

@borrows
fn CompilerProviderObjectPathsFromText(raw: str): str[] =
    return CompilerExportRootSymbolsFromText(raw)

fn compilerRequestAppendU32BE(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, int32(value & 255))

fn compilerRequestAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    compilerRequestAppendU32BE(buf, int64(4))
    compilerRequestAppendU32BE(buf, int64(value))

@borrows
fn compilerRequestAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    compilerRequestAppendU32BE(buf, int64(value.len))
    for textIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[textIndex])

@borrows
fn compilerRequestAppendFixed32(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    compilerRequestAppendU32BE(buf, int64(32))
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn compilerRequestSha256TextValid(value: str): bool =
    if value.len != 64:
        return false
    var nonZero = false
    for i in 0..<value.len:
        let ch = value[i]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
        if ch != '0':
            nonZero = true
    return nonZero

@borrows
fn CompilerRequestCompositionEvidenceStrictValid(
        req: CompilerRequest): bool =
    if req.compositionManifestSchema.len <= 0:
        return req.compositionManifestSha256.len == 0 &&
            req.compositionKernelManifestSha256.len == 0 &&
            req.compositionKind.len == 0 &&
            req.compositionEntrySource.len == 0 &&
            req.compositionPluginCanonicalTriple.len == 0 &&
            req.compositionDeclaredSourcePaths.len == 0 &&
            req.compositionDeclaredSourcesSha256.len == 0 &&
            req.compositionSourceClosureCount == 0 &&
            req.compositionSourceClosureSha256.len == 0
    if req.compositionManifestSchema != "cheng.composition.v1" ||
       !compilerRequestSha256TextValid(
           req.compositionManifestSha256) ||
       !compilerRequestSha256TextValid(
           req.compositionDeclaredSourcesSha256) ||
       req.compositionEntrySource.len <= 0 ||
       req.compositionDeclaredSourcePaths.len <= 0:
        return false
    let sourceBundlePending =
        req.compositionSourceClosureCount == 0 &&
        req.compositionSourceClosureSha256.len == 0
    let sourceBundleBound =
        req.compositionSourceClosureCount > 0 &&
        compilerRequestSha256TextValid(
            req.compositionSourceClosureSha256)
    if !sourceBundlePending && !sourceBundleBound:
        return false
    if req.compositionKind == "kernel-only":
        return req.compositionKernelManifestSha256.len == 0 &&
            req.compositionPluginCanonicalTriple.len == 0
    if req.compositionKind == "plugin":
        return compilerRequestSha256TextValid(
                   req.compositionKernelManifestSha256) &&
            req.compositionPluginCanonicalTriple.len > 0
    return false

@borrows
fn CompilerRequestBackendActionCid(
        req: CompilerRequest): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    let domain = "cheng.compiler.backend_request.action"
    compilerRequestAppendText(buf, domain)
    compilerRequestAppendI32(buf, int32(req.backendKind))
    compilerRequestAppendI32(buf, req.jobCount)
    compilerRequestAppendI32(buf, int32(req.emitKind))
    compilerRequestAppendI32(buf, req.providerObjectPaths.len)
    for providerIndex in 0..<req.providerObjectPaths.len:
        let providerPath = req.providerObjectPaths[providerIndex]
        compilerRequestAppendText(buf, providerPath)
    compilerRequestAppendText(buf, req.runtimeProviderBundle)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn CompilerRequestCid(
        req: CompilerRequest): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(768)
    let domain = "cheng.compiler.request"
    compilerRequestAppendText(buf, domain)
    compilerRequestAppendFixed32(
        buf, req.backendRequestActionCid)
    compilerRequestAppendText(buf, req.rootDir)
    compilerRequestAppendText(buf, req.sourcePath)
    compilerRequestAppendText(buf, req.outputPath)
    compilerRequestAppendText(buf, req.targetTriple)
    compilerRequestAppendText(buf, req.reportPath)
    compilerRequestAppendText(buf, req.symbolVisibility)
    compilerRequestAppendText(buf, req.browserBridgeObjectPath)
    compilerRequestAppendI32(buf, req.exportRootSymbols.len)
    for exportIndex in 0..<req.exportRootSymbols.len:
        let exportRoot = req.exportRootSymbols[exportIndex]
        compilerRequestAppendText(buf, exportRoot)
    compilerRequestAppendText(buf, req.compileMode)
    compilerRequestAppendText(buf, req.exactFunctionSourcePath)
    compilerRequestAppendText(buf, req.exactFunctionName)
    compilerRequestAppendText(buf, req.exactFunctionDriverPath)
    compilerRequestAppendText(buf, req.compositionManifestSchema)
    compilerRequestAppendText(buf, req.compositionManifestSha256)
    compilerRequestAppendText(
        buf, req.compositionKernelManifestSha256)
    compilerRequestAppendText(buf, req.compositionKind)
    compilerRequestAppendText(buf, req.compositionEntrySource)
    compilerRequestAppendText(
        buf, req.compositionPluginCanonicalTriple)
    compilerRequestAppendI32(
        buf, req.compositionDeclaredSourcePaths.len)
    for sourceIndex in 0..<req.compositionDeclaredSourcePaths.len:
        compilerRequestAppendText(
            buf,
            req.compositionDeclaredSourcePaths[sourceIndex])
    compilerRequestAppendText(
        buf, req.compositionDeclaredSourcesSha256)
    compilerRequestAppendI32(
        buf, req.compositionSourceClosureCount)
    compilerRequestAppendText(
        buf, req.compositionSourceClosureSha256)
    if req.cacheDisabled:
        compilerRequestAppendI32(buf, 1)
    else:
        compilerRequestAppendI32(buf, 0)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn CompilerAdmittedCacheKeyDomain(): str =
    return "csg_core.production.admitted_cache_key"

@borrows
fn CompilerAdmittedCacheKeyInto(executionInputCid: str,
                                 compilerExecutableCid: str,
                                 outputContractCid: str,
                                 outKey: var layout.FixedBytes32): bool =
    # cacheKeyCid = H("csg_core.production.admitted_cache_key",
    #   executionInputCid, compilerExecutableCid, outputContractCid).
    # Canonical transcript: domain + length-prefixed CID fields, SHA-256.
    # Strict: empty or aliased CIDs are a contract violation, never a miss.
    outKey = layout.FixedBytes32()
    if Len(executionInputCid) <= 0 || Len(compilerExecutableCid) <= 0 ||
       Len(outputContractCid) <= 0:
        return false
    if executionInputCid == compilerExecutableCid ||
       executionInputCid == outputContractCid ||
       compilerExecutableCid == outputContractCid:
        return false
    var buf = layout.ByteBufInit(1024)
    compilerRequestAppendText(buf, CompilerAdmittedCacheKeyDomain())
    compilerRequestAppendText(buf, executionInputCid)
    compilerRequestAppendText(buf, compilerExecutableCid)
    compilerRequestAppendText(buf, outputContractCid)
    outKey = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return !layout.FixedBytes32Equal(outKey, layout.FixedBytes32())

fn CompilerRequestSeal(out: var CompilerRequest) =
    if out.sealed ||
       out.jobCount < 1 ||
       !CompilerRequestCompositionEvidenceStrictValid(out) ||
       (out.backendKind != CompilerBackendPrimary &&
        out.backendKind != CompilerBackend2) ||
       (out.emitKind != EmitExe &&
        out.emitKind != EmitObj &&
        out.emitKind != EmitShared):
        panic("compiler request: invalid seal preimage")
    out.backendRequestActionCid = CompilerRequestBackendActionCid(out)
    out.backendRequestCid = CompilerRequestCid(out)
    if layout.FixedBytes32Equal(
           out.backendRequestActionCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           out.backendRequestCid, layout.FixedBytes32()):
        panic("compiler request: zero seal cid")
    out.sealed = true

@borrows
fn CompilerRequestStrictValidateSealed(
        req: CompilerRequest): bool =
    if !req.sealed:
        return false
    if req.jobCount < 1 ||
       !CompilerRequestCompositionEvidenceStrictValid(req) ||
       (req.backendKind != CompilerBackendPrimary &&
        req.backendKind != CompilerBackend2) ||
       (req.emitKind != EmitExe &&
        req.emitKind != EmitObj &&
        req.emitKind != EmitShared):
        return false
    let expectedActionCid =
        CompilerRequestBackendActionCid(req)
    if layout.FixedBytes32Equal(
           expectedActionCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           expectedActionCid, req.backendRequestActionCid):
        return false
    let expectedRequestCid = CompilerRequestCid(req)
    return !layout.FixedBytes32Equal(
               expectedRequestCid, layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               expectedRequestCid, req.backendRequestCid)

