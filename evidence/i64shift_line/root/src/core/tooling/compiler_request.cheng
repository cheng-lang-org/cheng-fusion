@borrows
@borrow_result
fn CompilerRequestCompositionEntrySource(
        req: CompilerRequest): str =
    return req.compositionEntrySource

@borrows
@borrow_result
fn CompilerRequestCompositionPluginCanonicalTriple(
        req: CompilerRequest): str =
    return req.compositionPluginCanonicalTriple

@borrows
@borrow_result
fn CompilerRequestCompositionDeclaredSourcePaths(
        req: CompilerRequest): str[] =
    return req.compositionDeclaredSourcePaths

@borrows
@borrow_result
fn CompilerRequestCompositionDeclaredSourcesSha256(
        req: CompilerRequest): str =
    return req.compositionDeclaredSourcesSha256

@borrows
fn CompilerRequestCompositionSourceBundleBound(
        req: CompilerRequest): bool =
    return CompilerRequestCompositionPresent(req) &&
        req.compositionSourceClosureCount > 0 &&
        compilerRequestSha256TextValid(
            req.compositionSourceClosureSha256)

@borrows
fn CompilerRequestCompositionSourceClosureCount(
        req: CompilerRequest): int32 =
    return req.compositionSourceClosureCount

@borrows
@borrow_result
fn CompilerRequestCompositionSourceClosureSha256(
        req: CompilerRequest): str =
    return req.compositionSourceClosureSha256

@borrows
fn CompilerRequestCidText(req: CompilerRequest): str =
    if !CompilerRequestStrictValidateSealed(req):
        return ""
    return Fmt"sha256:{layout.FixedBytes32Hex(req.backendRequestCid)}"

@borrows
fn CompilerRequestBackendKind(
        req: CompilerRequest): CompilerBackendKind =
    return req.backendKind

@borrows
fn CompilerRequestJobCount(req: CompilerRequest): int32 =
    if req.jobCount <= 0:
        return 1
    return req.jobCount

@borrows
fn CompilerReadFlagOrDefault(args: str[],
                               key: str,
                               defaultValue: str): str =
    for i in 0..<args.len:
        let arg: str = args[i]
        let colonKey = Fmt"{key}:"
        let eqKey = Fmt"{key}="
        if strutil.StartsWith(arg, colonKey):
            return strings.CloneStr(strings.DropPrefix(arg, colonKey))
        if strutil.StartsWith(arg, eqKey):
            return strings.CloneStr(strings.DropPrefix(arg, eqKey))
        if arg == key && i + 1 < args.len:
            return strings.CloneStr(args[i + 1])
    return strings.CloneStr(defaultValue)

@borrows
fn CompilerReadFlagAliasOrDefault(args: str[],
                                    key: str,
                                    aliasKey: str,
                                    defaultValue: str): str =
    let value = CompilerReadFlagOrDefault(args, key, "")
    if Len(value) > 0:
        return value
    if Len(aliasKey) > 0:
        let aliasValue = CompilerReadFlagOrDefault(args, aliasKey, "")
        if Len(aliasValue) > 0:
            return aliasValue
    return strings.CloneStr(defaultValue)

fn CompilerDefaultTargetTriple(): str =
    let chengTarget = os.GetEnv("CHENG_TARGET")
    if Len(chengTarget) > 0:
        return chengTarget
    let backendTarget = os.GetEnv("BACKEND_TARGET")
    if Len(backendTarget) > 0:
        return backendTarget
    return tmat.TargetTripleDarwinA64()

fn CompilerEmitText(kind: CompilerEmit): str =
    if kind == EmitExe:
        return "exe"
    if kind == EmitObj:
        return "obj"
    if kind == EmitShared:
        return "shared"
    return "unknown"

fn CompilerEmitOk(value: CompilerEmit): Result[CompilerEmit] =
    return Ok[CompilerEmit](value)

@borrows
fn CompilerEmitFromText(raw: str): Result[CompilerEmit] =
    if raw == "exe":
        return CompilerEmitOk(EmitExe)
    if raw == "obj":
        return CompilerEmitOk(EmitObj)
    if raw == "shared":
        return CompilerEmitOk(EmitShared)
    let message = Fmt" compiler: unsupported --emit: {raw}"
    return Err[CompilerEmit](message)

@borrows
@borrow_result
fn CompilerDefaultPackageRoot(workspaceRoot: str): str =
    return workspaceRoot

@borrows
@borrow_result
fn CompilerStringIdentity(value: str): str =
    return value

@borrows
fn CompilerPathIsWithinDir(pathRaw: str,
                             dirRaw: str): bool =
    let path = chengpath.PathTrim(strings.CloneStr(pathRaw))
    var dir = chengpath.PathTrim(strings.CloneStr(dirRaw))
    if Len(path) <= 0 || Len(dir) <= 0:
        return false
    while strings.HasSuffix(dir, "/"):
        dir = chengpath.TextSlice(dir, 0, dir.len - 1)
    if path == dir:
        return true
    let dirPrefix = Fmt"{dir}/"
    return strutil.StartsWith(path, dirPrefix)

@borrows
fn CompilerPackageManifestExists(dirRaw: str): bool =
    let dir = chengpath.PathTrim(strings.CloneStr(dirRaw))
    if Len(dir) <= 0:
        return false
    let manifestPath = chengpath.PathJoin(dir, "cheng-package.toml")
    if !os.FileExists(manifestPath):
        return false
    let manifestText = chengpath.ReadTextFile("", manifestPath)
    return strutil.Contains(manifestText, "package_id")

@borrows
fn CompilerFindNearestPackageRoot(baseRootRaw: str,
                                    sourcePathRaw: str): str =
    let baseRoot = chengpath.PathTrim(baseRootRaw)
    let sourcePath = chengpath.PathTrim(sourcePathRaw)
    if Len(baseRoot) <= 0 || Len(sourcePath) <= 0:
        return ""
    var cursor = chengpath.PathParentDir(sourcePath)
    while Len(cursor) > 0:
        if cursor != baseRoot && !CompilerPathIsWithinDir(cursor, baseRoot):
            break
        if CompilerPackageManifestExists(cursor):
            return cursor
        let parent = chengpath.PathParentDir(cursor)
        if Len(parent) <= 0 || parent == cursor:
            break
        cursor = parent
    if CompilerPackageManifestExists(baseRoot):
        return baseRoot
    return ""

@borrows
fn CompilerResolvePackageRoot(workspaceRoot: str,
                                sourcePathRaw: str,
                                packageRootRaw: str): str =
    let packageRoot = CompilerExactFunctionNormalizePath(
        workspaceRoot, packageRootRaw)
    if Len(packageRoot) <= 0:
        return CompilerStringIdentity(packageRoot)
    let baseRoot = packageRoot
    let sourcePath = CompilerExactFunctionNormalizePath(
        workspaceRoot, sourcePathRaw)
    if Len(sourcePath) <= 0 || !CompilerPathIsWithinDir(sourcePath, baseRoot):
        return CompilerStringIdentity(baseRoot)
    let nearestPackageRoot = CompilerFindNearestPackageRoot(
        share(baseRoot), sourcePath)
    if Len(nearestPackageRoot) > 0:
        return CompilerExactFunctionNormalizePath("", nearestPackageRoot)
    return CompilerStringIdentity(baseRoot)

@borrows
fn CompilerWorldHeadFromArgs(args: str[]): str =
    return CompilerReadFlagOrDefault(args, "--world-head", "")

@borrows
fn CompilerLockPathFromArgs(args: str[]): str =
    return CompilerReadFlagOrDefault(args, "--lock", "")

@borrows
fn CompilerBaselineSurfacePathFromArgs(args: str[]): str =
    return CompilerReadFlagOrDefault(args, "--baseline-surface", "")

@borrows
fn CompilerBaselineReceiptPathFromArgs(args: str[]): str =
    return CompilerReadFlagOrDefault(args, "--baseline-receipt", "")

@borrows
fn CompilerBaselineCsgPathFromArgs(args: str[]): str =
    return CompilerReadFlagOrDefault(args, "--baseline-csg", "")

@borrows
fn CompilerLegacyInPathFromArgs(args: str[]): str =
    return CompilerReadFlagOrDefault(args, "--legacy-in", "")

@borrows
fn CompilerChannelFromArgs(args: str[]): str =
    let channel = CompilerReadFlagOrDefault(args, "--channel", "")
    if Len(channel) > 0:
        return channel
    return "stable"

@borrows
fn CompilerCacheDisabledFromArgs(args: str[]): Result[bool] =
    # --cache-disabled is the only source of the production three-state
    # "disabled" cache decision; it seals into the request CID.
    for i in 0..<args.len:
        let arg: str = args[i]
        if arg == "--cache-disabled":
            return Ok[bool](true)
        if strutil.StartsWith(arg, "--cache-disabled:"):
            let value = strutil.Strip(
                strings.DropPrefix(arg, "--cache-disabled:"))
            if value == "1" || value == "true" || value == "yes" ||
               value == "on":
                return Ok[bool](true)
            if value == "0" || value == "false" || value == "no" ||
               value == "off":
                return Ok[bool](false)
            return Err[bool](
                Fmt" compiler: unsupported --cache-disabled value: {value}")
        if strutil.StartsWith(arg, "--cache-disabled="):
            let value = strutil.Strip(
                strings.DropPrefix(arg, "--cache-disabled="))
            if value == "1" || value == "true" || value == "yes" ||
               value == "on":
                return Ok[bool](true)
            if value == "0" || value == "false" || value == "no" ||
               value == "off":
                return Ok[bool](false)
            return Err[bool](
                Fmt" compiler: unsupported --cache-disabled value: {value}")
    return Ok[bool](false)

fn CompilerRequestOk(value: CompilerRequest): Result[CompilerRequest] =
    return Ok[CompilerRequest](value)

fn CompilerRequestFromArgsForCommand(workspaceRoot: str,
                                       args: str[],
                                       requireOutput: bool): Result[CompilerRequest] =
    let backendText =
        CompilerReadFlagOrDefault(args, "--backend", "primary")
    let backendKindRes = CompilerBackendKindFromText(backendText)
    if IsErr(backendKindRes):
        return Err[CompilerRequest](Error(backendKindRes))
    let sourcePath = CompilerReadFlagOrDefault(args, "--in", "")
    if Len(sourcePath) <= 0:
        return Err[CompilerRequest](" compiler: missing --in")
    var packageRootRaw = CompilerReadFlagOrDefault(args, "--root", "")
    if Len(packageRootRaw) <= 0:
        packageRootRaw = CompilerDefaultPackageRoot(share(workspaceRoot))
    let packageRoot = CompilerResolvePackageRoot(
        share(workspaceRoot), share(sourcePath), packageRootRaw)
    let outputPath = CompilerReadFlagOrDefault(args, "--out", "")
    if requireOutput && Len(outputPath) <= 0:
        return Err[CompilerRequest](" compiler: missing --out")
    var targetTriple = CompilerReadFlagOrDefault(args, "--target", "")
    if Len(targetTriple) <= 0:
        targetTriple = CompilerDefaultTargetTriple()
    let emitText = CompilerReadFlagOrDefault(args, "--emit", "exe")
    let emitKindRes = CompilerEmitFromText(emitText)
    if IsErr(emitKindRes):
        return Err[CompilerRequest](Error(emitKindRes))
    let reportPath = CompilerReadFlagOrDefault(args, "--report-out", "")
    let symbolVisibilityRes = CompilerSymbolVisibilityFromText(CompilerReadFlagOrDefault(args, "--symbol-visibility", ""))
    if IsErr(symbolVisibilityRes):
        return Err[CompilerRequest](Error(symbolVisibilityRes))
    let browserBridgeObjectPath = CompilerReadFlagOrDefault(args, "--browser-bridge-object", "")
    let exportRootsText = CompilerReadFlagOrDefault(args, "--export-roots", "")
    if os.GetEnv("CHENG_EXP_DBG") != "":
        os.WriteLine(os.GetStdout(), Fmt"expdbg reqroots text=[{exportRootsText}] argc={strings.IntToStr(args.len)}")
    let providerObjectsText = CompilerReadFlagOrDefault(args, "--provider-objects", "")
    let runtimeProviderBundle = CompilerReadFlagOrDefault(args, "--runtime-provider-bundle", "")
    let exactFunctionSourcePath = CompilerReadFlagOrDefault(args, "--exact-function-source", "")
    let exactFunctionName = CompilerReadFlagOrDefault(args, "--exact-function-name", "")
    let exactFunctionDriverPath = CompilerReadFlagOrDefault(args, "--exact-function-driver", "")
    let backendJobsText =
        CompilerReadFlagOrDefault(args, "--backend-jobs", "1")
    let jobCountRes =
        CompilerRequestBackendJobsFromText(backendJobsText)
    if IsErr(jobCountRes):
        return Err[CompilerRequest](Error(jobCountRes))
    let cacheDisabledRes = CompilerCacheDisabledFromArgs(args)
    if IsErr(cacheDisabledRes):
        return Err[CompilerRequest](Error(cacheDisabledRes))
    let baseRequest = CompilerRequestNew(packageRoot, sourcePath, outputPath, targetTriple, Value(emitKindRes), reportPath)
    let visibleRequest = CompilerRequestWithSymbolVisibility(baseRequest, Value(symbolVisibilityRes))
    let bridgeRequest = CompilerRequestWithBrowserBridgeObject(visibleRequest, browserBridgeObjectPath)
    let exportRequest = CompilerRequestWithExportRootSymbols(bridgeRequest, CompilerExportRootSymbolsFromText(exportRootsText))
    let exactRequestRes = CompilerRequestWithExactFunction(exportRequest,
                                                           workspaceRoot,
                                                           exactFunctionSourcePath,
                                                           exactFunctionName,
                                                           exactFunctionDriverPath)
    if IsErr(exactRequestRes):
        return Err[CompilerRequest](Error(exactRequestRes))
    var out = Value(exactRequestRes)
    out.backendKind = Value(backendKindRes)
    out.jobCount = Value(jobCountRes)
    out.emitKind = Value(emitKindRes)
    out.providerObjectPaths = CompilerProviderObjectPathsFromText(providerObjectsText)
    out.runtimeProviderBundle = runtimeProviderBundle
    out.cacheDisabled = Value(cacheDisabledRes)
    CompilerRequestSeal(out)
    return CompilerRequestOk(out)

fn CompilerRequestFromArgs(workspaceRoot: str,
                             args: str[]): Result[CompilerRequest] =
    return CompilerRequestFromArgsForCommand(workspaceRoot, args, true)
