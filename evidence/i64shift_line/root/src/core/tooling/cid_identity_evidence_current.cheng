type
    CidIdentityEvidenceCurrentFileIdentity =
        size: int64
        mode: int32
        device: uint64
        inode: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        changeVersion: uint64
        linkCount: uint64

@importc("open")
fn CidIdentityEvidenceCurrentOpenReadBridge(
        path: cstring,
        flags: int32,
        mode: int32): int32

@importc("close")
fn CidIdentityEvidenceCurrentCloseBridge(fd: int32): int32

@importc("cheng_host_fstat_identity")
fn CidIdentityEvidenceCurrentFstatIdentityBridge(
        fd: int32,
        outSize: var int64,
        outMode: var int32,
        outDevice: var uint64,
        outInode: var uint64,
        outMtimeSec: var int64,
        outMtimeNsec: var int64,
        outCtimeSec: var int64,
        outCtimeNsec: var int64,
        outChangeVersion: var uint64): int32

@importc("cheng_host_fstat_nlink")
fn CidIdentityEvidenceCurrentFstatNlinkBridge(
        fd: int32,
        outLinkCount: var uint64): int32

const
    CidIdentityEvidenceCurrentProgramPath = "/cheng-hardcap/current-driver"
    CidIdentityEvidenceCurrentCandidatePath = "/cheng-cid/candidate"
    CidIdentityEvidenceCurrentRepositoryPath = "/cheng-current-source/repo"
    CidIdentityEvidenceCurrentWorkPath = "/dev/shm/cheng-cid-case"
    CidIdentityEvidenceCurrentTarget = "x86_64-unknown-linux-gnu"
    CidIdentityEvidenceCurrentArgc = 4
    CidIdentityEvidenceCurrentLinuxOpenReadFlags = 655360
    CidIdentityEvidenceCurrentUstarBlockBytes = 512
    CidIdentityEvidenceCurrentUstarRecordBytes = 10240

@borrows
fn CidIdentityEvidenceCurrentCaseValid(caseId: str): bool =
    return caseId == "source-bundle-entry" ||
           caseId == "zero-byte-import" ||
           caseId == "source-csg-binding" ||
           caseId == "csg-atomic-consume" ||
           caseId == "migration-cross-root-fixed-point" ||
           caseId == "mirror-atomic-install"

@borrows
fn CidIdentityEvidenceCurrentSha256TextValid(value: str): bool =
    if value.len != 64:
        return false
    for index in 0..<value.len:
        let ch = value[index]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn CidIdentityEvidenceCurrentValidateArguments(
        argc: int32,
        command: str,
        caseId: str,
        candidateSha256: str,
        err: var str): bool =
    if argc != CidIdentityEvidenceCurrentArgc:
        err = "CID current driver: exact argc=4 required"
        return false
    if command != "run-case":
        err = "CID current driver: exact run-case command required"
        return false
    if !CidIdentityEvidenceCurrentCaseValid(caseId):
        err = "CID current driver: unknown case id"
        return false
    if !CidIdentityEvidenceCurrentSha256TextValid(candidateSha256):
        err = "CID current driver: candidate sha256 must be 64 lowercase hex"
        return false
    err = ""
    return true

fn CidIdentityEvidenceCurrentFileIdentityRead(
        fd: int32,
        requireExecutable: bool,
        requireNonEmpty: bool,
        out: var CidIdentityEvidenceCurrentFileIdentity): bool =
    if fd < 0:
        return false
    var next: CidIdentityEvidenceCurrentFileIdentity
    let rc = CidIdentityEvidenceCurrentFstatIdentityBridge(
        fd,
        next.size,
        next.mode,
        next.device,
        next.inode,
        next.mtimeSec,
        next.mtimeNsec,
        next.ctimeSec,
        next.ctimeNsec,
        next.changeVersion)
    let linkRc = CidIdentityEvidenceCurrentFstatNlinkBridge(
        fd, next.linkCount)
    if rc != 0 ||
       linkRc != 0 ||
       next.size < 0 ||
       (requireNonEmpty && next.size == 0) ||
       (next.mode & int32(61440)) != int32(32768) ||
       (requireExecutable &&
        (next.mode & int32(73)) == 0) ||
       next.device == uint64(0) ||
       next.inode == uint64(0) ||
       next.linkCount != uint64(1):
        return false
    out = next
    return true

fn CidIdentityEvidenceCurrentFileIdentityEqual(
        left: CidIdentityEvidenceCurrentFileIdentity,
        right: CidIdentityEvidenceCurrentFileIdentity): bool =
    return left.size == right.size &&
           left.mode == right.mode &&
           left.device == right.device &&
           left.inode == right.inode &&
           left.mtimeSec == right.mtimeSec &&
           left.mtimeNsec == right.mtimeNsec &&
           left.ctimeSec == right.ctimeSec &&
           left.ctimeNsec == right.ctimeNsec &&
           left.changeVersion == right.changeVersion &&
           left.linkCount == right.linkCount

fn CidIdentityEvidenceCurrentStableExecutableSha256Into(
        path: str,
        outSha256: var str,
        err: var str): bool =
    outSha256 = ""
    let canonicalBeforeRes = fs.Realpath(path)
    if IsErr(canonicalBeforeRes) ||
       Value(canonicalBeforeRes) != path:
        err = "CID current driver: executable path is not canonical"
        return false
    let fd = CidIdentityEvidenceCurrentOpenReadBridge(
        StrToCStringTemp(path),
        CidIdentityEvidenceCurrentLinuxOpenReadFlags,
        int32(0))
    if fd < 0:
        err = "CID current driver: executable open failed"
        return false
    var before: CidIdentityEvidenceCurrentFileIdentity
    var after: CidIdentityEvidenceCurrentFileIdentity
    var digest: layout.FixedBytes32
    var pinnedOk =
        CidIdentityEvidenceCurrentFileIdentityRead(
            fd, true, true, before)
    if pinnedOk:
        pinnedOk =
            sexecrt.SystemLinkExecRuntimeFileSha256Into(
                "", Fmt"/dev/fd/{fd}", digest, err)
    if pinnedOk:
        pinnedOk =
            CidIdentityEvidenceCurrentFileIdentityRead(
                fd, true, true, after)
    let closeRc = CidIdentityEvidenceCurrentCloseBridge(fd)
    if !pinnedOk ||
       closeRc != 0 ||
       !CidIdentityEvidenceCurrentFileIdentityEqual(
           before, after):
        err = "CID current driver: executable identity changed during pinned read"
        return false
    let verifyFd = CidIdentityEvidenceCurrentOpenReadBridge(
        StrToCStringTemp(path),
        CidIdentityEvidenceCurrentLinuxOpenReadFlags,
        int32(0))
    if verifyFd < 0:
        err = "CID current driver: executable reopen failed"
        return false
    var current: CidIdentityEvidenceCurrentFileIdentity
    let currentOk =
        CidIdentityEvidenceCurrentFileIdentityRead(
            verifyFd, true, true, current)
    let verifyCloseRc =
        CidIdentityEvidenceCurrentCloseBridge(verifyFd)
    let canonicalAfterRes = fs.Realpath(path)
    if !currentOk ||
       verifyCloseRc != 0 ||
       IsErr(canonicalAfterRes) ||
       Value(canonicalAfterRes) != path ||
       !CidIdentityEvidenceCurrentFileIdentityEqual(
           before, current):
        err = "CID current driver: executable identity is not stable"
        return false
    outSha256 = layout.FixedBytes32Hex(digest)
    if !CidIdentityEvidenceCurrentSha256TextValid(outSha256):
        err = "CID current driver: executable sha256 unavailable"
        return false
    err = ""
    return true

fn CidIdentityEvidenceCurrentStableRegularSizeInto(
        path: str,
        outSize: var int64,
        err: var str): bool =
    outSize = Int64(-1)
    let canonicalBeforeRes = fs.Realpath(path)
    if IsErr(canonicalBeforeRes) ||
       Value(canonicalBeforeRes) != path:
        err = "CID current driver: payload path is not canonical"
        return false
    let fd = CidIdentityEvidenceCurrentOpenReadBridge(
        StrToCStringTemp(path),
        CidIdentityEvidenceCurrentLinuxOpenReadFlags,
        int32(0))
    if fd < 0:
        err = "CID current driver: payload open failed"
        return false
    var identity: CidIdentityEvidenceCurrentFileIdentity
    let identityOk =
        CidIdentityEvidenceCurrentFileIdentityRead(
            fd, false, false, identity)
    let closeRc = CidIdentityEvidenceCurrentCloseBridge(fd)
    let canonicalAfterRes = fs.Realpath(path)
    if !identityOk ||
       closeRc != 0 ||
       IsErr(canonicalAfterRes) ||
       Value(canonicalAfterRes) != path:
        err = "CID current driver: payload identity is not stable regular single-link"
        return false
    outSize = identity.size
    err = ""
    return true

fn CidIdentityEvidenceCurrentStableRegularBytesInto(
        path: str,
        expectedSize: int32,
        outData: var rawbytes.Bytes,
        err: var str): bool =
    outData = rawbytes.EmptyBytes()
    let canonicalBeforeRes = fs.Realpath(path)
    if IsErr(canonicalBeforeRes) ||
       Value(canonicalBeforeRes) != path:
        err = "CID current driver: payload path is not canonical"
        return false
    let fd = CidIdentityEvidenceCurrentOpenReadBridge(
        StrToCStringTemp(path),
        CidIdentityEvidenceCurrentLinuxOpenReadFlags,
        int32(0))
    if fd < 0:
        err = "CID current driver: payload open failed"
        return false
    var before: CidIdentityEvidenceCurrentFileIdentity
    var after: CidIdentityEvidenceCurrentFileIdentity
    var pinnedOk =
        CidIdentityEvidenceCurrentFileIdentityRead(
            fd, false, false, before)
    var data = rawbytes.EmptyBytes()
    if pinnedOk:
        let readRes = os.ReadFileBytesResult(
            Fmt"/dev/fd/{fd}")
        if IsErr(readRes):
            pinnedOk = false
            err = Error(readRes)
        else:
            var readBytes = Value(readRes)
            data = rawbytes.BytesTake(readBytes)
    if pinnedOk:
        pinnedOk =
            CidIdentityEvidenceCurrentFileIdentityRead(
                fd, false, false, after)
    let closeRc = CidIdentityEvidenceCurrentCloseBridge(fd)
    if !pinnedOk ||
       closeRc != 0 ||
       !CidIdentityEvidenceCurrentFileIdentityEqual(
           before, after):
        rawbytes.BytesFree(data)
        err = "CID current driver: payload identity changed during pinned read"
        return false
    let verifyFd = CidIdentityEvidenceCurrentOpenReadBridge(
        StrToCStringTemp(path),
        CidIdentityEvidenceCurrentLinuxOpenReadFlags,
        int32(0))
    if verifyFd < 0:
        rawbytes.BytesFree(data)
        err = "CID current driver: payload reopen failed"
        return false
    var current: CidIdentityEvidenceCurrentFileIdentity
    let currentOk =
        CidIdentityEvidenceCurrentFileIdentityRead(
            verifyFd, false, false, current)
    let verifyCloseRc =
        CidIdentityEvidenceCurrentCloseBridge(verifyFd)
    let canonicalAfterRes = fs.Realpath(path)
    if !currentOk ||
       verifyCloseRc != 0 ||
       IsErr(canonicalAfterRes) ||
       Value(canonicalAfterRes) != path ||
       !CidIdentityEvidenceCurrentFileIdentityEqual(
           before, current) ||
       expectedSize < 0 ||
       rawbytes.BytesLen(data) != expectedSize:
        rawbytes.BytesFree(data)
        err = "CID current driver: payload stable read size or identity mismatch"
        return false
    outData = data
    err = ""
    return true

@borrows
fn CidIdentityEvidenceCurrentBindExecutables(
        programPath: str,
        expectedSha256: str,
        err: var str): bool =
    if programPath != CidIdentityEvidenceCurrentProgramPath:
        err = "CID current driver: unexpected program path"
        return false
    var programSha256: str
    if !CidIdentityEvidenceCurrentStableExecutableSha256Into(
            CidIdentityEvidenceCurrentProgramPath,
            programSha256,
            err):
        return false
    if programSha256 != expectedSha256:
        err = "CID current driver: running executable sha256 mismatch"
        return false
    var candidateSha256: str
    if !CidIdentityEvidenceCurrentStableExecutableSha256Into(
            CidIdentityEvidenceCurrentCandidatePath,
            candidateSha256,
            err):
        return false
    if candidateSha256 != expectedSha256:
        err = "CID current driver: image candidate sha256 mismatch"
        return false
    err = ""
    return true

fn CidIdentityEvidenceCurrentSetEnvironment() =
    os.SetEnv("TMPDIR",
              chengpath.PathJoin(
                  CidIdentityEvidenceCurrentWorkPath, "tmp"))
    os.SetEnv("BACKEND_JOBS", "1")
    os.SetEnv("BACKEND_INCREMENTAL", "0")
    os.SetEnv("BACKEND_MULTI_MODULE_CACHE", "0")
    os.SetEnv("CHENG_DISABLE_PRIMARY_OBJECT_CACHE", "1")
    os.SetEnv("CHENG_NO_BACKEND_DRIVER_HANDOFF", "1")
    os.SetEnv("CHENG_BACKEND_DRIVER_HANDOFF", "0")
    os.SetEnv("CHENG_REQUIRE_PURE_SYSTEM_LINK_EXEC", "1")
    os.SetEnv("CHENG_PROCESS_MAX_RSS_BYTES", "805306368")
    os.SetEnv("CHENG_PROGRESS", "")
    os.SetEnv("CHENG_PROGRESS_OUT", "")

fn CidIdentityEvidenceCurrentPrepareWork(
        payloadRoot: var str,
        caseRoot: var str,
        caseOutput: var str,
        compileReportPath: var str,
        err: var str): bool =
    if fs.Exists(CidIdentityEvidenceCurrentWorkPath):
        err = "CID current driver: work path already exists"
        return false
    let workCreate = fs.Mkdir(
        CidIdentityEvidenceCurrentWorkPath, 448)
    if IsErr(workCreate):
        err = Error(workCreate)
        return false
    payloadRoot = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "payload")
    caseRoot = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "case-root")
    caseOutput = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "case-output")
    compileReportPath = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "case-compile.report")
    let payloadCreate = fs.Mkdir(payloadRoot, 448)
    if IsErr(payloadCreate):
        err = Error(payloadCreate)
        return false
    let tmpCreate = fs.Mkdir(
        chengpath.PathJoin(
            CidIdentityEvidenceCurrentWorkPath, "tmp"),
        448)
    if IsErr(tmpCreate):
        err = Error(tmpCreate)
        return false
    CidIdentityEvidenceCurrentSetEnvironment()
    err = ""
    return true

@borrows
fn CidIdentityEvidenceCurrentCompile(
        programPath: str,
        packageRoot: str,
        sourcePath: str,
        outputPath: str,
        reportPath: str,
        err: var str): bool =
    var req = creq.CompilerRequestNew(
        share(packageRoot),
        share(sourcePath),
        share(outputPath),
        share(CidIdentityEvidenceCurrentTarget),
        creq.EmitExe,
        share(reportPath))
    req = creq.CompilerRequestWithJobCount(req, 1)
    creq.CompilerRequestSeal(req)
    if !creq.CompilerRequestStrictValidateSealed(req):
        err = "CID current driver: formal compile request is not sealed"
        return false
    var plan: sexec.SystemLinkExecPlan
    if !sexec.BuildSystemLinkExecPlanWithWorldAndChannelInto(
            CidIdentityEvidenceCurrentRepositoryPath,
            req,
            "",
            "",
            "",
            "stable",
            plan,
            err):
        return false
    var runtimeResult: sexecrt.SystemLinkExecRuntimeResult
    if !sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
            runtimeResult,
            err,
            CidIdentityEvidenceCurrentRepositoryPath,
            plan,
            programPath):
        return false
    var report = sexec.SystemLinkExecPlanReportBorrowed(plan)
    let runtimeReport =
        sexecrt.SystemLinkExecRuntimeResultReport(runtimeResult)
    if report.len > 0 && report[report.len - 1] != '\n':
        report = strutil.Join([report, "\n"], "")
    report = strutil.Join([report, runtimeReport], "")
    if !chengpath.WriteTextFile(
            CidIdentityEvidenceCurrentRepositoryPath,
            reportPath,
            report):
        err = "CID current driver: formal compile report write failed"
        return false
    let outputCanonicalRes = fs.Realpath(outputPath)
    let reportCanonicalRes = fs.Realpath(reportPath)
    if IsErr(outputCanonicalRes) ||
       IsErr(reportCanonicalRes) ||
       Value(outputCanonicalRes) != outputPath ||
       Value(reportCanonicalRes) != reportPath ||
       !fs.IsFile(outputPath) ||
       !fs.IsExecutable(outputPath) ||
       fs.StatSize(outputPath) <= 0 ||
       !fs.IsFile(reportPath) ||
       fs.StatSize(reportPath) <= 0:
        err = "CID current driver: formal compile artifacts invalid"
        return false
    err = ""
    return true

fn CidIdentityEvidenceCurrentResultOk(
        value: Result[bool],
        err: var str): bool =
    if IsErr(value):
        err = Error(value)
        return false
    if !Value(value):
        err = "CID current driver: case stage returned false"
        return false
    err = ""
    return true

@borrows
fn CidIdentityEvidenceCurrentSourceCase(
        programPath: str,
        caseId: str,
        payloadRoot: str,
        caseRoot: str,
        caseOutput: str,
        compileReportPath: str,
        err: var str): bool =
    if !sourcecase.CidEvidencePrepareCase(caseId, caseRoot):
        err = "CID current driver: source case preparation failed"
        return false
    if !CidIdentityEvidenceCurrentCompile(
            programPath,
            caseRoot,
            chengpath.PathJoin(caseRoot, "src/main.cheng"),
            caseOutput,
            compileReportPath,
            err):
        return false
    if !CidIdentityEvidenceCurrentResultOk(
            sourcecore.CidEvidenceSourceCoreCase(
                payloadRoot,
                caseOutput,
                compileReportPath,
                caseRoot),
            err):
        return false
    var specialFiles: str[]
    var kind = "source_bundle_entry"
    if caseId == "zero-byte-import":
        kind = "zero_byte_import"
        if !CidIdentityEvidenceCurrentResultOk(
                zerocase.CidEvidenceZeroProbeArtifacts(
                    caseRoot, payloadRoot, specialFiles),
                err):
            return false
    elif caseId == "source-csg-binding":
        kind = "source_csg_binding"
    elif caseId == "csg-atomic-consume":
        kind = "csg_atomic_consume"
        if !CidIdentityEvidenceCurrentResultOk(
                atomiccase.CidEvidenceAtomicConsumeArtifacts(
                    caseRoot, payloadRoot, specialFiles),
                err):
            return false
    return CidIdentityEvidenceCurrentResultOk(
        sourcecase.CidEvidenceSourceIndexCase(
            share(caseId),
            share(kind),
            share(payloadRoot),
            share(caseOutput),
            share(caseRoot)),
        err)

@borrows
fn CidIdentityEvidenceCurrentMigrationCase(
        programPath: str,
        caseId: str,
        payloadRoot: str,
        caseRoot: str,
        caseOutput: str,
        compileReportPath: str,
        err: var str): bool =
    if !migrationcase.CidEvidencePrepareCase(caseId, caseRoot):
        err = "CID current driver: migration case preparation failed"
        return false
    if !CidIdentityEvidenceCurrentCompile(
            programPath,
            caseRoot,
            chengpath.PathJoin(caseRoot, "src/main.cheng"),
            caseOutput,
            compileReportPath,
            err):
        return false
    return CidIdentityEvidenceCurrentResultOk(
        migrationcase.CidEvidenceMigrationCase(
            share(caseId), share(caseRoot), share(payloadRoot)),
        err)

@borrows
fn CidIdentityEvidenceCurrentMirrorCase(
        programPath: str,
        caseId: str,
        payloadRoot: str,
        caseRoot: str,
        caseOutput: str,
        compileReportPath: str,
        err: var str): bool =
    if !mirrormigration.CidEvidencePrepareCase(caseId, caseRoot):
        err = "CID current driver: mirror case preparation failed"
        return false
    if !CidIdentityEvidenceCurrentCompile(
            programPath,
            caseRoot,
            chengpath.PathJoin(caseRoot, "src/main.cheng"),
            caseOutput,
            compileReportPath,
            err):
        return false
    if !CidIdentityEvidenceCurrentResultOk(
            mirrormigration.CidEvidenceMirrorMigrationStage(
                share(caseRoot),
                share(payloadRoot),
                share(caseOutput)),
            err) ||
       !CidIdentityEvidenceCurrentResultOk(
            mirrordependency.CidEvidenceBuildDependency(
                share(caseRoot), share(caseOutput)),
            err):
        return false

    let rootB = strutil.Join([share(caseRoot), "-root-b"], "")
    let dependencyRoot = strutil.Join(
        [share(caseRoot), "-managed-dependency"], "")
    let rootBOutput = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "root-b-output")
    let dependencyOutput = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "dependency-output")
    let rootBReport = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "root-b-compile.report")
    let dependencyReport = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath,
        "dependency-compile.report")
    if !CidIdentityEvidenceCurrentCompile(
            programPath,
            rootB,
            chengpath.PathJoin(rootB, "src/main.cheng"),
            rootBOutput,
            rootBReport,
            err) ||
       !CidIdentityEvidenceCurrentCompile(
            programPath,
            dependencyRoot,
            chengpath.PathJoin(
                dependencyRoot, "src/main.cheng"),
            dependencyOutput,
            dependencyReport,
            err):
        return false

    if !CidIdentityEvidenceCurrentResultOk(
            mirrorplan.CidEvidencePlanBinding(
                share(caseRoot),
                share(caseOutput),
                share(compileReportPath),
                chengpath.PathJoin(
                    payloadRoot, "artifacts/migrated_csg.bin"),
                chengpath.PathJoin(
                    payloadRoot, "artifacts/migrated_semantic.bin"),
                chengpath.PathJoin(
                    payloadRoot, "artifacts/migrated_surface.bin"),
                share(CidIdentityEvidenceCurrentWorkPath),
                "root-a"),
            err) ||
       !CidIdentityEvidenceCurrentResultOk(
            mirrorplan.CidEvidencePlanBinding(
                rootB,
                rootBOutput,
                rootBReport,
                chengpath.PathJoin(
                    payloadRoot,
                    "artifacts/root_b_migrated_csg.bin"),
                chengpath.PathJoin(
                    payloadRoot,
                    "artifacts/root_b_migrated_semantic.bin"),
                chengpath.PathJoin(
                    payloadRoot,
                    "artifacts/root_b_migrated_surface.bin"),
                CidIdentityEvidenceCurrentWorkPath,
                "root-b"),
            err) ||
       !CidIdentityEvidenceCurrentResultOk(
            mirrorplan.CidEvidencePlanBinding(
                dependencyRoot,
                dependencyOutput,
                dependencyReport,
                chengpath.PathJoin(
                    CidIdentityEvidenceCurrentWorkPath,
                    "mirror-dependency-migrated-csg.kv"),
                chengpath.PathJoin(
                    CidIdentityEvidenceCurrentWorkPath,
                    "mirror-dependency-migrated-semantic.kv"),
                chengpath.PathJoin(
                    CidIdentityEvidenceCurrentWorkPath,
                    "mirror-dependency-migrated-surface.kv"),
                CidIdentityEvidenceCurrentWorkPath,
                "dependency"),
            err) ||
       !CidIdentityEvidenceCurrentResultOk(
            mirrorbundle.CidEvidenceMirrorBundleStage(
                share(caseRoot),
                share(payloadRoot),
                share(caseOutput)),
            err):
        return false
    return CidIdentityEvidenceCurrentResultOk(
        mirrorcase.CidEvidenceMirrorCase(
            share(caseId),
            share(caseRoot),
            share(payloadRoot),
            share(caseOutput),
            strutil.Join(
                ["cases/", share(caseId), "/payload"], "")),
        err)

@borrows
fn CidIdentityEvidenceCurrentRunWorkload(
        programPath: str,
        caseId: str,
        payloadRoot: str,
        caseRoot: str,
        caseOutput: str,
        compileReportPath: str,
        err: var str): bool =
    if caseId == "migration-cross-root-fixed-point":
        return CidIdentityEvidenceCurrentMigrationCase(
            programPath,
            caseId,
            payloadRoot,
            caseRoot,
            caseOutput,
            compileReportPath,
            err)
    if caseId == "mirror-atomic-install":
        return CidIdentityEvidenceCurrentMirrorCase(
            programPath,
            caseId,
            payloadRoot,
            caseRoot,
            caseOutput,
            compileReportPath,
            err)
    return CidIdentityEvidenceCurrentSourceCase(
        programPath,
        caseId,
        payloadRoot,
        caseRoot,
        caseOutput,
        compileReportPath,
        err)

@borrows
fn CidIdentityEvidenceCurrentPathLess(
        left: str,
        right: str): bool =
    let shared =
        left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] < right[index]:
            return true
        if left[index] > right[index]:
            return false
    return left.len < right.len

@borrows
fn CidIdentityEvidenceCurrentRelativePathValid(
        path: str): bool =
    if path.len <= 0 ||
       path.len > 255 ||
       path[0] == '/' ||
       path[path.len - 1] == '/':
        return false
    var segmentStart: int32
    for index in 0..<(path.len + 1):
        if index < path.len:
            let ch = path[index]
            if Int32(ch) <= 32 ||
               Int32(ch) >= 127 ||
               ch == '\\':
                return false
            if ch != '/':
                continue
        if index <= segmentStart:
            return false
        let segment = strings.SliceBytes(
            path, segmentStart, index - segmentStart)
        if segment == "." || segment == "..":
            return false
        segmentStart = index + 1
    return true

@borrows
fn CidIdentityEvidenceCurrentUstarSplitPath(
        path: str,
        name: var str,
        prefix: var str): bool =
    name = ""
    prefix = ""
    if path.len <= 100:
        name = strings.CloneStr(path)
        return true
    var splitAt: int32 = -1
    for index in 0..<path.len:
        if path[index] == '/' &&
           index <= 155 &&
           path.len - index - 1 <= 100:
            splitAt = index
    if splitAt <= 0 ||
       splitAt >= path.len - 1:
        return false
    prefix = strings.CloneStr(
        strings.SliceBytes(path, 0, splitAt))
    name = strings.CloneStr(strings.SliceBytes(
        path, splitAt + 1, path.len - splitAt - 1))
    return prefix.len <= 155 && name.len <= 100

fn CidIdentityEvidenceCurrentUstarWriteText(
        header: var rawbytes.Bytes,
        offset: int32,
        width: int32,
        text: str): bool =
    if offset < 0 ||
       width < 0 ||
       text.len > width ||
       offset + width > rawbytes.BytesLen(header):
        return false
    for index in 0..<text.len:
        rawbytes.BytesSet(
            header, offset + index, Int32(text[index]) & 255)
    return true

fn CidIdentityEvidenceCurrentUstarWriteOctal(
        header: var rawbytes.Bytes,
        offset: int32,
        digits: int32,
        value: int64,
        suffix: str): bool =
    if value < Int64(0) ||
       digits <= 0 ||
       suffix.len <= 0 ||
       offset < 0 ||
       offset + digits + suffix.len >
           rawbytes.BytesLen(header):
        return false
    var remaining = value
    var index: int32
    while index < digits:
        let target = offset + digits - index - 1
        rawbytes.BytesSet(
            header,
            target,
            int32(remaining % Int64(8)) + 48)
        remaining = remaining / Int64(8)
        index = index + 1
    if remaining != Int64(0):
        return false
    return CidIdentityEvidenceCurrentUstarWriteText(
        header, offset + digits, suffix.len, suffix)

@borrows
fn CidIdentityEvidenceCurrentUstarWriteFile(
        out: var rawbytes.Bytes,
        offset: int32,
        path: str,
        data: var rawbytes.Bytes,
        nextOffset: var int32,
        err: var str): bool =
    nextOffset = offset
    var name: str
    var prefix: str
    if !CidIdentityEvidenceCurrentUstarSplitPath(
            path, name, prefix):
        err = "CID current driver: payload path is not representable in USTAR"
        return false
    var header = rawbytes.BytesAlloc(
        CidIdentityEvidenceCurrentUstarBlockBytes)
    if rawbytes.BytesLen(header) !=
       CidIdentityEvidenceCurrentUstarBlockBytes:
        rawbytes.BytesFree(header)
        err = "CID current driver: USTAR header allocation failed"
        return false
    var headerOk =
        CidIdentityEvidenceCurrentUstarWriteText(
            header, 0, 100, name) &&
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header, 100, 7, Int64(384), "\0") &&
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header, 108, 7, Int64(0), "\0") &&
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header, 116, 7, Int64(0), "\0") &&
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header,
            124,
            11,
            Int64(rawbytes.BytesLen(data)),
            "\0") &&
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header, 136, 11, Int64(0), "\0") &&
        CidIdentityEvidenceCurrentUstarWriteText(
            header, 148, 8, "        ") &&
        CidIdentityEvidenceCurrentUstarWriteText(
            header, 156, 1, "0") &&
        CidIdentityEvidenceCurrentUstarWriteText(
            header, 257, 6, "ustar\0") &&
        CidIdentityEvidenceCurrentUstarWriteText(
            header, 263, 2, "00") &&
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header, 329, 7, Int64(0), "\0") &&
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header, 337, 7, Int64(0), "\0") &&
        CidIdentityEvidenceCurrentUstarWriteText(
            header, 345, 155, prefix)
    if !headerOk:
        rawbytes.BytesFree(header)
        err = "CID current driver: USTAR header encoding failed"
        return false
    var checksum: int64
    for index in 0..<CidIdentityEvidenceCurrentUstarBlockBytes:
        checksum = checksum +
            Int64(rawbytes.BytesGet(header, index) & 255)
    headerOk =
        CidIdentityEvidenceCurrentUstarWriteOctal(
            header, 148, 6, checksum, "\0 ")
    if !headerOk:
        rawbytes.BytesFree(header)
        err = "CID current driver: USTAR checksum encoding failed"
        return false
    let dataLen = rawbytes.BytesLen(data)
    let paddedLen =
        ((dataLen +
          CidIdentityEvidenceCurrentUstarBlockBytes - 1) /
         CidIdentityEvidenceCurrentUstarBlockBytes) *
        CidIdentityEvidenceCurrentUstarBlockBytes
    if offset < 0 ||
       offset + CidIdentityEvidenceCurrentUstarBlockBytes +
           paddedLen >
       rawbytes.BytesLen(out):
        rawbytes.BytesFree(header)
        err = "CID current driver: USTAR output range overflow"
        return false
    rawbytes.BytesCopyInto(out, offset, header)
    rawbytes.BytesFree(header)
    if dataLen > 0:
        rawbytes.BytesCopyInto(
            out,
            offset + CidIdentityEvidenceCurrentUstarBlockBytes,
            data)
    nextOffset =
        offset +
        CidIdentityEvidenceCurrentUstarBlockBytes +
        paddedLen
    err = ""
    return true

fn CidIdentityEvidenceCurrentBuildUstar(
        payloadRoot: str,
        outTar: var str,
        err: var str): bool =
    outTar = ""
    let listPath = chengpath.PathJoin(
        CidIdentityEvidenceCurrentWorkPath, "case-files.list")
    let listCanonicalRes = fs.Realpath(listPath)
    if IsErr(listCanonicalRes) ||
       Value(listCanonicalRes) != listPath ||
       !fs.IsFile(listPath):
        err = "CID current driver: case file list missing"
        return false
    let listReadRes = os.ReadFileResult(listPath)
    if IsErr(listReadRes):
        err = Error(listReadRes)
        return false
    let lines = strutil.Split(Value(listReadRes), '\n')
    if lines.len < 2 ||
       lines[lines.len - 1] != "":
        err = "CID current driver: case file list must end with one newline"
        return false
    var paths: str[]
    var sizes: int32[]
    var bodyBytes: int64
    var sawCaseIndex = false
    for index in 0..<(lines.len - 1):
        let relativePath = lines[index]
        if !CidIdentityEvidenceCurrentRelativePathValid(
                relativePath):
            err = "CID current driver: unsafe payload path"
            return false
        if index > 0 &&
           !CidIdentityEvidenceCurrentPathLess(
               lines[index - 1], relativePath):
            err = "CID current driver: payload paths are not strictly sorted"
            return false
        if relativePath == "case-index.json":
            sawCaseIndex = true
        let absolutePath = chengpath.PathJoin(
            payloadRoot, relativePath)
        var size: int64
        if !CidIdentityEvidenceCurrentStableRegularSizeInto(
                absolutePath, size, err):
            return false
        if size < Int64(0) ||
           size > Int64(2147483135):
            err = "CID current driver: payload member size is not encodable"
            return false
        let size32 = int32(size)
        let paddedSize =
            ((size32 +
              CidIdentityEvidenceCurrentUstarBlockBytes - 1) /
             CidIdentityEvidenceCurrentUstarBlockBytes) *
            CidIdentityEvidenceCurrentUstarBlockBytes
        bodyBytes = bodyBytes +
            Int64(CidIdentityEvidenceCurrentUstarBlockBytes) +
            Int64(paddedSize)
        add(paths, share(relativePath))
        add(sizes, size32)
    if !sawCaseIndex:
        err = "CID current driver: case-index.json is not declared"
        return false
    let terminatedBytes =
        bodyBytes +
        Int64(CidIdentityEvidenceCurrentUstarBlockBytes * 2)
    let recordBytes =
        Int64(CidIdentityEvidenceCurrentUstarRecordBytes)
    let totalBytes =
        ((terminatedBytes + recordBytes - Int64(1)) /
         recordBytes) * recordBytes
    if totalBytes <
           Int64(CidIdentityEvidenceCurrentUstarRecordBytes) ||
       totalBytes > Int64(2147483135):
        err = "CID current driver: USTAR total size is not encodable"
        return false
    var tarBytes = rawbytes.BytesAlloc(int32(totalBytes))
    defer:
        rawbytes.BytesFree(tarBytes)
    if rawbytes.BytesLen(tarBytes) != int32(totalBytes):
        err = "CID current driver: USTAR allocation failed"
        return false
    var offset: int32
    for index in 0..<paths.len:
        let absolutePath = chengpath.PathJoin(
            payloadRoot, paths[index])
        var data = rawbytes.EmptyBytes()
        if !CidIdentityEvidenceCurrentStableRegularBytesInto(
                absolutePath, sizes[index], data, err):
            return false
        var nextOffset: int32
        let writeOk =
            CidIdentityEvidenceCurrentUstarWriteFile(
                tarBytes,
                offset,
                paths[index],
                data,
                nextOffset,
                err)
        rawbytes.BytesFree(data)
        if !writeOk:
            return false
        offset = nextOffset
    if offset != int32(bodyBytes):
        err = "CID current driver: USTAR body length mismatch"
        return false
    outTar = rawbytes.BytesToString(tarBytes)
    err = ""
    return true

fn CidIdentityEvidenceCurrentRunCase(
        argc: int32,
        programPath: str,
        command: str,
        caseId: str,
        candidateSha256: str,
        outTar: var str,
        err: var str): bool =
    outTar = ""
    if !CidIdentityEvidenceCurrentValidateArguments(
            argc,
            command,
            caseId,
            candidateSha256,
            err):
        return false
    if !CidIdentityEvidenceCurrentBindExecutables(
            programPath, candidateSha256, err):
        return false
    var payloadRoot: str
    var caseRoot: str
    var caseOutput: str
    var compileReportPath: str
    if !CidIdentityEvidenceCurrentPrepareWork(
            payloadRoot,
            caseRoot,
            caseOutput,
            compileReportPath,
            err):
        return false
    if !CidIdentityEvidenceCurrentRunWorkload(
            programPath,
            caseId,
            payloadRoot,
            caseRoot,
            caseOutput,
            compileReportPath,
            err):
        return false
    return CidIdentityEvidenceCurrentBuildUstar(
        payloadRoot, outTar, err)
