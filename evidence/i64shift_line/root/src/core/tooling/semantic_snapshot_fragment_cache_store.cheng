import std/os
import std/result
import std/rawbytes
import std/strutils as strutil
import std/strings
import std/monotimes
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/semantic_snapshot_incremental_plan as incremental

const
    SemanticSnapshotFragmentCacheMagic: int32 = 1397965639

fn fragmentStoreAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn fragmentStoreReadU32(data: rawbytes.Bytes,
                        cursor: var int32,
                        ok: var bool): int32 =
    if !ok || cursor < 0 || cursor > data.len || data.len - cursor < 4:
        ok = false
        return 0
    let value = (rawbytes.BytesGet(data, cursor) << 24) |
        (rawbytes.BytesGet(data, cursor + 1) << 16) |
        (rawbytes.BytesGet(data, cursor + 2) << 8) |
        rawbytes.BytesGet(data, cursor + 3)
    cursor = cursor + 4
    return value

fn fragmentStoreReadCid(data: rawbytes.Bytes,
                        cursor: var int32,
                        out: var layout.FixedBytes32,
                        ok: var bool) =
    if !ok || cursor < 0 || cursor > data.len ||
       data.len - cursor < layout.FixedBytes32Size:
        ok = false
        return
    let view = rawbytes.BytesSliceView(
        data, cursor, layout.FixedBytes32Size)
    let parsed = layout.FixedBytes32FromBytes(view)
    if IsErr(parsed):
        ok = false
        return
    out = Value(parsed)
    cursor = cursor + layout.FixedBytes32Size

@borrows
fn fragmentStoreAppendRow(
        buf: var layout.ByteBuf,
        cache: incremental.SemanticSnapshotFunctionFragmentCache,
        row: int32) =
    layout.ByteBufAppendFixed32(buf, cache.functionSymbolCids[row])
    layout.ByteBufAppendFixed32(buf, cache.keyCids[row])
    layout.ByteBufAppendFixed32(buf, cache.fragmentCids[row])
    layout.ByteBufAppendFixed32(buf, cache.bodyContentCids[row])
    layout.ByteBufAppendFixed32(buf, cache.functionInterfaceCids[row])
    layout.ByteBufAppendFixed32(buf, cache.exactReadSetCids[row])
    layout.ByteBufAppendFixed32(buf, cache.schemaCids[row])
    layout.ByteBufAppendFixed32(buf, cache.compilerCids[row])
    layout.ByteBufAppendFixed32(buf, cache.targetCids[row])
    fragmentStoreAppendU32(buf, cache.payloadByteLengths[row])
    for index in 0..<cache.payloads[row].len:
        layout.ByteBufAppendByte(
            buf, Int32(cache.payloads[row][index]) & 255)

@borrows
fn SemanticSnapshotFunctionFragmentCacheEncode(
        cache: incremental.SemanticSnapshotFunctionFragmentCache):
        rawbytes.Bytes =
    var err: str
    if !incremental.SemanticSnapshotFunctionFragmentCacheStrictValidateInto(
            cache, err):
        panic("semantic_snapshot_fragment_cache_encode_invalid")
    var buf = layout.ByteBufInit(128 + cache.keyCids.len * 320)
    fragmentStoreAppendU32(buf, SemanticSnapshotFragmentCacheMagic)
    fragmentStoreAppendU32(buf, cache.keyCids.len)
    for row in 0..<cache.keyCids.len:
        fragmentStoreAppendRow(buf, cache, row)
    layout.ByteBufAppendFixed32(buf, cache.cacheCid)
    let out = layout.ByteSpanToBytes(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn SemanticSnapshotFunctionFragmentCacheDecodeInto(
        data: rawbytes.Bytes,
        out: var incremental.SemanticSnapshotFunctionFragmentCache,
        err: var str): bool =
    out = incremental.SemanticSnapshotFunctionFragmentCache()
    err = ""
    var cursor: int32
    var ok = true
    if fragmentStoreReadU32(data, cursor, ok) !=
           SemanticSnapshotFragmentCacheMagic:
        ok = false
    let rowCount = fragmentStoreReadU32(data, cursor, ok)
    if !ok || rowCount < 0 || rowCount > 1048576:
        err = " semantic snapshot fragment cache store: invalid envelope"
        return false
    var cache: incremental.SemanticSnapshotFunctionFragmentCache
    for row in 0..<rowCount:
        var functionSymbolCid: layout.FixedBytes32
        var keyCid: layout.FixedBytes32
        var fragmentCid: layout.FixedBytes32
        var bodyContentCid: layout.FixedBytes32
        var functionInterfaceCid: layout.FixedBytes32
        var exactReadSetCid: layout.FixedBytes32
        var schemaCid: layout.FixedBytes32
        var compilerCid: layout.FixedBytes32
        var targetCid: layout.FixedBytes32
        fragmentStoreReadCid(data, cursor, functionSymbolCid, ok)
        fragmentStoreReadCid(data, cursor, keyCid, ok)
        fragmentStoreReadCid(data, cursor, fragmentCid, ok)
        fragmentStoreReadCid(data, cursor, bodyContentCid, ok)
        fragmentStoreReadCid(data, cursor, functionInterfaceCid, ok)
        fragmentStoreReadCid(data, cursor, exactReadSetCid, ok)
        fragmentStoreReadCid(data, cursor, schemaCid, ok)
        fragmentStoreReadCid(data, cursor, compilerCid, ok)
        fragmentStoreReadCid(data, cursor, targetCid, ok)
        let payloadLen = fragmentStoreReadU32(data, cursor, ok)
        if !ok || payloadLen <= 0 || cursor > data.len ||
           payloadLen > data.len - cursor - layout.FixedBytes32Size:
            err = " semantic snapshot fragment cache store: row overrun"
            return false
        let payloadView = rawbytes.BytesSliceView(data, cursor, payloadLen)
        let payload = rawbytes.BytesToString(payloadView)
        cursor = cursor + payloadLen
        add(cache.functionSymbolCids, functionSymbolCid)
        add(cache.keyCids, keyCid)
        add(cache.fragmentCids, fragmentCid)
        add(cache.bodyContentCids, bodyContentCid)
        add(cache.functionInterfaceCids, functionInterfaceCid)
        add(cache.exactReadSetCids, exactReadSetCid)
        add(cache.schemaCids, schemaCid)
        add(cache.compilerCids, compilerCid)
        add(cache.targetCids, targetCid)
        add(cache.payloadByteLengths, payloadLen)
        add(cache.payloads, payload)
    fragmentStoreReadCid(data, cursor, cache.cacheCid, ok)
    if !ok || cursor != data.len ||
       !incremental.SemanticSnapshotFunctionFragmentCacheStrictValidateInto(
           cache, err):
        if err == "":
            err = " semantic snapshot fragment cache store: corrupt or trailing bytes"
        return false
    out = cache
    return true

@borrows
fn fragmentStoreRootIsCanonical(cacheRoot: str): bool =
    if cacheRoot == "" || cacheRoot == "/" ||
       !chengpath.PathIsAbsolute(cacheRoot) ||
       chengpath.PathHasParentTraversal(cacheRoot) ||
       cacheRoot[cacheRoot.len - 1] == '/':
        return false
    var segmentStart: int32
    for index in 0..<cacheRoot.len:
        if cacheRoot[index] == '\\':
            return false
        if cacheRoot[index] == '/':
            if index > 0 && cacheRoot[index - 1] == '/':
                return false
            if index - segmentStart == 1 &&
               cacheRoot[segmentStart] == '.':
                return false
            segmentStart = index + 1
    return !(cacheRoot.len - segmentStart == 1 &&
             cacheRoot[segmentStart] == '.')

@borrows
fn fragmentStoreRequireIdentity(
        cacheRoot: str,
        cacheCid: layout.FixedBytes32) =
    if !fragmentStoreRootIsCanonical(cacheRoot) ||
       layout.FixedBytes32Equal(cacheCid, layout.FixedBytes32()):
        panic("semantic_snapshot_fragment_cache_store_invalid_identity")

@borrows
fn SemanticSnapshotFunctionFragmentCachePath(
        cacheRoot: str,
        cacheCid: layout.FixedBytes32): str =
    fragmentStoreRequireIdentity(cacheRoot, cacheCid)
    return chengpath.PathJoin(
        cacheRoot, layout.FixedBytes32Hex(cacheCid))

fn fragmentStoreAbort(
        handle: os.AtomicTree,
        primaryError: str,
        err: var str): bool =
    let abortResult = os.AtomicTreeAbort(handle)
    if IsErr(abortResult):
        err = strutil.Join([
            primaryError,
            "; atomic staging abort failed: ",
            Error(abortResult)
        ], "")
    else:
        err = primaryError
    return false

fn SemanticSnapshotFunctionFragmentCacheLoadInto(
        cacheRoot: str,
        expectedCacheCid: layout.FixedBytes32,
        expectedSchemaCid: layout.FixedBytes32,
        expectedCompilerCid: layout.FixedBytes32,
        expectedTargetCid: layout.FixedBytes32,
        out: var incremental.SemanticSnapshotFunctionFragmentCache,
        err: var str): bool =
    out = incremental.SemanticSnapshotFunctionFragmentCache()
    err = ""
    if layout.FixedBytes32Equal(expectedSchemaCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(expectedCompilerCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(expectedTargetCid, layout.FixedBytes32()):
        panic("semantic_snapshot_fragment_cache_store_empty_expected_identity")
    let path = SemanticSnapshotFunctionFragmentCachePath(
        strings.CloneStr(cacheRoot), expectedCacheCid)
    if !os.DirExists(path):
        if os.FileExists(path):
            panic("semantic_snapshot_fragment_cache_store_entry_type_mismatch")
        panic("semantic_snapshot_fragment_cache_store_missing")
    let finalName = layout.FixedBytes32Hex(expectedCacheCid)
    let openResult = os.AtomicTreeOpenVerified(cacheRoot, finalName)
    if IsErr(openResult):
        panic("semantic_snapshot_fragment_cache_store_open_verified_failed")
    let handle = Value(openResult)
    let exactResult = os.AtomicTreeVerifyExact(handle, [], ["cache.bin"])
    if IsErr(exactResult):
        let closeResult = os.AtomicTreeClose(handle)
        if IsErr(closeResult):
            panic("semantic_snapshot_fragment_cache_store_shape_and_close_failed")
        panic("semantic_snapshot_fragment_cache_store_shape_mismatch")
    let readResult = os.AtomicTreeReadStable(handle, "cache.bin")
    if IsErr(readResult):
        let closeResult = os.AtomicTreeClose(handle)
        if IsErr(closeResult):
            panic("semantic_snapshot_fragment_cache_store_read_and_close_failed")
        panic("semantic_snapshot_fragment_cache_store_read_failed")
    var data = Value(readResult)
    let closeResult = os.AtomicTreeClose(handle)
    if IsErr(closeResult):
        rawbytes.BytesFree(data)
        panic("semantic_snapshot_fragment_cache_store_close_failed")
    defer:
        rawbytes.BytesFree(data)
    var cache: incremental.SemanticSnapshotFunctionFragmentCache
    if !SemanticSnapshotFunctionFragmentCacheDecodeInto(data, cache, err) ||
       !layout.FixedBytes32Equal(cache.cacheCid, expectedCacheCid):
        panic("semantic_snapshot_fragment_cache_store_corrupt")
    for row in 0..<cache.keyCids.len:
        if !layout.FixedBytes32Equal(cache.schemaCids[row], expectedSchemaCid) ||
           !layout.FixedBytes32Equal(
               cache.compilerCids[row], expectedCompilerCid) ||
           !layout.FixedBytes32Equal(cache.targetCids[row], expectedTargetCid):
            panic("semantic_snapshot_fragment_cache_store_identity_mismatch")
    out = cache
    return true

@borrows
fn SemanticSnapshotFunctionFragmentCachePutInto(
        cacheRoot: str,
        cache: incremental.SemanticSnapshotFunctionFragmentCache,
        writeOwnerCid: layout.FixedBytes32,
        err: var str): bool =
    err = ""
    if cache.keyCids.len <= 0 ||
       layout.FixedBytes32Equal(writeOwnerCid, layout.FixedBytes32()) ||
       !incremental.SemanticSnapshotFunctionFragmentCacheStrictValidateInto(
           cache, err):
        if err == "":
            err = " semantic snapshot fragment cache store: invalid immutable publish owner"
        return false
    fragmentStoreRequireIdentity(cacheRoot, cache.cacheCid)
    os.MkdirAll(cacheRoot, 493)
    if !os.DirExists(cacheRoot):
        err = " semantic snapshot fragment cache store: root create failed"
        return false
    var encoded = SemanticSnapshotFunctionFragmentCacheEncode(cache)
    let finalName = layout.FixedBytes32Hex(cache.cacheCid)
    let stagingName = strutil.Join([
        ".staging-semantic-fragment-cache-",
        strings.CloneStr(finalName),
        "-",
        layout.FixedBytes32Hex(writeOwnerCid),
        "-",
        IntToStr(os.ProcessId()),
        "-",
        strings.Int64ToStr(monotimes.MonoTimeNs(monotimes.GetMonoTime()))
    ], "")
    let beginResult = os.AtomicTreeBegin(cacheRoot, stagingName, finalName)
    if IsErr(beginResult):
        rawbytes.BytesFree(encoded)
        err = Error(beginResult)
        return false
    let handle = Value(beginResult)
    let writeResult = os.AtomicTreeWriteExclusiveSync(
        handle, "cache.bin", encoded)
    rawbytes.BytesFree(encoded)
    if IsErr(writeResult):
        return fragmentStoreAbort(
            handle, Error(writeResult), err)
    let exactResult = os.AtomicTreeVerifyExact(handle, [], ["cache.bin"])
    if IsErr(exactResult):
        return fragmentStoreAbort(
            handle, Error(exactResult), err)
    let commitResult = os.AtomicTreeCommitNoReplace(handle)
    if IsErr(commitResult):
        return fragmentStoreAbort(
            handle, Error(commitResult), err)
    if Value(commitResult) == os.AtomicTreeCommitted:
        let closeResult = os.AtomicTreeClose(handle)
        if IsErr(closeResult):
            err = Error(closeResult)
            return false
    elif Value(commitResult) == os.AtomicTreeDestinationExists:
        let abortResult = os.AtomicTreeAbort(handle)
        if IsErr(abortResult):
            err = Error(abortResult)
            return false
    elif Value(commitResult) == os.AtomicTreeCommittedDurabilityUnknown:
        let closeResult = os.AtomicTreeClose(handle)
        if IsErr(closeResult):
            err = strutil.Join([
                " semantic snapshot fragment cache store: committed durability unknown; close failed: ",
                Error(closeResult)
            ], "")
            return false
        err = " semantic snapshot fragment cache store: committed durability unknown"
        return false
    else:
        panic("semantic_snapshot_fragment_cache_store_impossible_commit_result")
    var verified: incremental.SemanticSnapshotFunctionFragmentCache
    return SemanticSnapshotFunctionFragmentCacheLoadInto(
        cacheRoot, cache.cacheCid, cache.schemaCids[0],
        cache.compilerCids[0], cache.targetCids[0], verified, err)
