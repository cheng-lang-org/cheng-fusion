type
    CompilerManagedMirrorBundleUnit =
        modulePath: str
        legacySourceRawByteLength: int32
        legacySourceCid: layout.FixedBytes32
        legacySourceText: str
        migratedSourceRawByteLength: int32
        migratedSourceCid: layout.FixedBytes32
        migratedSourceText: str

    CompilerManagedMirrorBundle =
        channel: str
        packageId: str
        migrationProofCid: layout.FixedBytes32
        legacySourceIdentityReceiptCid: layout.FixedBytes32
        migratedSourceIdentityReceiptCid: layout.FixedBytes32
        compileSemanticReceiptCid: layout.FixedBytes32
        unitCount: int32
        units: CompilerManagedMirrorBundleUnit[]
        baselineCsgText: str
        migratedCsgText: str
        baselineSurfaceText: str
        migratedSurfaceText: str
        baselineSemanticReceiptText: str
        migratedSemanticReceiptText: str
        evidenceText: str
        proofText: str
        bundleCid: layout.FixedBytes32

    CompilerManagedDependencyReceiptEntry =
        canonicalPackageId: str
        snapshotCid: layout.FixedBytes32
        syntaxSurfaceCid: layout.FixedBytes32
        migrationProofCid: layout.FixedBytes32
        priorManagedMirrorBundleCid: layout.FixedBytes32

    CompilerManagedDependencyReceipt =
        channel: str
        dependencyCount: int32
        entries: CompilerManagedDependencyReceiptEntry[]
        receiptCid: layout.FixedBytes32

    CompilerManagedMirrorMaterializedFile =
        relativePath: str
        text: str

@borrows
fn CompilerWorldManagedDependencyReceiptEntryOwnedCopy(
        entry: CompilerManagedDependencyReceiptEntry): CompilerManagedDependencyReceiptEntry =
    var out: CompilerManagedDependencyReceiptEntry
    out.canonicalPackageId = strings.CloneStr(entry.canonicalPackageId)
    out.snapshotCid = entry.snapshotCid
    out.syntaxSurfaceCid = entry.syntaxSurfaceCid
    out.migrationProofCid = entry.migrationProofCid
    out.priorManagedMirrorBundleCid = entry.priorManagedMirrorBundleCid
    return out


@borrows
fn CompilerWorldLibp2pOwnedBytesFromText(text: str): Bytes =
    var out = rawbytes.BytesAlloc(text.len)
    for index in 0..<text.len:
        rawbytes.BytesSet(out, index, int32(text[index]) & 255)
    return out

@borrows
fn CompilerWorldMirrorPackageManifestText(packageIdRaw: str): str =
    let packageId = chengpath.PathTrim(packageIdRaw)
    var modulePrefix = chengpath.PathBaseName(packageId)
    if len(modulePrefix) <= 0:
        modulePrefix = "pkg"
    return strutil.Join(["package_id = \"pkg://",
                         strings.CloneStr(packageId),
                         "\"\nmodule_prefix = \"",
                         strings.CloneStr(modulePrefix),
                         "\"\n"], "")

fn CompilerWorldHexValue(ch: uint8): int32 =
    if ch >= uint8('0') && ch <= uint8('9'):
        return int32(ch) - int32('0')
    if ch >= uint8('a') && ch <= uint8('f'):
        return 10 + (int32(ch) - int32('a'))
    if ch >= uint8('A') && ch <= uint8('F'):
        return 10 + (int32(ch) - int32('A'))
    return -1

fn CompilerWorldHexTextDecode(textRaw: str,
                                outText: var str): Result[bool] =
    let text = chengpath.PathTrim(textRaw)
    if len(text) <= 0:
        outText = ""
        return Ok[bool](true)
    if (len(text) % 2) != 0:
        return Err[bool](" compiler world libp2p: invalid hex length")
    var outBytes = rawbytes.BytesAlloc(len(text) / 2)
    var i: int32
    while i < len(text):
        let hi = CompilerWorldHexValue(uint8(text[i]))
        let lo = CompilerWorldHexValue(uint8(text[i + 1]))
        if hi < 0 || lo < 0:
            rawbytes.BytesFree(outBytes)
            return Err[bool](" compiler world libp2p: invalid hex payload")
        rawbytes.BytesSet(outBytes, i / 2, (hi * 16) + lo)
        i = i + 2
    outText = rawbytes.BytesToString(outBytes)
    rawbytes.BytesFree(outBytes)
    return Ok[bool](true)

@borrows
fn compilerWorldLibp2pLineValue(text: str,
                                  key: str): str =
    let lines = strutil.Split(share(text), '\n')
    let prefix = strutil.Join([share(key), "="], "")
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        if !strutil.StartsWith(line, prefix):
            continue
        return chengpath.TextSlice(line, len(prefix), len(line) - len(prefix))
    return ""

fn CompilerWorldManagedMirrorAppendU32BE(buf: var layout.ByteBuf,
                                           value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn CompilerWorldManagedMirrorAppendText(buf: var layout.ByteBuf,
                                         text: str) =
    CompilerWorldManagedMirrorAppendU32BE(buf, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, int32(text[i]) & 255)

fn CompilerWorldManagedMirrorAppendU32Field(buf: var layout.ByteBuf,
                                             value: int32) =
    CompilerWorldManagedMirrorAppendU32BE(buf, 4)
    CompilerWorldManagedMirrorAppendU32BE(buf, value)

fn CompilerWorldManagedMirrorAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    CompilerWorldManagedMirrorAppendU32BE(buf, 32)
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn CompilerWorldManagedMirrorSourceCid(text: str): layout.FixedBytes32 =
    return cworld.CompilerWorldSourceRawBytesCid(text)

@borrows
fn CompilerWorldManagedMirrorStrLess(left: str, right: str): bool =
    if left == right:
        return false
    var sharedLen = right.len
    if left.len < right.len:
        sharedLen = left.len
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return left[i] < right[i]
    return left.len < right.len

@borrows
fn CompilerWorldManagedMirrorModuleOwnedByPackage(modulePath: str,
                                                    packageId: str): bool =
    if modulePath.len <= packageId.len || modulePath[packageId.len] != '/':
        return false
    for i in 0..<packageId.len:
        if modulePath[i] != packageId[i]:
            return false
    return true

@borrows
fn CompilerWorldManagedMirrorBundleWire(
        bundle: CompilerManagedMirrorBundle): cworld.CompilerManagedMirrorBundleWire =
    var wire: cworld.CompilerManagedMirrorBundleWire
    wire.channel = strings.CloneStr(bundle.channel)
    wire.packageId = strings.CloneStr(bundle.packageId)
    wire.migrationProofCid = bundle.migrationProofCid
    wire.legacySourceIdentityReceiptCid =
        bundle.legacySourceIdentityReceiptCid
    wire.migratedSourceIdentityReceiptCid =
        bundle.migratedSourceIdentityReceiptCid
    wire.compileSemanticReceiptCid = bundle.compileSemanticReceiptCid
    wire.unitCount = bundle.unitCount
    var wireUnits: cworld.CompilerManagedMirrorBundleWireUnit[]
    for unitIndex in 0..<bundle.units.len:
        var wireUnit: cworld.CompilerManagedMirrorBundleWireUnit
        wireUnit.modulePath =
            strings.CloneStr(bundle.units[unitIndex].modulePath)
        wireUnit.legacySourceRawByteLength =
            bundle.units[unitIndex].legacySourceRawByteLength
        wireUnit.legacySourceCid = bundle.units[unitIndex].legacySourceCid
        wireUnit.legacySourceText =
            strings.CloneStr(bundle.units[unitIndex].legacySourceText)
        wireUnit.migratedSourceRawByteLength =
            bundle.units[unitIndex].migratedSourceRawByteLength
        wireUnit.migratedSourceCid = bundle.units[unitIndex].migratedSourceCid
        wireUnit.migratedSourceText =
            strings.CloneStr(bundle.units[unitIndex].migratedSourceText)
        add(wireUnits, wireUnit)
    wire.units = wireUnits
    wire.baselineCsgText = strings.CloneStr(bundle.baselineCsgText)
    wire.migratedCsgText = strings.CloneStr(bundle.migratedCsgText)
    wire.baselineSurfaceText = strings.CloneStr(bundle.baselineSurfaceText)
    wire.migratedSurfaceText = strings.CloneStr(bundle.migratedSurfaceText)
    wire.baselineSemanticReceiptText =
        strings.CloneStr(bundle.baselineSemanticReceiptText)
    wire.migratedSemanticReceiptText =
        strings.CloneStr(bundle.migratedSemanticReceiptText)
    wire.evidenceText = strings.CloneStr(bundle.evidenceText)
    wire.proofText = strings.CloneStr(bundle.proofText)
    wire.bundleCid = bundle.bundleCid
    return wire

@borrows
fn CompilerWorldManagedMirrorBundleOwnedCopy(
        bundle: CompilerManagedMirrorBundle): CompilerManagedMirrorBundle =
    var out: CompilerManagedMirrorBundle
    out.channel = strings.CloneStr(bundle.channel)
    out.packageId = strings.CloneStr(bundle.packageId)
    out.migrationProofCid = bundle.migrationProofCid
    out.legacySourceIdentityReceiptCid =
        bundle.legacySourceIdentityReceiptCid
    out.migratedSourceIdentityReceiptCid =
        bundle.migratedSourceIdentityReceiptCid
    out.compileSemanticReceiptCid = bundle.compileSemanticReceiptCid
    out.unitCount = bundle.unitCount
    var units: CompilerManagedMirrorBundleUnit[]
    for index in 0..<bundle.units.len:
        var unit: CompilerManagedMirrorBundleUnit
        unit.modulePath = strings.CloneStr(bundle.units[index].modulePath)
        unit.legacySourceRawByteLength =
            bundle.units[index].legacySourceRawByteLength
        unit.legacySourceCid = bundle.units[index].legacySourceCid
        unit.legacySourceText =
            strings.CloneStr(bundle.units[index].legacySourceText)
        unit.migratedSourceRawByteLength =
            bundle.units[index].migratedSourceRawByteLength
        unit.migratedSourceCid = bundle.units[index].migratedSourceCid
        unit.migratedSourceText =
            strings.CloneStr(bundle.units[index].migratedSourceText)
        add(units, unit)
    out.units = units
    out.baselineCsgText = strings.CloneStr(bundle.baselineCsgText)
    out.migratedCsgText = strings.CloneStr(bundle.migratedCsgText)
    out.baselineSurfaceText = strings.CloneStr(bundle.baselineSurfaceText)
    out.migratedSurfaceText = strings.CloneStr(bundle.migratedSurfaceText)
    out.baselineSemanticReceiptText =
        strings.CloneStr(bundle.baselineSemanticReceiptText)
    out.migratedSemanticReceiptText =
        strings.CloneStr(bundle.migratedSemanticReceiptText)
    out.evidenceText = strings.CloneStr(bundle.evidenceText)
    out.proofText = strings.CloneStr(bundle.proofText)
    out.bundleCid = bundle.bundleCid
    return out

@borrows
fn CompilerWorldManagedMirrorBundleCid(bundle: CompilerManagedMirrorBundle): layout.FixedBytes32 =
    return cworld.CompilerManagedMirrorBundleWireCid(
        CompilerWorldManagedMirrorBundleWire(bundle))

@borrows
fn CompilerWorldManagedDependencyReceiptCid(
        receipt: CompilerManagedDependencyReceipt): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(384)
    CompilerWorldManagedMirrorAppendText(
        buf,
        "cheng.compiler.managed_dependency_receipt")
    CompilerWorldManagedMirrorAppendText(buf, receipt.channel)
    CompilerWorldManagedMirrorAppendU32Field(buf, receipt.dependencyCount)
    for i in 0..<receipt.entries.len:
        CompilerWorldManagedMirrorAppendText(
            buf,
            receipt.entries[i].canonicalPackageId)
        CompilerWorldManagedMirrorAppendFixed32Field(
            buf,
            receipt.entries[i].snapshotCid)
        CompilerWorldManagedMirrorAppendFixed32Field(
            buf,
            receipt.entries[i].syntaxSurfaceCid)
        CompilerWorldManagedMirrorAppendFixed32Field(
            buf,
            receipt.entries[i].migrationProofCid)
        CompilerWorldManagedMirrorAppendFixed32Field(
            buf,
            receipt.entries[i].priorManagedMirrorBundleCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn CompilerWorldManagedDependencyReceiptVerify(
        receipt: CompilerManagedDependencyReceipt): bool =
    let channelRes = cworld.CompilerWorldNormalizeChannel(receipt.channel)
    if IsErr(channelRes) || Value(channelRes) != receipt.channel ||
       receipt.dependencyCount <= 0 ||
       receipt.dependencyCount != receipt.entries.len:
        return false
    for i in 0..<receipt.entries.len:
        let entry = receipt.entries[i]
        if parser.ParserManifestNormalizePackageId(entry.canonicalPackageId) !=
               entry.canonicalPackageId ||
           !parser.ParserSourceIdentityModuleTextValid(entry.canonicalPackageId) ||
           layout.FixedBytes32Equal(entry.snapshotCid,
                                    layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(entry.syntaxSurfaceCid,
                                    layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(entry.migrationProofCid,
                                    layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(entry.priorManagedMirrorBundleCid,
                                    layout.FixedBytes32()) ||
           (i > 0 && !CompilerWorldManagedMirrorStrLess(
                receipt.entries[i - 1].canonicalPackageId,
                entry.canonicalPackageId)):
            return false
    return layout.FixedBytes32Equal(
        receipt.receiptCid,
        CompilerWorldManagedDependencyReceiptCid(receipt))

fn CompilerWorldManagedDependencyReceiptMake(
        channelRaw: str,
        entries: CompilerManagedDependencyReceiptEntry[],
        out: var CompilerManagedDependencyReceipt): Result[bool] =
    let channelRes = cworld.CompilerWorldNormalizeChannel(channelRaw)
    if IsErr(channelRes) || entries.len <= 0:
        return Err[bool](
            " compiler world libp2p: invalid managed dependency receipt identity")
    var ordered: CompilerManagedDependencyReceiptEntry[]
    for i in 0..<entries.len:
        let candidate =
            CompilerWorldManagedDependencyReceiptEntryOwnedCopy(entries[i])
        var insertAt = ordered.len
        while insertAt > 0 && CompilerWorldManagedMirrorStrLess(
                candidate.canonicalPackageId,
                ordered[insertAt - 1].canonicalPackageId):
            insertAt = insertAt - 1
        var empty: CompilerManagedDependencyReceiptEntry
        add(ordered, empty)
        var cursor = ordered.len - 1
        while cursor > insertAt:
            ordered[cursor] = ordered[cursor - 1]
            cursor = cursor - 1
        ordered[insertAt] = candidate
    var next: CompilerManagedDependencyReceipt
    next.channel = Value(channelRes)
    next.dependencyCount = ordered.len
    next.entries = ordered
    next.receiptCid = CompilerWorldManagedDependencyReceiptCid(next)
    if !CompilerWorldManagedDependencyReceiptVerify(next):
        return Err[bool](
            " compiler world libp2p: managed dependency receipt validation failed")
    out = next
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedDependencyReceiptReport(
    receipt: CompilerManagedDependencyReceipt): str =
    var out = ""
    out = strutil.Join([
        out,
        "channel=",
        strings.CloneStr(receipt.channel),
        "\n"], "")
    out = strutil.Join([out, "dependency_count=",
                        IntToStr(receipt.dependencyCount), "\n"], "")
    for i in 0..<receipt.entries.len:
        let prefix = strutil.Join(["dependency[", IntToStr(i), "]."], "")
        out = strutil.Join([out, strings.CloneStr(prefix),
                            "canonical_package_id=",
                            strings.CloneStr(
                                receipt.entries[i].canonicalPackageId),
                            "\n"], "")
        out = strutil.Join([out, strings.CloneStr(prefix), "snapshot_cid=",
                            layout.FixedBytes32Hex(receipt.entries[i].snapshotCid),
                            "\n"], "")
        out = strutil.Join([out, strings.CloneStr(prefix),
                            "syntax_surface_cid=",
                            layout.FixedBytes32Hex(receipt.entries[i].syntaxSurfaceCid),
                            "\n"], "")
        out = strutil.Join([out, strings.CloneStr(prefix),
                            "migration_proof_cid=",
                            layout.FixedBytes32Hex(receipt.entries[i].migrationProofCid),
                            "\n"], "")
        out = strutil.Join([out, strings.CloneStr(prefix),
                            "prior_managed_mirror_bundle_cid=",
                            layout.FixedBytes32Hex(
                                receipt.entries[i].priorManagedMirrorBundleCid),
                            "\n"], "")
    out = strutil.Join([out, "receipt_cid=",
                        layout.FixedBytes32Hex(receipt.receiptCid)], "")
    return out

fn CompilerWorldManagedDependencyReceiptFromReportText(
        text: str,
        out: var CompilerManagedDependencyReceipt): Result[bool] =
    let countText = compilerWorldLibp2pLineValue(text, "dependency_count")
    let count = int32(strutil.ParseInt(countText))
    if count <= 0 || IntToStr(count) != countText:
        return Err[bool](
            " compiler world libp2p: invalid managed dependency count")
    var entries: CompilerManagedDependencyReceiptEntry[]
    for i in 0..<count:
        let prefix = strutil.Join(["dependency[", IntToStr(i), "]."], "")
        let packageId = compilerWorldLibp2pLineValue(
            text,
            strutil.Join([
                strings.CloneStr(prefix),
                "canonical_package_id"
            ], ""))
        let snapshotRes = layout.FixedBytes32FromHex(
            compilerWorldLibp2pLineValue(
                text,
                strutil.Join([
                    strings.CloneStr(prefix),
                    "snapshot_cid"
                ], "")))
        let surfaceRes = layout.FixedBytes32FromHex(
            compilerWorldLibp2pLineValue(
                text,
                strutil.Join([
                    strings.CloneStr(prefix),
                    "syntax_surface_cid"
                ], "")))
        let proofRes = layout.FixedBytes32FromHex(
            compilerWorldLibp2pLineValue(
                text,
                strutil.Join([
                    strings.CloneStr(prefix),
                    "migration_proof_cid"
                ], "")))
        let priorMirrorRes = layout.FixedBytes32FromHex(
            compilerWorldLibp2pLineValue(
                text,
                strutil.Join([strings.CloneStr(prefix),
                              "prior_managed_mirror_bundle_cid"], "")))
        if IsErr(snapshotRes) || IsErr(surfaceRes) || IsErr(proofRes) ||
           IsErr(priorMirrorRes):
            return Err[bool](
                " compiler world libp2p: invalid managed dependency cid")
        var entry: CompilerManagedDependencyReceiptEntry
        entry.canonicalPackageId = packageId
        entry.snapshotCid = Value(snapshotRes)
        entry.syntaxSurfaceCid = Value(surfaceRes)
        entry.migrationProofCid = Value(proofRes)
        entry.priorManagedMirrorBundleCid = Value(priorMirrorRes)
        add(entries, entry)
    let receiptCidRes = layout.FixedBytes32FromHex(
        compilerWorldLibp2pLineValue(text, "receipt_cid"))
    if IsErr(receiptCidRes):
        return Err[bool](
            " compiler world libp2p: invalid managed dependency receipt cid")
    var next: CompilerManagedDependencyReceipt
    next.channel = compilerWorldLibp2pLineValue(text, "channel")
    next.dependencyCount = count
    next.entries = entries
    next.receiptCid = Value(receiptCidRes)
    if !CompilerWorldManagedDependencyReceiptVerify(next):
        return Err[bool](
            " compiler world libp2p: managed dependency receipt verification failed")
    if text != CompilerWorldManagedDependencyReceiptReport(next):
        return Err[bool](
            " compiler world libp2p: managed dependency receipt is not canonical")
    out = next
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedDependencyReceiptFromPlanProjection(
        source: slplan.SystemLinkPlanManagedDependencyReceipt,
        out: var CompilerManagedDependencyReceipt): Result[bool] =
    out = CompilerManagedDependencyReceipt()
    if !slplan.SystemLinkPlanManagedDependencyReceiptPresent(source):
        return Ok[bool](false)
    var sourceErr: str
    if !slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
            source,
            sourceErr):
        return Err[bool](sourceErr)
    var entries: CompilerManagedDependencyReceiptEntry[]
    for index in 0..<source.entries.len:
        var entry: CompilerManagedDependencyReceiptEntry
        entry.canonicalPackageId = strings.CloneStr(
            source.entries[index].canonicalPackageId)
        entry.snapshotCid = source.entries[index].snapshotCid
        entry.syntaxSurfaceCid = source.entries[index].syntaxSurfaceCid
        entry.migrationProofCid = source.entries[index].migrationProofCid
        entry.priorManagedMirrorBundleCid =
            source.entries[index].priorManagedMirrorBundleCid
        add(entries, entry)
    var next: CompilerManagedDependencyReceipt
    next.channel = strings.CloneStr(source.channel)
    next.dependencyCount = source.dependencyCount
    next.entries = entries
    next.receiptCid = source.receiptCid
    if !CompilerWorldManagedDependencyReceiptVerify(next) ||
       !layout.FixedBytes32Equal(
            next.receiptCid,
            slplan.SystemLinkPlanManagedDependencyReceiptCid(source)):
        return Err[bool](
            " compiler world libp2p: plan managed dependency receipt conversion mismatch")
    out = next
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedDependencyReceiptFromManifest(
        manifest: cworld.CompilerUniverseManifest,
        out: var CompilerManagedDependencyReceipt): Result[bool] =
    out = CompilerManagedDependencyReceipt()
    var exactManifest: cworld.CompilerUniverseManifest
    let manifestRes = cworld.CompilerUniverseManifestFromReportText(
        cworld.CompilerUniverseManifestReport(manifest),
        exactManifest)
    if IsErr(manifestRes) ||
       !layout.FixedBytes32Equal(exactManifest.manifestCid,
                                 manifest.manifestCid):
        return Err[bool](
            " compiler world libp2p: managed receipt manifest is not exact canonical")
    var entries: CompilerManagedDependencyReceiptEntry[]
    let zeroCid = layout.FixedBytes32()
    for index in 0..<exactManifest.entries.len:
        let manifestEntry = exactManifest.entries[index]
        if manifestEntry.packageId == "cheng/compiler":
            continue
        if layout.FixedBytes32Equal(manifestEntry.managedMirrorBundleCid,
                                    zeroCid):
            continue
        var entry: CompilerManagedDependencyReceiptEntry
        entry.canonicalPackageId = manifestEntry.packageId
        entry.snapshotCid = manifestEntry.snapshotCid
        entry.syntaxSurfaceCid = manifestEntry.syntaxSurfaceCid
        entry.migrationProofCid = manifestEntry.migrationProofCid
        entry.priorManagedMirrorBundleCid =
            manifestEntry.managedMirrorBundleCid
        add(entries, entry)
    let receiptMissing = layout.FixedBytes32Equal(
        exactManifest.managedDependencyReceiptCid,
        zeroCid)
    if entries.len <= 0:
        if !receiptMissing:
            return Err[bool](
                " compiler world libp2p: manifest receipt cid has no managed mirror entries")
        return Ok[bool](false)
    if receiptMissing:
        return Err[bool](
            " compiler world libp2p: manifest managed mirror entries have no receipt cid")
    var next: CompilerManagedDependencyReceipt
    let makeRes = CompilerWorldManagedDependencyReceiptMake(
        strings.CloneStr(exactManifest.channel),
        entries,
        next)
    if IsErr(makeRes):
        return Err[bool](Error(makeRes))
    if !layout.FixedBytes32Equal(next.receiptCid,
                                 exactManifest.managedDependencyReceiptCid):
        return Err[bool](
            " compiler world libp2p: manifest/compact managed receipt cid mismatch")
    out = next
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorBundlesAuthorized(
        manifest: cworld.CompilerUniverseManifest,
        receipt: CompilerManagedDependencyReceipt,
        candidates: CompilerManagedMirrorBundle[]): Result[CompilerManagedMirrorBundle[]] =
    var expectedReceipt: CompilerManagedDependencyReceipt
    let expectedRes = CompilerWorldManagedDependencyReceiptFromManifest(
        manifest,
        expectedReceipt)
    if IsErr(expectedRes):
        return Err[CompilerManagedMirrorBundle[]](Error(expectedRes))
    if !Value(expectedRes):
        if receipt.channel != "" || receipt.dependencyCount != 0 ||
           receipt.entries.len != 0 ||
           !layout.FixedBytes32Equal(receipt.receiptCid,
                                     layout.FixedBytes32()) ||
           candidates.len != 0:
            return Err[CompilerManagedMirrorBundle[]](
                " compiler world libp2p: absent managed receipt has mirror payloads")
        var empty: CompilerManagedMirrorBundle[]
        return Ok[CompilerManagedMirrorBundle[]](empty)
    if !CompilerWorldManagedDependencyReceiptVerify(receipt) ||
       CompilerWorldManagedDependencyReceiptReport(receipt) !=
           CompilerWorldManagedDependencyReceiptReport(expectedReceipt):
        return Err[CompilerManagedMirrorBundle[]](
            " compiler world libp2p: compact managed receipt does not match manifest")
    if candidates.len != receipt.entries.len:
        return Err[CompilerManagedMirrorBundle[]](
            " compiler world libp2p: authorized managed mirror count mismatch")
    var ordered: CompilerManagedMirrorBundle[]
    for candidateIndex in 0..<candidates.len:
        let verifyRes = CompilerWorldManagedMirrorBundleVerify(
            candidates[candidateIndex])
        if IsErr(verifyRes):
            return Err[CompilerManagedMirrorBundle[]](Error(verifyRes))
        var insertAt = ordered.len
        while insertAt > 0 && CompilerWorldManagedMirrorStrLess(
                candidates[candidateIndex].packageId,
                ordered[insertAt - 1].packageId):
            insertAt = insertAt - 1
        add(ordered, CompilerWorldManagedMirrorBundleOwnedCopy(
            candidates[candidateIndex]))
        var cursor = ordered.len - 1
        while cursor > insertAt:
            ordered[cursor] = ordered[cursor - 1]
            cursor = cursor - 1
        ordered[insertAt] = candidates[candidateIndex]
    for index in 0..<ordered.len:
        let dependency = receipt.entries[index]
        let bundle = ordered[index]
        if bundle.channel != receipt.channel ||
           bundle.packageId != dependency.canonicalPackageId ||
           !layout.FixedBytes32Equal(bundle.migrationProofCid,
                                     dependency.migrationProofCid) ||
           !layout.FixedBytes32Equal(bundle.bundleCid,
                                     dependency.priorManagedMirrorBundleCid):
            return Err[CompilerManagedMirrorBundle[]](
                " compiler world libp2p: managed mirror is not authorized by compact receipt")
    return Ok[CompilerManagedMirrorBundle[]](ordered)

fn CompilerWorldManagedMirrorVerifiedReadError(
        handle: os.AtomicTree,
        primaryError: str): Result[CompilerManagedMirrorBundle[]] =
    let closeRes = os.AtomicTreeClose(handle)
    if IsErr(closeRes):
        return Err[CompilerManagedMirrorBundle[]](strutil.Join([
            strings.CloneStr(primaryError),
            "; verified mirror close failed: ",
            Error(closeRes)
        ], ""))
    return Err[CompilerManagedMirrorBundle[]](strings.CloneStr(primaryError))

@borrows
fn CompilerWorldManagedMirrorBundlesFromReceipt(
        rootDir: str,
        manifest: cworld.CompilerUniverseManifest,
        receipt: CompilerManagedDependencyReceipt): Result[CompilerManagedMirrorBundle[]] =
    if receipt.dependencyCount == 0:
        if receipt.channel != "" || receipt.entries.len != 0 ||
           !layout.FixedBytes32Equal(receipt.receiptCid,
                                     layout.FixedBytes32()):
            return CompilerWorldManagedMirrorAuthorizationRejected(
                " compiler world libp2p: invalid absent compact managed receipt")
        var empty: CompilerManagedMirrorBundle[]
        return CompilerWorldManagedMirrorBundlesAuthorized(manifest,
                                                           receipt,
                                                           empty)
    if !CompilerWorldManagedDependencyReceiptVerify(receipt):
        return CompilerWorldManagedMirrorAuthorizationRejected(
            " compiler world libp2p: invalid compact managed receipt")
    var out: CompilerManagedMirrorBundle[]
    for index in 0..<receipt.entries.len:
        let dependency = receipt.entries[index]
        let finalRoot = cworld.CompilerManagedMirrorRoot(
            rootDir,
            receipt.channel,
            dependency.canonicalPackageId,
            dependency.priorManagedMirrorBundleCid)
        let parentPath = chengpath.PathParentDir(finalRoot)
        let finalName = layout.FixedBytes32Hex(
            dependency.priorManagedMirrorBundleCid)
        let openRes = os.AtomicTreeOpenVerified(parentPath, finalName)
        if IsErr(openRes):
            return Err[CompilerManagedMirrorBundle[]](Error(openRes))
        let handle = Value(openRes)
        let path = "bundle.txt"
        let bundleBytesRes = os.AtomicTreeReadStable(handle, path)
        if IsErr(bundleBytesRes):
            return CompilerWorldManagedMirrorVerifiedReadError(
                handle,
                Error(bundleBytesRes))
        var bundleBytes = Value(bundleBytesRes)
        let text = cworld.CompilerWorldOwnText(
            rawbytes.BytesToString(bundleBytes))
        rawbytes.BytesFree(bundleBytes)
        var bundle: CompilerManagedMirrorBundle
        let parseRes = CompilerWorldManagedMirrorBundleFromReportText(text,
                                                                      bundle)
        if IsErr(parseRes):
            return CompilerWorldManagedMirrorVerifiedReadError(handle,
                                                               Error(parseRes))
        if bundle.packageId !=
                dependency.canonicalPackageId ||
           !layout.FixedBytes32Equal(
                bundle.migrationProofCid,
                dependency.migrationProofCid) ||
           !layout.FixedBytes32Equal(
                bundle.bundleCid,
                dependency.priorManagedMirrorBundleCid):
            return CompilerWorldManagedMirrorVerifiedReadError(
                handle,
                " compiler world libp2p: compact receipt/mirror bundle mismatch")
        var files: CompilerManagedMirrorMaterializedFile[]
        let filesRes = CompilerWorldManagedMirrorMaterializedFiles(
            bundle,
            files)
        if IsErr(filesRes):
            return CompilerWorldManagedMirrorVerifiedReadError(handle,
                                                               Error(filesRes))
        var expectedDirs: str[]
        var expectedFiles: str[]
        let expectedRes = CompilerWorldManagedMirrorExpectedTree(
            files,
            expectedDirs,
            expectedFiles)
        if IsErr(expectedRes):
            return CompilerWorldManagedMirrorVerifiedReadError(
                handle,
                Error(expectedRes))
        let verifyRes = CompilerWorldManagedMirrorVerifyHandle(
            handle,
            bundle,
            files,
            expectedDirs,
            expectedFiles)
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(verifyRes):
            if IsErr(closeRes):
                return Err[CompilerManagedMirrorBundle[]](strutil.Join([
                    Error(verifyRes),
                    "; verified mirror close failed: ",
                    Error(closeRes)
                ], ""))
            return Err[CompilerManagedMirrorBundle[]](Error(verifyRes))
        if IsErr(closeRes):
            return Err[CompilerManagedMirrorBundle[]](Error(closeRes))
        add(out, bundle)
    return CompilerWorldManagedMirrorBundlesAuthorized(manifest,
                                                       receipt,
                                                       out)

@borrows
fn CompilerWorldManagedMirrorArtifactPredecessorsVerify(
        bundle: CompilerManagedMirrorBundle,
        proof: ceq.CompilerMigrationSemanticProof): Result[bool] =
    var baselineGraphCid: layout.FixedBytes32
    var migratedGraphCid: layout.FixedBytes32
    var sidecarErr = ""
    if !ccsg.CompilerCsgCanonicalGraphCidFromReportTextInto(
            bundle.baselineCsgText,
            baselineGraphCid,
            sidecarErr):
        return Err[bool](sidecarErr)
    if !ccsg.CompilerCsgCanonicalGraphCidFromReportTextInto(
            bundle.migratedCsgText,
            migratedGraphCid,
            sidecarErr):
        return Err[bool](sidecarErr)
    if !layout.FixedBytes32Equal(baselineGraphCid,
                                 proof.baselineGraphCid) ||
       !layout.FixedBytes32Equal(migratedGraphCid,
                                 proof.migratedGraphCid):
        return Err[bool](
            " compiler world libp2p: mirror canonical csg/proof mismatch")
    var baselineSurface: ccsg.CsgExportSurface
    var migratedSurface: ccsg.CsgExportSurface
    let baselineSurfaceRes = ccsg.CompilerExportSurfaceFromReportText(
        bundle.baselineSurfaceText,
        baselineSurface)
    if IsErr(baselineSurfaceRes):
        return Err[bool](Error(baselineSurfaceRes))
    let migratedSurfaceRes = ccsg.CompilerExportSurfaceFromReportText(
        bundle.migratedSurfaceText,
        migratedSurface)
    if IsErr(migratedSurfaceRes):
        return Err[bool](Error(migratedSurfaceRes))
    if baselineSurface.packageId != bundle.packageId ||
       migratedSurface.packageId != bundle.packageId ||
       !layout.FixedBytes32Equal(baselineSurface.surfaceCid,
                                 proof.baselineSurfaceCid) ||
       !layout.FixedBytes32Equal(migratedSurface.surfaceCid,
                                 proof.migratedSurfaceCid):
        return Err[bool](
            " compiler world libp2p: mirror export surface/proof mismatch")
    var baselineSemantic: sexec.CompileSemanticReceipt
    var migratedSemantic: sexec.CompileSemanticReceipt
    let baselineSemanticRes =
        sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
            bundle.baselineSemanticReceiptText,
            baselineSemantic)
    if IsErr(baselineSemanticRes):
        return Err[bool](Error(baselineSemanticRes))
    let migratedSemanticRes =
        sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
            bundle.migratedSemanticReceiptText,
            migratedSemantic)
    if IsErr(migratedSemanticRes):
        return Err[bool](Error(migratedSemanticRes))
    let targetTripleCid = sexec.SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        proof.targetTriple)
    if !layout.FixedBytes32Equal(baselineSemantic.receiptCid,
                                 proof.baselineSemanticReceiptCid) ||
       !layout.FixedBytes32Equal(migratedSemantic.receiptCid,
                                 proof.migratedSemanticReceiptCid) ||
       !layout.FixedBytes32Equal(migratedSemantic.receiptCid,
                                 bundle.compileSemanticReceiptCid) ||
       !layout.FixedBytes32Equal(baselineSemantic.canonicalCompilerCsgCid,
                                 baselineGraphCid) ||
       !layout.FixedBytes32Equal(migratedSemantic.canonicalCompilerCsgCid,
                                 migratedGraphCid) ||
       !layout.FixedBytes32Equal(baselineSemantic.sourceIdentityReceiptCid,
                                 proof.legacySourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(migratedSemantic.sourceIdentityReceiptCid,
                                 proof.migratedSourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(baselineSemantic.targetTripleCid,
                                 targetTripleCid) ||
       !layout.FixedBytes32Equal(migratedSemantic.targetTripleCid,
                                 targetTripleCid):
        return Err[bool](
            " compiler world libp2p: mirror semantic receipt/proof mismatch")
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorBundleMakeFromAuthenticatedReports(
        legacyTexts: str[],
        migratedTexts: str[],
        evidence: ceq.CompilerMigrationEvidence,
        proof: ceq.CompilerMigrationSemanticProof,
        baselineCsgText: str,
        migratedCsgText: str,
        baselineSurfaceText: str,
        migratedSurfaceText: str,
        baselineSemanticReceiptText: str,
        migratedSemanticReceiptText: str,
        out: var CompilerManagedMirrorBundle): Result[bool] =
    if !ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence) ||
       proof.packageId != evidence.packageId ||
       legacyTexts.len != evidence.unitCount ||
       migratedTexts.len != evidence.unitCount:
        return Err[bool](
            " compiler world libp2p: authenticated report chain required")
    var units: CompilerManagedMirrorBundleUnit[]
    for evidenceIndex in 0..<evidence.orderedModulePaths.len:
        var unit: CompilerManagedMirrorBundleUnit
        unit.modulePath = strings.CloneStr(
            evidence.orderedModulePaths[evidenceIndex])
        unit.legacySourceRawByteLength =
            evidence.legacyRawByteLengths[evidenceIndex]
        unit.legacySourceCid = evidence.legacyRawCids[evidenceIndex]
        unit.legacySourceText = strings.CloneStr(legacyTexts[evidenceIndex])
        unit.migratedSourceRawByteLength =
            evidence.migratedRawByteLengths[evidenceIndex]
        unit.migratedSourceCid = evidence.migratedRawCids[evidenceIndex]
        unit.migratedSourceText = strings.CloneStr(
            migratedTexts[evidenceIndex])
        add(units, unit)
    var next: CompilerManagedMirrorBundle
    next.channel = strings.CloneStr(proof.channel)
    next.packageId = strings.CloneStr(proof.packageId)
    next.migrationProofCid = proof.proofCid
    next.legacySourceIdentityReceiptCid =
        proof.legacySourceIdentityReceiptCid
    next.migratedSourceIdentityReceiptCid =
        proof.migratedSourceIdentityReceiptCid
    next.compileSemanticReceiptCid = proof.migratedSemanticReceiptCid
    next.unitCount = units.len
    next.units = units
    next.baselineCsgText = strings.CloneStr(baselineCsgText)
    next.migratedCsgText = strings.CloneStr(migratedCsgText)
    next.baselineSurfaceText = strings.CloneStr(baselineSurfaceText)
    next.migratedSurfaceText = strings.CloneStr(migratedSurfaceText)
    next.baselineSemanticReceiptText = strings.CloneStr(
        baselineSemanticReceiptText)
    next.migratedSemanticReceiptText = strings.CloneStr(
        migratedSemanticReceiptText)
    next.evidenceText = ceq.CompilerMigrationEvidenceReport(evidence)
    next.proofText = ceq.CompilerMigrationSemanticProofReport(proof)
    next.bundleCid = CompilerWorldManagedMirrorBundleCid(next)
    let verifyRes = CompilerWorldManagedMirrorBundleVerify(next)
    if IsErr(verifyRes):
        return Err[bool](Error(verifyRes))
    out = next
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorBundleMake(
        plan: sexec.SystemLinkExecPlan,
        migration: ccsg.CompilerLegacyMigration,
        evidence: ceq.CompilerMigrationEvidence,
        proof: ceq.CompilerMigrationSemanticProof,
        out: var CompilerManagedMirrorBundle): Result[bool] =
    if migration.packageId != plan.systemLinkPlan.packageId ||
       migration.packageId != evidence.packageId ||
       !ceq.CompilerMigrationSourceReceiptEqual(
            plan.compilerCsg.sourceIdentityReceipt,
            migration.migratedArtifact.sourceIdentityReceipt) ||
       !layout.FixedBytes32Equal(
            plan.compilerCsg.canonicalGraphCid,
            migration.migratedArtifact.canonicalGraphCid) ||
       !layout.FixedBytes32Equal(
            plan.exportSurface.surfaceCid,
            migration.migratedArtifact.exportSurface.surfaceCid):
        return Err[bool](
            " compiler world libp2p: authenticated migration pair required")
    var baselineSemantic: sexec.CompileSemanticReceipt
    var migratedSemantic: sexec.CompileSemanticReceipt
    var semanticErr: str
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.baselineArtifact.sourceIdentityReceipt,
            migration.baselineArtifact.canonicalGraphCid,
            plan.semanticReceipt.canonicalOutputDigest,
            plan.systemLinkPlan.targetTriple,
            "stage3_local",
            plan.systemLinkPlan.providerModules,
            baselineSemantic,
            semanticErr):
        return Err[bool](strutil.Join([
            " compiler world libp2p: baseline semantic receipt invalid: ",
            semanticErr], ""))
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.migratedArtifact.sourceIdentityReceipt,
            migration.migratedArtifact.canonicalGraphCid,
            plan.semanticReceipt.canonicalOutputDigest,
            plan.systemLinkPlan.targetTriple,
            "stage3_local",
            plan.systemLinkPlan.providerModules,
            migratedSemantic,
            semanticErr):
        return Err[bool](strutil.Join([
            " compiler world libp2p: migrated semantic receipt invalid: ",
            semanticErr], ""))
    var legacyTexts: str[]
    var migratedTexts: str[]
    for evidenceIndex in 0..<evidence.orderedModulePaths.len:
        let modulePath = evidence.orderedModulePaths[evidenceIndex]
        var migrationUnitIndex = -1
        for unitIndex in 0..<migration.units.len:
            if migration.units[unitIndex].modulePath != modulePath:
                continue
            if migrationUnitIndex >= 0:
                return Err[bool](
                    " compiler world libp2p: duplicate migration module")
            migrationUnitIndex = unitIndex
        if migrationUnitIndex < 0:
            return Err[bool](
                " compiler world libp2p: migration evidence module missing")
        let unit = migration.units[migrationUnitIndex]
        add(legacyTexts, strings.CloneStr(unit.legacyText))
        add(migratedTexts, strings.CloneStr(unit.migratedText))
    return CompilerWorldManagedMirrorBundleMakeFromAuthenticatedReports(
        legacyTexts,
        migratedTexts,
        evidence,
        proof,
        migration.baselineArtifact.canonicalCsgReport,
        migration.migratedArtifact.canonicalCsgReport,
        ccsg.CompilerExportSurfaceReport(
            migration.baselineArtifact.exportSurface),
        ccsg.CompilerExportSurfaceReport(
            migration.migratedArtifact.exportSurface),
        sexec.SystemLinkExecCompileSemanticReceiptReport(
            baselineSemantic),
        sexec.SystemLinkExecCompileSemanticReceiptReport(
            migratedSemantic),
        out)

@borrows
fn CompilerWorldManagedMirrorBundleVerify(bundle: CompilerManagedMirrorBundle): Result[bool] =
    let channelRes = cworld.CompilerWorldNormalizeChannel(bundle.channel)
    if IsErr(channelRes) || Value(channelRes) != bundle.channel:
        return Err[bool](" compiler world libp2p: non-canonical mirror channel")
    if parser.ParserManifestNormalizePackageId(bundle.packageId) != bundle.packageId ||
       !parser.ParserSourceIdentityModuleTextValid(bundle.packageId):
        return Err[bool](" compiler world libp2p: non-canonical mirror package")
    if bundle.unitCount <= 0 || bundle.unitCount != bundle.units.len:
        return Err[bool](" compiler world libp2p: invalid mirror unit count")
    if layout.FixedBytes32Equal(bundle.migrationProofCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(bundle.legacySourceIdentityReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(bundle.migratedSourceIdentityReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(bundle.compileSemanticReceiptCid, layout.FixedBytes32()) ||
       bundle.baselineCsgText == "" || bundle.migratedCsgText == "" ||
       bundle.baselineSurfaceText == "" || bundle.migratedSurfaceText == "" ||
       bundle.baselineSemanticReceiptText == "" ||
       bundle.migratedSemanticReceiptText == "" ||
       bundle.evidenceText == "" || bundle.proofText == "":
        return Err[bool](" compiler world libp2p: mirror receipt chain missing")
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceFromReportText(
        bundle.evidenceText,
        evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofFromReportText(
        bundle.proofText,
        proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    if proof.packageId != bundle.packageId ||
       proof.channel != bundle.channel ||
       evidence.packageId != bundle.packageId ||
       evidence.unitCount != bundle.unitCount ||
       !layout.FixedBytes32Equal(proof.proofCid,
                                 bundle.migrationProofCid) ||
       !layout.FixedBytes32Equal(proof.legacySourceIdentityReceiptCid,
                                 bundle.legacySourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(proof.migratedSourceIdentityReceiptCid,
                                 bundle.migratedSourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(proof.migratedSemanticReceiptCid,
                                 bundle.compileSemanticReceiptCid) ||
       !ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence):
        return Err[bool](" compiler world libp2p: mirror evidence/proof pair mismatch")
    var modulePaths: str[]
    var legacyTexts: str[]
    var migratedTexts: str[]
    for i in 0..<bundle.units.len:
        let unit = bundle.units[i]
        let ownedModulePath = strings.CloneStr(unit.modulePath)
        let ownedPackageId = strings.CloneStr(bundle.packageId)
        if !parser.ParserSourceIdentityModuleTextValid(ownedModulePath) ||
           !CompilerWorldManagedMirrorModuleOwnedByPackage(ownedModulePath,
                                                            ownedPackageId):
            return Err[bool](" compiler world libp2p: non-canonical mirror module path")
        if i > 0:
            let previousModulePath = strings.CloneStr(bundle.units[i - 1].modulePath)
            if !CompilerWorldManagedMirrorStrLess(
                    previousModulePath,
                    ownedModulePath):
                return Err[bool](" compiler world libp2p: unordered or duplicate mirror module")
        if ownedModulePath != evidence.orderedModulePaths[i] ||
           unit.legacySourceRawByteLength != unit.legacySourceText.len ||
           unit.migratedSourceRawByteLength != unit.migratedSourceText.len ||
           unit.legacySourceRawByteLength != evidence.legacyRawByteLengths[i] ||
           unit.migratedSourceRawByteLength != evidence.migratedRawByteLengths[i] ||
           !layout.FixedBytes32Equal(unit.legacySourceCid,
                                     evidence.legacyRawCids[i]) ||
           !layout.FixedBytes32Equal(unit.migratedSourceCid,
                                     evidence.migratedRawCids[i]) ||
           !layout.FixedBytes32Equal(
                unit.legacySourceCid,
                CompilerWorldManagedMirrorSourceCid(unit.legacySourceText)) ||
           !layout.FixedBytes32Equal(
                unit.migratedSourceCid,
                CompilerWorldManagedMirrorSourceCid(unit.migratedSourceText)):
            return Err[bool](" compiler world libp2p: mirror source receipt mismatch")
        add(modulePaths, strings.CloneStr(unit.modulePath))
        add(legacyTexts, strings.CloneStr(unit.legacySourceText))
        add(migratedTexts, strings.CloneStr(unit.migratedSourceText))
    var legacyReceipt: ccsg.PortableSourceIdentityReceipt
    var migratedReceipt: ccsg.PortableSourceIdentityReceipt
    var sourceReceiptErr: str
    if !ceq.CompilerMigrationSourceReceiptFromTextsInto(
            bundle.packageId,
            evidence.entryModulePath,
            modulePaths,
            legacyTexts,
            legacyReceipt,
            sourceReceiptErr) ||
       !ceq.CompilerMigrationSourceReceiptFromTextsInto(
            bundle.packageId,
            evidence.entryModulePath,
            modulePaths,
            migratedTexts,
            migratedReceipt,
            sourceReceiptErr) ||
       !ceq.CompilerMigrationSourceReceiptEqual(
            legacyReceipt,
            evidence.legacySourceIdentityReceipt) ||
       !ceq.CompilerMigrationSourceReceiptEqual(
            migratedReceipt,
            evidence.migratedSourceIdentityReceipt):
        return Err[bool](
            " compiler world libp2p: mirror source text/portable receipt mismatch")
    let artifactRes = CompilerWorldManagedMirrorArtifactPredecessorsVerify(
        bundle,
        proof)
    if IsErr(artifactRes):
        return Err[bool](Error(artifactRes))
    if !layout.FixedBytes32Equal(bundle.bundleCid,
                                 CompilerWorldManagedMirrorBundleCid(bundle)):
        return Err[bool](" compiler world libp2p: mirror bundle cid mismatch")
    var wireBundle: cworld.CompilerManagedMirrorBundleWire
    let wireRes = cworld.CompilerManagedMirrorBundleWireFromReportText(
        CompilerWorldManagedMirrorBundleReport(bundle),
        wireBundle)
    if IsErr(wireRes):
        return Err[bool](Error(wireRes))
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorBundleReport(bundle: CompilerManagedMirrorBundle): str =
    return cworld.CompilerManagedMirrorBundleWireReport(
        CompilerWorldManagedMirrorBundleWire(bundle))

@borrows
fn CompilerWorldManagedMirrorBundleFromReportText(text: str,
                                                    out: var CompilerManagedMirrorBundle): Result[bool] =
    var wireBundle: cworld.CompilerManagedMirrorBundleWire
    let wireRes = cworld.CompilerManagedMirrorBundleWireFromReportText(
        text,
        wireBundle)
    if IsErr(wireRes):
        return Err[bool](Error(wireRes))
    let channelRes = cworld.CompilerWorldNormalizeChannel(compilerWorldLibp2pLineValue(text, "channel"))
    if IsErr(channelRes):
        return Err[bool](Error(channelRes))
    let packageId = compilerWorldLibp2pLineValue(text, "package_id")
    if len(packageId) <= 0:
        return Err[bool](" compiler world libp2p: mirror bundle package_id missing")
    let proofRes = layout.FixedBytes32FromHex(compilerWorldLibp2pLineValue(text, "migration_proof_cid"))
    if IsErr(proofRes):
        return Err[bool](" compiler world libp2p: invalid mirror bundle proof cid")
    let legacySourceIdentityRes = layout.FixedBytes32FromHex(
        compilerWorldLibp2pLineValue(
            text,
            "legacy_source_identity_receipt_cid"))
    let migratedSourceIdentityRes = layout.FixedBytes32FromHex(
        compilerWorldLibp2pLineValue(
            text,
            "migrated_source_identity_receipt_cid"))
    if IsErr(legacySourceIdentityRes) || IsErr(migratedSourceIdentityRes):
        return Err[bool](
            " compiler world libp2p: invalid source identity receipt cid")
    let semanticReceiptRes = layout.FixedBytes32FromHex(
        compilerWorldLibp2pLineValue(text, "compile_semantic_receipt_cid"))
    if IsErr(semanticReceiptRes):
        return Err[bool](" compiler world libp2p: invalid semantic receipt cid")
    let bundleCidRes = layout.FixedBytes32FromHex(
        compilerWorldLibp2pLineValue(text, "bundle_cid"))
    if IsErr(bundleCidRes):
        return Err[bool](" compiler world libp2p: invalid mirror bundle cid")
    let unitCountText = compilerWorldLibp2pLineValue(text, "unit_count")
    if len(unitCountText) <= 0:
        return Err[bool](" compiler world libp2p: mirror bundle unit_count missing")
    let unitCount = int32(strutil.ParseInt(unitCountText))
    if unitCount <= 0 || IntToStr(unitCount) != unitCountText:
        return Err[bool](" compiler world libp2p: invalid mirror bundle unit_count")
    var units: CompilerManagedMirrorBundleUnit[]
    for i in 0..<unitCount:
        let modulePath = compilerWorldLibp2pLineValue(
            text,
            strutil.Join(["unit[", IntToStr(i), "].module_path"], ""))
        if len(modulePath) <= 0:
            return Err[bool](" compiler world libp2p: mirror bundle module path missing")
        let legacyLengthText = compilerWorldLibp2pLineValue(
            text,
            strutil.Join(["unit[", IntToStr(i), "].legacy_source_raw_byte_length"], ""))
        let legacyLength = int32(strutil.ParseInt(legacyLengthText))
        if legacyLength < 0 || IntToStr(legacyLength) != legacyLengthText:
            return Err[bool](" compiler world libp2p: invalid legacy mirror source length")
        let legacyCidRes = layout.FixedBytes32FromHex(compilerWorldLibp2pLineValue(
            text,
            strutil.Join(["unit[", IntToStr(i), "].legacy_source_cid"], "")))
        if IsErr(legacyCidRes):
            return Err[bool](" compiler world libp2p: invalid legacy mirror source cid")
        var legacyText = ""
        let decodeLegacyRes = CompilerWorldHexTextDecode(
            compilerWorldLibp2pLineValue(
                text,
                strutil.Join(["unit[", IntToStr(i), "].legacy_source_text_hex"], "")),
            legacyText)
        if IsErr(decodeLegacyRes):
            return Err[bool](Error(decodeLegacyRes))
        let migratedLengthText = compilerWorldLibp2pLineValue(
            text,
            strutil.Join(["unit[", IntToStr(i), "].migrated_source_raw_byte_length"], ""))
        let migratedLength = int32(strutil.ParseInt(migratedLengthText))
        if migratedLength < 0 || IntToStr(migratedLength) != migratedLengthText:
            return Err[bool](" compiler world libp2p: invalid migrated mirror source length")
        let migratedCidRes = layout.FixedBytes32FromHex(compilerWorldLibp2pLineValue(
            text,
            strutil.Join(["unit[", IntToStr(i), "].migrated_source_cid"], "")))
        if IsErr(migratedCidRes):
            return Err[bool](" compiler world libp2p: invalid migrated mirror source cid")
        var migratedText = ""
        let decodeMigratedRes = CompilerWorldHexTextDecode(
            compilerWorldLibp2pLineValue(
                text,
                strutil.Join(["unit[", IntToStr(i), "].migrated_source_text_hex"], "")),
            migratedText)
        if IsErr(decodeMigratedRes):
            return Err[bool](Error(decodeMigratedRes))
        var unit: CompilerManagedMirrorBundleUnit
        unit.modulePath = modulePath
        unit.legacySourceRawByteLength = legacyLength
        unit.legacySourceCid = Value(legacyCidRes)
        unit.legacySourceText = legacyText
        unit.migratedSourceRawByteLength = migratedLength
        unit.migratedSourceCid = Value(migratedCidRes)
        unit.migratedSourceText = migratedText
        add(units, unit)
    var baselineCsgText = ""
    let baselineCsgRes = CompilerWorldHexTextDecode(
        compilerWorldLibp2pLineValue(text, "baseline_csg_text_hex"),
        baselineCsgText)
    if IsErr(baselineCsgRes):
        return Err[bool](Error(baselineCsgRes))
    var migratedCsgText = ""
    let migratedCsgRes = CompilerWorldHexTextDecode(
        compilerWorldLibp2pLineValue(text, "migrated_csg_text_hex"),
        migratedCsgText)
    if IsErr(migratedCsgRes):
        return Err[bool](Error(migratedCsgRes))
    var baselineSurfaceText = ""
    let baselineSurfaceRes = CompilerWorldHexTextDecode(
        compilerWorldLibp2pLineValue(text, "baseline_surface_text_hex"),
        baselineSurfaceText)
    if IsErr(baselineSurfaceRes):
        return Err[bool](Error(baselineSurfaceRes))
    var migratedSurfaceText = ""
    let migratedSurfaceRes = CompilerWorldHexTextDecode(
        compilerWorldLibp2pLineValue(text, "migrated_surface_text_hex"),
        migratedSurfaceText)
    if IsErr(migratedSurfaceRes):
        return Err[bool](Error(migratedSurfaceRes))
    var baselineSemanticReceiptText = ""
    let baselineSemanticRes = CompilerWorldHexTextDecode(
        compilerWorldLibp2pLineValue(
            text,
            "baseline_semantic_receipt_text_hex"),
        baselineSemanticReceiptText)
    if IsErr(baselineSemanticRes):
        return Err[bool](Error(baselineSemanticRes))
    var migratedSemanticReceiptText = ""
    let migratedSemanticRes = CompilerWorldHexTextDecode(
        compilerWorldLibp2pLineValue(
            text,
            "migrated_semantic_receipt_text_hex"),
        migratedSemanticReceiptText)
    if IsErr(migratedSemanticRes):
        return Err[bool](Error(migratedSemanticRes))
    var evidenceText = ""
    let evidenceTextRes = CompilerWorldHexTextDecode(
        compilerWorldLibp2pLineValue(text, "evidence_text_hex"),
        evidenceText)
    if IsErr(evidenceTextRes):
        return Err[bool](Error(evidenceTextRes))
    var proofText = ""
    let proofTextRes = CompilerWorldHexTextDecode(compilerWorldLibp2pLineValue(text, "proof_text_hex"),
                                                    proofText)
    if IsErr(proofTextRes):
        return Err[bool](Error(proofTextRes))
    out.channel = Value(channelRes)
    out.packageId = packageId
    out.migrationProofCid = Value(proofRes)
    out.legacySourceIdentityReceiptCid = Value(legacySourceIdentityRes)
    out.migratedSourceIdentityReceiptCid = Value(migratedSourceIdentityRes)
    out.compileSemanticReceiptCid = Value(semanticReceiptRes)
    out.unitCount = unitCount
    out.units = units
    out.baselineCsgText = baselineCsgText
    out.migratedCsgText = migratedCsgText
    out.baselineSurfaceText = baselineSurfaceText
    out.migratedSurfaceText = migratedSurfaceText
    out.baselineSemanticReceiptText = baselineSemanticReceiptText
    out.migratedSemanticReceiptText = migratedSemanticReceiptText
    out.evidenceText = evidenceText
    out.proofText = proofText
    out.bundleCid = Value(bundleCidRes)
    let verifyRes = CompilerWorldManagedMirrorBundleVerify(out)
    if IsErr(verifyRes):
        return Err[bool](Error(verifyRes))
    if text != CompilerWorldManagedMirrorBundleReport(out):
        return Err[bool](" compiler world libp2p: mirror bundle report is not canonical")
    return Ok[bool](true)

fn CompilerWorldManagedMirrorAuthorizationRejected(
        message: str): Result[CompilerManagedMirrorBundle[]] =

        return Err[CompilerManagedMirrorBundle[]](
            message)

fn CompilerWorldManagedMirrorBundlePathsFromIndexText(
        text: str,
        prefixLeaf: str,
        outPackageIds: var str[],
        outProofCids: var layout.FixedBytes32[],
        outBundleCids: var layout.FixedBytes32[]): Result[str[]] =
    if prefixLeaf == "" || strutil.Contains(prefixLeaf, "/") ||
       strutil.Contains(prefixLeaf, "\\"):
        return Err[str[]](
            " compiler world libp2p: mirror index prefix leaf invalid")
    let countText = compilerWorldLibp2pLineValue(text, "count")
    if len(countText) <= 0:
        return Err[str[]](" compiler world libp2p: mirror bundle index count missing")
    let count = int32(strutil.ParseInt(countText))
    if count <= 0 || IntToStr(count) != countText:
        return Err[str[]](" compiler world libp2p: invalid mirror bundle index count")
    var out: str[]
    var canonical = strutil.Join(["count=", countText], "")
    for i in 0..<count:
        let itemPrefix = strutil.Join(["package[", IntToStr(i), "]."], "")
        let packageId = compilerWorldLibp2pLineValue(
            text,
            Fmt"{itemPrefix}package_id")
        if parser.ParserManifestNormalizePackageId(packageId) != packageId ||
           !parser.ParserSourceIdentityModuleTextValid(packageId) ||
           (i > 0 && !CompilerWorldManagedMirrorStrLess(
                outPackageIds[i - 1],
                packageId)):
            return Err[str[]](" compiler world libp2p: invalid mirror index package")
        let proofRes = layout.FixedBytes32FromHex(compilerWorldLibp2pLineValue(
            text,
            Fmt"{itemPrefix}migration_proof_cid"))
        let bundleCidRes = layout.FixedBytes32FromHex(compilerWorldLibp2pLineValue(
            text,
            Fmt"{itemPrefix}bundle_cid"))
        if IsErr(proofRes) || IsErr(bundleCidRes) ||
           layout.FixedBytes32Equal(Value(proofRes), layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(Value(bundleCidRes), layout.FixedBytes32()):
            return Err[str[]](" compiler world libp2p: invalid mirror index cid")
        let expectedPath = Fmt"{prefixLeaf}.managed_mirror.{IntToStr(i)}.txt"
        let bundlePath = compilerWorldLibp2pLineValue(
            text,
            Fmt"{itemPrefix}bundle_path")
        if bundlePath != expectedPath:
            return Err[str[]](" compiler world libp2p: non-canonical mirror index path")
        canonical = Fmt"{canonical}\n{itemPrefix}package_id={packageId}\n{itemPrefix}migration_proof_cid={layout.FixedBytes32Hex(Value(proofRes))}\n{itemPrefix}bundle_cid={layout.FixedBytes32Hex(Value(bundleCidRes))}\n{itemPrefix}bundle_path={expectedPath}"
        add(outPackageIds, packageId)
        add(outProofCids, Value(proofRes))
        add(outBundleCids, Value(bundleCidRes))
        add(out, expectedPath)
    if text != canonical:
        return Err[str[]](" compiler world libp2p: mirror index is not canonical")
    return Ok[str[]](out)

fn CompilerWorldManagedMirrorMaterializedFileAppend(
        files: var CompilerManagedMirrorMaterializedFile[],
        relativePath: str,
        text: str): Result[bool] =
    var canonicalPath: str
    if !parser.ParserSourceIdentityLexicalPathInto(relativePath,
                                                   canonicalPath) ||
       canonicalPath != relativePath ||
       parser.ParserSourceIdentityPathAbsolute(relativePath):
        return Err[bool](
            " compiler world libp2p: non-canonical mirror materialized path")
    for index in 0..<files.len:
        if files[index].relativePath == relativePath:
            return Err[bool](
                " compiler world libp2p: duplicate mirror materialized path")
    var file: CompilerManagedMirrorMaterializedFile
    file.relativePath = relativePath
    file.text = text
    add(files, file)
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorSourceRelativePath(
        packageId: str,
        modulePath: str,
        out: var str): Result[bool] =
    return cworld.CompilerManagedMirrorSourceRelativePath(
        packageId,
        modulePath,
        out)

@borrows
fn CompilerWorldManagedMirrorMaterializedFiles(
        bundle: CompilerManagedMirrorBundle,
        out: var CompilerManagedMirrorMaterializedFile[]): Result[bool] =
    var files: CompilerManagedMirrorMaterializedFile[]
    var sourcePaths: str[]
    for unitIndex in 0..<bundle.units.len:
        var relativePath: str
        let pathRes = CompilerWorldManagedMirrorSourceRelativePath(
            strings.CloneStr(bundle.packageId),
            strings.CloneStr(bundle.units[unitIndex].modulePath),
            relativePath)
        if IsErr(pathRes):
            return Err[bool](Error(pathRes))
        add(sourcePaths, relativePath)
    var sourcesText = ""
    for sourceIndex in 0..<sourcePaths.len:
        sourcesText = strutil.Join([
            strings.CloneStr(sourcesText),
            strings.CloneStr(sourcePaths[sourceIndex]),
            "\n"], "")
    let fixedPaths = [
        "bundle.txt",
        "cheng-package.toml",
        "sources.list.txt",
        ".cheng-mirror/baseline.csg.txt",
        ".cheng-mirror/migrated.csg.txt",
        ".cheng-mirror/baseline.surface.txt",
        ".cheng-mirror/migrated.surface.txt",
        ".cheng-mirror/baseline.semantic_receipt.txt",
        ".cheng-mirror/migrated.semantic_receipt.txt",
        ".cheng-mirror/evidence.txt",
        ".cheng-mirror/proof.txt"
    ]
    let fixedTexts = [
        CompilerWorldManagedMirrorBundleReport(bundle),
        CompilerWorldMirrorPackageManifestText(bundle.packageId),
        strings.CloneStr(sourcesText),
        strings.CloneStr(bundle.baselineCsgText),
        strings.CloneStr(bundle.migratedCsgText),
        strings.CloneStr(bundle.baselineSurfaceText),
        strings.CloneStr(bundle.migratedSurfaceText),
        strings.CloneStr(bundle.baselineSemanticReceiptText),
        strings.CloneStr(bundle.migratedSemanticReceiptText),
        strings.CloneStr(bundle.evidenceText),
        strings.CloneStr(bundle.proofText)
    ]
    for fixedIndex in 0..<fixedPaths.len:
        let appendRes = CompilerWorldManagedMirrorMaterializedFileAppend(
            files,
            strings.CloneStr(fixedPaths[fixedIndex]),
            strings.CloneStr(fixedTexts[fixedIndex]))
        if IsErr(appendRes):
            return Err[bool](Error(appendRes))
    for sourceIndex in 0..<sourcePaths.len:
        let appendRes = CompilerWorldManagedMirrorMaterializedFileAppend(
            files,
            strings.CloneStr(sourcePaths[sourceIndex]),
            strings.CloneStr(bundle.units[sourceIndex].migratedSourceText))
        if IsErr(appendRes):
            return Err[bool](Error(appendRes))
    var marker = strutil.Join([
        "bundle_cid=",
        layout.FixedBytes32Hex(bundle.bundleCid),
        "\nfile_count=",
        IntToStr(files.len)
    ], "")
    for fileIndex in 0..<files.len:
        marker = strutil.Join([
            strings.CloneStr(marker),
            "\nfile[",
            IntToStr(fileIndex),
            "].path=",
            strings.CloneStr(files[fileIndex].relativePath),
            "\nfile[",
            IntToStr(fileIndex),
            "].raw_byte_length=",
            IntToStr(files[fileIndex].text.len),
            "\nfile[",
            IntToStr(fileIndex),
            "].content_cid=",
            layout.FixedBytes32Hex(
                CompilerWorldManagedMirrorSourceCid(
                    strings.CloneStr(files[fileIndex].text)))
        ], "")
    let markerRes = CompilerWorldManagedMirrorMaterializedFileAppend(
        files,
        ".cheng-mirror/commit.txt",
        strings.CloneStr(marker))
    if IsErr(markerRes):
        return Err[bool](Error(markerRes))
    out = files
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorAtomicWriteText(
        handle: os.AtomicTree,
        relativePath: str,
        text: str): Result[bool] =
    var bytes = CompilerWorldLibp2pOwnedBytesFromText(text)
    let writeRes = os.AtomicTreeWriteExclusiveSync(handle,
                                                    relativePath,
                                                    bytes)
    rawbytes.BytesFree(bytes)
    return writeRes

fn CompilerWorldManagedMirrorSortedPathInsert(
        paths: var str[],
        path: str): Result[bool] =
    for index in 0..<paths.len:
        if paths[index] == path:
            return Ok[bool](false)
    var insertAt = paths.len
    while insertAt > 0 && CompilerWorldManagedMirrorStrLess(
            path,
            paths[insertAt - 1]):
        insertAt = insertAt - 1
    add(paths, share(path))
    var cursor = paths.len - 1
    while cursor > insertAt:
        paths[cursor] = paths[cursor - 1]
        cursor = cursor - 1
    paths[insertAt] = path
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorExpectedTree(
        files: CompilerManagedMirrorMaterializedFile[],
        outDirs: var str[],
        outFiles: var str[]): Result[bool] =
    var dirs: str[]
    var filePaths: str[]
    for fileIndex in 0..<files.len:
        let relativePath = files[fileIndex].relativePath
        let fileRes = CompilerWorldManagedMirrorSortedPathInsert(
            filePaths,
            strings.CloneStr(relativePath))
        if IsErr(fileRes) || !Value(fileRes):
            return Err[bool](
                " compiler world libp2p: duplicate expected mirror file")
        for charIndex in 0..<relativePath.len:
            if relativePath[charIndex] != '/':
                continue
            let dir = chengpath.TextSlice(relativePath,
                                          0,
                                          charIndex)
            if dir == "":
                return Err[bool](
                    " compiler world libp2p: empty expected mirror directory")
            let dirRes = CompilerWorldManagedMirrorSortedPathInsert(
                dirs,
                dir)
            if IsErr(dirRes):
                return Err[bool](Error(dirRes))
    outDirs = dirs
    outFiles = filePaths
    return Ok[bool](true)

fn CompilerWorldManagedMirrorAtomicAbortError(
        handle: os.AtomicTree,
        primaryError: str): Result[str] =
    let abortRes = os.AtomicTreeAbort(handle)
    if IsErr(abortRes):
        return Err[str](strutil.Join([
            strings.CloneStr(primaryError),
            "; atomic staging abort failed: ",
            strings.CloneStr(Error(abortRes))
        ], ""))
    return Err[str](strings.CloneStr(primaryError))

@borrows
fn CompilerWorldManagedMirrorVerifyHandle(
        handle: os.AtomicTree,
        expectedBundle: CompilerManagedMirrorBundle,
        expectedFiles: CompilerManagedMirrorMaterializedFile[],
        expectedDirs: str[],
        expectedFilePaths: str[]): Result[bool] =
    let committedTreeRes =
        cworld.CompilerManagedMirrorCommittedTreeVerifyHandle(
            handle,
            expectedBundle.bundleCid)
    if IsErr(committedTreeRes):
        return Err[bool](Error(committedTreeRes))
    let exactTreeRes = os.AtomicTreeVerifyExact(handle,
                                                expectedDirs,
                                                expectedFilePaths)
    if IsErr(exactTreeRes):
        return Err[bool](Error(exactTreeRes))
    var parsedBundle: CompilerManagedMirrorBundle
    var bundleParsed = false
    for fileIndex in 0..<expectedFiles.len:
        let readRes = os.AtomicTreeReadStable(
            handle,
            expectedFiles[fileIndex].relativePath)
        if IsErr(readRes):
            return Err[bool](Error(readRes))
        var actualBytes = Value(readRes)
        var expectedBytes = CompilerWorldLibp2pOwnedBytesFromText(
            expectedFiles[fileIndex].text)
        let exact = rawbytes.BytesEqual(actualBytes, expectedBytes)
        let actualText = cworld.CompilerWorldOwnText(
            rawbytes.BytesToString(actualBytes))
        let actualCid = CompilerWorldManagedMirrorSourceCid(actualText)
        let expectedCid = CompilerWorldManagedMirrorSourceCid(
            expectedFiles[fileIndex].text)
        rawbytes.BytesFree(actualBytes)
        rawbytes.BytesFree(expectedBytes)
        if !exact || !layout.FixedBytes32Equal(actualCid, expectedCid):
            return Err[bool](strutil.Join([
                " compiler world libp2p: installed mirror file mismatch: ",
                strings.CloneStr(expectedFiles[fileIndex].relativePath)
            ], ""))
        if expectedFiles[fileIndex].relativePath == "bundle.txt":
            let parseRes = CompilerWorldManagedMirrorBundleFromReportText(
                actualText,
                parsedBundle)
            if IsErr(parseRes):
                return Err[bool](Error(parseRes))
            bundleParsed = true
    if !bundleParsed ||
       !layout.FixedBytes32Equal(parsedBundle.bundleCid,
                                 expectedBundle.bundleCid):
        return Err[bool](
            " compiler world libp2p: installed bundle identity mismatch")
    return Ok[bool](true)

@borrows
fn CompilerWorldManagedMirrorVerifyInstalled(
        parentPath: str,
        finalName: str,
        expectedBundle: CompilerManagedMirrorBundle,
        expectedFiles: CompilerManagedMirrorMaterializedFile[],
        expectedDirs: str[],
        expectedFilePaths: str[]): Result[str] =
    let openRes = os.AtomicTreeOpenVerified(parentPath, finalName)
    if IsErr(openRes):
        return Err[str](Error(openRes))
    let handle = Value(openRes)
    let verifyRes = CompilerWorldManagedMirrorVerifyHandle(
        handle,
        expectedBundle,
        expectedFiles,
        expectedDirs,
        expectedFilePaths)
    let closeRes = os.AtomicTreeClose(handle)
    if IsErr(verifyRes):
        if IsErr(closeRes):
            return Err[str](strutil.Join([
                Error(verifyRes),
                "; verified tree close failed: ",
                Error(closeRes)
            ], ""))
        return Err[str](Error(verifyRes))
    if IsErr(closeRes):
        return Err[str](Error(closeRes))
    return Ok[str](strutil.Join([
        strings.CloneStr(parentPath),
        "/",
        strings.CloneStr(finalName)], ""))

@borrows
fn CompilerWorldManagedMirrorMaterialize(rootDir: str,
                                           bundle: CompilerManagedMirrorBundle): Result[str] =
    let verifyRes = CompilerWorldManagedMirrorBundleVerify(bundle)
    if IsErr(verifyRes):
        return Err[str](Error(verifyRes))
    let finalRoot = cworld.CompilerManagedMirrorRoot(rootDir,
                                                      bundle.channel,
                                                      bundle.packageId,
                                                      bundle.bundleCid)
    let parentPath = chengpath.PathParentDir(finalRoot)
    let finalName = layout.FixedBytes32Hex(bundle.bundleCid)
    var files: CompilerManagedMirrorMaterializedFile[]
    let filesRes = CompilerWorldManagedMirrorMaterializedFiles(
        bundle,
        files)
    if IsErr(filesRes):
        return Err[str](Error(filesRes))
    var expectedDirs: str[]
    var expectedFilePaths: str[]
    let expectedTreeRes = CompilerWorldManagedMirrorExpectedTree(
        files,
        expectedDirs,
        expectedFilePaths)
    if IsErr(expectedTreeRes):
        return Err[str](Error(expectedTreeRes))
    let stagingName = strutil.Join([
        ".staging-",
        strings.CloneStr(finalName),
        "-",
        IntToStr(os.ProcessId()),
        "-",
        strings.Int64ToStr(monotimes.MonoTimeNs(monotimes.GetMonoTime()))
    ], "")
    let beginRes = os.AtomicTreeBegin(parentPath,
                                      stagingName,
                                      finalName)
    if IsErr(beginRes):
        return Err[str](Error(beginRes))
    let handle = Value(beginRes)
    for dirIndex in 0..<expectedDirs.len:
        let mkdirRes = os.AtomicTreeMkdir(handle,
                                          expectedDirs[dirIndex])
        if IsErr(mkdirRes):
            return CompilerWorldManagedMirrorAtomicAbortError(
                handle,
                strings.CloneStr(Error(mkdirRes)))
    for fileIndex in 0..<files.len:
        let relativePath = files[fileIndex].relativePath
        let writeRes = CompilerWorldManagedMirrorAtomicWriteText(
            handle,
            relativePath,
            files[fileIndex].text)
        if IsErr(writeRes):
            return CompilerWorldManagedMirrorAtomicAbortError(
                handle,
                strings.CloneStr(Error(writeRes)))
    let stagedVerifyRes = CompilerWorldManagedMirrorVerifyHandle(
        handle,
        bundle,
        files,
        expectedDirs,
        expectedFilePaths)
    if IsErr(stagedVerifyRes):
        return CompilerWorldManagedMirrorAtomicAbortError(
            handle,
            strings.CloneStr(Error(stagedVerifyRes)))
    let commitRes = os.AtomicTreeCommitNoReplace(handle)
    if IsErr(commitRes):
        return CompilerWorldManagedMirrorAtomicAbortError(
            handle,
            strings.CloneStr(Error(commitRes)))
    if Value(commitRes) == os.AtomicTreeCommitted:
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            return Err[str](Error(closeRes))
    elif Value(commitRes) == os.AtomicTreeDestinationExists:
        let abortRes = os.AtomicTreeAbort(handle)
        if IsErr(abortRes):
            return Err[str](Error(abortRes))
    elif Value(commitRes) == os.AtomicTreeCommittedDurabilityUnknown:
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            return Err[str](strutil.Join([
                " compiler world libp2p: committed mirror durability is unknown; close failed: ",
                Error(closeRes)
            ], ""))
        return Err[str](
            " compiler world libp2p: committed mirror durability is unknown")
    else:
        panic("compiler world libp2p: impossible atomic tree commit result")
    return CompilerWorldManagedMirrorVerifyInstalled(
        parentPath,
        finalName,
        bundle,
        files,
        expectedDirs,
        expectedFilePaths)

@borrows
fn CompilerWorldMaterializeManagedMirrorBundles(
        rootDir: str,
        manifest: cworld.CompilerUniverseManifest,
        receipt: CompilerManagedDependencyReceipt,
        candidates: CompilerManagedMirrorBundle[]): Result[int32] =
    let bundlesRes = CompilerWorldManagedMirrorBundlesAuthorized(
        manifest,
        receipt,
        candidates)
    if IsErr(bundlesRes):
        return Err[int32](Error(bundlesRes))
    let bundles = Value(bundlesRes)
    var count = 0
    for i in 0..<bundles.len:
        let materializeRes = CompilerWorldManagedMirrorMaterialize(rootDir, bundles[i])
        if IsErr(materializeRes):
            return Err[int32](Error(materializeRes))
        count = count + 1
    return Ok[int32](count)

fn CompilerWorldManagedMirrorMaterializeReport(prefix: str,
                                                 materializedMirrorCount: int32): str =
    var out = ""
    out = strutil.Join([out, "bundle_prefix=", prefix, "\n"], "")
    out = strutil.Join([out, "managed_mirror_count=", IntToStr(materializedMirrorCount)], "")
    return out
