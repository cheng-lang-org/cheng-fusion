// cheng_build.cheng — multi-module package build system skeleton
//
// Key insight: compile each module to .o (--emit:obj works for single modules),
// then system-link all .o files together via the system linker (cc).
// This bypasses the linkerless exe path's C bridge limitation.

import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/host_ops as hostops

type
    // BuildPlan: list of source files to compile, in dependency order
    BuildPlan =
        entryPath: str
        rootDir: str
        targetTriple: str
        sourceFiles: str[]
        sourceCount: int32

    // Single compilation result
    BuildCompileResult =
        sourcePath: str
        objectPath: str
        exitCode: int32
        log: str
        ok: bool

    // Full build result
    BuildResult =
        compileResults: BuildCompileResult[]
        compileCount: int32
        compileOk: int32
        linkExitCode: int32
        linkOk: bool
        outPath: str
        log: str

const
    BuildDefaultTargetTriple = "arm64-apple-darwin"

// ============================================================
// BuildPlan construction
// ============================================================

fn BuildPlanMake(entryPath: str,
                 rootDir: str,
                 targetTriple: str,
                 sourceFiles: str[]): BuildPlan =
    var plan: BuildPlan
    plan.entryPath = entryPath
    plan.rootDir = rootDir
    plan.targetTriple = targetTriple
    plan.sourceFiles = sourceFiles
    plan.sourceCount = sourceFiles.len
    return plan

// Scan a single source file for import lines and return resolved paths.
fn BuildScanImports(rootDir: str,
                    sourcePath: str,
                    visited: var str[]): str[] =
    var imports: str[]
    if !chengpath.PathFileExists(sourcePath):
        return imports
    let text = chengpath.ReadTextFile(rootDir, sourcePath)
    let lines = strutil.Split(text, '\n')
    var i: int32
    while i < lines.len:
        let line = strutil.Strip(lines[i])
        if strutil.StartsWith(line, "import "):
            if !strutil.StartsWith(line, "importc"):
                let rest = strutil.Strip(chengpath.TextSlice(line, 7, line.len - 7))
                if rest.len > 0:
                    var relPath = ""
                    if strutil.StartsWith(rest, "cheng/"):
                        relPath = strutil.Join(["src/", chengpath.TextSlice(rest, 6, rest.len - 6), ".cheng"], "")
                    elif strutil.StartsWith(rest, "std/"):
                        relPath = strutil.Join(["src/std/", chengpath.TextSlice(rest, 4, rest.len - 4), ".cheng"], "")
                    else:
                        relPath = strutil.Join([rest, ".cheng"], "")
                    let fullPath = os.JoinPath(rootDir, relPath)
                    var alreadyVisited = false
                    var j: int32
                    while j < visited.len:
                        if visited[j] == fullPath:
                            alreadyVisited = true
                            j = visited.len
                        j = j + 1
                    if !alreadyVisited && chengpath.PathFileExists(fullPath):
                        add(visited, fullPath)
                        add(imports, fullPath)
                        let transitive = BuildScanImports(rootDir, fullPath, visited)
                        var ti: int32
                        while ti < transitive.len:
                            var dup = false
                            var k: int32
                            while k < imports.len:
                                if imports[k] == transitive[ti]:
                                    dup = true
                                    k = imports.len
                                k = k + 1
                            if !dup:
                                add(imports, transitive[ti])
                            ti = ti + 1
        i = i + 1
    return imports

fn BuildPlanFromEntry(entryPath: str,
                      rootDir: str,
                      targetTriple: str): BuildPlan =
    var visited: str[]
    var sourceFiles: str[]
    let absEntry = chengpath.PathAbsolute(rootDir, entryPath)
    let transitive = BuildScanImports(rootDir, absEntry, visited)
    var i: int32
    while i < transitive.len:
        add(sourceFiles, transitive[i])
        i = i + 1
    var entryIncluded = false
    var j: int32
    while j < sourceFiles.len:
        if sourceFiles[j] == absEntry:
            entryIncluded = true
            j = sourceFiles.len
        j = j + 1
    if !entryIncluded:
        add(sourceFiles, absEntry)
    let objDir = os.JoinPath(rootDir, "_build/obj")
    let _ = chengpath.PathCreateDirAll(objDir)
    return BuildPlanMake(absEntry, rootDir, targetTriple, sourceFiles)

// ============================================================
// Compilation: compile each module to .o
// ============================================================

fn BuildCompilerPath(rootDir: str): str =
    let envPath = os.GetEnv("CHENG_COLD")
    if envPath.len > 0:
        return envPath
    return os.JoinPath(rootDir, "artifacts/backend_driver/cheng")

fn BuildObjectPath(rootDir: str, sourcePath: str): str =
    let objDir = os.JoinPath(rootDir, "_build/obj")
    let split = chengpath.PathSplitFile(sourcePath)
    return os.JoinPath(objDir, strutil.Join([split.name, ".o"], ""))

fn BuildCompileOne(plan: BuildPlan,
                   sourcePath: str,
                   compilerPath: str): BuildCompileResult =
    var result: BuildCompileResult
    result.sourcePath = sourcePath
    result.objectPath = BuildObjectPath(plan.rootDir, sourcePath)
    result.ok = false
    let objDir = os.JoinPath(plan.rootDir, "_build/obj")
    let _ = chengpath.PathCreateDirAll(objDir)
    let splitName = chengpath.PathSplitFile(sourcePath)
    let label = strutil.Join(["cheng_build_compile_", splitName.name], "")
    let logPath = strutil.Join([result.objectPath, ".compile.log"], "")
    var compileArgs: str[]
    add(compileArgs, "system-link-exec")
    add(compileArgs, strutil.Join(["--root:", plan.rootDir], ""))
    add(compileArgs, strutil.Join(["--in:", sourcePath], ""))
    add(compileArgs, "--emit:obj")
    add(compileArgs, strutil.Join(["--target:", plan.targetTriple], ""))
    add(compileArgs, strutil.Join(["--out:", result.objectPath], ""))
    var emptyEnv: str[]
    let run = hostops.RunFileLogged(plan.rootDir,
                                     label,
                                     compilerPath,
                                     compileArgs,
                                     emptyEnv,
                                     plan.rootDir,
                                     120,
                                     logPath)
    result.exitCode = run.exitCode
    result.log = run.output
    if hostops.LoggedRunOk(run):
        if chengpath.PathFileExists(result.objectPath):
            result.ok = true
    return result

fn BuildCompileAll(plan: BuildPlan): BuildResult =
    var result: BuildResult
    result.outPath = ""
    result.linkOk = false
    let compilerPath = BuildCompilerPath(plan.rootDir)
    if !chengpath.PathFileExists(compilerPath):
        result.log = strutil.Join(["cheng build: compiler not found: ", compilerPath], "")
        return result
    var compileResults: BuildCompileResult[]
    var compileOkCount: int32
    var i: int32
    while i < plan.sourceFiles.len:
        let src = plan.sourceFiles[i]
        let cr = BuildCompileOne(plan, src, compilerPath)
        add(compileResults, cr)
        if cr.ok:
            compileOkCount = compileOkCount + 1
        i = i + 1
    result.compileResults = compileResults
    result.compileCount = plan.sourceFiles.len
    result.compileOk = compileOkCount
    return result

// ============================================================
// Linking: system-link all .o files into executable
// ============================================================

fn BuildLinkAll(plan: BuildPlan,
                outPath: str): BuildResult =
    var result: BuildResult
    result.outPath = outPath
    result.linkOk = false
    result = BuildCompileAll(plan)
    if result.compileOk < result.compileCount:
        result.log = strutil.Join(["cheng build: compile failed (", IntToStr(result.compileOk), "/", IntToStr(result.compileCount), " ok)"], "")
        return result
    var objectPaths: str[]
    var i: int32
    while i < result.compileResults.len:
        let cr = result.compileResults[i]
        if cr.ok:
            add(objectPaths, cr.objectPath)
        i = i + 1
    if objectPaths.len <= 0:
        result.linkOk = false
        result.log = "cheng build: no object files to link"
        return result
    let absOut = chengpath.PathAbsolute(plan.rootDir, outPath)
    let outDir = chengpath.PathParentDir(absOut)
    let _ = chengpath.PathCreateDirAll(outDir)
    let logPath = strutil.Join([absOut, ".link.log"], "")
    var linkArgs: str[]
    add(linkArgs, "-o")
    add(linkArgs, absOut)
    var j: int32
    while j < objectPaths.len:
        add(linkArgs, strings.CloneStr(objectPaths[j]))
        j = j + 1
    var emptyEnv: str[]
    let linkRun = hostops.RunProgramLogged(plan.rootDir,
                                            "cheng_build_link",
                                            "cc",
                                            linkArgs,
                                            emptyEnv,
                                            plan.rootDir,
                                            120,
                                            logPath)
    result.linkExitCode = linkRun.exitCode
    result.log = linkRun.output
    result.linkOk = linkRun.exitCode == 0
    if result.linkOk:
        if chengpath.PathFileExists(absOut):
            result.log = strutil.Join(["cheng build: linked ", absOut, " (", IntToStr(objectPaths.len), " objects)"], "")
        else:
            result.linkOk = false
            result.log = strutil.Join(["cheng build: linker produced no output: ", absOut], "")
    return result

// ============================================================
// BuildPlan debug / serialization
// ============================================================

fn BuildPlanToString(plan: BuildPlan): str =
    var out = "BuildPlan("
    out = strutil.Join([out, plan.entryPath, ")\n"], "")
    out = strutil.Join([out, "  target: ", plan.targetTriple, "\n"], "")
    out = strutil.Join([out, "  sources: ", IntToStr(plan.sourceCount), "\n"], "")
    var i: int32
    while i < plan.sourceFiles.len:
        out = strutil.Join([out, "    [", IntToStr(i), "] ", plan.sourceFiles[i], "\n"], "")
        i = i + 1
    return out

fn BuildResultToString(result: BuildResult): str =
    var out = strutil.Join(["BuildResult: compile ", IntToStr(result.compileOk), "/", IntToStr(result.compileCount), " ok, link "], "")
    if result.linkOk:
        out = strutil.Join([out, "ok, out=", strings.CloneStr(result.outPath)], "")
    else:
        out = strutil.Join([out, "FAIL"], "")
    out = strutil.Join([out, "\n"], "")
    return out
