import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    CompilerExecutionIdentityDomain: str = "cheng.compiler.execution_identity"
    ExecutionStageReceiptDomain: str = "cheng.compiler.execution_stage_receipt"
    CompilerSevenStageReceiptDomain: str = "cheng.compiler.seven_stage_execution_root"
    CompilerToolchainEncoderAuthorityBuildProjectionDomain: str =
        "cheng.compiler.toolchain_encoder_authority_build_projection"
    CompilerToolchainEncoderAuthorityBuildProjectionReceiptDomain: str =
        "cheng.compiler.toolchain_encoder_authority_build_projection_receipt"

    ExecutionStageReceiptStageParser: str = "parser"
    ExecutionStageReceiptStageTypedExpr: str = "typed_expr"
    ExecutionStageReceiptStageCsg: str = "csg"
    ExecutionStageReceiptStageLowering: str = "lowering"
    ExecutionStageReceiptStagePrimary: str = "primary"
    ExecutionStageReceiptStagePrimaryRegalloc: str = "primary_regalloc"
    ExecutionStageReceiptStageBackend2: str = "backend2"
    ExecutionStageReceiptStageBackend2Regalloc: str = "backend2_regalloc"

    ExecutionStageReceiptLaneShared: str = "shared"
    ExecutionStageReceiptLanePrimary: str = "primary"
    ExecutionStageReceiptLaneBackend2: str = "backend2"

    ExecutionStageReceiptTypedExprSidecarSchema: str = "cheng.compiler.stage_semantic_sidecar.typed_expr"
    ExecutionStageReceiptCsgSidecarSchema: str = "cheng.compiler.stage_semantic_sidecar.csg"
    ExecutionStageReceiptLoweringSidecarSchema: str = "cheng.compiler.stage_semantic_sidecar.lowering"
    ExecutionStageReceiptPrimarySidecarSchema: str = "cheng.compiler.stage_semantic_sidecar.primary"
    ExecutionStageReceiptPrimaryRegallocSidecarSchema: str = "cheng.compiler.stage_semantic_sidecar.primary_regalloc"
    ExecutionStageReceiptBackend2SidecarSchema: str = "cheng.compiler.stage_semantic_sidecar.backend2"
    ExecutionStageReceiptBackend2RegallocSidecarSchema: str = "cheng.compiler.stage_semantic_sidecar.backend2_regalloc"

    ExecutionStageReceiptTypedExprArtifactKind: str = "typed_expr_fact_table"
    ExecutionStageReceiptCsgArtifactKind: str = "compiler_csg_facts"
    ExecutionStageReceiptLoweringArtifactKind: str = "lowering_body_ir"
    ExecutionStageReceiptPrimaryArtifactKind: str = "primary_emission_ledger"
    ExecutionStageReceiptPrimaryRegallocArtifactKind: str = "primary_regalloc_plan_action_fragment_symbol_bytes"
    ExecutionStageReceiptBackend2ArtifactKind: str = "backend2_emission_ledger"
    ExecutionStageReceiptBackend2RegallocArtifactKind: str = "backend2_regalloc_plan_action_fragment_symbol_bytes"

type
    # All hashes are required observations.  In particular, the empty-input
    # digest is rejected, so absent materializer/toolchain/config inputs cannot
    # be represented by a deterministic placeholder and later called evidence.
    CompilerExecutionIdentity =
        caseId: str
        sourceBundleRaw32: layout.FixedBytes32
        materializerBytesRaw32: layout.FixedBytes32
        grammarObligationRootRaw32: layout.FixedBytes32
        compilerSourceClosureRaw32: layout.FixedBytes32
        driverBytesRaw32: layout.FixedBytes32
        toolchainManifestRaw32: layout.FixedBytes32
        commandManifestRaw32: layout.FixedBytes32
        targetTriple: str
        executionRaw32: layout.FixedBytes32

    # This is only the inner, architecture-neutral build projection receipt.
    # It proves field/hash consistency but does not issue runtime authority.
    # The production projector must additionally prove a live lowering
    # authority and import official compiler-byte evidence.  This value retains
    # no paths or managed text: source/module identities stay canonical int32
    # rows in the CompilerCSG domain.
    CompilerToolchainEncoderAuthorityBuildProjectionReceipt =
        buildAuthorityCid: layout.FixedBytes32
        compilerCsgArtifactCid: layout.FixedBytes32
        compilerCsgGraphCid: layout.FixedBytes32
        compilerCsgCanonicalGraphCid: layout.FixedBytes32
        compilerCsgSourceBundleCid: layout.FixedBytes32
        compilerCsgCargoCid: layout.FixedBytes32
        compilerCsgFactsRootCid: layout.FixedBytes32
        compilerCsgCargoObjectReceiptCid: layout.FixedBytes32
        producerRow: int32
        canonicalRow: int32
        modulePathTextId: int32
        documentCid: layout.FixedBytes32
        contentCid: layout.FixedBytes32
        projectionCid: layout.FixedBytes32
        receiptCid: layout.FixedBytes32

    # Counts are deliberately absent.  Each producer must supply its complete
    # canonical semantic sidecar bytes and its real stage artifact bytes.  The
    # receipt binds both byte streams, their paths, the semantic transition,
    # the exact producer source, and the predecessor receipt.
    ExecutionStageReceipt =
        stageOrdinal: int32
        stageKind: str
        laneKind: str
        producerSourceRaw32: layout.FixedBytes32
        executionRaw32: layout.FixedBytes32
        predecessorStageKind: str
        predecessorReceiptRaw32: layout.FixedBytes32
        inputSemanticRaw32: layout.FixedBytes32
        # Derived from sidecarBytesRaw32 by MakeObserved; callers cannot pick
        # an unrelated semantic root and still form a valid receipt.
        outputSemanticRaw32: layout.FixedBytes32
        sidecarSchema: str
        sidecarPath: str
        sidecarByteLength: int64
        sidecarBytesRaw32: layout.FixedBytes32
        artifactKind: str
        artifactPath: str
        artifactByteLength: int64
        artifactBytesRaw32: layout.FixedBytes32
        receiptRaw32: layout.FixedBytes32

    # The validator is a monotonic state machine.  It accepts each stage only
    # with the observed sidecar/artifact bytes present, then retains just the
    # seven receipt/output roots needed to validate the branch topology.
    CompilerSevenStageReceiptValidator =
        active: bool
        executionRaw32: layout.FixedBytes32
        parserReceiptRaw32: layout.FixedBytes32
        parserSemanticRaw32: layout.FixedBytes32
        nextStageOrdinal: int32
        stageReceiptRaw32s: layout.FixedBytes32[]
        stageOutputSemanticRaw32s: layout.FixedBytes32[]

fn compilerExecutionReceiptAppendU32BE(buf: var layout.ByteBuf,
                                         value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn compilerExecutionReceiptAppendU64BE(buf: var layout.ByteBuf,
                                         value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn compilerExecutionReceiptAppendText(buf: var layout.ByteBuf, value: str) =
    compilerExecutionReceiptAppendU32BE(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

fn compilerExecutionReceiptAppendI32(buf: var layout.ByteBuf, value: int32) =
    compilerExecutionReceiptAppendU32BE(buf, 4)
    compilerExecutionReceiptAppendU32BE(buf, value)

fn compilerExecutionReceiptAppendI64(buf: var layout.ByteBuf, value: int64) =
    compilerExecutionReceiptAppendU32BE(buf, 8)
    compilerExecutionReceiptAppendU64BE(buf, value)

@borrows
fn compilerExecutionReceiptAppendFixed32(buf: var layout.ByteBuf,
                                            value: layout.FixedBytes32) =
    compilerExecutionReceiptAppendU32BE(buf, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn compilerExecutionReceiptHashObservedBytes(
        value: rawbytes.Bytes): layout.FixedBytes32 =
    return hash256.Sha256Fixed(layout.ByteSpanFromBytes(value))

fn compilerExecutionReceiptEmptyRaw32(): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(0)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn compilerExecutionReceiptRaw32Observed(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(value,
                                     compilerExecutionReceiptEmptyRaw32())

@borrows
fn compilerExecutionReceiptVisibleText(value: str): bool =
    if value.len <= 0 || value.len > 255:
        return false
    for index in 0..<value.len:
        let current = Int32(value[index])
        if current < 33 || current > 126:
            return false
    return true

@borrows
fn compilerExecutionReceiptPathSegmentDot(path: str,
                                             start: int32,
                                             stop: int32): bool =
    if stop - start == 1:
        return Int32(path[start]) == 46
    if stop - start == 2:
        return Int32(path[start]) == 46 && Int32(path[start + 1]) == 46
    return false

@borrows
fn compilerExecutionReceiptCanonicalRelativePath(path: str): bool =
    if path.len <= 0 || path.len > 4096:
        return false
    var segmentStart: int32
    for index in 0..<path.len:
        let current = Int32(path[index])
        if current < 33 || current > 126 || current == 92 || current == 58:
            return false
        if current == 47:
            if index == segmentStart ||
               compilerExecutionReceiptPathSegmentDot(path,
                                                         segmentStart,
                                                         index):
                return false
            segmentStart = index + 1
    if segmentStart >= path.len:
        return false
    return !compilerExecutionReceiptPathSegmentDot(path,
                                                      segmentStart,
                                                      path.len)

@borrows
fn CompilerExecutionIdentityObservedRaw32(
        observedBytes: rawbytes.Bytes): Result[layout.FixedBytes32] =
    if rawbytes.BytesLen(observedBytes) <= 0:
        return Err[layout.FixedBytes32](
            " compiler execution identity: observed bytes are empty")
    return Ok[layout.FixedBytes32](
        compilerExecutionReceiptHashObservedBytes(observedBytes))

@borrows
fn compilerExecutionIdentityFieldsValid(
        caseId: str,
        sourceBundleRaw32: layout.FixedBytes32,
        materializerBytesRaw32: layout.FixedBytes32,
        grammarObligationRootRaw32: layout.FixedBytes32,
        compilerSourceClosureRaw32: layout.FixedBytes32,
        driverBytesRaw32: layout.FixedBytes32,
        toolchainManifestRaw32: layout.FixedBytes32,
        commandManifestRaw32: layout.FixedBytes32,
        targetTriple: str): Result[bool] =
    if !compilerExecutionReceiptVisibleText(caseId):
        return Err[bool](
            " compiler execution identity: invalid case id")
    if !compilerExecutionReceiptVisibleText(targetTriple):
        return Err[bool](
            " compiler execution identity: invalid target triple")
    if !compilerExecutionReceiptRaw32Observed(sourceBundleRaw32):
        return Err[bool](
            " compiler execution identity: source bundle is absent")
    if !compilerExecutionReceiptRaw32Observed(materializerBytesRaw32):
        return Err[bool](
            " compiler execution identity: materializer bytes are absent")
    if !compilerExecutionReceiptRaw32Observed(grammarObligationRootRaw32):
        return Err[bool](
            " compiler execution identity: grammar obligation root is absent")
    if !compilerExecutionReceiptRaw32Observed(compilerSourceClosureRaw32):
        return Err[bool](
            " compiler execution identity: compiler source closure is absent")
    if !compilerExecutionReceiptRaw32Observed(driverBytesRaw32):
        return Err[bool](
            " compiler execution identity: driver bytes are absent")
    if !compilerExecutionReceiptRaw32Observed(toolchainManifestRaw32):
        return Err[bool](
            " compiler execution identity: toolchain manifest is absent")
    if !compilerExecutionReceiptRaw32Observed(commandManifestRaw32):
        return Err[bool](
            " compiler execution identity: command manifest is absent")
    return Ok[bool](true)

@borrows
fn compilerExecutionIdentityRaw32(
        caseId: str,
        sourceBundleRaw32: layout.FixedBytes32,
        materializerBytesRaw32: layout.FixedBytes32,
        grammarObligationRootRaw32: layout.FixedBytes32,
        compilerSourceClosureRaw32: layout.FixedBytes32,
        driverBytesRaw32: layout.FixedBytes32,
        toolchainManifestRaw32: layout.FixedBytes32,
        commandManifestRaw32: layout.FixedBytes32,
        targetTriple: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(384)
    compilerExecutionReceiptAppendText(buf,
                                         CompilerExecutionIdentityDomain)
    compilerExecutionReceiptAppendText(buf, caseId)
    compilerExecutionReceiptAppendFixed32(buf, sourceBundleRaw32)
    compilerExecutionReceiptAppendFixed32(buf, materializerBytesRaw32)
    compilerExecutionReceiptAppendFixed32(buf,
                                            grammarObligationRootRaw32)
    compilerExecutionReceiptAppendFixed32(buf,
                                            compilerSourceClosureRaw32)
    compilerExecutionReceiptAppendFixed32(buf, driverBytesRaw32)
    compilerExecutionReceiptAppendFixed32(buf, toolchainManifestRaw32)
    compilerExecutionReceiptAppendFixed32(buf, commandManifestRaw32)
    compilerExecutionReceiptAppendText(buf, targetTriple)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn CompilerExecutionIdentityMake(
        caseId: str,
        sourceBundleRaw32: layout.FixedBytes32,
        materializerBytesRaw32: layout.FixedBytes32,
        grammarObligationRootRaw32: layout.FixedBytes32,
        compilerSourceClosureRaw32: layout.FixedBytes32,
        driverBytesRaw32: layout.FixedBytes32,
        toolchainManifestRaw32: layout.FixedBytes32,
        commandManifestRaw32: layout.FixedBytes32,
        targetTriple: str): Result[CompilerExecutionIdentity] =
    let validRes = compilerExecutionIdentityFieldsValid(
        caseId,
        sourceBundleRaw32,
        materializerBytesRaw32,
        grammarObligationRootRaw32,
        compilerSourceClosureRaw32,
        driverBytesRaw32,
        toolchainManifestRaw32,
        commandManifestRaw32,
        targetTriple)
    if IsErr(validRes):
        return Err[CompilerExecutionIdentity](Error(validRes))
    var out: CompilerExecutionIdentity
    out.caseId = share(caseId)
    out.sourceBundleRaw32 = sourceBundleRaw32
    out.materializerBytesRaw32 = materializerBytesRaw32
    out.grammarObligationRootRaw32 = grammarObligationRootRaw32
    out.compilerSourceClosureRaw32 = compilerSourceClosureRaw32
    out.driverBytesRaw32 = driverBytesRaw32
    out.toolchainManifestRaw32 = toolchainManifestRaw32
    out.commandManifestRaw32 = commandManifestRaw32
    out.targetTriple = share(targetTriple)
    out.executionRaw32 = compilerExecutionIdentityRaw32(
        caseId,
        sourceBundleRaw32,
        materializerBytesRaw32,
        grammarObligationRootRaw32,
        compilerSourceClosureRaw32,
        driverBytesRaw32,
        toolchainManifestRaw32,
        commandManifestRaw32,
        targetTriple)
    return Ok[CompilerExecutionIdentity](out)

@borrows
fn CompilerExecutionIdentityVerify(
        identity: CompilerExecutionIdentity): Result[bool] =
    let validRes = compilerExecutionIdentityFieldsValid(
        identity.caseId,
        identity.sourceBundleRaw32,
        identity.materializerBytesRaw32,
        identity.grammarObligationRootRaw32,
        identity.compilerSourceClosureRaw32,
        identity.driverBytesRaw32,
        identity.toolchainManifestRaw32,
        identity.commandManifestRaw32,
        identity.targetTriple)
    if IsErr(validRes):
        return Err[bool](Error(validRes))
    let expected = compilerExecutionIdentityRaw32(
        identity.caseId,
        identity.sourceBundleRaw32,
        identity.materializerBytesRaw32,
        identity.grammarObligationRootRaw32,
        identity.compilerSourceClosureRaw32,
        identity.driverBytesRaw32,
        identity.toolchainManifestRaw32,
        identity.commandManifestRaw32,
        identity.targetTriple)
    if !layout.FixedBytes32Equal(expected, identity.executionRaw32):
        return Err[bool](
            " compiler execution identity: self hash mismatch")
    return Ok[bool](true)

@borrows
fn compilerToolchainEncoderAuthorityObservedCid(
        value: layout.FixedBytes32,
        emptyInputCid: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(value, emptyInputCid)

@borrows
fn compilerToolchainEncoderAuthoritySourceFieldsValid(
        receipt: CompilerToolchainEncoderAuthorityBuildProjectionReceipt):
        Result[bool] =
    # Empty-input SHA-256 is computed once for the fixed-width validation, not
    # once per column.
    let emptyInputCid = compilerExecutionReceiptEmptyRaw32()
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.buildAuthorityCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: build authority is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.compilerCsgArtifactCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: CompilerCSG artifact is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.compilerCsgGraphCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: CompilerCSG graph is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.compilerCsgCanonicalGraphCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: canonical CompilerCSG graph is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.compilerCsgSourceBundleCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: source bundle is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.compilerCsgCargoCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: cargo is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.compilerCsgFactsRootCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: facts root is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.compilerCsgCargoObjectReceiptCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: Cargo object receipt is absent")
    if receipt.producerRow < 0:
        return Err[bool](
            " compiler toolchain encoder authority: producer row is absent")
    if receipt.canonicalRow < 0:
        return Err[bool](
            " compiler toolchain encoder authority: canonical row is absent")
    if receipt.modulePathTextId < 0:
        return Err[bool](
            " compiler toolchain encoder authority: module path TextId is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.documentCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: document CID is absent")
    if !compilerToolchainEncoderAuthorityObservedCid(
           receipt.contentCid, emptyInputCid):
        return Err[bool](
            " compiler toolchain encoder authority: content CID is absent")
    return Ok[bool](true)

@borrows
fn compilerToolchainEncoderAuthorityProjectionCid(
        receipt: CompilerToolchainEncoderAuthorityBuildProjectionReceipt):
        layout.FixedBytes32 =
    var payload = layout.ByteBufInit(512)
    compilerExecutionReceiptAppendText(
        payload, CompilerToolchainEncoderAuthorityBuildProjectionDomain)
    compilerExecutionReceiptAppendFixed32(payload, receipt.buildAuthorityCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgArtifactCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgGraphCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgCanonicalGraphCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgSourceBundleCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgCargoCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgFactsRootCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgCargoObjectReceiptCid)
    compilerExecutionReceiptAppendI32(payload, receipt.producerRow)
    compilerExecutionReceiptAppendI32(payload, receipt.canonicalRow)
    compilerExecutionReceiptAppendI32(payload, receipt.modulePathTextId)
    compilerExecutionReceiptAppendFixed32(payload, receipt.documentCid)
    compilerExecutionReceiptAppendFixed32(payload, receipt.contentCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerToolchainEncoderAuthorityReceiptCid(
        receipt: CompilerToolchainEncoderAuthorityBuildProjectionReceipt,
        projectionCid: layout.FixedBytes32): layout.FixedBytes32 =
    var payload = layout.ByteBufInit(576)
    compilerExecutionReceiptAppendText(
        payload,
        CompilerToolchainEncoderAuthorityBuildProjectionReceiptDomain)
    compilerExecutionReceiptAppendFixed32(payload, receipt.buildAuthorityCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgArtifactCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgGraphCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgCanonicalGraphCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgSourceBundleCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgCargoCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgFactsRootCid)
    compilerExecutionReceiptAppendFixed32(
        payload, receipt.compilerCsgCargoObjectReceiptCid)
    compilerExecutionReceiptAppendI32(payload, receipt.producerRow)
    compilerExecutionReceiptAppendI32(payload, receipt.canonicalRow)
    compilerExecutionReceiptAppendI32(payload, receipt.modulePathTextId)
    compilerExecutionReceiptAppendFixed32(payload, receipt.documentCid)
    compilerExecutionReceiptAppendFixed32(payload, receipt.contentCid)
    compilerExecutionReceiptAppendFixed32(payload, projectionCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

# This constructor only closes the inner build projection.  A self-consistent
# CompilerExecutionIdentity is not issuer authority; production issuance must
# remain confined to the live CompilerSnapshotLoweringAuthority projector and
# bind the official receipt payload plus actual compiler bytes externally.
@borrows
fn CompilerToolchainEncoderAuthorityBuildProjectionMake(
        buildIdentity: CompilerExecutionIdentity,
        compilerCsgArtifactCid: layout.FixedBytes32,
        compilerCsgGraphCid: layout.FixedBytes32,
        compilerCsgCanonicalGraphCid: layout.FixedBytes32,
        compilerCsgSourceBundleCid: layout.FixedBytes32,
        compilerCsgCargoCid: layout.FixedBytes32,
        compilerCsgFactsRootCid: layout.FixedBytes32,
        compilerCsgCargoObjectReceiptCid: layout.FixedBytes32,
        producerRow: int32,
        canonicalRow: int32,
        modulePathTextId: int32,
        documentCid: layout.FixedBytes32,
        contentCid: layout.FixedBytes32):
        Result[CompilerToolchainEncoderAuthorityBuildProjectionReceipt] =
    let buildIdentityRes = CompilerExecutionIdentityVerify(buildIdentity)
    if IsErr(buildIdentityRes):
        return Err[CompilerToolchainEncoderAuthorityBuildProjectionReceipt](
            Error(buildIdentityRes))
    var out: CompilerToolchainEncoderAuthorityBuildProjectionReceipt
    out.buildAuthorityCid =
        layout.FixedBytes32Copy(buildIdentity.executionRaw32)
    out.compilerCsgArtifactCid =
        layout.FixedBytes32Copy(compilerCsgArtifactCid)
    out.compilerCsgGraphCid = layout.FixedBytes32Copy(compilerCsgGraphCid)
    out.compilerCsgCanonicalGraphCid =
        layout.FixedBytes32Copy(compilerCsgCanonicalGraphCid)
    out.compilerCsgSourceBundleCid =
        layout.FixedBytes32Copy(compilerCsgSourceBundleCid)
    out.compilerCsgCargoCid = layout.FixedBytes32Copy(compilerCsgCargoCid)
    out.compilerCsgFactsRootCid =
        layout.FixedBytes32Copy(compilerCsgFactsRootCid)
    out.compilerCsgCargoObjectReceiptCid =
        layout.FixedBytes32Copy(compilerCsgCargoObjectReceiptCid)
    out.producerRow = producerRow
    out.canonicalRow = canonicalRow
    out.modulePathTextId = modulePathTextId
    out.documentCid = layout.FixedBytes32Copy(documentCid)
    out.contentCid = layout.FixedBytes32Copy(contentCid)
    let fieldsRes = compilerToolchainEncoderAuthoritySourceFieldsValid(out)
    if IsErr(fieldsRes):
        return Err[CompilerToolchainEncoderAuthorityBuildProjectionReceipt](
            Error(fieldsRes))
    let projectionCid = compilerToolchainEncoderAuthorityProjectionCid(out)
    out.projectionCid = layout.FixedBytes32Copy(projectionCid)
    let receiptCid = compilerToolchainEncoderAuthorityReceiptCid(
        out, projectionCid)
    out.receiptCid = layout.FixedBytes32Copy(receiptCid)
    return Ok[CompilerToolchainEncoderAuthorityBuildProjectionReceipt](out)

@borrows
fn CompilerToolchainEncoderAuthorityBuildProjectionVerify(
        receipt: CompilerToolchainEncoderAuthorityBuildProjectionReceipt):
        Result[bool] =
    let fieldsRes = compilerToolchainEncoderAuthoritySourceFieldsValid(receipt)
    if IsErr(fieldsRes):
        return Err[bool](Error(fieldsRes))
    if !compilerExecutionReceiptRaw32Observed(receipt.projectionCid):
        return Err[bool](
            " compiler toolchain encoder authority: projection CID is absent")
    if !compilerExecutionReceiptRaw32Observed(receipt.receiptCid):
        return Err[bool](
            " compiler toolchain encoder authority: receipt CID is absent")
    let expectedProjection =
        compilerToolchainEncoderAuthorityProjectionCid(receipt)
    let expectedReceipt = compilerToolchainEncoderAuthorityReceiptCid(
        receipt, expectedProjection)
    let projectionMatches = layout.FixedBytes32Equal(
        expectedProjection, receipt.projectionCid)
    let receiptMatches = layout.FixedBytes32Equal(
        expectedReceipt, receipt.receiptCid)
    if !projectionMatches:
        return Err[bool](
            " compiler toolchain encoder authority: projection CID mismatch")
    if !receiptMatches:
        return Err[bool](
            " compiler toolchain encoder authority: receipt CID mismatch")
    return Ok[bool](true)

@borrows
fn CompilerToolchainEncoderAuthorityBuildProjectionVerifyForBuild(
        receipt: CompilerToolchainEncoderAuthorityBuildProjectionReceipt,
        buildIdentity: CompilerExecutionIdentity): Result[bool] =
    let buildIdentityRes = CompilerExecutionIdentityVerify(buildIdentity)
    if IsErr(buildIdentityRes):
        return Err[bool](Error(buildIdentityRes))
    let receiptRes = CompilerToolchainEncoderAuthorityBuildProjectionVerify(
        receipt)
    if IsErr(receiptRes):
        return Err[bool](Error(receiptRes))
    if !layout.FixedBytes32Equal(
           receipt.buildAuthorityCid, buildIdentity.executionRaw32):
        return Err[bool](
            " compiler toolchain encoder authority: build authority mismatch")
    return Ok[bool](true)

@borrows
fn ExecutionStageReceiptStageOrdinal(stageKind: str): int32 =
    if stageKind == ExecutionStageReceiptStageTypedExpr:
        return 1
    if stageKind == ExecutionStageReceiptStageCsg:
        return 2
    if stageKind == ExecutionStageReceiptStageLowering:
        return 3
    if stageKind == ExecutionStageReceiptStagePrimary:
        return 4
    if stageKind == ExecutionStageReceiptStagePrimaryRegalloc:
        return 5
    if stageKind == ExecutionStageReceiptStageBackend2:
        return 6
    if stageKind == ExecutionStageReceiptStageBackend2Regalloc:
        return 7
    return -1

@borrows
fn ExecutionStageReceiptLaneExpected(stageKind: str): str =
    if stageKind == ExecutionStageReceiptStageTypedExpr ||
       stageKind == ExecutionStageReceiptStageCsg ||
       stageKind == ExecutionStageReceiptStageLowering:
        return ExecutionStageReceiptLaneShared
    if stageKind == ExecutionStageReceiptStagePrimary ||
       stageKind == ExecutionStageReceiptStagePrimaryRegalloc:
        return ExecutionStageReceiptLanePrimary
    if stageKind == ExecutionStageReceiptStageBackend2 ||
       stageKind == ExecutionStageReceiptStageBackend2Regalloc:
        return ExecutionStageReceiptLaneBackend2
    return ""

@borrows
fn ExecutionStageReceiptPredecessorExpected(stageKind: str): str =
    if stageKind == ExecutionStageReceiptStageTypedExpr:
        return ExecutionStageReceiptStageParser
    if stageKind == ExecutionStageReceiptStageCsg:
        return ExecutionStageReceiptStageTypedExpr
    if stageKind == ExecutionStageReceiptStageLowering:
        return ExecutionStageReceiptStageCsg
    if stageKind == ExecutionStageReceiptStagePrimary:
        return ExecutionStageReceiptStageLowering
    if stageKind == ExecutionStageReceiptStagePrimaryRegalloc:
        return ExecutionStageReceiptStagePrimary
    if stageKind == ExecutionStageReceiptStageBackend2:
        return ExecutionStageReceiptStageLowering
    if stageKind == ExecutionStageReceiptStageBackend2Regalloc:
        return ExecutionStageReceiptStageBackend2
    return ""

@borrows
fn ExecutionStageReceiptSidecarSchemaExpected(stageKind: str): str =
    if stageKind == ExecutionStageReceiptStageTypedExpr:
        return ExecutionStageReceiptTypedExprSidecarSchema
    if stageKind == ExecutionStageReceiptStageCsg:
        return ExecutionStageReceiptCsgSidecarSchema
    if stageKind == ExecutionStageReceiptStageLowering:
        return ExecutionStageReceiptLoweringSidecarSchema
    if stageKind == ExecutionStageReceiptStagePrimary:
        return ExecutionStageReceiptPrimarySidecarSchema
    if stageKind == ExecutionStageReceiptStagePrimaryRegalloc:
        return ExecutionStageReceiptPrimaryRegallocSidecarSchema
    if stageKind == ExecutionStageReceiptStageBackend2:
        return ExecutionStageReceiptBackend2SidecarSchema
    if stageKind == ExecutionStageReceiptStageBackend2Regalloc:
        return ExecutionStageReceiptBackend2RegallocSidecarSchema
    return ""

@borrows
fn ExecutionStageReceiptArtifactKindExpected(stageKind: str): str =
    if stageKind == ExecutionStageReceiptStageTypedExpr:
        return ExecutionStageReceiptTypedExprArtifactKind
    if stageKind == ExecutionStageReceiptStageCsg:
        return ExecutionStageReceiptCsgArtifactKind
    if stageKind == ExecutionStageReceiptStageLowering:
        return ExecutionStageReceiptLoweringArtifactKind
    if stageKind == ExecutionStageReceiptStagePrimary:
        return ExecutionStageReceiptPrimaryArtifactKind
    if stageKind == ExecutionStageReceiptStagePrimaryRegalloc:
        return ExecutionStageReceiptPrimaryRegallocArtifactKind
    if stageKind == ExecutionStageReceiptStageBackend2:
        return ExecutionStageReceiptBackend2ArtifactKind
    if stageKind == ExecutionStageReceiptStageBackend2Regalloc:
        return ExecutionStageReceiptBackend2RegallocArtifactKind
    return ""

@borrows
fn executionStageReceiptFieldsValid(
        receipt: ExecutionStageReceipt): Result[bool] =
    let expectedOrdinal = ExecutionStageReceiptStageOrdinal(
        receipt.stageKind)
    if expectedOrdinal <= 0 || receipt.stageOrdinal != expectedOrdinal:
        return Err[bool](
            " compiler stage receipt: invalid stage ordinal")
    if receipt.laneKind != ExecutionStageReceiptLaneExpected(
            receipt.stageKind):
        return Err[bool](
            " compiler stage receipt: stage lane mismatch")
    if receipt.predecessorStageKind !=
       ExecutionStageReceiptPredecessorExpected(receipt.stageKind):
        return Err[bool](
            " compiler stage receipt: predecessor kind mismatch")
    if !compilerExecutionReceiptRaw32Observed(receipt.producerSourceRaw32) ||
       !compilerExecutionReceiptRaw32Observed(receipt.executionRaw32) ||
       !compilerExecutionReceiptRaw32Observed(
            receipt.predecessorReceiptRaw32) ||
       !compilerExecutionReceiptRaw32Observed(receipt.inputSemanticRaw32) ||
       !compilerExecutionReceiptRaw32Observed(receipt.outputSemanticRaw32) ||
       !compilerExecutionReceiptRaw32Observed(receipt.sidecarBytesRaw32) ||
       !compilerExecutionReceiptRaw32Observed(receipt.artifactBytesRaw32):
        return Err[bool](
            " compiler stage receipt: required hash is absent")
    if !layout.FixedBytes32Equal(receipt.outputSemanticRaw32,
                                 receipt.sidecarBytesRaw32):
        return Err[bool](
            " compiler stage receipt: semantic root is not sidecar bytes")
    if receipt.sidecarSchema !=
       ExecutionStageReceiptSidecarSchemaExpected(receipt.stageKind):
        return Err[bool](
            " compiler stage receipt: sidecar schema mismatch")
    if receipt.artifactKind !=
       ExecutionStageReceiptArtifactKindExpected(receipt.stageKind):
        return Err[bool](
            " compiler stage receipt: artifact kind mismatch")
    if !compilerExecutionReceiptCanonicalRelativePath(receipt.sidecarPath) ||
       !compilerExecutionReceiptCanonicalRelativePath(receipt.artifactPath) ||
       receipt.sidecarPath == receipt.artifactPath:
        return Err[bool](
            " compiler stage receipt: artifact path is not canonical")
    if receipt.sidecarByteLength <= Int64(0) ||
       receipt.artifactByteLength <= Int64(0):
        return Err[bool](
            " compiler stage receipt: observed artifact is empty")
    return Ok[bool](true)

@borrows
fn executionStageReceiptRaw32(
        receipt: ExecutionStageReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(640)
    compilerExecutionReceiptAppendText(buf, ExecutionStageReceiptDomain)
    compilerExecutionReceiptAppendI32(buf, receipt.stageOrdinal)
    compilerExecutionReceiptAppendText(buf, receipt.stageKind)
    compilerExecutionReceiptAppendText(buf, receipt.laneKind)
    compilerExecutionReceiptAppendFixed32(buf, receipt.producerSourceRaw32)
    compilerExecutionReceiptAppendFixed32(buf, receipt.executionRaw32)
    compilerExecutionReceiptAppendText(buf, receipt.predecessorStageKind)
    compilerExecutionReceiptAppendFixed32(
        buf, receipt.predecessorReceiptRaw32)
    compilerExecutionReceiptAppendFixed32(buf, receipt.inputSemanticRaw32)
    compilerExecutionReceiptAppendFixed32(buf, receipt.outputSemanticRaw32)
    compilerExecutionReceiptAppendText(buf, receipt.sidecarSchema)
    compilerExecutionReceiptAppendText(buf, receipt.sidecarPath)
    compilerExecutionReceiptAppendI64(buf, receipt.sidecarByteLength)
    compilerExecutionReceiptAppendFixed32(buf, receipt.sidecarBytesRaw32)
    compilerExecutionReceiptAppendText(buf, receipt.artifactKind)
    compilerExecutionReceiptAppendText(buf, receipt.artifactPath)
    compilerExecutionReceiptAppendI64(buf, receipt.artifactByteLength)
    compilerExecutionReceiptAppendFixed32(buf, receipt.artifactBytesRaw32)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn ExecutionStageReceiptMakeObserved(
        identity: CompilerExecutionIdentity,
        stageKind: str,
        laneKind: str,
        producerSourceBytes: rawbytes.Bytes,
        predecessorStageKind: str,
        predecessorReceiptRaw32: layout.FixedBytes32,
        inputSemanticRaw32: layout.FixedBytes32,
        sidecarPath: str,
        sidecarBytes: rawbytes.Bytes,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes): Result[ExecutionStageReceipt] =
    let identityRes = CompilerExecutionIdentityVerify(identity)
    if IsErr(identityRes):
        return Err[ExecutionStageReceipt](Error(identityRes))
    if rawbytes.BytesLen(producerSourceBytes) <= 0 ||
       rawbytes.BytesLen(sidecarBytes) <= 0 ||
       rawbytes.BytesLen(artifactBytes) <= 0:
        return Err[ExecutionStageReceipt](
            " compiler stage receipt: observed bytes are empty")
    var out: ExecutionStageReceipt
    out.stageOrdinal = ExecutionStageReceiptStageOrdinal(stageKind)
    out.laneKind = laneKind
    out.producerSourceRaw32 = compilerExecutionReceiptHashObservedBytes(
        producerSourceBytes)
    out.executionRaw32 = identity.executionRaw32
    out.predecessorStageKind = predecessorStageKind
    out.predecessorReceiptRaw32 = predecessorReceiptRaw32
    out.inputSemanticRaw32 = inputSemanticRaw32
    out.sidecarSchema = ExecutionStageReceiptSidecarSchemaExpected(stageKind)
    out.sidecarPath = sidecarPath
    out.sidecarByteLength = Int64(rawbytes.BytesLen(sidecarBytes))
    out.sidecarBytesRaw32 = compilerExecutionReceiptHashObservedBytes(
        sidecarBytes)
    out.outputSemanticRaw32 = out.sidecarBytesRaw32
    out.artifactKind = ExecutionStageReceiptArtifactKindExpected(stageKind)
    out.stageKind = stageKind
    out.artifactPath = artifactPath
    out.artifactByteLength = Int64(rawbytes.BytesLen(artifactBytes))
    out.artifactBytesRaw32 = compilerExecutionReceiptHashObservedBytes(
        artifactBytes)
    let validRes = executionStageReceiptFieldsValid(out)
    if IsErr(validRes):
        return Err[ExecutionStageReceipt](Error(validRes))
    out.receiptRaw32 = executionStageReceiptRaw32(out)
    return Ok[ExecutionStageReceipt](out)

@borrows
fn ExecutionStageReceiptVerify(
        receipt: ExecutionStageReceipt): Result[bool] =
    let validRes = executionStageReceiptFieldsValid(receipt)
    if IsErr(validRes):
        return Err[bool](Error(validRes))
    let expected = executionStageReceiptRaw32(receipt)
    if !layout.FixedBytes32Equal(expected, receipt.receiptRaw32):
        return Err[bool](
            " compiler stage receipt: self hash mismatch")
    return Ok[bool](true)

@borrows
fn ExecutionStageReceiptVerifyObserved(
        receipt: ExecutionStageReceipt,
        identity: CompilerExecutionIdentity,
        expectedPredecessorRaw32: layout.FixedBytes32,
        producerSourceBytes: rawbytes.Bytes,
        sidecarBytes: rawbytes.Bytes,
        artifactBytes: rawbytes.Bytes): Result[bool] =
    let identityRes = CompilerExecutionIdentityVerify(identity)
    if IsErr(identityRes):
        return Err[bool](Error(identityRes))
    let receiptRes = ExecutionStageReceiptVerify(receipt)
    if IsErr(receiptRes):
        return Err[bool](Error(receiptRes))
    if !layout.FixedBytes32Equal(receipt.executionRaw32,
                                 identity.executionRaw32):
        return Err[bool](
            " compiler stage receipt: execution identity drift")
    if !layout.FixedBytes32Equal(receipt.predecessorReceiptRaw32,
                                 expectedPredecessorRaw32):
        return Err[bool](
            " compiler stage receipt: predecessor receipt drift")
    if rawbytes.BytesLen(producerSourceBytes) <= 0 ||
       rawbytes.BytesLen(sidecarBytes) <= 0 ||
       rawbytes.BytesLen(artifactBytes) <= 0:
        return Err[bool](
            " compiler stage receipt: observed bytes are empty")
    if !layout.FixedBytes32Equal(
            receipt.producerSourceRaw32,
            compilerExecutionReceiptHashObservedBytes(
                producerSourceBytes)):
        return Err[bool](
            " compiler stage receipt: producer source bytes mismatch")
    if receipt.sidecarByteLength != Int64(rawbytes.BytesLen(sidecarBytes)) ||
       !layout.FixedBytes32Equal(
            receipt.sidecarBytesRaw32,
            compilerExecutionReceiptHashObservedBytes(sidecarBytes)):
        return Err[bool](
            " compiler stage receipt: sidecar bytes mismatch")
    if receipt.artifactByteLength != Int64(rawbytes.BytesLen(artifactBytes)) ||
       !layout.FixedBytes32Equal(
            receipt.artifactBytesRaw32,
            compilerExecutionReceiptHashObservedBytes(artifactBytes)):
        return Err[bool](
            " compiler stage receipt: artifact bytes mismatch")
    return Ok[bool](true)

@borrows
fn CompilerSevenStageReceiptValidatorInit(
        identity: CompilerExecutionIdentity,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32): Result[CompilerSevenStageReceiptValidator] =
    let identityRes = CompilerExecutionIdentityVerify(identity)
    if IsErr(identityRes):
        return Err[CompilerSevenStageReceiptValidator](Error(identityRes))
    if !compilerExecutionReceiptRaw32Observed(parserReceiptRaw32) ||
       !compilerExecutionReceiptRaw32Observed(parserSemanticRaw32):
        return Err[CompilerSevenStageReceiptValidator](
            " compiler seven stage receipt: parser prerequisite absent")
    var out: CompilerSevenStageReceiptValidator
    out.active = true
    out.executionRaw32 = layout.FixedBytes32Copy(identity.executionRaw32)
    out.parserReceiptRaw32 = layout.FixedBytes32Copy(parserReceiptRaw32)
    out.parserSemanticRaw32 = layout.FixedBytes32Copy(parserSemanticRaw32)
    out.nextStageOrdinal = 1
    return Ok[CompilerSevenStageReceiptValidator](out)

@borrows
fn compilerSevenStageReceiptExpectedPredecessorReceipt(
        validator: CompilerSevenStageReceiptValidator,
        ordinal: int32): layout.FixedBytes32 =
    if ordinal == 1:
        return layout.FixedBytes32Copy(
            validator.parserReceiptRaw32)
    if ordinal == 2:
        return layout.FixedBytes32Copy(
            validator.stageReceiptRaw32s[0])
    if ordinal == 3:
        return layout.FixedBytes32Copy(
            validator.stageReceiptRaw32s[1])
    if ordinal == 4:
        return layout.FixedBytes32Copy(
            validator.stageReceiptRaw32s[2])
    if ordinal == 5:
        return layout.FixedBytes32Copy(
            validator.stageReceiptRaw32s[3])
    if ordinal == 6:
        return layout.FixedBytes32Copy(
            validator.stageReceiptRaw32s[2])
    if ordinal == 7:
        return layout.FixedBytes32Copy(
            validator.stageReceiptRaw32s[5])
    return layout.FixedBytes32()

@borrows
fn compilerSevenStageReceiptExpectedInputSemantic(
        validator: CompilerSevenStageReceiptValidator,
        ordinal: int32): layout.FixedBytes32 =
    if ordinal == 1:
        return layout.FixedBytes32Copy(
            validator.parserSemanticRaw32)
    if ordinal == 2:
        return layout.FixedBytes32Copy(
            validator.stageOutputSemanticRaw32s[0])
    if ordinal == 3:
        return layout.FixedBytes32Copy(
            validator.stageOutputSemanticRaw32s[1])
    if ordinal == 4:
        return layout.FixedBytes32Copy(
            validator.stageOutputSemanticRaw32s[2])
    if ordinal == 5:
        return layout.FixedBytes32Copy(
            validator.stageOutputSemanticRaw32s[3])
    if ordinal == 6:
        return layout.FixedBytes32Copy(
            validator.stageOutputSemanticRaw32s[2])
    if ordinal == 7:
        return layout.FixedBytes32Copy(
            validator.stageOutputSemanticRaw32s[5])
    return layout.FixedBytes32()

@borrows
fn CompilerSevenStageReceiptValidatorObserve(
        validator: var CompilerSevenStageReceiptValidator,
        identity: CompilerExecutionIdentity,
        receipt: ExecutionStageReceipt,
        producerSourceBytes: rawbytes.Bytes,
        sidecarBytes: rawbytes.Bytes,
        artifactBytes: rawbytes.Bytes): Result[bool] =
    if !validator.active:
        return Err[bool](
            " compiler seven stage receipt: validator is sealed")
    if receipt.stageOrdinal != validator.nextStageOrdinal:
        return Err[bool](
            " compiler seven stage receipt: stage missing or out of order")
    if !layout.FixedBytes32Equal(validator.executionRaw32,
                                 identity.executionRaw32):
        return Err[bool](
            " compiler seven stage receipt: execution identity drift")
    let expectedPredecessor =
        compilerSevenStageReceiptExpectedPredecessorReceipt(
            validator, receipt.stageOrdinal)
    let observedRes = ExecutionStageReceiptVerifyObserved(
        receipt,
        identity,
        expectedPredecessor,
        producerSourceBytes,
        sidecarBytes,
        artifactBytes)
    if IsErr(observedRes):
        return Err[bool](Error(observedRes))
    let expectedInput = compilerSevenStageReceiptExpectedInputSemantic(
        validator, receipt.stageOrdinal)
    if !layout.FixedBytes32Equal(receipt.inputSemanticRaw32, expectedInput):
        return Err[bool](
            " compiler seven stage receipt: semantic transition mismatch")
    add(validator.stageReceiptRaw32s, receipt.receiptRaw32)
    add(validator.stageOutputSemanticRaw32s, receipt.outputSemanticRaw32)
    validator.nextStageOrdinal = validator.nextStageOrdinal + 1
    return Ok[bool](true)

@borrows
fn compilerSevenStageReceiptRootRaw32(
        validator: CompilerSevenStageReceiptValidator): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(768)
    compilerExecutionReceiptAppendText(buf,
                                         CompilerSevenStageReceiptDomain)
    compilerExecutionReceiptAppendFixed32(buf, validator.executionRaw32)
    compilerExecutionReceiptAppendFixed32(buf,
                                            validator.parserReceiptRaw32)
    compilerExecutionReceiptAppendFixed32(buf,
                                            validator.parserSemanticRaw32)
    compilerExecutionReceiptAppendI32(buf,
                                        validator.stageReceiptRaw32s.len)
    for index in 0..<validator.stageReceiptRaw32s.len:
        compilerExecutionReceiptAppendFixed32(
            buf, validator.stageReceiptRaw32s[index])
        compilerExecutionReceiptAppendFixed32(
            buf, validator.stageOutputSemanticRaw32s[index])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn CompilerSevenStageReceiptValidatorFinalize(
        validator: var CompilerSevenStageReceiptValidator): Result[layout.FixedBytes32] =
    if !validator.active:
        return Err[layout.FixedBytes32](
            " compiler seven stage receipt: validator is sealed")
    if validator.nextStageOrdinal != 8 ||
       validator.stageReceiptRaw32s.len != 7 ||
       validator.stageOutputSemanticRaw32s.len != 7:
        return Err[layout.FixedBytes32](
            " compiler seven stage receipt: seven observed stages required")
    let out = compilerSevenStageReceiptRootRaw32(validator)
    validator.active = false
    return Ok[layout.FixedBytes32](out)

# Structural pass used by the canonical wire encoder before publication.
# It proves the exact seven-node DAG and every receipt self hash, but does not
# replace VerifyObserved: release consumers must still read producer, sidecar,
# and artifact files and feed their real bytes through ValidatorObserve.
@borrows
fn CompilerSevenStageReceiptValidateStructure(
        identity: CompilerExecutionIdentity,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        receipts: ExecutionStageReceipt[]): Result[layout.FixedBytes32] =
    if receipts.len != 7:
        return Err[layout.FixedBytes32](
            " compiler seven stage receipt: structure requires seven receipts")
    let initRes = CompilerSevenStageReceiptValidatorInit(
        identity, parserReceiptRaw32, parserSemanticRaw32)
    if IsErr(initRes):
        return Err[layout.FixedBytes32](Error(initRes))
    var validator = Value(initRes)
    for index in 0..<receipts.len:
        let receipt = receipts[index]
        if receipt.stageOrdinal != validator.nextStageOrdinal:
            return Err[layout.FixedBytes32](
                " compiler seven stage receipt: structure stage order mismatch")
        let receiptRes = ExecutionStageReceiptVerify(receipt)
        if IsErr(receiptRes):
            return Err[layout.FixedBytes32](Error(receiptRes))
        if !layout.FixedBytes32Equal(receipt.executionRaw32,
                                     identity.executionRaw32):
            return Err[layout.FixedBytes32](
                " compiler seven stage receipt: structure execution drift")
        let expectedPredecessor =
            compilerSevenStageReceiptExpectedPredecessorReceipt(
                validator, receipt.stageOrdinal)
        if !layout.FixedBytes32Equal(receipt.predecessorReceiptRaw32,
                                     expectedPredecessor):
            return Err[layout.FixedBytes32](
                " compiler seven stage receipt: structure predecessor drift")
        let expectedInput = compilerSevenStageReceiptExpectedInputSemantic(
            validator, receipt.stageOrdinal)
        if !layout.FixedBytes32Equal(receipt.inputSemanticRaw32,
                                     expectedInput):
            return Err[layout.FixedBytes32](
                " compiler seven stage receipt: structure semantic drift")
        add(validator.stageReceiptRaw32s, receipt.receiptRaw32)
        add(validator.stageOutputSemanticRaw32s,
            receipt.outputSemanticRaw32)
        validator.nextStageOrdinal = validator.nextStageOrdinal + 1
    return CompilerSevenStageReceiptValidatorFinalize(validator)

@borrows
fn CompilerExecutionReceiptCanonicalRelativePath(path: str): bool =
    return compilerExecutionReceiptCanonicalRelativePath(path)
