import std/os
import std/strings
import std/strformat
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath

type
    CompositionManifestEvidence =
        present: bool
        manifestPath: str
        manifestSha256: str
        kernelManifestSha256: str
        compositionKind: str
        compilerEntrySource: str
        pluginCanonicalTriple: str
        declaredSourceCount: int32
        declaredSourcesSha256: str
        sourceClosureCount: int32
        sourceClosureSha256: str

    CompositionManifestParsed =
        manifestPath: str
        manifestText: str
        manifestSha256: str
        schema: str
        compositionKind: str
        compilerEntrySource: str
        kernelManifest: str
        pluginCanonicalTriple: str
        keys: str[]
        sourcePaths: str[]

@borrows
fn compositionManifestAppend(out: var str,
                              suffix: str) =
    out = Fmt"{out}{suffix}"

@borrows
fn compositionManifestPathWithin(path: str,
                                  root: str): bool =
    if path == root:
        return true
    return strutil.StartsWith(path, Fmt"{root}/")

@borrows
fn compositionManifestStripComment(raw: str): str =
    for i in 0..<raw.len:
        if raw[i] == '#':
            return strutil.Strip(
                strings.SliceBytes(raw, 0, i))
    return strutil.Strip(raw)

@borrows
fn compositionManifestKeyValid(key: str): bool =
    if key.len <= 0:
        return false
    for i in 0..<key.len:
        let ch = key[i]
        if !((ch >= 'a' && ch <= 'z') ||
             (ch >= '0' && ch <= '9') ||
             ch == '_'):
            return false
    return true

@borrows
fn compositionManifestHas(items: str[],
                           value: str): bool =
    for i in 0..<items.len:
        if items[i] == value:
            return true
    return false

@borrows
fn compositionManifestFlagValue(args: str[],
                                 value: var str,
                                 present: var bool,
                                 err: var str): bool =
    value = ""
    present = false
    var i: int32
    while i < args.len:
        let arg = strutil.Strip(args[i])
        var candidate = ""
        var matched = false
        if arg == "--composition-manifest":
            if i + 1 >= args.len:
                err = "HARD_RED:composition_manifest_value_missing"
                return false
            candidate = strutil.Strip(args[i + 1])
            i = i + 1
            matched = true
        elif strutil.StartsWith(arg, "--composition-manifest:"):
            candidate = strutil.Strip(
                strings.DropPrefix(arg, "--composition-manifest:"))
            matched = true
        elif strutil.StartsWith(arg, "--composition-manifest="):
            candidate = strutil.Strip(
                strings.DropPrefix(arg, "--composition-manifest="))
            matched = true
        if matched:
            if present:
                err = "HARD_RED:composition_manifest_flag_duplicate"
                return false
            if candidate.len <= 0:
                err = "HARD_RED:composition_manifest_value_empty"
                return false
            value = candidate
            present = true
        i = i + 1
    err = ""
    return true

@borrows
fn compositionManifestParseOne(rootDir: str,
                                manifestRaw: str,
                                includeCompilerEntry: bool,
                                out: var CompositionManifestParsed,
                                err: var str): bool =
    let root = chengpath.PathSlashNormalized(
        chengpath.PathHostFilePath(
            chengpath.PathAbsolute(rootDir, ".")))
    let bootstrapRoot = chengpath.PathSlashNormalized(
        chengpath.PathHostFilePath(
            chengpath.PathAbsolute(root, "bootstrap")))
    let manifestPath = chengpath.PathSlashNormalized(
        chengpath.PathHostFilePath(
            chengpath.PathAbsolute(root, manifestRaw)))
    if !compositionManifestPathWithin(manifestPath, bootstrapRoot) ||
       !strings.HasSuffix(manifestPath, ".cheng") ||
       !os.FileExists(manifestPath):
        err = Fmt"HARD_RED:composition_manifest_path_invalid:{manifestRaw}"
        return false
    let manifestText = chengpath.ReadTextFile("", manifestPath)
    if manifestText.len <= 0:
        err = Fmt"HARD_RED:composition_manifest_empty:{manifestRaw}"
        return false
    out.manifestPath = strings.CloneStr(manifestPath)
    out.manifestSha256 = strings.Sha256(manifestText)
    out.manifestText = strings.CloneStr(manifestText)
    let lines = strutil.Split(manifestText, '\n')
    for lineIndex in 0..<lines.len:
        let line = compositionManifestStripComment(lines[lineIndex])
        if line.len <= 0:
            continue
        var equalIndex: int32 = -1
        for i in 0..<line.len:
            if line[i] == '=':
                equalIndex = i
                break
        if equalIndex <= 0:
            err = Fmt"HARD_RED:composition_manifest_malformed_line:{lineIndex + 1}"
            return false
        let key = strutil.Strip(
            strings.SliceBytes(line, 0, equalIndex))
        let value = strutil.Strip(
            strings.SliceBytes(
                line,
                equalIndex + 1,
                line.len - equalIndex - 1))
        if !compositionManifestKeyValid(key) || value.len <= 0:
            err = Fmt"HARD_RED:composition_manifest_invalid_entry:{lineIndex + 1}"
            return false
        if compositionManifestHas(out.keys, key):
            err = Fmt"HARD_RED:composition_manifest_duplicate_key:{key}"
            return false
        add(out.keys, strings.CloneStr(key))
        if key == "composition_schema":
            out.schema = strings.CloneStr(value)
            continue
        if key == "composition_kind":
            out.compositionKind = strings.CloneStr(value)
            continue
        if key == "kernel_manifest":
            out.kernelManifest = strings.CloneStr(value)
            continue
        if key == "plugin_canonical_triple":
            out.pluginCanonicalTriple = strings.CloneStr(value)
            continue
        let sourceEntry = key == "compiler_entry_source" ||
                          strings.HasSuffix(key, "_source")
        if !sourceEntry:
            err = Fmt"HARD_RED:composition_manifest_unknown_key:{key}"
            return false
        if !strutil.StartsWith(value, "src/core/") ||
           !strings.HasSuffix(value, ".cheng") ||
           strutil.Contains(value, ".."):
            err = Fmt"HARD_RED:composition_manifest_source_path_invalid:{value}"
            return false
        if key == "compiler_entry_source":
            out.compilerEntrySource = strings.CloneStr(value)
            if !includeCompilerEntry:
                continue
        if compositionManifestHas(out.sourcePaths, value):
            err = Fmt"HARD_RED:composition_manifest_duplicate_source:{value}"
            return false
        add(out.sourcePaths, strings.CloneStr(value))
    if out.schema != "cheng.composition.v1":
        err = "HARD_RED:composition_manifest_schema_invalid"
        return false
    if out.compilerEntrySource.len <= 0:
        err = "HARD_RED:composition_manifest_entry_missing"
        return false
    err = ""
    return true

fn compositionManifestSort(items: var str[]) =
    for i in 0..<items.len:
        var j = i
        while j > 0 && items[j] < items[j - 1]:
            let left = strings.CloneStr(items[j - 1])
            items[j - 1] = strings.CloneStr(items[j])
            items[j] = left
            j = j - 1

@borrows
fn compositionManifestSourceSetSha256(
        sourcePaths: str[]): str =
    var sorted: str[]
    for i in 0..<sourcePaths.len:
        add(sorted, strings.CloneStr(sourcePaths[i]))
    compositionManifestSort(sorted)
    var transcript = "cheng.composition.declared_sources.v1\n"
    for i in 0..<sorted.len:
        compositionManifestAppend(
            transcript,
            Fmt"{sorted[i].len}:{sorted[i]}\n")
    return strings.Sha256(transcript)

@borrows
fn compositionManifestPlanCoreSourcesInto(
        rootDir: str,
        plan: var slplan.SystemLinkPlanStub,
        actualSources: var str[],
        err: var str): bool =
    actualSources = []
    let coreRoot = chengpath.PathSlashNormalized(
        chengpath.PathHostFilePath(
            chengpath.PathAbsolute(rootDir, "src/core")))
    for i in 0..<plan.sourceClosurePaths.len:
        let actualAbsolute = chengpath.PathSlashNormalized(
            chengpath.PathHostFilePath(
                chengpath.PathAbsolute(
                    rootDir,
                    plan.sourceClosurePaths[i])))
        if !compositionManifestPathWithin(actualAbsolute, coreRoot):
            continue
        let relative = strings.SliceBytes(
            actualAbsolute,
            coreRoot.len + 1,
            actualAbsolute.len - coreRoot.len - 1)
        let repoRelative = Fmt"src/core/{relative}"
        if compositionManifestHas(actualSources, repoRelative):
            err = Fmt"HARD_RED:composition_manifest_actual_duplicate_source:{repoRelative}"
            return false
        add(actualSources, repoRelative)
    err = ""
    return true

@borrows
fn compositionManifestExactSourceSet(
        declared: str[],
        actual: str[],
        err: var str): bool =
    if declared.len != actual.len:
        err = Fmt"HARD_RED:composition_manifest_closure_count_mismatch:declared={declared.len}:actual={actual.len}"
        return false
    for i in 0..<declared.len:
        if !compositionManifestHas(actual, declared[i]):
            err = Fmt"HARD_RED:composition_manifest_declared_unreachable:{declared[i]}"
            return false
    for i in 0..<actual.len:
        if !compositionManifestHas(declared, actual[i]):
            err = Fmt"HARD_RED:composition_manifest_source_undeclared:{actual[i]}"
            return false
    err = ""
    return true

@borrows
fn compositionManifestCanonicalEntryValid(
        compositionKind: str,
        compilerEntrySource: str,
        pluginCanonicalTriple: str): bool =
    if compositionKind == "kernel-only":
        return compilerEntrySource ==
                   "src/core/tooling/compiler_composition_kernel_main.cheng" &&
               pluginCanonicalTriple.len == 0
    if compositionKind != "plugin":
        return false
    if pluginCanonicalTriple == "arm64-apple-darwin":
        return compilerEntrySource ==
            "src/core/tooling/compiler_composition_aarch64_main.cheng"
    if pluginCanonicalTriple == "x86_64-unknown-linux-gnu":
        return compilerEntrySource ==
            "src/core/tooling/compiler_composition_x86_64_main.cheng"
    if pluginCanonicalTriple == "riscv64-unknown-linux-gnu":
        return compilerEntrySource ==
            "src/core/tooling/compiler_composition_riscv64_main.cheng"
    return false

fn CompositionManifestValidateRequestInto(
        rootDir: str,
        args: str[],
        req: var creq.CompilerRequest,
        evidence: var CompositionManifestEvidence,
        err: var str): bool =
    var manifestRaw: str
    var present: bool
    if !compositionManifestFlagValue(
           args, manifestRaw, present, err):
        return false
    if !present:
        err = ""
        return true
    if req.reportPath.len <= 0:
        err = "HARD_RED:composition_manifest_report_required"
        return false
    var primary: CompositionManifestParsed
    if !compositionManifestParseOne(
           rootDir, manifestRaw, true, primary, err):
        return false
    var expectedSources: str[]
    var kernelManifestSha256 = ""
    if primary.compositionKind == "kernel-only":
        if primary.kernelManifest.len > 0 ||
           primary.pluginCanonicalTriple.len > 0:
            err = "HARD_RED:composition_manifest_kernel_metadata_invalid"
            return false
    elif primary.compositionKind == "plugin":
        if primary.kernelManifest.len <= 0 ||
           primary.pluginCanonicalTriple.len <= 0:
            err = "HARD_RED:composition_manifest_plugin_metadata_missing"
            return false
        var kernel: CompositionManifestParsed
        if !compositionManifestParseOne(
               rootDir,
               primary.kernelManifest,
               false,
               kernel,
               err):
            return false
        if kernel.compositionKind != "kernel-only" ||
           kernel.kernelManifest.len > 0 ||
           kernel.pluginCanonicalTriple.len > 0 ||
           !compositionManifestCanonicalEntryValid(
               kernel.compositionKind,
               kernel.compilerEntrySource,
               kernel.pluginCanonicalTriple):
            err = "HARD_RED:composition_manifest_kernel_include_invalid"
            return false
        kernelManifestSha256 = strings.CloneStr(
            kernel.manifestSha256)
        for i in 0..<kernel.sourcePaths.len:
            add(expectedSources,
                strings.CloneStr(kernel.sourcePaths[i]))
    else:
        err = "HARD_RED:composition_manifest_kind_invalid"
        return false
    if !compositionManifestCanonicalEntryValid(
           primary.compositionKind,
           primary.compilerEntrySource,
           primary.pluginCanonicalTriple):
        err = Fmt"HARD_RED:composition_manifest_entry_unit_mismatch:{primary.compilerEntrySource}:{primary.pluginCanonicalTriple}"
        return false
    for i in 0..<primary.sourcePaths.len:
        let sourcePath = strings.CloneStr(primary.sourcePaths[i])
        if compositionManifestHas(expectedSources, sourcePath):
            err = Fmt"HARD_RED:composition_manifest_cross_duplicate_source:{sourcePath}"
            return false
        add(expectedSources, strings.CloneStr(sourcePath))
    let entryAbsolute = chengpath.PathSlashNormalized(
        chengpath.PathHostFilePath(
            chengpath.PathAbsolute(
                rootDir,
                primary.compilerEntrySource)))
    let requestEntryAbsolute = chengpath.PathSlashNormalized(
        chengpath.PathHostFilePath(
            chengpath.PathAbsolute(rootDir, req.sourcePath)))
    if entryAbsolute != requestEntryAbsolute:
        err = Fmt"HARD_RED:composition_manifest_entry_mismatch:{primary.compilerEntrySource}"
        return false
    let coreRoot = chengpath.PathSlashNormalized(
        chengpath.PathHostFilePath(
            chengpath.PathAbsolute(rootDir, "src/core")))
    for i in 0..<expectedSources.len:
        let sourceAbsolute = chengpath.PathSlashNormalized(
            chengpath.PathHostFilePath(
                chengpath.PathAbsolute(
                    rootDir,
                    expectedSources[i])))
        if !compositionManifestPathWithin(sourceAbsolute, coreRoot) ||
           !os.FileExists(sourceAbsolute):
            err = Fmt"HARD_RED:composition_manifest_source_missing:{expectedSources[i]}"
            return false
    let declaredSourcesSha256 =
        compositionManifestSourceSetSha256(expectedSources)
    var ownedSources: str[]
    for i in 0..<expectedSources.len:
        add(ownedSources, strings.CloneStr(expectedSources[i]))
    var ownedReq = creq.CompilerRequestClone(req)
    ownedReq = creq.CompilerRequestWithCompositionEvidence(
        ownedReq,
        "cheng.composition.v1",
        strings.CloneStr(primary.manifestSha256),
        strings.CloneStr(kernelManifestSha256),
        strings.CloneStr(primary.compositionKind),
        strings.CloneStr(primary.compilerEntrySource),
        strings.CloneStr(primary.pluginCanonicalTriple),
        ownedSources,
        strings.CloneStr(declaredSourcesSha256),
        0,
        "")
    creq.CompilerRequestSeal(ownedReq)
    req = ownedReq
    evidence.present = true
    evidence.manifestPath = strings.CloneStr(primary.manifestPath)
    evidence.manifestSha256 = strings.CloneStr(primary.manifestSha256)
    evidence.kernelManifestSha256 = strings.CloneStr(
        kernelManifestSha256)
    evidence.compositionKind = strings.CloneStr(primary.compositionKind)
    evidence.compilerEntrySource = strings.CloneStr(
        primary.compilerEntrySource)
    evidence.pluginCanonicalTriple = strings.CloneStr(
        primary.pluginCanonicalTriple)
    evidence.declaredSourceCount = expectedSources.len
    evidence.declaredSourcesSha256 = strings.CloneStr(
        declaredSourcesSha256)
    err = ""
    return true

@borrows
fn CompositionManifestBindPlanInto(
        rootDir: str,
        req: var creq.CompilerRequest,
        plan: var slplan.SystemLinkPlanStub,
        evidence: var CompositionManifestEvidence,
        err: var str): bool =
    if !creq.CompilerRequestStrictValidateSealed(req):
        err = "HARD_RED:composition_manifest_request_unsealed"
        return false
    if !creq.CompilerRequestCompositionPresent(req):
        err = ""
        return true
    if !compositionManifestCanonicalEntryValid(
           req.compositionKind,
           req.compositionEntrySource,
           req.compositionPluginCanonicalTriple):
        err = "HARD_RED:composition_manifest_entry_unit_mismatch"
        return false
    var actualSources: str[]
    if compositionManifestSourceSetSha256(
           req.compositionDeclaredSourcePaths) !=
       req.compositionDeclaredSourcesSha256:
        err = "HARD_RED:composition_manifest_declared_source_cid_drift"
        return false
    if !compositionManifestPlanCoreSourcesInto(
           rootDir, plan, actualSources, err) ||
       !compositionManifestExactSourceSet(
           req.compositionDeclaredSourcePaths,
           actualSources,
           err):
        return false
    let sourceBundleCid =
        slplan.SystemLinkPlanSourceBundleCidValue(plan)
    if layout.FixedBytes32Equal(
           sourceBundleCid, layout.FixedBytes32()):
        err = "HARD_RED:composition_manifest_source_bundle_cid_zero"
        return false
    let sourceBundleSha256 = layout.FixedBytes32Hex(sourceBundleCid)
    if creq.CompilerRequestCompositionSourceBundleBound(req):
        if req.compositionSourceClosureCount != actualSources.len ||
           req.compositionSourceClosureSha256 != sourceBundleSha256:
            err = "HARD_RED:composition_manifest_source_bundle_identity_drift"
            return false
    else:
        var declaredSources: str[]
        for i in 0..<req.compositionDeclaredSourcePaths.len:
            add(declaredSources, strings.CloneStr(
                req.compositionDeclaredSourcePaths[i]))
        var boundReq = creq.CompilerRequestClone(req)
        boundReq = creq.CompilerRequestWithCompositionEvidence(
            boundReq,
            strings.CloneStr(req.compositionManifestSchema),
            strings.CloneStr(req.compositionManifestSha256),
            strings.CloneStr(
                req.compositionKernelManifestSha256),
            strings.CloneStr(req.compositionKind),
            strings.CloneStr(req.compositionEntrySource),
            strings.CloneStr(
                req.compositionPluginCanonicalTriple),
            declaredSources,
            strings.CloneStr(
                req.compositionDeclaredSourcesSha256),
            actualSources.len,
            strings.CloneStr(sourceBundleSha256))
        creq.CompilerRequestSeal(boundReq)
        req = boundReq
    evidence.present = true
    evidence.manifestSha256 = strings.CloneStr(
        req.compositionManifestSha256)
    evidence.kernelManifestSha256 = strings.CloneStr(
        req.compositionKernelManifestSha256)
    evidence.compositionKind = strings.CloneStr(req.compositionKind)
    evidence.compilerEntrySource = strings.CloneStr(
        req.compositionEntrySource)
    evidence.pluginCanonicalTriple = strings.CloneStr(
        req.compositionPluginCanonicalTriple)
    evidence.declaredSourceCount =
        req.compositionDeclaredSourcePaths.len
    evidence.declaredSourcesSha256 = strings.CloneStr(
        req.compositionDeclaredSourcesSha256)
    evidence.sourceClosureCount = actualSources.len
    evidence.sourceClosureSha256 = strings.CloneStr(
        sourceBundleSha256)
    err = ""
    return true

@borrows
fn CompositionManifestValidateBoundPlanInto(
        rootDir: str,
        req: creq.CompilerRequest,
        plan: var slplan.SystemLinkPlanStub,
        err: var str): bool =
    if !creq.CompilerRequestCompositionPresent(req):
        err = ""
        return true
    if !creq.CompilerRequestStrictValidateSealed(req) ||
       !creq.CompilerRequestCompositionSourceBundleBound(req):
        err = "HARD_RED:composition_manifest_source_bundle_identity_unbound"
        return false
    if !compositionManifestCanonicalEntryValid(
           req.compositionKind,
           req.compositionEntrySource,
           req.compositionPluginCanonicalTriple):
        err = "HARD_RED:composition_manifest_entry_unit_mismatch"
        return false
    var actualSources: str[]
    if compositionManifestSourceSetSha256(
           req.compositionDeclaredSourcePaths) !=
           req.compositionDeclaredSourcesSha256 ||
       !compositionManifestPlanCoreSourcesInto(
           rootDir, plan, actualSources, err) ||
       !compositionManifestExactSourceSet(
           req.compositionDeclaredSourcePaths,
           actualSources,
           err):
        if err.len <= 0:
            err = "HARD_RED:composition_manifest_declared_source_cid_drift"
        return false
    let sourceBundleCid =
        slplan.SystemLinkPlanSourceBundleCidValue(plan)
    if req.compositionSourceClosureCount != actualSources.len ||
       req.compositionSourceClosureSha256 !=
           layout.FixedBytes32Hex(sourceBundleCid):
        err = "HARD_RED:composition_manifest_source_bundle_identity_drift"
        return false
    err = ""
    return true
