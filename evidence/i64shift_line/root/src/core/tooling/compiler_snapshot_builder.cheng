        buf, receipt.lexicalScopeRequiredCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingLexicalScopeProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingParserLexicalScopeIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedLexicalScopeIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingStatementLexicalScopeUseCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingLexicalScopeBridgeCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingLexicalScopeOwnerDeclarationIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingLexicalScopeOwnerFunctionIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingLexicalScopeSpanCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingLexicalScopeVisibleSymbolProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDependencyProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.diagnosticProducerKindCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.diagnosticCompletionRequiredCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.diagnosticProducedRowCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDiagnosticCompletionCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDiagnosticSourceIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDiagnosticProducerKindCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDiagnosticSpanIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDiagnosticParserNodeIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDiagnosticOwnerDeclarationIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDiagnosticProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.admissionBlocked ? 1 : 0)
    return compilerSnapshotBuilderHashFinish(buf)

fn CompilerSnapshotProductionTypeArenaBindingStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        typeArenaPresent: var bool,
        err: var str): bool =
    typeArenaPresent = csg.typeArena != nil
    if !typeArenaPresent:
        err = " compiler snapshot builder: production TypeArena missing"
        return false
    if csg.typeArenaMissingResolutionAuthorityCount != 0 ||
       csg.typeArena.producerSourceCount != csg.sourceSnapshotCount ||
       layout.FixedBytes32Equal(
           csg.typeArena.artifactRaw32, layout.FixedBytes32()) ||
       !typearena.TypedExprTypeArenaStrictValidateInto(csg.typeArena, err) ||
       !ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
            csg, err):
        if err == "":
            err = " compiler snapshot builder: TypeArena producer binding invalid"
        return false
    err = ""
    return true

# Import dependencies are already a sealed CompilerCSG producer domain.  The
# proof binds the immutable source/import graph identities to every exact
# int32 producer row; module/source text is deliberately not an identity key.
@borrows
fn compilerSnapshotProductionDependencyProofCid(
        csg: ccsg.CompilerCsg): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_dependency_proof")
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.receiptCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.importGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    let edgeCount =
        csg.semanticGraph.importEdgeTable.ownerSourceIndex.len
    compilerSnapshotBuilderHashAppendU32(buf, edgeCount)
    for edgeRow in 0..<edgeCount:
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.importEdgeTable.ownerSourceIndex[edgeRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.importEdgeTable.targetSourceIndex[edgeRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.importEdgeTable.resolved[edgeRow] ? 1 : 0)
    return compilerSnapshotBuilderHashFinish(buf)

@borrows
fn compilerSnapshotProductionSymbolInterfaceProofCid(
        csg: ccsg.CompilerCsg,
        tables: snapshot_schema.CsgCompilerSnapshotTables): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        256 + tables.symbols.symbolCids.len * 112)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_symbol_interface_proof")
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.receiptCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.parserNormalizedExprReceipt.envelope.receiptRaw32)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.typeArena.artifactRaw32)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.symbols.symbolCids.len)
    for symbolId in 0..<tables.symbols.symbolCids.len:
        compilerSnapshotBuilderHashAppendU32(buf, symbolId)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.symbolCids[symbolId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.interfaceCids[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.declIds[symbolId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.declKeyCids[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.sourceIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.symbolKinds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.typeIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.ownerSymbolIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.functionIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.externFunctionIds[symbolId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.externFunctions.symbolIds.len)
    for externFunctionId in 0..<tables.externFunctions.symbolIds.len:
        compilerSnapshotBuilderHashAppendU32(buf, externFunctionId)
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.externFunctions.symbolIds[externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFunctions.parserDeclarationRows[
                externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.externFunctions.typeIds[externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFunctions.externalNameTextIds[
                externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.externFunctions.abiKinds[externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFunctions.importAnnotationRows[
                externFunctionId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.externFunctions.interfaceCids[externFunctionId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.externFfiHandleContracts.externSymbolIds.len)
    for contractRow in 0..<
            tables.externFfiHandleContracts.externSymbolIds.len:
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.externSymbolIds[contractRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.externFfiHandleContracts.functionSymbolCids[
                contractRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.externFfiHandleContracts.parserProvenanceCids[
                contractRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.unwindKinds[contractRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.effectStarts[contractRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.effectCounts[contractRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.externFfiHandleContracts.contractCids[contractRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.externFfiHandleContracts.interfaceCids[contractRow])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.externFfiHandleContracts.effectKinds.len)
    for effectRow in 0..<
            tables.externFfiHandleContracts.effectKinds.len:
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.effectContractRows[effectRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.externFfiHandleContracts.effectKinds[effectRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.effectTargetKinds[effectRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.effectParameterOrdinals[
                effectRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.externFfiHandleContracts.effectParameterSymbolCids[
                effectRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.externFfiHandleContracts.effectTypeCids[effectRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFfiHandleContracts.effectAbiCarrierKinds[
                effectRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.externFfiHandleContracts.effectCids[effectRow])
    compilerSnapshotBuilderHashAppendCid(
        buf, tables.externFfiHandleContracts.cargoCid)
    return compilerSnapshotBuilderHashFinish(buf)

@borrows
fn compilerSnapshotProductionReferenceProofCid(
        csg: ccsg.CompilerCsg,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        requiredDomainCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        256 + tables.references.sourceIds.len * 64 +
            tables.calls.callReferenceIds.len * 256)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_reference_proof")
    compilerSnapshotBuilderHashAppendCid(buf, requiredDomainCid)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.typeArena.artifactRaw32)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.references.sourceIds.len)
    for referenceId in 0..<tables.references.sourceIds.len:
        compilerSnapshotBuilderHashAppendU32(buf, referenceId)
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.references.sourceIds[referenceId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.references.spanIds[referenceId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.references.ownerFunctionIds[referenceId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.references.ownerSymbolIds[referenceId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.references.targetSymbolIds[referenceId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.references.referenceKinds[referenceId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.references.bindingTypedNodeIds[referenceId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.calls.callReferenceIds.len)
    for callId in 0..<tables.calls.callReferenceIds.len:
        let referenceId = tables.calls.callReferenceIds[callId]
        compilerSnapshotBuilderHashAppendU32(buf, callId)
        compilerSnapshotBuilderHashAppendU32(buf, referenceId)
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.callerFunctionIds[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.calleeSymbolIds[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.targetCallDeclarationRows[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.targetSourceIds[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.calls.targetSourceLocalDeclarationRows[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.targetParserDeclarationRows[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.targetDeclIds[callId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.calls.targetDeclKeyCids[callId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.calls.targetSymbolCids[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.resultTypedNodeIds[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.resultValueDefinitionRows[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.resultTypeIds[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.resultOwnershipKinds[callId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.calls.resultOwnershipProofKinds[callId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.calls.resultOwnershipProofCids[callId])
    return compilerSnapshotBuilderHashFinish(buf)

@borrows
fn compilerSnapshotProductionDiagnosticProofCidInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        requiredDomainCid: layout.FixedBytes32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    let completionCount =
        tables.diagnosticCompletions.sourceIds.len
    let requiredCount =
        tables.diagnosticCompletions.requiredProducerIds.len
    if !compilerSnapshotBuilderCidObserved(requiredDomainCid) ||
       !layout.FixedBytes32Equal(
           tables.diagnosticCompletions.requiredDomainCid,
           requiredDomainCid) ||
       completionCount !=
           tables.diagnosticCompletions.producerKinds.len ||
       completionCount !=
           tables.diagnosticCompletions.requiredStarts.len ||
       completionCount !=
           tables.diagnosticCompletions.requiredCounts.len ||
       completionCount !=
           tables.diagnosticCompletions.rowCounts.len ||
       completionCount !=
           tables.diagnosticCompletions.proofCids.len ||
       requiredCount !=
           tables.diagnosticCompletions.requiredProducerCids.len ||
       requiredCount !=
           tables.diagnosticCompletions.requiredResultIds.len ||
       requiredCount !=
           tables.diagnosticCompletions.requiredResultCids.len:
        err = " compiler snapshot builder: diagnostic proof aggregate domain split"
        return false
    var buf = layout.ByteBufInit(384)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_diagnostic_proof")
    compilerSnapshotBuilderHashAppendCid(buf, requiredDomainCid)
    var authorityEvidenceCid: layout.FixedBytes32
    if !compilerSnapshotProductionDiagnosticEvidenceCidInto(
           tables,
           requiredDomainCid,
           authorityEvidenceCid,
           err):
        layout.ByteBufFree(buf)
        return false
    compilerSnapshotBuilderHashAppendCid(buf, authorityEvidenceCid)
    compilerSnapshotBuilderHashAppendU32(buf, completionCount)
    var requiredCursor: int32
    for completionId in 0..<completionCount:
        let requiredStart =
            tables.diagnosticCompletions.requiredStarts[completionId]
        let completionRequiredCount =
            tables.diagnosticCompletions.requiredCounts[completionId]
        var expectedProofCid: layout.FixedBytes32
        var expectedDiagnosticCount: int32
        if requiredStart != requiredCursor ||
           completionRequiredCount < 0 ||
           requiredCursor > requiredCount ||
           completionRequiredCount > requiredCount - requiredCursor ||
           !snapshot_schema.CsgCompilerDiagnosticCompletionProofCidInto(
               tables,
               completionId,
               expectedProofCid,
               expectedDiagnosticCount,
               err) ||
           tables.diagnosticCompletions.rowCounts[
               completionId] != expectedDiagnosticCount ||
           !layout.FixedBytes32Equal(
               tables.diagnosticCompletions.proofCids[completionId],
               expectedProofCid):
            layout.ByteBufFree(buf)
            if err == "":
                err = " compiler snapshot builder: diagnostic completion proof aggregate drift"
            return false
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnosticCompletions.sourceIds[completionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.diagnosticCompletions.producerKinds[completionId])
        compilerSnapshotBuilderHashAppendU32(buf, requiredStart)
        compilerSnapshotBuilderHashAppendU32(
            buf, completionRequiredCount)
        compilerSnapshotBuilderHashAppendU32(
            buf, expectedDiagnosticCount)
        compilerSnapshotBuilderHashAppendCid(buf, expectedProofCid)
        requiredCursor =
            requiredCursor + completionRequiredCount
    if requiredCursor != requiredCount:
        layout.ByteBufFree(buf)
        err = " compiler snapshot builder: diagnostic proof aggregate CSR tail drift"
        return false
    compilerSnapshotBuilderHashAppendU32(buf, requiredCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.diagnostics.sourceIds.len)
    out = compilerSnapshotBuilderHashFinish(buf)
    if !compilerSnapshotBuilderCidObserved(out):
        err = " compiler snapshot builder: diagnostic proof aggregate CID missing"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotProductionFunctionInterfaceProofCid(
        csg: ccsg.CompilerCsg,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        requiredDomainCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        512 +
        tables.symbols.symbolCids.len * 256 +
        tables.types.typeCids.len * 64 +
        tables.functions.symbolIds.len * 256)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_function_interface_proof")
    compilerSnapshotBuilderHashAppendCid(buf, requiredDomainCid)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.typeArena.artifactRaw32)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.sources.documentCids.len)
    for sourceId in 0..<tables.sources.documentCids.len:
        compilerSnapshotBuilderHashAppendU32(buf, sourceId)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.sources.documentCids[sourceId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.sources.contentCids[sourceId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.sources.interfaceCids[sourceId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.parserSidecars.producerSourceIndexes[sourceId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.dependencies.sourceIds.len)
    for dependencyId in 0..<tables.dependencies.sourceIds.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.sourceIds[dependencyId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.targetSourceIds[dependencyId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.spanIds[dependencyId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.dependencyKinds[dependencyId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.dependencies.observedInterfaceCids[dependencyId])
    # This proof is also the tamper boundary for the complete
    # Module/Function/Type subset produced by this stage.  A candidate may
    # still be blocked on other declaration kinds, so the absent all-Symbol
    # proof cannot be used to authenticate these already produced rows.
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.symbols.symbolCids.len)
    for symbolId in 0..<tables.symbols.symbolCids.len:
        compilerSnapshotBuilderHashAppendU32(buf, symbolId)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.symbolCids[symbolId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.interfaceCids[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.declIds[symbolId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.declKeyCids[symbolId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.declarationHeaderCids[symbolId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.declarationPathCids[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.sourceIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.nameTextIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.nameSpanIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.nameTokenIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.qualifiedNameTextIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.symbolKinds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.typeIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.declarationSpanIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.ownerSymbolIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.functionIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.externFunctionIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.exportedFlags[symbolId] ? 1 : 0)
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.symbols.genericParameterParserRows[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.symbols.genericParameterOrdinals[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.symbols.genericParameterDefaultTypeIds[symbolId])
        let constraintStart =
            tables.symbols.genericConstraintStarts[symbolId]
        let constraintCount =
            tables.symbols.genericConstraintCounts[symbolId]
        compilerSnapshotBuilderHashAppendU32(buf, constraintCount)
        for offset in 0..<constraintCount:
            compilerSnapshotBuilderHashAppendU32(
                buf,
                tables.symbols.genericConstraintTypeIds[
                    constraintStart + offset])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.annotationTargets.sourceIds.len)
    for row in 0..<tables.annotationTargets.sourceIds.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.annotationTargets.sourceIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.annotationTargets.parserAnnotationRows[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.annotationTargets.targetTokenIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.annotationTargets.targetParserDeclarationRows[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.annotationTargets.targetSymbolIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.annotationTargets.targetDeclIds[row])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.annotationTargets.targetDeclKeyCids[row])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.types.typeCids.len)
    for typeId in 0..<tables.types.typeCids.len:
        compilerSnapshotBuilderHashAppendU32(buf, typeId)
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.types.producerTypeArenaIds[typeId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.types.typeCids[typeId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.types.traitProofCids[typeId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.declarations.declKeyCids.len)
    for declId in 0..<tables.declarations.declKeyCids.len:
        compilerSnapshotBuilderHashAppendU32(buf, declId)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.declarations.declKeyCids[declId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.functions.symbolIds.len)
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        compilerSnapshotBuilderHashAppendU32(buf, functionId)
        compilerSnapshotBuilderHashAppendU32(buf, symbolId)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.symbols.symbolCids[symbolId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.functions.interfaceCids[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.functions.bodySpanIds[functionId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.functions.bodyContentCids[functionId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.functions.fragmentCids[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.symbols.typeIds[symbolId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.functions.typedFunctionIndexes[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.annotationFlags[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.manualConsumeTargetParameterSymbolIds[
                functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.manualConsumeSourceParameterSymbolIds[
                functionId])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.functions.manualConsumeEffectCids[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.resultOwnershipKinds[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.functions.parameterOwnershipCounts[functionId])
        let ownershipStart =
            tables.functions.parameterOwnershipStarts[functionId]
        for offset in 0..<
                tables.functions.parameterOwnershipCounts[functionId]:
            compilerSnapshotBuilderHashAppendU32(
                buf,
                tables.functions.parameterOwnershipKinds[
                    ownershipStart + offset])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.functions.readStarts[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.functions.readCounts[functionId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.functions.readSetPreimageCids[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.functions.nodeStarts[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.functions.nodeCounts[functionId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.externFunctions.symbolIds.len)
    for externFunctionId in 0..<tables.externFunctions.symbolIds.len:
        compilerSnapshotBuilderHashAppendU32(buf, externFunctionId)
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.externFunctions.symbolIds[externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFunctions.parserDeclarationRows[
                externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.externFunctions.typeIds[externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFunctions.externalNameTextIds[
                externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.externFunctions.abiKinds[externFunctionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.externFunctions.importAnnotationRows[
                externFunctionId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.externFunctions.interfaceCids[externFunctionId])
    return compilerSnapshotBuilderHashFinish(buf)

fn compilerSnapshotProductionSymbolInterfaceObligations(
        csg: var ccsg.CompilerCsg,
        declarationInterfaceCount: var int32,
        genericInterfaceCount: var int32,
        annotationTargetBindingCount: var int32) =
    # Every source owns exactly one Module Symbol. Explicit module declaration
    # rows replace, rather than duplicate, that source-owned obligation.
    declarationInterfaceCount = csg.sourceSnapshotCount
    genericInterfaceCount = 0
    annotationTargetBindingCount = 0
    for producerIndex in 0..<
            csg.parserNormalizedExprReceipt.sourceSidecars.len:
        let sidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[producerIndex]
        for declarationRow in 0..<sidecar.declarationKinds.len:
            let declarationKind =
                sidecar.declarationKinds[declarationRow]
            # [symbol-obligation-domain] This denominator must describe the
            # same declaration domain the Symbol producer covers.  A
            # module-level `var`/`const` block entry is a
            # `ParserDeclarationLocal` row with
            # `declarationFunctionRows == -1` -- the discriminator
            # `compilerCsgParserGlobalDeclaration` uses to classify it as a
            # global declaration -- and `AppendLocalSymbolsInto` appends no
            # Symbol for it: that producer walks value-definition groups,
            # and such a row has no function-local definition by
            # construction; no other Symbol kind owns it either
            # (`CsgCompilerSymbol*` is Module / Type / Function / Field /
            # Parameter / Local / GenericParameter).  Counting it here
            # demanded a Symbol that cannot exist, so the subtraction below
            # could never reach zero and the Symbol interface bit stayed
            # set.  Its coverage is the parser-owned global binding domain
            # (`compiler csg: parser-owned global coverage mismatch`,
            # compiler_csg.cheng:33830) instead.  Function-scoped Local rows
            # keep their obligation: a local that lost its value definition
            # still fails closed at "Local declaration lacks exact value
            # definition".
            if declarationKind ==
                   Int32(parser.ParserDeclarationModule) ||
               (declarationKind ==
                    Int32(parser.ParserDeclarationLocal) &&
                sidecar.declarationFunctionRows[declarationRow] < 0):
                continue
            declarationInterfaceCount =
                declarationInterfaceCount + 1
        genericInterfaceCount =
            genericInterfaceCount +
            sidecar.typeGenericSymbolNameTokenIds.len
        annotationTargetBindingCount =
            annotationTargetBindingCount +
            sidecar.annotationTargetTokenIds.len

# The parser receipt's executable function index is the exact retained
# FunctionId domain. Bind it to declaration identity with source-local int32
# indexes. Every sidecar column is consumed once; text, arity and source line
# are never identity keys.
fn compilerSnapshotProductionFunctionInspectionStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        parameterCount: var int32,
        genericCount: var int32,
        err: var str): bool =
    parameterCount = 0
    genericCount = 0
    let functionCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    var functionSeen: bool[]
    setLen(functionSeen, functionCount)
    for producerIndex in 0..<
            csg.parserNormalizedExprReceipt.sourceSidecars.len:
        let sidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[producerIndex]
        var declarationFunctionCount: int32
        for declarationRow in 0..<sidecar.declarationKinds.len:
            if sidecar.declarationKinds[declarationRow] ==
                   Int32(parser.ParserDeclarationFunction):
                declarationFunctionCount =
                    declarationFunctionCount + 1
        var functionDeclarationBySpanId: int32[]
        setLen(functionDeclarationBySpanId, sidecar.spanStartBytes.len)
        for spanId in 0..<functionDeclarationBySpanId.len:
            functionDeclarationBySpanId[spanId] = -1
        var localFunctionSeen: bool[]
        setLen(localFunctionSeen, declarationFunctionCount)
        var executableFunctionByOwnerToken: bool[]
        setLen(executableFunctionByOwnerToken, sidecar.tokenKinds.len)
        for declarationRow in 0..<sidecar.declarationKinds.len:
            if sidecar.declarationKinds[declarationRow] ==
                   Int32(parser.ParserDeclarationFunction):
                let declarationSpanId =
                    sidecar.declarationSpanIds[declarationRow]
                let localFunctionRow =
                    sidecar.declarationFunctionRows[declarationRow]
                if declarationSpanId < 0 ||
                   declarationSpanId >=
                       functionDeclarationBySpanId.len ||
                   localFunctionRow < 0 ||
                   localFunctionRow >= localFunctionSeen.len ||
                   functionDeclarationBySpanId[declarationSpanId] != -1:
                    err = " compiler snapshot builder: function declaration index split"
                    return false
                functionDeclarationBySpanId[declarationSpanId] =
                    declarationRow
        for parserFunctionRow in 0..<sidecar.functionIndexes.len:
            let functionId = sidecar.functionIndexes[parserFunctionRow]
            if functionId < 0 || functionId >= functionCount ||
               functionSeen[functionId] ||
               csg.semanticGraph.reachableFunctionTable.sourceIndex[
                   functionId] != sidecar.sourceIndex:
                err = " compiler snapshot builder: FunctionId/source row inspection split"
                return false
            let functionSpanId =
                sidecar.functionDeclarationSpanIds[parserFunctionRow]
            let functionNameSpanId =
                sidecar.functionNameSpanIds[parserFunctionRow]
            if functionSpanId < 0 ||
               functionSpanId >= functionDeclarationBySpanId.len:
                err = " compiler snapshot builder: FunctionId/parser declaration owner split"
                return false
            let ownerDeclaration =
                functionDeclarationBySpanId[functionSpanId]
            if ownerDeclaration < 0 ||
               sidecar.declarationNameSpanIds[ownerDeclaration] !=
                   functionNameSpanId:
                err = " compiler snapshot builder: FunctionId/parser declaration owner split"
                return false
            let localFunctionRow =
                sidecar.declarationFunctionRows[ownerDeclaration]
            if localFunctionRow < 0 ||
               localFunctionRow >= localFunctionSeen.len ||
               localFunctionSeen[localFunctionRow]:
                err = " compiler snapshot builder: FunctionId/local function row split"
                return false
            let ownerToken =
                sidecar.declarationNameTokenIds[ownerDeclaration]
            if ownerToken < 0 ||
               ownerToken >= executableFunctionByOwnerToken.len ||
               executableFunctionByOwnerToken[ownerToken]:
                err = " compiler snapshot builder: function generic owner token split"
                return false
            functionSeen[functionId] = true
            localFunctionSeen[localFunctionRow] = true
            executableFunctionByOwnerToken[ownerToken] = true
        for declarationRow in 0..<sidecar.declarationKinds.len:
            if sidecar.declarationKinds[declarationRow] ==
                   Int32(parser.ParserDeclarationParameter):
                let ownerDeclaration =
                    sidecar.declarationOwnerIds[declarationRow]
                if ownerDeclaration < 0 ||
                   ownerDeclaration >= sidecar.declarationKinds.len:
                    err = " compiler snapshot builder: function parameter owner split"
                    return false
                let localFunctionRow =
                    sidecar.declarationFunctionRows[ownerDeclaration]
                if localFunctionRow >= 0 &&
                   localFunctionRow < localFunctionSeen.len &&
                   localFunctionSeen[localFunctionRow]:
                    if sidecar.declarationKinds[ownerDeclaration] !=
                           Int32(parser.ParserDeclarationFunction) ||
                       sidecar.declarationFunctionRows[declarationRow] !=
                           localFunctionRow:
                        err = " compiler snapshot builder: function parameter owner split"
                        return false
                    parameterCount = parameterCount + 1
        for genericRow in 0..<
                sidecar.typeGenericSymbolNameTokenIds.len:
            let ownerToken =
                sidecar.typeGenericSymbolDeclarationOwnerTokenIds[
                    genericRow]
            if ownerToken < 0 ||
               ownerToken >= executableFunctionByOwnerToken.len:
                err = " compiler snapshot builder: function generic owner token split"
                return false
            if executableFunctionByOwnerToken[ownerToken]:
                genericCount = genericCount + 1
    for functionId in 0..<functionCount:
        if !functionSeen[functionId]:
            err = " compiler snapshot builder: reachable FunctionId inspection missing"
            return false
    err = ""
    return true

fn compilerSnapshotProductionTypedNodeRequiredDomainStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        err: var str): bool =
    if csg.parserNormalizedExprReceipt.counts.exprCount !=
           Int64(csg.semanticGraph.exprSummary.exprCount) ||
       !texpr.TypedExprIrNodes2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
            csg.typedIr, err):
        if err == "":
            err = " compiler snapshot builder: parser/TypedExpr required node domain split"
        return false
    # The assess-stage TypeId obligation subtracts the exact value-definition
    # authority count, so its TypeArena replay must hold at this boundary.
    if !ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
           csg, err):
        return false
    if texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr) >
           csg.typedIr.nodes2_nodeIndexs.len:
        err = " compiler snapshot builder: value-definition authority exceeds typed node domain"
        return false
    let sidecars =
        csg.parserNormalizedExprReceipt.sourceSidecars
    var sourceNodeBases: int32[]
    setLen(sourceNodeBases, sidecars.len)
    var totalParserNodeCount: int32
    for producerIndex in 0..<sidecars.len:
        sourceNodeBases[producerIndex] = totalParserNodeCount
        if !compilerSnapshotBuilderCountAppendSafe(
               totalParserNodeCount,
               sidecars[producerIndex].nodeKinds.len):
            err = " compiler snapshot builder: parser node identity domain overflow"
            return false
        totalParserNodeCount =
            totalParserNodeCount +
            sidecars[producerIndex].nodeKinds.len
    var expectedFunctionByParserNode: int32[]
    setLen(expectedFunctionByParserNode, totalParserNodeCount)
    for parserNodeRow in 0..<expectedFunctionByParserNode.len:
        expectedFunctionByParserNode[parserNodeRow] = -1
    var parserExprCount: int32
    let functionCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    var parserExprRequiredByFunction: bool[]
    setLen(parserExprRequiredByFunction, functionCount)
    for producerIndex in 0..<sidecars.len:
        let sidecar = sidecars[producerIndex]
        for exprRow in 0..<sidecar.normalizedExprParserNodeIds.len:
            let functionIndex =
                sidecar.normalizedExprFunctionIndexes[exprRow]
            let parserNodeId =
                sidecar.normalizedExprParserNodeIds[exprRow]
            if sidecar.normalizedExprProducerSourceIds[exprRow] !=
                   producerIndex ||
               functionIndex < 0 || functionIndex >= functionCount ||
               csg.semanticGraph.reachableFunctionTable.sourceIndex[
                   functionIndex] != sidecar.sourceIndex ||
               parserNodeId < 0 ||
               parserNodeId >= sidecar.nodeKinds.len:
                err = " compiler snapshot builder: parser expression FunctionId/source split"
                return false
            let parserNodeRow =
                sourceNodeBases[producerIndex] + parserNodeId
            let existingFunction =
                expectedFunctionByParserNode[parserNodeRow]
            if existingFunction >= 0 &&
               existingFunction != functionIndex:
                err = " compiler snapshot builder: normalized expression parser identity reused across functions"
                return false
            expectedFunctionByParserNode[parserNodeRow] =
                functionIndex
            parserExprRequiredByFunction[functionIndex] = true
            parserExprCount = parserExprCount + 1
    var reachableFunctionByGraphNodeId: int32[]
    if csg.nodes.len >= 2147483647:
        err = " compiler snapshot builder: graph node identity domain overflow"
        return false
    setLen(reachableFunctionByGraphNodeId, csg.nodes.len + 1)
    for graphNodeId in 0..<reachableFunctionByGraphNodeId.len:
        reachableFunctionByGraphNodeId[graphNodeId] = -1
    for functionIndex in 0..<functionCount:
        let graphNodeId =
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[
                functionIndex]
        if graphNodeId <= 0 ||
           graphNodeId >= reachableFunctionByGraphNodeId.len ||
           reachableFunctionByGraphNodeId[graphNodeId] != -1:
            err = " compiler snapshot builder: reachable function graph identity split"
            return false
        reachableFunctionByGraphNodeId[graphNodeId] =
            functionIndex
    var typedFunctionSeenByReachableFunction: bool[]
    setLen(typedFunctionSeenByReachableFunction, functionCount)
    for typedFunctionIndex in 0..<
            csg.semanticGraph.typedIrTable.functionGraphNodeIds.len:
        let graphNodeId =
            csg.semanticGraph.typedIrTable.functionGraphNodeIds[
                typedFunctionIndex]
        if graphNodeId <= 0 ||
           graphNodeId >= reachableFunctionByGraphNodeId.len:
            err = " compiler snapshot builder: typed function graph identity missing"
            return false
        let functionIndex =
            reachableFunctionByGraphNodeId[graphNodeId]
        let producerIndex =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[
                typedFunctionIndex]
        if functionIndex < 0 || producerIndex < 0 ||
           producerIndex >= sidecars.len ||
           csg.semanticGraph.reachableFunctionTable.sourceIndex[
               functionIndex] != producerIndex:
            err = " compiler snapshot builder: parser expression typed function missing"
            return false
        if typedFunctionSeenByReachableFunction[functionIndex]:
            err = " compiler snapshot builder: duplicate typed function identity"
            return false
        typedFunctionSeenByReachableFunction[functionIndex] = true
        let nodeStart =
            csg.semanticGraph.typedIrTable.functionNodeStart[
                typedFunctionIndex]
        let nodeCount =
            csg.semanticGraph.typedIrTable.functionNodeCount[
                typedFunctionIndex]
        if nodeStart < 0 || nodeCount < 0 ||
           nodeStart > csg.typedIr.nodes2_nodeIndexs.len ||
           nodeCount > csg.typedIr.nodes2_nodeIndexs.len - nodeStart:
            err = " compiler snapshot builder: typed function node range split"
            return false
    # CompilerCSG observed and immediately replay-verified these exact
    # normalized-expression rows against each function-local parser layer
    # before staging that same layer into TypedExpr.  The canonical typed
    # function table therefore closes the exact FunctionId/source join; node
    # semantic proofs remain a separate required domain below.
    for functionIndex in 0..<functionCount:
        if parserExprRequiredByFunction[functionIndex] &&
           !typedFunctionSeenByReachableFunction[functionIndex]:
            err = " compiler snapshot builder: normalized expression typed function coverage missing"
            return false
    if parserExprCount != csg.semanticGraph.exprSummary.exprCount:
        err = " compiler snapshot builder: normalized expression identity coverage mismatch"
        return false
    err = ""
    return true

fn compilerSnapshotProductionReferenceRequiredDomainStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        outCid: var layout.FixedBytes32,
        err: var str): bool =
    outCid = layout.FixedBytes32()
    let calls = csg.semanticGraph.resolvedCallTable
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    let rowCount = calls.sourceIndexes.len
    let callDeclarationIndex =
        texpr.TypedExprIrCallDeclarationBuildIndex(csg.typedIr)
    if callDeclarationIndex == nil ||
       callDeclarationIndex.released ||
       !callDeclarationIndex.callDeclarationSealed ||
       callDeclarationIndex.callDeclarationKinds.len !=
           callDeclarationIndex.callDeclarationProducerSourceIndexes.len ||
       callDeclarationIndex.callDeclarationKinds.len !=
           callDeclarationIndex.callDeclarationProducerDeclarationOrdinals.len ||
       callDeclarationIndex.callDeclarationKinds.len !=
           callDeclarationIndex.callDeclarationProducerFunctionRows.len ||
       rowCount != calls.targetProducerSourceIndexes.len ||
       rowCount != calls.targetProducerDeclarationOrdinals.len ||
       rowCount != calls.targetParserSourceLocalDeclarationRows.len:
        err = " compiler snapshot builder: reference call-declaration authority missing"
        return false
    var sourceNodeBases: int32[]
    setLen(sourceNodeBases, sidecars.len)
    var totalParserNodeCount: int32
    for producerSourceId in 0..<sidecars.len:
        sourceNodeBases[producerSourceId] = totalParserNodeCount
        if !compilerSnapshotBuilderCountAppendSafe(
               totalParserNodeCount,
               sidecars[producerSourceId].nodeKinds.len):
            err = " compiler snapshot builder: reference parser node domain overflow"
            return false
        totalParserNodeCount =
            totalParserNodeCount +
            sidecars[producerSourceId].nodeKinds.len
    var canonicalNodeByProducer: int32[]
    setLen(canonicalNodeByProducer, totalParserNodeCount)
    for row in 0..<canonicalNodeByProducer.len:
        canonicalNodeByProducer[row] = -1
    for producerSourceId in 0..<sidecars.len:
        let sidecar = sidecars[producerSourceId]
        for canonicalNodeId in 0..<sidecar.nodeKinds.len:
            let producerNodeId =
                sidecar.nodeProducerIds[canonicalNodeId]
            if producerNodeId < 0 ||
               producerNodeId >= sidecar.nodeKinds.len ||
               canonicalNodeByProducer[
                   sourceNodeBases[producerSourceId] +
                   producerNodeId] >= 0:
                err = " compiler snapshot builder: reference parser node remap invalid"
                return false
            canonicalNodeByProducer[
                sourceNodeBases[producerSourceId] +
                producerNodeId] = canonicalNodeId
    if csg.typeArena == nil ||
       !typearena.TypedExprTypeArenaComplete(csg.typeArena) ||
       !texpr.TypedExprIrNodes2ShapeComplete(csg.typedIr) ||
       csg.semanticGraph.typedIrTable.functionNodeStart.len !=
           csg.semanticGraph.typedIrTable.functionSourceIndexes.len ||
       csg.semanticGraph.typedIrTable.functionNodeCount.len !=
           csg.semanticGraph.typedIrTable.functionSourceIndexes.len ||
       !csg.typedIr.valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           csg.typedIr.valueDefinitionTypeArenaArtifactCid,
           csg.typeArena.artifactRaw32):
        err = " compiler snapshot builder: reference result TypeArena/TypedExpr authority missing"
        return false
    # One linear TypedExpr pass creates the exact
    # (producer source, source-local parser CallExpr node) -> TypedExpr node
    # relation. Text, callee name and source lines never select a result row.
    var typedCallNodeByProducerSlot: int32[]
    var typedCallFunctionByProducerSlot: int32[]
    setLen(typedCallNodeByProducerSlot, totalParserNodeCount)
    setLen(typedCallFunctionByProducerSlot, totalParserNodeCount)
    for slot in 0..<totalParserNodeCount:
        typedCallNodeByProducerSlot[slot] = -1
        typedCallFunctionByProducerSlot[slot] = -1
    for functionId in 0..<
            csg.semanticGraph.typedIrTable.functionSourceIndexes.len:
        let producerSourceId =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[
                functionId]
        let nodeStart =
            csg.semanticGraph.typedIrTable.functionNodeStart[functionId]
        let nodeCount =
            csg.semanticGraph.typedIrTable.functionNodeCount[functionId]
        if producerSourceId < 0 ||
           producerSourceId >= sidecars.len ||
           nodeStart < 0 || nodeCount < 0 ||
           nodeStart > csg.typedIr.nodes2_nodeIndexs.len ||
           nodeCount >
               csg.typedIr.nodes2_nodeIndexs.len - nodeStart:
            err = " compiler snapshot builder: reference TypedExpr function range invalid"
            return false
        for nodePosition in nodeStart..<nodeStart + nodeCount:
            if csg.typedIr.nodes2_opKinds[nodePosition] !=
                   texpr.TypedExprIrOpCallExpr:
                continue
            let producerParserNodeId =
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_originParserNodeIds,
                    nodePosition)
            if producerParserNodeId < 0:
                # Synthetic/runtime CallExpr rows are outside the resolved
                # parser-call domain. A resolved row can never select one
                # because its exact parser slot remains empty below.
                continue
            if producerParserNodeId >=
                   sidecars[producerSourceId].nodeKinds.len:
                err = " compiler snapshot builder: reference CallExpr parser identity missing"
                return false
            let slot =
                sourceNodeBases[producerSourceId] +
                producerParserNodeId
            let canonicalParserNodeId =
                canonicalNodeByProducer[slot]
            if canonicalParserNodeId < 0 ||
               canonicalParserNodeId >=
                   sidecars[producerSourceId].nodeKinds.len ||
               (sidecars[producerSourceId].nodeKinds[
                    canonicalParserNodeId] !=
                    Int32(parser.ParserValueExprCall) &&
                sidecars[producerSourceId].nodeKinds[
                    canonicalParserNodeId] !=
                    Int32(parser.ParserValueExprSpaceCall)) ||
               typedCallNodeByProducerSlot[slot] >= 0:
                err = " compiler snapshot builder: reference CallExpr producer identity ambiguous"
                return false
            typedCallNodeByProducerSlot[slot] = nodePosition
            typedCallFunctionByProducerSlot[slot] = functionId
    var buf = layout.ByteBufInit(512)
    compilerSnapshotBuilderHashAppendText(
        buf,
        "cheng.compiler.snapshot.production_reference_required_domain")
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.parserNormalizedExprReceipt.envelope.receiptRaw32)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.typeArena.artifactRaw32)
    compilerSnapshotBuilderHashAppendU32(buf, rowCount)
    var typedCallSeen: bool[]
    setLen(typedCallSeen, csg.typedIr.nodes2_nodeIndexs.len)
    for row in 0..<rowCount:
        let producerSourceId = calls.sourceIndexes[row]
        let functionId = calls.functionIndexes[row]
        let parserNodeId = calls.originParserNodeIds[row]
        let callerGraphNodeId = calls.callerGraphNodeIds[row]
        let targetGraphNodeId = calls.targetGraphNodeIds[row]
        if producerSourceId < 0 ||
           producerSourceId >= sidecars.len ||
           functionId < 0 ||
           functionId >=
               csg.semanticGraph.typedIrTable.functionGraphNodeIds.len:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: reference source/FunctionId missing"
            return false
        let sidecar = sidecars[producerSourceId]
        var canonicalParserNodeId: int32 = -1
        var typedCallNodePosition: int32 = -1
        if parserNodeId >= 0 &&
           parserNodeId < sidecar.nodeKinds.len:
            canonicalParserNodeId =
                canonicalNodeByProducer[
                    sourceNodeBases[producerSourceId] +
                    parserNodeId]
            typedCallNodePosition =
                typedCallNodeByProducerSlot[
                    sourceNodeBases[producerSourceId] +
                    parserNodeId]
        if parserNodeId < 0 ||
           parserNodeId >= sidecar.nodeKinds.len ||
           canonicalParserNodeId < 0 ||
           canonicalParserNodeId >= sidecar.nodeSpanIds.len ||
           sidecar.nodeSpanIds[canonicalParserNodeId] < 0 ||
           (sidecar.nodeKinds[canonicalParserNodeId] !=
                Int32(parser.ParserValueExprCall) &&
            sidecar.nodeKinds[canonicalParserNodeId] !=
                Int32(parser.ParserValueExprSpaceCall)) ||
           csg.semanticGraph.typedIrTable.functionSourceIndexes[
               functionId] != producerSourceId ||
           csg.semanticGraph.typedIrTable.functionGraphNodeIds[
               functionId] != callerGraphNodeId:
            layout.ByteBufFree(buf)
            err = Fmt" compiler snapshot builder: reference parser node/FunctionId join missing row={row} source={producerSourceId} function={functionId} producer_node={parserNodeId} canonical_node={canonicalParserNodeId} node_count={sidecar.nodeKinds.len} typed_source={csg.semanticGraph.typedIrTable.functionSourceIndexes[functionId]} typed_graph={csg.semanticGraph.typedIrTable.functionGraphNodeIds[functionId]} caller_graph={callerGraphNodeId}"
            return false
        if typedCallNodePosition < 0 ||
           typedCallNodePosition >=
               csg.typedIr.nodes2_nodeIndexs.len ||
           typedCallSeen[typedCallNodePosition] ||
           typedCallFunctionByProducerSlot[
               sourceNodeBases[producerSourceId] +
               parserNodeId] != functionId ||
           csg.typedIr.nodes2_opKinds[typedCallNodePosition] !=
               texpr.TypedExprIrOpCallExpr:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call result CallExpr join missing"
            return false
        let callDeclarationRow =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_callDeclarationIndexes,
                typedCallNodePosition)
        if callDeclarationRow < 0 ||
           callDeclarationRow >=
               callDeclarationIndex.callDeclarationKinds.len ||
           csg.typedIr.nodes2_callKinds[typedCallNodePosition] !=
               texpr.TypedExprCallNone ||
           (callDeclarationIndex.callDeclarationKinds[
                callDeclarationRow] ==
                texpr.TypedExprCallDeclarationImportc) !=
               calls.callTargetImportcFlags[row] ||
           (callDeclarationIndex.callDeclarationKinds[
                callDeclarationRow] !=
                texpr.TypedExprCallDeclarationFunction &&
            callDeclarationIndex.callDeclarationKinds[
                callDeclarationRow] !=
                texpr.TypedExprCallDeclarationImportc):
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call declaration row missing"
            return false
        let targetProducerSource =
            callDeclarationIndex.callDeclarationProducerSourceIndexes[
                callDeclarationRow]
        let targetProducerDeclarationOrdinal =
            callDeclarationIndex.callDeclarationProducerDeclarationOrdinals[
                callDeclarationRow]
        let targetProducerFunctionRow =
            callDeclarationIndex.callDeclarationProducerFunctionRows[
                callDeclarationRow]
        let targetParserSourceLocalDeclarationRow =
            calls.targetParserSourceLocalDeclarationRows[row]
        if targetProducerSource < 0 ||
           targetProducerSource >= sidecars.len ||
           targetProducerDeclarationOrdinal < 0 ||
           targetProducerFunctionRow < -1 ||
           targetParserSourceLocalDeclarationRow < 0 ||
           calls.targetProducerSourceIndexes[row] !=
               targetProducerSource ||
           calls.targetProducerDeclarationOrdinals[row] !=
               targetProducerDeclarationOrdinal:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call target producer coordinate invalid"
            return false
        let targetSidecar = sidecars[targetProducerSource]
        if (calls.callTargetImportcFlags[row] &&
            targetProducerFunctionRow != -1) ||
           (!calls.callTargetImportcFlags[row] &&
            (targetProducerFunctionRow < 0 ||
             targetProducerFunctionRow >=
                 targetSidecar.functionIndexes.len ||
             targetProducerFunctionRow >=
                 targetSidecar.functionDeclarationOrdinals.len ||
             targetSidecar.functionDeclarationOrdinals[
                 targetProducerFunctionRow] !=
                 targetProducerDeclarationOrdinal)):
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call Function row invalid"
            return false
        var targetParserDeclarationRow: int32 = -1
        for declarationRow in 0..<targetSidecar.declarationKinds.len:
            if targetSidecar.declarationSourceLocalRows[declarationRow] ==
                   targetParserSourceLocalDeclarationRow:
                if targetParserDeclarationRow >= 0:
                    layout.ByteBufFree(buf)
                    err = " compiler snapshot builder: resolved call parser declaration ambiguous"
                    return false
                targetParserDeclarationRow = declarationRow
        if targetParserDeclarationRow < 0 ||
           targetSidecar.declarationKinds[targetParserDeclarationRow] !=
               Int32(parser.ParserDeclarationFunction) ||
           targetSidecar.declarationFunctionRows[
               targetParserDeclarationRow] !=
               targetProducerDeclarationOrdinal:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call parser declaration coordinate invalid"
            return false
        let targetReachableFunction =
            targetProducerFunctionRow < 0 ? -1 :
                targetSidecar.functionIndexes[
                    targetProducerFunctionRow]
        if calls.callTargetImportcFlags[row]:
            if targetReachableFunction != -1 || targetGraphNodeId != -1:
                layout.ByteBufFree(buf)
                err = " compiler snapshot builder: importc call fabricated executable target"
                return false
        elif targetReachableFunction < 0 ||
             targetReachableFunction >=
                 csg.semanticGraph.reachableFunctionTable.graphNodeIds.len ||
             targetReachableFunction >=
                 csg.semanticGraph.reachableFunctionTable.producerSourceIndexes.len ||
             targetReachableFunction >=
                 csg.semanticGraph.reachableFunctionTable.producerDeclarationIndexes.len ||
             csg.semanticGraph.reachableFunctionTable.producerSourceIndexes[
                 targetReachableFunction] != targetProducerSource ||
             csg.semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
                 targetReachableFunction] !=
                 targetProducerDeclarationOrdinal ||
             csg.semanticGraph.reachableFunctionTable.graphNodeIds[
                 targetReachableFunction] != targetGraphNodeId:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: Cheng call target declaration/graph join missing"
            return false
        let resultArenaTypeId =
            texpr.TypedExprIrNodeStructuralTypeIdAt(
                csg.typedIr, typedCallNodePosition)
        let resultOwnershipKind =
            compilerSnapshotBuilderOwnershipKind(
                csg.typedIr.nodes2_exprClasses[
                    typedCallNodePosition])
        let resultTypeProofKind =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_resultTypeProofKinds,
                typedCallNodePosition)
        if resultArenaTypeId < 0 ||
           resultArenaTypeId >=
               typearena.TypedExprTypeArenaTypeCount(csg.typeArena):
            layout.ByteBufFree(buf)
            let producerTypedNodeId =
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_nodeIndexs,
                    typedCallNodePosition)
            err = Fmt" compiler snapshot builder: resolved call result TypeId authority invalid call={row} typed_position={typedCallNodePosition} producer_typed_node={producerTypedNodeId} parser_node={parserNodeId} call_declaration={callDeclarationRow} arena_type={resultArenaTypeId} arena_count={typearena.TypedExprTypeArenaTypeCount(csg.typeArena)} type_arena_cid={layout.FixedBytes32Hex(csg.typeArena.artifactRaw32)}"
            return false
        if resultOwnershipKind == 0:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call result ownership authority invalid"
            return false
        if resultTypeProofKind <= texpr.TypedExprSnapshotTypeProofNone ||
           resultTypeProofKind >
               texpr.TypedExprSnapshotTypeProofAggregate:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call result Type proof authority invalid"
            return false
        if csg.typedIr.nodes2_resultTypeManagedFlags[
               typedCallNodePosition] !=
               typearena.TypedExprTypeArenaManagedAt(
                   csg.typeArena, resultArenaTypeId):
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call result managed trait drift"
            return false
        if csg.typedIr.nodes2_resultTypeSendFlags[
               typedCallNodePosition] !=
               typearena.TypedExprTypeArenaSendAt(
                   csg.typeArena, resultArenaTypeId):
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call result Send trait drift"
            return false
        if csg.typedIr.nodes2_resultTypeSyncFlags[
               typedCallNodePosition] !=
               typearena.TypedExprTypeArenaSyncAt(
                   csg.typeArena, resultArenaTypeId):
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: resolved call result Sync trait drift"
            return false
        typedCallSeen[typedCallNodePosition] = true
        if !calls.callTargetImportcFlags[row] &&
           (targetGraphNodeId <= 0 ||
            targetGraphNodeId > csg.nodes.len ||
            csg.nodes[targetGraphNodeId - 1].nodeKind !=
                ccsg.CompilerCsgNodeKindSymbol):
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: reference target graph identity missing"
            return false
        compilerSnapshotBuilderHashAppendU32(buf, row)
        compilerSnapshotBuilderHashAppendU32(buf, producerSourceId)
        compilerSnapshotBuilderHashAppendU32(buf, functionId)
        compilerSnapshotBuilderHashAppendU32(buf, parserNodeId)
        compilerSnapshotBuilderHashAppendU32(
            buf, canonicalParserNodeId)
        compilerSnapshotBuilderHashAppendU32(
            buf, sidecar.nodeSpanIds[canonicalParserNodeId])
        compilerSnapshotBuilderHashAppendU32(buf, callerGraphNodeId)
        compilerSnapshotBuilderHashAppendU32(buf, targetGraphNodeId)
        compilerSnapshotBuilderHashAppendU32(buf, callDeclarationRow)
        compilerSnapshotBuilderHashAppendU32(
            buf, targetProducerSource)
        compilerSnapshotBuilderHashAppendU32(
            buf, targetProducerDeclarationOrdinal)
        compilerSnapshotBuilderHashAppendU32(
            buf, targetProducerFunctionRow)
        compilerSnapshotBuilderHashAppendU32(
            buf, targetParserSourceLocalDeclarationRow)
        compilerSnapshotBuilderHashAppendU32(
            buf, targetReachableFunction)
        compilerSnapshotBuilderHashAppendU32(
            buf, calls.callTargetImportcFlags[row] ? 1 : 0)
        compilerSnapshotBuilderHashAppendU32(
            buf, typedCallNodePosition)
        compilerSnapshotBuilderHashAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_nodeIndexs,
                typedCallNodePosition))
        compilerSnapshotBuilderHashAppendU32(
            buf, resultArenaTypeId)
        compilerSnapshotBuilderHashAppendU32(
            buf, resultOwnershipKind)
        compilerSnapshotBuilderHashAppendU32(
            buf, snapshot_schema.CsgCompilerValueProofFlow)
        compilerSnapshotBuilderHashAppendU32(
            buf, resultTypeProofKind)
    outCid = compilerSnapshotBuilderHashFinish(buf)
    if !compilerSnapshotBuilderCidObserved(outCid):
        err = " compiler snapshot builder: reference required-domain CID missing"
        return false
    err = ""
    return true

fn compilerSnapshotBuilderFinalTypeIdsByArenaTypeBuildInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        out: var int32[],
        err: var str): bool =
    out = []
    var projection: CompilerSnapshotPortableTypeProjection
    if !compilerSnapshotBuilderPortableTypeProjectionBuildInto(
           tables,
           csg.parserNormalizedExprReceipt.sourceSidecars,
           csg,
           projection,
           err):
        return false
    var typeSymbolIdByArenaTypeId: int32[]
    if !compilerSnapshotBuilderPortableTypeSymbolsJoinInto(
           tables,
           projection,
           csg,
           typeSymbolIdByArenaTypeId,
           err):
        return false
    var arenaTypeTexts: str[]
    if !compilerSnapshotBuilderArenaTypeTextsInto(
           csg, arenaTypeTexts, err):
        return false
    var parserGenericRowByArenaTypeId: int32[]
    if !compilerSnapshotBuilderPortableGenericRowsByArenaTypeInto(
           tables, csg, parserGenericRowByArenaTypeId, err):
        return false
    var portable =
        snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    portable.types = snapshot_schema.CsgCompilerTypeTable()
    setLen(out, csg.typeArena.typeCount)
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        let canonicalTextId =
            compilerSnapshotBuilderTextFind(
                portable.texts, arenaTypeTexts[arenaTypeId])
        if canonicalTextId < 0 ||
           !compilerSnapshotBuilderAppendArenaTypeRow(
               portable,
               csg,
               arenaTypeId,
               typeSymbolIdByArenaTypeId,
               parserGenericRowByArenaTypeId,
               canonicalTextId,
               err):
            if err == "":
                err = " compiler snapshot builder: reference result portable Type row missing"
            return false
    # [portable-row-order] Row order is not a dependency order: the aggregate
    # rows are reserved (`typedExprTypeArenaReserveAggregatesRec`) before the
    # non-aggregate rows are interned (`typedExprTypeArenaInternSyntaxRec`),
    # so an object's field TypeId is normally GREATER than the object's own
    # TypeId.  Deriving a row inside the append loop therefore range-checks
    # its premises against a table that does not hold those rows yet and
    # aborts with "object trait premise out of range".  The two passes below
    # are the two the final Type table itself runs, in the same increasing
    # arena row order, so every row lands on the CID the final table holds --
    # a child CID is consumed one pass stale by construction in both places.
    # No guard is dropped: every row is still derived and still checked
    # against this snapshot's own (now complete) row space.
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        var proofCid: layout.FixedBytes32
        var typeCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
               portable, arenaTypeId, proofCid, err):
            return false
        portable.types.traitProofCids[arenaTypeId] = proofCid
        if !snapshot_schema.CsgCompilerTypeRowCidInto(
               portable, arenaTypeId, typeCid, err):
            return false
        portable.types.typeCids[arenaTypeId] = typeCid
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        var proofCid: layout.FixedBytes32
        var typeCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
               portable, arenaTypeId, proofCid, err):
            return false
        portable.types.traitProofCids[arenaTypeId] = proofCid
        if !snapshot_schema.CsgCompilerTypeRowCidInto(
               portable, arenaTypeId, typeCid, err):
            return false
        portable.types.typeCids[arenaTypeId] = typeCid
        let finalTypeId =
            compilerSnapshotBuilderCanonicalTypeIdByCid(
                tables, typeCid)
        if finalTypeId < 0:
            err = " compiler snapshot builder: reference result canonical TypeId missing"
            return false
        out[arenaTypeId] = finalTypeId
    err = ""
    return true

fn compilerSnapshotProductionTypedNodeProofRowsReplayInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        apply: bool,
        out: var compilerSnapshotProductionTypedNodeProofCounts,
        err: var str): bool =
    out = compilerSnapshotProductionTypedNodeProofCounts()
    let typedNodeCount = csg.typedIr.nodes2_nodeIndexs.len
    if csg.typeArena == nil ||
       !texpr.TypedExprIrNodes2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrCaptureAuthorityStrictValidateInto(
           csg.typedIr, err) ||
       tables.typedNodes.typedIrNodeIndexes.len != typedNodeCount ||
       tables.typedNodes.bindingProducerSourceIndexes.len !=
           typedNodeCount ||
       tables.typedNodes.bindingParserSourceLocalNodeRows.len !=
           typedNodeCount ||
       tables.typedNodes.bindingDeclarationSourceLocalRows.len !=
           typedNodeCount ||
       tables.typedNodes.bindingPatternSourceLocalRows.len !=
           typedNodeCount ||
       tables.typedNodes.bindingValueDefinitionRows.len !=
           typedNodeCount ||
       tables.typedNodes.producedValueDefinitionRows.len !=
           typedNodeCount ||
       tables.typedNodes.ownerStatementIds.len != typedNodeCount ||
       tables.valueDefinitions.originKinds.len !=
           texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr) ||
       tables.valueDefinitions.groupRows.len !=
           texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr) ||
       tables.valueDefinitions.producerSourceIndexes.len !=
           texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr) ||
       tables.valueDefinitions.sourceLocalNodeIndexes.len !=
           texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr) ||
       tables.valueDefinitionGroups.producerSourceIndexes.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.parserProducerSourceIndexes.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.bindingOffsets.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.bindingCounts.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.functionIds.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.declarationSourceLocalRows.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.patternSourceLocalRows.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.definitionRows.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.valueDefinitionGroups.consumedFlags.len !=
           texpr.TypedExprValueDefinitionGroupAuthorityCount(
               csg.typedIr) ||
       tables.functions.valueDefinitionStarts.len !=
           tables.functions.symbolIds.len ||
       tables.functions.valueDefinitionCounts.len !=
           tables.functions.symbolIds.len ||
       tables.functions.valueDefinitionGroupStarts.len !=
           tables.functions.symbolIds.len ||
       tables.functions.valueDefinitionGroupCounts.len !=
           tables.functions.symbolIds.len ||
       tables.typedNodes.typeIds.len != typedNodeCount ||
       tables.typedNodes.valueKinds.len != typedNodeCount ||
       tables.typedNodes.captureStarts.len != typedNodeCount ||
       tables.typedNodes.captureCounts.len != typedNodeCount ||
       tables.typedNodes.ownershipKinds.len != typedNodeCount ||
       tables.typedNodes.ownershipProofKinds.len != typedNodeCount ||
       tables.typedNodes.ownershipProofCids.len != typedNodeCount ||
       tables.typedNodes.sendConclusions.len != typedNodeCount ||
       tables.typedNodes.sendProofKinds.len != typedNodeCount ||
       tables.typedNodes.sendProofCids.len != typedNodeCount ||
       tables.typedNodes.syncConclusions.len != typedNodeCount ||
       tables.typedNodes.syncProofKinds.len != typedNodeCount ||
       tables.typedNodes.syncProofCids.len != typedNodeCount ||
       tables.typedNodes.shareKinds.len != typedNodeCount ||
       tables.typedNodes.shareProofCids.len != typedNodeCount ||
       (apply &&
        (tables.typedNodes.captureValueDefinitionRows.len != 0 ||
         tables.typedNodes.captureTypeIds.len != 0 ||
         tables.typedNodes.captureOwnershipKinds.len != 0)) ||
       (!apply &&
        (tables.typedNodes.captureValueDefinitionRows.len !=
             tables.typedNodes.captureTypeIds.len ||
         tables.typedNodes.captureValueDefinitionRows.len !=
             tables.typedNodes.captureOwnershipKinds.len)):
        if err != "":
            return false
        err = " compiler snapshot builder: TypedNode proof domain split"
        return false
    var finalTypeIdByArenaTypeId: int32[]
    if !compilerSnapshotBuilderFinalTypeIdsByArenaTypeBuildInto(
           tables, csg, finalTypeIdByArenaTypeId, err):
        return false
    var positionByProducerNode: int32[]
    setLen(positionByProducerNode, typedNodeCount)
    for producerNodeId in 0..<typedNodeCount:
        positionByProducerNode[producerNodeId] = -1
    for nodePosition in 0..<typedNodeCount:
        let producerNodeId = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_nodeIndexs,
            nodePosition)
        if producerNodeId < 0 ||
           producerNodeId >= typedNodeCount ||
           positionByProducerNode[producerNodeId] >= 0:
            err = " compiler snapshot builder: TypedNode proof producer identity invalid"
            return false
        positionByProducerNode[producerNodeId] = nodePosition
    var snapshotCaptureCursor: int32
    for typedNodeId in 0..<typedNodeCount:
        let producerNodeId =
            tables.typedNodes.typedIrNodeIndexes[typedNodeId]
        let nodePosition =
            producerNodeId < 0 ||
            producerNodeId >= positionByProducerNode.len ?
                -1 : positionByProducerNode[producerNodeId]
        let arenaTypeId =
            nodePosition < 0 ? -1 :
                texpr.TypedExprIrNodeStructuralTypeIdAt(
                    csg.typedIr, nodePosition)
        let finalTypeId =
            arenaTypeId < 0 ||
            arenaTypeId >= finalTypeIdByArenaTypeId.len ?
                -1 : finalTypeIdByArenaTypeId[arenaTypeId]
        let opKind =
            nodePosition < 0 ?
                texpr.TypedExprIrOpUnsupported :
                csg.typedIr.nodes2_opKinds[nodePosition]
        let valueKind =
            nodePosition < 0 ? 0 :
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_valueKinds,
                    nodePosition)
        let shareKind =
            nodePosition < 0 ? 0 :
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_shareKinds,
                    nodePosition)
        let shareProofKind =
            nodePosition < 0 ? 0 :
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_shareProofKinds,
                    nodePosition)
        let ownershipKind =
            nodePosition < 0 ? 0 :
                compilerSnapshotBuilderOwnershipKind(
                    csg.typedIr.nodes2_exprClasses[nodePosition])
        let resultTypeProofKind =
            nodePosition < 0 ? 0 :
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_resultTypeProofKinds,
                    nodePosition)
        if nodePosition < 0 || finalTypeId < 0 ||
           finalTypeId >= tables.types.typeCids.len ||
           tables.typedNodes.typeIds[typedNodeId] != finalTypeId ||
           valueKind <= 0 ||
           valueKind > snapshot_schema.CsgCompilerValueClosure ||
           shareKind <= 0 ||
           shareKind > snapshot_schema.CsgCompilerShareThreadSafe ||
           shareProofKind <= 0 ||
           shareProofKind > snapshot_schema.CsgCompilerValueProofBoundary ||
           ((shareKind == snapshot_schema.CsgCompilerShareNone &&
             shareProofKind != snapshot_schema.CsgCompilerValueProofTypeTrait) ||
            (shareKind == snapshot_schema.CsgCompilerShareLocal &&
             shareProofKind != snapshot_schema.CsgCompilerValueProofFlow) ||
            (shareKind == snapshot_schema.CsgCompilerShareThreadSafe &&
             shareProofKind != snapshot_schema.CsgCompilerValueProofBoundary)) ||
           ownershipKind == 0 ||
           resultTypeProofKind <= texpr.TypedExprSnapshotTypeProofNone ||
           resultTypeProofKind >
               texpr.TypedExprSnapshotTypeProofAggregate ||
           tables.types.traitConclusionKinds[finalTypeId] !=
               snapshot_schema.CsgCompilerTraitConclusionExact ||
           !compilerSnapshotBuilderCidObserved(
               tables.types.traitProofCids[finalTypeId]) ||
           tables.types.managedFlags[finalTypeId] !=
               csg.typedIr.nodes2_resultTypeManagedFlags[nodePosition] ||
           tables.types.sendFlags[finalTypeId] !=
               csg.typedIr.nodes2_resultTypeSendFlags[nodePosition] ||
           tables.types.syncFlags[finalTypeId] !=
               csg.typedIr.nodes2_resultTypeSyncFlags[nodePosition]:
            err = " compiler snapshot builder: TypedNode TypeArena proof drift"
            return false
        let managed = tables.types.managedFlags[finalTypeId]
        if (managed &&
            ownershipKind != snapshot_schema.CsgCompilerOwnershipOwned &&
            ownershipKind != snapshot_schema.CsgCompilerOwnershipBorrowed):
            err = " compiler snapshot builder: TypedNode ownership authority drift"
            return false
        let ownershipProofKind =
            managed ||
            ownershipKind != snapshot_schema.CsgCompilerOwnershipUnmanaged ||
            opKind == texpr.TypedExprIrOpCallExpr ?
                snapshot_schema.CsgCompilerValueProofFlow :
                snapshot_schema.CsgCompilerValueProofTypeTrait
        let traitProofKind =
            (valueKind == snapshot_schema.CsgCompilerValueFunctionAddress ||
             valueKind == snapshot_schema.CsgCompilerValueClosure) ?
                snapshot_schema.CsgCompilerValueProofBoundary :
                snapshot_schema.CsgCompilerValueProofTypeTrait
        let producerCaptureStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_captureStarts,
            nodePosition)
        let producerCaptureCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_captureCounts,
            nodePosition)
        var valueSend =
            csg.typedIr.nodes2_resultTypeSendFlags[nodePosition]
        var valueSync =
            csg.typedIr.nodes2_resultTypeSyncFlags[nodePosition]
        if valueKind == snapshot_schema.CsgCompilerValueClosure:
            valueSend = true
            valueSync = true
            for captureOffset in 0..<producerCaptureCount:
                let captureRow =
                    producerCaptureStart + captureOffset
                let captureTypeId = arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.captures2_exactTypeIds,
                    captureRow)
                let captureOwnership = arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.captures2_ownerships,
                    captureRow)
                if captureOwnership ==
                       Int32(texpr.TypedExprExprBorrowed):
                    valueSend = false
                    valueSync = false
                else:
                    valueSend =
                        valueSend &&
                        typearena.TypedExprTypeArenaSendAt(
                            csg.typeArena, captureTypeId)
                    valueSync =
                        valueSync &&
                        typearena.TypedExprTypeArenaSyncAt(
                            csg.typeArena, captureTypeId)
        if apply:
            if (tables.typedNodes.valueKinds[typedNodeId] != 0 &&
                tables.typedNodes.valueKinds[typedNodeId] != valueKind) ||
               (tables.typedNodes.ownershipProofKinds[typedNodeId] != 0 &&
                tables.typedNodes.ownershipProofKinds[typedNodeId] !=
                    ownershipProofKind) ||
               compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.ownershipProofCids[typedNodeId]) ||
               compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.sendProofCids[typedNodeId]) ||
               compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.syncProofCids[typedNodeId]) ||
               (tables.typedNodes.shareKinds[typedNodeId] != 0 &&
                tables.typedNodes.shareKinds[typedNodeId] != shareKind) ||
               compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.shareProofCids[typedNodeId]):
                err = " compiler snapshot builder: TypedNode staged value proof drift"
                return false
            tables.typedNodes.valueKinds[typedNodeId] = valueKind
            tables.typedNodes.ownershipProofKinds[typedNodeId] =
                ownershipProofKind
            tables.typedNodes.sendConclusions[typedNodeId] =
                valueSend
            tables.typedNodes.sendProofKinds[typedNodeId] =
                traitProofKind
            tables.typedNodes.syncConclusions[typedNodeId] =
                valueSync
            tables.typedNodes.syncProofKinds[typedNodeId] =
                traitProofKind
            tables.typedNodes.shareKinds[typedNodeId] = shareKind
        elif tables.typedNodes.valueKinds[typedNodeId] != valueKind ||
             tables.typedNodes.ownershipProofKinds[typedNodeId] !=
                 ownershipProofKind ||
             tables.typedNodes.sendConclusions[typedNodeId] !=
                 valueSend ||
             tables.typedNodes.sendProofKinds[typedNodeId] !=
                 traitProofKind ||
             tables.typedNodes.syncConclusions[typedNodeId] !=
                 valueSync ||
             tables.typedNodes.syncProofKinds[typedNodeId] !=
                 traitProofKind ||
             tables.typedNodes.shareKinds[typedNodeId] != shareKind:
            err = " compiler snapshot builder: TypedNode value/trait replay drift"
            return false
        let snapshotCaptureStart = snapshotCaptureCursor
        if apply:
            tables.typedNodes.captureStarts[typedNodeId] =
                snapshotCaptureStart
            tables.typedNodes.captureCounts[typedNodeId] =
                producerCaptureCount
        elif tables.typedNodes.captureStarts[typedNodeId] !=
                 snapshotCaptureStart ||
             tables.typedNodes.captureCounts[typedNodeId] !=
                 producerCaptureCount:
            err = " compiler snapshot builder: closure capture CSR drift"
            return false
        for captureOffset in 0..<producerCaptureCount:
            let producerCaptureRow =
                producerCaptureStart + captureOffset
            let definitionRow = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.captures2_valueDefinitionRows,
                producerCaptureRow)
            let captureArenaTypeId = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.captures2_exactTypeIds,
                producerCaptureRow)
            let captureOwnership = compilerSnapshotBuilderOwnershipKind(
                texpr.TypedExprExprClass(
                    arenamod.ArenaArrayInt32Get(
                        csg.typedIr.arena,
                        csg.typedIr.captures2_ownerships,
                        producerCaptureRow)))
            let captureTypeId =
                captureArenaTypeId < 0 ||
                captureArenaTypeId >= finalTypeIdByArenaTypeId.len ?
                    -1 :
                    finalTypeIdByArenaTypeId[captureArenaTypeId]
            if definitionRow < 0 || captureTypeId < 0 ||
               captureOwnership == 0:
                err = " compiler snapshot builder: closure capture proof missing"
                return false
            let snapshotCaptureRow =
                snapshotCaptureStart + captureOffset
            if apply:
                add(tables.typedNodes.captureValueDefinitionRows,
                    definitionRow)
                add(tables.typedNodes.captureTypeIds, captureTypeId)
                add(tables.typedNodes.captureOwnershipKinds,
                    captureOwnership)
            elif snapshotCaptureRow >=
                     tables.typedNodes.captureValueDefinitionRows.len ||
                 tables.typedNodes.captureValueDefinitionRows[
                     snapshotCaptureRow] != definitionRow ||
                 tables.typedNodes.captureTypeIds[snapshotCaptureRow] !=
                     captureTypeId ||
                 tables.typedNodes.captureOwnershipKinds[
                     snapshotCaptureRow] != captureOwnership:
                err = " compiler snapshot builder: closure capture replay drift"
                return false
        snapshotCaptureCursor =
            snapshotCaptureCursor + producerCaptureCount
        var ownershipProofCid: layout.FixedBytes32
        var sendProofCid: layout.FixedBytes32
        var syncProofCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypedNodeOwnershipProofCidInto(
               tables, typedNodeId, ownershipProofCid, err) ||
           !snapshot_schema.CsgCompilerTypedNodeSendProofCidInto(
               tables, typedNodeId, sendProofCid, err) ||
           !snapshot_schema.CsgCompilerTypedNodeSyncProofCidInto(
               tables, typedNodeId, syncProofCid, err):
            return false
        if apply:
            tables.typedNodes.ownershipProofCids[typedNodeId] =
                ownershipProofCid
            tables.typedNodes.sendProofCids[typedNodeId] =
                sendProofCid
            tables.typedNodes.syncProofCids[typedNodeId] =
                syncProofCid
        elif !layout.FixedBytes32Equal(
                 tables.typedNodes.ownershipProofCids[typedNodeId],
                 ownershipProofCid) ||
             !layout.FixedBytes32Equal(
                 tables.typedNodes.sendProofCids[typedNodeId],
                 sendProofCid) ||
             !layout.FixedBytes32Equal(
                 tables.typedNodes.syncProofCids[typedNodeId],
                 syncProofCid):
            err = " compiler snapshot builder: TypedNode proof CID replay drift"
            return false
        var shareProofCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypedNodeShareProofCidInto(
               tables, typedNodeId, shareProofCid, err):
            return false
        if apply:
            tables.typedNodes.shareProofCids[typedNodeId] =
                shareProofCid
        elif !layout.FixedBytes32Equal(
                 tables.typedNodes.shareProofCids[typedNodeId],
                 shareProofCid):
            err = " compiler snapshot builder: TypedNode share proof CID replay drift"
            return false
        out.completeProofCount = out.completeProofCount + 1
    if snapshotCaptureCursor !=
           tables.typedNodes.captureValueDefinitionRows.len ||
       out.completeProofCount != typedNodeCount ||
       out.missingShareProofCount != 0:
        err = " compiler snapshot builder: TypedNode proof coverage drift"
        return false
    err = ""
    return true

fn compilerSnapshotProductionTypedNodeProofCid(
        csg: var ccsg.CompilerCsg,
        tables: var snapshot_schema.CsgCompilerSnapshotTables): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.typed_node.proof")
    compilerSnapshotBuilderHashAppendU32(
        buf, snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest)
    compilerSnapshotBuilderHashAppendI64(buf, tables.semanticEpoch)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.typeArena.artifactRaw32)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.typedStatements.typedIrStatementIndexes.len)
    for statementId in 0..<
            tables.typedStatements.typedIrStatementIndexes.len:
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedStatements.typedIrStatementIndexes[statementId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedStatements.functionIds[statementId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedStatements.rootStarts[statementId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedStatements.rootCounts[statementId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.typedStatements.rootTypedNodeIds.len)
    for rootTypedNodeId in tables.typedStatements.rootTypedNodeIds:
        compilerSnapshotBuilderHashAppendU32(buf, rootTypedNodeId)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.typedNodes.functionIds.len)
    for typedNodeId in 0..<tables.typedNodes.functionIds.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.typedIrNodeIndexes[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.bindingProducerSourceIndexes[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.bindingParserSourceLocalNodeRows[
                typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.bindingDeclarationSourceLocalRows[
                typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.bindingPatternSourceLocalRows[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.bindingValueDefinitionRows[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.producedValueDefinitionRows[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.ownerStatementIds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.functionIds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.opKinds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.typeIds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.valueKinds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.ownershipKinds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.ownershipProofKinds[typedNodeId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.typedNodes.ownershipProofCids[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.sendProofKinds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.sendConclusions[typedNodeId] ? 1 : 0)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.typedNodes.sendProofCids[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.syncProofKinds[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.typedNodes.syncConclusions[typedNodeId] ? 1 : 0)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.typedNodes.syncProofCids[typedNodeId])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.typedNodes.shareKinds[typedNodeId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.typedNodes.shareProofCids[typedNodeId])
        let captureStart =
            tables.typedNodes.captureStarts[typedNodeId]
        let captureCount =
            tables.typedNodes.captureCounts[typedNodeId]
        compilerSnapshotBuilderHashAppendU32(buf, captureStart)
        compilerSnapshotBuilderHashAppendU32(
            buf, captureCount)
        for captureOffset in 0..<captureCount:
            let captureRow = captureStart + captureOffset
            compilerSnapshotBuilderHashAppendU32(
                buf,
                tables.typedNodes.captureValueDefinitionRows[captureRow])
            compilerSnapshotBuilderHashAppendU32(
                buf, tables.typedNodes.captureTypeIds[captureRow])
            compilerSnapshotBuilderHashAppendU32(
                buf,
                tables.typedNodes.captureOwnershipKinds[captureRow])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.valueDefinitions.producerSourceIndexes.len)
    for definitionRow in 0..<
            tables.valueDefinitions.producerSourceIndexes.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.valueDefinitions.originKinds[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.valueDefinitions.groupRows[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitions.producerSourceIndexes[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitions.sourceLocalNodeIndexes[
                definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitions.declarationSourceLocalRows[
                definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitions.patternSourceLocalRows[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.valueDefinitions.functionIds[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitions.definingTypedNodeIds[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.valueDefinitions.typeIds[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.valueDefinitions.ownershipKinds[definitionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.valueDefinitions.proofKinds[definitionRow])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.valueDefinitionGroups.producerSourceIndexes.len)
    for groupRow in 0..<
            tables.valueDefinitionGroups.producerSourceIndexes.len:
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.producerSourceIndexes[
                groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.parserProducerSourceIndexes[
                groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.bindingOffsets[groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.bindingCounts[groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.valueDefinitionGroups.functionIds[groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.declarationSourceLocalRows[
                groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.patternSourceLocalRows[
                groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.definitionRows[groupRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.valueDefinitionGroups.consumedFlags[groupRow])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.functions.valueDefinitionStarts.len)
    for functionId in 0..<
            tables.functions.valueDefinitionStarts.len:
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.valueDefinitionStarts[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.valueDefinitionCounts[functionId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.functions.valueDefinitionGroupStarts.len)
    for functionId in 0..<
            tables.functions.valueDefinitionGroupStarts.len:
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.valueDefinitionGroupStarts[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            tables.functions.valueDefinitionGroupCounts[functionId])
    return compilerSnapshotBuilderHashFinish(buf)

fn compilerSnapshotProductionTypedNodeAdmissionApplyInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        admission: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    var proofCounts: compilerSnapshotProductionTypedNodeProofCounts
    if !compilerSnapshotProductionTypedNodeProofRowsReplayInto(
           tables, csg, false, proofCounts, err):
        return false
    admission.missingTypedNodeDeclarationIdentityCount = 0
    admission.missingTypedNodeTypeIdCount = 0
    admission.missingTypedNodeValueDefinitionCount = 0
    admission.missingTypedNodeOwnershipProofCount = 0
    admission.missingTypedNodeCaptureProofCount = 0
    admission.missingTypedNodeSourceBindingCount = 0
    admission.missingTypedNodeProofCount =
        proofCounts.missingShareProofCount
    if admission.missingTypedNodeProofCount == 0:
        var expectedFragmentCids: layout.FixedBytes32[]
        if !snapshot_schema.CsgCompilerFunctionFragmentCidsInto(
               tables, expectedFragmentCids, err) ||
           expectedFragmentCids.len !=
               tables.functions.fragmentCids.len:
            if err == "":
                err = " compiler snapshot builder: TypedNode fragment proof coverage drift"
            return false
        for functionId in 0..<expectedFragmentCids.len:
            if !layout.FixedBytes32Equal(
                   expectedFragmentCids[functionId],
                   tables.functions.fragmentCids[functionId]):
                err = " compiler snapshot builder: TypedNode fragment proof replay drift"
                return false
        let typedNodeProofCid =
            compilerSnapshotProductionTypedNodeProofCid(csg, tables)
        admission.typedNodeProofCid = typedNodeProofCid
        if !compilerSnapshotBuilderCidObserved(
               admission.typedNodeProofCid):
            err = " compiler snapshot builder: TypedNode proof CID missing"
            return false
        admission.missingFactBitmap =
            admission.missingFactBitmap &
            (511 - CompilerSnapshotAdmissionMissingTypedNodeProof)
    else:
        let emptyTypedNodeProofCid = layout.FixedBytes32()
        admission.typedNodeProofCid = emptyTypedNodeProofCid
        admission.missingFactBitmap =
            admission.missingFactBitmap |
            CompilerSnapshotAdmissionMissingTypedNodeProof
    err = ""
    return true

fn compilerSnapshotProductionReferenceProjectionMatchesCsgInto(
        csg: var ccsg.CompilerCsg,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    let calls = csg.semanticGraph.resolvedCallTable
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    let declarationIndex =
        texpr.TypedExprIrCallDeclarationBuildIndex(csg.typedIr)
    if declarationIndex == nil || declarationIndex.released ||
       declarationIndex.callDeclarationKinds.len !=
           declarationIndex.callDeclarationProducerSourceIndexes.len ||
       declarationIndex.callDeclarationKinds.len !=
           declarationIndex.callDeclarationProducerDeclarationOrdinals.len ||
       declarationIndex.callDeclarationKinds.len !=
           declarationIndex.callDeclarationProducerFunctionRows.len ||
       tables.calls.callReferenceIds.len != calls.sourceIndexes.len:
        err = " compiler snapshot builder: candidate reference producer domain split"
        return false
    var sourceNodeBases: int32[]
    var totalParserNodes: int32
    for producerSource in 0..<sidecars.len:
        add(sourceNodeBases, totalParserNodes)
        if !compilerSnapshotBuilderCountAppendSafe(
               totalParserNodes,
               sidecars[producerSource].nodeKinds.len):
            err = " compiler snapshot builder: candidate reference parser domain overflow"
            return false
        totalParserNodes =
            totalParserNodes + sidecars[producerSource].nodeKinds.len
    var resolvedRowByParserSlot: int32[]
    setLen(resolvedRowByParserSlot, totalParserNodes)
    for slot in 0..<resolvedRowByParserSlot.len:
        resolvedRowByParserSlot[slot] = -1
    for resolvedRow in 0..<calls.sourceIndexes.len:
        let producerSource = calls.sourceIndexes[resolvedRow]
        let parserNodeId = calls.originParserNodeIds[resolvedRow]
        if producerSource < 0 || producerSource >= sidecars.len ||
           parserNodeId < 0 ||
           parserNodeId >= sidecars[producerSource].nodeKinds.len:
            err = " compiler snapshot builder: candidate reference parser row invalid"
            return false
        let slot =
            sourceNodeBases[producerSource] + parserNodeId
        if resolvedRowByParserSlot[slot] >= 0:
            err = " compiler snapshot builder: candidate reference parser row ambiguous"
            return false
        resolvedRowByParserSlot[slot] = resolvedRow
    var typedPositionByProducerNode: int32[]
    setLen(typedPositionByProducerNode,
        csg.typedIr.nodes2_nodeIndexs.len)
    for row in 0..<typedPositionByProducerNode.len:
        typedPositionByProducerNode[row] = -1
    for typedPosition in 0..<csg.typedIr.nodes2_nodeIndexs.len:
        let producerNodeId = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_nodeIndexs,
            typedPosition)
        if producerNodeId < 0 ||
           producerNodeId >= typedPositionByProducerNode.len ||
           typedPositionByProducerNode[producerNodeId] >= 0:
            err = " compiler snapshot builder: candidate reference TypedExpr identity invalid"
            return false
        typedPositionByProducerNode[producerNodeId] =
            typedPosition
    var finalTypeIdByArenaTypeId: int32[]
    if !compilerSnapshotBuilderFinalTypeIdsByArenaTypeBuildInto(
           tables, csg, finalTypeIdByArenaTypeId, err):
        return false
    for callId in 0..<tables.calls.callReferenceIds.len:
        let callerFunctionId =
            tables.calls.callerFunctionIds[callId]
        let calleeSymbolId =
            tables.calls.calleeSymbolIds[callId]
        let resultTypedNodeId =
            tables.calls.resultTypedNodeIds[callId]
        if callerFunctionId < 0 ||
           callerFunctionId >= tables.functions.typedFunctionIndexes.len ||
           calleeSymbolId < 0 ||
           calleeSymbolId >= tables.symbols.functionIds.len ||
           calleeSymbolId >=
               tables.symbols.externFunctionIds.len ||
           resultTypedNodeId < 0 ||
           resultTypedNodeId >=
               tables.typedNodes.typedIrNodeIndexes.len:
            err = " compiler snapshot builder: candidate reference semantic row invalid"
            return false
        let callerTypedFunction =
            tables.functions.typedFunctionIndexes[
                callerFunctionId]
        let targetFunctionId =
            tables.symbols.functionIds[calleeSymbolId]
        let targetExternFunctionId =
            tables.symbols.externFunctionIds[calleeSymbolId]
        var targetTypedFunction: int32 = -1
        if targetFunctionId >= 0 &&
           targetFunctionId <
               tables.functions.typedFunctionIndexes.len:
            targetTypedFunction =
                tables.functions.typedFunctionIndexes[targetFunctionId]
        let producerTypedNodeId =
            tables.typedNodes.typedIrNodeIndexes[resultTypedNodeId]
        var typedPosition: int32 = -1
        if producerTypedNodeId >= 0 &&
           producerTypedNodeId < typedPositionByProducerNode.len:
            typedPosition =
                typedPositionByProducerNode[producerTypedNodeId]
        if callerTypedFunction < 0 ||
           callerTypedFunction >=
               csg.semanticGraph.typedIrTable.functionSourceIndexes.len ||
           ((targetFunctionId >= 0) ==
            (targetExternFunctionId >= 0)) ||
           typedPosition < 0:
            err = " compiler snapshot builder: candidate reference TypedExpr join missing"
            return false
        let producerSource =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[
                callerTypedFunction]
        let parserNodeId = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_originParserNodeIds,
            typedPosition)
        var resolvedRow: int32 = -1
        if producerSource >= 0 &&
           producerSource < sidecars.len &&
           parserNodeId >= 0 &&
           parserNodeId < sidecars[producerSource].nodeKinds.len:
            resolvedRow =
                resolvedRowByParserSlot[
                    sourceNodeBases[producerSource] +
                        parserNodeId]
        let callDeclarationRow = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_callDeclarationIndexes,
            typedPosition)
        let resultArenaTypeId =
            texpr.TypedExprIrNodeStructuralTypeIdAt(
                csg.typedIr, typedPosition)
        let expectedResultTypeId =
            resultArenaTypeId < 0 ||
            resultArenaTypeId >=
                finalTypeIdByArenaTypeId.len ?
                -1 :
                finalTypeIdByArenaTypeId[resultArenaTypeId]
        let expectedResultOwnershipKind =
            compilerSnapshotBuilderOwnershipKind(
                csg.typedIr.nodes2_exprClasses[typedPosition])
        var expectedResultOwnershipProofCid: layout.FixedBytes32
        if expectedResultTypeId < 0 ||
           expectedResultOwnershipKind == 0 ||
           tables.typedNodes.opKinds[resultTypedNodeId] !=
               texpr.TypedExprIrOpCallExpr ||
           tables.typedNodes.functionIds[resultTypedNodeId] !=
               callerFunctionId ||
           tables.typedNodes.typeIds[resultTypedNodeId] !=
               expectedResultTypeId ||
           tables.typedNodes.ownershipKinds[resultTypedNodeId] !=
               expectedResultOwnershipKind ||
           tables.calls.resultTypeIds[callId] !=
               expectedResultTypeId ||
           tables.calls.resultOwnershipKinds[callId] !=
               expectedResultOwnershipKind ||
           tables.calls.resultOwnershipProofKinds[callId] !=
               snapshot_schema.CsgCompilerValueProofFlow ||
           !snapshot_schema.CsgCompilerCallResultOwnershipProofCidInto(
               tables,
               callId,
               expectedResultOwnershipProofCid,
               err) ||
           !layout.FixedBytes32Equal(
               tables.calls.resultOwnershipProofCids[callId],
               expectedResultOwnershipProofCid):
            if err == "":
                err = " compiler snapshot builder: candidate call result Type/ownership producer drift"
            return false
        if resolvedRow < 0 ||
           calls.functionIndexes[resolvedRow] !=
               callerTypedFunction ||
           calls.callTargetImportcFlags[resolvedRow] !=
               (targetExternFunctionId >= 0) ||
           (targetExternFunctionId >= 0 &&
            calls.targetGraphNodeIds[resolvedRow] != -1) ||
           (targetFunctionId >= 0 &&
            (targetTypedFunction < 0 ||
             targetTypedFunction >=
                 csg.semanticGraph.typedIrTable.functionGraphNodeIds.len ||
             calls.targetGraphNodeIds[resolvedRow] !=
                 csg.semanticGraph.typedIrTable.functionGraphNodeIds[
                     targetTypedFunction])) ||
           callDeclarationRow < 0 ||
           callDeclarationRow >=
               declarationIndex.callDeclarationKinds.len ||
           tables.calls.targetCallDeclarationRows[callId] !=
               callDeclarationRow ||
           (declarationIndex.callDeclarationKinds[
                callDeclarationRow] ==
                texpr.TypedExprCallDeclarationImportc) !=
               (targetExternFunctionId >= 0):
            err = " compiler snapshot builder: candidate callDeclaration row drift"
            return false
        let targetProducerSource =
            declarationIndex.callDeclarationProducerSourceIndexes[
                callDeclarationRow]
        let targetDeclarationOrdinal =
            declarationIndex.callDeclarationProducerDeclarationOrdinals[
                callDeclarationRow]
        let targetProducerFunctionRow =
            declarationIndex.callDeclarationProducerFunctionRows[
                callDeclarationRow]
        if targetProducerSource < 0 ||
           targetProducerSource >= sidecars.len ||
           targetDeclarationOrdinal < 0 ||
           targetProducerFunctionRow < -1 ||
           calls.targetProducerSourceIndexes[resolvedRow] !=
               targetProducerSource ||
           calls.targetProducerDeclarationOrdinals[resolvedRow] !=
               targetDeclarationOrdinal:
            err = " compiler snapshot builder: candidate target producer row invalid"
            return false
        let targetParserLocalDeclaration =
            calls.targetParserSourceLocalDeclarationRows[resolvedRow]
        if targetParserLocalDeclaration < 0 ||
           targetParserLocalDeclaration >=
               sidecars[targetProducerSource].declarationKinds.len:
            err = " compiler snapshot builder: candidate target parser declaration row invalid"
            return false
        if targetFunctionId >= 0:
            if targetProducerFunctionRow < 0 ||
               targetProducerFunctionRow >=
                   sidecars[targetProducerSource].functionIndexes.len ||
               targetProducerFunctionRow >=
                   sidecars[targetProducerSource].functionDeclarationOrdinals.len ||
               sidecars[targetProducerSource].functionDeclarationOrdinals[
                       targetProducerFunctionRow] !=
                   targetDeclarationOrdinal:
                err = " compiler snapshot builder: candidate target Function row invalid"
                return false
        elif targetProducerFunctionRow != -1:
            err = " compiler snapshot builder: extern target carried Function row"
            return false
        let targetReachableFunction =
            targetProducerFunctionRow < 0 ? -1 :
                sidecars[targetProducerSource].functionIndexes[
                    targetProducerFunctionRow]
        if targetFunctionId >= 0:
            if targetFunctionId >= tables.functions.symbolIds.len ||
               targetReachableFunction < 0 ||
               targetReachableFunction >=
                   csg.semanticGraph.reachableFunctionTable.graphNodeIds.len ||
               targetReachableFunction >=
                   csg.semanticGraph.reachableFunctionTable.producerSourceIndexes.len ||
               targetReachableFunction >=
                   csg.semanticGraph.reachableFunctionTable.producerDeclarationIndexes.len ||
               csg.semanticGraph.reachableFunctionTable.producerSourceIndexes[
                   targetReachableFunction] != targetProducerSource ||
               csg.semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
                   targetReachableFunction] != targetDeclarationOrdinal ||
               csg.semanticGraph.reachableFunctionTable.graphNodeIds[
                   targetReachableFunction] !=
                   calls.targetGraphNodeIds[resolvedRow] ||
               tables.functions.symbolIds[targetFunctionId] !=
                   calleeSymbolId:
                err = " compiler snapshot builder: candidate call target producer ordinal drift"
                return false
        elif targetExternFunctionId < 0 ||
             targetExternFunctionId >=
                 tables.externFunctions.parserDeclarationRows.len ||
             tables.externFunctions.symbolIds[
                 targetExternFunctionId] != calleeSymbolId:
            err = " compiler snapshot builder: candidate extern call target drift"
            return false
        let targetSourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, targetProducerSource)
        let targetParserDeclaration =
            tables.calls.targetParserDeclarationRows[callId]
        if tables.calls.targetSourceIds[callId] != targetSourceId ||
           tables.calls.targetSourceLocalDeclarationRows[callId] !=
               targetParserLocalDeclaration ||
           targetParserDeclaration < 0 ||
           targetParserDeclaration >=
               tables.parserSidecars.declarationKinds.len ||
           tables.parserSidecars.declarationProducerSourceIds[
               targetParserDeclaration] != targetSourceId ||
           tables.parserSidecars.declarationSourceLocalRows[
               targetParserDeclaration] !=
               targetParserLocalDeclaration ||
           tables.parserSidecars.declarationKinds[
               targetParserDeclaration] !=
               Int32(parser.ParserDeclarationFunction) ||
           sidecars[targetProducerSource].declarationFunctionRows[
               targetParserLocalDeclaration] !=
               targetDeclarationOrdinal ||
           (targetExternFunctionId >= 0 &&
            tables.externFunctions.parserDeclarationRows[
                targetExternFunctionId] !=
                targetParserDeclaration) ||
           tables.calls.targetDeclIds[callId] !=
               tables.symbols.declIds[calleeSymbolId] ||
           !layout.FixedBytes32Equal(
               tables.calls.targetDeclKeyCids[callId],
               tables.symbols.declKeyCids[calleeSymbolId]) ||
           !layout.FixedBytes32Equal(
               tables.calls.targetSymbolCids[callId],
               tables.symbols.symbolCids[calleeSymbolId]):
            err = " compiler snapshot builder: candidate target producer coordinate drift"
            return false
    err = ""
    return true

fn compilerSnapshotProductionLexicalScopeRequiredDomainStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        outCid: var layout.FixedBytes32,
        counts: var compilerSnapshotProductionScopeDomainCounts,
        err: var str): bool =
    outCid = layout.FixedBytes32()
    counts = compilerSnapshotProductionScopeDomainCounts()
    if !texpr.TypedExprIrFunctions2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrScopes2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrStatements2ShapeComplete(csg.typedIr):
        err = " compiler snapshot builder: lexical scope TypedExpr shape missing"
        return false
    var buf = layout.ByteBufInit(768)
    compilerSnapshotBuilderHashAppendText(
        buf,
        "cheng.compiler.snapshot.production_lexical_scope_required_domain")
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.parserNormalizedExprReceipt.envelope.receiptRaw32)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    for producerSourceId in 0..<sidecars.len:
        let sidecar = sidecars[producerSourceId]
        if sidecar.declarationLexicalScopeKinds.len !=
               sidecar.declarationLexicalScopeProducerSourceIds.len ||
           sidecar.declarationLexicalScopeKinds.len !=
               sidecar.declarationLexicalScopeSourceLocalRows.len ||
           sidecar.declarationLexicalScopeKinds.len !=
               sidecar.declarationLexicalScopeParentIds.len ||
           sidecar.declarationLexicalScopeKinds.len !=
               sidecar.declarationLexicalScopeOwnerDeclarationIds.len ||
           sidecar.declarationLexicalScopeKinds.len !=
               sidecar.declarationLexicalScopeSpanIds.len:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: parser lexical scope SoA split"
            return false
        compilerSnapshotBuilderHashAppendU32(
            buf, sidecar.declarationLexicalScopeKinds.len)
        for localScopeId in 0..<
                sidecar.declarationLexicalScopeKinds.len:
            let parentScopeId =
                sidecar.declarationLexicalScopeParentIds[localScopeId]
            let ownerDeclarationId =
                sidecar.declarationLexicalScopeOwnerDeclarationIds[
                    localScopeId]
            if sidecar.declarationLexicalScopeProducerSourceIds[
                   localScopeId] != producerSourceId ||
               sidecar.declarationLexicalScopeSourceLocalRows[
                   localScopeId] != localScopeId ||
               parentScopeId < -1 || parentScopeId >= localScopeId ||
               ownerDeclarationId < -1 ||
               ownerDeclarationId >= sidecar.declarationKinds.len:
                layout.ByteBufFree(buf)
                err = " compiler snapshot builder: parser lexical scope identity invalid"
                return false
            if ownerDeclarationId >= 0:
                counts.parserOwnedScopeCount =
                    counts.parserOwnedScopeCount + 1
            counts.parserScopeCount = counts.parserScopeCount + 1
            compilerSnapshotBuilderHashAppendU32(buf, producerSourceId)
            compilerSnapshotBuilderHashAppendU32(buf, localScopeId)
            compilerSnapshotBuilderHashAppendU32(
                buf, sidecar.declarationLexicalScopeKinds[localScopeId])
            compilerSnapshotBuilderHashAppendU32(buf, parentScopeId)
            compilerSnapshotBuilderHashAppendU32(
                buf, ownerDeclarationId)
            compilerSnapshotBuilderHashAppendU32(
                buf, sidecar.declarationLexicalScopeSpanIds[localScopeId])
    let functionCount =
        csg.semanticGraph.typedIrTable.functionGraphNodeIds.len
    if functionCount !=
           csg.semanticGraph.typedIrTable.functionSourceIndexes.len ||
       functionCount != csg.typedIr.functions2_scopeStarts.len ||
       functionCount != csg.typedIr.functions2_scopeCounts.len ||
       functionCount != csg.typedIr.functions2_statementStarts.len ||
       functionCount != csg.typedIr.functions2_statementCounts.len:
        layout.ByteBufFree(buf)
        err = " compiler snapshot builder: lexical scope function domain split"
        return false
    var scopeCursor: int32
    var statementCursor: int32
    compilerSnapshotBuilderHashAppendU32(buf, functionCount)
    for functionId in 0..<functionCount:
        let scopeStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_scopeStarts,
            functionId)
        let scopeCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_scopeCounts,
            functionId)
        let statementStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_statementStarts,
            functionId)
        let statementCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_statementCounts,
            functionId)
        if scopeStart != scopeCursor || scopeCount <= 0 ||
           scopeCount >
               csg.typedIr.scopes2_scopeIds.len - scopeStart ||
           statementStart != statementCursor || statementCount < 0 ||
           statementCount >
               csg.typedIr.statements2_statementIndexs.len -
                   statementStart:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: lexical scope function range invalid"
            return false
        let producerSourceId =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[
                functionId]
        let functionGraphNodeId =
            csg.semanticGraph.typedIrTable.functionGraphNodeIds[
                functionId]
        if producerSourceId < 0 || producerSourceId >= sidecars.len ||
           functionGraphNodeId <= 0 ||
           functionGraphNodeId > csg.nodes.len ||
           csg.nodes[functionGraphNodeId - 1].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: lexical scope FunctionId identity invalid"
            return false
        compilerSnapshotBuilderHashAppendU32(buf, functionId)
        compilerSnapshotBuilderHashAppendU32(buf, producerSourceId)
        compilerSnapshotBuilderHashAppendU32(buf, functionGraphNodeId)
        compilerSnapshotBuilderHashAppendU32(buf, scopeCount)
        for localScopeId in 0..<scopeCount:
            let scopeRow = scopeStart + localScopeId
            let parentScopeId = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.scopes2_parentScopeIds,
                scopeRow)
            let ownerStatementOrdinal =
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_ownerStatementOrdinals,
                    scopeRow)
            let kind = Int32(csg.typedIr.scopes2_kinds[scopeRow])
            if arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.scopes2_scopeIds,
                   scopeRow) != localScopeId ||
               parentScopeId < -1 ||
               parentScopeId >= localScopeId ||
               (localScopeId == 0 && parentScopeId != -1) ||
               (localScopeId > 0 && parentScopeId < 0) ||
               kind < Int32(parser.NormalizedScopeRoot) ||
               kind > Int32(parser.NormalizedScopeDeferSuite) ||
               ownerStatementOrdinal < -1 ||
               ownerStatementOrdinal >= statementCount:
                layout.ByteBufFree(buf)
                err = " compiler snapshot builder: TypedExpr lexical scope row invalid"
                return false
            counts.typedScopeCount = counts.typedScopeCount + 1
            compilerSnapshotBuilderHashAppendU32(buf, localScopeId)
            compilerSnapshotBuilderHashAppendU32(buf, parentScopeId)
            compilerSnapshotBuilderHashAppendU32(buf, kind)
            compilerSnapshotBuilderHashAppendU32(
                buf, ownerStatementOrdinal)
            compilerSnapshotBuilderHashAppendU32(
                buf,
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_lexicalOrdinals,
                    scopeRow))
            compilerSnapshotBuilderHashAppendU32(
                buf,
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_startLineNumbers,
                    scopeRow))
            compilerSnapshotBuilderHashAppendU32(
                buf,
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_startColumnNumbers,
                    scopeRow))
            compilerSnapshotBuilderHashAppendU32(
                buf,
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_endLineNumbers,
                    scopeRow))
            compilerSnapshotBuilderHashAppendU32(
                buf,
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_endColumnNumbers,
                    scopeRow))
        for statementOffset in 0..<statementCount:
            let statementRow = statementStart + statementOffset
            let lexicalScopeId = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.statements2_lexicalScopeIds,
                statementRow)
            let suiteScopeId = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.statements2_suiteScopeIds,
                statementRow)
            if lexicalScopeId < 0 || lexicalScopeId >= scopeCount ||
               suiteScopeId < -1 || suiteScopeId >= scopeCount:
                layout.ByteBufFree(buf)
                err = " compiler snapshot builder: statement lexical scope use invalid"
                return false
            counts.statementScopeUseCount =
                counts.statementScopeUseCount + 1
            if suiteScopeId >= 0:
                counts.statementScopeUseCount =
                    counts.statementScopeUseCount + 1
            compilerSnapshotBuilderHashAppendU32(
                buf, statementOffset)
            compilerSnapshotBuilderHashAppendU32(
                buf, lexicalScopeId)
            compilerSnapshotBuilderHashAppendU32(
                buf, suiteScopeId)
        scopeCursor = scopeStart + scopeCount
        statementCursor = statementStart + statementCount
    if scopeCursor != csg.typedIr.scopes2_scopeIds.len ||
       statementCursor !=
           csg.typedIr.statements2_statementIndexs.len:
        layout.ByteBufFree(buf)
        err = " compiler snapshot builder: lexical scope coverage incomplete"
        return false
    outCid = compilerSnapshotBuilderHashFinish(buf)
    if !compilerSnapshotBuilderCidObserved(outCid):
        err = " compiler snapshot builder: lexical scope required-domain CID missing"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotProductionDiagnosticRequiredDomainBuildInto(
        csg: ccsg.CompilerCsg,
        out: var compilerSnapshotProductionDiagnosticRequiredDomain,
        err: var str): bool =
    out = compilerSnapshotProductionDiagnosticRequiredDomain()
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    let typedFunctions = csg.semanticGraph.typedIrTable
    let producerKindCount =
        snapshot_schema.CsgCompilerDiagnosticLayout -
        snapshot_schema.CsgCompilerDiagnosticParser + 1
    if producerKindCount <= 0 ||
       sidecars.len > 2147483647 / producerKindCount ||
       sidecars.len != csg.sourceSnapshotCount ||
       csg.typeArena == nil ||
       !compilerSnapshotBuilderCidObserved(
           csg.typeArena.artifactRaw32) ||
       csg.typeArena.producerSourceCount != sidecars.len ||
       csg.typeArena.typeSyntaxTypeIds.len !=
           csg.typeArena.typeSyntaxCount ||
       csg.typeArena.typeKinds.len != csg.typeArena.typeCount ||
       csg.typeArena.symbolIds.len != csg.typeArena.typeCount ||
       csg.typeArena.childStarts.len != csg.typeArena.typeCount ||
       csg.typeArena.childCounts.len != csg.typeArena.typeCount ||
       csg.typeArena.symbolDeclarationRootTypeSyntaxNodeIndexes.len !=
           csg.typeArena.symbolCount ||
       typedFunctions.functionSourceIndexes.len !=
           typedFunctions.functionGraphNodeIds.len ||
       typedFunctions.functionSourceIndexes.len !=
           typedFunctions.functionNodeStart.len ||
       typedFunctions.functionSourceIndexes.len !=
           typedFunctions.functionNodeCount.len:
        err = " compiler snapshot builder: diagnostic required producer domain split"
        return false
    var typeSyntaxBase: int32
    for producerSource in 0..<sidecars.len:
        let sidecar = sidecars[producerSource]
        if sidecar.sourceIndex != producerSource ||
           !compilerSnapshotBuilderCidObserved(sidecar.sidecarRaw32) ||
           !compilerSnapshotBuilderCidObserved(
               sidecar.sourceContentRaw32) ||
           !compilerSnapshotBuilderCidObserved(
               sidecar.parserInputRaw32):
            err = " compiler snapshot builder: diagnostic source identity missing"
            return false
        if typeSyntaxBase < 0 ||
           typeSyntaxBase > csg.typeArena.typeSyntaxCount ||
           sidecar.typeSyntaxKinds.len >
               csg.typeArena.typeSyntaxCount - typeSyntaxBase:
            err = " compiler snapshot builder: diagnostic TypeSyntax coverage split"
            return false
        for producerKind in snapshot_schema.CsgCompilerDiagnosticParser..
                snapshot_schema.CsgCompilerDiagnosticLayout:
            let start = out.requiredProducerIds.len
            add(out.completionRequiredStarts, start)
            if producerKind == snapshot_schema.CsgCompilerDiagnosticParser:
                var row = layout.ByteBufInit(192)
                compilerSnapshotBuilderHashAppendText(
                    row,
                    "cheng.compiler.snapshot.diagnostic.required.parser")
                compilerSnapshotBuilderHashAppendCid(
                    row,
                    csg.parserNormalizedExprReceipt.envelope.receiptRaw32)
                compilerSnapshotBuilderHashAppendU32(
                    row, producerSource)
                compilerSnapshotBuilderHashAppendCid(
                    row, sidecar.sidecarRaw32)
                compilerSnapshotBuilderHashAppendCid(
                    row, sidecar.sourceContentRaw32)
                compilerSnapshotBuilderHashAppendCid(
                    row, sidecar.parserInputRaw32)
                add(out.requiredProducerIds, 0)
                let parserProducerCid =
                    compilerSnapshotBuilderHashFinish(row)
                add(out.requiredProducerCids, parserProducerCid)
            elif producerKind == snapshot_schema.CsgCompilerDiagnosticType:
                for localTypeSyntax in 0..<sidecar.typeSyntaxKinds.len:
                    let globalTypeSyntax =
                        typeSyntaxBase + localTypeSyntax
                    if globalTypeSyntax < 0 ||
                       globalTypeSyntax >= csg.typeArena.typeSyntaxCount:
                        err = " compiler snapshot builder: diagnostic Type denominator missing"
                        return false
                    let arenaTypeId = arenamod.ArenaArrayInt32Get(
                        csg.typeArena.arena,
                        csg.typeArena.typeSyntaxTypeIds,
                        globalTypeSyntax)
                    if arenaTypeId < 0 ||
                       arenaTypeId >= csg.typeArena.typeCount:
                        err = " compiler snapshot builder: diagnostic Type denominator missing"
                        return false
                    var row = layout.ByteBufInit(192)
                    compilerSnapshotBuilderHashAppendText(
                        row,
                        "cheng.compiler.snapshot.diagnostic.required.type")
                    compilerSnapshotBuilderHashAppendCid(
                        row, csg.typeArena.artifactRaw32)
                    compilerSnapshotBuilderHashAppendU32(
                        row, producerSource)
                    compilerSnapshotBuilderHashAppendU32(
                        row, localTypeSyntax)
                    compilerSnapshotBuilderHashAppendU32(
                        row, globalTypeSyntax)
                    compilerSnapshotBuilderHashAppendU32(
                        row, arenaTypeId)
                    add(out.requiredProducerIds, localTypeSyntax)
                    let typeProducerCid =
                        compilerSnapshotBuilderHashFinish(row)
                    add(out.requiredProducerCids, typeProducerCid)
            elif producerKind ==
                     snapshot_schema.CsgCompilerDiagnosticOwnership ||
                 producerKind ==
                     snapshot_schema.CsgCompilerDiagnosticConcurrency:
                for typedFunction in 0..<
                        typedFunctions.functionSourceIndexes.len:
                    if typedFunctions.functionSourceIndexes[
                           typedFunction] != producerSource:
                        continue
                    let nodeStart =
                        typedFunctions.functionNodeStart[typedFunction]
                    let nodeCount =
                        typedFunctions.functionNodeCount[typedFunction]
                    if nodeStart < 0 || nodeCount < 0 ||
                       nodeStart > csg.typedIr.nodes2_nodeIndexs.len ||
                       nodeCount >
                           csg.typedIr.nodes2_nodeIndexs.len - nodeStart:
                        err = " compiler snapshot builder: diagnostic TypedExpr denominator range invalid"
                        return false
                    var fragmentCid: layout.FixedBytes32
                    if !compilerSnapshotBuilderFunctionFragmentCidInto(
                           csg, typedFunction, fragmentCid, err):
                        return false
                    for localNode in 0..<nodeCount:
                        let nodePosition = nodeStart + localNode
                        let producerNodeId =
                            arenamod.ArenaArrayInt32Get(
                                csg.typedIr.arena,
                                csg.typedIr.nodes2_nodeIndexs,
                                nodePosition)
                        if producerNodeId < 0 ||
                           producerNodeId >=
                               csg.typedIr.nodes2_nodeIndexs.len:
                            err = " compiler snapshot builder: diagnostic TypedExpr producer identity invalid"
                            return false
                        var row = layout.ByteBufInit(224)
                        compilerSnapshotBuilderHashAppendText(
                            row,
                            producerKind ==
                                snapshot_schema.CsgCompilerDiagnosticOwnership ?
                                "cheng.compiler.snapshot.diagnostic.required.ownership" :
                                "cheng.compiler.snapshot.diagnostic.required.concurrency")
                        compilerSnapshotBuilderHashAppendCid(
                            row, csg.canonicalGraphCid)
                        compilerSnapshotBuilderHashAppendCid(
                            row, csg.typeArena.artifactRaw32)
                        compilerSnapshotBuilderHashAppendCid(
                            row, fragmentCid)
                        compilerSnapshotBuilderHashAppendU32(
                            row, producerSource)
                        compilerSnapshotBuilderHashAppendU32(
                            row, typedFunction)
                        compilerSnapshotBuilderHashAppendU32(
                            row,
                            typedFunctions.functionGraphNodeIds[
                                typedFunction])
                        compilerSnapshotBuilderHashAppendU32(
                            row, localNode)
                        compilerSnapshotBuilderHashAppendU32(
                            row, producerNodeId)
                        compilerSnapshotBuilderHashAppendU32(
                            row,
                            texpr.TypedExprIrNodeStructuralTypeIdAt(
                                csg.typedIr, nodePosition))
                        add(out.requiredProducerIds, producerNodeId)
                        let typedProducerCid =
                            compilerSnapshotBuilderHashFinish(row)
                        add(out.requiredProducerCids, typedProducerCid)
            else:
                for localDeclaration in 0..<
                        sidecar.declarationKinds.len:
                    if sidecar.declarationKinds[localDeclaration] !=
                           Int32(parser.ParserDeclarationType):
                        continue
                    let localRoot =
                        sidecar.declarationTypeSyntaxRootIds[
                            localDeclaration]
                    let globalRoot = typeSyntaxBase + localRoot
                    let arenaTypeId =
                        localRoot < 0 ||
                        globalRoot >= csg.typeArena.typeSyntaxCount ?
                            -1 :
                            arenamod.ArenaArrayInt32Get(
                                csg.typeArena.arena,
                                csg.typeArena.typeSyntaxTypeIds,
                                globalRoot)
                    let arenaSymbolId =
                        arenaTypeId < 0 ||
                        arenaTypeId >= csg.typeArena.typeCount ?
                            -1 :
                            arenamod.ArenaArrayInt32Get(
                                csg.typeArena.arena,
                                csg.typeArena.symbolIds,
                                arenaTypeId)
                    let childStart =
                        arenaTypeId < 0 ||
                        arenaTypeId >= csg.typeArena.typeCount ?
                            -1 :
                            arenamod.ArenaArrayInt32Get(
                                csg.typeArena.arena,
                                csg.typeArena.childStarts,
                                arenaTypeId)
                    let childCount =
                        arenaTypeId < 0 ||
                        arenaTypeId >= csg.typeArena.typeCount ?
                            -1 :
                            arenamod.ArenaArrayInt32Get(
                                csg.typeArena.arena,
                                csg.typeArena.childCounts,
                                arenaTypeId)
                    let signatureArenaTypeId =
                        childCount == 1 &&
                        childStart >= 0 &&
                        childStart < csg.typeArena.childTypeIds.len ?
                            arenamod.ArenaArrayInt32Get(
                                csg.typeArena.arena,
                                csg.typeArena.childTypeIds,
                                childStart) :
                            -1
                    let arenaTypeKind =
                        arenaTypeId < 0 ||
                        arenaTypeId >= csg.typeArena.typeCount ?
                            -1 :
                            arenamod.ArenaArrayInt32Get(
                                csg.typeArena.arena,
                                csg.typeArena.typeKinds,
                                arenaTypeId)
                    # Nominal object/ref-object declarations carry their own
                    # TypeArena TypeId (kind Object/RefObject) whose layout
                    # authority row is keyed by that same TypeId; only alias
                    # declarations resolve a signature child.  Routing every
                    # ParserDeclarationType through the alias-only join died
                    # nominal declarations before their layout authority was
                    # ever consulted (wall w50).
                    # [phaseB-enum] enum 声明同为 nominal（kind=Enum），但物
                    # 理表示是标量 ordinal，没有复合布局证据域（exact-layout
                    # 发布面只发 Object/RefObject 行，见
                    # compilerSnapshotBuilderTypeProjectionExactLayoutRowBy
                    # ArenaTypeBuildInto 的 kind 过滤）。这类声明既非
                    # nominal-composite 也非 alias，不产生 required-layout
                    # 证据，直接跳过；此前掉进 alias 分支必挂 denominator。
                    if arenaTypeKind ==
                           Int32(typearena.TypedExprStructuralTypeObject) ||
                       arenaTypeKind ==
                           Int32(typearena.TypedExprStructuralTypeRefObject):
                        if localRoot < 0 ||
                           globalRoot < 0 ||
                           globalRoot >= csg.typeArena.typeSyntaxCount ||
                           arenaTypeId < 0 ||
                           arenaTypeId >= csg.typeArena.typeCount ||
                           arenaSymbolId < 0 ||
                           arenaSymbolId >= csg.typeArena.symbolCount ||
                           arenamod.ArenaArrayInt32Get(
                               csg.typeArena.arena,
                               csg.typeArena.symbolDeclarationRootTypeSyntaxNodeIndexes,
                               arenaSymbolId) != globalRoot:
                            err = Fmt" compiler snapshot builder: diagnostic Layout nominal denominator missing declaration={localDeclaration} typeKind={arenaTypeKind} localRoot={localRoot} globalRoot={globalRoot} arenaTypeId={arenaTypeId} arenaSymbolId={arenaSymbolId}"
                            return false
                        var row = layout.ByteBufInit(224)
                        compilerSnapshotBuilderHashAppendText(
                            row,
                            "cheng.compiler.snapshot.diagnostic.required.layout.nominal")
                        compilerSnapshotBuilderHashAppendCid(
                            row, csg.typeArena.artifactRaw32)
                        compilerSnapshotBuilderHashAppendU32(
                            row, producerSource)
                        compilerSnapshotBuilderHashAppendU32(
                            row, localDeclaration)
                        compilerSnapshotBuilderHashAppendU32(
                            row, localRoot)
                        compilerSnapshotBuilderHashAppendU32(
                            row, globalRoot)
                        compilerSnapshotBuilderHashAppendU32(
                            row, arenaTypeId)
                        compilerSnapshotBuilderHashAppendU32(
                            row, arenaSymbolId)
                        compilerSnapshotBuilderHashAppendU32(
                            row, arenaTypeKind)
                        add(out.requiredProducerIds, localDeclaration)
                        let layoutProducerCid =
                            compilerSnapshotBuilderHashFinish(row)
                        add(out.requiredProducerCids, layoutProducerCid)
                    else:
                        if arenaTypeKind !=
                               Int32(typearena.TypedExprStructuralTypeAlias):
                            # [phaseB-enum] 非 nominal-composite（Object/
                            # RefObject 已走上方分支）、非 alias 的声明 kind
                            # （Enum 等）没有 layout/signature-child 证据域，
                            # 跳过而不是当 denominator 缺失拒收。
                            continue
                        if localRoot < 0 ||
                           globalRoot < 0 ||
                           globalRoot >= csg.typeArena.typeSyntaxCount ||
                           arenaTypeId < 0 ||
                           arenaTypeId >= csg.typeArena.typeCount ||
                           arenamod.ArenaArrayInt32Get(
                               csg.typeArena.arena,
                               csg.typeArena.typeKinds,
                               arenaTypeId) !=
                                   Int32(typearena.TypedExprStructuralTypeAlias) ||
                           arenaSymbolId < 0 ||
                           arenaSymbolId >= csg.typeArena.symbolCount ||
                           signatureArenaTypeId < 0 ||
                           signatureArenaTypeId >= arenaTypeId ||
                           arenamod.ArenaArrayInt32Get(
                               csg.typeArena.arena,
                               csg.typeArena.symbolDeclarationRootTypeSyntaxNodeIndexes,
                               arenaSymbolId) != globalRoot:
                            err = Fmt" compiler snapshot builder: diagnostic Layout denominator missing declaration={localDeclaration} typeKind={arenaTypeKind} localRoot={localRoot} globalRoot={globalRoot} arenaTypeId={arenaTypeId} arenaSymbolId={arenaSymbolId} childStart={childStart} childCount={childCount} signatureArenaTypeId={signatureArenaTypeId}"
                            return false
                        var row = layout.ByteBufInit(224)
                        compilerSnapshotBuilderHashAppendText(
                            row,
                            "cheng.compiler.snapshot.diagnostic.required.layout")
                        compilerSnapshotBuilderHashAppendCid(
                            row, csg.typeArena.artifactRaw32)
                        compilerSnapshotBuilderHashAppendU32(
                            row, producerSource)
                        compilerSnapshotBuilderHashAppendU32(
                            row, localDeclaration)
                        compilerSnapshotBuilderHashAppendU32(
                            row, localRoot)
                        compilerSnapshotBuilderHashAppendU32(
                            row, globalRoot)
                        compilerSnapshotBuilderHashAppendU32(
                            row, arenaTypeId)
                        compilerSnapshotBuilderHashAppendU32(
                            row, arenaSymbolId)
                        compilerSnapshotBuilderHashAppendU32(
                            row, signatureArenaTypeId)
                        add(out.requiredProducerIds, localDeclaration)
                        let layoutProducerCid =
                            compilerSnapshotBuilderHashFinish(row)
                        add(out.requiredProducerCids, layoutProducerCid)
            add(out.completionRequiredCounts,
                out.requiredProducerIds.len - start)
        typeSyntaxBase =
            typeSyntaxBase + sidecar.typeSyntaxKinds.len
    if typeSyntaxBase != csg.typeArena.typeSyntaxCount ||
       out.completionRequiredStarts.len !=
           sidecars.len * producerKindCount ||
       out.completionRequiredStarts.len !=
           out.completionRequiredCounts.len ||
       out.requiredProducerIds.len !=
           out.requiredProducerCids.len:
        err = " compiler snapshot builder: diagnostic required CSR coverage drift"
        return false
    var buf = layout.ByteBufInit(512)
    compilerSnapshotBuilderHashAppendText(
        buf,
        "cheng.compiler.snapshot.production_diagnostic_required_domain")
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.receiptCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.parserNormalizedExprReceipt.envelope.receiptRaw32)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.typeArena.artifactRaw32)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendU32(
        buf, out.completionRequiredStarts.len)
    for completionId in 0..<out.completionRequiredStarts.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, completionId / producerKindCount)
        compilerSnapshotBuilderHashAppendU32(
            buf,
            completionId % producerKindCount +
                snapshot_schema.CsgCompilerDiagnosticParser)
        compilerSnapshotBuilderHashAppendU32(
            buf, out.completionRequiredStarts[completionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, out.completionRequiredCounts[completionId])
        for offset in 0..<out.completionRequiredCounts[completionId]:
            let row =
                out.completionRequiredStarts[completionId] + offset
            compilerSnapshotBuilderHashAppendU32(
                buf, out.requiredProducerIds[row])
            compilerSnapshotBuilderHashAppendCid(
                buf, out.requiredProducerCids[row])
    let baseCid = compilerSnapshotBuilderHashFinish(buf)
    out.baseCid = baseCid
    if !compilerSnapshotBuilderCidObserved(out.baseCid):
        err = " compiler snapshot builder: diagnostic required-domain CID missing"
        return false
    err = ""
    return true

fn compilerSnapshotProductionDiagnosticRequiredDomainStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        outCid: var layout.FixedBytes32,
        requiredCount: var int32,
        err: var str): bool =
    var domain: compilerSnapshotProductionDiagnosticRequiredDomain
    if !compilerSnapshotProductionDiagnosticRequiredDomainBuildInto(
           csg, domain, err):
        return false
    outCid = domain.baseCid
    requiredCount = domain.completionRequiredStarts.len
    err = ""
    return true

@borrows
fn compilerSnapshotProductionDiagnosticResultCoverageCidInto(
        csg: ccsg.CompilerCsg,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        producerKind: int32,
        producerId: int32,
        producerCid: layout.FixedBytes32,
        requiredDomainCid: layout.FixedBytes32,
        resultId: var int32,
        resultCid: var layout.FixedBytes32,
        err: var str): bool =
    resultId = -1
    resultCid = layout.FixedBytes32()
    if sourceId < 0 ||
       sourceId >= tables.sources.documentCids.len ||
       producerKind < snapshot_schema.CsgCompilerDiagnosticParser ||
       producerKind > snapshot_schema.CsgCompilerDiagnosticLayout ||
       !compilerSnapshotBuilderCidObserved(producerCid) ||
       !compilerSnapshotBuilderCidObserved(requiredDomainCid):
        err = " compiler snapshot builder: diagnostic result join domain invalid"
        return false
    var coveredRowCid: layout.FixedBytes32
    var row = layout.ByteBufInit(320)
    compilerSnapshotBuilderHashAppendText(
        row, "cheng.compiler.snapshot.diagnostic.covered_row")
    compilerSnapshotBuilderHashAppendCid(row, requiredDomainCid)
    compilerSnapshotBuilderHashAppendCid(row, producerCid)
    compilerSnapshotBuilderHashAppendU32(row, sourceId)
    compilerSnapshotBuilderHashAppendU32(row, producerKind)
    compilerSnapshotBuilderHashAppendU32(row, producerId)
    if producerKind == snapshot_schema.CsgCompilerDiagnosticParser:
        if producerId != 0 ||
           sourceId >= tables.parserSidecars.sidecarCids.len ||
           !compilerSnapshotBuilderCidObserved(
               tables.parserSidecars.sidecarCids[sourceId]):
            layout.ByteBufFree(row)
            err = " compiler snapshot builder: diagnostic parser result missing"
            return false
        resultId = sourceId
        coveredRowCid =
            tables.parserSidecars.sidecarCids[sourceId]
    elif producerKind == snapshot_schema.CsgCompilerDiagnosticType:
        var matchedTypeSyntax: int32 = -1
        var sourceLocalRow: int32
        for typeSyntaxId in 0..<
                tables.parserSidecars.typeSyntaxSourceIds.len:
            if tables.parserSidecars.typeSyntaxSourceIds[
                   typeSyntaxId] != sourceId:
                continue
            if sourceLocalRow == producerId:
                matchedTypeSyntax = typeSyntaxId
                break
            sourceLocalRow = sourceLocalRow + 1
        resultId =
            matchedTypeSyntax < 0 ? -1 :
                tables.parserSidecars.typeSyntaxTypeIds[
                    matchedTypeSyntax]
        if matchedTypeSyntax < 0 || resultId < 0 ||
           resultId >= tables.types.typeCids.len ||
           !compilerSnapshotBuilderCidObserved(
               tables.types.typeCids[resultId]):
            layout.ByteBufFree(row)
            err = " compiler snapshot builder: diagnostic Type result missing"
            return false
        compilerSnapshotBuilderHashAppendU32(
            row, matchedTypeSyntax)
        coveredRowCid = tables.types.typeCids[resultId]
    elif producerKind ==
             snapshot_schema.CsgCompilerDiagnosticOwnership ||
         producerKind ==
             snapshot_schema.CsgCompilerDiagnosticConcurrency:
        for typedNodeId in 0..<
                tables.typedNodes.typedIrNodeIndexes.len:
            if tables.typedNodes.typedIrNodeIndexes[typedNodeId] !=
                   producerId:
                continue
            if resultId >= 0:
                layout.ByteBufFree(row)
                err = " compiler snapshot builder: diagnostic TypedNode result ambiguous"
                return false
            resultId = typedNodeId
        let functionId =
            resultId < 0 ? -1 :
                tables.typedNodes.functionIds[resultId]
        let functionSymbolId =
            functionId < 0 ||
            functionId >= tables.functions.symbolIds.len ?
                -1 : tables.functions.symbolIds[functionId]
        if resultId < 0 || functionSymbolId < 0 ||
           functionSymbolId >= tables.symbols.sourceIds.len ||
           tables.symbols.sourceIds[functionSymbolId] != sourceId:
            layout.ByteBufFree(row)
            err = " compiler snapshot builder: diagnostic TypedNode source join missing"
            return false
        compilerSnapshotBuilderHashAppendU32(row, functionId)
        compilerSnapshotBuilderHashAppendU32(
            row, tables.typedNodes.typeIds[resultId])
        compilerSnapshotBuilderHashAppendU32(
            row, tables.typedNodes.opKinds[resultId])
        compilerSnapshotBuilderHashAppendU32(
            row, tables.typedNodes.valueKinds[resultId])
        if producerKind == snapshot_schema.CsgCompilerDiagnosticOwnership:
            if tables.typedNodes.ownershipProofKinds[resultId] <= 0 ||
               !compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.ownershipProofCids[resultId]):
                layout.ByteBufFree(row)
                err = " compiler snapshot builder: diagnostic ownership proof missing"
                return false
            compilerSnapshotBuilderHashAppendU32(
                row, tables.typedNodes.ownershipKinds[resultId])
            compilerSnapshotBuilderHashAppendU32(
                row, tables.typedNodes.ownershipProofKinds[resultId])
            coveredRowCid =
                tables.typedNodes.ownershipProofCids[resultId]
        else:
            if tables.typedNodes.sendProofKinds[resultId] <= 0 ||
               tables.typedNodes.syncProofKinds[resultId] <= 0 ||
               tables.typedNodes.shareKinds[resultId] <= 0 ||
               !compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.sendProofCids[resultId]) ||
               !compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.syncProofCids[resultId]) ||
               !compilerSnapshotBuilderCidObserved(
                   tables.typedNodes.shareProofCids[resultId]):
                layout.ByteBufFree(row)
                err = " compiler snapshot builder: diagnostic concurrency proof missing"
                return false
            compilerSnapshotBuilderHashAppendU32(
                row, tables.typedNodes.sendProofKinds[resultId])
            compilerSnapshotBuilderHashAppendU32(
                row,
                tables.typedNodes.sendConclusions[resultId] ? 1 : 0)
            compilerSnapshotBuilderHashAppendCid(
                row, tables.typedNodes.sendProofCids[resultId])
            compilerSnapshotBuilderHashAppendU32(
                row, tables.typedNodes.syncProofKinds[resultId])
            compilerSnapshotBuilderHashAppendU32(
                row,
                tables.typedNodes.syncConclusions[resultId] ? 1 : 0)
            compilerSnapshotBuilderHashAppendCid(
                row, tables.typedNodes.syncProofCids[resultId])
            compilerSnapshotBuilderHashAppendU32(
                row, tables.typedNodes.shareKinds[resultId])
            compilerSnapshotBuilderHashAppendCid(
                row, tables.typedNodes.shareProofCids[resultId])
            coveredRowCid =
                tables.typedNodes.shareProofCids[resultId]
    else:
        var declarationRow: int32 = -1
        for candidate in 0..<
                tables.parserSidecars.declarationKinds.len:
            if tables.parserSidecars.declarationProducerSourceIds[
                   candidate] == sourceId &&
               tables.parserSidecars.declarationSourceLocalRows[
                   candidate] == producerId:
                if declarationRow >= 0:
                    layout.ByteBufFree(row)
                    err = " compiler snapshot builder: diagnostic Layout declaration ambiguous"
                    return false
                declarationRow = candidate
        let typeSyntaxRoot =
            declarationRow < 0 ? -1 :
                tables.parserSidecars.declarationTypeSyntaxRootIds[
                    declarationRow]
        let aliasTypeId =
            typeSyntaxRoot < 0 ||
            typeSyntaxRoot >=
                tables.parserSidecars.typeSyntaxTypeIds.len ?
                -1 :
                tables.parserSidecars.typeSyntaxTypeIds[typeSyntaxRoot]
        let declaredTypeKind =
            aliasTypeId < 0 ||
            aliasTypeId >= tables.types.typeKinds.len ?
                -1 : tables.types.typeKinds[aliasTypeId]
        # Alias declarations resolve their layout through the alias target;
        # nominal object/ref-object declarations are layout-authority rows
        # keyed by their own TypeId (mirror of the required-domain nominal
        # arm and of the layouts projection, which admits exactly Object and
        # RefObject final types).
        var layoutTypeId: int32 = -1
        if declaredTypeKind == snapshot_schema.CsgCompilerTypeAlias:
            layoutTypeId =
                aliasTypeId < 0 ||
                aliasTypeId >= tables.types.aliasTargetTypeIds.len ?
                    -1 : tables.types.aliasTargetTypeIds[aliasTypeId]
        elif declaredTypeKind ==
                 snapshot_schema.CsgCompilerTypeObject ||
             declaredTypeKind ==
                 snapshot_schema.CsgCompilerTypeRefObject:
            layoutTypeId = aliasTypeId
        for layoutId in 0..<tables.layouts.typeIds.len:
            if tables.layouts.typeIds[layoutId] != layoutTypeId:
                continue
            if resultId >= 0:
                layout.ByteBufFree(row)
                err = " compiler snapshot builder: diagnostic Layout result ambiguous"
                return false
            resultId = layoutId
        if declarationRow < 0 ||
           tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationType) ||
           aliasTypeId < 0 ||
           aliasTypeId >= tables.types.typeKinds.len ||
           (declaredTypeKind != snapshot_schema.CsgCompilerTypeAlias &&
            declaredTypeKind != snapshot_schema.CsgCompilerTypeObject &&
            declaredTypeKind != snapshot_schema.CsgCompilerTypeRefObject) ||
           layoutTypeId < 0 ||
           layoutTypeId >= tables.types.typeCids.len ||
           resultId < 0 ||
           resultId >= tables.layouts.layoutCids.len ||
           !compilerSnapshotBuilderCidObserved(
               tables.layouts.layoutCids[resultId]):
            layout.ByteBufFree(row)
            err = Fmt" compiler snapshot builder: diagnostic Layout result missing declarationRow={declarationRow} typeKind={declaredTypeKind} aliasTypeId={aliasTypeId} layoutTypeId={layoutTypeId} resultId={resultId}"
            return false
        compilerSnapshotBuilderHashAppendU32(
            row, declarationRow)
        compilerSnapshotBuilderHashAppendU32(
            row, aliasTypeId)
        compilerSnapshotBuilderHashAppendU32(
            row, layoutTypeId)
        coveredRowCid = tables.layouts.layoutCids[resultId]
    compilerSnapshotBuilderHashAppendU32(row, resultId)
    compilerSnapshotBuilderHashAppendCid(row, coveredRowCid)
    resultCid = compilerSnapshotBuilderHashFinish(row)
    if !compilerSnapshotBuilderCidObserved(resultCid):
        err = " compiler snapshot builder: diagnostic covered-row CID missing"
        return false
    err = ""
    return true

fn compilerSnapshotProductionDiagnosticCompletionsBuildInto(
        csg: var ccsg.CompilerCsg,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        receipt: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    if compilerSnapshotBuilderCidObserved(
           tables.diagnosticCompletions.requiredDomainCid) ||
       tables.diagnosticCompletions.requiredStarts.len != 0 ||
       tables.diagnosticCompletions.requiredCounts.len != 0 ||
       tables.diagnosticCompletions.proofCids.len != 0 ||
       tables.diagnosticCompletions.requiredProducerIds.len != 0 ||
       tables.diagnosticCompletions.requiredProducerCids.len != 0 ||
       tables.diagnosticCompletions.requiredResultIds.len != 0 ||
       tables.diagnosticCompletions.requiredResultCids.len != 0:
        err = " compiler snapshot builder: diagnostic denominator destination is not empty"
        return false
    if !CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
           tables,
           csg.parserNormalizedExprReceipt.sourceSidecars,
           csg,
           err):
        return false
    var domain: compilerSnapshotProductionDiagnosticRequiredDomain
    if !compilerSnapshotProductionDiagnosticRequiredDomainBuildInto(
           csg, domain, err):
        return false
    let versionedDomainCid =
        compilerSnapshotProductionVersionedRequiredDomainCid(
            domain.baseCid, receipt.semanticEpoch)
    if !layout.FixedBytes32Equal(
           versionedDomainCid,
           receipt.diagnosticRequiredDomainCid) ||
       receipt.diagnosticCompletionRequiredCount !=
           domain.completionRequiredStarts.len:
        err = " compiler snapshot builder: diagnostic required domain drift"
        return false
    tables.diagnosticCompletions.requiredDomainCid =
        share(versionedDomainCid)
    let producerKindCount =
        snapshot_schema.CsgCompilerDiagnosticLayout -
        snapshot_schema.CsgCompilerDiagnosticParser + 1
    let completionCount =
        tables.diagnosticCompletions.sourceIds.len
    for completionId in 0..<completionCount:
        let sourceId =
            tables.diagnosticCompletions.sourceIds[completionId]
        let producerKind =
            tables.diagnosticCompletions.producerKinds[completionId]
        let producerSource =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        if producerSource < 0 ||
           producerSource >= csg.sourceSnapshotCount:
            err = " compiler snapshot builder: diagnostic source producer missing"
            return false
        let producerCompletionId =
            producerSource * producerKindCount +
                producerKind -
                snapshot_schema.CsgCompilerDiagnosticParser
        let producerStart =
            domain.completionRequiredStarts[
                producerCompletionId]
        let producerCount =
            domain.completionRequiredCounts[
                producerCompletionId]
        add(tables.diagnosticCompletions.requiredStarts,
            tables.diagnosticCompletions.requiredProducerIds.len)
        add(tables.diagnosticCompletions.requiredCounts,
            producerCount)
        for offset in 0..<producerCount:
            let producerRow = producerStart + offset
            let producerId =
                domain.requiredProducerIds[producerRow]
            let producerCid =
                domain.requiredProducerCids[producerRow]
            var resultId: int32
            var resultCid: layout.FixedBytes32
            if !compilerSnapshotProductionDiagnosticResultCoverageCidInto(
                   csg,
                   tables,
                   sourceId,
                   producerKind,
                   producerId,
                   producerCid,
                   versionedDomainCid,
                   resultId,
                   resultCid,
                   err):
                return false
            add(tables.diagnosticCompletions.requiredProducerIds,
                producerId)
            add(tables.diagnosticCompletions.requiredProducerCids,
                producerCid)
            add(tables.diagnosticCompletions.requiredResultIds,
                resultId)
            add(tables.diagnosticCompletions.requiredResultCids,
                resultCid)
        add(tables.diagnosticCompletions.proofCids,
            layout.FixedBytes32())
        var proofCid: layout.FixedBytes32
        var verifiedDiagnosticCount: int32
        if !snapshot_schema.CsgCompilerDiagnosticCompletionProofCidInto(
               tables,
               completionId,
               proofCid,
               verifiedDiagnosticCount,
               err) ||
           tables.diagnosticCompletions.rowCounts[completionId] !=
               verifiedDiagnosticCount:
            return false
        tables.diagnosticCompletions.proofCids[completionId] =
            proofCid
    err = ""
    return true

@borrows
fn compilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
        csg: ccsg.CompilerCsg,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        receipt: CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    var domain: compilerSnapshotProductionDiagnosticRequiredDomain
    if !compilerSnapshotProductionDiagnosticRequiredDomainBuildInto(
           csg, domain, err):
        return false
    let versionedDomainCid =
        compilerSnapshotProductionVersionedRequiredDomainCid(
            domain.baseCid, receipt.semanticEpoch)
    let producerKindCount =
        snapshot_schema.CsgCompilerDiagnosticLayout -
        snapshot_schema.CsgCompilerDiagnosticParser + 1
    if producerKindCount <= 0 ||
       tables.sources.documentCids.len >
           2147483647 / producerKindCount:
        err = " compiler snapshot builder: diagnostic completion count overflow"
        return false
    let expectedCount =
        tables.sources.documentCids.len * producerKindCount
    if tables.diagnosticCompletions.sourceIds.len !=
           expectedCount ||
       tables.diagnosticCompletions.producerKinds.len !=
           expectedCount ||
       tables.diagnosticCompletions.requiredStarts.len !=
           expectedCount ||
       tables.diagnosticCompletions.requiredCounts.len !=
           expectedCount ||
       tables.diagnosticCompletions.rowCounts.len !=
           expectedCount ||
       tables.diagnosticCompletions.proofCids.len !=
           expectedCount ||
       tables.diagnosticCompletions.requiredProducerIds.len !=
           tables.diagnosticCompletions.requiredProducerCids.len ||
       tables.diagnosticCompletions.requiredProducerIds.len !=
           tables.diagnosticCompletions.requiredResultIds.len ||
       tables.diagnosticCompletions.requiredProducerIds.len !=
           tables.diagnosticCompletions.requiredResultCids.len ||
       !layout.FixedBytes32Equal(
           tables.diagnosticCompletions.requiredDomainCid,
           versionedDomainCid) ||
       !layout.FixedBytes32Equal(
           receipt.diagnosticRequiredDomainCid,
           versionedDomainCid):
        err = " compiler snapshot builder: diagnostic completion coverage missing"
        return false
    var requiredCursor: int32
    for completionId in 0..<expectedCount:
        let sourceId =
            completionId / producerKindCount
        let producerKind =
            completionId % producerKindCount +
                snapshot_schema.CsgCompilerDiagnosticParser
        if sourceId >=
               tables.parserSidecars.producerSourceIndexes.len:
            err = " compiler snapshot builder: diagnostic completion source crosswalk missing"
            return false
        let producerSource =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        if producerSource < 0 ||
           producerSource >= csg.sourceSnapshotCount:
            err = " compiler snapshot builder: diagnostic completion producer source invalid"
            return false
        let producerCompletionId =
            producerSource * producerKindCount +
                producerKind -
                snapshot_schema.CsgCompilerDiagnosticParser
        let producerStart =
            domain.completionRequiredStarts[
                producerCompletionId]
        let producerCount =
            domain.completionRequiredCounts[
                producerCompletionId]
        if tables.diagnosticCompletions.sourceIds[
               completionId] != sourceId ||
           tables.diagnosticCompletions.producerKinds[
               completionId] != producerKind ||
           tables.diagnosticCompletions.requiredStarts[
               completionId] != requiredCursor ||
           tables.diagnosticCompletions.requiredCounts[
               completionId] != producerCount:
            err = " compiler snapshot builder: diagnostic completion CSR drift"
            return false
        for offset in 0..<producerCount:
            let requiredRow = requiredCursor + offset
            let producerRow = producerStart + offset
            let producerId =
                domain.requiredProducerIds[producerRow]
            let producerCid =
                domain.requiredProducerCids[producerRow]
            var resultId: int32
            var resultCid: layout.FixedBytes32
            if tables.diagnosticCompletions.requiredProducerIds[
                   requiredRow] != producerId ||
               !layout.FixedBytes32Equal(
                   tables.diagnosticCompletions.requiredProducerCids[
                       requiredRow],
                   producerCid) ||
               !compilerSnapshotProductionDiagnosticResultCoverageCidInto(
                   csg,
                   tables,
                   sourceId,
                   producerKind,
                   producerId,
                   producerCid,
                   versionedDomainCid,
                   resultId,
                   resultCid,
                   err) ||
               tables.diagnosticCompletions.requiredResultIds[
                   requiredRow] != resultId ||
               !layout.FixedBytes32Equal(
                   tables.diagnosticCompletions.requiredResultCids[
                       requiredRow],
                   resultCid):
                if err == "":
                    err = " compiler snapshot builder: diagnostic required row join drift"
                return false
        requiredCursor = requiredCursor + producerCount
        var proofCid: layout.FixedBytes32
        var diagnosticCount: int32
        if !snapshot_schema.CsgCompilerDiagnosticCompletionProofCidInto(
               tables,
               completionId,
               proofCid,
               diagnosticCount,
               err):
            return false
        if tables.diagnosticCompletions.rowCounts[
               completionId] != diagnosticCount ||
           !layout.FixedBytes32Equal(
               tables.diagnosticCompletions.proofCids[
                   completionId],
               proofCid):
            err = " compiler snapshot builder: diagnostic completion proof drift"
            return false
    if requiredCursor !=
           tables.diagnosticCompletions.requiredProducerIds.len:
        err = " compiler snapshot builder: diagnostic required CSR tail drift"
        return false
    var aggregateProofCid: layout.FixedBytes32
    if !compilerSnapshotProductionDiagnosticProofCidInto(
           tables,
           receipt.diagnosticRequiredDomainCid,
           aggregateProofCid,
           err):
        return false
    err = ""
    return true

fn compilerSnapshotProductionDiagnosticTableTextsAppendInto(
        table: var ccsg.CompilerCsgTypeDiagnosticCompletionTable,
        out: var str[],
        err: var str): bool =
    if table.diagnosticCodeTexts.len !=
           table.diagnosticMessageTexts.len:
        err = " compiler snapshot builder: diagnostic producer text columns split"
        return false
    for row in 0..<table.diagnosticCodeTexts.len:
        if !compilerSnapshotBuilderTextRepresentable(
               table.diagnosticCodeTexts[row]) ||
           !compilerSnapshotBuilderTextRepresentable(
               table.diagnosticMessageTexts[row]):
            err = " compiler snapshot builder: diagnostic producer text invalid"
            return false
        add(out, share(table.diagnosticCodeTexts[row]))
        add(out, share(table.diagnosticMessageTexts[row]))
    err = ""
    return true

fn compilerSnapshotProductionDiagnosticTextsAppendInto(
        csg: var ccsg.CompilerCsg,
        out: var str[],
        err: var str): bool =
    return compilerSnapshotProductionDiagnosticTableTextsAppendInto(
               csg.typeDiagnosticCompletions, out, err) &&
           compilerSnapshotProductionDiagnosticTableTextsAppendInto(
               csg.ownershipDiagnosticCompletions, out, err) &&
           compilerSnapshotProductionDiagnosticTableTextsAppendInto(
               csg.concurrencyDiagnosticCompletions, out, err) &&
           compilerSnapshotProductionDiagnosticTableTextsAppendInto(
               csg.layoutDiagnosticCompletions, out, err)

@borrows
fn compilerSnapshotProductionDiagnosticCompletionAppend(
        out: var snapshot_schema.CsgCompilerDiagnosticCompletionTable,
        sourceId: int32,
        producerKind: int32,
        rowStart: int32,
        rowCount: int32,
        producerReceiptCid: layout.FixedBytes32) =
    add(out.sourceIds, sourceId)
    add(out.producerKinds, producerKind)
    add(out.rowStarts, rowStart)
    add(out.rowCounts, rowCount)
    add(out.producerReceiptCids, producerReceiptCid)

@borrows
fn compilerSnapshotProductionDiagnosticOwnerId(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        tokenStart: int32,
        symbolByToken: int32[],
        ownerSourceLocalRow: int32): int32 =
    if ownerSourceLocalRow < 0:
        return -1
    if ownerSourceLocalRow >= sidecar.declarationNameTokenIds.len:
        return -2
    let localToken =
        sidecar.declarationNameTokenIds[ownerSourceLocalRow]
    let globalToken = tokenStart + localToken
    if localToken < 0 || globalToken < 0 ||
       globalToken >= symbolByToken.len:
        return -2
    let symbolId = symbolByToken[globalToken]
    if symbolId < 0 || symbolId >= tables.symbols.declIds.len:
        return -2
    return tables.symbols.declIds[symbolId]

@borrows
fn compilerSnapshotProductionDiagnosticRowAppendInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        sourceId: int32,
        producerKind: int32,
        completionRow: int32,
        completions: var snapshot_schema.CsgCompilerDiagnosticCompletionTable,
        nodeStart: int32,
        tokenStart: int32,
        spanMapStart: int32,
        spanGlobalByProducerLocal: int32[],
        symbolByToken: int32[],
        anchorKind: int32,
        anchorNodeId: int32,
        ownerSourceLocalRow: int32,
        localSpanId: int32,
        severity: int32,
        codeText: str,
        messageText: str,
        out: var snapshot_schema.CsgCompilerDiagnosticTable,
        err: var str): bool =
    let spanMapRow = spanMapStart + localSpanId
    let needsParser =
        anchorKind == snapshot_schema.CsgCompilerDiagnosticAnchorParserNode ||
        anchorKind ==
            snapshot_schema.CsgCompilerDiagnosticAnchorParserNodeOwnerDeclaration
    let needsOwner =
        anchorKind ==
            snapshot_schema.CsgCompilerDiagnosticAnchorOwnerDeclaration ||
        anchorKind ==
            snapshot_schema.CsgCompilerDiagnosticAnchorParserNodeOwnerDeclaration
    let parserNodeId =
        needsParser ? nodeStart + anchorNodeId : -1
    let ownerDeclarationId =
        needsOwner ?
            compilerSnapshotProductionDiagnosticOwnerId(
                tables, sidecar, tokenStart, symbolByToken,
                ownerSourceLocalRow) :
            -1
    let codeTextId =
        compilerSnapshotBuilderTextFind(tables.texts, codeText)
    let messageTextId =
        compilerSnapshotBuilderTextFind(tables.texts, messageText)
    if localSpanId < 0 || spanMapRow < 0 ||
       spanMapRow >= spanGlobalByProducerLocal.len ||
       spanGlobalByProducerLocal[spanMapRow] < 0 ||
       (needsParser &&
        (anchorNodeId < 0 ||
         parserNodeId < 0 ||
         parserNodeId >= tables.parserNodes.sourceIds.len ||
         tables.parserNodes.sourceIds[parserNodeId] != sourceId)) ||
       (needsOwner &&
        (ownerDeclarationId < 0 ||
         ownerDeclarationId >= tables.declarations.declIds.len)) ||
       codeTextId < 0 || messageTextId < 0:
        err = " compiler snapshot builder: diagnostic row remap invalid"
        return false
    let diagnosticRow = out.sourceIds.len
    add(out.sourceIds, sourceId)
    add(out.spanIds, spanGlobalByProducerLocal[spanMapRow])
    add(out.producerKinds, producerKind)
    add(out.anchorKinds, anchorKind)
    add(out.parserNodeIds, parserNodeId)
    add(out.ownerDeclarationIds, ownerDeclarationId)
    add(out.severities, severity)
    add(out.codeTextIds, codeTextId)
    add(out.messageTextIds, messageTextId)
    var proofCid: layout.FixedBytes32
    var proofTables: snapshot_schema.CsgCompilerSnapshotTables
    proofTables.texts = tables.texts
    proofTables.sources = tables.sources
    proofTables.spans = tables.spans
    proofTables.parserNodes = tables.parserNodes
    proofTables.declarations = tables.declarations
    proofTables.diagnosticCompletions =
        completions
    proofTables.diagnostics = out
    if !snapshot_schema.CsgCompilerDiagnosticRowProofCidInto(
           proofTables, completionRow, diagnosticRow,
           proofCid, err):
        return false
    add(out.proofCids, proofCid)
    err = ""
    return true

@borrows
fn compilerSnapshotProductionParserDiagnosticCompletionAppendInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        sourceId: int32,
        nodeStart: int32,
        tokenStart: int32,
        spanMapStart: int32,
        spanGlobalByProducerLocal: int32[],
        symbolByToken: int32[],
        outCompletions: var snapshot_schema.CsgCompilerDiagnosticCompletionTable,
        outDiagnostics: var snapshot_schema.CsgCompilerDiagnosticTable,
        err: var str): bool =
    let completionRow = outCompletions.sourceIds.len
    let rowStart = outDiagnostics.sourceIds.len
    let rowCount = sidecar.diagnosticAnchorKinds.len
    compilerSnapshotProductionDiagnosticCompletionAppend(
        outCompletions,
        sourceId,
        snapshot_schema.CsgCompilerDiagnosticParser,
        rowStart,
        rowCount,
        sidecar.diagnosticCompletionRaw32)
    for row in 0..<rowCount:
        if !compilerSnapshotProductionDiagnosticRowAppendInto(
               tables,
               sidecar,
               sourceId,
               snapshot_schema.CsgCompilerDiagnosticParser,
               completionRow,
               outCompletions,
               nodeStart,
               tokenStart,
               spanMapStart,
               spanGlobalByProducerLocal,
               symbolByToken,
               sidecar.diagnosticAnchorKinds[row],
               sidecar.diagnosticAnchorNodeIds[row],
               sidecar.diagnosticOwnerDeclarationSourceLocalRows[row],
               sidecar.diagnosticSpanIds[row],
               sidecar.diagnosticSeverities[row],
               sidecar.diagnosticCodeTexts[row],
               sidecar.diagnosticMessageTexts[row],
               outDiagnostics,
               err):
            return false
    return true

@borrows
fn compilerSnapshotProductionTypedDiagnosticCompletionAppendInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        sourceId: int32,
        producerSourceIndex: int32,
        producerKind: int32,
        table: ccsg.CompilerCsgTypeDiagnosticCompletionTable,
        nodeStart: int32,
        tokenStart: int32,
        spanMapStart: int32,
        spanGlobalByProducerLocal: int32[],
        symbolByToken: int32[],
        outCompletions: var snapshot_schema.CsgCompilerDiagnosticCompletionTable,
        outDiagnostics: var snapshot_schema.CsgCompilerDiagnosticTable,
        err: var str): bool =
    if producerSourceIndex < 0 ||
       producerSourceIndex >= table.sourceIds.len ||
       table.sourceIds[producerSourceIndex] != producerSourceIndex:
        err = " compiler snapshot builder: diagnostic producer completion source invalid"
        return false
    let producerRowStart = table.rowStarts[producerSourceIndex]
    let rowCount = table.rowCounts[producerSourceIndex]
    if producerRowStart < 0 || rowCount < 0 ||
       producerRowStart > table.diagnosticSourceIds.len ||
       rowCount >
           table.diagnosticSourceIds.len - producerRowStart:
        err = " compiler snapshot builder: diagnostic producer CSR invalid"
        return false
    let completionRow = outCompletions.sourceIds.len
    compilerSnapshotProductionDiagnosticCompletionAppend(
        outCompletions,
        sourceId,
        producerKind,
        outDiagnostics.sourceIds.len,
        rowCount,
        table.completionReceiptCids[producerSourceIndex])
    for offset in 0..<rowCount:
        let row = producerRowStart + offset
        if table.diagnosticSourceIds[row] != producerSourceIndex ||
           !compilerSnapshotProductionDiagnosticRowAppendInto(
               tables,
               sidecar,
               sourceId,
               producerKind,
               completionRow,
               outCompletions,
               nodeStart,
               tokenStart,
               spanMapStart,
               spanGlobalByProducerLocal,
               symbolByToken,
               table.diagnosticAnchorKinds[row],
               table.diagnosticAnchorNodeIds[row],
               table.diagnosticOwnerDeclarationSourceLocalRows[row],
               table.diagnosticSpanIds[row],
               table.diagnosticSeverities[row],
               table.diagnosticCodeTexts[row],
               table.diagnosticMessageTexts[row],
               outDiagnostics,
               err):
            if err == "":
                err = " compiler snapshot builder: diagnostic producer row source split"
            return false
    return true

@borrows
fn compilerSnapshotProductionDiagnosticExpectedInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        outCompletions: var snapshot_schema.CsgCompilerDiagnosticCompletionTable,
        outDiagnostics: var snapshot_schema.CsgCompilerDiagnosticTable,
        err: var str): bool =
    outCompletions = snapshot_schema.CsgCompilerDiagnosticCompletionTable()
    outDiagnostics = snapshot_schema.CsgCompilerDiagnosticTable()
    let sourceCount = tables.sources.documentCids.len
    if sourceCount <= 0 ||
       sourceCount != tables.sources.contentCids.len ||
       sourceCount != tables.parserSidecars.sourceIds.len ||
       sourceCount != tables.parserSidecars.producerSourceIndexes.len ||
       sourceCount != csg.sourceSnapshotCount ||
       sourceCount != sidecars.len ||
       !compilerSnapshotBuilderCidObserved(
            csg.sourceIdentityReceipt.receiptCid) ||
       !compilerSnapshotBuilderCidObserved(
            csg.parserNormalizedExprReceipt.envelope.receiptRaw32) ||
       !compilerSnapshotBuilderCidObserved(csg.canonicalGraphCid):
        err = " compiler snapshot builder: diagnostic source authority missing"
        return false
    let parserVerify =
        parser_receipt.ParserNormalizedExprReceiptVerify(
            csg.parserNormalizedExprReceipt)
    if IsErr(parserVerify):
        err = Error(parserVerify)
        return false
    if !ccsg.CompilerCsgTypeDiagnosticCompletionStrictValidateInto(
           csg, err) ||
       !ccsg.CompilerCsgOwnershipDiagnosticCompletionStrictValidateInto(
           csg, err) ||
       !ccsg.CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
           csg, err) ||
       !ccsg.CompilerCsgConcurrencyDiagnosticCompletionStrictValidateInto(
           csg, err) ||
       !compilerSnapshotBuilderPortableTypeProjectionStrictReplayInto(
            tables, sidecars, csg, err):
        if err == "":
            err = " compiler snapshot builder: diagnostic producer authority missing"
        return false
    var nodeStartBySource: int32[]
    var tokenStartBySource: int32[]
    setLen(nodeStartBySource, sourceCount)
    setLen(tokenStartBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        nodeStartBySource[sourceId] = -1
        tokenStartBySource[sourceId] = -1
    for row in 0..<tables.parserNodes.sourceIds.len:
        let sourceId = tables.parserNodes.sourceIds[row]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: diagnostic parser-node source invalid"
            return false
        if nodeStartBySource[sourceId] < 0:
            nodeStartBySource[sourceId] = row
    for row in 0..<tables.tokens.sourceIds.len:
        let sourceId = tables.tokens.sourceIds[row]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: diagnostic token source invalid"
            return false
        if tokenStartBySource[sourceId] < 0:
            tokenStartBySource[sourceId] = row
    var symbolByToken: int32[]
    setLen(symbolByToken, tables.tokens.sourceIds.len)
    for row in 0..<symbolByToken.len:
        symbolByToken[row] = -1
    for symbolId in 0..<tables.symbols.nameTokenIds.len:
        let tokenId = tables.symbols.nameTokenIds[symbolId]
        if tokenId < 0:
            if tables.symbols.symbolKinds[symbolId] ==
                   snapshot_schema.CsgCompilerSymbolModule &&
               tokenId == -1 &&
               tables.symbols.nameSpanIds[symbolId] == -1 &&
               tables.symbols.declarationSpanIds[symbolId] == -1 &&
               tables.symbols.ownerSymbolIds[symbolId] == -1:
                continue
            err = " compiler snapshot builder: diagnostic owner token map invalid"
            return false
        if tokenId >= symbolByToken.len ||
           symbolByToken[tokenId] >= 0:
            err = " compiler snapshot builder: diagnostic owner token map invalid"
            return false
        symbolByToken[tokenId] = symbolId
    var spanMapStartsByProducer: int32[]
    setLen(spanMapStartsByProducer, sidecars.len)
    var producerSpanCount: int32
    for producerSourceId in 0..<sidecars.len:
        spanMapStartsByProducer[producerSourceId] =
            producerSpanCount
        if !compilerSnapshotBuilderCountAppendSafe(
               producerSpanCount,
               sidecars[producerSourceId].spanStartBytes.len):
            err = " compiler snapshot builder: diagnostic span map overflow"
            return false
        producerSpanCount =
            producerSpanCount +
            sidecars[producerSourceId].spanStartBytes.len
    var spanGlobalByProducerLocal: int32[]
    setLen(spanGlobalByProducerLocal, producerSpanCount)
    for row in 0..<spanGlobalByProducerLocal.len:
        spanGlobalByProducerLocal[row] = -1
    var globalSpanCursor: int32
    for sourceId in 0..<sourceCount:
        let producerSourceIndex =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sidecars.len:
            err = " compiler snapshot builder: diagnostic span source remap invalid"
            return false
        let sidecar = sidecars[producerSourceIndex]
        for localSpan in 0..<sidecar.spanStartBytes.len:
            let localStart = sidecar.spanStartBytes[localSpan]
            let localEnd = sidecar.spanEndBytes[localSpan]
            while globalSpanCursor < tables.spans.sourceIds.len &&
                  (tables.spans.sourceIds[globalSpanCursor] < sourceId ||
                   (tables.spans.sourceIds[globalSpanCursor] == sourceId &&
                    (tables.spans.startBytes[globalSpanCursor] <
                         localStart ||
                     (tables.spans.startBytes[globalSpanCursor] ==
                          localStart &&
                      tables.spans.endBytes[globalSpanCursor] <
                          localEnd)))):
                globalSpanCursor = globalSpanCursor + 1
            if globalSpanCursor >= tables.spans.sourceIds.len ||
               tables.spans.sourceIds[globalSpanCursor] != sourceId ||
               tables.spans.startBytes[globalSpanCursor] != localStart ||
               tables.spans.endBytes[globalSpanCursor] != localEnd:
                err = " compiler snapshot builder: diagnostic span proof missing"
                return false
            spanGlobalByProducerLocal[
                spanMapStartsByProducer[producerSourceIndex] +
                    localSpan] = globalSpanCursor
    for sourceId in 0..<sourceCount:
        let producerSourceIndex =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        if tables.parserSidecars.sourceIds[sourceId] != sourceId ||
           producerSourceIndex < 0 ||
           producerSourceIndex >= sidecars.len:
            err = " compiler snapshot builder: parser diagnostic source remap invalid"
            return false
        let sidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producerSourceIndex]
        let projectedSidecar = sidecars[producerSourceIndex]
        if sidecar.sourceIndex != producerSourceIndex ||
           projectedSidecar.sourceIndex != producerSourceIndex ||
           !layout.FixedBytes32Equal(
               tables.sources.contentCids[sourceId],
               sidecar.sourceContentRaw32) ||
           !layout.FixedBytes32Equal(
               projectedSidecar.sidecarRaw32,
               sidecar.sidecarRaw32) ||
           !layout.FixedBytes32Equal(
               projectedSidecar.diagnosticCompletionRaw32,
               sidecar.diagnosticCompletionRaw32) ||
           !compilerSnapshotBuilderCidObserved(
               sidecar.parserInputRaw32) ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
                projectedSidecar, err) ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
                sidecar, err):
            if err == "":
                err = " compiler snapshot builder: parser diagnostic sidecar invalid"
            return false
        let typeCompletions = csg.typeDiagnosticCompletions
        let ownershipCompletions =
            csg.ownershipDiagnosticCompletions
        let concurrencyCompletions =
            csg.concurrencyDiagnosticCompletions
        let layoutCompletions =
            csg.layoutDiagnosticCompletions
        if producerSourceIndex >= typeCompletions.sourceIds.len ||
           producerSourceIndex >= ownershipCompletions.sourceIds.len ||
           producerSourceIndex >= concurrencyCompletions.sourceIds.len ||
           producerSourceIndex >= layoutCompletions.sourceIds.len ||
           typeCompletions.sourceIds[producerSourceIndex] !=
               producerSourceIndex ||
           ownershipCompletions.sourceIds[producerSourceIndex] !=
               producerSourceIndex ||
           concurrencyCompletions.sourceIds[producerSourceIndex] !=
               producerSourceIndex ||
           layoutCompletions.sourceIds[producerSourceIndex] !=
               producerSourceIndex ||
           !layout.FixedBytes32Equal(
               typeCompletions.sourceIdentityCids[producerSourceIndex],
               sidecar.sourceContentRaw32) ||
           !layout.FixedBytes32Equal(
               ownershipCompletions.sourceIdentityCids[
                   producerSourceIndex],
               sidecar.sourceContentRaw32) ||
           !layout.FixedBytes32Equal(
               concurrencyCompletions.sourceIdentityCids[
                   producerSourceIndex],
               sidecar.sourceContentRaw32) ||
           !layout.FixedBytes32Equal(
               layoutCompletions.sourceIdentityCids[
                   producerSourceIndex],
               sidecar.sourceContentRaw32) ||
           !layout.FixedBytes32Equal(
               typeCompletions.inputArtifactCids[producerSourceIndex],
               sidecar.sidecarRaw32) ||
           !compilerSnapshotBuilderCidObserved(
               typeCompletions.outputArtifactCids[
                   producerSourceIndex]) ||
           !layout.FixedBytes32Equal(
               ownershipCompletions.inputArtifactCids[
                   producerSourceIndex],
               csg.typeDiagnosticStageReceipt.artifactRaw32) ||
           !layout.FixedBytes32Equal(
               layoutCompletions.inputArtifactCids[
                   producerSourceIndex],
               csg.ownershipDiagnosticStageReceipt.artifactRaw32) ||
           !layout.FixedBytes32Equal(
               concurrencyCompletions.inputArtifactCids[
                   producerSourceIndex],
               csg.layoutDiagnosticStageReceipt.artifactRaw32):
            err = " compiler snapshot builder: diagnostic source remap invalid"
            return false
        let nodeStart = nodeStartBySource[sourceId]
        let tokenStart = tokenStartBySource[sourceId]
        let spanMapStart =
            spanMapStartsByProducer[producerSourceIndex]
        if !compilerSnapshotProductionParserDiagnosticCompletionAppendInto(
               tables,
               sidecar,
               sourceId,
               nodeStart,
               tokenStart,
               spanMapStart,
               spanGlobalByProducerLocal,
               symbolByToken,
               outCompletions,
               outDiagnostics,
               err) ||
           !compilerSnapshotProductionTypedDiagnosticCompletionAppendInto(
               tables,
               sidecar,
               sourceId,
               producerSourceIndex,
               snapshot_schema.CsgCompilerDiagnosticType,
               typeCompletions,
               nodeStart,
               tokenStart,
               spanMapStart,
               spanGlobalByProducerLocal,
               symbolByToken,
               outCompletions,
               outDiagnostics,
               err) ||
           !compilerSnapshotProductionTypedDiagnosticCompletionAppendInto(
               tables,
               sidecar,
               sourceId,
               producerSourceIndex,
               snapshot_schema.CsgCompilerDiagnosticOwnership,
               ownershipCompletions,
               nodeStart,
               tokenStart,
               spanMapStart,
               spanGlobalByProducerLocal,
               symbolByToken,
               outCompletions,
               outDiagnostics,
               err) ||
           !compilerSnapshotProductionTypedDiagnosticCompletionAppendInto(
               tables,
               sidecar,
               sourceId,
               producerSourceIndex,
               snapshot_schema.CsgCompilerDiagnosticConcurrency,
               concurrencyCompletions,
               nodeStart,
               tokenStart,
               spanMapStart,
               spanGlobalByProducerLocal,
               symbolByToken,
               outCompletions,
               outDiagnostics,
               err) ||
           !compilerSnapshotProductionTypedDiagnosticCompletionAppendInto(
               tables,
               sidecar,
               sourceId,
               producerSourceIndex,
               snapshot_schema.CsgCompilerDiagnosticLayout,
               layoutCompletions,
               nodeStart,
               tokenStart,
               spanMapStart,
               spanGlobalByProducerLocal,
               symbolByToken,
               outCompletions,
               outDiagnostics,
               err):
            return false
    err = ""
    return true

@borrows
fn CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let completionCount = tables.diagnosticCompletions.sourceIds.len
    let diagnosticCount = tables.diagnostics.sourceIds.len
    if completionCount !=
           tables.diagnosticCompletions.producerKinds.len ||
       completionCount !=
           tables.diagnosticCompletions.rowStarts.len ||
       completionCount !=
           tables.diagnosticCompletions.rowCounts.len ||
       completionCount !=
           tables.diagnosticCompletions.producerReceiptCids.len ||
       diagnosticCount != tables.diagnostics.spanIds.len ||
       diagnosticCount != tables.diagnostics.producerKinds.len ||
       diagnosticCount != tables.diagnostics.anchorKinds.len ||
       diagnosticCount != tables.diagnostics.parserNodeIds.len ||
       diagnosticCount != tables.diagnostics.ownerDeclarationIds.len ||
       diagnosticCount != tables.diagnostics.severities.len ||
       diagnosticCount != tables.diagnostics.codeTextIds.len ||
       diagnosticCount != tables.diagnostics.messageTextIds.len ||
       diagnosticCount != tables.diagnostics.proofCids.len:
        err = " compiler snapshot builder: diagnostic columns invalid"
        return false
    var expected: snapshot_schema.CsgCompilerDiagnosticCompletionTable
    var expectedDiagnostics: snapshot_schema.CsgCompilerDiagnosticTable
    if !compilerSnapshotProductionDiagnosticExpectedInto(
           tables, sidecars, csg,
           expected, expectedDiagnostics, err) ||
       completionCount != expected.sourceIds.len ||
       tables.diagnostics.sourceIds.len !=
           expectedDiagnostics.sourceIds.len:
        if err == "":
            err = " compiler snapshot builder: diagnostic completion coverage missing"
        return false
    for row in 0..<completionCount:
        if tables.diagnosticCompletions.sourceIds[row] !=
               expected.sourceIds[row] ||
           tables.diagnosticCompletions.producerKinds[row] !=
               expected.producerKinds[row] ||
           tables.diagnosticCompletions.rowStarts[row] !=
               expected.rowStarts[row] ||
           tables.diagnosticCompletions.rowCounts[row] !=
               expected.rowCounts[row] ||
           !layout.FixedBytes32Equal(
               tables.diagnosticCompletions.producerReceiptCids[row],
               expected.producerReceiptCids[row]):
            err = " compiler snapshot builder: diagnostic completion replay mismatch"
            return false
    for row in 0..<tables.diagnostics.sourceIds.len:
        if tables.diagnostics.sourceIds[row] !=
               expectedDiagnostics.sourceIds[row] ||
           tables.diagnostics.spanIds[row] !=
               expectedDiagnostics.spanIds[row] ||
           tables.diagnostics.producerKinds[row] !=
               expectedDiagnostics.producerKinds[row] ||
           tables.diagnostics.anchorKinds[row] !=
               expectedDiagnostics.anchorKinds[row] ||
           tables.diagnostics.parserNodeIds[row] !=
               expectedDiagnostics.parserNodeIds[row] ||
           tables.diagnostics.ownerDeclarationIds[row] !=
               expectedDiagnostics.ownerDeclarationIds[row] ||
           tables.diagnostics.severities[row] !=
               expectedDiagnostics.severities[row] ||
           tables.diagnostics.codeTextIds[row] !=
               expectedDiagnostics.codeTextIds[row] ||
           tables.diagnostics.messageTextIds[row] !=
               expectedDiagnostics.messageTextIds[row] ||
           !layout.FixedBytes32Equal(
               tables.diagnostics.proofCids[row],
               expectedDiagnostics.proofCids[row]):
            err = " compiler snapshot builder: diagnostic row replay mismatch"
            return false
    if !snapshot_schema.CsgCompilerDiagnosticAuthorityStrictValidateInto(
           tables, err):
        return false
    err = ""
    return true

@borrows
fn CompilerSnapshotProductionDiagnosticCompletionsProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    if compilerSnapshotBuilderCidObserved(
           tables.diagnosticCompletions.requiredDomainCid) ||
       tables.diagnosticCompletions.sourceIds.len != 0 ||
       tables.diagnosticCompletions.producerKinds.len != 0 ||
       tables.diagnosticCompletions.rowStarts.len != 0 ||
       tables.diagnosticCompletions.rowCounts.len != 0 ||
       tables.diagnosticCompletions.producerReceiptCids.len != 0 ||
       tables.diagnosticCompletions.requiredStarts.len != 0 ||
       tables.diagnosticCompletions.requiredCounts.len != 0 ||
       tables.diagnosticCompletions.proofCids.len != 0 ||
       tables.diagnosticCompletions.requiredProducerIds.len != 0 ||
       tables.diagnosticCompletions.requiredProducerCids.len != 0 ||
       tables.diagnosticCompletions.requiredResultIds.len != 0 ||
       tables.diagnosticCompletions.requiredResultCids.len != 0 ||
       tables.diagnostics.sourceIds.len != 0 ||
       tables.diagnostics.spanIds.len != 0 ||
       tables.diagnostics.producerKinds.len != 0 ||
       tables.diagnostics.anchorKinds.len != 0 ||
       tables.diagnostics.parserNodeIds.len != 0 ||
       tables.diagnostics.ownerDeclarationIds.len != 0 ||
       tables.diagnostics.severities.len != 0 ||
       tables.diagnostics.codeTextIds.len != 0 ||
       tables.diagnostics.messageTextIds.len != 0 ||
       tables.diagnostics.proofCids.len != 0:
        err = " compiler snapshot builder: diagnostic destination is not empty"
        return false
    var expected: snapshot_schema.CsgCompilerDiagnosticCompletionTable
    var expectedDiagnostics: snapshot_schema.CsgCompilerDiagnosticTable
    if !compilerSnapshotProductionDiagnosticExpectedInto(
           tables,
           csg.parserNormalizedExprReceipt.sourceSidecars,
           csg,
           expected, expectedDiagnostics, err):
        return false
    tables.diagnosticCompletions = expected
    tables.diagnostics = expectedDiagnostics
    return CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
        tables,
        csg.parserNormalizedExprReceipt.sourceSidecars,
        csg, err)

@borrows
fn compilerSnapshotProductionDiagnosticEvidenceCidInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        requiredDomainCid: layout.FixedBytes32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    if !compilerSnapshotBuilderCidObserved(requiredDomainCid) ||
       !snapshot_schema.CsgCompilerDiagnosticAuthorityStrictValidateInto(
            tables, err):
        if err == "":
            err = " compiler snapshot builder: diagnostic evidence authority invalid"
        return false
    var buf = layout.ByteBufInit(512)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_diagnostic_evidence")
    compilerSnapshotBuilderHashAppendCid(buf, requiredDomainCid)
    let completionCount = tables.diagnosticCompletions.sourceIds.len
    compilerSnapshotBuilderHashAppendU32(buf, completionCount)
    for row in 0..<completionCount:
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnosticCompletions.sourceIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnosticCompletions.producerKinds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnosticCompletions.rowStarts[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnosticCompletions.rowCounts[row])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            tables.diagnosticCompletions.producerReceiptCids[row])
    let diagnosticCount = tables.diagnostics.sourceIds.len
    compilerSnapshotBuilderHashAppendU32(buf, diagnosticCount)
    for row in 0..<diagnosticCount:
        let codeTextId = tables.diagnostics.codeTextIds[row]
        let messageTextId = tables.diagnostics.messageTextIds[row]
        if codeTextId < 0 || codeTextId >= tables.texts.len ||
           messageTextId < 0 || messageTextId >= tables.texts.len:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: diagnostic evidence text invalid"
            return false
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnostics.sourceIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnostics.spanIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnostics.producerKinds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnostics.anchorKinds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnostics.parserNodeIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnostics.ownerDeclarationIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.diagnostics.severities[row])
        compilerSnapshotBuilderHashAppendU32(buf, codeTextId)
        compilerSnapshotBuilderHashAppendText(
            buf, tables.texts[codeTextId])
        compilerSnapshotBuilderHashAppendU32(buf, messageTextId)
        compilerSnapshotBuilderHashAppendText(
            buf, tables.texts[messageTextId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.diagnostics.proofCids[row])
    out = compilerSnapshotBuilderHashFinish(buf)
    if !compilerSnapshotBuilderCidObserved(out) ||
       layout.FixedBytes32Equal(out, requiredDomainCid):
        err = " compiler snapshot builder: diagnostic evidence CID invalid"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotProductionDiagnosticAdmissionApplyInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        receipt: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    if !CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
           tables,
           csg.parserNormalizedExprReceipt.sourceSidecars,
           csg, err) ||
       !compilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
           csg, tables, receipt, err):
        return false
    let producedCompletionCount =
        tables.diagnosticCompletions.sourceIds.len
    let expectedProducedCompletionCount =
        tables.sources.documentCids.len *
            snapshot_schema.CsgCompilerDiagnosticProducerCount
    let expectedRequiredCompletionCount =
        tables.sources.documentCids.len *
            snapshot_schema.CsgCompilerDiagnosticProducerCount
    if producedCompletionCount != expectedProducedCompletionCount ||
       receipt.diagnosticCompletionRequiredCount !=
           expectedRequiredCompletionCount ||
       producedCompletionCount !=
           receipt.diagnosticCompletionRequiredCount:
        err = " compiler snapshot builder: diagnostic admission domain split"
        return false
    receipt.diagnosticProducedRowCount =
        tables.diagnostics.sourceIds.len
    receipt.missingDiagnosticCompletionCount =
        receipt.diagnosticCompletionRequiredCount -
        producedCompletionCount
    receipt.missingDiagnosticProofCount =
        receipt.missingDiagnosticCompletionCount
    if receipt.missingDiagnosticCompletionCount != 0 ||
       receipt.missingDiagnosticProofCount != 0 ||
       !compilerSnapshotBuilderCidObserved(
           receipt.diagnosticRequiredDomainCid) ||
       compilerSnapshotBuilderCidObserved(
           receipt.diagnosticProofCid):
        err = " compiler snapshot builder: diagnostic authority incomplete"
        return false
    if !compilerSnapshotProductionDiagnosticProofCidInto(
           tables,
           receipt.diagnosticRequiredDomainCid,
           receipt.diagnosticProofCid,
           err):
        return false
    receipt.missingFactBitmap =
        receipt.missingFactBitmap &
        (511 - CompilerSnapshotAdmissionMissingDiagnosticProof)
    err = ""
    return true

@borrows
fn CompilerSnapshotProductionDiagnosticAdmissionApplyInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        receipt: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    return compilerSnapshotProductionDiagnosticAdmissionApplyInto(
        tables, csg, receipt, err)

@borrows
fn compilerSnapshotProductionAdmissionBindCurrentCsgFactsInto(
        admission: var CompilerSnapshotProductionAdmissionReceipt,
        csg: ccsg.CompilerCsg) =
    admission.sourceIdentityReceiptCid =
        csg.sourceIdentityReceipt.receiptCid
    admission.parserReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    admission.compilerCsgTransitionReceiptCid =
        csg.csgTransitionReceipt.receiptCid
    admission.sourceBundleCid = csg.sourceBundleCid
    admission.importGraphCid = csg.sourceIdentityReceipt.importGraphCid
    admission.canonicalGraphCid = csg.canonicalGraphCid
    admission.graphCid = csg.graphCid
    admission.retainedFactsCid =
        compilerSnapshotBuilderRetainedFactsCid(csg)
    if csg.typeArena != nil:
        admission.typeArenaArtifactCid = csg.typeArena.artifactRaw32
        admission.typeArenaProducerSourceCount =
            csg.typeArena.producerSourceCount
        admission.typeArenaTypeCount = csg.typeArena.typeCount
        admission.typeArenaSymbolCount = csg.typeArena.symbolCount
    admission.sourceCount = csg.sourceSnapshotCount
    admission.reachableFunctionCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    admission.typedNodeCount = csg.typedIr.nodes2_nodeIndexs.len

fn compilerSnapshotProductionAdmissionBuildValidated(
        csg: var ccsg.CompilerCsg,
        semanticEpoch: int64,
        functionInterfaceRequiredDomainCid: layout.FixedBytes32,
        referenceRequiredDomainCid: layout.FixedBytes32,
        lexicalScopeRequiredDomainCid: layout.FixedBytes32,
        scopeCounts: compilerSnapshotProductionScopeDomainCounts,
        diagnosticRequiredDomainCid: layout.FixedBytes32,
        diagnosticCompletionRequiredCount: int32): CompilerSnapshotProductionAdmissionReceipt =
    var out: CompilerSnapshotProductionAdmissionReceipt
    out.schemaVersion = snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    out.semanticEpoch = semanticEpoch
    out.sourceIdentityReceiptCid = csg.sourceIdentityReceipt.receiptCid
    out.parserReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    out.compilerCsgTransitionReceiptCid =
        csg.csgTransitionReceipt.receiptCid
    out.sourceBundleCid = csg.sourceBundleCid
    out.importGraphCid = csg.sourceIdentityReceipt.importGraphCid
    out.canonicalGraphCid = csg.canonicalGraphCid
    out.graphCid = csg.graphCid
    let retainedFactsCid =
        compilerSnapshotBuilderRetainedFactsCid(csg)
    out.retainedFactsCid = retainedFactsCid
    let dependencyProofCid =
        compilerSnapshotProductionDependencyProofCid(csg)
    out.dependencyProofCid = dependencyProofCid
    out.functionInterfaceRequiredDomainCid =
        functionInterfaceRequiredDomainCid
    if csg.typeArena != nil:
        out.typeArenaArtifactCid = csg.typeArena.artifactRaw32
        out.typeArenaProducerSourceCount =
            csg.typeArena.producerSourceCount
        out.typeArenaTypeCount = csg.typeArena.typeCount
        out.typeArenaSymbolCount = csg.typeArena.symbolCount
    out.completedStageBitmap = CompilerSnapshotAdmissionStageParser |
        CompilerSnapshotAdmissionStageCompilerCsg |
        CompilerSnapshotAdmissionStageAssessment
    out.sourceCount = csg.sourceSnapshotCount
    var declarationInterfaceCount: int32
    var genericInterfaceCount: int32
    var annotationTargetBindingCount: int32
    compilerSnapshotProductionSymbolInterfaceObligations(
        csg,
        declarationInterfaceCount,
        genericInterfaceCount,
        annotationTargetBindingCount)
    out.symbolCount =
        declarationInterfaceCount + genericInterfaceCount
    out.reachableFunctionCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    out.typedNodeCount = csg.typedIr.nodes2_nodeIndexs.len
    out.referenceRequiredDomainCid = referenceRequiredDomainCid
    out.lexicalScopeRequiredDomainCid =
        lexicalScopeRequiredDomainCid
    out.diagnosticRequiredDomainCid =
        diagnosticRequiredDomainCid
    # Required coverage has two independent authenticated domains: every
    # parser normalized-expression row must bind to a TypedExpr origin, and
    # every exact TypedExpr node row (including synthetic nodes) must carry the
    # semantic proof columns.  The produced TypedExpr row count alone is never
    # the denominator.
    out.parserTypedExpressionCount =
        csg.semanticGraph.exprSummary.exprCount
    out.typedNodeRequiredCount =
        out.parserTypedExpressionCount + out.typedNodeCount
    out.resolvedCallCount =
        csg.semanticGraph.resolvedCallTable.sourceIndexes.len
    out.dependencyCount =
        csg.semanticGraph.importEdgeTable.ownerSourceIndex.len

    # These counts describe producer authorities not implemented by this
    # boundary.  TypeArena is mandatory and was validated before this helper.
    # No CID is synthesized from source text, names, lines, or fixture values.
    out.missingSourceInterfaceCount = out.sourceCount
    out.missingSymbolDeclarationInterfaceCount =
        declarationInterfaceCount
    out.missingSymbolGenericInterfaceCount =
        genericInterfaceCount
    out.missingSymbolAnnotationTargetBindingCount =
        annotationTargetBindingCount
    out.missingSymbolInterfaceCount =
        declarationInterfaceCount +
        genericInterfaceCount +
        annotationTargetBindingCount
    out.missingFunctionInterfaceCount = out.reachableFunctionCount
    # FunctionId/source, parameter/return TypeId, immutable ownership and
    # function-owned generic rows are all bound by the authenticated required
    # domain.  Canonical DeclId/SymbolCid ownership is still absent, so the
    # Function interface itself remains RED.
    out.missingFunctionOwnerIdentityCount =
        out.reachableFunctionCount
    out.missingFunctionParameterTypeCount = 0
    out.missingFunctionParameterOwnershipCount = 0
    out.missingFunctionReturnTypeCount = 0
    out.missingFunctionGenericIdentityCount = 0
    out.missingFunctionSourceBindingCount = 0
    out.missingParserTypedExpressionIdentityCount = 0
    out.missingTypedNodeDeclarationIdentityCount =
        out.typedNodeCount
    # Value-definition TypeIds are proven at this boundary: the typed-node
    # required-domain validator has replayed the exact value-definition
    # authority against TypeArena, so those rows are not missing facts.
    out.missingTypedNodeTypeIdCount =
        out.typedNodeCount -
            texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr)
    out.missingTypedNodeValueDefinitionCount =
        out.typedNodeCount
    out.missingTypedNodeOwnershipProofCount =
        out.typedNodeCount
    out.missingTypedNodeCaptureProofCount =
        out.typedNodeCount
    # TypedExpr function ranges and CompilerCSG typedIrTable retain the exact
    # producer source row. Source text is not used as a production identity.
    out.missingTypedNodeSourceBindingCount = 0
    out.missingTypedNodeProofCount = out.typedNodeCount
    # CompilerCSG retains the exact source-local parser call node, owning
    # FunctionId and caller/target graph node for every resolved call.
    # Reference required-domain validation joins every row to one TypedExpr
    # CallExpr/value-def and its exact callDeclaration producer coordinate.
    # The candidate seals that coordinate into canonical
    # DeclId/DeclKeyCid/SymbolCid rows without text-based reselection.
    out.missingReferenceParserNodeIdentityCount = 0
    out.missingReferenceOwnerFunctionIdentityCount = 0
    out.missingReferenceSpanCount = 0
    out.missingReferenceTargetDeclarationIdentityCount = 0
    out.missingReferenceTargetSymbolCidCount = 0
    out.missingReferenceResultTypeIdCount = 0
    out.missingReferenceResultOwnershipProofCount = 0
    # The retained CSG closes the producer denominator only. A nonempty
    # resolved-call domain stays RED until the canonical Reference/Call rows
    # are bijectively joined back to their target Decl/Symbol and call-result
    # TypedNode/Type/ownership proof.
    out.missingReferenceProofCount = out.resolvedCallCount
    if out.missingReferenceProofCount == 0:
        out.referenceProofCid =
            out.referenceRequiredDomainCid
    out.parserLexicalScopeCount = scopeCounts.parserScopeCount
    out.typedLexicalScopeCount = scopeCounts.typedScopeCount
    out.statementLexicalScopeUseCount =
        scopeCounts.statementScopeUseCount
    out.lexicalScopeRequiredCount =
        out.parserLexicalScopeCount +
        out.typedLexicalScopeCount
    out.missingParserLexicalScopeIdentityCount = 0
    out.missingTypedLexicalScopeIdentityCount = 0
    out.missingStatementLexicalScopeUseCount = 0
    # Parser declaration scopes and TypedExpr function-local suite scopes are
    # both exact, but no immutable cross-domain row currently joins them.
    # Canonical DeclId, byte-span and visible SymbolCid authorities are
    # likewise upstream gaps. FunctionId and its graph node are already exact.
    out.missingLexicalScopeBridgeCount =
        out.typedLexicalScopeCount
    out.missingLexicalScopeOwnerDeclarationIdentityCount =
        scopeCounts.parserOwnedScopeCount
    out.missingLexicalScopeOwnerFunctionIdentityCount = 0
    out.missingLexicalScopeSpanCount =
        out.lexicalScopeRequiredCount
    out.missingLexicalScopeVisibleSymbolProofCount =
        out.lexicalScopeRequiredCount
    out.missingLexicalScopeProofCount =
        out.lexicalScopeRequiredCount
    if out.missingLexicalScopeProofCount == 0:
        out.lexicalScopeProofCid =
            out.lexicalScopeRequiredDomainCid
    # compilerSnapshotBuilderGraphStrictValidateInto has already replayed the
    # source-index bounds, resolved flag, source ownership ranges and the
    # source/import graph identities.  This proof is therefore complete even
    # for the canonical empty dependency domain.
    out.missingDependencyProofCount = 0
    # Admission authenticates only the source-local producer denominator.
    # Candidate projection must still bijectively join every required row and
    # emit an authenticated zero/nonzero completion before this bit can clear.
    out.diagnosticProducerKindCount =
        snapshot_schema.CsgCompilerDiagnosticLayout -
        snapshot_schema.CsgCompilerDiagnosticParser + 1
    out.diagnosticCompletionRequiredCount =
        diagnosticCompletionRequiredCount
    out.diagnosticProducedRowCount = 0
    out.missingDiagnosticCompletionCount =
        out.diagnosticCompletionRequiredCount
    out.missingDiagnosticSourceIdentityCount = 0
    out.missingDiagnosticProducerKindCount = 0
    out.missingDiagnosticSpanIdentityCount = 0
    out.missingDiagnosticParserNodeIdentityCount = 0
    out.missingDiagnosticOwnerDeclarationIdentityCount = 0
    out.missingDiagnosticProofCount =
        out.missingDiagnosticCompletionCount
    if out.missingSourceInterfaceCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingSourceInterface
    if out.missingTypeArenaSourceBindingCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingTypeArenaBinding
    if out.missingSymbolInterfaceCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingSymbolInterface
    if out.missingFunctionInterfaceCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingFunctionInterface
    if out.missingTypedNodeProofCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingTypedNodeProof
    if out.missingReferenceProofCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingReferenceProof
    if out.missingLexicalScopeProofCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingLexicalScope
    if out.missingDependencyProofCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingDependencyProof
    if out.missingDiagnosticProofCount > 0:
        out.missingFactBitmap = out.missingFactBitmap |
            CompilerSnapshotAdmissionMissingDiagnosticProof
    out.admissionBlocked = out.missingFactBitmap != 0
    let receiptCid =
        compilerSnapshotProductionAdmissionReceiptCid(out)
    out.receiptCid = receiptCid
    return out

# Production admission consumes and strictly validates CompilerCSG's retained
# TypeArena.  Missing or incomplete nominal authority aborts CompilerCSG before
# this boundary and is never represented as an admissible degraded candidate.
fn CompilerSnapshotProductionAdmissionAssessInto(
        csg: var ccsg.CompilerCsg,
        semanticEpoch: int64,
        out: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    out = CompilerSnapshotProductionAdmissionReceipt()
    var functionParameterCount: int32
    var functionGenericCount: int32
    var functionInterfaceRequiredDomainCid: layout.FixedBytes32
    var referenceRequiredDomainCid: layout.FixedBytes32
    var lexicalScopeRequiredDomainCid: layout.FixedBytes32
    var scopeCounts: compilerSnapshotProductionScopeDomainCounts
    var diagnosticRequiredDomainCid: layout.FixedBytes32
    var diagnosticCompletionRequiredCount: int32
    if semanticEpoch <= 0:
        err = " compiler snapshot builder: invalid semantic epoch"
        return false
    if !compilerSnapshotBuilderGraphStrictValidateInto(csg, err) ||
       !ccsg.CompilerCsgOwnTransitionReceiptStrictValidateInto(
            csg, err) ||
       !compilerSnapshotProductionFunctionInspectionStrictValidateInto(
            csg, functionParameterCount, functionGenericCount, err) ||
       !compilerSnapshotProductionFunctionRequiredDomainCidInto(
            csg,
            functionParameterCount,
            functionGenericCount,
            functionInterfaceRequiredDomainCid,
            err) ||
       !compilerSnapshotProductionTypedNodeRequiredDomainStrictValidateInto(
            csg, err) ||
       !compilerSnapshotProductionReferenceRequiredDomainStrictValidateInto(
            csg, referenceRequiredDomainCid, err) ||
       !compilerSnapshotProductionLexicalScopeRequiredDomainStrictValidateInto(
            csg, lexicalScopeRequiredDomainCid, scopeCounts, err) ||
       !compilerSnapshotProductionDiagnosticRequiredDomainStrictValidateInto(
            csg, diagnosticRequiredDomainCid,
            diagnosticCompletionRequiredCount, err):
        return false
    functionInterfaceRequiredDomainCid =
        compilerSnapshotProductionVersionedRequiredDomainCid(
            functionInterfaceRequiredDomainCid, semanticEpoch)
    referenceRequiredDomainCid =
        compilerSnapshotProductionVersionedRequiredDomainCid(
            referenceRequiredDomainCid, semanticEpoch)
    lexicalScopeRequiredDomainCid =
        compilerSnapshotProductionVersionedRequiredDomainCid(
            lexicalScopeRequiredDomainCid, semanticEpoch)
    diagnosticRequiredDomainCid =
        compilerSnapshotProductionVersionedRequiredDomainCid(
            diagnosticRequiredDomainCid, semanticEpoch)
    let receipt = compilerSnapshotProductionAdmissionBuildValidated(
        csg,
        semanticEpoch,
        functionInterfaceRequiredDomainCid,
        referenceRequiredDomainCid,
        lexicalScopeRequiredDomainCid,
        scopeCounts,
        diagnosticRequiredDomainCid,
        diagnosticCompletionRequiredCount)
    if receipt.missingTypeArenaSourceBindingCount != 0 ||
       receipt.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       receipt.semanticEpoch != semanticEpoch ||
       receipt.missingTypeArenaResolutionAuthorityCount != 0 ||
       !compilerSnapshotBuilderCidObserved(receipt.dependencyProofCid) ||
       !compilerSnapshotBuilderCidObserved(
            receipt.functionInterfaceRequiredDomainCid) ||
       (receipt.missingSymbolInterfaceCount > 0 &&
        compilerSnapshotBuilderCidObserved(
            receipt.symbolInterfaceProofCid)) ||
       (receipt.missingFunctionInterfaceCount > 0 &&
        compilerSnapshotBuilderCidObserved(
            receipt.functionInterfaceProofCid)) ||
       (receipt.missingTypedNodeProofCount > 0 &&
        compilerSnapshotBuilderCidObserved(
            receipt.typedNodeProofCid)) ||
       !compilerSnapshotBuilderCidObserved(
            receipt.referenceRequiredDomainCid) ||
       (receipt.missingReferenceProofCount > 0 &&
        compilerSnapshotBuilderCidObserved(
            receipt.referenceProofCid)) ||
       (receipt.missingReferenceProofCount == 0 &&
        (!compilerSnapshotBuilderCidObserved(
             receipt.referenceProofCid) ||
         !layout.FixedBytes32Equal(
             receipt.referenceProofCid,
             receipt.referenceRequiredDomainCid))) ||
       !compilerSnapshotBuilderCidObserved(
            receipt.lexicalScopeRequiredDomainCid) ||
       (receipt.missingLexicalScopeProofCount > 0 &&
        compilerSnapshotBuilderCidObserved(
            receipt.lexicalScopeProofCid)) ||
       (receipt.missingLexicalScopeProofCount == 0 &&
        (!compilerSnapshotBuilderCidObserved(
             receipt.lexicalScopeProofCid) ||
         !layout.FixedBytes32Equal(
             receipt.lexicalScopeProofCid,
             receipt.lexicalScopeRequiredDomainCid))) ||
       !compilerSnapshotBuilderCidObserved(
            receipt.diagnosticRequiredDomainCid) ||
       (receipt.missingDiagnosticProofCount > 0 &&
        compilerSnapshotBuilderCidObserved(
            receipt.diagnosticProofCid)) ||
       (receipt.missingDiagnosticProofCount == 0 &&
        !compilerSnapshotBuilderCidObserved(
             receipt.diagnosticProofCid)) ||
       receipt.admissionBlocked !=
           (receipt.missingFactBitmap != 0) ||
       !compilerSnapshotBuilderCidObserved(receipt.receiptCid):
        err = " compiler snapshot builder: admission state drift"
        return false
    out = receipt
    err = ""
    return true

fn compilerSnapshotProductionCanonicalSourceRowsBuildInto(
        csg: var ccsg.CompilerCsg,
        canonicalDocumentCids: var layout.FixedBytes32[],
        canonicalSourceByProducer: var int32[],
        out: var CompilerSnapshotCanonicalSourceRow[],
        err: var str): bool =
    out = []
    let sourceCount = csg.sourceSnapshotCount
    if sourceCount <= 0 ||
       sourceCount != canonicalDocumentCids.len ||
       sourceCount != canonicalSourceByProducer.len ||
       sourceCount !=
           csg.parserNormalizedExprReceipt.sourceSidecars.len ||
       sourceCount != csg.semanticGraph.sourceTable.modulePaths.len:
        err = " compiler snapshot builder: production source skeleton shape mismatch"
        return false
    var producerByCanonical: int32[]
    setLen(producerByCanonical, sourceCount)
    for sourceId in 0..<sourceCount:
        producerByCanonical[sourceId] = -1
        if !compilerSnapshotBuilderCidObserved(
               canonicalDocumentCids[sourceId]) ||
           (sourceId > 0 &&
            !compilerSnapshotBuilderCidLess(
                canonicalDocumentCids[sourceId - 1],
                canonicalDocumentCids[sourceId])):
            err = " compiler snapshot builder: production document order invalid"
            return false
    for producerIndex in 0..<sourceCount:
        let sourceId = canonicalSourceByProducer[producerIndex]
        if sourceId < 0 || sourceId >= sourceCount ||
           producerByCanonical[sourceId] >= 0:
            err = " compiler snapshot builder: production source mapping is not bijective"
            return false
        producerByCanonical[sourceId] = producerIndex
    for sourceId in 0..<sourceCount:
        let producerIndex = producerByCanonical[sourceId]
        if producerIndex < 0:
            err = " compiler snapshot builder: production source mapping is incomplete"
            return false
        let modulePath =
            csg.semanticGraph.sourceTable.modulePaths[producerIndex]
        var expectedDocumentCid: layout.FixedBytes32
        if !compiler_world.CompilerWorldDocumentCidInto(
                csg.packageId, modulePath, expectedDocumentCid, err):
            return false
        if !layout.FixedBytes32Equal(
                expectedDocumentCid,
                canonicalDocumentCids[sourceId]):
            err = " compiler snapshot builder: production document identity split"
            return false
        var row: CompilerSnapshotCanonicalSourceRow
        row.documentCid = expectedDocumentCid
        row.producerSourceIndex = producerIndex
        row.modulePath = modulePath
        row.contentCid =
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producerIndex].sourceContentRaw32
        add(out, row)
    err = ""
    return true

@borrows
fn compilerSnapshotProductionSourceInterfaceProofCid(
        csg: ccsg.CompilerCsg,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        dependencyProofCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(384)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_source_interface_proof")
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.receiptCid)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, dependencyProofCid)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.sources.documentCids.len)
    for sourceId in 0..<tables.sources.documentCids.len:
        compilerSnapshotBuilderHashAppendU32(buf, sourceId)
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.sources.documentCids[sourceId])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.sources.interfaceCids[sourceId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.dependencies.sourceIds.len)
    for row in 0..<tables.dependencies.sourceIds.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.sourceIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.targetSourceIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.spanIds[row])
        compilerSnapshotBuilderHashAppendU32(
            buf, tables.dependencies.dependencyKinds[row])
        compilerSnapshotBuilderHashAppendCid(
            buf, tables.dependencies.observedInterfaceCids[row])
    return compilerSnapshotBuilderHashFinish(buf)

# This is the only production source-interface builder. Source interfaces must
# still be unsealed zero values; canonical Symbol and Function interfaces and
# exact dependency rows must already exist. It returns a fully replayed scalar
# commit payload and never mutates the candidate descriptor.
@borrows
fn CompilerSnapshotProductionSourceInterfacesBuildInto(
        csg: var ccsg.CompilerCsg,
        canonicalDocumentCids: var layout.FixedBytes32[],
        canonicalSourceByProducer: var int32[],
        dependencyProofCid: layout.FixedBytes32,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        nextSourceInterfaceCids: var layout.FixedBytes32[],
        nextObservedInterfaceCids: var layout.FixedBytes32[],
        outProofCid: var layout.FixedBytes32,
        err: var str): bool =
    outProofCid = layout.FixedBytes32()
    nextSourceInterfaceCids = []
    nextObservedInterfaceCids = []
    var sourceRows: CompilerSnapshotCanonicalSourceRow[]
    let expectedDependencyProofCid =
        compilerSnapshotProductionDependencyProofCid(csg)
    if !compilerSnapshotBuilderGraphStrictValidateInto(csg, err) ||
       !compilerSnapshotBuilderCidObserved(dependencyProofCid) ||
       !layout.FixedBytes32Equal(
            dependencyProofCid, expectedDependencyProofCid) ||
       !compilerSnapshotProductionCanonicalSourceRowsBuildInto(
            csg, canonicalDocumentCids, canonicalSourceByProducer,
            sourceRows, err):
        if err == "":
            err = " compiler snapshot builder: source-interface dependency proof missing"
        return false
    let sourceCount = sourceRows.len
    let symbolCount = tables.symbols.symbolCids.len
    let functionCount = tables.functions.symbolIds.len
    let externFunctionCount = tables.externFunctions.symbolIds.len
    let dependencyCount = tables.dependencies.sourceIds.len
    if tables.sources.documentCids.len != sourceCount ||
       tables.sources.interfaceCids.len != sourceCount ||
       tables.parserSidecars.producerSourceIndexes.len != sourceCount ||
       tables.symbols.interfaceCids.len != symbolCount ||
       tables.symbols.sourceIds.len != symbolCount ||
       tables.symbols.symbolKinds.len != symbolCount ||
       tables.symbols.exportedFlags.len != symbolCount ||
       tables.functions.interfaceCids.len != functionCount ||
       dependencyCount != tables.dependencies.targetSourceIds.len ||
       dependencyCount != tables.dependencies.spanIds.len ||
       dependencyCount != tables.dependencies.dependencyKinds.len ||
       dependencyCount !=
           tables.dependencies.observedInterfaceCids.len ||
       dependencyCount !=
           csg.semanticGraph.importEdgeTable.ownerSourceIndex.len:
        err = " compiler snapshot builder: source-interface producer shape invalid"
        return false
    for sourceId in 0..<sourceCount:
        if !layout.FixedBytes32Equal(
                tables.sources.documentCids[sourceId],
                canonicalDocumentCids[sourceId]) ||
           tables.parserSidecars.producerSourceIndexes[sourceId] !=
               sourceRows[sourceId].producerSourceIndex ||
           !layout.FixedBytes32Equal(
                tables.sources.interfaceCids[sourceId],
                layout.FixedBytes32()):
            err = " compiler snapshot builder: source-interface skeleton was prefilled"
            return false
    for symbolId in 0..<symbolCount:
        var expectedSymbolCid: layout.FixedBytes32
        var expectedInterfaceCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerSymbolRowCidInto(
                tables, symbolId, expectedSymbolCid, err) ||
           !snapshot_schema.CsgCompilerSymbolInterfaceCidInto(
                tables, symbolId, expectedInterfaceCid, err) ||
           !layout.FixedBytes32Equal(
                expectedSymbolCid,
                tables.symbols.symbolCids[symbolId]) ||
           !layout.FixedBytes32Equal(
                expectedInterfaceCid,
                tables.symbols.interfaceCids[symbolId]):
            if err == "":
                err = " compiler snapshot builder: canonical Symbol interface missing"
            return false
    for functionId in 0..<functionCount:
        let symbolId = tables.functions.symbolIds[functionId]
        if symbolId < 0 || symbolId >= symbolCount ||
           !layout.FixedBytes32Equal(
                tables.functions.interfaceCids[functionId],
                tables.symbols.interfaceCids[symbolId]):
            err = " compiler snapshot builder: canonical Function interface missing"
            return false
    for dependencyId in 0..<dependencyCount:
        let sourceId = tables.dependencies.sourceIds[dependencyId]
        let targetSourceId =
            tables.dependencies.targetSourceIds[dependencyId]
        let spanId = tables.dependencies.spanIds[dependencyId]
        if sourceId < 0 || sourceId >= sourceCount ||
           targetSourceId < 0 || targetSourceId >= sourceCount ||
           spanId < 0 || spanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[spanId] != sourceId ||
           tables.dependencies.dependencyKinds[dependencyId] !=
               snapshot_schema.CsgCompilerReferenceImport ||
           !layout.FixedBytes32Equal(
                tables.dependencies.observedInterfaceCids[dependencyId],
                layout.FixedBytes32()):
            err = " compiler snapshot builder: source-interface dependency row invalid"
            return false
        var matchCount: int32
        for producerRow in 0..<
                csg.semanticGraph.importEdgeTable.ownerSourceIndex.len:
            let ownerProducer =
                csg.semanticGraph.importEdgeTable.ownerSourceIndex[producerRow]
            let targetProducer =
                csg.semanticGraph.importEdgeTable.targetSourceIndex[producerRow]
            if ownerProducer >= 0 &&
               ownerProducer < canonicalSourceByProducer.len &&
               targetProducer >= 0 &&
               targetProducer < canonicalSourceByProducer.len &&
               csg.semanticGraph.importEdgeTable.resolved[producerRow] &&
               canonicalSourceByProducer[ownerProducer] == sourceId &&
               canonicalSourceByProducer[targetProducer] == targetSourceId:
                matchCount = matchCount + 1
        if matchCount != 1:
            err = " compiler snapshot builder: source-interface dependency authority split"
            return false
    if !snapshot_schema.CsgCompilerSourceInterfacesBuildInto(
           tables,
           nextSourceInterfaceCids,
           nextObservedInterfaceCids,
           err):
        return false
    var sealed = snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    for sourceId in 0..<sourceCount:
        sealed.sources.interfaceCids[sourceId] =
            nextSourceInterfaceCids[sourceId]
    for dependencyId in 0..<dependencyCount:
        sealed.dependencies.observedInterfaceCids[dependencyId] =
            nextObservedInterfaceCids[dependencyId]
    var replay: layout.FixedBytes32[]
    if !snapshot_schema.CsgCompilerSourceInterfaceCidsInto(
            sealed, replay, err) ||
       replay.len != sourceCount:
        return false
    for sourceId in 0..<sourceCount:
        if !layout.FixedBytes32Equal(
                replay[sourceId],
                nextSourceInterfaceCids[sourceId]):
            err = " compiler snapshot builder: source-interface replay mismatch"
            return false
    outProofCid = compilerSnapshotProductionSourceInterfaceProofCid(
        csg,
        sealed,
        dependencyProofCid)
    if !compilerSnapshotBuilderCidObserved(outProofCid):
        err = " compiler snapshot builder: source-interface proof missing"
        return false
    err = ""
    return true

fn compilerSnapshotProductionUnsealedExternSymbolsAppendInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        functionCount: int32,
        err: var str): bool =
    let declarationCount = csg.semanticGraph.declTable.names.len
    if declarationCount !=
           csg.semanticGraph.declTable.sourceIndex.len ||
       declarationCount !=
           csg.semanticGraph.declTable.importc.len ||
       declarationCount !=
           csg.semanticGraph.declTable.exported.len:
        err = " compiler snapshot builder: extern declaration producer columns mismatch"
        return false
    for producerDeclarationRow in 0..<declarationCount:
        if !csg.semanticGraph.declTable.importc[
               producerDeclarationRow]:
            continue
        let producerSource =
            csg.semanticGraph.declTable.sourceIndex[
                producerDeclarationRow]
        let sourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, producerSource)
        if producerSource < 0 ||
           producerSource >=
               csg.semanticGraph.sourceTable.declStart.len ||
           sourceId < 0 ||
           producerDeclarationRow <
               csg.semanticGraph.sourceTable.declStart[
                   producerSource]:
            err = " compiler snapshot builder: extern producer source invalid"
            return false
        let declarationOrdinal =
            producerDeclarationRow -
                csg.semanticGraph.sourceTable.declStart[
                    producerSource]
        # The aggregated declarationFunctionRows column is base-shifted into
        # the global function-row domain, while declarationOrdinal is the
        # producer's per-source semantic ordinal. Join in the per-source
        # sidecar domain first (same invariant the resolved-call bridge
        # proves), then remap to the aggregated row by exact
        # (producer source, source-local row) identity.
        if producerSource >=
               csg.parserNormalizedExprReceipt.sourceSidecars.len:
            err = " compiler snapshot builder: extern producer sidecar missing"
            return false
        let producerSidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[producerSource]
        var localParserDeclarationRow: int32 = -1
        for localCandidate in 0..<producerSidecar.declarationKinds.len:
            if producerSidecar.declarationKinds[localCandidate] ==
                   Int32(parser.ParserDeclarationFunction) &&
               localCandidate <
                   producerSidecar.declarationFunctionRows.len &&
               producerSidecar.declarationFunctionRows[
                   localCandidate] == declarationOrdinal:
                if localParserDeclarationRow >= 0:
                    err = " compiler snapshot builder: extern parser declaration ambiguous"
                    return false
                localParserDeclarationRow = localCandidate
        if localParserDeclarationRow < 0:
            err = " compiler snapshot builder: extern parser declaration missing"
            return false
        var parserDeclarationRow: int32 = -1
        for candidate in 0..<
                tables.parserSidecars.declarationKinds.len:
            if tables.parserSidecars.declarationProducerSourceIds[
                   candidate] == sourceId &&
               tables.parserSidecars.declarationSourceLocalRows[
                   candidate] == localParserDeclarationRow:
                if parserDeclarationRow >= 0:
                    err = " compiler snapshot builder: extern parser declaration ambiguous"
                    return false
                parserDeclarationRow = candidate
        if parserDeclarationRow < 0:
            err = " compiler snapshot builder: extern parser declaration missing"
            return false
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                parserDeclarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                parserDeclarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                parserDeclarationRow]
        if nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len:
            err = " compiler snapshot builder: extern parser name token missing"
            return false
        if nameSpanId < 0 ||
           nameSpanId >= tables.spans.startBytes.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.startBytes.len:
            err = " compiler snapshot builder: extern parser span coordinate missing"
            return false
        if tables.tokens.valueTextIds[nameTokenId] < 0 ||
           tables.tokens.valueTextIds[nameTokenId] >= tables.texts.len:
            err = " compiler snapshot builder: extern parser name text missing"
            return false
        if tables.texts[tables.tokens.valueTextIds[nameTokenId]] !=
               csg.semanticGraph.declTable.names[
                   producerDeclarationRow]:
            err = " compiler snapshot builder: extern parser/CSG name drift"
            return false
        if tables.parserSidecars.declarationExportedFlags[
               parserDeclarationRow] !=
               csg.semanticGraph.declTable.exported[
                   producerDeclarationRow]:
            err = Fmt" compiler snapshot builder: extern parser/CSG export drift producer_declaration={producerDeclarationRow} parser_declaration={parserDeclarationRow} producer_source={producerSource} source={sourceId} declaration_ordinal={declarationOrdinal} parser_exported={tables.parserSidecars.declarationExportedFlags[parserDeclarationRow]} csg_exported={csg.semanticGraph.declTable.exported[producerDeclarationRow]}"
            return false
        let nameTextId = tables.tokens.valueTextIds[nameTokenId]
        let qualifiedName = strutil.Join([
            share(tables.texts[
                tables.sources.modulePathTextIds[sourceId]]),
            "::",
            share(tables.texts[nameTextId])
        ], "")
        let qualifiedNameTextId =
            compilerSnapshotBuilderTextFind(
                tables.texts, qualifiedName)
        if qualifiedNameTextId < 0:
            err = " compiler snapshot builder: extern qualified name missing"
            return false
        var importAnnotationRow: int32 = -1
        let declarationStart =
            tables.spans.startBytes[declarationSpanId]
        for annotationRow in 0..<
                tables.parserSidecars.annotationNameTokenIds.len:
            let annotationNameToken =
                tables.parserSidecars.annotationNameTokenIds[
                    annotationRow]
            let targetToken =
                tables.parserSidecars.annotationTargetTokenIds[
                    annotationRow]
            if tables.parserSidecars.annotationProducerSourceIds[
                   annotationRow] != sourceId ||
               annotationNameToken < 0 ||
               annotationNameToken >= tables.tokens.valueTextIds.len ||
               tables.texts[
                   tables.tokens.valueTextIds[annotationNameToken]] !=
                   "importc" ||
               targetToken < 0 ||
               targetToken >= tables.tokens.spanIds.len:
                continue
            let targetSpan = tables.tokens.spanIds[targetToken]
            if targetSpan < 0 ||
               targetSpan >= tables.spans.startBytes.len ||
               tables.spans.startBytes[targetSpan] !=
                   declarationStart:
                continue
            if importAnnotationRow >= 0:
                err = " compiler snapshot builder: duplicate extern import annotation"
                return false
            importAnnotationRow = annotationRow
        var externalNameTextId = nameTextId
        if importAnnotationRow >= 0:
            let rootStart =
                tables.parserSidecars.annotationArgRootStarts[
                    importAnnotationRow]
            let rootCount =
                tables.parserSidecars.annotationArgRootCounts[
                    importAnnotationRow]
            if rootCount != 1 ||
               rootStart < 0 ||
               rootStart >=
                   tables.parserSidecars.annotationArgRootIds.len:
                err = " compiler snapshot builder: extern annotation argument root invalid"
                return false
            let rootArg =
                tables.parserSidecars.annotationArgRootIds[rootStart]
            if rootArg < 0 ||
               rootArg >=
                   tables.parserSidecars.annotationArgKinds.len ||
               tables.parserSidecars.annotationArgKinds[rootArg] !=
                   Int32(parser.ParserAnnotationArgString):
                err = " compiler snapshot builder: extern annotation ABI name is not String"
                return false
            let argToken =
                tables.parserSidecars.annotationArgTokenIds[rootArg]
            if argToken < 0 ||
               argToken >= tables.tokens.valueTextIds.len:
                err = " compiler snapshot builder: extern annotation ABI token missing"
                return false
            externalNameTextId = tables.tokens.valueTextIds[argToken]
        var nameProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, parserDeclarationRow, nameProofCid, err):
            return false
        let externFunctionId = tables.externFunctions.symbolIds.len
        let symbolId = tables.symbols.symbolCids.len
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids, share(nameProofCid))
        add(tables.symbols.declarationPathCids, nameProofCid)
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds,
            qualifiedNameTextId)
        add(tables.symbols.symbolKinds,
            snapshot_schema.CsgCompilerSymbolFunction)
        add(tables.symbols.typeIds, -1)
        add(tables.symbols.declarationSpanIds,
            declarationSpanId)
        add(tables.symbols.ownerSymbolIds, -1)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, externFunctionId)
        add(tables.symbols.exportedFlags,
            csg.semanticGraph.declTable.exported[
                producerDeclarationRow])
        add(tables.symbols.genericConstraintStarts,
            tables.symbols.genericConstraintTypeIds.len)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
        add(tables.externFunctions.symbolIds, symbolId)
        add(tables.externFunctions.parserDeclarationRows,
            parserDeclarationRow)
        add(tables.externFunctions.typeIds, -1)
        add(tables.externFunctions.externalNameTextIds,
            externalNameTextId)
        add(tables.externFunctions.abiKinds,
            snapshot_schema.CsgCompilerExternAbiC)
        add(tables.externFunctions.importAnnotationRows,
            importAnnotationRow)
        add(tables.externFunctions.interfaceCids,
            layout.FixedBytes32())
    err = ""
    return true

fn compilerSnapshotProductionUnsealedModuleSymbolsAppendInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        functionCount: int32,
        externFunctionCount: int32,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    for sourceId in 0..<sourceCount:
        var moduleDeclaration: int32 = -1
        for declarationRow in 0..<declarationCount:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationModule) ||
               tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] != sourceId:
                continue
            if moduleDeclaration >= 0:
                err = " compiler snapshot builder: duplicate production Module declaration"
                return false
            moduleDeclaration = declarationRow
        let modulePathTextId =
            tables.sources.modulePathTextIds[sourceId]
        var nameTextId = modulePathTextId
        var nameSpanId: int32 = -1
        var nameTokenId: int32 = -1
        var declarationSpanId: int32 = -1
        var exported = false
        if moduleDeclaration >= 0:
            nameTokenId =
                tables.parserSidecars.declarationNameTokenIds[
                    moduleDeclaration]
            nameSpanId =
                tables.parserSidecars.declarationNameSpanIds[
                    moduleDeclaration]
            declarationSpanId =
                tables.parserSidecars.declarationSpanIds[
                    moduleDeclaration]
            if nameTokenId < 0 ||
               nameTokenId >= tables.tokens.valueTextIds.len:
                err = " compiler snapshot builder: production Module token missing"
                return false
            nameTextId = tables.tokens.valueTextIds[nameTokenId]
            exported =
                tables.parserSidecars.declarationExportedFlags[
                    moduleDeclaration]
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            layout.FixedBytes32())
        add(tables.symbols.declarationPathCids,
            layout.FixedBytes32())
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, modulePathTextId)
        add(tables.symbols.symbolKinds,
            snapshot_schema.CsgCompilerSymbolModule)
        add(tables.symbols.typeIds, -1)
        add(tables.symbols.declarationSpanIds, declarationSpanId)
        add(tables.symbols.ownerSymbolIds, -1)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, -1)
        add(tables.symbols.exportedFlags, exported)
        add(tables.symbols.genericConstraintStarts, 0)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
    let callableCount = functionCount + externFunctionCount
    for callableSymbolId in 0..<callableCount:
        let sourceId = tables.symbols.sourceIds[callableSymbolId]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: production Function source invalid"
            return false
        tables.symbols.ownerSymbolIds[callableSymbolId] =
            callableCount + sourceId
    err = ""
    return true

fn compilerSnapshotProductionUnsealedGraphBaseBuildInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        canonicalSourceTexts: var str[],
        err: var str): bool =
    let functionCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    if canonicalSourceTexts.len != tables.sources.documentCids.len ||
       functionCount !=
           csg.semanticGraph.typedIrTable.functionSourceIndexes.len ||
       functionCount != tables.parserSidecars.functionIndexes.len:
        err = " compiler snapshot builder: production graph base domain split"
        return false
    for sourceId in 0..<canonicalSourceTexts.len:
        if !layout.FixedBytes32Equal(
               snapshot_schema.CsgCompilerSourceContentCid(
                   canonicalSourceTexts[sourceId]),
               tables.sources.contentCids[sourceId]):
            err = " compiler snapshot builder: production source bytes drift"
            return false
    var generatedTexts: str[]
    for nodeIndex in 0..<csg.nodes.len:
        if csg.nodes[nodeIndex].nodeKind ==
               ccsg.CompilerCsgNodeKindSymbol:
            add(generatedTexts,
                share(csg.nodes[nodeIndex].symbolText))
    for declarationRow in 0..<csg.semanticGraph.declTable.names.len:
        if !csg.semanticGraph.declTable.importc[declarationRow]:
            continue
        let producerSource =
            csg.semanticGraph.declTable.sourceIndex[declarationRow]
        if producerSource < 0 ||
           producerSource >=
               csg.semanticGraph.sourceTable.modulePaths.len ||
           csg.semanticGraph.declTable.names[declarationRow] == "":
            err = " compiler snapshot builder: extern declaration text identity invalid"
            return false
        add(generatedTexts, strutil.Join([
            share(csg.semanticGraph.sourceTable.modulePaths[
                producerSource]),
            "::",
            share(csg.semanticGraph.declTable.names[declarationRow])
        ], ""))
    if !compilerSnapshotBuilderGeneratedTextsMergeInto(
           tables, generatedTexts, err):
        return false
    var typedRowByReachable: int32[]
    if !compilerSnapshotBuilderTypedFunctionJoinInto(
           csg, typedRowByReachable, err):
        return false
    var nodeIndexById: int32[]
    setLen(nodeIndexById, csg.nodes.len + 1)
    for nodeId in 0..<nodeIndexById.len:
        nodeIndexById[nodeId] = -1
    for nodeIndex in 0..<csg.nodes.len:
        let nodeId = csg.nodes[nodeIndex].nodeId
        if nodeId <= 0 || nodeId >= nodeIndexById.len ||
           nodeIndexById[nodeId] >= 0:
            err = " compiler snapshot builder: production graph node identity invalid"
            return false
        nodeIndexById[nodeId] = nodeIndex
    var parserRowByReachable: int32[]
    setLen(parserRowByReachable, functionCount)
    for reachableRow in 0..<functionCount:
        parserRowByReachable[reachableRow] = -1
    for parserRow in 0..<tables.parserSidecars.functionIndexes.len:
        let reachableRow =
            tables.parserSidecars.functionIndexes[parserRow]
        if reachableRow < 0 || reachableRow >= functionCount ||
           parserRowByReachable[reachableRow] >= 0:
            err = " compiler snapshot builder: production parser Function identity split"
            return false
        parserRowByReachable[reachableRow] = parserRow
    var tokenBySpan: int32[]
    setLen(tokenBySpan, tables.spans.sourceIds.len)
    for spanId in 0..<tokenBySpan.len:
        tokenBySpan[spanId] = -1
    for tokenId in 0..<tables.tokens.spanIds.len:
        let spanId = tables.tokens.spanIds[tokenId]
        if spanId < 0 || spanId >= tokenBySpan.len ||
           tokenBySpan[spanId] >= 0:
            err = " compiler snapshot builder: production token/span identity split"
            return false
        tokenBySpan[spanId] = tokenId
    for functionId in 0..<functionCount:
        let graphNodeId =
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[
                functionId]
        let nodeIndex =
            graphNodeId <= 0 ||
            graphNodeId >= nodeIndexById.len ?
                -1 : nodeIndexById[graphNodeId]
        let typedRow = typedRowByReachable[functionId]
        let parserRow = parserRowByReachable[functionId]
        let producerSourceIndex =
            csg.semanticGraph.reachableFunctionTable.sourceIndex[
                functionId]
        let sourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, producerSourceIndex)
        if nodeIndex < 0 || typedRow < 0 || parserRow < 0 ||
           sourceId < 0 ||
           csg.nodes[nodeIndex].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol ||
           csg.semanticGraph.typedIrTable.functionGraphNodeIds[
               typedRow] != graphNodeId ||
           csg.semanticGraph.typedIrTable.functionSourceIndexes[
               typedRow] != producerSourceIndex:
            err = " compiler snapshot builder: production Function graph join missing"
            return false
        let node = csg.nodes[nodeIndex]
        let nameTextId =
            compilerSnapshotBuilderTextFind(
                tables.texts, node.factText)
        let qualifiedTextId =
            compilerSnapshotBuilderTextFind(
                tables.texts, node.symbolText)
        let declarationSpanId =
            tables.parserSidecars.functionDeclarationSpanIds[parserRow]
        let bodySpanId =
            tables.parserSidecars.functionBodySpanIds[parserRow]
        let nameSpanId =
            tables.parserSidecars.functionNameSpanIds[parserRow]
        var nameTokenId: int32
        if !compilerSnapshotBuilderFunctionNameOwnerTokenResolveInto(
               tables.spans.startBytes,
               tables.spans.endBytes,
               tables.spans.sourceIds,
               tables.tokens.sourceIds,
               tables.tokens.spanIds,
               tables.tokens.kinds,
               tokenBySpan,
               nameSpanId,
               nameTokenId,
               err):
            return false
        # Backtick surfaces have no single name-bearing token (the opener
        # contributes a literal backtick), so the name text binds through the
        # parse-time surface proof cid over (surfaceKind, name) instead of a
        # single-token value comparison.
        if nameTextId < 0 || qualifiedTextId < 0 ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           bodySpanId < 0 || bodySpanId >= tables.spans.sourceIds.len ||
           nameTokenId < 0 ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           tables.spans.sourceIds[bodySpanId] != sourceId ||
           tables.tokens.sourceIds[nameTokenId] != sourceId ||
           !layout.FixedBytes32Equal(
               tables.parserSidecars.functionNameProofCids[parserRow],
               parser_receipt.parserFunctionNameProofCid(
                   tables.parserSidecars.functionNameSurfaceKinds[
                       parserRow],
                   node.factText)) ||
           tables.texts[
               tables.parserSidecars.functionNameTextIds[parserRow]] !=
                   node.factText ||
           node.semanticSource !=
               csg.semanticGraph.sourceTable.modulePaths[
                   producerSourceIndex]:
            err = " compiler snapshot builder: production Function parser join drift"
            return false
        var bodyContentCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerFunctionBodyContentCidInto(
               tables.sources.documentCids[sourceId],
               canonicalSourceTexts[sourceId],
               tables.spans.startBytes[bodySpanId],
               tables.spans.endBytes[bodySpanId],
               bodyContentCid, err):
            return false
        var fragmentCid: layout.FixedBytes32
        if !compilerSnapshotBuilderFunctionFragmentCidInto(
               csg, typedRow, fragmentCid, err):
            return false
        let resultOwnershipKind =
            compilerSnapshotBuilderOwnershipKind(
                csg.typedIr.functions2_resultExprClasses[typedRow])
        if resultOwnershipKind != snapshot_schema.CsgCompilerOwnershipOwned &&
           resultOwnershipKind != snapshot_schema.CsgCompilerOwnershipBorrowed:
            err = " compiler snapshot builder: Function result ownership producer invalid"
            return false
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            tables.parserSidecars.functionDeclarationHeaderCids[
                parserRow])
        add(tables.symbols.declarationPathCids,
            tables.parserSidecars.functionDeclarationPathCids[
                parserRow])
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, qualifiedTextId)
        add(tables.symbols.symbolKinds,
            snapshot_schema.CsgCompilerSymbolFunction)
        add(tables.symbols.typeIds, -1)
        add(tables.symbols.declarationSpanIds, declarationSpanId)
        add(tables.symbols.ownerSymbolIds, -1)
        add(tables.symbols.functionIds, functionId)
        add(tables.symbols.externFunctionIds, -1)
        var parserDeclarationRow: int32 = -1
        for declarationRow in 0..<
                tables.parserSidecars.declarationKinds.len:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction) ||
               tables.parserSidecars.declarationFunctionRows[
                   declarationRow] != parserRow:
                continue
            if parserDeclarationRow >= 0:
                err = " compiler snapshot builder: function parser declaration ambiguous"
                return false
            parserDeclarationRow = declarationRow
        if parserDeclarationRow < 0:
            err = " compiler snapshot builder: function parser declaration missing"
            return false
        add(tables.symbols.exportedFlags,
            tables.parserSidecars.declarationExportedFlags[
                parserDeclarationRow])
        add(tables.symbols.genericConstraintStarts, 0)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
        add(tables.functions.typedFunctionIndexes, typedRow)
        add(tables.functions.symbolIds, functionId)
        add(tables.functions.bodySpanIds, bodySpanId)
        add(tables.functions.bodyContentCids, bodyContentCid)
        add(tables.functions.fragmentCids, fragmentCid)
        add(tables.functions.interfaceCids, layout.FixedBytes32())
        add(tables.functions.annotationFlags,
            tables.parserSidecars.functionAnnotationFlags[
                parserRow])
        add(tables.functions.manualConsumeTargetParameterSymbolIds, -1)
        add(tables.functions.manualConsumeSourceParameterSymbolIds, -1)
        add(tables.functions.manualConsumeEffectCids,
            layout.FixedBytes32())
        add(tables.functions.resultOwnershipKinds,
            resultOwnershipKind)
        add(tables.functions.parameterOwnershipStarts, 0)
        add(tables.functions.parameterOwnershipCounts, 0)
        add(tables.functions.valueDefinitionStarts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionStarts,
                typedRow))
        add(tables.functions.valueDefinitionCounts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionCounts,
                typedRow))
        add(tables.functions.valueDefinitionGroupStarts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionGroupStarts,
                typedRow))
        add(tables.functions.valueDefinitionGroupCounts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionGroupCounts,
                typedRow))
        add(tables.functions.readStarts, 0)
        add(tables.functions.readCounts, 0)
        add(tables.functions.readSetPreimageCids,
            layout.FixedBytes32())
        add(tables.functions.nodeStarts, 0)
        add(tables.functions.nodeCounts, 0)
    if !compilerSnapshotProductionUnsealedExternSymbolsAppendInto(
           tables, csg, functionCount, err):
        return false
    # Module rows are committed in this owner frame. A last nested composite
    # `var` producer would write back the pre-module Symbol sequence headers
    # when it returns, dropping the final canonical rows.
    let sourceCount = tables.sources.documentCids.len
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    for sourceId in 0..<sourceCount:
        var moduleDeclaration: int32 = -1
        for declarationRow in 0..<declarationCount:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationModule) ||
               tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] != sourceId:
                continue
            if moduleDeclaration >= 0:
                err = " compiler snapshot builder: duplicate production Module declaration"
                return false
            moduleDeclaration = declarationRow
        let modulePathTextId =
            tables.sources.modulePathTextIds[sourceId]
        var nameTextId = modulePathTextId
        var nameSpanId: int32 = -1
        var nameTokenId: int32 = -1
        var declarationSpanId: int32 = -1
        var exported = false
        if moduleDeclaration >= 0:
            nameTokenId =
                tables.parserSidecars.declarationNameTokenIds[
                    moduleDeclaration]
            nameSpanId =
                tables.parserSidecars.declarationNameSpanIds[
                    moduleDeclaration]
            declarationSpanId =
                tables.parserSidecars.declarationSpanIds[
                    moduleDeclaration]
            if nameTokenId < 0 ||
               nameTokenId >= tables.tokens.valueTextIds.len:
                err = " compiler snapshot builder: production Module token missing"
                return false
            nameTextId = tables.tokens.valueTextIds[nameTokenId]
            exported =
                tables.parserSidecars.declarationExportedFlags[
                    moduleDeclaration]
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            layout.FixedBytes32())
        add(tables.symbols.declarationPathCids,
            layout.FixedBytes32())
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, modulePathTextId)
        add(tables.symbols.symbolKinds,
            snapshot_schema.CsgCompilerSymbolModule)
        add(tables.symbols.typeIds, -1)
        add(tables.symbols.declarationSpanIds, declarationSpanId)
        add(tables.symbols.ownerSymbolIds, -1)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, -1)
        add(tables.symbols.exportedFlags, exported)
        add(tables.symbols.genericConstraintStarts, 0)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
    let callableCount =
        functionCount + tables.externFunctions.symbolIds.len
    for callableSymbolId in 0..<callableCount:
        let sourceId = tables.symbols.sourceIds[callableSymbolId]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: production Function source invalid"
            return false
        tables.symbols.ownerSymbolIds[callableSymbolId] =
            callableCount + sourceId
    return compilerSnapshotProductionUnsealedBaseStrictValidateInto(
        tables, csg, err)

fn compilerSnapshotProductionDependenciesProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        err: var str): bool =
    if tables.dependencies.sourceIds.len != 0 ||
       tables.dependencies.targetSourceIds.len != 0 ||
       tables.dependencies.spanIds.len != 0 ||
       tables.dependencies.dependencyKinds.len != 0 ||
       tables.dependencies.observedInterfaceCids.len != 0:
        err = " compiler snapshot builder: production dependency destination is not empty"
        return false
    let edgeCount =
        csg.semanticGraph.importEdgeTable.ownerSourceIndex.len
    for edgeRow in 0..<edgeCount:
        let ownerProducer =
            csg.semanticGraph.importEdgeTable.ownerSourceIndex[edgeRow]
        let targetProducer =
            csg.semanticGraph.importEdgeTable.targetSourceIndex[edgeRow]
        let sourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, ownerProducer)
        let targetSourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, targetProducer)
        if !csg.semanticGraph.importEdgeTable.resolved[edgeRow] ||
           sourceId < 0 || targetSourceId < 0:
            err = " compiler snapshot builder: production dependency identity unresolved"
            return false
        if ownerProducer < 0 ||
           ownerProducer >=
               csg.parserNormalizedExprReceipt.sourceSidecars.len:
            err = " compiler snapshot builder: production dependency parser source missing"
            return false
        let sidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[
                ownerProducer]
        if sidecar.importOrigins == nil:
            err = " compiler snapshot builder: production dependency parser origin missing"
            return false
        let importOrigins = sidecar.importOrigins
        var importItemRow: int32 = -1
        for candidateItemRow in 0..<
                importOrigins.importItemSpanIds.len:
            if parser_receipt.ParserCanonicalSourceSidecarImportTargetPathEquals(
                   sidecar,
                   candidateItemRow,
                   csg.semanticGraph.importEdgeTable.targetModulePaths[
                       edgeRow]):
                if importItemRow >= 0:
                    err = " compiler snapshot builder: production dependency parser origin ambiguous"
                    return false
                importItemRow = candidateItemRow
        if importItemRow < 0:
            err = " compiler snapshot builder: production dependency parser origin unresolved"
            return false
        let localSpanId =
            importOrigins.importItemSpanIds[importItemRow]
        if localSpanId < 0 ||
           localSpanId >= sidecar.spanStartBytes.len ||
           localSpanId >= sidecar.spanEndBytes.len:
            err = " compiler snapshot builder: production dependency parser span invalid"
            return false
        let spanId = compilerSnapshotBuilderSpanFind(
            tables.spans,
            sourceId,
            sidecar.spanStartBytes[localSpanId],
            sidecar.spanEndBytes[localSpanId])
        if spanId < 0:
            err = " compiler snapshot builder: production dependency canonical span missing"
            return false
        var insertRow = tables.dependencies.sourceIds.len
        while insertRow > 0:
            let previous = insertRow - 1
            let previousSource =
                tables.dependencies.sourceIds[previous]
            let previousTarget =
                tables.dependencies.targetSourceIds[previous]
            if previousSource < sourceId ||
               (previousSource == sourceId &&
                previousTarget < targetSourceId):
                break
            if previousSource == sourceId &&
               previousTarget == targetSourceId:
                err = " compiler snapshot builder: duplicate production dependency"
                return false
            insertRow = previous
        add(tables.dependencies.sourceIds, 0)
        add(tables.dependencies.targetSourceIds, 0)
        add(tables.dependencies.spanIds, 0)
        add(tables.dependencies.dependencyKinds, 0)
        add(tables.dependencies.observedInterfaceCids,
            layout.FixedBytes32())
        var cursor = tables.dependencies.sourceIds.len - 1
        while cursor > insertRow:
            tables.dependencies.sourceIds[cursor] =
                tables.dependencies.sourceIds[cursor - 1]
            tables.dependencies.targetSourceIds[cursor] =
                tables.dependencies.targetSourceIds[cursor - 1]
            tables.dependencies.spanIds[cursor] =
                tables.dependencies.spanIds[cursor - 1]
            tables.dependencies.dependencyKinds[cursor] =
                tables.dependencies.dependencyKinds[cursor - 1]
            tables.dependencies.observedInterfaceCids[cursor] =
                tables.dependencies.observedInterfaceCids[cursor - 1]
            cursor = cursor - 1
        tables.dependencies.sourceIds[insertRow] = sourceId
        tables.dependencies.targetSourceIds[insertRow] =
            targetSourceId
        tables.dependencies.spanIds[insertRow] = spanId
        tables.dependencies.dependencyKinds[insertRow] =
            snapshot_schema.CsgCompilerReferenceImport
    err = ""
    return true

@borrows
fn compilerSnapshotProductionActiveSourceMapInto(
        eventState: var snapshot_core.WorkspaceSourceEventState,
        canonicalDocumentCids: layout.FixedBytes32[],
        activeStableRowsOut: var int32[],
        canonicalSourceIdsByActiveOut: var int32[],
        err: var str): bool =
    activeStableRowsOut = []
    canonicalSourceIdsByActiveOut = []
    var activeStableRows: int32[]
    if !snapshot_core.WorkspaceSourceEventActiveSourceRowsInto(
            eventState, activeStableRows, err):
        return false
    if activeStableRows.len != canonicalDocumentCids.len:
        err = " compiler snapshot builder: active source membership count split"
        return false
    var canonicalSeen: bool[]
    setLen(canonicalSeen, canonicalDocumentCids.len)
    for activeSourceId in 0..<activeStableRows.len:
        let stableRow = activeStableRows[activeSourceId]
        if stableRow < 0 || stableRow >= eventState.documentCids.len:
            err = " compiler snapshot builder: active stable row invalid"
            return false
        let canonicalSourceId =
            compilerSnapshotBuilderCidFind(
                canonicalDocumentCids,
                eventState.documentCids[stableRow])
        if canonicalSourceId < 0 ||
           canonicalSeen[canonicalSourceId]:
            err = " compiler snapshot builder: active source identity split"
            return false
        canonicalSeen[canonicalSourceId] = true
        add(activeStableRowsOut, stableRow)
        add(canonicalSourceIdsByActiveOut, canonicalSourceId)
    for canonicalSourceId in 0..<canonicalSeen.len:
        if !canonicalSeen[canonicalSourceId]:
            err = " compiler snapshot builder: active source coverage missing"
            return false
    err = ""
    return true

fn compilerSnapshotProductionInitialFactsBuildInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        canonicalSourceTexts: var str[],
        eventState: var snapshot_core.WorkspaceSourceEventState,
        worldHeadCid: layout.FixedBytes32,
        compilerExecutionCid: layout.FixedBytes32,
        out: var incremental.SemanticSnapshotIncrementalPrebuildFacts,
        err: var str): bool =
    out = incremental.SemanticSnapshotIncrementalPrebuildFacts()
    let sourceCount = tables.sources.documentCids.len
    if sourceCount != canonicalSourceTexts.len ||
       eventState.lastAcceptedSourceVersion <= 0 ||
       eventState.nextSourceVersion !=
           eventState.lastAcceptedSourceVersion + int64(1) ||
       !compilerSnapshotBuilderCidObserved(
           eventState.workspaceSessionCid) ||
       !compilerSnapshotBuilderCidObserved(worldHeadCid) ||
       !compilerSnapshotBuilderCidObserved(compilerExecutionCid):
        err = " compiler snapshot builder: production current event authority invalid"
        return false
    var activeStableRows: int32[]
    var canonicalByActive: int32[]
    if !compilerSnapshotProductionActiveSourceMapInto(
            eventState,
            tables.sources.documentCids,
            activeStableRows,
            canonicalByActive,
            err):
        return false
    var input: incremental.SemanticSnapshotIncrementalPrebuildInput
    input.worldHeadCid = worldHeadCid
    input.compilerCid = compilerExecutionCid
    input.sourceBundleCid = csg.sourceBundleCid
    input.frontEndReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    for activeSourceId in 0..<activeStableRows.len:
        let canonicalSourceId = canonicalByActive[activeSourceId]
        add(input.documentCids,
            layout.FixedBytes32Copy(
                tables.sources.documentCids[canonicalSourceId]))
        add(input.sourceProducerIndexes,
            tables.parserSidecars.producerSourceIndexes[
                canonicalSourceId])
        # W2 源文本 share 化：input 仅在本函数内借给 PrebuildFactsMakeInto
        # 读取后即亡，facts 经 share 持 RC 持有同一缓冲，此处 CloneStr 深拷贝
        # 是纯冗余第三份（wall101）。字节面零变化：CID 哈希输入不变。
        add(input.sourceTexts,
            share(canonicalSourceTexts[canonicalSourceId]))
        add(input.sourceInterfaceCids,
            layout.FixedBytes32Copy(
                tables.sources.interfaceCids[canonicalSourceId]))
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction:
            continue
        let functionId = tables.symbols.functionIds[symbolId]
        let externFunctionId =
            tables.symbols.externFunctionIds[symbolId]
        if functionId < 0:
            if externFunctionId < 0 ||
               externFunctionId >=
                   tables.externFunctions.symbolIds.len ||
               tables.externFunctions.symbolIds[externFunctionId] !=
                   symbolId:
                err = " compiler snapshot builder: production extern Function/Symbol identity split"
                return false
            continue
        if externFunctionId != -1:
            err = " compiler snapshot builder: production FunctionId/ExternFunctionId XOR split"
            return false
        let canonicalSourceId = tables.symbols.sourceIds[symbolId]
        var activeSourceId: int32 = -1
        for candidateActiveId in 0..<canonicalByActive.len:
            if canonicalByActive[candidateActiveId] ==
                   canonicalSourceId:
                activeSourceId = candidateActiveId
        if functionId < 0 ||
           functionId >= tables.functions.symbolIds.len ||
           tables.functions.symbolIds[functionId] != symbolId ||
           activeSourceId < 0:
            err = " compiler snapshot builder: production Function/Symbol identity split"
            return false
        let currentSymbolId = input.symbolCids.len
        add(input.symbolCids,
            layout.FixedBytes32Copy(
                tables.symbols.symbolCids[symbolId]))
        add(input.symbolInterfaceCids,
            layout.FixedBytes32Copy(
                tables.symbols.interfaceCids[symbolId]))
        add(input.functionSymbolIds, currentSymbolId)
        add(input.functionSourceIds, activeSourceId)
        let bodySpanId =
            tables.functions.bodySpanIds[functionId]
        if bodySpanId < 0 ||
           bodySpanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[bodySpanId] !=
               canonicalSourceId:
            err = " compiler snapshot builder: production Function body identity missing"
            return false
        add(input.bodyStartBytes,
            tables.spans.startBytes[bodySpanId])
        add(input.bodyEndBytes,
            tables.spans.endBytes[bodySpanId])
        add(input.functionInterfaceCids,
            layout.FixedBytes32Copy(
                tables.functions.interfaceCids[functionId]))
    if !incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
           eventState, input, out, err):
        return false
    err = ""
    return true

fn compilerSnapshotProductionInitialReadsAttachInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        current: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalized:
            incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        err: var str): bool =
    let functionCount = tables.functions.symbolIds.len
    if !finalized.initialBuild ||
       functionCount != current.functionSymbolIds.len ||
       functionCount != finalized.readStarts.len ||
       functionCount != finalized.readCounts.len ||
       functionCount != finalized.readSetPreimageCids.len:
        err = " compiler snapshot builder: production initial read authority shape invalid"
        return false
    var currentFunctionByActual: int32[]
    setLen(currentFunctionByActual, functionCount)
    for functionId in 0..<functionCount:
        currentFunctionByActual[functionId] = -1
    for currentFunctionId in 0..<current.functionSymbolIds.len:
        let currentSymbolId =
            current.functionSymbolIds[currentFunctionId]
        if currentSymbolId < 0 ||
           currentSymbolId >= current.symbolCids.len:
            err = " compiler snapshot builder: production initial Function symbol invalid"
            return false
        let actualSymbolId =
            compilerSnapshotBuilderCidFind(
                tables.symbols.symbolCids,
                current.symbolCids[currentSymbolId])
        let actualFunctionId =
            actualSymbolId < 0 ? -1 :
                tables.symbols.functionIds[actualSymbolId]
        if actualFunctionId < 0 ||
           actualFunctionId >= functionCount ||
           currentFunctionByActual[actualFunctionId] >= 0:
            err = " compiler snapshot builder: production initial Function remap invalid"
            return false
        currentFunctionByActual[actualFunctionId] =
            currentFunctionId
    tables.readSet = snapshot_schema.CsgCompilerReadSetTable()
    for actualFunctionId in 0..<functionCount:
        let currentFunctionId =
            currentFunctionByActual[actualFunctionId]
        if currentFunctionId < 0:
            err = " compiler snapshot builder: production initial Function remap incomplete"
            return false
        tables.functions.readStarts[actualFunctionId] =
            tables.readSet.readerFunctionIds.len
        let start = finalized.readStarts[currentFunctionId]
        let count = finalized.readCounts[currentFunctionId]
        if start < 0 || count < 0 ||
           start > finalized.readSet.readerFunctionIds.len ||
           count >
               finalized.readSet.readerFunctionIds.len - start:
            err = " compiler snapshot builder: production initial read range invalid"
            return false
        for offset in 0..<count:
            let row = start + offset
            add(tables.readSet.readerFunctionIds,
                actualFunctionId)
            add(tables.readSet.targetDomainKinds,
                finalized.readSet.targetDomainKinds[row])
            add(tables.readSet.targetPortableKeyCids,
                finalized.readSet.targetPortableKeyCids[row])
            add(tables.readSet.observedValueCids,
                finalized.readSet.observedValueCids[row])
        tables.functions.readCounts[actualFunctionId] = count
        var preimage: layout.FixedBytes32
        let symbolId =
            tables.functions.symbolIds[actualFunctionId]
        if !snapshot_schema.CsgCompilerReadSetPreimageCidInto(
               tables.symbols.symbolCids[symbolId],
               tables.readSet.targetDomainKinds,
               tables.readSet.targetPortableKeyCids,
               tables.readSet.observedValueCids,
               tables.functions.readStarts[actualFunctionId],
               count,
               preimage,
               err):
            return false
        tables.functions.readSetPreimageCids[
            actualFunctionId] = preimage
    if !snapshot_schema.CsgCompilerReadSetReverseBuildInto(tables, err) ||
       !snapshot_schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
           tables, err):
        return false
    err = ""
    return true

# Unique production candidate builder. It returns one intentionally unsealed
# caller-owned descriptor: source and observed-interface CID columns are all
# zero and the admission receipt carries the exact source-interface missing
# fact. The caller must seal this same candidate before strict admission and
# publication; no alternate schema or compatibility builder exists.
fn CompilerSnapshotProductionCandidateBuildUnsealedInto(
        csg: var ccsg.CompilerCsg,
        canonicalDocumentCids: var layout.FixedBytes32[],
        canonicalSourceByProducer: var int32[],
        canonicalSourceTexts: var str[],
        eventState: var snapshot_core.WorkspaceSourceEventState,
        worldHeadCid: layout.FixedBytes32,
        compilerExecutionCid: layout.FixedBytes32,
        predecessorReceiptCid: layout.FixedBytes32,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        admission: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    let emptyTables = snapshot_schema.CsgCompilerSnapshotTables()
    tables = emptyTables
    let emptyAdmission = CompilerSnapshotProductionAdmissionReceipt()
    admission = emptyAdmission
    if eventState.lastAcceptedSourceVersion <= 0 ||
       !compilerSnapshotBuilderCidObserved(
           eventState.workspaceSessionCid) ||
       !compilerSnapshotBuilderCidObserved(worldHeadCid) ||
       !compilerSnapshotBuilderCidObserved(compilerExecutionCid):
        err = " compiler snapshot builder: production event/world authority missing"
        return false
    var activeStableRows: int32[]
    var canonicalSourceIdsByActive: int32[]
    if !compilerSnapshotProductionActiveSourceMapInto(
            eventState,
            canonicalDocumentCids,
            activeStableRows,
            canonicalSourceIdsByActive,
            err):
        return false
    if !CompilerSnapshotProductionAdmissionAssessInto(
            csg, eventState.lastAcceptedSourceVersion,
            admission, err):
        return false
    var sourceRows: CompilerSnapshotCanonicalSourceRow[]
    if !compilerSnapshotProductionCanonicalSourceRowsBuildInto(
            csg, canonicalDocumentCids, canonicalSourceByProducer,
            sourceRows, err):
        return false
    var completeTexts: str[]
    var completeSpans: CompilerSnapshotCanonicalSpanInput[]
    if !compilerSnapshotProductionDiagnosticTextsAppendInto(
           csg, completeTexts, err) ||
       !CompilerSnapshotParserTablesBuildInto(
            csg.parserNormalizedExprReceipt.sourceSidecars,
            sourceRows,
            completeTexts,
            completeSpans,
            predecessorReceiptCid,
            tables,
            err):
        return false
    tables.schemaVersion =
        snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    tables.semanticEpoch =
        eventState.lastAcceptedSourceVersion
    for sourceId in 0..<tables.sources.interfaceCids.len:
        if !layout.FixedBytes32Equal(
                tables.sources.interfaceCids[sourceId],
                layout.FixedBytes32()):
            err = " compiler snapshot builder: parser skeleton source interface is sealed"
            return false
    if !compilerSnapshotProductionUnsealedGraphBaseBuildInto(
           tables, csg, canonicalSourceTexts, err):
        return false
    # The candidate owner commits Module rows after the graph-base producer
    # returns. Current composite `var` lowering can preserve the callable rows
    # while restoring the pre-module Symbol sequence headers at that boundary.
    # Both accepted construction states are exact cardinalities; any partial
    # module domain hard-fails.
    let callableSymbolCount =
        tables.functions.symbolIds.len +
        tables.externFunctions.symbolIds.len
    let canonicalModuleCount =
        tables.sources.documentCids.len
    if tables.symbols.symbolCids.len == callableSymbolCount:
        let declarationCount =
            tables.parserSidecars.declarationKinds.len
        for sourceId in 0..<canonicalModuleCount:
            var moduleDeclaration: int32 = -1
            for declarationRow in 0..<declarationCount:
                if tables.parserSidecars.declarationKinds[
                       declarationRow] !=
                       Int32(parser.ParserDeclarationModule) ||
                   tables.parserSidecars.declarationProducerSourceIds[
                       declarationRow] != sourceId:
                    continue
                if moduleDeclaration >= 0:
                    err = " compiler snapshot builder: duplicate production Module declaration"
                    return false
                moduleDeclaration = declarationRow
            let modulePathTextId =
                tables.sources.modulePathTextIds[sourceId]
            var nameTextId = modulePathTextId
            var nameSpanId: int32 = -1
            var nameTokenId: int32 = -1
            var declarationSpanId: int32 = -1
            var exported = false
            if moduleDeclaration >= 0:
                nameTokenId =
                    tables.parserSidecars.declarationNameTokenIds[
                        moduleDeclaration]
                nameSpanId =
                    tables.parserSidecars.declarationNameSpanIds[
                        moduleDeclaration]
                declarationSpanId =
                    tables.parserSidecars.declarationSpanIds[
                        moduleDeclaration]
                if nameTokenId < 0 ||
                   nameTokenId >= tables.tokens.valueTextIds.len:
                    err = " compiler snapshot builder: production Module token missing"
                    return false
                nameTextId = tables.tokens.valueTextIds[nameTokenId]
                exported =
                    tables.parserSidecars.declarationExportedFlags[
                        moduleDeclaration]
            let emptySymbolCid = layout.FixedBytes32()
            add(tables.symbols.symbolCids, emptySymbolCid)
            let emptyInterfaceCid = layout.FixedBytes32()
            add(tables.symbols.interfaceCids, emptyInterfaceCid)
            add(tables.symbols.declIds, -1)
            let emptyDeclKeyCid = layout.FixedBytes32()
            add(tables.symbols.declKeyCids, emptyDeclKeyCid)
            let emptyDeclarationHeaderCid = layout.FixedBytes32()
            add(tables.symbols.declarationHeaderCids,
                emptyDeclarationHeaderCid)
            let emptyDeclarationPathCid = layout.FixedBytes32()
            add(tables.symbols.declarationPathCids,
                emptyDeclarationPathCid)
            add(tables.symbols.sourceIds, sourceId)
            add(tables.symbols.nameTextIds, nameTextId)
            add(tables.symbols.nameSpanIds, nameSpanId)
            add(tables.symbols.nameTokenIds, nameTokenId)
            add(tables.symbols.qualifiedNameTextIds,
                modulePathTextId)
            add(tables.symbols.symbolKinds,
                snapshot_schema.CsgCompilerSymbolModule)
            add(tables.symbols.typeIds, -1)
            add(tables.symbols.declarationSpanIds,
                declarationSpanId)
            add(tables.symbols.ownerSymbolIds, -1)
            add(tables.symbols.functionIds, -1)
            add(tables.symbols.externFunctionIds, -1)
            add(tables.symbols.exportedFlags, exported)
            add(tables.symbols.genericConstraintStarts, 0)
            add(tables.symbols.genericConstraintCounts, 0)
            add(tables.symbols.genericParameterParserRows, -1)
            add(tables.symbols.genericParameterOrdinals, -1)
            add(tables.symbols.genericParameterDefaultTypeIds, -1)
    elif tables.symbols.symbolCids.len !=
           callableSymbolCount + canonicalModuleCount:
        err = " compiler snapshot builder: partial production Module domain"
        return false
    for callableSymbolId in 0..<callableSymbolCount:
        let sourceId =
            tables.symbols.sourceIds[callableSymbolId]
        if sourceId < 0 || sourceId >= canonicalModuleCount:
            err = " compiler snapshot builder: production Function source invalid"
            return false
        tables.symbols.ownerSymbolIds[callableSymbolId] =
            callableSymbolCount + sourceId
    if !compilerSnapshotProductionUnsealedBaseStrictValidateInto(
           tables, csg, err):
        return false
    var typeAssessment: CompilerSnapshotTypeProjectionReceipt
    if !compilerSnapshotBuilderTypeProjectionAssessInto(
           csg, typeAssessment, err) ||
       typeAssessment.admissionBlocked:
        if err == "":
            err = Fmt" compiler snapshot builder: production Type authority missing stage={typeAssessment.firstMissingStage} typeId={typeAssessment.firstMissingTypeId}"
        return false
    if !compilerSnapshotBuilderTypeFunctionProjectValidatedInto(
           tables,
           csg,
           true,
           err):
        return false
    var typedNodeProofCounts: compilerSnapshotProductionTypedNodeProofCounts
    if !compilerSnapshotProductionTypedNodeProofRowsReplayInto(
           tables, csg, true, typedNodeProofCounts, err):
        return false
    if typedNodeProofCounts.missingShareProofCount == 0:
        var canonicalFragmentCids: layout.FixedBytes32[]
        if !snapshot_schema.CsgCompilerFunctionFragmentCidsInto(
               tables, canonicalFragmentCids, err) ||
           canonicalFragmentCids.len !=
               tables.functions.fragmentCids.len:
            if err == "":
                err = " compiler snapshot builder: canonical Function fragment coverage drift"
            return false
        for functionId in 0..<canonicalFragmentCids.len:
            tables.functions.fragmentCids[functionId] =
                canonicalFragmentCids[functionId]
    if !compilerSnapshotProductionTypedNodeAdmissionApplyInto(
           tables, csg, admission, err):
        return false
    if !compilerSnapshotBuilderProductionTypedLexicalScopesProjectInto(
           tables, csg, canonicalSourceTexts, err):
        return false
    if !compilerSnapshotProductionLexicalProjectionApplyInto(
           tables, csg, admission, err):
        return false
    if !CompilerSnapshotProductionDiagnosticCompletionsProjectInto(
           tables, csg, err):
        return false
    if admission.missingTypedNodeProofCount == 0:
        if !compilerSnapshotProductionDiagnosticCompletionsBuildInto(
               csg, tables, admission, err) ||
           !compilerSnapshotProductionDiagnosticAdmissionApplyInto(
               tables,
               csg,
               admission,
               err):
            return false
    if !compilerSnapshotProductionReferenceProjectionMatchesCsgInto(
           csg, tables, err):
        return false
    let referenceProofCid =
        compilerSnapshotProductionReferenceProofCid(
            csg, tables,
            admission.referenceRequiredDomainCid)
    admission.referenceProofCid = referenceProofCid
    admission.missingReferenceProofCount = 0
    admission.missingFactBitmap =
        admission.missingFactBitmap &
        (511 - CompilerSnapshotAdmissionMissingReferenceProof)
    admission.missingFunctionOwnerIdentityCount = 0
    admission.missingFunctionInterfaceCount = 0
    admission.missingFactBitmap =
        admission.missingFactBitmap &
        (511 - CompilerSnapshotAdmissionMissingFunctionInterface)
    var producedDeclarationInterfaceCount: int32
    var producedGenericInterfaceCount: int32
    for symbolId in 0..<tables.symbols.symbolKinds.len:
        if tables.symbols.symbolKinds[symbolId] ==
               snapshot_schema.CsgCompilerSymbolGenericParameter:
            producedGenericInterfaceCount =
                producedGenericInterfaceCount + 1
        else:
            producedDeclarationInterfaceCount =
                producedDeclarationInterfaceCount + 1
    let producedAnnotationTargetBindingCount =
        tables.annotationTargets.parserAnnotationRows.len
    if producedDeclarationInterfaceCount >
           admission.missingSymbolDeclarationInterfaceCount ||
       producedGenericInterfaceCount >
           admission.missingSymbolGenericInterfaceCount ||
       producedAnnotationTargetBindingCount >
           admission.missingSymbolAnnotationTargetBindingCount:
        err = " compiler snapshot builder: production Symbol obligation overrun"
        return false
    admission.missingSymbolDeclarationInterfaceCount =
        admission.missingSymbolDeclarationInterfaceCount -
        producedDeclarationInterfaceCount
    admission.missingSymbolGenericInterfaceCount =
        admission.missingSymbolGenericInterfaceCount -
        producedGenericInterfaceCount
    admission.missingSymbolAnnotationTargetBindingCount =
        admission.missingSymbolAnnotationTargetBindingCount -
        producedAnnotationTargetBindingCount
    admission.missingSymbolInterfaceCount =
        admission.missingSymbolDeclarationInterfaceCount +
        admission.missingSymbolGenericInterfaceCount +
        admission.missingSymbolAnnotationTargetBindingCount
    if admission.missingSymbolInterfaceCount == 0:
        let symbolInterfaceProofCid =
            compilerSnapshotProductionSymbolInterfaceProofCid(
                csg, tables)
        admission.symbolInterfaceProofCid = symbolInterfaceProofCid
        admission.missingFactBitmap =
            admission.missingFactBitmap &
            (511 - CompilerSnapshotAdmissionMissingSymbolInterface)
    if !compilerSnapshotProductionDependenciesProjectInto(
           tables, csg, err):
        return false
    if admission.missingSymbolInterfaceCount == 0:
        var proofCid: layout.FixedBytes32
        var nextSourceInterfaceCids: layout.FixedBytes32[]
        var nextObservedInterfaceCids: layout.FixedBytes32[]
        if !CompilerSnapshotProductionSourceInterfacesBuildInto(
            csg,
            canonicalDocumentCids,
            canonicalSourceByProducer,
            admission.dependencyProofCid,
            tables,
            nextSourceInterfaceCids,
            nextObservedInterfaceCids,
            proofCid,
            err):
            return false
        for sourceId in 0..<nextSourceInterfaceCids.len:
            tables.sources.interfaceCids[sourceId] =
                nextSourceInterfaceCids[sourceId]
        for dependencyId in 0..<nextObservedInterfaceCids.len:
            tables.dependencies.observedInterfaceCids[dependencyId] =
                nextObservedInterfaceCids[dependencyId]
        admission.sourceInterfaceProofCid = proofCid
        admission.missingSourceInterfaceCount = 0
        admission.missingFactBitmap =
            admission.missingFactBitmap &
            (511 - CompilerSnapshotAdmissionMissingSourceInterface)
        var current: incremental.SemanticSnapshotIncrementalPrebuildFacts
        if !compilerSnapshotProductionInitialFactsBuildInto(
               tables,
               csg,
               canonicalSourceTexts,
               eventState,
               worldHeadCid,
               compilerExecutionCid,
               current,
               err):
            return false
        var plan: incremental.SemanticSnapshotIncrementalPrebuildPlan
        if !incremental.SemanticSnapshotIncrementalInitialPrebuildPlanBuildInto(
               current, plan, err):
            return false
        var rebuilt: incremental.SemanticSnapshotIncrementalRebuildReadInput
        if !CompilerSnapshotIncrementalRebuildReadsProduceInto(
               tables, csg, current, plan,
               rebuilt, err):
            return false
        var previous: snapshot_schema.CsgCompilerSnapshotTables
        var finalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
        if !incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
               previous, current, plan, rebuilt,
               finalized, err) ||
           !incremental.SemanticSnapshotIncrementalFinalizedReadSetStrictValidateInto(
               previous, current, plan, finalized, err) ||
           !compilerSnapshotProductionInitialReadsAttachInto(
               tables, current, finalized, err):
            return false
    let functionInterfaceProofCid =
        compilerSnapshotProductionFunctionInterfaceProofCid(
            csg,
            tables,
            admission.functionInterfaceRequiredDomainCid)
    admission.functionInterfaceProofCid = functionInterfaceProofCid
    admission.admissionBlocked =
        admission.missingFactBitmap != 0
    compilerSnapshotProductionAdmissionBindCurrentCsgFactsInto(
        admission, csg)
    let sealedAdmissionReceiptCid =
        compilerSnapshotProductionAdmissionReceiptCid(
            admission)
    admission.receiptCid = sealedAdmissionReceiptCid
    if !CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
           csg, tables, admission, err):
        return false
    if !admission.admissionBlocked &&
       !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
           tables, err):
        return false
    # Source-interface columns are a distinct construction phase. The builder
    # always returns the exact unsealed state; the sole Seal entrypoint
    # recomputes and atomically commits the authenticated interface columns.
    for sourceId in 0..<tables.sources.interfaceCids.len:
        let emptySourceInterfaceCid = layout.FixedBytes32()
        tables.sources.interfaceCids[sourceId] =
            emptySourceInterfaceCid
    for dependencyId in 0..<
            tables.dependencies.observedInterfaceCids.len:
        let emptyObservedInterfaceCid = layout.FixedBytes32()
        tables.dependencies.observedInterfaceCids[dependencyId] =
            emptyObservedInterfaceCid
    let emptySourceInterfaceProofCid = layout.FixedBytes32()
    admission.sourceInterfaceProofCid =
        emptySourceInterfaceProofCid
    admission.missingSourceInterfaceCount =
        tables.sources.documentCids.len
    admission.missingFactBitmap =
        admission.missingFactBitmap |
        CompilerSnapshotAdmissionMissingSourceInterface
    let unsealedFunctionInterfaceProofCid =
        compilerSnapshotProductionFunctionInterfaceProofCid(
            csg,
            tables,
            admission.functionInterfaceRequiredDomainCid)
    admission.functionInterfaceProofCid =
        unsealedFunctionInterfaceProofCid
    admission.admissionBlocked = true
    compilerSnapshotProductionAdmissionBindCurrentCsgFactsInto(
        admission, csg)
    let unsealedAdmissionReceiptCid =
        compilerSnapshotProductionAdmissionReceiptCid(
            admission)
    admission.receiptCid = unsealedAdmissionReceiptCid
    if !CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
           csg, tables, admission, err):
        return false
    err = ""
    return true

fn CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        receipt: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    var expected: CompilerSnapshotProductionAdmissionReceipt
    if receipt.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       receipt.semanticEpoch <= 0 ||
       !CompilerSnapshotProductionAdmissionAssessInto(
            csg, receipt.semanticEpoch, expected, err):
        return false
    if !layout.FixedBytes32Equal(
           receipt.receiptCid,
           compilerSnapshotProductionAdmissionReceiptCid(receipt)) ||
       !layout.FixedBytes32Equal(receipt.receiptCid, expected.receiptCid):
        err = " compiler snapshot builder: production admission receipt drift"
        return false
    err = ""
    return true

fn compilerSnapshotProductionCandidateExpectedReceiptCidInto(
        csg: var ccsg.CompilerCsg,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        out: var compilerSnapshotProductionCandidateExpectedReceipt,
        err: var str): bool =
    out = compilerSnapshotProductionCandidateExpectedReceipt()
    var expected: CompilerSnapshotProductionAdmissionReceipt
    if tables.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       tables.semanticEpoch <= 0 ||
       !CompilerSnapshotProductionAdmissionAssessInto(
           csg, tables.semanticEpoch, expected, err):
        return false
    if !compilerSnapshotBuilderExternFfiHandleContractsStrictValidateInto(
           tables, csg, err):
        return false
    var sourceInterfacesSealed = true
    var sourceInterfacesUnsealed = true
    for sourceId in 0..<tables.sources.interfaceCids.len:
        let observed = compilerSnapshotBuilderCidObserved(
            tables.sources.interfaceCids[sourceId])
        sourceInterfacesSealed = sourceInterfacesSealed && observed
        sourceInterfacesUnsealed = sourceInterfacesUnsealed && !observed
    if !sourceInterfacesSealed && !sourceInterfacesUnsealed:
        err = " compiler snapshot builder: mixed source-interface candidate"
        return false
    if sourceInterfacesSealed:
        if !snapshot_schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
               tables, err) ||
           !snapshot_schema.CsgCompilerSnapshotReferenceCallTablesStrictValidateInto(
               tables, err):
            return false
    else:
        if !snapshot_schema.CsgCompilerSnapshotUnsealedSymbolFunctionTablesStrictValidateInto(
               tables, err) ||
           !snapshot_schema.CsgCompilerSnapshotUnsealedReferenceCallReadTablesStrictValidateInto(
               tables, err):
            return false
    if !compilerSnapshotProductionReferenceProjectionMatchesCsgInto(
           csg, tables, err):
        return false
    if !compilerSnapshotProductionLexicalProjectionApplyInto(
           tables, csg, expected, err):
        return false
    if !compilerSnapshotProductionTypedNodeAdmissionApplyInto(
           tables, csg, expected, err):
        return false
    if !CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
           tables,
           csg.parserNormalizedExprReceipt.sourceSidecars,
           csg,
           err):
        return false
    if expected.missingTypedNodeProofCount == 0 &&
       !compilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
           csg, tables, expected, err):
        return false
    if tables.functions.symbolIds.len !=
           expected.reachableFunctionCount:
        err = " compiler snapshot builder: production candidate Function coverage drift"
        return false
    var expectedBindingReferenceCount: int32
    for typedNodeId in 0..<tables.typedNodes.opKinds.len:
        if typedNodeId <
               tables.typedNodes.bindingProducerSourceIndexes.len &&
           tables.typedNodes.bindingProducerSourceIndexes[
               typedNodeId] >= 0 &&
           (tables.typedNodes.opKinds[typedNodeId] ==
                snapshot_schema.CsgCompilerTypedOpParamRef ||
            tables.typedNodes.opKinds[typedNodeId] ==
                snapshot_schema.CsgCompilerTypedOpLocalRef):
            expectedBindingReferenceCount =
                expectedBindingReferenceCount + 1
    if tables.references.sourceIds.len !=
           expected.resolvedCallCount +
               expectedBindingReferenceCount ||
       tables.calls.callReferenceIds.len != expected.resolvedCallCount:
        err = " compiler snapshot builder: production candidate reference coverage drift"
        return false
    expected.missingFunctionOwnerIdentityCount = 0
    expected.missingFunctionInterfaceCount = 0
    let functionInterfaceProofCid =
        compilerSnapshotProductionFunctionInterfaceProofCid(
            csg, tables,
            expected.functionInterfaceRequiredDomainCid)
    expected.functionInterfaceProofCid =
        functionInterfaceProofCid
    expected.missingFactBitmap =
        expected.missingFactBitmap &
        (511 - CompilerSnapshotAdmissionMissingFunctionInterface)
    let referenceProofCid =
        compilerSnapshotProductionReferenceProofCid(
            csg, tables, expected.referenceRequiredDomainCid)
    expected.referenceProofCid = referenceProofCid
    expected.missingReferenceProofCount = 0
    expected.missingFactBitmap =
        expected.missingFactBitmap &
        (511 - CompilerSnapshotAdmissionMissingReferenceProof)
    var producedDeclarationInterfaceCount: int32
    var producedGenericInterfaceCount: int32
    for symbolId in 0..<tables.symbols.symbolKinds.len:
        if tables.symbols.symbolKinds[symbolId] ==
               snapshot_schema.CsgCompilerSymbolGenericParameter:
            producedGenericInterfaceCount =
                producedGenericInterfaceCount + 1
        else:
            producedDeclarationInterfaceCount =
                producedDeclarationInterfaceCount + 1
    let producedAnnotationTargetBindingCount =
        tables.annotationTargets.parserAnnotationRows.len
    if producedDeclarationInterfaceCount >
           expected.missingSymbolDeclarationInterfaceCount ||
       producedGenericInterfaceCount >
           expected.missingSymbolGenericInterfaceCount ||
       producedAnnotationTargetBindingCount >
           expected.missingSymbolAnnotationTargetBindingCount:
        err = " compiler snapshot builder: production candidate Symbol coverage drift"
        return false
    expected.missingSymbolDeclarationInterfaceCount =
        expected.missingSymbolDeclarationInterfaceCount -
        producedDeclarationInterfaceCount
    expected.missingSymbolGenericInterfaceCount =
        expected.missingSymbolGenericInterfaceCount -
        producedGenericInterfaceCount
    expected.missingSymbolAnnotationTargetBindingCount =
        expected.missingSymbolAnnotationTargetBindingCount -
        producedAnnotationTargetBindingCount
    expected.missingSymbolInterfaceCount =
        expected.missingSymbolDeclarationInterfaceCount +
        expected.missingSymbolGenericInterfaceCount +
        expected.missingSymbolAnnotationTargetBindingCount
    if expected.missingSymbolInterfaceCount == 0:
        let symbolInterfaceProofCid =
            compilerSnapshotProductionSymbolInterfaceProofCid(
                csg, tables)
        expected.symbolInterfaceProofCid =
            symbolInterfaceProofCid
        expected.missingFactBitmap =
            expected.missingFactBitmap &
            (511 - CompilerSnapshotAdmissionMissingSymbolInterface)
        var sourceInterfacesComplete = true
        for sourceId in 0..<tables.sources.interfaceCids.len:
            if !compilerSnapshotBuilderCidObserved(
                   tables.sources.interfaceCids[sourceId]):
                sourceInterfacesComplete = false
        if sourceInterfacesComplete:
            let sourceInterfaceProofCid =
                compilerSnapshotProductionSourceInterfaceProofCid(
                    csg,
                    tables,
                    expected.dependencyProofCid)
            expected.sourceInterfaceProofCid =
                sourceInterfaceProofCid
            expected.missingSourceInterfaceCount = 0
            expected.missingFactBitmap =
                expected.missingFactBitmap &
                (511 - CompilerSnapshotAdmissionMissingSourceInterface)
    if sourceInterfacesSealed &&
       (expected.missingSourceInterfaceCount != 0 ||
        (expected.missingFactBitmap &
            CompilerSnapshotAdmissionMissingSourceInterface) != 0):
        err = Fmt" compiler snapshot builder: sealed source-interface assessment drift symbol={expected.missingSymbolInterfaceCount} declaration={expected.missingSymbolDeclarationInterfaceCount} generic={expected.missingSymbolGenericInterfaceCount} annotation={expected.missingSymbolAnnotationTargetBindingCount} symbolRows={tables.symbols.symbolCids.len} symbolKindRows={tables.symbols.symbolKinds.len}"
        return false
    if expected.missingTypedNodeProofCount == 0 &&
       !compilerSnapshotProductionDiagnosticAdmissionApplyInto(
           tables,
           csg,
           expected,
           err):
        return false
    expected.admissionBlocked = expected.missingFactBitmap != 0
    let receiptCid =
        compilerSnapshotProductionAdmissionReceiptCid(expected)
    expected.receiptCid = receiptCid
    out.receiptCid = expected.receiptCid
    out.missingFactBitmap = expected.missingFactBitmap
    out.missingSourceInterfaceCount =
        expected.missingSourceInterfaceCount
    out.missingTypedNodeProofCount =
        expected.missingTypedNodeProofCount
    out.missingReferenceProofCount =
        expected.missingReferenceProofCount
    out.missingSymbolInterfaceCount =
        expected.missingSymbolInterfaceCount
    out.completedStageBitmap = expected.completedStageBitmap
    out.typeArenaTypeCount = expected.typeArenaTypeCount
    out.typeArenaSymbolCount = expected.typeArenaSymbolCount
    out.retainedFactsCid = expected.retainedFactsCid
    out.lexicalScopeRequiredDomainCid =
        expected.lexicalScopeRequiredDomainCid
    out.functionInterfaceProofCid =
        expected.functionInterfaceProofCid
    out.sourceInterfaceProofCid =
        expected.sourceInterfaceProofCid
    out.symbolInterfaceProofCid =
        expected.symbolInterfaceProofCid
    out.typedNodeProofCid =
        expected.typedNodeProofCid
    out.referenceProofCid = expected.referenceProofCid
    out.lexicalScopeProofCid =
        expected.lexicalScopeProofCid
    out.diagnosticProofCid =
        expected.diagnosticProofCid
    err = ""
    return true

# Computes the complete expected candidate authority in a separate stack frame.
# The validator itself never materializes a second AdmissionReceipt beside the
# receipt under test, preventing composite ABI slot reuse from rewriting it.
@borrows
fn compilerSnapshotProductionCandidateReceiptAuthorityStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        receiptSchemaVersion: int32,
        receiptSemanticEpoch: int64,
        actualReceiptCid: layout.FixedBytes32,
        actualReceiptSelfCid: layout.FixedBytes32,
        actualMissingFactBitmap: int32,
        actualMissingSourceInterfaceCount: int32,
        actualMissingTypedNodeProofCount: int32,
        actualFunctionInterfaceProofCid: layout.FixedBytes32,
        actualSourceInterfaceProofCid: layout.FixedBytes32,
        actualSymbolInterfaceProofCid: layout.FixedBytes32,
        actualTypedNodeProofCid: layout.FixedBytes32,
        actualReferenceProofCid: layout.FixedBytes32,
        actualLexicalScopeProofCid: layout.FixedBytes32,
        actualDiagnosticProofCid: layout.FixedBytes32,
        actualRetainedFactsCid: layout.FixedBytes32,
        actualLexicalScopeRequiredDomainCid: layout.FixedBytes32,
        actualMissingSymbolInterfaceCount: int32,
        actualCompletedStageBitmap: int32,
        actualTypeArenaTypeCount: int32,
        actualTypeArenaSymbolCount: int32,
        err: var str): bool =
    if receiptSchemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       receiptSemanticEpoch != tables.semanticEpoch:
        err = " compiler snapshot builder: production candidate receipt version drift"
        return false
    if !layout.FixedBytes32Equal(
           actualReceiptCid, actualReceiptSelfCid):
        err = " compiler snapshot builder: production candidate receipt self-check drift"
        return false
    var expected: compilerSnapshotProductionCandidateExpectedReceipt
    if !compilerSnapshotProductionCandidateExpectedReceiptCidInto(
           csg,
           tables,
           expected,
           err):
        return false
    if !layout.FixedBytes32Equal(
           actualReceiptCid, expected.receiptCid):
        if actualMissingFactBitmap != expected.missingFactBitmap ||
           actualMissingSourceInterfaceCount !=
               expected.missingSourceInterfaceCount ||
           actualMissingTypedNodeProofCount !=
               expected.missingTypedNodeProofCount:
            err = Fmt" compiler snapshot builder: production candidate receipt fact drift bitmap={actualMissingFactBitmap}/{expected.missingFactBitmap} source={actualMissingSourceInterfaceCount}/{expected.missingSourceInterfaceCount} typed={actualMissingTypedNodeProofCount}/{expected.missingTypedNodeProofCount}"
            return false
        if !layout.FixedBytes32Equal(
               actualFunctionInterfaceProofCid,
               expected.functionInterfaceProofCid):
            err = " compiler snapshot builder: production candidate Function proof drift"
            return false
        if !layout.FixedBytes32Equal(
               actualSourceInterfaceProofCid,
               expected.sourceInterfaceProofCid):
            err = " compiler snapshot builder: production candidate source-interface proof drift"
            return false
        if !layout.FixedBytes32Equal(
               actualSymbolInterfaceProofCid,
               expected.symbolInterfaceProofCid):
            err = " compiler snapshot builder: production candidate Symbol proof drift"
            return false
        if !layout.FixedBytes32Equal(
               actualTypedNodeProofCid,
               expected.typedNodeProofCid):
            err = " compiler snapshot builder: production candidate TypedNode proof drift"
            return false
        if !layout.FixedBytes32Equal(
               actualReferenceProofCid,
               expected.referenceProofCid):
            err = " compiler snapshot builder: production candidate reference proof drift"
            return false
        if !layout.FixedBytes32Equal(
               actualLexicalScopeProofCid,
               expected.lexicalScopeProofCid):
            err = " compiler snapshot builder: production candidate lexical proof drift"
            return false
        if !layout.FixedBytes32Equal(
               actualDiagnosticProofCid,
               expected.diagnosticProofCid):
            err = " compiler snapshot builder: production candidate diagnostic proof drift"
            return false
        if !layout.FixedBytes32Equal(
               actualRetainedFactsCid, expected.retainedFactsCid):
            err = " compiler snapshot builder: production candidate retained-facts drift"
            return false
        if !layout.FixedBytes32Equal(
               actualLexicalScopeRequiredDomainCid,
               expected.lexicalScopeRequiredDomainCid):
            err = " compiler snapshot builder: production candidate lexical required-domain drift"
            return false
        if actualMissingSymbolInterfaceCount !=
               expected.missingSymbolInterfaceCount:
            err = Fmt" compiler snapshot builder: production candidate Symbol interface count drift {actualMissingSymbolInterfaceCount}/{expected.missingSymbolInterfaceCount}"
            return false
        if actualCompletedStageBitmap != expected.completedStageBitmap:
            err = Fmt" compiler snapshot builder: production candidate completed-stage drift {actualCompletedStageBitmap}/{expected.completedStageBitmap}"
            return false
        if actualTypeArenaTypeCount != expected.typeArenaTypeCount ||
           actualTypeArenaSymbolCount != expected.typeArenaSymbolCount:
            err = Fmt" compiler snapshot builder: production candidate TypeArena count drift type={actualTypeArenaTypeCount}/{expected.typeArenaTypeCount} symbol={actualTypeArenaSymbolCount}/{expected.typeArenaSymbolCount}"
            return false
        err = " compiler snapshot builder: production candidate receipt authority drift"
        return false
    err = ""
    return true

@borrows
fn CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        receipt: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    return compilerSnapshotProductionCandidateReceiptAuthorityStrictValidateInto(
        csg,
        tables,
        receipt.schemaVersion,
        receipt.semanticEpoch,
        receipt.receiptCid,
        compilerSnapshotProductionAdmissionReceiptCid(receipt),
        receipt.missingFactBitmap,
        receipt.missingSourceInterfaceCount,
        receipt.missingTypedNodeProofCount,
        receipt.functionInterfaceProofCid,
        receipt.sourceInterfaceProofCid,
        receipt.symbolInterfaceProofCid,
        receipt.typedNodeProofCid,
        receipt.referenceProofCid,
        receipt.lexicalScopeProofCid,
        receipt.diagnosticProofCid,
        receipt.retainedFactsCid,
        receipt.lexicalScopeRequiredDomainCid,
        receipt.missingSymbolInterfaceCount,
        receipt.completedStageBitmap,
        receipt.typeArenaTypeCount,
        receipt.typeArenaSymbolCount,
        err)

# Seals the only latest-schema production candidate. All validation completes
# against a private sealed clone before the caller-owned table columns and
# receipt are committed.
fn CompilerSnapshotProductionCandidateSealInto(
        csg: var ccsg.CompilerCsg,
        canonicalDocumentCids: var layout.FixedBytes32[],
        canonicalSourceByProducer: var int32[],
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        admission: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    if tables.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       tables.sources.documentCids.len != canonicalDocumentCids.len ||
       tables.sources.interfaceCids.len !=
           tables.sources.documentCids.len ||
       tables.dependencies.observedInterfaceCids.len !=
           tables.dependencies.sourceIds.len:
        err = " compiler snapshot builder: production candidate is not unsealed"
        return false
    for sourceId in 0..<tables.sources.interfaceCids.len:
        if compilerSnapshotBuilderCidObserved(
               tables.sources.interfaceCids[sourceId]):
            err = " compiler snapshot builder: source-interface candidate already sealed"
            return false
    for dependencyId in 0..<
            tables.dependencies.observedInterfaceCids.len:
        if compilerSnapshotBuilderCidObserved(
               tables.dependencies.observedInterfaceCids[dependencyId]):
            err = " compiler snapshot builder: observed-interface candidate already sealed"
            return false
    if !CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
           csg, tables, admission, err):
        return false
    if !compilerSnapshotBuilderTypeArenaBridgeStrictValidateInto(
           tables, csg, err):
        return false
    var nextSourceInterfaceCids: layout.FixedBytes32[]
    var nextObservedInterfaceCids: layout.FixedBytes32[]
    var sourceInterfaceProofCid: layout.FixedBytes32
    let dependencyProofCid =
        compilerSnapshotProductionDependencyProofCid(csg)
    if !CompilerSnapshotProductionSourceInterfacesBuildInto(
           csg,
           canonicalDocumentCids,
           canonicalSourceByProducer,
           dependencyProofCid,
           tables,
           nextSourceInterfaceCids,
           nextObservedInterfaceCids,
           sourceInterfaceProofCid,
           err):
        return false
    if nextSourceInterfaceCids.len !=
           tables.sources.interfaceCids.len ||
       nextObservedInterfaceCids.len !=
           tables.dependencies.observedInterfaceCids.len:
        err = " compiler snapshot builder: source-interface seal cardinality drift"
        return false
    var sealed = snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    for sourceId in 0..<nextSourceInterfaceCids.len:
        sealed.sources.interfaceCids[sourceId] =
            nextSourceInterfaceCids[sourceId]
    for dependencyId in 0..<nextObservedInterfaceCids.len:
        sealed.dependencies.observedInterfaceCids[dependencyId] =
            nextObservedInterfaceCids[dependencyId]
    var sealedExpected: compilerSnapshotProductionCandidateExpectedReceipt
    if !compilerSnapshotProductionCandidateExpectedReceiptCidInto(
           csg,
           sealed,
           sealedExpected,
           err):
        return false
    if sealedExpected.missingSourceInterfaceCount != 0 ||
       (sealedExpected.missingFactBitmap &
            CompilerSnapshotAdmissionMissingSourceInterface) != 0:
        err = " compiler snapshot builder: source-interface seal proof drift"
        return false
    if sealedExpected.missingFactBitmap == 0 &&
       !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
           sealed, err):
        return false
    for sourceId in 0..<nextSourceInterfaceCids.len:
        tables.sources.interfaceCids[sourceId] =
            nextSourceInterfaceCids[sourceId]
    for dependencyId in 0..<nextObservedInterfaceCids.len:
        tables.dependencies.observedInterfaceCids[dependencyId] =
            nextObservedInterfaceCids[dependencyId]
    admission.schemaVersion =
        snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    admission.semanticEpoch = tables.semanticEpoch
    admission.dependencyProofCid = dependencyProofCid
    admission.sourceInterfaceProofCid =
        sealedExpected.sourceInterfaceProofCid
    admission.symbolInterfaceProofCid =
        sealedExpected.symbolInterfaceProofCid
    admission.functionInterfaceProofCid =
        sealedExpected.functionInterfaceProofCid
    admission.typedNodeProofCid =
        sealedExpected.typedNodeProofCid
    admission.referenceProofCid =
        sealedExpected.referenceProofCid
    admission.lexicalScopeProofCid =
        sealedExpected.lexicalScopeProofCid
    admission.diagnosticProofCid =
        sealedExpected.diagnosticProofCid
    admission.missingSourceInterfaceCount =
        sealedExpected.missingSourceInterfaceCount
    admission.missingTypedNodeProofCount =
        sealedExpected.missingTypedNodeProofCount
    admission.missingReferenceProofCount =
        sealedExpected.missingReferenceProofCount
    admission.missingFactBitmap =
        sealedExpected.missingFactBitmap
    admission.admissionBlocked =
        sealedExpected.missingFactBitmap != 0
    admission.receiptCid = sealedExpected.receiptCid
    err = ""
    return true

fn compilerSnapshotBuilderGraphReceiptCid(
        receipt: var CompilerSnapshotGraphProjectionReceipt): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(512)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.graph.projection.receipt")
    compilerSnapshotBuilderHashAppendCid(buf, receipt.sourcePackageIdCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.entryModulePathCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.sourceBundleCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.entrySourceCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.importGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.graphCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.sourceIdentityReceiptCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.retainedFactsCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.prebuildFactsCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.finalizedReadSetReceiptCid)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.sourceCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.nodeCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.edgeCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.symbolCandidateCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.reachableFunctionCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.typedIrFunctionCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.resolvedCallCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.projectedSymbolCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.projectedFunctionCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.projectedReferenceCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.projectedCallCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.projectedReadSetRowCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingSymbolSourceBindingCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingSymbolDeclarationSpanCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingSymbolDeclarationHeaderCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingSymbolDeclarationPathCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingSymbolIdentityCidCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.missingSymbolTypeCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingSymbolInterfaceCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionGraphNodeBindingCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionTypedIrBindingCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionBodySpanCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionBodyContentCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionFragmentCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionInterfaceCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionReadSetPreimageCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingResolvedTargetNodeIdCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingReferenceSpanCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.missingResultTypeCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingResultOwnershipCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingLexicalScopeProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeBindingCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeTypeIdCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeValueKindCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeOwnershipProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingValueSendProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingValueSyncProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingValueShareProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingThreadBoundaryProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.admissionBlocked ? 1 : 0)
    return compilerSnapshotBuilderHashFinish(buf)

# Proves the exact bijection between reachable graph Symbol nodes and committed
# TypedIR function rows. CompilerCSG's retained graph node id is the identity
# key; source/name/line remain independently validated facts, never identity.
@borrows
fn compilerSnapshotBuilderTypedFunctionJoinInto(
        csg: ccsg.CompilerCsg,
        typedRowByReachable: var int32[],
        err: var str): bool =
    typedRowByReachable = []
    let reachableCount = csg.semanticGraph.reachableFunctionTable.sourceIndex.len
    let typedCount = csg.semanticGraph.typedIrTable.functionSourceIndexes.len
    if reachableCount != typedCount:
        err = " compiler snapshot builder: typed function domain is not the reachable graph closure"
        return false
    for reachableRow in 0..<reachableCount:
        add(typedRowByReachable, -1)
    var reachableByGraphNodeId: int32[]
    setLen(reachableByGraphNodeId, csg.nodes.len + 1)
    for graphNodeId in 0..<reachableByGraphNodeId.len:
        reachableByGraphNodeId[graphNodeId] = -1
    for reachableRow in 0..<reachableCount:
        let graphNodeId =
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[reachableRow]
        if graphNodeId <= 0 || graphNodeId >= reachableByGraphNodeId.len ||
           reachableByGraphNodeId[graphNodeId] >= 0:
            err = " compiler snapshot builder: reachable graph function identity invalid"
            return false
        reachableByGraphNodeId[graphNodeId] = reachableRow
    for typedRow in 0..<typedCount:
        let graphNodeId =
            csg.semanticGraph.typedIrTable.functionGraphNodeIds[typedRow]
        if graphNodeId <= 0 || graphNodeId >= reachableByGraphNodeId.len:
            err = " compiler snapshot builder: typed function graph identity invalid"
            return false
        let matched = reachableByGraphNodeId[graphNodeId]
        if matched < 0 || typedRowByReachable[matched] >= 0:
            err = " compiler snapshot builder: typed function has no exact graph row"
            return false
        typedRowByReachable[matched] = typedRow
    for reachableRow in 0..<reachableCount:
        if typedRowByReachable[reachableRow] < 0:
            err = " compiler snapshot builder: graph function has no exact typed row"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypedDomainExact(
        csg: ccsg.CompilerCsg): bool =
    var symbolCount: int32
    for index in 0..<csg.nodes.len:
        if csg.nodes[index].nodeKind ==
               ccsg.CompilerCsgNodeKindSymbol:
            symbolCount = symbolCount + 1
    if symbolCount !=
           csg.semanticGraph.reachableFunctionTable.sourceIndex.len:
        return false
    var join: int32[]
    var joinErr: str
    return compilerSnapshotBuilderTypedFunctionJoinInto(csg, join, joinErr)

# Fragment identity is the domain-separated SHA-256 of the canonical typed-IR
# function fragment encoding.  The fragment producer is the retained TypedIR
# itself; no source text is re-read and no shallow digest substitutes it.
@borrows
fn compilerSnapshotBuilderFunctionFragmentCidInto(
        csg: ccsg.CompilerCsg,
        typedRow: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    let fragment = fragcodec.TypedExprIrFunctionFragmentExtract(
        csg.typedIr, typedRow)
    let encoded = fragcodec.TypedExprIrFunctionFragmentEncode(fragment)
    let encodedLen = rawbytes.BytesLen(encoded)
    var buf = layout.ByteBufInit(96 + encodedLen)
    # Producer receipt only.  Canonical CSG FunctionFragmentCid additionally
    # commits structural TypeIds and value proof CIDs, which this inspection
    # projection intentionally leaves as hard admission gaps.
    let domain = "cheng.compiler.typed_ir_function_fragment_receipt"
    for index in 0..<domain.len:
        layout.ByteBufAppendByte(buf, Int32(domain[index]) & 255)
    layout.ByteBufAppendByte(buf, (encodedLen >> 24) & 255)
    layout.ByteBufAppendByte(buf, (encodedLen >> 16) & 255)
    layout.ByteBufAppendByte(buf, (encodedLen >> 8) & 255)
    layout.ByteBufAppendByte(buf, encodedLen & 255)
    for index in 0..<encodedLen:
        layout.ByteBufAppendByte(
            buf, rawbytes.BytesGet(encoded, index) & 255)
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

fn compilerSnapshotBuilderOwnershipKind(
        exprClass: texpr.TypedExprExprClass): int32 =
    if exprClass == texpr.TypedExprExprOwned:
        return snapshot_schema.CsgCompilerOwnershipOwned
    if exprClass == texpr.TypedExprExprBorrowed:
        return snapshot_schema.CsgCompilerOwnershipBorrowed
    if exprClass == texpr.TypedExprExprUnmanaged:
        return snapshot_schema.CsgCompilerOwnershipUnmanaged
    return 0

@borrows
fn compilerSnapshotBuilderOperandRow(
        operandProducerNodeId: int32,
        snapshotRowByProducerNode: int32[],
        functionStart: int32,
        currentRow: int32): int32 =
    if operandProducerNodeId == -1:
        return -1
    if operandProducerNodeId < 0 ||
       operandProducerNodeId >= snapshotRowByProducerNode.len:
        return -2
    let row = snapshotRowByProducerNode[operandProducerNodeId]
    if row < functionStart || row >= currentRow:
        return -2
    return row

@borrows
fn compilerSnapshotBuilderTypedStatementRootAppendInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        snapshotRowByProducerNode: int32[],
        statementId: int32,
        rootNodePosition: int32,
        err: var str): bool =
    if rootNodePosition == -1:
        return true
    if rootNodePosition < 0 ||
       rootNodePosition >= csg.typedIr.nodes2_nodeIndexs.len:
        err = " compiler snapshot builder: typed-statement root escapes node arena"
        return false
    let rootProducerNodeId = arenamod.ArenaArrayInt32Get(
        csg.typedIr.arena,
        csg.typedIr.nodes2_nodeIndexs,
        rootNodePosition)
    if rootProducerNodeId < 0 ||
       rootProducerNodeId >= snapshotRowByProducerNode.len:
        err = " compiler snapshot builder: typed-statement producer root invalid"
        return false
    let rootTypedNodeId =
        snapshotRowByProducerNode[rootProducerNodeId]
    if rootTypedNodeId < 0 ||
       rootTypedNodeId >= tables.typedNodes.ownerStatementIds.len ||
       tables.typedNodes.ownerStatementIds[rootTypedNodeId] !=
           statementId:
        err = " compiler snapshot builder: typed-statement root owner drift"
        return false
    let rootStart = tables.typedStatements.rootStarts[statementId]
    for rootOffset in 0..<
            tables.typedStatements.rootTypedNodeIds.len - rootStart:
        if tables.typedStatements.rootTypedNodeIds[
               rootStart + rootOffset] == rootTypedNodeId:
            return true
    add(tables.typedStatements.rootTypedNodeIds, rootTypedNodeId)
    return true

@borrows
fn compilerSnapshotBuilderProjectTypedNodesInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let totalNodeCount = csg.typedIr.nodes2_nodeIndexs.len
    if tables.valueDefinitions.originKinds.len != 0 ||
       tables.valueDefinitions.groupRows.len != 0 ||
       tables.valueDefinitions.producerSourceIndexes.len != 0 ||
       tables.valueDefinitions.sourceLocalNodeIndexes.len != 0 ||
       tables.valueDefinitions.declarationSourceLocalRows.len != 0 ||
       tables.valueDefinitions.patternSourceLocalRows.len != 0 ||
       tables.valueDefinitions.functionIds.len != 0 ||
       tables.valueDefinitions.definingTypedNodeIds.len != 0 ||
       tables.valueDefinitions.typeIds.len != 0 ||
       tables.valueDefinitions.ownershipKinds.len != 0 ||
       tables.valueDefinitions.proofKinds.len != 0 ||
       tables.valueDefinitionGroups.producerSourceIndexes.len != 0 ||
       tables.valueDefinitionGroups.parserProducerSourceIndexes.len !=
           0 ||
       tables.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes.len !=
           0 ||
       tables.valueDefinitionGroups.bindingOffsets.len != 0 ||
       tables.valueDefinitionGroups.bindingCounts.len != 0 ||
       tables.valueDefinitionGroups.functionIds.len != 0 ||
       tables.valueDefinitionGroups.declarationSourceLocalRows.len !=
           0 ||
       tables.valueDefinitionGroups.patternSourceLocalRows.len != 0 ||
       tables.valueDefinitionGroups.definitionRows.len != 0 ||
       tables.valueDefinitionGroups.consumedFlags.len != 0 ||
       tables.typedStatements.typedIrStatementIndexes.len != 0 ||
       tables.typedStatements.functionIds.len != 0 ||
       tables.typedStatements.rootStarts.len != 0 ||
       tables.typedStatements.rootCounts.len != 0 ||
       tables.typedStatements.rootTypedNodeIds.len != 0 ||
       tables.typedNodes.ownerStatementIds.len != 0:
        err = " compiler snapshot builder: typed ownership destination is not empty"
        return false
    var sourceNodeCounts: int32[]
    setLen(sourceNodeCounts, tables.sources.documentCids.len)
    for parserNodeId in 0..<tables.parserNodes.sourceIds.len:
        let sourceId = tables.parserNodes.sourceIds[parserNodeId]
        sourceNodeCounts[sourceId] = sourceNodeCounts[sourceId] + 1
    var sourceNodeStarts: int32[]
    setLen(sourceNodeStarts, sourceNodeCounts.len)
    var parserNodeCursor: int32
    for sourceId in 0..<sourceNodeCounts.len:
        sourceNodeStarts[sourceId] = parserNodeCursor
        parserNodeCursor = parserNodeCursor + sourceNodeCounts[sourceId]
    var parserNodeByProducerSlot: int32[]
    setLen(parserNodeByProducerSlot, tables.parserNodes.sourceIds.len)
    for slot in 0..<parserNodeByProducerSlot.len:
        parserNodeByProducerSlot[slot] = -1
    for parserNodeId in 0..<tables.parserNodes.sourceIds.len:
        let sourceId = tables.parserNodes.sourceIds[parserNodeId]
        let producerNodeId =
            tables.parserNodes.producerNodeIds[parserNodeId]
        if producerNodeId < 0 || producerNodeId >= sourceNodeCounts[sourceId]:
            err = " compiler snapshot builder: parser producer identity out of range"
            return false
        let slot = sourceNodeStarts[sourceId] + producerNodeId
        if parserNodeByProducerSlot[slot] >= 0:
            err = " compiler snapshot builder: parser producer identity duplicated"
            return false
        parserNodeByProducerSlot[slot] = parserNodeId
    var snapshotRowByProducerNode: int32[]
    setLen(snapshotRowByProducerNode, totalNodeCount)
    for producerNodeId in 0..<totalNodeCount:
        snapshotRowByProducerNode[producerNodeId] = -1
    for functionId in 0..<tables.functions.symbolIds.len:
        let typedFunctionIndex =
            tables.functions.typedFunctionIndexes[functionId]
        let producerSourceIndex =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[typedFunctionIndex]
        let sourceId = compilerSnapshotBuilderCanonicalSourceForProducer(
            tables, producerSourceIndex)
        let nodePositionStart =
            csg.semanticGraph.typedIrTable.functionNodeStart[typedFunctionIndex]
        let nodeCount =
            csg.semanticGraph.typedIrTable.functionNodeCount[typedFunctionIndex]
        let functionStart = tables.typedNodes.functionIds.len
        let producerStatementStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_statementStarts,
            typedFunctionIndex)
        let producerStatementCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_statementCounts,
            typedFunctionIndex)
        let statementSnapshotStart =
            tables.typedStatements.functionIds.len
        if producerStatementStart < 0 ||
           producerStatementCount < 0 ||
           producerStatementStart >
               csg.typedIr.statements2_statementIndexs.len -
                   producerStatementCount:
            err = " compiler snapshot builder: typed function statement CSR invalid"
            return false
        for localStatement in 0..<producerStatementCount:
            let producerStatementIndex =
                producerStatementStart + localStatement
            if arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.statements2_statementIndexs,
                   producerStatementIndex) != producerStatementIndex:
                err = " compiler snapshot builder: typed statement producer identity drift"
                return false
            add(tables.typedStatements.typedIrStatementIndexes,
                producerStatementIndex)
            add(tables.typedStatements.functionIds, functionId)
            add(tables.typedStatements.rootStarts, 0)
            add(tables.typedStatements.rootCounts, 0)
        tables.functions.nodeStarts[functionId] = functionStart
        tables.functions.nodeCounts[functionId] = nodeCount
        if sourceId < 0 || tables.symbols.sourceIds[
                tables.functions.symbolIds[functionId]] != sourceId:
            err = " compiler snapshot builder: typed node function source drift"
            return false
        for localNode in 0..<nodeCount:
            let nodePosition = nodePositionStart + localNode
            let producerNodeId = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_nodeIndexs,
                nodePosition)
            if producerNodeId < 0 || producerNodeId >= totalNodeCount ||
               snapshotRowByProducerNode[producerNodeId] >= 0:
                err = " compiler snapshot builder: typed node producer identity invalid"
                return false
            let sourceResult = langintern.LookupIntern(
                csg.typedIr.internPool,
                csg.typedIr.nodes2_sourcePathIds[nodePosition])
            let functionResult = langintern.LookupIntern(
                csg.typedIr.internPool,
                csg.typedIr.nodes2_functionNameIds[nodePosition])
            if !IsOk(sourceResult) || !IsOk(functionResult) ||
               Value(sourceResult) !=
                   csg.semanticGraph.sourceTable.sourcePaths[producerSourceIndex] ||
               Value(functionResult) !=
                   csg.semanticGraph.typedIrTable.functionNames[typedFunctionIndex]:
                err = " compiler snapshot builder: typed node owner drift"
                return false
            let originProducerNodeId = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_originParserNodeIds,
                nodePosition)
            let syntheticOriginKind = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_syntheticOriginKinds,
                nodePosition)
            let spanAuthorityKind = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_spanAuthorityKinds,
                nodePosition)
            var originParserNodeId: int32 = -1
            var spanId: int32 = -1
            if originProducerNodeId >= 0 && syntheticOriginKind == 0 &&
               spanAuthorityKind == texpr.TypedExprSpanAuthorityParserNode:
                if originProducerNodeId >= sourceNodeCounts[sourceId]:
                    err = " compiler snapshot builder: typed parser origin out of range"
                    return false
                originParserNodeId = parserNodeByProducerSlot[
                    sourceNodeStarts[sourceId] + originProducerNodeId]
                if originParserNodeId < 0:
                    err = " compiler snapshot builder: typed parser origin missing"
                    return false
                spanId = tables.parserNodes.spanIds[originParserNodeId]
            elif originProducerNodeId != -1 || syntheticOriginKind <= 0 ||
                 syntheticOriginKind >
                     texpr.TypedExprSyntheticOriginRuntimeIntrinsic ||
                 spanAuthorityKind !=
                     texpr.TypedExprSpanAuthorityNoSource:
                err = " compiler snapshot builder: typed node origin proof invalid"
                return false
            let ownershipKind = compilerSnapshotBuilderOwnershipKind(
                csg.typedIr.nodes2_exprClasses[nodePosition])
            let opKind = Int32(csg.typedIr.nodes2_opKinds[nodePosition])
            let bindingParserNodeIndex =
                texpr.TypedExprIrNodeBindingParserNodeIndexAt(
                    csg.typedIr, nodePosition)
            let bindingProducerSourceIndex =
                texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
                    csg.typedIr, nodePosition)
            let bindingDeclarationSourceLocalRow =
                texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
                    csg.typedIr, nodePosition)
            let bindingPatternSourceLocalRow =
                texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
                    csg.typedIr, nodePosition)
            let bindingValueDefinitionRow =
                texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
                    csg.typedIr, nodePosition)
            let producedValueDefinitionRow =
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_producedValueDefinitionRows,
                    nodePosition)
            let bindingAbsent =
                bindingParserNodeIndex == -1 &&
                bindingProducerSourceIndex == -1 &&
                bindingDeclarationSourceLocalRow == -1 &&
                bindingPatternSourceLocalRow == -1 &&
                bindingValueDefinitionRow == -1
            var bindingParserSourceLocalNodeRow: int32 = -1
            if bindingAbsent:
                if originProducerNodeId >= 0 &&
                   (opKind == Int32(texpr.TypedExprIrOpParamRef) ||
                    opKind == Int32(texpr.TypedExprIrOpLocalRef)):
                    err = " compiler snapshot builder: source-backed reference binding identity missing"
                    return false
            else:
                if (opKind != Int32(texpr.TypedExprIrOpParamRef) &&
                    opKind != Int32(texpr.TypedExprIrOpLocalRef)) ||
                   bindingParserNodeIndex < 0 ||
                   bindingProducerSourceIndex != producerSourceIndex ||
                   bindingDeclarationSourceLocalRow < 0 ||
                   originProducerNodeId < 0 ||
                   bindingProducerSourceIndex >=
                       csg.parserNormalizedExprReceipt.sourceSidecars.len:
                    err = " compiler snapshot builder: typed binding identity invalid"
                    return false
                let bindingSidecar =
                    csg.parserNormalizedExprReceipt.sourceSidecars[
                        bindingProducerSourceIndex]
                if bindingSidecar.sourceIndex !=
                       bindingProducerSourceIndex ||
                   originProducerNodeId >=
                       bindingSidecar.nodeProducerIds.len ||
                   bindingDeclarationSourceLocalRow >=
                       bindingSidecar.declarationKinds.len ||
                   bindingSidecar.declarationSourceLocalRows[
                       bindingDeclarationSourceLocalRow] !=
                       bindingDeclarationSourceLocalRow:
                    err = " compiler snapshot builder: typed binding parser coordinate missing"
                    return false
                bindingParserSourceLocalNodeRow =
                    originProducerNodeId
                if opKind == Int32(texpr.TypedExprIrOpParamRef):
                    if tables.parserNodes.bindingResolutionKinds[
                           originParserNodeId] !=
                           snapshot_schema.CsgCompilerParserBindingResolutionParameter ||
                       tables.parserNodes.bindingDeclarationSourceLocalRows[
                           originParserNodeId] !=
                           bindingDeclarationSourceLocalRow ||
                       tables.parserNodes.bindingPatternSourceLocalRows[
                           originParserNodeId] != -1 ||
                       bindingSidecar.declarationKinds[
                           bindingDeclarationSourceLocalRow] !=
                           Int32(parser.ParserDeclarationParameter) ||
                       bindingPatternSourceLocalRow != -1 ||
                       bindingValueDefinitionRow < 0 ||
                       bindingValueDefinitionRow >=
                           texpr.TypedExprValueDefinitionAuthorityCount(
                               csg.typedIr) ||
                       arenamod.ArenaArrayInt32Get(
                           csg.typedIr.arena,
                           csg.typedIr.valueDefinitions_originKinds,
                           bindingValueDefinitionRow) !=
                           Int32(
                               texpr.TypedExprValueDefinitionOriginParameter):
                        err = " compiler snapshot builder: ParamRef binding identity invalid"
                        return false
                else:
                    let definitionCount =
                        texpr.TypedExprValueDefinitionAuthorityCount(
                            csg.typedIr)
                    if tables.parserNodes.bindingResolutionKinds[
                           originParserNodeId] !=
                           snapshot_schema.CsgCompilerParserBindingResolutionPattern ||
                       tables.parserNodes.bindingDeclarationSourceLocalRows[
                           originParserNodeId] !=
                           bindingDeclarationSourceLocalRow ||
                       tables.parserNodes.bindingPatternSourceLocalRows[
                           originParserNodeId] !=
                           bindingPatternSourceLocalRow ||
                       bindingSidecar.declarationKinds[
                           bindingDeclarationSourceLocalRow] !=
                           Int32(parser.ParserDeclarationLocal) ||
                       bindingPatternSourceLocalRow < 0 ||
                       bindingPatternSourceLocalRow >=
                           bindingSidecar.patternSourceLocalRows.len ||
                       bindingSidecar.patternSourceLocalRows[
                           bindingPatternSourceLocalRow] !=
                           bindingPatternSourceLocalRow ||
                       bindingSidecar.patternBindingDeclarationIds[
                           bindingPatternSourceLocalRow] !=
                           bindingDeclarationSourceLocalRow ||
                       bindingValueDefinitionRow < 0 ||
                       bindingValueDefinitionRow >= definitionCount ||
                       texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                           csg.typedIr,
                           bindingValueDefinitionRow) !=
                           bindingProducerSourceIndex ||
                       texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                           csg.typedIr,
                           bindingValueDefinitionRow) !=
                           bindingDeclarationSourceLocalRow ||
                       texpr.TypedExprValueDefinitionPatternSourceLocalRowAt(
                           csg.typedIr,
                           bindingValueDefinitionRow) !=
                           bindingPatternSourceLocalRow:
                        err = " compiler snapshot builder: LocalRef binding identity drift"
                        return false
            let snapshotRow = tables.typedNodes.functionIds.len
            let producerOwnerStatementIndex =
                texpr.TypedExprIrNodeOwnerStatementIndexAt(
                    csg.typedIr, nodePosition)
            var ownerStatementId: int32 = -1
            if producerOwnerStatementIndex >= 0:
                if producerOwnerStatementIndex < producerStatementStart ||
                   producerOwnerStatementIndex >=
                       producerStatementStart + producerStatementCount:
                    err = " compiler snapshot builder: typed node owner escapes function statement CSR"
                    return false
                ownerStatementId =
                    statementSnapshotStart +
                        producerOwnerStatementIndex -
                        producerStatementStart
            let operand0 = compilerSnapshotBuilderOperandRow(
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_operand0NodeIndexs,
                    nodePosition),
                snapshotRowByProducerNode, functionStart, snapshotRow)
            let operand1 = compilerSnapshotBuilderOperandRow(
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_operand1NodeIndexs,
                    nodePosition),
                snapshotRowByProducerNode, functionStart, snapshotRow)
            let operand2 = compilerSnapshotBuilderOperandRow(
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.nodes2_operand2NodeIndexs,
                    nodePosition),
                snapshotRowByProducerNode, functionStart, snapshotRow)
            if ownershipKind == 0 || opKind <= 0 ||
               operand0 == -2 || operand1 == -2 || operand2 == -2:
                err = " compiler snapshot builder: typed node immutable fact missing"
                return false
            add(tables.typedNodes.typedIrNodeIndexes, producerNodeId)
            add(tables.typedNodes.bindingProducerSourceIndexes,
                bindingProducerSourceIndex)
            add(tables.typedNodes.bindingParserSourceLocalNodeRows,
                bindingParserSourceLocalNodeRow)
            add(tables.typedNodes.bindingDeclarationSourceLocalRows,
                bindingDeclarationSourceLocalRow)
            add(tables.typedNodes.bindingPatternSourceLocalRows,
                bindingPatternSourceLocalRow)
            add(tables.typedNodes.bindingValueDefinitionRows,
                bindingValueDefinitionRow)
            add(tables.typedNodes.producedValueDefinitionRows,
                producedValueDefinitionRow)
            add(tables.typedNodes.ownerStatementIds, ownerStatementId)
            add(tables.typedNodes.originParserNodeIds, originParserNodeId)
            add(tables.typedNodes.syntheticOriginKinds, syntheticOriginKind)
            add(tables.typedNodes.spanAuthorityKinds, spanAuthorityKind)
            add(tables.typedNodes.functionIds, functionId)
            add(tables.typedNodes.opKinds, opKind)
            # Type/value/trait proof columns are staged only until the
            # canonical Type table has been sorted and the exact arena TypeId
            # remap is available. Production admission rejects this unsealed
            # state.
            add(tables.typedNodes.typeIds, -1)
            add(tables.typedNodes.valueKinds, 0)
            add(tables.typedNodes.captureStarts,
                tables.typedNodes.captureValueDefinitionRows.len)
            add(tables.typedNodes.captureCounts, 0)
            add(tables.typedNodes.ownershipKinds, ownershipKind)
            add(tables.typedNodes.ownershipProofKinds, 0)
            add(tables.typedNodes.ownershipProofCids, layout.FixedBytes32())
            add(tables.typedNodes.sendConclusions, false)
            add(tables.typedNodes.sendProofKinds, 0)
            add(tables.typedNodes.sendProofCids, layout.FixedBytes32())
            add(tables.typedNodes.syncProofKinds, 0)
            add(tables.typedNodes.syncProofCids, layout.FixedBytes32())
            add(tables.typedNodes.syncConclusions, false)
            add(tables.typedNodes.shareKinds, 0)
            add(tables.typedNodes.shareProofCids, layout.FixedBytes32())
            add(tables.typedNodes.spanIds, spanId)
            add(tables.typedNodes.operand0NodeIds, operand0)
            add(tables.typedNodes.operand1NodeIds, operand1)
            add(tables.typedNodes.operand2NodeIds, operand2)
            add(tables.debugOps.typedNodeIds, snapshotRow)
            add(tables.debugOps.functionIds, functionId)
            add(tables.debugOps.spanIds, spanId)
            add(tables.debugOps.symbolIds,
                tables.functions.symbolIds[functionId])
            add(tables.debugOps.opKinds, opKind)
            snapshotRowByProducerNode[producerNodeId] = snapshotRow
        for localStatement in 0..<producerStatementCount:
            let producerStatementIndex =
                producerStatementStart + localStatement
            let statementId = statementSnapshotStart + localStatement
            let rootStart =
                tables.typedStatements.rootTypedNodeIds.len
            tables.typedStatements.rootStarts[statementId] = rootStart
            # Statement roots must be TypedIR node indexes. valueExprRoot /
            # valueExprCall are parser-forest rows and must not be treated as
            # TypedIR identities (ownerStatementIds would drift onto a
            # different statement's node).
            if !compilerSnapshotBuilderTypedStatementRootAppendInto(
                   tables, csg, snapshotRowByProducerNode,
                   statementId,
                   arenamod.ArenaArrayInt32Get(
                       csg.typedIr.arena,
                       csg.typedIr.statements2_rhsNodeIndexs,
                       producerStatementIndex),
                   err) ||
               !compilerSnapshotBuilderTypedStatementRootAppendInto(
                   tables, csg, snapshotRowByProducerNode,
                   statementId,
                   arenamod.ArenaArrayInt32Get(
                       csg.typedIr.arena,
                       csg.typedIr.statements2_callArgNodeStarts,
                       producerStatementIndex),
                   err) ||
               !compilerSnapshotBuilderTypedStatementRootAppendInto(
                   tables, csg, snapshotRowByProducerNode,
                   statementId,
                   arenamod.ArenaArrayInt32Get(
                       csg.typedIr.arena,
                       csg.typedIr.statements2_forStartNodeIndexs,
                       producerStatementIndex),
                   err) ||
               !compilerSnapshotBuilderTypedStatementRootAppendInto(
                   tables, csg, snapshotRowByProducerNode,
                   statementId,
                   arenamod.ArenaArrayInt32Get(
                       csg.typedIr.arena,
                       csg.typedIr.statements2_assignLvalueNodeIndexs,
                       producerStatementIndex),
                   err) ||
               !compilerSnapshotBuilderTypedStatementRootAppendInto(
                   tables, csg, snapshotRowByProducerNode,
                   statementId,
                   arenamod.ArenaArrayInt32Get(
                       csg.typedIr.arena,
                       csg.typedIr.statements2_assignIndexNodeIndexs,
                       producerStatementIndex),
                   err):
                return false
            tables.typedStatements.rootCounts[statementId] =
                tables.typedStatements.rootTypedNodeIds.len - rootStart
    for producerNodeId in 0..<totalNodeCount:
        if snapshotRowByProducerNode[producerNodeId] < 0:
            err = " compiler snapshot builder: typed node producer coverage incomplete"
            return false
    if tables.typedStatements.typedIrStatementIndexes.len !=
           csg.typedIr.statements2_statementIndexs.len:
        err = " compiler snapshot builder: typed statement producer coverage incomplete"
        return false
    var functionIdByTypedFunctionIndex: int32[]
    setLen(
        functionIdByTypedFunctionIndex,
        csg.typedIr.functions2_functionNameIds.len)
    for typedFunctionIndex in 0..<functionIdByTypedFunctionIndex.len:
        functionIdByTypedFunctionIndex[typedFunctionIndex] = -1
    for functionId in 0..<tables.functions.typedFunctionIndexes.len:
        let typedFunctionIndex =
            tables.functions.typedFunctionIndexes[functionId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= functionIdByTypedFunctionIndex.len ||
           functionIdByTypedFunctionIndex[typedFunctionIndex] >= 0:
            err = " compiler snapshot builder: value-definition function identity invalid"
            return false
        functionIdByTypedFunctionIndex[typedFunctionIndex] = functionId
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr)
    let groupCount =
        texpr.TypedExprValueDefinitionGroupAuthorityCount(csg.typedIr)
    for groupRow in 0..<groupCount:
        let typedFunctionIndex = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.valueDefinitionGroups_typedFunctionIndexes,
            groupRow)
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= functionIdByTypedFunctionIndex.len ||
           functionIdByTypedFunctionIndex[typedFunctionIndex] < 0:
            err = " compiler snapshot builder: value-definition group function missing"
            return false
        add(tables.valueDefinitionGroups.producerSourceIndexes,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_producerSourceIndexes,
                groupRow))
        add(tables.valueDefinitionGroups.parserProducerSourceIndexes,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_parserProducerSourceIndexes,
                groupRow))
        add(tables.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
                groupRow))
        add(tables.valueDefinitionGroups.bindingOffsets,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_bindingOffsets,
                groupRow))
        add(tables.valueDefinitionGroups.bindingCounts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_bindingCounts,
                groupRow))
        add(tables.valueDefinitionGroups.functionIds,
            functionIdByTypedFunctionIndex[typedFunctionIndex])
        add(tables.valueDefinitionGroups.declarationSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_declarationSourceLocalRows,
                groupRow))
        add(tables.valueDefinitionGroups.patternSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_patternSourceLocalRows,
                groupRow))
        add(tables.valueDefinitionGroups.definitionRows,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_definitionRows,
                groupRow))
        add(tables.valueDefinitionGroups.consumedFlags,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitionGroups_consumedFlags,
                groupRow))
    for definitionRow in 0..<definitionCount:
        let typedFunctionIndex =
            texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
                csg.typedIr, definitionRow)
        let definingNodePosition =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                csg.typedIr, definitionRow)
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= functionIdByTypedFunctionIndex.len ||
           functionIdByTypedFunctionIndex[typedFunctionIndex] < 0 ||
           definingNodePosition < 0 ||
           definingNodePosition >= totalNodeCount:
            err = " compiler snapshot builder: value-definition owner identity missing"
            return false
        let definingProducerNodeId =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_nodeIndexs,
                definingNodePosition)
        if definingProducerNodeId < 0 ||
           definingProducerNodeId >= snapshotRowByProducerNode.len ||
           snapshotRowByProducerNode[definingProducerNodeId] < 0:
            err = " compiler snapshot builder: value-definition defining node missing"
            return false
        add(tables.valueDefinitions.originKinds,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitions_originKinds,
                definitionRow))
        add(tables.valueDefinitions.groupRows,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitions_groupRows,
                definitionRow))
        add(tables.valueDefinitions.producerSourceIndexes,
            texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                csg.typedIr, definitionRow))
        add(tables.valueDefinitions.sourceLocalNodeIndexes,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.valueDefinitions_sourceLocalNodeIndexes,
                definitionRow))
        add(tables.valueDefinitions.declarationSourceLocalRows,
            texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                csg.typedIr, definitionRow))
        add(tables.valueDefinitions.patternSourceLocalRows,
            texpr.TypedExprValueDefinitionPatternSourceLocalRowAt(
                csg.typedIr, definitionRow))
        add(tables.valueDefinitions.functionIds,
            functionIdByTypedFunctionIndex[typedFunctionIndex])
        add(tables.valueDefinitions.definingTypedNodeIds,
            snapshotRowByProducerNode[definingProducerNodeId])
        add(tables.valueDefinitions.typeIds, -1)
        add(tables.valueDefinitions.ownershipKinds,
            compilerSnapshotBuilderOwnershipKind(
                texpr.TypedExprValueDefinitionOwnershipAt(
                    csg.typedIr, definitionRow)))
        add(tables.valueDefinitions.proofKinds,
            texpr.TypedExprValueDefinitionProofKindAt(
                csg.typedIr, definitionRow))
        let definingSnapshotNodeId =
            snapshotRowByProducerNode[definingProducerNodeId]
        if definingSnapshotNodeId < 0 ||
           definingSnapshotNodeId >=
               tables.typedNodes.producedValueDefinitionRows.len ||
           tables.typedNodes.producedValueDefinitionRows[
               definingSnapshotNodeId] != definitionRow:
            err = " compiler snapshot builder: value-definition producer edge drift"
            return false
    return true

@borrows
fn compilerSnapshotBuilderModuleDeclKeysInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        keys: var layout.FixedBytes32[],
        err: var str): bool =
    keys = []
    let sourceCount = tables.sources.documentCids.len
    if sourceCount <= 0 ||
       sourceCount != tables.sources.modulePathTextIds.len:
        err = " compiler snapshot builder: module declaration source shape invalid"
        return false
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    var candidateBySource: int32[]
    setLen(candidateBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        let moduleTextId = tables.sources.modulePathTextIds[sourceId]
        if moduleTextId < 0 || moduleTextId >= tables.texts.len:
            err = " compiler snapshot builder: module declaration path missing"
            return false
        let modulePath = tables.texts[moduleTextId]
        let documentCid = tables.sources.documentCids[sourceId]
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId, modulePath, documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               modulePath, documentCid, documentCid,
               layout.FixedBytes32(), 0, 0,
               candidateIndex, err):
            return false
        candidateBySource[sourceId] = candidateIndex
    var sealed: declaration.SemanticSnapshotDeclarationTable
    defer:
        declaration.SemanticSnapshotDeclarationTableReleaseInto(sealed)
    var mapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    if !declaration.SemanticSnapshotDeclarationTableSealInto(
           store, sealed, mapping, err) ||
       mapping.producerCandidateDeclKeyCids.len != sourceCount:
        if err == "":
            err = " compiler snapshot builder: module declaration key seal failed"
        return false
    setLen(keys, sourceCount)
    for sourceId in 0..<sourceCount:
        let candidateIndex = candidateBySource[sourceId]
        if candidateIndex < 0 ||
           candidateIndex >=
               mapping.producerCandidateDeclKeyCids.len:
            err = " compiler snapshot builder: module declaration key mapping missing"
            return false
        keys[sourceId] =
            mapping.producerCandidateDeclKeyCids[candidateIndex]
    return true

@borrows
fn compilerSnapshotBuilderAppendModuleSymbolsInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let declarationCount = tables.parserSidecars.declarationKinds.len
    if declarationCount !=
           tables.parserSidecars.declarationProducerSourceIds.len ||
       declarationCount !=
           tables.parserSidecars.declarationSourceLocalRows.len ||
       declarationCount !=
           tables.parserSidecars.declarationNameTokenIds.len ||
       declarationCount !=
           tables.parserSidecars.declarationOwnerIds.len ||
       declarationCount !=
           tables.parserSidecars.declarationLexicalScopeIds.len ||
       declarationCount !=
           tables.parserSidecars.declarationFunctionRows.len ||
       declarationCount !=
           tables.parserSidecars.declarationTypeSyntaxRootIds.len ||
       declarationCount !=
           tables.parserSidecars.declarationDefaultStatementRootRows.len ||
       declarationCount !=
           tables.parserSidecars.declarationSpanIds.len ||
       declarationCount !=
           tables.parserSidecars.declarationNameSpanIds.len ||
       declarationCount !=
           tables.parserSidecars.declarationMutableFlags.len ||
       declarationCount !=
           tables.parserSidecars.declarationExportedFlags.len:
        err = " compiler snapshot builder: module parser declaration columns mismatch"
        return false
    var moduleKeys: layout.FixedBytes32[]
    if !compilerSnapshotBuilderModuleDeclKeysInto(
           tables, csg, moduleKeys, err):
        return false
    let sourceCount = tables.sources.documentCids.len
    var moduleSymbolBySource: int32[]
    setLen(moduleSymbolBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        var moduleDeclaration: int32 = -1
        for declarationRow in 0..<declarationCount:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   declaration.SemanticSnapshotDeclarationKindModule ||
               tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] != sourceId:
                continue
            if moduleDeclaration >= 0:
                err = " compiler snapshot builder: duplicate module declaration authority"
                return false
            moduleDeclaration = declarationRow
        let modulePathTextId =
            tables.sources.modulePathTextIds[sourceId]
        if modulePathTextId < 0 ||
           modulePathTextId >= tables.texts.len:
            err = " compiler snapshot builder: module path text missing"
            return false
        var nameTextId = modulePathTextId
        var nameSpanId: int32 = -1
        var nameTokenId: int32 = -1
        var declarationSpanId: int32 = -1
        var exported = false
        if moduleDeclaration >= 0:
            nameTokenId =
                tables.parserSidecars.declarationNameTokenIds[
                    moduleDeclaration]
            nameSpanId =
                tables.parserSidecars.declarationNameSpanIds[
                    moduleDeclaration]
            declarationSpanId =
                tables.parserSidecars.declarationSpanIds[
                    moduleDeclaration]
            if nameTokenId < 0 ||
               nameTokenId >= tables.tokens.spanIds.len ||
               nameTokenId >= tables.tokens.sourceIds.len ||
               nameTokenId >= tables.tokens.valueTextIds.len ||
               nameSpanId < 0 ||
               nameSpanId >= tables.spans.sourceIds.len ||
               declarationSpanId < 0 ||
               declarationSpanId >= tables.spans.sourceIds.len ||
               tables.tokens.sourceIds[nameTokenId] != sourceId ||
               tables.tokens.spanIds[nameTokenId] != nameSpanId ||
               tables.spans.sourceIds[nameSpanId] != sourceId ||
               tables.spans.sourceIds[declarationSpanId] != sourceId ||
               tables.spans.startBytes[nameSpanId] >=
                   tables.spans.endBytes[nameSpanId] ||
               tables.spans.startBytes[declarationSpanId] >=
                   tables.spans.endBytes[declarationSpanId] ||
               tables.spans.startBytes[nameSpanId] <
                   tables.spans.startBytes[declarationSpanId] ||
               tables.spans.endBytes[nameSpanId] >
                   tables.spans.endBytes[declarationSpanId]:
                err = " compiler snapshot builder: explicit module coordinate authority drift"
                return false
            nameTextId = tables.tokens.valueTextIds[nameTokenId]
            if nameTextId < 0 || nameTextId >= tables.texts.len:
                err = " compiler snapshot builder: explicit module name text missing"
                return false
            exported =
                tables.parserSidecars.declarationExportedFlags[
                    moduleDeclaration]
        let symbolId = tables.symbols.symbolCids.len
        moduleSymbolBySource[sourceId] = symbolId
        add(tables.symbols.symbolCids, moduleKeys[sourceId])
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            moduleKeys[sourceId])
        add(tables.symbols.declarationPathCids,
            moduleKeys[sourceId])
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, modulePathTextId)
        add(tables.symbols.symbolKinds, snapshot_schema.CsgCompilerSymbolModule)
        add(tables.symbols.typeIds, -1)
        add(tables.symbols.declarationSpanIds, declarationSpanId)
        add(tables.symbols.ownerSymbolIds, -1)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, -1)
        add(tables.symbols.exportedFlags, exported)
        add(tables.symbols.genericConstraintStarts,
            tables.symbols.genericConstraintTypeIds.len)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
        if !snapshot_schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               tables, symbolId, err):
            return false
        var interfaceCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerSymbolInterfaceCidInto(
               tables, symbolId, interfaceCid, err):
            return false
        tables.symbols.interfaceCids[symbolId] = interfaceCid
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        if symbolId < 0 || symbolId >= tables.symbols.sourceIds.len:
            err = " compiler snapshot builder: function owner Symbol binding invalid"
            return false
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= moduleSymbolBySource.len:
            err = " compiler snapshot builder: function owner source invalid"
            return false
        tables.symbols.ownerSymbolIds[symbolId] =
            moduleSymbolBySource[sourceId]
    return true

fn compilerSnapshotBuilderProjectionSymbolsCanonicalizeInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    let symbolCount = tables.symbols.symbolCids.len
    var order: int32[]
    setLen(order, symbolCount)
    for symbolId in 0..<symbolCount:
        order[symbolId] = symbolId
    for row in 1..<order.len:
        let symbolId = order[row]
        var cursor = row
        while cursor > 0 && compilerSnapshotBuilderCidLess(
               tables.symbols.symbolCids[symbolId],
               tables.symbols.symbolCids[order[cursor - 1]]):
            order[cursor] = order[cursor - 1]
            cursor = cursor - 1
        order[cursor] = symbolId
    for row in 1..<order.len:
        if layout.FixedBytes32Equal(
               tables.symbols.symbolCids[order[row - 1]],
               tables.symbols.symbolCids[order[row]]):
            err = " compiler snapshot builder: duplicate projected Symbol identity"
            return false
    var newByOld: int32[]
    setLen(newByOld, symbolCount)
    for newSymbolId in 0..<order.len:
        newByOld[order[newSymbolId]] = newSymbolId
    var canonical: snapshot_schema.CsgCompilerSymbolTable
    for newSymbolId in 0..<order.len:
        let oldSymbolId = order[newSymbolId]
        let ownerSymbolId = tables.symbols.ownerSymbolIds[oldSymbolId]
        if ownerSymbolId < -1 || ownerSymbolId >= symbolCount:
            err = " compiler snapshot builder: projected Symbol owner invalid"
            return false
        add(canonical.symbolCids,
            tables.symbols.symbolCids[oldSymbolId])
        add(canonical.interfaceCids,
            tables.symbols.interfaceCids[oldSymbolId])
        add(canonical.declIds, tables.symbols.declIds[oldSymbolId])
        add(canonical.declKeyCids,
            tables.symbols.declKeyCids[oldSymbolId])
        add(canonical.declarationHeaderCids,
            tables.symbols.declarationHeaderCids[oldSymbolId])
        add(canonical.declarationPathCids,
            tables.symbols.declarationPathCids[oldSymbolId])
        add(canonical.sourceIds, tables.symbols.sourceIds[oldSymbolId])
        add(canonical.nameTextIds,
            tables.symbols.nameTextIds[oldSymbolId])
        add(canonical.nameSpanIds,
            tables.symbols.nameSpanIds[oldSymbolId])
        add(canonical.nameTokenIds,
            tables.symbols.nameTokenIds[oldSymbolId])
        add(canonical.qualifiedNameTextIds,
            tables.symbols.qualifiedNameTextIds[oldSymbolId])
        add(canonical.symbolKinds,
            tables.symbols.symbolKinds[oldSymbolId])
        add(canonical.typeIds, tables.symbols.typeIds[oldSymbolId])
        add(canonical.declarationSpanIds,
            tables.symbols.declarationSpanIds[oldSymbolId])
        add(canonical.ownerSymbolIds,
            ownerSymbolId < 0 ? -1 : newByOld[ownerSymbolId])
        add(canonical.functionIds,
            tables.symbols.functionIds[oldSymbolId])
        add(canonical.externFunctionIds,
            tables.symbols.externFunctionIds[oldSymbolId])
        add(canonical.exportedFlags,
            tables.symbols.exportedFlags[oldSymbolId])
        let constraintStart =
            tables.symbols.genericConstraintStarts[oldSymbolId]
        let constraintCount =
            tables.symbols.genericConstraintCounts[oldSymbolId]
        if constraintStart < 0 || constraintCount < 0 ||
           constraintStart >
               tables.symbols.genericConstraintTypeIds.len ||
           constraintCount >
               tables.symbols.genericConstraintTypeIds.len -
                   constraintStart:
            err = " compiler snapshot builder: projected Symbol constraints invalid"
            return false
        add(canonical.genericConstraintStarts,
            canonical.genericConstraintTypeIds.len)
        add(canonical.genericConstraintCounts, constraintCount)
        add(canonical.genericParameterParserRows,
            tables.symbols.genericParameterParserRows[oldSymbolId])
        add(canonical.genericParameterOrdinals,
            tables.symbols.genericParameterOrdinals[oldSymbolId])
        add(canonical.genericParameterDefaultTypeIds,
            tables.symbols.genericParameterDefaultTypeIds[oldSymbolId])
        for offset in 0..<constraintCount:
            add(canonical.genericConstraintTypeIds,
                tables.symbols.genericConstraintTypeIds[
                    constraintStart + offset])
    for functionId in 0..<tables.functions.symbolIds.len:
        let oldSymbolId = tables.functions.symbolIds[functionId]
        if oldSymbolId < 0 || oldSymbolId >= symbolCount:
            err = " compiler snapshot builder: projected function SymbolId invalid"
            return false
        tables.functions.symbolIds[functionId] = newByOld[oldSymbolId]
    for externFunctionId in 0..<tables.externFunctions.symbolIds.len:
        let oldSymbolId =
            tables.externFunctions.symbolIds[externFunctionId]
        if oldSymbolId < 0 || oldSymbolId >= symbolCount:
            err = " compiler snapshot builder: projected extern SymbolId invalid"
            return false
        tables.externFunctions.symbolIds[externFunctionId] =
            newByOld[oldSymbolId]
    var externOrder: int32[]
    setLen(externOrder, tables.externFunctions.symbolIds.len)
    for row in 0..<externOrder.len:
        externOrder[row] = row
    for row in 1..<externOrder.len:
        let externFunctionId = externOrder[row]
        var cursor = row
        while cursor > 0 &&
              tables.externFunctions.symbolIds[externFunctionId] <
                  tables.externFunctions.symbolIds[
                      externOrder[cursor - 1]]:
            externOrder[cursor] = externOrder[cursor - 1]
            cursor = cursor - 1
        externOrder[cursor] = externFunctionId
    var canonicalExternFunctions: snapshot_schema.CsgCompilerExternFunctionTable
    for newExternFunctionId in 0..<externOrder.len:
        let oldExternFunctionId =
            externOrder[newExternFunctionId]
        let symbolId =
            tables.externFunctions.symbolIds[oldExternFunctionId]
        add(canonicalExternFunctions.symbolIds, symbolId)
        add(canonicalExternFunctions.parserDeclarationRows,
            tables.externFunctions.parserDeclarationRows[
                oldExternFunctionId])
        add(canonicalExternFunctions.typeIds,
            tables.externFunctions.typeIds[oldExternFunctionId])
        add(canonicalExternFunctions.externalNameTextIds,
            tables.externFunctions.externalNameTextIds[
                oldExternFunctionId])
        add(canonicalExternFunctions.abiKinds,
            tables.externFunctions.abiKinds[oldExternFunctionId])
        add(canonicalExternFunctions.importAnnotationRows,
            tables.externFunctions.importAnnotationRows[
                oldExternFunctionId])
        add(canonicalExternFunctions.interfaceCids,
            tables.externFunctions.interfaceCids[
                oldExternFunctionId])
        canonical.externFunctionIds[symbolId] =
            newExternFunctionId
    tables.externFunctions = canonicalExternFunctions
    tables.symbols = canonical
    return true

fn compilerSnapshotBuilderModuleFunctionOwnersValidateInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let functionCount = tables.functions.symbolIds.len
    let externFunctionCount = tables.externFunctions.symbolIds.len
    let callableCount = functionCount + externFunctionCount
    let symbolCount = tables.symbols.symbolCids.len
    if sourceCount <= 0 ||
       functionCount > 2147483647 - sourceCount ||
       externFunctionCount >
           2147483647 - sourceCount - functionCount ||
       symbolCount != callableCount + sourceCount:
        err = " compiler snapshot builder: Module/Function Symbol domain invalid"
        return false
    var moduleSymbolBySource: int32[]
    setLen(moduleSymbolBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        moduleSymbolBySource[sourceId] = -1
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolModule:
            continue
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount ||
           moduleSymbolBySource[sourceId] >= 0 ||
           tables.symbols.ownerSymbolIds[symbolId] != -1 ||
           tables.symbols.typeIds[symbolId] != -1 ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] != -1:
            err = " compiler snapshot builder: Module Symbol owner binding invalid"
            return false
        moduleSymbolBySource[sourceId] = symbolId
    for sourceId in 0..<sourceCount:
        if moduleSymbolBySource[sourceId] < 0:
            err = " compiler snapshot builder: Module Symbol owner binding missing"
            return false
    for functionId in 0..<functionCount:
        let symbolId = tables.functions.symbolIds[functionId]
        if symbolId < 0 || symbolId >= symbolCount ||
           tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction ||
           tables.symbols.functionIds[symbolId] != functionId:
            err = " compiler snapshot builder: Function Symbol subset binding invalid"
            return false
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount ||
           tables.symbols.ownerSymbolIds[symbolId] !=
               moduleSymbolBySource[sourceId]:
            err = " compiler snapshot builder: Function Module owner binding invalid"
            return false
    for externFunctionId in 0..<externFunctionCount:
        let symbolId =
            tables.externFunctions.symbolIds[externFunctionId]
        if symbolId < 0 || symbolId >= symbolCount ||
           tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] !=
               externFunctionId:
            err = " compiler snapshot builder: extern Function Symbol subset binding invalid"
            return false
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount ||
           tables.symbols.ownerSymbolIds[symbolId] !=
               moduleSymbolBySource[sourceId]:
            err = " compiler snapshot builder: extern Function Module owner binding invalid"
            return false
    return true

# Commits the exact retained inspection projection.  Every row is derived from
# retained graph, TypedIR, parser-sidecar and prebuild columns; any drift
# between two producer authorities hard-fails.  Parser declaration header/path
# CIDs are copied from the retained sidecar only after the exact
# parser-row/reachable-function/graph-symbol join succeeds.  Symbol/interface
# CIDs remain explicitly uncertified until TypeArena SymbolIds are joined to
# graph symbols.  Tables that still lack exact producer columns (references,
# calls, lexical scopes, layouts, dependencies,
# diagnostics and function-symbol type authority) stay empty and are accounted
# in the projection receipt instead of being approximated.
@borrows
fn compilerSnapshotBuilderProjectSymbolFunctionReadTablesInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        prebuildFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalizedReads: incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        err: var str): bool =
    let callableSymbolCount = prebuildFacts.symbolCids.len
    let functionCount = prebuildFacts.functionSymbolIds.len
    if callableSymbolCount != functionCount:
        err = " compiler snapshot builder: callable Symbol/Function domain mismatch"
        return false
    var typedRowByReachable: int32[]
    if !compilerSnapshotBuilderTypedFunctionJoinInto(
            csg, typedRowByReachable, err):
        return false
    # graphNodeId -> reachable row; the reachable shape proof above already
    # rejected duplicate or out-of-range graph node ids.
    var reachableByNode: int32[]
    setLen(reachableByNode, csg.nodes.len + 1)
    for index in 0..<reachableByNode.len:
        reachableByNode[index] = -1
    for reachableRow in 0..<csg.semanticGraph.reachableFunctionTable.graphNodeIds.len:
        reachableByNode[
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[reachableRow]] =
            reachableRow
    # symbolId per graph Symbol node; the prebuild symbol order is the
    # canonical CID-sorted order the snapshot table must keep.
    var nodeBySymbol: int32[]
    setLen(nodeBySymbol, callableSymbolCount)
    for index in 0..<callableSymbolCount:
        nodeBySymbol[index] = -1
    var symbolIdByGraphNode: int32[]
    if !compilerSnapshotBuilderGraphNodeSymbolIdsInto(
            tables, csg, prebuildFacts,
            symbolIdByGraphNode, err):
        return false
    for nodeIndex in 0..<csg.nodes.len:
        if csg.nodes[nodeIndex].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol:
            continue
        let symbolId = symbolIdByGraphNode[csg.nodes[nodeIndex].nodeId]
        if symbolId < 0 || nodeBySymbol[symbolId] >= 0:
            err = " compiler snapshot builder: graph symbol is outside the exact prebuild domain"
            return false
        nodeBySymbol[symbolId] = nodeIndex
    for symbolId in 0..<callableSymbolCount:
        if nodeBySymbol[symbolId] < 0:
            err = " compiler snapshot builder: prebuild symbol is outside the exact graph domain"
            return false
    # Parser functionIndexes is the immutable producer identity. It maps
    # directly to the reachable-function row; names and line numbers are only
    # checked after this exact row has been selected.
    var parserRowByReachable: int32[]
    setLen(parserRowByReachable,
           csg.semanticGraph.reachableFunctionTable.graphNodeIds.len)
    for reachableRow in 0..<parserRowByReachable.len:
        parserRowByReachable[reachableRow] = -1
    let parserFunctionCount = tables.parserSidecars.functionIndexes.len
    for parserRow in 0..<parserFunctionCount:
        let reachableRow = tables.parserSidecars.functionIndexes[parserRow]
        if reachableRow < 0 || reachableRow >= parserRowByReachable.len ||
           parserRowByReachable[reachableRow] >= 0:
            err = " compiler snapshot builder: parser function identity is not bijective"
            return false
        parserRowByReachable[reachableRow] = parserRow
    # Token spans are unique by strict parser-table snapshot_schema.  Build the direct
    # span -> TokenId authority once so symbol projection stays O(tokens +
    # symbols), independent of open-file and declaration order.
    var tokenBySpan: int32[]
    setLen(tokenBySpan, tables.spans.sourceIds.len)
    for spanId in 0..<tokenBySpan.len:
        tokenBySpan[spanId] = -1
    for tokenId in 0..<tables.tokens.spanIds.len:
        let tokenSpanId = tables.tokens.spanIds[tokenId]
        if tokenSpanId < 0 || tokenSpanId >= tokenBySpan.len ||
           tokenBySpan[tokenSpanId] >= 0:
            err = " compiler snapshot builder: token span identity is not unique"
            return false
        tokenBySpan[tokenSpanId] = tokenId
    for symbolId in 0..<callableSymbolCount:
        let node = csg.nodes[nodeBySymbol[symbolId]]
        let functionId = compilerSnapshotBuilderFunctionFind(
            prebuildFacts.functionSymbolIds, symbolId)
        let graphNodeId = node.nodeId
        if functionId < 0 || graphNodeId <= 0 ||
           graphNodeId >= reachableByNode.len:
            err = " compiler snapshot builder: graph symbol binding drift"
            return false
        let reachableRow = reachableByNode[graphNodeId]
        if reachableRow < 0 || reachableRow >= typedRowByReachable.len:
            err = " compiler snapshot builder: graph symbol reachable identity missing"
            return false
        let typedRow = typedRowByReachable[reachableRow]
        let parserFunctionRow = parserRowByReachable[reachableRow]
        let producerSourceIndex =
            csg.semanticGraph.reachableFunctionTable.sourceIndex[reachableRow]
        let sourceId = compilerSnapshotBuilderCanonicalSourceForProducer(
            tables, producerSourceIndex)
        if typedRow < 0 || parserFunctionRow < 0 || sourceId < 0 ||
           csg.semanticGraph.reachableFunctionTable.sourceIndex[reachableRow] !=
               producerSourceIndex ||
           csg.semanticGraph.typedIrTable.functionGraphNodeIds[typedRow] !=
               graphNodeId ||
           csg.semanticGraph.typedIrTable.functionSourceIndexes[typedRow] !=
               producerSourceIndex ||
           prebuildFacts.functionSourceIds[functionId] != sourceId:
            err = " compiler snapshot builder: graph symbol reachable binding drift"
            return false
        let nameTextId = compilerSnapshotBuilderTextFind(
            tables.texts, node.factText)
        let qualifiedTextId = compilerSnapshotBuilderTextFind(
            tables.texts, node.symbolText)
        if nameTextId < 0 || qualifiedTextId < 0:
            err = " compiler snapshot builder: symbol text missing from canonical pool"
            return false
        let declarationSpanId =
            tables.parserSidecars.functionDeclarationSpanIds[
                parserFunctionRow]
        let bodySpanId =
            tables.parserSidecars.functionBodySpanIds[parserFunctionRow]
        let nameSpanId =
            tables.parserSidecars.functionNameSpanIds[parserFunctionRow]
        var nameTokenId: int32
        if !compilerSnapshotBuilderFunctionNameOwnerTokenResolveInto(
               tables.spans.startBytes,
               tables.spans.endBytes,
               tables.spans.sourceIds,
               tables.tokens.sourceIds,
               tables.tokens.spanIds,
               tables.tokens.kinds,
               tokenBySpan,
               nameSpanId,
               nameTokenId,
               err):
            return false
        if node.semanticSource !=
               csg.semanticGraph.sourceTable.modulePaths[producerSourceIndex] ||
           tables.texts[
               tables.parserSidecars.functionNameTextIds[
                   parserFunctionRow]] != node.factText ||
           tables.parserSidecars.functionSignatureLineNumbers[
               parserFunctionRow] !=
                   csg.semanticGraph.reachableFunctionTable.startLines[reachableRow] ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           nameTokenId < 0 ||
           tables.tokens.sourceIds[nameTokenId] != sourceId ||
           !layout.FixedBytes32Equal(
               tables.parserSidecars.functionNameProofCids[
                   parserFunctionRow],
               parser_receipt.parserFunctionNameProofCid(
                   tables.parserSidecars.functionNameSurfaceKinds[
                       parserFunctionRow],
                   node.factText)) ||
           tables.spans.sourceIds[bodySpanId] != sourceId ||
           tables.spans.startBytes[bodySpanId] !=
               prebuildFacts.bodyStartBytes[functionId] ||
           tables.spans.endBytes[bodySpanId] !=
               prebuildFacts.bodyEndBytes[functionId]:
            err = " compiler snapshot builder: parser function span binding drift"
            return false
        var fragmentCid: layout.FixedBytes32
        if !compilerSnapshotBuilderFunctionFragmentCidInto(
                csg, typedRow, fragmentCid, err):
            return false
        let resultOwnershipKind =
            compilerSnapshotBuilderOwnershipKind(
                csg.typedIr.functions2_resultExprClasses[typedRow])
        if resultOwnershipKind != snapshot_schema.CsgCompilerOwnershipOwned &&
           resultOwnershipKind != snapshot_schema.CsgCompilerOwnershipBorrowed:
            err = " compiler snapshot builder: Function result ownership producer invalid"
            return false
        add(tables.symbols.symbolCids, prebuildFacts.symbolCids[symbolId])
        add(tables.symbols.interfaceCids,
            prebuildFacts.symbolInterfaceCids[symbolId])
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            tables.parserSidecars.functionDeclarationHeaderCids[
                parserFunctionRow])
        add(tables.symbols.declarationPathCids,
            tables.parserSidecars.functionDeclarationPathCids[
                parserFunctionRow])
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds,
            nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, qualifiedTextId)
        add(tables.symbols.symbolKinds, snapshot_schema.CsgCompilerSymbolFunction)
        add(tables.symbols.typeIds, -1)
        add(tables.symbols.declarationSpanIds, declarationSpanId)
        add(tables.symbols.ownerSymbolIds, -1)
        add(tables.symbols.functionIds, functionId)
        add(tables.symbols.externFunctionIds, -1)
        var parserDeclarationRow: int32 = -1
        for declarationRow in 0..<
                tables.parserSidecars.declarationKinds.len:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction) ||
               tables.parserSidecars.declarationFunctionRows[
                   declarationRow] != parserFunctionRow:
                continue
            if parserDeclarationRow >= 0:
                err = " compiler snapshot builder: function parser declaration ambiguous"
                return false
            parserDeclarationRow = declarationRow
        if parserDeclarationRow < 0:
            err = " compiler snapshot builder: function parser declaration missing"
            return false
        add(tables.symbols.exportedFlags,
            tables.parserSidecars.declarationExportedFlags[
                parserDeclarationRow])
        add(tables.symbols.genericConstraintStarts,
            tables.symbols.genericConstraintTypeIds.len)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
        add(tables.functions.typedFunctionIndexes,
            typedRow)
        add(tables.functions.symbolIds, symbolId)
        add(tables.functions.bodySpanIds, bodySpanId)
        add(tables.functions.bodyContentCids,
            prebuildFacts.bodyContentCids[functionId])
        add(tables.functions.fragmentCids, fragmentCid)
        add(tables.functions.interfaceCids,
            prebuildFacts.functionInterfaceCids[functionId])
        add(tables.functions.annotationFlags,
            tables.parserSidecars.functionAnnotationFlags[
                parserFunctionRow])
        add(tables.functions.manualConsumeTargetParameterSymbolIds, -1)
        add(tables.functions.manualConsumeSourceParameterSymbolIds, -1)
        add(tables.functions.manualConsumeEffectCids,
            layout.FixedBytes32())
        add(tables.functions.resultOwnershipKinds,
            resultOwnershipKind)
        add(tables.functions.parameterOwnershipStarts,
            tables.functions.parameterOwnershipKinds.len)
        add(tables.functions.parameterOwnershipCounts, 0)
        add(tables.functions.valueDefinitionStarts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionStarts,
                typedRow))
        add(tables.functions.valueDefinitionCounts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionCounts,
                typedRow))
        add(tables.functions.valueDefinitionGroupStarts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionGroupStarts,
                typedRow))
        add(tables.functions.valueDefinitionGroupCounts,
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.functions2_valueDefinitionGroupCounts,
                typedRow))
        add(tables.functions.readStarts, finalizedReads.readStarts[functionId])
        add(tables.functions.readCounts, finalizedReads.readCounts[functionId])
        add(tables.functions.readSetPreimageCids,
            finalizedReads.readSetPreimageCids[functionId])
        add(tables.functions.nodeStarts, 0)
        add(tables.functions.nodeCounts, 0)
    if !compilerSnapshotBuilderAppendModuleSymbolsInto(
           tables, csg, err) ||
       !compilerSnapshotBuilderProjectionSymbolsCanonicalizeInto(
           tables, err) ||
       !compilerSnapshotBuilderModuleFunctionOwnersValidateInto(
           tables, err):
        return false
    if !compilerSnapshotBuilderProjectTypedNodesInto(tables, csg, err):
        return false
    # The finalized receipt is the only current read authority. Its forward
    # and reverse columns were built atomically after rebuild producers ended.
    for row in 0..<finalizedReads.readSet.readerFunctionIds.len:
        add(tables.readSet.readerFunctionIds,
            finalizedReads.readSet.readerFunctionIds[row])
        add(tables.readSet.targetDomainKinds,
            finalizedReads.readSet.targetDomainKinds[row])
        add(tables.readSet.targetPortableKeyCids,
            finalizedReads.readSet.targetPortableKeyCids[row])
        add(tables.readSet.observedValueCids,
            finalizedReads.readSet.observedValueCids[row])
    tables.readSet.reverseIndexCid = finalizedReads.readSet.reverseIndexCid
    for targetId in 0..<finalizedReads.readSet.reverseStarts.len:
        add(tables.readSet.reverseTargetDomainKinds,
            finalizedReads.readSet.reverseTargetDomainKinds[targetId])
        add(tables.readSet.reverseTargetPortableKeyCids,
            finalizedReads.readSet.reverseTargetPortableKeyCids[targetId])
        add(tables.readSet.reverseStarts,
            finalizedReads.readSet.reverseStarts[targetId])
        add(tables.readSet.reverseCounts,
            finalizedReads.readSet.reverseCounts[targetId])
    for row in 0..<finalizedReads.readSet.reverseReaderFunctionIds.len:
        add(tables.readSet.reverseReaderFunctionIds,
            finalizedReads.readSet.reverseReaderFunctionIds[row])
        add(tables.readSet.reverseObservedValueCids,
            finalizedReads.readSet.reverseObservedValueCids[row])
        add(tables.readSet.reverseForwardRowIds,
            finalizedReads.readSet.reverseForwardRowIds[row])
    if !snapshot_schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
            tables, err):
        return false
    return snapshot_schema.CsgCompilerSnapshotTypedNodeProjectionTablesStrictValidateInto(
        tables, err)

@borrows
fn compilerSnapshotBuilderTypeProjectionReceiptCid(
        receipt: CompilerSnapshotTypeProjectionReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(320)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler_snapshot.type_projection_receipt")
    compilerSnapshotBuilderHashAppendCid(buf, receipt.sourceBundleCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.parserReceiptCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.retainedFactsCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.typeArenaArtifactCid)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.typeArenaTypeCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.typeArenaSymbolCount)
    compilerSnapshotBuilderHashAppendU32(buf, receipt.projectedTypeCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.projectedFunctionSignatureCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypeArenaProducerCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTargetScalarWidthCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingSchemaKindCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDeclarationIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingDeclarationLayoutCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.firstMissingStage)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.firstMissingTypeId)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.admissionBlocked ? 1 : 0)
    return compilerSnapshotBuilderHashFinish(buf)

fn compilerSnapshotBuilderTypeProjectionFirstMissing(
        receipt: var CompilerSnapshotTypeProjectionReceipt,
        stage: int32,
        typeId: int32) =
    if receipt.firstMissingStage ==
           CompilerSnapshotTypeProjectionStageNone:
        receipt.firstMissingStage = stage
        receipt.firstMissingTypeId = typeId

@borrows
fn compilerSnapshotBuilderTypeProjectionExactLayoutRowByArenaTypeBuildInto(
        csg: ccsg.CompilerCsg,
        out: var int32[],
        err: var str): bool =
    # Index of the exact-layout producer row set keyed by nominal arena
    # TypeId. This is the exact row set the layouts projection consumes
    # (Object/RefObject rows only; every other arena kind is skipped), so a
    # positive entry is precisely the required-layout authority the
    # declaration-layout projection will later join against.
    out = []
    if csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len !=
           csg.layoutDiagnosticCompletions.exactLayoutSizeBytes.len ||
       csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len !=
           csg.layoutDiagnosticCompletions.exactLayoutAlignBytes.len ||
       csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldCounts.len:
        err = " compiler snapshot builder: type projection exact layout authority columns split"
        return false
    setLen(out, csg.typeArena.typeCount)
    for typeId in 0..<out.len:
        out[typeId] = -1
    for row in 0..<csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len:
        let arenaTypeId =
            csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[row]
        if arenaTypeId < 0:
            continue
        if arenaTypeId >= out.len:
            err = " compiler snapshot builder: type projection exact layout authority row invalid"
            return false
        let arenaKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeKinds,
            arenaTypeId)
        if arenaKind !=
               Int32(typearena.TypedExprStructuralTypeObject) &&
           arenaKind !=
               Int32(typearena.TypedExprStructuralTypeRefObject):
            continue
        if out[arenaTypeId] >= 0:
            err = " compiler snapshot builder: type projection duplicate nominal exact layout authority"
            return false
        out[arenaTypeId] = row
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeProjectionDeclarationRootMapBuildInto(
        csg: ccsg.CompilerCsg,
        out: var int32[],
        err: var str): bool =
    # Global TypeSyntax row -> owning nominal Type declaration row. Only
    # ParserDeclarationType rows claim declaration identity; -1 marks an
    # unclaimed row and -2 an ambiguous (duplicate) claim.
    out = []
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    if sidecars.len != csg.typeArena.producerSourceCount:
        err = " compiler snapshot builder: type projection declaration root producer domain split"
        return false
    setLen(out, csg.typeArena.typeSyntaxCount)
    for row in 0..<out.len:
        out[row] = -1
    var typeSyntaxBase: int32
    for producerSource in 0..<sidecars.len:
        let sidecar = sidecars[producerSource]
        if typeSyntaxBase < 0 ||
           typeSyntaxBase > csg.typeArena.typeSyntaxCount ||
           sidecar.typeSyntaxKinds.len >
               csg.typeArena.typeSyntaxCount - typeSyntaxBase ||
           sidecar.declarationKinds.len !=
               sidecar.declarationTypeSyntaxRootIds.len:
            err = " compiler snapshot builder: type projection declaration root sidecar split"
            return false
        for localDeclaration in 0..<sidecar.declarationKinds.len:
            if sidecar.declarationKinds[localDeclaration] !=
                   Int32(parser.ParserDeclarationType):
                continue
            let localRoot =
                sidecar.declarationTypeSyntaxRootIds[localDeclaration]
            if localRoot < 0 ||
               localRoot >= sidecar.typeSyntaxKinds.len:
                continue
            let globalRoot = typeSyntaxBase + localRoot
            if out[globalRoot] != -1:
                out[globalRoot] = -2
                continue
            out[globalRoot] = localDeclaration
        typeSyntaxBase = typeSyntaxBase + sidecar.typeSyntaxKinds.len
    if typeSyntaxBase != csg.typeArena.typeSyntaxCount:
        err = " compiler snapshot builder: type projection declaration root coverage split"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeProjectionNominalHeadJoinInto(
        csg: ccsg.CompilerCsg,
        declarationRowByTypeSyntaxRoot: int32[],
        typeId: int32,
        kind: int32,
        headTypeIdOut: var int32): bool =
    # Exact nominal declaration-identity join (wall w51): arena type row ->
    # declaring Symbol -> declaration root TypeSyntax row -> owning nominal
    # Type declaration row -> TypeSyntax TypeId roundtrip. The generic
    # application wrapper carries its head declaration's Symbol, so the
    # wrapper is peeled to child 0 exactly once and joined through that head
    # (same peel discipline as the Borrow unary-child authority; ref-object
    # application bases are forbidden authority).
    headTypeIdOut = -1
    if typeId < 0 || typeId >= csg.typeArena.typeCount:
        return false
    let arenaSymbolId = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.symbolIds,
        typeId)
    if arenaSymbolId < 0 || arenaSymbolId >= csg.typeArena.symbolCount:
        return false
    let declarationRoot = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.symbolDeclarationRootTypeSyntaxNodeIndexes,
        arenaSymbolId)
    if declarationRoot < 0 ||
       declarationRoot >= declarationRowByTypeSyntaxRoot.len ||
       declarationRowByTypeSyntaxRoot[declarationRoot] < 0:
        return false
    let rootTypeId = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.typeSyntaxTypeIds,
        declarationRoot)
    if kind == Int32(typearena.TypedExprStructuralTypeObject) ||
       kind == Int32(typearena.TypedExprStructuralTypeRefObject) ||
       kind == Int32(typearena.TypedExprStructuralTypeEnum):
        # [phaseB-enum-schema] An enum declaration row joins exactly like a
        # nominal object row: its own Symbol's declaration root TypeSyntax
        # must roundtrip to the same arena TypeId.
        headTypeIdOut = typeId
        return rootTypeId == typeId
    let childStart = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.childStarts,
        typeId)
    let childCount = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.childCounts,
        typeId)
    if childCount < 2 || childStart < 0 ||
       childStart >= csg.typeArena.childTypeIds.len ||
       childCount > csg.typeArena.childTypeIds.len - childStart:
        return false
    let headTypeId = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.childTypeIds,
        childStart)
    if headTypeId < 0 || headTypeId >= typeId:
        return false
    let headKind = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.typeKinds,
        headTypeId)
    if headKind != Int32(typearena.TypedExprStructuralTypeObject):
        return false
    headTypeIdOut = headTypeId
    return rootTypeId == headTypeId

@borrows
fn compilerSnapshotBuilderTypeProjectionAssessInto(
        csg: ccsg.CompilerCsg,
        out: var CompilerSnapshotTypeProjectionReceipt,
        err: var str): bool =
    let emptyReceipt = CompilerSnapshotTypeProjectionReceipt()
    out = emptyReceipt
    out.firstMissingTypeId = -1
    if !compilerSnapshotBuilderGraphStrictValidateInto(csg, err):
        return false
    out.sourceBundleCid = csg.sourceBundleCid
    out.parserReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    let retainedFactsCid = compilerSnapshotBuilderRetainedFactsCid(csg)
    out.retainedFactsCid = retainedFactsCid
    if csg.typeArena == nil:
        out.missingTypeArenaProducerCount = 1
        out.admissionBlocked = true
        compilerSnapshotBuilderTypeProjectionFirstMissing(
            out,
            CompilerSnapshotTypeProjectionStageTypeArenaProducer,
            -1)
        let blockedReceiptCid =
            compilerSnapshotBuilderTypeProjectionReceiptCid(out)
        out.receiptCid = blockedReceiptCid
        err = ""
        return true
    if csg.typeArenaMissingResolutionAuthorityCount != 0 ||
       csg.typeArena.producerSourceCount != csg.sourceSnapshotCount ||
       layout.FixedBytes32Equal(
           csg.typeArena.artifactRaw32, layout.FixedBytes32()):
        err = " compiler snapshot builder: TypeArena producer binding corrupt"
        return false
    if !typearena.TypedExprTypeArenaStrictValidateInto(csg.typeArena, err):
        return false
    out.typeArenaArtifactCid = csg.typeArena.artifactRaw32
    out.typeArenaTypeCount = csg.typeArena.typeCount
    out.typeArenaSymbolCount = csg.typeArena.symbolCount
    var typeProjectionExactLayoutRowByArenaType: int32[]
    if !compilerSnapshotBuilderTypeProjectionExactLayoutRowByArenaTypeBuildInto(
           csg, typeProjectionExactLayoutRowByArenaType, err):
        return false
    var typeProjectionDeclarationRowByTypeSyntaxRoot: int32[]
    if !compilerSnapshotBuilderTypeProjectionDeclarationRootMapBuildInto(
           csg, typeProjectionDeclarationRowByTypeSyntaxRoot, err):
        return false
    for typeId in 0..<csg.typeArena.typeCount:
        let kind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena, csg.typeArena.typeKinds, typeId)
        if kind == Int32(typearena.TypedExprStructuralTypeScalar):
            let scalarKind = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.scalarKinds,
                typeId)
            if scalarKind ==
                   Int32(typearena.TypedExprStructuralScalarInt) ||
               scalarKind ==
                   Int32(typearena.TypedExprStructuralScalarUInt):
                out.missingTargetScalarWidthCount =
                    out.missingTargetScalarWidthCount + 1
                compilerSnapshotBuilderTypeProjectionFirstMissing(
                    out,
                    CompilerSnapshotTypeProjectionStageTargetScalarWidth,
                    typeId)
        elif kind == Int32(typearena.TypedExprStructuralTypeBorrow) ||
             kind == Int32(typearena.TypedExprStructuralTypeSequence) ||
             kind == Int32(typearena.TypedExprStructuralTypeFixedArray) ||
             kind == Int32(typearena.TypedExprStructuralTypeAlias) ||
             kind ==
                 Int32(typearena.TypedExprStructuralTypeGenericParameter):
            continue
        elif kind == Int32(typearena.TypedExprStructuralTypeTuple):
            continue
        elif kind == Int32(typearena.TypedExprStructuralTypeObject) ||
             kind == Int32(typearena.TypedExprStructuralTypeRefObject) ||
             kind == Int32(typearena.TypedExprStructuralTypeApply):
            # [builtin-ctor] A builtin-headed application has no declaration
            # to join: its head is child[0]'s Scalar row.  It is admitted by
            # KIND, exactly like Sequence/Optional/GenericParameter above --
            # and it must be, because the nominal exact-layout map this
            # branch joins against is built from Object/RefObject rows only
            # (compiler_snapshot_builder.cheng:13738-13742), so no Scalar
            # head could ever satisfy the join below.
            var builtinApplyHead = false
            if kind == Int32(typearena.TypedExprStructuralTypeApply):
                let builtinApplyHeadTypeId = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.childTypeIds,
                    arenamod.ArenaArrayInt32Get(
                        csg.typeArena.arena,
                        csg.typeArena.childStarts,
                        typeId))
                if builtinApplyHeadTypeId >= 0 &&
                   builtinApplyHeadTypeId < csg.typeArena.typeCount &&
                   arenamod.ArenaArrayInt32Get(
                       csg.typeArena.arena,
                       csg.typeArena.typeKinds,
                       builtinApplyHeadTypeId) ==
                       Int32(typearena.TypedExprStructuralTypeScalar):
                    builtinApplyHead = true
            if builtinApplyHead:
                continue
            # Nominal declaration projection (wall w51). The declaration
            # identity is the declarationRow+Symbol back-reference join; the
            # layout authority is the exact-layout producer row set keyed by
            # the same arena TypeId (the row set the layouts projection
            # consumes). The generic-application wrapper is peeled to its
            # head declaration before both joins. Shapes this projection
            # cannot prove keep counting missing per stage, so genuinely
            # unrepresented forms stay admissionBlocked.
            var nominalHeadTypeId: int32 = -1
            if !compilerSnapshotBuilderTypeProjectionNominalHeadJoinInto(
                   csg,
                   typeProjectionDeclarationRowByTypeSyntaxRoot,
                   typeId,
                   kind,
                   nominalHeadTypeId):
                out.missingDeclarationIdentityCount =
                    out.missingDeclarationIdentityCount + 1
                compilerSnapshotBuilderTypeProjectionFirstMissing(
                    out,
                    CompilerSnapshotTypeProjectionStageDeclarationIdentity,
                    typeId)
            if nominalHeadTypeId < 0 ||
               nominalHeadTypeId >=
                   typeProjectionExactLayoutRowByArenaType.len ||
               typeProjectionExactLayoutRowByArenaType[
                   nominalHeadTypeId] < 0:
                out.missingDeclarationLayoutCount =
                    out.missingDeclarationLayoutCount + 1
                compilerSnapshotBuilderTypeProjectionFirstMissing(
                    out,
                    CompilerSnapshotTypeProjectionStageDeclarationLayout,
                    typeId)
        elif kind == Int32(typearena.TypedExprStructuralTypeEnum):
            # [phaseB-enum-schema] The snapshot schema's CsgCompilerTypeEnum
            # row now carries the exact variant payload CSR (names, ordinals
            # and payload TypeIds), so accepting an enum no longer loses
            # declaration data. The declaration identity join below is the
            # same nominal proof the Object/RefObject projection uses; the
            # declaration-layout stage stays inapplicable because an enum is
            # physically its ordinal scalar and has no composite layout
            # evidence domain (see the required-layout skip above).
            var nominalHeadTypeId: int32 = -1
            if !compilerSnapshotBuilderTypeProjectionNominalHeadJoinInto(
                   csg,
                   typeProjectionDeclarationRowByTypeSyntaxRoot,
                   typeId,
                   kind,
                   nominalHeadTypeId):
                out.missingDeclarationIdentityCount =
                    out.missingDeclarationIdentityCount + 1
                compilerSnapshotBuilderTypeProjectionFirstMissing(
                    out,
                    CompilerSnapshotTypeProjectionStageDeclarationIdentity,
                    typeId)
        else:
            # TypeArena Ref is an owned managed value while schema Reference
            # is an unmanaged address. TypeArena Function is a function value
            # while schema Function is a signature. Neither is coercible.
            # `ptr` is a TypeArena scalar kind and projects to
            # CsgCompilerTypeScalar, so it never reaches this boundary
            # either.
            out.missingSchemaKindCount =
                out.missingSchemaKindCount + 1
            compilerSnapshotBuilderTypeProjectionFirstMissing(
                out,
                CompilerSnapshotTypeProjectionStageSchemaKind,
                typeId)
    out.admissionBlocked =
        out.missingTypeArenaProducerCount != 0 ||
        out.missingTargetScalarWidthCount != 0 ||
        out.missingSchemaKindCount != 0 ||
        out.missingDeclarationIdentityCount != 0 ||
        out.missingDeclarationLayoutCount != 0
    let receiptCid = compilerSnapshotBuilderTypeProjectionReceiptCid(out)
    out.receiptCid = receiptCid
    err = ""
    return true

fn compilerSnapshotBuilderSchemaScalarKind(
        scalarKind: int32): int32 =
    if scalarKind == Int32(typearena.TypedExprStructuralScalarVoid):
        return snapshot_schema.CsgCompilerScalarVoid
    if scalarKind == Int32(typearena.TypedExprStructuralScalarBool):
        return snapshot_schema.CsgCompilerScalarBool
    if scalarKind == Int32(typearena.TypedExprStructuralScalarChar):
        return snapshot_schema.CsgCompilerScalarChar
    if scalarKind == Int32(typearena.TypedExprStructuralScalarInt8):
        return snapshot_schema.CsgCompilerScalarInt8
    if scalarKind == Int32(typearena.TypedExprStructuralScalarUInt8):
        return snapshot_schema.CsgCompilerScalarUInt8
    if scalarKind == Int32(typearena.TypedExprStructuralScalarInt16):
        return snapshot_schema.CsgCompilerScalarInt16
    if scalarKind == Int32(typearena.TypedExprStructuralScalarUInt16):
        return snapshot_schema.CsgCompilerScalarUInt16
    if scalarKind == Int32(typearena.TypedExprStructuralScalarInt32):
        return snapshot_schema.CsgCompilerScalarInt32
    if scalarKind == Int32(typearena.TypedExprStructuralScalarUInt32):
        return snapshot_schema.CsgCompilerScalarUInt32
    if scalarKind == Int32(typearena.TypedExprStructuralScalarInt64):
        return snapshot_schema.CsgCompilerScalarInt64
    if scalarKind == Int32(typearena.TypedExprStructuralScalarUInt64):
        return snapshot_schema.CsgCompilerScalarUInt64
    if scalarKind == Int32(typearena.TypedExprStructuralScalarFloat32):
        return snapshot_schema.CsgCompilerScalarFloat32
    if scalarKind == Int32(typearena.TypedExprStructuralScalarFloat64):
        return snapshot_schema.CsgCompilerScalarFloat64
    if scalarKind == Int32(typearena.TypedExprStructuralScalarStr):
        return snapshot_schema.CsgCompilerScalarStr
    if scalarKind == Int32(typearena.TypedExprStructuralScalarCString):
        return snapshot_schema.CsgCompilerScalarCString
    if scalarKind == Int32(typearena.TypedExprStructuralScalarPtr):
        return snapshot_schema.CsgCompilerScalarPtr
    if scalarKind == Int32(typearena.TypedExprStructuralScalarTypedesc):
        return snapshot_schema.CsgCompilerScalarTypedesc
    if scalarKind == Int32(typearena.TypedExprStructuralScalarSet):
        return snapshot_schema.CsgCompilerScalarSet
    if scalarKind == Int32(typearena.TypedExprStructuralScalarUtf8View):
        return snapshot_schema.CsgCompilerScalarUtf8View
    if scalarKind == Int32(typearena.TypedExprStructuralScalarBytesView):
        return snapshot_schema.CsgCompilerScalarBytesView
    # `int` and `uint` have target-dependent width in the producer and no
    # exact schema constructor.  They are deliberately unsupported here.
    return 0

fn compilerSnapshotBuilderScalarText(scalarKind: int32): str =
    if scalarKind == snapshot_schema.CsgCompilerScalarVoid: return "void"
    if scalarKind == snapshot_schema.CsgCompilerScalarBool: return "bool"
    if scalarKind == snapshot_schema.CsgCompilerScalarChar: return "char"
    if scalarKind == snapshot_schema.CsgCompilerScalarInt8: return "int8"
    if scalarKind == snapshot_schema.CsgCompilerScalarUInt8: return "uint8"
    if scalarKind == snapshot_schema.CsgCompilerScalarInt16: return "int16"
    if scalarKind == snapshot_schema.CsgCompilerScalarUInt16: return "uint16"
    if scalarKind == snapshot_schema.CsgCompilerScalarInt32: return "int32"
    if scalarKind == snapshot_schema.CsgCompilerScalarUInt32: return "uint32"
    if scalarKind == snapshot_schema.CsgCompilerScalarInt64: return "int64"
    if scalarKind == snapshot_schema.CsgCompilerScalarUInt64: return "uint64"
    if scalarKind == snapshot_schema.CsgCompilerScalarFloat32: return "float32"
    if scalarKind == snapshot_schema.CsgCompilerScalarFloat64: return "float64"
    if scalarKind == snapshot_schema.CsgCompilerScalarStr: return "str"
    if scalarKind == snapshot_schema.CsgCompilerScalarCString: return "cstring"
    if scalarKind == snapshot_schema.CsgCompilerScalarPtr: return "ptr"
    if scalarKind == snapshot_schema.CsgCompilerScalarTypedesc:
        return "typedesc"
    if scalarKind == snapshot_schema.CsgCompilerScalarSet: return "set"
    if scalarKind == snapshot_schema.CsgCompilerScalarUtf8View:
        return "utf8_view"
    if scalarKind == snapshot_schema.CsgCompilerScalarBytesView:
        return "bytes_view"
    return ""

@borrows
fn compilerSnapshotBuilderArenaTypeTextsInto(
        csg: ccsg.CompilerCsg,
        out: var str[],
        err: var str): bool =
    # [object-field-fixpoint] Row order is not a dependency order: the
    # aggregate rows are reserved (`typedExprTypeArenaReserveAggregatesRec`)
    # before the non-aggregate rows are interned
    # (`typedExprTypeArenaInternSyntaxRec`), so an object's field TypeId is
    # generally greater than the object's own TypeId and one increasing sweep
    # cannot produce the text of every row.  This driver repeats the sweep
    # until every row is written; a sweep that writes nothing while rows
    # remain is a dependency cycle and fails closed.  Each row's text is the
    # same expression as before, so the canonical text pool, the portable
    # Type table and every CID derived from them are unchanged.
    out = []
    var textReady: bool[]
    setLen(textReady, csg.typeArena.typeCount)
    for readyRow in 0..<textReady.len:
        textReady[readyRow] = false
        add(out, "")
    var remaining = csg.typeArena.typeCount
    var sweeps = 0
    while remaining > 0:
        var progressed = false
        if !compilerSnapshotBuilderArenaTypeTextsSweepInto(
               csg, out, textReady, remaining, progressed, err):
            return false
        sweeps = sweeps + 1
        if !progressed:
            err = Fmt" compiler snapshot builder: TypeArena structural dependency cycle unresolved={remaining} typeCount={csg.typeArena.typeCount} sweeps={sweeps}"
            return false
    err = ""
    return true

# [object-field-fixpoint] One sweep of the row-order-independent text pass.
# Every row whose child texts are already in `out` is written; the rest are
# left to a later sweep.  `remainingOut` counts the rows still missing after
# this sweep and `progressedOut` reports whether this sweep wrote any row.  A
# row is written exactly once and never rewritten, so the iteration is
# monotone and cannot oscillate.
@borrows
fn compilerSnapshotBuilderArenaTypeTextsSweepInto(
        csg: ccsg.CompilerCsg,
        out: var str[],
        textReady: var bool[],
        remainingOut: var int32,
        progressedOut: var bool,
        err: var str): bool =
    remainingOut = 0
    progressedOut = false
    for typeId in 0..<csg.typeArena.typeCount:
        if textReady[typeId]:
            continue
        var deferred = false
        let kind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena, csg.typeArena.typeKinds, typeId)
        let childStart = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena, csg.typeArena.childStarts, typeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena, csg.typeArena.childCounts, typeId)
        var text: str
        if kind == Int32(typearena.TypedExprStructuralTypeScalar):
            text = compilerSnapshotBuilderScalarText(
                compilerSnapshotBuilderSchemaScalarKind(
                    arenamod.ArenaArrayInt32Get(
                        csg.typeArena.arena,
                        csg.typeArena.scalarKinds,
                        typeId)))
        elif kind == Int32(typearena.TypedExprStructuralTypeBorrow) ||
             kind == Int32(typearena.TypedExprStructuralTypeSequence) ||
             kind == Int32(typearena.TypedExprStructuralTypeFixedArray) ||
             kind == Int32(typearena.TypedExprStructuralTypeAlias):
            if childCount != 1:
                err = " compiler snapshot builder: unary TypeArena row invalid"
                return false
            let childTypeId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childTypeIds,
                childStart)
            if childTypeId < 0 ||
               childTypeId >= csg.typeArena.typeCount:
                err = " compiler snapshot builder: structural TypeId dependency is not prior"
                return false
            if !textReady[childTypeId]:
                deferred = true
            if kind == Int32(typearena.TypedExprStructuralTypeBorrow):
                text = strutil.Join(
                    ["var ", strings.CloneStr(out[childTypeId])], "")
            elif kind == Int32(typearena.TypedExprStructuralTypeSequence):
                text = strutil.Join(
                    [strings.CloneStr(out[childTypeId]), "[]"], "")
            elif kind == Int32(typearena.TypedExprStructuralTypeAlias):
                text = strutil.Join(
                    ["alias[", strings.CloneStr(out[childTypeId]), "]"],
                    "")
            else:
                let fixedLength = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.fixedLengths,
                    typeId)
                text = strutil.Join(
                    [strings.CloneStr(out[childTypeId]),
                     Fmt"[{fixedLength}]"],
                    "")
        elif kind == Int32(typearena.TypedExprStructuralTypeTuple):
            var parts: str[]
            add(parts, "tuple[")
            for offset in 0..<childCount:
                if offset > 0:
                    add(parts, ",")
                let childTypeId = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.childTypeIds,
                    childStart + offset)
                if childTypeId < 0 ||
                   childTypeId >= csg.typeArena.typeCount:
                    err = " compiler snapshot builder: tuple TypeId dependency is not prior"
                    return false
                if !textReady[childTypeId]:
                    deferred = true
                let childNameId = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.childNameIds,
                    childStart + offset)
                if childNameId >= 0:
                    let childNameResult = langintern.LookupIntern(
                        csg.typeArena.internPool, childNameId)
                    if !IsOk(childNameResult) ||
                       Value(childNameResult) == "":
                        err = " compiler snapshot builder: tuple field name authority missing"
                        return false
                    add(parts, strings.CloneStr(Value(childNameResult)))
                    add(parts, ":")
                add(parts, strings.CloneStr(out[childTypeId]))
            add(parts, "]")
            text = strutil.Join(parts, "")
        elif kind == Int32(typearena.TypedExprStructuralTypeObject) ||
             kind == Int32(typearena.TypedExprStructuralTypeRefObject):
            var parts: str[]
            add(parts,
                kind ==
                    Int32(typearena.TypedExprStructuralTypeRefObject) ?
                    "ref object[" : "object[")
            for offset in 0..<childCount:
                if offset > 0:
                    add(parts, ",")
                let childTypeId = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.childTypeIds,
                    childStart + offset)
                let childNameId = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.childNameIds,
                    childStart + offset)
                if childTypeId < 0 ||
                   childTypeId >= csg.typeArena.typeCount ||
                   childNameId < 0:
                    err = " compiler snapshot builder: object field TypeArena authority invalid"
                    return false
                if !textReady[childTypeId]:
                    deferred = true
                let childNameResult = langintern.LookupIntern(
                    csg.typeArena.internPool, childNameId)
                if !IsOk(childNameResult) ||
                   Value(childNameResult) == "":
                    err = " compiler snapshot builder: object field name authority missing"
                    return false
                add(parts, strings.CloneStr(Value(childNameResult)))
                add(parts, ":")
                add(parts, strings.CloneStr(out[childTypeId]))
            add(parts, "]")
            text = strutil.Join(parts, "")
        elif kind ==
                 Int32(typearena.TypedExprStructuralTypeGenericParameter):
            if childCount != 0:
                err = " compiler snapshot builder: generic parameter TypeArena row has children"
                return false
            text = "generic_parameter"
        elif kind == Int32(typearena.TypedExprStructuralTypeEnum):
            # [phaseB-enum-schema] Canonical diagnostic text is the exact
            # declared variant sequence: `enum[Name,Name(payload),...]`.
            # Diagnostic cargo only; never a CID input.
            let arenaSymbolId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.symbolIds,
                typeId)
            if arenaSymbolId < 0 ||
               arenaSymbolId >= csg.typeArena.symbolCount:
                err = " compiler snapshot builder: enum TypeArena Symbol missing"
                return false
            let memberStart = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.symbolMemberStarts,
                arenaSymbolId)
            let memberCount = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.symbolMemberCounts,
                arenaSymbolId)
            if memberStart < 0 || memberCount < 0 ||
               memberStart > csg.typeArena.memberCount ||
               memberCount > csg.typeArena.memberCount - memberStart:
                err = " compiler snapshot builder: enum variant member CSR invalid"
                return false
            var parts: str[]
            add(parts, "enum[")
            for variantOffset in 0..<memberCount:
                if variantOffset > 0:
                    add(parts, ",")
                let memberRow = memberStart + variantOffset
                let memberNameId = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.memberNameIds,
                    memberRow)
                let payloadTypeId = arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.memberTypeIds,
                    memberRow)
                if memberNameId < 0 || payloadTypeId < -1 ||
                   payloadTypeId >= csg.typeArena.typeCount:
                    err = " compiler snapshot builder: enum variant payload authority invalid"
                    return false
                if payloadTypeId >= 0 && !textReady[payloadTypeId]:
                    deferred = true
                let variantNameResult = langintern.LookupIntern(
                    csg.typeArena.internPool, memberNameId)
                if !IsOk(variantNameResult) ||
                   Value(variantNameResult) == "":
                    err = " compiler snapshot builder: enum variant name authority missing"
                    return false
                add(parts, strings.CloneStr(Value(variantNameResult)))
                if payloadTypeId >= 0:
                    add(parts, "(")
                    add(parts, strings.CloneStr(out[payloadTypeId]))
                    add(parts, ")")
            add(parts, "]")
            text = strutil.Join(parts, "")
        else:
            err = " compiler snapshot builder: unsupported TypeArena kind reached projection"
            return false
        if deferred:
            continue
        if !compilerSnapshotBuilderTextRepresentable(
               strings.CloneStr(text)):
            err = " compiler snapshot builder: structural type text invalid"
            return false
        out[typeId] = strings.CloneStr(text)
        textReady[typeId] = true
        progressedOut = true
    remainingOut = 0
    for readyRow in 0..<textReady.len:
        if !textReady[readyRow]:
            remainingOut = remainingOut + 1
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderAppendArenaTypeRow(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        arenaTypeId: int32,
        typeSymbolIdByArenaTypeId: int32[],
        parserGenericRowByArenaTypeId: int32[],
        canonicalTextId: int32,
        err: var str): bool =
    let arenaKind = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.typeKinds,
        arenaTypeId)
    let childStart = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.childStarts,
        arenaTypeId)
    let childCount = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.childCounts,
        arenaTypeId)
    var schemaKind: int32
    var scalarKind: int32
    var elementTypeId: int32 = -1
    var arrayLength: int32 = -1
    var argCount: int32
    var declSymbolId: int32 = -1
    var aliasTargetTypeId: int32 = -1
    var proofKind = snapshot_schema.CsgCompilerTraitProofStructural
    if arenaKind == Int32(typearena.TypedExprStructuralTypeScalar):
        schemaKind = snapshot_schema.CsgCompilerTypeScalar
        scalarKind = compilerSnapshotBuilderSchemaScalarKind(
            arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.scalarKinds,
                arenaTypeId))
        proofKind = snapshot_schema.CsgCompilerTraitProofBuiltin
    elif arenaKind == Int32(typearena.TypedExprStructuralTypeBorrow):
        schemaKind = snapshot_schema.CsgCompilerTypeBorrow
        elementTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childTypeIds,
            childStart)
    elif arenaKind == Int32(typearena.TypedExprStructuralTypeSequence):
        schemaKind = snapshot_schema.CsgCompilerTypeSequence
        elementTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childTypeIds,
            childStart)
    elif arenaKind == Int32(typearena.TypedExprStructuralTypeFixedArray):
        schemaKind = snapshot_schema.CsgCompilerTypeArray
        elementTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childTypeIds,
            childStart)
        arrayLength = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.fixedLengths,
            arenaTypeId)
    elif arenaKind == Int32(typearena.TypedExprStructuralTypeTuple):
        schemaKind = snapshot_schema.CsgCompilerTypeTuple
        argCount = childCount
    elif arenaKind == Int32(typearena.TypedExprStructuralTypeObject):
        schemaKind = snapshot_schema.CsgCompilerTypeObject
        argCount = childCount
        declSymbolId = typeSymbolIdByArenaTypeId[arenaTypeId]
        proofKind = snapshot_schema.CsgCompilerTraitProofDeclaration
    elif arenaKind ==
             Int32(typearena.TypedExprStructuralTypeRefObject):
        schemaKind = snapshot_schema.CsgCompilerTypeRefObject
        argCount = childCount
        declSymbolId = typeSymbolIdByArenaTypeId[arenaTypeId]
        proofKind = snapshot_schema.CsgCompilerTraitProofDeclaration
    elif arenaKind == Int32(typearena.TypedExprStructuralTypeEnum):
        # [phaseB-enum-schema] An enum projects to the schema's nominal
        # CsgCompilerTypeEnum row with zero type arguments; its exact
        # declaration data rides in the variant payload CSR appended below.
        schemaKind = snapshot_schema.CsgCompilerTypeEnum
        argCount = 0
        declSymbolId = typeSymbolIdByArenaTypeId[arenaTypeId]
        proofKind = snapshot_schema.CsgCompilerTraitProofDeclaration
    elif arenaKind == Int32(typearena.TypedExprStructuralTypeAlias):
        schemaKind = snapshot_schema.CsgCompilerTypeAlias
        declSymbolId =
            typeSymbolIdByArenaTypeId[arenaTypeId]
        aliasTargetTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childTypeIds,
            childStart)
    elif arenaKind ==
             Int32(typearena.TypedExprStructuralTypeGenericParameter):
        schemaKind = snapshot_schema.CsgCompilerTypeGenericParameter
    else:
        err = " compiler snapshot builder: unsupported TypeArena kind reached row append"
        return false
    if parserGenericRowByArenaTypeId.len != csg.typeArena.typeCount ||
       schemaKind <= 0 || canonicalTextId < 0 ||
       (schemaKind != snapshot_schema.CsgCompilerTypeScalar &&
        schemaKind != snapshot_schema.CsgCompilerTypeGenericParameter &&
        schemaKind != snapshot_schema.CsgCompilerTypeObject &&
        schemaKind != snapshot_schema.CsgCompilerTypeRefObject &&
        schemaKind != snapshot_schema.CsgCompilerTypeEnum &&
        childCount <= 0) ||
       (schemaKind == snapshot_schema.CsgCompilerTypeAlias &&
        (childCount != 1 || declSymbolId < 0)) ||
       ((schemaKind == snapshot_schema.CsgCompilerTypeObject ||
         schemaKind == snapshot_schema.CsgCompilerTypeRefObject ||
         schemaKind == snapshot_schema.CsgCompilerTypeEnum) &&
        declSymbolId < 0) ||
       (schemaKind == snapshot_schema.CsgCompilerTypeGenericParameter &&
        parserGenericRowByArenaTypeId[arenaTypeId] < 0):
        err = " compiler snapshot builder: structural type row authority invalid"
        return false
    add(tables.types.typeCids, layout.FixedBytes32())
    add(tables.types.producerTypeArenaIds, arenaTypeId)
    add(tables.types.canonicalTextIds, canonicalTextId)
    add(tables.types.typeKinds, schemaKind)
    add(tables.types.scalarKinds, scalarKind)
    add(tables.types.declSymbolIds, declSymbolId)
    add(tables.types.elementTypeIds, elementTypeId)
    add(tables.types.arrayLengths, arrayLength)
    add(tables.types.argStarts, tables.types.argTypeIds.len)
    add(tables.types.argCounts, argCount)
    if schemaKind == snapshot_schema.CsgCompilerTypeTuple ||
       schemaKind == snapshot_schema.CsgCompilerTypeObject ||
       schemaKind == snapshot_schema.CsgCompilerTypeRefObject:
        for offset in 0..<childCount:
            add(tables.types.argTypeIds,
                arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.childTypeIds,
                    childStart + offset))
            let childNameId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childNameIds,
                childStart + offset)
            var childNameTextId: int32 = -1
            if childNameId >= 0:
                let childNameResult = langintern.LookupIntern(
                    csg.typeArena.internPool, childNameId)
                if !IsOk(childNameResult) ||
                   Value(childNameResult) == "":
                    err = " compiler snapshot builder: aggregate field name authority missing"
                    return false
                childNameTextId = compilerSnapshotBuilderTextFind(
                    tables.texts, Value(childNameResult))
                if childNameTextId < 0:
                    err = " compiler snapshot builder: tuple field name text missing"
                    return false
            add(tables.types.argNameTextIds, childNameTextId)
    add(tables.types.constArgStarts, tables.types.constArgKinds.len)
    add(tables.types.constArgCounts, 0)
    add(tables.types.aliasTargetTypeIds, aliasTargetTypeId)
    add(tables.types.genericParameterParserRows,
        schemaKind == snapshot_schema.CsgCompilerTypeGenericParameter ?
            parserGenericRowByArenaTypeId[arenaTypeId] : -1)
    add(tables.types.managedFlags,
        arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.managedFlags,
            arenaTypeId) == 1)
    add(tables.types.sendFlags,
        arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.sendFlags,
            arenaTypeId) == 1)
    add(tables.types.syncFlags,
        arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.syncFlags,
            arenaTypeId) == 1)
    add(tables.types.traitConclusionKinds,
        snapshot_schema.CsgCompilerTraitConclusionExact)
    add(tables.types.traitProofKinds, proofKind)
    add(tables.types.traitProofCids, layout.FixedBytes32())
    add(tables.types.traitPremiseStarts,
        tables.types.traitPremiseTypeIds.len)
    let traitPremiseStart = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.traitPremiseStarts,
        arenaTypeId)
    let traitPremiseCount = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.traitPremiseCounts,
        arenaTypeId)
    add(tables.types.traitPremiseCounts, traitPremiseCount)
    for offset in 0..<traitPremiseCount:
        add(tables.types.traitPremiseTypeIds,
            arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.traitPremiseTypeIds,
                traitPremiseStart + offset))
    # [phaseB-enum-schema] Enum variant payload CSR projection. The producer
    # member CSR of the enum's declaration Symbol is the exact declared
    # variant sequence in ordinal order; names move from the arena intern
    # pool into the canonical text pool, and payloadless variants keep -1.
    add(tables.types.variantStarts, tables.types.variantNameTextIds.len)
    if schemaKind == snapshot_schema.CsgCompilerTypeEnum:
        let arenaSymbolId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolIds,
            arenaTypeId)
        if arenaSymbolId < 0 ||
           arenaSymbolId >= csg.typeArena.symbolCount:
            err = " compiler snapshot builder: enum TypeArena Symbol missing"
            return false
        let memberStart = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolMemberStarts,
            arenaSymbolId)
        let memberCount = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolMemberCounts,
            arenaSymbolId)
        if memberStart < 0 || memberCount < 0 ||
           memberStart > csg.typeArena.memberCount ||
           memberCount > csg.typeArena.memberCount - memberStart:
            err = " compiler snapshot builder: enum variant member CSR invalid"
            return false
        add(tables.types.variantCounts, memberCount)
        for variantOffset in 0..<memberCount:
            let memberRow = memberStart + variantOffset
            let memberNameId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.memberNameIds,
                memberRow)
            let memberOrdinal = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.memberOrdinals,
                memberRow)
            let payloadTypeId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.memberTypeIds,
                memberRow)
            if memberNameId < 0 || memberOrdinal != variantOffset ||
               payloadTypeId < -1 || payloadTypeId >= arenaTypeId:
                err = " compiler snapshot builder: enum variant payload authority invalid"
                return false
            let variantNameResult = langintern.LookupIntern(
                csg.typeArena.internPool, memberNameId)
            if !IsOk(variantNameResult) ||
               Value(variantNameResult) == "":
                err = " compiler snapshot builder: enum variant name authority missing"
                return false
            let variantNameTextId = compilerSnapshotBuilderTextFind(
                tables.texts, Value(variantNameResult))
            if variantNameTextId < 0:
                err = " compiler snapshot builder: enum variant name text missing"
                return false
            add(tables.types.variantNameTextIds, variantNameTextId)
            add(tables.types.variantOrdinals, memberOrdinal)
            add(tables.types.variantPayloadTypeIds, payloadTypeId)
    else:
        add(tables.types.variantCounts, 0)
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTextIdsRemapInto(
        ids: var int32[],
        oldTexts: str[],
        newTexts: str[],
        err: var str): bool =
    for row in 0..<ids.len:
        let oldId = ids[row]
        if oldId < 0:
            continue
        if oldId >= oldTexts.len:
            err = " compiler snapshot builder: text identity out of range"
            return false
        let newId = compilerSnapshotBuilderTextFind(
            newTexts, oldTexts[oldId])
        if newId < 0:
            err = " compiler snapshot builder: text identity lost during merge"
            return false
        ids[row] = newId
    return true

fn compilerSnapshotBuilderGeneratedTextsMergeInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        generated: str[],
        err: var str): bool =
    var oldTexts: str[]
    for row in 0..<tables.texts.len:
        if !compilerSnapshotBuilderTextRepresentable(tables.texts[row]) ||
           (row > 0 && !compilerSnapshotBuilderTextLess(
               tables.texts[row - 1], tables.texts[row])):
            err = " compiler snapshot builder: existing text pool is not canonical"
            return false
        add(oldTexts, share(tables.texts[row]))
    var candidates: str[]
    for row in 0..<oldTexts.len:
        add(candidates, share(oldTexts[row]))
    for row in 0..<generated.len:
        if !compilerSnapshotBuilderTextRepresentable(generated[row]):
            err = " compiler snapshot builder: generated type text invalid"
            return false
        add(candidates, share(generated[row]))
    let candidateOrder = compilerSnapshotBuilderTextOrder(candidates)
    var merged: str[]
    for row in 0..<candidateOrder.len:
        let candidateIndex = candidateOrder[row]
        if row == 0 ||
           candidates[candidateIndex] !=
               candidates[candidateOrder[row - 1]]:
            add(merged, strings.CloneStr(candidates[candidateIndex]))
    if !compilerSnapshotBuilderTextIdsRemapInto(
           tables.sources.modulePathTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.tokens.valueTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.parserSidecars.functionNameTextIds,
           oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.types.canonicalTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.types.argNameTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.types.variantNameTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.symbols.nameTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.symbols.qualifiedNameTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.externFunctions.externalNameTextIds,
           oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.diagnostics.codeTextIds, oldTexts, merged, err) ||
       !compilerSnapshotBuilderTextIdsRemapInto(
           tables.diagnostics.messageTextIds, oldTexts, merged, err):
        return false
    tables.texts = merged
    return true

fn compilerSnapshotBuilderDeclarationSymbolQualifiedNameInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        symbolId: int32,
        out: var str,
        err: var str): bool =
    if symbolId < 0 ||
       symbolId >= tables.symbols.symbolKinds.len ||
       tables.symbols.symbolKinds[symbolId] ==
           snapshot_schema.CsgCompilerSymbolModule:
        err = " compiler snapshot builder: declaration Symbol qualified coordinate invalid"
        return false
    let sourceId = tables.symbols.sourceIds[symbolId]
    if sourceId < 0 ||
       sourceId >= tables.sources.modulePathTextIds.len:
        err = " compiler snapshot builder: declaration Symbol source missing"
        return false
    var ownerChain: int32[]
    var current = symbolId
    while current >= 0 &&
          tables.symbols.symbolKinds[current] !=
              snapshot_schema.CsgCompilerSymbolModule:
        if current >= tables.symbols.ownerSymbolIds.len ||
           ownerChain.len >= tables.symbols.symbolKinds.len ||
           tables.symbols.sourceIds[current] != sourceId:
            err = " compiler snapshot builder: declaration Symbol owner chain invalid"
            return false
        add(ownerChain, current)
        current = tables.symbols.ownerSymbolIds[current]
    if current < 0 ||
       current >= tables.symbols.symbolKinds.len ||
       tables.symbols.symbolKinds[current] !=
           snapshot_schema.CsgCompilerSymbolModule ||
       tables.symbols.sourceIds[current] != sourceId:
        err = " compiler snapshot builder: declaration Symbol Module owner missing"
        return false
    var parts: str[]
    add(parts, share(tables.texts[
        tables.sources.modulePathTextIds[sourceId]]))
    for reverse in 0..<ownerChain.len:
        let chainRow = ownerChain.len - 1 - reverse
        let memberSymbolId = ownerChain[chainRow]
        add(parts, reverse == 0 ? "::" : ".")
        add(parts, share(tables.texts[
            tables.symbols.nameTextIds[memberSymbolId]]))
    out = strutil.Join(parts, "")
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderFunctionParameterOwnershipKindInto(
        csg: ccsg.CompilerCsg,
        arenaTypeId: int32,
        out: var int32,
        err: var str): bool =
    if csg.typeArena == nil ||
       arenaTypeId < 0 ||
       arenaTypeId >= csg.typeArena.typeCount:
        err = " compiler snapshot builder: parameter ownership TypeId invalid"
        return false
    let typeKind = arenamod.ArenaArrayInt32Get(
        csg.typeArena.arena,
        csg.typeArena.typeKinds,
        arenaTypeId)
    if typeKind == Int32(typearena.TypedExprStructuralTypeBorrow):
        out = snapshot_schema.CsgCompilerOwnershipBorrowed
    elif arenamod.ArenaArrayInt32Get(
             csg.typeArena.arena,
             csg.typeArena.managedFlags,
             arenaTypeId) != 0:
        out = snapshot_schema.CsgCompilerOwnershipOwned
    else:
        out = snapshot_schema.CsgCompilerOwnershipUnmanaged
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeFunctionBindingsFromOwnerTokensInto(
        csg: ccsg.CompilerCsg,
        functionIdByOwnerToken: int32[],
        parserFunctionOwnerKinds: int32[],
        functionCount: int32,
        returnArenaTypeIds: var int32[],
        paramStarts: var int32[],
        paramCounts: var int32[],
        paramArenaTypeIds: var int32[],
        paramOwnershipKinds: var int32[],
        err: var str): bool =
    returnArenaTypeIds = []
    paramStarts = []
    paramCounts = []
    paramArenaTypeIds = []
    paramOwnershipKinds = []
    if csg.typeArena == nil ||
       functionCount < 0 ||
       functionIdByOwnerToken.len != csg.typeArena.tokenCount ||
       parserFunctionOwnerKinds.len != csg.typeArena.tokenCount:
        err = " compiler snapshot builder: function owner-token domain invalid"
        return false
    for functionId in 0..<functionCount:
        add(returnArenaTypeIds, -1)
        add(paramStarts, 0)
        add(paramCounts, 0)
    var returnCounts: int32[]
    setLen(returnCounts, functionCount)
    for globalTypeRow in 0..<csg.typeArena.typeSyntaxCount:
        let rootKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxRootKinds,
            globalTypeRow)
        if rootKind != Int32(parser.ParserTypeSyntaxRootFunctionParameter) &&
           rootKind != Int32(parser.ParserTypeSyntaxRootFunctionReturn):
            continue
        let ownerToken = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxDeclarationOwnerTokenIndexes,
            globalTypeRow)
        let functionId = ownerToken < 0 ||
            ownerToken >= functionIdByOwnerToken.len ? -1 :
                functionIdByOwnerToken[ownerToken]
        let parserOwnerKind = ownerToken < 0 ||
            ownerToken >= parserFunctionOwnerKinds.len ?
                compilerSnapshotParserFunctionOwnerNone :
                parserFunctionOwnerKinds[ownerToken]
        let arenaTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxTypeIds,
            globalTypeRow)
        if arenaTypeId < 0 ||
           arenaTypeId >= csg.typeArena.typeCount ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxDeclarationOwnerNodeIndexes,
               globalTypeRow) != -1 ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxGenericSymbolCounts,
               globalTypeRow) != 0:
            err = " compiler snapshot builder: parser function type root authority invalid"
            return false
        if parserOwnerKind ==
               compilerSnapshotParserFunctionOwnerNonExecutable:
            if functionId != -1:
                err = " compiler snapshot builder: non-executable function type root entered FunctionId domain"
                return false
            continue
        if parserOwnerKind !=
               compilerSnapshotParserFunctionOwnerExecutable:
            err = " compiler snapshot builder: function type root parser owner missing"
            return false
        if functionId < 0 || functionId >= functionCount:
            err = " compiler snapshot builder: executable function type root FunctionId missing"
            return false
        if rootKind == Int32(parser.ParserTypeSyntaxRootFunctionParameter):
            if paramCounts[functionId] == 2147483647:
                err = " compiler snapshot builder: function parameter count overflow"
                return false
            paramCounts[functionId] = paramCounts[functionId] + 1
        else:
            if returnCounts[functionId] == 2147483647:
                err = " compiler snapshot builder: function return count overflow"
                return false
            returnCounts[functionId] = returnCounts[functionId] + 1
            returnArenaTypeIds[functionId] = arenaTypeId
    # Void routines surface zero explicit FunctionReturn roots (the parser
    # mirrors the surface syntax); the TypeArena authority binds every
    # function's return to the unique semantic builtin void scalar unless an
    # explicit root overrides it.  Resolve that same authority here and bind
    # 0-root functions to it; more than one explicit root stays a violation.
    var voidArenaTypeId: int32 = -1
    for typeId in 0..<csg.typeArena.typeCount:
        if arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeKinds,
               typeId) == Int32(typearena.TypedExprStructuralTypeScalar) &&
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.scalarKinds,
               typeId) == Int32(typearena.TypedExprStructuralScalarVoid) &&
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeOriginKinds,
               typeId) ==
               Int32(typearena.TypedExprTypeOriginSemanticBuiltin):
            if voidArenaTypeId >= 0:
                err = " compiler snapshot builder: semantic void authority duplicated"
                return false
            voidArenaTypeId = typeId
    if voidArenaTypeId < 0:
        err = " compiler snapshot builder: semantic void authority missing"
        return false
    var paramCursor: int32
    for functionId in 0..<functionCount:
        if returnCounts[functionId] > 1 ||
           !compilerSnapshotBuilderCountAppendSafe(
               paramCursor, paramCounts[functionId]):
            err = " compiler snapshot builder: function return root is not unique"
            return false
        if returnCounts[functionId] == 0:
            returnArenaTypeIds[functionId] = voidArenaTypeId
        paramStarts[functionId] = paramCursor
        paramCursor = paramCursor + paramCounts[functionId]
    setLen(paramArenaTypeIds, paramCursor)
    setLen(paramOwnershipKinds, paramCursor)
    var paramWriteCursors: int32[]
    for functionId in 0..<paramStarts.len:
        add(paramWriteCursors, paramStarts[functionId])
    for globalTypeRow in 0..<csg.typeArena.typeSyntaxCount:
        if arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxRootKinds,
               globalTypeRow) !=
                   Int32(parser.ParserTypeSyntaxRootFunctionParameter):
            continue
        let ownerToken = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxDeclarationOwnerTokenIndexes,
            globalTypeRow)
        let parserOwnerKind = ownerToken < 0 ||
            ownerToken >= parserFunctionOwnerKinds.len ?
                compilerSnapshotParserFunctionOwnerNone :
                parserFunctionOwnerKinds[ownerToken]
        if parserOwnerKind ==
               compilerSnapshotParserFunctionOwnerNonExecutable:
            continue
        if parserOwnerKind !=
               compilerSnapshotParserFunctionOwnerExecutable:
            err = " compiler snapshot builder: function parameter root parser owner missing"
            return false
        let functionId = functionIdByOwnerToken[ownerToken]
        if functionId < 0 || functionId >= functionCount:
            err = " compiler snapshot builder: function parameter root FunctionId missing"
            return false
        let writeRow = paramWriteCursors[functionId]
        let arenaTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxTypeIds,
            globalTypeRow)
        paramArenaTypeIds[writeRow] = arenaTypeId
        if !compilerSnapshotBuilderFunctionParameterOwnershipKindInto(
               csg, arenaTypeId,
               paramOwnershipKinds[writeRow], err):
            return false
        paramWriteCursors[functionId] = writeRow + 1
    for functionId in 0..<functionCount:
        if paramWriteCursors[functionId] !=
               paramStarts[functionId] + paramCounts[functionId]:
            err = " compiler snapshot builder: function parameter coverage drift"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeFunctionBindingsInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        returnArenaTypeIds: var int32[],
        paramStarts: var int32[],
        paramCounts: var int32[],
        paramArenaTypeIds: var int32[],
        paramOwnershipKinds: var int32[],
        err: var str): bool =
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    returnArenaTypeIds = []
    paramStarts = []
    paramCounts = []
    paramArenaTypeIds = []
    paramOwnershipKinds = []
    if csg.typeArena == nil ||
       sidecars.len != csg.typeArena.producerSourceCount ||
       sidecars.len != tables.sources.documentCids.len:
        err = " compiler snapshot builder: TypeArena source domain invalid"
        return false
    let functionCount = tables.functions.symbolIds.len
    let externFunctionCount =
        tables.externFunctions.symbolIds.len
    let sourceCount = tables.sources.documentCids.len
    var typeSymbolCount: int32
    var genericSymbolCount: int32
    var moduleSymbolCount: int32
    var functionSymbolCount: int32
    var fieldSymbolCount: int32
    var parameterSymbolCount: int32
    var localSymbolCount: int32
    if tables.symbols.symbolKinds.len !=
           tables.symbols.symbolCids.len:
        err = " compiler snapshot builder: function signature domain invalid"
        return false
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let symbolKind = tables.symbols.symbolKinds[symbolId]
        if symbolKind == snapshot_schema.CsgCompilerSymbolType:
            typeSymbolCount = typeSymbolCount + 1
        elif symbolKind ==
                 snapshot_schema.CsgCompilerSymbolGenericParameter:
            genericSymbolCount = genericSymbolCount + 1
        elif symbolKind == snapshot_schema.CsgCompilerSymbolModule:
            moduleSymbolCount = moduleSymbolCount + 1
        elif symbolKind == snapshot_schema.CsgCompilerSymbolFunction:
            functionSymbolCount = functionSymbolCount + 1
        elif symbolKind == snapshot_schema.CsgCompilerSymbolField:
            fieldSymbolCount = fieldSymbolCount + 1
        elif symbolKind == snapshot_schema.CsgCompilerSymbolParameter:
            parameterSymbolCount = parameterSymbolCount + 1
        elif symbolKind == snapshot_schema.CsgCompilerSymbolLocal:
            localSymbolCount = localSymbolCount + 1
        else:
            err = " compiler snapshot builder: function signature domain invalid"
            return false
    if sourceCount <= 0 ||
       functionCount > 2147483647 - sourceCount ||
       externFunctionCount >
           2147483647 - sourceCount - functionCount ||
       typeSymbolCount >
           2147483647 - sourceCount - functionCount -
               externFunctionCount ||
       genericSymbolCount >
           2147483647 - sourceCount - functionCount -
               externFunctionCount - typeSymbolCount ||
       moduleSymbolCount != sourceCount ||
       functionSymbolCount !=
           functionCount + externFunctionCount ||
       (genericSymbolCount != 0 &&
        genericSymbolCount !=
            tables.parserSidecars.typeGenericSymbolProducerSourceIds.len) ||
       tables.symbols.symbolCids.len !=
           functionSymbolCount + moduleSymbolCount +
               typeSymbolCount + genericSymbolCount +
               fieldSymbolCount + parameterSymbolCount +
               localSymbolCount:
        err = " compiler snapshot builder: function signature domain invalid"
        return false
    var typedRowByReachable: int32[]
    if !compilerSnapshotBuilderTypedFunctionJoinInto(
           csg, typedRowByReachable, err):
        return false
    var functionIdByTypedRow: int32[]
    setLen(functionIdByTypedRow,
           csg.semanticGraph.typedIrTable.functionNames.len)
    for row in 0..<functionIdByTypedRow.len:
        functionIdByTypedRow[row] = -1
    for functionId in 0..<functionCount:
        let typedRow = tables.functions.typedFunctionIndexes[functionId]
        let symbolId = tables.functions.symbolIds[functionId]
        if typedRow < 0 || typedRow >= functionIdByTypedRow.len ||
           functionIdByTypedRow[typedRow] >= 0 || symbolId < 0 ||
           symbolId >= tables.symbols.symbolCids.len ||
           tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction:
            err = " compiler snapshot builder: function TypedIR identity invalid"
            return false
        functionIdByTypedRow[typedRow] = functionId
    var tokenBases: int32[]
    var typeBases: int32[]
    var genericBases: int32[]
    var bracketBases: int32[]
    var tokenCursor: int32
    var typeCursor: int32
    var genericCursor: int32
    var bracketCursor: int32
    for producerSourceIndex in 0..<sidecars.len:
        let sidecar = sidecars[producerSourceIndex]
        var sidecarErr: str
        if sidecar.sourceIndex != producerSourceIndex ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, sidecarErr):
            err = sidecarErr == "" ?
                " compiler snapshot builder: parser TypeSyntax sidecar invalid" :
                sidecarErr
            return false
        add(tokenBases, tokenCursor)
        add(typeBases, typeCursor)
        add(genericBases, genericCursor)
        add(bracketBases, bracketCursor)
        if !compilerSnapshotBuilderCountAppendSafe(
               tokenCursor, sidecar.tokenKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               typeCursor, sidecar.typeSyntaxKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               genericCursor,
               sidecar.typeGenericSymbolNameTokenIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               bracketCursor,
               sidecar.typeSyntaxBracketArgTokenStarts.len):
            err = " compiler snapshot builder: TypeSyntax forest size overflow"
            return false
        tokenCursor = tokenCursor + sidecar.tokenKinds.len
        typeCursor = typeCursor + sidecar.typeSyntaxKinds.len
        genericCursor = genericCursor +
            sidecar.typeGenericSymbolNameTokenIds.len
        bracketCursor = bracketCursor +
            sidecar.typeSyntaxBracketArgTokenStarts.len
    if tokenCursor != csg.typeArena.tokenCount ||
       typeCursor != csg.typeArena.typeSyntaxCount ||
       genericCursor != csg.typeArena.genericSymbolCount ||
       bracketCursor != csg.typeArena.bracketArgCount:
        err = " compiler snapshot builder: TypeArena forest coverage mismatch"
        return false
    var functionIdByOwnerToken: int32[]
    setLen(functionIdByOwnerToken, csg.typeArena.tokenCount)
    for row in 0..<functionIdByOwnerToken.len:
        functionIdByOwnerToken[row] = -1
    var parserFunctionOwnerKinds: int32[]
    if !compilerSnapshotBuilderParserFunctionOwnerKindsBuildInto(
           sidecars,
           tokenBases,
           csg.typeArena.tokenCount,
           parserFunctionOwnerKinds,
           err):
        return false
    var functionSeen: int32[]
    setLen(functionSeen, functionCount)
    var parserFunctionCount: int32
    var sourceIdByProducer: int32[]
    var sidecarRowByProducer: int32[]
    var producerBySourceId: int32[]
    setLen(sourceIdByProducer, sourceCount)
    setLen(sidecarRowByProducer, sourceCount)
    setLen(producerBySourceId, sourceCount)
    for producerSourceIndex in 0..<sourceCount:
        sourceIdByProducer[producerSourceIndex] = -1
        sidecarRowByProducer[producerSourceIndex] = -1
        producerBySourceId[producerSourceIndex] = -1
    if tables.parserSidecars.sourceIds.len != sourceCount ||
       tables.parserSidecars.producerSourceIndexes.len != sourceCount:
        err = " compiler snapshot builder: parser source domain is not bijective"
        return false
    for row in 0..<sourceCount:
        let producerSourceIndex =
            tables.parserSidecars.producerSourceIndexes[row]
        let sourceId = tables.parserSidecars.sourceIds[row]
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sourceCount ||
           sourceId < 0 || sourceId >= sourceCount ||
           sourceIdByProducer[producerSourceIndex] >= 0 ||
           producerBySourceId[sourceId] >= 0:
            err = " compiler snapshot builder: duplicate parser source binding"
            return false
        sourceIdByProducer[producerSourceIndex] = sourceId
        sidecarRowByProducer[producerSourceIndex] = row
        producerBySourceId[sourceId] = producerSourceIndex
    for producerSourceIndex in 0..<sidecars.len:
        let sidecar = sidecars[producerSourceIndex]
        let sourceId = sourceIdByProducer[producerSourceIndex]
        let sidecarTableRow =
            sidecarRowByProducer[producerSourceIndex]
        if sourceId < 0 || sidecarTableRow < 0 ||
           tables.parserSidecars.sourceIds[sidecarTableRow] != sourceId ||
           !layout.FixedBytes32Equal(
               tables.parserSidecars.parserInputCids[sidecarTableRow],
               sidecar.parserInputRaw32) ||
           !layout.FixedBytes32Equal(
               tables.parserSidecars.sidecarCids[sidecarTableRow],
               sidecar.sidecarRaw32):
            err = " compiler snapshot builder: parser source receipt binding drift"
            return false
        var tokenBySpan: int32[]
        setLen(tokenBySpan, sidecar.spanStartBytes.len)
        for spanId in 0..<tokenBySpan.len:
            tokenBySpan[spanId] = -1
        for localToken in 0..<sidecar.tokenSpanIds.len:
            let spanId = sidecar.tokenSpanIds[localToken]
            if spanId < 0 || spanId >= tokenBySpan.len ||
               tokenBySpan[spanId] >= 0:
                err = " compiler snapshot builder: function name span token identity split"
                return false
            tokenBySpan[spanId] = localToken
        var parentByLocalType: int32[]
        setLen(parentByLocalType, sidecar.typeSyntaxKinds.len)
        for row in 0..<parentByLocalType.len:
            parentByLocalType[row] = -1
        for localParent in 0..<sidecar.typeSyntaxKinds.len:
            let childStart = sidecar.typeSyntaxChildStarts[localParent]
            for offset in 0..<sidecar.typeSyntaxChildCounts[localParent]:
                let localChild = sidecar.typeSyntaxChildIds[
                    childStart + offset]
                if parentByLocalType[localChild] >= 0:
                    err = " compiler snapshot builder: TypeSyntax child has two parents"
                    return false
                parentByLocalType[localChild] = localParent
        for localTypeRow in 0..<sidecar.typeSyntaxKinds.len:
            let globalTypeRow = typeBases[producerSourceIndex] +
                localTypeRow
            let localSpanId = sidecar.typeSyntaxSpanIds[localTypeRow]
            let localOwnerToken =
                sidecar.typeSyntaxOwnerTokenIds[localTypeRow]
            let localDeclarationOwnerToken =
                sidecar.typeSyntaxDeclarationOwnerTokenIds[localTypeRow]
            let localDeclarationOwner =
                sidecar.typeSyntaxDeclarationOwnerIds[localTypeRow]
            let localGenericStart =
                sidecar.typeSyntaxGenericSymbolStarts[localTypeRow]
            let localBracketStart =
                sidecar.typeSyntaxBracketArgStarts[localTypeRow]
            let expectedParent = parentByLocalType[localTypeRow] < 0 ?
                -1 : typeBases[producerSourceIndex] +
                    parentByLocalType[localTypeRow]
            let expectedBracketBase =
                sidecar.typeSyntaxBracketArgCounts[localTypeRow] == 0 ?
                    -1 : typeBases[producerSourceIndex] +
                        sidecar.typeSyntaxChildIds[
                            sidecar.typeSyntaxChildStarts[localTypeRow]]
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxProducerSourceIndexes,
                   globalTypeRow) != producerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxSourceLocalRows,
                   globalTypeRow) != localTypeRow ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxParserKinds,
                   globalTypeRow) != sidecar.typeSyntaxKinds[localTypeRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxSpanStarts,
                   globalTypeRow) != sidecar.spanStartBytes[localSpanId] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxSpanEnds,
                   globalTypeRow) != sidecar.spanEndBytes[localSpanId] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxOwnerTokenIndexes,
                   globalTypeRow) != tokenBases[producerSourceIndex] +
                       localOwnerToken ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxDeclarationOwnerTokenIndexes,
                   globalTypeRow) !=
                       (localDeclarationOwnerToken < 0 ? -1 :
                            tokenBases[producerSourceIndex] +
                                localDeclarationOwnerToken) ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxDeclarationOwnerNodeIndexes,
                   globalTypeRow) !=
                       (localDeclarationOwner < 0 ? -1 :
                            typeBases[producerSourceIndex] +
                                localDeclarationOwner) ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxGenericSymbolStarts,
                   globalTypeRow) !=
                       (localGenericStart < 0 ? -1 :
                            genericBases[producerSourceIndex] +
                                localGenericStart) ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxGenericSymbolCounts,
                   globalTypeRow) !=
                       sidecar.typeSyntaxGenericSymbolCounts[localTypeRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxRootKinds,
                   globalTypeRow) !=
                       sidecar.typeSyntaxRootKinds[localTypeRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxBracketArgStarts,
                   globalTypeRow) != bracketBases[producerSourceIndex] +
                       localBracketStart ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxBracketArgCounts,
                   globalTypeRow) !=
                       sidecar.typeSyntaxBracketArgCounts[localTypeRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxBracketBaseTypeSyntaxNodeIndexes,
                   globalTypeRow) != expectedBracketBase ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxParentNodeIndexes,
                   globalTypeRow) != expectedParent:
                err = " compiler snapshot builder: TypeArena TypeSyntax producer binding drift"
                return false
        for localGenericRow in 0..<
                sidecar.typeGenericSymbolNameTokenIds.len:
            let globalGenericRow = genericBases[producerSourceIndex] +
                localGenericRow
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolProducerSourceIndexes,
                   globalGenericRow) != producerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolDeclarationOwnerTokenIndexes,
                   globalGenericRow) != tokenBases[producerSourceIndex] +
                       sidecar.typeGenericSymbolDeclarationOwnerTokenIds[
                           localGenericRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolNameTokenIndexes,
                   globalGenericRow) != tokenBases[producerSourceIndex] +
                       sidecar.typeGenericSymbolNameTokenIds[
                           localGenericRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolOrdinals,
                   globalGenericRow) !=
                       sidecar.typeGenericSymbolOrdinals[localGenericRow]:
                err = " compiler snapshot builder: TypeArena generic producer binding drift"
                return false
        for localBracketRow in 0..<
                sidecar.typeSyntaxBracketArgTokenStarts.len:
            let globalBracketRow = bracketBases[producerSourceIndex] +
                localBracketRow
            let localArgType =
                sidecar.typeSyntaxBracketArgTypeIds[localBracketRow]
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.bracketArgTokenStarts,
                   globalBracketRow) != tokenBases[producerSourceIndex] +
                       sidecar.typeSyntaxBracketArgTokenStarts[
                           localBracketRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.bracketArgTokenCounts,
                   globalBracketRow) !=
                       sidecar.typeSyntaxBracketArgTokenCounts[
                           localBracketRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.bracketArgTypeSyntaxNodeIndexes,
                   globalBracketRow) !=
                       (localArgType < 0 ? -1 :
                            typeBases[producerSourceIndex] + localArgType):
                err = " compiler snapshot builder: TypeArena bracket producer binding drift"
                return false
        for localFunctionRow in 0..<sidecar.functionIndexes.len:
            parserFunctionCount = parserFunctionCount + 1
            let reachableRow = sidecar.functionIndexes[localFunctionRow]
            if reachableRow < 0 || reachableRow >= typedRowByReachable.len:
                err = " compiler snapshot builder: parser function producer row invalid"
                return false
            let typedRow = typedRowByReachable[reachableRow]
            if typedRow < 0 || typedRow >= functionIdByTypedRow.len:
                err = " compiler snapshot builder: parser function TypedIR row missing"
                return false
            let functionId = functionIdByTypedRow[typedRow]
            let symbolId = functionId < 0 ? -1 :
                tables.functions.symbolIds[functionId]
            if functionId < 0 || functionSeen[functionId] != 0 ||
               csg.semanticGraph.typedIrTable.functionSourceIndexes[
                   typedRow] != producerSourceIndex ||
               symbolId < 0 ||
               tables.symbols.sourceIds[symbolId] != sourceId:
                err = " compiler snapshot builder: parser function exact binding drift"
                return false
            let nameSpanId = sidecar.functionNameSpanIds[localFunctionRow]
            # A sidecar is one exact source: every row is implicitly the same
            # source, so the resolver's source columns stay empty here (kept
            # explicit for grep-auditable producer/consumer pairing).
            var noSpanSources: int32[]
            var noTokenSources: int32[]
            var localNameToken: int32
            if !compilerSnapshotBuilderFunctionNameOwnerTokenResolveInto(
                   sidecar.spanStartBytes,
                   sidecar.spanEndBytes,
                   noSpanSources,
                   noTokenSources,
                   sidecar.tokenSpanIds,
                   sidecar.tokenKinds,
                   tokenBySpan,
                   nameSpanId,
                   localNameToken,
                   err):
                return false
            let ownerToken = localNameToken < 0 ? -1 :
                tokenBases[producerSourceIndex] + localNameToken
            if ownerToken < 0 ||
               functionIdByOwnerToken[ownerToken] >= 0 ||
               parserFunctionOwnerKinds[ownerToken] !=
                   compilerSnapshotParserFunctionOwnerExecutable:
                err = " compiler snapshot builder: function owner token binding invalid"
                return false
            functionIdByOwnerToken[ownerToken] = functionId
            functionSeen[functionId] = 1
    if parserFunctionCount != functionCount:
        err = " compiler snapshot builder: parser function coverage mismatch"
        return false
    for functionId in 0..<functionSeen.len:
        if functionSeen[functionId] != 1:
            err = " compiler snapshot builder: function has no parser owner"
            return false
    return compilerSnapshotBuilderTypeFunctionBindingsFromOwnerTokensInto(
        csg, functionIdByOwnerToken, parserFunctionOwnerKinds,
        functionCount,
        returnArenaTypeIds, paramStarts, paramCounts,
        paramArenaTypeIds, paramOwnershipKinds, err)

@borrows
fn compilerSnapshotBuilderTypeExternBindingsInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        returnArenaTypeIds: var int32[],
        paramStarts: var int32[],
        paramCounts: var int32[],
        paramArenaTypeIds: var int32[],
        err: var str): bool =
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    returnArenaTypeIds = []
    paramStarts = []
    paramCounts = []
    paramArenaTypeIds = []
    if csg.typeArena == nil ||
       sidecars.len != csg.typeArena.producerSourceCount:
        err = " compiler snapshot builder: extern TypeArena source domain invalid"
        return false
    let externFunctionCount =
        tables.externFunctions.symbolIds.len
    var tokenBases: int32[]
    var tokenCursor: int32
    for producerSource in 0..<sidecars.len:
        add(tokenBases, tokenCursor)
        if !compilerSnapshotBuilderCountAppendSafe(
               tokenCursor,
               sidecars[producerSource].tokenKinds.len):
            err = " compiler snapshot builder: extern token domain overflow"
            return false
        tokenCursor =
            tokenCursor +
                sidecars[producerSource].tokenKinds.len
    if tokenCursor != csg.typeArena.tokenCount:
        err = " compiler snapshot builder: extern token domain drift"
        return false
    var parserFunctionOwnerKinds: int32[]
    if !compilerSnapshotBuilderParserFunctionOwnerKindsBuildInto(
           sidecars, tokenBases, tokenCursor,
           parserFunctionOwnerKinds, err):
        return false
    var externFunctionIdByOwnerToken: int32[]
    setLen(externFunctionIdByOwnerToken, tokenCursor)
    for row in 0..<externFunctionIdByOwnerToken.len:
        externFunctionIdByOwnerToken[row] = -1
    for externFunctionId in 0..<externFunctionCount:
        let symbolId =
            tables.externFunctions.symbolIds[externFunctionId]
        let parserDeclarationRow =
            tables.externFunctions.parserDeclarationRows[
                externFunctionId]
        if symbolId < 0 ||
           symbolId >= tables.symbols.nameTokenIds.len ||
           parserDeclarationRow < 0 ||
           parserDeclarationRow >=
               tables.parserSidecars.declarationKinds.len:
            err = " compiler snapshot builder: extern owner declaration invalid"
            return false
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                parserDeclarationRow]
        var producerSource: int32 = -1
        if sourceId >= 0 &&
           sourceId <
               tables.parserSidecars.producerSourceIndexes.len:
            producerSource =
                tables.parserSidecars.producerSourceIndexes[sourceId]
        let globalNameToken =
            tables.symbols.nameTokenIds[symbolId]
        var localNameToken: int32 = -1
        if globalNameToken >= 0 &&
           globalNameToken < tables.tokens.sourceLocalRows.len:
            localNameToken =
                tables.tokens.sourceLocalRows[globalNameToken]
        var ownerToken: int32 = -1
        if producerSource >= 0 &&
           producerSource < tokenBases.len &&
           localNameToken >= 0:
            ownerToken =
                tokenBases[producerSource] + localNameToken
        if ownerToken < 0 ||
           ownerToken >= externFunctionIdByOwnerToken.len ||
           parserFunctionOwnerKinds[ownerToken] !=
               compilerSnapshotParserFunctionOwnerNonExecutable ||
           externFunctionIdByOwnerToken[ownerToken] >= 0:
            err = " compiler snapshot builder: extern owner token identity drift"
            return false
        externFunctionIdByOwnerToken[ownerToken] =
            externFunctionId
    for externFunctionId in 0..<externFunctionCount:
        add(returnArenaTypeIds, -1)
        add(paramStarts, 0)
        add(paramCounts, 0)
    var returnCounts: int32[]
    setLen(returnCounts, externFunctionCount)
    for globalTypeRow in 0..<csg.typeArena.typeSyntaxCount:
        let rootKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxRootKinds,
            globalTypeRow)
        if rootKind !=
               Int32(parser.ParserTypeSyntaxRootFunctionParameter) &&
           rootKind !=
               Int32(parser.ParserTypeSyntaxRootFunctionReturn):
            continue
        let ownerToken = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxDeclarationOwnerTokenIndexes,
            globalTypeRow)
        if ownerToken < 0 ||
           ownerToken >= parserFunctionOwnerKinds.len:
            err = " compiler snapshot builder: extern TypeSyntax owner missing"
            return false
        if parserFunctionOwnerKinds[ownerToken] ==
               compilerSnapshotParserFunctionOwnerExecutable:
            continue
        let externFunctionId =
            externFunctionIdByOwnerToken[ownerToken]
        if parserFunctionOwnerKinds[ownerToken] !=
               compilerSnapshotParserFunctionOwnerNonExecutable ||
           externFunctionId < 0 ||
           externFunctionId >= externFunctionCount:
            err = " compiler snapshot builder: non-executable Function lacks ExternFunctionId"
            return false
        let arenaTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxTypeIds,
            globalTypeRow)
        if arenaTypeId < 0 ||
           arenaTypeId >= csg.typeArena.typeCount:
            err = " compiler snapshot builder: extern structural TypeId invalid"
            return false
        if rootKind ==
               Int32(parser.ParserTypeSyntaxRootFunctionParameter):
            paramCounts[externFunctionId] =
                paramCounts[externFunctionId] + 1
        else:
            returnCounts[externFunctionId] =
                returnCounts[externFunctionId] + 1
            returnArenaTypeIds[externFunctionId] =
                arenaTypeId
    var paramCursor: int32
    for externFunctionId in 0..<externFunctionCount:
        if returnCounts[externFunctionId] != 1 ||
           !compilerSnapshotBuilderCountAppendSafe(
               paramCursor,
               paramCounts[externFunctionId]):
            err = " compiler snapshot builder: extern return root is not unique"
            return false
        paramStarts[externFunctionId] = paramCursor
        paramCursor =
            paramCursor + paramCounts[externFunctionId]
    setLen(paramArenaTypeIds, paramCursor)
    var paramWriteCursors: int32[]
    for externFunctionId in 0..<externFunctionCount:
        add(paramWriteCursors, paramStarts[externFunctionId])
    for globalTypeRow in 0..<csg.typeArena.typeSyntaxCount:
        if arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxRootKinds,
               globalTypeRow) !=
               Int32(parser.ParserTypeSyntaxRootFunctionParameter):
            continue
        let ownerToken = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxDeclarationOwnerTokenIndexes,
            globalTypeRow)
        var externFunctionId: int32 = -1
        if ownerToken >= 0 &&
           ownerToken < externFunctionIdByOwnerToken.len:
            externFunctionId =
                externFunctionIdByOwnerToken[ownerToken]
        if externFunctionId < 0:
            continue
        let writeRow = paramWriteCursors[externFunctionId]
        paramArenaTypeIds[writeRow] =
            arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.typeSyntaxTypeIds,
                globalTypeRow)
        paramWriteCursors[externFunctionId] = writeRow + 1
    for externFunctionId in 0..<externFunctionCount:
        if paramWriteCursors[externFunctionId] !=
               paramStarts[externFunctionId] +
                   paramCounts[externFunctionId]:
            err = " compiler snapshot builder: extern parameter coverage drift"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotProductionFunctionTypeArenaBridgeStrictValidateInto(
        csg: ccsg.CompilerCsg,
        tokenBases: int32[],
        typeBases: int32[],
        genericBases: int32[],
        err: var str): bool =
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    if csg.typeArena == nil ||
       sidecars.len != tokenBases.len ||
       sidecars.len != typeBases.len ||
       sidecars.len != genericBases.len:
        err = " compiler snapshot builder: Function TypeArena bridge domain invalid"
        return false
    for producerSourceIndex in 0..<sidecars.len:
        let sidecar = sidecars[producerSourceIndex]
        for localTypeRow in 0..<sidecar.typeSyntaxKinds.len:
            let rootKind =
                sidecar.typeSyntaxRootKinds[localTypeRow]
            let globalTypeRow =
                typeBases[producerSourceIndex] + localTypeRow
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxProducerSourceIndexes,
                   globalTypeRow) != producerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxSourceLocalRows,
                   globalTypeRow) != localTypeRow ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxRootKinds,
                   globalTypeRow) != rootKind:
                err = " compiler snapshot builder: Function TypeArena root domain drift"
                return false
            if rootKind !=
                   Int32(parser.ParserTypeSyntaxRootFunctionParameter) &&
               rootKind !=
                   Int32(parser.ParserTypeSyntaxRootFunctionReturn):
                continue
            let localOwnerToken =
                sidecar.typeSyntaxOwnerTokenIds[localTypeRow]
            let localDeclarationOwnerToken =
                sidecar.typeSyntaxDeclarationOwnerTokenIds[
                    localTypeRow]
            let localDeclarationOwner =
                sidecar.typeSyntaxDeclarationOwnerIds[localTypeRow]
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxParserKinds,
                   globalTypeRow) !=
                       sidecar.typeSyntaxKinds[localTypeRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxOwnerTokenIndexes,
                   globalTypeRow) !=
                       tokenBases[producerSourceIndex] +
                           localOwnerToken ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxDeclarationOwnerTokenIndexes,
                   globalTypeRow) !=
                       (localDeclarationOwnerToken < 0 ? -1 :
                            tokenBases[producerSourceIndex] +
                                localDeclarationOwnerToken) ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxDeclarationOwnerNodeIndexes,
                   globalTypeRow) !=
                       (localDeclarationOwner < 0 ? -1 :
                            typeBases[producerSourceIndex] +
                                localDeclarationOwner) ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxGenericSymbolCounts,
                   globalTypeRow) !=
                       sidecar.typeSyntaxGenericSymbolCounts[
                           localTypeRow]:
                err = " compiler snapshot builder: Function TypeArena root bridge drift"
                return false
        for localGenericRow in 0..<
                sidecar.typeGenericSymbolNameTokenIds.len:
            let globalGenericRow =
                genericBases[producerSourceIndex] +
                    localGenericRow
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolProducerSourceIndexes,
                   globalGenericRow) != producerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolDeclarationOwnerTokenIndexes,
                   globalGenericRow) !=
                       tokenBases[producerSourceIndex] +
                           sidecar.typeGenericSymbolDeclarationOwnerTokenIds[
                               localGenericRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolNameTokenIndexes,
                   globalGenericRow) !=
                       tokenBases[producerSourceIndex] +
                           sidecar.typeGenericSymbolNameTokenIds[
                               localGenericRow] ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.genericSymbolOrdinals,
                   globalGenericRow) !=
                       sidecar.typeGenericSymbolOrdinals[
                           localGenericRow]:
                err = " compiler snapshot builder: Function generic TypeArena bridge drift"
                return false
    err = ""
    return true

# Authenticates the complete Function signature obligation directly from
# FunctionId, parser owner-token rows and the retained TypeArena.  Only exact
# int32 joins enter the shared TypeArena binding derivation; no provisional
# SymbolCid or source text is constructed.
fn compilerSnapshotProductionFunctionRequiredDomainCidInto(
        csg: var ccsg.CompilerCsg,
        expectedParameterCount: int32,
        expectedGenericCount: int32,
        outCid: var layout.FixedBytes32,
        err: var str): bool =
    outCid = layout.FixedBytes32()
    let sidecars =
        csg.parserNormalizedExprReceipt.sourceSidecars
    let sourceCount = sidecars.len
    let functionCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    var typeArenaPresent: bool
    if csg.typeArena == nil ||
       sourceCount <= 0 ||
       sourceCount != csg.sourceSnapshotCount ||
       sourceCount != csg.typeArena.producerSourceCount ||
       expectedParameterCount < 0 ||
       expectedGenericCount < 0:
        err = " compiler snapshot builder: Function required domain shape invalid"
        return false
    if !CompilerSnapshotProductionTypeArenaBindingStrictValidateInto(
           csg, typeArenaPresent, err) ||
       !typeArenaPresent:
        if err == "":
            err = " compiler snapshot builder: Function required TypeArena authority missing"
        return false
    var typedRowByReachable: int32[]
    if !compilerSnapshotBuilderTypedFunctionJoinInto(
           csg, typedRowByReachable, err) ||
       typedRowByReachable.len != functionCount:
        if err == "":
            err = " compiler snapshot builder: Function required TypedIR domain invalid"
        return false
    var tokenBases: int32[]
    var typeBases: int32[]
    var genericBases: int32[]
    var tokenCount: int32
    var typeCount: int32
    var genericCount: int32
    for producerSourceIndex in 0..<sourceCount:
        let sidecar = sidecars[producerSourceIndex]
        var sidecarErr: str
        if sidecar.sourceIndex != producerSourceIndex ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
                sidecar, sidecarErr) ||
           !compilerSnapshotBuilderCountAppendSafe(
                tokenCount, sidecar.tokenKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
                typeCount, sidecar.typeSyntaxKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
                genericCount,
                sidecar.typeGenericSymbolNameTokenIds.len):
            err = sidecarErr == "" ?
                " compiler snapshot builder: Function required parser forest invalid" :
                sidecarErr
            return false
        add(tokenBases, tokenCount)
        add(typeBases, typeCount)
        add(genericBases, genericCount)
        tokenCount = tokenCount + sidecar.tokenKinds.len
        typeCount = typeCount + sidecar.typeSyntaxKinds.len
        genericCount = genericCount +
            sidecar.typeGenericSymbolNameTokenIds.len
    if tokenCount != csg.typeArena.tokenCount ||
       typeCount != csg.typeArena.typeSyntaxCount ||
       genericCount != csg.typeArena.genericSymbolCount ||
       !compilerSnapshotProductionFunctionTypeArenaBridgeStrictValidateInto(
            csg, tokenBases, typeBases, genericBases, err):
        if err == "":
            err = " compiler snapshot builder: Function required TypeArena forest drift"
        return false
    var functionOwnerTokens: int32[]
    var functionProducerSources: int32[]
    var functionLocalRows: int32[]
    var functionByOwnerToken: int32[]
    setLen(functionOwnerTokens, functionCount)
    setLen(functionProducerSources, functionCount)
    setLen(functionLocalRows, functionCount)
    setLen(functionByOwnerToken, tokenCount)
    for functionId in 0..<functionCount:
        functionOwnerTokens[functionId] = -1
        functionProducerSources[functionId] = -1
        functionLocalRows[functionId] = -1
    for tokenId in 0..<functionByOwnerToken.len:
        functionByOwnerToken[tokenId] = -1
    var parserFunctionOwnerKinds: int32[]
    if !compilerSnapshotBuilderParserFunctionOwnerKindsBuildInto(
           sidecars,
           tokenBases,
           tokenCount,
           parserFunctionOwnerKinds,
           err):
        return false
    for producerSourceIndex in 0..<sourceCount:
        let sidecar = sidecars[producerSourceIndex]
        var tokenBySpan: int32[]
        setLen(tokenBySpan, sidecar.spanStartBytes.len)
        for spanId in 0..<tokenBySpan.len:
            tokenBySpan[spanId] = -1
        for localTokenId in 0..<sidecar.tokenSpanIds.len:
            let spanId = sidecar.tokenSpanIds[localTokenId]
            if spanId < 0 || spanId >= tokenBySpan.len ||
               tokenBySpan[spanId] >= 0:
                err = " compiler snapshot builder: Function required token/span identity split"
                return false
            tokenBySpan[spanId] = localTokenId
        for localFunctionRow in 0..<sidecar.functionIndexes.len:
            let functionId =
                sidecar.functionIndexes[localFunctionRow]
            let nameSpanId =
                sidecar.functionNameSpanIds[localFunctionRow]
            # A sidecar is one exact source: every row is implicitly the same
            # source, so the resolver's source columns stay empty here (kept
            # explicit for grep-auditable producer/consumer pairing).
            var noSpanSources: int32[]
            var noTokenSources: int32[]
            var localOwnerToken: int32
            if !compilerSnapshotBuilderFunctionNameOwnerTokenResolveInto(
                   sidecar.spanStartBytes,
                   sidecar.spanEndBytes,
                   noSpanSources,
                   noTokenSources,
                   sidecar.tokenSpanIds,
                   sidecar.tokenKinds,
                   tokenBySpan,
                   nameSpanId,
                   localOwnerToken,
                   err):
                return false
            let ownerToken =
                localOwnerToken < 0 ? -1 :
                    tokenBases[producerSourceIndex] +
                        localOwnerToken
            if functionId < 0 || functionId >= functionCount ||
               typedRowByReachable[functionId] < 0 ||
               functionOwnerTokens[functionId] >= 0 ||
               ownerToken < 0 ||
               ownerToken >= functionByOwnerToken.len ||
               functionByOwnerToken[ownerToken] >= 0 ||
               parserFunctionOwnerKinds[ownerToken] !=
                   compilerSnapshotParserFunctionOwnerExecutable:
                err = " compiler snapshot builder: Function required owner identity split"
                return false
            functionOwnerTokens[functionId] = ownerToken
            functionProducerSources[functionId] =
                producerSourceIndex
            functionLocalRows[functionId] =
                localFunctionRow
            functionByOwnerToken[ownerToken] = functionId
    for functionId in 0..<functionCount:
        if functionOwnerTokens[functionId] < 0:
            err = " compiler snapshot builder: Function required owner identity missing"
            return false
    var returnArenaTypeIds: int32[]
    var parameterStarts: int32[]
    var parameterCounts: int32[]
    var parameterArenaTypeIds: int32[]
    var parameterOwnershipKinds: int32[]
    if !compilerSnapshotBuilderTypeFunctionBindingsFromOwnerTokensInto(
           csg, functionByOwnerToken, parserFunctionOwnerKinds,
           functionCount,
           returnArenaTypeIds,
           parameterStarts,
           parameterCounts,
           parameterArenaTypeIds,
           parameterOwnershipKinds,
           err):
        return false
    var actualParameterCount: int32
    for functionId in 0..<functionCount:
        actualParameterCount =
            actualParameterCount + parameterCounts[functionId]
    if actualParameterCount != expectedParameterCount ||
       parameterArenaTypeIds.len != actualParameterCount ||
       parameterOwnershipKinds.len != actualParameterCount:
        err = " compiler snapshot builder: Function required parameter coverage drift"
        return false
    var functionGenericCounts: int32[]
    setLen(functionGenericCounts, functionCount)
    var actualGenericCount: int32
    for producerSourceIndex in 0..<sourceCount:
        let sidecar = sidecars[producerSourceIndex]
        for localGenericRow in 0..<
                sidecar.typeGenericSymbolNameTokenIds.len:
            let localOwnerToken =
                sidecar.typeGenericSymbolDeclarationOwnerTokenIds[
                    localGenericRow]
            let ownerToken =
                localOwnerToken < 0 ? -1 :
                    tokenBases[producerSourceIndex] +
                        localOwnerToken
            let functionId =
                ownerToken < 0 ||
                ownerToken >= functionByOwnerToken.len ?
                    -1 : functionByOwnerToken[ownerToken]
            if functionId >= 0:
                functionGenericCounts[functionId] =
                    functionGenericCounts[functionId] + 1
                actualGenericCount = actualGenericCount + 1
    if actualGenericCount != expectedGenericCount:
        err = " compiler snapshot builder: Function required generic coverage drift"
        return false
    var functionGenericStarts: int32[]
    var functionGenericWriteCursors: int32[]
    var genericRowCursor: int32
    for functionId in 0..<functionCount:
        add(functionGenericStarts, genericRowCursor)
        add(functionGenericWriteCursors, genericRowCursor)
        genericRowCursor =
            genericRowCursor + functionGenericCounts[functionId]
    var functionGenericRows: int32[]
    setLen(functionGenericRows, genericRowCursor)
    for producerSourceIndex in 0..<sourceCount:
        let sidecar = sidecars[producerSourceIndex]
        for localGenericRow in 0..<
                sidecar.typeGenericSymbolNameTokenIds.len:
            let localOwnerToken =
                sidecar.typeGenericSymbolDeclarationOwnerTokenIds[
                    localGenericRow]
            let ownerToken =
                localOwnerToken < 0 ? -1 :
                    tokenBases[producerSourceIndex] +
                        localOwnerToken
            let functionId =
                ownerToken < 0 ||
                ownerToken >= functionByOwnerToken.len ?
                    -1 : functionByOwnerToken[ownerToken]
            if functionId >= 0:
                let writeRow =
                    functionGenericWriteCursors[functionId]
                functionGenericRows[writeRow] =
                    genericBases[producerSourceIndex] +
                        localGenericRow
                functionGenericWriteCursors[functionId] =
                    writeRow + 1
    for functionId in 0..<functionCount:
        if functionGenericWriteCursors[functionId] !=
               functionGenericStarts[functionId] +
                   functionGenericCounts[functionId]:
            err = " compiler snapshot builder: Function required generic CSR drift"
            return false
    var buf = layout.ByteBufInit(512)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_function_required_domain")
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.receiptCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.parserNormalizedExprReceipt.envelope.receiptRaw32)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.typeArena.artifactRaw32)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendU32(buf, functionCount)
    for functionId in 0..<functionCount:
        let producerSourceIndex =
            functionProducerSources[functionId]
        let localFunctionRow =
            functionLocalRows[functionId]
        let typedFunctionRow =
            typedRowByReachable[functionId]
        if typedFunctionRow < 0 ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumePresents.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeFunctionDeclarationRows.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeTargetParameterOrdinals.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeSourceParameterOrdinals.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeTargetParameterDeclarationRows.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeSourceParameterDeclarationRows.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeTargetTypeIds.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeSourceTypeIds.len ||
           typedFunctionRow >=
               csg.typedIr.functions2_manualConsumeEffectCids.len:
            layout.ByteBufFree(buf)
            err = " compiler snapshot builder: Function required manual consume producer missing"
            return false
        compilerSnapshotBuilderHashAppendU32(buf, functionId)
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[
                functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, producerSourceIndex)
        compilerSnapshotBuilderHashAppendU32(
            buf, typedFunctionRow)
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
                functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, functionOwnerTokens[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf, returnArenaTypeIds[functionId])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            sidecars[producerSourceIndex].functionAnnotationFlags[
                localFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            sidecars[producerSourceIndex].functionManualConsumeTargetParameterOrdinals[
                localFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            sidecars[producerSourceIndex].functionManualConsumeTargetParameterDeclarationSourceLocalRows[
                localFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            sidecars[producerSourceIndex].functionManualConsumeSourceParameterOrdinals[
                localFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            sidecars[producerSourceIndex].functionManualConsumeSourceParameterDeclarationSourceLocalRows[
                localFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumePresents[
                typedFunctionRow] ? 1 : 0)
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumeFunctionDeclarationRows[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumeTargetParameterOrdinals[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumeSourceParameterOrdinals[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumeTargetParameterDeclarationRows[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumeSourceParameterDeclarationRows[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumeTargetTypeIds[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.typedIr.functions2_manualConsumeSourceTypeIds[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendCid(
            buf,
            csg.typedIr.functions2_manualConsumeEffectCids[
                typedFunctionRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, parameterCounts[functionId])
        for offset in 0..<parameterCounts[functionId]:
            let parameterRow =
                parameterStarts[functionId] + offset
            compilerSnapshotBuilderHashAppendU32(
                buf, parameterArenaTypeIds[parameterRow])
            compilerSnapshotBuilderHashAppendU32(
                buf, parameterOwnershipKinds[parameterRow])
        compilerSnapshotBuilderHashAppendU32(
            buf, functionGenericCounts[functionId])
        for offset in 0..<functionGenericCounts[functionId]:
            compilerSnapshotBuilderHashAppendU32(
                buf,
                functionGenericRows[
                    functionGenericStarts[functionId] + offset])
    outCid = compilerSnapshotBuilderHashFinish(buf)
    if !compilerSnapshotBuilderCidObserved(outCid):
        err = " compiler snapshot builder: Function required domain CID missing"
        return false
    err = ""
    return true

# Resolves every parser declaration's source-local TypeSyntax root through the
# retained TypeArena forest.  -1 is preserved only for declarations whose
# parser row has no explicit root; no name/text lookup participates.
@borrows
fn compilerSnapshotBuilderTypeDeclarationRootJoinStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    if csg.typeArena == nil ||
       sidecars.len != csg.typeArena.producerSourceCount ||
       tables.parserSidecars.sourceIds.len != sidecars.len:
        err = " compiler snapshot builder: Type declaration root source domain invalid"
        return false
    var tokenBases: int32[]
    var typeBases: int32[]
    var tokenCursor: int32
    var typeCursor: int32
    for producer in 0..<sidecars.len:
        add(tokenBases, tokenCursor)
        add(typeBases, typeCursor)
        if !compilerSnapshotBuilderCountAppendSafe(
               tokenCursor, sidecars[producer].tokenKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               typeCursor, sidecars[producer].typeSyntaxKinds.len):
            err = " compiler snapshot builder: Type declaration root forest overflow"
            return false
        tokenCursor = tokenCursor + sidecars[producer].tokenKinds.len
        typeCursor = typeCursor + sidecars[producer].typeSyntaxKinds.len
    if tokenCursor != csg.typeArena.tokenCount ||
       typeCursor != csg.typeArena.typeSyntaxCount:
        err = " compiler snapshot builder: Type declaration root forest coverage invalid"
        return false
    var rootSeen: bool[]
    setLen(rootSeen, csg.typeArena.typeSyntaxCount)
    var declarationCount: int32
    for declarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        if tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationType):
            continue
        declarationCount = declarationCount + 1
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        if sourceId < 0 ||
           sourceId >= tables.parserSidecars.producerSourceIndexes.len:
            err = " compiler snapshot builder: Type declaration root source invalid"
            return false
        let producer =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        let localDeclaration =
            tables.parserSidecars.declarationSourceLocalRows[
                declarationRow]
        if producer < 0 || producer >= sidecars.len ||
           localDeclaration < 0 ||
           localDeclaration >= sidecars[producer].declarationKinds.len ||
           sidecars[producer].declarationKinds[localDeclaration] !=
               Int32(parser.ParserDeclarationType):
            err = " compiler snapshot builder: Type declaration producer join invalid"
            return false
        let snapshotRoot =
            tables.parserSidecars.declarationTypeSyntaxRootIds[
                declarationRow]
        let sidecarRoot =
            sidecars[producer].declarationTypeSyntaxRootIds[
                localDeclaration]
        var snapshotTypeBase: int32 = -1
        for candidate in 0..<tables.parserSidecars.typeSyntaxSourceIds.len:
            if tables.parserSidecars.typeSyntaxSourceIds[candidate] ==
                   sourceId:
                snapshotTypeBase = candidate
                break
        let localNameToken =
            sidecars[producer].declarationNameTokenIds[localDeclaration]
        if snapshotTypeBase < 0 || sidecarRoot < 0 ||
           sidecarRoot >= sidecars[producer].typeSyntaxKinds.len ||
           snapshotRoot != snapshotTypeBase + sidecarRoot ||
           sidecars[producer].typeSyntaxSourceIds[sidecarRoot] != producer ||
           sidecars[producer].typeSyntaxProducerSourceIds[sidecarRoot] !=
               producer ||
           sidecars[producer].typeSyntaxRootKinds[sidecarRoot] !=
               Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) ||
           sidecars[producer].typeSyntaxOwnerTokenIds[sidecarRoot] !=
               localNameToken ||
           sidecars[producer].typeSyntaxDeclarationOwnerTokenIds[
               sidecarRoot] != localNameToken ||
           sidecars[producer].typeSyntaxDeclarationOwnerIds[sidecarRoot] !=
               sidecarRoot:
            err = " compiler snapshot builder: parser Type declaration root join drift"
            return false
        let globalRoot = typeBases[producer] + sidecarRoot
        let globalNameToken = tokenBases[producer] + localNameToken
        if globalRoot < 0 ||
           globalRoot >= csg.typeArena.typeSyntaxCount ||
           rootSeen[globalRoot] ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxProducerSourceIndexes,
               globalRoot) != producer ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxRootKinds,
               globalRoot) !=
                   Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxOwnerTokenIndexes,
               globalRoot) != globalNameToken ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxDeclarationOwnerTokenIndexes,
               globalRoot) != globalNameToken ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxDeclarationOwnerNodeIndexes,
               globalRoot) != globalRoot:
            err = " compiler snapshot builder: TypeArena Type declaration root join drift"
            return false
        rootSeen[globalRoot] = true
    var rootCount: int32
    for producer in 0..<sidecars.len:
        for localRoot in 0..<sidecars[producer].typeSyntaxKinds.len:
            if sidecars[producer].typeSyntaxRootKinds[localRoot] !=
                   Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
                continue
            rootCount = rootCount + 1
            if !rootSeen[typeBases[producer] + localRoot]:
                err = " compiler snapshot builder: Type declaration root coverage incomplete"
                return false
    if rootCount != declarationCount:
        err = " compiler snapshot builder: Type declaration root coverage drift"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderDeclarationArenaTypeIdsInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        typeIds: var int32[],
        typeSyntaxRows: var int32[],
        err: var str): bool =
    typeIds = []
    typeSyntaxRows = []
    if csg.typeArena == nil ||
       csg.typeArena.producerSourceCount !=
           tables.parserSidecars.sourceIds.len:
        err = " compiler snapshot builder: declaration TypeArena source domain invalid"
        return false
    if !compilerSnapshotBuilderTypeDeclarationRootJoinStrictValidateInto(
           tables, sidecars, csg, err):
        return false
    let sourceCount = tables.parserSidecars.sourceIds.len
    var snapshotTypeStarts: int32[]
    var snapshotTypeCounts: int32[]
    var arenaTypeStarts: int32[]
    var arenaTypeCounts: int32[]
    setLen(snapshotTypeStarts, sourceCount)
    setLen(snapshotTypeCounts, sourceCount)
    setLen(arenaTypeStarts, sourceCount)
    setLen(arenaTypeCounts, sourceCount)
    for source in 0..<sourceCount:
        snapshotTypeStarts[source] = -1
        arenaTypeStarts[source] = -1
    var previousSource: int32 = -1
    for snapshotTypeRow in 0..<
            tables.parserSidecars.typeSyntaxSourceIds.len:
        let source =
            tables.parserSidecars.typeSyntaxSourceIds[snapshotTypeRow]
        if source < 0 || source >= sourceCount ||
           source < previousSource ||
           (source != previousSource &&
            snapshotTypeStarts[source] >= 0):
            err = " compiler snapshot builder: declaration snapshot TypeSyntax order invalid"
            return false
        if snapshotTypeStarts[source] < 0:
            snapshotTypeStarts[source] = snapshotTypeRow
        snapshotTypeCounts[source] =
            snapshotTypeCounts[source] + 1
        previousSource = source
    var previousProducer: int32 = -1
    for globalTypeRow in 0..<csg.typeArena.typeSyntaxCount:
        let producer = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxProducerSourceIndexes,
            globalTypeRow)
        if producer < 0 || producer >= sourceCount ||
           producer < previousProducer:
            err = " compiler snapshot builder: declaration TypeSyntax producer order invalid"
            return false
        if arenaTypeStarts[producer] < 0:
            arenaTypeStarts[producer] = globalTypeRow
        arenaTypeCounts[producer] =
            arenaTypeCounts[producer] + 1
        previousProducer = producer
    for producer in 0..<sourceCount:
        if arenaTypeCounts[producer] > 0 &&
           arenaTypeStarts[producer] < 0:
            err = " compiler snapshot builder: declaration TypeSyntax producer coverage invalid"
            return false
    for source in 0..<sourceCount:
        let producer =
            tables.parserSidecars.producerSourceIndexes[source]
        if producer < 0 || producer >= sourceCount ||
           snapshotTypeCounts[source] !=
               arenaTypeCounts[producer]:
            err = " compiler snapshot builder: declaration TypeSyntax source crosswalk drift"
            return false
    for declarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        let sourceId = tables.parserSidecars.declarationProducerSourceIds[declarationRow]
        let snapshotTypeRoot =
            tables.parserSidecars.declarationTypeSyntaxRootIds[
                declarationRow]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: declaration source row invalid"
            return false
        let producer = tables.parserSidecars.producerSourceIndexes[sourceId]
        if producer < 0 || producer >= sourceCount:
            err = " compiler snapshot builder: declaration producer source missing"
            return false
        if snapshotTypeRoot < 0:
            add(typeIds, -1)
            add(typeSyntaxRows, -1)
            continue
        if snapshotTypeRoot < snapshotTypeStarts[sourceId] ||
           snapshotTypeRoot >=
               snapshotTypeStarts[sourceId] +
                   snapshotTypeCounts[sourceId]:
            err = " compiler snapshot builder: declaration TypeSyntax root out of range"
            return false
        let sourceLocalTypeRow =
            snapshotTypeRoot - snapshotTypeStarts[sourceId]
        let globalTypeRow =
            arenaTypeStarts[producer] + sourceLocalTypeRow
        let arenaTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxTypeIds,
            globalTypeRow)
        if globalTypeRow < 0 ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxProducerSourceIndexes,
               globalTypeRow) != producer ||
           arenaTypeId < 0 || arenaTypeId >= csg.typeArena.typeCount:
            err = " compiler snapshot builder: declaration TypeId authority missing"
            return false
        add(typeIds, arenaTypeId)
        add(typeSyntaxRows, globalTypeRow)
    if typeIds.len != tables.parserSidecars.declarationKinds.len ||
       typeSyntaxRows.len != tables.parserSidecars.declarationKinds.len:
        err = " compiler snapshot builder: declaration TypeId coverage mismatch"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderFunctionSignatureEqual(
        leftFunctionId: int32,
        rightFunctionId: int32,
        returns: int32[],
        paramStarts: int32[],
        paramCounts: int32[],
        params: int32[]): bool =
    if returns[leftFunctionId] != returns[rightFunctionId] ||
       paramCounts[leftFunctionId] != paramCounts[rightFunctionId]:
        return false
    for offset in 0..<paramCounts[leftFunctionId]:
        if params[paramStarts[leftFunctionId] + offset] !=
               params[paramStarts[rightFunctionId] + offset]:
            return false
    return true

fn compilerSnapshotBuilderAppendFunctionTypeRow(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        returnTypeId: int32,
        paramTypeIds: int32[],
        paramStart: int32,
        paramCount: int32,
        canonicalTextId: int32) =
    add(tables.types.typeCids, layout.FixedBytes32())
    add(tables.types.producerTypeArenaIds, -1)
    add(tables.types.canonicalTextIds, canonicalTextId)
    add(tables.types.typeKinds, snapshot_schema.CsgCompilerTypeFunction)
    add(tables.types.scalarKinds, 0)
    add(tables.types.declSymbolIds, -1)
    add(tables.types.elementTypeIds, returnTypeId)
    add(tables.types.arrayLengths, -1)
    add(tables.types.argStarts, tables.types.argTypeIds.len)
    add(tables.types.argCounts, paramCount)
    for offset in 0..<paramCount:
        add(tables.types.argTypeIds,
            paramTypeIds[paramStart + offset])
        add(tables.types.argNameTextIds, -1)
    add(tables.types.constArgStarts, tables.types.constArgKinds.len)
    add(tables.types.constArgCounts, 0)
    add(tables.types.aliasTargetTypeIds, -1)
    add(tables.types.genericParameterParserRows, -1)
    add(tables.types.managedFlags, false)
    add(tables.types.sendFlags, false)
    add(tables.types.syncFlags, false)
    add(tables.types.traitConclusionKinds,
        snapshot_schema.CsgCompilerTraitConclusionNone)
    add(tables.types.traitProofKinds,
        snapshot_schema.CsgCompilerTraitProofStructural)
    add(tables.types.traitProofCids, layout.FixedBytes32())
    add(tables.types.traitPremiseStarts,
        tables.types.traitPremiseTypeIds.len)
    add(tables.types.traitPremiseCounts, paramCount + 1)
    add(tables.types.traitPremiseTypeIds, returnTypeId)
    for offset in 0..<paramCount:
        add(tables.types.traitPremiseTypeIds,
            paramTypeIds[paramStart + offset])
    # [phaseB-enum-schema] Synthesized signature rows carry zero variant
    # payload rows; only CsgCompilerTypeEnum rows own the variant CSR.
    add(tables.types.variantStarts, tables.types.variantNameTextIds.len)
    add(tables.types.variantCounts, 0)

@borrows
fn compilerSnapshotBuilderTypeOrderSiftDown(
        types: snapshot_schema.CsgCompilerTypeTable,
        order: var int32[],
        start: int32,
        count: int32) =
    var root = start
    while root >= 0 && root < count:
        let left = root * 2 + 1
        if left >= count:
            return
        var selected = left
        let right = left + 1
        if right < count && compilerSnapshotBuilderCidLess(
               types.typeCids[order[selected]],
               types.typeCids[order[right]]):
            selected = right
        if !compilerSnapshotBuilderCidLess(
               types.typeCids[order[root]],
               types.typeCids[order[selected]]):
            return
        let saved = order[root]
        order[root] = order[selected]
        order[selected] = saved
        root = selected

@borrows
fn compilerSnapshotBuilderTypeOrderSort(
        types: snapshot_schema.CsgCompilerTypeTable,
        order: var int32[]) =
    setLen(order, types.typeCids.len)
    for row in 0..<order.len:
        order[row] = row
    let parentCount = order.len / 2
    for reverse in 0..<parentCount:
        compilerSnapshotBuilderTypeOrderSiftDown(
            types, order, parentCount - 1 - reverse, order.len)
    if order.len <= 1:
        return
    for reverse in 0..<order.len - 1:
        let endExclusive = order.len - reverse
        let saved = order[0]
        order[0] = order[endExclusive - 1]
        order[endExclusive - 1] = saved
        compilerSnapshotBuilderTypeOrderSiftDown(
            types, order, 0, endExclusive - 1)

@borrows
fn compilerSnapshotBuilderTypeArenaBridgeStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    if csg.typeArena == nil:
        err = " compiler snapshot builder: producer TypeArena missing"
        return false
    let typeCount = tables.types.typeCids.len
    let arenaTypeCount = csg.typeArena.typeCount
    if tables.types.producerTypeArenaIds.len != typeCount ||
       arenaTypeCount <= 0 || arenaTypeCount > typeCount:
        err = " compiler snapshot builder: producer TypeArena bridge shape drift"
        return false
    var typeIdByArenaTypeId: int32[]
    setLen(typeIdByArenaTypeId, arenaTypeCount)
    for arenaTypeId in 0..<arenaTypeCount:
        typeIdByArenaTypeId[arenaTypeId] = -1
    for typeId in 0..<typeCount:
        let arenaTypeId =
            tables.types.producerTypeArenaIds[typeId]
        if arenaTypeId == -1:
            if tables.types.typeKinds[typeId] !=
                   snapshot_schema.CsgCompilerTypeFunction:
                err = " compiler snapshot builder: non-signature Type lost producer TypeArenaId"
                return false
            continue
        if arenaTypeId < 0 || arenaTypeId >= arenaTypeCount ||
           tables.types.typeKinds[typeId] ==
               snapshot_schema.CsgCompilerTypeFunction ||
           typeIdByArenaTypeId[arenaTypeId] >= 0:
            err = " compiler snapshot builder: producer TypeArena bridge is not bijective"
            return false
        typeIdByArenaTypeId[arenaTypeId] = typeId
    for arenaTypeId in 0..<arenaTypeCount:
        if typeIdByArenaTypeId[arenaTypeId] < 0:
            err = " compiler snapshot builder: producer TypeArena row not covered"
            return false
    for arenaTypeId in 0..<arenaTypeCount:
        let typeId = typeIdByArenaTypeId[arenaTypeId]
        let arenaKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeKinds,
            arenaTypeId)
        let childStart = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childStarts,
            arenaTypeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childCounts,
            arenaTypeId)
        var expectedSchemaKind: int32
        if arenaKind ==
               Int32(typearena.TypedExprStructuralTypeScalar):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeScalar
            if childCount != 0 ||
               tables.types.scalarKinds[typeId] !=
                   compilerSnapshotBuilderSchemaScalarKind(
                       arenamod.ArenaArrayInt32Get(
                           csg.typeArena.arena,
                           csg.typeArena.scalarKinds,
                           arenaTypeId)):
                err = " compiler snapshot builder: scalar TypeArena bridge drift"
                return false
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeBorrow):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeBorrow
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeSequence):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeSequence
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeFixedArray):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeArray
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeTuple):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeTuple
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeObject):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeObject
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeRefObject):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeRefObject
        elif arenaKind == Int32(typearena.TypedExprStructuralTypeEnum):
            # [phaseB-enum-schema] Enum rows join the arena<->schema kind
            # bijection as nominal CsgCompilerTypeEnum rows; their child
            # rows are the payload-bearing variants and ride the variant
            # payload CSR, not the arg CSR.
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeEnum
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeAlias):
            expectedSchemaKind = snapshot_schema.CsgCompilerTypeAlias
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeGenericParameter):
            expectedSchemaKind =
                snapshot_schema.CsgCompilerTypeGenericParameter
            if childCount != 0:
                err = " compiler snapshot builder: generic TypeArena bridge has children"
                return false
        else:
            err = " compiler snapshot builder: unsupported producer TypeArena kind"
            return false
        if tables.types.typeKinds[typeId] != expectedSchemaKind:
            err = " compiler snapshot builder: producer TypeArena kind bridge drift"
            return false
        if arenaKind ==
               Int32(typearena.TypedExprStructuralTypeBorrow) ||
           arenaKind ==
               Int32(typearena.TypedExprStructuralTypeSequence) ||
           arenaKind ==
               Int32(typearena.TypedExprStructuralTypeFixedArray) ||
           arenaKind ==
               Int32(typearena.TypedExprStructuralTypeAlias):
            if childCount != 1:
                err = " compiler snapshot builder: unary producer TypeArena row invalid"
                return false
            let childArenaTypeId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childTypeIds,
                childStart)
            if childArenaTypeId < 0 ||
               childArenaTypeId >= arenaTypeCount:
                err = " compiler snapshot builder: producer TypeArena child invalid"
                return false
            let childTypeId =
                typeIdByArenaTypeId[childArenaTypeId]
            if arenaKind ==
                   Int32(typearena.TypedExprStructuralTypeAlias):
                if tables.types.aliasTargetTypeIds[typeId] !=
                       childTypeId:
                    err = " compiler snapshot builder: alias target TypeArena bridge drift"
                    return false
            elif tables.types.elementTypeIds[typeId] != childTypeId:
                err = " compiler snapshot builder: unary TypeArena child bridge drift"
                return false
            if arenaKind ==
                   Int32(typearena.TypedExprStructuralTypeFixedArray) &&
               tables.types.arrayLengths[typeId] !=
                   arenamod.ArenaArrayInt32Get(
                       csg.typeArena.arena,
                       csg.typeArena.fixedLengths,
                       arenaTypeId):
                err = " compiler snapshot builder: fixed-array TypeArena length drift"
                return false
        elif arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeTuple) ||
             arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeObject) ||
             arenaKind ==
                 Int32(typearena.TypedExprStructuralTypeRefObject):
            let argStart = tables.types.argStarts[typeId]
            if tables.types.argCounts[typeId] != childCount ||
               argStart < 0 ||
               argStart > tables.types.argTypeIds.len ||
               childCount >
                   tables.types.argTypeIds.len - argStart ||
               argStart > tables.types.argNameTextIds.len ||
               childCount >
                   tables.types.argNameTextIds.len - argStart:
                err = " compiler snapshot builder: aggregate TypeArena child shape drift"
                return false
            for offset in 0..<childCount:
                let childArenaTypeId =
                    arenamod.ArenaArrayInt32Get(
                        csg.typeArena.arena,
                        csg.typeArena.childTypeIds,
                        childStart + offset)
                if childArenaTypeId < 0 ||
                   childArenaTypeId >= arenaTypeCount ||
                   tables.types.argTypeIds[argStart + offset] !=
                       typeIdByArenaTypeId[childArenaTypeId]:
                    err = " compiler snapshot builder: aggregate TypeArena child bridge drift"
                    return false
                let childNameId =
                    arenamod.ArenaArrayInt32Get(
                        csg.typeArena.arena,
                        csg.typeArena.childNameIds,
                        childStart + offset)
                let childNameTextId =
                    tables.types.argNameTextIds[argStart + offset]
                if childNameId < 0:
                    if childNameTextId != -1:
                        err = " compiler snapshot builder: unnamed TypeArena child gained a name"
                        return false
                else:
                    let childNameResult = langintern.LookupIntern(
                        csg.typeArena.internPool, childNameId)
                    if !IsOk(childNameResult) ||
                       childNameTextId < 0 ||
                       childNameTextId >= tables.texts.len ||
                       tables.texts[childNameTextId] !=
                           Value(childNameResult):
                        err = " compiler snapshot builder: TypeArena child name bridge drift"
                        return false
        if tables.types.managedFlags[typeId] !=
               (arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.managedFlags,
                    arenaTypeId) == 1) ||
           tables.types.sendFlags[typeId] !=
               (arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.sendFlags,
                    arenaTypeId) == 1) ||
           tables.types.syncFlags[typeId] !=
               (arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.syncFlags,
                    arenaTypeId) == 1):
            err = " compiler snapshot builder: TypeArena trait bridge drift"
            return false
        let arenaPremiseStart =
            arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.traitPremiseStarts,
                arenaTypeId)
        let arenaPremiseCount =
            arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.traitPremiseCounts,
                arenaTypeId)
        let premiseStart =
            tables.types.traitPremiseStarts[typeId]
        if tables.types.traitPremiseCounts[typeId] !=
               arenaPremiseCount ||
           premiseStart < 0 ||
           premiseStart >
               tables.types.traitPremiseTypeIds.len ||
           arenaPremiseCount >
               tables.types.traitPremiseTypeIds.len -
                   premiseStart:
            err = " compiler snapshot builder: TypeArena trait premise shape drift"
            return false
        for offset in 0..<arenaPremiseCount:
            let premiseArenaTypeId =
                arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.traitPremiseTypeIds,
                    arenaPremiseStart + offset)
            if premiseArenaTypeId < 0 ||
               premiseArenaTypeId >= arenaTypeCount ||
               tables.types.traitPremiseTypeIds[
                   premiseStart + offset] !=
                   typeIdByArenaTypeId[premiseArenaTypeId]:
                err = " compiler snapshot builder: TypeArena trait premise bridge drift"
                return false
    err = ""
    return true

fn compilerSnapshotBuilderTypeTableCanonicalizeInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        newTypeIdByOld: var int32[],
        err: var str): bool =
    let oldTypes = tables.types
    var order: int32[]
    compilerSnapshotBuilderTypeOrderSort(oldTypes, order)
    for row in 1..<order.len:
        if !compilerSnapshotBuilderCidLess(
               oldTypes.typeCids[order[row - 1]],
               oldTypes.typeCids[order[row]]):
            err = " compiler snapshot builder: duplicate structural type identity"
            return false
    setLen(newTypeIdByOld, order.len)
    for newTypeId in 0..<order.len:
        newTypeIdByOld[order[newTypeId]] = newTypeId
    var canonical: snapshot_schema.CsgCompilerTypeTable
    for newTypeId in 0..<order.len:
        let oldTypeId = order[newTypeId]
        add(canonical.typeCids, oldTypes.typeCids[oldTypeId])
        add(canonical.producerTypeArenaIds,
            oldTypes.producerTypeArenaIds[oldTypeId])
        add(canonical.canonicalTextIds,
            oldTypes.canonicalTextIds[oldTypeId])
        add(canonical.typeKinds, oldTypes.typeKinds[oldTypeId])
        add(canonical.scalarKinds, oldTypes.scalarKinds[oldTypeId])
        add(canonical.declSymbolIds, oldTypes.declSymbolIds[oldTypeId])
        let oldElement = oldTypes.elementTypeIds[oldTypeId]
        add(canonical.elementTypeIds,
            oldElement < 0 ? -1 : newTypeIdByOld[oldElement])
        add(canonical.arrayLengths, oldTypes.arrayLengths[oldTypeId])
        add(canonical.argStarts, canonical.argTypeIds.len)
        add(canonical.argCounts, oldTypes.argCounts[oldTypeId])
        for offset in 0..<oldTypes.argCounts[oldTypeId]:
            let oldArgRow = oldTypes.argStarts[oldTypeId] + offset
            add(canonical.argTypeIds,
                newTypeIdByOld[oldTypes.argTypeIds[oldArgRow]])
            add(canonical.argNameTextIds,
                oldTypes.argNameTextIds[oldArgRow])
        add(canonical.constArgStarts, canonical.constArgKinds.len)
        add(canonical.constArgCounts,
            oldTypes.constArgCounts[oldTypeId])
        for offset in 0..<oldTypes.constArgCounts[oldTypeId]:
            let oldConstRow = oldTypes.constArgStarts[oldTypeId] + offset
            add(canonical.constArgKinds,
                oldTypes.constArgKinds[oldConstRow])
            add(canonical.constArgValues,
                oldTypes.constArgValues[oldConstRow])
        let oldAlias = oldTypes.aliasTargetTypeIds[oldTypeId]
        add(canonical.aliasTargetTypeIds,
            oldAlias < 0 ? -1 : newTypeIdByOld[oldAlias])
        add(canonical.genericParameterParserRows,
            oldTypes.genericParameterParserRows[oldTypeId])
        add(canonical.managedFlags, oldTypes.managedFlags[oldTypeId])
        add(canonical.sendFlags, oldTypes.sendFlags[oldTypeId])
        add(canonical.syncFlags, oldTypes.syncFlags[oldTypeId])
        add(canonical.traitConclusionKinds,
            oldTypes.traitConclusionKinds[oldTypeId])
        add(canonical.traitProofKinds,
            oldTypes.traitProofKinds[oldTypeId])
        add(canonical.traitProofCids,
            oldTypes.traitProofCids[oldTypeId])
        add(canonical.traitPremiseStarts,
            canonical.traitPremiseTypeIds.len)
        add(canonical.traitPremiseCounts,
            oldTypes.traitPremiseCounts[oldTypeId])
        for offset in 0..<oldTypes.traitPremiseCounts[oldTypeId]:
            add(canonical.traitPremiseTypeIds, newTypeIdByOld[
                oldTypes.traitPremiseTypeIds[
                    oldTypes.traitPremiseStarts[oldTypeId] + offset]])
        # [phaseB-enum-schema] The enum variant payload CSR must survive the
        # canonical row reorder exactly like the arg/constArg/premise CSRs;
        # payload TypeIds remap through the same old->new bijection.
        add(canonical.variantStarts, canonical.variantNameTextIds.len)
        add(canonical.variantCounts, oldTypes.variantCounts[oldTypeId])
        for offset in 0..<oldTypes.variantCounts[oldTypeId]:
            let oldVariantRow = oldTypes.variantStarts[oldTypeId] + offset
            add(canonical.variantNameTextIds,
                oldTypes.variantNameTextIds[oldVariantRow])
            add(canonical.variantOrdinals,
                oldTypes.variantOrdinals[oldVariantRow])
            let oldPayload = oldTypes.variantPayloadTypeIds[oldVariantRow]
            add(canonical.variantPayloadTypeIds,
                oldPayload < 0 ? -1 : newTypeIdByOld[oldPayload])
    tables.types = canonical
    for typeId in 0..<tables.types.typeCids.len:
        var expectedProof: layout.FixedBytes32
        var expectedTypeCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
               tables, typeId, expectedProof, err) ||
           !layout.FixedBytes32Equal(
               expectedProof, tables.types.traitProofCids[typeId]) ||
           !snapshot_schema.CsgCompilerTypeRowCidInto(
               tables, typeId, expectedTypeCid, err) ||
           !layout.FixedBytes32Equal(
               expectedTypeCid, tables.types.typeCids[typeId]):
            if err == "":
                err = " compiler snapshot builder: TypeId remap changed type identity"
            return false
    return true

@borrows
fn compilerSnapshotBuilderReadObservedCidInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        domainKind: int32,
        portableKeyCid: layout.FixedBytes32,
        out: var layout.FixedBytes32): bool =
    out = layout.FixedBytes32()
    if domainKind == snapshot_schema.CsgCompilerReadDomainSourceInterface:
        let sourceId = compilerSnapshotBuilderCidFind(
            tables.sources.documentCids, portableKeyCid)
        if sourceId >= 0:
            out = tables.sources.interfaceCids[sourceId]
    elif domainKind == snapshot_schema.CsgCompilerReadDomainSymbolInterface:
        let symbolId = compilerSnapshotBuilderCidFind(
            tables.symbols.symbolCids, portableKeyCid)
        if symbolId >= 0:
            out = tables.symbols.interfaceCids[symbolId]
    elif domainKind == snapshot_schema.CsgCompilerReadDomainTypeIdentity:
        let typeId = compilerSnapshotBuilderCidFind(
            tables.types.typeCids, portableKeyCid)
        if typeId >= 0:
            out = tables.types.typeCids[typeId]
    elif domainKind == snapshot_schema.CsgCompilerReadDomainLayout:
        for layoutId in 0..<tables.layouts.typeIds.len:
            let typeId = tables.layouts.typeIds[layoutId]
            if layoutId < tables.layouts.layoutCids.len && typeId >= 0 &&
               typeId < tables.types.typeCids.len &&
               layout.FixedBytes32Equal(
                   tables.types.typeCids[typeId], portableKeyCid):
                out = tables.layouts.layoutCids[layoutId]
    return compilerSnapshotBuilderCidObserved(out)

fn compilerSnapshotBuilderInterfaceReadsRebuildInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    for readRow in 0..<tables.readSet.readerFunctionIds.len:
        var observed: layout.FixedBytes32
        if !compilerSnapshotBuilderReadObservedCidInto(
               tables,
               tables.readSet.targetDomainKinds[readRow],
               tables.readSet.targetPortableKeyCids[readRow],
               observed):
            err = " compiler snapshot builder: read target missing after type projection"
            return false
        tables.readSet.observedValueCids[readRow] = observed
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        var preimage: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerReadSetPreimageCidInto(
               tables.symbols.symbolCids[symbolId],
               tables.readSet.targetDomainKinds,
               tables.readSet.targetPortableKeyCids,
               tables.readSet.observedValueCids,
               tables.functions.readStarts[functionId],
               tables.functions.readCounts[functionId],
               preimage,
               err):
            return false
        tables.functions.readSetPreimageCids[functionId] = preimage
    return snapshot_schema.CsgCompilerReadSetReverseBuildInto(tables, err)

fn compilerSnapshotBuilderReadRowsCanonicalizeInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables) =
    for functionId in 0..<tables.functions.readStarts.len:
        let start = tables.functions.readStarts[functionId]
        let count = tables.functions.readCounts[functionId]
        for offset in 1..<count:
            let row = start + offset
            let reader = tables.readSet.readerFunctionIds[row]
            let domain = tables.readSet.targetDomainKinds[row]
            let key = tables.readSet.targetPortableKeyCids[row]
            let observed = tables.readSet.observedValueCids[row]
            var cursor = row
            while cursor > start:
                let previous = cursor - 1
                let previousDomain =
                    tables.readSet.targetDomainKinds[previous]
                let previousKey =
                    tables.readSet.targetPortableKeyCids[previous]
                let ordered = previousDomain < domain ||
                    (previousDomain == domain &&
                     compilerSnapshotBuilderCidLess(previousKey, key))
                if ordered:
                    break
                tables.readSet.readerFunctionIds[cursor] =
                    tables.readSet.readerFunctionIds[previous]
                tables.readSet.targetDomainKinds[cursor] = previousDomain
                tables.readSet.targetPortableKeyCids[cursor] = previousKey
                tables.readSet.observedValueCids[cursor] =
                    tables.readSet.observedValueCids[previous]
                cursor = previous
            tables.readSet.readerFunctionIds[cursor] = reader
            tables.readSet.targetDomainKinds[cursor] = domain
            tables.readSet.targetPortableKeyCids[cursor] = key
            tables.readSet.observedValueCids[cursor] = observed

@borrows
fn compilerSnapshotBuilderSymbolIdRemapOptional(
        oldId: int32,
        newByOld: int32[]): int32 =
    return oldId < 0 ? -1 : newByOld[oldId]

fn compilerSnapshotBuilderParserFunctionBaseForSource(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sourceId: int32): int32 =
    var base: int32
    for parserRow in 0..<tables.parserSidecars.functionDeclarationSpanIds.len:
        let spanId =
            tables.parserSidecars.functionDeclarationSpanIds[parserRow]
        if spanId >= 0 && spanId < tables.spans.sourceIds.len &&
           tables.spans.sourceIds[spanId] < sourceId:
            base = base + 1
    return base

@borrows
fn compilerSnapshotBuilderDeclarationNameProofCidInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        declarationRow: int32,
        proofCid: var layout.FixedBytes32,
        err: var str): bool =
    proofCid = layout.FixedBytes32()
    if declarationRow < 0 ||
       declarationRow >= tables.parserSidecars.declarationKinds.len:
        err = " compiler snapshot builder: declaration name proof row invalid"
        return false
    let sourceId =
        tables.parserSidecars.declarationProducerSourceIds[declarationRow]
    let sourceLocalRow =
        tables.parserSidecars.declarationSourceLocalRows[declarationRow]
    let nameTokenId =
        tables.parserSidecars.declarationNameTokenIds[declarationRow]
    let nameSpanId =
        tables.parserSidecars.declarationNameSpanIds[declarationRow]
    let declarationSpanId =
        tables.parserSidecars.declarationSpanIds[declarationRow]
    if sourceId < 0 || sourceId >= tables.sources.documentCids.len ||
       sourceLocalRow < 0 ||
       nameTokenId < 0 || nameTokenId >= tables.tokens.sourceIds.len ||
       nameSpanId < 0 || nameSpanId >= tables.spans.sourceIds.len ||
       declarationSpanId < 0 ||
       declarationSpanId >= tables.spans.sourceIds.len ||
       tables.tokens.sourceIds[nameTokenId] != sourceId ||
       tables.tokens.spanIds[nameTokenId] != nameSpanId ||
       tables.spans.sourceIds[nameSpanId] != sourceId ||
       tables.spans.sourceIds[declarationSpanId] != sourceId ||
       tables.spans.startBytes[nameSpanId] >=
           tables.spans.endBytes[nameSpanId] ||
       tables.spans.startBytes[declarationSpanId] >=
           tables.spans.endBytes[declarationSpanId] ||
       tables.spans.startBytes[nameSpanId] <
           tables.spans.startBytes[declarationSpanId] ||
       tables.spans.endBytes[nameSpanId] >
           tables.spans.endBytes[declarationSpanId]:
        err = " compiler snapshot builder: declaration name coordinate authority drift"
        return false
    let nameTextId = tables.tokens.valueTextIds[nameTokenId]
    if nameTextId < 0 || nameTextId >= tables.texts.len:
        err = " compiler snapshot builder: declaration name text missing"
        return false
    var buf = layout.ByteBufInit(192)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler_snapshot.parser_declaration_name_proof")
    compilerSnapshotBuilderHashAppendCid(
        buf, tables.sources.documentCids[sourceId])
    compilerSnapshotBuilderHashAppendU32(buf, sourceLocalRow)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.parserSidecars.declarationKinds[declarationRow])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.tokens.kinds[nameTokenId])
    compilerSnapshotBuilderHashAppendText(
        buf, tables.texts[nameTextId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.spans.startBytes[nameSpanId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.spans.endBytes[nameSpanId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.spans.startBytes[declarationSpanId])
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.spans.endBytes[declarationSpanId])
    proofCid = compilerSnapshotBuilderHashFinish(buf)
    err = ""
    return true

fn compilerSnapshotBuilderDeclarationTypeSyntaxProofCidInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        declarationRow: int32,
        proofCid: var layout.FixedBytes32,
        err: var str): bool =
    proofCid = layout.FixedBytes32()
    if declarationRow < 0 ||
       declarationRow >= tables.parserSidecars.declarationKinds.len:
        err = " compiler snapshot builder: declaration TypeSyntax proof row invalid"
        return false
    let sourceId =
        tables.parserSidecars.declarationProducerSourceIds[declarationRow]
    let sourceLocalRow =
        tables.parserSidecars.declarationSourceLocalRows[declarationRow]
    let localTypeRoot =
        tables.parserSidecars.declarationTypeSyntaxRootIds[declarationRow]
    if sourceId < 0 || sourceId >= tables.sources.documentCids.len ||
       sourceLocalRow < 0 || localTypeRoot < 0:
        err = " compiler snapshot builder: declaration TypeSyntax proof identity missing"
        return false
    var buf = layout.ByteBufInit(128)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler_snapshot.parser_type_syntax_proof")
    compilerSnapshotBuilderHashAppendCid(
        buf, tables.sources.documentCids[sourceId])
    compilerSnapshotBuilderHashAppendU32(buf, sourceLocalRow)
    compilerSnapshotBuilderHashAppendU32(
        buf, tables.parserSidecars.declarationKinds[declarationRow])
    compilerSnapshotBuilderHashAppendU32(buf, localTypeRoot)
    proofCid = compilerSnapshotBuilderHashFinish(buf)
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderPortableTypeProjectionBuildInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        out: var CompilerSnapshotPortableTypeProjection,
        err: var str): bool =
    out = CompilerSnapshotPortableTypeProjection()
    var declarationArenaTypeIds: int32[]
    var declarationArenaTypeSyntaxRows: int32[]
    if !compilerSnapshotBuilderDeclarationArenaTypeIdsInto(
           tables, sidecars, csg,
           declarationArenaTypeIds,
           declarationArenaTypeSyntaxRows,
           err):
        return false
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    if declarationArenaTypeIds.len != declarationCount ||
       declarationArenaTypeSyntaxRows.len != declarationCount:
        err = " compiler snapshot builder: portable Type projection declaration shape invalid"
        return false
    for declarationRow in 0..<declarationCount:
        let declarationKind =
            tables.parserSidecars.declarationKinds[declarationRow]
        let typeDeclaration =
            declarationKind ==
                Int32(parser.ParserDeclarationType)
        let fieldDeclaration =
            declarationKind ==
                Int32(parser.ParserDeclarationField)
        if !typeDeclaration && !fieldDeclaration:
            continue
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        var producerSourceIndex: int32 = -1
        if sourceId >= 0 &&
           sourceId <
               tables.parserSidecars.producerSourceIndexes.len:
            producerSourceIndex =
                tables.parserSidecars.producerSourceIndexes[sourceId]
        let sourceLocalDeclarationRow =
            tables.parserSidecars.declarationSourceLocalRows[
                declarationRow]
        let arenaTypeId =
            declarationArenaTypeIds[declarationRow]
        let arenaTypeSyntaxRow =
            declarationArenaTypeSyntaxRows[declarationRow]
        if sourceId < 0 ||
           sourceId >= tables.sources.documentCids.len ||
           producerSourceIndex < 0 ||
           producerSourceIndex >= csg.typeArena.producerSourceCount ||
           sourceLocalDeclarationRow < 0 ||
           arenaTypeId < 0 ||
           arenaTypeId >= csg.typeArena.typeCount ||
           arenaTypeSyntaxRow < 0 ||
           arenaTypeSyntaxRow >= csg.typeArena.typeSyntaxCount:
            err = " compiler snapshot builder: portable Type projection coordinate invalid"
            return false
        let childStart = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childStarts,
            arenaTypeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childCounts,
            arenaTypeId)
        let arenaKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeKinds,
            arenaTypeId)
        let aliasDeclaration =
            typeDeclaration &&
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeAlias)
        let aggregateDeclaration =
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeObject) ||
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeRefObject) ||
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeEnum)
        if (typeDeclaration &&
            !aliasDeclaration && !aggregateDeclaration) ||
           (aliasDeclaration &&
            (childCount != 1 || childStart < 0 ||
             childStart >= csg.typeArena.childTypeIds.len)) ||
           (fieldDeclaration &&
            arenaKind == Int32(typearena.TypedExprStructuralTypeAlias)):
            err = " compiler snapshot builder: portable Type/Field projection declaration kind invalid"
            return false
        let signatureArenaTypeId =
            aliasDeclaration ?
                arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childTypeIds,
                childStart) :
                arenaTypeId
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        if signatureArenaTypeId < 0 ||
           signatureArenaTypeId > arenaTypeId ||
           (aliasDeclaration &&
            signatureArenaTypeId >= arenaTypeId) ||
           nameTokenId < 0 ||
           nameTokenId >= tables.tokens.sourceIds.len ||
           nameSpanId < 0 ||
           nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.tokens.sourceIds[nameTokenId] != sourceId ||
           tables.tokens.spanIds[nameTokenId] != nameSpanId ||
           tables.spans.sourceIds[nameSpanId] != sourceId ||
           tables.spans.sourceIds[declarationSpanId] != sourceId:
            err = " compiler snapshot builder: portable Type projection parser authority invalid"
            return false
        add(out.declarationRows, declarationRow)
        add(out.sourceIds, sourceId)
        add(out.producerSourceIndexes, producerSourceIndex)
        add(out.sourceLocalDeclarationRows,
            sourceLocalDeclarationRow)
        add(out.arenaTypeIds, arenaTypeId)
        add(out.arenaTypeSyntaxRows, arenaTypeSyntaxRow)
        add(out.signatureArenaTypeIds, signatureArenaTypeId)
        add(out.nameTokenIds, nameTokenId)
        add(out.nameSpanIds, nameSpanId)
        add(out.declarationSpanIds, declarationSpanId)
    if out.declarationRows.len != out.sourceIds.len ||
       out.declarationRows.len != out.producerSourceIndexes.len ||
       out.declarationRows.len !=
           out.sourceLocalDeclarationRows.len ||
       out.declarationRows.len != out.arenaTypeIds.len ||
       out.declarationRows.len != out.signatureArenaTypeIds.len ||
       out.declarationRows.len != out.nameTokenIds.len ||
       out.declarationRows.len != out.nameSpanIds.len ||
       out.declarationRows.len != out.declarationSpanIds.len:
        err = " compiler snapshot builder: portable Type projection coverage missing"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderAppendTypeSymbolsInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        declarationArenaTypeIds: int32[],
        declarationArenaTypeSyntaxRows: int32[],
        declarationRowByOldSymbol: var int32[],
        typeSymbolIdByArenaTypeId: var int32[],
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let baseSymbolCount = tables.symbols.symbolCids.len
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    if sourceCount <= 0 ||
       declarationArenaTypeIds.len != declarationCount ||
       declarationArenaTypeSyntaxRows.len != declarationCount ||
       csg.typeArena.typeCount <= 0:
        err = " compiler snapshot builder: Type Symbol producer shape invalid"
        return false
    if !compilerSnapshotBuilderTypeDeclarationRootJoinStrictValidateInto(
           tables, sidecars, csg, err):
        return false
    var moduleSymbolBySource: int32[]
    setLen(moduleSymbolBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        moduleSymbolBySource[sourceId] = -1
    for symbolId in 0..<baseSymbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolModule:
            continue
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount ||
           moduleSymbolBySource[sourceId] >= 0:
            err = " compiler snapshot builder: Type Symbol Module owner domain invalid"
            return false
        moduleSymbolBySource[sourceId] = symbolId
    for sourceId in 0..<sourceCount:
        if moduleSymbolBySource[sourceId] < 0:
            err = " compiler snapshot builder: Type Symbol Module owner missing"
            return false
    setLen(declarationRowByOldSymbol, baseSymbolCount)
    for symbolId in 0..<baseSymbolCount:
        declarationRowByOldSymbol[symbolId] = -1
    setLen(typeSymbolIdByArenaTypeId, csg.typeArena.typeCount)
    for arenaTypeId in 0..<typeSymbolIdByArenaTypeId.len:
        typeSymbolIdByArenaTypeId[arenaTypeId] = -1
    var symbolByDeclaration: int32[]
    setLen(symbolByDeclaration, declarationCount)
    for declarationRow in 0..<declarationCount:
        symbolByDeclaration[declarationRow] = -1
    var projectedDeclarationCount: int32
    for declarationRow in 0..<declarationCount:
        let parserDeclarationKind =
            tables.parserSidecars.declarationKinds[declarationRow]
        let typeDeclaration =
            parserDeclarationKind ==
                Int32(parser.ParserDeclarationType)
        let fieldDeclaration =
            parserDeclarationKind ==
                Int32(parser.ParserDeclarationField)
        if !typeDeclaration && !fieldDeclaration:
            continue
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        var producerSourceIndex: int32 = -1
        if sourceId >= 0 &&
           sourceId <
               tables.parserSidecars.producerSourceIndexes.len:
            producerSourceIndex =
                tables.parserSidecars.producerSourceIndexes[sourceId]
        let arenaTypeId = declarationArenaTypeIds[declarationRow]
        let arenaTypeSyntaxRow =
            declarationArenaTypeSyntaxRows[declarationRow]
        let expectedRootKind =
            typeDeclaration ?
                Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) :
                Int32(parser.ParserTypeSyntaxRootFieldDeclaration)
        let declarationOwnerTypeSyntaxRow =
            arenaTypeSyntaxRow < 0 ||
            arenaTypeSyntaxRow >= csg.typeArena.typeSyntaxCount ?
                -1 :
                arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.typeSyntaxDeclarationOwnerNodeIndexes,
                    arenaTypeSyntaxRow)
        if sourceId < 0 || sourceId >= sourceCount ||
           producerSourceIndex < 0 ||
           producerSourceIndex >= csg.typeArena.producerSourceCount ||
           arenaTypeId < 0 || arenaTypeId >= csg.typeArena.typeCount ||
           arenaTypeSyntaxRow < 0 ||
           arenaTypeSyntaxRow >= csg.typeArena.typeSyntaxCount ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxProducerSourceIndexes,
               arenaTypeSyntaxRow) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxRootKinds,
               arenaTypeSyntaxRow) != expectedRootKind ||
           (typeDeclaration &&
            declarationOwnerTypeSyntaxRow != arenaTypeSyntaxRow) ||
           (fieldDeclaration &&
            (declarationOwnerTypeSyntaxRow < 0 ||
             declarationOwnerTypeSyntaxRow >= arenaTypeSyntaxRow)) ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxTypeIds,
               arenaTypeSyntaxRow) != arenaTypeId:
            err = " compiler snapshot builder: parser declaration/TypeArena row join drift"
            return false
        let arenaKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeKinds,
            arenaTypeId)
        let childStart = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childStarts,
            arenaTypeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childCounts,
            arenaTypeId)
        let aliasDeclaration =
            typeDeclaration &&
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeAlias)
        let aggregateDeclaration =
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeObject) ||
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeRefObject) ||
            arenaKind ==
                Int32(typearena.TypedExprStructuralTypeEnum)
        let signatureArenaTypeId =
            aliasDeclaration && childCount == 1 ?
                arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.childTypeIds,
                    childStart) :
            aggregateDeclaration || fieldDeclaration ?
                arenaTypeId : -1
        if (typeDeclaration &&
            !aliasDeclaration && !aggregateDeclaration) ||
           signatureArenaTypeId < 0 ||
           signatureArenaTypeId > arenaTypeId ||
           (aliasDeclaration && signatureArenaTypeId >= arenaTypeId) ||
           (fieldDeclaration &&
            arenaKind == Int32(typearena.TypedExprStructuralTypeAlias)):
            err = " compiler snapshot builder: Type declaration signature TypeId missing"
            return false
        let arenaSymbolId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolIds,
            arenaTypeId)
        let symbolicDeclaration =
            typeDeclaration || aggregateDeclaration
        let arenaSymbolDeclarationRoot =
            arenaSymbolId < 0 ||
            arenaSymbolId >= csg.typeArena.symbolCount ?
                -1 :
                arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.symbolDeclarationRootTypeSyntaxNodeIndexes,
                    arenaSymbolId)
        # wall w53: the arena grants a declaration SymbolId only to a
        # declaration's own root row (typed_expr_type_arena
        # DeclarationCreatesSymbol + FillDeclarationSymbols).  A field whose
        # declared type merely references a nominal declaration owns no
        # SymbolId: symbolIds[arenaTypeId] stays the referenced
        # declaration's Symbol and its declaration root is that
        # declaration's row, never this field row.  The join therefore
        # splits by root coordinate: an own root requires the exact
        # producer join; a foreign root must be a Type declaration root
        # whose TypeSyntax TypeId roundtrips to exactly this arenaTypeId.
        if symbolicDeclaration &&
           (arenaSymbolId < 0 ||
            arenaSymbolId >= csg.typeArena.symbolCount ||
            arenaSymbolDeclarationRoot < 0 ||
            arenaSymbolDeclarationRoot >=
                csg.typeArena.typeSyntaxCount ||
            (arenaSymbolDeclarationRoot == arenaTypeSyntaxRow ?
                arenamod.ArenaArrayInt32Get(
                    csg.typeArena.arena,
                    csg.typeArena.symbolProducerSourceIndexes,
                    arenaSymbolId) != producerSourceIndex :
                !(fieldDeclaration &&
                  arenamod.ArenaArrayInt32Get(
                      csg.typeArena.arena,
                      csg.typeArena.typeSyntaxRootKinds,
                      arenaSymbolDeclarationRoot) ==
                      Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) &&
                  arenamod.ArenaArrayInt32Get(
                      csg.typeArena.arena,
                      csg.typeArena.typeSyntaxTypeIds,
                      arenaSymbolDeclarationRoot) == arenaTypeId))):
            err = Fmt" compiler snapshot builder: TypeArena declaration SymbolId join drift declaration={declarationRow} arenaTypeId={arenaTypeId} arenaSymbolId={arenaSymbolId} symbolRoot={arenaSymbolDeclarationRoot} arenaTypeSyntaxRow={arenaTypeSyntaxRow} producerSourceIndex={producerSourceIndex}"
            return false
        if fieldDeclaration && !aggregateDeclaration &&
           arenaSymbolId != -1:
            err = " compiler snapshot builder: scalar Field claimed declaration SymbolId"
            return false
        var ownerSymbolId = moduleSymbolBySource[sourceId]
        if fieldDeclaration:
            var ownerDeclaration: int32 = -1
            for candidateDeclaration in 0..<declarationRow:
                if declarationArenaTypeSyntaxRows[
                       candidateDeclaration] ==
                       declarationOwnerTypeSyntaxRow:
                    if ownerDeclaration >= 0:
                        err = " compiler snapshot builder: Field immediate owner is ambiguous"
                        return false
                    ownerDeclaration = candidateDeclaration
            if ownerDeclaration < 0 ||
               symbolByDeclaration[ownerDeclaration] < 0:
                err = " compiler snapshot builder: Field immediate owner Symbol missing"
                return false
            ownerSymbolId = symbolByDeclaration[ownerDeclaration]
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[declarationRow]
        if nameTokenId < 0 || nameTokenId >= tables.tokens.sourceIds.len ||
           nameSpanId < 0 || nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.tokens.sourceIds[nameTokenId] != sourceId ||
           tables.tokens.spanIds[nameTokenId] != nameSpanId ||
           tables.spans.sourceIds[nameSpanId] != sourceId ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           tables.spans.startBytes[nameSpanId] <
               tables.spans.startBytes[declarationSpanId] ||
           tables.spans.endBytes[nameSpanId] >
               tables.spans.endBytes[declarationSpanId] ||
           ((aliasDeclaration || aggregateDeclaration) &&
            arenaSymbolDeclarationRoot == arenaTypeSyntaxRow &&
            typeSymbolIdByArenaTypeId[arenaTypeId] != -1):
            err = " compiler snapshot builder: Type Symbol source coordinate invalid"
            return false
        let nameTextId = tables.tokens.valueTextIds[nameTokenId]
        if nameTextId < 0 || nameTextId >= tables.texts.len:
            err = " compiler snapshot builder: Type Symbol name text missing"
            return false
        var nameProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err):
            return false
        var typeSyntaxProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationTypeSyntaxProofCidInto(
               tables, declarationRow, typeSyntaxProofCid, err):
            return false
        let symbolId = tables.symbols.symbolCids.len
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            typeSyntaxProofCid)
        add(tables.symbols.declarationPathCids, nameProofCid)
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, nameTextId)
        add(tables.symbols.symbolKinds,
            typeDeclaration ?
                snapshot_schema.CsgCompilerSymbolType :
                snapshot_schema.CsgCompilerSymbolField)
        add(tables.symbols.typeIds, signatureArenaTypeId)
        add(tables.symbols.declarationSpanIds, declarationSpanId)
        add(tables.symbols.ownerSymbolIds, ownerSymbolId)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, -1)
        add(tables.symbols.exportedFlags,
            typeDeclaration &&
            tables.parserSidecars.declarationExportedFlags[
                declarationRow])
        add(tables.symbols.genericConstraintStarts,
            tables.symbols.genericConstraintTypeIds.len)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
        add(declarationRowByOldSymbol, declarationRow)
        symbolByDeclaration[declarationRow] = symbolId
        # wall w53: only a declaration that owns its own arena Symbol may
        # claim the arenaTypeId for the appended snapshot Symbol.  A field
        # referencing a nominal declaration must leave the claim with the
        # referenced declaration's Type Symbol, or the type row's
        # declSymbolId authority would be overwritten.
        if (aliasDeclaration || aggregateDeclaration) &&
           arenaSymbolDeclarationRoot == arenaTypeSyntaxRow:
            typeSymbolIdByArenaTypeId[arenaTypeId] = symbolId
        projectedDeclarationCount =
            projectedDeclarationCount + 1
    var expectedDeclarationCount: int32
    for declarationRow in 0..<declarationCount:
        let declarationKind =
            tables.parserSidecars.declarationKinds[declarationRow]
        if declarationKind == Int32(parser.ParserDeclarationType) ||
           declarationKind == Int32(parser.ParserDeclarationField):
            expectedDeclarationCount =
                expectedDeclarationCount + 1
    if projectedDeclarationCount != expectedDeclarationCount ||
       declarationRowByOldSymbol.len != tables.symbols.symbolCids.len:
        err = " compiler snapshot builder: Type/Field Symbol declaration coverage mismatch"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderAppendGenericParameterSymbolsInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        declarationRowByOldSymbol: var int32[],
        parserGenericRowByArenaTypeId: var int32[],
        err: var str): bool =
    let parserGenericCount =
        tables.parserSidecars.typeGenericSymbolProducerSourceIds.len
    if csg.typeArena == nil ||
       sidecars.len != csg.typeArena.producerSourceCount ||
       parserGenericCount != csg.typeArena.genericSymbolCount ||
       declarationRowByOldSymbol.len !=
           tables.symbols.symbolCids.len:
        err = " compiler snapshot builder: generic parameter producer shape invalid"
        return false
    let sourceCount =
        tables.parserSidecars.producerSourceIndexes.len
    if sourceCount != sidecars.len:
        err = " compiler snapshot builder: generic source domain split"
        return false
    setLen(parserGenericRowByArenaTypeId, csg.typeArena.typeCount)
    for arenaTypeId in 0..<parserGenericRowByArenaTypeId.len:
        parserGenericRowByArenaTypeId[arenaTypeId] = -1
    var sourceByProducer: int32[]
    var tokenBaseByProducer: int32[]
    var parserTypeBaseBySource: int32[]
    var parserTypeCountBySource: int32[]
    var arenaTypeBaseByProducer: int32[]
    var arenaTypeCountByProducer: int32[]
    var parserGenericBaseBySource: int32[]
    var parserGenericCountBySource: int32[]
    var arenaGenericBaseByProducer: int32[]
    var arenaGenericCountByProducer: int32[]
    setLen(sourceByProducer, sourceCount)
    setLen(tokenBaseByProducer, sourceCount)
    setLen(parserTypeBaseBySource, sourceCount)
    setLen(parserTypeCountBySource, sourceCount)
    setLen(arenaTypeBaseByProducer, sourceCount)
    setLen(arenaTypeCountByProducer, sourceCount)
    setLen(parserGenericBaseBySource, sourceCount)
    setLen(parserGenericCountBySource, sourceCount)
    setLen(arenaGenericBaseByProducer, sourceCount)
    setLen(arenaGenericCountByProducer, sourceCount)
    for row in 0..<sourceCount:
        sourceByProducer[row] = -1
        parserTypeBaseBySource[row] = -1
        arenaTypeBaseByProducer[row] = -1
        parserGenericBaseBySource[row] = -1
        arenaGenericBaseByProducer[row] = -1
    var tokenCursor: int32
    for producer in 0..<sourceCount:
        tokenBaseByProducer[producer] = tokenCursor
        tokenCursor = tokenCursor + sidecars[producer].tokenKinds.len
    if tokenCursor != csg.typeArena.tokenCount:
        err = " compiler snapshot builder: generic token forest coverage mismatch"
        return false
    for sourceId in 0..<sourceCount:
        let producer =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        if producer < 0 || producer >= sourceCount ||
           sourceByProducer[producer] >= 0:
            err = " compiler snapshot builder: generic source crosswalk is not bijective"
            return false
        sourceByProducer[producer] = sourceId
    var previousParserTypeSource: int32 = -1
    for parserTypeRow in 0..<
            tables.parserSidecars.typeSyntaxSourceIds.len:
        let sourceId =
            tables.parserSidecars.typeSyntaxSourceIds[parserTypeRow]
        if sourceId < 0 || sourceId >= sourceCount ||
           sourceId < previousParserTypeSource ||
           (sourceId != previousParserTypeSource &&
            parserTypeBaseBySource[sourceId] >= 0):
            err = " compiler snapshot builder: parser TypeSyntax source order invalid"
            return false
        if parserTypeBaseBySource[sourceId] < 0:
            parserTypeBaseBySource[sourceId] = parserTypeRow
        parserTypeCountBySource[sourceId] =
            parserTypeCountBySource[sourceId] + 1
        previousParserTypeSource = sourceId
    var previousArenaTypeProducer: int32 = -1
    for arenaTypeSyntaxRow in 0..<csg.typeArena.typeSyntaxCount:
        let producer = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxProducerSourceIndexes,
            arenaTypeSyntaxRow)
        if producer < 0 || producer >= sourceCount ||
           producer < previousArenaTypeProducer ||
           (producer != previousArenaTypeProducer &&
            arenaTypeBaseByProducer[producer] >= 0):
            err = " compiler snapshot builder: TypeArena TypeSyntax producer order invalid"
            return false
        if arenaTypeBaseByProducer[producer] < 0:
            arenaTypeBaseByProducer[producer] =
                arenaTypeSyntaxRow
        arenaTypeCountByProducer[producer] =
            arenaTypeCountByProducer[producer] + 1
        previousArenaTypeProducer = producer
    var previousParserGenericSource: int32 = -1
    for parserRow in 0..<parserGenericCount:
        let sourceId =
            tables.parserSidecars.typeGenericSymbolProducerSourceIds[
                parserRow]
        if sourceId < 0 || sourceId >= sourceCount ||
           sourceId < previousParserGenericSource ||
           (sourceId != previousParserGenericSource &&
            parserGenericBaseBySource[sourceId] >= 0):
            err = " compiler snapshot builder: parser generic source order invalid"
            return false
        if parserGenericBaseBySource[sourceId] < 0:
            parserGenericBaseBySource[sourceId] = parserRow
        parserGenericCountBySource[sourceId] =
            parserGenericCountBySource[sourceId] + 1
        previousParserGenericSource = sourceId
    var previousArenaGenericProducer: int32 = -1
    for arenaGenericRow in 0..<csg.typeArena.genericSymbolCount:
        let producer = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolProducerSourceIndexes,
            arenaGenericRow)
        if producer < 0 || producer >= sourceCount ||
           producer < previousArenaGenericProducer ||
           (producer != previousArenaGenericProducer &&
            arenaGenericBaseByProducer[producer] >= 0):
            err = " compiler snapshot builder: TypeArena generic producer order invalid"
            return false
        if arenaGenericBaseByProducer[producer] < 0:
            arenaGenericBaseByProducer[producer] =
                arenaGenericRow
        arenaGenericCountByProducer[producer] =
            arenaGenericCountByProducer[producer] + 1
        previousArenaGenericProducer = producer
    for producer in 0..<sourceCount:
        let sourceId = sourceByProducer[producer]
        if sourceId < 0 ||
           parserTypeCountBySource[sourceId] !=
               arenaTypeCountByProducer[producer] ||
           parserGenericCountBySource[sourceId] !=
               arenaGenericCountByProducer[producer]:
            err = " compiler snapshot builder: parser/TypeArena source forest coverage drift"
            return false
    var parserTypeSyntaxToArena: int32[]
    setLen(
        parserTypeSyntaxToArena,
        tables.parserSidecars.typeSyntaxSourceIds.len)
    for parserTypeRow in 0..<parserTypeSyntaxToArena.len:
        let sourceId =
            tables.parserSidecars.typeSyntaxSourceIds[parserTypeRow]
        let producer =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        let localRow =
            parserTypeRow - parserTypeBaseBySource[sourceId]
        let arenaRow =
            arenaTypeBaseByProducer[producer] + localRow
        if localRow < 0 ||
           localRow >= parserTypeCountBySource[sourceId] ||
           arenaRow < 0 || arenaRow >= csg.typeArena.typeSyntaxCount ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeSyntaxProducerSourceIndexes,
               arenaRow) != producer:
            err = " compiler snapshot builder: TypeSyntax crosswalk drift"
            return false
        parserTypeSyntaxToArena[parserTypeRow] = arenaRow
    var parserGenericByArenaGeneric: int32[]
    setLen(parserGenericByArenaGeneric, parserGenericCount)
    for row in 0..<parserGenericCount:
        parserGenericByArenaGeneric[row] = -1
    for parserRow in 0..<parserGenericCount:
        let sourceId =
            tables.parserSidecars.typeGenericSymbolProducerSourceIds[
                parserRow]
        let producer =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        let localRow =
            tables.parserSidecars.typeGenericSymbolSourceLocalRows[
                parserRow]
        let arenaRow =
            arenaGenericBaseByProducer[producer] + localRow
        if localRow < 0 ||
           localRow >= parserGenericCountBySource[sourceId] ||
           arenaRow < 0 || arenaRow >= parserGenericCount ||
           parserGenericByArenaGeneric[arenaRow] >= 0:
            err = " compiler snapshot builder: generic row crosswalk drift"
            return false
        parserGenericByArenaGeneric[arenaRow] = parserRow
    var ownerSymbolByToken: int32[]
    setLen(ownerSymbolByToken, tables.tokens.sourceIds.len)
    for tokenId in 0..<ownerSymbolByToken.len:
        ownerSymbolByToken[tokenId] = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let symbolKind = tables.symbols.symbolKinds[symbolId]
        if symbolKind != snapshot_schema.CsgCompilerSymbolFunction &&
           symbolKind != snapshot_schema.CsgCompilerSymbolType:
            continue
        let tokenId = tables.symbols.nameTokenIds[symbolId]
        if tokenId < 0 || tokenId >= ownerSymbolByToken.len ||
           ownerSymbolByToken[tokenId] >= 0:
            err = " compiler snapshot builder: generic owner token index ambiguous"
            return false
        ownerSymbolByToken[tokenId] = symbolId
    var arenaTypeIdByGenericRow: int32[]
    setLen(arenaTypeIdByGenericRow, parserGenericCount)
    for row in 0..<parserGenericCount:
        arenaTypeIdByGenericRow[row] = -1
    var genericTypeCount: int32
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        if arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeKinds,
               arenaTypeId) !=
               Int32(typearena.TypedExprStructuralTypeGenericParameter):
            continue
        let arenaGenericRow = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolIds,
            arenaTypeId)
        if arenaGenericRow < 0 ||
           arenaGenericRow >= parserGenericCount ||
           arenaTypeIdByGenericRow[arenaGenericRow] >= 0:
            err = " compiler snapshot builder: generic parameter TypeId is not bijective"
            return false
        arenaTypeIdByGenericRow[arenaGenericRow] = arenaTypeId
        genericTypeCount = genericTypeCount + 1
    if genericTypeCount != parserGenericCount:
        err = " compiler snapshot builder: generic parameter TypeId coverage mismatch"
        return false
    var parserSeen: bool[]
    setLen(parserSeen, parserGenericCount)
    for arenaGenericRow in 0..<parserGenericCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolProducerSourceIndexes,
            arenaGenericRow)
        let parserRow =
            parserGenericByArenaGeneric[arenaGenericRow]
        if parserRow < 0 || parserSeen[parserRow]:
            err = " compiler snapshot builder: generic parser/TypeArena relation missing"
            return false
        parserSeen[parserRow] = true
        let sourceId =
            tables.parserSidecars.typeGenericSymbolProducerSourceIds[
                parserRow]
        let producerTokenBase =
            tokenBaseByProducer[producerSourceIndex]
        let nameTokenId =
            tables.parserSidecars.typeGenericSymbolNameTokenIds[
                parserRow]
        let ownerTokenId =
            tables.parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds[
                parserRow]
        let ordinal =
            tables.parserSidecars.typeGenericSymbolOrdinals[parserRow]
        let declarationSpanId =
            tables.parserSidecars.typeGenericSymbolSpanIds[parserRow]
        let arenaNameTokenId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolNameTokenIndexes,
            arenaGenericRow)
        let arenaOwnerTokenId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolDeclarationOwnerTokenIndexes,
            arenaGenericRow)
        if nameTokenId < 0 ||
           nameTokenId >= tables.tokens.sourceIds.len ||
           ownerTokenId < 0 ||
           ownerTokenId >= tables.tokens.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.tokens.sourceIds[nameTokenId] != sourceId ||
           tables.tokens.sourceIds[ownerTokenId] != sourceId ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           arenaNameTokenId < 0 ||
           arenaNameTokenId >= csg.typeArena.tokenCount ||
           arenaOwnerTokenId < 0 ||
           arenaOwnerTokenId >= csg.typeArena.tokenCount ||
           arenaNameTokenId != producerTokenBase +
               tables.tokens.sourceLocalRows[nameTokenId] ||
           arenaOwnerTokenId != producerTokenBase +
               tables.tokens.sourceLocalRows[ownerTokenId] ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.genericSymbolOrdinals,
               arenaGenericRow) != ordinal:
            err = " compiler snapshot builder: generic parser token relation drift"
            return false
        let ownerSymbolId =
            ownerSymbolByToken[ownerTokenId]
        if ownerSymbolId < 0 ||
           tables.symbols.sourceIds[ownerSymbolId] != sourceId:
            err = " compiler snapshot builder: generic owner Symbol relation missing"
            return false
        let arenaTypeId = arenaTypeIdByGenericRow[arenaGenericRow]
        if arenaTypeId < 0 ||
           arenaTypeId >= parserGenericRowByArenaTypeId.len ||
           parserGenericRowByArenaTypeId[arenaTypeId] >= 0:
            err = " compiler snapshot builder: generic Type parser crosswalk is not bijective"
            return false
        parserGenericRowByArenaTypeId[arenaTypeId] = parserRow
        let constraintParserTypeSyntax =
            tables.parserSidecars.typeGenericSymbolConstraintTypeSyntaxIds[
                parserRow]
        let defaultParserTypeSyntax =
            tables.parserSidecars.typeGenericSymbolDefaultTypeSyntaxIds[
                parserRow]
        let constraintArenaTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolConstraintTypeIds,
            arenaGenericRow)
        let defaultArenaTypeId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolDefaultTypeIds,
            arenaGenericRow)
        let ownerParserTypeSyntax =
            tables.parserSidecars.typeGenericSymbolOwnerTypeSyntaxIds[
                parserRow]
        if ownerParserTypeSyntax < 0 ||
           ownerParserTypeSyntax >= parserTypeSyntaxToArena.len ||
           constraintParserTypeSyntax < -1 ||
           constraintParserTypeSyntax >= parserTypeSyntaxToArena.len ||
           defaultParserTypeSyntax < -1 ||
           defaultParserTypeSyntax >= parserTypeSyntaxToArena.len:
            err = " compiler snapshot builder: generic parser TypeSyntax relation invalid"
            return false
        let ownerArenaTypeSyntax =
            parserTypeSyntaxToArena[ownerParserTypeSyntax]
        let constraintArenaTypeSyntax =
            constraintParserTypeSyntax < 0 ? -1 :
                parserTypeSyntaxToArena[constraintParserTypeSyntax]
        let defaultArenaTypeSyntax =
            defaultParserTypeSyntax < 0 ? -1 :
                parserTypeSyntaxToArena[defaultParserTypeSyntax]
        if arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.genericSymbolOwnerTypeSyntaxNodeIndexes,
               arenaGenericRow) != ownerArenaTypeSyntax ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.genericSymbolConstraintTypeSyntaxNodeIndexes,
               arenaGenericRow) != constraintArenaTypeSyntax ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.genericSymbolDefaultTypeSyntaxNodeIndexes,
               arenaGenericRow) != defaultArenaTypeSyntax ||
           (constraintParserTypeSyntax < 0) !=
               (constraintArenaTypeId < 0) ||
           (defaultParserTypeSyntax < 0) !=
               (defaultArenaTypeId < 0) ||
           (constraintArenaTypeSyntax >= 0 &&
            arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.typeSyntaxTypeIds,
                constraintArenaTypeSyntax) != constraintArenaTypeId) ||
           (defaultArenaTypeSyntax >= 0 &&
            arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.typeSyntaxTypeIds,
                defaultArenaTypeSyntax) != defaultArenaTypeId):
            err = " compiler snapshot builder: generic constraint/default TypeId relation drift"
            return false
        let nameSpanId = tables.tokens.spanIds[nameTokenId]
        let nameTextId = tables.tokens.valueTextIds[nameTokenId]
        if nameSpanId < 0 ||
           nameSpanId >= tables.spans.sourceIds.len ||
           nameTextId < 0 || nameTextId >= tables.texts.len:
            err = " compiler snapshot builder: generic parameter name authority missing"
            return false
        let parserIdentityCid =
            tables.parserSidecars.typeGenericSymbolIdentityCids[
                parserRow]
        if !compilerSnapshotBuilderCidObserved(parserIdentityCid):
            err = " compiler snapshot builder: generic parser identity missing"
            return false
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            layout.FixedBytes32Copy(parserIdentityCid))
        add(tables.symbols.declarationPathCids,
            layout.FixedBytes32Copy(parserIdentityCid))
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, nameTextId)
        add(tables.symbols.symbolKinds,
            snapshot_schema.CsgCompilerSymbolGenericParameter)
        add(tables.symbols.typeIds, arenaTypeId)
        add(tables.symbols.declarationSpanIds, declarationSpanId)
        add(tables.symbols.ownerSymbolIds, ownerSymbolId)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, -1)
        add(tables.symbols.exportedFlags, false)
        add(tables.symbols.genericConstraintStarts,
            tables.symbols.genericConstraintTypeIds.len)
        add(tables.symbols.genericConstraintCounts,
            constraintArenaTypeId < 0 ? 0 : 1)
        if constraintArenaTypeId >= 0:
            add(tables.symbols.genericConstraintTypeIds,
                constraintArenaTypeId)
        add(tables.symbols.genericParameterParserRows, parserRow)
        add(tables.symbols.genericParameterOrdinals, ordinal)
        add(tables.symbols.genericParameterDefaultTypeIds,
            defaultArenaTypeId)
        add(declarationRowByOldSymbol, -1)
    if declarationRowByOldSymbol.len !=
           tables.symbols.symbolCids.len:
        err = " compiler snapshot builder: generic Symbol coverage mismatch"
        return false
    for arenaTypeId in 0..<parserGenericRowByArenaTypeId.len:
        let genericType = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena, csg.typeArena.typeKinds, arenaTypeId) ==
                Int32(typearena.TypedExprStructuralTypeGenericParameter)
        if genericType !=
               (parserGenericRowByArenaTypeId[arenaTypeId] >= 0):
            err = " compiler snapshot builder: generic Type parser crosswalk coverage mismatch"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderAppendParameterSymbolsInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        declarationArenaTypeIds: int32[],
        functionParamStarts: int32[],
        functionParamCounts: int32[],
        functionParamArenaTypeIds: int32[],
        externParamStarts: int32[],
        externParamCounts: int32[],
        externParamArenaTypeIds: int32[],
        declarationRowByOldSymbol: var int32[],
        err: var str): bool =
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    if declarationArenaTypeIds.len != declarationCount ||
       declarationRowByOldSymbol.len !=
           tables.symbols.symbolCids.len ||
       functionParamStarts.len != tables.functions.symbolIds.len ||
       functionParamCounts.len != tables.functions.symbolIds.len ||
       externParamStarts.len !=
           tables.externFunctions.symbolIds.len ||
       externParamCounts.len !=
           tables.externFunctions.symbolIds.len:
        err = " compiler snapshot builder: parameter Symbol producer shape invalid"
        return false
    for functionId in 0..<functionParamStarts.len:
        let start = functionParamStarts[functionId]
        let count = functionParamCounts[functionId]
        if start < 0 || count < 0 ||
           start > functionParamArenaTypeIds.len ||
           count > functionParamArenaTypeIds.len - start:
            err = " compiler snapshot builder: executable parameter TypeId CSR invalid"
            return false
    for externFunctionId in 0..<externParamStarts.len:
        let start = externParamStarts[externFunctionId]
        let count = externParamCounts[externFunctionId]
        if start < 0 || count < 0 ||
           start > externParamArenaTypeIds.len ||
           count > externParamArenaTypeIds.len - start:
            err = " compiler snapshot builder: extern parameter TypeId CSR invalid"
            return false
    var functionSymbolByDeclaration: int32[]
    var parameterCountByFunctionDeclaration: int32[]
    setLen(functionSymbolByDeclaration, declarationCount)
    setLen(parameterCountByFunctionDeclaration, declarationCount)
    for declarationRow in 0..<declarationCount:
        functionSymbolByDeclaration[declarationRow] = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction:
            continue
        let sourceId = tables.symbols.sourceIds[symbolId]
        let nameTokenId = tables.symbols.nameTokenIds[symbolId]
        let declarationSpanId =
            tables.symbols.declarationSpanIds[symbolId]
        var ownerDeclaration: int32 = -1
        for declarationRow in 0..<declarationCount:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction) ||
               tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] != sourceId ||
               tables.parserSidecars.declarationNameTokenIds[
                   declarationRow] != nameTokenId ||
               tables.parserSidecars.declarationSpanIds[
                   declarationRow] != declarationSpanId:
                continue
            if ownerDeclaration >= 0:
                err = " compiler snapshot builder: parameter owner declaration ambiguous"
                return false
            ownerDeclaration = declarationRow
        if ownerDeclaration < 0 ||
           functionSymbolByDeclaration[ownerDeclaration] >= 0:
            err = " compiler snapshot builder: parameter owner Function declaration missing"
            return false
        functionSymbolByDeclaration[ownerDeclaration] = symbolId
    var projectedParameterCount: int32
    for declarationRow in 0..<declarationCount:
        if tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationParameter):
            continue
        let ownerDeclaration =
            tables.parserSidecars.declarationOwnerIds[declarationRow]
        if ownerDeclaration < 0 ||
           ownerDeclaration >= declarationCount ||
           tables.parserSidecars.declarationKinds[ownerDeclaration] !=
               Int32(parser.ParserDeclarationFunction):
            err = " compiler snapshot builder: parameter declaration owner invalid"
            return false
        let ownerSymbolId =
            functionSymbolByDeclaration[ownerDeclaration]
        if ownerSymbolId < 0 ||
           ownerSymbolId >= tables.symbols.symbolCids.len:
            err = " compiler snapshot builder: parameter owner Symbol missing"
            return false
        let ordinal =
            parameterCountByFunctionDeclaration[ownerDeclaration]
        var expectedArenaTypeId: int32 = -1
        let functionId =
            tables.symbols.functionIds[ownerSymbolId]
        let externFunctionId =
            tables.symbols.externFunctionIds[ownerSymbolId]
        if functionId >= 0:
            if functionId >= functionParamCounts.len ||
               ordinal >= functionParamCounts[functionId]:
                err = " compiler snapshot builder: executable parameter ordinal invalid"
                return false
            expectedArenaTypeId =
                functionParamArenaTypeIds[
                    functionParamStarts[functionId] + ordinal]
        elif externFunctionId >= 0:
            if externFunctionId >= externParamCounts.len ||
               ordinal >= externParamCounts[externFunctionId]:
                err = " compiler snapshot builder: extern parameter ordinal invalid"
                return false
            expectedArenaTypeId =
                externParamArenaTypeIds[
                    externParamStarts[externFunctionId] + ordinal]
        else:
            err = " compiler snapshot builder: parameter owner is not callable"
            return false
        let arenaTypeId =
            declarationArenaTypeIds[declarationRow]
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        if arenaTypeId != expectedArenaTypeId ||
           arenaTypeId < 0 ||
           sourceId != tables.symbols.sourceIds[ownerSymbolId] ||
           nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len ||
           nameSpanId < 0 ||
           nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.tokens.sourceIds[nameTokenId] != sourceId ||
           tables.tokens.spanIds[nameTokenId] != nameSpanId ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           tables.parserSidecars.declarationExportedFlags[
               declarationRow]:
            err = " compiler snapshot builder: parameter declaration authority incomplete"
            return false
        let nameTextId =
            tables.tokens.valueTextIds[nameTokenId]
        if nameTextId < 0 || nameTextId >= tables.texts.len:
            err = " compiler snapshot builder: parameter name text missing"
            return false
        var nameProofCid: layout.FixedBytes32
        var typeSyntaxProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err) ||
           !compilerSnapshotBuilderDeclarationTypeSyntaxProofCidInto(
               tables, declarationRow, typeSyntaxProofCid, err):
            return false
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            typeSyntaxProofCid)
        add(tables.symbols.declarationPathCids, nameProofCid)
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, nameTextId)
        add(tables.symbols.symbolKinds,
            snapshot_schema.CsgCompilerSymbolParameter)
        add(tables.symbols.typeIds, arenaTypeId)
        add(tables.symbols.declarationSpanIds,
            declarationSpanId)
        add(tables.symbols.ownerSymbolIds, ownerSymbolId)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, -1)
        add(tables.symbols.exportedFlags, false)
        add(tables.symbols.genericConstraintStarts,
            tables.symbols.genericConstraintTypeIds.len)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
        add(declarationRowByOldSymbol, declarationRow)
        parameterCountByFunctionDeclaration[ownerDeclaration] =
            ordinal + 1
        projectedParameterCount = projectedParameterCount + 1
    for ownerDeclaration in 0..<declarationCount:
        let ownerSymbolId =
            functionSymbolByDeclaration[ownerDeclaration]
        if ownerSymbolId < 0:
            continue
        let functionId =
            tables.symbols.functionIds[ownerSymbolId]
        let externFunctionId =
            tables.symbols.externFunctionIds[ownerSymbolId]
        let expectedCount =
            functionId >= 0 ?
                functionParamCounts[functionId] :
                externParamCounts[externFunctionId]
        if parameterCountByFunctionDeclaration[ownerDeclaration] !=
               expectedCount:
            err = " compiler snapshot builder: parameter Symbol coverage mismatch"
            return false
    var requiredParameterCount: int32
    for declarationRow in 0..<declarationCount:
        if tables.parserSidecars.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationParameter):
            requiredParameterCount = requiredParameterCount + 1
    if projectedParameterCount != requiredParameterCount ||
       declarationRowByOldSymbol.len !=
           tables.symbols.symbolCids.len:
        err = " compiler snapshot builder: parameter Symbol coverage mismatch"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderAppendLocalSymbolsInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        declarationRowByOldSymbol: var int32[],
        err: var str): bool =
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    let patternCount =
        tables.parserSidecars.patternKinds.len
    let definitionCount =
        tables.valueDefinitions.groupRows.len
    let groupCount =
        tables.valueDefinitionGroups.definitionRows.len
    let typedDefinitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr)
    let typedGroupCount =
        texpr.TypedExprValueDefinitionGroupAuthorityCount(csg.typedIr)
    if declarationRowByOldSymbol.len !=
           tables.symbols.symbolCids.len ||
       definitionCount != tables.valueDefinitions.originKinds.len ||
       definitionCount !=
           tables.valueDefinitions.producerSourceIndexes.len ||
       definitionCount !=
           tables.valueDefinitions.declarationSourceLocalRows.len ||
       definitionCount !=
           tables.valueDefinitions.patternSourceLocalRows.len ||
       definitionCount !=
           tables.valueDefinitions.functionIds.len ||
       definitionCount !=
           tables.valueDefinitions.definingTypedNodeIds.len ||
       definitionCount != tables.valueDefinitions.typeIds.len ||
       groupCount !=
           tables.valueDefinitionGroups.producerSourceIndexes.len ||
       groupCount !=
           tables.valueDefinitionGroups.parserProducerSourceIndexes.len ||
       groupCount !=
           tables.valueDefinitionGroups.bindingOffsets.len ||
       groupCount !=
           tables.valueDefinitionGroups.bindingCounts.len ||
       groupCount !=
           tables.valueDefinitionGroups.functionIds.len ||
       groupCount !=
           tables.valueDefinitionGroups.declarationSourceLocalRows.len ||
       groupCount !=
           tables.valueDefinitionGroups.patternSourceLocalRows.len ||
       definitionCount != typedDefinitionCount ||
       groupCount != typedGroupCount:
        var bindingDefs: int32
        var parameterDefs: int32
        var callResultDefs: int32
        var temporaryDefs: int32
        var otherDefs: int32
        var negativeGroupRows: int32
        for originRow in 0..<tables.valueDefinitions.originKinds.len:
            let originKind = tables.valueDefinitions.originKinds[originRow]
            if originKind ==
                   snapshot_schema.CsgCompilerValueDefinitionOriginBindingInitializer:
                bindingDefs = bindingDefs + 1
            elif originKind ==
                     snapshot_schema.CsgCompilerValueDefinitionOriginParameter:
                parameterDefs = parameterDefs + 1
            elif originKind ==
                     snapshot_schema.CsgCompilerValueDefinitionOriginCallResult:
                callResultDefs = callResultDefs + 1
            elif originKind ==
                     snapshot_schema.CsgCompilerValueDefinitionOriginManagedTemporary:
                temporaryDefs = temporaryDefs + 1
            else:
                otherDefs = otherDefs + 1
            if originRow < tables.valueDefinitions.groupRows.len &&
               tables.valueDefinitions.groupRows[originRow] < 0:
                negativeGroupRows = negativeGroupRows + 1
        err = Fmt" compiler snapshot builder: Local Symbol producer domain split declarationRowByOldSymbol={declarationRowByOldSymbol.len} symbolCids={tables.symbols.symbolCids.len} definitionCount={definitionCount} groupCount={groupCount} defProducer={tables.valueDefinitions.producerSourceIndexes.len} defDeclLocal={tables.valueDefinitions.declarationSourceLocalRows.len} defPatternLocal={tables.valueDefinitions.patternSourceLocalRows.len} defFunction={tables.valueDefinitions.functionIds.len} defDefining={tables.valueDefinitions.definingTypedNodeIds.len} defType={tables.valueDefinitions.typeIds.len} groupProducer={tables.valueDefinitionGroups.producerSourceIndexes.len} groupParserProducer={tables.valueDefinitionGroups.parserProducerSourceIndexes.len} groupBindOff={tables.valueDefinitionGroups.bindingOffsets.len} groupBindCnt={tables.valueDefinitionGroups.bindingCounts.len} groupFunction={tables.valueDefinitionGroups.functionIds.len} groupDeclLocal={tables.valueDefinitionGroups.declarationSourceLocalRows.len} groupPatternLocal={tables.valueDefinitionGroups.patternSourceLocalRows.len} typedDefAuth={typedDefinitionCount} typedGroupAuth={typedGroupCount} bindingDefs={bindingDefs} parameterDefs={parameterDefs} callResultDefs={callResultDefs} temporaryDefs={temporaryDefs} otherDefs={otherDefs} negativeGroupRows={negativeGroupRows}"
        return false
    var declarationByProducerLocal: int32[]
    var patternByProducerLocal: int32[]
    setLen(declarationByProducerLocal, declarationCount)
    setLen(patternByProducerLocal, patternCount)
    for row in 0..<declarationByProducerLocal.len:
        declarationByProducerLocal[row] = -1
    for row in 0..<patternByProducerLocal.len:
        patternByProducerLocal[row] = -1
    var declarationBaseByProducer: int32[]
    var patternBaseByProducer: int32[]
    setLen(
        declarationBaseByProducer,
        csg.parserNormalizedExprReceipt.sourceSidecars.len)
    setLen(
        patternBaseByProducer,
        csg.parserNormalizedExprReceipt.sourceSidecars.len)
    var declarationCursor: int32
    var patternCursor: int32
    for producerSource in 0..<
            csg.parserNormalizedExprReceipt.sourceSidecars.len:
        declarationBaseByProducer[producerSource] =
            declarationCursor
        patternBaseByProducer[producerSource] = patternCursor
        declarationCursor = declarationCursor +
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producerSource].declarationKinds.len
        patternCursor = patternCursor +
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producerSource].patternKinds.len
    if declarationCursor != declarationCount ||
       patternCursor != patternCount:
        err = " compiler snapshot builder: Local parser producer coverage split"
        return false
    for declarationRow in 0..<declarationCount:
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        let producerSource =
            sourceId < 0 ||
            sourceId >=
                tables.parserSidecars.producerSourceIndexes.len ?
                -1 :
                tables.parserSidecars.producerSourceIndexes[sourceId]
        let localRow =
            tables.parserSidecars.declarationSourceLocalRows[
                declarationRow]
        if producerSource < 0 ||
           producerSource >= declarationBaseByProducer.len ||
           localRow < 0 ||
           localRow >=
               csg.parserNormalizedExprReceipt.sourceSidecars[
                   producerSource].declarationKinds.len:
            err = " compiler snapshot builder: Local declaration coordinate invalid"
            return false
        let coordinate =
            declarationBaseByProducer[producerSource] + localRow
        if declarationByProducerLocal[coordinate] >= 0:
            err = " compiler snapshot builder: Local declaration coordinate duplicated"
            return false
        declarationByProducerLocal[coordinate] = declarationRow
    for patternRow in 0..<patternCount:
        let sourceId =
            tables.parserSidecars.patternProducerSourceIds[patternRow]
        let producerSource =
            sourceId < 0 ||
            sourceId >=
                tables.parserSidecars.producerSourceIndexes.len ?
                -1 :
                tables.parserSidecars.producerSourceIndexes[sourceId]
        let localRow =
            tables.parserSidecars.patternSourceLocalRows[patternRow]
        if producerSource < 0 ||
           producerSource >= patternBaseByProducer.len ||
           localRow < 0 ||
           localRow >=
               csg.parserNormalizedExprReceipt.sourceSidecars[
                   producerSource].patternKinds.len:
            err = " compiler snapshot builder: Local pattern coordinate invalid"
            return false
        let coordinate = patternBaseByProducer[producerSource] + localRow
        if patternByProducerLocal[coordinate] >= 0:
            err = " compiler snapshot builder: Local pattern coordinate duplicated"
            return false
        patternByProducerLocal[coordinate] = patternRow
    var functionSymbolByDeclaration: int32[]
    setLen(functionSymbolByDeclaration, declarationCount)
    for declarationRow in 0..<declarationCount:
        functionSymbolByDeclaration[declarationRow] = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction:
            continue
        for declarationRow in 0..<declarationCount:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction) ||
               tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] !=
                   tables.symbols.sourceIds[symbolId] ||
               tables.parserSidecars.declarationNameTokenIds[
                   declarationRow] !=
                   tables.symbols.nameTokenIds[symbolId] ||
               tables.parserSidecars.declarationSpanIds[
                   declarationRow] !=
                   tables.symbols.declarationSpanIds[symbolId]:
                continue
            if functionSymbolByDeclaration[declarationRow] >= 0:
                err = " compiler snapshot builder: Local owner Function declaration ambiguous"
                return false
            functionSymbolByDeclaration[declarationRow] = symbolId
    var localDeclarationSeen: bool[]
    var localPatternSeen: bool[]
    setLen(localDeclarationSeen, declarationCount)
    setLen(localPatternSeen, patternCount)
    var generatedQualifiedNames: str[]
    var bindingDefinitionCount: int32
    for definitionRow in 0..<definitionCount:
        let originKind =
            tables.valueDefinitions.originKinds[definitionRow]
        let groupRow =
            tables.valueDefinitions.groupRows[definitionRow]
        if originKind !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.valueDefinitions_originKinds,
                   definitionRow) ||
           groupRow !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.valueDefinitions_groupRows,
                   definitionRow):
            err = " compiler snapshot builder: Local value-definition origin identity drift"
            return false
        if originKind !=
               snapshot_schema.CsgCompilerValueDefinitionOriginBindingInitializer:
            if (originKind !=
                    snapshot_schema.CsgCompilerValueDefinitionOriginParameter &&
                originKind !=
                    snapshot_schema.CsgCompilerValueDefinitionOriginCallResult &&
                originKind !=
                    snapshot_schema.CsgCompilerValueDefinitionOriginManagedTemporary) ||
               groupRow != -1:
                err = " compiler snapshot builder: non-binding value-definition retained Local group edge"
                return false
            continue
        bindingDefinitionCount = bindingDefinitionCount + 1
        let producerSource =
            tables.valueDefinitions.producerSourceIndexes[definitionRow]
        let declarationLocalRow =
            tables.valueDefinitions.declarationSourceLocalRows[
                definitionRow]
        let patternLocalRow =
            tables.valueDefinitions.patternSourceLocalRows[
                definitionRow]
        let functionId =
            tables.valueDefinitions.functionIds[definitionRow]
        let definingTypedNodeId =
            tables.valueDefinitions.definingTypedNodeIds[definitionRow]
        let typeId =
            tables.valueDefinitions.typeIds[definitionRow]
        if producerSource < 0 ||
           producerSource >= declarationBaseByProducer.len ||
           declarationLocalRow < 0 ||
           declarationLocalRow >=
               csg.parserNormalizedExprReceipt.sourceSidecars[
                   producerSource].declarationKinds.len ||
           patternLocalRow < 0 ||
           patternLocalRow >=
               csg.parserNormalizedExprReceipt.sourceSidecars[
                   producerSource].patternKinds.len ||
           groupRow < 0 || groupRow >= groupCount ||
           functionId < 0 ||
           functionId >= tables.functions.symbolIds.len ||
           definingTypedNodeId < 0 ||
           definingTypedNodeId >= tables.typedNodes.functionIds.len ||
           typeId < 0 || typeId >= tables.types.typeCids.len:
            err = " compiler snapshot builder: Local value-definition coordinate invalid"
            return false
        let declarationRow =
            declarationByProducerLocal[
                declarationBaseByProducer[producerSource] +
                    declarationLocalRow]
        let patternRow =
            patternByProducerLocal[
                patternBaseByProducer[producerSource] +
                    patternLocalRow]
        let sourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, producerSource)
        let ownerDeclaration =
            declarationRow < 0 ? -1 :
                tables.parserSidecars.declarationOwnerIds[
                    declarationRow]
        let ownerSymbolId =
            ownerDeclaration < 0 ||
            ownerDeclaration >= functionSymbolByDeclaration.len ?
                -1 :
                functionSymbolByDeclaration[ownerDeclaration]
        if declarationRow < 0 || patternRow < 0 ||
           localDeclarationSeen[declarationRow] ||
           localPatternSeen[patternRow] ||
           sourceId < 0 ||
           tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationLocal) ||
           tables.parserSidecars.declarationProducerSourceIds[
               declarationRow] != sourceId ||
           tables.parserSidecars.patternProducerSourceIds[
               patternRow] != sourceId ||
           tables.parserSidecars.patternBindingDeclarationIds[
               patternRow] != declarationRow ||
           tables.parserSidecars.patternNameTokenIds[patternRow] !=
               tables.parserSidecars.declarationNameTokenIds[
                   declarationRow] ||
           ownerSymbolId != tables.functions.symbolIds[functionId] ||
           tables.typedNodes.functionIds[definingTypedNodeId] !=
               functionId ||
           tables.typedNodes.typeIds[definingTypedNodeId] != typeId ||
           tables.valueDefinitionGroups.definitionRows[groupRow] !=
               definitionRow ||
           tables.valueDefinitionGroups.producerSourceIndexes[
               groupRow] != producerSource ||
           tables.valueDefinitionGroups.parserProducerSourceIndexes[
               groupRow] != producerSource ||
           tables.valueDefinitionGroups.bindingOffsets[groupRow] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.valueDefinitionGroups_bindingOffsets,
                   groupRow) ||
           tables.valueDefinitionGroups.bindingCounts[groupRow] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.valueDefinitionGroups_bindingCounts,
                   groupRow) ||
           tables.valueDefinitionGroups.functionIds[groupRow] !=
               functionId ||
           tables.valueDefinitionGroups.declarationSourceLocalRows[
               groupRow] != declarationLocalRow ||
           tables.valueDefinitionGroups.patternSourceLocalRows[
               groupRow] != patternLocalRow ||
           texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
               csg.typedIr, definitionRow) !=
               tables.functions.typedFunctionIndexes[functionId] ||
           texpr.TypedExprValueDefinitionProducerSourceIndexAt(
               csg.typedIr, definitionRow) != producerSource ||
           texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
               csg.typedIr, definitionRow) != declarationLocalRow ||
           texpr.TypedExprValueDefinitionPatternSourceLocalRowAt(
               csg.typedIr, definitionRow) != patternLocalRow:
            err = " compiler snapshot builder: Local value-definition identity drift"
            return false
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        let parserScopeId =
            tables.parserSidecars.declarationLexicalScopeIds[
                declarationRow]
        if nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len ||
           nameSpanId < 0 || nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           parserScopeId < 0 ||
           parserScopeId >=
               tables.parserSidecars.declarationLexicalScopeKinds.len:
            err = " compiler snapshot builder: Local parser declaration authority incomplete"
            return false
        let nameTextId = tables.tokens.valueTextIds[nameTokenId]
        var nameProofCid: layout.FixedBytes32
        var definitionProofBuf = layout.ByteBufInit(160)
        if nameTextId < 0 || nameTextId >= tables.texts.len ||
           !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err):
            layout.ByteBufFree(definitionProofBuf)
            return false
        layout.ByteBufAppendFixed32(
            definitionProofBuf,
            tables.parserSidecars.sidecarCids[sourceId])
        compilerSnapshotBuilderHashAppendU32(
            definitionProofBuf, groupRow)
        compilerSnapshotBuilderHashAppendU32(
            definitionProofBuf, definitionRow)
        compilerSnapshotBuilderHashAppendU32(
            definitionProofBuf, declarationLocalRow)
        compilerSnapshotBuilderHashAppendU32(
            definitionProofBuf, patternLocalRow)
        compilerSnapshotBuilderHashAppendU32(
            definitionProofBuf,
            tables.valueDefinitionGroups.bindingOffsets[groupRow])
        compilerSnapshotBuilderHashAppendU32(
            definitionProofBuf,
            tables.valueDefinitionGroups.bindingCounts[groupRow])
        compilerSnapshotBuilderHashAppendU32(
            definitionProofBuf, definingTypedNodeId)
        layout.ByteBufAppendFixed32(
            definitionProofBuf, tables.types.typeCids[typeId])
        let definitionProofCid =
            hash256.Sha256Fixed(layout.ByteBufView(definitionProofBuf))
        layout.ByteBufFree(definitionProofBuf)
        add(tables.symbols.symbolCids, layout.FixedBytes32())
        add(tables.symbols.interfaceCids, layout.FixedBytes32())
        add(tables.symbols.declIds, -1)
        add(tables.symbols.declKeyCids, layout.FixedBytes32())
        add(tables.symbols.declarationHeaderCids,
            definitionProofCid)
        add(tables.symbols.declarationPathCids, nameProofCid)
        add(tables.symbols.sourceIds, sourceId)
        add(tables.symbols.nameTextIds, nameTextId)
        add(tables.symbols.nameSpanIds, nameSpanId)
        add(tables.symbols.nameTokenIds, nameTokenId)
        add(tables.symbols.qualifiedNameTextIds, nameTextId)
        add(tables.symbols.symbolKinds,
            snapshot_schema.CsgCompilerSymbolLocal)
        add(tables.symbols.typeIds, typeId)
        add(tables.symbols.declarationSpanIds,
            declarationSpanId)
        add(tables.symbols.ownerSymbolIds, ownerSymbolId)
        add(tables.symbols.functionIds, -1)
        add(tables.symbols.externFunctionIds, -1)
        add(tables.symbols.exportedFlags, false)
        add(tables.symbols.genericConstraintStarts,
            tables.symbols.genericConstraintTypeIds.len)
        add(tables.symbols.genericConstraintCounts, 0)
        add(tables.symbols.genericParameterParserRows, -1)
        add(tables.symbols.genericParameterOrdinals, -1)
        add(tables.symbols.genericParameterDefaultTypeIds, -1)
        add(declarationRowByOldSymbol, declarationRow)
        add(generatedQualifiedNames, strutil.Join([
            share(tables.texts[
                tables.sources.modulePathTextIds[sourceId]]),
            "::",
            share(tables.texts[
                tables.symbols.nameTextIds[ownerSymbolId]]),
            ".",
            share(tables.texts[nameTextId])
        ], ""))
        localDeclarationSeen[declarationRow] = true
        localPatternSeen[patternRow] = true
    # [local-symbol-domain] The Local symbol domain is the function-local one:
    # every row counted here is proved by a binding-initializer value definition
    # (`CsgCompilerValueDefinitionOriginBindingInitializer`), and the symbol Cid
    # appended below is a proof over that function-scoped definition row.  A
    # module-level `var`/`const` block entry is also a ParserDeclarationLocal
    # row, but with `declarationFunctionRows == -1` -- the same discriminator
    # `compilerCsgParserGlobalDeclaration` uses to classify it as a global
    # declaration -- and it has no function-local value definition by
    # construction (`ownerSymbolId != tables.functions.symbolIds[functionId]`
    # would reject one at the marking loop above).  Counting such a row here
    # demanded a definition that cannot exist, while no symbol was ever appended
    # for it, so the count and the count-driven identities below are narrowed to
    # the rows that can and must be proved.  Every function-local Local row is
    # still counted and still required to be seen: the equality
    # `expectedLocalCount == bindingDefinitionCount` remains, so a local
    # declaration that lost its definition still fails closed here.
    var expectedLocalCount: int32
    for declarationRow in 0..<declarationCount:
        if tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationLocal) ||
           tables.parserSidecars.declarationFunctionRows[
               declarationRow] < 0:
            continue
        expectedLocalCount = expectedLocalCount + 1
        if !localDeclarationSeen[declarationRow]:
            err = " compiler snapshot builder: Local declaration lacks exact value definition"
            return false
    if expectedLocalCount != bindingDefinitionCount ||
       bindingDefinitionCount != groupCount ||
       declarationRowByOldSymbol.len !=
           tables.symbols.symbolCids.len ||
       !compilerSnapshotBuilderGeneratedTextsMergeInto(
           tables, generatedQualifiedNames, err):
        if err == "":
            err = " compiler snapshot builder: Local Symbol coverage mismatch"
        return false
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolLocal:
            continue
        let ownerSymbolId =
            tables.symbols.ownerSymbolIds[symbolId]
        let qualifiedName = strutil.Join([
            share(tables.texts[
                tables.sources.modulePathTextIds[
                    tables.symbols.sourceIds[symbolId]]]),
            "::",
            share(tables.texts[
                tables.symbols.nameTextIds[ownerSymbolId]]),
            ".",
            share(tables.texts[
                tables.symbols.nameTextIds[symbolId]])
        ], "")
        let qualifiedNameTextId =
            compilerSnapshotBuilderTextFind(
                tables.texts, qualifiedName)
        if qualifiedNameTextId < 0:
            err = " compiler snapshot builder: Local qualified name missing"
            return false
        tables.symbols.qualifiedNameTextIds[symbolId] =
            qualifiedNameTextId
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderFinalizeTypeSymbolDeclKeyInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        declarationRow: int32,
        symbolId: int32,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    if declarationRow < 0 ||
       declarationRow >= tables.parserSidecars.declarationKinds.len ||
       symbolId < 0 || symbolId >= tables.symbols.symbolCids.len ||
       tables.symbols.symbolKinds[symbolId] !=
           snapshot_schema.CsgCompilerSymbolType:
        err = " compiler snapshot builder: Type DeclKey finalizer input invalid"
        return false
    let sourceId = tables.symbols.sourceIds[symbolId]
    let typeId = tables.symbols.typeIds[symbolId]
    if sourceId < 0 || sourceId >= sourceCount ||
       typeId < 0 || typeId >= tables.types.typeCids.len ||
       !compilerSnapshotBuilderCidObserved(
            tables.types.typeCids[typeId]):
        err = " compiler snapshot builder: Type signature TypeCid unavailable"
        return false
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    var moduleCandidateBySource: int32[]
    setLen(moduleCandidateBySource, sourceCount)
    for candidateSourceId in 0..<sourceCount:
        let moduleTextId =
            tables.sources.modulePathTextIds[candidateSourceId]
        if moduleTextId < 0 || moduleTextId >= tables.texts.len:
            err = " compiler snapshot builder: Type DeclKey module path missing"
            return false
        let modulePath = tables.texts[moduleTextId]
        let documentCid =
            tables.sources.documentCids[candidateSourceId]
        var moduleCandidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId, modulePath, documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               modulePath, documentCid, documentCid,
               layout.FixedBytes32(), 0, 0,
               moduleCandidateIndex, err):
            return false
        moduleCandidateBySource[candidateSourceId] =
            moduleCandidateIndex
    let nameTokenId =
        tables.parserSidecars.declarationNameTokenIds[declarationRow]
    let declarationSpanId =
        tables.parserSidecars.declarationSpanIds[declarationRow]
    if nameTokenId < 0 || nameTokenId >= tables.tokens.valueTextIds.len ||
       declarationSpanId < 0 ||
       declarationSpanId >= tables.spans.sourceIds.len ||
       tables.parserSidecars.declarationProducerSourceIds[
           declarationRow] != sourceId:
        err = " compiler snapshot builder: Type DeclKey parser coordinate missing"
        return false
    let nameTextId = tables.tokens.valueTextIds[nameTokenId]
    if nameTextId < 0 || nameTextId >= tables.texts.len:
        err = " compiler snapshot builder: Type DeclKey name text missing"
        return false
    var nameProofCid: layout.FixedBytes32
    if !compilerSnapshotBuilderDeclarationNameProofCidInto(
           tables, declarationRow, nameProofCid, err):
        return false
    var typeCandidateIndex: int32
    if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
           store, csg.packageId,
           tables.texts[tables.sources.modulePathTextIds[sourceId]],
           tables.sources.documentCids[sourceId], "",
           moduleCandidateBySource[sourceId],
           declaration.SemanticSnapshotDeclarationKindType,
           declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
           tables.texts[nameTextId], nameProofCid,
           tables.types.typeCids[typeId], layout.FixedBytes32(),
           tables.spans.startBytes[declarationSpanId],
           tables.spans.endBytes[declarationSpanId],
           typeCandidateIndex, err):
        return false
    var provisionalDeclarations: declaration.SemanticSnapshotDeclarationTable
    var provisionalMapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    if !declaration.SemanticSnapshotDeclarationTableSealInto(
           store, provisionalDeclarations, provisionalMapping, err):
        return false
    if typeCandidateIndex < 0 ||
       typeCandidateIndex >=
           provisionalMapping.producerCandidateToDeclIds.len:
        err = " compiler snapshot builder: Type DeclKey mapping missing"
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            provisionalDeclarations)
        return false
    let declId =
        provisionalMapping.producerCandidateToDeclIds[typeCandidateIndex]
    tables.symbols.symbolCids[symbolId] =
        provisionalDeclarations.declKeyCids[declId]
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        provisionalDeclarations)
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderReferenceRowsStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    let referenceCount = tables.references.sourceIds.len
    if referenceCount != tables.references.spanIds.len ||
       referenceCount != tables.references.ownerFunctionIds.len ||
       referenceCount != tables.references.ownerSymbolIds.len ||
       referenceCount != tables.references.targetSymbolIds.len ||
       referenceCount != tables.references.referenceKinds.len ||
       referenceCount != tables.references.bindingTypedNodeIds.len:
        err = " compiler snapshot builder: reference columns mismatch"
        return false
    let sourceCount = tables.sources.documentCids.len
    let spanCount = tables.spans.sourceIds.len
    let functionCount = tables.functions.symbolIds.len
    let symbolCount = tables.symbols.symbolCids.len
    for row in 0..<referenceCount:
        let sourceId = tables.references.sourceIds[row]
        let spanId = tables.references.spanIds[row]
        let ownerFunctionId =
            tables.references.ownerFunctionIds[row]
        let ownerSymbolId =
            tables.references.ownerSymbolIds[row]
        let targetSymbolId =
            tables.references.targetSymbolIds[row]
        let referenceKind =
            tables.references.referenceKinds[row]
        let bindingTypedNodeId =
            tables.references.bindingTypedNodeIds[row]
        if sourceId < 0 || sourceId >= sourceCount ||
           spanId < 0 || spanId >= spanCount ||
           ownerFunctionId < -1 ||
           ownerFunctionId >= functionCount ||
           ownerSymbolId < 0 || ownerSymbolId >= symbolCount ||
           targetSymbolId < 0 || targetSymbolId >= symbolCount ||
           bindingTypedNodeId < -1 ||
           bindingTypedNodeId >= tables.typedNodes.opKinds.len ||
           referenceKind < snapshot_schema.CsgCompilerReferenceRead ||
           referenceKind > snapshot_schema.CsgCompilerReferenceImport:
            err = " compiler snapshot builder: invalid reference owner/target binding"
            return false
        let ownerSymbolKind =
            tables.symbols.symbolKinds[ownerSymbolId]
        let targetSymbolKind =
            tables.symbols.symbolKinds[targetSymbolId]
        if tables.spans.sourceIds[spanId] != sourceId ||
           tables.symbols.sourceIds[ownerSymbolId] != sourceId ||
           (ownerSymbolKind != snapshot_schema.CsgCompilerSymbolModule &&
            ownerSymbolKind != snapshot_schema.CsgCompilerSymbolType &&
            ownerSymbolKind != snapshot_schema.CsgCompilerSymbolFunction) ||
           tables.symbols.functionIds[ownerSymbolId] !=
               ownerFunctionId ||
           ((targetSymbolKind ==
                 snapshot_schema.CsgCompilerSymbolParameter ||
             targetSymbolKind ==
                 snapshot_schema.CsgCompilerSymbolLocal) !=
            (bindingTypedNodeId >= 0)) ||
           (referenceKind == snapshot_schema.CsgCompilerReferenceCall &&
            targetSymbolKind != snapshot_schema.CsgCompilerSymbolFunction) ||
           (referenceKind == snapshot_schema.CsgCompilerReferenceType &&
            targetSymbolKind != snapshot_schema.CsgCompilerSymbolType) ||
           (referenceKind == snapshot_schema.CsgCompilerReferenceImport &&
            targetSymbolKind != snapshot_schema.CsgCompilerSymbolModule):
            err = " compiler snapshot builder: invalid reference owner/target binding"
            return false
    err = ""
    return true

@borrows
fn CompilerSnapshotBuilderBindingReferencesMergeInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let oldReferenceCount = tables.references.sourceIds.len
    let typedNodeCount =
        tables.typedNodes.typedIrNodeIndexes.len
    if !compilerSnapshotBuilderReferenceRowsStrictValidateInto(
           tables, err) ||
       typedNodeCount != csg.typedIr.nodes2_nodeIndexs.len ||
       typedNodeCount != tables.typedNodes.opKinds.len ||
       typedNodeCount != tables.typedNodes.originParserNodeIds.len ||
       typedNodeCount !=
           tables.typedNodes.bindingProducerSourceIndexes.len ||
       typedNodeCount !=
           tables.typedNodes.bindingParserSourceLocalNodeRows.len ||
       typedNodeCount !=
           tables.typedNodes.bindingDeclarationSourceLocalRows.len ||
       typedNodeCount !=
           tables.typedNodes.bindingPatternSourceLocalRows.len ||
       typedNodeCount !=
           tables.typedNodes.bindingValueDefinitionRows.len ||
       typedNodeCount != tables.typedNodes.ownerStatementIds.len ||
       typedNodeCount != tables.typedNodes.functionIds.len ||
       typedNodeCount != tables.typedNodes.typeIds.len ||
       typedNodeCount != tables.typedNodes.spanIds.len:
        if err == "":
            err = " compiler snapshot builder: binding reference input domain split"
        return false
    var positionByProducerNode: int32[]
    setLen(
        positionByProducerNode,
        csg.typedIr.nodes2_nodeIndexs.len)
    for row in 0..<positionByProducerNode.len:
        positionByProducerNode[row] = -1
    for nodePosition in 0..<csg.typedIr.nodes2_nodeIndexs.len:
        let producerNodeId =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_nodeIndexs,
                nodePosition)
        if producerNodeId < 0 ||
           producerNodeId >= positionByProducerNode.len ||
           positionByProducerNode[producerNodeId] >= 0:
            err = " compiler snapshot builder: binding reference TypedExpr index invalid"
            return false
        positionByProducerNode[producerNodeId] = nodePosition
    var symbolByParserDeclaration: int32[]
    setLen(
        symbolByParserDeclaration,
        tables.parserSidecars.declarationKinds.len)
    for row in 0..<symbolByParserDeclaration.len:
        symbolByParserDeclaration[row] = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let symbolKind = tables.symbols.symbolKinds[symbolId]
        if symbolKind != snapshot_schema.CsgCompilerSymbolParameter &&
           symbolKind != snapshot_schema.CsgCompilerSymbolLocal:
            continue
        var parserDeclaration: int32 = -1
        for declarationRow in 0..<
                tables.parserSidecars.declarationKinds.len:
            if tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] !=
                   tables.symbols.sourceIds[symbolId] ||
               tables.parserSidecars.declarationNameTokenIds[
                   declarationRow] !=
                   tables.symbols.nameTokenIds[symbolId] ||
               tables.parserSidecars.declarationNameSpanIds[
                   declarationRow] !=
                   tables.symbols.nameSpanIds[symbolId] ||
               tables.parserSidecars.declarationSpanIds[
                   declarationRow] !=
                   tables.symbols.declarationSpanIds[symbolId]:
                continue
            if parserDeclaration >= 0:
                err = " compiler snapshot builder: binding target parser declaration ambiguous"
                return false
            parserDeclaration = declarationRow
        if parserDeclaration < 0 ||
           symbolByParserDeclaration[parserDeclaration] >= 0 ||
           (symbolKind == snapshot_schema.CsgCompilerSymbolParameter &&
            tables.parserSidecars.declarationKinds[
                parserDeclaration] !=
                Int32(parser.ParserDeclarationParameter)) ||
           (symbolKind == snapshot_schema.CsgCompilerSymbolLocal &&
            tables.parserSidecars.declarationKinds[
                parserDeclaration] !=
                Int32(parser.ParserDeclarationLocal)):
            err = " compiler snapshot builder: binding target parser declaration missing"
            return false
        symbolByParserDeclaration[parserDeclaration] = symbolId
    var sourceIds: int32[]
    var spanIds: int32[]
    var ownerFunctionIds: int32[]
    var ownerSymbolIds: int32[]
    var targetSymbolIds: int32[]
    var referenceKinds: int32[]
    var bindingTypedNodeIds: int32[]
    for row in 0..<oldReferenceCount:
        add(sourceIds, tables.references.sourceIds[row])
        add(spanIds, tables.references.spanIds[row])
        add(ownerFunctionIds,
            tables.references.ownerFunctionIds[row])
        add(ownerSymbolIds,
            tables.references.ownerSymbolIds[row])
        add(targetSymbolIds,
            tables.references.targetSymbolIds[row])
        add(referenceKinds,
            tables.references.referenceKinds[row])
        add(bindingTypedNodeIds,
            tables.references.bindingTypedNodeIds[row])
    for typedNodeId in 0..<tables.typedNodes.opKinds.len:
        let opKind = tables.typedNodes.opKinds[typedNodeId]
        if opKind != Int32(texpr.TypedExprIrOpParamRef) &&
           opKind != Int32(texpr.TypedExprIrOpLocalRef):
            continue
        let originParserNodeId =
            tables.typedNodes.originParserNodeIds[typedNodeId]
        let producerSource =
            tables.typedNodes.bindingProducerSourceIndexes[
                typedNodeId]
        if producerSource < 0:
            continue
        let producerNodeId =
            tables.typedNodes.typedIrNodeIndexes[typedNodeId]
        let nodePosition =
            producerNodeId < 0 ||
            producerNodeId >= positionByProducerNode.len ?
                -1 :
                positionByProducerNode[producerNodeId]
        let parserSourceLocalNode =
            tables.typedNodes.bindingParserSourceLocalNodeRows[
                typedNodeId]
        let declarationLocalRow =
            tables.typedNodes.bindingDeclarationSourceLocalRows[
                typedNodeId]
        let patternLocalRow =
            tables.typedNodes.bindingPatternSourceLocalRows[
                typedNodeId]
        let definitionRow =
            tables.typedNodes.bindingValueDefinitionRows[
                typedNodeId]
        let functionId =
            tables.typedNodes.functionIds[typedNodeId]
        let sourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, producerSource)
        var originIdentityInvalid = false
        if originParserNodeId >= 0:
            originIdentityInvalid =
                originParserNodeId >=
                    tables.parserNodes.sourceIds.len ||
                tables.parserNodes.sourceIds[originParserNodeId] !=
                    sourceId ||
                tables.parserNodes.producerNodeIds[
                    originParserNodeId] != parserSourceLocalNode ||
                tables.parserNodes.kinds[originParserNodeId] !=
                    snapshot_schema.CsgCompilerParserValueExprIdentifier
        if nodePosition < 0 ||
           producerSource >=
               csg.parserNormalizedExprReceipt.sourceSidecars.len ||
           sourceId < 0 ||
           functionId < 0 ||
           functionId >= tables.functions.symbolIds.len ||
           originIdentityInvalid ||
           texpr.TypedExprIrNodeBindingParserNodeIndexAt(
               csg.typedIr, nodePosition) !=
               parserSourceLocalNode ||
           texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
               csg.typedIr, nodePosition) != producerSource ||
           texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
               csg.typedIr, nodePosition) != declarationLocalRow ||
           texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
               csg.typedIr, nodePosition) != patternLocalRow ||
           texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
               csg.typedIr, nodePosition) != definitionRow:
            err = " compiler snapshot builder: binding reference TypedExpr/parser identity drift"
            return false
        var parserDeclaration: int32 = -1
        for declarationRow in 0..<
                tables.parserSidecars.declarationKinds.len:
            if tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] == sourceId &&
               tables.parserSidecars.declarationSourceLocalRows[
                   declarationRow] == declarationLocalRow:
                if parserDeclaration >= 0:
                    err = " compiler snapshot builder: binding declaration coordinate ambiguous"
                    return false
                parserDeclaration = declarationRow
        let targetSymbolId =
            parserDeclaration < 0 ||
            parserDeclaration >= symbolByParserDeclaration.len ?
                -1 :
                symbolByParserDeclaration[parserDeclaration]
        if targetSymbolId < 0 ||
           tables.symbols.ownerSymbolIds[targetSymbolId] !=
               tables.functions.symbolIds[functionId] ||
           tables.symbols.typeIds[targetSymbolId] !=
               tables.typedNodes.typeIds[typedNodeId]:
            err = " compiler snapshot builder: binding reference target Symbol missing"
            return false
        if opKind == Int32(texpr.TypedExprIrOpParamRef):
            var paramOriginInvalid = false
            if originParserNodeId >= 0:
                paramOriginInvalid =
                    tables.parserNodes.bindingResolutionKinds[
                        originParserNodeId] !=
                        snapshot_schema.CsgCompilerParserBindingResolutionParameter ||
                    tables.parserNodes.bindingDeclarationSourceLocalRows[
                        originParserNodeId] != declarationLocalRow ||
                    tables.parserNodes.bindingPatternSourceLocalRows[
                        originParserNodeId] != -1
            if paramOriginInvalid ||
               patternLocalRow != -1 ||
               definitionRow < 0 ||
               definitionRow >= tables.valueDefinitions.originKinds.len ||
               tables.valueDefinitions.originKinds[definitionRow] !=
                   Int32(texpr.TypedExprValueDefinitionOriginParameter) ||
               tables.symbols.symbolKinds[targetSymbolId] !=
                   snapshot_schema.CsgCompilerSymbolParameter:
                err = " compiler snapshot builder: ParamRef reference authority drift"
                return false
        else:
            if definitionRow < 0 ||
               definitionRow >= tables.valueDefinitions.groupRows.len:
                err = " compiler snapshot builder: LocalRef value definition missing"
                return false
            let groupRow =
                tables.valueDefinitions.groupRows[definitionRow]
            var parserPattern: int32 = -1
            for patternRow in 0..<
                    tables.parserSidecars.patternKinds.len:
                if tables.parserSidecars.patternProducerSourceIds[
                       patternRow] == sourceId &&
                   tables.parserSidecars.patternSourceLocalRows[
                       patternRow] == patternLocalRow:
                    if parserPattern >= 0:
                        err = " compiler snapshot builder: LocalRef pattern coordinate ambiguous"
                        return false
                    parserPattern = patternRow
            var localOriginInvalid = false
            if originParserNodeId >= 0:
                localOriginInvalid =
                    tables.parserNodes.bindingResolutionKinds[
                        originParserNodeId] !=
                        snapshot_schema.CsgCompilerParserBindingResolutionPattern ||
                    tables.parserNodes.bindingDeclarationSourceLocalRows[
                        originParserNodeId] != declarationLocalRow ||
                    tables.parserNodes.bindingPatternSourceLocalRows[
                        originParserNodeId] != patternLocalRow
            if groupRow < 0 ||
               groupRow >=
                   tables.valueDefinitionGroups.definitionRows.len ||
               parserPattern < 0 ||
               localOriginInvalid ||
               tables.parserSidecars.patternBindingDeclarationIds[
                   parserPattern] != parserDeclaration ||
               tables.valueDefinitions.producerSourceIndexes[
                   definitionRow] != producerSource ||
               tables.valueDefinitions.declarationSourceLocalRows[
                   definitionRow] != declarationLocalRow ||
               tables.valueDefinitions.patternSourceLocalRows[
                   definitionRow] != patternLocalRow ||
               tables.valueDefinitions.functionIds[definitionRow] !=
                   functionId ||
               tables.valueDefinitions.typeIds[definitionRow] !=
                   tables.symbols.typeIds[targetSymbolId] ||
               tables.valueDefinitionGroups.definitionRows[groupRow] !=
                   definitionRow ||
               tables.valueDefinitionGroups.producerSourceIndexes[
                   groupRow] != producerSource ||
               tables.valueDefinitionGroups.parserProducerSourceIndexes[
                   groupRow] != producerSource ||
               tables.valueDefinitionGroups.functionIds[groupRow] !=
                   functionId ||
               tables.valueDefinitionGroups.declarationSourceLocalRows[
                   groupRow] != declarationLocalRow ||
               tables.valueDefinitionGroups.patternSourceLocalRows[
                   groupRow] != patternLocalRow ||
               tables.symbols.symbolKinds[targetSymbolId] !=
                   snapshot_schema.CsgCompilerSymbolLocal:
                err = " compiler snapshot builder: LocalRef exact binding authority drift"
                return false
        let spanId = tables.typedNodes.spanIds[typedNodeId]
        if spanId < 0 || spanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[spanId] != sourceId:
            err = " compiler snapshot builder: binding reference span missing"
            return false
        add(sourceIds, sourceId)
        add(spanIds, spanId)
        add(ownerFunctionIds, functionId)
        add(ownerSymbolIds,
            tables.functions.symbolIds[functionId])
        add(targetSymbolIds, targetSymbolId)
        add(referenceKinds,
            snapshot_schema.CsgCompilerReferenceRead)
        add(bindingTypedNodeIds, typedNodeId)
    var order: int32[]
    setLen(order, sourceIds.len)
    for row in 0..<order.len:
        order[row] = row
    for row in 1..<order.len:
        let referenceId = order[row]
        var cursor = row
        while cursor > 0:
            let previous = order[cursor - 1]
            let ordered =
                targetSymbolIds[previous] <
                    targetSymbolIds[referenceId] ||
                (targetSymbolIds[previous] ==
                     targetSymbolIds[referenceId] &&
                 sourceIds[previous] < sourceIds[referenceId]) ||
                (targetSymbolIds[previous] ==
                     targetSymbolIds[referenceId] &&
                 sourceIds[previous] == sourceIds[referenceId] &&
                 spanIds[previous] < spanIds[referenceId]) ||
                (targetSymbolIds[previous] ==
                     targetSymbolIds[referenceId] &&
                 sourceIds[previous] == sourceIds[referenceId] &&
                 spanIds[previous] == spanIds[referenceId] &&
                 bindingTypedNodeIds[previous] <
                     bindingTypedNodeIds[referenceId])
            if ordered:
                break
            order[cursor] = previous
            cursor = cursor - 1
        order[cursor] = referenceId
    var newByOld: int32[]
    setLen(newByOld, sourceIds.len)
    var canonical: snapshot_schema.CsgCompilerReferenceTable
    for newReferenceId in 0..<order.len:
        let oldReferenceId = order[newReferenceId]
        if newReferenceId > 0:
            let previous = order[newReferenceId - 1]
            if targetSymbolIds[previous] ==
                   targetSymbolIds[oldReferenceId] &&
               sourceIds[previous] == sourceIds[oldReferenceId] &&
               spanIds[previous] == spanIds[oldReferenceId] &&
               bindingTypedNodeIds[previous] ==
                   bindingTypedNodeIds[oldReferenceId]:
                err = " compiler snapshot builder: duplicate binding reference coordinate"
                return false
        newByOld[oldReferenceId] = newReferenceId
        add(canonical.sourceIds, sourceIds[oldReferenceId])
        add(canonical.spanIds, spanIds[oldReferenceId])
        add(canonical.ownerFunctionIds,
            ownerFunctionIds[oldReferenceId])
        add(canonical.ownerSymbolIds,
            ownerSymbolIds[oldReferenceId])
        add(canonical.targetSymbolIds,
            targetSymbolIds[oldReferenceId])
        add(canonical.referenceKinds,
            referenceKinds[oldReferenceId])
        add(canonical.bindingTypedNodeIds,
            bindingTypedNodeIds[oldReferenceId])
    for callRow in 0..<tables.calls.callReferenceIds.len:
        let oldReferenceId =
            tables.calls.callReferenceIds[callRow]
        if oldReferenceId < 0 ||
           oldReferenceId >= oldReferenceCount:
            err = " compiler snapshot builder: call binding reference remap invalid"
            return false
        tables.calls.callReferenceIds[callRow] =
            newByOld[oldReferenceId]
    tables.references = canonical
    for callRow in 0..<tables.calls.callReferenceIds.len:
        var proofCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerCallResultOwnershipProofCidInto(
               tables, callRow, proofCid, err):
            return false
        tables.calls.resultOwnershipProofCids[callRow] =
            proofCid
    return snapshot_schema.CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
        tables, err)

@borrows
fn compilerSnapshotBuilderDeclarationAuthorityCommitInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        declarationRowByOldSymbol: int32[],
        oldSymbolIdsByCid: var int32[],
        unsealedProductionBase: bool,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let symbolCount = tables.symbols.symbolCids.len
    let functionCount = tables.functions.symbolIds.len
    let externFunctionCount =
        tables.externFunctions.symbolIds.len
    let genericParameterCount =
        tables.parserSidecars.typeGenericSymbolProducerSourceIds.len
    var typeDeclarationCount: int32
    var fieldDeclarationCount: int32
    var parameterDeclarationCount: int32
    var localDeclarationCount: int32
    for declarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        if tables.parserSidecars.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationType):
            typeDeclarationCount = typeDeclarationCount + 1
        elif tables.parserSidecars.declarationKinds[declarationRow] ==
                 Int32(parser.ParserDeclarationField):
            fieldDeclarationCount = fieldDeclarationCount + 1
        elif tables.parserSidecars.declarationKinds[declarationRow] ==
                 Int32(parser.ParserDeclarationParameter):
            parameterDeclarationCount =
                parameterDeclarationCount + 1
        elif unsealedProductionBase &&
             tables.parserSidecars.declarationKinds[declarationRow] ==
                 Int32(parser.ParserDeclarationLocal) &&
             tables.parserSidecars.declarationFunctionRows[
                 declarationRow] >= 0:
            localDeclarationCount =
                localDeclarationCount + 1
    if sourceCount <= 0 ||
       functionCount > 2147483647 - sourceCount ||
       externFunctionCount >
           2147483647 - sourceCount - functionCount ||
       typeDeclarationCount >
           2147483647 - sourceCount - functionCount -
               externFunctionCount ||
       fieldDeclarationCount >
           2147483647 - sourceCount - functionCount -
               externFunctionCount - typeDeclarationCount ||
       parameterDeclarationCount >
           2147483647 - sourceCount - functionCount -
               externFunctionCount - typeDeclarationCount -
               fieldDeclarationCount ||
       localDeclarationCount >
           2147483647 - sourceCount - functionCount -
               externFunctionCount - typeDeclarationCount -
               fieldDeclarationCount - parameterDeclarationCount ||
       genericParameterCount >
           2147483647 - sourceCount - functionCount -
               externFunctionCount - typeDeclarationCount -
               fieldDeclarationCount - parameterDeclarationCount -
               localDeclarationCount ||
       tables.symbols.symbolCids.len !=
           functionCount + externFunctionCount + sourceCount +
               typeDeclarationCount + fieldDeclarationCount +
               parameterDeclarationCount +
               localDeclarationCount +
               genericParameterCount ||
       ((!unsealedProductionBase &&
         oldSymbolIdsByCid.len !=
             functionCount + externFunctionCount + sourceCount) ||
        (unsealedProductionBase &&
         oldSymbolIdsByCid.len != 0)) ||
       sidecars.len != sourceCount ||
       declarationRowByOldSymbol.len != symbolCount ||
       tables.declarations.declIds.len != 0:
        err = " compiler snapshot builder: declaration authority destination invalid"
        return false
    if unsealedProductionBase:
        if tables.readSet.readerFunctionIds.len != 0 ||
           tables.readSet.targetDomainKinds.len != 0 ||
           tables.readSet.targetPortableKeyCids.len != 0 ||
           tables.readSet.observedValueCids.len != 0:
            err = " compiler snapshot builder: unsealed production base carried read authority"
            return false
        for symbolId in 0..<
                functionCount + externFunctionCount + sourceCount:
            let symbolTypeId =
                tables.symbols.typeIds[symbolId]
            let functionSymbol =
                tables.symbols.symbolKinds[symbolId] ==
                    snapshot_schema.CsgCompilerSymbolFunction
            if compilerSnapshotBuilderCidObserved(
                   tables.symbols.symbolCids[symbolId]) ||
               compilerSnapshotBuilderCidObserved(
                   tables.symbols.interfaceCids[symbolId]) ||
               tables.symbols.declIds[symbolId] != -1 ||
               compilerSnapshotBuilderCidObserved(
                   tables.symbols.declKeyCids[symbolId]) ||
               (functionSymbol &&
                (tables.symbols.symbolKinds[symbolId] !=
                     snapshot_schema.CsgCompilerSymbolFunction ||
                 symbolTypeId < 0 ||
                 symbolTypeId >= tables.types.typeKinds.len ||
                 tables.types.typeKinds[symbolTypeId] !=
                     snapshot_schema.CsgCompilerTypeFunction)) ||
               (!functionSymbol &&
                (tables.symbols.symbolKinds[symbolId] !=
                     snapshot_schema.CsgCompilerSymbolModule ||
                 symbolTypeId != -1)):
                err = " compiler snapshot builder: unsealed production base claimed Symbol authority"
                return false
    if !compilerSnapshotBuilderReferenceRowsStrictValidateInto(
           tables, err):
        return false
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    var moduleCandidateBySource: int32[]
    setLen(moduleCandidateBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        let moduleTextId = tables.sources.modulePathTextIds[sourceId]
        if moduleTextId < 0 || moduleTextId >= tables.texts.len:
            err = " compiler snapshot builder: declaration module path missing"
            return false
        let modulePath = tables.texts[moduleTextId]
        let documentCid = tables.sources.documentCids[sourceId]
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId, modulePath, documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               modulePath, documentCid, documentCid,
               layout.FixedBytes32(), 0, 0,
               candidateIndex, err):
            return false
        moduleCandidateBySource[sourceId] = candidateIndex
    var typedRowByReachable: int32[]
    if !compilerSnapshotBuilderTypedFunctionJoinInto(
           csg, typedRowByReachable, err):
        return false
    var parserRowByReachable: int32[]
    setLen(parserRowByReachable, typedRowByReachable.len)
    for row in 0..<parserRowByReachable.len:
        parserRowByReachable[row] = -1
    for parserRow in 0..<tables.parserSidecars.functionIndexes.len:
        let reachableRow = tables.parserSidecars.functionIndexes[parserRow]
        if reachableRow < 0 || reachableRow >= parserRowByReachable.len ||
           parserRowByReachable[reachableRow] >= 0:
            err = " compiler snapshot builder: declaration parser row is not bijective"
            return false
        parserRowByReachable[reachableRow] = parserRow
    var candidateByOldSymbol: int32[]
    setLen(candidateByOldSymbol, symbolCount)
    for symbolId in 0..<symbolCount:
        candidateByOldSymbol[symbolId] = -1
    var moduleSymbolBySource: int32[]
    setLen(moduleSymbolBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        moduleSymbolBySource[sourceId] = -1
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolModule:
            continue
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount ||
           moduleSymbolBySource[sourceId] >= 0 ||
           tables.symbols.ownerSymbolIds[symbolId] != -1 ||
           tables.symbols.typeIds[symbolId] != -1 ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] != -1 ||
           declarationRowByOldSymbol[symbolId] != -1:
            err = " compiler snapshot builder: module Symbol declaration binding invalid"
            return false
        moduleSymbolBySource[sourceId] = symbolId
    for sourceId in 0..<sourceCount:
        let symbolId = moduleSymbolBySource[sourceId]
        if symbolId < 0:
            err = " compiler snapshot builder: module Symbol declaration binding missing"
            return false
        candidateByOldSymbol[symbolId] =
            moduleCandidateBySource[sourceId]
    var typeDeclarationSeen: bool[]
    setLen(typeDeclarationSeen,
        tables.parserSidecars.declarationKinds.len)
    var committedTypeDeclarationCount: int32
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolType:
            continue
        let declarationRow =
            declarationRowByOldSymbol[symbolId]
        if declarationRow < 0 ||
           declarationRow >=
               tables.parserSidecars.declarationKinds.len ||
           typeDeclarationSeen[declarationRow] ||
           tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationType):
            err = " compiler snapshot builder: Type declaration row identity invalid"
            return false
        let sourceId = tables.symbols.sourceIds[symbolId]
        let parserSourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        let typeId = tables.symbols.typeIds[symbolId]
        var declarationTypeBindingCount: int32
        for candidateTypeId in 0..<tables.types.typeCids.len:
            if tables.types.declSymbolIds[candidateTypeId] ==
                   symbolId:
                let candidateKind =
                    tables.types.typeKinds[candidateTypeId]
                let aliasBinding =
                    candidateKind == snapshot_schema.CsgCompilerTypeAlias &&
                    tables.types.aliasTargetTypeIds[candidateTypeId] ==
                        typeId
                let nominalBinding =
                    (candidateKind == snapshot_schema.CsgCompilerTypeObject ||
                     candidateKind ==
                         snapshot_schema.CsgCompilerTypeRefObject ||
                     candidateKind == snapshot_schema.CsgCompilerTypeEnum) &&
                    candidateTypeId == typeId
                if !aliasBinding && !nominalBinding:
                    err = " compiler snapshot builder: Type declaration Type binding drift"
                    return false
                declarationTypeBindingCount =
                    declarationTypeBindingCount + 1
        if sourceId < 0 || sourceId >= sourceCount ||
           parserSourceId != sourceId ||
           nameTokenId < 0 ||
           nameTokenId >= tables.tokens.sourceIds.len ||
           nameSpanId < 0 || nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           typeId < 0 || typeId >= tables.types.typeCids.len ||
           tables.symbols.ownerSymbolIds[symbolId] !=
               moduleSymbolBySource[sourceId] ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] != -1 ||
           tables.symbols.nameTokenIds[symbolId] != nameTokenId ||
           tables.symbols.nameSpanIds[symbolId] != nameSpanId ||
           tables.symbols.declarationSpanIds[symbolId] !=
               declarationSpanId ||
           tables.symbols.nameTextIds[symbolId] !=
               tables.tokens.valueTextIds[nameTokenId] ||
           declarationTypeBindingCount != 1:
            err = " compiler snapshot builder: Type declaration authority incomplete"
            return false
        var nameProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err):
            return false
        let modulePath = tables.texts[
            tables.sources.modulePathTextIds[sourceId]]
        let name = tables.texts[
            tables.tokens.valueTextIds[nameTokenId]]
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId, modulePath,
               tables.sources.documentCids[sourceId], "",
               moduleCandidateBySource[sourceId],
               declaration.SemanticSnapshotDeclarationKindType,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               name, nameProofCid,
               tables.types.typeCids[typeId], layout.FixedBytes32(),
               tables.spans.startBytes[declarationSpanId],
               tables.spans.endBytes[declarationSpanId],
               candidateIndex, err):
            return false
        candidateByOldSymbol[symbolId] = candidateIndex
        typeDeclarationSeen[declarationRow] = true
        committedTypeDeclarationCount =
            committedTypeDeclarationCount + 1
    if committedTypeDeclarationCount != typeDeclarationCount:
        err = " compiler snapshot builder: Type declaration authority coverage mismatch"
        return false
    var symbolByParserDeclaration: int32[]
    setLen(symbolByParserDeclaration,
           tables.parserSidecars.declarationKinds.len)
    for declarationRow in 0..<symbolByParserDeclaration.len:
        symbolByParserDeclaration[declarationRow] = -1
    for symbolId in 0..<symbolCount:
        let declarationRow =
            declarationRowByOldSymbol[symbolId]
        if declarationRow < 0:
            continue
        if declarationRow >= symbolByParserDeclaration.len ||
           symbolByParserDeclaration[declarationRow] >= 0:
            err = " compiler snapshot builder: declaration Symbol mapping is not bijective"
            return false
        symbolByParserDeclaration[declarationRow] = symbolId
    var committedFieldDeclarationCount: int32
    var fieldDeclarationSeen: bool[]
    setLen(fieldDeclarationSeen,
           tables.parserSidecars.declarationKinds.len)
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolField:
            continue
        let declarationRow =
            declarationRowByOldSymbol[symbolId]
        if declarationRow < 0 ||
           declarationRow >=
               tables.parserSidecars.declarationKinds.len ||
           fieldDeclarationSeen[declarationRow] ||
           tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationField):
            err = " compiler snapshot builder: Field declaration row identity invalid"
            return false
        let parserOwnerDeclaration =
            tables.parserSidecars.declarationOwnerIds[
                declarationRow]
        let ownerTypeSymbolId =
            parserOwnerDeclaration < 0 ||
            parserOwnerDeclaration >= symbolByParserDeclaration.len ?
                -1 :
                symbolByParserDeclaration[parserOwnerDeclaration]
        let immediateOwnerSymbolId =
            tables.symbols.ownerSymbolIds[symbolId]
        let fieldRoot =
            tables.parserSidecars.declarationTypeSyntaxRootIds[
                declarationRow]
        let immediateOwnerRoot =
            fieldRoot < 0 ||
            fieldRoot >=
                tables.parserSidecars.typeSyntaxDeclarationOwnerIds.len ?
                -1 :
                tables.parserSidecars.typeSyntaxDeclarationOwnerIds[
                    fieldRoot]
        let immediateOwnerDeclaration =
            immediateOwnerSymbolId < 0 ||
            immediateOwnerSymbolId >= declarationRowByOldSymbol.len ?
                -1 :
                declarationRowByOldSymbol[immediateOwnerSymbolId]
        let sourceId = tables.symbols.sourceIds[symbolId]
        let typeId = tables.symbols.typeIds[symbolId]
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        if parserOwnerDeclaration < 0 ||
           parserOwnerDeclaration >=
               tables.parserSidecars.declarationKinds.len ||
           tables.parserSidecars.declarationKinds[
               parserOwnerDeclaration] !=
               Int32(parser.ParserDeclarationType) ||
           ownerTypeSymbolId < 0 ||
           candidateByOldSymbol[ownerTypeSymbolId] < 0 ||
           immediateOwnerDeclaration < 0 ||
           tables.parserSidecars.declarationTypeSyntaxRootIds[
               immediateOwnerDeclaration] != immediateOwnerRoot ||
           (tables.symbols.symbolKinds[immediateOwnerSymbolId] !=
                snapshot_schema.CsgCompilerSymbolType &&
            tables.symbols.symbolKinds[immediateOwnerSymbolId] !=
                snapshot_schema.CsgCompilerSymbolField) ||
           sourceId < 0 || sourceId >= sourceCount ||
           tables.parserSidecars.declarationProducerSourceIds[
               declarationRow] != sourceId ||
           tables.symbols.sourceIds[immediateOwnerSymbolId] != sourceId ||
           typeId < 0 || typeId >= tables.types.typeCids.len ||
           nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len ||
           nameSpanId < 0 || nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.symbols.nameTokenIds[symbolId] != nameTokenId ||
           tables.symbols.nameSpanIds[symbolId] != nameSpanId ||
           tables.symbols.declarationSpanIds[symbolId] !=
               declarationSpanId ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] != -1 ||
           tables.symbols.exportedFlags[symbolId]:
            err = " compiler snapshot builder: Field declaration authority incomplete"
            return false
        var nameProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err):
            return false
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId,
               tables.texts[
                   tables.sources.modulePathTextIds[sourceId]],
               tables.sources.documentCids[sourceId], "",
               candidateByOldSymbol[ownerTypeSymbolId],
               declaration.SemanticSnapshotDeclarationKindField,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               tables.texts[tables.symbols.nameTextIds[symbolId]],
               nameProofCid, tables.types.typeCids[typeId],
               layout.FixedBytes32(),
               tables.spans.startBytes[declarationSpanId],
               tables.spans.endBytes[declarationSpanId],
               candidateIndex, err):
            return false
        candidateByOldSymbol[symbolId] = candidateIndex
        fieldDeclarationSeen[declarationRow] = true
        committedFieldDeclarationCount =
            committedFieldDeclarationCount + 1
    if committedFieldDeclarationCount != fieldDeclarationCount:
        err = " compiler snapshot builder: Field declaration authority coverage mismatch"
        return false
    for functionId in 0..<functionCount:
        let symbolId = tables.functions.symbolIds[functionId]
        let typedRow = tables.functions.typedFunctionIndexes[functionId]
        var reachableRow: int32 = -1
        for candidateReachable in 0..<typedRowByReachable.len:
            if typedRowByReachable[candidateReachable] == typedRow:
                if reachableRow >= 0:
                    err = " compiler snapshot builder: typed row has two declarations"
                    return false
                reachableRow = candidateReachable
        let parserRow = reachableRow < 0 ? -1 :
            parserRowByReachable[reachableRow]
        if symbolId < 0 || symbolId >= symbolCount ||
           candidateByOldSymbol[symbolId] >= 0 ||
           declarationRowByOldSymbol[symbolId] != -1 ||
           parserRow < 0:
            err = " compiler snapshot builder: function declaration join missing"
            return false
        let sourceId = tables.symbols.sourceIds[symbolId]
        let typeId = tables.symbols.typeIds[symbolId]
        let declarationSpanId =
            tables.parserSidecars.functionDeclarationSpanIds[parserRow]
        if sourceId < 0 || sourceId >= sourceCount ||
           typeId < 0 || typeId >= tables.types.typeCids.len ||
           tables.symbols.ownerSymbolIds[symbolId] !=
               moduleSymbolBySource[sourceId] ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[declarationSpanId] != sourceId:
            err = " compiler snapshot builder: function declaration authority incomplete"
            return false
        let modulePath = tables.texts[
            tables.sources.modulePathTextIds[sourceId]]
        let name = tables.texts[
            tables.parserSidecars.functionNameTextIds[parserRow]]
        let producerSourceIndex =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        let localFunctionRow = parserRow -
            compilerSnapshotBuilderParserFunctionBaseForSource(
                tables, sourceId)
        if producerSourceIndex < 0 || producerSourceIndex >= sidecars.len ||
           localFunctionRow < 0 ||
           localFunctionRow >=
               sidecars[producerSourceIndex].functionNameProofCids.len ||
           tables.parserSidecars.functionNameSurfaceKinds[parserRow] !=
               sidecars[producerSourceIndex].functionNameSurfaceKinds[
                   localFunctionRow] ||
           !layout.FixedBytes32Equal(
               tables.parserSidecars.functionNameProofCids[parserRow],
               sidecars[producerSourceIndex].functionNameProofCids[
                   localFunctionRow]):
            err = " compiler snapshot builder: parser name proof binding drift"
            return false
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId, modulePath,
               tables.sources.documentCids[sourceId], "",
               moduleCandidateBySource[sourceId],
               declaration.SemanticSnapshotDeclarationKindFunction,
               tables.parserSidecars.functionNameSurfaceKinds[parserRow],
               name,
               tables.parserSidecars.functionNameProofCids[parserRow],
               tables.types.typeCids[typeId], layout.FixedBytes32(),
               tables.spans.startBytes[declarationSpanId],
               tables.spans.endBytes[declarationSpanId],
               candidateIndex, err):
            return false
        candidateByOldSymbol[symbolId] = candidateIndex
    var externParserDeclarationSeen: bool[]
    setLen(externParserDeclarationSeen,
        tables.parserSidecars.declarationKinds.len)
    for externFunctionId in 0..<externFunctionCount:
        let symbolId =
            tables.externFunctions.symbolIds[externFunctionId]
        let parserDeclarationRow =
            tables.externFunctions.parserDeclarationRows[
                externFunctionId]
        if symbolId < 0 || symbolId >= symbolCount ||
           candidateByOldSymbol[symbolId] >= 0 ||
           declarationRowByOldSymbol[symbolId] != -1 ||
           parserDeclarationRow < 0 ||
           parserDeclarationRow >=
               tables.parserSidecars.declarationKinds.len ||
           externParserDeclarationSeen[parserDeclarationRow] ||
           tables.parserSidecars.declarationKinds[
               parserDeclarationRow] !=
               Int32(parser.ParserDeclarationFunction):
            err = " compiler snapshot builder: extern declaration join missing"
            return false
        let sourceId = tables.symbols.sourceIds[symbolId]
        let typeId = tables.symbols.typeIds[symbolId]
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                parserDeclarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                parserDeclarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                parserDeclarationRow]
        if sourceId < 0 || sourceId >= sourceCount ||
           tables.parserSidecars.declarationProducerSourceIds[
               parserDeclarationRow] != sourceId ||
           typeId < 0 || typeId >= tables.types.typeCids.len ||
           tables.types.typeKinds[typeId] !=
               snapshot_schema.CsgCompilerTypeFunction ||
           tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] !=
               externFunctionId ||
           tables.symbols.ownerSymbolIds[symbolId] !=
               moduleSymbolBySource[sourceId] ||
           tables.externFunctions.typeIds[externFunctionId] !=
               typeId ||
           nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len ||
           nameSpanId < 0 ||
           nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[nameSpanId] != sourceId ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           tables.symbols.nameTokenIds[symbolId] != nameTokenId ||
           tables.symbols.nameSpanIds[symbolId] != nameSpanId ||
           tables.symbols.declarationSpanIds[symbolId] !=
               declarationSpanId ||
           tables.symbols.nameTextIds[symbolId] !=
               tables.tokens.valueTextIds[nameTokenId]:
            err = " compiler snapshot builder: extern declaration authority incomplete"
            return false
        var nameProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, parserDeclarationRow, nameProofCid, err):
            return false
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId,
               tables.texts[
                   tables.sources.modulePathTextIds[sourceId]],
               tables.sources.documentCids[sourceId], "",
               moduleCandidateBySource[sourceId],
               declaration.SemanticSnapshotDeclarationKindFunction,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               tables.texts[tables.symbols.nameTextIds[symbolId]],
               nameProofCid, tables.types.typeCids[typeId],
               layout.FixedBytes32(),
               tables.spans.startBytes[declarationSpanId],
               tables.spans.endBytes[declarationSpanId],
               candidateIndex, err):
            return false
        candidateByOldSymbol[symbolId] = candidateIndex
        externParserDeclarationSeen[parserDeclarationRow] = true
    var committedParameterCount: int32
    var parameterDeclarationSeen: bool[]
    setLen(parameterDeclarationSeen,
        tables.parserSidecars.declarationKinds.len)
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolParameter:
            continue
        let declarationRow =
            declarationRowByOldSymbol[symbolId]
        let ownerSymbolId =
            tables.symbols.ownerSymbolIds[symbolId]
        let sourceId = tables.symbols.sourceIds[symbolId]
        let typeId = tables.symbols.typeIds[symbolId]
        if declarationRow < 0 ||
           declarationRow >=
               tables.parserSidecars.declarationKinds.len ||
           parameterDeclarationSeen[declarationRow] ||
           tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationParameter) ||
           ownerSymbolId < 0 || ownerSymbolId >= symbolCount ||
           tables.symbols.symbolKinds[ownerSymbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction ||
           candidateByOldSymbol[ownerSymbolId] < 0 ||
           tables.parserSidecars.declarationOwnerIds[declarationRow] < 0 ||
           typeId < 0 || typeId >= tables.types.typeCids.len ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] != -1 ||
           tables.symbols.exportedFlags[symbolId]:
            err = " compiler snapshot builder: parameter declaration join missing"
            return false
        let ownerDeclaration =
            tables.parserSidecars.declarationOwnerIds[declarationRow]
        if ownerDeclaration >=
               tables.parserSidecars.declarationKinds.len ||
           tables.parserSidecars.declarationKinds[ownerDeclaration] !=
               Int32(parser.ParserDeclarationFunction) ||
           tables.parserSidecars.declarationNameTokenIds[
               ownerDeclaration] !=
               tables.symbols.nameTokenIds[ownerSymbolId] ||
           tables.parserSidecars.declarationProducerSourceIds[
               declarationRow] != sourceId ||
           tables.symbols.sourceIds[ownerSymbolId] != sourceId:
            err = " compiler snapshot builder: parameter declaration owner drift"
            return false
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        if nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len ||
           nameSpanId < 0 ||
           nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.symbols.nameTokenIds[symbolId] != nameTokenId ||
           tables.symbols.nameSpanIds[symbolId] != nameSpanId ||
           tables.symbols.declarationSpanIds[symbolId] !=
               declarationSpanId ||
           tables.symbols.nameTextIds[symbolId] !=
               tables.tokens.valueTextIds[nameTokenId]:
            err = " compiler snapshot builder: parameter declaration coordinate drift"
            return false
        var nameProofCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err):
            return false
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId,
               tables.texts[
                   tables.sources.modulePathTextIds[sourceId]],
               tables.sources.documentCids[sourceId], "",
               candidateByOldSymbol[ownerSymbolId],
               declaration.SemanticSnapshotDeclarationKindParameter,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               tables.texts[tables.symbols.nameTextIds[symbolId]],
               nameProofCid, tables.types.typeCids[typeId],
               layout.FixedBytes32(),
               tables.spans.startBytes[declarationSpanId],
               tables.spans.endBytes[declarationSpanId],
               candidateIndex, err):
            return false
        candidateByOldSymbol[symbolId] = candidateIndex
        parameterDeclarationSeen[declarationRow] = true
        committedParameterCount = committedParameterCount + 1
    if committedParameterCount != parameterDeclarationCount:
        err = " compiler snapshot builder: parameter declaration authority coverage mismatch"
        return false
    var committedLocalCount: int32
    var localDeclarationSeen: bool[]
    setLen(localDeclarationSeen,
        tables.parserSidecars.declarationKinds.len)
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolLocal:
            continue
        let declarationRow =
            declarationRowByOldSymbol[symbolId]
        let ownerSymbolId =
            tables.symbols.ownerSymbolIds[symbolId]
        let sourceId = tables.symbols.sourceIds[symbolId]
        let typeId = tables.symbols.typeIds[symbolId]
        if declarationRow < 0 ||
           declarationRow >=
               tables.parserSidecars.declarationKinds.len ||
           localDeclarationSeen[declarationRow] ||
           tables.parserSidecars.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationLocal) ||
           ownerSymbolId < 0 || ownerSymbolId >= symbolCount ||
           tables.symbols.symbolKinds[ownerSymbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction ||
           tables.symbols.functionIds[ownerSymbolId] < 0 ||
           candidateByOldSymbol[ownerSymbolId] < 0 ||
           tables.parserSidecars.declarationOwnerIds[
               declarationRow] < 0 ||
           typeId < 0 || typeId >= tables.types.typeCids.len ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] != -1 ||
           tables.symbols.exportedFlags[symbolId]:
            err = " compiler snapshot builder: Local declaration join missing"
            return false
        let ownerDeclaration =
            tables.parserSidecars.declarationOwnerIds[
                declarationRow]
        if ownerDeclaration >=
               tables.parserSidecars.declarationKinds.len ||
           tables.parserSidecars.declarationKinds[ownerDeclaration] !=
               Int32(parser.ParserDeclarationFunction) ||
           tables.parserSidecars.declarationNameTokenIds[
               ownerDeclaration] !=
               tables.symbols.nameTokenIds[ownerSymbolId] ||
           tables.parserSidecars.declarationProducerSourceIds[
               declarationRow] != sourceId ||
           tables.symbols.sourceIds[ownerSymbolId] != sourceId:
            err = " compiler snapshot builder: Local declaration owner drift"
            return false
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        let nameSpanId =
            tables.parserSidecars.declarationNameSpanIds[
                declarationRow]
        let declarationSpanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        let parserScopeId =
            tables.parserSidecars.declarationLexicalScopeIds[
                declarationRow]
        var definitionRow: int32 = -1
        for candidateDefinition in 0..<
                tables.valueDefinitions.groupRows.len:
            if tables.valueDefinitions.producerSourceIndexes[
                   candidateDefinition] !=
                   tables.parserSidecars.producerSourceIndexes[
                       sourceId] ||
               tables.valueDefinitions.declarationSourceLocalRows[
                   candidateDefinition] !=
                   tables.parserSidecars.declarationSourceLocalRows[
                       declarationRow] ||
               tables.valueDefinitions.functionIds[
                   candidateDefinition] !=
                   tables.symbols.functionIds[ownerSymbolId]:
                continue
            if definitionRow >= 0:
                err = " compiler snapshot builder: Local declaration has two value definitions"
                return false
            definitionRow = candidateDefinition
        if nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len ||
           nameSpanId < 0 ||
           nameSpanId >= tables.spans.sourceIds.len ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           parserScopeId < 0 ||
           parserScopeId >=
               tables.parserSidecars.declarationLexicalScopeKinds.len ||
           definitionRow < 0 ||
           tables.valueDefinitions.typeIds[definitionRow] != typeId ||
           tables.symbols.nameTokenIds[symbolId] != nameTokenId ||
           tables.symbols.nameSpanIds[symbolId] != nameSpanId ||
           tables.symbols.declarationSpanIds[symbolId] !=
               declarationSpanId ||
           tables.symbols.nameTextIds[symbolId] !=
               tables.tokens.valueTextIds[nameTokenId]:
            err = " compiler snapshot builder: Local declaration coordinate drift"
            return false
        let patternLocalRow =
            tables.valueDefinitions.patternSourceLocalRows[
                definitionRow]
        var patternRow: int32 = -1
        for candidatePattern in 0..<
                tables.parserSidecars.patternKinds.len:
            if tables.parserSidecars.patternProducerSourceIds[
                   candidatePattern] == sourceId &&
               tables.parserSidecars.patternSourceLocalRows[
                   candidatePattern] == patternLocalRow:
                if patternRow >= 0:
                    err = " compiler snapshot builder: Local pattern coordinate ambiguous"
                    return false
                patternRow = candidatePattern
        if patternRow < 0 ||
           tables.parserSidecars.patternBindingDeclarationIds[
               patternRow] != declarationRow:
            err = " compiler snapshot builder: Local pattern authority missing"
            return false
        var nameProofCid: layout.FixedBytes32
        var lexicalScopeCid: layout.FixedBytes32
        if !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err) ||
           !snapshot_schema.CsgCompilerParserLexicalScopeIdentityCidInto(
               tables, parserScopeId, lexicalScopeCid, err):
            return false
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId,
               tables.texts[
                   tables.sources.modulePathTextIds[sourceId]],
               tables.sources.documentCids[sourceId], "",
               candidateByOldSymbol[ownerSymbolId],
               declaration.SemanticSnapshotDeclarationKindLocal,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               tables.texts[tables.symbols.nameTextIds[symbolId]],
               nameProofCid, tables.types.typeCids[typeId],
               lexicalScopeCid,
               tables.spans.startBytes[declarationSpanId],
               tables.spans.endBytes[declarationSpanId],
               candidateIndex, err):
            return false
        candidateByOldSymbol[symbolId] = candidateIndex
        localDeclarationSeen[declarationRow] = true
        committedLocalCount = committedLocalCount + 1
    if committedLocalCount != localDeclarationCount:
        err = " compiler snapshot builder: Local declaration authority coverage mismatch"
        return false
    var committedGenericCount: int32
    var genericParserSeen: bool[]
    setLen(genericParserSeen, genericParameterCount)
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolGenericParameter:
            continue
        let sourceId = tables.symbols.sourceIds[symbolId]
        let ownerSymbolId =
            tables.symbols.ownerSymbolIds[symbolId]
        let parserRow =
            tables.symbols.genericParameterParserRows[symbolId]
        let typeId = tables.symbols.typeIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount ||
           ownerSymbolId < 0 || ownerSymbolId >= symbolCount ||
           candidateByOldSymbol[ownerSymbolId] < 0 ||
           (tables.symbols.symbolKinds[ownerSymbolId] !=
                snapshot_schema.CsgCompilerSymbolFunction &&
            tables.symbols.symbolKinds[ownerSymbolId] !=
                snapshot_schema.CsgCompilerSymbolType) ||
           parserRow < 0 || parserRow >= genericParameterCount ||
           genericParserSeen[parserRow] ||
           typeId < 0 || typeId >= tables.types.typeCids.len ||
           tables.types.typeKinds[typeId] !=
               snapshot_schema.CsgCompilerTypeGenericParameter ||
           declarationRowByOldSymbol[symbolId] != -1 ||
           tables.parserSidecars.typeGenericSymbolProducerSourceIds[
               parserRow] != sourceId ||
           tables.parserSidecars.typeGenericSymbolNameTokenIds[
               parserRow] != tables.symbols.nameTokenIds[symbolId] ||
           tables.parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds[
               parserRow] != tables.symbols.nameTokenIds[ownerSymbolId] ||
           !compilerSnapshotBuilderCidObserved(
               tables.parserSidecars.typeGenericSymbolIdentityCids[
                   parserRow]):
            err = " compiler snapshot builder: generic declaration authority incomplete"
            return false
        let declarationSpanId =
            tables.parserSidecars.typeGenericSymbolSpanIds[parserRow]
        let nameTokenId =
            tables.parserSidecars.typeGenericSymbolNameTokenIds[
                parserRow]
        if declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           nameTokenId < 0 ||
           nameTokenId >= tables.tokens.valueTextIds.len:
            err = " compiler snapshot builder: generic declaration coordinate missing"
            return false
        let nameTextId = tables.tokens.valueTextIds[nameTokenId]
        if nameTextId < 0 || nameTextId >= tables.texts.len:
            err = " compiler snapshot builder: generic declaration name missing"
            return false
        var candidateIndex: int32
        if !declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, csg.packageId,
               tables.texts[
                   tables.sources.modulePathTextIds[sourceId]],
               tables.sources.documentCids[sourceId], "",
               candidateByOldSymbol[ownerSymbolId],
               declaration.SemanticSnapshotDeclarationKindGenericParameter,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               tables.texts[nameTextId],
               tables.parserSidecars.typeGenericSymbolIdentityCids[
                   parserRow],
               tables.types.typeCids[typeId], layout.FixedBytes32(),
               tables.spans.startBytes[declarationSpanId],
               tables.spans.endBytes[declarationSpanId],
               candidateIndex, err):
            return false
        candidateByOldSymbol[symbolId] = candidateIndex
        genericParserSeen[parserRow] = true
        committedGenericCount = committedGenericCount + 1
    if committedGenericCount != genericParameterCount:
        err = " compiler snapshot builder: generic declaration authority coverage mismatch"
        return false
    var declarationTable: declaration.SemanticSnapshotDeclarationTable
    var mapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    if !declaration.SemanticSnapshotDeclarationTableSealInto(
           store, declarationTable, mapping, err):
        return false
    var newKeyByOld: layout.FixedBytes32[]
    var declIdByOld: int32[]
    var order: int32[]
    setLen(newKeyByOld, symbolCount)
    setLen(declIdByOld, symbolCount)
    setLen(order, symbolCount)
    for oldSymbolId in 0..<symbolCount:
        let candidateIndex = candidateByOldSymbol[oldSymbolId]
        if candidateIndex < 0 ||
           candidateIndex >= mapping.producerCandidateToDeclIds.len:
            err = " compiler snapshot builder: declaration mapping missing"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
        let declId = mapping.producerCandidateToDeclIds[candidateIndex]
        declIdByOld[oldSymbolId] = declId
        newKeyByOld[oldSymbolId] = declarationTable.declKeyCids[declId]
        if tables.symbols.symbolKinds[oldSymbolId] ==
               snapshot_schema.CsgCompilerSymbolType &&
           !layout.FixedBytes32Equal(
               tables.symbols.symbolCids[oldSymbolId],
               newKeyByOld[oldSymbolId]):
            var firstDiff: int32 = -1
            for diffIndex in 0..<layout.FixedBytes32Size:
                if firstDiff < 0 &&
                   tables.symbols.symbolCids[oldSymbolId].data[diffIndex] !=
                       newKeyByOld[oldSymbolId].data[diffIndex]:
                    firstDiff = diffIndex
            err = Fmt" compiler snapshot builder: provisional Type DeclKey drift symbol={oldSymbolId} kind={tables.symbols.symbolKinds[oldSymbolId]} type={tables.symbols.typeIds[oldSymbolId]} arena_type={tables.types.producerTypeArenaIds[oldSymbolId]} observed={compilerSnapshotBuilderCidObserved(tables.symbols.symbolCids[oldSymbolId]) ? 1 : 0} first_diff={firstDiff} name_token={tables.symbols.nameTokenIds[oldSymbolId]} decl_name_token={tables.parserSidecars.declarationNameTokenIds[declarationRowByOldSymbol[oldSymbolId]]}"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
        order[oldSymbolId] = oldSymbolId
    for row in 1..<order.len:
        let oldSymbolId = order[row]
        var cursor = row
        while cursor > 0 && compilerSnapshotBuilderCidLess(
               newKeyByOld[oldSymbolId], newKeyByOld[order[cursor - 1]]):
            order[cursor] = order[cursor - 1]
            cursor = cursor - 1
        order[cursor] = oldSymbolId
    for row in 1..<order.len:
        if layout.FixedBytes32Equal(
               newKeyByOld[order[row - 1]], newKeyByOld[order[row]]):
            err = " compiler snapshot builder: duplicate canonical Symbol declaration"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    var newByOld: int32[]
    setLen(newByOld, symbolCount)
    for newSymbolId in 0..<order.len:
        newByOld[order[newSymbolId]] = newSymbolId
    for symbolId in 0..<symbolCount:
        let ownerSymbolId = tables.symbols.ownerSymbolIds[symbolId]
        let constraintStart =
            tables.symbols.genericConstraintStarts[symbolId]
        let constraintCount =
            tables.symbols.genericConstraintCounts[symbolId]
        if ownerSymbolId < -1 || ownerSymbolId >= symbolCount ||
           constraintStart < 0 || constraintCount < 0 ||
           constraintStart >
               tables.symbols.genericConstraintTypeIds.len ||
           constraintCount >
               tables.symbols.genericConstraintTypeIds.len -
                   constraintStart:
            err = " compiler snapshot builder: symbol remap input invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    for functionId in 0..<tables.functions.symbolIds.len:
        if tables.functions.symbolIds[functionId] < 0 ||
           tables.functions.symbolIds[functionId] >= symbolCount:
            err = " compiler snapshot builder: function SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    for externFunctionId in 0..<tables.externFunctions.symbolIds.len:
        if tables.externFunctions.symbolIds[externFunctionId] < 0 ||
           tables.externFunctions.symbolIds[externFunctionId] >=
               symbolCount:
            err = " compiler snapshot builder: extern SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    if tables.references.targetSymbolIds.len !=
           tables.references.ownerSymbolIds.len:
        err = " compiler snapshot builder: reference SymbolId remap shape invalid"
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            declarationTable)
        return false
    for row in 0..<tables.references.targetSymbolIds.len:
        if tables.references.targetSymbolIds[row] < 0 ||
           tables.references.targetSymbolIds[row] >= symbolCount ||
           tables.references.ownerSymbolIds[row] < 0 ||
           tables.references.ownerSymbolIds[row] >= symbolCount:
            err = " compiler snapshot builder: reference target/owner SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    if tables.lexicalScopes.visibleStarts.len !=
           tables.lexicalScopes.visibleCounts.len:
        err = " compiler snapshot builder: visible SymbolId range shape invalid"
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            declarationTable)
        return false
    for row in 0..<tables.lexicalScopes.visibleSymbolIds.len:
        if tables.lexicalScopes.visibleSymbolIds[row] < 0 ||
           tables.lexicalScopes.visibleSymbolIds[row] >= symbolCount:
            err = " compiler snapshot builder: visible SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    for row in 0..<tables.calls.calleeSymbolIds.len:
        if tables.calls.calleeSymbolIds[row] < 0 ||
           tables.calls.calleeSymbolIds[row] >= symbolCount:
            err = " compiler snapshot builder: call SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    for row in 0..<tables.layoutFields.fieldSymbolIds.len:
        if tables.layoutFields.fieldSymbolIds[row] < 0 ||
           tables.layoutFields.fieldSymbolIds[row] >= symbolCount:
            err = " compiler snapshot builder: layout SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    for row in 0..<tables.debugOps.symbolIds.len:
        if tables.debugOps.symbolIds[row] < -1 ||
           tables.debugOps.symbolIds[row] >= symbolCount:
            err = " compiler snapshot builder: debug SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    for row in 0..<tables.types.declSymbolIds.len:
        if tables.types.declSymbolIds[row] < -1 ||
           tables.types.declSymbolIds[row] >= symbolCount:
            err = " compiler snapshot builder: type SymbolId remap invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
    if !unsealedProductionBase:
        for row in 0..<oldSymbolIdsByCid.len:
            let oldSymbolId = oldSymbolIdsByCid[row]
            if oldSymbolId < 0 ||
               oldSymbolId >=
                   functionCount + externFunctionCount + sourceCount ||
               (row > 0 &&
                !compilerSnapshotBuilderCidLess(
                    tables.symbols.symbolCids[
                        oldSymbolIdsByCid[row - 1]],
                    tables.symbols.symbolCids[oldSymbolId])):
                err = " compiler snapshot builder: old SymbolCid index drift"
                declaration.SemanticSnapshotDeclarationTableReleaseInto(
                    declarationTable)
                return false
    for readRow in 0..<tables.readSet.targetDomainKinds.len:
        if tables.readSet.targetDomainKinds[readRow] ==
               snapshot_schema.CsgCompilerReadDomainSymbolInterface:
            if unsealedProductionBase:
                err = " compiler snapshot builder: unsealed production base carried Symbol read"
                declaration.SemanticSnapshotDeclarationTableReleaseInto(
                    declarationTable)
                return false
            let oldSymbolId =
                compilerSnapshotBuilderOldSymbolCidIndexFind(
                tables.symbols.symbolCids,
                oldSymbolIdsByCid,
                tables.readSet.targetPortableKeyCids[readRow])
            if oldSymbolId < 0:
                err = " compiler snapshot builder: symbol read target lacks declaration"
                declaration.SemanticSnapshotDeclarationTableReleaseInto(
                    declarationTable)
                return false
            tables.readSet.targetPortableKeyCids[readRow] =
                newKeyByOld[oldSymbolId]
    var canonical: snapshot_schema.CsgCompilerSymbolTable
    for newSymbolId in 0..<order.len:
        let oldSymbolId = order[newSymbolId]
        add(canonical.symbolCids, newKeyByOld[oldSymbolId])
        add(canonical.interfaceCids, layout.FixedBytes32())
        add(canonical.declIds, declIdByOld[oldSymbolId])
        add(canonical.declKeyCids, newKeyByOld[oldSymbolId])
        add(canonical.declarationHeaderCids,
            tables.symbols.declarationHeaderCids[oldSymbolId])
        add(canonical.declarationPathCids,
            tables.symbols.declarationPathCids[oldSymbolId])
        add(canonical.sourceIds, tables.symbols.sourceIds[oldSymbolId])
        add(canonical.nameTextIds, tables.symbols.nameTextIds[oldSymbolId])
        add(canonical.nameSpanIds, tables.symbols.nameSpanIds[oldSymbolId])
        add(canonical.nameTokenIds, tables.symbols.nameTokenIds[oldSymbolId])
        add(canonical.qualifiedNameTextIds,
            tables.symbols.qualifiedNameTextIds[oldSymbolId])
        add(canonical.symbolKinds, tables.symbols.symbolKinds[oldSymbolId])
        add(canonical.typeIds, tables.symbols.typeIds[oldSymbolId])
        add(canonical.declarationSpanIds,
            tables.symbols.declarationSpanIds[oldSymbolId])
        add(canonical.ownerSymbolIds,
            compilerSnapshotBuilderSymbolIdRemapOptional(
                tables.symbols.ownerSymbolIds[oldSymbolId], newByOld))
        add(canonical.functionIds,
            tables.symbols.functionIds[oldSymbolId])
        add(canonical.externFunctionIds,
            tables.symbols.externFunctionIds[oldSymbolId])
        add(canonical.exportedFlags,
            tables.symbols.exportedFlags[oldSymbolId])
        let constraintStart =
            tables.symbols.genericConstraintStarts[oldSymbolId]
        let constraintCount =
            tables.symbols.genericConstraintCounts[oldSymbolId]
        add(canonical.genericConstraintStarts,
            canonical.genericConstraintTypeIds.len)
        add(canonical.genericConstraintCounts, constraintCount)
        add(canonical.genericParameterParserRows,
            tables.symbols.genericParameterParserRows[oldSymbolId])
        add(canonical.genericParameterOrdinals,
            tables.symbols.genericParameterOrdinals[oldSymbolId])
        add(canonical.genericParameterDefaultTypeIds,
            tables.symbols.genericParameterDefaultTypeIds[oldSymbolId])
        for offset in 0..<constraintCount:
            add(canonical.genericConstraintTypeIds,
                tables.symbols.genericConstraintTypeIds[
                    constraintStart + offset])
    for functionId in 0..<tables.functions.symbolIds.len:
        tables.functions.symbolIds[functionId] =
            newByOld[tables.functions.symbolIds[functionId]]
    for externFunctionId in 0..<tables.externFunctions.symbolIds.len:
        tables.externFunctions.symbolIds[externFunctionId] =
            newByOld[
                tables.externFunctions.symbolIds[externFunctionId]]
    var externOrder: int32[]
    setLen(externOrder, tables.externFunctions.symbolIds.len)
    for row in 0..<externOrder.len:
        externOrder[row] = row
    for row in 1..<externOrder.len:
        let externFunctionId = externOrder[row]
        var cursor = row
        while cursor > 0 &&
              tables.externFunctions.symbolIds[externFunctionId] <
                  tables.externFunctions.symbolIds[
                      externOrder[cursor - 1]]:
            externOrder[cursor] = externOrder[cursor - 1]
            cursor = cursor - 1
        externOrder[cursor] = externFunctionId
    var canonicalExternFunctions: snapshot_schema.CsgCompilerExternFunctionTable
    for newExternFunctionId in 0..<externOrder.len:
        let oldExternFunctionId =
            externOrder[newExternFunctionId]
        let symbolId =
            tables.externFunctions.symbolIds[oldExternFunctionId]
        add(canonicalExternFunctions.symbolIds, symbolId)
        add(canonicalExternFunctions.parserDeclarationRows,
            tables.externFunctions.parserDeclarationRows[
                oldExternFunctionId])
        add(canonicalExternFunctions.typeIds,
            tables.externFunctions.typeIds[oldExternFunctionId])
        add(canonicalExternFunctions.externalNameTextIds,
            tables.externFunctions.externalNameTextIds[
                oldExternFunctionId])
        add(canonicalExternFunctions.abiKinds,
            tables.externFunctions.abiKinds[oldExternFunctionId])
        add(canonicalExternFunctions.importAnnotationRows,
            tables.externFunctions.importAnnotationRows[
                oldExternFunctionId])
        add(canonicalExternFunctions.interfaceCids,
            tables.externFunctions.interfaceCids[
                oldExternFunctionId])
        canonical.externFunctionIds[symbolId] =
            newExternFunctionId
    tables.externFunctions = canonicalExternFunctions
    for row in 0..<tables.references.targetSymbolIds.len:
        tables.references.targetSymbolIds[row] =
            newByOld[tables.references.targetSymbolIds[row]]
        tables.references.ownerSymbolIds[row] =
            newByOld[tables.references.ownerSymbolIds[row]]
    for row in 0..<tables.lexicalScopes.visibleSymbolIds.len:
        tables.lexicalScopes.visibleSymbolIds[row] =
            newByOld[tables.lexicalScopes.visibleSymbolIds[row]]
    for scopeId in 0..<tables.lexicalScopes.visibleStarts.len:
        let visibleStart = tables.lexicalScopes.visibleStarts[scopeId]
        let visibleCount = tables.lexicalScopes.visibleCounts[scopeId]
        if visibleStart < 0 || visibleCount < 0 ||
           visibleStart > tables.lexicalScopes.visibleSymbolIds.len ||
           visibleCount >
               tables.lexicalScopes.visibleSymbolIds.len - visibleStart:
            err = " compiler snapshot builder: visible SymbolId range invalid"
            declaration.SemanticSnapshotDeclarationTableReleaseInto(
                declarationTable)
            return false
        for offset in 1..<visibleCount:
            let value = tables.lexicalScopes.visibleSymbolIds[
                visibleStart + offset]
            var cursor = offset
            while cursor > 0 && value <
                   tables.lexicalScopes.visibleSymbolIds[
                       visibleStart + cursor - 1]:
                tables.lexicalScopes.visibleSymbolIds[
                    visibleStart + cursor] =
                    tables.lexicalScopes.visibleSymbolIds[
                        visibleStart + cursor - 1]
                cursor = cursor - 1
            tables.lexicalScopes.visibleSymbolIds[
                visibleStart + cursor] = value
        for offset in 1..<visibleCount:
            if tables.lexicalScopes.visibleSymbolIds[
                   visibleStart + offset - 1] ==
               tables.lexicalScopes.visibleSymbolIds[
                   visibleStart + offset]:
                err = " compiler snapshot builder: duplicate visible SymbolId"
                declaration.SemanticSnapshotDeclarationTableReleaseInto(
                    declarationTable)
                return false
    for row in 0..<tables.calls.calleeSymbolIds.len:
        tables.calls.calleeSymbolIds[row] =
            newByOld[tables.calls.calleeSymbolIds[row]]
    for row in 0..<tables.layoutFields.fieldSymbolIds.len:
        tables.layoutFields.fieldSymbolIds[row] =
            newByOld[tables.layoutFields.fieldSymbolIds[row]]
    for row in 0..<tables.debugOps.symbolIds.len:
        tables.debugOps.symbolIds[row] =
            compilerSnapshotBuilderSymbolIdRemapOptional(
                tables.debugOps.symbolIds[row], newByOld)
    for row in 0..<tables.types.declSymbolIds.len:
        tables.types.declSymbolIds[row] =
            compilerSnapshotBuilderSymbolIdRemapOptional(
                tables.types.declSymbolIds[row], newByOld)
    tables.symbols = canonical
    tables.declarations = declarationTable
    compilerSnapshotBuilderReadRowsCanonicalizeInto(tables)
    if !compilerSnapshotBuilderReferenceRowsStrictValidateInto(
           tables, err):
        return false
    return true

fn compilerSnapshotBuilderAnnotationTargetsProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    let annotationCount =
        tables.parserSidecars.annotationProducerSourceIds.len
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    let spanCount = tables.spans.sourceIds.len
    let tokenCount = tables.tokens.sourceIds.len
    if tables.annotationTargets.sourceIds.len != 0 ||
       tables.annotationTargets.parserAnnotationRows.len != 0 ||
       tables.annotationTargets.targetTokenIds.len != 0 ||
       tables.annotationTargets.targetParserDeclarationRows.len != 0 ||
       tables.annotationTargets.targetSymbolIds.len != 0 ||
       tables.annotationTargets.targetDeclIds.len != 0 ||
       tables.annotationTargets.targetDeclKeyCids.len != 0:
        err = " compiler snapshot builder: annotation target destination is not empty"
        return false
    var startGroupBySpan: int32[]
    setLen(startGroupBySpan, spanCount)
    var startGroupCount: int32
    var previousSource: int32 = -1
    var previousStart: int32 = -1
    for spanId in 0..<spanCount:
        let sourceId = tables.spans.sourceIds[spanId]
        let startByte = tables.spans.startBytes[spanId]
        if sourceId < previousSource ||
           (sourceId == previousSource &&
            startByte < previousStart):
            err = " compiler snapshot builder: annotation span order drift"
            return false
        if spanId == 0 || sourceId != previousSource ||
           startByte != previousStart:
            startGroupCount = startGroupCount + 1
        startGroupBySpan[spanId] = startGroupCount - 1
        previousSource = sourceId
        previousStart = startByte
    var declarationByStartGroup: int32[]
    var declarationByNameToken: int32[]
    var symbolByParserDeclaration: int32[]
    setLen(declarationByStartGroup, startGroupCount)
    setLen(declarationByNameToken, tokenCount)
    setLen(symbolByParserDeclaration, declarationCount)
    for row in 0..<declarationByStartGroup.len:
        declarationByStartGroup[row] = -1
    for row in 0..<declarationByNameToken.len:
        declarationByNameToken[row] = -1
    for row in 0..<symbolByParserDeclaration.len:
        symbolByParserDeclaration[row] = -1
    for declarationRow in 0..<declarationCount:
        let spanId =
            tables.parserSidecars.declarationSpanIds[
                declarationRow]
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        if spanId < 0 || spanId >= spanCount:
            err = " compiler snapshot builder: annotation declaration span missing"
            return false
        let startGroup = startGroupBySpan[spanId]
        if declarationByStartGroup[startGroup] == -1:
            declarationByStartGroup[startGroup] = declarationRow
        else:
            declarationByStartGroup[startGroup] = -2
        if nameTokenId >= 0:
            if nameTokenId >= tokenCount ||
               declarationByNameToken[nameTokenId] >= 0:
                err = " compiler snapshot builder: annotation declaration token identity ambiguous"
                return false
            declarationByNameToken[nameTokenId] = declarationRow
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let nameTokenId = tables.symbols.nameTokenIds[symbolId]
        if nameTokenId < 0:
            continue
        if nameTokenId >= declarationByNameToken.len:
            err = " compiler snapshot builder: annotation Symbol token out of range"
            return false
        let declarationRow =
            declarationByNameToken[nameTokenId]
        if declarationRow < 0:
            if tables.symbols.symbolKinds[symbolId] ==
                   snapshot_schema.CsgCompilerSymbolGenericParameter:
                continue
            err = " compiler snapshot builder: canonical Symbol lacks parser declaration"
            return false
        if symbolByParserDeclaration[declarationRow] >= 0 ||
           tables.symbols.sourceIds[symbolId] !=
               tables.parserSidecars.declarationProducerSourceIds[
                   declarationRow] ||
           tables.symbols.nameSpanIds[symbolId] !=
               tables.parserSidecars.declarationNameSpanIds[
                   declarationRow] ||
           tables.symbols.declarationSpanIds[symbolId] !=
               tables.parserSidecars.declarationSpanIds[
                   declarationRow]:
            err = " compiler snapshot builder: annotation declaration/Symbol relation drift"
            return false
        symbolByParserDeclaration[declarationRow] = symbolId
    for parserAnnotationRow in 0..<annotationCount:
        let sourceId =
            tables.parserSidecars.annotationProducerSourceIds[
                parserAnnotationRow]
        let targetTokenId =
            tables.parserSidecars.annotationTargetTokenIds[
                parserAnnotationRow]
        if targetTokenId < 0 || targetTokenId >= tokenCount ||
           tables.tokens.sourceIds[targetTokenId] != sourceId:
            err = " compiler snapshot builder: annotation target anchor invalid"
            return false
        let anchorSpanId = tables.tokens.spanIds[targetTokenId]
        if anchorSpanId < 0 || anchorSpanId >= spanCount:
            err = " compiler snapshot builder: annotation target anchor span missing"
            return false
        let targetParserDeclaration =
            declarationByStartGroup[
                startGroupBySpan[anchorSpanId]]
        if targetParserDeclaration < 0 ||
           targetParserDeclaration >= declarationCount ||
           tables.parserSidecars.declarationProducerSourceIds[
               targetParserDeclaration] != sourceId:
            err = " compiler snapshot builder: annotation target declaration is missing or ambiguous"
            return false
        let targetSymbolId =
            symbolByParserDeclaration[targetParserDeclaration]
        if targetSymbolId < 0 ||
           targetSymbolId >= tables.symbols.symbolCids.len:
            err = " compiler snapshot builder: annotation target Symbol missing"
            return false
        let targetDeclId =
            tables.symbols.declIds[targetSymbolId]
        if targetDeclId < 0 ||
           targetDeclId >= tables.declarations.declIds.len:
            err = " compiler snapshot builder: annotation target DeclId missing"
            return false
        add(tables.annotationTargets.sourceIds, sourceId)
        add(tables.annotationTargets.parserAnnotationRows,
            parserAnnotationRow)
        add(tables.annotationTargets.targetTokenIds, targetTokenId)
        add(tables.annotationTargets.targetParserDeclarationRows,
            targetParserDeclaration)
        add(tables.annotationTargets.targetSymbolIds, targetSymbolId)
        add(tables.annotationTargets.targetDeclIds, targetDeclId)
        add(tables.annotationTargets.targetDeclKeyCids,
            tables.declarations.declKeyCids[targetDeclId])
    err = ""
    return true

fn compilerSnapshotBuilderTypedScopeParserSpanFind(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        startLineNumber: int32,
        startColumnNumber: int32,
        endLineNumber: int32,
        endColumnNumber: int32): int32 =
    if sourceId < 0 ||
       sourceId >= tables.sources.documentCids.len ||
       startLineNumber <= 0 || startColumnNumber <= 0 ||
       endLineNumber < startLineNumber ||
       endColumnNumber <= 0:
        return -1
    var found: int32 = -1
    for spanId in 0..<tables.spans.sourceIds.len:
        if tables.spans.sourceIds[spanId] != sourceId ||
           tables.spans.startLines[spanId] !=
               startLineNumber - 1 ||
           tables.spans.startColumns[spanId] !=
               startColumnNumber - 1 ||
           tables.spans.endLines[spanId] !=
               endLineNumber - 1 ||
           tables.spans.endColumns[spanId] !=
               endColumnNumber:
            continue
        if found >= 0:
            return -1
        found = spanId
    return found

# Projects the parser-owned declaration scope forest and the exact TypedExpr
# function-local scope forest into one canonical table. Parser scope spans are
# receipt-owned byte spans; TypedExpr positions may only select one of those
# already committed parser spans. No text, line or inferred source extent is
# retained as scope identity.
fn compilerSnapshotBuilderProductionTypedLexicalScopesProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        canonicalSourceTexts: var str[],
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let functionCount = tables.functions.symbolIds.len
    if sourceCount <= 0 ||
       canonicalSourceTexts.len != sourceCount ||
       tables.lexicalScopes.sourceIds.len != 0 ||
       tables.lexicalScopes.spanIds.len != 0 ||
       tables.lexicalScopes.parentScopeIds.len != 0 ||
       tables.lexicalScopes.producerKinds.len != 0 ||
       tables.lexicalScopes.producerIds.len != 0 ||
       tables.lexicalScopes.parserBridgeScopeIds.len != 0 ||
       tables.lexicalScopes.ownerDeclIds.len != 0 ||
       tables.lexicalScopes.ownerFunctionIds.len != 0 ||
       tables.lexicalScopes.visibleStarts.len != 0 ||
       tables.lexicalScopes.visibleCounts.len != 0 ||
       tables.lexicalScopes.visibleSymbolIds.len != 0 ||
       !texpr.TypedExprIrFunctions2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrScopes2ShapeComplete(csg.typedIr):
        err = " compiler snapshot builder: lexical scope projection destination invalid"
        return false
    var candidateSources: int32[]
    var candidateSpans: int32[]
    var candidateParents: int32[]
    var candidateDepths: int32[]
    var candidateProducerKinds: int32[]
    var candidateProducerIds: int32[]
    var candidateOwnerParserDeclarations: int32[]
    var candidateOwnerFunctionIds: int32[]
    var candidateVisibilityParserScopes: int32[]
    var projectedProducerKinds: int32[]
    var projectedProducerIds: int32[]
    var projectedParserBridgeScopeIds: int32[]
    var projectedOwnerDeclIds: int32[]
    var projectedOwnerFunctionIds: int32[]
    var candidateByParserScope: int32[]
    var sourceRootParserScopes: int32[]
    var parserSourceRootCounts: int32[]
    let parserScopeCount =
        tables.parserSidecars.declarationLexicalScopeKinds.len
    let parserDeclarationCount =
        tables.parserSidecars.declarationKinds.len
    setLen(candidateByParserScope, parserScopeCount)
    setLen(sourceRootParserScopes, sourceCount)
    setLen(parserSourceRootCounts, sourceCount)
    for sourceId in 0..<sourceCount:
        sourceRootParserScopes[sourceId] = -1
    for parserScopeId in 0..<parserScopeCount:
        let sourceId =
            tables.parserSidecars.declarationLexicalScopeProducerSourceIds[
                parserScopeId]
        let spanId =
            tables.parserSidecars.declarationLexicalScopeSpanIds[
                parserScopeId]
        let parentParserScope =
            tables.parserSidecars.declarationLexicalScopeParentIds[
                parserScopeId]
        if sourceId < 0 || sourceId >= sourceCount ||
           spanId < 0 || spanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[spanId] != sourceId ||
           parentParserScope < -1 ||
           parentParserScope >= parserScopeId:
            err = " compiler snapshot builder: parser lexical scope source invalid"
            return false
        let candidateId = candidateSources.len
        candidateByParserScope[parserScopeId] = candidateId
        add(candidateSources, sourceId)
        add(candidateSpans, spanId)
        add(candidateParents,
            parentParserScope < 0 ? -1 :
                candidateByParserScope[parentParserScope])
        add(candidateDepths,
            parentParserScope < 0 ? 0 :
                candidateDepths[
                    candidateByParserScope[parentParserScope]] + 1)
        add(candidateProducerKinds,
            snapshot_schema.CsgCompilerLexicalScopeProducerParser)
        add(candidateProducerIds, parserScopeId)
        add(candidateOwnerParserDeclarations,
            tables.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[
                parserScopeId])
        add(candidateOwnerFunctionIds, -1)
        add(candidateVisibilityParserScopes, parserScopeId)
        if parentParserScope == -1 &&
           tables.parserSidecars.declarationLexicalScopeKinds[
               parserScopeId] ==
               Int32(parser.ParserDeclarationLexicalScopeSource):
            parserSourceRootCounts[sourceId] =
                parserSourceRootCounts[sourceId] + 1
            sourceRootParserScopes[sourceId] = parserScopeId
    for sourceId in 0..<sourceCount:
        if parserSourceRootCounts[sourceId] != 1 ||
           sourceRootParserScopes[sourceId] < 0 ||
           tables.spans.startBytes[
               tables.parserSidecars.declarationLexicalScopeSpanIds[
                   sourceRootParserScopes[sourceId]]] != 0 ||
           tables.spans.endBytes[
               tables.parserSidecars.declarationLexicalScopeSpanIds[
                   sourceRootParserScopes[sourceId]]] !=
               canonicalSourceTexts[sourceId].len:
            err = " compiler snapshot builder: source lexical root span missing"
            return false
    var parserDeclarationByNameToken: int32[]
    setLen(
        parserDeclarationByNameToken,
        tables.tokens.sourceIds.len)
    for tokenId in 0..<parserDeclarationByNameToken.len:
        parserDeclarationByNameToken[tokenId] = -1
    for declarationRow in 0..<parserDeclarationCount:
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        if nameTokenId < 0 ||
           nameTokenId >= parserDeclarationByNameToken.len ||
           parserDeclarationByNameToken[nameTokenId] >= 0:
            err = " compiler snapshot builder: lexical declaration token identity invalid"
            return false
        parserDeclarationByNameToken[nameTokenId] =
            declarationRow
    var functionParserScopeByDeclaration: int32[]
    var ownedParserScopeByDeclaration: int32[]
    setLen(
        functionParserScopeByDeclaration,
        parserDeclarationCount)
    setLen(
        ownedParserScopeByDeclaration,
        parserDeclarationCount)
    for declarationRow in 0..<parserDeclarationCount:
        functionParserScopeByDeclaration[declarationRow] = -1
        ownedParserScopeByDeclaration[declarationRow] = -1
    for parserScopeId in 0..<parserScopeCount:
        let ownerDeclaration =
            tables.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[
                parserScopeId]
        let scopeKind =
            tables.parserSidecars.declarationLexicalScopeKinds[
                parserScopeId]
        if scopeKind !=
               Int32(parser.ParserDeclarationLexicalScopeFunction) &&
           scopeKind !=
               Int32(parser.ParserDeclarationLexicalScopeType):
            continue
        if ownerDeclaration < 0 ||
           ownerDeclaration >= parserDeclarationCount ||
           ownedParserScopeByDeclaration[ownerDeclaration] >= 0:
            err = " compiler snapshot builder: declaration-owned parser scope identity invalid"
            return false
        ownedParserScopeByDeclaration[ownerDeclaration] = parserScopeId
        if scopeKind ==
               Int32(parser.ParserDeclarationLexicalScopeFunction):
            if tables.parserSidecars.declarationKinds[
                   ownerDeclaration] !=
                   Int32(parser.ParserDeclarationFunction):
                err = " compiler snapshot builder: Function parser scope identity invalid"
                return false
            functionParserScopeByDeclaration[ownerDeclaration] =
                parserScopeId
    for functionId in 0..<functionCount:
        let typedFunctionIndex =
            tables.functions.typedFunctionIndexes[functionId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               csg.semanticGraph.typedIrTable.functionSourceIndexes.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_scopeStarts.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_scopeCounts.len:
            err = " compiler snapshot builder: lexical scope FunctionId binding invalid"
            return false
        let producerSourceId =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[
                typedFunctionIndex]
        let sourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, producerSourceId)
        let scopeStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_scopeStarts,
            typedFunctionIndex)
        let scopeCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_scopeCounts,
            typedFunctionIndex)
        let functionSymbolId =
            tables.functions.symbolIds[functionId]
        let functionNameTokenId =
            functionSymbolId < 0 ||
            functionSymbolId >= tables.symbols.nameTokenIds.len ?
                -1 :
                tables.symbols.nameTokenIds[functionSymbolId]
        let functionParserDeclaration =
            functionNameTokenId < 0 ||
            functionNameTokenId >=
                parserDeclarationByNameToken.len ?
                -1 :
                parserDeclarationByNameToken[
                    functionNameTokenId]
        let functionParserScope =
            functionParserDeclaration < 0 ||
            functionParserDeclaration >=
                functionParserScopeByDeclaration.len ?
                -1 :
                functionParserScopeByDeclaration[
                    functionParserDeclaration]
        if sourceId < 0 || sourceId >= sourceCount ||
           scopeStart < 0 || scopeCount <= 0 ||
           scopeStart > csg.typedIr.scopes2_scopeIds.len ||
           scopeCount >
               csg.typedIr.scopes2_scopeIds.len - scopeStart ||
           functionSymbolId < 0 ||
           functionSymbolId >= tables.symbols.symbolCids.len ||
           tables.symbols.sourceIds[functionSymbolId] != sourceId ||
           functionParserDeclaration < 0 ||
           tables.parserSidecars.declarationKinds[
               functionParserDeclaration] !=
               Int32(parser.ParserDeclarationFunction) ||
           functionParserScope < 0 ||
           tables.parserSidecars.declarationLexicalScopeProducerSourceIds[
               functionParserScope] != sourceId:
            err = " compiler snapshot builder: lexical scope function range invalid"
            return false
        var candidateByLocalScope: int32[]
        setLen(candidateByLocalScope, scopeCount)
        for localScopeId in 0..<scopeCount:
            let scopeRow = scopeStart + localScopeId
            let producerLocalScopeId =
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_scopeIds,
                    scopeRow)
            let parentLocalScopeId =
                arenamod.ArenaArrayInt32Get(
                    csg.typedIr.arena,
                    csg.typedIr.scopes2_parentScopeIds,
                    scopeRow)
            let startLine = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.scopes2_startLineNumbers,
                scopeRow)
            let startColumn = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.scopes2_startColumnNumbers,
                scopeRow)
            let endLine = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.scopes2_endLineNumbers,
                scopeRow)
            let endColumn = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.scopes2_endColumnNumbers,
                scopeRow)
            if producerLocalScopeId != localScopeId ||
               parentLocalScopeId < -1 ||
               parentLocalScopeId >= localScopeId ||
               (localScopeId == 0 && parentLocalScopeId != -1) ||
               (localScopeId > 0 && parentLocalScopeId < 0):
                err = " compiler snapshot builder: lexical scope producer row invalid"
                return false
            let spanId =
                compilerSnapshotBuilderTypedScopeParserSpanFind(
                    tables,
                    sourceId,
                    startLine,
                    startColumn,
                    endLine,
                    endColumn)
            if spanId < 0:
                err = " compiler snapshot builder: lexical scope lacks parser-owned byte span"
                return false
            let startByte = tables.spans.startBytes[spanId]
            let endByte = tables.spans.endBytes[spanId]
            var parserBridgeScope = functionParserScope
            var parserBridgeDepth =
                candidateDepths[
                    candidateByParserScope[
                        functionParserScope]]
            for parserScopeId in 0..<parserScopeCount:
                if tables.parserSidecars.declarationLexicalScopeProducerSourceIds[
                       parserScopeId] != sourceId:
                    continue
                let parserSpanId =
                    tables.parserSidecars.declarationLexicalScopeSpanIds[
                        parserScopeId]
                if tables.spans.startBytes[parserSpanId] >
                       startByte ||
                   tables.spans.endBytes[parserSpanId] <
                       endByte:
                    continue
                var ancestorCursor = parserScopeId
                var insideFunctionScope = false
                while ancestorCursor >= 0 &&
                      !insideFunctionScope:
                    if ancestorCursor == functionParserScope:
                        insideFunctionScope = true
                    else:
                        ancestorCursor =
                            tables.parserSidecars.declarationLexicalScopeParentIds[
                                ancestorCursor]
                if !insideFunctionScope:
                    continue
                let parserDepth =
                    candidateDepths[
                        candidateByParserScope[
                            parserScopeId]]
                if parserDepth > parserBridgeDepth:
                    parserBridgeScope = parserScopeId
                    parserBridgeDepth = parserDepth
                elif parserDepth == parserBridgeDepth &&
                     parserScopeId != parserBridgeScope:
                    err = " compiler snapshot builder: TypedExpr parser scope bridge ambiguous"
                    return false
            let candidateId = candidateSources.len
            candidateByLocalScope[localScopeId] = candidateId
            add(candidateSources, sourceId)
            add(candidateSpans, spanId)
            add(candidateParents,
                parentLocalScopeId < 0 ?
                    candidateByParserScope[
                        functionParserScope] :
                    candidateByLocalScope[parentLocalScopeId])
            add(candidateDepths,
                parentLocalScopeId < 0 ?
                    candidateDepths[
                        candidateByParserScope[
                            functionParserScope]] + 1 :
                    candidateDepths[
                        candidateByLocalScope[parentLocalScopeId]] + 1)
            add(candidateProducerKinds,
                snapshot_schema.CsgCompilerLexicalScopeProducerTypedExpr)
            add(candidateProducerIds, scopeRow)
            add(candidateOwnerParserDeclarations,
                functionParserDeclaration)
            add(candidateOwnerFunctionIds, functionId)
            add(candidateVisibilityParserScopes,
                parserBridgeScope)
    var symbolByParserDeclaration: int32[]
    setLen(symbolByParserDeclaration, parserDeclarationCount)
    for declarationRow in 0..<parserDeclarationCount:
        symbolByParserDeclaration[declarationRow] = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let nameTokenId =
            tables.symbols.nameTokenIds[symbolId]
        let parserDeclaration =
            nameTokenId < 0 ||
            nameTokenId >= parserDeclarationByNameToken.len ?
                -1 :
                parserDeclarationByNameToken[nameTokenId]
        if parserDeclaration < 0:
            if tables.symbols.symbolKinds[symbolId] ==
                   snapshot_schema.CsgCompilerSymbolGenericParameter:
                continue
            if tables.symbols.symbolKinds[symbolId] ==
                   snapshot_schema.CsgCompilerSymbolModule &&
               tables.symbols.nameTokenIds[symbolId] == -1 &&
               tables.symbols.nameSpanIds[symbolId] == -1 &&
               tables.symbols.declarationSpanIds[symbolId] == -1 &&
               tables.symbols.ownerSymbolIds[symbolId] == -1:
                continue
            err = " compiler snapshot builder: lexical Symbol lacks parser declaration"
            return false
        if symbolByParserDeclaration[parserDeclaration] >= 0 ||
           tables.symbols.sourceIds[symbolId] !=
               tables.parserSidecars.declarationProducerSourceIds[
                   parserDeclaration] ||
           tables.symbols.nameSpanIds[symbolId] !=
               tables.parserSidecars.declarationNameSpanIds[
                   parserDeclaration] ||
           tables.symbols.declarationSpanIds[symbolId] !=
               tables.parserSidecars.declarationSpanIds[
                   parserDeclaration]:
            err = " compiler snapshot builder: lexical declaration/Symbol identity drift"
            return false
        symbolByParserDeclaration[parserDeclaration] = symbolId
    var order: int32[]
    setLen(order, candidateSources.len)
    for candidateId in 0..<order.len:
        order[candidateId] = candidateId
    for row in 1..<order.len:
        let candidateId = order[row]
        let sourceId = candidateSources[candidateId]
        let spanId = candidateSpans[candidateId]
        let startByte = tables.spans.startBytes[spanId]
        let endByte = tables.spans.endBytes[spanId]
        let depth = candidateDepths[candidateId]
        var cursor = row
        while cursor > 0:
            let previousId = order[cursor - 1]
            let previousSpanId = candidateSpans[previousId]
            let ordered =
                candidateSources[previousId] < sourceId ||
                (candidateSources[previousId] == sourceId &&
                 tables.spans.startBytes[previousSpanId] <
                     startByte) ||
                (candidateSources[previousId] == sourceId &&
                 tables.spans.startBytes[previousSpanId] ==
                     startByte &&
                 tables.spans.endBytes[previousSpanId] >
                     endByte) ||
                (candidateSources[previousId] == sourceId &&
                 tables.spans.startBytes[previousSpanId] ==
                     startByte &&
                 tables.spans.endBytes[previousSpanId] ==
                     endByte &&
                 candidateDepths[previousId] < depth) ||
                (candidateSources[previousId] == sourceId &&
                 tables.spans.startBytes[previousSpanId] ==
                     startByte &&
                 tables.spans.endBytes[previousSpanId] ==
                     endByte &&
                 candidateDepths[previousId] == depth &&
                 previousId < candidateId)
            if ordered:
                break
            order[cursor] = previousId
            cursor = cursor - 1
        order[cursor] = candidateId
    var canonicalByCandidate: int32[]
    setLen(canonicalByCandidate, order.len)
    for scopeId in 0..<order.len:
        canonicalByCandidate[order[scopeId]] = scopeId
    for scopeId in 0..<order.len:
        let candidateId = order[scopeId]
        let parentCandidate = candidateParents[candidateId]
        let parentScopeId =
            parentCandidate < 0 ? -1 :
                canonicalByCandidate[parentCandidate]
        if parentScopeId >= scopeId:
            err = " compiler snapshot builder: lexical scope canonical parent order invalid"
            return false
        add(tables.lexicalScopes.sourceIds,
            candidateSources[candidateId])
        add(tables.lexicalScopes.spanIds,
            candidateSpans[candidateId])
        add(tables.lexicalScopes.parentScopeIds,
            parentScopeId)
        add(projectedProducerKinds,
            candidateProducerKinds[candidateId])
        add(projectedProducerIds,
            candidateProducerIds[candidateId])
        add(projectedParserBridgeScopeIds,
            candidateVisibilityParserScopes[candidateId])
        if projectedProducerKinds.len != scopeId + 1 ||
           projectedProducerIds.len != scopeId + 1 ||
           projectedParserBridgeScopeIds.len !=
               scopeId + 1:
            err = Fmt" compiler snapshot builder: lexical producer append failed scope={scopeId} candidates={candidateSources.len} candidate_kind={candidateProducerKinds.len} candidate_id={candidateProducerIds.len} candidate_bridge={candidateVisibilityParserScopes.len} produced_kind={projectedProducerKinds.len} produced_id={projectedProducerIds.len} produced_bridge={projectedParserBridgeScopeIds.len}"
            return false
        let ownerParserDeclaration =
            candidateOwnerParserDeclarations[candidateId]
        let ownerSymbolId =
            ownerParserDeclaration < 0 ||
            ownerParserDeclaration >=
                symbolByParserDeclaration.len ?
                -1 :
                symbolByParserDeclaration[
                    ownerParserDeclaration]
        var ownerDeclId: int32 = -1
        var ownerFunctionId =
            candidateOwnerFunctionIds[candidateId]
        if ownerParserDeclaration >= 0:
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.declIds.len:
                err = " compiler snapshot builder: lexical owner declaration Symbol missing"
                return false
            ownerDeclId = tables.symbols.declIds[ownerSymbolId]
            let symbolFunctionId =
                tables.symbols.functionIds[ownerSymbolId]
            if ownerFunctionId >= 0 &&
               ownerFunctionId != symbolFunctionId:
                err = " compiler snapshot builder: lexical owner FunctionId split"
                return false
            if ownerFunctionId < 0:
                ownerFunctionId = symbolFunctionId
        elif ownerFunctionId >= 0:
            err = " compiler snapshot builder: lexical FunctionId lacks declaration owner"
            return false
        add(projectedOwnerDeclIds,
            ownerDeclId)
        add(projectedOwnerFunctionIds,
            ownerFunctionId)
        if projectedOwnerDeclIds.len !=
               scopeId + 1 ||
           projectedOwnerFunctionIds.len !=
               scopeId + 1:
            err = Fmt" compiler snapshot builder: lexical owner append failed scope={scopeId} owner_decl={projectedOwnerDeclIds.len} owner_fn={projectedOwnerFunctionIds.len}"
            return false
        add(tables.lexicalScopes.visibleStarts,
            tables.lexicalScopes.visibleSymbolIds.len)
        let sourceId = candidateSources[candidateId]
        let visibilityParserScope =
            candidateVisibilityParserScopes[candidateId]
        if visibilityParserScope < 0 ||
           visibilityParserScope >= parserScopeCount ||
           tables.parserSidecars.declarationLexicalScopeProducerSourceIds[
               visibilityParserScope] != sourceId:
            err = " compiler snapshot builder: lexical visibility scope identity invalid"
            return false
        for symbolId in 0..<tables.symbols.symbolCids.len:
            if tables.symbols.sourceIds[symbolId] != sourceId:
                continue
            let symbolKind = tables.symbols.symbolKinds[symbolId]
            let nameTokenId =
                tables.symbols.nameTokenIds[symbolId]
            let parserDeclaration =
                nameTokenId < 0 ||
                nameTokenId >=
                    parserDeclarationByNameToken.len ?
                    -1 :
                    parserDeclarationByNameToken[nameTokenId]
            var declarationScope: int32 = -1
            if parserDeclaration >= 0:
                declarationScope =
                    tables.parserSidecars.declarationLexicalScopeIds[
                        parserDeclaration]
            elif symbolKind ==
                   snapshot_schema.CsgCompilerSymbolModule &&
                 nameTokenId == -1 &&
                 tables.symbols.nameSpanIds[symbolId] == -1 &&
                 tables.symbols.declarationSpanIds[symbolId] == -1 &&
                 tables.symbols.ownerSymbolIds[symbolId] == -1:
                declarationScope =
                    sourceRootParserScopes[sourceId]
            elif symbolKind ==
                   snapshot_schema.CsgCompilerSymbolGenericParameter:
                let ownerSymbolId =
                    tables.symbols.ownerSymbolIds[symbolId]
                let ownerNameTokenId =
                    ownerSymbolId < 0 ||
                    ownerSymbolId >=
                        tables.symbols.nameTokenIds.len ?
                        -1 :
                        tables.symbols.nameTokenIds[
                            ownerSymbolId]
                let ownerParserDeclaration =
                    ownerNameTokenId < 0 ||
                    ownerNameTokenId >=
                        parserDeclarationByNameToken.len ?
                        -1 :
                        parserDeclarationByNameToken[
                            ownerNameTokenId]
                if ownerParserDeclaration >= 0:
                    declarationScope =
                        ownedParserScopeByDeclaration[
                            ownerParserDeclaration]
            if declarationScope < 0 ||
               declarationScope >= parserScopeCount:
                err = " compiler snapshot builder: visible Symbol lacks exact parser scope"
                return false
            var scopeCursor = visibilityParserScope
            var visible = false
            while scopeCursor >= 0 && !visible:
                if scopeCursor == declarationScope:
                    visible = true
                else:
                    scopeCursor =
                        tables.parserSidecars.declarationLexicalScopeParentIds[
                            scopeCursor]
            if visible:
                add(tables.lexicalScopes.visibleSymbolIds,
                    symbolId)
        add(tables.lexicalScopes.visibleCounts,
            tables.lexicalScopes.visibleSymbolIds.len -
                tables.lexicalScopes.visibleStarts[scopeId])
    tables.lexicalScopes.producerKinds =
        projectedProducerKinds
    tables.lexicalScopes.producerIds =
        projectedProducerIds
    tables.lexicalScopes.parserBridgeScopeIds =
        projectedParserBridgeScopeIds
    tables.lexicalScopes.ownerDeclIds =
        projectedOwnerDeclIds
    tables.lexicalScopes.ownerFunctionIds =
        projectedOwnerFunctionIds
    if tables.lexicalScopes.producerKinds.len != order.len ||
       tables.lexicalScopes.producerIds.len != order.len ||
       tables.lexicalScopes.parserBridgeScopeIds.len != order.len ||
       tables.lexicalScopes.ownerDeclIds.len != order.len ||
       tables.lexicalScopes.ownerFunctionIds.len != order.len:
        err = Fmt" compiler snapshot builder: lexical canonical column move failed scopes={order.len} producer_kind={tables.lexicalScopes.producerKinds.len} producer_id={tables.lexicalScopes.producerIds.len} bridge={tables.lexicalScopes.parserBridgeScopeIds.len} owner_decl={tables.lexicalScopes.ownerDeclIds.len} owner_fn={tables.lexicalScopes.ownerFunctionIds.len}"
        return false
    return snapshot_schema.CsgCompilerSnapshotLexicalScopesStrictValidateInto(
        tables, err)

fn compilerSnapshotBuilderLexicalVisibleSetsStrictValidateInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    let parserScopeCount =
        tables.parserSidecars.declarationLexicalScopeKinds.len
    var declarationByNameToken: int32[]
    setLen(declarationByNameToken, tables.tokens.sourceIds.len)
    for tokenId in 0..<declarationByNameToken.len:
        declarationByNameToken[tokenId] = -1
    for declarationRow in 0..<declarationCount:
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[
                declarationRow]
        if nameTokenId < 0 ||
           nameTokenId >= declarationByNameToken.len ||
           declarationByNameToken[nameTokenId] >= 0:
            err = " compiler snapshot builder: lexical visibility declaration token invalid"
            return false
        declarationByNameToken[nameTokenId] =
            declarationRow
    var ownedScopeByDeclaration: int32[]
    var sourceRootScopeBySource: int32[]
    setLen(ownedScopeByDeclaration, declarationCount)
    setLen(
        sourceRootScopeBySource,
        tables.sources.documentCids.len)
    for declarationRow in 0..<declarationCount:
        ownedScopeByDeclaration[declarationRow] = -1
    for sourceId in 0..<sourceRootScopeBySource.len:
        sourceRootScopeBySource[sourceId] = -1
    for parserScopeId in 0..<parserScopeCount:
        let kind =
            tables.parserSidecars.declarationLexicalScopeKinds[
                parserScopeId]
        if kind ==
               Int32(parser.ParserDeclarationLexicalScopeSource):
            let sourceId =
                tables.parserSidecars.declarationLexicalScopeProducerSourceIds[
                    parserScopeId]
            if sourceId < 0 ||
               sourceId >= sourceRootScopeBySource.len ||
               tables.parserSidecars.declarationLexicalScopeParentIds[
                   parserScopeId] != -1 ||
               tables.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[
                   parserScopeId] != -1 ||
               sourceRootScopeBySource[sourceId] >= 0:
                err = " compiler snapshot builder: lexical visibility source root invalid"
                return false
            sourceRootScopeBySource[sourceId] = parserScopeId
            continue
        if kind !=
               Int32(parser.ParserDeclarationLexicalScopeFunction) &&
           kind !=
               Int32(parser.ParserDeclarationLexicalScopeType):
            continue
        let ownerDeclaration =
            tables.parserSidecars.declarationLexicalScopeOwnerDeclarationIds[
                parserScopeId]
        if ownerDeclaration < 0 ||
           ownerDeclaration >= declarationCount ||
           ownedScopeByDeclaration[ownerDeclaration] >= 0:
            err = " compiler snapshot builder: lexical visibility owned scope invalid"
            return false
        ownedScopeByDeclaration[ownerDeclaration] =
            parserScopeId
    for sourceId in 0..<sourceRootScopeBySource.len:
        if sourceRootScopeBySource[sourceId] < 0:
            err = " compiler snapshot builder: lexical visibility source root missing"
            return false
    for scopeId in 0..<tables.lexicalScopes.sourceIds.len:
        let sourceId = tables.lexicalScopes.sourceIds[scopeId]
        let bridgeScopeId =
            tables.lexicalScopes.parserBridgeScopeIds[scopeId]
        let visibleStart =
            tables.lexicalScopes.visibleStarts[scopeId]
        let visibleCount =
            tables.lexicalScopes.visibleCounts[scopeId]
        var expectedCount: int32
        for symbolId in 0..<tables.symbols.symbolCids.len:
            if tables.symbols.sourceIds[symbolId] != sourceId:
                continue
            let nameTokenId =
                tables.symbols.nameTokenIds[symbolId]
            let parserDeclaration =
                nameTokenId < 0 ||
                nameTokenId >= declarationByNameToken.len ?
                    -1 :
                    declarationByNameToken[nameTokenId]
            var declarationScope: int32 = -1
            if parserDeclaration >= 0:
                declarationScope =
                    tables.parserSidecars.declarationLexicalScopeIds[
                        parserDeclaration]
            elif tables.symbols.symbolKinds[symbolId] ==
                   snapshot_schema.CsgCompilerSymbolModule &&
                 nameTokenId == -1 &&
                 tables.symbols.nameSpanIds[symbolId] == -1 &&
                 tables.symbols.declarationSpanIds[symbolId] == -1 &&
                 tables.symbols.ownerSymbolIds[symbolId] == -1:
                declarationScope =
                    sourceRootScopeBySource[sourceId]
            elif tables.symbols.symbolKinds[symbolId] ==
                   snapshot_schema.CsgCompilerSymbolGenericParameter:
                let ownerSymbolId =
                    tables.symbols.ownerSymbolIds[symbolId]
                let ownerNameTokenId =
                    ownerSymbolId < 0 ||
                    ownerSymbolId >=
                        tables.symbols.nameTokenIds.len ?
                        -1 :
                        tables.symbols.nameTokenIds[
                            ownerSymbolId]
                let ownerDeclaration =
                    ownerNameTokenId < 0 ||
                    ownerNameTokenId >=
                        declarationByNameToken.len ?
                        -1 :
                        declarationByNameToken[
                            ownerNameTokenId]
                if ownerDeclaration >= 0:
                    declarationScope =
                        ownedScopeByDeclaration[
                            ownerDeclaration]
            if declarationScope < 0 ||
               declarationScope >= parserScopeCount:
                err = " compiler snapshot builder: lexical visibility Symbol scope missing"
                return false
            var cursor = bridgeScopeId
            var visible = false
            while cursor >= 0 && !visible:
                if cursor == declarationScope:
                    visible = true
                else:
                    cursor =
                        tables.parserSidecars.declarationLexicalScopeParentIds[
                            cursor]
            if !visible:
                continue
            if expectedCount >= visibleCount ||
               tables.lexicalScopes.visibleSymbolIds[
                   visibleStart + expectedCount] != symbolId:
                err = " compiler snapshot builder: lexical visible Symbol set drift"
                return false
            expectedCount = expectedCount + 1
        if expectedCount != visibleCount:
            err = " compiler snapshot builder: lexical visible Symbol coverage drift"
            return false
    err = ""
    return true

fn compilerSnapshotProductionLexicalProjectionApplyInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        receipt: var CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    var rawRequiredDomainCid: layout.FixedBytes32
    var counts: compilerSnapshotProductionScopeDomainCounts
    if !compilerSnapshotProductionLexicalScopeRequiredDomainStrictValidateInto(
           csg, rawRequiredDomainCid, counts, err):
        return false
    if tables.semanticEpoch != receipt.semanticEpoch:
        err =
            " compiler snapshot builder: lexical required domain epoch drift"
        return false
    let requiredDomainCid =
        compilerSnapshotProductionVersionedRequiredDomainCid(
            rawRequiredDomainCid, receipt.semanticEpoch)
    if !layout.FixedBytes32Equal(
           requiredDomainCid,
           receipt.lexicalScopeRequiredDomainCid):
        err =
            " compiler snapshot builder: lexical required domain CID drift"
        return false
    if !snapshot_schema.CsgCompilerSnapshotLexicalScopesStrictValidateInto(
           tables, err):
        return false
    if !compilerSnapshotBuilderLexicalVisibleSetsStrictValidateInto(
           tables, err):
        return false
    if tables.lexicalScopes.sourceIds.len !=
           counts.parserScopeCount + counts.typedScopeCount:
        err =
            " compiler snapshot builder: lexical scope count drift"
        return false
    var parserProducerCount: int32
    var typedProducerCount: int32
    var typedProducerSeen: bool[]
    setLen(
        typedProducerSeen,
        csg.typedIr.scopes2_scopeIds.len)
    for scopeId in 0..<tables.lexicalScopes.sourceIds.len:
        let producerKind =
            tables.lexicalScopes.producerKinds[scopeId]
        let producerId =
            tables.lexicalScopes.producerIds[scopeId]
        if producerKind ==
               snapshot_schema.CsgCompilerLexicalScopeProducerParser:
            parserProducerCount = parserProducerCount + 1
            continue
        if producerKind !=
               snapshot_schema.CsgCompilerLexicalScopeProducerTypedExpr ||
           producerId < 0 ||
           producerId >= typedProducerSeen.len ||
           typedProducerSeen[producerId]:
            err = " compiler snapshot builder: TypedExpr lexical producer coverage invalid"
            return false
        let ownerFunctionId =
            tables.lexicalScopes.ownerFunctionIds[scopeId]
        if ownerFunctionId < 0 ||
           ownerFunctionId >= tables.functions.symbolIds.len:
            err = " compiler snapshot builder: TypedExpr lexical FunctionId missing"
            return false
        let typedFunctionIndex =
            tables.functions.typedFunctionIndexes[
                ownerFunctionId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               csg.typedIr.functions2_scopeStarts.len:
            err = " compiler snapshot builder: TypedExpr lexical function producer missing"
            return false
        let scopeStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_scopeStarts,
            typedFunctionIndex)
        let scopeCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_scopeCounts,
            typedFunctionIndex)
        if producerId < scopeStart ||
           producerId >= scopeStart + scopeCount:
            err = " compiler snapshot builder: TypedExpr lexical producer/function split"
            return false
        let localScopeId = producerId - scopeStart
        let retainedLocalScopeId =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.scopes2_scopeIds,
                producerId)
        let parentLocalScopeId =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.scopes2_parentScopeIds,
                producerId)
        let parentScopeId =
            tables.lexicalScopes.parentScopeIds[scopeId]
        if retainedLocalScopeId != localScopeId ||
           (parentLocalScopeId < 0 &&
            (parentScopeId < 0 ||
             tables.lexicalScopes.producerKinds[parentScopeId] !=
                 snapshot_schema.CsgCompilerLexicalScopeProducerParser)) ||
           (parentLocalScopeId >= 0 &&
            (parentScopeId < 0 ||
             tables.lexicalScopes.producerKinds[parentScopeId] !=
                 snapshot_schema.CsgCompilerLexicalScopeProducerTypedExpr ||
             tables.lexicalScopes.producerIds[parentScopeId] !=
                 scopeStart + parentLocalScopeId)):
            err = " compiler snapshot builder: TypedExpr lexical parent bridge drift"
            return false
        let sourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables,
                csg.semanticGraph.typedIrTable.functionSourceIndexes[
                    typedFunctionIndex])
        let spanId = tables.lexicalScopes.spanIds[scopeId]
        if sourceId != tables.lexicalScopes.sourceIds[scopeId] ||
           tables.spans.startLines[spanId] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.scopes2_startLineNumbers,
                   producerId) - 1 ||
           tables.spans.startColumns[spanId] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.scopes2_startColumnNumbers,
                   producerId) - 1 ||
           tables.spans.endLines[spanId] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.scopes2_endLineNumbers,
                   producerId) - 1 ||
           tables.spans.endColumns[spanId] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.scopes2_endColumnNumbers,
                   producerId):
            err = " compiler snapshot builder: TypedExpr lexical span producer drift"
            return false
        typedProducerSeen[producerId] = true
        typedProducerCount = typedProducerCount + 1
    if parserProducerCount != counts.parserScopeCount ||
       typedProducerCount != counts.typedScopeCount:
        err = " compiler snapshot builder: lexical producer domain incomplete"
        return false
    receipt.missingParserLexicalScopeIdentityCount = 0
    receipt.missingTypedLexicalScopeIdentityCount = 0
    receipt.missingStatementLexicalScopeUseCount = 0
    receipt.missingLexicalScopeBridgeCount = 0
    receipt.missingLexicalScopeOwnerDeclarationIdentityCount = 0
    receipt.missingLexicalScopeOwnerFunctionIdentityCount = 0
    receipt.missingLexicalScopeSpanCount = 0
    receipt.missingLexicalScopeVisibleSymbolProofCount = 0
    receipt.missingLexicalScopeProofCount = 0
    receipt.lexicalScopeProofCid =
        receipt.lexicalScopeRequiredDomainCid
    receipt.missingFactBitmap =
        receipt.missingFactBitmap &
        (511 - CompilerSnapshotAdmissionMissingLexicalScope)
    err = ""
    return true

@borrows
fn compilerSnapshotProductionUnsealedBaseStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let functionCount = tables.functions.symbolIds.len
    let externFunctionCount =
        tables.externFunctions.symbolIds.len
    let callableCount = functionCount + externFunctionCount
    let symbolCount = tables.symbols.symbolCids.len
    var expectedExternFunctionCount: int32
    for declarationRow in 0..<csg.semanticGraph.declTable.importc.len:
        if csg.semanticGraph.declTable.importc[declarationRow]:
            expectedExternFunctionCount =
                expectedExternFunctionCount + 1
    if !compilerSnapshotBuilderParserShape(tables) ||
       sourceCount != csg.sourceSnapshotCount ||
       functionCount !=
           csg.semanticGraph.reachableFunctionTable.graphNodeIds.len ||
       functionCount !=
           csg.semanticGraph.typedIrTable.functionSourceIndexes.len ||
       externFunctionCount != expectedExternFunctionCount ||
       symbolCount != callableCount + sourceCount ||
       tables.types.typeCids.len != 0 ||
       tables.declarations.declIds.len != 0 ||
       tables.readSet.readerFunctionIds.len != 0 ||
       tables.references.sourceIds.len != 0 ||
       tables.calls.callReferenceIds.len != 0:
        err = " compiler snapshot builder: unsealed production base shape invalid"
        return false
    for sourceId in 0..<sourceCount:
        if compilerSnapshotBuilderCidObserved(
               tables.sources.interfaceCids[sourceId]):
            err = " compiler snapshot builder: unsealed production source interface was prefilled"
            return false
    let symbolColumnsAligned =
        symbolCount == tables.symbols.interfaceCids.len &&
        symbolCount == tables.symbols.declIds.len &&
        symbolCount == tables.symbols.declKeyCids.len &&
        symbolCount == tables.symbols.declarationHeaderCids.len &&
        symbolCount == tables.symbols.declarationPathCids.len &&
        symbolCount == tables.symbols.sourceIds.len &&
        symbolCount == tables.symbols.nameTextIds.len &&
        symbolCount == tables.symbols.nameSpanIds.len &&
        symbolCount == tables.symbols.nameTokenIds.len &&
        symbolCount == tables.symbols.qualifiedNameTextIds.len &&
        symbolCount == tables.symbols.symbolKinds.len &&
        symbolCount == tables.symbols.typeIds.len &&
        symbolCount == tables.symbols.declarationSpanIds.len &&
        symbolCount == tables.symbols.ownerSymbolIds.len &&
        symbolCount == tables.symbols.functionIds.len &&
        symbolCount == tables.symbols.externFunctionIds.len &&
        symbolCount == tables.symbols.exportedFlags.len &&
        symbolCount == tables.symbols.genericConstraintStarts.len &&
        symbolCount == tables.symbols.genericConstraintCounts.len &&
        symbolCount == tables.symbols.genericParameterParserRows.len &&
        symbolCount == tables.symbols.genericParameterOrdinals.len &&
        symbolCount == tables.symbols.genericParameterDefaultTypeIds.len
    let functionColumnsAligned =
        functionCount == tables.functions.typedFunctionIndexes.len &&
        functionCount == tables.functions.bodySpanIds.len &&
        functionCount == tables.functions.bodyContentCids.len &&
        functionCount == tables.functions.fragmentCids.len &&
        functionCount == tables.functions.interfaceCids.len &&
        functionCount == tables.functions.annotationFlags.len &&
        functionCount ==
            tables.functions.manualConsumeTargetParameterSymbolIds.len &&
        functionCount ==
            tables.functions.manualConsumeSourceParameterSymbolIds.len &&
        functionCount ==
            tables.functions.manualConsumeEffectCids.len &&
        functionCount ==
            tables.functions.resultOwnershipKinds.len &&
        functionCount ==
            tables.functions.parameterOwnershipStarts.len &&
        functionCount ==
            tables.functions.parameterOwnershipCounts.len &&
        functionCount ==
            tables.functions.valueDefinitionStarts.len &&
        functionCount ==
            tables.functions.valueDefinitionCounts.len &&
        functionCount ==
            tables.functions.valueDefinitionGroupStarts.len &&
        functionCount ==
            tables.functions.valueDefinitionGroupCounts.len &&
        functionCount == tables.functions.readStarts.len &&
        functionCount == tables.functions.readCounts.len &&
        functionCount ==
            tables.functions.readSetPreimageCids.len &&
        functionCount == tables.functions.nodeStarts.len &&
        functionCount == tables.functions.nodeCounts.len
    let externFunctionColumnsAligned =
        externFunctionCount ==
            tables.externFunctions.parserDeclarationRows.len &&
        externFunctionCount == tables.externFunctions.typeIds.len &&
        externFunctionCount ==
            tables.externFunctions.externalNameTextIds.len &&
        externFunctionCount == tables.externFunctions.abiKinds.len &&
        externFunctionCount ==
            tables.externFunctions.importAnnotationRows.len &&
        externFunctionCount ==
            tables.externFunctions.interfaceCids.len
    if !symbolColumnsAligned || !functionColumnsAligned ||
       !externFunctionColumnsAligned ||
       tables.symbols.genericConstraintTypeIds.len != 0 ||
       tables.functions.parameterOwnershipKinds.len != 0:
        err = " compiler snapshot builder: unsealed production base columns invalid"
        return false
    for symbolId in 0..<symbolCount:
        let isExecutableFunction = symbolId < functionCount
        let isExternFunction =
            symbolId >= functionCount &&
            symbolId < callableCount
        let expectedKind =
            isExecutableFunction || isExternFunction ?
            snapshot_schema.CsgCompilerSymbolFunction :
            snapshot_schema.CsgCompilerSymbolModule
        if compilerSnapshotBuilderCidObserved(
               tables.symbols.symbolCids[symbolId]) ||
           compilerSnapshotBuilderCidObserved(
               tables.symbols.interfaceCids[symbolId]) ||
           tables.symbols.declIds[symbolId] != -1 ||
           compilerSnapshotBuilderCidObserved(
               tables.symbols.declKeyCids[symbolId]) ||
           tables.symbols.symbolKinds[symbolId] != expectedKind ||
           tables.symbols.typeIds[symbolId] != -1 ||
           tables.symbols.genericConstraintStarts[symbolId] != 0 ||
           tables.symbols.genericConstraintCounts[symbolId] != 0 ||
           !snapshot_schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
                tables, symbolId, err):
            if err == "":
                err = " compiler snapshot builder: unsealed production Symbol row invalid"
            return false
        if isExecutableFunction:
            let sourceId = tables.symbols.sourceIds[symbolId]
            let moduleSymbolId = callableCount + sourceId
            if tables.symbols.functionIds[symbolId] != symbolId ||
               tables.symbols.externFunctionIds[symbolId] != -1 ||
               tables.functions.symbolIds[symbolId] != symbolId ||
               tables.symbols.ownerSymbolIds[symbolId] !=
                   moduleSymbolId:
                err = " compiler snapshot builder: unsealed production Function owner invalid"
                return false
        elif isExternFunction:
            let externFunctionId = symbolId - functionCount
            let sourceId = tables.symbols.sourceIds[symbolId]
            let moduleSymbolId = callableCount + sourceId
            if tables.symbols.functionIds[symbolId] != -1 ||
               tables.symbols.externFunctionIds[symbolId] !=
                   externFunctionId ||
               tables.externFunctions.symbolIds[externFunctionId] !=
                   symbolId ||
               tables.externFunctions.typeIds[externFunctionId] != -1 ||
               compilerSnapshotBuilderCidObserved(
                   tables.externFunctions.interfaceCids[
                       externFunctionId]) ||
               tables.symbols.ownerSymbolIds[symbolId] !=
                   moduleSymbolId:
                err = " compiler snapshot builder: unsealed production extern owner invalid"
                return false
        elif tables.symbols.functionIds[symbolId] != -1 ||
             tables.symbols.externFunctionIds[symbolId] != -1 ||
             tables.symbols.ownerSymbolIds[symbolId] != -1:
            err = " compiler snapshot builder: unsealed production Module owner invalid"
            return false
    for functionId in 0..<functionCount:
        if compilerSnapshotBuilderCidObserved(
               tables.functions.interfaceCids[functionId]) ||
           !compilerSnapshotBuilderCidObserved(
               tables.functions.bodyContentCids[functionId]) ||
           !compilerSnapshotBuilderCidObserved(
               tables.functions.fragmentCids[functionId]) ||
           tables.functions.parameterOwnershipStarts[functionId] != 0 ||
           tables.functions.parameterOwnershipCounts[functionId] != 0 ||
           tables.functions.readStarts[functionId] != 0 ||
           tables.functions.readCounts[functionId] != 0 ||
           compilerSnapshotBuilderCidObserved(
               tables.functions.readSetPreimageCids[functionId]) ||
           tables.functions.manualConsumeTargetParameterSymbolIds[
               functionId] != -1 ||
           tables.functions.manualConsumeSourceParameterSymbolIds[
               functionId] != -1 ||
           compilerSnapshotBuilderCidObserved(
               tables.functions.manualConsumeEffectCids[functionId]) ||
           tables.functions.nodeStarts[functionId] != 0 ||
           tables.functions.nodeCounts[functionId] != 0:
            err = " compiler snapshot builder: unsealed production Function row invalid"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypedNodeTypesProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        newTypeIdByArenaTypeId: int32[],
        err: var str): bool =
    if !ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
           csg, err):
        return false
    let typedNodeCount = csg.typedIr.nodes2_nodeIndexs.len
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr)
    let groupCount =
        texpr.TypedExprValueDefinitionGroupAuthorityCount(csg.typedIr)
    if tables.typedNodes.typedIrNodeIndexes.len != typedNodeCount ||
       tables.typedNodes.ownerStatementIds.len != typedNodeCount ||
       tables.valueDefinitions.originKinds.len != definitionCount ||
       tables.valueDefinitions.groupRows.len != definitionCount ||
       tables.valueDefinitions.producerSourceIndexes.len !=
           definitionCount ||
       tables.valueDefinitions.sourceLocalNodeIndexes.len !=
           definitionCount ||
       tables.valueDefinitions.declarationSourceLocalRows.len !=
           definitionCount ||
       tables.valueDefinitions.patternSourceLocalRows.len !=
           definitionCount ||
       tables.valueDefinitions.functionIds.len != definitionCount ||
       tables.valueDefinitions.definingTypedNodeIds.len !=
           definitionCount ||
       tables.valueDefinitions.typeIds.len != definitionCount ||
       tables.valueDefinitions.ownershipKinds.len != definitionCount ||
       tables.valueDefinitions.proofKinds.len != definitionCount ||
       tables.valueDefinitionGroups.producerSourceIndexes.len !=
           groupCount ||
       tables.valueDefinitionGroups.bindingOffsets.len != groupCount ||
       tables.valueDefinitionGroups.bindingCounts.len != groupCount ||
       tables.valueDefinitionGroups.definitionRows.len != groupCount:
        err = " compiler snapshot builder: value-definition TypedNode domain split"
        return false
    var positionByProducerNode: int32[]
    setLen(positionByProducerNode, typedNodeCount)
    for typedNodeIndex in 0..<typedNodeCount:
        positionByProducerNode[typedNodeIndex] = -1
    for nodePosition in 0..<typedNodeCount:
        let producerNodeId =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_nodeIndexs,
                nodePosition)
        if producerNodeId < 0 ||
           producerNodeId >= typedNodeCount ||
           positionByProducerNode[producerNodeId] >= 0:
            err = " compiler snapshot builder: TypedNode producer TypeId identity invalid"
            return false
        positionByProducerNode[producerNodeId] =
            nodePosition
    for typedNodeRow in 0..<tables.typedNodes.typedIrNodeIndexes.len:
        let producerNodeId =
            tables.typedNodes.typedIrNodeIndexes[typedNodeRow]
        let nodePosition =
            producerNodeId < 0 ||
            producerNodeId >= positionByProducerNode.len ?
                -1 :
                positionByProducerNode[producerNodeId]
        let arenaTypeId =
            nodePosition < 0 ? -1 :
                texpr.TypedExprIrNodeStructuralTypeIdAt(
                    csg.typedIr, nodePosition)
        let finalTypeId =
            arenaTypeId < 0 ||
            arenaTypeId >= newTypeIdByArenaTypeId.len ?
                -1 : newTypeIdByArenaTypeId[arenaTypeId]
        if nodePosition >= 0 &&
           arenaTypeId < 0 &&
           texpr.TypedExprIrNodeOpKindAt(
               csg.typedIr, nodePosition) ==
               texpr.TypedExprIrOpNilPtr:
            # [prek-W1 预制刀] NilPtr 载体 canonical TypeId 放行臂——np3 终检臂
            # 放行的生产者侧 nil-able 证明：plain nil 铸造恒
            # resultStructuralTypeId=-1，无行是合法态非数据缺失。镜像 nn2 裁决
            # （NilPtr 即生产者侧 nil-able 证明放行 -1，-1 照旧入列零捏造），
            # 非 NilPtr 节点的 -1 与其余漏章仍走原判词 fail-closed 零弱化。
            tables.typedNodes.typeIds[typedNodeRow] = -1
            continue
        if nodePosition < 0 ||
           arenaTypeId < 0 ||
           arenaTypeId >= newTypeIdByArenaTypeId.len ||
           finalTypeId < 0 ||
           finalTypeId >= tables.types.typeCids.len ||
           tables.typedNodes.typeIds[typedNodeRow] != -1:
            err = " compiler snapshot builder: TypedNode canonical TypeId missing"
            return false
        tables.typedNodes.typeIds[typedNodeRow] =
            finalTypeId
    var snapshotRowByProducerNode: int32[]
    setLen(snapshotRowByProducerNode, typedNodeCount)
    for producerNodeId in 0..<typedNodeCount:
        snapshotRowByProducerNode[producerNodeId] = -1
    for typedNodeRow in 0..<tables.typedNodes.typedIrNodeIndexes.len:
        let producerNodeId =
            tables.typedNodes.typedIrNodeIndexes[typedNodeRow]
        if producerNodeId < 0 ||
           producerNodeId >= snapshotRowByProducerNode.len ||
           snapshotRowByProducerNode[producerNodeId] >= 0:
            err = " compiler snapshot builder: value-definition TypedNode reverse identity invalid"
            return false
        snapshotRowByProducerNode[producerNodeId] = typedNodeRow
    var functionIdByTypedFunctionIndex: int32[]
    setLen(
        functionIdByTypedFunctionIndex,
        csg.typedIr.functions2_functionNameIds.len)
    for typedFunctionIndex in 0..<functionIdByTypedFunctionIndex.len:
        functionIdByTypedFunctionIndex[typedFunctionIndex] = -1
    for functionId in 0..<tables.functions.typedFunctionIndexes.len:
        let typedFunctionIndex =
            tables.functions.typedFunctionIndexes[functionId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= functionIdByTypedFunctionIndex.len ||
           functionIdByTypedFunctionIndex[typedFunctionIndex] >= 0:
            err = " compiler snapshot builder: value-definition function reverse identity invalid"
            return false
        functionIdByTypedFunctionIndex[typedFunctionIndex] = functionId
    for definitionRow in 0..<definitionCount:
        let producerSourceIndex =
            texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                csg.typedIr, definitionRow)
        let declarationSourceLocalRow =
            texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                csg.typedIr, definitionRow)
        let patternSourceLocalRow =
            texpr.TypedExprValueDefinitionPatternSourceLocalRowAt(
                csg.typedIr, definitionRow)
        let typedFunctionIndex =
            texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
                csg.typedIr, definitionRow)
        let definingNodePosition =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                csg.typedIr, definitionRow)
        let arenaTypeId =
            texpr.TypedExprValueDefinitionExactTypeIdAt(
                csg.typedIr, definitionRow)
        let finalTypeId =
            arenaTypeId < 0 ||
            arenaTypeId >= newTypeIdByArenaTypeId.len ?
                -1 : newTypeIdByArenaTypeId[arenaTypeId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= functionIdByTypedFunctionIndex.len ||
           functionIdByTypedFunctionIndex[typedFunctionIndex] < 0 ||
           definingNodePosition < 0 ||
           definingNodePosition >= typedNodeCount ||
           arenaTypeId < 0 ||
           arenaTypeId >= newTypeIdByArenaTypeId.len ||
           finalTypeId < 0 ||
           finalTypeId >= tables.types.typeCids.len:
            err = " compiler snapshot builder: value-definition producer identity missing"
            return false
        let definingProducerNodeId =
            arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_nodeIndexs,
                definingNodePosition)
        if definingProducerNodeId < 0 ||
           definingProducerNodeId >= snapshotRowByProducerNode.len ||
           snapshotRowByProducerNode[definingProducerNodeId] < 0:
            err = " compiler snapshot builder: value-definition defining TypedNode missing"
            return false
        if tables.valueDefinitions.originKinds[definitionRow] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.valueDefinitions_originKinds,
                   definitionRow) ||
           tables.valueDefinitions.producerSourceIndexes[definitionRow] !=
               producerSourceIndex ||
           tables.valueDefinitions.sourceLocalNodeIndexes[definitionRow] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.valueDefinitions_sourceLocalNodeIndexes,
                   definitionRow) ||
           tables.valueDefinitions.groupRows[definitionRow] !=
               arenamod.ArenaArrayInt32Get(
                   csg.typedIr.arena,
                   csg.typedIr.valueDefinitions_groupRows,
                   definitionRow) ||
           tables.valueDefinitions.declarationSourceLocalRows[
               definitionRow] != declarationSourceLocalRow ||
           tables.valueDefinitions.patternSourceLocalRows[definitionRow] !=
               patternSourceLocalRow ||
           tables.valueDefinitions.functionIds[definitionRow] !=
               functionIdByTypedFunctionIndex[typedFunctionIndex] ||
           tables.valueDefinitions.definingTypedNodeIds[definitionRow] !=
               snapshotRowByProducerNode[definingProducerNodeId] ||
           tables.typedNodes.producedValueDefinitionRows[
               snapshotRowByProducerNode[definingProducerNodeId]] !=
               definitionRow ||
           tables.valueDefinitions.typeIds[definitionRow] != -1 ||
           tables.typedNodes.typeIds[
               snapshotRowByProducerNode[definingProducerNodeId]] !=
               finalTypeId ||
           tables.valueDefinitions.ownershipKinds[definitionRow] !=
               compilerSnapshotBuilderOwnershipKind(
                   texpr.TypedExprValueDefinitionOwnershipAt(
                       csg.typedIr, definitionRow)) ||
           tables.valueDefinitions.proofKinds[definitionRow] !=
               texpr.TypedExprValueDefinitionProofKindAt(
                   csg.typedIr, definitionRow):
            err = " compiler snapshot builder: value-definition canonical TypeId drift"
            return false
        tables.valueDefinitions.typeIds[definitionRow] =
            finalTypeId
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeSyntaxTypesProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        newTypeIdByArenaTypeId: int32[],
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let typeSyntaxCount =
        tables.parserSidecars.typeSyntaxSourceIds.len
    if csg.typeArena == nil ||
       sourceCount != csg.typeArena.producerSourceCount ||
       typeSyntaxCount != csg.typeArena.typeSyntaxCount ||
       tables.parserSidecars.typeSyntaxTypeIds.len != typeSyntaxCount ||
       newTypeIdByArenaTypeId.len < csg.typeArena.typeCount:
        err = " compiler snapshot builder: TypeSyntax TypeId bridge domain split"
        return false
    var sourceTypeStarts: int32[]
    var sourceTypeCounts: int32[]
    var producerTypeStarts: int32[]
    var producerTypeCounts: int32[]
    setLen(sourceTypeStarts, sourceCount)
    setLen(sourceTypeCounts, sourceCount)
    setLen(producerTypeStarts, sourceCount)
    setLen(producerTypeCounts, sourceCount)
    for sourceId in 0..<sourceCount:
        sourceTypeStarts[sourceId] = -1
        producerTypeStarts[sourceId] = -1
    for typeSyntaxId in 0..<typeSyntaxCount:
        let sourceId =
            tables.parserSidecars.typeSyntaxSourceIds[typeSyntaxId]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: TypeSyntax TypeId source invalid"
            return false
        if sourceTypeStarts[sourceId] < 0:
            sourceTypeStarts[sourceId] = typeSyntaxId
        sourceTypeCounts[sourceId] =
            sourceTypeCounts[sourceId] + 1
    for arenaTypeSyntaxId in 0..<csg.typeArena.typeSyntaxCount:
        let producerSource = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxProducerSourceIndexes,
            arenaTypeSyntaxId)
        if producerSource < 0 || producerSource >= sourceCount:
            err = " compiler snapshot builder: TypeArena TypeSyntax source invalid"
            return false
        if producerTypeStarts[producerSource] < 0:
            producerTypeStarts[producerSource] = arenaTypeSyntaxId
        producerTypeCounts[producerSource] =
            producerTypeCounts[producerSource] + 1
    for sourceId in 0..<sourceCount:
        let producerSource =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        if producerSource < 0 || producerSource >= sourceCount ||
           sourceTypeCounts[sourceId] !=
               producerTypeCounts[producerSource]:
            err = " compiler snapshot builder: TypeSyntax TypeId source crosswalk drift"
            return false
        for localTypeSyntaxId in 0..<sourceTypeCounts[sourceId]:
            let typeSyntaxId =
                sourceTypeStarts[sourceId] + localTypeSyntaxId
            let arenaTypeSyntaxId =
                producerTypeStarts[producerSource] + localTypeSyntaxId
            let arenaTypeId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.typeSyntaxTypeIds,
                arenaTypeSyntaxId)
            if tables.parserSidecars.typeSyntaxTypeIds[typeSyntaxId] != -1 ||
               arenaTypeId < 0 ||
               arenaTypeId >= newTypeIdByArenaTypeId.len ||
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxProducerSourceIndexes,
                   arenaTypeSyntaxId) != producerSource:
                err = " compiler snapshot builder: TypeSyntax TypeId producer join drift"
                return false
            tables.parserSidecars.typeSyntaxTypeIds[typeSyntaxId] =
                newTypeIdByArenaTypeId[arenaTypeId]
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeSyntaxTypesBindingValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        finalTypeIdByArenaTypeId: int32[],
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let typeSyntaxCount =
        tables.parserSidecars.typeSyntaxSourceIds.len
    if csg.typeArena == nil ||
       sourceCount != csg.typeArena.producerSourceCount ||
       typeSyntaxCount != csg.typeArena.typeSyntaxCount ||
       tables.parserSidecars.typeSyntaxTypeIds.len != typeSyntaxCount ||
       finalTypeIdByArenaTypeId.len != csg.typeArena.typeCount:
        err = " compiler snapshot builder: TypeSyntax TypeId binding domain split"
        return false
    var sourceTypeStarts: int32[]
    var sourceTypeCounts: int32[]
    var producerTypeStarts: int32[]
    var producerTypeCounts: int32[]
    setLen(sourceTypeStarts, sourceCount)
    setLen(sourceTypeCounts, sourceCount)
    setLen(producerTypeStarts, sourceCount)
    setLen(producerTypeCounts, sourceCount)
    for sourceId in 0..<sourceCount:
        sourceTypeStarts[sourceId] = -1
        producerTypeStarts[sourceId] = -1
    for typeSyntaxId in 0..<typeSyntaxCount:
        let sourceId =
            tables.parserSidecars.typeSyntaxSourceIds[typeSyntaxId]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: TypeSyntax TypeId binding source invalid"
            return false
        if sourceTypeStarts[sourceId] < 0:
            sourceTypeStarts[sourceId] = typeSyntaxId
        sourceTypeCounts[sourceId] =
            sourceTypeCounts[sourceId] + 1
    for arenaTypeSyntaxId in 0..<csg.typeArena.typeSyntaxCount:
        let producerSource = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxProducerSourceIndexes,
            arenaTypeSyntaxId)
        if producerSource < 0 || producerSource >= sourceCount:
            err = " compiler snapshot builder: TypeArena TypeSyntax binding source invalid"
            return false
        if producerTypeStarts[producerSource] < 0:
            producerTypeStarts[producerSource] = arenaTypeSyntaxId
        producerTypeCounts[producerSource] =
            producerTypeCounts[producerSource] + 1
    for sourceId in 0..<sourceCount:
        let producerSource =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        if producerSource < 0 || producerSource >= sourceCount ||
           sourceTypeCounts[sourceId] !=
               producerTypeCounts[producerSource]:
            err = " compiler snapshot builder: TypeSyntax TypeId binding crosswalk drift"
            return false
        for localTypeSyntaxId in 0..<sourceTypeCounts[sourceId]:
            let typeSyntaxId =
                sourceTypeStarts[sourceId] + localTypeSyntaxId
            let arenaTypeSyntaxId =
                producerTypeStarts[producerSource] + localTypeSyntaxId
            let arenaTypeId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.typeSyntaxTypeIds,
                arenaTypeSyntaxId)
            if arenaTypeId < 0 ||
               arenaTypeId >= finalTypeIdByArenaTypeId.len ||
               tables.parserSidecars.typeSyntaxTypeIds[typeSyntaxId] !=
                   finalTypeIdByArenaTypeId[arenaTypeId]:
                err = " compiler snapshot builder: TypeSyntax canonical TypeId binding drift"
                return false
    err = ""
    return true

@borrows
fn compilerSnapshotResolvedCallProjectionRowLess(
        left: compilerSnapshotResolvedCallProjectionRow,
        right: compilerSnapshotResolvedCallProjectionRow): bool =
    if left.calleeSymbolId != right.calleeSymbolId:
        return left.calleeSymbolId < right.calleeSymbolId
    if left.sourceId != right.sourceId:
        return left.sourceId < right.sourceId
    return left.spanId < right.spanId

fn compilerSnapshotResolvedCallProjectionRowsCanonicalizeInto(
        rows: var compilerSnapshotResolvedCallProjectionRow[],
        err: var str): bool =
    var width: int32 = 1
    var scratch: compilerSnapshotResolvedCallProjectionRow[]
    setLen(scratch, rows.len)
    while width < rows.len:
        var start: int32
        while start < rows.len:
            let middle =
                start + width < rows.len ? start + width : rows.len
            let end =
                middle + width < rows.len ? middle + width : rows.len
            var left = start
            var right = middle
            var write = start
            while left < middle || right < end:
                if right >= end ||
                   (left < middle &&
                    compilerSnapshotResolvedCallProjectionRowLess(
                        rows[left], rows[right])):
                    scratch[write] = rows[left]
                    left = left + 1
                else:
                    scratch[write] = rows[right]
                    right = right + 1
                write = write + 1
            start = end
        for row in 0..<rows.len:
            rows[row] = scratch[row]
        if width > 1073741823:
            err = " compiler snapshot builder: resolved call sort overflow"
            return false
        width = width * 2
    for row in 1..<rows.len:
        if !compilerSnapshotResolvedCallProjectionRowLess(
               rows[row - 1], rows[row]):
            err = " compiler snapshot builder: duplicate resolved call coordinate"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderResolvedCallsProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        newTypeIdByArenaTypeId: int32[],
        err: var str): bool =
    if tables.references.sourceIds.len != 0 ||
       tables.references.spanIds.len != 0 ||
       tables.references.ownerFunctionIds.len != 0 ||
       tables.references.ownerSymbolIds.len != 0 ||
       tables.references.targetSymbolIds.len != 0 ||
       tables.references.referenceKinds.len != 0 ||
       tables.references.bindingTypedNodeIds.len != 0 ||
       tables.calls.callReferenceIds.len != 0 ||
       tables.calls.callerFunctionIds.len != 0 ||
       tables.calls.calleeSymbolIds.len != 0 ||
       tables.calls.targetCallDeclarationRows.len != 0 ||
       tables.calls.targetSourceIds.len != 0 ||
       tables.calls.targetSourceLocalDeclarationRows.len != 0 ||
       tables.calls.targetParserDeclarationRows.len != 0 ||
       tables.calls.targetDeclIds.len != 0 ||
       tables.calls.targetDeclKeyCids.len != 0 ||
       tables.calls.targetSymbolCids.len != 0 ||
       tables.calls.resultTypedNodeIds.len != 0 ||
       tables.calls.resultValueDefinitionRows.len != 0 ||
       tables.calls.resultTypeIds.len != 0 ||
       tables.calls.resultOwnershipKinds.len != 0 ||
       tables.calls.resultOwnershipProofKinds.len != 0 ||
       tables.calls.resultOwnershipProofCids.len != 0:
        err = " compiler snapshot builder: resolved call destination is not empty"
        return false
    let calls = csg.semanticGraph.resolvedCallTable
    let callCount = calls.sourceIndexes.len
    let declarationIndex =
        texpr.TypedExprIrCallDeclarationBuildIndex(csg.typedIr)
    if declarationIndex == nil || declarationIndex.released ||
       !declarationIndex.callDeclarationSealed ||
       declarationIndex.callDeclarationKinds.len !=
           declarationIndex.callDeclarationProducerSourceIndexes.len ||
       declarationIndex.callDeclarationKinds.len !=
           declarationIndex.callDeclarationProducerDeclarationOrdinals.len ||
       declarationIndex.callDeclarationKinds.len !=
           declarationIndex.callDeclarationProducerFunctionRows.len ||
       callCount != calls.originParserNodeIds.len ||
       callCount != calls.functionIndexes.len ||
       callCount != calls.callTargetImportcFlags.len ||
       callCount != calls.targetProducerSourceIndexes.len ||
       callCount != calls.targetProducerDeclarationOrdinals.len ||
       callCount !=
           calls.targetParserSourceLocalDeclarationRows.len ||
       callCount != calls.callerGraphNodeIds.len ||
       callCount != calls.targetGraphNodeIds.len:
        err = " compiler snapshot builder: resolved call producer shape invalid"
        return false
    var functionIdByTypedRow: int32[]
    setLen(functionIdByTypedRow,
        csg.semanticGraph.typedIrTable.functionGraphNodeIds.len)
    var functionIdByGraphNode: int32[]
    setLen(functionIdByGraphNode, csg.nodes.len + 1)
    for row in 0..<functionIdByTypedRow.len:
        functionIdByTypedRow[row] = -1
    for row in 0..<functionIdByGraphNode.len:
        functionIdByGraphNode[row] = -1
    for functionId in 0..<tables.functions.symbolIds.len:
        let typedRow = tables.functions.typedFunctionIndexes[functionId]
        let graphNodeId =
            typedRow < 0 || typedRow >= functionIdByTypedRow.len ?
                -1 :
                csg.semanticGraph.typedIrTable.functionGraphNodeIds[
                    typedRow]
        if typedRow < 0 || typedRow >= functionIdByTypedRow.len ||
           graphNodeId <= 0 ||
           graphNodeId >= functionIdByGraphNode.len ||
           functionIdByTypedRow[typedRow] >= 0 ||
           functionIdByGraphNode[graphNodeId] >= 0:
            err = " compiler snapshot builder: resolved call FunctionId index invalid"
            return false
        functionIdByTypedRow[typedRow] = functionId
        functionIdByGraphNode[graphNodeId] = functionId
    var sourceNodeBases: int32[]
    var sourceDeclarationBases: int32[]
    var totalParserNodes: int32
    var totalParserDeclarations: int32
    for producerSource in 0..<sidecars.len:
        add(sourceNodeBases, totalParserNodes)
        add(sourceDeclarationBases, totalParserDeclarations)
        if !compilerSnapshotBuilderCountAppendSafe(
               totalParserNodes,
               sidecars[producerSource].nodeKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               totalParserDeclarations,
               sidecars[producerSource].declarationKinds.len):
            err = " compiler snapshot builder: resolved call parser domain overflow"
            return false
        totalParserNodes =
            totalParserNodes + sidecars[producerSource].nodeKinds.len
        totalParserDeclarations =
            totalParserDeclarations +
            sidecars[producerSource].declarationKinds.len
    var typedPositionByParserSlot: int32[]
    var parserDeclarationByProducerSlot: int32[]
    setLen(typedPositionByParserSlot, totalParserNodes)
    setLen(parserDeclarationByProducerSlot, totalParserDeclarations)
    for row in 0..<typedPositionByParserSlot.len:
        typedPositionByParserSlot[row] = -1
    for row in 0..<parserDeclarationByProducerSlot.len:
        parserDeclarationByProducerSlot[row] = -1
    for typedFunctionRow in 0..<functionIdByTypedRow.len:
        let producerSource =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[
                typedFunctionRow]
        let nodeStart =
            csg.semanticGraph.typedIrTable.functionNodeStart[
                typedFunctionRow]
        let nodeCount =
            csg.semanticGraph.typedIrTable.functionNodeCount[
                typedFunctionRow]
        if producerSource < 0 || producerSource >= sidecars.len ||
           nodeStart < 0 || nodeCount < 0 ||
           nodeStart > csg.typedIr.nodes2_nodeIndexs.len ||
           nodeCount > csg.typedIr.nodes2_nodeIndexs.len - nodeStart:
            err = " compiler snapshot builder: resolved call TypedExpr range invalid"
            return false
        for nodePosition in nodeStart..<nodeStart + nodeCount:
            if csg.typedIr.nodes2_opKinds[nodePosition] !=
                   texpr.TypedExprIrOpCallExpr:
                continue
            let parserNodeId = arenamod.ArenaArrayInt32Get(
                csg.typedIr.arena,
                csg.typedIr.nodes2_originParserNodeIds,
                nodePosition)
            if parserNodeId < 0:
                continue
            if parserNodeId >= sidecars[producerSource].nodeKinds.len:
                err = " compiler snapshot builder: resolved call parser origin invalid"
                return false
            let slot =
                sourceNodeBases[producerSource] + parserNodeId
            if typedPositionByParserSlot[slot] >= 0:
                err = " compiler snapshot builder: resolved call parser origin ambiguous"
                return false
            typedPositionByParserSlot[slot] = nodePosition
    for parserDeclarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                parserDeclarationRow]
        let localRow =
            tables.parserSidecars.declarationSourceLocalRows[
                parserDeclarationRow]
        let producerSource =
            sourceId < 0 ||
            sourceId >= tables.parserSidecars.producerSourceIndexes.len ?
                -1 :
                tables.parserSidecars.producerSourceIndexes[sourceId]
        if producerSource < 0 || producerSource >= sidecars.len ||
           localRow < 0 ||
           localRow >= sidecars[producerSource].declarationKinds.len:
            err = " compiler snapshot builder: resolved call parser declaration coordinate invalid"
            return false
        let slot =
            sourceDeclarationBases[producerSource] + localRow
        if parserDeclarationByProducerSlot[slot] >= 0:
            err = " compiler snapshot builder: resolved call parser declaration ambiguous"
            return false
        parserDeclarationByProducerSlot[slot] =
            parserDeclarationRow
    var snapshotTypedNodeByProducer: int32[]
    setLen(snapshotTypedNodeByProducer,
        csg.typedIr.nodes2_nodeIndexs.len)
    for row in 0..<snapshotTypedNodeByProducer.len:
        snapshotTypedNodeByProducer[row] = -1
    for typedNodeId in 0..<tables.typedNodes.typedIrNodeIndexes.len:
        let producerNodeId =
            tables.typedNodes.typedIrNodeIndexes[typedNodeId]
        if producerNodeId < 0 ||
           producerNodeId >= snapshotTypedNodeByProducer.len ||
           snapshotTypedNodeByProducer[producerNodeId] >= 0:
            err = " compiler snapshot builder: resolved call TypedNode index invalid"
            return false
        snapshotTypedNodeByProducer[producerNodeId] = typedNodeId
    var rows: compilerSnapshotResolvedCallProjectionRow[]
    for callRow in 0..<callCount:
        let producerSource = calls.sourceIndexes[callRow]
        let parserNodeId = calls.originParserNodeIds[callRow]
        let typedFunctionRow = calls.functionIndexes[callRow]
        let targetGraphNodeId = calls.targetGraphNodeIds[callRow]
        let typedPosition =
            producerSource < 0 || producerSource >= sidecars.len ||
            parserNodeId < 0 ||
            parserNodeId >= sidecars[producerSource].nodeKinds.len ?
                -1 :
                typedPositionByParserSlot[
                    sourceNodeBases[producerSource] + parserNodeId]
        let callerFunctionId =
            typedFunctionRow < 0 ||
            typedFunctionRow >= functionIdByTypedRow.len ?
                -1 : functionIdByTypedRow[typedFunctionRow]
        let targetFunctionId =
            targetGraphNodeId <= 0 ||
            targetGraphNodeId >= functionIdByGraphNode.len ?
                -1 : functionIdByGraphNode[targetGraphNodeId]
        if typedPosition < 0 || callerFunctionId < 0 ||
           (calls.callTargetImportcFlags[callRow] &&
            targetGraphNodeId != -1) ||
           (!calls.callTargetImportcFlags[callRow] &&
            targetFunctionId < 0) ||
           calls.callerGraphNodeIds[callRow] !=
               csg.semanticGraph.typedIrTable.functionGraphNodeIds[
                   typedFunctionRow]:
            err = " compiler snapshot builder: resolved Cheng call graph join invalid"
            return false
        let callDeclarationRow = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_callDeclarationIndexes,
            typedPosition)
        if callDeclarationRow < 0 ||
           callDeclarationRow >= declarationIndex.callDeclarationKinds.len ||
           csg.typedIr.nodes2_callKinds[typedPosition] !=
               texpr.TypedExprCallNone ||
           (declarationIndex.callDeclarationKinds[
                callDeclarationRow] ==
                texpr.TypedExprCallDeclarationImportc) !=
               calls.callTargetImportcFlags[callRow] ||
           (declarationIndex.callDeclarationKinds[
                callDeclarationRow] !=
                texpr.TypedExprCallDeclarationFunction &&
            declarationIndex.callDeclarationKinds[
                callDeclarationRow] !=
                texpr.TypedExprCallDeclarationImportc):
            err = " compiler snapshot builder: resolved call declaration row invalid"
            return false
        let targetProducerSource =
            declarationIndex.callDeclarationProducerSourceIndexes[
                callDeclarationRow]
        let targetProducerDeclarationOrdinal =
            declarationIndex.callDeclarationProducerDeclarationOrdinals[
                callDeclarationRow]
        let targetProducerFunctionRow =
            declarationIndex.callDeclarationProducerFunctionRows[
                callDeclarationRow]
        let targetParserLocalDeclaration =
            calls.targetParserSourceLocalDeclarationRows[callRow]
        if targetProducerSource < 0 ||
           targetProducerSource >= sidecars.len ||
           targetProducerDeclarationOrdinal < 0 ||
           targetProducerFunctionRow < -1 ||
           targetParserLocalDeclaration < 0 ||
           targetParserLocalDeclaration >=
               sidecars[targetProducerSource].declarationKinds.len ||
           calls.targetProducerSourceIndexes[callRow] !=
               targetProducerSource ||
           calls.targetProducerDeclarationOrdinals[callRow] !=
               targetProducerDeclarationOrdinal:
            err = " compiler snapshot builder: resolved call target producer join invalid"
            return false
        let targetParserDeclaration =
            parserDeclarationByProducerSlot[
                sourceDeclarationBases[targetProducerSource] +
                    targetParserLocalDeclaration]
        if targetParserDeclaration < 0 ||
           targetParserDeclaration >=
               tables.parserSidecars.declarationKinds.len ||
           tables.parserSidecars.declarationKinds[
               targetParserDeclaration] !=
               Int32(parser.ParserDeclarationFunction) ||
           tables.parserSidecars.declarationProducerSourceIds[
               targetParserDeclaration] !=
               compilerSnapshotBuilderCanonicalSourceForProducer(
                   tables, targetProducerSource) ||
           tables.parserSidecars.declarationSourceLocalRows[
               targetParserDeclaration] !=
               targetParserLocalDeclaration ||
           sidecars[targetProducerSource].declarationFunctionRows[
               targetParserLocalDeclaration] !=
               targetProducerDeclarationOrdinal:
            err = " compiler snapshot builder: resolved call target declaration row invalid"
            return false
        let targetSourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, targetProducerSource)
        var calleeSymbolId: int32 = -1
        if calls.callTargetImportcFlags[callRow]:
            if targetProducerFunctionRow != -1:
                err = " compiler snapshot builder: extern call carried Function row"
                return false
            for externFunctionId in 0..<
                    tables.externFunctions.symbolIds.len:
                if tables.externFunctions.parserDeclarationRows[
                       externFunctionId] !=
                       targetParserDeclaration:
                    continue
                if calleeSymbolId >= 0:
                    err = " compiler snapshot builder: resolved extern call target ambiguous"
                    return false
                calleeSymbolId =
                    tables.externFunctions.symbolIds[externFunctionId]
        else:
            if targetProducerFunctionRow < 0 ||
               targetProducerFunctionRow >=
                   sidecars[targetProducerSource].functionIndexes.len ||
               targetProducerFunctionRow >=
                   sidecars[targetProducerSource].functionDeclarationOrdinals.len ||
               sidecars[targetProducerSource].functionDeclarationOrdinals[
                       targetProducerFunctionRow] !=
                   targetProducerDeclarationOrdinal:
                err = " compiler snapshot builder: resolved executable call producer join invalid"
                return false
            let parserTargetFunctionId =
                sidecars[targetProducerSource].functionIndexes[
                    targetProducerFunctionRow]
            if parserTargetFunctionId < 0 ||
               parserTargetFunctionId >=
                   tables.functions.typedFunctionIndexes.len ||
               targetFunctionId < 0 ||
               targetFunctionId >=
                   tables.functions.typedFunctionIndexes.len ||
               tables.functions.typedFunctionIndexes[
                   parserTargetFunctionId] !=
                   tables.functions.typedFunctionIndexes[
                       targetFunctionId]:
                err = " compiler snapshot builder: resolved executable call TypedExpr Function join invalid"
                return false
            calleeSymbolId =
                tables.functions.symbolIds[targetFunctionId]
        let targetDeclId =
            calleeSymbolId < 0 ||
            calleeSymbolId >= tables.symbols.declIds.len ?
                -1 : tables.symbols.declIds[calleeSymbolId]
        let producerTypedNodeId = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_nodeIndexs,
            typedPosition)
        let resultTypedNodeId =
            producerTypedNodeId < 0 ||
            producerTypedNodeId >= snapshotTypedNodeByProducer.len ?
                -1 :
                snapshotTypedNodeByProducer[producerTypedNodeId]
        let arenaTypeId =
            texpr.TypedExprIrNodeStructuralTypeIdAt(
                csg.typedIr, typedPosition)
        let resultTypeId =
            arenaTypeId < 0 ||
            arenaTypeId >= newTypeIdByArenaTypeId.len ?
                -1 : newTypeIdByArenaTypeId[arenaTypeId]
        let resultOwnershipKind =
            compilerSnapshotBuilderOwnershipKind(
                csg.typedIr.nodes2_exprClasses[typedPosition])
        if targetParserDeclaration < 0 || targetSourceId < 0 ||
           calleeSymbolId < 0 || targetDeclId < 0 ||
           calleeSymbolId >= tables.symbols.functionIds.len ||
           calleeSymbolId >= tables.symbols.externFunctionIds.len ||
           tables.symbols.symbolKinds[calleeSymbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction ||
           resultTypedNodeId < 0 || resultTypeId < 0 ||
           resultOwnershipKind == 0 ||
           tables.typedNodes.functionIds[resultTypedNodeId] !=
               callerFunctionId ||
           tables.typedNodes.spanIds[resultTypedNodeId] < 0 ||
           tables.symbols.sourceIds[calleeSymbolId] != targetSourceId:
            err = " compiler snapshot builder: resolved call semantic identity missing"
            return false
        let calleeFunctionId =
            tables.symbols.functionIds[calleeSymbolId]
        let calleeExternFunctionId =
            tables.symbols.externFunctionIds[calleeSymbolId]
        if calls.callTargetImportcFlags[callRow]:
            if calleeFunctionId != -1 ||
               calleeExternFunctionId < 0 ||
               calleeExternFunctionId >=
                   tables.externFunctions.symbolIds.len ||
               tables.externFunctions.symbolIds[
                   calleeExternFunctionId] != calleeSymbolId ||
               tables.externFunctions.parserDeclarationRows[
                   calleeExternFunctionId] !=
                   targetParserDeclaration:
                err = " compiler snapshot builder: resolved extern call identity split"
                return false
        elif calleeFunctionId != targetFunctionId ||
             calleeExternFunctionId != -1:
            err = " compiler snapshot builder: resolved executable call identity split"
            return false
        var callManualTargetOrdinal: int32
        var callManualSourceOrdinal: int32
        var callManualTargetDeclarationRow: int32
        var callManualSourceDeclarationRow: int32
        var callManualTargetTypeId: int32
        var callManualSourceTypeId: int32
        var callManualEffectCid: layout.FixedBytes32
        let callManualPresent =
            texpr.TypedExprIrCallManualConsumeEffectInto(
                csg.typedIr,
                typedPosition,
                callManualTargetOrdinal,
                callManualSourceOrdinal,
                callManualTargetDeclarationRow,
                callManualSourceDeclarationRow,
                callManualTargetTypeId,
                callManualSourceTypeId,
                callManualEffectCid)
        if calls.callTargetImportcFlags[callRow]:
            if callManualPresent:
                err = " compiler snapshot builder: extern CallExpr carried manual consume effect"
                return false
        else:
            let calleeManualPresent =
                (tables.functions.annotationFlags[targetFunctionId] &
                 snapshot_schema.CsgCompilerFunctionAnnotationManualConsume) != 0
            if callManualPresent != calleeManualPresent:
                err = " compiler snapshot builder: CallExpr manual consume presence drift"
                return false
            if callManualPresent:
                var targetParserFunctionRow: int32 = -1
                for parserFunctionRow in 0..<
                        tables.parserSidecars.functionIndexes.len:
                    let parserFunctionId =
                        tables.parserSidecars.functionIndexes[
                            parserFunctionRow]
                    if parserFunctionId < 0 ||
                       parserFunctionId >=
                           tables.functions.typedFunctionIndexes.len ||
                       tables.functions.typedFunctionIndexes[
                           parserFunctionId] !=
                           tables.functions.typedFunctionIndexes[
                               targetFunctionId]:
                        continue
                    if parserFunctionId != targetFunctionId:
                        err = " compiler snapshot builder: CallExpr manual consume Function identity crossed"
                        return false
                    if targetParserFunctionRow >= 0:
                        err = " compiler snapshot builder: CallExpr manual consume callee ambiguous"
                        return false
                    targetParserFunctionRow = parserFunctionRow
                let targetParameterSymbolId =
                    tables.functions.manualConsumeTargetParameterSymbolIds[
                        targetFunctionId]
                let sourceParameterSymbolId =
                    tables.functions.manualConsumeSourceParameterSymbolIds[
                        targetFunctionId]
                if targetParserFunctionRow < 0:
                    err = " compiler snapshot builder: CallExpr manual consume callee missing"
                    return false
                let targetParserParameterDeclaration =
                    tables.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
                        targetParserFunctionRow]
                let sourceParserParameterDeclaration =
                    tables.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
                        targetParserFunctionRow]
                if targetParserParameterDeclaration < 0 ||
                   targetParserParameterDeclaration >=
                       tables.parserSidecars.declarationSourceLocalRows.len ||
                   sourceParserParameterDeclaration < 0 ||
                   sourceParserParameterDeclaration >=
                       tables.parserSidecars.declarationSourceLocalRows.len ||
                   targetParameterSymbolId < 0 ||
                   sourceParameterSymbolId < 0 ||
                   callManualTargetTypeId < 0 ||
                   callManualTargetTypeId >=
                       newTypeIdByArenaTypeId.len ||
                   callManualSourceTypeId < 0 ||
                   callManualSourceTypeId >=
                       newTypeIdByArenaTypeId.len ||
                   callManualTargetOrdinal !=
                       tables.parserSidecars.functionManualConsumeTargetParameterOrdinals[
                           targetParserFunctionRow] ||
                   callManualSourceOrdinal !=
                       tables.parserSidecars.functionManualConsumeSourceParameterOrdinals[
                           targetParserFunctionRow] ||
                   callManualTargetDeclarationRow !=
                       tables.parserSidecars.declarationSourceLocalRows[
                           targetParserParameterDeclaration] ||
                   callManualSourceDeclarationRow !=
                       tables.parserSidecars.declarationSourceLocalRows[
                           sourceParserParameterDeclaration] ||
                   tables.symbols.typeIds[targetParameterSymbolId] !=
                       newTypeIdByArenaTypeId[
                           callManualTargetTypeId] ||
                   tables.symbols.typeIds[sourceParameterSymbolId] !=
                       newTypeIdByArenaTypeId[
                           callManualSourceTypeId] ||
                   !layout.FixedBytes32Equal(
                       callManualEffectCid,
                       csg.typedIr.functions2_manualConsumeEffectCids[
                           tables.functions.typedFunctionIndexes[
                               targetFunctionId]]) ||
                   !compilerSnapshotBuilderCidObserved(
                       tables.functions.manualConsumeEffectCids[
                           targetFunctionId]):
                    err = " compiler snapshot builder: CallExpr manual consume producer drift"
                    return false
        if tables.typedNodes.typeIds[resultTypedNodeId] == -1:
            tables.typedNodes.typeIds[resultTypedNodeId] =
                resultTypeId
        if tables.typedNodes.valueKinds[resultTypedNodeId] == 0:
            tables.typedNodes.valueKinds[resultTypedNodeId] =
                snapshot_schema.CsgCompilerValueOrdinary
        if tables.typedNodes.ownershipProofKinds[resultTypedNodeId] == 0:
            tables.typedNodes.ownershipProofKinds[resultTypedNodeId] =
                snapshot_schema.CsgCompilerValueProofFlow
        if tables.typedNodes.typeIds[resultTypedNodeId] != resultTypeId ||
           tables.typedNodes.valueKinds[resultTypedNodeId] !=
               snapshot_schema.CsgCompilerValueOrdinary ||
           tables.typedNodes.ownershipKinds[resultTypedNodeId] !=
               resultOwnershipKind ||
           tables.typedNodes.ownershipProofKinds[resultTypedNodeId] !=
               snapshot_schema.CsgCompilerValueProofFlow:
            err = " compiler snapshot builder: resolved call result value-def drift"
            return false
        let resultValueDefinitionRow =
            tables.typedNodes.producedValueDefinitionRows[
                resultTypedNodeId]
        if resultValueDefinitionRow < 0 ||
           resultValueDefinitionRow >=
               tables.valueDefinitions.functionIds.len ||
           (tables.valueDefinitions.originKinds[
                resultValueDefinitionRow] !=
                snapshot_schema.CsgCompilerValueDefinitionOriginBindingInitializer &&
            tables.valueDefinitions.originKinds[
                resultValueDefinitionRow] !=
                snapshot_schema.CsgCompilerValueDefinitionOriginCallResult) ||
           tables.valueDefinitions.functionIds[
               resultValueDefinitionRow] != callerFunctionId ||
           tables.valueDefinitions.definingTypedNodeIds[
               resultValueDefinitionRow] != resultTypedNodeId:
            err = " compiler snapshot builder: resolved call result value-definition identity missing"
            return false
        add(rows, compilerSnapshotResolvedCallProjectionRow(
            sourceId: tables.symbols.sourceIds[
                tables.functions.symbolIds[callerFunctionId]],
            spanId: tables.typedNodes.spanIds[resultTypedNodeId],
            callerFunctionId: callerFunctionId,
            calleeSymbolId: calleeSymbolId,
            targetCallDeclarationRow: callDeclarationRow,
            targetSourceId: targetSourceId,
            targetSourceLocalDeclarationRow:
                targetParserLocalDeclaration,
            targetParserDeclarationRow:
                targetParserDeclaration,
            targetDeclId: targetDeclId,
            resultTypedNodeId: resultTypedNodeId,
            resultTypeId: resultTypeId,
            resultOwnershipKind: resultOwnershipKind
        ))
    if !compilerSnapshotResolvedCallProjectionRowsCanonicalizeInto(
           rows, err):
        return false
    for row in 0..<rows.len:
        let projected = rows[row]
        let ownerSymbolId =
            tables.functions.symbolIds[projected.callerFunctionId]
        add(tables.references.sourceIds, projected.sourceId)
        add(tables.references.spanIds, projected.spanId)
        add(tables.references.ownerFunctionIds,
            projected.callerFunctionId)
        add(tables.references.ownerSymbolIds, ownerSymbolId)
        add(tables.references.targetSymbolIds,
            projected.calleeSymbolId)
        add(tables.references.referenceKinds,
            snapshot_schema.CsgCompilerReferenceCall)
        add(tables.references.bindingTypedNodeIds, -1)
        add(tables.calls.callReferenceIds, row)
        add(tables.calls.callerFunctionIds,
            projected.callerFunctionId)
        add(tables.calls.calleeSymbolIds,
            projected.calleeSymbolId)
        add(tables.calls.targetCallDeclarationRows,
            projected.targetCallDeclarationRow)
        add(tables.calls.targetSourceIds,
            projected.targetSourceId)
        add(tables.calls.targetSourceLocalDeclarationRows,
            projected.targetSourceLocalDeclarationRow)
        add(tables.calls.targetParserDeclarationRows,
            projected.targetParserDeclarationRow)
        add(tables.calls.targetDeclIds, projected.targetDeclId)
        add(tables.calls.targetDeclKeyCids,
            tables.symbols.declKeyCids[
                projected.calleeSymbolId])
        add(tables.calls.targetSymbolCids,
            tables.symbols.symbolCids[
                projected.calleeSymbolId])
        add(tables.calls.resultTypedNodeIds,
            projected.resultTypedNodeId)
        add(tables.calls.resultValueDefinitionRows,
            tables.typedNodes.producedValueDefinitionRows[
                projected.resultTypedNodeId])
        add(tables.calls.resultTypeIds, projected.resultTypeId)
        add(tables.calls.resultOwnershipKinds,
            projected.resultOwnershipKind)
        add(tables.calls.resultOwnershipProofKinds,
            snapshot_schema.CsgCompilerValueProofFlow)
        add(tables.calls.resultOwnershipProofCids,
            layout.FixedBytes32())
    for row in 0..<tables.calls.callReferenceIds.len:
        var proofCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerCallResultOwnershipProofCidInto(
               tables, row, proofCid, err):
            return false
        tables.calls.resultOwnershipProofCids[row] = proofCid
    # Call projection emits Call refs only (bindingTypedNodeIds = -1).
    # Binding coverage is proven after BindingReferencesMergeInto.
    return compilerSnapshotBuilderReferenceRowsStrictValidateInto(
        tables, err)

@borrows
fn compilerSnapshotBuilderLayoutsProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        finalTypeIdByArenaTypeId: int32[],
        err: var str): bool =
    if tables.layouts.layoutCids.len != 0 ||
       tables.layouts.typeIds.len != 0 ||
       tables.layoutFields.layoutIds.len != 0 ||
       tables.layoutFields.fieldSymbolIds.len != 0:
        err = " compiler snapshot builder: layout projection destination is not empty"
        return false
    if csg.typeArena == nil ||
       finalTypeIdByArenaTypeId.len != csg.typeArena.typeCount:
        err = " compiler snapshot builder: layout TypeArena identity map missing"
        return false
    let producerSourceCount =
        csg.parserNormalizedExprReceipt.sourceSidecars.len
    if !texpr.TypedExprIrExactLayoutCoordinatesStrictValidateInto(
           csg.typedIr, producerSourceCount, err):
        return false
    var declarationStartsByProducer: int32[]
    setLen(declarationStartsByProducer, producerSourceCount + 1)
    for producer in 0..<producerSourceCount:
        let producerDeclarationCount =
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producer].declarationSourceLocalRows.len
        if declarationStartsByProducer[producer] >
               2147483647 - producerDeclarationCount:
            err = " compiler snapshot builder: layout declaration coordinate overflow"
            return false
        declarationStartsByProducer[producer + 1] =
            declarationStartsByProducer[producer] +
            producerDeclarationCount
    let declarationCount =
        tables.parserSidecars.declarationKinds.len
    if declarationStartsByProducer[producerSourceCount] !=
           declarationCount:
        err = " compiler snapshot builder: layout declaration domain mismatch"
        return false
    var declarationByProducerCoordinate: int32[]
    setLen(declarationByProducerCoordinate, declarationCount)
    for row in 0..<declarationCount:
        declarationByProducerCoordinate[row] = -1
    for declarationRow in 0..<declarationCount:
        let sourceId =
            tables.parserSidecars.declarationProducerSourceIds[
                declarationRow]
        if sourceId < 0 ||
           sourceId >=
               tables.parserSidecars.producerSourceIndexes.len:
            err = " compiler snapshot builder: layout declaration source missing"
            return false
        let producer =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        let sourceLocalRow =
            tables.parserSidecars.declarationSourceLocalRows[
                declarationRow]
        if producer < 0 || producer >= producerSourceCount ||
           sourceLocalRow < 0 ||
           sourceLocalRow >=
               declarationStartsByProducer[producer + 1] -
                   declarationStartsByProducer[producer]:
            err = " compiler snapshot builder: layout declaration coordinate invalid"
            return false
        let coordinate =
            declarationStartsByProducer[producer] +
            sourceLocalRow
        if declarationByProducerCoordinate[coordinate] >= 0:
            err = " compiler snapshot builder: duplicate layout declaration coordinate"
            return false
        declarationByProducerCoordinate[coordinate] =
            declarationRow
    for coordinate in 0..<declarationByProducerCoordinate.len:
        if declarationByProducerCoordinate[coordinate] < 0:
            err = " compiler snapshot builder: incomplete layout declaration coordinate"
            return false
    var declarationSymbolIdsByCoordinate: int32[]
    if !compilerSnapshotBuilderTypeSymbolCoordinateIndexBuildInto(
           tables, declarationSymbolIdsByCoordinate, err):
        return false
    var symbolByDeclaration: int32[]
    setLen(symbolByDeclaration, declarationCount)
    for declarationRow in 0..<declarationCount:
        symbolByDeclaration[declarationRow] = -1
        let declarationKind =
            tables.parserSidecars.declarationKinds[declarationRow]
        if declarationKind !=
               Int32(parser.ParserDeclarationType) &&
           declarationKind !=
               Int32(parser.ParserDeclarationField):
            continue
        let symbolId =
            compilerSnapshotBuilderTypeSymbolCoordinateFind(
                tables,
                declarationSymbolIdsByCoordinate,
                tables.parserSidecars.declarationProducerSourceIds[
                    declarationRow],
                tables.parserSidecars.declarationNameTokenIds[
                    declarationRow],
                tables.parserSidecars.declarationNameSpanIds[
                    declarationRow],
                tables.parserSidecars.declarationSpanIds[
                    declarationRow])
        if symbolId < 0:
            err = " compiler snapshot builder: layout declaration Symbol missing"
            return false
        symbolByDeclaration[declarationRow] = symbolId
    var exactLayoutRowByFinalTypeId: int32[]
    setLen(exactLayoutRowByFinalTypeId, tables.types.typeCids.len)
    for typeId in 0..<exactLayoutRowByFinalTypeId.len:
        exactLayoutRowByFinalTypeId[typeId] = -1
    if csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len !=
           csg.layoutDiagnosticCompletions.exactLayoutSizeBytes.len ||
       csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len !=
           csg.layoutDiagnosticCompletions.exactLayoutAlignBytes.len ||
       csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldCounts.len ||
       csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len !=
           csg.layoutDiagnosticCompletions.exactLayoutBuiltinKinds.len:
        err = " compiler snapshot builder: exact layout authority columns split"
        return false
    for exactLayoutRow in 0..<csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len:
        let arenaTypeId =
            csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[exactLayoutRow]
        if arenaTypeId < 0:
            continue
        if arenaTypeId >= finalTypeIdByArenaTypeId.len:
            err = " compiler snapshot builder: exact layout TypeArena row invalid"
            return false
        let arenaKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeKinds,
            arenaTypeId)
        # [phaseB-tuple-snap] A named tuple declaration's exact layout row
        # is keyed by the alias declaration's TypeArena row; its layout
        # authority projects onto the alias target tuple structure row.
        if arenaKind == Int32(typearena.TypedExprStructuralTypeAlias):
            let aliasChildStart = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childStarts,
                arenaTypeId)
            let aliasChildCount = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childCounts,
                arenaTypeId)
            if aliasChildCount != 1:
                continue
            let targetArenaTypeId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childTypeIds,
                aliasChildStart)
            if targetArenaTypeId < 0 ||
               targetArenaTypeId >= finalTypeIdByArenaTypeId.len:
                err = " compiler snapshot builder: exact layout alias target invalid"
                return false
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeKinds,
                   targetArenaTypeId) !=
                   Int32(typearena.TypedExprStructuralTypeTuple):
                continue
            let targetFinalTypeId =
                finalTypeIdByArenaTypeId[targetArenaTypeId]
            if targetFinalTypeId < 0 ||
               targetFinalTypeId >= exactLayoutRowByFinalTypeId.len ||
               exactLayoutRowByFinalTypeId[targetFinalTypeId] >= 0:
                err = " compiler snapshot builder: duplicate tuple layout authority"
                return false
            exactLayoutRowByFinalTypeId[targetFinalTypeId] =
                exactLayoutRow
            continue
        if arenaKind !=
               Int32(typearena.TypedExprStructuralTypeObject) &&
           arenaKind !=
               Int32(typearena.TypedExprStructuralTypeRefObject):
            continue
        let finalTypeId =
            finalTypeIdByArenaTypeId[arenaTypeId]
        if finalTypeId < 0 ||
           finalTypeId >= exactLayoutRowByFinalTypeId.len ||
           exactLayoutRowByFinalTypeId[finalTypeId] >= 0:
            err = " compiler snapshot builder: duplicate nominal layout authority"
            return false
        exactLayoutRowByFinalTypeId[finalTypeId] =
            exactLayoutRow
    var exactFieldRowByMemberRow: int32[]
    setLen(exactFieldRowByMemberRow, csg.typeArena.memberCount)
    for memberRow in 0..<exactFieldRowByMemberRow.len:
        exactFieldRowByMemberRow[memberRow] = -1
    if csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldOwnerTypeArenaIds.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldTypeArenaIds.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldOrdinals.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldProducerRowIds.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldSourceIds.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldDeclarationSourceLocalRows.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldOffsetBytes.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldSizeBytes.len ||
       csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len !=
           csg.layoutDiagnosticCompletions.exactLayoutFieldAlignBytes.len:
        err = " compiler snapshot builder: exact layout Field columns split"
        return false
    for exactFieldRow in 0..<csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows.len:
        let memberRow =
            csg.layoutDiagnosticCompletions.exactLayoutFieldMemberRows[exactFieldRow]
        if memberRow < 0:
            continue
        if memberRow >= exactFieldRowByMemberRow.len ||
           exactFieldRowByMemberRow[memberRow] >= 0:
            err = " compiler snapshot builder: duplicate exact layout member row"
            return false
        exactFieldRowByMemberRow[memberRow] = exactFieldRow
    for finalTypeId in 0..<tables.types.typeCids.len:
        let finalKind = tables.types.typeKinds[finalTypeId]
        if finalKind != snapshot_schema.CsgCompilerTypeObject &&
           finalKind != snapshot_schema.CsgCompilerTypeRefObject &&
           finalKind != snapshot_schema.CsgCompilerTypeTuple:
            continue
        let exactLayoutRow =
            exactLayoutRowByFinalTypeId[finalTypeId]
        if exactLayoutRow < 0:
            # [phaseB-tuple-snap] A tuple structure row without a named
            # declaration owns no exact layout authority; only the nominal
            # families are required to project a layout row.
            if finalKind != snapshot_schema.CsgCompilerTypeTuple:
                err = " compiler snapshot builder: nominal layout authority missing"
                return false
            continue
        # [phaseB-tuple-snap] The tuple projection's field owner Symbol is
        # the alias declaration's Type Symbol resolved below; the nominal
        # projection keeps its own declaring Symbol.
        var declaringSymbolId: int32 = -1
        if finalKind != snapshot_schema.CsgCompilerTypeTuple:
            let nominalSymbolId =
                tables.types.declSymbolIds[finalTypeId]
            if nominalSymbolId < 0 ||
               nominalSymbolId >= tables.symbols.typeIds.len ||
               tables.symbols.typeIds[nominalSymbolId] !=
                   finalTypeId:
                err = " compiler snapshot builder: nominal layout declaring Symbol drift"
                return false
            declaringSymbolId = nominalSymbolId
        else:
            let aliasArenaTypeId =
                csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[
                    exactLayoutRow]
            if aliasArenaTypeId < 0 ||
               aliasArenaTypeId >= finalTypeIdByArenaTypeId.len:
                err = " compiler snapshot builder: tuple layout alias row invalid"
                return false
            let aliasFinalTypeId =
                finalTypeIdByArenaTypeId[aliasArenaTypeId]
            if aliasFinalTypeId < 0 ||
               aliasFinalTypeId >= tables.types.declSymbolIds.len:
                err = " compiler snapshot builder: tuple layout alias row invalid"
                return false
            let aliasSymbolId =
                tables.types.declSymbolIds[aliasFinalTypeId]
            # [phaseB-tuple-snap] The alias Type Symbol's signature TypeId
            # is the alias target structure row itself
            # (AppendTypeSyntaxRootInto signature projection), so the
            # declaring-Symbol authority for the tuple layout joins on
            # finalTypeId, never on the alias wrapper row.
            if aliasSymbolId < 0 ||
               aliasSymbolId >= tables.symbols.typeIds.len ||
               tables.symbols.typeIds[aliasSymbolId] !=
                   finalTypeId:
                err = " compiler snapshot builder: tuple layout declaring Symbol drift"
                return false
            declaringSymbolId = aliasSymbolId
        let arenaTypeId =
            csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[exactLayoutRow]
        let arenaSymbolId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolIds,
            arenaTypeId)
        if arenaSymbolId < 0 ||
           arenaSymbolId >= csg.typeArena.symbolCount:
            err = " compiler snapshot builder: nominal layout TypeArena Symbol missing"
            return false
        let memberStart = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolMemberStarts,
            arenaSymbolId)
        let memberCount = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolMemberCounts,
            arenaSymbolId)
        if memberStart < 0 || memberCount < 0 ||
           memberStart > csg.typeArena.memberCount ||
           memberCount > csg.typeArena.memberCount - memberStart ||
           memberCount !=
               csg.layoutDiagnosticCompletions.exactLayoutFieldCounts[exactLayoutRow] ||
           memberCount !=
               tables.types.argCounts[finalTypeId]:
            err = " compiler snapshot builder: nominal layout Field coverage drift"
            return false
        let layoutId = tables.layouts.layoutCids.len
        add(tables.layouts.layoutCids, layout.FixedBytes32())
        add(tables.layouts.typeIds, finalTypeId)
        add(tables.layouts.sizeBytes,
            csg.layoutDiagnosticCompletions.exactLayoutSizeBytes[exactLayoutRow])
        add(tables.layouts.alignBytes,
            csg.layoutDiagnosticCompletions.exactLayoutAlignBytes[exactLayoutRow])
        add(tables.layouts.fieldStarts,
            tables.layoutFields.layoutIds.len)
        add(tables.layouts.fieldCounts, memberCount)
        for memberOffset in 0..<memberCount:
            let memberRow = memberStart + memberOffset
            let exactFieldRow =
                exactFieldRowByMemberRow[memberRow]
            if exactFieldRow < 0 ||
               csg.layoutDiagnosticCompletions.exactLayoutFieldOwnerTypeArenaIds[
                   exactFieldRow] != arenaTypeId ||
               csg.layoutDiagnosticCompletions.exactLayoutFieldOrdinals[
                   exactFieldRow] != memberOffset:
                err = " compiler snapshot builder: nominal layout exact Field missing"
                return false
            let producer =
                csg.layoutDiagnosticCompletions.exactLayoutFieldSourceIds[exactFieldRow]
            let sourceLocalDeclarationRow =
                csg.layoutDiagnosticCompletions.exactLayoutFieldDeclarationSourceLocalRows[
                    exactFieldRow]
            if producer < 0 || producer >= producerSourceCount ||
               sourceLocalDeclarationRow < 0 ||
               sourceLocalDeclarationRow >=
                   declarationStartsByProducer[producer + 1] -
                       declarationStartsByProducer[producer]:
                err = " compiler snapshot builder: layout Field declaration coordinate invalid"
                return false
            let fieldDeclarationRow =
                declarationByProducerCoordinate[
                    declarationStartsByProducer[producer] +
                    sourceLocalDeclarationRow]
            let fieldSymbolId =
                symbolByDeclaration[fieldDeclarationRow]
            let fieldArenaTypeId =
                csg.layoutDiagnosticCompletions.exactLayoutFieldTypeArenaIds[exactFieldRow]
            if fieldSymbolId < 0 ||
               tables.symbols.symbolKinds[fieldSymbolId] !=
                   snapshot_schema.CsgCompilerSymbolField ||
               tables.symbols.ownerSymbolIds[fieldSymbolId] !=
                   declaringSymbolId ||
               fieldArenaTypeId < 0 ||
               fieldArenaTypeId >=
                   finalTypeIdByArenaTypeId.len:
                err = " compiler snapshot builder: layout Field Symbol authority drift"
                return false
            let fieldTypeId =
                finalTypeIdByArenaTypeId[fieldArenaTypeId]
            if tables.symbols.typeIds[fieldSymbolId] !=
                   fieldTypeId:
                err = " compiler snapshot builder: layout Field TypeId drift"
                return false
            add(tables.layoutFields.layoutIds, layoutId)
            add(tables.layoutFields.fieldSymbolIds,
                fieldSymbolId)
            add(tables.layoutFields.typeIds, fieldTypeId)
            add(tables.layoutFields.offsetBytes,
                csg.layoutDiagnosticCompletions.exactLayoutFieldOffsetBytes[exactFieldRow])
            add(tables.layoutFields.sizeBytes,
                csg.layoutDiagnosticCompletions.exactLayoutFieldSizeBytes[exactFieldRow])
            add(tables.layoutFields.alignBytes,
                csg.layoutDiagnosticCompletions.exactLayoutFieldAlignBytes[exactFieldRow])
        var layoutCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerLayoutRowCidInto(
               tables, layoutId, layoutCid, err):
            return false
        tables.layouts.layoutCids[layoutId] =
            layoutCid
    return snapshot_schema.CsgCompilerSnapshotLayoutsStrictValidateInto(
        tables, err)

fn compilerSnapshotBuilderManualConsumeParameterSymbolInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        functionSymbolId: int32,
        parserDeclarationRow: int32,
        symbolIdOut: var int32,
        err: var str): bool =
    symbolIdOut = -1
    if parserDeclarationRow < 0 ||
       parserDeclarationRow >=
           tables.parserSidecars.declarationKinds.len ||
       tables.parserSidecars.declarationKinds[parserDeclarationRow] !=
           Int32(parser.ParserDeclarationParameter):
        err = " compiler snapshot builder: manual consume parser Parameter invalid"
        return false
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolParameter ||
           tables.symbols.ownerSymbolIds[symbolId] !=
               functionSymbolId ||
           tables.symbols.sourceIds[symbolId] !=
               tables.parserSidecars.declarationProducerSourceIds[
                   parserDeclarationRow] ||
           tables.symbols.nameTokenIds[symbolId] !=
               tables.parserSidecars.declarationNameTokenIds[
                   parserDeclarationRow] ||
           tables.symbols.nameSpanIds[symbolId] !=
               tables.parserSidecars.declarationNameSpanIds[
                   parserDeclarationRow] ||
           tables.symbols.declarationSpanIds[symbolId] !=
               tables.parserSidecars.declarationSpanIds[
                   parserDeclarationRow]:
            continue
        if symbolIdOut >= 0:
            err = " compiler snapshot builder: manual consume Parameter Symbol ambiguous"
            return false
        symbolIdOut = symbolId
    if symbolIdOut < 0:
        err = " compiler snapshot builder: manual consume Parameter Symbol missing"
        return false
    return true

@borrows
fn compilerSnapshotBuilderManualConsumeSealInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        newTypeIdByArenaTypeId: int32[],
        err: var str): bool =
    let functionCount = tables.functions.symbolIds.len
    if functionCount !=
           tables.functions.typedFunctionIndexes.len ||
       functionCount != tables.functions.bodySpanIds.len ||
       functionCount != tables.functions.annotationFlags.len ||
       functionCount !=
           tables.functions.manualConsumeTargetParameterSymbolIds.len ||
       functionCount !=
           tables.functions.manualConsumeSourceParameterSymbolIds.len ||
       functionCount !=
           tables.functions.manualConsumeEffectCids.len:
        err = " compiler snapshot builder: manual consume Function columns split"
        return false
    for functionId in 0..<functionCount:
        let typedFunctionIndex =
            tables.functions.typedFunctionIndexes[functionId]
        var parserFunctionRow: int32 = -1
        for row in 0..<tables.parserSidecars.functionIndexes.len:
            let parserFunctionId =
                tables.parserSidecars.functionIndexes[row]
            if parserFunctionId < 0 ||
               parserFunctionId >=
                   tables.functions.typedFunctionIndexes.len ||
               tables.functions.typedFunctionIndexes[
                   parserFunctionId] != typedFunctionIndex:
                continue
            if parserFunctionId != functionId:
                err = " compiler snapshot builder: manual consume Function identity crossed"
                return false
            if parserFunctionRow >= 0:
                err = " compiler snapshot builder: manual consume parser Function ambiguous"
                return false
            parserFunctionRow = row
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= functionCount ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumePresents.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeFunctionDeclarationRows.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeTargetParameterOrdinals.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeSourceParameterOrdinals.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeTargetParameterDeclarationRows.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeSourceParameterDeclarationRows.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeTargetTypeIds.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeSourceTypeIds.len ||
           typedFunctionIndex >=
               csg.typedIr.functions2_manualConsumeEffectCids.len ||
           parserFunctionRow < 0 ||
           parserFunctionRow >=
               tables.parserSidecars.functionBodySpanIds.len ||
           tables.parserSidecars.functionBodySpanIds[parserFunctionRow] !=
               tables.functions.bodySpanIds[functionId]:
            err = " compiler snapshot builder: manual consume Function producer join invalid"
            return false
        let parserPresent =
            (tables.parserSidecars.functionAnnotationFlags[
                 parserFunctionRow] &
             snapshot_schema.CsgCompilerFunctionAnnotationManualConsume) != 0
        let functionPresent =
            (tables.functions.annotationFlags[functionId] &
             snapshot_schema.CsgCompilerFunctionAnnotationManualConsume) != 0
        if parserPresent != functionPresent ||
           parserPresent !=
               csg.typedIr.functions2_manualConsumePresents[
                   typedFunctionIndex]:
            err = " compiler snapshot builder: manual consume presence producer drift"
            return false
        if !parserPresent:
            if tables.parserSidecars.functionManualConsumeTargetParameterOrdinals[
                   parserFunctionRow] != -1 ||
               tables.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
                   parserFunctionRow] != -1 ||
               tables.parserSidecars.functionManualConsumeSourceParameterOrdinals[
                   parserFunctionRow] != -1 ||
               tables.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
                   parserFunctionRow] != -1 ||
               csg.typedIr.functions2_manualConsumeFunctionDeclarationRows[
                   typedFunctionIndex] != -1 ||
               csg.typedIr.functions2_manualConsumeTargetParameterOrdinals[
                   typedFunctionIndex] != -1 ||
               csg.typedIr.functions2_manualConsumeSourceParameterOrdinals[
                   typedFunctionIndex] != -1 ||
               csg.typedIr.functions2_manualConsumeTargetParameterDeclarationRows[
                   typedFunctionIndex] != -1 ||
               csg.typedIr.functions2_manualConsumeSourceParameterDeclarationRows[
                   typedFunctionIndex] != -1 ||
               csg.typedIr.functions2_manualConsumeTargetTypeIds[
                   typedFunctionIndex] != -1 ||
               csg.typedIr.functions2_manualConsumeSourceTypeIds[
                   typedFunctionIndex] != -1 ||
               compilerSnapshotBuilderCidObserved(
                   csg.typedIr.functions2_manualConsumeEffectCids[
                       typedFunctionIndex]):
                err = " compiler snapshot builder: absent manual consume producer relation invalid"
                return false
            continue
        let targetOrdinal =
            tables.parserSidecars.functionManualConsumeTargetParameterOrdinals[
                parserFunctionRow]
        let sourceOrdinal =
            tables.parserSidecars.functionManualConsumeSourceParameterOrdinals[
                parserFunctionRow]
        let targetParserDeclaration =
            tables.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
                parserFunctionRow]
        let sourceParserDeclaration =
            tables.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
                parserFunctionRow]
        var functionParserDeclaration: int32 = -1
        for declarationRow in 0..<
                tables.parserSidecars.declarationKinds.len:
            if tables.parserSidecars.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction) ||
               tables.parserSidecars.declarationSpanIds[declarationRow] !=
                   tables.parserSidecars.functionDeclarationSpanIds[
                       parserFunctionRow] ||
               tables.parserSidecars.declarationNameSpanIds[declarationRow] !=
                   tables.parserSidecars.functionNameSpanIds[
                       parserFunctionRow]:
                continue
            if functionParserDeclaration >= 0:
                err = " compiler snapshot builder: manual consume function Declaration ambiguous"
                return false
            functionParserDeclaration = declarationRow
        if functionParserDeclaration < 0 ||
           tables.parserSidecars.declarationSourceLocalRows[
               functionParserDeclaration] !=
               csg.typedIr.functions2_manualConsumeFunctionDeclarationRows[
                   typedFunctionIndex]:
            err = " compiler snapshot builder: manual consume function Declaration producer drift"
            return false
        let functionSymbolId = tables.functions.symbolIds[functionId]
        var targetSymbolId: int32
        var sourceSymbolId: int32
        if !compilerSnapshotBuilderManualConsumeParameterSymbolInto(
               tables, functionSymbolId, targetParserDeclaration,
               targetSymbolId, err) ||
           !compilerSnapshotBuilderManualConsumeParameterSymbolInto(
               tables, functionSymbolId, sourceParserDeclaration,
               sourceSymbolId, err):
            return false
        let targetArenaTypeId =
            csg.typedIr.functions2_manualConsumeTargetTypeIds[
                typedFunctionIndex]
        let sourceArenaTypeId =
            csg.typedIr.functions2_manualConsumeSourceTypeIds[
                typedFunctionIndex]
        if targetSymbolId == sourceSymbolId ||
           targetArenaTypeId < 0 ||
           targetArenaTypeId >= newTypeIdByArenaTypeId.len ||
           sourceArenaTypeId < 0 ||
           sourceArenaTypeId >= newTypeIdByArenaTypeId.len ||
           tables.symbols.typeIds[targetSymbolId] !=
               newTypeIdByArenaTypeId[targetArenaTypeId] ||
           tables.symbols.typeIds[sourceSymbolId] !=
               newTypeIdByArenaTypeId[sourceArenaTypeId] ||
           targetOrdinal !=
               csg.typedIr.functions2_manualConsumeTargetParameterOrdinals[
                   typedFunctionIndex] ||
           sourceOrdinal !=
               csg.typedIr.functions2_manualConsumeSourceParameterOrdinals[
                   typedFunctionIndex] ||
           tables.parserSidecars.declarationSourceLocalRows[
               targetParserDeclaration] !=
               csg.typedIr.functions2_manualConsumeTargetParameterDeclarationRows[
                   typedFunctionIndex] ||
           tables.parserSidecars.declarationSourceLocalRows[
               sourceParserDeclaration] !=
               csg.typedIr.functions2_manualConsumeSourceParameterDeclarationRows[
                   typedFunctionIndex] ||
           !compilerSnapshotBuilderCidObserved(
               csg.typedIr.functions2_manualConsumeEffectCids[
                   typedFunctionIndex]):
            err = " compiler snapshot builder: manual consume TypedExpr producer drift"
            return false
        tables.functions.manualConsumeTargetParameterSymbolIds[
            functionId] = targetSymbolId
        tables.functions.manualConsumeSourceParameterSymbolIds[
            functionId] = sourceSymbolId
        var effectCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               tables, functionId, effectCid, err):
            return false
        tables.functions.manualConsumeEffectCids[functionId] =
            effectCid
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderExternFfiHandleTableEqual(
        left: snapshot_schema.CsgCompilerExternFfiHandleContractTable,
        right: snapshot_schema.CsgCompilerExternFfiHandleContractTable): bool =
    if left.externSymbolIds.len != right.externSymbolIds.len ||
       left.effectKinds.len != right.effectKinds.len ||
       left.externSymbolIds.len != left.functionSymbolCids.len ||
       left.externSymbolIds.len != left.parserProvenanceCids.len ||
       left.externSymbolIds.len != left.unwindKinds.len ||
       left.externSymbolIds.len != left.effectStarts.len ||
       left.externSymbolIds.len != left.effectCounts.len ||
       left.externSymbolIds.len != left.contractCids.len ||
       left.externSymbolIds.len != left.interfaceCids.len ||
       right.externSymbolIds.len != right.functionSymbolCids.len ||
       right.externSymbolIds.len != right.parserProvenanceCids.len ||
       right.externSymbolIds.len != right.unwindKinds.len ||
       right.externSymbolIds.len != right.effectStarts.len ||
       right.externSymbolIds.len != right.effectCounts.len ||
       right.externSymbolIds.len != right.contractCids.len ||
       right.externSymbolIds.len != right.interfaceCids.len ||
       left.effectKinds.len != left.effectContractRows.len ||
       left.effectKinds.len != left.effectTargetKinds.len ||
       left.effectKinds.len != left.effectParameterOrdinals.len ||
       left.effectKinds.len != left.effectParameterSymbolCids.len ||
       left.effectKinds.len != left.effectTypeCids.len ||
       left.effectKinds.len != left.effectAbiCarrierKinds.len ||
       left.effectKinds.len != left.effectCids.len ||
       right.effectKinds.len != right.effectContractRows.len ||
       right.effectKinds.len != right.effectTargetKinds.len ||
       right.effectKinds.len != right.effectParameterOrdinals.len ||
       right.effectKinds.len != right.effectParameterSymbolCids.len ||
       right.effectKinds.len != right.effectTypeCids.len ||
       right.effectKinds.len != right.effectAbiCarrierKinds.len ||
       right.effectKinds.len != right.effectCids.len ||
       !layout.FixedBytes32Equal(left.cargoCid, right.cargoCid):
        return false
    for contractRow in 0..<left.externSymbolIds.len:
        if left.externSymbolIds[contractRow] !=
               right.externSymbolIds[contractRow] ||
           left.effectStarts[contractRow] !=
               right.effectStarts[contractRow] ||
           left.unwindKinds[contractRow] !=
               right.unwindKinds[contractRow] ||
           left.effectCounts[contractRow] !=
               right.effectCounts[contractRow] ||
           !layout.FixedBytes32Equal(
               left.functionSymbolCids[contractRow],
               right.functionSymbolCids[contractRow]) ||
           !layout.FixedBytes32Equal(
               left.parserProvenanceCids[contractRow],
               right.parserProvenanceCids[contractRow]) ||
           !layout.FixedBytes32Equal(
               left.contractCids[contractRow],
               right.contractCids[contractRow]) ||
           !layout.FixedBytes32Equal(
               left.interfaceCids[contractRow],
               right.interfaceCids[contractRow]):
            return false
    for effectRow in 0..<left.effectKinds.len:
        if left.effectContractRows[effectRow] !=
               right.effectContractRows[effectRow] ||
           left.effectKinds[effectRow] != right.effectKinds[effectRow] ||
           left.effectTargetKinds[effectRow] !=
               right.effectTargetKinds[effectRow] ||
           left.effectParameterOrdinals[effectRow] !=
               right.effectParameterOrdinals[effectRow] ||
           left.effectAbiCarrierKinds[effectRow] !=
               right.effectAbiCarrierKinds[effectRow] ||
           !layout.FixedBytes32Equal(
               left.effectParameterSymbolCids[effectRow],
               right.effectParameterSymbolCids[effectRow]) ||
           !layout.FixedBytes32Equal(
               left.effectTypeCids[effectRow],
               right.effectTypeCids[effectRow]) ||
           !layout.FixedBytes32Equal(
               left.effectCids[effectRow],
               right.effectCids[effectRow]):
            return false
    return true

fn compilerSnapshotBuilderExternFfiHandleSnapshotTypeIdInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        producerTypeArenaId: int32,
        carrierKind: int32,
        out: var int32,
        err: var str): bool =
    out = -1
    var matchCount: int32
    for typeId in 0..<tables.types.producerTypeArenaIds.len:
        if tables.types.producerTypeArenaIds[typeId] == producerTypeArenaId:
            out = typeId
            matchCount = matchCount + 1
    let expectedScalarKind =
        carrierKind == snapshot_schema.CsgCompilerExternFfiHandleAbiCarrierUInt32 ?
            snapshot_schema.CsgCompilerScalarUInt32 :
        carrierKind == snapshot_schema.CsgCompilerExternFfiHandleAbiCarrierUInt64 ?
            snapshot_schema.CsgCompilerScalarUInt64 : 0
    if matchCount != 1 || out < 0 ||
       out >= tables.types.typeKinds.len ||
       out >= tables.types.scalarKinds.len ||
       tables.types.typeKinds[out] != snapshot_schema.CsgCompilerTypeScalar ||
       tables.types.scalarKinds[out] != expectedScalarKind:
        err = " compiler snapshot builder: ffi handle exact scalar TypeId join failed"
        return false
    err = ""
    return true

fn compilerSnapshotBuilderExternFfiHandleParameterStrictValidateInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        externSymbolId: int32,
        canonicalSourceId: int32,
        declarationSourceLocalRow: int32,
        parameterOrdinal: int32,
        parameterTypeId: int32,
        err: var str): bool =
    var parserDeclarationRow: int32 = -1
    for candidateRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        if tables.parserSidecars.declarationProducerSourceIds[
               candidateRow] == canonicalSourceId &&
           tables.parserSidecars.declarationSourceLocalRows[
               candidateRow] == declarationSourceLocalRow:
            if parserDeclarationRow >= 0:
                err = " compiler snapshot builder: ffi handle parameter parser row ambiguous"
                return false
            parserDeclarationRow = candidateRow
    if parserDeclarationRow < 0 ||
       tables.parserSidecars.declarationKinds[parserDeclarationRow] !=
           Int32(parser.ParserDeclarationParameter):
        err = " compiler snapshot builder: ffi handle parameter parser row missing"
        return false
    let parameterNameTokenId =
        tables.parserSidecars.declarationNameTokenIds[
            parserDeclarationRow]
    var parameterSymbolId: int32 = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] ==
               snapshot_schema.CsgCompilerSymbolParameter &&
           tables.symbols.ownerSymbolIds[symbolId] == externSymbolId &&
           tables.symbols.nameTokenIds[symbolId] == parameterNameTokenId:
            if parameterSymbolId >= 0:
                err = " compiler snapshot builder: ffi handle parameter Symbol authority ambiguous"
                return false
            parameterSymbolId = symbolId
    if parameterSymbolId < 0 ||
       tables.symbols.typeIds[parameterSymbolId] != parameterTypeId:
        err = " compiler snapshot builder: ffi handle parameter Symbol/Type join failed"
        return false
    let externFunctionId =
        tables.symbols.externFunctionIds[externSymbolId]
    let functionTypeId =
        tables.externFunctions.typeIds[externFunctionId]
    if functionTypeId < 0 ||
       functionTypeId >= tables.types.typeKinds.len ||
       functionTypeId >= tables.types.argStarts.len ||
       functionTypeId >= tables.types.argCounts.len ||
       tables.types.typeKinds[functionTypeId] !=
           snapshot_schema.CsgCompilerTypeFunction ||
       parameterOrdinal < 0 ||
       parameterOrdinal >= tables.types.argCounts[functionTypeId] ||
       tables.types.argTypeIds[
           tables.types.argStarts[functionTypeId] + parameterOrdinal] !=
           parameterTypeId:
        err = " compiler snapshot builder: ffi handle parameter ordinal TypeId drift"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderExternFfiHandleContractsProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let emptyTable = snapshot_schema.CsgCompilerExternFfiHandleContractTable()
    if !compilerSnapshotBuilderExternFfiHandleTableEqual(
           tables.externFfiHandleContracts, emptyTable) ||
       !ccsg.CompilerCsgExternFfiHandleContractsStrictValidateInto(
           csg, err):
        if err == "":
            err = " compiler snapshot builder: ffi handle destination is not empty"
        return false
    let contractCount =
        csg.externFfiHandleContracts.functionSymbolIds.len
    var externSymbolByContract: int32[]
    var canonicalSourceByContract: int32[]
    setLen(externSymbolByContract, contractCount)
    setLen(canonicalSourceByContract, contractCount)
    for contractRow in 0..<contractCount:
        externSymbolByContract[contractRow] = -1
        canonicalSourceByContract[contractRow] = -1
        let producerSourceId =
            csg.externFfiHandleContracts.producerSourceIds[contractRow]
        let declarationSourceLocalRow =
            csg.externFfiHandleContracts.functionDeclarationSourceLocalRows[
                contractRow]
        let canonicalSourceId =
            compilerSnapshotBuilderCanonicalSourceForProducer(
                tables, producerSourceId)
        let graphNodeId =
            csg.externFfiHandleContracts.functionSymbolIds[contractRow]
        var graphNodeIndex: int32 = -1
        for nodeIndex in 0..<csg.nodes.len:
            if csg.nodes[nodeIndex].nodeId == graphNodeId:
                if graphNodeIndex >= 0:
                    err = " compiler snapshot builder: ffi handle graph Symbol ambiguous"
                    return false
                graphNodeIndex = nodeIndex
        if canonicalSourceId < 0 || graphNodeIndex < 0 ||
           csg.nodes[graphNodeIndex].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol ||
           csg.nodes[graphNodeIndex].producerSourceIndex !=
               producerSourceId ||
           csg.nodes[graphNodeIndex].producerDeclarationIndex !=
               declarationSourceLocalRow ||
           csg.nodes[graphNodeIndex].semanticSource !=
               snapshot_schema.CsgCompilerExternFfiHandleSchemaIdentity ||
           !layout.FixedBytes32Equal(
               csg.nodes[graphNodeIndex].nameProofCid,
               csg.externFfiHandleContracts.functionSymbolCids[
                   contractRow]):
            err = " compiler snapshot builder: ffi handle exact graph Symbol join failed"
            return false
        var externFunctionId: int32 = -1
        for candidateExternFunctionId in 0..<
                tables.externFunctions.symbolIds.len:
            let parserDeclarationRow =
                tables.externFunctions.parserDeclarationRows[
                    candidateExternFunctionId]
            if parserDeclarationRow >= 0 &&
               parserDeclarationRow <
                   tables.parserSidecars.declarationKinds.len &&
               tables.parserSidecars.declarationProducerSourceIds[
                   parserDeclarationRow] == canonicalSourceId &&
               tables.parserSidecars.declarationSourceLocalRows[
                   parserDeclarationRow] == declarationSourceLocalRow:
                if externFunctionId >= 0:
                    err = " compiler snapshot builder: ffi handle extern declaration ambiguous"
                    return false
                externFunctionId = candidateExternFunctionId
        if externFunctionId < 0:
            err = " compiler snapshot builder: ffi handle annotated extern missing"
            return false
        let externSymbolId =
            tables.externFunctions.symbolIds[externFunctionId]
        if externSymbolId < 0 ||
           externSymbolId >= tables.symbols.symbolCids.len ||
           tables.symbols.sourceIds[externSymbolId] != canonicalSourceId ||
           tables.symbols.functionIds[externSymbolId] != -1 ||
           tables.symbols.externFunctionIds[externSymbolId] !=
               externFunctionId:
            err = " compiler snapshot builder: ffi handle snapshot extern Symbol join failed"
            return false
        for previousRow in 0..<contractRow:
            if externSymbolByContract[previousRow] == externSymbolId:
                err = " compiler snapshot builder: duplicate ffi handle snapshot contract"
                return false
        externSymbolByContract[contractRow] = externSymbolId
        canonicalSourceByContract[contractRow] = canonicalSourceId
    var order: int32[]
    setLen(order, contractCount)
    for contractRow in 0..<contractCount:
        order[contractRow] = contractRow
    for row in 1..<order.len:
        let contractRow = order[row]
        var cursor = row
        while cursor > 0 &&
              externSymbolByContract[contractRow] <
                  externSymbolByContract[order[cursor - 1]]:
            order[cursor] = order[cursor - 1]
            cursor = cursor - 1
        order[cursor] = contractRow
    var candidate: snapshot_schema.CsgCompilerExternFfiHandleContractTable
    for canonicalContractRow in 0..<order.len:
        let contractRow = order[canonicalContractRow]
        let sourceRow = contractRow
        let externSymbolId = externSymbolByContract[contractRow]
        let externFunctionId =
            tables.symbols.externFunctionIds[externSymbolId]
        let functionTypeId =
            tables.externFunctions.typeIds[externFunctionId]
        add(candidate.externSymbolIds, externSymbolId)
        add(candidate.functionSymbolCids,
            csg.externFfiHandleContracts.functionSymbolCids[contractRow])
        add(candidate.parserProvenanceCids,
            csg.externFfiHandleContracts.parserContractCids[contractRow])
        add(candidate.unwindKinds,
            csg.externFfiHandleContracts.unwindKinds[sourceRow])
        add(candidate.effectStarts, candidate.effectKinds.len)
        add(candidate.effectCounts,
            csg.externFfiHandleContracts.effectCounts[contractRow])
        add(candidate.contractCids,
            csg.externFfiHandleContracts.contractCids[contractRow])
        add(candidate.interfaceCids,
            csg.externFfiHandleContracts.interfaceCids[contractRow])
        let effectStart =
            csg.externFfiHandleContracts.effectStarts[contractRow]
        let rowEffectCount =
            csg.externFfiHandleContracts.effectCounts[contractRow]
        for effectOffset in 0..<rowEffectCount:
            let effectRow = effectStart + effectOffset
            let targetKind =
                csg.externFfiHandleContracts.effectTargetKinds[effectRow]
            let parameterOrdinal =
                csg.externFfiHandleContracts.effectParameterOrdinals[
                    effectRow]
            let producerTypeArenaId =
                csg.externFfiHandleContracts.effectTypeIds[effectRow]
            let carrierKind =
                csg.externFfiHandleContracts.effectAbiCarrierKinds[
                    effectRow]
            var snapshotTypeId: int32
            if !compilerSnapshotBuilderExternFfiHandleSnapshotTypeIdInto(
                   tables, producerTypeArenaId, carrierKind,
                   snapshotTypeId, err):
                return false
            if targetKind ==
                   snapshot_schema.CsgCompilerExternFfiHandleTargetResult:
                if functionTypeId < 0 ||
                   functionTypeId >= tables.types.elementTypeIds.len ||
                   tables.types.elementTypeIds[functionTypeId] !=
                       snapshotTypeId:
                    err = " compiler snapshot builder: ffi handle result TypeId drift"
                    return false
            elif targetKind ==
                     snapshot_schema.CsgCompilerExternFfiHandleTargetParameter:
                if !compilerSnapshotBuilderExternFfiHandleParameterStrictValidateInto(
                       tables,
                       externSymbolId,
                       canonicalSourceByContract[contractRow],
                       csg.externFfiHandleContracts.effectParameterDeclarationSourceLocalRows[
                           effectRow],
                       parameterOrdinal,
                       snapshotTypeId,
                       err):
                    return false
            else:
                err = " compiler snapshot builder: ffi handle target kind invalid"
                return false
            add(candidate.effectContractRows, canonicalContractRow)
            add(candidate.effectKinds,
                csg.externFfiHandleContracts.effectKinds[effectRow])
            add(candidate.effectTargetKinds, targetKind)
            add(candidate.effectParameterOrdinals, parameterOrdinal)
            add(candidate.effectParameterSymbolCids,
                csg.externFfiHandleContracts.effectParameterSymbolCids[
                    effectRow])
            add(candidate.effectTypeCids,
                csg.externFfiHandleContracts.effectTypeCids[effectRow])
            add(candidate.effectAbiCarrierKinds, carrierKind)
            add(candidate.effectCids,
                csg.externFfiHandleContracts.effectCids[effectRow])
    candidate.cargoCid =
        snapshot_schema.CsgCompilerExternFfiHandleCargoCid(candidate)
    if !layout.FixedBytes32Equal(
           candidate.cargoCid,
           csg.externFfiHandleContracts.cargoCid):
        err = " compiler snapshot builder: ffi handle portable cargo CID split"
        return false
    tables.externFfiHandleContracts = candidate
    if !snapshot_schema.CsgCompilerExternFfiHandleContractsStrictValidateInto(
           tables, err):
        snapshot_schema.CsgCompilerExternFfiHandleContractTableRelease(
            tables.externFfiHandleContracts)
        return false
    err = ""
    return true

fn compilerSnapshotBuilderExternFfiHandleContractsStrictValidateInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        err: var str): bool =
    if !snapshot_schema.CsgCompilerExternFfiHandleContractsStrictValidateInto(
           tables, err):
        return false
    if tables.externFfiHandleContracts.unwindKinds.len !=
           csg.externFfiHandleContracts.unwindKinds.len:
        err =
            " compiler snapshot builder: ffi handle unwind shape drift"
        return false
    var replay = snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    replay.externFfiHandleContracts =
        snapshot_schema.CsgCompilerExternFfiHandleContractTable()
    if !compilerSnapshotBuilderExternFfiHandleContractsProjectInto(
           replay, csg, err):
        snapshot_schema.CsgCompilerSnapshotTablesRelease(replay)
        return false
    if !compilerSnapshotBuilderExternFfiHandleTableEqual(
           tables.externFfiHandleContracts,
           replay.externFfiHandleContracts):
        snapshot_schema.CsgCompilerSnapshotTablesRelease(replay)
        err = " compiler snapshot builder: ffi handle portable replay drift"
        return false
    snapshot_schema.CsgCompilerSnapshotTablesRelease(replay)
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeFunctionProjectValidatedInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        unsealedProductionBase: bool,
        err: var str): bool =
    let sidecars = csg.parserNormalizedExprReceipt.sourceSidecars
    if tables.types.typeCids.len != 0 ||
       (!unsealedProductionBase &&
        !snapshot_schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
            tables, err)):
        if err == "":
            err = " compiler snapshot builder: type projection destination is not empty"
        return false
    if unsealedProductionBase &&
       !compilerSnapshotProductionUnsealedBaseStrictValidateInto(
            tables, csg, err):
        return false
    var returnArenaTypeIds: int32[]
    var paramStarts: int32[]
    var paramCounts: int32[]
    var paramArenaTypeIds: int32[]
    var paramOwnershipKinds: int32[]
    if !compilerSnapshotBuilderTypeFunctionBindingsInto(
           tables, csg, returnArenaTypeIds,
           paramStarts, paramCounts, paramArenaTypeIds,
           paramOwnershipKinds, err):
        return false
    var externReturnArenaTypeIds: int32[]
    var externParamStarts: int32[]
    var externParamCounts: int32[]
    var externParamArenaTypeIds: int32[]
    if !compilerSnapshotBuilderTypeExternBindingsInto(
           tables, csg,
           externReturnArenaTypeIds,
           externParamStarts,
           externParamCounts,
           externParamArenaTypeIds,
           err):
        return false
    if tables.functions.parameterOwnershipKinds.len != 0:
        err = " compiler snapshot builder: function ownership destination is not empty"
        return false
    for functionId in 0..<tables.functions.symbolIds.len:
        if tables.functions.parameterOwnershipCounts[functionId] != 0:
            err = " compiler snapshot builder: function ownership destination was prefilled"
            return false
        tables.functions.parameterOwnershipStarts[functionId] =
            tables.functions.parameterOwnershipKinds.len
        tables.functions.parameterOwnershipCounts[functionId] =
            paramCounts[functionId]
        for offset in 0..<paramCounts[functionId]:
            add(tables.functions.parameterOwnershipKinds,
                paramOwnershipKinds[
                    paramStarts[functionId] + offset])
    var declarationArenaTypeIds: int32[]
    var declarationArenaTypeSyntaxRows: int32[]
    if !compilerSnapshotBuilderDeclarationArenaTypeIdsInto(
           tables, sidecars, csg, declarationArenaTypeIds,
           declarationArenaTypeSyntaxRows, err):
        return false
    var oldSymbolIdsByCid: int32[]
    if !unsealedProductionBase &&
       !compilerSnapshotBuilderOldSymbolCidIndexBuildInto(
           tables.symbols.symbolCids, oldSymbolIdsByCid, err):
        return false
    var declarationRowByOldSymbol: int32[]
    var typeSymbolIdByArenaTypeId: int32[]
    if !compilerSnapshotBuilderAppendTypeSymbolsInto(
           tables, sidecars, csg,
           declarationArenaTypeIds,
           declarationArenaTypeSyntaxRows,
           declarationRowByOldSymbol,
           typeSymbolIdByArenaTypeId,
           err):
        return false
    var parserGenericRowByArenaTypeId: int32[]
    if !compilerSnapshotBuilderAppendGenericParameterSymbolsInto(
           tables, sidecars, csg,
           declarationRowByOldSymbol,
           parserGenericRowByArenaTypeId, err):
        return false
    if !compilerSnapshotBuilderAppendParameterSymbolsInto(
           tables,
           declarationArenaTypeIds,
           paramStarts,
           paramCounts,
           paramArenaTypeIds,
           externParamStarts,
           externParamCounts,
           externParamArenaTypeIds,
           declarationRowByOldSymbol,
           err):
        return false
    var arenaTypeTexts: str[]
    if !compilerSnapshotBuilderArenaTypeTextsInto(
           csg, arenaTypeTexts, err):
        return false
    var generatedTexts: str[]
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        add(generatedTexts, share(arenaTypeTexts[arenaTypeId]))
        let childStart = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childStarts,
            arenaTypeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.childCounts,
            arenaTypeId)
        for offset in 0..<childCount:
            let childNameId = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.childNameIds,
                childStart + offset)
            if childNameId >= 0:
                let childNameResult = langintern.LookupIntern(
                    csg.typeArena.internPool, childNameId)
                if !IsOk(childNameResult) ||
                   Value(childNameResult) == "":
                    err = " compiler snapshot builder: tuple field name authority missing"
                    return false
                add(generatedTexts, Value(childNameResult))
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let symbolKind = tables.symbols.symbolKinds[symbolId]
        if symbolKind == snapshot_schema.CsgCompilerSymbolType:
            let sourceId = tables.symbols.sourceIds[symbolId]
            add(generatedTexts, strutil.Join([
                share(tables.texts[
                    tables.sources.modulePathTextIds[sourceId]]),
                "::",
                share(tables.texts[tables.symbols.nameTextIds[symbolId]])
            ], ""))
        elif symbolKind == snapshot_schema.CsgCompilerSymbolField:
            var qualifiedName: str
            if !compilerSnapshotBuilderDeclarationSymbolQualifiedNameInto(
                   tables, symbolId, qualifiedName, err):
                return false
            add(generatedTexts, qualifiedName)
        elif symbolKind ==
                 snapshot_schema.CsgCompilerSymbolGenericParameter:
            let sourceId = tables.symbols.sourceIds[symbolId]
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.symbolCids.len:
                err = " compiler snapshot builder: generic qualified owner missing"
                return false
            add(generatedTexts, strutil.Join([
                share(tables.texts[
                    tables.sources.modulePathTextIds[sourceId]]),
                "::",
                share(tables.texts[
                    tables.symbols.nameTextIds[ownerSymbolId]]),
                ".",
                share(tables.texts[tables.symbols.nameTextIds[symbolId]])
            ], ""))
        elif symbolKind == snapshot_schema.CsgCompilerSymbolParameter:
            let sourceId = tables.symbols.sourceIds[symbolId]
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.symbolCids.len ||
               tables.symbols.symbolKinds[ownerSymbolId] !=
                   snapshot_schema.CsgCompilerSymbolFunction:
                err = " compiler snapshot builder: parameter qualified owner missing"
                return false
            add(generatedTexts, strutil.Join([
                share(tables.texts[
                    tables.sources.modulePathTextIds[sourceId]]),
                "::",
                share(tables.texts[
                    tables.symbols.nameTextIds[ownerSymbolId]]),
                ".",
                share(tables.texts[tables.symbols.nameTextIds[symbolId]])
            ], ""))
    var signatureRepresentativeFunctions: int32[]
    var signatureOldTypeByFunction: int32[]
    var signatureTextByFunction: str[]
    for functionId in 0..<tables.functions.symbolIds.len:
        var representative: int32 = -1
        for row in 0..<signatureRepresentativeFunctions.len:
            let previousFunction = signatureRepresentativeFunctions[row]
            if compilerSnapshotBuilderFunctionSignatureEqual(
                   functionId, previousFunction,
                   returnArenaTypeIds, paramStarts, paramCounts,
                   paramArenaTypeIds):
                representative = row
                break
        if representative < 0:
            representative = signatureRepresentativeFunctions.len
            add(signatureRepresentativeFunctions, functionId)
        add(signatureOldTypeByFunction,
            csg.typeArena.typeCount + representative)
        var parts: str[]
        add(parts, "fn(")
        for offset in 0..<paramCounts[functionId]:
            if offset > 0:
                add(parts, ",")
            let arenaTypeId = paramArenaTypeIds[
                paramStarts[functionId] + offset]
            add(parts, share(arenaTypeTexts[arenaTypeId]))
        add(parts, "):")
        add(parts, share(arenaTypeTexts[returnArenaTypeIds[functionId]]))
        let signatureText = strutil.Join(parts, "")
        add(signatureTextByFunction, share(signatureText))
        add(generatedTexts, signatureText)
    var signatureRepresentativeExternFunctions: int32[]
    var signatureOldTypeByExternFunction: int32[]
    var signatureTextByExternFunction: str[]
    for externFunctionId in 0..<
            tables.externFunctions.symbolIds.len:
        var oldTypeId: int32 = -1
        for representativeRow in 0..<
                signatureRepresentativeFunctions.len:
            let functionId =
                signatureRepresentativeFunctions[
                    representativeRow]
            if returnArenaTypeIds[functionId] !=
                   externReturnArenaTypeIds[externFunctionId] ||
               paramCounts[functionId] !=
                   externParamCounts[externFunctionId]:
                continue
            var equal = true
            for offset in 0..<paramCounts[functionId]:
                if paramArenaTypeIds[
                       paramStarts[functionId] + offset] !=
                       externParamArenaTypeIds[
                           externParamStarts[externFunctionId] +
                               offset]:
                    equal = false
                    break
            if equal:
                oldTypeId =
                    csg.typeArena.typeCount +
                        representativeRow
                break
        if oldTypeId < 0:
            var externRepresentativeRow: int32 = -1
            for row in 0..<
                    signatureRepresentativeExternFunctions.len:
                let previousExternFunctionId =
                    signatureRepresentativeExternFunctions[row]
                if compilerSnapshotBuilderFunctionSignatureEqual(
                       externFunctionId,
                       previousExternFunctionId,
                       externReturnArenaTypeIds,
                       externParamStarts,
                       externParamCounts,
                       externParamArenaTypeIds):
                    externRepresentativeRow = row
                    break
            if externRepresentativeRow < 0:
                externRepresentativeRow =
                    signatureRepresentativeExternFunctions.len
                add(signatureRepresentativeExternFunctions,
                    externFunctionId)
            oldTypeId =
                csg.typeArena.typeCount +
                    signatureRepresentativeFunctions.len +
                    externRepresentativeRow
        add(signatureOldTypeByExternFunction, oldTypeId)
        var parts: str[]
        add(parts, "fn(")
        for offset in 0..<externParamCounts[externFunctionId]:
            if offset > 0:
                add(parts, ",")
            add(parts, share(arenaTypeTexts[
                externParamArenaTypeIds[
                    externParamStarts[externFunctionId] +
                        offset]]))
        add(parts, "):")
        add(parts, share(arenaTypeTexts[
            externReturnArenaTypeIds[externFunctionId]]))
        let signatureText = strutil.Join(parts, "")
        add(signatureTextByExternFunction, share(signatureText))
        add(generatedTexts, signatureText)
    if !compilerSnapshotBuilderGeneratedTextsMergeInto(
           tables, generatedTexts, err):
        return false
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let symbolKind = tables.symbols.symbolKinds[symbolId]
        if symbolKind == snapshot_schema.CsgCompilerSymbolType:
            let sourceId = tables.symbols.sourceIds[symbolId]
            let qualifiedName = strutil.Join([
                share(tables.texts[
                    tables.sources.modulePathTextIds[sourceId]]),
                "::",
                share(tables.texts[tables.symbols.nameTextIds[symbolId]])
            ], "")
            let qualifiedNameTextId =
                compilerSnapshotBuilderTextFind(
                    tables.texts, qualifiedName)
            if qualifiedNameTextId < 0:
                err = " compiler snapshot builder: Type qualified name missing"
                return false
            tables.symbols.qualifiedNameTextIds[symbolId] =
                qualifiedNameTextId
        elif symbolKind == snapshot_schema.CsgCompilerSymbolField:
            var qualifiedName: str
            if !compilerSnapshotBuilderDeclarationSymbolQualifiedNameInto(
                   tables, symbolId, qualifiedName, err):
                return false
            let qualifiedNameTextId =
                compilerSnapshotBuilderTextFind(
                    tables.texts, qualifiedName)
            if qualifiedNameTextId < 0:
                err = " compiler snapshot builder: Field qualified name missing"
                return false
            tables.symbols.qualifiedNameTextIds[symbolId] =
                qualifiedNameTextId
        elif symbolKind ==
                 snapshot_schema.CsgCompilerSymbolGenericParameter:
            let sourceId = tables.symbols.sourceIds[symbolId]
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            let qualifiedName = strutil.Join([
                share(tables.texts[
                    tables.sources.modulePathTextIds[sourceId]]),
                "::",
                share(tables.texts[
                    tables.symbols.nameTextIds[ownerSymbolId]]),
                ".",
                share(tables.texts[tables.symbols.nameTextIds[symbolId]])
            ], "")
            let qualifiedNameTextId =
                compilerSnapshotBuilderTextFind(
                    tables.texts, qualifiedName)
            if qualifiedNameTextId < 0:
                err = " compiler snapshot builder: generic qualified name missing"
                return false
            tables.symbols.qualifiedNameTextIds[symbolId] =
                qualifiedNameTextId
        elif symbolKind == snapshot_schema.CsgCompilerSymbolParameter:
            let sourceId = tables.symbols.sourceIds[symbolId]
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            let qualifiedName = strutil.Join([
                share(tables.texts[
                    tables.sources.modulePathTextIds[sourceId]]),
                "::",
                share(tables.texts[
                    tables.symbols.nameTextIds[ownerSymbolId]]),
                ".",
                share(tables.texts[tables.symbols.nameTextIds[symbolId]])
            ], "")
            let qualifiedNameTextId =
                compilerSnapshotBuilderTextFind(
                    tables.texts, qualifiedName)
            if qualifiedNameTextId < 0:
                err = " compiler snapshot builder: parameter qualified name missing"
                return false
            tables.symbols.qualifiedNameTextIds[symbolId] =
                qualifiedNameTextId
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        let canonicalTextId = compilerSnapshotBuilderTextFind(
            tables.texts, arenaTypeTexts[arenaTypeId])
        if canonicalTextId < 0:
            err = " compiler snapshot builder: structural type text missing"
            return false
        if !compilerSnapshotBuilderAppendArenaTypeRow(
               tables, csg, arenaTypeId,
               typeSymbolIdByArenaTypeId,
               parserGenericRowByArenaTypeId,
               canonicalTextId, err):
            return false
    for representativeRow in 0..<signatureRepresentativeFunctions.len:
        let functionId =
            signatureRepresentativeFunctions[representativeRow]
        var schemaParamTypeIds: int32[]
        for offset in 0..<paramCounts[functionId]:
            add(schemaParamTypeIds, paramArenaTypeIds[
                paramStarts[functionId] + offset])
        let canonicalTextId = compilerSnapshotBuilderTextFind(
            tables.texts, signatureTextByFunction[functionId])
        if canonicalTextId < 0:
            err = " compiler snapshot builder: function signature text missing"
            return false
        compilerSnapshotBuilderAppendFunctionTypeRow(
            tables,
            returnArenaTypeIds[functionId],
            schemaParamTypeIds,
            0,
            schemaParamTypeIds.len,
            canonicalTextId)
    for representativeRow in 0..<
            signatureRepresentativeExternFunctions.len:
        let externFunctionId =
            signatureRepresentativeExternFunctions[
                representativeRow]
        var schemaParamTypeIds: int32[]
        for offset in 0..<externParamCounts[externFunctionId]:
            add(schemaParamTypeIds,
                externParamArenaTypeIds[
                    externParamStarts[externFunctionId] +
                        offset])
        let canonicalTextId =
            compilerSnapshotBuilderTextFind(
                tables.texts,
                signatureTextByExternFunction[
                    externFunctionId])
        if canonicalTextId < 0:
            err = " compiler snapshot builder: extern signature text missing"
            return false
        compilerSnapshotBuilderAppendFunctionTypeRow(
            tables,
            externReturnArenaTypeIds[externFunctionId],
            schemaParamTypeIds,
            0,
            schemaParamTypeIds.len,
            canonicalTextId)
    # wall w53: derive Type row identities first (both derivations are
    # row-local), then run the provisional DeclKey finalizer for EVERY
    # Type Symbol.  The commit audit "provisional Type DeclKey drift"
    # compares each Type Symbol cid against the sealed declaration table,
    # so nominal Type Symbols need provisional keys exactly like Alias
    # ones, and the finalizer's observed-typeCid authority requires the
    # rows above to exist before it runs.
    for typeId in 0..<tables.types.typeCids.len:
        var proofCid: layout.FixedBytes32
        var typeCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
               tables, typeId, proofCid, err):
            return false
        tables.types.traitProofCids[typeId] = proofCid
        if !snapshot_schema.CsgCompilerTypeRowCidInto(
               tables, typeId, typeCid, err):
            return false
        tables.types.typeCids[typeId] = typeCid
    # [phaseB-tuple-snap] The DeclKey finalizer above rewrites each Type
    # Symbol's symbolCids to the sealed declaration key. A non-nominal
    # declared row (the alias(Tuple) family: kind Alias is the only row
    # family that is neither nominal nor symbol-free) feeds
    # symbols.symbolCids[declSymbolId] directly into its row identity
    # preimage, so its first-pass proof/row CIDs are provisional by
    # construction and the canonical reorder audit below would reject the
    # drift. Re-derive every row identity from the now-sealed symbol
    # authority. The derivation consumes only immutable inputs for every
    # other family (nominal rows project declarationPathCids sealed at the
    # symbol join; structural rows carry declSymbolId -1), and an alias
    # target row never depends on symbolCids, so one pass in arena
    # declaration order -- also the alias-target topological order --
    # reaches the exact fixed point the canonicalization requires.
    for typeId in 0..<tables.types.typeCids.len:
        var proofCid: layout.FixedBytes32
        var typeCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
               tables, typeId, proofCid, err):
            return false
        tables.types.traitProofCids[typeId] = proofCid
        if !snapshot_schema.CsgCompilerTypeRowCidInto(
               tables, typeId, typeCid, err):
            return false
        tables.types.typeCids[typeId] = typeCid
    var newTypeIdByOld: int32[]
    if !compilerSnapshotBuilderTypeTableCanonicalizeInto(
           tables, newTypeIdByOld, err):
        return false
    if newTypeIdByOld.len != tables.types.typeCids.len:
        err = " compiler snapshot builder: canonical TypeId map shape drift"
        return false
    for oldTypeId in 0..<newTypeIdByOld.len:
        let newTypeId = newTypeIdByOld[oldTypeId]
        let expectedProducerTypeArenaId =
            oldTypeId < csg.typeArena.typeCount ?
                oldTypeId : -1
        if newTypeId < 0 ||
           newTypeId >= tables.types.producerTypeArenaIds.len ||
           tables.types.producerTypeArenaIds[newTypeId] !=
               expectedProducerTypeArenaId:
            err = " compiler snapshot builder: canonical TypeId to TypeArenaId order drift"
            return false
    if csg.typeArena == nil ||
       newTypeIdByOld.len < csg.typeArena.typeCount:
        err = " compiler snapshot builder: canonical TypeArena TypeId map shape drift"
        return false
    var finalTypeIdByArenaTypeId: int32[]
    setLen(finalTypeIdByArenaTypeId, csg.typeArena.typeCount)
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        finalTypeIdByArenaTypeId[arenaTypeId] =
            newTypeIdByOld[arenaTypeId]
    if !compilerSnapshotBuilderTypeArenaBridgeStrictValidateInto(
           tables, csg, err):
        return false
    if !compilerSnapshotBuilderTypeSyntaxTypesProjectInto(
           tables, csg, finalTypeIdByArenaTypeId, err):
        return false
    if unsealedProductionBase &&
       !compilerSnapshotBuilderProjectTypedNodesInto(
           tables, csg, err):
        return false
    if !compilerSnapshotBuilderTypedNodeTypesProjectInto(
           tables, csg, finalTypeIdByArenaTypeId, err):
        return false
    var remappedDeclarationSymbol: bool[]
    setLen(remappedDeclarationSymbol, tables.symbols.typeIds.len)
    for symbolId in 0..<remappedDeclarationSymbol.len:
        remappedDeclarationSymbol[symbolId] = false
    for arenaTypeId in 0..<typeSymbolIdByArenaTypeId.len:
        let symbolId = typeSymbolIdByArenaTypeId[arenaTypeId]
        if symbolId < 0:
            continue
        if symbolId >= tables.symbols.typeIds.len ||
           (tables.symbols.symbolKinds[symbolId] !=
                snapshot_schema.CsgCompilerSymbolType &&
            tables.symbols.symbolKinds[symbolId] !=
                snapshot_schema.CsgCompilerSymbolField) ||
           tables.symbols.typeIds[symbolId] < 0 ||
           tables.symbols.typeIds[symbolId] >=
               csg.typeArena.typeCount:
            err = " compiler snapshot builder: Type/Field Symbol TypeId remap input drift"
            return false
        let signatureArenaTypeId =
            tables.symbols.typeIds[symbolId]
        tables.symbols.typeIds[symbolId] =
            finalTypeIdByArenaTypeId[signatureArenaTypeId]
        remappedDeclarationSymbol[symbolId] = true
    # wall w53: declaration Symbols that claim no arena TypeId - scalar
    # Fields and Fields referencing a nominal declaration - still bind an
    # arena TypeId in symbols.typeIds and must join the same final TypeId
    # remap, or the declaration commit and the layout projection would
    # read stale arena rows.  Parameters also carry declaration rows but
    # remap through their own GenericParameter/Parameter pass below.
    for symbolId in 0..<tables.symbols.typeIds.len:
        if declarationRowByOldSymbol[symbolId] < 0 ||
           remappedDeclarationSymbol[symbolId]:
            continue
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolField:
            continue
        if tables.symbols.typeIds[symbolId] < 0 ||
           tables.symbols.typeIds[symbolId] >=
               csg.typeArena.typeCount:
            err = " compiler snapshot builder: Field Symbol TypeId remap input drift"
            return false
        let fieldArenaTypeId =
            tables.symbols.typeIds[symbolId]
        tables.symbols.typeIds[symbolId] =
            finalTypeIdByArenaTypeId[fieldArenaTypeId]
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let symbolKind = tables.symbols.symbolKinds[symbolId]
        if symbolKind != snapshot_schema.CsgCompilerSymbolGenericParameter &&
           symbolKind != snapshot_schema.CsgCompilerSymbolParameter:
            continue
        let arenaTypeId = tables.symbols.typeIds[symbolId]
        if arenaTypeId < 0 ||
           arenaTypeId >= finalTypeIdByArenaTypeId.len:
            err = " compiler snapshot builder: declaration TypeId remap input drift"
            return false
        tables.symbols.typeIds[symbolId] =
            finalTypeIdByArenaTypeId[arenaTypeId]
        if symbolKind == snapshot_schema.CsgCompilerSymbolParameter:
            continue
        let defaultArenaTypeId =
            tables.symbols.genericParameterDefaultTypeIds[symbolId]
        let constraintStart =
            tables.symbols.genericConstraintStarts[symbolId]
        let constraintCount =
            tables.symbols.genericConstraintCounts[symbolId]
        if defaultArenaTypeId < -1 ||
           defaultArenaTypeId >= finalTypeIdByArenaTypeId.len ||
           constraintStart < 0 || constraintCount < 0 ||
           constraintStart >
               tables.symbols.genericConstraintTypeIds.len ||
           constraintCount >
               tables.symbols.genericConstraintTypeIds.len -
                   constraintStart:
            err = " compiler snapshot builder: generic TypeId remap input drift"
            return false
        if defaultArenaTypeId >= 0:
            tables.symbols.genericParameterDefaultTypeIds[symbolId] =
                finalTypeIdByArenaTypeId[defaultArenaTypeId]
        for offset in 0..<constraintCount:
            let oldConstraintTypeId =
                tables.symbols.genericConstraintTypeIds[
                    constraintStart + offset]
            if oldConstraintTypeId < 0 ||
               oldConstraintTypeId >= finalTypeIdByArenaTypeId.len:
                err = " compiler snapshot builder: generic constraint TypeId remap input drift"
                return false
            tables.symbols.genericConstraintTypeIds[
                constraintStart + offset] =
                    finalTypeIdByArenaTypeId[oldConstraintTypeId]
    # wall w53 follow-up: the provisional DeclKey finalizer must run AFTER the
    # TypeId remap above.  The finalizer and the commit audit "provisional Type
    # DeclKey drift" both observe the row identity through
    # `symbols.typeIds[symbolId]`, and until that remap the column still holds
    # the ARENA row while `tables.types.typeCids` is indexed by the FINAL table
    # position.  `compilerSnapshotBuilderAppendFunctionTypeRow` appends the
    # synthesized signature rows after the projected arena rows and
    # `compilerSnapshotBuilderTypeTableCanonicalizeInto` orders the whole table
    # by row CID, so an arena row does not stay at its arena TypeId -- the
    # position<->arenaId check at "canonical TypeId to TypeArenaId order drift"
    # compares `producerTypeArenaIds[newTypeId]` against the OLD position, which
    # a retained arena row moved to another position satisfies.  Sealing a Type
    # Symbol before that remap therefore froze its key against the WRONG row's
    # TypeCid, which the audit rejects.  Here `symbols.typeIds` is the final
    # position and the Type table is the settled one the declaration projection
    # below consumes (the second derivation pass above produced it; the
    # finalizer itself writes only `symbolCids`, which no Type row identity
    # reads).  Coverage and every guard are unchanged: a row that claims no
    # Type Symbol still has `typeSymbolIdByArenaTypeId[arenaTypeId] < 0`, a
    # non-Type claimant is still skipped by kind, and the finalizer keeps all of
    # its own input guards.
    for arenaTypeId in 0..<typeSymbolIdByArenaTypeId.len:
        let typeSymbolId =
            typeSymbolIdByArenaTypeId[arenaTypeId]
        if typeSymbolId < 0 ||
           tables.symbols.symbolKinds[typeSymbolId] !=
               snapshot_schema.CsgCompilerSymbolType:
            continue
        let finalTypeId =
            tables.symbols.typeIds[typeSymbolId]
        if finalTypeId < 0 ||
           finalTypeId >= tables.types.typeCids.len:
            err = " compiler snapshot builder: Type Symbol finalizer TypeId map drift"
            return false
        let declarationRow =
            declarationRowByOldSymbol[typeSymbolId]
        if !compilerSnapshotBuilderFinalizeTypeSymbolDeclKeyInto(
               tables, csg, declarationRow,
               typeSymbolId, err):
            return false
    if unsealedProductionBase &&
       !compilerSnapshotBuilderAppendLocalSymbolsInto(
           tables, csg, declarationRowByOldSymbol, err):
        return false
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        if symbolId < 0 || symbolId >= tables.symbols.typeIds.len ||
           tables.symbols.functionIds[symbolId] != functionId ||
           tables.symbols.externFunctionIds[symbolId] != -1:
            err = " compiler snapshot builder: function SymbolId binding drift"
            return false
        tables.symbols.typeIds[symbolId] = newTypeIdByOld[
            signatureOldTypeByFunction[functionId]]
    for externFunctionId in 0..<
            tables.externFunctions.symbolIds.len:
        let symbolId =
            tables.externFunctions.symbolIds[externFunctionId]
        if symbolId < 0 ||
           symbolId >= tables.symbols.typeIds.len ||
           tables.symbols.functionIds[symbolId] != -1 ||
           tables.symbols.externFunctionIds[symbolId] !=
               externFunctionId:
            err = " compiler snapshot builder: extern SymbolId binding drift"
            return false
        let typeId = newTypeIdByOld[
            signatureOldTypeByExternFunction[externFunctionId]]
        tables.symbols.typeIds[symbolId] = typeId
        tables.externFunctions.typeIds[externFunctionId] =
            typeId
    if !compilerSnapshotBuilderDeclarationAuthorityCommitInto(
           tables, sidecars, csg,
           declarationRowByOldSymbol,
           oldSymbolIdsByCid,
           unsealedProductionBase,
           err):
        return false
    if !compilerSnapshotBuilderExternFfiHandleContractsProjectInto(
           tables, csg, err):
        return false
    if !compilerSnapshotBuilderManualConsumeSealInto(
           tables, csg, finalTypeIdByArenaTypeId, err):
        return false
    if !compilerSnapshotBuilderLayoutsProjectInto(
           tables,
           csg,
           finalTypeIdByArenaTypeId,
           err):
        return false
    if !compilerSnapshotBuilderAnnotationTargetsProjectInto(
           tables, err):
        return false
    var projectedTypeDeclarationCount: int32
    var projectedFieldDeclarationCount: int32
    var projectedParameterDeclarationCount: int32
    var projectedLocalDeclarationCount: int32
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let kind = tables.symbols.symbolKinds[symbolId]
        if kind == snapshot_schema.CsgCompilerSymbolModule:
            if tables.symbols.ownerSymbolIds[symbolId] != -1 ||
               tables.symbols.typeIds[symbolId] != -1 ||
               tables.symbols.functionIds[symbolId] != -1 ||
               tables.symbols.externFunctionIds[symbolId] != -1:
                err = " compiler snapshot builder: module Symbol projection drift"
                return false
        elif kind == snapshot_schema.CsgCompilerSymbolFunction:
            let functionId = tables.symbols.functionIds[symbolId]
            let externFunctionId =
                tables.symbols.externFunctionIds[symbolId]
            if ((functionId >= 0) == (externFunctionId >= 0)) ||
               tables.symbols.typeIds[symbolId] < 0:
                err = " compiler snapshot builder: function Symbol projection drift"
                return false
            if functionId >= 0 &&
               (functionId >= tables.functions.symbolIds.len ||
                tables.functions.symbolIds[functionId] != symbolId):
                err = " compiler snapshot builder: executable Function projection drift"
                return false
            if externFunctionId >= 0 &&
               (externFunctionId >=
                    tables.externFunctions.symbolIds.len ||
                tables.externFunctions.symbolIds[
                    externFunctionId] != symbolId ||
                tables.externFunctions.typeIds[
                    externFunctionId] !=
                    tables.symbols.typeIds[symbolId]):
                err = " compiler snapshot builder: extern Function projection drift"
                return false
        elif kind == snapshot_schema.CsgCompilerSymbolType:
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            let typeId = tables.symbols.typeIds[symbolId]
            var declarationTypeBindingCount: int32
            for candidateTypeId in 0..<tables.types.typeCids.len:
                if tables.types.declSymbolIds[candidateTypeId] ==
                       symbolId:
                    let declarationTypeKind =
                        tables.types.typeKinds[candidateTypeId]
                    if (declarationTypeKind ==
                            snapshot_schema.CsgCompilerTypeAlias &&
                        tables.types.aliasTargetTypeIds[
                            candidateTypeId] != typeId) ||
                       ((declarationTypeKind ==
                             snapshot_schema.CsgCompilerTypeObject ||
                         declarationTypeKind ==
                             snapshot_schema.CsgCompilerTypeRefObject ||
                         declarationTypeKind ==
                             snapshot_schema.CsgCompilerTypeEnum) &&
                        candidateTypeId != typeId) ||
                       (declarationTypeKind !=
                            snapshot_schema.CsgCompilerTypeAlias &&
                        declarationTypeKind !=
                            snapshot_schema.CsgCompilerTypeObject &&
                        declarationTypeKind !=
                            snapshot_schema.CsgCompilerTypeRefObject &&
                        declarationTypeKind !=
                            snapshot_schema.CsgCompilerTypeEnum):
                        err = " compiler snapshot builder: Type Symbol declaration projection drift"
                        return false
                    declarationTypeBindingCount =
                        declarationTypeBindingCount + 1
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.symbolCids.len ||
               tables.symbols.symbolKinds[ownerSymbolId] !=
                   snapshot_schema.CsgCompilerSymbolModule ||
               typeId < 0 || typeId >= tables.types.typeCids.len ||
               tables.symbols.functionIds[symbolId] != -1 ||
               tables.symbols.externFunctionIds[symbolId] != -1 ||
               declarationTypeBindingCount != 1:
                err = " compiler snapshot builder: Type Symbol projection drift"
                return false
            projectedTypeDeclarationCount =
                projectedTypeDeclarationCount + 1
        elif kind == snapshot_schema.CsgCompilerSymbolField:
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            let typeId = tables.symbols.typeIds[symbolId]
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.symbolCids.len ||
               (tables.symbols.symbolKinds[ownerSymbolId] !=
                    snapshot_schema.CsgCompilerSymbolType &&
                tables.symbols.symbolKinds[ownerSymbolId] !=
                    snapshot_schema.CsgCompilerSymbolField) ||
               typeId < 0 || typeId >= tables.types.typeCids.len ||
               tables.symbols.functionIds[symbolId] != -1 ||
               tables.symbols.externFunctionIds[symbolId] != -1:
                err = " compiler snapshot builder: Field Symbol projection drift"
                return false
            let typeKind = tables.types.typeKinds[typeId]
            let nominalField =
                typeKind == snapshot_schema.CsgCompilerTypeObject ||
                typeKind == snapshot_schema.CsgCompilerTypeRefObject
            if nominalField !=
                   (tables.types.declSymbolIds[typeId] == symbolId):
                # wall w53: a Field Symbol may bind a nominal Type row it
                # does not declare only as a reference; the row's declaring
                # Symbol must then be a Type Symbol owning exactly this row.
                if !nominalField ||
                   tables.types.declSymbolIds[typeId] < 0 ||
                   tables.types.declSymbolIds[typeId] >=
                       tables.symbols.symbolCids.len ||
                   tables.symbols.symbolKinds[
                       tables.types.declSymbolIds[typeId]] !=
                       snapshot_schema.CsgCompilerSymbolType:
                    err = " compiler snapshot builder: Field nominal Type projection drift"
                    return false
            projectedFieldDeclarationCount =
                projectedFieldDeclarationCount + 1
        elif kind ==
                 snapshot_schema.CsgCompilerSymbolGenericParameter:
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            let typeId = tables.symbols.typeIds[symbolId]
            let parserRow =
                tables.symbols.genericParameterParserRows[
                    symbolId]
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.symbolCids.len ||
               (tables.symbols.symbolKinds[ownerSymbolId] !=
                    snapshot_schema.CsgCompilerSymbolFunction &&
                tables.symbols.symbolKinds[ownerSymbolId] !=
                    snapshot_schema.CsgCompilerSymbolType) ||
               typeId < 0 || typeId >= tables.types.typeCids.len ||
               tables.types.typeKinds[typeId] !=
                   snapshot_schema.CsgCompilerTypeGenericParameter ||
               parserRow < 0 ||
               parserRow >=
                   tables.parserSidecars.typeGenericSymbolProducerSourceIds.len ||
               tables.symbols.functionIds[symbolId] != -1 ||
               tables.symbols.externFunctionIds[symbolId] != -1:
                err = " compiler snapshot builder: generic Symbol projection drift"
                return false
        elif kind == snapshot_schema.CsgCompilerSymbolParameter:
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            let typeId = tables.symbols.typeIds[symbolId]
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.symbolCids.len ||
               tables.symbols.symbolKinds[ownerSymbolId] !=
                   snapshot_schema.CsgCompilerSymbolFunction ||
               typeId < 0 || typeId >= tables.types.typeCids.len ||
               tables.symbols.functionIds[symbolId] != -1 ||
               tables.symbols.externFunctionIds[symbolId] != -1 ||
               tables.symbols.exportedFlags[symbolId]:
                err = " compiler snapshot builder: parameter Symbol projection drift"
                return false
            projectedParameterDeclarationCount =
                projectedParameterDeclarationCount + 1
        elif kind == snapshot_schema.CsgCompilerSymbolLocal:
            let ownerSymbolId =
                tables.symbols.ownerSymbolIds[symbolId]
            let typeId = tables.symbols.typeIds[symbolId]
            if ownerSymbolId < 0 ||
               ownerSymbolId >= tables.symbols.symbolCids.len ||
               tables.symbols.symbolKinds[ownerSymbolId] !=
                   snapshot_schema.CsgCompilerSymbolFunction ||
               tables.symbols.functionIds[ownerSymbolId] < 0 ||
               typeId < 0 || typeId >= tables.types.typeCids.len ||
               tables.symbols.functionIds[symbolId] != -1 ||
               tables.symbols.externFunctionIds[symbolId] != -1 ||
               tables.symbols.exportedFlags[symbolId]:
                err = " compiler snapshot builder: Local Symbol projection drift"
                return false
            projectedLocalDeclarationCount =
                projectedLocalDeclarationCount + 1
        else:
            err = " compiler snapshot builder: unsupported non-function symbol projection"
            return false
        var interfaceCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerSymbolInterfaceCidInto(
               tables, symbolId, interfaceCid, err):
            return false
        tables.symbols.interfaceCids[symbolId] = interfaceCid
        if kind == snapshot_schema.CsgCompilerSymbolFunction:
            let functionId = tables.symbols.functionIds[symbolId]
            if functionId >= 0:
                tables.functions.interfaceCids[functionId] =
                    interfaceCid
            else:
                tables.externFunctions.interfaceCids[
                    tables.symbols.externFunctionIds[symbolId]] =
                    interfaceCid
    if unsealedProductionBase &&
       !compilerSnapshotBuilderResolvedCallsProjectInto(
           tables, sidecars, csg, newTypeIdByOld, err):
        return false
    if unsealedProductionBase &&
       !CompilerSnapshotBuilderBindingReferencesMergeInto(
           tables, csg, err):
        return false
    var expectedTypeDeclarationCount: int32
    var expectedFieldDeclarationCount: int32
    var expectedParameterDeclarationCount: int32
    var expectedLocalDeclarationCount: int32
    for declarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        if tables.parserSidecars.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationType):
            expectedTypeDeclarationCount =
                expectedTypeDeclarationCount + 1
        elif tables.parserSidecars.declarationKinds[declarationRow] ==
                 Int32(parser.ParserDeclarationField):
            expectedFieldDeclarationCount =
                expectedFieldDeclarationCount + 1
        elif tables.parserSidecars.declarationKinds[declarationRow] ==
                 Int32(parser.ParserDeclarationParameter):
            expectedParameterDeclarationCount =
                expectedParameterDeclarationCount + 1
        elif unsealedProductionBase &&
             tables.parserSidecars.declarationKinds[declarationRow] ==
                 Int32(parser.ParserDeclarationLocal) &&
             tables.parserSidecars.declarationFunctionRows[
                 declarationRow] >= 0:
            expectedLocalDeclarationCount =
                expectedLocalDeclarationCount + 1
    if projectedTypeDeclarationCount != expectedTypeDeclarationCount ||
       projectedFieldDeclarationCount != expectedFieldDeclarationCount ||
       projectedParameterDeclarationCount !=
           expectedParameterDeclarationCount ||
       projectedLocalDeclarationCount !=
           expectedLocalDeclarationCount:
        err = " compiler snapshot builder: declaration Symbol projection coverage drift"
        return false
    if !compilerSnapshotBuilderInterfaceReadsRebuildInto(tables, err):
        return false
    if unsealedProductionBase:
        if !snapshot_schema.CsgCompilerSnapshotUnsealedSymbolFunctionTablesStrictValidateInto(
               tables, err):
            return false
    elif !snapshot_schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
             tables, err):
        return false
    err = ""
    return true

fn compilerSnapshotBuilderTypeFunctionProjectionEqual(
        left: var snapshot_schema.CsgCompilerSnapshotTables,
        right: var snapshot_schema.CsgCompilerSnapshotTables): bool =
    if left.schemaVersion != right.schemaVersion ||
       left.semanticEpoch != right.semanticEpoch ||
       left.types.typeCids.len != right.types.typeCids.len ||
       left.types.producerTypeArenaIds.len !=
           right.types.producerTypeArenaIds.len ||
       left.types.argNameTextIds.len !=
           right.types.argNameTextIds.len ||
       left.parserSidecars.typeSyntaxTypeIds.len !=
           right.parserSidecars.typeSyntaxTypeIds.len ||
       left.symbols.typeIds.len != right.symbols.typeIds.len ||
       left.symbols.externFunctionIds.len !=
           right.symbols.externFunctionIds.len ||
       left.functions.interfaceCids.len !=
           right.functions.interfaceCids.len ||
       left.functions.symbolIds.len !=
           right.functions.symbolIds.len ||
       left.functions.readSetPreimageCids.len !=
           right.functions.readSetPreimageCids.len ||
       left.functions.manualConsumeTargetParameterSymbolIds.len !=
           right.functions.manualConsumeTargetParameterSymbolIds.len ||
       left.functions.manualConsumeSourceParameterSymbolIds.len !=
           right.functions.manualConsumeSourceParameterSymbolIds.len ||
       left.functions.manualConsumeEffectCids.len !=
           right.functions.manualConsumeEffectCids.len ||
       left.functions.resultOwnershipKinds.len !=
           right.functions.resultOwnershipKinds.len ||
       left.externFunctions.interfaceCids.len !=
           right.externFunctions.interfaceCids.len ||
       left.externFunctions.symbolIds.len !=
           right.externFunctions.symbolIds.len ||
       left.externFunctions.parserDeclarationRows.len !=
           right.externFunctions.parserDeclarationRows.len ||
       left.externFunctions.typeIds.len !=
           right.externFunctions.typeIds.len ||
       left.externFunctions.externalNameTextIds.len !=
           right.externFunctions.externalNameTextIds.len ||
       left.externFunctions.abiKinds.len !=
           right.externFunctions.abiKinds.len ||
       left.externFunctions.importAnnotationRows.len !=
           right.externFunctions.importAnnotationRows.len ||
       !compilerSnapshotBuilderExternFfiHandleTableEqual(
            left.externFfiHandleContracts,
            right.externFfiHandleContracts) ||
       left.functions.parameterOwnershipKinds.len !=
           right.functions.parameterOwnershipKinds.len ||
       left.layouts.layoutCids.len !=
           right.layouts.layoutCids.len ||
       left.layoutFields.layoutIds.len !=
           right.layoutFields.layoutIds.len ||
       left.readSet.observedValueCids.len !=
           right.readSet.observedValueCids.len ||
       left.readSet.targetPortableKeyCids.len !=
           right.readSet.targetPortableKeyCids.len:
        return false
    if !layout.FixedBytes32Equal(
           left.declarations.tableCid, right.declarations.tableCid):
        return false
    for typeId in 0..<left.types.typeCids.len:
        if !layout.FixedBytes32Equal(
               left.types.typeCids[typeId], right.types.typeCids[typeId]) ||
           left.types.producerTypeArenaIds[typeId] !=
               right.types.producerTypeArenaIds[typeId] ||
           left.types.canonicalTextIds[typeId] !=
               right.types.canonicalTextIds[typeId]:
            return false
    for row in 0..<left.types.argNameTextIds.len:
        if left.types.argNameTextIds[row] !=
               right.types.argNameTextIds[row]:
            return false
    for row in 0..<left.parserSidecars.typeSyntaxTypeIds.len:
        if left.parserSidecars.typeSyntaxTypeIds[row] !=
               right.parserSidecars.typeSyntaxTypeIds[row]:
            return false
    for symbolId in 0..<left.symbols.typeIds.len:
        if left.symbols.sourceIds[symbolId] !=
               right.symbols.sourceIds[symbolId] ||
           left.symbols.nameTextIds[symbolId] !=
               right.symbols.nameTextIds[symbolId] ||
           left.symbols.nameSpanIds[symbolId] !=
               right.symbols.nameSpanIds[symbolId] ||
           left.symbols.nameTokenIds[symbolId] !=
               right.symbols.nameTokenIds[symbolId] ||
           left.symbols.symbolKinds[symbolId] !=
               right.symbols.symbolKinds[symbolId] ||
           left.symbols.typeIds[symbolId] !=
               right.symbols.typeIds[symbolId] ||
           left.symbols.declarationSpanIds[symbolId] !=
               right.symbols.declarationSpanIds[symbolId] ||
           left.symbols.ownerSymbolIds[symbolId] !=
               right.symbols.ownerSymbolIds[symbolId] ||
           left.symbols.functionIds[symbolId] !=
               right.symbols.functionIds[symbolId] ||
           left.symbols.externFunctionIds[symbolId] !=
               right.symbols.externFunctionIds[symbolId] ||
           left.symbols.exportedFlags[symbolId] !=
               right.symbols.exportedFlags[symbolId] ||
           left.symbols.declIds[symbolId] !=
               right.symbols.declIds[symbolId] ||
           !layout.FixedBytes32Equal(
               left.symbols.declKeyCids[symbolId],
               right.symbols.declKeyCids[symbolId]) ||
           !layout.FixedBytes32Equal(
               left.symbols.symbolCids[symbolId],
               right.symbols.symbolCids[symbolId]) ||
           !layout.FixedBytes32Equal(
               left.symbols.interfaceCids[symbolId],
               right.symbols.interfaceCids[symbolId]):
            return false
    for functionId in 0..<left.functions.interfaceCids.len:
        if left.functions.symbolIds[functionId] !=
               right.functions.symbolIds[functionId] ||
           left.functions.resultOwnershipKinds[functionId] !=
               right.functions.resultOwnershipKinds[functionId] ||
           left.functions.parameterOwnershipStarts[functionId] !=
               right.functions.parameterOwnershipStarts[functionId] ||
           left.functions.parameterOwnershipCounts[functionId] !=
               right.functions.parameterOwnershipCounts[functionId] ||
           left.functions.manualConsumeTargetParameterSymbolIds[
               functionId] !=
               right.functions.manualConsumeTargetParameterSymbolIds[
                   functionId] ||
           left.functions.manualConsumeSourceParameterSymbolIds[
               functionId] !=
               right.functions.manualConsumeSourceParameterSymbolIds[
                   functionId] ||
           !layout.FixedBytes32Equal(
               left.functions.manualConsumeEffectCids[functionId],
               right.functions.manualConsumeEffectCids[functionId]) ||
           !layout.FixedBytes32Equal(
               left.functions.interfaceCids[functionId],
               right.functions.interfaceCids[functionId]) ||
           !layout.FixedBytes32Equal(
               left.functions.readSetPreimageCids[functionId],
               right.functions.readSetPreimageCids[functionId]):
            return false
    for row in 0..<left.functions.parameterOwnershipKinds.len:
        if left.functions.parameterOwnershipKinds[row] !=
               right.functions.parameterOwnershipKinds[row]:
            return false
    for layoutId in 0..<left.layouts.layoutCids.len:
        if left.layouts.typeIds[layoutId] !=
               right.layouts.typeIds[layoutId] ||
           left.layouts.sizeBytes[layoutId] !=
               right.layouts.sizeBytes[layoutId] ||
           left.layouts.alignBytes[layoutId] !=
               right.layouts.alignBytes[layoutId] ||
           left.layouts.fieldStarts[layoutId] !=
               right.layouts.fieldStarts[layoutId] ||
           left.layouts.fieldCounts[layoutId] !=
               right.layouts.fieldCounts[layoutId] ||
           !layout.FixedBytes32Equal(
               left.layouts.layoutCids[layoutId],
               right.layouts.layoutCids[layoutId]):
            return false
    for fieldRow in 0..<left.layoutFields.layoutIds.len:
        if left.layoutFields.layoutIds[fieldRow] !=
               right.layoutFields.layoutIds[fieldRow] ||
           left.layoutFields.fieldSymbolIds[fieldRow] !=
               right.layoutFields.fieldSymbolIds[fieldRow] ||
           left.layoutFields.typeIds[fieldRow] !=
               right.layoutFields.typeIds[fieldRow] ||
           left.layoutFields.offsetBytes[fieldRow] !=
               right.layoutFields.offsetBytes[fieldRow] ||
           left.layoutFields.sizeBytes[fieldRow] !=
               right.layoutFields.sizeBytes[fieldRow] ||
           left.layoutFields.alignBytes[fieldRow] !=
               right.layoutFields.alignBytes[fieldRow]:
            return false
    for externFunctionId in 0..<
            left.externFunctions.interfaceCids.len:
        if left.externFunctions.symbolIds[externFunctionId] !=
               right.externFunctions.symbolIds[externFunctionId] ||
           left.externFunctions.parserDeclarationRows[
               externFunctionId] !=
               right.externFunctions.parserDeclarationRows[
                   externFunctionId] ||
           left.externFunctions.typeIds[externFunctionId] !=
               right.externFunctions.typeIds[externFunctionId] ||
           left.externFunctions.externalNameTextIds[
               externFunctionId] !=
               right.externFunctions.externalNameTextIds[
                   externFunctionId] ||
           left.externFunctions.abiKinds[externFunctionId] !=
               right.externFunctions.abiKinds[externFunctionId] ||
           left.externFunctions.importAnnotationRows[
               externFunctionId] !=
               right.externFunctions.importAnnotationRows[
                   externFunctionId] ||
           !layout.FixedBytes32Equal(
               left.externFunctions.interfaceCids[
                   externFunctionId],
               right.externFunctions.interfaceCids[
                   externFunctionId]):
            return false
    for readRow in 0..<left.readSet.observedValueCids.len:
        if !layout.FixedBytes32Equal(
               left.readSet.targetPortableKeyCids[readRow],
               right.readSet.targetPortableKeyCids[readRow]) ||
           !layout.FixedBytes32Equal(
               left.readSet.observedValueCids[readRow],
               right.readSet.observedValueCids[readRow]):
            return false
    return layout.FixedBytes32Equal(
        left.readSet.reverseIndexCid, right.readSet.reverseIndexCid)

@borrows
fn compilerSnapshotBuilderCanonicalTypeIdByCid(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        wanted: layout.FixedBytes32): int32 =
    var low: int32
    var high = tables.types.typeCids.len
    while low < high:
        let middle = low + (high - low) / 2
        if compilerSnapshotBuilderCidLess(
               tables.types.typeCids[middle], wanted):
            low = middle + 1
        else:
            high = middle
    if low < tables.types.typeCids.len &&
       layout.FixedBytes32Equal(
           tables.types.typeCids[low], wanted):
        return low
    return -1

@borrows
fn compilerSnapshotBuilderTypeSymbolCoordinateLess(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        leftSymbolId: int32,
        rightSymbolId: int32): bool =
    if tables.symbols.sourceIds[leftSymbolId] !=
           tables.symbols.sourceIds[rightSymbolId]:
        return tables.symbols.sourceIds[leftSymbolId] <
            tables.symbols.sourceIds[rightSymbolId]
    if tables.symbols.nameTokenIds[leftSymbolId] !=
           tables.symbols.nameTokenIds[rightSymbolId]:
        return tables.symbols.nameTokenIds[leftSymbolId] <
            tables.symbols.nameTokenIds[rightSymbolId]
    if tables.symbols.nameSpanIds[leftSymbolId] !=
           tables.symbols.nameSpanIds[rightSymbolId]:
        return tables.symbols.nameSpanIds[leftSymbolId] <
            tables.symbols.nameSpanIds[rightSymbolId]
    return tables.symbols.declarationSpanIds[leftSymbolId] <
        tables.symbols.declarationSpanIds[rightSymbolId]

@borrows
fn compilerSnapshotBuilderTypeSymbolCoordinateSiftDown(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        typeSymbolIds: var int32[],
        start: int32,
        count: int32) =
    var root = start
    while root >= 0 && root < count:
        let left = root * 2 + 1
        if left >= count:
            return
        var selected = left
        let right = left + 1
        if right < count &&
           compilerSnapshotBuilderTypeSymbolCoordinateLess(
               tables,
               typeSymbolIds[selected],
               typeSymbolIds[right]):
            selected = right
        if !compilerSnapshotBuilderTypeSymbolCoordinateLess(
               tables,
               typeSymbolIds[root],
               typeSymbolIds[selected]):
            return
        let saved = typeSymbolIds[root]
        typeSymbolIds[root] = typeSymbolIds[selected]
        typeSymbolIds[selected] = saved
        root = selected

@borrows
fn compilerSnapshotBuilderTypeSymbolCoordinateIndexBuildInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        typeSymbolIds: var int32[],
        err: var str): bool =
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] ==
               snapshot_schema.CsgCompilerSymbolType ||
           tables.symbols.symbolKinds[symbolId] ==
               snapshot_schema.CsgCompilerSymbolField:
            add(typeSymbolIds, symbolId)
    let parentCount = typeSymbolIds.len / 2
    for reverse in 0..<parentCount:
        compilerSnapshotBuilderTypeSymbolCoordinateSiftDown(
            tables, typeSymbolIds,
            parentCount - 1 - reverse, typeSymbolIds.len)
    if typeSymbolIds.len > 1:
        for reverse in 0..<typeSymbolIds.len - 1:
            let endExclusive = typeSymbolIds.len - reverse
            let saved = typeSymbolIds[0]
            typeSymbolIds[0] = typeSymbolIds[endExclusive - 1]
            typeSymbolIds[endExclusive - 1] = saved
            compilerSnapshotBuilderTypeSymbolCoordinateSiftDown(
                tables, typeSymbolIds, 0, endExclusive - 1)
    for row in 1..<typeSymbolIds.len:
        if !compilerSnapshotBuilderTypeSymbolCoordinateLess(
               tables,
               typeSymbolIds[row - 1],
               typeSymbolIds[row]):
            err = " compiler snapshot builder: duplicate final Type Symbol coordinate"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypeSymbolCoordinateFind(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        typeSymbolIds: int32[],
        sourceId: int32,
        nameTokenId: int32,
        nameSpanId: int32,
        declarationSpanId: int32): int32 =
    var low: int32
    var high = typeSymbolIds.len
    while low < high:
        let middle = low + (high - low) / 2
        let symbolId = typeSymbolIds[middle]
        let less =
            tables.symbols.sourceIds[symbolId] < sourceId ||
            (tables.symbols.sourceIds[symbolId] == sourceId &&
             (tables.symbols.nameTokenIds[symbolId] < nameTokenId ||
              (tables.symbols.nameTokenIds[symbolId] == nameTokenId &&
               (tables.symbols.nameSpanIds[symbolId] < nameSpanId ||
                (tables.symbols.nameSpanIds[symbolId] == nameSpanId &&
                 tables.symbols.declarationSpanIds[symbolId] <
                     declarationSpanId)))))
        if less:
            low = middle + 1
        else:
            high = middle
    if low >= typeSymbolIds.len:
        return -1
    let symbolId = typeSymbolIds[low]
    if tables.symbols.sourceIds[symbolId] == sourceId &&
       tables.symbols.nameTokenIds[symbolId] == nameTokenId &&
       tables.symbols.nameSpanIds[symbolId] == nameSpanId &&
       tables.symbols.declarationSpanIds[symbolId] ==
           declarationSpanId:
        return symbolId
    return -1

@borrows
fn compilerSnapshotBuilderPortableTypeSymbolsJoinInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        projection: CompilerSnapshotPortableTypeProjection,
        csg: ccsg.CompilerCsg,
        typeSymbolIdByArenaTypeId: var int32[],
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let symbolCount = tables.symbols.symbolCids.len
    setLen(typeSymbolIdByArenaTypeId, csg.typeArena.typeCount)
    for arenaTypeId in 0..<typeSymbolIdByArenaTypeId.len:
        typeSymbolIdByArenaTypeId[arenaTypeId] = -1
    var moduleSymbolBySource: int32[]
    setLen(moduleSymbolBySource, sourceCount)
    for sourceId in 0..<sourceCount:
        moduleSymbolBySource[sourceId] = -1
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolModule:
            continue
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount ||
           moduleSymbolBySource[sourceId] >= 0:
            err = " compiler snapshot builder: portable Type Module Symbol join invalid"
            return false
        moduleSymbolBySource[sourceId] = symbolId
    var seenSymbols: bool[]
    setLen(seenSymbols, symbolCount)
    var typeSymbolIdsByCoordinate: int32[]
    if !compilerSnapshotBuilderTypeSymbolCoordinateIndexBuildInto(
           tables, typeSymbolIdsByCoordinate, err):
        return false
    var symbolByDeclaration: int32[]
    setLen(symbolByDeclaration,
           tables.parserSidecars.declarationKinds.len)
    for declarationRow in 0..<symbolByDeclaration.len:
        symbolByDeclaration[declarationRow] = -1
    for projectionRow in 0..<projection.declarationRows.len:
        let sourceId = projection.sourceIds[projectionRow]
        let nameTokenId = projection.nameTokenIds[projectionRow]
        let nameSpanId = projection.nameSpanIds[projectionRow]
        let declarationSpanId =
            projection.declarationSpanIds[projectionRow]
        let symbolId =
            compilerSnapshotBuilderTypeSymbolCoordinateFind(
                tables, typeSymbolIdsByCoordinate,
                sourceId, nameTokenId, nameSpanId,
                declarationSpanId)
        let declarationRow =
            projection.declarationRows[projectionRow]
        let parserDeclarationKind =
            tables.parserSidecars.declarationKinds[declarationRow]
        let expectedSymbolKind =
            parserDeclarationKind ==
                Int32(parser.ParserDeclarationType) ?
                snapshot_schema.CsgCompilerSymbolType :
                snapshot_schema.CsgCompilerSymbolField
        var expectedOwnerSymbolId =
            moduleSymbolBySource[sourceId]
        if expectedSymbolKind == snapshot_schema.CsgCompilerSymbolField:
            let root =
                tables.parserSidecars.declarationTypeSyntaxRootIds[
                    declarationRow]
            let ownerRoot =
                root < 0 ||
                root >=
                    tables.parserSidecars.typeSyntaxDeclarationOwnerIds.len ?
                    -1 :
                    tables.parserSidecars.typeSyntaxDeclarationOwnerIds[root]
            var immediateOwnerDeclaration: int32 = -1
            for candidateDeclaration in 0..<declarationRow:
                if tables.parserSidecars.declarationTypeSyntaxRootIds[
                       candidateDeclaration] == ownerRoot:
                    immediateOwnerDeclaration = candidateDeclaration
            if immediateOwnerDeclaration < 0:
                err = " compiler snapshot builder: portable Field immediate owner declaration missing"
                return false
            expectedOwnerSymbolId =
                symbolByDeclaration[immediateOwnerDeclaration]
        if sourceId < 0 || sourceId >= sourceCount ||
           moduleSymbolBySource[sourceId] < 0 ||
           symbolId < 0 || seenSymbols[symbolId] ||
           expectedOwnerSymbolId < 0 ||
           tables.symbols.symbolKinds[symbolId] !=
               expectedSymbolKind ||
           tables.symbols.ownerSymbolIds[symbolId] !=
               expectedOwnerSymbolId ||
           tables.symbols.functionIds[symbolId] != -1:
            err = " compiler snapshot builder: portable Type/Field Symbol exact join missing"
            return false
        let declId = tables.symbols.declIds[symbolId]
        var declarationOwnerSymbolId =
            moduleSymbolBySource[sourceId]
        if expectedSymbolKind == snapshot_schema.CsgCompilerSymbolField:
            let parserOwnerDeclaration =
                tables.parserSidecars.declarationOwnerIds[
                    declarationRow]
            if parserOwnerDeclaration < 0 ||
               parserOwnerDeclaration >= symbolByDeclaration.len:
                err = " compiler snapshot builder: portable Field declaration owner missing"
                return false
            declarationOwnerSymbolId =
                symbolByDeclaration[parserOwnerDeclaration]
        let ownerDeclId =
            declarationOwnerSymbolId < 0 ? -1 :
                tables.symbols.declIds[declarationOwnerSymbolId]
        let expectedDeclarationKind =
            expectedSymbolKind == snapshot_schema.CsgCompilerSymbolType ?
                declaration.SemanticSnapshotDeclarationKindType :
                declaration.SemanticSnapshotDeclarationKindField
        var nameProofCid: layout.FixedBytes32
        if declId < 0 ||
           declId >= tables.declarations.declIds.len ||
           ownerDeclId < 0 ||
           ownerDeclId >= tables.declarations.declIds.len ||
           tables.declarations.declarationKinds[declId] !=
               expectedDeclarationKind ||
           tables.declarations.ownerDeclIds[declId] != ownerDeclId ||
           !layout.FixedBytes32Equal(
               tables.declarations.portableDocumentIdentityCids[declId],
               tables.sources.documentCids[sourceId]) ||
           tables.declarations.spanStartBytes[declId] !=
               tables.spans.startBytes[declarationSpanId] ||
           tables.declarations.spanEndBytes[declId] !=
               tables.spans.endBytes[declarationSpanId] ||
           !compilerSnapshotBuilderDeclarationNameProofCidInto(
               tables, declarationRow, nameProofCid, err) ||
           !layout.FixedBytes32Equal(
               tables.declarations.parserValidatedNameProofCids[declId],
               nameProofCid) ||
           !layout.FixedBytes32Equal(
               tables.symbols.symbolCids[symbolId],
               tables.symbols.declKeyCids[symbolId]) ||
           !layout.FixedBytes32Equal(
               tables.symbols.declKeyCids[symbolId],
               tables.declarations.declKeyCids[declId]):
            if err == "":
                err = " compiler snapshot builder: portable Type declaration CID join invalid"
            return false
        let arenaTypeId = projection.arenaTypeIds[projectionRow]
        if arenaTypeId < 0 ||
           arenaTypeId >= typeSymbolIdByArenaTypeId.len:
            err = " compiler snapshot builder: portable TypeArena Symbol join invalid"
            return false
        let arenaSymbolId = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.symbolIds,
            arenaTypeId)
        if arenaSymbolId >= 0:
            # wall w53: the arena grants a declaration SymbolId only to the
            # declaration root that created it (typed_expr_type_arena
            # FillDeclarationSymbols), and that root is exactly the row this
            # projection stores in arenaTypeSyntaxRows.  A Field whose
            # declared type references a nominal declaration shares that
            # declaration's arena TypeId - ResolveNominal returns the
            # declaration's own TypeId - and therefore also reads the
            # referenced declaration's arena Symbol at this row.  Only the
            # row that owns the Symbol may claim the TypeId: a referencing
            # Field that merely tests `arenaSymbolId >= 0` takes the claim
            # whenever its own row precedes the declaration row, which both
            # poisons the portable Type row's declSymbolId authority and
            # trips the duplicate check on the owning declaration row.
            if arenaSymbolId >= csg.typeArena.symbolCount:
                err = " compiler snapshot builder: portable TypeArena Symbol owner invalid"
                return false
            let arenaSymbolRoot = arenamod.ArenaArrayInt32Get(
                csg.typeArena.arena,
                csg.typeArena.symbolDeclarationRootTypeSyntaxNodeIndexes,
                arenaSymbolId)
            if arenaSymbolRoot < 0 ||
               arenaSymbolRoot >= csg.typeArena.typeSyntaxCount:
                err = " compiler snapshot builder: portable TypeArena Symbol owner root invalid"
                return false
            if arenaSymbolRoot ==
                   projection.arenaTypeSyntaxRows[projectionRow]:
                if typeSymbolIdByArenaTypeId[arenaTypeId] >= 0:
                    err = " compiler snapshot builder: portable TypeArena Symbol join duplicate"
                    return false
                typeSymbolIdByArenaTypeId[arenaTypeId] = symbolId
            elif expectedSymbolKind ==
                     snapshot_schema.CsgCompilerSymbolType:
                err = Fmt" compiler snapshot builder: portable Type declaration SymbolId not owned row={projectionRow} declaration={declarationRow} symbolId={symbolId} arenaTypeId={arenaTypeId} arenaSymbolId={arenaSymbolId} arenaSymbolRoot={arenaSymbolRoot} rowRoot={projection.arenaTypeSyntaxRows[projectionRow]}"
                return false
        elif expectedSymbolKind == snapshot_schema.CsgCompilerSymbolType:
            err = " compiler snapshot builder: portable Type declaration SymbolId missing"
            return false
        symbolByDeclaration[declarationRow] = symbolId
        seenSymbols[symbolId] = true
    var observedDeclarationSymbolCount: int32
    for symbolId in 0..<symbolCount:
        if tables.symbols.symbolKinds[symbolId] ==
               snapshot_schema.CsgCompilerSymbolType ||
           tables.symbols.symbolKinds[symbolId] ==
               snapshot_schema.CsgCompilerSymbolField:
            observedDeclarationSymbolCount =
                observedDeclarationSymbolCount + 1
            if !seenSymbols[symbolId]:
                err = " compiler snapshot builder: final Type/Field Symbol lacks parser projection"
                return false
    if observedDeclarationSymbolCount != projection.declarationRows.len:
        err = " compiler snapshot builder: portable Type/Field Symbol coverage mismatch"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderPortableGenericRowsByArenaTypeInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        parserGenericRowByArenaTypeId: var int32[],
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    let parserGenericCount =
        tables.parserSidecars.typeGenericSymbolProducerSourceIds.len
    if parserGenericCount != csg.typeArena.genericSymbolCount ||
       tables.parserSidecars.typeGenericSymbolSourceLocalRows.len !=
           parserGenericCount:
        err = " compiler snapshot builder: portable generic row coverage drift"
        return false
    var arenaGenericBaseByProducer: int32[]
    var arenaGenericCountByProducer: int32[]
    setLen(arenaGenericBaseByProducer, sourceCount)
    setLen(arenaGenericCountByProducer, sourceCount)
    for producer in 0..<sourceCount:
        arenaGenericBaseByProducer[producer] = -1
    var previousProducer: int32 = -1
    for arenaGenericRow in 0..<csg.typeArena.genericSymbolCount:
        let producer = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolProducerSourceIndexes,
            arenaGenericRow)
        if producer < 0 || producer >= sourceCount ||
           producer < previousProducer ||
           (producer != previousProducer &&
            arenaGenericBaseByProducer[producer] >= 0):
            err = " compiler snapshot builder: portable generic producer order invalid"
            return false
        if arenaGenericBaseByProducer[producer] < 0:
            arenaGenericBaseByProducer[producer] = arenaGenericRow
        arenaGenericCountByProducer[producer] =
            arenaGenericCountByProducer[producer] + 1
        previousProducer = producer
    var parserRowByArenaGeneric: int32[]
    setLen(parserRowByArenaGeneric, parserGenericCount)
    for row in 0..<parserGenericCount:
        parserRowByArenaGeneric[row] = -1
    for parserRow in 0..<parserGenericCount:
        let sourceId =
            tables.parserSidecars.typeGenericSymbolProducerSourceIds[
                parserRow]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler snapshot builder: portable generic source invalid"
            return false
        let producer =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        let sourceLocalRow =
            tables.parserSidecars.typeGenericSymbolSourceLocalRows[
                parserRow]
        if producer < 0 || producer >= sourceCount ||
           sourceLocalRow < 0 ||
           sourceLocalRow >=
               arenaGenericCountByProducer[producer]:
            err = " compiler snapshot builder: portable generic coordinate invalid"
            return false
        let arenaGenericRow =
            arenaGenericBaseByProducer[producer] + sourceLocalRow
        if arenaGenericRow < 0 ||
           arenaGenericRow >= parserRowByArenaGeneric.len ||
           parserRowByArenaGeneric[arenaGenericRow] >= 0 ||
           arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.genericSymbolProducerSourceIndexes,
               arenaGenericRow) != producer:
            err = " compiler snapshot builder: portable generic coordinate ambiguous"
            return false
        parserRowByArenaGeneric[arenaGenericRow] = parserRow
    setLen(parserGenericRowByArenaTypeId, csg.typeArena.typeCount)
    for arenaTypeId in 0..<parserGenericRowByArenaTypeId.len:
        parserGenericRowByArenaTypeId[arenaTypeId] = -1
        if arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeKinds,
               arenaTypeId) !=
               Int32(typearena.TypedExprStructuralTypeGenericParameter):
            continue
        let arenaGenericRow = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolIds,
            arenaTypeId)
        if arenaGenericRow < 0 ||
           arenaGenericRow >= parserRowByArenaGeneric.len ||
           parserRowByArenaGeneric[arenaGenericRow] < 0:
            err = " compiler snapshot builder: portable generic Type row missing"
            return false
        parserGenericRowByArenaTypeId[arenaTypeId] =
            parserRowByArenaGeneric[arenaGenericRow]
    for arenaGenericRow in 0..<parserRowByArenaGeneric.len:
        if parserRowByArenaGeneric[arenaGenericRow] < 0:
            err = " compiler snapshot builder: portable generic parser row missing"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderPortableTypeProjectionStrictReplayInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    var projection: CompilerSnapshotPortableTypeProjection
    if !compilerSnapshotBuilderPortableTypeProjectionBuildInto(
           tables, sidecars, csg, projection, err):
        return false
    var typeSymbolIdByArenaTypeId: int32[]
    if !compilerSnapshotBuilderPortableTypeSymbolsJoinInto(
           tables, projection, csg,
           typeSymbolIdByArenaTypeId, err):
        return false
    var arenaTypeTexts: str[]
    if !compilerSnapshotBuilderArenaTypeTextsInto(
           csg, arenaTypeTexts, err):
        return false
    var parserGenericRowByArenaTypeId: int32[]
    if !compilerSnapshotBuilderPortableGenericRowsByArenaTypeInto(
           tables, csg, parserGenericRowByArenaTypeId, err):
        return false
    var portable =
        snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    portable.types = snapshot_schema.CsgCompilerTypeTable()
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        let canonicalTextId =
            compilerSnapshotBuilderTextFind(
                portable.texts, arenaTypeTexts[arenaTypeId])
        if canonicalTextId < 0 ||
           !compilerSnapshotBuilderAppendArenaTypeRow(
               portable, csg, arenaTypeId,
               typeSymbolIdByArenaTypeId,
               parserGenericRowByArenaTypeId,
               canonicalTextId, err):
            if err == "":
                err = " compiler snapshot builder: portable Type text cargo missing"
            return false
    # [portable-row-order] Same rule as the reference-result projection
    # above: append the whole portable row space first, then derive row
    # identities in the two passes the final Type table runs.  Deriving a
    # row while appending range-checks its premises against a partial table,
    # which an aggregate row (reserved before its fields are interned)
    # never satisfies.
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        var proofCid: layout.FixedBytes32
        var typeCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
               portable, arenaTypeId, proofCid, err):
            return false
        portable.types.traitProofCids[arenaTypeId] = proofCid
        if !snapshot_schema.CsgCompilerTypeRowCidInto(
               portable, arenaTypeId, typeCid, err):
            return false
        portable.types.typeCids[arenaTypeId] = typeCid
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        var proofCid: layout.FixedBytes32
        var typeCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
               portable, arenaTypeId, proofCid, err):
            return false
        portable.types.traitProofCids[arenaTypeId] = proofCid
        if !snapshot_schema.CsgCompilerTypeRowCidInto(
               portable, arenaTypeId, typeCid, err):
            return false
        portable.types.typeCids[arenaTypeId] = typeCid
    var finalTypeIdByArenaTypeId: int32[]
    setLen(finalTypeIdByArenaTypeId, csg.typeArena.typeCount)
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        let finalTypeId =
            compilerSnapshotBuilderCanonicalTypeIdByCid(
                tables, portable.types.typeCids[arenaTypeId])
        if finalTypeId < 0:
            err = " compiler snapshot builder: portable TypeCid missing from final table"
            return false
        finalTypeIdByArenaTypeId[arenaTypeId] = finalTypeId
    if !compilerSnapshotBuilderTypeSyntaxTypesBindingValidateInto(
           tables, csg, finalTypeIdByArenaTypeId, err):
        return false
    var portableLayoutReplay =
        snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    portableLayoutReplay.layouts =
        snapshot_schema.CsgCompilerLayoutTable()
    portableLayoutReplay.layoutFields =
        snapshot_schema.CsgCompilerLayoutFieldTable()
    if !compilerSnapshotBuilderLayoutsProjectInto(
           portableLayoutReplay,
           csg,
           finalTypeIdByArenaTypeId,
           err) ||
       portableLayoutReplay.layouts.layoutCids.len !=
           tables.layouts.layoutCids.len ||
       portableLayoutReplay.layoutFields.layoutIds.len !=
           tables.layoutFields.layoutIds.len:
        if err == "":
            err = " compiler snapshot builder: portable layout replay shape drift"
        return false
    for layoutId in 0..<tables.layouts.layoutCids.len:
        if portableLayoutReplay.layouts.typeIds[layoutId] !=
               tables.layouts.typeIds[layoutId] ||
           portableLayoutReplay.layouts.sizeBytes[layoutId] !=
               tables.layouts.sizeBytes[layoutId] ||
           portableLayoutReplay.layouts.alignBytes[layoutId] !=
               tables.layouts.alignBytes[layoutId] ||
           portableLayoutReplay.layouts.fieldStarts[layoutId] !=
               tables.layouts.fieldStarts[layoutId] ||
           portableLayoutReplay.layouts.fieldCounts[layoutId] !=
               tables.layouts.fieldCounts[layoutId] ||
           !layout.FixedBytes32Equal(
               portableLayoutReplay.layouts.layoutCids[layoutId],
               tables.layouts.layoutCids[layoutId]):
            err = " compiler snapshot builder: portable layout replay row drift"
            return false
    for fieldRow in 0..<tables.layoutFields.layoutIds.len:
        if portableLayoutReplay.layoutFields.layoutIds[fieldRow] !=
               tables.layoutFields.layoutIds[fieldRow] ||
           portableLayoutReplay.layoutFields.fieldSymbolIds[fieldRow] !=
               tables.layoutFields.fieldSymbolIds[fieldRow] ||
           portableLayoutReplay.layoutFields.typeIds[fieldRow] !=
               tables.layoutFields.typeIds[fieldRow] ||
           portableLayoutReplay.layoutFields.offsetBytes[fieldRow] !=
               tables.layoutFields.offsetBytes[fieldRow] ||
           portableLayoutReplay.layoutFields.sizeBytes[fieldRow] !=
               tables.layoutFields.sizeBytes[fieldRow] ||
           portableLayoutReplay.layoutFields.alignBytes[fieldRow] !=
               tables.layoutFields.alignBytes[fieldRow]:
            err = " compiler snapshot builder: portable layout replay Field drift"
            return false
    var typeSymbolIdsByCoordinate: int32[]
    if !compilerSnapshotBuilderTypeSymbolCoordinateIndexBuildInto(
           tables, typeSymbolIdsByCoordinate, err):
        return false
    for projectionRow in 0..<projection.declarationRows.len:
        let arenaTypeId = projection.arenaTypeIds[projectionRow]
        let signatureArenaTypeId =
            projection.signatureArenaTypeIds[projectionRow]
        let symbolId =
            compilerSnapshotBuilderTypeSymbolCoordinateFind(
                tables,
                typeSymbolIdsByCoordinate,
                projection.sourceIds[projectionRow],
                projection.nameTokenIds[projectionRow],
                projection.nameSpanIds[projectionRow],
                projection.declarationSpanIds[projectionRow])
        let declaredTypeId =
            finalTypeIdByArenaTypeId[arenaTypeId]
        let signatureTypeId =
            finalTypeIdByArenaTypeId[signatureArenaTypeId]
        if symbolId < 0 ||
           symbolId >= tables.symbols.declIds.len:
            err = " compiler snapshot builder: portable Type/Field final Symbol missing"
            return false
        let declId = tables.symbols.declIds[symbolId]
        let parserDeclarationKind =
            tables.parserSidecars.declarationKinds[
                projection.declarationRows[projectionRow]]
        let typeDeclaration =
            parserDeclarationKind ==
                Int32(parser.ParserDeclarationType)
        let declaredKind =
            tables.types.typeKinds[declaredTypeId]
        let aliasDeclaration =
            typeDeclaration &&
            declaredKind == snapshot_schema.CsgCompilerTypeAlias
        let nominalDeclaration =
            declaredKind == snapshot_schema.CsgCompilerTypeObject ||
            declaredKind == snapshot_schema.CsgCompilerTypeRefObject ||
            declaredKind == snapshot_schema.CsgCompilerTypeEnum
        let expectedSymbolKind =
            typeDeclaration ?
                snapshot_schema.CsgCompilerSymbolType :
                snapshot_schema.CsgCompilerSymbolField
        let expectedSymbolTypeId =
            aliasDeclaration ? signatureTypeId : declaredTypeId
        var interfaceCid: layout.FixedBytes32
        if tables.symbols.symbolKinds[symbolId] !=
               expectedSymbolKind ||
           tables.symbols.typeIds[symbolId] !=
               expectedSymbolTypeId ||
           (aliasDeclaration &&
            (tables.types.declSymbolIds[declaredTypeId] !=
                 symbolId ||
             tables.types.aliasTargetTypeIds[declaredTypeId] !=
                 signatureTypeId)) ||
           (nominalDeclaration && typeDeclaration &&
            tables.types.declSymbolIds[declaredTypeId] !=
                symbolId) ||
           (nominalDeclaration && !typeDeclaration &&
            tables.types.declSymbolIds[declaredTypeId] !=
                typeSymbolIdByArenaTypeId[arenaTypeId]) ||
           (!aliasDeclaration && !nominalDeclaration &&
            tables.types.declSymbolIds[declaredTypeId] ==
                symbolId) ||
           !layout.FixedBytes32Equal(
               tables.declarations.portableSignatureTypeExpressionCids[
                   declId],
               tables.types.typeCids[expectedSymbolTypeId]) ||
           !snapshot_schema.CsgCompilerSymbolInterfaceCidInto(
               tables, symbolId, interfaceCid, err) ||
           !layout.FixedBytes32Equal(
               tables.symbols.interfaceCids[symbolId],
               interfaceCid):
            if err == "":
                err = Fmt" compiler snapshot builder: portable Type final CID projection drift row={projectionRow} declaration={projection.declarationRows[projectionRow]} symbolId={symbolId} declId={declId} arenaTypeId={arenaTypeId} declaredTypeId={declaredTypeId} signatureTypeId={signatureTypeId} declaredKind={declaredKind} joinedOwnerSymbolId={typeSymbolIdByArenaTypeId[arenaTypeId]} declSymbolId={tables.types.declSymbolIds[declaredTypeId]}"
            return false
    var returnArenaTypeIds: int32[]
    var paramStarts: int32[]
    var paramCounts: int32[]
    var paramArenaTypeIds: int32[]
    var paramOwnershipKinds: int32[]
    if !compilerSnapshotBuilderTypeFunctionBindingsInto(
           tables, csg,
           returnArenaTypeIds, paramStarts,
           paramCounts, paramArenaTypeIds,
           paramOwnershipKinds, err):
        return false
    var signaturePortableTypeIdByFunction: int32[]
    for functionId in 0..<tables.functions.symbolIds.len:
        let ownershipStart =
            tables.functions.parameterOwnershipStarts[functionId]
        if ownershipStart != paramStarts[functionId] ||
           tables.functions.parameterOwnershipCounts[functionId] !=
               paramCounts[functionId]:
            err = " compiler snapshot builder: portable function ownership CSR drift"
            return false
        for offset in 0..<paramCounts[functionId]:
            if tables.functions.parameterOwnershipKinds[
                   ownershipStart + offset] !=
                   paramOwnershipKinds[
                       paramStarts[functionId] + offset]:
                err = " compiler snapshot builder: portable function ownership row drift"
                return false
        var representativeTypeId: int32 = -1
        for priorFunctionId in 0..<functionId:
            if compilerSnapshotBuilderFunctionSignatureEqual(
                   functionId, priorFunctionId,
                   returnArenaTypeIds, paramStarts,
                   paramCounts, paramArenaTypeIds):
                representativeTypeId =
                    signaturePortableTypeIdByFunction[
                        priorFunctionId]
                break
        if representativeTypeId < 0:
            var portableParamTypeIds: int32[]
            for offset in 0..<paramCounts[functionId]:
                add(portableParamTypeIds,
                    paramArenaTypeIds[
                        paramStarts[functionId] + offset])
            let returnArenaTypeId =
                returnArenaTypeIds[functionId]
            let signatureTextId =
                tables.symbols.typeIds[
                    tables.functions.symbolIds[functionId]]
            if signatureTextId < 0 ||
               signatureTextId >= tables.types.canonicalTextIds.len:
                err = " compiler snapshot builder: portable function TypeId missing"
                return false
            representativeTypeId = portable.types.typeCids.len
            compilerSnapshotBuilderAppendFunctionTypeRow(
                portable,
                returnArenaTypeId,
                portableParamTypeIds,
                0,
                portableParamTypeIds.len,
                tables.types.canonicalTextIds[signatureTextId])
            var proofCid: layout.FixedBytes32
            var typeCid: layout.FixedBytes32
            if !snapshot_schema.CsgCompilerTypeTraitProofCidInto(
                   portable, representativeTypeId,
                   proofCid, err):
                return false
            portable.types.traitProofCids[
                representativeTypeId] = proofCid
            if !snapshot_schema.CsgCompilerTypeRowCidInto(
                   portable, representativeTypeId,
                   typeCid, err):
                return false
            portable.types.typeCids[representativeTypeId] =
                typeCid
        add(signaturePortableTypeIdByFunction,
            representativeTypeId)
        let finalFunctionTypeId =
            compilerSnapshotBuilderCanonicalTypeIdByCid(
                tables,
                portable.types.typeCids[representativeTypeId])
        let functionSymbolId =
            tables.functions.symbolIds[functionId]
        if finalFunctionTypeId < 0 ||
           tables.symbols.typeIds[functionSymbolId] !=
               finalFunctionTypeId:
            err = " compiler snapshot builder: portable function TypeCid projection drift"
            return false
    if portable.types.typeCids.len !=
           tables.types.typeCids.len:
        err = " compiler snapshot builder: portable Type projection final coverage mismatch"
        return false
    if !compilerSnapshotBuilderTypeArenaBridgeStrictValidateInto(
           portable, csg, err):
        return false
    err = ""
    return true

# Exact producer projection. TypeSyntax rows bind by
# (producerSourceIndex, local TypeSyntaxId), function roots bind by the parser
# functionIndex -> reachable row -> TypedIR row chain and the declaration-owner
# token row. Text is diagnostic cargo generated only after structural binding.
# Missing target/schema/declaration authority returns an authenticated receipt
# while preserving the complete destination table byte-for-byte.
@borrows
fn CompilerSnapshotTypeFunctionSignatureTablesProjectWithReceiptInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        receipt: var CompilerSnapshotTypeProjectionReceipt,
        err: var str): bool =
    receipt = CompilerSnapshotTypeProjectionReceipt()
    if tables.types.typeCids.len != 0 ||
       !snapshot_schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
           tables, err):
        if err == "":
            err = " compiler snapshot builder: type projection destination is not empty"
        return false
    if !compilerSnapshotBuilderTypeProjectionAssessInto(
           csg, receipt, err):
        return false
    if receipt.admissionBlocked:
        err = Fmt" compiler snapshot builder: type projection authority missing stage={receipt.firstMissingStage} typeId={receipt.firstMissingTypeId}"
        return false
    var projected = snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    if !compilerSnapshotBuilderTypeFunctionProjectValidatedInto(
           projected, csg, false, err):
        return false
    receipt.projectedTypeCount = projected.types.typeCids.len
    for typeId in 0..<projected.types.typeCids.len:
        if projected.types.typeKinds[typeId] ==
               snapshot_schema.CsgCompilerTypeFunction:
            receipt.projectedFunctionSignatureCount =
                receipt.projectedFunctionSignatureCount + 1
    receipt.receiptCid =
        compilerSnapshotBuilderTypeProjectionReceiptCid(receipt)
    tables = projected
    err = ""
    return true

@borrows
fn CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    var receipt: CompilerSnapshotTypeProjectionReceipt
    return CompilerSnapshotTypeFunctionSignatureTablesProjectWithReceiptInto(
        tables, sidecars, csg, receipt, err)

@borrows
fn CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    var assessment: CompilerSnapshotTypeProjectionReceipt
    if !compilerSnapshotBuilderTypeProjectionAssessInto(
           csg, assessment, err):
        return false
    if assessment.admissionBlocked:
        err = Fmt" compiler snapshot builder: type projection authority missing stage={assessment.firstMissingStage} typeId={assessment.firstMissingTypeId}"
        return false
    return compilerSnapshotBuilderTypeFunctionSignatureProjectionValidatedInto(
        tables, sidecars, csg, err)

@borrows
fn compilerSnapshotBuilderTypeFunctionSignatureProjectionValidatedInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    if !snapshot_schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
           tables, err) ||
       !compilerSnapshotBuilderReferenceRowsStrictValidateInto(
           tables, err) ||
       !compilerSnapshotBuilderTypeArenaBridgeStrictValidateInto(
           tables, csg, err):
        return false
    return compilerSnapshotBuilderPortableTypeProjectionStrictReplayInto(
        tables, sidecars, csg, err)

fn compilerSnapshotBuilderTypeProjectionReceiptEqual(
        left: var CompilerSnapshotTypeProjectionReceipt,
        right: var CompilerSnapshotTypeProjectionReceipt): bool =
    return layout.FixedBytes32Equal(
               left.sourceBundleCid,
               right.sourceBundleCid) &&
        layout.FixedBytes32Equal(
               left.parserReceiptCid,
               right.parserReceiptCid) &&
        layout.FixedBytes32Equal(
               left.retainedFactsCid,
               right.retainedFactsCid) &&
        layout.FixedBytes32Equal(
               left.typeArenaArtifactCid,
               right.typeArenaArtifactCid) &&
        left.typeArenaTypeCount == right.typeArenaTypeCount &&
        left.typeArenaSymbolCount == right.typeArenaSymbolCount &&
        left.projectedTypeCount == right.projectedTypeCount &&
        left.projectedFunctionSignatureCount ==
            right.projectedFunctionSignatureCount &&
        left.missingTypeArenaProducerCount ==
            right.missingTypeArenaProducerCount &&
        left.missingTargetScalarWidthCount ==
            right.missingTargetScalarWidthCount &&
        left.missingSchemaKindCount == right.missingSchemaKindCount &&
        left.missingDeclarationIdentityCount ==
            right.missingDeclarationIdentityCount &&
        left.missingDeclarationLayoutCount ==
            right.missingDeclarationLayoutCount &&
        left.firstMissingStage == right.firstMissingStage &&
        left.firstMissingTypeId == right.firstMissingTypeId &&
        left.admissionBlocked == right.admissionBlocked &&
        layout.FixedBytes32Equal(left.receiptCid, right.receiptCid)

fn CompilerSnapshotTypeProjectionReceiptStrictValidateInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        csg: var ccsg.CompilerCsg,
        receipt: var CompilerSnapshotTypeProjectionReceipt,
        err: var str): bool =
    var expected: CompilerSnapshotTypeProjectionReceipt
    if !compilerSnapshotBuilderTypeProjectionAssessInto(
           csg, expected, err):
        return false
    if expected.admissionBlocked:
        if tables.types.typeCids.len != 0 ||
           !snapshot_schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               tables, err):
            if err == "":
                err = " compiler snapshot builder: blocked type projection mutated destination"
            return false
    else:
        if !compilerSnapshotBuilderTypeFunctionSignatureProjectionValidatedInto(
               tables, sidecars, csg, err):
            return false
        expected.projectedTypeCount = tables.types.typeCids.len
        for typeId in 0..<tables.types.typeCids.len:
            if tables.types.typeKinds[typeId] ==
                   snapshot_schema.CsgCompilerTypeFunction:
                expected.projectedFunctionSignatureCount =
                    expected.projectedFunctionSignatureCount + 1
        expected.receiptCid =
            compilerSnapshotBuilderTypeProjectionReceiptCid(expected)
    if !compilerSnapshotBuilderTypeProjectionReceiptEqual(
           receipt, expected):
        err = " compiler snapshot builder: type projection receipt drift"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderGraphReceiptBuildInto(
        csg: ccsg.CompilerCsg,
        prebuildFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalizedReads: incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        retainedFactsCid: layout.FixedBytes32,
        out: var CompilerSnapshotGraphProjectionReceipt) =
    out = CompilerSnapshotGraphProjectionReceipt()
    out.sourcePackageIdCid =
        csg.sourceIdentityReceipt.sourcePackageIdCid
    out.entryModulePathCid =
        csg.sourceIdentityReceipt.entryModulePathCid
    out.sourceBundleCid = csg.sourceBundleCid
    out.entrySourceCid = csg.entrySourceCid
    out.importGraphCid = csg.sourceIdentityReceipt.importGraphCid
    out.canonicalGraphCid = csg.canonicalGraphCid
    out.graphCid = csg.graphCid
    out.sourceIdentityReceiptCid = csg.sourceIdentityReceipt.receiptCid
    out.retainedFactsCid = retainedFactsCid
    out.prebuildFactsCid = prebuildFacts.factsCid
    out.finalizedReadSetReceiptCid = finalizedReads.receiptCid
    out.sourceCount = csg.sourceSnapshotCount
    out.nodeCount = csg.nodeCount
    out.edgeCount = csg.edgeCount
    for index in 0..<csg.nodes.len:
        if csg.nodes[index].nodeKind ==
               ccsg.CompilerCsgNodeKindSymbol:
            out.symbolCandidateCount = out.symbolCandidateCount + 1
    out.reachableFunctionCount =
        csg.semanticGraph.reachableFunctionTable.sourceIndex.len
    out.typedIrFunctionCount =
        csg.semanticGraph.typedIrTable.functionSourceIndexes.len
    out.resolvedCallCount = csg.semanticGraph.resolvedCallTable.sourceIndexes.len
    out.missingSymbolSourceBindingCount = 0
    # ParserNormalizedExprReceipt owns these immutable CIDs. Projection has
    # already proved the parser function row is bijectively joined to the
    # reachable graph symbol before these counts are cleared.
    out.missingSymbolDeclarationHeaderCidCount = 0
    out.missingSymbolDeclarationPathCidCount = 0
    out.missingSymbolIdentityCidCount = 0
    # Current prebuild CIDs are retained inspection facts, not certified
    # structural symbol/interface identities.  They remain explicit gaps until
    # TypeArena SymbolId-to-graph-symbol joins are available.
    out.missingSymbolInterfaceCidCount = out.symbolCandidateCount
    # CompilerCsg commits a bijective function row -> graph Symbol node column;
    # compilerSnapshotBuilderReachableShape above revalidates the exact join.
    out.missingFunctionGraphNodeBindingCount = 0
    out.missingFunctionTypedIrBindingCount =
        out.reachableFunctionCount - out.typedIrFunctionCount
    out.missingFunctionBodySpanCount = 0
    out.missingFunctionBodyContentCidCount = 0
    out.missingFunctionInterfaceCidCount = out.reachableFunctionCount
    out.missingFunctionReadSetPreimageCidCount = 0
    # Resolved-call rows carry exact caller/target graph Symbol node ids; the
    # graph validator rejects text/line drift before this receipt is built.
    out.missingResolvedTargetNodeIdCount = 0
    let functionDomainExact = out.symbolCandidateCount > 0 &&
        out.symbolCandidateCount ==
            prebuildFacts.symbolCids.len &&
        out.symbolCandidateCount ==
            prebuildFacts.functionSymbolIds.len &&
        compilerSnapshotBuilderTypedDomainExact(csg)
    let zeroFunctionDomainExact =
        out.sourceCount == 1 &&
        csg.semanticGraph.importEdgeTable.ownerSourceIndex.len == 0 &&
        out.symbolCandidateCount == 0 &&
        out.reachableFunctionCount == 0 &&
        out.typedIrFunctionCount == 0 &&
        out.resolvedCallCount == 0 &&
        prebuildFacts.symbolCids.len == 0 &&
        prebuildFacts.functionSymbolIds.len == 0 &&
        csg.typedIr.nodes2_nodeIndexs.len == 0 &&
        csg.parserNormalizedExprReceipt.functionCount == Int64(0) &&
        compilerSnapshotBuilderTypedDomainExact(csg)
    let domainExact =
        functionDomainExact || zeroFunctionDomainExact
    if domainExact:
        # Symbols/functions/read-set are committed by the exact projection;
        # declaration spans come from the parser sidecar.  The retained
        # TypedIR fragment receipt is independently checked, but it is not the
        # canonical CSG fragment until structural Type/value proofs exist.
        out.projectedSymbolCount =
            out.symbolCandidateCount + out.sourceCount
        out.projectedFunctionCount =
            prebuildFacts.functionSymbolIds.len
        out.projectedReadSetRowCount =
            finalizedReads.readSet.readerFunctionIds.len
        out.missingSymbolDeclarationSpanCount = 0
        out.missingFunctionFragmentCidCount =
            prebuildFacts.functionSymbolIds.len
    else:
        out.missingSymbolDeclarationSpanCount = 0
        out.missingFunctionFragmentCidCount =
            prebuildFacts.functionSymbolIds.len
    out.missingSymbolTypeCount = out.symbolCandidateCount
    out.missingReferenceSpanCount = out.resolvedCallCount
    out.missingResultTypeCount = out.resolvedCallCount
    out.missingResultOwnershipCount = out.resolvedCallCount
    out.missingLexicalScopeProofCount =
        zeroFunctionDomainExact ? 0 : out.sourceCount
    out.missingTypedNodeBindingCount = domainExact ?
        0 : csg.typedIr.nodes2_nodeIndexs.len
    # This is the unsealed preprojection obligation count. The production
    # candidate replays every TypedExpr structural TypeId and proof group;
    # observation is counted only after that exact replay.
    out.missingTypedNodeTypeIdCount = csg.typedIr.nodes2_nodeIndexs.len
    out.missingTypedNodeValueKindCount = csg.typedIr.nodes2_nodeIndexs.len
    out.missingTypedNodeOwnershipProofCount =
        csg.typedIr.nodes2_nodeIndexs.len
    out.missingValueSendProofCount = csg.typedIr.nodes2_nodeIndexs.len
    out.missingValueSyncProofCount = csg.typedIr.nodes2_nodeIndexs.len
    out.missingValueShareProofCount = csg.typedIr.nodes2_nodeIndexs.len
    out.missingThreadBoundaryProofCount = domainExact ?
        0 : out.reachableFunctionCount
    out.admissionBlocked = !domainExact ||
        out.missingSymbolSourceBindingCount > 0 ||
        out.missingSymbolDeclarationSpanCount > 0 ||
        out.missingSymbolDeclarationHeaderCidCount > 0 ||
        out.missingSymbolDeclarationPathCidCount > 0 ||
        out.missingSymbolIdentityCidCount > 0 ||
        out.missingSymbolTypeCount > 0 ||
        out.missingSymbolInterfaceCidCount > 0 ||
        out.missingFunctionGraphNodeBindingCount > 0 ||
        out.missingFunctionTypedIrBindingCount > 0 ||
        out.missingFunctionBodySpanCount > 0 ||
        out.missingFunctionBodyContentCidCount > 0 ||
        out.missingFunctionFragmentCidCount > 0 ||
        out.missingFunctionInterfaceCidCount > 0 ||
        out.missingFunctionReadSetPreimageCidCount > 0 ||
        out.missingResolvedTargetNodeIdCount > 0 ||
        out.missingReferenceSpanCount > 0 ||
        out.missingResultTypeCount > 0 ||
        out.missingResultOwnershipCount > 0 ||
        out.missingLexicalScopeProofCount > 0 ||
        out.missingTypedNodeBindingCount > 0 ||
        out.missingTypedNodeTypeIdCount > 0 ||
        out.missingTypedNodeValueKindCount > 0 ||
        out.missingTypedNodeOwnershipProofCount > 0 ||
        out.missingValueSendProofCount > 0 ||
        out.missingValueSyncProofCount > 0 ||
        out.missingValueShareProofCount > 0 ||
        out.missingThreadBoundaryProofCount > 0
    out.receiptCid = compilerSnapshotBuilderGraphReceiptCid(out)

fn compilerSnapshotBuilderTypedProjectionEqual(
        left: var snapshot_schema.CsgCompilerSnapshotTables,
        right: var snapshot_schema.CsgCompilerSnapshotTables): bool =
    if left.schemaVersion != right.schemaVersion ||
       left.semanticEpoch != right.semanticEpoch ||
       left.types.typeCids.len != right.types.typeCids.len ||
       left.types.producerTypeArenaIds.len !=
           right.types.producerTypeArenaIds.len ||
       left.types.argNameTextIds.len !=
           right.types.argNameTextIds.len ||
       left.parserSidecars.typeSyntaxTypeIds.len !=
           right.parserSidecars.typeSyntaxTypeIds.len ||
       left.typedStatements.typedIrStatementIndexes.len !=
           right.typedStatements.typedIrStatementIndexes.len ||
       left.typedStatements.functionIds.len !=
           right.typedStatements.functionIds.len ||
       left.typedStatements.rootStarts.len !=
           right.typedStatements.rootStarts.len ||
       left.typedStatements.rootCounts.len !=
           right.typedStatements.rootCounts.len ||
       left.typedStatements.rootTypedNodeIds.len !=
           right.typedStatements.rootTypedNodeIds.len ||
       left.typedNodes.functionIds.len != right.typedNodes.functionIds.len ||
       left.typedNodes.bindingProducerSourceIndexes.len !=
           right.typedNodes.bindingProducerSourceIndexes.len ||
       left.typedNodes.bindingParserSourceLocalNodeRows.len !=
           right.typedNodes.bindingParserSourceLocalNodeRows.len ||
       left.typedNodes.bindingDeclarationSourceLocalRows.len !=
           right.typedNodes.bindingDeclarationSourceLocalRows.len ||
       left.typedNodes.bindingPatternSourceLocalRows.len !=
           right.typedNodes.bindingPatternSourceLocalRows.len ||
       left.typedNodes.bindingValueDefinitionRows.len !=
           right.typedNodes.bindingValueDefinitionRows.len ||
       left.typedNodes.producedValueDefinitionRows.len !=
           right.typedNodes.producedValueDefinitionRows.len ||
       left.typedNodes.ownerStatementIds.len !=
           right.typedNodes.ownerStatementIds.len ||
       left.valueDefinitions.originKinds.len !=
           right.valueDefinitions.originKinds.len ||
       left.valueDefinitions.groupRows.len !=
           right.valueDefinitions.groupRows.len ||
       left.valueDefinitions.producerSourceIndexes.len !=
           right.valueDefinitions.producerSourceIndexes.len ||
       left.valueDefinitions.sourceLocalNodeIndexes.len !=
           right.valueDefinitions.sourceLocalNodeIndexes.len ||
       left.valueDefinitions.declarationSourceLocalRows.len !=
           right.valueDefinitions.declarationSourceLocalRows.len ||
       left.valueDefinitions.patternSourceLocalRows.len !=
           right.valueDefinitions.patternSourceLocalRows.len ||
       left.valueDefinitions.functionIds.len !=
           right.valueDefinitions.functionIds.len ||
       left.valueDefinitions.definingTypedNodeIds.len !=
           right.valueDefinitions.definingTypedNodeIds.len ||
       left.valueDefinitions.typeIds.len !=
           right.valueDefinitions.typeIds.len ||
       left.valueDefinitions.ownershipKinds.len !=
           right.valueDefinitions.ownershipKinds.len ||
       left.valueDefinitions.proofKinds.len !=
           right.valueDefinitions.proofKinds.len ||
       left.valueDefinitionGroups.producerSourceIndexes.len !=
           right.valueDefinitionGroups.producerSourceIndexes.len ||
       left.valueDefinitionGroups.parserProducerSourceIndexes.len !=
           right.valueDefinitionGroups.parserProducerSourceIndexes.len ||
       left.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes.len !=
           right.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes.len ||
       left.valueDefinitionGroups.bindingOffsets.len !=
           right.valueDefinitionGroups.bindingOffsets.len ||
       left.valueDefinitionGroups.bindingCounts.len !=
           right.valueDefinitionGroups.bindingCounts.len ||
       left.valueDefinitionGroups.functionIds.len !=
           right.valueDefinitionGroups.functionIds.len ||
       left.valueDefinitionGroups.declarationSourceLocalRows.len !=
           right.valueDefinitionGroups.declarationSourceLocalRows.len ||
       left.valueDefinitionGroups.patternSourceLocalRows.len !=
           right.valueDefinitionGroups.patternSourceLocalRows.len ||
       left.valueDefinitionGroups.definitionRows.len !=
           right.valueDefinitionGroups.definitionRows.len ||
       left.valueDefinitionGroups.consumedFlags.len !=
           right.valueDefinitionGroups.consumedFlags.len ||
       left.typedNodes.captureValueDefinitionRows.len !=
           right.typedNodes.captureValueDefinitionRows.len ||
       left.typedNodes.captureTypeIds.len !=
           right.typedNodes.captureTypeIds.len ||
       left.typedNodes.captureOwnershipKinds.len !=
           right.typedNodes.captureOwnershipKinds.len ||
       left.debugOps.typedNodeIds.len != right.debugOps.typedNodeIds.len ||
       left.functions.nodeStarts.len != right.functions.nodeStarts.len ||
       left.functions.valueDefinitionStarts.len !=
           right.functions.valueDefinitionStarts.len ||
       left.functions.valueDefinitionCounts.len !=
           right.functions.valueDefinitionCounts.len ||
       left.functions.valueDefinitionGroupStarts.len !=
           right.functions.valueDefinitionGroupStarts.len ||
       left.functions.valueDefinitionGroupCounts.len !=
           right.functions.valueDefinitionGroupCounts.len:
        return false
    for row in 0..<left.types.typeCids.len:
        if !layout.FixedBytes32Equal(
               left.types.typeCids[row], right.types.typeCids[row]) ||
           left.types.producerTypeArenaIds[row] !=
               right.types.producerTypeArenaIds[row] ||
           left.types.canonicalTextIds[row] !=
               right.types.canonicalTextIds[row] ||
           left.types.typeKinds[row] != right.types.typeKinds[row] ||
           left.types.scalarKinds[row] != right.types.scalarKinds[row] ||
           left.types.declSymbolIds[row] != right.types.declSymbolIds[row] ||
           left.types.elementTypeIds[row] !=
               right.types.elementTypeIds[row] ||
           left.types.arrayLengths[row] != right.types.arrayLengths[row] ||
           left.types.argStarts[row] != right.types.argStarts[row] ||
           left.types.argCounts[row] != right.types.argCounts[row] ||
           left.types.constArgStarts[row] !=
               right.types.constArgStarts[row] ||
           left.types.constArgCounts[row] !=
               right.types.constArgCounts[row] ||
           left.types.aliasTargetTypeIds[row] !=
               right.types.aliasTargetTypeIds[row] ||
           left.types.managedFlags[row] != right.types.managedFlags[row] ||
           left.types.sendFlags[row] != right.types.sendFlags[row] ||
           left.types.syncFlags[row] != right.types.syncFlags[row] ||
           left.types.traitProofKinds[row] !=
               right.types.traitProofKinds[row] ||
           !layout.FixedBytes32Equal(
               left.types.traitProofCids[row],
               right.types.traitProofCids[row]):
            return false
    for row in 0..<left.types.argNameTextIds.len:
        if left.types.argNameTextIds[row] !=
               right.types.argNameTextIds[row]:
            return false
    for row in 0..<left.parserSidecars.typeSyntaxTypeIds.len:
        if left.parserSidecars.typeSyntaxTypeIds[row] !=
               right.parserSidecars.typeSyntaxTypeIds[row]:
            return false
    for functionId in 0..<left.functions.nodeStarts.len:
        if left.functions.nodeStarts[functionId] !=
               right.functions.nodeStarts[functionId] ||
           left.functions.nodeCounts[functionId] !=
               right.functions.nodeCounts[functionId] ||
           left.functions.valueDefinitionStarts[functionId] !=
               right.functions.valueDefinitionStarts[functionId] ||
           left.functions.valueDefinitionCounts[functionId] !=
               right.functions.valueDefinitionCounts[functionId] ||
           left.functions.valueDefinitionGroupStarts[functionId] !=
               right.functions.valueDefinitionGroupStarts[functionId] ||
           left.functions.valueDefinitionGroupCounts[functionId] !=
               right.functions.valueDefinitionGroupCounts[functionId]:
            return false
    for statementId in 0..<
            left.typedStatements.typedIrStatementIndexes.len:
        if left.typedStatements.typedIrStatementIndexes[statementId] !=
               right.typedStatements.typedIrStatementIndexes[statementId] ||
           left.typedStatements.functionIds[statementId] !=
               right.typedStatements.functionIds[statementId] ||
           left.typedStatements.rootStarts[statementId] !=
               right.typedStatements.rootStarts[statementId] ||
           left.typedStatements.rootCounts[statementId] !=
               right.typedStatements.rootCounts[statementId]:
            return false
    for rootRow in 0..<left.typedStatements.rootTypedNodeIds.len:
        if left.typedStatements.rootTypedNodeIds[rootRow] !=
               right.typedStatements.rootTypedNodeIds[rootRow]:
            return false
    for row in 0..<left.typedNodes.functionIds.len:
        if left.typedNodes.typedIrNodeIndexes[row] !=
               right.typedNodes.typedIrNodeIndexes[row] ||
           left.typedNodes.bindingProducerSourceIndexes[row] !=
               right.typedNodes.bindingProducerSourceIndexes[row] ||
           left.typedNodes.bindingParserSourceLocalNodeRows[row] !=
               right.typedNodes.bindingParserSourceLocalNodeRows[row] ||
           left.typedNodes.bindingDeclarationSourceLocalRows[row] !=
               right.typedNodes.bindingDeclarationSourceLocalRows[row] ||
           left.typedNodes.bindingPatternSourceLocalRows[row] !=
               right.typedNodes.bindingPatternSourceLocalRows[row] ||
           left.typedNodes.bindingValueDefinitionRows[row] !=
               right.typedNodes.bindingValueDefinitionRows[row] ||
           left.typedNodes.producedValueDefinitionRows[row] !=
               right.typedNodes.producedValueDefinitionRows[row] ||
           left.typedNodes.ownerStatementIds[row] !=
               right.typedNodes.ownerStatementIds[row] ||
           left.typedNodes.originParserNodeIds[row] !=
               right.typedNodes.originParserNodeIds[row] ||
           left.typedNodes.syntheticOriginKinds[row] !=
               right.typedNodes.syntheticOriginKinds[row] ||
           left.typedNodes.spanAuthorityKinds[row] !=
               right.typedNodes.spanAuthorityKinds[row] ||
           left.typedNodes.functionIds[row] !=
               right.typedNodes.functionIds[row] ||
           left.typedNodes.opKinds[row] != right.typedNodes.opKinds[row] ||
           left.typedNodes.typeIds[row] != right.typedNodes.typeIds[row] ||
           left.typedNodes.valueKinds[row] !=
               right.typedNodes.valueKinds[row] ||
           left.typedNodes.captureStarts[row] !=
               right.typedNodes.captureStarts[row] ||
           left.typedNodes.captureCounts[row] !=
               right.typedNodes.captureCounts[row] ||
           left.typedNodes.ownershipKinds[row] !=
               right.typedNodes.ownershipKinds[row] ||
           left.typedNodes.ownershipProofKinds[row] !=
               right.typedNodes.ownershipProofKinds[row] ||
           !layout.FixedBytes32Equal(
               left.typedNodes.ownershipProofCids[row],
               right.typedNodes.ownershipProofCids[row]) ||
           left.typedNodes.sendConclusions[row] !=
               right.typedNodes.sendConclusions[row] ||
           left.typedNodes.sendProofKinds[row] !=
               right.typedNodes.sendProofKinds[row] ||
           !layout.FixedBytes32Equal(
               left.typedNodes.sendProofCids[row],
               right.typedNodes.sendProofCids[row]) ||
           left.typedNodes.syncProofKinds[row] !=
               right.typedNodes.syncProofKinds[row] ||
           !layout.FixedBytes32Equal(
               left.typedNodes.syncProofCids[row],
               right.typedNodes.syncProofCids[row]) ||
           left.typedNodes.syncConclusions[row] !=
               right.typedNodes.syncConclusions[row] ||
           left.typedNodes.shareKinds[row] !=
               right.typedNodes.shareKinds[row] ||
           !layout.FixedBytes32Equal(
               left.typedNodes.shareProofCids[row],
               right.typedNodes.shareProofCids[row]) ||
           left.typedNodes.spanIds[row] != right.typedNodes.spanIds[row] ||
           left.typedNodes.operand0NodeIds[row] !=
               right.typedNodes.operand0NodeIds[row] ||
           left.typedNodes.operand1NodeIds[row] !=
               right.typedNodes.operand1NodeIds[row] ||
           left.typedNodes.operand2NodeIds[row] !=
               right.typedNodes.operand2NodeIds[row]:
            return false
    for row in 0..<left.typedNodes.captureValueDefinitionRows.len:
        if left.typedNodes.captureValueDefinitionRows[row] !=
               right.typedNodes.captureValueDefinitionRows[row] ||
           left.typedNodes.captureTypeIds[row] !=
               right.typedNodes.captureTypeIds[row] ||
           left.typedNodes.captureOwnershipKinds[row] !=
               right.typedNodes.captureOwnershipKinds[row]:
            return false
    for row in 0..<left.valueDefinitions.producerSourceIndexes.len:
        if left.valueDefinitions.originKinds[row] !=
               right.valueDefinitions.originKinds[row] ||
           left.valueDefinitions.groupRows[row] !=
               right.valueDefinitions.groupRows[row] ||
           left.valueDefinitions.producerSourceIndexes[row] !=
               right.valueDefinitions.producerSourceIndexes[row] ||
           left.valueDefinitions.sourceLocalNodeIndexes[row] !=
               right.valueDefinitions.sourceLocalNodeIndexes[row] ||
           left.valueDefinitions.declarationSourceLocalRows[row] !=
               right.valueDefinitions.declarationSourceLocalRows[row] ||
           left.valueDefinitions.patternSourceLocalRows[row] !=
               right.valueDefinitions.patternSourceLocalRows[row] ||
           left.valueDefinitions.functionIds[row] !=
               right.valueDefinitions.functionIds[row] ||
           left.valueDefinitions.definingTypedNodeIds[row] !=
               right.valueDefinitions.definingTypedNodeIds[row] ||
           left.valueDefinitions.typeIds[row] !=
               right.valueDefinitions.typeIds[row] ||
           left.valueDefinitions.ownershipKinds[row] !=
               right.valueDefinitions.ownershipKinds[row] ||
           left.valueDefinitions.proofKinds[row] !=
               right.valueDefinitions.proofKinds[row]:
            return false
    for row in 0..<left.valueDefinitionGroups.producerSourceIndexes.len:
        if left.valueDefinitionGroups.producerSourceIndexes[row] !=
               right.valueDefinitionGroups.producerSourceIndexes[row] ||
           left.valueDefinitionGroups.parserProducerSourceIndexes[row] !=
               right.valueDefinitionGroups.parserProducerSourceIndexes[row] ||
           left.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                   row] !=
               right.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                   row] ||
           left.valueDefinitionGroups.bindingOffsets[row] !=
               right.valueDefinitionGroups.bindingOffsets[row] ||
           left.valueDefinitionGroups.bindingCounts[row] !=
               right.valueDefinitionGroups.bindingCounts[row] ||
           left.valueDefinitionGroups.functionIds[row] !=
               right.valueDefinitionGroups.functionIds[row] ||
           left.valueDefinitionGroups.declarationSourceLocalRows[row] !=
               right.valueDefinitionGroups.declarationSourceLocalRows[row] ||
           left.valueDefinitionGroups.patternSourceLocalRows[row] !=
               right.valueDefinitionGroups.patternSourceLocalRows[row] ||
           left.valueDefinitionGroups.definitionRows[row] !=
               right.valueDefinitionGroups.definitionRows[row] ||
           left.valueDefinitionGroups.consumedFlags[row] !=
               right.valueDefinitionGroups.consumedFlags[row]:
            return false
    for row in 0..<left.debugOps.typedNodeIds.len:
        if left.debugOps.typedNodeIds[row] !=
               right.debugOps.typedNodeIds[row] ||
           left.debugOps.functionIds[row] !=
               right.debugOps.functionIds[row] ||
           left.debugOps.spanIds[row] != right.debugOps.spanIds[row] ||
           left.debugOps.symbolIds[row] != right.debugOps.symbolIds[row] ||
           left.debugOps.opKinds[row] != right.debugOps.opKinds[row]:
            return false
    return true

fn compilerSnapshotBuilderTypedProjectionBindingValidateInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        err: var str): bool =
    var expected = snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    expected.types = snapshot_schema.CsgCompilerTypeTable()
    expected.typedStatements =
        snapshot_schema.CsgCompilerTypedStatementTable()
    expected.typedNodes = snapshot_schema.CsgCompilerTypedNodeTable()
    expected.valueDefinitions = snapshot_schema.CsgCompilerValueDefinitionTable()
    expected.valueDefinitionGroups =
        snapshot_schema.CsgCompilerValueDefinitionGroupTable()
    expected.debugOps = snapshot_schema.CsgCompilerDebugOpTable()
    if !compilerSnapshotBuilderProjectTypedNodesInto(expected, csg, err):
        return false
    if !compilerSnapshotBuilderTypedProjectionEqual(tables, expected):
        err = " compiler snapshot builder: typed-node producer projection drift"
        return false
    return true

# Read-only over `prebuildFacts`/`finalizedReads`: a strict validator only
# re-derives and compares; it never rebinds, stores or releases them.
@borrows
fn CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        prebuildFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalizedReads: incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        receipt: var CompilerSnapshotGraphProjectionReceipt,
        err: var str): bool =
    if !compilerSnapshotBuilderGraphStrictValidateInto(csg, err):
        return false
    if !compilerSnapshotBuilderPrebuildFactsValidateInto(
            tables, csg, prebuildFacts, err):
        return false
    if !compilerSnapshotBuilderFinalizedReadsValidateInto(
            tables, csg, prebuildFacts, finalizedReads, err):
        return false
    if !snapshot_schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
            tables, err) ||
       !snapshot_schema.CsgCompilerSnapshotTypedNodeProjectionTablesStrictValidateInto(
            tables, err):
        return false
    if !compilerSnapshotBuilderModuleFunctionOwnersValidateInto(
           tables, err):
        return false
    if !compilerSnapshotBuilderFinalizedReadProjectionEqual(
            tables, finalizedReads):
        err = " compiler snapshot builder: finalized read projection drift"
        return false
    if !compilerSnapshotBuilderTypedProjectionBindingValidateInto(
            tables, csg, err):
        return false
    for functionId in 0..<tables.functions.symbolIds.len:
        var expectedFragmentCid: layout.FixedBytes32
        if !compilerSnapshotBuilderFunctionFragmentCidInto(
                csg,
                tables.functions.typedFunctionIndexes[functionId],
                expectedFragmentCid,
                err) ||
           !layout.FixedBytes32Equal(
               expectedFragmentCid,
               tables.functions.fragmentCids[functionId]):
            if err == "":
                err = " compiler snapshot builder: function fragment producer binding mismatch"
            return false
    if !compilerSnapshotBuilderCidObserved(receipt.receiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.receiptCid,
           compilerSnapshotBuilderGraphReceiptCid(receipt)):
        err = " compiler snapshot builder: graph projection receipt CID invalid"
        return false
    var expected: CompilerSnapshotGraphProjectionReceipt
    compilerSnapshotBuilderGraphReceiptBuildInto(
        csg, prebuildFacts, finalizedReads,
        compilerSnapshotBuilderRetainedFactsCid(csg), expected)
    if !layout.FixedBytes32Equal(receipt.receiptCid, expected.receiptCid):
        err = " compiler snapshot builder: graph projection receipt binding mismatch"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderGraphFactsProjectFinalizedInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        prebuildFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalizedReads: incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        validatedGraph: compilerSnapshotBuilderValidatedGraphState,
        receipt: var CompilerSnapshotGraphProjectionReceipt,
        err: var str): bool =
    # `true` means the retained facts were projected exactly for inspection.
    # It never means snapshot publication: admissionBlocked remains true until
    # TypeArena TypeIds and all trait/value proof CIDs are present, and the
    # resulting partial tables cannot pass full schema/cargo admission.
    receipt = CompilerSnapshotGraphProjectionReceipt()
    if !compilerSnapshotBuilderSemanticTablesEmpty(tables):
        err = " compiler snapshot builder: semantic projection destination is not empty"
        return false
    if !compilerSnapshotBuilderValidatedGraphStateMatches(
           csg, validatedGraph):
        err = " compiler snapshot builder: validated graph capability drift"
        return false
    let retainedFactsBeforeProjection =
        compilerSnapshotBuilderRetainedFactsCid(csg)
    if !layout.FixedBytes32Equal(
           retainedFactsBeforeProjection,
           validatedGraph.retainedFactsCid):
        err = " compiler snapshot builder: retained facts changed before finalized projection"
        return false
    if !compilerSnapshotBuilderPrebuildFactsValidateInto(
            tables, csg, prebuildFacts, err):
        return false
    if !compilerSnapshotBuilderFinalizedReadsValidateInto(
            tables, csg, prebuildFacts, finalizedReads, err):
        return false
    if !compilerSnapshotBuilderTypedDomainExact(csg):
        compilerSnapshotBuilderGraphReceiptBuildInto(
            csg, prebuildFacts, finalizedReads,
            validatedGraph.retainedFactsCid, receipt)
        err = " compiler snapshot builder: exact semantic projection requires the graph symbol domain to equal the committed typed function closure"
        return false
    # Project into an independent owner first; a hard-fail anywhere leaves the
    # caller's tables byte-identical (fail-no-mutation).
    var projected = snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    if !compilerSnapshotBuilderProjectSymbolFunctionReadTablesInto(
            projected, csg, prebuildFacts, finalizedReads, err):
        return false
    let retainedFactsAfterProjection =
        compilerSnapshotBuilderRetainedFactsCid(csg)
    if !layout.FixedBytes32Equal(
           retainedFactsAfterProjection,
           retainedFactsBeforeProjection) ||
       !layout.FixedBytes32Equal(
           retainedFactsAfterProjection,
           validatedGraph.retainedFactsCid):
        err = " compiler snapshot builder: retained facts changed during finalized projection"
        return false
    tables = projected
    compilerSnapshotBuilderGraphReceiptBuildInto(
        csg, prebuildFacts, finalizedReads,
        validatedGraph.retainedFactsCid, receipt)
    # The projection committed symbols/functions/read-set/type/typed-node and
    # debug rows. Full admission stays blocked while the remaining
    # function-symbol type, reference, call and lexical-scope counts are nonzero;
    # receipt is the exact ledger of what still blocks publication.
    err = ""
    return true

# Production entry: rebuilt reads are derived from the retained CompilerCSG
# exactly once, then atomically merged with previous reusable rows. Callers
# cannot supply a finalized fixture on this path.
fn CompilerSnapshotGraphFactsProduceAndProjectInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        previous: var snapshot_schema.CsgCompilerSnapshotTables,
        current: var incremental.SemanticSnapshotIncrementalPrebuildFacts,
        plan: var incremental.SemanticSnapshotIncrementalPrebuildPlan,
        receipt: var CompilerSnapshotGraphProjectionReceipt,
        err: var str): bool =
    var validatedGraph: compilerSnapshotBuilderValidatedGraphState
    if !compilerSnapshotBuilderValidatedGraphStateMakeInto(
           csg, validatedGraph, err):
        return false
    var rebuilt: incremental.SemanticSnapshotIncrementalRebuildReadInput
    if !compilerSnapshotBuilderIncrementalRebuildReadsProduceValidatedInto(
            tables, csg, current, plan, validatedGraph, rebuilt, err):
        return false
    var finalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    if !incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
            previous, current, plan, rebuilt, finalized, err):
        return false
    if !layout.FixedBytes32Equal(
           finalized.rebuildReadProducer.producerReceiptCid,
           rebuilt.producerReceiptCid):
        err = " compiler snapshot builder: producer receipt binding mismatch"
        return false
    return compilerSnapshotBuilderGraphFactsProjectFinalizedInto(
        tables, csg, current, finalized, validatedGraph, receipt, err)
