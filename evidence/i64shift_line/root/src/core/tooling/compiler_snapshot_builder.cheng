    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingReferenceTargetSymbolCidCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingReferenceResultTypeIdCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingReferenceResultOwnershipProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.parserLexicalScopeCount)
    compilerSnapshotBuilderHashAppendU32(
