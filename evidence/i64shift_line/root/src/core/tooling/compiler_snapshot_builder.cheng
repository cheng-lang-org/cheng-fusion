                   annotationBase +
                       sidecars[producerIndex].annotationArgOwnerIds[localArg] ||
               tables.parserSidecars.annotationArgKinds[globalArg] !=
                   sidecars[producerIndex].annotationArgKinds[localArg] ||
               tables.parserSidecars.annotationArgTokenIds[globalArg] !=
                   (localToken < 0 ? -1 : tokenBase + localToken) ||
               tables.parserSidecars.annotationArgSeparatorTokenIds[
                   globalArg] !=
                   (localSeparator < 0 ? -1 :
                       tokenBase + localSeparator) ||
               tables.parserSidecars.annotationArgSpanIds[globalArg] !=
                   spanId ||
               tables.parserSidecars.annotationArgChildStarts[globalArg] !=
                   annotationArgChildBase +
                       sidecars[producerIndex].annotationArgChildStarts[
                           localArg] ||
               tables.parserSidecars.annotationArgChildCounts[globalArg] !=
                   sidecars[producerIndex].annotationArgChildCounts[
                       localArg] ||
               !layout.FixedBytes32Equal(
                   expectedArgIdentity,
                   tables.parserSidecars.annotationArgIdentityCids[
                       globalArg]):
                err = " compiler snapshot builder: exact annotation argument remap mismatch"
                return false
        for localArgChild in 0..<
                sidecars[producerIndex].annotationArgChildIds.len:
            if tables.parserSidecars.annotationArgChildIds[
                   annotationArgChildBase + localArgChild] !=
                   annotationArgBase +
                       sidecars[producerIndex].annotationArgChildIds[
                           localArgChild]:
                err = " compiler snapshot builder: exact annotation argument child remap mismatch"
                return false
        for localExpr in 0..<
                sidecars[producerIndex].normalizedExprParserNodeIds.len:
            let globalExpr = normalizedExprBase + localExpr
            let producerNodeId =
                sidecars[producerIndex].normalizedExprParserNodeIds[
                    localExpr]
            let localFunctionIndex =
                sidecars[producerIndex].normalizedExprFunctionIndexes[
                    localExpr]
            if globalExpr >=
                   tables.parserSidecars.normalizedExprParserNodeIds.len ||
               producerNodeId < 0 ||
               producerNodeId >= localNodeByProducer.len ||
               localNodeByProducer[producerNodeId] < 0 ||
               tables.parserSidecars.normalizedExprProducerSourceIds[
                   globalExpr] != sourceIndex ||
               tables.parserSidecars.normalizedExprSourceLocalRows[
                   globalExpr] !=
                   sidecars[producerIndex].normalizedExprSourceLocalRows[
                       localExpr] ||
               tables.parserSidecars.normalizedExprFunctionIndexes[
                   globalExpr] != localFunctionIndex ||
               tables.parserSidecars.normalizedExprParserNodeIds[
                   globalExpr] !=
                   nodeBase + localNodeByProducer[producerNodeId] ||
               tables.parserSidecars.normalizedExprKinds[globalExpr] !=
                   sidecars[producerIndex].normalizedExprKinds[
                       localExpr] ||
               tables.parserSidecars.normalizedExprStatementRoles[
                   globalExpr] !=
                   sidecars[producerIndex].normalizedExprStatementRoles[
                       localExpr]:
                err = " compiler snapshot builder: exact normalized expression remap mismatch"
                return false
        for localFunction in 0..<sidecars[producerIndex].functionIndexes.len:
            let globalFunction = functionBase + localFunction
            let functionNameTextId = compilerSnapshotBuilderTextFind(
                tables.texts,
                sidecars[producerIndex].functionNames[localFunction])
            let declarationSpanId =
                compilerSnapshotBuilderParserLocalSpanFind(
                    tables.spans,
                    sidecars[producerIndex],
                    sourceIndex,
                    sidecars[producerIndex].functionDeclarationSpanIds[
                        localFunction])
            let nameSpanId = compilerSnapshotBuilderParserLocalSpanFind(
                tables.spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].functionNameSpanIds[localFunction])
            let bodySpanId = compilerSnapshotBuilderParserLocalSpanFind(
                tables.spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].functionBodySpanIds[localFunction])
            if globalFunction >=
                   tables.parserSidecars.functionIndexes.len ||
               functionNameTextId < 0 || declarationSpanId < 0 ||
               nameSpanId < 0 || bodySpanId < 0 ||
               tables.parserSidecars.functionIndexes[globalFunction] !=
                   sidecars[producerIndex].functionIndexes[localFunction] ||
               tables.parserSidecars.functionNameTextIds[globalFunction] !=
                   functionNameTextId ||
               tables.parserSidecars.functionNameSurfaceKinds[
                   globalFunction] !=
                   sidecars[producerIndex].functionNameSurfaceKinds[
                       localFunction] ||
               !layout.FixedBytes32Equal(
                   tables.parserSidecars.functionNameProofCids[
                       globalFunction],
                   sidecars[producerIndex].functionNameProofCids[
                       localFunction]) ||
               tables.parserSidecars.functionSignatureLineNumbers[
                   globalFunction] !=
                   sidecars[producerIndex].functionSignatureLineNumbers[
                       localFunction] ||
               tables.parserSidecars.functionDeclarationSpanIds[
                   globalFunction] != declarationSpanId ||
               !layout.FixedBytes32Equal(
                   tables.parserSidecars.functionDeclarationHeaderCids[
                       globalFunction],
                   sidecars[producerIndex].functionDeclarationHeaderCids[
                       localFunction]) ||
               !layout.FixedBytes32Equal(
                   tables.parserSidecars.functionDeclarationPathCids[
                       globalFunction],
                   sidecars[producerIndex].functionDeclarationPathCids[
                       localFunction]) ||
               tables.parserSidecars.functionNameSpanIds[globalFunction] !=
                   nameSpanId ||
               tables.parserSidecars.functionBodySpanIds[globalFunction] !=
                   bodySpanId ||
               tables.parserSidecars.functionAnnotationFlags[
                   globalFunction] !=
                   sidecars[producerIndex].functionAnnotationFlags[
                       localFunction] ||
               tables.parserSidecars.functionManualConsumeTargetParameterOrdinals[
                   globalFunction] !=
                   sidecars[producerIndex].functionManualConsumeTargetParameterOrdinals[
                       localFunction] ||
               tables.parserSidecars.functionManualConsumeSourceParameterOrdinals[
                   globalFunction] !=
                   sidecars[producerIndex].functionManualConsumeSourceParameterOrdinals[
                       localFunction] ||
               tables.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
                   globalFunction] !=
                   (sidecars[producerIndex].functionManualConsumeTargetParameterDeclarationSourceLocalRows[
                        localFunction] < 0 ?
                        -1 :
                        declarationBase +
                            sidecars[producerIndex].functionManualConsumeTargetParameterDeclarationSourceLocalRows[
                                localFunction]) ||
               tables.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
                   globalFunction] !=
                   (sidecars[producerIndex].functionManualConsumeSourceParameterDeclarationSourceLocalRows[
                        localFunction] < 0 ?
                        -1 :
                        declarationBase +
                            sidecars[producerIndex].functionManualConsumeSourceParameterDeclarationSourceLocalRows[
                                localFunction]):
                err = " compiler snapshot builder: exact function span remap mismatch"
                return false
        nodeBase = nodeBase + sidecars[producerIndex].nodeKinds.len
        childBase = childBase + sidecars[producerIndex].nodeChildIds.len
        tokenBase = tokenBase + sidecars[producerIndex].tokenKinds.len
        genericBase = genericBase + sidecars[producerIndex].genericSpanIds.len
        regionBase = regionBase + sidecars[producerIndex].regionKinds.len
        rootBase = rootBase + sidecars[producerIndex].rootNodeIds.len
        callBase = callBase + sidecars[producerIndex].callEventNodeIds.len
        statementBase = statementBase +
            sidecars[producerIndex].statementRootNodeIds.len
        normalizedExprBase = normalizedExprBase +
            sidecars[producerIndex].normalizedExprParserNodeIds.len
        declarationBase = declarationBase +
            sidecars[producerIndex].declarationKinds.len
        declarationScopeBase = declarationScopeBase +
            sidecars[producerIndex].declarationLexicalScopeKinds.len
        patternBase = patternBase + sidecars[producerIndex].patternKinds.len
        patternChildBase = patternChildBase +
            sidecars[producerIndex].patternChildIds.len
        typeSyntaxBase = typeSyntaxBase +
            sidecars[producerIndex].typeSyntaxKinds.len
        typeSyntaxChildBase = typeSyntaxChildBase +
            sidecars[producerIndex].typeSyntaxChildIds.len
        typeBracketArgBase = typeBracketArgBase +
            sidecars[producerIndex].typeSyntaxBracketArgTokenStarts.len
        typeConstExprBase = typeConstExprBase +
            sidecars[producerIndex].typeConstExprKinds.len
        typeEnumVariantBase = typeEnumVariantBase +
            sidecars[producerIndex].typeEnumVariantProducerSourceIds.len
        genericSymbolBase = genericSymbolBase +
            sidecars[producerIndex].typeGenericSymbolProducerSourceIds.len
        genericSymbolChildBase = genericSymbolChildBase +
            sidecars[producerIndex].typeGenericSymbolChildTypeSyntaxIds.len
        annotationBase = annotationBase +
            sidecars[producerIndex].annotationProducerSourceIds.len
        annotationRootBase = annotationRootBase +
            sidecars[producerIndex].annotationArgRootIds.len
        annotationArgBase = annotationArgBase +
            sidecars[producerIndex].annotationArgProducerSourceIds.len
        annotationArgChildBase = annotationArgChildBase +
            sidecars[producerIndex].annotationArgChildIds.len
        functionBase = functionBase +
            sidecars[producerIndex].functionIndexes.len
        declarationFunctionBase =
            declarationFunctionBase + localDeclarationFunctionCount
    var projectedFunctionDeclarationCount: int32
    for declarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        if tables.parserSidecars.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationFunction):
            projectedFunctionDeclarationCount =
                projectedFunctionDeclarationCount + 1
    if nodeBase != tables.parserNodes.sourceIds.len ||
       childBase != tables.parserNodes.childNodeIds.len ||
       tokenBase != tables.tokens.sourceIds.len ||
       genericBase != tables.parserSidecars.genericSpanIds.len ||
       regionBase != tables.parserSidecars.regionKinds.len ||
       rootBase != tables.parserSidecars.rootNodeIds.len ||
       callBase != tables.parserSidecars.callEventNodeIds.len ||
       statementBase != tables.parserSidecars.statementRootNodeIds.len ||
       normalizedExprBase !=
           tables.parserSidecars.normalizedExprParserNodeIds.len ||
       declarationBase != tables.parserSidecars.declarationKinds.len ||
       declarationScopeBase !=
           tables.parserSidecars.declarationLexicalScopeKinds.len ||
       patternBase != tables.parserSidecars.patternKinds.len ||
       patternChildBase != tables.parserSidecars.patternChildIds.len ||
       typeSyntaxBase != tables.parserSidecars.typeSyntaxKinds.len ||
       typeSyntaxChildBase !=
           tables.parserSidecars.typeSyntaxChildIds.len ||
       typeBracketArgBase !=
           tables.parserSidecars.typeSyntaxBracketArgTokenStarts.len ||
       typeConstExprBase != tables.parserSidecars.typeConstExprKinds.len ||
       typeEnumVariantBase !=
           tables.parserSidecars.typeEnumVariantProducerSourceIds.len ||
       genericSymbolBase !=
           tables.parserSidecars.typeGenericSymbolProducerSourceIds.len ||
       genericSymbolChildBase !=
           tables.parserSidecars.typeGenericSymbolChildTypeSyntaxIds.len ||
       annotationBase !=
           tables.parserSidecars.annotationProducerSourceIds.len ||
       annotationRootBase != tables.parserSidecars.annotationArgRootIds.len ||
       annotationArgBase !=
           tables.parserSidecars.annotationArgProducerSourceIds.len ||
       annotationArgChildBase !=
           tables.parserSidecars.annotationArgChildIds.len ||
       declarationFunctionBase != projectedFunctionDeclarationCount ||
       functionBase != tables.parserSidecars.functionIndexes.len:
        err = " compiler snapshot builder: projection coverage mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerSnapshotParserProjectionStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: CompilerSnapshotCanonicalSourceRow[],
        completeTextInputs: str[],
        completeSpanInputs: CompilerSnapshotCanonicalSpanInput[],
        predecessorReceiptCid: layout.FixedBytes32,
        err: var str): bool =
    if !compilerSnapshotBuilderSourceInputsValidateInto(
           sidecars, sourceRows, predecessorReceiptCid, err):
        return false
    return compilerSnapshotBuilderProjectionValidate(
        tables,
        sidecars,
        sourceRows,
        completeTextInputs,
        completeSpanInputs,
        predecessorReceiptCid,
        err)

@borrows
fn CompilerSnapshotParserTablesBuildInto(
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: CompilerSnapshotCanonicalSourceRow[],
        completeTextInputs: str[],
        completeSpanInputs: CompilerSnapshotCanonicalSpanInput[],
        predecessorReceiptCid: layout.FixedBytes32,
        out: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    out = snapshot_schema.CsgCompilerSnapshotTables()
    if !compilerSnapshotBuilderSourceInputsValidateInto(
           sidecars, sourceRows, predecessorReceiptCid, err):
        return false
    var texts: str[]
    if !compilerSnapshotBuilderTextPool(
           sidecars, sourceRows, completeTextInputs, texts, err):
        return false
    var sources: snapshot_schema.CsgCompilerSourceTable
    var spans: snapshot_schema.CsgCompilerSpanTable
    if !compilerSnapshotBuilderCanonicalSpansBuildInto(
           sidecars, sourceRows, completeSpanInputs, spans, err):
        return false
    var nodes: snapshot_schema.CsgCompilerParserNodeTable
    var tokens: snapshot_schema.CsgCompilerTokenTable
    var parserSidecars: snapshot_schema.CsgCompilerParserSidecarTable
    var declarationFunctionBase: int32
    for sourceIndex in 0..<sourceRows.len:
        let source = sourceRows[sourceIndex]
        let producerIndex = source.producerSourceIndex
        let localDeclarationFunctionCount =
            compilerSnapshotBuilderParserFunctionDeclarationCount(
                sidecars[producerIndex])
        if !compilerSnapshotBuilderCountAppendSafe(
               nodes.sourceIds.len,
               sidecars[producerIndex].nodeKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               nodes.childNodeIds.len,
               sidecars[producerIndex].nodeChildIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               tokens.sourceIds.len,
               sidecars[producerIndex].tokenKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.genericSpanIds.len,
               sidecars[producerIndex].genericSpanIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.regionKinds.len,
               sidecars[producerIndex].regionKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.rootNodeIds.len,
               sidecars[producerIndex].rootNodeIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.callEventNodeIds.len,
               sidecars[producerIndex].callEventNodeIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.statementRootNodeIds.len,
               sidecars[producerIndex].statementRootNodeIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.declarationKinds.len,
               sidecars[producerIndex].declarationKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.declarationLexicalScopeKinds.len,
               sidecars[producerIndex].declarationLexicalScopeKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.patternKinds.len,
               sidecars[producerIndex].patternKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.patternChildIds.len,
               sidecars[producerIndex].patternChildIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.typeSyntaxKinds.len,
               sidecars[producerIndex].typeSyntaxKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.typeSyntaxChildIds.len,
               sidecars[producerIndex].typeSyntaxChildIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.typeSyntaxBracketArgTokenStarts.len,
               sidecars[producerIndex].typeSyntaxBracketArgTokenStarts.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.typeConstExprKinds.len,
               sidecars[producerIndex].typeConstExprKinds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.typeEnumVariantProducerSourceIds.len,
               sidecars[producerIndex].typeEnumVariantProducerSourceIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.typeGenericSymbolProducerSourceIds.len,
               sidecars[producerIndex].typeGenericSymbolProducerSourceIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.typeGenericSymbolChildTypeSyntaxIds.len,
               sidecars[producerIndex].typeGenericSymbolChildTypeSyntaxIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.annotationProducerSourceIds.len,
               sidecars[producerIndex].annotationProducerSourceIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.annotationArgRootIds.len,
               sidecars[producerIndex].annotationArgRootIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.annotationArgProducerSourceIds.len,
               sidecars[producerIndex].annotationArgProducerSourceIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.annotationArgChildIds.len,
               sidecars[producerIndex].annotationArgChildIds.len) ||
           !compilerSnapshotBuilderCountAppendSafe(
               parserSidecars.functionIndexes.len,
               sidecars[producerIndex].functionIndexes.len) ||
           localDeclarationFunctionCount >
               2147483647 - declarationFunctionBase:
            err = " compiler snapshot builder: parser table index overflow"
            return false
        let moduleTextId = compilerSnapshotBuilderTextFind(
            texts, source.modulePath)
        if moduleTextId < 0:
            var linearTextId: int32 = -1
            for candidateTextId in 0..<texts.len:
                if texts[candidateTextId] == source.modulePath:
                    linearTextId = candidateTextId
                    break
            err = Fmt" compiler snapshot builder: module text missing source={sourceIndex} producer={producerIndex} module_len={source.modulePath.len} text_count={texts.len} linear_text_id={linearTextId} module={source.modulePath}"
            return false
        add(sources.documentCids, source.documentCid)
        add(sources.modulePathTextIds, moduleTextId)
        add(sources.contentCids, source.contentCid)
        # Parser projection is an explicitly unsealed source skeleton.
        # Source interfaces depend on canonical Symbol interfaces and the
        # import DAG, so no caller-supplied CID is accepted at this boundary.
        add(sources.interfaceCids, layout.FixedBytes32())
        add(parserSidecars.sourceIds, sourceIndex)
        add(parserSidecars.producerSourceIndexes, producerIndex)
        add(parserSidecars.parserInputCids,
            sidecars[producerIndex].parserInputRaw32)
        add(parserSidecars.sidecarCids,
            sidecars[producerIndex].sidecarRaw32)

        let nodeBase = nodes.sourceIds.len
        let childBase = nodes.childNodeIds.len
        let tokenBase = tokens.sourceIds.len
        let genericBase = parserSidecars.genericSpanIds.len
        let statementRootBase =
            parserSidecars.statementRootNodeIds.len
        let declarationBase = parserSidecars.declarationKinds.len
        let declarationScopeBase =
            parserSidecars.declarationLexicalScopeKinds.len
        let patternBase = parserSidecars.patternKinds.len
        let patternChildBase = parserSidecars.patternChildIds.len
        let typeSyntaxBase = parserSidecars.typeSyntaxKinds.len
        let typeSyntaxChildBase = parserSidecars.typeSyntaxChildIds.len
        let typeBracketArgBase =
            parserSidecars.typeSyntaxBracketArgTokenStarts.len
        let typeConstExprBase = parserSidecars.typeConstExprKinds.len
        let typeEnumVariantBase =
            parserSidecars.typeEnumVariantProducerSourceIds.len
        let genericSymbolBase =
            parserSidecars.typeGenericSymbolProducerSourceIds.len
        let genericSymbolChildBase =
            parserSidecars.typeGenericSymbolChildTypeSyntaxIds.len
        let annotationBase =
            parserSidecars.annotationProducerSourceIds.len
        let annotationRootBase =
            parserSidecars.annotationArgRootIds.len
        let annotationArgBase =
            parserSidecars.annotationArgProducerSourceIds.len
        let annotationArgChildBase =
            parserSidecars.annotationArgChildIds.len
        var localNodeByProducer: int32[]
        setLen(
            localNodeByProducer,
            sidecars[producerIndex].nodeKinds.len)
        for producerNodeId in 0..<localNodeByProducer.len:
            localNodeByProducer[producerNodeId] = -1
        for localNode in 0..<sidecars[producerIndex].nodeKinds.len:
            let localParent = sidecars[producerIndex].nodeParentIds[localNode]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].nodeSpanIds[localNode])
            if spanId < 0:
                err = " compiler snapshot builder: node span missing"
                return false
            add(nodes.sourceIds, sourceIndex)
            add(nodes.producerNodeIds,
                sidecars[producerIndex].nodeProducerIds[localNode])
            add(nodes.parentNodeIds,
                localParent < 0 ? -1 : nodeBase + localParent)
            add(nodes.kinds, sidecars[producerIndex].nodeKinds[localNode])
            add(nodes.spanIds, spanId)
            add(nodes.childStarts,
                childBase + sidecars[producerIndex].nodeChildStarts[localNode])
            add(nodes.childCounts,
                sidecars[producerIndex].nodeChildCounts[localNode])
            add(nodes.genericStarts,
                genericBase +
                    sidecars[producerIndex].nodeGenericStarts[localNode])
            add(nodes.genericCounts,
                sidecars[producerIndex].nodeGenericCounts[localNode])
            add(nodes.bindingResolutionKinds,
                sidecars[producerIndex].nodeBindingResolutionKinds[
                    localNode])
            add(nodes.bindingDeclarationSourceLocalRows,
                sidecars[producerIndex].nodeBindingDeclarationSourceLocalRows[
                    localNode])
            add(nodes.bindingPatternSourceLocalRows,
                sidecars[producerIndex].nodeBindingPatternSourceLocalRows[
                    localNode])
            let producerNodeId =
                sidecars[producerIndex].nodeProducerIds[localNode]
            if producerNodeId < 0 ||
               producerNodeId >= localNodeByProducer.len ||
               localNodeByProducer[producerNodeId] >= 0:
                err = " compiler snapshot builder: parser producer node remap invalid"
                return false
            localNodeByProducer[producerNodeId] = localNode
        for localChild in 0..<sidecars[producerIndex].nodeChildIds.len:
            add(nodes.childNodeIds,
                nodeBase + sidecars[producerIndex].nodeChildIds[localChild])
        for localToken in 0..<sidecars[producerIndex].tokenKinds.len:
            let textId = compilerSnapshotBuilderTextFind(
                texts, sidecars[producerIndex].tokenValues[localToken])
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].tokenSpanIds[localToken])
            if textId < 0 || spanId < 0:
                err = " compiler snapshot builder: token proof missing"
                return false
            add(tokens.sourceIds, sourceIndex)
            add(tokens.sourceLocalRows,
                sidecars[producerIndex].tokenSourceLocalRows[localToken])
            let localParent =
                sidecars[producerIndex].tokenLexicalParentIds[localToken]
            var globalParent: int32 = -1
            if localParent >= 0:
                globalParent = tokenBase + localParent
            add(tokens.lexicalParentTokenIds, globalParent)
            add(tokens.spanIds, spanId)
            add(tokens.kinds,
                sidecars[producerIndex].tokenKinds[localToken])
            add(tokens.valueTextIds, textId)
        for localGeneric in 0..<sidecars[producerIndex].genericSpanIds.len:
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].genericSpanIds[localGeneric])
            if spanId < 0:
                err = " compiler snapshot builder: generic span missing"
                return false
            add(parserSidecars.genericSpanIds, spanId)
        for localConstExpr in 0..<
                sidecars[producerIndex].typeConstExprKinds.len:
            let localToken =
                sidecars[producerIndex].typeConstExprTokenIds[localConstExpr]
            let localLeft =
                sidecars[producerIndex].typeConstExprLeftChildIds[
                    localConstExpr]
            let localRight =
                sidecars[producerIndex].typeConstExprRightChildIds[
                    localConstExpr]
            add(parserSidecars.typeConstExprKinds,
                sidecars[producerIndex].typeConstExprKinds[localConstExpr])
            add(parserSidecars.typeConstExprProducerSourceIds, sourceIndex)
            add(parserSidecars.typeConstExprSourceTextIds,
                sidecars[producerIndex].typeConstExprSourceTextIds[
                    localConstExpr])
            add(parserSidecars.typeConstExprTokenIds,
                tokenBase + localToken)
            add(parserSidecars.typeConstExprLeftChildIds,
                localLeft < 0 ? -1 : typeConstExprBase + localLeft)
            add(parserSidecars.typeConstExprRightChildIds,
                localRight < 0 ? -1 : typeConstExprBase + localRight)
            add(parserSidecars.typeConstExprIntegerValues,
                sidecars[producerIndex].typeConstExprIntegerValues[
                    localConstExpr])
            add(parserSidecars.typeConstExprIdentityCids,
                sidecars[producerIndex].typeConstExprIdentityCids[
                    localConstExpr])
        for localTypeSyntax in 0..<
                sidecars[producerIndex].typeSyntaxKinds.len:
            let localOwnerToken =
                sidecars[producerIndex].typeSyntaxOwnerTokenIds[
                    localTypeSyntax]
            let localDeclarationOwnerToken =
                sidecars[producerIndex].typeSyntaxDeclarationOwnerTokenIds[
                    localTypeSyntax]
            let localDeclarationOwner =
                sidecars[producerIndex].typeSyntaxDeclarationOwnerIds[
                    localTypeSyntax]
            let localNameToken =
                sidecars[producerIndex].typeSyntaxNameTokenIds[localTypeSyntax]
            let localQuestionToken =
                sidecars[producerIndex].typeSyntaxQuestionTokenIds[
                    localTypeSyntax]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].typeSyntaxSpanIds[localTypeSyntax])
            if spanId < 0:
                err = " compiler snapshot builder: TypeSyntax span proof missing"
                return false
            add(parserSidecars.typeSyntaxSourceIds, sourceIndex)
            add(parserSidecars.typeSyntaxProducerSourceIds, sourceIndex)
            add(parserSidecars.typeSyntaxSourceLocalRows,
                sidecars[producerIndex].typeSyntaxSourceLocalRows[
                    localTypeSyntax])
            add(parserSidecars.typeSyntaxKinds,
                sidecars[producerIndex].typeSyntaxKinds[localTypeSyntax])
            add(parserSidecars.typeSyntaxSpanIds, spanId)
            add(parserSidecars.typeSyntaxOwnerTokenIds,
                localOwnerToken < 0 ? -1 : tokenBase + localOwnerToken)
            add(parserSidecars.typeSyntaxDeclarationOwnerTokenIds,
                localDeclarationOwnerToken < 0 ? -1 :
                    tokenBase + localDeclarationOwnerToken)
            add(parserSidecars.typeSyntaxDeclarationOwnerIds,
                localDeclarationOwner < 0 ? -1 :
                    typeSyntaxBase + localDeclarationOwner)
            add(parserSidecars.typeSyntaxGenericSymbolStarts,
                sidecars[producerIndex].typeSyntaxGenericSymbolStarts[
                    localTypeSyntax] < 0 ? -1 :
                    genericSymbolBase +
                        sidecars[producerIndex].typeSyntaxGenericSymbolStarts[
                            localTypeSyntax])
            add(parserSidecars.typeSyntaxGenericSymbolCounts,
                sidecars[producerIndex].typeSyntaxGenericSymbolCounts[
                    localTypeSyntax])
            add(parserSidecars.typeSyntaxChildStarts,
                typeSyntaxChildBase +
                    sidecars[producerIndex].typeSyntaxChildStarts[
                        localTypeSyntax])
            add(parserSidecars.typeSyntaxChildCounts,
                sidecars[producerIndex].typeSyntaxChildCounts[localTypeSyntax])
            add(parserSidecars.typeSyntaxBracketArgStarts,
                typeBracketArgBase +
                    sidecars[producerIndex].typeSyntaxBracketArgStarts[
                        localTypeSyntax])
            add(parserSidecars.typeSyntaxBracketArgCounts,
                sidecars[producerIndex].typeSyntaxBracketArgCounts[
                    localTypeSyntax])
            add(parserSidecars.typeSyntaxNameTokenIds,
                localNameToken < 0 ? -1 : tokenBase + localNameToken)
            add(parserSidecars.typeSyntaxFixedLengths,
                sidecars[producerIndex].typeSyntaxFixedLengths[
                    localTypeSyntax])
            add(parserSidecars.typeSyntaxQuestionTokenIds,
                localQuestionToken < 0 ? -1 :
                    tokenBase + localQuestionToken)
            add(parserSidecars.typeSyntaxRootKinds,
                sidecars[producerIndex].typeSyntaxRootKinds[localTypeSyntax])
            add(parserSidecars.typeSyntaxEnumVariantStarts,
                typeEnumVariantBase +
                    sidecars[producerIndex].typeSyntaxEnumVariantStarts[
                        localTypeSyntax])
            add(parserSidecars.typeSyntaxEnumVariantCounts,
                sidecars[producerIndex].typeSyntaxEnumVariantCounts[
                    localTypeSyntax])
            add(parserSidecars.typeSyntaxIdentityCids,
                layout.FixedBytes32())
            add(parserSidecars.typeSyntaxTypeIds, -1)
        for localTypeChild in 0..<
                sidecars[producerIndex].typeSyntaxChildIds.len:
            add(parserSidecars.typeSyntaxChildIds,
                typeSyntaxBase +
                    sidecars[producerIndex].typeSyntaxChildIds[localTypeChild])
        for localBracketArg in 0..<
                sidecars[producerIndex].typeSyntaxBracketArgTokenStarts.len:
            let localTypeId =
                sidecars[producerIndex].typeSyntaxBracketArgTypeIds[
                    localBracketArg]
            let localConstRoot =
                sidecars[producerIndex].typeSyntaxBracketArgConstExprRootIds[
                    localBracketArg]
            add(parserSidecars.typeSyntaxBracketArgTokenStarts,
                tokenBase +
                    sidecars[producerIndex].typeSyntaxBracketArgTokenStarts[
                        localBracketArg])
            add(parserSidecars.typeSyntaxBracketArgTokenCounts,
                sidecars[producerIndex].typeSyntaxBracketArgTokenCounts[
                    localBracketArg])
            add(parserSidecars.typeSyntaxBracketArgTypeIds,
                localTypeId < 0 ? -1 : typeSyntaxBase + localTypeId)
            add(parserSidecars.typeSyntaxBracketArgConstExprRootIds,
                localConstRoot < 0 ? -1 :
                    typeConstExprBase + localConstRoot)
        for localVariant in 0..<
                sidecars[producerIndex].typeEnumVariantProducerSourceIds.len:
            let localPayload =
                sidecars[producerIndex].typeEnumVariantPayloadTypeSyntaxIds[
                    localVariant]
            add(parserSidecars.typeEnumVariantProducerSourceIds, sourceIndex)
            add(parserSidecars.typeEnumVariantDeclarationOwnerIds,
                typeSyntaxBase +
                    sidecars[producerIndex].typeEnumVariantDeclarationOwnerIds[
                        localVariant])
            add(parserSidecars.typeEnumVariantDeclarationOwnerTokenIds,
                tokenBase +
                    sidecars[producerIndex].typeEnumVariantDeclarationOwnerTokenIds[
                        localVariant])
            add(parserSidecars.typeEnumVariantNameTokenIds,
                tokenBase +
                    sidecars[producerIndex].typeEnumVariantNameTokenIds[
                        localVariant])
            add(parserSidecars.typeEnumVariantOrdinals,
                sidecars[producerIndex].typeEnumVariantOrdinals[localVariant])
            add(parserSidecars.typeEnumVariantPayloadTypeSyntaxIds,
                localPayload < 0 ? -1 : typeSyntaxBase + localPayload)
        for localScope in 0..<
                sidecars[producerIndex].declarationLexicalScopeKinds.len:
            let localParent = sidecars[producerIndex].declarationLexicalScopeParentIds[localScope]
            let localOwner = sidecars[producerIndex].declarationLexicalScopeOwnerDeclarationIds[localScope]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].declarationLexicalScopeSpanIds[
                    localScope])
            if spanId < 0:
                err = " compiler snapshot builder: declaration scope span proof missing"
                return false
            add(parserSidecars.declarationLexicalScopeProducerSourceIds,
                sourceIndex)
            add(parserSidecars.declarationLexicalScopeSourceLocalRows,
                localScope)
            add(parserSidecars.declarationLexicalScopeKinds,
                sidecars[producerIndex].declarationLexicalScopeKinds[
                    localScope])
            add(parserSidecars.declarationLexicalScopeParentIds,
                localParent < 0 ? -1 : declarationScopeBase + localParent)
            add(parserSidecars.declarationLexicalScopeOwnerDeclarationIds,
                localOwner < 0 ? -1 : declarationBase + localOwner)
            add(parserSidecars.declarationLexicalScopeSpanIds, spanId)
        for localDeclaration in 0..<
                sidecars[producerIndex].declarationKinds.len:
            let localNameToken = sidecars[producerIndex].declarationNameTokenIds[localDeclaration]
            let localOwner = sidecars[producerIndex].declarationOwnerIds[localDeclaration]
            let localScope = sidecars[producerIndex].declarationLexicalScopeIds[localDeclaration]
            let localFunction = sidecars[producerIndex].declarationFunctionRows[localDeclaration]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].declarationSpanIds[
                    localDeclaration])
            let nameSpanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].declarationNameSpanIds[
                    localDeclaration])
            if localNameToken < 0 ||
               localNameToken >= sidecars[producerIndex].tokenKinds.len ||
               localScope < 0 ||
               localScope >= sidecars[producerIndex].declarationLexicalScopeKinds.len ||
               spanId < 0 || nameSpanId < 0:
                err = " compiler snapshot builder: declaration proof missing"
                return false
            add(parserSidecars.declarationProducerSourceIds, sourceIndex)
            add(parserSidecars.declarationSourceLocalRows, localDeclaration)
            add(parserSidecars.declarationKinds,
                sidecars[producerIndex].declarationKinds[localDeclaration])
            add(parserSidecars.declarationNameTokenIds,
                tokenBase + localNameToken)
            add(parserSidecars.declarationOwnerIds,
                localOwner < 0 ? -1 : declarationBase + localOwner)
            add(parserSidecars.declarationLexicalScopeIds,
                declarationScopeBase + localScope)
            add(parserSidecars.declarationFunctionRows,
                localFunction < 0 ? -1 :
                    declarationFunctionBase + localFunction)
            add(parserSidecars.declarationTypeSyntaxRootIds,
                sidecars[producerIndex].declarationTypeSyntaxRootIds[
                    localDeclaration] < 0 ? -1 :
                    typeSyntaxBase +
                        sidecars[producerIndex].declarationTypeSyntaxRootIds[
                            localDeclaration])
            add(parserSidecars.declarationDefaultStatementRootRows,
                sidecars[producerIndex].declarationDefaultStatementRootRows[
                        localDeclaration] < 0 ? -1 :
                    statementRootBase +
                        sidecars[producerIndex].declarationDefaultStatementRootRows[
                            localDeclaration])
            add(parserSidecars.declarationSpanIds, spanId)
            add(parserSidecars.declarationNameSpanIds, nameSpanId)
            add(parserSidecars.declarationMutableFlags,
                sidecars[producerIndex].declarationMutableFlags[
                    localDeclaration])
            add(parserSidecars.declarationExportedFlags,
                sidecars[producerIndex].declarationExportedFlags[
                    localDeclaration])
        for localPattern in 0..<sidecars[producerIndex].patternKinds.len:
            let localNameToken =
                sidecars[producerIndex].patternNameTokenIds[localPattern]
            let localScope = sidecars[producerIndex].patternOwnerLexicalScopeIds[localPattern]
            let localDeclaration = sidecars[producerIndex].patternBindingDeclarationIds[localPattern]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].patternSpanIds[localPattern])
            if localNameToken < -1 ||
               localNameToken >= sidecars[producerIndex].tokenKinds.len ||
               localScope < 0 || localScope >= sidecars[producerIndex].declarationLexicalScopeKinds.len ||
               localDeclaration < -1 ||
               localDeclaration >= sidecars[producerIndex].declarationKinds.len ||
               spanId < 0:
                err = " compiler snapshot builder: pattern proof missing"
                return false
            add(parserSidecars.patternProducerSourceIds, sourceIndex)
            add(parserSidecars.patternSourceLocalRows, localPattern)
            add(parserSidecars.patternKinds,
                sidecars[producerIndex].patternKinds[localPattern])
            add(parserSidecars.patternNameTokenIds,
                localNameToken < 0 ? -1 : tokenBase + localNameToken)
            add(parserSidecars.patternOwnerLexicalScopeIds,
                declarationScopeBase + localScope)
            add(parserSidecars.patternBindingDeclarationIds,
                localDeclaration < 0 ? -1 :
                    declarationBase + localDeclaration)
            let localPatternTypeSyntax =
                sidecars[producerIndex].patternTypeSyntaxRootIds[localPattern]
            add(parserSidecars.patternTypeSyntaxRootIds,
                localPatternTypeSyntax < 0 ? -1 :
                    typeSyntaxBase + localPatternTypeSyntax)
            add(parserSidecars.patternSpanIds, spanId)
            add(parserSidecars.patternChildStarts,
                patternChildBase +
                    sidecars[producerIndex].patternChildStarts[localPattern])
            add(parserSidecars.patternChildCounts,
                sidecars[producerIndex].patternChildCounts[localPattern])
        for localPatternChild in 0..<
                sidecars[producerIndex].patternChildIds.len:
            add(parserSidecars.patternChildIds,
                patternBase + sidecars[producerIndex].patternChildIds[
                    localPatternChild])
        for localGenericSymbol in 0..<
                sidecars[producerIndex].typeGenericSymbolProducerSourceIds.len:
            let ownerToken =
                sidecars[producerIndex].typeGenericSymbolDeclarationOwnerTokenIds[
                    localGenericSymbol]
            let nameToken =
                sidecars[producerIndex].typeGenericSymbolNameTokenIds[
                    localGenericSymbol]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].typeGenericSymbolSpanIds[
                    localGenericSymbol])
            if ownerToken < 0 ||
               ownerToken >= sidecars[producerIndex].tokenKinds.len ||
               nameToken < 0 ||
               nameToken >= sidecars[producerIndex].tokenKinds.len ||
               spanId < 0:
                err = " compiler snapshot builder: generic parameter parser proof missing"
                return false
            add(parserSidecars.typeGenericSymbolProducerSourceIds,
                sourceIndex)
            add(parserSidecars.typeGenericSymbolSourceLocalRows,
                localGenericSymbol)
            add(
                parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds,
                tokenBase + ownerToken)
            add(parserSidecars.typeGenericSymbolNameTokenIds,
                tokenBase + nameToken)
            add(parserSidecars.typeGenericSymbolOrdinals,
                sidecars[producerIndex].typeGenericSymbolOrdinals[
                    localGenericSymbol])
            add(parserSidecars.typeGenericSymbolSpanIds, spanId)
            add(parserSidecars.typeGenericSymbolOwnerTypeSyntaxIds,
                typeSyntaxBase +
                    sidecars[producerIndex].typeGenericSymbolOwnerTypeSyntaxIds[
                        localGenericSymbol])
            add(parserSidecars.typeGenericSymbolConstraintTypeSyntaxIds,
                sidecars[producerIndex].typeGenericSymbolConstraintTypeSyntaxIds[
                    localGenericSymbol] < 0 ? -1 :
                    typeSyntaxBase +
                        sidecars[producerIndex].typeGenericSymbolConstraintTypeSyntaxIds[
                            localGenericSymbol])
            add(parserSidecars.typeGenericSymbolDefaultTypeSyntaxIds,
                sidecars[producerIndex].typeGenericSymbolDefaultTypeSyntaxIds[
                    localGenericSymbol] < 0 ? -1 :
                    typeSyntaxBase +
                        sidecars[producerIndex].typeGenericSymbolDefaultTypeSyntaxIds[
                            localGenericSymbol])
            add(parserSidecars.typeGenericSymbolChildStarts,
                genericSymbolChildBase +
                    sidecars[producerIndex].typeGenericSymbolChildStarts[
                        localGenericSymbol])
            add(parserSidecars.typeGenericSymbolChildCounts,
                sidecars[producerIndex].typeGenericSymbolChildCounts[
                    localGenericSymbol])
            add(parserSidecars.typeGenericSymbolIdentityCids,
                layout.FixedBytes32())
        for localGenericChild in 0..<
                sidecars[producerIndex].typeGenericSymbolChildTypeSyntaxIds.len:
            add(parserSidecars.typeGenericSymbolChildTypeSyntaxIds,
                typeSyntaxBase +
                    sidecars[producerIndex].typeGenericSymbolChildTypeSyntaxIds[
                        localGenericChild])
        for localAnnotation in 0..<
                sidecars[producerIndex].annotationProducerSourceIds.len:
            let nameToken =
                sidecars[producerIndex].annotationNameTokenIds[localAnnotation]
            let targetToken =
                sidecars[producerIndex].annotationTargetTokenIds[
                    localAnnotation]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].annotationSpanIds[localAnnotation])
            if nameToken < 0 ||
               nameToken >= sidecars[producerIndex].tokenKinds.len ||
               targetToken < 0 ||
               targetToken >= sidecars[producerIndex].tokenKinds.len ||
               spanId < 0:
                err = " compiler snapshot builder: annotation parser proof missing"
                return false
            add(parserSidecars.annotationProducerSourceIds, sourceIndex)
            add(parserSidecars.annotationSourceLocalRows, localAnnotation)
            add(parserSidecars.annotationNameTokenIds, tokenBase + nameToken)
            add(parserSidecars.annotationTargetTokenIds,
                tokenBase + targetToken)
            add(parserSidecars.annotationSpanIds, spanId)
            add(parserSidecars.annotationArgRootStarts,
                annotationRootBase +
                    sidecars[producerIndex].annotationArgRootStarts[
                        localAnnotation])
            add(parserSidecars.annotationArgRootCounts,
                sidecars[producerIndex].annotationArgRootCounts[
                    localAnnotation])
            add(parserSidecars.annotationIdentityCids,
                layout.FixedBytes32())
        for localAnnotationRoot in 0..<
                sidecars[producerIndex].annotationArgRootIds.len:
            add(parserSidecars.annotationArgRootIds,
                annotationArgBase +
                    sidecars[producerIndex].annotationArgRootIds[
                        localAnnotationRoot])
        for localArg in 0..<
                sidecars[producerIndex].annotationArgProducerSourceIds.len:
            let owner =
                sidecars[producerIndex].annotationArgOwnerIds[localArg]
            let token =
                sidecars[producerIndex].annotationArgTokenIds[localArg]
            let separator =
                sidecars[producerIndex].annotationArgSeparatorTokenIds[
                    localArg]
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans, sidecars[producerIndex], sourceIndex,
                sidecars[producerIndex].annotationArgSpanIds[localArg])
            if owner < 0 ||
               owner >=
                   sidecars[producerIndex].annotationProducerSourceIds.len ||
               token < -1 ||
               token >= sidecars[producerIndex].tokenKinds.len ||
               separator < -1 ||
               separator >= sidecars[producerIndex].tokenKinds.len ||
               spanId < 0:
                err = " compiler snapshot builder: annotation argument parser proof missing"
                return false
            add(parserSidecars.annotationArgProducerSourceIds, sourceIndex)
            add(parserSidecars.annotationArgSourceLocalRows, localArg)
            add(parserSidecars.annotationArgOwnerIds, annotationBase + owner)
            add(parserSidecars.annotationArgKinds,
                sidecars[producerIndex].annotationArgKinds[localArg])
            add(parserSidecars.annotationArgTokenIds,
                token < 0 ? -1 : tokenBase + token)
            add(parserSidecars.annotationArgSeparatorTokenIds,
                separator < 0 ? -1 : tokenBase + separator)
            add(parserSidecars.annotationArgSpanIds, spanId)
            add(parserSidecars.annotationArgChildStarts,
                annotationArgChildBase +
                    sidecars[producerIndex].annotationArgChildStarts[
                        localArg])
            add(parserSidecars.annotationArgChildCounts,
                sidecars[producerIndex].annotationArgChildCounts[localArg])
            add(parserSidecars.annotationArgIdentityCids,
                layout.FixedBytes32())
        for localArgChild in 0..<
                sidecars[producerIndex].annotationArgChildIds.len:
            add(parserSidecars.annotationArgChildIds,
                annotationArgBase +
                    sidecars[producerIndex].annotationArgChildIds[
                        localArgChild])
        for localRegion in 0..<sidecars[producerIndex].regionKinds.len:
            let spanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].regionSpanIds[localRegion])
            if spanId < 0:
                err = " compiler snapshot builder: region span missing"
                return false
            add(parserSidecars.regionKinds,
                sidecars[producerIndex].regionKinds[localRegion])
            add(parserSidecars.regionSpanIds, spanId)
            add(parserSidecars.regionAnchorTokenIds,
                tokenBase +
                    sidecars[producerIndex].regionAnchorTokenIds[localRegion])
        for localRoot in 0..<sidecars[producerIndex].rootNodeIds.len:
            add(parserSidecars.rootNodeIds,
                nodeBase + sidecars[producerIndex].rootNodeIds[localRoot])
        for localCall in 0..<sidecars[producerIndex].callEventNodeIds.len:
            add(parserSidecars.callEventNodeIds,
                nodeBase +
                    sidecars[producerIndex].callEventNodeIds[localCall])
        for localStatement in 0..<
                sidecars[producerIndex].statementRootNodeIds.len:
            add(parserSidecars.statementRootNodeIds,
                nodeBase +
                    sidecars[producerIndex].statementRootNodeIds[
                        localStatement])
            add(parserSidecars.statementRootRoles,
                sidecars[producerIndex].statementRootRoles[localStatement])
            add(parserSidecars.statementRootAnchorTokenIds,
                tokenBase +
                    sidecars[producerIndex].statementRootAnchorTokenIds[
                        localStatement])
            let localBindingDeclarationStart =
                sidecars[producerIndex].statementRootBindingDeclarationStarts[
                    localStatement]
            add(parserSidecars.statementRootBindingDeclarationStarts,
                localBindingDeclarationStart < 0 ? -1 :
                    declarationBase + localBindingDeclarationStart)
            add(parserSidecars.statementRootBindingDeclarationCounts,
                sidecars[producerIndex].statementRootBindingDeclarationCounts[
                    localStatement])
            add(parserSidecars.statementRootAnchorLines,
                sidecars[producerIndex].statementRootAnchorLines[
                    localStatement])
            add(parserSidecars.statementRootAnchorColumns,
                sidecars[producerIndex].statementRootAnchorColumns[
                    localStatement])
            add(parserSidecars.statementRootEndLines,
                sidecars[producerIndex].statementRootEndLines[localStatement])
            add(parserSidecars.statementRootEndColumns,
                sidecars[producerIndex].statementRootEndColumns[
                    localStatement])
        for localExpr in 0..<
                sidecars[producerIndex].normalizedExprParserNodeIds.len:
            let producerNodeId =
                sidecars[producerIndex].normalizedExprParserNodeIds[
                    localExpr]
            if producerNodeId < 0 ||
               producerNodeId >= localNodeByProducer.len ||
               localNodeByProducer[producerNodeId] < 0:
                err = " compiler snapshot builder: normalized expression parser node remap missing"
                return false
            add(parserSidecars.normalizedExprProducerSourceIds,
                sourceIndex)
            add(parserSidecars.normalizedExprSourceLocalRows,
                sidecars[producerIndex].normalizedExprSourceLocalRows[
                    localExpr])
            add(parserSidecars.normalizedExprFunctionIndexes,
                sidecars[producerIndex].normalizedExprFunctionIndexes[
                    localExpr])
            add(parserSidecars.normalizedExprParserNodeIds,
                nodeBase + localNodeByProducer[producerNodeId])
            add(parserSidecars.normalizedExprKinds,
                sidecars[producerIndex].normalizedExprKinds[localExpr])
            add(parserSidecars.normalizedExprStatementRoles,
                sidecars[producerIndex].normalizedExprStatementRoles[
                    localExpr])
        for localFunction in 0..<sidecars[producerIndex].functionIndexes.len:
            let nameTextId = compilerSnapshotBuilderTextFind(
                texts, sidecars[producerIndex].functionNames[localFunction])
            let declarationSpanId =
                compilerSnapshotBuilderParserLocalSpanFind(
                    spans,
                    sidecars[producerIndex],
                    sourceIndex,
                    sidecars[producerIndex].functionDeclarationSpanIds[
                        localFunction])
            let nameSpanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].functionNameSpanIds[localFunction])
            let bodySpanId = compilerSnapshotBuilderParserLocalSpanFind(
                spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].functionBodySpanIds[localFunction])
            if nameTextId < 0 || declarationSpanId < 0 ||
               nameSpanId < 0 || bodySpanId < 0:
                err = " compiler snapshot builder: function span proof missing"
                return false
            add(parserSidecars.functionIndexes,
                sidecars[producerIndex].functionIndexes[localFunction])
            add(parserSidecars.functionNameTextIds, nameTextId)
            add(parserSidecars.functionNameSurfaceKinds,
                sidecars[producerIndex].functionNameSurfaceKinds[
                    localFunction])
            add(parserSidecars.functionNameProofCids,
                sidecars[producerIndex].functionNameProofCids[
                    localFunction])
            add(parserSidecars.functionSignatureLineNumbers,
                sidecars[producerIndex].functionSignatureLineNumbers[
                    localFunction])
            add(parserSidecars.functionDeclarationSpanIds,
                declarationSpanId)
            add(parserSidecars.functionDeclarationHeaderCids,
                sidecars[producerIndex].functionDeclarationHeaderCids[
                    localFunction])
            add(parserSidecars.functionDeclarationPathCids,
                sidecars[producerIndex].functionDeclarationPathCids[
                    localFunction])
            add(parserSidecars.functionNameSpanIds, nameSpanId)
            add(parserSidecars.functionBodySpanIds, bodySpanId)
            add(parserSidecars.functionAnnotationFlags,
                sidecars[producerIndex].functionAnnotationFlags[
                    localFunction])
            add(parserSidecars.functionManualConsumeTargetParameterOrdinals,
                sidecars[producerIndex].functionManualConsumeTargetParameterOrdinals[
                    localFunction])
            add(parserSidecars.functionManualConsumeTargetParameterDeclarationIds,
                sidecars[producerIndex].functionManualConsumeTargetParameterDeclarationSourceLocalRows[
                    localFunction] < 0 ?
                    -1 :
                    declarationBase +
                        sidecars[producerIndex].functionManualConsumeTargetParameterDeclarationSourceLocalRows[
                            localFunction])
            add(parserSidecars.functionManualConsumeSourceParameterOrdinals,
                sidecars[producerIndex].functionManualConsumeSourceParameterOrdinals[
                    localFunction])
            add(parserSidecars.functionManualConsumeSourceParameterDeclarationIds,
                sidecars[producerIndex].functionManualConsumeSourceParameterDeclarationSourceLocalRows[
                    localFunction] < 0 ?
                    -1 :
                    declarationBase +
                        sidecars[producerIndex].functionManualConsumeSourceParameterDeclarationSourceLocalRows[
                            localFunction])
        declarationFunctionBase =
            declarationFunctionBase + localDeclarationFunctionCount
    if spans.sourceIds.len <= 0 || nodes.sourceIds.len <= 0 ||
       tokens.sourceIds.len <= 0:
        err = " compiler snapshot builder: parser projection is empty"
        return false
    out.schemaVersion = snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    # Parser-owned skeletons are intentionally unpublished. Production binds
    # the exact accepted sourceVersion immediately after this build.
    out.semanticEpoch = 0
    out.predecessorReceiptCid = predecessorReceiptCid
    out.texts = texts
    out.sources = sources
    out.spans = spans
    out.parserNodes = nodes
    out.tokens = tokens
    out.parserSidecars = parserSidecars
    for row in 0..<out.parserSidecars.typeSyntaxKinds.len:
        var identityCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerParserTypeSyntaxIdentityCidInto(
               out, row, identityCid, err):
            out = snapshot_schema.CsgCompilerSnapshotTables()
            return false
        out.parserSidecars.typeSyntaxIdentityCids[row] = identityCid
    for row in 0..<
            out.parserSidecars.typeGenericSymbolProducerSourceIds.len:
        var identityCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerParserGenericParameterIdentityCidInto(
               out, row, identityCid, err):
            out = snapshot_schema.CsgCompilerSnapshotTables()
            return false
        out.parserSidecars.typeGenericSymbolIdentityCids[row] = identityCid
    for row in 0..<
            out.parserSidecars.annotationArgProducerSourceIds.len:
        var identityCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerParserAnnotationArgIdentityCidInto(
               out, row, identityCid, err):
            out = snapshot_schema.CsgCompilerSnapshotTables()
            return false
        out.parserSidecars.annotationArgIdentityCids[row] = identityCid
    for row in 0..<out.parserSidecars.annotationProducerSourceIds.len:
        var identityCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerParserAnnotationIdentityCidInto(
               out, row, identityCid, err):
            out = snapshot_schema.CsgCompilerSnapshotTables()
            return false
        out.parserSidecars.annotationIdentityCids[row] = identityCid
    if !compilerSnapshotBuilderProjectionValidate(
           out,
           sidecars,
           sourceRows,
           completeTextInputs,
           completeSpanInputs,
           predecessorReceiptCid,
           err):
        out = snapshot_schema.CsgCompilerSnapshotTables()
        return false
    err = ""
    return true

fn compilerSnapshotBuilderHashAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (Int64(value) >> 24) & 255)
    layout.ByteBufAppendByte(buf, (Int64(value) >> 16) & 255)
    layout.ByteBufAppendByte(buf, (Int64(value) >> 8) & 255)
    layout.ByteBufAppendByte(buf, Int64(value) & 255)

fn compilerSnapshotBuilderHashAppendI64(
        buf: var layout.ByteBuf,
        value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn compilerSnapshotBuilderHashAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    compilerSnapshotBuilderHashAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[index])

@borrows
fn compilerSnapshotBuilderHashAppendCid(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn compilerSnapshotBuilderHashFinish(
        buf: var layout.ByteBuf): layout.FixedBytes32 =
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn compilerSnapshotProductionVersionedRequiredDomainCid(
        baseCid: layout.FixedBytes32,
        semanticEpoch: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.required_domain")
    compilerSnapshotBuilderHashAppendU32(
        buf, snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest)
    compilerSnapshotBuilderHashAppendI64(buf, semanticEpoch)
    compilerSnapshotBuilderHashAppendCid(buf, baseCid)
    return compilerSnapshotBuilderHashFinish(buf)

fn compilerSnapshotBuilderSemanticTablesEmpty(
        tables: var snapshot_schema.CsgCompilerSnapshotTables): bool =
    return tables.symbols.symbolCids.len == 0 &&
           tables.symbols.interfaceCids.len == 0 &&
           tables.symbols.declIds.len == 0 &&
           tables.symbols.declKeyCids.len == 0 &&
           tables.symbols.declarationHeaderCids.len == 0 &&
           tables.symbols.declarationPathCids.len == 0 &&
           tables.symbols.sourceIds.len == 0 &&
           tables.symbols.nameTextIds.len == 0 &&
           tables.symbols.nameSpanIds.len == 0 &&
           tables.symbols.nameTokenIds.len == 0 &&
           tables.symbols.qualifiedNameTextIds.len == 0 &&
           tables.symbols.symbolKinds.len == 0 &&
           tables.symbols.typeIds.len == 0 &&
           tables.symbols.declarationSpanIds.len == 0 &&
           tables.symbols.ownerSymbolIds.len == 0 &&
           tables.symbols.functionIds.len == 0 &&
           tables.symbols.externFunctionIds.len == 0 &&
