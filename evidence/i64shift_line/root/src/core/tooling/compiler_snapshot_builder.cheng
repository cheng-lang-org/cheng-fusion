const CompilerSnapshotAdmissionStageParser: int32 = 4
const CompilerSnapshotAdmissionStageCompilerCsg: int32 = 8
const CompilerSnapshotAdmissionStageAssessment: int32 = 16
const CompilerSnapshotAdmissionMissingSourceInterface: int32 = 1
const CompilerSnapshotAdmissionMissingTypeArenaBinding: int32 = 2
const CompilerSnapshotAdmissionMissingSymbolInterface: int32 = 4
const CompilerSnapshotAdmissionMissingFunctionInterface: int32 = 8
const CompilerSnapshotAdmissionMissingTypedNodeProof: int32 = 16
const CompilerSnapshotAdmissionMissingReferenceProof: int32 = 32
const CompilerSnapshotAdmissionMissingLexicalScope: int32 = 64
const CompilerSnapshotAdmissionMissingDependencyProof: int32 = 128
const CompilerSnapshotAdmissionMissingDiagnosticProof: int32 = 256
const compilerSnapshotParserFunctionOwnerNone: int32 = 0
const compilerSnapshotParserFunctionOwnerExecutable: int32 = 1
const compilerSnapshotParserFunctionOwnerNonExecutable: int32 = 2
const CompilerSnapshotTypeProjectionStageNone: int32 = 0
const CompilerSnapshotTypeProjectionStageTypeArenaProducer: int32 = 1
const CompilerSnapshotTypeProjectionStageTargetScalarWidth: int32 = 2
const CompilerSnapshotTypeProjectionStageSchemaKind: int32 = 3
const CompilerSnapshotTypeProjectionStageDeclarationIdentity: int32 = 4
const CompilerSnapshotTypeProjectionStageDeclarationLayout: int32 = 5

type
    # Source identity is fixed before parser projection.  This array is in
    # canonical documentCid order; producerSourceIndex binds each row to the
    # immutable parser producer order without rewriting the producer receipt.
    CompilerSnapshotCanonicalSourceRow =
        documentCid: layout.FixedBytes32
        producerSourceIndex: int32
        modulePath: str
        contentCid: layout.FixedBytes32

    # Complete non-parser span inputs are supplied before any table ID is
    # assigned.  sourceIndex is the canonical source row, never producer order.
    CompilerSnapshotCanonicalSpanInput =
        sourceIndex: int32
        startByte: int32
        endByte: int32
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32

    # Production hard-fail receipt for the current retained CompilerCSG
    # boundary. It records only independently revalidated parser/CSG facts and
    # exact missing producer columns. It is not a publishable snapshot and it
    # cannot be converted into source/interface/type identities.
    CompilerSnapshotProductionAdmissionReceipt =
        schemaVersion: int32
        semanticEpoch: int64
        sourceIdentityReceiptCid: layout.FixedBytes32
        parserReceiptCid: layout.FixedBytes32
        compilerCsgTransitionReceiptCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        importGraphCid: layout.FixedBytes32
        canonicalGraphCid: layout.FixedBytes32
        graphCid: layout.FixedBytes32
        retainedFactsCid: layout.FixedBytes32
        typeArenaArtifactCid: layout.FixedBytes32
        dependencyProofCid: layout.FixedBytes32
        sourceInterfaceProofCid: layout.FixedBytes32
        symbolInterfaceProofCid: layout.FixedBytes32
        functionInterfaceRequiredDomainCid: layout.FixedBytes32
        functionInterfaceProofCid: layout.FixedBytes32
        typedNodeProofCid: layout.FixedBytes32
        referenceRequiredDomainCid: layout.FixedBytes32
        referenceProofCid: layout.FixedBytes32
        lexicalScopeRequiredDomainCid: layout.FixedBytes32
        lexicalScopeProofCid: layout.FixedBytes32
        diagnosticRequiredDomainCid: layout.FixedBytes32
        diagnosticProofCid: layout.FixedBytes32
        completedStageBitmap: int32
        missingFactBitmap: int32
        sourceCount: int32
        symbolCount: int32
        reachableFunctionCount: int32
        typedNodeCount: int32
        parserTypedExpressionCount: int32
        typedNodeRequiredCount: int32
        resolvedCallCount: int32
        dependencyCount: int32
        typeArenaProducerSourceCount: int32
        typeArenaTypeCount: int32
        typeArenaSymbolCount: int32
        missingSourceInterfaceCount: int32
        missingTypeArenaSourceBindingCount: int32
        missingTypeArenaResolutionAuthorityCount: int32
        missingSymbolInterfaceCount: int32
        missingSymbolDeclarationInterfaceCount: int32
        missingSymbolGenericInterfaceCount: int32
        missingSymbolAnnotationTargetBindingCount: int32
        missingFunctionInterfaceCount: int32
        missingFunctionOwnerIdentityCount: int32
        missingFunctionParameterTypeCount: int32
        missingFunctionParameterOwnershipCount: int32
        missingFunctionReturnTypeCount: int32
        missingFunctionGenericIdentityCount: int32
        missingFunctionSourceBindingCount: int32
        missingTypedNodeProofCount: int32
        missingParserTypedExpressionIdentityCount: int32
        missingTypedNodeDeclarationIdentityCount: int32
        missingTypedNodeTypeIdCount: int32
        missingTypedNodeValueDefinitionCount: int32
        missingTypedNodeOwnershipProofCount: int32
        missingTypedNodeCaptureProofCount: int32
        missingTypedNodeSourceBindingCount: int32
        missingReferenceProofCount: int32
        missingReferenceParserNodeIdentityCount: int32
        missingReferenceOwnerFunctionIdentityCount: int32
        missingReferenceSpanCount: int32
        missingReferenceTargetDeclarationIdentityCount: int32
        missingReferenceTargetSymbolCidCount: int32
        missingReferenceResultTypeIdCount: int32
        missingReferenceResultOwnershipProofCount: int32
        parserLexicalScopeCount: int32
        typedLexicalScopeCount: int32
        statementLexicalScopeUseCount: int32
        lexicalScopeRequiredCount: int32
        missingLexicalScopeProofCount: int32
        missingParserLexicalScopeIdentityCount: int32
        missingTypedLexicalScopeIdentityCount: int32
        missingStatementLexicalScopeUseCount: int32
        missingLexicalScopeBridgeCount: int32
        missingLexicalScopeOwnerDeclarationIdentityCount: int32
        missingLexicalScopeOwnerFunctionIdentityCount: int32
        missingLexicalScopeSpanCount: int32
        missingLexicalScopeVisibleSymbolProofCount: int32
        missingDependencyProofCount: int32
        diagnosticProducerKindCount: int32
        diagnosticCompletionRequiredCount: int32
        diagnosticProducedRowCount: int32
        missingDiagnosticCompletionCount: int32
        missingDiagnosticSourceIdentityCount: int32
        missingDiagnosticProducerKindCount: int32
        missingDiagnosticSpanIdentityCount: int32
        missingDiagnosticParserNodeIdentityCount: int32
        missingDiagnosticOwnerDeclarationIdentityCount: int32
        missingDiagnosticProofCount: int32
        admissionBlocked: bool
        receiptCid: layout.FixedBytes32

    compilerSnapshotProductionScopeDomainCounts =
        parserScopeCount: int32
        typedScopeCount: int32
        statementScopeUseCount: int32
        parserOwnedScopeCount: int32

    # Producer-order source-local denominator. It is built exclusively from
    # parser, TypeArena and TypedExpr retained facts before any snapshot output
    # row is consulted.
    compilerSnapshotProductionDiagnosticRequiredDomain =
        completionRequiredStarts: int32[]
        completionRequiredCounts: int32[]
        requiredProducerIds: int32[]
        requiredProducerCids: layout.FixedBytes32[]
        baseCid: layout.FixedBytes32

    compilerSnapshotProductionCandidateExpectedReceipt =
        receiptCid: layout.FixedBytes32
        missingFactBitmap: int32
        missingSourceInterfaceCount: int32
        missingTypedNodeProofCount: int32
        missingReferenceProofCount: int32
        missingSymbolInterfaceCount: int32
        completedStageBitmap: int32
        typeArenaTypeCount: int32
        typeArenaSymbolCount: int32
        retainedFactsCid: layout.FixedBytes32
        lexicalScopeRequiredDomainCid: layout.FixedBytes32
        functionInterfaceProofCid: layout.FixedBytes32
        sourceInterfaceProofCid: layout.FixedBytes32
        symbolInterfaceProofCid: layout.FixedBytes32
        typedNodeProofCid: layout.FixedBytes32
        referenceProofCid: layout.FixedBytes32
        lexicalScopeProofCid: layout.FixedBytes32
        diagnosticProofCid: layout.FixedBytes32

    compilerSnapshotProductionTypedNodeProofCounts =
        completeProofCount: int32
        missingShareProofCount: int32

    compilerSnapshotResolvedCallProjectionRow =
        sourceId: int32
        spanId: int32
        callerFunctionId: int32
        calleeSymbolId: int32
        targetCallDeclarationRow: int32
        targetSourceId: int32
        targetSourceLocalDeclarationRow: int32
        targetParserDeclarationRow: int32
        targetDeclId: int32
        resultTypedNodeId: int32
        resultTypeId: int32
        resultOwnershipKind: int32

    # Exact graph integrity is proven first.  This is an inspection receipt,
    # never a publish/admission receipt and never a semantic snapshot binding.
    # Projection commits only the
    # tables whose producer columns are retained exactly (symbols, functions,
    # read-set); every remaining table keeps an explicit missing count and
    # blocks full admission instead of being approximated.
    CompilerSnapshotGraphProjectionReceipt =
        sourcePackageIdCid: layout.FixedBytes32
        entryModulePathCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        entrySourceCid: layout.FixedBytes32
        importGraphCid: layout.FixedBytes32
        canonicalGraphCid: layout.FixedBytes32
        graphCid: layout.FixedBytes32
        sourceIdentityReceiptCid: layout.FixedBytes32
        retainedFactsCid: layout.FixedBytes32
        prebuildFactsCid: layout.FixedBytes32
        finalizedReadSetReceiptCid: layout.FixedBytes32
        sourceCount: int32
        nodeCount: int32
        edgeCount: int32
        symbolCandidateCount: int32
        reachableFunctionCount: int32
        typedIrFunctionCount: int32
        resolvedCallCount: int32
        projectedSymbolCount: int32
        projectedFunctionCount: int32
        projectedReferenceCount: int32
        projectedCallCount: int32
        projectedReadSetRowCount: int32
        missingSymbolSourceBindingCount: int32
        missingSymbolDeclarationSpanCount: int32
        missingSymbolDeclarationHeaderCidCount: int32
        missingSymbolDeclarationPathCidCount: int32
        missingSymbolIdentityCidCount: int32
        missingSymbolTypeCount: int32
        missingSymbolInterfaceCidCount: int32
        missingFunctionGraphNodeBindingCount: int32
        missingFunctionTypedIrBindingCount: int32
        missingFunctionBodySpanCount: int32
        missingFunctionBodyContentCidCount: int32
        missingFunctionFragmentCidCount: int32
        missingFunctionInterfaceCidCount: int32
        missingFunctionReadSetPreimageCidCount: int32
        missingResolvedTargetNodeIdCount: int32
        missingReferenceSpanCount: int32
        missingResultTypeCount: int32
        missingResultOwnershipCount: int32
        missingLexicalScopeProofCount: int32
        missingTypedNodeBindingCount: int32
        missingTypedNodeTypeIdCount: int32
        missingTypedNodeValueKindCount: int32
        missingTypedNodeOwnershipProofCount: int32
        missingValueSendProofCount: int32
        missingValueSyncProofCount: int32
        missingValueShareProofCount: int32
        missingThreadBoundaryProofCount: int32
        admissionBlocked: bool
        receiptCid: layout.FixedBytes32

    # A blocked receipt is still authenticated evidence: the caller can tell
    # which producer authority is missing without receiving a partially
    # mutated type table.  firstMissingTypeId is a TypeArena row, never a text
    # or name+arity approximation.
    CompilerSnapshotTypeProjectionReceipt =
        sourceBundleCid: layout.FixedBytes32
        parserReceiptCid: layout.FixedBytes32
        retainedFactsCid: layout.FixedBytes32
        typeArenaArtifactCid: layout.FixedBytes32
        typeArenaTypeCount: int32
        typeArenaSymbolCount: int32
        projectedTypeCount: int32
        projectedFunctionSignatureCount: int32
        missingTypeArenaProducerCount: int32
        missingTargetScalarWidthCount: int32
        missingSchemaKindCount: int32
        missingDeclarationIdentityCount: int32
        missingDeclarationLayoutCount: int32
        firstMissingStage: int32
        firstMissingTypeId: int32
        admissionBlocked: bool
        receiptCid: layout.FixedBytes32

    # Stage-local structural bridge from parser declaration rows to TypeArena
    # rows.  It carries only exact integer coordinates; final SymbolId,
    # DeclKey and TypeCid are joined after every Symbol producer has finished
    # and the single global Symbol remap has committed.
    CompilerSnapshotPortableTypeProjection =
        declarationRows: int32[]
        sourceIds: int32[]
        producerSourceIndexes: int32[]
        sourceLocalDeclarationRows: int32[]
        arenaTypeIds: int32[]
        arenaTypeSyntaxRows: int32[]
        signatureArenaTypeIds: int32[]
        nameTokenIds: int32[]
        nameSpanIds: int32[]
        declarationSpanIds: int32[]

    # Module-private capability minted only after the complete retained graph
    # has passed strict validation.  Production projection keeps it in one
    # synchronous stack frame; no public API can construct or retain it.
    compilerSnapshotBuilderValidatedGraphState =
        validated: bool
        sourceIdentityReceiptCid: layout.FixedBytes32
        parserReceiptCid: layout.FixedBytes32
        compilerCsgTransitionReceiptCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        entrySourceCid: layout.FixedBytes32
        canonicalGraphCid: layout.FixedBytes32
        graphCid: layout.FixedBytes32
        retainedFactsCid: layout.FixedBytes32
        typeArenaArtifactCid: layout.FixedBytes32
        typeArenaPresent: bool
        typeArenaMissingResolutionAuthorityCount: int32
        typeArenaProducerSourceCount: int32
        sourceSnapshotCount: int32
        nodeCount: int32
        edgeCount: int32
        reachableFunctionCount: int32
        typedFunctionCount: int32
        resolvedCallCount: int32

@borrows
fn compilerSnapshotBuilderTextLess(left: str, right: str): bool =
    if left == right:
        return false
    let shared = left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] != right[index]:
            return left[index] < right[index]
    return left.len < right.len

@borrows
fn compilerSnapshotBuilderTextRepresentable(value: str): bool =
    if value == "":
        return false
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 && value[index] != '\n' && value[index] != '\r' &&
           value[index] != '\t':
            return false
    return true

fn compilerSnapshotBuilderSwapTextOrder(order: var int32[],
                                        left: int32,
                                        right: int32) =
    let saved = order[left]
    order[left] = order[right]
    order[right] = saved

@borrows
fn compilerSnapshotBuilderTextOrderSiftDown(
        values: str[],
        order: var int32[],
        start: int32,
        count: int32) =
    var root: int32 = start
    while root >= 0 && root < count:
        let left = root * 2 + 1
        if left >= count:
            return
        var selected: int32 = left
        let right = left + 1
        if right < count &&
           compilerSnapshotBuilderTextLess(
               values[order[selected]], values[order[right]]):
            selected = right
        if !compilerSnapshotBuilderTextLess(
               values[order[root]], values[order[selected]]):
            return
        compilerSnapshotBuilderSwapTextOrder(order, root, selected)
        root = selected

@borrows
fn compilerSnapshotBuilderTextOrder(values: str[]): int32[] =
    var order: int32[]
    setLen(order, values.len)
    for row in 0..<values.len:
        order[row] = row
    let parentCount = order.len / 2
    for reverse in 0..<parentCount:
        let start = parentCount - 1 - reverse
        compilerSnapshotBuilderTextOrderSiftDown(
            values, order, start, order.len)
    if order.len > 1:
        for reverse in 0..<order.len - 1:
            let endExclusive = order.len - reverse
            compilerSnapshotBuilderSwapTextOrder(
                order, 0, endExclusive - 1)
            compilerSnapshotBuilderTextOrderSiftDown(
                values, order, 0, endExclusive - 1)
    return order

@borrows
fn compilerSnapshotBuilderTextFind(values: str[], value: str): int32 =
    var low: int32
    var high: int32 = values.len
    while low < high:
        let middle = low + (high - low) / 2
        if compilerSnapshotBuilderTextLess(values[middle], value):
            low = middle + 1
        else:
            high = middle
    if low < values.len && values[low] == value:
        return low
    return -1

@borrows
fn compilerSnapshotBuilderCidObserved(value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn compilerSnapshotBuilderCidLess(left: layout.FixedBytes32,
                                  right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] != right.data[index]:
            return left.data[index] < right.data[index]
    return false

fn compilerSnapshotBuilderCountAppendSafe(current: int32,
                                          added: int32): bool =
    return current >= 0 && added >= 0 &&
           added <= 2147483647 - current

@borrows
fn compilerSnapshotBuilderTextPool(
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: CompilerSnapshotCanonicalSourceRow[],
        completeTextInputs: str[],
        out: var str[],
        err: var str): bool =
    var candidates: str[]
    for sourceIndex in 0..<sourceRows.len:
        if !compilerSnapshotBuilderTextRepresentable(
               sourceRows[sourceIndex].modulePath):
            err = " compiler snapshot builder: invalid module path text"
            return false
        add(candidates, share(sourceRows[sourceIndex].modulePath))
        let producerIndex = sourceRows[sourceIndex].producerSourceIndex
        for tokenIndex in 0..<sidecars[producerIndex].tokenValues.len:
            let value = sidecars[producerIndex].tokenValues[tokenIndex]
            if !compilerSnapshotBuilderTextRepresentable(value):
                err = " compiler snapshot builder: invalid parser token text"
                return false
            add(candidates, share(value))
        for functionIndex in 0..<sidecars[producerIndex].functionNames.len:
            let functionName =
                sidecars[producerIndex].functionNames[functionIndex]
            if !compilerSnapshotBuilderTextRepresentable(functionName):
                err = " compiler snapshot builder: invalid parser function name"
                return false
            add(candidates, share(functionName))
        for diagnosticRow in 0..<
                sidecars[producerIndex].diagnosticCodeTexts.len:
            let codeText =
                sidecars[producerIndex].diagnosticCodeTexts[
                    diagnosticRow]
            let messageText =
                sidecars[producerIndex].diagnosticMessageTexts[
                    diagnosticRow]
            if !compilerSnapshotBuilderTextRepresentable(codeText) ||
               !compilerSnapshotBuilderTextRepresentable(messageText):
                err = " compiler snapshot builder: invalid parser diagnostic text"
                return false
            add(candidates, share(codeText))
            add(candidates, share(messageText))
    for textIndex in 0..<completeTextInputs.len:
        if !compilerSnapshotBuilderTextRepresentable(
               completeTextInputs[textIndex]):
            err = " compiler snapshot builder: invalid complete text input"
            return false
        add(candidates, share(completeTextInputs[textIndex]))
    if candidates.len <= 0:
        err = " compiler snapshot builder: empty canonical text domain"
        return false
    let candidateOrder = compilerSnapshotBuilderTextOrder(candidates)
    out = []
    for index in 0..<candidateOrder.len:
        let candidateIndex = candidateOrder[index]
        if index == 0 ||
           candidates[candidateIndex] !=
               candidates[candidateOrder[index - 1]]:
            add(out, strings.CloneStr(candidates[candidateIndex]))
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderSourceInputsValidateInto(
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: CompilerSnapshotCanonicalSourceRow[],
        predecessorReceiptCid: layout.FixedBytes32,
        err: var str): bool =
    if sidecars.len <= 0 || sidecars.len != sourceRows.len ||
       !compilerSnapshotBuilderCidObserved(predecessorReceiptCid):
        err = " compiler snapshot builder: source input shape mismatch"
        return false
    var producerSeen: int32[]
    for producerIndex in 0..<sidecars.len:
        add(producerSeen, 0)
    for sourceIndex in 0..<sourceRows.len:
        let row = sourceRows[sourceIndex]
        let producerIndex = row.producerSourceIndex
        if producerIndex < 0 || producerIndex >= sidecars.len ||
           producerSeen[producerIndex] != 0:
            err = " compiler snapshot builder: producer source mapping is not bijective"
            return false
        producerSeen[producerIndex] = 1
        var sidecarErr: str
        if sidecars[producerIndex].sourceIndex != producerIndex ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecars[producerIndex], sidecarErr):
            err = sidecarErr == "" ?
                " compiler snapshot builder: invalid parser sidecar" :
                sidecarErr
            return false
        if !compilerSnapshotBuilderCidObserved(row.documentCid) ||
           !compilerSnapshotBuilderCidObserved(row.contentCid) ||
           !layout.FixedBytes32Equal(
               row.contentCid, sidecars[producerIndex].sourceContentRaw32) ||
           !compilerSnapshotBuilderCidObserved(
               sidecars[producerIndex].parserInputRaw32) ||
           !compilerSnapshotBuilderCidObserved(
               sidecars[producerIndex].sidecarRaw32) ||
           (sourceIndex > 0 &&
            !compilerSnapshotBuilderCidLess(
                sourceRows[sourceIndex - 1].documentCid,
                row.documentCid)):
            err = " compiler snapshot builder: invalid canonical source row"
            return false
    for producerIndex in 0..<producerSeen.len:
        if producerSeen[producerIndex] != 1:
            err = " compiler snapshot builder: producer source mapping is incomplete"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderSpanLess(
        left: CompilerSnapshotCanonicalSpanInput,
        right: CompilerSnapshotCanonicalSpanInput): bool =
    if left.sourceIndex != right.sourceIndex:
        return left.sourceIndex < right.sourceIndex
    if left.startByte != right.startByte:
        return left.startByte < right.startByte
    return left.endByte < right.endByte

@borrows
fn compilerSnapshotBuilderSpanKeyEqual(
        left: CompilerSnapshotCanonicalSpanInput,
        right: CompilerSnapshotCanonicalSpanInput): bool =
    return left.sourceIndex == right.sourceIndex &&
           left.startByte == right.startByte &&
           left.endByte == right.endByte

@borrows
fn compilerSnapshotBuilderSpanCoordinateEqual(
        left: CompilerSnapshotCanonicalSpanInput,
        right: CompilerSnapshotCanonicalSpanInput): bool =
    return compilerSnapshotBuilderSpanKeyEqual(left, right) &&
           left.startLine == right.startLine &&
           left.startColumn == right.startColumn &&
           left.endLine == right.endLine &&
           left.endColumn == right.endColumn

@borrows
fn compilerSnapshotBuilderSpanRepresentable(
        value: CompilerSnapshotCanonicalSpanInput,
        sourceCount: int32): bool =
    return value.sourceIndex >= 0 && value.sourceIndex < sourceCount &&
           value.startByte >= 0 && value.endByte >= value.startByte &&
           value.startLine >= 0 && value.startColumn >= 0 &&
           value.endLine >= value.startLine && value.endColumn >= 0 &&
           (value.endLine != value.startLine ||
            value.endColumn >= value.startColumn)

fn compilerSnapshotBuilderSwapSpan(
        values: var CompilerSnapshotCanonicalSpanInput[],
        left: int32,
        right: int32) =
    let saved = values[left]
    values[left] = values[right]
    values[right] = saved

fn compilerSnapshotBuilderSpanSiftDown(
        values: var CompilerSnapshotCanonicalSpanInput[],
        start: int32,
        count: int32) =
    var root: int32 = start
    while root >= 0 && root < count:
        let left = root * 2 + 1
        if left >= count:
            return
        var selected: int32 = left
        let right = left + 1
        if right < count &&
           compilerSnapshotBuilderSpanLess(values[selected], values[right]):
            selected = right
        if !compilerSnapshotBuilderSpanLess(values[root], values[selected]):
            return
        compilerSnapshotBuilderSwapSpan(values, root, selected)
        root = selected

fn compilerSnapshotBuilderSpanSort(
        values: var CompilerSnapshotCanonicalSpanInput[]) =
    let parentCount = values.len / 2
    for reverse in 0..<parentCount:
        compilerSnapshotBuilderSpanSiftDown(
            values, parentCount - 1 - reverse, values.len)
    if values.len <= 1:
        return
    for reverse in 0..<values.len - 1:
        let endExclusive = values.len - reverse
        compilerSnapshotBuilderSwapSpan(values, 0, endExclusive - 1)
        compilerSnapshotBuilderSpanSiftDown(values, 0, endExclusive - 1)

@borrows
fn compilerSnapshotBuilderCanonicalSpansBuildInto(
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: CompilerSnapshotCanonicalSourceRow[],
        completeSpanInputs: CompilerSnapshotCanonicalSpanInput[],
        out: var snapshot_schema.CsgCompilerSpanTable,
        err: var str): bool =
    var candidates: CompilerSnapshotCanonicalSpanInput[]
    for sourceIndex in 0..<sourceRows.len:
        let producerIndex = sourceRows[sourceIndex].producerSourceIndex
        if sidecars[producerIndex].spanStartBytes.len <= 0:
            err = " compiler snapshot builder: source semantic span domain empty"
            return false
        for localSpan in 0..<sidecars[producerIndex].spanStartBytes.len:
            var value: CompilerSnapshotCanonicalSpanInput
            value.sourceIndex = sourceIndex
            value.startByte =
                sidecars[producerIndex].spanStartBytes[localSpan]
            value.endByte = sidecars[producerIndex].spanEndBytes[localSpan]
            value.startLine = sidecars[producerIndex].spanStartLines[localSpan]
            value.startColumn =
                sidecars[producerIndex].spanStartColumns[localSpan]
            value.endLine = sidecars[producerIndex].spanEndLines[localSpan]
            value.endColumn = sidecars[producerIndex].spanEndColumns[localSpan]
            add(candidates, value)
    for inputIndex in 0..<completeSpanInputs.len:
        add(candidates, completeSpanInputs[inputIndex])
    if candidates.len <= 0:
        err = " compiler snapshot builder: empty complete span domain"
        return false
    for index in 0..<candidates.len:
        if !compilerSnapshotBuilderSpanRepresentable(
               candidates[index], sourceRows.len):
            err = " compiler snapshot builder: invalid complete span input"
            return false
    compilerSnapshotBuilderSpanSort(candidates)
    out = snapshot_schema.CsgCompilerSpanTable()
    for index in 0..<candidates.len:
        if index > 0 && compilerSnapshotBuilderSpanKeyEqual(
               candidates[index - 1], candidates[index]):
            if !compilerSnapshotBuilderSpanCoordinateEqual(
                   candidates[index - 1], candidates[index]):
                err = " compiler snapshot builder: conflicting span coordinates"
                return false
            continue
        add(out.sourceIds, candidates[index].sourceIndex)
        add(out.startBytes, candidates[index].startByte)
        add(out.endBytes, candidates[index].endByte)
        add(out.startLines, candidates[index].startLine)
        add(out.startColumns, candidates[index].startColumn)
        add(out.endLines, candidates[index].endLine)
        add(out.endColumns, candidates[index].endColumn)
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderSpanFind(
        spans: snapshot_schema.CsgCompilerSpanTable,
        sourceIndex: int32,
        startByte: int32,
        endByte: int32): int32 =
    var low: int32
    var high: int32 = spans.sourceIds.len
    while low < high:
        let middle = low + (high - low) / 2
        let sourceLess = spans.sourceIds[middle] < sourceIndex
        let startLess = spans.sourceIds[middle] == sourceIndex &&
            spans.startBytes[middle] < startByte
        let endLess = spans.sourceIds[middle] == sourceIndex &&
            spans.startBytes[middle] == startByte &&
            spans.endBytes[middle] < endByte
        if sourceLess || startLess || endLess:
            low = middle + 1
        else:
            high = middle
    if low < spans.sourceIds.len && spans.sourceIds[low] == sourceIndex &&
       spans.startBytes[low] == startByte && spans.endBytes[low] == endByte:
        return low
    return -1

@borrows
fn compilerSnapshotBuilderParserLocalSpanFind(
        spans: snapshot_schema.CsgCompilerSpanTable,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        sourceIndex: int32,
        localSpan: int32): int32 =
    if localSpan < 0 || localSpan >= sidecar.spanStartBytes.len:
        return -1
    return compilerSnapshotBuilderSpanFind(
        spans,
        sourceIndex,
        sidecar.spanStartBytes[localSpan],
        sidecar.spanEndBytes[localSpan])

@borrows
fn compilerSnapshotBuilderParserFunctionDeclarationCount(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar): int32 =
    var count: int32
    for declarationRow in 0..<sidecar.declarationKinds.len:
        if sidecar.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationFunction):
            count = count + 1
    return count

@borrows
fn compilerSnapshotBuilderSpanTablesEqual(
        left: snapshot_schema.CsgCompilerSpanTable,
        right: snapshot_schema.CsgCompilerSpanTable): bool =
    if left.sourceIds.len != right.sourceIds.len:
        return false
    for index in 0..<left.sourceIds.len:
        if left.sourceIds[index] != right.sourceIds[index] ||
           left.startBytes[index] != right.startBytes[index] ||
           left.endBytes[index] != right.endBytes[index] ||
           left.startLines[index] != right.startLines[index] ||
           left.startColumns[index] != right.startColumns[index] ||
           left.endLines[index] != right.endLines[index] ||
           left.endColumns[index] != right.endColumns[index]:
            return false
    return true

fn compilerSnapshotBuilderFunctionAnnotationWireSynchronized(): bool =
    return Int32(parser.ParserValueExprIdentifier) ==
               snapshot_schema.CsgCompilerParserValueExprIdentifier &&
           Int32(parser.ParserValueExprBindingResolutionNone) ==
               snapshot_schema.CsgCompilerParserBindingResolutionNone &&
           Int32(parser.ParserValueExprBindingResolutionParameter) ==
               snapshot_schema.CsgCompilerParserBindingResolutionParameter &&
           Int32(parser.ParserValueExprBindingResolutionPattern) ==
               snapshot_schema.CsgCompilerParserBindingResolutionPattern &&
           parser.ParserFunctionAnnotationThreadBoundary ==
               snapshot_schema.CsgCompilerFunctionAnnotationThreadBoundary &&
           parser.ParserFunctionAnnotationBorrows ==
               snapshot_schema.CsgCompilerFunctionAnnotationBorrows &&
           parser.ParserFunctionAnnotationEscapes ==
               snapshot_schema.CsgCompilerFunctionAnnotationEscapes &&
           parser.ParserFunctionAnnotationWeak ==
               snapshot_schema.CsgCompilerFunctionAnnotationWeak &&
           parser.ParserFunctionAnnotationTrustedAbi ==
               snapshot_schema.CsgCompilerFunctionAnnotationTrustedAbi &&
           parser.ParserFunctionAnnotationNoAlloc ==
               snapshot_schema.CsgCompilerFunctionAnnotationNoAlloc &&
           parser.ParserFunctionAnnotationInterruptHandler ==
               snapshot_schema.CsgCompilerFunctionAnnotationInterruptHandler &&
           parser.ParserFunctionAnnotationKeepExportBinding ==
               snapshot_schema.CsgCompilerFunctionAnnotationKeepExportBinding &&
           parser.ParserFunctionAnnotationBorrowResult ==
               snapshot_schema.CsgCompilerFunctionAnnotationBorrowResult &&
           parser.ParserFunctionAnnotationManualConsume ==
               snapshot_schema.CsgCompilerFunctionAnnotationManualConsume &&
           parser.ParserFunctionAnnotationMask ==
               snapshot_schema.CsgCompilerFunctionAnnotationMask

@borrows
fn compilerSnapshotBuilderParserShape(
        tables: snapshot_schema.CsgCompilerSnapshotTables): bool =
    let sourceCount = tables.sources.documentCids.len
    let spanCount = tables.spans.sourceIds.len
    let nodeCount = tables.parserNodes.sourceIds.len
    let tokenCount = tables.tokens.sourceIds.len
    let parserSourceCount = tables.parserSidecars.sourceIds.len
    let regionCount = tables.parserSidecars.regionKinds.len
    let statementCount = tables.parserSidecars.statementRootNodeIds.len
    let declarationCount = tables.parserSidecars.declarationKinds.len
    let declarationScopeCount =
        tables.parserSidecars.declarationLexicalScopeKinds.len
    let patternCount = tables.parserSidecars.patternKinds.len
    let genericSymbolCount =
        tables.parserSidecars.typeGenericSymbolProducerSourceIds.len
    let typeSyntaxCount = tables.parserSidecars.typeSyntaxKinds.len
    let typeConstExprCount = tables.parserSidecars.typeConstExprKinds.len
    let typeEnumVariantCount =
        tables.parserSidecars.typeEnumVariantProducerSourceIds.len
    let annotationCount =
        tables.parserSidecars.annotationProducerSourceIds.len
    let annotationArgCount =
        tables.parserSidecars.annotationArgProducerSourceIds.len
    let normalizedExprCount =
        tables.parserSidecars.normalizedExprParserNodeIds.len
    let functionCount = tables.parserSidecars.functionIndexes.len
    return compilerSnapshotBuilderFunctionAnnotationWireSynchronized() &&
           sourceCount > 0 &&
           sourceCount == tables.sources.modulePathTextIds.len &&
           sourceCount == tables.sources.contentCids.len &&
           sourceCount == tables.sources.interfaceCids.len &&
           spanCount > 0 &&
           spanCount == tables.spans.startBytes.len &&
           spanCount == tables.spans.endBytes.len &&
           spanCount == tables.spans.startLines.len &&
           spanCount == tables.spans.startColumns.len &&
           spanCount == tables.spans.endLines.len &&
           spanCount == tables.spans.endColumns.len &&
           nodeCount > 0 &&
           nodeCount == tables.parserNodes.producerNodeIds.len &&
           nodeCount == tables.parserNodes.parentNodeIds.len &&
           nodeCount == tables.parserNodes.kinds.len &&
           nodeCount == tables.parserNodes.spanIds.len &&
           nodeCount == tables.parserNodes.childStarts.len &&
           nodeCount == tables.parserNodes.childCounts.len &&
           nodeCount == tables.parserNodes.genericStarts.len &&
           nodeCount == tables.parserNodes.genericCounts.len &&
           nodeCount == tables.parserNodes.bindingResolutionKinds.len &&
           nodeCount ==
               tables.parserNodes.bindingDeclarationSourceLocalRows.len &&
           nodeCount ==
               tables.parserNodes.bindingPatternSourceLocalRows.len &&
           tokenCount > 0 &&
           tokenCount == tables.tokens.sourceLocalRows.len &&
           tokenCount == tables.tokens.lexicalParentTokenIds.len &&
           tokenCount == tables.tokens.spanIds.len &&
           tokenCount == tables.tokens.kinds.len &&
           tokenCount == tables.tokens.valueTextIds.len &&
           parserSourceCount == sourceCount &&
           parserSourceCount ==
               tables.parserSidecars.producerSourceIndexes.len &&
           parserSourceCount == tables.parserSidecars.parserInputCids.len &&
           parserSourceCount == tables.parserSidecars.sidecarCids.len &&
           regionCount == tables.parserSidecars.regionSpanIds.len &&
           regionCount == tables.parserSidecars.regionAnchorTokenIds.len &&
           statementCount == tables.parserSidecars.statementRootRoles.len &&
           statementCount ==
               tables.parserSidecars.statementRootAnchorTokenIds.len &&
           statementCount ==
               tables.parserSidecars.statementRootBindingDeclarationStarts.len &&
           statementCount ==
               tables.parserSidecars.statementRootBindingDeclarationCounts.len &&
           statementCount ==
               tables.parserSidecars.statementRootAnchorLines.len &&
           statementCount ==
               tables.parserSidecars.statementRootAnchorColumns.len &&
           statementCount ==
               tables.parserSidecars.statementRootEndLines.len &&
           statementCount ==
               tables.parserSidecars.statementRootEndColumns.len &&
           declarationCount == tables.parserSidecars.declarationProducerSourceIds.len &&
           declarationCount == tables.parserSidecars.declarationSourceLocalRows.len &&
           declarationCount ==
               tables.parserSidecars.declarationNameTokenIds.len &&
           declarationCount == tables.parserSidecars.declarationOwnerIds.len &&
           declarationCount == tables.parserSidecars.declarationLexicalScopeIds.len &&
           declarationCount == tables.parserSidecars.declarationFunctionRows.len &&
           declarationCount == tables.parserSidecars.declarationTypeSyntaxRootIds.len &&
           declarationCount ==
               tables.parserSidecars.declarationDefaultStatementRootRows.len &&
           declarationCount == tables.parserSidecars.declarationSpanIds.len &&
           declarationCount == tables.parserSidecars.declarationNameSpanIds.len &&
           declarationCount == tables.parserSidecars.declarationMutableFlags.len &&
           declarationCount == tables.parserSidecars.declarationExportedFlags.len &&
           declarationScopeCount > 0 &&
           declarationScopeCount == tables.parserSidecars.declarationLexicalScopeProducerSourceIds.len &&
           declarationScopeCount == tables.parserSidecars.declarationLexicalScopeSourceLocalRows.len &&
           declarationScopeCount == tables.parserSidecars.declarationLexicalScopeParentIds.len &&
           declarationScopeCount == tables.parserSidecars.declarationLexicalScopeOwnerDeclarationIds.len &&
           declarationScopeCount == tables.parserSidecars.declarationLexicalScopeSpanIds.len &&
           patternCount == tables.parserSidecars.patternProducerSourceIds.len &&
           patternCount == tables.parserSidecars.patternSourceLocalRows.len &&
           patternCount == tables.parserSidecars.patternNameTokenIds.len &&
           patternCount == tables.parserSidecars.patternOwnerLexicalScopeIds.len &&
           patternCount == tables.parserSidecars.patternBindingDeclarationIds.len &&
           patternCount ==
               tables.parserSidecars.patternTypeSyntaxRootIds.len &&
           patternCount == tables.parserSidecars.patternSpanIds.len &&
           patternCount == tables.parserSidecars.patternChildStarts.len &&
           patternCount == tables.parserSidecars.patternChildCounts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxSourceIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxProducerSourceIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxSourceLocalRows.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxSpanIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxOwnerTokenIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxDeclarationOwnerTokenIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxDeclarationOwnerIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxGenericSymbolStarts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxGenericSymbolCounts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxChildStarts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxChildCounts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxBracketArgStarts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxBracketArgCounts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxNameTokenIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxFixedLengths.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxQuestionTokenIds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxRootKinds.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxEnumVariantStarts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxEnumVariantCounts.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxIdentityCids.len &&
           typeSyntaxCount ==
               tables.parserSidecars.typeSyntaxTypeIds.len &&
           tables.parserSidecars.typeSyntaxBracketArgTokenStarts.len ==
               tables.parserSidecars.typeSyntaxBracketArgTokenCounts.len &&
           tables.parserSidecars.typeSyntaxBracketArgTokenStarts.len ==
               tables.parserSidecars.typeSyntaxBracketArgTypeIds.len &&
           tables.parserSidecars.typeSyntaxBracketArgTokenStarts.len ==
               tables.parserSidecars.typeSyntaxBracketArgConstExprRootIds.len &&
           typeConstExprCount ==
               tables.parserSidecars.typeConstExprProducerSourceIds.len &&
           typeConstExprCount ==
               tables.parserSidecars.typeConstExprSourceTextIds.len &&
           typeConstExprCount ==
               tables.parserSidecars.typeConstExprTokenIds.len &&
           typeConstExprCount ==
               tables.parserSidecars.typeConstExprLeftChildIds.len &&
           typeConstExprCount ==
               tables.parserSidecars.typeConstExprRightChildIds.len &&
           typeConstExprCount ==
               tables.parserSidecars.typeConstExprIntegerValues.len &&
           typeConstExprCount ==
               tables.parserSidecars.typeConstExprIdentityCids.len &&
           typeEnumVariantCount ==
               tables.parserSidecars.typeEnumVariantDeclarationOwnerIds.len &&
           typeEnumVariantCount ==
               tables.parserSidecars.typeEnumVariantDeclarationOwnerTokenIds.len &&
           typeEnumVariantCount ==
               tables.parserSidecars.typeEnumVariantNameTokenIds.len &&
           typeEnumVariantCount ==
               tables.parserSidecars.typeEnumVariantOrdinals.len &&
           typeEnumVariantCount ==
               tables.parserSidecars.typeEnumVariantPayloadTypeSyntaxIds.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolSourceLocalRows.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolDeclarationOwnerTokenIds.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolNameTokenIds.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolOrdinals.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolSpanIds.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolOwnerTypeSyntaxIds.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolConstraintTypeSyntaxIds.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolDefaultTypeSyntaxIds.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolChildStarts.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolChildCounts.len &&
           genericSymbolCount ==
               tables.parserSidecars.typeGenericSymbolIdentityCids.len &&
           annotationCount ==
               tables.parserSidecars.annotationSourceLocalRows.len &&
           annotationCount ==
               tables.parserSidecars.annotationNameTokenIds.len &&
           annotationCount ==
               tables.parserSidecars.annotationTargetTokenIds.len &&
           annotationCount ==
               tables.parserSidecars.annotationSpanIds.len &&
           annotationCount ==
               tables.parserSidecars.annotationArgRootStarts.len &&
           annotationCount ==
               tables.parserSidecars.annotationArgRootCounts.len &&
           annotationCount ==
               tables.parserSidecars.annotationIdentityCids.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgSourceLocalRows.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgOwnerIds.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgKinds.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgTokenIds.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgSeparatorTokenIds.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgSpanIds.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgChildStarts.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgChildCounts.len &&
           annotationArgCount ==
               tables.parserSidecars.annotationArgIdentityCids.len &&
           normalizedExprCount ==
               tables.parserSidecars.normalizedExprProducerSourceIds.len &&
           normalizedExprCount ==
               tables.parserSidecars.normalizedExprSourceLocalRows.len &&
           normalizedExprCount ==
               tables.parserSidecars.normalizedExprFunctionIndexes.len &&
           normalizedExprCount ==
               tables.parserSidecars.normalizedExprKinds.len &&
           normalizedExprCount ==
               tables.parserSidecars.normalizedExprStatementRoles.len &&
           functionCount == tables.parserSidecars.functionNameTextIds.len &&
           functionCount ==
               tables.parserSidecars.functionNameSurfaceKinds.len &&
           functionCount ==
               tables.parserSidecars.functionNameProofCids.len &&
           functionCount ==
               tables.parserSidecars.functionSignatureLineNumbers.len &&
           functionCount ==
               tables.parserSidecars.functionDeclarationSpanIds.len &&
           functionCount ==
               tables.parserSidecars.functionDeclarationHeaderCids.len &&
           functionCount ==
               tables.parserSidecars.functionDeclarationPathCids.len &&
           functionCount ==
               tables.parserSidecars.functionNameSpanIds.len &&
           functionCount == tables.parserSidecars.functionBodySpanIds.len &&
           functionCount ==
               tables.parserSidecars.functionAnnotationFlags.len &&
           functionCount ==
               tables.parserSidecars.functionManualConsumeTargetParameterOrdinals.len &&
           functionCount ==
               tables.parserSidecars.functionManualConsumeTargetParameterDeclarationIds.len &&
           functionCount ==
               tables.parserSidecars.functionManualConsumeSourceParameterOrdinals.len &&
           functionCount ==
               tables.parserSidecars.functionManualConsumeSourceParameterDeclarationIds.len

# Proves every global parser/source row is the exact base-remapped image of the
# immutable per-source parser receipt.  Later exact producers may populate the
# remaining tables without invalidating this parser-scoped proof.
@borrows
fn compilerSnapshotBuilderProjectionValidate(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: CompilerSnapshotCanonicalSourceRow[],
        completeTextInputs: str[],
        completeSpanInputs: CompilerSnapshotCanonicalSpanInput[],
        predecessorReceiptCid: layout.FixedBytes32,
        err: var str): bool =
    if !layout.FixedBytes32Equal(
           tables.predecessorReceiptCid, predecessorReceiptCid) ||
       !compilerSnapshotBuilderParserShape(tables):
        err = " compiler snapshot builder: projection shape mismatch"
        return false
    if tables.texts.len <= 0:
        err = " compiler snapshot builder: empty canonical text pool"
        return false
    for textIndex in 0..<tables.texts.len:
        if !compilerSnapshotBuilderTextRepresentable(
               tables.texts[textIndex]) ||
           (textIndex > 0 &&
            !compilerSnapshotBuilderTextLess(
                tables.texts[textIndex - 1], tables.texts[textIndex])):
            err = " compiler snapshot builder: non-canonical text pool"
            return false
    var expectedTexts: str[]
    if !compilerSnapshotBuilderTextPool(
           sidecars, sourceRows, completeTextInputs, expectedTexts, err) ||
       expectedTexts.len != tables.texts.len:
        if err == "":
            err = " compiler snapshot builder: complete text universe mismatch"
        return false
    for textIndex in 0..<expectedTexts.len:
        if expectedTexts[textIndex] != tables.texts[textIndex]:
            err = " compiler snapshot builder: complete text universe mismatch"
            return false
    var expectedSpans: snapshot_schema.CsgCompilerSpanTable
    if !compilerSnapshotBuilderCanonicalSpansBuildInto(
           sidecars, sourceRows, completeSpanInputs, expectedSpans, err) ||
       !compilerSnapshotBuilderSpanTablesEqual(expectedSpans, tables.spans):
        if err == "":
            err = " compiler snapshot builder: complete span universe mismatch"
        return false

    var nodeBase: int32
    var childBase: int32
    var tokenBase: int32
    var genericBase: int32
    var regionBase: int32
    var rootBase: int32
    var callBase: int32
    var statementBase: int32
    var normalizedExprBase: int32
    var declarationBase: int32
    var declarationScopeBase: int32
    var patternBase: int32
    var patternChildBase: int32
    var typeSyntaxBase: int32
    var typeSyntaxChildBase: int32
    var typeBracketArgBase: int32
    var typeConstExprBase: int32
    var typeEnumVariantBase: int32
    var genericSymbolBase: int32
    var genericSymbolChildBase: int32
    var annotationBase: int32
    var annotationRootBase: int32
    var annotationArgBase: int32
    var annotationArgChildBase: int32
    var functionBase: int32
    var declarationFunctionBase: int32
    for sourceIndex in 0..<sourceRows.len:
        let source = sourceRows[sourceIndex]
        let producerIndex = source.producerSourceIndex
        let localDeclarationFunctionCount =
            compilerSnapshotBuilderParserFunctionDeclarationCount(
                sidecars[producerIndex])
        if sidecars[producerIndex].nodeKinds.len >
               tables.parserNodes.sourceIds.len - nodeBase ||
           sidecars[producerIndex].nodeChildIds.len >
               tables.parserNodes.childNodeIds.len - childBase ||
           sidecars[producerIndex].tokenKinds.len >
               tables.tokens.sourceIds.len - tokenBase ||
           sidecars[producerIndex].genericSpanIds.len >
               tables.parserSidecars.genericSpanIds.len - genericBase ||
           sidecars[producerIndex].regionKinds.len >
               tables.parserSidecars.regionKinds.len - regionBase ||
           sidecars[producerIndex].rootNodeIds.len >
               tables.parserSidecars.rootNodeIds.len - rootBase ||
           sidecars[producerIndex].callEventNodeIds.len >
               tables.parserSidecars.callEventNodeIds.len - callBase ||
           sidecars[producerIndex].statementRootNodeIds.len >
               tables.parserSidecars.statementRootNodeIds.len - statementBase ||
           sidecars[producerIndex].normalizedExprParserNodeIds.len >
               tables.parserSidecars.normalizedExprParserNodeIds.len -
                   normalizedExprBase ||
           sidecars[producerIndex].declarationKinds.len >
               tables.parserSidecars.declarationKinds.len - declarationBase ||
           sidecars[producerIndex].declarationLexicalScopeKinds.len >
               tables.parserSidecars.declarationLexicalScopeKinds.len -
                   declarationScopeBase ||
           sidecars[producerIndex].patternKinds.len >
               tables.parserSidecars.patternKinds.len - patternBase ||
           sidecars[producerIndex].patternChildIds.len >
               tables.parserSidecars.patternChildIds.len - patternChildBase ||
           sidecars[producerIndex].typeSyntaxKinds.len >
               tables.parserSidecars.typeSyntaxKinds.len - typeSyntaxBase ||
           sidecars[producerIndex].typeSyntaxChildIds.len >
               tables.parserSidecars.typeSyntaxChildIds.len -
                   typeSyntaxChildBase ||
           sidecars[producerIndex].typeSyntaxBracketArgTokenStarts.len >
               tables.parserSidecars.typeSyntaxBracketArgTokenStarts.len -
                   typeBracketArgBase ||
           sidecars[producerIndex].typeConstExprKinds.len >
               tables.parserSidecars.typeConstExprKinds.len -
                   typeConstExprBase ||
           sidecars[producerIndex].typeEnumVariantProducerSourceIds.len >
               tables.parserSidecars.typeEnumVariantProducerSourceIds.len -
                   typeEnumVariantBase ||
           sidecars[producerIndex].typeGenericSymbolProducerSourceIds.len >
               tables.parserSidecars.typeGenericSymbolProducerSourceIds.len -
                   genericSymbolBase ||
           sidecars[producerIndex].typeGenericSymbolChildTypeSyntaxIds.len >
               tables.parserSidecars.typeGenericSymbolChildTypeSyntaxIds.len -
                   genericSymbolChildBase ||
           sidecars[producerIndex].annotationProducerSourceIds.len >
               tables.parserSidecars.annotationProducerSourceIds.len -
                   annotationBase ||
           sidecars[producerIndex].annotationArgRootIds.len >
               tables.parserSidecars.annotationArgRootIds.len -
                   annotationRootBase ||
           sidecars[producerIndex].annotationArgProducerSourceIds.len >
               tables.parserSidecars.annotationArgProducerSourceIds.len -
                   annotationArgBase ||
           sidecars[producerIndex].annotationArgChildIds.len >
               tables.parserSidecars.annotationArgChildIds.len -
                   annotationArgChildBase ||
           sidecars[producerIndex].functionIndexes.len >
               tables.parserSidecars.functionIndexes.len - functionBase ||
           localDeclarationFunctionCount >
               2147483647 - declarationFunctionBase:
            err = " compiler snapshot builder: source range overflow"
            return false
        let moduleTextId = compilerSnapshotBuilderTextFind(
            tables.texts, source.modulePath)
        if moduleTextId < 0 ||
           !layout.FixedBytes32Equal(
               tables.sources.documentCids[sourceIndex], source.documentCid) ||
           tables.sources.modulePathTextIds[sourceIndex] != moduleTextId ||
           !layout.FixedBytes32Equal(
               tables.sources.contentCids[sourceIndex], source.contentCid) ||
           !layout.FixedBytes32Equal(
               tables.sources.interfaceCids[sourceIndex],
               layout.FixedBytes32()) ||
           tables.parserSidecars.sourceIds[sourceIndex] != sourceIndex ||
           tables.parserSidecars.producerSourceIndexes[sourceIndex] !=
               producerIndex ||
           !layout.FixedBytes32Equal(
               tables.parserSidecars.parserInputCids[sourceIndex],
               sidecars[producerIndex].parserInputRaw32) ||
           !layout.FixedBytes32Equal(
               tables.parserSidecars.sidecarCids[sourceIndex],
               sidecars[producerIndex].sidecarRaw32):
            err = " compiler snapshot builder: exact source binding mismatch"
            return false

        for localSpan in 0..<sidecars[producerIndex].spanStartBytes.len:
            let globalSpan = compilerSnapshotBuilderSpanFind(
                tables.spans,
                sourceIndex,
                sidecars[producerIndex].spanStartBytes[localSpan],
                sidecars[producerIndex].spanEndBytes[localSpan])
            if globalSpan < 0 ||
               tables.spans.startLines[globalSpan] !=
                   sidecars[producerIndex].spanStartLines[localSpan] ||
               tables.spans.startColumns[globalSpan] !=
                   sidecars[producerIndex].spanStartColumns[localSpan] ||
               tables.spans.endLines[globalSpan] !=
                   sidecars[producerIndex].spanEndLines[localSpan] ||
               tables.spans.endColumns[globalSpan] !=
                   sidecars[producerIndex].spanEndColumns[localSpan]:
                err = " compiler snapshot builder: exact span remap mismatch"
                return false

        var localNodeByProducer: int32[]
        setLen(localNodeByProducer,
            sidecars[producerIndex].nodeKinds.len)
        for producerNodeId in 0..<localNodeByProducer.len:
            localNodeByProducer[producerNodeId] = -1
        for localNode in 0..<sidecars[producerIndex].nodeKinds.len:
            let globalNode = nodeBase + localNode
            let localParent = sidecars[producerIndex].nodeParentIds[localNode]
            let producerNodeId =
                sidecars[producerIndex].nodeProducerIds[localNode]
            let expectedParent = localParent < 0 ? -1 : nodeBase + localParent
            let expectedSpan = compilerSnapshotBuilderParserLocalSpanFind(
                tables.spans,
                sidecars[producerIndex],
                sourceIndex,
                sidecars[producerIndex].nodeSpanIds[localNode])
            if globalNode >= tables.parserNodes.sourceIds.len ||
               expectedSpan < 0 ||
               producerNodeId < 0 ||
               producerNodeId >= localNodeByProducer.len ||
               localNodeByProducer[producerNodeId] >= 0 ||
               tables.parserNodes.sourceIds[globalNode] != sourceIndex ||
               tables.parserNodes.producerNodeIds[globalNode] !=
                   producerNodeId ||
               tables.parserNodes.parentNodeIds[globalNode] != expectedParent ||
               tables.parserNodes.kinds[globalNode] !=
                   sidecars[producerIndex].nodeKinds[localNode] ||
               tables.parserNodes.spanIds[globalNode] != expectedSpan ||
               tables.parserNodes.childStarts[globalNode] !=
                   childBase +
                       sidecars[producerIndex].nodeChildStarts[localNode] ||
               tables.parserNodes.childCounts[globalNode] !=
                   sidecars[producerIndex].nodeChildCounts[localNode] ||
               tables.parserNodes.genericStarts[globalNode] !=
                   genericBase +
                       sidecars[producerIndex].nodeGenericStarts[localNode] ||
               tables.parserNodes.genericCounts[globalNode] !=
                   sidecars[producerIndex].nodeGenericCounts[localNode] ||
               tables.parserNodes.bindingResolutionKinds[globalNode] !=
                   sidecars[producerIndex].nodeBindingResolutionKinds[
                       localNode] ||
               tables.parserNodes.bindingDeclarationSourceLocalRows[
                   globalNode] !=
                   sidecars[producerIndex].nodeBindingDeclarationSourceLocalRows[
                       localNode] ||
               tables.parserNodes.bindingPatternSourceLocalRows[
                   globalNode] !=
                   sidecars[producerIndex].nodeBindingPatternSourceLocalRows[
                       localNode]:
