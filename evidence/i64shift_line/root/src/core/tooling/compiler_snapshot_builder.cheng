    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionInterfaceCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionOwnerIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingFunctionParameterTypeCount)
    compilerSnapshotBuilderHashAppendU32(
