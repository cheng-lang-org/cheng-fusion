@borrows
fn compilerSnapshotBuilderCidFind(
        values: layout.FixedBytes32[],
        value: layout.FixedBytes32): int32 =
    var low: int32
    var high = values.len
    while low < high:
        let middle = low + (high - low) / 2
        if compilerSnapshotBuilderCidLess(values[middle], value):
            low = middle + 1
        else:
            high = middle
    if low < values.len && layout.FixedBytes32Equal(values[low], value):
        return low
    return -1

fn compilerSnapshotBuilderOldSymbolCidIndexSiftDown(
        symbolCids: var layout.FixedBytes32[],
        oldSymbolIdsByCid: var int32[],
        start: int32,
        count: int32) =
    var root = start
    while root >= 0 && root < count:
        if count <= 1 || root > (count - 2) / 2:
            return
        let left = root * 2 + 1
        var selected = left
        let right = left + 1
        if right < count && compilerSnapshotBuilderCidLess(
               symbolCids[oldSymbolIdsByCid[selected]],
               symbolCids[oldSymbolIdsByCid[right]]):
            selected = right
        if !compilerSnapshotBuilderCidLess(
               symbolCids[oldSymbolIdsByCid[root]],
               symbolCids[oldSymbolIdsByCid[selected]]):
            return
        let saved = oldSymbolIdsByCid[root]
        oldSymbolIdsByCid[root] = oldSymbolIdsByCid[selected]
        oldSymbolIdsByCid[selected] = saved
        root = selected

# Producer-owned exact index over the immutable pre-Type Symbol domain.
# Appended Type rows never enter this index, so declaration remap cannot
# binary-search the later mixed old-SymbolCid/new-DeclKey array.
fn compilerSnapshotBuilderOldSymbolCidIndexBuildInto(
        symbolCids: var layout.FixedBytes32[],
        oldSymbolIdsByCid: var int32[],
        err: var str): bool =
    setLen(oldSymbolIdsByCid, symbolCids.len)
    for oldSymbolId in 0..<oldSymbolIdsByCid.len:
        if !compilerSnapshotBuilderCidObserved(symbolCids[oldSymbolId]):
            err = " compiler snapshot builder: old SymbolCid index input missing"
            return false
        oldSymbolIdsByCid[oldSymbolId] = oldSymbolId
    let parentCount = oldSymbolIdsByCid.len / 2
    for reverse in 0..<parentCount:
        compilerSnapshotBuilderOldSymbolCidIndexSiftDown(
            symbolCids, oldSymbolIdsByCid,
            parentCount - 1 - reverse, oldSymbolIdsByCid.len)
    if oldSymbolIdsByCid.len > 1:
        for reverse in 0..<oldSymbolIdsByCid.len - 1:
            let endExclusive = oldSymbolIdsByCid.len - reverse
            let saved = oldSymbolIdsByCid[0]
            oldSymbolIdsByCid[0] =
                oldSymbolIdsByCid[endExclusive - 1]
            oldSymbolIdsByCid[endExclusive - 1] = saved
            compilerSnapshotBuilderOldSymbolCidIndexSiftDown(
                symbolCids, oldSymbolIdsByCid, 0, endExclusive - 1)
    for row in 1..<oldSymbolIdsByCid.len:
        if !compilerSnapshotBuilderCidLess(
               symbolCids[oldSymbolIdsByCid[row - 1]],
               symbolCids[oldSymbolIdsByCid[row]]):
            err = " compiler snapshot builder: duplicate old SymbolCid index key"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderOldSymbolCidIndexFind(
        symbolCids: layout.FixedBytes32[],
        oldSymbolIdsByCid: int32[],
        value: layout.FixedBytes32): int32 =
    var low: int32
    var high = oldSymbolIdsByCid.len
    while low < high:
        let middle = low + (high - low) / 2
        let oldSymbolId = oldSymbolIdsByCid[middle]
        if compilerSnapshotBuilderCidLess(
               symbolCids[oldSymbolId], value):
            low = middle + 1
        else:
            high = middle
    if low < oldSymbolIdsByCid.len:
        let oldSymbolId = oldSymbolIdsByCid[low]
        if layout.FixedBytes32Equal(symbolCids[oldSymbolId], value):
            return oldSymbolId
    return -1

@borrows
fn compilerSnapshotBuilderFunctionFind(
        functionSymbolIds: int32[],
        symbolId: int32): int32 =
    var low: int32
    var high = functionSymbolIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if functionSymbolIds[middle] < symbolId:
            low = middle + 1
        else:
            high = middle
    if low < functionSymbolIds.len &&
       functionSymbolIds[low] == symbolId:
        return low
    return -1

@borrows
fn compilerSnapshotBuilderCanonicalSourceForProducer(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        producerSourceIndex: int32): int32 =
    for row in 0..<tables.parserSidecars.sourceIds.len:
        if tables.parserSidecars.producerSourceIndexes[row] ==
               producerSourceIndex:
            return tables.parserSidecars.sourceIds[row]
    return -1

@borrows
fn compilerSnapshotBuilderParserFunctionDeclarationLocalRowInto(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        localFunctionRow: int32,
        out: var int32,
        err: var str): bool =
    out = -1
    if localFunctionRow < 0 ||
       localFunctionRow >= sidecar.functionIndexes.len ||
       localFunctionRow >= sidecar.functionDeclarationSpanIds.len ||
       localFunctionRow >= sidecar.functionNameSpanIds.len:
        err = " compiler snapshot builder: parser Function row missing"
        return false
    let expectedDeclarationSpan =
        sidecar.functionDeclarationSpanIds[localFunctionRow]
    let expectedNameSpan =
        sidecar.functionNameSpanIds[localFunctionRow]
    for declarationRow in 0..<sidecar.declarationKinds.len:
        if sidecar.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationFunction):
            continue
        if declarationRow >= sidecar.declarationSpanIds.len ||
           declarationRow >= sidecar.declarationNameSpanIds.len:
            err = " compiler snapshot builder: parser declaration columns split"
            return false
        if sidecar.declarationSpanIds[declarationRow] !=
               expectedDeclarationSpan:
            continue
        if sidecar.declarationNameSpanIds[declarationRow] !=
               expectedNameSpan ||
           out >= 0:
            err = " compiler snapshot builder: parser Function declaration bridge ambiguous"
            return false
        out = declarationRow
    if out < 0:
        err = " compiler snapshot builder: parser Function declaration bridge missing"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderParserFunctionOwnerKindsBuildInto(
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        tokenBases: int32[],
        tokenCount: int32,
        out: var int32[],
        err: var str): bool =
    setLen(out, tokenCount)
    if sidecars.len != tokenBases.len:
        err = " compiler snapshot builder: parser Function owner source domain split"
        return false
    for producerSource in 0..<sidecars.len:
        let sidecar = sidecars[producerSource]
        let tokenBase = tokenBases[producerSource]
        for declarationRow in 0..<sidecar.declarationKinds.len:
            if sidecar.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction):
                continue
            let localOwnerToken =
                sidecar.declarationNameTokenIds[declarationRow]
            if localOwnerToken < 0 ||
               localOwnerToken >= sidecar.tokenKinds.len:
                err = " compiler snapshot builder: parser Function owner token missing"
                return false
            let ownerToken = tokenBase + localOwnerToken
            if ownerToken < 0 || ownerToken >= out.len ||
               out[ownerToken] !=
                   compilerSnapshotParserFunctionOwnerNone:
                err = " compiler snapshot builder: parser Function owner token ambiguous"
                return false
            out[ownerToken] =
                compilerSnapshotParserFunctionOwnerNonExecutable
        for localFunctionRow in 0..<sidecar.functionIndexes.len:
            var declarationRow: int32
            if !compilerSnapshotBuilderParserFunctionDeclarationLocalRowInto(
                   sidecar, localFunctionRow, declarationRow, err):
                return false
            let localOwnerToken =
                sidecar.declarationNameTokenIds[declarationRow]
            let ownerToken = tokenBase + localOwnerToken
            if ownerToken < 0 || ownerToken >= out.len ||
               out[ownerToken] !=
                   compilerSnapshotParserFunctionOwnerNonExecutable:
                err = " compiler snapshot builder: executable Function owner bridge ambiguous"
                return false
            out[ownerToken] =
                compilerSnapshotParserFunctionOwnerExecutable
    err = ""
    return true

# Backtick operator names (`[]`, `[]=`, `()`) are tokenized as separate
# punctuation tokens, and the receipt records a function's name span as the
# inner byte range (mirror of parserReceiptDeclarationNameSpanResolveInto),
# so the name span is generally not any token's span.  The owner-token domain
# must stay the parser's declaration name tokens: the opening backtick token
# for a backtick surface, the single can-name token otherwise.  `tokenBySpan`
# must be the already-validated unique span-to-token projection over the same
# token/span arrays.  Span byte offsets are per-source local, so the
# opener/closer token scans are source-filtered (mirror of
# CsgCompilerBacktickNameTokenBracketValid): global-table callers pass the
# exact per-row source id columns and only the name span's own source is
# scanned; per-source sidecar callers pass empty columns because every row is
# implicitly the same source.  An out-of-domain or unresolvable name span
# resolves to
# -1 with no error so the caller's existing owner-token judgments keep
# firing; only structural contradictions inside a backtick surface fail here.
@borrows
fn compilerSnapshotBuilderFunctionNameOwnerTokenResolveInto(
        spanStartBytes: int32[],
        spanEndBytes: int32[],
        spanSourceIds: int32[],
        tokenSourceIds: int32[],
        tokenSpanIds: int32[],
        tokenKinds: int32[],
        tokenBySpan: int32[],
        nameSpanId: int32,
        ownerToken: var int32,
        err: var str): bool =
    ownerToken = -1
    if nameSpanId < 0 || nameSpanId >= spanStartBytes.len:
        err = ""
        return true
    let directToken = tokenBySpan[nameSpanId]
    if directToken >= 0 &&
       parser.ParserValueExprTokenCanName(
           parser.ParserValueTokenKind(tokenKinds[directToken])):
        ownerToken = directToken
        err = ""
        return true
    let nameStart = spanStartBytes[nameSpanId]
    let nameEnd = spanEndBytes[nameSpanId]
    # Without the source filter a backtick token from another source whose
    # per-source byte offsets collide with this name span would be misjudged
    # as a second opener (or a wrong closer).
    let filterBySource = spanSourceIds.len > 0
    if filterBySource &&
       (spanSourceIds.len != spanStartBytes.len ||
        tokenSourceIds.len != tokenKinds.len):
        err = " compiler snapshot builder: backtick name source columns misaligned"
        return false
    let nameSource =
        filterBySource ? spanSourceIds[nameSpanId] : -1
    var openerToken = -1
    for tokenId in 0..<tokenKinds.len:
        if filterBySource && tokenSourceIds[tokenId] != nameSource:
            continue
        if tokenKinds[tokenId] != Int32(parser.ParserValueTokenBacktick):
            continue
        let tokenSpanId = tokenSpanIds[tokenId]
        if tokenSpanId < 0 || tokenSpanId >= spanStartBytes.len ||
           (filterBySource &&
                spanSourceIds[tokenSpanId] != nameSource) ||
           spanEndBytes[tokenSpanId] <= spanStartBytes[tokenSpanId]:
            err = " compiler snapshot builder: backtick name token span invalid"
            return false
        if spanEndBytes[tokenSpanId] == nameStart:
            if openerToken >= 0:
                err = " compiler snapshot builder: backtick name opener ambiguous"
                return false
            openerToken = tokenId
    if openerToken < 0:
        err = ""
        return true
    var closerToken = -1
    for tokenId in openerToken + 1..<tokenKinds.len:
        if filterBySource && tokenSourceIds[tokenId] != nameSource:
            continue
        if tokenKinds[tokenId] == Int32(parser.ParserValueTokenBacktick):
            closerToken = tokenId
            break
    if closerToken < 0:
        err = " compiler snapshot builder: backtick name closer missing"
        return false
    let closerSpanId = tokenSpanIds[closerToken]
    if closerSpanId < 0 || closerSpanId >= spanStartBytes.len ||
       (filterBySource && spanSourceIds[closerSpanId] != nameSource) ||
       spanStartBytes[closerSpanId] != nameEnd:
        err = " compiler snapshot builder: backtick name closer span invalid"
        return false
    ownerToken = openerToken
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderPrebuildFunctionForParserRowInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        parserFunctionRow: int32,
        facts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        functionIdOut: var int32,
        err: var str): bool =
    functionIdOut = -1
    if parserFunctionRow < 0 ||
       parserFunctionRow >=
           tables.parserSidecars.functionDeclarationSpanIds.len:
        err = " compiler snapshot builder: parser function identity missing"
        return false
    let declarationSpanId =
        tables.parserSidecars.functionDeclarationSpanIds[parserFunctionRow]
    if declarationSpanId < 0 ||
       declarationSpanId >= tables.spans.sourceIds.len:
        err = " compiler snapshot builder: parser declaration span missing"
        return false
    let sourceId = tables.spans.sourceIds[declarationSpanId]
    if sourceId < 0 || sourceId >= tables.sources.documentCids.len:
        err = " compiler snapshot builder: parser declaration source missing"
        return false
    let bodySpanId =
        tables.parserSidecars.functionBodySpanIds[parserFunctionRow]
    if bodySpanId < 0 || bodySpanId >= tables.spans.sourceIds.len ||
       tables.spans.sourceIds[bodySpanId] != sourceId:
        err = " compiler snapshot builder: parser function body span missing"
        return false
    for functionId in 0..<facts.functionSourceIds.len:
        if facts.functionSourceIds[functionId] == sourceId &&
           facts.bodyStartBytes[functionId] ==
               tables.spans.startBytes[bodySpanId] &&
           facts.bodyEndBytes[functionId] ==
               tables.spans.endBytes[bodySpanId]:
            if functionIdOut >= 0:
                err = " compiler snapshot builder: parser body has two prebuild functions"
                return false
            functionIdOut = functionId
    if functionIdOut < 0:
        err = " compiler snapshot builder: parser body has no prebuild function"
        return false
    return true

@borrows
fn compilerSnapshotBuilderGraphNodeSymbolIdsInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        facts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        out: var int32[],
        err: var str): bool =
    setLen(out, csg.nodes.len + 1)
    for nodeId in 0..<out.len:
        out[nodeId] = -1
    for parserRow in 0..<tables.parserSidecars.functionIndexes.len:
        let reachableRow = tables.parserSidecars.functionIndexes[parserRow]
        if reachableRow < 0 || reachableRow >=
               csg.semanticGraph.reachableFunctionTable.graphNodeIds.len:
            err = " compiler snapshot builder: reachable parser identity missing"
            return false
        let graphNodeId =
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[reachableRow]
        var functionId: int32
        if graphNodeId <= 0 || graphNodeId >= out.len ||
           out[graphNodeId] >= 0 ||
           !compilerSnapshotBuilderPrebuildFunctionForParserRowInto(
                tables, parserRow, facts, functionId, err):
            return false
        let symbolId = functionId < 0 ||
            functionId >= facts.functionSymbolIds.len ? -1 :
            facts.functionSymbolIds[functionId]
        if symbolId < 0 || symbolId >= facts.symbolCids.len:
            err = " compiler snapshot builder: prebuild SymbolId outside current domain"
            return false
        out[graphNodeId] = symbolId
    return true

@borrows
fn compilerSnapshotBuilderFinalizedReadFind(
        facts: incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        functionId: int32,
        targetDomainKind: int32,
        targetPortableKeyCid: layout.FixedBytes32): int32 =
    if functionId < 0 || functionId >= facts.readStarts.len ||
       functionId >= facts.readCounts.len:
        return -1
    let start = facts.readStarts[functionId]
    let count = facts.readCounts[functionId]
    var low = start
    var high = start + count
    while low < high:
        let middle = low + (high - low) / 2
        let middleDomain = facts.readSet.targetDomainKinds[middle]
        let middleKey = facts.readSet.targetPortableKeyCids[middle]
        if middleDomain < targetDomainKind ||
           (middleDomain == targetDomainKind &&
            compilerSnapshotBuilderCidLess(
                middleKey, targetPortableKeyCid)):
            low = middle + 1
        else:
            high = middle
    if low < start + count &&
       facts.readSet.targetDomainKinds[low] == targetDomainKind &&
       layout.FixedBytes32Equal(
           facts.readSet.targetPortableKeyCids[low], targetPortableKeyCid):
        return low
    return -1

fn compilerSnapshotBuilderRebuildPartitionContains(
        plan: var incremental.SemanticSnapshotIncrementalPrebuildPlan,
        functionId: int32): bool =
    var low: int32
    var high = plan.rebuildFunctionIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if plan.rebuildFunctionIds[middle] < functionId:
            low = middle + 1
        else:
            high = middle
    return low < plan.rebuildFunctionIds.len &&
        plan.rebuildFunctionIds[low] == functionId

fn compilerSnapshotBuilderReadPairRadixSort(
        readerFunctionIds: var int32[],
        targetSymbolIds: var int32[]) =
    var keyPass: int32
    while keyPass < 8:
        var counts: int32[]
        var offsets: int32[]
        setLen(counts, 256)
        setLen(offsets, 256)
        let shift = (keyPass & 3) * 8
        for row in 0..<readerFunctionIds.len:
            let value = keyPass < 4 ? targetSymbolIds[row] :
                                      readerFunctionIds[row]
            let bucket = (value >> shift) & 255
            counts[bucket] = counts[bucket] + 1
        var total: int32
        for bucket in 0..<256:
            offsets[bucket] = total
            total = total + counts[bucket]
        var nextReaders: int32[]
        var nextTargets: int32[]
        setLen(nextReaders, readerFunctionIds.len)
        setLen(nextTargets, targetSymbolIds.len)
        for row in 0..<readerFunctionIds.len:
            let value = keyPass < 4 ? targetSymbolIds[row] :
                                      readerFunctionIds[row]
            let bucket = (value >> shift) & 255
            let destination = offsets[bucket]
            nextReaders[destination] = readerFunctionIds[row]
            nextTargets[destination] = targetSymbolIds[row]
            offsets[bucket] = destination + 1
        readerFunctionIds = nextReaders
        targetSymbolIds = nextTargets
        keyPass = keyPass + 1

fn compilerSnapshotBuilderIncrementalRebuildReadsProduceValidatedInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        current: var incremental.SemanticSnapshotIncrementalPrebuildFacts,
        plan: var incremental.SemanticSnapshotIncrementalPrebuildPlan,
        validatedGraph: compilerSnapshotBuilderValidatedGraphState,
        out: var incremental.SemanticSnapshotIncrementalRebuildReadInput,
        err: var str): bool =
    out = incremental.SemanticSnapshotIncrementalRebuildReadInput()
    if !compilerSnapshotBuilderValidatedGraphStateMatches(
            csg, validatedGraph):
        err = " compiler snapshot builder: rebuild read validated graph binding mismatch"
        return false
    if !compilerSnapshotBuilderPrebuildFactsValidateInto(
            tables, csg, current, err):
        return false
    if !layout.FixedBytes32Equal(plan.factsCid, current.factsCid):
        err = " compiler snapshot builder: rebuild read prebuild facts binding mismatch"
        return false
    if plan.functionIds.len != current.functionSymbolIds.len:
        err = " compiler snapshot builder: rebuild read function domain mismatch"
        return false
    if plan.partitionKinds.len != plan.functionIds.len:
        err = " compiler snapshot builder: rebuild read partition shape mismatch"
        return false
    if plan.reusableFunctionIds.len + plan.rebuildFunctionIds.len !=
           plan.functionIds.len:
        err = " compiler snapshot builder: rebuild read partition coverage mismatch"
        return false
    var reuseCursor: int32
    var rebuildCursor: int32
    for functionId in 0..<plan.functionIds.len:
        if plan.functionIds[functionId] != functionId:
            err = " compiler snapshot builder: rebuild read producer function identity mismatch"
            return false
        if plan.partitionKinds[functionId] ==
               incremental.SemanticSnapshotIncrementalPartitionReusable:
            if reuseCursor >= plan.reusableFunctionIds.len ||
               plan.reusableFunctionIds[reuseCursor] != functionId:
                err = " compiler snapshot builder: reusable producer partition mismatch"
                return false
            reuseCursor = reuseCursor + 1
        elif plan.partitionKinds[functionId] ==
                 incremental.SemanticSnapshotIncrementalPartitionRebuildRequired:
            if rebuildCursor >= plan.rebuildFunctionIds.len ||
               plan.rebuildFunctionIds[rebuildCursor] != functionId:
                err = " compiler snapshot builder: rebuild producer partition mismatch"
                return false
            rebuildCursor = rebuildCursor + 1
        else:
            err = " compiler snapshot builder: rebuild read producer unknown partition"
            return false
    if reuseCursor != plan.reusableFunctionIds.len ||
       rebuildCursor != plan.rebuildFunctionIds.len:
        err = " compiler snapshot builder: rebuild read producer partition coverage mismatch"
        return false
    var readerFunctionIds: int32[]
    var targetSymbolIds: int32[]
    var relevantFunctionIds: int32[]
    var relevantTargetSymbolIds: int32[]
    var relevantCallRows: int32[]
    var factCountsByFunction: int32[]
    setLen(factCountsByFunction, plan.functionIds.len)
    var symbolIdByGraphNode: int32[]
    if !compilerSnapshotBuilderGraphNodeSymbolIdsInto(
            tables, csg, current,
            symbolIdByGraphNode, err):
        return false
    for callRow in 0..<csg.semanticGraph.resolvedCallTable.sourceIndexes.len:
        if csg.semanticGraph.resolvedCallTable.callTargetImportcFlags[callRow]:
            continue
        let callerNodeId =
            csg.semanticGraph.resolvedCallTable.callerGraphNodeIds[callRow]
        let targetNodeId =
            csg.semanticGraph.resolvedCallTable.targetGraphNodeIds[callRow]
        let callerSymbolId = symbolIdByGraphNode[callerNodeId]
        let targetSymbolId = symbolIdByGraphNode[targetNodeId]
        let functionId = compilerSnapshotBuilderFunctionFind(
            current.functionSymbolIds, callerSymbolId)
        if functionId < 0 || targetSymbolId < 0:
            err = " compiler snapshot builder: resolved call outside current symbol domain"
            return false
        if compilerSnapshotBuilderRebuildPartitionContains(plan, functionId):
            let producerSourceId =
                csg.semanticGraph.resolvedCallTable.sourceIndexes[callRow]
            let canonicalSourceId =
                compilerSnapshotBuilderCanonicalSourceForProducer(
                    tables, producerSourceId)
            let originNodeId =
                csg.semanticGraph.resolvedCallTable.originParserNodeIds[callRow]
            if canonicalSourceId < 0 ||
               canonicalSourceId != current.functionSourceIds[functionId] ||
               originNodeId < 0 ||
               factCountsByFunction[functionId] == 2147483647:
                err = " compiler snapshot builder: resolved call producer identity invalid"
                return false
            add(readerFunctionIds, functionId)
            add(targetSymbolIds, targetSymbolId)
            add(relevantFunctionIds, functionId)
            add(relevantTargetSymbolIds, targetSymbolId)
            add(relevantCallRows, callRow)
            factCountsByFunction[functionId] =
                factCountsByFunction[functionId] + 1
    compilerSnapshotBuilderReadPairRadixSort(
        readerFunctionIds, targetSymbolIds)
    var factStartsByFunction: int32[]
    var factWriteCursors: int32[]
    var factCursor: int32
    for functionId in 0..<plan.functionIds.len:
        add(factStartsByFunction, factCursor)
        add(factWriteCursors, factCursor)
        if factCountsByFunction[functionId] >
               2147483647 - factCursor:
            err = " compiler snapshot builder: resolved call fact count overflow"
            return false
        factCursor = factCursor + factCountsByFunction[functionId]
    if factCursor != relevantCallRows.len:
        err = " compiler snapshot builder: resolved call fact coverage drift"
        return false
    var groupedCallRows: int32[]
    var groupedTargetSymbolIds: int32[]
    setLen(groupedCallRows, relevantCallRows.len)
    setLen(groupedTargetSymbolIds, relevantCallRows.len)
    for index in 0..<relevantCallRows.len:
        let functionId = relevantFunctionIds[index]
        let destination = factWriteCursors[functionId]
        groupedCallRows[destination] = relevantCallRows[index]
        groupedTargetSymbolIds[destination] =
            relevantTargetSymbolIds[index]
        factWriteCursors[functionId] = destination + 1
    for functionId in 0..<plan.functionIds.len:
        if factWriteCursors[functionId] !=
               factStartsByFunction[functionId] +
                   factCountsByFunction[functionId]:
            err = " compiler snapshot builder: resolved call fact partition drift"
            return false
    var rebuilt: incremental.SemanticSnapshotIncrementalRebuildReadInput
    if !incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
           current, plan,
           validatedGraph.retainedFactsCid,
           relevantCallRows.len,
           rebuilt, err):
        return false
    var rowCursor: int32
    var readRowByTargetSymbolId: int32[]
    setLen(readRowByTargetSymbolId, current.symbolCids.len)
    for symbolId in 0..<readRowByTargetSymbolId.len:
        readRowByTargetSymbolId[symbolId] = -1
    for rebuildIndex in 0..<plan.rebuildFunctionIds.len:
        let functionId = plan.rebuildFunctionIds[rebuildIndex]
        let expectedFunctionFactCount =
            factCountsByFunction[functionId]
        if !incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               current, plan, rebuilt, functionId,
               expectedFunctionFactCount, err):
            return false
        while rowCursor < readerFunctionIds.len &&
              readerFunctionIds[rowCursor] < functionId:
            err = " compiler snapshot builder: rebuild read producer partition drift"
            return false
        var touchedTargetSymbolIds: int32[]
        while rowCursor < readerFunctionIds.len &&
              readerFunctionIds[rowCursor] == functionId:
            let targetSymbolId = targetSymbolIds[rowCursor]
            if readRowByTargetSymbolId[targetSymbolId] < 0:
                var readRowId: int32
                let targetPortableKeyCid =
                    layout.FixedBytes32Copy(
                        current.symbolCids[targetSymbolId])
                let observedValueCid =
                    layout.FixedBytes32Copy(
                        current.symbolInterfaceCids[targetSymbolId])
                if !incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
                       current, plan, rebuilt, functionId,
                       snapshot_schema.CsgCompilerReadDomainSymbolInterface,
                       targetPortableKeyCid,
                       observedValueCid,
                       readRowId, err):
                    return false
                readRowByTargetSymbolId[targetSymbolId] = readRowId
                add(touchedTargetSymbolIds, targetSymbolId)
            rowCursor = rowCursor + 1
        let factStart = factStartsByFunction[functionId]
        for offset in 0..<expectedFunctionFactCount:
            let groupedRow = factStart + offset
            let callRow = groupedCallRows[groupedRow]
            let targetSymbolId = groupedTargetSymbolIds[groupedRow]
            let readRowId = readRowByTargetSymbolId[targetSymbolId]
            if readRowId < 0:
                err = " compiler snapshot builder: resolved call read row missing"
                return false
            if !incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
                   current, plan, rebuilt, functionId, readRowId,
                   incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
                   csg.semanticGraph.resolvedCallTable.sourceIndexes[callRow],
                   current.functionSourceIds[functionId],
                   callRow,
                   csg.semanticGraph.resolvedCallTable.originParserNodeIds[callRow],
                   err):
                return false
        if !incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
               current, plan, rebuilt, functionId, err):
            return false
        for index in 0..<touchedTargetSymbolIds.len:
            readRowByTargetSymbolId[
                touchedTargetSymbolIds[index]] = -1
    if rowCursor != readerFunctionIds.len:
        err = " compiler snapshot builder: rebuild read producer coverage mismatch"
        return false
    for factIndex in 0..<rebuilt.producerFactRowIds.len:
        let functionId = rebuilt.producerFactFunctionIds[factIndex]
        let invocationIndex = compilerSnapshotBuilderFunctionFind(
            rebuilt.functionIds, functionId)
        let canonicalSourceId =
            rebuilt.producerCanonicalSourceIds[factIndex]
        let producerSourceId = rebuilt.producerSourceIds[factIndex]
        let readRowId = rebuilt.producerFactReadRowIds[factIndex]
        if invocationIndex < 0 || canonicalSourceId < 0 ||
           canonicalSourceId >= current.sourceProducerIndexes.len ||
           canonicalSourceId != current.functionSourceIds[functionId] ||
           producerSourceId !=
               current.sourceProducerIndexes[canonicalSourceId] ||
           readRowId < rebuilt.readStarts[invocationIndex] ||
           readRowId >= rebuilt.readStarts[invocationIndex] +
               rebuilt.readCounts[invocationIndex]:
            err = Fmt" compiler snapshot builder: resolved call receipt binding drift fact={factIndex} function={functionId} invocation={invocationIndex} producer={producerSourceId} canonical={canonicalSourceId} read={readRowId}"
            return false
    if !incremental.SemanticSnapshotIncrementalRebuildReadProducerSealInto(
           current, plan, rebuilt, err):
        return false
    out = rebuilt
    err = ""
    return true

fn CompilerSnapshotIncrementalRebuildReadsProduceInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        current: var incremental.SemanticSnapshotIncrementalPrebuildFacts,
        plan: var incremental.SemanticSnapshotIncrementalPrebuildPlan,
        out: var incremental.SemanticSnapshotIncrementalRebuildReadInput,
        err: var str): bool =
    out = incremental.SemanticSnapshotIncrementalRebuildReadInput()
    var validatedGraph: compilerSnapshotBuilderValidatedGraphState
    if !compilerSnapshotBuilderValidatedGraphStateMakeInto(
           csg, validatedGraph, err):
        return false
    return compilerSnapshotBuilderIncrementalRebuildReadsProduceValidatedInto(
        tables, csg, current, plan, validatedGraph, out, err)

@borrows
fn compilerSnapshotBuilderCsgSymbolPartitionStrictValidateInto(
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let ordinarySymbolCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    let externSymbolCount =
        csg.externFfiHandleContracts.functionSymbolIds.len
    var ordinarySymbolNodeSeen: bool[]
    var externSymbolNodeSeen: bool[]
    setLen(ordinarySymbolNodeSeen, csg.nodes.len + 1)
    setLen(externSymbolNodeSeen, csg.nodes.len + 1)
    for ordinaryRow in 0..<ordinarySymbolCount:
        let graphNodeId =
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[
                ordinaryRow]
        var nodeIndex: int32 = -1
        for candidateIndex in 0..<csg.nodes.len:
            if csg.nodes[candidateIndex].nodeId == graphNodeId:
                if nodeIndex >= 0:
                    err = " compiler snapshot builder: duplicate ordinary Symbol graph node"
                    return false
                nodeIndex = candidateIndex
        if graphNodeId <= 0 || graphNodeId > csg.nodes.len ||
           nodeIndex < 0 || ordinarySymbolNodeSeen[graphNodeId] ||
           csg.nodes[nodeIndex].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol:
            err = " compiler snapshot builder: ordinary Symbol partition invalid"
            return false
        ordinarySymbolNodeSeen[graphNodeId] = true
    for contractRow in 0..<externSymbolCount:
        let graphNodeId =
            csg.externFfiHandleContracts.functionSymbolIds[contractRow]
        var nodeIndex: int32 = -1
        for candidateIndex in 0..<csg.nodes.len:
            if csg.nodes[candidateIndex].nodeId == graphNodeId:
                if nodeIndex >= 0:
                    err = " compiler snapshot builder: duplicate extern Symbol graph node"
                    return false
                nodeIndex = candidateIndex
        if graphNodeId <= 0 || graphNodeId > csg.nodes.len ||
           nodeIndex < 0 || externSymbolNodeSeen[graphNodeId] ||
           ordinarySymbolNodeSeen[graphNodeId] ||
           csg.nodes[nodeIndex].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol:
            err = " compiler snapshot builder: extern Symbol partition invalid"
            return false
        externSymbolNodeSeen[graphNodeId] = true
    var observedSymbolCount: int32
    for nodeIndex in 0..<csg.nodes.len:
        let graphNodeId = csg.nodes[nodeIndex].nodeId
        if csg.nodes[nodeIndex].nodeKind ==
               ccsg.CompilerCsgNodeKindSymbol:
            if graphNodeId <= 0 || graphNodeId > csg.nodes.len ||
               (ordinarySymbolNodeSeen[graphNodeId] ==
                    externSymbolNodeSeen[graphNodeId]):
                err = " compiler snapshot builder: graph Symbol partition is not exhaustive"
                return false
            observedSymbolCount = observedSymbolCount + 1
        elif graphNodeId > 0 && graphNodeId <= csg.nodes.len &&
             (ordinarySymbolNodeSeen[graphNodeId] ||
              externSymbolNodeSeen[graphNodeId]):
            err = " compiler snapshot builder: non-Symbol entered Symbol partition"
            return false
    if observedSymbolCount != ordinarySymbolCount + externSymbolCount:
        err = " compiler snapshot builder: graph Symbol partition cardinality drift"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderPrebuildFactsValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        facts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        err: var str): bool =
    if !incremental.SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
            facts, err):
        return false
    let sourceCount = tables.sources.documentCids.len
    if !compilerSnapshotBuilderParserShape(tables) ||
       facts.documentCids.len != sourceCount ||
       csg.semanticGraph.sourceTable.sourcePaths.len != sourceCount ||
       !layout.FixedBytes32Equal(facts.sourceBundleCid,
                                 csg.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
           facts.frontEndReceiptCid,
           csg.parserNormalizedExprReceipt.envelope.receiptRaw32):
        err = " compiler snapshot builder: prebuild source/receipt binding mismatch"
        return false
    var producerSeen: bool[]
    setLen(producerSeen, sourceCount)
    for sourceId in 0..<sourceCount:
        let producerSourceId =
            tables.parserSidecars.producerSourceIndexes[sourceId]
        let moduleTextId = tables.sources.modulePathTextIds[sourceId]
        if tables.parserSidecars.sourceIds[sourceId] != sourceId ||
           producerSourceId < 0 || producerSourceId >= sourceCount ||
           producerSeen[producerSourceId] ||
           facts.sourceProducerIndexes[sourceId] != producerSourceId ||
           moduleTextId < 0 || moduleTextId >= tables.texts.len ||
           tables.texts[moduleTextId] !=
               csg.semanticGraph.sourceTable.modulePaths[producerSourceId] ||
           !layout.FixedBytes32Equal(
               facts.documentCids[sourceId],
               tables.sources.documentCids[sourceId]) ||
           !layout.FixedBytes32Equal(
               facts.sourceContentCids[sourceId],
               tables.sources.contentCids[sourceId]) ||
           !layout.FixedBytes32Equal(
               facts.sourceInterfaceCids[sourceId],
               tables.sources.interfaceCids[sourceId]):
            err = " compiler snapshot builder: prebuild document binding mismatch"
            return false
        producerSeen[producerSourceId] = true
    if !compilerSnapshotBuilderCsgSymbolPartitionStrictValidateInto(
           csg, err):
        return false
    let functionCount =
        csg.semanticGraph.reachableFunctionTable.graphNodeIds.len
    let externSymbolCount =
        csg.externFfiHandleContracts.functionSymbolIds.len
    var graphSymbolCount: int32
    for nodeId in 0..<csg.nodes.len:
        if csg.nodes[nodeId].nodeKind ==
               ccsg.CompilerCsgNodeKindSymbol:
            graphSymbolCount = graphSymbolCount + 1
    if graphSymbolCount != functionCount + externSymbolCount ||
       facts.symbolCids.len != functionCount ||
       facts.functionSymbolIds.len != functionCount ||
       tables.parserSidecars.functionIndexes.len != functionCount:
        err = " compiler snapshot builder: prebuild symbol/function coverage mismatch"
        return false
    var parserRowByFunctionIndex: int32[]
    setLen(parserRowByFunctionIndex, functionCount)
    for functionIndex in 0..<functionCount:
        parserRowByFunctionIndex[functionIndex] = -1
    for parserRow in 0..<tables.parserSidecars.functionIndexes.len:
        let functionIndex =
            tables.parserSidecars.functionIndexes[parserRow]
        if functionIndex < 0 || functionIndex >= functionCount ||
           parserRowByFunctionIndex[functionIndex] >= 0:
            err = " compiler snapshot builder: parser function identity is not bijective"
            return false
        parserRowByFunctionIndex[functionIndex] = parserRow
    var symbolSeen: bool[]
    setLen(symbolSeen, facts.symbolCids.len)
    var functionSeen: bool[]
    setLen(functionSeen, facts.functionSymbolIds.len)
    var reachableRowByGraphNodeId: int32[]
    setLen(reachableRowByGraphNodeId, csg.nodes.len + 1)
    for graphNodeId in 0..<reachableRowByGraphNodeId.len:
        reachableRowByGraphNodeId[graphNodeId] = -1
    for reachableId in 0..<functionCount:
        let graphNodeId =
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[reachableId]
        if graphNodeId <= 0 || graphNodeId > csg.nodes.len:
            err = " compiler snapshot builder: prebuild graph node missing"
            return false
        let parserRow = parserRowByFunctionIndex[reachableId]
        var functionId: int32
        if parserRow < 0 ||
           !compilerSnapshotBuilderPrebuildFunctionForParserRowInto(
                tables, parserRow, facts, functionId, err):
            return false
        let symbolId = functionId < 0 ||
            functionId >= facts.functionSymbolIds.len ? -1 :
            facts.functionSymbolIds[functionId]
        let producerSourceId =
            csg.semanticGraph.reachableFunctionTable.sourceIndex[reachableId]
        let sourceId = compilerSnapshotBuilderCanonicalSourceForProducer(
            tables, producerSourceId)
        let declarationSpanId =
            tables.parserSidecars.functionDeclarationSpanIds[parserRow]
        let nameSpanId = tables.parserSidecars.functionNameSpanIds[parserRow]
        let bodySpanId = tables.parserSidecars.functionBodySpanIds[parserRow]
        let functionNameTextId =
            tables.parserSidecars.functionNameTextIds[parserRow]
        if symbolId < 0 || functionId < 0 || sourceId < 0 ||
           symbolSeen[symbolId] || functionSeen[functionId] ||
           facts.functionSourceIds[functionId] != sourceId ||
           declarationSpanId < 0 ||
           declarationSpanId >= tables.spans.sourceIds.len ||
           nameSpanId < 0 || nameSpanId >= tables.spans.sourceIds.len ||
           bodySpanId < 0 || bodySpanId >= tables.spans.sourceIds.len ||
           functionNameTextId < 0 ||
           functionNameTextId >= tables.texts.len ||
           tables.spans.sourceIds[declarationSpanId] != sourceId ||
           tables.spans.sourceIds[nameSpanId] != sourceId ||
           tables.spans.sourceIds[bodySpanId] != sourceId ||
           tables.parserSidecars.functionSignatureLineNumbers[parserRow] !=
               csg.semanticGraph.reachableFunctionTable.startLines[reachableId] ||
           tables.texts[functionNameTextId] !=
               csg.semanticGraph.reachableFunctionTable.functionNames[reachableId] ||
           tables.spans.startBytes[bodySpanId] !=
               facts.bodyStartBytes[functionId] ||
           tables.spans.endBytes[bodySpanId] !=
               facts.bodyEndBytes[functionId] ||
           !layout.FixedBytes32Equal(
               facts.functionInterfaceCids[functionId],
               facts.symbolInterfaceCids[symbolId]):
            err = " compiler snapshot builder: prebuild function binding mismatch"
            return false
        symbolSeen[symbolId] = true
        functionSeen[functionId] = true
        reachableRowByGraphNodeId[graphNodeId] = reachableId
    for symbolId in 0..<symbolSeen.len:
        if !symbolSeen[symbolId]:
            err = " compiler snapshot builder: prebuild symbol is not in graph"
            return false
    if csg.semanticGraph.typedIrTable.functionGraphNodeIds.len > functionCount:
        err = " compiler snapshot builder: typed function coverage exceeds functions"
        return false
    var typedFunctionSeen: bool[]
    setLen(typedFunctionSeen, facts.functionSymbolIds.len)
    for typedFunctionIndex in 0..<csg.semanticGraph.typedIrTable.functionGraphNodeIds.len:
        let graphNodeId =
            csg.semanticGraph.typedIrTable.functionGraphNodeIds[typedFunctionIndex]
        if graphNodeId <= 0 || graphNodeId >= reachableRowByGraphNodeId.len:
            err = " compiler snapshot builder: typed function graph identity missing"
            return false
        let reachableId = reachableRowByGraphNodeId[graphNodeId]
        var functionId: int32
        if reachableId < 0 ||
           !compilerSnapshotBuilderPrebuildFunctionForParserRowInto(
                tables, parserRowByFunctionIndex[reachableId],
                facts, functionId, err):
            return false
        let symbolId = functionId < 0 ||
            functionId >= facts.functionSymbolIds.len ? -1 :
            facts.functionSymbolIds[functionId]
        let producerSourceId =
            csg.semanticGraph.typedIrTable.functionSourceIndexes[typedFunctionIndex]
        let sourceId = compilerSnapshotBuilderCanonicalSourceForProducer(
            tables, producerSourceId)
        if reachableId < 0 || symbolId < 0 || functionId < 0 ||
           sourceId < 0 || typedFunctionSeen[functionId] ||
           csg.semanticGraph.reachableFunctionTable.graphNodeIds[reachableId] !=
               graphNodeId ||
           csg.semanticGraph.reachableFunctionTable.sourceIndex[reachableId] !=
               producerSourceId ||
           facts.functionSourceIds[functionId] != sourceId:
            err = " compiler snapshot builder: typed function exact binding mismatch"
            return false
        typedFunctionSeen[functionId] = true
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderFinalizedReadsValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: ccsg.CompilerCsg,
        prebuildFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        err: var str): bool =
    if !incremental.SemanticSnapshotIncrementalFinalizedReadSetCurrentStrictValidateInto(
            prebuildFacts, finalized, err):
        return false
    var matchedReads: bool[]
    setLen(matchedReads, finalized.readSet.readerFunctionIds.len)
    var symbolIdByGraphNode: int32[]
    if !compilerSnapshotBuilderGraphNodeSymbolIdsInto(
            tables, csg, prebuildFacts,
            symbolIdByGraphNode, err):
        return false
    for callRow in 0..<csg.semanticGraph.resolvedCallTable.sourceIndexes.len:
        if csg.semanticGraph.resolvedCallTable.callTargetImportcFlags[callRow]:
            continue
        let callerGraphNodeId =
            csg.semanticGraph.resolvedCallTable.callerGraphNodeIds[callRow]
        let targetGraphNodeId =
            csg.semanticGraph.resolvedCallTable.targetGraphNodeIds[callRow]
        let callerSymbolId = symbolIdByGraphNode[callerGraphNodeId]
        let targetSymbolId = symbolIdByGraphNode[targetGraphNodeId]
        let callerFunctionId = compilerSnapshotBuilderFunctionFind(
            prebuildFacts.functionSymbolIds, callerSymbolId)
        let readRow = compilerSnapshotBuilderFinalizedReadFind(
            finalized, callerFunctionId,
            snapshot_schema.CsgCompilerReadDomainSymbolInterface,
            prebuildFacts.symbolCids[targetSymbolId])
        if callerFunctionId < 0 || targetSymbolId < 0 || readRow < 0:
            err = " compiler snapshot builder: resolved call missing from exact read set"
            return false
        matchedReads[readRow] = true
    for readRow in 0..<matchedReads.len:
        if !matchedReads[readRow]:
            err = " compiler snapshot builder: finalized portable read is absent from retained CompilerCSG facts"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderFinalizedReadProjectionEqual(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        finalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet): bool =
    if tables.functions.readStarts.len != finalized.readStarts.len ||
       tables.functions.readCounts.len != finalized.readCounts.len ||
       tables.functions.readSetPreimageCids.len !=
           finalized.readSetPreimageCids.len ||
       tables.readSet.readerFunctionIds.len !=
           finalized.readSet.readerFunctionIds.len ||
       tables.readSet.reverseStarts.len !=
           finalized.readSet.reverseStarts.len ||
       tables.readSet.reverseTargetDomainKinds.len !=
           finalized.readSet.reverseTargetDomainKinds.len ||
       tables.readSet.reverseReaderFunctionIds.len !=
           finalized.readSet.reverseReaderFunctionIds.len ||
       !layout.FixedBytes32Equal(tables.readSet.reverseIndexCid,
                                 finalized.readSet.reverseIndexCid):
        return false
    for functionId in 0..<finalized.readStarts.len:
        if tables.functions.readStarts[functionId] !=
               finalized.readStarts[functionId] ||
           tables.functions.readCounts[functionId] !=
               finalized.readCounts[functionId] ||
           !layout.FixedBytes32Equal(
               tables.functions.readSetPreimageCids[functionId],
               finalized.readSetPreimageCids[functionId]):
            return false
    for row in 0..<finalized.readSet.readerFunctionIds.len:
        if tables.readSet.readerFunctionIds[row] !=
               finalized.readSet.readerFunctionIds[row] ||
           tables.readSet.targetDomainKinds[row] !=
               finalized.readSet.targetDomainKinds[row] ||
           !layout.FixedBytes32Equal(tables.readSet.observedValueCids[row],
                                     finalized.readSet.observedValueCids[row]) ||
           !layout.FixedBytes32Equal(
               tables.readSet.targetPortableKeyCids[row],
               finalized.readSet.targetPortableKeyCids[row]):
            return false
    for targetId in 0..<finalized.readSet.reverseStarts.len:
        if tables.readSet.reverseTargetDomainKinds[targetId] !=
               finalized.readSet.reverseTargetDomainKinds[targetId] ||
           !layout.FixedBytes32Equal(
               tables.readSet.reverseTargetPortableKeyCids[targetId],
               finalized.readSet.reverseTargetPortableKeyCids[targetId]) ||
           tables.readSet.reverseStarts[targetId] !=
               finalized.readSet.reverseStarts[targetId] ||
           tables.readSet.reverseCounts[targetId] !=
               finalized.readSet.reverseCounts[targetId]:
            return false
    for row in 0..<finalized.readSet.reverseReaderFunctionIds.len:
        if tables.readSet.reverseReaderFunctionIds[row] !=
               finalized.readSet.reverseReaderFunctionIds[row] ||
           !layout.FixedBytes32Equal(
               tables.readSet.reverseObservedValueCids[row],
               finalized.readSet.reverseObservedValueCids[row]) ||
           tables.readSet.reverseForwardRowIds[row] !=
               finalized.readSet.reverseForwardRowIds[row]:
            return false
    return true

@borrows
fn compilerSnapshotBuilderGraphSourceShape(
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let sourceCount = csg.semanticGraph.sourceTable.sourcePaths.len
    let declCount = csg.semanticGraph.declTable.sourceIndex.len
    let importCount = csg.semanticGraph.importEdgeTable.ownerSourceIndex.len
    if sourceCount <= 0 || sourceCount != csg.sourceSnapshotCount ||
       csg.semanticGraph.sourceTable.modulePaths.len != sourceCount ||
       csg.semanticGraph.sourceTable.textBytes.len != sourceCount ||
       csg.semanticGraph.sourceTable.declStart.len != sourceCount ||
       csg.semanticGraph.sourceTable.declCount.len != sourceCount ||
       csg.semanticGraph.sourceTable.importEdgeStart.len != sourceCount ||
       csg.semanticGraph.sourceTable.importEdgeCount.len != sourceCount ||
       csg.semanticGraph.declTable.names.len != declCount ||
       csg.semanticGraph.declTable.lineNumbers.len != declCount ||
       csg.semanticGraph.declTable.importc.len != declCount ||
       csg.semanticGraph.declTable.exported.len != declCount ||
       csg.semanticGraph.importEdgeTable.targetSourceIndex.len != importCount ||
       csg.semanticGraph.importEdgeTable.ownerModulePaths.len != importCount ||
       csg.semanticGraph.importEdgeTable.targetModulePaths.len != importCount ||
       csg.semanticGraph.importEdgeTable.targetSourcePaths.len != importCount ||
       csg.semanticGraph.importEdgeTable.resolved.len != importCount:
        err = " compiler snapshot builder: compiler source fact shape mismatch"
        return false
    var expectedDeclStart: int32
    var expectedImportStart: int32
    for sourceIndex in 0..<sourceCount:
        let declStart = csg.semanticGraph.sourceTable.declStart[sourceIndex]
        let localDeclCount = csg.semanticGraph.sourceTable.declCount[sourceIndex]
        let importStart = csg.semanticGraph.sourceTable.importEdgeStart[sourceIndex]
        let localImportCount = csg.semanticGraph.sourceTable.importEdgeCount[sourceIndex]
        if csg.semanticGraph.sourceTable.sourcePaths[sourceIndex] == "" ||
           csg.semanticGraph.sourceTable.modulePaths[sourceIndex] == "" ||
           csg.semanticGraph.sourceTable.textBytes[sourceIndex] < 0 ||
           declStart != expectedDeclStart || localDeclCount < 0 ||
           declStart > declCount || localDeclCount > declCount - declStart ||
           importStart != expectedImportStart || localImportCount < 0 ||
           importStart > importCount ||
           localImportCount > importCount - importStart:
            err = " compiler snapshot builder: compiler source fact range mismatch"
            return false
        for previousSourceIndex in 0..<sourceIndex:
            if csg.semanticGraph.sourceTable.sourcePaths[sourceIndex] ==
                   csg.semanticGraph.sourceTable.sourcePaths[
                       previousSourceIndex] ||
               csg.semanticGraph.sourceTable.modulePaths[sourceIndex] ==
                   csg.semanticGraph.sourceTable.modulePaths[
                       previousSourceIndex]:
                err = " compiler snapshot builder: duplicate source authority"
                return false
        for localDeclIndex in 0..<localDeclCount:
            if csg.semanticGraph.declTable.sourceIndex[
                   declStart + localDeclIndex] != sourceIndex:
                err = " compiler snapshot builder: declaration owner range mismatch"
                return false
        for localImportIndex in 0..<localImportCount:
            if csg.semanticGraph.importEdgeTable.ownerSourceIndex[
                   importStart + localImportIndex] != sourceIndex:
                err = " compiler snapshot builder: import owner range mismatch"
                return false
        expectedDeclStart = expectedDeclStart + localDeclCount
        expectedImportStart = expectedImportStart + localImportCount
    if expectedDeclStart != declCount || expectedImportStart != importCount:
        err = " compiler snapshot builder: compiler source fact coverage mismatch"
        return false
    for declIndex in 0..<declCount:
        if csg.semanticGraph.declTable.sourceIndex[declIndex] < 0 ||
           csg.semanticGraph.declTable.sourceIndex[declIndex] >= sourceCount ||
           csg.semanticGraph.declTable.names[declIndex] == "" ||
           csg.semanticGraph.declTable.lineNumbers[declIndex] <= 0:
            err = " compiler snapshot builder: compiler declaration fact invalid"
            return false
    for importIndex in 0..<importCount:
        if csg.semanticGraph.importEdgeTable.ownerSourceIndex[importIndex] < 0 ||
           csg.semanticGraph.importEdgeTable.ownerSourceIndex[importIndex] >= sourceCount ||
           csg.semanticGraph.importEdgeTable.targetSourceIndex[importIndex] < 0 ||
           csg.semanticGraph.importEdgeTable.targetSourceIndex[importIndex] >= sourceCount ||
           !csg.semanticGraph.importEdgeTable.resolved[importIndex] ||
           csg.semanticGraph.importEdgeTable.ownerModulePaths[importIndex] == "" ||
           csg.semanticGraph.importEdgeTable.targetModulePaths[importIndex] == "" ||
           csg.semanticGraph.importEdgeTable.targetSourcePaths[importIndex] == "":
            err = " compiler snapshot builder: compiler import fact invalid"
            return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderSourceIndexForPhysicalPathInto(
        csg: ccsg.CompilerCsg,
        sourcePath: str,
        sourceIndexOut: var int32,
        err: var str): bool =
    sourceIndexOut = -1
    if sourcePath == "":
        err = " compiler snapshot builder: empty physical source path"
        return false
    for sourceIndex in 0..<csg.semanticGraph.sourceTable.sourcePaths.len:
        if csg.semanticGraph.sourceTable.sourcePaths[sourceIndex] ==
               sourcePath:
            if sourceIndexOut >= 0:
                err = " compiler snapshot builder: ambiguous physical source path"
                return false
            sourceIndexOut = sourceIndex
    if sourceIndexOut < 0:
        err = " compiler snapshot builder: physical source path is outside source authority"
        return false
    return true

@borrows
fn compilerSnapshotBuilderReachableShape(
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let count = csg.semanticGraph.reachableFunctionTable.sourceIndex.len
    if csg.semanticGraph.reachableFunctionTable.sourcePaths.len != count ||
       csg.semanticGraph.reachableFunctionTable.functionNames.len != count ||
       csg.semanticGraph.reachableFunctionTable.symbolTexts.len != count ||
       csg.semanticGraph.reachableFunctionTable.startLines.len != count ||
       csg.semanticGraph.reachableFunctionTable.endLines.len != count ||
       csg.semanticGraph.reachableFunctionTable.reachable.len != count ||
       csg.semanticGraph.reachableFunctionTable.graphNodeIds.len != count:
        err = " compiler snapshot builder: reachable function shape mismatch"
        return false
    var seenGraphNode: bool[]
    setLen(seenGraphNode, csg.nodes.len + 1)
    var graphNodeSeen: bool[]
    setLen(graphNodeSeen, csg.nodes.len + 1)
    for index in 0..<count:
        let sourceIndex = csg.semanticGraph.reachableFunctionTable.sourceIndex[index]
        let graphNodeId =
            csg.semanticGraph.reachableFunctionTable.graphNodeIds[index]
        if sourceIndex < 0 || sourceIndex >= csg.sourceSnapshotCount ||
           graphNodeId <= 0 || graphNodeId > csg.nodes.len ||
           seenGraphNode[graphNodeId] ||
           csg.nodes[graphNodeId - 1].nodeId != graphNodeId ||
           csg.nodes[graphNodeId - 1].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol ||
           csg.semanticGraph.reachableFunctionTable.sourcePaths[index] !=
               csg.semanticGraph.sourceTable.sourcePaths[sourceIndex] ||
           csg.semanticGraph.reachableFunctionTable.functionNames[index] == "" ||
           csg.semanticGraph.reachableFunctionTable.symbolTexts[index] == "" ||
           csg.semanticGraph.reachableFunctionTable.startLines[index] <= 0 ||
           csg.semanticGraph.reachableFunctionTable.endLines[index] <
               csg.semanticGraph.reachableFunctionTable.startLines[index] ||
           csg.nodes[graphNodeId - 1].semanticSource !=
               csg.semanticGraph.sourceTable.modulePaths[sourceIndex] ||
           csg.nodes[graphNodeId - 1].factText !=
               csg.semanticGraph.reachableFunctionTable.functionNames[index] ||
           csg.nodes[graphNodeId - 1].semanticDeclarationLineIndex !=
               csg.semanticGraph.reachableFunctionTable.startLines[index]:
            err = " compiler snapshot builder: reachable function fact invalid"
            return false
        seenGraphNode[graphNodeId] = true
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderTypedIrShape(
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let count = csg.semanticGraph.typedIrTable.functionSourceIndexes.len
    if csg.semanticGraph.typedIrTable.functionNames.len != count ||
       csg.semanticGraph.typedIrTable.functionGraphNodeIds.len != count ||
       csg.semanticGraph.typedIrTable.functionNodeStart.len != count ||
       csg.semanticGraph.typedIrTable.functionNodeCount.len != count ||
       csg.semanticGraph.typedIrTable.functionStatementStart.len != count ||
       csg.semanticGraph.typedIrTable.functionStatementCount.len != count ||
       !texpr.TypedExprIrFunctions2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrNodes2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrStatements2ShapeComplete(csg.typedIr) ||
       csg.typedIr.functions2_functionNameIds.len != count ||
       (count > 0 && csg.typedIr.internPool == nil):
        err = " compiler snapshot builder: typed IR fact shape mismatch"
        return false
    var graphNodeSeen: bool[]
    setLen(graphNodeSeen, csg.nodes.len + 1)
    for index in 0..<count:
        let sourceIndex = csg.semanticGraph.typedIrTable.functionSourceIndexes[index]
        let graphNodeId =
            csg.semanticGraph.typedIrTable.functionGraphNodeIds[index]
        let nodeStart = csg.semanticGraph.typedIrTable.functionNodeStart[index]
        let nodeCount = csg.semanticGraph.typedIrTable.functionNodeCount[index]
        let statementStart =
            csg.semanticGraph.typedIrTable.functionStatementStart[index]
        let statementCount =
            csg.semanticGraph.typedIrTable.functionStatementCount[index]
        let signatureLine = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_signatureLineNumbers,
            index)
        let sourcePathResult = langintern.LookupIntern(
            csg.typedIr.internPool,
            csg.typedIr.functions2_sourcePathIds[index])
        let functionNameResult = langintern.LookupIntern(
            csg.typedIr.internPool,
            csg.typedIr.functions2_functionNameIds[index])
        if sourceIndex < 0 || sourceIndex >= csg.sourceSnapshotCount ||
           graphNodeId <= 0 || graphNodeId > csg.nodes.len ||
           graphNodeSeen[graphNodeId] ||
           csg.nodes[graphNodeId - 1].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol ||
           nodeStart < 0 || nodeCount < 0 ||
           nodeStart > csg.typedIr.nodes2_nodeIndexs.len ||
           nodeCount > csg.typedIr.nodes2_nodeIndexs.len - nodeStart ||
           statementStart < 0 || statementCount < 0 ||
           statementStart > csg.typedIr.statements2_statementIndexs.len ||
           statementCount >
               csg.typedIr.statements2_statementIndexs.len - statementStart ||
           arenamod.ArenaArrayInt32Get(
               csg.typedIr.arena,
               csg.typedIr.functions2_nodeStarts,
               index) != nodeStart ||
           arenamod.ArenaArrayInt32Get(
               csg.typedIr.arena,
               csg.typedIr.functions2_nodeCounts,
               index) != nodeCount ||
           arenamod.ArenaArrayInt32Get(
               csg.typedIr.arena,
               csg.typedIr.functions2_statementStarts,
               index) != statementStart ||
           arenamod.ArenaArrayInt32Get(
               csg.typedIr.arena,
               csg.typedIr.functions2_statementCounts,
               index) != statementCount ||
           !IsOk(sourcePathResult) || !IsOk(functionNameResult) ||
           Value(sourcePathResult) !=
               csg.semanticGraph.sourceTable.sourcePaths[sourceIndex] ||
           Value(functionNameResult) !=
               csg.semanticGraph.typedIrTable.functionNames[index] ||
           csg.nodes[graphNodeId - 1].semanticSource !=
               csg.semanticGraph.sourceTable.modulePaths[sourceIndex] ||
           csg.nodes[graphNodeId - 1].factText !=
               Value(functionNameResult) ||
           csg.nodes[graphNodeId - 1].semanticDeclarationLineIndex !=
               signatureLine:
            err = " compiler snapshot builder: typed IR fact binding mismatch"
            return false
        graphNodeSeen[graphNodeId] = true
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderResolvedCallShape(
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    let functionCount = csg.semanticGraph.typedIrTable.functionNames.len
    let rowCount = csg.semanticGraph.resolvedCallTable.sourceIndexes.len
    if csg.semanticGraph.resolvedCallTable.internPool == nil ||
       csg.semanticGraph.resolvedCallTable.functionRowHeads.len != functionCount ||
       csg.semanticGraph.resolvedCallTable.originParserNodeIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.functionIndexes.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.functionRowNext.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.sourcePathIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.lineNumbers.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.columnNumbers.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callQualifierIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callCalleeIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callTargetIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callTargetSourcePathIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callTargetSignatureLineNumbers.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callTargetImportcFlags.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callArgCounts.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callArgsTextIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.returnRootFlags.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.callerGraphNodeIds.len != rowCount ||
       csg.semanticGraph.resolvedCallTable.targetGraphNodeIds.len != rowCount ||
       !csg.semanticGraph.resolvedCallTable.graphNodeProjectionComplete:
        err = " compiler snapshot builder: resolved call fact shape mismatch"
        return false
    for rowIndex in 0..<rowCount:
        let sourceIndex = csg.semanticGraph.resolvedCallTable.sourceIndexes[rowIndex]
        let functionIndex = csg.semanticGraph.resolvedCallTable.functionIndexes[rowIndex]
        let sourcePathResult = langintern.LookupIntern(
            csg.semanticGraph.resolvedCallTable.internPool,
            csg.semanticGraph.resolvedCallTable.sourcePathIds[rowIndex])
        let qualifierResult = langintern.LookupIntern(
            csg.semanticGraph.resolvedCallTable.internPool,
            csg.semanticGraph.resolvedCallTable.callQualifierIds[rowIndex])
        let calleeResult = langintern.LookupIntern(
            csg.semanticGraph.resolvedCallTable.internPool,
            csg.semanticGraph.resolvedCallTable.callCalleeIds[rowIndex])
        let targetResult = langintern.LookupIntern(
            csg.semanticGraph.resolvedCallTable.internPool,
            csg.semanticGraph.resolvedCallTable.callTargetIds[rowIndex])
        let targetSourceResult = langintern.LookupIntern(
            csg.semanticGraph.resolvedCallTable.internPool,
            csg.semanticGraph.resolvedCallTable.callTargetSourcePathIds[rowIndex])
        let argsResult = langintern.LookupIntern(
            csg.semanticGraph.resolvedCallTable.internPool,
            csg.semanticGraph.resolvedCallTable.callArgsTextIds[rowIndex])
        let callerGraphNodeId =
            csg.semanticGraph.resolvedCallTable.callerGraphNodeIds[rowIndex]
        let targetGraphNodeId =
            csg.semanticGraph.resolvedCallTable.targetGraphNodeIds[rowIndex]
        let targetSignatureLine =
            csg.semanticGraph.resolvedCallTable.callTargetSignatureLineNumbers[rowIndex]
        if sourceIndex < 0 || sourceIndex >= csg.sourceSnapshotCount ||
           csg.semanticGraph.resolvedCallTable.originParserNodeIds[rowIndex] < 0 ||
           functionIndex < 0 || functionIndex >= functionCount ||
           callerGraphNodeId <= 0 || callerGraphNodeId > csg.nodes.len ||
           csg.nodes[callerGraphNodeId - 1].nodeKind !=
               ccsg.CompilerCsgNodeKindSymbol ||
           csg.semanticGraph.typedIrTable.functionSourceIndexes[functionIndex] !=
               sourceIndex ||
           csg.semanticGraph.resolvedCallTable.functionRowNext[rowIndex] < -1 ||
           csg.semanticGraph.resolvedCallTable.functionRowNext[rowIndex] >= rowCount ||
           csg.semanticGraph.resolvedCallTable.lineNumbers[rowIndex] <= 0 ||
           csg.semanticGraph.resolvedCallTable.columnNumbers[rowIndex] < 0 ||
           csg.semanticGraph.resolvedCallTable.callArgCounts[rowIndex] < 0 ||
           (csg.semanticGraph.resolvedCallTable.callTargetImportcFlags[rowIndex] &&
            csg.semanticGraph.resolvedCallTable.callTargetSignatureLineNumbers[rowIndex] != 0) ||
           (!csg.semanticGraph.resolvedCallTable.callTargetImportcFlags[rowIndex] &&
            csg.semanticGraph.resolvedCallTable.callTargetSignatureLineNumbers[rowIndex] <= 0) ||
           !IsOk(sourcePathResult) || !IsOk(qualifierResult) ||
           !IsOk(calleeResult) || !IsOk(targetResult) ||
           !IsOk(targetSourceResult) || !IsOk(argsResult) ||
           Value(sourcePathResult) !=
               csg.semanticGraph.sourceTable.sourcePaths[sourceIndex] ||
           csg.nodes[callerGraphNodeId - 1].semanticSource !=
               csg.semanticGraph.sourceTable.modulePaths[sourceIndex] ||
           csg.nodes[callerGraphNodeId - 1].factText !=
               csg.semanticGraph.typedIrTable.functionNames[functionIndex] ||
           Value(calleeResult) == "" || Value(targetResult) == "" ||
           Value(targetSourceResult) == "":
            err = " compiler snapshot builder: resolved call fact invalid"
            return false
        if csg.semanticGraph.resolvedCallTable.callTargetImportcFlags[rowIndex]:
            if targetGraphNodeId != -1:
                err = " compiler snapshot builder: importc call has graph target"
                return false
        else:
            var targetSourceIndex: int32
            if !compilerSnapshotBuilderSourceIndexForPhysicalPathInto(
                    csg, Value(targetSourceResult), targetSourceIndex, err):
                return false
            if targetGraphNodeId <= 0 ||
               targetGraphNodeId > csg.nodes.len ||
               csg.nodes[targetGraphNodeId - 1].nodeKind !=
                   ccsg.CompilerCsgNodeKindSymbol ||
               csg.nodes[targetGraphNodeId - 1].semanticSource !=
                   csg.semanticGraph.sourceTable.modulePaths[
                       targetSourceIndex] ||
               csg.nodes[targetGraphNodeId - 1].factText !=
                   Value(targetResult) ||
               csg.nodes[targetGraphNodeId - 1].semanticDeclarationLineIndex !=
                   targetSignatureLine:
                err = " compiler snapshot builder: resolved call graph target mismatch"
                return false
    var chainedCount: int32
    for functionIndex in 0..<functionCount:
        var rowIndex =
            csg.semanticGraph.resolvedCallTable.functionRowHeads[functionIndex]
        var localCount: int32
        while rowIndex >= 0:
            if rowIndex >= rowCount ||
               csg.semanticGraph.resolvedCallTable.functionIndexes[rowIndex] !=
                   functionIndex ||
               localCount >= rowCount:
                err = " compiler snapshot builder: resolved call adjacency invalid"
                return false
            localCount = localCount + 1
            rowIndex = csg.semanticGraph.resolvedCallTable.functionRowNext[rowIndex]
        chainedCount = chainedCount + localCount
    if chainedCount != rowCount:
        err = " compiler snapshot builder: resolved call adjacency incomplete"
        return false
    err = ""
    return true

fn compilerSnapshotBuilderGraphNodeKindKnown(kind: int32): bool =
    return kind == ccsg.CompilerCsgNodeKindPackage ||
           kind == ccsg.CompilerCsgNodeKindModule ||
           kind == ccsg.CompilerCsgNodeKindSymbol ||
           kind == ccsg.CompilerCsgNodeKindLayout ||
           kind == ccsg.CompilerCsgNodeKindEffect ||
           kind == ccsg.CompilerCsgNodeKindCapability

fn compilerSnapshotBuilderGraphEdgeKindKnown(kind: int32): bool =
    return kind == ccsg.CompilerCsgEdgeKindContains ||
           kind == ccsg.CompilerCsgEdgeKindImports ||
           kind == ccsg.CompilerCsgEdgeKindHasLayout ||
           kind == ccsg.CompilerCsgEdgeKindHasEffect ||
           kind == ccsg.CompilerCsgEdgeKindHasCapability

@borrows
fn compilerSnapshotBuilderGraphStrictValidateInto(
        csg: ccsg.CompilerCsg,
        err: var str): bool =
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
           csg.sourceIdentityReceipt, err):
        return false
    if csg.packageId == "" || csg.nodes.len <= 0 ||
       csg.nodeCount != csg.nodes.len ||
       csg.edgeCount != csg.edges.len:
        err = Fmt" compiler snapshot builder: compiler graph envelope shape invalid package={csg.packageId} nodes={csg.nodes.len} node_count={csg.nodeCount} edges={csg.edges.len} edge_count={csg.edgeCount}"
        return false
    if !compilerSnapshotBuilderCidObserved(csg.sourceBundleCid) ||
       !compilerSnapshotBuilderCidObserved(csg.entrySourceCid) ||
       !compilerSnapshotBuilderCidObserved(csg.canonicalGraphCid) ||
       !compilerSnapshotBuilderCidObserved(csg.graphCid):
        err = " compiler snapshot builder: compiler graph envelope CID missing"
        return false
    if csg.sourceIdentityReceipt.sourceSnapshotCount !=
           csg.sourceSnapshotCount ||
       csg.sourceIdentityReceipt.importEdgeCount !=
           csg.semanticGraph.importEdgeTable.ownerSourceIndex.len:
        err = Fmt" compiler snapshot builder: compiler graph envelope count drift receipt_sources={csg.sourceIdentityReceipt.sourceSnapshotCount} sources={csg.sourceSnapshotCount} receipt_imports={csg.sourceIdentityReceipt.importEdgeCount} imports={csg.semanticGraph.importEdgeTable.ownerSourceIndex.len}"
        return false
    if !layout.FixedBytes32Equal(
           csg.sourceIdentityReceipt.sourcePackageIdCid,
           ccsg.CompilerCsgPortableSourcePackageIdCid(
               csg.packageId)):
        err = " compiler snapshot builder: compiler graph package identity drift"
        return false
    if !layout.FixedBytes32Equal(
           csg.sourceBundleCid,
           csg.sourceIdentityReceipt.sourceBundleCid):
        err = " compiler snapshot builder: compiler graph source bundle identity drift"
        return false
    if !layout.FixedBytes32Equal(
           csg.entrySourceCid,
           csg.sourceIdentityReceipt.entrySourceCid):
        err = " compiler snapshot builder: compiler graph entry source identity drift"
        return false
    if !compilerSnapshotBuilderGraphSourceShape(csg, err):
        return false
    var packageNodeCount: int32
    for index in 0..<csg.nodes.len:
        if csg.nodes[index].nodeId != index + 1 ||
           !compilerSnapshotBuilderGraphNodeKindKnown(
               csg.nodes[index].nodeKind) ||
           csg.nodes[index].ownerNodeId < 0 ||
           csg.nodes[index].ownerNodeId > csg.nodes.len ||
           csg.nodes[index].semanticDeclarationLineIndex < 0 ||
           csg.nodes[index].semanticSignatureComplete < 0 ||
           csg.nodes[index].semanticSignatureComplete > 1 ||
           csg.nodes[index].entryFlag < 0 ||
           csg.nodes[index].entryFlag > 1 ||
           csg.nodes[index].exportedFlag < 0 ||
           csg.nodes[index].exportedFlag > 1 ||
           csg.nodes[index].exportNameExplicit < 0 ||
           csg.nodes[index].exportNameExplicit > 1 ||
           !layout.FixedBytes32Equal(
               csg.nodes[index].factCid,
               ccsg.CompilerCsgHashNodeRecord(csg.nodes[index])):
            err = " compiler snapshot builder: compiler graph node invalid"
            return false
        if csg.nodes[index].nodeKind ==
               ccsg.CompilerCsgNodeKindPackage:
            packageNodeCount = packageNodeCount + 1
            if csg.nodes[index].ownerNodeId != 0:
                err = " compiler snapshot builder: package graph owner invalid"
                return false
        elif csg.nodes[index].ownerNodeId <= 0:
            err = " compiler snapshot builder: graph node owner missing"
            return false
    if packageNodeCount != 1:
        err = " compiler snapshot builder: package graph root count invalid"
        return false
    var identityErr: str
    if !csgnorm.CsgNormValidateSemanticIdentity(csg.nodes, identityErr):
        err = identityErr
        return false
    for index in 0..<csg.edges.len:
        if csg.edges[index].edgeId != index + 1 ||
           !compilerSnapshotBuilderGraphEdgeKindKnown(
               csg.edges[index].edgeKind) ||
           csg.edges[index].fromNodeId <= 0 ||
           csg.edges[index].fromNodeId > csg.nodes.len ||
           csg.edges[index].toNodeId <= 0 ||
           csg.edges[index].toNodeId > csg.nodes.len ||
           !layout.FixedBytes32Equal(
               csg.edges[index].edgeCid,
               ccsg.CompilerCsgHashEdge(
                   csg.edges[index].fromNodeId,
                   csg.edges[index].toNodeId,
                   csg.edges[index].edgeKind)):
            err = " compiler snapshot builder: compiler graph edge invalid"
            return false
    let expectedCanonical = csgnorm.CsgNormalizedGraphCid(
        csg.packageId, csg.nodes, csg.edges)
    if !layout.FixedBytes32Equal(
           csg.canonicalGraphCid, expectedCanonical):
        err = " compiler snapshot builder: canonical graph CID mismatch"
        return false
    if !compilerSnapshotBuilderReachableShape(csg, err) ||
       !compilerSnapshotBuilderTypedIrShape(csg, err) ||
       !compilerSnapshotBuilderResolvedCallShape(csg, err):
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderRetainedFactsCid(
        csg: ccsg.CompilerCsg): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(1024)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.graph.retained.facts")
    compilerSnapshotBuilderHashAppendText(buf, csg.packageId)
    compilerSnapshotBuilderHashAppendCid(buf, csg.sourceBundleCid)
    compilerSnapshotBuilderHashAppendCid(buf, csg.entrySourceCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.sourcePackageIdCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.entryModulePathCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.importGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, csg.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, csg.graphCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, csg.sourceIdentityReceipt.receiptCid)
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.typeArenaMissingResolutionAuthorityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.typeArena != nil ? 1 : 0)
    if csg.typeArena != nil:
        compilerSnapshotBuilderHashAppendCid(
            buf, csg.typeArena.artifactRaw32)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.typeArena.producerSourceCount)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.typeArena.typeCount)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.typeArena.symbolCount)
    compilerSnapshotBuilderHashAppendU32(buf, csg.nodes.len)
    for index in 0..<csg.nodes.len:
        compilerSnapshotBuilderHashAppendU32(buf, csg.nodes[index].nodeId)
        compilerSnapshotBuilderHashAppendCid(buf, csg.nodes[index].factCid)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.nodes[index].exportNameExplicit)
    compilerSnapshotBuilderHashAppendU32(buf, csg.edges.len)
    for index in 0..<csg.edges.len:
        compilerSnapshotBuilderHashAppendU32(buf, csg.edges[index].edgeId)
        compilerSnapshotBuilderHashAppendU32(buf, csg.edges[index].fromNodeId)
        compilerSnapshotBuilderHashAppendU32(buf, csg.edges[index].toNodeId)
        compilerSnapshotBuilderHashAppendU32(buf, csg.edges[index].edgeKind)
        compilerSnapshotBuilderHashAppendCid(buf, csg.edges[index].edgeCid)
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.semanticGraph.sourceTable.sourcePaths.len)
    for index in 0..<csg.semanticGraph.sourceTable.sourcePaths.len:
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.sourceTable.sourcePaths[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.sourceTable.modulePaths[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.sourceTable.textBytes[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.sourceTable.declStart[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.sourceTable.declCount[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.sourceTable.importEdgeStart[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.sourceTable.importEdgeCount[index])
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.semanticGraph.declTable.sourceIndex.len)
    for index in 0..<csg.semanticGraph.declTable.sourceIndex.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.declTable.sourceIndex[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.declTable.names[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.declTable.lineNumbers[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.declTable.importc[index] ? 1 : 0)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.declTable.exported[index] ? 1 : 0)
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.semanticGraph.importEdgeTable.ownerSourceIndex.len)
    for index in 0..<csg.semanticGraph.importEdgeTable.ownerSourceIndex.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.importEdgeTable.ownerSourceIndex[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.importEdgeTable.targetSourceIndex[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.importEdgeTable.ownerModulePaths[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.importEdgeTable.targetModulePaths[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.importEdgeTable.targetSourcePaths[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.importEdgeTable.resolved[index] ? 1 : 0)
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.semanticGraph.reachableFunctionTable.sourceIndex.len)
    for index in 0..<csg.semanticGraph.reachableFunctionTable.sourceIndex.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.reachableFunctionTable.sourceIndex[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.reachableFunctionTable.sourcePaths[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.reachableFunctionTable.functionNames[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.reachableFunctionTable.symbolTexts[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.reachableFunctionTable.startLines[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.reachableFunctionTable.endLines[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.reachableFunctionTable.reachable[index] ? 1 : 0)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.reachableFunctionTable.graphNodeIds[index])
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.semanticGraph.typedIrTable.functionSourceIndexes.len)
    for index in 0..<csg.semanticGraph.typedIrTable.functionSourceIndexes.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.typedIrTable.functionSourceIndexes[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.typedIrTable.functionGraphNodeIds[index])
        compilerSnapshotBuilderHashAppendText(
            buf, csg.semanticGraph.typedIrTable.functionNames[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.typedIrTable.functionNodeStart[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.typedIrTable.functionNodeCount[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.typedIrTable.functionStatementStart[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.typedIrTable.functionStatementCount[index])
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.semanticGraph.resolvedCallTable.functionRowHeads.len)
    for index in 0..<csg.semanticGraph.resolvedCallTable.functionRowHeads.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.functionRowHeads[index])
    compilerSnapshotBuilderHashAppendU32(
        buf, csg.semanticGraph.resolvedCallTable.sourceIndexes.len)
    compilerSnapshotBuilderHashAppendU32(
        buf,
        csg.semanticGraph.resolvedCallTable.graphNodeProjectionComplete ? 1 : 0)
    for index in 0..<csg.semanticGraph.resolvedCallTable.sourceIndexes.len:
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.sourceIndexes[index])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.resolvedCallTable.originParserNodeIds[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.functionIndexes[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.functionRowNext[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.lineNumbers[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.columnNumbers[index])
        compilerSnapshotBuilderHashAppendText(
            buf,
            Value(langintern.LookupIntern(
                csg.semanticGraph.resolvedCallTable.internPool,
                csg.semanticGraph.resolvedCallTable.sourcePathIds[index])))
        compilerSnapshotBuilderHashAppendText(
            buf,
            Value(langintern.LookupIntern(
                csg.semanticGraph.resolvedCallTable.internPool,
                csg.semanticGraph.resolvedCallTable.callQualifierIds[index])))
        compilerSnapshotBuilderHashAppendText(
            buf,
            Value(langintern.LookupIntern(
                csg.semanticGraph.resolvedCallTable.internPool,
                csg.semanticGraph.resolvedCallTable.callCalleeIds[index])))
        compilerSnapshotBuilderHashAppendText(
            buf,
            Value(langintern.LookupIntern(
                csg.semanticGraph.resolvedCallTable.internPool,
                csg.semanticGraph.resolvedCallTable.callTargetIds[index])))
        compilerSnapshotBuilderHashAppendText(
            buf,
            Value(langintern.LookupIntern(
                csg.semanticGraph.resolvedCallTable.internPool,
                csg.semanticGraph.resolvedCallTable.callTargetSourcePathIds[index])))
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.resolvedCallTable.callTargetSignatureLineNumbers[index])
        compilerSnapshotBuilderHashAppendU32(
            buf,
            csg.semanticGraph.resolvedCallTable.callTargetImportcFlags[index] ? 1 : 0)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.callArgCounts[index])
        compilerSnapshotBuilderHashAppendText(
            buf,
            Value(langintern.LookupIntern(
                csg.semanticGraph.resolvedCallTable.internPool,
                csg.semanticGraph.resolvedCallTable.callArgsTextIds[index])))
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.returnRootFlags[index] ? 1 : 0)
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.callerGraphNodeIds[index])
        compilerSnapshotBuilderHashAppendU32(
            buf, csg.semanticGraph.resolvedCallTable.targetGraphNodeIds[index])
    return compilerSnapshotBuilderHashFinish(buf)

fn compilerSnapshotBuilderValidatedGraphStateMakeInto(
        csg: var ccsg.CompilerCsg,
        out: var compilerSnapshotBuilderValidatedGraphState,
        err: var str): bool =
    let emptyState = compilerSnapshotBuilderValidatedGraphState()
    out = emptyState
    if !compilerSnapshotBuilderGraphStrictValidateInto(csg, err):
        return false
    out.validated = true
    out.sourceIdentityReceiptCid = csg.sourceIdentityReceipt.receiptCid
    out.parserReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    out.compilerCsgTransitionReceiptCid = csg.csgTransitionReceipt.receiptCid
    out.sourceBundleCid = csg.sourceBundleCid
    out.entrySourceCid = csg.entrySourceCid
    out.canonicalGraphCid = csg.canonicalGraphCid
    out.graphCid = csg.graphCid
    let retainedFactsCid = compilerSnapshotBuilderRetainedFactsCid(csg)
    out.retainedFactsCid = retainedFactsCid
    out.typeArenaPresent = csg.typeArena != nil
    out.typeArenaMissingResolutionAuthorityCount =
        csg.typeArenaMissingResolutionAuthorityCount
    if csg.typeArena != nil:
        out.typeArenaArtifactCid = csg.typeArena.artifactRaw32
        out.typeArenaProducerSourceCount = csg.typeArena.producerSourceCount
    out.sourceSnapshotCount = csg.sourceSnapshotCount
    out.nodeCount = csg.nodeCount
    out.edgeCount = csg.edgeCount
    out.reachableFunctionCount =
        csg.semanticGraph.reachableFunctionTable.sourceIndex.len
    out.typedFunctionCount =
        csg.semanticGraph.typedIrTable.functionSourceIndexes.len
    out.resolvedCallCount =
        csg.semanticGraph.resolvedCallTable.sourceIndexes.len
    err = ""
    return true

@borrows
fn compilerSnapshotBuilderValidatedGraphStateMatches(
        csg: ccsg.CompilerCsg,
        state: compilerSnapshotBuilderValidatedGraphState): bool =
    return state.validated &&
        layout.FixedBytes32Equal(
            state.sourceIdentityReceiptCid,
            csg.sourceIdentityReceipt.receiptCid) &&
        layout.FixedBytes32Equal(
            state.parserReceiptCid,
            csg.parserNormalizedExprReceipt.envelope.receiptRaw32) &&
        layout.FixedBytes32Equal(
            state.compilerCsgTransitionReceiptCid,
            csg.csgTransitionReceipt.receiptCid) &&
        layout.FixedBytes32Equal(state.sourceBundleCid, csg.sourceBundleCid) &&
        layout.FixedBytes32Equal(state.entrySourceCid, csg.entrySourceCid) &&
        layout.FixedBytes32Equal(
            state.canonicalGraphCid, csg.canonicalGraphCid) &&
        layout.FixedBytes32Equal(state.graphCid, csg.graphCid) &&
        state.typeArenaPresent == (csg.typeArena != nil) &&
        state.typeArenaMissingResolutionAuthorityCount ==
            csg.typeArenaMissingResolutionAuthorityCount &&
        (!state.typeArenaPresent ||
            (layout.FixedBytes32Equal(
                state.typeArenaArtifactCid,
                csg.typeArena.artifactRaw32) &&
             state.typeArenaProducerSourceCount ==
                csg.typeArena.producerSourceCount)) &&
        state.sourceSnapshotCount == csg.sourceSnapshotCount &&
        state.nodeCount == csg.nodeCount &&
        state.edgeCount == csg.edgeCount &&
        state.reachableFunctionCount ==
            csg.semanticGraph.reachableFunctionTable.sourceIndex.len &&
        state.typedFunctionCount ==
            csg.semanticGraph.typedIrTable.functionSourceIndexes.len &&
        state.resolvedCallCount ==
            csg.semanticGraph.resolvedCallTable.sourceIndexes.len

@borrows
fn compilerSnapshotProductionAdmissionReceiptCid(
        receipt: CompilerSnapshotProductionAdmissionReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    compilerSnapshotBuilderHashAppendText(
        buf, "cheng.compiler.snapshot.production_admission")
    compilerSnapshotBuilderHashAppendU32(buf, receipt.schemaVersion)
    compilerSnapshotBuilderHashAppendI64(buf, receipt.semanticEpoch)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.sourceIdentityReceiptCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.parserReceiptCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.compilerCsgTransitionReceiptCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.sourceBundleCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.importGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.canonicalGraphCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.graphCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.retainedFactsCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.typeArenaArtifactCid)
    compilerSnapshotBuilderHashAppendCid(buf, receipt.dependencyProofCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.sourceInterfaceProofCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.symbolInterfaceProofCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.functionInterfaceRequiredDomainCid)
    compilerSnapshotBuilderHashAppendCid(
        buf, receipt.functionInterfaceProofCid)
