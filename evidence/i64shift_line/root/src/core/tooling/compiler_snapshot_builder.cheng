        buf, receipt.missingFunctionSourceBindingCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingParserTypedExpressionIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeDeclarationIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeTypeIdCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeValueDefinitionCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeOwnershipProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeCaptureProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingTypedNodeSourceBindingCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingReferenceProofCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingReferenceParserNodeIdentityCount)
    compilerSnapshotBuilderHashAppendU32(
        buf, receipt.missingReferenceOwnerFunctionIdentityCount)
