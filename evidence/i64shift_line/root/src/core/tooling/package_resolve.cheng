import std/os
import std/strings
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/world_resolver as wresolver
import cheng/core/tooling/world_facts as wfacts
import cheng/core/tooling/cheng_lock as clock
import cheng/core/tooling/registry as reg

type
    // Parsed dependency from cheng-package.toml
    PackageDependency =
        packageId: str
        channel: str
        version: str
        source: str

    // Parsed cheng-package.toml
    PackageManifest =
        packageId: str
        modulePrefix: str
        channel: str
        version: str
        dependencyCount: int32
        dependencies: PackageDependency[]

@borrows
fn PackageDependencyMake(packageId: str,
                          channel: str,
                          version: str,
                          source: str): PackageDependency =
    var out: PackageDependency
    out.packageId = strings.CloneStr(packageId)
    out.channel = strings.CloneStr(channel)
    out.version = strings.CloneStr(version)
    out.source = strings.CloneStr(source)
    return out

fn PackageManifestMake(packageId: str,
                        modulePrefix: str,
                        channel: str,
                        version: str,
                        dependencies: PackageDependency[]): PackageManifest =
    var out: PackageManifest
    out.packageId = packageId
    out.modulePrefix = modulePrefix
    out.channel = channel
    out.version = version
    out.dependencyCount = dependencies.len
    out.dependencies = dependencies
    return out

@borrows
fn PackageManifestTomlLineValue(text: str, key: str): str =
    let lines = strutil.Split(text, '\n')
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        var matchedLine = false
        if line.len > key.len:
            if line[key.len] == '=':
                matchedLine = true
                for j in 0..<key.len:
                    if line[j] != key[j]:
                        matchedLine = false
                        break
        if matchedLine:
            let rawValue = strutil.Strip(chengpath.TextSlice(line, key.len + 1, line.len - (key.len + 1)))
            let valLen = rawValue.len
            if valLen >= 2:
                if rawValue[0] == '\"' && rawValue[valLen - 1] == '\"':
                    return chengpath.TextSlice(rawValue, 1, valLen - 2)
            return rawValue
    return ""

@borrows
fn PackageManifestRead(rootDir: str): PackageManifest =
    let manifestPath = os.JoinPath(rootDir, "cheng-package.toml")
    if !chengpath.PathFileExists(manifestPath):
        return PackageManifestMake("", "", "", "", [])
    let text = chengpath.ReadTextFile("", manifestPath)
    let pkgId = PackageManifestTomlLineValue(text, "package_id")
    let prefix = PackageManifestTomlLineValue(text, "module_prefix")
    let channel = PackageManifestTomlLineValue(text, "channel")
    let version = PackageManifestTomlLineValue(text, "version")
    var deps: PackageDependency[]
    // Parse [[dependencies]] sections
    let lines = strutil.Split(text, '\n')
    var i: int32
    while i < lines.len:
        let line = strutil.Strip(lines[i])
        if line == "[[dependencies]]":
            i = i + 1
            var depId = ""
            var depChannel = ""
            var depVersion = ""
            while i < lines.len:
                let innerLine = strutil.Strip(lines[i])
                if innerLine.len <= 0 || innerLine[0] == '[':
                    break
                for j in 0..<innerLine.len:
                    if innerLine[j] == '=':
                        let key = strutil.Strip(chengpath.TextSlice(innerLine, 0, j))
                        let rawValue = strutil.Strip(chengpath.TextSlice(innerLine, j + 1, innerLine.len - (j + 1)))
                        let valLen = rawValue.len
                        var value: str
                        if valLen >= 2 && rawValue[0] == '\"' && rawValue[valLen - 1] == '\"':
                            value = chengpath.TextSlice(rawValue, 1, valLen - 2)
                        else:
                            value = rawValue
                        if key == "package_id":
                            depId = value
                        elif key == "channel":
                            depChannel = value
                        elif key == "version":
                            depVersion = value
                        break
                i = i + 1
            if depId.len > 0:
                add(deps, PackageDependencyMake(depId, depChannel, depVersion, "registry"))
        else:
            i = i + 1
    return PackageManifestMake(pkgId, prefix, channel, version, deps)

@borrows
fn PackageResolveLocalPath(rootDir: str,
                            dep: PackageDependency): Result[wresolver.WorldReceipt] =
    // Resolve a local path dependency: the packageId is used as a relative path
    let depDir = os.JoinPath(rootDir, dep.packageId)
    if !chengpath.PathDirExists(depDir):
        return Err[wresolver.WorldReceipt](strutil.Join([" package resolve: local dep not found: ", depDir], ""))
    return wresolver.WorldResolve(depDir)

fn PackageResolve(rootDir: str): Result[clock.ChengLock] =
    let manifest = PackageManifestRead(rootDir)
    if manifest.packageId.len <= 0:
        return Err[clock.ChengLock](" package resolve: no cheng-package.toml found")
    // First, resolve the root package itself
    let rootReceiptRes = wresolver.WorldResolve(rootDir)
    if IsErr(rootReceiptRes):
        return Err[clock.ChengLock](strutil.Join([" package resolve: root resolve failed: ", strings.CloneStr(Error(rootReceiptRes))], ""))
    let rootReceipt = Value(rootReceiptRes)
    // Build lock
    var lock: clock.ChengLock
    lock.formatVersion = clock.ChengLockFormatVersionLatest
    lock.worldHeadCid = layout.FixedBytes32Hex(rootReceipt.worldHeadCid)
    lock.channel = manifest.channel
    lock.epoch = 0
    lock.compilerPackageId = "cheng/compiler"
    lock.compilerCid = layout.FixedBytes32Hex(rootReceipt.snapshotCid)
    lock.stdlibPackageId = "cheng/stdlib"
    lock.stdlibCid = layout.FixedBytes32Hex(rootReceipt.snapshotCid)
    lock.runtimePackageId = "cheng/runtime"
    lock.runtimeCid = layout.FixedBytes32Hex(rootReceipt.snapshotCid)
    var packages: clock.ChengLockPackage[]
    // Add root package entry
    add(packages, clock.ChengLockPackageMake(
        manifest.packageId,
        manifest.modulePrefix,
        manifest.channel,
        manifest.version,
        layout.FixedBytes32Hex(rootReceipt.snapshotCid),
        "",
        "local",
        "cheng"))
    // Resolve each dependency
    var depRegistry = "file:///tmp/cheng-registry"
    for i in 0..<manifest.dependencies.len:
        let dep = manifest.dependencies[i]
        var depReceiptRes: Result[wresolver.WorldReceipt]
        if dep.source == "registry":
            // Try registry fetch
            let depVersion = dep.version.len > 0 ? dep.version : "1.0.0"
            depReceiptRes = reg.RegistryFetch(strings.CloneStr(dep.packageId), depVersion, depRegistry)
            if IsErr(depReceiptRes):
                // Fall back to local path resolution
                depReceiptRes = PackageResolveLocalPath(rootDir, dep)
        else:
            depReceiptRes = PackageResolveLocalPath(rootDir, dep)
        if IsErr(depReceiptRes):
            return Err[clock.ChengLock](strutil.Join([" package resolve: dep failed: ", strings.CloneStr(dep.packageId), ": ", strings.CloneStr(Error(depReceiptRes))], ""))
        let depReceipt = Value(depReceiptRes)
        if depReceipt.entryCount > 0:
            let depEntry = depReceipt.entries[0]
            add(packages, clock.ChengLockPackageMake(
                depEntry.packageId,
                depEntry.modulePrefix,
                depEntry.channel,
                depEntry.version,
                layout.FixedBytes32Hex(depEntry.cid),
                depEntry.checksum,
                dep.source,
                "cheng"))
    lock.packages = packages
    lock.packageCount = packages.len
    return Ok[clock.ChengLock](lock)

fn PackageResolveOffline(lock: clock.ChengLock): Result[wfacts.WorldFacts] =
    // Resolve from lock file only - no registry or filesystem access beyond the lock data
    if lock.packageCount <= 0 && lock.compilerCid.len <= 0:
        return Err[wfacts.WorldFacts](" package resolve offline: empty or invalid lock")
    return wfacts.WorldFactsFromLock(lock)

fn PackageResolveOfflineFromFile(rootDir: str): Result[wfacts.WorldFacts] =
    let lockRes = clock.ChengLockRead(rootDir)
    if IsErr(lockRes):
        return Err[wfacts.WorldFacts](strutil.Join([" package resolve offline: ", Error(lockRes)], ""))
    return PackageResolveOffline(Value(lockRes))

fn PackageResolveWrite(rootDir: str, lock: clock.ChengLock): bool =
    return clock.ChengLockWrite(rootDir, lock)

fn PackageResolveReadLock(rootDir: str): Result[clock.ChengLock] =
    return clock.ChengLockRead(rootDir)

fn PackageInstall(lock: clock.ChengLock, registryEndpoint: str, targetDir: str): Result[int32] =
    let stagingDir = strutil.Join([strings.CloneStr(targetDir), ".__installing__"], "")
    if !chengpath.PathCreateDirAll(stagingDir):
        return Err[int32](" package install: failed to create staging dir")
    var count: int32
    for i in 0..<lock.packages.len:
        let pkg = lock.packages[i]
        if pkg.source == "local":
            count = count + 1
            continue
        if pkg.source != "registry":
            return Err[int32](strutil.Join([" package install: unknown source: ", strings.CloneStr(pkg.source)], ""))
        let pkgDir = os.JoinPath(os.JoinPath(os.JoinPath(stagingDir, "pkg"), pkg.packageId), pkg.version)
        if !chengpath.PathCreateDirAll(pkgDir):
            return Err[int32](strutil.Join([" package install: failed to create pkg dir for ", strings.CloneStr(pkg.packageId)], ""))
        let srcDir = os.JoinPath(os.JoinPath(os.JoinPath(registryEndpoint, pkg.packageId), pkg.version), "src")
        var snapshotEntries: wresolver.WorldSnapshotEntry[]
        if chengpath.PathDirExists(srcDir):
            let rawFiles = os.ListDir(srcDir)
            for j in 0..<rawFiles.len:
                let fileName = rawFiles[j]
                let fullPath = os.JoinPath(srcDir, fileName)
                if !chengpath.PathFileExists(fullPath):
                    continue
                let fileText = chengpath.ReadTextFile("", fullPath)
                let contentCid = wresolver.WorldResolveContentCid(fileText)
                let contentHash = wresolver.WorldResolveContentHash(fileText)
                let relFile = os.JoinPath("src", fileName)
                add(snapshotEntries, wresolver.WorldSnapshotEntryMake(relFile, contentCid, contentHash))
                if !chengpath.WriteTextFile("", os.JoinPath(pkgDir, relFile), fileText):
                    return Err[int32](strutil.Join([" package install: failed to write ", strings.CloneStr(fileName)], ""))
        let actualCid = wresolver.WorldResolveSnapshotCid(snapshotEntries)
        let expectedCidRes = layout.FixedBytes32FromHex(pkg.cid)
        if IsErr(expectedCidRes):
            return Err[int32](strutil.Join([" package install: invalid CID for ", strings.CloneStr(pkg.packageId)], ""))
        if !layout.FixedBytes32Equal(actualCid, Value(expectedCidRes)):
            return Err[int32](strutil.Join([" package install: CID mismatch for ", strings.CloneStr(pkg.packageId)], ""))
        count = count + 1
    let lockText = clock.ChengLockSerialize(lock)
    if !chengpath.WriteTextFile("", os.JoinPath(stagingDir, "cheng.lock.toml"), lockText):
        return Err[int32](" package install: failed to write lock file")
    if !os.RenameFile(stagingDir, targetDir):
        return Err[int32](" package install: atomic rename failed")
    return Ok[int32](count)

// ============================================================
// Version operations — parse, compare, format semver strings
// ============================================================

type
    VersionParts =
        major: int32
        minor: int32
        patch: int32

    VersionConstraint =
        constraintType: int32   // 0=exact, 1=caret(^), 2=range(>=,<)
        exactVersion: str
        minVersion: str
        maxVersion: str

@borrows
fn VersionParse(ver: str): VersionParts =
    var out: VersionParts
    out.major = 0
    out.minor = 0
    out.patch = 0
    if ver.len <= 0:
        return out
    let parts = strutil.Split(ver, '.')
    if parts.len > 0:
        out.major = strutil.ParseInt(parts[0])
    if parts.len > 1:
        out.minor = strutil.ParseInt(parts[1])
    if parts.len > 2:
        out.patch = strutil.ParseInt(parts[2])
    return out

fn VersionToString(v: VersionParts): str =
    return strutil.Join([IntToStr(v.major), ".", IntToStr(v.minor), ".", IntToStr(v.patch)], "")

fn VersionCompare(a: VersionParts, b: VersionParts): int32 =
    if a.major < b.major: return -1
    if a.major > b.major: return 1
    if a.minor < b.minor: return -1
    if a.minor > b.minor: return 1
    if a.patch < b.patch: return -1
    if a.patch > b.patch: return 1
    return 0

fn VersionLess(a: VersionParts, b: VersionParts): bool =
    return VersionCompare(a, b) < 0

fn VersionEqual(a: VersionParts, b: VersionParts): bool =
    return VersionCompare(a, b) == 0

// ============================================================
// Dependency graph — adjacency list via edges array
// ============================================================

type
    DepEdge =
        from: str
        to: str
        constraint: str

    DependencyGraph =
        nodeCount: int32
        nodeIds: str[]
        nodeVersions: str[]
        edgeCount: int32
        edges: DepEdge[]

@borrows
fn DepEdgeMake(from: str, to: str, constraint: str): DepEdge =
    var out: DepEdge
    out.from = strings.CloneStr(from)
    out.to = strings.CloneStr(to)
    out.constraint = strings.CloneStr(constraint)
    return out

fn DependencyGraphMake(nodeIds: str[], nodeVersions: str[], edges: DepEdge[]): DependencyGraph =
    var out: DependencyGraph
    out.nodeCount = nodeIds.len
    out.nodeIds = nodeIds
    out.nodeVersions = nodeVersions
    out.edgeCount = edges.len
    out.edges = edges
    return out

@borrows
fn FindNodeIdx(graph: DependencyGraph, packageId: str): int32 =
    for i in 0..<graph.nodeCount:
        if graph.nodeIds[i] == packageId:
            return i
    return -1

@borrows
fn GetOutEdges(graph: DependencyGraph, nodeIdx: int32): DepEdge[] =
    var out: DepEdge[]
    if nodeIdx < 0 || nodeIdx >= graph.nodeCount:
        return out
    let nodeId = graph.nodeIds[nodeIdx]
    for i in 0..<graph.edges.len:
        if graph.edges[i].from == nodeId:
            add(out, DepEdgeMake(graph.edges[i].from, graph.edges[i].to, graph.edges[i].constraint))
    return out

fn BuildDependencyGraph(manifest: PackageManifest): DependencyGraph =
    var nodeIds: str[]
    var nodeVersions: str[]
    var edges: DepEdge[]
    add(nodeIds, strings.CloneStr(manifest.packageId))
    add(nodeVersions, strings.CloneStr(manifest.version))
    for i in 0..<manifest.dependencies.len:
        let dep = manifest.dependencies[i]
        add(nodeIds, strings.CloneStr(dep.packageId))
        add(nodeVersions, strings.CloneStr(dep.version))
        add(edges, DepEdgeMake(manifest.packageId, dep.packageId, dep.version))
    return DependencyGraphMake(nodeIds, nodeVersions, edges)

@borrows
fn ArrContainsStr(arr: str[], val: str): bool =
    for i in 0..<arr.len:
        if arr[i] == val:
            return true
    return false

@borrows
fn dfsCycleDetect(graph: DependencyGraph,
                  startId: str,
                  currentId: str,
                  path: str[]): str[] =
    let nodeIdx = FindNodeIdx(graph, currentId)
    if nodeIdx < 0:
        return []
    let outEdges = GetOutEdges(graph, nodeIdx)
    for i in 0..<outEdges.len:
        let target = outEdges[i].to
        if target == startId:
            var cycle: str[]
            for j in 0..<path.len:
                add(cycle, strings.CloneStr(path[j]))
            add(cycle, strings.CloneStr(target))
            return cycle
        if !ArrContainsStr(path, target):
            var newPath: str[]
            for j in 0..<path.len:
                add(newPath, strings.CloneStr(path[j]))
            add(newPath, strings.CloneStr(target))
            let res = dfsCycleDetect(graph, startId, target, newPath)
            if res.len > 0:
                return res
    return []

@borrows
fn DetectCycles(graph: DependencyGraph): str[] =
    for start in 0..<graph.nodeCount:
        let startId = graph.nodeIds[start]
        var path: str[]
        add(path, strings.CloneStr(startId))
        let cycle = dfsCycleDetect(graph, startId, startId, path)
        if cycle.len > 0:
            return cycle
    return []

@borrows
fn topoSortDfsVisit(graph: DependencyGraph,
                    nodeId: str,
                    visited: var str[],
                    ordering: var str[]) =
    add(visited, strings.CloneStr(nodeId))
    let nodeIdx = FindNodeIdx(graph, nodeId)
    if nodeIdx >= 0:
        let outEdges = GetOutEdges(graph, nodeIdx)
        for i in 0..<outEdges.len:
            let target = outEdges[i].to
            if !ArrContainsStr(visited, target):
                topoSortDfsVisit(graph, target, visited, ordering)
    add(ordering, strings.CloneStr(nodeId))

@borrows
fn TopologicalSort(graph: DependencyGraph): str[] =
    var visited: str[]
    var ordering: str[]
    for i in 0..<graph.nodeCount:
        if !ArrContainsStr(visited, graph.nodeIds[i]):
            topoSortDfsVisit(graph, graph.nodeIds[i], visited, ordering)
    var result: str[]
    var idx: int32 = ordering.len - 1
    while idx >= 0:
        add(result, strings.CloneStr(ordering[idx]))
        idx = idx - 1
    return result

// ============================================================
// Version constraint parsing and resolution
// ============================================================

@borrows
fn VersionConstraintMakeExact(exact: str): VersionConstraint =
    var out: VersionConstraint
    out.constraintType = 0
    out.exactVersion = strings.CloneStr(exact)
    out.minVersion = strings.CloneStr(exact)
    out.maxVersion = strings.CloneStr(exact)
    return out

@borrows
fn VersionConstraintMakeCaret(minVer: str): VersionConstraint =
    var out: VersionConstraint
    out.constraintType = 1
    out.minVersion = strings.CloneStr(minVer)
    var vp = VersionParse(minVer)
    vp.major = vp.major + 1
    vp.minor = 0
    vp.patch = 0
    out.maxVersion = VersionToString(vp)
    return out

@borrows
fn VersionConstraintMakeRange(minVer: str, maxVer: str): VersionConstraint =
    var out: VersionConstraint
    out.constraintType = 2
    out.minVersion = strings.CloneStr(minVer)
    out.maxVersion = strings.CloneStr(maxVer)
    return out

fn ParseVersionConstraint(spec: str): VersionConstraint =
    let trimmed = strutil.Strip(spec)
    if trimmed.len <= 0:
        return VersionConstraintMakeExact("")
    if strutil.StartsWith(trimmed, "^"):
        let verPart = strutil.Strip(chengpath.TextSlice(trimmed, 1, trimmed.len - 1))
        return VersionConstraintMakeCaret(verPart)
    if strutil.StartsWith(trimmed, ">="):
        let parts = strutil.Split(trimmed, ',')
        if parts.len >= 2:
            let first = strutil.Strip(parts[0])
            let second = strutil.Strip(parts[1])
            var minVer = ""
            var maxVer = ""
            if strutil.StartsWith(first, ">="):
                minVer = strutil.Strip(chengpath.TextSlice(first, 2, first.len - 2))
            if strutil.StartsWith(second, "<"):
                maxVer = strutil.Strip(chengpath.TextSlice(second, 1, second.len - 1))
            if minVer.len > 0 && maxVer.len > 0:
                return VersionConstraintMakeRange(minVer, maxVer)
        let after = strutil.Strip(chengpath.TextSlice(trimmed, 2, trimmed.len - 2))
        return VersionConstraintMakeExact(after)
    if strutil.StartsWith(trimmed, "="):
        let exact = strutil.Strip(chengpath.TextSlice(trimmed, 1, trimmed.len - 1))
        return VersionConstraintMakeExact(exact)
    return VersionConstraintMakeExact(trimmed)

@borrows
fn VersionSatisfies(vp: VersionParts, constraint: VersionConstraint): bool =
    if constraint.constraintType == 0:
        let exactParts = VersionParse(constraint.exactVersion)
        return VersionEqual(vp, exactParts)
    let minParts = VersionParse(constraint.minVersion)
    if VersionLess(vp, minParts):
        return false
    if constraint.maxVersion.len > 0 && constraint.constraintType != 0:
        let maxParts = VersionParse(constraint.maxVersion)
        if !VersionLess(vp, maxParts):
            return false
    return true

fn ResolveBestVersion(constraint: VersionConstraint, available: str[]): str =
    var bestVersion = ""
    var bestMajor: int32 = -1
    var bestMinor: int32 = -1
    var bestPatch: int32 = -1
    for i in 0..<available.len:
        let ver = available[i]
        let vp = VersionParse(ver)
        if VersionSatisfies(vp, constraint):
            if bestMajor < 0 ||
               vp.major > bestMajor ||
               (vp.major == bestMajor && vp.minor > bestMinor) ||
               (vp.major == bestMajor && vp.minor == bestMinor && vp.patch > bestPatch):
                bestVersion = ver
                bestMajor = vp.major
                bestMinor = vp.minor
                bestPatch = vp.patch
    return bestVersion

fn ResolveAll(rootDir: str): Result[DependencyGraph] =
    let manifest = PackageManifestRead(rootDir)
    if manifest.packageId.len <= 0:
        return Err[DependencyGraph](" resolve all: no cheng-package.toml found")
    let graph = BuildDependencyGraph(manifest)
    let cycle = DetectCycles(graph)
    if cycle.len > 0:
        var cycleStr = "cycle detected:"
        for i in 0..<cycle.len:
            cycleStr = strutil.Join([cycleStr, " ", strings.CloneStr(cycle[i])], "")
        return Err[DependencyGraph](strings.CloneStr(cycleStr))
    let buildOrder = TopologicalSort(graph)
    if buildOrder.len != graph.nodeCount:
        return Err[DependencyGraph](" resolve all: inconsistent dependency graph")
    return Ok[DependencyGraph](graph)
