import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/world_resolver as wresolver

const ChengLockFormatVersionLatest: int32 = 1

type
    // TOML-compatible lock file representation
    ChengLockPackage =
        packageId: str
        modulePrefix: str
        channel: str
        version: str
        cid: str
        checksum: str
        source: str
        format: str

    ChengLock =
        formatVersion: int32
        worldHeadCid: str
        channel: str
        epoch: int32
        compilerPackageId: str
        compilerCid: str
        stdlibPackageId: str
        stdlibCid: str
        runtimePackageId: str
        runtimeCid: str
        packageCount: int32
        packages: ChengLockPackage[]

    ChengLockDependency =
        packageId: str
        channel: str
        version: str

@borrows
fn ChengLockPackageMake(packageId: str,
                         modulePrefix: str,
                         channel: str,
                         version: str,
                         cid: str,
                         checksum: str,
                         source: str,
                         format: str): ChengLockPackage =
    var out: ChengLockPackage
    out.packageId = strings.CloneStr(packageId)
    out.modulePrefix = strings.CloneStr(modulePrefix)
    out.channel = strings.CloneStr(channel)
    out.version = strings.CloneStr(version)
    out.cid = strings.CloneStr(cid)
    out.checksum = strings.CloneStr(checksum)
    out.source = strings.CloneStr(source)
    out.format = strings.CloneStr(format)
    return out

@borrows
fn ChengLockMake(worldHeadCid: str,
                  channel: str,
                  epoch: int32,
                  compilerPackageId: str,
                  compilerCid: str,
                  stdlibPackageId: str,
                  stdlibCid: str,
                  runtimePackageId: str,
                  runtimeCid: str,
                  packages: ChengLockPackage[]): ChengLock =
    var out: ChengLock
    out.formatVersion = ChengLockFormatVersionLatest
    out.worldHeadCid = strings.CloneStr(worldHeadCid)
    out.channel = strings.CloneStr(channel)
    out.epoch = epoch
    out.compilerPackageId = strings.CloneStr(compilerPackageId)
    out.compilerCid = strings.CloneStr(compilerCid)
    out.stdlibPackageId = strings.CloneStr(stdlibPackageId)
    out.stdlibCid = strings.CloneStr(stdlibCid)
    out.runtimePackageId = strings.CloneStr(runtimePackageId)
    out.runtimeCid = strings.CloneStr(runtimeCid)
    out.packageCount = packages.len
    out.packages = packages
    return out

fn ChengLockSerialize(lock: ChengLock): str =
    if lock.formatVersion != ChengLockFormatVersionLatest:
        panic(" cheng lock: cannot serialize non-current format_version")
    var out = ""
    out = strutil.Join([out, "format_version = ", IntToStr(lock.formatVersion), "\n"], "")
    out = strutil.Join([out, "world_head_cid = \"", strings.CloneStr(lock.worldHeadCid), "\"\n"], "")
    out = strutil.Join([out, "channel = \"", strings.CloneStr(lock.channel), "\"\n"], "")
    out = strutil.Join([out, "epoch = ", IntToStr(lock.epoch), "\n"], "")
    out = strutil.Join([out, "\n"], "")
    out = strutil.Join([out, "[compiler]\n"], "")
    out = strutil.Join([out, "  package_id = \"", strings.CloneStr(lock.compilerPackageId), "\"\n"], "")
    out = strutil.Join([out, "  cid = \"", strings.CloneStr(lock.compilerCid), "\"\n"], "")
    out = strutil.Join([out, "\n"], "")
    out = strutil.Join([out, "[stdlib]\n"], "")
    out = strutil.Join([out, "  package_id = \"", strings.CloneStr(lock.stdlibPackageId), "\"\n"], "")
    out = strutil.Join([out, "  cid = \"", strings.CloneStr(lock.stdlibCid), "\"\n"], "")
    out = strutil.Join([out, "\n"], "")
    out = strutil.Join([out, "[runtime]\n"], "")
    out = strutil.Join([out, "  package_id = \"", strings.CloneStr(lock.runtimePackageId), "\"\n"], "")
    out = strutil.Join([out, "  cid = \"", strings.CloneStr(lock.runtimeCid), "\"\n"], "")
    out = strutil.Join([out, "\n"], "")
    for i in 0..<lock.packages.len:
        let pkg = lock.packages[i]
        out = strutil.Join([out, "[[packages]]\n"], "")
        out = strutil.Join([out, "  package_id = \"", strings.CloneStr(pkg.packageId), "\"\n"], "")
        out = strutil.Join([out, "  module_prefix = \"", strings.CloneStr(pkg.modulePrefix), "\"\n"], "")
        out = strutil.Join([out, "  channel = \"", strings.CloneStr(pkg.channel), "\"\n"], "")
        out = strutil.Join([out, "  version = \"", strings.CloneStr(pkg.version), "\"\n"], "")
        out = strutil.Join([out, "  cid = \"", strings.CloneStr(pkg.cid), "\"\n"], "")
        out = strutil.Join([out, "  source = \"", strings.CloneStr(pkg.source), "\"\n"], "")
        out = strutil.Join([out, "  format = \"", strings.CloneStr(pkg.format), "\"\n"], "")
        if pkg.checksum.len > 0:
            out = strutil.Join([out, "  checksum = \"", strings.CloneStr(pkg.checksum), "\"\n"], "")
    return out

fn ChengLockLineValue(text: str, key: str): str =
    let lines = strutil.Split(text, '\n')
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        var matchedLine = false
        if line.len > key.len:
            if line[key.len] == '=':
                matchedLine = true
                for j in 0..<key.len:
                    if line[j] != key[j]:
                        matchedLine = false
                        break
        if matchedLine:
            let rawValue = strutil.Strip(chengpath.TextSlice(line, key.len + 1, line.len - (key.len + 1)))
            let valLen = rawValue.len
            if valLen >= 2:
                if rawValue[0] == '\"' && rawValue[valLen - 1] == '\"':
                    return chengpath.TextSlice(rawValue, 1, valLen - 2)
            return rawValue
    return ""

fn ChengLockDeserialize(text: str): Result[ChengLock] =
    let versionText = ChengLockLineValue(text, "format_version")
    if versionText.len <= 0:
        return Err[ChengLock](" cheng lock: missing format_version")
    let formatVersion = parseInt(versionText)
    if formatVersion != ChengLockFormatVersionLatest:
        return Err[ChengLock](" cheng lock: unsupported format_version")
    let worldHeadCid = ChengLockLineValue(text, "world_head_cid")
    let channel = ChengLockLineValue(text, "channel")
    let epochText = ChengLockLineValue(text, "epoch")
    var epoch = 0
    if epochText.len > 0:
        epoch = parseInt(epochText)
    let compilerPackageId = ChengLockLineValue(text, "compiler.package_id")
    let compilerCid = ChengLockLineValue(text, "compiler.cid")
    let stdlibPackageId = ChengLockLineValue(text, "stdlib.package_id")
    let stdlibCid = ChengLockLineValue(text, "stdlib.cid")
    let runtimePackageId = ChengLockLineValue(text, "runtime.package_id")
    let runtimeCid = ChengLockLineValue(text, "runtime.cid")

    // Count package sections by scanning for [[packages]] headers
    var packages: ChengLockPackage[]
    let lines = strutil.Split(text, '\n')
    var i = 0
    while i < lines.len:
        let line = strutil.Strip(lines[i])
        if line == "[[packages]]":
            i = i + 1
            var pkgId = ""
            var pkgPrefix = ""
            var pkgChannel = ""
            var pkgVersion = ""
            var pkgCid = ""
            var pkgChecksum = ""
            var pkgSource = ""
            var pkgFormat = ""
            while i < lines.len:
                let innerLine = strutil.Strip(lines[i])
                if innerLine.len <= 0 || innerLine[0] == '[':
                    break
                let eqPos = -1
                for j in 0..<innerLine.len:
                    if innerLine[j] == '=':
                        let key = strutil.Strip(chengpath.TextSlice(innerLine, 0, j))
                        let rawValue = strutil.Strip(chengpath.TextSlice(innerLine, j + 1, innerLine.len - (j + 1)))
                        let valLen = rawValue.len
                        var value = rawValue
                        if valLen >= 2 && rawValue[0] == '\"' && rawValue[valLen - 1] == '\"':
                            value = chengpath.TextSlice(rawValue, 1, valLen - 2)
                        if key == "package_id":
                            pkgId = value
                        elif key == "module_prefix":
                            pkgPrefix = value
                        elif key == "channel":
                            pkgChannel = value
                        elif key == "version":
                            pkgVersion = value
                        elif key == "cid":
                            pkgCid = value
                        elif key == "checksum":
                            pkgChecksum = value
                        elif key == "source":
                            pkgSource = value
                        elif key == "format":
                            pkgFormat = value
                        break
                i = i + 1
            if pkgId.len > 0:
                add(packages, ChengLockPackageMake(pkgId,
                                                    pkgPrefix,
                                                    pkgChannel,
                                                    pkgVersion,
                                                    pkgCid,
                                                    pkgChecksum,
                                                    pkgSource,
                                                    pkgFormat))
        else:
            i = i + 1
    var out: ChengLock
    out.formatVersion = formatVersion
    out.worldHeadCid = worldHeadCid
    out.channel = channel
    out.epoch = epoch
    out.compilerPackageId = compilerPackageId
    out.compilerCid = compilerCid
    out.stdlibPackageId = stdlibPackageId
    out.stdlibCid = stdlibCid
    out.runtimePackageId = runtimePackageId
    out.runtimeCid = runtimeCid
    out.packageCount = packages.len
    out.packages = packages
    return Ok[ChengLock](out)

fn ChengLockWrite(rootDir: str, lock: ChengLock): bool =
    let text = ChengLockSerialize(lock)
    let lockPath = os.JoinPath(rootDir, "cheng.lock.toml")
    return chengpath.WriteTextFile("", lockPath, text)

fn ChengLockRead(rootDir: str): Result[ChengLock] =
    let lockPath = os.JoinPath(rootDir, "cheng.lock.toml")
    if !chengpath.PathFileExists(lockPath):
        return Err[ChengLock](strutil.Join([" cheng lock: missing lock file: ", lockPath], ""))
    let text = chengpath.ReadTextFile("", lockPath)
    return ChengLockDeserialize(text)

fn ChengLockFindPackage(lock: ChengLock, packageId: str): Result[ChengLockPackage] =
    for i in 0..<lock.packages.len:
        if lock.packages[i].packageId == packageId:
            return Ok[ChengLockPackage](lock.packages[i])
    return Err[ChengLockPackage](strutil.Join([" cheng lock: package not found: ", packageId], ""))

fn ChengLockPinVersion(lock: var ChengLock, packageId: str, version: str): bool =
    for i in 0..<lock.packages.len:
        if lock.packages[i].packageId == packageId:
            lock.packages[i].version = version
            return true
    return false

fn ChengLockHasPackage(lock: ChengLock, packageId: str): bool =
    for i in 0..<lock.packages.len:
        if lock.packages[i].packageId == packageId:
            return true
    return false

fn ChengLockReport(lock: ChengLock): str =
    var out = ""
    out = strutil.Join([out, "format_version=", IntToStr(lock.formatVersion), "\n"], "")
    out = strutil.Join([out, "world_head_cid=", strings.CloneStr(lock.worldHeadCid), "\n"], "")
    out = strutil.Join([out, "channel=", strings.CloneStr(lock.channel), "\n"], "")
    out = strutil.Join([out, "epoch=", IntToStr(lock.epoch), "\n"], "")
    out = strutil.Join([out, "compiler=", strings.CloneStr(lock.compilerCid), "\n"], "")
    out = strutil.Join([out, "stdlib=", strings.CloneStr(lock.stdlibCid), "\n"], "")
    out = strutil.Join([out, "runtime=", strings.CloneStr(lock.runtimeCid), "\n"], "")
    out = strutil.Join([out, "package_count=", IntToStr(lock.packageCount), "\n"], "")
    for i in 0..<lock.packages.len:
        out = strutil.Join([out, "package[", IntToStr(i), "].id=", strings.CloneStr(lock.packages[i].packageId), "\n"], "")
        out = strutil.Join([out, "package[", IntToStr(i), "].version=", strings.CloneStr(lock.packages[i].version), "\n"], "")
    return out

fn IsValidVersionString(ver: str): bool =
    if ver.len <= 0:
        return false
    var dotCount: int32
    for i in 0..<ver.len:
        let ch = ver[i]
        if ch == '.':
            dotCount = dotCount + 1
        elif ch < '0' || ch > '9':
            return false
    return dotCount > 0

fn ChengLockVerify(lock: ChengLock): Result[int32] =
    if lock.formatVersion != ChengLockFormatVersionLatest:
        return Err[int32](" cheng lock verify: unsupported format_version")
    if lock.worldHeadCid.len > 0:
        if IsErr(layout.FixedBytes32FromHex(lock.worldHeadCid)):
            return Err[int32](" cheng lock verify: invalid world_head_cid")
    if lock.compilerCid.len > 0:
        if IsErr(layout.FixedBytes32FromHex(lock.compilerCid)):
            return Err[int32](" cheng lock verify: invalid compiler_cid")
    if lock.stdlibCid.len > 0:
        if IsErr(layout.FixedBytes32FromHex(lock.stdlibCid)):
            return Err[int32](" cheng lock verify: invalid stdlib_cid")
    if lock.runtimeCid.len > 0:
        if IsErr(layout.FixedBytes32FromHex(lock.runtimeCid)):
            return Err[int32](" cheng lock verify: invalid runtime_cid")
    for i in 0..<lock.packages.len:
        let pkg = lock.packages[i]
        if pkg.packageId.len <= 0:
            return Err[int32](" cheng lock verify: package with empty packageId")
        if IsErr(layout.FixedBytes32FromHex(pkg.cid)):
            return Err[int32](strutil.Join([" cheng lock verify: invalid CID for ", strings.CloneStr(pkg.packageId)], ""))
        if !IsValidVersionString(pkg.version):
            return Err[int32](strutil.Join([" cheng lock verify: invalid version for ", strings.CloneStr(pkg.packageId), ": ", strings.CloneStr(pkg.version)], ""))
        for j in 0..<i:
            if lock.packages[j].packageId == pkg.packageId:
                return Err[int32](strutil.Join([" cheng lock verify: duplicate package: ", strings.CloneStr(pkg.packageId)], ""))
    return Ok[int32](lock.packages.len)
