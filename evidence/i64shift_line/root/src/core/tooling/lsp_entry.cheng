# src/core/tooling/lsp_entry.cheng
# Binary entry point for the LSP server.
# JSON-RPC 2.0 over stdin/stdout.
# Delegates to LspServerMain in lsp_server.cheng.

import std/cmdline
import cheng/core/tooling/lsp_server as lsp

fn main(argc: int32, argv: str*): int32 =
    let _ = argc
    let _ = argv
    cmdline.CaptureCmdLine(argc, argv)
    var args: str[]
    let count: int32 = cmdline.ParamCount()
    for i in 1..count:
        let arg: str = cmdline.ParamStr(i)
        if len(arg) > 0:
            add(args, arg)
    return lsp.LspServerMain(args)
