        buffer.AppendText(buf, ", \"mutableFlag\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.declarationMutableFlags,
                declarationRow)))
        buffer.AppendText(buf, ", \"exportedFlag\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
