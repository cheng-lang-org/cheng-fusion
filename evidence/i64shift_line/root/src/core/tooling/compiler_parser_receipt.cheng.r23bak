        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.declarationSpanStarts, declarationRow)))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.declarationSpanEnds, declarationRow)))
        buffer.AppendText(buf, ", \"nameSpanStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.declarationNameSpanStarts,
                declarationRow)))
        buffer.AppendText(buf, ", \"nameSpanEnd\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.declarationNameSpanEnds,
