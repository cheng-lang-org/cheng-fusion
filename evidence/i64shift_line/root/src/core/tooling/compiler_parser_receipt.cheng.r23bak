    for row in 0..<source.declarationKinds.len:
        add(out.declarationProducerSourceIds,
            source.declarationProducerSourceIds[row])
        add(out.declarationSourceLocalRows,
            source.declarationSourceLocalRows[row])
        add(out.declarationKinds, source.declarationKinds[row])
