        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(buf,
            layout.FixedBytes32Hex(
                declarationIdentities[declarationRow]))
        buffer.AppendText(buf, "\"}")
        if declarationRow + 1 < tree.declarationCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"declarationLexicalScopes\": [\n")
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        let kind = parserReceiptArenaI32(
