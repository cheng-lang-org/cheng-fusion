            source.declarationLexicalScopeSpanIds[row])
    for row in 0..<source.patternKinds.len:
        add(out.patternProducerSourceIds,
            source.patternProducerSourceIds[row])
        add(out.patternSourceLocalRows, source.patternSourceLocalRows[row])
