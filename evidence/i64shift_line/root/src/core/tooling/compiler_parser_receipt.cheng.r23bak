        add(out.ffiHandleParserContractCids,
            source.ffiHandleParserContractCids[row])
    for row in 0..<source.ffiHandleParameterOrdinals.len:
        add(out.ffiHandleParameterOrdinals,
            source.ffiHandleParameterOrdinals[row])
        add(out.ffiHandleParameterDeclarationSourceLocalRows,
            source.ffiHandleParameterDeclarationSourceLocalRows[row])
        add(out.ffiHandleParameterEffects,
            source.ffiHandleParameterEffects[row])
    out.sidecarRaw32 = source.sidecarRaw32
    return out

fn ParserCanonicalSourceSidecarRelease(
        sidecar: var ParserCanonicalSourceSidecar) =
    sidecar = new(ParserCanonicalSourceSidecar)

@borrows
fn ParserCanonicalSourceSidecarImportTargetPathEquals(
        sidecar: ParserCanonicalSourceSidecar,
        itemRow: int32,
        canonicalPath: str): bool =
    if sidecar.importOrigins == nil:
        return false
    let importOrigins = sidecar.importOrigins
    if itemRow < 0 ||
       itemRow >= importOrigins.importItemModuleTokenStarts.len ||
       itemRow >= importOrigins.importItemModuleTokenCounts.len ||
       canonicalPath == "":
        return false
    let tokenStart = importOrigins.importItemModuleTokenStarts[itemRow]
    let tokenCount = importOrigins.importItemModuleTokenCounts[itemRow]
    if tokenStart < 0 || tokenCount <= 0 ||
       tokenStart > importOrigins.importModuleTokenIds.len - tokenCount:
        return false
    var pathOffset: int32
    for tokenOffset in 0..<tokenCount:
        if tokenOffset > 0:
            if pathOffset >= canonicalPath.len ||
               canonicalPath[pathOffset] != '/':
                return false
            pathOffset = pathOffset + 1
        let tokenId =
            importOrigins.importModuleTokenIds[tokenStart + tokenOffset]
        if tokenId < 0 || tokenId >= sidecar.tokenValues.len:
            return false
        let tokenValue = sidecar.tokenValues[tokenId]
        if tokenValue == "" ||
           pathOffset > canonicalPath.len - tokenValue.len:
            return false
        for valueOffset in 0..<tokenValue.len:
            if canonicalPath[pathOffset + valueOffset] !=
                   tokenValue[valueOffset]:
                return false
        pathOffset = pathOffset + tokenValue.len
    return pathOffset == canonicalPath.len

@borrows
fn parserCanonicalSourceSidecarConstExprMatchesTokenRangeInto(
        sidecar: ParserCanonicalSourceSidecar,
        rootIndex: int32,
        tokenStartRaw: int32,
        tokenLimitRaw: int32,
        visited: var bool[],
        err: var str): bool =
    var tokenStart = tokenStartRaw
    var tokenLimit = tokenLimitRaw
    var stripping = true
    while stripping && tokenStart < tokenLimit &&
          sidecar.tokenKinds[tokenStart] ==
              Int32(parser.ParserValueTokenLeftParen):
        var depth: int32
        var closeIndex: int32 = -1
        for tokenIndex in tokenStart..<tokenLimit:
            let tokenKind = sidecar.tokenKinds[tokenIndex]
            if tokenKind == Int32(parser.ParserValueTokenLeftParen):
                depth = depth + 1
            elif tokenKind == Int32(parser.ParserValueTokenRightParen):
                depth = depth - 1
                if depth == 0:
                    closeIndex = tokenIndex
                    break
        if closeIndex == tokenLimit - 1:
            tokenStart = tokenStart + 1
            tokenLimit = tokenLimit - 1
        else:
            stripping = false
    if rootIndex < 0 || rootIndex >= sidecar.typeConstExprKinds.len ||
       tokenStart >= tokenLimit ||
       visited.len != sidecar.typeConstExprKinds.len:
        err = " compiler parser receipt: const token range shape invalid"
        return false
    var depth: int32
    var additiveSplit: int32 = -1
    var multiplicativeSplit: int32 = -1
    for tokenIndex in tokenStart..<tokenLimit:
        if sidecar.tokenProducerSourceIds[tokenIndex] !=
               sidecar.sourceIndex:
            err = " compiler parser receipt: const token source invalid"
            return false
        let tokenKind = sidecar.tokenKinds[tokenIndex]
        if tokenKind == Int32(parser.ParserValueTokenLeftParen):
            depth = depth + 1
        elif tokenKind == Int32(parser.ParserValueTokenRightParen):
            depth = depth - 1
            if depth < 0:
                err = " compiler parser receipt: const parentheses invalid"
                return false
        elif depth == 0:
            let previousCanEnd =
                tokenIndex > tokenStart &&
                (sidecar.tokenKinds[tokenIndex - 1] ==
                     Int32(parser.ParserValueTokenInteger) ||
                 sidecar.tokenKinds[tokenIndex - 1] ==
                     Int32(parser.ParserValueTokenRightParen))
            if previousCanEnd &&
               (tokenKind == Int32(parser.ParserValueTokenPlus) ||
                tokenKind == Int32(parser.ParserValueTokenMinus)):
                additiveSplit = tokenIndex
            elif previousCanEnd &&
                 (tokenKind == Int32(parser.ParserValueTokenStar) ||
                  tokenKind == Int32(parser.ParserValueTokenSlash) ||
                  tokenKind == Int32(parser.ParserValueTokenPercent)):
                multiplicativeSplit = tokenIndex
    if depth != 0:
        err = " compiler parser receipt: const parentheses invalid"
        return false
    let split = additiveSplit >= 0 ?
        additiveSplit : multiplicativeSplit
    let nodeKind = sidecar.typeConstExprKinds[rootIndex]
    let nodeToken = sidecar.typeConstExprTokenIds[rootIndex]
    let left = sidecar.typeConstExprLeftChildIds[rootIndex]
    let right = sidecar.typeConstExprRightChildIds[rootIndex]
    let integerValue = sidecar.typeConstExprIntegerValues[rootIndex]
    if visited[rootIndex] ||
       sidecar.typeConstExprProducerSourceIds[rootIndex] !=
           sidecar.sourceIndex:
        err = " compiler parser receipt: const AST node reused"
        return false
    if split >= 0:
        let splitKind = sidecar.tokenKinds[split]
        var expectedKind = Int32(parser.ParserTypeConstExprAdd)
        if splitKind == Int32(parser.ParserValueTokenMinus):
            expectedKind = Int32(parser.ParserTypeConstExprSubtract)
        elif splitKind == Int32(parser.ParserValueTokenStar):
            expectedKind = Int32(parser.ParserTypeConstExprMultiply)
        elif splitKind == Int32(parser.ParserValueTokenSlash):
            expectedKind = Int32(parser.ParserTypeConstExprDivide)
        elif splitKind == Int32(parser.ParserValueTokenPercent):
            expectedKind = Int32(parser.ParserTypeConstExprModulo)
        if nodeKind != expectedKind || nodeToken != split ||
           integerValue != 0 || left < 0 || right < 0:
            err = " compiler parser receipt: const binary AST mismatch"
            return false
        visited[rootIndex] = true
        return parserCanonicalSourceSidecarConstExprMatchesTokenRangeInto(
                   sidecar,
                   left,
                   tokenStart,
                   split,
                   visited,
                   err) &&
               parserCanonicalSourceSidecarConstExprMatchesTokenRangeInto(
                   sidecar,
                   right,
                   split + 1,
                   tokenLimit,
                   visited,
                   err)
    let firstKind = sidecar.tokenKinds[tokenStart]
    if firstKind == Int32(parser.ParserValueTokenPlus) ||
       firstKind == Int32(parser.ParserValueTokenMinus):
        let expectedKind =
            firstKind == Int32(parser.ParserValueTokenPlus) ?
                Int32(parser.ParserTypeConstExprUnaryPlus) :
                Int32(parser.ParserTypeConstExprUnaryMinus)
        if nodeKind != expectedKind || nodeToken != tokenStart ||
           integerValue != 0 || left < 0 || right != -1:
            err = " compiler parser receipt: const unary AST mismatch"
            return false
        visited[rootIndex] = true
        return parserCanonicalSourceSidecarConstExprMatchesTokenRangeInto(
            sidecar,
            left,
            tokenStart + 1,
            tokenLimit,
            visited,
            err)
    var parsedInteger: int32
    let parsedLength =
        tokenStart < sidecar.tokenValues.len ?
            parseutils.ParseInt32(
                sidecar.tokenValues[tokenStart], parsedInteger) :
            -1
    if tokenLimit != tokenStart + 1 ||
       firstKind != Int32(parser.ParserValueTokenInteger) ||
       nodeKind != Int32(parser.ParserTypeConstExprInteger) ||
       nodeToken != tokenStart || left != -1 || right != -1 ||
       parsedLength != sidecar.tokenValues[tokenStart].len ||
       integerValue != parsedInteger:
        err = " compiler parser receipt: const integer AST mismatch"
        return false
    visited[rootIndex] = true
    return true

@borrows
fn parserCanonicalSourceSidecarFindMatchingToken(
        sidecar: ParserCanonicalSourceSidecar,
        tokenStart: int32,
        leftKind: parser.ParserValueTokenKind,
        rightKind: parser.ParserValueTokenKind): int32 =
    if tokenStart < 0 || tokenStart >= sidecar.tokenKinds.len ||
       sidecar.tokenKinds[tokenStart] != Int32(leftKind):
        return -1
    var depth: int32
    for tokenIndex in tokenStart..<sidecar.tokenKinds.len:
        if sidecar.tokenProducerSourceIds[tokenIndex] !=
               sidecar.sourceIndex:
            return -1
        let tokenKind = sidecar.tokenKinds[tokenIndex]
        if tokenKind == Int32(leftKind):
            depth = depth + 1
        elif tokenKind == Int32(rightKind):
            depth = depth - 1
            if depth == 0:
                return tokenIndex
            if depth < 0:
                return -1
    return -1

@borrows
fn parserCanonicalSourceSidecarTypeSyntaxOwnerKindValid(
        sidecar: ParserCanonicalSourceSidecar,
        root: int32): bool =
    if root < 0 || root >= sidecar.typeSyntaxKinds.len ||
       root >= sidecar.typeSyntaxRootKinds.len:
        return false
    let rootKind = sidecar.typeSyntaxRootKinds[root]
    let kind = sidecar.typeSyntaxKinds[root]
    if rootKind ==
           Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
        return kind == Int32(parser.ParserTypeSyntaxImplicitObject) ||
               kind == Int32(parser.ParserTypeSyntaxObject) ||
               kind == Int32(parser.ParserTypeSyntaxRefObject)
    if rootKind ==
           Int32(parser.ParserTypeSyntaxRootFieldDeclaration):
        return kind == Int32(parser.ParserTypeSyntaxObject) ||
               kind == Int32(parser.ParserTypeSyntaxRefObject)
    return false

@borrows
fn parserCanonicalSourceSidecarTypeSyntaxImmediateOwnerRoot(
        sidecar: ParserCanonicalSourceSidecar,
        fieldRoot: int32,
        declarationRowByTypeRoot: int32[]): int32 =
    if fieldRoot < 0 || fieldRoot >= declarationRowByTypeRoot.len:
        return -1
    let fieldDeclaration = declarationRowByTypeRoot[fieldRoot]
    if fieldDeclaration < 0 ||
       fieldDeclaration >= sidecar.declarationKinds.len ||
       sidecar.declarationKinds[fieldDeclaration] !=
           Int32(parser.ParserDeclarationField):
        return -1
    let fieldScope =
        sidecar.declarationLexicalScopeIds[fieldDeclaration]
    if fieldScope < 0 ||
       fieldScope >= sidecar.declarationLexicalScopeParentIds.len:
        return -1
    let parentScope =
        sidecar.declarationLexicalScopeParentIds[fieldScope]
    if parentScope < 0:
        return -1
    var expectedOwnerRoot: int32 = -1
    for declarationRow in 0..<fieldDeclaration:
        if sidecar.declarationLexicalScopeIds[declarationRow] !=
               parentScope:
            continue
        let candidateRoot =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
        if candidateRoot >= 0 &&
           candidateRoot < declarationRowByTypeRoot.len &&
           declarationRowByTypeRoot[candidateRoot] == declarationRow &&
           parserCanonicalSourceSidecarTypeSyntaxOwnerKindValid(
               sidecar, candidateRoot):
            expectedOwnerRoot = candidateRoot
    return expectedOwnerRoot

@borrows
fn parserCanonicalSourceSidecarTypeSyntaxOwnerChainValid(
        sidecar: ParserCanonicalSourceSidecar,
        root: int32,
        declarationRowByTypeRoot: int32[]): bool =
    let typeCount = sidecar.typeSyntaxKinds.len
    if root < 0 || root >= typeCount ||
       declarationRowByTypeRoot.len != typeCount:
        return false
    var cursor = root
    var stepCount: int32
    while stepCount < typeCount:
        let rootKind = sidecar.typeSyntaxRootKinds[cursor]
        let declarationOwner =
            sidecar.typeSyntaxDeclarationOwnerIds[cursor]
        if rootKind ==
               Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
            return declarationOwner == cursor &&
                   declarationRowByTypeRoot[cursor] >= 0 &&
                   sidecar.declarationKinds[
                       declarationRowByTypeRoot[cursor]] ==
                       Int32(parser.ParserDeclarationType)
        if rootKind !=
               Int32(parser.ParserTypeSyntaxRootFieldDeclaration) ||
           declarationOwner < 0 || declarationOwner >= cursor ||
           declarationRowByTypeRoot[cursor] < 0 ||
           sidecar.declarationKinds[
               declarationRowByTypeRoot[cursor]] !=
               Int32(parser.ParserDeclarationField) ||
           !parserCanonicalSourceSidecarTypeSyntaxOwnerKindValid(
               sidecar, declarationOwner) ||
           sidecar.typeSyntaxSourceIds[declarationOwner] !=
               sidecar.typeSyntaxSourceIds[cursor] ||
           sidecar.typeSyntaxProducerSourceIds[declarationOwner] !=
               sidecar.typeSyntaxProducerSourceIds[cursor] ||
           sidecar.typeSyntaxDeclarationOwnerTokenIds[
               declarationOwner] !=
               sidecar.typeSyntaxDeclarationOwnerTokenIds[cursor] ||
           sidecar.typeSyntaxGenericSymbolStarts[declarationOwner] !=
               sidecar.typeSyntaxGenericSymbolStarts[cursor] ||
           sidecar.typeSyntaxGenericSymbolCounts[declarationOwner] !=
               sidecar.typeSyntaxGenericSymbolCounts[cursor] ||
           parserCanonicalSourceSidecarTypeSyntaxImmediateOwnerRoot(
               sidecar, cursor, declarationRowByTypeRoot) !=
               declarationOwner:
            return false
        cursor = declarationOwner
        stepCount = stepCount + 1
    return false

@borrows
fn parserCanonicalFfiHandleAnnotationEffectMatches(
        sidecar: ParserCanonicalSourceSidecar,
        annotationRow: int32,
        contractRow: int32): bool =
    let parameterStart =
        sidecar.ffiHandleContractParameterStarts[contractRow]
    let parameterCount =
        sidecar.ffiHandleContractParameterCounts[contractRow]
    let resultEffect =
        sidecar.ffiHandleContractResultEffects[contractRow]
    let unwindKind =
        sidecar.ffiHandleContractUnwindKinds[contractRow]
    let rootStart = sidecar.annotationArgRootStarts[annotationRow]
    let rootCount = sidecar.annotationArgRootCounts[annotationRow]
    if rootCount != 1 + parameterCount +
           (resultEffect ==
                Int32(parser.NormalizedFfiHandleEffectProduce) ? 1 : 0):
        return false
    var parameterSeen: bool[]
    setLen(parameterSeen, parameterCount)
    var unwindSeen = false
    var resultSeen = false
    for rootOffset in 0..<rootCount:
        let keyValueRow =
            sidecar.annotationArgRootIds[rootStart + rootOffset]
        if sidecar.annotationArgKinds[keyValueRow] !=
               Int32(parser.ParserAnnotationArgKeyValue) ||
           sidecar.annotationArgChildCounts[keyValueRow] != 2:
            return false
        let childStart = sidecar.annotationArgChildStarts[keyValueRow]
        let keyRow = sidecar.annotationArgChildIds[childStart]
        let valueRow = sidecar.annotationArgChildIds[childStart + 1]
        if sidecar.annotationArgKinds[keyRow] !=
               Int32(parser.ParserAnnotationArgIdentifier) ||
           sidecar.annotationArgKinds[valueRow] !=
               Int32(parser.ParserAnnotationArgIdentifier):
            return false
        let key = sidecar.tokenValues[sidecar.annotationArgTokenIds[keyRow]]
        let effectText =
            sidecar.tokenValues[sidecar.annotationArgTokenIds[valueRow]]
        if key == "unwind":
            if unwindSeen:
                return false
            if effectText == "no_unwind":
                if unwindKind !=
                       Int32(parser.NormalizedFfiHandleUnwindNoUnwind):
                    return false
                unwindSeen = true
                continue
            return false
        var effect = Int32(parser.NormalizedFfiHandleEffectInvalid)
        if effectText == "produce":
            effect = Int32(parser.NormalizedFfiHandleEffectProduce)
        elif effectText == "borrow":
            effect = Int32(parser.NormalizedFfiHandleEffectBorrow)
        elif effectText == "consume":
            effect = Int32(parser.NormalizedFfiHandleEffectConsume)
        if key == "result":
            if resultSeen ||
               effect != Int32(parser.NormalizedFfiHandleEffectProduce) ||
               resultEffect != effect:
                return false
            resultSeen = true
            continue
        let ordinal = parser.ParserArgIndexFromName(key)
        var matched: int32 = -1
        for parameterOffset in 0..<parameterCount:
            if sidecar.ffiHandleParameterOrdinals[
                   parameterStart + parameterOffset] == ordinal:
                matched = parameterOffset
        if ordinal < 0 || matched < 0 || parameterSeen[matched] ||
           sidecar.ffiHandleParameterEffects[
               parameterStart + matched] != effect:
            return false
        parameterSeen[matched] = true
    if !unwindSeen ||
       resultSeen !=
           (resultEffect ==
                Int32(parser.NormalizedFfiHandleEffectProduce)):
        return false
    for parameterOffset in 0..<parameterCount:
        if !parameterSeen[parameterOffset]:
            return false
    return true

@borrows
fn parserCanonicalFfiHandleContractsStrictValidateInto(
        sidecar: ParserCanonicalSourceSidecar,
        err: var str): bool =
    let contractCount = sidecar.ffiHandleContractProducerSourceIds.len
    let parameterCount = sidecar.ffiHandleParameterOrdinals.len
    if contractCount !=
           sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows.len ||
       contractCount !=
           sidecar.ffiHandleContractAnnotationSourceLocalRows.len ||
       contractCount != sidecar.ffiHandleContractUnwindKinds.len ||
       contractCount != sidecar.ffiHandleContractResultEffects.len ||
       contractCount != sidecar.ffiHandleContractParameterStarts.len ||
       contractCount != sidecar.ffiHandleContractParameterCounts.len ||
       contractCount != sidecar.ffiHandleParserContractCids.len ||
       parameterCount !=
           sidecar.ffiHandleParameterDeclarationSourceLocalRows.len ||
       parameterCount != sidecar.ffiHandleParameterEffects.len:
        err = " compiler parser receipt: ffi handle contract shape mismatch"
        return false
    var ffiAnnotationCount: int32
    for annotationRow in 0..<sidecar.annotationNameTokenIds.len:
        let nameToken = sidecar.annotationNameTokenIds[annotationRow]
        if nameToken >= 0 && nameToken < sidecar.tokenValues.len &&
           sidecar.tokenValues[nameToken] == "ffi_handle":
            ffiAnnotationCount = ffiAnnotationCount + 1
    if ffiAnnotationCount != contractCount:
        err = " compiler parser receipt: ffi handle annotation coverage mismatch"
        return false
    var functionSeen: bool[]
    var annotationSeen: bool[]
    setLen(functionSeen, sidecar.declarationKinds.len)
    setLen(annotationSeen, sidecar.annotationNameTokenIds.len)
    var parameterCursor: int32
    for contractRow in 0..<contractCount:
        let producerSource =
            sidecar.ffiHandleContractProducerSourceIds[contractRow]
        let functionSourceLocalRow =
            sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows[
                contractRow]
        let annotationSourceLocalRow =
            sidecar.ffiHandleContractAnnotationSourceLocalRows[contractRow]
        let resultEffect =
            sidecar.ffiHandleContractResultEffects[contractRow]
        let effectStart =
            sidecar.ffiHandleContractParameterStarts[contractRow]
        let effectCount =
            sidecar.ffiHandleContractParameterCounts[contractRow]
        if producerSource != sidecar.sourceIndex ||
           functionSourceLocalRow < 0 ||
           functionSourceLocalRow >= sidecar.declarationKinds.len ||
           annotationSourceLocalRow < 0 ||
           annotationSourceLocalRow >= sidecar.annotationNameTokenIds.len ||
           functionSeen[functionSourceLocalRow] ||
           annotationSeen[annotationSourceLocalRow] ||
           sidecar.declarationSourceLocalRows[
               functionSourceLocalRow] != functionSourceLocalRow ||
           sidecar.declarationProducerSourceIds[
               functionSourceLocalRow] != producerSource ||
           sidecar.declarationKinds[functionSourceLocalRow] !=
               Int32(parser.ParserDeclarationFunction) ||
           sidecar.annotationSourceLocalRows[
               annotationSourceLocalRow] != annotationSourceLocalRow ||
           sidecar.annotationProducerSourceIds[
               annotationSourceLocalRow] != producerSource ||
           sidecar.tokenValues[sidecar.annotationNameTokenIds[
               annotationSourceLocalRow]] != "ffi_handle" ||
           effectStart != parameterCursor || effectCount < 0 ||
           effectStart > parameterCount - effectCount ||
           sidecar.ffiHandleContractUnwindKinds[contractRow] !=
               Int32(parser.NormalizedFfiHandleUnwindNoUnwind) ||
           (resultEffect !=
                Int32(parser.NormalizedFfiHandleEffectInvalid) &&
            resultEffect !=
                Int32(parser.NormalizedFfiHandleEffectProduce)) ||
           (resultEffect ==
                Int32(parser.NormalizedFfiHandleEffectInvalid) &&
            effectCount == 0) ||
           (contractRow > 0 &&
            sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows[
                contractRow - 1] >= functionSourceLocalRow):
            err = " compiler parser receipt: ffi handle contract row invalid"
            return false
        var previousContractOrdinal: int32 = -1
        for effectOffset in 0..<effectCount:
            let effectRow = effectStart + effectOffset
            let ordinal = sidecar.ffiHandleParameterOrdinals[effectRow]
            let parameterSourceLocalRow =
                sidecar.ffiHandleParameterDeclarationSourceLocalRows[
                    effectRow]
            let effect = sidecar.ffiHandleParameterEffects[effectRow]
            var exactParameterDeclarationRow: int32 = -1
            var observedParameterOrdinal: int32
            for declarationRow in 0..<sidecar.declarationKinds.len:
                if sidecar.declarationKinds[declarationRow] !=
                       Int32(parser.ParserDeclarationParameter) ||
                   sidecar.declarationOwnerIds[declarationRow] !=
                       functionSourceLocalRow:
                    continue
                if sidecar.declarationSourceLocalRows[declarationRow] ==
                       parameterSourceLocalRow:
                    if exactParameterDeclarationRow >= 0 ||
                       observedParameterOrdinal != ordinal:
                        err = " compiler parser receipt: ffi handle exact parameter ambiguous"
                        return false
                    exactParameterDeclarationRow = declarationRow
                observedParameterOrdinal = observedParameterOrdinal + 1
            if ordinal <= previousContractOrdinal ||
               exactParameterDeclarationRow < 0 ||
               sidecar.declarationProducerSourceIds[
                   exactParameterDeclarationRow] != producerSource ||
               (effect != Int32(parser.NormalizedFfiHandleEffectBorrow) &&
                effect != Int32(parser.NormalizedFfiHandleEffectConsume)):
                err = " compiler parser receipt: ffi handle parameter row invalid"
                return false
            previousContractOrdinal = ordinal
        if !parserCanonicalFfiHandleAnnotationEffectMatches(
               sidecar,
               annotationSourceLocalRow,
               contractRow) ||
           layout.FixedBytes32Equal(
               sidecar.ffiHandleParserContractCids[contractRow],
               layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               sidecar.ffiHandleParserContractCids[contractRow],
               parserFfiHandleContractCid(sidecar, contractRow)):
            err = " compiler parser receipt: ffi handle contract cid mismatch"
            return false
        functionSeen[functionSourceLocalRow] = true
        annotationSeen[annotationSourceLocalRow] = true
        parameterCursor = parameterCursor + effectCount
    if parameterCursor != parameterCount:
        err = " compiler parser receipt: ffi handle parameter CSR incomplete"
        return false
    err = ""
    return true

type
    parserCanonicalSidecarTypeSyntaxScratch = ref object
        typeChildCursor: int32
        typeBracketArgCursor: int32
        typeEnumVariantCursor: int32
        typeChildSeen: bool[]
        typeEnumPayloadSeen: bool[]
        typeConstExprSeen: bool[]

@borrows
fn parserCanonicalSourceSidecarValidateTypeSyntaxRec(
        sidecar: ParserCanonicalSourceSidecar,
        scratch: parserCanonicalSidecarTypeSyntaxScratch,
        row: int32,
        err: var str): bool =
    let typeCount = sidecar.typeSyntaxKinds.len
    let typeConstExprCount = sidecar.typeConstExprKinds.len
    let spanCount = sidecar.spanStartBytes.len
    let nodeCount = sidecar.nodeKinds.len
    let declarationCount = sidecar.declarationKinds.len
    if row >= typeCount:
        if scratch.typeChildCursor != sidecar.typeSyntaxChildIds.len ||
           scratch.typeBracketArgCursor !=
               sidecar.typeSyntaxBracketArgTokenStarts.len ||
           scratch.typeEnumVariantCursor !=
               sidecar.typeEnumVariantNameTokenIds.len:
            err = " compiler parser receipt: type syntax child coverage mismatch"
            return false
        for constRow in 0..<typeConstExprCount:
            if !scratch.typeConstExprSeen[constRow]:
                err = " compiler parser receipt: type const expression orphan"
                return false
        return true
    let kind = sidecar.typeSyntaxKinds[row]
    let spanId = sidecar.typeSyntaxSpanIds[row]
    let ownerToken = sidecar.typeSyntaxOwnerTokenIds[row]
    let declarationOwnerToken =
        sidecar.typeSyntaxDeclarationOwnerTokenIds[row]
    let declarationOwner =
        sidecar.typeSyntaxDeclarationOwnerIds[row]
    let genericSymbolStart =
        sidecar.typeSyntaxGenericSymbolStarts[row]
    let genericSymbolCount =
        sidecar.typeSyntaxGenericSymbolCounts[row]
    let nameToken = sidecar.typeSyntaxNameTokenIds[row]
    let childStart = sidecar.typeSyntaxChildStarts[row]
    let childCount = sidecar.typeSyntaxChildCounts[row]
    let bracketArgStart = sidecar.typeSyntaxBracketArgStarts[row]
    let bracketArgCount = sidecar.typeSyntaxBracketArgCounts[row]
    let fixedLength = sidecar.typeSyntaxFixedLengths[row]
    let questionToken = sidecar.typeSyntaxQuestionTokenIds[row]
    let rootKind = sidecar.typeSyntaxRootKinds[row]
    let enumVariantStart = sidecar.typeSyntaxEnumVariantStarts[row]
    let enumVariantCount = sidecar.typeSyntaxEnumVariantCounts[row]
    if sidecar.typeSyntaxSourceIds[row] != sidecar.sourceIndex ||
       sidecar.typeSyntaxProducerSourceIds[row] != sidecar.sourceIndex ||
       sidecar.typeSyntaxSourceLocalRows[row] != row ||
       kind <= Int32(parser.ParserTypeSyntaxInvalid) ||
       kind > Int32(parser.ParserTypeSyntaxOptional) ||
       spanId < 0 || spanId >= spanCount ||
       ownerToken < 0 || ownerToken >= sidecar.tokenKinds.len ||
       declarationOwnerToken < -1 ||
       declarationOwnerToken >= sidecar.tokenKinds.len ||
       declarationOwner < -1 || declarationOwner >= typeCount ||
       genericSymbolStart < -1 || genericSymbolCount < 0 ||
       (genericSymbolCount == 0) != (genericSymbolStart == -1) ||
       (genericSymbolCount > 0 &&
        genericSymbolStart >
            sidecar.typeGenericSymbolNameTokenIds.len -
                genericSymbolCount) ||
       nameToken < -1 || nameToken >= sidecar.tokenKinds.len ||
       questionToken < -1 ||
       questionToken >= sidecar.tokenKinds.len ||
       childStart != scratch.typeChildCursor || childCount < 0 ||
       childStart + childCount > sidecar.typeSyntaxChildIds.len ||
       bracketArgStart != scratch.typeBracketArgCursor || bracketArgCount < 0 ||
       bracketArgStart + bracketArgCount >
           sidecar.typeSyntaxBracketArgTokenStarts.len ||
       enumVariantStart < -1 || enumVariantCount < 0 ||
       (enumVariantCount == 0) != (enumVariantStart == -1) ||
       (enumVariantCount > 0 &&
        (enumVariantStart != scratch.typeEnumVariantCursor ||
         enumVariantStart + enumVariantCount >
             sidecar.typeEnumVariantNameTokenIds.len)) ||
       rootKind < Int32(parser.ParserTypeSyntaxRootInvalid) ||
       rootKind > Int32(parser.ParserTypeSyntaxRootGenericDefault):
        err = " compiler parser receipt: type syntax row invalid"
        return false
    let fixedArray = kind == Int32(parser.ParserTypeSyntaxFixedArray)
    if (fixedArray && fixedLength <= 0) ||
       (!fixedArray && fixedLength != -1):
        err = " compiler parser receipt: type syntax fixed length invalid"
        return false
    let unary = kind == Int32(parser.ParserTypeSyntaxSeq) ||
                kind == Int32(parser.ParserTypeSyntaxFixedArray) ||
                kind == Int32(parser.ParserTypeSyntaxVarBorrow) ||
                kind == Int32(parser.ParserTypeSyntaxAlias) ||
                kind == Int32(parser.ParserTypeSyntaxGrouped) ||
                kind == Int32(parser.ParserTypeSyntaxOptional)
    let objectType =
        kind == Int32(parser.ParserTypeSyntaxObject) ||
        kind == Int32(parser.ParserTypeSyntaxRefObject)
    let leaf = kind == Int32(parser.ParserTypeSyntaxNominal) ||
               kind == Int32(parser.ParserTypeSyntaxImplicitObject) ||
               kind == Int32(parser.ParserTypeSyntaxEnum)
    if (unary && childCount != 1) ||
       (leaf && childCount != 0) ||
       (objectType && childCount > 1) ||
       (kind == Int32(parser.ParserTypeSyntaxAlgebraic) &&
        childCount < 1) ||
       (kind == Int32(parser.ParserTypeSyntaxBracketApply) &&
        childCount < 1) ||
       (kind == Int32(parser.ParserTypeSyntaxQualified) &&
        childCount < 2):
        err = " compiler parser receipt: type syntax arity invalid"
        return false
    let optional =
        kind == Int32(parser.ParserTypeSyntaxOptional)
    let grouped =
        kind == Int32(parser.ParserTypeSyntaxGrouped)
    if optional != (questionToken >= 0):
        err = " compiler parser receipt: optional token shape invalid"
        return false
    if optional:
        let child = sidecar.typeSyntaxChildIds[childStart]
        if child < 0 || child >= row:
            err = " compiler parser receipt: optional child invalid"
            return false
        let childSpan = sidecar.typeSyntaxSpanIds[child]
        if questionToken <= 0 ||
           sidecar.tokenKinds[questionToken] !=
               Int32(parser.ParserValueTokenQuestion) ||
           sidecar.tokenProducerSourceIds[questionToken] !=
               sidecar.sourceIndex ||
           sidecar.typeSyntaxProducerSourceIds[child] !=
               sidecar.sourceIndex ||
           sidecar.typeSyntaxOwnerTokenIds[child] != ownerToken ||
           sidecar.typeSyntaxRootKinds[child] !=
               Int32(parser.ParserTypeSyntaxRootInvalid) ||
           sidecar.typeSyntaxDeclarationOwnerIds[child] != -1 ||
           sidecar.spanStartBytes[childSpan] !=
               sidecar.spanStartBytes[spanId] ||
           sidecar.spanEndBytes[childSpan] !=
               sidecar.spanEndBytes[
                   sidecar.tokenSpanIds[questionToken - 1]] ||
           sidecar.spanEndBytes[spanId] !=
               sidecar.spanEndBytes[
                   sidecar.tokenSpanIds[questionToken]]:
            err = " compiler parser receipt: optional token authority invalid"
            return false
    if grouped:
        let leftToken = nameToken
        let rightToken =
            parserCanonicalSourceSidecarFindMatchingToken(
                sidecar,
                leftToken,
                parser.ParserValueTokenLeftParen,
                parser.ParserValueTokenRightParen)
        let child = sidecar.typeSyntaxChildIds[childStart]
        let leftSpan =
            leftToken >= 0 &&
            leftToken < sidecar.tokenSpanIds.len ?
                sidecar.tokenSpanIds[leftToken] :
                -1
        let rightSpan =
            rightToken >= 0 &&
            rightToken < sidecar.tokenSpanIds.len ?
                sidecar.tokenSpanIds[rightToken] :
                -1
        let childSpan =
            child >= 0 && child < sidecar.typeSyntaxSpanIds.len ?
                sidecar.typeSyntaxSpanIds[child] :
                -1
        if leftToken < 0 || leftToken >= sidecar.tokenKinds.len ||
           rightToken <= leftToken + 1 ||
           rightToken >= sidecar.tokenKinds.len ||
           leftSpan < 0 || leftSpan >= spanCount ||
           rightSpan < 0 || rightSpan >= spanCount ||
           child < 0 || child >= row ||
           childSpan < 0 || childSpan >= spanCount ||
           sidecar.tokenKinds[leftToken] !=
               Int32(parser.ParserValueTokenLeftParen) ||
           sidecar.tokenKinds[rightToken] !=
               Int32(parser.ParserValueTokenRightParen) ||
           sidecar.tokenProducerSourceIds[leftToken] !=
               sidecar.sourceIndex ||
           sidecar.tokenProducerSourceIds[rightToken] !=
               sidecar.sourceIndex ||
           sidecar.spanStartBytes[spanId] !=
               sidecar.spanStartBytes[leftSpan] ||
           sidecar.spanEndBytes[spanId] !=
               sidecar.spanEndBytes[rightSpan] ||
           sidecar.typeSyntaxProducerSourceIds[child] !=
               sidecar.sourceIndex ||
           sidecar.typeSyntaxSourceIds[child] !=
               sidecar.sourceIndex ||
           sidecar.typeSyntaxOwnerTokenIds[child] != ownerToken ||
           sidecar.typeSyntaxRootKinds[child] !=
               Int32(parser.ParserTypeSyntaxRootInvalid) ||
           sidecar.typeSyntaxDeclarationOwnerIds[child] != -1 ||
           sidecar.spanStartBytes[childSpan] !=
               sidecar.spanStartBytes[
                   sidecar.tokenSpanIds[leftToken + 1]] ||
           sidecar.spanEndBytes[childSpan] !=
               sidecar.spanEndBytes[
                   sidecar.tokenSpanIds[rightToken - 1]]:
            err = " compiler parser receipt: grouped token authority invalid"
            return false
    if objectType:
        let markerToken = nameToken
        let markerKind =
            markerToken >= 0 && markerToken < sidecar.tokenKinds.len ?
                sidecar.tokenKinds[markerToken] :
                Int32(parser.ParserValueTokenInvalid)
        let markerSpan =
            markerToken >= 0 && markerToken < sidecar.tokenSpanIds.len ?
                sidecar.tokenSpanIds[markerToken] :
                -1
        if markerToken < 0 ||
           markerToken >= sidecar.tokenKinds.len ||
           markerSpan < 0 || markerSpan >= spanCount ||
           sidecar.tokenProducerSourceIds[markerToken] !=
               sidecar.sourceIndex ||
           sidecar.spanStartBytes[spanId] !=
               sidecar.spanStartBytes[markerSpan] ||
           (kind == Int32(parser.ParserTypeSyntaxObject) &&
            markerKind != Int32(parser.ParserValueTokenObject) &&
            markerKind != Int32(parser.ParserValueTokenOf)) ||
           (kind == Int32(parser.ParserTypeSyntaxRefObject) &&
            markerKind != Int32(parser.ParserValueTokenRef)):
            err = " compiler parser receipt: object marker authority invalid"
            return false
        if childCount == 0:
            let bareObject =
                kind == Int32(parser.ParserTypeSyntaxObject) &&
                markerKind == Int32(parser.ParserValueTokenObject) &&
                sidecar.spanEndBytes[spanId] ==
                    sidecar.spanEndBytes[markerSpan]
            let objectToken = markerToken + 1
            let explicitRefObject =
                kind == Int32(parser.ParserTypeSyntaxRefObject) &&
                objectToken < sidecar.tokenKinds.len &&
                sidecar.tokenKinds[objectToken] ==
                    Int32(parser.ParserValueTokenObject) &&
                sidecar.tokenProducerSourceIds[objectToken] ==
                    sidecar.sourceIndex &&
                sidecar.spanEndBytes[markerSpan] <=
                    sidecar.spanStartBytes[
                        sidecar.tokenSpanIds[objectToken]] &&
                sidecar.spanEndBytes[spanId] ==
                    sidecar.spanEndBytes[
                        sidecar.tokenSpanIds[objectToken]]
            if !bareObject && !explicitRefObject:
                err = " compiler parser receipt: empty object span invalid"
                return false
        else:
            let baseType = sidecar.typeSyntaxChildIds[childStart]
            var baseStartToken = markerToken + 1
            if kind == Int32(parser.ParserTypeSyntaxRefObject):
                baseStartToken = markerToken + 3
            elif markerKind == Int32(parser.ParserValueTokenObject):
                baseStartToken = markerToken + 2
            let ofToken = baseStartToken - 1
            if baseStartToken <= markerToken ||
               baseStartToken >= sidecar.tokenKinds.len ||
               ofToken < 0 || ofToken >= sidecar.tokenKinds.len ||
               sidecar.tokenKinds[ofToken] !=
                   Int32(parser.ParserValueTokenOf) ||
               sidecar.tokenProducerSourceIds[ofToken] !=
                   sidecar.sourceIndex ||
               (kind == Int32(parser.ParserTypeSyntaxRefObject) &&
                (markerToken + 2 >= sidecar.tokenKinds.len ||
                 sidecar.tokenKinds[markerToken + 1] !=
                     Int32(parser.ParserValueTokenObject) ||
                 sidecar.tokenKinds[markerToken + 2] !=
                     Int32(parser.ParserValueTokenOf) ||
                 sidecar.tokenProducerSourceIds[markerToken + 1] !=
                     sidecar.sourceIndex ||
                 sidecar.spanEndBytes[markerSpan] >
                     sidecar.spanStartBytes[
                         sidecar.tokenSpanIds[markerToken + 1]] ||
                 sidecar.spanEndBytes[
                     sidecar.tokenSpanIds[markerToken + 1]] >
                     sidecar.spanStartBytes[
                         sidecar.tokenSpanIds[ofToken]])) ||
               baseType < 0 || baseType >= row ||
               sidecar.spanEndBytes[
                   sidecar.tokenSpanIds[ofToken]] >
                   sidecar.spanStartBytes[
                       sidecar.typeSyntaxSpanIds[baseType]] ||
               sidecar.typeSyntaxProducerSourceIds[baseType] !=
                   sidecar.sourceIndex ||
               sidecar.typeSyntaxSourceIds[baseType] !=
                   sidecar.sourceIndex ||
               sidecar.typeSyntaxOwnerTokenIds[baseType] != ownerToken ||
               sidecar.typeSyntaxRootKinds[baseType] !=
                   Int32(parser.ParserTypeSyntaxRootInvalid) ||
               sidecar.typeSyntaxDeclarationOwnerIds[baseType] != -1 ||
               sidecar.spanStartBytes[
                   sidecar.typeSyntaxSpanIds[baseType]] !=
                   sidecar.spanStartBytes[
                       sidecar.tokenSpanIds[baseStartToken]] ||
               sidecar.spanEndBytes[
                   sidecar.typeSyntaxSpanIds[baseType]] !=
                   sidecar.spanEndBytes[spanId]:
                err = " compiler parser receipt: object inheritance edge invalid"
                return false
    let bracketKind = fixedArray ||
        kind == Int32(parser.ParserTypeSyntaxBracketApply)
    if (bracketKind && bracketArgCount == 0) ||
       (!bracketKind && bracketArgCount != 0) ||
       (fixedArray && bracketArgCount != 1):
        err = " compiler parser receipt: type syntax bracket shape invalid"
        return false
    if bracketKind:
        let baseChild = sidecar.typeSyntaxChildIds[childStart]
        let firstArgToken =
            sidecar.typeSyntaxBracketArgTokenStarts[bracketArgStart]
        let finalArgRow = bracketArgStart + bracketArgCount - 1
        let closeToken =
            sidecar.typeSyntaxBracketArgTokenStarts[finalArgRow] +
            sidecar.typeSyntaxBracketArgTokenCounts[finalArgRow]
        let baseSpan = sidecar.typeSyntaxSpanIds[baseChild]
        if sidecar.spanStartBytes[baseSpan] !=
               sidecar.spanStartBytes[spanId] ||
           firstArgToken <= 0 || closeToken >= sidecar.tokenKinds.len ||
           sidecar.spanStartBytes[
               sidecar.tokenSpanIds[firstArgToken - 1]] <
               sidecar.spanEndBytes[baseSpan] ||
           sidecar.spanEndBytes[
               sidecar.tokenSpanIds[closeToken]] !=
               sidecar.spanEndBytes[spanId]:
            err = " compiler parser receipt: bracket owner span invalid"
            return false
    var bracketTypeChildOffset: int32 = 1
    for argOffset in 0..<bracketArgCount:
        let argRow = bracketArgStart + argOffset
        let tokenStart =
            sidecar.typeSyntaxBracketArgTokenStarts[argRow]
        let tokenCount =
            sidecar.typeSyntaxBracketArgTokenCounts[argRow]
        let typeNode = sidecar.typeSyntaxBracketArgTypeIds[argRow]
        let constRoot =
            sidecar.typeSyntaxBracketArgConstExprRootIds[argRow]
        let tokenLimit = tokenStart + tokenCount
        let separatorToken = tokenStart - 1
        if tokenStart <= 0 || tokenCount <= 0 ||
           tokenLimit >= sidecar.tokenKinds.len ||
           sidecar.spanStartBytes[
               sidecar.tokenSpanIds[tokenStart]] <
               sidecar.spanStartBytes[spanId] ||
           sidecar.spanEndBytes[
               sidecar.tokenSpanIds[tokenLimit - 1]] >
               sidecar.spanEndBytes[spanId] ||
           (argOffset == 0 &&
            sidecar.tokenKinds[separatorToken] !=
                Int32(parser.ParserValueTokenLeftBracket)) ||
           (argOffset > 0 &&
            ((sidecar.tokenKinds[separatorToken] !=
                  Int32(parser.ParserValueTokenComma) &&
              sidecar.tokenKinds[separatorToken] !=
                  Int32(parser.ParserValueTokenSemicolon)) ||
             sidecar.typeSyntaxBracketArgTokenStarts[argRow - 1] +
                 sidecar.typeSyntaxBracketArgTokenCounts[argRow - 1] !=
                 separatorToken)) ||
           (argOffset + 1 == bracketArgCount &&
            sidecar.tokenKinds[tokenLimit] !=
                Int32(parser.ParserValueTokenRightBracket)) ||
           typeNode < -1 || typeNode >= row || constRoot < -1 ||
           constRoot >= typeConstExprCount ||
           (typeNode >= 0) == (constRoot >= 0):
            err = " compiler parser receipt: bracket token CSR invalid"
            return false
        if typeNode >= 0:
            if fixedArray || bracketTypeChildOffset >= childCount ||
               sidecar.typeSyntaxChildIds[
                   childStart + bracketTypeChildOffset] != typeNode ||
               sidecar.typeSyntaxOwnerTokenIds[typeNode] != ownerToken:
                err = " compiler parser receipt: bracket type child authority invalid"
                return false
            let typeSpan = sidecar.typeSyntaxSpanIds[typeNode]
            if sidecar.spanStartBytes[typeSpan] !=
                   sidecar.spanStartBytes[
                       sidecar.tokenSpanIds[tokenStart]] ||
               sidecar.spanEndBytes[typeSpan] !=
                   sidecar.spanEndBytes[
                       sidecar.tokenSpanIds[tokenLimit - 1]]:
                err = " compiler parser receipt: bracket type child span invalid"
                return false
            bracketTypeChildOffset = bracketTypeChildOffset + 1
        else:
            if !parserCanonicalSourceSidecarConstExprMatchesTokenRangeInto(
                   sidecar,
                   constRoot,
                   tokenStart,
                   tokenLimit,
                   scratch.typeConstExprSeen,
                   err):
                err = " compiler parser receipt: bracket const authority invalid"
                return false
        scratch.typeBracketArgCursor = scratch.typeBracketArgCursor + 1
    if bracketKind && bracketTypeChildOffset != childCount:
        err = " compiler parser receipt: bracket type child coverage invalid"
        return false
    if fixedArray &&
       (sidecar.typeSyntaxBracketArgTokenCounts[bracketArgStart] != 1 ||
        sidecar.tokenKinds[
            sidecar.typeSyntaxBracketArgTokenStarts[bracketArgStart]] !=
            Int32(parser.ParserValueTokenInteger)):
        err = " compiler parser receipt: literal fixed array proof invalid"
        return false
    let nameRequired =
        kind == Int32(parser.ParserTypeSyntaxNominal) ||
        kind == Int32(parser.ParserTypeSyntaxQualified) ||
        kind == Int32(parser.ParserTypeSyntaxTuple) ||
        kind == Int32(parser.ParserTypeSyntaxFunction) ||
        kind == Int32(parser.ParserTypeSyntaxVarBorrow) ||
        kind == Int32(parser.ParserTypeSyntaxGrouped) ||
        kind == Int32(parser.ParserTypeSyntaxObject) ||
        kind == Int32(parser.ParserTypeSyntaxRefObject) ||
        kind == Int32(parser.ParserTypeSyntaxImplicitObject) ||
        kind == Int32(parser.ParserTypeSyntaxEnum) ||
        kind == Int32(parser.ParserTypeSyntaxVariant)
    if nameRequired != (nameToken >= 0):
        err = " compiler parser receipt: type syntax name authority invalid"
        return false
    if nameToken >= 0:
        let nameSpanId = sidecar.tokenSpanIds[nameToken]
        if sidecar.spanStartBytes[nameSpanId] <
               sidecar.spanStartBytes[spanId] ||
           sidecar.spanEndBytes[nameSpanId] >
               sidecar.spanEndBytes[spanId]:
            err = " compiler parser receipt: type syntax name span escaped"
            return false
    let enumRoot = kind == Int32(parser.ParserTypeSyntaxEnum) &&
                   rootKind ==
                       Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs)
    if (!enumRoot && enumVariantCount != 0) ||
       (enumRoot && enumVariantCount <= 0):
        err = " compiler parser receipt: enum variant CSR owner invalid"
        return false
    if enumVariantCount > 0:
        var names = parser.ParserTextLookupInit(enumVariantCount * 2)
        var previousNameToken: int32 = -1
        for variantOffset in 0..<enumVariantCount:
            let variantRow = enumVariantStart + variantOffset
            let producerSource =
                sidecar.typeEnumVariantProducerSourceIds[variantRow]
            let variantOwner =
                sidecar.typeEnumVariantDeclarationOwnerIds[variantRow]
            let variantOwnerToken =
                sidecar.typeEnumVariantDeclarationOwnerTokenIds[variantRow]
            let variantNameToken =
                sidecar.typeEnumVariantNameTokenIds[variantRow]
            let ordinal = sidecar.typeEnumVariantOrdinals[variantRow]
            let payloadType =
                sidecar.typeEnumVariantPayloadTypeSyntaxIds[variantRow]
            if producerSource != sidecar.sourceIndex ||
               variantOwner != row ||
               variantOwnerToken != declarationOwnerToken ||
               variantNameToken < 0 ||
               variantNameToken >= sidecar.tokenKinds.len ||
               variantNameToken <= previousNameToken ||
               sidecar.tokenKinds[variantNameToken] !=
                   Int32(parser.ParserValueTokenIdentifier) ||
               ordinal != variantOffset || payloadType < -1 ||
               payloadType >= typeCount ||
               !parser.ParserTextLookupInsertExact(
                   names, sidecar.tokenValues[variantNameToken]):
                err = " compiler parser receipt: enum variant authority invalid"
                return false
            if payloadType >= 0:
                if scratch.typeChildSeen[payloadType] ||
                   scratch.typeEnumPayloadSeen[payloadType] ||
                   sidecar.typeSyntaxProducerSourceIds[payloadType] !=
                       producerSource ||
                   sidecar.typeSyntaxRootKinds[payloadType] !=
                       Int32(parser.ParserTypeSyntaxRootInvalid) ||
                   sidecar.typeSyntaxDeclarationOwnerIds[payloadType] != -1 ||
                   sidecar.typeSyntaxDeclarationOwnerTokenIds[payloadType] !=
                       -1 ||
                   sidecar.typeSyntaxOwnerTokenIds[payloadType] !=
                       variantNameToken:
                    err = " compiler parser receipt: enum payload authority invalid"
                    return false
                scratch.typeEnumPayloadSeen[payloadType] = true
            previousNameToken = variantNameToken
        scratch.typeEnumVariantCursor = scratch.typeEnumVariantCursor + enumVariantCount
    for childOffset in 0..<childCount:
        let child = sidecar.typeSyntaxChildIds[
            childStart + childOffset]
        if child < 0 || child >= row || scratch.typeChildSeen[child]:
            err = " compiler parser receipt: type syntax child invalid"
            return false
        if kind == Int32(parser.ParserTypeSyntaxAlgebraic) &&
           sidecar.typeSyntaxKinds[child] !=
               Int32(parser.ParserTypeSyntaxVariant):
            err = " compiler parser receipt: algebraic child is not variant"
            return false
        let childSpan = sidecar.typeSyntaxSpanIds[child]
        if sidecar.spanStartBytes[childSpan] <
               sidecar.spanStartBytes[spanId] ||
           sidecar.spanEndBytes[childSpan] >
               sidecar.spanEndBytes[spanId]:
            err = " compiler parser receipt: type syntax child span escaped"
            return false
        let childOwner = sidecar.typeSyntaxOwnerTokenIds[child]
        if childOwner != ownerToken:
            let namedChildParent =
                kind == Int32(parser.ParserTypeSyntaxTuple) ||
                kind == Int32(parser.ParserTypeSyntaxFunction) ||
                kind == Int32(parser.ParserTypeSyntaxVariant)
            if !namedChildParent || childOwner + 2 >= sidecar.tokenKinds.len ||
               sidecar.tokenKinds[childOwner] !=
                   Int32(parser.ParserValueTokenIdentifier) ||
               sidecar.tokenKinds[childOwner + 1] !=
                   Int32(parser.ParserValueTokenColon) ||
               sidecar.spanStartBytes[
                   sidecar.tokenSpanIds[childOwner + 2]] !=
                   sidecar.spanStartBytes[childSpan]:
                err = " compiler parser receipt: named type child owner invalid"
                return false
        scratch.typeChildSeen[child] = true
    scratch.typeChildCursor = scratch.typeChildCursor + childCount
    return parserCanonicalSourceSidecarValidateTypeSyntaxRec(
        sidecar, scratch, row + 1, err)

@borrows
fn parserCanonicalSourceSidecarPayloadStrictValidateInto(
        sidecar: ParserCanonicalSourceSidecar,
        err: var str): bool =
    if sidecar.importOrigins == nil:
        err = " compiler parser receipt: import origin owner unavailable"
        return false
    let importOrigins = sidecar.importOrigins
    let spanCount = sidecar.spanStartBytes.len
    var emptySourceSpanId: int32 = -1
    if sidecar.sourceIndex < 0 ||
       layout.FixedBytes32Equal(sidecar.sourceContentRaw32,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(sidecar.parserInputRaw32,
                                layout.FixedBytes32()) ||
       spanCount != sidecar.spanEndBytes.len ||
       spanCount != sidecar.spanStartLines.len ||
       spanCount != sidecar.spanStartColumns.len ||
       spanCount != sidecar.spanEndLines.len ||
       spanCount != sidecar.spanEndColumns.len:
        err = " compiler parser receipt: canonical sidecar span shape mismatch"
        return false
    if spanCount == 0 &&
       (sidecar.nodeKinds.len > 0 || sidecar.tokenKinds.len > 0 ||
        sidecar.genericSpanIds.len > 0 || sidecar.regionKinds.len > 0 ||
        sidecar.typeSyntaxKinds.len > 0 || sidecar.patternKinds.len > 0 ||
        sidecar.annotationProducerSourceIds.len > 0 ||
        sidecar.annotationArgProducerSourceIds.len > 0 ||
        importOrigins.importDeclarationSourceLocalRows.len > 0 ||
        importOrigins.importItemSourceLocalRows.len > 0):
        err = " compiler parser receipt: semantic rows have no canonical span"
        return false
    for row in 0..<spanCount:
        let exactEmptySourceSpan =
            sidecar.spanStartBytes[row] == 0 &&
            sidecar.spanEndBytes[row] == 0
        if sidecar.spanStartBytes[row] < 0 ||
           sidecar.spanEndBytes[row] < sidecar.spanStartBytes[row] ||
           (sidecar.spanEndBytes[row] == sidecar.spanStartBytes[row] &&
            !exactEmptySourceSpan) ||
           sidecar.spanStartLines[row] < 0 ||
           sidecar.spanStartColumns[row] < 0 ||
           sidecar.spanEndLines[row] < sidecar.spanStartLines[row] ||
           sidecar.spanEndColumns[row] < 0 ||
           (row > 0 &&
            (sidecar.spanStartBytes[row] < sidecar.spanStartBytes[row - 1] ||
             (sidecar.spanStartBytes[row] ==
                  sidecar.spanStartBytes[row - 1] &&
              sidecar.spanEndBytes[row] <= sidecar.spanEndBytes[row - 1]))):
            err = " compiler parser receipt: canonical sidecar span invalid"
            return false
        if exactEmptySourceSpan:
            emptySourceSpanId = row
    let nodeCount = sidecar.nodeKinds.len
    if nodeCount != sidecar.nodeProducerIds.len ||
       nodeCount != sidecar.nodeParentIds.len ||
       nodeCount != sidecar.nodeSpanIds.len ||
       nodeCount != sidecar.nodeChildStarts.len ||
       nodeCount != sidecar.nodeChildCounts.len ||
       nodeCount != sidecar.nodeGenericStarts.len ||
       nodeCount != sidecar.nodeGenericCounts.len ||
       nodeCount != sidecar.nodeBindingResolutionKinds.len ||
       nodeCount !=
           sidecar.nodeBindingDeclarationSourceLocalRows.len ||
       nodeCount != sidecar.nodeBindingPatternSourceLocalRows.len:
        err = " compiler parser receipt: canonical sidecar node shape mismatch"
        return false
    var childCursor: int32
    var childSeen: bool[]
    var genericSeen: bool[]
    var producerSeen: bool[]
    setLen(childSeen, nodeCount)
    setLen(genericSeen, sidecar.genericSpanIds.len)
    setLen(producerSeen, nodeCount)
    for row in 0..<nodeCount:
        let producerNodeId = sidecar.nodeProducerIds[row]
        let parent = sidecar.nodeParentIds[row]
        let childStart = sidecar.nodeChildStarts[row]
        let childCount = sidecar.nodeChildCounts[row]
        let genericStart = sidecar.nodeGenericStarts[row]
        let genericCount = sidecar.nodeGenericCounts[row]
        let bindingResolutionKind =
            sidecar.nodeBindingResolutionKinds[row]
        let bindingDeclarationSourceLocalRow =
            sidecar.nodeBindingDeclarationSourceLocalRows[row]
        let bindingPatternSourceLocalRow =
            sidecar.nodeBindingPatternSourceLocalRows[row]
        if producerNodeId < 0 || producerNodeId >= nodeCount ||
           producerSeen[producerNodeId] ||
           sidecar.nodeKinds[row] <= 0 || sidecar.nodeSpanIds[row] < 0 ||
           sidecar.nodeSpanIds[row] >= spanCount ||
           (parent != -1 && (parent < 0 || parent >= row)) ||
           childStart != childCursor || childCount < 0 ||
           childStart + childCount > sidecar.nodeChildIds.len ||
           genericStart < 0 || genericCount < 0 ||
           genericStart + genericCount > sidecar.genericSpanIds.len:
            err = " compiler parser receipt: canonical sidecar node invalid"
            return false
        let bindingAbsent =
            bindingResolutionKind ==
                Int32(parser.ParserValueExprBindingResolutionNone) &&
            bindingDeclarationSourceLocalRow == -1 &&
            bindingPatternSourceLocalRow == -1
        if bindingResolutionKind <
               Int32(parser.ParserValueExprBindingResolutionNone) ||
           bindingResolutionKind >
               Int32(parser.ParserValueExprBindingResolutionPattern) ||
           (bindingResolutionKind ==
                Int32(parser.ParserValueExprBindingResolutionNone) &&
            !bindingAbsent) ||
           (!bindingAbsent &&
            sidecar.nodeKinds[row] !=
                Int32(parser.ParserValueExprIdentifier)) ||
           (bindingResolutionKind ==
                Int32(parser.ParserValueExprBindingResolutionParameter) &&
            (bindingDeclarationSourceLocalRow < 0 ||
             bindingDeclarationSourceLocalRow >=
                 sidecar.declarationKinds.len ||
             sidecar.declarationKinds[
                 bindingDeclarationSourceLocalRow] !=
                 Int32(parser.ParserDeclarationParameter) ||
             bindingPatternSourceLocalRow != -1)) ||
           (bindingResolutionKind ==
                Int32(parser.ParserValueExprBindingResolutionPattern) &&
            (bindingDeclarationSourceLocalRow < 0 ||
             bindingDeclarationSourceLocalRow >=
                 sidecar.declarationKinds.len ||
             sidecar.declarationKinds[
                 bindingDeclarationSourceLocalRow] !=
                 Int32(parser.ParserDeclarationLocal) ||
             bindingPatternSourceLocalRow < 0 ||
             bindingPatternSourceLocalRow >=
                 sidecar.patternBindingDeclarationIds.len ||
             sidecar.patternBindingDeclarationIds[
                 bindingPatternSourceLocalRow] !=
                 bindingDeclarationSourceLocalRow)):
            err = " compiler parser receipt: canonical node binding authority invalid"
            return false
        producerSeen[producerNodeId] = true
        for offset in 0..<childCount:
            let child = sidecar.nodeChildIds[childStart + offset]
            if child <= row || child >= nodeCount ||
               childSeen[child] || sidecar.nodeParentIds[child] != row ||
               (offset > 0 &&
                child <= sidecar.nodeChildIds[childStart + offset - 1]):
                err = " compiler parser receipt: canonical sidecar child invalid"
                return false
            childSeen[child] = true
        for offset in 0..<genericCount:
            let genericRow = genericStart + offset
            if genericSeen[genericRow]:
                err = " compiler parser receipt: canonical generic owner duplicate"
                return false
            genericSeen[genericRow] = true
        childCursor = childCursor + childCount
    if childCursor != sidecar.nodeChildIds.len ||
       sidecar.tokenKinds.len != sidecar.tokenProducerSourceIds.len ||
       sidecar.tokenKinds.len != sidecar.tokenSourceLocalRows.len ||
       sidecar.tokenKinds.len != sidecar.tokenLexicalParentIds.len ||
       sidecar.tokenKinds.len != sidecar.tokenSpanIds.len ||
       sidecar.tokenKinds.len != sidecar.tokenValues.len:
        err = " compiler parser receipt: canonical sidecar token shape mismatch"
        return false
    for row in 0..<nodeCount:
        if childSeen[row] != (sidecar.nodeParentIds[row] >= 0):
            err = " compiler parser receipt: canonical child coverage mismatch"
            return false
    for row in 0..<genericSeen.len:
        if !genericSeen[row]:
            err = " compiler parser receipt: canonical generic coverage mismatch"
            return false
    let normalizedExprCount =
        sidecar.normalizedExprParserNodeIds.len
    if normalizedExprCount !=
           sidecar.normalizedExprProducerSourceIds.len ||
       normalizedExprCount !=
           sidecar.normalizedExprSourceLocalRows.len ||
       normalizedExprCount !=
           sidecar.normalizedExprFunctionIndexes.len ||
       normalizedExprCount != sidecar.normalizedExprKinds.len ||
       normalizedExprCount !=
           sidecar.normalizedExprStatementRoles.len:
        err = " compiler parser receipt: normalized expression identity shape mismatch"
        return false
    for row in 0..<normalizedExprCount:
        let parserNodeId =
            sidecar.normalizedExprParserNodeIds[row]
        let statementRole =
            sidecar.normalizedExprStatementRoles[row]
        if sidecar.normalizedExprProducerSourceIds[row] !=
               sidecar.sourceIndex ||
           sidecar.normalizedExprSourceLocalRows[row] != row ||
           sidecar.normalizedExprFunctionIndexes[row] < 0 ||
           parserNodeId < 0 || parserNodeId >= nodeCount ||
           sidecar.normalizedExprKinds[row] <= 0 ||
           statementRole < Int32(
               parser.ParserValueExprStatementInvalid) ||
           statementRole > Int32(
               parser.ParserValueExprStatementCaseGuard):
            err = " compiler parser receipt: normalized expression identity invalid"
            return false
        for previous in 0..<row:
            if sidecar.normalizedExprProducerSourceIds[previous] ==
                   sidecar.normalizedExprProducerSourceIds[row] &&
               sidecar.normalizedExprFunctionIndexes[previous] ==
                   sidecar.normalizedExprFunctionIndexes[row] &&
               sidecar.normalizedExprParserNodeIds[previous] ==
                   parserNodeId &&
               sidecar.normalizedExprKinds[previous] ==
                   sidecar.normalizedExprKinds[row] &&
               sidecar.normalizedExprStatementRoles[previous] ==
                   statementRole:
                err = " compiler parser receipt: duplicate normalized expression identity"
                return false
    var previousRootEndByte: int32 = -1
    var previousChildEndBytes: int32[]
    setLen(previousChildEndBytes, sidecar.tokenKinds.len)
    for row in 0..<previousChildEndBytes.len:
        previousChildEndBytes[row] = -1
    for row in 0..<sidecar.tokenKinds.len:
        let spanId = sidecar.tokenSpanIds[row]
        let parent = sidecar.tokenLexicalParentIds[row]
        if sidecar.tokenProducerSourceIds[row] != sidecar.sourceIndex ||
           sidecar.tokenSourceLocalRows[row] != row ||
           sidecar.tokenKinds[row] <= 0 || sidecar.tokenValues[row] == "" ||
           spanId < 0 || spanId >= spanCount ||
           parent < -1 || parent >= row:
            err = Fmt" compiler parser receipt: canonical sidecar token identity invalid row={row} parent={parent}"
            return false
        let startByte = sidecar.spanStartBytes[spanId]
        let endByte = sidecar.spanEndBytes[spanId]
        if parent == -1:
            if startByte < previousRootEndByte:
                err = Fmt" compiler parser receipt: canonical primary token order invalid row={row} start={startByte} previous_end={previousRootEndByte}"
                return false
            previousRootEndByte = endByte
            continue
        let parentSpanId = sidecar.tokenSpanIds[parent]
        if parentSpanId < 0 || parentSpanId >= spanCount ||
           sidecar.tokenKinds[parent] !=
               Int32(parser.ParserValueTokenFmtString) ||
           startByte <= sidecar.spanStartBytes[parentSpanId] ||
           endByte >= sidecar.spanEndBytes[parentSpanId] ||
           startByte < previousChildEndBytes[parent]:
            err = Fmt" compiler parser receipt: canonical interpolation token parent invalid row={row} parent={parent} start={startByte} end={endByte}"
            return false
        previousChildEndBytes[parent] = endByte
    let importDeclarationCount =
        importOrigins.importDeclarationSourceLocalRows.len
    let importItemCount = importOrigins.importItemSourceLocalRows.len
    if importDeclarationCount !=
           importOrigins.importDeclarationProducerSourceIds.len ||
       importDeclarationCount !=
           importOrigins.importDeclarationKeywordTokenIds.len ||
       importDeclarationCount != importOrigins.importDeclarationSpanIds.len ||
       importDeclarationCount !=
           importOrigins.importDeclarationItemStarts.len ||
       importDeclarationCount !=
           importOrigins.importDeclarationItemCounts.len ||
       importItemCount != importOrigins.importItemProducerSourceIds.len ||
       importItemCount != importOrigins.importItemDeclarationIds.len ||
       importItemCount != importOrigins.importItemAliasTokenIds.len ||
       importItemCount != importOrigins.importItemSpanIds.len ||
       importItemCount != importOrigins.importItemModuleTokenStarts.len ||
       importItemCount != importOrigins.importItemModuleTokenCounts.len ||
       importItemCount != importOrigins.importItemPrefixTokenCounts.len:
        err = " compiler parser receipt: import origin column shape mismatch"
        return false
    var importItemCursor: int32
    for declarationRow in 0..<importDeclarationCount:
        let keywordToken =
            importOrigins.importDeclarationKeywordTokenIds[declarationRow]
        let spanId = importOrigins.importDeclarationSpanIds[declarationRow]
        let itemStart =
            importOrigins.importDeclarationItemStarts[declarationRow]
        let itemCount =
            importOrigins.importDeclarationItemCounts[declarationRow]
        if importOrigins.importDeclarationProducerSourceIds[declarationRow] !=
               sidecar.sourceIndex ||
           importOrigins.importDeclarationSourceLocalRows[declarationRow] !=
               declarationRow ||
           keywordToken < 0 || keywordToken >= sidecar.tokenKinds.len ||
           sidecar.tokenKinds[keywordToken] !=
               Int32(parser.ParserValueTokenImport) ||
           sidecar.tokenValues[keywordToken] != "import" ||
           spanId < 0 || spanId >= spanCount ||
           sidecar.spanStartBytes[spanId] !=
               sidecar.spanStartBytes[
                   sidecar.tokenSpanIds[keywordToken]] ||
           itemStart != importItemCursor || itemCount <= 0 ||
           itemStart > importItemCount - itemCount:
            err = " compiler parser receipt: import declaration invalid"
            return false
        importItemCursor = itemStart + itemCount
    if importItemCursor != importItemCount:
        err = " compiler parser receipt: import item CSR incomplete"
        return false
    var importModuleTokenCursor: int32
    for itemRow in 0..<importItemCount:
        let declarationRow = importOrigins.importItemDeclarationIds[itemRow]
        let aliasToken = importOrigins.importItemAliasTokenIds[itemRow]
        let spanId = importOrigins.importItemSpanIds[itemRow]
        let tokenStart = importOrigins.importItemModuleTokenStarts[itemRow]
        let tokenCount = importOrigins.importItemModuleTokenCounts[itemRow]
        let prefixTokenCount =
            importOrigins.importItemPrefixTokenCounts[itemRow]
        if importOrigins.importItemProducerSourceIds[itemRow] !=
               sidecar.sourceIndex ||
           importOrigins.importItemSourceLocalRows[itemRow] != itemRow ||
           declarationRow < 0 ||
           declarationRow >= importDeclarationCount ||
           spanId < 0 || spanId >= spanCount ||
           aliasToken < -1 || aliasToken >= sidecar.tokenKinds.len ||
           (aliasToken >= 0 &&
            (sidecar.tokenProducerSourceIds[aliasToken] !=
                 sidecar.sourceIndex ||
             !parser.ParserValueExprTokenCanName(
                 parser.ParserValueTokenKind(
                     sidecar.tokenKinds[aliasToken])) ||
             sidecar.tokenValues[aliasToken] == "" ||
             aliasToken <= 0 ||
             sidecar.tokenKinds[aliasToken - 1] !=
                 Int32(parser.ParserValueTokenIdentifier) ||
             sidecar.tokenValues[aliasToken - 1] != "as" ||
             sidecar.spanEndBytes[spanId] !=
                 sidecar.spanEndBytes[
                     sidecar.tokenSpanIds[aliasToken]])) ||
           sidecar.spanStartBytes[spanId] <
               sidecar.spanStartBytes[
                   importOrigins.importDeclarationSpanIds[declarationRow]] ||
           sidecar.spanEndBytes[spanId] >
               sidecar.spanEndBytes[
                   importOrigins.importDeclarationSpanIds[declarationRow]] ||
           tokenStart != importModuleTokenCursor || tokenCount <= 0 ||
           prefixTokenCount < 0 || prefixTokenCount >= tokenCount ||
           tokenStart > importOrigins.importModuleTokenIds.len - tokenCount:
            err = " compiler parser receipt: import item invalid"
            return false
        for tokenOffset in 0..<tokenCount:
            let tokenId =
                importOrigins.importModuleTokenIds[tokenStart + tokenOffset]
            if tokenId < 0 || tokenId >= sidecar.tokenKinds.len ||
               sidecar.tokenProducerSourceIds[tokenId] !=
                   sidecar.sourceIndex ||
               !parser.ParserValueExprTokenCanName(
                   parser.ParserValueTokenKind(
                       sidecar.tokenKinds[tokenId])) ||
               sidecar.tokenValues[tokenId] == "":
                err = " compiler parser receipt: import module token invalid"
                return false
        let lastModuleToken =
            importOrigins.importModuleTokenIds[
                tokenStart + tokenCount - 1]
        let keywordToken =
            importOrigins.importDeclarationKeywordTokenIds[declarationRow]
        let declarationItemStart =
            importOrigins.importDeclarationItemStarts[declarationRow]
        let declarationItemCount =
            importOrigins.importDeclarationItemCounts[declarationRow]
        let itemOffset = itemRow - declarationItemStart
        if itemOffset < 0 || itemOffset >= declarationItemCount:
            err = " compiler parser receipt: import item declaration CSR mismatch"
            return false
        let firstModuleToken =
            importOrigins.importModuleTokenIds[tokenStart]
        let firstSuffixToken =
            importOrigins.importModuleTokenIds[
                tokenStart + prefixTokenCount]
        for moduleOffset in 1..<tokenCount:
            if moduleOffset == prefixTokenCount:
                continue
            let previousToken =
                importOrigins.importModuleTokenIds[
                    tokenStart + moduleOffset - 1]
            let nextToken =
                importOrigins.importModuleTokenIds[
                    tokenStart + moduleOffset]
            if nextToken != previousToken + 2 ||
               previousToken + 1 >= sidecar.tokenKinds.len ||
               sidecar.tokenKinds[previousToken + 1] !=
                   Int32(parser.ParserValueTokenSlash) ||
               sidecar.tokenValues[previousToken + 1] != "/":
                err = " compiler parser receipt: import module adjacency invalid"
                return false
        if prefixTokenCount == 0:
            if declarationItemCount != 1 || itemOffset != 0 ||
               firstModuleToken != keywordToken + 1 ||
               sidecar.spanStartBytes[spanId] !=
                   sidecar.spanStartBytes[
                       sidecar.tokenSpanIds[firstModuleToken]] ||
               ((aliasToken < 0 &&
                 (sidecar.spanEndBytes[spanId] !=
                      sidecar.spanEndBytes[
                          sidecar.tokenSpanIds[lastModuleToken]] ||
                  sidecar.spanEndBytes[
                      importOrigins.importDeclarationSpanIds[declarationRow]] !=
                      sidecar.spanEndBytes[spanId])) ||
                (aliasToken >= 0 &&
                 (aliasToken != lastModuleToken + 2 ||
                  sidecar.tokenValues[lastModuleToken + 1] != "as" ||
                  sidecar.spanEndBytes[
                      importOrigins.importDeclarationSpanIds[declarationRow]] !=
                      sidecar.spanEndBytes[spanId]))):
                err = " compiler parser receipt: simple import replay failed"
                return false
        else:
            let lastPrefixToken =
                importOrigins.importModuleTokenIds[
                    tokenStart + prefixTokenCount - 1]
            if aliasToken != -1 ||
               firstModuleToken != keywordToken + 1 ||
               (itemOffset == 0 &&
                (lastPrefixToken + 3 != firstSuffixToken ||
                 lastPrefixToken + 2 >= sidecar.tokenKinds.len ||
                 sidecar.tokenKinds[lastPrefixToken + 1] !=
                     Int32(parser.ParserValueTokenSlash) ||
                 sidecar.tokenValues[lastPrefixToken + 1] != "/" ||
                 sidecar.tokenKinds[lastPrefixToken + 2] !=
                     Int32(parser.ParserValueTokenLeftBracket) ||
                 sidecar.tokenValues[lastPrefixToken + 2] != "[")) ||
               sidecar.spanStartBytes[spanId] !=
                   sidecar.spanStartBytes[
                       sidecar.tokenSpanIds[firstSuffixToken]] ||
               sidecar.spanEndBytes[spanId] !=
                   sidecar.spanEndBytes[
                       sidecar.tokenSpanIds[lastModuleToken]]:
                err = " compiler parser receipt: grouped import replay failed"
                return false
            if itemOffset > 0:
                let previousTokenStart =
                    importOrigins.importItemModuleTokenStarts[itemRow - 1]
                let previousTokenCount =
                    importOrigins.importItemModuleTokenCounts[itemRow - 1]
                let previousLastToken =
                    importOrigins.importModuleTokenIds[
                        previousTokenStart + previousTokenCount - 1]
                if firstSuffixToken != previousLastToken + 2 ||
                   previousLastToken + 1 >= sidecar.tokenKinds.len ||
                   sidecar.tokenKinds[previousLastToken + 1] !=
                       Int32(parser.ParserValueTokenComma) ||
                   sidecar.tokenValues[previousLastToken + 1] != ",":
                    err = " compiler parser receipt: grouped item boundary invalid"
                    return false
                for prefixOffset in 0..<prefixTokenCount:
                    if importOrigins.importModuleTokenIds[
                           tokenStart + prefixOffset] !=
                       importOrigins.importModuleTokenIds[
                           previousTokenStart + prefixOffset]:
                        err = " compiler parser receipt: grouped prefix drift"
                        return false
            if itemOffset + 1 == declarationItemCount:
                if lastModuleToken + 1 >= sidecar.tokenKinds.len ||
                   sidecar.tokenKinds[lastModuleToken + 1] !=
                       Int32(parser.ParserValueTokenRightBracket) ||
                   sidecar.tokenValues[lastModuleToken + 1] != "]" ||
                   sidecar.spanEndBytes[
                       importOrigins.importDeclarationSpanIds[declarationRow]] !=
                       sidecar.spanEndBytes[
                           sidecar.tokenSpanIds[lastModuleToken + 1]]:
                    err = " compiler parser receipt: grouped close boundary invalid"
                    return false
            elif lastModuleToken + 1 >= sidecar.tokenKinds.len ||
                 sidecar.tokenKinds[lastModuleToken + 1] !=
                     Int32(parser.ParserValueTokenComma) ||
                 sidecar.tokenValues[lastModuleToken + 1] != ",":
                err = " compiler parser receipt: grouped separator missing"
                return false
        importModuleTokenCursor = tokenStart + tokenCount
    if importModuleTokenCursor != importOrigins.importModuleTokenIds.len:
        err = " compiler parser receipt: import module token CSR incomplete"
        return false
    let declarationCount = sidecar.declarationKinds.len
    let lexicalScopeCount = sidecar.declarationLexicalScopeKinds.len
    if lexicalScopeCount <= 0 ||
       lexicalScopeCount !=
           sidecar.declarationLexicalScopeProducerSourceIds.len ||
       lexicalScopeCount !=
           sidecar.declarationLexicalScopeSourceLocalRows.len ||
       lexicalScopeCount != sidecar.declarationLexicalScopeParentIds.len ||
       lexicalScopeCount !=
           sidecar.declarationLexicalScopeOwnerDeclarationIds.len ||
       lexicalScopeCount !=
           sidecar.declarationLexicalScopeSpanIds.len:
        err = " compiler parser receipt: lexical scope shape mismatch"
        return false
    var sourceScopeCount: int32
    var sourceScopeSpanId: int32 = -1
    for scopeRow in 0..<lexicalScopeCount:
        let parent = sidecar.declarationLexicalScopeParentIds[scopeRow]
        let owner =
            sidecar.declarationLexicalScopeOwnerDeclarationIds[scopeRow]
        let kind = sidecar.declarationLexicalScopeKinds[scopeRow]
        let spanId = sidecar.declarationLexicalScopeSpanIds[scopeRow]
        if sidecar.declarationLexicalScopeProducerSourceIds[scopeRow] !=
               sidecar.sourceIndex ||
           sidecar.declarationLexicalScopeSourceLocalRows[scopeRow] !=
               scopeRow ||
           kind < Int32(parser.ParserDeclarationLexicalScopeSource) ||
           kind > Int32(parser.ParserDeclarationLexicalScopeBlock) ||
           parent < -1 || parent >= scopeRow || owner < -1 ||
           owner >= declarationCount ||
           spanId < 0 || spanId >= spanCount ||
           (kind == Int32(parser.ParserDeclarationLexicalScopeSource) &&
            (parent != -1 || owner != -1 ||
             sidecar.spanStartBytes[spanId] != 0)) ||
           (sidecar.spanStartBytes[spanId] ==
                sidecar.spanEndBytes[spanId] &&
            kind != Int32(parser.ParserDeclarationLexicalScopeSource)):
            err = " compiler parser receipt: lexical scope row invalid"
            return false
        if kind == Int32(parser.ParserDeclarationLexicalScopeSource):
            sourceScopeCount = sourceScopeCount + 1
            sourceScopeSpanId = spanId
        if parent >= 0:
            let parentSpanId =
                sidecar.declarationLexicalScopeSpanIds[parent]
            if sidecar.declarationLexicalScopeProducerSourceIds[parent] !=
                   sidecar.declarationLexicalScopeProducerSourceIds[scopeRow] ||
               sidecar.spanStartBytes[parentSpanId] >
                   sidecar.spanStartBytes[spanId] ||
               sidecar.spanEndBytes[parentSpanId] <
                   sidecar.spanEndBytes[spanId]:
                err = " compiler parser receipt: lexical scope parent span mismatch"
                return false
    if sourceScopeCount != 1 ||
       (emptySourceSpanId >= 0 &&
        sourceScopeSpanId != emptySourceSpanId):
        err = " compiler parser receipt: source lexical scope span invalid"
        return false
    if declarationCount != sidecar.declarationProducerSourceIds.len ||
       declarationCount != sidecar.declarationSourceLocalRows.len ||
       declarationCount != sidecar.declarationNameTokenIds.len ||
       declarationCount != sidecar.declarationOwnerIds.len ||
       declarationCount != sidecar.declarationLexicalScopeIds.len ||
       declarationCount != sidecar.declarationFunctionRows.len ||
       declarationCount != sidecar.declarationTypeSyntaxRootIds.len ||
       declarationCount !=
           sidecar.declarationDefaultStatementRootRows.len ||
       declarationCount != sidecar.declarationGenericSymbolStarts.len ||
       declarationCount != sidecar.declarationGenericSymbolCounts.len ||
       declarationCount != sidecar.declarationSuiteLexicalScopeIds.len ||
       declarationCount != sidecar.declarationSpanIds.len ||
       declarationCount != sidecar.declarationNameSpanIds.len ||
       declarationCount != sidecar.declarationMutableFlags.len ||
       declarationCount != sidecar.declarationExportedFlags.len:
        err = " compiler parser receipt: declaration shape mismatch"
        return false
    # `functionIndexes` is the executable-function receipt domain and excludes
    # importc declarations. `declarationFunctionRows` is the parser declaration
    # domain and includes every function declaration. Reconstruct that exact
    # dense domain from the immutable declaration-kind column; never use the
    # executable subset as its bound.
    var declarationFunctionCount: int32
    for row in 0..<declarationCount:
        if sidecar.declarationKinds[row] ==
               Int32(parser.ParserDeclarationFunction):
            declarationFunctionCount = declarationFunctionCount + 1
    var functionDeclarationSeen: bool[]
    setLen(functionDeclarationSeen, declarationFunctionCount)
    for row in 0..<declarationCount:
        let kind = sidecar.declarationKinds[row]
        let nameToken = sidecar.declarationNameTokenIds[row]
        let owner = sidecar.declarationOwnerIds[row]
        let scope = sidecar.declarationLexicalScopeIds[row]
        let functionRow = sidecar.declarationFunctionRows[row]
        let typeRoot = sidecar.declarationTypeSyntaxRootIds[row]
        let defaultStatementRoot =
            sidecar.declarationDefaultStatementRootRows[row]
        let genericStart =
            sidecar.declarationGenericSymbolStarts[row]
        let genericCount =
            sidecar.declarationGenericSymbolCounts[row]
        let suiteScope =
            sidecar.declarationSuiteLexicalScopeIds[row]
        let spanId = sidecar.declarationSpanIds[row]
        let nameSpanId = sidecar.declarationNameSpanIds[row]
        let lexicalScopeSpanId =
            scope >= 0 && scope < lexicalScopeCount ?
                sidecar.declarationLexicalScopeSpanIds[scope] : -1
        if sidecar.declarationProducerSourceIds[row] !=
               sidecar.sourceIndex ||
           sidecar.declarationSourceLocalRows[row] != row ||
           kind < Int32(parser.ParserDeclarationModule) ||
           kind > Int32(parser.ParserDeclarationTrait) ||
           nameToken < 0 || nameToken >= sidecar.tokenKinds.len ||
           owner < -1 || owner >= row || scope < 0 ||
           scope >= lexicalScopeCount ||
           sidecar.declarationLexicalScopeProducerSourceIds[scope] !=
               sidecar.declarationProducerSourceIds[row] ||
           functionRow < -1 || functionRow >= declarationFunctionCount ||
           typeRoot < -1 || typeRoot >= sidecar.typeSyntaxKinds.len ||
           defaultStatementRoot < -1 ||
           defaultStatementRoot >= sidecar.statementRootNodeIds.len ||
           (kind != Int32(parser.ParserDeclarationParameter) &&
            defaultStatementRoot != -1) ||
           genericStart < -1 || genericCount < 0 ||
           (genericCount == 0 && genericStart != -1) ||
           (genericCount > 0 &&
            (genericStart < 0 ||
             genericStart >
                 sidecar.typeGenericSymbolNameTokenIds.len -
                     genericCount)) ||
           suiteScope < -1 || suiteScope >= lexicalScopeCount ||
           spanId < 0 || spanId >= spanCount ||
           nameSpanId < 0 || nameSpanId >= spanCount ||
           lexicalScopeSpanId < 0 ||
           lexicalScopeSpanId >= spanCount ||
           sidecar.spanStartBytes[lexicalScopeSpanId] >
               sidecar.spanStartBytes[spanId] ||
           sidecar.spanEndBytes[lexicalScopeSpanId] <
               sidecar.spanEndBytes[spanId] ||
           sidecar.tokenSpanIds[nameToken] != nameSpanId ||
           sidecar.spanStartBytes[nameSpanId] <
               sidecar.spanStartBytes[spanId] ||
           sidecar.spanEndBytes[nameSpanId] >
               sidecar.spanEndBytes[spanId]:
            var nameTokenSpanId: int32 = -1
            if nameToken >= 0 && nameToken < sidecar.tokenSpanIds.len:
                nameTokenSpanId = sidecar.tokenSpanIds[nameToken]
            err = Fmt" compiler parser receipt: declaration row invalid row={row} source={sidecar.sourceIndex} producer={sidecar.declarationProducerSourceIds[row]} local={sidecar.declarationSourceLocalRows[row]} kind={kind} name_token={nameToken} name_token_span={nameTokenSpanId} owner={owner} scope={scope} scope_count={lexicalScopeCount} function={functionRow} declaration_function_count={declarationFunctionCount} executable_function_count={sidecar.functionIndexes.len} type_root={typeRoot} default_root={defaultStatementRoot} generic={genericStart}+{genericCount} suite_scope={suiteScope} type_count={sidecar.typeSyntaxKinds.len} span={spanId} name_span={nameSpanId} span_count={spanCount}"
            return false
        let ownerKind = owner < 0 ?
            Int32(parser.ParserDeclarationInvalid) :
            sidecar.declarationKinds[owner]
        if (kind == Int32(parser.ParserDeclarationModule) &&
            (owner != -1 || functionRow != -1 ||
             typeRoot != -1 || sidecar.declarationMutableFlags[row])) ||
           (kind == Int32(parser.ParserDeclarationType) &&
            (typeRoot < 0 ||
             (owner >= 0 &&
              ownerKind != Int32(parser.ParserDeclarationModule) &&
              ownerKind != Int32(parser.ParserDeclarationType) &&
              ownerKind != Int32(parser.ParserDeclarationFunction) &&
              ownerKind != Int32(parser.ParserDeclarationConcept) &&
              ownerKind != Int32(parser.ParserDeclarationTrait)))) ||
           (kind == Int32(parser.ParserDeclarationFunction) &&
            (functionRow < 0 ||
             (owner >= 0 &&
              ownerKind != Int32(parser.ParserDeclarationModule) &&
              ownerKind != Int32(parser.ParserDeclarationType) &&
              ownerKind != Int32(parser.ParserDeclarationFunction) &&
              ownerKind != Int32(parser.ParserDeclarationConcept) &&
              ownerKind != Int32(parser.ParserDeclarationTrait)))) ||
           (kind == Int32(parser.ParserDeclarationField) &&
            (owner < 0 ||
             ownerKind != Int32(parser.ParserDeclarationType) ||
             functionRow != -1 || typeRoot < 0)) ||
           (kind == Int32(parser.ParserDeclarationParameter) &&
            (owner < 0 ||
             ownerKind != Int32(parser.ParserDeclarationFunction) ||
             functionRow < 0)) ||
           (kind == Int32(parser.ParserDeclarationLocal) &&
            ((functionRow >= 0 &&
              (owner < 0 ||
               ownerKind != Int32(parser.ParserDeclarationFunction))) ||
             (functionRow < 0 && owner >= 0 &&
              ownerKind != Int32(parser.ParserDeclarationModule) &&
              ownerKind != Int32(parser.ParserDeclarationType) &&
              ownerKind != Int32(parser.ParserDeclarationConcept) &&
              ownerKind != Int32(parser.ParserDeclarationTrait)))) ||
           ((kind == Int32(parser.ParserDeclarationConcept) ||
             kind == Int32(parser.ParserDeclarationTrait)) &&
            (functionRow != -1 || typeRoot != -1 ||
             sidecar.declarationMutableFlags[row] ||
             (owner >= 0 &&
              ownerKind != Int32(parser.ParserDeclarationModule) &&
              ownerKind != Int32(parser.ParserDeclarationType) &&
              ownerKind != Int32(parser.ParserDeclarationFunction) &&
              ownerKind != Int32(parser.ParserDeclarationConcept) &&
              ownerKind != Int32(parser.ParserDeclarationTrait)))):
            err = " compiler parser receipt: declaration owner invalid"
            return false
        let functionDeclaration =
            kind == Int32(parser.ParserDeclarationFunction)
        let conceptTraitDeclaration =
            kind == Int32(parser.ParserDeclarationConcept) ||
            kind == Int32(parser.ParserDeclarationTrait)
        if functionDeclaration && suiteScope >= 0:
            if sidecar.declarationLexicalScopeOwnerDeclarationIds[
                   suiteScope] != row ||
               sidecar.declarationLexicalScopeKinds[suiteScope] !=
                   Int32(
                       parser.ParserDeclarationLexicalScopeFunction):
                err =
                    " compiler parser receipt: function suite owner invalid"
                return false
        elif conceptTraitDeclaration:
            if suiteScope < 0 ||
               sidecar.declarationLexicalScopeOwnerDeclarationIds[
                   suiteScope] != row ||
               sidecar.declarationLexicalScopeKinds[suiteScope] !=
                   Int32(parser.ParserDeclarationLexicalScopeBlock):
                err = " compiler parser receipt: concept/trait suite owner invalid"
                return false
        elif suiteScope != -1:
            err =
                " compiler parser receipt: non-suite declaration edge invalid"
            return false
        if genericCount > 0:
            if kind != Int32(parser.ParserDeclarationType) &&
               kind != Int32(parser.ParserDeclarationFunction) &&
               kind != Int32(parser.ParserDeclarationConcept) &&
               kind != Int32(parser.ParserDeclarationTrait):
                err = " compiler parser receipt: generic declaration kind invalid"
                return false
            for genericOffset in 0..<genericCount:
                let genericRow = genericStart + genericOffset
                if sidecar.typeGenericSymbolOwnerDeclarationIds[
                       genericRow] != row ||
                   sidecar.typeGenericSymbolOrdinals[genericRow] !=
                       genericOffset:
                    err = " compiler parser receipt: declaration generic CSR invalid"
                    return false
        if kind == Int32(parser.ParserDeclarationFunction):
            if functionDeclarationSeen[functionRow]:
                err = " compiler parser receipt: duplicate function declaration"
                return false
            functionDeclarationSeen[functionRow] = true
    for functionRow in 0..<functionDeclarationSeen.len:
        if !functionDeclarationSeen[functionRow]:
            err = " compiler parser receipt: function declaration missing"
            return false
    for scopeRow in 0..<lexicalScopeCount:
        let owner =
            sidecar.declarationLexicalScopeOwnerDeclarationIds[scopeRow]
        if owner >= 0:
            let scopeSpanId =
                sidecar.declarationLexicalScopeSpanIds[scopeRow]
            let ownerSpanId = sidecar.declarationSpanIds[owner]
            if sidecar.declarationProducerSourceIds[owner] !=
                   sidecar.declarationLexicalScopeProducerSourceIds[
                       scopeRow] ||
               sidecar.spanStartBytes[ownerSpanId] >
                   sidecar.spanStartBytes[scopeSpanId] ||
               sidecar.spanEndBytes[ownerSpanId] <
                   sidecar.spanEndBytes[scopeSpanId]:
                err = " compiler parser receipt: lexical scope owner span mismatch"
                return false
    let patternCount = sidecar.patternKinds.len
    if patternCount != sidecar.patternProducerSourceIds.len ||
       patternCount != sidecar.patternSourceLocalRows.len ||
       patternCount != sidecar.patternNameTokenIds.len ||
       patternCount != sidecar.patternOwnerLexicalScopeIds.len ||
       patternCount != sidecar.patternOwnerKinds.len ||
       patternCount != sidecar.patternOwnerRows.len ||
       patternCount != sidecar.patternBindingDeclarationIds.len ||
       patternCount != sidecar.patternTypeSyntaxRootIds.len ||
       patternCount != sidecar.patternSpanIds.len ||
       patternCount != sidecar.patternChildStarts.len ||
       patternCount != sidecar.patternChildCounts.len:
        err = " compiler parser receipt: pattern shape mismatch"
        return false
    var patternChildSeen: bool[]
    var patternParentRows: int32[]
    setLen(patternChildSeen, patternCount)
    setLen(patternParentRows, patternCount)
    for row in 0..<patternCount:
        patternParentRows[row] = -1
    var patternChildCursor: int32
    for row in 0..<patternCount:
        let kind = sidecar.patternKinds[row]
        let nameToken = sidecar.patternNameTokenIds[row]
        let scope = sidecar.patternOwnerLexicalScopeIds[row]
        let ownerKind = sidecar.patternOwnerKinds[row]
        let ownerRow = sidecar.patternOwnerRows[row]
        let declaration = sidecar.patternBindingDeclarationIds[row]
