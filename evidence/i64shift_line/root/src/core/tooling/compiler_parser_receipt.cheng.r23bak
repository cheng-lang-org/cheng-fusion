                   declarationOwnerToken ||
               sidecar.typeSyntaxDeclarationOwnerIds[child] != -1 ||
               sidecar.spanStartBytes[
                   sidecar.typeSyntaxSpanIds[child]] <
                   sidecar.spanStartBytes[spanId] ||
               sidecar.spanEndBytes[
                   sidecar.typeSyntaxSpanIds[child]] >
                   sidecar.spanEndBytes[spanId]:
                err = " compiler parser receipt: generic child CSR invalid"
                return false
            genericTypeChildSeen[child] = true
        genericChildCursor = genericChildCursor + childCount
        previousGenericOwnerToken = declarationOwnerToken
        previousGenericOrdinal = ordinal
        previousGenericEndToken = spanEndToken
    if genericChildCursor !=
           sidecar.typeGenericSymbolChildTypeSyntaxIds.len:
        err = " compiler parser receipt: generic child coverage mismatch"
        return false
    if previousGenericOrdinal >= 0 &&
       (previousGenericEndToken + 1 >= sidecar.tokenKinds.len ||
        sidecar.tokenKinds[previousGenericEndToken + 1] !=
            Int32(parser.ParserValueTokenRightBracket)):
        err = " compiler parser receipt: generic declaration close missing"
        return false
    var genericSymbolReferenced: bool[]
    setLen(genericSymbolReferenced,
           sidecar.typeGenericSymbolNameTokenIds.len)
    for declarationRow in 0..<declarationCount:
        let genericStart =
            sidecar.declarationGenericSymbolStarts[declarationRow]
        let genericCount =
            sidecar.declarationGenericSymbolCounts[declarationRow]
        for genericOffset in 0..<genericCount:
            let symbolRow = genericStart + genericOffset
            if symbolRow < 0 ||
               symbolRow >= genericSymbolReferenced.len ||
               genericSymbolReferenced[symbolRow]:
                err = " compiler parser receipt: declaration generic coverage invalid"
                return false
            genericSymbolReferenced[symbolRow] = true
    var declarationRowByTypeRoot: int32[]
    setLen(declarationRowByTypeRoot, typeCount)
    for typeRow in 0..<typeCount:
        declarationRowByTypeRoot[typeRow] = -1
    for declarationRow in 0..<declarationCount:
        let declarationKind =
            sidecar.declarationKinds[declarationRow]
        if declarationKind != Int32(parser.ParserDeclarationType) &&
           declarationKind != Int32(parser.ParserDeclarationField):
            continue
        let typeRoot =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
        let expectedRootKind =
            declarationKind == Int32(parser.ParserDeclarationType) ?
                Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) :
                Int32(parser.ParserTypeSyntaxRootFieldDeclaration)
        if typeRoot < 0 || typeRoot >= typeCount ||
           sidecar.typeSyntaxRootKinds[typeRoot] != expectedRootKind ||
           declarationRowByTypeRoot[typeRoot] != -1:
            err = " compiler parser receipt: TypeSyntax declaration root join invalid"
            return false
        declarationRowByTypeRoot[typeRoot] = declarationRow
    var typeRootCount: int32
    for row in 0..<typeCount:
        let rootKind = sidecar.typeSyntaxRootKinds[row]
        let declarationOwnerToken =
            sidecar.typeSyntaxDeclarationOwnerTokenIds[row]
        let declarationOwner =
            sidecar.typeSyntaxDeclarationOwnerIds[row]
        let genericSymbolStart =
            sidecar.typeSyntaxGenericSymbolStarts[row]
        let genericSymbolCount =
            sidecar.typeSyntaxGenericSymbolCounts[row]
        if typeSyntaxScratch.typeChildSeen[row] ||
           typeSyntaxScratch.typeEnumPayloadSeen[row]:
            if rootKind != Int32(parser.ParserTypeSyntaxRootInvalid) ||
               declarationOwner != -1 || declarationOwnerToken != -1 ||
               genericSymbolStart != -1 || genericSymbolCount != 0:
                err = " compiler parser receipt: nested type syntax is a root"
                return false
        else:
            if rootKind == Int32(parser.ParserTypeSyntaxRootInvalid) ||
               declarationOwnerToken < 0:
                err = " compiler parser receipt: type syntax root proof missing"
                return false
            for symbolOffset in 0..<genericSymbolCount:
                let symbolRow = genericSymbolStart + symbolOffset
                if sidecar.typeGenericSymbolDeclarationOwnerTokenIds[
                       symbolRow] != declarationOwnerToken ||
                   sidecar.typeGenericSymbolOrdinals[symbolRow] !=
                       symbolOffset:
                    err = " compiler parser receipt: generic symbol CSR invalid"
                    return false
                genericSymbolReferenced[symbolRow] = true
            if rootKind ==
                   Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
                if !parserCanonicalSourceSidecarTypeSyntaxOwnerChainValid(
                       sidecar, row, declarationRowByTypeRoot):
                    err = " compiler parser receipt: type declaration owner chain invalid"
                    return false
            elif rootKind ==
                     Int32(parser.ParserTypeSyntaxRootFieldDeclaration):
                if !parserCanonicalSourceSidecarTypeSyntaxOwnerChainValid(
                       sidecar, row, declarationRowByTypeRoot):
                    err = " compiler parser receipt: field declaration owner chain invalid"
                    return false
            elif declarationOwner != -1:
                err = " compiler parser receipt: unexpected declaration owner"
                return false
            typeRootCount = typeRootCount + 1
    var typeDeclarationRootSeen: bool[]
    setLen(typeDeclarationRootSeen, typeCount)
    var typeDeclarationCount: int32
    for declarationRow in 0..<declarationCount:
        let declarationKind =
            sidecar.declarationKinds[declarationRow]
        let typeRoot =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
        if declarationKind == Int32(parser.ParserDeclarationType):
            typeDeclarationCount = typeDeclarationCount + 1
            let declarationNameToken =
                sidecar.declarationNameTokenIds[declarationRow]
            if typeRoot < 0 || typeRoot >= typeCount ||
               sidecar.typeSyntaxRootKinds[typeRoot] !=
                   Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs) ||
               sidecar.typeSyntaxSourceIds[typeRoot] !=
                   sidecar.declarationProducerSourceIds[declarationRow] ||
               sidecar.typeSyntaxProducerSourceIds[typeRoot] !=
                   sidecar.declarationProducerSourceIds[declarationRow] ||
               sidecar.typeSyntaxOwnerTokenIds[typeRoot] !=
                   declarationNameToken ||
               sidecar.typeSyntaxDeclarationOwnerTokenIds[typeRoot] !=
                   declarationNameToken ||
               sidecar.typeSyntaxDeclarationOwnerIds[typeRoot] != typeRoot ||
               typeDeclarationRootSeen[typeRoot]:
                err = " compiler parser receipt: Type declaration root join invalid"
                return false
            typeDeclarationRootSeen[typeRoot] = true
        elif typeRoot >= 0 && typeRoot < typeCount &&
             sidecar.typeSyntaxRootKinds[typeRoot] ==
                 Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
            err = " compiler parser receipt: non-Type declaration owns Type root"
            return false
    var typeDeclarationRootCount: int32
    for typeRow in 0..<typeCount:
        if sidecar.typeSyntaxRootKinds[typeRow] ==
               Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
            typeDeclarationRootCount = typeDeclarationRootCount + 1
            if !typeDeclarationRootSeen[typeRow]:
                err = " compiler parser receipt: Type declaration root is unbound"
                return false
    if typeDeclarationRootCount != typeDeclarationCount:
        err = " compiler parser receipt: Type declaration root coverage mismatch"
        return false
    for symbolRow in 0..<genericSymbolReferenced.len:
        if !genericSymbolReferenced[symbolRow]:
            err = " compiler parser receipt: generic symbol is unreachable"
            return false
    if typeCount > 0 && typeRootCount <= 0:
        err = " compiler parser receipt: type syntax forest has no root"
        return false
    var patternAnnotationOwnerRoots: int32[]
    setLen(patternAnnotationOwnerRoots, typeCount)
    for typeRow in 0..<typeCount:
        patternAnnotationOwnerRoots[typeRow] = -1
    for patternRow in 0..<patternCount:
        let kind = sidecar.patternKinds[patternRow]
        let typeRoot =
            sidecar.patternTypeSyntaxRootIds[patternRow]
        if typeRoot < 0:
            continue
        if kind != Int32(parser.ParserPatternBinding) &&
           patternParentRows[patternRow] >= 0:
            err = " compiler parser receipt: nested non-binding pattern owns type annotation"
            return false
        if sidecar.typeSyntaxRootKinds[typeRoot] !=
               Int32(parser.ParserTypeSyntaxRootBindingAnnotation) ||
           sidecar.typeSyntaxProducerSourceIds[typeRoot] !=
               sidecar.patternProducerSourceIds[patternRow] ||
           sidecar.typeSyntaxDeclarationOwnerIds[typeRoot] != -1:
            err = " compiler parser receipt: pattern TypeSyntax authority invalid"
            return false
        if patternParentRows[patternRow] < 0:
            if patternAnnotationOwnerRoots[typeRoot] >= 0:
                err = " compiler parser receipt: pattern TypeSyntax root reused"
                return false
            patternAnnotationOwnerRoots[typeRoot] = patternRow
    for patternRow in 0..<patternCount:
        if sidecar.patternKinds[patternRow] !=
               Int32(parser.ParserPatternBinding):
            continue
        let declaration =
            sidecar.patternBindingDeclarationIds[patternRow]
        let typeRoot =
            sidecar.patternTypeSyntaxRootIds[patternRow]
        var rootPattern = patternRow
        while patternParentRows[rootPattern] >= 0:
            rootPattern = patternParentRows[rootPattern]
        let rootTypeRoot =
            sidecar.patternTypeSyntaxRootIds[rootPattern]
        if typeRoot != rootTypeRoot ||
           sidecar.declarationTypeSyntaxRootIds[declaration] != typeRoot:
            err = " compiler parser receipt: pattern declaration TypeSyntax join invalid"
            return false
        if typeRoot < 0:
            continue
        if patternAnnotationOwnerRoots[typeRoot] != rootPattern ||
           sidecar.declarationProducerSourceIds[declaration] !=
               sidecar.patternProducerSourceIds[patternRow] ||
           sidecar.tokenProducerSourceIds[
               sidecar.patternNameTokenIds[patternRow]] !=
               sidecar.patternProducerSourceIds[patternRow]:
            err = " compiler parser receipt: pattern TypeSyntax owner/source invalid"
            return false
    for typeRow in 0..<typeCount:
        let rootPattern = patternAnnotationOwnerRoots[typeRow]
        if rootPattern < 0:
            continue
        var firstBindingNameToken: int32 = -1
        for bindingRow in 0..<patternCount:
            if sidecar.patternKinds[bindingRow] !=
                   Int32(parser.ParserPatternBinding) ||
               sidecar.patternTypeSyntaxRootIds[bindingRow] != typeRow:
                continue
            var bindingRoot = bindingRow
            while patternParentRows[bindingRoot] >= 0:
                bindingRoot = patternParentRows[bindingRoot]
            if bindingRoot != rootPattern:
                err = " compiler parser receipt: pattern TypeSyntax crossed root"
                return false
            let nameToken = sidecar.patternNameTokenIds[bindingRow]
            if firstBindingNameToken < 0 ||
               nameToken < firstBindingNameToken:
                firstBindingNameToken = nameToken
        if firstBindingNameToken < 0:
            firstBindingNameToken =
                sidecar.patternNameTokenIds[rootPattern]
        let typeSpan = sidecar.typeSyntaxSpanIds[typeRow]
        let patternSpan = sidecar.patternSpanIds[rootPattern]
        if firstBindingNameToken < 0 ||
           sidecar.typeSyntaxOwnerTokenIds[typeRow] !=
               firstBindingNameToken ||
           sidecar.typeSyntaxDeclarationOwnerTokenIds[typeRow] !=
               firstBindingNameToken ||
           sidecar.spanStartBytes[typeSpan] <=
               sidecar.spanEndBytes[patternSpan]:
            err = " compiler parser receipt: pattern TypeSyntax owner/span invalid"
            return false
    if sidecar.regionKinds.len != sidecar.regionSpanIds.len ||
       sidecar.regionKinds.len != sidecar.regionAnchorTokenIds.len ||
       sidecar.statementRootNodeIds.len != sidecar.statementRootRoles.len ||
       sidecar.statementRootNodeIds.len !=
           sidecar.statementRootAnchorTokenIds.len ||
       sidecar.statementRootNodeIds.len !=
           sidecar.statementRootBindingDeclarationStarts.len ||
       sidecar.statementRootNodeIds.len !=
           sidecar.statementRootBindingDeclarationCounts.len ||
       sidecar.statementRootNodeIds.len !=
           sidecar.statementRootAnchorLines.len ||
       sidecar.statementRootNodeIds.len !=
           sidecar.statementRootAnchorColumns.len ||
       sidecar.statementRootNodeIds.len != sidecar.statementRootEndLines.len ||
       sidecar.statementRootNodeIds.len !=
           sidecar.statementRootEndColumns.len ||
       sidecar.functionIndexes.len != sidecar.functionNames.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionSignatureLineNumbers.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionDeclarationSpanIds.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionDeclarationHeaderSpanIds.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionDeclarationOrdinals.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionDeclarationHeaderCids.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionDeclarationPathCids.len ||
       sidecar.functionIndexes.len != sidecar.functionNameSpanIds.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionNameSurfaceKinds.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionNameProofCids.len ||
       sidecar.functionIndexes.len != sidecar.functionBodySpanIds.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionAnnotationFlags.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionManualConsumeTargetParameterOrdinals.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionManualConsumeTargetParameterDeclarationSourceLocalRows.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionManualConsumeSourceParameterOrdinals.len ||
       sidecar.functionIndexes.len !=
           sidecar.functionManualConsumeSourceParameterDeclarationSourceLocalRows.len:
        err = " compiler parser receipt: canonical sidecar auxiliary shape mismatch"
        return false
    for row in 0..<sidecar.functionIndexes.len:
        let declarationSpanId = sidecar.functionDeclarationSpanIds[row]
        let headerSpanId =
            sidecar.functionDeclarationHeaderSpanIds[row]
        let nameSpanId = sidecar.functionNameSpanIds[row]
        let bodySpanId = sidecar.functionBodySpanIds[row]
        var expectedHeaderCid: layout.FixedBytes32
        var headerErr: str
        if !parserDeclarationHeaderCidInto(
               sidecar,
               headerSpanId,
               nameSpanId,
               expectedHeaderCid,
               headerErr):
            err = headerErr
            return false
        var expectedNameSurfaceKind: int32
        var expectedNameProofCid: layout.FixedBytes32
        if !parserFunctionNameSurfaceProofInto(
               sidecar,
               nameSpanId,
               sidecar.functionNames[row],
               expectedNameSurfaceKind,
               expectedNameProofCid,
               err):
            return false
        if sidecar.functionIndexes[row] < 0 ||
           sidecar.functionNames[row] == "" ||
           sidecar.functionSignatureLineNumbers[row] <= 0 ||
           declarationSpanId < 0 || declarationSpanId >= spanCount ||
           headerSpanId < 0 || headerSpanId >= spanCount ||
           nameSpanId < 0 || nameSpanId >= spanCount ||
           bodySpanId < 0 || bodySpanId >= spanCount ||
           sidecar.functionDeclarationOrdinals[row] < 0 ||
           !layout.FixedBytes32Equal(
               sidecar.functionDeclarationHeaderCids[row],
               expectedHeaderCid) ||
           !layout.FixedBytes32Equal(
               sidecar.functionDeclarationPathCids[row],
               parserDeclarationPathCid(
                   sidecar.functionDeclarationOrdinals[row])) ||
           sidecar.functionNameSurfaceKinds[row] !=
               expectedNameSurfaceKind ||
           !layout.FixedBytes32Equal(
               sidecar.functionNameProofCids[row],
               expectedNameProofCid) ||
           sidecar.spanStartLines[declarationSpanId] + 1 !=
               sidecar.functionSignatureLineNumbers[row] ||
           sidecar.spanStartLines[nameSpanId] + 1 !=
               sidecar.functionSignatureLineNumbers[row] ||
           sidecar.spanStartBytes[nameSpanId] <
               sidecar.spanStartBytes[headerSpanId] ||
           sidecar.spanEndBytes[nameSpanId] >
               sidecar.spanEndBytes[headerSpanId] ||
           sidecar.spanStartBytes[headerSpanId] !=
               sidecar.spanStartBytes[declarationSpanId] ||
           sidecar.spanEndBytes[headerSpanId] >
               sidecar.spanEndBytes[declarationSpanId] ||
           sidecar.spanStartBytes[bodySpanId] <
               sidecar.spanEndBytes[headerSpanId] ||
           sidecar.spanEndBytes[bodySpanId] >
               sidecar.spanEndBytes[declarationSpanId] ||
           !parser.ParserNormalizedFunctionAnnotationFlagsValid(
               sidecar.functionAnnotationFlags[row]) ||
            (row > 0 &&
            (sidecar.functionSignatureLineNumbers[row] <=
                 sidecar.functionSignatureLineNumbers[row - 1] ||
             sidecar.functionIndexes[row] <=
                 sidecar.functionIndexes[row - 1] ||
             sidecar.functionDeclarationOrdinals[row] <=
                 sidecar.functionDeclarationOrdinals[row - 1])):
            err = " compiler parser receipt: canonical function span invalid"
            return false
        let manualConsumePresent =
            (sidecar.functionAnnotationFlags[row] &
             parser.ParserFunctionAnnotationManualConsume) != 0
        let targetOrdinal =
            sidecar.functionManualConsumeTargetParameterOrdinals[row]
        let targetDeclarationRow =
            sidecar.functionManualConsumeTargetParameterDeclarationSourceLocalRows[
                row]
        let sourceOrdinal =
            sidecar.functionManualConsumeSourceParameterOrdinals[row]
        let sourceDeclarationRow =
            sidecar.functionManualConsumeSourceParameterDeclarationSourceLocalRows[
                row]
        if !manualConsumePresent:
            if targetOrdinal != -1 || targetDeclarationRow != -1 ||
               sourceOrdinal != -1 || sourceDeclarationRow != -1:
                err = " compiler parser receipt: absent manual consume relation invalid"
                return false
        else:
            var functionDeclarationRow: int32 = -1
            for declarationRow in 0..<sidecar.declarationKinds.len:
                if sidecar.declarationKinds[declarationRow] !=
                       Int32(parser.ParserDeclarationFunction) ||
                   sidecar.declarationSpanIds[declarationRow] !=
                       declarationSpanId ||
                   sidecar.declarationNameSpanIds[declarationRow] !=
                       nameSpanId:
                    continue
                if functionDeclarationRow >= 0:
                    err = " compiler parser receipt: manual consume function declaration ambiguous"
                    return false
                functionDeclarationRow = declarationRow
            if functionDeclarationRow < 0 ||
               targetOrdinal < 0 || sourceOrdinal < 0 ||
               targetOrdinal == sourceOrdinal ||
               targetDeclarationRow < 0 ||
               targetDeclarationRow >= sidecar.declarationKinds.len ||
               sourceDeclarationRow < 0 ||
               sourceDeclarationRow >= sidecar.declarationKinds.len ||
               targetDeclarationRow == sourceDeclarationRow ||
               sidecar.declarationKinds[targetDeclarationRow] !=
                   Int32(parser.ParserDeclarationParameter) ||
               sidecar.declarationKinds[sourceDeclarationRow] !=
                   Int32(parser.ParserDeclarationParameter) ||
               sidecar.declarationOwnerIds[targetDeclarationRow] !=
                   functionDeclarationRow ||
               sidecar.declarationOwnerIds[sourceDeclarationRow] !=
                   functionDeclarationRow:
                err = " compiler parser receipt: manual consume relation invalid"
                return false
            var observedTargetOrdinal: int32 = -1
            var observedSourceOrdinal: int32 = -1
            var parameterOrdinal: int32
            for declarationRow in 0..<sidecar.declarationKinds.len:
                if sidecar.declarationKinds[declarationRow] !=
                       Int32(parser.ParserDeclarationParameter) ||
                   sidecar.declarationOwnerIds[declarationRow] !=
                       functionDeclarationRow:
                    continue
                if declarationRow == targetDeclarationRow:
                    observedTargetOrdinal = parameterOrdinal
                if declarationRow == sourceDeclarationRow:
                    observedSourceOrdinal = parameterOrdinal
                parameterOrdinal = parameterOrdinal + 1
            if observedTargetOrdinal != targetOrdinal ||
               observedSourceOrdinal != sourceOrdinal:
                err = " compiler parser receipt: manual consume parameter ordinal invalid"
                return false
    for row in 0..<sidecar.genericSpanIds.len:
        if sidecar.genericSpanIds[row] < 0 ||
           sidecar.genericSpanIds[row] >= spanCount:
            err = " compiler parser receipt: canonical generic span invalid"
            return false
    for row in 0..<sidecar.regionKinds.len:
        if sidecar.regionKinds[row] <= 0 || sidecar.regionSpanIds[row] < 0 ||
           sidecar.regionSpanIds[row] >= spanCount ||
           sidecar.regionAnchorTokenIds[row] < 0 ||
           sidecar.regionAnchorTokenIds[row] >= sidecar.tokenKinds.len ||
           sidecar.spanStartBytes[
               sidecar.tokenSpanIds[sidecar.regionAnchorTokenIds[row]]] <
               sidecar.spanStartBytes[sidecar.regionSpanIds[row]] ||
           sidecar.spanEndBytes[
               sidecar.tokenSpanIds[sidecar.regionAnchorTokenIds[row]]] >
               sidecar.spanEndBytes[sidecar.regionSpanIds[row]]:
            err = " compiler parser receipt: canonical region invalid"
            return false
    for row in 0..<sidecar.rootNodeIds.len:
        let node = sidecar.rootNodeIds[row]
        if node < 0 || node >= nodeCount:
            err = " compiler parser receipt: canonical root invalid"
            return false
    for row in 0..<sidecar.callEventNodeIds.len:
        if sidecar.callEventNodeIds[row] < 0 ||
           sidecar.callEventNodeIds[row] >= nodeCount:
            err = " compiler parser receipt: canonical call event invalid"
            return false
    for row in 0..<sidecar.statementRootNodeIds.len:
        let nodeId = sidecar.statementRootNodeIds[row]
        let anchorTokenId = sidecar.statementRootAnchorTokenIds[row]
        let declarationStart =
            sidecar.statementRootBindingDeclarationStarts[row]
        let declarationCount =
            sidecar.statementRootBindingDeclarationCounts[row]
        if nodeId < 0 || nodeId >= nodeCount ||
           anchorTokenId < 0 ||
           anchorTokenId >= sidecar.tokenKinds.len ||
           sidecar.statementRootRoles[row] <= 0 ||
           sidecar.statementRootAnchorLines[row] < 0 ||
           sidecar.statementRootAnchorColumns[row] < 0 ||
           sidecar.statementRootEndLines[row] <
               sidecar.statementRootAnchorLines[row] ||
           (sidecar.statementRootEndLines[row] ==
                sidecar.statementRootAnchorLines[row] &&
            sidecar.statementRootEndColumns[row] <
                sidecar.statementRootAnchorColumns[row]) ||
           sidecar.statementRootEndColumns[row] < 0:
            err = " compiler parser receipt: canonical statement root invalid"
            return false
        let anchorSpanId = sidecar.tokenSpanIds[anchorTokenId]
        if anchorSpanId < 0 || anchorSpanId >= spanCount ||
           sidecar.statementRootAnchorLines[row] !=
               sidecar.spanStartLines[anchorSpanId] ||
           sidecar.statementRootAnchorColumns[row] !=
               sidecar.spanStartColumns[anchorSpanId]:
            err = " compiler parser receipt: statement anchor token invalid"
            return false
        let statementRole = sidecar.statementRootRoles[row]
        let declarationAuthorityRole =
            statementRole ==
                Int32(parser.ParserValueExprStatementBindingInitializer) ||
            statementRole ==
                Int32(parser.ParserValueExprStatementTypeDefault) ||
            statementRole ==
                Int32(parser.ParserValueExprStatementParameterDefault)
        if !declarationAuthorityRole:
            if declarationStart != -1 || declarationCount != 0:
                err = " compiler parser receipt: statement without declaration authority owns declarations"
                return false
            continue
        if sidecar.tokenKinds[anchorTokenId] !=
               Int32(parser.ParserValueTokenAssign) ||
           declarationStart < 0 || declarationCount <= 0 ||
           declarationStart > sidecar.declarationKinds.len ||
           declarationCount >
               sidecar.declarationKinds.len - declarationStart:
            err = " compiler parser receipt: statement declaration authority range invalid"
            return false
        let anchorStart = sidecar.spanStartBytes[anchorSpanId]
        let nodeSpanId = sidecar.nodeSpanIds[nodeId]
        if (statementRole ==
                Int32(parser.ParserValueExprStatementTypeDefault) ||
            statementRole ==
                Int32(parser.ParserValueExprStatementParameterDefault)) &&
           declarationCount != 1:
            err = " compiler parser receipt: declaration default cardinality invalid"
            return false
        for declarationOffset in 0..<declarationCount:
            let declarationRow = declarationStart + declarationOffset
            let declarationSpanId = sidecar.declarationSpanIds[
                declarationRow]
            let declarationNameTokenId = sidecar.declarationNameTokenIds[
                declarationRow]
            if statementRole ==
                   Int32(parser.ParserValueExprStatementBindingInitializer):
                if sidecar.declarationKinds[declarationRow] !=
                       Int32(parser.ParserDeclarationLocal) ||
                   sidecar.spanStartBytes[declarationSpanId] >=
                       anchorStart ||
                   sidecar.spanEndBytes[declarationSpanId] !=
                       sidecar.spanEndBytes[nodeSpanId] ||
                   sidecar.spanStartBytes[
                       sidecar.tokenSpanIds[declarationNameTokenId]] >=
                       anchorStart:
                    err = " compiler parser receipt: binding statement declaration authority invalid"
                    return false
            elif statementRole ==
                     Int32(parser.ParserValueExprStatementTypeDefault):
                let declarationKind =
                    sidecar.declarationKinds[declarationRow]
                let declarationFunctionRow =
                    sidecar.declarationFunctionRows[declarationRow]
                let declarationScopeRow =
                    sidecar.declarationLexicalScopeIds[declarationRow]
                let declarationScopeKind =
                    sidecar.declarationLexicalScopeKinds[
                        declarationScopeRow]
                let typeDeclarationAuthority =
                    declarationKind ==
                        Int32(parser.ParserDeclarationType) &&
                    declarationScopeKind ==
                        Int32(parser.ParserDeclarationLexicalScopeSource)
                let fieldDeclarationAuthority =
                    declarationKind ==
                        Int32(parser.ParserDeclarationField) &&
                    declarationScopeKind ==
                        Int32(parser.ParserDeclarationLexicalScopeType)
                if declarationFunctionRow != -1 ||
                   (!typeDeclarationAuthority &&
                    !fieldDeclarationAuthority) ||
                   sidecar.spanStartBytes[declarationSpanId] >=
                       anchorStart ||
                   sidecar.spanEndBytes[declarationSpanId] <
                       sidecar.spanEndBytes[nodeSpanId] ||
                   sidecar.spanStartBytes[
                       sidecar.tokenSpanIds[declarationNameTokenId]] >=
                       anchorStart:
                    err = " compiler parser receipt: type default declaration authority invalid"
                    return false
            else:
                let declarationKind =
                    sidecar.declarationKinds[declarationRow]
                let declarationFunctionRow =
                    sidecar.declarationFunctionRows[declarationRow]
                let declarationOwnerRow =
                    sidecar.declarationOwnerIds[declarationRow]
                let declarationScopeRow =
                    sidecar.declarationLexicalScopeIds[declarationRow]
                if declarationKind !=
                       Int32(parser.ParserDeclarationParameter) ||
                   sidecar.declarationDefaultStatementRootRows[
                       declarationRow] != row ||
                   declarationFunctionRow < 0 ||
                   declarationOwnerRow < 0 ||
                   sidecar.declarationKinds[declarationOwnerRow] !=
                       Int32(parser.ParserDeclarationFunction) ||
                   sidecar.declarationFunctionRows[
                       declarationOwnerRow] != declarationFunctionRow ||
                   sidecar.declarationLexicalScopeKinds[
                       declarationScopeRow] !=
                       Int32(
                           parser.ParserDeclarationLexicalScopeFunction) ||
                   sidecar.declarationLexicalScopeOwnerDeclarationIds[
                       declarationScopeRow] != declarationOwnerRow ||
                   sidecar.declarationLexicalScopeProducerSourceIds[
                       declarationScopeRow] !=
                       sidecar.declarationProducerSourceIds[
                           declarationRow] ||
                   sidecar.spanStartBytes[declarationSpanId] >=
                       anchorStart ||
                   sidecar.spanEndBytes[declarationSpanId] !=
                       sidecar.spanEndBytes[nodeSpanId] ||
                   sidecar.spanStartBytes[
                       sidecar.tokenSpanIds[declarationNameTokenId]] >=
                       anchorStart:
                    err = " compiler parser receipt: parameter default declaration authority invalid"
                    return false
    err = ""
    return true

# Read-only over `sidecar`: it is only inspected and re-hashed; nothing is
# rebound, stored or released, so the caller keeps ownership.
@borrows
fn ParserCanonicalSourceSidecarStrictValidateInto(
        sidecar: ParserCanonicalSourceSidecar,
        err: var str): bool =
    if !parserCanonicalSourceSidecarPayloadStrictValidateInto(sidecar, err):
        return false
    if !parserDiagnosticRowsStrictValidateInto(sidecar, err):
        return false
    if !layout.FixedBytes32Equal(
           parserCanonicalSourceSidecarHash(sidecar), sidecar.sidecarRaw32):
        err = " compiler parser receipt: canonical sidecar CID mismatch"
        return false
    if sidecar.diagnosticRowStart < 0 ||
       sidecar.diagnosticRowCount !=
           sidecar.diagnosticAnchorNodeIds.len ||
       layout.FixedBytes32Equal(
           sidecar.diagnosticCompletionRaw32,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           parserDiagnosticCompletionRaw32(sidecar),
           sidecar.diagnosticCompletionRaw32):
        err = " compiler parser receipt: diagnostic completion mismatch"
        return false
    err = ""
    return true

@borrows
fn parserSidecarCopyI32KindsRec(sidecar: ParserCanonicalSourceSidecar,
                                 dest: var int32[],
                                 i: int32) =
    if i >= sidecar.diagnosticAnchorKinds.len:
        return
    add(dest, sidecar.diagnosticAnchorKinds[i])
    parserSidecarCopyI32KindsRec(sidecar, dest, i + 1)

@borrows
fn parserSidecarCopyI32NodeIdsRec(sidecar: ParserCanonicalSourceSidecar,
                                   dest: var int32[],
                                   i: int32) =
    if i >= sidecar.diagnosticAnchorNodeIds.len:
        return
    add(dest, sidecar.diagnosticAnchorNodeIds[i])
    parserSidecarCopyI32NodeIdsRec(sidecar, dest, i + 1)

@borrows
fn parserSidecarCopyI32OwnersRec(sidecar: ParserCanonicalSourceSidecar,
                                  dest: var int32[],
                                  i: int32) =
    if i >= sidecar.diagnosticOwnerDeclarationSourceLocalRows.len:
        return
    add(dest, sidecar.diagnosticOwnerDeclarationSourceLocalRows[i])
    parserSidecarCopyI32OwnersRec(sidecar, dest, i + 1)

@borrows
fn parserSidecarCopyI32SpansRec(sidecar: ParserCanonicalSourceSidecar,
                                 dest: var int32[],
                                 i: int32) =
    if i >= sidecar.diagnosticSpanIds.len:
        return
    add(dest, sidecar.diagnosticSpanIds[i])
    parserSidecarCopyI32SpansRec(sidecar, dest, i + 1)

@borrows
fn parserSidecarCopyI32SeveritiesRec(sidecar: ParserCanonicalSourceSidecar,
                                      dest: var int32[],
                                      i: int32) =
    if i >= sidecar.diagnosticSeverities.len:
        return
    add(dest, sidecar.diagnosticSeverities[i])
    parserSidecarCopyI32SeveritiesRec(sidecar, dest, i + 1)

@borrows
fn parserSidecarCopyStrCodesRec(sidecar: ParserCanonicalSourceSidecar,
                                 dest: var str[],
                                 i: int32) =
    if i >= sidecar.diagnosticCodeTexts.len:
        return
    add(dest, strings.CloneStr(sidecar.diagnosticCodeTexts[i]))
    parserSidecarCopyStrCodesRec(sidecar, dest, i + 1)

@borrows
fn parserSidecarCopyStrMessagesRec(sidecar: ParserCanonicalSourceSidecar,
                                    dest: var str[],
                                    i: int32) =
    if i >= sidecar.diagnosticMessageTexts.len:
        return
    add(dest, strings.CloneStr(sidecar.diagnosticMessageTexts[i]))
    parserSidecarCopyStrMessagesRec(sidecar, dest, i + 1)

@borrows
fn ParserCanonicalSourceSidecarDiagnosticAppendInto(
        sidecar: ParserCanonicalSourceSidecar,
        anchorKind: int32,
        anchorNodeId: int32,
        ownerDeclarationSourceLocalRow: int32,
        spanId: int32,
        severity: int32,
        codeText: str,
        messageText: str,
        err: var str): bool =
    var oldKinds: int32[]
    var oldNodeIds: int32[]
    var oldOwners: int32[]
    var oldSpans: int32[]
    var oldSeverities: int32[]
    var oldCodes: str[]
    var oldMessages: str[]
    parserSidecarCopyI32KindsRec(sidecar, oldKinds, 0)
    parserSidecarCopyI32NodeIdsRec(sidecar, oldNodeIds, 0)
    parserSidecarCopyI32OwnersRec(sidecar, oldOwners, 0)
    parserSidecarCopyI32SpansRec(sidecar, oldSpans, 0)
    parserSidecarCopyI32SeveritiesRec(sidecar, oldSeverities, 0)
    parserSidecarCopyStrCodesRec(sidecar, oldCodes, 0)
    parserSidecarCopyStrMessagesRec(sidecar, oldMessages, 0)
    var newKinds: int32[]
    var newNodeIds: int32[]
    var newOwners: int32[]
    var newSpans: int32[]
    var newSeverities: int32[]
    var newCodes: str[]
    var newMessages: str[]
    parserSidecarCopyI32KindsRec(sidecar, newKinds, 0)
    parserSidecarCopyI32NodeIdsRec(sidecar, newNodeIds, 0)
    parserSidecarCopyI32OwnersRec(sidecar, newOwners, 0)
    parserSidecarCopyI32SpansRec(sidecar, newSpans, 0)
    parserSidecarCopyI32SeveritiesRec(sidecar, newSeverities, 0)
    parserSidecarCopyStrCodesRec(sidecar, newCodes, 0)
    parserSidecarCopyStrMessagesRec(sidecar, newMessages, 0)
    add(newKinds, anchorKind)
    add(newNodeIds, anchorNodeId)
    add(newOwners, ownerDeclarationSourceLocalRow)
    add(newSpans, spanId)
    add(newSeverities, severity)
    add(newCodes, strings.CloneStr(codeText))
    add(newMessages, strings.CloneStr(messageText))
    sidecar.diagnosticAnchorKinds = newKinds
    sidecar.diagnosticAnchorNodeIds = newNodeIds
    sidecar.diagnosticOwnerDeclarationSourceLocalRows = newOwners
    sidecar.diagnosticSpanIds = newSpans
    sidecar.diagnosticSeverities = newSeverities
    sidecar.diagnosticCodeTexts = newCodes
    sidecar.diagnosticMessageTexts = newMessages
    if !parserDiagnosticRowsPayloadStrictValidateInto(sidecar, err):
        sidecar.diagnosticAnchorKinds = oldKinds
        sidecar.diagnosticAnchorNodeIds = oldNodeIds
        sidecar.diagnosticOwnerDeclarationSourceLocalRows = oldOwners
        sidecar.diagnosticSpanIds = oldSpans
        sidecar.diagnosticSeverities = oldSeverities
        sidecar.diagnosticCodeTexts = oldCodes
        sidecar.diagnosticMessageTexts = oldMessages
        return false
    err = ""
    return true

fn ParserCanonicalSourceSidecarSealInto(
        sidecar: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    if !parserCanonicalSourceSidecarPayloadStrictValidateInto(sidecar, err):
        return false
    if !parserDiagnosticRowsPayloadStrictValidateInto(sidecar, err):
        return false
    sidecar.diagnosticProofRaw32s = []
    for row in 0..<sidecar.diagnosticAnchorNodeIds.len:
        add(sidecar.diagnosticProofRaw32s,
            parserDiagnosticRowProofRaw32(sidecar, row))
    sidecar.sidecarRaw32 = parserCanonicalSourceSidecarHash(sidecar)
    sidecar.diagnosticRowStart = 0
    sidecar.diagnosticRowCount =
        sidecar.diagnosticAnchorNodeIds.len
    sidecar.diagnosticCompletionRaw32 =
        parserDiagnosticCompletionRaw32(sidecar)
    err = ""
    return true

fn ParserCanonicalSourceSidecarTypeConstExprIdentityCidAt(
        sidecar: ParserCanonicalSourceSidecar,
        row: int32): layout.FixedBytes32 =
    if row < 0 || row >= sidecar.typeConstExprKinds.len ||
       row >= sidecar.typeConstExprProducerSourceIds.len ||
       row >= sidecar.typeConstExprSourceTextIds.len ||
       row >= sidecar.typeConstExprTokenIds.len ||
       row >= sidecar.typeConstExprLeftChildIds.len ||
       row >= sidecar.typeConstExprRightChildIds.len ||
       row >= sidecar.typeConstExprIntegerValues.len:
        panic("compiler parser receipt: type const identity row invalid")
    return parserSpanReceiptTypeConstExprIdentityRaw32(
        row,
        sidecar.typeConstExprProducerSourceIds[row],
        sidecar.typeConstExprSourceTextIds[row],
        sidecar.typeConstExprTokenIds[row],
        sidecar.typeConstExprKinds[row],
        sidecar.typeConstExprLeftChildIds[row],
        sidecar.typeConstExprRightChildIds[row],
        sidecar.typeConstExprIntegerValues[row])

@borrows
fn parserReceiptAppendIdentity(buf: var layout.ByteBuf,
                               identity: ParserNormalizedExprFunctionIdentity) =
    parserReceiptAppendI32(buf, identity.sourceIndex)
    parserReceiptAppendI32(buf, identity.functionIndex)
    parserReceiptAppendText(buf, identity.sourcePath)
    parserReceiptAppendText(buf, identity.ownerModulePath)
    parserReceiptAppendText(buf, identity.functionName)
    parserReceiptAppendI32(buf, identity.signatureLineNumber)
    parserReceiptAppendI32(buf, identity.endLineNumber)

@borrows
fn parserReceiptAppendExpr(buf: var layout.ByteBuf,
                           expr: parser.NormalizedExpr) =
    parserReceiptAppendText(buf, expr.exprId)
    parserReceiptAppendText(buf, expr.sourcePath)
    parserReceiptAppendI32(buf, expr.lineNumber)
    parserReceiptAppendI32(buf, expr.columnNumber)
    parserReceiptAppendI32(buf, expr.endLineNumber)
    parserReceiptAppendI32(buf, expr.endColumnNumber)
    parserReceiptAppendI32(buf, Int32(expr.kind))
    parserReceiptAppendI32(buf, Int32(expr.detailKind))
    parserReceiptAppendText(buf, expr.surfaceText)
    parserReceiptAppendI32(buf, Int32(expr.callSurfaceKind))
    parserReceiptAppendBool(buf, expr.callResolved)
    parserReceiptAppendI32(buf, Int32(expr.callReason))
    parserReceiptAppendText(buf, expr.callQualifier)
    parserReceiptAppendText(buf, expr.callCallee)
    parserReceiptAppendText(buf, expr.callTarget)
    parserReceiptAppendText(buf, expr.callTargetSourcePath)
    parserReceiptAppendBool(buf, expr.callTargetImportc)
    parserReceiptAppendBool(buf, expr.callPrefixStyle)
    parserReceiptAppendI32(buf, expr.callArgCount)
    parserReceiptAppendText(buf, expr.callArgsText)
    parserReceiptAppendI32(buf, expr.valueExprCallNodeIndex)
    parserReceiptAppendI32(buf, expr.originParserNodeId)
    parserReceiptAppendI32(buf, expr.callArgValueRootStart)
    parserReceiptAppendI32(buf, expr.callArgValueRootCount)
    parserReceiptAppendI32(buf, expr.valueExprRootNodeIndex)
    parserReceiptAppendI32(buf, expr.valueExprSpanStart)
    parserReceiptAppendI32(buf, expr.valueExprSpanEnd)
    parserReceiptAppendI32(buf, Int32(expr.valueExprStatementRole))
    parserReceiptAppendI32(buf, expr.anchorTokenIndex)
    parserReceiptAppendI32(buf, expr.lexicalScopeId)
    parserReceiptAppendI32(buf, expr.suiteScopeId)
    parserReceiptAppendI32(buf, expr.statementOrdinal)
    parserReceiptAppendI32(buf, expr.lexicalOrdinal)
    parserReceiptAppendI32(buf, expr.deferOwnerStatementOrdinal)

@borrows
fn parserReceiptAppendScope(buf: var layout.ByteBuf,
                            scope: parser.NormalizedScopeFact) =
    parserReceiptAppendText(buf, scope.sourcePath)
    parserReceiptAppendI32(buf, scope.scopeId)
    parserReceiptAppendI32(buf, scope.sourceScopeId)
    parserReceiptAppendI32(buf, scope.parentScopeId)
    parserReceiptAppendI32(buf, Int32(scope.kind))
    parserReceiptAppendI32(buf, scope.ownerStatementOrdinal)
    parserReceiptAppendI32(buf, scope.ownerStatementRow)
    parserReceiptAppendI32(buf, scope.ownerDeclarationRow)
    parserReceiptAppendBool(buf, scope.moduleRootAnchor)
    parserReceiptAppendI32(buf, scope.lexicalOrdinal)
    parserReceiptAppendI32(buf, scope.indentColumn)
    parserReceiptAppendI32(buf, scope.startLineNumber)
    parserReceiptAppendI32(buf, scope.startColumnNumber)
    parserReceiptAppendI32(buf, scope.endLineNumber)
    parserReceiptAppendI32(buf, scope.endColumnNumber)
    parserReceiptAppendI32(buf, scope.anchorTokenIndex)

@borrows
fn parserReceiptAppendTree(buf: var layout.ByteBuf,
                           tree: parser.ParserValueExprTree) =
    if tree == nil:
        parserReceiptAppendBool(buf, false)
        return
    parserReceiptAppendBool(buf, true)
    parserReceiptAppendI32(buf, tree.nodeCount)
    parserReceiptAppendI32(buf, tree.genericCount)
    parserReceiptAppendI32(buf, tree.rootCount)
    parserReceiptAppendI32(buf, tree.tokenCount)
    parserReceiptAppendI32(buf, tree.callEventCount)
    parserReceiptAppendI32(buf, tree.statementRootCount)
    parserReceiptAppendI32(buf, tree.regionCount)
    parserReceiptAppendI32(buf, tree.typeSyntaxCount)
    parserReceiptAppendI32(buf, tree.typeSyntaxChildCount)
    parserReceiptAppendI32(buf, tree.typeSyntaxBracketArgCount)
    parserReceiptAppendI32(buf, tree.typeConstExprCount)
    parserReceiptAppendI32(buf, tree.typeGenericSymbolCount)
    parserReceiptAppendI32(buf, tree.typeGenericSymbolChildCount)
    parserReceiptAppendI32(buf, tree.typeEnumVariantCount)
    parserReceiptAppendI32(buf, tree.declarationCount)
    parserReceiptAppendI32(buf, tree.declarationLexicalScopeCount)
    parserReceiptAppendI32(buf, tree.patternCount)
    parserReceiptAppendI32(buf, tree.patternChildCount)
    parserReceiptAppendI32(buf, tree.annotationCount)
    parserReceiptAppendI32(buf, tree.annotationArgCount)
    parserReceiptAppendI32(buf, tree.annotationArgRootCount)
    parserReceiptAppendI32(buf, tree.annotationArgChildCount)
    parserReceiptAppendI32(buf, tree.producerSourceCount)
    var sourceTextIds: int32[]
    var sourceTextRaw32s: layout.FixedBytes32[]
    for nodeIndex in 0..<tree.nodeCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.kinds, nodeIndex))
        let sourceTextId = parserReceiptArenaI32(
            tree, tree.sourceTextIds, nodeIndex)
        parserReceiptAppendFixed32(buf,
            parserReceiptSourceRaw32(tree,
                                     sourceTextId,
                                     sourceTextIds,
                                     sourceTextRaw32s))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.spanStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.spanEnds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.atomStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.atomEnds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.ownerStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.ownerEnds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.nameStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.nameEnds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.operatorStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.operatorEnds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.argumentNameStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.argumentNameEnds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.callArgsStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.callArgsEnds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.argumentRootStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.argumentRootCounts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.firstChilds, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.childCounts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.nextSiblings, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.parentNodeIndexes, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.nodeStatementRootEventIndexes, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.explicitGenericStarts, nodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.explicitGenericCounts, nodeIndex))
    for genericIndex in 0..<tree.genericCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.explicitGenericSpanStarts, genericIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.explicitGenericSpanEnds, genericIndex))
    for regionIndex in 0..<tree.regionCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.regionKinds, regionIndex))
        let regionSourceTextId = parserReceiptArenaI32(
            tree, tree.regionSourceTextIds, regionIndex)
        parserReceiptAppendFixed32(buf,
            parserReceiptSourceRaw32(tree,
                                     regionSourceTextId,
                                     sourceTextIds,
                                     sourceTextRaw32s))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.regionSpanStarts, regionIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.regionSpanEnds, regionIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.regionAnchorTokenIndexes, regionIndex))
    for typeNodeIndex in 0..<tree.typeSyntaxCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxKinds, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxProducerSourceIndexes, typeNodeIndex))
        let typeSourceTextId = parserReceiptArenaI32(
            tree, tree.typeSyntaxSourceTextIds, typeNodeIndex)
        parserReceiptAppendFixed32(buf,
            parserReceiptSourceRaw32(tree,
                                     typeSourceTextId,
                                     sourceTextIds,
                                     sourceTextRaw32s))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSpanStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSpanEnds, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxOwnerTokenIndexes, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxDeclarationOwnerTokenIndexes,
                typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxDeclarationOwnerNodeIndexes,
                typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxGenericSymbolStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxGenericSymbolCounts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxChildStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxChildCounts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgCounts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxNameTokenIndexes, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxFixedLengths, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxQuestionTokenIndexes,
                typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxRootKinds, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxEnumVariantStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxEnumVariantCounts, typeNodeIndex))
    for childIndex in 0..<tree.typeSyntaxChildCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxChildNodeIndexes, childIndex))
    for argIndex in 0..<tree.typeSyntaxBracketArgCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgTokenStarts, argIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgTokenCounts, argIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxBracketArgTypeNodeIndexes,
                argIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxBracketArgConstExprRootIndexes,
                argIndex))
    for constIndex in 0..<tree.typeConstExprCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeConstExprKinds, constIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeConstExprProducerSourceIndexes,
                constIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeConstExprTokenIndexes, constIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeConstExprLeftChildIndexes, constIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeConstExprRightChildIndexes, constIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeConstExprIntegerValues, constIndex))
    for symbolIndex in 0..<tree.typeGenericSymbolCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolProducerSourceIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolNameTokenIndexes, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolOrdinals, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolSpanStarts, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolSpanEnds, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolOwnerDeclarationRows,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolChildStarts, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolChildCounts, symbolIndex))
    parserReceiptAppendI32(buf, tree.typeGenericSymbolChildCount)
    for childIndex in 0..<tree.typeGenericSymbolChildCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolChildTypeSyntaxNodeIndexes,
                childIndex))
    for variantIndex in 0..<tree.typeEnumVariantCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantProducerSourceIndexes,
                variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantDeclarationOwnerNodeIndexes,
                variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantDeclarationOwnerTokenIndexes,
                variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeEnumVariantNameTokenIndexes, variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeEnumVariantOrdinals, variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
                variantIndex))
    for declarationRow in 0..<tree.declarationCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationProducerSourceIndexes, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationSourceLocalRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationKinds, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationNameTokenIndexes, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationOwnerRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationFunctionRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationTypeSyntaxRootIndexes,
            declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationDefaultStatementRootRows,
            declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationGenericSymbolStarts,
            declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationGenericSymbolCounts,
            declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationSuiteLexicalScopeRows,
            declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationSpanStarts, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationSpanEnds, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationNameSpanStarts, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationNameSpanEnds, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationMutableFlags, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationExportedFlags, declarationRow))
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeProducerSourceIndexes,
            scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeSourceLocalRows, scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeKinds, scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeParentRows, scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeOwnerDeclarationRows,
            scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeSpanStarts,
            scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeSpanEnds,
            scopeRow))
    for patternRow in 0..<tree.patternCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternProducerSourceIndexes, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternSourceLocalRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternKinds, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternNameTokenIndexes, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternOwnerLexicalScopeRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternOwnerKinds, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternOwnerRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternBindingDeclarationRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternTypeSyntaxRootIndexes, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternSpanStarts, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternSpanEnds, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternChildStarts, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternChildCounts, patternRow))
    for childRow in 0..<tree.patternChildCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternChildNodeIndexes, childRow))
    for annotationRow in 0..<tree.annotationCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.annotationProducerSourceIndexes,
            annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationSourceLocalRows, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationNameTokenIndexes, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationTargetTokenIndexes, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationSpanStarts, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationSpanEnds, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgRootStarts, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgRootCounts, annotationRow))
    for rootRow in 0..<tree.annotationArgRootCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgRootNodeIndexes, rootRow))
    for annotationArgRow in 0..<tree.annotationArgCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.annotationArgProducerSourceIndexes,
            annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgSourceLocalRows, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgOwnerRows, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgKinds, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgTokenIndexes, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.annotationArgSeparatorTokenIndexes,
            annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgSpanStarts, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgSpanEnds, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgChildStarts, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgChildCounts, annotationArgRow))
    for childRow in 0..<tree.annotationArgChildCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgChildNodeIndexes, childRow))
    for rootIndex in 0..<tree.rootCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.rootNodeIndexes, rootIndex))
    for tokenIndex in 0..<tree.tokenCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenKinds, tokenIndex))
        let sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, tokenIndex)
        parserReceiptAppendFixed32(buf,
            parserReceiptSourceRaw32(tree,
                                     sourceTextId,
                                     sourceTextIds,
                                     sourceTextRaw32s))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.tokenProducerSourceIndexes, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.tokenSourceLocalIndexes, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.tokenLexicalParentIndexes, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenStarts, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenEnds, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenLineNumbers, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenColumnNumbers, tokenIndex))
    for eventIndex in 0..<tree.callEventCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.callEventNodeIndexes, eventIndex))
    for rootIndex in 0..<tree.statementRootCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootNodeIndexes, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.statementRootRoles, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootAnchorTokenIndexes, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.statementRootBindingDeclarationStarts,
                rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.statementRootBindingDeclarationCounts,
                rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootAnchorLineNumbers, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootAnchorColumnNumbers, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootEndLineNumbers, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootEndColumnNumbers, rootIndex))

@borrows
fn ParserNormalizedExprFunctionIdentityMake(
        sourceIndex: int32,
        functionIndex: int32,
        sourcePath: str,
        ownerModulePath: str,
        functionName: str,
        signatureLineNumber: int32,
        endLineNumber: int32): ParserNormalizedExprFunctionIdentity =
    var out: ParserNormalizedExprFunctionIdentity
    out.sourceIndex = sourceIndex
    out.functionIndex = functionIndex
    out.sourcePath = share(sourcePath)
    out.ownerModulePath = share(ownerModulePath)
    out.functionName = share(functionName)
    out.signatureLineNumber = signatureLineNumber
    out.endLineNumber = endLineNumber
    return out

@borrows
fn parserReceiptIdentityValid(
        identity: ParserNormalizedExprFunctionIdentity): bool =
    return identity.sourceIndex >= 0 && identity.functionIndex >= 0 &&
           identity.sourcePath != "" && identity.ownerModulePath != "" &&
           identity.functionName != "" && identity.signatureLineNumber > 0 &&
           identity.endLineNumber >= identity.signatureLineNumber

@borrows
fn parserReceiptExprIdentityMatchCount(
        identities: ParserNormalizedExprFunctionIdentity[],
        expr: parser.NormalizedExpr): int32 =
    var out: int32
    for identityIndex in 0..<identities.len:
        let identity = identities[identityIndex]
        if expr.sourcePath == identity.sourcePath &&
           expr.lineNumber >= identity.signatureLineNumber &&
           expr.endLineNumber >= expr.lineNumber &&
           expr.endLineNumber <= identity.endLineNumber:
            out = out + 1
    return out

@borrows
fn parserReceiptScopeHasSourceIdentity(
        identities: ParserNormalizedExprFunctionIdentity[],
        scope: parser.NormalizedScopeFact): bool =
    for identityIndex in 0..<identities.len:
        if scope.sourcePath == identities[identityIndex].sourcePath:
            return true
    return false

@borrows
fn parserNormalizedExprLayerArtifactBuild(
        layer: var parser.NormalizedExprLayer,
        identities: ParserNormalizedExprFunctionIdentity[]): Result[ParserNormalizedExprFunctionArtifact] =
    if identities.len <= 0:
        return Err[ParserNormalizedExprFunctionArtifact](
            " compiler parser receipt: empty layer function identity set")
    for identityIndex in 0..<identities.len:
        if !parserReceiptIdentityValid(identities[identityIndex]):
            return Err[ParserNormalizedExprFunctionArtifact](
                " compiler parser receipt: invalid function identity")
        if identityIndex > 0 &&
           !parserReceiptIdentityLess(identities[identityIndex - 1],
                                      identities[identityIndex]):
            return Err[ParserNormalizedExprFunctionArtifact](
                " compiler parser receipt: layer identities are not canonical")
        if identityIndex > 0 &&
           identities[identityIndex - 1].sourceIndex ==
               identities[identityIndex].sourceIndex &&
           identities[identityIndex - 1].endLineNumber >=
               identities[identityIndex].signatureLineNumber:
            return Err[ParserNormalizedExprFunctionArtifact](
                " compiler parser receipt: function identity ranges overlap")
    if layer.sourceCount < 0 || layer.questionResidualCount < 0:
        return Err[ParserNormalizedExprFunctionArtifact](
            " compiler parser receipt: negative layer count")
    if layer.valueExprTree == nil:
        return Err[ParserNormalizedExprFunctionArtifact](
            " compiler parser receipt: value tree missing")
    var borrowedTree: parser.ParserValueExprTree
    borrowedTree = parser.ParserValueExprTreeBorrow(layer.valueExprTree)
    if !parserReceiptTreeArrayShape(borrowedTree):
        parser.ParserValueExprTreeReleaseBorrow(borrowedTree)
        return Err[ParserNormalizedExprFunctionArtifact](
            " compiler parser receipt: value tree SoA shape mismatch")
    for exprIndex in 0..<layer.exprs.len:
        if parserReceiptExprIdentityMatchCount(identities,
                                               layer.exprs[exprIndex]) != 1:
            parser.ParserValueExprTreeReleaseBorrow(borrowedTree)
            return Err[ParserNormalizedExprFunctionArtifact](
                " compiler parser receipt: expression function identity is not exact")
    for scopeIndex in 0..<layer.scopes.len:
        if !parserReceiptScopeHasSourceIdentity(identities,
                                                layer.scopes[scopeIndex]):
            parser.ParserValueExprTreeReleaseBorrow(borrowedTree)
            return Err[ParserNormalizedExprFunctionArtifact](
                " compiler parser receipt: scope escapes source identity")
    var buf = layout.ByteBufInit(4096)
    parserReceiptAppendText(buf, ParserNormalizedExprArtifactDomain)
    parserReceiptAppendI32(buf, identities.len)
    for identityIndex in 0..<identities.len:
        parserReceiptAppendIdentity(buf, identities[identityIndex])
    parserReceiptAppendI32(buf, layer.sourceCount)
    parserReceiptAppendI32(buf, layer.questionResidualCount)
    parserReceiptAppendI32(buf, layer.exprs.len)
    for exprIndex in 0..<layer.exprs.len:
        parserReceiptAppendExpr(buf, layer.exprs[exprIndex])
    parserReceiptAppendI32(buf, layer.scopes.len)
    for scopeIndex in 0..<layer.scopes.len:
        parserReceiptAppendScope(buf, layer.scopes[scopeIndex])
    parserReceiptAppendTree(buf, borrowedTree)
    let artifactRaw32 = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    var counts: ParserNormalizedExprArtifactCounts
    counts.exprCount = Int64(layer.exprs.len)
    counts.scopeCount = Int64(layer.scopes.len)
    counts.questionResidualCount = Int64(layer.questionResidualCount)
    if borrowedTree != nil:
        counts.nodeCount = Int64(borrowedTree.nodeCount)
        counts.genericCount = Int64(borrowedTree.genericCount)
        counts.rootCount = Int64(borrowedTree.rootCount)
        counts.tokenCount = Int64(borrowedTree.tokenCount)
        counts.callEventCount = Int64(borrowedTree.callEventCount)
        counts.statementRootCount = Int64(
            borrowedTree.statementRootCount)
        counts.typeSyntaxCount = Int64(borrowedTree.typeSyntaxCount)
        counts.typeSyntaxChildCount = Int64(
            borrowedTree.typeSyntaxChildCount)
        counts.typeSyntaxBracketArgCount = Int64(
            borrowedTree.typeSyntaxBracketArgCount)
        counts.typeConstExprCount = Int64(
            borrowedTree.typeConstExprCount)
        counts.typeEnumVariantCount = Int64(
            borrowedTree.typeEnumVariantCount)
        counts.declarationCount = Int64(borrowedTree.declarationCount)
        counts.patternCount = Int64(borrowedTree.patternCount)
        counts.patternChildCount = Int64(borrowedTree.patternChildCount)
        counts.annotationCount = Int64(borrowedTree.annotationCount)
        counts.annotationArgCount = Int64(
            borrowedTree.annotationArgCount)
        counts.annotationArgRootCount = Int64(
            borrowedTree.annotationArgRootCount)
        counts.annotationArgChildCount = Int64(
            borrowedTree.annotationArgChildCount)
    var out: ParserNormalizedExprFunctionArtifact
    out.identity = share(identities[0])
    out.artifactRaw32 = artifactRaw32
    out.counts = counts
    parser.ParserValueExprTreeReleaseBorrow(borrowedTree)
    return Ok[ParserNormalizedExprFunctionArtifact](out)

fn ParserNormalizedExprFunctionArtifactBuild(
        layer: var parser.NormalizedExprLayer,
        identity: ParserNormalizedExprFunctionIdentity): Result[ParserNormalizedExprFunctionArtifact] =
    var identities: ParserNormalizedExprFunctionIdentity[]
    add(identities, identity)
    return parserNormalizedExprLayerArtifactBuild(layer, identities)

@borrows
fn parserReceiptCloneImportEdge(edge: parser.ImportEdge): parser.ImportEdge =
    var out: parser.ImportEdge
    out.ownerProducerSourceIndex = edge.ownerProducerSourceIndex
    out.importDeclarationSourceLocalRow =
        edge.importDeclarationSourceLocalRow
    out.importItemSourceLocalRow = edge.importItemSourceLocalRow
    out.importDeclarationRow = edge.importDeclarationRow
    out.importItemRow = edge.importItemRow
    out.ownerModulePath = parser.ParserOwnedText(edge.ownerModulePath)
    out.targetModulePath = parser.ParserOwnedText(edge.targetModulePath)
    out.targetSourcePath = parser.ParserOwnedText(edge.targetSourcePath)
    out.targetSourcePathLen = edge.targetSourcePathLen
    out.targetSourcePathFirstCode = edge.targetSourcePathFirstCode
    out.targetSourcePathLastCode = edge.targetSourcePathLastCode
    out.targetSourcePathDotCount = edge.targetSourcePathDotCount
    out.targetSourcePathHash = edge.targetSourcePathHash
    out.targetProfileIndex = edge.targetProfileIndex
    out.importAlias = parser.ParserOwnedText(edge.importAlias)
    out.qualifier = parser.ParserOwnedText(edge.qualifier)
    out.allowsUnqualifiedCall = edge.allowsUnqualifiedCall
    out.resolved = edge.resolved
    return out

@borrows
fn parserReceiptImportEdgeLess(left: parser.ImportEdge,
                               right: parser.ImportEdge): bool =
    if left.ownerProducerSourceIndex != right.ownerProducerSourceIndex:
        return left.ownerProducerSourceIndex <
               right.ownerProducerSourceIndex
    if left.importDeclarationSourceLocalRow !=
           right.importDeclarationSourceLocalRow:
        return left.importDeclarationSourceLocalRow <
               right.importDeclarationSourceLocalRow
    if left.importItemSourceLocalRow != right.importItemSourceLocalRow:
        return left.importItemSourceLocalRow <
               right.importItemSourceLocalRow
    if left.importDeclarationRow != right.importDeclarationRow:
        return left.importDeclarationRow < right.importDeclarationRow
    if left.importItemRow != right.importItemRow:
        return left.importItemRow < right.importItemRow
    if left.ownerModulePath != right.ownerModulePath:
        return parserReceiptTextLess(left.ownerModulePath,
                                     right.ownerModulePath)
    if left.targetModulePath != right.targetModulePath:
        return parserReceiptTextLess(left.targetModulePath,
                                     right.targetModulePath)
    if left.targetSourcePath != right.targetSourcePath:
        return parserReceiptTextLess(left.targetSourcePath,
                                     right.targetSourcePath)
    if left.targetProfileIndex != right.targetProfileIndex:
        return left.targetProfileIndex < right.targetProfileIndex
    if left.importAlias != right.importAlias:
        return parserReceiptTextLess(left.importAlias, right.importAlias)
    if left.qualifier != right.qualifier:
        return parserReceiptTextLess(left.qualifier, right.qualifier)
    if left.allowsUnqualifiedCall != right.allowsUnqualifiedCall:
        return !left.allowsUnqualifiedCall
    if left.resolved != right.resolved:
        return !left.resolved
    return false

fn parserReceiptInsertCanonicalImportEdge(
        edges: var parser.ImportEdge[],
        edge: parser.ImportEdge) =
    var insertIndex = edges.len
    add(edges, share(edge))
    while insertIndex > 0 &&
          parserReceiptImportEdgeLess(edge, edges[insertIndex - 1]):
        edges[insertIndex] = edges[insertIndex - 1]
        insertIndex = insertIndex - 1
    edges[insertIndex] = edge

@borrows
fn ParserNormalizedExprReceiptAccumulatorInit(
        predecessorRaw32: layout.FixedBytes32,
        sourcePaths: str[],
        ownerModulePaths: str[],
        importEdges: parser.ImportEdge[],
        expectedFunctionCount: int32): Result[ParserNormalizedExprReceiptAccumulator] =
    if sourcePaths.len <= 0 || sourcePaths.len != ownerModulePaths.len ||
       expectedFunctionCount < 0:
        return Err[ParserNormalizedExprReceiptAccumulator](
            " compiler parser receipt: invalid accumulator domain")
    var out: ParserNormalizedExprReceiptAccumulator
    out.active = true
    out.predecessorRaw32 = predecessorRaw32
    for sourceIndex in 0..<sourcePaths.len:
        if sourcePaths[sourceIndex] == "" || ownerModulePaths[sourceIndex] == "":
            return Err[ParserNormalizedExprReceiptAccumulator](
                " compiler parser receipt: empty source identity")
        # sourceIndex is the parser/CompilerCSG profile identity.  Its order is
        # already committed by predecessorRaw32 (the sealed source-bundle CID),
        # so re-sorting here would sever every later function/profile index from
        # the source identity consumed by lowering.  Preserve that exact order;
        # canonical graph validation belongs to the source-bundle producer.
        add(out.sourcePaths,
            parser.ParserOwnedText(sourcePaths[sourceIndex]))
        add(out.ownerModulePaths,
            parser.ParserOwnedText(ownerModulePaths[sourceIndex]))
    for edgeIndex in 0..<importEdges.len:
        let edge = importEdges[edgeIndex]
        if edge.ownerModulePath == "" || edge.targetModulePath == "" ||
           edge.targetSourcePath == "" || !edge.resolved:
            return Err[ParserNormalizedExprReceiptAccumulator](
                " compiler parser receipt: invalid import edge")
        parserReceiptInsertCanonicalImportEdge(
            out.importEdges,
            parserReceiptCloneImportEdge(edge))
    setLen(out.sourceSidecarPresent, sourcePaths.len)
    setLen(out.sourceSidecars, sourcePaths.len)
    setLen(out.functionPresent, expectedFunctionCount)
    setLen(out.functionVerified, expectedFunctionCount)
    setLen(out.functionArtifacts, expectedFunctionCount)
    return Ok[ParserNormalizedExprReceiptAccumulator](out)

@borrows
fn parserReceiptIdentityEqual(
        left: ParserNormalizedExprFunctionIdentity,
        right: ParserNormalizedExprFunctionIdentity): bool =
    return left.sourceIndex == right.sourceIndex &&
           left.functionIndex == right.functionIndex &&
           left.sourcePath == right.sourcePath &&
           left.ownerModulePath == right.ownerModulePath &&
           left.functionName == right.functionName &&
           left.signatureLineNumber == right.signatureLineNumber &&
           left.endLineNumber == right.endLineNumber

fn parserReceiptCountsEqual(
        left: ParserNormalizedExprArtifactCounts,
        right: ParserNormalizedExprArtifactCounts): bool =
    return left.exprCount == right.exprCount &&
           left.scopeCount == right.scopeCount &&
           left.nodeCount == right.nodeCount &&
           left.genericCount == right.genericCount &&
           left.rootCount == right.rootCount &&
           left.tokenCount == right.tokenCount &&
           left.callEventCount == right.callEventCount &&
           left.statementRootCount == right.statementRootCount &&
           left.typeSyntaxCount == right.typeSyntaxCount &&
           left.typeSyntaxChildCount == right.typeSyntaxChildCount &&
           left.typeSyntaxBracketArgCount ==
               right.typeSyntaxBracketArgCount &&
           left.typeConstExprCount == right.typeConstExprCount &&
           left.typeEnumVariantCount == right.typeEnumVariantCount &&
           left.declarationCount == right.declarationCount &&
           left.patternCount == right.patternCount &&
           left.patternChildCount == right.patternChildCount &&
           left.annotationCount == right.annotationCount &&
           left.annotationArgCount == right.annotationArgCount &&
           left.annotationArgRootCount == right.annotationArgRootCount &&
           left.annotationArgChildCount ==
               right.annotationArgChildCount &&
           left.questionResidualCount == right.questionResidualCount

@borrows
fn parserReceiptFunctionSidecarExactlyEmpty(
        sidecar: ParserCanonicalSourceSidecar): bool =
    return sidecar.functionIndexes.len == 0 &&
           sidecar.functionNames.len == 0 &&
           sidecar.functionSignatureLineNumbers.len == 0 &&
           sidecar.functionDeclarationSpanIds.len == 0 &&
           sidecar.functionDeclarationHeaderSpanIds.len == 0 &&
           sidecar.functionDeclarationOrdinals.len == 0 &&
           sidecar.functionDeclarationHeaderCids.len == 0 &&
           sidecar.functionDeclarationPathCids.len == 0 &&
           sidecar.functionNameSpanIds.len == 0 &&
           sidecar.functionNameSurfaceKinds.len == 0 &&
           sidecar.functionNameProofCids.len == 0 &&
           sidecar.functionBodySpanIds.len == 0 &&
           sidecar.functionAnnotationFlags.len == 0 &&
           sidecar.functionManualConsumeTargetParameterOrdinals.len == 0 &&
           sidecar.functionManualConsumeTargetParameterDeclarationSourceLocalRows.len == 0 &&
           sidecar.functionManualConsumeSourceParameterOrdinals.len == 0 &&
           sidecar.functionManualConsumeSourceParameterDeclarationSourceLocalRows.len == 0 &&
           sidecar.normalizedExprParserNodeIds.len == 0

@borrows
fn ParserNormalizedExprReceiptObserveSourceTree(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        sourceIndex: int32,
        sourceText: str,
        parserInputText: str,
        tree: parser.ParserValueExprTree,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[]): Result[bool] =
    if !accumulator.active || sourceIndex < 0 ||
       sourceIndex >= accumulator.sourcePaths.len ||
       accumulator.sourceSidecarPresent.len != accumulator.sourcePaths.len ||
       accumulator.sourceSidecars.len != accumulator.sourcePaths.len:
        return Err[bool](
            " compiler parser receipt: invalid source-tree observation")
    if accumulator.sourceSidecarPresent[sourceIndex]:
        return Err[bool](
            " compiler parser receipt: duplicate source-tree observation")
    var sidecar: ParserCanonicalSourceSidecar
    var sidecarErr: str
    if !ParserCanonicalSourceSidecarBuildInto(sourceIndex,
                                               sourceText,
                                               parserInputText,
                                               tree,
                                               identities,
                                               declarations,
                                               sidecar,
                                               sidecarErr):
        return Err[bool](sidecarErr)
    if !parserReceiptProjectNormalizedExprIdentitiesForSourceInto(
           accumulator, sourceIndex, sidecar, sidecarErr):
        return Err[bool](sidecarErr)
    if !ParserCanonicalSourceSidecarStrictValidateInto(sidecar, sidecarErr):
        return Err[bool](sidecarErr)
    accumulator.sourceSidecars[sourceIndex] = sidecar
    accumulator.sourceSidecarPresent[sourceIndex] = true
    return Ok[bool](true)

fn ParserNormalizedExprReceiptObserveSourceText(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        sourceIndex: int32,
        sourceText: str,
        migrationSourceSyntax: bool,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[]): Result[bool] =
    if !accumulator.active || sourceIndex < 0 ||
       sourceIndex >= accumulator.sourcePaths.len ||
       accumulator.sourceSidecarPresent.len != accumulator.sourcePaths.len ||
       accumulator.sourceSidecars.len != accumulator.sourcePaths.len:
        return Err[bool](
            " compiler parser receipt: invalid source-text observation")
    if accumulator.sourceSidecarPresent[sourceIndex]:
        return Err[bool](
            " compiler parser receipt: duplicate source-text observation")
    var sidecar: ParserCanonicalSourceSidecar
    var sidecarErr: str
    if !ParserCanonicalSourceSidecarBuildFromSourceInto(
           sourceIndex,
           sourceText,
           migrationSourceSyntax,
           identities,
           declarations,
           sidecar,
           sidecarErr):
        return Err[bool](sidecarErr)
    if !parserReceiptProjectNormalizedExprIdentitiesForSourceInto(
           accumulator, sourceIndex, sidecar, sidecarErr):
        return Err[bool](sidecarErr)
    if !ParserCanonicalSourceSidecarStrictValidateInto(sidecar, sidecarErr):
        return Err[bool](sidecarErr)
    accumulator.sourceSidecars[sourceIndex] = sidecar
    accumulator.sourceSidecarPresent[sourceIndex] = true
    return Ok[bool](true)

@borrows
fn parserReceiptNormalizedExprIdentityNode(
        expr: parser.NormalizedExpr): int32 =
    # A nested Call shares its enclosing statement root with the direct
    # statement fact, but owns a distinct parser call node.  Receipt identity
    # therefore follows the expression's exact origin first; consumers recover
    # the enclosing statement through the parser parent/root sidecars.
    if expr.originParserNodeId >= 0:
        return expr.originParserNodeId
    return expr.valueExprRootNodeIndex

fn parserReceiptProjectNormalizedExprIdentitiesForSourceInto(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        sourceIndex: int32,
        sidecar: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    sidecar.normalizedExprProducerSourceIds = []
    sidecar.normalizedExprSourceLocalRows = []
    sidecar.normalizedExprFunctionIndexes = []
    sidecar.normalizedExprParserNodeIds = []
    sidecar.normalizedExprKinds = []
    sidecar.normalizedExprStatementRoles = []
    for pendingRow in 0..<
            accumulator.normalizedExprParserNodeIds.len:
        if accumulator.normalizedExprProducerSourceIds[pendingRow] !=
               sourceIndex:
            continue
        let sourceLocalRow =
            sidecar.normalizedExprParserNodeIds.len
        add(sidecar.normalizedExprProducerSourceIds, sourceIndex)
        add(sidecar.normalizedExprSourceLocalRows, sourceLocalRow)
        add(sidecar.normalizedExprFunctionIndexes,
            accumulator.normalizedExprFunctionIndexes[pendingRow])
        add(sidecar.normalizedExprParserNodeIds,
            accumulator.normalizedExprParserNodeIds[pendingRow])
        add(sidecar.normalizedExprKinds,
            accumulator.normalizedExprKinds[pendingRow])
        add(sidecar.normalizedExprStatementRoles,
            accumulator.normalizedExprStatementRoles[pendingRow])
    return ParserCanonicalSourceSidecarSealInto(sidecar, err)

@borrows
fn parserReceiptObserveNormalizedExprIdentitiesInto(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        layer: var parser.NormalizedExprLayer,
        identity: ParserNormalizedExprFunctionIdentity,
        err: var str): bool =
    if identity.sourceIndex < 0 ||
       identity.sourceIndex >= accumulator.sourceSidecars.len ||
       layer.valueExprTree == nil ||
       layer.valueExprTree.producerSourceCount != 1:
        err = " compiler parser receipt: normalized expression source owner missing"
        return false
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        let parserNodeId =
            parserReceiptNormalizedExprIdentityNode(expr)
        if parserNodeId < 0 ||
           parserNodeId >= layer.valueExprTree.nodeCount:
            err = Fmt" compiler parser receipt: normalized expression parser node missing exprIndex={exprIndex} kind={parser.NormalizedExprKindCode(expr.kind)} line={expr.lineNumber} surface={expr.surfaceText} rootNode={expr.valueExprRootNodeIndex} originNode={expr.originParserNodeId} role={Int32(expr.valueExprStatementRole)}"
            return false
        let kind = parser.NormalizedExprKindCode(expr.kind)
        let statementRole = Int32(expr.valueExprStatementRole)
        for previous in 0..<
                accumulator.normalizedExprParserNodeIds.len:
            if accumulator.normalizedExprProducerSourceIds[previous] ==
                   identity.sourceIndex &&
               accumulator.normalizedExprFunctionIndexes[previous] ==
                   identity.functionIndex &&
               accumulator.normalizedExprParserNodeIds[previous] ==
                   parserNodeId &&
               accumulator.normalizedExprKinds[previous] == kind &&
               accumulator.normalizedExprStatementRoles[previous] ==
                   statementRole:
                err = " compiler parser receipt: duplicate normalized expression identity"
                return false
        add(accumulator.normalizedExprProducerSourceIds,
            identity.sourceIndex)
        add(accumulator.normalizedExprFunctionIndexes,
            identity.functionIndex)
        add(accumulator.normalizedExprParserNodeIds, parserNodeId)
        add(accumulator.normalizedExprKinds, kind)
        add(accumulator.normalizedExprStatementRoles,
            statementRole)
    if accumulator.sourceSidecarPresent[identity.sourceIndex]:
        var sidecar =
            accumulator.sourceSidecars[identity.sourceIndex]
        if !parserReceiptProjectNormalizedExprIdentitiesForSourceInto(
               accumulator, identity.sourceIndex, sidecar, err):
            return false
        accumulator.sourceSidecars[identity.sourceIndex] = sidecar
    err = ""
    return true

@borrows
fn parserReceiptVerifyNormalizedExprIdentitiesInto(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        layer: var parser.NormalizedExprLayer,
        identity: ParserNormalizedExprFunctionIdentity,
        err: var str): bool =
    var exprCursor: int32
    for row in 0..<accumulator.normalizedExprParserNodeIds.len:
        if accumulator.normalizedExprFunctionIndexes[row] !=
               identity.functionIndex:
            continue
        if exprCursor >= layer.exprs.len:
            err = " compiler parser receipt: extra normalized expression identity"
            return false
        let expr = layer.exprs[exprCursor]
        if accumulator.normalizedExprProducerSourceIds[row] !=
               identity.sourceIndex ||
           accumulator.normalizedExprParserNodeIds[row] !=
               parserReceiptNormalizedExprIdentityNode(expr) ||
           accumulator.normalizedExprKinds[row] !=
               parser.NormalizedExprKindCode(expr.kind) ||
           accumulator.normalizedExprStatementRoles[row] !=
               Int32(expr.valueExprStatementRole):
            err = " compiler parser receipt: normalized expression identity drift"
            return false
        exprCursor = exprCursor + 1
    if exprCursor != layer.exprs.len:
        err = " compiler parser receipt: normalized expression identity coverage missing"
        return false
    err = ""
    return true

@borrows
fn ParserNormalizedExprReceiptObserveFunctions(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        layer: var parser.NormalizedExprLayer,
        identities: ParserNormalizedExprFunctionIdentity[]): Result[bool] =
    if !accumulator.active || identities.len <= 0:
        return Err[bool](" compiler parser receipt: inactive or empty observation")
    for identityIndex in 0..<identities.len:
        let identity = identities[identityIndex]
        if identity.functionIndex < 0 ||
           identity.functionIndex >= accumulator.functionPresent.len:
            return Err[bool](
                " compiler parser receipt: function outside accumulator domain")
        if accumulator.functionPresent[identity.functionIndex]:
            return Err[bool](
                " compiler parser receipt: duplicate function observation")
        if identity.sourceIndex < 0 ||
           identity.sourceIndex >= accumulator.sourcePaths.len ||
           accumulator.sourcePaths[identity.sourceIndex] !=
               identity.sourcePath ||
           accumulator.ownerModulePaths[identity.sourceIndex] !=
               identity.ownerModulePath:
            return Err[bool](
                " compiler parser receipt: function source identity mismatch")
    let artifactRes = parserNormalizedExprLayerArtifactBuild(layer, identities)
    if IsErr(artifactRes):
        return Err[bool](Error(artifactRes))
    let artifact = Value(artifactRes)
    var identityErr: str
    if !parserReceiptObserveNormalizedExprIdentitiesInto(
           accumulator, layer, identities[0], identityErr):
        return Err[bool](identityErr)
    for identityIndex in 0..<identities.len:
        let identity = identities[identityIndex]
        var functionArtifact: ParserNormalizedExprFunctionArtifact
        functionArtifact.identity = share(identity)
        functionArtifact.artifactRaw32 = artifact.artifactRaw32
        if identityIndex == 0:
            functionArtifact.counts = artifact.counts
        accumulator.functionArtifacts[identity.functionIndex] = functionArtifact
        accumulator.functionPresent[identity.functionIndex] = true
    return Ok[bool](true)

fn ParserNormalizedExprReceiptObserveFunction(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        layer: var parser.NormalizedExprLayer,
        identity: ParserNormalizedExprFunctionIdentity): Result[bool] =
    var identities: ParserNormalizedExprFunctionIdentity[]
    add(identities, identity)
    return ParserNormalizedExprReceiptObserveFunctions(
        accumulator, layer, identities)

@borrows
fn ParserNormalizedExprReceiptVerifyObservedFunctions(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        layer: var parser.NormalizedExprLayer,
        identities: ParserNormalizedExprFunctionIdentity[]): Result[bool] =
    if !accumulator.active || identities.len <= 0:
        return Err[bool](" compiler parser receipt: inactive or empty verification")
    let rebuiltRes = parserNormalizedExprLayerArtifactBuild(layer, identities)
    if IsErr(rebuiltRes):
        return Err[bool](Error(rebuiltRes))
    let rebuilt = Value(rebuiltRes)
    let primaryIdentity = identities[0]
    var identityErr: str
    if primaryIdentity.sourceIndex < 0 ||
       primaryIdentity.sourceIndex >= accumulator.sourceSidecars.len ||
       !parserReceiptVerifyNormalizedExprIdentitiesInto(
            accumulator,
            layer,
            primaryIdentity,
            identityErr):
        if identityErr == "":
            identityErr =
                " compiler parser receipt: normalized expression source unavailable"
        return Err[bool](identityErr)
    for identityIndex in 0..<identities.len:
        let identity = identities[identityIndex]
        if identity.functionIndex < 0 ||
           identity.functionIndex >= accumulator.functionPresent.len ||
           !accumulator.functionPresent[identity.functionIndex]:
            return Err[bool](
                " compiler parser receipt: function was not observed")
        let observed = accumulator.functionArtifacts[identity.functionIndex]
        if !parserReceiptIdentityEqual(observed.identity, identity) ||
           !layout.FixedBytes32Equal(observed.artifactRaw32,
                                     rebuilt.artifactRaw32) ||
           (identityIndex == 0 &&
            !parserReceiptCountsEqual(observed.counts, rebuilt.counts)):
            return Err[bool](
                " compiler parser receipt: function artifact changed before consumer")
    for identityIndex in 0..<identities.len:
        accumulator.functionVerified[identities[identityIndex].functionIndex] =
            true
    return Ok[bool](true)

fn ParserNormalizedExprReceiptVerifyObservedFunction(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        layer: var parser.NormalizedExprLayer,
        identity: ParserNormalizedExprFunctionIdentity): Result[bool] =
    var identities: ParserNormalizedExprFunctionIdentity[]
    add(identities, identity)
    return ParserNormalizedExprReceiptVerifyObservedFunctions(
        accumulator, layer, identities)

@borrows
fn parserReceiptIdentityLess(
        left: ParserNormalizedExprFunctionIdentity,
        right: ParserNormalizedExprFunctionIdentity): bool =
    if left.sourceIndex != right.sourceIndex:
        return left.sourceIndex < right.sourceIndex
    if left.signatureLineNumber != right.signatureLineNumber:
        return left.signatureLineNumber < right.signatureLineNumber
    if left.endLineNumber != right.endLineNumber:
        return left.endLineNumber < right.endLineNumber
    if left.functionName != right.functionName:
        return parserReceiptTextLess(left.functionName, right.functionName)
    return left.functionIndex < right.functionIndex

@borrows
fn parserReceiptAppendImportEdge(buf: var layout.ByteBuf,
                                 edge: parser.ImportEdge) =
    parserReceiptAppendI32(buf, edge.ownerProducerSourceIndex)
    parserReceiptAppendI32(
        buf, edge.importDeclarationSourceLocalRow)
    parserReceiptAppendI32(buf, edge.importItemSourceLocalRow)
    parserReceiptAppendI32(buf, edge.importDeclarationRow)
    parserReceiptAppendI32(buf, edge.importItemRow)
    parserReceiptAppendText(buf, edge.ownerModulePath)
    parserReceiptAppendText(buf, edge.targetModulePath)
    parserReceiptAppendText(buf, edge.targetSourcePath)
    parserReceiptAppendI32(buf, edge.targetSourcePathLen)
    parserReceiptAppendI32(buf, edge.targetSourcePathFirstCode)
    parserReceiptAppendI32(buf, edge.targetSourcePathLastCode)
    parserReceiptAppendI32(buf, edge.targetSourcePathDotCount)
    parserReceiptAppendI32(buf, edge.targetSourcePathHash)
    parserReceiptAppendI32(buf, edge.targetProfileIndex)
    parserReceiptAppendText(buf, edge.importAlias)
    parserReceiptAppendText(buf, edge.qualifier)
    parserReceiptAppendBool(buf, edge.allowsUnqualifiedCall)
    parserReceiptAppendBool(buf, edge.resolved)

@borrows
fn parserReceiptAppendCounts(buf: var layout.ByteBuf,
                             counts: ParserNormalizedExprArtifactCounts) =
    parserReceiptAppendI64(buf, counts.annotationArgChildCount)
    parserReceiptAppendI64(buf, counts.annotationArgCount)
    parserReceiptAppendI64(buf, counts.annotationArgRootCount)
    parserReceiptAppendI64(buf, counts.annotationCount)
    parserReceiptAppendI64(buf, counts.callEventCount)
    parserReceiptAppendI64(buf, counts.exprCount)
    parserReceiptAppendI64(buf, counts.genericCount)
    parserReceiptAppendI64(buf, counts.nodeCount)
    parserReceiptAppendI64(buf, counts.questionResidualCount)
    parserReceiptAppendI64(buf, counts.rootCount)
    parserReceiptAppendI64(buf, counts.scopeCount)
    parserReceiptAppendI64(buf, counts.statementRootCount)
    parserReceiptAppendI64(buf, counts.tokenCount)
    parserReceiptAppendI64(buf, counts.typeSyntaxCount)
    parserReceiptAppendI64(buf, counts.typeSyntaxChildCount)
    parserReceiptAppendI64(buf, counts.typeSyntaxBracketArgCount)
    parserReceiptAppendI64(buf, counts.typeConstExprCount)
    parserReceiptAppendI64(buf, counts.typeEnumVariantCount)
    parserReceiptAppendI64(buf, counts.declarationCount)
    parserReceiptAppendI64(buf, counts.patternCount)
    parserReceiptAppendI64(buf, counts.patternChildCount)

fn parserReceiptAccumulateCounts(
        total: var ParserNormalizedExprArtifactCounts,
        next: ParserNormalizedExprArtifactCounts) =
    total.exprCount = total.exprCount + next.exprCount
    total.questionResidualCount = total.questionResidualCount +
                                  next.questionResidualCount
    total.scopeCount = total.scopeCount + next.scopeCount

fn parserReceiptCountKeys(): str[] =
    var out: str[]
    add(out, "annotation_arg_child_count")
    add(out, "annotation_arg_count")
    add(out, "annotation_arg_root_count")
    add(out, "annotation_count")
    add(out, "call_event_count")
    add(out, "declaration_count")
    add(out, "expr_count")
    add(out, "function_count")
    add(out, "generic_count")
    add(out, "import_edge_count")
    add(out, "node_count")
    add(out, "pattern_child_count")
    add(out, "pattern_count")
    add(out, "question_residual_count")
    add(out, "root_count")
    add(out, "scope_count")
    add(out, "source_count")
    add(out, "statement_root_count")
    add(out, "token_count")
    add(out, "type_const_expr_count")
    add(out, "type_enum_variant_count")
    add(out, "type_syntax_bracket_arg_count")
    add(out, "type_syntax_child_count")
    add(out, "type_syntax_count")
    return out

fn parserReceiptCountValues(
        counts: ParserNormalizedExprArtifactCounts,
        functionCount: int64,
        importEdgeCount: int64,
    sourceCount: int64): int64[] =
    var out: int64[]
    add(out, counts.annotationArgChildCount)
    add(out, counts.annotationArgCount)
    add(out, counts.annotationArgRootCount)
    add(out, counts.annotationCount)
    add(out, counts.callEventCount)
    add(out, counts.declarationCount)
    add(out, counts.exprCount)
    add(out, functionCount)
    add(out, counts.genericCount)
    add(out, importEdgeCount)
    add(out, counts.nodeCount)
    add(out, counts.patternChildCount)
    add(out, counts.patternCount)
    add(out, counts.questionResidualCount)
    add(out, counts.rootCount)
    add(out, counts.scopeCount)
    add(out, sourceCount)
    add(out, counts.statementRootCount)
    add(out, counts.tokenCount)
    add(out, counts.typeConstExprCount)
    add(out, counts.typeEnumVariantCount)
    add(out, counts.typeSyntaxBracketArgCount)
    add(out, counts.typeSyntaxChildCount)
    add(out, counts.typeSyntaxCount)
    return out

fn ParserNormalizedExprReceiptFinalize(
        accumulator: var ParserNormalizedExprReceiptAccumulator,
        reachableFunctions: bool[]): Result[ParserNormalizedExprReceipt] =
    if !accumulator.active ||
       reachableFunctions.len != accumulator.functionPresent.len:
        return Err[ParserNormalizedExprReceipt](
            " compiler parser receipt: invalid finalize domain")
    var buf = layout.ByteBufInit(4096)
    parserReceiptAppendText(buf, ParserNormalizedExprAggregateDomain)
    parserReceiptAppendI32(buf, accumulator.sourcePaths.len)
    for sourceIndex in 0..<accumulator.sourcePaths.len:
        parserReceiptAppendI32(buf, sourceIndex)
        parserReceiptAppendText(buf, accumulator.sourcePaths[sourceIndex])
        parserReceiptAppendText(buf,
                                accumulator.ownerModulePaths[sourceIndex])
    parserReceiptAppendI32(buf, accumulator.importEdges.len)
    for edgeIndex in 0..<accumulator.importEdges.len:
        parserReceiptAppendImportEdge(buf, accumulator.importEdges[edgeIndex])
    var counts: ParserNormalizedExprArtifactCounts
    if accumulator.sourceSidecarPresent.len != accumulator.sourcePaths.len ||
       accumulator.sourceSidecars.len != accumulator.sourcePaths.len ||
       accumulator.normalizedExprParserNodeIds.len !=
           accumulator.normalizedExprProducerSourceIds.len ||
       accumulator.normalizedExprParserNodeIds.len !=
           accumulator.normalizedExprFunctionIndexes.len ||
       accumulator.normalizedExprParserNodeIds.len !=
           accumulator.normalizedExprKinds.len ||
       accumulator.normalizedExprParserNodeIds.len !=
           accumulator.normalizedExprStatementRoles.len:
        layout.ByteBufFree(buf)
        return Err[ParserNormalizedExprReceipt](
            " compiler parser receipt: source sidecar columns mismatch")
    parserReceiptAppendI32(buf, accumulator.sourceSidecars.len)
    var diagnosticRowCursor: int32
    for sourceIndex in 0..<accumulator.sourceSidecars.len:
        var sidecar = accumulator.sourceSidecars[sourceIndex]
        sidecar.diagnosticRowStart = diagnosticRowCursor
        sidecar.diagnosticRowCount =
            sidecar.diagnosticAnchorNodeIds.len
        diagnosticRowCursor =
            diagnosticRowCursor + sidecar.diagnosticRowCount
        sidecar.diagnosticCompletionRaw32 =
            parserDiagnosticCompletionRaw32(sidecar)
        accumulator.sourceSidecars[sourceIndex] = sidecar
    var functionSidecarsExactlyEmpty = true
    for sourceIndex in 0..<accumulator.sourceSidecars.len:
        var sidecarErr: str
        if !accumulator.sourceSidecarPresent[sourceIndex] ||
           accumulator.sourceSidecars[sourceIndex].sourceIndex != sourceIndex ||
           !ParserCanonicalSourceSidecarStrictValidateInto(
               accumulator.sourceSidecars[sourceIndex], sidecarErr):
            layout.ByteBufFree(buf)
            if sidecarErr != "":
                return Err[ParserNormalizedExprReceipt](sidecarErr)
            return Err[ParserNormalizedExprReceipt](
                " compiler parser receipt: source sidecar coverage mismatch")
        let sidecar = accumulator.sourceSidecars[sourceIndex]
        if !parserReceiptFunctionSidecarExactlyEmpty(sidecar):
            functionSidecarsExactlyEmpty = false
        parserReceiptAppendI32(buf, sourceIndex)
        parserReceiptAppendFixed32(buf, sidecar.sidecarRaw32)
        counts.nodeCount = counts.nodeCount + Int64(sidecar.nodeKinds.len)
        counts.genericCount = counts.genericCount +
                              Int64(sidecar.genericSpanIds.len)
        counts.rootCount = counts.rootCount + Int64(sidecar.rootNodeIds.len)
        counts.tokenCount = counts.tokenCount + Int64(sidecar.tokenKinds.len)
        counts.callEventCount = counts.callEventCount +
                                Int64(sidecar.callEventNodeIds.len)
        counts.statementRootCount = counts.statementRootCount +
                                    Int64(sidecar.statementRootNodeIds.len)
        counts.typeSyntaxCount = counts.typeSyntaxCount +
                                 Int64(sidecar.typeSyntaxKinds.len)
        counts.typeSyntaxChildCount = counts.typeSyntaxChildCount +
                                      Int64(sidecar.typeSyntaxChildIds.len)
        counts.typeSyntaxBracketArgCount =
            counts.typeSyntaxBracketArgCount +
            Int64(sidecar.typeSyntaxBracketArgTokenStarts.len)
        counts.typeConstExprCount = counts.typeConstExprCount +
            Int64(sidecar.typeConstExprKinds.len)
        counts.typeEnumVariantCount = counts.typeEnumVariantCount +
                                      Int64(
                                          sidecar.typeEnumVariantNameTokenIds.len)
        counts.declarationCount = counts.declarationCount +
                                  Int64(sidecar.declarationKinds.len)
        counts.patternCount = counts.patternCount +
                              Int64(sidecar.patternKinds.len)
        counts.patternChildCount = counts.patternChildCount +
                                   Int64(sidecar.patternChildIds.len)
        counts.annotationCount = counts.annotationCount +
                                 Int64(
                                     sidecar.annotationProducerSourceIds.len)
        counts.annotationArgCount = counts.annotationArgCount +
                                    Int64(
                                        sidecar.annotationArgProducerSourceIds.len)
        counts.annotationArgRootCount =
            counts.annotationArgRootCount +
            Int64(sidecar.annotationArgRootIds.len)
        counts.annotationArgChildCount =
            counts.annotationArgChildCount +
            Int64(sidecar.annotationArgChildIds.len)
    var functionCount: int64
    var verifiedFunctionCount: int64
    var canonicalFunctionIndexes: int32[]
    for functionIndex in 0..<reachableFunctions.len:
        if reachableFunctions[functionIndex] !=
               accumulator.functionPresent[functionIndex]:
            layout.ByteBufFree(buf)
            return Err[ParserNormalizedExprReceipt](
                " compiler parser receipt: reachable function coverage mismatch")
        if !reachableFunctions[functionIndex]:
            continue
        if !accumulator.functionVerified[functionIndex]:
            layout.ByteBufFree(buf)
            return Err[ParserNormalizedExprReceipt](
                " compiler parser receipt: function consumer verification missing")
        let identity = accumulator.functionArtifacts[functionIndex].identity
        if identity.functionIndex != functionIndex:
            layout.ByteBufFree(buf)
            return Err[ParserNormalizedExprReceipt](
                " compiler parser receipt: dense function identity mismatch")
        var insertIndex = canonicalFunctionIndexes.len
        add(canonicalFunctionIndexes, functionIndex)
        while insertIndex > 0 &&
              parserReceiptIdentityLess(
                  identity,
                  accumulator.functionArtifacts[
                      canonicalFunctionIndexes[insertIndex - 1]].identity):
            canonicalFunctionIndexes[insertIndex] =
                canonicalFunctionIndexes[insertIndex - 1]
            insertIndex = insertIndex - 1
        canonicalFunctionIndexes[insertIndex] = functionIndex
    for orderIndex in 0..<canonicalFunctionIndexes.len:
        let functionIndex = canonicalFunctionIndexes[orderIndex]
        let artifact = accumulator.functionArtifacts[functionIndex]
        if orderIndex > 0:
            let previousArtifact = accumulator.functionArtifacts[
                canonicalFunctionIndexes[orderIndex - 1]]
            if !parserReceiptIdentityLess(
                   previousArtifact.identity, artifact.identity):
                layout.ByteBufFree(buf)
                return Err[ParserNormalizedExprReceipt](
                    " compiler parser receipt: function identity order is not canonical")
        parserReceiptAppendIdentity(buf, artifact.identity)
        parserReceiptAppendFixed32(buf, artifact.artifactRaw32)
        parserReceiptAppendCounts(buf, artifact.counts)
        parserReceiptAccumulateCounts(counts, artifact.counts)
        functionCount = functionCount + Int64(1)
        verifiedFunctionCount = verifiedFunctionCount + Int64(1)
    var normalizedExprIdentityCount: int64
    for sourceIndex in 0..<accumulator.sourceSidecars.len:
        normalizedExprIdentityCount =
            normalizedExprIdentityCount +
            Int64(accumulator.sourceSidecars[
                sourceIndex].normalizedExprParserNodeIds.len)
    if normalizedExprIdentityCount != counts.exprCount:
        layout.ByteBufFree(buf)
        return Err[ParserNormalizedExprReceipt](
            " compiler parser receipt: normalized expression identity count mismatch")
    let aggregateBaseRaw32 = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    if verifiedFunctionCount != functionCount ||
       (functionCount == Int64(0) &&
        (verifiedFunctionCount != Int64(0) ||
         accumulator.functionPresent.len != 0 ||
         accumulator.functionVerified.len != 0 ||
         accumulator.functionArtifacts.len != 0 ||
         accumulator.normalizedExprParserNodeIds.len != 0 ||
         canonicalFunctionIndexes.len != 0 ||
         !functionSidecarsExactlyEmpty)):
        return Err[ParserNormalizedExprReceipt](
            " compiler parser receipt: invalid or unverified function closure")
    let countKeys = parserReceiptCountKeys()
    let countValues = parserReceiptCountValues(
        counts,
        functionCount,
        Int64(accumulator.importEdges.len),
        Int64(accumulator.sourcePaths.len))
    let canonicalParserRootRaw32 = parserCanonicalSidecarsRoot(
        accumulator.sourceSidecars)
    let artifactRaw32 = parserCanonicalAggregateArtifact(
        aggregateBaseRaw32, canonicalParserRootRaw32)
    let envelopeRes = stage_receipt.CompilerStageReceiptMake(
        stage_receipt.CompilerStageReceiptStageParser,
        stage_receipt.CompilerStageReceiptLaneShared,
        ParserNormalizedExprProducerIdentity,
        accumulator.predecessorRaw32,
        artifactRaw32,
        countKeys,
        countValues)
    if IsErr(envelopeRes):
        return Err[ParserNormalizedExprReceipt](Error(envelopeRes))
    var out: ParserNormalizedExprReceipt
    out.envelope = Value(envelopeRes)
    out.aggregateBaseRaw32 = aggregateBaseRaw32
    out.canonicalParserRootRaw32 = canonicalParserRootRaw32
    out.counts = counts
    out.sourceCount = Int64(accumulator.sourcePaths.len)
    out.functionCount = functionCount
    out.importEdgeCount = Int64(accumulator.importEdges.len)
    out.verifiedFunctionCount = verifiedFunctionCount
    out.sourceSidecars = accumulator.sourceSidecars
    accumulator.sourceSidecars = []
    accumulator.sourceSidecarPresent = []
    accumulator.normalizedExprProducerSourceIds = []
    accumulator.normalizedExprFunctionIndexes = []
    accumulator.normalizedExprParserNodeIds = []
    accumulator.normalizedExprKinds = []
    accumulator.normalizedExprStatementRoles = []
    accumulator.active = false
    return Ok[ParserNormalizedExprReceipt](out)

@borrows
fn ParserNormalizedExprReceiptVerify(
        receipt: ParserNormalizedExprReceipt): Result[bool] =
    if receipt.envelope.stageKind !=
           stage_receipt.CompilerStageReceiptStageParser ||
       receipt.envelope.laneKind !=
           stage_receipt.CompilerStageReceiptLaneShared ||
       receipt.envelope.producerIdentity !=
           ParserNormalizedExprProducerIdentity ||
       receipt.functionCount < Int64(0) ||
       receipt.verifiedFunctionCount != receipt.functionCount ||
       receipt.sourceCount <= Int64(0) || receipt.importEdgeCount < Int64(0) ||
       Int64(receipt.sourceSidecars.len) != receipt.sourceCount:
        return Err[bool](
            " compiler parser receipt: invalid parser envelope fields")
    var observedParserCounts: ParserNormalizedExprArtifactCounts
    var diagnosticRowCursor: int32
    for sourceIndex in 0..<receipt.sourceSidecars.len:
        var sidecarErr: str
        if receipt.sourceSidecars[sourceIndex].sourceIndex != sourceIndex:
            return Err[bool](
                " compiler parser receipt: canonical source order mismatch")
        if !ParserCanonicalSourceSidecarStrictValidateInto(
               receipt.sourceSidecars[sourceIndex], sidecarErr):
            return Err[bool](sidecarErr)
        let sidecar = receipt.sourceSidecars[sourceIndex]
        if sidecar.diagnosticRowStart != diagnosticRowCursor:
            return Err[bool](
                " compiler parser receipt: diagnostic source partition mismatch")
        diagnosticRowCursor =
            diagnosticRowCursor + sidecar.diagnosticRowCount
        if receipt.functionCount == Int64(0) &&
           !parserReceiptFunctionSidecarExactlyEmpty(sidecar):
            return Err[bool](
                " compiler parser receipt: zero-function sidecar is not empty")
        observedParserCounts.nodeCount = observedParserCounts.nodeCount +
                                         Int64(sidecar.nodeKinds.len)
        observedParserCounts.genericCount = observedParserCounts.genericCount +
                                            Int64(sidecar.genericSpanIds.len)
        observedParserCounts.rootCount = observedParserCounts.rootCount +
                                         Int64(sidecar.rootNodeIds.len)
        observedParserCounts.tokenCount = observedParserCounts.tokenCount +
                                          Int64(sidecar.tokenKinds.len)
        observedParserCounts.callEventCount =
            observedParserCounts.callEventCount +
            Int64(sidecar.callEventNodeIds.len)
        observedParserCounts.statementRootCount =
            observedParserCounts.statementRootCount +
            Int64(sidecar.statementRootNodeIds.len)
        observedParserCounts.typeSyntaxCount =
            observedParserCounts.typeSyntaxCount +
            Int64(sidecar.typeSyntaxKinds.len)
        observedParserCounts.typeSyntaxChildCount =
            observedParserCounts.typeSyntaxChildCount +
            Int64(sidecar.typeSyntaxChildIds.len)
        observedParserCounts.typeSyntaxBracketArgCount =
            observedParserCounts.typeSyntaxBracketArgCount +
            Int64(sidecar.typeSyntaxBracketArgTokenStarts.len)
        observedParserCounts.typeConstExprCount =
            observedParserCounts.typeConstExprCount +
            Int64(sidecar.typeConstExprKinds.len)
        observedParserCounts.typeEnumVariantCount =
            observedParserCounts.typeEnumVariantCount +
            Int64(sidecar.typeEnumVariantNameTokenIds.len)
        observedParserCounts.declarationCount =
            observedParserCounts.declarationCount +
            Int64(sidecar.declarationKinds.len)
        observedParserCounts.patternCount =
            observedParserCounts.patternCount +
            Int64(sidecar.patternKinds.len)
        observedParserCounts.patternChildCount =
            observedParserCounts.patternChildCount +
            Int64(sidecar.patternChildIds.len)
        observedParserCounts.annotationCount =
            observedParserCounts.annotationCount +
            Int64(sidecar.annotationProducerSourceIds.len)
        observedParserCounts.annotationArgCount =
            observedParserCounts.annotationArgCount +
            Int64(sidecar.annotationArgProducerSourceIds.len)
        observedParserCounts.annotationArgRootCount =
            observedParserCounts.annotationArgRootCount +
            Int64(sidecar.annotationArgRootIds.len)
        observedParserCounts.annotationArgChildCount =
            observedParserCounts.annotationArgChildCount +
            Int64(sidecar.annotationArgChildIds.len)
        observedParserCounts.exprCount =
            observedParserCounts.exprCount +
            Int64(sidecar.normalizedExprParserNodeIds.len)
    if !layout.FixedBytes32Equal(
           parserCanonicalSidecarsRoot(receipt.sourceSidecars),
           receipt.canonicalParserRootRaw32):
        return Err[bool](
            " compiler parser receipt: canonical parser root mismatch")
    if !layout.FixedBytes32Equal(
           parserCanonicalAggregateArtifact(
               receipt.aggregateBaseRaw32,
               receipt.canonicalParserRootRaw32),
           receipt.envelope.artifactRaw32):
        return Err[bool](
            " compiler parser receipt: parser sidecar aggregate mismatch")
    if observedParserCounts.exprCount != receipt.counts.exprCount ||
       observedParserCounts.nodeCount != receipt.counts.nodeCount ||
       observedParserCounts.genericCount != receipt.counts.genericCount ||
       observedParserCounts.rootCount != receipt.counts.rootCount ||
       observedParserCounts.tokenCount != receipt.counts.tokenCount ||
       observedParserCounts.callEventCount != receipt.counts.callEventCount ||
       observedParserCounts.statementRootCount !=
           receipt.counts.statementRootCount ||
       observedParserCounts.typeSyntaxCount !=
           receipt.counts.typeSyntaxCount ||
       observedParserCounts.typeSyntaxChildCount !=
           receipt.counts.typeSyntaxChildCount ||
       observedParserCounts.typeSyntaxBracketArgCount !=
           receipt.counts.typeSyntaxBracketArgCount ||
       observedParserCounts.typeConstExprCount !=
           receipt.counts.typeConstExprCount ||
       observedParserCounts.typeEnumVariantCount !=
           receipt.counts.typeEnumVariantCount ||
       observedParserCounts.declarationCount !=
           receipt.counts.declarationCount ||
       observedParserCounts.patternCount != receipt.counts.patternCount ||
       observedParserCounts.patternChildCount !=
           receipt.counts.patternChildCount ||
       observedParserCounts.annotationCount !=
           receipt.counts.annotationCount ||
       observedParserCounts.annotationArgCount !=
           receipt.counts.annotationArgCount ||
       observedParserCounts.annotationArgRootCount !=
           receipt.counts.annotationArgRootCount ||
       observedParserCounts.annotationArgChildCount !=
           receipt.counts.annotationArgChildCount:
        return Err[bool](
            " compiler parser receipt: canonical parser counts mismatch")
    let expectedKeys = parserReceiptCountKeys()
    let expectedValues = parserReceiptCountValues(
        receipt.counts,
        receipt.functionCount,
        receipt.importEdgeCount,
        receipt.sourceCount)
    if receipt.envelope.countKeys.len != expectedKeys.len ||
       receipt.envelope.countValues.len != expectedValues.len:
        return Err[bool](
            " compiler parser receipt: count envelope shape mismatch")
    for index in 0..<expectedKeys.len:
        if receipt.envelope.countKeys[index] != expectedKeys[index] ||
           receipt.envelope.countValues[index] != expectedValues[index]:
            return Err[bool](
                " compiler parser receipt: count envelope mismatch")
    return stage_receipt.CompilerStageReceiptVerify(receipt.envelope)

@borrows
fn ParserNormalizedExprReceiptClone(
        receipt: ParserNormalizedExprReceipt): ParserNormalizedExprReceipt =
    var out: ParserNormalizedExprReceipt
    out.envelope.stageKind = parser.ParserOwnedText(receipt.envelope.stageKind)
    out.envelope.laneKind = parser.ParserOwnedText(receipt.envelope.laneKind)
    out.envelope.producerIdentity =
        parser.ParserOwnedText(receipt.envelope.producerIdentity)
    out.envelope.predecessorRaw32 = receipt.envelope.predecessorRaw32
    out.envelope.artifactRaw32 = receipt.envelope.artifactRaw32
    for index in 0..<receipt.envelope.countKeys.len:
        add(out.envelope.countKeys,
            parser.ParserOwnedText(receipt.envelope.countKeys[index]))
        add(out.envelope.countValues, receipt.envelope.countValues[index])
    out.envelope.receiptRaw32 = receipt.envelope.receiptRaw32
    out.aggregateBaseRaw32 = receipt.aggregateBaseRaw32
    out.canonicalParserRootRaw32 = receipt.canonicalParserRootRaw32
    out.counts = receipt.counts
    out.sourceCount = receipt.sourceCount
    out.functionCount = receipt.functionCount
    out.importEdgeCount = receipt.importEdgeCount
    out.verifiedFunctionCount = receipt.verifiedFunctionCount
    for sourceIndex in 0..<receipt.sourceSidecars.len:
        add(out.sourceSidecars,
            ParserCanonicalSourceSidecarClone(
                receipt.sourceSidecars[sourceIndex]))
    return out

fn ParserNormalizedExprReceiptMoveInto(
        target: var ParserNormalizedExprReceipt,
        source: var ParserNormalizedExprReceipt) =
    target = source
    source = ParserNormalizedExprReceipt()

# ---- Driver parse-receipt (S1 span receipt DAG core) ----
#
# GrammarParserSpanReceipt-compatible raw evidence serialized at the parse
# completion point (parser.cheng `parsed.normalizedExprLayer = exprLayer`).
# The document carries every valueExprTree node (kind name, character span,
# exact contained driver-token span, per-node identity hash), the region side
# table, the driver token stream, statement roots, the whole-tree canonical
# hash root, and the driver/toolchain identity hashes.  The fusion-side binder
# (S1 3.2) projects character spans onto `chengPublicTokens` and assembles the
# per-obligation GrammarParserSpanReceipt; this module never invents EBNF
# obligation bindings.
#
# Canonical hash contracts (both sha256 over the exact byte stream built by
# the parserReceiptAppend* big-endian framing above):
#   node identity  = sha256(text(domain) + kind + sourceTextId + spanStart +
#                      spanEnd + parent + firstChild + childCount +
#                      nextSibling)  -- parent/sibling links fix 父子序 exactly
#   trace root     = sha256(text(domain) + counts + node identities in index
#                      order + region tuples + root list + token tuples +
#                      call events + statement roots + generic spans)
const
    ParserSpanReceiptSchema: str = "cheng_driver_parse_receipt"
    ParserSpanReceiptStage: str = "parser"
    ParserSpanReceiptProducerIdentity: str = "compiler_parser_span_receipt"
    ParserSpanReceiptNodeDomain: str = "cheng.parser_span_receipt.node"
    ParserSpanReceiptTypeSyntaxDomain: str = "cheng.parser_span_receipt.type_syntax"
    ParserSpanReceiptTypeEnumVariantDomain: str = "cheng.parser_span_receipt.type_enum_variant"
    ParserSpanReceiptTypeSyntaxBracketArgDomain: str = "cheng.parser_span_receipt.type_syntax_bracket_arg"
    ParserSpanReceiptTypeConstExprDomain: str = "cheng.parser_span_receipt.type_const_expr"
    ParserSpanReceiptTypeGenericSymbolDomain: str = "cheng.parser_span_receipt.type_generic_symbol"
    ParserSpanReceiptDeclarationDomain: str = "cheng.parser_span_receipt.declaration"
    ParserSpanReceiptDeclarationLexicalScopeDomain: str = "cheng.parser_span_receipt.declaration_lexical_scope"
    ParserSpanReceiptPatternDomain: str = "cheng.parser_span_receipt.pattern"
    ParserSpanReceiptAnnotationDomain: str = "cheng.parser_span_receipt.annotation"
    ParserSpanReceiptAnnotationArgDomain: str = "cheng.parser_span_receipt.annotation_arg"
    ParserSpanReceiptForwardingProductionDomain: str = "cheng.parser_span_receipt.forwarding_production"
    ParserSpanReceiptTraceDomain: str = "cheng.parser_span_receipt.trace"
    ParserSpanReceiptManifestSchema: str = "cheng_driver_toolchain_manifest"

@borrows
fn parserSpanReceiptHex64Valid(text: str): bool =
    if text.len != 64:
        return false
    for index in 0..<64:
        let code = Int32(text[index]) & 255
        if !(code >= 48 && code <= 57) && !(code >= 97 && code <= 102):
            return false
    return true

fn parserSpanReceiptPatternKindText(kind: int32): str =
    if kind == Int32(parser.ParserPatternBinding):
        return "ParserPatternBinding"
    if kind == Int32(parser.ParserPatternWildcard):
        return "ParserPatternWildcard"
    if kind == Int32(parser.ParserPatternLiteral):
        return "ParserPatternLiteral"
    if kind == Int32(parser.ParserPatternTuple):
        return "ParserPatternTuple"
    if kind == Int32(parser.ParserPatternSequence):
        return "ParserPatternSequence"
    if kind == Int32(parser.ParserPatternObject):
        return "ParserPatternObject"
    if kind == Int32(parser.ParserPatternConstructor):
        return "ParserPatternConstructor"
    if kind == Int32(parser.ParserPatternNamedField):
        return "ParserPatternNamedField"
    if kind == Int32(parser.ParserPatternRange):
        return "ParserPatternRange"
    panic("compiler parser span receipt: invalid pattern kind")

fn parserSpanReceiptDeclarationLexicalScopeKindText(kind: int32): str =
    if kind == Int32(parser.ParserDeclarationLexicalScopeSource):
        return "ParserDeclarationLexicalScopeSource"
    if kind == Int32(parser.ParserDeclarationLexicalScopeType):
        return "ParserDeclarationLexicalScopeType"
    if kind == Int32(parser.ParserDeclarationLexicalScopeFunction):
        return "ParserDeclarationLexicalScopeFunction"
    if kind == Int32(parser.ParserDeclarationLexicalScopeBlock):
        return "ParserDeclarationLexicalScopeBlock"
    panic("compiler parser span receipt: invalid declaration lexical scope kind")

fn parserSpanReceiptDeclarationKindText(kind: int32): str =
    if kind == Int32(parser.ParserDeclarationModule):
        return "ParserDeclarationModule"
    if kind == Int32(parser.ParserDeclarationType):
        return "ParserDeclarationType"
    if kind == Int32(parser.ParserDeclarationFunction):
        return "ParserDeclarationFunction"
    if kind == Int32(parser.ParserDeclarationField):
        return "ParserDeclarationField"
    if kind == Int32(parser.ParserDeclarationParameter):
        return "ParserDeclarationParameter"
    if kind == Int32(parser.ParserDeclarationLocal):
        return "ParserDeclarationLocal"
    if kind == Int32(parser.ParserDeclarationConcept):
        return "ParserDeclarationConcept"
    if kind == Int32(parser.ParserDeclarationTrait):
        return "ParserDeclarationTrait"
    panic("compiler parser span receipt: invalid declaration kind")

@borrows
fn parserSpanReceiptJsonAppendEscaped(buf: var buffer.GrowByteBuffer,
                                      value: str) =
    buffer.AppendByte(buf, 34)
    for index in 0..<value.len:
        let code = Int32(value[index]) & 255
        if code == 34 || code == 92:
            buffer.AppendByte(buf, 92)
            buffer.AppendByte(buf, code)
        elif code == 8:
            buffer.AppendByte(buf, 92)
            buffer.AppendByte(buf, 98)
        elif code == 9:
            buffer.AppendByte(buf, 92)
            buffer.AppendByte(buf, 116)
        elif code == 10:
            buffer.AppendByte(buf, 92)
            buffer.AppendByte(buf, 110)
        elif code == 12:
            buffer.AppendByte(buf, 92)
            buffer.AppendByte(buf, 102)
        elif code == 13:
            buffer.AppendByte(buf, 92)
            buffer.AppendByte(buf, 114)
        elif code < 32:
            buffer.AppendText(buf, "\\u00")
            buffer.AppendByte(buf, 48 + (code >> 4))
            let low = code & 15
            buffer.AppendByte(buf, low < 10 ? 48 + low : 87 + low)
        else:
            buffer.AppendByte(buf, code)
    buffer.AppendByte(buf, 34)

@borrows
fn parserSpanReceiptJsonFieldStr(buf: var buffer.GrowByteBuffer,
                                 key: str,
                                 value: str,
                                 comma: bool) =
    buffer.AppendText(buf, "  \"")
    buffer.AppendText(buf, key)
    buffer.AppendText(buf, "\": ")
    parserSpanReceiptJsonAppendEscaped(buf, value)
    if comma:
        buffer.AppendByte(buf, 44)
    buffer.AppendByte(buf, 10)

@borrows
fn parserSpanReceiptJsonFieldInt(buf: var buffer.GrowByteBuffer,
                                 key: str,
                                 value: int32,
                                 comma: bool) =
    buffer.AppendText(buf, "  \"")
    buffer.AppendText(buf, key)
    buffer.AppendText(buf, "\": ")
    buffer.AppendText(buf, strings.IntToStr(value))
    if comma:
        buffer.AppendByte(buf, 44)
    buffer.AppendByte(buf, 10)

@borrows
fn parserSpanReceiptAppendTokenIdentity(
        buf: var layout.ByteBuf,
        tree: parser.ParserValueExprTree,
        tokenIndex: int32) =
    if tokenIndex < 0 || tokenIndex >= tree.tokenCount:
        panic("compiler parser receipt: annotation identity token invalid")
    parserReceiptAppendI32(buf, tokenIndex)
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.tokenKinds, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.tokenSourceTextIds, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(
            tree, tree.tokenProducerSourceIndexes, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(
            tree, tree.tokenSourceLocalIndexes, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(
            tree, tree.tokenLexicalParentIndexes, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.tokenStarts, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.tokenEnds, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.tokenLineNumbers, tokenIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.tokenColumnNumbers, tokenIndex))
    parserReceiptAppendText(
        buf, parser.ParserValueExprTokenText(tree, tokenIndex))

@borrows
fn parserSpanReceiptNodeIdentityRaw32(tree: parser.ParserValueExprTree,
                                      nodeIndex: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    parserReceiptAppendText(buf, ParserSpanReceiptNodeDomain)
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.kinds, nodeIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.sourceTextIds, nodeIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.spanStarts, nodeIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.spanEnds, nodeIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.parentNodeIndexes, nodeIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.firstChilds, nodeIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.childCounts, nodeIndex))
    parserReceiptAppendI32(buf,
        parserReceiptArenaI32(tree, tree.nextSiblings, nodeIndex))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptTypeSyntaxIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    parserReceiptAppendText(buf, ParserSpanReceiptTypeSyntaxDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxProducerSourceIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxSourceLocalRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxSourceTextIds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxKinds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxSpanEnds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxOwnerTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxDeclarationOwnerTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxDeclarationOwnerNodeIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxGenericSymbolStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxGenericSymbolCounts, row))
    let childStart = parserReceiptArenaI32(
        tree, tree.typeSyntaxChildStarts, row)
    let childCount = parserReceiptArenaI32(
        tree, tree.typeSyntaxChildCounts, row)
    parserReceiptAppendI32(buf, childStart)
    parserReceiptAppendI32(buf, childCount)
    for childOffset in 0..<childCount:
        parserReceiptAppendI32(
            buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxChildNodeIndexes,
                childStart + childOffset))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxBracketArgStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxBracketArgCounts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxNameTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxFixedLengths, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxQuestionTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxRootKinds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxEnumVariantStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxEnumVariantCounts, row))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptTypeEnumVariantIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        typeSyntaxIdentities: layout.FixedBytes32[]): layout.FixedBytes32 =
    let owner = parserReceiptArenaI32(
        tree, tree.typeEnumVariantDeclarationOwnerNodeIndexes, row)
    let ownerToken = parserReceiptArenaI32(
        tree, tree.typeEnumVariantDeclarationOwnerTokenIndexes, row)
    let nameToken = parserReceiptArenaI32(
        tree, tree.typeEnumVariantNameTokenIndexes, row)
    let payload = parserReceiptArenaI32(
        tree, tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes, row)
    if owner < 0 || owner >= typeSyntaxIdentities.len ||
       payload < -1 || payload >= typeSyntaxIdentities.len:
        panic("compiler parser receipt: enum variant identity edge invalid")
    var buf = layout.ByteBufInit(192)
    parserReceiptAppendText(buf, ParserSpanReceiptTypeEnumVariantDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeEnumVariantProducerSourceIndexes, row))
    parserReceiptAppendI32(buf, owner)
    parserReceiptAppendFixed32(buf, typeSyntaxIdentities[owner])
    parserSpanReceiptAppendTokenIdentity(buf, tree, ownerToken)
    parserSpanReceiptAppendTokenIdentity(buf, tree, nameToken)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeEnumVariantOrdinals, row))
    parserReceiptAppendI32(buf, payload)
    if payload >= 0:
        parserReceiptAppendFixed32(buf, typeSyntaxIdentities[payload])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptTypeSyntaxBracketArgIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        ownerTypeSyntaxIndex: int32,
        ordinal: int32): layout.FixedBytes32 =
    let tokenStart = parserReceiptArenaI32(
        tree, tree.typeSyntaxBracketArgTokenStarts, row)
    var buf = layout.ByteBufInit(96)
    parserReceiptAppendText(
        buf, ParserSpanReceiptTypeSyntaxBracketArgDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree,
        tree.typeSyntaxProducerSourceIndexes,
        ownerTypeSyntaxIndex))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.tokenSourceTextIds, tokenStart))
    parserReceiptAppendI32(buf, ownerTypeSyntaxIndex)
    parserReceiptAppendI32(buf, ordinal)
    parserReceiptAppendI32(buf, tokenStart)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxBracketArgTokenCounts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxBracketArgTypeNodeIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeSyntaxBracketArgConstExprRootIndexes, row))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptTypeConstExprIdentityRaw32(
        index: int32,
        producerSourceIndex: int32,
        sourceTextId: int32,
        tokenIndex: int32,
        kind: int32,
        leftChildIndex: int32,
        rightChildIndex: int32,
        integerValue: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(80)
    parserReceiptAppendText(buf, ParserSpanReceiptTypeConstExprDomain)
    parserReceiptAppendI32(buf, index)
    parserReceiptAppendI32(buf, producerSourceIndex)
    parserReceiptAppendI32(buf, sourceTextId)
    parserReceiptAppendI32(buf, tokenIndex)
    parserReceiptAppendI32(buf, kind)
    parserReceiptAppendI32(buf, leftChildIndex)
    parserReceiptAppendI32(buf, rightChildIndex)
    parserReceiptAppendI32(buf, integerValue)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptTypeConstExprTreeIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32): layout.FixedBytes32 =
    let token = parserReceiptArenaI32(
        tree, tree.typeConstExprTokenIndexes, row)
    return parserSpanReceiptTypeConstExprIdentityRaw32(
        row,
        parserReceiptArenaI32(
            tree, tree.typeConstExprProducerSourceIndexes, row),
        parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, token),
        token,
        parserReceiptArenaI32(tree, tree.typeConstExprKinds, row),
        parserReceiptArenaI32(
            tree, tree.typeConstExprLeftChildIndexes, row),
        parserReceiptArenaI32(
            tree, tree.typeConstExprRightChildIndexes, row),
        parserReceiptArenaI32(
            tree, tree.typeConstExprIntegerValues, row))

@borrows
fn parserSpanReceiptTypeGenericSymbolIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    parserReceiptAppendText(buf, ParserSpanReceiptTypeGenericSymbolDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolProducerSourceIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolDeclarationOwnerTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolNameTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolOrdinals, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolSpanEnds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolOwnerDeclarationRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolChildStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.typeGenericSymbolChildCounts, row))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptPatternIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(112)
    parserReceiptAppendText(buf, ParserSpanReceiptPatternDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternProducerSourceIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternSourceLocalRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternKinds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternNameTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternOwnerLexicalScopeRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternOwnerKinds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternOwnerRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternBindingDeclarationRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternTypeSyntaxRootIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternSpanEnds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternChildStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.patternChildCounts, row))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptDeclarationIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        typeSyntaxIdentities: layout.FixedBytes32[],
        typeGenericSymbolIdentities: layout.FixedBytes32[],
        declarationIdentities: layout.FixedBytes32[],
        declarationLexicalScopeIdentities:
            layout.FixedBytes32[]): layout.FixedBytes32 =
    let nameToken = parserReceiptArenaI32(
        tree, tree.declarationNameTokenIndexes, row)
    let ownerDeclaration = parserReceiptArenaI32(
        tree, tree.declarationOwnerRows, row)
    let lexicalScope = parserReceiptArenaI32(
        tree, tree.declarationLexicalScopeRows, row)
    let typeSyntaxRoot = parserReceiptArenaI32(
        tree, tree.declarationTypeSyntaxRootIndexes, row)
    let defaultStatementRoot = parserReceiptArenaI32(
        tree, tree.declarationDefaultStatementRootRows, row)
    let genericSymbolStart = parserReceiptArenaI32(
        tree, tree.declarationGenericSymbolStarts, row)
    let genericSymbolCount = parserReceiptArenaI32(
        tree, tree.declarationGenericSymbolCounts, row)
    let suiteLexicalScope = parserReceiptArenaI32(
        tree, tree.declarationSuiteLexicalScopeRows, row)
    var buf = layout.ByteBufInit(384)
    parserReceiptAppendText(buf, ParserSpanReceiptDeclarationDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationProducerSourceIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationSourceLocalRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.tokenSourceTextIds, nameToken))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationKinds, row))
    parserSpanReceiptAppendTokenIdentity(buf, tree, nameToken)
    parserReceiptAppendI32(buf, ownerDeclaration)
    if ownerDeclaration >= 0:
        parserReceiptAppendFixed32(
            buf, declarationIdentities[ownerDeclaration])
    parserReceiptAppendI32(buf, lexicalScope)
    parserReceiptAppendFixed32(
        buf, declarationLexicalScopeIdentities[lexicalScope])
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationFunctionRows, row))
    parserReceiptAppendI32(buf, typeSyntaxRoot)
    if typeSyntaxRoot >= 0:
        parserReceiptAppendFixed32(
            buf, typeSyntaxIdentities[typeSyntaxRoot])
    parserReceiptAppendI32(buf, defaultStatementRoot)
    parserReceiptAppendI32(buf, genericSymbolStart)
    parserReceiptAppendI32(buf, genericSymbolCount)
    for genericOffset in 0..<genericSymbolCount:
        let genericRow = genericSymbolStart + genericOffset
        parserReceiptAppendI32(buf, genericRow)
        parserReceiptAppendFixed32(
            buf, typeGenericSymbolIdentities[genericRow])
    parserReceiptAppendI32(buf, suiteLexicalScope)
    if suiteLexicalScope >= 0:
        parserReceiptAppendFixed32(
            buf,
            declarationLexicalScopeIdentities[suiteLexicalScope])
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationSpanEnds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationNameSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationNameSpanEnds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationMutableFlags, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationExportedFlags, row))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptDeclarationLexicalScopeIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(80)
    parserReceiptAppendText(
        buf, ParserSpanReceiptDeclarationLexicalScopeDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree,
        tree.declarationLexicalScopeProducerSourceIndexes,
        row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationLexicalScopeSourceLocalRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationLexicalScopeKinds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationLexicalScopeParentRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree,
        tree.declarationLexicalScopeOwnerDeclarationRows,
        row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationLexicalScopeSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.declarationLexicalScopeSpanEnds, row))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptAnnotationIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        annotationArgIdentities:
            layout.FixedBytes32[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    parserReceiptAppendText(buf, ParserSpanReceiptAnnotationDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationProducerSourceIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationSourceLocalRows, row))
    let nameToken = parserReceiptArenaI32(
        tree, tree.annotationNameTokenIndexes, row)
    parserSpanReceiptAppendTokenIdentity(buf, tree, nameToken - 1)
    parserSpanReceiptAppendTokenIdentity(buf, tree, nameToken)
    parserSpanReceiptAppendTokenIdentity(
        buf,
        tree,
        parserReceiptArenaI32(
            tree, tree.annotationTargetTokenIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationSpanEnds, row))
    let rootStart = parserReceiptArenaI32(
        tree, tree.annotationArgRootStarts, row)
    let rootCount = parserReceiptArenaI32(
        tree, tree.annotationArgRootCounts, row)
    parserReceiptAppendI32(buf, rootStart)
    parserReceiptAppendI32(buf, rootCount)
    for rootOffset in 0..<rootCount:
        let rootRow = parserReceiptArenaI32(
            tree,
            tree.annotationArgRootNodeIndexes,
            rootStart + rootOffset)
        if rootRow < 0 || rootRow >= annotationArgIdentities.len:
            panic(
                "compiler parser receipt: annotation identity root invalid")
        parserReceiptAppendI32(buf, rootRow)
        parserReceiptAppendFixed32(
            buf, annotationArgIdentities[rootRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptAnnotationArgIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        priorIdentities:
            layout.FixedBytes32[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    parserReceiptAppendText(buf, ParserSpanReceiptAnnotationArgDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationArgProducerSourceIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationArgSourceLocalRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationArgOwnerRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationArgKinds, row))
    let token = parserReceiptArenaI32(
        tree, tree.annotationArgTokenIndexes, row)
    parserSpanReceiptAppendTokenIdentity(buf, tree, token)
    let separatorToken = parserReceiptArenaI32(
        tree, tree.annotationArgSeparatorTokenIndexes, row)
    parserReceiptAppendI32(buf, separatorToken)
    if separatorToken >= 0:
        parserSpanReceiptAppendTokenIdentity(
            buf, tree, separatorToken)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationArgSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.annotationArgSpanEnds, row))
    let childStart = parserReceiptArenaI32(
        tree, tree.annotationArgChildStarts, row)
    let childCount = parserReceiptArenaI32(
        tree, tree.annotationArgChildCounts, row)
    parserReceiptAppendI32(buf, childStart)
    parserReceiptAppendI32(buf, childCount)
    for childOffset in 0..<childCount:
        let childRow = parserReceiptArenaI32(
            tree,
            tree.annotationArgChildNodeIndexes,
            childStart + childOffset)
        if childRow < 0 || childRow >= row ||
           childRow >= priorIdentities.len:
            panic(
                "compiler parser receipt: annotation arg identity child invalid")
        parserReceiptAppendI32(buf, childRow)
        parserReceiptAppendFixed32(buf, priorIdentities[childRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptForwardingChildSourceTextId(
        tree: parser.ParserValueExprTree,
        producerSourceIndex: int32,
        spanStart: int32,
        spanEnd: int32): int32 =
    for tokenRow in 0..<tree.tokenCount:
        if parserReceiptArenaI32(
               tree,
               tree.tokenProducerSourceIndexes,
               tokenRow) == producerSourceIndex &&
           parserReceiptArenaI32(
               tree, tree.tokenStarts, tokenRow) >= spanStart &&
           parserReceiptArenaI32(
               tree, tree.tokenEnds, tokenRow) <= spanEnd:
            return parserReceiptArenaI32(
                tree, tree.tokenSourceTextIds, tokenRow)
    panic("compiler parser receipt: forwarding child source text missing")

@borrows
fn parserSpanReceiptForwardingChildTargetIdentityRaw32(
        tree: parser.ParserValueExprTree,
        kind: parser.ParserForwardingProductionChildKind,
        row: int32,
        nodeIdentities: layout.FixedBytes32[],
        typeSyntaxIdentities: layout.FixedBytes32[],
        declarationIdentities: layout.FixedBytes32[],
        patternIdentities: layout.FixedBytes32[],
        annotationIdentities: layout.FixedBytes32[],
        declarationLexicalScopeIdentities: layout.FixedBytes32[],
        forwardingProductionIdentities:
            layout.FixedBytes32[]): layout.FixedBytes32 =
    var producerSourceIndex: int32
    var sourceTextId: int32
    var spanStart: int32
    var spanEnd: int32
    var canonicalIdentity: layout.FixedBytes32
    if kind == parser.ParserForwardingProductionChildForwardingProduction:
        producerSourceIndex = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionProducerSourceIndexes,
            row)
        let anchorToken = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAnchorTokenIndexes,
            row)
        sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, anchorToken)
        spanStart = parserReceiptArenaI32(
            tree, tree.forwardingProductionSpanStarts, row)
        spanEnd = parserReceiptArenaI32(
            tree, tree.forwardingProductionSpanEnds, row)
        parserReceiptFixed32CopyInto(
            canonicalIdentity,
            forwardingProductionIdentities[row])
    elif kind == parser.ParserForwardingProductionChildValueNode:
        producerSourceIndex = parser.ParserValueExprNodeProducerSourceIndexAt(
            tree, row)
        sourceTextId = parser.ParserValueExprNodeSourceIdAt(tree, row)
        spanStart = parser.ParserValueExprNodeSpanStartAt(tree, row)
        spanEnd = parser.ParserValueExprNodeSpanEndAt(tree, row)
        parserReceiptFixed32CopyInto(
            canonicalIdentity, nodeIdentities[row])
    elif kind == parser.ParserForwardingProductionChildStatementRoot:
        let nodeRow = parser.ParserValueExprStatementRootNodeAt(
            tree, row)
        producerSourceIndex = parser.ParserValueExprNodeProducerSourceIndexAt(
            tree, nodeRow)
        sourceTextId = parser.ParserValueExprNodeSourceIdAt(
            tree, nodeRow)
        spanStart = parser.ParserValueExprNodeSpanStartAt(tree, nodeRow)
        spanEnd = parser.ParserValueExprNodeSpanEndAt(tree, nodeRow)
        var statementBuf = layout.ByteBufInit(192)
        parserReceiptAppendText(
            statementBuf,
            "cheng.parser_span_receipt.forwarding_statement_root_target")
        parserReceiptAppendI32(statementBuf, row)
        parserReceiptAppendFixed32(
            statementBuf, nodeIdentities[nodeRow])
        parserReceiptAppendI32(
            statementBuf,
            Int32(parser.ParserValueExprStatementRootRoleAt(
                tree, row)))
        parserSpanReceiptAppendTokenIdentity(
            statementBuf,
            tree,
            parser.ParserValueExprStatementRootAnchorTokenAt(
                tree, row))
        parserReceiptAppendI32(
            statementBuf,
            parser.ParserValueExprStatementRootBindingDeclarationStartAt(
                tree, row))
        parserReceiptAppendI32(
            statementBuf,
            parser.ParserValueExprStatementRootBindingDeclarationCountAt(
                tree, row))
        canonicalIdentity =
            hash256.Sha256Fixed(layout.ByteBufView(statementBuf))
        layout.ByteBufFree(statementBuf)
    elif kind == parser.ParserForwardingProductionChildRegion:
        let anchorToken = parserReceiptArenaI32(
            tree, tree.regionAnchorTokenIndexes, row)
        producerSourceIndex = parserReceiptArenaI32(
            tree, tree.tokenProducerSourceIndexes, anchorToken)
        sourceTextId = parserReceiptArenaI32(
            tree, tree.regionSourceTextIds, row)
        spanStart = parserReceiptArenaI32(
            tree, tree.regionSpanStarts, row)
        spanEnd = parserReceiptArenaI32(
            tree, tree.regionSpanEnds, row)
        var regionBuf = layout.ByteBufInit(128)
        parserReceiptAppendText(
            regionBuf,
            "cheng.parser_span_receipt.forwarding_region_target")
        parserReceiptAppendI32(regionBuf, row)
        parserReceiptAppendI32(
            regionBuf,
            parserReceiptArenaI32(tree, tree.regionKinds, row))
        parserReceiptAppendI32(regionBuf, sourceTextId)
        parserReceiptAppendI32(regionBuf, spanStart)
        parserReceiptAppendI32(regionBuf, spanEnd)
        parserSpanReceiptAppendTokenIdentity(
            regionBuf, tree, anchorToken)
        canonicalIdentity =
            hash256.Sha256Fixed(layout.ByteBufView(regionBuf))
        layout.ByteBufFree(regionBuf)
    elif kind == parser.ParserForwardingProductionChildToken:
        producerSourceIndex = parserReceiptArenaI32(
            tree, tree.tokenProducerSourceIndexes, row)
        sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, row)
        spanStart = parserReceiptArenaI32(
            tree, tree.tokenStarts, row)
        spanEnd = parserReceiptArenaI32(
            tree, tree.tokenEnds, row)
        var tokenBuf = layout.ByteBufInit(128)
        parserReceiptAppendText(
            tokenBuf,
            "cheng.parser_span_receipt.forwarding_token_target")
        parserSpanReceiptAppendTokenIdentity(tokenBuf, tree, row)
        canonicalIdentity =
            hash256.Sha256Fixed(layout.ByteBufView(tokenBuf))
        layout.ByteBufFree(tokenBuf)
    elif kind == parser.ParserForwardingProductionChildDeclaration:
        producerSourceIndex = parserReceiptArenaI32(
            tree, tree.declarationProducerSourceIndexes, row)
        let nameToken = parserReceiptArenaI32(
            tree, tree.declarationNameTokenIndexes, row)
        sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, nameToken)
        spanStart = parserReceiptArenaI32(
            tree, tree.declarationSpanStarts, row)
        spanEnd = parserReceiptArenaI32(
            tree, tree.declarationSpanEnds, row)
        parserReceiptFixed32CopyInto(
            canonicalIdentity, declarationIdentities[row])
    elif kind == parser.ParserForwardingProductionChildPattern:
        producerSourceIndex = parserReceiptArenaI32(
            tree, tree.patternProducerSourceIndexes, row)
        spanStart = parserReceiptArenaI32(
            tree, tree.patternSpanStarts, row)
        spanEnd = parserReceiptArenaI32(
            tree, tree.patternSpanEnds, row)
        sourceTextId = parserSpanReceiptForwardingChildSourceTextId(
            tree, producerSourceIndex, spanStart, spanEnd)
        parserReceiptFixed32CopyInto(
            canonicalIdentity, patternIdentities[row])
    elif kind == parser.ParserForwardingProductionChildAnnotation:
        producerSourceIndex = parserReceiptArenaI32(
            tree, tree.annotationProducerSourceIndexes, row)
        let nameToken = parserReceiptArenaI32(
            tree, tree.annotationNameTokenIndexes, row)
        sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, nameToken)
        spanStart = parserReceiptArenaI32(
            tree, tree.annotationSpanStarts, row)
        spanEnd = parserReceiptArenaI32(
            tree, tree.annotationSpanEnds, row)
        parserReceiptFixed32CopyInto(
            canonicalIdentity, annotationIdentities[row])
    elif kind ==
         parser.ParserForwardingProductionChildLexicalScope:
        producerSourceIndex = parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeProducerSourceIndexes,
            row)
        spanStart = parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeSpanStarts, row)
        spanEnd = parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeSpanEnds, row)
        sourceTextId = parserSpanReceiptForwardingChildSourceTextId(
            tree, producerSourceIndex, spanStart, spanEnd)
        parserReceiptFixed32CopyInto(
            canonicalIdentity,
            declarationLexicalScopeIdentities[row])
    elif kind == parser.ParserForwardingProductionChildTypeSyntax:
        producerSourceIndex =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                tree, row)
        sourceTextId = parser.ParserValueExprTypeSyntaxSourceIdAt(
            tree, row)
        spanStart = parser.ParserValueExprTypeSyntaxSpanStartAt(
            tree, row)
        spanEnd = parser.ParserValueExprTypeSyntaxSpanEndAt(tree, row)
        parserReceiptFixed32CopyInto(
            canonicalIdentity, typeSyntaxIdentities[row])
    else:
        panic("compiler parser receipt: forwarding child target kind invalid")
    var buf = layout.ByteBufInit(192)
    parserReceiptAppendText(
        buf,
        "cheng.parser_span_receipt.forwarding_child_target")
    parserReceiptAppendI32(buf, Int32(kind))
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, producerSourceIndex)
    parserReceiptAppendI32(buf, sourceTextId)
    parserReceiptAppendI32(buf, spanStart)
    parserReceiptAppendI32(buf, spanEnd)
    parserReceiptAppendFixed32(buf, canonicalIdentity)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptForwardingProductionIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        nodeIdentities: layout.FixedBytes32[],
        typeSyntaxIdentities: layout.FixedBytes32[],
        declarationIdentities: layout.FixedBytes32[],
        patternIdentities: layout.FixedBytes32[],
        annotationIdentities: layout.FixedBytes32[],
        declarationLexicalScopeIdentities: layout.FixedBytes32[],
        forwardingProductionIdentities:
            layout.FixedBytes32[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    parserReceiptAppendText(
        buf, ParserSpanReceiptForwardingProductionDomain)
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree,
        tree.forwardingProductionProducerSourceIndexes,
        row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionSourceLocalRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionKinds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionArmIndexes, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionOwnerRows, row))
    parserSpanReceiptAppendTokenIdentity(
        buf,
        tree,
        parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAnchorTokenIndexes,
            row))
    parserSpanReceiptAppendTokenIdentity(
        buf,
        tree,
        parserReceiptArenaI32(
            tree,
            tree.forwardingProductionSpanStartTokenIndexes,
            row))
    parserSpanReceiptAppendTokenIdentity(
        buf,
        tree,
        parserReceiptArenaI32(
            tree,
            tree.forwardingProductionSpanEndTokenIndexes,
            row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionSpanStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionSpanEnds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionAuthorityKinds, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionAuthorityRows, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionAnnotationStarts, row))
    parserReceiptAppendI32(buf, parserReceiptArenaI32(
        tree, tree.forwardingProductionAnnotationCounts, row))
    let childStart = parserReceiptArenaI32(
        tree, tree.forwardingProductionChildStarts, row)
    let childCount = parserReceiptArenaI32(
        tree, tree.forwardingProductionChildCounts, row)
    parserReceiptAppendI32(buf, childStart)
    parserReceiptAppendI32(buf, childCount)
    for childOffset in 0..<childCount:
        let childIndex = childStart + childOffset
        let childKind = parser.ParserForwardingProductionChildKind(
            parserReceiptArenaI32(
                tree,
                tree.forwardingProductionChildKinds,
                childIndex))
        let childRow = parserReceiptArenaI32(
            tree, tree.forwardingProductionChildRows, childIndex)
        let authorityKind = parser.ParserForwardingProductionChildKind(
            parserReceiptArenaI32(
                tree,
                tree.forwardingProductionAuthorityKinds,
                row))
        let annotationCount = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAnnotationCounts,
            row)
        var role: int32 = 3
        if childOffset == 0 &&
           authorityKind !=
               parser.ParserForwardingProductionChildInvalid:
            role = 1
        elif childOffset <
             (authorityKind !=
                  parser.ParserForwardingProductionChildInvalid ?
                  1 : 0) + annotationCount:
            role = 2
        let targetIdentity =
            parserSpanReceiptForwardingChildTargetIdentityRaw32(
                tree,
                childKind,
                childRow,
                nodeIdentities,
                typeSyntaxIdentities,
                declarationIdentities,
                patternIdentities,
                annotationIdentities,
                declarationLexicalScopeIdentities,
                forwardingProductionIdentities)
        parserReceiptAppendI32(buf, role)
        parserReceiptAppendI32(buf, row)
        parserReceiptAppendI32(buf, childOffset)
        parserReceiptAppendI32(buf, Int32(childKind))
        parserReceiptAppendI32(buf, childRow)
        parserReceiptAppendI32(
            buf,
            parser.ParserValueExprForwardingProductionChildProducerSourceIndexAt(
                tree, childKind, childRow))
        parserReceiptAppendI32(
            buf,
            parser.ParserValueExprForwardingProductionChildSourceTextIdAt(
                tree, childKind, childRow))
        parserReceiptAppendI32(
            buf,
            parser.ParserValueExprForwardingProductionChildSpanStartAt(
                tree, childKind, childRow))
        parserReceiptAppendI32(
            buf,
            parser.ParserValueExprForwardingProductionChildSpanEndAt(
                tree, childKind, childRow))
        parserReceiptAppendFixed32(buf, targetIdentity)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptBuildCurrentStructureFacts(
        layer: parser.NormalizedExprLayer,
        tree: parser.ParserValueExprTree,
        sourcePaths: str[],
        ownerModulePaths: str[],
        importEdges: parser.ImportEdge[],
        statements: var ParserSpanNormalizedStatementFact[],
        scopes: var ParserSpanNormalizedScopeFact[],
        edges: var ParserSpanImportEdgeFact[],
        err: var str): bool =
    if sourcePaths.len <= 0 ||
       sourcePaths.len != ownerModulePaths.len:
        err = " compiler parser span receipt: source graph shape invalid"
        return false
    var nextStatementRows: int32[]
    var nextScopeRows: int32[]
    setLen(nextStatementRows, sourcePaths.len)
    setLen(nextScopeRows, sourcePaths.len)
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if !parserSpanReceiptNormalizedStatementKind(expr.kind):
            continue
        let producerSourceIndex =
            parserSpanReceiptSourceIndex(sourcePaths, expr.sourcePath)
        let anchorTokenIndex = expr.anchorTokenIndex
        if producerSourceIndex < 0 ||
           anchorTokenIndex < 0 ||
           anchorTokenIndex >= tree.tokenCount ||
           parserReceiptArenaI32(
               tree,
               tree.tokenProducerSourceIndexes,
               anchorTokenIndex) != producerSourceIndex ||
           parserReceiptArenaI32(
               tree,
               tree.tokenLineNumbers,
               anchorTokenIndex) != expr.lineNumber ||
           parserReceiptArenaI32(
               tree,
               tree.tokenColumnNumbers,
               anchorTokenIndex) != expr.columnNumber:
            err =
                " compiler parser span receipt: normalized statement anchor missing"
            return false
        var fact: ParserSpanNormalizedStatementFact
        fact.producerSourceIndex = producerSourceIndex
        fact.sourceLocalRow = nextStatementRows[producerSourceIndex]
        fact.normalizedExprRow = exprIndex
        nextStatementRows[producerSourceIndex] =
            nextStatementRows[producerSourceIndex] + 1
        fact.sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, anchorTokenIndex)
        fact.kind = Int32(expr.kind)
        fact.anchorTokenIndex = anchorTokenIndex
        fact.spanStart = expr.valueExprSpanStart
        fact.spanEnd = expr.valueExprSpanEnd
        if fact.spanStart < 0 || fact.spanEnd <= fact.spanStart:
            err =
                " compiler parser span receipt: normalized statement span missing"
            return false
        fact.lineNumber = expr.lineNumber
        fact.columnNumber = expr.columnNumber
        fact.endLineNumber = expr.endLineNumber
        fact.endColumnNumber = expr.endColumnNumber
        fact.rootNodeIndex = expr.valueExprRootNodeIndex
        fact.originNodeIndex = expr.originParserNodeId
        fact.statementRole = Int32(expr.valueExprStatementRole)
        fact.lexicalScopeId = expr.lexicalScopeId
        fact.suiteScopeId = expr.suiteScopeId
        fact.statementOrdinal = expr.statementOrdinal
        fact.lexicalOrdinal = expr.lexicalOrdinal
        fact.deferOwnerStatementOrdinal =
            expr.deferOwnerStatementOrdinal
        fact.identityRaw32 =
            parserSpanReceiptNormalizedStatementIdentityRaw32(
                tree, statements.len, fact)
        add(statements, fact)
    for scopeIndex in 0..<layer.scopes.len:
        let scope = layer.scopes[scopeIndex]
        let producerSourceIndex =
            parserSpanReceiptSourceIndex(sourcePaths, scope.sourcePath)
        let anchorTokenIndex = scope.anchorTokenIndex
        if producerSourceIndex < 0 ||
           anchorTokenIndex < 0 ||
           anchorTokenIndex >= tree.tokenCount ||
           parserReceiptArenaI32(
               tree,
               tree.tokenProducerSourceIndexes,
               anchorTokenIndex) != producerSourceIndex:
            err =
                " compiler parser span receipt: normalized scope anchor missing"
            return false
        if scope.ownerStatementOrdinal >= 0:
            if scope.ownerDeclarationRow != -1 ||
               scope.moduleRootAnchor ||
               scope.ownerStatementRow < 0 ||
               scope.ownerStatementRow >= layer.exprs.len:
                err =
                    " compiler parser span receipt: scope owner row missing"
                return false
            let ownerExpr = layer.exprs[scope.ownerStatementRow]
            if !parserSpanReceiptNormalizedStatementKind(
                    ownerExpr.kind) ||
               ownerExpr.sourcePath != scope.sourcePath ||
               ownerExpr.statementOrdinal !=
                   scope.ownerStatementOrdinal ||
               ownerExpr.anchorTokenIndex != anchorTokenIndex:
                err =
                    " compiler parser span receipt: scope owner row mismatch"
                return false
            var ownerStatementIndex = -1
            for statementIndex in 0..<statements.len:
                if statements[statementIndex].normalizedExprRow !=
                       scope.ownerStatementRow:
                    continue
                if ownerStatementIndex >= 0:
                    err =
                        " compiler parser span receipt: scope owner ambiguous"
                    return false
                ownerStatementIndex = statementIndex
            if ownerStatementIndex < 0 ||
               statements[ownerStatementIndex].anchorTokenIndex !=
                   anchorTokenIndex:
                err =
                    " compiler parser span receipt: scope owner anchor mismatch"
                return false
        elif scope.ownerDeclarationRow >= 0:
            let declarationRow = scope.ownerDeclarationRow
            if declarationRow >= tree.declarationCount ||
               scope.ownerStatementOrdinal != -1 ||
               scope.ownerStatementRow != -1 ||
               scope.moduleRootAnchor ||
               parserReceiptArenaI32(
                   tree,
                   tree.declarationProducerSourceIndexes,
                   declarationRow) != producerSourceIndex ||
               parserReceiptArenaI32(
                   tree,
                   tree.declarationKinds,
                   declarationRow) !=
                   Int32(parser.ParserDeclarationFunction) ||
               parserReceiptArenaI32(
                   tree,
                   tree.declarationNameTokenIndexes,
                   declarationRow) != anchorTokenIndex:
                err =
                    " compiler parser span receipt: declaration scope owner mismatch"
                return false
            let suiteScopeRow = parserReceiptArenaI32(
                tree,
                tree.declarationSuiteLexicalScopeRows,
                declarationRow)
            if suiteScopeRow < 0 ||
               suiteScopeRow >= tree.declarationLexicalScopeCount ||
               parserReceiptArenaI32(
                   tree,
                   tree.declarationLexicalScopeKinds,
                   suiteScopeRow) !=
                   Int32(
                       parser.ParserDeclarationLexicalScopeFunction) ||
               parserReceiptArenaI32(
                   tree,
                   tree.declarationLexicalScopeOwnerDeclarationRows,
                   suiteScopeRow) != declarationRow:
                err =
                    " compiler parser span receipt: declaration suite owner mismatch"
                return false
        elif !scope.moduleRootAnchor ||
             scope.ownerStatementRow != -1 ||
             scope.ownerDeclarationRow != -1 ||
             scope.parentScopeId != -1 ||
             scope.kind != parser.NormalizedScopeRoot ||
             parserReceiptArenaI32(
                 tree,
                 tree.tokenSourceLocalIndexes,
                 anchorTokenIndex) != 0:
            err =
                " compiler parser span receipt: module root anchor invalid"
            return false
        var parentScopeIndex = -1
        if scope.parentScopeId >= 0:
            for candidateIndex in 0..<layer.scopes.len:
                let candidate = layer.scopes[candidateIndex]
                if candidate.sourcePath == scope.sourcePath &&
                   candidate.scopeId == scope.parentScopeId:
                    if parentScopeIndex >= 0:
                        err =
                            " compiler parser span receipt: scope parent ambiguous"
                        return false
                    parentScopeIndex = candidateIndex
        var fact: ParserSpanNormalizedScopeFact
        fact.producerSourceIndex = producerSourceIndex
        fact.sourceLocalRow = nextScopeRows[producerSourceIndex]
        nextScopeRows[producerSourceIndex] =
            nextScopeRows[producerSourceIndex] + 1
        fact.sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, anchorTokenIndex)
        fact.scopeId = scope.scopeId
        fact.sourceScopeId = scope.sourceScopeId
        fact.parentScopeId = scope.parentScopeId
        fact.parentScopeIndex = parentScopeIndex
        fact.kind = Int32(scope.kind)
        fact.ownerStatementOrdinal = scope.ownerStatementOrdinal
        fact.ownerStatementRow = scope.ownerStatementRow
        fact.ownerDeclarationRow = scope.ownerDeclarationRow
        fact.moduleRootAnchor = scope.moduleRootAnchor
        fact.lexicalOrdinal = scope.lexicalOrdinal
        fact.indentColumn = scope.indentColumn
        fact.anchorTokenIndex = anchorTokenIndex
        fact.lineNumber = scope.startLineNumber
        fact.columnNumber = scope.startColumnNumber
        fact.endLineNumber = scope.endLineNumber
        fact.endColumnNumber = scope.endColumnNumber
        fact.identityRaw32 =
            parserSpanReceiptNormalizedScopeIdentityRaw32(
                tree, scopes.len, fact)
        add(scopes, fact)
    if importEdges.len == 0:
        return true
    if tree.importOrigins == nil:
        err = " compiler parser span receipt: import origins missing"
        return false
    let origins = tree.importOrigins
    if importEdges.len != origins.itemCount:
        err =
            " compiler parser span receipt: import origin coverage mismatch"
        return false
    var usedItems: bool[]
    setLen(usedItems, origins.itemCount)
    for edgeIndex in 0..<importEdges.len:
        let edge = importEdges[edgeIndex]
        let ownerProducerSourceIndex =
            edge.ownerProducerSourceIndex
        let targetProducerSourceIndex = edge.targetProfileIndex
        if ownerProducerSourceIndex < 0 ||
           ownerProducerSourceIndex >= sourcePaths.len ||
           targetProducerSourceIndex < 0 ||
           targetProducerSourceIndex >= sourcePaths.len ||
           edge.ownerModulePath !=
               ownerModulePaths[ownerProducerSourceIndex] ||
           edge.targetModulePath !=
               ownerModulePaths[targetProducerSourceIndex] ||
           edge.targetSourcePath !=
               sourcePaths[targetProducerSourceIndex] ||
           !edge.resolved:
            err =
                " compiler parser span receipt: import graph identity invalid"
            return false
        let matchedItem = edge.importItemRow
        let declarationRow = edge.importDeclarationRow
        if matchedItem < 0 ||
           matchedItem >= origins.itemCount ||
           declarationRow < 0 ||
           declarationRow >= origins.declarationCount ||
           usedItems[matchedItem] ||
           parserReceiptArenaI32(
               tree,
               origins.itemProducerSourceIndexes,
               matchedItem) != ownerProducerSourceIndex ||
           parserReceiptArenaI32(
               tree,
               origins.itemSourceLocalRows,
               matchedItem) != edge.importItemSourceLocalRow ||
           parserReceiptArenaI32(
               tree,
               origins.itemDeclarationRows,
               matchedItem) != declarationRow ||
           parserReceiptArenaI32(
               tree,
               origins.declarationProducerSourceIndexes,
               declarationRow) != ownerProducerSourceIndex ||
           parserReceiptArenaI32(
               tree,
               origins.declarationSourceLocalRows,
               declarationRow) !=
               edge.importDeclarationSourceLocalRow:
            err =
                " compiler parser span receipt: import edge origin row mismatch"
            return false
        usedItems[matchedItem] = true
        let keywordTokenIndex = parserReceiptArenaI32(
            tree,
            origins.declarationKeywordTokenIndexes,
            declarationRow)
        let aliasTokenIndex = parserReceiptArenaI32(
            tree, origins.itemAliasTokenIndexes, matchedItem)
        if (aliasTokenIndex < 0 && edge.importAlias != "") ||
           (aliasTokenIndex >= 0 &&
            parser.ParserValueExprTokenText(
                tree, aliasTokenIndex) != edge.importAlias):
            err =
                " compiler parser span receipt: import alias row mismatch"
            return false
        let tokenStart = parserReceiptArenaI32(
            tree, origins.itemModuleTokenStarts, matchedItem)
        let tokenCount = parserReceiptArenaI32(
            tree, origins.itemModuleTokenCounts, matchedItem)
        var fact: ParserSpanImportEdgeFact
        fact.ownerProducerSourceIndex = ownerProducerSourceIndex
        fact.targetProducerSourceIndex = targetProducerSourceIndex
        fact.sourceDeclarationRaw32 =
            parserSpanReceiptModuleDeclarationIdentityRaw32(
                ownerProducerSourceIndex,
                sourcePaths[ownerProducerSourceIndex],
                ownerModulePaths[ownerProducerSourceIndex])
        fact.targetDeclarationRaw32 =
            parserSpanReceiptModuleDeclarationIdentityRaw32(
                targetProducerSourceIndex,
                sourcePaths[targetProducerSourceIndex],
                ownerModulePaths[targetProducerSourceIndex])
        fact.importDeclarationRow = declarationRow
        fact.importItemRow = matchedItem
        fact.keywordTokenIndex = keywordTokenIndex
        fact.aliasTokenIndex = aliasTokenIndex
        fact.spanStart = parserReceiptArenaI32(
            tree, origins.itemSpanStarts, matchedItem)
        fact.spanEnd = parserReceiptArenaI32(
            tree, origins.itemSpanEnds, matchedItem)
        for tokenOffset in 0..<tokenCount:
            add(fact.moduleTokenIndexes,
                parserReceiptArenaI32(
                    tree,
                    origins.moduleTokenIndexes,
                    tokenStart + tokenOffset))
        fact.prefixTokenCount = parserReceiptArenaI32(
            tree, origins.itemPrefixTokenCounts, matchedItem)
        # The fact sequence owns its managed fields until JSON emission
        # finishes.  Materialize exactly once at that owner boundary; the
        # import graph itself remains borrowed and reusable.
        fact.ownerModulePath =
            parser.ParserOwnedText(edge.ownerModulePath)
        fact.targetModulePath =
            parser.ParserOwnedText(edge.targetModulePath)
        fact.targetSourcePath =
            parser.ParserOwnedText(edge.targetSourcePath)
        fact.targetProfileIndex = edge.targetProfileIndex
        fact.identityRaw32 =
            parserSpanReceiptImportEdgeIdentityRaw32(
                tree, edges.len, fact)
        add(edges, fact)
    for itemRow in 0..<usedItems.len:
        if !usedItems[itemRow]:
            err =
                " compiler parser span receipt: import origin item unconsumed"
            return false
    return true

@borrows
fn parserSpanReceiptTraceRootRaw32(
        tree: parser.ParserValueExprTree,
        nodeIdentities: layout.FixedBytes32[],
        typeSyntaxIdentities: layout.FixedBytes32[],
        typeSyntaxBracketArgIdentities:
            layout.FixedBytes32[],
        typeConstExprIdentities:
            layout.FixedBytes32[],
        declarationIdentities:
            layout.FixedBytes32[],
        annotationIdentities:
            layout.FixedBytes32[],
        annotationArgIdentities:
            layout.FixedBytes32[],
        forwardingProductionIdentities:
            layout.FixedBytes32[],
        normalizedStatementFacts:
            ParserSpanNormalizedStatementFact[],
        normalizedScopeFacts:
            ParserSpanNormalizedScopeFact[],
        importEdgeFacts:
            ParserSpanImportEdgeFact[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(4096)
    parserReceiptAppendText(buf, ParserSpanReceiptTraceDomain)
    parserReceiptAppendI32(buf, tree.nodeCount)
    for nodeIndex in 0..<tree.nodeCount:
        parserReceiptAppendFixed32(buf, nodeIdentities[nodeIndex])
    parserReceiptAppendI32(buf, tree.genericCount)
    for genericIndex in 0..<tree.genericCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.explicitGenericSpanStarts, genericIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.explicitGenericSpanEnds, genericIndex))
    parserReceiptAppendI32(buf, tree.regionCount)
    for regionIndex in 0..<tree.regionCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.regionKinds, regionIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.regionSourceTextIds, regionIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.regionSpanStarts, regionIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.regionSpanEnds, regionIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.regionAnchorTokenIndexes, regionIndex))
    parserReceiptAppendI32(buf, tree.typeSyntaxCount)
    parserReceiptAppendI32(buf, tree.typeSyntaxChildCount)
    parserReceiptAppendI32(buf, tree.typeSyntaxBracketArgCount)
    parserReceiptAppendI32(buf, tree.typeConstExprCount)
    parserReceiptAppendI32(buf, tree.typeGenericSymbolCount)
    parserReceiptAppendI32(buf, tree.typeGenericSymbolChildCount)
    parserReceiptAppendI32(buf, tree.typeEnumVariantCount)
    parserReceiptAppendI32(buf, tree.declarationCount)
    parserReceiptAppendI32(buf, tree.declarationLexicalScopeCount)
    parserReceiptAppendI32(buf, tree.patternCount)
    parserReceiptAppendI32(buf, tree.patternChildCount)
    parserReceiptAppendI32(buf, tree.annotationCount)
    parserReceiptAppendI32(buf, tree.annotationArgCount)
    parserReceiptAppendI32(buf, tree.annotationArgRootCount)
    parserReceiptAppendI32(buf, tree.annotationArgChildCount)
    parserReceiptAppendI32(buf, tree.forwardingProductionCount)
    parserReceiptAppendI32(
        buf, tree.forwardingProductionChildCount)
    parserReceiptAppendI32(buf, tree.producerSourceCount)
    for typeNodeIndex in 0..<tree.typeSyntaxCount:
        parserReceiptAppendFixed32(
            buf, typeSyntaxIdentities[typeNodeIndex])
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxKinds, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxProducerSourceIndexes, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSourceLocalRows, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSourceTextIds, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSpanStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSpanEnds, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxOwnerTokenIndexes, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxDeclarationOwnerTokenIndexes,
                typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxDeclarationOwnerNodeIndexes,
                typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxGenericSymbolStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxGenericSymbolCounts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxChildStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxChildCounts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgCounts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxNameTokenIndexes, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxFixedLengths, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeSyntaxQuestionTokenIndexes,
                typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxRootKinds, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxEnumVariantStarts, typeNodeIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxEnumVariantCounts, typeNodeIndex))
    for childIndex in 0..<tree.typeSyntaxChildCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxChildNodeIndexes, childIndex))
    for argIndex in 0..<tree.typeSyntaxBracketArgCount:
        parserReceiptAppendFixed32(
            buf, typeSyntaxBracketArgIdentities[argIndex])
    for constIndex in 0..<tree.typeConstExprCount:
        parserReceiptAppendFixed32(
            buf, typeConstExprIdentities[constIndex])
    for symbolIndex in 0..<tree.typeGenericSymbolCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolProducerSourceIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolNameTokenIndexes, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolOrdinals, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolSpanStarts, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolSpanEnds, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
                symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolChildStarts, symbolIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolChildCounts, symbolIndex))
    parserReceiptAppendI32(buf, tree.typeGenericSymbolChildCount)
    for childIndex in 0..<tree.typeGenericSymbolChildCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolChildTypeSyntaxNodeIndexes,
                childIndex))
    for variantIndex in 0..<tree.typeEnumVariantCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantProducerSourceIndexes,
                variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantDeclarationOwnerNodeIndexes,
                variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantDeclarationOwnerTokenIndexes,
                variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeEnumVariantNameTokenIndexes, variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.typeEnumVariantOrdinals, variantIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
                variantIndex))
    parserReceiptAppendI32(buf, tree.declarationCount)
    for declarationRow in 0..<tree.declarationCount:
        parserReceiptAppendFixed32(
            buf, declarationIdentities[declarationRow])
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationProducerSourceIndexes, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationSourceLocalRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationKinds, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationNameTokenIndexes, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationOwnerRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationFunctionRows, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationTypeSyntaxRootIndexes,
            declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationDefaultStatementRootRows,
            declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationSpanStarts, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationSpanEnds, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationNameSpanStarts, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationNameSpanEnds, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationMutableFlags, declarationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationExportedFlags, declarationRow))
    parserReceiptAppendI32(buf, tree.declarationLexicalScopeCount)
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeProducerSourceIndexes,
            scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeSourceLocalRows, scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeKinds, scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.declarationLexicalScopeParentRows, scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeOwnerDeclarationRows,
            scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeSpanStarts,
            scopeRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeSpanEnds,
            scopeRow))
    parserReceiptAppendI32(buf, tree.patternCount)
    for patternRow in 0..<tree.patternCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternProducerSourceIndexes, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternSourceLocalRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternKinds, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternNameTokenIndexes, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternOwnerLexicalScopeRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternOwnerKinds, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternOwnerRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternBindingDeclarationRows, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternTypeSyntaxRootIndexes, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternSpanStarts, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternSpanEnds, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternChildStarts, patternRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternChildCounts, patternRow))
    parserReceiptAppendI32(buf, tree.patternChildCount)
    for childRow in 0..<tree.patternChildCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.patternChildNodeIndexes, childRow))
    parserReceiptAppendI32(buf, tree.annotationCount)
    for annotationRow in 0..<tree.annotationCount:
        parserReceiptAppendFixed32(
            buf, annotationIdentities[annotationRow])
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.annotationProducerSourceIndexes,
            annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationSourceLocalRows, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationNameTokenIndexes, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationTargetTokenIndexes, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationSpanStarts, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationSpanEnds, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgRootStarts, annotationRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgRootCounts, annotationRow))
    parserReceiptAppendI32(buf, tree.annotationArgRootCount)
    for rootRow in 0..<tree.annotationArgRootCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgRootNodeIndexes, rootRow))
    parserReceiptAppendI32(buf, tree.annotationArgCount)
    for annotationArgRow in 0..<tree.annotationArgCount:
        parserReceiptAppendFixed32(
            buf, annotationArgIdentities[annotationArgRow])
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.annotationArgProducerSourceIndexes,
            annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgSourceLocalRows, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgOwnerRows, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgKinds, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgTokenIndexes, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.annotationArgSeparatorTokenIndexes,
            annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgSpanStarts, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgSpanEnds, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgChildStarts, annotationArgRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgChildCounts, annotationArgRow))
    parserReceiptAppendI32(buf, tree.annotationArgChildCount)
    for childRow in 0..<tree.annotationArgChildCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree, tree.annotationArgChildNodeIndexes, childRow))
    parserReceiptAppendI32(buf, tree.forwardingProductionCount)
    for forwardingRow in 0..<tree.forwardingProductionCount:
        parserReceiptAppendFixed32(
            buf,
            forwardingProductionIdentities[forwardingRow])
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionProducerSourceIndexes,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionSourceLocalRows,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionKinds,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionArmIndexes,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionOwnerRows,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAnchorTokenIndexes,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionSpanStartTokenIndexes,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionSpanEndTokenIndexes,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionSpanStarts,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionSpanEnds,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAuthorityKinds,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAuthorityRows,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAnnotationStarts,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAnnotationCounts,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionChildStarts,
            forwardingRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionChildCounts,
            forwardingRow))
    parserReceiptAppendI32(buf, tree.forwardingProductionChildCount)
    for forwardingChildRow in
            0..<tree.forwardingProductionChildCount:
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionChildKinds,
            forwardingChildRow))
        parserReceiptAppendI32(buf, parserReceiptArenaI32(
            tree,
            tree.forwardingProductionChildRows,
            forwardingChildRow))
    parserReceiptAppendI32(buf, tree.rootCount)
    for rootIndex in 0..<tree.rootCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.rootNodeIndexes, rootIndex))
    parserReceiptAppendI32(buf, tree.tokenCount)
    for tokenIndex in 0..<tree.tokenCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenKinds, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenSourceTextIds, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.tokenProducerSourceIndexes, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.tokenSourceLocalIndexes, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.tokenLexicalParentIndexes, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenStarts, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenEnds, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenLineNumbers, tokenIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.tokenColumnNumbers, tokenIndex))
    parserReceiptAppendI32(buf, tree.callEventCount)
    for eventIndex in 0..<tree.callEventCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.callEventNodeIndexes, eventIndex))
    parserReceiptAppendI32(buf, tree.statementRootCount)
    for rootIndex in 0..<tree.statementRootCount:
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootNodeIndexes, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(tree, tree.statementRootRoles, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootAnchorTokenIndexes, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.statementRootBindingDeclarationStarts,
                rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree,
                tree.statementRootBindingDeclarationCounts,
                rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootAnchorLineNumbers, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootAnchorColumnNumbers, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootEndLineNumbers, rootIndex))
        parserReceiptAppendI32(buf,
            parserReceiptArenaI32(
                tree, tree.statementRootEndColumnNumbers, rootIndex))
    parserReceiptAppendI32(buf, normalizedStatementFacts.len)
    for row in 0..<normalizedStatementFacts.len:
        parserReceiptAppendFixed32(
            buf, normalizedStatementFacts[row].identityRaw32)
    parserReceiptAppendI32(buf, normalizedScopeFacts.len)
    for row in 0..<normalizedScopeFacts.len:
        parserReceiptAppendFixed32(
            buf, normalizedScopeFacts[row].identityRaw32)
    parserReceiptAppendI32(buf, importEdgeFacts.len)
    for row in 0..<importEdgeFacts.len:
        parserReceiptAppendFixed32(
            buf, importEdgeFacts[row].identityRaw32)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

# Exact contained-token projection: tokenStart is the first driver token fully
# inside the node character span, tokenEnd is one past the last; both are -1
# when the node carries no valid span or contains no complete token.  No
# heuristic snapping: fusion retokenizes from character spans, this pair only
# cross-references the driver token stream emitted beside it.
@borrows
fn parserSpanReceiptCurrentTraceRootRaw32(
        tree: parser.ParserValueExprTree,
        forwardingProductionIdentities:
            layout.FixedBytes32[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(4096)
    parserReceiptAppendText(
        buf,
        "cheng.parser_span_receipt.current_forwarding_trace")
    parserReceiptAppendI32(buf, tree.tokenCount)
    for tokenRow in 0..<tree.tokenCount:
        parserSpanReceiptAppendTokenIdentity(buf, tree, tokenRow)
    parserReceiptAppendI32(buf, tree.forwardingProductionCount)
    for forwardingRow in 0..<tree.forwardingProductionCount:
        parserReceiptAppendFixed32(
            buf,
            forwardingProductionIdentities[forwardingRow])
    parserReceiptAppendI32(
        buf, tree.forwardingProductionChildCount)
    for childRow in 0..<tree.forwardingProductionChildCount:
        parserReceiptAppendI32(
            buf,
            parserReceiptArenaI32(
                tree,
                tree.forwardingProductionChildKinds,
                childRow))
        parserReceiptAppendI32(
            buf,
            parserReceiptArenaI32(
                tree,
                tree.forwardingProductionChildRows,
                childRow))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptNodeTokenSpan(tree: parser.ParserValueExprTree,
                                  nodeIndex: int32,
                                  tokenStartOut: var int32,
                                  tokenEndOut: var int32) =
    tokenStartOut = -1
    tokenEndOut = -1
    let sourceTextId = parserReceiptArenaI32(
        tree, tree.sourceTextIds, nodeIndex)
    let spanStart = parserReceiptArenaI32(tree, tree.spanStarts, nodeIndex)
    let spanEnd = parserReceiptArenaI32(tree, tree.spanEnds, nodeIndex)
    if spanStart < 0 || spanEnd < spanStart:
        return
    for tokenIndex in 0..<tree.tokenCount:
        if parserReceiptArenaI32(
               tree, tree.tokenSourceTextIds, tokenIndex) != sourceTextId:
            continue
        let start = parserReceiptArenaI32(tree, tree.tokenStarts, tokenIndex)
        let stop = parserReceiptArenaI32(tree, tree.tokenEnds, tokenIndex)
        if start >= spanStart && stop <= spanEnd:
            if tokenStartOut < 0:
                tokenStartOut = tokenIndex
            tokenEndOut = tokenIndex + 1

fn parserSpanReceiptSourceTextIdRecord(seen: var int32[],
                                       sourceTextId: int32) =
    if sourceTextId < 0:
        return
    for index in 0..<seen.len:
        if seen[index] == sourceTextId:
            return
    var insertIndex = seen.len
    add(seen, sourceTextId)
    while insertIndex > 0 && seen[insertIndex - 1] > sourceTextId:
        seen[insertIndex] = seen[insertIndex - 1]
        insertIndex = insertIndex - 1
    seen[insertIndex] = sourceTextId

# sha256 of the exact UTF-8 bytes of a receipt-grade text artifact (used for
# the toolchain manifest identity).
@borrows
fn ParserSpanReceiptTextSha256Hex(text: str): str =
    return layout.FixedBytes32Hex(parserReceiptTextRaw32(text))

# Toolchain manifest (S1 3.1.2 driver-side artifact): the exact JSON text
# whose sha256 becomes toolchainManifestSha256.  Key order is fixed by
# construction; the same text is embedded verbatim in the receipt document so
# the hash input is never ambiguous.
@borrows
fn ParserSpanReceiptToolchainManifestBuild(driverPath: str,
                                           driverSha256: str,
                                           packageRoot: str,
                                           rootDir: str): Result[str] =
    if driverPath == "" || packageRoot == "" || rootDir == "":
        return Err[str](
            " compiler parser span receipt: empty toolchain manifest identity")
    if !parserSpanReceiptHex64Valid(driverSha256):
        return Err[str](
            " compiler parser span receipt: driver sha256 is not 64-hex")
    var buf = buffer.NewByteBuffer()
    buffer.AppendText(buf, "{\n")
    parserSpanReceiptJsonFieldStr(buf, "schema",
                                  ParserSpanReceiptManifestSchema, true)
    parserSpanReceiptJsonFieldStr(buf, "producerIdentity",
                                  ParserSpanReceiptProducerIdentity, true)
    parserSpanReceiptJsonFieldStr(buf, "driverPath", driverPath, true)
    parserSpanReceiptJsonFieldStr(buf, "driverBytesSha256",
                                  driverSha256, true)
    parserSpanReceiptJsonFieldStr(buf, "packageRoot", packageRoot, true)
    parserSpanReceiptJsonFieldStr(buf, "rootDir", rootDir, false)
    buffer.AppendText(buf, "}\n")
    return Ok[str](buffer.FinishString(buf))

@borrows
fn ParserSpanReceiptJsonBuild(
        layer: var parser.NormalizedExprLayer,
        relativePath: str,
        sourcePath: str,
        sourceSha256: str,
        driverBytesSha256: str,
        toolchainManifestText: str,
        sourcePaths: str[],
        ownerModulePaths: str[],
        importEdges: parser.ImportEdge[]): Result[str] =
    if relativePath == "" || sourcePath == "":
        return Err[str](
            " compiler parser span receipt: empty source identity")
    if !parserSpanReceiptHex64Valid(sourceSha256) ||
       !parserSpanReceiptHex64Valid(driverBytesSha256):
        return Err[str](
            " compiler parser span receipt: identity hash is not 64-hex")
    if toolchainManifestText.len <= 2:
        return Err[str](
            " compiler parser span receipt: toolchain manifest missing")
    let toolchainManifestSha256 = ParserSpanReceiptTextSha256Hex(
        toolchainManifestText)
    if layer.valueExprTree == nil:
        return Err[str](
            " compiler parser span receipt: value expr tree missing")
    var tree = parser.ParserValueExprTreeBorrow(layer.valueExprTree)
    if !parserReceiptTreeArrayShape(tree):
        parser.ParserValueExprTreeReleaseBorrow(tree)
        return Err[str](
            " compiler parser span receipt: value tree SoA shape mismatch")
    var typeSyntaxErr: str
    if !parser.ParserValueExprTreeTypeSyntaxBracketArgsStrictValidateInto(
           tree, typeSyntaxErr):
        parser.ParserValueExprTreeReleaseBorrow(tree)
        return Err[str](
            Fmt" compiler parser span receipt: {typeSyntaxErr}")
    var declarationErr: str
    if !parser.ParserValueExprTreeDeclarationsStrictValidateInto(
           tree, declarationErr):
        parser.ParserValueExprTreeReleaseBorrow(tree)
        return Err[str](
            Fmt" compiler parser span receipt: {declarationErr}")
    var annotationErr: str
    if !parser.ParserValueExprTreeAnnotationsStrictValidateInto(
           tree, annotationErr):
        parser.ParserValueExprTreeReleaseBorrow(tree)
        return Err[str](
            Fmt" compiler parser span receipt: {annotationErr}")
    var forwardingErr: str
    if !parser.ParserValueExprTreeForwardingProductionsStrictValidateInto(
           tree, forwardingErr):
        parser.ParserValueExprTreeReleaseBorrow(tree)
        return Err[str](
            Fmt" compiler parser span receipt: {forwardingErr}")
    for annotationRow in 0..<tree.annotationCount:
        let annotationNameToken = parserReceiptArenaI32(
            tree, tree.annotationNameTokenIndexes, annotationRow)
        if !parser.ParserNormalizedAnnotationRegisteredName(
               parser.ParserValueExprTokenText(
                   tree, annotationNameToken)):
            parser.ParserValueExprTreeReleaseBorrow(tree)
            return Err[str](
                " compiler parser span receipt: unregistered annotation")
    var nodeIdentities: layout.FixedBytes32[]
    for nodeIndex in 0..<tree.nodeCount:
        let nodeIdentity = parserSpanReceiptNodeIdentityRaw32(
            tree, nodeIndex)
        add(nodeIdentities, nodeIdentity)
    var typeSyntaxIdentities: layout.FixedBytes32[]
    for typeSyntaxRow in 0..<tree.typeSyntaxCount:
        let typeSyntaxIdentity =
            parserSpanReceiptTypeSyntaxIdentityRaw32(tree, typeSyntaxRow)
        add(typeSyntaxIdentities, typeSyntaxIdentity)
    var typeSyntaxBracketArgOwnerIndexes: int32[]
    var typeSyntaxBracketArgOrdinals: int32[]
    setLen(typeSyntaxBracketArgOwnerIndexes,
           tree.typeSyntaxBracketArgCount)
    setLen(typeSyntaxBracketArgOrdinals,
           tree.typeSyntaxBracketArgCount)
    var typeSyntaxBracketArgCursor: int32
    for typeSyntaxRow in 0..<tree.typeSyntaxCount:
        let argStart = parserReceiptArenaI32(
            tree, tree.typeSyntaxBracketArgStarts, typeSyntaxRow)
        let argCount = parserReceiptArenaI32(
            tree, tree.typeSyntaxBracketArgCounts, typeSyntaxRow)
        if argStart != typeSyntaxBracketArgCursor || argCount < 0 ||
           argStart + argCount > tree.typeSyntaxBracketArgCount:
            parser.ParserValueExprTreeReleaseBorrow(tree)
            return Err[str](
                " compiler parser span receipt: bracket argument owner CSR invalid")
        for ordinal in 0..<argCount:
            let argRow = argStart + ordinal
            typeSyntaxBracketArgOwnerIndexes[argRow] = typeSyntaxRow
            typeSyntaxBracketArgOrdinals[argRow] = ordinal
        typeSyntaxBracketArgCursor =
            typeSyntaxBracketArgCursor + argCount
    if typeSyntaxBracketArgCursor != tree.typeSyntaxBracketArgCount:
        parser.ParserValueExprTreeReleaseBorrow(tree)
        return Err[str](
            " compiler parser span receipt: bracket argument owner coverage invalid")
    var typeSyntaxBracketArgIdentities: layout.FixedBytes32[]
    for argRow in 0..<tree.typeSyntaxBracketArgCount:
        let bracketArgIdentity =
            parserSpanReceiptTypeSyntaxBracketArgIdentityRaw32(
                tree,
                argRow,
                typeSyntaxBracketArgOwnerIndexes[argRow],
                typeSyntaxBracketArgOrdinals[argRow])
        add(typeSyntaxBracketArgIdentities, bracketArgIdentity)
    var typeEnumVariantIdentities: layout.FixedBytes32[]
    for variantRow in 0..<tree.typeEnumVariantCount:
        let variantIdentity = parserSpanReceiptTypeEnumVariantIdentityRaw32(
            tree, variantRow, typeSyntaxIdentities)
        add(typeEnumVariantIdentities, variantIdentity)
    var typeConstExprIdentities: layout.FixedBytes32[]
    for constRow in 0..<tree.typeConstExprCount:
        let constIdentity = parserSpanReceiptTypeConstExprTreeIdentityRaw32(
            tree, constRow)
        add(typeConstExprIdentities, constIdentity)
    var typeGenericSymbolIdentities: layout.FixedBytes32[]
    for symbolRow in 0..<tree.typeGenericSymbolCount:
        let symbolIdentity = parserSpanReceiptTypeGenericSymbolIdentityRaw32(
            tree, symbolRow)
        add(typeGenericSymbolIdentities, symbolIdentity)
    var declarationLexicalScopeIdentities: layout.FixedBytes32[]
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        let scopeIdentity =
            parserSpanReceiptDeclarationLexicalScopeIdentityRaw32(
                tree, scopeRow)
        add(declarationLexicalScopeIdentities, scopeIdentity)
    var declarationIdentities: layout.FixedBytes32[]
    for declarationRow in 0..<tree.declarationCount:
        let declarationIdentity = parserSpanReceiptDeclarationIdentityRaw32(
            tree,
            declarationRow,
            typeSyntaxIdentities,
            typeGenericSymbolIdentities,
            declarationIdentities,
            declarationLexicalScopeIdentities)
        add(declarationIdentities, declarationIdentity)
    var patternIdentities: layout.FixedBytes32[]
    for patternRow in 0..<tree.patternCount:
        let patternIdentity = parserSpanReceiptPatternIdentityRaw32(
            tree, patternRow)
        add(patternIdentities, patternIdentity)
    var annotationArgIdentities: layout.FixedBytes32[]
    for annotationArgRow in 0..<tree.annotationArgCount:
        let annotationArgIdentity =
            parserSpanReceiptAnnotationArgIdentityRaw32(
                tree,
                annotationArgRow,
                annotationArgIdentities)
        add(annotationArgIdentities, annotationArgIdentity)
    var annotationIdentities: layout.FixedBytes32[]
    for annotationRow in 0..<tree.annotationCount:
        let annotationIdentity = parserSpanReceiptAnnotationIdentityRaw32(
            tree,
            annotationRow,
            annotationArgIdentities)
        add(annotationIdentities, annotationIdentity)
    var forwardingProductionIdentities: layout.FixedBytes32[]
    setLen(
        forwardingProductionIdentities,
        tree.forwardingProductionCount)
    var forwardingRow = tree.forwardingProductionCount
    while forwardingRow > 0:
        forwardingRow = forwardingRow - 1
        forwardingProductionIdentities[forwardingRow] =
            parserSpanReceiptForwardingProductionIdentityRaw32(
                tree,
                forwardingRow,
                nodeIdentities,
                typeSyntaxIdentities,
                declarationIdentities,
                patternIdentities,
                annotationIdentities,
                declarationLexicalScopeIdentities,
                forwardingProductionIdentities)
    var normalizedStatementFacts:
        ParserSpanNormalizedStatementFact[]
    var normalizedScopeFacts: ParserSpanNormalizedScopeFact[]
    var importEdgeFacts: ParserSpanImportEdgeFact[]
    var structureFactsErr: str
    if !parserSpanReceiptBuildCurrentStructureFacts(
           layer,
           tree,
           sourcePaths,
           ownerModulePaths,
           importEdges,
           normalizedStatementFacts,
           normalizedScopeFacts,
           importEdgeFacts,
           structureFactsErr):
        parser.ParserValueExprTreeReleaseBorrow(tree)
        return Err[str](structureFactsErr)
    let traceRootRaw32 = parserSpanReceiptCurrentTraceRootRaw32(
        tree,
        forwardingProductionIdentities)
    var sourceTextIdsSeen: int32[]
    for nodeIndex in 0..<tree.nodeCount:
        parserSpanReceiptSourceTextIdRecord(
            sourceTextIdsSeen,
            parserReceiptArenaI32(tree, tree.sourceTextIds, nodeIndex))
    for tokenIndex in 0..<tree.tokenCount:
        parserSpanReceiptSourceTextIdRecord(
            sourceTextIdsSeen,
            parserReceiptArenaI32(tree, tree.tokenSourceTextIds, tokenIndex))
    for typeSyntaxRow in 0..<tree.typeSyntaxCount:
        parserSpanReceiptSourceTextIdRecord(
            sourceTextIdsSeen,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSourceTextIds, typeSyntaxRow))
    for regionIndex in 0..<tree.regionCount:
        parserSpanReceiptSourceTextIdRecord(
            sourceTextIdsSeen,
            parserReceiptArenaI32(
                tree, tree.regionSourceTextIds, regionIndex))
    var buf = buffer.NewByteBuffer()
    buffer.AppendText(buf, "{\n")
    parserSpanReceiptJsonFieldStr(buf, "schema",
                                  ParserSpanReceiptSchema, true)
    parserSpanReceiptJsonFieldStr(buf, "stage",
                                  ParserSpanReceiptStage, true)
    parserSpanReceiptJsonFieldStr(buf, "producerIdentity",
                                  ParserSpanReceiptProducerIdentity, true)
    parserSpanReceiptJsonFieldStr(buf, "relativePath", relativePath, true)
    parserSpanReceiptJsonFieldStr(buf, "sourcePath", sourcePath, true)
    parserSpanReceiptJsonFieldStr(buf, "sourceSha256", sourceSha256, true)
    parserSpanReceiptJsonFieldStr(buf, "driverBytesSha256",
                                  driverBytesSha256, true)
    parserSpanReceiptJsonFieldStr(buf, "toolchainManifestSha256",
                                  toolchainManifestSha256, true)
    parserSpanReceiptJsonFieldStr(buf, "parserTraceRootSha256",
        layout.FixedBytes32Hex(traceRootRaw32), true)
    buffer.AppendText(buf, "  \"toolchainManifest\": ")
    buffer.AppendText(buf, toolchainManifestText)
    buffer.AppendText(buf, ",\n")
    buffer.AppendText(buf, "  \"counts\": {\"nodeCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.nodeCount))
    buffer.AppendText(buf, ", \"genericCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.genericCount))
    buffer.AppendText(buf, ", \"rootCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.rootCount))
    buffer.AppendText(buf, ", \"tokenCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.tokenCount))
    buffer.AppendText(buf, ", \"callEventCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.callEventCount))
    buffer.AppendText(buf, ", \"statementRootCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.statementRootCount))
    buffer.AppendText(buf, ", \"typeSyntaxCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.typeSyntaxCount))
    buffer.AppendText(buf, ", \"typeSyntaxChildCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.typeSyntaxChildCount))
    buffer.AppendText(buf, ", \"typeEnumVariantCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.typeEnumVariantCount))
    buffer.AppendText(buf, ", \"typeSyntaxBracketArgCount\": ")
    buffer.AppendText(
        buf, strings.IntToStr(tree.typeSyntaxBracketArgCount))
    buffer.AppendText(buf, ", \"typeConstExprCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.typeConstExprCount))
    buffer.AppendText(buf, ", \"typeGenericSymbolCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.typeGenericSymbolCount))
    buffer.AppendText(buf, ", \"typeGenericSymbolChildCount\": ")
    buffer.AppendText(buf,
        strings.IntToStr(tree.typeGenericSymbolChildCount))
    buffer.AppendText(buf, ", \"regionCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.regionCount))
    buffer.AppendText(buf, ", \"declarationCount\": ")
    buffer.AppendText(buf, strings.IntToStr(tree.declarationCount))
    buffer.AppendText(buf, ", \"declarationLexicalScopeCount\": ")
    buffer.AppendText(
