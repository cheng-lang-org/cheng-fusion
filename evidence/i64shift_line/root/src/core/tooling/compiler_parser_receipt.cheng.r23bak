            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.patternOwnerKinds, patternRow)))
        buffer.AppendText(buf, ", \"ownerRow\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.patternOwnerRows, patternRow)))
        buffer.AppendText(buf, ", \"bindingDeclarationIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.patternBindingDeclarationRows,
                patternRow)))
        buffer.AppendText(buf, ", \"typeSyntaxRootIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.patternTypeSyntaxRootIndexes,
                patternRow)))
        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.patternSpanStarts, patternRow)))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.patternSpanEnds, patternRow)))
        buffer.AppendText(buf, ", \"childStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.patternChildStarts, patternRow)))
        buffer.AppendText(buf, ", \"childCount\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.patternChildCounts, patternRow)))
        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(buf,
            layout.FixedBytes32Hex(patternIdentities[patternRow]))
        buffer.AppendText(buf, "\"}")
        if patternRow + 1 < tree.patternCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"patternChildren\": [")
    for childRow in 0..<tree.patternChildCount:
        if childRow > 0:
            buffer.AppendText(buf, ", ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.patternChildNodeIndexes, childRow)))
    buffer.AppendText(buf, "],\n")
    buffer.AppendText(buf, "  \"annotations\": [\n")
    for annotationRow in 0..<tree.annotationCount:
        let nameToken = parserReceiptArenaI32(
            tree, tree.annotationNameTokenIndexes, annotationRow)
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(annotationRow))
        buffer.AppendText(buf, ", \"producerSourceIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationProducerSourceIndexes,
                annotationRow)))
        buffer.AppendText(buf, ", \"sourceTextId\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenSourceTextIds, nameToken)))
        buffer.AppendText(buf, ", \"sourceLocalRow\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.annotationSourceLocalRows, annotationRow)))
        buffer.AppendText(buf, ", \"nameTokenIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(nameToken))
        buffer.AppendText(buf, ", \"targetTokenIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationTargetTokenIndexes,
                annotationRow)))
        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.annotationSpanStarts, annotationRow)))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.annotationSpanEnds, annotationRow)))
        buffer.AppendText(buf, ", \"argRootStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.annotationArgRootStarts, annotationRow)))
        buffer.AppendText(buf, ", \"argRootCount\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.annotationArgRootCounts, annotationRow)))
        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(buf,
            layout.FixedBytes32Hex(
                annotationIdentities[annotationRow]))
        buffer.AppendText(buf, "\"}")
        if annotationRow + 1 < tree.annotationCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"annotationArgRoots\": [")
    for rootRow in 0..<tree.annotationArgRootCount:
        if rootRow > 0:
            buffer.AppendText(buf, ", ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgRootNodeIndexes,
                rootRow)))
    buffer.AppendText(buf, "],\n")
    buffer.AppendText(buf, "  \"annotationArgs\": [\n")
    for annotationArgRow in 0..<tree.annotationArgCount:
        let token = parserReceiptArenaI32(
            tree,
            tree.annotationArgTokenIndexes,
            annotationArgRow)
        let kind = parserReceiptArenaI32(
            tree, tree.annotationArgKinds, annotationArgRow)
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(annotationArgRow))
        buffer.AppendText(buf, ", \"producerSourceIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgProducerSourceIndexes,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"sourceTextId\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenSourceTextIds, token)))
        buffer.AppendText(buf, ", \"sourceLocalRow\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgSourceLocalRows,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"ownerAnnotationIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgOwnerRows,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"kind\": ")
        buffer.AppendText(buf, strings.IntToStr(kind))
        buffer.AppendText(buf, ", \"kindText\": \"")
        buffer.AppendText(buf,
            parser.ParserAnnotationArgKindText(
                parser.ParserAnnotationArgKind(kind)))
        buffer.AppendText(buf, "\", \"tokenIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(token))
        buffer.AppendText(buf, ", \"separatorTokenIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgSeparatorTokenIndexes,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgSpanStarts,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgSpanEnds,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"childStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgChildStarts,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"childCount\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgChildCounts,
                annotationArgRow)))
        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(buf,
            layout.FixedBytes32Hex(
                annotationArgIdentities[annotationArgRow]))
        buffer.AppendText(buf, "\"}")
        if annotationArgRow + 1 < tree.annotationArgCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"annotationArgChildren\": [")
    for childRow in 0..<tree.annotationArgChildCount:
        if childRow > 0:
            buffer.AppendText(buf, ", ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.annotationArgChildNodeIndexes,
                childRow)))
    buffer.AppendText(buf, "],\n")
    buffer.AppendText(buf, "  \"forwardingProductions\": [\n")
    for forwardingRow in 0..<tree.forwardingProductionCount:
        let kind = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionKinds,
            forwardingRow)
        let authorityKind = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAuthorityKinds,
            forwardingRow)
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(forwardingRow))
        buffer.AppendText(buf, ", \"producerSourceIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionProducerSourceIndexes,
                forwardingRow)))
        buffer.AppendText(buf, ", \"sourceLocalRow\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionSourceLocalRows,
                forwardingRow)))
        buffer.AppendText(buf, ", \"kind\": ")
        buffer.AppendText(buf, strings.IntToStr(kind))
        buffer.AppendText(buf, ", \"kindText\": \"")
        buffer.AppendText(
            buf,
            parser.ParserForwardingProductionKindText(
                parser.ParserForwardingProductionKind(kind)))
        buffer.AppendText(buf, "\", \"armIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionArmIndexes,
                forwardingRow)))
        buffer.AppendText(buf, ", \"ownerIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionOwnerRows,
                forwardingRow)))
        buffer.AppendText(buf, ", \"anchorTokenIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionAnchorTokenIndexes,
                forwardingRow)))
        buffer.AppendText(buf, ", \"spanStartTokenIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionSpanStartTokenIndexes,
                forwardingRow)))
        buffer.AppendText(buf, ", \"spanEndTokenIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionSpanEndTokenIndexes,
                forwardingRow)))
        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionSpanStarts,
                forwardingRow)))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionSpanEnds,
                forwardingRow)))
        buffer.AppendText(buf, ", \"authorityKind\": ")
        buffer.AppendText(buf, strings.IntToStr(authorityKind))
        buffer.AppendText(buf, ", \"authorityKindText\": \"")
        buffer.AppendText(
            buf,
            parser.ParserForwardingProductionChildKindText(
                parser.ParserForwardingProductionChildKind(
                    authorityKind)))
        buffer.AppendText(buf, "\", \"authorityRow\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionAuthorityRows,
                forwardingRow)))
        buffer.AppendText(buf, ", \"annotationStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionAnnotationStarts,
                forwardingRow)))
        buffer.AppendText(buf, ", \"annotationCount\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionAnnotationCounts,
                forwardingRow)))
        buffer.AppendText(buf, ", \"childStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionChildStarts,
                forwardingRow)))
        buffer.AppendText(buf, ", \"childCount\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.forwardingProductionChildCounts,
                forwardingRow)))
        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(
            buf,
            layout.FixedBytes32Hex(
                forwardingProductionIdentities[forwardingRow]))
        buffer.AppendText(buf, "\"}")
        if forwardingRow + 1 < tree.forwardingProductionCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(
        buf, "  \"forwardingProductionChildren\": [\n")
    for forwardingChildRow in
            0..<tree.forwardingProductionChildCount:
        let childKind = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionChildKinds,
            forwardingChildRow)
        let childTargetRow = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionChildRows,
            forwardingChildRow)
        var parentRow: int32 = -1
        var childOrdinal: int32 = -1
        for candidateParent in 0..<tree.forwardingProductionCount:
            let candidateStart = parserReceiptArenaI32(
                tree,
                tree.forwardingProductionChildStarts,
                candidateParent)
            let candidateCount = parserReceiptArenaI32(
                tree,
                tree.forwardingProductionChildCounts,
                candidateParent)
            if forwardingChildRow >= candidateStart &&
               forwardingChildRow < candidateStart + candidateCount:
                if parentRow >= 0:
                    panic(
                        "compiler parser receipt: forwarding child parent duplicate")
                parentRow = candidateParent
                childOrdinal = forwardingChildRow - candidateStart
        if parentRow < 0 || childOrdinal < 0:
            panic("compiler parser receipt: forwarding child parent missing")
        let parentAuthorityKind =
            parser.ParserForwardingProductionChildKind(
                parserReceiptArenaI32(
                    tree,
                    tree.forwardingProductionAuthorityKinds,
                    parentRow))
        let parentAnnotationCount = parserReceiptArenaI32(
            tree,
            tree.forwardingProductionAnnotationCounts,
            parentRow)
        var childRole: int32 = 3
        var childRoleText = "forwarding"
        if childOrdinal == 0 &&
           parentAuthorityKind !=
               parser.ParserForwardingProductionChildInvalid:
            childRole = 1
            childRoleText = "authority"
        elif childOrdinal <
             (parentAuthorityKind !=
                  parser.ParserForwardingProductionChildInvalid ?
                  1 : 0) + parentAnnotationCount:
            childRole = 2
            childRoleText = "annotation"
        let childKindValue =
            parser.ParserForwardingProductionChildKind(childKind)
        let targetProducerSourceIndex =
            parser.ParserValueExprForwardingProductionChildProducerSourceIndexAt(
                tree, childKindValue, childTargetRow)
        let targetSourceTextId =
            parser.ParserValueExprForwardingProductionChildSourceTextIdAt(
                tree, childKindValue, childTargetRow)
        let targetSpanStart =
            parser.ParserValueExprForwardingProductionChildSpanStartAt(
                tree, childKindValue, childTargetRow)
        let targetSpanEnd =
            parser.ParserValueExprForwardingProductionChildSpanEndAt(
                tree, childKindValue, childTargetRow)
        let targetIdentity =
            parserSpanReceiptForwardingChildTargetIdentityRaw32(
                tree,
                childKindValue,
                childTargetRow,
                nodeIdentities,
                typeSyntaxIdentities,
                declarationIdentities,
                patternIdentities,
                annotationIdentities,
                declarationLexicalScopeIdentities,
                forwardingProductionIdentities)
        buffer.AppendText(buf, "    {\"parentIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(parentRow))
        buffer.AppendText(buf, ", \"ordinal\": ")
        buffer.AppendText(buf, strings.IntToStr(childOrdinal))
        buffer.AppendText(buf, ", \"role\": ")
        buffer.AppendText(buf, strings.IntToStr(childRole))
        buffer.AppendText(buf, ", \"roleText\": \"")
        buffer.AppendText(buf, childRoleText)
        buffer.AppendText(buf, "\", \"kind\": ")
        buffer.AppendText(buf, strings.IntToStr(childKind))
        buffer.AppendText(buf, ", \"kindText\": \"")
        buffer.AppendText(
            buf,
            parser.ParserForwardingProductionChildKindText(
                parser.ParserForwardingProductionChildKind(
                    childKind)))
        buffer.AppendText(buf, "\", \"row\": ")
        buffer.AppendText(buf, strings.IntToStr(childTargetRow))
        buffer.AppendText(buf, ", \"producerSourceIndex\": ")
        buffer.AppendText(
            buf, strings.IntToStr(targetProducerSourceIndex))
        buffer.AppendText(buf, ", \"sourceTextId\": ")
        buffer.AppendText(buf, strings.IntToStr(targetSourceTextId))
        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf, strings.IntToStr(targetSpanStart))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf, strings.IntToStr(targetSpanEnd))
        buffer.AppendText(buf, ", \"targetIdentitySha256\": \"")
        buffer.AppendText(buf, layout.FixedBytes32Hex(targetIdentity))
        buffer.AppendText(buf, "\"}")
        if forwardingChildRow + 1 <
           tree.forwardingProductionChildCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"normalizedStatementFacts\": [\n")
    for row in 0..<normalizedStatementFacts.len:
        let fact = normalizedStatementFacts[row]
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(row))
        buffer.AppendText(buf, ", \"producerSourceIndex\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.producerSourceIndex))
        buffer.AppendText(buf, ", \"sourceLocalRow\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.sourceLocalRow))
        buffer.AppendText(buf, ", \"normalizedExprRow\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.normalizedExprRow))
        buffer.AppendText(buf, ", \"sourceTextId\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.sourceTextId))
        buffer.AppendText(buf, ", \"kind\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.kind))
        buffer.AppendText(buf, ", \"kindText\": ")
        parserSpanReceiptJsonAppendEscaped(
            buf,
            parserSpanReceiptNormalizedStatementKindText(fact.kind))
        buffer.AppendText(buf, ", \"anchorTokenIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.anchorTokenIndex))
        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.spanStart))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.spanEnd))
        buffer.AppendText(buf, ", \"line\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.lineNumber))
        buffer.AppendText(buf, ", \"column\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.columnNumber))
        buffer.AppendText(buf, ", \"endLine\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.endLineNumber))
        buffer.AppendText(buf, ", \"endColumn\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.endColumnNumber))
        buffer.AppendText(buf, ", \"rootNodeIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.rootNodeIndex))
        buffer.AppendText(buf, ", \"originNodeIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.originNodeIndex))
        buffer.AppendText(buf, ", \"statementRole\": ")
        parserSpanReceiptJsonAppendEscaped(
            buf,
            parser.ParserValueExprStatementRoleText(
                parser.ParserValueExprStatementRole(
                    fact.statementRole)))
        buffer.AppendText(buf, ", \"lexicalScopeId\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.lexicalScopeId))
        buffer.AppendText(buf, ", \"suiteScopeId\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.suiteScopeId))
        buffer.AppendText(buf, ", \"statementOrdinal\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.statementOrdinal))
        buffer.AppendText(buf, ", \"lexicalOrdinal\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.lexicalOrdinal))
        buffer.AppendText(
            buf, ", \"deferOwnerStatementOrdinal\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.deferOwnerStatementOrdinal))
        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(
            buf, layout.FixedBytes32Hex(fact.identityRaw32))
        buffer.AppendText(buf, "\"}")
        if row + 1 < normalizedStatementFacts.len:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"normalizedScopeFacts\": [\n")
    for row in 0..<normalizedScopeFacts.len:
        let fact = normalizedScopeFacts[row]
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(row))
        buffer.AppendText(buf, ", \"producerSourceIndex\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.producerSourceIndex))
        buffer.AppendText(buf, ", \"sourceLocalRow\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.sourceLocalRow))
        buffer.AppendText(buf, ", \"sourceTextId\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.sourceTextId))
        buffer.AppendText(buf, ", \"scopeId\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.scopeId))
        buffer.AppendText(buf, ", \"sourceScopeId\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.sourceScopeId))
        buffer.AppendText(buf, ", \"parentScopeId\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.parentScopeId))
        buffer.AppendText(buf, ", \"parentScopeIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.parentScopeIndex))
        buffer.AppendText(buf, ", \"kind\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.kind))
        buffer.AppendText(buf, ", \"kindText\": ")
        parserSpanReceiptJsonAppendEscaped(
            buf, parserSpanReceiptNormalizedScopeKindText(fact.kind))
        buffer.AppendText(buf, ", \"ownerStatementOrdinal\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.ownerStatementOrdinal))
        buffer.AppendText(buf, ", \"ownerStatementRow\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.ownerStatementRow))
        buffer.AppendText(buf, ", \"ownerDeclarationRow\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.ownerDeclarationRow))
        buffer.AppendText(buf, ", \"moduleRootAnchor\": ")
        buffer.AppendText(
            buf, fact.moduleRootAnchor ? "true" : "false")
        buffer.AppendText(buf, ", \"lexicalOrdinal\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.lexicalOrdinal))
        buffer.AppendText(buf, ", \"indentColumn\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.indentColumn))
        buffer.AppendText(buf, ", \"anchorTokenIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.anchorTokenIndex))
        buffer.AppendText(buf, ", \"line\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.lineNumber))
        buffer.AppendText(buf, ", \"column\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.columnNumber))
        buffer.AppendText(buf, ", \"endLine\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.endLineNumber))
        buffer.AppendText(buf, ", \"endColumn\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.endColumnNumber))
        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(
            buf, layout.FixedBytes32Hex(fact.identityRaw32))
        buffer.AppendText(buf, "\"}")
        if row + 1 < normalizedScopeFacts.len:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"importEdges\": [\n")
    for row in 0..<importEdgeFacts.len:
        let fact = importEdgeFacts[row]
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(row))
        buffer.AppendText(buf, ", \"ownerProducerSourceIndex\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.ownerProducerSourceIndex))
        buffer.AppendText(buf, ", \"targetProducerSourceIndex\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.targetProducerSourceIndex))
        buffer.AppendText(
            buf, ", \"sourceDeclarationIdentitySha256\": \"")
        buffer.AppendText(
            buf, layout.FixedBytes32Hex(fact.sourceDeclarationRaw32))
        buffer.AppendText(
            buf, "\", \"targetDeclarationIdentitySha256\": \"")
        buffer.AppendText(
            buf, layout.FixedBytes32Hex(fact.targetDeclarationRaw32))
        buffer.AppendText(buf, "\", \"importDeclarationRow\": ")
        buffer.AppendText(
            buf, strings.IntToStr(fact.importDeclarationRow))
        buffer.AppendText(buf, ", \"importItemRow\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.importItemRow))
        buffer.AppendText(buf, ", \"keywordTokenIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.keywordTokenIndex))
        buffer.AppendText(buf, ", \"aliasTokenIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.aliasTokenIndex))
        buffer.AppendText(buf, ", \"spanStart\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.spanStart))
        buffer.AppendText(buf, ", \"spanEnd\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.spanEnd))
        buffer.AppendText(buf, ", \"moduleTokenIndexes\": [")
        for tokenOffset in 0..<fact.moduleTokenIndexes.len:
            if tokenOffset > 0:
                buffer.AppendText(buf, ", ")
            buffer.AppendText(
                buf,
                strings.IntToStr(
                    fact.moduleTokenIndexes[tokenOffset]))
        buffer.AppendText(buf, "], \"prefixTokenCount\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.prefixTokenCount))
        buffer.AppendText(buf, ", \"ownerModulePath\": ")
        parserSpanReceiptJsonAppendEscaped(buf, fact.ownerModulePath)
        buffer.AppendText(buf, ", \"targetModulePath\": ")
        parserSpanReceiptJsonAppendEscaped(buf, fact.targetModulePath)
        buffer.AppendText(buf, ", \"targetSourcePath\": ")
        parserSpanReceiptJsonAppendEscaped(buf, fact.targetSourcePath)
        buffer.AppendText(buf, ", \"targetProfileIndex\": ")
        buffer.AppendText(buf, strings.IntToStr(fact.targetProfileIndex))
        buffer.AppendText(buf, ", \"identitySha256\": \"")
        buffer.AppendText(
            buf, layout.FixedBytes32Hex(fact.identityRaw32))
        buffer.AppendText(buf, "\"}")
        if row + 1 < importEdgeFacts.len:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"tokens\": [\n")
    for tokenIndex in 0..<tree.tokenCount:
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(tokenIndex))
        buffer.AppendText(buf, ", \"kind\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenKinds, tokenIndex)))
        buffer.AppendText(buf, ", \"sourceTextId\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenSourceTextIds, tokenIndex)))
        buffer.AppendText(buf, ", \"producerSourceIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenProducerSourceIndexes, tokenIndex)))
        buffer.AppendText(buf, ", \"sourceLocalIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenSourceLocalIndexes, tokenIndex)))
        buffer.AppendText(buf, ", \"lexicalParentIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenLexicalParentIndexes, tokenIndex)))
        buffer.AppendText(buf, ", \"start\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenStarts, tokenIndex)))
        buffer.AppendText(buf, ", \"end\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenEnds, tokenIndex)))
        buffer.AppendText(buf, ", \"line\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenLineNumbers, tokenIndex)))
        buffer.AppendText(buf, ", \"column\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.tokenColumnNumbers, tokenIndex)))
        buffer.AppendText(buf, "}")
        if tokenIndex + 1 < tree.tokenCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ],\n")
    buffer.AppendText(buf, "  \"statementRoots\": [\n")
    for rootIndex in 0..<tree.statementRootCount:
        buffer.AppendText(buf, "    {\"index\": ")
        buffer.AppendText(buf, strings.IntToStr(rootIndex))
        buffer.AppendText(buf, ", \"nodeIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.statementRootNodeIndexes, rootIndex)))
        buffer.AppendText(buf, ", \"role\": \"")
        buffer.AppendText(buf,
            parser.ParserValueExprStatementRoleText(
                parser.ParserValueExprStatementRole(parserReceiptArenaI32(
                    tree, tree.statementRootRoles, rootIndex))))
        buffer.AppendText(buf, "\", \"anchorTokenIndex\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.statementRootAnchorTokenIndexes, rootIndex)))
        buffer.AppendText(buf, ", \"bindingDeclarationStart\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.statementRootBindingDeclarationStarts,
                rootIndex)))
        buffer.AppendText(buf, ", \"bindingDeclarationCount\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree,
                tree.statementRootBindingDeclarationCounts,
                rootIndex)))
        buffer.AppendText(buf, ", \"anchorLine\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.statementRootAnchorLineNumbers, rootIndex)))
        buffer.AppendText(buf, ", \"anchorColumn\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.statementRootAnchorColumnNumbers, rootIndex)))
        buffer.AppendText(buf, ", \"endLine\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.statementRootEndLineNumbers, rootIndex)))
        buffer.AppendText(buf, ", \"endColumn\": ")
        buffer.AppendText(buf,
            strings.IntToStr(parserReceiptArenaI32(
                tree, tree.statementRootEndColumnNumbers, rootIndex)))
        buffer.AppendText(buf, "}")
        if rootIndex + 1 < tree.statementRootCount:
            buffer.AppendByte(buf, 44)
        buffer.AppendByte(buf, 10)
    buffer.AppendText(buf, "  ]\n")
    buffer.AppendText(buf, "}\n")
    parser.ParserValueExprTreeReleaseBorrow(tree)
    return Ok[str](buffer.FinishString(buf))
