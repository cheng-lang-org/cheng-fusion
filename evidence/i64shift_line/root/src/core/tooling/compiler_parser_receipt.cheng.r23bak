           tree.forwardingProductionChildCount >= 0

@borrows
fn parserReceiptArenaI32(tree: parser.ParserValueExprTree,
                         column: arenamod.ArenaArrayInt32,
                         index: int32): int32 =
    return arenamod.ArenaArrayInt32Get(tree.arena, column, index)

@borrows
fn parserReceiptFixed32CopyInto(out: var layout.FixedBytes32,
                                value: layout.FixedBytes32) =
    for byteIndex in 0..<layout.FixedBytes32Size:
        out.data[byteIndex] = value.data[byteIndex]

@borrows
fn parserReceiptSourceRaw32(tree: parser.ParserValueExprTree,
                            sourceTextId: int32,
                            cachedIds: var int32[],
                            cachedRaw32s: var layout.FixedBytes32[]): layout.FixedBytes32 =
    for index in 0..<cachedIds.len:
        if cachedIds[index] == sourceTextId:
            var cachedResult: layout.FixedBytes32
            parserReceiptFixed32CopyInto(cachedResult,
                                         cachedRaw32s[index])
            return cachedResult
    let sourceText = parser.ParserValueExprSourceText(tree, sourceTextId)
    let raw32 = parserReceiptTextRaw32(sourceText)
    var cachedRaw32: layout.FixedBytes32
    parserReceiptFixed32CopyInto(cachedRaw32, raw32)
    add(cachedIds, sourceTextId)
    add(cachedRaw32s, cachedRaw32)
    return raw32

@borrows
fn parserCanonicalSpanLess(left: ParserCanonicalSpanCandidate,
                           right: ParserCanonicalSpanCandidate): bool =
    if left.startByte != right.startByte:
        return left.startByte < right.startByte
    return left.endByte < right.endByte

@borrows
fn parserCanonicalSpanEqual(left: ParserCanonicalSpanCandidate,
                            right: ParserCanonicalSpanCandidate): bool =
    return left.startByte == right.startByte &&
           left.endByte == right.endByte

fn parserCanonicalSpanHeapSiftDown(values: var ParserCanonicalSpanCandidate[],
                                   start: int32,
                                   count: int32) =
    var root = start
    while true:
        let leftChild = root * 2 + 1
        if leftChild >= count:
            return
        var selected = leftChild
        if leftChild + 1 < count &&
           parserCanonicalSpanLess(values[leftChild], values[leftChild + 1]):
            selected = leftChild + 1
        if !parserCanonicalSpanLess(values[root], values[selected]):
            return
        let swap = values[root]
        values[root] = values[selected]
        values[selected] = swap
        root = selected

fn parserCanonicalSpanSort(values: var ParserCanonicalSpanCandidate[]) =
    var start = values.len / 2
    while start > 0:
        start = start - 1
        parserCanonicalSpanHeapSiftDown(values, start, values.len)
    var stop = values.len
    while stop > 1:
        stop = stop - 1
        let swap = values[0]
        values[0] = values[stop]
        values[stop] = swap
        parserCanonicalSpanHeapSiftDown(values, 0, stop)

fn parserCanonicalSpanCandidateAdd(values: var ParserCanonicalSpanCandidate[],
                                   startByte: int32,
                                   endByte: int32,
                                   sourceLength: int32,
                                   err: var str): bool =
    let exactEmptySource =
        sourceLength == 0 && startByte == 0 && endByte == 0
    if startByte < 0 || endByte < startByte || endByte > sourceLength ||
       (endByte == startByte && !exactEmptySource):
        err = " compiler parser receipt: canonical span is invalid"
        return false
    var row: ParserCanonicalSpanCandidate
    row.startByte = startByte
    row.endByte = endByte
    add(values, row)
    return true

@borrows
fn parserCanonicalSourceSpanCandidateAdd(
        values: var ParserCanonicalSpanCandidate[],
        coordinateMap: parser.ParserSourceRewriteCoordinateMap,
        sourceText: str,
        parserInputText: str,
        parserStartByte: int32,
        parserEndByte: int32,
        err: var str): bool =
    if sourceText.len == 0 && parserInputText.len == 0 &&
       parserStartByte == 0 && parserEndByte == 0:
        return parserCanonicalSpanCandidateAdd(
            values, 0, 0, 0, err)
    var sourceStartByte: int32
    var sourceEndByte: int32
    if !parser.ParserSourceRewriteSpanToOriginalInto(
           coordinateMap,
           share(sourceText),
           share(parserInputText),
           parserStartByte,
           parserEndByte,
           sourceStartByte,
           sourceEndByte,
           err):
        return false
    return parserCanonicalSpanCandidateAdd(values,
                                           sourceStartByte,
                                           sourceEndByte,
                                           sourceText.len,
                                           err)

@borrows
fn parserCanonicalSourceSpanFind(
        spans: ParserCanonicalSpanCandidate[],
        coordinateMap: parser.ParserSourceRewriteCoordinateMap,
        sourceText: str,
        parserInputText: str,
        parserStartByte: int32,
        parserEndByte: int32,
        err: var str): int32 =
    if sourceText.len == 0 && parserInputText.len == 0 &&
       parserStartByte == 0 && parserEndByte == 0:
        return parserCanonicalSpanFind(spans, 0, 0)
    var sourceStartByte: int32
    var sourceEndByte: int32
    if !parser.ParserSourceRewriteSpanToOriginalInto(
           coordinateMap,
           share(sourceText),
           share(parserInputText),
           parserStartByte,
           parserEndByte,
           sourceStartByte,
           sourceEndByte,
           err):
        return -1
    return parserCanonicalSpanFind(spans, sourceStartByte, sourceEndByte)

@borrows
fn parserCanonicalLineStarts(text: str): int32[] =
    var out: int32[]
    add(out, 0)
    for index in 0..<text.len:
        if text[index] == '\n':
            add(out, index + 1)
    return out

@borrows
fn parserCanonicalPosition(lineStarts: int32[],
                           textLength: int32,
                           byteOffset: int32,
                           lineOut: var int32,
                           columnOut: var int32): bool =
    if lineStarts.len <= 0 || byteOffset < 0 || byteOffset > textLength:
        return false
    var low: int32
    var high = lineStarts.len
    while low < high:
        let middle = low + (high - low) / 2
        if lineStarts[middle] <= byteOffset:
            low = middle + 1
        else:
            high = middle
    let line = low - 1
    if line < 0:
        return false
    lineOut = line
    columnOut = byteOffset - lineStarts[line]
    return true

@borrows
fn parserCanonicalSpanFind(spans: ParserCanonicalSpanCandidate[],
                           startByte: int32,
                           endByte: int32): int32 =
    var low: int32
    var high = spans.len
    while low < high:
        let middle = low + (high - low) / 2
        var probe: ParserCanonicalSpanCandidate
        probe.startByte = startByte
        probe.endByte = endByte
        if parserCanonicalSpanLess(spans[middle], probe):
            low = middle + 1
        else:
            high = middle
    if low < spans.len && spans[low].startByte == startByte &&
       spans[low].endByte == endByte:
        return low
    return -1

@borrows
fn parserDeclarationPathCid(
        declarationOrdinal: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    parserReceiptAppendText(buf, ParserDeclarationPathDomain)
    parserReceiptAppendI32(buf, 1)
    parserReceiptAppendI32(buf, ParserDeclarationKindFunction)
    parserReceiptAppendI32(buf, declarationOrdinal)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserFunctionNameProofCid(
        surfaceKind: int32,
        canonicalName: str): layout.FixedBytes32 =
    let capacity = parserReceiptCheckedCapacityAdd(
        128,
        canonicalName.len,
        "compiler parser receipt: function name proof capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    parserReceiptAppendText(buf, ParserFunctionNameProofDomain)
    parserReceiptAppendI32(buf, ParserDeclarationKindFunction)
    parserReceiptAppendI32(buf, surfaceKind)
    parserReceiptAppendText(buf, canonicalName)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserFunctionNameSurfaceProofInto(
        sidecar: ParserCanonicalSourceSidecar,
        nameSpanId: int32,
        canonicalName: str,
        surfaceKind: var int32,
        proofCid: var layout.FixedBytes32,
        err: var str): bool =
    if canonicalName == "" ||
       nameSpanId < 0 || nameSpanId >= sidecar.spanStartBytes.len ||
       sidecar.tokenKinds.len != sidecar.tokenSpanIds.len ||
       sidecar.tokenKinds.len != sidecar.tokenValues.len:
        err = " compiler parser receipt: function name proof input invalid"
        return false
    let nameStart = sidecar.spanStartBytes[nameSpanId]
    let nameEnd = sidecar.spanEndBytes[nameSpanId]
    if nameEnd <= nameStart ||
       sidecar.spanStartLines[nameSpanId] !=
           sidecar.spanEndLines[nameSpanId]:
        err = " compiler parser receipt: function name surface is not one line"
        return false
    var firstToken: int32 = -1
    var lastToken: int32 = -1
    var tokenCount: int32
    var byteCursor = nameStart
    var nameCursor: int32
    for tokenId in 0..<sidecar.tokenKinds.len:
        let tokenSpanId = sidecar.tokenSpanIds[tokenId]
        if tokenSpanId < 0 || tokenSpanId >= sidecar.spanStartBytes.len:
            err = " compiler parser receipt: function name token span invalid"
            return false
        let tokenStart = sidecar.spanStartBytes[tokenSpanId]
        let tokenEnd = sidecar.spanEndBytes[tokenSpanId]
        if tokenStart >= nameStart && tokenEnd <= nameEnd:
            let tokenValue = sidecar.tokenValues[tokenId]
            if tokenStart != byteCursor || tokenEnd <= tokenStart ||
               tokenValue.len != tokenEnd - tokenStart ||
               nameCursor + tokenValue.len > canonicalName.len ||
               parser.ParserTextSliceFast(
                   canonicalName, nameCursor, tokenValue.len) != tokenValue:
                err = " compiler parser receipt: function name token coverage invalid"
                return false
            if firstToken < 0:
                firstToken = tokenId
            lastToken = tokenId
            tokenCount = tokenCount + 1
            byteCursor = tokenEnd
            nameCursor = nameCursor + tokenValue.len
        elif tokenStart < nameEnd && tokenEnd > nameStart:
            err = " compiler parser receipt: function name span splits token"
            return false
    if tokenCount <= 0 || byteCursor != nameEnd ||
       nameCursor != canonicalName.len:
        err = " compiler parser receipt: function name token coverage incomplete"
        return false
    var afterSurfaceToken: int32
    if tokenCount == 1 &&
       parser.ParserValueExprTokenCanName(
           parser.ParserValueTokenKind(sidecar.tokenKinds[firstToken])):
        if firstToken <= 0 ||
           sidecar.tokenKinds[firstToken - 1] !=
               Int32(parser.ParserValueTokenFn):
            err = " compiler parser receipt: identifier function owner missing"
            return false
        var identifierErr: str
        if !ParserRenameIdentifierStrictValidateInto(
               canonicalName, identifierErr):
            err = " compiler parser receipt: identifier function name invalid"
            return false
        surfaceKind = ParserFunctionNameSurfaceIdentifier
        afterSurfaceToken = lastToken + 1
    else:
        let openBacktick = firstToken - 1
        let closeBacktick = lastToken + 1
        if openBacktick <= 0 ||
           closeBacktick >= sidecar.tokenKinds.len ||
           sidecar.tokenKinds[openBacktick - 1] !=
               Int32(parser.ParserValueTokenFn) ||
           sidecar.tokenKinds[openBacktick] !=
               Int32(parser.ParserValueTokenBacktick) ||
           sidecar.tokenKinds[closeBacktick] !=
               Int32(parser.ParserValueTokenBacktick) ||
           sidecar.tokenValues[openBacktick] != "`" ||
           sidecar.tokenValues[closeBacktick] != "`" ||
           sidecar.spanEndBytes[sidecar.tokenSpanIds[openBacktick]] !=
               nameStart ||
           sidecar.spanStartBytes[sidecar.tokenSpanIds[closeBacktick]] !=
               nameEnd:
            err = " compiler parser receipt: backtick function delimiter proof invalid"
            return false
        for tokenId in firstToken..<closeBacktick:
            if sidecar.tokenKinds[tokenId] ==
                   Int32(parser.ParserValueTokenBacktick):
                err = " compiler parser receipt: embedded function backtick"
                return false
        surfaceKind = ParserFunctionNameSurfaceBacktick
        afterSurfaceToken = closeBacktick + 1
    if afterSurfaceToken >= sidecar.tokenKinds.len ||
       (sidecar.tokenKinds[afterSurfaceToken] !=
            Int32(parser.ParserValueTokenLeftBracket) &&
        sidecar.tokenKinds[afterSurfaceToken] !=
            Int32(parser.ParserValueTokenLeftParen)):
        err = " compiler parser receipt: function name grammar successor invalid"
        return false
    proofCid = parserFunctionNameProofCid(surfaceKind, canonicalName)
    err = ""
    return true

@borrows
fn parserDeclarationHeaderCidInto(
        sidecar: ParserCanonicalSourceSidecar,
        headerSpanId: int32,
        nameSpanId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    if headerSpanId < 0 || headerSpanId >= sidecar.spanStartBytes.len ||
       nameSpanId < 0 || nameSpanId >= sidecar.spanStartBytes.len:
        err = " compiler parser receipt: declaration header span missing"
        return false
    let headerStart = sidecar.spanStartBytes[headerSpanId]
    let headerEnd = sidecar.spanEndBytes[headerSpanId]
    var tokenCount: int32
    var nameTokenCount: int32
    let nameStart = sidecar.spanStartBytes[nameSpanId]
    let nameEnd = sidecar.spanEndBytes[nameSpanId]
    var nameCursor = nameStart
    for tokenId in 0..<sidecar.tokenKinds.len:
        let tokenSpanId = sidecar.tokenSpanIds[tokenId]
        if tokenSpanId < 0 || tokenSpanId >= sidecar.spanStartBytes.len:
            err = " compiler parser receipt: declaration header token span invalid"
            return false
        let tokenStart = sidecar.spanStartBytes[tokenSpanId]
        let tokenEnd = sidecar.spanEndBytes[tokenSpanId]
        if tokenStart >= headerStart && tokenEnd <= headerEnd:
            tokenCount = tokenCount + 1
            if tokenStart >= nameStart && tokenEnd <= nameEnd:
                if tokenStart != nameCursor:
                    err = " compiler parser receipt: declaration name token gap"
                    return false
                nameTokenCount = nameTokenCount + 1
                nameCursor = tokenEnd
            elif tokenStart < nameEnd && tokenEnd > nameStart:
                err = " compiler parser receipt: declaration name splits token"
                return false
        elif tokenStart < headerEnd && tokenEnd > headerStart:
            err = " compiler parser receipt: declaration header splits token"
            return false
    if tokenCount <= 0 || nameTokenCount <= 0 || nameCursor != nameEnd:
        err = " compiler parser receipt: declaration header token coverage invalid"
        return false
    let tokenBytes = parserReceiptCheckedCapacityMul(
        tokenCount,
        24,
        "compiler parser receipt: declaration header capacity overflow")
    let capacity = parserReceiptCheckedCapacityAdd(
        128,
        tokenBytes,
        "compiler parser receipt: declaration header capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    parserReceiptAppendText(buf, ParserDeclarationHeaderDomain)
    parserReceiptAppendI32(buf, ParserDeclarationKindFunction)
    parserReceiptAppendI32(buf, tokenCount)
    for tokenId in 0..<sidecar.tokenKinds.len:
        let tokenSpanId = sidecar.tokenSpanIds[tokenId]
        let tokenStart = sidecar.spanStartBytes[tokenSpanId]
        let tokenEnd = sidecar.spanEndBytes[tokenSpanId]
        if tokenStart >= headerStart && tokenEnd <= headerEnd:
            parserReceiptAppendI32(buf, sidecar.tokenKinds[tokenId])
            parserReceiptAppendText(buf, sidecar.tokenValues[tokenId])
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn parserFfiHandleContractCid(
        sidecar: ParserCanonicalSourceSidecar,
        contractRow: int32): layout.FixedBytes32 =
    if contractRow < 0 ||
       contractRow >= sidecar.ffiHandleContractParameterStarts.len ||
       contractRow >= sidecar.ffiHandleContractParameterCounts.len ||
       contractRow >=
           sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows.len ||
       contractRow >=
           sidecar.ffiHandleContractAnnotationSourceLocalRows.len ||
       contractRow >= sidecar.ffiHandleContractUnwindKinds.len ||
       contractRow >= sidecar.ffiHandleContractResultEffects.len:
        return layout.FixedBytes32()
    let parameterStart =
        sidecar.ffiHandleContractParameterStarts[contractRow]
    let parameterCount =
        sidecar.ffiHandleContractParameterCounts[contractRow]
    if parameterStart < 0 || parameterCount < 0 ||
       parameterStart >
           sidecar.ffiHandleParameterOrdinals.len - parameterCount:
        return layout.FixedBytes32()
    let capacity = parserReceiptCheckedCapacityAdd(
        192,
        parserReceiptCheckedCapacityMul(
            parameterCount,
            12,
            "compiler parser receipt: ffi handle cid capacity overflow"),
        "compiler parser receipt: ffi handle cid capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    parserReceiptAppendText(buf, ParserFfiHandleContractDomain)
    parserReceiptAppendFixed32(buf, sidecar.sourceContentRaw32)
    parserReceiptAppendI32(
        buf,
        sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows[
            contractRow])
    parserReceiptAppendI32(
        buf,
        sidecar.ffiHandleContractAnnotationSourceLocalRows[contractRow])
    parserReceiptAppendI32(
        buf, sidecar.ffiHandleContractUnwindKinds[contractRow])
    parserReceiptAppendI32(
        buf, sidecar.ffiHandleContractResultEffects[contractRow])
    parserReceiptAppendI32(buf, parameterCount)
    for offset in 0..<parameterCount:
        let effectRow = parameterStart + offset
        parserReceiptAppendI32(
            buf, sidecar.ffiHandleParameterOrdinals[effectRow])
        parserReceiptAppendI32(
            buf,
            sidecar.ffiHandleParameterDeclarationSourceLocalRows[effectRow])
        parserReceiptAppendI32(
            buf, sidecar.ffiHandleParameterEffects[effectRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserCanonicalSourceSidecarHash(
        sidecar: ParserCanonicalSourceSidecar): layout.FixedBytes32 =
    let importOrigins = sidecar.importOrigins
    var buf = layout.ByteBufInit(4096)
    parserReceiptAppendText(buf, ParserCanonicalSourceSidecarDomain)
    parserReceiptAppendI32(buf, sidecar.sourceIndex)
    parserReceiptAppendFixed32(buf, sidecar.sourceContentRaw32)
    parserReceiptAppendFixed32(buf, sidecar.parserInputRaw32)
    parserReceiptAppendI32(buf, sidecar.spanStartBytes.len)
    for row in 0..<sidecar.spanStartBytes.len:
        parserReceiptAppendI32(buf, sidecar.spanStartBytes[row])
        parserReceiptAppendI32(buf, sidecar.spanEndBytes[row])
        parserReceiptAppendI32(buf, sidecar.spanStartLines[row])
        parserReceiptAppendI32(buf, sidecar.spanStartColumns[row])
        parserReceiptAppendI32(buf, sidecar.spanEndLines[row])
        parserReceiptAppendI32(buf, sidecar.spanEndColumns[row])
    parserReceiptAppendI32(buf, sidecar.nodeKinds.len)
    for row in 0..<sidecar.nodeKinds.len:
        parserReceiptAppendI32(buf, sidecar.nodeProducerIds[row])
        parserReceiptAppendI32(buf, sidecar.nodeParentIds[row])
        parserReceiptAppendI32(buf, sidecar.nodeKinds[row])
        parserReceiptAppendI32(buf, sidecar.nodeSpanIds[row])
        parserReceiptAppendI32(buf, sidecar.nodeChildStarts[row])
        parserReceiptAppendI32(buf, sidecar.nodeChildCounts[row])
        parserReceiptAppendI32(buf, sidecar.nodeGenericStarts[row])
        parserReceiptAppendI32(buf, sidecar.nodeGenericCounts[row])
        parserReceiptAppendI32(
            buf, sidecar.nodeBindingResolutionKinds[row])
        parserReceiptAppendI32(
            buf, sidecar.nodeBindingDeclarationSourceLocalRows[row])
        parserReceiptAppendI32(
            buf, sidecar.nodeBindingPatternSourceLocalRows[row])
    parserReceiptAppendI32(buf, sidecar.nodeChildIds.len)
    for row in 0..<sidecar.nodeChildIds.len:
        parserReceiptAppendI32(buf, sidecar.nodeChildIds[row])
    parserReceiptAppendI32(buf, sidecar.tokenKinds.len)
    for row in 0..<sidecar.tokenKinds.len:
        parserReceiptAppendI32(
            buf, sidecar.tokenProducerSourceIds[row])
        parserReceiptAppendI32(buf, sidecar.tokenSourceLocalRows[row])
        parserReceiptAppendI32(buf, sidecar.tokenLexicalParentIds[row])
        parserReceiptAppendI32(buf, sidecar.tokenKinds[row])
        parserReceiptAppendI32(buf, sidecar.tokenSpanIds[row])
        parserReceiptAppendText(buf, sidecar.tokenValues[row])
    parserReceiptAppendI32(
        buf, importOrigins.importDeclarationSourceLocalRows.len)
    for row in 0..<importOrigins.importDeclarationSourceLocalRows.len:
