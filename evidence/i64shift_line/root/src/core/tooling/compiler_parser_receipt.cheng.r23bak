        add(out.typeGenericSymbolConstraintTypeSyntaxIds,
            source.typeGenericSymbolConstraintTypeSyntaxIds[row])
        add(out.typeGenericSymbolDefaultTypeSyntaxIds,
            source.typeGenericSymbolDefaultTypeSyntaxIds[row])
        add(out.typeGenericSymbolChildStarts,
            source.typeGenericSymbolChildStarts[row])
        add(out.typeGenericSymbolChildCounts,
            source.typeGenericSymbolChildCounts[row])
    for row in 0..<source.typeGenericSymbolChildTypeSyntaxIds.len:
        add(out.typeGenericSymbolChildTypeSyntaxIds,
            source.typeGenericSymbolChildTypeSyntaxIds[row])
    for row in 0..<source.typeEnumVariantNameTokenIds.len:
        add(out.typeEnumVariantProducerSourceIds,
            source.typeEnumVariantProducerSourceIds[row])
        add(out.typeEnumVariantDeclarationOwnerIds,
            source.typeEnumVariantDeclarationOwnerIds[row])
        add(out.typeEnumVariantDeclarationOwnerTokenIds,
