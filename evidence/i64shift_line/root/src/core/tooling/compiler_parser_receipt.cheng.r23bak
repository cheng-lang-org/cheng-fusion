       tree.annotationArgSourceLocalRows.len != tree.annotationArgCount ||
       tree.annotationArgOwnerRows.len != tree.annotationArgCount ||
       tree.annotationArgKinds.len != tree.annotationArgCount ||
       tree.annotationArgTokenIndexes.len != tree.annotationArgCount ||
       tree.annotationArgSeparatorTokenIndexes.len !=
           tree.annotationArgCount ||
       tree.annotationArgSpanStarts.len != tree.annotationArgCount ||
       tree.annotationArgSpanEnds.len != tree.annotationArgCount ||
       tree.annotationArgChildStarts.len != tree.annotationArgCount ||
       tree.annotationArgChildCounts.len != tree.annotationArgCount ||
       tree.annotationArgChildNodeIndexes.len !=
           tree.annotationArgChildCount ||
       tree.forwardingProductionProducerSourceIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSourceLocalRows.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionKinds.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionArmIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionOwnerRows.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAnchorTokenIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanStartTokenIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanEndTokenIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanStarts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanEnds.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAuthorityKinds.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAuthorityRows.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAnnotationStarts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAnnotationCounts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionChildStarts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionChildCounts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionChildKinds.len !=
           tree.forwardingProductionChildCount ||
       tree.forwardingProductionChildRows.len !=
           tree.forwardingProductionChildCount ||
       tree.rootNodeIndexes.len != tree.rootCount ||
       tree.callEventNodeIndexes.len != tree.callEventCount ||
       tree.statementRootNodeIndexes.len != tree.statementRootCount ||
       tree.statementRootRoles.len != tree.statementRootCount ||
       tree.statementRootAnchorTokenIndexes.len != tree.statementRootCount ||
       tree.statementRootBindingDeclarationStarts.len !=
           tree.statementRootCount ||
       tree.statementRootBindingDeclarationCounts.len !=
           tree.statementRootCount ||
       tree.statementRootAnchorLineNumbers.len != tree.statementRootCount ||
       tree.statementRootAnchorColumnNumbers.len != tree.statementRootCount ||
       tree.statementRootEndLineNumbers.len != tree.statementRootCount ||
       tree.statementRootEndColumnNumbers.len != tree.statementRootCount ||
       tree.tokenKinds.len != tree.tokenCount ||
       tree.tokenSourceTextIds.len != tree.tokenCount ||
       tree.tokenProducerSourceIndexes.len != tree.tokenCount ||
       tree.tokenSourceLocalIndexes.len != tree.tokenCount ||
       tree.tokenLexicalParentIndexes.len != tree.tokenCount ||
       tree.tokenStarts.len != tree.tokenCount ||
       tree.tokenEnds.len != tree.tokenCount ||
       tree.tokenLineNumbers.len != tree.tokenCount ||
       tree.tokenColumnNumbers.len != tree.tokenCount:
