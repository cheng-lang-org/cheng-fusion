    for row in 0..<sourceImportOrigins.importModuleTokenIds.len:
        add(outImportOrigins.importModuleTokenIds,
            sourceImportOrigins.importModuleTokenIds[row])
    for row in 0..<source.genericSpanIds.len:
        add(out.genericSpanIds, source.genericSpanIds[row])
    for row in 0..<source.regionKinds.len:
        add(out.regionKinds, source.regionKinds[row])
        add(out.regionSpanIds, source.regionSpanIds[row])
        add(out.regionAnchorTokenIds, source.regionAnchorTokenIds[row])
    for row in 0..<source.typeSyntaxKinds.len:
        add(out.typeSyntaxSourceIds, source.typeSyntaxSourceIds[row])
