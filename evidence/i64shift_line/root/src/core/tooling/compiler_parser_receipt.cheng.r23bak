const
    ParserNormalizedExprArtifactDomain: str = "cheng.compiler.parser_normalized_expr_artifact"
    ParserNormalizedExprAggregateDomain: str = "cheng.compiler.parser_normalized_expr_aggregate"
    ParserNormalizedExprProducerIdentity: str = "compiler_parser_normalized_expr"
    ParserCanonicalSourceSidecarDomain: str = "cheng.compiler.parser_canonical_source"
    ParserFfiHandleContractDomain: str = "cheng.compiler.parser_ffi_handle_contract"
    ParserDiagnosticCompletionDomain: str = "cheng.compiler.parser_diagnostic_completion"
    ParserDeclarationHeaderDomain: str = "cheng.compiler.parser_declaration_header"
    ParserDeclarationPathDomain: str = "cheng.compiler.parser_declaration_path"
    ParserFunctionNameProofDomain: str = "cheng.compiler.function_name_proof"
    ParserDeclarationKindFunction: int32 = 1
    ParserFunctionNameSurfaceIdentifier: int32 = 1
    ParserFunctionNameSurfaceBacktick: int32 = 2
    ParserDiagnosticSeverityError: int32 = 1
    ParserDiagnosticSeverityWarning: int32 = 2
    ParserDiagnosticSeverityInformation: int32 = 3
    ParserDiagnosticSeverityHint: int32 = 4
    ParserDiagnosticAnchorSpan: int32 = 1
    ParserDiagnosticAnchorParserNode: int32 = 2
    ParserDiagnosticAnchorOwnerDeclaration: int32 = 3
    ParserDiagnosticAnchorParserNodeOwnerDeclaration: int32 = 4

type
    # Exact declaration identity.  Dense indexes are never used alone: the
    # canonical source/module/name/line tuple is committed beside each index.
    ParserNormalizedExprFunctionIdentity =
        sourceIndex: int32
        functionIndex: int32
        sourcePath: str
        ownerModulePath: str
        functionName: str
        signatureLineNumber: int32
        endLineNumber: int32

    # Semantic row counts only.  Capacity, addresses, timing, parser lifecycle
    # counters and lookup-cache telemetry are deliberately outside the schema.
    ParserNormalizedExprArtifactCounts =
        exprCount: int64
        scopeCount: int64
        nodeCount: int64
        genericCount: int64
        rootCount: int64
        tokenCount: int64
        callEventCount: int64
        statementRootCount: int64
        typeSyntaxCount: int64
        typeSyntaxChildCount: int64
        typeSyntaxBracketArgCount: int64
        typeConstExprCount: int64
        typeEnumVariantCount: int64
        declarationCount: int64
        patternCount: int64
        patternChildCount: int64
        annotationCount: int64
        annotationArgCount: int64
        annotationArgRootCount: int64
        annotationArgChildCount: int64
        questionResidualCount: int64

    ParserNormalizedExprFunctionArtifact =
        identity: ParserNormalizedExprFunctionIdentity
        artifactRaw32: layout.FixedBytes32
        counts: ParserNormalizedExprArtifactCounts

    ParserCanonicalImportOriginSoA = ref object
        importDeclarationProducerSourceIds: int32[]
        importDeclarationSourceLocalRows: int32[]
        importDeclarationKeywordTokenIds: int32[]
        importDeclarationSpanIds: int32[]
        importDeclarationItemStarts: int32[]
        importDeclarationItemCounts: int32[]
        importItemProducerSourceIds: int32[]
        importItemSourceLocalRows: int32[]
        importItemDeclarationIds: int32[]
        importItemAliasTokenIds: int32[]
        importItemSpanIds: int32[]
        importItemModuleTokenStarts: int32[]
        importItemModuleTokenCounts: int32[]
        importItemPrefixTokenCounts: int32[]
        importModuleTokenIds: int32[]

    # Compact immutable projection of one exact full-source ParserValueExprTree.
    # Parser node ids are remapped from producer postorder to canonical preorder;
    # every other identity is an int32 row in this owner.  No source text or
    # parser arena is retained after projection.
    ParserCanonicalSourceSidecar = ref object
        sourceIndex: int32
        sourceContentRaw32: layout.FixedBytes32
        parserInputRaw32: layout.FixedBytes32
        # Produced at the parser sidecar seal point. Snapshot builders may
        # replay/copy this receipt, but may not derive a replacement.
        diagnosticRowStart: int32
        diagnosticRowCount: int32
        diagnosticCompletionRaw32: layout.FixedBytes32
        # Parser-owned diagnostic rows. Source identity is implicit in this
        # sidecar; all identities are exact source-local int32 rows.
        diagnosticAnchorKinds: int32[]
        diagnosticAnchorNodeIds: int32[]
        diagnosticOwnerDeclarationSourceLocalRows: int32[]
        diagnosticSpanIds: int32[]
        diagnosticSeverities: int32[]
        diagnosticCodeTexts: str[]
        diagnosticMessageTexts: str[]
        diagnosticProofRaw32s: layout.FixedBytes32[]
        spanStartBytes: int32[]
        spanEndBytes: int32[]
        spanStartLines: int32[]
        spanStartColumns: int32[]
        spanEndLines: int32[]
        spanEndColumns: int32[]
        # Producer ParserValueExprTree node id for each canonical preorder row.
        # This is a bijection used only to bind TypedIR origins exactly.
        nodeProducerIds: int32[]
        nodeParentIds: int32[]
        nodeKinds: int32[]
        nodeSpanIds: int32[]
        nodeChildStarts: int32[]
        nodeChildCounts: int32[]
        nodeChildIds: int32[]
        nodeGenericStarts: int32[]
        nodeGenericCounts: int32[]
        # Exact parser-authored lexical binding edge for each canonical node.
        # Declaration/Pattern identities are source-local rows in this
        # sidecar; unresolved and non-Identifier nodes keep all sentinels.
        nodeBindingResolutionKinds: int32[]
        nodeBindingDeclarationSourceLocalRows: int32[]
        nodeBindingPatternSourceLocalRows: int32[]
        tokenProducerSourceIds: int32[]
        tokenSourceLocalRows: int32[]
        tokenLexicalParentIds: int32[]
        tokenKinds: int32[]
        tokenSpanIds: int32[]
        tokenValues: str[]
        genericSpanIds: int32[]
        regionKinds: int32[]
        regionSpanIds: int32[]
        regionAnchorTokenIds: int32[]
        # Parser-owned TypeSyntax postorder.  Row index is the exact producer
        # TypeSyntaxId; all names/owners reference canonical token rows and all
        # composition is carried by the child CSR, never by token text.
        typeSyntaxSourceIds: int32[]
        typeSyntaxProducerSourceIds: int32[]
        typeSyntaxSourceLocalRows: int32[]
        typeSyntaxKinds: int32[]
        typeSyntaxSpanIds: int32[]
        typeSyntaxOwnerTokenIds: int32[]
        typeSyntaxDeclarationOwnerTokenIds: int32[]
        typeSyntaxDeclarationOwnerIds: int32[]
        typeSyntaxGenericSymbolStarts: int32[]
        typeSyntaxGenericSymbolCounts: int32[]
        typeSyntaxChildStarts: int32[]
        typeSyntaxChildCounts: int32[]
        typeSyntaxChildIds: int32[]
        typeSyntaxBracketArgStarts: int32[]
        typeSyntaxBracketArgCounts: int32[]
        typeSyntaxBracketArgTokenStarts: int32[]
        typeSyntaxBracketArgTokenCounts: int32[]
        typeSyntaxBracketArgTypeIds: int32[]
        typeSyntaxBracketArgConstExprRootIds: int32[]
        typeConstExprKinds: int32[]
        typeConstExprProducerSourceIds: int32[]
        typeConstExprSourceTextIds: int32[]
        typeConstExprTokenIds: int32[]
        typeConstExprLeftChildIds: int32[]
        typeConstExprRightChildIds: int32[]
        typeConstExprIntegerValues: int32[]
        typeConstExprIdentityCids: layout.FixedBytes32[]
        typeSyntaxNameTokenIds: int32[]
        typeSyntaxFixedLengths: int32[]
        typeSyntaxQuestionTokenIds: int32[]
        typeSyntaxRootKinds: int32[]
        typeSyntaxEnumVariantStarts: int32[]
        typeSyntaxEnumVariantCounts: int32[]
        typeEnumVariantProducerSourceIds: int32[]
        typeEnumVariantDeclarationOwnerIds: int32[]
        typeEnumVariantDeclarationOwnerTokenIds: int32[]
        typeEnumVariantNameTokenIds: int32[]
        typeEnumVariantOrdinals: int32[]
        typeEnumVariantPayloadTypeSyntaxIds: int32[]
        typeGenericSymbolProducerSourceIds: int32[]
        typeGenericSymbolDeclarationOwnerTokenIds: int32[]
        typeGenericSymbolNameTokenIds: int32[]
        typeGenericSymbolOrdinals: int32[]
        typeGenericSymbolSpanIds: int32[]
        typeGenericSymbolOwnerDeclarationIds: int32[]
        typeGenericSymbolOwnerTypeSyntaxIds: int32[]
        typeGenericSymbolConstraintTypeSyntaxIds: int32[]
        typeGenericSymbolDefaultTypeSyntaxIds: int32[]
        typeGenericSymbolChildStarts: int32[]
        typeGenericSymbolChildCounts: int32[]
        typeGenericSymbolChildTypeSyntaxIds: int32[]
        # Parser-produced canonical declaration rows.  All relationship
        # columns are structural row domains; spans remain diagnostic payload.
        declarationProducerSourceIds: int32[]
        declarationSourceLocalRows: int32[]
        declarationKinds: int32[]
        declarationNameTokenIds: int32[]
        declarationOwnerIds: int32[]
        declarationLexicalScopeIds: int32[]
        declarationFunctionRows: int32[]
        declarationTypeSyntaxRootIds: int32[]
        declarationDefaultStatementRootRows: int32[]
        declarationGenericSymbolStarts: int32[]
        declarationGenericSymbolCounts: int32[]
        declarationSuiteLexicalScopeIds: int32[]
        declarationSpanIds: int32[]
        declarationNameSpanIds: int32[]
        declarationMutableFlags: bool[]
        declarationExportedFlags: bool[]
        declarationLexicalScopeProducerSourceIds: int32[]
        declarationLexicalScopeSourceLocalRows: int32[]
        declarationLexicalScopeKinds: int32[]
        declarationLexicalScopeParentIds: int32[]
        declarationLexicalScopeOwnerDeclarationIds: int32[]
        declarationLexicalScopeSpanIds: int32[]
        patternProducerSourceIds: int32[]
        patternSourceLocalRows: int32[]
        patternKinds: int32[]
        patternNameTokenIds: int32[]
        patternOwnerLexicalScopeIds: int32[]
        patternOwnerKinds: int32[]
        patternOwnerRows: int32[]
        patternBindingDeclarationIds: int32[]
        patternTypeSyntaxRootIds: int32[]
        patternSpanIds: int32[]
        patternChildStarts: int32[]
        patternChildCounts: int32[]
        patternChildIds: int32[]
        annotationProducerSourceIds: int32[]
        annotationSourceLocalRows: int32[]
        annotationNameTokenIds: int32[]
        annotationTargetTokenIds: int32[]
        annotationSpanIds: int32[]
        annotationArgRootStarts: int32[]
        annotationArgRootCounts: int32[]
        annotationArgRootIds: int32[]
        annotationArgProducerSourceIds: int32[]
        annotationArgSourceLocalRows: int32[]
        annotationArgOwnerIds: int32[]
        annotationArgKinds: int32[]
        annotationArgTokenIds: int32[]
        annotationArgSeparatorTokenIds: int32[]
        annotationArgSpanIds: int32[]
        annotationArgChildStarts: int32[]
        annotationArgChildCounts: int32[]
        annotationArgChildIds: int32[]
        rootNodeIds: int32[]
        callEventNodeIds: int32[]
        statementRootNodeIds: int32[]
        statementRootRoles: int32[]
        statementRootAnchorTokenIds: int32[]
        statementRootBindingDeclarationStarts: int32[]
        statementRootBindingDeclarationCounts: int32[]
        statementRootAnchorLines: int32[]
        statementRootAnchorColumns: int32[]
        statementRootEndLines: int32[]
        statementRootEndColumns: int32[]
        # One row per produced normalized expression.  The parser node is the
        # exact source-local producer row recorded on NormalizedExpr itself;
        # later stages must not reconstruct it from source text or lines.
        normalizedExprProducerSourceIds: int32[]
        normalizedExprSourceLocalRows: int32[]
        normalizedExprFunctionIndexes: int32[]
        normalizedExprParserNodeIds: int32[]
        normalizedExprKinds: int32[]
        normalizedExprStatementRoles: int32[]
        functionIndexes: int32[]
        functionNames: str[]
        functionSignatureLineNumbers: int32[]
        functionDeclarationSpanIds: int32[]
        functionDeclarationHeaderSpanIds: int32[]
        functionDeclarationOrdinals: int32[]
        functionDeclarationHeaderCids: layout.FixedBytes32[]
        functionDeclarationPathCids: layout.FixedBytes32[]
        functionNameSpanIds: int32[]
        functionNameSurfaceKinds: int32[]
        functionNameProofCids: layout.FixedBytes32[]
        functionBodySpanIds: int32[]
        functionAnnotationFlags: int32[]
        # Exact @manual_consume semantic relation. Presence is represented
        # only by ParserFunctionAnnotationManualConsume in annotationFlags;
        # absent rows carry four -1 sentinels.
        functionManualConsumeTargetParameterOrdinals: int32[]
        functionManualConsumeTargetParameterDeclarationSourceLocalRows: int32[]
        functionManualConsumeSourceParameterOrdinals: int32[]
        functionManualConsumeSourceParameterDeclarationSourceLocalRows: int32[]
        # Exact parser-owned @ffi_handle contract projection. Contract rows are
        # canonical by function declaration source-local row; effect rows are a
        # dense ordinal CSR. No aggregate parser row or source span is retained.
        ffiHandleContractProducerSourceIds: int32[]
        ffiHandleContractFunctionDeclarationSourceLocalRows: int32[]
        ffiHandleContractAnnotationSourceLocalRows: int32[]
        ffiHandleContractUnwindKinds: int32[]
        ffiHandleContractResultEffects: int32[]
        ffiHandleContractParameterStarts: int32[]
        ffiHandleContractParameterCounts: int32[]
        ffiHandleParserContractCids: layout.FixedBytes32[]
        ffiHandleParameterOrdinals: int32[]
        ffiHandleParameterDeclarationSourceLocalRows: int32[]
        ffiHandleParameterEffects: int32[]
        sidecarRaw32: layout.FixedBytes32
        # Parser-owned import syntax identity.  Declaration/item rows remain
        # source-local; module paths are committed beside the exact token CSR.
        importOrigins: ParserCanonicalImportOriginSoA

    ParserCanonicalSpanCandidate =
        startByte: int32
        endByte: int32

    ParserSpanNormalizedStatementFact =
        producerSourceIndex: int32
        sourceLocalRow: int32
        normalizedExprRow: int32
        sourceTextId: int32
        kind: int32
        anchorTokenIndex: int32
        spanStart: int32
        spanEnd: int32
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        rootNodeIndex: int32
        originNodeIndex: int32
        statementRole: int32
        lexicalScopeId: int32
        suiteScopeId: int32
        statementOrdinal: int32
        lexicalOrdinal: int32
        deferOwnerStatementOrdinal: int32
        identityRaw32: layout.FixedBytes32

    ParserSpanNormalizedScopeFact =
        producerSourceIndex: int32
        sourceLocalRow: int32
        sourceTextId: int32
        scopeId: int32
        sourceScopeId: int32
        parentScopeId: int32
        parentScopeIndex: int32
        kind: int32
        ownerStatementOrdinal: int32
        ownerStatementRow: int32
        ownerDeclarationRow: int32
        moduleRootAnchor: bool
        lexicalOrdinal: int32
        indentColumn: int32
        anchorTokenIndex: int32
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        identityRaw32: layout.FixedBytes32

    ParserSpanImportEdgeFact =
        ownerProducerSourceIndex: int32
        targetProducerSourceIndex: int32
        sourceDeclarationRaw32: layout.FixedBytes32
        targetDeclarationRaw32: layout.FixedBytes32
        importDeclarationRow: int32
        importItemRow: int32
        keywordTokenIndex: int32
        aliasTokenIndex: int32
        spanStart: int32
        spanEnd: int32
        moduleTokenIndexes: int32[]
        prefixTokenCount: int32
        ownerModulePath: str
        targetModulePath: str
        targetSourcePath: str
        targetProfileIndex: int32
        identityRaw32: layout.FixedBytes32

    ParserCanonicalFunctionSpan =
        functionIndex: int32
        functionName: str
        signatureLineNumber: int32
        declarationOrdinal: int32
        declarationStartByte: int32
        declarationEndByte: int32
        headerStartByte: int32
        headerEndByte: int32
        nameStartByte: int32
        nameEndByte: int32
        bodyStartByte: int32
        bodyEndByte: int32
        annotationFlags: int32
        manualConsumeFunctionDeclarationSourceLocalRow: int32
        manualConsumeTargetParameterOrdinal: int32
        manualConsumeTargetParameterDeclarationSourceLocalRow: int32
        manualConsumeSourceParameterOrdinal: int32
        manualConsumeSourceParameterDeclarationSourceLocalRow: int32

    ParserNormalizedExprReceiptAccumulator =
        active: bool
        predecessorRaw32: layout.FixedBytes32
        sourcePaths: str[]
        ownerModulePaths: str[]
        importEdges: parser.ImportEdge[]
        sourceSidecarPresent: bool[]
        sourceSidecars: ParserCanonicalSourceSidecar[]
        functionPresent: bool[]
        functionVerified: bool[]
        functionArtifacts: ParserNormalizedExprFunctionArtifact[]
        normalizedExprProducerSourceIds: int32[]
        normalizedExprFunctionIndexes: int32[]
        normalizedExprParserNodeIds: int32[]
        normalizedExprKinds: int32[]
        normalizedExprStatementRoles: int32[]

    ParserNormalizedExprReceipt =
        envelope: stage_receipt.CompilerStageReceipt
        aggregateBaseRaw32: layout.FixedBytes32
        canonicalParserRootRaw32: layout.FixedBytes32
        counts: ParserNormalizedExprArtifactCounts
        sourceCount: int64
        functionCount: int64
        importEdgeCount: int64
        verifiedFunctionCount: int64
        sourceSidecars: ParserCanonicalSourceSidecar[]

# Canonical compiler-owned lexical gate for rename.  This delegates both the
# identifier alphabet and the complete keyword classification to the parser;
# tooling must not carry a copied keyword list or accept a name by heuristic.
@borrows
fn ParserRenameIdentifierStrictValidateInto(
        value: str,
        err: var str): bool =
    if value.len <= 0 || !parser.ParserValueExprIsIdentStart(value[0]):
        err = " parser receipt rename: invalid identifier start"
        return false
    for index in 1..<value.len:
        if !parser.ParserValueExprIsIdentContinue(value[index]):
            err = " parser receipt rename: invalid identifier continuation"
            return false
    if !parser.ParserValueExprTokenCanName(
           parser.ParserValueExprKeywordKind(value, 0, value.len)):
        err = " parser receipt rename: reserved keyword"
        return false
    err = ""
    return true

fn parserReceiptAppendU32BE(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn parserReceiptAppendU64BE(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn parserReceiptAppendText(buf: var layout.ByteBuf, value: str) =
    parserReceiptAppendU32BE(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

fn parserReceiptAppendI32(buf: var layout.ByteBuf, value: int32) =
    parserReceiptAppendU32BE(buf, 4)
    parserReceiptAppendU32BE(buf, value)

fn parserReceiptAppendI64(buf: var layout.ByteBuf, value: int64) =
    parserReceiptAppendU32BE(buf, 8)
    parserReceiptAppendU64BE(buf, value)

fn parserReceiptAppendBool(buf: var layout.ByteBuf, value: bool) =
    parserReceiptAppendU32BE(buf, 1)
    layout.ByteBufAppendByte(buf, value ? 1 : 0)

@borrows
fn parserReceiptAppendFixed32(buf: var layout.ByteBuf,
                              value: layout.FixedBytes32) =
    parserReceiptAppendU32BE(buf, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(buf, value)

fn parserReceiptCheckedCapacityAdd(
        left: int32,
        right: int32,
        reason: str): int32 =
    if left < 0 || right < 0 || left > 2147483647 - right:
        panic(reason)
    return left + right

fn parserReceiptCheckedCapacityMul(
        left: int32,
        right: int32,
        reason: str): int32 =
    if left < 0 || right < 0 ||
       (right != 0 && left > 2147483647 / right):
        panic(reason)
    return left * right

@borrows
fn parserReceiptTextLess(left: str, right: str): bool =
    let sharedLen = left.len < right.len ? left.len : right.len
    for index in 0..<sharedLen:
        let leftByte = Int32(left[index])
        let rightByte = Int32(right[index])
        if leftByte != rightByte:
            return leftByte < rightByte
    return left.len < right.len

@borrows
fn parserReceiptTextRaw32(value: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptSourceIndex(sourcePaths: str[],
                                sourcePath: str): int32 =
    var found = -1
    for sourceIndex in 0..<sourcePaths.len:
        if sourcePaths[sourceIndex] == sourcePath:
            if found >= 0:
                return -1
            found = sourceIndex
    return found

fn parserSpanReceiptNormalizedStatementKind(
        kind: parser.NormalizedExprKind): bool =
    return kind == parser.NormalizedExprReturn ||
           kind == parser.NormalizedExprAssign ||
           kind == parser.NormalizedExprIfStmt ||
           kind == parser.NormalizedExprElifStmt ||
           kind == parser.NormalizedExprElseStmt ||
           kind == parser.NormalizedExprForStmt ||
           kind == parser.NormalizedExprMatchStmt ||
           kind == parser.NormalizedExprCaseStmt ||
           kind == parser.NormalizedExprWhileStmt ||
           kind == parser.NormalizedExprDeferStmt ||
           kind == parser.NormalizedExprBreakStmt ||
           kind == parser.NormalizedExprContinueStmt

fn parserSpanReceiptNormalizedStatementKindText(kind: int32): str =
    return "NormalizedExpr" +
        parser.NormalizedExprKindText(parser.NormalizedExprKind(kind))

fn parserSpanReceiptNormalizedScopeKindText(kind: int32): str =
    if kind == Int32(parser.NormalizedScopeRoot):
        return "NormalizedScopeRoot"
    if kind == Int32(parser.NormalizedScopeIndentedSuite):
        return "NormalizedScopeIndentedSuite"
    if kind == Int32(parser.NormalizedScopeInlineSuite):
        return "NormalizedScopeInlineSuite"
    if kind == Int32(parser.NormalizedScopeDeferSuite):
        return "NormalizedScopeDeferSuite"
    return "NormalizedScopeInvalid"

@borrows
fn parserSpanReceiptNormalizedStatementIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        fact: ParserSpanNormalizedStatementFact): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    parserReceiptAppendText(
        buf, "cheng.parser_span_receipt.normalized_statement_fact")
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, fact.producerSourceIndex)
    parserReceiptAppendI32(buf, fact.sourceLocalRow)
    parserReceiptAppendI32(buf, fact.normalizedExprRow)
    parserReceiptAppendI32(buf, fact.sourceTextId)
    parserReceiptAppendI32(buf, fact.kind)
    parserReceiptAppendI32(buf, fact.anchorTokenIndex)
    parserSpanReceiptAppendTokenIdentity(
        buf, tree, fact.anchorTokenIndex)
    parserReceiptAppendI32(buf, fact.spanStart)
    parserReceiptAppendI32(buf, fact.spanEnd)
    parserReceiptAppendI32(buf, fact.lineNumber)
    parserReceiptAppendI32(buf, fact.columnNumber)
    parserReceiptAppendI32(buf, fact.endLineNumber)
    parserReceiptAppendI32(buf, fact.endColumnNumber)
    parserReceiptAppendI32(buf, fact.rootNodeIndex)
    if fact.rootNodeIndex >= 0:
        parserReceiptAppendFixed32(
            buf,
            parserSpanReceiptNodeIdentityRaw32(
                tree, fact.rootNodeIndex))
    parserReceiptAppendI32(buf, fact.originNodeIndex)
    parserReceiptAppendI32(buf, fact.statementRole)
    parserReceiptAppendI32(buf, fact.lexicalScopeId)
    parserReceiptAppendI32(buf, fact.suiteScopeId)
    parserReceiptAppendI32(buf, fact.statementOrdinal)
    parserReceiptAppendI32(buf, fact.lexicalOrdinal)
    parserReceiptAppendI32(buf, fact.deferOwnerStatementOrdinal)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptNormalizedScopeIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        fact: ParserSpanNormalizedScopeFact): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    parserReceiptAppendText(
        buf, "cheng.parser_span_receipt.normalized_scope_fact")
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, fact.producerSourceIndex)
    parserReceiptAppendI32(buf, fact.sourceLocalRow)
    parserReceiptAppendI32(buf, fact.sourceTextId)
    parserReceiptAppendI32(buf, fact.scopeId)
    parserReceiptAppendI32(buf, fact.sourceScopeId)
    parserReceiptAppendI32(buf, fact.parentScopeId)
    parserReceiptAppendI32(buf, fact.parentScopeIndex)
    parserReceiptAppendI32(buf, fact.kind)
    parserReceiptAppendI32(buf, fact.ownerStatementOrdinal)
    parserReceiptAppendI32(buf, fact.ownerStatementRow)
    parserReceiptAppendI32(buf, fact.ownerDeclarationRow)
    parserReceiptAppendBool(buf, fact.moduleRootAnchor)
    parserReceiptAppendI32(buf, fact.lexicalOrdinal)
    parserReceiptAppendI32(buf, fact.indentColumn)
    parserReceiptAppendI32(buf, fact.anchorTokenIndex)
    parserSpanReceiptAppendTokenIdentity(
        buf, tree, fact.anchorTokenIndex)
    parserReceiptAppendI32(buf, fact.lineNumber)
    parserReceiptAppendI32(buf, fact.columnNumber)
    parserReceiptAppendI32(buf, fact.endLineNumber)
    parserReceiptAppendI32(buf, fact.endColumnNumber)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptModuleDeclarationIdentityRaw32(
        producerSourceIndex: int32,
        sourcePath: str,
        modulePath: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    parserReceiptAppendText(
        buf, "cheng.parser_span_receipt.module_declaration")
    parserReceiptAppendI32(buf, producerSourceIndex)
    parserReceiptAppendText(buf, sourcePath)
    parserReceiptAppendText(buf, modulePath)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserSpanReceiptImportEdgeIdentityRaw32(
        tree: parser.ParserValueExprTree,
        row: int32,
        fact: ParserSpanImportEdgeFact): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    parserReceiptAppendText(
        buf, "cheng.parser_span_receipt.import_edge_fact")
    parserReceiptAppendI32(buf, row)
    parserReceiptAppendI32(buf, fact.ownerProducerSourceIndex)
    parserReceiptAppendI32(buf, fact.targetProducerSourceIndex)
    parserReceiptAppendFixed32(buf, fact.sourceDeclarationRaw32)
    parserReceiptAppendFixed32(buf, fact.targetDeclarationRaw32)
    parserReceiptAppendI32(buf, fact.importDeclarationRow)
    parserReceiptAppendI32(buf, fact.importItemRow)
    parserReceiptAppendI32(buf, fact.keywordTokenIndex)
    parserSpanReceiptAppendTokenIdentity(
        buf, tree, fact.keywordTokenIndex)
    parserReceiptAppendI32(buf, fact.aliasTokenIndex)
    if fact.aliasTokenIndex >= 0:
        parserSpanReceiptAppendTokenIdentity(
            buf, tree, fact.aliasTokenIndex)
    parserReceiptAppendI32(buf, fact.spanStart)
    parserReceiptAppendI32(buf, fact.spanEnd)
    parserReceiptAppendI32(buf, fact.moduleTokenIndexes.len)
    for tokenOffset in 0..<fact.moduleTokenIndexes.len:
        parserSpanReceiptAppendTokenIdentity(
            buf, tree, fact.moduleTokenIndexes[tokenOffset])
    parserReceiptAppendI32(buf, fact.prefixTokenCount)
    parserReceiptAppendText(buf, fact.ownerModulePath)
    parserReceiptAppendText(buf, fact.targetModulePath)
    parserReceiptAppendText(buf, fact.targetSourcePath)
    parserReceiptAppendI32(buf, fact.targetProfileIndex)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserReceiptTreeArrayShape(tree: parser.ParserValueExprTree): bool =
    if tree == nil:
        return true
    let nodes = tree.nodeCount
    if tree.producerSourceCount <= 0:
        return false
    if tree.kinds.len != nodes || tree.sourceTextIds.len != nodes ||
       tree.spanStarts.len != nodes || tree.spanEnds.len != nodes ||
       tree.atomStarts.len != nodes || tree.atomEnds.len != nodes ||
       tree.ownerStarts.len != nodes || tree.ownerEnds.len != nodes ||
       tree.nameStarts.len != nodes || tree.nameEnds.len != nodes ||
       tree.operatorStarts.len != nodes || tree.operatorEnds.len != nodes ||
       tree.argumentNameStarts.len != nodes ||
       tree.argumentNameEnds.len != nodes ||
       tree.callArgsStarts.len != nodes || tree.callArgsEnds.len != nodes ||
       tree.argumentRootStarts.len != nodes ||
       tree.argumentRootCounts.len != nodes ||
       tree.firstChilds.len != nodes || tree.childCounts.len != nodes ||
       tree.nextSiblings.len != nodes ||
       tree.parentNodeIndexes.len != nodes ||
       tree.nodeStatementRootEventIndexes.len != nodes ||
       tree.explicitGenericStarts.len != nodes ||
       tree.explicitGenericCounts.len != nodes:
        return false
    if tree.explicitGenericSpanStarts.len != tree.genericCount ||
       tree.explicitGenericSpanEnds.len != tree.genericCount ||
       tree.regionKinds.len != tree.regionCount ||
       tree.regionSourceTextIds.len != tree.regionCount ||
       tree.regionSpanStarts.len != tree.regionCount ||
       tree.regionSpanEnds.len != tree.regionCount ||
       tree.regionAnchorTokenIndexes.len != tree.regionCount ||
       tree.typeSyntaxKinds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSourceTextIds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxProducerSourceIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSourceLocalRows.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSpanStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSpanEnds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxOwnerTokenIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxDeclarationOwnerTokenIndexes.len !=
           tree.typeSyntaxCount ||
       tree.typeSyntaxDeclarationOwnerNodeIndexes.len !=
           tree.typeSyntaxCount ||
       tree.typeSyntaxGenericSymbolStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxGenericSymbolCounts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxChildStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxChildCounts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxChildNodeIndexes.len != tree.typeSyntaxChildCount ||
       tree.typeSyntaxBracketArgStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxBracketArgCounts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxBracketArgTokenStarts.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgTokenCounts.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgTypeNodeIndexes.len !=
