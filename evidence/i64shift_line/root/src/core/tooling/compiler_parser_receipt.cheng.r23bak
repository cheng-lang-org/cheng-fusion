        parserReceiptAppendI32(buf, sidecar.diagnosticSeverities[row])
        parserReceiptAppendText(buf, sidecar.diagnosticCodeTexts[row])
        parserReceiptAppendText(buf, sidecar.diagnosticMessageTexts[row])
        parserReceiptAppendFixed32(
            buf, sidecar.diagnosticProofRaw32s[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserDiagnosticCompletionRaw32(
        sidecar: ParserCanonicalSourceSidecar): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    parserReceiptAppendText(buf, ParserDiagnosticCompletionDomain)
    parserReceiptAppendI32(buf, sidecar.sourceIndex)
    parserReceiptAppendFixed32(buf, sidecar.sourceContentRaw32)
    parserReceiptAppendFixed32(buf, sidecar.parserInputRaw32)
    parserReceiptAppendFixed32(buf, sidecar.sidecarRaw32)
    parserReceiptAppendI32(buf, sidecar.diagnosticRowStart)
    parserReceiptAppendI32(buf, sidecar.diagnosticRowCount)
    for row in 0..<sidecar.diagnosticRowCount:
        parserReceiptAppendI32(
            buf, sidecar.diagnosticAnchorKinds[row])
        parserReceiptAppendI32(
            buf, sidecar.diagnosticAnchorNodeIds[row])
        parserReceiptAppendI32(
            buf,
            sidecar.diagnosticOwnerDeclarationSourceLocalRows[row])
        parserReceiptAppendI32(buf, sidecar.diagnosticSpanIds[row])
        parserReceiptAppendI32(buf, sidecar.diagnosticSeverities[row])
        parserReceiptAppendText(buf, sidecar.diagnosticCodeTexts[row])
        parserReceiptAppendText(buf, sidecar.diagnosticMessageTexts[row])
        parserReceiptAppendFixed32(
            buf, sidecar.diagnosticProofRaw32s[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserDiagnosticTextValid(value: str): bool =
    if value == "":
        return false
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 && value[index] != '\n' &&
           value[index] != '\r' && value[index] != '\t':
            return false
    return true

@borrows
fn parserDiagnosticRowProofRaw32(
        sidecar: ParserCanonicalSourceSidecar,
        row: int32): layout.FixedBytes32 =
    let canonicalNodeRow =
        sidecar.diagnosticAnchorNodeIds[row]
    var producerNodeRow: int32 = -1
    if canonicalNodeRow >= 0:
        producerNodeRow =
            sidecar.nodeProducerIds[canonicalNodeRow]
    let owner =
        sidecar.diagnosticOwnerDeclarationSourceLocalRows[row]
    var ownerKind: int32 = -1
    if owner >= 0:
        ownerKind = sidecar.declarationKinds[owner]
    let span = sidecar.diagnosticSpanIds[row]
    return diagnostic_authority.ParserDiagnosticAuthorityParserProjectionCid(
        sidecar.sourceIndex,
        sidecar.sourceContentRaw32,
        sidecar.parserInputRaw32,
        sidecar.diagnosticAnchorKinds[row],
        canonicalNodeRow,
        producerNodeRow,
        owner,
        ownerKind,
        span,
        sidecar.spanStartBytes[span],
        sidecar.spanEndBytes[span],
        sidecar.diagnosticSeverities[row],
        sidecar.diagnosticCodeTexts[row],
        sidecar.diagnosticMessageTexts[row])

@borrows
fn parserDiagnosticRowsPayloadStrictValidateInto(
        sidecar: ParserCanonicalSourceSidecar,
        err: var str): bool =
    let rowCount = sidecar.diagnosticAnchorNodeIds.len
    if rowCount != sidecar.diagnosticAnchorKinds.len ||
       rowCount !=
           sidecar.diagnosticOwnerDeclarationSourceLocalRows.len ||
       rowCount != sidecar.diagnosticSpanIds.len ||
       rowCount != sidecar.diagnosticSeverities.len ||
       rowCount != sidecar.diagnosticCodeTexts.len ||
       rowCount != sidecar.diagnosticMessageTexts.len:
        err = " compiler parser receipt: diagnostic row columns split"
        return false
    for row in 0..<rowCount:
        let anchorKind = sidecar.diagnosticAnchorKinds[row]
        let anchorNode = sidecar.diagnosticAnchorNodeIds[row]
        let owner =
            sidecar.diagnosticOwnerDeclarationSourceLocalRows[row]
        let span = sidecar.diagnosticSpanIds[row]
        let needsParser =
            anchorKind == ParserDiagnosticAnchorParserNode ||
            anchorKind ==
                ParserDiagnosticAnchorParserNodeOwnerDeclaration
        let needsOwner =
            anchorKind == ParserDiagnosticAnchorOwnerDeclaration ||
            anchorKind ==
                ParserDiagnosticAnchorParserNodeOwnerDeclaration
        if anchorKind < ParserDiagnosticAnchorSpan ||
           anchorKind >
               ParserDiagnosticAnchorParserNodeOwnerDeclaration ||
           span < 0 || span >= sidecar.spanStartBytes.len ||
           (needsParser &&
            (anchorNode < 0 || anchorNode >= sidecar.nodeKinds.len ||
             sidecar.nodeSpanIds[anchorNode] != span)) ||
           (!needsParser && anchorNode != -1) ||
           (needsOwner &&
            (owner < 0 || owner >= sidecar.declarationKinds.len ||
             sidecar.declarationSourceLocalRows[owner] != owner ||
             sidecar.spanStartBytes[span] <
                 sidecar.spanStartBytes[
                     sidecar.declarationSpanIds[owner]] ||
             sidecar.spanEndBytes[span] >
                 sidecar.spanEndBytes[
                     sidecar.declarationSpanIds[owner]])) ||
           (!needsOwner && owner != -1) ||
           sidecar.diagnosticSeverities[row] <
               ParserDiagnosticSeverityError ||
           sidecar.diagnosticSeverities[row] >
               ParserDiagnosticSeverityHint ||
           !parserDiagnosticTextValid(
               sidecar.diagnosticCodeTexts[row]) ||
           !parserDiagnosticTextValid(
               sidecar.diagnosticMessageTexts[row]):
            err = " compiler parser receipt: diagnostic row invalid"
            return false
        if row > 0:
            let previousSourceOrder =
                sidecar.diagnosticSpanIds[row - 1] < span ||
                (sidecar.diagnosticSpanIds[row - 1] == span &&
                 sidecar.diagnosticAnchorKinds[row - 1] < anchorKind)
            if !previousSourceOrder:
                err = " compiler parser receipt: diagnostic rows are not canonical"
                return false
    err = ""
    return true

@borrows
fn parserDiagnosticRowsStrictValidateInto(
        sidecar: ParserCanonicalSourceSidecar,
        err: var str): bool =
    if !parserDiagnosticRowsPayloadStrictValidateInto(sidecar, err):
        return false
    if sidecar.diagnosticProofRaw32s.len !=
           sidecar.diagnosticAnchorNodeIds.len:
        err = " compiler parser receipt: diagnostic proof columns split"
        return false
    for row in 0..<sidecar.diagnosticProofRaw32s.len:
        if !layout.FixedBytes32Equal(
               parserDiagnosticRowProofRaw32(sidecar, row),
               sidecar.diagnosticProofRaw32s[row]):
            err = " compiler parser receipt: diagnostic row proof mismatch"
            return false
    err = ""
    return true

@borrows
fn parserCanonicalSidecarsRoot(
        sidecars: ParserCanonicalSourceSidecar[]): layout.FixedBytes32 =
    let sidecarBytes = parserReceiptCheckedCapacityMul(
        sidecars.len,
        layout.FixedBytes32Size,
        "compiler parser receipt: sidecar root capacity overflow")
    let capacity = parserReceiptCheckedCapacityAdd(
        128,
        sidecarBytes,
        "compiler parser receipt: sidecar root capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    parserReceiptAppendText(buf, "cheng.compiler.parser_canonical_sources")
    parserReceiptAppendI32(buf, sidecars.len)
    for sourceIndex in 0..<sidecars.len:
        parserReceiptAppendI32(buf, sourceIndex)
        parserReceiptAppendFixed32(buf, sidecars[sourceIndex].sidecarRaw32)
        parserReceiptAppendI32(
            buf, sidecars[sourceIndex].diagnosticRowStart)
        parserReceiptAppendI32(
            buf, sidecars[sourceIndex].diagnosticRowCount)
        parserReceiptAppendFixed32(
            buf, sidecars[sourceIndex].diagnosticCompletionRaw32)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserCanonicalAggregateArtifact(
        aggregateBaseRaw32: layout.FixedBytes32,
        canonicalParserRootRaw32: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    parserReceiptAppendText(
        buf, "cheng.compiler.parser_normalized_expr_aggregate_binding")
    parserReceiptAppendFixed32(buf, aggregateBaseRaw32)
    parserReceiptAppendFixed32(buf, canonicalParserRootRaw32)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn parserCanonicalSourceTextMatches(tree: parser.ParserValueExprTree,
                                    sourceTextId: int32,
                                    parserInputText: str,
                                    observedIds: var int32[],
                                    err: var str): bool =
    for index in 0..<observedIds.len:
        if observedIds[index] == sourceTextId:
            return true
    if sourceTextId < 0 ||
       parser.ParserValueExprSourceText(tree, sourceTextId) != parserInputText:
        err = " compiler parser receipt: parser source text identity mismatch"
        return false
    add(observedIds, sourceTextId)
    return true

@borrows
fn parserCanonicalFunctionSpansBuildInto(
        sourceIndex: int32,
        sourceText: str,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        out: var ParserCanonicalFunctionSpan[],
        err: var str): bool =
    out = []
    let lines = parser.ParserSplitChar(sourceText, '\n')
    let lineStarts = parserCanonicalLineStarts(sourceText)
    if lines.len != lineStarts.len:
        err = " compiler parser receipt: function source line index mismatch"
        return false
    # Identities are emitted in the parser's executable declaration order for
    # this source. Preserve that exact structural row identity; name and line
    # are consistency evidence below, never lookup keys.
    var executableDeclarationIndexes: int32[]
    for declarationIndex in 0..<declarations.len:
        if !declarations[declarationIndex].importc:
            add(executableDeclarationIndexes, declarationIndex)
    if executableDeclarationIndexes.len != identities.len:
        err = " compiler parser receipt: executable declaration identity coverage mismatch"
        return false
    var previousSignatureLine: int32
    for identityIndex in 0..<identities.len:
        let identity = identities[identityIndex]
        if identity.sourceIndex != sourceIndex ||
           identity.functionIndex < 0 || identity.functionName == "" ||
           identity.signatureLineNumber <= previousSignatureLine ||
           identity.endLineNumber < identity.signatureLineNumber ||
           identity.endLineNumber > lines.len:
            err = " compiler parser receipt: function span identity invalid"
            return false
        let declarationIndex = executableDeclarationIndexes[identityIndex]
        if declarationIndex < 0 || declarationIndex >= declarations.len:
            err = " compiler parser receipt: executable declaration row invalid"
            return false
        let declaration = declarations[declarationIndex]
        if declaration.lineIndex != identity.signatureLineNumber ||
           declaration.name != identity.functionName:
            err = " compiler parser receipt: function declaration identity drift"
            return false
        let signatureLineIndex = identity.signatureLineNumber - 1
        let endLineIndex = identity.endLineNumber - 1
        let signatureLine = parser.ParserLineWithoutTrailingCr(
            lines[signatureLineIndex])
        let endLine = parser.ParserLineWithoutTrailingCr(lines[endLineIndex])
        let signatureEndLineIndex = declaration.signatureEndLineIndex - 1
        let bodyStartLineIndex = declaration.bodyStartLineIndex - 1
        if signatureEndLineIndex < signatureLineIndex ||
           signatureEndLineIndex > endLineIndex ||
           bodyStartLineIndex < signatureLineIndex ||
           bodyStartLineIndex > endLineIndex:
            err = " compiler parser receipt: function declaration line range invalid"
            return false
        let signatureEndLine = parser.ParserLineWithoutTrailingCr(
            lines[signatureEndLineIndex])
        let bodyStartLine = parser.ParserLineWithoutTrailingCr(
            lines[bodyStartLineIndex])
        if declaration.importc ||
           declaration.signatureStartColumn < 0 ||
           declaration.signatureEndColumn <= 0 ||
           declaration.signatureEndColumn > signatureEndLine.len ||
           declaration.nameStartColumn < declaration.signatureStartColumn ||
           declaration.nameEndColumn <= declaration.nameStartColumn ||
           declaration.nameEndColumn > signatureLine.len ||
           declaration.bodyStartColumn < 0 ||
           declaration.bodyStartColumn > bodyStartLine.len ||
           bodyStartLineIndex < signatureEndLineIndex ||
           (bodyStartLineIndex == signatureEndLineIndex &&
            declaration.bodyStartColumn < declaration.signatureEndColumn) ||
           parser.ParserTextSliceFast(
               signatureLine,
               declaration.nameStartColumn,
               declaration.nameEndColumn - declaration.nameStartColumn) !=
               identity.functionName:
            err = " compiler parser receipt: function declaration columns invalid"
            return false
        var functionSpan: ParserCanonicalFunctionSpan
        functionSpan.functionIndex = identity.functionIndex
        functionSpan.functionName = identity.functionName
        functionSpan.signatureLineNumber = identity.signatureLineNumber
        functionSpan.declarationOrdinal = declarationIndex
        functionSpan.declarationStartByte =
            lineStarts[signatureLineIndex] +
                declaration.signatureStartColumn
        functionSpan.declarationEndByte =
            lineStarts[endLineIndex] + endLine.len
        functionSpan.headerStartByte = functionSpan.declarationStartByte
        functionSpan.headerEndByte =
            lineStarts[signatureEndLineIndex] +
                declaration.signatureEndColumn
        functionSpan.nameStartByte =
            lineStarts[signatureLineIndex] + declaration.nameStartColumn
        functionSpan.nameEndByte =
            lineStarts[signatureLineIndex] + declaration.nameEndColumn
        functionSpan.bodyStartByte =
            lineStarts[bodyStartLineIndex] + declaration.bodyStartColumn
        functionSpan.bodyEndByte = functionSpan.declarationEndByte
        functionSpan.annotationFlags =
            parser.ParserNormalizedFunctionAnnotationFlags(declaration)
        if !parser.ParserNormalizedFunctionAnnotationFlagsValid(
               functionSpan.annotationFlags) ||
           !parser.ParserNormalizedFunctionManualConsumeIdentityValid(
               declaration):
            err = " compiler parser receipt: function annotation flags invalid"
            return false
        functionSpan.manualConsumeTargetParameterOrdinal =
            declaration.manualConsumeTargetParameterOrdinal
        functionSpan.manualConsumeFunctionDeclarationSourceLocalRow =
            declaration.manualConsumeFunctionDeclarationRow
        functionSpan.manualConsumeTargetParameterDeclarationSourceLocalRow =
            declaration.manualConsumeTargetParameterDeclarationRow
        functionSpan.manualConsumeSourceParameterOrdinal =
            declaration.manualConsumeSourceParameterOrdinal
        functionSpan.manualConsumeSourceParameterDeclarationSourceLocalRow =
            declaration.manualConsumeSourceParameterDeclarationRow
        if functionSpan.declarationEndByte <=
               functionSpan.declarationStartByte ||
           functionSpan.nameStartByte < functionSpan.declarationStartByte ||
           functionSpan.nameEndByte > functionSpan.declarationEndByte ||
           functionSpan.headerEndByte <= functionSpan.headerStartByte ||
           functionSpan.headerEndByte > functionSpan.declarationEndByte ||
           functionSpan.nameStartByte < functionSpan.headerStartByte ||
           functionSpan.nameEndByte > functionSpan.headerEndByte ||
           functionSpan.bodyStartByte < functionSpan.nameEndByte ||
           functionSpan.bodyEndByte <= functionSpan.bodyStartByte:
            err = " compiler parser receipt: function source span invalid"
            return false
        add(out, functionSpan)
        previousSignatureLine = identity.signatureLineNumber
    err = ""
    return true

@borrows
fn parserCanonicalFfiHandleContractsProjectInto(
        tree: parser.ParserValueExprTree,
        declarations: parser.NormalizedFunctionDecl[],
        exactTreeAuthority: bool,
        out: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    out.ffiHandleContractProducerSourceIds = []
    out.ffiHandleContractFunctionDeclarationSourceLocalRows = []
    out.ffiHandleContractAnnotationSourceLocalRows = []
    out.ffiHandleContractUnwindKinds = []
    out.ffiHandleContractResultEffects = []
    out.ffiHandleContractParameterStarts = []
    out.ffiHandleContractParameterCounts = []
    out.ffiHandleParserContractCids = []
    out.ffiHandleParameterOrdinals = []
    out.ffiHandleParameterDeclarationSourceLocalRows = []
    out.ffiHandleParameterEffects = []
    var contracts: parser.NormalizedFfiHandleContractTable
    if !parser.ParserBuildNormalizedFfiHandleContractsInto(
           tree, declarations, contracts, err):
        return false
    let contractCount =
        parser.ParserNormalizedFfiHandleContractCount(contracts)
    if contractCount > 0 && !exactTreeAuthority:
        err = " compiler parser receipt: ffi handle requires exact source-tree authority"
        return false
    for contractRow in 0..<contractCount:
        let functionDeclarationRow =
            parser.ParserNormalizedFfiHandleContractFunctionDeclarationRowAt(
                contracts, contractRow)
        let annotationRow =
            parser.ParserNormalizedFfiHandleContractAnnotationRowAt(
                contracts, contractRow)
        if functionDeclarationRow < 0 ||
           functionDeclarationRow >= out.declarationKinds.len ||
           annotationRow < 0 ||
           annotationRow >= out.annotationProducerSourceIds.len ||
           out.declarationKinds[functionDeclarationRow] !=
               Int32(parser.ParserDeclarationFunction) ||
           out.declarationProducerSourceIds[functionDeclarationRow] !=
               out.sourceIndex ||
           out.annotationProducerSourceIds[annotationRow] != out.sourceIndex:
            err = " compiler parser receipt: ffi handle exact owner missing"
            return false
        let functionSourceLocalRow =
            out.declarationSourceLocalRows[functionDeclarationRow]
        let annotationSourceLocalRow =
            out.annotationSourceLocalRows[annotationRow]
        if contractRow > 0 &&
           out.ffiHandleContractFunctionDeclarationSourceLocalRows[
               contractRow - 1] >= functionSourceLocalRow:
            err = " compiler parser receipt: ffi handle contract order invalid"
            return false
        let parameterCount =
            parser.ParserNormalizedFfiHandleContractParameterCountAt(
                contracts, contractRow)
        let resultEffect = Int32(
            parser.ParserNormalizedFfiHandleContractResultEffectAt(
                contracts, contractRow))
        let unwindKind = Int32(
            parser.ParserNormalizedFfiHandleContractUnwindKindAt(
                contracts, contractRow))
        if parameterCount < 0 ||
           unwindKind !=
               Int32(parser.NormalizedFfiHandleUnwindNoUnwind) ||
           (resultEffect !=
                Int32(parser.NormalizedFfiHandleEffectInvalid) &&
            resultEffect !=
                Int32(parser.NormalizedFfiHandleEffectProduce)):
            err = " compiler parser receipt: ffi handle contract shape invalid"
            return false
        add(out.ffiHandleContractProducerSourceIds, out.sourceIndex)
        add(out.ffiHandleContractFunctionDeclarationSourceLocalRows,
            functionSourceLocalRow)
        add(out.ffiHandleContractAnnotationSourceLocalRows,
            annotationSourceLocalRow)
        add(out.ffiHandleContractUnwindKinds, unwindKind)
        add(out.ffiHandleContractResultEffects, resultEffect)
        add(out.ffiHandleContractParameterStarts,
            out.ffiHandleParameterOrdinals.len)
        add(out.ffiHandleContractParameterCounts, parameterCount)
        add(out.ffiHandleParserContractCids, layout.FixedBytes32())
        for parameterOffset in 0..<parameterCount:
            let ordinal =
                parser.ParserNormalizedFfiHandleContractParameterOrdinalAt(
                    contracts, contractRow, parameterOffset)
            let parameterSourceLocalRow =
                parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
                    contracts, contractRow, parameterOffset)
            let effect = Int32(
                parser.ParserNormalizedFfiHandleContractParameterEffectAt(
                    contracts, contractRow, parameterOffset))
            var parameterDeclarationRow: int32 = -1
            var observedOrdinal: int32
            for declarationRow in 0..<out.declarationKinds.len:
                if out.declarationKinds[declarationRow] !=
                       Int32(parser.ParserDeclarationParameter) ||
                   out.declarationOwnerIds[declarationRow] !=
                       functionDeclarationRow:
                    continue
                if out.declarationProducerSourceIds[declarationRow] !=
                       out.sourceIndex:
                    err = " compiler parser receipt: ffi handle parameter source split"
                    return false
                if out.declarationSourceLocalRows[declarationRow] ==
                       parameterSourceLocalRow:
                    if parameterDeclarationRow >= 0:
                        err = " compiler parser receipt: ffi handle parameter identity ambiguous"
                        return false
                    parameterDeclarationRow = declarationRow
                    if observedOrdinal != ordinal:
                        err = " compiler parser receipt: ffi handle parameter ordinal drift"
                        return false
                observedOrdinal = observedOrdinal + 1
            if parameterDeclarationRow < 0 || ordinal < 0 ||
               (parameterOffset > 0 &&
                out.ffiHandleParameterOrdinals[
                    out.ffiHandleParameterOrdinals.len - 1] >= ordinal) ||
               (effect != Int32(parser.NormalizedFfiHandleEffectBorrow) &&
                effect != Int32(parser.NormalizedFfiHandleEffectConsume)):
                err = " compiler parser receipt: ffi handle parameter relation invalid"
                return false
            add(out.ffiHandleParameterOrdinals, ordinal)
            add(out.ffiHandleParameterDeclarationSourceLocalRows,
                parameterSourceLocalRow)
            add(out.ffiHandleParameterEffects, effect)
        let cid = parserFfiHandleContractCid(out, contractRow)
        if layout.FixedBytes32Equal(cid, layout.FixedBytes32()):
            err = " compiler parser receipt: ffi handle contract cid missing"
            return false
        out.ffiHandleParserContractCids[contractRow] = cid
    err = ""
    return true

@borrows
fn parserCanonicalSourceSidecarBuildMappedInto(
        sourceIndex: int32,
        sourceText: str,
        parserInputText: str,
        tree: parser.ParserValueExprTree,
        coordinateMap: parser.ParserSourceRewriteCoordinateMap,
        diagnosticSpanStartByte: int32,
        diagnosticSpanEndByte: int32,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        exactFfiHandleTreeAuthority: bool,
        out: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    out = new(ParserCanonicalSourceSidecar)
    out.importOrigins = new(ParserCanonicalImportOriginSoA)
    if sourceIndex < 0 || tree == nil || !parserReceiptTreeArrayShape(tree):
        err = " compiler parser receipt: invalid canonical source tree"
        return false
    if !parser.ParserValueExprTreeTokensStrictValidateInto(tree, err) ||
       !parser.ParserValueExprTreeImportOriginsStrictValidateInto(
           tree, err) ||
       !parser.ParserValueExprTreeTypeSyntaxBracketArgsStrictValidateInto(
           tree, err) ||
       !parser.ParserValueExprTreeEnumVariantsStrictValidateInto(tree, err) ||
       !parser.ParserValueExprTreeDeclarationsStrictValidateInto(tree, err) ||
       !parser.ParserValueExprTreeAnnotationsStrictValidateInto(tree, err) ||
       !parser.ParserValueExprTreePatternsStrictValidateInto(tree, err) ||
       !parser.ParserValueExprTreeForwardingProductionsStrictValidateInto(
           tree, err):
        return false
    let parserImportOrigins = tree.importOrigins
    let outImportOrigins = out.importOrigins
    var observedSourceTextIds: int32[]
    var spanCandidates: ParserCanonicalSpanCandidate[]
    var functionSpans: ParserCanonicalFunctionSpan[]
    if !parserCanonicalFunctionSpansBuildInto(
           sourceIndex,
           sourceText,
           identities,
           declarations,
           functionSpans,
           err):
        return false
    if diagnosticSpanStartByte >= 0 ||
       diagnosticSpanEndByte >= 0:
        if !parserCanonicalSpanCandidateAdd(
               spanCandidates,
               diagnosticSpanStartByte,
               diagnosticSpanEndByte,
               sourceText.len,
               err):
            return false
    for nodeIndex in 0..<tree.nodeCount:
        let sourceTextId = parserReceiptArenaI32(
            tree, tree.sourceTextIds, nodeIndex)
        if !parserCanonicalSourceTextMatches(tree,
                                             sourceTextId,
                                             parserInputText,
                                             observedSourceTextIds,
                                             err) ||
           !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(tree, tree.spanStarts, nodeIndex),
               parserReceiptArenaI32(tree, tree.spanEnds, nodeIndex),
               err):
            return false
    for tokenIndex in 0..<tree.tokenCount:
        let sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, tokenIndex)
        if !parserCanonicalSourceTextMatches(tree,
                                             sourceTextId,
                                             parserInputText,
                                             observedSourceTextIds,
                                             err) ||
           !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(tree, tree.tokenStarts, tokenIndex),
               parserReceiptArenaI32(tree, tree.tokenEnds, tokenIndex),
               err):
            return false
    for genericIndex in 0..<tree.genericCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, tree.explicitGenericSpanStarts, genericIndex),
               parserReceiptArenaI32(
                   tree, tree.explicitGenericSpanEnds, genericIndex),
               err):
            return false
    for declarationRow in 0..<parserImportOrigins.declarationCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree,
                   parserImportOrigins.declarationSpanStarts,
                   declarationRow),
               parserReceiptArenaI32(
                   tree,
                   parserImportOrigins.declarationSpanEnds,
                   declarationRow),
               err):
            return false
    for itemRow in 0..<parserImportOrigins.itemCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, parserImportOrigins.itemSpanStarts, itemRow),
               parserReceiptArenaI32(
                   tree, parserImportOrigins.itemSpanEnds, itemRow),
               err):
            return false
    for regionIndex in 0..<tree.regionCount:
        let sourceTextId = parserReceiptArenaI32(
            tree, tree.regionSourceTextIds, regionIndex)
        if !parserCanonicalSourceTextMatches(tree,
                                             sourceTextId,
                                             parserInputText,
                                             observedSourceTextIds,
                                             err) ||
           !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(tree, tree.regionSpanStarts, regionIndex),
               parserReceiptArenaI32(tree, tree.regionSpanEnds, regionIndex),
               err):
            return false
    for typeNodeIndex in 0..<tree.typeSyntaxCount:
        let sourceTextId = parserReceiptArenaI32(
            tree, tree.typeSyntaxSourceTextIds, typeNodeIndex)
        if !parserCanonicalSourceTextMatches(tree,
                                             sourceTextId,
                                             parserInputText,
                                             observedSourceTextIds,
                                             err) ||
           !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, tree.typeSyntaxSpanStarts, typeNodeIndex),
               parserReceiptArenaI32(
                   tree, tree.typeSyntaxSpanEnds, typeNodeIndex),
               err):
            return false
    for symbolRow in 0..<tree.typeGenericSymbolCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, tree.typeGenericSymbolSpanStarts, symbolRow),
               parserReceiptArenaI32(
                   tree, tree.typeGenericSymbolSpanEnds, symbolRow),
               err):
            return false
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        let producerSourceIndex = parserReceiptArenaI32(
            tree,
            tree.declarationLexicalScopeProducerSourceIndexes,
            scopeRow)
        if tree.producerSourceCount != 1 || producerSourceIndex != 0:
            err = " compiler parser receipt: lexical scope mapping failed"
            return false
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree,
                   tree.declarationLexicalScopeSpanStarts,
                   scopeRow),
               parserReceiptArenaI32(
                   tree,
                   tree.declarationLexicalScopeSpanEnds,
                   scopeRow),
               err):
            return false
        add(out.declarationLexicalScopeProducerSourceIds, sourceIndex)
        add(out.declarationLexicalScopeSourceLocalRows,
            parserReceiptArenaI32(
                tree,
                tree.declarationLexicalScopeSourceLocalRows,
                scopeRow))
        add(out.declarationLexicalScopeKinds,
            parserReceiptArenaI32(
                tree, tree.declarationLexicalScopeKinds, scopeRow))
        add(out.declarationLexicalScopeParentIds,
            parserReceiptArenaI32(
                tree, tree.declarationLexicalScopeParentRows, scopeRow))
        add(out.declarationLexicalScopeOwnerDeclarationIds,
            parserReceiptArenaI32(
                tree,
                tree.declarationLexicalScopeOwnerDeclarationRows,
                scopeRow))
    for declarationRow in 0..<tree.declarationCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, tree.declarationSpanStarts, declarationRow),
               parserReceiptArenaI32(
                   tree, tree.declarationSpanEnds, declarationRow),
               err) ||
           !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, tree.declarationNameSpanStarts, declarationRow),
               parserReceiptArenaI32(
                   tree, tree.declarationNameSpanEnds, declarationRow),
               err):
            return false
    for patternRow in 0..<tree.patternCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, tree.patternSpanStarts, patternRow),
               parserReceiptArenaI32(
                   tree, tree.patternSpanEnds, patternRow),
               err):
            return false
    for annotationRow in 0..<tree.annotationCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree, tree.annotationSpanStarts, annotationRow),
               parserReceiptArenaI32(
                   tree, tree.annotationSpanEnds, annotationRow),
               err):
            return false
    for annotationArgRow in 0..<tree.annotationArgCount:
        if !parserCanonicalSourceSpanCandidateAdd(
               spanCandidates,
               coordinateMap,
               sourceText,
               parserInputText,
               parserReceiptArenaI32(
                   tree,
                   tree.annotationArgSpanStarts,
                   annotationArgRow),
               parserReceiptArenaI32(
                   tree,
                   tree.annotationArgSpanEnds,
                   annotationArgRow),
               err):
            return false
    if !parserCanonicalFfiHandleContractsProjectInto(
           tree,
           declarations,
           exactFfiHandleTreeAuthority,
           out,
           err):
        return false
    for functionIndex in 0..<functionSpans.len:
        let functionSpan = functionSpans[functionIndex]
        if !parserCanonicalSpanCandidateAdd(
               spanCandidates,
               functionSpan.declarationStartByte,
               functionSpan.declarationEndByte,
               sourceText.len,
               err) ||
           !parserCanonicalSpanCandidateAdd(
               spanCandidates,
               functionSpan.headerStartByte,
               functionSpan.headerEndByte,
               sourceText.len,
               err) ||
           !parserCanonicalSpanCandidateAdd(
               spanCandidates,
               functionSpan.nameStartByte,
               functionSpan.nameEndByte,
               sourceText.len,
               err) ||
           !parserCanonicalSpanCandidateAdd(
               spanCandidates,
               functionSpan.bodyStartByte,
               functionSpan.bodyEndByte,
               sourceText.len,
               err):
            return false
    if tree.tokenCount > 0 && spanCandidates.len <= 0:
        err = " compiler parser receipt: canonical source has no spans"
        return false
    parserCanonicalSpanSort(spanCandidates)
    var canonicalSpans: ParserCanonicalSpanCandidate[]
    for row in 0..<spanCandidates.len:
        if row == 0 ||
           !parserCanonicalSpanEqual(spanCandidates[row - 1],
                                     spanCandidates[row]):
            add(canonicalSpans, spanCandidates[row])
    let sourceLineStarts = parserCanonicalLineStarts(sourceText)
    let parserLineStarts = parserCanonicalLineStarts(parserInputText)
    out.sourceIndex = sourceIndex
    out.sourceContentRaw32 = parserReceiptTextRaw32(sourceText)
    out.parserInputRaw32 = parserReceiptTextRaw32(parserInputText)
    for row in 0..<canonicalSpans.len:
        let span = canonicalSpans[row]
        var startLine: int32
        var startColumn: int32
        var endLine: int32
        var endColumn: int32
        if !parserCanonicalPosition(sourceLineStarts,
                                    sourceText.len,
                                    span.startByte,
                                    startLine,
                                    startColumn) ||
           !parserCanonicalPosition(sourceLineStarts,
                                    sourceText.len,
                                    span.endByte,
                                    endLine,
                                    endColumn):
            err = " compiler parser receipt: canonical span position failed"
            return false
        add(out.spanStartBytes, span.startByte)
        add(out.spanEndBytes, span.endByte)
        add(out.spanStartLines, startLine)
        add(out.spanStartColumns, startColumn)
        add(out.spanEndLines, endLine)
        add(out.spanEndColumns, endColumn)
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree,
                tree.declarationLexicalScopeSpanStarts,
                scopeRow),
            parserReceiptArenaI32(
                tree,
                tree.declarationLexicalScopeSpanEnds,
                scopeRow),
            err)
        if spanId < 0:
            err = " compiler parser receipt: lexical scope span missing"
            return false
        add(out.declarationLexicalScopeSpanIds, spanId)
    var oldToNew: int32[]
    setLen(oldToNew, tree.nodeCount)
    for nodeIndex in 0..<tree.nodeCount:
        oldToNew[nodeIndex] = -1
    var traversalStack: int32[]
    var topLevelRoots: int32[]
    for nodeIndex in 0..<tree.nodeCount:
        let parent = parserReceiptArenaI32(
            tree, tree.parentNodeIndexes, nodeIndex)
        if parent == -1:
            add(topLevelRoots, nodeIndex)
        elif parent < 0 || parent >= tree.nodeCount:
            err = " compiler parser receipt: parser parent is invalid"
            return false
    var topRootCursor = topLevelRoots.len
    while topRootCursor > 0:
        topRootCursor = topRootCursor - 1
        add(traversalStack, topLevelRoots[topRootCursor])
    if tree.nodeCount > 0 && topLevelRoots.len <= 0:
        err = " compiler parser receipt: parser forest has no root"
        return false
    var preorderOldIds: int32[]
    while traversalStack.len > 0:
        let stackLast = traversalStack.len - 1
        let oldNode = traversalStack[stackLast]
        setLen(traversalStack, stackLast)
        if oldNode < 0 || oldNode >= tree.nodeCount || oldToNew[oldNode] >= 0:
            err = " compiler parser receipt: parser tree is cyclic or shared"
            return false
        oldToNew[oldNode] = preorderOldIds.len
        add(preorderOldIds, oldNode)
        let childCount = parserReceiptArenaI32(
            tree, tree.childCounts, oldNode)
        var children: int32[]
        var child = parserReceiptArenaI32(tree, tree.firstChilds, oldNode)
        for childOffset in 0..<childCount:
            if child < 0 || child >= tree.nodeCount ||
               parserReceiptArenaI32(
                   tree, tree.parentNodeIndexes, child) != oldNode:
                err = " compiler parser receipt: parser child authority mismatch"
                return false
            add(children, child)
            child = parserReceiptArenaI32(tree, tree.nextSiblings, child)
        if child != -1:
            err = " compiler parser receipt: parser child count mismatch"
            return false
        var childCursor = children.len
        while childCursor > 0:
            childCursor = childCursor - 1
            add(traversalStack, children[childCursor])
    if preorderOldIds.len != tree.nodeCount:
        err = " compiler parser receipt: parser node coverage mismatch"
        return false
    var childRowCursor: int32
    for newNode in 0..<preorderOldIds.len:
        let oldNode = preorderOldIds[newNode]
        let oldParent = parserReceiptArenaI32(
            tree, tree.parentNodeIndexes, oldNode)
        let parent = oldParent < 0 ? -1 : oldToNew[oldParent]
        let kind = parserReceiptArenaI32(tree, tree.kinds, oldNode)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(tree, tree.spanStarts, oldNode),
            parserReceiptArenaI32(tree, tree.spanEnds, oldNode),
            err)
        let childCount = parserReceiptArenaI32(
            tree, tree.childCounts, oldNode)
        if kind <= 0 || spanId < 0 ||
           (parent >= 0 && parent >= newNode) || childCount < 0:
            err = " compiler parser receipt: canonical parser node is invalid"
            return false
        add(out.nodeParentIds, parent)
        add(out.nodeProducerIds, oldNode)
        add(out.nodeKinds, kind)
        add(out.nodeSpanIds, spanId)
        add(out.nodeChildStarts, childRowCursor)
        add(out.nodeChildCounts, childCount)
        add(out.nodeGenericStarts,
            parserReceiptArenaI32(tree, tree.explicitGenericStarts, oldNode))
        add(out.nodeGenericCounts,
            parserReceiptArenaI32(tree, tree.explicitGenericCounts, oldNode))
        let bindingResolutionKind = parserReceiptArenaI32(
            tree, tree.nodeBindingResolutionKinds, oldNode)
        let bindingDeclarationRow = parserReceiptArenaI32(
            tree, tree.nodeResolvedBindingDeclarationRows, oldNode)
        let bindingPatternRow = parserReceiptArenaI32(
            tree, tree.nodeResolvedBindingPatternRows, oldNode)
        let bindingDeclarationSourceLocalRow =
            bindingDeclarationRow < 0 ? -1 :
                parserReceiptArenaI32(
                    tree,
                    tree.declarationSourceLocalRows,
                    bindingDeclarationRow)
        let bindingPatternSourceLocalRow =
            bindingPatternRow < 0 ? -1 :
                parserReceiptArenaI32(
                    tree,
                    tree.patternSourceLocalRows,
                    bindingPatternRow)
        add(out.nodeBindingResolutionKinds, bindingResolutionKind)
        add(out.nodeBindingDeclarationSourceLocalRows,
            bindingDeclarationSourceLocalRow)
        add(out.nodeBindingPatternSourceLocalRows,
            bindingPatternSourceLocalRow)
        var child = parserReceiptArenaI32(tree, tree.firstChilds, oldNode)
        for childOffset in 0..<childCount:
            let newChild = oldToNew[child]
            if newChild <= newNode ||
               (childOffset > 0 &&
                newChild <= out.nodeChildIds[out.nodeChildIds.len - 1]):
                err = " compiler parser receipt: canonical child order failed"
                return false
            add(out.nodeChildIds, newChild)
            childRowCursor = childRowCursor + 1
            child = parserReceiptArenaI32(tree, tree.nextSiblings, child)
    for tokenIndex in 0..<tree.tokenCount:
        let kind = parserReceiptArenaI32(tree, tree.tokenKinds, tokenIndex)
        let producerSourceIndex = parserReceiptArenaI32(
            tree, tree.tokenProducerSourceIndexes, tokenIndex)
        let sourceLocalIndex = parserReceiptArenaI32(
            tree, tree.tokenSourceLocalIndexes, tokenIndex)
        let lexicalParentIndex = parserReceiptArenaI32(
            tree, tree.tokenLexicalParentIndexes, tokenIndex)
        let startByte = parserReceiptArenaI32(
            tree, tree.tokenStarts, tokenIndex)
        let endByte = parserReceiptArenaI32(tree, tree.tokenEnds, tokenIndex)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            startByte,
            endByte,
            err)
        var startLine: int32
        var startColumn: int32
        if kind <= 0 || spanId < 0 ||
           tree.producerSourceCount != 1 || producerSourceIndex != 0 ||
           sourceLocalIndex != tokenIndex ||
           lexicalParentIndex < -1 ||
           lexicalParentIndex >= tokenIndex ||
           !parserCanonicalPosition(parserLineStarts,
                                    parserInputText.len,
                                    startByte,
                                    startLine,
                                    startColumn) ||
           parserReceiptArenaI32(
               tree, tree.tokenLineNumbers, tokenIndex) != startLine + 1 ||
           parserReceiptArenaI32(
               tree, tree.tokenColumnNumbers, tokenIndex) != startColumn + 1:
            err = " compiler parser receipt: token position proof mismatch"
            return false
        add(out.tokenProducerSourceIds, sourceIndex)
        add(out.tokenSourceLocalRows, sourceLocalIndex)
        add(out.tokenLexicalParentIds, lexicalParentIndex)
        add(out.tokenKinds, kind)
        add(out.tokenSpanIds, spanId)
        add(out.tokenValues, parser.ParserValueExprTokenText(tree, tokenIndex))
    for declarationRow in 0..<parserImportOrigins.declarationCount:
        let producerSourceIndex = parserReceiptArenaI32(
            tree,
            parserImportOrigins.declarationProducerSourceIndexes,
            declarationRow)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree,
                parserImportOrigins.declarationSpanStarts,
                declarationRow),
            parserReceiptArenaI32(
                tree,
                parserImportOrigins.declarationSpanEnds,
                declarationRow),
            err)
        if tree.producerSourceCount != 1 || producerSourceIndex != 0 ||
           spanId < 0:
            err = " compiler parser receipt: import declaration mapping failed"
            return false
        add(outImportOrigins.importDeclarationProducerSourceIds, sourceIndex)
        add(outImportOrigins.importDeclarationSourceLocalRows,
            parserReceiptArenaI32(
                tree,
                parserImportOrigins.declarationSourceLocalRows,
                declarationRow))
        add(outImportOrigins.importDeclarationKeywordTokenIds,
            parserReceiptArenaI32(
                tree,
                parserImportOrigins.declarationKeywordTokenIndexes,
                declarationRow))
        add(outImportOrigins.importDeclarationSpanIds, spanId)
        add(outImportOrigins.importDeclarationItemStarts,
            parserReceiptArenaI32(
                tree,
                parserImportOrigins.declarationItemStarts,
                declarationRow))
        add(outImportOrigins.importDeclarationItemCounts,
            parserReceiptArenaI32(
                tree,
                parserImportOrigins.declarationItemCounts,
                declarationRow))
    for itemRow in 0..<parserImportOrigins.itemCount:
        let producerSourceIndex = parserReceiptArenaI32(
            tree, parserImportOrigins.itemProducerSourceIndexes, itemRow)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemSpanStarts, itemRow),
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemSpanEnds, itemRow),
            err)
        if tree.producerSourceCount != 1 || producerSourceIndex != 0 ||
           spanId < 0:
            err = " compiler parser receipt: import item mapping failed"
            return false
        add(outImportOrigins.importItemProducerSourceIds, sourceIndex)
        add(outImportOrigins.importItemSourceLocalRows,
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemSourceLocalRows, itemRow))
        add(outImportOrigins.importItemDeclarationIds,
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemDeclarationRows, itemRow))
        add(outImportOrigins.importItemAliasTokenIds,
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemAliasTokenIndexes, itemRow))
        add(outImportOrigins.importItemSpanIds, spanId)
        add(outImportOrigins.importItemModuleTokenStarts,
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemModuleTokenStarts, itemRow))
        add(outImportOrigins.importItemModuleTokenCounts,
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemModuleTokenCounts, itemRow))
        add(outImportOrigins.importItemPrefixTokenCounts,
            parserReceiptArenaI32(
                tree, parserImportOrigins.itemPrefixTokenCounts, itemRow))
    for moduleTokenRow in 0..<parserImportOrigins.moduleTokenCount:
        add(outImportOrigins.importModuleTokenIds,
            parserReceiptArenaI32(
                tree, parserImportOrigins.moduleTokenIndexes, moduleTokenRow))
    for constRow in 0..<tree.typeConstExprCount:
        let kind = parserReceiptArenaI32(
            tree, tree.typeConstExprKinds, constRow)
        let producerSourceIndex = parserReceiptArenaI32(
            tree, tree.typeConstExprProducerSourceIndexes, constRow)
        let token = parserReceiptArenaI32(
            tree, tree.typeConstExprTokenIndexes, constRow)
        let left = parserReceiptArenaI32(
            tree, tree.typeConstExprLeftChildIndexes, constRow)
        let right = parserReceiptArenaI32(
            tree, tree.typeConstExprRightChildIndexes, constRow)
        if token < 0 || token >= tree.tokenCount:
            err = " compiler parser receipt: type const token invalid"
            return false
        let sourceTextId = parserReceiptArenaI32(
            tree, tree.tokenSourceTextIds, token)
        let integerValue = parserReceiptArenaI32(
            tree, tree.typeConstExprIntegerValues, constRow)
        if kind <= Int32(parser.ParserTypeConstExprInvalid) ||
           kind > Int32(parser.ParserTypeConstExprModulo) ||
           producerSourceIndex != 0 || sourceTextId < 0 ||
           left < -1 || left >= constRow ||
           right < -1 || right >= constRow:
            err = " compiler parser receipt: type const expression invalid"
            return false
        add(out.typeConstExprKinds, kind)
        add(out.typeConstExprProducerSourceIds, sourceIndex)
        add(out.typeConstExprSourceTextIds, sourceTextId)
        add(out.typeConstExprTokenIds, token)
        add(out.typeConstExprLeftChildIds, left)
        add(out.typeConstExprRightChildIds, right)
        add(out.typeConstExprIntegerValues, integerValue)
        add(out.typeConstExprIdentityCids,
            parserSpanReceiptTypeConstExprIdentityRaw32(
                constRow,
                sourceIndex,
                sourceTextId,
                token,
                kind,
                left,
                right,
                integerValue))
    var typeChildCursor: int32
    var typeBracketArgCursor: int32
    var typeEnumVariantCursor: int32
    for typeNodeIndex in 0..<tree.typeSyntaxCount:
        let kind = parserReceiptArenaI32(
            tree, tree.typeSyntaxKinds, typeNodeIndex)
        let producerSourceIndex = parserReceiptArenaI32(
            tree, tree.typeSyntaxProducerSourceIndexes, typeNodeIndex)
        let sourceLocalRow =
            parser.ParserValueExprTypeSyntaxSourceLocalRowAt(
                tree, typeNodeIndex)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSpanStarts, typeNodeIndex),
            parserReceiptArenaI32(
                tree, tree.typeSyntaxSpanEnds, typeNodeIndex),
            err)
        let ownerToken = parserReceiptArenaI32(
            tree, tree.typeSyntaxOwnerTokenIndexes, typeNodeIndex)
        let declarationOwnerToken = parserReceiptArenaI32(
            tree,
            tree.typeSyntaxDeclarationOwnerTokenIndexes,
            typeNodeIndex)
        let declarationOwner = parserReceiptArenaI32(
            tree,
            tree.typeSyntaxDeclarationOwnerNodeIndexes,
            typeNodeIndex)
        let genericSymbolStart = parserReceiptArenaI32(
            tree, tree.typeSyntaxGenericSymbolStarts, typeNodeIndex)
        let genericSymbolCount = parserReceiptArenaI32(
            tree, tree.typeSyntaxGenericSymbolCounts, typeNodeIndex)
        let nameToken = parserReceiptArenaI32(
            tree, tree.typeSyntaxNameTokenIndexes, typeNodeIndex)
        let childStart = parserReceiptArenaI32(
            tree, tree.typeSyntaxChildStarts, typeNodeIndex)
        let childCount = parserReceiptArenaI32(
            tree, tree.typeSyntaxChildCounts, typeNodeIndex)
        let bracketArgStart = parserReceiptArenaI32(
            tree, tree.typeSyntaxBracketArgStarts, typeNodeIndex)
        let bracketArgCount = parserReceiptArenaI32(
            tree, tree.typeSyntaxBracketArgCounts, typeNodeIndex)
        let fixedLength = parserReceiptArenaI32(
            tree, tree.typeSyntaxFixedLengths, typeNodeIndex)
        let questionToken = parserReceiptArenaI32(
            tree, tree.typeSyntaxQuestionTokenIndexes, typeNodeIndex)
        let rootKind = parserReceiptArenaI32(
            tree, tree.typeSyntaxRootKinds, typeNodeIndex)
        let enumVariantStart = parserReceiptArenaI32(
            tree, tree.typeSyntaxEnumVariantStarts, typeNodeIndex)
        let enumVariantCount = parserReceiptArenaI32(
            tree, tree.typeSyntaxEnumVariantCounts, typeNodeIndex)
        if tree.producerSourceCount != 1 ||
           kind <= 0 || producerSourceIndex != 0 ||
           sourceLocalRow != typeNodeIndex ||
           spanId < 0 || ownerToken < 0 ||
           ownerToken >= tree.tokenCount ||
           declarationOwnerToken < -1 ||
           declarationOwnerToken >= tree.tokenCount ||
           declarationOwner < -1 ||
           declarationOwner >= tree.typeSyntaxCount ||
           genericSymbolStart < -1 || genericSymbolCount < 0 ||
           (genericSymbolCount == 0) != (genericSymbolStart == -1) ||
           (genericSymbolCount > 0 &&
            genericSymbolStart >
                tree.typeGenericSymbolCount - genericSymbolCount) ||
           nameToken < -1 || nameToken >= tree.tokenCount ||
           childStart != typeChildCursor || childCount < 0 ||
           childStart + childCount > tree.typeSyntaxChildCount ||
           bracketArgStart != typeBracketArgCursor || bracketArgCount < 0 ||
           bracketArgStart + bracketArgCount >
               tree.typeSyntaxBracketArgCount ||
           (enumVariantCount == 0) != (enumVariantStart == -1) ||
           (enumVariantCount > 0 &&
            (enumVariantStart != typeEnumVariantCursor ||
             enumVariantStart + enumVariantCount >
                 tree.typeEnumVariantCount)) ||
           fixedLength < -1 || questionToken < -1 ||
           questionToken >= tree.tokenCount || rootKind < 0:
            err = " compiler parser receipt: type syntax row invalid"
            return false
        add(out.typeSyntaxSourceIds, sourceIndex)
        add(out.typeSyntaxProducerSourceIds, sourceIndex)
        add(out.typeSyntaxSourceLocalRows, sourceLocalRow)
        add(out.typeSyntaxKinds, kind)
        add(out.typeSyntaxSpanIds, spanId)
        add(out.typeSyntaxOwnerTokenIds, ownerToken)
        add(out.typeSyntaxDeclarationOwnerTokenIds,
            declarationOwnerToken)
        add(out.typeSyntaxDeclarationOwnerIds, declarationOwner)
        add(out.typeSyntaxGenericSymbolStarts, genericSymbolStart)
        add(out.typeSyntaxGenericSymbolCounts, genericSymbolCount)
        add(out.typeSyntaxChildStarts, typeChildCursor)
        add(out.typeSyntaxChildCounts, childCount)
        add(out.typeSyntaxBracketArgStarts, typeBracketArgCursor)
        add(out.typeSyntaxBracketArgCounts, bracketArgCount)
        add(out.typeSyntaxNameTokenIds, nameToken)
        add(out.typeSyntaxFixedLengths, fixedLength)
        add(out.typeSyntaxQuestionTokenIds, questionToken)
        add(out.typeSyntaxRootKinds, rootKind)
        add(out.typeSyntaxEnumVariantStarts,
            enumVariantCount == 0 ? -1 : typeEnumVariantCursor)
        add(out.typeSyntaxEnumVariantCounts, enumVariantCount)
        for childOffset in 0..<childCount:
            let child = parserReceiptArenaI32(
                tree,
                tree.typeSyntaxChildNodeIndexes,
                childStart + childOffset)
            if child < 0 || child >= typeNodeIndex:
                err = " compiler parser receipt: type syntax child is not postorder"
                return false
            add(out.typeSyntaxChildIds, child)
            typeChildCursor = typeChildCursor + 1
        for argOffset in 0..<bracketArgCount:
            let argRow = bracketArgStart + argOffset
            let tokenStart = parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgTokenStarts, argRow)
            let tokenCount = parserReceiptArenaI32(
                tree, tree.typeSyntaxBracketArgTokenCounts, argRow)
            let typeNode = parserReceiptArenaI32(
                tree,
                tree.typeSyntaxBracketArgTypeNodeIndexes,
                argRow)
            let constRoot = parserReceiptArenaI32(
                tree,
                tree.typeSyntaxBracketArgConstExprRootIndexes,
                argRow)
            if tokenStart < 0 || tokenCount <= 0 ||
               tokenStart + tokenCount > tree.tokenCount || typeNode < -1 ||
               typeNode >= typeNodeIndex || constRoot < -1 ||
               constRoot >= tree.typeConstExprCount ||
               (typeNode >= 0) == (constRoot >= 0):
                err = " compiler parser receipt: bracket argument invalid"
                return false
            add(out.typeSyntaxBracketArgTokenStarts, tokenStart)
            add(out.typeSyntaxBracketArgTokenCounts, tokenCount)
            add(out.typeSyntaxBracketArgTypeIds, typeNode)
            add(out.typeSyntaxBracketArgConstExprRootIds, constRoot)
            typeBracketArgCursor = typeBracketArgCursor + 1
        typeEnumVariantCursor = typeEnumVariantCursor + enumVariantCount
    if typeEnumVariantCursor != tree.typeEnumVariantCount:
        err = " compiler parser receipt: enum variant CSR coverage invalid"
        return false
    for variantRow in 0..<tree.typeEnumVariantCount:
        let producerSourceIndex = parserReceiptArenaI32(
            tree,
            tree.typeEnumVariantProducerSourceIndexes,
            variantRow)
        let declarationOwner = parserReceiptArenaI32(
            tree,
            tree.typeEnumVariantDeclarationOwnerNodeIndexes,
            variantRow)
        let declarationOwnerToken = parserReceiptArenaI32(
            tree,
            tree.typeEnumVariantDeclarationOwnerTokenIndexes,
            variantRow)
        let nameToken = parserReceiptArenaI32(
            tree, tree.typeEnumVariantNameTokenIndexes, variantRow)
        let ordinal = parserReceiptArenaI32(
            tree, tree.typeEnumVariantOrdinals, variantRow)
        let payloadTypeSyntaxNode = parserReceiptArenaI32(
            tree,
            tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
            variantRow)
        if producerSourceIndex != 0 || declarationOwner < 0 ||
           declarationOwner >= tree.typeSyntaxCount ||
           declarationOwnerToken < 0 ||
           declarationOwnerToken >= tree.tokenCount || nameToken < 0 ||
           nameToken >= tree.tokenCount || ordinal < 0 ||
           payloadTypeSyntaxNode < -1 ||
           payloadTypeSyntaxNode >= tree.typeSyntaxCount:
            err = " compiler parser receipt: enum variant row invalid"
            return false
        add(out.typeEnumVariantProducerSourceIds, sourceIndex)
        add(out.typeEnumVariantDeclarationOwnerIds, declarationOwner)
        add(out.typeEnumVariantDeclarationOwnerTokenIds,
            declarationOwnerToken)
        add(out.typeEnumVariantNameTokenIds, nameToken)
        add(out.typeEnumVariantOrdinals, ordinal)
        add(out.typeEnumVariantPayloadTypeSyntaxIds,
            payloadTypeSyntaxNode)
    var typeGenericChildCursor: int32
    for symbolIndex in 0..<tree.typeGenericSymbolCount:
        let producerSourceIndex = parserReceiptArenaI32(
            tree,
            tree.typeGenericSymbolProducerSourceIndexes,
            symbolIndex)
        let declarationOwnerToken = parserReceiptArenaI32(
            tree,
            tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
            symbolIndex)
        let nameToken = parserReceiptArenaI32(
            tree,
            tree.typeGenericSymbolNameTokenIndexes,
            symbolIndex)
        let ordinal = parserReceiptArenaI32(
            tree, tree.typeGenericSymbolOrdinals, symbolIndex)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolSpanStarts, symbolIndex),
            parserReceiptArenaI32(
                tree, tree.typeGenericSymbolSpanEnds, symbolIndex),
            err)
        let ownerTypeSyntax = parserReceiptArenaI32(
            tree,
            tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
            symbolIndex)
        let ownerDeclaration = parserReceiptArenaI32(
            tree,
            tree.typeGenericSymbolOwnerDeclarationRows,
            symbolIndex)
        let constraintTypeSyntax = parserReceiptArenaI32(
            tree,
            tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
            symbolIndex)
        let defaultTypeSyntax = parserReceiptArenaI32(
            tree,
            tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
            symbolIndex)
        let childStart = parserReceiptArenaI32(
            tree, tree.typeGenericSymbolChildStarts, symbolIndex)
        let childCount = parserReceiptArenaI32(
            tree, tree.typeGenericSymbolChildCounts, symbolIndex)
        let expectedChildCount =
            (constraintTypeSyntax >= 0 ? 1 : 0) +
            (defaultTypeSyntax >= 0 ? 1 : 0)
        if tree.producerSourceCount != 1 || producerSourceIndex != 0 ||
           declarationOwnerToken < 0 ||
           declarationOwnerToken >= tree.tokenCount ||
           nameToken < 0 || nameToken >= tree.tokenCount || ordinal < 0 ||
           spanId < 0 || ownerDeclaration < 0 ||
           ownerDeclaration >= tree.declarationCount ||
           ownerTypeSyntax < -1 ||
           ownerTypeSyntax >= tree.typeSyntaxCount ||
           constraintTypeSyntax < -1 ||
           constraintTypeSyntax >= tree.typeSyntaxCount ||
           defaultTypeSyntax < -1 ||
           defaultTypeSyntax >= tree.typeSyntaxCount ||
           childStart != typeGenericChildCursor ||
           childCount != expectedChildCount ||
           childStart + childCount > tree.typeGenericSymbolChildCount:
            err = Fmt" compiler parser receipt: generic symbol row invalid row={symbolIndex} producer={producerSourceIndex} ownerToken={declarationOwnerToken} nameToken={nameToken} ordinal={ordinal} spanId={spanId} ownerType={ownerTypeSyntax} constraint={constraintTypeSyntax} default={defaultTypeSyntax} childStart={childStart} childCount={childCount} expectedChildren={expectedChildCount} childCursor={typeGenericChildCursor} treeChildren={tree.typeGenericSymbolChildCount}"
            return false
        add(out.typeGenericSymbolProducerSourceIds, sourceIndex)
        add(out.typeGenericSymbolDeclarationOwnerTokenIds,
            declarationOwnerToken)
        add(out.typeGenericSymbolNameTokenIds, nameToken)
        add(out.typeGenericSymbolOrdinals, ordinal)
        add(out.typeGenericSymbolSpanIds, spanId)
        add(out.typeGenericSymbolOwnerDeclarationIds, ownerDeclaration)
        add(out.typeGenericSymbolOwnerTypeSyntaxIds, ownerTypeSyntax)
        add(out.typeGenericSymbolConstraintTypeSyntaxIds,
            constraintTypeSyntax)
        add(out.typeGenericSymbolDefaultTypeSyntaxIds,
            defaultTypeSyntax)
        add(out.typeGenericSymbolChildStarts, typeGenericChildCursor)
        add(out.typeGenericSymbolChildCounts, childCount)
        for childOffset in 0..<childCount:
            let child = parserReceiptArenaI32(
                tree,
                tree.typeGenericSymbolChildTypeSyntaxNodeIndexes,
                childStart + childOffset)
            let expectedChild =
                childOffset == 0 && constraintTypeSyntax >= 0 ?
                    constraintTypeSyntax : defaultTypeSyntax
            if child != expectedChild:
                err = " compiler parser receipt: generic symbol child invalid"
                return false
            add(out.typeGenericSymbolChildTypeSyntaxIds, child)
            typeGenericChildCursor = typeGenericChildCursor + 1
    if typeGenericChildCursor != tree.typeGenericSymbolChildCount:
        err = " compiler parser receipt: generic symbol child coverage mismatch"
        return false
    if typeChildCursor != tree.typeSyntaxChildCount ||
       typeBracketArgCursor != tree.typeSyntaxBracketArgCount:
        err = " compiler parser receipt: type syntax CSR coverage mismatch"
        return false
    for declarationRow in 0..<tree.declarationCount:
        let producerSourceIndex = parserReceiptArenaI32(
            tree,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree, tree.declarationSpanStarts, declarationRow),
            parserReceiptArenaI32(
                tree, tree.declarationSpanEnds, declarationRow),
            err)
        let nameSpanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree, tree.declarationNameSpanStarts, declarationRow),
            parserReceiptArenaI32(
                tree, tree.declarationNameSpanEnds, declarationRow),
            err)
        if tree.producerSourceCount != 1 || producerSourceIndex != 0 ||
           spanId < 0 || nameSpanId < 0:
            err = " compiler parser receipt: declaration mapping failed"
            return false
        add(out.declarationProducerSourceIds, sourceIndex)
        add(out.declarationSourceLocalRows,
            parserReceiptArenaI32(
                tree, tree.declarationSourceLocalRows, declarationRow))
        add(out.declarationKinds,
            parserReceiptArenaI32(
                tree, tree.declarationKinds, declarationRow))
        add(out.declarationNameTokenIds,
            parserReceiptArenaI32(
                tree, tree.declarationNameTokenIndexes, declarationRow))
        add(out.declarationOwnerIds,
            parserReceiptArenaI32(
                tree, tree.declarationOwnerRows, declarationRow))
        add(out.declarationLexicalScopeIds,
            parserReceiptArenaI32(
                tree, tree.declarationLexicalScopeRows, declarationRow))
        add(out.declarationFunctionRows,
            parserReceiptArenaI32(
                tree, tree.declarationFunctionRows, declarationRow))
        add(out.declarationTypeSyntaxRootIds,
            parserReceiptArenaI32(
                tree,
                tree.declarationTypeSyntaxRootIndexes,
                declarationRow))
        add(out.declarationDefaultStatementRootRows,
            parserReceiptArenaI32(
                tree,
                tree.declarationDefaultStatementRootRows,
                declarationRow))
        add(out.declarationGenericSymbolStarts,
            parserReceiptArenaI32(
                tree,
                tree.declarationGenericSymbolStarts,
                declarationRow))
        add(out.declarationGenericSymbolCounts,
            parserReceiptArenaI32(
                tree,
                tree.declarationGenericSymbolCounts,
                declarationRow))
        add(out.declarationSuiteLexicalScopeIds,
            parserReceiptArenaI32(
                tree,
                tree.declarationSuiteLexicalScopeRows,
                declarationRow))
        add(out.declarationSpanIds, spanId)
        add(out.declarationNameSpanIds, nameSpanId)
        add(out.declarationMutableFlags,
            parserReceiptArenaI32(
                tree, tree.declarationMutableFlags, declarationRow) != 0)
        add(out.declarationExportedFlags,
            parserReceiptArenaI32(
                tree, tree.declarationExportedFlags, declarationRow) != 0)
    for patternRow in 0..<tree.patternCount:
        let typeSyntaxRoot = parserReceiptArenaI32(
            tree, tree.patternTypeSyntaxRootIndexes, patternRow)
        let ownerKind = parserReceiptArenaI32(
            tree, tree.patternOwnerKinds, patternRow)
        var ownerRow = parserReceiptArenaI32(
            tree, tree.patternOwnerRows, patternRow)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(tree, tree.patternSpanStarts, patternRow),
            parserReceiptArenaI32(tree, tree.patternSpanEnds, patternRow),
            err)
        if spanId < 0 || typeSyntaxRoot < -1 ||
           typeSyntaxRoot >= tree.typeSyntaxCount ||
           ownerKind < Int32(parser.ParserPatternOwnerInvalid) ||
           ownerKind > Int32(parser.ParserPatternOwnerValueNode) ||
           (ownerKind == Int32(parser.ParserPatternOwnerInvalid) &&
            ownerRow != -1) ||
           (ownerKind == Int32(parser.ParserPatternOwnerRegion) &&
            (ownerRow < 0 || ownerRow >= tree.regionCount)) ||
           (ownerKind == Int32(parser.ParserPatternOwnerValueNode) &&
            (ownerRow < 0 || ownerRow >= tree.nodeCount ||
             oldToNew[ownerRow] < 0)):
            err = " compiler parser receipt: pattern span mapping failed"
            return false
        if ownerKind == Int32(parser.ParserPatternOwnerValueNode):
            ownerRow = oldToNew[ownerRow]
        add(out.patternProducerSourceIds, sourceIndex)
        add(out.patternSourceLocalRows,
            parserReceiptArenaI32(
                tree, tree.patternSourceLocalRows, patternRow))
        add(out.patternKinds,
            parserReceiptArenaI32(tree, tree.patternKinds, patternRow))
        add(out.patternNameTokenIds,
            parserReceiptArenaI32(
                tree, tree.patternNameTokenIndexes, patternRow))
        add(out.patternOwnerLexicalScopeIds,
            parserReceiptArenaI32(
                tree, tree.patternOwnerLexicalScopeRows, patternRow))
        add(out.patternOwnerKinds, ownerKind)
        add(out.patternOwnerRows, ownerRow)
        add(out.patternBindingDeclarationIds,
            parserReceiptArenaI32(
                tree, tree.patternBindingDeclarationRows, patternRow))
        add(out.patternTypeSyntaxRootIds, typeSyntaxRoot)
        add(out.patternSpanIds, spanId)
        add(out.patternChildStarts,
            parserReceiptArenaI32(
                tree, tree.patternChildStarts, patternRow))
        add(out.patternChildCounts,
            parserReceiptArenaI32(
                tree, tree.patternChildCounts, patternRow))
    for childRow in 0..<tree.patternChildCount:
        add(out.patternChildIds,
            parserReceiptArenaI32(
                tree, tree.patternChildNodeIndexes, childRow))
    for annotationRow in 0..<tree.annotationCount:
        let annotationSpanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree, tree.annotationSpanStarts, annotationRow),
            parserReceiptArenaI32(
                tree, tree.annotationSpanEnds, annotationRow),
            err)
        if annotationSpanId < 0:
            err = " compiler parser receipt: annotation span mapping failed"
            return false
        add(out.annotationProducerSourceIds, sourceIndex)
        add(out.annotationSourceLocalRows,
            parserReceiptArenaI32(
                tree, tree.annotationSourceLocalRows, annotationRow))
        add(out.annotationNameTokenIds,
            parserReceiptArenaI32(
                tree, tree.annotationNameTokenIndexes, annotationRow))
        add(out.annotationTargetTokenIds,
            parserReceiptArenaI32(
                tree, tree.annotationTargetTokenIndexes, annotationRow))
        add(out.annotationSpanIds, annotationSpanId)
        add(out.annotationArgRootStarts,
            parserReceiptArenaI32(
                tree, tree.annotationArgRootStarts, annotationRow))
        add(out.annotationArgRootCounts,
            parserReceiptArenaI32(
                tree, tree.annotationArgRootCounts, annotationRow))
    for rootRow in 0..<tree.annotationArgRootCount:
        add(out.annotationArgRootIds,
            parserReceiptArenaI32(
                tree, tree.annotationArgRootNodeIndexes, rootRow))
    for annotationArgRow in 0..<tree.annotationArgCount:
        let annotationArgSpanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree,
                tree.annotationArgSpanStarts,
                annotationArgRow),
            parserReceiptArenaI32(
                tree,
                tree.annotationArgSpanEnds,
                annotationArgRow),
            err)
        if annotationArgSpanId < 0:
            err = " compiler parser receipt: annotation arg span mapping failed"
            return false
        add(out.annotationArgProducerSourceIds, sourceIndex)
        add(out.annotationArgSourceLocalRows,
            parserReceiptArenaI32(
                tree,
                tree.annotationArgSourceLocalRows,
                annotationArgRow))
        add(out.annotationArgOwnerIds,
            parserReceiptArenaI32(
                tree, tree.annotationArgOwnerRows, annotationArgRow))
        add(out.annotationArgKinds,
            parserReceiptArenaI32(
                tree, tree.annotationArgKinds, annotationArgRow))
        add(out.annotationArgTokenIds,
            parserReceiptArenaI32(
                tree, tree.annotationArgTokenIndexes, annotationArgRow))
        add(out.annotationArgSeparatorTokenIds,
            parserReceiptArenaI32(
                tree,
                tree.annotationArgSeparatorTokenIndexes,
                annotationArgRow))
        add(out.annotationArgSpanIds, annotationArgSpanId)
        add(out.annotationArgChildStarts,
            parserReceiptArenaI32(
                tree, tree.annotationArgChildStarts, annotationArgRow))
        add(out.annotationArgChildCounts,
            parserReceiptArenaI32(
                tree, tree.annotationArgChildCounts, annotationArgRow))
    for childRow in 0..<tree.annotationArgChildCount:
        add(out.annotationArgChildIds,
            parserReceiptArenaI32(
                tree, tree.annotationArgChildNodeIndexes, childRow))
    for genericIndex in 0..<tree.genericCount:
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(
                tree, tree.explicitGenericSpanStarts, genericIndex),
            parserReceiptArenaI32(
                tree, tree.explicitGenericSpanEnds, genericIndex),
            err)
        if spanId < 0:
            err = " compiler parser receipt: generic span mapping failed"
            return false
        add(out.genericSpanIds, spanId)
    for regionIndex in 0..<tree.regionCount:
        let kind = parserReceiptArenaI32(tree, tree.regionKinds, regionIndex)
        let spanId = parserCanonicalSourceSpanFind(
            canonicalSpans,
            coordinateMap,
            sourceText,
            parserInputText,
            parserReceiptArenaI32(tree, tree.regionSpanStarts, regionIndex),
            parserReceiptArenaI32(tree, tree.regionSpanEnds, regionIndex),
            err)
        let anchorToken = parserReceiptArenaI32(
            tree, tree.regionAnchorTokenIndexes, regionIndex)
        if kind <= 0 || spanId < 0 || anchorToken < 0 ||
           anchorToken >= tree.tokenCount:
            err = " compiler parser receipt: region mapping failed"
            return false
        add(out.regionKinds, kind)
        add(out.regionSpanIds, spanId)
        add(out.regionAnchorTokenIds, anchorToken)
    for index in 0..<tree.rootCount:
        let mapped = oldToNew[parserReceiptArenaI32(
            tree, tree.rootNodeIndexes, index)]
        if mapped < 0:
            err = " compiler parser receipt: root remap failed"
            return false
        add(out.rootNodeIds, mapped)
    for index in 0..<tree.callEventCount:
        let mapped = oldToNew[parserReceiptArenaI32(
            tree, tree.callEventNodeIndexes, index)]
        if mapped < 0:
            err = " compiler parser receipt: call event remap failed"
            return false
        add(out.callEventNodeIds, mapped)
    for index in 0..<tree.statementRootCount:
        let mapped = oldToNew[parserReceiptArenaI32(
            tree, tree.statementRootNodeIndexes, index)]
        let role = parserReceiptArenaI32(tree, tree.statementRootRoles, index)
        let anchorToken = parserReceiptArenaI32(
            tree, tree.statementRootAnchorTokenIndexes, index)
        let bindingDeclarationStart = parserReceiptArenaI32(
            tree,
            tree.statementRootBindingDeclarationStarts,
            index)
        let bindingDeclarationCount = parserReceiptArenaI32(
            tree,
            tree.statementRootBindingDeclarationCounts,
            index)
        let anchorLine = parserReceiptArenaI32(
            tree, tree.statementRootAnchorLineNumbers, index) - 1
        let anchorColumn = parserReceiptArenaI32(
            tree, tree.statementRootAnchorColumnNumbers, index) - 1
        let endLine = parserReceiptArenaI32(
            tree, tree.statementRootEndLineNumbers, index) - 1
        let endColumn = parserReceiptArenaI32(
            tree, tree.statementRootEndColumnNumbers, index)
        if mapped < 0 || role <= 0 || anchorToken < 0 ||
           anchorToken >= tree.tokenCount ||
           bindingDeclarationStart < -1 || bindingDeclarationCount < 0 ||
           (bindingDeclarationStart < 0 && bindingDeclarationCount != 0) ||
           (bindingDeclarationStart >= 0 &&
            (bindingDeclarationStart > tree.declarationCount ||
             bindingDeclarationCount >
                 tree.declarationCount - bindingDeclarationStart)) ||
           anchorLine < 0 || anchorColumn < 0 ||
           endLine < anchorLine || endColumn < 0:
            err = " compiler parser receipt: statement root mapping failed"
            return false
        add(out.statementRootNodeIds, mapped)
        add(out.statementRootRoles, role)
        add(out.statementRootAnchorTokenIds, anchorToken)
        add(out.statementRootBindingDeclarationStarts,
            bindingDeclarationStart)
        add(out.statementRootBindingDeclarationCounts,
            bindingDeclarationCount)
        add(out.statementRootAnchorLines, anchorLine)
        add(out.statementRootAnchorColumns, anchorColumn)
        add(out.statementRootEndLines, endLine)
        add(out.statementRootEndColumns, endColumn)
    for functionIndex in 0..<functionSpans.len:
        let functionSpan = functionSpans[functionIndex]
        let declarationSpanId = parserCanonicalSpanFind(
            canonicalSpans,
            functionSpan.declarationStartByte,
            functionSpan.declarationEndByte)
        let headerSpanId = parserCanonicalSpanFind(
            canonicalSpans,
            functionSpan.headerStartByte,
            functionSpan.headerEndByte)
        let nameSpanId = parserCanonicalSpanFind(
            canonicalSpans,
            functionSpan.nameStartByte,
            functionSpan.nameEndByte)
        let bodySpanId = parserCanonicalSpanFind(
            canonicalSpans,
            functionSpan.bodyStartByte,
            functionSpan.bodyEndByte)
        if declarationSpanId < 0 || headerSpanId < 0 ||
           nameSpanId < 0 || bodySpanId < 0:
            err = " compiler parser receipt: function canonical span missing"
            return false
        let manualConsumePresent =
            (functionSpan.annotationFlags &
             parser.ParserFunctionAnnotationManualConsume) != 0
        var exactFunctionDeclarationRow: int32 = -1
        for declarationRow in 0..<out.declarationKinds.len:
            if out.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction) ||
               out.declarationSpanIds[declarationRow] !=
                   declarationSpanId ||
               out.declarationNameSpanIds[declarationRow] != nameSpanId:
                continue
            if exactFunctionDeclarationRow >= 0:
                err = " compiler parser receipt: function declaration bridge ambiguous"
                return false
            exactFunctionDeclarationRow = declarationRow
        if exactFunctionDeclarationRow < 0 ||
           (manualConsumePresent &&
            functionSpan.manualConsumeFunctionDeclarationSourceLocalRow !=
                exactFunctionDeclarationRow) ||
           (!manualConsumePresent &&
            functionSpan.manualConsumeFunctionDeclarationSourceLocalRow !=
                -1):
            err = " compiler parser receipt: manual consume function identity drift"
            return false
        var headerCid: layout.FixedBytes32
        if !parserDeclarationHeaderCidInto(
               out, headerSpanId, nameSpanId, headerCid, err):
            return false
        var nameSurfaceKind: int32
        var nameProofCid: layout.FixedBytes32
        if !parserFunctionNameSurfaceProofInto(
               out,
               nameSpanId,
               functionSpan.functionName,
               nameSurfaceKind,
               nameProofCid,
               err):
            return false
        add(out.functionIndexes, functionSpan.functionIndex)
        add(out.functionNames, share(functionSpan.functionName))
        add(out.functionSignatureLineNumbers,
            functionSpan.signatureLineNumber)
        add(out.functionDeclarationSpanIds, declarationSpanId)
        add(out.functionDeclarationHeaderSpanIds, headerSpanId)
        add(out.functionDeclarationOrdinals,
            functionSpan.declarationOrdinal)
        add(out.functionDeclarationHeaderCids, headerCid)
        add(out.functionDeclarationPathCids,
            parserDeclarationPathCid(functionSpan.declarationOrdinal))
        add(out.functionNameSpanIds, nameSpanId)
        add(out.functionNameSurfaceKinds, nameSurfaceKind)
        add(out.functionNameProofCids, nameProofCid)
        add(out.functionBodySpanIds, bodySpanId)
        add(out.functionAnnotationFlags,
            functionSpan.annotationFlags)
        add(out.functionManualConsumeTargetParameterOrdinals,
            functionSpan.manualConsumeTargetParameterOrdinal)
        add(
            out.functionManualConsumeTargetParameterDeclarationSourceLocalRows,
            functionSpan.manualConsumeTargetParameterDeclarationSourceLocalRow)
        add(out.functionManualConsumeSourceParameterOrdinals,
            functionSpan.manualConsumeSourceParameterOrdinal)
        add(
            out.functionManualConsumeSourceParameterDeclarationSourceLocalRows,
            functionSpan.manualConsumeSourceParameterDeclarationSourceLocalRow)
    return ParserCanonicalSourceSidecarSealInto(out, err)

@borrows
fn ParserCanonicalSourceSidecarBuildInto(
        sourceIndex: int32,
        sourceText: str,
        parserInputText: str,
        tree: parser.ParserValueExprTree,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        out: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    var coordinateMap: parser.ParserSourceRewriteCoordinateMap
    if !parser.ParserSourceRewriteCoordinateMapBuildInto(
           sourceText, parserInputText, coordinateMap, err):
        return false
    return parserCanonicalSourceSidecarBuildMappedInto(
        sourceIndex,
        sourceText,
        parserInputText,
        tree,
        coordinateMap,
        -1,
        -1,
        identities,
        declarations,
        true,
        out,
        err)

fn ParserCanonicalSourceFailureSidecarBuildInto(
        sourceIndex: int32,
        sourceText: str,
        parserInputText: str,
        tree: parser.ParserValueExprTree,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        artifact: var diagnostic_failure.DiagnosticFailureArtifact,
        out: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    if artifact.producerKinds.len != 1 ||
       artifact.producerSourceIndexes[0] != 0 ||
       !diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
           artifact, err):
        if err == "":
            err = " compiler parser receipt: failure artifact identity split"
        return false
    var coordinateMap: parser.ParserSourceRewriteCoordinateMap
    if !parser.ParserSourceRewriteCoordinateMapBuildInto(
           sourceText, parserInputText, coordinateMap, err):
        return false
    var originalStartByte: int32
    var originalEndByte: int32
    if !parser.ParserDiagnosticFailureAnchorSpanToOriginalInto(
           artifact.anchorKinds[0],
           coordinateMap,
           sourceText,
           parserInputText,
           artifact.spanStartBytes[0],
           artifact.spanEndBytes[0],
           originalStartByte,
           originalEndByte,
           err):
        return false
    if !parser.ParserValueExprTreeFailureAuthorityLeaseBegin(tree):
        err = " compiler parser receipt: failure tree authority unavailable"
        return false
    let built = parserCanonicalSourceSidecarBuildMappedInto(
        sourceIndex,
        sourceText,
        parserInputText,
        share(tree),
        coordinateMap,
        originalStartByte,
        originalEndByte,
        identities,
        declarations,
        true,
        out,
        err)
    parser.ParserValueExprTreeFailureAuthorityLeaseEnd(tree)
    if !built:
        return false
    var parserAnchorKind = ParserDiagnosticAnchorSpan
    if artifact.anchorKinds[0] ==
           diagnostic_failure.DiagnosticFailureAnchorParserNode:
        parserAnchorKind = ParserDiagnosticAnchorParserNode
    elif artifact.anchorKinds[0] ==
             diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration:
        parserAnchorKind = ParserDiagnosticAnchorOwnerDeclaration
    elif artifact.anchorKinds[0] ==
             diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration:
        parserAnchorKind =
            ParserDiagnosticAnchorParserNodeOwnerDeclaration
    var canonicalNodeId: int32 = -1
    if artifact.parserNodeIds[0] >= 0:
        for nodeId in 0..<out.nodeProducerIds.len:
            if out.nodeProducerIds[nodeId] == artifact.parserNodeIds[0]:
                if canonicalNodeId >= 0:
                    err = " compiler parser receipt: failure parser node duplicated"
                    return false
                canonicalNodeId = nodeId
        if canonicalNodeId < 0:
            err = " compiler parser receipt: failure parser node missing"
            return false
    var spanId: int32 = -1
    for candidateSpanId in 0..<out.spanStartBytes.len:
        if out.spanStartBytes[candidateSpanId] == originalStartByte &&
           out.spanEndBytes[candidateSpanId] == originalEndByte:
            if spanId >= 0:
                err = " compiler parser receipt: failure span duplicated"
                return false
            spanId = candidateSpanId
    if spanId < 0 ||
       !ParserCanonicalSourceSidecarDiagnosticAppendInto(
           out,
           parserAnchorKind,
           canonicalNodeId,
           artifact.ownerDeclarationSourceLocalRows[0],
           spanId,
           ParserDiagnosticSeverityError,
           artifact.codes[0],
           artifact.messages[0],
           err) ||
       !ParserCanonicalSourceSidecarSealInto(out, err) ||
       !ParserCanonicalSourceSidecarStrictValidateInto(out, err):
        if err == "":
            err = " compiler parser receipt: failure authority invalid"
        return false
    return true

@borrows
fn ParserDiagnosticFailureAuthorityBuildInto(
        sourceIndex: int32,
        sourceText: str,
        parserInputText: str,
        tree: parser.ParserValueExprTree,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        artifact: var diagnostic_failure.DiagnosticFailureArtifact,
        authorityOut:
            var diagnostic_authority.ParserDiagnosticAuthority,
        producerProjectionCidsOut: var layout.FixedBytes32[],
        sidecarOut: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    authorityOut = diagnostic_authority.ParserDiagnosticAuthority()
    producerProjectionCidsOut = []
    sidecarOut = new(ParserCanonicalSourceSidecar)
    if artifact.producerKinds.len != 1 ||
       artifact.producerSourceIndexes[0] != 0 ||
       sourceIndex < 0 ||
       !diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
           artifact, err):
        if err == "":
            err = " compiler parser receipt: diagnostic authority input split"
        return false
    let anchorKind = artifact.anchorKinds[0]
    let needsCanonicalSidecar =
        anchorKind ==
            diagnostic_failure.DiagnosticFailureAnchorParserNode ||
        anchorKind ==
            diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration ||
        anchorKind ==
            diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration
    if !needsCanonicalSidecar:
        err = " compiler parser receipt: non-structural diagnostic has no parser authority"
        return false
    if !ParserCanonicalSourceFailureSidecarBuildInto(
           sourceIndex,
           share(sourceText),
           share(parserInputText),
           share(tree),
           share(identities),
           share(declarations),
           artifact,
           sidecarOut,
           err):
        return false
    var coordinateMap: parser.ParserSourceRewriteCoordinateMap
    var originalStartByte: int32
    var originalEndByte: int32
    if !parser.ParserSourceRewriteCoordinateMapBuildInto(
           sourceText, parserInputText, coordinateMap, err) ||
       !parser.ParserDiagnosticFailureAnchorSpanToOriginalInto(
           anchorKind,
           coordinateMap,
           sourceText,
           parserInputText,
           artifact.spanStartBytes[0],
           artifact.spanEndBytes[0],
           originalStartByte,
           originalEndByte,
           err):
        return false
    authorityOut.schemaVersion =
        diagnostic_authority.ParserDiagnosticAuthoritySchemaVersionLatest
    add(authorityOut.authorityKinds,
        diagnostic_authority.ParserDiagnosticAuthorityKindCanonicalSidecar)
    add(authorityOut.parserLocalProducerSourceRows, 0)
    add(authorityOut.portableProducerSourceIndexes, sourceIndex)
    add(authorityOut.producerSourceByteLengths, sourceText.len)
    add(authorityOut.producerContentCids,
        diagnostic_failure.DiagnosticFailureSourceContentCid(sourceText))
    add(authorityOut.parserInputCids,
        diagnostic_failure.DiagnosticFailureSourceContentCid(
            parserInputText))
    var authorityAnchorKind: int32
    if anchorKind ==
             diagnostic_failure.DiagnosticFailureAnchorParserNode:
        authorityAnchorKind =
            diagnostic_authority.ParserDiagnosticAuthorityAnchorParserNode
    elif anchorKind ==
             diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration:
        authorityAnchorKind =
            diagnostic_authority.ParserDiagnosticAuthorityAnchorOwnerDeclaration
    elif anchorKind ==
             diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration:
        authorityAnchorKind =
            diagnostic_authority.ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration
    else:
        err = " compiler parser receipt: unknown diagnostic authority anchor"
        return false
    if sidecarOut.diagnosticAnchorKinds.len != 1 ||
       sidecarOut.diagnosticAnchorKinds[0] != authorityAnchorKind:
        err = " compiler parser receipt: diagnostic anchor domain split"
        return false
    add(authorityOut.anchorKinds, authorityAnchorKind)
    var canonicalNodeRow: int32 = -1
    var producerNodeRow: int32 = -1
    var parserNodeKind: int32 = -1
    var parserNodeStartByte: int32 = -1
    var parserNodeEndByte: int32 = -1
    var ownerRow: int32 = -1
    var ownerKind: int32 = -1
    var ownerStartByte: int32 = -1
    var ownerEndByte: int32 = -1
    if sidecarOut.diagnosticAnchorNodeIds.len != 1 ||
       sidecarOut.diagnosticOwnerDeclarationSourceLocalRows.len != 1 ||
       sidecarOut.diagnosticSpanIds.len != 1 ||
       sidecarOut.diagnosticProofRaw32s.len != 1:
        err = " compiler parser receipt: diagnostic sidecar row split"
        return false
    canonicalNodeRow = sidecarOut.diagnosticAnchorNodeIds[0]
    ownerRow =
        sidecarOut.diagnosticOwnerDeclarationSourceLocalRows[0]
    if canonicalNodeRow >= 0:
        let nodeSpanId = sidecarOut.nodeSpanIds[canonicalNodeRow]
        producerNodeRow =
            sidecarOut.nodeProducerIds[canonicalNodeRow]
        parserNodeKind = sidecarOut.nodeKinds[canonicalNodeRow]
        parserNodeStartByte =
            sidecarOut.spanStartBytes[nodeSpanId]
        parserNodeEndByte =
            sidecarOut.spanEndBytes[nodeSpanId]
    if ownerRow >= 0:
        let ownerSpanId =
            sidecarOut.declarationSpanIds[ownerRow]
        ownerKind = sidecarOut.declarationKinds[ownerRow]
        ownerStartByte =
            sidecarOut.spanStartBytes[ownerSpanId]
        ownerEndByte =
            sidecarOut.spanEndBytes[ownerSpanId]
    add(authorityOut.sourceSidecarCids,
        sidecarOut.sidecarRaw32)
    add(authorityOut.diagnosticCompletionCids,
        sidecarOut.diagnosticCompletionRaw32)
    add(authorityOut.canonicalParserNodeRows, canonicalNodeRow)
    add(authorityOut.producerParserNodeRows, producerNodeRow)
    add(authorityOut.parserNodeKinds, parserNodeKind)
    add(authorityOut.parserNodeSpanStartBytes, parserNodeStartByte)
    add(authorityOut.parserNodeSpanEndBytes, parserNodeEndByte)
    add(authorityOut.ownerDeclarationSourceLocalRows, ownerRow)
    add(authorityOut.ownerDeclarationKinds, ownerKind)
    add(authorityOut.ownerDeclarationSpanStartBytes, ownerStartByte)
    add(authorityOut.ownerDeclarationSpanEndBytes, ownerEndByte)
    add(authorityOut.diagnosticSpanIds,
        sidecarOut.diagnosticSpanIds[0])
    add(authorityOut.diagnosticSpanStartBytes, originalStartByte)
    add(authorityOut.diagnosticSpanEndBytes, originalEndByte)
    if artifact.severities[0] !=
           diagnostic_failure.DiagnosticFailureSeverityError:
        err = " compiler parser receipt: unsupported diagnostic authority severity"
        return false
    add(authorityOut.severities,
        diagnostic_authority.ParserDiagnosticAuthoritySeverityError)
    add(authorityOut.codes, share(artifact.codes[0]))
    add(authorityOut.messages, share(artifact.messages[0]))
    let producerProjectionCid =
        sidecarOut.diagnosticProofRaw32s[0]
    let producerProjectionCidCopy =
        sidecarOut.diagnosticProofRaw32s[0]
    add(authorityOut.producerProjectionCids,
        producerProjectionCid)
    add(producerProjectionCidsOut, producerProjectionCidCopy)
    add(authorityOut.proofCids,
        diagnostic_authority.ParserDiagnosticAuthorityRowProofCid(
            authorityOut, 0))
    authorityOut.authorityRootCid =
        diagnostic_authority.ParserDiagnosticAuthorityRootCid(
            authorityOut)
    return diagnostic_authority.ParserDiagnosticAuthorityStrictValidateInto(
        authorityOut, producerProjectionCidsOut, err)

fn ParserCanonicalSourceSidecarBuildFromSourceInto(
        sourceIndex: int32,
        sourceText: str,
        migrationSourceSyntax: bool,
        identities: ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        out: var ParserCanonicalSourceSidecar,
        err: var str): bool =
    var parserInputText: str
    var coordinateMap: parser.ParserSourceRewriteCoordinateMap
    if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
           sourceText, parserInputText, coordinateMap, err):
        return false
    var tree: parser.ParserValueExprTree
    var treeRead = false
    if migrationSourceSyntax:
        treeRead = parser.ParserValueExprReadMigrationSourceTreeFromText(
            share(parserInputText), tree, err)
    else:
        treeRead = parser.ParserValueExprReadTreeFromText(
            share(parserInputText), tree, err)
    if !treeRead:
        parser.ParserValueExprTreeRelease(tree)
        return false
    let ok = parserCanonicalSourceSidecarBuildMappedInto(
        sourceIndex,
        sourceText,
        parserInputText,
        share(tree),
        coordinateMap,
        -1,
        -1,
        identities,
        declarations,
        false,
        out,
        err)
    parser.ParserValueExprTreeRelease(tree)
    return ok

@borrows
fn ParserCanonicalSourceSidecarClone(
        source: ParserCanonicalSourceSidecar): ParserCanonicalSourceSidecar =
    var out: ParserCanonicalSourceSidecar = new(ParserCanonicalSourceSidecar)
    out.importOrigins = new(ParserCanonicalImportOriginSoA)
    let sourceImportOrigins = source.importOrigins
    let outImportOrigins = out.importOrigins
    out.sourceIndex = source.sourceIndex
    out.sourceContentRaw32 = source.sourceContentRaw32
    out.parserInputRaw32 = source.parserInputRaw32
    out.diagnosticRowStart = source.diagnosticRowStart
    out.diagnosticRowCount = source.diagnosticRowCount
    out.diagnosticCompletionRaw32 =
        source.diagnosticCompletionRaw32
    for row in 0..<source.diagnosticAnchorNodeIds.len:
        add(out.diagnosticAnchorKinds,
            source.diagnosticAnchorKinds[row])
        add(out.diagnosticAnchorNodeIds,
            source.diagnosticAnchorNodeIds[row])
        add(out.diagnosticOwnerDeclarationSourceLocalRows,
            source.diagnosticOwnerDeclarationSourceLocalRows[row])
        add(out.diagnosticSpanIds, source.diagnosticSpanIds[row])
        add(out.diagnosticSeverities,
            source.diagnosticSeverities[row])
        add(out.diagnosticCodeTexts,
            parser.ParserOwnedText(source.diagnosticCodeTexts[row]))
        add(out.diagnosticMessageTexts,
            parser.ParserOwnedText(source.diagnosticMessageTexts[row]))
        add(out.diagnosticProofRaw32s,
            source.diagnosticProofRaw32s[row])
    for row in 0..<source.spanStartBytes.len:
        add(out.spanStartBytes, source.spanStartBytes[row])
        add(out.spanEndBytes, source.spanEndBytes[row])
        add(out.spanStartLines, source.spanStartLines[row])
        add(out.spanStartColumns, source.spanStartColumns[row])
        add(out.spanEndLines, source.spanEndLines[row])
        add(out.spanEndColumns, source.spanEndColumns[row])
    for row in 0..<source.nodeKinds.len:
        add(out.nodeProducerIds, source.nodeProducerIds[row])
        add(out.nodeParentIds, source.nodeParentIds[row])
        add(out.nodeKinds, source.nodeKinds[row])
        add(out.nodeSpanIds, source.nodeSpanIds[row])
        add(out.nodeChildStarts, source.nodeChildStarts[row])
        add(out.nodeChildCounts, source.nodeChildCounts[row])
        add(out.nodeGenericStarts, source.nodeGenericStarts[row])
        add(out.nodeGenericCounts, source.nodeGenericCounts[row])
        add(out.nodeBindingResolutionKinds,
            source.nodeBindingResolutionKinds[row])
        add(out.nodeBindingDeclarationSourceLocalRows,
            source.nodeBindingDeclarationSourceLocalRows[row])
        add(out.nodeBindingPatternSourceLocalRows,
            source.nodeBindingPatternSourceLocalRows[row])
    for row in 0..<source.nodeChildIds.len:
        add(out.nodeChildIds, source.nodeChildIds[row])
    for row in 0..<source.tokenKinds.len:
        add(out.tokenProducerSourceIds,
            source.tokenProducerSourceIds[row])
        add(out.tokenSourceLocalRows, source.tokenSourceLocalRows[row])
        add(out.tokenLexicalParentIds,
            source.tokenLexicalParentIds[row])
        add(out.tokenKinds, source.tokenKinds[row])
        add(out.tokenSpanIds, source.tokenSpanIds[row])
        add(out.tokenValues, parser.ParserOwnedText(source.tokenValues[row]))
    for row in 0..<sourceImportOrigins.importDeclarationSourceLocalRows.len:
        add(outImportOrigins.importDeclarationProducerSourceIds,
            sourceImportOrigins.importDeclarationProducerSourceIds[row])
        add(outImportOrigins.importDeclarationSourceLocalRows,
            sourceImportOrigins.importDeclarationSourceLocalRows[row])
        add(outImportOrigins.importDeclarationKeywordTokenIds,
            sourceImportOrigins.importDeclarationKeywordTokenIds[row])
        add(outImportOrigins.importDeclarationSpanIds,
            sourceImportOrigins.importDeclarationSpanIds[row])
        add(outImportOrigins.importDeclarationItemStarts,
            sourceImportOrigins.importDeclarationItemStarts[row])
        add(outImportOrigins.importDeclarationItemCounts,
            sourceImportOrigins.importDeclarationItemCounts[row])
    for row in 0..<sourceImportOrigins.importItemSourceLocalRows.len:
        add(outImportOrigins.importItemProducerSourceIds,
