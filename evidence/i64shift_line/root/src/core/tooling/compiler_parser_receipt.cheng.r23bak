        add(out.typeConstExprIntegerValues,
            source.typeConstExprIntegerValues[row])
        add(out.typeConstExprIdentityCids,
            source.typeConstExprIdentityCids[row])
    for row in 0..<source.typeGenericSymbolNameTokenIds.len:
        add(out.typeGenericSymbolProducerSourceIds,
            source.typeGenericSymbolProducerSourceIds[row])
        add(out.typeGenericSymbolDeclarationOwnerTokenIds,
            source.typeGenericSymbolDeclarationOwnerTokenIds[row])
        add(out.typeGenericSymbolNameTokenIds,
            source.typeGenericSymbolNameTokenIds[row])
        add(out.typeGenericSymbolOrdinals,
            source.typeGenericSymbolOrdinals[row])
        add(out.typeGenericSymbolSpanIds,
            source.typeGenericSymbolSpanIds[row])
        add(out.typeGenericSymbolOwnerDeclarationIds,
            source.typeGenericSymbolOwnerDeclarationIds[row])
        add(out.typeGenericSymbolOwnerTypeSyntaxIds,
