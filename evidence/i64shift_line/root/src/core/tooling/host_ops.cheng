import std/os
import std/os_host_process as hostos
import std/buffer
import std/rawbytes
import std/result
import std/strutils as strutil
import std/strings
import std/monotimes
import cheng/core/tooling/path as chengpath

@importc("getpid")
fn HostOpsGetPidBridge(): int32

@importc("cheng_native_process_group_rss_bytes_value_bridge")
fn HostOpsProcessGroupRssBytesBridge(pid: int64): int64

@importc("exit")
fn HostOpsExitBridge(code: int32)

type
    LoggedRun =
        label: str
        filePath: str
        logPath: str
        exitCode: int32
        output: str

    SpawnedProcess =
        label: str
        filePath: str
        readFd: int32
        writeFd: int32
        pid: int64
        output: str
        liveLogPath: str
        liveLogLen: int32

    ParallelJob =
        label: str
        logPath: str
        proc: SpawnedProcess

const
    ProcessSigTerm = 15
    ProcessSigKill = 9
    ProcessRunning = -2147483000
    ProcessMemoryExceeded = 125
    ProcessMemoryCheckIntervalNs = Int64(500000000)

@borrows
fn LoggedRunMake(label: str,
                   filePath: str,
                   logPath: str,
                   exitCode: int32,
                   output: str): LoggedRun =
    var out: LoggedRun
    out.label = share(label)
    out.filePath = share(filePath)
    out.logPath = share(logPath)
    out.exitCode = exitCode
    out.output = share(output)
    return out

@borrows
fn SpawnedProcessMake(label: str,
                        filePath: str,
                        readFd: int32,
                        writeFd: int32,
                        pid: int64,
                        output: str,
                        liveLogPath: str,
                        liveLogLen: int32): SpawnedProcess =
    var out: SpawnedProcess
    out.label = strings.CloneStr(label)
    out.filePath = strings.CloneStr(filePath)
    out.readFd = readFd
    out.writeFd = writeFd
    out.pid = pid
    out.output = strings.CloneStr(output)
    out.liveLogPath = strings.CloneStr(liveLogPath)
    out.liveLogLen = liveLogLen
    return out

@borrows
fn ParallelJobMake(label: str,
                     logPath: str,
                     proc: SpawnedProcess): ParallelJob =
    var out: ParallelJob
    out.label = strings.CloneStr(label)
    out.logPath = strings.CloneStr(logPath)
    out.proc = proc
    return out

@borrows
fn HostOpsMissingExecutableText(programName: str): str =
    return strutil.Join(["missing executable: ", share(programName), "\n"], "")

@borrows
fn HostOpsShellStatusEnabled(envOverrides: str[]): bool =
    var mode = strutil.Strip(HostOpsEnvOverrideValue(envOverrides, "CHENG_HOSTOPS_SHELL_STATUS"))
    if Len(mode) <= 0:
        mode = strutil.Strip(os.GetEnv("CHENG_HOSTOPS_SHELL_STATUS"))
    return Len(mode) > 0 && mode != "0" && mode != "false"

fn HostOpsCommandText(filePath: str,
                       argv: str[],
                       envOverrides: str[]): str =
    var parts: str[]
    if envOverrides.len > 0:
        add(parts, "env")
        for i in 0..<envOverrides.len:
            let envText = envOverrides[i]
            if Len(envText) > 0:
                add(parts, os.QuoteShell(envText))
    if Len(filePath) > 0:
        add(parts, os.QuoteShell(filePath))
    for i in 0..<argv.len:
        add(parts, os.QuoteShell(argv[i]))
    return strutil.Join(parts, " ")

@borrows
fn HostOpsSpawnMissingText(filePath: str,
                            spawnRes: os.ExecFilePipeSpawnResult,
                            liveProgress: bool,
                            maxRssBytes: int64): str =
    var okText = "0"
    if spawnRes.ok:
        okText = "1"
    var liveText = "0"
    if liveProgress:
        liveText = "1"
    return strutil.Join([
        "spawn pid missing: ",
        share(filePath),
        "\nspawn_ok=",
        okText,
        "\nspawn_read_fd=",
        strings.IntToStr(spawnRes.readFd),
        "\nspawn_write_fd=",
        strings.IntToStr(spawnRes.writeFd),
        "\nspawn_pid=",
        strings.Int64ToStr(spawnRes.pid),
        "\nspawn_live_progress=",
        liveText,
        "\nspawn_max_rss_bytes=",
        strings.Int64ToStr(maxRssBytes),
        "\n"
    ], "")

@borrows
fn ExecFileDirect(filePath: str, argv: str[], envOverrides: str[],
                    workingDir: str, timeoutSec: int32,
                    capturePreferred: bool): os.ExecCmdResult =
    let _ = capturePreferred
    return hostos.ExecFileCapture(filePath, argv, envOverrides, workingDir, true, timeoutSec)

@borrows
fn ResolveProgram(root: str, nameRaw: str): str =
    let name: str = strutil.Strip(nameRaw)
    if Len(name) <= 0:
        return ""
    if strutil.Contains(name, "/"):
        let absolute: str = chengpath.PathAbsolute(root, name)
        if chengpath.FileExistsNonEmpty(root, absolute):
            return absolute
        return ""
    let pathEnv: str = os.GetEnv("PATH")
    let total: int32 = strings.Len(pathEnv)
    var start: int32
    for i in 0..total:
        var endHit = false
        if i == total:
            endHit = true
        elif pathEnv[i] == ';':
            endHit = true
        elif pathEnv[i] == ':':
            var driveColon = false
            if i == start + 1:
                let drive = pathEnv[start]
                if (drive >= 'A' && drive <= 'Z') || (drive >= 'a' && drive <= 'z'):
                    driveColon = true
            if !driveColon:
                endHit = true
        if !endHit:
            continue
        let itemLen: int32 = i - start
        if itemLen > 0:
            let dirText: str = chengpath.TextSlice(pathEnv, start, itemLen)
            let candidate: str = os.JoinPath(dirText, name)
            if chengpath.FileExistsNonEmpty(root, candidate):
                return candidate
            if !strutil.Contains(name, "."):
                let exeCandidate: str = os.JoinPath(dirText, strutil.Join([share(name), ".exe"], ""))
                if chengpath.FileExistsNonEmpty(root, exeCandidate):
                    return exeCandidate
        start = i + 1
    return ""

@borrows
fn RunFileLogged(root: str, label: str, filePathRaw: str, argv: str[], envOverrides: str[],
                   workingDirRaw: str, timeoutSec: int32, logPathRaw: str): LoggedRun =
    let filePath: str = chengpath.PathAbsolute(root, filePathRaw)
    var workingDir: str = chengpath.PathAbsolute(root, workingDirRaw)
    if !chengpath.PathNonEmpty(workingDirRaw):
        workingDir = share(root)
    let filePathExec: str = chengpath.PathHostFilePath(filePath)
    let workingDirExec: str = chengpath.PathHostFilePath(workingDir)
    let logPath: str = chengpath.PathAbsolute(root, logPathRaw)
    if !chengpath.FileExistsNonEmpty(root, filePath):
        let missingText = HostOpsMissingExecutableText(filePathExec)
        let _logged: bool = chengpath.WriteTextFile(root, logPath, missingText)
        return LoggedRunMake(label, filePathExec, logPath, 127, missingText)
    if HostOpsShellStatusEnabled(envOverrides):
        let exitCode = hostos.ExecFileStatusLogged(share(filePathExec),
                                                   share(argv),
                                                   share(envOverrides),
                                                   workingDirExec,
                                                   timeoutSec,
                                                   share(logPath))
        let outputText = chengpath.ReadTextFile("", logPath)
        return LoggedRunMake(label, filePathExec, logPath, exitCode, outputText)
    let maxRssBytes: int64 = HostOpsConfiguredMaxRssBytes(envOverrides)
    if maxRssBytes < Int64(0):
        let configText = "invalid CHENG_PROCESS_MAX_RSS_BYTES\n"
        let _logged: bool = chengpath.WriteTextFile(root, logPath, configText)
        return LoggedRunMake(label, filePath, logPath, 2, configText)
    let liveProgress = HostOpsLiveProgressEnabled(envOverrides)
    if liveProgress || maxRssBytes > Int64(0):
        let spawnRes = hostos.ExecFilePipeSpawn(share(filePathExec), share(argv), share(envOverrides), share(workingDirExec))
        if !spawnRes.ok || spawnRes.pid <= 0 || spawnRes.readFd < 0:
            let outputText = HostOpsSpawnMissingText(filePathExec, spawnRes, liveProgress, maxRssBytes)
            let _logged: bool = chengpath.WriteTextFile(root, logPath, outputText)
            return LoggedRunMake(label, filePathExec, logPath, 1, outputText)
        var writeFd = spawnRes.writeFd
        if writeFd >= 0:
            hostos.PtyClose(writeFd)
            writeFd = -1
        var proc = SpawnedProcessMake(share(label),
                                        filePathExec,
                                        spawnRes.readFd,
                                        writeFd,
                                        spawnRes.pid,
                                        "",
                                        "",
                                        0)
        return SpawnedProcessWaitLoggedLive(root, proc, timeoutSec, maxRssBytes, logPathRaw)
    let res: os.ExecCmdResult = ExecFileDirect(share(filePathExec), share(argv), share(envOverrides), share(workingDirExec), timeoutSec, true)
    let outputText = res.output
    let exitCode = res.exitCode
    let _logged: bool = chengpath.WriteTextFile(root, logPath, outputText)
    return LoggedRunMake(label, filePathExec, logPath, exitCode, outputText)

@borrows
fn RunProgramLogged(root: str, label: str, programName: str, argv: str[], envOverrides: str[],
                      workingDirRaw: str, timeoutSec: int32, logPathRaw: str): LoggedRun =
    let programPath: str = ResolveProgram(root, programName)
    if !chengpath.PathNonEmpty(programPath):
        let logPath: str = chengpath.PathAbsolute(root, logPathRaw)
        let missingText = HostOpsMissingExecutableText(programName)
        let _logged: bool = chengpath.WriteTextFile(root, logPath, missingText)
        return LoggedRunMake(label, programName, logPath, 127, missingText)
    return RunFileLogged(root, label, programPath, argv, envOverrides, workingDirRaw, timeoutSec, logPathRaw)

fn RunProgramLoggedExitCode(root: str,
                            label: str,
                            programName: str,
                            argv: str[],
                            envOverrides: str[],
                            workingDirRaw: str,
                            timeoutSec: int32,
                            logPathRaw: str): int32 =
    let programPath: str = ResolveProgram(root, programName)
    if !chengpath.PathNonEmpty(programPath):
        let logPath: str = chengpath.PathAbsolute(root, logPathRaw)
        let missingText = HostOpsMissingExecutableText(programName)
        let _logged: bool = chengpath.WriteTextFile(root, logPath, missingText)
        return 127
    return RunFileLoggedExitCode(root,
                                 label,
                                 programPath,
                                 argv,
                                 envOverrides,
                                 workingDirRaw,
                                 timeoutSec,
                                 logPathRaw)

@borrows
fn RunFileLoggedExitCode(root: str,
                           label: str,
                           filePathRaw: str,
                           argv: str[],
                           envOverrides: str[],
                           workingDirRaw: str,
                           timeoutSec: int32,
                           logPathRaw: str): int32 =
    let filePath: str = chengpath.PathAbsolute(root, filePathRaw)
    var workingDir: str = chengpath.PathAbsolute(root, workingDirRaw)
    if !chengpath.PathNonEmpty(workingDirRaw):
        workingDir = strings.CloneStr(root)
    let logPath: str = chengpath.PathAbsolute(root, logPathRaw)
    if !chengpath.FileExistsNonEmpty(root, filePath):
        let missingText = HostOpsMissingExecutableText(filePath)
        let _logged: bool = chengpath.WriteTextFile(root, logPath, missingText)
        return 127
    if HostOpsShellStatusEnabled(envOverrides):
        return hostos.ExecFileStatusLogged(filePath,
                                           argv,
                                           envOverrides,
                                           workingDir,
                                           timeoutSec,
                                           logPath)
    let maxRssBytes: int64 = HostOpsConfiguredMaxRssBytes(envOverrides)
    if maxRssBytes < Int64(0):
        let configText = "invalid CHENG_PROCESS_MAX_RSS_BYTES\n"
        let _logged: bool = chengpath.WriteTextFile(root, logPath, configText)
        return 2
    let liveProgress = HostOpsLiveProgressEnabled(envOverrides)
    if liveProgress || maxRssBytes > Int64(0):
        let spawnRes = hostos.ExecFilePipeSpawn(share(filePath), share(argv), share(envOverrides), share(workingDir))
        if !spawnRes.ok || spawnRes.pid <= 0 || spawnRes.readFd < 0:
            let outputText = HostOpsSpawnMissingText(filePath, spawnRes, liveProgress, maxRssBytes)
            let _logged: bool = chengpath.WriteTextFile(root, logPath, outputText)
            return 1
        var writeFd = spawnRes.writeFd
        if writeFd >= 0:
            hostos.PtyClose(writeFd)
            writeFd = -1
        var proc = SpawnedProcessMake(label,
                                        filePath,
                                        spawnRes.readFd,
                                        writeFd,
                                        spawnRes.pid,
                                        "",
                                        "",
                                        0)
        return SpawnedProcessWaitLoggedLiveExitCode(root,
                                                    proc,
                                                    timeoutSec,
                                                    maxRssBytes,
                                                    logPathRaw)
    let res: os.ExecCmdResult = ExecFileDirect(filePath, argv, envOverrides, workingDir, timeoutSec, true)
    let outputText = res.output
    let exitCode = res.exitCode
    let _logged: bool = chengpath.WriteTextFile(root, logPath, outputText)
    return exitCode

@borrows
fn RunFileLoggedWithInputText(root: str,
                                label: str,
                                filePathRaw: str,
                                argv: str[],
                                envOverrides: str[],
                                workingDirRaw: str,
                                timeoutSec: int32,
                                logPathRaw: str,
                                inputText: str): LoggedRun =
    let filePath: str = strings.CloneStr(chengpath.PathAbsolute(root, filePathRaw))
    var workingDir: str = strings.CloneStr(chengpath.PathAbsolute(root, workingDirRaw))
    if !chengpath.PathNonEmpty(workingDirRaw):
        workingDir = strings.CloneStr(root)
    let logPath: str = strings.CloneStr(chengpath.PathAbsolute(root, logPathRaw))
    if !chengpath.FileExistsNonEmpty(root, filePath):
        let missingText = HostOpsMissingExecutableText(filePath)
        let _logged: bool = chengpath.WriteTextFile(root, logPath, missingText)
        return LoggedRunMake(strings.CloneStr(label), strings.CloneStr(filePath), strings.CloneStr(logPath), 127, missingText)
    let spawnRes = hostos.ExecFilePipeSpawn(share(filePath), share(argv), share(envOverrides), share(workingDir))
    if !spawnRes.ok || spawnRes.pid <= 0 || spawnRes.readFd < 0:
        let outputText = strutil.Join(["spawn pid missing: ", strings.CloneStr(filePath), "\n"], "")
        let _logged: bool = chengpath.WriteTextFile(root, logPath, outputText)
        return LoggedRunMake(strings.CloneStr(label), strings.CloneStr(filePath), strings.CloneStr(logPath), 1, outputText)
    var proc = SpawnedProcessMake(strings.CloneStr(label),
                                    strings.CloneStr(filePath),
                                    spawnRes.readFd,
                                    spawnRes.writeFd,
                                    spawnRes.pid,
                                    "",
                                    "",
                                    0)
    let writeOk: bool = SpawnedProcessWriteAll(proc, strings.CloneStr(inputText))
    SpawnedProcessCloseWrite(proc)
    if !writeOk:
        proc.output = strutil.Join([share(proc.output), "write stdin failed\n"], "")
        SpawnedProcessKill(proc)
        return SpawnedProcessFinalize(root, proc, logPathRaw, 1)
    return SpawnedProcessWaitLogged(root, proc, timeoutSec, logPathRaw)

@borrows
fn RunProgramLoggedWithInputText(root: str,
                                   label: str,
                                   programName: str,
                                   argv: str[],
                                   envOverrides: str[],
                                   workingDirRaw: str,
                                   timeoutSec: int32,
                                   logPathRaw: str,
                                   inputText: str): LoggedRun =
    let programPath: str = ResolveProgram(root, programName)
    if !chengpath.PathNonEmpty(programPath):
        let logPath: str = chengpath.PathAbsolute(root, logPathRaw)
        let missingText = HostOpsMissingExecutableText(programName)
        let _logged: bool = chengpath.WriteTextFile(root, logPath, missingText)
        return LoggedRunMake(label, programName, logPath, 127, missingText)
    return RunFileLoggedWithInputText(root,
                                        label,
                                        programPath,
                                        argv,
                                        envOverrides,
                                        workingDirRaw,
                                        timeoutSec,
                                        logPathRaw,
                                        inputText)

@borrows
fn LoggedRunOk(run: LoggedRun): bool =
    return run.exitCode == 0

@borrows
fn HostOpsEnvOverrideValue(envOverrides: str[],
                             key: str): str =
    let n: int32 = envOverrides.len
    for ri in range(n):
        let i: int32 = n - 1 - ri
        let item: str = strutil.Strip(envOverrides[i])
        if strutil.StartsWith(item, strutil.Join([share(key), "="], "")):
            return strings.SliceBytes(item, Len(key) + 1, Len(item) - Len(key) - 1)
    return ""

@borrows
fn HostOpsEnvOverrideHasKey(envOverrides: str[],
                            key: str): bool =
    let prefix = strutil.Join([share(key), "="], "")
    for i in 0..<envOverrides.len:
        if strutil.StartsWith(strutil.Strip(envOverrides[i]), prefix):
            return true
    return false

@borrows
fn HostOpsLegacyResourceGuardEnvPresent(envOverrides: str[]): bool =
    if HostOpsEnvOverrideHasKey(envOverrides, "PROCESS_MAX_RSS_BYTES") ||
       HostOpsEnvOverrideHasKey(envOverrides, "CHENG_MAX_RSS_BYTES") ||
       HostOpsEnvOverrideHasKey(envOverrides, "MAX_RSS_BYTES") ||
       HostOpsEnvOverrideHasKey(envOverrides, "PARENT_RSS_GUARD"):
        return true
    return Len(os.GetEnv("PROCESS_MAX_RSS_BYTES")) > 0 ||
           Len(os.GetEnv("CHENG_MAX_RSS_BYTES")) > 0 ||
           Len(os.GetEnv("MAX_RSS_BYTES")) > 0 ||
           Len(os.GetEnv("PARENT_RSS_GUARD")) > 0

@borrows
fn HostOpsParseUnsignedInt64(raw: str): int64 =
    let text: str = strutil.Strip(share(raw))
    if Len(text) <= 0:
        return Int64(-1)
    var value: int64
    var hadDigit: bool
    for i in 0..<Len(text):
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            return Int64(-1)
        value = value * Int64(10) + Int64(Int32(ch) - Int32('0'))
        hadDigit = true
    if !hadDigit:
        return Int64(-1)
    return value

@borrows
fn HostOpsConfiguredMaxRssBytes(envOverrides: str[]): int64 =
    if HostOpsLegacyResourceGuardEnvPresent(envOverrides):
        return Int64(-1)
    var raw: str = strutil.Strip(HostOpsEnvOverrideValue(envOverrides, "CHENG_PROCESS_MAX_RSS_BYTES"))
    if Len(raw) <= 0:
        raw = strutil.Strip(os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES"))
    if Len(raw) <= 0:
        return Int64(0)
    let parsed: int64 = HostOpsParseUnsignedInt64(raw)
    if parsed <= Int64(0):
        return Int64(-1)
    return parsed

@borrows
fn HostOpsLiveProgressEnabled(envOverrides: str[]): bool =
    let progressText = strutil.Strip(HostOpsEnvOverrideValue(envOverrides, "CHENG_PROGRESS"))
    if Len(progressText) > 0 && progressText != "0" && progressText != "false":
        return true
    let pathText = strutil.Strip(HostOpsEnvOverrideValue(envOverrides, "CHENG_PROGRESS_OUT"))
    return Len(pathText) > 0

fn HostOpsProcessGroupRssBytes(pid: int64): int64 =
    if pid <= 0:
        return Int64(-1)
    let rss: int64 = HostOpsProcessGroupRssBytesBridge(pid)
    if rss <= Int64(0):
        return Int64(-1)
    return rss

fn HostOpsCurrentPid(): int64 =
    return Int64(HostOpsGetPidBridge())

fn HostOpsCurrentRssBytes(): int64 =
    # Own-process sampling goes through os.ProcessRssBytes so the self-guard reads
    # phys_footprint on Darwin (the native bridge metric is blind to compressed memory).
    let rss: int64 = os.ProcessRssBytes()
    if rss <= Int64(0):
        return Int64(-1)
    return rss

fn HostOpsExitProcess(code: int32) =
    HostOpsExitBridge(code)

fn HostOpsExitInvalidMaxRss() =
    HostOpsExitBridge(2)

fn HostOpsExitRssLimit() =
    HostOpsExitBridge(125)

fn HostOpsMemoryLimitExceededLine(rssBytes: int64,
                                    maxRssBytes: int64): str =
    return strutil.Join(["compile_progress phase=resource_guard status=rss_limit_exceeded rss_bytes=", strings.Int64ToStr(rssBytes), " limit_bytes=", strings.Int64ToStr(maxRssBytes)], "")

fn LoggedRunSignalName(exitCode: int32): str =
    if exitCode < 129:
        return ""
    let signalCode: int32 = exitCode - 128
    if signalCode == 1:
        return "SIGHUP"
    if signalCode == 2:
        return "SIGINT"
    if signalCode == 3:
        return "SIGQUIT"
    if signalCode == 4:
        return "SIGILL"
    if signalCode == 5:
        return "SIGTRAP"
    if signalCode == 6:
        return "SIGABRT"
    if signalCode == 7:
        return "SIGBUS"
    if signalCode == 8:
        return "SIGFPE"
    if signalCode == 9:
        return "SIGKILL"
    if signalCode == 10:
        return "SIGUSR1"
    if signalCode == 11:
        return "SIGSEGV"
    if signalCode == 12:
        return "SIGUSR2"
    if signalCode == 13:
        return "SIGPIPE"
    if signalCode == 14:
        return "SIGALRM"
    if signalCode == 15:
        return "SIGTERM"
    return ""

@borrows
fn LoggedRunSummary(run: LoggedRun): str =
    var out = ""
    out = strutil.Join([out, strings.CloneStr(run.label)], "")
    out = strutil.Join([out, " exit="], "")
    out = strutil.Join([out, strings.IntToStr(run.exitCode)], "")
    let signalName: str = LoggedRunSignalName(run.exitCode)
    if Len(signalName) > 0:
        out = strutil.Join([out, " signal="], "")
        out = strutil.Join([out, signalName], "")
    out = strutil.Join([out, " log="], "")
    out = strutil.Join([out, strings.CloneStr(run.logPath)], "")
    return out

@borrows
fn LoggedRunZero(label: str,
                   filePath: str,
                   logPath: str,
                   exitCode: int32,
                   output: str): LoggedRun =
    return LoggedRunMake(label, filePath, logPath, exitCode, output)

fn HostOpsAppendLiveLog(proc: var SpawnedProcess) =
    let liveLogPath: str = proc.liveLogPath
    if Len(liveLogPath) <= 0:
        return
    if !os.FileExists(liveLogPath):
        return
    let logText: str = chengpath.ReadTextFile("", liveLogPath)
    let logLen: int32 = Len(logText)
    if logLen < proc.liveLogLen:
        proc.output = logText
        proc.liveLogLen = logLen
        return
    if logLen == proc.liveLogLen:
        return
    let chunk: str = strings.SliceBytes(logText, proc.liveLogLen, logLen - proc.liveLogLen)
    proc.output = strutil.Join([share(proc.output), share(chunk)], "")
    proc.liveLogLen = logLen

@borrows
fn SpawnedProcessAppendOutput(proc: var SpawnedProcess, chunk: str) =
    proc.output = strutil.Join([share(proc.output), share(chunk)], "")

fn SpawnedProcessCloseRead(proc: var SpawnedProcess) =
    if proc.readFd >= 0:
        hostos.PtyClose(proc.readFd)
        proc.readFd = -1

fn SpawnedProcessCloseWrite(proc: var SpawnedProcess) =
    if proc.writeFd >= 0:
        hostos.PtyClose(proc.writeFd)
        proc.writeFd = -1

@borrows
fn SpawnedProcessWriteAll(proc: var SpawnedProcess, data: str): bool =
    if Len(data) <= 0:
        return true
    if proc.writeFd < 0:
        return false
    var cursor: int32
    let total: int32 = Len(data)
    for _ in range(total - cursor):
        if cursor >= total:
            break
        let chunk: str = strings.SliceBytes(data, cursor, total - cursor)
        let wrote: int32 = hostos.PtyWrite(proc.writeFd, chunk)
        if wrote <= 0:
            return false
        cursor = cursor + wrote
    return true

fn SpawnedProcessCleanup(proc: var SpawnedProcess) =
    SpawnedProcessCloseRead(proc)
    SpawnedProcessCloseWrite(proc)
    proc.pid = 0
    proc.liveLogPath = ""
    proc.liveLogLen = 0

fn SpawnedProcessDrain(proc: var SpawnedProcess, timeoutMs: int32) =
    if Len(proc.liveLogPath) > 0:
        HostOpsAppendLiveLog(proc)
        return
    if proc.readFd < 0:
        return
    var waitMs = timeoutMs
    while proc.readFd >= 0:
        let readRes = hostos.FdReadWait(proc.readFd, 65536, waitMs)
        let chunk = readRes.text
        let eof = readRes.eof
        if strings.Len(chunk) <= 0:
            if eof:
                SpawnedProcessCloseRead(proc)
            break
        SpawnedProcessAppendOutput(proc, chunk)
        waitMs = 0

@borrows
fn SpawnedProcessSignal(proc: SpawnedProcess, signalCode: int32): bool =
    if proc.pid <= 0:
        return false
    return hostos.ProcessSignal(proc.pid, signalCode)

fn SpawnedProcessKill(proc: var SpawnedProcess) =
    if proc.pid <= 0:
        SpawnedProcessCleanup(proc)
        return
    let _term = SpawnedProcessSignal(proc, ProcessSigTerm)
    for i in 0..<20:
        i
        SpawnedProcessDrain(proc, 0)
        if !hostos.ProcessExists(proc.pid):
            SpawnedProcessCleanup(proc)
            return
        os.SleepMs(50)
    let _kill = SpawnedProcessSignal(proc, ProcessSigKill)
    for i in 0..<20:
        i
        SpawnedProcessDrain(proc, 0)
        if !hostos.ProcessExists(proc.pid):
            SpawnedProcessCleanup(proc)
            return
        os.SleepMs(50)
    SpawnedProcessDrain(proc, 0)
    SpawnedProcessCleanup(proc)

@borrows
fn SpawnedProcessFinalize(root: str,
                            proc: var SpawnedProcess,
                            logPathRaw: str,
                            exitCode: int32): LoggedRun =
    let logPath: str = chengpath.PathAbsolute(root, logPathRaw)
    let _logged: bool = chengpath.WriteTextFile(root, strings.CloneStr(logPath), strings.CloneStr(proc.output))
    let out = LoggedRunMake(proc.label,
                              proc.filePath,
                              logPath,
                              exitCode,
                              proc.output)
    proc = SpawnedProcess()
    return out

fn SpawnedProcessPoll(proc: var SpawnedProcess): int32 =
    if proc.pid <= 0:
        return 0
    SpawnedProcessDrain(proc, 0)
    if Len(proc.liveLogPath) > 0:
        if hostos.ProcessExists(proc.pid):
            return ProcessRunning
        SpawnedProcessCleanup(proc)
        return 0
    let waitRes = hostos.PtyWait(proc.pid)
    let waitStatus = waitRes.waitStatus
    if waitStatus == 1:
        let exitCode = waitRes.exitCode
        SpawnedProcessDrain(proc, 0)
        SpawnedProcessCleanup(proc)
        return exitCode
    if waitStatus < 0:
        SpawnedProcessDrain(proc, 0)
        SpawnedProcessCleanup(proc)
        return -1
    return ProcessRunning

fn SpawnedProcessRunning(proc: var SpawnedProcess): bool =
    let exitCode = SpawnedProcessPoll(proc)
    return exitCode == ProcessRunning

@borrows
fn HostOpsEchoProgressChunk(chunk: str) =
    var start: int32
    let n = Len(chunk)
    for i in range(n + 1):
        if i == n:
            let line = strings.SliceBytes(chunk, start, i - start)
            if Len(line) > 0 && strutil.StartsWith(line, "compile_progress "):
                os.WriteLine(os.Get_stderr(), line)
            start = i + 1
        elif chunk[i] == '\n':
            let line = strings.SliceBytes(chunk, start, i - start)
            if Len(line) > 0 && strutil.StartsWith(line, "compile_progress "):
                os.WriteLine(os.Get_stderr(), line)
            start = i + 1

@borrows
fn SpawnedProcessWaitLoggedLive(root: str,
                                  proc: var SpawnedProcess,
                                  timeoutSec: int32,
                                  maxRssBytes: int64,
                                  logPathRaw: str): LoggedRun =
    let start = monotimes.GetMonoTime()
    let startNs: int64 = monotimes.MonoTimeNs(start)
    let timeoutNs: int64 = Int64(timeoutSec) * Int64(1000000000)
    var timedOut = false
    var memoryExceeded = false
    var termSent = false
    var termAtNs: int64
    var nextMemoryCheckNs: int64
    var exceededRssBytes: int64
    var exitCode = -1
    while proc.pid > 0:
        let beforeLen = Len(proc.output)
        SpawnedProcessDrain(proc, 20)
        if Len(proc.output) > beforeLen:
            let chunk = strings.SliceBytes(proc.output, beforeLen, Len(proc.output) - beforeLen)
            HostOpsEchoProgressChunk(chunk)
        let nowTime = monotimes.GetMonoTime()
        let nowNs: int64 = monotimes.MonoTimeNs(nowTime) - startNs
        var checkMemory = false
        if maxRssBytes > Int64(0):
            if nowNs >= nextMemoryCheckNs:
                checkMemory = true
        if checkMemory:
            nextMemoryCheckNs = nowNs + Int64(500000000)
            let rssBytes: int64 = HostOpsProcessGroupRssBytes(proc.pid)
            if rssBytes > maxRssBytes:
                memoryExceeded = true
                exceededRssBytes = rssBytes
                let guardLine: str = HostOpsMemoryLimitExceededLine(rssBytes, maxRssBytes)
                proc.output = strutil.Join([share(proc.output), share(guardLine), "\n"], "")
                os.WriteLine(os.Get_stderr(), guardLine)
                if !termSent:
                    let _term = SpawnedProcessSignal(proc, ProcessSigTerm)
                    termSent = true
                    termAtNs = nowNs
                elif nowNs - termAtNs >= Int64(500000000):
                    let _kill = SpawnedProcessSignal(proc, ProcessSigKill)
                os.SleepMs(20)
                continue
            if memoryExceeded && nowNs - termAtNs >= Int64(500000000):
                let _kill = SpawnedProcessSignal(proc, ProcessSigKill)
                os.SleepMs(20)
                continue
        if Len(proc.liveLogPath) > 0:
            if !hostos.ProcessExists(proc.pid):
                exitCode = 0
                proc.pid = 0
                break
            if timeoutSec > 0:
                if nowNs >= timeoutNs:
                    timedOut = true
                    if !termSent:
                        let _term = SpawnedProcessSignal(proc, ProcessSigTerm)
                        termSent = true
                        termAtNs = nowNs
                    elif nowNs - termAtNs >= Int64(500000000):
                        let _kill = SpawnedProcessSignal(proc, ProcessSigKill)
                    os.SleepMs(20)
                    continue
            os.SleepMs(10)
            continue
        let waitRes = hostos.PtyWait(proc.pid)
        let waitStatus = waitRes.waitStatus
        if waitStatus == 1:
            exitCode = waitRes.exitCode
            proc.pid = 0
            break
        if waitStatus < 0:
            exitCode = -1
            proc.pid = 0
            break
        if timeoutSec > 0:
            if nowNs >= timeoutNs:
                timedOut = true
                if !termSent:
                    let _term = SpawnedProcessSignal(proc, ProcessSigTerm)
                    termSent = true
                    termAtNs = nowNs
                elif nowNs - termAtNs >= Int64(500000000):
                    let _kill = SpawnedProcessSignal(proc, ProcessSigKill)
                os.SleepMs(20)
                continue
        os.SleepMs(10)
    let beforeLen = Len(proc.output)
    SpawnedProcessDrain(proc, 0)
    if Len(proc.output) > beforeLen:
        let chunk = strings.SliceBytes(proc.output, beforeLen, Len(proc.output) - beforeLen)
        HostOpsEchoProgressChunk(chunk)
    SpawnedProcessCloseWrite(proc)
    SpawnedProcessCloseRead(proc)
    if timedOut:
        exitCode = 124
    if memoryExceeded:
        exitCode = ProcessMemoryExceeded
        if exceededRssBytes > Int64(0):
            let finalGuardLine: str = HostOpsMemoryLimitExceededLine(exceededRssBytes, maxRssBytes)
            if !strutil.Contains(proc.output, finalGuardLine):
                proc.output = strutil.Join([share(proc.output), finalGuardLine, "\n"], "")
    let logPathAbsRaw: str = chengpath.PathAbsolute(root, logPathRaw)
    let logPath: str = NewStringCopy(StrDataPtr(logPathAbsRaw), StrLenFast(logPathAbsRaw))
    let _logged: bool = chengpath.WriteTextFile(root, strings.CloneStr(logPath), strings.CloneStr(proc.output))
    let out = LoggedRunMake(proc.label,
                              proc.filePath,
                              logPath,
                              exitCode,
                              proc.output)
    proc = SpawnedProcess()
    return out

