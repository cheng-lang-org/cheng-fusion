import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/rawbytes
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema

const
    SemanticSnapshotIdentityDomain: str = "cheng.semantic_snapshot.identity"
    SemanticSnapshotBindingDomain: str = "cheng.semantic_snapshot.local_binding"
    SemanticSnapshotValidationDomain: str = "cheng.semantic_snapshot.validation"
    SemanticSnapshotFailureDomain: str = "cheng.semantic_snapshot.failure"

    SemanticSourceEventOpen: int32 = 1
    SemanticSourceEventChange: int32 = 2
    SemanticSourceEventClose: int32 = 3
    SemanticSourceEventAdd: int32 = 4
    SemanticSourceEventRemove: int32 = 5
    SemanticSourceEventRename: int32 = 6

    SemanticSourcePresenceAbsent: int32 = 0
    SemanticSourcePresencePresent: int32 = 1

    SemanticSourceEventStateDomain: str = "cheng.semantic_snapshot.source_event_state"
    SemanticSourceEventReceiptDomain: str = "cheng.semantic_snapshot.source_event"

    SemanticSnapshotStateNone: int32 = 0
    SemanticSnapshotStateBuilding: int32 = 1
    SemanticSnapshotStateValidated: int32 = 2
    SemanticSnapshotStatePublished: int32 = 3
    SemanticSnapshotStateRejected: int32 = 4
    SemanticSnapshotStateCancelled: int32 = 5
    SemanticSnapshotStateRetired: int32 = 6
    SemanticSnapshotStateReleased: int32 = 7

type
    PortableSemanticSnapshotIdentity =
        sourceIdentityReceiptCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32

    WorkspaceSourceEventState =
        workspaceSessionCid: layout.FixedBytes32
        nextSourceVersion: int64
        lastAcceptedSourceVersion: int64
        documentCids: layout.FixedBytes32[]
        clientVersions: int64[]
        documentOpenStates: int32[]
        documentPresenceStates: int32[]
        documentRenamePeerRows: int32[]
        documentLastEventCids: layout.FixedBytes32[]
        # Exact event provenance per document.  This bounded ledger is enough
        # to compute the union of documents changed since any published
        # sourceVersion without retaining an unbounded global event log.
        documentLastEventSourceVersions: int64[]
        documentLastEventKinds: int32[]
        eventStateReceiptCid: layout.FixedBytes32

    LocalSourceVersionBinding =
        workspaceSessionCid: layout.FixedBytes32
        schemaVersion: int32
        semanticEpoch: int64
        sourceVersion: int64
        documentCids: layout.FixedBytes32[]
        clientVersions: int64[]
        documentOpenStates: int32[]
        activeSourceStableRows: int32[]
        sourceEventStateReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32

    SemanticSnapshotValidationReceipt =
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        parserRootCid: layout.FixedBytes32
        typeRootCid: layout.FixedBytes32
        ownershipRootCid: layout.FixedBytes32
        callRootCid: layout.FixedBytes32
        layoutRootCid: layout.FixedBytes32
        dependencyRootCid: layout.FixedBytes32
        readSetRootCid: layout.FixedBytes32
        reachabilityRootCid: layout.FixedBytes32
        canonicalRootCid: layout.FixedBytes32
        lifecycleRootCid: layout.FixedBytes32
        queryIndexRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32

    SemanticSnapshotFailureReceipt =
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        sourceVersion: int64
        reasonCode: int32
        diagnosticRootCid: layout.FixedBytes32
        failureReceiptCid: layout.FixedBytes32

    SemanticSnapshotPin =
        snapshotIndex: int32
        schemaVersion: int32
        semanticEpoch: int64
        sourceVersion: int64
        bindingReceiptCid: layout.FixedBytes32
        active: bool

    SemanticSnapshotCandidateFailureStage =
        candidateIndex: int32
        sourceVersion: int64
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        failureReceiptCid: layout.FixedBytes32
        active: bool

    # Snapshot rows are stored as stable int32 indexes.  Columns are SoA;
    # publish only flips indexes/states and performs no allocation or I/O.
    SemanticSnapshotStore =
        workspaceSessionCid: layout.FixedBytes32
        currentSourceVersion: int64
        publishedIndex: int32
        candidateIndex: int32
        states: int32[]
        schemaVersions: int32[]
        semanticEpochs: int64[]
        sourceVersions: int64[]
        sourceIdentityReceiptCids: layout.FixedBytes32[]
        semanticSnapshotCids: layout.FixedBytes32[]
        worldHeadCids: layout.FixedBytes32[]
        compilerCids: layout.FixedBytes32[]
        sourceBundleCids: layout.FixedBytes32[]
        csgRootCids: layout.FixedBytes32[]
        bindingReceiptCids: layout.FixedBytes32[]
        validationReceiptCids: layout.FixedBytes32[]
        failureReceiptCids: layout.FixedBytes32[]
        borrowCounts: int32[]

fn semanticSnapshotAppendU32BE(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn semanticSnapshotAppendU64BE(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn semanticSnapshotAppendText(buf: var layout.ByteBuf, value: str) =
    semanticSnapshotAppendU32BE(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

fn semanticSnapshotAppendI32(buf: var layout.ByteBuf, value: int32) =
    semanticSnapshotAppendU32BE(buf, 4)
    semanticSnapshotAppendU32BE(buf, value)

fn semanticSnapshotAppendI64(buf: var layout.ByteBuf, value: int64) =
    semanticSnapshotAppendU32BE(buf, 8)
    semanticSnapshotAppendU64BE(buf, value)

@borrows
fn semanticSnapshotAppendFixed32(buf: var layout.ByteBuf,
                                  value: layout.FixedBytes32) =
    semanticSnapshotAppendU32BE(buf, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(buf, value)

fn semanticSnapshotHash(buf: var layout.ByteBuf): layout.FixedBytes32 =
    return hash256.Sha256Fixed(layout.ByteBufView(buf))

@borrows
fn semanticSnapshotRaw32Observed(value: layout.FixedBytes32): bool =
    if layout.FixedBytes32Equal(value, layout.FixedBytes32()):
        return false
    var empty = layout.ByteBufInit(0)
    let emptyCid = semanticSnapshotHash(empty)
    layout.ByteBufFree(empty)
    return !layout.FixedBytes32Equal(value, emptyCid)

@borrows
fn semanticSourceEventStateReceiptCid(
        state: WorkspaceSourceEventState): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        160 + state.documentCids.len * 132)
    semanticSnapshotAppendText(buf, SemanticSourceEventStateDomain)
    semanticSnapshotAppendFixed32(buf, state.workspaceSessionCid)
    semanticSnapshotAppendI64(buf, state.nextSourceVersion)
    semanticSnapshotAppendI64(buf, state.lastAcceptedSourceVersion)
    semanticSnapshotAppendI32(buf, state.documentCids.len)
    for row in 0..<state.documentCids.len:
        semanticSnapshotAppendI32(buf, row)
        semanticSnapshotAppendFixed32(buf, state.documentCids[row])
        semanticSnapshotAppendI64(buf, state.clientVersions[row])
        semanticSnapshotAppendI32(buf, state.documentOpenStates[row])
        semanticSnapshotAppendI32(buf, state.documentPresenceStates[row])
        semanticSnapshotAppendI32(buf, state.documentRenamePeerRows[row])
        semanticSnapshotAppendI64(
            buf, state.documentLastEventSourceVersions[row])
        semanticSnapshotAppendI32(buf, state.documentLastEventKinds[row])
        semanticSnapshotAppendFixed32(
            buf, state.documentLastEventCids[row])
    let out = semanticSnapshotHash(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSourceEventReceiptCid(
        state: WorkspaceSourceEventState,
        sourceVersion: int64,
        eventKind: int32,
        documentRow: int32,
        renamePeerRow: int32,
        documentCid: layout.FixedBytes32,
        renamePeerDocumentCid: layout.FixedBytes32,
        clientVersion: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(320)
    semanticSnapshotAppendText(buf, SemanticSourceEventReceiptDomain)
    semanticSnapshotAppendFixed32(buf, state.workspaceSessionCid)
    semanticSnapshotAppendFixed32(buf, state.eventStateReceiptCid)
    semanticSnapshotAppendI64(buf, sourceVersion)
    semanticSnapshotAppendI32(buf, eventKind)
    semanticSnapshotAppendI32(buf, documentRow)
    semanticSnapshotAppendI32(buf, renamePeerRow)
    semanticSnapshotAppendFixed32(buf, documentCid)
    semanticSnapshotAppendFixed32(buf, renamePeerDocumentCid)
    semanticSnapshotAppendI64(buf, clientVersion)
    let out = semanticSnapshotHash(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotIdentityCid(
        sourceIdentityReceiptCid: layout.FixedBytes32,
        worldHeadCid: layout.FixedBytes32,
        compilerCid: layout.FixedBytes32,
        sourceBundleCid: layout.FixedBytes32,
        csgRootCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    semanticSnapshotAppendText(buf, SemanticSnapshotIdentityDomain)
    semanticSnapshotAppendFixed32(buf, sourceIdentityReceiptCid)
    semanticSnapshotAppendFixed32(buf, worldHeadCid)
    semanticSnapshotAppendFixed32(buf, compilerCid)
    semanticSnapshotAppendFixed32(buf, sourceBundleCid)
    semanticSnapshotAppendFixed32(buf, csgRootCid)
    let out = semanticSnapshotHash(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn PortableSemanticSnapshotIdentityMakeInto(
        sourceIdentityReceiptCid: layout.FixedBytes32,
        worldHeadCid: layout.FixedBytes32,
        compilerCid: layout.FixedBytes32,
        sourceBundleCid: layout.FixedBytes32,
        csgRootCid: layout.FixedBytes32,
        out: var PortableSemanticSnapshotIdentity,
        err: var str): bool =
    err = ""
    if !semanticSnapshotRaw32Observed(sourceIdentityReceiptCid) ||
       !semanticSnapshotRaw32Observed(worldHeadCid) ||
       !semanticSnapshotRaw32Observed(compilerCid) ||
       !semanticSnapshotRaw32Observed(sourceBundleCid) ||
       !semanticSnapshotRaw32Observed(csgRootCid):
        err = " semantic snapshot identity: unobserved root"
        return false
    let semanticSnapshotCid = semanticSnapshotIdentityCid(
        sourceIdentityReceiptCid, worldHeadCid, compilerCid,
        sourceBundleCid, csgRootCid)
    var candidate: PortableSemanticSnapshotIdentity
    candidate.sourceIdentityReceiptCid =
        layout.FixedBytes32Copy(sourceIdentityReceiptCid)
    candidate.worldHeadCid = layout.FixedBytes32Copy(worldHeadCid)
    candidate.compilerCid = layout.FixedBytes32Copy(compilerCid)
    candidate.sourceBundleCid = layout.FixedBytes32Copy(sourceBundleCid)
    candidate.csgRootCid = layout.FixedBytes32Copy(csgRootCid)
    candidate.semanticSnapshotCid = semanticSnapshotCid
    out = candidate
    return true

@borrows
fn PortableSemanticSnapshotIdentityStrictValidateInto(
        identity: PortableSemanticSnapshotIdentity,
        err: var str): bool =
    err = ""
    if !semanticSnapshotRaw32Observed(identity.sourceIdentityReceiptCid) ||
       !semanticSnapshotRaw32Observed(identity.worldHeadCid) ||
       !semanticSnapshotRaw32Observed(identity.compilerCid) ||
       !semanticSnapshotRaw32Observed(identity.sourceBundleCid) ||
       !semanticSnapshotRaw32Observed(identity.csgRootCid):
        err = " semantic snapshot identity: unobserved root"
        return false
    let expected = semanticSnapshotIdentityCid(
        identity.sourceIdentityReceiptCid, identity.worldHeadCid,
        identity.compilerCid, identity.sourceBundleCid, identity.csgRootCid)
    if !layout.FixedBytes32Equal(expected, identity.semanticSnapshotCid):
        err = " semantic snapshot identity: receipt mismatch"
        return false
    return true

@borrows
fn WorkspaceSourceEventStateInitInto(
        workspaceSessionCid: layout.FixedBytes32,
        out: var WorkspaceSourceEventState,
        err: var str): bool =
    err = ""
    if !semanticSnapshotRaw32Observed(workspaceSessionCid):
        err = " semantic source event: invalid workspace session"
        return false
    let ownedWorkspaceSessionCid = layout.FixedBytes32Copy(workspaceSessionCid)
    var state: WorkspaceSourceEventState
    state.workspaceSessionCid = ownedWorkspaceSessionCid
    state.nextSourceVersion = int64(1)
    state.documentCids = []
    state.clientVersions = []
    state.documentOpenStates = []
    state.documentPresenceStates = []
    state.documentRenamePeerRows = []
    state.documentLastEventCids = []
    state.documentLastEventSourceVersions = []
    state.documentLastEventKinds = []
    state.eventStateReceiptCid =
        semanticSourceEventStateReceiptCid(state)
    out = state
    return true

@borrows
fn semanticSourceEventStateShapeValid(state: WorkspaceSourceEventState): bool =
    return semanticSnapshotRaw32Observed(state.workspaceSessionCid) &&
           state.nextSourceVersion > 0 &&
           state.lastAcceptedSourceVersion == state.nextSourceVersion - int64(1) &&
           state.documentCids.len == state.clientVersions.len &&
           state.documentCids.len == state.documentOpenStates.len &&
           state.documentCids.len == state.documentPresenceStates.len &&
           state.documentCids.len == state.documentRenamePeerRows.len &&
           state.documentCids.len == state.documentLastEventCids.len &&
           state.documentCids.len ==
               state.documentLastEventSourceVersions.len &&
           state.documentCids.len == state.documentLastEventKinds.len &&
           semanticSnapshotRaw32Observed(state.eventStateReceiptCid) &&
           layout.FixedBytes32Equal(
               semanticSourceEventStateReceiptCid(state),
               state.eventStateReceiptCid)

@borrows
fn semanticSourceEventFindDocument(state: WorkspaceSourceEventState,
                                   documentCid: layout.FixedBytes32): int32 =
    for index in 0..<state.documentCids.len:
        if layout.FixedBytes32Equal(state.documentCids[index], documentCid):
            return index
    return -1

@borrows
fn semanticSourceEventDocumentIdentitiesUnique(
        state: WorkspaceSourceEventState): bool =
    for row in 0..<state.documentCids.len:
        if !semanticSnapshotRaw32Observed(state.documentCids[row]):
            return false
        for previous in 0..<row:
            if layout.FixedBytes32Equal(
                    state.documentCids[previous],
                    state.documentCids[row]):
                return false
    return true

@borrows
fn semanticSourceEventDocumentProvenanceValid(
        state: WorkspaceSourceEventState,
        row: int32): bool =
    if row < 0 || row >= state.documentCids.len:
        return false
    let eventVersion = state.documentLastEventSourceVersions[row]
    let eventKind = state.documentLastEventKinds[row]
    let presence = state.documentPresenceStates[row]
    let renamePeerRow = state.documentRenamePeerRows[row]
    if eventVersion < 0 || eventVersion > state.lastAcceptedSourceVersion ||
       !semanticSnapshotRaw32Observed(state.documentLastEventCids[row]) ||
       (presence != SemanticSourcePresenceAbsent &&
        presence != SemanticSourcePresencePresent) ||
       (eventKind != SemanticSourceEventOpen &&
        eventKind != SemanticSourceEventChange &&
        eventKind != SemanticSourceEventClose &&
        eventKind != SemanticSourceEventAdd &&
        eventKind != SemanticSourceEventRemove &&
        eventKind != SemanticSourceEventRename):
        return false
    if eventVersion == 0:
        return eventKind == SemanticSourceEventAdd &&
            presence == SemanticSourcePresencePresent &&
            state.documentOpenStates[row] == 0 &&
            renamePeerRow == -1
    if eventKind == SemanticSourceEventRename:
        if renamePeerRow < 0 ||
           renamePeerRow >= state.documentCids.len ||
           renamePeerRow == row ||
           (presence == SemanticSourcePresenceAbsent &&
            state.documentOpenStates[row] != 0):
            return false
        let peerEventVersion =
            state.documentLastEventSourceVersions[renamePeerRow]
        if peerEventVersion < eventVersion:
            return false
        if peerEventVersion == eventVersion &&
           (state.documentRenamePeerRows[renamePeerRow] != row ||
            state.documentLastEventKinds[renamePeerRow] !=
                SemanticSourceEventRename ||
            !layout.FixedBytes32Equal(
                state.documentLastEventCids[renamePeerRow],
                state.documentLastEventCids[row]) ||
            state.documentPresenceStates[renamePeerRow] == presence):
            return false
        return true
    if renamePeerRow != -1:
        return false
    if eventKind == SemanticSourceEventClose:
        return presence == SemanticSourcePresencePresent &&
            state.documentOpenStates[row] == 0
    if eventKind == SemanticSourceEventRemove:
        return presence == SemanticSourcePresenceAbsent &&
            state.documentOpenStates[row] == 0
    if eventKind == SemanticSourceEventAdd:
        return presence == SemanticSourcePresencePresent &&
            state.documentOpenStates[row] == 0
    return presence == SemanticSourcePresencePresent &&
        state.documentOpenStates[row] == 1

@borrows
fn WorkspaceSourceEventActiveSourceRowsInto(
        state: WorkspaceSourceEventState,
        out: var int32[],
        err: var str): bool =
    out = []
    err = ""
    if !semanticSourceEventStateShapeValid(state) ||
       !semanticSourceEventDocumentIdentitiesUnique(state):
        err = " semantic source event: invalid active-source query"
        return false
    for row in 0..<state.documentCids.len:
        if !semanticSourceEventDocumentProvenanceValid(state, row):
            err = " semantic source event: invalid active-source provenance"
            return false
        if state.documentPresenceStates[row] ==
               SemanticSourcePresencePresent:
            add(out, row)
    return true

@borrows
fn WorkspaceSourceEventRegisterInitialDocumentInto(
        state: var WorkspaceSourceEventState,
        documentCid: layout.FixedBytes32,
        stableRowOut: var int32,
        err: var str): bool =
    stableRowOut = -1
    err = ""
    if !semanticSourceEventStateShapeValid(state) ||
       !semanticSourceEventDocumentIdentitiesUnique(state) ||
       state.lastAcceptedSourceVersion != 0 ||
       !semanticSnapshotRaw32Observed(documentCid) ||
       semanticSourceEventFindDocument(state, documentCid) >= 0:
        err = " semantic source event: invalid initial document registration"
        return false
    let stableRow = state.documentCids.len
    let eventCid = semanticSourceEventReceiptCid(
        state, 0, SemanticSourceEventAdd, stableRow, -1,
        documentCid, layout.FixedBytes32(), 0)
    add(state.documentCids, layout.FixedBytes32Copy(documentCid))
    add(state.clientVersions, int64(0))
    add(state.documentOpenStates, 0)
    add(state.documentPresenceStates, SemanticSourcePresencePresent)
    add(state.documentRenamePeerRows, -1)
    add(state.documentLastEventCids, eventCid)
    add(state.documentLastEventSourceVersions, int64(0))
    add(state.documentLastEventKinds, SemanticSourceEventAdd)
    state.eventStateReceiptCid =
        semanticSourceEventStateReceiptCid(state)
    stableRowOut = stableRow
    return true

# Returns the exact document rows touched after `sourceVersionExclusive`.
# Multiple unpublished edits collapse only by exact document identity; no
# source range, name, or content heuristic participates in invalidation.
@borrows
fn WorkspaceSourceEventChangedDocumentRowsSinceInto(
        state: WorkspaceSourceEventState,
        sourceVersionExclusive: int64,
        out: var int32[],
        err: var str): bool =
    out = []
    err = ""
    if !semanticSourceEventStateShapeValid(state) ||
       !semanticSourceEventDocumentIdentitiesUnique(state) ||
       sourceVersionExclusive < 0 ||
       sourceVersionExclusive > state.lastAcceptedSourceVersion:
        err = " semantic source event: invalid changed-document query"
        return false
    for row in 0..<state.documentCids.len:
        if !semanticSnapshotRaw32Observed(state.documentCids[row]) ||
           !semanticSourceEventDocumentProvenanceValid(state, row):
            err = " semantic source event: invalid document provenance"
            return false
        if state.documentLastEventSourceVersions[row] >
               sourceVersionExclusive:
            add(out, row)
    return true

@borrows
fn WorkspaceSourceEventAcceptInto(
        state: var WorkspaceSourceEventState,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        clientVersion: int64,
        sourceVersionOut: var int64,
        err: var str): bool =
    return workspaceSourceEventAcceptCanonicalInto(
        state, eventKind, documentCid, layout.FixedBytes32(),
        clientVersion, sourceVersionOut, err)

@borrows
fn WorkspaceSourceFileEventAcceptInto(
        state: var WorkspaceSourceEventState,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        renameTargetDocumentCid: layout.FixedBytes32,
        sourceVersionOut: var int64,
        err: var str): bool =
    return workspaceSourceEventAcceptCanonicalInto(
        state, eventKind, documentCid, renameTargetDocumentCid,
        int64(-1), sourceVersionOut, err)

@borrows
fn workspaceSourceEventAcceptCanonicalInto(
        state: var WorkspaceSourceEventState,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        renameTargetDocumentCid: layout.FixedBytes32,
        clientVersion: int64,
        sourceVersionOut: var int64,
        err: var str): bool =
    err = ""
    sourceVersionOut = 0
    if !semanticSourceEventStateShapeValid(state) ||
       !semanticSourceEventDocumentIdentitiesUnique(state):
        err = " semantic source event: invalid state"
        return false
    if !semanticSnapshotRaw32Observed(documentCid) ||
       (eventKind == SemanticSourceEventRename &&
        (!semanticSnapshotRaw32Observed(renameTargetDocumentCid) ||
         layout.FixedBytes32Equal(
             documentCid, renameTargetDocumentCid))) ||
       (eventKind != SemanticSourceEventRename &&
        !layout.FixedBytes32Equal(
            renameTargetDocumentCid, layout.FixedBytes32())):
        err = " semantic source event: invalid document identity"
        return false
    let row = semanticSourceEventFindDocument(state, documentCid)
    let renameTargetRow =
        semanticSourceEventFindDocument(state, renameTargetDocumentCid)
    if row >= 0 &&
       !semanticSourceEventDocumentProvenanceValid(state, row):
        err = " semantic source event: corrupted document provenance"
        return false
    if eventKind == SemanticSourceEventOpen:
        if clientVersion < 0:
            err = " semantic source event: negative open version"
            return false
        if row >= 0 &&
           (state.documentPresenceStates[row] !=
                SemanticSourcePresencePresent ||
            state.documentOpenStates[row] != 0):
            err = " semantic source event: document already open"
            return false
        if row >= 0 &&
           (state.clientVersions[row] ==
                int64(9223372036854775807) ||
            clientVersion !=
                state.clientVersions[row] + int64(1)):
            err =
                " semantic source event: reopen version must advance by one"
            return false
    elif eventKind == SemanticSourceEventChange:
        if row < 0 ||
           state.documentPresenceStates[row] !=
               SemanticSourcePresencePresent ||
           state.documentOpenStates[row] == 0:
            err = " semantic source event: change for closed document"
            return false
        if state.clientVersions[row] == int64(9223372036854775807) ||
           clientVersion != state.clientVersions[row] + int64(1):
            err = " semantic source event: client version must advance by one"
            return false
    elif eventKind == SemanticSourceEventClose:
        if row < 0 ||
           state.documentPresenceStates[row] !=
               SemanticSourcePresencePresent ||
           state.documentOpenStates[row] == 0:
            err = " semantic source event: close for closed document"
            return false
        if clientVersion != int64(-1):
            err = " semantic source event: close version must be absent"
            return false
    elif eventKind == SemanticSourceEventAdd:
        if clientVersion != int64(-1) ||
           (row >= 0 &&
            state.documentPresenceStates[row] !=
                SemanticSourcePresenceAbsent):
            err = " semantic source event: duplicate add"
            return false
    elif eventKind == SemanticSourceEventRemove:
        if clientVersion != int64(-1) || row < 0 ||
           state.documentPresenceStates[row] !=
               SemanticSourcePresencePresent:
            err = " semantic source event: remove for absent document"
            return false
    elif eventKind == SemanticSourceEventRename:
        if clientVersion != int64(-1) || row < 0 ||
           state.documentPresenceStates[row] !=
               SemanticSourcePresencePresent ||
           (renameTargetRow >= 0 &&
            state.documentPresenceStates[renameTargetRow] !=
                SemanticSourcePresenceAbsent):
            err = " semantic source event: invalid rename"
            return false
    else:
        err = " semantic source event: unknown event kind"
        return false
    if state.nextSourceVersion == int64(9223372036854775807):
        err = " semantic source event: source version exhausted"
        return false

    let acceptedSourceVersion = state.nextSourceVersion
    var eventRow = row
    if eventRow < 0:
        eventRow = state.documentCids.len
    var eventPeerRow: int32 = -1
    if eventKind == SemanticSourceEventRename:
        eventPeerRow = renameTargetRow
        if eventPeerRow < 0:
            eventPeerRow = state.documentCids.len
    let eventCid = semanticSourceEventReceiptCid(
        state, acceptedSourceVersion, eventKind,
        eventRow, eventPeerRow, documentCid,
        renameTargetDocumentCid, clientVersion)

    if eventKind == SemanticSourceEventOpen:
        if row < 0:
            let ownedDocumentCid = layout.FixedBytes32Copy(documentCid)
            add(state.documentCids, ownedDocumentCid)
            add(state.clientVersions, clientVersion)
            add(state.documentOpenStates, 1)
            add(state.documentPresenceStates,
                SemanticSourcePresencePresent)
            add(state.documentRenamePeerRows, -1)
            add(state.documentLastEventCids, eventCid)
            add(state.documentLastEventSourceVersions,
                acceptedSourceVersion)
            add(state.documentLastEventKinds, eventKind)
        else:
            state.clientVersions[row] = clientVersion
            state.documentOpenStates[row] = 1
            state.documentRenamePeerRows[row] = -1
            state.documentLastEventCids[row] = eventCid
            state.documentLastEventSourceVersions[row] =
                acceptedSourceVersion
            state.documentLastEventKinds[row] = eventKind
    elif eventKind == SemanticSourceEventChange:
        state.clientVersions[row] = clientVersion
        state.documentRenamePeerRows[row] = -1
        state.documentLastEventCids[row] = eventCid
        state.documentLastEventSourceVersions[row] = acceptedSourceVersion
        state.documentLastEventKinds[row] = eventKind
    elif eventKind == SemanticSourceEventClose:
        state.documentOpenStates[row] = 0
        state.documentRenamePeerRows[row] = -1
        state.documentLastEventCids[row] = eventCid
        state.documentLastEventSourceVersions[row] = acceptedSourceVersion
        state.documentLastEventKinds[row] = eventKind
    elif eventKind == SemanticSourceEventAdd:
        if row < 0:
            add(state.documentCids, layout.FixedBytes32Copy(documentCid))
            add(state.clientVersions, int64(0))
            add(state.documentOpenStates, 0)
            add(state.documentPresenceStates,
                SemanticSourcePresencePresent)
            add(state.documentRenamePeerRows, -1)
            add(state.documentLastEventCids, eventCid)
            add(state.documentLastEventSourceVersions,
                acceptedSourceVersion)
            add(state.documentLastEventKinds, eventKind)
        else:
            state.clientVersions[row] = 0
            state.documentOpenStates[row] = 0
            state.documentPresenceStates[row] =
                SemanticSourcePresencePresent
            state.documentRenamePeerRows[row] = -1
            state.documentLastEventCids[row] = eventCid
            state.documentLastEventSourceVersions[row] =
                acceptedSourceVersion
            state.documentLastEventKinds[row] = eventKind
    elif eventKind == SemanticSourceEventRemove:
        state.documentOpenStates[row] = 0
        state.documentPresenceStates[row] =
            SemanticSourcePresenceAbsent
        state.documentRenamePeerRows[row] = -1
        state.documentLastEventCids[row] = eventCid
        state.documentLastEventSourceVersions[row] =
            acceptedSourceVersion
        state.documentLastEventKinds[row] = eventKind
    else:
        let sourceOpenState = state.documentOpenStates[row]
        let sourceClientVersion = state.clientVersions[row]
        state.documentOpenStates[row] = 0
        state.documentPresenceStates[row] =
            SemanticSourcePresenceAbsent
        state.documentRenamePeerRows[row] = eventPeerRow
        state.documentLastEventCids[row] = eventCid
        state.documentLastEventSourceVersions[row] =
            acceptedSourceVersion
        state.documentLastEventKinds[row] = eventKind
        if renameTargetRow < 0:
            add(state.documentCids,
                layout.FixedBytes32Copy(renameTargetDocumentCid))
            add(state.clientVersions, sourceClientVersion)
            add(state.documentOpenStates, sourceOpenState)
            add(state.documentPresenceStates,
                SemanticSourcePresencePresent)
            add(state.documentRenamePeerRows, row)
            add(state.documentLastEventCids, eventCid)
            add(state.documentLastEventSourceVersions,
                acceptedSourceVersion)
            add(state.documentLastEventKinds, eventKind)
        else:
            state.clientVersions[renameTargetRow] =
                sourceClientVersion
            state.documentOpenStates[renameTargetRow] =
                sourceOpenState
            state.documentPresenceStates[renameTargetRow] =
                SemanticSourcePresencePresent
            state.documentRenamePeerRows[renameTargetRow] = row
            state.documentLastEventCids[renameTargetRow] = eventCid
            state.documentLastEventSourceVersions[renameTargetRow] =
                acceptedSourceVersion
            state.documentLastEventKinds[renameTargetRow] = eventKind
    sourceVersionOut = acceptedSourceVersion
    state.lastAcceptedSourceVersion = sourceVersionOut
    state.nextSourceVersion = state.nextSourceVersion + int64(1)
    state.eventStateReceiptCid =
        semanticSourceEventStateReceiptCid(state)
    return true

@borrows
fn semanticSnapshotBindingCanonicalEncodeInto(
        buf: var layout.ByteBuf,
        binding: LocalSourceVersionBinding) =
    semanticSnapshotAppendText(buf, SemanticSnapshotBindingDomain)
    semanticSnapshotAppendFixed32(buf, binding.workspaceSessionCid)
    semanticSnapshotAppendI32(buf, binding.schemaVersion)
    semanticSnapshotAppendI64(buf, binding.semanticEpoch)
    semanticSnapshotAppendI64(buf, binding.sourceVersion)
    semanticSnapshotAppendI32(buf, binding.documentCids.len)
    for index in 0..<binding.documentCids.len:
        semanticSnapshotAppendFixed32(buf, binding.documentCids[index])
        semanticSnapshotAppendI64(buf, binding.clientVersions[index])
        semanticSnapshotAppendI32(buf, binding.documentOpenStates[index])
        semanticSnapshotAppendI32(
            buf, binding.activeSourceStableRows[index])
    semanticSnapshotAppendFixed32(
        buf, binding.sourceEventStateReceiptCid)
    semanticSnapshotAppendFixed32(buf, binding.semanticSnapshotCid)
    semanticSnapshotAppendFixed32(buf, binding.worldHeadCid)
    semanticSnapshotAppendFixed32(buf, binding.compilerCid)
    semanticSnapshotAppendFixed32(buf, binding.sourceBundleCid)
    semanticSnapshotAppendFixed32(buf, binding.csgRootCid)

@borrows
fn semanticSnapshotBindingCid(
        binding: LocalSourceVersionBinding): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    semanticSnapshotBindingCanonicalEncodeInto(buf, binding)
    let out = semanticSnapshotHash(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn LocalSourceVersionBindingCanonicalRawInto(
        binding: LocalSourceVersionBinding,
        out: var rawbytes.Bytes) =
    out = rawbytes.EmptyBytes()
    var buf = layout.ByteBufInit(512)
    semanticSnapshotBindingCanonicalEncodeInto(buf, binding)
    out = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)

@borrows
fn SemanticSnapshotDocumentCidRowsCanonicalInto(
        documentCids: layout.FixedBytes32[],
        out: var int32[]): bool =
    var rows: int32[]
    var scratch: int32[]
    setLen(rows, documentCids.len)
    setLen(scratch, documentCids.len)
    for row in 0..<documentCids.len:
        rows[row] = row
    var counts: int32[]
    setLen(counts, 256)
    for passIndex in 0..<layout.FixedBytes32Size:
        for bucket in 0..<counts.len:
            counts[bucket] = 0
        let byteIndex = layout.FixedBytes32Size - 1 - passIndex
        for rowIndex in 0..<rows.len:
            let bucket = Int32(
                documentCids[rows[rowIndex]].data[byteIndex])
            counts[bucket] = counts[bucket] + 1
        var offset: int32
        for bucket in 0..<counts.len:
            let count = counts[bucket]
            counts[bucket] = offset
            offset = offset + count
        for rowIndex in 0..<rows.len:
            let row = rows[rowIndex]
            let bucket = Int32(documentCids[row].data[byteIndex])
            scratch[counts[bucket]] = row
            counts[bucket] = counts[bucket] + 1
        for rowIndex in 0..<rows.len:
            rows[rowIndex] = scratch[rowIndex]
    for rowIndex in 1..<rows.len:
        if layout.FixedBytes32Equal(
                documentCids[rows[rowIndex - 1]],
                documentCids[rows[rowIndex]]):
            return false
    out = rows
    return true

# Read-only over `eventState` and `identity`: their fields are validated and
# copied element-by-element into the fresh binding; neither is rebound,
# stored or released.
@borrows
fn LocalSourceVersionBindingMakeInto(
        eventState: WorkspaceSourceEventState,
        identity: PortableSemanticSnapshotIdentity,
        out: var LocalSourceVersionBinding,
        err: var str): bool =
    err = ""
    if !semanticSourceEventStateShapeValid(eventState) ||
       eventState.lastAcceptedSourceVersion <= 0:
        err = " semantic snapshot binding: no accepted source event"
        return false
    if !PortableSemanticSnapshotIdentityStrictValidateInto(identity, err):
        return false
    var binding: LocalSourceVersionBinding
    binding.workspaceSessionCid =
        layout.FixedBytes32Copy(eventState.workspaceSessionCid)
    binding.schemaVersion =
        snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    binding.semanticEpoch = eventState.lastAcceptedSourceVersion
    binding.sourceVersion = eventState.lastAcceptedSourceVersion
    binding.documentCids = []
    binding.clientVersions = []
    binding.documentOpenStates = []
    binding.activeSourceStableRows = []
    var activeStableRows: int32[]
    if !WorkspaceSourceEventActiveSourceRowsInto(
            eventState, activeStableRows, err):
        return false
    var activeDocumentCids: layout.FixedBytes32[]
    for index in 0..<activeStableRows.len:
        add(activeDocumentCids,
            layout.FixedBytes32Copy(
                eventState.documentCids[activeStableRows[index]]))
    var canonicalActiveRows: int32[]
    if !SemanticSnapshotDocumentCidRowsCanonicalInto(
            activeDocumentCids, canonicalActiveRows):
        err = " semantic snapshot binding: duplicate active document"
        return false
    for index in 0..<canonicalActiveRows.len:
        let activeRow = canonicalActiveRows[index]
        let stableRow = activeStableRows[activeRow]
        add(binding.documentCids,
            layout.FixedBytes32Copy(eventState.documentCids[stableRow]))
        add(binding.clientVersions, eventState.clientVersions[stableRow])
        add(binding.documentOpenStates,
            eventState.documentOpenStates[stableRow])
        add(binding.activeSourceStableRows, stableRow)
    binding.sourceEventStateReceiptCid =
        layout.FixedBytes32Copy(eventState.eventStateReceiptCid)
    binding.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    binding.worldHeadCid = layout.FixedBytes32Copy(identity.worldHeadCid)
    binding.compilerCid = layout.FixedBytes32Copy(identity.compilerCid)
    binding.sourceBundleCid =
        layout.FixedBytes32Copy(identity.sourceBundleCid)
    binding.csgRootCid = layout.FixedBytes32Copy(identity.csgRootCid)
    binding.bindingReceiptCid = semanticSnapshotBindingCid(binding)
    out = binding
    return true

@borrows
fn LocalSourceVersionBindingStrictValidateInto(
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        err: var str): bool =
    err = ""
    if binding.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       binding.semanticEpoch <= 0 ||
       binding.semanticEpoch != binding.sourceVersion ||
       binding.sourceVersion <= 0 ||
       binding.documentCids.len != binding.clientVersions.len ||
       binding.documentCids.len != binding.documentOpenStates.len ||
       binding.documentCids.len !=
           binding.activeSourceStableRows.len ||
       !semanticSnapshotRaw32Observed(
           binding.sourceEventStateReceiptCid) ||
       !semanticSnapshotRaw32Observed(binding.workspaceSessionCid):
        err = " semantic snapshot binding: invalid shape"
        return false
    if !PortableSemanticSnapshotIdentityStrictValidateInto(identity, err):
        return false
    for index in 0..<binding.documentCids.len:
        if !semanticSnapshotRaw32Observed(binding.documentCids[index]) ||
           binding.clientVersions[index] < 0 ||
           binding.activeSourceStableRows[index] < 0 ||
           (binding.documentOpenStates[index] != 0 &&
            binding.documentOpenStates[index] != 1):
            err = " semantic snapshot binding: invalid document row"
            return false
        for previous in 0..<index:
            if binding.activeSourceStableRows[previous] ==
                   binding.activeSourceStableRows[index]:
                err = " semantic snapshot binding: duplicate stable row"
                return false
    var canonicalDocumentRows: int32[]
    if !SemanticSnapshotDocumentCidRowsCanonicalInto(
            binding.documentCids, canonicalDocumentRows):
        err = " semantic snapshot binding: duplicate document row"
        return false
    for index in 0..<canonicalDocumentRows.len:
        if canonicalDocumentRows[index] != index:
            err = " semantic snapshot binding: non-canonical document order"
            return false
    if !layout.FixedBytes32Equal(binding.semanticSnapshotCid,
                                 identity.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(binding.worldHeadCid, identity.worldHeadCid) ||
       !layout.FixedBytes32Equal(binding.compilerCid, identity.compilerCid) ||
       !layout.FixedBytes32Equal(binding.sourceBundleCid,
                                 identity.sourceBundleCid) ||
       !layout.FixedBytes32Equal(binding.csgRootCid, identity.csgRootCid):
        err = " semantic snapshot binding: identity mismatch"
        return false
    let expected = semanticSnapshotBindingCid(binding)
    if !layout.FixedBytes32Equal(expected, binding.bindingReceiptCid):
        err = " semantic snapshot binding: receipt mismatch"
        return false
    return true

@borrows
fn semanticSnapshotValidationCid(
        receipt: SemanticSnapshotValidationReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    semanticSnapshotAppendText(buf, SemanticSnapshotValidationDomain)
    semanticSnapshotAppendFixed32(buf, receipt.bindingReceiptCid)
    semanticSnapshotAppendFixed32(buf, receipt.semanticSnapshotCid)
    semanticSnapshotAppendFixed32(buf, receipt.parserRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.typeRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.ownershipRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.callRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.layoutRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.dependencyRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.readSetRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.reachabilityRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.canonicalRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.lifecycleRootCid)
    semanticSnapshotAppendFixed32(buf, receipt.queryIndexRootCid)
    let out = semanticSnapshotHash(buf)
    layout.ByteBufFree(buf)
    return out

# Read-only over `binding` and `identity`: both are validated and their CIDs
# copied into the fresh receipt; neither is rebound, stored or released.
@borrows
fn SemanticSnapshotValidationReceiptMakeInto(
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        parserRootCid: layout.FixedBytes32,
        typeRootCid: layout.FixedBytes32,
        ownershipRootCid: layout.FixedBytes32,
        callRootCid: layout.FixedBytes32,
        layoutRootCid: layout.FixedBytes32,
        dependencyRootCid: layout.FixedBytes32,
        readSetRootCid: layout.FixedBytes32,
        reachabilityRootCid: layout.FixedBytes32,
        lifecycleRootCid: layout.FixedBytes32,
        queryIndexRootCid: layout.FixedBytes32,
        out: var SemanticSnapshotValidationReceipt,
        err: var str): bool =
    if !LocalSourceVersionBindingStrictValidateInto(binding, identity, err):
        return false
    if !semanticSnapshotRaw32Observed(parserRootCid) ||
       !semanticSnapshotRaw32Observed(typeRootCid) ||
       !semanticSnapshotRaw32Observed(ownershipRootCid) ||
       !semanticSnapshotRaw32Observed(callRootCid) ||
       !semanticSnapshotRaw32Observed(layoutRootCid) ||
       !semanticSnapshotRaw32Observed(dependencyRootCid) ||
       !semanticSnapshotRaw32Observed(readSetRootCid) ||
       !semanticSnapshotRaw32Observed(reachabilityRootCid) ||
       !semanticSnapshotRaw32Observed(lifecycleRootCid) ||
       !semanticSnapshotRaw32Observed(queryIndexRootCid):
        err = " semantic snapshot validation: unobserved proof root"
        return false
    var receipt: SemanticSnapshotValidationReceipt
    receipt.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    receipt.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    receipt.parserRootCid = layout.FixedBytes32Copy(parserRootCid)
    receipt.typeRootCid = layout.FixedBytes32Copy(typeRootCid)
    receipt.ownershipRootCid = layout.FixedBytes32Copy(ownershipRootCid)
    receipt.callRootCid = layout.FixedBytes32Copy(callRootCid)
    receipt.layoutRootCid = layout.FixedBytes32Copy(layoutRootCid)
    receipt.dependencyRootCid = layout.FixedBytes32Copy(dependencyRootCid)
    receipt.readSetRootCid = layout.FixedBytes32Copy(readSetRootCid)
    receipt.reachabilityRootCid =
        layout.FixedBytes32Copy(reachabilityRootCid)
    receipt.canonicalRootCid = layout.FixedBytes32Copy(identity.csgRootCid)
    receipt.lifecycleRootCid = layout.FixedBytes32Copy(lifecycleRootCid)
    receipt.queryIndexRootCid =
        layout.FixedBytes32Copy(queryIndexRootCid)
    receipt.validationReceiptCid = semanticSnapshotValidationCid(receipt)
    out = receipt
    err = ""
    return true

@borrows
fn SemanticSnapshotValidationReceiptStrictValidateInto(
        receipt: SemanticSnapshotValidationReceipt,
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        err: var str): bool =
    if !LocalSourceVersionBindingStrictValidateInto(binding, identity, err):
        err = " semantic snapshot validation: invalid binding"
        return false
    if !layout.FixedBytes32Equal(receipt.bindingReceiptCid,
                                 binding.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.semanticSnapshotCid,
                                 identity.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(receipt.canonicalRootCid,
                                 identity.csgRootCid):
        err = " semantic snapshot validation: snapshot mismatch"
        return false
    if !semanticSnapshotRaw32Observed(receipt.parserRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.typeRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.ownershipRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.callRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.layoutRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.dependencyRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.readSetRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.reachabilityRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.lifecycleRootCid) ||
       !semanticSnapshotRaw32Observed(receipt.queryIndexRootCid):
        err = " semantic snapshot validation: unobserved proof root"
        return false
    let expected = semanticSnapshotValidationCid(receipt)
    if !layout.FixedBytes32Equal(expected, receipt.validationReceiptCid):
        err = " semantic snapshot validation: receipt mismatch"
        return false
    err = ""
    return true

@borrows
fn semanticSnapshotFailureCid(
        receipt: SemanticSnapshotFailureReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    semanticSnapshotAppendText(buf, SemanticSnapshotFailureDomain)
    semanticSnapshotAppendFixed32(buf, receipt.bindingReceiptCid)
    semanticSnapshotAppendFixed32(buf, receipt.semanticSnapshotCid)
    semanticSnapshotAppendI64(buf, receipt.sourceVersion)
    semanticSnapshotAppendI32(buf, receipt.reasonCode)
    semanticSnapshotAppendFixed32(buf, receipt.diagnosticRootCid)
    let out = semanticSnapshotHash(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn SemanticSnapshotFailureReceiptMakeInto(
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        reasonCode: int32,
        diagnosticRootCid: layout.FixedBytes32,
        out: var SemanticSnapshotFailureReceipt,
        err: var str): bool =
    if !LocalSourceVersionBindingStrictValidateInto(binding, identity, err):
        return false
    if reasonCode <= 0 || !semanticSnapshotRaw32Observed(diagnosticRootCid):
        err = " semantic snapshot failure: invalid reason"
        return false
    var receipt: SemanticSnapshotFailureReceipt
    receipt.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    receipt.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    receipt.sourceVersion = binding.sourceVersion
    receipt.reasonCode = reasonCode
    receipt.diagnosticRootCid = layout.FixedBytes32Copy(diagnosticRootCid)
    receipt.failureReceiptCid = semanticSnapshotFailureCid(receipt)
    out = receipt
    err = ""
    return true

@borrows
fn SemanticSnapshotFailureReceiptStrictValidateInto(
        receipt: SemanticSnapshotFailureReceipt,
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        err: var str): bool =
    if receipt.sourceVersion != binding.sourceVersion ||
       receipt.reasonCode <= 0 ||
       !semanticSnapshotRaw32Observed(receipt.diagnosticRootCid) ||
       !LocalSourceVersionBindingStrictValidateInto(binding, identity, err):
        err = " semantic snapshot failure: invalid receipt"
        return false
    if !layout.FixedBytes32Equal(receipt.bindingReceiptCid,
                                 binding.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.semanticSnapshotCid,
                                 identity.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(semanticSnapshotFailureCid(receipt),
                                 receipt.failureReceiptCid):
        err = " semantic snapshot failure: receipt mismatch"
        return false
    err = ""
    return true

@borrows
fn SemanticSnapshotStoreInitInto(
        workspaceSessionCid: layout.FixedBytes32,
        out: var SemanticSnapshotStore,
        err: var str): bool =
    err = ""
    if !semanticSnapshotRaw32Observed(workspaceSessionCid):
        err = " semantic snapshot store: invalid workspace session"
        return false
    let ownedWorkspaceSessionCid = layout.FixedBytes32Copy(workspaceSessionCid)
    var store: SemanticSnapshotStore
    store.workspaceSessionCid = ownedWorkspaceSessionCid
    store.publishedIndex = -1
    store.candidateIndex = -1
    store.states = []
    store.schemaVersions = []
    store.semanticEpochs = []
    store.sourceVersions = []
    store.sourceIdentityReceiptCids = []
    store.semanticSnapshotCids = []
    store.worldHeadCids = []
    store.compilerCids = []
    store.sourceBundleCids = []
    store.csgRootCids = []
    store.bindingReceiptCids = []
    store.validationReceiptCids = []
    store.failureReceiptCids = []
    store.borrowCounts = []
    out = store
    return true

@borrows
fn semanticSnapshotStoreColumnShapeValidNoAlloc(
        store: SemanticSnapshotStore): bool =
    let count = store.states.len
    return store.currentSourceVersion >= 0 &&
           count == store.schemaVersions.len &&
           count == store.semanticEpochs.len &&
           count == store.sourceVersions.len &&
           count == store.sourceIdentityReceiptCids.len &&
           count == store.semanticSnapshotCids.len &&
           count == store.worldHeadCids.len &&
           count == store.compilerCids.len &&
           count == store.sourceBundleCids.len &&
           count == store.csgRootCids.len &&
           count == store.bindingReceiptCids.len &&
           count == store.validationReceiptCids.len &&
           count == store.failureReceiptCids.len &&
           count == store.borrowCounts.len &&
           store.publishedIndex >= -1 && store.publishedIndex < count &&
           store.candidateIndex >= -1 && store.candidateIndex < count

@borrows
fn SemanticSnapshotStoreShapeValid(store: SemanticSnapshotStore): bool =
    return semanticSnapshotStoreColumnShapeValidNoAlloc(store) &&
           semanticSnapshotRaw32Observed(store.workspaceSessionCid)

@borrows
fn SemanticSnapshotStoreStrictValidateInto(
        store: SemanticSnapshotStore,
        err: var str): bool =
    err = ""
    if !SemanticSnapshotStoreShapeValid(store):
        err = " semantic snapshot store: invalid shape"
        return false
    for row in 0..<store.states.len:
        let state = store.states[row]
        let borrows = store.borrowCounts[row]
        if state < SemanticSnapshotStateBuilding ||
           state > SemanticSnapshotStateReleased ||
           store.schemaVersions[row] !=
               snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
           store.semanticEpochs[row] <= 0 ||
           store.semanticEpochs[row] != store.sourceVersions[row] ||
           store.sourceVersions[row] <= 0 ||
           store.sourceVersions[row] > store.currentSourceVersion || borrows < 0 ||
           !semanticSnapshotRaw32Observed(store.sourceIdentityReceiptCids[row]) ||
           !semanticSnapshotRaw32Observed(store.semanticSnapshotCids[row]) ||
           !semanticSnapshotRaw32Observed(store.worldHeadCids[row]) ||
           !semanticSnapshotRaw32Observed(store.compilerCids[row]) ||
           !semanticSnapshotRaw32Observed(store.sourceBundleCids[row]) ||
           !semanticSnapshotRaw32Observed(store.csgRootCids[row]) ||
           !semanticSnapshotRaw32Observed(store.bindingReceiptCids[row]):
            err = " semantic snapshot store: invalid row"
            return false
        let expectedSnapshotCid = semanticSnapshotIdentityCid(
            store.sourceIdentityReceiptCids[row], store.worldHeadCids[row],
            store.compilerCids[row], store.sourceBundleCids[row],
            store.csgRootCids[row])
        if !layout.FixedBytes32Equal(expectedSnapshotCid,
                                     store.semanticSnapshotCids[row]):
            err = " semantic snapshot store: identity columns diverged"
            return false
        if state == SemanticSnapshotStateBuilding &&
           semanticSnapshotRaw32Observed(store.validationReceiptCids[row]):
            err = " semantic snapshot store: building row has validation"
            return false
        if (state == SemanticSnapshotStateValidated ||
            state == SemanticSnapshotStatePublished ||
            state == SemanticSnapshotStateRetired ||
            state == SemanticSnapshotStateReleased) &&
           !semanticSnapshotRaw32Observed(store.validationReceiptCids[row]):
            err = " semantic snapshot store: validated row lost proof"
            return false
        if state == SemanticSnapshotStateRejected:
            if !semanticSnapshotRaw32Observed(store.failureReceiptCids[row]):
                err = " semantic snapshot store: rejected row lost failure proof"
                return false
        elif semanticSnapshotRaw32Observed(store.failureReceiptCids[row]):
            err = " semantic snapshot store: non-rejected row has failure proof"
            return false
        if state == SemanticSnapshotStatePublished:
            if row != store.publishedIndex:
                err = " semantic snapshot store: unindexed published row"
                return false
        elif row == store.publishedIndex:
            err = " semantic snapshot store: published index state mismatch"
            return false
        if state == SemanticSnapshotStateBuilding ||
           state == SemanticSnapshotStateValidated:
            if row != store.candidateIndex || borrows != 0 ||
               store.sourceVersions[row] != store.currentSourceVersion:
                err = " semantic snapshot store: candidate row mismatch"
                return false
        elif row == store.candidateIndex:
            err = " semantic snapshot store: candidate index state mismatch"
            return false
        if state == SemanticSnapshotStateRetired:
            if borrows <= 0:
                err = " semantic snapshot store: empty retired row"
                return false
        elif state != SemanticSnapshotStatePublished && borrows != 0:
            err = " semantic snapshot store: borrow on inactive row"
            return false
    return true

fn SemanticSnapshotStoreAdvanceToAcceptedVersionInto(
        store: var SemanticSnapshotStore,
        sourceVersion: int64,
        err: var str): bool =
    err = ""
    if !semanticSnapshotStoreColumnShapeValidNoAlloc(store):
        err = " semantic snapshot store: invalid shape"
        return false
    if store.currentSourceVersion == int64(9223372036854775807) ||
       sourceVersion != store.currentSourceVersion + int64(1):
        err = " semantic snapshot store: source version must advance by one"
        return false
    if store.candidateIndex >= 0:
        let candidate = store.candidateIndex
        if store.states[candidate] != SemanticSnapshotStateBuilding &&
           store.states[candidate] != SemanticSnapshotStateValidated:
            err = " semantic snapshot store: invalid candidate state"
            return false
        if store.borrowCounts[candidate] != 0:
            err = " semantic snapshot store: borrowed candidate"
            return false
        store.states[candidate] = SemanticSnapshotStateCancelled
        store.candidateIndex = -1
    store.currentSourceVersion = sourceVersion
    return true

@borrows
fn SemanticSnapshotStoreBeginCandidateInto(
        store: var SemanticSnapshotStore,
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        candidateIndexOut: var int32,
        err: var str): bool =
    candidateIndexOut = -1
    if !SemanticSnapshotStoreShapeValid(store) ||
       !LocalSourceVersionBindingStrictValidateInto(binding, identity, err):
        err = " semantic snapshot store: invalid candidate input"
        return false
    if !layout.FixedBytes32Equal(store.workspaceSessionCid,
                                 binding.workspaceSessionCid) ||
       binding.sourceVersion != store.currentSourceVersion ||
       store.currentSourceVersion <= 0 || store.candidateIndex >= 0:
        err = " semantic snapshot store: candidate version mismatch"
        return false
    if store.publishedIndex >= 0 &&
       store.states[store.publishedIndex] != SemanticSnapshotStatePublished:
        err = " semantic snapshot store: published row mismatch"
        return false
    let row = store.states.len
    add(store.states, SemanticSnapshotStateBuilding)
    add(store.schemaVersions, binding.schemaVersion)
    add(store.semanticEpochs, binding.semanticEpoch)
    add(store.sourceVersions, binding.sourceVersion)
    add(store.sourceIdentityReceiptCids,
        layout.FixedBytes32Copy(identity.sourceIdentityReceiptCid))
    add(store.semanticSnapshotCids,
        layout.FixedBytes32Copy(identity.semanticSnapshotCid))
    add(store.worldHeadCids, layout.FixedBytes32Copy(identity.worldHeadCid))
    add(store.compilerCids, layout.FixedBytes32Copy(identity.compilerCid))
    add(store.sourceBundleCids,
        layout.FixedBytes32Copy(identity.sourceBundleCid))
    add(store.csgRootCids, layout.FixedBytes32Copy(identity.csgRootCid))
    add(store.bindingReceiptCids,
        layout.FixedBytes32Copy(binding.bindingReceiptCid))
    add(store.validationReceiptCids, layout.FixedBytes32())
    add(store.failureReceiptCids, layout.FixedBytes32())
    add(store.borrowCounts, 0)
    store.candidateIndex = row
    candidateIndexOut = row
    err = ""
    return true

@borrows
fn semanticSnapshotStoreCandidateMatches(
        store: SemanticSnapshotStore,
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity): bool =
    let row = store.candidateIndex
    if row < 0 || row >= store.states.len ||
       store.schemaVersions[row] != binding.schemaVersion ||
       store.semanticEpochs[row] != binding.semanticEpoch ||
       store.sourceVersions[row] != binding.sourceVersion:
        return false
    return layout.FixedBytes32Equal(store.bindingReceiptCids[row],
                                    binding.bindingReceiptCid) &&
           layout.FixedBytes32Equal(store.semanticSnapshotCids[row],
                                    identity.semanticSnapshotCid) &&
           layout.FixedBytes32Equal(store.sourceIdentityReceiptCids[row],
                                    identity.sourceIdentityReceiptCid) &&
           layout.FixedBytes32Equal(store.worldHeadCids[row],
                                    identity.worldHeadCid) &&
           layout.FixedBytes32Equal(store.compilerCids[row],
                                    identity.compilerCid) &&
           layout.FixedBytes32Equal(store.sourceBundleCids[row],
                                    identity.sourceBundleCid) &&
           layout.FixedBytes32Equal(store.csgRootCids[row], identity.csgRootCid)

@borrows
fn SemanticSnapshotStoreValidateCandidateInto(
        store: var SemanticSnapshotStore,
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        receipt: SemanticSnapshotValidationReceipt,
        err: var str): bool =
    if !semanticSnapshotStoreColumnShapeValidNoAlloc(store) ||
       !semanticSnapshotStoreCandidateMatches(store, binding, identity) ||
       store.states[store.candidateIndex] != SemanticSnapshotStateBuilding ||
       !SemanticSnapshotValidationReceiptStrictValidateInto(
            receipt, binding, identity, err):
        err = " semantic snapshot store: candidate validation failed"
        return false
    let row = store.candidateIndex
    store.validationReceiptCids[row] =
        layout.FixedBytes32Copy(receipt.validationReceiptCid)
    store.states[row] = SemanticSnapshotStateValidated
    err = ""
    return true

@borrows
fn SemanticSnapshotStoreStageCandidateFailureInto(
        store: SemanticSnapshotStore,
        binding: LocalSourceVersionBinding,
        identity: PortableSemanticSnapshotIdentity,
        receipt: SemanticSnapshotFailureReceipt,
        out: var SemanticSnapshotCandidateFailureStage,
        err: var str): bool =
    if out.active ||
       !semanticSnapshotStoreColumnShapeValidNoAlloc(store) ||
       !semanticSnapshotStoreCandidateMatches(store, binding, identity) ||
       store.states[store.candidateIndex] != SemanticSnapshotStateBuilding ||
       !SemanticSnapshotFailureReceiptStrictValidateInto(
            receipt, binding, identity, err):
        err = " semantic snapshot store: candidate failure staging failed"
        return false
    let row = store.candidateIndex
    out.candidateIndex = row
    out.sourceVersion = binding.sourceVersion
    out.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    out.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    out.failureReceiptCid =
        layout.FixedBytes32Copy(receipt.failureReceiptCid)
    out.active = true
    err = ""
    return true

fn SemanticSnapshotStoreCommitRejectedCandidateInto(
        store: var SemanticSnapshotStore,
        stage: var SemanticSnapshotCandidateFailureStage,
        rejectedIndexOut: var int32) =
    rejectedIndexOut = -1
    if !semanticSnapshotStoreColumnShapeValidNoAlloc(store) ||
       store.candidateIndex < 0:
        panic("semantic_snapshot_reject_commit_candidate_missing")
    let candidate = store.candidateIndex
    if store.states[candidate] != SemanticSnapshotStateBuilding ||
       store.borrowCounts[candidate] != 0 ||
       !stage.active || stage.candidateIndex != candidate ||
       stage.sourceVersion != store.sourceVersions[candidate] ||
       !layout.FixedBytes32Equal(
           stage.bindingReceiptCid, store.bindingReceiptCids[candidate]) ||
       !layout.FixedBytes32Equal(
           stage.semanticSnapshotCid, store.semanticSnapshotCids[candidate]) ||
       layout.FixedBytes32Equal(stage.failureReceiptCid,
                                layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(store.failureReceiptCids[candidate],
                                 layout.FixedBytes32()):
        panic("semantic_snapshot_reject_commit_stage_drift")
    store.failureReceiptCids[candidate] =
        layout.FixedBytes32Copy(stage.failureReceiptCid)
    store.states[candidate] = SemanticSnapshotStateRejected
    store.candidateIndex = -1
    rejectedIndexOut = candidate
    stage = SemanticSnapshotCandidateFailureStage()

# All fallible validation and all row allocation finish in Begin/Validate.
# This terminal commit only flips scalar state/index fields. Any mismatch is
# internal corruption and must crash instead of exposing a recoverable split.
fn SemanticSnapshotStoreCommitCandidateInto(
        store: var SemanticSnapshotStore,
        publishedIndexOut: var int32) =
    publishedIndexOut = -1
    if !semanticSnapshotStoreColumnShapeValidNoAlloc(store) ||
       store.candidateIndex < 0:
        panic("semantic_snapshot_publish_commit_candidate_missing")
    let candidate = store.candidateIndex
    if store.states[candidate] != SemanticSnapshotStateValidated ||
       store.sourceVersions[candidate] != store.currentSourceVersion ||
       store.borrowCounts[candidate] != 0 ||
       layout.FixedBytes32Equal(store.validationReceiptCids[candidate],
                                layout.FixedBytes32()):
        panic("semantic_snapshot_publish_commit_stage_drift")
    let previous = store.publishedIndex
    if previous >= 0:
        if store.states[previous] != SemanticSnapshotStatePublished ||
           store.borrowCounts[previous] < 0:
            panic("semantic_snapshot_publish_commit_previous_drift")
        if store.borrowCounts[previous] > 0:
            store.states[previous] = SemanticSnapshotStateRetired
        else:
            store.states[previous] = SemanticSnapshotStateReleased
    store.states[candidate] = SemanticSnapshotStatePublished
    store.publishedIndex = candidate
    store.candidateIndex = -1
    publishedIndexOut = candidate

@borrows
fn semanticSnapshotStorePublishedRowStrict(
        store: SemanticSnapshotStore,
        row: int32): bool =
    if row < 0 || row >= store.states.len ||
       row != store.publishedIndex ||
       store.states[row] != SemanticSnapshotStatePublished ||
       store.schemaVersions[row] !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       store.semanticEpochs[row] <= 0 ||
       store.semanticEpochs[row] != store.sourceVersions[row] ||
       store.sourceVersions[row] <= 0 ||
       store.sourceVersions[row] > store.currentSourceVersion ||
       store.borrowCounts[row] < 0 ||
       !semanticSnapshotRaw32Observed(
           store.sourceIdentityReceiptCids[row]) ||
       !semanticSnapshotRaw32Observed(store.semanticSnapshotCids[row]) ||
       !semanticSnapshotRaw32Observed(store.worldHeadCids[row]) ||
       !semanticSnapshotRaw32Observed(store.compilerCids[row]) ||
       !semanticSnapshotRaw32Observed(store.sourceBundleCids[row]) ||
       !semanticSnapshotRaw32Observed(store.csgRootCids[row]) ||
       !semanticSnapshotRaw32Observed(store.bindingReceiptCids[row]) ||
       !semanticSnapshotRaw32Observed(store.validationReceiptCids[row]) ||
       semanticSnapshotRaw32Observed(store.failureReceiptCids[row]):
        return false
    let expectedSnapshotCid = semanticSnapshotIdentityCid(
        store.sourceIdentityReceiptCids[row], store.worldHeadCids[row],
        store.compilerCids[row], store.sourceBundleCids[row],
        store.csgRootCids[row])
    return layout.FixedBytes32Equal(
        expectedSnapshotCid, store.semanticSnapshotCids[row])

fn semanticSnapshotStorePinPublishedRow(
        store: var SemanticSnapshotStore,
        row: int32,
        pinOut: var SemanticSnapshotPin) =
    store.borrowCounts[row] = store.borrowCounts[row] + 1
    pinOut.snapshotIndex = row
    pinOut.schemaVersion = store.schemaVersions[row]
    pinOut.semanticEpoch = store.semanticEpochs[row]
    pinOut.sourceVersion = store.sourceVersions[row]
    pinOut.bindingReceiptCid =
        layout.FixedBytes32Copy(store.bindingReceiptCids[row])
    pinOut.active = true

fn SemanticSnapshotStorePinCurrentInto(
        store: var SemanticSnapshotStore,
        pinOut: var SemanticSnapshotPin,
        err: var str): bool =
    if pinOut.active ||
       !semanticSnapshotStoreColumnShapeValidNoAlloc(store) ||
       store.publishedIndex < 0:
        err = " semantic snapshot store: no published snapshot"
        return false
    let row = store.publishedIndex
    if store.candidateIndex >= 0 ||
       !semanticSnapshotStorePublishedRowStrict(store, row) ||
       store.sourceVersions[row] != store.currentSourceVersion:
        err = " semantic snapshot store: current version is not published"
        return false
    if store.borrowCounts[row] == 2147483647:
        err = " semantic snapshot store: borrow count exhausted"
        return false
    semanticSnapshotStorePinPublishedRow(store, row, pinOut)
    err = ""
    return true

# Compiler-owned incremental builders may pin only the last atomically
# published snapshot after an event has advanced currentSourceVersion. Query
# consumers keep using PinCurrentInto and therefore can never observe this
# predecessor as the current semantic answer.
fn SemanticSnapshotStorePinPublishedPredecessorInto(
        store: var SemanticSnapshotStore,
        expectedCurrentSourceVersion: int64,
        pinOut: var SemanticSnapshotPin,
        err: var str): bool =
    if pinOut.active ||
       !semanticSnapshotStoreColumnShapeValidNoAlloc(store) ||
       store.publishedIndex < 0:
        err = " semantic snapshot store: no published predecessor"
        return false
    let row = store.publishedIndex
    if expectedCurrentSourceVersion <= 0 ||
       store.currentSourceVersion != expectedCurrentSourceVersion ||
       store.candidateIndex != -1 ||
       !semanticSnapshotStorePublishedRowStrict(store, row) ||
       store.sourceVersions[row] >= expectedCurrentSourceVersion:
        err = " semantic snapshot store: published predecessor mismatch"
        return false
    if store.borrowCounts[row] == 2147483647:
        err = " semantic snapshot store: borrow count exhausted"
        return false
    semanticSnapshotStorePinPublishedRow(store, row, pinOut)
    err = ""
    return true

fn SemanticSnapshotStoreReleasePinInto(
        store: var SemanticSnapshotStore,
        pin: var SemanticSnapshotPin,
        err: var str): bool =
    if !semanticSnapshotStoreColumnShapeValidNoAlloc(store) || !pin.active ||
       pin.snapshotIndex < 0 || pin.snapshotIndex >= store.states.len:
        err = " semantic snapshot store: invalid pin"
        return false
    let row = pin.snapshotIndex
    if (store.states[row] != SemanticSnapshotStatePublished &&
        store.states[row] != SemanticSnapshotStateRetired) ||
       pin.schemaVersion != store.schemaVersions[row] ||
       pin.semanticEpoch != store.semanticEpochs[row] ||
       pin.sourceVersion != store.sourceVersions[row] ||
       !layout.FixedBytes32Equal(pin.bindingReceiptCid,
                                 store.bindingReceiptCids[row]) ||
       store.borrowCounts[row] <= 0:
        err = " semantic snapshot store: pin identity mismatch"
        return false
    store.borrowCounts[row] = store.borrowCounts[row] - 1
    if store.borrowCounts[row] == 0 &&
       store.states[row] == SemanticSnapshotStateRetired:
        store.states[row] = SemanticSnapshotStateReleased
    pin = SemanticSnapshotPin()
    err = ""
    return true

@borrows
fn SemanticSnapshotAcceptSourceEventInto(
        eventState: var WorkspaceSourceEventState,
        store: var SemanticSnapshotStore,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        clientVersion: int64,
        sourceVersionOut: var int64,
        err: var str): bool =
    sourceVersionOut = 0
    if !semanticSourceEventStateShapeValid(eventState) ||
       !semanticSourceEventDocumentIdentitiesUnique(eventState) ||
       !SemanticSnapshotStoreShapeValid(store) ||
       !layout.FixedBytes32Equal(eventState.workspaceSessionCid,
                                 store.workspaceSessionCid) ||
       eventState.lastAcceptedSourceVersion != store.currentSourceVersion:
        err = " semantic snapshot event: workspace state mismatch"
        return false
    # Validate against a scalar-only shadow first.  The real mutation and the
    # store advance then execute under the same exclusive `var` borrow.
    let expectedVersion = eventState.nextSourceVersion
    let row = semanticSourceEventFindDocument(eventState, documentCid)
    if !semanticSnapshotRaw32Observed(documentCid):
        err = " semantic snapshot event: invalid document identity"
        return false
    if eventKind == SemanticSourceEventOpen:
        if clientVersion < 0 ||
           (row >= 0 &&
            (eventState.documentPresenceStates[row] !=
                 SemanticSourcePresencePresent ||
             eventState.documentOpenStates[row] != 0)):
            err = " semantic snapshot event: invalid open"
            return false
        if row >= 0 &&
           (eventState.clientVersions[row] ==
                int64(9223372036854775807) ||
            clientVersion !=
                eventState.clientVersions[row] + int64(1)):
            err =
                " semantic snapshot event: invalid reopen client version"
            return false
    elif eventKind == SemanticSourceEventChange:
        if row < 0 ||
           eventState.documentPresenceStates[row] !=
               SemanticSourcePresencePresent ||
           eventState.documentOpenStates[row] == 0 ||
           eventState.clientVersions[row] == int64(9223372036854775807) ||
           clientVersion != eventState.clientVersions[row] + int64(1):
            err = " semantic snapshot event: invalid client version"
            return false
    elif eventKind == SemanticSourceEventClose:
        if row < 0 ||
           eventState.documentPresenceStates[row] !=
               SemanticSourcePresencePresent ||
           eventState.documentOpenStates[row] == 0 ||
           clientVersion != int64(-1):
            err = " semantic snapshot event: invalid close"
            return false
    else:
        err = " semantic snapshot event: unknown event kind"
        return false
    if expectedVersion == int64(9223372036854775807) ||
       store.currentSourceVersion == int64(9223372036854775807) ||
       expectedVersion != store.currentSourceVersion + int64(1):
        err = " semantic snapshot event: source version exhausted or split"
        return false
    if store.candidateIndex >= 0:
        let candidate = store.candidateIndex
        if store.states[candidate] != SemanticSnapshotStateBuilding &&
           store.states[candidate] != SemanticSnapshotStateValidated:
            err = " semantic snapshot event: invalid candidate state"
            return false

    if !WorkspaceSourceEventAcceptInto(
            eventState, eventKind, documentCid, clientVersion,
            sourceVersionOut, err):
        panic("semantic_snapshot_prevalidated_event_rejected")
    if sourceVersionOut != expectedVersion ||
       !SemanticSnapshotStoreAdvanceToAcceptedVersionInto(
            store, sourceVersionOut, err):
        panic("semantic_snapshot_atomic_event_store_drift")
    err = ""
    return true

@borrows
fn SemanticSnapshotAcceptSourceFileEventInto(
        eventState: var WorkspaceSourceEventState,
        store: var SemanticSnapshotStore,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        renameTargetDocumentCid: layout.FixedBytes32,
        sourceVersionOut: var int64,
        err: var str): bool =
    sourceVersionOut = 0
    if !semanticSourceEventStateShapeValid(eventState) ||
       !SemanticSnapshotStoreShapeValid(store) ||
       !layout.FixedBytes32Equal(eventState.workspaceSessionCid,
                                 store.workspaceSessionCid) ||
       eventState.lastAcceptedSourceVersion != store.currentSourceVersion ||
       (eventKind != SemanticSourceEventAdd &&
        eventKind != SemanticSourceEventRemove &&
        eventKind != SemanticSourceEventRename):
        err = " semantic snapshot file event: workspace state mismatch"
        return false
    let expectedVersion = eventState.nextSourceVersion
    if expectedVersion == int64(9223372036854775807) ||
       store.currentSourceVersion == int64(9223372036854775807) ||
       expectedVersion != store.currentSourceVersion + int64(1):
        err = " semantic snapshot file event: source version exhausted or split"
        return false
    if store.candidateIndex >= 0:
        let candidate = store.candidateIndex
        if store.states[candidate] != SemanticSnapshotStateBuilding &&
           store.states[candidate] != SemanticSnapshotStateValidated:
            err = " semantic snapshot file event: invalid candidate state"
            return false
    if !WorkspaceSourceFileEventAcceptInto(
            eventState, eventKind, documentCid,
            renameTargetDocumentCid, sourceVersionOut, err):
        return false
    if sourceVersionOut != expectedVersion ||
       !SemanticSnapshotStoreAdvanceToAcceptedVersionInto(
            store, sourceVersionOut, err):
        panic("semantic_snapshot_atomic_file_event_store_drift")
    err = ""
    return true
