// cheng_build_main.cheng — CLI entry for "cheng build"
//
// Usage:
//   cheng build --target:<triple> --out:<path> [--root:<dir>] <entry.cheng>
//
// The build command:
//   1. Resolves all transitive imports of the entry file
//   2. Compiles each module to .o via --emit:obj
//   3. Links all .o into an executable via system linker (cc)

import std/cmdline
import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/core/tooling/cheng_build as build
import cheng/core/tooling/path as chengpath

const
    ChengBuildMainVersion = "cheng.build.v0.1.0"

fn main(args: int32): int32 =
    // Parse CLI arguments
    let count: int32 = cmdline.ParamCount()
    if count <= 0:
        os.WriteLine(os.Get_stdout(), "cheng build: usage: cheng build --target:<triple> --out:<path> [--root:<dir>] <entry.cheng>")
        return 1

    var targetTriple = build.BuildDefaultTargetTriple
    var outPath: str
    var rootDir = chengpath.PathCurrentDir()
    var entryPath: str
    var showPlan = false

    for i in 1..count:
        let arg: str = cmdline.ParamStr(i)
        if strutil.StartsWith(arg, "--target:"):
            targetTriple = strings.SliceBytes(arg, 9, arg.len - 9)
        elif strutil.StartsWith(arg, "--out:"):
            outPath = strings.SliceBytes(arg, 6, arg.len - 6)
        elif strutil.StartsWith(arg, "--root:"):
            rootDir = strings.SliceBytes(arg, 7, arg.len - 7)
        elif arg == "--plan":
            showPlan = true
        elif arg == "--help" || arg == "-h":
            os.WriteLine(os.Get_stdout(), "cheng build --target:<triple> --out:<path> [--root:<dir>] [--plan] <entry.cheng>")
            return 0
        elif arg == "--version":
            os.WriteLine(os.Get_stdout(), ChengBuildMainVersion)
            return 0
        else:
            entryPath = arg

    if entryPath.len <= 0:
        os.WriteLine(os.Get_stdout(), "cheng build: missing entry file")
        return 1
    if outPath.len <= 0:
        outPath = strutil.Join([chengpath.PathCurrentDir(), "/a.out"], "")

    // Resolve build plan
    let plan = build.BuildPlanFromEntry(entryPath, rootDir, targetTriple)

    if showPlan:
        os.WriteLine(os.Get_stdout(), build.BuildPlanToString(plan))
        return 0

    if plan.sourceCount <= 0:
        os.WriteLine(os.Get_stdout(), "cheng build: no source files found")
        return 1

    // Compile and link
    let result = build.BuildLinkAll(plan, outPath)
    let report = build.BuildResultToString(result)
    os.WriteLine(os.Get_stdout(), report)

    if !result.linkOk:
        os.WriteLine(os.Get_stdout(), strutil.Join(["cheng build: FAIL (compile ", IntToStr(result.compileOk), "/", IntToStr(result.compileCount), " ok, link ", result.linkOk ? "ok" : "FAIL", ")"], ""))
        return 1

    os.WriteLine(os.Get_stdout(), strutil.Join(["cheng build: ok (", IntToStr(result.compileOk), " modules, out=", strings.CloneStr(result.outPath), ")"], ""))
    return 0
