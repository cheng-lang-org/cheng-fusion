    if outCopied:
        return true
    let directSource: str = os.JoinPath(sourceRoot, "unimaker_scene_data.bin")
    let runtimeSource: str = os.JoinPath(sourceRoot, MobileShellRuntimeSceneDataRelPath())
    var sourcePath: str
    if os.FileExists(directSource):
        sourcePath = directSource
    elif os.FileExists(runtimeSource):
        sourcePath = runtimeSource
    else:
