	                "{{\"ok\":false,\"error\":\"social_synccast_refresh_failed\"}}"
	            }}
	        }}

	        private fun chengRegionPolicyFromCountry(countryCode: String, source: String): JSONObject {{
	            val normalized = countryCode.trim().uppercase(java.util.Locale.ROOT)
	            val domestic = normalized == "CN"
	            val policy = JSONObject()
	            policy.put("policyGroupId", if (domestic) "CN" else "INTL")
	            policy.put("isDomestic", domestic)
	            policy.put("countryCode", normalized)
	            policy.put("source", source)
	            policy.put("updatedAt", System.currentTimeMillis())
	            return policy
	        }}

	        private fun chengRegionPolicyFallback(): JSONObject {{
	            val zone = java.util.TimeZone.getDefault().id
	            val language = java.util.Locale.getDefault().toLanguageTag().lowercase(java.util.Locale.ROOT)
	            val domestic = zone == "Asia/Shanghai" || zone == "Asia/Chongqing" || zone == "Asia/Urumqi" || language.startsWith("zh-cn")
	            val policy = JSONObject()
	            policy.put("policyGroupId", if (domestic) "CN" else "INTL")
	            policy.put("isDomestic", domestic)
	            policy.put("countryCode", if (domestic) "CN" else "")
	            policy.put("source", "locale_fallback")
	            policy.put("updatedAt", System.currentTimeMillis())
	            return policy
	        }}

	        private fun chengFetchRegionPolicy(url: String, source: String, countryKey: String, requireSuccess: Boolean): JSONObject? {{
	            var connection: java.net.HttpURLConnection? = null
	            return try {{
	                connection = java.net.URL(url).openConnection() as java.net.HttpURLConnection
	                connection.connectTimeout = 2800
	                connection.readTimeout = 2800
	                connection.requestMethod = "GET"
	                connection.setRequestProperty("Accept", "application/json")
	                if (connection.responseCode !in 200..299) {{
	                    return null
	                }}
	                val text = connection.inputStream.bufferedReader(Charsets.UTF_8).use {{ it.readText() }}
	                val payload = JSONObject(text)
	                if (requireSuccess && payload.optBoolean("success", true) == false) {{
	                    return null
	                }}
	                val country = payload.optString(countryKey, "").trim()
	                if (country.isEmpty()) {{
	                    return null
	                }}
	                chengRegionPolicyFromCountry(country, source)
	            }} catch (_: Throwable) {{
	                null
	            }} finally {{
	                connection?.disconnect()
	            }}
	        }}

	        fun chengRegionPolicyRefreshFromNative(): String {{
	            return try {{
	                val policy = chengFetchRegionPolicy("https://ipapi.co/json/", "ipapi", "country_code", false)
	                    ?: chengFetchRegionPolicy("https://ipwho.is/", "ipwhois", "country_code", true)
	                    ?: chengFetchRegionPolicy("https://ipinfo.io/json", "ipinfo", "country", false)
	                    ?: chengRegionPolicyFallback()
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("policy", policy)
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "region_policy_refresh failed", error)
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("policy", chengRegionPolicyFallback())
	                out.toString()
	            }}
	        }}

	        // Profile peerId: single-shot fetch of the local libp2p identity, fired when the
	        // profile tab is entered (mirrors PWA fetchPeerId without its 1s polling loop).
	        fun chengProfilePeerIdRefreshFromNative(): String {{
	            return try {{
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return startError
	                }}
	                val peerMethod = klass.getMethod("getLocalPeerId")
	                val localPeerId = peerMethod.invoke(instance)?.toString()?.trim().orEmpty()
	                if (localPeerId.isEmpty()) {{
	                    return "{{\"ok\":false,\"error\":\"peer_identity_unavailable\"}}"
	                }}
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("peerId", localPeerId)
	                Log.i("cheng-mobile-shell", "profile_peer_id_refresh peer_id=" + localPeerId)
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "profile_peer_id_refresh failed", error)
	                "{{\"ok\":false,\"error\":\"peer_identity_unavailable\"}}"
	            }}
	        }}

	        private fun chengProfileAssetErrorJson(error: String): String {{
	            val out = JSONObject()
	            out.put("ok", false)
	            out.put("error", error)
	            return out.toString()
	        }}

	        private fun chengProfileAssetStoredNumber(raw: String?, fallback: Double): Double {{
	            return raw?.trim()?.toDoubleOrNull() ?: fallback
	        }}

	        private fun chengProfileAssetFormatNumber(value: Double): String {{
	            var text = String.format(Locale.US, "%.6f", if (value < 0.0) 0.0 else value)
	            while (text.contains(".") && text.endsWith("0")) {{
	                text = text.dropLast(1)
	            }}
	            if (text.endsWith(".")) {{
	                text = text.dropLast(1)
	            }}
	            return text
	        }}

	        private fun chengProfileAssetLedgerFromPrefs(prefs: android.content.SharedPreferences): JSONArray {{
	            return try {{
	                JSONArray(prefs.getString("profile_asset_ledger_v2", "[]") ?: "[]")
	            }} catch (_: Throwable) {{
	                JSONArray()
	            }}
	        }}

	        fun chengProfileAssetActionSubmitFromNative(requestJson: String): String {{
	            return try {{
	                val request = JSONObject(requestJson)
	                val asset = request.optString("asset", "").trim()
	                val action = request.optString("action", "").trim()
	                val amount = request.optString("amount", "").trim().toDoubleOrNull()
	                    ?: return chengProfileAssetErrorJson("请输入有效金额")
	                val target = request.optString("target", "").trim()
	                if (amount <= 0.0) {{
	                    return chengProfileAssetErrorJson("请输入有效金额")
	                }}
	                if (asset != "points" && asset != "rwad") {{
	                    return chengProfileAssetErrorJson("invalid_asset")
	                }}
	                if (action != "recharge" && action != "transfer") {{
	                    return chengProfileAssetErrorJson("invalid_action")
	                }}
	                val prefs = getSharedPreferences("cheng_profile_asset_v1", Context.MODE_PRIVATE)
	                val ledger = chengProfileAssetLedgerFromPrefs(prefs)
	                var pointsBalance = chengProfileAssetStoredNumber(prefs.getString("profile_points_balance_v2", "0"), 0.0)
	                val entry = JSONObject()
	                entry.put("id", "ledger-" + System.currentTimeMillis().toString())
	                entry.put("amount", amount)
	                entry.put("createdAt", System.currentTimeMillis())
	                if (action == "recharge") {{
	                    if (asset == "rwad") {{
	                        return chengProfileAssetErrorJson("RWAD 余额以链上为准，不支持本地充值。")
	                    }}
	                    pointsBalance += amount
	                    entry.put("type", "points_recharge")
	                }} else {{
	                    if (asset == "points") {{
	                        if (pointsBalance < amount) {{
	                            return chengProfileAssetErrorJson("积分余额不足")
	                        }}
	                        pointsBalance -= amount
	                        entry.put("type", "points_transfer")
	                        entry.put("target", target)
	                    }} else {{
	                        return chengProfileAssetErrorJson("NFC 转账通道未就绪")
	                    }}
	                }}
	                val nextLedger = JSONArray()
	                nextLedger.put(entry)
	                var index = 0
	                while (index < ledger.length() && index < 49) {{
	                    nextLedger.put(ledger.opt(index))
	                    index += 1
	                }}
	                val pointsText = chengProfileAssetFormatNumber(pointsBalance)
	                val committed = prefs.edit()
	                    .putString("profile_points_balance_v2", pointsText)
	                    .putString("profile_asset_ledger_v2", nextLedger.toString())
	                    .commit()
	                if (!committed) {{
	                    return chengProfileAssetErrorJson("asset_persist_failed")
	                }}
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("pointsBalance", pointsText)
	                out.put("ledger", nextLedger)
	                out.put("hint", "")
	                Log.i("cheng-mobile-shell", "profile_asset_action_submit ok asset=" + asset + " action=" + action)
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "profile_asset_action_submit failed", error)
	                chengProfileAssetErrorJson("asset_action_submit_failed")
	            }}
	        }}

	        private fun chengAppendJsonArrayItems(out: JSONArray, items: JSONArray?) {{
	            if (items == null) {{
	                return
	            }}
	            for (index in 0 until items.length()) {{
	                out.put(items.opt(index))
	            }}
	        }}

	        private fun chengJsonArrayItems(raw: String): JSONArray {{
	            return try {{
	                val root = JSONObject(raw)
	                val out = JSONArray()
	                chengAppendJsonArrayItems(out, root.optJSONArray("items"))
	                chengAppendJsonArrayItems(out, root.optJSONObject("feedSnapshot")?.optJSONArray("items"))
	                out
	            }} catch (_: Throwable) {{
	                JSONArray()
	            }}
	        }}

	        private fun chengNodeContentPeerCandidate(item: JSONObject): String {{
	            fun firstNonEmpty(vararg values: String): String {{
	                for (value in values) {{
	                    val clean = value.trim()
	                    if (clean.isNotEmpty()) return clean
	                }}
	                return ""
	            }}
	            val nestedItem = item.optJSONObject("item")
	            val payload = item.optJSONObject("payload")
	            val extra = item.optJSONObject("extra")
	            return firstNonEmpty(
	                item.optString("userId", ""),
	                item.optString("authorPeerId", ""),
	                item.optString("peerId", ""),
	                item.optString("ownerPeerId", ""),
	                item.optString("author", ""),
	                nestedItem?.optString("userId", "") ?: "",
	                nestedItem?.optString("authorPeerId", "") ?: "",
	                nestedItem?.optString("peerId", "") ?: "",
	                payload?.optString("userId", "") ?: "",
	                payload?.optString("authorPeerId", "") ?: "",
	                payload?.optString("peerId", "") ?: "",
	                extra?.optString("authorPeerId", "") ?: "",
	            )
	        }}

	        private fun chengAppendNodeContentItems(out: JSONArray, raw: String, peerId: String) {{
	            val items = chengJsonArrayItems(raw)
	            for (index in 0 until items.length()) {{
	                val item = items.optJSONObject(index) ?: continue
	                val candidate = chengNodeContentPeerCandidate(item)
	                if (candidate == peerId) {{
	                    out.put(item)
	                }}
	            }}
	        }}

	        fun chengNodeContentsRefreshFromNative(peerId: String, useNetwork: Boolean): String {{
	            return try {{
	                val cleanPeerId = peerId.trim()
	                if (cleanPeerId.isEmpty()) {{
	                    return "{{\"ok\":true,\"items\":[],\"subscribed\":false}}"
	                }}
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return startError
	                }}
	                var subscribed = false
	                if (useNetwork) {{
	                    val subscribeMethod = klass.getMethod("feedSubscribePeer", String::class.java)
	                    subscribed = subscribeMethod.invoke(instance, cleanPeerId) as? Boolean ?: false
	                }}
	                val feedMethod = klass.getMethod("socialFeedSnapshot", String::class.java, String::class.java, Int::class.javaPrimitiveType)
	                val taskMethod = klass.getMethod("socialPublishTasks", String::class.java, String::class.java, Int::class.javaPrimitiveType)
	                val momentMethod = klass.getMethod("socialMomentsTimeline", String::class.java, Int::class.javaPrimitiveType)
	                val feedText = feedMethod.invoke(instance, "", "", 300)?.toString() ?: "{{\"items\":[]}}"
	                val taskText = taskMethod.invoke(instance, "mine", "", 300)?.toString() ?: "{{\"items\":[]}}"
	                val momentText = momentMethod.invoke(instance, "", 300)?.toString() ?: "{{\"items\":[]}}"
	                val items = JSONArray()
	                chengAppendNodeContentItems(items, feedText, cleanPeerId)
	                chengAppendNodeContentItems(items, taskText, cleanPeerId)
	                chengAppendNodeContentItems(items, momentText, cleanPeerId)
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("items", items)
	                out.put("subscribed", subscribed)
	                out.put("totalCount", items.length())
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "node_contents_refresh failed", error)
	                "{{\"ok\":false,\"error\":\"node_contents_refresh_failed\"}}"
	            }}
	        }}

	        private fun chengDistributedContentField(item: JSONObject, field: String): String {{
	            val direct = item.optString(field, "").trim()
	            if (direct.isNotEmpty()) {{
	                return direct
	            }}
	            val nestedItem = item.optJSONObject("item")
	            val nested = nestedItem?.optString(field, "")?.trim().orEmpty()
	            if (nested.isNotEmpty()) {{
	                return nested
	            }}
	            val payload = item.optJSONObject("payload")
	            val payloadValue = payload?.optString(field, "")?.trim().orEmpty()
	            if (payloadValue.isNotEmpty()) {{
	                return payloadValue
	            }}
	            val extra = item.optJSONObject("extra")
	            return extra?.optString(field, "")?.trim().orEmpty()
	        }}

	        private fun chengDistributedContentLong(item: JSONObject, field: String): Long {{
	            fun fromObject(obj: JSONObject?): Long {{
	                if (obj == null || !obj.has(field)) return 0L
	                val value = obj.opt(field)
	                return when (value) {{
	                    is Number -> value.toLong()
	                    is String -> value.trim().toLongOrNull() ?: 0L
	                    else -> 0L
	                }}
	            }}
	            val direct = fromObject(item)
	            if (direct > 0L) return direct
	            val nested = fromObject(item.optJSONObject("item"))
	            if (nested > 0L) return nested
	            return fromObject(item.optJSONObject("payload"))
	        }}

	        private fun chengDistributedContentBool(item: JSONObject, field: String): Boolean {{
	            fun fromObject(obj: JSONObject?): Boolean? {{
	                if (obj == null || !obj.has(field)) return null
	                val value = obj.opt(field)
	                return when (value) {{
	                    is Boolean -> value
	                    is String -> value.trim().equals("true", ignoreCase = true)
	                    is Number -> value.toInt() != 0
	                    else -> null
	                }}
	            }}
	            return fromObject(item)
	                ?: fromObject(item.optJSONObject("item"))
	                ?: fromObject(item.optJSONObject("payload"))
	                ?: false
	        }}

	        private fun chengDistributedContentArray(item: JSONObject, field: String): JSONArray {{
	            val direct = item.optJSONArray(field)
	            if (direct != null) return direct
	            val nested = item.optJSONObject("item")?.optJSONArray(field)
	            if (nested != null) return nested
	            return item.optJSONObject("payload")?.optJSONArray(field) ?: JSONArray()
	        }}

	        private fun chengCanonicalDistributedContent(item: JSONObject): JSONObject? {{
	            val category = chengDistributedContentField(item, "publishCategory")
	                .ifEmpty {{ chengDistributedContentField(item, "category") }}
	                .ifEmpty {{ chengDistributedContentField(item, "channel") }}
	            if (category.isEmpty()) return null
	            val title = chengDistributedContentField(item, "title")
	            val content = chengDistributedContentField(item, "content")
	                .ifEmpty {{ chengDistributedContentField(item, "body") }}
	                .ifEmpty {{ chengDistributedContentField(item, "text") }}
	            if (title.isEmpty() && content.isEmpty()) return null
	            val id = chengDistributedContentField(item, "contentId")
	                .ifEmpty {{ chengDistributedContentField(item, "id") }}
	                .ifEmpty {{ chengDistributedContentField(item, "postId") }}
	                .ifEmpty {{ chengDistributedContentField(item, "taskId") }}
	            if (id.isEmpty()) return null
	            val timestamp = chengDistributedContentLong(item, "timestamp")
	                .let {{ if (it > 0L) it else chengDistributedContentLong(item, "timestampMs") }}
	                .let {{ if (it > 0L) it else chengDistributedContentLong(item, "createdAt") }}
	                .let {{ if (it > 0L) it else chengDistributedContentLong(item, "updatedAt") }}
	            if (timestamp <= 0L) return null
	            val userId = chengDistributedContentField(item, "userId")
	                .ifEmpty {{ chengDistributedContentField(item, "authorPeerId") }}
	                .ifEmpty {{ chengDistributedContentField(item, "peerId") }}
	                .ifEmpty {{ chengDistributedContentField(item, "author") }}
	            val media = chengDistributedContentField(item, "media")
	                .ifEmpty {{ chengDistributedContentField(item, "mediaLabel") }}
	            val type = chengDistributedContentField(item, "type")
	            val out = JSONObject()
	            out.put("id", id)
	            out.put("postId", chengDistributedContentField(item, "postId").ifEmpty {{ id }})
	            out.put("taskId", chengDistributedContentField(item, "taskId"))
	            out.put("authorSeq", chengDistributedContentLong(item, "authorSeq").let {{ if (it > 0L) it else chengDistributedContentLong(item, "seq") }})
	            out.put("type", type)
	            out.put("publishCategory", category)
	            out.put("userId", userId)
	            out.put("userName", chengDistributedContentField(item, "userName").ifEmpty {{ chengDistributedContentField(item, "authorName") }})
	            out.put("avatar", chengDistributedContentField(item, "avatar"))
	            out.put("title", title)
	            out.put("content", content)
	            out.put("media", media)
	            out.put("mediaItems", chengDistributedContentArray(item, "mediaItems"))
	            out.put("tinyPreview", chengDistributedContentField(item, "tinyPreview"))
	            out.put("coverMedia", chengDistributedContentField(item, "coverMedia"))
	            out.put("mediaAspectRatio", chengDistributedContentLong(item, "mediaAspectRatio"))
	            out.put("likes", chengDistributedContentLong(item, "likes"))
	            out.put("comments", chengDistributedContentLong(item, "comments"))
	            out.put("timestamp", timestamp)
	            out.put("publishedAt", chengDistributedContentLong(item, "publishedAt"))
	            out.put("publishState", chengDistributedContentField(item, "publishState"))
	            out.put("moderationClass", chengDistributedContentField(item, "moderationClass"))
	            out.put("moderationDecision", chengDistributedContentField(item, "moderationDecision"))
	            out.put("visibility", chengDistributedContentField(item, "visibility"))
	            out.put("homeEligible", chengDistributedContentBool(item, "homeEligible"))
	            out.put("distributionTags", chengDistributedContentArray(item, "distributionTags"))
	            out.put("reasonCode", chengDistributedContentField(item, "reasonCode"))
	            out.put("retryCount", chengDistributedContentLong(item, "retryCount"))
	            out.put("lastAttemptAt", chengDistributedContentLong(item, "lastAttemptAt"))
	            out.put("tombstoned", chengDistributedContentBool(item, "tombstoned"))
	            out.put("viewerCanAccess", chengDistributedContentBool(item, "viewerCanAccess"))
	            out.put("accessPolicy", chengDistributedContentField(item, "accessPolicy"))
	            out.put("isDuplicate", chengDistributedContentBool(item, "isDuplicate"))
	            out.put("locationHint", chengDistributedContentField(item, "locationHint"))
	            return out
	        }}

	        private fun chengAppendDistributedContentItems(out: JSONArray, raw: String) {{
	            val items = chengJsonArrayItems(raw)
	            for (index in 0 until items.length()) {{
	                val item = items.optJSONObject(index) ?: continue
	                val content = chengCanonicalDistributedContent(item) ?: continue
	                out.put(content)
	            }}
	        }}

	        private fun chengDistributedContentsSummary(items: JSONArray): String {{
	            if (items.length() <= 0) {{
	                return "total=0"
	            }}
	            val first = items.optJSONObject(0)
	            if (first == null) {{
	                return "total=" + items.length() + " first=null"
	            }}
	            val media = first.optString("media", "")
	            val mediaItems = first.optJSONArray("mediaItems")
	            return "total=" + items.length() +
	                " first_id=" + first.optString("id", "").take(48) +
	                " first_category=" + first.optString("publishCategory", "") +
	                " first_type=" + first.optString("type", "") +
	                " first_title=" + first.optString("title", "").take(64) +
	                " first_media_len=" + media.length +
	                " first_media_items=" + (mediaItems?.length() ?: 0)
	        }}

	        private fun chengDedupeDistributedContentItems(items: JSONArray): JSONArray {{
	            val byId = LinkedHashMap<String, JSONObject>()
	            for (index in 0 until items.length()) {{
	                val item = items.optJSONObject(index) ?: continue
	                val id = item.optString("id", "")
	                val existing = byId[id]
	                if (existing == null || item.optLong("timestamp", 0L) > existing.optLong("timestamp", 0L)) {{
	                    byId[id] = item
	                }}
	            }}
	            val out = JSONArray()
	            for (value in byId.values) {{
	                out.put(value)
	            }}
	            return out
	        }}

	        private fun chengDistributedContentsSnapshotForRuntime(): String {{
	            return try {{
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return startError
	                }}
	                val feedMethod = klass.getMethod("socialFeedSnapshot", String::class.java, String::class.java, Int::class.javaPrimitiveType)
	                val taskMethod = klass.getMethod("socialPublishTasks", String::class.java, String::class.java, Int::class.javaPrimitiveType)
	                val momentMethod = klass.getMethod("socialMomentsTimeline", String::class.java, Int::class.javaPrimitiveType)
	                val feedText = feedMethod.invoke(instance, "", "", 300)?.toString() ?: "{{\"items\":[]}}"
	                val taskText = taskMethod.invoke(instance, "mine", "", 300)?.toString() ?: "{{\"items\":[]}}"
	                val momentText = momentMethod.invoke(instance, "", 300)?.toString() ?: "{{\"items\":[]}}"
	                val rawItems = JSONArray()
	                chengAppendDistributedContentItems(rawItems, feedText)
	                chengAppendDistributedContentItems(rawItems, taskText)
	                chengAppendDistributedContentItems(rawItems, momentText)
	                val items = chengDedupeDistributedContentItems(rawItems)
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("items", items)
	                out.put("totalCount", items.length())
	                Log.i("cheng-mobile-shell", "distributed_contents_snapshot " + chengDistributedContentsSummary(items))
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "distributed_contents_snapshot failed", error)
	                "{{\"ok\":false,\"error\":\"distributed_contents_snapshot_failed\"}}"
	            }}
	        }}

	        private fun pushDistributedContentsToRuntime(reason: String) {{
	            val handle = runtimeHandle
	            if (handle == 0L) {{
	                return
	            }}
	            val snapshot = chengDistributedContentsSnapshotForRuntime()
	            postRender {{
	                val ok = if (runtimeHandle == handle) nativeApplyDistributedContentsUpdate(handle, snapshot) else false
	                mainHandler.post {{
	                    if (runtimeHandle == handle) {{
	                        Log.i("cheng-mobile-shell", "distributed_contents_update reason=" + reason + " ok=" + ok + " bytes=" + snapshot.length)
	                        if (ok) {{
	                            requestFrame()
	                        }}
	                    }}
	                }}
	            }}
	        }}

	        // Home-feed realtime wake (gossipsub inbound): the native feed-event pump
	        // thread blocks inside the backend's social_wait_feed_event export and calls
	        // this the moment a new publish-metadata/content-announce lands in the feed
	        // store. Until this wiring the runtime feed only refreshed on create/resume
	        // (one-shot snapshot merge), so anything arriving while the app sat open was
	        // invisible. Wake does the same real snapshot merge as those lifecycle paths.
	        fun chengFeedInboundWake() {{
	            mainHandler.post {{
	                pushDistributedContentsToRuntime("gossipsub_inbound")
	            }}
	        }}

	        @Volatile private var feedEventPumpStartInFlight = false
	        private fun startFeedEventPumpIfNeeded() {{
	            // Do not latch on pthread_create success: the native worker can still
	            // die on dlopen/dlsym/wait. Native s_feed_pump_started is the running
	            // guard (TRUE if the worker is alive). Java only serializes in-flight
	            // start attempts so create/resume/social-start can retry.
	            if (feedEventPumpStartInFlight) {{
	                return
	            }}
	            feedEventPumpStartInFlight = true
	            Thread(null, Runnable {{
	                try {{
	                    val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                    val instance = klass.getField("INSTANCE").get(null)
	                    if (instance == null) {{
	                        Log.e("cheng-mobile-shell", "feed event pump: social backend instance missing")
	                        return@Runnable
	                    }}
	                    val startError = ensureChengSocialBackendStarted(klass, instance)
	                    if (startError != null) {{
	                        Log.e("cheng-mobile-shell", "feed event pump: social backend not startable " + startError)
	                        return@Runnable
	                    }}
	                    val handleField = klass.getDeclaredField("handle")
	                    handleField.isAccessible = true
	                    val nodeHandle = handleField.getLong(instance)
	                    if (nodeHandle == 0L) {{
	                        Log.e("cheng-mobile-shell", "feed event pump: node handle is zero")
	                        return@Runnable
	                    }}
	                    val started = nativeStartFeedEventPump(nodeHandle)
	                    if (!started) {{
	                        Log.e("cheng-mobile-shell", "feed event pump: native start failed (backend without social_wait_feed_event? will retry on next social start / resume)")
	                    }}
	                }} catch (error: Throwable) {{
	                    Log.e("cheng-mobile-shell", "feed event pump: start failed", error)
	                }} finally {{
	                    feedEventPumpStartInFlight = false
	                }}
	            }}, "ChengFeedEventPumpStart").start()
	        }}

	        // ── Ingress WAN presence (nodes page wide-area rows) ─────────────────
	        // Presence is foreground-scoped and fully event-driven: started on
	        // runtime_create/onResume, stopped on onPause/onDestroy. Write side:
	        // announce keepalive every 45s — the server hard-codes peer liveness at
	        // 45s (PEER_TTL_MS); failure retries ladder 5s/10s/20s, capped below the
	        // TTL so one transient error never hides this device for minutes. Read
	        // side: one blocking SSE stream (topic=discovery); every (re)connect
	        // first POSTs one snapshot seed that full-replaces the WAN table — that
	        // recovers 'left' frames lost while disconnected and carries
	        // systemProfile, which live frames do not — then frames apply deltas.
	        // Entries expire locally 60s after last seen (server TTL + grace),
	        // checked at read points only: no timers, no polling. Our own 45s
	        // announce echoes back on the stream, so a healthy foreground
	        // connection sees a frame at least every 45s; readTimeout=90s turns a
	        // half-open socket into a reconnect instead of a permanent freeze.
	        // Base URL override for LAN bring-up:
	        //   adb shell setprop debug.cheng.presence.ingress.url http://<host>:8788
	        // Every failure path is soft: unreachable ingress leaves the WAN map
	        // empty and the merge is a no-op — the nodes page falls back to the
	        // pure local snapshot, never aborts.
	        private class IngressWanPeer(val payload: JSONObject, val seenAtElapsedMs: Long)
	        private val INGRESS_WAN_TTL_MS = 60_000L
	        private val ingressWanPeers = java.util.concurrent.atomic.AtomicReference<Map<String, IngressWanPeer>>(emptyMap())
	        @Volatile private var ingressPresenceStarted = false
	        @Volatile private var ingressStreamThreadRunning = false
	        @Volatile private var ingressStreamConnection: java.net.HttpURLConnection? = null
	        @Volatile private var ingressCachedPeerId = ""
	        @Volatile private var ingressLastPushedFingerprint = ""
	        private var ingressAnnounceFailureStreak = 0
	        private var ingressAnnounceRunnable: Runnable? = null

	        private fun ingressPresenceBaseUrl(): String {{
	            val override = try {{
	                val props = Class.forName("android.os.SystemProperties")
	                props.getMethod("get", String::class.java, String::class.java)
	                    .invoke(null, "debug.cheng.presence.ingress.url", "")?.toString() ?: ""
	            }} catch (error: Throwable) {{
	                ""
	            }}
	            val trimmed = override.trim().trimEnd('/')
	            if (trimmed.isNotEmpty()) {{
	                return trimmed
	            }}
	            return "https://unimaker.fun"
	        }}

	        private fun ingressLocalPeerId(): String {{
	            val cached = ingressCachedPeerId
	            if (cached.isNotEmpty()) {{
	                return cached
	            }}
	            val resolved = try {{
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null) ?: return ""
	                klass.getMethod("getLocalPeerId").invoke(instance)?.toString()?.trim() ?: ""
	            }} catch (error: Throwable) {{
	                ""
	            }}
	            if (resolved.isNotEmpty()) {{
	                ingressCachedPeerId = resolved
	            }}
	            return resolved
	        }}

	        private fun startIngressPresenceIfNeeded() {{
	            if (!ingressPresenceStarted) {{
	                ingressPresenceStarted = true
	                ingressAnnounceFailureStreak = 0
	            }}
	            scheduleIngressPresenceAnnounce(0L)
	            startIngressDiscoveryStreamIfNeeded()
	        }}

	        private fun stopIngressPresence(reason: String) {{
	            if (!ingressPresenceStarted) {{
	                return
	            }}
	            ingressPresenceStarted = false
	            ingressAnnounceRunnable?.let {{ mainHandler.removeCallbacks(it) }}
	            val connection = ingressStreamConnection
	            if (connection != null) {{
	                Thread(null, Runnable {{
	                    try {{
	                        connection.disconnect()
	                    }} catch (error: Throwable) {{
	                        /* already down */
	                    }}
	                }}, "ChengIngressStop").start()
	            }}
	            Log.i("cheng-mobile-shell", "ingress_presence stopped reason=" + reason)
	        }}

	        private fun scheduleIngressPresenceAnnounce(delayMs: Long) {{
	            val runnable = ingressAnnounceRunnable ?: Runnable {{
	                Thread(null, Runnable {{
	                    val peerId = ingressLocalPeerId()
	                    val outcome = if (peerId.isEmpty()) {{
	                        "not_ready"
	                    }} else if (announceIngressPresenceOnce(peerId)) {{
	                        "ok"
	                    }} else {{
	                        "fail"
	                    }}
	                    mainHandler.post {{
	                        if (!ingressPresenceStarted || !activityResumed) {{
	                            return@post
	                        }}
	                        val nextDelayMs = when (outcome) {{
	                            "ok" -> {{
	                                ingressAnnounceFailureStreak = 0
	                                45_000L
	                            }}
	                            "not_ready" -> 2_000L
	                            else -> {{
	                                ingressAnnounceFailureStreak += 1
	                                5_000L shl (ingressAnnounceFailureStreak - 1).coerceAtMost(2)
	                            }}
	                        }}
	                        scheduleIngressPresenceAnnounce(nextDelayMs)
	                    }}
	                }}, "ChengIngressAnnounce").start()
	            }}.also {{ ingressAnnounceRunnable = it }}
	            mainHandler.removeCallbacks(runnable)
	            mainHandler.postDelayed(runnable, delayMs)
	        }}

	        private fun announceIngressPresenceOnce(peerId: String): Boolean {{
	            val base = ingressPresenceBaseUrl()
	            if (base.isEmpty()) {{
	                return false
	            }}
	            var connection: java.net.HttpURLConnection? = null
	            return try {{
	                connection = java.net.URL(base + "/v1/libp2p/presence/announce")
	                    .openConnection() as java.net.HttpURLConnection
	                connection.requestMethod = "POST"
	                connection.connectTimeout = 8000
	                connection.readTimeout = 10000
	                connection.doOutput = true
	                connection.setRequestProperty("Content-Type", "application/json")
	                connection.setRequestProperty("X-UniMaker-Peer-Id", peerId)
	                // ttlMs only affects namespace ads server-side; peer liveness is
	                // hard-coded at 45s (PEER_TTL_MS), which the 45s keepalive tracks.
	                val body = JSONObject()
	                    .put("started", true)
	                    .put("ttlMs", 120000)
	                    .put("capabilities", JSONArray().put("libp2p_native"))
	                    .put("sources", JSONArray().put("native_bridge"))
	                    .put("systemProfile", JSONObject()
	                        .put("osName", "Android")
	                        .put("osVersion", android.os.Build.VERSION.RELEASE))
	                connection.outputStream.use {{ it.write(body.toString().toByteArray(Charsets.UTF_8)) }}
	                val code = connection.responseCode
	                if (code in 200..299) {{
	                    true
	                }} else {{
	                    Log.i("cheng-mobile-shell", "ingress_announce rejected code=" + code)
	                    false
	                }}
	            }} catch (error: Throwable) {{
	                Log.i("cheng-mobile-shell", "ingress_announce unreachable " + (error.message ?: "unknown"))
	                false
	            }} finally {{
	                try {{
	                    connection?.disconnect()
	                }} catch (error: Throwable) {{
	                    /* closing */
	                }}
	            }}
	        }}

	        private fun startIngressDiscoveryStreamIfNeeded() {{
	            if (ingressStreamThreadRunning) {{
	                return
	            }}
	            ingressStreamThreadRunning = true
	            Thread(null, Runnable {{
	                var backoffMs = 2_000L
	                while (ingressPresenceStarted) {{
	                    val base = ingressPresenceBaseUrl()
	                    val peerId = ingressLocalPeerId()
	                    if (base.isEmpty() || peerId.isEmpty()) {{
	                        try {{
	                            Thread.sleep(2_000L)
	                        }} catch (interrupted: InterruptedException) {{
	                            break
	                        }}
	                        continue
	                    }}
	                    var connection: java.net.HttpURLConnection? = null
	                    var reader: java.io.BufferedReader? = null
	                    var parseFailures = 0
	                    try {{
	                        connection = java.net.URL(
	                            base + "/v1/libp2p/stream?topic=discovery&peerId=" +
	                                java.net.URLEncoder.encode(peerId, "UTF-8")
	                        ).openConnection() as java.net.HttpURLConnection
	                        connection.connectTimeout = 8000
	                        connection.readTimeout = 90_000
	                        connection.setRequestProperty("Accept", "text/event-stream")
	                        ingressStreamConnection = connection
	                        reader = java.io.BufferedReader(
	                            java.io.InputStreamReader(connection.inputStream, Charsets.UTF_8)
	                        )
	                        backoffMs = 2_000L
	                        seedIngressWanPeers(base, peerId)
	                        val dataBuffer = StringBuilder()
	                        while (ingressPresenceStarted) {{
	                            val line = reader.readLine() ?: break
	                            if (line.isEmpty()) {{
	                                if (dataBuffer.isNotEmpty()) {{
	                                    if (!handleIngressDiscoveryFrame(dataBuffer.toString())) {{
	                                        parseFailures += 1
	                                        if (parseFailures == 1) {{
	                                            Log.i("cheng-mobile-shell", "ingress_frame parse failure (first this connection)")
	                                        }}
	                                    }}
	                                    dataBuffer.setLength(0)
	                                }}
	                            }} else if (line.startsWith("data:")) {{
	                                if (dataBuffer.isNotEmpty()) {{
	                                    dataBuffer.append('\n')
	                                }}
	                                dataBuffer.append(line.removePrefix("data:").trim())
	                            }}
	                        }}
	                    }} catch (timeout: java.net.SocketTimeoutException) {{
	                        backoffMs = 2_000L
	                    }} catch (error: Throwable) {{
	                        if (ingressPresenceStarted) {{
	                            Log.i("cheng-mobile-shell", "ingress_stream reconnect " + (error.message ?: "unknown"))
	                        }}
	                    }} finally {{
	                        ingressStreamConnection = null
	                        try {{
	                            reader?.close()
	                        }} catch (error: Throwable) {{
	                            /* closing */
	                        }}
	                        try {{
	                            connection?.disconnect()
	                        }} catch (error: Throwable) {{
	                            /* closing */
	                        }}
	                        if (parseFailures > 0) {{
	                            Log.i("cheng-mobile-shell", "ingress_stream closed parse_failures=" + parseFailures)
	                        }}
	                    }}
	                    if (!ingressPresenceStarted) {{
	                        break
	                    }}
	                    try {{
	                        Thread.sleep(backoffMs)
	                    }} catch (interrupted: InterruptedException) {{
	                        break
	                    }}
	                    backoffMs = (backoffMs * 2).coerceAtMost(300_000L)
	                }}
	                ingressStreamThreadRunning = false
	                if (ingressPresenceStarted) {{
	                    mainHandler.post {{ startIngressDiscoveryStreamIfNeeded() }}
	                }}
	            }}, "ChengIngressPresence").start()
	        }}

	        private fun seedIngressWanPeers(base: String, peerId: String) {{
	            var connection: java.net.HttpURLConnection? = null
	            try {{
	                connection = java.net.URL(base + "/v1/libp2p/bridge/networkDiscoverySnapshot")
	                    .openConnection() as java.net.HttpURLConnection
	                connection.requestMethod = "POST"
	                connection.connectTimeout = 8000
	                connection.readTimeout = 10000
	                connection.doOutput = true
	                connection.setRequestProperty("Content-Type", "application/json")
	                connection.setRequestProperty("X-UniMaker-Peer-Id", peerId)
	                connection.outputStream.use {{ it.write("{{}}".toByteArray(Charsets.UTF_8)) }}
	                val body = connection.inputStream.bufferedReader(Charsets.UTF_8).use {{ it.readText() }}
	                val root = JSONObject(body)
	                val peers = root.optJSONObject("discoveredPeers")?.optJSONArray("peers") ?: JSONArray()
	                val now = android.os.SystemClock.elapsedRealtime()
	                val next = HashMap<String, IngressWanPeer>()
	                for (index in 0 until peers.length()) {{
	                    val peer = peers.optJSONObject(index) ?: continue
	                    val id = peer.optString("peerId", "").trim()
	                    if (id.isEmpty() || id == peerId) {{
	                        continue
	                    }}
	                    next[id] = IngressWanPeer(peer, now)
	                }}
	                ingressWanPeers.set(next)
	                pushIngressPresenceUpdate("ingress_seed")
	            }} catch (error: Throwable) {{
	                Log.i("cheng-mobile-shell", "ingress_seed unavailable " + (error.message ?: "unknown"))
	            }} finally {{
	                try {{
	                    connection?.disconnect()
	                }} catch (error: Throwable) {{
	                    /* closing */
	                }}
	            }}
	        }}

	        private fun handleIngressDiscoveryFrame(payloadText: String): Boolean {{
	            val frame = try {{
	                JSONObject(payloadText)
	            }} catch (error: Throwable) {{
	                return false
	            }}
	            if (frame.optString("entity") != "discovery") {{
	                return true
	            }}
	            val payload = frame.optJSONObject("payload") ?: return true
	            val peerId = payload.optString("peerId", "").trim()
	            if (peerId.isEmpty() || peerId == ingressLocalPeerId()) {{
	                return true
	            }}
	            val now = android.os.SystemClock.elapsedRealtime()
	            val current = HashMap(ingressWanPeers.get())
	            var mutated = false
	            when (frame.optString("op")) {{
	                "seen" -> {{
	                    val previousProfile = current[peerId]?.payload?.optJSONObject("systemProfile")
	                    if (payload.optJSONObject("systemProfile") == null && previousProfile != null) {{
	                        payload.put("systemProfile", previousProfile)
	                    }}
	                    current[peerId] = IngressWanPeer(payload, now)
	                    mutated = true
	                }}
	                "left" -> {{
	                    mutated = current.remove(peerId) != null
	                }}
	            }}
	            val expired = current.keys.filter {{ now - (current[it]?.seenAtElapsedMs ?: 0L) > INGRESS_WAN_TTL_MS }}
	            if (expired.isNotEmpty()) {{
	                expired.forEach {{ current.remove(it) }}
	                mutated = true
	            }}
	            if (!mutated) {{
	                return true
	            }}
	            ingressWanPeers.set(current)
	            pushIngressPresenceUpdate("ingress_presence")
	            return true
	        }}

	        private fun pushIngressPresenceUpdate(reason: String) {{
	            val wan = ingressWanPeers.get()
	            val fingerprint = wan.keys.sorted().joinToString("|") {{ id ->
	                val profile = wan[id]?.payload?.optJSONObject("systemProfile")
	                id + ":" + (profile?.optString("osName") ?: "") + ":" + (profile?.optString("osVersion") ?: "")
	            }}
	            if (fingerprint == ingressLastPushedFingerprint) {{
	                return
	            }}
	            ingressLastPushedFingerprint = fingerprint
	            val snapshot = chengNodesSnapshotForRuntime()
	            mainHandler.post {{
	                val handle = runtimeHandle
	                if (handle != 0L) {{
	                    applyNodesSnapshot(handle, snapshot, reason)
	                }}
	            }}
	        }}

	        private fun mergeIngressWanPeers(raw: String): String {{
	            val wan = ingressWanPeers.get()
	            if (wan.isEmpty()) {{
	                return raw
	            }}
	            val now = android.os.SystemClock.elapsedRealtime()
	            return try {{
	                val root = JSONObject(raw)
	                val discovered = root.optJSONObject("discoveredPeers")
	                    ?: JSONObject().also {{ root.put("discoveredPeers", it) }}
	                val peers = discovered.optJSONArray("peers")
	                    ?: JSONArray().also {{ discovered.put("peers", it) }}
	                val existing = HashSet<String>()
	                for (index in 0 until peers.length()) {{
	                    val peer = peers.optJSONObject(index) ?: continue
	                    val id = peer.optString("peerId", "").trim()
	                    if (id.isNotEmpty()) {{
	                        existing.add(id)
	                    }}
	                }}
	                val selfId = root.optString("peerId", "").trim().ifEmpty {{ ingressLocalPeerId() }}
	                var added = 0
	                for ((id, entry) in wan) {{
	                    if (id == selfId || existing.contains(id)) {{
	                        continue
	                    }}
	                    if (now - entry.seenAtElapsedMs > INGRESS_WAN_TTL_MS) {{
	                        continue
	                    }}
	                    // Nodes-page source tags are a fixed vocabulary (mDNS/BLE/DHT/
	                    // Connected/LAN/WAN/Rendezvous — unimaker_compat_ffi
	                    // peerSourcesJson); ingress rows are wide-area by definition,
	                    // raw transport strings would be dropped by every filter tab.
	                    val row = JSONObject()
	                        .put("peerId", id)
	                        .put("sources", JSONArray().put("WAN"))
	                    entry.payload.optJSONObject("systemProfile")?.let {{ row.put("systemProfile", it) }}
	                    peers.put(row)
	                    added += 1
	                }}
	                if (added == 0) raw else root.toString()
	            }} catch (error: Throwable) {{
	                Log.i("cheng-mobile-shell", "ingress_merge skipped " + (error.message ?: "unknown"))
	                raw
	            }}
	        }}

	        // Wiring (buildNodesRowWiring) consumes discoveredPeers.peers[] +
	        // connectedPeers[] + top-level peerId. Some backends/stubs still emit
	        // a flat nodes[] (or social_list's top-level peers[]). Normalize here
	        // before any nativeApplyNodesUpdate / route-enter return — do not
	        // change the scene consumer.
	        private fun normalizeNodesSnapshotForWiring(raw: String): String {{
	            return try {{
	                val root = JSONObject(raw)
	                var discovered = root.optJSONObject("discoveredPeers")
	                var peers = discovered?.optJSONArray("peers")
	                val connected = root.optJSONArray("connectedPeers") ?: JSONArray()
	                if (peers == null) {{
	                    val nodes = root.optJSONArray("nodes")
	                    val topPeers = root.optJSONArray("peers")
	                    peers = JSONArray()
	                    if (nodes != null) {{
	                        for (index in 0 until nodes.length()) {{
	                            val node = nodes.optJSONObject(index) ?: continue
	                            val id = node.optString("peerId", "").trim().ifEmpty {{ node.optString("id", "").trim() }}
	                            if (id.isEmpty()) {{
	                                continue
	                            }}
	                            val row = JSONObject().put("peerId", id)
	                            node.optJSONArray("sources")?.let {{ row.put("sources", it) }}
	                            node.optJSONObject("systemProfile")?.let {{ row.put("systemProfile", it) }}
	                            val nickname = node.optString("nickname", "").trim()
	                            if (nickname.isNotEmpty()) {{
	                                row.put("nickname", nickname)
	                            }}
	                            val domain = node.optString("domain", "").trim()
	                            if (domain.isNotEmpty()) {{
	                                row.put("domain", domain)
	                            }}
	                            val location = node.optString("location", "").trim()
	                            if (location.isNotEmpty()) {{
	                                row.put("location", location)
	                            }}
	                            peers.put(row)
	                            if (node.optBoolean("connected", false)) {{
	                                var already = false
	                                for (ci in 0 until connected.length()) {{
	                                    if (connected.optString(ci, "").trim() == id) {{
	                                        already = true
	                                        break
	                                    }}
	                                }}
	                                if (!already) {{
	                                    connected.put(id)
	                                }}
	                            }}
	                        }}
	                    }} else if (topPeers != null) {{
	                        peers = topPeers
	                    }}
	                    discovered = JSONObject().put("peers", peers).put("totalCount", peers.length())
	                    root.put("discoveredPeers", discovered)
	                }}
	                if (root.optJSONArray("connectedPeers") == null) {{
	                    root.put("connectedPeers", connected)
	                }}
	                val selfId = root.optString("peerId", "").trim().ifEmpty {{ ingressLocalPeerId() }}
	                if (selfId.isNotEmpty()) {{
	                    root.put("peerId", selfId)
	                }}
	                root.toString()
	            }} catch (error: Throwable) {{
	                Log.i("cheng-mobile-shell", "nodes_normalize skipped " + (error.message ?: "unknown"))
	                raw
	            }}
	        }}

	        // compat_ffi's libp2p_network_discovery_snapshot currently emits the
	        // wiring shape with empty peers[]; the live LAN/libp2p roster is
	        // socialListDiscoveredPeers / getConnectedPeers. Fill only when the
	        // snapshot peers are empty so a later real snapshot is not overwritten.
	        private fun fillNodesSnapshotFromLocalDiscovery(raw: String): String {{
	            return try {{
	                val root = JSONObject(raw)
	                val discovered = root.optJSONObject("discoveredPeers")
	                    ?: JSONObject().also {{ root.put("discoveredPeers", it) }}
	                val peers = discovered.optJSONArray("peers")
	                    ?: JSONArray().also {{ discovered.put("peers", it) }}
	                val connected = root.optJSONArray("connectedPeers") ?: JSONArray()
	                if (peers.length() > 0 && connected.length() > 0) {{
	                    return raw
	                }}
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null) ?: return raw
	                if (peers.length() <= 0) {{
	                    try {{
	                        val listMethod = klass.getMethod("socialListDiscoveredPeers", String::class.java, Int::class.javaPrimitiveType)
	                        val listRaw = listMethod.invoke(instance, "", 64)?.toString() ?: ""
	                        val listPeers = JSONObject(listRaw).optJSONArray("peers")
	                        if (listPeers != null && listPeers.length() > 0) {{
	                            discovered.put("peers", listPeers)
	                            discovered.put("totalCount", listPeers.length())
	                        }}
	                    }} catch (error: Throwable) {{
	                        /* method absent on stub backend */
	                    }}
	                }}
	                if (connected.length() <= 0) {{
	                    try {{
	                        val connectedMethod = klass.getMethod("getConnectedPeers")
	                        val connectedRaw = connectedMethod.invoke(instance)?.toString() ?: "[]"
	                        val connectedArr = JSONArray(connectedRaw)
	                        if (connectedArr.length() > 0) {{
	                            root.put("connectedPeers", connectedArr)
	                        }} else if (root.optJSONArray("connectedPeers") == null) {{
	                            root.put("connectedPeers", JSONArray())
	                        }}
	                    }} catch (error: Throwable) {{
	                        if (root.optJSONArray("connectedPeers") == null) {{
	                            root.put("connectedPeers", JSONArray())
	                        }}
	                    }}
	                }}
	                if (root.optString("peerId", "").trim().isEmpty()) {{
	                    val selfId = ingressLocalPeerId()
	                    if (selfId.isNotEmpty()) {{
	                        root.put("peerId", selfId)
	                    }}
	                }}
	                root.toString()
	            }} catch (error: Throwable) {{
	                raw
	            }}
	        }}

	        private fun chengNodesSnapshotSummary(raw: String): String {{
	            return try {{
	                val root = JSONObject(raw)
	                val peers = root.optJSONObject("discoveredPeers")?.optJSONArray("peers") ?: JSONArray()
	                val connected = root.optJSONArray("connectedPeers") ?: JSONArray()
	                "total=" + peers.length() + " connected=" + connected.length()
	            }} catch (error: Throwable) {{
	                "total=0 connected=0 parse_error=" + (error.message ?: "unknown")
	            }}
	        }}

	        private fun nodesSnapshotFingerprint(raw: String): String {{
	            return try {{
	                val root = JSONObject(raw)
	                val peers = root.optJSONObject("discoveredPeers")?.optJSONArray("peers") ?: JSONArray()
	                val connected = root.optJSONArray("connectedPeers") ?: JSONArray()
	                val connectedSet = HashSet<String>()
	                for (index in 0 until connected.length()) {{
	                    val id = connected.optString(index, "").trim()
	                    if (id.isNotEmpty()) {{
	                        connectedSet.add(id)
	                    }}
	                }}
	                val peerKeys = ArrayList<String>()
	                for (index in 0 until peers.length()) {{
	                    val peer = peers.optJSONObject(index) ?: continue
	                    val id = peer.optString("peerId", "").trim()
	                    if (id.isEmpty()) {{
	                        continue
	                    }}
	                    val sources = peer.optJSONArray("sources") ?: JSONArray()
	                    val sourceKeys = ArrayList<String>()
	                    for (si in 0 until sources.length()) {{
	                        val source = sources.optString(si, "").trim()
	                        if (source.isNotEmpty()) {{
	                            sourceKeys.add(source)
	                        }}
	                    }}
	                    sourceKeys.sort()
	                    val profile = peer.optJSONObject("systemProfile")
	                    val os = (profile?.optString("osName") ?: "") + ":" + (profile?.optString("osVersion") ?: "")
	                    val flag = if (connectedSet.contains(id)) "1" else "0"
	                    peerKeys.add(id + ":" + sourceKeys.joinToString(",") + ":" + os + ":" + flag)
	                }}
	                peerKeys.sort()
	                val connectedKeys = ArrayList(connectedSet)
	                connectedKeys.sort()
	                peerKeys.joinToString("|") + "#c=" + connectedKeys.joinToString("|")
	            }} catch (error: Throwable) {{
	                "parse_error"
	            }}
	        }}

	        private fun chengNodesSnapshotForRuntime(): String {{
	            val localSnapshot = try {{
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                if (instance == null) {{
	                    "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                }} else {{
	                    val startError = ensureChengSocialBackendStarted(klass, instance)
	                    if (startError != null) {{
	                        startError
	                    }} else {{
	                        val discoveryMethod = klass.getMethod("networkDiscoverySnapshot", String::class.java, Int::class.javaPrimitiveType, Int::class.javaPrimitiveType)
	                        discoveryMethod.invoke(instance, "", 64, 4)?.toString() ?: "{{\"discoveredPeers\":{{\"peers\":[]}},\"connectedPeers\":[]}}"
	                    }}
	                }}
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "nodes_snapshot failed", error)
	                "{{\"ok\":false,\"error\":\"nodes_snapshot_failed\"}}"
	            }}
	            val wired = normalizeNodesSnapshotForWiring(localSnapshot)
	            val filled = fillNodesSnapshotFromLocalDiscovery(wired)
	            val mergedText = mergeIngressWanPeers(filled)
	            Log.i("cheng-mobile-shell", "nodes_snapshot " + chengNodesSnapshotSummary(mergedText))
	            return mergedText
	        }}

	        // Nodes tab enter: single-shot re-fetch of the same discovery snapshot
	        // pushNodesToRuntime uses, called by the native scene runtime the moment
	        // tab_nodes becomes the active route (mirrors chengProfilePeerIdRefreshFromNative's
	        // route-enter fetch, no polling). Kotlin's own pushNodesToRuntime path (below)
	        // still owns the runtime_create/resume pushes; this covers the mid-session
	        // tab switch those two don't reach.
	        fun chengNodesRouteEnterRefreshFromNative(): String {{
	            return chengNodesSnapshotForRuntime()
	        }}

	        // LAN/libp2p discovery wake: ChengLibp2pNative.pollEvents drains
	        // libp2p_poll_events (peer.connected / disconnected /
	        // connect.multiaddr / network_event=MdnsPeerDiscovered /
	        // entity=discovery). waitEvents peeks the same node->events
	        // queue (not the DM inbox). When the symbol exists, block
	        // waitEvents(1000) then drain; rc==0 mdnsProbe then skip
	        // snapshot (late mDNS peers never enqueue without probe);
	        // rc==1 drain only (events already queued); rc<0 ends the
	        // thread. Old APKs without the symbol keep 250ms empty-queue
	        // sleep + mdnsProbe + pollEvents. Arm-time mdnsProbe stays;
	        // timeout/sleep ticks reuse it — not a new Java timer.
	        @Volatile private var nodesDiscoveryPumpStarted = false
	        @Volatile private var nodesDiscoveryPumpUnavailable = false
	        @Volatile private var nodesLastPushedFingerprint = ""

	        private fun nodesDiscoveryEventsAreRelevant(raw: String): Boolean {{
	            return try {{
	                val events = JSONArray(raw)
	                for (index in 0 until events.length()) {{
	                    val event = events.optJSONObject(index) ?: continue
	                    val topic = event.optString("topic", "")
	                    if (topic == "peer.connected" || topic == "peer.disconnected" || topic == "connect.multiaddr" || topic == "network_event") {{
	                        return true
	                    }}
	                    if (event.optString("entity") == "discovery") {{
	                        return true
	                    }}
	                    val payload = event.optJSONObject("payload")
	                    if (payload != null) {{
	                        if (payload.optString("entity") == "discovery") {{
	                            return true
	                        }}
	                        if (payload.optString("type") == "MdnsPeerDiscovered") {{
	                            return true
	                        }}
	                    }}
	                }}
	                false
	            }} catch (error: Throwable) {{
	                false
	            }}
	        }}

	        private fun startNodesDiscoveryEventPumpIfNeeded() {{
	            if (nodesDiscoveryPumpStarted || nodesDiscoveryPumpUnavailable) {{
	                return
	            }}
	            nodesDiscoveryPumpStarted = true
	            Thread(null, Runnable {{
	                try {{
	                    val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                    val instance = klass.getField("INSTANCE").get(null)
	                    if (instance == null) {{
	                        Log.e("cheng-mobile-shell", "nodes discovery pump: social backend instance missing")
	                        return@Runnable
	                    }}
	                    val startError = ensureChengSocialBackendStarted(klass, instance)
	                    if (startError != null) {{
	                        Log.e("cheng-mobile-shell", "nodes discovery pump: social backend not startable " + startError)
	                        return@Runnable
	                    }}
	                    try {{
	                        klass.getMethod("mdnsProbe").invoke(instance)
	                    }} catch (error: Throwable) {{
	                        /* stub backend may lack mdns */
	                    }}
	                    val pollMethod = try {{
	                        klass.getMethod("pollEvents", Int::class.javaPrimitiveType)
	                    }} catch (error: Throwable) {{
	                        nodesDiscoveryPumpUnavailable = true
	                        Log.e("cheng-mobile-shell", "nodes discovery pump: pollEvents missing")
	                        return@Runnable
	                    }}
	                    val waitMethod = try {{
	                        klass.getMethod("waitEvents", Int::class.javaPrimitiveType)
	                    }} catch (error: Throwable) {{
	                        null
	                    }}
	                    if (waitMethod != null) {{
	                        Log.i("cheng-mobile-shell", "nodes discovery pump: started waitEvents")
	                    }} else {{
	                        Log.i("cheng-mobile-shell", "nodes discovery pump: started")
	                    }}
	                    while (!isFinishing && !isDestroyed) {{
	                        if (waitMethod != null) {{
	                            val waitRc = (waitMethod.invoke(instance, 1000) as Number).toInt()
	                            if (waitRc < 0) {{
	                                Log.e("cheng-mobile-shell", "nodes discovery pump: waitEvents rc=" + waitRc)
	                                return@Runnable
	                            }}
	                            if (waitRc == 0) {{
	                                try {{
	                                    klass.getMethod("mdnsProbe").invoke(instance)
	                                }} catch (error: Throwable) {{
	                                    Log.w("cheng-mobile-shell", "nodes discovery pump: mdnsProbe failed", error)
	                                }}
	                                continue
	                            }}
	                            val events = pollMethod.invoke(instance, 32)?.toString() ?: "[]"
	                            if (events.length > 2 && nodesDiscoveryEventsAreRelevant(events)) {{
	                                val snapshot = chengNodesSnapshotForRuntime()
	                                if (nodesSnapshotFingerprint(snapshot) != nodesLastPushedFingerprint) {{
	                                    Log.i("cheng-mobile-shell", "nodes discovery pump: event bytes=" + events.length)
	                                    mainHandler.post {{
	                                        pushNodesToRuntime("libp2p_discovery")
	                                    }}
	                                }}
	                            }}
	                        }} else {{
	                            val events = pollMethod.invoke(instance, 32)?.toString() ?: "[]"
	                            if (events.length > 2 && nodesDiscoveryEventsAreRelevant(events)) {{
	                                val snapshot = chengNodesSnapshotForRuntime()
	                                if (nodesSnapshotFingerprint(snapshot) != nodesLastPushedFingerprint) {{
	                                    Log.i("cheng-mobile-shell", "nodes discovery pump: event bytes=" + events.length)
	                                    mainHandler.post {{
	                                        pushNodesToRuntime("libp2p_discovery")
	                                    }}
	                                }}
	                            }} else {{
	                                try {{
	                                    Thread.sleep(250)
	                                }} catch (ignored: InterruptedException) {{
	                                    return@Runnable
	                                }}
	                                try {{
	                                    klass.getMethod("mdnsProbe").invoke(instance)
	                                }} catch (error: Throwable) {{
	                                    Log.w("cheng-mobile-shell", "nodes discovery pump: mdnsProbe failed", error)
	                                }}
	                            }}
	                        }}
	                    }}
	                }} catch (error: Throwable) {{
	                    Log.e("cheng-mobile-shell", "nodes discovery pump: failed", error)
	                }} finally {{
	                    if (!nodesDiscoveryPumpUnavailable) {{
	                        nodesDiscoveryPumpStarted = false
	                    }}
	                }}
	            }}, "ChengNodesDiscovery").start()
	        }}

	        private fun pushNodesToRuntime(reason: String) {{
	            startNodesDiscoveryEventPumpIfNeeded()
	            val handle = runtimeHandle
	            if (handle == 0L) {{
	                return
	            }}
	            val snapshot = chengNodesSnapshotForRuntime()
	            applyNodesSnapshot(handle, snapshot, reason)
	        }}

	        private fun applyNodesSnapshot(handle: Long, snapshot: String, reason: String) {{
	            val fingerprint = nodesSnapshotFingerprint(snapshot)
	            if (fingerprint == nodesLastPushedFingerprint && reason != "runtime_create" && reason != "resume") {{
	                return
	            }}
	            nodesLastPushedFingerprint = fingerprint
	            postRender {{
	                val ok = if (runtimeHandle == handle) nativeApplyNodesUpdate(handle, snapshot) else false
	                mainHandler.post {{
	                    if (runtimeHandle == handle) {{
	                        Log.i("cheng-mobile-shell", "nodes_update reason=" + reason + " ok=" + ok + " bytes=" + snapshot.length)
	                        if (ok) {{
	                            requestFrame()
	                        }}
	                    }}
	                }}
	            }}
	        }}

	        private fun chengContentField(item: JSONObject, field: String): String {{
	            val direct = item.optString(field, "").trim()
	            if (direct.isNotEmpty()) {{
	                return direct
	            }}
	            val nestedItem = item.optJSONObject("item")
	            val nested = nestedItem?.optString(field, "")?.trim().orEmpty()
	            if (nested.isNotEmpty()) {{
	                return nested
	            }}
	            val payload = item.optJSONObject("payload")
	            return payload?.optString(field, "")?.trim().orEmpty()
	        }}

	        private fun chengAppendClearPublishedTargets(targets: LinkedHashMap<String, String>, raw: String, peerId: String) {{
	            val items = chengJsonArrayItems(raw)
	            for (index in 0 until items.length()) {{
	                val item = items.optJSONObject(index) ?: continue
	                if (chengNodeContentPeerCandidate(item) != peerId) {{
	                    continue
	                }}
	                val contentId = chengContentField(item, "contentId")
	                    .ifEmpty {{ chengContentField(item, "id") }}
	                    .ifEmpty {{ chengContentField(item, "postId") }}
	                if (contentId.isEmpty()) {{
	                    continue
	                }}
	                val postId = chengContentField(item, "postId")
	                    .ifEmpty {{ chengContentField(item, "id") }}
	                    .ifEmpty {{ contentId }}
	                targets[contentId] = postId
	            }}
	        }}

	        fun chengClearPublishedContentsFromNative(peerId: String): String {{
	            return try {{
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return startError
	                }}
	                var cleanPeerId = peerId.trim()
	                if (cleanPeerId.isEmpty()) {{
	                    val peerMethod = klass.getMethod("getLocalPeerId")
	                    cleanPeerId = peerMethod.invoke(instance)?.toString()?.trim().orEmpty()
	                }}
	                if (cleanPeerId.isEmpty()) {{
	                    return "{{\"ok\":false,\"error\":\"transfer_identity_unavailable\"}}"
	                }}
	                val feedMethod = klass.getMethod("socialFeedSnapshot", String::class.java, String::class.java, Int::class.javaPrimitiveType)
	                val taskMethod = klass.getMethod("socialPublishTasks", String::class.java, String::class.java, Int::class.javaPrimitiveType)
	                val momentMethod = klass.getMethod("socialMomentsTimeline", String::class.java, Int::class.javaPrimitiveType)
	                val feedText = feedMethod.invoke(instance, "", "", 500)?.toString() ?: "{{\"items\":[]}}"
	                val taskText = taskMethod.invoke(instance, "mine", "", 500)?.toString() ?: "{{\"items\":[]}}"
	                val momentText = momentMethod.invoke(instance, "", 500)?.toString() ?: "{{\"items\":[]}}"
	                val targets = LinkedHashMap<String, String>()
	                chengAppendClearPublishedTargets(targets, feedText, cleanPeerId)
	                chengAppendClearPublishedTargets(targets, taskText, cleanPeerId)
	                chengAppendClearPublishedTargets(targets, momentText, cleanPeerId)
	                val issueMethod = klass.getMethod("socialTombstoneIssue", String::class.java)
	                val failedIds = JSONArray()
	                var tombstonedRemote = 0
	                for ((contentId, postId) in targets) {{
	                    val payload = JSONObject()
	                    payload.put("contentId", contentId)
	                    payload.put("postId", postId)
	                    payload.put("reasonCode", "author_clear_published")
	                    payload.put("issuedBy", cleanPeerId)
	                    val rawResult = issueMethod.invoke(instance, payload.toString())?.toString() ?: "{{\"ok\":false,\"error\":\"social_tombstone_issue_returned_null\"}}"
	                    val tombstone = JSONObject(rawResult)
	                    val ok = tombstone.optBoolean("ok", false) && tombstone.optString("error", "").trim().isEmpty()
	                    if (ok) {{
	                        tombstonedRemote += 1
	                    }} else {{
	                        failedIds.put(contentId)
	                    }}
	                }}
	                val requested = targets.size
	                val progress = JSONObject()
	                progress.put("total", requested)
	                progress.put("completed", requested)
	                progress.put("succeeded", tombstonedRemote)
	                progress.put("failed", failedIds.length())
	                progress.put("currentContentId", "")
	                val result = JSONObject()
	                result.put("peerId", cleanPeerId)
	                result.put("requested", requested)
	                result.put("removed", tombstonedRemote)
	                result.put("tombstonedRemote", tombstonedRemote)
	                result.put("reclaimedAssets", 0)
	                result.put("failedIds", failedIds)
	                val snapshot = JSONObject()
	                snapshot.put("status", "succeeded")
	                snapshot.put("startedAt", System.currentTimeMillis())
	                snapshot.put("updatedAt", System.currentTimeMillis())
	                snapshot.put("progress", progress)
	                snapshot.put("result", result)
	                snapshot.put("error", "")
	                val successText = "已向全网下架 " + tombstonedRemote + " / " + requested + " 条内容"
	                val failedText = if (failedIds.length() > 0) "，还有 " + failedIds.length() + " 条下架失败" else ""
                val out = JSONObject()
                out.put("ok", true)
                out.put("snapshot", snapshot)
                out.put("hint", successText + failedText)
                if (tombstonedRemote > 0) {{
                    pushDistributedContentsToRuntime("clear_published")
                }}
                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "clear_published_contents failed", error)
	                "{{\"ok\":false,\"error\":\"clear_published_contents_failed\"}}"
	            }}
	        }}

	        private fun chengConfirmContentDeleteFromNative(message: String): Boolean {{
	            if (Looper.myLooper() == Looper.getMainLooper()) {{
	                throw IllegalStateException("native_confirm_main_thread_deadlock")
	            }}
	            val latch = java.util.concurrent.CountDownLatch(1)
	            val confirmed = java.util.concurrent.atomic.AtomicBoolean(false)
	            val posted = mainHandler.post {{
	                try {{
	                    android.app.AlertDialog.Builder(this)
	                        .setMessage(message.ifBlank {{ "确认下架这条发布内容？相关视频资产会一起回收。" }})
	                        .setNegativeButton("取消") {{ dialog, _ ->
	                            confirmed.set(false)
	                            dialog.dismiss()
	                            latch.countDown()
	                        }}
	                        .setPositiveButton("确认") {{ dialog, _ ->
	                            confirmed.set(true)
	                            dialog.dismiss()
	                            latch.countDown()
	                        }}
	                        .setOnCancelListener {{
	                            confirmed.set(false)
	                            latch.countDown()
	                        }}
	                        .show()
	                }} catch (error: Throwable) {{
	                    Log.e("cheng-mobile-shell", "content delete confirm failed", error)
	                    latch.countDown()
	                }}
	            }}
	            if (!posted) {{
	                throw IllegalStateException("native_confirm_post_failed")
	            }}
	            latch.await()
	            return confirmed.get()
	        }}

	        fun chengContentDeleteFromNative(contentJson: String, confirmMessage: String): String {{
	            if (Looper.myLooper() == Looper.getMainLooper()) {{
	                throw IllegalStateException("native_confirm_main_thread_deadlock")
	            }}
	            return try {{
	                val content = JSONObject(contentJson)
	                val contentId = chengContentField(content, "id")
	                    .ifEmpty {{ chengContentField(content, "contentId") }}
	                    .ifEmpty {{ chengContentField(content, "postId") }}
	                if (contentId.isEmpty()) {{
	                    return "{{\"ok\":false,\"error\":\"content_id_required\"}}"
	                }}
	                val confirmed = chengConfirmContentDeleteFromNative(confirmMessage)
	                if (!confirmed) {{
	                    val out = JSONObject()
	                    out.put("ok", true)
	                    out.put("confirmed", false)
	                    out.toString()
	                }} else {{
	                    val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                    val instance = klass.getField("INSTANCE").get(null)
	                        ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                    val startError = ensureChengSocialBackendStarted(klass, instance)
	                    if (startError != null) {{
	                        return startError
	                    }}
	                    val peerMethod = klass.getMethod("getLocalPeerId")
	                    val localPeerId = peerMethod.invoke(instance)?.toString()?.trim().orEmpty()
	                    if (localPeerId.isEmpty()) {{
	                        return "{{\"ok\":false,\"error\":\"transfer_identity_unavailable\"}}"
	                    }}
	                    val authorPeerId = chengNodeContentPeerCandidate(content)
	                    if (authorPeerId.isNotEmpty() && authorPeerId != localPeerId) {{
	                        return "{{\"ok\":false,\"error\":\"content_delete_forbidden\"}}"
	                    }}
	                    val postId = chengContentField(content, "postId")
	                        .ifEmpty {{ chengContentField(content, "id") }}
	                        .ifEmpty {{ contentId }}
	                    val payload = JSONObject()
	                    payload.put("contentId", contentId)
	                    payload.put("postId", postId)
	                    payload.put("reasonCode", "author_delete_content")
	                    payload.put("issuedBy", localPeerId)
	                    val issueMethod = klass.getMethod("socialTombstoneIssue", String::class.java)
	                    val rawResult = issueMethod.invoke(instance, payload.toString())?.toString()
	                        ?: return "{{\"ok\":false,\"error\":\"social_tombstone_issue_returned_null\"}}"
	                    val tombstone = JSONObject(rawResult)
	                    val ok = tombstone.optBoolean("ok", false) && tombstone.optString("error", "").trim().isEmpty()
	                    if (!ok) {{
	                        return "{{\"ok\":false,\"error\":\"social_tombstone_issue_failed\"}}"
	                    }}
                    val out = JSONObject()
                    out.put("ok", true)
                    out.put("confirmed", true)
                    out.put("removed", true)
                    out.put("tombstonedRemote", true)
                    out.put("reclaimedAssets", 0)
                    pushDistributedContentsToRuntime("content_delete")
                    out.toString()
	                }}
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "content_delete failed", error)
	                "{{\"ok\":false,\"error\":\"content_delete_failed\"}}"
	            }}
	        }}

	        private fun chengBioDidErrorJson(error: String): String {{
	            val safe = error.replace("\\", "\\\\").replace("\"", "\\\"")
	            return "{{\"ok\":false,\"error\":\"" + safe + "\"}}"
	        }}

	        private fun chengBioDidUtf8(text: String): ByteArray {{
	            return text.toByteArray(Charsets.UTF_8)
	        }}

	        private fun chengBioDidHex(bytes: ByteArray): String {{
	            val table = "0123456789abcdef"
	            val out = CharArray(bytes.size * 2)
	            var j = 0
	            for (value in bytes) {{
	                val b = value.toInt() and 0xff
	                out[j] = table[b ushr 4]
	                out[j + 1] = table[b and 0x0f]
	                j += 2
	            }}
	            return String(out)
	        }}

	        private fun chengBioDidHexText(text: String): String {{
	            return chengBioDidHex(chengBioDidUtf8(text))
	        }}

	        private fun chengBioDidSha256(vararg parts: ByteArray): ByteArray {{
	            val digest = MessageDigest.getInstance("SHA-256")
	            for (part in parts) {{
	                digest.update(part)
	            }}
	            return digest.digest()
	        }}

	        private fun chengBioDidSha256Hex(vararg parts: ByteArray): String {{
	            return chengBioDidHex(chengBioDidSha256(*parts))
	        }}

	        private fun chengBioDidFixed32(value: java.math.BigInteger): ByteArray {{
	            val raw = value.toByteArray()
	            var start = 0
	            while (start < raw.size - 1 && raw[start].toInt() == 0) {{
	                start += 1
	            }}
	            val len = raw.size - start
	            if (len > 32) {{
	                throw IllegalStateException("android_device_did_invalid_ec_scalar_width")
	            }}
	            val out = ByteArray(32)
	            System.arraycopy(raw, start, out, 32 - len, len)
	            return out
	        }}

	        private fun chengBioDidEcdsaDerReadLength(data: ByteArray, offsetRef: IntArray): Int {{
	            if (offsetRef[0] >= data.size) {{
	                throw IllegalStateException("android_device_did_bad_der_length")
	            }}
	            var first = data[offsetRef[0]].toInt() and 0xff
	            offsetRef[0] += 1
	            if ((first and 0x80) == 0) {{
	                return first
	            }}
	            val count = first and 0x7f
	            if (count <= 0 || count > 2 || offsetRef[0] + count > data.size) {{
	                throw IllegalStateException("android_device_did_bad_der_length")
	            }}
	            var len = 0
	            for (i in 0 until count) {{
	                len = (len shl 8) or (data[offsetRef[0]].toInt() and 0xff)
	                offsetRef[0] += 1
	            }}
	            return len
	        }}

	        private fun chengBioDidEcdsaDerReadInt32(data: ByteArray, offsetRef: IntArray): ByteArray {{
	            if (offsetRef[0] >= data.size || (data[offsetRef[0]].toInt() and 0xff) != 0x02) {{
	                throw IllegalStateException("android_device_did_bad_der_integer")
	            }}
	            offsetRef[0] += 1
	            val len = chengBioDidEcdsaDerReadLength(data, offsetRef)
	            if (len <= 0 || offsetRef[0] + len > data.size) {{
	                throw IllegalStateException("android_device_did_bad_der_integer_length")
	            }}
	            var start = offsetRef[0]
	            var count = len
	            while (count > 1 && data[start].toInt() == 0) {{
	                start += 1
	                count -= 1
	            }}
	            if (count > 32) {{
	                throw IllegalStateException("android_device_did_der_integer_too_wide")
	            }}
	            val out = ByteArray(32)
	            System.arraycopy(data, start, out, 32 - count, count)
	            offsetRef[0] += len
	            return out
	        }}

	        private fun chengBioDidEcdsaDerToRaw64(data: ByteArray): ByteArray {{
	            val offsetRef = intArrayOf(0)
	            if (data.isEmpty() || (data[offsetRef[0]].toInt() and 0xff) != 0x30) {{
	                throw IllegalStateException("android_device_did_bad_der_sequence")
	            }}
	            offsetRef[0] += 1
	            val seqLen = chengBioDidEcdsaDerReadLength(data, offsetRef)
	            val seqEnd = offsetRef[0] + seqLen
	            if (seqEnd != data.size) {{
	                throw IllegalStateException("android_device_did_bad_der_sequence_length")
	            }}
	            val r = chengBioDidEcdsaDerReadInt32(data, offsetRef)
	            val s = chengBioDidEcdsaDerReadInt32(data, offsetRef)
	            if (offsetRef[0] != seqEnd) {{
	                throw IllegalStateException("android_device_did_bad_der_trailing")
	            }}
	            val out = ByteArray(64)
	            System.arraycopy(r, 0, out, 0, 32)
	            System.arraycopy(s, 0, out, 32, 32)
	            return out
	        }}

	        private fun chengBioDidLoadKeyStore(): KeyStore {{
	            val keyStore = KeyStore.getInstance("AndroidKeyStore")
	            keyStore.load(null)
	            return keyStore
	        }}

	        private fun chengBioDidEnsureHmacKey(): SecretKey {{
	            val keyStore = chengBioDidLoadKeyStore()
	            val existing = keyStore.getKey(CHENG_BIO_DID_HMAC_ALIAS, null)
	            if (existing is SecretKey) {{
	                return existing
	            }}
	            if (keyStore.containsAlias(CHENG_BIO_DID_HMAC_ALIAS)) {{
	                throw IllegalStateException("android_device_did_hmac_alias_not_secret")
	            }}
	            val generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_HMAC_SHA256, "AndroidKeyStore")
	            val spec = KeyGenParameterSpec.Builder(CHENG_BIO_DID_HMAC_ALIAS, KeyProperties.PURPOSE_SIGN)
	                .build()
	            generator.init(spec)
	            return generator.generateKey()
	        }}

	        private fun chengBioDidEnsureAttestorEntry(): KeyStore.PrivateKeyEntry {{
	            val keyStore = chengBioDidLoadKeyStore()
	            val existing = keyStore.getEntry(CHENG_BIO_DID_ATTESTOR_ALIAS, null)
	            if (existing is KeyStore.PrivateKeyEntry) {{
	                return existing
	            }}
	            if (keyStore.containsAlias(CHENG_BIO_DID_ATTESTOR_ALIAS)) {{
	                throw IllegalStateException("android_device_did_attestor_alias_not_private")
	            }}
	            val generator = KeyPairGenerator.getInstance(KeyProperties.KEY_ALGORITHM_EC, "AndroidKeyStore")
	            val specBuilder = KeyGenParameterSpec.Builder(
	                CHENG_BIO_DID_ATTESTOR_ALIAS,
	                KeyProperties.PURPOSE_SIGN or KeyProperties.PURPOSE_VERIFY
	            )
	                .setAlgorithmParameterSpec(ECGenParameterSpec("secp256r1"))
	                .setDigests(KeyProperties.DIGEST_SHA256)
	                .setUserAuthenticationRequired(true)
	                .setAttestationChallenge(chengBioDidUtf8("cheng.bio.did.android.attestor.v1"))
	            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.N) {{
	                specBuilder.setInvalidatedByBiometricEnrollment(true)
	            }}
	            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R) {{
	                specBuilder.setUserAuthenticationParameters(0, KeyProperties.AUTH_BIOMETRIC_STRONG)
	            }}
	            val spec = specBuilder.build()
	            generator.initialize(spec)
	            generator.generateKeyPair()
	            val created = chengBioDidLoadKeyStore().getEntry(CHENG_BIO_DID_ATTESTOR_ALIAS, null)
	            if (created !is KeyStore.PrivateKeyEntry) {{
	                throw IllegalStateException("android_device_did_attestor_create_failed")
	            }}
	            return created
	        }}

	        private fun chengBioDidHmacBytes(key: SecretKey, domain: String): ByteArray {{
	            val mac = Mac.getInstance("HmacSHA256")
	            mac.init(key)
	            return mac.doFinal(chengBioDidUtf8(domain))
	        }}

	        private fun chengBioDidPublicKeyHex(entry: KeyStore.PrivateKeyEntry): String {{
	            val publicKey = entry.certificate.publicKey
	            if (publicKey !is ECPublicKey) {{
	                throw IllegalStateException("android_device_did_attestor_not_p256")
	            }}
	            val x = chengBioDidFixed32(publicKey.w.affineX)
	            val y = chengBioDidFixed32(publicKey.w.affineY)
	            val out = ByteArray(65)
	            out[0] = 0x04
	            System.arraycopy(x, 0, out, 1, 32)
	            System.arraycopy(y, 0, out, 33, 32)
	            return chengBioDidHex(out)
	        }}

	        private fun chengBioDidCertificateChainText(entry: KeyStore.PrivateKeyEntry): String {{
	            val chain = entry.certificateChain ?: arrayOf(entry.certificate)
	            return chain.joinToString("|") {{ cert ->
	                android.util.Base64.encodeToString(cert.encoded, android.util.Base64.NO_WRAP)
	            }}
	        }}

	        private fun chengBioDidAppendLine(out: StringBuilder, key: String, value: String) {{
	            out.append(key).append('=').append(value).append('\n')
	        }}

		        private fun chengBioDidMapAuthError(errorCode: Int): String {{
		            return when (errorCode) {{
		                BiometricPrompt.BIOMETRIC_ERROR_USER_CANCELED,
		                BiometricPrompt.BIOMETRIC_ERROR_CANCELED -> "device_auth_cancelled"
		                BiometricPrompt.BIOMETRIC_ERROR_TIMEOUT -> "device_auth_timeout"
		                BiometricPrompt.BIOMETRIC_ERROR_LOCKOUT,
		                BiometricPrompt.BIOMETRIC_ERROR_LOCKOUT_PERMANENT -> "device_auth_locked"
		                BiometricPrompt.BIOMETRIC_ERROR_NO_BIOMETRICS -> "device_auth_not_enrolled"
		                BiometricPrompt.BIOMETRIC_ERROR_HW_NOT_PRESENT,
		                BiometricPrompt.BIOMETRIC_ERROR_HW_UNAVAILABLE -> "device_auth_not_available"
		                else -> "device_auth_failed"
		            }}
		        }}

	        private fun chengBioDidAuthenticateAndSignStrongBlocking(promptSubtitle: String, promptDescription: String, attestorEntry: KeyStore.PrivateKeyEntry, signableText: String): String {{
	            if (Looper.myLooper() == Looper.getMainLooper()) {{
	                return "error:device_auth_not_ready"
	            }}
	            val signature = try {{
	                Signature.getInstance("SHA256withECDSA").apply {{
	                    initSign(attestorEntry.privateKey)
	                }}
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "device DID signature init failed", error)
	                return "error:device_auth_failed"
	            }}
	            val latch = java.util.concurrent.CountDownLatch(1)
	            val done = java.util.concurrent.atomic.AtomicBoolean(false)
	            val errorRef = java.util.concurrent.atomic.AtomicReference<String?>(null)
	            val signedRef = java.util.concurrent.atomic.AtomicReference<String?>(null)
	            val cancellationSignal = CancellationSignal()
	            fun finish(signatureHex: String?, error: String?) {{
	                if (done.compareAndSet(false, true)) {{
	                    signedRef.set(signatureHex)
	                    errorRef.set(error)
	                    latch.countDown()
	                }}
	            }}
	            val timeout = Runnable {{
	                Log.w("cheng-mobile-shell", "device DID auth prompt timeout")
	                try {{
	                    cancellationSignal.cancel()
	                }} catch (_: Throwable) {{
	                }}
	                finish(null, "device_auth_timeout")
	            }}
	            val posted = mainHandler.post {{
	                try {{
	                    val builder = BiometricPrompt.Builder(this)
	                        .setTitle("设备认证 DID")
	                        .setSubtitle(promptSubtitle)
	                        .setDescription(promptDescription)
		                        .setNegativeButton("取消", mainExecutor) {{ _, _ ->
		                            mainHandler.removeCallbacks(timeout)
		                            finish(null, "device_auth_cancelled")
		                        }}
	                    if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.Q) {{
	                        builder.setConfirmationRequired(false)
	                    }}
	                    if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R) {{
	                        builder.setAllowedAuthenticators(BiometricManager.Authenticators.BIOMETRIC_STRONG)
	                    }}
		                    val prompt = builder.build()
		                    mainHandler.postDelayed(timeout, 120000L)
		                    prompt.authenticate(
		                        BiometricPrompt.CryptoObject(signature),
		                        cancellationSignal,
		                        mainExecutor,
		                        object : BiometricPrompt.AuthenticationCallback() {{
	                            override fun onAuthenticationError(errorCode: Int, errString: CharSequence) {{
	                                mainHandler.removeCallbacks(timeout)
	                                finish(null, chengBioDidMapAuthError(errorCode))
	                            }}

	                            override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) {{
	                                Log.i("cheng-mobile-shell", "device_auth_ok")
	                                mainHandler.removeCallbacks(timeout)
	                                try {{
	                                    val cryptoSig = result.cryptoObject?.signature ?: signature
	                                    cryptoSig.update(chengBioDidUtf8(signableText))
	                                    val raw64 = chengBioDidEcdsaDerToRaw64(cryptoSig.sign())
	                                    finish(chengBioDidHex(raw64), null)
	                                }} catch (error: Throwable) {{
	                                    Log.e("cheng-mobile-shell", "device DID auth signature failed", error)
	                                    finish(null, "device_auth_failed")
	                                }}
	                            }}

	                            override fun onAuthenticationFailed() {{
	                                Log.w("cheng-mobile-shell", "device DID auth attempt failed")
	                            }}
	                        }}
	                    )
		                }} catch (error: Throwable) {{
		                    Log.e("cheng-mobile-shell", "device DID auth prompt failed", error)
		                    mainHandler.removeCallbacks(timeout)
		                    finish(null, "device_auth_not_available")
		                }}
	            }}
	            if (!posted) {{
	                return "error:device_auth_not_ready"
	            }}
	            if (!latch.await(125000L, java.util.concurrent.TimeUnit.MILLISECONDS)) {{
	                finish(null, "device_auth_timeout")
	            }}
	            val signed = signedRef.get()
	            if (signed != null) {{
	                return signed
	            }}
	            return "error:" + (errorRef.get() ?: "device_auth_failed")
	        }}

	        private fun chengBioDidBuildRequestWire(hmacKey: SecretKey, attestorEntry: KeyStore.PrivateKeyEntry, requestAction: String, purpose: String, latestBundleText: String?, promptSubtitle: String, promptDescription: String): String {{
	            val requestId = "android-device-did-" + requestAction + "-" + System.currentTimeMillis().toString()
	            val platform = "3"
	            val attestationKind = "1"
	            val sensorId = "android.biometric.strong.keystore.v1"
	            var deviceLabel = (android.os.Build.MANUFACTURER + " " + android.os.Build.MODEL).trim()
	            if (deviceLabel.isEmpty()) {{
	                deviceLabel = "Android device"
	            }}
	            val feature32 = chengBioDidHmacBytes(hmacKey, "cheng.bio.did.feature32.v1")
	            val feature32Hex = chengBioDidHex(feature32)
	            val deviceBindingSeed = "android-keystore:" + chengBioDidHex(chengBioDidHmacBytes(hmacKey, "cheng.bio.did.device.binding.seed.v1"))
	            val certChainText = chengBioDidCertificateChainText(attestorEntry)
	            val livenessText = "android-device-auth|request_id=" + requestId.replace("|", "/") + "|purpose=" + purpose + "|did=|ts_ms=" + System.currentTimeMillis().toString()
	            val pubKeyHex = chengBioDidPublicKeyHex(attestorEntry)
	            val certChainCid = chengBioDidSha256Hex(
	                chengBioDidUtf8("cheng.biometric.platform.cert.chain"),
	                chengBioDidUtf8(platform),
	                chengBioDidUtf8("|"),
	                chengBioDidUtf8(attestationKind),
	                chengBioDidUtf8("|"),
	                chengBioDidUtf8(CHENG_BIO_DID_ROOT_KEY_ID),
	                chengBioDidUtf8("|"),
	                chengBioDidUtf8(certChainText)
	            )
	            val livenessCid = chengBioDidSha256Hex(
	                chengBioDidUtf8("cheng.biometric.liveness"),
	                chengBioDidUtf8(livenessText)
	            )
	            val deviceBindingSeedHash = chengBioDidSha256Hex(
	                chengBioDidUtf8("cheng.biometric.device.binding.seed"),
	                chengBioDidUtf8(deviceBindingSeed)
	            )
	            val featureCommitment = chengBioDidSha256Hex(
	                chengBioDidUtf8("cheng.biometric.feature.commitment"),
	                feature32
	            )
	            val signable = StringBuilder()
	            chengBioDidAppendLine(signable, "cheng_biometric_attestation_version", "2")
	            chengBioDidAppendLine(signable, "request_id", chengBioDidHexText(requestId))
	            chengBioDidAppendLine(signable, "purpose", purpose)
	            chengBioDidAppendLine(signable, "sensor_id", chengBioDidHexText(sensorId))
	            chengBioDidAppendLine(signable, "platform", platform)
	            chengBioDidAppendLine(signable, "attestation_kind", attestationKind)
	            chengBioDidAppendLine(signable, "root_key_id", chengBioDidHexText(CHENG_BIO_DID_ROOT_KEY_ID))
	            chengBioDidAppendLine(signable, "cert_chain_cid", certChainCid)
	            chengBioDidAppendLine(signable, "liveness_cid", livenessCid)
	            chengBioDidAppendLine(signable, "device_binding_seed_hash", deviceBindingSeedHash)
	            chengBioDidAppendLine(signable, "device_label", chengBioDidHexText(deviceLabel))
	            chengBioDidAppendLine(signable, "feature_commitment", featureCommitment)
	            chengBioDidAppendLine(signable, "attestor_pub_key", pubKeyHex)
	            val signatureHex = chengBioDidAuthenticateAndSignStrongBlocking(promptSubtitle, promptDescription, attestorEntry, signable.toString())
	            if (signatureHex.startsWith("error:")) {{
	                return chengBioDidErrorJson(signatureHex.removePrefix("error:"))
	            }}
	            val attestation = StringBuilder(signable.toString())
	            chengBioDidAppendLine(attestation, "signature", signatureHex)
	            val wire = StringBuilder()
	            chengBioDidAppendLine(wire, "trusted_attestor_pub_key", pubKeyHex)
	            chengBioDidAppendLine(wire, "trusted_attestor_root_key_id", chengBioDidHexText(CHENG_BIO_DID_ROOT_KEY_ID))
	            chengBioDidAppendLine(wire, "request_id", chengBioDidHexText(requestId))
	            chengBioDidAppendLine(wire, "feature32_hex", feature32Hex)
	            chengBioDidAppendLine(wire, "device_binding_seed", chengBioDidHexText(deviceBindingSeed))
	            chengBioDidAppendLine(wire, "device_label", chengBioDidHexText(deviceLabel))
	            chengBioDidAppendLine(wire, "sensor_id", chengBioDidHexText(sensorId))
	            chengBioDidAppendLine(wire, "hardware_attestation", chengBioDidHexText(attestation.toString()))
	            if (latestBundleText != null) {{
	                chengBioDidAppendLine(wire, "latest_bundle_text", chengBioDidHexText(latestBundleText))
	            }}
	            Log.i("cheng-mobile-shell", "request_wire_built")
	            return wire.toString()
	        }}

	        fun chengProfileBioDidCreateRequestWireFromNative(): String {{
	            return try {{
	                val hmacKey = chengBioDidEnsureHmacKey()
	                Log.i("cheng-mobile-shell", "keystore_ready hmac key ensured")
	                val attestorEntry = chengBioDidEnsureAttestorEntry()
	                Log.i("cheng-mobile-shell", "attestor_ready pub=" + chengBioDidPublicKeyHex(attestorEntry))
	                chengBioDidBuildRequestWire(hmacKey, attestorEntry, "create", "1", null, "请验证当前设备设备认证并创建本机 DID", "验证后继续创建设备 DID")
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "profile device DID create request wire failed", error)
	                chengBioDidErrorJson("device_did_create_request_wire_failed")
	            }}
	        }}

	        fun chengProfileBioDidImportRequestWireFromNative(recoveryText: String): String {{
	            return try {{
	                val normalizedRecoveryText = recoveryText.trim()
	                if (normalizedRecoveryText.isEmpty()) {{
	                    return chengBioDidErrorJson("device_did_recovery_required")
	                }}
	                val hmacKey = chengBioDidEnsureHmacKey()
	                Log.i("cheng-mobile-shell", "keystore_ready hmac key ensured")
	                val attestorEntry = chengBioDidEnsureAttestorEntry()
	                Log.i("cheng-mobile-shell", "attestor_ready pub=" + chengBioDidPublicKeyHex(attestorEntry))
	                Log.i("cheng-mobile-shell", "import_request_wire_built")
	                chengBioDidBuildRequestWire(hmacKey, attestorEntry, "import", "2", normalizedRecoveryText, "请完成设备认证并恢复 DID", "验证后继续导入 DID")
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "profile device DID import request wire failed", error)
	                chengBioDidErrorJson("device_did_import_request_wire_failed")
	            }}
	        }}

	        private fun chengTradingBinanceInterval(interval: String): String {{
	            return when (interval.trim()) {{
	                "1m" -> "1m"
	                "5m" -> "5m"
	                "15m" -> "15m"
	                "1H" -> "1h"
	                "4H" -> "4h"
	                "1D" -> "1d"
	                else -> "1h"
	            }}
	        }}

	        private fun chengTradingNumber(value: String): Double {{
	            return value.trim().toDoubleOrNull() ?: 0.0
	        }}

	        private fun chengTradingFetchText(url: String, timeoutMs: Int): String {{
	            var connection: java.net.HttpURLConnection? = null
	            try {{
	                connection = java.net.URL(url).openConnection() as java.net.HttpURLConnection
	                connection.connectTimeout = timeoutMs
	                connection.readTimeout = timeoutMs
	                connection.requestMethod = "GET"
	                connection.setRequestProperty("Accept", "application/json")
	                if (connection.responseCode !in 200..299) {{
	                    throw IOException("market_http_" + connection.responseCode)
	                }}
	                return connection.inputStream.bufferedReader(Charsets.UTF_8).use {{ it.readText() }}
	            }} finally {{
	                connection?.disconnect()
	            }}
	        }}

	        private fun chengTradingFetchObject(url: String, timeoutMs: Int): JSONObject {{
	            return JSONObject(chengTradingFetchText(url, timeoutMs))
	        }}

	        private fun chengTradingFetchArray(url: String, timeoutMs: Int): JSONArray {{
	            return JSONArray(chengTradingFetchText(url, timeoutMs))
	        }}

	        private fun chengTradingParseBookSide(rows: JSONArray, reverseForAsks: Boolean): JSONArray {{
	            val out = JSONArray()
	            var total = 0.0
	            val indices = if (reverseForAsks) (rows.length() - 1 downTo 0) else (0 until rows.length())
	            for (index in indices) {{
	                val row = rows.optJSONArray(index) ?: continue
	                val price = chengTradingNumber(row.optString(0, "0"))
	                val amount = chengTradingNumber(row.optString(1, "0"))
	                total += amount
	                val item = JSONObject()
	                item.put("price", price)
	                item.put("amount", amount)
	                item.put("total", total)
	                out.put(item)
	            }}
	            return out
	        }}

	        fun chengTradingRefreshFromNative(pairJson: String, interval: String): String {{
	            return try {{
	                val pair = JSONObject(pairJson)
	                val binanceSymbol = pair.optString("binanceSymbol", "").trim()
	                if (binanceSymbol.isEmpty()) {{
	                    return "{{\"ok\":false,\"error\":\"trading_pair_symbol_required\"}}"
	                }}
	                val failedParts = JSONArray()
	                var livePrice = pair.optDouble("price", 0.0)
	                val encodedSymbol = java.net.URLEncoder.encode(binanceSymbol, "UTF-8")
	                try {{
	                    val ticker = chengTradingFetchObject("https://api.binance.com/api/v3/ticker/24hr?symbol=" + encodedSymbol, 2600)
	                    val price = chengTradingNumber(ticker.optString("lastPrice", "0"))
	                    if (price > 0.0) {{
	                        livePrice = price
	                        pair.put("price", price)
	                    }}
	                    pair.put("change24h", chengTradingNumber(ticker.optString("priceChangePercent", "0")))
	                    pair.put("high24h", chengTradingNumber(ticker.optString("highPrice", "0")))
	                    pair.put("low24h", chengTradingNumber(ticker.optString("lowPrice", "0")))
	                    pair.put("volume24h", chengTradingNumber(ticker.optString("quoteVolume", "0")))
	                }} catch (error: Throwable) {{
	                    failedParts.put("24h")
	                }}
	                val candles = JSONArray()
	                try {{
	                    val iv = chengTradingBinanceInterval(interval)
	                    val rawCandles = chengTradingFetchArray("https://api.binance.com/api/v3/klines?symbol=" + encodedSymbol + "&interval=" + iv + "&limit=120", 2600)
	                    for (index in 0 until rawCandles.length()) {{
	                        val row = rawCandles.optJSONArray(index) ?: continue
	                        val item = JSONObject()
	                        item.put("time", row.optLong(0, 0L))
	                        item.put("open", chengTradingNumber(row.optString(1, "0")))
	                        item.put("high", chengTradingNumber(row.optString(2, "0")))
	                        item.put("low", chengTradingNumber(row.optString(3, "0")))
	                        val close = chengTradingNumber(row.optString(4, "0"))
	                        item.put("close", close)
	                        item.put("volume", chengTradingNumber(row.optString(5, "0")))
	                        candles.put(item)
	                    }}
	                    if (candles.length() == 0) {{
	                        failedParts.put("K线")
	                    }} else if (livePrice > 0.0) {{
	                        val last = candles.optJSONObject(candles.length() - 1)
	                        last?.put("close", livePrice)
	                        last?.put("high", kotlin.math.max(last.optDouble("high", livePrice), livePrice))
	                        last?.put("low", kotlin.math.min(last.optDouble("low", livePrice), livePrice))
	                    }}
	                }} catch (error: Throwable) {{
	                    failedParts.put("K线")
	                }}
	                var orderBook = JSONObject()
	                try {{
	                    val depth = chengTradingFetchObject("https://api.binance.com/api/v3/depth?symbol=" + encodedSymbol + "&limit=15", 2600)
	                    orderBook = JSONObject()
	                    orderBook.put("asks", chengTradingParseBookSide(depth.optJSONArray("asks") ?: JSONArray(), true))
	                    orderBook.put("bids", chengTradingParseBookSide(depth.optJSONArray("bids") ?: JSONArray(), false))
	                }} catch (error: Throwable) {{
	                    failedParts.put("盘口")
	                }}
	                val trades = JSONArray()
	                try {{
	                    val rawTrades = chengTradingFetchArray("https://api.binance.com/api/v3/trades?symbol=" + encodedSymbol + "&limit=30", 2600)
	                    for (index in 0 until rawTrades.length()) {{
	                        val row = rawTrades.optJSONObject(index) ?: continue
	                        val item = JSONObject()
	                        item.put("price", chengTradingNumber(row.optString("price", "0")))
	                        item.put("amount", chengTradingNumber(row.optString("qty", "0")))
	                        item.put("time", row.optLong("time", 0L))
	                        item.put("isBuy", !row.optBoolean("isBuyerMaker", false))
	                        trades.put(item)
	                    }}
	                    if (trades.length() == 0) {{
	                        failedParts.put("成交")
	                    }}
	                }} catch (error: Throwable) {{
	                    failedParts.put("成交")
	                }}
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("pair", pair)
	                out.put("candles", candles)
	                out.put("orderBook", orderBook)
	                out.put("trades", trades)
	                out.put("updatedAt", System.currentTimeMillis())
	                if (failedParts.length() == 0) {{
	                    out.put("dexHealth", "live")
	                    out.put("loadError", "")
	                }} else if (failedParts.length() >= 4) {{
	                    out.put("dexHealth", "offline")
	                    out.put("loadError", "行情暂时不可用，请稍后重试。")
	                }} else {{
	                    val names = ArrayList<String>()
	                    for (index in 0 until failedParts.length()) {{
	                        names.add(failedParts.optString(index))
	                    }}
	                    out.put("dexHealth", "partial")
	                    out.put("loadError", "部分数据更新失败：" + names.joinToString("、"))
	                }}
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "trading_refresh failed", error)
	                "{{\"ok\":false,\"error\":\"trading_refresh_failed\"}}"
	            }}
	        }}

	        private fun chengStartActivityForNative(intent: Intent): Boolean {{
	            if (Looper.myLooper() == Looper.getMainLooper()) {{
	                return try {{
	                    startActivity(intent)
	                    true
	                }} catch (error: Throwable) {{
	                    Log.e("cheng-mobile-shell", "native startActivity failed", error)
	                    false
	                }}
	            }}
	            val latch = java.util.concurrent.CountDownLatch(1)
	            var opened = false
	            val posted = mainHandler.post {{
	                try {{
	                    startActivity(intent)
	                    opened = true
	                }} catch (error: Throwable) {{
	                    Log.e("cheng-mobile-shell", "native startActivity failed", error)
	                }} finally {{
	                    latch.countDown()
	                }}
	            }}
	            if (!posted) {{
	                return false
	            }}
	            return try {{
	                latch.await(1500L, java.util.concurrent.TimeUnit.MILLISECONDS)
	                opened
	            }} catch (_: InterruptedException) {{
	                Thread.currentThread().interrupt()
	                false
	            }}
	        }}

	        private fun chengContentLocationText(value: Any?): String {{
	            return when (value) {{
	                null, JSONObject.NULL -> ""
	                else -> value.toString().trim()
	            }}
	        }}

	        private fun chengContentLocationLabel(content: JSONObject): String {{
	            val directHint = chengContentLocationText(content.opt("locationHint"))
	            if (directHint.isNotEmpty()) {{
	                return directHint
	            }}
	            val location = content.optJSONObject("location") ?: return ""
	            val pub = location.optJSONObject("public") ?: return ""
	            val parts = ArrayList<String>()
	            val push = {{ raw: Any? ->
	                val text = chengContentLocationText(raw)
	                if (text.isNotEmpty() && !parts.contains(text)) {{
	                    parts.add(text)
	                }}
	            }}
	            push(pub.opt("country"))
	            push(pub.opt("province"))
	            push(pub.opt("city"))
	            push(pub.opt("district"))
	            return parts.joinToString("")
	        }}

	        private fun chengContentLocationUri(content: JSONObject): Uri? {{
	            val label = chengContentLocationLabel(content)
	            if (label.isEmpty()) {{
	                return null
	            }}
	            return Uri.Builder()
	                .scheme("https")
	                .authority("uri.amap.com")
	                .path("search")
	                .appendQueryParameter("keyword", label)
	                .appendQueryParameter("src", "UniMaker")
	                .appendQueryParameter("callnative", "1")
	                .build()
	        }}

	        fun chengOpenContentLocationFromNative(contentJson: String): Int {{
	            return try {{
	                val content = JSONObject(contentJson)
	                val uri = chengContentLocationUri(content) ?: return 0
	                val intent = Intent(Intent.ACTION_VIEW, uri).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
	                if (chengStartActivityForNative(intent)) 1 else -1
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "content_location_open failed", error)
	                -1
	            }}
	        }}

	        private fun chengOpenNfcSettingsFromNative(payment: Boolean): Boolean {{
	            val action = if (payment) Settings.ACTION_NFC_PAYMENT_SETTINGS else Settings.ACTION_NFC_SETTINGS
	            val primary = Intent(action).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
	            if (chengStartActivityForNative(primary)) {{
	                return true
	            }}
	            return chengStartActivityForNative(Intent(Settings.ACTION_WIRELESS_SETTINGS).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
	        }}

	        fun chengRwadNfcReceiveToggleFromNative(walletId: String, active: Boolean): String {{
	            return try {{
	                val cleanWallet = walletId.trim()
	                if (cleanWallet.isEmpty()) {{
	                    return "{{\"ok\":false,\"error\":\"transfer_identity_unavailable\"}}"
	                }}
	                val klass = Class.forName("com.unimaker.app.security.NfcTransferNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return "{{\"ok\":false,\"error\":\"bridge_method_unavailable:rwad_nfc_receive_toggle\"}}"
	                val value = if (active) {{
	                    val method = klass.getMethod("stopReceive", android.content.Context::class.java, android.app.Activity::class.java, String::class.java)
	                    method.invoke(instance, applicationContext, this, cleanWallet)
	                }} else {{
	                    val method = klass.getMethod("startReceive", android.content.Context::class.java, android.app.Activity::class.java, String::class.java, Long::class.javaPrimitiveType)
	                    method.invoke(instance, applicationContext, this, cleanWallet, 180000L)
	                }}
	                val out = JSONObject(value as Map<*, *>)
	                if (!out.optBoolean("ok", false)) {{
	                    val code = out.optString("error", "").trim()
	                    if (code == "nfc_wallet_intercepted") {{
	                        out.put("settingsOpened", chengOpenNfcSettingsFromNative(true))
	                    }} else if (code == "nfc_disabled" || code == "nfc_unavailable") {{
	                        out.put("settingsOpened", chengOpenNfcSettingsFromNative(false))
	                    }}
	                }}
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "rwad_nfc_receive_toggle failed", error)
	                "{{\"ok\":false,\"error\":\"bridge_method_unavailable:rwad_nfc_receive_toggle\"}}"
	            }}
	        }}

	        private fun queryComputerUseVideoByTitle(title: String): ComputerUseVideoSelection {{
	            val cleanTitle = title.trim()
	            if (cleanTitle.isEmpty()) {{
	                return ComputerUseVideoSelection(CHENG_CU_MEDIA_EMPTY_TITLE, "", "", "", 0L, 0L)
	            }}
	            val projection = arrayOf(
	                MediaStore.Video.Media._ID,
	                MediaStore.Video.Media.DISPLAY_NAME,
		                MediaStore.Video.Media.TITLE,
		                MediaStore.Video.Media.SIZE,
		                MediaStore.Video.Media.DURATION,
		                MediaStore.Video.Media.WIDTH,
		                MediaStore.Video.Media.HEIGHT,
		                MediaStore.Video.Media.MIME_TYPE,
		            )
	            val candidateNames = arrayOf(
	                cleanTitle,
	                cleanTitle + ".mp4",
	                cleanTitle + ".MP4",
	                cleanTitle + ".mov",
	                cleanTitle + ".MOV",
	                cleanTitle + ".m4v",
	                cleanTitle + ".M4V",
	                cleanTitle + ".3gp",
	                cleanTitle + ".3GP",
	                cleanTitle + ".webm",
	                cleanTitle + ".WEBM",
	            )
	            val displaySelection = candidateNames.joinToString(" OR ") {{ MediaStore.Video.Media.DISPLAY_NAME + "=?" }}
	            val selection = MediaStore.Video.Media.TITLE + "=? OR " + displaySelection
	            val selectionArgs = arrayOf(cleanTitle, *candidateNames)
	            return try {{
	                val cursor = contentResolver.query(
	                    MediaStore.Video.Media.EXTERNAL_CONTENT_URI,
	                    projection,
	                    selection,
	                    selectionArgs,
	                    MediaStore.Video.Media.DATE_MODIFIED + " DESC"
	                ) ?: return ComputerUseVideoSelection(CHENG_CU_MEDIA_QUERY_FAILED, "", "", "", 0L, 0L)
	                cursor.use {{
	                    val idIndex = it.getColumnIndexOrThrow(MediaStore.Video.Media._ID)
		                    val displayIndex = it.getColumnIndexOrThrow(MediaStore.Video.Media.DISPLAY_NAME)
		                    val sizeIndex = it.getColumnIndexOrThrow(MediaStore.Video.Media.SIZE)
		                    val durationIndex = it.getColumnIndexOrThrow(MediaStore.Video.Media.DURATION)
		                    val widthIndex = it.getColumnIndexOrThrow(MediaStore.Video.Media.WIDTH)
		                    val heightIndex = it.getColumnIndexOrThrow(MediaStore.Video.Media.HEIGHT)
		                    val mimeIndex = it.getColumnIndexOrThrow(MediaStore.Video.Media.MIME_TYPE)
		                    var selected: ComputerUseVideoSelection? = null
		                    while (it.moveToNext()) {{
		                        val id = it.getLong(idIndex)
		                        val uri = ContentUris.withAppendedId(MediaStore.Video.Media.EXTERNAL_CONTENT_URI, id).toString()
		                        val displayName = if (it.isNull(displayIndex)) "" else it.getString(displayIndex)
		                        val sizeBytes = if (it.isNull(sizeIndex)) 0L else it.getLong(sizeIndex)
		                        val durationMs = if (it.isNull(durationIndex)) 0L else it.getLong(durationIndex)
		                        val width = if (it.isNull(widthIndex)) 0 else it.getInt(widthIndex)
		                        val height = if (it.isNull(heightIndex)) 0 else it.getInt(heightIndex)
		                        val mime = if (it.isNull(mimeIndex)) "" else it.getString(mimeIndex)
		                        val shortSide = minOf(width, height)
		                        val longSide = maxOf(width, height)
		                        if (!mime.startsWith("video/") || durationMs < 5000L || shortSide < 720 || longSide < 1080) {{
		                            Log.i("cheng-mobile-shell", "computer_use_media_candidate_rejected id=" + id + " duration_ms=" + durationMs + " width=" + width + " height=" + height + " size=" + sizeBytes + " mime=" + mime)
		                            continue
		                        }}
		                        val current = ComputerUseVideoSelection(CHENG_CU_MEDIA_SELECTED, uri, displayName, "", sizeBytes, durationMs)
	                        if (selected != null && selected.uri != current.uri) {{
	                            return ComputerUseVideoSelection(CHENG_CU_MEDIA_MULTIPLE_MATCHES, "", "", "", 0L, 0L)
	                        }}
	                        selected = current
	                    }}
	                    selected ?: ComputerUseVideoSelection(CHENG_CU_MEDIA_NOT_FOUND, "", "", "", 0L, 0L)
	                }}
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "computer_use_media_query_failed title_len=" + cleanTitle.length, error)
	                ComputerUseVideoSelection(CHENG_CU_MEDIA_QUERY_FAILED, "", "", "", 0L, 0L)
	            }}
	        }}

	        private fun sanitizeComputerUseMediaFileName(raw: String): String {{
	            val source = if (raw.trim().isEmpty()) "selected-video.mp4" else raw.trim()
	            val dotIndex = source.lastIndexOf('.')
	            val rawBase = if (dotIndex > 0) source.substring(0, dotIndex) else source
	            val rawExt = if (dotIndex > 0 && dotIndex < source.length - 1) source.substring(dotIndex + 1) else ""
	            var ext = ""
	            if (rawExt.length in 1..8) {{
	                var extValid = true
	                for (ch in rawExt) {{
	                    val valid = (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9')
	                    if (!valid) {{
	                        extValid = false
	                    }}
	                }}
	                if (extValid) {{
	                    ext = "." + rawExt.lowercase(Locale.ROOT)
	                }}
	            }}
	            val builder = StringBuilder()
	            for (ch in rawBase) {{
	                val valid = (ch >= 'A' && ch <= 'Z') ||
	                    (ch >= 'a' && ch <= 'z') ||
	                    (ch >= '0' && ch <= '9') ||
	                    ch == '_' ||
	                    ch == '-'
	                builder.append(if (valid) ch else '_')
	            }}
	            val cleanedBase = builder.toString().trim('_', '-')
	            val safeBase = if (cleanedBase.isEmpty()) "selected-video" else cleanedBase
	            val safeName = safeBase + ext
	            return if (safeName.length > 96) safeName.takeLast(96) else safeName
	        }}

	        private fun computerUseHex(bytes: ByteArray): String {{
	            val alphabet = "0123456789abcdef"
	            val out = StringBuilder(bytes.size * 2)
	            for (byte in bytes) {{
	                val value = byte.toInt() and 0xff
	                out.append(alphabet[value ushr 4])
	                out.append(alphabet[value and 0x0f])
	            }}
	            return out.toString()
	        }}

	        private fun computerUseSha256Hex(text: String): String {{
	            val digest = MessageDigest.getInstance("SHA-256")
	            return computerUseHex(digest.digest(text.toByteArray(Charsets.UTF_8)))
	        }}

		        private fun withComputerUseVideoPreview(selection: ComputerUseVideoSelection): ComputerUseVideoSelection {{
		            if (selection.status != CHENG_CU_MEDIA_SELECTED) {{
		                return selection
		            }}
		            if (selection.localPath.trim().isEmpty()) {{
		                return ComputerUseVideoSelection(CHENG_CU_MEDIA_PREVIEW_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
		            }}
		            return try {{
		                val preview = chengDecodeVideoFrameFromPath(selection.localPath)
		                Log.i("cheng-mobile-shell", "computer_use_video_preview decoded path_len=" + selection.localPath.length + " size=" + preview.width + "x" + preview.height)
		                selection.copy(previewImage = preview)
		            }} catch (error: Throwable) {{
		                Log.e("cheng-mobile-shell", "computer_use_video_preview_failed path_len=" + selection.localPath.length, error)
		                ComputerUseVideoSelection(CHENG_CU_MEDIA_PREVIEW_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
		            }}
		        }}

	        private fun copyComputerUseVideoToPrivateFile(selection: ComputerUseVideoSelection): ComputerUseVideoSelection {{
	            if (selection.status != CHENG_CU_MEDIA_SELECTED) {{
	                return selection
	            }}
	            if (selection.uri.isEmpty()) {{
	                return ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	            }}
	            return try {{
	                val dir = File(filesDir, "computer-use-media")
	                if ((!dir.exists() && !dir.mkdirs()) || !dir.isDirectory) {{
	                    Log.e("cheng-mobile-shell", "computer_use_media_copy_dir_failed path_len=" + dir.absolutePath.length)
	                    return ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	                }}
	                val tmpFile = File(dir, "pending-" + computerUseSha256Hex(selection.uri) + ".tmp")
	                if (tmpFile.exists() && !tmpFile.delete()) {{
	                    Log.e("cheng-mobile-shell", "computer_use_media_copy_tmp_delete_failed path_len=" + tmpFile.absolutePath.length)
	                    return ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	                }}
	                var copiedBytes = 0L
	                val input = contentResolver.openInputStream(Uri.parse(selection.uri))
	                if (input == null) {{
	                    Log.e("cheng-mobile-shell", "computer_use_media_copy_open_failed uri_len=" + selection.uri.length)
	                    return ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	                }}
	                val digest = MessageDigest.getInstance("SHA-256")
	                input.use {{ source ->
	                    FileOutputStream(tmpFile, false).use {{ output ->
	                        val buffer = ByteArray(65536)
	                        while (true) {{
	                            val readBytes = source.read(buffer)
	                            if (readBytes < 0) {{
	                                break
	                            }}
	                            output.write(buffer, 0, readBytes)
	                            digest.update(buffer, 0, readBytes)
	                            copiedBytes += readBytes.toLong()
	                        }}
	                        output.fd.sync()
	                    }}
	                }}
	                if (selection.sizeBytes > 0L && copiedBytes != selection.sizeBytes) {{
	                    tmpFile.delete()
	                    Log.e("cheng-mobile-shell", "computer_use_media_copy_size_mismatch expected=" + selection.sizeBytes + " actual=" + copiedBytes)
	                    return ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	                }}
	                val contentHash = computerUseHex(digest.digest())
	                val outputName = "video-" + contentHash + "-" + sanitizeComputerUseMediaFileName(selection.displayName)
	                val outputFile = File(dir, outputName)
	                if (outputFile.exists()) {{
	                    if (outputFile.length() != copiedBytes) {{
	                        tmpFile.delete()
	                        Log.e("cheng-mobile-shell", "computer_use_media_copy_existing_size_mismatch expected=" + copiedBytes + " actual=" + outputFile.length())
	                        return ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	                    }}
	                    tmpFile.delete()
	                    Log.i("cheng-mobile-shell", "computer_use_media_copy_result status=1 bytes=" + copiedBytes + " path_len=" + outputFile.absolutePath.length)
	                    return ComputerUseVideoSelection(CHENG_CU_MEDIA_SELECTED, selection.uri, selection.displayName, outputFile.absolutePath, copiedBytes, selection.durationMs)
	                }}
	                if (!tmpFile.renameTo(outputFile)) {{
	                    tmpFile.delete()
	                    Log.e("cheng-mobile-shell", "computer_use_media_copy_rename_failed path_len=" + outputFile.absolutePath.length)
	                    return ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	                }}
	                Log.i("cheng-mobile-shell", "computer_use_media_copy_result status=1 bytes=" + copiedBytes + " path_len=" + outputFile.absolutePath.length)
	                ComputerUseVideoSelection(CHENG_CU_MEDIA_SELECTED, selection.uri, selection.displayName, outputFile.absolutePath, copiedBytes, selection.durationMs)
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "computer_use_media_copy_failed uri_len=" + selection.uri.length, error)
	                ComputerUseVideoSelection(CHENG_CU_MEDIA_COPY_FAILED, selection.uri, selection.displayName, "", selection.sizeBytes, selection.durationMs)
	            }}
	        }}

	        private fun deliverComputerUseVideoSelection(request: PendingComputerUseMediaSelection, selection: ComputerUseVideoSelection) {{
	            val handle = request.handle
	            postPriorityRender {{
		                var imageOk = true
		                if (runtimeHandle == handle && selection.previewImage != null) {{
		                    imageOk = nativeInstallDynamicImageTexture(handle, CHENG_MEDIA_PREVIEWS_STATE_REF, selection.previewImage.width, selection.previewImage.height, selection.previewImage.pixels)
		                }}
	                val ok = if (runtimeHandle == handle && imageOk) {{
	                    nativeApplyComputerUseMediaSelection(handle, selection.uri, selection.displayName, selection.localPath, selection.sizeBytes, selection.durationMs, selection.status, selection.previewImage != null)
	                }} else {{
	                    false
	                }}
	                if (ok) {{
	                    syncRuntimeStorageDirty(handle)
	                    clearPendingComputerUsePublishRetry(request, selection)
	                }} else {{
	                    storePendingComputerUsePublishRetry(request, selection, "media_selection_not_ready")
	                }}
	                Log.i("cheng-mobile-shell", "computer_use_media_selection template=" + request.templateCode + " status=" + selection.status + " title_len=" + request.title.length + " uri_len=" + selection.uri.length + " name_len=" + selection.displayName.length + " path_len=" + selection.localPath.length + " preview=" + (selection.previewImage != null) + " image_ok=" + imageOk + " ok=" + ok)
		                mainHandler.post {{
		                    if (runtimeHandle == handle) {{
		                        updateComputerUseNativeMediaStatus(selection.status)
		                        requestFrame()
		                    }}
		                }}
		            }}
		            requestFrame()
		        }}

	        private fun computerUseTemplateName(code: Int): String {{
	            return when (code) {{
	                1 -> "短视频发布"
	                2 -> "广告短视频发布"
	                3 -> "授权商品草稿"
	                4 -> "购买辅助"
	                5 -> "搜索"
	                6 -> "二手距离筛选"
	                0 -> "未匹配"
	                else -> "失败 " + code
	            }}
	        }}

	        private fun computerUseMediaStatusLabel(status: Int): String {{
	            return when (status) {{
	                CHENG_CU_MEDIA_SELECTED -> "已自动选择视频"
	                CHENG_CU_MEDIA_PERMISSION_DENIED -> "媒体权限被拒绝"
	                CHENG_CU_MEDIA_NOT_FOUND -> "未找到唯一视频"
	                CHENG_CU_MEDIA_MULTIPLE_MATCHES -> "匹配到多个视频，已停止"
	                CHENG_CU_MEDIA_QUERY_FAILED -> "媒体库查询失败"
	                CHENG_CU_MEDIA_EMPTY_TITLE -> "标题为空，无法选视频"
	                CHENG_CU_MEDIA_COPY_FAILED -> "视频复制到私有目录失败"
	                CHENG_CU_MEDIA_PREVIEW_FAILED -> "视频封面帧生成失败"
	                else -> "状态 " + status
	            }}
	        }}

	        private fun isComputerUsePublishSelection(request: PendingComputerUseMediaSelection, selection: ComputerUseVideoSelection): Boolean {{
	            return request.templateCode == 1 && selection.status == CHENG_CU_MEDIA_SELECTED && selection.localPath.trim().isNotEmpty()
	        }}

	        private fun sameComputerUsePublishSelection(a: PendingComputerUsePublishRetry?, request: PendingComputerUseMediaSelection, selection: ComputerUseVideoSelection): Boolean {{
	            val current = a ?: return false
	            return current.request.handle == request.handle &&
	                current.request.templateCode == request.templateCode &&
	                current.selection.localPath == selection.localPath
	        }}

	        private fun clearPendingComputerUsePublishRetry(request: PendingComputerUseMediaSelection, selection: ComputerUseVideoSelection) {{
	            val current = pendingComputerUsePublishRetry ?: return
	            if (sameComputerUsePublishSelection(current, request, selection)) {{
	                pendingComputerUsePublishRetry = null
	                Log.i("cheng-mobile-shell", "computer_use_publish_pending clear path_len=" + selection.localPath.length)
	            }}
	        }}

	        private fun storePendingComputerUsePublishRetry(request: PendingComputerUseMediaSelection, selection: ComputerUseVideoSelection, reason: String) {{
	            if (!isComputerUsePublishSelection(request, selection)) {{
	                return
	            }}
	            val attempts = if (sameComputerUsePublishSelection(pendingComputerUsePublishRetry, request, selection)) {{
	                pendingComputerUsePublishRetry?.attempts ?: 0
	            }} else {{
	                0
	            }}
	            pendingComputerUsePublishRetry = PendingComputerUsePublishRetry(request, selection, attempts)
	            Log.i("cheng-mobile-shell", "computer_use_publish_pending store reason=" + reason + " attempts=" + attempts + " path_len=" + selection.localPath.length)
	        }}

	        private fun retryPendingComputerUsePublish(reason: String) {{
	            val current = pendingComputerUsePublishRetry ?: return
	            val handle = runtimeHandle
	            if (handle == 0L || current.request.handle != handle) {{
	                pendingComputerUsePublishRetry = null
	                Log.i("cheng-mobile-shell", "computer_use_publish_pending drop reason=runtime_changed")
	                return
	            }}
	            if (current.attempts >= 2) {{
	                pendingComputerUsePublishRetry = null
	                Log.e("cheng-mobile-shell", "computer_use_publish_pending exhausted reason=" + reason + " path_len=" + current.selection.localPath.length)
	                return
	            }}
	            val next = current.copy(attempts = current.attempts + 1)
	            pendingComputerUsePublishRetry = next
	            Log.i("cheng-mobile-shell", "computer_use_publish_pending retry reason=" + reason + " attempts=" + next.attempts + " path_len=" + next.selection.localPath.length)
	            deliverComputerUseVideoSelection(next.request, next.selection)
	        }}

	        private fun computerUseReplayStatusLabel(status: Int): String {{
	            return when (status) {{
	                0 -> "未开始"
	                1 -> "进行中"
	                2 -> "完成"
	                3 -> "等待慢放间隔"
	                -1 -> "步骤执行失败"
	                -2 -> "没有可回放任务"
	                -3 -> "任务没有步骤"
	                -4 -> "慢放倍数无效"
	                else -> "状态 " + status
	            }}
	        }}

	        private fun computerUseExecutionModeLabel(mode: Int): String {{
	            return if (mode == 1) "人类模式" else "AI模式"
	        }}

	        private fun computerUseSlowMultiplierLabel(slowPermille: Int): String {{
	            val normalized = when {{
	                slowPermille < 1000 -> 1000
	                slowPermille > 10000 -> 10000
	                else -> slowPermille
	            }}
	            val whole = normalized / 1000
	            val tenth = (normalized % 1000) / 100
	            return if (tenth == 0) whole.toString() + "x" else whole.toString() + "." + tenth.toString() + "x"
	        }}

	        private fun installComputerUseNativeOverlay() {{
	            Log.i("cheng-mobile-shell", "computer_use_native_overlay disabled; task cards render in Xiaoyou chat")
	        }}

	        private fun renderComputerUseNativeOverlay() {{
	            return
	        }}

	        private fun showComputerUseNativeTask(text: String, result: Int, title: String, mediaStatus: Int) {{
	            computerUseNativeLastText = text.trim()
	            computerUseNativeLastResult = result
	            computerUseNativeLastTitle = title.trim()
	            computerUseNativeLastMediaStatus = mediaStatus
	            renderComputerUseNativeOverlay()
	        }}

	        private fun updateComputerUseNativeMediaStatus(status: Int) {{
	            computerUseNativeLastMediaStatus = status
	            renderComputerUseNativeOverlay()
	        }}

	        private fun updateComputerUseNativeRuntimeState(chatTrigger: Int, chatResult: Int, title: String, executionMode: Int, slowPermille: Int, replayActive: Int, replayStepIndex: Int, replayStepCount: Int, replayApplied: Int, replayStatus: Int) {{
	            if (executionMode >= 0) {{
	                computerUseNativeExecutionMode = executionMode
	            }}
	            if (slowPermille >= 1000) {{
	                computerUseNativeSlowPermille = slowPermille
	            }}
	            if (chatTrigger > computerUseNativeLastChatTriggerCount) {{
	                computerUseNativeLastChatTriggerCount = chatTrigger
	                val text = if (computerUseNativeLastChatText.isNotEmpty()) computerUseNativeLastChatText else computerUseNativeLastText
	                showComputerUseNativeTask(text, chatResult, title, computerUseNativeLastMediaStatus)
	            }}
	        }}

	        private fun startComputerUseVideoSelection(request: PendingComputerUseMediaSelection) {{
	            if (runtimeHandle != request.handle) {{
	                return
	            }}
	            Log.i("cheng-mobile-shell", "computer_use_media_query_start template=" + request.templateCode + " title_len=" + request.title.length)
	            Thread({{
	                val selection = withComputerUseVideoPreview(copyComputerUseVideoToPrivateFile(queryComputerUseVideoByTitle(request.title)))
	                mainHandler.post {{
	                    if (runtimeHandle == request.handle) {{
	                        deliverComputerUseVideoSelection(request, selection)
	                    }}
	                }}
	            }}, "cheng-computer-use-mediastore").start()
	        }}

	        private fun maybeResolveComputerUseVideoMedia(handle: Long, result: Int, title: String) {{
	            if (result != 1 && result != 2) {{
	                return
	            }}
	            val cleanTitle = title.trim()
	            val request = PendingComputerUseMediaSelection(handle, cleanTitle, result)
	            Log.i("cheng-mobile-shell", "computer_use_media_resolve template=" + result + " title_len=" + cleanTitle.length + " has_permission=" + hasVideoMediaPermission())
	            if (cleanTitle.isEmpty()) {{
	                deliverComputerUseVideoSelection(request, ComputerUseVideoSelection(CHENG_CU_MEDIA_EMPTY_TITLE, "", "", "", 0L, 0L))
	                return
	            }}
	            if (!hasVideoMediaPermission()) {{
	                pendingComputerUseMediaSelection = request
	                requestVideoMediaPermission()
	                return
	            }}
	            startComputerUseVideoSelection(request)
	        }}

	        private fun validateStateRef(value: String): String {{
            if (value.isEmpty()) {{
                throw IllegalArgumentException("cheng state ref is empty")
            }}
            for (ch in value) {{
                val valid = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_'
                if (!valid) {{
                    throw IllegalArgumentException("cheng state ref contains invalid character")
                }}
            }}
            return value
        }}

        private fun validateMediaSlotId(value: String): String {{
            if (value.isEmpty()) {{
                throw IllegalArgumentException("cheng media slot id is empty")
            }}
            for (ch in value) {{
                val valid = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.' || ch == '-'
                if (!valid) {{
                    throw IllegalArgumentException("cheng media slot id contains invalid character")
                }}
            }}
            return value
        }}

        private fun validateMediaActionKind(value: String): String {{
            if (value.isEmpty()) {{
                throw IllegalArgumentException("cheng media action is empty")
            }}
            for (ch in value) {{
                val valid = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
                if (!valid) {{
                    throw IllegalArgumentException("cheng media action contains invalid character")
                }}
            }}
            return value
        }}

        private data class Pcm16WavPayload(
            val sampleRateHz: Int,
            val channelCount: Int,
            val bitsPerSample: Int,
            val blockAlign: Int,
            val pcmDataOffset: Int,
            val pcmByteCount: Int,
        )

        private fun readLeU16(bytes: ByteArray, offset: Int): Int {{
            return (bytes[offset].toInt() and 0xff) or ((bytes[offset + 1].toInt() and 0xff) shl 8)
        }}

        private fun readLeU32(bytes: ByteArray, offset: Int): Long {{
            return ((bytes[offset].toLong() and 0xffL) or
                ((bytes[offset + 1].toLong() and 0xffL) shl 8) or
                ((bytes[offset + 2].toLong() and 0xffL) shl 16) or
                ((bytes[offset + 3].toLong() and 0xffL) shl 24))
        }}

        private fun bytesMatchAscii4(bytes: ByteArray, offset: Int, a: Char, b: Char, c: Char, d: Char): Boolean {{
            if (offset < 0 || offset + 4 > bytes.size) {{
                return false
            }}
            return bytes[offset].toInt() == a.code &&
                bytes[offset + 1].toInt() == b.code &&
                bytes[offset + 2].toInt() == c.code &&
                bytes[offset + 3].toInt() == d.code
        }}

        private fun isHex64(value: String): Boolean {{
            if (value.length != 64) {{
                return false
            }}
            for (ch in value) {{
                val valid = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')
                if (!valid) {{
                    return false
                }}
            }}
            return true
        }}

        private fun hash31String(value: String): Int {{
            var hash = 216613626L
            for (ch in value) {{
                hash = hash xor ch.code.toLong()
                hash = (hash * 16777619L) and 2147483647L
            }}
            return hash.toInt()
        }}

        private fun hash31Bytes(bytes: ByteArray, offset: Int, byteCount: Int): Int {{
            var hash = 216613626L
            var i = 0
            while (i < byteCount) {{
                hash = hash xor (bytes[offset + i].toLong() and 0xffL)
                hash = (hash * 16777619L) and 2147483647L
                i += 1
            }}
            return hash.toInt()
        }}

        private fun parsePcm16WavPayload(bytes: ByteArray): Pcm16WavPayload? {{
            if (bytes.size < 44) {{
                return null
            }}
            if (!bytesMatchAscii4(bytes, 0, 'R', 'I', 'F', 'F') ||
                !bytesMatchAscii4(bytes, 8, 'W', 'A', 'V', 'E')) {{
                return null
            }}
            val riffSize = readLeU32(bytes, 4)
            if (riffSize + 8L != bytes.size.toLong()) {{
                return null
            }}
            var cursor = 12
            var sampleRateHz = 0
            var channelCount = 0
            var bitsPerSample = 0
            var blockAlign = 0
            var byteRate = 0L
            var fmtFound = false
            var dataOffset = 0
            var dataBytes = 0
            while (cursor + 8 <= bytes.size) {{
                val chunkSizeLong = readLeU32(bytes, cursor + 4)
                if (chunkSizeLong > Int.MAX_VALUE.toLong()) {{
                    return null
                }}
                val chunkSize = chunkSizeLong.toInt()
                val chunkDataOffset = cursor + 8
                if (chunkSize < 0 || chunkDataOffset + chunkSize > bytes.size) {{
                    return null
                }}
                if (bytesMatchAscii4(bytes, cursor, 'f', 'm', 't', ' ')) {{
                    if (chunkSize < 16) {{
                        return null
                    }}
                    val audioFormat = readLeU16(bytes, chunkDataOffset)
                    channelCount = readLeU16(bytes, chunkDataOffset + 2)
                    sampleRateHz = readLeU32(bytes, chunkDataOffset + 4).toInt()
                    byteRate = readLeU32(bytes, chunkDataOffset + 8)
                    blockAlign = readLeU16(bytes, chunkDataOffset + 12)
                    bitsPerSample = readLeU16(bytes, chunkDataOffset + 14)
                    if (audioFormat != 1 || channelCount <= 0 || sampleRateHz <= 0) {{
                        return null
                    }}
                    fmtFound = true
                }} else if (bytesMatchAscii4(bytes, cursor, 'd', 'a', 't', 'a')) {{
                    dataOffset = chunkDataOffset
                    dataBytes = chunkSize
                }}
                cursor = chunkDataOffset + chunkSize
                if ((chunkSize and 1) == 1) {{
                    cursor += 1
                }}
            }}
            if (!fmtFound || dataOffset <= 0 || dataBytes <= 0) {{
                return null
            }}
            if (bitsPerSample != 16 || channelCount < 1 || channelCount > 2) {{
                return null
            }}
            val expectedBlockAlign = channelCount * 2
            if (blockAlign != expectedBlockAlign || byteRate != (sampleRateHz * expectedBlockAlign).toLong()) {{
                return null
            }}
            if ((dataBytes % blockAlign) != 0) {{
                return null
            }}
            return Pcm16WavPayload(sampleRateHz, channelCount, bitsPerSample, blockAlign, dataOffset, dataBytes)
        }}

        private fun recordAudioPlaybackFailureLocked(slotId: String, assetCid: String, audioProviderHash: Int, reason: String) {{
            audioPlaybackReceiptCount += 1
            audioPlaybackStatus = CHENG_AUDIO_STATUS_FAILED
            audioPlaybackState = CHENG_AUDIO_STATUS_FAILED
            audioPlaybackSlotId = slotId
            audioPlaybackAssetCid = assetCid
            audioPlaybackProviderHash = if (audioProviderHash > 0) audioProviderHash else 0
            audioPlaybackSlotHash = hash31String(slotId)
            audioPlaybackAssetHash = hash31String(assetCid)
            publishNativeAudioPlaybackReceiptLocked()
            Log.e("cheng-mobile-shell", "audio_playback_failed slot=" + slotId + " asset=" + assetCid + " provider_hash=" + audioPlaybackProviderHash + " reason=" + reason + " receipt=" + audioPlaybackReceiptCount)
        }}

        private fun releaseAudioPlaybackLocked(resetReceiptState: Boolean) {{
            val track = audioPlaybackTrack
            if (track != null) {{
                try {{
                    track.pause()
                }} catch (ignored: IllegalStateException) {{
                }}
                track.release()
            }}
            audioPlaybackTrack = null
            audioPlaybackSlotId = ""
            audioPlaybackAssetCid = ""
            audioPlaybackSampleRateHz = 0
            audioPlaybackChannelCount = 0
            audioPlaybackBitsPerSample = 0
            audioPlaybackPcmDataOffset = 0
            audioPlaybackPcmBytes = 0
            audioPlaybackProviderHash = 0
            audioPlaybackSlotHash = 0
            audioPlaybackAssetHash = 0
            audioPlaybackDataHash = 0
            if (resetReceiptState) {{
                audioPlaybackReceiptCount = 0
                audioPlaybackStatus = CHENG_AUDIO_STATUS_NONE
                audioPlaybackState = CHENG_AUDIO_STATUS_NONE
                publishNativeAudioPlaybackReceiptLocked()
            }}
        }}

        private fun releaseAudioPlayback() {{
            synchronized(audioPlaybackLock) {{
                releaseAudioPlaybackLocked(true)
            }}
        }}

        private fun requestMediaAudioFocus(reason: String): Boolean {{
            if (mediaAudioFocusHeld) {{
                return true
            }}
            val audioManager = getSystemService(Context.AUDIO_SERVICE) as AudioManager
            val result = audioManager.requestAudioFocus(
                mediaAudioFocusChangeListener,
                AudioManager.STREAM_MUSIC,
                AudioManager.AUDIOFOCUS_GAIN
            )
            val granted = result == AudioManager.AUDIOFOCUS_REQUEST_GRANTED
            mediaAudioFocusHeld = granted
            Log.i("cheng-mobile-shell", "audio_focus_request reason=" + reason + " result=" + result + " granted=" + granted)
            return granted
        }}

        private fun abandonMediaAudioFocus(reason: String) {{
            if (!mediaAudioFocusHeld) {{
                return
            }}
            val audioManager = getSystemService(Context.AUDIO_SERVICE) as AudioManager
            val result = audioManager.abandonAudioFocus(mediaAudioFocusChangeListener)
            mediaAudioFocusHeld = false
            Log.i("cheng-mobile-shell", "audio_focus_abandon reason=" + reason + " result=" + result)
        }}

        private fun syncMediaAudioFocus(playbackState: Int, reason: String) {{
            if (playbackState == CHENG_MEDIA_PLAYBACK_PLAYING || playbackState == CHENG_MEDIA_PLAYBACK_SEEKED) {{
                requestMediaAudioFocus(reason)
            }} else {{
                abandonMediaAudioFocus(reason)
            }}
        }}

        private fun pauseAudioPlaybackForLifecycle() {{
            synchronized(audioPlaybackLock) {{
                val track = audioPlaybackTrack ?: return
                try {{
                    track.pause()
                    audioPlaybackStatus = CHENG_AUDIO_STATUS_PAUSED
                    audioPlaybackState = CHENG_AUDIO_STATUS_PAUSED
                    publishNativeAudioPlaybackReceiptLocked()
                }} catch (error: IllegalStateException) {{
                    recordAudioPlaybackFailureLocked(audioPlaybackSlotId, audioPlaybackAssetCid, audioPlaybackProviderHash, "pause_lifecycle_failed")
                    Log.e("cheng-mobile-shell", "audio lifecycle pause failed", error)
                }}
            }}
        }}

        private fun openAudioPlaybackFromPayload(slotId: String, payload: String, shouldPlay: Boolean, audioProviderHash: Int): Boolean {{
            synchronized(audioPlaybackLock) {{
                if (audioProviderHash <= 0) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, 0, "missing_audio_provider")
                    return false
                }}
                if (slotId.isEmpty()) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "missing_slot")
                    return false
                }}
                if (!isHex64(payload)) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "invalid_asset_cid")
                    return false
                }}
                if (audioPlaybackTrack != null && audioPlaybackAssetCid == payload && audioPlaybackSlotId == slotId && audioPlaybackProviderHash == audioProviderHash) {{
                    audioPlaybackReceiptCount += 1
                    return if (shouldPlay) {{
                        playAudioPlaybackLocked(slotId, payload, audioProviderHash)
                    }} else {{
                        audioPlaybackStatus = CHENG_AUDIO_STATUS_OPENED
                        audioPlaybackState = CHENG_AUDIO_STATUS_OPENED
                        publishNativeAudioPlaybackReceiptLocked()
                        true
                    }}
                }}
                releaseAudioPlaybackLocked(false)
                val relPath = "runtime/media/assets/" + payload + ".wav"
                val wavBytes = try {{
                    assets.open(relPath).use {{ stream -> stream.readBytes() }}
                }} catch (error: IOException) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "asset_missing")
                    Log.e("cheng-mobile-shell", "audio asset open failed rel=" + relPath, error)
                    return false
                }}
                val wav = parsePcm16WavPayload(wavBytes)
                if (wav == null) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "wav_pcm16_validation_failed")
                    return false
                }}
                val channelMask = if (wav.channelCount == 1) AudioFormat.CHANNEL_OUT_MONO else AudioFormat.CHANNEL_OUT_STEREO
                val format = AudioFormat.Builder()
                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                    .setSampleRate(wav.sampleRateHz)
                    .setChannelMask(channelMask)
                    .build()
                val attributes = AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_MEDIA)
                    .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
                    .build()
                val track = try {{
                    AudioTrack.Builder()
                        .setAudioAttributes(attributes)
                        .setAudioFormat(format)
                        .setTransferMode(AudioTrack.MODE_STATIC)
                        .setBufferSizeInBytes(wav.pcmByteCount)
                        .build()
                }} catch (error: RuntimeException) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "audiotrack_build_failed")
                    Log.e("cheng-mobile-shell", "audio track build failed asset=" + payload, error)
                    return false
                }}
                if (track.state != AudioTrack.STATE_INITIALIZED) {{
                    track.release()
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "audiotrack_not_initialized")
                    return false
                }}
                val written = track.write(wavBytes, wav.pcmDataOffset, wav.pcmByteCount)
                if (written != wav.pcmByteCount) {{
                    track.release()
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "audiotrack_short_write")
                    return false
                }}
                audioPlaybackTrack = track
                audioPlaybackSlotId = slotId
                audioPlaybackAssetCid = payload
                audioPlaybackReceiptCount += 1
                audioPlaybackStatus = CHENG_AUDIO_STATUS_OPENED
                audioPlaybackState = CHENG_AUDIO_STATUS_OPENED
                audioPlaybackSampleRateHz = wav.sampleRateHz
                audioPlaybackChannelCount = wav.channelCount
                audioPlaybackBitsPerSample = wav.bitsPerSample
                audioPlaybackPcmDataOffset = wav.pcmDataOffset
                audioPlaybackPcmBytes = wav.pcmByteCount
                audioPlaybackProviderHash = audioProviderHash
                audioPlaybackSlotHash = hash31String(slotId)
                audioPlaybackAssetHash = hash31String(payload)
                audioPlaybackDataHash = hash31Bytes(wavBytes, wav.pcmDataOffset, wav.pcmByteCount)
                Log.i("cheng-mobile-shell", "audio_playback_opened slot=" + slotId + " asset=" + payload + " rel=" + relPath + " sample_rate=" + audioPlaybackSampleRateHz + " channels=" + audioPlaybackChannelCount + " bits=" + audioPlaybackBitsPerSample + " pcm_offset=" + audioPlaybackPcmDataOffset + " pcm_bytes=" + audioPlaybackPcmBytes + " provider_hash=" + audioPlaybackProviderHash + " slot_hash=" + audioPlaybackSlotHash + " data_hash=" + audioPlaybackDataHash + " receipt=" + audioPlaybackReceiptCount)
                if (!shouldPlay) {{
                    publishNativeAudioPlaybackReceiptLocked()
                }}
                return if (shouldPlay) playAudioPlaybackLocked(slotId, payload, audioProviderHash) else true
            }}
        }}

        private fun playAudioPlaybackLocked(slotId: String, assetCid: String, audioProviderHash: Int): Boolean {{
            val track = audioPlaybackTrack
            if (track == null || audioPlaybackAssetCid != assetCid || audioPlaybackSlotId != slotId || audioPlaybackProviderHash != audioProviderHash) {{
                recordAudioPlaybackFailureLocked(slotId, assetCid, audioProviderHash, "track_not_open")
                return false
            }}
            return try {{
                track.play()
                audioPlaybackStatus = CHENG_AUDIO_STATUS_PLAYING
                audioPlaybackState = CHENG_AUDIO_STATUS_PLAYING
                publishNativeAudioPlaybackReceiptLocked()
                Log.i("cheng-mobile-shell", "audio_playback_first_packet slot=" + slotId + " asset=" + assetCid + " sample_rate=" + audioPlaybackSampleRateHz + " channels=" + audioPlaybackChannelCount + " pcm_bytes=" + audioPlaybackPcmBytes + " provider_hash=" + audioPlaybackProviderHash + " slot_hash=" + audioPlaybackSlotHash + " data_hash=" + audioPlaybackDataHash + " receipt=" + audioPlaybackReceiptCount)
                true
            }} catch (error: IllegalStateException) {{
                recordAudioPlaybackFailureLocked(slotId, assetCid, audioProviderHash, "play_failed")
                Log.e("cheng-mobile-shell", "audio playback play failed asset=" + assetCid, error)
                false
            }}
        }}

        private fun pauseAudioPlaybackAction(slotId: String, audioProviderHash: Int): Boolean {{
            synchronized(audioPlaybackLock) {{
                val track = audioPlaybackTrack
                if (audioProviderHash <= 0) {{
                    recordAudioPlaybackFailureLocked(slotId, audioPlaybackAssetCid, 0, "missing_audio_provider")
                    return false
                }}
                if (track == null || audioPlaybackSlotId != slotId || audioPlaybackProviderHash != audioProviderHash) {{
                    recordAudioPlaybackFailureLocked(slotId, audioPlaybackAssetCid, audioProviderHash, "pause_without_track")
                    return false
                }}
                return try {{
                    track.pause()
                    audioPlaybackReceiptCount += 1
                    audioPlaybackStatus = CHENG_AUDIO_STATUS_PAUSED
                    audioPlaybackState = CHENG_AUDIO_STATUS_PAUSED
                    publishNativeAudioPlaybackReceiptLocked()
                    true
                }} catch (error: IllegalStateException) {{
                    recordAudioPlaybackFailureLocked(slotId, audioPlaybackAssetCid, audioProviderHash, "pause_failed")
                    Log.e("cheng-mobile-shell", "audio playback pause failed", error)
                    false
                }}
            }}
        }}

        private fun seekAudioPlaybackToStart(slotId: String, payload: String, audioProviderHash: Int): Boolean {{
            synchronized(audioPlaybackLock) {{
                if (audioProviderHash <= 0) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, 0, "missing_audio_provider")
                    return false
                }}
                if (audioPlaybackTrack == null && isHex64(payload)) {{
                    if (!openAudioPlaybackFromPayload(slotId, payload, false, audioProviderHash)) {{
                        return false
                    }}
                }}
                val track = audioPlaybackTrack
                if (track == null || audioPlaybackSlotId != slotId || audioPlaybackProviderHash != audioProviderHash) {{
                    recordAudioPlaybackFailureLocked(slotId, payload, audioProviderHash, "seek_without_track")
                    return false
                }}
                return try {{
                    track.pause()
                    val seekOk = track.setPlaybackHeadPosition(0)
                    if (seekOk != AudioTrack.SUCCESS) {{
                        recordAudioPlaybackFailureLocked(slotId, audioPlaybackAssetCid, audioProviderHash, "seek_failed")
                        return false
                    }}
                    audioPlaybackReceiptCount += 1
                    audioPlaybackStatus = CHENG_AUDIO_STATUS_SEEKED
                    audioPlaybackState = CHENG_AUDIO_STATUS_SEEKED
                    publishNativeAudioPlaybackReceiptLocked()
                    true
                }} catch (error: IllegalStateException) {{
                    recordAudioPlaybackFailureLocked(slotId, audioPlaybackAssetCid, audioProviderHash, "seek_failed")
                    Log.e("cheng-mobile-shell", "audio playback seek failed", error)
                    false
                }}
            }}
        }}

        private fun handleHostAudioAction(receiptKind: Int, slotId: String, action: String, payload: String, audioProviderHash: Int): Boolean {{
            if (receiptKind != CHENG_MEDIA_KIND_AUDIO) {{
                return true
            }}
            return when (action) {{
                "OpenAsset" -> openAudioPlaybackFromPayload(slotId, payload, false, audioProviderHash)
                "Play" -> openAudioPlaybackFromPayload(slotId, payload, true, audioProviderHash)
                "Pause" -> pauseAudioPlaybackAction(slotId, audioProviderHash)
                "Seek" -> seekAudioPlaybackToStart(slotId, payload, audioProviderHash)
                else -> true
            }}
        }}

        private fun handleMediaActionIntent(sourceIntent: Intent?) {{
            val handle = runtimeHandle
            if (handle == 0L || sourceIntent == null) {{
                return
            }}
            val slotId = validateMediaSlotId(sourceIntent.getStringExtra(CHENG_MEDIA_SLOT_EXTRA)?.trim() ?: return)
            val payload = sourceIntent.getStringExtra(CHENG_MEDIA_PAYLOAD_EXTRA) ?: ""
            val rawActions = sourceIntent.getStringExtra(CHENG_MEDIA_ACTIONS_EXTRA)
            val actions = if (rawActions != null && rawActions.trim().isNotEmpty()) {{
                rawActions.split(",").map {{ validateMediaActionKind(it.trim()) }}
            }} else {{
                val action = sourceIntent.getStringExtra(CHENG_MEDIA_ACTION_EXTRA)?.trim() ?: return
                listOf(validateMediaActionKind(action))
            }}
            if (actions.isEmpty()) {{
                return
            }}
	            postPriorityRender {{
	                var allOk = true
	                for (action in actions) {{
	                    val ok = if (runtimeHandle == handle) nativeApplyMediaAction(handle, slotId, action, payload) else false
	                    if (ok) {{
	                        syncRuntimeStorageDirty(handle)
	                    }}
	                    val receiptCount = if (runtimeHandle == handle) nativeMediaReceiptCount(handle) else -1
                    val receiptIndex = receiptCount - 1
                    val receiptActionCode = if (receiptIndex >= 0 && runtimeHandle == handle) nativeMediaReceiptActionCodeAt(handle, receiptIndex) else -1
                    val receiptStatus = if (receiptIndex >= 0 && runtimeHandle == handle) nativeMediaReceiptStatusAt(handle, receiptIndex) else -1
                    val receiptState = if (receiptIndex >= 0 && runtimeHandle == handle) nativeMediaReceiptStateAt(handle, receiptIndex) else -1
