    /* Defined further below in the shared GLES core (MobileShellNativeGlesCoreSource,
       emitted after this prologue in the same translation unit); forward-declared here
       so the checked rawfile/asset readers below can verify integrity like the Android
       AAsset readers do. */
    static uint32_t cheng_android_crc32_u8(const uint8_t* data, int byteCount);

    static const char* kChengGlyphSdfPixelAssetRel = "runtime/unimaker_glyph_sdf_pixels.bin";
    static const char* kChengSceneDataAssetRel = "runtime/unimaker_scene_data.bin";

    /* Headless asset fallback: when there is no NativeResourceManager (standalone
       capture exe, not an ArkTS ability), read the asset from
       $CHENG_HEADLESS_ASSET_DIR/<rel> on disk. Mirrors the Android
       cheng_android_read_asset_file_fallback contract (same numeric return codes). */
    static int32_t cheng_harmony_read_asset_file_fallback(const char* rel, void* out, int32_t byteCount, int32_t expectedCrc32) {{
      const char* dir = getenv("CHENG_HEADLESS_ASSET_DIR");
      if (dir == NULL || dir[0] == '\0' || out == NULL || byteCount <= 0) {{
        return 2;
      }}
      char path[4096];
      snprintf(path, sizeof(path), "%s/%s", dir, rel);
      FILE* f = fopen(path, "rb");
      if (f == NULL) {{
        return 3;
      }}
      size_t total = 0;
      unsigned char* dst = (unsigned char*)out;
      while (total < (size_t)byteCount) {{
        size_t n = fread(dst + total, 1u, (size_t)byteCount - total, f);
        if (n == 0) {{ fclose(f); return 4; }}
        total += n;
      }}
      unsigned char probe;
      if (fread(&probe, 1u, 1u, f) != 0) {{ fclose(f); return 5; }}
      fclose(f);
      uint32_t actualCrc32 = cheng_android_crc32_u8(dst, byteCount);
      if (actualCrc32 != (uint32_t)expectedCrc32) {{ return 6; }}
      return 0;
    }}

    static const char* cheng_harmony_rawfile_path(const char* relPath) {{
      static const char* prefix = "rawfile/";
      if (relPath == NULL) {{
        return NULL;
      }}
      if (strncmp(relPath, prefix, 8u) == 0) {{
        return relPath + 8u;
      }}
      return relPath;
    }}

    /* Checked RawFile read: exact byte count + CRC32 match required, so the scene
       runtime's integrity gate passes identically to the Android AAsset readers
       (cheng_mobile_host_read_glyph_sdf_pixel_asset/read_scene_data_asset in
       MobileShellAndroidHostSource). Return codes match that contract:
       0=ok 1=invalid-args 2=no-resource-manager 3=missing 4=length-mismatch
       5=short-read 6=crc-mismatch. */
    static int32_t cheng_host_read_asset(const char* rel, void* out, int32_t byteCount, int32_t expectedCrc32) {{
      if (out == NULL || byteCount <= 0) {{
        CHENG_HOST_LOG_ERROR("rawfile read invalid args rel=%s out=%p byteCount=%d", rel ? rel : "", out, byteCount);
        return 1;
      }}
      if (s_resource_manager == NULL) {{
        if (getenv("CHENG_HEADLESS_ASSET_DIR") != NULL) {{
          return cheng_harmony_read_asset_file_fallback(rel, out, byteCount, expectedCrc32);
        }}
        CHENG_HOST_LOG_ERROR("rawfile read without resource manager rel=%s", rel ? rel : "");
        return 2;
      }}
      const char* rawPath = cheng_harmony_rawfile_path(rel);
      RawFile* rawFile = OH_ResourceManager_OpenRawFile(s_resource_manager, rawPath);
      if (rawFile == NULL) {{
        CHENG_HOST_LOG_ERROR("rawfile missing rel=%s", rel ? rel : "");
        return 3;
      }}
      long rawSize = OH_ResourceManager_GetRawFileSize(rawFile);
      if (rawSize != (long)byteCount) {{
        CHENG_HOST_LOG_ERROR("rawfile length mismatch rel=%s actual=%ld expected=%d", rel ? rel : "", rawSize, byteCount);
        OH_ResourceManager_CloseRawFile(rawFile);
        return 4;
      }}
      uint8_t* dst = (uint8_t*)out;
      int32_t readTotal = 0;
      while (readTotal < byteCount) {{
        int n = OH_ResourceManager_ReadRawFile(rawFile, dst + readTotal, (size_t)(byteCount - readTotal));
        if (n <= 0) {{
          CHENG_HOST_LOG_ERROR("rawfile short read rel=%s read=%d expected=%d", rel ? rel : "", readTotal, byteCount);
          OH_ResourceManager_CloseRawFile(rawFile);
          return 5;
        }}
        readTotal += n;
      }}
      OH_ResourceManager_CloseRawFile(rawFile);
      uint32_t actualCrc32 = cheng_android_crc32_u8(dst, byteCount);
      if (actualCrc32 != (uint32_t)expectedCrc32) {{
        CHENG_HOST_LOG_ERROR("rawfile crc mismatch rel=%s actual=%08x expected=%08x", rel ? rel : "", actualCrc32, (uint32_t)expectedCrc32);
        return 6;
      }}
      CHENG_HOST_LOG_INFO("rawfile read ok rel=%s bytes=%d crc32=%08x", rel ? rel : "", byteCount, actualCrc32);
      return 0;
    }}

    int32_t cheng_mobile_host_read_glyph_sdf_pixel_asset(void* out, int32_t byteCount, int32_t expectedCrc32) {{
      return cheng_host_read_asset(kChengGlyphSdfPixelAssetRel, out, byteCount, expectedCrc32);
    }}

    void cheng_mobile_host_trace_step(int32_t step) {{
      CHENG_HOST_LOG_INFO("app_trace step=%{{public}}d", (int)step);
    }}

    int32_t cheng_mobile_host_read_scene_data_asset(void* out, int32_t byteCount, int32_t expectedCrc32) {{
      return cheng_host_read_asset(kChengSceneDataAssetRel, out, byteCount, expectedCrc32);
    }}

    static char* cheng_harmony_read_raw_text(const char* relPath) {{
      if (s_resource_manager == NULL || relPath == NULL || relPath[0] == '\0') {{
        return NULL;
      }}
      const char* rawPath = cheng_harmony_rawfile_path(relPath);
      RawFile* rawFile = OH_ResourceManager_OpenRawFile(s_resource_manager, rawPath);
      if (rawFile == NULL) {{
        return NULL;
      }}
      long rawSize = OH_ResourceManager_GetRawFileSize(rawFile);
      if (rawSize < 0) {{
        OH_ResourceManager_CloseRawFile(rawFile);
        return NULL;
      }}
      size_t size = (size_t)rawSize;
      char* textBuf = (char*)calloc(size + 1u, 1u);
      if (textBuf == NULL) {{
        OH_ResourceManager_CloseRawFile(rawFile);
        return NULL;
      }}
      if (size > 0u) {{
        int readLen = OH_ResourceManager_ReadRawFile(rawFile, textBuf, size);
        if (readLen < 0) {{
          free(textBuf);
          OH_ResourceManager_CloseRawFile(rawFile);
          return NULL;
        }}
        if ((size_t)readLen < size) {{
          textBuf[(size_t)readLen] = '\0';
        }} else {{
          textBuf[size] = '\0';
        }}
      }}
      OH_ResourceManager_CloseRawFile(rawFile);
      return textBuf;
    }}

    static void cheng_harmony_apply_runtime_payloads(void* handle) {{
      if (s_runtime_payloads_applied != 0 || handle == NULL || s_resource_manager == NULL) {{
        return;
      }}
      cheng_mobile_host_runtime_set_manifest_payloads_fn setRuntimePayloads =
          (cheng_mobile_host_runtime_set_manifest_payloads_fn)dlsym(handle, "cheng_mobile_host_runtime_set_manifest_payloads");
      if (setRuntimePayloads == NULL) {{
        return;
      }}
      char* manifestJson = cheng_harmony_read_raw_text(kChengRuntimeManifest);
      char* contractPayloadJson = cheng_harmony_read_raw_text(kChengRuntimeContractPayloadRel);
      char* bundlePayloadJson = cheng_harmony_read_raw_text(kChengRuntimeBundlePayloadRel);
      setRuntimePayloads(manifestJson, contractPayloadJson, bundlePayloadJson);
      if (manifestJson != NULL) {{
        free(manifestJson);
      }}
      if (contractPayloadJson != NULL) {{
        free(contractPayloadJson);
      }}
      if (bundlePayloadJson != NULL) {{
        free(bundlePayloadJson);
      }}
      s_runtime_payloads_applied = 1;
    }}

    static void cheng_harmony_apply_launch_args(void* handle) {{
      if (s_launch_args_applied != 0 || handle == NULL || s_resource_manager == NULL) {{
        return;
      }}
      cheng_mobile_host_runtime_set_launch_args_fn setLaunchArgs =
          (cheng_mobile_host_runtime_set_launch_args_fn)dlsym(handle, "cheng_mobile_host_runtime_set_launch_args");
      if (setLaunchArgs == NULL) {{
        return;
      }}
      char* argsKv = cheng_harmony_read_raw_text(kChengLaunchArgsKvRel);
      char* argsJson = cheng_harmony_read_raw_text(kChengLaunchArgsJsonRel);
      setLaunchArgs(argsKv, argsJson);
      if (argsKv != NULL) {{
        free(argsKv);
      }}
      if (argsJson != NULL) {{
        free(argsJson);
      }}
      s_launch_args_applied = 1;
    }}

    static int cheng_harmony_init_runtime(void) {{
      if (s_runtime.app_id != 0u) {{
        return 1;
      }}
      if (s_resource_manager == NULL) {{
        return 0;
      }}
      void* handle = dlopen(NULL, RTLD_NOW);
      if (handle == NULL) {{
        return 0;
      }}
      cheng_harmony_apply_runtime_payloads(handle);
      cheng_harmony_apply_launch_args(handle);
      cheng_app_init_fn initFn = (cheng_app_init_fn)dlsym(handle, "cheng_app_init");
      s_set_window = (cheng_app_set_window_fn)dlsym(handle, "cheng_app_set_window");
      s_tick = (cheng_app_tick_fn)dlsym(handle, "cheng_app_tick");
      s_touch = (cheng_app_on_touch_milli_fn)dlsym(handle, "cheng_app_on_touch_milli");
      s_needs_frame = (cheng_app_needs_frame_fn)dlsym(handle, "cheng_app_needs_frame");
      s_pause = (cheng_app_pause_fn)dlsym(handle, "cheng_app_pause");
      s_resume = (cheng_app_resume_fn)dlsym(handle, "cheng_app_resume");
      if (initFn == NULL || s_set_window == NULL || s_tick == NULL || s_touch == NULL ||
          s_needs_frame == NULL || s_pause == NULL || s_resume == NULL) {{
        CHENG_HOST_LOG_ERROR("missing required app export during harmony init");
        return 0;
      }}
      s_runtime.app_id = initFn();
      return 1;
    }}

    static napi_value ChengSetResourceManager(napi_env env, napi_callback_info info) {{
      size_t argc = 1u;
      napi_value argv[1] = {{0}};
      (void)napi_get_cb_info(env, info, &argc, argv, NULL, NULL);
      if (argc >= 1u) {{
        if (s_resource_manager != NULL) {{
          OH_ResourceManager_ReleaseNativeResourceManager(s_resource_manager);
          s_resource_manager = NULL;
          s_runtime_payloads_applied = 0;
          s_launch_args_applied = 0;
        }}
        s_resource_manager = OH_ResourceManager_InitNativeResourceManager(env, argv[0]);
        if (s_resource_manager != NULL) {{
          (void)cheng_harmony_init_runtime();
        }}
      }}
      napi_value result = NULL;
      (void)napi_get_undefined(env, &result);
      return result;
    }}

    static napi_value ChengHarmonyHostNapiInit(napi_env env, napi_value exports) {{
      napi_property_descriptor props[1] = {{
          {{"setResourceManager", NULL, ChengSetResourceManager, NULL, NULL, NULL, napi_default, NULL}},
      }};
      (void)napi_define_properties(env, exports, 1u, props);
      return exports;
    }}

    static napi_module s_cheng_harmony_host_module = {{0}};

    extern "C" __attribute__((constructor)) void ChengHarmonyHostRegisterModule(void) {{
      s_cheng_harmony_host_module.nm_version = 1;
      s_cheng_harmony_host_module.nm_flags = 0;
      s_cheng_harmony_host_module.nm_filename = NULL;
      s_cheng_harmony_host_module.nm_register_func = ChengHarmonyHostNapiInit;
      s_cheng_harmony_host_module.nm_modname = "{harmonyModName}";
      s_cheng_harmony_host_module.nm_priv = NULL;
      napi_module_register(&s_cheng_harmony_host_module);
    }}

