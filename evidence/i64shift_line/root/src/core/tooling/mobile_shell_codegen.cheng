    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_NONE 0
    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE 1
    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_INVALID_BATCH 2
