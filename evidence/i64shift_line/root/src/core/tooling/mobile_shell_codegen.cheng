    }}

    /* The cheng @importc declares (path: str, mode: str); a cheng `str` is passed as TWO args
       (data pointer + length), NOT a null-terminated const char*. Receiving it as (const char*,
       const char*) made `mode` = path.len (e.g. 0x3e for a 62-char cache path) → SIGSEGV. Match
       the str ABI (ptr,len ×2) and rebuild null-terminated C strings. */
    void* cheng_os_fopen_mode_bridge(const char* pathPtr, int32_t pathLen,
                                     const char* modePtr, int32_t modeLen) {{
      if (pathPtr == NULL || pathLen <= 0 || modePtr == NULL || modeLen <= 0) {{
        errno = EINVAL;
        return NULL;
      }}
      if (pathLen >= 4096 || modeLen >= 16) {{
        errno = ENAMETOOLONG;
        return NULL;
      }}
      char pathBuf[4096];
      char modeBuf[16];
      memcpy(pathBuf, pathPtr, (size_t)pathLen);
      pathBuf[pathLen] = '\0';
      memcpy(modeBuf, modePtr, (size_t)modeLen);
      modeBuf[modeLen] = '\0';
      return (void*)fopen(pathBuf, modeBuf);
    }}

    int32_t cheng_fclose(void* stream) {{
      if (stream == NULL) {{
        errno = EINVAL;
        return EOF;
      }}
      return (int32_t)fclose((FILE*)stream);
    }}

    int32_t cheng_fflush(void* stream) {{
      return (int32_t)fflush((FILE*)stream);
    }}

    int32_t cheng_fwrite(void* buf, int64_t size, int64_t n, void* stream) {{
      if (buf == NULL || stream == NULL || size <= 0 || n <= 0) {{
        return 0;
      }}
      if ((uint64_t)size > (uint64_t)SIZE_MAX || (uint64_t)n > (uint64_t)SIZE_MAX) {{
        errno = EINVAL;
        return 0;
      }}
      size_t wrote = fwrite(buf, (size_t)size, (size_t)n, (FILE*)stream);
      if (wrote > 0u) {{
        (void)fflush((FILE*)stream);
      }}
      if (wrote > (size_t)INT32_MAX) {{
        return INT32_MAX;
      }}
      return (int32_t)wrote;
    }}

    int32_t cheng_fwrite_i32(void* buf, int32_t size, int32_t n, void* stream) {{
      return cheng_fwrite(buf, (int64_t)size, (int64_t)n, stream);
    }}

