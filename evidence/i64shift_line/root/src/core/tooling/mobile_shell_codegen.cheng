@borrows
fn MobileShellWriteIosProjectFile(opts: MobileShellOptions,
                                    files: var str[],
                                    outError: var str): bool =
    let rel: str = "ios/ChengGeneratedApp.xcodeproj/project.pbxproj"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    return MobileShellWriteFile(full, MobileShellIosProjectPbxproj(opts), rel, files, outError)

@borrows
fn MobileShellWriteIosWorkspaceFile(opts: MobileShellOptions,
                                      files: var str[],
                                      outError: var str): bool =
    let rel: str = "ios/ChengGeneratedApp.xcodeproj/project.xcworkspace/contents.xcworkspacedata"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    return MobileShellWriteFile(full, MobileShellIosWorkspaceData(), rel, files, outError)

@borrows
fn MobileShellWriteIos(opts: MobileShellOptions,
                         files: var str[],
                         outError: var str): bool =
    if !MobileShellWriteIosInfoPlistFile(opts, files, outError):
        return false
    if !MobileShellWriteIosMainFile(opts, files, outError):
        return false
    if !MobileShellWriteIosAppDelegateHeaderFile(opts, files, outError):
        return false
    if !MobileShellWriteIosAppDelegateImplFile(opts, files, outError):
        return false
    if !MobileShellWriteIosViewControllerHeaderFile(opts, files, outError):
        return false
    if !MobileShellWriteIosViewControllerImplFile(opts, files, outError):
        return false
    if !MobileShellWriteIosProjectFile(opts, files, outError):
        return false
    return MobileShellWriteIosWorkspaceFile(opts, files, outError)

@borrows
fn MobileShellWriteHarmony(opts: MobileShellOptions,
                             files: var str[],
                             outError: var str): bool =
    let buildProfileRel: str = "harmony/build-profile.json5"
    let buildProfileFull: str = chengpath.PathJoin(opts.outDir, buildProfileRel)
    let buildProfileText: str = MobileShellHarmonyBuildProfile()
    if !MobileShellWriteFile(buildProfileFull, buildProfileText, buildProfileRel, files, outError):
        return false
    let hvigorRel: str = "harmony/hvigorfile.ts"
    let hvigorFull: str = chengpath.PathJoin(opts.outDir, hvigorRel)
    let hvigorText: str = MobileShellHarmonyHvigorFile()
    if !MobileShellWriteFile(hvigorFull, hvigorText, hvigorRel, files, outError):
        return false
    let hvigorConfigRel: str = "harmony/hvigor/hvigor-config.json5"
    let hvigorConfigFull: str = chengpath.PathJoin(opts.outDir, hvigorConfigRel)
    let hvigorConfigText: str = MobileShellHarmonyHvigorConfig()
    if !MobileShellWriteFile(hvigorConfigFull, hvigorConfigText, hvigorConfigRel, files, outError):
        return false
    let rootPackageRel: str = "harmony/oh-package.json5"
    let rootPackageFull: str = chengpath.PathJoin(opts.outDir, rootPackageRel)
    let rootPackageText: str = MobileShellHarmonyRootPackageJson()
    if !MobileShellWriteFile(rootPackageFull, rootPackageText, rootPackageRel, files, outError):
        return false
    let entryPackageRel: str = "harmony/entry/oh-package.json5"
    let entryPackageFull: str = chengpath.PathJoin(opts.outDir, entryPackageRel)
    let entryPackageText: str = MobileShellHarmonyEntryPackageJson()
    if !MobileShellWriteFile(entryPackageFull, entryPackageText, entryPackageRel, files, outError):
        return false
    let entryHvigorRel: str = "harmony/entry/hvigorfile.ts"
    let entryHvigorFull: str = chengpath.PathJoin(opts.outDir, entryHvigorRel)
    let entryHvigorText: str = MobileShellHarmonyEntryHvigorFile()
    if !MobileShellWriteFile(entryHvigorFull, entryHvigorText, entryHvigorRel, files, outError):
        return false
    let entryBuildProfileRel: str = "harmony/entry/build-profile.json5"
    let entryBuildProfileFull: str = chengpath.PathJoin(opts.outDir, entryBuildProfileRel)
    let entryBuildProfileText: str = MobileShellHarmonyEntryBuildProfile()
    if !MobileShellWriteFile(entryBuildProfileFull, entryBuildProfileText, entryBuildProfileRel, files, outError):
        return false
    let appScopeRel: str = "harmony/AppScope/app.json5"
    let appScopeFull: str = chengpath.PathJoin(opts.outDir, appScopeRel)
    let appScopeText: str = MobileShellHarmonyAppJson(opts)
    if !MobileShellWriteFile(appScopeFull, appScopeText, appScopeRel, files, outError):
        return false
    let moduleRel: str = "harmony/entry/src/main/module.json5"
    let moduleFull: str = chengpath.PathJoin(opts.outDir, moduleRel)
    let moduleText: str = MobileShellHarmonyModuleJson(opts)
    if !MobileShellWriteFile(moduleFull, moduleText, moduleRel, files, outError):
        return false
    let stringRel: str = "harmony/entry/src/main/resources/base/element/string.json"
    let stringFull: str = chengpath.PathJoin(opts.outDir, stringRel)
    let stringText: str = MobileShellHarmonyStringJson(opts)
    if !MobileShellWriteFile(stringFull, stringText, stringRel, files, outError):
        return false
    let colorRel: str = "harmony/entry/src/main/resources/base/element/color.json"
    let colorFull: str = chengpath.PathJoin(opts.outDir, colorRel)
    let colorText: str = MobileShellHarmonyColorJson()
    if !MobileShellWriteFile(colorFull, colorText, colorRel, files, outError):
        return false
    let appIconRel: str = "harmony/entry/src/main/resources/base/media/app_icon.svg"
    let appIconFull: str = chengpath.PathJoin(opts.outDir, appIconRel)
    let appIconText: str = MobileShellHarmonyAppIconSvg()
    if !MobileShellWriteFile(appIconFull, appIconText, appIconRel, files, outError):
        return false
    let indexRel: str = "harmony/entry/src/main/ets/pages/Index.ets"
    let indexFull: str = chengpath.PathJoin(opts.outDir, indexRel)
    let indexText: str = MobileShellHarmonyIndexEts(opts)
    if !MobileShellWriteFile(indexFull, indexText, indexRel, files, outError):
        return false
    let entryAbilityRel: str = "harmony/entry/src/main/ets/entryability/EntryAbility.ets"
    let entryAbilityFull: str = chengpath.PathJoin(opts.outDir, entryAbilityRel)
    let entryAbilityText: str = MobileShellHarmonyEntryAbilityEts()
    if !MobileShellWriteFile(entryAbilityFull, entryAbilityText, entryAbilityRel, files, outError):
        return false
    let mainPagesRel: str = "harmony/entry/src/main/resources/base/profile/main_pages.json"
    let mainPagesFull: str = chengpath.PathJoin(opts.outDir, mainPagesRel)
    let mainPagesText: str = MobileShellHarmonyMainPagesJson()
    if !MobileShellWriteFile(mainPagesFull, mainPagesText, mainPagesRel, files, outError):
        return false
    # slice-8 wiring (M3 internal "slice 3"): the three-file generator split
    # (MobileShellHarmonyGuiHostGenSource/AdapterSource below, paired with the
    # full MobileShellHarmonyGuiHostCmakeText .so topology here) is gated behind
    # opts.harmonyNativeGuiExperimental -- the same experimental switch slice-1
    # wired into MobileShellValidatePlatformRenderContract. #140 retired the
    # non-experimental branch below from the CLI surface:
    # MobileShellResolveOptions refuses any CLI export that selects harmony
    # without the experimental generator path, so the only remaining callers
    # that can reach the toy MobileShellHarmonyCmake + monolithic
    # MobileShellHarmonyHostSource are library-level test fixtures.
    let cmakeRel: str = "harmony/entry/src/main/cpp/CMakeLists.txt"
    let cmakeFull: str = chengpath.PathJoin(opts.outDir, cmakeRel)
    let cmakeText: str = if opts.harmonyNativeGuiExperimental: MobileShellHarmonyGuiHostCmakeText(opts) else: MobileShellHarmonyCmake(opts)
    if !MobileShellWriteFile(cmakeFull, cmakeText, cmakeRel, files, outError):
        return false
    let adapterContractRel: str = "harmony/entry/src/main/cpp/cheng_gui_host_adapter_contract.h"
    let adapterContractFull: str = chengpath.PathJoin(opts.outDir, adapterContractRel)
    let adapterContractText: str = MobileShellHarmonyAdapterContractText()
    if !MobileShellWriteFile(adapterContractFull, adapterContractText, adapterContractRel, files, outError):
        return false
    # slice-8 first wave: emit the shared header of the gen.c/adapter.c physical
    # split (docs/harmony-host-codegen-migration-plan.md) unconditionally -- it is
    # a pure declarations surface, identical regardless of which branch below is
    # taken, and keeps the census tool's GEN-EQUAL byte-parity gate honest either
    # way.
    let sharedHeaderRel: str = "harmony/entry/src/main/cpp/cheng_gui_host_shared.h"
    let sharedHeaderFull: str = chengpath.PathJoin(opts.outDir, sharedHeaderRel)
    let sharedHeaderText: str = MobileShellHarmonyGuiHostSharedHeaderText()
    if !MobileShellWriteFile(sharedHeaderFull, sharedHeaderText, sharedHeaderRel, files, outError):
        return false
    if opts.harmonyNativeGuiExperimental:
        let genRel: str = "harmony/entry/src/main/cpp/cheng_gui_host_gen.c"
        let genFull: str = chengpath.PathJoin(opts.outDir, genRel)
        let genText: str = MobileShellHarmonyGuiHostGenSource(opts)
        if !MobileShellWriteFile(genFull, genText, genRel, files, outError):
            return false
        let adapterRel: str = "harmony/entry/src/main/cpp/cheng_gui_host_adapter.c"
        let adapterFull: str = chengpath.PathJoin(opts.outDir, adapterRel)
        let adapterText: str = MobileShellHarmonyGuiHostAdapterSource(opts)
        return MobileShellWriteFile(adapterFull, adapterText, adapterRel, files, outError)
    let hostRel: str = Fmt"harmony/entry/src/main/cpp/{MobileShellHarmonyHostFileName(opts)}"
    let hostFull: str = chengpath.PathJoin(opts.outDir, hostRel)
    let hostText: str = MobileShellHarmonyHostSource(opts)
    return MobileShellWriteFile(hostFull, hostText, hostRel, files, outError)

fn MobileShellResolveOptions(rootDir: str,
                               args: str[],
                               outOpts: var MobileShellOptions,
                               outPlatforms: var str[],
                               outError: var str): bool =
    outOpts = MobileShellDefaultOptions(rootDir)
    outPlatforms = []
    outError = ""
    let outRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--out-dir", outOpts.outDir))
    if len(outRaw) > 0:
        outOpts.outDir = chengpath.PathAbsolute(rootDir, outRaw)
    let appIdRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--app-id", outOpts.appId))
    if len(appIdRaw) > 0:
        outOpts.appId = appIdRaw
    let appNameRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--app-name", outOpts.appName))
    if len(appNameRaw) > 0:
        outOpts.appName = appNameRaw
    let libNameRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--lib-name", outOpts.libName))
    if len(libNameRaw) > 0:
        outOpts.libName = libNameRaw
    let runtimeModeRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--runtime-mode", outOpts.runtimeMode))
    if len(runtimeModeRaw) > 0:
        outOpts.runtimeMode = runtimeModeRaw
    let runtimeContractRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--runtime-contract", ""))
    if len(runtimeContractRaw) > 0:
        outOpts.runtimeContractPath = chengpath.PathAbsolute(rootDir, runtimeContractRaw)
    let runtimeBundleRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--runtime-bundle", ""))
    if len(runtimeBundleRaw) > 0:
        outOpts.runtimeBundlePath = chengpath.PathAbsolute(rootDir, runtimeBundleRaw)
    let routeStateRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--route-state", ""))
    if len(routeStateRaw) > 0:
        outOpts.routeState = routeStateRaw
    let androidNativeModeRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-native-mode", outOpts.androidNativeMode))
    if len(androidNativeModeRaw) > 0:
        outOpts.androidNativeMode = androidNativeModeRaw
    if !MobileShellAndroidNativeModeValid(outOpts.androidNativeMode):
        outError = Fmt"mobile-shell: unsupported android native mode: {outOpts.androidNativeMode}"
        return false
    let androidAppLibRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-app-lib", ""))
    if len(androidAppLibRaw) > 0:
        outOpts.androidAppLibPath = chengpath.PathAbsolute(rootDir, androidAppLibRaw)
    let androidHostCcRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-host-cc", ""))
    if len(androidHostCcRaw) > 0:
        outOpts.androidHostCc = chengpath.PathAbsolute(rootDir, androidHostCcRaw)
    let androidHostLdRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-host-ld", ""))
    if len(androidHostLdRaw) > 0:
        outOpts.androidHostLd = chengpath.PathAbsolute(rootDir, androidHostLdRaw)
    let androidNdkRootRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-ndk-root", ""))
    if len(androidNdkRootRaw) > 0:
        outOpts.androidNdkRoot = chengpath.PathAbsolute(rootDir, androidNdkRootRaw)
    let androidJavaHomeRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-java-home", ""))
    if len(androidJavaHomeRaw) > 0:
        outOpts.androidJavaHome = chengpath.PathAbsolute(rootDir, androidJavaHomeRaw)
    let androidClangRtDirRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-clang-rt-dir", ""))
    if len(androidClangRtDirRaw) > 0:
        outOpts.androidClangRtDir = chengpath.PathAbsolute(rootDir, androidClangRtDirRaw)
    let androidApiLevelRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-api-level", outOpts.androidApiLevel))
    if len(androidApiLevelRaw) > 0:
        outOpts.androidApiLevel = androidApiLevelRaw
    var platforms: str[]
    let platformText: str = MobileShellReadFlagOrDefault(args, "--platform", "all")
    if !MobileShellResolvePlatforms(platformText, platforms):
        outError = Fmt"mobile-shell: unsupported platform: {platformText}"
        return false
    outOpts.emitAndroid = false
    outOpts.emitIos = false
    outOpts.emitHarmony = false
    for i in 0..<platforms.len:
        if platforms[i] == "android":
            outOpts.emitAndroid = true
        elif platforms[i] == "ios":
            outOpts.emitIos = true
        elif platforms[i] == "harmony":
            outOpts.emitHarmony = true
    #140 disposition (explicit retirement): the CLI can never set
    # harmonyNativeGuiExperimental, so any CLI export that selects harmony
    # would emit the legacy monolith MobileShellHarmonyHostSource -- a fourth
    # physical copy that permanently lags the destroy-handshake fix family
    # (render thread / destroy epoch / g_window_touch_mutex) which exists only
    # in the three-file host. Refuse loudly instead of silently producing the
    # stale copy. The r2c_native_gui_v1 + harmony combination keeps failing in
    # MobileShellValidatePlatformRenderContract with its own established
    # message, so this gate only covers the modes that could actually emit.
    if outOpts.emitHarmony && !MobileShellRuntimeModeRequiresNativeSceneRenderer(outOpts.runtimeMode):
        outError = "mobile-shell: harmony export is retired (#140): the CLI monolith host (MobileShellHarmonyHostSource) is explicitly deprecated and systematically lags the destroy-handshake fix family; use the checked-in three-file harmony host (platform/harmony/ChengGuiDemo/entry/src/main/cpp/cheng_gui_host_gen.c + cheng_gui_host_adapter.c + CMakeLists.txt, regenerated via the harmonyNativeGuiExperimental generator path); for android/ios-only export pass --platform:android / --platform:ios"
        return false
    if MobileShellRuntimeModeRequiresNativeSceneRenderer(outOpts.runtimeMode):
        if !MobileShellRouteStateValid(outOpts.routeState):
            outError = "mobile-shell: native scene renderer requires non-empty --route-state matching a generated route id"
            return false
    outOpts.rootDir = Fmt"{rootDir}"
    outPlatforms = platforms
    return true

fn MobileShellExportResolved(opts: var MobileShellOptions,
                               outManifestPath: var str,
                               outError: var str): bool =
    outManifestPath = ""
    outError = ""
    if !MobileShellValidatePlatformRenderContract(opts, outError):
        return false
    let exportOutDir: str = Fmt"{opts.outDir}"
    if !MobileShellEnsureDir(exportOutDir):
        outError = Fmt"mobile-shell: failed to create out dir: {exportOutDir}"
        return false
    var files: str[]
    var runtimeContractPayloadRel: str
    var runtimeBundlePayloadRel: str
    var runtimeSemanticNodesRel: str
    var runtimeTruthRootRel: str
    var launchArgsKvRel: str
    var launchArgsJsonRel: str
    let manifestOutDir: str = Fmt"{exportOutDir}"
    let manifestAppId: str = Fmt"{opts.appId}"
    let manifestAppName: str = Fmt"{opts.appName}"
    let manifestLibName: str = Fmt"{opts.libName}"
    let manifestRuntimeMode: str = Fmt"{opts.runtimeMode}"
    let manifestRouteState: str = Fmt"{opts.routeState}"
    let manifestEmitAndroid: bool = opts.emitAndroid
    let manifestEmitIos: bool = opts.emitIos
    let manifestEmitHarmony: bool = opts.emitHarmony
    let manifestAndroidNativeMode: str = Fmt"{opts.androidNativeMode}"
    let runtimeManifestRel: str = MobileShellRuntimeManifestRelPath()
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWriteRuntimePayloadFile(opts,
                                             opts.runtimeContractPath,
                                             "runtime_contract_payload.json",
                                             files,
                                             runtimeContractPayloadRel,
                                             outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWriteRuntimePayloadFile(opts,
                                             opts.runtimeBundlePath,
                                             "runtime_bundle_payload.json",
                                             files,
                                             runtimeBundlePayloadRel,
                                             outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWriteOptionalRuntimeResources(opts,
                                                   files,
                                                   runtimeSemanticNodesRel,
                                                   runtimeTruthRootRel,
                                                   outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    let readmePath = chengpath.PathJoin(exportOutDir, "README.md")
    if !MobileShellWriteLaunchArgsFiles(exportOutDir,
                                          manifestRouteState,
                                          manifestRuntimeMode,
                                          runtimeManifestRel,
                                          runtimeContractPayloadRel,
                                          runtimeBundlePayloadRel,
                                          files,
                                          launchArgsKvRel,
                                          launchArgsJsonRel,
                                          outError):
        return false
    if !MobileShellWriteFile(readmePath,
                               MobileShellReadme(opts,
                                                   runtimeManifestRel,
                                                   runtimeContractPayloadRel,
                                                   runtimeBundlePayloadRel,
                                                   runtimeSemanticNodesRel,
                                                   runtimeTruthRootRel,
                                                   launchArgsKvRel,
                                                   launchArgsJsonRel),
                               "README.md",
                               files,
                               outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    let runtimeManifestPath: str = chengpath.PathJoin(exportOutDir, runtimeManifestRel)
    if !MobileShellWriteFile(runtimeManifestPath,
                               MobileShellRuntimeManifest(opts,
                                                            runtimeContractPayloadRel,
                                                            runtimeBundlePayloadRel,
                                                            runtimeSemanticNodesRel,
                                                            runtimeTruthRootRel,
                                                            launchArgsKvRel,
                                                            launchArgsJsonRel),
                               runtimeManifestRel,
                               files,
                               outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    let manifestRel = "mobile_shell_manifest_v1.json"
    let manifestPath = chengpath.PathJoin(exportOutDir, manifestRel)
    let manifestGeneratedFileCount: int32 = files.len + MobileShellExpectedPlatformSourceFileCount(manifestEmitAndroid,
                                                                                                    manifestEmitIos,
                                                                                                    manifestEmitHarmony,
                                                                                                    manifestAndroidNativeMode)
    if !MobileShellWriteFile(manifestPath,
                               MobileShellManifestValues(manifestOutDir,
                                                         manifestAppId,
                                                         manifestAppName,
                                                         manifestLibName,
                                                         manifestRuntimeMode,
                                                         manifestRouteState,
                                                         manifestEmitAndroid,
                                                         manifestEmitIos,
                                                         manifestEmitHarmony,
                                                         runtimeManifestRel,
                                                         runtimeContractPayloadRel,
                                                         runtimeBundlePayloadRel,
                                                         runtimeSemanticNodesRel,
                                                         runtimeTruthRootRel,
                                                         launchArgsKvRel,
                                                         launchArgsJsonRel,
                                                         manifestGeneratedFileCount),
                               manifestRel,
                               files,
                               outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWritePlatformRuntimeMirrors(opts,
                                                 runtimeManifestPath,
                                                 runtimeContractPayloadRel,
                                                 runtimeBundlePayloadRel,
                                                 runtimeSemanticNodesRel,
                                                 runtimeTruthRootRel,
                                                 launchArgsKvRel,
                                                 launchArgsJsonRel,
                                                 files,
                                                 outError):
        return false
    if manifestEmitAndroid:
        opts.outDir = Fmt"{exportOutDir}"
        opts.appId = Fmt"{manifestAppId}"
        opts.appName = Fmt"{manifestAppName}"
        opts.libName = Fmt"{manifestLibName}"
        opts.runtimeMode = Fmt"{manifestRuntimeMode}"
        opts.routeState = Fmt"{manifestRouteState}"
        opts.androidNativeMode = Fmt"{manifestAndroidNativeMode}"
        opts.emitAndroid = manifestEmitAndroid
        opts.emitIos = manifestEmitIos
        opts.emitHarmony = manifestEmitHarmony
        if !MobileShellWriteAndroid(opts, files, outError):
            return false
    if manifestEmitIos:
        opts.outDir = Fmt"{exportOutDir}"
        opts.appId = Fmt"{manifestAppId}"
        opts.appName = Fmt"{manifestAppName}"
        opts.libName = Fmt"{manifestLibName}"
        opts.runtimeMode = Fmt"{manifestRuntimeMode}"
        opts.routeState = Fmt"{manifestRouteState}"
        opts.androidNativeMode = Fmt"{manifestAndroidNativeMode}"
        opts.emitAndroid = manifestEmitAndroid
        opts.emitIos = manifestEmitIos
        opts.emitHarmony = manifestEmitHarmony
        if !MobileShellWriteIos(opts, files, outError):
            return false
    if manifestEmitHarmony:
        opts.outDir = Fmt"{exportOutDir}"
        opts.appId = Fmt"{manifestAppId}"
        opts.appName = Fmt"{manifestAppName}"
        opts.libName = Fmt"{manifestLibName}"
        opts.runtimeMode = Fmt"{manifestRuntimeMode}"
        opts.routeState = Fmt"{manifestRouteState}"
        opts.androidNativeMode = Fmt"{manifestAndroidNativeMode}"
        opts.emitAndroid = manifestEmitAndroid
        opts.emitIos = manifestEmitIos
        opts.emitHarmony = manifestEmitHarmony
        if !MobileShellWriteHarmony(opts, files, outError):
            return false
    outManifestPath = manifestPath
    return true

fn MobileShellExport(rootDir: str,
                       args: str[],
                       outOutput: var str,
                       outError: var str): int32 =
    outOutput = ""
    outError = ""
    var opts: MobileShellOptions
    var platforms: str[]
    if !MobileShellResolveOptions(rootDir, args, opts, platforms, outError):
        return 1
    var manifestPath: str
    if !MobileShellExportResolved(opts, manifestPath, outError):
        return 1
    outOutput = "mobile-shell export ok\n"
    return 0

fn MobileShellBuildProbe(rootDir: str,
                           args: str[],
                           outOutput: var str,
                           outError: var str): int32 =
    outOutput = ""
    outError = ""
    var opts: MobileShellOptions
    var platforms: str[]
    if !MobileShellResolveOptions(rootDir, args, opts, platforms, outError):
        return 1
    let buildOutDir: str = Fmt"{opts.outDir}"
    let buildAndroidNativeMode: str = MobileShellAndroidNativeModeText(opts.androidNativeMode)
    let androidPrebuiltConfig: MobileShellAndroidPrebuiltConfig = MobileShellAndroidPrebuiltConfigFromOptions(opts)
    var manifestPath: str
    if !MobileShellExportResolved(opts, manifestPath, outError):
        return 1
    let runtimeManifestPath: str = chengpath.PathJoin(buildOutDir, MobileShellRuntimeManifestRelPath())
    let runtimeContractPayloadRel: str = MobileShellRuntimeContractPayloadRelPath()
    let runtimeBundlePayloadRel: str = MobileShellRuntimeBundlePayloadRelPath()
    let summaryPath: str = chengpath.PathJoin(buildOutDir, "mobile_shell_build_probe.summary.env")
    let androidLog: str = chengpath.PathJoin(buildOutDir, "android_build.log")
    let androidPrebuiltCopyLog: str = chengpath.PathJoin(buildOutDir, "android_prebuilt_copy.log")
    let androidPrebuiltCompileLog: str = chengpath.PathJoin(buildOutDir, "android_prebuilt_host_compile.log")
    let androidPrebuiltLinkLog: str = chengpath.PathJoin(buildOutDir, "android_prebuilt_host_link.log")
    let androidPrebuiltScript: str = chengpath.PathJoin(buildOutDir, "android_prebuilt_build.sh")
    let iosLog: str = chengpath.PathJoin(buildOutDir, "ios_build.log")
    let harmonyLog: str = chengpath.PathJoin(buildOutDir, "harmony_build.log")
    let androidApk: str = chengpath.PathJoin(buildOutDir, "android/app/build/outputs/apk/debug/app-debug.apk")
    let iosApp: str = chengpath.PathJoin(buildOutDir, "ios/.derived_data/Build/Products/Debug-iphonesimulator/ChengGeneratedApp.app/ChengGeneratedApp")
    let harmonyApp: str = chengpath.PathJoin(buildOutDir, "harmony/build/outputs/default/harmony-default-unsigned.app")
    let harmonyHap: str = chengpath.PathJoin(buildOutDir, "harmony/entry/build/default/outputs/default/app/entry-default.hap")
    let harmonyHvigorPath: str = "/Applications/DevEco-Studio.app/Contents/tools/hvigor/bin/hvigorw.js"
    var androidSelected: bool
    var iosSelected: bool
    var harmonySelected: bool
    var androidExitCode: int32 = -1
    var iosExitCode: int32 = -1
    var harmonyExitCode: int32 = -1
    for i in 0..<platforms.len:
        let platform: str = platforms[i]
        if platform == "android":
            androidSelected = true
            let command: str = MobileShellBuildCommand("gradle",
                                                         [
                                                             "-p",
                                                             chengpath.PathJoin(buildOutDir, "android"),
                                                             ":app:assembleDebug"
                                                         ])
            var androidCommand: str = command
            if buildAndroidNativeMode == "prebuilt":
                let _androidPrebuiltCopyLog: str = androidPrebuiltCopyLog
                let _androidPrebuiltCompileLog: str = androidPrebuiltCompileLog
                let _androidPrebuiltLinkLog: str = androidPrebuiltLinkLog
                var nativeCommand: str
                if !MobileShellAndroidPrebuiltCommand(androidPrebuiltConfig,
                                                       nativeCommand,
                                                       outError):
                    return 1
                var scriptError: str
                if !MobileShellWriteAndroidPrebuiltBuildScript(androidPrebuiltScript,
                                                                nativeCommand,
                                                                command,
                                                                scriptError):
                    outError = scriptError
                    return 1
            var run: os.ExecCmdResult
            if buildAndroidNativeMode == "prebuilt":
                var scriptArgs: str[]
                add(scriptArgs, androidPrebuiltScript)
                run = MobileShellRunProgramLogged("/bin/sh", scriptArgs, strings.CloneStr(rootDir), strings.CloneStr(androidLog))
            else:
                run = MobileShellRunCommandLogged(androidCommand, rootDir, androidLog)
            androidExitCode = os.ExecCmdResultExitCode(run)
            if androidExitCode != 0:
                return MobileShellBuildProbeFail(summaryPath,
                                                   Fmt"mobile-shell: android build failed rc={IntToStr(androidExitCode)} log={androidLog}",
                                                   outError)
            if !os.FileExists(androidApk):
                return MobileShellBuildProbeFail(summaryPath,
                                                   Fmt"mobile-shell: android artifact missing: {androidApk}",
                                                   outError)
        elif platform == "ios":
            iosSelected = true
            let command: str = MobileShellBuildCommand("xcodebuild",
                                                         [
                                                             "-project",
                                                             chengpath.PathJoin(buildOutDir, "ios/ChengGeneratedApp.xcodeproj"),
                                                             "-scheme",
                                                             "ChengGeneratedApp",
                                                             "-configuration",
                                                             "Debug",
                                                             "-sdk",
                                                             "iphonesimulator",
                                                             "-derivedDataPath",
                                                             chengpath.PathJoin(buildOutDir, "ios/.derived_data"),
                                                             "CODE_SIGNING_ALLOWED=NO",
                                                             "build"
                                                         ])
            let run: os.ExecCmdResult = MobileShellRunCommandLogged(command, rootDir, iosLog)
            iosExitCode = os.ExecCmdResultExitCode(run)
            if iosExitCode != 0:
                return MobileShellBuildProbeFail(summaryPath,
                                                   Fmt"mobile-shell: ios build failed rc={IntToStr(iosExitCode)} log={iosLog}",
                                                   outError)
            if !os.FileExists(iosApp):
                return MobileShellBuildProbeFail(summaryPath,
                                                   Fmt"mobile-shell: ios artifact missing: {iosApp}",
                                                   outError)
        elif platform == "harmony":
            harmonySelected = true
            let command: str = MobileShellBuildCommand("node",
                                                         [
                                                             harmonyHvigorPath,
                                                             "assembleApp",
                                                             "-p",
                                                             "product=default",
                                                             "-p",
                                                             "buildMode=debug",
                                                             "--no-daemon"
                                                         ])
            let run: os.ExecCmdResult = MobileShellRunCommandLogged(command,
                                                                      chengpath.PathJoin(buildOutDir, "harmony"),
                                                                      harmonyLog)
            harmonyExitCode = os.ExecCmdResultExitCode(run)
            if harmonyExitCode != 0:
                return MobileShellBuildProbeFail(summaryPath,
                                                   Fmt"mobile-shell: harmony build failed rc={IntToStr(harmonyExitCode)} log={harmonyLog}",
                                                   outError)
            if !os.FileExists(harmonyApp):
                return MobileShellBuildProbeFail(summaryPath,
                                                   Fmt"mobile-shell: harmony app artifact missing: {harmonyApp}",
                                                   outError)
            if !os.FileExists(harmonyHap):
                return MobileShellBuildProbeFail(summaryPath,
                                                   Fmt"mobile-shell: harmony hap artifact missing: {harmonyHap}",
                                                   outError)
    if !MobileShellWriteBuildProbeSummary(summaryPath,
                                            androidSelected,
                                            iosSelected,
                                            harmonySelected,
                                            opts.runtimeMode):
        outError = Fmt"mobile-shell: failed to write summary: {summaryPath}"
        return 1
    outOutput = "mobile-shell build-probe ok\n"
    return 0

fn MobileShellRun(rootDir: str,
                    args: str[],
                    outOutput: var str,
                    outError: var str): int32 =
    outOutput = ""
    outError = ""
    if args.len <= 0:
        outOutput = MobileShellHelpText()
        return 0
    let subcmd: str = strutil.Strip(args[0])
    if subcmd == "help":
        outOutput = MobileShellHelpText()
        return 0
    if subcmd == "--help":
        outOutput = MobileShellHelpText()
        return 0
    if subcmd == "-h":
        outOutput = MobileShellHelpText()
        return 0
    var tail: str[]
    if args.len > 1:
        setLen(tail, args.len - 1)
        for i in 1..<args.len:
            tail[i - 1] = args[i]
    if subcmd == "export":
        return MobileShellExport(rootDir, tail, outOutput, outError)
    if subcmd == "build-probe":
        return MobileShellBuildProbe(rootDir, tail, outOutput, outError)
    outOutput = MobileShellHelpText()
    outError = Fmt"mobile-shell: unknown subcommand: {subcmd}"
    return 2
