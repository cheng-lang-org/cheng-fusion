    static int cheng_android_set_asset_manager(JNIEnv* env, jobject assetManager) {{
      if (env == NULL || assetManager == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "asset manager missing");
        return 0;
      }}
      AAssetManager* nativeManager = AAssetManager_fromJava(env, assetManager);
      if (nativeManager == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "AAssetManager_fromJava failed");
        return 0;
      }}
      jobject globalRef = (*env)->NewGlobalRef(env, assetManager);
      if (globalRef == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "AssetManager global ref failed");
        return 0;
      }}
      if (s_asset_manager_ref != NULL) {{
        (*env)->DeleteGlobalRef(env, s_asset_manager_ref);
      }}
      s_asset_manager_ref = globalRef;
      s_asset_manager = nativeManager;
      return 1;
    }}

    static void cheng_android_clear_asset_manager(JNIEnv* env) {{
      if (env != NULL && s_asset_manager_ref != NULL) {{
        (*env)->DeleteGlobalRef(env, s_asset_manager_ref);
      }}
      s_asset_manager_ref = NULL;
      s_asset_manager = NULL;
    }}

    static int cheng_android_set_activity_ref(JNIEnv* env, jobject activity) {{
      if (env == NULL || activity == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "activity ref missing");
        return 0;
      }}
      jobject globalRef = (*env)->NewGlobalRef(env, activity);
      if (globalRef == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "Activity global ref failed");
        return 0;
      }}
      if (s_activity_ref != NULL) {{
        (*env)->DeleteGlobalRef(env, s_activity_ref);
      }}
      s_activity_ref = globalRef;
      return 1;
    }}

    static void cheng_android_clear_activity_ref(JNIEnv* env) {{
      if (env != NULL && s_activity_ref != NULL) {{
        (*env)->DeleteGlobalRef(env, s_activity_ref);
      }}
      s_activity_ref = NULL;
    }}

    static uint32_t cheng_android_crc32_u8(const uint8_t* data, int byteCount) {{
      uint32_t crc = 0xffffffffu;
      for (int i = 0; i < byteCount; i++) {{
        crc ^= (uint32_t)data[i];
        for (int bit = 0; bit < 8; bit++) {{
          uint32_t mask = 0u - (crc & 1u);
          crc = (crc >> 1u) ^ (0xedb88320u & mask);
        }}
      }}
      return crc ^ 0xffffffffu;
    }}

    static int cheng_android_headless_asset_path(const char* rel, char* out, size_t out_cap) {{
      const char* dir = getenv("CHENG_HEADLESS_ASSET_DIR");
      if (dir == NULL || dir[0] == '\0' || rel == NULL || rel[0] == '\0' || out == NULL || out_cap == 0u) {{
        return 0;
      }}
      int n = snprintf(out, out_cap, "%s/%s", dir, rel);
      return n > 0 && n < (int)out_cap;
    }}

    static int cheng_android_open_headless_asset_fd(const char* rel, off64_t* out_length) {{
      char path[4096];
      if (!cheng_android_headless_asset_path(rel, path, sizeof(path)) || out_length == NULL) {{
        return -1;
      }}
      int fd = open(path, O_RDONLY);
      if (fd < 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "headless asset open failed rel=%s path=%s errno=%d",
                            rel, path, errno);
        return -1;
      }}
      off_t length = lseek(fd, 0, SEEK_END);
      if (length <= 0 || lseek(fd, 0, SEEK_SET) != 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "headless asset length failed rel=%s path=%s errno=%d",
                            rel, path, errno);
        close(fd);
        return -1;
      }}
      *out_length = (off64_t)length;
      return fd;
    }}

    // Headless asset fallback: when there is no AAssetManager (standalone capture exe,
    // not an Activity), read the asset from $CHENG_HEADLESS_ASSET_DIR/<rel> on disk.
    static int32_t cheng_android_read_asset_file_fallback(const char* rel, void* out, int32_t byteCount, int32_t expectedCrc32) {{
      if (out == NULL || byteCount <= 0) {{
        return 2;
      }}
      char path[4096];
      if (!cheng_android_headless_asset_path(rel, path, sizeof(path))) {{
        return 2;
      }}
      FILE* f = fopen(path, "rb");
      if (f == NULL) {{
        return 3;
      }}
      size_t total = 0;
      unsigned char* dst = (unsigned char*)out;
      while (total < (size_t)byteCount) {{
        size_t n = fread(dst + total, 1u, (size_t)byteCount - total, f);
        if (n == 0) {{ fclose(f); return 4; }}
        total += n;
      }}
      unsigned char probe;
      if (fread(&probe, 1u, 1u, f) != 0) {{ fclose(f); return 5; }}
      fclose(f);
      uint32_t actualCrc32 = cheng_android_crc32_u8(dst, byteCount);
      if (actualCrc32 != (uint32_t)expectedCrc32) {{ return 6; }}
      return 0;
    }}

    int32_t cheng_mobile_host_read_glyph_sdf_pixel_asset(void* out, int32_t byteCount, int32_t expectedCrc32) {{
      if (out == NULL || byteCount <= 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "glyph asset read invalid args out=%p byteCount=%d",
                            out, byteCount);
        return 1;
      }}
      if (s_asset_manager == NULL) {{
        if (getenv("CHENG_HEADLESS_ASSET_DIR") != NULL) {{
          return cheng_android_read_asset_file_fallback(kChengGlyphSdfPixelAssetRel, out, byteCount, expectedCrc32);
        }}
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "glyph asset read without asset manager");
        return 2;
      }}
      AAsset* asset = AAssetManager_open(s_asset_manager, kChengGlyphSdfPixelAssetRel, AASSET_MODE_BUFFER);
      if (asset == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "glyph asset missing rel=%s",
                            kChengGlyphSdfPixelAssetRel);
        return 3;
      }}
      off_t length = AAsset_getLength(asset);
      if (length != (off_t)byteCount) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "glyph asset length mismatch rel=%s actual=%lld expected=%d",
                            kChengGlyphSdfPixelAssetRel, (long long)length, byteCount);
        AAsset_close(asset);
        return 4;
      }}
      uint8_t* dst = (uint8_t*)out;
      int readTotal = 0;
      while (readTotal < byteCount) {{
        int n = AAsset_read(asset, dst + readTotal, (size_t)(byteCount - readTotal));
        if (n <= 0) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                              "glyph asset short read rel=%s read=%d expected=%d",
                              kChengGlyphSdfPixelAssetRel, readTotal, byteCount);
          AAsset_close(asset);
          return 5;
        }}
        readTotal += n;
      }}
      AAsset_close(asset);
      uint32_t actualCrc32 = cheng_android_crc32_u8(dst, byteCount);
      uint32_t expected = (uint32_t)expectedCrc32;
      if (actualCrc32 != expected) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "glyph asset crc mismatch rel=%s actual=%08x expected=%08x",
                            kChengGlyphSdfPixelAssetRel, actualCrc32, expected);
        return 6;
      }}
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "glyph asset read ok rel=%s bytes=%d crc32=%08x",
                          kChengGlyphSdfPixelAssetRel, byteCount, actualCrc32);
      return 0;
    }}

    void cheng_mobile_host_trace_step(int32_t step) {{
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "app_trace step=%d", (int)step);
      if (step == 975001 && s_touch_trace_pending_present && cheng_android_touch_trace_enabled()) {{
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "tap_trace t1");
      }}
    }}

    int32_t cheng_mobile_host_read_scene_data_asset(void* out, int32_t byteCount, int32_t expectedCrc32) {{
      if (out == NULL || byteCount <= 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "scene data asset read invalid args out=%p byteCount=%d",
                            out, byteCount);
        return 1;
      }}
      if (s_asset_manager == NULL) {{
        if (getenv("CHENG_HEADLESS_ASSET_DIR") != NULL) {{
          return cheng_android_read_asset_file_fallback(kChengSceneDataAssetRel, out, byteCount, expectedCrc32);
        }}
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "scene data asset read without asset manager");
        return 2;
      }}
      AAsset* asset = AAssetManager_open(s_asset_manager, kChengSceneDataAssetRel, AASSET_MODE_BUFFER);
      if (asset == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "scene data asset missing rel=%s",
                            kChengSceneDataAssetRel);
        return 3;
      }}
      off_t length = AAsset_getLength(asset);
      if (length != (off_t)byteCount) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "scene data asset length mismatch rel=%s actual=%lld expected=%d",
                            kChengSceneDataAssetRel, (long long)length, byteCount);
        AAsset_close(asset);
        return 4;
      }}
      uint8_t* dst = (uint8_t*)out;
      int readTotal = 0;
      while (readTotal < byteCount) {{
        int n = AAsset_read(asset, dst + readTotal, (size_t)(byteCount - readTotal));
        if (n <= 0) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                              "scene data asset short read rel=%s read=%d expected=%d",
                              kChengSceneDataAssetRel, readTotal, byteCount);
          AAsset_close(asset);
          return 5;
        }}
        readTotal += n;
      }}
      AAsset_close(asset);
      uint32_t actualCrc32 = cheng_android_crc32_u8(dst, byteCount);
      uint32_t expected = (uint32_t)expectedCrc32;
      if (actualCrc32 != expected) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "scene data asset crc mismatch rel=%s actual=%08x expected=%08x",
                            kChengSceneDataAssetRel, actualCrc32, expected);
        return 6;
      }}
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "scene data asset read ok rel=%s bytes=%d crc32=%08x",
                          kChengSceneDataAssetRel, byteCount, actualCrc32);
      return 0;
    }}

    static uint64_t cheng_android_register_window(ANativeWindow* window) {{
      if (window == NULL) {{
        return 0u;
      }}
      for (int i = 0; i < CHENG_ANDROID_WINDOW_SLOT_CAP; i++) {{
        if (s_window_slots[i].window == window && s_window_slots[i].id != 0u) {{
          return s_window_slots[i].id;
        }}
      }}
      for (int i = 0; i < CHENG_ANDROID_WINDOW_SLOT_CAP; i++) {{
        if (s_window_slots[i].id == 0u) {{
          uint64_t id = s_next_window_id++;
          if (id == 0u) {{
            id = s_next_window_id++;
          }}
          s_window_slots[i].id = id;
          s_window_slots[i].window = window;
          return id;
        }}
      }}
      return 0u;
    }}

    static void cheng_android_unregister_window(uint64_t id) {{
      if (id == 0u) {{
        return;
      }}
      for (int i = 0; i < CHENG_ANDROID_WINDOW_SLOT_CAP; i++) {{
        if (s_window_slots[i].id == id) {{
          if (s_active_window == s_window_slots[i].window) {{
            s_active_window = NULL;
            s_active_width = 0;
            s_active_height = 0;
            s_active_density = 1.0f;
          }}
          s_window_slots[i].id = 0u;
          s_window_slots[i].window = NULL;
          return;
        }}
      }}
    }}

    static int cheng_android_surface_dimension(int preferred, int measured) {{
      if (preferred > 0) {{
        return preferred;
      }}
      return measured > 0 ? measured : 0;
    }}

    static int cheng_android_surface_css_px(int physical, float density) {{
      if (physical <= 0) {{
        return 0;
      }}
      if (density <= 0.0f) {{
        return physical;
      }}
      int logical = (int)(((float)physical / density) + 0.5f);
      return logical > 0 ? logical : 1;
    }}

    static int cheng_resolve_exports(void) {{
      if (s_app_init != NULL) {{
        return 1;
      }}
      char lib_path[256];
      snprintf(lib_path, sizeof(lib_path), "lib%s.so", CHENG_APP_LIB_NAME);
      s_app_handle = dlopen(lib_path, RTLD_NOW | RTLD_GLOBAL);
      if (s_app_handle == NULL) {{
        cheng_log(dlerror());
        return 0;
      }}
      s_app_init = (cheng_app_init_fn)cheng_resolve_required_app_export("cheng_app_init");
      s_app_set_window = (cheng_app_set_window_fn)cheng_resolve_required_app_export("cheng_app_set_window");
      s_app_tick = (cheng_app_tick_fn)cheng_resolve_required_app_export("cheng_app_tick");
      s_app_needs_frame = (cheng_app_needs_frame_fn)cheng_resolve_required_app_export("cheng_app_needs_frame");
      s_app_on_touch_milli = (cheng_app_on_touch_milli_fn)cheng_resolve_required_app_export("cheng_app_on_touch_milli");
      s_app_pause = (cheng_app_pause_fn)cheng_resolve_required_app_export("cheng_app_pause");
      s_app_resume = (cheng_app_resume_fn)cheng_resolve_required_app_export("cheng_app_resume");
      if (!(s_app_init && s_app_set_window && s_app_tick && s_app_needs_frame && s_app_on_touch_milli && s_app_pause && s_app_resume)) {{
        return 0;
      }}
	      s_app_text_input_utf8 = (cheng_app_text_input_utf8_fn)cheng_resolve_required_app_export("cheng_app_text_input_utf8");
	      s_app_text_input_cursor_utf8 = (cheng_app_text_input_cursor_utf8_fn)cheng_resolve_required_app_export("cheng_app_text_input_cursor_utf8");
		      s_app_clear_text_input_focus = (cheng_app_clear_text_input_focus_fn)cheng_resolve_required_app_export("cheng_app_clear_text_input_focus");
	      s_app_on_back = (cheng_app_on_back_fn)cheng_resolve_required_app_export("cheng_app_on_back");
	      if (!(s_app_text_input_utf8 && s_app_text_input_cursor_utf8 && s_app_clear_text_input_focus && s_app_on_back)) {{
	        return 0;
	      }}
	      s_app_scroll_by = (cheng_app_scroll_by_fn)dlsym(s_app_handle, "cheng_app_scroll_by");
	      s_app_scroll_get = (cheng_app_scroll_get_fn)dlsym(s_app_handle, "cheng_app_scroll_get");
	      s_app_computer_use_compile_text_utf8 = (cheng_app_computer_use_compile_text_utf8_fn)dlsym(s_app_handle, "cheng_app_computer_use_compile_text_utf8");
