	    }} ChengAndroidImageTextureCache;

    typedef struct ChengAndroidLocalAudioPlayback {{
      int valid;
      AMediaExtractor* extractor;
      AMediaCodec* codec;
      AAudioStream* stream;
      int decoder_started;
      int stream_started;
      int input_done;
      int output_done;
      int sample_rate;
      int channels;
      int pcm_cap_samples;
      int16_t* pcm;
      int pcm_head;
      int pcm_tail;
      int pcm_size;
      int pcm_mutex_inited;
      pthread_mutex_t pcm_mu;
      volatile int64_t frames_played;
      int64_t last_presentation_us;
      int last_playback_state;
      int decoded_frames;
      int underrun_frames;
      int pcm_peak;
      int callback_peak;
      int64_t decoded_nonzero_samples;
      int64_t callback_nonzero_samples;
    }} ChengAndroidLocalAudioPlayback;

    typedef struct ChengAndroidMediaTextureCache {{
      int valid;
      int kind_code;
      int surface_kind;
      int texture_provider;
      int slot_hash;
      int asset_hash;
      int manifest_hash;
      int poster_hash;
      int width;
      int height;
      int pixel_format;
      int texture_target;
      GLuint gl_texture;
      GLuint poster_gl_texture;
      int poster_width;
      int poster_height;
      float texture_transform[16];
      int texture_transform_valid;
      int rotation_degrees;
      jobject surface_texture;
      jobject surface;
      ANativeWindow* decode_window;
      AMediaExtractor* extractor;
      AMediaCodec* codec;
      int decoder_started;
      int input_done;
      int output_done;
      int frame_count;
      int update_count;
      int64_t last_presentation_us;
      int64_t playback_anchor_us;
      int last_playback_state;
      int es_mode;            /* 1 = progressive ES streaming decoder (no extractor); 0 = whole-file extractor path */
      ChengAndroidLocalAudioPlayback audio;
      char asset_rel[160];
    }} ChengAndroidMediaTextureCache;

    /* Progressive ES (elementary-stream) direct-feed streaming context. One per app
       (only one video card is the cross-device peer). Mirrors the Harmony host's
       ChengStreamCtx input-FIFO design (cheng_gui_host.c): a producer pushes Annex-B
       access units into a ring (with full-FIFO backpressure), the render-thread decoder
       pump drains them straight into AMediaCodec — no AMediaExtractor / container parse.
       秒开: es_open learns w/h/fps the moment the announce + index land (kilobytes), so
       the decoder configures and the first IDR decodes long before the whole file would
       have downloaded. */
    #define CHENG_ANDROID_ES_FQ_CAP 128
    #define CHENG_ANDROID_ES_MAXFRAME 262144
    typedef struct ChengAndroidEsStreamCtx {{
      pthread_mutex_t fq_mu;
      pthread_cond_t cv_notfull_fq;   /* input FIFO not-full (producer backpressure) */
      unsigned char* fq[CHENG_ANDROID_ES_FQ_CAP];
      int32_t fq_len[CHENG_ANDROID_ES_FQ_CAP];
      int64_t fq_pts[CHENG_ANDROID_ES_FQ_CAP];
      int fq_key[CHENG_ANDROID_ES_FQ_CAP];
      int fq_head, fq_tail, fq_size;
      double fps;
      int frame_count;
      int next_frame_idx;             /* plan-B render-thread prefetch cursor */
      int64_t pts_seq;                /* monotonic across loop wraps so the decoder never reorders */
      volatile int end_of_stream;
      volatile int stop;
      volatile int producer_started;  /* plan-A fetch worker spawned */
      volatile int sink_total;        /* access units pushed (probe signal: >0 ⇒ producer drives QUIC) */
    }} ChengAndroidEsStreamCtx;

    static ChengAndroidEsStreamCtx s_es_ctx;
    static volatile int s_es_ctx_inited = 0;
    static volatile int s_es_open_done = 0;     /* es_open completed (1 ok, -1 failed) */
    static volatile int s_es_open_result = 0;
    static int s_es_vw = 0, s_es_vh = 0, s_es_fps = 0, s_es_fc = 0;
    static volatile int s_es_engaged = 0;       /* an ES streaming decoder is live → render thread feeds it */
    /* ES app exports resolved via dlsym on s_app_handle (Android host->app edges must NOT be
       undefined dynamic imports — only dlopen/dlsym, same as s_fetch_remote_announced_to_file). */
    typedef int32_t (*cheng_es_open_fn)(const char* host, int32_t port);
    typedef int32_t (*cheng_es_int_fn)(void);
    typedef int32_t (*cheng_es_fetch_frame_fn)(int32_t frameIdx, void* outBuf, int32_t outCap);
    typedef int32_t (*cheng_es_str_int_fn)(const char* s);
    typedef int32_t (*cheng_es_prefetch_tick_fn)(int32_t aheadGops);
    static cheng_es_open_fn s_es_open = NULL;
    static cheng_es_int_fn s_es_width = NULL;
    static cheng_es_int_fn s_es_height = NULL;
    static cheng_es_int_fn s_es_fps_fn = NULL;
    static cheng_es_int_fn s_es_frame_count = NULL;
    static cheng_es_int_fn s_es_stream_loop = NULL;
    static cheng_es_fetch_frame_fn s_es_fetch_frame = NULL;
    static cheng_es_int_fn s_es_rotation_fn = NULL;   /* required current-index display rotation */
    static int s_es_rotation = 0;                       /* normalized display rotation applied to the ES texture */
    /* Content-addressing check for the 秒开 prefetch primitive (see cheng_android_es_arm_prefetch):
       optional exports (dlsym, tolerate NULL) so a scene .so without them degrades to "cannot
       verify" rather than a hard failure. */
    static cheng_es_str_int_fn s_es_content_matches_fn = NULL;
    static cheng_es_int_fn s_es_invalidate_fn = NULL;
    /* S5 background prefetch (video-seek-scrub-blueprint.md §S5, WebSceneMediaEsPrefetchTick):
       optional export, same fail-open precedent as s_es_content_matches_fn — a
       older scene .so without it simply never gets background prefetch (no crash, no behavior
       change on the foreground fetch/decode path). */
    static cheng_es_prefetch_tick_fn s_es_prefetch_tick_fn = NULL;
    /* S3b ES seek (video-seek-scrub-blueprint.md §S3b): resolves the bridge's
       WebSceneMediaEsSeekToPositionMs (cheng_scene_media_es_seek_to_position_ms), mirroring the
       Harmony fetch thread's es_seek_to_position_ms_fn (cheng_gui_host_gen.c). Optional export,
       same fail-open precedent as s_es_prefetch_tick_fn above. */
    typedef int32_t (*cheng_es_int_int_fn)(int32_t positionMs);
    static cheng_es_int_int_fn s_es_seek_to_position_ms_fn = NULL;
    /* S7 audio ES seek-sync (video-seek-scrub-blueprint.md §7.1 选项 A): read back the video ES
       pump cursor's keyframe-snapped frame index right after a position-ms seek — the host has
       no other way to learn which frame the ms-seek actually landed on (WebSceneMediaEsSeekToFrame
       snaps internally) — so the audio ES pump can be repositioned to the SAME frame-aligned AU
       via s_aes_seek_to_video_frame_fn below. Reuses WebSceneMediaEsPumpCursor, an existing
       zero-argument getter export (same ABI shape as s_es_rotation_fn). Same fail-open optional-export
       precedent as every other dlsym in this block: an older scene .so without it just means the
       audio ES pump (if engaged) is not repositioned on seek — pre-S7 video-only seek behavior,
       no crash. */
    static cheng_es_int_fn s_es_pump_cursor_fn = NULL;

    /* ---- Streaming AUDIO ES (AAC/ADTS) — audio mirror of the video ES pipeline ----
       The scene .so exports cheng_scene_media_audio_es_* (open / sample_rate / channels /
       profile / frame_count / fetch_frame), resolved via dlsym on the app handle. The
       render thread (the only one that drives the Cheng QUIC pump) opens the audio session,
       prefetches ADTS access units into an input FIFO, decodes them with AMediaCodec
       (audio/mp4a-latm, IS_ADTS=1, no csd — each ADTS AU self-describes), and writes the
       PCM into a ring buffer that an AAudio output stream drains. Audio is the master clock:
       its播放position drives video frame release so they never drift. 秒开 is preserved —
       audio open is a kilobyte announce+index dial, same as video. */
    #define CHENG_ANDROID_AES_FQ_CAP 64
    #define CHENG_ANDROID_AES_MAXFRAME 16384      /* one ADTS AAC AU is well under this */
    /* PCM ring buffer: 16-bit interleaved. 48000Hz * 2ch * 2B * ~1.0s headroom. */
    #define CHENG_ANDROID_AES_PCM_RING_FRAMES 65536  /* sample-frames (per-channel groups) */
    typedef struct ChengAndroidAudioEsStreamCtx {{
      pthread_mutex_t fq_mu;
      pthread_cond_t cv_notfull_fq;
      unsigned char* fq[CHENG_ANDROID_AES_FQ_CAP];
      int32_t fq_len[CHENG_ANDROID_AES_FQ_CAP];
      int fq_head, fq_tail, fq_size;
      int frame_count;
      int next_frame_idx;
      int64_t pts_seq;                   /* monotonic ADTS-AU pts (1024 samples / frame) */
      int sample_rate;
      int channels;
      volatile int end_of_stream;
      int input_done;
      int output_done;
      volatile int stop;
      /* PCM ring (producer = decode drain on render thread; consumer = AAudio callback). */
      pthread_mutex_t pcm_mu;
      int16_t* pcm;                      /* malloc'd: PCM_RING_FRAMES * channels int16 */
      int pcm_cap_samples;               /* total int16 slots = PCM_RING_FRAMES * channels */
      int pcm_head, pcm_tail, pcm_size;  /* in int16 slots */
      volatile int64_t frames_played;    /* total sample-frames consumed by AAudio (master clock) */
      volatile int sink_total;           /* ADTS AUs pushed (probe) */
      volatile int pcm_decoded_frames;   /* sample-frames decoded into the ring (probe) */
    }} ChengAndroidAudioEsStreamCtx;
    static ChengAndroidAudioEsStreamCtx s_aes_ctx;
    static volatile int s_aes_ctx_inited = 0;
    static volatile int s_aes_open_requested = 0;
    static volatile int s_aes_open_done = 0;
    static volatile int s_aes_open_result = 0;
    static volatile int s_aes_engaged = 0;       /* an audio ES decoder is live → render thread feeds it */
    static int s_aes_sr = 0, s_aes_ch = 0, s_aes_profile = 0, s_aes_fc = 0;
    static AMediaCodec* s_aes_codec = NULL;
    static AAudioStream* s_aes_stream = NULL;
    static cheng_es_open_fn s_aes_open = NULL;
    static cheng_es_int_fn s_aes_sample_rate = NULL;
    static cheng_es_int_fn s_aes_channels = NULL;
    static cheng_es_int_fn s_aes_profile_fn = NULL;
    static cheng_es_int_fn s_aes_frame_count = NULL;
    static cheng_es_fetch_frame_fn s_aes_fetch_frame = NULL;
    /* S7 audio ES seek-sync: audio mirror of s_es_seek_to_position_ms_fn — jumps the audio pump
       cursor to the AU aligned with a given VIDEO frame index (WebSceneMediaAudioEsSeekToVideoFrame,
       video-seek-scrub-blueprint.md §7.1 选项 A). Resolved in cheng_android_aes_start_once below,
       same fail-open precedent as the rest of this block. */
    static cheng_es_int_int_fn s_aes_seek_to_video_frame_fn = NULL;
    /* Session-lifecycle ownership: the media-texture slot (see ChengAndroidMediaTextureCache
       below) whose prepare_media_surface call last successfully engaged the audio ES session
       above -- this app has exactly one live audio ES stream at a time (s_aes_ctx/s_aes_codec/
       s_aes_stream are process-global singletons, not per-texture), so a single owner pointer
       is enough to answer "does releasing THIS texture end the CURRENT audio session, or is it
       an unrelated slot (image/cover/poster/a different still-live video)". NULL = no session
       owns anything right now. Cleared by cheng_android_aes_session_teardown. */
    static ChengAndroidMediaTextureCache* s_aes_owner_texture = NULL;
    static int cheng_android_aes_start_once(void);
    static void cheng_android_aes_pump_open_on_render_thread(void);
    static void cheng_android_aes_prefetch_on_render_thread(void);
    static void cheng_android_aes_decode_pump_on_render_thread(void);
    static void cheng_android_aes_session_teardown(void);

