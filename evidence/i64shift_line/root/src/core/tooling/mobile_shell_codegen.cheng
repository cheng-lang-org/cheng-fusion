fn MobileShellHarmonyGuiHostSharedHeaderText(): str =
    return Fmt"""
    #ifndef CHENG_GUI_HOST_SHARED_H
    #define CHENG_GUI_HOST_SHARED_H

    // Mechanically split out of cheng_gui_host.c (slice-8 physical split, zero behavior
    // change). Contains: (1) the original file-scope preamble verbatim (includes, macros,
    // typedefs, struct defs) so both TUs see identical type/macro surface; (2) extern
    // prototypes for the 20 functions called across the GEN/ADAPTER split (static removed
    // at their single definition site, accounted in evidence.md); (3) extern declarations
    // for the 39 file-scope variables touched by both sides (27 from the svars ledger +
    // 12 newly-discovered fn_img_*/p_* NDK dlsym pointers), each with exactly one
    // non-static definition in cheng_gui_host_gen.c.
    // GENERATED by build_gui_host.sh — do not edit by hand.
    // OHOS GUI host: proven Android GLES compositor body + OHOS XComponent/EGL driver.
    #include <EGL/egl.h>
    #include <EGL/eglext.h>
    #include <GLES3/gl3.h>
    #include <dlfcn.h>
    #include <errno.h>
    #include <limits.h>
    #include <math.h>
    #include <poll.h>
    #include <pthread.h>
    #include <stdio.h>
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    #include <sys/socket.h>
    #include <sys/types.h>
    #include <arpa/inet.h>
    #include <ifaddrs.h>
    #include <time.h>
    #include <unistd.h>
    #include <fcntl.h>
    #include <sys/stat.h>
    #if defined(__aarch64__) || defined(__ARM_NEON)
    #include <arm_neon.h>
    #define CHENG_HAS_NEON 1
    #endif
    #include <multimedia/player_framework/native_avcodec_base.h>
    #include <multimedia/player_framework/native_avformat.h>
    #include <multimedia/player_framework/native_avbuffer.h>
    #include <multimedia/player_framework/native_avsource.h>
    #include <multimedia/player_framework/native_avdemuxer.h>
