unt + " host_video_texture_update=" + hostVideoTextureUpdateCount + " host_video_texture_presentation_us=" + hostVideoTexturePresentationUs + " host_video_texture_identity=" + hostVideoTextureProvider + "," + hostVideoTextureSlotHash + "," + hostVideoTextureAssetHash + "," + hostVideoTextureManifestHash + "," + hostVideoTexturePosterHash + " host_image_texture_ready=" + hostImageTextureReady + " host_image_texture_receipts=" + hostImageTextureReceiptCount + " host_image_texture_status=" + hostImageTextureStatus + " host_image_texture_provider=" + hostImageTextureProvider + " host_image_texture=" + hostImageTexture + " host_image_texture_size=" + hostImageTextureWidth + "x" + hostImageTextureHeight + " host_image_texture_pixel=" + hostImageTexturePixelFormat + " host_image_texture_target=" + hostImageTextureTarget + " host_image_texture_identity=" + hostImageTextureProvider + "," + hostImageTextureSlotHash + "," + hostImageTextureAssetHash + "," + hostImageTextureManifestHash + "," + hostImageTexturePosterHash + " host_audio_ok=" + hostAudioOk + " host_audio_receipts=" + hostAudioReceiptCount + " host_audio_status=" + hostAudioStatus + " host_audio_state=" + hostAudioState + " host_audio_sample_rate=" + hostAudioSampleRate + " host_audio_channels=" + hostAudioChannels + " host_audio_bits=" + hostAudioBits + " host_audio_pcm_offset=" + hostAudioPcmOffset + " host_audio_pcm_bytes=" + hostAudioPcmBytes + " host_audio_hash=" + hostAudioProviderHash + "," + hostAudioAssetHash + "," + hostAudioDataHash + " host_audio_identity=" + hostAudioProviderHash + "," + hostAudioSlotHash + "," + hostAudioAssetHash + "," + hostAudioDataHash)
