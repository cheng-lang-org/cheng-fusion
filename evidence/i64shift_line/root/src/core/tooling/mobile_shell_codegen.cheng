	            val displayName: String,
	            val localPath: String,
	            val sizeBytes: Long,
	            val durationMs: Long,
	            val previewImage: ChengDecodedImage? = null,
	        )

	        private data class PendingComputerUsePublishRetry(
	            val request: PendingComputerUseMediaSelection,
	            val selection: ComputerUseVideoSelection,
	            val attempts: Int,
	        )

	        private data class ChengPublishMediaPayload(
	            val mediaValue: String,
	            val displayName: String,
	            val mime: String,
	            val type: String,
	            val localPath: String,
	            val sizeBytes: Long,
	        )

        private fun publishNativeAudioPlaybackReceiptLocked() {{
            val handle = runtimeHandle
            if (handle == 0L) {{
                return
            }}
            val ok = nativeRecordAudioPlaybackReceipt(
                handle,
                audioPlaybackReceiptCount,
                audioPlaybackStatus,
                audioPlaybackState,
                audioPlaybackSampleRateHz,
                audioPlaybackChannelCount,
                audioPlaybackBitsPerSample,
                audioPlaybackPcmDataOffset,
                audioPlaybackPcmBytes,
                audioPlaybackProviderHash,
                audioPlaybackSlotHash,
                audioPlaybackAssetHash,
                audioPlaybackDataHash
            )
            if (!ok) {{
                Log.e("cheng-mobile-shell", "audio native receipt record failed receipt=" + audioPlaybackReceiptCount + " status=" + audioPlaybackStatus + " state=" + audioPlaybackState)
            }}
        }}

        private fun readAssetText(relPath: String): String {{
            val stream = assets.open(relPath)
            val reader = stream.reader()
            return reader.readText()
        }}

        private fun validateRouteState(value: String): String {{
            if (value.isEmpty()) {{
                throw IllegalArgumentException("cheng route_state extra is empty")
            }}
            for (ch in value) {{
                val valid = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_'
                if (!valid) {{
                    throw IllegalArgumentException("cheng route_state extra contains invalid character")
                }}
            }}
            return value
        }}

        private fun launchRouteStateOverride(): String? {{
            val raw = intent?.getStringExtra(CHENG_ROUTE_STATE_EXTRA) ?: return null
            return validateRouteState(raw)
        }}

	        private fun computerUseTextFromIntent(sourceIntent: Intent): String? {{
	            val raw = sourceIntent.getStringExtra(CHENG_COMPUTER_USE_TEXT_EXTRA) ?: return null
	            if (raw.isEmpty()) {{
	                throw IllegalArgumentException("cheng computer_use_text extra is empty")
            }}
            if (raw.length > 4096) {{
                throw IllegalArgumentException("cheng computer_use_text extra is too long")
            }}
	            sourceIntent.removeExtra(CHENG_COMPUTER_USE_TEXT_EXTRA)
	            return raw
	        }}

	        private fun requiredVideoMediaPermission(): String? {{
	            return if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.TIRAMISU) {{
	                Manifest.permission.READ_MEDIA_VIDEO
	            }} else if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.M) {{
	                Manifest.permission.READ_EXTERNAL_STORAGE
	            }} else {{
	                null
	            }}
	        }}

	        private fun hasVideoMediaPermission(): Boolean {{
	            val permission = requiredVideoMediaPermission() ?: return true
	            return checkSelfPermission(permission) == PackageManager.PERMISSION_GRANTED
	        }}

	        private fun requestVideoMediaPermission() {{
	            val permission = requiredVideoMediaPermission()
	            if (permission == null) {{
	                val pending = pendingComputerUseMediaSelection
	                pendingComputerUseMediaSelection = null
	                if (pending != null) {{
	                    startComputerUseVideoSelection(pending)
	                }}
	                return
	            }}
	            Log.i("cheng-mobile-shell", "computer_use_media_permission_request permission=" + permission)
	            requestPermissions(arrayOf(permission), CHENG_MEDIA_VIDEO_PERMISSION_REQUEST)
	        }}

	        private fun validateChengFilePickerToken(value: String, label: String): String {{
	            val clean = value.trim()
	            if (clean.isEmpty() || clean.length > 64 || !clean.all {{ ch -> ch.isLetterOrDigit() || ch == '_' || ch == '-' }}) {{
	                throw IllegalArgumentException("invalid cheng file picker " + label)
	            }}
	            return clean
	        }}

	        private fun validateOptionalChengFilePickerToken(value: String, label: String): String {{
	            val clean = value.trim()
	            if (clean.isEmpty()) {{
	                return ""
	            }}
	            return validateChengFilePickerToken(clean, label)
	        }}

	        private fun chengFilePickerMimeTypes(kind: String): Array<String>? {{
	            return when (kind) {{
	                "image" -> arrayOf("image/*")
	                "video" -> arrayOf("video/*")
	                "audio" -> arrayOf("audio/*")
	                "text", "text-document" -> arrayOf("text/plain", "application/pdf", "application/epub+zip")
	                "image-video" -> arrayOf("image/*", "video/*")
	                "any" -> null
	                else -> throw IllegalArgumentException("unsupported cheng file picker kind=" + kind)
	            }}
	        }}

	        private fun chengFilePickerDisplayName(uri: Uri): String {{
	            var displayName = ""
	            contentResolver.query(uri, arrayOf(android.provider.OpenableColumns.DISPLAY_NAME), null, null, null)?.use {{ cursor ->
	                if (cursor.moveToFirst()) {{
	                    val index = cursor.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME)
	                    if (index >= 0) {{
	                        displayName = cursor.getString(index) ?: ""
	                    }}
	                }}
	            }}
	            if (displayName.isNotEmpty()) {{
	                return displayName
	            }}
	            return uri.lastPathSegment ?: ""
	        }}

	        private fun chengFilePickerReadBytes(uri: Uri): ByteArray {{
	            contentResolver.openInputStream(uri)?.use {{ input ->
	                return input.readBytes()
	            }}
	            throw IOException("unable to open picked uri")
	        }}

	        private fun chengFilePickerPayload(uri: Uri, mode: String, displayName: String, mime: String): String {{
		            return when (mode) {{
		                "" -> ""
		                "uri" -> uri.toString()
	                "name" -> displayName
	                "text", "product-csv" -> contentResolver.openInputStream(uri)?.use {{ input ->
	                    input.bufferedReader(Charsets.UTF_8).readText()
	                }} ?: throw IOException("unable to open picked uri text")
			                "data-url", "data-url-array-append" -> {{
			                    val cleanMime = if (mime.isNotEmpty()) mime else "application/octet-stream"
			                    val encoded = android.util.Base64.encodeToString(chengFilePickerReadBytes(uri), android.util.Base64.NO_WRAP)
			                    "data:" + cleanMime + ";base64," + encoded
			                }}
			                "media-selection" -> {{
			                    val fileValue = if (mime.startsWith("video/")) {{
			                        uri.toString()
			                    }} else {{
			                        val cleanMime = if (mime.isNotEmpty()) mime else "application/octet-stream"
			                        val encoded = android.util.Base64.encodeToString(chengFilePickerReadBytes(uri), android.util.Base64.NO_WRAP)
			                        "data:" + cleanMime + ";base64," + encoded
			                    }}
			                    val out = JSONObject()
			                    out.put("uri", fileValue)
			                    out.put("displayName", displayName)
			                    out.put("mime", mime)
			                    out.toString()
			                }}
		                else -> throw IllegalArgumentException("unsupported cheng file picker result mode=" + mode)
		            }}
		        }}

	        private fun chengPublishJsonError(code: String): String {{
	            val out = JSONObject()
	            out.put("ok", false)
	            out.put("error", code)
	            return out.toString()
	        }}

	        private fun chengPublishCategory(rawKind: String): String {{
	            return when (val clean = rawKind.trim()) {{
	                "content", "movie", "graphic", "music", "novel", "product", "food", "ride", "secondhand", "live", "ad" -> clean
	                else -> throw IllegalArgumentException("unsupported publish kind=" + clean)
	            }}
	        }}

	        private fun chengPublishTypeFromMime(mime: String): String {{
	            val clean = mime.trim().lowercase(Locale.ROOT)
	            return when {{
	                clean.startsWith("video/") -> "video"
	                clean.startsWith("image/") -> "image"
	                clean.startsWith("audio/") -> "audio"
	                clean.startsWith("text/") -> "text"
	                else -> throw IllegalArgumentException("unsupported publish mime=" + clean)
	            }}
	        }}

	        private fun chengPublishFileExtension(mime: String): String {{
	            return when (mime.trim().lowercase(Locale.ROOT)) {{
	                "video/mp4" -> ".mp4"
	                "video/quicktime" -> ".mov"
	                "video/webm" -> ".webm"
	                "image/jpeg" -> ".jpg"
	                "image/png" -> ".png"
	                "image/webp" -> ".webp"
	                "image/gif" -> ".gif"
	                "audio/mpeg" -> ".mp3"
	                "audio/mp4" -> ".m4a"
	                "audio/aac" -> ".aac"
	                "audio/wav", "audio/x-wav" -> ".wav"
	                "text/plain" -> ".txt"
	                else -> ".bin"
	            }}
	        }}

	        private fun chengPublishSafeFileName(rawName: String, mime: String): String {{
	            val clean = rawName.trim()
	            val base = StringBuilder()
	            for (ch in clean) {{
	                val valid = (ch >= 'a' && ch <= 'z') ||
	                    (ch >= 'A' && ch <= 'Z') ||
	                    (ch >= '0' && ch <= '9') ||
	                    ch == '.' || ch == '_' || ch == '-'
	                base.append(if (valid) ch else '_')
	            }}
	            var name = base.toString().trim('_')
	            if (name.isEmpty()) {{
	                name = "media"
	            }}
	            if (!name.contains('.')) {{
	                name += chengPublishFileExtension(mime)
	            }}
	            return name
	        }}

	        private fun chengPublishCacheDir(): File {{
	            val dir = File(cacheDir, "cheng-publish")
	            if (!dir.exists() && !dir.mkdirs()) {{
	                throw IOException("unable to create cheng publish cache")
	            }}
	            return dir
	        }}

	        private fun chengPublishWriteBytesToCache(bytes: ByteArray, displayName: String, mime: String): File {{
	            val out = File(chengPublishCacheDir(), System.currentTimeMillis().toString() + "-" + chengPublishSafeFileName(displayName, mime))
	            FileOutputStream(out).use {{ output ->
	                output.write(bytes)
	            }}
	            return out
	        }}

	        private fun chengPublishCopyUriToCache(uri: Uri, displayName: String, mime: String): File {{
	            val out = File(chengPublishCacheDir(), System.currentTimeMillis().toString() + "-" + chengPublishSafeFileName(displayName, mime))
	            contentResolver.openInputStream(uri)?.use {{ input ->
	                FileOutputStream(out).use {{ output ->
	                    input.copyTo(output)
	                }}
	            }} ?: throw IOException("unable to open publish uri")
	            return out
	        }}

	        private fun chengPublishDecodeDataUrl(raw: String): ChengPublishMediaPayload {{
	            val comma = raw.indexOf(',')
	            if (!raw.startsWith("data:") || comma <= 5) {{
	                throw IllegalArgumentException("invalid publish data url")
	            }}
	            val header = raw.substring(5, comma)
	            if (!header.endsWith(";base64")) {{
	                throw IllegalArgumentException("publish data url must be base64")
	            }}
	            val mime = header.removeSuffix(";base64").trim().lowercase(Locale.ROOT)
	            val type = chengPublishTypeFromMime(mime)
	            val bytes = android.util.Base64.decode(raw.substring(comma + 1), android.util.Base64.DEFAULT)
	            val file = chengPublishWriteBytesToCache(bytes, "media" + chengPublishFileExtension(mime), mime)
	            return ChengPublishMediaPayload(raw, file.name, mime, type, file.absolutePath, file.length())
	        }}

	        private fun chengPublishMimeFromLocalFile(file: File): String {{
	            val guessed = java.net.URLConnection.guessContentTypeFromName(file.name)?.trim()?.lowercase(Locale.ROOT).orEmpty()
	            if (guessed.isNotEmpty()) {{
	                return guessed
	            }}
	            val lower = file.name.lowercase(Locale.ROOT)
	            return when {{
	                lower.endsWith(".mp4") -> "video/mp4"
	                lower.endsWith(".mov") -> "video/quicktime"
	                lower.endsWith(".webm") -> "video/webm"
	                lower.endsWith(".jpg") || lower.endsWith(".jpeg") -> "image/jpeg"
	                lower.endsWith(".png") -> "image/png"
	                lower.endsWith(".webp") -> "image/webp"
	                lower.endsWith(".gif") -> "image/gif"
	                lower.endsWith(".mp3") -> "audio/mpeg"
	                lower.endsWith(".m4a") -> "audio/mp4"
	                lower.endsWith(".aac") -> "audio/aac"
	                lower.endsWith(".wav") -> "audio/wav"
	                lower.endsWith(".txt") -> "text/plain"
	                else -> throw IllegalArgumentException("unsupported publish file extension")
	            }}
	        }}

	        private fun chengPublishLocalFilePayload(file: File): ChengPublishMediaPayload {{
	            if (!file.isFile || !file.canRead()) {{
	                throw IOException("publish local file is not readable")
	            }}
	            val mime = chengPublishMimeFromLocalFile(file)
	            val type = chengPublishTypeFromMime(mime)
	            return ChengPublishMediaPayload("file://" + file.absolutePath, file.name, mime, type, file.absolutePath, file.length())
	        }}

	        private fun chengPublishResolveMedia(selectedMediaPath: String): ChengPublishMediaPayload {{
	            val clean = selectedMediaPath.trim()
	            if (clean.isEmpty()) {{
	                throw IllegalArgumentException("publish media is required")
	            }}
	            if (clean.startsWith("data:")) {{
	                return chengPublishDecodeDataUrl(clean)
	            }}
	            val uri = Uri.parse(clean)
	            if (uri.scheme == "content") {{
	                val mime = contentResolver.getType(uri)?.trim().orEmpty()
	                val type = chengPublishTypeFromMime(mime)
	                val displayName = chengFilePickerDisplayName(uri)
	                val file = chengPublishCopyUriToCache(uri, displayName, mime)
	                return ChengPublishMediaPayload("file://" + file.absolutePath, displayName.ifEmpty {{ file.name }}, mime, type, file.absolutePath, file.length())
	            }}
	            if (uri.scheme == "file") {{
	                val path = uri.path ?: ""
	                return chengPublishLocalFilePayload(File(path))
	            }}
	            if (uri.scheme.isNullOrEmpty() && clean.startsWith("/")) {{
	                return chengPublishLocalFilePayload(File(clean))
	            }}
	            throw IllegalArgumentException("unsupported publish media uri")
	        }}

	        private fun chengPublishRequiresMedia(category: String): Boolean {{
	            return category == "content" || category == "movie" || category == "music"
	        }}

	        private fun chengPublishPayloadObject(publishPayloadJson: String): JSONObject {{
	            val clean = publishPayloadJson.trim()
	            if (clean.isEmpty()) {{
	                throw IllegalArgumentException("publish payload is required")
	            }}
	            val payload = JSONObject(clean)
	            val source = payload.optString("source", "").trim()
	            if (source != "cheng.scene.external_publish.v1") {{
	                throw IllegalArgumentException("unsupported publish payload source")
	            }}
	            return payload
	        }}

	        private fun chengPublishPayloadString(payload: JSONObject, key: String): String {{
	            val value = payload.opt(key) ?: return ""
	            return when (value) {{
	                JSONObject.NULL -> ""
	                is String -> value.trim()
	                else -> value.toString().trim()
	            }}
	        }}

	        private fun chengPublishSummary(vararg parts: String): String {{
	            val out = StringBuilder()
	            for (part in parts) {{
	                val clean = part.trim()
	                if (clean.isNotEmpty()) {{
	                    if (out.isNotEmpty()) {{
	                        out.append(" · ")
	                    }}
	                    out.append(clean)
	                }}
	            }}
	            return out.toString()
	        }}

	        private fun chengPublishArray(payload: JSONObject, key: String): JSONArray {{
	            return payload.optJSONArray(key) ?: JSONArray()
	        }}

	        private fun chengPublishCopyStringArray(src: JSONArray): JSONArray {{
	            val out = JSONArray()
	            for (index in 0 until src.length()) {{
	                val item = src.optString(index, "").trim()
	                if (item.isNotEmpty()) {{
	                    out.put(item)
	                }}
	            }}
	            return out
	        }}

	        private fun chengPublishFallbackTitle(category: String, media: ChengPublishMediaPayload?): String {{
	            val explicit = computerUseNativeLastTitle.trim()
	            if (explicit.isNotEmpty()) {{
	                return explicit
	            }}
	            if (media != null) {{
	                val displayName = media.displayName.substringBeforeLast('.', media.displayName).trim()
	                if (displayName.isNotEmpty()) {{
	                    return displayName
	                }}
	            }}
	            return category + " 发布"
	        }}

	        // sourcePeer self-stamp (peerhost-pipeline-break-v10): this device's own reachable
	        // LAN address, written into extra.sourcePeer at publish time -- the ONLY point that
	        // can honestly know it (a viewer cannot guess it, and no upstream caller ever
	        // supplied it, so every downstream peerHost/peerPort transport slot silently stayed
	        // empty). Mirrors the Harmony host's cheng_gui_host_resolve_own_ips (M1 slice-5):
	        // first non-loopback IPv4 interface, deterministic order (no specific peer to prefer
	        // a same-subnet match against at publish time -- that comparison is the CONSUMER's
	        // job, see cheng_gui_host_own_ip_for_peer/cheng_gui_host_peer_matches_own_ip). No
	        // interface found or enumeration failure both fail loud (Log.e) and return null --
	        // callers must omit sourcePeer, never guess a default IP.
	        private fun chengOwnLanIPv4(): String? {{
	            return try {{
	                val interfaces = java.net.NetworkInterface.getNetworkInterfaces()
	                while (interfaces.hasMoreElements()) {{
	                    val iface = interfaces.nextElement()
	                    if (!iface.isUp || iface.isLoopback) {{
	                        continue
	                    }}
	                    val addresses = iface.inetAddresses
	                    while (addresses.hasMoreElements()) {{
	                        val addr = addresses.nextElement()
	                        if (addr is java.net.Inet4Address && !addr.isLoopbackAddress) {{
	                            return addr.hostAddress
	                        }}
	                    }}
	                }}
	                Log.e("cheng-mobile-shell", "own-ip: no non-loopback IPv4 interface found -- sourcePeer will be omitted, no default")
	                null
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "own-ip: NetworkInterface enumeration failed -- sourcePeer will be omitted, no default", error)
	                null
	            }}
	        }}

	        private fun chengPublishBuildPostJson(category: String, media: ChengPublishMediaPayload?, locationHint: String, titleSnapshot: String, payload: JSONObject): String {{
	            val now = System.currentTimeMillis()
	            val mediaItems = JSONArray()
	            if (media != null) {{
	                mediaItems.put(media.mediaValue)
	            }} else {{
	                val images = chengPublishCopyStringArray(chengPublishArray(payload, "images"))
	                for (index in 0 until images.length()) {{
	                    mediaItems.put(images.optString(index))
	                }}
	            }}
	            val firstMedia = if (mediaItems.length() > 0) mediaItems.optString(0, "") else ""
            val payloadTitle = chengPublishPayloadString(payload, "title")
            val payloadAdTitle = chengPublishPayloadString(payload, "adTitle")
            val payloadContent = chengPublishPayloadString(payload, "content")
            val payloadDescription = chengPublishPayloadString(payload, "description")
            val title = if (payloadTitle.isNotEmpty()) payloadTitle else if (payloadAdTitle.isNotEmpty()) payloadAdTitle else titleSnapshot.ifEmpty {{ chengPublishFallbackTitle(category, media) }}
	            val content = if (payloadContent.isNotEmpty()) payloadContent else payloadDescription
	            val routeCategory = chengPublishPayloadString(payload, "category")
	            val price = chengPublishPayloadString(payload, "price")
	            val address = chengPublishPayloadString(payload, "address")
	            val condition = chengPublishPayloadString(payload, "condition")
	            val summary = when (category) {{
	                "food" -> chengPublishSummary(title, routeCategory, if (price.isNotEmpty()) "¥" + price else "", address)
	                "secondhand" -> chengPublishSummary(title, routeCategory, condition, if (price.isNotEmpty()) "¥" + price else "")
	                "ride" -> chengPublishSummary(
	                    chengPublishPayloadString(payload, "rideType"),
	                    chengPublishPayloadString(payload, "fromAddress") + " → " + chengPublishPayloadString(payload, "toAddress"),
	                    chengPublishPayloadString(payload, "date") + " " + chengPublishPayloadString(payload, "time")
	                )
                "product" -> if (title.isNotEmpty()) title else chengPublishPayloadString(payload, "csvFileName")
                "ad" -> chengPublishSummary(title, payloadDescription)
                else -> if (title.isNotEmpty()) title else chengPublishFallbackTitle(category, media)
	            }}
	            val extra = JSONObject()
	            extra.put("scenePublishPayload", JSONObject(payload.toString()))
	            if (media != null) {{
	                extra.put("androidLocalPath", media.localPath)
	                extra.put("androidDisplayName", media.displayName)
	                extra.put("androidMime", media.mime)
	                extra.put("androidSizeBytes", media.sizeBytes)
	            }}
	            if (category == "food") {{
	                val foodMeta = JSONObject()
	                foodMeta.put("title", title)
	                foodMeta.put("description", payloadDescription)
	                foodMeta.put("price", price)
	                foodMeta.put("category", routeCategory)
	                foodMeta.put("address", address)
	                foodMeta.put("availableTime", chengPublishPayloadString(payload, "availableTime"))
	                extra.put("foodMeta", foodMeta)
	            }} else if (category == "secondhand") {{
	                val secondhandMeta = JSONObject()
	                secondhandMeta.put("title", title)
	                secondhandMeta.put("description", payloadDescription)
	                secondhandMeta.put("category", routeCategory)
	                secondhandMeta.put("condition", condition)
	                secondhandMeta.put("originalPrice", chengPublishPayloadString(payload, "originalPrice"))
	                secondhandMeta.put("location", chengPublishPayloadString(payload, "locationInput"))
	                extra.put("secondhandMeta", secondhandMeta)
	            }} else if (category == "ride") {{
	                val rideMeta = JSONObject()
	                rideMeta.put("rideType", chengPublishPayloadString(payload, "rideType"))
	                rideMeta.put("fromAddress", chengPublishPayloadString(payload, "fromAddress"))
	                rideMeta.put("toAddress", chengPublishPayloadString(payload, "toAddress"))
	                rideMeta.put("date", chengPublishPayloadString(payload, "date"))
	                rideMeta.put("time", chengPublishPayloadString(payload, "time"))
	                rideMeta.put("note", chengPublishPayloadString(payload, "note"))
	                rideMeta.put("licensePlate", chengPublishPayloadString(payload, "licensePlate"))
	                rideMeta.put("isNewEnergyVehicle", payload.optBoolean("isNewEnergyVehicle", false))
	                extra.put("rideMeta", rideMeta)
            }} else if (category == "product") {{
                val productMode = chengPublishPayloadString(payload, "mode")
                if (productMode == "csv") {{
                    extra.put("csvData", chengPublishPayloadString(payload, "csvText"))
                }} else {{
                    val productMeta = JSONObject()
                    productMeta.put("mode", productMode)
                    productMeta.put("title", title)
                    productMeta.put("description", payloadDescription)
                    productMeta.put("price", price)
                    productMeta.put("stock", chengPublishPayloadString(payload, "stock"))
                    productMeta.put("enableSKU", payload.optBoolean("enableSKU", false))
                    productMeta.put("colors", chengPublishCopyStringArray(chengPublishArray(payload, "colors")))
                    productMeta.put("sizes", chengPublishCopyStringArray(chengPublishArray(payload, "sizes")))
                    extra.put("manualProduct", productMeta)
                }}
            }} else if (category == "ad") {{
                val adMeta = JSONObject()
                adMeta.put("adTitle", chengPublishPayloadString(payload, "adTitle"))
                adMeta.put("description", payloadDescription)
                adMeta.put("mediaType", media?.type ?: if (mediaItems.length() > 0) "image" else "text")
                val attachContractFlag = payload.optBoolean("attachContract", false)
                adMeta.put("attachContract", attachContractFlag)
                val rewardRaw = chengPublishPayloadString(payload, "rewardRwad")
                val rewardValue = rewardRaw.trim().toDoubleOrNull()
                adMeta.put("rewardRwad", if (attachContractFlag && rewardValue != null && rewardValue.isFinite()) rewardValue else 0.0)
                extra.put("adMeta", adMeta)
            }}
	            // sourcePeer self-stamp: the transport fact a viewer needs to dial this
	            // content (peerhost-pipeline-break-v10 -- this was never written by any
	            // producer, so every downstream peerHost/peerPort slot stayed silently
	            // empty). Port 38000 matches this app's own established fixed publish/ES
	            // serve port convention (s_media_fetch_port's own-device default throughout
	            // this file; unlike the OHOS HAP host this Android app is not sandboxed out
	            // of binding a fixed port, so no ephemeral-port discovery step is needed
	            // here). No default host: an unresolved own IP means this content is not
	            // remotely dial-able and must say so, not lie with a guessed address.
	            val ownIp = chengOwnLanIPv4()
	            if (ownIp != null) {{
	                val sourcePeer = JSONObject()
	                sourcePeer.put("host", ownIp)
	                sourcePeer.put("port", 38000)
	                extra.put("sourcePeer", sourcePeer)
	            }} else {{
	                Log.e("cheng-mobile-shell", "publish: sourcePeer omitted (own LAN IPv4 unknown) -- viewers cannot dial this content, no default host")
	            }}
	            val post = JSONObject()
	            post.put("contentId", category + "-" + now.toString())
	            post.put("postId", category + "-" + now.toString())
	            post.put("id", category + "-" + now.toString())
	            post.put("publishCategory", category)
	            post.put("type", media?.type ?: if (mediaItems.length() > 0) "image" else "text")
	            post.put("title", title)
	            post.put("content", if (content.isNotEmpty()) content else summary)
	            post.put("summary", summary)
	            post.put("media", firstMedia)
	            post.put("mediaItems", mediaItems)
	            if ((media?.type ?: if (mediaItems.length() > 0) "image" else "text") == "image") {{
	                post.put("coverMedia", firstMedia)
	            }} else {{
	                post.put("coverMedia", "")
	            }}
	            post.put("tinyPreview", if (firstMedia.startsWith("data:image/")) firstMedia else "")
	            post.put("mediaAspectRatio", if (media?.type == "video") 16.0 / 9.0 else if (mediaItems.length() > 0) 1.0 else JSONObject.NULL)
	            post.put("locationHint", locationHint)
	            post.put("timestampMs", now)
	            post.put("createdAt", now)
	            post.put("extra", extra)
	            return post.toString()
	        }}

	        // Publish-time real CID ingest (P2P distribution 秒发 slice): run the selected
	        // video through the production chunker pipeline (cheng_publish_cid_pipeline_run
	        // — the same real MediaIngestVideoFilePin/MoqFountainBuild ingest the MoQ
	        // publisher uses — dlsym'd from libcheng_moq_android.so by the native bridge)
	        // so assetCid/manifestCid/posterCid are REAL content-addressed ids of the exact
	        // bytes being published. Before this wiring the post JSON carried no CIDs at
	        // all (the video was packed straight into the task store), so every remote slot
	        // keyed on those CIDs stayed a permanent placeholder. The poster is a REAL
	        // frame extracted from the selected video itself — never a bundled substitute.
	        // Any failure aborts the publish loudly with an error JSON; a CID-less video
	        // post is never allowed out.
	        private fun chengPublishExtractPosterJpeg(videoLocalPath: String, outFile: File): Long {{
	            val retriever = MediaMetadataRetriever()
	            try {{
	                retriever.setDataSource(videoLocalPath)
	                val bitmap = retriever.getFrameAtTime(0L, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
	                    ?: throw IOException("unable to decode publish poster frame")
	                val durationMs = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull() ?: 0L
	                outFile.parentFile?.mkdirs()
	                FileOutputStream(outFile).use {{ out ->
	                    if (!bitmap.compress(android.graphics.Bitmap.CompressFormat.JPEG, 92, out)) {{
	                        throw IOException("publish poster jpeg encode failed")
	                    }}
	                }}
	                bitmap.recycle()
	                return durationMs
	            }} finally {{
	                retriever.release()
	            }}
	        }}

	        // Result envelope: ok=true plus a "cids" object (assetCid / manifestCid /
	        // posterCid / cidContentId) on success; ok=false plus an "error" code on
	        // failure. The pipeline's result channel is the receipt line it appends to
	        // the receipts store (write-then-verify, same contract as
	        // mediaMoqPublisherWriteReadyCid), so the CIDs are read back from disk — never
	        // trusted from a return code alone.
	        private fun chengPublishCidIngestForVideo(media: ChengPublishMediaPayload, klass: Class<*>, instance: Any): JSONObject {{
	            val out = JSONObject()
	            try {{
	                val publishCacheDir = File(cacheDir, "cheng-publish").apply {{ mkdirs() }}
	                val nowMs = System.currentTimeMillis()
	                val posterFile = File(publishCacheDir, "publish_poster_" + nowMs + ".jpg")
	                val durationMs = chengPublishExtractPosterJpeg(media.localPath, posterFile)
	                // Real codec probe for the manifest's codec field (MediaExtractor track
	                // MIME, e.g. "video/avc" / "video/hevc") — the pipeline must not stamp a
	                // guessed codec onto content-addressed metadata.
	                val extractor = android.media.MediaExtractor()
	                var codecMime = ""
	                try {{
	                    extractor.setDataSource(media.localPath)
	                    for (trackIndex in 0 until extractor.trackCount) {{
	                        val trackMime = extractor.getTrackFormat(trackIndex).getString(android.media.MediaFormat.KEY_MIME).orEmpty()
	                        if (trackMime.startsWith("video/")) {{
	                            codecMime = trackMime
	                            break
	                        }}
	                    }}
	                }} finally {{
	                    extractor.release()
	                }}
	                if (codecMime.isEmpty()) {{
	                    out.put("ok", false)
	                    out.put("error", "publish_cid_codec_probe_failed")
	                    return out
	                }}
	                val receiptsStore = File(filesDir, "cheng_publish_cid_receipts.jsonl")
	                val taskId = "publish-cid-" + nowMs
	                val contentId = "publish-cid-content-" + nowMs
	                var ownerPeerId = ""
	                try {{
	                    ownerPeerId = klass.getMethod("getLocalPeerId").invoke(instance)?.toString()?.trim().orEmpty()
	                }} catch (peerError: Throwable) {{
	                    Log.e("cheng-mobile-shell", "publish cid: local peer id unresolved", peerError)
	                }}
	                val rc = nativePublishCidIngest(media.localPath, posterFile.absolutePath, receiptsStore.absolutePath, taskId, contentId, ownerPeerId, durationMs, codecMime)
	                if (rc != 0) {{
	                    Log.e("cheng-mobile-shell", "publish cid: pipeline rc=" + rc + " path_len=" + media.localPath.length)
	                    out.put("ok", false)
	                    out.put("error", "publish_cid_pipeline_failed")
	                    out.put("pipelineRc", rc)
	                    return out
	                }}
	                val linePrefix = taskId + "\t" + contentId + "\t"
	                var receiptJson: JSONObject? = null
	                if (receiptsStore.isFile) {{
	                    receiptsStore.readLines().asReversed().forEach {{ line ->
	                        if (receiptJson == null && line.startsWith(linePrefix)) {{
	                            receiptJson = JSONObject(line.substring(linePrefix.length))
	                        }}
	                    }}
	                }}
	                if (receiptJson == null) {{
	                    out.put("ok", false)
	                    out.put("error", "publish_cid_receipt_missing")
	                    return out
	                }}
	                val receipt = receiptJson!!
	                val assetCid = receipt.optString("assetCid", "").trim()
	                val manifestCid = receipt.optString("manifestCid", "").trim()
	                val posterCid = receipt.optString("posterCid", "").trim()
	                if (assetCid.isEmpty() || manifestCid.isEmpty() || posterCid.isEmpty()) {{
	                    out.put("ok", false)
	                    out.put("error", "publish_cid_receipt_incomplete")
	                    return out
	                }}
	                val cids = JSONObject()
	                cids.put("assetCid", assetCid)
	                cids.put("manifestCid", manifestCid)
	                cids.put("posterCid", posterCid)
	                cids.put("cidContentId", contentId)
	                out.put("ok", true)
	                out.put("cids", cids)
	                Log.i("cheng-mobile-shell", "publish cid: real ingest ok asset_cid=" + assetCid.take(16) + " object_count=" + receipt.optInt("objectCount", -1))
	                return out
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "publish cid: ingest failed", error)
	                out.put("ok", false)
	                out.put("error", "publish_cid_ingest_failed")
	                return out
	            }}
	        }}

	        private fun chengPublishRun(selectedMediaPath: String, category: String, locationHint: String, titleSnapshot: String, publishPayloadJson: String): String {{
	            return try {{
	                val payload = chengPublishPayloadObject(publishPayloadJson)
	                val media = if (selectedMediaPath.trim().isNotEmpty()) chengPublishResolveMedia(selectedMediaPath) else null
	                if (media == null && chengPublishRequiresMedia(category)) {{
	                    return chengPublishJsonError("publish_media_required")
	                }}
	                val postJson = chengPublishBuildPostJson(category, media, locationHint, titleSnapshot, payload)
	                // publish_trace t_pub1: local post JSON materialized (contentId not assigned
	                // yet — that happens inside social_publish_enqueue). Low-frequency, one line
	                // per publish call, mirrors the tap_trace/app_trace marker convention (timing
	                // read off the logcat wall-clock, no in-app delta math).
	                Log.i("cheng-mobile-shell", "publish_trace t_pub1 kind=" + category)
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return chengPublishJsonError("social_backend_instance_missing")
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return startError
	                }}
	                // 秒发 real-CID wiring (publish_cid_pipeline.cheng slice 2): a video publish
	                // must carry the real content-addressed ids of its own bytes. Ingest runs
	                // AFTER the backend is up (ownerPeerId is the real local peer) and BEFORE
	                // enqueue, so the stored/announced post payload embeds the CIDs. Failure
	                // aborts the publish loudly — a CID-less video post is never enqueued.
	                var finalPostJson = postJson
	                if (media != null && media.type == "video") {{
	                    val cidResult = chengPublishCidIngestForVideo(media, klass, instance)
	                    if (!cidResult.optBoolean("ok", false)) {{
	                        return cidResult.toString()
	                    }}
	                    val cids = cidResult.getJSONObject("cids")
	                    val postObj = JSONObject(postJson)
	                    val extraObj = postObj.optJSONObject("extra") ?: JSONObject()
	                    extraObj.put("assetCid", cids.getString("assetCid"))
	                    extraObj.put("manifestCid", cids.getString("manifestCid"))
	                    extraObj.put("posterCid", cids.getString("posterCid"))
	                    extraObj.put("cidContentId", cids.getString("cidContentId"))
	                    postObj.put("extra", extraObj)
	                    finalPostJson = postObj.toString()
	                }}
	                val method = klass.getMethod("socialPublishEnqueue", String::class.java)
	                val result = method.invoke(instance, finalPostJson)?.toString() ?: chengPublishJsonError("social_publish_enqueue_returned_null")
	                var publishedContentId = ""
	                val ok = try {{
	                    val resultJson = JSONObject(result)
	                    publishedContentId = resultJson.optJSONObject("task")?.optString("contentId", "")?.trim().orEmpty()
	                    resultJson.optBoolean("ok", false)
	                }} catch (_: Throwable) {{
	                    false
	                }}
	                if (ok) {{
	                    if (publishedContentId.isEmpty()) {{
	                        Log.e("cheng-mobile-shell", "host_publish enqueue ok but task.contentId missing result_len=" + result.length)
	                    }} else {{
	                        // publish_trace t_pub2: social_publish_enqueue_cstr returned ok with a
	                        // real contentId — the gossipsub announce broadcast and the local
	                        // publish-task store both completed, so the content is hash-addressable
	                        // and fetchable by a connected peer. Fires at most once per publish
	                        // (only on the success path, after t_pub0/t_pub1).
	                        Log.i("cheng-mobile-shell", "publish_trace t_pub2 content_id=" + publishedContentId)
	                    }}
	                    mainHandler.post {{
	                        if (publishedContentId.isNotEmpty()) {{
	                            dispatchRuntimeState("publishedAssetCid", publishedContentId)
	                        }}
	                        pushDistributedContentsToRuntime("publish")
	                    }}
	                }}
	                Log.i("cheng-mobile-shell", "host_publish enqueue_result ok=" + ok + " content_id=" + publishedContentId + " kind=" + category + " media_type=" + (media?.type ?: "text") + " bytes=" + (media?.sizeBytes ?: 0L) + " result_len=" + result.length)
	                result
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "host_publish failed", error)
	                chengPublishJsonError("host_publish_failed")
	            }}
	        }}

	        fun chengPublishFromNative(selectedMediaPath: String, publishKind: String, publishPayloadJson: String): String {{
	            return try {{
	                val category = chengPublishCategory(publishKind)
	                val locationHint = chengPublishVisibleLocationAddress.trim()
	                if (locationHint.isEmpty()) {{
	                    return chengPublishJsonError("publish_location_required")
	                }}
	                val titleSnapshot = computerUseNativeLastTitle.trim()
	                val mediaPathSnapshot = selectedMediaPath.trim()
	                val payloadSnapshot = publishPayloadJson.trim()
	                if (payloadSnapshot.isEmpty()) {{
	                    return chengPublishJsonError("publish_payload_required")
	                }}
	                Thread(null, Runnable {{
	                    chengPublishRun(mediaPathSnapshot, category, locationHint, titleSnapshot, payloadSnapshot)
	                }}, "ChengPublishBridge").start()
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("queued", true)
	                out.put("publishCategory", category)
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "host_publish queue failed", error)
	                chengPublishJsonError("host_publish_queue_failed")
	            }}
	        }}

	        fun chengSocialDmSendFromNative(peerId: String, conversationId: String, messageJson: String): Boolean {{
	            return try {{
	                val cleanPeer = peerId.trim()
	                val cleanConversation = conversationId.trim()
	                val cleanMessage = messageJson.trim()
	                if (cleanPeer.isEmpty() || cleanConversation.isEmpty() || cleanMessage.isEmpty()) {{
	                    return false
	                }}
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return false
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return false
	                }}
	                val method = klass.getMethod("socialDmSend", String::class.java, String::class.java, String::class.java)
	                val value = method.invoke(instance, cleanPeer, cleanConversation, cleanMessage)
	                value as? Boolean ?: false
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "host_social_dm_send failed", error)
	                false
	            }}
	        }}

		        private data class ChengDecodedImage(val width: Int, val height: Int, val pixels: IntArray)

		        private fun chengScaleBitmapForPreview(bitmap: android.graphics.Bitmap): android.graphics.Bitmap {{
		            val maxEdge = maxOf(bitmap.width, bitmap.height)
		            if (maxEdge <= 512) {{
		                return bitmap
		            }}
		            val targetWidth = maxOf(1, ((bitmap.width.toLong() * 512L) / maxEdge.toLong()).toInt())
		            val targetHeight = maxOf(1, ((bitmap.height.toLong() * 512L) / maxEdge.toLong()).toInt())
		            val scaled = android.graphics.Bitmap.createScaledBitmap(bitmap, targetWidth, targetHeight, true)
		            bitmap.recycle()
		            return scaled
		        }}

		        private fun chengDecodedImageFromBitmap(bitmap: android.graphics.Bitmap): ChengDecodedImage {{
		            val previewBitmap = chengScaleBitmapForPreview(bitmap)
		            val pixelCountLong = previewBitmap.width.toLong() * previewBitmap.height.toLong()
		            if (previewBitmap.width <= 0 || previewBitmap.height <= 0 || pixelCountLong <= 0L || pixelCountLong > 33554432L) {{
		                previewBitmap.recycle()
		                throw IOException("picked image dimensions out of range width=" + previewBitmap.width + " height=" + previewBitmap.height)
		            }}
		            val pixels = IntArray(pixelCountLong.toInt())
		            previewBitmap.getPixels(pixels, 0, previewBitmap.width, 0, 0, previewBitmap.width, previewBitmap.height)
		            val decoded = ChengDecodedImage(previewBitmap.width, previewBitmap.height, pixels)
		            previewBitmap.recycle()
		            return decoded
		        }}

		        private fun chengFilePickerShouldInstallDynamicImage(kind: String, mode: String, stateRef: String, mime: String): Boolean {{
		            if (mode != "data-url" || stateRef.isEmpty()) {{
		                return false
		            }}
		            if (kind == "image") {{
		                return true
		            }}
		            return mime.startsWith("image/")
		        }}

		        private fun chengDecodePickedImage(uri: Uri): ChengDecodedImage {{
		            val bitmap = contentResolver.openInputStream(uri)?.use {{ input ->
		                android.graphics.BitmapFactory.decodeStream(input)
		            }} ?: throw IOException("unable to decode picked image")
		            return chengDecodedImageFromBitmap(bitmap)
		        }}

		        private fun chengDecodePickedVideoFrame(uri: Uri): ChengDecodedImage {{
		            val retriever = MediaMetadataRetriever()
		            try {{
		                retriever.setDataSource(this, uri)
		                val bitmap = retriever.getFrameAtTime(50000L, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
		                    ?: retriever.getFrameAtTime(0L, MediaMetadataRetriever.OPTION_CLOSEST)
		                    ?: throw IOException("unable to decode picked video first frame")
		                return chengDecodedImageFromBitmap(bitmap)
		            }} finally {{
		                retriever.release()
		            }}
		        }}

		        private fun chengDecodeVideoFrameFromPath(localPath: String): ChengDecodedImage {{
		            val cleanPath = localPath.trim()
		            if (cleanPath.isEmpty()) {{
		                throw IOException("video path required for cover frame")
		            }}
		            val retriever = MediaMetadataRetriever()
		            try {{
		                retriever.setDataSource(cleanPath)
		                val bitmap = retriever.getFrameAtTime(50000L, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
		                    ?: retriever.getFrameAtTime(0L, MediaMetadataRetriever.OPTION_CLOSEST)
		                    ?: throw IOException("unable to decode selected video cover frame")
		                return chengDecodedImageFromBitmap(bitmap)
		            }} finally {{
		                retriever.release()
		            }}
		        }}

		        private fun chengDecodePickedQrText(uri: Uri, onDecoded: (String?, Throwable?) -> Unit) {{
		            val image = try {{
		                InputImage.fromFilePath(this, uri)
		            }} catch (error: Throwable) {{
		                onDecoded(null, error)
		                return
		            }}
		            val options = BarcodeScannerOptions.Builder()
		                .setBarcodeFormats(Barcode.FORMAT_QR_CODE)
		                .build()
		            val scanner = BarcodeScanning.getClient(options)
		            scanner.process(image)
		                .addOnSuccessListener {{ barcodes ->
		                    var decoded = ""
		                    for (barcode in barcodes) {{
		                        if (barcode.format != Barcode.FORMAT_QR_CODE) {{
		                            continue
		                        }}
		                        val raw = barcode.rawValue?.trim().orEmpty()
		                        if (raw.isNotEmpty()) {{
		                            decoded = raw
		                            break
		                        }}
		                    }}
		                    onDecoded(decoded, null)
		                }}
		                .addOnFailureListener {{ error ->
		                    onDecoded(null, error)
		                }}
		                .addOnCompleteListener {{
		                    scanner.close()
		                }}
		        }}

		        private fun requestChengFilePicker(refName: String, kind: String, resultMode: String, resultStateRef: String) {{
	            val cleanRef = validateChengFilePickerToken(refName, "ref")
	            val cleanKind = validateChengFilePickerToken(kind, "kind")
	            val cleanResultMode = validateOptionalChengFilePickerToken(resultMode, "result mode")
	            val cleanResultStateRef = if (resultStateRef.trim().isEmpty()) "" else validateStateRef(resultStateRef.trim())
	            val mimeTypes = chengFilePickerMimeTypes(cleanKind)
	            val pickerIntent = Intent(Intent.ACTION_OPEN_DOCUMENT).also {{
	                it.addCategory(Intent.CATEGORY_OPENABLE)
	                it.addFlags(Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION)
	                if (mimeTypes == null) {{
	                    it.type = "*/*"
	                }} else if (mimeTypes.size == 1) {{
	                    it.type = mimeTypes[0]
	                }} else {{
	                    it.type = "*/*"
	                    it.putExtra(Intent.EXTRA_MIME_TYPES, mimeTypes)
	                }}
	            }}
	            pickerIntent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
		            pendingChengFilePickerRef = cleanRef
		            pendingChengFilePickerKind = cleanKind
		            pendingChengFilePickerResultMode = cleanResultMode
		            pendingChengFilePickerStateRef = cleanResultStateRef
		            // Snapshot route + form state before documentsui destroys/recreates the runtime.
			            snapshotRuntimeStateForLifecycle("file_picker_open")
			            pendingPickerRestoreRoute = lastRuntimeRouteState
		            Log.i("cheng-mobile-shell", "file_picker_open ref=" + cleanRef + " kind=" + cleanKind + " restore_route=" + (pendingPickerRestoreRoute ?: ""))
		            writeSceneLifecycleStateFile()
		            activityResumed = false
		            nativeSetPresentEnabled(false)
		            cancelFrame()
		            startActivityForResult(pickerIntent, CHENG_FILE_PICKER_REQUEST)
		        }}

	        fun chengRequestFilePickerFromNative(refName: String, kind: String, resultMode: String, resultStateRef: String) {{
	            mainHandler.post {{
	                requestChengFilePicker(refName, kind, resultMode, resultStateRef)
	            }}
	        }}

	        private fun restorePendingChengFilePicker(savedInstanceState: Bundle?) {{
	            if (savedInstanceState == null) {{
	                return
	            }}
	            pendingChengFilePickerRef = savedInstanceState.getString(CHENG_FILE_PICKER_SAVED_REF, "") ?: ""
	            pendingChengFilePickerKind = savedInstanceState.getString(CHENG_FILE_PICKER_SAVED_KIND, "") ?: ""
	            pendingChengFilePickerResultMode = savedInstanceState.getString(CHENG_FILE_PICKER_SAVED_RESULT_MODE, "") ?: ""
	            pendingChengFilePickerStateRef = savedInstanceState.getString(CHENG_FILE_PICKER_SAVED_STATE_REF, "") ?: ""
	            val restoreRoute = savedInstanceState.getString(CHENG_FILE_PICKER_SAVED_RESTORE_ROUTE, "") ?: ""
	            pendingPickerRestoreRoute = if (restoreRoute.isNotEmpty()) validateRouteState(restoreRoute) else null
	            if (pendingChengFilePickerRef.isNotEmpty()) {{
	                Log.i("cheng-mobile-shell", "file_picker_restore ref=" + pendingChengFilePickerRef + " kind=" + pendingChengFilePickerKind + " mode=" + pendingChengFilePickerResultMode + " state_ref=" + pendingChengFilePickerStateRef + " restore_route=" + (pendingPickerRestoreRoute ?: ""))
	            }}
	        }}

	        private fun sceneLifecycleStateFile(): File {{
	            return File(filesDir, CHENG_SCENE_LIFECYCLE_STATE_FILE)
	        }}

	        private fun sceneLifecycleHex(bytes: ByteArray): String {{
	            val alphabet = "0123456789abcdef"
	            val out = StringBuilder(bytes.size * 2)
	            for (byte in bytes) {{
	                val value = byte.toInt() and 0xff
	                out.append(alphabet[value ushr 4])
	                out.append(alphabet[value and 0x0f])
	            }}
	            return out.toString()
	        }}

	        private fun sceneLifecycleRuntimeIdentity(): String {{
	            val digest = MessageDigest.getInstance("SHA-256")
	            digest.update(readAssetText(CHENG_RUNTIME_MANIFEST).toByteArray(Charsets.UTF_8))
	            digest.update(byteArrayOf(0))
	            digest.update(readAssetText(CHENG_RUNTIME_CONTRACT_PAYLOAD_REL).toByteArray(Charsets.UTF_8))
	            digest.update(byteArrayOf(0))
	            digest.update(readAssetText(CHENG_RUNTIME_BUNDLE_PAYLOAD_REL).toByteArray(Charsets.UTF_8))
	            return sceneLifecycleHex(digest.digest())
	        }}

	        private fun snapshotRuntimeStateForLifecycle(reason: String) {{
	            val handle = runtimeHandle
	            if (handle == 0L) {{
	                return
	            }}
	            val route = nativeCurrentRouteState(handle)
	            if (!route.isNullOrEmpty()) {{
	                lastRuntimeRouteState = validateRouteState(route)
	            }}
	            val snapshot = nativeExportSceneStateSnapshot(handle)
	            if (!snapshot.isNullOrEmpty()) {{
	                lastRuntimeStateSnapshotJson = snapshot
	            }}
	            Log.i("cheng-mobile-shell", "scene_lifecycle_snapshot reason=" + reason + " route=" + (lastRuntimeRouteState ?: "") + " snapshot_len=" + lastRuntimeStateSnapshotJson.length + " media=" + (lastRuntimeMediaSelection != null))
	        }}

	        private fun writeSceneLifecycleStateFile() {{
	            val root = JSONObject()
	            root.put("runtimeIdentity", sceneLifecycleRuntimeIdentity())
	            root.put("route", lastRuntimeRouteState ?: "")
	            root.put("snapshot", lastRuntimeStateSnapshotJson)
	            root.put("restoreOnColdStart", pendingChengFilePickerRef.isNotEmpty() || lastRuntimeMediaSelection != null)
	            if (pendingChengFilePickerRef.isNotEmpty()) {{
	                val picker = JSONObject()
	                picker.put("ref", pendingChengFilePickerRef)
	                picker.put("kind", pendingChengFilePickerKind)
	                picker.put("resultMode", pendingChengFilePickerResultMode)
	                picker.put("stateRef", pendingChengFilePickerStateRef)
	                picker.put("restoreRoute", pendingPickerRestoreRoute ?: "")
	                root.put("pendingPicker", picker)
	            }}
	            val media = lastRuntimeMediaSelection
	            if (media != null) {{
	                val mediaJson = JSONObject()
	                mediaJson.put("kind", media.mediaKind)
	                mediaJson.put("payload", media.payload)
	                mediaJson.put("previewReady", media.previewReady)
	                root.put("media", mediaJson)
	            }}
	            sceneLifecycleStateFile().writeText(root.toString(), Charsets.UTF_8)
	        }}

	        private fun discardSceneLifecycleSnapshot(reason: String, snapshotLength: Int) {{
	            lastRuntimeStateSnapshotJson = ""
	            val file = sceneLifecycleStateFile()
	            val deleted = if (file.isFile) file.delete() else false
	            Log.w("cheng-mobile-shell", "scene_lifecycle_restore_skip " + reason + " snapshot_len=" + snapshotLength + " deleted=" + deleted)
	        }}

	        private fun restoreSceneLifecycleState(savedInstanceState: Bundle?) {{
	            val savedFileRequested = savedInstanceState?.getBoolean(CHENG_SCENE_LIFECYCLE_SAVED_FILE, false) ?: false
	            val file = sceneLifecycleStateFile()
	            if (!file.isFile) {{
	                if (savedFileRequested) {{
	                    throw IllegalStateException("cheng scene lifecycle state file is missing")
	                }}
	                return
	            }}
	            val root = JSONObject(file.readText(Charsets.UTF_8))
	            val fileIdentity = root.optString("runtimeIdentity", "")
	            val currentIdentity = sceneLifecycleRuntimeIdentity()
	            if (fileIdentity != currentIdentity) {{
	                Log.i("cheng-mobile-shell", "scene_lifecycle_restore_skip identity_mismatch file=" + fileIdentity.length + " current=" + currentIdentity.length)
	                file.delete()
	                return
	            }}
	            if (!savedFileRequested && !root.optBoolean("restoreOnColdStart", false)) {{
	                return
	            }}
	            // An explicit cheng.route_state launch extra is a debug/automation intent and wins
	            // over this best-effort disk restore (e.g. `am start -e cheng.route_state X` after
	            // force-stop must land on X, not silently resume whatever route was persisted before
	            // the process died). savedFileRequested is a stronger, framework-driven signal
	            // (onSaveInstanceState/onCreate(savedInstanceState) exact-restore contract, e.g.
	            // rotation) and still restores unconditionally there — createRuntimeForSurface's own
	            // lastRuntimeRouteState-over-launchRouteStateOverride() priority (surface
	            // teardown/recreate within a live process, where the launch intent's extra can go
	            // stale relative to live navigation) is unaffected by this cold-restore gate.
	            val route = root.optString("route", "")
	            if (route.isNotEmpty() && (savedFileRequested || launchRouteStateOverride() == null)) {{
	                lastRuntimeRouteState = validateRouteState(route)
	            }}
	            if (pendingChengFilePickerRef.isEmpty()) {{
	                val picker = root.optJSONObject("pendingPicker")
	                if (picker != null) {{
	                    val ref = picker.optString("ref", "")
	                    if (ref.isNotEmpty()) {{
	                        pendingChengFilePickerRef = validateChengFilePickerToken(ref, "ref")
	                        pendingChengFilePickerKind = validateChengFilePickerToken(picker.optString("kind", ""), "kind")
	                        pendingChengFilePickerResultMode = validateOptionalChengFilePickerToken(picker.optString("resultMode", ""), "result mode")
	                        val stateRef = picker.optString("stateRef", "")
	                        pendingChengFilePickerStateRef = if (stateRef.isEmpty()) "" else validateStateRef(stateRef)
	                        val restoreRoute = picker.optString("restoreRoute", "")
	                        pendingPickerRestoreRoute = if (restoreRoute.isNotEmpty()) validateRouteState(restoreRoute) else lastRuntimeRouteState
	                        Log.i("cheng-mobile-shell", "file_picker_restore_file ref=" + pendingChengFilePickerRef + " kind=" + pendingChengFilePickerKind + " mode=" + pendingChengFilePickerResultMode + " state_ref=" + pendingChengFilePickerStateRef + " restore_route=" + (pendingPickerRestoreRoute ?: ""))
	                    }}
	                }}
	            }}
	            lastRuntimeStateSnapshotJson = root.optString("snapshot", "")
	            val mediaJson = root.optJSONObject("media")
	            if (mediaJson != null) {{
	                val mediaKind = mediaJson.optString("kind", "")
	                val payload = mediaJson.optString("payload", "")
	                if (mediaKind.isNotEmpty() && payload.isNotEmpty()) {{
	                    validateChengFilePickerToken(mediaKind, "media kind")
	                    lastRuntimeMediaSelection = PendingMediaSelection(mediaKind, payload, null, mediaJson.optBoolean("previewReady", false))
	                }}
	            }}
	            Log.i("cheng-mobile-shell", "scene_lifecycle_restore route=" + (lastRuntimeRouteState ?: "") + " snapshot_len=" + lastRuntimeStateSnapshotJson.length + " media=" + (lastRuntimeMediaSelection != null))
	        }}

	        private fun chengDecodeMediaSelectionPreviewFromPayload(payload: String): ChengDecodedImage {{
	            val clean = payload.trim()
	            if (clean.startsWith("data:")) {{
	                val comma = clean.indexOf(',')
	                if (comma <= 5 || !clean.substring(0, comma).contains(";base64")) {{
	                    throw IOException("media selection data-url preview payload is not base64")
	                }}
	                val bytes = android.util.Base64.decode(clean.substring(comma + 1), android.util.Base64.DEFAULT)
	                val bitmap = android.graphics.BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
	                    ?: throw IOException("unable to decode media selection data-url preview")
	                return chengDecodedImageFromBitmap(bitmap)
	            }}
	            val uri = Uri.parse(clean)
	            val mime = contentResolver.getType(uri) ?: ""
	            if (mime.startsWith("video/")) {{
	                return chengDecodePickedVideoFrame(uri)
	            }}
	            if (mime.startsWith("image/")) {{
	                return chengDecodePickedImage(uri)
	            }}
	            throw IOException("unsupported media selection preview mime: " + mime)
	        }}

	        private fun mediaSelectionWithRestoredPreview(selection: PendingMediaSelection): PendingMediaSelection {{
	            if (selection.previewImage != null || !selection.previewReady) {{
	                return selection
	            }}
	            val preview = chengDecodeMediaSelectionPreviewFromPayload(selection.payload)
	            return selection.copy(previewImage = preview, previewReady = true)
	        }}

	        private fun replayLastRuntimeMediaSelection(reason: String) {{
	            val selection = lastRuntimeMediaSelection ?: return
	            val restored = mediaSelectionWithRestoredPreview(selection)
	            lastRuntimeMediaSelection = restored
	            Log.i("cheng-mobile-shell", "scene_lifecycle_media_replay reason=" + reason + " kind=" + restored.mediaKind + " payload_len=" + restored.payload.length + " preview=" + restored.previewReady)
	            dispatchRuntimeMediaSelection(restored.mediaKind, restored.payload, restored.previewImage)
	        }}

	        @Volatile
	        private var chengSocialBackendStarted = false

		        private fun buildChengSocialBackendInitConfig(): String {{
		            val config = JSONObject()
		            val dataDir = File(filesDir, "libp2p")
		            if (!dataDir.exists()) {{
		                dataDir.mkdirs()
		            }}
		            config.put("dataDir", dataDir.absolutePath)
		            config.put("data_dir", dataDir.absolutePath)
		            val runtimeProfile = "standard_android"
		            config.put("runtimeProfile", runtimeProfile)
		            config.put("runtime_profile", runtimeProfile)

		            val listenAddresses = JSONArray()
		            listenAddresses.put("/ip4/0.0.0.0/udp/4001/quic-v1")
		            listenAddresses.put("/ip6/::/udp/4001/quic-v1")
		            listenAddresses.put("/ip4/0.0.0.0/tcp/4001")
		            config.put("listenAddresses", listenAddresses)

		            val automations = JSONObject()
		            automations.put("gossipsub", true)
		            automations.put("directStream", true)
		            automations.put("rendezvous", true)
		            automations.put("autonat", false)
		            automations.put("circuitRelay", false)
		            automations.put("livestream", false)
		            automations.put("dataTransfer", false)
		            config.put("automations", automations)
		            return config.toString()
		        }}

		        @Synchronized
		        private fun ensureChengSocialBackendStarted(klass: Class<*>, instance: Any): String? {{
		            if (chengSocialBackendStarted) {{
		                return null
		            }}
		            val initMethod = klass.getMethod("init", String::class.java)
		            val startMethod = klass.getMethod("start")
		            val initValue = initMethod.invoke(instance, buildChengSocialBackendInitConfig())
		            val initOk = initValue as? Boolean ?: false
		            if (!initOk) {{
		                return "{{\"ok\":false,\"error\":\"social_backend_init_failed\"}}"
		            }}
		            val startValue = startMethod.invoke(instance)
		            val startOk = startValue as? Boolean ?: false
		            if (!startOk) {{
		                return "{{\"ok\":false,\"error\":\"social_backend_start_failed\"}}"
		            }}
		            chengSocialBackendStarted = true
		            // Gossipsub/libp2p is live: arm the home-feed inbound pump now, not only
		            // at runtime_create. Create-time start often races backend-not-ready.
		            startFeedEventPumpIfNeeded()
		            return null
		        }}

		        fun chengCreateSocialGroupFromNative(groupMetaJson: String): String {{
		            return try {{
		                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
		                val instance = klass.getField("INSTANCE").get(null)
		                    ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
		                val startError = ensureChengSocialBackendStarted(klass, instance)
		                if (startError != null) {{
		                    return startError
		                }}
		                val method = klass.getMethod("socialGroupsCreate", String::class.java)
		                val value = method.invoke(instance, groupMetaJson)
		                value?.toString() ?: "{{\"ok\":false,\"error\":\"social_groups_create_returned_null\"}}"
		            }} catch (error: Throwable) {{
		                Log.e("cheng-mobile-shell", "social_groups_create failed", error)
		                "{{\"ok\":false,\"error\":\"social_groups_create_failed\"}}"
	            }}
	        }}

	        fun chengSocialSynccastControlFromNative(roomId: String, op: String): String {{
	            return try {{
	                val cleanRoomId = roomId.trim()
	                val cleanOp = op.trim()
	                if (cleanRoomId.isEmpty()) {{
	                    return "{{\"ok\":false,\"error\":\"room_id_required\"}}"
	                }}
	                if (cleanOp != "play" && cleanOp != "pause") {{
	                    return "{{\"ok\":false,\"error\":\"unsupported_synccast_op\"}}"
	                }}
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return startError
	                }}
	                val subscribeMethod = klass.getMethod("pubsubSubscribe", String::class.java)
	                subscribeMethod.invoke(instance, "unimaker/group/" + cleanRoomId + "/v1")
	                val now = System.currentTimeMillis()
	                val control = JSONObject()
	                control.put("op", cleanOp)
	                control.put("timestampMs", now)
	                control.put("anchorTsMs", now)
	                val controlMethod = klass.getMethod("socialSynccastControl", String::class.java, String::class.java)
	                val ok = controlMethod.invoke(instance, cleanRoomId, control.toString()) as? Boolean ?: false
	                if (!ok) {{
	                    return "{{\"ok\":false,\"error\":\"social_synccast_control_failed\"}}"
	                }}
	                val stateMethod = klass.getMethod("socialSynccastGetState", String::class.java)
	                val roomsMethod = klass.getMethod("socialSynccastListRooms", Int::class.javaPrimitiveType)
	                val stateText = stateMethod.invoke(instance, cleanRoomId)?.toString() ?: "{{}}"
	                val roomsText = roomsMethod.invoke(instance, 20)?.toString() ?: "{{\"items\":[],\"totalCount\":0}}"
	                val out = JSONObject()
	                out.put("ok", true)
	                out.put("state", JSONObject(stateText))
	                out.put("rooms", JSONObject(roomsText))
	                out.toString()
	            }} catch (error: Throwable) {{
	                Log.e("cheng-mobile-shell", "social_synccast_control failed", error)
	                "{{\"ok\":false,\"error\":\"social_synccast_control_failed\"}}"
	            }}
	        }}

	        fun chengSocialSynccastRefreshFromNative(roomId: String): String {{
	            return try {{
	                val cleanRoomId = roomId.trim()
	                if (cleanRoomId.isEmpty()) {{
	                    return "{{\"ok\":false,\"error\":\"room_id_required\"}}"
	                }}
	                val klass = Class.forName("com.unimaker.app.libp2p.ChengLibp2pNative")
	                val instance = klass.getField("INSTANCE").get(null)
	                    ?: return "{{\"ok\":false,\"error\":\"social_backend_instance_missing\"}}"
	                val startError = ensureChengSocialBackendStarted(klass, instance)
	                if (startError != null) {{
	                    return startError
	                }}
	                val subscribeMethod = klass.getMethod("pubsubSubscribe", String::class.java)
	                subscribeMethod.invoke(instance, "unimaker/group/" + cleanRoomId + "/v1")
	                val stateMethod = klass.getMethod("socialSynccastGetState", String::class.java)
	                val stateText = stateMethod.invoke(instance, cleanRoomId)?.toString() ?: "{{}}"
	                val out = JSONObject()
	                out.put("ok", true)
