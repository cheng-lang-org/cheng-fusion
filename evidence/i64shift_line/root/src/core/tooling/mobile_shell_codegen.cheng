    int32_t cheng_native_stream_send(int32_t fd, void* data, int32_t n, int32_t flags) {{
      if (data == NULL || n < 0) {{
        errno = EINVAL;
        return -1;
      }}
      ssize_t rc;
      do {{
        rc = send(fd, data, (size_t)n, flags);
      }} while (rc < 0 && errno == EINTR);
      if (rc > INT32_MAX) {{
        abort();
      }}
      return (int32_t)rc;
    }}

    int32_t cheng_native_stream_recv(int32_t fd, void* data, int32_t n, int32_t flags) {{
      if (data == NULL || n < 0) {{
        errno = EINVAL;
        return -1;
      }}
      ssize_t rc;
      do {{
        rc = recv(fd, data, (size_t)n, flags);
      }} while (rc < 0 && errno == EINTR);
      if (rc > INT32_MAX) {{
        abort();
      }}
      return (int32_t)rc;
    }}

