                s_touch_scrolling = 1;
              }}
            }}
            if (s_touch_scrolling) {{
              dispatch_touch = 0;
              // Finger moves up (app_y decreases) -> content scrolls up (scrollY increases).
              scroll_delta_px = (s_touch_last_app_y_milli - app_y_milli) / 1000;
              s_touch_last_app_y_milli = app_y_milli;
