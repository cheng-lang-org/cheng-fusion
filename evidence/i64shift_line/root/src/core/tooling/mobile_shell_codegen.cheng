    return "[\"cheng_app_init\",\"cheng_app_set_window\",\"cheng_app_tick\",\"cheng_app_needs_frame\",\"cheng_app_on_touch\",\"cheng_app_on_touch_milli\",\"cheng_app_on_back\",\"cheng_app_scroll_by\",\"cheng_app_scroll_get\",\"cheng_app_pause\",\"cheng_app_resume\",\"cheng_app_clear_text_input_focus\",\"cheng_app_text_input_utf8\",\"cheng_app_text_input_cursor_utf8\"]"

