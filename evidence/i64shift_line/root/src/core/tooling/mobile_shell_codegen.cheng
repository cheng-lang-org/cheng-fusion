@borrows
fn MobileShellJsonPlatformsText(opts: MobileShellOptions): str =
    return MobileShellJsonPlatformsTextFromFlags(opts.emitAndroid, opts.emitIos, opts.emitHarmony)

fn MobileShellJsonPlatformsTextFromFlags(emitAndroid: bool,
                                          emitIos: bool,
                                          emitHarmony: bool): str =
    if emitAndroid && emitIos && emitHarmony:
        return "[\"android\",\"ios\",\"harmony\"]"
    if emitAndroid && emitIos:
        return "[\"android\",\"ios\"]"
    if emitAndroid && emitHarmony:
        return "[\"android\",\"harmony\"]"
    if emitIos && emitHarmony:
        return "[\"ios\",\"harmony\"]"
    if emitAndroid:
        return "[\"android\"]"
    if emitIos:
        return "[\"ios\"]"
    if emitHarmony:
        return "[\"harmony\"]"
    return "[]"

fn MobileShellJsonNativeSceneRendererPlatformsTextFromFlags(emitAndroid: bool): str =
    if emitAndroid:
        return "[\"android\"]"
    return "[]"

fn MobileShellJsonUnsupportedNativeSceneRendererPlatformsTextFromFlags(emitIos: bool,
                                                                        emitHarmony: bool): str =
    return MobileShellJsonPlatformsTextFromFlags(false, emitIos, emitHarmony)

fn MobileShellUnsupportedNativeSceneRendererPlatformListText(emitIos: bool,
                                                              emitHarmony: bool): str =
    if emitIos && emitHarmony:
        return "ios,harmony"
    if emitIos:
        return "ios"
    if emitHarmony:
        return "harmony"
    return ""

@borrows
fn MobileShellRuntimeModeRequiresNativeSceneRenderer(runtimeMode: str): bool =
    let normalized: str = strutil.Strip(runtimeMode)
    return normalized == "r2c_native_gui_v1"

@borrows
fn MobileShellValidatePlatformRenderContract(opts: MobileShellOptions,
                                               outError: var str): bool =
    if !MobileShellRuntimeModeRequiresNativeSceneRenderer(opts.runtimeMode):
        return true
    let harmonyBlocked: bool = opts.emitHarmony && !opts.harmonyNativeGuiExperimental
    if opts.emitIos || harmonyBlocked:
        let unsupportedPlatforms: str = MobileShellUnsupportedNativeSceneRendererPlatformListText(opts.emitIos, harmonyBlocked)
        outError = Fmt"mobile-shell: runtime mode {opts.runtimeMode} requires cheng_mobile_host_render_v1; native scene renderer is implemented only for android; unsupported platforms: {unsupportedPlatforms}"
        return false
    if !opts.emitAndroid:
        outError = Fmt"mobile-shell: runtime mode {opts.runtimeMode} requires android because cheng_mobile_host_render_v1 is implemented only for android"
        return false
    if !MobileShellAndroidNativeModeIsPrebuilt(opts.androidNativeMode):
        outError = Fmt"mobile-shell: runtime mode {opts.runtimeMode} requires --android-native-mode prebuilt so lib{opts.libName}.so is packaged into android jniLibs"
        return false
    return true

@borrows
fn MobileShellAndroidPackagePath(appId: str): str =
    let parts: str[] = strutil.Split(appId, '.')
    return strutil.Join(parts, "/")

@borrows
fn MobileShellAndroidNativeModeText(mode: str): str =
    let raw: str = strutil.Strip(mode)
    if len(raw) <= 0:
        return "cmake"
    return raw

@borrows
fn MobileShellAndroidNativeModeIsPrebuilt(mode: str): bool =
    return MobileShellAndroidNativeModeText(mode) == "prebuilt"

@borrows
fn MobileShellAndroidNativeModeValid(mode: str): bool =
    let normalized: str = MobileShellAndroidNativeModeText(mode)
    return normalized == "cmake" || normalized == "prebuilt"

fn MobileShellAndroidAbi(): str =
    return "arm64-v8a"

@borrows
fn MobileShellRouteStateValid(routeState: str): bool =
    if len(routeState) <= 0:
        return false
    for i in 0..<routeState.len:
        let ch = routeState[i]
        let lower = ch >= 'a' && ch <= 'z'
        let upper = ch >= 'A' && ch <= 'Z'
        let digit = ch >= '0' && ch <= '9'
        if !(lower || upper || digit || ch == '_'):
            return false
    return true

# Read-only on rootDir (PathAbsolute is @borrows; Fmt interpolates without
# storing the formal): upgrade the callee so borrowed callers bind without
# cloning (turnlog W6/W7 read-only-chain precedent, backward compatible).
@borrows
fn MobileShellDefaultOptions(rootDir: str): MobileShellOptions =
    var opts: MobileShellOptions
    opts.outDir = chengpath.PathAbsolute(rootDir, "artifacts/mobile_shell_export")
    opts.appId = "org.cheng.generated.app"
    opts.appName = "ChengGeneratedApp"
    opts.libName = "cheng_mobile_app"
    opts.runtimeMode = "cheng_app_exports_v1"
    opts.runtimeContractPath = ""
    opts.runtimeBundlePath = ""
    opts.routeState = ""
    opts.androidNativeMode = "cmake"
    opts.androidAppLibPath = ""
    opts.androidHostCc = ""
    opts.androidHostLd = ""
    opts.androidNdkRoot = ""
    opts.androidJavaHome = ""
    opts.androidClangRtDir = ""
    opts.androidApiLevel = "24"
    opts.emitAndroid = true
    opts.emitIos = true
    opts.emitHarmony = true
    opts.harmonyNativeGuiExperimental = false
    opts.harmonyModName = ""
    opts.harmonyLibraryName = ""
    opts.harmonyGuiHostLibraryName = ""
    opts.harmonyGuiHostLinkFlags = ""
    opts.harmonyGuiHostPrebuiltObjects = []
    opts.rootDir = Fmt"{rootDir}"
    return opts

