    /* 与桌面 shim unimaker-digest-host.c 的 cheng_rawmem_write_char 镜像
       (62b5d670a 只补了桌面, 安卓 host 漏补致 scene .so 悬空引用,
       headless-capture -z,defs 链接失败)。 */
    void cheng_rawmem_write_char(void* dst, int32_t idx, char value) {{
      if (dst == NULL || idx < 0) {{
        return;
      }}
      ((char*)dst)[idx] = value;
    }}

    void* cheng_seq_set_grow(void* seq_ptr, int32_t idx, int32_t elem_size) {{
      if (seq_ptr == NULL || elem_size <= 0 || idx < 0 || idx == INT32_MAX) {{
        abort();
      }}
      ChengHostSeqHeader* seq = (ChengHostSeqHeader*)seq_ptr;
      if (seq->len < 0 || seq->cap < 0 || seq->cap < seq->len) {{
        abort();
      }}
      int32_t need_len = idx + 1;
      if (need_len > seq->cap || seq->buffer == NULL) {{
        int32_t new_cap = seq->cap;
        if (new_cap < 4) {{
          new_cap = 4;
        }}
        while (new_cap < need_len) {{
          int32_t grown = new_cap + (new_cap / 2);
          if (grown <= new_cap) {{
            new_cap = need_len;
            break;
          }}
          new_cap = grown;
        }}
        int64_t bytes64 = (int64_t)new_cap * (int64_t)elem_size;
        if (bytes64 <= 0 || bytes64 > (int64_t)INT32_MAX || bytes64 >= 67108864LL) {{
          abort();
        }}
        int32_t old_cap = seq->cap;
        void* new_buffer = realloc(seq->buffer, (size_t)bytes64);
        if (new_buffer == NULL) {{
          abort();
        }}
        if (new_cap > old_cap) {{
          memset((uint8_t*)new_buffer + ((size_t)old_cap * (size_t)elem_size),
                 0,
                 (size_t)(new_cap - old_cap) * (size_t)elem_size);
        }}
        seq->buffer = new_buffer;
        seq->cap = new_cap;
      }}
      if (need_len > seq->len) {{
        seq->len = need_len;
      }}
      return (void*)((uint8_t*)seq->buffer + ((size_t)idx * (size_t)elem_size));
    }}

    void cheng_seq_free(void* seq_ptr) {{
      if (seq_ptr == NULL) {{
        return;
      }}
      ChengHostSeqHeader* seq = (ChengHostSeqHeader*)seq_ptr;
      free(seq->buffer);
      seq->buffer = NULL;
      seq->len = 0;
      seq->cap = 0;
    }}

    /* 墙9 补齐: driver 出的 .so (libchenglibp2p/libcheng_mobile_capi) 重定位
       修真 (elf_object_writer rType 字面量化) 后, -z,defs 首次真正生效暴露的
       运行时原语缺口。语义正典 = src/core/runtime/program_support_backend.cheng
       的同名 @exportc 实现 (exec_diff 网 _shared_runtime.c 为 ABI 对照)。 */
    void setMem(void* dest, int32_t val, int32_t size) {{
