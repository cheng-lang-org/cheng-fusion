fn MobileShellHelpText(): str =
    return Fmt"""
    usage: cheng mobile-shell <subcommand> [args]
    subcommands: help, export, build-probe
    export flags: [--platform android|ios|harmony|all] [--out-dir <dir>] [--app-id <id>] [--app-name <name>] [--lib-name <name>] [--runtime-mode <id>] [--runtime-contract <file>] [--runtime-bundle <file>] [--route-state <id>] [--android-native-mode cmake|prebuilt]
    build-probe flags: [--platform none|android|ios|harmony|all] [--out-dir <dir>] [--app-id <id>] [--app-name <name>] [--lib-name <name>] [--runtime-mode <id>] [--runtime-contract <file>] [--runtime-bundle <file>] [--route-state <id>] [--android-native-mode cmake|prebuilt] [--android-app-lib <so>] [--android-host-cc <clang>] [--android-host-ld <ld.lld>] [--android-ndk-root <dir>] [--android-java-home <dir>] [--android-clang-rt-dir <dir>] [--android-api-level <level>]

    """

fn MobileShellResolvePlatforms(platformText: str,
                                 out: var str[]): bool =
    out = []
    let raw: str = strutil.Strip(platformText)
    let normalized: str = if len(raw) > 0: raw else: "all"
    if normalized == "all":
        add(out, "android")
        add(out, "ios")
        add(out, "harmony")
        return true
    if normalized == "none":
        return true
    if normalized == "android":
        add(out, normalized)
        return true
    if normalized == "ios":
        add(out, normalized)
        return true
    if normalized == "harmony":
        add(out, normalized)
        return true
    return false

# args is scanned read-only; var formals (implicit borrow) let @borrows
# callers bind their borrowed str[] view instead of an owned move. The
# matched element is cloned out to keep the returned str owned.
@borrows
fn MobileShellReadFlagOrDefault(args: var str[],
                                  key: str,
                                  defaultValue: str): str =
    let colonKey: str = Fmt"{key}:"
    let eqKey: str = Fmt"{key}="
    for i in 0..<args.len:
        let arg: str = args[i]
        if strutil.StartsWith(arg, colonKey):
            return strings.DropPrefix(arg, colonKey)
        if strutil.StartsWith(arg, eqKey):
            return strings.DropPrefix(arg, eqKey)
        if arg == key && i + 1 < args.len:
            # 直返视图而非 CloneStr：cmdline 捕获的 argv 后备存储进程级存活，
            # 且本形参组合下 CloneStr 会被冷编译错误赋源（长度对/指针错，probe3 实证）。
            return args[i + 1]
    return defaultValue

@borrows
fn MobileShellEnsureDir(pathRaw: str): bool =
    let path: str = strutil.Strip(pathRaw)
    if len(path) <= 0:
        return false
    if os.DirExists(path):
        return true
    let parent: str = os.ParentDir(path)
    if len(parent) > 0 && parent != path && !os.DirExists(parent):
        if !MobileShellEnsureDir(parent):
            return false
    if !os.MakeDir(path):
        if !os.DirExists(path):
            return false
    return os.DirExists(path)

@borrows
fn MobileShellWriteTextExact(fullPath: str,
                              text: str,
                              outError: var str): bool =
    let parent: str = os.ParentDir(fullPath)
    if len(parent) > 0 && !MobileShellEnsureDir(parent):
        outError = Fmt"mobile-shell: failed to create dir: {parent}"
        return false
    let writePath: str = Fmt"{fullPath}"
    let verifyPath: str = Fmt"{fullPath}"
    if !chengpath.WriteTextFile("", writePath, text):
        outError = Fmt"mobile-shell: write failed: {verifyPath}"
        return false
    return true

@borrows
fn MobileShellWriteFile(fullPath: str,
                          text: str,
                          relPath: str,
                          files: var str[],
                          outError: var str): bool =
    var payload: str = text
    var needsNewline: bool
    if len(payload) <= 0:
        needsNewline = true
    elif payload[payload.len - 1] != '\n':
        needsNewline = true
    if needsNewline:
        payload = Fmt"{payload}\n"
    if !MobileShellWriteTextExact(fullPath, payload, outError):
        return false
    add(files, strings.CloneStr(relPath))
    return true

@borrows
fn MobileShellWriteRelativeFile(rootDir: str,
                                  relPath: str,
                                  text: str,
                                  files: var str[],
                                  outError: var str): bool =
    var payload: str = text
    var needsNewline: bool
    if len(payload) <= 0:
        needsNewline = true
    elif payload[payload.len - 1] != '\n':
        needsNewline = true
    if needsNewline:
        payload = Fmt"{payload}\n"
    let fullPath: str = os.JoinPath(rootDir, relPath)
    if !MobileShellWriteTextExact(fullPath, payload, outError):
        return false
    add(files, strings.CloneStr(relPath))
    return true

@borrows
fn MobileShellReadme(opts: MobileShellOptions,
                       runtimeManifestRel: str,
                       runtimeContractPayloadRel: str,
                       runtimeBundlePayloadRel: str,
                       runtimeSemanticNodesRel: str,
                       runtimeTruthRootRel: str,
                       launchArgsKvRel: str,
                       launchArgsJsonRel: str): str =
    return Fmt"""
    # Cheng Mobile Shell Export

    This bundle is emitted by `cheng mobile-shell export`.

    App contract:
    - The Cheng app binary exports `cheng_app_init`, `cheng_app_set_window`, `cheng_app_tick`, `cheng_app_needs_frame`, `cheng_app_on_touch_milli`, `cheng_app_pause`, `cheng_app_resume`.
    - The generated native shell is responsible for platform lifecycle, window creation, and input forwarding.
    - The shell is generated by Cheng; platform source still targets Android NDK, UIKit/Metal, and Harmony XComponent APIs.

    app_id={opts.appId}
    app_name={opts.appName}
    lib_name={opts.libName}
    runtime_mode={opts.runtimeMode}
    runtime_manifest={runtimeManifestRel}
    runtime_contract_payload={runtimeContractPayloadRel}
    runtime_bundle_payload={runtimeBundlePayloadRel}
    semantic_nodes_path={runtimeSemanticNodesRel}
    truth_root_path={runtimeTruthRootRel}
    host_render_abi=cheng_mobile_host_render_v1
    native_scene_renderer_platforms={MobileShellJsonNativeSceneRendererPlatformsTextFromFlags(opts.emitAndroid)}
    native_scene_renderer_unsupported_platforms={MobileShellJsonUnsupportedNativeSceneRendererPlatformsTextFromFlags(opts.emitIos, opts.emitHarmony)}
    launch_args_kv={launchArgsKvRel}
    launch_args_json={launchArgsJsonRel}
    initial_route_state={opts.routeState}

    """

fn MobileShellWorkspaceRootText(): str =
    let envRoot: str = strutil.Strip(os.GetEnv("CHENG_ROOT"))
    if len(envRoot) > 0:
        return envRoot
    return os.GetCurrentDir()

@borrows
fn MobileShellManifest(opts: MobileShellOptions,
                         runtimeManifestRel: str,
                         runtimeContractPayloadRel: str,
                         runtimeBundlePayloadRel: str,
                         runtimeSemanticNodesRel: str,
                         runtimeTruthRootRel: str,
                         launchArgsKvRel: str,
                         launchArgsJsonRel: str,
                         files: var str[]): str =
    let generatedFileCount: int32 = files.len
    let workspaceRoot: str = MobileShellWorkspaceRootText()
    return Fmt"""
    {{"format":"mobile_shell_manifest_v1","generator":"cheng.cheng.mobile_shell_codegen","workspace_root":{MobileShellJsonQuote(workspaceRoot)},"out_dir":{MobileShellJsonQuote(opts.outDir)},"app_id":{MobileShellJsonQuote(opts.appId)},"app_name":{MobileShellJsonQuote(opts.appName)},"lib_name":{MobileShellJsonQuote(opts.libName)},"runtime_mode":{MobileShellJsonQuote(opts.runtimeMode)},"runtime_manifest":{MobileShellJsonQuote(runtimeManifestRel)},"runtime_contract_payload":{MobileShellJsonQuote(runtimeContractPayloadRel)},"runtime_bundle_payload":{MobileShellJsonQuote(runtimeBundlePayloadRel)},"semantic_nodes_path":{MobileShellJsonQuote(runtimeSemanticNodesRel)},"truth_root_path":{MobileShellJsonQuote(runtimeTruthRootRel)},"host_render_abi":"cheng_mobile_host_render_v1","host_render_exports":{MobileShellJsonHostRenderExportsText()},"native_scene_renderer_platforms":{MobileShellJsonNativeSceneRendererPlatformsTextFromFlags(opts.emitAndroid)},"native_scene_renderer_unsupported_platforms":{MobileShellJsonUnsupportedNativeSceneRendererPlatformsTextFromFlags(opts.emitIos, opts.emitHarmony)},"launch_args_kv":{MobileShellJsonQuote(launchArgsKvRel)},"launch_args_json":{MobileShellJsonQuote(launchArgsJsonRel)},"initial_route_state":{MobileShellJsonQuote(opts.routeState)},"app_exports":{MobileShellJsonAppExportsText()},"platforms":{MobileShellJsonPlatformsText(opts)},"generated_file_count":{generatedFileCount}}}

    """

fn MobileShellManifestValues(outDir: str,
                              appId: str,
                              appName: str,
                              libName: str,
                              runtimeMode: str,
                              routeState: str,
                              emitAndroid: bool,
                              emitIos: bool,
                              emitHarmony: bool,
                              runtimeManifestRel: str,
                              runtimeContractPayloadRel: str,
                              runtimeBundlePayloadRel: str,
                              runtimeSemanticNodesRel: str,
                              runtimeTruthRootRel: str,
                              launchArgsKvRel: str,
                              launchArgsJsonRel: str,
                              generatedFileCount: int32): str =
    let workspaceRoot: str = MobileShellWorkspaceRootText()
    return Fmt"""
    {{"format":"mobile_shell_manifest_v1","generator":"cheng.cheng.mobile_shell_codegen","workspace_root":{MobileShellJsonQuote(workspaceRoot)},"out_dir":{MobileShellJsonQuote(outDir)},"app_id":{MobileShellJsonQuote(appId)},"app_name":{MobileShellJsonQuote(appName)},"lib_name":{MobileShellJsonQuote(libName)},"runtime_mode":{MobileShellJsonQuote(runtimeMode)},"runtime_manifest":{MobileShellJsonQuote(runtimeManifestRel)},"runtime_contract_payload":{MobileShellJsonQuote(runtimeContractPayloadRel)},"runtime_bundle_payload":{MobileShellJsonQuote(runtimeBundlePayloadRel)},"semantic_nodes_path":{MobileShellJsonQuote(runtimeSemanticNodesRel)},"truth_root_path":{MobileShellJsonQuote(runtimeTruthRootRel)},"host_render_abi":"cheng_mobile_host_render_v1","host_render_exports":{MobileShellJsonHostRenderExportsText()},"native_scene_renderer_platforms":{MobileShellJsonNativeSceneRendererPlatformsTextFromFlags(emitAndroid)},"native_scene_renderer_unsupported_platforms":{MobileShellJsonUnsupportedNativeSceneRendererPlatformsTextFromFlags(emitIos, emitHarmony)},"launch_args_kv":{MobileShellJsonQuote(launchArgsKvRel)},"launch_args_json":{MobileShellJsonQuote(launchArgsJsonRel)},"initial_route_state":{MobileShellJsonQuote(routeState)},"app_exports":{MobileShellJsonAppExportsText()},"platforms":{MobileShellJsonPlatformsTextFromFlags(emitAndroid, emitIos, emitHarmony)},"generated_file_count":{generatedFileCount}}}

    """

@borrows
fn MobileShellRuntimeManifest(opts: MobileShellOptions,
                                runtimeContractPayloadRel: str,
                                runtimeBundlePayloadRel: str,
                                runtimeSemanticNodesRel: str,
                                runtimeTruthRootRel: str,
                                launchArgsKvRel: str,
                                launchArgsJsonRel: str): str =
    return Fmt"""
    {{"format":"mobile_shell_runtime_contract_v1","runtime_mode":{MobileShellJsonQuote(opts.runtimeMode)},"runtime_contract_payload":{MobileShellJsonQuote(runtimeContractPayloadRel)},"runtime_bundle_payload":{MobileShellJsonQuote(runtimeBundlePayloadRel)},"semantic_nodes_path":{MobileShellJsonQuote(runtimeSemanticNodesRel)},"truth_root_path":{MobileShellJsonQuote(runtimeTruthRootRel)},"host_render_abi":"cheng_mobile_host_render_v1","host_render_exports":{MobileShellJsonHostRenderExportsText()},"native_scene_renderer_platforms":{MobileShellJsonNativeSceneRendererPlatformsTextFromFlags(opts.emitAndroid)},"native_scene_renderer_unsupported_platforms":{MobileShellJsonUnsupportedNativeSceneRendererPlatformsTextFromFlags(opts.emitIos, opts.emitHarmony)},"launch_args_kv":{MobileShellJsonQuote(launchArgsKvRel)},"launch_args_json":{MobileShellJsonQuote(launchArgsJsonRel)},"initial_route_state":{MobileShellJsonQuote(opts.routeState)},"app_exports":{MobileShellJsonAppExportsText()}}}

    """

fn MobileShellLaunchArgsKvText(routeState: str,
                                 runtimeMode: str,
                                 runtimeManifestRel: str,
                                 runtimeContractPayloadRel: str,
                                 runtimeBundlePayloadRel: str): str =
    return Fmt"""
    gate_mode=android-semantic-visual-1to1
    truth_mode=strict
    route_state={routeState}
    route_lock=0
    ink_launch=0
    ink_seed=52
    runtime_mode={runtimeMode}
    runtime_manifest={runtimeManifestRel}
    runtime_contract_payload={runtimeContractPayloadRel}
    runtime_bundle_payload={runtimeBundlePayloadRel}

    """

fn MobileShellLaunchArgsJsonText(routeState: str,
                                   runtimeMode: str,
                                   runtimeManifestRel: str,
                                   runtimeContractPayloadRel: str,
                                   runtimeBundlePayloadRel: str): str =
    return Fmt"""
    {{"format":"mobile_shell_launch_args_v1","gate_mode":"android-semantic-visual-1to1","truth_mode":"strict","route_state":{MobileShellJsonQuote(routeState)},"route_lock":false,"runtime_mode":{MobileShellJsonQuote(runtimeMode)},"runtime_manifest":{MobileShellJsonQuote(runtimeManifestRel)},"runtime_contract_payload":{MobileShellJsonQuote(runtimeContractPayloadRel)},"runtime_bundle_payload":{MobileShellJsonQuote(runtimeBundlePayloadRel)}}}

    """

fn MobileShellAndroidSettingsGradle(): str =
    return Fmt"""
    pluginManagement {{
        repositories {{
            google()
            mavenCentral()
            gradlePluginPortal()
        }}
    }}
    dependencyResolutionManagement {{
        repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
        repositories {{
            google()
            mavenCentral()
        }}
    }}
    rootProject.name = "cheng_mobile_shell"
    include(":app")

    """

fn MobileShellAndroidTopBuildGradle(): str =
    return Fmt"""
    plugins {{
        id("com.android.application") version "8.13.0" apply false
        id("org.jetbrains.kotlin.android") version "2.0.21" apply false
    }}

    """

fn MobileShellAndroidGradleProperties(): str =
    return Fmt"""
    org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
    android.useAndroidX=true
    kotlin.code.style=official
    kotlin.compiler.execution.strategy=in-process

    """

@borrows
fn MobileShellWriteRuntimePayloadFile(opts: MobileShellOptions,
                                        sourcePath: str,
                                        fallbackBaseName: str,
                                        files: var str[],
                                        outRelPath: var str,
                                        outError: var str): bool =
    outRelPath = ""
    if len(strutil.Strip(sourcePath)) <= 0:
        return true
    let sourceAbs: str = chengpath.PathAbsolute(opts.rootDir, sourcePath)
    if len(sourceAbs) <= 0:
        return true
    let payloadText: str = os.ReadFile(sourceAbs)
    if len(payloadText) <= 0:
        outError = Fmt"mobile-shell: runtime payload missing or empty: {sourceAbs}"
        return false
    var relPath: str = MobileShellRuntimeBundlePayloadRelPath()
    if fallbackBaseName == "runtime_contract_payload.json":
        relPath = MobileShellRuntimeContractPayloadRelPath()
    let targetPath: str = chengpath.PathJoin(opts.outDir, relPath)
    if !MobileShellWriteFile(targetPath, payloadText, relPath, files, outError):
        return false
    outRelPath = relPath
    return true

@borrows
fn MobileShellWriteRawFile(fullPath: str,
                             payload: str,
                             relPath: str,
                             files: var str[],
                             outError: var str): bool =
    if !MobileShellWriteTextExact(fullPath, payload, outError):
        return false
    add(files, strings.CloneStr(relPath))
    return true

@borrows
fn MobileShellCopyRawFile(opts: MobileShellOptions,
                            sourceFull: str,
                            targetRel: str,
                            files: var str[],
    outError: var str): bool =
    if !os.FileExists(sourceFull):
        outError = Fmt"mobile-shell: runtime mirror source missing: {sourceFull}"
        return false
    let payloadText: str = os.ReadFile(sourceFull)
    let targetFull: str = chengpath.PathJoin(opts.outDir, targetRel)
    return MobileShellWriteRawFile(targetFull, payloadText, targetRel, files, outError)

fn MobileShellAddSourceRoot(roots: var str[], root: str) =
    if len(root) <= 0:
        return
    for i in 0..<roots.len:
        if roots[i] == root:
            return
    add(roots, root)

@borrows
fn MobileShellSourceRoots(opts: MobileShellOptions): str[] =
    var roots: str[]
    var bundleSourceAbs: str
    var contractSourceAbs: str
    var appLibSourceAbs: str
    if len(strutil.Strip(opts.runtimeBundlePath)) > 0:
        bundleSourceAbs = chengpath.PathAbsolute(opts.rootDir, opts.runtimeBundlePath)
    if len(strutil.Strip(opts.runtimeContractPath)) > 0:
        contractSourceAbs = chengpath.PathAbsolute(opts.rootDir, opts.runtimeContractPath)
    if MobileShellAndroidNativeModeIsPrebuilt(opts.androidNativeMode) && len(strutil.Strip(opts.androidAppLibPath)) > 0:
        appLibSourceAbs = chengpath.PathAbsolute(opts.rootDir, opts.androidAppLibPath)
    if len(appLibSourceAbs) > 0:
        MobileShellAddSourceRoot(roots, chengpath.PathParentDir(appLibSourceAbs))
    if len(bundleSourceAbs) > 0:
        MobileShellAddSourceRoot(roots, chengpath.PathParentDir(bundleSourceAbs))
    if len(contractSourceAbs) > 0:
        MobileShellAddSourceRoot(roots, chengpath.PathParentDir(contractSourceAbs))
    return roots

@borrows
fn MobileShellCopyRawTreeRec(opts: MobileShellOptions,
                               sourceDir: str,
                               relPrefix: str,
                               targetRootRel: str,
                               files: var str[],
                               outCopiedCount: var int32,
                               outError: var str): bool =
    let names: str[] = os.ListDir(sourceDir)
    for i in 0..<names.len:
        let name: str = names[i]
        if len(name) <= 0:
            continue
        let sourceEntry: str = os.JoinPath(sourceDir, name)
        var nextRelPrefix: str = name
        if len(relPrefix) > 0:
            nextRelPrefix = Fmt"{relPrefix}/{name}"
        if os.DirExists(sourceEntry):
            if !MobileShellCopyRawTreeRec(opts,
                                            sourceEntry,
                                            nextRelPrefix,
                                            targetRootRel,
                                            files,
                                            outCopiedCount,
                                            outError):
                return false
        elif os.FileExists(sourceEntry):
            let targetRel: str = Fmt"{targetRootRel}/{nextRelPrefix}"
            if !MobileShellCopyRawFile(opts, sourceEntry, targetRel, files, outError):
                return false
            outCopiedCount = outCopiedCount + 1
    return true

@borrows
fn MobileShellCopyOptionalGlyphSdfPixelsFromSource(opts: MobileShellOptions,
                                                     sourceRoot: str,
                                                     files: var str[],
                                                     outCopied: var bool,
                                                     outError: var str): bool =
    if outCopied:
        return true
    let directSource: str = os.JoinPath(sourceRoot, "unimaker_glyph_sdf_pixels.bin")
    let runtimeSource: str = os.JoinPath(sourceRoot, MobileShellRuntimeGlyphSdfPixelsRelPath())
    var sourcePath: str
    if os.FileExists(directSource):
        sourcePath = directSource
    elif os.FileExists(runtimeSource):
        sourcePath = runtimeSource
    else:
        return true
    if !MobileShellCopyRawFile(opts,
                                 sourcePath,
                                 MobileShellRuntimeGlyphSdfPixelsRelPath(),
                                 files,
                                 outError):
        return false
    outCopied = true
    return true

