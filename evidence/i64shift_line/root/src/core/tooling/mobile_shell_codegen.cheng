    typedef void (*cheng_app_pause_fn)(uint64_t);
    typedef void (*cheng_app_resume_fn)(uint64_t);
	    typedef int32_t (*cheng_app_text_input_utf8_fn)(const char*);
	    typedef int32_t (*cheng_app_text_input_cursor_utf8_fn)(const char*, int32_t);
	    typedef int32_t (*cheng_app_clear_text_input_focus_fn)(void);
	    typedef int32_t (*cheng_app_computer_use_compile_text_utf8_fn)(const char*, int32_t, int32_t);
	    typedef int32_t (*cheng_app_computer_use_gui_replay_start_fn)(int32_t);
	    typedef int32_t (*cheng_app_computer_use_gui_replay_tick_fn)(int32_t);
	    typedef char* (*cheng_app_debug_cstring_fn)(void);
	    typedef int32_t (*cheng_app_computer_use_media_selection_result_utf8_fn)(const char*, const char*, const char*, int64_t, int64_t, int32_t, int32_t);
	    typedef int32_t (*cheng_app_media_control_fn)(uint64_t, const char*, const char*, const char*);
    typedef int32_t (*cheng_app_debug_i32_fn)(void);
    typedef int32_t (*cheng_app_debug_i32_at_fn)(int32_t);
    typedef int32_t (*cheng_app_debug_probe2_fn)(int32_t, int32_t);
    typedef int32_t (*cheng_app_debug_probe3_fn)(int32_t, int32_t, int32_t);

	    typedef void (*cheng_mobile_host_runtime_set_manifest_payloads_fn)(const char*, const char*, const char*);
	    typedef void (*cheng_mobile_host_runtime_set_launch_args_fn)(const char*, const char*);
			    typedef int32_t (*cheng_mobile_host_runtime_set_state_fn)(const char*, const char*);
			    typedef int32_t (*cheng_app_distributed_contents_update_utf8_fn)(const char*);
			    typedef int32_t (*cheng_app_nodes_update_utf8_fn)(const char*);
			    typedef const char* (*cheng_mobile_host_runtime_current_route_state_fn)(void);
			    typedef const char* (*cheng_mobile_host_runtime_export_scene_state_snapshot_fn)(void);
			    typedef int32_t (*cheng_mobile_host_runtime_restore_scene_state_snapshot_fn)(const char*);
			    typedef int32_t (*cheng_mobile_host_runtime_set_storage_fn)(const char*, const char*);
		    typedef int32_t (*cheng_mobile_host_runtime_storage_dirty_count_fn)(void);
		    typedef char* (*cheng_mobile_host_runtime_storage_dirty_at_fn)(int32_t);
		    typedef int32_t (*cheng_mobile_host_runtime_storage_clear_dirty_fn)(const char*);
		    typedef int32_t (*cheng_mobile_host_runtime_append_string_array_state_fn)(const char*, const char*);
		    typedef int32_t (*cheng_mobile_host_runtime_apply_media_selection_fn)(const char*, const char*, int32_t);
		    typedef int32_t (*cheng_mobile_host_runtime_apply_product_csv_selection_fn)(const char*, const char*);
		    typedef char* (*cheng_mobile_capi_bio_did_create_trusted_wire_fn)(const char*);
		    typedef char* (*cheng_mobile_capi_bio_did_import_wire_fn)(const char*);

	    typedef struct ChengAndroidWindowSlot {{
	      uint64_t id;
	      ANativeWindow* window;
	    }} ChengAndroidWindowSlot;

    typedef struct ChengAndroidLayerCache {{
      int valid;
      int route_index;
