    extern void* cheng_stream_prewarm_worker(void* arg);
    extern void cheng_stream_teardown_active(void);
    extern int cheng_surface_consume(int w, int h);  // 1 = a real frame was consumed+drawn this call (修5 2026-07-26: 秒开 t1 must not count a no-op)
    extern int cheng_surface_create_oes(void);
    extern void cheng_video_vsync_disengage(void);

    // ---- cross-file shared variables (static removed at definition site in
    // cheng_gui_host_gen.c) ----
    extern ChengStreamCtx* s_stream_ctx;
    extern volatile int s_stream_starting;
    extern volatile int s_fetch_route;
    extern OH_AVPlayer* s_audio_player;
    extern volatile int s_stream_ready;
    extern GLuint s_stream_tex;
    extern int64_t s_stream_play_base_ns;
    extern int64_t s_stream_last_frame_idx;
    extern volatile int s_stream_paused;
    extern volatile int s_surf_mode;
    extern OHNativeWindow* s_surf_window;
    extern volatile int s_fetch_thread_started;
    extern pthread_t s_fetch_thread;
    extern volatile int s_stream_src_eof;
    extern volatile int s_stream_eos;
    extern int s_stream_eos_logged;
    extern int s_stream_prefetch_total;  // cumulative video AUs produced by the pump (adapter.c); 修3 gates the deferred audio open on it
    // Publish-receipt mailbox (gen.c, 2026-07-26 init-race root fix): background reporter posts, render thread drains.
    extern void cheng_host_publish_receipt_post(const char* cid, int port);
    extern void cheng_host_publish_receipt_drain(void);
    /* S3 feed prewarm plan: up to N=2 visible-card peers (host dials first only —
       single global ES session; second peer is plan/diag until per-slot pool lands). */
    #define CHENG_FEED_PREWARM_N 2
    extern char s_prewarm_peer_host[64]; /* alias of plan[0] for legacy readers */
    extern volatile int s_prewarm_peer_port;
    extern char s_prewarm_hosts[CHENG_FEED_PREWARM_N][64];
    extern int s_prewarm_ports[CHENG_FEED_PREWARM_N];
    extern volatile int s_prewarm_plan_count;
    extern volatile int s_prewarm_started;
    extern ChengAndroidMediaTextureCache* s_active_stream_texture;
    extern int s_video_back_btn_x;
    extern int s_video_back_btn_y;
    extern int s_video_back_btn_w;
    extern int s_video_back_btn_h;
    extern cheng_app_pause_fn       s_gui_app_pause;
    extern uint64_t s_gui_app_id;
    extern void* s_gui_resource_manager;
    extern fn_img_CreateFromFd p_CreateFromFd;
    extern fn_img_CreatePixelmap p_CreatePixelmap;
    extern fn_img_SrcRelease p_SrcRelease;
    extern fn_dopt_Create p_DoptCreate;
    extern fn_dopt_SetPixelFormat p_DoptSetPixelFormat;
    extern fn_dopt_Release p_DoptRelease;
    extern fn_iinfo_Create p_IInfoCreate;
    extern fn_pm_GetImageInfo p_GetImageInfo;
    extern fn_iinfo_GetU32 p_GetWidth, p_GetHeight, p_GetRowStride;
    extern fn_iinfo_Release p_IInfoRelease;
    extern fn_pm_ReadPixels p_ReadPixels;
    extern fn_pm_Release p_PmRelease;

    // ---- CHENG_LEAK_AUDIT: opt-in per-point malloc/free byte accounting on the
    // playback path (native_hook attribution instrument, see leak3/evidence.md).
    // Compiled out entirely (zero code, zero storage) unless CHENG_LEAK_AUDIT is
    // defined at build time (-DCHENG_LEAK_AUDIT=1). Named points cover every
    // malloc/calloc call site reachable from LOCAL-file playback plus the
    // cheng_malloc/cheng_free Cheng-runtime allocator boundary (catches Cheng-side
    // struct-copy churn from any call site, not just the ones hand-audited so far).
    #ifdef CHENG_LEAK_AUDIT
    #include <malloc.h>  // malloc_usable_size: exact freed-byte size for net-outstanding accounting
    typedef enum {{
      CHENG_LEAK_PT_STREAM_CTX_CALLOC = 0,   // adapter.c cheng_ohos_start_streaming_decode: calloc(1,sizeof(ChengStreamCtx)), per-prepare
      CHENG_LEAK_PT_CPU_RING_POOL_MALLOC,    // adapter.c: CPU-fallback RGBA pool malloc(frame_bytes) x(RING_CAP+2), only when s_surf_mode=0
      CHENG_LEAK_PT_ES_PREFETCH_MALLOC,      // adapter.c cheng_stream_prefetch_frames: malloc(CHENG_STREAM_MAXFRAME), network ES path only
      CHENG_LEAK_PT_ES_SINK_MALLOC,          // adapter.c cheng_scene_media_es_sink_frame: malloc(frameSize), network ES path only
      CHENG_LEAK_PT_LOCAL_PUSH_FRAME_MALLOC, // adapter.c cheng_stream_local_push_frame: malloc(n), LOCAL path, every NALU
      CHENG_LEAK_PT_ON_NEED_INPUT_FREE,      // gen.c cheng_stream_on_need_input: free(bytes), pairs with LOCAL_PUSH_FRAME_MALLOC
      CHENG_LEAK_PT_DECODE_FIRST_FRAME_MALLOC, // gen.c cheng_ohos_decode_first_frame: ctx->nv12 malloc, once per prepare
      CHENG_LEAK_PT_DECODE_FIRST_FRAME_FREE,   // gen.c: matching free(ctx.nv12)
      CHENG_LEAK_PT_CHENG_MALLOC,            // gen.c cheng_malloc: aggregate Cheng-runtime allocator entry (all Cheng-side heap allocs)
      CHENG_LEAK_PT_CHENG_FREE,              // gen.c cheng_free: aggregate Cheng-runtime allocator exit
      CHENG_LEAK_PT_COUNT
    }} ChengLeakAuditPoint;

    extern volatile int64_t g_cheng_leak_audit_calls[CHENG_LEAK_PT_COUNT];
    extern volatile int64_t g_cheng_leak_audit_bytes[CHENG_LEAK_PT_COUNT];

    // Records one alloc/free event at the given named point (thread-safe, lock-free).
    extern void cheng_leak_audit_record(ChengLeakAuditPoint point, int64_t bytes);
    // Call once per render tick. Internally wall-clock gated (cheng_monotime_ns): a
    // no-op on every call except roughly once per 5s, when it emits one structured
    // hilog line via cheng_media_diag with interval deltas + cumulative + net
    // outstanding (malloc_bytes - free_bytes) for the two paired points.
    extern void cheng_leak_audit_tick(void);

    #define CHENG_LEAK_AUDIT_RECORD(point, bytes) cheng_leak_audit_record((point), (int64_t)(bytes))
    #define CHENG_LEAK_AUDIT_TICK() cheng_leak_audit_tick()
    #else
    #define CHENG_LEAK_AUDIT_RECORD(point, bytes) ((void)0)
    #define CHENG_LEAK_AUDIT_TICK() ((void)0)
    #endif // CHENG_LEAK_AUDIT

    #endif // CHENG_GUI_HOST_SHARED_H
    """

fn MobileShellExpectedPlatformSourceFileCount(emitAndroid: bool,
                                               emitIos: bool,
                                               emitHarmony: bool,
                                               androidNativeMode: str): int32 =
    var count: int32
    if emitAndroid:
        if MobileShellAndroidNativeModeIsPrebuilt(androidNativeMode):
            count = count + 10
        else:
            count = count + 11
    if emitIos:
        count = count + 8
    if emitHarmony:
        count = count + 20
    return count

@borrows
fn MobileShellWriteIosInfoPlistFile(opts: MobileShellOptions,
                                      files: var str[],
                                      outError: var str): bool =
    let rel: str = "ios/Info.plist"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    return MobileShellWriteFile(full, MobileShellIosInfoPlist(opts), rel, files, outError)

@borrows
fn MobileShellWriteIosMainFile(opts: MobileShellOptions,
                                 files: var str[],
                                 outError: var str): bool =
    let rel: str = "ios/main.m"
    let text: str = MobileShellIosMain()
    return MobileShellWriteRelativeFile(opts.outDir, rel, text, files, outError)

