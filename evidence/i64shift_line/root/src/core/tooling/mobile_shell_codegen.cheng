	    static void cheng_android_store_rgba_from_argb(uint8_t* dst_px, uint32_t argb) {{
      dst_px[0] = (uint8_t)((argb >> 16u) & 0xffu);
      dst_px[1] = (uint8_t)((argb >> 8u) & 0xffu);
      dst_px[2] = (uint8_t)(argb & 0xffu);
      dst_px[3] = (uint8_t)((argb >> 24u) & 0xffu);
    }}

    static void cheng_android_fill_rect_surface(uint8_t* dst, int surface_width, int surface_height, int stride_pixels, int x, int y, int width, int height, uint32_t argb) {{
      if (dst == NULL || surface_width <= 0 || surface_height <= 0 || stride_pixels < surface_width || width <= 0 || height <= 0) {{
        return;
      }}
      int x0 = x < 0 ? 0 : x;
      int y0 = y < 0 ? 0 : y;
      int x1 = x + width;
      int y1 = y + height;
      if (x1 > surface_width) {{
        x1 = surface_width;
      }}
      if (y1 > surface_height) {{
        y1 = surface_height;
      }}
      if (x0 >= x1 || y0 >= y1) {{
        return;
      }}
      for (int py = y0; py < y1; py++) {{
        uint8_t* row = dst + ((size_t)py * (size_t)stride_pixels * 4u);
        for (int px = x0; px < x1; px++) {{
          cheng_android_store_rgba_from_argb(row + ((size_t)px * 4u), argb);
        }}
      }}
    }}

    static void cheng_android_fill_rect_rgba(ANativeWindow_Buffer* buffer, int x, int y, int width, int height, uint32_t argb) {{
      if (buffer == NULL) {{
        return;
      }}
      cheng_android_fill_rect_surface((uint8_t*)buffer->bits, buffer->width, buffer->height, buffer->stride, x, y, width, height, argb);
    }}

    static void cheng_android_gl_abort_if_false(int ok, const char* stage) {{
      if (!ok) {{
        cheng_log(stage);
        abort();
      }}
    }}

    static GLuint cheng_android_gl_compile_shader(GLenum type, const char* source) {{
      GLuint shader = glCreateShader(type);
      cheng_android_gl_abort_if_false(shader != 0u, "glCreateShader failed");
      glShaderSource(shader, 1, &source, NULL);
      glCompileShader(shader);
      GLint status = 0;
      glGetShaderiv(shader, GL_COMPILE_STATUS, &status);
      if (status != GL_TRUE) {{
        char log_buf[512];
        GLsizei log_len = 0;
        glGetShaderInfoLog(shader, (GLsizei)sizeof(log_buf), &log_len, log_buf);
        log_buf[sizeof(log_buf) - 1u] = 0;
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "shader compile failed: %s", log_buf);
        abort();
      }}
      return shader;
    }}

    static GLuint cheng_android_gl_link_program(const char* vertex_source, const char* fragment_source) {{
      GLuint vertex = cheng_android_gl_compile_shader(GL_VERTEX_SHADER, vertex_source);
      GLuint fragment = cheng_android_gl_compile_shader(GL_FRAGMENT_SHADER, fragment_source);
      GLuint program = glCreateProgram();
      cheng_android_gl_abort_if_false(program != 0u, "glCreateProgram failed");
      glAttachShader(program, vertex);
      glAttachShader(program, fragment);
      glLinkProgram(program);
      glDeleteShader(vertex);
      glDeleteShader(fragment);
      GLint status = 0;
      glGetProgramiv(program, GL_LINK_STATUS, &status);
      if (status != GL_TRUE) {{
        char log_buf[512];
        GLsizei log_len = 0;
        glGetProgramInfoLog(program, (GLsizei)sizeof(log_buf), &log_len, log_buf);
        log_buf[sizeof(log_buf) - 1u] = 0;
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "program link failed: %s", log_buf);
        abort();
      }}
      return program;
    }}

    static void cheng_android_gpu_init_programs(void) {{
      if (s_gl_rect_program != 0u && s_gl_shadow_program != 0u && s_gl_gradient_program != 0u && s_gl_text_program != 0u && s_gl_blit_program != 0u && s_gl_external_blit_program != 0u && s_gl_vbo != 0u && s_gl_fbo != 0u) {{
        return;
      }}
      const char* rect_vs =
          "#version 300 es\n"
          "layout(location = 0) in vec2 a_pos;\n"
          "uniform vec2 u_screen;\n"
          "out vec2 v_pos;\n"
          "void main() {{\n"
          "  vec2 clip = vec2((a_pos.x / u_screen.x) * 2.0 - 1.0, 1.0 - (a_pos.y / u_screen.y) * 2.0);\n"
          "  gl_Position = vec4(clip, 0.0, 1.0);\n"
          "  v_pos = a_pos;\n"
          "}}\n";
      const char* rect_fs =
          "#version 300 es\n"
          "precision highp float;\n"
          "uniform vec4 u_color;\n"
          "uniform vec4 u_rect;\n"
          "uniform float u_radius;\n"
          "uniform float u_stroke_width;\n"
          "in vec2 v_pos;\n"
          "out vec4 frag_color;\n"
          "float rounded_box_distance(vec2 p, vec4 rect, float radius) {{\n"
          "  vec2 half_size = max(rect.zw * 0.5, vec2(0.0));\n"
          "  vec2 center = rect.xy + half_size;\n"
          "  float r = clamp(radius, 0.0, min(half_size.x, half_size.y));\n"
          "  vec2 q = abs(p - center) - max(half_size - vec2(r), vec2(0.0));\n"
          "  return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;\n"
          "}}\n"
          "void main() {{\n"
          "  float d = rounded_box_distance(v_pos, u_rect, u_radius);\n"
          "  float aa = max(fwidth(d), 1e-4);\n"
          "  float outer_alpha = clamp(0.5 - d / aa, 0.0, 1.0);\n"
          "  float alpha = outer_alpha;\n"
          "  if (u_stroke_width > 0.0) {{\n"
          "    float sw = min(u_stroke_width, min(u_rect.z, u_rect.w) * 0.5);\n"
          "    vec4 inner_rect = vec4(u_rect.xy + vec2(sw), max(u_rect.zw - vec2(sw * 2.0), vec2(0.0)));\n"
          "    float inner_radius = max(u_radius - sw, 0.0);\n"
          "    float inner_d = rounded_box_distance(v_pos, inner_rect, inner_radius);\n"
          "    float inner_aa = max(fwidth(inner_d), 1e-4);\n"
          "    float inner_alpha = clamp(0.5 - inner_d / inner_aa, 0.0, 1.0);\n"
          "    alpha = outer_alpha * (1.0 - inner_alpha);\n"
          "  }}\n"
          "  frag_color = vec4(u_color.rgb, u_color.a * clamp(alpha, 0.0, 1.0));\n"
          "}}\n";
      const char* shadow_vs =
          "#version 300 es\n"
          "layout(location = 0) in vec2 a_pos;\n"
          "uniform vec2 u_screen;\n"
          "out vec2 v_pos;\n"
          "void main() {{\n"
          "  vec2 clip = vec2((a_pos.x / u_screen.x) * 2.0 - 1.0, 1.0 - (a_pos.y / u_screen.y) * 2.0);\n"
          "  gl_Position = vec4(clip, 0.0, 1.0);\n"
          "  v_pos = a_pos;\n"
          "}}\n";
      const char* shadow_fs =
          "#version 300 es\n"
          "precision mediump float;\n"
          "uniform vec4 u_color;\n"
          "uniform vec4 u_origin_rect;\n"
          "uniform vec4 u_shadow_rect;\n"
          "uniform float u_origin_radius;\n"
          "uniform float u_shadow_radius;\n"
          "uniform float u_blur;\n"
          "uniform float u_inset;\n"
          "in vec2 v_pos;\n"
          "out vec4 frag_color;\n"
          "float rounded_box_distance(vec2 p, vec4 rect, float radius) {{\n"
          "  vec2 half_size = max(rect.zw * 0.5, vec2(0.0));\n"
          "  vec2 center = rect.xy + half_size;\n"
          "  float r = clamp(radius, 0.0, min(half_size.x, half_size.y));\n"
          "  vec2 q = abs(p - center) - max(half_size - vec2(r), vec2(0.0));\n"
          "  return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;\n"
          "}}\n"
          "void main() {{\n"
          "  float inside_origin = rounded_box_distance(v_pos, u_origin_rect, u_origin_radius);\n"
          "  float outside_shadow = rounded_box_distance(v_pos, u_shadow_rect, u_shadow_radius);\n"
          "  float outer_alpha = u_blur <= 0.0 ? step(outside_shadow, 0.0) : 1.0 - smoothstep(0.0, u_blur, outside_shadow);\n"
          "  outer_alpha *= step(0.0, inside_origin);\n"
          "  float inner_alpha = u_blur <= 0.0 ? step(0.0, outside_shadow) : smoothstep(0.0, u_blur, outside_shadow);\n"
          "  inner_alpha *= step(inside_origin, 0.0);\n"
          "  float alpha = u_inset > 0.5 ? inner_alpha : outer_alpha;\n"
          "  frag_color = vec4(u_color.rgb, u_color.a * clamp(alpha, 0.0, 1.0));\n"
          "}}\n";
      const char* gradient_vs =
          "#version 300 es\n"
          "layout(location = 0) in vec2 a_pos;\n"
          "uniform vec2 u_screen;\n"
          "out vec2 v_pos;\n"
          "void main() {{\n"
          "  vec2 clip = vec2((a_pos.x / u_screen.x) * 2.0 - 1.0, 1.0 - (a_pos.y / u_screen.y) * 2.0);\n"
          "  gl_Position = vec4(clip, 0.0, 1.0);\n"
          "  v_pos = a_pos;\n"
          "}}\n";
      const char* gradient_fs =
          "#version 300 es\n"
          "precision highp float;\n"
          "uniform vec4 u_start_color;\n"
          "uniform vec4 u_end_color;\n"
          "uniform vec4 u_rect;\n"
          "uniform float u_radius;\n"
          "uniform vec2 u_gradient_start;\n"
          "uniform vec2 u_gradient_end;\n"
          "uniform int u_gradient_kind;\n"
          "uniform vec2 u_gradient_center;\n"
          "uniform float u_gradient_outer_radius;\n"
          "in vec2 v_pos;\n"
          "out vec4 frag_color;\n"
          "float rounded_box_distance(vec2 p, vec4 rect, float radius) {{\n"
          "  vec2 half_size = max(rect.zw * 0.5, vec2(0.0));\n"
          "  vec2 center = rect.xy + half_size;\n"
          "  float r = clamp(radius, 0.0, min(half_size.x, half_size.y));\n"
          "  vec2 q = abs(p - center) - max(half_size - vec2(r), vec2(0.0));\n"
          "  return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;\n"
          "}}\n"
          "void main() {{\n"
          "  float t;\n"
          "  if (u_gradient_kind == 1) {{\n"
          "    float outer = max(u_gradient_outer_radius, 1.0);\n"
          "    t = clamp(distance(v_pos, u_gradient_center) / outer, 0.0, 1.0);\n"
          "  }} else {{\n"
          "    vec2 axis = u_gradient_end - u_gradient_start;\n"
          "    float denom = max(dot(axis, axis), 1.0);\n"
          "    t = clamp(dot(v_pos - u_gradient_start, axis) / denom, 0.0, 1.0);\n"
          "  }}\n"
          "  vec4 color = mix(u_start_color, u_end_color, t);\n"
          "  float inside = step(rounded_box_distance(v_pos, u_rect, u_radius), 0.0);\n"
          "  frag_color = vec4(color.rgb, color.a * inside);\n"
          "}}\n";
      const char* text_vs =
          "#version 300 es\n"
          "layout(location = 0) in vec2 a_pos;\n"
          "layout(location = 1) in vec2 a_uv;\n"
          "uniform vec2 u_screen;\n"
          "out vec2 v_uv;\n"
          "void main() {{\n"
          "  vec2 clip = vec2((a_pos.x / u_screen.x) * 2.0 - 1.0, 1.0 - (a_pos.y / u_screen.y) * 2.0);\n"
          "  gl_Position = vec4(clip, 0.0, 1.0);\n"
          "  v_uv = a_uv;\n"
          "}}\n";
      const char* text_fs =
          "#version 300 es\n"
          "precision mediump float;\n"
          "uniform sampler2D u_atlas;\n"
          "uniform vec4 u_color;\n"
          "uniform float u_px_range;\n"
          "in vec2 v_uv;\n"
          "out vec4 frag_color;\n"
          "void main() {{\n"
          "  float d = texture(u_atlas, v_uv).r;\n"
          "  vec2 unit_range = vec2(u_px_range) / vec2(textureSize(u_atlas, 0));\n"
          "  vec2 screen_tex_size = vec2(1.0) / max(fwidth(v_uv), vec2(0.000001));\n"
          "  float screen_px_range = max(0.5 * dot(unit_range, screen_tex_size), 1.0);\n"
          "  float a = clamp((d - 0.5) * screen_px_range + 0.5, 0.0, 1.0) * u_color.a;\n"
          "  frag_color = vec4(u_color.rgb, a);\n"
          "}}\n";
      const char* blit_vs =
          "#version 300 es\n"
          "layout(location = 0) in vec2 a_pos;\n"
          "layout(location = 1) in vec2 a_uv;\n"
          "uniform vec2 u_screen;\n"
          "out vec2 v_uv;\n"
          "void main() {{\n"
          "  vec2 clip = vec2((a_pos.x / u_screen.x) * 2.0 - 1.0, 1.0 - (a_pos.y / u_screen.y) * 2.0);\n"
          "  gl_Position = vec4(clip, 0.0, 1.0);\n"
          "  v_uv = a_uv;\n"
          "}}\n";
      const char* external_blit_vs =
          "#version 300 es\n"
          "layout(location = 0) in vec2 a_pos;\n"
          "layout(location = 1) in vec2 a_uv;\n"
          "uniform vec2 u_screen;\n"
          "uniform mat4 u_tex_transform;\n"
          "out vec2 v_uv;\n"
          "void main() {{\n"
          "  vec2 clip = vec2((a_pos.x / u_screen.x) * 2.0 - 1.0, 1.0 - (a_pos.y / u_screen.y) * 2.0);\n"
          "  gl_Position = vec4(clip, 0.0, 1.0);\n"
          "  vec4 transformed = u_tex_transform * vec4(a_uv, 0.0, 1.0);\n"
          "  v_uv = transformed.xy;\n"
          "}}\n";
      const char* blit_fs =
          "#version 300 es\n"
          "precision mediump float;\n"
          "uniform sampler2D u_texture;\n"
          "in vec2 v_uv;\n"
          "out vec4 frag_color;\n"
          "void main() {{\n"
          "  frag_color = texture(u_texture, v_uv);\n"
          "}}\n";
      const char* external_blit_fs =
          "#version 300 es\n"
          "#extension GL_OES_EGL_image_external_essl3 : require\n"
          "precision mediump float;\n"
          "uniform samplerExternalOES u_texture;\n"
          "in vec2 v_uv;\n"
          "out vec4 frag_color;\n"
          "void main() {{\n"
          "  frag_color = texture(u_texture, v_uv);\n"
          "}}\n";
      s_gl_rect_program = cheng_android_gl_link_program(rect_vs, rect_fs);
      s_gl_shadow_program = cheng_android_gl_link_program(shadow_vs, shadow_fs);
      s_gl_gradient_program = cheng_android_gl_link_program(gradient_vs, gradient_fs);
      s_gl_text_program = cheng_android_gl_link_program(text_vs, text_fs);
      const char* inkfield_fs =
          "#version 300 es\n"
          "precision mediump float;\n"
          "uniform sampler2D u_texture;\n"
          "uniform float u_fade;\n"
          "in vec2 v_uv;\n"
          "out vec4 frag_color;\n"
          "void main() {{\n"
          "  float d = texture(u_texture, v_uv).r * u_fade;\n"
          "  float core = smoothstep(0.26, 0.46, d);\n"
          "  float haze = smoothstep(0.05, 0.26, d) * 0.30;\n"
          "  float a = clamp(core + haze, 0.0, 1.0);\n"
          "  vec3 ink = mix(vec3(0.30, 0.34, 0.38), vec3(0.030, 0.040, 0.055), core);\n"
          "  frag_color = vec4(ink * a, a);\n"
          "}}\n";
      s_gl_inkfield_program = cheng_android_gl_link_program(blit_vs, inkfield_fs);
      s_gl_blit_program = cheng_android_gl_link_program(blit_vs, blit_fs);
      s_gl_external_blit_program = cheng_android_gl_link_program(external_blit_vs, external_blit_fs);
      s_gl_rect_screen_loc = glGetUniformLocation(s_gl_rect_program, "u_screen");
      s_gl_rect_color_loc = glGetUniformLocation(s_gl_rect_program, "u_color");
      s_gl_rect_rect_loc = glGetUniformLocation(s_gl_rect_program, "u_rect");
      s_gl_rect_radius_loc = glGetUniformLocation(s_gl_rect_program, "u_radius");
      s_gl_rect_stroke_width_loc = glGetUniformLocation(s_gl_rect_program, "u_stroke_width");
      s_gl_shadow_screen_loc = glGetUniformLocation(s_gl_shadow_program, "u_screen");
      s_gl_shadow_color_loc = glGetUniformLocation(s_gl_shadow_program, "u_color");
      s_gl_shadow_origin_rect_loc = glGetUniformLocation(s_gl_shadow_program, "u_origin_rect");
      s_gl_shadow_rect_loc = glGetUniformLocation(s_gl_shadow_program, "u_shadow_rect");
      s_gl_shadow_origin_radius_loc = glGetUniformLocation(s_gl_shadow_program, "u_origin_radius");
      s_gl_shadow_radius_loc = glGetUniformLocation(s_gl_shadow_program, "u_shadow_radius");
      s_gl_shadow_blur_loc = glGetUniformLocation(s_gl_shadow_program, "u_blur");
      s_gl_shadow_inset_loc = glGetUniformLocation(s_gl_shadow_program, "u_inset");
      s_gl_gradient_screen_loc = glGetUniformLocation(s_gl_gradient_program, "u_screen");
      s_gl_gradient_start_color_loc = glGetUniformLocation(s_gl_gradient_program, "u_start_color");
      s_gl_gradient_end_color_loc = glGetUniformLocation(s_gl_gradient_program, "u_end_color");
      s_gl_gradient_rect_loc = glGetUniformLocation(s_gl_gradient_program, "u_rect");
      s_gl_gradient_radius_loc = glGetUniformLocation(s_gl_gradient_program, "u_radius");
      s_gl_gradient_start_loc = glGetUniformLocation(s_gl_gradient_program, "u_gradient_start");
      s_gl_gradient_end_loc = glGetUniformLocation(s_gl_gradient_program, "u_gradient_end");
      s_gl_gradient_kind_loc = glGetUniformLocation(s_gl_gradient_program, "u_gradient_kind");
      s_gl_gradient_center_loc = glGetUniformLocation(s_gl_gradient_program, "u_gradient_center");
      s_gl_gradient_outer_radius_loc = glGetUniformLocation(s_gl_gradient_program, "u_gradient_outer_radius");
      s_gl_text_screen_loc = glGetUniformLocation(s_gl_text_program, "u_screen");
      s_gl_text_color_loc = glGetUniformLocation(s_gl_text_program, "u_color");
      s_gl_text_px_range_loc = glGetUniformLocation(s_gl_text_program, "u_px_range");
      s_gl_text_atlas_loc = glGetUniformLocation(s_gl_text_program, "u_atlas");
      s_gl_inkfield_screen_loc = glGetUniformLocation(s_gl_inkfield_program, "u_screen");
      s_gl_inkfield_texture_loc = glGetUniformLocation(s_gl_inkfield_program, "u_texture");
      s_gl_inkfield_fade_loc = glGetUniformLocation(s_gl_inkfield_program, "u_fade");
      s_gl_blit_screen_loc = glGetUniformLocation(s_gl_blit_program, "u_screen");
      s_gl_blit_texture_loc = glGetUniformLocation(s_gl_blit_program, "u_texture");
      s_gl_external_blit_screen_loc = glGetUniformLocation(s_gl_external_blit_program, "u_screen");
      s_gl_external_blit_texture_loc = glGetUniformLocation(s_gl_external_blit_program, "u_texture");
      s_gl_external_blit_tex_transform_loc = glGetUniformLocation(s_gl_external_blit_program, "u_tex_transform");
      cheng_android_gl_abort_if_false(s_gl_rect_screen_loc >= 0 && s_gl_rect_color_loc >= 0 && s_gl_rect_rect_loc >= 0 && s_gl_rect_radius_loc >= 0 && s_gl_rect_stroke_width_loc >= 0 && s_gl_shadow_screen_loc >= 0 && s_gl_shadow_color_loc >= 0 && s_gl_shadow_origin_rect_loc >= 0 && s_gl_shadow_rect_loc >= 0 && s_gl_shadow_origin_radius_loc >= 0 && s_gl_shadow_radius_loc >= 0 && s_gl_shadow_blur_loc >= 0 && s_gl_shadow_inset_loc >= 0 && s_gl_gradient_screen_loc >= 0 && s_gl_gradient_start_color_loc >= 0 && s_gl_gradient_end_color_loc >= 0 && s_gl_gradient_rect_loc >= 0 && s_gl_gradient_radius_loc >= 0 && s_gl_gradient_start_loc >= 0 && s_gl_gradient_end_loc >= 0 && s_gl_gradient_kind_loc >= 0 && s_gl_gradient_center_loc >= 0 && s_gl_gradient_outer_radius_loc >= 0 && s_gl_text_screen_loc >= 0 && s_gl_text_color_loc >= 0 && s_gl_text_px_range_loc >= 0 && s_gl_text_atlas_loc >= 0 && s_gl_blit_screen_loc >= 0 && s_gl_blit_texture_loc >= 0 && s_gl_external_blit_screen_loc >= 0 && s_gl_external_blit_texture_loc >= 0 && s_gl_external_blit_tex_transform_loc >= 0, "glGetUniformLocation failed");
      glGenBuffers(1, &s_gl_vbo);
      cheng_android_gl_abort_if_false(s_gl_vbo != 0u, "glGenBuffers failed");
      glGenFramebuffers(1, &s_gl_fbo);
      cheng_android_gl_abort_if_false(s_gl_fbo != 0u, "glGenFramebuffers failed");
    }}

    static void cheng_android_media_texture_release(ChengAndroidMediaTextureCache* texture);
    static JNIEnv* cheng_android_jni_env(void);
    static int cheng_android_media_texture_pump_decoder(ChengAndroidMediaTextureCache* texture, JNIEnv* env, int playback_state);

    static void cheng_android_gpu_destroy(void) {{
      for (int i = 0; i < CHENG_ANDROID_MEDIA_TEXTURE_CACHE_CAP; i++) {{
        cheng_android_media_texture_release(&s_media_textures[i]);
      }}
      if (s_egl_display != EGL_NO_DISPLAY) {{
        eglMakeCurrent(s_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
        if (s_egl_pbuffer_surface != EGL_NO_SURFACE) {{
          eglDestroySurface(s_egl_display, s_egl_pbuffer_surface);
        }}
        if (s_egl_surface != EGL_NO_SURFACE) {{
          eglDestroySurface(s_egl_display, s_egl_surface);
        }}
        if (s_egl_context != EGL_NO_CONTEXT) {{
          eglDestroyContext(s_egl_display, s_egl_context);
        }}
        eglTerminate(s_egl_display);
      }}
      s_egl_display = EGL_NO_DISPLAY;
      s_egl_context = EGL_NO_CONTEXT;
      s_egl_surface = EGL_NO_SURFACE;
      s_egl_pbuffer_surface = EGL_NO_SURFACE;
      s_egl_config = NULL;
      s_egl_window = NULL;
      s_gl_rect_program = 0u;
      s_gl_shadow_program = 0u;
      s_gl_gradient_program = 0u;
      s_gl_text_program = 0u;
      s_gl_blit_program = 0u;
      s_gl_external_blit_program = 0u;
      s_gl_vbo = 0u;
      s_gl_fbo = 0u;
      s_gl_rect_screen_loc = -1;
      s_gl_rect_color_loc = -1;
      s_gl_rect_rect_loc = -1;
      s_gl_rect_radius_loc = -1;
      s_gl_rect_stroke_width_loc = -1;
      s_gl_shadow_screen_loc = -1;
      s_gl_shadow_color_loc = -1;
      s_gl_shadow_origin_rect_loc = -1;
      s_gl_shadow_rect_loc = -1;
      s_gl_shadow_origin_radius_loc = -1;
      s_gl_shadow_radius_loc = -1;
      s_gl_shadow_blur_loc = -1;
      s_gl_shadow_inset_loc = -1;
      s_gl_gradient_screen_loc = -1;
      s_gl_gradient_start_color_loc = -1;
      s_gl_gradient_end_color_loc = -1;
      s_gl_gradient_rect_loc = -1;
      s_gl_gradient_radius_loc = -1;
      s_gl_gradient_start_loc = -1;
      s_gl_gradient_end_loc = -1;
      s_gl_gradient_kind_loc = -1;
      s_gl_gradient_center_loc = -1;
      s_gl_gradient_outer_radius_loc = -1;
      s_gl_text_screen_loc = -1;
      s_gl_text_color_loc = -1;
      s_gl_text_px_range_loc = -1;
      s_gl_text_atlas_loc = -1;
      s_gl_blit_screen_loc = -1;
      s_gl_blit_texture_loc = -1;
      s_gl_external_blit_screen_loc = -1;
      s_gl_external_blit_texture_loc = -1;
      s_gl_external_blit_tex_transform_loc = -1;
      for (int i = 0; i < CHENG_ANDROID_LAYER_CACHE_CAP; i++) {{
        memset(&s_layer_caches[i], 0, sizeof(s_layer_caches[i]));
      }}
      for (int i = 0; i < CHENG_ANDROID_IMAGE_ATLAS_CACHE_CAP; i++) {{
        s_image_textures[i].gl_texture = 0u;
        s_image_textures[i].gl_uploaded = 0;
      }}
      s_pending_image_texture_delete_count = 0;
      for (int i = 0; i < CHENG_ANDROID_GLYPH_SDF_ATLAS_CACHE_CAP; i++) {{
        free(s_glyph_sdf_atlases[i].gl_textures);
        s_glyph_sdf_atlases[i].gl_textures = NULL;
        s_glyph_sdf_atlases[i].gl_texture_count = 0;
        s_glyph_sdf_atlases[i].gl_tile_height = 0;
        s_glyph_sdf_atlases[i].gl_texture = 0u;
        s_glyph_sdf_atlases[i].gl_uploaded = 0;
      }}
    }}

    static void cheng_android_gpu_ensure(ANativeWindow* window, int width, int height) {{
      if (window == NULL || width <= 0 || height <= 0) {{
        abort();
      }}
      if (s_egl_display == EGL_NO_DISPLAY) {{
        s_egl_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
        cheng_android_gl_abort_if_false(s_egl_display != EGL_NO_DISPLAY, "eglGetDisplay failed");
        cheng_android_gl_abort_if_false(eglInitialize(s_egl_display, NULL, NULL), "eglInitialize failed");
        cheng_android_gl_abort_if_false(eglBindAPI(EGL_OPENGL_ES_API), "eglBindAPI failed");
        const EGLint config_attribs[] = {{
          EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT,
          EGL_SURFACE_TYPE, EGL_WINDOW_BIT | EGL_PBUFFER_BIT,
          EGL_RED_SIZE, 8,
          EGL_GREEN_SIZE, 8,
          EGL_BLUE_SIZE, 8,
          EGL_ALPHA_SIZE, 8,
          EGL_DEPTH_SIZE, 0,
          EGL_STENCIL_SIZE, 0,
          EGL_NONE
        }};
        EGLint config_count = 0;
        cheng_android_gl_abort_if_false(eglChooseConfig(s_egl_display, config_attribs, &s_egl_config, 1, &config_count) && config_count == 1, "eglChooseConfig failed");
        const EGLint context_attribs[] = {{
          EGL_CONTEXT_CLIENT_VERSION, 3,
          EGL_NONE
        }};
        s_egl_context = eglCreateContext(s_egl_display, s_egl_config, EGL_NO_CONTEXT, context_attribs);
        cheng_android_gl_abort_if_false(s_egl_context != EGL_NO_CONTEXT, "eglCreateContext failed");
      }}
      if (s_egl_surface == EGL_NO_SURFACE || s_egl_window != window) {{
        if (s_egl_surface != EGL_NO_SURFACE) {{
          eglDestroySurface(s_egl_display, s_egl_surface);
          s_egl_surface = EGL_NO_SURFACE;
        }}
        s_egl_surface = eglCreateWindowSurface(s_egl_display, s_egl_config, window, NULL);
        cheng_android_gl_abort_if_false(s_egl_surface != EGL_NO_SURFACE, "eglCreateWindowSurface failed");
        s_egl_window = window;
      }}
      cheng_android_gl_abort_if_false(eglMakeCurrent(s_egl_display, s_egl_surface, s_egl_surface, s_egl_context), "eglMakeCurrent failed");
      cheng_android_gpu_init_programs();
      if (s_pending_image_texture_delete_count > 0) {{
        glDeleteTextures(s_pending_image_texture_delete_count, s_pending_image_texture_deletes);
        s_pending_image_texture_delete_count = 0;
      }}
      glViewport(0, 0, width, height);
      glDisable(GL_DEPTH_TEST);
      glDisable(GL_CULL_FACE);
      glEnable(GL_BLEND);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
    }}

    // Headless GPU capture: same EGL display/context/config + program pipeline as the
    // window path, but renders into an offscreen pbuffer at the exact logical size so the
    // result can be read back with glReadPixels and pixel-compared to the React PWA.
    static void cheng_android_gpu_ensure_offscreen(int width, int height) {{
      if (width <= 0 || height <= 0) {{
        abort();
      }}
      if (s_egl_display == EGL_NO_DISPLAY) {{
        s_egl_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
        cheng_android_gl_abort_if_false(s_egl_display != EGL_NO_DISPLAY, "eglGetDisplay failed");
        cheng_android_gl_abort_if_false(eglInitialize(s_egl_display, NULL, NULL), "eglInitialize failed");
        cheng_android_gl_abort_if_false(eglBindAPI(EGL_OPENGL_ES_API), "eglBindAPI failed");
        const EGLint config_attribs[] = {{
          EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT,
          EGL_SURFACE_TYPE, EGL_WINDOW_BIT | EGL_PBUFFER_BIT,
          EGL_RED_SIZE, 8,
          EGL_GREEN_SIZE, 8,
          EGL_BLUE_SIZE, 8,
          EGL_ALPHA_SIZE, 8,
          EGL_DEPTH_SIZE, 0,
          EGL_STENCIL_SIZE, 0,
          EGL_NONE
        }};
        EGLint config_count = 0;
        cheng_android_gl_abort_if_false(eglChooseConfig(s_egl_display, config_attribs, &s_egl_config, 1, &config_count) && config_count == 1, "eglChooseConfig failed");
        const EGLint context_attribs[] = {{
          EGL_CONTEXT_CLIENT_VERSION, 3,
          EGL_NONE
        }};
        s_egl_context = eglCreateContext(s_egl_display, s_egl_config, EGL_NO_CONTEXT, context_attribs);
        cheng_android_gl_abort_if_false(s_egl_context != EGL_NO_CONTEXT, "eglCreateContext failed");
      }}
      if (s_egl_pbuffer_surface == EGL_NO_SURFACE || s_headless_capture_width != width || s_headless_capture_height != height) {{
        if (s_egl_pbuffer_surface != EGL_NO_SURFACE) {{
          eglDestroySurface(s_egl_display, s_egl_pbuffer_surface);
          s_egl_pbuffer_surface = EGL_NO_SURFACE;
        }}
        const EGLint pbuffer_attribs[] = {{ EGL_WIDTH, width, EGL_HEIGHT, height, EGL_NONE }};
        s_egl_pbuffer_surface = eglCreatePbufferSurface(s_egl_display, s_egl_config, pbuffer_attribs);
        cheng_android_gl_abort_if_false(s_egl_pbuffer_surface != EGL_NO_SURFACE, "eglCreatePbufferSurface failed");
        s_headless_capture_width = width;
        s_headless_capture_height = height;
      }}
      cheng_android_gl_abort_if_false(eglMakeCurrent(s_egl_display, s_egl_pbuffer_surface, s_egl_pbuffer_surface, s_egl_context), "eglMakeCurrent pbuffer failed");
      cheng_android_gpu_init_programs();
      if (s_pending_image_texture_delete_count > 0) {{
        glDeleteTextures(s_pending_image_texture_delete_count, s_pending_image_texture_deletes);
        s_pending_image_texture_delete_count = 0;
      }}
      glViewport(0, 0, width, height);
      glDisable(GL_DEPTH_TEST);
      glDisable(GL_CULL_FACE);
      glEnable(GL_BLEND);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
    }}

    // Enable headless capture mode at an exact logical size. After cheng_app_init +
    // set_window + tick (which drives present_compositor_frame into the pbuffer), call
    // cheng_mobile_host_read_offscreen_pixels to read the RGBA back.
    void cheng_mobile_host_begin_offscreen_capture(int width, int height) {{
      s_headless_capture = 1;
      cheng_android_gpu_ensure_offscreen(width, height);
    }}

    int cheng_mobile_host_read_offscreen_pixels(int width, int height, unsigned char* out_rgba) {{
      if (!s_headless_capture || out_rgba == NULL || width <= 0 || height <= 0) {{
        return 0;
      }}
      if (width != s_headless_capture_width || height != s_headless_capture_height) {{
        return 0;
      }}
      glFinish();
      glPixelStorei(GL_PACK_ALIGNMENT, 1);
      glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, out_rgba);
      // glReadPixels origin is bottom-left; flip vertically to top-left row order.
      int row_bytes = width * 4;
      unsigned char* tmp = (unsigned char*)malloc((size_t)row_bytes);
      if (tmp == NULL) {{
        return 0;
      }}
      for (int y = 0; y < height / 2; y++) {{
        unsigned char* top = out_rgba + (size_t)y * (size_t)row_bytes;
        unsigned char* bot = out_rgba + (size_t)(height - 1 - y) * (size_t)row_bytes;
        memcpy(tmp, top, (size_t)row_bytes);
        memcpy(top, bot, (size_t)row_bytes);
        memcpy(bot, tmp, (size_t)row_bytes);
      }}
      free(tmp);
      return 1;
    }}

    void cheng_mobile_host_end_offscreen_capture(void) {{
      if (s_headless_capture) {{
        glFinish();
      }}
      s_headless_capture = 0;
      s_headless_capture_width = 0;
      s_headless_capture_height = 0;
      cheng_android_gpu_destroy();
    }}

    static void cheng_android_gpu_color_from_argb(uint32_t argb, float* rgba) {{
      rgba[0] = (float)((argb >> 16u) & 0xffu) / 255.0f;
      rgba[1] = (float)((argb >> 8u) & 0xffu) / 255.0f;
      rgba[2] = (float)(argb & 0xffu) / 255.0f;
      rgba[3] = (float)((argb >> 24u) & 0xffu) / 255.0f;
    }}

    static int cheng_android_max_int(int a, int b) {{
      return a > b ? a : b;
    }}

    static int cheng_android_min_int(int a, int b) {{
      return a < b ? a : b;
    }}

    static int cheng_android_framebuffer_width_for(int logical_width) {{
      return s_active_width > 0 ? s_active_width : logical_width;
    }}

    static int cheng_android_framebuffer_height_for(int logical_height) {{
      return s_active_height > 0 ? s_active_height : logical_height;
    }}

    static int cheng_android_div_floor_i64(int64_t numerator, int64_t denominator) {{
      if (denominator <= 0) {{
        abort();
      }}
      if (numerator >= 0) {{
        return (int)(numerator / denominator);
      }}
      return (int)(-(((-numerator) + denominator - 1) / denominator));
    }}

    static int cheng_android_div_ceil_i64(int64_t numerator, int64_t denominator) {{
      if (denominator <= 0) {{
        abort();
      }}
      if (numerator >= 0) {{
        return (int)((numerator + denominator - 1) / denominator);
      }}
      return (int)(-((-numerator) / denominator));
    }}

    static int cheng_android_scale_logical_to_framebuffer(int value, int logical_size, int framebuffer_size) {{
      if (logical_size <= 0 || framebuffer_size <= 0) {{
        abort();
      }}
      return cheng_android_div_floor_i64((int64_t)value * (int64_t)framebuffer_size, (int64_t)logical_size);
    }}

    static int cheng_android_scale_logical_to_framebuffer_ceil(int value, int logical_size, int framebuffer_size) {{
      if (logical_size <= 0 || framebuffer_size <= 0) {{
        abort();
      }}
      return cheng_android_div_ceil_i64((int64_t)value * (int64_t)framebuffer_size, (int64_t)logical_size);
    }}

    static void cheng_android_gpu_set_scissor_top_left(int framebuffer_width, int framebuffer_height, int x, int y, int width, int height) {{
      if (framebuffer_width <= 0 || framebuffer_height <= 0 || width < 0 || height < 0) {{
        abort();
      }}
      int left = cheng_android_max_int(0, x);
      int top = cheng_android_max_int(0, y);
      int right = cheng_android_min_int(framebuffer_width, x + width);
      int bottom = cheng_android_min_int(framebuffer_height, y + height);
      if (right < left) {{
        right = left;
      }}
      if (bottom < top) {{
        bottom = top;
      }}
      glEnable(GL_SCISSOR_TEST);
      glScissor(left, framebuffer_height - bottom, right - left, bottom - top);
    }}

    static void cheng_android_gpu_set_scaled_scissor_top_left(int framebuffer_width, int framebuffer_height, int logical_width, int logical_height, int x, int y, int width, int height) {{
      if (framebuffer_width <= 0 || framebuffer_height <= 0 || logical_width <= 0 || logical_height <= 0 || width < 0 || height < 0) {{
        abort();
      }}
      int left = cheng_android_scale_logical_to_framebuffer(x, logical_width, framebuffer_width);
      int top = cheng_android_scale_logical_to_framebuffer(y, logical_height, framebuffer_height);
      int right = cheng_android_scale_logical_to_framebuffer_ceil(x + width, logical_width, framebuffer_width);
      int bottom = cheng_android_scale_logical_to_framebuffer_ceil(y + height, logical_height, framebuffer_height);
      cheng_android_gpu_set_scissor_top_left(framebuffer_width, framebuffer_height, left, top, right - left, bottom - top);
    }}

    static void cheng_android_gpu_intersect_clip(int* clip_x, int* clip_y, int* clip_w, int* clip_h, int rect_x, int rect_y, int rect_w, int rect_h) {{
      if (clip_x == NULL || clip_y == NULL || clip_w == NULL || clip_h == NULL || rect_w <= 0 || rect_h <= 0) {{
        abort();
      }}
      int next_x = cheng_android_max_int(*clip_x, rect_x);
      int next_y = cheng_android_max_int(*clip_y, rect_y);
      int next_right = cheng_android_min_int(*clip_x + *clip_w, rect_x + rect_w);
      int next_bottom = cheng_android_min_int(*clip_y + *clip_h, rect_y + rect_h);
      *clip_x = next_x;
      *clip_y = next_y;
      *clip_w = next_right - next_x;
      *clip_h = next_bottom - next_y;
      if (*clip_w < 0) {{
        *clip_w = 0;
      }}
      if (*clip_h < 0) {{
        *clip_h = 0;
      }}
    }}

    static int cheng_android_clip_layer_rect_to_viewport(int logical_width,
                                                         int logical_height,
                                                         int offset_x,
                                                         int offset_y,
                                                         int* x,
                                                         int* y,
                                                         int* w,
                                                         int* h) {{
      if (logical_width <= 0 || logical_height <= 0 || x == NULL || y == NULL || w == NULL || h == NULL || *w < 0 || *h < 0) {{
        abort();
      }}
      if (*w == 0 || *h == 0) {{
        return 0;
      }}
      int viewport_x = 0 - offset_x;
      int viewport_y = 0 - offset_y;
      int viewport_right = viewport_x + logical_width;
      int viewport_bottom = viewport_y + logical_height;
      int left = *x;
      int top = *y;
      int right = *x + *w;
      int bottom = *y + *h;
      if (viewport_x > left) {{
        left = viewport_x;
      }}
      if (viewport_y > top) {{
        top = viewport_y;
      }}
      if (viewport_right < right) {{
        right = viewport_right;
      }}
      if (viewport_bottom < bottom) {{
        bottom = viewport_bottom;
      }}
      if (right <= left || bottom <= top) {{
        *x = left;
        *y = top;
        *w = 0;
        *h = 0;
        return 0;
      }}
      *x = left;
      *y = top;
      *w = right - left;
      *h = bottom - top;
      return 1;
    }}

    static void cheng_android_gpu_draw_rect_shape(int screen_width, int screen_height, int x, int y, int width, int height, uint32_t argb, int radius, int stroke_width) {{
      if (width <= 0 || height <= 0) {{
        return;
      }}
      float x0 = (float)x;
      float y0 = (float)y;
      float x1 = (float)(x + width);
      float y1 = (float)(y + height);
      const float vertices[] = {{
        x0, y0, x1, y0, x0, y1,
        x1, y0, x1, y1, x0, y1
      }};
      float color[4];
      cheng_android_gpu_color_from_argb(argb, color);
      int clipped_radius = radius < 0 ? 0 : radius;
      int clipped_stroke_width = stroke_width < 0 ? 0 : stroke_width;
      glUseProgram(s_gl_rect_program);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
      glUniform2f(s_gl_rect_screen_loc, (float)screen_width, (float)screen_height);
      glUniform4f(s_gl_rect_color_loc, color[0], color[1], color[2], color[3]);
      glUniform4f(s_gl_rect_rect_loc, (float)x, (float)y, (float)width, (float)height);
      glUniform1f(s_gl_rect_radius_loc, (float)clipped_radius);
      glUniform1f(s_gl_rect_stroke_width_loc, (float)clipped_stroke_width);
      glBindBuffer(GL_ARRAY_BUFFER, s_gl_vbo);
      glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)sizeof(vertices), vertices, GL_STREAM_DRAW);
      glEnableVertexAttribArray(0);
      glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, (GLsizei)(2 * sizeof(float)), (const void*)0);
      glDrawArrays(GL_TRIANGLES, 0, 6);
    }}

    static void cheng_android_gpu_draw_rect(int screen_width, int screen_height, int x, int y, int width, int height, uint32_t argb, int radius) {{
      cheng_android_gpu_draw_rect_shape(screen_width, screen_height, x, y, width, height, argb, radius, 0);
    }}

    static void cheng_android_gpu_draw_stroke_rect(int screen_width, int screen_height, int x, int y, int width, int height, uint32_t argb, int radius) {{
      cheng_android_gpu_draw_rect_shape(screen_width, screen_height, x, y, width, height, argb, radius, 1);
    }}

    static void cheng_android_gpu_draw_svg_circle_pattern(int screen_width, int screen_height, int x, int y, int width, int height, uint32_t argb, int tile_width, int tile_height, int circle_cx, int circle_cy, int circle_radius) {{
      if (screen_width <= 0 || screen_height <= 0 || width <= 0 || height <= 0 || tile_width <= 0 || tile_height <= 0 || circle_cx < 0 || circle_cy < 0 || circle_radius <= 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "svg_circle_pattern invalid args screen=%dx%d rect=%d,%d,%d,%d tile=%dx%d circle=%d,%d r=%d",
                            screen_width, screen_height, x, y, width, height, tile_width, tile_height, circle_cx, circle_cy, circle_radius);
        abort();
      }}
      int dot_size = circle_radius * 2;
      if (dot_size <= 0) {{
        abort();
      }}
      int max_y = y + height;
      int max_x = x + width;
      for (int cy = y + circle_cy; cy < max_y; cy += tile_height) {{
        for (int cx = x + circle_cx; cx < max_x; cx += tile_width) {{
          cheng_android_gpu_draw_rect(screen_width, screen_height, cx - circle_radius, cy - circle_radius, dot_size, dot_size, argb, circle_radius);
        }}
      }}
    }}

    static void cheng_android_gpu_draw_box_shadow(int screen_width, int screen_height, int x, int y, int width, int height, int offset_x, int offset_y, int blur, int spread, int radius, int inset, uint32_t argb) {{
      if (screen_width <= 0 || screen_height <= 0 || blur < 0) {{
        abort();
      }}
      if (width <= 0 || height <= 0) {{
        return;
      }}
      int shadow_x = x + offset_x - spread;
      int shadow_y = y + offset_y - spread;
      int shadow_w = width + spread * 2;
      int shadow_h = height + spread * 2;
      if (inset != 0) {{
        shadow_x = x + offset_x + spread;
        shadow_y = y + offset_y + spread;
        shadow_w = width - spread * 2;
        shadow_h = height - spread * 2;
      }}
      if (shadow_w <= 0 || shadow_h <= 0) {{
        return;
      }}
      int quad_x = shadow_x - blur;
      int quad_y = shadow_y - blur;
      int quad_w = shadow_w + blur * 2;
      int quad_h = shadow_h + blur * 2;
      if (inset != 0) {{
        quad_x = x;
        quad_y = y;
        quad_w = width;
        quad_h = height;
      }}
      if (quad_w <= 0 || quad_h <= 0) {{
        return;
      }}
      float x0 = (float)quad_x;
      float y0 = (float)quad_y;
      float x1 = (float)(quad_x + quad_w);
      float y1 = (float)(quad_y + quad_h);
      const float vertices[] = {{
        x0, y0, x1, y0, x0, y1,
        x1, y0, x1, y1, x0, y1
      }};
      float color[4];
      cheng_android_gpu_color_from_argb(argb, color);
      int origin_radius = radius < 0 ? 0 : radius;
      int shadow_radius = inset != 0 ? radius - spread : radius + spread;
      if (shadow_radius < 0) {{
        shadow_radius = 0;
      }}
      glUseProgram(s_gl_shadow_program);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
      glUniform2f(s_gl_shadow_screen_loc, (float)screen_width, (float)screen_height);
      glUniform4f(s_gl_shadow_color_loc, color[0], color[1], color[2], color[3]);
      glUniform4f(s_gl_shadow_origin_rect_loc, (float)x, (float)y, (float)width, (float)height);
      glUniform4f(s_gl_shadow_rect_loc, (float)shadow_x, (float)shadow_y, (float)shadow_w, (float)shadow_h);
      glUniform1f(s_gl_shadow_origin_radius_loc, (float)origin_radius);
      glUniform1f(s_gl_shadow_radius_loc, (float)shadow_radius);
      glUniform1f(s_gl_shadow_blur_loc, (float)blur);
      glUniform1f(s_gl_shadow_inset_loc, inset != 0 ? 1.0f : 0.0f);
      glBindBuffer(GL_ARRAY_BUFFER, s_gl_vbo);
      glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)sizeof(vertices), vertices, GL_STREAM_DRAW);
      glEnableVertexAttribArray(0);
      glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, (GLsizei)(2 * sizeof(float)), (const void*)0);
      glDrawArrays(GL_TRIANGLES, 0, 6);
    }}

    static int cheng_android_gpu_gradient_points(int x, int y, int width, int height, int angle, float* start_x, float* start_y, float* end_x, float* end_y) {{
      // CSS gradient angle (0deg = to top, clockwise). Screen y is down, so the
      // direction unit vector is (sin a, -cos a). The gradient line passes through the
      // box center with length |W*sin a| + |H*cos a| (covers all corners), matching the
      // 8 keyword directions exactly while supporting arbitrary degrees.
      double a = (double)angle * 3.14159265358979323846 / 180.0;
      double dirx = sin(a);
      double diry = -cos(a);
      double cx = (double)x + (double)width * 0.5;
      double cy = (double)y + (double)height * 0.5;
      double len = fabs((double)width * dirx) + fabs((double)height * diry);
      double half = len * 0.5;
      *start_x = (float)(cx - dirx * half);
      *start_y = (float)(cy - diry * half);
      *end_x = (float)(cx + dirx * half);
      *end_y = (float)(cy + diry * half);
      return 1;
    }}

    static void cheng_android_gpu_draw_linear_gradient(int screen_width, int screen_height, int x, int y, int width, int height, uint32_t start_argb, uint32_t end_argb, int angle, int radius, int gradient_kind, int center_x_permille, int center_y_permille, int radius_permille) {{
      if (screen_width <= 0 || screen_height <= 0) {{
        abort();
      }}
      if (width <= 0 || height <= 0) {{
        return;
      }}
      float gradient_start_x = 0.0f;
      float gradient_start_y = 0.0f;
      float gradient_end_x = 0.0f;
      float gradient_end_y = 0.0f;
      if (!cheng_android_gpu_gradient_points(x, y, width, height, angle, &gradient_start_x, &gradient_start_y, &gradient_end_x, &gradient_end_y)) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "unsupported gradient angle=%d", angle);
        abort();
      }}
      // Radial gradient: center is a permille of the box, outer radius a permille of
      // the box diagonal (CSS radial-gradient default extent ~farthest-corner).
      float center_px = (float)x + (float)width * ((float)center_x_permille / 1000.0f);
      float center_py = (float)y + (float)height * ((float)center_y_permille / 1000.0f);
      float diag = sqrtf((float)width * (float)width + (float)height * (float)height);
      float outer_radius = diag * ((float)radius_permille / 1000.0f);
      float x0 = (float)x;
      float y0 = (float)y;
      float x1 = (float)(x + width);
      float y1 = (float)(y + height);
      const float vertices[] = {{
        x0, y0, x1, y0, x0, y1,
        x1, y0, x1, y1, x0, y1
      }};
      float start_color[4];
      float end_color[4];
      cheng_android_gpu_color_from_argb(start_argb, start_color);
      cheng_android_gpu_color_from_argb(end_argb, end_color);
      int clipped_radius = radius < 0 ? 0 : radius;
      glUseProgram(s_gl_gradient_program);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
      glUniform2f(s_gl_gradient_screen_loc, (float)screen_width, (float)screen_height);
      glUniform4f(s_gl_gradient_start_color_loc, start_color[0], start_color[1], start_color[2], start_color[3]);
      glUniform4f(s_gl_gradient_end_color_loc, end_color[0], end_color[1], end_color[2], end_color[3]);
      glUniform4f(s_gl_gradient_rect_loc, (float)x, (float)y, (float)width, (float)height);
      glUniform1f(s_gl_gradient_radius_loc, (float)clipped_radius);
      glUniform2f(s_gl_gradient_start_loc, gradient_start_x, gradient_start_y);
      glUniform2f(s_gl_gradient_end_loc, gradient_end_x, gradient_end_y);
      glUniform1i(s_gl_gradient_kind_loc, gradient_kind);
      glUniform2f(s_gl_gradient_center_loc, center_px, center_py);
      glUniform1f(s_gl_gradient_outer_radius_loc, outer_radius);
      glBindBuffer(GL_ARRAY_BUFFER, s_gl_vbo);
      glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)sizeof(vertices), vertices, GL_STREAM_DRAW);
      glEnableVertexAttribArray(0);
      glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, (GLsizei)(2 * sizeof(float)), (const void*)0);
      glDrawArrays(GL_TRIANGLES, 0, 6);
    }}

    static int cheng_android_normalize_video_rotation_degrees(int rotation_degrees);

    static void cheng_android_media_source_display_size(int source_width, int source_height, int rotation_degrees, int* out_width, int* out_height) {{
      if (source_width <= 0 || source_height <= 0 || out_width == NULL || out_height == NULL) {{
        abort();
      }}
      int rotation = cheng_android_normalize_video_rotation_degrees(rotation_degrees);
      if (rotation == 90 || rotation == 270) {{
        *out_width = source_height;
        *out_height = source_width;
      }} else {{
        *out_width = source_width;
        *out_height = source_height;
      }}
    }}

    static float cheng_android_clamp_unit_float(float value) {{
      if (value < 0.0f) {{
        return 0.0f;
      }}
      if (value > 1.0f) {{
        return 1.0f;
      }}
      return value;
    }}

    static void cheng_android_media_object_fit_rect(int source_width, int source_height, int rotation_degrees, int object_fit, int x, int y, int width, int height, int* out_x, int* out_y, int* out_width, int* out_height, float* out_left_u, float* out_right_u, float* out_top_v, float* out_bottom_v) {{
      if (source_width <= 0 || source_height <= 0 || width <= 0 || height <= 0 ||
          out_x == NULL || out_y == NULL || out_width == NULL || out_height == NULL ||
          out_left_u == NULL || out_right_u == NULL || out_top_v == NULL || out_bottom_v == NULL) {{
        abort();
      }}
      int display_source_width = 0;
      int display_source_height = 0;
      cheng_android_media_source_display_size(source_width, source_height, rotation_degrees, &display_source_width, &display_source_height);
      *out_x = x;
      *out_y = y;
      *out_width = width;
      *out_height = height;
      *out_left_u = 0.0f;
      *out_right_u = 1.0f;
      *out_top_v = 0.0f;
      *out_bottom_v = 1.0f;
      if (object_fit == CHENG_ANDROID_MEDIA_OBJECT_FIT_FILL) {{
        return;
      }}
      if (object_fit == CHENG_ANDROID_MEDIA_OBJECT_FIT_CONTAIN) {{
        if ((int64_t)display_source_width * (int64_t)height > (int64_t)width * (int64_t)display_source_height) {{
          int fitted_height = (int)(((int64_t)width * (int64_t)display_source_height) / (int64_t)display_source_width);
          if (fitted_height <= 0) fitted_height = 1;
          *out_y = y + ((height - fitted_height) / 2);
          *out_height = fitted_height;
        }} else {{
          int fitted_width = (int)(((int64_t)height * (int64_t)display_source_width) / (int64_t)display_source_height);
          if (fitted_width <= 0) fitted_width = 1;
          *out_x = x + ((width - fitted_width) / 2);
          *out_width = fitted_width;
        }}
        return;
      }}
      if (object_fit != CHENG_ANDROID_MEDIA_OBJECT_FIT_COVER) {{
        abort();
      }}
      float display_crop_horizontal = 0.0f;
      float display_crop_vertical = 0.0f;
      if ((int64_t)display_source_width * (int64_t)height > (int64_t)width * (int64_t)display_source_height) {{
        float visible = ((float)width * (float)display_source_height) / ((float)display_source_width * (float)height);
        display_crop_horizontal = (1.0f - cheng_android_clamp_unit_float(visible)) * 0.5f;
      }} else {{
        float visible = ((float)display_source_width * (float)height) / ((float)width * (float)display_source_height);
        display_crop_vertical = (1.0f - cheng_android_clamp_unit_float(visible)) * 0.5f;
      }}
      int rotation = cheng_android_normalize_video_rotation_degrees(rotation_degrees);
      float crop_u = display_crop_horizontal;
      float crop_v = display_crop_vertical;
      if (rotation == 90 || rotation == 270) {{
        crop_u = display_crop_vertical;
        crop_v = display_crop_horizontal;
      }}
      *out_left_u = crop_u;
      *out_right_u = 1.0f - crop_u;
      *out_top_v = crop_v;
      *out_bottom_v = 1.0f - crop_v;
    }}

    static void cheng_android_gpu_draw_texture_uv_rect(int screen_width, int screen_height, GLuint texture, int x, int y, int width, int height, float left_u, float top_v, float right_u, float bottom_v) {{
      if (screen_width <= 0 || screen_height <= 0 || texture == 0u) {{
        abort();
      }}
      if (width <= 0 || height <= 0) {{
        return;
      }}
      float x0 = (float)x;
      float y0 = (float)y;
      float x1 = (float)(x + width);
      float y1 = (float)(y + height);
      const float vertices[] = {{
        x0, y0, left_u, top_v,
        x1, y0, right_u, top_v,
        x0, y1, left_u, bottom_v,
        x1, y0, right_u, top_v,
        x1, y1, right_u, bottom_v,
        x0, y1, left_u, bottom_v
      }};
      glUseProgram(s_gl_blit_program);
      glBlendFuncSeparate(GL_ONE, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
      glUniform2f(s_gl_blit_screen_loc, (float)screen_width, (float)screen_height);
      glActiveTexture(GL_TEXTURE0);
      glBindTexture(GL_TEXTURE_2D, texture);
      glUniform1i(s_gl_blit_texture_loc, 0);
      glBindBuffer(GL_ARRAY_BUFFER, s_gl_vbo);
      glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)sizeof(vertices), vertices, GL_STREAM_DRAW);
      glEnableVertexAttribArray(0);
      glEnableVertexAttribArray(1);
      glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, (GLsizei)(4 * sizeof(float)), (const void*)0);
      glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, (GLsizei)(4 * sizeof(float)), (const void*)(2 * sizeof(float)));
      glDrawArrays(GL_TRIANGLES, 0, 6);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
    }}

    static void cheng_android_gpu_draw_texture_uv(int screen_width, int screen_height, GLuint texture, int x, int y, int width, int height, int flip_y) {{
      float top_v = flip_y ? 1.0f : 0.0f;
      float bottom_v = flip_y ? 0.0f : 1.0f;
      cheng_android_gpu_draw_texture_uv_rect(screen_width, screen_height, texture, x, y, width, height, 0.0f, top_v, 1.0f, bottom_v);
    }}

    static void cheng_android_gpu_draw_texture(int screen_width, int screen_height, GLuint texture, int x, int y, int width, int height) {{
      cheng_android_gpu_draw_texture_uv(screen_width, screen_height, texture, x, y, width, height, 0);
    }}

    static void cheng_android_gpu_draw_texture_object_fit(int screen_width, int screen_height, GLuint texture, int x, int y, int width, int height, int source_width, int source_height, int object_fit) {{
      int draw_x = x;
      int draw_y = y;
      int draw_width = width;
      int draw_height = height;
      float left_u = 0.0f;
      float right_u = 1.0f;
      float top_v = 0.0f;
      float bottom_v = 1.0f;
      cheng_android_media_object_fit_rect(source_width, source_height, 0, object_fit, x, y, width, height, &draw_x, &draw_y, &draw_width, &draw_height, &left_u, &right_u, &top_v, &bottom_v);
      cheng_android_gpu_draw_texture_uv_rect(screen_width, screen_height, texture, draw_x, draw_y, draw_width, draw_height, left_u, top_v, right_u, bottom_v);
    }}

    static void cheng_android_texture_transform_identity(float* out_transform) {{
      if (out_transform == NULL) {{
        abort();
      }}
      for (int i = 0; i < 16; i++) {{
        out_transform[i] = 0.0f;
      }}
      out_transform[0] = 1.0f;
      out_transform[5] = 1.0f;
      out_transform[10] = 1.0f;
      out_transform[15] = 1.0f;
    }}

    static int cheng_android_normalize_video_rotation_degrees(int rotation_degrees) {{
      int normalized = rotation_degrees % 360;
      if (normalized < 0) {{
        normalized += 360;
      }}
      if (normalized == 90 || normalized == 180 || normalized == 270) {{
        return normalized;
      }}
      return 0;
    }}

    static void cheng_android_rotated_uv(float u, float v, int rotation_degrees, float* out_u, float* out_v) {{
      if (out_u == NULL || out_v == NULL) {{
        abort();
      }}
      int rotation = cheng_android_normalize_video_rotation_degrees(rotation_degrees);
      if (rotation == 90) {{
        *out_u = v;
        *out_v = 1.0f - u;
      }} else if (rotation == 180) {{
        *out_u = 1.0f - u;
        *out_v = 1.0f - v;
      }} else if (rotation == 270) {{
        *out_u = 1.0f - v;
        *out_v = u;
      }} else {{
        *out_u = u;
        *out_v = v;
      }}
    }}

    static void cheng_android_gpu_draw_external_texture(int screen_width, int screen_height, GLuint texture, int x, int y, int width, int height, const float* texture_transform, int rotation_degrees) {{
      if (screen_width <= 0 || screen_height <= 0 || texture == 0u) {{
        abort();
      }}
      if (width <= 0 || height <= 0) {{
        return;
      }}
      float x0 = (float)x;
      float y0 = (float)y;
      float x1 = (float)(x + width);
      float y1 = (float)(y + height);
      float uv00_u = 0.0f;
      float uv00_v = 1.0f;
      float uv10_u = 1.0f;
      float uv10_v = 1.0f;
      float uv01_u = 0.0f;
      float uv01_v = 0.0f;
      float uv11_u = 1.0f;
      float uv11_v = 0.0f;
      cheng_android_rotated_uv(0.0f, 1.0f, rotation_degrees, &uv00_u, &uv00_v);
      cheng_android_rotated_uv(1.0f, 1.0f, rotation_degrees, &uv10_u, &uv10_v);
      cheng_android_rotated_uv(0.0f, 0.0f, rotation_degrees, &uv01_u, &uv01_v);
      cheng_android_rotated_uv(1.0f, 0.0f, rotation_degrees, &uv11_u, &uv11_v);
      const float vertices[] = {{
        x0, y0, uv00_u, uv00_v,
        x1, y0, uv10_u, uv10_v,
        x0, y1, uv01_u, uv01_v,
        x1, y0, uv10_u, uv10_v,
        x1, y1, uv11_u, uv11_v,
        x0, y1, uv01_u, uv01_v
      }};
      glUseProgram(s_gl_external_blit_program);
      glBlendFuncSeparate(GL_ONE, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
      glUniform2f(s_gl_external_blit_screen_loc, (float)screen_width, (float)screen_height);
      glActiveTexture(GL_TEXTURE0);
      glBindTexture(GL_TEXTURE_EXTERNAL_OES, texture);
      glUniform1i(s_gl_external_blit_texture_loc, 0);
      float identity_transform[16];
      const float* transform = texture_transform;
      if (transform == NULL) {{
        cheng_android_texture_transform_identity(identity_transform);
        transform = identity_transform;
      }}
      glUniformMatrix4fv(s_gl_external_blit_tex_transform_loc, 1, GL_FALSE, transform);
      glBindBuffer(GL_ARRAY_BUFFER, s_gl_vbo);
      glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)sizeof(vertices), vertices, GL_STREAM_DRAW);
      glEnableVertexAttribArray(0);
      glEnableVertexAttribArray(1);
      glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, (GLsizei)(4 * sizeof(float)), (const void*)0);
      glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, (GLsizei)(4 * sizeof(float)), (const void*)(2 * sizeof(float)));
      glDrawArrays(GL_TRIANGLES, 0, 6);
      glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0u);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
    }}

    static void cheng_android_gpu_draw_external_texture_object_fit(int screen_width, int screen_height, GLuint texture, int x, int y, int width, int height, int source_width, int source_height, int object_fit, const float* texture_transform, int rotation_degrees) {{
      if (screen_width <= 0 || screen_height <= 0 || texture == 0u) {{
        abort();
      }}
      if (width <= 0 || height <= 0) {{
        return;
      }}
      int draw_x = x;
      int draw_y = y;
      int draw_width = width;
      int draw_height = height;
      float left_u = 0.0f;
      float right_u = 1.0f;
      float top_v = 0.0f;
      float bottom_v = 1.0f;
      cheng_android_media_object_fit_rect(source_width, source_height, rotation_degrees, object_fit, x, y, width, height, &draw_x, &draw_y, &draw_width, &draw_height, &left_u, &right_u, &top_v, &bottom_v);
      float oes_top_v = 1.0f - top_v;
      float oes_bottom_v = 1.0f - bottom_v;
      float x0 = (float)draw_x;
      float y0 = (float)draw_y;
      float x1 = (float)(draw_x + draw_width);
      float y1 = (float)(draw_y + draw_height);
      float uv00_u = left_u;
      float uv00_v = oes_top_v;
      float uv10_u = right_u;
      float uv10_v = oes_top_v;
      float uv01_u = left_u;
      float uv01_v = oes_bottom_v;
      float uv11_u = right_u;
      float uv11_v = oes_bottom_v;
      cheng_android_rotated_uv(left_u, oes_top_v, rotation_degrees, &uv00_u, &uv00_v);
      cheng_android_rotated_uv(right_u, oes_top_v, rotation_degrees, &uv10_u, &uv10_v);
      cheng_android_rotated_uv(left_u, oes_bottom_v, rotation_degrees, &uv01_u, &uv01_v);
      cheng_android_rotated_uv(right_u, oes_bottom_v, rotation_degrees, &uv11_u, &uv11_v);
      const float vertices[] = {{
        x0, y0, uv00_u, uv00_v,
        x1, y0, uv10_u, uv10_v,
        x0, y1, uv01_u, uv01_v,
        x1, y0, uv10_u, uv10_v,
        x1, y1, uv11_u, uv11_v,
        x0, y1, uv01_u, uv01_v
      }};
      glUseProgram(s_gl_external_blit_program);
      glBlendFuncSeparate(GL_ONE, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
      glUniform2f(s_gl_external_blit_screen_loc, (float)screen_width, (float)screen_height);
      glActiveTexture(GL_TEXTURE0);
      glBindTexture(GL_TEXTURE_EXTERNAL_OES, texture);
      glUniform1i(s_gl_external_blit_texture_loc, 0);
      float identity_transform[16];
      const float* transform = texture_transform;
      if (transform == NULL) {{
        cheng_android_texture_transform_identity(identity_transform);
        transform = identity_transform;
      }}
      glUniformMatrix4fv(s_gl_external_blit_tex_transform_loc, 1, GL_FALSE, transform);
      glBindBuffer(GL_ARRAY_BUFFER, s_gl_vbo);
      glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)sizeof(vertices), vertices, GL_STREAM_DRAW);
      glEnableVertexAttribArray(0);
      glEnableVertexAttribArray(1);
      glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, (GLsizei)(4 * sizeof(float)), (const void*)0);
      glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, (GLsizei)(4 * sizeof(float)), (const void*)(2 * sizeof(float)));
      glDrawArrays(GL_TRIANGLES, 0, 6);
      glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0u);
      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
    }}

    static void cheng_android_gpu_draw_framebuffer_texture(int screen_width, int screen_height, GLuint texture, int x, int y, int width, int height) {{
      cheng_android_gpu_draw_texture_uv(screen_width, screen_height, texture, x, y, width, height, 1);
    }}

    static ChengAndroidImageTextureCache* cheng_android_find_image_texture(int texture_id) {{
      if (texture_id <= 0) {{
        return NULL;
      }}
      for (int i = 0; i < CHENG_ANDROID_IMAGE_ATLAS_CACHE_CAP; i++) {{
        if (s_image_textures[i].valid && s_image_textures[i].texture_id == texture_id) {{
          return &s_image_textures[i];
        }}
      }}
      return NULL;
    }}

    static int cheng_android_image_texture_uploaded(int texture_id) {{
      return cheng_android_find_image_texture(texture_id) != NULL;
    }}

    static void cheng_android_gpu_upload_image_texture(ChengAndroidImageTextureCache* texture) {{
      if (texture == NULL || !texture->valid || texture->pixels == NULL || texture->width <= 0 || texture->height <= 0 || texture->pixel_count != texture->width * texture->height) {{
        abort();
      }}
      if (texture->gl_texture == 0u) {{
        glGenTextures(1, &texture->gl_texture);
        cheng_android_gl_abort_if_false(texture->gl_texture != 0u, "glGenTextures image failed");
      }}
      glBindTexture(GL_TEXTURE_2D, texture->gl_texture);
      glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, texture->width, texture->height, 0, GL_RGBA, GL_UNSIGNED_BYTE, texture->pixels);
      glGenerateMipmap(GL_TEXTURE_2D);
      texture->gl_uploaded = 1;
    }}

	    static void cheng_android_gpu_draw_image_texture(int screen_width, int screen_height, int x, int y, int width, int height, int texture_id) {{
	      if (screen_width <= 0 || screen_height <= 0 || width <= 0 || height <= 0 || texture_id <= 0) {{
	        abort();
	      }}
      ChengAndroidImageTextureCache* texture = cheng_android_find_image_texture(texture_id);
      if (texture == NULL || texture->pixels == NULL) {{
        abort();
      }}
      if (!texture->gl_uploaded || texture->gl_texture == 0u) {{
        cheng_android_gpu_upload_image_texture(texture);
	      }}
	      cheng_android_gpu_draw_texture(screen_width, screen_height, texture->gl_texture, x, y, width, height);
	    }}

	    static int cheng_android_state_image_texture_id(const char* state_ref) {{
	      if (state_ref == NULL || state_ref[0] == '\0') {{
	        return -1;
	      }}
	      uint64_t hash = 216613626u;
	      const char* prefix = "image.state.";
	      for (const unsigned char* p = (const unsigned char*)prefix; *p != 0u; p++) {{
	        hash = (hash * 16777619u + (uint64_t)(*p)) & 2147483647u;
	      }}
	      for (const unsigned char* p = (const unsigned char*)state_ref; *p != 0u; p++) {{
	        hash = (hash * 16777619u + (uint64_t)(*p)) & 2147483647u;
	      }}
	      int out = (int)hash;
	      if (out <= 0) {{
	        return 1;
	      }}
	      return out;
	    }}

	    static int cheng_android_install_dynamic_image_texture(int texture_id, int width, int height, const jint* argb_pixels) {{
	      if (texture_id <= 0 || width <= 0 || height <= 0 || argb_pixels == NULL) {{
	        return 0;
	      }}
	      int64_t pixel_count_i64 = (int64_t)width * (int64_t)height;
	      if (pixel_count_i64 <= 0 || pixel_count_i64 > 33554432LL) {{
	        return 0;
	      }}
	      int pixel_count = (int)pixel_count_i64;
	      uint8_t* rgba = (uint8_t*)malloc((size_t)pixel_count * 4u);
	      if (rgba == NULL) {{
	        return 0;
	      }}
	      for (int pixel_index = 0; pixel_index < pixel_count; pixel_index++) {{
	        uint32_t argb = (uint32_t)argb_pixels[pixel_index];
	        uint32_t alpha = (argb >> 24u) & 0xffu;
	        uint32_t red = (argb >> 16u) & 0xffu;
	        uint32_t green = (argb >> 8u) & 0xffu;
	        uint32_t blue = argb & 0xffu;
	        size_t byte_index = (size_t)pixel_index * 4u;
	        rgba[byte_index + 0u] = (uint8_t)((red * alpha + 127u) / 255u);
	        rgba[byte_index + 1u] = (uint8_t)((green * alpha + 127u) / 255u);
	        rgba[byte_index + 2u] = (uint8_t)((blue * alpha + 127u) / 255u);
	        rgba[byte_index + 3u] = (uint8_t)alpha;
	      }}
	      int slot = -1;
	      for (int i = 0; i < CHENG_ANDROID_IMAGE_ATLAS_CACHE_CAP; i++) {{
	        if (s_image_textures[i].valid && s_image_textures[i].texture_id == texture_id) {{
	          slot = i;
	          break;
	        }}
	      }}
	      if (slot < 0) {{
	        for (int i = 0; i < CHENG_ANDROID_IMAGE_ATLAS_CACHE_CAP; i++) {{
	          if (!s_image_textures[i].valid) {{
	            slot = i;
	            break;
	          }}
	        }}
	      }}
	      if (slot < 0) {{
	        free(rgba);
	        return 0;
	      }}
	      if (s_image_textures[slot].gl_texture != 0u) {{
	        if (s_pending_image_texture_delete_count >= CHENG_ANDROID_IMAGE_ATLAS_CACHE_CAP) {{
	          free(rgba);
	          abort();
	        }}
	        s_pending_image_texture_deletes[s_pending_image_texture_delete_count] = s_image_textures[slot].gl_texture;
	        s_pending_image_texture_delete_count++;
	      }}
	      free(s_image_textures[slot].pixels);
	      memset(&s_image_textures[slot], 0, sizeof(s_image_textures[slot]));
	      s_image_textures[slot].valid = 1;
	      s_image_textures[slot].texture_id = texture_id;
	      s_image_textures[slot].width = width;
	      s_image_textures[slot].height = height;
	      s_image_textures[slot].pixel_count = pixel_count;
	      s_image_textures[slot].pixels = rgba;
	      s_image_textures[slot].dynamic_texture = 1;
	      return 1;
	    }}

	    static jboolean native_install_dynamic_image_texture(JNIEnv* env, jobject thiz, jlong handle, jstring state_ref, jint width, jint height, jintArray pixels) {{
	      thiz = thiz;
	      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)(uintptr_t)handle;
	      if (runtime == NULL || runtime->app_id == 0u || state_ref == NULL || pixels == NULL || width <= 0 || height <= 0) {{
	        return JNI_FALSE;
	      }}
	      jsize pixel_len = (*env)->GetArrayLength(env, pixels);
	      int64_t expected = (int64_t)width * (int64_t)height;
	      if (expected <= 0 || expected != (int64_t)pixel_len) {{
	        return JNI_FALSE;
	      }}
	      const char* stateRefRaw = (*env)->GetStringUTFChars(env, state_ref, NULL);
	      if (stateRefRaw == NULL) {{
	        return JNI_FALSE;
	      }}
	      int texture_id = cheng_android_state_image_texture_id(stateRefRaw);
	      jint* rawPixels = (*env)->GetIntArrayElements(env, pixels, NULL);
	      if (rawPixels == NULL) {{
	        (*env)->ReleaseStringUTFChars(env, state_ref, stateRefRaw);
	        return JNI_FALSE;
	      }}
	      int ok = cheng_android_install_dynamic_image_texture(texture_id, width, height, rawPixels);
	      (*env)->ReleaseIntArrayElements(env, pixels, rawPixels, JNI_ABORT);
	      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
	                          "install_dynamic_image state_ref=%s texture_id=%d size=%dx%d ok=%d",
	                          stateRefRaw, texture_id, width, height, ok);
	      (*env)->ReleaseStringUTFChars(env, state_ref, stateRefRaw);
	      return ok != 0 ? JNI_TRUE : JNI_FALSE;
	    }}

	    static jboolean native_append_string_array_state(JNIEnv* env, jobject thiz, jlong handle, jstring state_ref, jstring value) {{
	      thiz = thiz;
	      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)(uintptr_t)handle;
	      if (runtime == NULL || runtime->app_id == 0u || s_runtime_append_string_array_state == NULL || state_ref == NULL || value == NULL) {{
	        return JNI_FALSE;
	      }}
	      const char* stateRefRaw = (*env)->GetStringUTFChars(env, state_ref, NULL);
	      if (stateRefRaw == NULL) {{
	        return JNI_FALSE;
	      }}
	      const char* valueRaw = (*env)->GetStringUTFChars(env, value, NULL);
	      if (valueRaw == NULL) {{
	        (*env)->ReleaseStringUTFChars(env, state_ref, stateRefRaw);
	        return JNI_FALSE;
	      }}
	      int ok = s_runtime_append_string_array_state(stateRefRaw, valueRaw);
	      (*env)->ReleaseStringUTFChars(env, value, valueRaw);
	      (*env)->ReleaseStringUTFChars(env, state_ref, stateRefRaw);
	      return ok != 0 ? JNI_TRUE : JNI_FALSE;
	    }}

	    static jboolean native_apply_media_selection(JNIEnv* env, jobject thiz, jlong handle, jstring media_kind, jstring payload, jboolean preview_ready) {{
	      thiz = thiz;
	      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)(uintptr_t)handle;
	      if (runtime == NULL || runtime->app_id == 0u || s_runtime_apply_media_selection == NULL || media_kind == NULL || payload == NULL) {{
	        return JNI_FALSE;
	      }}
	      const char* mediaKindRaw = (*env)->GetStringUTFChars(env, media_kind, NULL);
	      if (mediaKindRaw == NULL) {{
	        return JNI_FALSE;
	      }}
	      const char* payloadRaw = (*env)->GetStringUTFChars(env, payload, NULL);
	      if (payloadRaw == NULL) {{
	        (*env)->ReleaseStringUTFChars(env, media_kind, mediaKindRaw);
	        return JNI_FALSE;
	      }}
	      int previewReady = preview_ready == JNI_TRUE ? 1 : 0;
	      int ok = s_runtime_apply_media_selection(mediaKindRaw, payloadRaw, previewReady);
	      (*env)->ReleaseStringUTFChars(env, payload, payloadRaw);
	      (*env)->ReleaseStringUTFChars(env, media_kind, mediaKindRaw);
	      return ok != 0 ? JNI_TRUE : JNI_FALSE;
	    }}

	    static jboolean native_apply_product_csv_selection(JNIEnv* env, jobject thiz, jlong handle, jstring display_name, jstring csv_text) {{
	      thiz = thiz;
	      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)(uintptr_t)handle;
	      if (runtime == NULL || runtime->app_id == 0u || s_runtime_apply_product_csv_selection == NULL || display_name == NULL || csv_text == NULL) {{
	        return JNI_FALSE;
	      }}
	      const char* displayNameRaw = (*env)->GetStringUTFChars(env, display_name, NULL);
	      if (displayNameRaw == NULL) {{
	        return JNI_FALSE;
	      }}
	      const char* csvTextRaw = (*env)->GetStringUTFChars(env, csv_text, NULL);
	      if (csvTextRaw == NULL) {{
	        (*env)->ReleaseStringUTFChars(env, display_name, displayNameRaw);
	        return JNI_FALSE;
	      }}
	      int ok = s_runtime_apply_product_csv_selection(displayNameRaw, csvTextRaw);
	      (*env)->ReleaseStringUTFChars(env, csv_text, csvTextRaw);
	      (*env)->ReleaseStringUTFChars(env, display_name, displayNameRaw);
	      return ok != 0 ? JNI_TRUE : JNI_FALSE;
	    }}

	    static ChengAndroidMediaTextureCache* cheng_android_find_media_texture(int kind_code, int surface_kind, int texture_provider, int slot_hash, int asset_hash, int manifest_hash, int poster_hash) {{
      if (kind_code <= 0 || surface_kind <= 0 || texture_provider <= 0 || slot_hash <= 0 || asset_hash <= 0 || manifest_hash <= 0 || poster_hash <= 0) {{
        return NULL;
      }}
      for (int i = 0; i < CHENG_ANDROID_MEDIA_TEXTURE_CACHE_CAP; i++) {{
        if (s_media_textures[i].valid &&
            s_media_textures[i].kind_code == kind_code &&
            s_media_textures[i].surface_kind == surface_kind &&
            s_media_textures[i].texture_provider == texture_provider &&
            s_media_textures[i].slot_hash == slot_hash &&
            s_media_textures[i].asset_hash == asset_hash &&
            s_media_textures[i].manifest_hash == manifest_hash &&
            s_media_textures[i].poster_hash == poster_hash) {{
          return &s_media_textures[i];
        }}
      }}
      return NULL;
    }}

    static ChengAndroidMediaTextureCache* cheng_android_find_or_allocate_media_texture(int kind_code, int surface_kind, int texture_provider, int slot_hash, int asset_hash, int manifest_hash, int poster_hash) {{
      ChengAndroidMediaTextureCache* existing = cheng_android_find_media_texture(kind_code, surface_kind, texture_provider, slot_hash, asset_hash, manifest_hash, poster_hash);
      if (existing != NULL) {{
        return existing;
      }}
      for (int i = 0; i < CHENG_ANDROID_MEDIA_TEXTURE_CACHE_CAP; i++) {{
        if (!s_media_textures[i].valid) {{
          return &s_media_textures[i];
        }}
      }}
      return NULL;
    }}

    static ChengAndroidMediaTextureCache* cheng_android_media_texture_for_command(const int32_t* cmd) {{
      if (cmd == NULL) {{
        return NULL;
      }}
      return cheng_android_find_media_texture((int)cmd[0], (int)cmd[1], (int)cmd[2], (int)cmd[12], (int)cmd[13], (int)cmd[14], (int)cmd[15]);
    }}

    static void cheng_android_gpu_draw_media_surface_texture(int screen_width, int screen_height, int x, int y, int w, int h, int kind_code, int surface_kind, int texture_provider, int slot_hash, int asset_hash, int manifest_hash, int poster_hash, int object_fit, int playback_state) {{
      if (screen_width <= 0 || screen_height <= 0 || w <= 0 || h <= 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "draw_media_surface invalid geometry screen=%dx%d rect=%d,%d,%d,%d identity=%d,%d,%d,%d,%d,%d,%d fit=%d playback=%d",
                            screen_width, screen_height, x, y, w, h, kind_code, surface_kind, texture_provider,
                            slot_hash, asset_hash, manifest_hash, poster_hash, object_fit, playback_state);
        abort();
      }}
      ChengAndroidMediaTextureCache* texture = cheng_android_find_media_texture(kind_code, surface_kind, texture_provider, slot_hash, asset_hash, manifest_hash, poster_hash);
      if (texture == NULL || !texture->valid || texture->gl_texture == 0u || texture->width <= 0 || texture->height <= 0) {{
        int cache_provider = -1;
        int cache_slot_hash = -1;
        int cache_asset_hash = -1;
        int cache_manifest_hash = -1;
        int cache_poster_hash = -1;
        for (int i = 0; i < CHENG_ANDROID_MEDIA_TEXTURE_CACHE_CAP; i++) {{
          if (s_media_textures[i].valid) {{
            cache_provider = s_media_textures[i].texture_provider;
            cache_slot_hash = s_media_textures[i].slot_hash;
            cache_asset_hash = s_media_textures[i].asset_hash;
            cache_manifest_hash = s_media_textures[i].manifest_hash;
            cache_poster_hash = s_media_textures[i].poster_hash;
            break;
          }}
        }}
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "draw_media_surface missing texture identity=%d,%d,%d,%d,%d,%d,%d fit=%d playback=%d cache_key=%d,%d,%d,%d,%d texture=%p valid=%d gl=%u size=%dx%d",
                            kind_code, surface_kind, texture_provider, slot_hash, asset_hash, manifest_hash, poster_hash,
                            object_fit, playback_state, cache_provider, cache_slot_hash, cache_asset_hash, cache_manifest_hash, cache_poster_hash,
                            (void*)texture, texture != NULL ? texture->valid : -1,
                            texture != NULL ? texture->gl_texture : 0u,
                            texture != NULL ? texture->width : 0,
                            texture != NULL ? texture->height : 0);
        abort();
      }}
      if (kind_code == CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE &&
          playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_PLAYING &&
          playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED &&
          texture->poster_gl_texture != 0u &&
          texture->poster_width > 0 &&
          texture->poster_height > 0) {{
        cheng_android_gpu_draw_texture_object_fit(screen_width, screen_height, texture->poster_gl_texture, x, y, w, h, texture->poster_width, texture->poster_height, object_fit);
        return;
      }}
      if (kind_code == CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE &&
          texture->texture_target == GL_TEXTURE_EXTERNAL_OES) {{
        JNIEnv* env = cheng_android_jni_env();
        if (env == NULL) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                              "draw_media_surface missing jni env identity=%d,%d,%d,%d,%d,%d,%d",
                              kind_code, surface_kind, texture_provider, slot_hash, asset_hash, manifest_hash, poster_hash);
          abort();
        }}
        s_media_playback_last_state = playback_state;
        cheng_android_media_texture_pump_decoder(texture, env, playback_state);
      }}
      if (texture->texture_target == GL_TEXTURE_EXTERNAL_OES) {{
        /* texture_transform_valid (SurfaceTexture's real GL transform matrix, applied in the
           vertex shader as u_tex_transform * a_uv) and rotation_degrees (CPU pre-rotation of
           a_uv via cheng_android_rotated_uv, applied BEFORE the shader multiply) are two
           independent rotation mechanisms over the SAME uv -- compounding them produces neither
           "not rotated" nor "rotated rotation_degrees", but a third, wrong composite orientation
           (confirmed on-device: sideways/upside-down playback at rotation=90). They must stay
           mutually exclusive, matching the ES branch's already-validated fix (this file, ES
           texture setup below: texture_transform_valid is only ever left unset there so the real
           matrix never fights rotation_degrees). This covers whole-file and ES uniformly (every
           producer of this cache entry funnels through this one draw call) and every rotation
           value (0/90/180/270 -- cheng_android_rotated_uv already normalizes all four): only hand
           the real matrix to the shader when there is no separate CPU rotation to also apply;
           otherwise force identity (NULL) and let rotation_degrees be the single source of truth.
           rotation_degrees==0 is a no-op in cheng_android_rotated_uv, so unrotated content is
           provably unchanged by this. */
        cheng_android_gpu_draw_external_texture_object_fit(screen_width, screen_height, texture->gl_texture, x, y, w, h, texture->width, texture->height, object_fit, (texture->texture_transform_valid && texture->rotation_degrees == 0) ? texture->texture_transform : NULL, texture->rotation_degrees);
      }} else {{
        cheng_android_gpu_draw_texture_object_fit(screen_width, screen_height, texture->gl_texture, x, y, w, h, texture->width, texture->height, object_fit);
      }}
    }}

    static void cheng_android_gpu_draw_registered_media_surfaces(int screen_width, int screen_height) {{
      if (screen_width <= 0 || screen_height <= 0) {{
        abort();
      }}
      int command_count = s_media_surface_command_word_count / CHENG_ANDROID_MEDIA_SURFACE_HOST_STRIDE_I32;
      if (command_count <= 0) {{
        return;
      }}
      for (int i = 0; i < command_count; i++) {{
        const int32_t* cmd = s_media_surface_command_words + ((size_t)i * (size_t)CHENG_ANDROID_MEDIA_SURFACE_HOST_STRIDE_I32);
        cheng_android_gpu_draw_media_surface_texture(screen_width, screen_height, (int)cmd[6], (int)cmd[7], (int)cmd[8], (int)cmd[9], (int)cmd[0], (int)cmd[1], (int)cmd[2], (int)cmd[12], (int)cmd[13], (int)cmd[14], (int)cmd[15], (int)cmd[11], (int)cmd[10]);
      }}
    }}

    static int cheng_android_hash31(const char* text) {{
      if (text == NULL || text[0] == 0) {{
        return -1;
      }}
      uint64_t hash = 216613626ull;
      for (const unsigned char* p = (const unsigned char*)text; *p != 0; p++) {{
        hash = (hash * 16777619ull + (uint64_t)(*p)) & 2147483647ull;
      }}
      int out = (int)hash;
      return out <= 0 ? 1 : out;
    }}

    static int cheng_android_is_hex_sha256(const char* text) {{
      if (text == NULL || strlen(text) != 64u) {{
        return 0;
      }}
      for (int i = 0; i < 64; i++) {{
        char ch = text[i];
        int hex = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
        if (!hex) {{
          return 0;
        }}
      }}
      return 1;
    }}

    static int cheng_android_is_local_file_media_uri(const char* text) {{
      if (text == NULL || text[0] == '\0') {{
        return 0;
      }}
      if (strncmp(text, "file://", 7u) == 0 && text[7] == '/') {{
        return 1;
      }}
      return text[0] == '/';
    }}

    static const char* cheng_android_local_file_media_path(const char* text) {{
      if (text == NULL) {{
        return NULL;
      }}
      if (strncmp(text, "file://", 7u) == 0) {{
        return text + 7;
      }}
      return text;
    }}

    static int cheng_android_open_local_file_media_fd(const char* uri, off64_t* out_length) {{
      if (!cheng_android_is_local_file_media_uri(uri) || out_length == NULL) {{
        return -1;
      }}
      const char* path = cheng_android_local_file_media_path(uri);
      if (path == NULL || path[0] != '/') {{
        return -1;
      }}
      int fd = open(path, O_RDONLY);
      if (fd < 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local media open failed path=%s errno=%d", path, errno);
        return -1;
      }}
      struct stat st;
      if (fstat(fd, &st) != 0 || st.st_size <= 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local media stat failed path=%s errno=%d", path, errno);
        close(fd);
        return -1;
      }}
      *out_length = (off64_t)st.st_size;
      return fd;
    }}

    static JNIEnv* cheng_android_jni_env(void) {{
      if (s_java_vm == NULL) {{
        return NULL;
      }}
      JNIEnv* env = NULL;
      jint rc = (*s_java_vm)->GetEnv(s_java_vm, (void**)&env, JNI_VERSION_1_6);
      if (rc == JNI_OK) {{
        return env;
      }}
      if (rc == JNI_EDETACHED) {{
        if ((*s_java_vm)->AttachCurrentThread(s_java_vm, (void**)&env, NULL) == JNI_OK) {{
          return env;
        }}
      }}
      return NULL;
    }}

    static void cheng_android_local_audio_release(ChengAndroidLocalAudioPlayback* audio) {{
      if (audio == NULL) {{
        return;
      }}
      if (audio->stream != NULL) {{
        if (audio->stream_started) {{
          AAudioStream_requestStop(audio->stream);
        }}
        AAudioStream_close(audio->stream);
      }}
      if (audio->codec != NULL) {{
        if (audio->decoder_started) {{
          AMediaCodec_stop(audio->codec);
        }}
        AMediaCodec_delete(audio->codec);
      }}
      if (audio->extractor != NULL) {{
        AMediaExtractor_delete(audio->extractor);
      }}
      if (audio->pcm != NULL) {{
        free(audio->pcm);
      }}
      if (audio->pcm_mutex_inited) {{
        pthread_mutex_destroy(&audio->pcm_mu);
      }}
      memset(audio, 0, sizeof(*audio));
    }}

    static aaudio_data_callback_result_t cheng_android_local_audio_data_callback(AAudioStream* stream, void* userData, void* audioData, int32_t numFrames) {{
      (void)stream;
      ChengAndroidLocalAudioPlayback* audio = (ChengAndroidLocalAudioPlayback*)userData;
      int16_t* out = (int16_t*)audioData;
      if (audio == NULL || out == NULL || numFrames <= 0) {{
        return AAUDIO_CALLBACK_RESULT_CONTINUE;
      }}
      int channels = audio->channels > 0 ? audio->channels : 2;
      int want_slots = numFrames * channels;
      int take = 0;
      int callback_peak = 0;
      int callback_nonzero = 0;
      if (audio->pcm_mutex_inited) {{
        pthread_mutex_lock(&audio->pcm_mu);
        take = audio->pcm_size < want_slots ? audio->pcm_size : want_slots;
        for (int i = 0; i < take; i++) {{
          int16_t sample = audio->pcm[audio->pcm_head];
          out[i] = sample;
          if (sample != 0) {{
            callback_nonzero++;
            int sample_abs = sample < 0 ? -((int)sample) : (int)sample;
            if (sample_abs > callback_peak) {{
              callback_peak = sample_abs;
            }}
          }}
          audio->pcm_head = (audio->pcm_head + 1) % audio->pcm_cap_samples;
        }}
        audio->pcm_size -= take;
        if (callback_peak > audio->callback_peak) {{
          audio->callback_peak = callback_peak;
        }}
        audio->callback_nonzero_samples += callback_nonzero;
        audio->frames_played += numFrames;   /* MASTER CLOCK advances by device frames — moved
           inside pcm_mu (same fix shape as S7 v2's s_aes_ctx.frames_played) to close the
           write-write race with cheng_android_local_audio_clear_pcm's frames_played=0, which
           runs under this same lock on the render/decoder-pump thread during a seek reset:
           this is a load-add-store, not atomic across threads without the lock. Pure field
           increment only, no calls added to the critical section — the stream (and hence this
           callback) is only ever created after pcm_mutex_inited is set, so this branch is the
           callback's only reachable path. */
        if (take < want_slots) {{
          audio->underrun_frames += numFrames - (take / channels);   /* moved inside pcm_mu
             (same fix shape as frames_played above, c6281f9d8) to close the write-write race
             with cheng_android_local_audio_clear_pcm's underrun_frames=0, which runs under this
             same lock on the render/decoder-pump thread during a seek reset. take is fixed by
             this point (set under this lock above); want_slots/channels/numFrames are fixed
             before the lock, so relocating this read-add-store changes no value semantics. */
        }}
        pthread_mutex_unlock(&audio->pcm_mu);
      }}
      for (int i = take; i < want_slots; i++) {{
        out[i] = 0;
      }}
      return AAUDIO_CALLBACK_RESULT_CONTINUE;
    }}

    static AAudioStream* cheng_android_create_local_audio_stream(int sample_rate, int channels, ChengAndroidLocalAudioPlayback* audio) {{
      if (sample_rate <= 0 || channels <= 0 || audio == NULL) {{
        return NULL;
      }}
      AAudioStreamBuilder* builder = NULL;
      if (AAudio_createStreamBuilder(&builder) != AAUDIO_OK || builder == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio builder create failed");
        return NULL;
      }}
      AAudioStreamBuilder_setDirection(builder, AAUDIO_DIRECTION_OUTPUT);
      AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_SHARED);
      AAudioStreamBuilder_setSampleRate(builder, sample_rate);
      AAudioStreamBuilder_setChannelCount(builder, channels);
      AAudioStreamBuilder_setFormat(builder, AAUDIO_FORMAT_PCM_I16);
      AAudioStreamBuilder_setUsage(builder, AAUDIO_USAGE_MEDIA);
      AAudioStreamBuilder_setContentType(builder, AAUDIO_CONTENT_TYPE_MUSIC);
      AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY);
      AAudioStreamBuilder_setDataCallback(builder, cheng_android_local_audio_data_callback, audio);
      AAudioStream* stream = NULL;
      aaudio_result_t rc = AAudioStreamBuilder_openStream(builder, &stream);
      AAudioStreamBuilder_delete(builder);
      if (rc != AAUDIO_OK || stream == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio open failed rc=%d sr=%d ch=%d", (int)rc, sample_rate, channels);
        return NULL;
      }}
      return stream;
    }}

    static void cheng_android_local_audio_clear_pcm(ChengAndroidLocalAudioPlayback* audio) {{
      if (audio == NULL || !audio->pcm_mutex_inited) {{
        return;
      }}
      pthread_mutex_lock(&audio->pcm_mu);
      audio->pcm_head = 0;
      audio->pcm_tail = 0;
      audio->pcm_size = 0;
      audio->frames_played = 0;
      audio->decoded_frames = 0;
      audio->underrun_frames = 0;
      audio->pcm_peak = 0;
      audio->callback_peak = 0;
      audio->decoded_nonzero_samples = 0;
      audio->callback_nonzero_samples = 0;
      pthread_mutex_unlock(&audio->pcm_mu);
    }}

    static void cheng_android_media_texture_release(ChengAndroidMediaTextureCache* texture) {{
      if (texture == NULL) {{
        return;
      }}
      /* This slot is the streaming AUDIO ES session's owner (see s_aes_owner_texture's
         declaration comment) -- the video texture going away means that session is over
         (explicit release, slot reuse for a different asset, or cheng_android_gpu_destroy's
         full sweep on app exit), so its audio counterpart must end its own lifecycle here
         too, not just leak forward into whatever plays next. Runs before this texture's own
         GL/JNI teardown below; independent of it (different resource families). */
      if (texture == s_aes_owner_texture) {{
        cheng_android_aes_session_teardown();
      }}
      JNIEnv* env = cheng_android_jni_env();
      cheng_android_local_audio_release(&texture->audio);
      if (texture->codec != NULL) {{
        if (texture->decoder_started) {{
          AMediaCodec_stop(texture->codec);
        }}
        AMediaCodec_delete(texture->codec);
      }}
      if (texture->extractor != NULL) {{
        AMediaExtractor_delete(texture->extractor);
      }}
      if (texture->decode_window != NULL) {{
        ANativeWindow_release(texture->decode_window);
      }}
      if (env != NULL && texture->surface != NULL) {{
        (*env)->DeleteGlobalRef(env, texture->surface);
      }}
      if (env != NULL && texture->surface_texture != NULL) {{
        (*env)->DeleteGlobalRef(env, texture->surface_texture);
      }}
      if (texture->gl_texture != 0u) {{
        glDeleteTextures(1, &texture->gl_texture);
      }}
      if (texture->poster_gl_texture != 0u && texture->poster_gl_texture != texture->gl_texture) {{
        glDeleteTextures(1, &texture->poster_gl_texture);
      }}
      memset(texture, 0, sizeof(*texture));
    }}

    static int cheng_android_create_decoder_surface(JNIEnv* env,
                                                     GLuint texture,
                                                     jobject* out_surface_texture,
                                                     jobject* out_surface,
                                                     ANativeWindow** out_window) {{
      if (env == NULL || texture == 0u || out_surface_texture == NULL || out_surface == NULL || out_window == NULL) {{
        return 0;
      }}
      *out_surface_texture = NULL;
      *out_surface = NULL;
      *out_window = NULL;
      jclass st_cls = (*env)->FindClass(env, "android/graphics/SurfaceTexture");
      if (st_cls == NULL) {{
        return 0;
      }}
      jmethodID st_ctor = (*env)->GetMethodID(env, st_cls, "<init>", "(I)V");
      if (st_ctor == NULL) {{
        (*env)->DeleteLocalRef(env, st_cls);
        return 0;
      }}
      jobject st_local = (*env)->NewObject(env, st_cls, st_ctor, (jint)texture);
      (*env)->DeleteLocalRef(env, st_cls);
      if (st_local == NULL || (*env)->ExceptionCheck(env)) {{
        if ((*env)->ExceptionCheck(env)) {{
          (*env)->ExceptionClear(env);
        }}
        return 0;
      }}
      jclass surface_cls = (*env)->FindClass(env, "android/view/Surface");
      if (surface_cls == NULL) {{
        (*env)->DeleteLocalRef(env, st_local);
        return 0;
      }}
      jmethodID surface_ctor = (*env)->GetMethodID(env, surface_cls, "<init>", "(Landroid/graphics/SurfaceTexture;)V");
      if (surface_ctor == NULL) {{
        (*env)->DeleteLocalRef(env, surface_cls);
        (*env)->DeleteLocalRef(env, st_local);
        return 0;
      }}
      jobject surface_local = (*env)->NewObject(env, surface_cls, surface_ctor, st_local);
      (*env)->DeleteLocalRef(env, surface_cls);
      if (surface_local == NULL || (*env)->ExceptionCheck(env)) {{
        if ((*env)->ExceptionCheck(env)) {{
          (*env)->ExceptionClear(env);
        }}
        (*env)->DeleteLocalRef(env, st_local);
        return 0;
      }}
      ANativeWindow* window = ANativeWindow_fromSurface(env, surface_local);
      if (window == NULL) {{
        (*env)->DeleteLocalRef(env, surface_local);
        (*env)->DeleteLocalRef(env, st_local);
        return 0;
      }}
      jobject st_global = (*env)->NewGlobalRef(env, st_local);
      jobject surface_global = (*env)->NewGlobalRef(env, surface_local);
      (*env)->DeleteLocalRef(env, surface_local);
      (*env)->DeleteLocalRef(env, st_local);
      if (st_global == NULL || surface_global == NULL) {{
        if (st_global != NULL) {{
          (*env)->DeleteGlobalRef(env, st_global);
        }}
        if (surface_global != NULL) {{
          (*env)->DeleteGlobalRef(env, surface_global);
        }}
        ANativeWindow_release(window);
        return 0;
      }}
      *out_surface_texture = st_global;
      *out_surface = surface_global;
      *out_window = window;
      return 1;
    }}

    static int cheng_android_set_surface_texture_default_buffer_size(JNIEnv* env, jobject surface_texture, int width, int height) {{
      if (env == NULL || surface_texture == NULL || width <= 0 || height <= 0) {{
        return 0;
      }}
      jclass st_cls = (*env)->GetObjectClass(env, surface_texture);
      if (st_cls == NULL) {{
        return 0;
      }}
      jmethodID set_mid = (*env)->GetMethodID(env, st_cls, "setDefaultBufferSize", "(II)V");
      (*env)->DeleteLocalRef(env, st_cls);
      if (set_mid == NULL) {{
        return 0;
      }}
      (*env)->CallVoidMethod(env, surface_texture, set_mid, (jint)width, (jint)height);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        return 0;
      }}
      return 1;
    }}

    static int cheng_android_surface_texture_update(JNIEnv* env, jobject surface_texture, float* out_transform) {{
      if (env == NULL || surface_texture == NULL || out_transform == NULL) {{
        return 0;
      }}
      cheng_android_texture_transform_identity(out_transform);
      jclass st_cls = (*env)->GetObjectClass(env, surface_texture);
      if (st_cls == NULL) {{
        return 0;
      }}
      jmethodID update_mid = (*env)->GetMethodID(env, st_cls, "updateTexImage", "()V");
      jmethodID transform_mid = (*env)->GetMethodID(env, st_cls, "getTransformMatrix", "([F)V");
      (*env)->DeleteLocalRef(env, st_cls);
      if (update_mid == NULL || transform_mid == NULL) {{
        return 0;
      }}
      (*env)->CallVoidMethod(env, surface_texture, update_mid);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        return 0;
      }}
      jfloatArray transform_array = (*env)->NewFloatArray(env, 16);
      if (transform_array == NULL || (*env)->ExceptionCheck(env)) {{
        if ((*env)->ExceptionCheck(env)) {{
          (*env)->ExceptionClear(env);
        }}
        return 0;
      }}
      (*env)->CallVoidMethod(env, surface_texture, transform_mid, transform_array);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        (*env)->DeleteLocalRef(env, transform_array);
        return 0;
      }}
      (*env)->GetFloatArrayRegion(env, transform_array, 0, 16, out_transform);
      (*env)->DeleteLocalRef(env, transform_array);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        cheng_android_texture_transform_identity(out_transform);
        return 0;
      }}
      return 1;
    }}

    static int cheng_android_copy_decoder_format_buffer(AMediaFormat* source,
                                                        AMediaFormat* clean_format,
                                                        const char* key,
                                                        size_t* out_size) {{
      if (source == NULL || clean_format == NULL || key == NULL || out_size == NULL) {{
        return 0;
      }}
      *out_size = 0u;
      void* data = NULL;
      size_t size = 0u;
      if (!AMediaFormat_getBuffer(source, key, &data, &size)) {{
        return 1;
      }}
      if (data == NULL || size == 0u) {{
        return 0;
      }}
      AMediaFormat_setBuffer(clean_format, key, data, size);
      *out_size = size;
      return 1;
    }}

    static AMediaFormat* cheng_android_create_clean_decoder_format(AMediaFormat* source,
                                                                    const char* mime,
                                                                    int width,
                                                                    int height,
                                                                    size_t* out_csd0_size,
                                                                    size_t* out_csd1_size) {{
      if (source == NULL || mime == NULL || width <= 0 || height <= 0 || out_csd0_size == NULL || out_csd1_size == NULL) {{
        return NULL;
      }}
      *out_csd0_size = 0u;
      *out_csd1_size = 0u;
      AMediaFormat* clean_format = AMediaFormat_new();
      if (clean_format == NULL) {{
        return NULL;
      }}
      AMediaFormat_setString(clean_format, AMEDIAFORMAT_KEY_MIME, mime);
      AMediaFormat_setInt32(clean_format, AMEDIAFORMAT_KEY_WIDTH, (int32_t)width);
      AMediaFormat_setInt32(clean_format, AMEDIAFORMAT_KEY_HEIGHT, (int32_t)height);
      if (!cheng_android_copy_decoder_format_buffer(source, clean_format, "csd-0", out_csd0_size) ||
          !cheng_android_copy_decoder_format_buffer(source, clean_format, "csd-1", out_csd1_size)) {{
        AMediaFormat_delete(clean_format);
        return NULL;
      }}
      int32_t frame_rate = 0;
      if (AMediaFormat_getInt32(source, AMEDIAFORMAT_KEY_FRAME_RATE, &frame_rate)) {{
        AMediaFormat_setInt32(clean_format, AMEDIAFORMAT_KEY_FRAME_RATE, frame_rate);
      }}
      int64_t duration_us = 0;
      if (AMediaFormat_getInt64(source, AMEDIAFORMAT_KEY_DURATION, &duration_us)) {{
        AMediaFormat_setInt64(clean_format, AMEDIAFORMAT_KEY_DURATION, duration_us);
      }}
      return clean_format;
    }}

    static AMediaCodec* cheng_android_create_decoder_for_mime(const char* mime, const char** out_codec_name) {{
      if (mime == NULL || out_codec_name == NULL) {{
        return NULL;
      }}
      if (strcmp(mime, "video/avc") == 0) {{
        *out_codec_name = "c2.android.avc.decoder";
        return AMediaCodec_createCodecByName(*out_codec_name);
      }}
      *out_codec_name = "decoderByType";
      return AMediaCodec_createDecoderByType(mime);
    }}

    static void cheng_android_log_media_codec_configure_failure(const char* codec_name,
                                                                const char* mime,
                                                                int width,
                                                                int height,
                                                                size_t csd0_size,
                                                                size_t csd1_size,
                                                                const char* asset_rel,
                                                                media_status_t status) {{
      __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                          "media codec configure failed codec=%s mime=%s size=%dx%d csd=%zu,%zu asset=%s status=%d",
                          codec_name != NULL ? codec_name : "",
                          mime != NULL ? mime : "",
                          width,
                          height,
                          csd0_size,
                          csd1_size,
                          asset_rel != NULL ? asset_rel : "",
                          (int)status);
    }}

    /* 对端秒开: implemented in web_scene_media_network_bridge.cheng and linked
       into the app library. Fetches the publisher's announced MoQ object over
       real QUIC and writes it to out_path. Resolved through s_app_handle so the
       Android dynamic linker never sees a host->app undefined edge at load time. */
    typedef int (*cheng_scene_media_fetch_remote_announced_to_file_fn)(const char* dial_host, int port, const char* out_path);
    static cheng_scene_media_fetch_remote_announced_to_file_fn s_fetch_remote_announced_to_file = NULL;

    /* Endpoint discovery for the localhost 端到端 demo: the publisher's bound
       port is published as a system property — adb shell setprop
       debug.cheng.media.peer.port <port> — readable across UIDs (the app and the
       publisher run under different UIDs). Returns the fetched byte count, 0 when
       no peer is configured (the host then decodes the bundled asset), or -1 when
       a peer IS configured but the network fetch failed (no silent fallback: the
       decode then fails loudly). */
    /* Cross-device fetch, split across threads. The pure-Cheng QUIC dial/recv pump only makes
       progress on the thread that owns the cheng runtime (where cheng_app_init/cheng_app_tick run,
       i.e. the render thread) — on the decode thread or a raw pthread the handshake response arrives
       but the recv pump is never driven. So the decode thread only REQUESTS the fetch here; it is
       executed once on the render thread by cheng_pump_media_fetch_on_runtime_thread (single-threaded
       model, same as the standalone subscriber which completes a LAN fetch in ~0ms).
       Peer: debug.cheng.media.peer.host/port. When neither property is set, the bundled
       media asset is decoded locally. Set either property to opt into cross-device
       鸿蒙发布→安卓秒开; a configured peer must succeed and does not silently fall back.
       Returns >0 fetched bytes (file ready at out_path), -2 pending (show poster, retry next frame),
       or -1 failed. No silent fallback. */
    static volatile int s_media_fetch_requested = 0;
    static volatile int s_media_fetch_done = 0;
    static int s_media_fetch_bytes = 0;
    static char s_media_fetch_path[256];
    static char s_media_fetch_host[128];
    static int s_media_fetch_port = 0;
    /* #32: identity key for the one-shot remote cache. Without this, a second
       card reuses the first card's path/bytes (fetch-ONCE-ever, no asset key). */
    static char s_media_fetch_asset[128];
    /* 秒开 prewarm one-shot guard: set the first time a feed video card reaches prepare with a
       known peer and the ES announce/index dial is kicked off (feed period, before any tap). It
       fires exactly once — a later card switch reuses/redials through webSceneMediaEsEnsureDialed,
       it must not reset this feed-period prewarm marker (device-perf-oracle anchors dial timing to
       the single "es prewarm: feed dial ... t_ms=" log this guards). */
    static int s_prewarm_done = 0;
    static int cheng_android_fetch_remote_media_to_cache(const char* asset_cid, char* out_path, size_t out_cap) {{
      if (asset_cid == NULL || asset_cid[0] == '\0' || out_path == NULL || out_cap == 0u) {{
        return -1;
      }}
      /* Identity mismatch: disarm prior one-shot so we never hand back another card's bytes. */
      if (__atomic_load_n(&s_media_fetch_requested, __ATOMIC_SEQ_CST) &&
          (s_media_fetch_asset[0] == '\0' || strcmp(s_media_fetch_asset, asset_cid) != 0)) {{
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "remote media: rearm for asset=%s (was=%s)",
                            asset_cid, s_media_fetch_asset[0] != '\0' ? s_media_fetch_asset : "(none)");
        __atomic_store_n(&s_media_fetch_requested, 0, __ATOMIC_SEQ_CST);
        __atomic_store_n(&s_media_fetch_done, 0, __ATOMIC_SEQ_CST);
        s_media_fetch_bytes = 0;
        /* Single-slot cache: reclaim the displaced identity's on-disk file here, or every
           distinct card ever viewed leaves a permanent cheng_remote_media_<cid> file. An
           in-flight reader holding an open fd keeps its data (POSIX unlink semantics). */
        if (s_media_fetch_path[0] != '\0') {{ unlink(s_media_fetch_path); }}
        s_media_fetch_path[0] = '\0';
        s_media_fetch_asset[0] = '\0';
      }}
      if (!__atomic_load_n(&s_media_fetch_requested, __ATOMIC_SEQ_CST)) {{
        char host_prop[128]; host_prop[0] = '\0';
        char port_prop[32]; port_prop[0] = '\0';
        __system_property_get("debug.cheng.media.peer.host", host_prop);
        __system_property_get("debug.cheng.media.peer.port", port_prop);
        int peer_configured = (host_prop[0] != '\0') || (port_prop[0] != '\0') || (s_media_fetch_host[0] != '\0');
        if (!peer_configured) {{
          return 0;
        }}
        const char* dial_host = (s_media_fetch_host[0] != '\0')
          ? s_media_fetch_host
          : ((host_prop[0] != '\0') ? host_prop : "127.0.0.1");
        int port = (s_media_fetch_port > 0)
          ? s_media_fetch_port
          : ((port_prop[0] != '\0') ? atoi(port_prop) : 38000);
        if (port <= 0) {{ port = 38000; }}
        const char* tmpdir = getenv("TMPDIR");
        char cache_dir[256];
        if (tmpdir != NULL && tmpdir[0] != '\0') {{ snprintf(cache_dir, sizeof(cache_dir), "%s", tmpdir); }}
        else {{ snprintf(cache_dir, sizeof(cache_dir), "/data/user/0/org.cheng.unimaker.scene/cache"); }}
        snprintf(s_media_fetch_asset, sizeof(s_media_fetch_asset), "%s", asset_cid);
        /* Per-asset path: basename-safe slice of cid (hex/sha path components). */
        snprintf(s_media_fetch_path, sizeof(s_media_fetch_path), "%s/cheng_remote_media_%.80s", cache_dir, asset_cid);
        snprintf(s_media_fetch_host, sizeof(s_media_fetch_host), "%s", dial_host);
        s_media_fetch_port = port;
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "remote media: fetch requested %s:%d asset=%s (runs on render thread)",
                            dial_host, port, asset_cid);
        __atomic_store_n(&s_media_fetch_requested, 1, __ATOMIC_SEQ_CST);
        return -2;
      }}
      if (!__atomic_load_n(&s_media_fetch_done, __ATOMIC_SEQ_CST)) {{ return -2; }}
      if (s_media_fetch_bytes <= 0) {{ return -1; }}
      snprintf(out_path, out_cap, "%s", s_media_fetch_path);
      return s_media_fetch_bytes;
    }}

    /* Runs on the cheng runtime-owner (render) thread, once, after a fetch is requested. */
    static void cheng_pump_media_fetch_on_runtime_thread(void) {{
      if (!__atomic_load_n(&s_media_fetch_requested, __ATOMIC_SEQ_CST)) {{ return; }}
      if (__atomic_load_n(&s_media_fetch_done, __ATOMIC_SEQ_CST)) {{ return; }}
      if (s_fetch_remote_announced_to_file == NULL) {{
        s_fetch_remote_announced_to_file =
          (cheng_scene_media_fetch_remote_announced_to_file_fn)cheng_resolve_required_app_export("cheng_scene_media_fetch_remote_announced_to_file");
        if (s_fetch_remote_announced_to_file == NULL) {{
          s_media_fetch_bytes = -1;
          __atomic_store_n(&s_media_fetch_done, 1, __ATOMIC_SEQ_CST);
          return;
        }}
      }}
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "remote media: fetch run on render thread %s:%d", s_media_fetch_host, s_media_fetch_port);
      int n = s_fetch_remote_announced_to_file(s_media_fetch_host, s_media_fetch_port, s_media_fetch_path);
      s_media_fetch_bytes = n;
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "remote media: fetch done bytes=%d", n);
      __atomic_store_n(&s_media_fetch_done, 1, __ATOMIC_SEQ_CST);
    }}

    static int cheng_android_open_media_asset_fd_for_read(const char* asset_rel, char* remote_cache, size_t remote_cache_cap, off64_t* out_start, off64_t* out_length) {{
      if (asset_rel == NULL || out_start == NULL || out_length == NULL) {{
        return -1;
      }}
      *out_start = 0;
      *out_length = 0;
      if (remote_cache != NULL && remote_cache_cap > 0u) {{
        remote_cache[0] = '\0';
      }}
      if (cheng_android_is_local_file_media_uri(asset_rel)) {{
        return cheng_android_open_local_file_media_fd(asset_rel, out_length);
      }}
      char local_remote_cache[256];
      char* cache_path = remote_cache != NULL && remote_cache_cap > 0u ? remote_cache : local_remote_cache;
      size_t cache_cap = remote_cache != NULL && remote_cache_cap > 0u ? remote_cache_cap : sizeof(local_remote_cache);
      int remote_bytes = cheng_android_fetch_remote_media_to_cache(asset_rel, cache_path, cache_cap);
      if (remote_bytes == -2) {{
        return -2;
      }}
      if (remote_bytes < 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "remote media required but unavailable rel=%s", asset_rel);
        return -1;
      }}
      if (remote_bytes > 0) {{
        int fd = open(cache_path, O_RDONLY);
        if (fd < 0) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "remote media cache open failed path=%s", cache_path);
          return -1;
        }}
        *out_length = (off64_t)remote_bytes;
        return fd;
      }}
      if (s_asset_manager != NULL) {{
        AAsset* asset = AAssetManager_open(s_asset_manager, asset_rel, AASSET_MODE_RANDOM);
        if (asset == NULL) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media asset missing rel=%s", asset_rel);
          return -1;
        }}
        int fd = AAsset_openFileDescriptor64(asset, out_start, out_length);
        AAsset_close(asset);
        return fd;
      }}
      return cheng_android_open_headless_asset_fd(asset_rel, out_length);
    }}

    static int cheng_android_configure_local_audio_for_asset(const char* asset_rel, ChengAndroidLocalAudioPlayback* audio) {{
      if (asset_rel == NULL || audio == NULL) {{
        return 0;
      }}
      cheng_android_local_audio_release(audio);
      off64_t start = 0;
      off64_t length = 0;
      char remote_cache[256];
      int fd = cheng_android_open_media_asset_fd_for_read(asset_rel, remote_cache, sizeof(remote_cache), &start, &length);
      if (fd == -2) {{
        return 0;
      }}
      if (fd < 0 || length <= 0) {{
        if (fd >= 0) {{
          close(fd);
        }}
        return 0;
      }}
      AMediaExtractor* extractor = AMediaExtractor_new();
      if (extractor == NULL) {{
        close(fd);
        return 0;
      }}
      media_status_t data_source_status = AMediaExtractor_setDataSourceFd(extractor, fd, start, length);
      close(fd);
      if (data_source_status != AMEDIA_OK) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio extractor setDataSourceFd failed rel=%s status=%d", asset_rel, (int)data_source_status);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      size_t track_count = AMediaExtractor_getTrackCount(extractor);
      AMediaFormat* selected_format = NULL;
      int selected_track = -1;
      int sample_rate = 0;
      int channels = 0;
      char selected_mime[64];
      selected_mime[0] = '\0';
      for (size_t track = 0; track < track_count; track++) {{
        AMediaFormat* candidate = AMediaExtractor_getTrackFormat(extractor, track);
        if (candidate == NULL) {{
          continue;
        }}
        const char* mime = NULL;
        if (AMediaFormat_getString(candidate, AMEDIAFORMAT_KEY_MIME, &mime) && mime != NULL && strncmp(mime, "audio/", 6u) == 0) {{
          int32_t sr = 0;
          int32_t ch = 0;
          if (!AMediaFormat_getInt32(candidate, AMEDIAFORMAT_KEY_SAMPLE_RATE, &sr) ||
              !AMediaFormat_getInt32(candidate, AMEDIAFORMAT_KEY_CHANNEL_COUNT, &ch) ||
              sr <= 0 || ch <= 0 || ch > 2) {{
            AMediaFormat_delete(candidate);
            AMediaExtractor_delete(extractor);
            __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio invalid format rel=%s mime=%s sr=%d ch=%d", asset_rel, mime, (int)sr, (int)ch);
            return 0;
          }}
          int mime_len = snprintf(selected_mime, sizeof(selected_mime), "%s", mime);
          if (mime_len <= 0 || mime_len >= (int)sizeof(selected_mime)) {{
            AMediaFormat_delete(candidate);
            AMediaExtractor_delete(extractor);
            return 0;
          }}
          selected_format = candidate;
          selected_track = (int)track;
          sample_rate = (int)sr;
          channels = (int)ch;
          break;
        }}
        AMediaFormat_delete(candidate);
      }}
      if (selected_track < 0 || selected_format == NULL) {{
        AMediaExtractor_delete(extractor);
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "local_audio no_track rel=%s", asset_rel);
        return 1;
      }}
      if (AMediaExtractor_selectTrack(extractor, (size_t)selected_track) != AMEDIA_OK) {{
        AMediaFormat_delete(selected_format);
        AMediaExtractor_delete(extractor);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio select_track failed rel=%s track=%d", asset_rel, selected_track);
        return 0;
      }}
      AMediaCodec* codec = AMediaCodec_createDecoderByType(selected_mime);
      if (codec == NULL) {{
        AMediaFormat_delete(selected_format);
        AMediaExtractor_delete(extractor);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio decoder create failed rel=%s mime=%s", asset_rel, selected_mime);
        return 0;
      }}
      media_status_t configure_status = AMediaCodec_configure(codec, selected_format, NULL, NULL, 0);
      AMediaFormat_delete(selected_format);
      if (configure_status != AMEDIA_OK) {{
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(extractor);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio decoder configure failed rel=%s mime=%s status=%d", asset_rel, selected_mime, (int)configure_status);
        return 0;
      }}
      if (AMediaCodec_start(codec) != AMEDIA_OK) {{
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(extractor);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio decoder start failed rel=%s mime=%s", asset_rel, selected_mime);
        return 0;
      }}
      audio->pcm_cap_samples = CHENG_ANDROID_AES_PCM_RING_FRAMES * channels;
      audio->pcm = (int16_t*)malloc((size_t)audio->pcm_cap_samples * sizeof(int16_t));
      if (audio->pcm == NULL) {{
        AMediaCodec_stop(codec);
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      if (pthread_mutex_init(&audio->pcm_mu, NULL) != 0) {{
        free(audio->pcm);
        AMediaCodec_stop(codec);
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      audio->pcm_mutex_inited = 1;
      audio->sample_rate = sample_rate;
      audio->channels = channels;
      audio->extractor = extractor;
      audio->codec = codec;
      audio->decoder_started = 1;
      audio->stream = cheng_android_create_local_audio_stream(sample_rate, channels, audio);
      if (audio->stream == NULL) {{
        cheng_android_local_audio_release(audio);
        return 0;
      }}
      audio->valid = 1;
      audio->last_presentation_us = -1;
      audio->last_playback_state = CHENG_ANDROID_MEDIA_PLAYBACK_OPENED;
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "local_audio configured rel=%s mime=%s sr=%d ch=%d", asset_rel, selected_mime, sample_rate, channels);
      return 1;
    }}

    static int cheng_android_local_audio_reset_to_start(ChengAndroidLocalAudioPlayback* audio) {{
      if (audio == NULL || !audio->valid || audio->extractor == NULL || audio->codec == NULL) {{
        return 0;
      }}
      if (audio->stream != NULL && audio->stream_started) {{
        AAudioStream_requestPause(audio->stream);
        AAudioStream_requestFlush(audio->stream);
        audio->stream_started = 0;
      }}
      media_status_t seek_status = AMediaExtractor_seekTo(audio->extractor, 0, AMEDIAEXTRACTOR_SEEK_CLOSEST_SYNC);
      media_status_t flush_status = AMediaCodec_flush(audio->codec);
      if (seek_status != AMEDIA_OK || flush_status != AMEDIA_OK) {{
        audio->output_done = 1;
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio seek_failed seek=%d flush=%d", (int)seek_status, (int)flush_status);
        return 0;
      }}
      audio->input_done = 0;
      audio->output_done = 0;
      audio->last_presentation_us = -1;
      cheng_android_local_audio_clear_pcm(audio);
      return 1;
    }}

    static int cheng_android_local_audio_pump_decoder(ChengAndroidLocalAudioPlayback* audio, int playback_state) {{
      if (audio == NULL || !audio->valid || audio->codec == NULL || audio->extractor == NULL || audio->stream == NULL) {{
        return 0;
      }}
      if (playback_state == CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED &&
          (audio->last_playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED || audio->output_done)) {{
        if (!cheng_android_local_audio_reset_to_start(audio)) {{
          return 0;
        }}
      }}
      audio->last_playback_state = playback_state;
      if (playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_PLAYING && playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED) {{
        if (audio->stream_started) {{
          AAudioStream_requestPause(audio->stream);
          audio->stream_started = 0;
        }}
        return 0;
      }}
      for (int feed_i = 0; feed_i < 32 && !audio->input_done; feed_i++) {{
        ssize_t input_index = AMediaCodec_dequeueInputBuffer(audio->codec, 0);
        if (input_index < 0) {{
          break;
        }}
        size_t input_size = 0;
        uint8_t* input_buffer = AMediaCodec_getInputBuffer(audio->codec, (size_t)input_index, &input_size);
        if (input_buffer == NULL || input_size == 0u) {{
          audio->output_done = 1;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio input_buffer_failed");
          return 0;
        }}
        ssize_t sample_size = AMediaExtractor_readSampleData(audio->extractor, input_buffer, input_size);
        if (sample_size < 0) {{
          AMediaCodec_queueInputBuffer(audio->codec, (size_t)input_index, 0u, 0u, 0, AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
          audio->input_done = 1;
          break;
        }}
        int64_t sample_time = AMediaExtractor_getSampleTime(audio->extractor);
        uint32_t sample_flags = (uint32_t)AMediaExtractor_getSampleFlags(audio->extractor);
        AMediaCodec_queueInputBuffer(audio->codec, (size_t)input_index, 0u, (size_t)sample_size, sample_time, sample_flags);
        AMediaExtractor_advance(audio->extractor);
      }}
      int decoded_any = 0;
      for (int drain_i = 0; drain_i < 32; drain_i++) {{
        pthread_mutex_lock(&audio->pcm_mu);
        int ring_free = audio->pcm_cap_samples - audio->pcm_size;
        pthread_mutex_unlock(&audio->pcm_mu);
        if (ring_free < (4096 * audio->channels)) {{
          break;
        }}
        AMediaCodecBufferInfo info;
        ssize_t output_index = AMediaCodec_dequeueOutputBuffer(audio->codec, &info, 0);
        if (output_index < 0) {{
          break;
        }}
        if ((info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM) != 0) {{
          audio->output_done = 1;
        }}
        if (info.size > 0) {{
          size_t output_cap = 0;
          uint8_t* output_buffer = AMediaCodec_getOutputBuffer(audio->codec, (size_t)output_index, &output_cap);
          if (output_buffer != NULL && info.offset >= 0 && info.size > 0 && (size_t)(info.offset + info.size) <= output_cap) {{
            const int16_t* pcm = (const int16_t*)(output_buffer + info.offset);
            int slots = (int)(info.size / (int)sizeof(int16_t));
            int written_slots = 0;
            int drain_peak = 0;
            int drain_nonzero = 0;
            pthread_mutex_lock(&audio->pcm_mu);
            for (int i = 0; i < slots; i++) {{
              if (audio->pcm_size >= audio->pcm_cap_samples) {{
                break;
              }}
              int16_t sample = pcm[i];
              audio->pcm[audio->pcm_tail] = sample;
              audio->pcm_tail = (audio->pcm_tail + 1) % audio->pcm_cap_samples;
              audio->pcm_size++;
              written_slots++;
              if (sample != 0) {{
                drain_nonzero++;
                int sample_abs = sample < 0 ? -((int)sample) : (int)sample;
                if (sample_abs > drain_peak) {{
                  drain_peak = sample_abs;
                }}
              }}
            }}
            audio->decoded_frames += audio->channels > 0 ? (written_slots / audio->channels) : 0;
            if (drain_peak > audio->pcm_peak) {{
              audio->pcm_peak = drain_peak;
            }}
            audio->decoded_nonzero_samples += drain_nonzero;
            pthread_mutex_unlock(&audio->pcm_mu);
            audio->last_presentation_us = info.presentationTimeUs;
            decoded_any = 1;
          }}
        }}
        AMediaCodec_releaseOutputBuffer(audio->codec, (size_t)output_index, false);
      }}
      int pcm_ready = 0;
      int pcm_peak = 0;
      int callback_peak = 0;
      int64_t decoded_nonzero = 0;
      int64_t callback_nonzero = 0;
      pthread_mutex_lock(&audio->pcm_mu);
      pcm_ready = audio->pcm_size;
      pcm_peak = audio->pcm_peak;
      callback_peak = audio->callback_peak;
      decoded_nonzero = audio->decoded_nonzero_samples;
      callback_nonzero = audio->callback_nonzero_samples;
      pthread_mutex_unlock(&audio->pcm_mu);
      if (!audio->stream_started && pcm_ready > 0) {{
        aaudio_result_t start_status = AAudioStream_requestStart(audio->stream);
        if (start_status != AAUDIO_OK) {{
          audio->output_done = 1;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "local_audio start_failed rc=%d", (int)start_status);
          return decoded_any;
        }}
        audio->stream_started = 1;
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "local_audio_playback_started sr=%d ch=%d decoded_frames=%d pcm_ready=%d peak=%d decoded_nonzero=%lld callback_peak=%d callback_nonzero=%lld",
                            audio->sample_rate,
                            audio->channels,
                            audio->decoded_frames,
                            pcm_ready,
                            pcm_peak,
                            (long long)decoded_nonzero,
                            callback_peak,
                            (long long)callback_nonzero);
      }}
      if (decoded_any && cheng_android_media_trace_enabled()) {{
        int32_t stream_state = audio->stream != NULL ? (int32_t)AAudioStream_getState(audio->stream) : -1;
        int32_t xrun_count = audio->stream != NULL ? AAudioStream_getXRunCount(audio->stream) : -1;
        s_local_audio_frame_log_count++;
        if (s_local_audio_frame_log_count <= 12 || (s_local_audio_frame_log_count % 60) == 0) {{
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "local_audio_frame decoded_frames=%d played=%lld pcm=%d underrun=%d pts=%lld peak=%d decoded_nonzero=%lld callback_peak=%d callback_nonzero=%lld state=%d xruns=%d",
                              audio->decoded_frames,
                              (long long)audio->frames_played,
                              pcm_ready,
                              audio->underrun_frames,
                              (long long)audio->last_presentation_us,
                              pcm_peak,
                              (long long)decoded_nonzero,
                              callback_peak,
                              (long long)callback_nonzero,
                              (int)stream_state,
                              (int)xrun_count);
        }}
      }}
      return decoded_any;
    }}

    static int cheng_android_decode_video_first_frame_to_surface(const char* asset_rel,
                                                                  JNIEnv* env,
                                                                  jobject surface_texture,
                                                                  ANativeWindow* decode_window,
                                                                  int* out_width,
                                                                  int* out_height,
                                                                  AMediaExtractor** out_extractor,
                                                                  AMediaCodec** out_codec,
                                                                  int* out_input_done,
                                                                  int* out_output_done,
                                                                  int64_t* out_last_presentation_us,
                                                                  int* out_rotation_degrees) {{
      if (asset_rel == NULL || env == NULL || surface_texture == NULL || decode_window == NULL || out_width == NULL || out_height == NULL || out_extractor == NULL || out_codec == NULL || out_input_done == NULL || out_output_done == NULL || out_last_presentation_us == NULL || out_rotation_degrees == NULL) {{
        return 0;
      }}
      *out_width = 0;
      *out_height = 0;
      *out_extractor = NULL;
      *out_codec = NULL;
      *out_input_done = 0;
      *out_output_done = 0;
      *out_last_presentation_us = -1;
      *out_rotation_degrees = 0;
      off64_t start = 0;
      off64_t length = 0;
      int fd = -1;
      char remote_cache[256];
      if (cheng_android_is_local_file_media_uri(asset_rel)) {{
        fd = cheng_android_open_local_file_media_fd(asset_rel, &length);
        if (fd < 0) {{
          return 0;
        }}
      }} else {{
        int remote_bytes = cheng_android_fetch_remote_media_to_cache(asset_rel, remote_cache, sizeof(remote_cache));
        if (remote_bytes == -2) {{
          /* session opening on its own pass — show the poster this frame, retry next frame
             (秒开: poster → first decoded video frame once the announce + first range land). */
          return 0;
        }}
        if (remote_bytes < 0) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "remote media required but unavailable rel=%s", asset_rel);
          return 0;
        }}
        if (remote_bytes > 0) {{
          fd = open(remote_cache, O_RDONLY);
          if (fd < 0) {{
            __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "remote media cache open failed path=%s", remote_cache);
            return 0;
          }}
          length = (off64_t)remote_bytes;
        }} else {{
          if (s_asset_manager != NULL) {{
            AAsset* asset = AAssetManager_open(s_asset_manager, asset_rel, AASSET_MODE_RANDOM);
            if (asset == NULL) {{
              __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media asset missing rel=%s", asset_rel);
              return 0;
            }}
            fd = AAsset_openFileDescriptor64(asset, &start, &length);
            AAsset_close(asset);
          }} else {{
            fd = cheng_android_open_headless_asset_fd(asset_rel, &length);
            start = 0;
          }}
        }}
      }}
      if (fd < 0 || length <= 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media asset fd unavailable rel=%s compressed_or_missing_fd=1", asset_rel);
        if (fd >= 0) {{
          close(fd);
        }}
        return 0;
      }}
      AMediaExtractor* extractor = AMediaExtractor_new();
      if (extractor == NULL) {{
        close(fd);
        return 0;
      }}
      media_status_t data_source_status = AMediaExtractor_setDataSourceFd(extractor, fd, start, length);
      close(fd);
      if (data_source_status != AMEDIA_OK) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media extractor setDataSourceFd failed rel=%s status=%d", asset_rel, (int)data_source_status);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      size_t track_count = AMediaExtractor_getTrackCount(extractor);
      AMediaCodec* codec = NULL;
      AMediaFormat* format = NULL;
      int selected_track = -1;
      int video_width = 0;
      int video_height = 0;
      char selected_mime[64];
      selected_mime[0] = '\0';
      int selected_rotation_degrees = 0;
      size_t csd0_size = 0u;
      size_t csd1_size = 0u;
      for (size_t track = 0; track < track_count; track++) {{
        AMediaFormat* candidate = AMediaExtractor_getTrackFormat(extractor, track);
        if (candidate == NULL) {{
          continue;
        }}
        const char* mime = NULL;
        if (AMediaFormat_getString(candidate, AMEDIAFORMAT_KEY_MIME, &mime) && mime != NULL && strncmp(mime, "video/", 6u) == 0) {{
          if (!AMediaFormat_getInt32(candidate, AMEDIAFORMAT_KEY_WIDTH, &video_width) ||
              !AMediaFormat_getInt32(candidate, AMEDIAFORMAT_KEY_HEIGHT, &video_height) ||
              video_width <= 0 || video_height <= 0) {{
            AMediaFormat_delete(candidate);
            AMediaExtractor_delete(extractor);
            return 0;
          }}
          int mime_len = snprintf(selected_mime, sizeof(selected_mime), "%s", mime);
          if (mime_len <= 0 || mime_len >= (int)sizeof(selected_mime)) {{
            AMediaFormat_delete(candidate);
            AMediaExtractor_delete(extractor);
            return 0;
          }}
          int32_t candidate_rotation_degrees = 0;
          if (AMediaFormat_getInt32(candidate, "rotation-degrees", &candidate_rotation_degrees)) {{
            selected_rotation_degrees = cheng_android_normalize_video_rotation_degrees((int)candidate_rotation_degrees);
          }} else {{
            selected_rotation_degrees = 0;
          }}
          size_t candidate_csd0_size = 0u;
          size_t candidate_csd1_size = 0u;
          AMediaFormat* clean_format = cheng_android_create_clean_decoder_format(candidate, mime, video_width, video_height, &candidate_csd0_size, &candidate_csd1_size);
          if (clean_format == NULL) {{
            __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                                "media clean decoder format failed mime=%s size=%dx%d asset=%s",
                                selected_mime, video_width, video_height, asset_rel);
            AMediaFormat_delete(candidate);
            AMediaExtractor_delete(extractor);
            return 0;
          }}
          const char* decoder_name = NULL;
          codec = cheng_android_create_decoder_for_mime(mime, &decoder_name);
          if (codec == NULL) {{
            __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                                "media decoder create failed codec=%s mime=%s size=%dx%d asset=%s",
                                decoder_name != NULL ? decoder_name : "",
                                selected_mime, video_width, video_height, asset_rel);
            AMediaFormat_delete(clean_format);
            AMediaFormat_delete(candidate);
            AMediaExtractor_delete(extractor);
            return 0;
          }}
          AMediaFormat_delete(candidate);
          format = clean_format;
          csd0_size = candidate_csd0_size;
          csd1_size = candidate_csd1_size;
          selected_track = (int)track;
          break;
        }}
        AMediaFormat_delete(candidate);
      }}
      if (codec == NULL || format == NULL || selected_track < 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media asset has no decodable video track rel=%s", asset_rel);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      if (AMediaExtractor_selectTrack(extractor, (size_t)selected_track) != AMEDIA_OK) {{
        AMediaCodec_delete(codec);
        AMediaFormat_delete(format);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      if (!cheng_android_set_surface_texture_default_buffer_size(env, surface_texture, video_width, video_height)) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "media decoder surface buffer size failed mime=%s size=%dx%d asset=%s",
                            selected_mime, video_width, video_height, asset_rel);
        AMediaCodec_delete(codec);
        AMediaFormat_delete(format);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      media_status_t configure_status = AMediaCodec_configure(codec, format, decode_window, NULL, 0);
      AMediaFormat_delete(format);
      if (configure_status != AMEDIA_OK) {{
        cheng_android_log_media_codec_configure_failure(selected_mime[0] != '\0' && strcmp(selected_mime, "video/avc") == 0 ? "c2.android.avc.decoder" : "decoderByType",
                                                       selected_mime, video_width, video_height, csd0_size, csd1_size, asset_rel, configure_status);
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      if (AMediaCodec_start(codec) != AMEDIA_OK) {{
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(extractor);
        return 0;
      }}
      int input_done = 0;
      int output_done = 0;
      int got_frame = 0;
      int64_t last_presentation_us = -1;
      for (int iter = 0; iter < 128 && !got_frame; iter++) {{
        if (!input_done) {{
          ssize_t input_index = AMediaCodec_dequeueInputBuffer(codec, 100000);
          if (input_index >= 0) {{
            size_t input_size = 0;
            uint8_t* input_buffer = AMediaCodec_getInputBuffer(codec, (size_t)input_index, &input_size);
            if (input_buffer == NULL || input_size == 0u) {{
              AMediaCodec_stop(codec);
              AMediaCodec_delete(codec);
              AMediaExtractor_delete(extractor);
              return 0;
            }}
            ssize_t sample_size = AMediaExtractor_readSampleData(extractor, input_buffer, input_size);
            if (sample_size < 0) {{
              AMediaCodec_queueInputBuffer(codec, (size_t)input_index, 0u, 0u, 0, AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
              input_done = 1;
            }} else {{
              int64_t sample_time = AMediaExtractor_getSampleTime(extractor);
              uint32_t sample_flags = (uint32_t)AMediaExtractor_getSampleFlags(extractor);
              AMediaCodec_queueInputBuffer(codec, (size_t)input_index, 0u, (size_t)sample_size, sample_time, sample_flags);
              AMediaExtractor_advance(extractor);
            }}
          }}
        }}
        AMediaCodecBufferInfo info;
        ssize_t output_index = AMediaCodec_dequeueOutputBuffer(codec, &info, 100000);
        if (output_index >= 0) {{
          int render = info.size > 0 ? 1 : 0;
          AMediaCodec_releaseOutputBuffer(codec, (size_t)output_index, render);
          if (render) {{
            got_frame = 1;
            last_presentation_us = info.presentationTimeUs;
          }}
          if ((info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM) != 0) {{
            output_done = 1;
            break;
          }}
        }}
      }}
      if (!got_frame) {{
        AMediaCodec_stop(codec);
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(extractor);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media first frame decode failed rel=%s", asset_rel);
        return 0;
      }}
      *out_width = video_width;
      *out_height = video_height;
      *out_extractor = extractor;
      *out_codec = codec;
      *out_input_done = input_done;
      *out_output_done = output_done;
      *out_last_presentation_us = last_presentation_us;
      *out_rotation_degrees = selected_rotation_degrees;
      return 1;
    }}

    /* S3b seek target handoff (video-seek-scrub-blueprint.md §S3a/S3b), mirroring the Harmony
       host's cheng_host_video_seek → ChengStreamCtx.seek_target_ms design
       (cheng_gui_host_adapter.c:1060): a fire-and-forget target the render-thread pumps below
       pick up on the next SEEKED-state tick. handle is accepted for API symmetry with the
       existing cheng_host_video_play/pause/set_muted (same file, §S6 wiring) but unused —
       single active stream, same precedent those already established. -1 = no seek pending. */
    static volatile int64_t s_android_media_seek_target_us = -1;
    void cheng_host_video_seek(int32_t handle, int32_t position_ms) {{
      (void)handle;
      if (position_ms < 0) {{ return; }}
      s_android_media_seek_target_us = (int64_t)position_ms * 1000;
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "video seek position_ms=%d", position_ms);
    }}

    /* Progressive-ES pump: feed Annex-B access units from the input FIFO into AMediaCodec and
       drain decoded frames onto the OES window, paced to wall-clock PTS — the exact realtime
       pacing of the whole-file path, just sourced from the FIFO instead of AMediaExtractor.
       S3b seek (video-seek-scrub-blueprint.md §S3b): mirrors S3a's Harmony fetch-thread seek —
       reposition the Cheng bridge's ES cursor FIRST (WebSceneMediaEsSeekToPositionMs, via
       s_es_seek_to_position_ms_fn) so the drain below is not immediately refilled with
       pre-seek frames, THEN drain the now-stale local FIFO and flush the codec. */
    static int cheng_android_media_texture_pump_es(ChengAndroidMediaTextureCache* texture, JNIEnv* env, int playback_state) {{
      if (texture == NULL || env == NULL || !texture->valid || texture->codec == NULL || texture->surface_texture == NULL || !s_es_ctx_inited) {{
        return 0;
      }}
      if (texture->output_done && playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED) {{
        return 0;
      }}
      if (playback_state == CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED &&
          (texture->last_playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED || texture->output_done)) {{
        int64_t seekUs = s_android_media_seek_target_us;
        int32_t seekMs = seekUs >= 0 ? (int32_t)(seekUs / 1000) : 0;
        int32_t seekOk = (s_es_seek_to_position_ms_fn != NULL) ? s_es_seek_to_position_ms_fn(seekMs) : 0;
        ChengAndroidEsStreamCtx* seek_sc = &s_es_ctx;
        pthread_mutex_lock(&seek_sc->fq_mu);
        while (seek_sc->fq_size > 0) {{
          free(seek_sc->fq[seek_sc->fq_head]);
          seek_sc->fq[seek_sc->fq_head] = NULL;
          seek_sc->fq_head = (seek_sc->fq_head + 1) % CHENG_ANDROID_ES_FQ_CAP;
          seek_sc->fq_size--;
        }}
        pthread_cond_signal(&seek_sc->cv_notfull_fq);
        pthread_mutex_unlock(&seek_sc->fq_mu);
        media_status_t es_flush_status = AMediaCodec_flush(texture->codec);
        texture->input_done = 0;
        texture->output_done = 0;
        texture->last_presentation_us = -1;
        texture->playback_anchor_us = -1;
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "es seek ms=%d bridge_ok=%d codec_flush=%d", seekMs, seekOk, (int)es_flush_status);
        /* S7 audio ES seek-sync (video-seek-scrub-blueprint.md §7.1 选项 A, 用户 7/10 拍板①):
           without this, a video seek left the audio ES pump exactly where it was — decoding
           stale pre-seek AUs while frames_played (the declared master clock, see the pacing
           comment a few lines below) kept advancing from the OLD position, permanently
           desyncing audio from the new video position. Runs on THIS SAME thread (the render
           thread's present path — see this function's own header comment and
           cheng_android_aes_decode_pump_on_render_thread's), the ONLY thread that ever touches
           s_aes_ctx/s_aes_codec, so this introduces no new cross-thread dereference (same
           thread-ownership invariant as the video seek block immediately above). Only engages
           when an audio ES pump is actually live (s_aes_engaged) — local-clip audio (胡广生,
           played via cheng_audio_play_local_file, §7.1's still-unmigrated fallback) is
           untouched, matching S3a/S3b's own scope discipline. */
        if (s_aes_engaged) {{
          int32_t seekFrameIdx = (s_es_pump_cursor_fn != NULL) ? s_es_pump_cursor_fn() : -1;
          int32_t aesSeekOk = (seekFrameIdx >= 0 && s_aes_seek_to_video_frame_fn != NULL) ?
                               s_aes_seek_to_video_frame_fn(seekFrameIdx) : 0;
          ChengAndroidAudioEsStreamCtx* aes_sc = &s_aes_ctx;
          pthread_mutex_lock(&aes_sc->fq_mu);
          while (aes_sc->fq_size > 0) {{
            free(aes_sc->fq[aes_sc->fq_head]);
            aes_sc->fq[aes_sc->fq_head] = NULL;
            aes_sc->fq_head = (aes_sc->fq_head + 1) % CHENG_ANDROID_AES_FQ_CAP;
            aes_sc->fq_size--;
          }}
          pthread_cond_signal(&aes_sc->cv_notfull_fq);
          pthread_mutex_unlock(&aes_sc->fq_mu);
          media_status_t aes_flush_status = (s_aes_codec != NULL) ? AMediaCodec_flush(s_aes_codec) : AMEDIA_ERROR_INVALID_OBJECT;
          pthread_mutex_lock(&aes_sc->pcm_mu);
          aes_sc->pcm_head = 0; aes_sc->pcm_tail = 0; aes_sc->pcm_size = 0;
          aes_sc->input_done = 0;
          aes_sc->output_done = 0;
          aes_sc->end_of_stream = 0;
          aes_sc->frames_played = 0;   /* master clock restarts from the new position — write moved
             inside pcm_mu (S7 v2) to close the write-write race with cheng_android_aes_data_callback's
             frames_played += below: without this, the AAudio realtime thread's unlocked read-add-store
             could interleave between this store and the old unlock point and silently keep the
             pre-seek value. Pure field writes only, no calls added to the critical section. */
          pthread_mutex_unlock(&aes_sc->pcm_mu);
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                              "es seek audio frame=%d bridge_ok=%d codec_flush=%d", seekFrameIdx, aesSeekOk, (int)aes_flush_status);
        }}
      }}
      texture->last_playback_state = playback_state;
      if (playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_PLAYING && playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED) {{
        s_media_playback_pause_guard_count++;
        return 0;
      }}
      /* Refill the input FIFO from QUIC on THIS (render) thread before draining — the pump runs in
         the present path, which is driven during playback, so feeding here does not depend on the
         (event-driven) native_tick still ticking. */
      cheng_android_es_prefetch_on_render_thread();
      /* Keep the AUDIO ES fed + decoding from the SAME render-thread present path (native_tick
         can stop when the UI is idle, but present runs every frame during playback). */
      if (s_aes_engaged) {{ cheng_android_aes_decode_pump_on_render_thread(); }}
      ChengAndroidEsStreamCtx* sc = &s_es_ctx;
      /* Feed: drain the FIFO into the codec's input buffers (up to 64/tick). Pop the AU FIRST
         (this is the only consumer of fq_head, on this single render thread), then claim an
         input buffer; if none is available, push the AU back to the head so the offer is never
         lost. */
      for (int feed_i = 0; feed_i < 64; feed_i++) {{
        unsigned char* au = NULL;
        int32_t au_len = 0;
        int64_t au_pts = 0;
        int au_key = 0;
        pthread_mutex_lock(&sc->fq_mu);
        if (sc->fq_size > 0) {{
          au = sc->fq[sc->fq_head];
          au_len = sc->fq_len[sc->fq_head];
          au_pts = sc->fq_pts[sc->fq_head];
          au_key = sc->fq_key[sc->fq_head];
          sc->fq[sc->fq_head] = NULL;
          sc->fq_head = (sc->fq_head + 1) % CHENG_ANDROID_ES_FQ_CAP;
          sc->fq_size--;
          pthread_cond_signal(&sc->cv_notfull_fq);  /* a slot freed → wake the plan-A producer */
        }}
        pthread_mutex_unlock(&sc->fq_mu);
        if (au == NULL) {{ break; }}
        ssize_t in_idx = AMediaCodec_dequeueInputBuffer(texture->codec, 0);
        if (in_idx < 0) {{
          /* no codec input slot — push the AU back to the FIFO head and stop feeding this tick */
          pthread_mutex_lock(&sc->fq_mu);
          sc->fq_head = (sc->fq_head + CHENG_ANDROID_ES_FQ_CAP - 1) % CHENG_ANDROID_ES_FQ_CAP;
          sc->fq[sc->fq_head] = au;
          sc->fq_len[sc->fq_head] = au_len;
          sc->fq_pts[sc->fq_head] = au_pts;
          sc->fq_key[sc->fq_head] = au_key;
          sc->fq_size++;
          pthread_mutex_unlock(&sc->fq_mu);
          break;
        }}
        size_t in_cap = 0;
        uint8_t* in_buf = AMediaCodec_getInputBuffer(texture->codec, (size_t)in_idx, &in_cap);
        if (in_buf == NULL || in_cap == 0u) {{ free(au); break; }}
        if (au_len > (int32_t)in_cap) {{ au_len = (int32_t)in_cap; }}
        memcpy(in_buf, au, (size_t)au_len);
        free(au);
        /* No input flag for keyframes: AMediaCodec detects the IDR + inline SPS/PPS from the
           Annex-B NAL units directly (the publisher inlined them per IDR via h264_mp4toannexb),
           so no AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG / csd is needed. */
        (void)au_key;
        AMediaCodec_queueInputBuffer(texture->codec, (size_t)in_idx, 0u, (size_t)au_len, au_pts, 0u);
      }}
      if (sc->end_of_stream && sc->fq_size <= 0 && !texture->input_done) {{
        ssize_t eos_in_idx = AMediaCodec_dequeueInputBuffer(texture->codec, 0);
        if (eos_in_idx >= 0) {{
          AMediaCodec_queueInputBuffer(texture->codec, (size_t)eos_in_idx, 0u, 0u, 0, AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
          texture->input_done = 1;
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "es input_eos queued asset=%s frames=%d", texture->asset_rel, texture->frame_count);
        }}
      }}
      /* Drain: render every frame whose PTS is due, up to 64/tick. CLOCK SOURCE: when the
         AUDIO ES is engaged and actually producing PCM (frames_played>0), AUDIO IS THE MASTER
         clock — the video frame is released when the audio playback position reaches its PTS,
         so video and audio never drift. Otherwise (no audio track / not yet producing) fall
         back to the monotonic wall-clock anchor (the proven video-only pacing). */
      int64_t pace_now_us = 0;
      int rendered_any = 0;
      int audio_master = (s_aes_engaged && s_aes_ctx.sample_rate > 0 && s_aes_ctx.frames_played > 0) ? 1 : 0;
      for (int drain_i = 0; drain_i < 64; drain_i++) {{
        {{
          struct timespec ts;
          if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) {{
            pace_now_us = (int64_t)ts.tv_sec * 1000000LL + (int64_t)ts.tv_nsec / 1000LL;
          }}
        }}
        if (audio_master) {{
          if (texture->last_presentation_us >= 0) {{
            int64_t audio_clock_us = (int64_t)((double)s_aes_ctx.frames_played * 1000000.0 / (double)s_aes_ctx.sample_rate);
            if (audio_clock_us < texture->last_presentation_us) {{ break; }}
          }}
        }} else if (texture->playback_anchor_us >= 0 && texture->last_presentation_us >= 0) {{
          int64_t elapsed = pace_now_us - texture->playback_anchor_us;
          if (elapsed < texture->last_presentation_us) {{ break; }}
        }}
        AMediaCodecBufferInfo info;
        ssize_t out_idx = AMediaCodec_dequeueOutputBuffer(texture->codec, &info, 0);
        if (out_idx < 0) {{ break; }}
        int render = info.size > 0 ? 1 : 0;
        AMediaCodec_releaseOutputBuffer(texture->codec, (size_t)out_idx, render);
        if ((info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM) != 0) {{
          texture->output_done = 1;
          s_es_engaged = 0;
          s_media_playback_last_state = playback_state;
          s_media_playback_last_presentation_us = texture->last_presentation_us;
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                              "media_playback_eos asset=%s frames=%d presentation_us=%lld es=1",
                              texture->asset_rel, texture->frame_count, (long long)texture->last_presentation_us);
          break;
        }}
        if (!render) {{ continue; }}
        if (!cheng_android_surface_texture_update(env, texture->surface_texture, texture->texture_transform)) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "es_playback_update_failed");
          break;
        }}
        texture->texture_transform_valid = 1;
        if (texture->frame_count == 0) {{
          /* first_media_frame (ES path): unlike whole-file decode, the ES texture starts at
             frame_count=0 (prepare only sets up the decoder) — the first REAL decoded frame
             lands here, asynchronously, on a later render tick. This is the true 秒开 TTFF
             anchor for progressive/network content, distinct from the poster shown while
             ES was still opening. */
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                              "first_media_frame asset=%s source=es decoded=%dx%d t_ms=%lld",
                              texture->asset_rel, texture->width, texture->height, (long long)cheng_epoch_time_ms());
        }}
        texture->frame_count++;
        texture->update_count++;
        texture->last_presentation_us = info.presentationTimeUs;
        if (texture->playback_anchor_us < 0) {{
          texture->playback_anchor_us = pace_now_us - info.presentationTimeUs;
        }}
        s_media_playback_pump_count++;
        s_media_playback_frame_count = texture->frame_count;
        s_media_playback_update_count = texture->update_count;
        s_media_playback_last_state = playback_state;
        s_media_playback_last_presentation_us = texture->last_presentation_us;
        rendered_any = 1;
      }}
      if (rendered_any && cheng_android_media_trace_enabled()) {{
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "media_playback_frame asset=%s frame=%d update=%d presentation_us=%lld playback=%d es=1",
                            texture->asset_rel, texture->frame_count, texture->update_count, (long long)texture->last_presentation_us, playback_state);
      }}
      return rendered_any;
    }}

    static int cheng_android_media_texture_pump_decoder(ChengAndroidMediaTextureCache* texture, JNIEnv* env, int playback_state) {{
      if (texture != NULL && texture->es_mode) {{
        return cheng_android_media_texture_pump_es(texture, env, playback_state);
      }}
      if (texture == NULL || env == NULL || !texture->valid || texture->codec == NULL || texture->extractor == NULL || texture->surface_texture == NULL) {{
        return 0;
      }}
      if (texture->output_done && playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED) {{
        return 0;
      }}
      if (playback_state == CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED && (texture->last_playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED || texture->output_done)) {{
        int64_t seek_target_us = s_android_media_seek_target_us;
        if (seek_target_us < 0) {{ seek_target_us = 0; }}
        media_status_t seek_status = AMediaExtractor_seekTo(texture->extractor, seek_target_us, AMEDIAEXTRACTOR_SEEK_CLOSEST_SYNC);
        media_status_t flush_status = AMediaCodec_flush(texture->codec);
        if (seek_status != AMEDIA_OK || flush_status != AMEDIA_OK) {{
          texture->output_done = 1;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                              "media_playback_seek_failed asset=%s seek=%d flush=%d",
                              texture->asset_rel, (int)seek_status, (int)flush_status);
          return 0;
        }}
        texture->input_done = 0;
        texture->output_done = 0;
        texture->last_presentation_us = -1;
        texture->playback_anchor_us = -1;
        s_media_playback_seek_count++;
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "media_playback_seek asset=%s", texture->asset_rel);
      }}
      texture->last_playback_state = playback_state;
      if (playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_PLAYING && playback_state != CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED) {{
        s_media_playback_pause_guard_count++;
        if (texture->audio.valid) {{
          cheng_android_local_audio_pump_decoder(&texture->audio, playback_state);
        }}
        return 0;
      }}
      if (texture->audio.valid) {{
        cheng_android_local_audio_pump_decoder(&texture->audio, playback_state);
      }}
      int64_t pace_now_us = 0;
      {{
        struct timespec pace_ts;
        if (clock_gettime(CLOCK_MONOTONIC, &pace_ts) == 0) {{
          pace_now_us = (int64_t)pace_ts.tv_sec * 1000000LL + (int64_t)pace_ts.tv_nsec / 1000LL;
        }}
      }}
      // Feed the decoder's input queue aggressively so it stays full; one sample
      // per render tick (the old behavior) capped playback to the tick rate (~3-4 Hz)
      // → ~16x slow. Prime up to 64 access units per tick.
      for (int feed_i = 0; feed_i < 64 && !texture->input_done; feed_i++) {{
        ssize_t input_index = AMediaCodec_dequeueInputBuffer(texture->codec, 0);
        if (input_index < 0) {{
          break;
        }}
        size_t input_size = 0;
        uint8_t* input_buffer = AMediaCodec_getInputBuffer(texture->codec, (size_t)input_index, &input_size);
        if (input_buffer == NULL || input_size == 0u) {{
          texture->output_done = 1;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media_playback_input_buffer_failed asset=%s", texture->asset_rel);
          return 0;
        }}
        ssize_t sample_size = AMediaExtractor_readSampleData(texture->extractor, input_buffer, input_size);
        if (sample_size < 0) {{
          AMediaCodec_queueInputBuffer(texture->codec, (size_t)input_index, 0u, 0u, 0, AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
          texture->input_done = 1;
          break;
        }}
        int64_t sample_time = AMediaExtractor_getSampleTime(texture->extractor);
        uint32_t sample_flags = (uint32_t)AMediaExtractor_getSampleFlags(texture->extractor);
        AMediaCodec_queueInputBuffer(texture->codec, (size_t)input_index, 0u, (size_t)sample_size, sample_time, sample_flags);
        AMediaExtractor_advance(texture->extractor);
      }}
      // Drain output frames, paced to wall-clock realtime: render every frame whose
      // PTS is due (elapsed >= its PTS), re-reading the clock each iteration. This
      // catches playback up to realtime per tick instead of one frame per tick, so a
      // slow render-tick rate no longer slows the video (it drops to the tick's
      // visible rate but progresses in realtime). Cap 64 frames/tick to bound work.
      int rendered_any = 0;
      int audio_master = (texture->audio.valid && texture->audio.sample_rate > 0 && texture->audio.frames_played > 0) ? 1 : 0;
      for (int drain_i = 0; drain_i < 64; drain_i++) {{
        {{
          struct timespec pace_ts2;
          if (clock_gettime(CLOCK_MONOTONIC, &pace_ts2) == 0) {{
            pace_now_us = (int64_t)pace_ts2.tv_sec * 1000000LL + (int64_t)pace_ts2.tv_nsec / 1000LL;
          }}
        }}
        if (audio_master && texture->last_presentation_us >= 0) {{
          int64_t audio_clock_us = (int64_t)((double)texture->audio.frames_played * 1000000.0 / (double)texture->audio.sample_rate);
          if (audio_clock_us < texture->last_presentation_us) {{
            break;
          }}
        }} else if (texture->playback_anchor_us >= 0 && texture->last_presentation_us >= 0) {{
          int64_t pace_elapsed_us = pace_now_us - texture->playback_anchor_us;
          if (pace_elapsed_us < texture->last_presentation_us) {{
            break;
          }}
        }}
        AMediaCodecBufferInfo info;
        ssize_t output_index = AMediaCodec_dequeueOutputBuffer(texture->codec, &info, 0);
        if (output_index < 0) {{
          break;
        }}
        int render = info.size > 0 ? 1 : 0;
        AMediaCodec_releaseOutputBuffer(texture->codec, (size_t)output_index, render);
        if ((info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM) != 0) {{
          texture->output_done = 1;
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                              "media_playback_eos asset=%s frames=%d presentation_us=%lld",
                              texture->asset_rel, texture->frame_count, (long long)texture->last_presentation_us);
          break;
        }}
        if (!render) {{
          continue;
        }}
        if (!cheng_android_surface_texture_update(env, texture->surface_texture, texture->texture_transform)) {{
          texture->output_done = 1;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media_playback_update_failed asset=%s", texture->asset_rel);
          break;
        }}
        texture->texture_transform_valid = 1;
        texture->frame_count++;
        texture->update_count++;
        texture->last_presentation_us = info.presentationTimeUs;
        if (texture->playback_anchor_us < 0) {{
          texture->playback_anchor_us = pace_now_us - info.presentationTimeUs;
        }}
        s_media_playback_pump_count++;
        s_media_playback_frame_count = texture->frame_count;
        s_media_playback_update_count = texture->update_count;
        s_media_playback_last_state = playback_state;
        s_media_playback_last_presentation_us = texture->last_presentation_us;
        rendered_any = 1;
      }}
      if (rendered_any && cheng_android_media_trace_enabled()) {{
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "media_playback_frame asset=%s frame=%d update=%d presentation_us=%lld playback=%d",
                            texture->asset_rel, texture->frame_count, texture->update_count, (long long)texture->last_presentation_us, playback_state);
      }}
      return rendered_any;
    }}

    static int cheng_android_decode_png_asset_file_to_gl_texture(const char* asset_rel, GLuint* out_texture, int* out_width, int* out_height) {{
      if (asset_rel == NULL || out_texture == NULL || out_width == NULL || out_height == NULL) {{
        return 0;
      }}
      off64_t encoded_length = 0;
      int fd = cheng_android_open_headless_asset_fd(asset_rel, &encoded_length);
      if (fd < 0 || encoded_length <= 0) {{
        return 0;
      }}
      AImageDecoder* decoder = NULL;
      int rc = AImageDecoder_createFromFd(fd, &decoder);
      if (rc != ANDROID_IMAGE_DECODER_SUCCESS || decoder == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "png native decoder create failed rel=%s rc=%d",
                            asset_rel, rc);
        close(fd);
        return 0;
      }}
      const AImageDecoderHeaderInfo* info = AImageDecoder_getHeaderInfo(decoder);
      int32_t width = info != NULL ? AImageDecoderHeaderInfo_getWidth(info) : 0;
      int32_t height = info != NULL ? AImageDecoderHeaderInfo_getHeight(info) : 0;
      if (width <= 0 || height <= 0 || width > 8192 || height > 8192) {{
        AImageDecoder_delete(decoder);
        close(fd);
        return 0;
      }}
      if (AImageDecoder_setAndroidBitmapFormat(decoder, ANDROID_BITMAP_FORMAT_RGBA_8888) != ANDROID_IMAGE_DECODER_SUCCESS) {{
        AImageDecoder_delete(decoder);
        close(fd);
        return 0;
      }}
      size_t stride = AImageDecoder_getMinimumStride(decoder);
      size_t tight_stride = (size_t)width * 4u;
      if (stride < tight_stride || stride == 0u) {{
        AImageDecoder_delete(decoder);
        close(fd);
        return 0;
      }}
      int64_t pixel_count64 = (int64_t)width * (int64_t)height;
      if (pixel_count64 <= 0 || pixel_count64 > 67108864LL) {{
        AImageDecoder_delete(decoder);
        close(fd);
        return 0;
      }}
      size_t decoded_size = stride * (size_t)height;
      size_t rgba_size = tight_stride * (size_t)height;
      uint8_t* decoded = (uint8_t*)malloc(decoded_size);
      uint8_t* rgba = (uint8_t*)malloc(rgba_size);
      if (decoded == NULL || rgba == NULL) {{
        free(decoded);
        free(rgba);
        AImageDecoder_delete(decoder);
        close(fd);
        return 0;
      }}
      memset(decoded, 0, decoded_size);
      rc = AImageDecoder_decodeImage(decoder, decoded, stride, decoded_size);
      AImageDecoder_delete(decoder);
      close(fd);
      if (rc != ANDROID_IMAGE_DECODER_SUCCESS) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "png native decode failed rel=%s rc=%d",
                            asset_rel, rc);
        free(decoded);
        free(rgba);
        return 0;
      }}
      for (int32_t y = 0; y < height; y++) {{
        memcpy(rgba + (size_t)y * tight_stride, decoded + (size_t)y * stride, tight_stride);
      }}
      free(decoded);
      GLuint gl_texture = 0u;
      glGenTextures(1, &gl_texture);
      if (gl_texture == 0u) {{
        free(rgba);
        return 0;
      }}
      glBindTexture(GL_TEXTURE_2D, gl_texture);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
      glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
      free(rgba);
      GLenum err = glGetError();
      if (err != GL_NO_ERROR) {{
        glDeleteTextures(1, &gl_texture);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "png native texture upload failed rel=%s gl=%u",
                            asset_rel, (unsigned)err);
        return 0;
      }}
      *out_texture = gl_texture;
      *out_width = (int)width;
      *out_height = (int)height;
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "png native decode ok rel=%s size=%dx%d bytes=%lld",
                          asset_rel, (int)width, (int)height, (long long)encoded_length);
      return 1;
    }}

    static int cheng_android_decode_png_asset_to_gl_texture(JNIEnv* env, const char* asset_rel, GLuint* out_texture, int* out_width, int* out_height) {{
      if (asset_rel == NULL || out_texture == NULL || out_width == NULL || out_height == NULL) {{
        return 0;
      }}
      if ((env == NULL || s_asset_manager_ref == NULL) && getenv("CHENG_HEADLESS_ASSET_DIR") != NULL) {{
        return cheng_android_decode_png_asset_file_to_gl_texture(asset_rel, out_texture, out_width, out_height);
      }}
      if (env == NULL || s_asset_manager_ref == NULL) {{
        return 0;
      }}
      jclass asset_manager_cls = (*env)->GetObjectClass(env, s_asset_manager_ref);
      if (asset_manager_cls == NULL) {{
        return 0;
      }}
      jmethodID open_method = (*env)->GetMethodID(env, asset_manager_cls, "open", "(Ljava/lang/String;)Ljava/io/InputStream;");
      if (open_method == NULL) {{
        (*env)->DeleteLocalRef(env, asset_manager_cls);
        return 0;
      }}
      jstring rel_string = (*env)->NewStringUTF(env, asset_rel);
      if (rel_string == NULL) {{
        (*env)->DeleteLocalRef(env, asset_manager_cls);
        return 0;
      }}
      jobject stream = (*env)->CallObjectMethod(env, s_asset_manager_ref, open_method, rel_string);
      (*env)->DeleteLocalRef(env, rel_string);
      (*env)->DeleteLocalRef(env, asset_manager_cls);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        return 0;
      }}
      if (stream == NULL) {{
        return 0;
      }}
      jclass bitmap_factory_cls = (*env)->FindClass(env, "android/graphics/BitmapFactory");
      if (bitmap_factory_cls == NULL) {{
        (*env)->DeleteLocalRef(env, stream);
        return 0;
      }}
      jmethodID decode_stream = (*env)->GetStaticMethodID(env, bitmap_factory_cls, "decodeStream", "(Ljava/io/InputStream;)Landroid/graphics/Bitmap;");
      if (decode_stream == NULL) {{
        (*env)->DeleteLocalRef(env, bitmap_factory_cls);
        (*env)->DeleteLocalRef(env, stream);
        return 0;
      }}
      jobject bitmap = (*env)->CallStaticObjectMethod(env, bitmap_factory_cls, decode_stream, stream);
      (*env)->DeleteLocalRef(env, bitmap_factory_cls);
      jclass stream_cls = (*env)->GetObjectClass(env, stream);
      if (stream_cls != NULL) {{
        jmethodID close_method = (*env)->GetMethodID(env, stream_cls, "close", "()V");
        if (close_method != NULL) {{
          (*env)->CallVoidMethod(env, stream, close_method);
          if ((*env)->ExceptionCheck(env)) {{
            (*env)->ExceptionClear(env);
          }}
        }}
        (*env)->DeleteLocalRef(env, stream_cls);
      }}
      (*env)->DeleteLocalRef(env, stream);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        return 0;
      }}
      if (bitmap == NULL) {{
        return 0;
      }}
      jclass bitmap_cls = (*env)->GetObjectClass(env, bitmap);
      if (bitmap_cls == NULL) {{
        (*env)->DeleteLocalRef(env, bitmap);
        return 0;
      }}
      jmethodID get_width = (*env)->GetMethodID(env, bitmap_cls, "getWidth", "()I");
      jmethodID get_height = (*env)->GetMethodID(env, bitmap_cls, "getHeight", "()I");
      jmethodID get_pixels = (*env)->GetMethodID(env, bitmap_cls, "getPixels", "([IIIIIII)V");
      if (get_width == NULL || get_height == NULL || get_pixels == NULL) {{
        (*env)->DeleteLocalRef(env, bitmap_cls);
        (*env)->DeleteLocalRef(env, bitmap);
        return 0;
      }}
      jint width = (*env)->CallIntMethod(env, bitmap, get_width);
      jint height = (*env)->CallIntMethod(env, bitmap, get_height);
      if ((*env)->ExceptionCheck(env) || width <= 0 || height <= 0 || width > 8192 || height > 8192) {{
        if ((*env)->ExceptionCheck(env)) {{
          (*env)->ExceptionClear(env);
        }}
        (*env)->DeleteLocalRef(env, bitmap_cls);
        (*env)->DeleteLocalRef(env, bitmap);
        return 0;
      }}
      int64_t pixel_count64 = (int64_t)width * (int64_t)height;
      if (pixel_count64 <= 0 || pixel_count64 > 67108864LL) {{
        (*env)->DeleteLocalRef(env, bitmap_cls);
        (*env)->DeleteLocalRef(env, bitmap);
        return 0;
      }}
      jsize pixel_count = (jsize)pixel_count64;
      jintArray pixel_array = (*env)->NewIntArray(env, pixel_count);
      if (pixel_array == NULL) {{
        (*env)->DeleteLocalRef(env, bitmap_cls);
        (*env)->DeleteLocalRef(env, bitmap);
        return 0;
      }}
      (*env)->CallVoidMethod(env, bitmap, get_pixels, pixel_array, 0, width, 0, 0, width, height);
      (*env)->DeleteLocalRef(env, bitmap_cls);
      (*env)->DeleteLocalRef(env, bitmap);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        (*env)->DeleteLocalRef(env, pixel_array);
        return 0;
      }}
      jint* argb = (jint*)malloc((size_t)pixel_count * sizeof(jint));
      uint8_t* rgba = (uint8_t*)malloc((size_t)pixel_count * 4u);
      if (argb == NULL || rgba == NULL) {{
        free(argb);
        free(rgba);
        (*env)->DeleteLocalRef(env, pixel_array);
        return 0;
      }}
      (*env)->GetIntArrayRegion(env, pixel_array, 0, pixel_count, argb);
      (*env)->DeleteLocalRef(env, pixel_array);
      if ((*env)->ExceptionCheck(env)) {{
        (*env)->ExceptionClear(env);
        free(argb);
        free(rgba);
        return 0;
      }}
      for (jsize i = 0; i < pixel_count; i++) {{
        uint32_t pixel = (uint32_t)argb[i];
        uint32_t alpha = (pixel >> 24u) & 0xffu;
        uint32_t red = (pixel >> 16u) & 0xffu;
        uint32_t green = (pixel >> 8u) & 0xffu;
        uint32_t blue = pixel & 0xffu;
        size_t byte_index = (size_t)i * 4u;
        rgba[byte_index + 0u] = (uint8_t)((red * alpha + 127u) / 255u);
        rgba[byte_index + 1u] = (uint8_t)((green * alpha + 127u) / 255u);
        rgba[byte_index + 2u] = (uint8_t)((blue * alpha + 127u) / 255u);
        rgba[byte_index + 3u] = (uint8_t)alpha;
      }}
      free(argb);
      GLuint gl_texture = 0u;
      glGenTextures(1, &gl_texture);
      if (gl_texture == 0u) {{
        free(rgba);
        return 0;
      }}
      glBindTexture(GL_TEXTURE_2D, gl_texture);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
      glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
      free(rgba);
      GLenum err = glGetError();
      if (err != GL_NO_ERROR) {{
        glDeleteTextures(1, &gl_texture);
        return 0;
      }}
      *out_texture = gl_texture;
      *out_width = (int)width;
      *out_height = (int)height;
      return 1;
    }}

    int cheng_mobile_host_prepare_media_surface_texture(int kindCode,
                                                        int surfaceKind,
                                                        int textureProvider,
                                                        const char* slotId,
                                                        const char* assetCid,
                                                        const char* manifestCid,
                                                        const char* posterCid,
                                                        int width,
                                                        int height,
                                                        const char* peerHost,
                                                        int peerPort,
                                                        int playbackState) {{
      int localFileMedia = cheng_android_is_local_file_media_uri(assetCid);
      if (kindCode <= 0 || kindCode > CHENG_ANDROID_MEDIA_SURFACE_AUDIO_COVER_TEXTURE ||
          surfaceKind != kindCode ||
          (textureProvider != CHENG_ANDROID_MEDIA_TEXTURE_PROVIDER_METAL_SURFACE &&
           textureProvider != CHENG_ANDROID_MEDIA_TEXTURE_PROVIDER_SURFACE) ||
          slotId == NULL || assetCid == NULL || manifestCid == NULL || posterCid == NULL ||
          ((!localFileMedia && (!cheng_android_is_hex_sha256(assetCid) ||
                                !cheng_android_is_hex_sha256(manifestCid) ||
                                !cheng_android_is_hex_sha256(posterCid))) ||
           (localFileMedia && (kindCode != CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE ||
                               strcmp(manifestCid, "local-file") != 0 ||
                               !cheng_android_is_local_file_media_uri(posterCid)))) ||
          width <= 0 || height <= 0 ||
          playbackState < 0 ||
          playbackState > 6) {{
        s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_INVALID_BATCH;
        cheng_android_record_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_INVALID_BATCH,
                                                   kindCode, surfaceKind, textureProvider,
                                                   0, 0, 0, 0, 0u, width, height, 0, 0);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "prepare_media_surface invalid kind=%d surface=%d provider=%d asset=%s manifest=%s poster=%s",
                            kindCode, surfaceKind, textureProvider,
                            assetCid != NULL ? assetCid : "", manifestCid != NULL ? manifestCid : "", posterCid != NULL ? posterCid : "");
        return 0;
      }}
      int slotHash = cheng_android_hash31(slotId);
      int assetHash = cheng_android_hash31(assetCid);
      int manifestHash = cheng_android_hash31(manifestCid);
      int posterHash = cheng_android_hash31(posterCid);
      if (slotHash <= 0 || assetHash <= 0 || manifestHash <= 0 || posterHash <= 0) {{
        s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_INVALID_BATCH;
        cheng_android_record_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_INVALID_BATCH,
                                                   kindCode, surfaceKind, textureProvider,
                                                   slotHash, assetHash, manifestHash, posterHash,
                                                   0u, width, height, 0, 0);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "prepare_media_surface invalid hashes=%d,%d,%d,%d asset=%s manifest=%s poster=%s",
                            slotHash, assetHash, manifestHash, posterHash, assetCid, manifestCid, posterCid);
        return 0;
      }}
      cheng_android_record_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED,
                                                 kindCode, surfaceKind, textureProvider,
                                                 slotHash, assetHash, manifestHash, posterHash,
                                                 0u, width, height, 0, 0);
      int playbackWantsVideo = kindCode == CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE &&
                               (playbackState == CHENG_ANDROID_MEDIA_PLAYBACK_PLAYING ||
                                playbackState == CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED);
      ChengAndroidMediaTextureCache* existing = cheng_android_find_media_texture(kindCode, surfaceKind, textureProvider, slotHash, assetHash, manifestHash, posterHash);
      if (existing != NULL && existing->valid && existing->gl_texture != 0u && existing->width > 0 && existing->height > 0) {{
        if (kindCode != CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE ||
            !playbackWantsVideo ||
            existing->texture_target == GL_TEXTURE_EXTERNAL_OES) {{
          cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_READY,
                                                  existing->kind_code, existing->surface_kind, existing->texture_provider,
                                                  existing->slot_hash, existing->asset_hash, existing->manifest_hash, existing->poster_hash,
                                                  existing->gl_texture, existing->width, existing->height,
                                                  existing->pixel_format, existing->texture_target);
          return 1;
        }}
      }}
      int headless_asset_mode = (s_headless_capture && getenv("CHENG_HEADLESS_ASSET_DIR") != NULL) ? 1 : 0;
      if ((!s_headless_capture && (s_active_window == NULL || s_active_width <= 0 || s_active_height <= 0)) ||
          (!headless_asset_mode && s_asset_manager == NULL)) {{
        s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE;
        cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE,
                                                kindCode, surfaceKind, textureProvider,
                                                slotHash, assetHash, manifestHash, posterHash,
                                                0u, width, height, 0, 0);
        return 0;
      }}
      JNIEnv* env = cheng_android_jni_env();
      if (s_headless_capture) {{
        cheng_android_gpu_ensure_offscreen(width, height);
      }} else {{
        if (env == NULL) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE;
          cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE,
                                                  kindCode, surfaceKind, textureProvider,
                                                  slotHash, assetHash, manifestHash, posterHash,
                                                  0u, width, height, 0, 0);
          return 0;
        }}
        cheng_android_gpu_ensure(s_active_window, s_active_width, s_active_height);
      }}
      if (kindCode == CHENG_ANDROID_MEDIA_SURFACE_IMAGE_RASTER_TEXTURE) {{
        char image_asset_rel[128];
        int image_rel_len = snprintf(image_asset_rel, sizeof(image_asset_rel), "runtime/media/assets/%s.png", assetCid);
        if (image_rel_len <= 0 || image_rel_len >= (int)sizeof(image_asset_rel)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          return 0;
        }}
        GLuint image_texture = 0u;
        int image_width = 0;
        int image_height = 0;
        if (!cheng_android_decode_png_asset_to_gl_texture(env, image_asset_rel, &image_texture, &image_width, &image_height)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "prepare_media_surface image_decode_failed asset=%s rel=%s", assetCid, image_asset_rel);
          return 0;
        }}
        ChengAndroidMediaTextureCache* texture = cheng_android_find_or_allocate_media_texture(kindCode, surfaceKind, textureProvider, slotHash, assetHash, manifestHash, posterHash);
        if (texture == NULL) {{
          glDeleteTextures(1, &image_texture);
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE;
          cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE,
                                                  kindCode, surfaceKind, textureProvider,
                                                  slotHash, assetHash, manifestHash, posterHash,
                                                  0u, image_width, image_height, GL_RGBA8, GL_TEXTURE_2D);
          return 0;
        }}
        cheng_android_media_texture_release(texture);
        texture->valid = 1;
        texture->kind_code = kindCode;
        texture->surface_kind = surfaceKind;
        texture->texture_provider = textureProvider;
        texture->slot_hash = slotHash;
        texture->asset_hash = assetHash;
        texture->manifest_hash = manifestHash;
        texture->poster_hash = posterHash;
        texture->width = image_width;
        texture->height = image_height;
        texture->pixel_format = GL_RGBA8;
        texture->texture_target = GL_TEXTURE_2D;
        texture->gl_texture = image_texture;
        texture->frame_count = 1;
        texture->update_count = 1;
        texture->last_presentation_us = 0;
        texture->last_playback_state = CHENG_ANDROID_MEDIA_PLAYBACK_OPENED;
        snprintf(texture->asset_rel, sizeof(texture->asset_rel), "%s", image_asset_rel);
        cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_READY,
                                                kindCode, surfaceKind, textureProvider,
                                                slotHash, assetHash, manifestHash, posterHash,
                                                image_texture, image_width, image_height,
                                                texture->pixel_format, texture->texture_target);
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "prepare_media_surface image_ok asset=%s texture=%u decoded=%dx%d hashes=%d,%d,%d,%d receipt=%d,%d,%d,%d,%d,%d",
                            assetCid, image_texture, image_width, image_height, slotHash, assetHash, manifestHash, posterHash,
                            s_media_surface_prepare_count, s_media_surface_prepare_status,
                            s_media_surface_prepare_kind, s_media_surface_prepare_surface_kind,
                            s_media_surface_prepare_gl_texture, s_media_surface_prepare_pixel_format);
        return 1;
      }}
      if (kindCode == CHENG_ANDROID_MEDIA_SURFACE_AUDIO_COVER_TEXTURE) {{
        char cover_asset_rel[128];
        int cover_rel_len = snprintf(cover_asset_rel, sizeof(cover_asset_rel), "runtime/media/assets/%s.png", posterCid);
        if (cover_rel_len <= 0 || cover_rel_len >= (int)sizeof(cover_asset_rel)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          return 0;
        }}
        GLuint cover_texture = 0u;
        int cover_width = 0;
        int cover_height = 0;
        if (!cheng_android_decode_png_asset_to_gl_texture(env, cover_asset_rel, &cover_texture, &cover_width, &cover_height)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "prepare_media_surface audio_cover_decode_failed asset=%s poster=%s rel=%s", assetCid, posterCid, cover_asset_rel);
          return 0;
        }}
        ChengAndroidMediaTextureCache* texture = cheng_android_find_or_allocate_media_texture(kindCode, surfaceKind, textureProvider, slotHash, assetHash, manifestHash, posterHash);
        if (texture == NULL) {{
          glDeleteTextures(1, &cover_texture);
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE;
          cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE,
                                                  kindCode, surfaceKind, textureProvider,
                                                  slotHash, assetHash, manifestHash, posterHash,
                                                  0u, cover_width, cover_height, GL_RGBA8, GL_TEXTURE_2D);
          return 0;
        }}
        cheng_android_media_texture_release(texture);
        texture->valid = 1;
        texture->kind_code = kindCode;
        texture->surface_kind = surfaceKind;
        texture->texture_provider = textureProvider;
        texture->slot_hash = slotHash;
        texture->asset_hash = assetHash;
        texture->manifest_hash = manifestHash;
        texture->poster_hash = posterHash;
        texture->width = cover_width;
        texture->height = cover_height;
        texture->pixel_format = GL_RGBA8;
        texture->texture_target = GL_TEXTURE_2D;
        texture->gl_texture = cover_texture;
        texture->frame_count = 1;
        texture->update_count = 1;
        texture->last_presentation_us = 0;
        texture->last_playback_state = CHENG_ANDROID_MEDIA_PLAYBACK_OPENED;
        snprintf(texture->asset_rel, sizeof(texture->asset_rel), "%s", cover_asset_rel);
        cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_READY,
                                                kindCode, surfaceKind, textureProvider,
                                                slotHash, assetHash, manifestHash, posterHash,
                                                cover_texture, cover_width, cover_height,
                                                texture->pixel_format, texture->texture_target);
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "prepare_media_surface audio_cover_ok asset=%s poster=%s texture=%u decoded=%dx%d hashes=%d,%d,%d,%d receipt=%d,%d,%d,%d,%d,%d",
                            assetCid, posterCid, cover_texture, cover_width, cover_height, slotHash, assetHash, manifestHash, posterHash,
                            s_media_surface_prepare_count, s_media_surface_prepare_status,
                            s_media_surface_prepare_kind, s_media_surface_prepare_surface_kind,
                            s_media_surface_prepare_gl_texture, s_media_surface_prepare_pixel_format);
        return 1;
      }}
      if (kindCode == CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE && env == NULL && s_headless_capture) {{
        char poster_asset_rel[128];
        int poster_rel_len = snprintf(poster_asset_rel, sizeof(poster_asset_rel), "runtime/media/assets/%s.png", posterCid);
        if (poster_rel_len <= 0 || poster_rel_len >= (int)sizeof(poster_asset_rel)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          return 0;
        }}
        GLuint poster_texture = 0u;
        int poster_width = 0;
        int poster_height = 0;
        if (!cheng_android_decode_png_asset_to_gl_texture(env, poster_asset_rel, &poster_texture, &poster_width, &poster_height)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "prepare_media_surface video_poster_decode_failed asset=%s poster=%s rel=%s", assetCid, posterCid, poster_asset_rel);
          return 0;
        }}
        ChengAndroidMediaTextureCache* texture = cheng_android_find_or_allocate_media_texture(kindCode, surfaceKind, textureProvider, slotHash, assetHash, manifestHash, posterHash);
        if (texture == NULL) {{
          glDeleteTextures(1, &poster_texture);
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE;
          cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE,
                                                  kindCode, surfaceKind, textureProvider,
                                                  slotHash, assetHash, manifestHash, posterHash,
                                                  0u, poster_width, poster_height, GL_RGBA8, GL_TEXTURE_2D);
          return 0;
        }}
        cheng_android_media_texture_release(texture);
        texture->valid = 1;
        texture->kind_code = kindCode;
        texture->surface_kind = surfaceKind;
        texture->texture_provider = textureProvider;
        texture->slot_hash = slotHash;
        texture->asset_hash = assetHash;
        texture->manifest_hash = manifestHash;
        texture->poster_hash = posterHash;
        texture->width = poster_width;
        texture->height = poster_height;
        texture->pixel_format = GL_RGBA8;
        texture->texture_target = GL_TEXTURE_2D;
        texture->gl_texture = poster_texture;
        texture->frame_count = 1;
        texture->update_count = 1;
        texture->last_presentation_us = 0;
        texture->last_playback_state = CHENG_ANDROID_MEDIA_PLAYBACK_OPENED;
        snprintf(texture->asset_rel, sizeof(texture->asset_rel), "%s", poster_asset_rel);
        cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_READY,
                                                kindCode, surfaceKind, textureProvider,
                                                slotHash, assetHash, manifestHash, posterHash,
                                                poster_texture, poster_width, poster_height,
                                                texture->pixel_format, texture->texture_target);
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "prepare_media_surface video_poster_ok asset=%s poster=%s texture=%u decoded=%dx%d hashes=%d,%d,%d,%d",
                            assetCid, posterCid, poster_texture, poster_width, poster_height,
                            slotHash, assetHash, manifestHash, posterHash);
        return 1;
      }}
      if (env == NULL) {{
        s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE;
        cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE,
                                                kindCode, surfaceKind, textureProvider,
                                                slotHash, assetHash, manifestHash, posterHash,
                                                0u, width, height, 0, 0);
        return 0;
      }}
      if (kindCode == CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE &&
          !playbackWantsVideo &&
          !localFileMedia) {{
        /* 秒开 prefetch, decoupled from playback: arm the ES announce/index fetch NOW,
           while the poster is being shown (the user has not tapped play yet) — instead of
           waiting for playbackWantsVideo below, which only becomes true after the tap this
           fetch is meant to get ahead of. cheng_android_es_start_once's atomic guards make
           this idempotent: the later play-time engage branch finds the fetch already done
           (or in flight) and reuses it, it never redials. Does not decode/engage anything
           here — the poster path below is unchanged. */
        cheng_android_es_arm_prefetch(peerHost, peerPort);
        char poster_asset_rel[128];
        int poster_rel_len = snprintf(poster_asset_rel, sizeof(poster_asset_rel), "runtime/media/assets/%s.png", posterCid);
        if (poster_rel_len <= 0 || poster_rel_len >= (int)sizeof(poster_asset_rel)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          return 0;
        }}
        GLuint poster_texture = 0u;
        int poster_width = 0;
        int poster_height = 0;
        if (!cheng_android_decode_png_asset_to_gl_texture(env, poster_asset_rel, &poster_texture, &poster_width, &poster_height)) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "prepare_media_surface video_poster_only_decode_failed asset=%s poster=%s rel=%s playback=%d", assetCid, posterCid, poster_asset_rel, playbackState);
          return 0;
        }}
        ChengAndroidMediaTextureCache* texture = cheng_android_find_or_allocate_media_texture(kindCode, surfaceKind, textureProvider, slotHash, assetHash, manifestHash, posterHash);
        if (texture == NULL) {{
          glDeleteTextures(1, &poster_texture);
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE;
          cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE,
                                                  kindCode, surfaceKind, textureProvider,
                                                  slotHash, assetHash, manifestHash, posterHash,
                                                  0u, poster_width, poster_height, GL_RGBA8, GL_TEXTURE_2D);
          return 0;
        }}
        cheng_android_media_texture_release(texture);
        texture->valid = 1;
        texture->kind_code = kindCode;
        texture->surface_kind = surfaceKind;
        texture->texture_provider = textureProvider;
        texture->slot_hash = slotHash;
        texture->asset_hash = assetHash;
        texture->manifest_hash = manifestHash;
        texture->poster_hash = posterHash;
        texture->width = poster_width;
        texture->height = poster_height;
        texture->pixel_format = GL_RGBA8;
        texture->texture_target = GL_TEXTURE_2D;
        texture->gl_texture = poster_texture;
        texture->poster_gl_texture = poster_texture;
        texture->poster_width = poster_width;
        texture->poster_height = poster_height;
        texture->frame_count = 1;
        texture->update_count = 1;
        texture->last_presentation_us = 0;
        texture->last_playback_state = playbackState;
        snprintf(texture->asset_rel, sizeof(texture->asset_rel), "poster:%s", assetCid);
        cheng_android_set_media_surface_prepare(CHENG_ANDROID_MEDIA_SURFACE_STATUS_READY,
                                                kindCode, surfaceKind, textureProvider,
                                                slotHash, assetHash, manifestHash, posterHash,
                                                poster_texture, poster_width, poster_height,
                                                texture->pixel_format, texture->texture_target);
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "prepare_media_surface video_poster_only_ok asset=%s poster=%s texture=%u decoded=%dx%d hashes=%d,%d,%d,%d playback=%d",
                            assetCid, posterCid, poster_texture, poster_width, poster_height,
                            slotHash, assetHash, manifestHash, posterHash, playbackState);
        return 1;
      }}
      if (localFileMedia && kindCode == CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE) {{
        GLuint external_texture = 0u;
        glGenTextures(1, &external_texture);
        if (external_texture == 0u) {{
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          return 0;
        }}
        glBindTexture(GL_TEXTURE_EXTERNAL_OES, external_texture);
        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
        jobject surface_texture = NULL;
        jobject surface = NULL;
        ANativeWindow* decode_window = NULL;
        if (!cheng_android_create_decoder_surface(env, external_texture, &surface_texture, &surface, &decode_window)) {{
          glDeleteTextures(1, &external_texture);
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          return 0;
        }}
        int decoded_width = 0;
        int decoded_height = 0;
        AMediaExtractor* extractor = NULL;
        AMediaCodec* codec = NULL;
        int input_done = 0;
        int output_done = 0;
        int64_t last_presentation_us = -1;
        int rotation_degrees = 0;
        float texture_transform[16];
        if (!cheng_android_decode_video_first_frame_to_surface(assetCid, env, surface_texture, decode_window, &decoded_width, &decoded_height, &extractor, &codec, &input_done, &output_done, &last_presentation_us, &rotation_degrees) ||
            !cheng_android_surface_texture_update(env, surface_texture, texture_transform)) {{
          if (codec != NULL) {{
            AMediaCodec_stop(codec);
            AMediaCodec_delete(codec);
          }}
          if (extractor != NULL) {{
            AMediaExtractor_delete(extractor);
          }}
          if (decode_window != NULL) {{
            ANativeWindow_release(decode_window);
          }}
          (*env)->DeleteGlobalRef(env, surface);
          (*env)->DeleteGlobalRef(env, surface_texture);
          glDeleteTextures(1, &external_texture);
          s_present_media_surface_status = CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED;
          return 0;
        }}
        /* first_media_frame: the synchronous decode above already latched a REAL decoded
           video frame onto the external OES texture (cheng_android_surface_texture_update
           just succeeded) — distinct from a poster/placeholder image. Single, parseable
           anchor for device-perf-oracle TTFF measurement (秒开), emitted once per prepare
           call (this whole-file/local-file path decodes frame 1 synchronously, unlike the
           ES path where the first frame arrives later on the render-thread pump). */
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "first_media_frame asset=%s source=local_file decoded=%dx%d t_ms=%lld",
