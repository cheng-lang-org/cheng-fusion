       resolves via importc; keep it in C linkage so symbols are unmangled. */
    // ---- M3 wave2 absorption compat shims (mirrors ohos_android_compat.h) ----
    // Several functions absorbed byte-identical from cheng_gui_host_gen.c below
    // still use the Android-native spellings; keep those two macros + the window
    // alias so the literal text compiles unchanged on OHOS, same as the hand file.
    #define ANDROID_LOG_DEBUG LOG_DEBUG
    #define ANDROID_LOG_INFO LOG_INFO
    #define ANDROID_LOG_WARN LOG_WARN
    #define ANDROID_LOG_ERROR LOG_ERROR
    #define __android_log_print(level, tag, ...) OH_LOG_Print(LOG_APP, (LogLevel)(level), 0xC0DE, (tag), __VA_ARGS__)
