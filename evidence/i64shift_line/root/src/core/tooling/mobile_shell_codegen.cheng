                                 files,
                                 outError):
        return false
    outCopied = true
    return true

@borrows
fn MobileShellCopyOptionalComputerUseManifestFromSource(opts: MobileShellOptions,
                                                          sourceRoot: str,
                                                          files: var str[],
                                                          outCopied: var bool,
                                                          outError: var str): bool =
    if outCopied:
        return true
    let directSource: str = os.JoinPath(sourceRoot, "unimaker_computer_use_manifest.json")
    let runtimeSource: str = os.JoinPath(sourceRoot, MobileShellRuntimeComputerUseManifestRelPath())
    var sourcePath: str
    if os.FileExists(directSource):
        sourcePath = directSource
    elif os.FileExists(runtimeSource):
        sourcePath = runtimeSource
    else:
        return true
    if !MobileShellCopyRawFile(opts,
                                 sourcePath,
                                 MobileShellRuntimeComputerUseManifestRelPath(),
