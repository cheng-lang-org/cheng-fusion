	        private fun handleComputerUseTextIntent(sourceIntent: Intent?) {{
	            val handle = runtimeHandle
	            if (handle == 0L || sourceIntent == null) {{
	                return
	            }}
	            val text = computerUseTextFromIntent(sourceIntent) ?: return
	            postPriorityRender {{
	                val result = if (runtimeHandle == handle) nativeSubmitComputerUseText(handle, text) else -2147483647
	                if (result > 0) {{
	                    syncRuntimeStorageDirty(handle)
	                }}
	                val title = if (result == 1 || result == 2) {{
	                    if (runtimeHandle == handle) nativeComputerUseLastTitle(handle) else ""
	                }} else {{
	                    ""
	                }}
	                mainHandler.post {{
	                    if (runtimeHandle == handle) {{
	                        showComputerUseNativeTask(text, result, title, 0)
	                        if (result > 0) {{
	                            maybeResolveComputerUseVideoMedia(handle, result, title)
	                            requestFrame()
	                        }}
	                    }}
	                }}
	            }}
	        }}

        private fun routeNeedsPublishLocation(routeState: String): Boolean {{
            return routeState.startsWith("publish_") && routeState != "publish_selector"
        }}

	        private fun hasPublishLocationPermission(): Boolean {{
	            return checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||
	                checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED
	        }}

	        private fun validateRuntimeStorageKey(storageKey: String) {{
	            if (storageKey.isEmpty() || storageKey.length > 128) {{
	                throw IllegalArgumentException("invalid runtime storage key length=" + storageKey.length)
	            }}
	            for (ch in storageKey) {{
	                val ok = (ch >= 'a' && ch <= 'z') ||
	                    (ch >= 'A' && ch <= 'Z') ||
	                    (ch >= '0' && ch <= '9') ||
	                    ch == '_' || ch == '-' || ch == '.'
	                if (!ok) {{
	                    throw IllegalArgumentException("invalid runtime storage key=" + storageKey)
	                }}
	            }}
	        }}

	        private fun restoreRuntimeStorage(handle: Long) {{
	            if (handle == 0L) {{
	                return
	            }}
	            val entries = getSharedPreferences(CHENG_RUNTIME_STORAGE_PREFS, Context.MODE_PRIVATE).all
	            var restored = 0
	            for ((storageKey, rawValue) in entries) {{
	                validateRuntimeStorageKey(storageKey)
	                if (rawValue !is String) {{
	                    throw IllegalStateException("runtime storage value is not a string key=" + storageKey)
	                }}
	                val ok = nativeSetStorage(handle, storageKey, rawValue)
	                if (!ok) {{
	                    throw IllegalStateException("runtime storage restore failed key=" + storageKey)
	                }}
	                restored += 1
	            }}
	            if (restored > 0) {{
	                Log.i("cheng-mobile-shell", "runtime storage restored count=" + restored)
	            }}
	        }}

	        private fun syncRuntimeStorageDirty(handle: Long) {{
	            if (handle == 0L || runtimeHandle != handle) {{
	                return
	            }}
	            val dirtyCount = nativeStorageDirtyCount(handle)
	            if (dirtyCount <= 0) {{
	                return
	            }}
	            val prefs = getSharedPreferences(CHENG_RUNTIME_STORAGE_PREFS, Context.MODE_PRIVATE)
	            val editor = prefs.edit()
	            val dirtyKeys = ArrayList<String>(dirtyCount)
	            var i = 0
	            while (i < dirtyCount) {{
	                val storageKey = nativeStorageDirtyKey(handle, i)
	                validateRuntimeStorageKey(storageKey)
	                val value = nativeStorageDirtyValue(handle, i)
	                editor.putString(storageKey, value)
	                dirtyKeys.add(storageKey)
	                i += 1
	            }}
	            if (!editor.commit()) {{
	                throw IllegalStateException("runtime storage commit failed count=" + dirtyCount)
	            }}
	            for (storageKey in dirtyKeys) {{
	                val cleared = nativeStorageClearDirty(handle, storageKey)
	                if (!cleared) {{
	                    throw IllegalStateException("runtime storage dirty clear failed key=" + storageKey)
	                }}
	            }}
	            Log.i("cheng-mobile-shell", "runtime storage synced dirty_count=" + dirtyCount)
	        }}

	        private fun dispatchRuntimeState(stateRef: String, value: String) {{
	            validateStateRef(stateRef)
	            val handle = runtimeHandle
	            if (handle == 0L) {{
                return
            }}
	            postRender {{
	                val ok = if (runtimeHandle == handle) nativeSetState(handle, stateRef, value) else false
	                val shouldRetryComputerUsePublish = ok &&
	                    stateRef == CHENG_PUBLISH_LOCATION_STATUS_REF &&
		                    value.trim() == "success"
	                if (ok) {{
	                    if (stateRef == CHENG_PUBLISH_LOCATION_STATE_REF) {{
	                        chengPublishVisibleLocationAddress = value.trim()
	                    }}
	                    syncRuntimeStorageDirty(handle)
	                }}
	                Log.i("cheng-mobile-shell", "runtime state set state_ref=" + stateRef + " value_len=" + value.length + " ok=" + ok)
                mainHandler.post {{
                    if (ok && runtimeHandle == handle) {{
	                        if (shouldRetryComputerUsePublish) {{
	                            retryPendingComputerUsePublish("location_ready")
	                        }}
                        requestFrame()
                    }}
                }}
            }}
        }}

        private fun appendUniqueAddressPart(parts: MutableList<String>, raw: String?) {{
            val value = raw?.trim() ?: return
            if (value.isEmpty()) {{
                return
            }}
            if (parts.isEmpty() || parts[parts.size - 1] != value) {{
                parts.add(value)
            }}
        }}

        private fun publishLocationAddressLabel(location: Location): String {{
            val geocoder = Geocoder(this, Locale.getDefault())
            val addresses = geocoder.getFromLocation(location.latitude, location.longitude, 1)
            val address = addresses?.firstOrNull() ?: return ""
            val parts = mutableListOf<String>()
            appendUniqueAddressPart(parts, address.countryName)
            appendUniqueAddressPart(parts, address.adminArea)
            appendUniqueAddressPart(parts, address.locality)
            appendUniqueAddressPart(parts, address.subLocality)
            if (parts.isNotEmpty()) {{
                return parts.joinToString("")
            }}
            return address.getAddressLine(0)?.trim() ?: ""
        }}

        private fun publishRuntimeLocation(location: Location) {{
            Thread(null, Runnable {{
                val label = try {{
                    publishLocationAddressLabel(location)
                }} catch (error: IOException) {{
                    Log.e("cheng-mobile-shell", "publish location reverse geocode failed", error)
                    ""
                }}
                Log.i("cheng-mobile-shell", "publish location geocoder label_len=" + label.length)
                if (label.isNotEmpty()) {{
                    mainHandler.post {{
	                        dispatchRuntimeState(CHENG_PUBLISH_LOCATION_STATE_REF, label)
	                        dispatchRuntimeState(CHENG_PUBLISH_LOCATION_STATUS_REF, "success")
                    }}
                }}
            }}, "ChengPublishLocationGeocoder").start()
        }}

        private fun requestPublishLocation() {{
            if (!hasPublishLocationPermission()) {{
                Log.w("cheng-mobile-shell", "publish location permission missing")
                dispatchRuntimeState(CHENG_PUBLISH_LOCATION_STATUS_REF, "permission_denied")
                dispatchRuntimeState(CHENG_PUBLISH_LOCATION_MESSAGE_REF, "定位权限被拒绝，请在系统设置中开启定位权限")
                return
            }}
            val manager = getSystemService(Context.LOCATION_SERVICE) as LocationManager
            val providers = manager.getProviders(true)
            if (providers.isEmpty()) {{
                Log.w("cheng-mobile-shell", "publish location provider unavailable")
                dispatchRuntimeState(CHENG_PUBLISH_LOCATION_STATUS_REF, "unavailable")
                dispatchRuntimeState(CHENG_PUBLISH_LOCATION_MESSAGE_REF, "定位服务不可用，请检查 GPS 开关")
                return
            }}
            val provider = when {{
                providers.contains(LocationManager.NETWORK_PROVIDER) -> LocationManager.NETWORK_PROVIDER
                providers.contains(LocationManager.GPS_PROVIDER) -> LocationManager.GPS_PROVIDER
                else -> providers[0]
            }}
            Log.i("cheng-mobile-shell", "publish location request provider=" + provider)
            manager.requestSingleUpdate(provider, object : LocationListener {{
                override fun onLocationChanged(location: Location) {{
                    Log.i("cheng-mobile-shell", "publish location received provider=" + location.provider)
                    manager.removeUpdates(this)
                    publishRuntimeLocation(location)
                }}
            }}, Looper.getMainLooper())
        }}

        private fun requestPublishLocationIfNeeded(routeState: String) {{
            if (publishLocationRequested || !routeNeedsPublishLocation(routeState)) {{
                Log.i("cheng-mobile-shell", "publish location skip route_state=" + routeState + " requested=" + publishLocationRequested)
                return
            }}
            publishLocationRequested = true
            if (!hasPublishLocationPermission()) {{
                requestPermissions(arrayOf(Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION), CHENG_LOCATION_PERMISSION_REQUEST)
                return
            }}
            requestPublishLocation()
        }}

        private fun locationCoordinateLabel(location: Location): String {{
            return String.format(Locale.US, "%.6f, %.6f", location.latitude, location.longitude)
        }}

        private fun writeCapturedLocation(location: Location, previewRef: String, statusRef: String, messageRef: String) {{
            // Publish pages match React prepareLocation(): success is not observable until the
            // desensitized address label is available. Chat can publish the coordinate label
            // immediately because the visible preview is the coordinate itself.
            if (previewRef == "locationMessage") {{
                Thread(null, Runnable {{
                    var label = try {{
                        publishLocationAddressLabel(location)
                    }} catch (error: IOException) {{
                        Log.e("cheng-mobile-shell", "location_capture android_geocoder failed", error)
                        ""
                    }}
                    if (label.isEmpty()) {{
                        val address = reverseGeocodeChain(location.latitude, location.longitude)
                        label = if (address != null) formatReverseGeocodeLabel(address) else ""
                    }}
                    Log.i("cheng-mobile-shell", "location_capture reverse_geocode preview_ref=" + previewRef + " label_len=" + label.length)
                    if (label.isNotEmpty()) {{
                        mainHandler.post {{
	                            dispatchRuntimeState(previewRef, label)
	                            dispatchRuntimeState(statusRef, "success")
	                            if (messageRef != previewRef) {{
	                                dispatchRuntimeState(messageRef, "")
	                            }}
                        }}
                    }} else {{
                        mainHandler.post {{
                            writeLocationCaptureFailure(statusRef, messageRef, "unavailable", "定位失败，请重试")
                        }}
                    }}
                }}, "ChengReverseGeocode").start()
            }} else {{
                val coord = locationCoordinateLabel(location)
                Log.i("cheng-mobile-shell", "location_capture coord preview_ref=" + previewRef)
                mainHandler.post {{
                    dispatchRuntimeState(previewRef, coord)
	                    dispatchRuntimeState(statusRef, "success")
	                    if (messageRef != previewRef) {{
	                        dispatchRuntimeState(messageRef, "")
	                    }}
                }}
            }}
        }}

        private fun reverseGeocodeHttpGetJson(urlStr: String, timeoutMs: Int, userAgent: String?): JSONObject? {{
            return try {{
                val conn = java.net.URL(urlStr).openConnection() as java.net.HttpURLConnection
                conn.connectTimeout = timeoutMs
                conn.readTimeout = timeoutMs
                conn.requestMethod = "GET"
                conn.setRequestProperty("Accept", "application/json")
                if (userAgent != null) {{
                    conn.setRequestProperty("User-Agent", userAgent)
                }}
                val code = conn.responseCode
                if (code != 200) {{
                    conn.disconnect()
                    return null
                }}
                val text = conn.inputStream.bufferedReader().use {{ reader -> reader.readText() }}
                conn.disconnect()
                JSONObject(text)
            }} catch (t: Throwable) {{
                Log.w("cheng-mobile-shell", "reverse_geocode http failed " + t.toString())
                null
            }}
        }}

        private fun reverseGeocodeJsonText(obj: JSONObject?, key: String): String {{
            if (obj == null) {{
                return ""
            }}
            val value = obj.opt(key) ?: return ""
            return value.toString().trim()
        }}

        private fun reverseGeocodeFirstText(vararg values: String): String {{
            for (value in values) {{
                if (value.isNotEmpty()) {{
                    return value
                }}
            }}
            return ""
        }}

        private fun reverseGeocodeIsTownshipLike(value: String): Boolean {{
            return Regex("(镇|乡|街道|苏木)$").containsMatchIn(value.trim())
        }}

        private fun reverseGeocodeNominatim(lat: Double, lon: Double): Array<String>? {{
            val url = "https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&zoom=18&lat=" + lat + "&lon=" + lon + "&accept-language=zh-CN"
            val root = reverseGeocodeHttpGetJson(url, 8000, "UniMaker/1.0 (reverse-geocode)") ?: return null
            val a = root.optJSONObject("address") ?: return null
            val cityByPrec = reverseGeocodeFirstText(reverseGeocodeJsonText(a, "city"), reverseGeocodeJsonText(a, "municipality"), reverseGeocodeJsonText(a, "state_district"), reverseGeocodeJsonText(a, "region"), reverseGeocodeJsonText(a, "county"), reverseGeocodeJsonText(a, "town"))
            val city = if (reverseGeocodeIsTownshipLike(cityByPrec)) reverseGeocodeFirstText(reverseGeocodeJsonText(a, "state_district"), reverseGeocodeJsonText(a, "county"), cityByPrec) else cityByPrec
            val town = reverseGeocodeJsonText(a, "town")
            val district = reverseGeocodeFirstText(reverseGeocodeJsonText(a, "city_district"), reverseGeocodeJsonText(a, "suburb"), reverseGeocodeJsonText(a, "district"), reverseGeocodeJsonText(a, "neighbourhood"), reverseGeocodeJsonText(a, "quarter"), if (reverseGeocodeIsTownshipLike(town)) town else "")
            val country = reverseGeocodeJsonText(a, "country")
            val province = reverseGeocodeFirstText(reverseGeocodeJsonText(a, "state"), reverseGeocodeJsonText(a, "province"), reverseGeocodeJsonText(a, "region"), reverseGeocodeJsonText(a, "state_district"))
            val addr = arrayOf(country, province, city, district)
            return if (addr.any {{ part -> part.isNotEmpty() }}) addr else null
        }}

        private fun reverseGeocodeBigDataCloud(lat: Double, lon: Double): Array<String>? {{
            val url = "https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=" + lat + "&longitude=" + lon + "&localityLanguage=zh"
            val root = reverseGeocodeHttpGetJson(url, 8000, null) ?: return null
            val country = reverseGeocodeFirstText(reverseGeocodeJsonText(root, "countryName"), reverseGeocodeJsonText(root, "countryCode"))
            val province = reverseGeocodeJsonText(root, "principalSubdivision")
            val city = reverseGeocodeFirstText(reverseGeocodeJsonText(root, "city"), reverseGeocodeJsonText(root, "locality"))
            var district = reverseGeocodeFirstText(reverseGeocodeJsonText(root, "locality"), reverseGeocodeJsonText(root, "localityName"))
            if (district.isEmpty()) {{
                val adm = root.optJSONObject("localityInfo")?.optJSONArray("administrative")
                if (adm != null) {{
                    var i = 0
                    while (i < adm.length()) {{
                        val row = adm.optJSONObject(i)
                        if (row != null && row.optInt("order", -1) >= 8 && reverseGeocodeJsonText(row, "name").isNotEmpty()) {{
                            district = reverseGeocodeJsonText(row, "name")
                            break
                        }}
                        i += 1
                    }}
                }}
            }}
            val addr = arrayOf(country, province, city, district)
            return if (addr.any {{ part -> part.isNotEmpty() }}) addr else null
        }}

        private fun reverseGeocodeChain(lat: Double, lon: Double): Array<String>? {{
            // ingress (system property) → Nominatim → BigDataCloud (keyless). AMap needs a key and
            // native has no localStorage, so it is skipped — matching the PWA no-key behavior.
            val ingressUrl = (System.getProperty("cheng.ingress.url") ?: "").trim()
            if (ingressUrl.isNotEmpty()) {{
                val base = ingressUrl.trimEnd('/')
                val url = base + "/v1/libp2p/location/reverse-geocode?latitude=" + lat + "&longitude=" + lon + "&locale=zh-CN&timeoutMs=8000"
                val root = reverseGeocodeHttpGetJson(url, 8000, "UniMaker/1.0 (reverse-geocode)")
                if (root != null && root.optBoolean("ok", false)) {{
                    val a = root.optJSONObject("address")
                    if (a != null) {{
                        val addr = arrayOf(reverseGeocodeJsonText(a, "country"), reverseGeocodeJsonText(a, "province"), reverseGeocodeJsonText(a, "city"), reverseGeocodeJsonText(a, "district"))
                        if (addr.any {{ part -> part.isNotEmpty() }}) {{
                            return addr
                        }}
                    }}
                }}
            }}
            val nominatim = reverseGeocodeNominatim(lat, lon)
            if (nominatim != null) {{
                return nominatim
            }}
            return reverseGeocodeBigDataCloud(lat, lon)
        }}

        private fun reverseGeocodeCountryDisplayName(country: String): String {{
            val trimmed = country.trim()
            if (trimmed.isEmpty()) {{
                return ""
            }}
            if (!Regex("^[A-Za-z][A-Za-z]$").matches(trimmed)) {{
                return trimmed
            }}
            return try {{
                val name = java.util.Locale("", trimmed.uppercase()).displayCountry
                if (name.isNotEmpty()) name else trimmed.uppercase()
            }} catch (e: Exception) {{
                trimmed.uppercase()
            }}
        }}

        private fun formatReverseGeocodeLabel(addr: Array<String>): String {{
            val country = addr[0]
            val province = addr[1]
            val city = addr[2]
            val district = addr[3]
            val displayLevel = if (district.isNotEmpty()) "district" else if (city.isNotEmpty()) "city" else if (province.isNotEmpty()) "province" else "country"
            val parts = ArrayList<String>()
            val pushPart = {{ value: String ->
                val tv = value.trim()
                if (tv.isNotEmpty() && !parts.contains(tv)) {{
                    parts.add(tv)
                }}
            }}
            pushPart(reverseGeocodeCountryDisplayName(country))
            if (displayLevel != "country") {{
                pushPart(province)
            }}
            if (displayLevel != "country" && displayLevel != "province") {{
                pushPart(city)
            }}
            if (displayLevel == "district") {{
                pushPart(district)
            }}
            if (parts.isEmpty()) {{
                return ""
            }}
            val normalizedCountry = country.trim().lowercase()
            val isChina = normalizedCountry == "cn" || normalizedCountry == "china" || normalizedCountry == "中国" || normalizedCountry == "中华人民共和国"
            return if (isChina) parts.joinToString("") else parts.joinToString(" · ")
        }}

        private fun writeLocationCaptureFailure(statusRef: String, messageRef: String, code: String, message: String) {{
            Log.w("cheng-mobile-shell", "location_capture fail status_ref=" + statusRef + " code=" + code)
            dispatchRuntimeState(statusRef, code)
            dispatchRuntimeState(messageRef, message)
        }}

        private fun freshLastKnownLocation(manager: LocationManager, providers: List<String>, maxAgeMs: Int): Location? {{
            if (maxAgeMs <= 0) {{
                return null
            }}
            val nowMs = System.currentTimeMillis()
            var best: Location? = null
            for (provider in providers) {{
                val loc = try {{
                    manager.getLastKnownLocation(provider)
                }} catch (error: SecurityException) {{
                    null
                }}
                if (loc == null) {{
                    continue
                }}
                if (nowMs - loc.time > maxAgeMs) {{
                    continue
                }}
                val current = best
                if (current == null || loc.time > current.time) {{
                    best = loc
                }}
            }}
            return best
        }}

        private fun runLocationCapture(previewRef: String, statusRef: String, messageRef: String, timeoutMs: Int, maxAgeMs: Int) {{
            if (!hasPublishLocationPermission()) {{
                writeLocationCaptureFailure(statusRef, messageRef, "permission_denied", "定位权限被拒绝，请在系统设置中开启定位权限")
                return
            }}
            dispatchRuntimeState(statusRef, "loading")
            dispatchRuntimeState(messageRef, "")
            val manager = getSystemService(Context.LOCATION_SERVICE) as LocationManager
            val providers = manager.getProviders(true)
            if (providers.isEmpty()) {{
                writeLocationCaptureFailure(statusRef, messageRef, "unavailable", "定位服务不可用，请检查 GPS 开关")
                return
            }}
            val cached = freshLastKnownLocation(manager, providers, maxAgeMs)
            if (cached != null) {{
                writeCapturedLocation(cached, previewRef, statusRef, messageRef)
                return
            }}
            val provider = when {{
                providers.contains(LocationManager.NETWORK_PROVIDER) -> LocationManager.NETWORK_PROVIDER
                providers.contains(LocationManager.GPS_PROVIDER) -> LocationManager.GPS_PROVIDER
                else -> providers[0]
            }}
            Log.i("cheng-mobile-shell", "location_capture request provider=" + provider + " preview_ref=" + previewRef)
            var fired = false
            val listener = object : LocationListener {{
                override fun onLocationChanged(location: Location) {{
                    if (fired) {{
                        return
                    }}
                    fired = true
                    manager.removeUpdates(this)
                    writeCapturedLocation(location, previewRef, statusRef, messageRef)
                }}
            }}
            manager.requestSingleUpdate(provider, listener, Looper.getMainLooper())
            val effectiveTimeout = if (timeoutMs > 0) timeoutMs.toLong() else 20000L
            mainHandler.postDelayed({{
                if (!fired) {{
                    fired = true
                    manager.removeUpdates(listener)
                    writeLocationCaptureFailure(statusRef, messageRef, "timeout", "定位超时，请重试")
                }}
            }}, effectiveTimeout)
        }}

        private fun requestChengLocationCapture(timeoutMs: Int, maxAgeMs: Int, previewRef: String, statusRef: String, messageRef: String) {{
            val cleanPreview = validateStateRef(previewRef.trim())
            val cleanStatus = validateStateRef(statusRef.trim())
            val cleanMessage = validateStateRef(messageRef.trim())
            if (!hasPublishLocationPermission()) {{
                pendingLocationCapturePreviewRef = cleanPreview
                pendingLocationCaptureStatusRef = cleanStatus
                pendingLocationCaptureMessageRef = cleanMessage
                pendingLocationCaptureTimeoutMs = timeoutMs
                pendingLocationCaptureMaxAgeMs = maxAgeMs
                pendingLocationCaptureActive = true
                Log.i("cheng-mobile-shell", "location_capture permission request preview_ref=" + cleanPreview)
                requestPermissions(arrayOf(Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION), CHENG_LOCATION_CAPTURE_PERMISSION_REQUEST)
                return
            }}
            runLocationCapture(cleanPreview, cleanStatus, cleanMessage, timeoutMs, maxAgeMs)
        }}

        fun chengRequestLocationCaptureFromNative(timeoutMs: Int, maxAgeMs: Int, previewRef: String, statusRef: String, messageRef: String) {{
            mainHandler.post {{
                requestChengLocationCapture(timeoutMs, maxAgeMs, previewRef, statusRef, messageRef)
            }}
        }}

        private fun launchArgsKvWithRoute(baseKv: String, routeState: String): String {{
            var replaced = false
            val rewritten = baseKv.lines().map {{ line ->
                if (line.startsWith("route_state=")) {{
                    replaced = true
                    "route_state=$routeState"
                }} else {{
                    line
                }}
            }}.joinToString("\n")
            if (!replaced) {{
                throw IllegalStateException("cheng launch args kv missing route_state")
            }}
            return rewritten
        }}

        private fun launchArgsJsonWithRoute(baseJson: String, routeState: String): String {{
            val json = JSONObject(baseJson)
            if (!json.has("route_state")) {{
                throw IllegalStateException("cheng launch args json missing route_state")
            }}
            json.put("route_state", routeState)
            return json.toString()
        }}

        override fun onBackPressed() {{
	            if (dismissImeForBack()) {{
	                return
	            }}
            val handle = runtimeHandle
            if (handle != 0L && nativeOnBack(handle)) {{
                requestFrame()
                return
            }}
            super.onBackPressed()
        }}

        override fun onKeyUp(keyCode: Int, event: KeyEvent): Boolean {{
	            if (keyCode == KeyEvent.KEYCODE_BACK && suppressBackEventTimeAfterPreImeDismiss == event.eventTime) {{
	                suppressBackEventTimeAfterPreImeDismiss = -1L
	                Log.i("cheng-mobile-shell", "back_after_pre_ime_consumed event_time=" + event.eventTime)
	                return true
	            }}
	            if (keyCode == KeyEvent.KEYCODE_BACK) {{
	                suppressBackEventTimeAfterPreImeDismiss = -1L
	            }}
	            return super.onKeyUp(keyCode, event)
	        }}

        private fun canScheduleFrame(): Boolean {{
            return activityResumed && ::surfaceView.isInitialized && surfaceView.holder.surface.isValid && runtimeHandle != 0L
        }}

        private fun requestFrame() {{
            frameDirty = true
            if (canScheduleFrame() && !frameScheduled) {{
                frameScheduled = true
                Choreographer.getInstance().postFrameCallback(frameCallback)
            }}
        }}

        private fun cancelFrame() {{
            if (frameScheduled) {{
                Choreographer.getInstance().removeFrameCallback(frameCallback)
                frameScheduled = false
            }}
        }}

        private fun clearRuntimeBindings() {{
            abandonMediaAudioFocus("clear_runtime")
            releaseAudioPlayback()
            runtimeHandle = 0L
            runtimeCreateInFlight = false
            inputRingBuffer = null
            inputWriteIndex = null
            inputReadIndex = null
        }}

        private fun startRenderThread() {{
            renderThreadRunning = true
            renderThread = Thread(null, Runnable {{
                while (true) {{
                    drainPriorityRenderQueue()
                    val task = try {{
                        renderQueue.take()
                    }} catch (interrupted: InterruptedException) {{
                        if (!renderThreadRunning) {{
                            return@Runnable
                        }}
                        throw IllegalStateException("cheng render thread interrupted", interrupted)
                    }}
                    drainPriorityRenderQueue()
                    task.invoke()
                    drainPriorityRenderQueue()
                    if (!renderThreadRunning && renderQueue.isEmpty() && priorityRenderQueue.isEmpty()) {{
                        return@Runnable
                    }}
                }}
            }}, "ChengRenderThread", CHENG_RENDER_THREAD_STACK_BYTES)
            renderThread.start()
        }}

        private fun drainPriorityRenderQueue() {{
            while (true) {{
                val priorityTask = priorityRenderQueue.poll() ?: return
                priorityTask.invoke()
            }}
        }}

        private fun postRender(task: () -> Unit) {{
            if (!renderThreadRunning || !::renderThread.isInitialized) {{
                throw IllegalStateException("cheng render thread is not running")
            }}
            if (!renderQueue.offer(task)) {{
                throw IllegalStateException("cheng render queue is full")
            }}
        }}

        private fun postPriorityRender(task: () -> Unit) {{
            if (!renderThreadRunning || !::renderThread.isInitialized) {{
                throw IllegalStateException("cheng render thread is not running")
            }}
            if (!priorityRenderQueue.offer(task)) {{
                throw IllegalStateException("cheng priority render queue is full")
            }}
            renderQueue.offer({{ }})
        }}

        private fun shutdownRenderThread() {{
            if (!::renderThread.isInitialized) {{
                return
            }}
            renderThreadRunning = false
            if (!renderQueue.offer({{ }})) {{
                throw IllegalStateException("cheng render queue is full during shutdown")
            }}
        }}

        private fun destroyRuntimeAsync(handle: Long) {{
            if (handle == 0L) {{
                return
            }}
            postRender {{
                nativePause(handle)
                nativeDestroy(handle)
            }}
        }}

        private fun coordinateToMilli(value: Float): Int {{
            val milli = (value * 1000.0f).toLong()
            if (milli < Int.MIN_VALUE || milli > Int.MAX_VALUE) {{
                throw IllegalArgumentException("cheng touch coordinate is out of int32 milli range")
            }}
            return milli.toInt()
        }}

        private fun enqueueTouch(action: Int, pointerId: Int, x: Float, y: Float) {{
            val handle = runtimeHandle
            if (handle == 0L) {{
                return
            }}
            val ok = nativeEnqueueTouch(handle, action, pointerId, coordinateToMilli(x), coordinateToMilli(y))
            if (!ok) {{
                throw IllegalStateException("cheng native touch enqueue failed")
            }}
        }}

        private fun enqueueMotionEvent(event: MotionEvent) {{
            if (event.actionMasked == MotionEvent.ACTION_MOVE) {{
                for (pointerIndex in 0 until event.pointerCount) {{
                    enqueueTouch(event.actionMasked, event.getPointerId(pointerIndex), event.getX(pointerIndex), event.getY(pointerIndex))
                }}
            }} else {{
                val pointerIndex = event.actionIndex
                enqueueTouch(event.actionMasked, event.getPointerId(pointerIndex), event.getX(pointerIndex), event.getY(pointerIndex))
            }}
        }}

	        private fun armComputerUseGuiReplayLongPress(event: MotionEvent) {{
	            computerUseGuiReplayLongPressArmed = true
	            computerUseGuiReplayDownX = event.x
	            computerUseGuiReplayDownY = event.y
	            computerUseGuiReplayDownUptimeMs = event.eventTime
	            mainHandler.removeCallbacks(computerUseGuiReplayLongPressRunnable)
	            mainHandler.postDelayed(computerUseGuiReplayLongPressRunnable, 550L)
	        }}

	        private fun updateComputerUseGuiReplayLongPress(event: MotionEvent) {{
	            if (!computerUseGuiReplayLongPressArmed) {{
	                return
	            }}
	            val dx = event.x - computerUseGuiReplayDownX
	            val dy = event.y - computerUseGuiReplayDownY
	            val threshold = 18.0f * resources.displayMetrics.density
	            if (dx * dx + dy * dy > threshold * threshold) {{
	                cancelComputerUseGuiReplayLongPress()
	            }}
	        }}

	        private fun dispatchRuntimeAppendStringArrayState(stateRef: String, value: String) {{
	            validateStateRef(stateRef)
	            val handle = runtimeHandle
	            if (handle == 0L) {{
	                return
	            }}
	            postRender {{
	                val ok = if (runtimeHandle == handle) nativeAppendStringArrayState(handle, stateRef, value) else false
	                if (ok) {{
	                    syncRuntimeStorageDirty(handle)
	                }}
	                Log.i("cheng-mobile-shell", "runtime string array state append state_ref=" + stateRef + " value_len=" + value.length + " ok=" + ok)
	                mainHandler.post {{
	                    if (ok && runtimeHandle == handle) {{
	                        requestFrame()
	                    }}
	                }}
	            }}
	        }}

			        private fun dispatchRuntimeMediaSelection(mediaKind: String, payload: String, previewImage: ChengDecodedImage? = null) {{
			            validateChengFilePickerToken(mediaKind, "media kind")
			            val selection = PendingMediaSelection(mediaKind, payload, previewImage, previewImage != null)
			            lastRuntimeMediaSelection = selection
			            writeSceneLifecycleStateFile()
			            val handle = runtimeHandle
			            if (handle == 0L) {{
	                // The document picker tears down the surface (surfaceDestroyed -> runtime destroyed),
	                // and onActivityResult can arrive before surfaceCreated rebuilds the runtime. Dropping
	                // the payload here loses the user's selection (media box stays empty, publish stays
	                // disabled). Queue the fully-resolved selection and replay it once the runtime is ready
	                // (see flushPendingMediaSelection at the end of createRuntimeForSurface). The persistable
			                // URI permission taken in onActivityResult keeps a content:// video payload readable
			                // across the recreation. Keep only the latest pick — semantics = user's last selection.
			                pendingMediaSelection = selection
			                Log.i("cheng-mobile-shell", "pending_media_queue kind=" + mediaKind + " payload_len=" + payload.length + " preview=" + (previewImage != null))
			                return
			            }}
			            postRender {{
			                var imageOk = true
		                if (runtimeHandle == handle && previewImage != null) {{
		                    imageOk = nativeInstallDynamicImageTexture(handle, CHENG_MEDIA_PREVIEWS_STATE_REF, previewImage.width, previewImage.height, previewImage.pixels)
		                }}
		                val ok = if (runtimeHandle == handle && imageOk) nativeApplyMediaSelection(handle, mediaKind, payload, previewImage != null) else false
			                if (ok) {{
			                    syncRuntimeStorageDirty(handle)
			                }}
			                Log.i("cheng-mobile-shell", "runtime media selection kind=" + mediaKind + " payload_len=" + payload.length + " preview=" + (previewImage != null) + " image_ok=" + imageOk + " ok=" + ok)
			                mainHandler.post {{
			                    if (ok && runtimeHandle == handle) {{
		                        lastRuntimeMediaSelection = selection
		                        writeSceneLifecycleStateFile()
		                        requestFrame()
		                    }}
		                }}
	            }}
	        }}

		        private fun flushPendingMediaSelection() {{
		            val pending = pendingMediaSelection ?: return
		            pendingMediaSelection = null
		            Log.i("cheng-mobile-shell", "pending_media_flush kind=" + pending.mediaKind + " payload_len=" + pending.payload.length + " preview=" + (pending.previewImage != null))
		            dispatchRuntimeMediaSelection(pending.mediaKind, pending.payload, pending.previewImage)
		        }}

	        private fun dispatchRuntimeProductCsvSelection(displayName: String, csvText: String) {{
	            val handle = runtimeHandle
	            if (handle == 0L) {{
	                return
	            }}
	            postRender {{
	                val ok = if (runtimeHandle == handle) nativeApplyProductCsvSelection(handle, displayName, csvText) else false
	                if (ok) {{
	                    syncRuntimeStorageDirty(handle)
	                }}
	                Log.i("cheng-mobile-shell", "runtime product csv selection name_len=" + displayName.length + " csv_len=" + csvText.length + " ok=" + ok)
	                mainHandler.post {{
	                    if (ok && runtimeHandle == handle) {{
	                        requestFrame()
	                    }}
	                }}
	            }}
	        }}

	        private fun cancelComputerUseGuiReplayLongPress() {{
	            if (!computerUseGuiReplayLongPressArmed) {{
	                return
	            }}
	            computerUseGuiReplayLongPressArmed = false
	            mainHandler.removeCallbacks(computerUseGuiReplayLongPressRunnable)
	        }}

	        private fun finishComputerUseGuiReplayLongPress(event: MotionEvent) {{
	            if (!computerUseGuiReplayLongPressArmed) {{
	                return
	            }}
	            val elapsedMs = event.eventTime - computerUseGuiReplayDownUptimeMs
	            if (elapsedMs >= 550L) {{
	                startComputerUseGuiReplayFromLongPress()
	            }} else {{
	                cancelComputerUseGuiReplayLongPress()
	            }}
	        }}

	        private fun startComputerUseGuiReplayFromLongPress() {{
	            if (!computerUseGuiReplayLongPressArmed) {{
	                return
	            }}
	            computerUseGuiReplayLongPressArmed = false
	            mainHandler.removeCallbacks(computerUseGuiReplayLongPressRunnable)
	            startComputerUseGuiReplayNative("surface_long_press")
	        }}

	        private fun startComputerUseGuiReplayNative(source: String) {{
	            val handle = runtimeHandle
	            if (handle == 0L) {{
	                return
	            }}
	            postPriorityRender {{
	                val executionMode = if (runtimeHandle == handle) nativeComputerUseExecutionMode(handle) else -1
	                val slowPermille = if (runtimeHandle == handle) nativeComputerUseCurrentSlowPermille(handle) else -2147483647
	                if (slowPermille < 1000) {{
	                    Log.e("cheng-mobile-shell", "computer_use_gui_replay_start invalid_slow_permille=" + slowPermille + " source=" + source)
	                    mainHandler.post {{
	                        if (runtimeHandle == handle) {{
	                            updateComputerUseNativeRuntimeState(computerUseNativeLastChatTriggerCount, computerUseNativeLastResult, computerUseNativeLastTitle, executionMode, computerUseNativeSlowPermille, 0, 0, 0, 0, -4)
	                        }}
	                    }}
	                    return@postPriorityRender
	                }}
	                val result = if (runtimeHandle == handle) nativeStartComputerUseGuiReplay(handle, slowPermille) else -2147483647
	                if (result > 0) {{
	                    syncRuntimeStorageDirty(handle)
	                }}
	                val replayActive = if (runtimeHandle == handle) nativeComputerUseGuiReplayActive(handle) else 0
	                val replayStepIndex = if (runtimeHandle == handle) nativeComputerUseGuiReplayStepIndex(handle) else 0
	                val replayStepCount = if (runtimeHandle == handle) nativeComputerUseGuiReplayStepCount(handle) else 0
	                val replayApplied = if (runtimeHandle == handle) nativeComputerUseGuiReplayAppliedCount(handle) else 0
	                val replayStatus = if (runtimeHandle == handle) nativeComputerUseGuiReplayLastStatus(handle) else 0
	                Log.i("cheng-mobile-shell", "computer_use_gui_replay_start source=" + source + " result=" + result + " mode=" + executionMode + " slow_permille=" + slowPermille + " active=" + replayActive + " step=" + replayStepIndex + "/" + replayStepCount + " applied=" + replayApplied + " status=" + replayStatus)
	                mainHandler.post {{
	                    if (runtimeHandle == handle) {{
	                        updateComputerUseNativeRuntimeState(computerUseNativeLastChatTriggerCount, computerUseNativeLastResult, computerUseNativeLastTitle, executionMode, slowPermille, replayActive, replayStepIndex, replayStepCount, replayApplied, replayStatus)
	                        if (result > 0) {{
	                            requestFrame()
	                        }}
	                    }}
	                }}
	            }}
	        }}

	        private fun dispatchRuntimeImageState(stateRef: String, value: String, uri: Uri) {{
	            validateStateRef(stateRef)
	            val decoded = chengDecodePickedImage(uri)
	            val handle = runtimeHandle
	            if (handle == 0L) {{
	                return
	            }}
	            postRender {{
	                var ok = false
	                if (runtimeHandle == handle) {{
	                    val imageOk = nativeInstallDynamicImageTexture(handle, stateRef, decoded.width, decoded.height, decoded.pixels)
	                    ok = imageOk && nativeSetState(handle, stateRef, value)
	                    if (ok) {{
	                        syncRuntimeStorageDirty(handle)
	                    }}
	                    Log.i("cheng-mobile-shell", "runtime image state set state_ref=" + stateRef + " value_len=" + value.length + " image=" + decoded.width + "x" + decoded.height + " image_ok=" + imageOk + " ok=" + ok)
	                }}
	                mainHandler.post {{
	                    if (ok && runtimeHandle == handle) {{
	                        requestFrame()
	                    }}
	                }}
	            }}
	        }}

        private fun requireSurfaceWidth(holder: SurfaceHolder): Int {{
            // holder.surfaceFrame is the SurfaceHolder's own authoritative buffer-frame size
            // (exactly what surfaceChanged's width/height callback args report). The legacy
            // per-Activity display-metrics pixel fields must not be used here: they can
            // under-report the true edge-to-edge frame (this window runs with
            // setDecorFitsSystemWindows(false) + MATCH_PARENT SurfaceView), and clamping to
            // whichever is smaller silently shrinks height only (portrait nav bar affects
            // height, never width) — desyncing touch's phys->logical divisor from the
            // render's actual GLES viewport/ortho scale on the Y axis.
            val w = holder.surfaceFrame.width()
            if (w <= 0) {{
                throw IllegalStateException("cheng surface view width is not ready")
            }}
            return w
        }}

        private fun requireSurfaceHeight(holder: SurfaceHolder): Int {{
            val h = holder.surfaceFrame.height()
            if (h <= 0) {{
                throw IllegalStateException("cheng surface view height is not ready")
            }}
            return h
        }}

        private fun surfaceFrameReady(holder: SurfaceHolder): Boolean {{
            return holder.surfaceFrame.width() > 0 && holder.surfaceFrame.height() > 0
        }}

	        private fun dispatchTextInputValue(value: String, selectionStart: Int) {{
	            if (suppressTextInputCallback) {{
	                return
            }}
	            val trimmed = value.trim()
	            if (trimmed.isNotEmpty()) {{
	                computerUseNativeLastChatText = trimmed
	            }}
            val handle = runtimeHandle
            if (handle == 0L) {{
                return
            }}
	            postRender {{
	                val ok = if (runtimeHandle == handle) nativeTextInputCursorUtf8(handle, value, selectionStart) else false
	                if (ok) {{
	                    syncRuntimeStorageDirty(handle)
	                }}
	                mainHandler.post {{
                    if (ok && runtimeHandle == handle) {{
                        requestFrame()
                    }}
                }}
	            }}
	        }}

	        private class ChengHiddenEditText(context: Context, private val onBackPreIme: (Long) -> Boolean) : EditText(context) {{
	            override fun onKeyPreIme(keyCode: Int, event: KeyEvent): Boolean {{
	                if (keyCode == KeyEvent.KEYCODE_BACK) {{
	                    if (event.action == KeyEvent.ACTION_UP) {{
	                        Log.i("cheng-mobile-shell", "back_pre_ime event_time=" + event.eventTime)
	                        return onBackPreIme(event.eventTime)
	                    }}
	                    return true
	                }}
	                return super.onKeyPreIme(keyCode, event)
	            }}
	        }}

	        private fun publishImeState(handle: Long, insetBottomPx: Int, visible: Boolean) {{
	            // The scene works in logical px (viewport space); insets arrive in
	            // device px. Ceil so the focused editor always fully clears the IME.
	            val density = resources.displayMetrics.density
	            val insetLogical = if (insetBottomPx > 0 && density > 0f) kotlin.math.ceil(insetBottomPx / density).toInt() else 0
	            val insetText = insetLogical.toString()
	            val visibleText = if (visible) "true" else "false"
	            postPriorityRender {{
	                var ok = false
	                if (runtimeHandle == handle) {{
	                    val insetOk = nativeSetState(handle, "keyboardInsetBottom", insetText)
	                    val visibleOk = nativeSetState(handle, "keyboardVisible", visibleText)
	                    ok = insetOk && visibleOk
	                    if (ok) {{
	                        syncRuntimeStorageDirty(handle)
	                    }}
	                    Log.i("cheng-mobile-shell", "ime_state inset=" + insetBottomPx + " visible=" + visible + " ok=" + ok)
	                }}
	                mainHandler.post {{
	                    if (runtimeHandle == handle && ok) {{
	                        requestFrame()
	                    }}
	                }}
	            }}
	        }}

	        private fun applyImeInset(bottomPx: Int, visible: Boolean) {{
	            val safeBottom = if (visible && bottomPx > 0) bottomPx else 0
	            val nextVisible = visible && safeBottom > 0
	            if (imeInsetBottomPx == safeBottom && imeVisible == nextVisible) {{
	                return
	            }}
	            imeInsetBottomPx = safeBottom
	            imeVisible = nextVisible
	            // PWA parity (Chrome resizes-visual): the IME overlays the scene —
	            // never resize the surface (a resize squeezed the bottom tab bar
	            // above the keyboard and re-laid-out the whole route per toggle).
	            // The scene scrolls the focused editor into view from the
	            // keyboardInsetBottom state instead.
	            val handle = runtimeHandle
	            if (handle != 0L) {{
	                publishImeState(handle, safeBottom, nextVisible)
	            }}
	        }}

	        private fun installImeInsetsBridge() {{
	            if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.R) {{
	                throw IllegalStateException("cheng mobile shell requires Android R IME insets")
	            }}
	            rootView.setOnApplyWindowInsetsListener {{ _, insets ->
	                val imeInsets = insets.getInsets(android.view.WindowInsets.Type.ime())
	                val visible = insets.isVisible(android.view.WindowInsets.Type.ime())
	                applyImeInset(imeInsets.bottom, visible)
	                insets
	            }}
	        }}

	        private fun dismissImeForBack(preImeBackEventTime: Long = -1L): Boolean {{
	            if (!::textInput.isInitialized) {{
	                return false
	            }}
	            val shouldDismiss = focusedTextNodeId > 0 || textInput.hasFocus() || imeVisible || imeInsetBottomPx > 0
		            if (!shouldDismiss) {{
		                return false
		            }}
		            if (preImeBackEventTime >= 0L) {{
		                suppressBackEventTimeAfterPreImeDismiss = preImeBackEventTime
		            }}
		            Log.i("cheng-mobile-shell", "back_dismiss_ime focused_node=" + focusedTextNodeId + " inset=" + imeInsetBottomPx + " visible=" + imeVisible)
		            focusedTextNodeId = -1
		            suppressTextInputCallback = true
		            textInput.setText("")
	            suppressTextInputCallback = false
	            textInput.clearFocus()
	            val imm = getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
	            imm.hideSoftInputFromWindow(textInput.windowToken, 0)
	            if (::surfaceView.isInitialized) {{
	                surfaceView.requestFocus()
	            }}
	            applyImeInset(0, false)
	            val handle = runtimeHandle
	            if (handle != 0L) {{
		                postPriorityRender {{
		                    val ok = runtimeHandle == handle && nativeClearTextInputFocus(handle)
		                    mainHandler.post {{
		                        if (runtimeHandle == handle && !ok) {{
		                            throw IllegalStateException("cheng text focus clear failed")
		                        }}
		                        if (runtimeHandle == handle && ok) {{
		                            requestFrame()
		                        }}
		                    }}
	                }}
	            }}
	            requestFrame()
	            return true
	        }}

        private fun updateTextInputFocus(nodeId: Int) {{
            val imm = getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
            if (nodeId > 0) {{
                if (focusedTextNodeId != nodeId) {{
                    focusedTextNodeId = nodeId
                    suppressTextInputCallback = true
                    textInput.setText("")
                    textInput.setSelection(0)
                    suppressTextInputCallback = false
                }}
                if (!textInput.hasFocus()) {{
                    textInput.requestFocus()
                }}
                imm.showSoftInput(textInput, InputMethodManager.SHOW_IMPLICIT)
            }} else if (focusedTextNodeId > 0) {{
                focusedTextNodeId = -1
                suppressTextInputCallback = true
                textInput.setText("")
                suppressTextInputCallback = false
                textInput.clearFocus()
                imm.hideSoftInputFromWindow(textInput.windowToken, 0)
            }}
        }}

	        private fun installHiddenTextInput() {{
	            textInput = ChengHiddenEditText(this) {{ eventTime -> dismissImeForBack(eventTime) }}
	            textInput.setBackgroundColor(Color.TRANSPARENT)
            textInput.setTextColor(Color.TRANSPARENT)
            textInput.setHintTextColor(Color.TRANSPARENT)
            textInput.alpha = 0.01f
            textInput.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
            textInput.setSingleLine(false)
            textInput.isFocusable = true
            textInput.isFocusableInTouchMode = true
            textInput.addTextChangedListener(object : TextWatcher {{
                override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {{
                    s
                    start
                    count
                    after
                }}
                override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {{
                    s
                    start
                    before
                    count
                }}
                override fun afterTextChanged(s: Editable?) {{
                    dispatchTextInputValue(s?.toString() ?: "", textInput.selectionStart)
                }}
            }})
            val textLayout = FrameLayout.LayoutParams(1, 1)
            rootView.addView(textInput, textLayout)
        }}

        private fun configureNativeSurfaceWindow() {{
            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.P) {{
                val attrs = window.attributes
                attrs.layoutInDisplayCutoutMode = android.view.WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
                window.attributes = attrs
            }}
            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R) {{
                window.setDecorFitsSystemWindows(false)
                val controller = window.decorView.windowInsetsController
                if (controller != null) {{
                    controller.hide(android.view.WindowInsets.Type.statusBars())
                    controller.systemBarsBehavior = android.view.WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
                }}
            }}
            window.setFlags(android.view.WindowManager.LayoutParams.FLAG_FULLSCREEN, android.view.WindowManager.LayoutParams.FLAG_FULLSCREEN)
            window.decorView.systemUiVisibility = android.view.View.SYSTEM_UI_FLAG_FULLSCREEN or android.view.View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN or android.view.View.SYSTEM_UI_FLAG_LAYOUT_STABLE
        }}

        // Cross-device LAN media fetch (鸿蒙发布→安卓秒开): the publisher is on the WiFi LAN
        // (192.168.x), but the WiFi is local-only / unvalidated, so Android routes app sockets to
        // the validated default network (cellular) where the LAN is unreachable — the QUIC packets
        // stick in tx_queue. Bind THIS app process to the WiFi network so its sockets use WiFi.
        private fun bindProcessToWifiForLanMedia() {{
            try {{
                val cm = getSystemService(android.content.Context.CONNECTIVITY_SERVICE) as android.net.ConnectivityManager
                for (net in cm.allNetworks) {{
                    val caps = cm.getNetworkCapabilities(net)
                    if (caps != null && caps.hasTransport(android.net.NetworkCapabilities.TRANSPORT_WIFI)) {{
                        cm.bindProcessToNetwork(net)
                        Log.i("cheng-mobile-shell", "bound process to WiFi network for LAN media: " + net.toString())
                        break
                    }}
                }}
                // Robustness: also request WiFi + rebind when it (re)appears.
                val req = android.net.NetworkRequest.Builder()
                    .addTransportType(android.net.NetworkCapabilities.TRANSPORT_WIFI).build()
                cm.requestNetwork(req, object : android.net.ConnectivityManager.NetworkCallback() {{
                    override fun onAvailable(network: android.net.Network) {{
                        cm.bindProcessToNetwork(network)
                        Log.i("cheng-mobile-shell", "WiFi available, bound process for LAN media")
                    }}
                }})
            }} catch (t: Throwable) {{
                Log.e("cheng-mobile-shell", "bindProcessToWifiForLanMedia failed: " + t.toString())
            }}
        }}

	        override fun onCreate(savedInstanceState: Bundle?) {{
	            super.onCreate(savedInstanceState)
	            touchTraceEnabled = nativeTouchTraceEnabled()
	            setVolumeControlStream(AudioManager.STREAM_MUSIC)
	            restorePendingChengFilePicker(savedInstanceState)
	            restoreSceneLifecycleState(savedInstanceState)
	            // NOTE: do NOT bindProcessToNetwork(WiFi) here — the validated default network is
            // already WiFi on this device, so the bind is redundant; worse, the explicit-network
            // fwmark it sets perturbs ingress for the cross-device QUIC socket.
            configureNativeSurfaceWindow()
            startRenderThread()
            rootView = FrameLayout(this)
            surfaceView = SurfaceView(this)
            surfaceView.holder.addCallback(this)
            surfaceView.isClickable = true
            surfaceView.setOnTouchListener {{ _, event ->
                if (touchTraceEnabled) {{
                    Log.i("cheng-mobile-shell", "touch event action=" + event.actionMasked + " pointers=" + event.pointerCount + " x=" + event.x + " y=" + event.y + " runtime=" + runtimeHandle)
                }}
                when (event.actionMasked) {{
                    MotionEvent.ACTION_DOWN -> armComputerUseGuiReplayLongPress(event)
                    MotionEvent.ACTION_MOVE -> updateComputerUseGuiReplayLongPress(event)
                    MotionEvent.ACTION_UP -> finishComputerUseGuiReplayLongPress(event)
                    MotionEvent.ACTION_CANCEL -> cancelComputerUseGuiReplayLongPress()
                }}
            if (runtimeHandle != 0L && inputRingBuffer != null) {{
                val handle = runtimeHandle
                enqueueMotionEvent(event)
                postPriorityRender {{
                    val drained = runtimeHandle == handle && nativeDrainInput(handle)
                    mainHandler.post {{
                        if (runtimeHandle == handle) {{
                            if (!drained) {{
                                throw IllegalStateException("cheng native input drain failed")
                            }}
                            requestFrame()
                        }}
                    }}
                }}
                requestFrame()
            }}
                true
            }}
            surfaceView.isFocusable = true
            surfaceView.isFocusableInTouchMode = true
            rootView.addView(surfaceView, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
            installHiddenTextInput()
            installComputerUseNativeOverlay()
            setContentView(rootView, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
	            installImeInsetsBridge()
            surfaceView.requestFocus()
        }}

	        override fun onSaveInstanceState(outState: Bundle) {{
	            super.onSaveInstanceState(outState)
	            snapshotRuntimeStateForLifecycle("save_instance")
	            writeSceneLifecycleStateFile()
	            outState.putBoolean(CHENG_SCENE_LIFECYCLE_SAVED_FILE, true)
	            if (pendingChengFilePickerRef.isNotEmpty()) {{
	                outState.putString(CHENG_FILE_PICKER_SAVED_REF, pendingChengFilePickerRef)
                outState.putString(CHENG_FILE_PICKER_SAVED_KIND, pendingChengFilePickerKind)
                outState.putString(CHENG_FILE_PICKER_SAVED_RESULT_MODE, pendingChengFilePickerResultMode)
                outState.putString(CHENG_FILE_PICKER_SAVED_STATE_REF, pendingChengFilePickerStateRef)
                outState.putString(CHENG_FILE_PICKER_SAVED_RESTORE_ROUTE, pendingPickerRestoreRoute ?: "")
                Log.i("cheng-mobile-shell", "file_picker_save ref=" + pendingChengFilePickerRef + " kind=" + pendingChengFilePickerKind + " mode=" + pendingChengFilePickerResultMode + " state_ref=" + pendingChengFilePickerStateRef + " restore_route=" + (pendingPickerRestoreRoute ?: ""))
            }}
        }}

	        override fun onRequestPermissionsResult(requestCode: Int, permissions: Array<out String>, grantResults: IntArray) {{
	            super.onRequestPermissionsResult(requestCode, permissions, grantResults)
	            if (requestCode == CHENG_LOCATION_PERMISSION_REQUEST && hasPublishLocationPermission()) {{
	                requestPublishLocation()
	            }}
	            if (requestCode == CHENG_LOCATION_CAPTURE_PERMISSION_REQUEST) {{
	                val active = pendingLocationCaptureActive
	                val previewRef = pendingLocationCapturePreviewRef
	                val statusRef = pendingLocationCaptureStatusRef
	                val messageRef = pendingLocationCaptureMessageRef
	                val timeoutMs = pendingLocationCaptureTimeoutMs
	                val maxAgeMs = pendingLocationCaptureMaxAgeMs
	                pendingLocationCaptureActive = false
	                pendingLocationCapturePreviewRef = ""
	                pendingLocationCaptureStatusRef = ""
	                pendingLocationCaptureMessageRef = ""
	                if (active) {{
	                    if (hasPublishLocationPermission()) {{
	                        runLocationCapture(previewRef, statusRef, messageRef, timeoutMs, maxAgeMs)
	                    }} else {{
	                        writeLocationCaptureFailure(statusRef, messageRef, "permission_denied", "定位权限被拒绝，请在系统设置中开启定位权限")
	                    }}
	                }}
	            }}
	            if (requestCode == CHENG_MEDIA_VIDEO_PERMISSION_REQUEST) {{
	                Log.i("cheng-mobile-shell", "computer_use_media_permission_result grant_count=" + grantResults.size + " has_permission=" + hasVideoMediaPermission())
	                val pending = pendingComputerUseMediaSelection
	                pendingComputerUseMediaSelection = null
	                if (pending != null) {{
	                    if (hasVideoMediaPermission()) {{
	                        startComputerUseVideoSelection(pending)
	                    }} else {{
	                        deliverComputerUseVideoSelection(pending, ComputerUseVideoSelection(CHENG_CU_MEDIA_PERMISSION_DENIED, "", "", "", 0L, 0L))
	                    }}
	                }}
	            }}
	        }}

	        override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {{
	            super.onActivityResult(requestCode, resultCode, data)
	            if (requestCode != CHENG_FILE_PICKER_REQUEST) {{
	                return
	            }}
	            val pendingRef = pendingChengFilePickerRef
	            val pendingKind = pendingChengFilePickerKind
	            val pendingResultMode = pendingChengFilePickerResultMode
	            val pendingResultStateRef = pendingChengFilePickerStateRef
	            pendingChengFilePickerRef = ""
	            pendingChengFilePickerKind = ""
	            pendingChengFilePickerResultMode = ""
	            pendingChengFilePickerStateRef = ""
	            if (runtimeHandle != 0L) {{
	                pendingPickerRestoreRoute = null
	            }}
	            val uri = data?.data
	            Log.i("cheng-mobile-shell", "file_picker_result result=" + resultCode + " uri_len=" + (uri?.toString()?.length ?: 0))
	            if (resultCode == RESULT_OK && uri != null && data != null) {{
	                try {{
	                    val takeFlags = data.flags and Intent.FLAG_GRANT_READ_URI_PERMISSION
	                    if (takeFlags != 0) {{
	                        contentResolver.takePersistableUriPermission(uri, takeFlags)
	                    }}
	                }} catch (t: Throwable) {{
	                    Log.i("cheng-mobile-shell", "file_picker_persist_permission_skip " + t.toString())
	                }}
	                if (pendingResultStateRef.isNotEmpty()) {{
	                    val mime = contentResolver.getType(uri) ?: ""
		                    val displayName = chengFilePickerDisplayName(uri)
		                    if (pendingResultMode == "qr-text") {{
		                        chengDecodePickedQrText(uri) {{ qrText, error ->
		                            if (error != null) {{
		                                Log.e("cheng-mobile-shell", "file_picker_qr_text failed", error)
		                                dispatchRuntimeState("didActionHint", "二维码识别失败")
		                            }} else {{
		                                val cleanQrText = qrText?.trim().orEmpty()
		                                if (cleanQrText.isEmpty()) {{
		                                    dispatchRuntimeState("didActionHint", "没有识别到恢复二维码")
		                                }} else {{
		                                    dispatchRuntimeState(pendingResultStateRef, cleanQrText)
		                                    dispatchRuntimeState("didActionHint", "二维码已识别")
		                                }}
		                            }}
		                        }}
		                    }} else {{
			                        val payload = chengFilePickerPayload(uri, pendingResultMode, displayName, mime)
			                        Log.i("cheng-mobile-shell", "file_picker_state ref=" + pendingRef + " kind=" + pendingKind + " mode=" + pendingResultMode + " state_ref=" + pendingResultStateRef + " payload_len=" + payload.length)
				                    if (pendingResultMode == "media-selection") {{
				                        var previewImage: ChengDecodedImage? = null
				                        if (mime.startsWith("video/")) {{
				                            try {{
				                                previewImage = chengDecodePickedVideoFrame(uri)
				                                Log.i("cheng-mobile-shell", "file_picker_video_preview decoded " + previewImage.width + "x" + previewImage.height)
				                            }} catch (error: Throwable) {{
				                                Log.e("cheng-mobile-shell", "file_picker_video_preview failed", error)
				                                dispatchRuntimeState("publishError", "视频首帧提取失败")
				                                return
				                            }}
				                        }} else if (mime.startsWith("image/")) {{
				                            try {{
				                                previewImage = chengDecodePickedImage(uri)
				                                Log.i("cheng-mobile-shell", "file_picker_image_preview decoded " + previewImage.width + "x" + previewImage.height)
				                            }} catch (error: Throwable) {{
				                                Log.e("cheng-mobile-shell", "file_picker_image_preview failed", error)
				                                dispatchRuntimeState("publishError", "图片预览解码失败")
				                                return
				                            }}
				                        }}
				                        dispatchRuntimeMediaSelection(pendingResultStateRef, payload, previewImage)
				                    }} else if (pendingResultMode == "data-url-array-append") {{
				                        dispatchRuntimeAppendStringArrayState(pendingResultStateRef, payload)
				                    }} else if (pendingResultMode == "product-csv") {{
			                        dispatchRuntimeProductCsvSelection(displayName, payload)
			                    }} else if (chengFilePickerShouldInstallDynamicImage(pendingKind, pendingResultMode, pendingResultStateRef, mime)) {{
			                        dispatchRuntimeImageState(pendingResultStateRef, payload, uri)
			                    }} else {{
			                        dispatchRuntimeState(pendingResultStateRef, payload)
			                    }}
		                    }}
		                }}
		            }}
		            mainHandler.post {{
		                ensureFilePickerReturnVisible()
		            }}
		        }}

		        private fun ensureFilePickerReturnVisible() {{
		            if (isFinishing || isDestroyed) {{
		                return
		            }}
		            val route = pendingPickerRestoreRoute ?: lastRuntimeRouteState
		            val selfIntent = Intent(this, ChengMainActivity::class.java)
		            selfIntent.addFlags(Intent.FLAG_ACTIVITY_REORDER_TO_FRONT or Intent.FLAG_ACTIVITY_SINGLE_TOP)
		            if (!route.isNullOrEmpty()) {{
		                selfIntent.putExtra(CHENG_ROUTE_STATE_EXTRA, route)
		            }}
		            Log.i("cheng-mobile-shell", "file_picker_return_resume route=" + (route ?: "") + " resumed=" + activityResumed + " runtime=" + runtimeHandle)
		            val activityManager = getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
		            activityManager.moveTaskToFront(taskId, 0)
		            startActivity(selfIntent)
		            if (activityResumed && ::surfaceView.isInitialized && surfaceView.holder.surface.isValid) {{
		                nativeSetPresentEnabled(true)
		                if (runtimeHandle == 0L) {{
		                    createRuntimeForSurface(surfaceView.holder)
		                }} else {{
		                    requestFrame()
		                }}
		            }}
		        }}

        private fun createRuntimeForSurface(holder: SurfaceHolder) {{
            if (runtimeHandle != 0L || runtimeCreateInFlight) {{
                return
            }}
            if (!holder.surface.isValid || !surfaceFrameReady(holder)) {{
                return
            }}
            runtimeCreateInFlight = true
            surfaceGeneration += 1
            val generation = surfaceGeneration
            val density = resources.displayMetrics.density
            val width = requireSurfaceWidth(holder)
            val height = requireSurfaceHeight(holder)
	            // Lifecycle restore wins over the original launch route: the launch intent may still
	            // contain home_default after IME/picker/surface recreation.
	            val restoreRoute = pendingPickerRestoreRoute ?: lastRuntimeRouteState
	            pendingPickerRestoreRoute = null
	            val routeOverride = restoreRoute ?: launchRouteStateOverride()
	            val stateSnapshotJson = lastRuntimeStateSnapshotJson
	            val runtimeManifestJson = readAssetText(CHENG_RUNTIME_MANIFEST)
            val runtimeContractPayloadJson = readAssetText(CHENG_RUNTIME_CONTRACT_PAYLOAD_REL)
            val runtimeBundlePayloadJson = readAssetText(CHENG_RUNTIME_BUNDLE_PAYLOAD_REL)
            val launchArgsKvAsset = readAssetText(CHENG_LAUNCH_ARGS_KV_REL)
            val launchArgsJsonAsset = readAssetText(CHENG_LAUNCH_ARGS_JSON_REL)
            val launchArgsKv = if (routeOverride == null) launchArgsKvAsset else launchArgsKvWithRoute(launchArgsKvAsset, routeOverride)
            val launchArgsJson = if (routeOverride == null) launchArgsJsonAsset else launchArgsJsonWithRoute(launchArgsJsonAsset, routeOverride)
            val activeRouteState = routeOverride ?: JSONObject(launchArgsJson).getString("route_state")
            val surface = holder.surface
            postRender {{
                val handle = nativeCreate(surface, width, height, density, assets, runtimeManifestJson, runtimeContractPayloadJson, runtimeBundlePayloadJson, launchArgsKv, launchArgsJson)
                if (handle == 0L) {{
                    mainHandler.post {{
                        runtimeCreateInFlight = false
                        if (generation == surfaceGeneration) {{
                            throw IllegalStateException("cheng native runtime create failed")
                        }}
                    }}
                    return@postRender
                }}
                // Android startup-period MoQ serve (方向A last piece: 鸿蒙 fetch 安卓). Native-side
                // start is idempotent (s_moq_serve_started guard), so calling this on every
                // successful runtime create (incl. surface recreation across rotation/resume) is
                // a cheap no-op after the first call — no extra Kotlin-side one-shot bookkeeping.
                val moqServeCacheDir = File(filesDir, "moq_publish").apply {{ mkdirs() }}
                nativeStartMoqServe(moqServeCacheDir.absolutePath)
                // S4 block cache (video-seek-scrub-blueprint.md §S4): sibling of moq_publish
                // above, NOT the same directory — moq_publish is the outbound cheng-publish
                // staging dir (this device serving its own asset), the block cache is inbound
                // (this device caching GOP blocks fetched from a remote peer); the module's own
                // header comment requires physical isolation between the two. Native-side start
                // is idempotent (mirrors nativeStartMoqServe's s_moq_serve_started guard).
                val mediaBlockCacheDir = File(filesDir, "media_block_cache").apply {{ mkdirs() }}
                nativeStartMediaBlockCache(mediaBlockCacheDir.absolutePath)
		                val ring = nativeInputRingBuffer(handle).order(ByteOrder.nativeOrder())
		                val writeIndex = nativeInputWriteIndex(handle).order(ByteOrder.nativeOrder())
		                val readIndex = nativeInputReadIndex(handle).order(ByteOrder.nativeOrder())
		                restoreRuntimeStorage(handle)
		                var stateRestoreOk = true
			                if (stateSnapshotJson.isNotEmpty()) {{
			                    stateRestoreOk = nativeRestoreSceneStateSnapshot(handle, stateSnapshotJson)
			                }}
			                if (!stateRestoreOk) {{
			                    mainHandler.post {{
			                        val recreate = generation == surfaceGeneration &&
			                            runtimeHandle == 0L &&
			                            ::surfaceView.isInitialized &&
			                            surfaceView.holder.surface.isValid &&
			                            !isFinishing &&
			                            !isDestroyed
			                        runtimeCreateInFlight = false
			                        discardSceneLifecycleSnapshot("snapshot_restore_failed", stateSnapshotJson.length)
			                        destroyRuntimeAsync(handle)
			                        if (recreate) {{
			                            createRuntimeForSurface(surfaceView.holder)
			                        }}
			                    }}
			                    return@postRender
			                }}
		                mainHandler.post {{
                    runtimeCreateInFlight = false
                    if (generation != surfaceGeneration || !surfaceView.holder.surface.isValid || runtimeHandle != 0L) {{
                        destroyRuntimeAsync(handle)
                        return@post
                    }}
                    inputRingBuffer = ring
                    inputWriteIndex = writeIndex
                    inputReadIndex = readIndex
                    runtimeHandle = handle
                    computerUseNativeLastChatTriggerCount = 0
	                    lastFrameNanos = 0L
	                    Log.i("cheng-mobile-shell", "runtime_recreated route=" + activeRouteState)
	                    Log.i("cheng-mobile-shell", "scene_lifecycle_restore_applied snapshot_len=" + stateSnapshotJson.length)
	                    pushDistributedContentsToRuntime("runtime_create")
	                    pushNodesToRuntime("runtime_create")
	                    // Realtime home-feed inbound: start the backend-blocking feed event
	                    // pump once per process (self-guarded inside); the create/resume
	                    // one-shot merges above stay as the initial snapshot.
	                    startFeedEventPumpIfNeeded()
	                    startIngressPresenceIfNeeded()
                    requestPublishLocationIfNeeded(activeRouteState)
                    handleMediaActionIntent(intent)
                    handleComputerUseTextIntent(intent)
                    // Replay a media selection that landed while the runtime was being rebuilt after
                    // the document picker destroyed the surface. Route restore has already baked the
                    // publish page into the launch args above, so the runtime is on the publish route.
	                    if (pendingMediaSelection != null) {{
	                        flushPendingMediaSelection()
	                    }} else {{
	                        replayLastRuntimeMediaSelection("runtime_create")
	                    }}
                    requestFrame()
                }}
            }}
        }}

        override fun onNewIntent(newIntent: Intent) {{
            super.onNewIntent(newIntent)
            setIntent(newIntent)
            handleMediaActionIntent(newIntent)
            handleComputerUseTextIntent(newIntent)
        }}

        override fun surfaceCreated(holder: SurfaceHolder) {{
            if (activityResumed) {{
                nativeSetPresentEnabled(true)
            }}
            createRuntimeForSurface(holder)
        }}

        override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {{
            val handle = runtimeHandle
            if (handle != 0L) {{
                val surface = holder.surface
                val surfaceWidth = requireSurfaceWidth(holder)
                val surfaceHeight = requireSurfaceHeight(holder)
                val density = resources.displayMetrics.density
	                postRender {{
	                    if (runtimeHandle == handle) {{
	                        nativeResize(handle, surface, surfaceWidth, surfaceHeight, density)
	                        mainHandler.post {{
	                            if (runtimeHandle == handle) {{
	                                if (activityResumed) {{
	                                    nativeSetPresentEnabled(true)
	                                }}
	                                requestFrame()
	                            }}
	                        }}
                    }}
                }}
            }} else {{
                createRuntimeForSurface(holder)
            }}
        }}

	        override fun surfaceDestroyed(holder: SurfaceHolder) {{
	            holder
	            snapshotRuntimeStateForLifecycle("surface_destroyed")
	            surfaceGeneration += 1
	            runtimeCreateInFlight = false
            val handle = runtimeHandle
            cancelFrame()
            nativeSetPresentEnabled(false)
            clearRuntimeBindings()
            destroyRuntimeAsync(handle)
        }}

        override fun onResume() {{
            super.onResume()
            activityResumed = true
            nativeSetPresentEnabled(true)
            val handle = runtimeHandle
            if (handle != 0L) {{
                postRender {{
                    if (runtimeHandle == handle) {{
                        nativeResume(handle)
                    }}
                }}
                pushDistributedContentsToRuntime("resume")
                pushNodesToRuntime("resume")
                startFeedEventPumpIfNeeded()
                requestFrame()
            }} else if (::surfaceView.isInitialized && surfaceView.holder.surface.isValid) {{
                createRuntimeForSurface(surfaceView.holder)
            }}
            startIngressPresenceIfNeeded()
        }}

	        override fun onPause() {{
		            activityResumed = false
		            stopIngressPresence("pause")
		            snapshotRuntimeStateForLifecycle("pause")
		            nativeSetPresentEnabled(false)
		            abandonMediaAudioFocus("pause")
            pauseAudioPlaybackForLifecycle()
            val handle = runtimeHandle
            if (handle != 0L) {{
                cancelFrame()
                postRender {{
                    if (runtimeHandle == handle) {{
                        nativePause(handle)
                    }}
                }}
            }}
            super.onPause()
        }}

        private val frameCallback = Choreographer.FrameCallback {{ frameTimeNanos ->
            frameScheduled = false
            val handle = runtimeHandle
            if (handle != 0L && activityResumed && ::surfaceView.isInitialized && surfaceView.holder.surface.isValid) {{
                frameDirty = false
                val deltaNanos = if (lastFrameNanos == 0L) 16_666_667L else frameTimeNanos - lastFrameNanos
                val safeDeltaNanos = if (deltaNanos < 1L) 1L else deltaNanos
                lastFrameNanos = frameTimeNanos
                val deltaSeconds = safeDeltaNanos.toFloat() / 1_000_000_000.0f
		            postRender {{
		                if (runtimeHandle != handle || !activityResumed) {{
		                    return@postRender
		                }}
		                val needsFrame = nativeTick(handle, deltaSeconds)
	                if (runtimeHandle == handle) {{
	                    syncRuntimeStorageDirty(handle)
	                }}
	                val mediaPlaybackState = if (runtimeHandle == handle) nativeMediaPlaybackLastState(handle) else -1
	                val focusedTextNode = if (runtimeHandle == handle) nativeFocusedTextNodeId(handle) else -1
                    val computerUseChatTrigger = if (runtimeHandle == handle) nativeComputerUseChatTriggerCount(handle) else -1
                    val computerUseChatResult = if (runtimeHandle == handle) nativeComputerUseLastChatResult(handle) else -1
                    val computerUseTitle = if (runtimeHandle == handle && (computerUseChatResult == 1 || computerUseChatResult == 2)) nativeComputerUseLastTitle(handle) else ""
                    val computerUseExecutionMode = if (runtimeHandle == handle) nativeComputerUseExecutionMode(handle) else -1
                    val computerUseSlowPermille = if (runtimeHandle == handle) nativeComputerUseCurrentSlowPermille(handle) else -1
                    val replayActive = if (runtimeHandle == handle) nativeComputerUseGuiReplayActive(handle) else 0
                    val replayStepIndex = if (runtimeHandle == handle) nativeComputerUseGuiReplayStepIndex(handle) else 0
                    val replayStepCount = if (runtimeHandle == handle) nativeComputerUseGuiReplayStepCount(handle) else 0
                    val replayApplied = if (runtimeHandle == handle) nativeComputerUseGuiReplayAppliedCount(handle) else 0
                    val replayStatus = if (runtimeHandle == handle) nativeComputerUseGuiReplayLastStatus(handle) else 0
                    mainHandler.post {{
                        if (runtimeHandle == handle) {{
                            syncMediaAudioFocus(mediaPlaybackState, "native_playback")
                            updateTextInputFocus(focusedTextNode)
                            updateComputerUseNativeRuntimeState(computerUseChatTrigger, computerUseChatResult, computerUseTitle, computerUseExecutionMode, computerUseSlowPermille, replayActive, replayStepIndex, replayStepCount, replayApplied, replayStatus)
                            if (needsFrame || frameDirty) {{
                                requestFrame()
                            }}
                        }}
                    }}
                }}
            }}
        }}

        override fun onWindowFocusChanged(hasFocus: Boolean) {{
            super.onWindowFocusChanged(hasFocus)
            if (hasFocus) {{
                configureNativeSurfaceWindow()
                if (runtimeHandle != 0L) {{
                    requestFrame()
                }} else if (::surfaceView.isInitialized && surfaceView.holder.surface.isValid) {{
                    createRuntimeForSurface(surfaceView.holder)
                }}
            }}
        }}

        override fun onDestroy() {{
            stopIngressPresence("destroy")
            surfaceGeneration += 1
            val handle = runtimeHandle
            cancelFrame()
            nativeSetPresentEnabled(false)
            clearRuntimeBindings()
            destroyRuntimeAsync(handle)
            if (::renderThread.isInitialized) {{
                shutdownRenderThread()
            }}
            super.onDestroy()
        }}
    }}

    """

@borrows
fn MobileShellAndroidCmake(opts: MobileShellOptions): str =
    return Fmt"""
    cmake_minimum_required(VERSION 3.22.1)
    project(cheng_generated_android_host C)

    add_library(cheng_generated_android_host SHARED cheng_generated_android_host.c)
    target_compile_definitions(cheng_generated_android_host PRIVATE CHENG_APP_LIB_NAME=\"{opts.libName}\")
    target_link_options(cheng_generated_android_host PRIVATE "-Wl,-z,global")
    find_library(log-lib log)
    find_library(android-lib android)
    find_library(egl-lib EGL)
    find_library(gles-lib GLESv3)
    find_library(mediandk-lib mediandk)
    find_library(jnigraphics-lib jnigraphics)
    find_library(aaudio-lib aaudio)
    find_library(m-lib m)
    target_link_libraries(cheng_generated_android_host ${{log-lib}} ${{android-lib}} ${{egl-lib}} ${{gles-lib}} ${{mediandk-lib}} ${{jnigraphics-lib}} ${{aaudio-lib}} ${{m-lib}})

    """

