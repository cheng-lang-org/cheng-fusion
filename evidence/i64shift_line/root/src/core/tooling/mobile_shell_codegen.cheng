        return false
    outCopied = true
    return true

@borrows
fn MobileShellCopyOptionalMediaAssetsFromSource(opts: MobileShellOptions,
                                                 sourceRoot: str,
                                                 files: var str[],
                                                 outCopied: var bool,
                                                 outError: var str): bool =
    if outCopied:
        return true
    let mediaSourceRoot: str = os.JoinPath(sourceRoot, MobileShellRuntimeMediaAssetsRelPath())
    if !os.DirExists(mediaSourceRoot):
        return true
    var copiedCount: int32
    if !MobileShellCopyRawTreeRec(opts,
                                    mediaSourceRoot,
                                    "",
                                    MobileShellRuntimeMediaAssetsRelPath(),
                                    files,
                                    copiedCount,
                                    outError):
        return false
    if copiedCount > 0:
        outCopied = true
    return true

@borrows
fn MobileShellWriteOptionalRuntimeResources(opts: MobileShellOptions,
                                              files: var str[],
                                              outSemanticNodesRel: var str,
                                              outTruthRootRel: var str,
                                              outError: var str): bool =
    outSemanticNodesRel = ""
    outTruthRootRel = ""
    let sourceRoots: str[] = MobileShellSourceRoots(opts)
    var sceneDataCopied: bool
    var glyphSdfPixelsCopied: bool
    var computerUseManifestCopied: bool
    var mediaAssetsCopied: bool
    for i in 0..<sourceRoots.len:
        let semanticSource: str = os.JoinPath(sourceRoots[i], "r2c_semantic_render_nodes.tsv")
        if len(outSemanticNodesRel) <= 0 && os.FileExists(semanticSource):
            outSemanticNodesRel = MobileShellRuntimeSemanticNodesRelPath()
            if !MobileShellCopyRawFile(opts, semanticSource, outSemanticNodesRel, files, outError):
                return false
        let truthSourceRoot: str = os.JoinPath(sourceRoots[i], "truth")
        if len(outTruthRootRel) <= 0 && os.DirExists(truthSourceRoot):
            var copiedCount: int32
            if !MobileShellCopyRawTreeRec(opts,
                                            truthSourceRoot,
                                            "",
                                            MobileShellRuntimeTruthRootRelPath(),
                                            files,
                                            copiedCount,
                                            outError):
                return false
            if copiedCount > 0:
                outTruthRootRel = MobileShellRuntimeTruthRootRelPath()
        if !MobileShellCopyOptionalGlyphSdfPixelsFromSource(opts,
                                                              sourceRoots[i],
                                                              files,
                                                              glyphSdfPixelsCopied,
                                                              outError):
            return false
        if !MobileShellCopyOptionalSceneDataFromSource(opts,
                                                         sourceRoots[i],
                                                         files,
                                                         sceneDataCopied,
                                                         outError):
            return false
        if !MobileShellCopyOptionalComputerUseManifestFromSource(opts,
                                                                  sourceRoots[i],
                                                                  files,
                                                                  computerUseManifestCopied,
                                                                  outError):
            return false
        if !MobileShellCopyOptionalMediaAssetsFromSource(opts,
                                                           sourceRoots[i],
                                                           files,
                                                           mediaAssetsCopied,
                                                           outError):
            return false
    return true

@borrows
fn MobileShellMirrorRuntimeFile(opts: MobileShellOptions,
                                  sourceFull: str,
                                  targetRel: str,
                                  files: var str[],
    outError: var str): bool =
    if !os.FileExists(sourceFull):
        outError = Fmt"mobile-shell: runtime mirror source missing: {sourceFull}"
        return false
    let payloadText: str = os.ReadFile(sourceFull)
    let targetFull: str = chengpath.PathJoin(opts.outDir, targetRel)
    return MobileShellWriteFile(targetFull, payloadText, targetRel, files, outError)

@borrows
fn MobileShellMirrorRawTree(opts: MobileShellOptions,
                              sourceRoot: str,
                              targetRootRel: str,
                              files: var str[],
                              outError: var str): bool =
    var copiedCount: int32
    return MobileShellCopyRawTreeRec(opts,
                                       sourceRoot,
                                       "",
                                       targetRootRel,
                                       files,
                                       copiedCount,
                                       outError)

@borrows
fn MobileShellWriteRuntimeStubFile(opts: MobileShellOptions,
                                     targetRel: str,
                                     files: var str[],
                                     outError: var str): bool =
    let targetFull: str = chengpath.PathJoin(opts.outDir, targetRel)
    return MobileShellWriteFile(targetFull, "{\n}\n", targetRel, files, outError)

@borrows
fn MobileShellWriteLaunchArgsFiles(outDir: str,
                                     routeState: str,
                                     runtimeMode: str,
                                     runtimeManifestRel: str,
                                     runtimeContractPayloadRel: str,
                                     runtimeBundlePayloadRel: str,
                                     files: var str[],
                                     outLaunchArgsKvRel: var str,
                                     outLaunchArgsJsonRel: var str,
                                     outError: var str): bool =
    outLaunchArgsKvRel = MobileShellLaunchArgsKvRelPath()
    outLaunchArgsJsonRel = MobileShellLaunchArgsJsonRelPath()
    let kvPath: str = chengpath.PathJoin(outDir, outLaunchArgsKvRel)
    let jsonPath: str = chengpath.PathJoin(outDir, outLaunchArgsJsonRel)
    let kvRouteState: str = Fmt"{routeState}"
    let kvRuntimeMode: str = Fmt"{runtimeMode}"
    let kvRuntimeManifestRel: str = Fmt"{runtimeManifestRel}"
    let kvRuntimeContractPayloadRel: str = Fmt"{runtimeContractPayloadRel}"
    let kvRuntimeBundlePayloadRel: str = Fmt"{runtimeBundlePayloadRel}"
    let jsonRouteState: str = Fmt"{routeState}"
    let jsonRuntimeMode: str = Fmt"{runtimeMode}"
    let jsonRuntimeManifestRel: str = Fmt"{runtimeManifestRel}"
    let jsonRuntimeContractPayloadRel: str = Fmt"{runtimeContractPayloadRel}"
    let jsonRuntimeBundlePayloadRel: str = Fmt"{runtimeBundlePayloadRel}"
    if !MobileShellWriteFile(jsonPath,
                               MobileShellLaunchArgsJsonText(jsonRouteState,
                                                               jsonRuntimeMode,
                                                               jsonRuntimeManifestRel,
                                                               jsonRuntimeContractPayloadRel,
                                                               jsonRuntimeBundlePayloadRel),
                               outLaunchArgsJsonRel,
                               files,
                               outError):
        return false
    if !MobileShellWriteFile(kvPath,
                               MobileShellLaunchArgsKvText(kvRouteState,
                                                             kvRuntimeMode,
                                                             kvRuntimeManifestRel,
                                                             kvRuntimeContractPayloadRel,
                                                             kvRuntimeBundlePayloadRel),
                               outLaunchArgsKvRel,
                               files,
                               outError):
        return false
    return true

@borrows
fn MobileShellWritePlatformRuntimeMirrors(opts: MobileShellOptions,
                                            runtimeManifestPath: str,
                                            runtimeContractPayloadRel: str,
                                            runtimeBundlePayloadRel: str,
                                            runtimeSemanticNodesRel: str,
                                            runtimeTruthRootRel: str,
                                            launchArgsKvRel: str,
                                            launchArgsJsonRel: str,
                                            files: var str[],
                                            outError: var str): bool =
    if MobileShellRuntimeModeRequiresNativeSceneRenderer(opts.runtimeMode):
        if len(runtimeContractPayloadRel) <= 0:
            outError = "mobile-shell: native scene renderer requires a real runtime contract payload"
            return false
        if len(runtimeBundlePayloadRel) <= 0:
            outError = "mobile-shell: native scene renderer requires a real runtime bundle payload"
            return false
    if opts.emitAndroid:
        if !MobileShellMirrorRuntimeFile(opts,
                                           runtimeManifestPath,
                                           MobileShellAndroidRuntimeManifestRelPath(),
                                           files,
                                           outError):
            return false
        if len(runtimeContractPayloadRel) > 0:
            if !MobileShellMirrorRuntimeFile(opts,
                                               chengpath.PathJoin(opts.outDir, runtimeContractPayloadRel),
                                               MobileShellAndroidRuntimeContractPayloadRelPath(),
                                               files,
                                               outError):
                return false
        else:
            if !MobileShellWriteRuntimeStubFile(opts,
                                                  MobileShellAndroidRuntimeContractPayloadRelPath(),
                                                  files,
                                                  outError):
                return false
        if len(runtimeBundlePayloadRel) > 0:
            if !MobileShellMirrorRuntimeFile(opts,
                                               chengpath.PathJoin(opts.outDir, runtimeBundlePayloadRel),
                                               MobileShellAndroidRuntimeBundlePayloadRelPath(),
                                               files,
                                               outError):
                return false
        else:
            if !MobileShellWriteRuntimeStubFile(opts,
                                                  MobileShellAndroidRuntimeBundlePayloadRelPath(),
                                                  files,
                                                  outError):
                return false
        if !MobileShellMirrorRuntimeFile(opts,
                                           chengpath.PathJoin(opts.outDir, launchArgsKvRel),
                                           MobileShellAndroidLaunchArgsKvRelPath(),
                                           files,
                                           outError):
            return false
        if !MobileShellMirrorRuntimeFile(opts,
                                           chengpath.PathJoin(opts.outDir, launchArgsJsonRel),
                                           MobileShellAndroidLaunchArgsJsonRelPath(),
                                           files,
                                           outError):
            return false
        let glyphSdfPixelsSource: str = chengpath.PathJoin(opts.outDir, MobileShellRuntimeGlyphSdfPixelsRelPath())
        if os.FileExists(glyphSdfPixelsSource):
            if !MobileShellCopyRawFile(opts,
                                         glyphSdfPixelsSource,
                                         MobileShellAndroidAssetMirrorRelPath(MobileShellRuntimeGlyphSdfPixelsRelPath()),
                                         files,
                                         outError):
                return false
        let sceneDataSource: str = chengpath.PathJoin(opts.outDir, MobileShellRuntimeSceneDataRelPath())
        if os.FileExists(sceneDataSource):
            if !MobileShellCopyRawFile(opts,
                                         sceneDataSource,
                                         MobileShellAndroidAssetMirrorRelPath(MobileShellRuntimeSceneDataRelPath()),
                                         files,
                                         outError):
                return false
        let computerUseManifestSource: str = chengpath.PathJoin(opts.outDir, MobileShellRuntimeComputerUseManifestRelPath())
        if os.FileExists(computerUseManifestSource):
            if !MobileShellCopyRawFile(opts,
                                         computerUseManifestSource,
                                         MobileShellAndroidAssetMirrorRelPath(MobileShellRuntimeComputerUseManifestRelPath()),
                                         files,
                                         outError):
                return false
        let mediaAssetsSourceRoot: str = chengpath.PathJoin(opts.outDir, MobileShellRuntimeMediaAssetsRelPath())
        if os.DirExists(mediaAssetsSourceRoot):
            if !MobileShellMirrorRawTree(opts,
                                           mediaAssetsSourceRoot,
                                           MobileShellAndroidAssetMirrorRelPath(MobileShellRuntimeMediaAssetsRelPath()),
                                           files,
                                           outError):
                return false
        if len(runtimeSemanticNodesRel) > 0:
            if !MobileShellCopyRawFile(opts,
                                         chengpath.PathJoin(opts.outDir, runtimeSemanticNodesRel),
                                         MobileShellAndroidAssetMirrorRelPath(runtimeSemanticNodesRel),
                                         files,
                                         outError):
                return false
        if len(runtimeTruthRootRel) > 0:
            let truthSourceRoot: str = chengpath.PathJoin(opts.outDir, runtimeTruthRootRel)
            if !MobileShellMirrorRawTree(opts,
                                           truthSourceRoot,
                                           MobileShellAndroidAssetMirrorRelPath(runtimeTruthRootRel),
                                           files,
                                           outError):
                return false
    if opts.emitIos:
        if !MobileShellMirrorRuntimeFile(opts,
                                           runtimeManifestPath,
                                           MobileShellIosRuntimeManifestRelPath(),
                                           files,
                                           outError):
            return false
        if len(runtimeContractPayloadRel) > 0:
            if !MobileShellMirrorRuntimeFile(opts,
                                               chengpath.PathJoin(opts.outDir, runtimeContractPayloadRel),
                                               MobileShellIosRuntimeContractPayloadRelPath(),
                                               files,
                                               outError):
                return false
        else:
            if !MobileShellWriteRuntimeStubFile(opts,
                                                  MobileShellIosRuntimeContractPayloadRelPath(),
                                                  files,
                                                  outError):
                return false
        if len(runtimeBundlePayloadRel) > 0:
            if !MobileShellMirrorRuntimeFile(opts,
                                               chengpath.PathJoin(opts.outDir, runtimeBundlePayloadRel),
                                               MobileShellIosRuntimeBundlePayloadRelPath(),
                                               files,
                                               outError):
                return false
        else:
            if !MobileShellWriteRuntimeStubFile(opts,
                                                  MobileShellIosRuntimeBundlePayloadRelPath(),
                                                  files,
                                                  outError):
                return false
        if !MobileShellMirrorRuntimeFile(opts,
                                           chengpath.PathJoin(opts.outDir, launchArgsKvRel),
                                           MobileShellIosLaunchArgsKvRelPath(),
                                           files,
                                           outError):
            return false
        if !MobileShellMirrorRuntimeFile(opts,
                                           chengpath.PathJoin(opts.outDir, launchArgsJsonRel),
                                           MobileShellIosLaunchArgsJsonRelPath(),
                                           files,
                                           outError):
            return false
        if len(runtimeSemanticNodesRel) > 0:
            if !MobileShellCopyRawFile(opts,
                                         chengpath.PathJoin(opts.outDir, runtimeSemanticNodesRel),
                                         MobileShellIosAssetMirrorRelPath(runtimeSemanticNodesRel),
                                         files,
                                         outError):
                return false
        if len(runtimeTruthRootRel) > 0:
            let truthSourceRoot: str = chengpath.PathJoin(opts.outDir, runtimeTruthRootRel)
            if !MobileShellMirrorRawTree(opts,
                                           truthSourceRoot,
                                           MobileShellIosAssetMirrorRelPath(runtimeTruthRootRel),
                                           files,
                                           outError):
                return false
    if opts.emitHarmony:
        if !MobileShellMirrorRuntimeFile(opts,
                                           runtimeManifestPath,
                                           MobileShellHarmonyRuntimeManifestRelPath(),
                                           files,
                                           outError):
            return false
        if len(runtimeContractPayloadRel) > 0:
            if !MobileShellMirrorRuntimeFile(opts,
                                               chengpath.PathJoin(opts.outDir, runtimeContractPayloadRel),
                                               MobileShellHarmonyRuntimeContractPayloadRelPath(),
                                               files,
                                               outError):
                return false
        else:
            if !MobileShellWriteRuntimeStubFile(opts,
                                                  MobileShellHarmonyRuntimeContractPayloadRelPath(),
                                                  files,
                                                  outError):
                return false
        if len(runtimeBundlePayloadRel) > 0:
            if !MobileShellMirrorRuntimeFile(opts,
                                               chengpath.PathJoin(opts.outDir, runtimeBundlePayloadRel),
                                               MobileShellHarmonyRuntimeBundlePayloadRelPath(),
                                               files,
                                               outError):
                return false
        else:
            if !MobileShellWriteRuntimeStubFile(opts,
                                                  MobileShellHarmonyRuntimeBundlePayloadRelPath(),
                                                  files,
                                                  outError):
                return false
        if !MobileShellMirrorRuntimeFile(opts,
                                           chengpath.PathJoin(opts.outDir, launchArgsKvRel),
                                           MobileShellHarmonyLaunchArgsKvRelPath(),
                                           files,
                                           outError):
            return false
        if !MobileShellMirrorRuntimeFile(opts,
                                           chengpath.PathJoin(opts.outDir, launchArgsJsonRel),
                                           MobileShellHarmonyLaunchArgsJsonRelPath(),
                                           files,
                                           outError):
            return false
        if len(runtimeSemanticNodesRel) > 0:
            if !MobileShellCopyRawFile(opts,
                                         chengpath.PathJoin(opts.outDir, runtimeSemanticNodesRel),
                                         MobileShellHarmonyAssetMirrorRelPath(runtimeSemanticNodesRel),
                                         files,
                                         outError):
                return false
        if len(runtimeTruthRootRel) > 0:
            let truthSourceRoot: str = chengpath.PathJoin(opts.outDir, runtimeTruthRootRel)
            if !MobileShellMirrorRawTree(opts,
                                           truthSourceRoot,
                                           MobileShellHarmonyAssetMirrorRelPath(runtimeTruthRootRel),
                                           files,
                                           outError):
                return false
    return true

@borrows
fn MobileShellAndroidDefaultConfigNativeText(opts: MobileShellOptions): str =
    if MobileShellAndroidNativeModeIsPrebuilt(opts.androidNativeMode):
        return Fmt"""
            ndk {{
                abiFilters += {MobileShellQuote(MobileShellAndroidAbi())}
            }}

        """
    return Fmt"""
            externalNativeBuild {{
                cmake {{
                    cppFlags += {MobileShellQuote("-std=c17")}
                }}
            }}

    """

@borrows
fn MobileShellAndroidProjectNativeText(opts: MobileShellOptions): str =
    if MobileShellAndroidNativeModeIsPrebuilt(opts.androidNativeMode):
        return Fmt"""
        sourceSets {{
            getByName("main") {{
                jniLibs.srcDirs("src/main/jniLibs")
            }}
        }}

        """
    return Fmt"""
        externalNativeBuild {{
            cmake {{
                path = file("src/main/cpp/CMakeLists.txt")
            }}
        }}

    """

@borrows
fn MobileShellAndroidNdkVersionText(opts: MobileShellOptions): str =
    let ndkRoot: str = strutil.Strip(opts.androidNdkRoot)
    if len(ndkRoot) <= 0:
        return ""
    let ndkVersion: str = chengpath.PathBaseName(ndkRoot)
    if len(ndkVersion) <= 0:
        return ""
    return Fmt"""
        ndkVersion = {MobileShellQuote(ndkVersion)}

    """

fn MobileShellAndroidVersionCodeText(): str =
    let raw: str = strutil.Strip(os.GetEnv("CHENG_MOBILE_SHELL_VERSION_CODE"))
    if len(raw) <= 0:
        return "1"
    for i in 0..<len(raw):
        let ch: char = raw[i]
        if ch < '0' || ch > '9':
            return "invalid_version_code_env"
    return raw

@borrows
fn MobileShellAndroidAppBuildGradle(opts: MobileShellOptions): str =
    return Fmt"""
    plugins {{
        id("com.android.application")
        id("org.jetbrains.kotlin.android")
    }}

    android {{
        namespace = {MobileShellQuote(opts.appId)}
        compileSdk = 36
        {MobileShellAndroidNdkVersionText(opts)}

        defaultConfig {{
            applicationId = {MobileShellQuote(opts.appId)}
            minSdk = 30
            targetSdk = 36
            versionCode = {MobileShellAndroidVersionCodeText()}
            versionName = {MobileShellQuote("1.0")}
        {MobileShellAndroidDefaultConfigNativeText(opts)}
        }}

        buildTypes {{
            release {{
                isMinifyEnabled = false
                proguardFiles(
                    getDefaultProguardFile("proguard-android-optimize.txt"),
                    "proguard-rules.pro"
                )
            }}
        }}

        {MobileShellAndroidProjectNativeText(opts)}

        buildFeatures {{
            prefab = false
        }}
        androidResources {{
            noCompress += listOf("bin", "mp4", "png", "wav")
        }}
        compileOptions {{
            sourceCompatibility = JavaVersion.VERSION_17
            targetCompatibility = JavaVersion.VERSION_17
        }}
        kotlinOptions {{
            jvmTarget = {MobileShellQuote("17")}
        }}
    }}

    dependencies {{
        implementation({MobileShellQuote("androidx.core:core-ktx:1.13.1")})
        implementation({MobileShellQuote("com.google.mlkit:barcode-scanning:17.3.0")})
    }}

    """

@borrows
fn MobileShellAndroidManifest(opts: MobileShellOptions): str =
    return Fmt"""
    <?xml version="1.0" encoding="utf-8"?>
	    <manifest xmlns:android="http://schemas.android.com/apk/res/android">
	        <uses-permission android:name="android.permission.INTERNET" />
        <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	        <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
		        <uses-permission android:name="android.permission.REORDER_TASKS" />
		        <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
		        <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
		        <uses-permission android:name="android.permission.USE_BIOMETRIC" />
		        <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
		        <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
	        <application
            android:allowBackup="false"
            android:label="@string/app_name"
            android:theme="@style/ChengMobileShellTheme"
            android:vmSafeMode="true">
            <activity
                android:name=".ChengMainActivity"
                android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
                android:exported="true"
                android:launchMode="singleTask"
                android:screenOrientation="portrait"
                android:windowSoftInputMode="adjustNothing">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity>
        </application>
    </manifest>

    """

@borrows
fn MobileShellAndroidProguardRules(opts: MobileShellOptions): str =
    return Fmt"""
    # Generated by cheng mobile-shell export.
    -keep class {opts.appId}.** {{ *; }}
    -keepclassmembers class * {{
        native <methods>;
    }}

    """

@borrows
fn MobileShellAndroidStringsXml(opts: MobileShellOptions): str =
    return Fmt"""
    <?xml version="1.0" encoding="utf-8"?>
    <resources>
        <string name="app_name">{opts.appName}</string>
    </resources>

    """

fn MobileShellAndroidStylesXml(): str =
    return Fmt"""
    <?xml version="1.0" encoding="utf-8"?>
    <resources>
        <style name="ChengMobileShellTheme" parent="@android:style/Theme.Material.NoActionBar">
            <item name="android:windowNoTitle">true</item>
            <item name="android:windowActionBar">false</item>
            <item name="android:windowFullscreen">true</item>
            <item name="android:windowDrawsSystemBarBackgrounds">true</item>
            <item name="android:statusBarColor">#F9FAFB</item>
            <item name="android:navigationBarColor">#F9FAFB</item>
            <!-- Launch splash matches the home root background (#F9FAFB) so the
                 system pre-first-frame window seamlessly becomes the home page
                 instead of flashing black during the one-time asset load + build. -->
            <item name="android:windowBackground">#F9FAFB</item>
        </style>
    </resources>

    """

