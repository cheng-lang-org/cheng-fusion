    static int cheng_android_present_allowed_or_skip(const char* context) {{
      if (s_headless_capture || cheng_android_present_enabled()) {{
        return 1;
      }}
      if (s_present_skip_log_count < 16) {{
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "present_skip context=%s enabled=0", context != NULL ? context : "");
        s_present_skip_log_count++;
      }}
      return 0;
    }}

    static void cheng_android_gl_abort_if_false(int ok, const char* stage);

    /* eglSwapBuffers legitimately loses the race with surfaceDestroyed: the UI
       thread abandons the window's BufferQueue while the render thread is
       mid-frame, so a swap to the dying EGLSurface fails with
       EGL_BAD_SURFACE/EGL_BAD_NATIVE_WINDOW (or the context-lost family on
       some drivers). That is a recoverable lifecycle event — skip the frame
       (the lifecycle path already flipped present_enabled=false and rebuilds
       on surfaceCreated) instead of aborting. Any other swap failure stays
       fatal via the abort helper. */
    static void cheng_android_swap_or_skip_dead_surface(const char* stage) {{
      if (eglSwapBuffers(s_egl_display, s_egl_surface)) {{
        return;
      }}
      EGLint swap_err = eglGetError();
      if (swap_err == EGL_BAD_SURFACE || swap_err == EGL_BAD_NATIVE_WINDOW ||
          swap_err == EGL_BAD_DISPLAY || swap_err == EGL_NOT_INITIALIZED
#ifdef EGL_CONTEXT_LOST
          || swap_err == EGL_CONTEXT_LOST
#endif
      ) {{
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "%s skipped: surface lost mid-frame (egl err=0x%x)", stage, swap_err);
        return;
      }}
      cheng_android_gl_abort_if_false(0, stage);
    }}

