                    val receiptAudioProviderHash = if (receiptIndex >= 0 && runtimeHandle == handle) nativeMediaReceiptAudioProviderHashAt(handle, receiptIndex) else -1
                    val hostAudioOk = ok && handleHostAudioAction(receiptKind, slotId, action, payload, receiptAudioProviderHash)
                    val hostFrame = if (runtimeHandle == handle) nativeMediaPlaybackFrameCount(handle) else -1
                    val hostUpdate = if (runtimeHandle == handle) nativeMediaPlaybackUpdateCount(handle) else -1
