    static void cheng_log(const char* msg) {{
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "%s", msg);
    }}

	    static void* cheng_resolve_required_app_export(const char* name) {{
	      dlerror();
	      void* symbol = dlsym(s_app_handle, name);
	      const char* error = dlerror();
	      if (symbol == NULL) {{
        if (error != NULL) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "missing required app export %s: %s", name, error);
        }} else {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "missing required app export %s", name);
        }}
	      }}
	      return symbol;
	    }}

	    static void* cheng_resolve_required_mobile_capi_export(const char* name) {{
	      dlerror();
	      void* symbol = dlsym(s_mobile_capi_handle, name);
	      const char* error = dlerror();
	      if (symbol == NULL) {{
	        if (error != NULL) {{
	          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "missing required mobile CAPI export %s: %s", name, error);
	        }} else {{
	          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "missing required mobile CAPI export %s", name);
	        }}
	      }}
	      return symbol;
	    }}

	    static int cheng_resolve_mobile_capi_exports(void) {{
	      if (s_mobile_capi_bio_did_create_trusted_wire != NULL) {{
	        return 1;
	      }}
	      s_mobile_capi_handle = dlopen("libcheng_mobile_capi.so", RTLD_NOW | RTLD_GLOBAL);
	      if (s_mobile_capi_handle == NULL) {{
	        const char* error = dlerror();
	        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "failed to load libcheng_mobile_capi.so: %s", error != NULL ? error : "unknown");
	        return 0;
	      }}
	      s_mobile_capi_bio_did_create_trusted_wire = (cheng_mobile_capi_bio_did_create_trusted_wire_fn)cheng_resolve_required_mobile_capi_export("MobileCapiBioDidCreateTrustedWire");
	      s_mobile_capi_bio_did_import_wire = (cheng_mobile_capi_bio_did_import_wire_fn)cheng_resolve_required_mobile_capi_export("MobileCapiBioDidImportWire");
	      return s_mobile_capi_bio_did_create_trusted_wire != NULL && s_mobile_capi_bio_did_import_wire != NULL;
	    }}

	    static void cheng_android_gpu_destroy(void);

    typedef struct ChengHostAllocHeader {{
      struct ChengHostAllocHeader* prev;
      struct ChengHostAllocHeader* next;
      int32_t size;
      int32_t ref_count;
    }} ChengHostAllocHeader;

    typedef struct ChengHostSeqHeader {{
      int32_t len;
      int32_t cap;
      void* buffer;
    }} ChengHostSeqHeader;

    typedef struct ChengHostStr {{
      void* data;
      int32_t len;
      int32_t store_id;
      int32_t flags;
    }} ChengHostStr;

    static pthread_mutex_t g_cheng_host_alloc_lock = PTHREAD_MUTEX_INITIALIZER;
    static ChengHostAllocHeader* g_cheng_host_alloc_head = NULL;

    static void cheng_host_alloc_lock(void) {{
      if (pthread_mutex_lock(&g_cheng_host_alloc_lock) != 0) {{
        abort();
      }}
    }}

    static void cheng_host_alloc_unlock(void) {{
      if (pthread_mutex_unlock(&g_cheng_host_alloc_lock) != 0) {{
        abort();
      }}
    }}

    static ChengHostAllocHeader* cheng_host_alloc_find_locked(void* payload) {{
      ChengHostAllocHeader* cur = g_cheng_host_alloc_head;
      while (cur != NULL) {{
        if ((void*)(cur + 1) == payload) {{
          return cur;
        }}
        cur = cur->next;
      }}
      return NULL;
    }}

    static void cheng_host_alloc_link_locked(ChengHostAllocHeader* header) {{
      header->prev = NULL;
      header->next = g_cheng_host_alloc_head;
      if (g_cheng_host_alloc_head != NULL) {{
        g_cheng_host_alloc_head->prev = header;
      }}
      g_cheng_host_alloc_head = header;
    }}

    static void cheng_host_alloc_unlink_locked(ChengHostAllocHeader* header) {{
      if (header->prev != NULL) {{
        header->prev->next = header->next;
      }} else if (g_cheng_host_alloc_head == header) {{
        g_cheng_host_alloc_head = header->next;
      }}
      if (header->next != NULL) {{
        header->next->prev = header->prev;
      }}
      header->prev = NULL;
      header->next = NULL;
    }}

    void* cheng_malloc(int32_t size) {{
      if (size <= 0) {{
        size = 1;
      }}
      size_t payload_size = (size_t)size;
      if (payload_size > SIZE_MAX - sizeof(ChengHostAllocHeader)) {{
        abort();
      }}
      ChengHostAllocHeader* header = (ChengHostAllocHeader*)calloc(1u, sizeof(ChengHostAllocHeader) + payload_size);
      if (header == NULL) {{
        return NULL;
      }}
      header->size = size;
      header->ref_count = 1;
      cheng_host_alloc_lock();
      cheng_host_alloc_link_locked(header);
      cheng_host_alloc_unlock();
      return (void*)(header + 1);
    }}

    void cheng_free(void* p) {{
      if (p == NULL) {{
        return;
      }}
      cheng_host_alloc_lock();
      ChengHostAllocHeader* header = cheng_host_alloc_find_locked(p);
      if (header != NULL) {{
        cheng_host_alloc_unlink_locked(header);
        cheng_host_alloc_unlock();
        free(header);
        return;
      }}
      cheng_host_alloc_unlock();
      free(p);
    }}

    void cheng_mem_retain(void* p) {{
      if (p == NULL) {{
        return;
      }}
      cheng_host_alloc_lock();
      ChengHostAllocHeader* header = cheng_host_alloc_find_locked(p);
      if (header != NULL) {{
        if (header->ref_count == INT32_MAX) {{
          cheng_host_alloc_unlock();
          abort();
        }}
        header->ref_count += 1;
      }}
      cheng_host_alloc_unlock();
    }}

    void cheng_mem_release(void* p) {{
      if (p == NULL) {{
        return;
      }}
      ChengHostAllocHeader* free_header = NULL;
      cheng_host_alloc_lock();
      ChengHostAllocHeader* header = cheng_host_alloc_find_locked(p);
      if (header != NULL) {{
        header->ref_count -= 1;
        if (header->ref_count <= 0) {{
          cheng_host_alloc_unlink_locked(header);
          free_header = header;
        }}
      }}
      cheng_host_alloc_unlock();
      if (free_header != NULL) {{
        free(free_header);
      }}
    }}

