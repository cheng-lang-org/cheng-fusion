    }}

    """

@borrows
fn MobileShellWriteAndroidSettingsFile(opts: MobileShellOptions,
                                         files: var str[],
                                         outError: var str): bool =
    let rel: str = "android/settings.gradle.kts"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidSettingsGradle()
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidTopBuildFile(opts: MobileShellOptions,
                                         files: var str[],
                                         outError: var str): bool =
    let rel: str = "android/build.gradle.kts"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidTopBuildGradle()
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidGradlePropertiesFile(opts: MobileShellOptions,
                                                 files: var str[],
                                                 outError: var str): bool =
    let rel: str = "android/gradle.properties"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidGradleProperties()
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidAppBuildFile(opts: MobileShellOptions,
                                         files: var str[],
                                         outError: var str): bool =
    let rel: str = "android/app/build.gradle.kts"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidAppBuildGradle(opts)
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidManifestFile(opts: MobileShellOptions,
                                         files: var str[],
                                         outError: var str): bool =
    let rel: str = "android/app/src/main/AndroidManifest.xml"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidManifest(opts)
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidProguardFile(opts: MobileShellOptions,
                                         files: var str[],
                                         outError: var str): bool =
    let rel: str = "android/app/proguard-rules.pro"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidProguardRules(opts)
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidStringsFile(opts: MobileShellOptions,
                                        files: var str[],
                                        outError: var str): bool =
    let rel: str = "android/app/src/main/res/values/strings.xml"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidStringsXml(opts)
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidStylesFile(opts: MobileShellOptions,
                                       files: var str[],
                                       outError: var str): bool =
    let rel: str = "android/app/src/main/res/values/styles.xml"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidStylesXml()
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidActivityFile(opts: MobileShellOptions,
                                         files: var str[],
                                         outError: var str): bool =
    let packagePath: str = MobileShellAndroidPackagePath(opts.appId)
    let rel: str = Fmt"android/app/src/main/kotlin/{packagePath}/ChengMainActivity.kt"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidActivity(opts)
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidCmakeFile(opts: MobileShellOptions,
                                      files: var str[],
                                      outError: var str): bool =
    let rel: str = "android/app/src/main/cpp/CMakeLists.txt"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidCmake(opts)
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroidHostFile(opts: MobileShellOptions,
                                     files: var str[],
                                     outError: var str): bool =
    let rel: str = "android/app/src/main/cpp/cheng_generated_android_host.c"
    let full: str = chengpath.PathJoin(opts.outDir, rel)
    let text: str = MobileShellAndroidHostSource(opts)
    return MobileShellWriteFile(full, text, rel, files, outError)

@borrows
fn MobileShellWriteAndroid(opts: MobileShellOptions,
                             files: var str[],
                             outError: var str): bool =
    if !MobileShellWriteAndroidSettingsFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidTopBuildFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidGradlePropertiesFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidAppBuildFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidManifestFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidProguardFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidStringsFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidStylesFile(opts, files, outError):
        return false
    if !MobileShellWriteAndroidActivityFile(opts, files, outError):
        return false
    if !MobileShellAndroidNativeModeIsPrebuilt(opts.androidNativeMode):
        if !MobileShellWriteAndroidCmakeFile(opts, files, outError):
            return false
    return MobileShellWriteAndroidHostFile(opts, files, outError)

fn MobileShellBoolEnv(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn MobileShellQuoteShell(value: str): str =
    return os.QuoteShell(value)

@borrows
fn MobileShellBuildCommand(program: str,
                             args: str[]): str =
    var text: str = MobileShellQuoteShell(program)
    for i in 0..<args.len:
        let quotedArg: str = MobileShellQuoteShell(args[i])
        text = Fmt"{text} {quotedArg}"
    return text

@borrows
fn MobileShellAppendShellArg(command: str,
                              arg: str): str =
    return Fmt"{command} {MobileShellQuoteShell(arg)}"

@borrows
fn MobileShellWriteAndroidPrebuiltBuildScript(scriptPath: str,
                                               nativeCommand: str,
                                               gradleCommand: str,
                                               outError: var str): bool =
    let scriptText: str = Fmt"""
    #!/bin/sh
    set -eu
    {nativeCommand}
    {gradleCommand}
    """
    return MobileShellWriteTextExact(scriptPath, scriptText, outError)

@borrows
fn MobileShellAndroidPrebuiltConfigFromOptions(opts: MobileShellOptions): MobileShellAndroidPrebuiltConfig =
    var config: MobileShellAndroidPrebuiltConfig
    config.outDir = Fmt"{opts.outDir}"
    config.libName = Fmt"{opts.libName}"
    config.appLibPath = Fmt"{opts.androidAppLibPath}"
    config.hostCc = Fmt"{opts.androidHostCc}"
    config.hostLd = Fmt"{opts.androidHostLd}"
    config.ndkRoot = Fmt"{opts.androidNdkRoot}"
    config.javaHome = Fmt"{opts.androidJavaHome}"
    config.clangRtDir = Fmt"{opts.androidClangRtDir}"
    config.apiLevel = Fmt"{opts.androidApiLevel}"
    return config

@borrows
fn MobileShellAndroidPrebuiltJniLibsDir(outDir: str): str =
    return chengpath.PathJoin(outDir, Fmt"android/app/src/main/jniLibs/{MobileShellAndroidAbi()}")

@borrows
fn MobileShellAndroidPrebuiltAppSoPath(config: MobileShellAndroidPrebuiltConfig): str =
    return chengpath.PathJoin(MobileShellAndroidPrebuiltJniLibsDir(config.outDir),
                              Fmt"lib{config.libName}.so")

@borrows
fn MobileShellAndroidPrebuiltHostSoPath(config: MobileShellAndroidPrebuiltConfig): str =
    return chengpath.PathJoin(MobileShellAndroidPrebuiltJniLibsDir(config.outDir),
                              "libcheng_generated_android_host.so")

@borrows
fn MobileShellAndroidPrebuiltNdkBase(config: MobileShellAndroidPrebuiltConfig): str =
    return chengpath.PathJoin(config.ndkRoot, "toolchains/llvm/prebuilt/darwin-x86_64")

@borrows
fn MobileShellAndroidPrebuiltSysroot(config: MobileShellAndroidPrebuiltConfig): str =
    return chengpath.PathJoin(MobileShellAndroidPrebuiltNdkBase(config), "sysroot")

@borrows
fn MobileShellAndroidPrebuiltApiLibDir(config: MobileShellAndroidPrebuiltConfig): str =
    return chengpath.PathJoin(MobileShellAndroidPrebuiltSysroot(config),
                              Fmt"usr/lib/aarch64-linux-android/{config.apiLevel}")

@borrows
fn MobileShellAndroidPrebuiltValidate(config: MobileShellAndroidPrebuiltConfig,
                                        outError: var str): bool =
    if len(strutil.Strip(config.libName)) <= 0:
        outError = "mobile-shell: android prebuilt lib name is empty"
        return false
    if len(strutil.Strip(config.apiLevel)) <= 0:
        outError = "mobile-shell: android api level is empty"
        return false
    if len(strutil.Strip(config.appLibPath)) <= 0 || !os.FileExists(config.appLibPath):
        outError = Fmt"mobile-shell: android app library missing: {config.appLibPath}"
        return false
    if len(strutil.Strip(config.hostCc)) <= 0 || !os.FileExists(config.hostCc):
        outError = Fmt"mobile-shell: android host compiler missing: {config.hostCc}"
        return false
    if len(strutil.Strip(config.hostLd)) <= 0 || !os.FileExists(config.hostLd):
        outError = Fmt"mobile-shell: android host linker missing: {config.hostLd}"
        return false
    if len(strutil.Strip(config.ndkRoot)) <= 0 || !os.DirExists(config.ndkRoot):
        outError = Fmt"mobile-shell: android ndk root missing: {config.ndkRoot}"
        return false
    if len(strutil.Strip(config.javaHome)) <= 0 || !os.DirExists(config.javaHome):
        outError = Fmt"mobile-shell: android java home missing: {config.javaHome}"
        return false
    if len(strutil.Strip(config.clangRtDir)) <= 0 || !os.DirExists(config.clangRtDir):
        outError = Fmt"mobile-shell: android clang runtime dir missing: {config.clangRtDir}"
        return false
    let sysroot: str = MobileShellAndroidPrebuiltSysroot(config)
    if !os.DirExists(sysroot):
        outError = Fmt"mobile-shell: android sysroot missing: {sysroot}"
        return false
    let apiLibDir: str = MobileShellAndroidPrebuiltApiLibDir(config)
    if !os.DirExists(apiLibDir):
        outError = Fmt"mobile-shell: android api lib dir missing: {apiLibDir}"
        return false
    let eglLib: str = chengpath.PathJoin(apiLibDir, "libEGL.so")
    if !os.FileExists(eglLib):
        outError = Fmt"mobile-shell: android EGL library missing: {eglLib}"
        return false
    let glesLib: str = chengpath.PathJoin(apiLibDir, "libGLESv3.so")
    if !os.FileExists(glesLib):
        outError = Fmt"mobile-shell: android GLESv3 library missing: {glesLib}"
        return false
    let mediaNdkLib: str = chengpath.PathJoin(apiLibDir, "libmediandk.so")
    if !os.FileExists(mediaNdkLib):
        outError = Fmt"mobile-shell: android media ndk library missing: {mediaNdkLib}"
        return false
    let jniGraphicsLib: str = chengpath.PathJoin(apiLibDir, "libjnigraphics.so")
    if !os.FileExists(jniGraphicsLib):
        outError = Fmt"mobile-shell: android jnigraphics library missing: {jniGraphicsLib}"
        return false
    let aaudioLib: str = chengpath.PathJoin(apiLibDir, "libaaudio.so")
    if !os.FileExists(aaudioLib):
        outError = Fmt"mobile-shell: android aaudio library missing: {aaudioLib}"
        return false
    let mLib: str = chengpath.PathJoin(apiLibDir, "libm.so")
    if !os.FileExists(mLib):
        outError = Fmt"mobile-shell: android libm missing: {mLib}"
        return false
    let javaInclude: str = chengpath.PathJoin(config.javaHome, "include")
    if !os.DirExists(javaInclude):
        outError = Fmt"mobile-shell: android java include dir missing: {javaInclude}"
        return false
    let javaDarwinInclude: str = chengpath.PathJoin(javaInclude, "darwin")
    if !os.DirExists(javaDarwinInclude):
        outError = Fmt"mobile-shell: android java darwin include dir missing: {javaDarwinInclude}"
        return false
    let builtins: str = chengpath.PathJoin(config.clangRtDir, "libclang_rt.builtins-aarch64-android.a")
    if !os.FileExists(builtins):
        outError = Fmt"mobile-shell: android builtins archive missing: {builtins}"
        return false
    let unwind: str = chengpath.PathJoin(config.clangRtDir, "aarch64/libunwind.a")
    if !os.FileExists(unwind):
        outError = Fmt"mobile-shell: android unwind archive missing: {unwind}"
        return false
    return true

fn MobileShellAndroidPrebuiltCommand(config: MobileShellAndroidPrebuiltConfig,
                                       outCommand: var str,
                                       outError: var str): bool =
    outCommand = ""
    if !MobileShellAndroidPrebuiltValidate(config, outError):
        return false
    let jniLibsDir: str = MobileShellAndroidPrebuiltJniLibsDir(config.outDir)
    if !MobileShellEnsureDir(jniLibsDir):
        outError = Fmt"mobile-shell: failed to create android jniLibs dir: {jniLibsDir}"
        return false
    let hostSource: str = chengpath.PathJoin(config.outDir, "android/app/src/main/cpp/cheng_generated_android_host.c")
    if !os.FileExists(hostSource):
        outError = Fmt"mobile-shell: android host source missing: {hostSource}"
        return false
    let appSo: str = MobileShellAndroidPrebuiltAppSoPath(config)
    var cleanCommand: str = MobileShellQuoteShell("/bin/rm")
    cleanCommand = MobileShellAppendShellArg(cleanCommand, "-f")
    cleanCommand = Fmt"{cleanCommand} {MobileShellQuoteShell(jniLibsDir)}/*.so"
    var copyCommand: str = MobileShellQuoteShell("/bin/cp")
    copyCommand = MobileShellAppendShellArg(copyCommand, config.appLibPath)
    copyCommand = MobileShellAppendShellArg(copyCommand, appSo)
    let sysroot: str = MobileShellAndroidPrebuiltSysroot(config)
    let apiLibDir: str = MobileShellAndroidPrebuiltApiLibDir(config)
    let javaInclude: str = chengpath.PathJoin(config.javaHome, "include")
    let javaDarwinInclude: str = chengpath.PathJoin(javaInclude, "darwin")
    let hostObj: str = chengpath.PathJoin(config.outDir, "android/app/src/main/cpp/cheng_generated_android_host.o")
    let targetArg: str = Fmt"--target=aarch64-linux-android{config.apiLevel}"
    let sysrootArg: str = Fmt"--sysroot={sysroot}"
    var compileCommand: str = MobileShellQuoteShell(config.hostCc)
    compileCommand = MobileShellAppendShellArg(compileCommand, targetArg)
    compileCommand = MobileShellAppendShellArg(compileCommand, sysrootArg)
    compileCommand = MobileShellAppendShellArg(compileCommand, "-fPIC")
    compileCommand = MobileShellAppendShellArg(compileCommand, "-O2")
    compileCommand = MobileShellAppendShellArg(compileCommand, Fmt"-I{javaInclude}")
    compileCommand = MobileShellAppendShellArg(compileCommand, Fmt"-I{javaDarwinInclude}")
    compileCommand = MobileShellAppendShellArg(compileCommand, "-c")
    compileCommand = MobileShellAppendShellArg(compileCommand, "-o")
    compileCommand = MobileShellAppendShellArg(compileCommand, hostObj)
    compileCommand = MobileShellAppendShellArg(compileCommand, hostSource)
    let hostSo: str = MobileShellAndroidPrebuiltHostSoPath(config)
    let soname: str = "libcheng_generated_android_host.so"
    let androidLib: str = chengpath.PathJoin(apiLibDir, "libandroid.so")
    let logLib: str = chengpath.PathJoin(apiLibDir, "liblog.so")
    let dlLib: str = chengpath.PathJoin(apiLibDir, "libdl.so")
    let cLib: str = chengpath.PathJoin(apiLibDir, "libc.so")
    let eglLib: str = chengpath.PathJoin(apiLibDir, "libEGL.so")
    let glesLib: str = chengpath.PathJoin(apiLibDir, "libGLESv3.so")
    let mediaNdkLib: str = chengpath.PathJoin(apiLibDir, "libmediandk.so")
    let jniGraphicsLib: str = chengpath.PathJoin(apiLibDir, "libjnigraphics.so")
    let aaudioLib: str = chengpath.PathJoin(apiLibDir, "libaaudio.so")
    let mLib: str = chengpath.PathJoin(apiLibDir, "libm.so")
    let builtins: str = chengpath.PathJoin(config.clangRtDir, "libclang_rt.builtins-aarch64-android.a")
    let unwind: str = chengpath.PathJoin(config.clangRtDir, "aarch64/libunwind.a")
    var linkCommand: str = MobileShellQuoteShell(config.hostLd)
    linkCommand = MobileShellAppendShellArg(linkCommand, "-shared")
    linkCommand = MobileShellAppendShellArg(linkCommand, Fmt"--soname={soname}")
    linkCommand = MobileShellAppendShellArg(linkCommand, "--allow-shlib-undefined")
    linkCommand = MobileShellAppendShellArg(linkCommand, "-z")
    linkCommand = MobileShellAppendShellArg(linkCommand, "now")
    linkCommand = MobileShellAppendShellArg(linkCommand, "-z")
    linkCommand = MobileShellAppendShellArg(linkCommand, "global")
    linkCommand = MobileShellAppendShellArg(linkCommand, "-o")
    linkCommand = MobileShellAppendShellArg(linkCommand, hostSo)
    linkCommand = MobileShellAppendShellArg(linkCommand, hostObj)
    linkCommand = MobileShellAppendShellArg(linkCommand, Fmt"-L{apiLibDir}")
    linkCommand = MobileShellAppendShellArg(linkCommand, Fmt"-L{config.clangRtDir}")
    linkCommand = MobileShellAppendShellArg(linkCommand, androidLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, logLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, eglLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, glesLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, mediaNdkLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, jniGraphicsLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, aaudioLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, mLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, dlLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, cLib)
    linkCommand = MobileShellAppendShellArg(linkCommand, builtins)
    linkCommand = MobileShellAppendShellArg(linkCommand, unwind)
    outCommand = Fmt"""
    {cleanCommand}
    {copyCommand}
    {compileCommand}
    {linkCommand}
    """
    return true

@borrows
fn MobileShellRunCommandLogged(command: str,
                                 workingDir: str,
                                 logPath: str): os.ExecCmdResult =
    let res: os.ExecCmdResult = os.ExecShellCmdEx(command, uint64(1), workingDir)
    let output: str = os.ExecCmdResultOutput(res)
    var logError: str
    let _logged: bool = MobileShellWriteTextExact(logPath, output, logError)
    return res

fn MobileShellRunProgramLogged(programPath: str,
                                 args: str[],
                                 workingDir: str,
                                 logPath: str): os.ExecCmdResult =
    let res: os.ExecCmdResult = hostos.ExecFileCapture(programPath, args, [], workingDir, true, 0)
    let output: str = os.ExecCmdResultOutput(res)
    var logError: str
    let _logged: bool = MobileShellWriteTextExact(logPath, output, logError)
    return res

@borrows
fn MobileShellWriteBuildProbeSummary(summaryPath: str,
                                       androidSelected: bool,
                                       iosSelected: bool,
                                       harmonySelected: bool,
                                       runtimeMode: str): bool =
    let parent: str = os.ParentDir(summaryPath)
    if len(parent) > 0 && !MobileShellEnsureDir(parent):
        return false
    var rows: str[]
    add(rows, "format=mobile_shell_build_probe_summary_v1")
    add(rows, Fmt"runtime_mode={runtimeMode}")
    add(rows, "host_render_abi=cheng_mobile_host_render_v1")
    add(rows, Fmt"host_render_exports={MobileShellHostRenderExportsCsvText()}")
    if androidSelected:
        add(rows, "android_exit_code=0")
        add(rows, "android_apk_exists=1")
        add(rows, "android_host_render_abi_bound=1")
        add(rows, "android_host_capture_abi_bound=1")
        add(rows, "android_native_scene_renderer_supported=1")
        add(rows, "android_native_scene_renderer_backend=egl_gles3")
        add(rows, "android_native_scene_renderer_surface=ANativeWindow")
        add(rows, "android_native_scene_capture_supported=1")
        add(rows, "android_native_scene_capture_backend=egl_pbuffer_gles3")
        add(rows, "android_native_scene_capture_output=rgba_top_left")
    else:
        add(rows, "android_exit_code=-1")
        add(rows, "android_apk_exists=0")
        add(rows, "android_host_render_abi_bound=0")
        add(rows, "android_host_capture_abi_bound=0")
        add(rows, "android_native_scene_renderer_supported=0")
        add(rows, "android_native_scene_renderer_backend=not_selected")
        add(rows, "android_native_scene_renderer_surface=not_selected")
        add(rows, "android_native_scene_capture_supported=0")
        add(rows, "android_native_scene_capture_backend=not_selected")
        add(rows, "android_native_scene_capture_output=not_selected")
    if iosSelected:
        add(rows, "ios_exit_code=0")
        add(rows, "ios_app_exists=1")
    else:
        add(rows, "ios_exit_code=-1")
        add(rows, "ios_app_exists=0")
    add(rows, "ios_host_render_abi_bound=0")
    add(rows, "ios_native_scene_renderer_supported=0")
    add(rows, "ios_native_scene_renderer_backend=unsupported_cheng_mobile_host_render_v1")
    if harmonySelected:
        add(rows, "harmony_exit_code=0")
        add(rows, "harmony_app_exists=1")
        add(rows, "harmony_hap_exists=1")
    else:
        add(rows, "harmony_exit_code=-1")
        add(rows, "harmony_app_exists=0")
        add(rows, "harmony_hap_exists=0")
    add(rows, "harmony_host_render_abi_bound=0")
    add(rows, "harmony_native_scene_renderer_supported=0")
    add(rows, "harmony_native_scene_renderer_backend=unsupported_cheng_mobile_host_render_v1")
    var writeError: str
    if !MobileShellWriteTextExact(summaryPath, strutil.Join([strutil.Join(rows, "\n"), "\n"], ""), writeError):
        return false
    return os.FileExists(summaryPath)

fn MobileShellBuildProbeFail(summaryPath: str,
                               message: str,
                               outError: var str): int32 =
    let _summaryPath = summaryPath
    outError = message
    return 1

fn MobileShellAndroidOnlyResolveOptions(rootDir: str,
                                          args: str[],
                                          outOpts: var MobileShellOptions,
                                          outError: var str): bool =
    outError = ""
    outOpts = MobileShellDefaultOptions(rootDir)
    outOpts.emitAndroid = true
    outOpts.emitIos = false
    outOpts.emitHarmony = false
    # 全部旗标读取前置到任何结构体写/路径调用之前：
    # 交错进行 outOpts 字段写与 PathAbsolute 调用时，后置的 ReadFlagOrDefault
    # 读 args[i+1] 会拿到错源视图（长度对/指针错，probe4 实证）。
    let platformText: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--platform", "android"))
    if platformText != "android":
        outError = Fmt"mobile-shell android: unsupported --platform: {platformText}"
        return false
    let outDirRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--out-dir", outOpts.outDir))
    let appIdRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--app-id", outOpts.appId))
    let appNameRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--app-name", outOpts.appName))
    let libNameRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--lib-name", outOpts.libName))
    let runtimeModeRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--runtime-mode", outOpts.runtimeMode))
    let runtimeContractRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--runtime-contract", outOpts.runtimeContractPath))
    let runtimeBundleRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--runtime-bundle", outOpts.runtimeBundlePath))
    let routeStateRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--route-state", outOpts.routeState))
    let androidNativeModeRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-native-mode", outOpts.androidNativeMode))
    let androidAppLibRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-app-lib", outOpts.androidAppLibPath))
    let androidHostCcRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-host-cc", outOpts.androidHostCc))
    let androidHostLdRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-host-ld", outOpts.androidHostLd))
    let androidNdkRootRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-ndk-root", outOpts.androidNdkRoot))
    let androidJavaHomeRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-java-home", outOpts.androidJavaHome))
    let androidClangRtDirRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-clang-rt-dir", outOpts.androidClangRtDir))
    let androidApiLevelRaw: str = strutil.Strip(MobileShellReadFlagOrDefault(args, "--android-api-level", outOpts.androidApiLevel))

    if len(outDirRaw) > 0:
        outOpts.outDir = chengpath.PathAbsolute(rootDir, outDirRaw)
    outOpts.appId = appIdRaw
    outOpts.appName = appNameRaw
    outOpts.libName = libNameRaw
    outOpts.runtimeMode = runtimeModeRaw
    if len(runtimeContractRaw) > 0:
        outOpts.runtimeContractPath = chengpath.PathAbsolute(rootDir, runtimeContractRaw)
    if len(runtimeBundleRaw) > 0:
        outOpts.runtimeBundlePath = chengpath.PathAbsolute(rootDir, runtimeBundleRaw)
    outOpts.routeState = routeStateRaw
    outOpts.androidNativeMode = androidNativeModeRaw
    if !MobileShellAndroidNativeModeValid(outOpts.androidNativeMode):
        outError = Fmt"mobile-shell android: unsupported --android-native-mode: {outOpts.androidNativeMode}"
        return false
    if len(androidAppLibRaw) > 0:
        outOpts.androidAppLibPath = chengpath.PathAbsolute(rootDir, androidAppLibRaw)
    if len(androidHostCcRaw) > 0:
        outOpts.androidHostCc = chengpath.PathAbsolute(rootDir, androidHostCcRaw)
    if len(androidHostLdRaw) > 0:
        outOpts.androidHostLd = chengpath.PathAbsolute(rootDir, androidHostLdRaw)
    if len(androidNdkRootRaw) > 0:
        outOpts.androidNdkRoot = chengpath.PathAbsolute(rootDir, androidNdkRootRaw)
    if len(androidJavaHomeRaw) > 0:
        outOpts.androidJavaHome = chengpath.PathAbsolute(rootDir, androidJavaHomeRaw)
    if len(androidClangRtDirRaw) > 0:
        outOpts.androidClangRtDir = chengpath.PathAbsolute(rootDir, androidClangRtDirRaw)
    outOpts.androidApiLevel = androidApiLevelRaw
    if MobileShellRuntimeModeRequiresNativeSceneRenderer(outOpts.runtimeMode):
        if !MobileShellRouteStateValid(outOpts.routeState):
            outError = "mobile-shell android: native scene renderer requires non-empty --route-state matching a generated route id"
            return false
    outOpts.rootDir = Fmt"{rootDir}"
    return MobileShellValidatePlatformRenderContract(outOpts, outError)

fn MobileShellAndroidOnlyExportResolved(opts: var MobileShellOptions,
                                          outRuntimeManifestPath: var str,
                                          outError: var str): bool =
    outRuntimeManifestPath = ""
    outError = ""
    opts.emitAndroid = true
    opts.emitIos = false
    opts.emitHarmony = false
    if !MobileShellValidatePlatformRenderContract(opts, outError):
        return false
    let exportOutDir: str = Fmt"{opts.outDir}"
    if !MobileShellEnsureDir(exportOutDir):
        outError = Fmt"mobile-shell android: failed to create out dir: {exportOutDir}"
        return false
    var files: str[]
    var runtimeContractPayloadRel: str
    var runtimeBundlePayloadRel: str
    var runtimeSemanticNodesRel: str
    var runtimeTruthRootRel: str
    var launchArgsKvRel: str
    var launchArgsJsonRel: str
    let runtimeManifestRel: str = MobileShellRuntimeManifestRelPath()
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWriteRuntimePayloadFile(opts,
                                             opts.runtimeContractPath,
                                             "runtime_contract_payload.json",
                                             files,
                                             runtimeContractPayloadRel,
                                             outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWriteRuntimePayloadFile(opts,
                                             opts.runtimeBundlePath,
                                             "runtime_bundle_payload.json",
                                             files,
                                             runtimeBundlePayloadRel,
                                             outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWriteOptionalRuntimeResources(opts,
                                                   files,
                                                   runtimeSemanticNodesRel,
                                                   runtimeTruthRootRel,
                                                   outError):
        return false
    if !MobileShellWriteLaunchArgsFiles(exportOutDir,
                                          opts.routeState,
                                          opts.runtimeMode,
                                          runtimeManifestRel,
                                          runtimeContractPayloadRel,
                                          runtimeBundlePayloadRel,
                                          files,
                                          launchArgsKvRel,
                                          launchArgsJsonRel,
                                          outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    let runtimeManifestPath: str = chengpath.PathJoin(exportOutDir, runtimeManifestRel)
    if !MobileShellWriteFile(runtimeManifestPath,
                               MobileShellRuntimeManifest(opts,
                                                            runtimeContractPayloadRel,
                                                            runtimeBundlePayloadRel,
                                                            runtimeSemanticNodesRel,
                                                            runtimeTruthRootRel,
                                                            launchArgsKvRel,
                                                            launchArgsJsonRel),
                               runtimeManifestRel,
                               files,
                               outError):
        return false
    if !MobileShellWritePlatformRuntimeMirrors(opts,
                                                 runtimeManifestPath,
                                                 runtimeContractPayloadRel,
                                                 runtimeBundlePayloadRel,
                                                 runtimeSemanticNodesRel,
                                                 runtimeTruthRootRel,
                                                 launchArgsKvRel,
                                                 launchArgsJsonRel,
                                                 files,
                                                 outError):
        return false
    opts.outDir = Fmt"{exportOutDir}"
    if !MobileShellWriteAndroid(opts, files, outError):
        return false
    outRuntimeManifestPath = runtimeManifestPath
    return true

fn MobileShellAndroidOnlyBuildProbe(rootDir: str,
                                      args: str[],
                                      outOutput: var str,
                                      outError: var str): int32 =
    outOutput = ""
    outError = ""
    var opts: MobileShellOptions
    # rootDir 会被 ResolveOptions 的 owned 形参消费，后续 RunProgramLogged 还要用——先克隆。
    let rootDirForLog: str = strings.CloneStr(rootDir)
    if !MobileShellAndroidOnlyResolveOptions(rootDir, args, opts, outError):
        return 1
    let buildOutDir: str = Fmt"{opts.outDir}"
    let buildAndroidNativeMode: str = MobileShellAndroidNativeModeText(opts.androidNativeMode)
    if buildAndroidNativeMode != "prebuilt":
        outError = "mobile-shell android: build-probe requires --android-native-mode prebuilt"
        return 1
    let androidPrebuiltConfig: MobileShellAndroidPrebuiltConfig = MobileShellAndroidPrebuiltConfigFromOptions(opts)
    var runtimeManifestPath: str
    if !MobileShellAndroidOnlyExportResolved(opts, runtimeManifestPath, outError):
        return 1
    let _runtimeManifestPath: str = runtimeManifestPath
    let summaryPath: str = chengpath.PathJoin(buildOutDir, "mobile_shell_build_probe.summary.env")
    let androidLog: str = chengpath.PathJoin(buildOutDir, "android_build.log")
    let androidPrebuiltScript: str = chengpath.PathJoin(buildOutDir, "android_prebuilt_build.sh")
    let androidApk: str = chengpath.PathJoin(buildOutDir, "android/app/build/outputs/apk/debug/app-debug.apk")
    let gradleCommand: str = MobileShellBuildCommand("gradle",
                                                       [
                                                           "-p",
                                                           chengpath.PathJoin(buildOutDir, "android"),
                                                           ":app:assembleDebug"
                                                       ])
    var nativeCommand: str
    if !MobileShellAndroidPrebuiltCommand(androidPrebuiltConfig,
                                           nativeCommand,
                                           outError):
        return 1
    var scriptError: str
    if !MobileShellWriteAndroidPrebuiltBuildScript(androidPrebuiltScript,
                                                    nativeCommand,
                                                    gradleCommand,
                                                    scriptError):
        outError = scriptError
        return 1
    var scriptArgs: str[]
    add(scriptArgs, androidPrebuiltScript)
    # 冷内联后 @borrows 形参的实参源追踪断链（lessons 253 同族）——调用点独立克隆。
    let run: os.ExecCmdResult = MobileShellRunProgramLogged("/bin/sh", scriptArgs, rootDirForLog, strings.CloneStr(androidLog))
    let androidExitCode: int32 = os.ExecCmdResultExitCode(run)
    if androidExitCode != 0:
        return MobileShellBuildProbeFail(summaryPath,
                                           Fmt"mobile-shell android: build failed rc={IntToStr(androidExitCode)} log={androidLog}",
                                           outError)
    if !os.FileExists(androidApk):
        return MobileShellBuildProbeFail(summaryPath,
                                           Fmt"mobile-shell android: artifact missing: {androidApk}",
                                           outError)
    if !MobileShellWriteBuildProbeSummary(summaryPath,
                                            true,
                                            false,
                                            false,
                                            opts.runtimeMode):
        outError = Fmt"mobile-shell android: failed to write summary: {summaryPath}"
        return 1
    outOutput = "mobile-shell build-probe ok\n"
    return 0

fn MobileShellAndroidOnlyRun(rootDir: str,
                               args: str[],
                               outOutput: var str,
                               outError: var str): int32 =
    outOutput = ""
    outError = ""
    if args.len <= 0:
        outOutput = MobileShellHelpText()
        return 0
    let subcmd: str = strutil.Strip(args[0])
    if subcmd == "help" || subcmd == "--help" || subcmd == "-h":
        outOutput = MobileShellHelpText()
        return 0
    var tail: str[]
    if args.len > 1:
        setLen(tail, args.len - 1)
        for i in 1..<args.len:
            tail[i - 1] = args[i]
    if subcmd == "build-probe":
        return MobileShellAndroidOnlyBuildProbe(rootDir, tail, outOutput, outError)
    outOutput = MobileShellHelpText()
    outError = Fmt"mobile-shell android: unknown subcommand: {subcmd}"
    return 2

@borrows
fn MobileShellIosInfoPlist(opts: MobileShellOptions): str =
    let dollar: str = strings.CharToStr('$')
    return Fmt"""
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>CFBundleDevelopmentRegion</key>
        <string>en</string>
        <key>CFBundleExecutable</key>
        <string>{dollar}(EXECUTABLE_NAME)</string>
        <key>CFBundleIdentifier</key>
        <string>{dollar}(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <key>CFBundleDisplayName</key>
        <string>{opts.appName}</string>
        <key>CFBundleName</key>
        <string>{dollar}(PRODUCT_NAME)</string>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>LSRequiresIPhoneOS</key>
        <true/>
        <key>UIApplicationSceneManifest</key>
        <dict/>
        <key>UILaunchStoryboardName</key>
        <string></string>
    </dict>
    </plist>

    """

