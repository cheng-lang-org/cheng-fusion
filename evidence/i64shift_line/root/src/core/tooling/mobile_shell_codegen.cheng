	    static jboolean native_apply_media_action(JNIEnv* env, jobject thiz, jlong handle, jstring slot_id, jstring action_kind, jstring payload) {{
      thiz = thiz;
      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)(uintptr_t)handle;
      if (runtime == NULL || runtime->app_id == 0u || s_app_media_control == NULL || slot_id == NULL || action_kind == NULL || payload == NULL) {{
        return JNI_FALSE;
      }}
      const char* slotRaw = (*env)->GetStringUTFChars(env, slot_id, NULL);
      if (slotRaw == NULL) {{
        return JNI_FALSE;
      }}
      const char* actionRaw = (*env)->GetStringUTFChars(env, action_kind, NULL);
      if (actionRaw == NULL) {{
        (*env)->ReleaseStringUTFChars(env, slot_id, slotRaw);
        return JNI_FALSE;
      }}
      const char* payloadRaw = (*env)->GetStringUTFChars(env, payload, NULL);
      if (payloadRaw == NULL) {{
        (*env)->ReleaseStringUTFChars(env, action_kind, actionRaw);
        (*env)->ReleaseStringUTFChars(env, slot_id, slotRaw);
        return JNI_FALSE;
      }}
      int before_receipts = s_app_debug_media_receipt_count != NULL ? s_app_debug_media_receipt_count() : -1;
      int ok = s_app_media_control(runtime->app_id, slotRaw, actionRaw, payloadRaw);
      int after_receipts = s_app_debug_media_receipt_count != NULL ? s_app_debug_media_receipt_count() : -1;
      int app_status = s_app_debug_last_main_status != NULL ? s_app_debug_last_main_status() : -9999;
      int receipt_index = (after_receipts > before_receipts && after_receipts > 0) ? after_receipts - 1 : -1;
      int receipt_action_code = (receipt_index >= 0 && s_app_debug_media_receipt_action_code_at != NULL) ? s_app_debug_media_receipt_action_code_at(receipt_index) : -1;
      int receipt_status = (receipt_index >= 0 && s_app_debug_media_receipt_status_at != NULL) ? s_app_debug_media_receipt_status_at(receipt_index) : -1;
      int receipt_state = (receipt_index >= 0 && s_app_debug_media_receipt_state_at != NULL) ? s_app_debug_media_receipt_state_at(receipt_index) : -1;
      int receipt_kind = (receipt_index >= 0 && s_app_debug_media_receipt_kind_at != NULL) ? s_app_debug_media_receipt_kind_at(receipt_index) : -1;
      int receipt_audio_provider_hash = (receipt_index >= 0 && s_app_debug_media_receipt_audio_provider_hash_at != NULL) ? s_app_debug_media_receipt_audio_provider_hash_at(receipt_index) : -1;
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "media_control slot=%s action=%s payload_len=%zu ok=%d receipts=%d,%d status=%d",
                          slotRaw, actionRaw, strlen(payloadRaw), ok, before_receipts, after_receipts, app_status);
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "media_control_receipt slot=%s action=%s receipt=%d action_code=%d status=%d state=%d kind=%d audio_provider_hash=%d host_frame=%d host_update=%d host_playback=%d host_presentation_us=%lld",
                          slotRaw, actionRaw, receipt_index, receipt_action_code, receipt_status, receipt_state, receipt_kind, receipt_audio_provider_hash,
                          s_media_playback_frame_count, s_media_playback_update_count, s_media_playback_last_state,
                          (long long)s_media_playback_last_presentation_us);
      // S6 (video-seek-scrub-blueprint.md S1.3/S6, task #14 CSG payload wiring): the CSG
      // layer above (s_app_media_control -> WebSceneApplyMediaControlWithPayload) only
      // tracks paint/receipt state and never reached the decoder-level whole-file seek
      // target -- cheng_host_video_seek (defined below, mirroring the Harmony host's
      // seek_epoch-gated entry) had zero callers. receipt_kind==1 is CHENG_MEDIA_KIND_VIDEO
      // (see handleHostAudioAction's CHENG_MEDIA_KIND_AUDIO check above for the audio-kind
      // sibling path, which already forwards its own payload via seekAudioPlaybackToStart).
      // strtol (not atoi) so a malformed payload is rejected instead of silently seeking to 0.
      if (ok != 0 && receipt_kind == 1 && strcmp(actionRaw, "Seek") == 0) {{
        char* seekEndPtr = NULL;
        long seekMsParsed = strtol(payloadRaw, &seekEndPtr, 10);
        if (payloadRaw[0] != '\0' && seekEndPtr != NULL && *seekEndPtr == '\0' &&
            seekMsParsed >= 0 && seekMsParsed <= 2147483647L) {{
          cheng_host_video_seek(1, (int32_t)seekMsParsed);
        }}
      }}
      (*env)->ReleaseStringUTFChars(env, payload, payloadRaw);
      (*env)->ReleaseStringUTFChars(env, action_kind, actionRaw);
      (*env)->ReleaseStringUTFChars(env, slot_id, slotRaw);
      return ok != 0 ? JNI_TRUE : JNI_FALSE;
    }}

