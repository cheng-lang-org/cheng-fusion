    static int cheng_android_media_trace_enabled(void) {{
      static int cached = -1;
      if (cached >= 0) {{
        return cached;
      }}
      char prop[PROP_VALUE_MAX];
      prop[0] = '\0';
      cached = (__system_property_get("debug.cheng.media.trace", prop) > 0 && prop[0] == '1') ? 1 : 0;
      return cached;
    }}

