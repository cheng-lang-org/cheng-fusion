@borrows
fn MobileShellHarmonyIndexEts(opts: MobileShellOptions): str =
    let libraryName: str = MobileShellHarmonyLibraryName(opts)
    let dot: str = strings.CharToStr('.')
    let importKw: str = "import"
    return Fmt"""
    {importKw} harmonyHost from 'lib{libraryName}.so'

    @Entry
    @Component
    struct Index {{
      private surfaceController: XComponentController = new XComponentController()

      aboutToAppear(): void {{
        const context = getContext(this)
        harmonyHost.setResourceManager(context.resourceManager)
      }}

      build() {{
        Column() {{
          XComponent({{
            id: 'chengSurface',
            type: XComponentType.SURFACE,
            libraryname: '{libraryName}',
            controller: this.surfaceController
          }})
            {dot}width('100%')
            {dot}height('100%')
        }}
        {dot}width('100%')
        {dot}height('100%')
        {dot}backgroundColor('#000000')
      }}
    }}

    """

fn MobileShellHarmonyEntryAbilityEts(): str =
    let importKw: str = "import"
    return Fmt"""
    {importKw} {{ UIAbility }} from '@kit.AbilityKit';
    {importKw} {{ window }} from '@kit.ArkUI';

    export default class EntryAbility extends UIAbility {{
      onWindowStageCreate(windowStage: window.WindowStage): void {{
        windowStage.loadContent('pages/Index', (err) => {{
          if (err && err.code) {{
            console.error('loadContent failed: ' + JSON.stringify(err))
          }}
        }})
      }}

      onWindowStageDestroy(): void {{
      }}

      onForeground(): void {{
      }}

      onBackground(): void {{
      }}
    }}

    """

fn MobileShellHarmonyMainPagesJson(): str =
    return "{\"src\":[\"pages/Index\"]}\n"

@borrows
fn MobileShellHarmonyLibraryName(opts: MobileShellOptions): str =
    let raw: str = strutil.Strip(opts.harmonyLibraryName)
    if len(raw) <= 0:
        return "cheng_generated_harmony_host"
    return raw

@borrows
fn MobileShellHarmonyHostFileName(opts: MobileShellOptions): str =
    return Fmt"{MobileShellHarmonyLibraryName(opts)}.cpp"

@borrows
fn MobileShellHarmonyCmake(opts: MobileShellOptions): str =
    let libraryName: str = MobileShellHarmonyLibraryName(opts)
    let hostFileName: str = MobileShellHarmonyHostFileName(opts)
    return Fmt"""
    cmake_minimum_required(VERSION 3.5.0)
    project({libraryName})

    add_library({libraryName} SHARED {hostFileName})
    target_link_libraries({libraryName} PUBLIC ace_napi.z ace_ndk.z hilog_ndk.z native_window rawfile.z EGL GLESv3 native_vsync)

    """

@borrows
fn MobileShellHarmonyGuiHostLibraryName(opts: MobileShellOptions): str =
    let raw: str = strutil.Strip(opts.harmonyGuiHostLibraryName)
    if len(raw) <= 0:
        return "cheng_gui_host"
    return raw

@borrows
fn MobileShellHarmonyGuiHostLinkFlags(opts: MobileShellOptions): str =
    let raw: str = strutil.Strip(opts.harmonyGuiHostLinkFlags)
    if len(raw) <= 0:
        return "-Wl,-Bsymbolic-functions -Wl,--export-dynamic"
    return raw

@borrows
fn MobileShellHarmonyGuiHostPrebuiltObjects(opts: MobileShellOptions): str[] =
    if opts.harmonyGuiHostPrebuiltObjects.len <= 0:
        return ["scene_app_oh.o", "ps.o", "cp_local.o", "hr.o"]
    return opts.harmonyGuiHostPrebuiltObjects

# Renders one CMake list() body — one quoted "${CHENG_PREBUILT_DIR}/<obj>" line per
# entry — used for the three prebuilt object sets (host/publisher/feed) so the
# object file names live only in MobileShellOptions, not as CMakeLists.txt literals.
fn MobileShellHarmonyPrebuiltObjectListLinesText(objects: str[]): str =
    var out: str = ""
    for i in 0..<objects.len:
        out = Fmt"{out}    \"${{CHENG_PREBUILT_DIR}}/{objects[i]}\"\n"
    return out

# Shared `set_source_files_properties(<objVar> PROPERTIES GENERATED FALSE
# EXTERNAL_OBJECT TRUE)` fragment — identical shape used by the main cheng_gui_host
# library and both isolated .so targets below; `indent` lets callers nest it inside
# an `if(EXISTS ...)` block without a second copy of the text.
fn MobileShellHarmonySourceFilePropsCmakeText(indent: str, objVar: str): str =
    return Fmt"""
    {indent}set_source_files_properties(${{{objVar}}} PROPERTIES
    {indent}    GENERATED FALSE
    {indent}    EXTERNAL_OBJECT TRUE
    {indent})
    """

# One reusable "isolated .so target" tail: source-file properties + add_library +
# set_target_properties + target_link_libraries. Called once for cheng_moq_harmony
# and once for cheng_feed_harmony (see MobileShellHarmonyGuiHostMoqCmakeText /
# MobileShellHarmonyGuiHostFeedCmakeText) — the only structural difference between
# the two call sites is the required-vs-optional prebuilt-object gate around it.
fn MobileShellHarmonyIsolatedSoTailCmakeText(indent: str,
                                               objVar: str,
                                               soName: str,
                                               objSubdir: str): str =
    let propsText: str = MobileShellHarmonySourceFilePropsCmakeText(indent, objVar)
    return Fmt"""
    {propsText}
    {indent}add_library({soName} SHARED
    {indent}    ${{{objVar}}}
    {indent}    "${{CHENG_PREBUILT_DIR}}/{objSubdir}/host_bridge.c"
    {indent}    "${{CHENG_PREBUILT_DIR}}/{objSubdir}/linux_intrinsics.S"
    {indent})
    {indent}set_target_properties({soName} PROPERTIES
    {indent}    OUTPUT_NAME "{soName}"
    {indent}    LINKER_LANGUAGE C
    {indent}    LINK_FLAGS "-Wl,-Bsymbolic"
    {indent})
    {indent}target_link_libraries({soName} PUBLIC dl m hilog_ndk.z)
    """

@borrows
fn MobileShellHarmonyGuiHostMainCmakeText(opts: MobileShellOptions): str =
    let libraryName: str = MobileShellHarmonyGuiHostLibraryName(opts)
    let linkFlags: str = MobileShellHarmonyGuiHostLinkFlags(opts)
    let prebuiltObjects: str[] = MobileShellHarmonyGuiHostPrebuiltObjects(opts)
    let prebuiltObjectLinesText: str = MobileShellHarmonyPrebuiltObjectListLinesText(prebuiltObjects)
    let prebuiltPropsText: str = MobileShellHarmonySourceFilePropsCmakeText("", "CHENG_PREBUILT_OBJECTS")
    return Fmt"""
    cmake_minimum_required(VERSION 3.10)
    project(cheng_gui_demo C CXX ASM)

    set(CMAKE_C_STANDARD 11)
    set(CMAKE_C_STANDARD_REQUIRED ON)
    set(CMAKE_CXX_STANDARD 17)
    set(CMAKE_CXX_STANDARD_REQUIRED ON)

    set(CHENG_PREBUILT_DIR "${{CMAKE_CURRENT_SOURCE_DIR}}/prebuilt")

    # Prebuilt Cheng objects: the OHOS-compiled GUI scene runtime (scene_app_oh.o
    # exports cheng_app_* and references cheng_mobile_host_* callbacks) plus the OHOS
    # runtime providers (ps/cp_local/hr) and the C runtime bridge + intrinsics.
    set(CHENG_PREBUILT_OBJECTS
    {prebuiltObjectLinesText})
    {prebuiltPropsText}

    # Single shared library: the GLES compositor host (C) + the OHOS NAPI/XComponent
    # entry (C++) + the scene app + providers + bridge. The XComponent libraryname and
    # the NAPI modname are both "{libraryName}".
    # cheng_gui_host.c was mechanically physically split (slice-8b, zero behavior change)
    # into cheng_gui_host_gen.c (generator-absorbed GLES/present/route/media-registry code)
    # and cheng_gui_host_adapter.c (hand-written OHOS driver adapter code), sharing
    # declarations via cheng_gui_host_shared.h.
    add_library({libraryName} SHARED
        cheng_gui_host_gen.c
        cheng_gui_host_adapter.c
        cheng_gui_entry.cpp
        "${{CHENG_PREBUILT_DIR}}/host_bridge.c"
        "${{CHENG_PREBUILT_DIR}}/linux_intrinsics.S"
        ${{CHENG_PREBUILT_OBJECTS}}
    )

    set_target_properties({libraryName} PROPERTIES
        OUTPUT_NAME "{libraryName}"
        # Export host symbols dynamically so the in-process scene app resolves the
        # cheng_mobile_host_* callbacks; -Bsymbolic-functions binds intra-lib refs.
        LINK_FLAGS "{linkFlags}"
    )

    # Leak-audit diagnostic build: cmake -DCHENG_LEAK_AUDIT=ON (or hvigor arg) compiles the
    # #ifdef CHENG_LEAK_AUDIT counters in gen.c/adapter.c; OFF (default) is zero-cost.
    if(DEFINED CHENG_LEAK_AUDIT AND CHENG_LEAK_AUDIT)
        target_compile_definitions({libraryName} PRIVATE CHENG_LEAK_AUDIT=1)
        # Route every cross-object cheng_malloc/cheng_free call through the audit wrappers
        # (the weak in-file definitions are shadowed by the strong ps.o ones — see gen.c).
        target_link_options({libraryName} PRIVATE -Wl,--wrap=cheng_malloc -Wl,--wrap=cheng_free)
    endif()
    target_include_directories({libraryName} PRIVATE
        ${{CMAKE_CURRENT_SOURCE_DIR}}
    )

    target_link_libraries({libraryName} PUBLIC
        EGL
        GLESv3
        ace_napi.z
        ace_ndk.z
        hilog_ndk.z
        native_window
        native_image
        native_vsync
        rawfile.z
        native_media_core
        native_media_codecbase
        native_media_avsource
        native_media_avdemuxer
        native_media_vdec
        native_media_acodec
        ohaudio
        avplayer
        pasteboard
        udmf
        dl
        m
    )
    """

fn MobileShellHarmonyGuiHostMoqCmakeText(guiHostLibraryName: str): str =
    let soName: str = "cheng_moq_harmony"
    let tailText: str = MobileShellHarmonyIsolatedSoTailCmakeText("    ", "CHENG_PUBLISHER_OBJECTS", soName, "publisher")
    return Fmt"""
    # In-app MoQ publisher library (生产 computer-use 发布路径). Built as a SEPARATE .so
    # with its own provider objs (prebuilt/publisher/) and dlopen'd by cheng_host_publish at
    # runtime — so its bigint/crypto/libp2p/QUIC symbols do NOT collide with scene_app_oh.o's
    # (those two full obj sets share ~1371 defined symbols; one .so each keeps them isolated).
    set(CHENG_PUBLISHER_OBJECTS
        "${{CHENG_PREBUILT_DIR}}/publisher/moq_core.o"
        "${{CHENG_PREBUILT_DIR}}/publisher/ps.o"
        "${{CHENG_PREBUILT_DIR}}/publisher/cp_local.o"
        "${{CHENG_PREBUILT_DIR}}/publisher/hr.o"
    )
    if(EXISTS "${{CHENG_PREBUILT_DIR}}/publisher/moq_core.o")
        set(CHENG_NM_TOOL "${{CMAKE_NM}}")
        if(NOT CHENG_NM_TOOL)
            find_program(CHENG_NM_TOOL NAMES llvm-nm nm)
        endif()
        if(NOT CHENG_NM_TOOL)
            message(FATAL_ERROR "{soName}: nm tool not found; cannot verify publisher ABI")
        endif()
        execute_process(
            COMMAND "${{CHENG_NM_TOOL}}" -g "${{CHENG_PREBUILT_DIR}}/publisher/moq_core.o"
            OUTPUT_VARIABLE CHENG_PUBLISHER_NM
            ERROR_VARIABLE CHENG_PUBLISHER_NM_ERR
            RESULT_VARIABLE CHENG_PUBLISHER_NM_RC
        )
        if(NOT CHENG_PUBLISHER_NM_RC EQUAL 0)
            message(FATAL_ERROR "{soName}: nm failed for publisher/moq_core.o: ${{CHENG_PUBLISHER_NM_ERR}}")
        endif()
        string(FIND "${{CHENG_PUBLISHER_NM}}" "cheng_moq_harmony_publish_serve_file" CHENG_PUBLISHER_SERVE_FILE_SYMBOL)
        if(CHENG_PUBLISHER_SERVE_FILE_SYMBOL EQUAL -1)
            message(FATAL_ERROR "{soName}: publisher/moq_core.o lacks cheng_moq_harmony_publish_serve_file; run platform/harmony/ChengGuiDemo/rebuild_publisher_prebuilt.sh before packaging")
        endif()
        # cheng_host_publish dlsym's the parameterized _ex entry (poster path + optional
        # ES pair are caller-supplied since the poster is no longer hardcoded to the
        # bundled maitian asset) and the publish path persists its real CID receipt via
        # cheng_publish_cid_pipeline_run (publish_cid_pipeline.cheng, imported by
        # media_moq_publisher_main.cheng) — both symbols must be in the prebuilt or the
        # runtime dlsym fails; a stale prebuilt must fail packaging here, not on device.
        string(FIND "${{CHENG_PUBLISHER_NM}}" "cheng_moq_harmony_publish_serve_file_ex" CHENG_PUBLISHER_SERVE_FILE_EX_SYMBOL)
        if(CHENG_PUBLISHER_SERVE_FILE_EX_SYMBOL EQUAL -1)
            message(FATAL_ERROR "{soName}: publisher/moq_core.o lacks cheng_moq_harmony_publish_serve_file_ex; run platform/harmony/ChengGuiDemo/rebuild_publisher_prebuilt.sh before packaging")
        endif()
        string(FIND "${{CHENG_PUBLISHER_NM}}" "cheng_publish_cid_pipeline_run" CHENG_PUBLISHER_CID_PIPELINE_SYMBOL)
        if(CHENG_PUBLISHER_CID_PIPELINE_SYMBOL EQUAL -1)
            message(FATAL_ERROR "{soName}: publisher/moq_core.o lacks cheng_publish_cid_pipeline_run; run platform/harmony/ChengGuiDemo/rebuild_publisher_prebuilt.sh before packaging")
        endif()
    {tailText}
        # Build the publisher .so alongside the host so it is packaged into the HAP libs/.
        add_dependencies({guiHostLibraryName} {soName})
    else()
        message(STATUS "{soName}: prebuilt publisher objects absent; publisher bridge dlopen-fails to honest unavailable (build moq_core.o via backend driver)")
    endif()
    """

fn MobileShellHarmonyGuiHostFeedCmakeText(guiHostLibraryName: str): str =
    let soName: str = "cheng_feed_harmony"
    let tailText: str = MobileShellHarmonyIsolatedSoTailCmakeText("    ", "CHENG_FEED_OBJECTS", soName, "feed")
    return Fmt"""
    # In-app distributed-feed library (生产 feed 发现路径, S2). Same SEPARATE-.so discipline
    # as the MoQ publisher: the pure-Cheng NodeRuntime (unimaker_compat_ffi) drags the full
    # libp2p/QUIC/crypto/gossipsub closure (~1371 symbols shared with scene_app_oh.o), so it is
    # isolated in lib{soName}.so and dlopen'd by cheng_host_node_contents_refresh /
    # cheng_host_nodes_snapshot_refresh at runtime (exports NimMain/libp2p_node_init_slim/
    # libp2p_node_start/libp2p_feed_node_contents/libp2p_network_discovery_snapshot; 5th root
    # is optional for host — lazy dlsym, old 4-root .so keeps node_contents_refresh alive).
    # Built only when the prebuilt feed objects are present — producing feed_core.o requires the
    # full backend driver, which currently does not materialize the feed closure in bounded time
    # (see docs/cheng-video-e2e-miaofa-miaokai-plan.md S2 build wall). Absent the objects the host
    # bridge degrades to an honest feed_runtime_unavailable error (no fake, no crash).
    set(CHENG_FEED_OBJECTS
        "${{CHENG_PREBUILT_DIR}}/feed/feed_core.o"
        "${{CHENG_PREBUILT_DIR}}/feed/ps.o"
        "${{CHENG_PREBUILT_DIR}}/feed/cp_local.o"
        "${{CHENG_PREBUILT_DIR}}/feed/hr.o"
    )
    if(EXISTS "${{CHENG_PREBUILT_DIR}}/feed/feed_core.o")
    {tailText}
        add_dependencies({guiHostLibraryName} {soName})
    else()
        message(STATUS "{soName}: prebuilt feed objects absent; feed bridge dlopen-fails to honest unavailable (build feed_core.o via backend driver — see docs S2 build wall)")
    endif()
    """

# Full platform/harmony/ChengGuiDemo/entry/src/main/cpp/CMakeLists.txt topology:
# the cheng_gui_host main library (prebuilt scene objects + link flags from opts,
# per M1 slice-6 ask ①/③) plus the two isolated dlopen .so targets built from the
# one reusable tail fragment (ask ②). With default opts this is byte-identical to
# the current hand-written file (see mobile_shell_codegen_smoke.cheng).
@borrows
fn MobileShellHarmonyGuiHostCmakeText(opts: MobileShellOptions): str =
    let libraryName: str = MobileShellHarmonyGuiHostLibraryName(opts)
    let mainText: str = MobileShellHarmonyGuiHostMainCmakeText(opts)
    let moqText: str = MobileShellHarmonyGuiHostMoqCmakeText(libraryName)
    let feedText: str = MobileShellHarmonyGuiHostFeedCmakeText(libraryName)
    return Fmt"{mainText}\n\n{moqText}\n\n{feedText}\n"

fn MobileShellNativeGlesCoreSource(): str =
    return Fmt"""
    #define CHENG_ANDROID_WINDOW_SLOT_CAP 16
    #define CHENG_ANDROID_INPUT_RING_CAPACITY (1024u * 1024u)
    #define CHENG_ANDROID_INPUT_TOUCH_V1 1u
    #define CHENG_ANDROID_INPUT_TOUCH_V1_BYTES 20u
    #define CHENG_ANDROID_TOUCH_SCROLL_SLOP_MILLI 8000
    #define CHENG_ANDROID_GPU_COMMAND_STRIDE_I32 17
    #define CHENG_ANDROID_MEDIA_SURFACE_HOST_STRIDE_I32 16
    #define CHENG_ANDROID_MEDIA_SURFACE_COMMAND_CAP 64
    #define CHENG_ANDROID_MEDIA_TEXTURE_CACHE_CAP 64
    #define CHENG_ANDROID_COMPOSITOR_LAYER_STRIDE_I32 17
    #define CHENG_ANDROID_LAYER_CACHE_CAP 64
    #define CHENG_ANDROID_IMAGE_ATLAS_CACHE_CAP 64
    #define CHENG_ANDROID_IMAGE_ATLAS_HOST_STRIDE_I32 5
    #define CHENG_ANDROID_SVG_DISPLAY_LIST_ENTRY_HOST_STRIDE_I32 3
    #define CHENG_ANDROID_SVG_PRIMITIVE_HOST_STRIDE_I32 9
    #define CHENG_ANDROID_PAINT_ICON_KIND_SVG 1000
    #define CHENG_ANDROID_SVG_PRIMITIVE_LINE 1
    #define CHENG_ANDROID_SVG_PRIMITIVE_CIRCLE 2
    #define CHENG_ANDROID_SVG_PRIMITIVE_ELLIPSE 3
    #define CHENG_ANDROID_SVG_PRIMITIVE_RECT 4
    #define CHENG_ANDROID_SVG_PRIMITIVE_TRIANGLE 5
    #define CHENG_ANDROID_SVG_COORD_UNIT 2400.0f
    #define CHENG_ANDROID_SVG_STROKE_UNIT 200.0f
    #define CHENG_ANDROID_GLYPH_SDF_ATLAS_CACHE_CAP 64
    #define CHENG_ANDROID_GLYPH_SDF_BASE_PX_RANGE 8
    #define CHENG_ANDROID_GLYPH_SDF_ATLAS_HOST_STRIDE_I32 8
    #define CHENG_ANDROID_GLYPH_SDF_GLYPH_HOST_STRIDE_I32 12
    #define CHENG_ANDROID_GLYPH_SDF_RUN_HOST_STRIDE_I32 6
    #define CHENG_ANDROID_GLYPH_SDF_RUN_GLYPH_HOST_STRIDE_I32 2
    #define CHENG_ANDROID_GPU_FILL_RECT 1
    #define CHENG_ANDROID_GPU_STROKE_RECT 2
    #define CHENG_ANDROID_GPU_FILL_TEXT 3
    #define CHENG_ANDROID_GPU_DRAW_IMAGE 4
    #define CHENG_ANDROID_GPU_DRAW_ICON 5
    #define CHENG_ANDROID_GPU_SET_CLIP 6
    #define CHENG_ANDROID_GPU_BOX_SHADOW 7
    #define CHENG_ANDROID_GPU_GRADIENT_FILL 8
    #define CHENG_ANDROID_GPU_SVG_CIRCLE_PATTERN 9
    #define CHENG_ANDROID_GPU_DRAW_MEDIA_SURFACE 10
    #define CHENG_ANDROID_MEDIA_SURFACE_VIDEO_FIRST_FRAME_TEXTURE 1
    #define CHENG_ANDROID_MEDIA_SURFACE_IMAGE_RASTER_TEXTURE 2
    #define CHENG_ANDROID_MEDIA_SURFACE_AUDIO_COVER_TEXTURE 3
    #define CHENG_ANDROID_MEDIA_OBJECT_FIT_COVER 1
    #define CHENG_ANDROID_MEDIA_OBJECT_FIT_CONTAIN 2
    #define CHENG_ANDROID_MEDIA_OBJECT_FIT_FILL 3
    #define CHENG_ANDROID_MEDIA_TEXTURE_PROVIDER_METAL_SURFACE 1
    #define CHENG_ANDROID_MEDIA_TEXTURE_PROVIDER_SURFACE 2
    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_NONE 0
    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_PROVIDER_UNAVAILABLE 1
    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_INVALID_BATCH 2
    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_READY 3
    #define CHENG_ANDROID_MEDIA_SURFACE_STATUS_PREPARE_FAILED 4
    #define CHENG_ANDROID_MEDIA_PLAYBACK_CLOSED 0
    #define CHENG_ANDROID_MEDIA_PLAYBACK_OPENED 1
    #define CHENG_ANDROID_MEDIA_PLAYBACK_PLAYING 2
    #define CHENG_ANDROID_MEDIA_PLAYBACK_PAUSED 3
    #define CHENG_ANDROID_MEDIA_PLAYBACK_SEEKED 4
    #define CHENG_ANDROID_MEDIA_TEXTURE_TARGET_EXTERNAL_OES 36197
    #ifndef GL_TEXTURE_EXTERNAL_OES
    #define GL_TEXTURE_EXTERNAL_OES 0x8D65
    #endif
    #define CHENG_ANDROID_LAYER_TRANSITION_REUSE 1
    #define CHENG_ANDROID_LAYER_TRANSITION_REPLACE 2
    #define CHENG_ANDROID_LAYER_TRANSITION_DROP 3
    #ifndef EGL_OPENGL_ES3_BIT
    #define EGL_OPENGL_ES3_BIT 0x00000040
    #endif

    typedef uint64_t (*cheng_app_init_fn)(void);
    typedef void (*cheng_app_set_window_fn)(uint64_t, uint64_t, int, int, float);
    typedef void (*cheng_app_tick_fn)(uint64_t, float);
    typedef int32_t (*cheng_app_needs_frame_fn)(uint64_t);
    typedef void (*cheng_app_on_touch_milli_fn)(uint64_t, int, int, int, int);
    typedef int32_t (*cheng_app_on_back_fn)(uint64_t);
    typedef int32_t (*cheng_app_scroll_by_fn)(uint64_t, int32_t, int32_t);
    typedef int32_t (*cheng_app_ink_overlay_count_fn)(uint64_t);
    typedef int32_t (*cheng_app_ink_overlay_word_fn)(uint64_t, int32_t);
    typedef int32_t (*cheng_app_scroll_get_fn)(uint64_t, int32_t);
    typedef void (*cheng_app_pause_fn)(uint64_t);
    typedef void (*cheng_app_resume_fn)(uint64_t);
    typedef int32_t (*cheng_app_text_input_utf8_fn)(const char*);
    typedef int32_t (*cheng_app_text_input_cursor_utf8_fn)(const char*, int32_t);
    typedef int32_t (*cheng_app_media_control_fn)(uint64_t, const char*, const char*, const char*);
    typedef int32_t (*cheng_app_debug_i32_fn)(void);
    typedef int32_t (*cheng_app_debug_i32_at_fn)(int32_t);

    typedef void (*cheng_mobile_host_runtime_set_manifest_payloads_fn)(const char*, const char*, const char*);
    typedef void (*cheng_mobile_host_runtime_set_launch_args_fn)(const char*, const char*);
    typedef int32_t (*cheng_mobile_host_runtime_set_state_fn)(const char*, const char*);

    /* wave9 phase B: typedefs for the 59 optional App exports lit up in
       Harmony cheng_resolve_exports below (dossier: wf_568671a5-ebd).
       Signatures copied verbatim from MobileShellAndroidHostSource above.
       cheng_app_text_input_cursor_utf8_fn already declared above (line
       21211) -- Android parity leftover, reused here rather than
       redeclared. */
