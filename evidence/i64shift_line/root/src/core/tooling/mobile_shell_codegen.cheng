        outDir: str
        libName: str
        appLibPath: str
        hostCc: str
        hostLd: str
        ndkRoot: str
        javaHome: str
        clangRtDir: str
        apiLevel: str

fn MobileShellHexDigit(n: int32): str =
    if n == 0: return "0"
    if n == 1: return "1"
    if n == 2: return "2"
    if n == 3: return "3"
    if n == 4: return "4"
    if n == 5: return "5"
    if n == 6: return "6"
    if n == 7: return "7"
    if n == 8: return "8"
    if n == 9: return "9"
    if n == 10: return "A"
    if n == 11: return "B"
    if n == 12: return "C"
    if n == 13: return "D"
    if n == 14: return "E"
    return "F"

@borrows
fn MobileShellJsonQuote(text: str): str =
    var out: str = "\""
    var i: int32
    for i in i..<len(text):
        let ch: char = text[i]
        let code: int32 = int32(ch)
        if code == 34:
            out = Fmt"{out}\\\""
        elif code == 92:
            out = Fmt"{out}\\\\"
        elif code == 8:
            out = Fmt"{out}\\b"
        elif code == 9:
            out = Fmt"{out}\\t"
        elif code == 10:
            out = Fmt"{out}\\n"
        elif code == 12:
            out = Fmt"{out}\\f"
        elif code == 13:
            out = Fmt"{out}\\r"
        elif code >= 0 && code < 32:
            let hi: int32 = code / 16
            let lo: int32 = code % 16
            out = Fmt"{out}\\u00{MobileShellHexDigit(hi)}{MobileShellHexDigit(lo)}"
        else:
            let piece: str = strings.CharToStr(ch)
            out = Fmt"{out}{piece}"
    return Fmt"{out}\""

@borrows
fn MobileShellQuote(text: str): str =
    return MobileShellJsonQuote(text)

fn MobileShellJsonStringArrayText(items: var str[]): str =
    var out: str = "["
    for i in 0..<items.len:
        if i > 0:
            out = Fmt"{out},"
        out = Fmt"{out}{MobileShellJsonQuote(items[i])}"
    return Fmt"{out}]"

