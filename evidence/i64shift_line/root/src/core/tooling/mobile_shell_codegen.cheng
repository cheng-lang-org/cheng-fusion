        int touch_deep_trace_enabled = touch_trace_enabled && cheng_android_touch_deep_trace_enabled();
        int need_route_before = touch_trace_enabled || (pointer_id == 0 && action == 0);
        int route_before = need_route_before && s_app_debug_route_index != NULL ? s_app_debug_route_index() : s_touch_route_index;
        int route_probe_node = touch_deep_trace_enabled && s_app_debug_route_hit_probe != NULL ? s_app_debug_route_hit_probe(app_x_milli, app_y_milli) : -9999;
        int box_probe_node = touch_deep_trace_enabled && s_app_debug_box_probe != NULL ? s_app_debug_box_probe(app_x_milli, app_y_milli, 0) : -9999;
        int box_probe_x = touch_deep_trace_enabled && s_app_debug_box_probe != NULL ? s_app_debug_box_probe(app_x_milli, app_y_milli, 1) : -9999;
        int box_probe_y = touch_deep_trace_enabled && s_app_debug_box_probe != NULL ? s_app_debug_box_probe(app_x_milli, app_y_milli, 2) : -9999;
        int box_probe_w = touch_deep_trace_enabled && s_app_debug_box_probe != NULL ? s_app_debug_box_probe(app_x_milli, app_y_milli, 3) : -9999;
        int box_probe_h = touch_deep_trace_enabled && s_app_debug_box_probe != NULL ? s_app_debug_box_probe(app_x_milli, app_y_milli, 4) : -9999;
        int publish_notice_button_x = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7573, 0) : -9999;
        int publish_notice_button_y = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7573, 1) : -9999;
        int publish_notice_button_w = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7573, 2) : -9999;
        int publish_notice_button_h = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7573, 3) : -9999;
        int publish_notice_thumb_x = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7574, 0) : -9999;
        int publish_notice_thumb_y = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7574, 1) : -9999;
        int publish_notice_thumb_w = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7574, 2) : -9999;
        int publish_notice_thumb_h = touch_deep_trace_enabled && s_app_debug_node_box != NULL ? s_app_debug_node_box(7574, 3) : -9999;
        // Touch-drag -> content-layer scroll. Only the primary pointer drives scroll.
        // Coordinates are in milli (1000 = 1px); scroll_by takes px deltas.
        int scroll_applied = -9999;
        int scroll_delta_px = 0;
        int dispatch_touch = 1;
        if (pointer_id == 0) {{
          if (action == 0) {{
            s_touch_active = 1;
            s_touch_scrolling = 0;
            s_touch_down_app_x_milli = app_x_milli;
            s_touch_down_app_y_milli = app_y_milli;
            s_touch_last_app_y_milli = app_y_milli;
            s_touch_route_index = route_before;
          }} else if (action == 2 && s_touch_active) {{
