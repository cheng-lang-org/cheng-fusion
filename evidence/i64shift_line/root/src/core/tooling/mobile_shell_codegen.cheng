    void cheng_seq_set_len(void* seq_ptr, int32_t new_len, int32_t elem_size) {{
      if (seq_ptr == NULL || elem_size <= 0) {{
        return;
      }}
      ChengHostSeqHeader* seq = (ChengHostSeqHeader*)seq_ptr;
      int32_t target = new_len;
      if (target < 0) {{
        target = 0;
      }}
      if (target > seq->cap || (target > 0 && seq->buffer == NULL)) {{
        int32_t new_cap = seq->cap;
        if (new_cap < 4) {{
          new_cap = 4;
        }}
        while (new_cap < target) {{
          int32_t doubled = new_cap * 2;
          if (doubled <= new_cap) {{
            new_cap = target;
            break;
          }}
          new_cap = doubled;
        }}
        int64_t bytes64 = (int64_t)new_cap * (int64_t)elem_size;
        if (bytes64 <= 0 || bytes64 >= 67108864LL) {{
          abort();
        }}
        int32_t old_cap = seq->cap;
        void* new_buffer = realloc(seq->buffer, (size_t)bytes64);
        if (new_buffer == NULL) {{
          abort();
        }}
        if (new_cap > old_cap) {{
          memset((uint8_t*)new_buffer + ((size_t)old_cap * (size_t)elem_size),
                 0,
                 (size_t)(new_cap - old_cap) * (size_t)elem_size);
        }}
        seq->buffer = new_buffer;
        seq->cap = new_cap;
      }}
      if (target > seq->len) {{
        memset((uint8_t*)seq->buffer + ((size_t)seq->len * (size_t)elem_size),
               0,
               (size_t)(target - seq->len) * (size_t)elem_size);
      }}
      seq->len = target;
    }}

    int32_t cheng_seq_drop_str_field_tail(void* seq_ptr,
                                          int32_t new_len,
                                          int32_t elem_size,
                                          int32_t field_offset) {{
      if (seq_ptr == NULL || elem_size <= 0 || field_offset < 0 ||
          field_offset > elem_size - (int32_t)sizeof(ChengHostStr)) {{
        abort();
      }}
      ChengHostSeqHeader* seq = (ChengHostSeqHeader*)seq_ptr;
      if (seq->len < 0 || seq->cap < seq->len) {{
        abort();
      }}
      int32_t target = new_len < 0 ? 0 : new_len;
      if (target >= seq->len) {{
        return 0;
      }}
      if (seq->buffer == NULL) {{
        abort();
      }}
      for (int32_t i = target; i < seq->len; i += 1) {{
        int64_t row_offset = (int64_t)i * (int64_t)elem_size + (int64_t)field_offset;
        if (row_offset < 0 || row_offset > INT32_MAX) {{
          abort();
        }}
        ChengHostStr* slot = (ChengHostStr*)((uint8_t*)seq->buffer + row_offset);
        if (slot->flags == 1 && slot->data != NULL) {{
          cheng_mem_release(slot->data);
        }}
        slot->data = NULL;
        slot->len = 0;
        slot->store_id = 0;
        slot->flags = 0;
      }}
      return 0;
    }}

    void cheng_seq_str_add(void* seq_ptr, void* value_ptr) {{
      if (seq_ptr == NULL || value_ptr == NULL) {{
        return;
      }}
      ChengHostSeqHeader* seq = (ChengHostSeqHeader*)seq_ptr;
      void* slot = cheng_seq_set_grow(seq_ptr, seq->len, (int32_t)sizeof(ChengHostStr));
      *(ChengHostStr*)slot = *(ChengHostStr*)value_ptr;
    }}

    ChengHostStr driver_c_str_from_utf8_copy_bridge(const char* raw, int32_t n) {{
      ChengHostStr out;
      if (n < 0) {{
        n = 0;
      }}
      char* buf = (char*)cheng_malloc(n + 1);
      if (buf == NULL) {{
        abort();
      }}
      if (raw != NULL && n > 0) {{
        memcpy(buf, raw, (size_t)n);
      }}
      buf[n] = '\0';
      out.data = buf;
      out.len = n;
      out.store_id = 0;
      out.flags = 1;
      return out;
    }}

    ChengHostStr driver_c_str_slice_bridge(ChengHostStr s, int32_t start, int32_t count) {{
      /* 语义镜像 program_support_backend.cheng cheng_str_slice_copy:
         start<0 归 0; start>=len 或 count<=0 得空串; count 夹到 len-start。 */
      int32_t len = s.len;
      const char* base = (const char*)s.data;
      int32_t begin = start < 0 ? 0 : start;
      if (base == NULL || len <= 0 || begin >= len || count <= 0) {{
        return driver_c_str_from_utf8_copy_bridge(NULL, 0);
      }}
      int32_t n = count;
      if (begin + n > len) {{
        n = len - begin;
      }}
      return driver_c_str_from_utf8_copy_bridge(base + begin, n);
    }}

    ChengHostStr driver_c_str_concat_bridge(ChengHostStr a, ChengHostStr b) {{
      /* 语义镜像 program_support_backend.cheng driver_c_str_concat_bridge_export:
         len>0 而 data==NULL 视为无效串, 溢出/分配失败显式 abort (host 无 panic 通道)。 */
      int32_t len_a = a.len < 0 ? 0 : a.len;
      int32_t len_b = b.len < 0 ? 0 : b.len;
      if ((len_a > 0 && a.data == NULL) || (len_b > 0 && b.data == NULL)) {{
        __android_log_print(ANDROID_LOG_FATAL, "cheng-host", "driver_c_str_concat_bridge: invalid input string");
        abort();
      }}
      int64_t total = (int64_t)len_a + (int64_t)len_b;
      if (total >= 2147483647LL) {{
        __android_log_print(ANDROID_LOG_FATAL, "cheng-host", "driver_c_str_concat_bridge: length overflow");
        abort();
      }}
      char* buf = (char*)cheng_malloc((size_t)total + 1);
      if (buf == NULL) {{
        __android_log_print(ANDROID_LOG_FATAL, "cheng-host", "driver_c_str_concat_bridge: alloc failed");
        abort();
      }}
      if (len_a > 0) {{
        memcpy(buf, a.data, (size_t)len_a);
      }}
      if (len_b > 0) {{
        memcpy(buf + len_a, b.data, (size_t)len_b);
      }}
      buf[total] = '\0';
      ChengHostStr out;
      out.data = buf;
      out.len = (int32_t)total;
      out.store_id = 0;
      out.flags = 1;
      return out;
    }}

