    static void cheng_set_launch_args(JNIEnv* env, jstring launch_args_kv, jstring launch_args_json) {{
      if (env == NULL || s_app_handle == NULL) {{
        return;
      }}
      cheng_mobile_host_runtime_set_launch_args_fn setLaunchArgs = (cheng_mobile_host_runtime_set_launch_args_fn)dlsym(s_app_handle, "cheng_mobile_host_runtime_set_launch_args");
      if (setLaunchArgs == NULL) {{
        return;
      }}
      const char* kv = NULL;
      const char* json = NULL;
      if (launch_args_kv != NULL) {{
        kv = (*env)->GetStringUTFChars(env, launch_args_kv, NULL);
      }}
      if (launch_args_json != NULL) {{
        json = (*env)->GetStringUTFChars(env, launch_args_json, NULL);
      }}
      setLaunchArgs(kv, json);
      if (launch_args_kv != NULL && kv != NULL) {{
        (*env)->ReleaseStringUTFChars(env, launch_args_kv, kv);
      }}
      if (launch_args_json != NULL && json != NULL) {{
        (*env)->ReleaseStringUTFChars(env, launch_args_json, json);
      }}
    }}

    static void cheng_set_runtime_payloads(JNIEnv* env, jstring runtime_manifest_json, jstring runtime_contract_payload_json, jstring runtime_bundle_payload_json) {{
      if (env == NULL || s_app_handle == NULL) {{
        return;
      }}
      cheng_mobile_host_runtime_set_manifest_payloads_fn setRuntimePayloads = (cheng_mobile_host_runtime_set_manifest_payloads_fn)dlsym(s_app_handle, "cheng_mobile_host_runtime_set_manifest_payloads");
      if (setRuntimePayloads == NULL) {{
        return;
      }}
      const char* manifest = NULL;
      const char* contractPayload = NULL;
      const char* bundlePayload = NULL;
      if (runtime_manifest_json != NULL) {{
        manifest = (*env)->GetStringUTFChars(env, runtime_manifest_json, NULL);
      }}
      if (runtime_contract_payload_json != NULL) {{
        contractPayload = (*env)->GetStringUTFChars(env, runtime_contract_payload_json, NULL);
      }}
      if (runtime_bundle_payload_json != NULL) {{
        bundlePayload = (*env)->GetStringUTFChars(env, runtime_bundle_payload_json, NULL);
      }}
      setRuntimePayloads(manifest, contractPayload, bundlePayload);
      if (runtime_manifest_json != NULL && manifest != NULL) {{
        (*env)->ReleaseStringUTFChars(env, runtime_manifest_json, manifest);
      }}
      if (runtime_contract_payload_json != NULL && contractPayload != NULL) {{
        (*env)->ReleaseStringUTFChars(env, runtime_contract_payload_json, contractPayload);
      }}
      if (runtime_bundle_payload_json != NULL && bundlePayload != NULL) {{
        (*env)->ReleaseStringUTFChars(env, runtime_bundle_payload_json, bundlePayload);
      }}
    }}

    static ChengAndroidShellRuntime* cheng_runtime_new(JNIEnv* env, jobject surface, jint width, jint height, jfloat density) {{
      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)calloc(1u, sizeof(ChengAndroidShellRuntime));
      if (runtime == NULL) {{
        return NULL;
      }}
      runtime->window = ANativeWindow_fromSurface(env, surface);
      if (runtime->window == NULL) {{
        free(runtime);
        return NULL;
      }}
      runtime->window_id = cheng_android_register_window(runtime->window);
      if (runtime->window_id == 0u) {{
        ANativeWindow_release(runtime->window);
        free(runtime);
        return NULL;
      }}
      runtime->width = cheng_android_surface_dimension((int)width, ANativeWindow_getWidth(runtime->window));
      runtime->height = cheng_android_surface_dimension((int)height, ANativeWindow_getHeight(runtime->window));
      runtime->density = density;
      s_touch_width = width > 0 ? (int)width : runtime->width;
      s_touch_height = height > 0 ? (int)height : runtime->height;
      s_active_window = runtime->window;
      s_active_width = runtime->width;
      s_active_height = runtime->height;
      s_active_density = runtime->density;
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "native_create begin window_id=%llu surface=%dx%d density=%.3f",
                          (unsigned long long)runtime->window_id, runtime->width, runtime->height, runtime->density);
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "native_create app_init_begin");
      runtime->app_id = s_app_init();
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "native_create app_init_return app_id=%llu",
                          (unsigned long long)runtime->app_id);
      int app_status = s_app_debug_last_main_status != NULL ? s_app_debug_last_main_status() : -9999;
      int app_build_step = s_app_debug_build_step != NULL ? s_app_debug_build_step() : -1;
      int layout_fail_code = s_app_debug_layout_fail_code != NULL ? s_app_debug_layout_fail_code() : -9999;
      int layout_fail_route = s_app_debug_layout_fail_route_index != NULL ? s_app_debug_layout_fail_route_index() : -9999;
      int layout_fail_node = s_app_debug_layout_fail_node_id != NULL ? s_app_debug_layout_fail_node_id() : -9999;
      int layout_fail_ordinal = s_app_debug_layout_fail_ordinal != NULL ? s_app_debug_layout_fail_ordinal() : -9999;
      int css_fail_code = s_app_debug_css_fail_code != NULL ? s_app_debug_css_fail_code() : -9999;
      int css_fail_route = s_app_debug_css_fail_route_index != NULL ? s_app_debug_css_fail_route_index() : -9999;
      int css_fail_node = s_app_debug_css_fail_node_id != NULL ? s_app_debug_css_fail_node_id() : -9999;
      int css_fail_rule = s_app_debug_css_fail_rule_ordinal != NULL ? s_app_debug_css_fail_rule_ordinal() : -9999;
      int css_fail_decl = s_app_debug_css_fail_declaration_ordinal != NULL ? s_app_debug_css_fail_declaration_ordinal() : -9999;
      int css_fail_property = s_app_debug_css_fail_property_code != NULL ? s_app_debug_css_fail_property_code() : -9999;
      int svg_fail_code = s_app_debug_svg_atlas_fail_code != NULL ? s_app_debug_svg_atlas_fail_code() : -9999;
      int svg_fail_paint = s_app_debug_svg_atlas_fail_paint_index != NULL ? s_app_debug_svg_atlas_fail_paint_index() : -9999;
      int svg_fail_route = s_app_debug_svg_atlas_fail_route_index != NULL ? s_app_debug_svg_atlas_fail_route_index() : -9999;
      int svg_fail_node = s_app_debug_svg_atlas_fail_node_id != NULL ? s_app_debug_svg_atlas_fail_node_id() : -9999;
      int svg_fail_ordinal = s_app_debug_svg_atlas_fail_ordinal != NULL ? s_app_debug_svg_atlas_fail_ordinal() : -9999;
      int svg_fail_resource_hash = s_app_debug_svg_atlas_fail_resource_hash != NULL ? s_app_debug_svg_atlas_fail_resource_hash() : -9999;
      int glyph_fail_code = s_app_debug_glyph_atlas_fail_code != NULL ? s_app_debug_glyph_atlas_fail_code() : -9999;
      int glyph_fail_route = s_app_debug_glyph_atlas_fail_route_index != NULL ? s_app_debug_glyph_atlas_fail_route_index() : -9999;
      int glyph_fail_node = s_app_debug_glyph_atlas_fail_node_id != NULL ? s_app_debug_glyph_atlas_fail_node_id() : -9999;
      int glyph_fail_ordinal = s_app_debug_glyph_atlas_fail_ordinal != NULL ? s_app_debug_glyph_atlas_fail_ordinal() : -9999;
      int glyph_fail_codepoint = s_app_debug_glyph_atlas_fail_codepoint != NULL ? s_app_debug_glyph_atlas_fail_codepoint() : -9999;
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "native_create init_done app_id=%llu app_status=%d app_build_step=%d layout_fail=%d layout_route=%d layout_node=%d layout_ordinal=%d css_fail=%d css_route=%d css_node=%d css_rule=%d css_decl=%d css_prop=%d svg_fail=%d svg_paint=%d svg_route=%d svg_node=%d svg_ordinal=%d svg_resource_hash=%d glyph_fail=%d glyph_route=%d glyph_node=%d glyph_ordinal=%d glyph_codepoint=%d",
                          (unsigned long long)runtime->app_id, app_status, app_build_step,
                          layout_fail_code, layout_fail_route, layout_fail_node, layout_fail_ordinal,
                          css_fail_code, css_fail_route, css_fail_node, css_fail_rule, css_fail_decl, css_fail_property,
                          svg_fail_code, svg_fail_paint, svg_fail_route, svg_fail_node, svg_fail_ordinal, svg_fail_resource_hash,
                          glyph_fail_code, glyph_fail_route, glyph_fail_node, glyph_fail_ordinal, glyph_fail_codepoint);
      if (runtime->app_id == 0u) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "native_create app_zero app_status=%d app_build_step=%d layout_fail=%d layout_route=%d layout_node=%d layout_ordinal=%d css_fail=%d css_route=%d css_node=%d css_rule=%d css_decl=%d css_prop=%d svg_fail=%d svg_paint=%d svg_route=%d svg_node=%d svg_ordinal=%d svg_resource_hash=%d glyph_fail=%d glyph_route=%d glyph_node=%d glyph_ordinal=%d glyph_codepoint=%d",
                            app_status, app_build_step,
                            layout_fail_code, layout_fail_route, layout_fail_node, layout_fail_ordinal,
                            css_fail_code, css_fail_route, css_fail_node, css_fail_rule, css_fail_decl, css_fail_property,
                            svg_fail_code, svg_fail_paint, svg_fail_route, svg_fail_node, svg_fail_ordinal, svg_fail_resource_hash,
                            glyph_fail_code, glyph_fail_route, glyph_fail_node, glyph_fail_ordinal, glyph_fail_codepoint);
        cheng_android_unregister_window(runtime->window_id);
        ANativeWindow_release(runtime->window);
        free(runtime);
        return NULL;
      }}
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "native_create set_window_begin app_id=%llu window_id=%llu",
                          (unsigned long long)runtime->app_id, (unsigned long long)runtime->window_id);
      int logical_width = cheng_android_surface_css_px(runtime->width, runtime->density);
      int logical_height = cheng_android_surface_css_px(runtime->height, runtime->density);
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "native_create set_window_viewport app_id=%llu window_id=%llu viewport=%dx%d surface=%dx%d density=%.3f",
                          (unsigned long long)runtime->app_id, (unsigned long long)runtime->window_id,
                          logical_width, logical_height, runtime->width, runtime->height, runtime->density);
      s_app_set_window(runtime->app_id, runtime->window_id, logical_width, logical_height, runtime->density);
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "native_create set_window_done app_id=%llu window_id=%llu",
                          (unsigned long long)runtime->app_id, (unsigned long long)runtime->window_id);
      return runtime;
    }}

    static jlong native_create(JNIEnv* env, jobject thiz, jobject surface, jint width, jint height, jfloat density, jobject assetManager, jstring runtimeManifestJson, jstring runtimeContractPayloadJson, jstring runtimeBundlePayloadJson, jstring launchArgsKv, jstring launchArgsJson) {{
      if (!cheng_resolve_exports()) {{
        return 0;
      }}
      if (!cheng_android_set_asset_manager(env, assetManager)) {{
        return 0;
      }}
      if (!cheng_android_set_activity_ref(env, thiz)) {{
        cheng_android_clear_asset_manager(env);
        return 0;
      }}
      pthread_mutex_lock(&s_input_mutex);
      s_input_write_idx = 0u;
      s_input_read_idx = 0u;
      pthread_mutex_unlock(&s_input_mutex);
      s_present_width = 0;
      s_present_height = 0;
      s_touch_width = width > 0 ? (int)width : 0;
      s_touch_height = height > 0 ? (int)height : 0;
      cheng_set_runtime_payloads(env, runtimeManifestJson, runtimeContractPayloadJson, runtimeBundlePayloadJson);
      cheng_set_launch_args(env, launchArgsKv, launchArgsJson);
      ChengAndroidShellRuntime* runtime = cheng_runtime_new(env, surface, width, height, density);
      if (runtime == NULL) {{
        cheng_android_clear_activity_ref(env);
        cheng_android_clear_asset_manager(env);
      }}
      return (jlong)(uintptr_t)runtime;
    }}

    // ---- Android startup-period MoQ serve (方向A last piece: 鸿蒙 fetch 安卓) ----------
    // Extracts the bundled fixture asset (own real content, packaged at build time under
    // assets/moq_fixture/) into the app-scoped dir Kotlin passes in, then dlopen+dlsym+pthread
    // the ISOLATED publisher .so (kept SEPARATE from cheng_generated_android_host.so — same
    // discipline as Harmony's libcheng_moq_harmony.so — its bigint/crypto/libp2p/QUIC symbols
    // would otherwise collide with the scene app's own copies). Idempotent: only the first
    // call starts the serve thread; served object identity is the real ingested asset's own
    // cid (mediaMoqPublisherRun range-checks every request against it, no arbitrary-file serve).
    static volatile int s_moq_serve_started = 0;
    static char s_moq_serve_mp4_path[PATH_MAX];
    static char s_moq_serve_cache_dir[PATH_MAX];
    typedef int (*cheng_moq_serve_file_fn)(const char*, const char*);
    static cheng_moq_serve_file_fn s_moq_serve_fn = NULL;

    static int cheng_android_extract_asset_to_file(const char* asset_rel, const char* out_path) {{
      if (s_asset_manager == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq fixture extract: no asset manager rel=%s", asset_rel);
        return 1;
      }}
      AAsset* asset = AAssetManager_open(s_asset_manager, asset_rel, AASSET_MODE_STREAMING);
      if (asset == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq fixture extract: asset missing rel=%s", asset_rel);
        return 2;
      }}
      FILE* out = fopen(out_path, "wb");
      if (out == NULL) {{
        AAsset_close(asset);
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq fixture extract: open dest failed path=%s errno=%d", out_path, errno);
        return 3;
      }}
      unsigned char buf[65536];
      int n;
      long long total = 0;
      while ((n = AAsset_read(asset, buf, sizeof(buf))) > 0) {{
        if (fwrite(buf, 1u, (size_t)n, out) != (size_t)n) {{
          fclose(out);
          AAsset_close(asset);
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq fixture extract: write failed path=%s", out_path);
          return 4;
        }}
        total += n;
      }}
      fclose(out);
      AAsset_close(asset);
      if (total <= 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq fixture extract: empty asset rel=%s", asset_rel);
        return 5;
      }}
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "moq fixture extract ok rel=%s bytes=%lld", asset_rel, total);
      return 0;
    }}

    static void* cheng_moq_serve_worker(void* arg) {{
      arg = arg;
      /* mediaMoqPublisherRun reports failure branches only on stderr, which the app
         swallows — persist it beside the cache so adb run-as can attribute any rc!=0
         (mirrors the Harmony own-serve bridge stderr capture, first needed 2026-07-11). */
      char errlog[512];
      snprintf(errlog, sizeof(errlog), "%s/serve_stderr.log", s_moq_serve_cache_dir);
      int errfd = open(errlog, O_WRONLY | O_CREAT | O_TRUNC, 0644);
      if (errfd >= 0) {{ dup2(errfd, 2); close(errfd); }}
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "moq startup serve: binding 0.0.0.0:38000 cache=%s", s_moq_serve_cache_dir);
      int rc = ((int (*)(const char*))s_moq_serve_fn)(s_moq_serve_cache_dir);
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "moq startup serve: returned rc=%d", rc);
      return NULL;
    }}

    static jboolean native_start_moq_serve(JNIEnv* env, jobject thiz, jstring cacheDir) {{
      thiz = thiz;
      if (s_moq_serve_started) {{
        return JNI_TRUE;
      }}
      if (cacheDir == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq startup serve: missing cache dir");
        return JNI_FALSE;
      }}
      const char* cacheDirChars = (*env)->GetStringUTFChars(env, cacheDir, NULL);
      if (cacheDirChars == NULL) {{
        return JNI_FALSE;
      }}
      snprintf(s_moq_serve_cache_dir, sizeof(s_moq_serve_cache_dir), "%s", cacheDirChars);
      (*env)->ReleaseStringUTFChars(env, cacheDir, cacheDirChars);
      mkdir(s_moq_serve_cache_dir, 0700);
      /* Six-asset bundled form (hgs.*): the bare-mp4 form produced an announce without
         es_index_bytes, which the ES-path viewer on the peer device refuses (es diag
         step=4, found on-device 2026-07-11). Mirrors the Harmony own-serve asset set. */
      static const char* kMoqOwnAssets[6] = {{
        "hgs.mp4", "hgs_poster.jpg", "hgs.h264", "hgs.moqidx", "hgs.aac", "hgs.aidx"
      }};
      for (int i = 0; i < 6; i++) {{
        char rel[128];
        char dst[PATH_MAX];
        snprintf(rel, sizeof(rel), "moq_fixture/%s", kMoqOwnAssets[i]);
        snprintf(dst, sizeof(dst), "%s/%s", s_moq_serve_cache_dir, kMoqOwnAssets[i]);
        if (cheng_android_extract_asset_to_file(rel, dst) != 0) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq startup serve: asset extract failed %s", rel);
          return JNI_FALSE;
        }}
      }}
      if (s_moq_serve_fn == NULL) {{
        void* h = dlopen("libcheng_moq_android.so", RTLD_NOW | RTLD_LOCAL);
        if (h == NULL) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq startup serve: dlopen failed: %s", dlerror());
          return JNI_FALSE;
        }}
        s_moq_serve_fn = (cheng_moq_serve_file_fn)dlsym(h, "cheng_android_publish_serve_bundled");
        if (s_moq_serve_fn == NULL) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq startup serve: dlsym failed");
          return JNI_FALSE;
        }}
      }}
      pthread_t worker;
      if (pthread_create(&worker, NULL, cheng_moq_serve_worker, NULL) != 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "moq startup serve: pthread_create failed");
        return JNI_FALSE;
      }}
      pthread_detach(worker);
      s_moq_serve_started = 1;
      return JNI_TRUE;
    }}

    /* S4 block cache production wiring (video-seek-scrub-blueprint.md §S4):
       cheng_scene_media_block_cache_init is a plain export of the SAME app .so
       (s_app_handle, already dlopen'd by native_create) that es_open/es_width/etc. resolve
       from — WebSceneMediaBlockCacheInit lives in web_scene_media_block_cache.cheng, imported
       by the same web_scene_media_network_bridge.cheng closure the ES pump already links, so
       it is NOT a separate .so the way the MoQ publish path (libcheng_moq_android.so) is.
       Idempotent (mirrors s_moq_serve_started above) and fail-open: a scene .so built before
       this slice simply lacks the symbol (dlsym returns NULL) and the cache stays uninitialized
       (WebSceneMediaBlockCacheGet already returns Err on every lookup in that state — no crash,
       same as before this slice, just no disk cache). */
    static volatile int s_media_block_cache_started = 0;
    static jboolean native_start_media_block_cache(JNIEnv* env, jobject thiz, jstring cacheDir) {{
      thiz = thiz;
      if (s_media_block_cache_started) {{
        return JNI_TRUE;
      }}
      if (cacheDir == NULL || s_app_handle == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media block cache: missing cache dir or app handle");
        return JNI_FALSE;
      }}
      const char* cacheDirChars = (*env)->GetStringUTFChars(env, cacheDir, NULL);
      if (cacheDirChars == NULL) {{
        return JNI_FALSE;
      }}
      int32_t (*blockCacheInitFn)(const char*) = (int32_t (*)(const char*))dlsym(s_app_handle, "cheng_scene_media_block_cache_init");
      int ok = 0;
      if (blockCacheInitFn == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "media block cache: dlsym cheng_scene_media_block_cache_init failed (older scene .so?)");
      }} else {{
        ok = blockCacheInitFn(cacheDirChars) != 0;
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "media block cache: init cache=%s ok=%d", cacheDirChars, ok);
      }}
      (*env)->ReleaseStringUTFChars(env, cacheDir, cacheDirChars);
      s_media_block_cache_started = ok ? 1 : 0;
      return ok ? JNI_TRUE : JNI_FALSE;
    }}

    /* Publish-time real CID ingest bridge (秒发): JNI entry Kotlin's chengPublishRun
       calls for video publishes. dlsym's cheng_publish_cid_pipeline_run from the
       ISOLATED publisher .so (same library/discipline as the MoQ startup serve
       above — media_moq_publisher_main.cheng imports publish_cid_pipeline.cheng,
       so the symbol ships in the same libcheng_moq_android.so) and runs it
       synchronously on the caller's background publish thread — the pipeline is
       network-free (ingest+persist only), so no listener/serve thread is involved.
       Distinct negative rc per failure stage, never silently swallowed. */
    static JNIEnv* cheng_android_jni_env(void);
    typedef int (*cheng_publish_cid_pipeline_run_fn)(const char*, const char*, const char*, const char*, const char*, const char*, long long, const char*);
    static cheng_publish_cid_pipeline_run_fn s_publish_cid_pipeline_fn = NULL;

    static jint native_publish_cid_ingest(JNIEnv* env, jobject thiz, jstring videoPath, jstring posterPath, jstring storePath, jstring taskId, jstring contentId, jstring ownerPeerId, jlong durationMs, jstring codecMime) {{
      thiz = thiz;
      if (videoPath == NULL || posterPath == NULL || storePath == NULL || taskId == NULL || contentId == NULL || ownerPeerId == NULL || codecMime == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "publish cid ingest: missing arg");
        return -10;
      }}
      if (s_publish_cid_pipeline_fn == NULL) {{
        void* h = dlopen("libcheng_moq_android.so", RTLD_NOW | RTLD_LOCAL);
        if (h == NULL) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "publish cid ingest: dlopen libcheng_moq_android.so failed: %s", dlerror());
          return -11;
        }}
        s_publish_cid_pipeline_fn = (cheng_publish_cid_pipeline_run_fn)dlsym(h, "cheng_publish_cid_pipeline_run");
        if (s_publish_cid_pipeline_fn == NULL) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "publish cid ingest: dlsym cheng_publish_cid_pipeline_run failed (stale publisher library — version script must export it)");
          return -12;
        }}
      }}
      const char* video = (*env)->GetStringUTFChars(env, videoPath, NULL);
      const char* poster = (*env)->GetStringUTFChars(env, posterPath, NULL);
      const char* store = (*env)->GetStringUTFChars(env, storePath, NULL);
      const char* task = (*env)->GetStringUTFChars(env, taskId, NULL);
      const char* content = (*env)->GetStringUTFChars(env, contentId, NULL);
      const char* owner = (*env)->GetStringUTFChars(env, ownerPeerId, NULL);
      const char* codec = (*env)->GetStringUTFChars(env, codecMime, NULL);
      if (video == NULL || poster == NULL || store == NULL || task == NULL || content == NULL || owner == NULL || codec == NULL) {{
        if (video != NULL) (*env)->ReleaseStringUTFChars(env, videoPath, video);
        if (poster != NULL) (*env)->ReleaseStringUTFChars(env, posterPath, poster);
        if (store != NULL) (*env)->ReleaseStringUTFChars(env, storePath, store);
        if (task != NULL) (*env)->ReleaseStringUTFChars(env, taskId, task);
        if (content != NULL) (*env)->ReleaseStringUTFChars(env, contentId, content);
        if (owner != NULL) (*env)->ReleaseStringUTFChars(env, ownerPeerId, owner);
        if (codec != NULL) (*env)->ReleaseStringUTFChars(env, codecMime, codec);
        return -13;
      }}
      int rc = s_publish_cid_pipeline_fn(video, poster, store, task, content, owner, (long long)durationMs, codec);
      (*env)->ReleaseStringUTFChars(env, videoPath, video);
      (*env)->ReleaseStringUTFChars(env, posterPath, poster);
      (*env)->ReleaseStringUTFChars(env, storePath, store);
      (*env)->ReleaseStringUTFChars(env, taskId, task);
      (*env)->ReleaseStringUTFChars(env, contentId, content);
      (*env)->ReleaseStringUTFChars(env, ownerPeerId, owner);
      (*env)->ReleaseStringUTFChars(env, codecMime, codec);
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "publish cid ingest: pipeline rc=%d", rc);
      return rc;
    }}

    /* Home-feed realtime pump (gossipsub inbound → runtime feed): one detached thread
       per process blocking inside the backend's social_wait_feed_event export; each
       wake means drainInboundGossipMessages just stored >=1 new publish-metadata/
       content-announce into the feed store, so the Java side is woken to re-merge the
       real snapshot into the retained runtime (replacing the create/resume-only
       one-shot merge). A backend .so built before the export existed fails the dlsym
       below loudly — the create/resume snapshot path stays authoritative there; there
       is no fabricated empty-poll loop anywhere in this design. The worker detaches
       from the JVM before every exit (ART aborts on attached-thread exit). */
    typedef int (*cheng_social_wait_feed_event_fn)(int64_t, int32_t);
    typedef char* (*cheng_social_poll_events_fn)(int64_t, int32_t);
    typedef void (*cheng_libp2p_string_free_fn)(const char*);
    static volatile int s_feed_pump_started = 0;
    static int64_t s_feed_pump_handle = 0;

    static void cheng_feed_event_pump_worker_inner(void) {{
      void* h = dlopen("libchenglibp2p.so", RTLD_NOW | RTLD_LOCAL);
      if (h == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: dlopen libchenglibp2p.so failed: %s", dlerror());
        return;
      }}
      cheng_social_wait_feed_event_fn waitFn = (cheng_social_wait_feed_event_fn)dlsym(h, "social_wait_feed_event");
      cheng_social_poll_events_fn pollFn = (cheng_social_poll_events_fn)dlsym(h, "social_poll_events");
      cheng_libp2p_string_free_fn freeFn = (cheng_libp2p_string_free_fn)dlsym(h, "libp2p_string_free");
      if (waitFn == NULL || pollFn == NULL || freeFn == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: backend lacks social_wait_feed_event/social_poll_events/libp2p_string_free (group-create stub backend has no gossipsub inbound; realtime feed wake unavailable on it)");
        return;
      }}
      JNIEnv* env = cheng_android_jni_env();
      if (env == NULL || s_activity_ref == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: missing env/activity");
        return;
      }}
      jclass cls = (*env)->GetObjectClass(env, s_activity_ref);
      if (cls == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: missing activity class");
        return;
      }}
      jmethodID wake = (*env)->GetMethodID(env, cls, "chengFeedInboundWake", "()V");
      if (wake == NULL) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: missing chengFeedInboundWake method");
        if ((*env)->ExceptionCheck(env)) (*env)->ExceptionDescribe(env);
        return;
      }}
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "feed event pump: started handle=%lld", (long long)s_feed_pump_handle);
      for (;;) {{
        int wrc = waitFn(s_feed_pump_handle, 30000);
        if (wrc < 0) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: wait failed rc=%d — pump exits loud (no retry spin)", wrc);
          return;
        }}
        if (wrc == 0) continue;
        char* events = pollFn(s_feed_pump_handle, 32);
        int eventsLen = 0;
        if (events != NULL) {{ eventsLen = (int)strlen(events); freeFn(events); }}
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell", "feed event pump: inbound feed update events_len=%d", eventsLen);
        env = cheng_android_jni_env();
        if (env == NULL || s_activity_ref == NULL) continue;
        (*env)->CallVoidMethod(env, s_activity_ref, wake);
        if ((*env)->ExceptionCheck(env)) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: wake call failed");
          (*env)->ExceptionDescribe(env);
          (*env)->ExceptionClear(env);
        }}
      }}
    }}

    static void* cheng_feed_event_pump_worker(void* arg) {{
      arg = arg;
      cheng_feed_event_pump_worker_inner();
      /* Worker exit (dlopen/dlsym/wait fail) must clear the latch so
         startFeedEventPumpIfNeeded can recreate the thread. Leaving the
         flag set after a dead worker is a silent one-shot disable. */
      s_feed_pump_started = 0;
      __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: worker exited; startFeedEventPumpIfNeeded may retry");
      if (s_java_vm != NULL) {{
        (*s_java_vm)->DetachCurrentThread(s_java_vm);
      }}
      return NULL;
    }}

    static jboolean native_start_feed_event_pump(JNIEnv* env, jobject thiz, jlong nodeHandle) {{
      thiz = thiz;
      if (s_feed_pump_started) {{
        return JNI_TRUE;
      }}
      if (nodeHandle == 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: zero node handle");
        return JNI_FALSE;
      }}
      s_feed_pump_handle = (int64_t)nodeHandle;
      pthread_t worker;
      if (pthread_create(&worker, NULL, cheng_feed_event_pump_worker, NULL) != 0) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell", "feed event pump: pthread_create failed");
        return JNI_FALSE;
      }}
      pthread_detach(worker);
      s_feed_pump_started = 1;
      return JNI_TRUE;
    }}

    static void native_resize(JNIEnv* env, jobject thiz, jlong handle, jobject surface, jint width, jint height, jfloat density) {{
      thiz = thiz;
      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)(uintptr_t)handle;
      if (runtime == NULL) {{
        return;
      }}
      if (runtime->window != NULL) {{
        cheng_android_unregister_window(runtime->window_id);
        ANativeWindow_release(runtime->window);
      }}
      runtime->window = ANativeWindow_fromSurface(env, surface);
      if (runtime->window == NULL) {{
        runtime->window_id = 0u;
        return;
      }}
      runtime->window_id = cheng_android_register_window(runtime->window);
      runtime->width = cheng_android_surface_dimension((int)width, ANativeWindow_getWidth(runtime->window));
      runtime->height = cheng_android_surface_dimension((int)height, ANativeWindow_getHeight(runtime->window));
      runtime->density = density;
      s_touch_width = width > 0 ? (int)width : runtime->width;
      s_touch_height = height > 0 ? (int)height : runtime->height;
      s_active_window = runtime->window;
      s_active_width = runtime->width;
      s_active_height = runtime->height;
      s_active_density = runtime->density;
      int logical_width = cheng_android_surface_css_px(runtime->width, runtime->density);
      int logical_height = cheng_android_surface_css_px(runtime->height, runtime->density);
      __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                          "native_resize set_window_viewport app_id=%llu window_id=%llu viewport=%dx%d surface=%dx%d density=%.3f",
                          (unsigned long long)runtime->app_id, (unsigned long long)runtime->window_id,
                          logical_width, logical_height, runtime->width, runtime->height, runtime->density);
      s_app_set_window(runtime->app_id, runtime->window_id, logical_width, logical_height, runtime->density);
    }}

    static uint8_t cheng_ring_read_u8(uint32_t offset) {{
      return s_input_ring[offset % CHENG_ANDROID_INPUT_RING_CAPACITY];
    }}

    static uint32_t cheng_ring_read_u32(uint32_t offset) {{
      uint32_t out = 0u;
      uint8_t bytes[4];
      bytes[0] = cheng_ring_read_u8(offset);
      bytes[1] = cheng_ring_read_u8(offset + 1u);
      bytes[2] = cheng_ring_read_u8(offset + 2u);
      bytes[3] = cheng_ring_read_u8(offset + 3u);
      memcpy(&out, bytes, sizeof(out));
      return out;
    }}

    static void cheng_ring_write_u32(uint32_t offset, uint32_t value) {{
      uint8_t bytes[4];
      memcpy(bytes, &value, sizeof(value));
      s_input_ring[offset % CHENG_ANDROID_INPUT_RING_CAPACITY] = bytes[0];
      s_input_ring[(offset + 1u) % CHENG_ANDROID_INPUT_RING_CAPACITY] = bytes[1];
      s_input_ring[(offset + 2u) % CHENG_ANDROID_INPUT_RING_CAPACITY] = bytes[2];
      s_input_ring[(offset + 3u) % CHENG_ANDROID_INPUT_RING_CAPACITY] = bytes[3];
    }}

    static int cheng_android_enqueue_touch_event(int action, int pointer_id, int x_milli, int y_milli) {{
      pthread_mutex_lock(&s_input_mutex);
      uint32_t w = s_input_write_idx;
      uint32_t r = s_input_read_idx;
      if (w >= CHENG_ANDROID_INPUT_RING_CAPACITY || r >= CHENG_ANDROID_INPUT_RING_CAPACITY) {{
        pthread_mutex_unlock(&s_input_mutex);
        return 0;
      }}
      uint32_t used = w >= r ? (w - r) : (CHENG_ANDROID_INPUT_RING_CAPACITY - (r - w));
      if (used + CHENG_ANDROID_INPUT_TOUCH_V1_BYTES + 1u >= CHENG_ANDROID_INPUT_RING_CAPACITY) {{
        pthread_mutex_unlock(&s_input_mutex);
        return 0;
      }}
      cheng_ring_write_u32(w, CHENG_ANDROID_INPUT_TOUCH_V1);
      cheng_ring_write_u32(w + 4u, (uint32_t)action);
      cheng_ring_write_u32(w + 8u, (uint32_t)pointer_id);
      cheng_ring_write_u32(w + 12u, (uint32_t)x_milli);
      cheng_ring_write_u32(w + 16u, (uint32_t)y_milli);
      s_input_write_idx = (w + CHENG_ANDROID_INPUT_TOUCH_V1_BYTES) % CHENG_ANDROID_INPUT_RING_CAPACITY;
      pthread_mutex_unlock(&s_input_mutex);
      return 1;
    }}

    static int cheng_android_touch_trace_enabled(void) {{
      if (s_touch_trace_enabled < 0) {{
        char prop[92];
        prop[0] = '\0';
        s_touch_trace_enabled = __system_property_get("debug.cheng.touch.trace", prop) > 0 && prop[0] == '1' ? 1 : 0;
      }}
      return s_touch_trace_enabled;
    }}

    static int cheng_android_touch_deep_trace_enabled(void) {{
      if (s_touch_deep_trace_enabled < 0) {{
        char prop[92];
        prop[0] = '\0';
        s_touch_deep_trace_enabled = __system_property_get("debug.cheng.touch.deep", prop) > 0 && prop[0] == '1' ? 1 : 0;
      }}
      return s_touch_deep_trace_enabled;
    }}

    static int cheng_android_pop_touch_event(int* action, int* pointer_id, int* x_milli, int* y_milli) {{
      pthread_mutex_lock(&s_input_mutex);
      if (s_input_read_idx == s_input_write_idx) {{
        pthread_mutex_unlock(&s_input_mutex);
        return 0;
      }}
      uint32_t r = s_input_read_idx;
      uint32_t kind = cheng_ring_read_u32(r);
      if (kind != CHENG_ANDROID_INPUT_TOUCH_V1) {{
        s_input_read_idx = s_input_write_idx;
        pthread_mutex_unlock(&s_input_mutex);
        return -1;
      }}
      *action = (int)cheng_ring_read_u32(r + 4u);
      *pointer_id = (int)cheng_ring_read_u32(r + 8u);
      *x_milli = (int)(int32_t)cheng_ring_read_u32(r + 12u);
      *y_milli = (int)(int32_t)cheng_ring_read_u32(r + 16u);
      s_input_read_idx = (r + CHENG_ANDROID_INPUT_TOUCH_V1_BYTES) % CHENG_ANDROID_INPUT_RING_CAPACITY;
      pthread_mutex_unlock(&s_input_mutex);
      return 1;
    }}

    static int cheng_android_drain_input_ring(ChengAndroidShellRuntime* runtime) {{
      if (runtime == NULL || s_app_on_touch_milli == NULL) {{
        return 0;
      }}
      int drained_event_count = 0;
      while (true) {{
        int action = 0;
        int pointer_id = 0;
        int x_milli = 0;
        int y_milli = 0;
        int pop_status = cheng_android_pop_touch_event(&action, &pointer_id, &x_milli, &y_milli);
        if (pop_status == 0) {{
          if (drained_event_count > 0 && s_app_needs_frame != NULL && s_app_needs_frame(runtime->app_id) != 0) {{
            s_input_pending_frame_invalidation = 1;
          }}
          return 1;
        }}
        if (pop_status < 0) {{
          __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                              "input_ring corrupt kind; aborting");
          abort();
        }}
        drained_event_count++;
        int app_x_milli = x_milli;
        int app_y_milli = y_milli;
        int source_width = s_touch_width > 0 ? s_touch_width : runtime->width;
        int source_height = s_touch_height > 0 ? s_touch_height : runtime->height;
        if (source_width > 0 && s_present_width > 0) {{
          app_x_milli = (int)(((int64_t)x_milli * (int64_t)s_present_width) / (int64_t)source_width);
        }}
        if (source_height > 0 && s_present_height > 0) {{
          app_y_milli = (int)(((int64_t)y_milli * (int64_t)s_present_height) / (int64_t)source_height);
        }}
        if (action == 2) {{
          if (s_input_last_move_valid &&
              s_input_last_move_pointer_id == pointer_id &&
              s_input_last_move_x_milli == app_x_milli &&
              s_input_last_move_y_milli == app_y_milli) {{
            continue;
          }}
          s_input_last_move_valid = 1;
          s_input_last_move_pointer_id = pointer_id;
          s_input_last_move_x_milli = app_x_milli;
          s_input_last_move_y_milli = app_y_milli;
        }} else {{
          s_input_last_move_valid = 0;
        }}
