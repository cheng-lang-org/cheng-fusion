            // when the drag velocity is high enough (sampled per-frame in tick).
            if (s_touch_scrolling) {{
              dispatch_touch = 0;
              float fling_v = s_fling_velocity_px_per_ms;
              if (fling_v < 0.0f) {{
                fling_v = -fling_v;
              }}
