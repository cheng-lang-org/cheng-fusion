            s_touch_active = 0;
            s_touch_scrolling = 0;
            s_touch_route_index = -1;
          }}
        }}
        if (touch_trace_enabled && action == 1 && dispatch_touch) {{
          /* t0 of the tap->first-frame trace triple (t0=tap dispatch, t1=resource
           * ready, t2=present_compositor frame=N). One line per real dispatched
           * tap-up only (never per move/scroll-release), so cost is event-driven
           * not per-frame. t1/t2 correlate by log arrival order (single-threaded
           * render/tick loop; see cheng_mobile_host_trace_step step=975001 and
           * __csg_scene_present_active_route / __csg_scene_refresh_transition_stats). */
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                              "tap_trace t0 pointer=%d app_milli=%d,%d",
                              pointer_id, app_x_milli, app_y_milli);
          s_touch_trace_pending_present = 1;
        }}
        struct timespec touch_ts0;
        if (touch_trace_enabled) {{
          clock_gettime(CLOCK_MONOTONIC, &touch_ts0);
        }}
        if (dispatch_touch) {{
          s_app_on_touch_milli(runtime->app_id, action, pointer_id, app_x_milli, app_y_milli);
        }} else if (action == 2) {{
          /* Scroll consumed this move for panning, but still forward it: the
           * app's move branch only feeds the qi ink trail (no hit/click state),
           * so the trail follows the finger during scroll gestures too. */
          s_app_on_touch_milli(runtime->app_id, 2, pointer_id, app_x_milli, app_y_milli);
        }}
        if (!touch_trace_enabled) {{
          continue;
        }}
        struct timespec touch_ts1;
        clock_gettime(CLOCK_MONOTONIC, &touch_ts1);
        int route_after = s_app_debug_route_index != NULL ? s_app_debug_route_index() : -9999;
        if (!touch_deep_trace_enabled) {{
          __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                              "input_touch action=%d dur_us=%lld pointer=%d app_milli=%d,%d route_before=%d route_after=%d",
                              action,
                              (long long)((touch_ts1.tv_sec - touch_ts0.tv_sec) * 1000000LL + (touch_ts1.tv_nsec - touch_ts0.tv_nsec) / 1000LL),
                              pointer_id, app_x_milli, app_y_milli, route_before, route_after);
          continue;
        }}
        int hit_index = s_app_debug_touch_hit_index != NULL ? s_app_debug_touch_hit_index() : -9999;
        int top_kind = s_app_debug_top_kind != NULL ? s_app_debug_top_kind() : -9999;
        int top_node = s_app_debug_top_node != NULL ? s_app_debug_top_node() : -9999;
        int top_apply = s_app_debug_top_apply_status != NULL ? s_app_debug_top_apply_status() : -9999;
        int route_apply_node = s_app_debug_route_apply_node != NULL ? s_app_debug_route_apply_node() : -9999;
        int route_apply_from = s_app_debug_route_apply_from != NULL ? s_app_debug_route_apply_from() : -9999;
        int route_apply_target = s_app_debug_route_apply_target != NULL ? s_app_debug_route_apply_target() : -9999;
        int route_apply_to = s_app_debug_route_apply_to != NULL ? s_app_debug_route_apply_to() : -9999;
        int route_apply_status = s_app_debug_route_apply_status != NULL ? s_app_debug_route_apply_status() : -9999;
        int event_node = s_app_debug_last_event_hit_node_id != NULL ? s_app_debug_last_event_hit_node_id() : -9999;
        int event_status = s_app_debug_last_event_hit_status != NULL ? s_app_debug_last_event_hit_status() : -9999;
        int event_apply = s_app_debug_last_event_apply_status != NULL ? s_app_debug_last_event_apply_status() : -9999;
        int state_publish_notice = s_app_debug_state_publish_notice_open != NULL ? s_app_debug_state_publish_notice_open() : -9999;
        int state_original = s_app_debug_state_is_original != NULL ? s_app_debug_state_is_original() : -9999;
        int state_paid = s_app_debug_state_is_paid != NULL ? s_app_debug_state_is_paid() : -9999;
        int state_review_console = s_app_debug_state_show_review_console != NULL ? s_app_debug_state_show_review_console() : -9999;
        int state_video_playing = s_app_debug_state_is_video_playing != NULL ? s_app_debug_state_is_video_playing() : -9999;
        int video_overlay_hidden = s_app_debug_video_overlay_hidden != NULL ? s_app_debug_video_overlay_hidden() : -9999;
        int app_status = s_app_debug_last_main_status != NULL ? s_app_debug_last_main_status() : -9999;
        int css_fail_code = s_app_debug_css_fail_code != NULL ? s_app_debug_css_fail_code() : -9999;
        int css_fail_route = s_app_debug_css_fail_route_index != NULL ? s_app_debug_css_fail_route_index() : -9999;
        int css_fail_node = s_app_debug_css_fail_node_id != NULL ? s_app_debug_css_fail_node_id() : -9999;
        int css_fail_rule = s_app_debug_css_fail_rule_ordinal != NULL ? s_app_debug_css_fail_rule_ordinal() : -9999;
        int css_fail_declaration = s_app_debug_css_fail_declaration_ordinal != NULL ? s_app_debug_css_fail_declaration_ordinal() : -9999;
        int css_fail_property = s_app_debug_css_fail_property_code != NULL ? s_app_debug_css_fail_property_code() : -9999;
        int refresh_css_fail_stage = s_app_debug_refresh_css_fail_stage != NULL ? s_app_debug_refresh_css_fail_stage() : -9999;
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "input_touch action=%d dur_us=%lld pointer=%d raw_milli=%d,%d app_milli=%d,%d source=%dx%d present=%dx%d route_before=%d route_after=%d hit=%d route_probe=%d box_probe=%d,%d,%d,%d,%d publish_notice_box=%d,%d,%d,%d thumb=%d,%d,%d,%d top=%d,%d,%d route_apply=%d,%d,%d,%d,%d event=%d,%d,%d state=%d,%d,%d review=%d video=%d,%d status=%d refresh=%d css=%d,%d,%d,%d,%d,%d scroll=%d,%d,%d,%d",
                            action, (long long)((touch_ts1.tv_sec - touch_ts0.tv_sec) * 1000000LL + (touch_ts1.tv_nsec - touch_ts0.tv_nsec) / 1000LL), pointer_id, x_milli, y_milli, app_x_milli, app_y_milli,
                            source_width, source_height, s_present_width, s_present_height,
                            route_before, route_after, hit_index,
                            route_probe_node, box_probe_node, box_probe_x, box_probe_y, box_probe_w, box_probe_h,
                            publish_notice_button_x, publish_notice_button_y, publish_notice_button_w, publish_notice_button_h,
                            publish_notice_thumb_x, publish_notice_thumb_y, publish_notice_thumb_w, publish_notice_thumb_h,
                            top_kind, top_node, top_apply,
                            route_apply_node, route_apply_from, route_apply_target, route_apply_to, route_apply_status,
                            event_node, event_status, event_apply,
                            state_publish_notice, state_original, state_paid, state_review_console,
                            state_video_playing, video_overlay_hidden,
                            app_status,
                            refresh_css_fail_stage,
                            css_fail_code, css_fail_route, css_fail_node, css_fail_rule, css_fail_declaration, css_fail_property,
                            s_touch_scrolling, dispatch_touch, scroll_delta_px, scroll_applied);
      }}
    }}

    static jboolean native_tick(JNIEnv* env, jobject thiz, jlong handle, jfloat delta_seconds) {{
      env = env;
      thiz = thiz;
      ChengAndroidShellRuntime* runtime = (ChengAndroidShellRuntime*)(uintptr_t)handle;
      if (runtime == NULL) {{
        return JNI_FALSE;
      }}
      if (!cheng_android_drain_input_ring(runtime)) {{
        __android_log_print(ANDROID_LOG_ERROR, "cheng-mobile-shell",
                            "native_tick input drain failed; aborting");
        abort();
      }}
      int drained_input_events = s_input_events_since_tick;
      s_input_events_since_tick = 0;
      if (s_input_pending_frame_invalidation) {{
        cheng_android_invalidate_cached_compositor_frame("input_drain");
        s_input_pending_frame_invalidation = 0;
      }}
      {{
        float dt_ms = delta_seconds > 0.0f ? delta_seconds * 1000.0f : 16.0f;
        if (s_touch_scrolling) {{
          float inst = (float)s_frame_scroll_px / dt_ms;
          s_fling_velocity_px_per_ms = 0.6f * inst + 0.4f * s_fling_velocity_px_per_ms;
        }} else if (!s_fling_active) {{
          s_fling_velocity_px_per_ms = 0.0f;
        }}
        s_frame_scroll_px = 0;
        if (s_fling_active) {{
          int step_px = (int)(s_fling_velocity_px_per_ms * dt_ms);
          if (step_px != 0 && s_app_scroll_by != NULL && s_fling_route_index >= 0) {{
            int applied = s_app_scroll_by(runtime->app_id, s_fling_route_index, step_px);
            if (s_fling_log_count < 12) {{
              s_fling_log_count++;
              __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                                  "fling route=%d step=%d applied=%d v=%.3f",
                                  s_fling_route_index, step_px, applied, (double)s_fling_velocity_px_per_ms);
            }}
            if (applied == s_fling_last_applied) {{
              s_fling_active = 0;
            }}
            s_fling_last_applied = applied;
          }}
          float decay = 1.0f - 0.0045f * dt_ms;
          if (decay < 0.0f) {{
            decay = 0.0f;
          }}
          s_fling_velocity_px_per_ms *= decay;
          float fling_abs = s_fling_velocity_px_per_ms < 0.0f ? -s_fling_velocity_px_per_ms : s_fling_velocity_px_per_ms;
          if (fling_abs < 0.05f) {{
            s_fling_active = 0;
          }}
        }}
      }}
      int computer_use_replay_active_for_media_fast_path = s_app_debug_computer_use_gui_replay_active != NULL ? s_app_debug_computer_use_gui_replay_active() : 0;
      if (drained_input_events == 0 &&
          !s_touch_active &&
          !s_fling_active &&
          computer_use_replay_active_for_media_fast_path == 0 &&
          s_present_media_surface_playing_count > 0) {{
        cheng_pump_media_fetch_on_runtime_thread();
        cheng_android_es_pump_open_on_render_thread();
        if (s_es_engaged) {{
          cheng_android_es_prefetch_on_render_thread();
        }}
        cheng_android_aes_pump_open_on_render_thread();
        if (s_aes_engaged) {{
          cheng_android_aes_decode_pump_on_render_thread();
        }}
        if (cheng_android_present_cached_compositor_media_frame("native_tick_media_fast_path")) {{
          return JNI_TRUE;
        }}
      }}
      if (s_tick_debug_log_count < 8) {{
        int app_status_before = s_app_debug_last_main_status != NULL ? s_app_debug_last_main_status() : -9999;
        int app_build_step_before = s_app_debug_build_step != NULL ? s_app_debug_build_step() : -1;
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                            "native_tick begin app_id=%llu delta=%.6f app_status=%d app_build_step=%d",
                            (unsigned long long)runtime->app_id, delta_seconds, app_status_before, app_build_step_before);
      }}
      int compositor_frames_before_tick = s_present_compositor_gl_frame_count;
      s_app_tick(runtime->app_id, delta_seconds);
      /* Drive the cross-device media fetch on the cheng runtime-owner thread (here) — the pure-Cheng
         QUIC recv pump only progresses on this thread; the decode thread merely requests it. */
      cheng_pump_media_fetch_on_runtime_thread();
      /* Progressive ES: run es_open + frame prefetch on this (runtime-owner) thread — the only
         thread that drives the Cheng QUIC pump (measured: a bare pthread cannot). es_open is
         pumped even before the decoder is live so prepare can configure the moment w/h lands. */
      cheng_android_es_pump_open_on_render_thread();
      if (s_es_engaged) {{
        cheng_android_es_prefetch_on_render_thread();
      }}
      /* Streaming AUDIO ES: open pump (QUIC dial, render thread only) + decode pump (feed
         AAC codec, drain PCM into the AAudio ring). Mirrors the video ES tick wiring. */
      cheng_android_aes_pump_open_on_render_thread();
      if (s_aes_engaged) {{
        cheng_android_aes_decode_pump_on_render_thread();
      }}
      int computer_use_replay_tick = 0;
      if (s_app_computer_use_gui_replay_tick != NULL) {{
        int delta_ms = delta_seconds > 0.0f ? (int)(delta_seconds * 1000.0f) : 16;
        if (delta_ms < 1) {{
          delta_ms = 1;
        }}
        computer_use_replay_tick = s_app_computer_use_gui_replay_tick((int32_t)delta_ms);
        if (computer_use_replay_tick != 0) {{
          static int s_computer_use_gui_replay_tick_log_count = 0;
          if (s_computer_use_gui_replay_tick_log_count < 64) {{
            __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
                                "computer_use_gui_replay_tick result=%d delta_ms=%d",
                                computer_use_replay_tick, delta_ms);
            s_computer_use_gui_replay_tick_log_count++;
          }}
        }}
      }}
      if (s_present_media_surface_playing_count > 0 &&
          s_present_compositor_gl_frame_count == compositor_frames_before_tick) {{
        cheng_android_present_cached_compositor_media_frame("native_tick_media_playback");
      }}
      if (s_app_needs_frame == NULL) {{
        return computer_use_replay_tick != 0 ? JNI_TRUE : JNI_FALSE;
      }}
      int needs_frame = s_app_needs_frame(runtime->app_id) != 0 ? 1 : 0;
      if (computer_use_replay_tick != 0) {{
        needs_frame = 1;
      }}
      if (s_fling_active) {{
        needs_frame = 1;
      }}
      if (s_ink_overlay_command_count > 0 || (s_ink_field_active && s_ink_field_fade_permille > 0)) {{
        needs_frame = 1;
      }}
      /* Video playback must drive continuous redraw: the loop is otherwise dirty-flag
         event-driven, so the frame pump only advances at the app's sporadic dirty rate
         (~23fps → ~2.6x slow). While any media surface is PLAYING/SEEKED, force a frame
         every vsync so Choreographer re-posts at 60fps; the pump's PTS gate then drains
         to wall-clock realtime (1.0x). Reverts to dirty-driven once playback stops. */
      if (s_present_media_surface_playing_count > 0) {{
        needs_frame = 1;
      }}
      if (s_tick_debug_log_count < 8) {{
        int app_status = s_app_debug_last_main_status != NULL ? s_app_debug_last_main_status() : -9999;
        int app_build_step = s_app_debug_build_step != NULL ? s_app_debug_build_step() : -1;
        int app_gpu_commands = s_app_debug_gpu_command_count != NULL ? s_app_debug_gpu_command_count() : -1;
        int app_media_surfaces = s_app_debug_media_surface_command_count != NULL ? s_app_debug_media_surface_command_count() : -1;
        int app_media_surface_bytes = s_app_debug_media_surface_batch_bytes != NULL ? s_app_debug_media_surface_batch_bytes() : -1;
        int app_media_surface_stride = s_app_debug_media_surface_batch_stride != NULL ? s_app_debug_media_surface_batch_stride() : -1;
        int app_layers = s_app_debug_compositor_layer_count != NULL ? s_app_debug_compositor_layer_count() : -1;
        int glyph_fail_code = s_app_debug_glyph_atlas_fail_code != NULL ? s_app_debug_glyph_atlas_fail_code() : -9999;
        int glyph_fail_route = s_app_debug_glyph_atlas_fail_route_index != NULL ? s_app_debug_glyph_atlas_fail_route_index() : -9999;
        int glyph_fail_node = s_app_debug_glyph_atlas_fail_node_id != NULL ? s_app_debug_glyph_atlas_fail_node_id() : -9999;
        int glyph_fail_ordinal = s_app_debug_glyph_atlas_fail_ordinal != NULL ? s_app_debug_glyph_atlas_fail_ordinal() : -9999;
        int glyph_fail_codepoint = s_app_debug_glyph_atlas_fail_codepoint != NULL ? s_app_debug_glyph_atlas_fail_codepoint() : -9999;
        int host_video_texture_ready = cheng_android_video_texture_receipt_ready();
        __android_log_print(ANDROID_LOG_INFO, "cheng-mobile-shell",
