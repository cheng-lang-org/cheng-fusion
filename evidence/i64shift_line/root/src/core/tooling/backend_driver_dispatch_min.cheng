        closureSourceSnapshots: BackendDriverDispatchMinFileSnapshot[]

    BackendDriverDispatchMinProviderCompileResult =
        completed: bool
        ok: bool
        moduleIndex: int32
        modulePath: str
        sourcePath: str
        objectPath: str
        logPath: str
        errorMessage: str
        cacheHit: bool
        nestedCompile: bool
        canonicalObjectPath: str
        objectSha256: str
        objectSize: str
        pinnedObjectFd: int32 = -1

    BackendDriverDispatchMinProviderBundle =
        compilerPath: str
        modulePaths: str[]
        sourcePaths: str[]
        exportRootTexts: str[]
        objectPaths: str[]
        compileReportPaths: str[]
        compileLogPaths: str[]
        compileRequestCount: int32
        requestedJobs: int32
        activeWorkers: int32
        completedWorkers: int32
        schedule: str
        compilerSha256: str
        cacheMode: str
        cacheDirectory: str
        cacheTaskCount: int32
        cacheHitCount: int32
        cacheMissCount: int32
        nestedCompileCount: int32
        providerStageManifestPath: str
        providerStageManifestSha256: str
        providerStageId: str
        providerStagePlanSha256: str
        providerStageValidationStatus: str
        providerStageValidationPassCount: int32
        providerStageManifestSnapshot: BackendDriverDispatchMinFileSnapshot
        providerStageArtifactSnapshots: BackendDriverDispatchMinFileSnapshot[]
        providerStagePinnedFds: int32[]
        providerStagePinnedPaths: str[]
        providerStagePinnedObjectPaths: str[]
        providerObjectPinnedFds: int32[]
        reportObjectPaths: str[]
        reportObjectSha256s: str[]
        reportObjectSizes: str[]

    BackendDriverDispatchMinProviderWorkerContext = ref object
        workerId: int32
        rootDir: str
        compilerPath: str
        targetTriple: str

    # emit-csg 查询臂在 16MB pthread 上跑（与 program_support worker 同口径）。
    # 主线程 8MB：TypedExprIrAppendNode 序言单帧 334KB 写穿 guard
    # （EXC_BAD_ACCESS code=2，drv12 hello 栈顶已用 7.7MB）。
    BackendDriverDispatchMinEmitCsgQueryWork = ref object
        plan: sexec.SystemLinkExecPlan
        linkPlan: slplan.SystemLinkPlanStub
        receipt: ccsg.PortableSourceIdentityReceipt
        err: str
        ok: bool

    # system-link-exec 编译臂同样必须离开 8MB 主栈。
    # getenv6 hello：10102 序言 sub $0x15e930 后 mov [rsp],r10，
    # fault=RSP 已在 [stack] 映射之下（SEGV_MAPERR）。同链 10724 帧 4MB、
    # 9831 帧 2.6MB 已把主栈吃到只剩 ~46KB。
    BackendDriverDispatchMinSystemLinkExecWork = ref object
        workspaceRoot: str
        req: creq.CompilerRequest
        worldHead: str
        lockPath: str
        baselineSurfacePath: str
        channel: str
        reportKind: str
        heldObjectMode: bool
        heldObjectLease: heldfd.HeldOutputFdLease
        plan: sexec.SystemLinkExecPlan
        runtimeResult: sexecrt.SystemLinkExecRuntimeResult
        preExecutionReport: str
        err: str
        ok: bool

