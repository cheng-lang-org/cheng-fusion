    BackendDriverDispatchMinAppendLine(out, "cold_system_link_exec=0")
    BackendDriverDispatchMinAppendLine(out, "system_link_exec_scope=selfhost_direct")
    BackendDriverDispatchMinAppendLine(out, "full_backend_codegen=1")

fn BackendDriverDispatchMinPrintBuildPlanFromCmdline(): int32 =
    return BackendDriverDispatchMinPrintBuildPlan()

fn BackendDriverDispatchMinPrintBuildPlanCommandFromCmdline(): int32 =
    return BackendDriverDispatchMinPrintBuildPlanFromCmdline()

fn BackendDriverDispatchMinHelp(): int32 =
    BackendDriverDispatchMinPrintLine("usage: cheng <command> [args]")
    BackendDriverDispatchMinPrintLine("core commands: status, print-build-plan, dry-compile, system-link-exec, run-case, emit-csg, parse-receipt, vpn-proxy, run-host-smokes compiler_csg_egraph_active_contract_smoke thread_atomic_orc_runtime_gate_smoke std_file_io_smoke")
    return 0

@borrows
fn BackendDriverDispatchMinCurrentCompiler(rootDir: str): str =
    let noHandoffText = strutil.Strip(os.GetEnv("CHENG_NO_BACKEND_DRIVER_HANDOFF"))
    let noHandoffForced = len(noHandoffText) > 0 && noHandoffText != "0"
    if noHandoffForced:
        let stage3 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage3")
        if chengpath.FileExistsNonEmpty(rootDir, stage3):
            return stage3
        let stage0 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage0")
        if chengpath.FileExistsNonEmpty(rootDir, stage0):
            return stage0
    var raw: str
    BackendDriverDispatchMinParamStrInto(0, raw)
    if len(raw) > 0:
        let current = chengpath.PathAbsolute(rootDir, raw)
        if chengpath.FileExistsNonEmpty(rootDir, current):
            return current
    let handoffText = strutil.Strip(os.GetEnv("CHENG_BACKEND_DRIVER_HANDOFF"))
    let handoffEnabled = len(handoffText) > 0 && handoffText != "0"
    if handoffEnabled:
        let driver = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng")
        if chengpath.FileExistsNonEmpty(rootDir, driver):
            return driver
    let handoffDisabled = !handoffEnabled
    if handoffDisabled:
        let stage3 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage3")
        if chengpath.FileExistsNonEmpty(rootDir, stage3):
            return stage3
        let stage0 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage0")
        if chengpath.FileExistsNonEmpty(rootDir, stage0):
            return stage0
    return ""

@borrows
fn BackendDriverDispatchMinArtifactsDir(rootDir: str): str =
    let custom = os.GetEnv("VERIFY_EXPORT_VISIBILITY_DIR")
    if len(custom) > 0:
        return chengpath.PathAbsolute(rootDir, custom)
    return chengpath.PathAbsolute(rootDir, "artifacts/forward/verify_export_visibility")

@borrows
fn BackendDriverDispatchMinEnsureDir(rootDir: str,
                                      dirPath: str): bool =
    if chengpath.MkdirP(rootDir, dirPath):
        return true
    BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: failed to create dir: {dirPath}")
    return false

@borrows
fn BackendDriverDispatchMinWriteManifest(rootDir: str,
                                          packageRoot: str,
                                          packageId: str,
                                          modulePrefix: str): bool =
    let manifestPath = chengpath.PathJoin(packageRoot, "cheng-package.toml")
    let manifestText = Fmt"package_id = \"{packageId}\"\nmodule_prefix = \"{modulePrefix}\"\n"
    if chengpath.WriteTextFile(rootDir, manifestPath, manifestText):
        return true
    BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: failed to write manifest: {manifestPath}")
    return false

@borrows
fn BackendDriverDispatchMinExecShell(command: str,
                                      workingDir: str): os.ExecCmdResult =
    var argv: str[]
    add(argv, "-c")
    add(argv, strings.CloneStr(command))
    var envs: str[]
    return hostos.ExecFileCapture(
        "/bin/sh", argv, envs, strings.CloneStr(workingDir), true, 0)

@borrows
fn BackendDriverDispatchMinExecShellInto(command: str,
                                          workingDir: str,
                                          outText: var str): int32 =
    let run = BackendDriverDispatchMinExecShell(command, workingDir)
    if run == nil:
        return 2
    outText = strings.CloneStr(run.output)
    return run.exitCode

@borrows
fn BackendDriverDispatchMinCompileFixture(rootDir: str,
                                           compilerPath: str,
                                           packageRoot: str,
                                           inputPath: str,
                                           outPath: str,
                                           logPath: str,
                                           outOutput: var str): int32 =
    let reportPath = Fmt"{outPath}.report.txt"
    let compilerQ = strings.CloneStr(os.QuoteShell(strings.CloneStr(compilerPath)))
    let packageQ = strings.CloneStr(os.QuoteShell(strings.CloneStr(packageRoot)))
    let inputQ = strings.CloneStr(os.QuoteShell(strings.CloneStr(inputPath)))
    let outQ = strings.CloneStr(os.QuoteShell(strings.CloneStr(outPath)))
    let reportQ = strings.CloneStr(os.QuoteShell(strings.CloneStr(reportPath)))
    let command = Fmt"CHENG_PROGRESS=1 PROGRESS=1 CHENG_PROCESS_MAX_RSS_BYTES=805306368 {compilerQ} system-link-exec --root:{packageQ} --in:{inputQ} --emit:exe --target:arm64-apple-darwin --out:{outQ} --report-out:{reportQ}"
    let code = BackendDriverDispatchMinExecShellInto(command, rootDir, outOutput)
    let logText = strings.CloneStr(outOutput)
    let _ = chengpath.WriteTextFile(rootDir, logPath, logText)
    return code

fn BackendDriverDispatchMinProviderModuleSafeName(modulePath: str): str =
    if modulePath == "runtime/compiler_runtime":
        return "runtime_compiler_runtime"
    if modulePath == "runtime/core_runtime":
        return "runtime_core_runtime"
    if modulePath == "runtime/debug_runtime":
        return "runtime_debug_runtime"
    if modulePath == "runtime/program_support":
        return "runtime_program_support"
    if modulePath == "runtime/program_support_get_env_bridge":
        return "runtime_program_support_get_env_bridge"
    if modulePath == "runtime/program_support_host_runtime":
        return "runtime_program_support_host_runtime"
    var out = "module"
    for i in 0..<modulePath.len:
        let c = modulePath[i]
        if (c >= 'a' && c <= 'z') ||
           (c >= 'A' && c <= 'Z') ||
           (c >= '0' && c <= '9') ||
           c == '_':
            out = Fmt"{out}{strings.CharToStr(c)}"
        else:
            out = Fmt"{out}_"
    return out

fn BackendDriverDispatchMinProviderSourcePath(rootDir: str,
                                               linkPlan: var slplan.SystemLinkPlanStub,
                                               modulePath: str): str =
    if modulePath == "runtime/compiler_runtime":
        return chengpath.PathAbsolute(rootDir, "src/core/runtime/compiler_runtime_link_provider.cheng")
    if modulePath == "runtime/core_runtime":
        if tmat.TargetIsDarwin(linkPlan.targetTriple):
            return chengpath.PathAbsolute(rootDir, "src/core/runtime/core_runtime_provider_darwin.cheng")
        return chengpath.PathAbsolute(rootDir, "src/core/runtime/core_runtime_provider_linux.cheng")
    if modulePath == "runtime/debug_runtime":
        return chengpath.PathAbsolute(rootDir, "src/core/runtime/debug_runtime_provider.cheng")
    if modulePath == "runtime/program_support":
        return chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_backend.cheng")
    if modulePath == "runtime/program_support_get_env_bridge":
        return chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_get_env_bridge.cheng")
    if modulePath == "runtime/program_support_host_runtime":
        return chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_host_runtime.cheng")
    var sourceModulePath = strutil.Strip(modulePath)
    if strutil.StartsWith(sourceModulePath, "cheng/"):
        sourceModulePath = strings.DropPrefix(sourceModulePath, "cheng/")
    return chengpath.PathAbsolute(rootDir, strutil.Join(["src/", sourceModulePath, ".cheng"], ""))

@borrows
fn BackendDriverDispatchMinDarwinProviderSourceLeak(targetTriple: str,
                                                     sourcePath: str): bool =
    if !tmat.TargetIsDarwin(targetTriple):
        return false
    if chengpath.TextContains(sourcePath, "core_runtime_provider_linux.cheng"):
        return true
    if chengpath.TextContains(sourcePath, "system_helpers_backend_nolibc_linux_aarch64.cheng"):
        return true
    return false

@borrows
fn BackendDriverDispatchMinProgramSupportRootCandidate(symbol: str): bool =
    let root = BackendDriverDispatchMinPublicRootName(symbol)
    if BackendDriverDispatchMinProgramSupportHostRuntimeOwns(root):
        return false
    if strings.StrContains(root, "debug_profile_flush_from_argv0"):
        return false
    if strings.StrContains(root, "native_register_line_map_from_argv0"):
        return false
    if root == "driver_c_get_env_bridge":
        return false
    if root == "system_ptr_add":
        return false
    if strings.StrContains(root, "__L"):
        return false
    if root == "c_iometer_call":
        return true
    if root == "assert" || root == "Assert":
        return true
    if root == "cheng_fopen":
        return true
    if root == "cheng_fflush":
        return true
    if root == "cheng_strutils_join_bridge":
        return true
    # runtime 桥根批: primary lowering 会发射对这些 @exportc 运行时桥的直接引用
    # (标量→str / panic / atomic / rawbytes / memcpy / 文件句柄 / exec capture),
    # formal system_link_exec_runtime provider roots 清单全含;
    # provider export roots 漏任一时 program_support 编过但链接期 unresolved。
    # 2408 取址边修后逐层暴露 (先 i32_to_str 再 panic), 按 primary-undef ∖
    # provider-def 集合差一次补齐 (wave-35), 绝根不在此: 候选门只对 primary
    # relocs 真实引用的符号放行 (AddRootIfReferenced), 不会过度导出。
    if root == "cheng_i32_to_str_bridge" ||
       root == "cheng_i64_to_str_bridge" ||
       root == "cheng_u64_to_str_bridge" ||
       root == "cheng_char_to_str_bridge" ||
       root == "cheng_panic_cstring_and_exit" ||
       strutil.StartsWith(root, "cheng_atomic_") ||
       strutil.StartsWith(root, "cheng_exec_program_capture") ||
       root == "cheng_fclose" ||
       root == "cheng_file_mtime" ||
       root == "cheng_memcpy" ||
       strutil.StartsWith(root, "cheng_rawbytes_"):
        return true
    # libc 薄封装 wrapper (@exportc 在 program_support_backend: libc_open :8474 /
    # libc_close :6138 / get_stderr :7609): primary 直引, 同批集合差成员。
    if root == "libc_open" ||
       root == "libc_close" ||
       root == "get_stderr":
        return true
    if root == "cheng_memcmp":
        return true
    if strutil.StartsWith(root, "cheng_file_handle_"):
        return true
    if strutil.StartsWith(root, "cheng_os_") &&
       strings.StrContains(root, "_bridge"):
        return true
    if root == "cheng_system_entropy_fill":
        return true
    if strutil.StartsWith(root, "cheng_udp_"):
        return true
    if root == "cheng_tcp_connect_host_port_bridge":
        return true
    if strutil.StartsWith(root, "cheng_tcp_"):
        return true
    if strutil.StartsWith(root, "cheng_seq_"):
        return true
    if strutil.StartsWith(root, "driver_c_") ||
       strutil.StartsWith(root, "cheng_mem_"):
        return true
    if strutil.StartsWith(root, "__cheng"):
        return true
    if root == "alloc" ||
       root == "copyMem" ||
       root == "setMem" ||
       root == "ptr_add" ||
       root == "store_ptr" ||
       root == "load_ptr" ||
       root == "store_int32" ||
       root == "load_int32" ||
       root == "paramCount" ||
       root == "paramStr" ||
       root == "cheng_malloc" ||
       root == "cheng_realloc" ||
       root == "cheng_free":
        return true
    return false

@borrows
fn BackendDriverDispatchMinCopyFileBytes(rootDir: str, fromPath: str, toPath: str): bool =
    let absFrom = chengpath.PathAbsolute(rootDir, fromPath)
    var buf = bytes.ReadFileBytes(absFrom)
    defer:
        bytes.FreeByteBuffer(buf)
    if buf.data == nil || buf.len <= 0:
        return false
    var raw = rawbytes.BytesAlloc(buf.len)
    defer:
        rawbytes.BytesFree(raw)
    if raw.data == nil:
        return false
    rawmem_support.RawmemCopy(raw.data, buf.data, buf.len)
    return LinkerCoreWriteRawBytesAtomic(chengpath.PathAbsolute(rootDir, toPath), raw)

@borrows
fn BackendDriverDispatchMinWriteTextAtomic(rootDir: str,
                                           path: str,
                                           content: str): bool =
    var raw = rawbytes.BytesAlloc(len(content))
    defer:
        rawbytes.BytesFree(raw)
    if rawbytes.BytesLen(raw) != len(content):
        return false
    for i in 0..<len(content):
        rawbytes.BytesSet(raw, i, int32(content[i]) & 255)
    return LinkerCoreWriteRawBytesAtomic(chengpath.PathAbsolute(rootDir, path), raw)

@borrows
fn BackendDriverDispatchMinFileSha256Hex(rootDir: str,
                                         path: str,
                                         outHex: var str): bool =
    outHex = ""
    let absPath = chengpath.PathAbsolute(rootDir, path)
    var buf = bytes.ReadFileBytes(absPath)
    defer:
        bytes.FreeByteBuffer(buf)
    if buf.data == nil || buf.len <= 0:
        return false
    var raw = rawbytes.BytesAlloc(buf.len)
    defer:
        rawbytes.BytesFree(raw)
    if raw.data == nil:
        return false
    rawmem_support.RawmemCopy(raw.data, buf.data, buf.len)
    var digest = sha256.Sha256Digest(raw)
    defer:
        rawbytes.BytesFree(digest)
    outHex = rawbytes.BytesToHex(digest)
    return len(outHex) == 64

fn BackendDriverDispatchMinHostFstatIdentity(
        fd: int32,
        out: var BackendDriverDispatchMinHostFileIdentity): bool =
    if fd < 0:
        return false
    var next: BackendDriverDispatchMinHostFileIdentity
    let rc = BackendDriverDispatchMinHostFstatIdentityBridge(
        fd,
        next.size,
        next.mode,
        next.device,
        next.inode,
        next.mtimeSec,
        next.mtimeNsec,
        next.ctimeSec,
        next.ctimeNsec,
        next.changeVersion)
    if rc != 0 || next.size <= 0 ||
       (next.mode & int32(61440)) != int32(32768) ||
       next.device == uint64(0) || next.inode == uint64(0):
        return false
    out = next
    return true

fn BackendDriverDispatchMinHostFileIdentityEqual(
        left: BackendDriverDispatchMinHostFileIdentity,
        right: BackendDriverDispatchMinHostFileIdentity): bool =
    return left.size == right.size &&
           left.mode == right.mode &&
           left.device == right.device &&
           left.inode == right.inode &&
           left.mtimeSec == right.mtimeSec &&
           left.mtimeNsec == right.mtimeNsec &&
           left.ctimeSec == right.ctimeSec &&
           left.ctimeNsec == right.ctimeNsec &&
           left.changeVersion == right.changeVersion

fn BackendDriverDispatchMinReadStablePinnedFileSha256Hex(
        rootDir: str,
        path: str,
        outHex: var str): bool =
    outHex = ""
    let absolutePath = chengpath.PathAbsolute(rootDir, path)
    let canonicalBeforeRes = fs.Realpath(absolutePath)
    if !canonicalBeforeRes.ok || canonicalBeforeRes.value != absolutePath:
        return false
    let pathCString: cstring = system.StrToCStringTemp(absolutePath)
    let fd = BackendDriverDispatchMinOpenReadBridge(pathCString, int32(0), int32(0))
    if fd < 0:
        return false
    var before: BackendDriverDispatchMinHostFileIdentity
    var after: BackendDriverDispatchMinHostFileIdentity
    var digest: str
    let fdPath = Fmt"/dev/fd/{fd}"
    var pinnedOk = BackendDriverDispatchMinHostFstatIdentity(fd, before)
    if pinnedOk:
        pinnedOk = BackendDriverDispatchMinFileSha256Hex("", fdPath, digest)
    if pinnedOk:
        pinnedOk = BackendDriverDispatchMinHostFstatIdentity(fd, after)
    let closeRc = BackendDriverDispatchMinCloseBridge(fd)
    if !pinnedOk || closeRc != 0 ||
       !BackendDriverDispatchMinHostFileIdentityEqual(before, after):
        return false
    let verifyFd = BackendDriverDispatchMinOpenReadBridge(pathCString,
                                                           int32(0),
                                                           int32(0))
    if verifyFd < 0:
        return false
    var current: BackendDriverDispatchMinHostFileIdentity
    let currentOk = BackendDriverDispatchMinHostFstatIdentity(verifyFd,
                                                               current)
    let verifyCloseRc = BackendDriverDispatchMinCloseBridge(verifyFd)
    let canonicalAfterRes = fs.Realpath(absolutePath)
    if !currentOk || verifyCloseRc != 0 || !canonicalAfterRes.ok ||
       canonicalAfterRes.value != absolutePath ||
       !BackendDriverDispatchMinHostFileIdentityEqual(before, current):
        return false
    outHex = digest
    return len(outHex) == 64

@borrows
fn BackendDriverDispatchMinLoadUnsignedLe(raw: rawbytes.Bytes,
                                          offset: int32,
                                          width: int32): uint64 =
    var out: uint64
    var i: int32
    while i < width:
        let value = uint64(rawbytes.BytesGet(raw, offset + i) & 255)
        out = out | (value << uint64(i * 8))
        i = i + 1
    return out

fn BackendDriverDispatchMinPathIsDevFd(path: var str): bool =
    if path.len <= 8:
        return false
    return strings.SliceBytes(path, 0, 8) == "/dev/fd/"

@borrows
fn BackendDriverDispatchMinFileSnapshotStat(rootDir: str,
                                            path: str,
                                            out: var BackendDriverDispatchMinFileSnapshot): bool =
    var absolutePath = chengpath.PathAbsolute(rootDir, path)
    # macOS fdesc: realpath(3) 对 /dev/fd/N 返回展示用假名 /dev/fd/<basename>,
    # 该假名不可回 stat (ENOENT) —— fd 引用本身已是规范形式, 跳过 realpath
    # 直接 stat 数字 fd 路径。普通路径维持 realpath 规范化不变。
    var canonicalPath = strings.CloneStr(absolutePath)
    if !BackendDriverDispatchMinPathIsDevFd(absolutePath):
        let canonicalRes = fs.Realpath(absolutePath)
        if !canonicalRes.ok:
            return false
        canonicalPath = canonicalRes.value
    out.path = canonicalPath
    var statBytes = rawbytes.BytesAlloc(144)
    if statBytes.data == nil || statBytes.len != 144:
        rawbytes.BytesFree(statBytes)
        return false
    let pathCString: cstring = system.StrToCStringTemp(out.path)
    let statRc = BackendDriverDispatchMinStatBridge(pathCString, statBytes.data)
    if statRc != 0:
        rawbytes.BytesFree(statBytes)
        return false
    let mode = BackendDriverDispatchMinLoadUnsignedLe(statBytes, 4, 2)
    if (mode & uint64(61440)) != uint64(32768):
        rawbytes.BytesFree(statBytes)
        return false
    out.device = strings.Uint64ToStr(BackendDriverDispatchMinLoadUnsignedLe(statBytes, 0, 4))
    out.inode = strings.Uint64ToStr(BackendDriverDispatchMinLoadUnsignedLe(statBytes, 8, 8))
    out.mtimeSec = strings.Uint64ToStr(BackendDriverDispatchMinLoadUnsignedLe(statBytes, 48, 8))
    out.mtimeNsec = strings.Uint64ToStr(BackendDriverDispatchMinLoadUnsignedLe(statBytes, 56, 8))
    out.ctimeSec = strings.Uint64ToStr(BackendDriverDispatchMinLoadUnsignedLe(statBytes, 64, 8))
    out.ctimeNsec = strings.Uint64ToStr(BackendDriverDispatchMinLoadUnsignedLe(statBytes, 72, 8))
    out.size = strings.Uint64ToStr(BackendDriverDispatchMinLoadUnsignedLe(statBytes, 96, 8))
    rawbytes.BytesFree(statBytes)
    return true

@borrows
fn BackendDriverDispatchMinFileSnapshotIdentityEqual(a: BackendDriverDispatchMinFileSnapshot,
                                                      b: BackendDriverDispatchMinFileSnapshot): bool =
    return a.path == b.path &&
           a.device == b.device &&
           a.inode == b.inode &&
           a.size == b.size &&
           a.mtimeSec == b.mtimeSec &&
           a.mtimeNsec == b.mtimeNsec &&
           a.ctimeSec == b.ctimeSec &&
           a.ctimeNsec == b.ctimeNsec

@borrows
fn BackendDriverDispatchMinFileSnapshotEqual(a: BackendDriverDispatchMinFileSnapshot,
                                              b: BackendDriverDispatchMinFileSnapshot): bool =
    return BackendDriverDispatchMinFileSnapshotIdentityEqual(a, b) &&
           a.sha256 == b.sha256

@borrows
fn BackendDriverDispatchMinReadStableFileSnapshot(rootDir: str,
                                                   path: str,
                                                   out: var BackendDriverDispatchMinFileSnapshot): bool =
    var before: BackendDriverDispatchMinFileSnapshot
    var after: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinFileSnapshotStat(rootDir, path, before):
        return false
    var digest: str
    if !BackendDriverDispatchMinFileSha256Hex(rootDir, path, digest):
        return false
    if !BackendDriverDispatchMinFileSnapshotStat(rootDir, path, after):
        return false
    if !BackendDriverDispatchMinFileSnapshotIdentityEqual(before, after):
        return false
    after.sha256 = digest
    out = after
    return true

fn BackendDriverDispatchMinCloseFdList(fds: var int32[]): bool =
    var ok = true
    for i in 0..<fds.len:
        if fds[i] >= 0 && BackendDriverDispatchMinCloseBridge(fds[i]) != 0:
            ok = false
    fds = []
    return ok

fn BackendDriverDispatchMinCloseFdListDeferred(fds: var int32[]) =
    let _ = BackendDriverDispatchMinCloseFdList(fds)

fn BackendDriverDispatchMinCloseProviderStagePins(out: var BackendDriverDispatchMinProviderBundle): bool =
    var ok = true
    for i in 0..<out.providerStagePinnedFds.len:
        let fd = out.providerStagePinnedFds[i]
        if fd >= 0:
            if BackendDriverDispatchMinCloseBridge(fd) != 0:
                ok = false
    for i in 0..<out.providerObjectPinnedFds.len:
        let fd = out.providerObjectPinnedFds[i]
        if fd >= 0:
            if BackendDriverDispatchMinCloseBridge(fd) != 0:
                ok = false
    out.providerStagePinnedFds = []
    out.providerStagePinnedPaths = []
    out.providerStagePinnedObjectPaths = []
    out.providerObjectPinnedFds = []
    return ok

fn BackendDriverDispatchMinCloseProviderStagePinsDeferred(out: var BackendDriverDispatchMinProviderBundle) =
    let _ = BackendDriverDispatchMinCloseProviderStagePins(out)

fn BackendDriverDispatchMinRewindProviderStagePins(out: var BackendDriverDispatchMinProviderBundle): bool =
    for i in 0..<out.providerStagePinnedFds.len:
        let fd = out.providerStagePinnedFds[i]
        if fd < 0 || BackendDriverDispatchMinSeekBridge(fd, Int64(0), 0) != Int64(0):
            return false
    for i in 0..<out.providerObjectPinnedFds.len:
        let fd = out.providerObjectPinnedFds[i]
        if fd < 0 || BackendDriverDispatchMinSeekBridge(fd, Int64(0), 0) != Int64(0):
            return false
    return true

@borrows
fn BackendDriverDispatchMinPinFileSnapshotFlags(rootDir: str,
                                                expected: BackendDriverDispatchMinFileSnapshot,
                                                openFlags: int32,
                                                outFd: var int32,
                                                outPinnedPath: var str): bool =
    outFd = -1
    outPinnedPath = ""
    let absolutePath = chengpath.PathAbsolute(rootDir, expected.path)
    let fd = BackendDriverDispatchMinOpenReadBridge(
        system.StrToCStringTemp(absolutePath),
        openFlags,
        0)
    if fd < 0:
        return false
    let pinnedPath = Fmt"/dev/fd/{fd}"
    if BackendDriverDispatchMinSeekBridge(fd, Int64(0), 0) != Int64(0):
        let _ = BackendDriverDispatchMinCloseBridge(fd)
        return false
    var observed: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(rootDir, pinnedPath, observed):
        let _ = BackendDriverDispatchMinCloseBridge(fd)
        return false
    observed.path = expected.path
    # macOS fdesc: stat(/dev/fd/N) 的 st_dev 是 fdesc 虚拟文件系统的 device
    # (实测 3607505669), 与原路径所在卷 device (如 16777230) 结构性不等 ——
    # 与窗口期漂移无关, 每个经 /dev/fd 重读的快照都挂在 device 字段。
    # fd 在 open 时已钉住 vnode (TOCTOU 防护由 fd 本身承担), 同一性由
    # inode+size+mtime+ctime+sha256 继续作证; device 在 fdesc 命名空间下
    # 无真实卷语义, 比对前回填为 expected 的 device。
    observed.device = expected.device
    if !BackendDriverDispatchMinFileSnapshotEqual(observed, expected) ||
       BackendDriverDispatchMinSeekBridge(fd, Int64(0), 0) != Int64(0):
        let _ = BackendDriverDispatchMinCloseBridge(fd)
        return false
    outFd = fd
    outPinnedPath = pinnedPath
    return true

@borrows
fn BackendDriverDispatchMinPinFileSnapshot(rootDir: str,
                                           expected: BackendDriverDispatchMinFileSnapshot,
                                           outFd: var int32,
                                           outPinnedPath: var str): bool =
    # Darwin O_CLOEXEC | O_NOFOLLOW. Strict provider manifests are Darwin arm64 only.
    return BackendDriverDispatchMinPinFileSnapshotFlags(rootDir,
                                                        expected,
                                                        16777472,
                                                        outFd,
                                                        outPinnedPath)

@borrows
fn BackendDriverDispatchMinPinnedSnapshotMatches(rootDir: str,
                                                 fd: int32,
                                                 pinnedPath: str,
                                                 expected: BackendDriverDispatchMinFileSnapshot): bool =
    if fd < 0 || len(pinnedPath) <= 0 ||
       BackendDriverDispatchMinSeekBridge(fd, Int64(0), 0) != Int64(0):
        return false
    var observed: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(rootDir, pinnedPath, observed):
        return false
    observed.path = expected.path
    if !BackendDriverDispatchMinFileSnapshotEqual(observed, expected):
        return false
    return BackendDriverDispatchMinSeekBridge(fd, Int64(0), 0) == Int64(0)

@borrows
fn BackendDriverDispatchMinProviderStageManifestLineCount(text: str): int32 =
    if len(text) <= 0 || text[len(text) - 1] != '\n':
        return -1
    let lines = strutil.Split(text, '\n')
    var count: int32
    for i in 0..<lines.len:
        let line = lines[i]
        if len(line) <= 0:
            if i != lines.len - 1:
                return -1
            continue
        var equalIndex: int32 = -1
        for j in 0..<line.len:
            let ch = line[j]
            if ch == '\r' || ch == '\t' || int32(ch) == 31:
                return -1
            if ch == '=' && equalIndex < 0:
                equalIndex = j
        if equalIndex <= 0:
            return -1
        for j in 0..<equalIndex:
            let ch = line[j]
            if !((ch >= 'a' && ch <= 'z') ||
                 (ch >= '0' && ch <= '9') ||
                 ch == '_'):
                return -1
        count = count + 1
    return count

@borrows
fn BackendDriverDispatchMinProviderStageManifestValue(text: str,
                                                       key: str,
                                                       out: var str): bool =
    out = ""
    let lines = strutil.Split(text, '\n')
    var found: bool
    for i in 0..<lines.len:
        let line = lines[i]
        if len(line) <= len(key) || line[len(key)] != '=':
            continue
        var matches = true
        for j in 0..<len(key):
            if line[j] != key[j]:
                matches = false
                break
        if matches:
            if found:
                return false
            found = true
            out = chengpath.TextSlice(line, len(key) + 1, len(line) - len(key) - 1)
    return found

@borrows
fn BackendDriverDispatchMinProviderStageManifestExpected(text: str,
                                                          key: str,
                                                          expected: str): bool =
    var value: str
    return BackendDriverDispatchMinProviderStageManifestValue(text, key, value) &&
           value == expected

@borrows
fn BackendDriverDispatchMinProviderStageSnapshotMatches(text: str,
                                                        prefix: str,
                                                        snapshot: BackendDriverDispatchMinFileSnapshot): bool =
    return BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_path", snapshot.path) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_sha256", snapshot.sha256) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_device", snapshot.device) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_inode", snapshot.inode) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_size", snapshot.size) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_mtime_sec", snapshot.mtimeSec) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_mtime_nsec", snapshot.mtimeNsec) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_ctime_sec", snapshot.ctimeSec) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_ctime_nsec", snapshot.ctimeNsec)

@borrows
fn BackendDriverDispatchMinProviderStageSnapshotEmpty(text: str,
                                                      prefix: str): bool =
    return BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_path", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_sha256", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_device", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_inode", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_size", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_mtime_sec", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_mtime_nsec", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_ctime_sec", "") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, Fmt"{prefix}_ctime_nsec", "")

@borrows
fn BackendDriverDispatchMinProviderCacheHex(keyText: str): str =
    var raw = rawbytes.BytesAlloc(len(keyText))
    defer:
        rawbytes.BytesFree(raw)
    if raw.data == nil:
        return ""
    for i in 0..<len(keyText):
        rawbytes.BytesSet(raw, i, int32(keyText[i]) & 255)
    var digest = sha256.Sha256Digest(raw)
    defer:
        rawbytes.BytesFree(digest)
    let out = rawbytes.BytesToHex(digest)
    return out

fn BackendDriverDispatchMinProviderCacheMode(): str =
    return strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--provider-cache-mode", "allow-build"))

fn BackendDriverDispatchMinProviderCacheDirectory(): str =
    return strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--provider-cache-dir",
                                                                   "artifacts/backend_driver/provider_cache"))

fn BackendDriverDispatchMinProviderCacheAppendField(out: var str,
                                                     name: str,
                                                     value: str) =
    out = Fmt"{out}|{len(name)}:{name}|{len(value)}:{value}"

fn BackendDriverDispatchMinProviderCacheKeyFromContent(compilerSha256: str,
                                                       closureCid: str,
                                                       targetTriple: str,
                                                       modulePath: str,
                                                       exportRootsText: str): str =
    var material = "provider_cache_content"
    BackendDriverDispatchMinProviderCacheAppendField(material, "compiler_sha256", compilerSha256)
    BackendDriverDispatchMinProviderCacheAppendField(material, "provider_closure_cid", closureCid)
    BackendDriverDispatchMinProviderCacheAppendField(material, "target", targetTriple)
    BackendDriverDispatchMinProviderCacheAppendField(material, "module", modulePath)
    BackendDriverDispatchMinProviderCacheAppendField(material, "export_roots", exportRootsText)
    return BackendDriverDispatchMinProviderCacheHex(material)

@borrows
fn BackendDriverDispatchMinProviderClosureCid(driverRoot: str,
                                              linkPlan: slplan.SystemLinkPlanStub,
                                              sourcePath: str,
                                              outCid: var str,
                                              outSourcePaths: var str[],
                                              outErr: var str): bool =
    outCid = ""
    outSourcePaths = []
    outErr = ""
    let providerRoot = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe("", driverRoot))
    var externalPackageRoots = linkPlan.externalPackageRoots
    if externalPackageRoots.len <= 0:
        externalPackageRoots = BackendDriverDispatchMinDefaultExternalPackageRoots(providerRoot,
                                                                                   providerRoot)
    var sourcePaths: str[]
    var importEdges: parser.ImportEdge[]
    var importEdgeCount: int32
    var unresolvedImportCount: int32
    if !BackendDriverDispatchMinDryCompileCollectSourceClosure(providerRoot,
                                                               providerRoot,
                                                               sourcePath,
                                                               externalPackageRoots,
                                                               sourcePaths,
                                                               importEdges,
                                                               importEdgeCount,
                                                               unresolvedImportCount,
                                                               outErr):
        return false
    if sourcePaths.len <= 0 || unresolvedImportCount != 0:
        outErr = "backend driver direct: provider source closure is incomplete"
        return false
    var cid: layout.FixedBytes32
    if !cworld.CompilerWorldSourceBundleCidWithExternalPackageRootsInto("cheng",
                                                                        providerRoot,
                                                                        providerRoot,
                                                                        externalPackageRoots,
                                                                        sourcePaths,
                                                                        cid):
        outErr = "backend driver direct: provider source closure cid unavailable"
        return false
    outCid = layout.FixedBytes32Hex(cid)
    outSourcePaths = sourcePaths
    return len(outCid) == 64

@borrows
fn BackendDriverDispatchMinProviderPlanValueSafe(value: str): bool =
    for i in 0..<value.len:
        if value[i] == '\n' || value[i] == '\r' || value[i] == '\t' || int32(value[i]) == 31:
            return false
    return true

@borrows
fn BackendDriverDispatchMinSha256TextValid(value: str): bool =
    if value.len != 64:
        return false
    for i in 0..<value.len:
        let c = value[i]
        if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')):
            return false
    return true

fn BackendDriverDispatchMinRegallocManifestPath(driverRoot: str,
                                                 reportPath: str): str =
    let reportAbs = chengpath.PathAbsolute(driverRoot, reportPath)
    let workDir = chengpath.PathParentDir(reportAbs)
    if len(reportAbs) <= 0 || len(workDir) <= 0:
        return ""
    return chengpath.PathJoin(workDir, "current-source-manifest.txt")

fn BackendDriverDispatchMinRegallocReceiptField(
        reportLines: var str[],
        hashParts: var str[],
        key: str,
        value: str) =
    let line = Fmt"{key}={value}"
    add(reportLines, strings.CloneStr(line))
    add(hashParts, Fmt"{line}\n")

@borrows
fn BackendDriverDispatchMinProviderCompileInputsCurrent(rootDir: str,
                                                        compilerPath: str,
                                                        linkPlan: slplan.SystemLinkPlanStub,
                                                        task: BackendDriverDispatchMinProviderCompileTask): bool =
    var compilerSha256: str
    if !BackendDriverDispatchMinFileSha256Hex(rootDir,
                                              compilerPath,
                                              compilerSha256) ||
       compilerSha256 != task.compilerSha256:
        return false
    var closureCid: str
    var closureSourcePaths: str[]
    var closureErr: str
    return BackendDriverDispatchMinProviderClosureCid(rootDir,
                                                      linkPlan,
                                                      task.sourcePath,
                                                      closureCid,
                                                      closureSourcePaths,
                                                      closureErr) &&
           closureCid == task.closureCid

@borrows
fn BackendDriverDispatchMinPinProviderCompileInputs(rootDir: str,
                                                    compilerPath: str,
                                                    linkPlan: slplan.SystemLinkPlanStub,
                                                    task: BackendDriverDispatchMinProviderCompileTask,
                                                    outCompilerPath: var str,
                                                    outFds: var int32[],
                                                    outPinnedPaths: var str[]): bool =
    outCompilerPath = strings.CloneStr(compilerPath)
    outFds = []
    outPinnedPaths = []
    if !BackendDriverDispatchMinProviderCompileInputsCurrent(rootDir,
                                                             compilerPath,
                                                             linkPlan,
                                                             task):
        return false
    if !tmat.TargetIsDarwin(linkPlan.targetTriple):
        return true
    if task.compilerSnapshot.sha256 != task.compilerSha256 ||
       task.closureSourceSnapshots.len <= 0:
        return false
    var compilerFd: int32
    var compilerPinnedPath: str
    # Darwin O_NOFOLLOW without O_CLOEXEC: the child executes these pinned bytes.
    if !BackendDriverDispatchMinPinFileSnapshotFlags(rootDir,
                                                     task.compilerSnapshot,
                                                     256,
                                                     compilerFd,
                                                     compilerPinnedPath):
        return false
    add(outFds, compilerFd)
    add(outPinnedPaths, compilerPinnedPath)
    # macOS 内核禁止经 /dev/fd/N execve Mach-O (O_RDONLY/O_EXEC 均 EACCES,
    # 本机 C 实证) —— compilerPinnedPath 不能作子进程命令行。exec 改用真实
    # 路径, 临 exec 前对路径再取一次快照与钉住快照逐字段比对
    # (device+inode+size+mtime 一致 ⇒ 路径仍指向钉住 fd 的同一 inode),
    # 把 TOCTOU 窗口压到复核与 exec 之间; 编译后另有
    # RevalidateProviderCompileInputs 全量复核兜底。钉住 fd 继续保留在
    # outFds 里, 全程持有 inode。
    var compilerRecheck: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinFileSnapshotStat(rootDir,
                                                 compilerPath,
                                                 compilerRecheck) ||
       compilerRecheck.device != task.compilerSnapshot.device ||
       compilerRecheck.inode != task.compilerSnapshot.inode ||
       compilerRecheck.size != task.compilerSnapshot.size ||
       compilerRecheck.mtimeSec != task.compilerSnapshot.mtimeSec ||
       compilerRecheck.mtimeNsec != task.compilerSnapshot.mtimeNsec:
        let _ = BackendDriverDispatchMinCloseFdList(outFds)
        outPinnedPaths = []
        return false
    outCompilerPath = compilerPath
    for i in 0..<task.closureSourceSnapshots.len:
        var sourceFd: int32
        var sourcePinnedPath: str
        if !BackendDriverDispatchMinPinFileSnapshot(rootDir,
                                                    task.closureSourceSnapshots[i],
                                                    sourceFd,
                                                    sourcePinnedPath):
            let _ = BackendDriverDispatchMinCloseFdList(outFds)
            outPinnedPaths = []
            return false
        add(outFds, sourceFd)
        add(outPinnedPaths, sourcePinnedPath)
    return true

@borrows
fn BackendDriverDispatchMinRevalidateProviderCompileInputs(rootDir: str,
                                                           compilerPath: str,
                                                           linkPlan: slplan.SystemLinkPlanStub,
                                                           task: BackendDriverDispatchMinProviderCompileTask,
                                                           pinnedFds: var int32[],
                                                           pinnedPaths: var str[]): bool =
    if !BackendDriverDispatchMinProviderCompileInputsCurrent(rootDir,
                                                             compilerPath,
                                                             linkPlan,
                                                             task):
        return false
    if !tmat.TargetIsDarwin(linkPlan.targetTriple):
        return true
    if pinnedFds.len != task.closureSourceSnapshots.len + 1 ||
       pinnedPaths.len != pinnedFds.len ||
       !BackendDriverDispatchMinPinnedSnapshotMatches(rootDir,
                                                      pinnedFds[0],
                                                      pinnedPaths[0],
                                                      task.compilerSnapshot):
        return false
    for i in 0..<task.closureSourceSnapshots.len:
        if !BackendDriverDispatchMinPinnedSnapshotMatches(rootDir,
                                                          pinnedFds[i + 1],
                                                          pinnedPaths[i + 1],
                                                          task.closureSourceSnapshots[i]):
            return false
    return true

@borrows
fn BackendDriverDispatchMinProviderCacheBindingText(task: BackendDriverDispatchMinProviderCompileTask,
                                                    targetTriple: str,
                                                    objectSnapshot: BackendDriverDispatchMinFileSnapshot,
                                                    reportSnapshot: BackendDriverDispatchMinFileSnapshot): str =
    var out: str
    BackendDriverDispatchMinAppendLine(out, "provider_cache_binding_schema=backend_driver_provider_cache_binding")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_key={task.cacheKey}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_kind={task.kind}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_module={task.modulePath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_target={targetTriple}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_compiler_sha256={task.compilerSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_closure_cid={task.closureCid}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_export_roots={task.exportRootsText}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_object_path={objectSnapshot.path}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_object_sha256={objectSnapshot.sha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_report_path={reportSnapshot.path}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_report_sha256={reportSnapshot.sha256}")
    out = Fmt"{out}\n"
    return out

@borrows
fn BackendDriverDispatchMinProviderCacheBindingMatches(text: str,
                                                       task: BackendDriverDispatchMinProviderCompileTask,
                                                       targetTriple: str,
                                                       objectSnapshot: BackendDriverDispatchMinFileSnapshot,
                                                       reportSnapshot: BackendDriverDispatchMinFileSnapshot): bool =
    return BackendDriverDispatchMinProviderStageManifestLineCount(text) == 12 &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_binding_schema", "backend_driver_provider_cache_binding") &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_key", task.cacheKey) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_kind", task.kind) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_module", task.modulePath) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_target", targetTriple) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_compiler_sha256", task.compilerSha256) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_closure_cid", task.closureCid) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_export_roots", task.exportRootsText) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_object_path", objectSnapshot.path) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_object_sha256", objectSnapshot.sha256) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_report_path", reportSnapshot.path) &&
           BackendDriverDispatchMinProviderStageManifestExpected(text, "provider_cache_report_sha256", reportSnapshot.sha256)

fn BackendDriverDispatchMinProviderEmptySnapshot(): BackendDriverDispatchMinFileSnapshot =
    var out: BackendDriverDispatchMinFileSnapshot
    return out

@borrows
fn BackendDriverDispatchMinProviderCacheLoad(rootDir: str,
                                             linkPlan: slplan.SystemLinkPlanStub,
                                             task: BackendDriverDispatchMinProviderCompileTask,
                                             reportPath: str,
                                             effectiveObjectPath: var str,
                                             canonicalObjectPath: var str,
                                             objectSha256: var str,
                                             objectSize: var str,
                                             pinnedObjectFd: var int32): bool =
    pinnedObjectFd = -1
    var objectSnapshot: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(rootDir,
                                                       task.cacheObjectPath,
                                                       objectSnapshot):
        return false
    var reportSnapshot = BackendDriverDispatchMinProviderEmptySnapshot()
    if task.kind == "source":
        if !BackendDriverDispatchMinReadStableFileSnapshot(rootDir,
                                                           task.cacheReportPath,
                                                           reportSnapshot):
            return false
    var bindingSnapshot: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(rootDir,
                                                       task.cacheBindingPath,
                                                       bindingSnapshot):
        return false
    let bindingText = chengpath.ReadTextFile(rootDir, bindingSnapshot.path)
    if len(bindingText) <= 0 ||
       BackendDriverDispatchMinProviderCacheHex(bindingText) != bindingSnapshot.sha256 ||
       !BackendDriverDispatchMinProviderCacheBindingMatches(bindingText,
                                                            task,
                                                            linkPlan.targetTriple,
                                                            objectSnapshot,
                                                            reportSnapshot):
        return false
    if task.kind == "source":
        let cachedReportText = chengpath.ReadTextFile(rootDir,
                                                      reportSnapshot.path)
        var cachedSourceBundleCid: str
        if !BackendDriverDispatchMinProviderStageManifestValue(cachedReportText,
                                                               "source_bundle_cid",
                                                               cachedSourceBundleCid) ||
           cachedSourceBundleCid != task.closureCid:
            return false
    var objectPinnedPath: str
    if !BackendDriverDispatchMinPinFileSnapshot(rootDir,
                                                objectSnapshot,
                                                pinnedObjectFd,
                                                objectPinnedPath):
        return false
    if task.kind == "source":
        var reportFd: int32
        var reportPinnedPath: str
        if !BackendDriverDispatchMinPinFileSnapshot(rootDir,
                                                    reportSnapshot,
                                                    reportFd,
                                                    reportPinnedPath):
            let _ = BackendDriverDispatchMinCloseBridge(pinnedObjectFd)
            pinnedObjectFd = -1
            return false
        let reportCopied = BackendDriverDispatchMinCopyFileBytes(rootDir,
                                                                 reportPinnedPath,
                                                                 reportPath)
        let reportClosed = BackendDriverDispatchMinCloseBridge(reportFd) == 0
        var copiedReportSha256: str
        if !reportCopied || !reportClosed ||
           !BackendDriverDispatchMinFileSha256Hex(rootDir,
                                                  reportPath,
                                                  copiedReportSha256) ||
           copiedReportSha256 != reportSnapshot.sha256:
            let _ = BackendDriverDispatchMinCloseBridge(pinnedObjectFd)
            pinnedObjectFd = -1
            return false
    effectiveObjectPath = objectPinnedPath
    canonicalObjectPath = objectSnapshot.path
    objectSha256 = objectSnapshot.sha256
    objectSize = objectSnapshot.size
    return true

@borrows
fn BackendDriverDispatchMinProviderCachePublish(rootDir: str,
                                                linkPlan: slplan.SystemLinkPlanStub,
                                                task: BackendDriverDispatchMinProviderCompileTask,
                                                objectPath: str,
                                                reportPath: str): bool =
    if !BackendDriverDispatchMinCopyFileBytes(rootDir,
                                              objectPath,
                                              task.cacheObjectPath):
        return false
    if task.kind == "source" &&
       !BackendDriverDispatchMinCopyFileBytes(rootDir,
                                              reportPath,
                                              task.cacheReportPath):
        let _ = os.RemoveFile(chengpath.PathAbsolute(rootDir, task.cacheObjectPath))
        return false
    var objectSnapshot: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(rootDir,
                                                       task.cacheObjectPath,
                                                       objectSnapshot):
        return false
    var reportSnapshot = BackendDriverDispatchMinProviderEmptySnapshot()
    if task.kind == "source" &&
       !BackendDriverDispatchMinReadStableFileSnapshot(rootDir,
                                                       task.cacheReportPath,
                                                       reportSnapshot):
        return false
    let bindingText = BackendDriverDispatchMinProviderCacheBindingText(task,
                                                                       linkPlan.targetTriple,
                                                                       objectSnapshot,
                                                                       reportSnapshot)
    if !BackendDriverDispatchMinWriteTextAtomic(rootDir,
                                                task.cacheBindingPath,
                                                bindingText):
        return false
    return true

@borrows
fn BackendDriverDispatchMinCompileProviderObject(rootDir: str,
                                                  compilerPath: str,
                                                  linkPlan: slplan.SystemLinkPlanStub,
                                                  task: BackendDriverDispatchMinProviderCompileTask,
                                                  effectiveObjectPath: var str,
                                                  canonicalObjectPath: var str,
                                                  objectSha256: var str,
                                                  objectSize: var str,
                                                  pinnedObjectFd: var int32,
                                                  cacheHit: var bool,
                                                  nestedCompile: var bool): bool =
    effectiveObjectPath = strings.CloneStr(task.objectPath)
    pinnedObjectFd = -1
    cacheHit = false
    nestedCompile = false
    let modulePath = strings.CloneStr(task.modulePath)
    let sourcePath = strings.CloneStr(task.sourcePath)
    let objectPath = strings.CloneStr(task.objectPath)
    let exportRootsText = strings.CloneStr(task.exportRootsText)
    if len(sourcePath) <= 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider source unsupported: {modulePath}")
        return false
    if BackendDriverDispatchMinDarwinProviderSourceLeak(linkPlan.targetTriple, sourcePath):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: Darwin provider closure selected Linux source: {sourcePath}")
        return false
    if !chengpath.FileExistsNonEmpty(rootDir, sourcePath):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider source missing: {sourcePath}")
        return false
    if !BackendDriverDispatchMinProviderCompileInputsCurrent(rootDir,
                                                             compilerPath,
                                                             linkPlan,
                                                             task):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider compile inputs drifted before cache use: {modulePath}")
        return false
    let reportPath = Fmt"{objectPath}.report.txt"
    let logPath = Fmt"{objectPath}.compile.log"
    let cacheObjectPath = task.cacheObjectPath
    let cacheReportPath = task.cacheReportPath
    let cacheMode = BackendDriverDispatchMinProviderCacheMode()
    if cacheMode == "require-hit":
        if len(task.pinnedCacheObjectPath) <= 0 ||
           len(task.pinnedCacheObjectCanonicalPath) <= 0 ||
           !BackendDriverDispatchMinSha256TextValid(task.pinnedCacheObjectSha256) ||
           len(task.pinnedCacheReportPath) <= 0 ||
           !BackendDriverDispatchMinSha256TextValid(task.pinnedCacheReportSha256):
            return false
        let reportCopied = BackendDriverDispatchMinCopyFileBytes(rootDir,
                                                                 task.pinnedCacheReportPath,
                                                                 reportPath)
        if !reportCopied:
            return false
        var copiedReportSha256: str
        if !BackendDriverDispatchMinFileSha256Hex(rootDir,
                                                  reportPath,
                                                  copiedReportSha256) ||
           copiedReportSha256 != task.pinnedCacheReportSha256:
            return false
        if !chengpath.WriteTextFile(rootDir, logPath, Fmt"provider_cache_hit={cacheObjectPath}\n"):
            return false
        effectiveObjectPath = strings.CloneStr(task.pinnedCacheObjectPath)
        canonicalObjectPath = strings.CloneStr(task.pinnedCacheObjectCanonicalPath)
        objectSha256 = strings.CloneStr(task.pinnedCacheObjectSha256)
        objectSize = strings.CloneStr(task.pinnedCacheObjectSize)
        cacheHit = true
        return true
    var pinnedInputFds: int32[]
    var pinnedInputPaths: str[]
    var compilerCommandPath: str
    if !BackendDriverDispatchMinPinProviderCompileInputs(rootDir,
                                                        compilerPath,
                                                        linkPlan,
                                                        task,
                                                        compilerCommandPath,
                                                        pinnedInputFds,
                                                        pinnedInputPaths):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider compile inputs could not be pinned: {modulePath}")
        return false
    defer:
        BackendDriverDispatchMinCloseFdListDeferred(pinnedInputFds)
    if tmat.TargetIsDarwin(linkPlan.targetTriple) &&
       BackendDriverDispatchMinProviderCacheLoad(rootDir,
                                                 linkPlan,
                                                 task,
                                                 reportPath,
                                                 effectiveObjectPath,
                                                 canonicalObjectPath,
                                                 objectSha256,
                                                 objectSize,
                                                 pinnedObjectFd):
        if !chengpath.WriteTextFile(rootDir, logPath, Fmt"provider_cache_hit={cacheObjectPath}\n"):
            let _ = BackendDriverDispatchMinCloseBridge(pinnedObjectFd)
            pinnedObjectFd = -1
            return false
        cacheHit = true
        return true
    # `--root:.` + PathAbsolute 拼出 `./src/...`，与闭包绝对路径在 FindRoot 不等价，
    # 双名 @exportc 根（cheng_ptr_plus 等）foundExplicitCount>1 → ambiguous。
    # 子进程必须传绝对 root；--in 同步绝对化，避免 `./` 前缀泄漏进 CSG。
    let providerRootAbs = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe("", rootDir))
    let providerSourceAbs = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe(providerRootAbs, sourcePath))
    let envRss = os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES")
    let rssText = len(envRss) > 0 ? strings.CloneStr(envRss) : strings.CloneStr("805306368")
    let coreCommand = Fmt"CHENG_PROGRESS=1 PROGRESS=1 CHENG_PROCESS_MAX_RSS_BYTES={rssText} {os.QuoteShell(compilerCommandPath)} system-link-exec --root:{os.QuoteShell(providerRootAbs)} --in:{os.QuoteShell(providerSourceAbs)} --emit:obj --target:{linkPlan.targetTriple} --out:{os.QuoteShell(objectPath)} --report-out:{os.QuoteShell(reportPath)}"
    let isRuntime = modulePath == "runtime/compiler_runtime" || modulePath == "runtime/core_runtime" || modulePath == "runtime/debug_runtime" || modulePath == "runtime/program_support" || modulePath == "runtime/program_support_get_env_bridge" || modulePath == "runtime/program_support_host_runtime"
    let darwinCommand = Fmt"CHENG_BACKEND_DRIVER_HANDOFF=1 CHENG_NO_BACKEND_DRIVER_HANDOFF=0 {coreCommand}"
    let runtimeCommand = Fmt"CHENG_NO_BACKEND_DRIVER_HANDOFF=1 {coreCommand}"
    let prefixedCommand = tmat.TargetIsDarwin(linkPlan.targetTriple) ? darwinCommand : (isRuntime ? runtimeCommand : coreCommand)
    let extra = len(exportRootsText) > 0 ? Fmt" --symbol-visibility:internal --export-roots:{os.QuoteShell(exportRootsText)}" : strings.CloneStr("")
    let command = Fmt"{prefixedCommand}{extra}"
    nestedCompile = true
    var compileOutput: str
    let exitCode = BackendDriverDispatchMinExecShellInto(command, rootDir, compileOutput)
    if exitCode != 0 && len(compileOutput) <= 0:
        let fallback = Fmt"provider_compile_exit_code={exitCode}\nprovider_compile_command={command}\n"
        let _ = chengpath.WriteTextFile(rootDir, logPath, fallback)
    else:
        let _ = chengpath.WriteTextFile(rootDir, logPath, compileOutput)
    if exitCode != 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider compile failed module={modulePath} log={logPath}")
        return false
    if !chengpath.FileExistsNonEmpty(rootDir, objectPath):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider object missing: {objectPath}")
        return false
    if !chengpath.FileExistsNonEmpty(rootDir, reportPath):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider report missing: {reportPath}")
        return false
    let reportText = chengpath.ReadTextFile(rootDir, reportPath)
    var reportedSourceBundleCid: str
    if !BackendDriverDispatchMinProviderStageManifestValue(reportText,
                                                           "source_bundle_cid",
                                                           reportedSourceBundleCid) ||
       reportedSourceBundleCid != task.closureCid:
        let _ = os.RemoveFile(chengpath.PathAbsolute(rootDir, objectPath))
        let _ = os.RemoveFile(chengpath.PathAbsolute(rootDir, reportPath))
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider compile report source cid mismatch: {modulePath}")
        return false
    if !BackendDriverDispatchMinRevalidateProviderCompileInputs(rootDir,
                                                                compilerPath,
                                                                linkPlan,
                                                                task,
                                                                pinnedInputFds,
                                                                pinnedInputPaths):
        let _ = os.RemoveFile(chengpath.PathAbsolute(rootDir, objectPath))
        let _ = os.RemoveFile(chengpath.PathAbsolute(rootDir, reportPath))
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: provider compile inputs drifted while compiling: {modulePath}")
        return false
    if tmat.TargetIsDarwin(linkPlan.targetTriple):
        if chengpath.TextContains(reportText, "system_helpers_backend_nolibc_linux_aarch64.cheng") ||
           chengpath.TextContains(reportText, "__cheng_linux_"):
            BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: Darwin provider report leaked Linux provider symbols: {reportPath}")
            return false
    if tmat.TargetIsDarwin(linkPlan.targetTriple):
        let cacheDir = BackendDriverDispatchMinProviderCacheDirectory()
        if !BackendDriverDispatchMinEnsureDir(rootDir, cacheDir):
            return false
        if !BackendDriverDispatchMinProviderCachePublish(rootDir,
                                                         linkPlan,
                                                         task,
                                                         objectPath,
                                                         reportPath):
            return false
        if !BackendDriverDispatchMinProviderCacheLoad(rootDir,
                                                      linkPlan,
                                                      task,
                                                      reportPath,
                                                      effectiveObjectPath,
                                                      canonicalObjectPath,
                                                      objectSha256,
                                                      objectSize,
                                                      pinnedObjectFd):
            return false
    else:
        let cacheDir = BackendDriverDispatchMinProviderCacheDirectory()
        if BackendDriverDispatchMinEnsureDir(rootDir, cacheDir):
            let _objectStored = BackendDriverDispatchMinCopyFileBytes(rootDir,
                                                                      objectPath,
                                                                      task.cacheObjectPath)
            let _reportStored = BackendDriverDispatchMinCopyFileBytes(rootDir,
                                                                      reportPath,
                                                                      task.cacheReportPath)
        let canonicalRes = fs.Realpath(chengpath.PathAbsolute(rootDir, objectPath))
        if !canonicalRes.ok:
            return false
        let canon = strings.CloneStr(canonicalRes.value)
        var shaText: str
        if !BackendDriverDispatchMinFileSha256Hex(rootDir, objectPath, shaText):
            return false
        let sizeText = strings.Int64ToStr(os.FileSize(canon))
        canonicalObjectPath = strings.CloneStr(canon)
        objectSha256 = strings.CloneStr(shaText)
        objectSize = strings.CloneStr(sizeText)
    return true

@borrows
fn BackendDriverDispatchMinProviderCompileResultEmpty(task: BackendDriverDispatchMinProviderCompileTask): BackendDriverDispatchMinProviderCompileResult =
    var out: BackendDriverDispatchMinProviderCompileResult
    out.moduleIndex = task.moduleIndex
    out.modulePath = strings.CloneStr(task.modulePath)
    out.sourcePath = strings.CloneStr(task.sourcePath)
    out.objectPath = strings.CloneStr(task.objectPath)
    out.logPath = strings.CloneStr(task.logPath)
    return out

fn BackendDriverDispatchMinCloseProviderCompileResultPins(results: var BackendDriverDispatchMinProviderCompileResult[]) =
    for i in 0..<results.len:
        let fd = results[i].pinnedObjectFd
        if fd >= 0:
            let _ = BackendDriverDispatchMinCloseBridge(fd)
            var row = results[i]
            row.pinnedObjectFd = -1
            results[i] = row

@borrows
fn BackendDriverDispatchMinCompileGeneratedProviderObject(rootDir: str,
                                                           linkPlan: slplan.SystemLinkPlanStub,
                                                           task: BackendDriverDispatchMinProviderCompileTask,
                                                           effectiveObjectPath: var str,
                                                           canonicalObjectPath: var str,
                                                           objectSha256: var str,
                                                           objectSize: var str,
                                                           pinnedObjectFd: var int32,
                                                           cacheHit: var bool): bool =
    effectiveObjectPath = task.objectPath
    canonicalObjectPath = ""
    objectSha256 = ""
    objectSize = ""
    pinnedObjectFd = -1
    cacheHit = false
    if BackendDriverDispatchMinProviderCacheMode() == "require-hit":
        if len(task.pinnedCacheObjectPath) <= 0 ||
           len(task.pinnedCacheObjectCanonicalPath) <= 0 ||
           !BackendDriverDispatchMinSha256TextValid(task.pinnedCacheObjectSha256):
            return false
        effectiveObjectPath = task.pinnedCacheObjectPath
        canonicalObjectPath = task.pinnedCacheObjectCanonicalPath
        objectSha256 = task.pinnedCacheObjectSha256
        objectSize = task.pinnedCacheObjectSize
        cacheHit = true
        return true
    if BackendDriverDispatchMinProviderCacheLoad(rootDir,
                                                 linkPlan,
                                                 task,
                                                 "",
                                                 effectiveObjectPath,
                                                 canonicalObjectPath,
                                                 objectSha256,
                                                 objectSize,
                                                 pinnedObjectFd):
        cacheHit = true
        return true
    let writeRes = BackendDriverDispatchMinWriteDarwinSyscallProviderObject(rootDir, task.objectPath)
    if !writeRes.ok || !chengpath.FileExistsNonEmpty(rootDir, task.objectPath):
        return false
    let cacheDir = BackendDriverDispatchMinProviderCacheDirectory()
    if !BackendDriverDispatchMinEnsureDir(rootDir, cacheDir):
        return false
    if !BackendDriverDispatchMinProviderCachePublish(rootDir,
                                                     linkPlan,
                                                     task,
                                                     task.objectPath,
                                                     ""):
        return false
    if !BackendDriverDispatchMinProviderCacheLoad(rootDir,
                                                  linkPlan,
                                                  task,
                                                  "",
                                                  effectiveObjectPath,
                                                  canonicalObjectPath,
                                                  objectSha256,
                                                  objectSize,
                                                  pinnedObjectFd):
        return false
    return true

@borrows
fn BackendDriverDispatchMinCompileProviderTask(rootDir: str,
                                               compilerPath: str,
                                               linkPlan: slplan.SystemLinkPlanStub,
                                               task: BackendDriverDispatchMinProviderCompileTask,
                                               effectiveObjectPath: var str,
                                               canonicalObjectPath: var str,
                                               objectSha256: var str,
                                               objectSize: var str,
                                               pinnedObjectFd: var int32,
                                               cacheHit: var bool,
                                               nestedCompile: var bool): bool =
    effectiveObjectPath = task.objectPath
    canonicalObjectPath = ""
    objectSha256 = ""
    objectSize = ""
    pinnedObjectFd = -1
    cacheHit = false
    nestedCompile = false
    if task.kind == "source":
        return BackendDriverDispatchMinCompileProviderObject(rootDir,
                                                             compilerPath,
                                                             linkPlan,
                                                             task,
                                                             effectiveObjectPath,
                                                             canonicalObjectPath,
                                                             objectSha256,
                                                             objectSize,
                                                             pinnedObjectFd,
                                                             cacheHit,
                                                             nestedCompile)
    if task.kind == "darwin_syscall":
        return BackendDriverDispatchMinCompileGeneratedProviderObject(rootDir,
                                                                      linkPlan,
                                                                      task,
                                                                      effectiveObjectPath,
                                                                      canonicalObjectPath,
                                                                      objectSha256,
                                                                      objectSize,
                                                                      pinnedObjectFd,
                                                                      cacheHit)
    BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: unsupported provider task kind: {task.kind}")
    return false

fn BackendDriverDispatchMinProviderWsResetState() =
    backendDriverDispatchMinProviderWsTasks = []
    backendDriverDispatchMinProviderWsResults = []
    backendDriverDispatchMinProviderWsShardHeads = []
    backendDriverDispatchMinProviderWsShardTails = []
    backendDriverDispatchMinProviderWsWorkerCount = 0

fn BackendDriverDispatchMinProviderWsPopOwn(workerId: int32,
                                             taskIndex: var int32): bool =
    if workerId < 0 || workerId >= backendDriverDispatchMinProviderWsWorkerCount:
        return false
    let headCell = backendDriverDispatchMinProviderWsShardHeads[workerId]
    let tailCell = backendDriverDispatchMinProviderWsShardTails[workerId]
    let nextTail = atomic.LoadI32(tailCell) - 1
    atomic.StoreI32(tailCell, nextTail)
    let head = atomic.LoadI32(headCell)
    if head < nextTail:
        taskIndex = nextTail
        return true
    atomic.StoreI32(tailCell, head)
    if head == nextTail:
        if atomic.CasI32(headCell, head, head + 1):
            taskIndex = nextTail
            atomic.StoreI32(tailCell, head + 1)
            return true
    atomic.StoreI32(tailCell, atomic.LoadI32(headCell))
    return false

fn BackendDriverDispatchMinProviderWsStealFrom(victimId: int32,
                                                taskIndex: var int32): bool =
    if victimId < 0 || victimId >= backendDriverDispatchMinProviderWsWorkerCount:
        return false
    let headCell = backendDriverDispatchMinProviderWsShardHeads[victimId]
    let tailCell = backendDriverDispatchMinProviderWsShardTails[victimId]
    while true:
        let head = atomic.LoadI32(headCell)
        let tail = atomic.LoadI32(tailCell)
        if head >= tail:
            return false
        if atomic.CasI32(headCell, head, head + 1):
            taskIndex = head
            return true

fn BackendDriverDispatchMinProviderWsTakeTask(workerId: int32,
                                               taskIndex: var int32): bool =
    if BackendDriverDispatchMinProviderWsPopOwn(workerId, taskIndex):
        return true
    var offset = 1
    while offset < backendDriverDispatchMinProviderWsWorkerCount:
        let victimId = (workerId + offset) % backendDriverDispatchMinProviderWsWorkerCount
        if BackendDriverDispatchMinProviderWsStealFrom(victimId, taskIndex):
            return true
        offset = offset + 1
    return false

fn BackendDriverDispatchMinProviderWsStoreResult(
        taskIndex: int32,
        result: BackendDriverDispatchMinProviderCompileResult) =
    backendDriverDispatchMinProviderWsResults[taskIndex] = result

@borrows
fn BackendDriverDispatchMinProviderCompileTaskIndex(rootDir: str,
                                                     compilerPath: str,
                                                     targetTriple: str,
                                                     taskIndex: int32) =
    if taskIndex < 0 || taskIndex >= backendDriverDispatchMinProviderWsTasks.len:
        panic("backend_driver_provider_ws_task_index_out_of_range")
    let task = backendDriverDispatchMinProviderWsTasks[taskIndex]
    var result = BackendDriverDispatchMinProviderCompileResultEmpty(task)
    var linkPlan: slplan.SystemLinkPlanStub
    linkPlan.targetTriple = strings.CloneStr(targetTriple)
    var effectiveObjectPath: str
    var canonicalObjectPath: str
    var objectSha256: str
    var objectSize: str
    var pinnedObjectFd: int32
    pinnedObjectFd = -1
    var cacheHit: bool
    var nestedCompile: bool
    let ok = BackendDriverDispatchMinCompileProviderTask(rootDir,
                                                         compilerPath,
                                                         linkPlan,
                                                         task,
                                                         effectiveObjectPath,
                                                         canonicalObjectPath,
                                                         objectSha256,
                                                         objectSize,
                                                         pinnedObjectFd,
                                                         cacheHit,
                                                         nestedCompile)
    result.completed = true
    result.ok = ok
    result.objectPath = effectiveObjectPath
    result.canonicalObjectPath = canonicalObjectPath
    result.objectSha256 = objectSha256
    result.objectSize = objectSize
    result.pinnedObjectFd = pinnedObjectFd
    result.cacheHit = cacheHit
    result.nestedCompile = nestedCompile
    if !ok:
        result.errorMessage = Fmt"backend driver direct system-link-exec: provider object failed: {task.modulePath}"
    BackendDriverDispatchMinProviderWsStoreResult(taskIndex, result)

fn BackendDriverDispatchMinProviderWorkerCountFor(taskCount: int32,
                                                   requestedJobs: int32): int32 =
    if taskCount <= 0:
        return 0
    var workerCount = requestedJobs
    if workerCount < 1:
        workerCount = 1
    if workerCount > taskCount:
        workerCount = taskCount
    return workerCount

@borrows
fn BackendDriverDispatchMinProviderJoinAll(workerThreads: thread.Thread[]): bool =
    var joined = true
    for i in 0..<workerThreads.len:
        if !thread.JoinThread(workerThreads[i]):
            joined = false
    return joined

@borrows
fn BackendDriverDispatchMinProviderWsPrepare(rootDir: str,
                                              compilerPath: str,
                                              linkPlan: var slplan.SystemLinkPlanStub,
                                              tasks: BackendDriverDispatchMinProviderCompileTask[],
                                              workerCount: int32) =
    backendDriverDispatchMinProviderWsWorkerCount = workerCount
    let doneCell = atomic.NewI32(0)
    if doneCell == nil:
        panic("backend_driver_provider_ws_done_atomic_alloc_failed")
    backendDriverDispatchMinProviderWsDoneCount = doneCell
    var preparedResults: BackendDriverDispatchMinProviderCompileResult[]
    for i in 0..<tasks.len:
        add(preparedResults,
            BackendDriverDispatchMinProviderCompileResultEmpty(tasks[i]))
    backendDriverDispatchMinProviderWsResults = preparedResults
    var preparedShardHeads: atomic.I32[]
    var preparedShardTails: atomic.I32[]
    for workerId in 0..<workerCount:
        let start = (tasks.len * workerId) / workerCount
        let finish = (tasks.len * (workerId + 1)) / workerCount
        let head = atomic.NewI32(start)
        let tail = atomic.NewI32(finish)
        if head == nil || tail == nil:
            panic("backend_driver_provider_ws_queue_alloc_failed")
        add(preparedShardHeads, head)
        add(preparedShardTails, tail)
    backendDriverDispatchMinProviderWsShardHeads = preparedShardHeads
    backendDriverDispatchMinProviderWsShardTails = preparedShardTails
    backendDriverDispatchMinProviderWsTasks = tasks

@borrows
fn BackendDriverDispatchMinProviderWsExecute(rootDir: str,
                                              compilerPath: str,
                                              linkPlan: var slplan.SystemLinkPlanStub,
                                              tasks: BackendDriverDispatchMinProviderCompileTask[],
                                              outResults: var BackendDriverDispatchMinProviderCompileResult[],
                                              requestedJobs: var int32,
                                              activeWorkers: var int32,
                                              completedWorkers: var int32,
                                              schedule: var str): bool =
    requestedJobs = BackendDriverDispatchMinPositiveJobs(linkPlan.jobCount)
    activeWorkers = BackendDriverDispatchMinProviderWorkerCountFor(tasks.len, requestedJobs)
    completedWorkers = 0
    schedule = "none"
    if tasks.len <= 0:
        outResults = []
        return true
    if BackendDriverDispatchMinProviderCacheMode() == "require-hit":
        requestedJobs = 1
        activeWorkers = 1
        completedWorkers = 1
        schedule = "cache_hit_serial"
        outResults = []
        for taskIndex in 0..<tasks.len:
            let task = tasks[taskIndex]
            var result = BackendDriverDispatchMinProviderCompileResultEmpty(task)
            var taskLinkPlan = linkPlan
            var effectiveObjectPath: str
            var canonicalObjectPath: str
            var objectSha256: str
            var objectSize: str
            var pinnedObjectFd: int32
            pinnedObjectFd = -1
            var cacheHit: bool
            var nestedCompile: bool
            let ok = BackendDriverDispatchMinCompileProviderTask(rootDir,
                                                                 compilerPath,
                                                                 taskLinkPlan,
                                                                 task,
                                                                 effectiveObjectPath,
                                                                 canonicalObjectPath,
                                                                 objectSha256,
                                                                 objectSize,
                                                                 pinnedObjectFd,
                                                                 cacheHit,
                                                                 nestedCompile)
            result.completed = true
            result.ok = ok
            result.objectPath = effectiveObjectPath
            result.canonicalObjectPath = canonicalObjectPath
            result.objectSha256 = objectSha256
            result.objectSize = objectSize
            result.pinnedObjectFd = pinnedObjectFd
            result.cacheHit = cacheHit
            result.nestedCompile = nestedCompile
            if !ok:
                result.errorMessage = Fmt"backend driver direct system-link-exec: required provider cache task failed: {task.modulePath}"
            add(outResults, result)
        return true
    requestedJobs = 1
    activeWorkers = 1
    completedWorkers = 1
    if tmat.TargetIsDarwin(linkPlan.targetTriple):
        schedule = "main_process_spawn"
    else:
        schedule = "serial"
    outResults = []
    for taskIndex in 0..<tasks.len:
        let task = tasks[taskIndex]
        var result = BackendDriverDispatchMinProviderCompileResultEmpty(task)
        var taskLinkPlan = linkPlan
        var effectiveObjectPath: str
        var canonicalObjectPath: str
        var objectSha256: str
        var objectSize: str
        var pinnedObjectFd: int32
        pinnedObjectFd = -1
        var cacheHit: bool
        var nestedCompile: bool
        let ok = BackendDriverDispatchMinCompileProviderTask(rootDir,
                                                             compilerPath,
                                                             taskLinkPlan,
                                                             task,
                                                             effectiveObjectPath,
                                                             canonicalObjectPath,
                                                             objectSha256,
                                                             objectSize,
                                                             pinnedObjectFd,
                                                             cacheHit,
                                                             nestedCompile)
        result.completed = true
        result.ok = ok
        result.objectPath = effectiveObjectPath
        result.canonicalObjectPath = canonicalObjectPath
        result.objectSha256 = objectSha256
        result.objectSize = objectSize
        result.pinnedObjectFd = pinnedObjectFd
        result.cacheHit = cacheHit
        result.nestedCompile = nestedCompile
        if !ok:
            result.errorMessage = Fmt"backend driver direct system-link-exec: provider object failed: {task.modulePath}"
        add(outResults, result)
    return true

fn BackendDriverDispatchMinPinProviderStageArtifacts(driverRoot: str,
                                                     manifestText: str,
                                                     tasks: var BackendDriverDispatchMinProviderCompileTask[],
                                                     out: var BackendDriverDispatchMinProviderBundle,
                                                     outErr: var str): bool =
    out.providerStagePinnedFds = []
    out.providerStagePinnedPaths = []
    out.providerStagePinnedObjectPaths = []
    var manifestFd: int32
    var manifestPinnedPath: str
    if !BackendDriverDispatchMinPinFileSnapshot(driverRoot,
                                                out.providerStageManifestSnapshot,
                                                manifestFd,
                                                manifestPinnedPath):
        outErr = "provider stage manifest fd pin failed"
        return false
    add(out.providerStagePinnedFds, manifestFd)
    add(out.providerStagePinnedPaths, strings.CloneStr(manifestPinnedPath))
    let pinnedManifestText = chengpath.ReadTextFile(driverRoot, manifestPinnedPath)
    if pinnedManifestText != manifestText ||
       BackendDriverDispatchMinSeekBridge(manifestFd, Int64(0), 0) != Int64(0):
        outErr = "provider stage manifest pinned content mismatch"
        let _ = BackendDriverDispatchMinCloseProviderStagePins(out)
        return false
    var artifactIndex: int32
    for i in 0..<tasks.len:
        if artifactIndex >= out.providerStageArtifactSnapshots.len:
            outErr = Fmt"provider stage pinned object index mismatch index={i}"
            let _ = BackendDriverDispatchMinCloseProviderStagePins(out)
            return false
        let objectExpected = out.providerStageArtifactSnapshots[artifactIndex]
        var objectFd: int32
        var objectPinnedPath: str
        if !BackendDriverDispatchMinPinFileSnapshot(driverRoot,
                                                    objectExpected,
                                                    objectFd,
                                                    objectPinnedPath):
            outErr = Fmt"provider stage object fd pin failed index={i}"
            let _ = BackendDriverDispatchMinCloseProviderStagePins(out)
            return false
        add(out.providerStagePinnedFds, objectFd)
        add(out.providerStagePinnedPaths, strings.CloneStr(objectPinnedPath))
        add(out.providerStagePinnedObjectPaths, strings.CloneStr(objectPinnedPath))
        var pinnedTask = tasks[i]
        pinnedTask.pinnedCacheObjectPath = objectPinnedPath
        pinnedTask.pinnedCacheObjectCanonicalPath = objectExpected.path
        pinnedTask.pinnedCacheObjectSha256 = objectExpected.sha256
        pinnedTask.pinnedCacheObjectSize = objectExpected.size
        tasks[i] = pinnedTask
        artifactIndex = artifactIndex + 1
        if tasks[i].kind == "source":
            if artifactIndex >= out.providerStageArtifactSnapshots.len:
                outErr = Fmt"provider stage pinned report index mismatch index={i}"
                let _ = BackendDriverDispatchMinCloseProviderStagePins(out)
                return false
            let reportExpected = out.providerStageArtifactSnapshots[artifactIndex]
            var reportFd: int32
            var reportPinnedPath: str
            if !BackendDriverDispatchMinPinFileSnapshot(driverRoot,
                                                        reportExpected,
                                                        reportFd,
                                                        reportPinnedPath):
                outErr = Fmt"provider stage report fd pin failed index={i}"
                let _ = BackendDriverDispatchMinCloseProviderStagePins(out)
                return false
            add(out.providerStagePinnedFds, reportFd)
            add(out.providerStagePinnedPaths, strings.CloneStr(reportPinnedPath))
            pinnedTask = tasks[i]
            pinnedTask.pinnedCacheReportPath = reportPinnedPath
            pinnedTask.pinnedCacheReportSha256 = reportExpected.sha256
            tasks[i] = pinnedTask
            artifactIndex = artifactIndex + 1
    if artifactIndex != out.providerStageArtifactSnapshots.len ||
       out.providerStagePinnedObjectPaths.len != tasks.len ||
       out.providerStagePinnedFds.len != out.providerStageArtifactSnapshots.len + 1 ||
       out.providerStagePinnedPaths.len != out.providerStagePinnedFds.len:
        outErr = "provider stage fd pin cardinality mismatch"
        let _ = BackendDriverDispatchMinCloseProviderStagePins(out)
        return false
    return true

@borrows
fn BackendDriverDispatchMinRenderProviderPlan(driverRoot: str,
                                              linkPlan: var slplan.SystemLinkPlanStub,
                                              bundle: var BackendDriverDispatchMinProviderBundle,
                                              tasks: var BackendDriverDispatchMinProviderCompileTask[],
                                              plan: var str,
                                              outErr: var str): bool =
    plan = ""
    outErr = ""
    BackendDriverDispatchMinAppendLine(plan, "provider_plan_schema=backend_driver_provider_plan")
    BackendDriverDispatchMinAppendLine(plan, "provider_plan_status=complete")
    BackendDriverDispatchMinAppendLine(plan, "provider_cache_key_schema=provider_cache_content")
    BackendDriverDispatchMinAppendLine(plan, Fmt"provider_plan_compiler_path={chengpath.PathAbsolute(driverRoot, bundle.compilerPath)}")
    BackendDriverDispatchMinAppendLine(plan, Fmt"provider_plan_compiler_sha256={bundle.compilerSha256}")
    BackendDriverDispatchMinAppendLine(plan, Fmt"provider_plan_target={linkPlan.targetTriple}")
    BackendDriverDispatchMinAppendLine(plan, Fmt"provider_plan_cache_directory={chengpath.PathAbsolute(driverRoot, bundle.cacheDirectory)}")
    BackendDriverDispatchMinAppendLine(plan, Fmt"provider_plan_task_count={tasks.len}")
    for i in 0..<tasks.len:
        let task = tasks[i]
        if !BackendDriverDispatchMinProviderPlanValueSafe(task.kind) ||
           !BackendDriverDispatchMinProviderPlanValueSafe(task.modulePath) ||
           !BackendDriverDispatchMinProviderPlanValueSafe(task.sourcePath) ||
           !BackendDriverDispatchMinProviderPlanValueSafe(task.exportRootsText) ||
           !BackendDriverDispatchMinProviderPlanValueSafe(task.cacheObjectPath) ||
           !BackendDriverDispatchMinProviderPlanValueSafe(task.cacheReportPath):
            outErr = Fmt"unsafe provider plan value index={i}"
            return false
        let prefix = Fmt"provider_task_{i}"
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_kind={task.kind}")
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_module={task.modulePath}")
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_source_path={task.sourcePath}")
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_closure_cid={task.closureCid}")
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_export_roots={task.exportRootsText}")
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_cache_key={task.cacheKey}")
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_cache_object_path={chengpath.PathAbsolute(driverRoot, task.cacheObjectPath)}")
        var absoluteCacheReportPath: str
        if len(task.cacheReportPath) > 0:
            absoluteCacheReportPath = chengpath.PathAbsolute(driverRoot, task.cacheReportPath)
        BackendDriverDispatchMinAppendLine(plan, Fmt"{prefix}_cache_report_path={absoluteCacheReportPath}")
    return true

fn BackendDriverDispatchMinValidateProviderStageManifest(driverRoot: str,
                                                         linkPlan: var slplan.SystemLinkPlanStub,
                                                         tasks: var BackendDriverDispatchMinProviderCompileTask[],
                                                         out: var BackendDriverDispatchMinProviderBundle,
                                                         outErr: var str): bool =
    outErr = ""
    if out.cacheMode != "require-hit":
        out.providerStageValidationStatus = "not_applicable_allow_build"
        return true
    if !tmat.TargetIsDarwinA64(linkPlan.targetTriple):
        outErr = "provider stage manifest stat identity is only defined for Darwin arm64"
        return false
    if linkPlan.providerObjectPaths.len > 0:
        outErr = "require-hit provider stage manifest does not permit unpinned explicit provider objects"
        return false
    let manifestPathRaw = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--provider-stage-manifest", ""))
    if len(manifestPathRaw) <= 0 ||
       !BackendDriverDispatchMinProviderPlanValueSafe(manifestPathRaw):
        outErr = "require-hit provider stage manifest is missing or unsafe"
        return false
    var manifestSnapshotBefore: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                       manifestPathRaw,
                                                       manifestSnapshotBefore):
        outErr = "provider stage manifest is not a stable regular file"
        return false
    let manifestText = chengpath.ReadTextFile(driverRoot, manifestPathRaw)
    if len(manifestText) <= 0 ||
       BackendDriverDispatchMinProviderCacheHex(manifestText) != manifestSnapshotBefore.sha256:
        outErr = "provider stage manifest read does not match its content hash"
        return false
    var manifestSnapshotAfter: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                       manifestPathRaw,
                                                       manifestSnapshotAfter) ||
       !BackendDriverDispatchMinFileSnapshotEqual(manifestSnapshotBefore,
                                                  manifestSnapshotAfter):
        outErr = "provider stage manifest changed while validating"
        return false
    var stageId: str
    var planSha256: str
    var taskCountText: str
    if !BackendDriverDispatchMinProviderStageManifestValue(manifestText,
                                                           "provider_stage_id",
                                                           stageId) ||
       len(stageId) <= 0 ||
       !BackendDriverDispatchMinProviderPlanValueSafe(stageId):
        outErr = "provider stage manifest has invalid stage id"
        return false
    if !BackendDriverDispatchMinProviderStageManifestValue(manifestText,
                                                           "provider_stage_plan_sha256",
                                                           planSha256) ||
       !BackendDriverDispatchMinSha256TextValid(planSha256):
        outErr = "provider stage manifest has invalid plan hash"
        return false
    if !BackendDriverDispatchMinProviderStageManifestValue(manifestText,
                                                           "provider_stage_task_count",
                                                           taskCountText) ||
       strutil.ParseInt(taskCountText) != tasks.len:
        outErr = "provider stage manifest task count mismatch"
        return false
    let expectedLineCount = 12 + tasks.len * 24
    if BackendDriverDispatchMinProviderStageManifestLineCount(manifestText) != expectedLineCount:
        outErr = "provider stage manifest field set is not exact"
        return false
    let cacheDirectoryAbs = chengpath.PathAbsolute(driverRoot, out.cacheDirectory)
    if !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_manifest_schema", "backend_driver_provider_stage_manifest") ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_status", "complete") ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_target", linkPlan.targetTriple) ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_compiler_sha256", out.compilerSha256) ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_cache_directory", cacheDirectoryAbs) ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_artifact_binding", "pre_post_sha256_dev_inode_size_mtime_ctime_plus_pinned_fd_link_inputs") ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_fd_pin", "1") ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_toctou_closed", "1") ||
       !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, "provider_stage_toctou_model", "pinned_fd_link_inputs_with_path_and_fd_revalidation"):
        outErr = "provider stage manifest global contract mismatch"
        return false
    var canonicalPlan: str
    var canonicalPlanErr: str
    if !BackendDriverDispatchMinRenderProviderPlan(driverRoot,
                                                   linkPlan,
                                                   out,
                                                   tasks,
                                                   canonicalPlan,
                                                   canonicalPlanErr) ||
       BackendDriverDispatchMinProviderCacheHex(canonicalPlan) != planSha256:
        outErr = Fmt"provider stage canonical plan hash mismatch: {canonicalPlanErr}"
        return false
    out.providerStageArtifactSnapshots = []
    for i in 0..<tasks.len:
        let task = tasks[i]
        let prefix = Fmt"provider_stage_task_{i}"
        if !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, Fmt"{prefix}_kind", task.kind) ||
           !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, Fmt"{prefix}_module", task.modulePath) ||
           !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, Fmt"{prefix}_source_path", task.sourcePath) ||
           !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, Fmt"{prefix}_closure_cid", task.closureCid) ||
           !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, Fmt"{prefix}_export_roots", task.exportRootsText) ||
           !BackendDriverDispatchMinProviderStageManifestExpected(manifestText, Fmt"{prefix}_cache_key", task.cacheKey):
            outErr = Fmt"provider stage manifest task metadata mismatch index={i}"
            return false
        var objectSnapshot: BackendDriverDispatchMinFileSnapshot
        if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                           task.cacheObjectPath,
                                                           objectSnapshot) ||
           !BackendDriverDispatchMinProviderStageSnapshotMatches(manifestText,
                                                                 Fmt"{prefix}_object",
                                                                 objectSnapshot):
            outErr = Fmt"provider stage object mismatch index={i}"
            return false
        add(out.providerStageArtifactSnapshots, objectSnapshot)
        if task.kind == "source":
            var reportSnapshot: BackendDriverDispatchMinFileSnapshot
            if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                               task.cacheReportPath,
                                                               reportSnapshot) ||
               !BackendDriverDispatchMinProviderStageSnapshotMatches(manifestText,
                                                                     Fmt"{prefix}_report",
                                                                     reportSnapshot):
                outErr = Fmt"provider stage report mismatch index={i}"
                return false
            add(out.providerStageArtifactSnapshots, reportSnapshot)
        elif task.kind == "darwin_syscall":
            if !BackendDriverDispatchMinProviderStageSnapshotEmpty(manifestText,
                                                                  Fmt"{prefix}_report"):
                outErr = Fmt"generated provider stage report fields must be empty index={i}"
                return false
        else:
            outErr = Fmt"provider stage task kind unsupported index={i}"
            return false
    out.providerStageManifestPath = manifestSnapshotAfter.path
    out.providerStageManifestSha256 = manifestSnapshotAfter.sha256
    out.providerStageId = stageId
    out.providerStagePlanSha256 = planSha256
    out.providerStageManifestSnapshot = manifestSnapshotAfter
    if !BackendDriverDispatchMinPinProviderStageArtifacts(driverRoot,
                                                          manifestText,
                                                          tasks,
                                                          out,
                                                          outErr):
        return false
    out.providerStageValidationPassCount = 1
    out.providerStageValidationStatus = "validated_before_provider_cache_use"
    return true

fn BackendDriverDispatchMinRevalidateProviderStage(driverRoot: str,
                                                   out: var BackendDriverDispatchMinProviderBundle,
                                                   phaseName: str,
                                                   outErr: var str): bool =
    outErr = ""
    if out.cacheMode != "require-hit":
        return true
    if phaseName != "before_link" && phaseName != "after_link":
        outErr = Fmt"provider stage validation phase unsupported: {phaseName}"
        return false
    var currentManifest: BackendDriverDispatchMinFileSnapshot
    if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                       out.providerStageManifestPath,
                                                       currentManifest) ||
       !BackendDriverDispatchMinFileSnapshotEqual(currentManifest,
                                                  out.providerStageManifestSnapshot):
        outErr = Fmt"provider stage manifest drift at {phaseName}"
        return false
    for i in 0..<out.providerStageArtifactSnapshots.len:
        let expected = out.providerStageArtifactSnapshots[i]
        var current: BackendDriverDispatchMinFileSnapshot
        if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                           expected.path,
                                                           current) ||
           !BackendDriverDispatchMinFileSnapshotEqual(current, expected):
            outErr = Fmt"provider stage artifact drift at {phaseName} index={i}"
            return false
    if out.providerStagePinnedFds.len != out.providerStageArtifactSnapshots.len + 1 ||
       out.providerStagePinnedPaths.len != out.providerStagePinnedFds.len ||
       !BackendDriverDispatchMinPinnedSnapshotMatches(driverRoot,
                                                      out.providerStagePinnedFds[0],
                                                      out.providerStagePinnedPaths[0],
                                                      out.providerStageManifestSnapshot):
        outErr = Fmt"provider stage manifest fd pin drift at {phaseName}"
        return false
    for i in 0..<out.providerStageArtifactSnapshots.len:
        if !BackendDriverDispatchMinPinnedSnapshotMatches(driverRoot,
                                                          out.providerStagePinnedFds[i + 1],
                                                          out.providerStagePinnedPaths[i + 1],
                                                          out.providerStageArtifactSnapshots[i]):
            outErr = Fmt"provider stage artifact fd pin drift at {phaseName} index={i}"
            return false
    out.providerStageValidationPassCount = out.providerStageValidationPassCount + 1
    if phaseName == "before_link":
        out.providerStageValidationStatus = "validated_before_cache_use_and_before_link"
    elif phaseName == "after_link":
        out.providerStageValidationStatus = "validated_before_cache_use_before_link_after_link"
    return true

@borrows
fn BackendDriverDispatchMinRunExecutable(rootDir: str,
                                          exePath: str,
                                          logPath: str): int32 =
    let command = os.QuoteShell(exePath)
    let run = BackendDriverDispatchMinExecShell(command, rootDir)
    let _ = chengpath.WriteTextFile(rootDir, logPath, run.output)
    return run.exitCode

@borrows
fn BackendDriverDispatchMinCheckNegative(rootDir: str,
                                          label: str,
                                          exitCode: int32,
                                          output: str,
                                          reportPath: str,
                                          outputNeedle: str,
                                          reportNeedle: str): bool =
    if exitCode == 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: verify-export-visibility unexpected success: {label}")
        return false
    if chengpath.TextContains(output, outputNeedle):
        return true
    let reportText = chengpath.ReadTextFile(rootDir, reportPath)
    if chengpath.TextContains(reportText, reportNeedle):
        return true
    BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: verify-export-visibility missing diagnostic: {label}")
    return false

@borrows
fn BackendDriverDispatchMinVerifyExportPositive(rootDir: str,
                                                 compilerPath: str): bool =
    let caseDir = chengpath.PathJoin(BackendDriverDispatchMinArtifactsDir(rootDir), "positive_smoke")
    if !BackendDriverDispatchMinEnsureDir(rootDir, caseDir):
        return false
    let srcPath = chengpath.PathAbsolute(rootDir, "src/tests/export_visibility_smoke.cheng")
    let outPath = chengpath.PathJoin(caseDir, "export_visibility_smoke")
    let logPath = chengpath.PathJoin(caseDir, "export_visibility_smoke.compile.log")
    var output: str
    let compileCode = BackendDriverDispatchMinCompileFixture(rootDir,
                                                              compilerPath,
                                                              rootDir,
                                                              srcPath,
                                                              outPath,
                                                              logPath,
                                                              output)
    if compileCode != 0:
        BackendDriverDispatchMinPrintErr("backend driver direct: verify-export-visibility positive compile failed")
        return false
    let runLogPath = chengpath.PathJoin(caseDir, "export_visibility_smoke.run.log")
    let runCode = BackendDriverDispatchMinRunExecutable(rootDir, outPath, runLogPath)
    if runCode != 0:
        BackendDriverDispatchMinPrintErr("backend driver direct: verify-export-visibility positive run failed")
        return false
    BackendDriverDispatchMinPrintLine("verify-export-visibility export smoke ok")
    return true

@borrows
fn BackendDriverDispatchMinVerifyPrivateNegative(rootDir: str,
                                                  compilerPath: str): bool =
    let caseDir = chengpath.PathJoin(BackendDriverDispatchMinArtifactsDir(rootDir), "private_symbol")
    let packageRoot = chengpath.PathJoin(caseDir, "workspace")
    let helperSrcDir = chengpath.PathJoin(packageRoot, "src/private_helper_pkg")
    let consumerSrcDir = chengpath.PathJoin(packageRoot, "src/private_consumer_pkg")
    if !BackendDriverDispatchMinEnsureDir(rootDir, helperSrcDir):
        return false
    if !BackendDriverDispatchMinEnsureDir(rootDir, consumerSrcDir):
        return false
    if !BackendDriverDispatchMinWriteManifest(rootDir,
                                               packageRoot,
                                               "pkg://cheng",
                                               "cheng"):
        return false
    let helperSrcPath = chengpath.PathJoin(helperSrcDir, "helper.cheng")
    let consumerSrcPath = chengpath.PathJoin(consumerSrcDir, "main.cheng")
    let importKw = "import"
    let helperSource = "fn privateFn(): int32 =\n    return 1\n\nfn PublicFn(): int32 =\n    return 2\n"
    let consumerSource = Fmt"{importKw} cheng/private_helper_pkg/helper as helper\n\nfn main(): int32 =\n    let x = helper.privateFn()\n    return x\n"
    if !chengpath.WriteTextFile(rootDir, helperSrcPath, helperSource):
        return false
    if !chengpath.WriteTextFile(rootDir, consumerSrcPath, consumerSource):
        return false
    let outPath = chengpath.PathJoin(caseDir, "private_symbol")
    let logPath = chengpath.PathJoin(caseDir, "private_symbol.compile.log")
    let reportPath = Fmt"{outPath}.report.txt"
    var output: str
    let exitCode = BackendDriverDispatchMinCompileFixture(rootDir,
                                                           compilerPath,
                                                           packageRoot,
                                                           consumerSrcPath,
                                                           outPath,
                                                           logPath,
                                                           output)
    if !BackendDriverDispatchMinCheckNegative(rootDir,
                                               "private symbol",
                                               exitCode,
                                               output,
                                               reportPath,
                                               "imported private symbol 'privateFn' is not exported",
                                               "unknown_qualified_target:helper:privateFn"):
        return false
    BackendDriverDispatchMinPrintLine("verify-export-visibility private symbol ok")
    return true

@borrows
fn BackendDriverDispatchMinVerifyStrformatCase(rootDir: str,
                                                compilerPath: str,
                                                packageRoot: str,
                                                caseDir: str,
                                                stem: str,
                                                sourceText: str,
                                                outputNeedle: str,
                                                reportNeedle: str): bool =
    let srcDir = chengpath.PathJoin(packageRoot, "src")
    if !BackendDriverDispatchMinEnsureDir(rootDir, srcDir):
        return false
    let srcPath = chengpath.PathJoin(srcDir, Fmt"{stem}.cheng")
    if !chengpath.WriteTextFile(rootDir, srcPath, sourceText):
        return false
    let outPath = chengpath.PathJoin(caseDir, stem)
    let logPath = chengpath.PathJoin(caseDir, Fmt"{stem}.compile.log")
    let reportPath = Fmt"{outPath}.report.txt"
    var output: str
    let exitCode = BackendDriverDispatchMinCompileFixture(rootDir,
                                                           compilerPath,
                                                           packageRoot,
                                                           srcPath,
                                                           outPath,
                                                           logPath,
                                                           output)
    let negativeOk = BackendDriverDispatchMinCheckNegative(rootDir,
                                                           stem,
                                                           exitCode,
                                                           output,
                                                           reportPath,
                                                           outputNeedle,
                                                           reportNeedle)
    return negativeOk

fn BackendDriverDispatchMinVerifyStrformatNegative(rootDir: str,
                                                    compilerPath: str): bool =
    let caseDir = chengpath.PathJoin(BackendDriverDispatchMinArtifactsDir(rootDir), "strformat_private")
    let packageRoot = chengpath.PathJoin(caseDir, "strformat_negative_pkg")
    if !BackendDriverDispatchMinWriteManifest(rootDir,
                                               packageRoot,
                                               "pkg://cheng/strformat_negative_pkg",
                                               "strformat_negative_pkg"):
        return false
    let importKw = "import"
    let fmtSource = Fmt"{importKw} std/strformat as strfmt\n\nfn main(): int32 =\n    let text = strfmt.fmt(\"bad\")\n    echo(text)\n    return 0\n"
    if !BackendDriverDispatchMinVerifyStrformatCase(rootDir,
                                                     compilerPath,
                                                     packageRoot,
                                                     caseDir,
                                                     "fmt_private_main",
                                                     fmtSource,
                                                     "imported private symbol 'fmt' is not exported",
                                                     "unknown_qualified_target:strfmt:fmt"):
        return false
    let linesSource = Fmt"{importKw} std/strformat as strfmt\n\nfn main(): int32 =\n    let text = strfmt.lines(\"bad\")\n    echo(text)\n    return 0\n"
    if !BackendDriverDispatchMinVerifyStrformatCase(rootDir,
                                                     compilerPath,
                                                     packageRoot,
                                                     caseDir,
                                                     "lines_private_main",
                                                     linesSource,
                                                     "imported private symbol 'lines' is not exported",
                                                     "unknown_qualified_target:strfmt:lines"):
        return false
    BackendDriverDispatchMinPrintLine("verify-export-visibility strformat ok")
    return true

fn BackendDriverDispatchMinVerifyExportVisibility(rootDir: str): int32 =
    let compilerPath = BackendDriverDispatchMinCurrentCompiler(rootDir)
    if !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        return BackendDriverDispatchMinUnsupported(Fmt"backend driver direct: missing compiler: {compilerPath}")
    if !BackendDriverDispatchMinVerifyExportPositive(rootDir, compilerPath):
        return 1
    if !BackendDriverDispatchMinVerifyPrivateNegative(rootDir, compilerPath):
        return 1
    if !BackendDriverDispatchMinVerifyStrformatNegative(rootDir, compilerPath):
        return 1
    BackendDriverDispatchMinPrintLine("verify-export-visibility ok")
    return 0

fn BackendDriverDispatchMinVerifyExportVisibilityFromCmdline(): int32 =
    return 2

fn BackendDriverDispatchMinVerifyExportVisibilityParallelFromCmdline(): int32 =
    return 2

fn BackendDriverDispatchMinRunDryCompileConcreteFields(): int32 =
    if BackendDriverDispatchMinParamCount() <= 2:
        return BackendDriverDispatchMinUnsupported("backend driver dry-compile: missing --in")
    let packageRoot = BackendDriverDispatchMinWorkspaceRootFromCmdline()
    var outputPath = BackendDriverDispatchMinReadFlagOrDefault("--out", "")
    let sourcePath = BackendDriverDispatchMinReadFlagOrDefault("--in", "")
    let reportPath = BackendDriverDispatchMinReadFlagOrDefault("--report-out", "")
    let targetTriple = BackendDriverDispatchMinReadFlagOrDefault("--target", "arm64-apple-darwin")
    let emitText = BackendDriverDispatchMinReadFlagOrDefault("--emit", "exe")
    let symbolVisibility = BackendDriverDispatchMinSymbolVisibilityValue(BackendDriverDispatchMinReadKnownFlagOrDefault(10, "--symbol-visibility", ""))
    if !BackendDriverDispatchMinSymbolVisibilitySupported(symbolVisibility):
        let reason = Fmt"backend driver dry-compile: unsupported --symbol-visibility: {symbolVisibility}"
        if len(reportPath) > 0:
            let _ = BackendDriverDispatchMinWriteErrorReportBridge(packageRoot,
                                                                   reportPath,
                                                                   reason)
        return BackendDriverDispatchMinUnsupported(reason)
    let browserBridgeObjectPath = BackendDriverDispatchMinReadFlagOrDefault("--browser-bridge-object", "")
    let emitKindCode = BackendDriverDispatchMinEmitKindCode(emitText)
    if emitKindCode < 0:
        let reason = Fmt"backend driver dry-compile: unsupported --emit: {emitText}"
        if len(reportPath) > 0:
            let _ = BackendDriverDispatchMinWriteErrorReportBridge(packageRoot,
                                                                   reportPath,
                                                                   reason)
        return BackendDriverDispatchMinUnsupported(reason)
    var emitKind = creq.CompilerEmitExeValue()
    if emitKindCode == 1:
        emitKind = creq.CompilerEmitObjValue()
    elif emitKindCode == 2:
        emitKind = creq.CompilerEmitSharedValue()
    if len(sourcePath) <= 0:
        let reason = "backend driver dry-compile: missing --in"
        if len(reportPath) > 0:
            let _ = BackendDriverDispatchMinWriteErrorReportBridge(packageRoot,
                                                                   reportPath,
                                                                   reason)
        return BackendDriverDispatchMinUnsupported(reason)
    if len(outputPath) <= 0:
        outputPath = "artifacts/dry-compile/dry-output"
    var phaseProfile: BackendDriverDispatchMinPhaseProfile
    let dryCompileStartNs = BackendDriverDispatchMinNowNs()
    phaseProfile.totalStartNs = dryCompileStartNs
    var linkPlan: slplan.SystemLinkPlanStub
    var err: str
    let systemLinkPlanStartNs = BackendDriverDispatchMinMonoTimeNsBridge()
    BackendDriverDispatchMinProgress("system_link_plan", "begin")
    let initialExternalPackageRoots =
        BackendDriverDispatchMinDefaultExternalPackageRoots(packageRoot,
                                                            packageRoot)
    let planOk = slplan.BuildSystemLinkPlanStubWithFieldsAndExternalPackageRoots(
        packageRoot,
        packageRoot,
        sourcePath,
        outputPath,
        targetTriple,
        emitKind,
        symbolVisibility,
        browserBridgeObjectPath,
        initialExternalPackageRoots,
        linkPlan,
        err)
    if !planOk:
        let _ = BackendDriverDispatchMinWriteErrorReportBridge(packageRoot,
                                                               reportPath,
                                                               err)
        return BackendDriverDispatchMinUnsupported(err)
    var jobsErr: str
    if !BackendDriverDispatchMinApplyRequestedJobsControl(linkPlan, jobsErr):
        let _ = BackendDriverDispatchMinWriteErrorReportBridge(packageRoot,
                                                               reportPath,
                                                               jobsErr)
        return BackendDriverDispatchMinUnsupported(jobsErr)
    linkPlan.exportRootSymbols = BackendDriverDispatchMinSplitCsv(BackendDriverDispatchMinReadKnownFlagOrDefault(6, "--export-roots", ""))
    phaseProfile.systemLinkPlanNs = BackendDriverDispatchMinMonoTimeNsBridge() - systemLinkPlanStartNs
    BackendDriverDispatchMinProgress("system_link_plan", "done")
    return BackendDriverDispatchMinRunDryCompileConcretePlan(packageRoot,
                                                             reportPath,
                                                             linkPlan,
                                                             sourcePath,
                                                             dryCompileStartNs,
                                                             phaseProfile)

@borrows
fn BackendDriverDispatchMinCheckDriverSafe(driverRoot: str,
                                           reportPath: str,
                                           linkPlan: var slplan.SystemLinkPlanStub,
                                           entrySourcePath: str,
                                           entrySourceText: str,
                                           err: var str): bool =
    var driverSafe: dsafe.DriverSafeContractResult
    if dsafe.DriverSafeContractCheckEntry(driverRoot,
                                          linkPlan,
                                          entrySourcePath,
                                          entrySourceText,
                                          driverSafe):
        err = ""
        return true
    err = driverSafe.firstError
    if Len(err) <= 0:
        err = "driver_safe contract failed"
    var report: str
    dsafe.DriverSafeContractAppendReport(report, driverSafe)
    BackendDriverDispatchMinAppendLine(report, Fmt"error={err}")
    let _ = BackendDriverDispatchMinWriteReport(driverRoot, reportPath, report)
    return false

fn BackendDriverDispatchMinRunDryCompileConcretePlan(driverRoot: str,
                                                      reportPath: str,
                                                      linkPlan: var slplan.SystemLinkPlanStub,
                                                      entrySourcePath: str,
                                                      dryCompileStartNs: int64,
                                                      phaseProfile: var BackendDriverDispatchMinPhaseProfile): int32 =
    var entrySourceText = chengpath.ReadTextFile("", entrySourcePath)
    if entrySourceText.len <= 0:
        let readErr = Fmt"backend driver dry-compile: failed to read entry source: {entrySourcePath}"
        let _ = BackendDriverDispatchMinWriteErrorReportBridge(driverRoot,
                                                               reportPath,
                                                               readErr)
        return BackendDriverDispatchMinUnsupported(readErr)
    var driverSafeErr: str
    if !BackendDriverDispatchMinCheckDriverSafe(driverRoot,
                                                reportPath,
                                                linkPlan,
                                                entrySourcePath,
                                                entrySourceText,
                                                driverSafeErr):
        return BackendDriverDispatchMinUnsupported(driverSafeErr)
    entrySourceText = ""
    var sourcePaths: str[]
    var importEdges: parser.ImportEdge[]
    var importEdgeCount: int32
    var unresolvedImportCount: int32
    var sourceClosureErr: str
    var sourceStats: BackendDriverDispatchMinDryCompileSourceStats
    let externalPackageRoots = BackendDriverDispatchMinDefaultExternalPackageRoots(driverRoot, linkPlan.packageRoot)
    let sourceClosureStartNs = BackendDriverDispatchMinNowNs()
    BackendDriverDispatchMinProgress("source_closure", "begin")
    if !BackendDriverDispatchMinDryCompileCollectSourceClosureWithStats(driverRoot,
                                                                        linkPlan.packageRoot,
                                                                        entrySourcePath,
                                                                        externalPackageRoots,
                                                                        true,
                                                                        sourceStats,
                                                                        sourcePaths,
                                                                        importEdges,
                                                                        importEdgeCount,
                                                                        unresolvedImportCount,
                                                                        sourceClosureErr):
        let _ = BackendDriverDispatchMinWriteErrorReportBridge(driverRoot,
                                                               reportPath,
                                                               sourceClosureErr)
        return BackendDriverDispatchMinUnsupported(sourceClosureErr)
    let sourceClosureNs = BackendDriverDispatchMinNowNs() - sourceClosureStartNs
    BackendDriverDispatchMinProgress("source_closure", "done")
    var sourceBundleErr: str
    BackendDriverDispatchMinProgress("source_bundle_bind", "begin")
    if !slplan.SystemLinkPlanBindSourceClosureGraphFromFiles(
            linkPlan,
            externalPackageRoots,
            sourcePaths,
            importEdges,
            importEdgeCount,
            unresolvedImportCount,
            sourceBundleErr):
        let bindErr = Fmt"backend driver dry-compile: {sourceBundleErr}"
        let _ = BackendDriverDispatchMinWriteErrorReportBridge(driverRoot,
                                                               reportPath,
                                                               bindErr)
        return BackendDriverDispatchMinUnsupported(bindErr)
    var sourceManifestBindErr: str
    if !BackendDriverDispatchMinDryCompileSourceStatsMatchBoundPlan(
            sourceStats, linkPlan, sourceManifestBindErr):
        let bindErr =
            Fmt"backend driver dry-compile: {sourceManifestBindErr}"
        let _ = BackendDriverDispatchMinWriteErrorReportBridge(driverRoot,
                                                               reportPath,
                                                               bindErr)
        return BackendDriverDispatchMinUnsupported(bindErr)
    # Source-bundle sealing owns no source text after return.  Hand allocator
    # pages from its exact import/CID scratch back at the phase boundary before
    # report assembly starts.
    let _drySourceBundleBindRelief = os.ProcessMemoryPressureRelief()
    BackendDriverDispatchMinProgress("source_bundle_bind", "done")
    BackendDriverDispatchMinRecordSourceClosureAfter(linkPlan.sourceClosurePaths,
                                                     linkPlan.sourceBundleIdentityPaths,
                                                     importEdgeCount)
    phaseProfile.compilerCsgNs = 0
    phaseProfile.loweringPlanNs = 0
    phaseProfile.primaryObjectPlanNs = 0
    dryCompileStartNs
    phaseProfile.totalNs = phaseProfile.systemLinkPlanNs + sourceClosureNs
    var report: str
    BackendDriverDispatchMinRecordReportPayloadAssemblyBefore()
    let reportAssemblyStartNs = BackendDriverDispatchMinNowNs()
    let ok = BackendDriverDispatchMinAppendDryCompileReport(report,
                                                            driverRoot,
                                                            linkPlan,
                                                            sourceStats,
                                                            importEdgeCount,
                                                            unresolvedImportCount,
                                                            sourceClosureNs,
                                                            phaseProfile)
    BackendDriverDispatchMinAppendPhaseMemoryLedgerReport(report)
    let reportAssemblyNs = BackendDriverDispatchMinNowNs() - reportAssemblyStartNs
    let dryActualNs = phaseProfile.systemLinkPlanNs + sourceClosureNs + reportAssemblyNs
    BackendDriverDispatchMinAppendLine(report, Fmt"exec_phase_report_payload_assembly_ns={reportAssemblyNs}")
    BackendDriverDispatchMinAppendLine(report, Fmt"exec_phase_report_payload_assembly_ms={BackendDriverDispatchMinPhaseMsText(reportAssemblyNs)}")
    BackendDriverDispatchMinAppendLine(report, Fmt"exec_phase_dry_actual_total_ns={dryActualNs}")
    BackendDriverDispatchMinAppendLine(report, Fmt"exec_phase_dry_actual_total_ms={BackendDriverDispatchMinPhaseMsText(dryActualNs)}")
    if len(reportPath) > 0 && !BackendDriverDispatchMinWriteReport(driverRoot, reportPath, report):
        return BackendDriverDispatchMinUnsupported(Fmt"backend driver dry-compile: failed to write report: {reportPath}")
    BackendDriverDispatchMinPrintLine(report)
    if !ok:
        return 2
    if linkPlan.missingReasons.len > 0:
        return 2
    return 0

fn BackendDriverDispatchMinIsTargetSupported(triple: str): bool =
    if tmat.TargetIsDarwinA64(triple):
        return true
    if tmat.TargetIsLinuxA64(triple):
        return true
    if triple == "riscv64-unknown-linux-gnu":
        return true
    if triple == "riscv64-unknown-none-elf":
        return true
    if triple == "riscv32-esp32s31-none-elf":
        return true
    if triple == "esp32s31":
        return true
    if triple == "riscv32-unknown-linux-gnu":
        return true
    if triple == "riscv32-unknown-none-elf":
        return true
    if tmat.TargetIsAndroidA64(triple):
        return true
    if tmat.TargetIsOhosA64(triple):
        return true
    # inline triple check: tmat.TargetIsLinuxX64 is a cross-module leaf-bool
    # that the cold (cheng_cold.c) codegen miscompiles to return false (findings
    # wave-30 cold bug #1, 4 repro坐实). Inline the equality so the check stays
    # in-module — matches the documented workaround "dispatch_min 内联 triple 判等".
    if triple == "x86_64-unknown-linux-gnu":
        return true
    return false

@borrows
@borrow_result
fn BackendDriverDispatchMinBaseName(path: str): str =
    return path

fn BackendDriverDispatchMinOhosClang(): str =
    let configured = os.GetEnv("OHOS_AARCH64_CLANG")
    if len(configured) > 0:
        return strings.CloneStr(configured)
    return strings.CloneStr("/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/native/llvm/bin/aarch64-unknown-linux-ohos-clang")

@borrows
fn BackendDriverDispatchMinAndroidClangCandidate(ndkHome: str,
                                                  hostName: str,
                                                  apiLevel: str): str =
    let candidate = strutil.Join([strings.CloneStr(ndkHome),
                                  "/toolchains/llvm/prebuilt/",
                                  strings.CloneStr(hostName),
                                  "/bin/aarch64-linux-android",
                                  strings.CloneStr(apiLevel),
                                  "-clang"], "")
    return candidate

fn BackendDriverDispatchMinAndroidClang(): str =
    let configured = os.GetEnv("ANDROID_AARCH64_CLANG")
    if len(configured) > 0:
        return strings.CloneStr(configured)
    let ndkHome = os.GetEnv("ANDROID_NDK_HOME")
    let ndkHome2 = os.GetEnv("NDK_HOME")
    let effectiveNdkHome = len(ndkHome) > 0 ? strings.CloneStr(ndkHome) : strings.CloneStr(ndkHome2)
    if len(effectiveNdkHome) <= 0:
        let sdkHome = os.GetEnv("ANDROID_HOME")
        let sdkHome2 = os.GetEnv("ANDROID_SDK_ROOT")
        let effectiveSdkHome = len(sdkHome) > 0 ? strings.CloneStr(sdkHome) : strings.CloneStr(sdkHome2)
        if len(effectiveSdkHome) > 0:
            let api35 = BackendDriverDispatchMinAndroidClangCandidate(strutil.Join([strings.CloneStr(effectiveSdkHome), "/ndk/29.0.13599879"], ""), "darwin-x86_64", "35")
            if chengpath.PathFileExists(api35):
                return strings.CloneStr(api35)
            let api21 = BackendDriverDispatchMinAndroidClangCandidate(strutil.Join([strings.CloneStr(effectiveSdkHome), "/ndk/26.3.11579264"], ""), "darwin-x86_64", "21")
            if chengpath.PathFileExists(api21):
                return strings.CloneStr(api21)
            let api21Arm = BackendDriverDispatchMinAndroidClangCandidate(strutil.Join([strings.CloneStr(effectiveSdkHome), "/ndk/26.3.11579264"], ""), "darwin-arm64", "21")
            if chengpath.PathFileExists(api21Arm):
                return strings.CloneStr(api21Arm)
    if len(effectiveNdkHome) > 0:
        let api21DarwinX64 = BackendDriverDispatchMinAndroidClangCandidate(effectiveNdkHome, "darwin-x86_64", "21")
        if chengpath.PathFileExists(api21DarwinX64):
            return strings.CloneStr(api21DarwinX64)
        let api21DarwinA64 = BackendDriverDispatchMinAndroidClangCandidate(effectiveNdkHome, "darwin-arm64", "21")
        if chengpath.PathFileExists(api21DarwinA64):
            return strings.CloneStr(api21DarwinA64)
        let api21LinuxX64 = BackendDriverDispatchMinAndroidClangCandidate(effectiveNdkHome, "linux-x86_64", "21")
        if chengpath.PathFileExists(api21LinuxX64):
            return strings.CloneStr(api21LinuxX64)
    var empty: str
    return empty

fn BackendDriverDispatchMinShellJoinInputs(inputs: str[]): str =
    var parts: str[]
    for i in 0..<inputs.len:
        add(parts, strings.CloneStr(os.QuoteShell(strings.CloneStr(inputs[i]))))
    return strutil.Join(parts, " ")

fn BackendDriverDispatchMinSharedLinkCommandInputs(targetTriple: str,
                                                   objectInputs: str[],
                                                   outputPath: str): str =
    if objectInputs.len <= 0:
        var empty: str
        return empty
    let inputText = BackendDriverDispatchMinShellJoinInputs(objectInputs)
    let outQ = strings.CloneStr(os.QuoteShell(strings.CloneStr(outputPath)))
    var parts: str[]
    if tmat.TargetIsAndroidA64(targetTriple):
        let clang = BackendDriverDispatchMinAndroidClang()
        if len(clang) <= 0:
            var emptyAndroid: str
            return emptyAndroid
        let sonameQ = strings.CloneStr(os.QuoteShell(BackendDriverDispatchMinBaseName(strings.CloneStr(outputPath))))
        add(parts, strings.CloneStr(os.QuoteShell(strings.CloneStr(clang))))
        add(parts, strings.CloneStr(" -shared -fPIC "))
        add(parts, strings.CloneStr(inputText))
        add(parts, strings.CloneStr(" -Wl,--no-undefined -Wl,-soname,"))
        add(parts, sonameQ)
        add(parts, strings.CloneStr(" -ldl -lm -o "))
        add(parts, outQ)
        return strutil.Join(parts, "")
    if tmat.TargetIsOhosA64(targetTriple):
        let clang = BackendDriverDispatchMinOhosClang()
        if !chengpath.PathFileExists(clang):
            var emptyOhos: str
            return emptyOhos
        let sonameQ = strings.CloneStr(os.QuoteShell(BackendDriverDispatchMinBaseName(strings.CloneStr(outputPath))))
        add(parts, strings.CloneStr(os.QuoteShell(strings.CloneStr(clang))))
        add(parts, strings.CloneStr(" -shared -fPIC "))
        add(parts, strings.CloneStr(inputText))
        add(parts, strings.CloneStr(" -Wl,--no-undefined -Wl,-soname,"))
        add(parts, sonameQ)
        add(parts, strings.CloneStr(" -ldl -lm -o "))
        add(parts, outQ)
        return strutil.Join(parts, "")
    if tmat.TargetIsDarwinA64(targetTriple):
        add(parts, strings.CloneStr("cc -arch arm64 -dynamiclib "))
        add(parts, strings.CloneStr(inputText))
        add(parts, strings.CloneStr(" -o "))
        add(parts, outQ)
        return strutil.Join(parts, "")
    add(parts, strings.CloneStr("cc -shared -fPIC "))
    add(parts, strings.CloneStr(inputText))
    add(parts, strings.CloneStr(" -o "))
    add(parts, outQ)
    return strutil.Join(parts, "")

fn BackendDriverDispatchMinSharedLinkCommand(targetTriple: str,
                                              objectPath: str,
                                              outputPath: str): str =
    var inputs: str[]
    add(inputs, strings.CloneStr(objectPath))
    return BackendDriverDispatchMinSharedLinkCommandInputs(targetTriple, inputs, outputPath)

fn BackendDriverDispatchMinPlanProviderObjectPathsLen(plan: var slplan.SystemLinkPlanStub): int32 =
    return plan.providerObjectPaths.len

fn BackendDriverDispatchMinBundleObjectPathsLen(bundle: var BackendDriverDispatchMinProviderBundle): int32 =
    return bundle.objectPaths.len

fn BackendDriverDispatchMinAppendProviderLinkInputs(driverRoot: str,
                                                    linkPlan: var slplan.SystemLinkPlanStub,
                                                    providerBundle: var BackendDriverDispatchMinProviderBundle,
                                                    linkInputs: var str[]) =
    for i in 0..<BackendDriverDispatchMinPlanProviderObjectPathsLen(linkPlan):
        add(linkInputs, chengpath.PathAbsolute(driverRoot, linkPlan.providerObjectPaths[i]))
    for i in 0..<BackendDriverDispatchMinBundleObjectPathsLen(providerBundle):
        add(linkInputs, chengpath.PathAbsolute(driverRoot, providerBundle.objectPaths[i]))

fn BackendDriverDispatchMinPinExplicitProviderInputs(driverRoot: str,
                                                     linkPlan: var slplan.SystemLinkPlanStub,
                                                     providerBundle: var BackendDriverDispatchMinProviderBundle,
                                                     pinnedPaths: var str[],
                                                     canonicalPaths: var str[],
                                                     contentSha256s: var str[],
                                                     sizes: var str[]): bool =
    pinnedPaths = []
    canonicalPaths = []
    contentSha256s = []
    sizes = []
    for i in 0..<linkPlan.providerObjectPaths.len:
        var snapshot: BackendDriverDispatchMinFileSnapshot
        if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                           linkPlan.providerObjectPaths[i],
                                                           snapshot):
            return false
        var fd: int32
        var pinnedPath: str
        if !BackendDriverDispatchMinPinFileSnapshot(driverRoot,
                                                    snapshot,
                                                    fd,
                                                    pinnedPath):
            return false
        add(providerBundle.providerObjectPinnedFds, fd)
        add(pinnedPaths, pinnedPath)
        add(canonicalPaths, strings.CloneStr(snapshot.path))
        add(contentSha256s, strings.CloneStr(snapshot.sha256))
        add(sizes, strings.CloneStr(snapshot.size))
    return true

fn BackendDriverDispatchMinCollectCertifiedProviderInputs(driverRoot: str,
                                                          linkPlan: var slplan.SystemLinkPlanStub,
                                                          providerBundle: var BackendDriverDispatchMinProviderBundle,
                                                          linkPaths: str[],
                                                          explicitCanonicalPaths: str[],
                                                          explicitContentSha256s: str[],
                                                          explicitSizes: str[],
                                                          canonicalPaths: var str[],
                                                          contentSha256s: var str[]): bool =
    canonicalPaths = []
    contentSha256s = []
    if linkPaths.len != linkPlan.providerObjectPaths.len + providerBundle.objectPaths.len ||
       explicitCanonicalPaths.len != linkPlan.providerObjectPaths.len ||
       explicitContentSha256s.len != linkPlan.providerObjectPaths.len ||
       explicitSizes.len != linkPlan.providerObjectPaths.len ||
       providerBundle.reportObjectPaths.len != providerBundle.objectPaths.len ||
       providerBundle.reportObjectSha256s.len != providerBundle.objectPaths.len ||
       providerBundle.reportObjectSizes.len != providerBundle.objectPaths.len:
        return false
    for i in 0..<linkPaths.len:
        var linkedSnapshot: BackendDriverDispatchMinFileSnapshot
        if !BackendDriverDispatchMinReadStableFileSnapshot(driverRoot,
                                                           linkPaths[i],
                                                           linkedSnapshot):
            return false
        if i < linkPlan.providerObjectPaths.len:
            if linkedSnapshot.sha256 != explicitContentSha256s[i] ||
               linkedSnapshot.size != explicitSizes[i]:
                return false
            add(canonicalPaths, strings.CloneStr(explicitCanonicalPaths[i]))
            add(contentSha256s, strings.CloneStr(explicitContentSha256s[i]))
        else:
            let runtimeIndex = i - linkPlan.providerObjectPaths.len
            if linkedSnapshot.sha256 != providerBundle.reportObjectSha256s[runtimeIndex] ||
               linkedSnapshot.size != providerBundle.reportObjectSizes[runtimeIndex]:
                return false
            add(canonicalPaths, strings.CloneStr(providerBundle.reportObjectPaths[runtimeIndex]))
            add(contentSha256s, strings.CloneStr(providerBundle.reportObjectSha256s[runtimeIndex]))
    return true

fn BackendDriverDispatchMinAppendProviderObjectReport(out: var str,
                                                      linkPlan: var slplan.SystemLinkPlanStub,
                                                      providerBundle: var BackendDriverDispatchMinProviderBundle) =
    var reportProviderObjectPaths: str[]
    for i in 0..<linkPlan.providerObjectPaths.len:
        add(reportProviderObjectPaths, strings.CloneStr(linkPlan.providerObjectPaths[i]))
    for i in 0..<providerBundle.objectPaths.len:
        add(reportProviderObjectPaths, strings.CloneStr(providerBundle.objectPaths[i]))
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_count={reportProviderObjectPaths.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_paths={slplan.SystemLinkPlanListText(reportProviderObjectPaths)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"explicit_provider_object_count={linkPlan.providerObjectPaths.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"explicit_provider_object_paths={slplan.SystemLinkPlanListText(linkPlan.providerObjectPaths)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"runtime_provider_object_count={providerBundle.objectPaths.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"runtime_provider_object_paths={slplan.SystemLinkPlanListText(providerBundle.objectPaths)}")
    BackendDriverDispatchMinAppendLine(out, "provider_cache_key_schema=provider_cache_content")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_mode={providerBundle.cacheMode}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_directory={providerBundle.cacheDirectory}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_compiler_sha256={providerBundle.compilerSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_task_count={providerBundle.cacheTaskCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_hit_count={providerBundle.cacheHitCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_miss_count={providerBundle.cacheMissCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_nested_compile_count={providerBundle.nestedCompileCount}")
    if providerBundle.cacheMode == "require-hit":
        BackendDriverDispatchMinAppendLine(out, "provider_execution_fork_contract=require_hit_cache_only_no_provider_spawn")
    else:
        BackendDriverDispatchMinAppendLine(out, "provider_execution_fork_contract=allow_build_may_spawn_provider_compile")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_manifest_path={providerBundle.providerStageManifestPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_manifest_sha256={providerBundle.providerStageManifestSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_id={providerBundle.providerStageId}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_plan_sha256={providerBundle.providerStagePlanSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_validation_status={providerBundle.providerStageValidationStatus}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_validation_pass_count={providerBundle.providerStageValidationPassCount}")
    if providerBundle.cacheMode == "require-hit":
        BackendDriverDispatchMinAppendLine(out, "provider_stage_artifact_binding=pre_post_sha256_dev_inode_size_mtime_ctime_plus_pinned_fd_link_inputs")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_fd_pin=1")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_closed=1")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_model=pinned_fd_link_inputs_with_path_and_fd_revalidation")
    else:
        BackendDriverDispatchMinAppendLine(out, "provider_stage_artifact_binding=none")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_fd_pin=0")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_closed=0")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_model=not_applicable_allow_build")

@borrows
fn BackendDriverDispatchMinReportTextHex(value: str): str =
    var raw = rawbytes.BytesAlloc(len(value))
    if rawbytes.BytesLen(raw) != len(value):
        rawbytes.BytesFree(raw)
        return ""
    for i in 0..<len(value):
        rawbytes.BytesSet(raw, i, int32(value[i]) & 255)
    let out = rawbytes.BytesToHex(raw)
    rawbytes.BytesFree(raw)
    return out

fn BackendDriverDispatchMinAppendCertifiedProviderObjectReport(out: var str,
                                                               linkPlan: var slplan.SystemLinkPlanStub,
                                                               providerBundle: var BackendDriverDispatchMinProviderBundle,
                                                               receipt: macholink.MachoProviderLinkReceipt) =
    var paths: str[]
    var hashes: str[]
    var sizes: str[]
    var explicitPaths: str[]
    var runtimePaths: str[]
    for i in 0..<receipt.providerEvidence.len:
        let evidence = receipt.providerEvidence[i]
        add(paths, strings.CloneStr(evidence.inputCanonicalPath))
        add(hashes, strings.CloneStr(evidence.inputContentSha256))
        add(sizes, strings.Int64ToStr(evidence.inputSize))
        if i < linkPlan.providerObjectPaths.len:
            add(explicitPaths, strings.CloneStr(evidence.inputCanonicalPath))
        else:
            add(runtimePaths, strings.CloneStr(evidence.inputCanonicalPath))
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_count={paths.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_paths={slplan.SystemLinkPlanListText(paths)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_sha256s={slplan.SystemLinkPlanListText(hashes)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_sizes={slplan.SystemLinkPlanListText(sizes)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"explicit_provider_object_count={explicitPaths.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"explicit_provider_object_paths={slplan.SystemLinkPlanListText(explicitPaths)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"runtime_provider_object_count={runtimePaths.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"runtime_provider_object_paths={slplan.SystemLinkPlanListText(runtimePaths)}")
    BackendDriverDispatchMinAppendLine(out, "provider_cache_key_schema=provider_cache_content")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_mode={providerBundle.cacheMode}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_directory={providerBundle.cacheDirectory}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_compiler_sha256={providerBundle.compilerSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_task_count={providerBundle.cacheTaskCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_hit_count={providerBundle.cacheHitCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_cache_miss_count={providerBundle.cacheMissCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_nested_compile_count={providerBundle.nestedCompileCount}")
    if providerBundle.cacheMode == "require-hit":
        BackendDriverDispatchMinAppendLine(out, "provider_execution_fork_contract=require_hit_cache_only_no_provider_spawn")
    else:
        BackendDriverDispatchMinAppendLine(out, "provider_execution_fork_contract=allow_build_may_spawn_provider_compile")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_manifest_path={providerBundle.providerStageManifestPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_manifest_sha256={providerBundle.providerStageManifestSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_id={providerBundle.providerStageId}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_plan_sha256={providerBundle.providerStagePlanSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_validation_status={providerBundle.providerStageValidationStatus}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_stage_validation_pass_count={providerBundle.providerStageValidationPassCount}")
    if providerBundle.cacheMode == "require-hit":
        BackendDriverDispatchMinAppendLine(out, "provider_stage_artifact_binding=pre_post_sha256_dev_inode_size_mtime_ctime_plus_pinned_fd_link_inputs")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_fd_pin=1")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_closed=1")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_model=pinned_fd_link_inputs_with_path_and_fd_revalidation")
    else:
        BackendDriverDispatchMinAppendLine(out, "provider_stage_artifact_binding=stable_input_fd_plus_content_hash_and_cache_binding")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_fd_pin=1")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_closed=1")
        BackendDriverDispatchMinAppendLine(out, "provider_stage_toctou_model=compiler_and_sources_pre_post_hash_plus_pinned_cache_object")

fn BackendDriverDispatchMinAppendProviderBindingReport(out: var str,
                                                        receipt: macholink.MachoProviderLinkReceipt,
                                                        matchesPinReceipt: bool): bool =
    if receipt.providerObjectCount <= 0 ||
       receipt.providerEvidence.len != receipt.providerObjectCount:
        return false
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_content_sha256={receipt.providerObjectContentSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_binding_schema={receipt.providerObjectBindingSchema}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_binding_storage={receipt.providerObjectBindingStorage}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_canonical_path_hex={BackendDriverDispatchMinReportTextHex(receipt.outputCanonicalPath)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_sha256={receipt.outputFileSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_device={receipt.outputFileDevice}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_inode={receipt.outputFileInode}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_size={receipt.outputFileSize}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_mtime_sec={receipt.outputFileMtimeSec}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_mtime_nsec={receipt.outputFileMtimeNsec}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_ctime_sec={receipt.outputFileCtimeSec}")
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_output_ctime_nsec={receipt.outputFileCtimeNsec}")
    let evidenceLinesRes = macholink.MachoProviderEvidenceReportLines(receipt)
    if !evidenceLinesRes.ok:
        return false
    let evidenceLines = evidenceLinesRes.value
    for i in 0..<evidenceLines.len:
        BackendDriverDispatchMinAppendLine(out, evidenceLines[i])
    let proofLinesRes = macholink.MachoProviderProofReportLines(receipt)
    if !proofLinesRes.ok:
        return false
    let proofLines = proofLinesRes.value
    for i in 0..<proofLines.len:
        BackendDriverDispatchMinAppendLine(out, proofLines[i])
    BackendDriverDispatchMinAppendLine(out, "provider_object_binding_signed=1")
    BackendDriverDispatchMinAppendLine(out, "provider_object_binding_matches_read_bytes=1")
    BackendDriverDispatchMinAppendLine(out, "provider_object_binding_matches_prelink_receipt=1")
    var pinReceiptStatus = "0"
    if matchesPinReceipt:
        pinReceiptStatus = "1"
    BackendDriverDispatchMinAppendLine(out, Fmt"provider_object_binding_matches_pin_receipt={pinReceiptStatus}")
    BackendDriverDispatchMinAppendLine(out, "provider_object_binding_status=proved")
    return true

fn BackendDriverDispatchMinProviderEvidenceReportExact(report: str,
                                                        receipt: macholink.MachoProviderLinkReceipt): bool =
    let reportLines = strutil.Split(report, '\n')
    var evidenceLines: str[]
    var proofLines: str[]
    for i in 0..<reportLines.len:
        if strutil.StartsWith(reportLines[i], "provider_evidence_"):
            add(evidenceLines, strings.CloneStr(reportLines[i]))
        if strutil.StartsWith(reportLines[i], "provider_proof_"):
            add(proofLines, strings.CloneStr(reportLines[i]))
    return macholink.MachoProviderEvidenceReportLinesMatch(evidenceLines,
                                                           receipt) &&
           macholink.MachoProviderProofReportLinesMatch(proofLines,
                                                        receipt)

fn BackendDriverDispatchMinAppendRegallocDeferReceiptReport(
        out: var str,
        plan: var sexec.SystemLinkExecPlan,
        err: var str): bool =
    let deferReceiptCount =
        plan.primaryObjectPlan.regallocDeferActionCids.len
    if plan.primaryObjectPlan.regallocDeferFunctionRows.len !=
           deferReceiptCount ||
       plan.primaryObjectPlan.regallocDeferStatementRows.len !=
           deferReceiptCount ||
       plan.primaryObjectPlan.regallocDeferFragmentCids.len !=
           deferReceiptCount:
        err =
            "backend driver: regalloc defer receipt column length mismatch"
        return false
    let backendRole = plan.primaryObjectPlan.actualBackendKind
    if (backendRole != "primary" && backendRole != "backend2") ||
       backendRole !=
           creq.CompilerBackendKindText(plan.requestBackendKind):
        err =
            "backend driver: regalloc defer receipt backend role mismatch"
        return false
    BackendDriverDispatchMinAppendLine(
        out, Fmt"defer_receipt_count={deferReceiptCount}")
    BackendDriverDispatchMinAppendLine(
        out, Fmt"defer_receipt_backend_role={backendRole}")
    for receiptIndex in 0..<deferReceiptCount:
        if plan.primaryObjectPlan.regallocDeferFunctionRows[
               receiptIndex] < 0 ||
           plan.primaryObjectPlan.regallocDeferStatementRows[
               receiptIndex] < 0 ||
           layout.FixedBytes32Equal(
               plan.primaryObjectPlan.regallocDeferActionCids[
                   receiptIndex],
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               plan.primaryObjectPlan.regallocDeferFragmentCids[
                   receiptIndex],
               layout.FixedBytes32()):
            err =
                Fmt"backend driver: invalid regalloc defer receipt row={receiptIndex}"
            return false
        let receiptPrefix = Fmt"defer_receipt.{receiptIndex}"
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"{receiptPrefix}.function_row={plan.primaryObjectPlan.regallocDeferFunctionRows[receiptIndex]}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"{receiptPrefix}.statement_row={plan.primaryObjectPlan.regallocDeferStatementRows[receiptIndex]}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"{receiptPrefix}.target={plan.primaryObjectPlan.targetTriple}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"{receiptPrefix}.action_cid={layout.FixedBytes32Hex(plan.primaryObjectPlan.regallocDeferActionCids[receiptIndex])}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"{receiptPrefix}.fragment_cid={layout.FixedBytes32Hex(plan.primaryObjectPlan.regallocDeferFragmentCids[receiptIndex])}")
    err = ""
    return true

@borrows
fn BackendDriverDispatchMinEmitCsgQuerySrcLayoutRoot(queryRoot: str): str =
    if queryRoot == "/":
        return "/src"
    return Fmt"{queryRoot}/src"

@borrows
fn BackendDriverDispatchMinEmitCsgBasenamePackageId(queryRoot: str): str =
    if queryRoot == "" || queryRoot == "/":
        return ""
    var lastSep: int32 = -1
    for i in 0..<queryRoot.len:
        if queryRoot[i] == '/' || queryRoot[i] == '\\':
            lastSep = i
    var name: str
    if lastSep >= 0:
        name = chengpath.TextSlice(queryRoot,
                                   lastSep + 1,
                                   queryRoot.len - lastSep - 1)
    else:
        name = queryRoot
    if name == "cheng-lang":
        return "cheng"
    if name == "":
        return ""
    return Fmt"cheng/{name}"

@borrows
fn BackendDriverDispatchMinEmitCsgEnsurePackageManifestInto(
        queryRoot: str,
        err: var str): bool =
    let manifestPath = Fmt"{queryRoot}/cheng-package.toml"
    if chengpath.PathFileExists(manifestPath):
        err = ""
        return true
    let packageId = BackendDriverDispatchMinEmitCsgBasenamePackageId(queryRoot)
    if packageId == "" ||
       !parser.ParserSourceIdentityModuleTextValid(packageId):
        err = Fmt"backend driver emit-csg: package identity unavailable root={queryRoot}"
        return false
    if !chengpath.WriteTextFile(
           queryRoot,
           "cheng-package.toml",
           Fmt"package_id = \"pkg://{packageId}\"\n"):
        err = Fmt"backend driver emit-csg: failed to write package manifest root={queryRoot}"
        return false
    err = ""
    return true

@borrows
fn BackendDriverDispatchMinEmitCsgMaterializeQuerySrcSourceInto(
        destRoot: str,
        sourcePath: str,
        outSrcPath: var str,
        err: var str): bool =
    outSrcPath = ""
    let stem = parser.ParserFileStem(sourcePath)
    if stem == "" || !parser.ParserSourceIdentityModuleTextValid(stem):
        err = Fmt"backend driver emit-csg: source stem is not a module identity source={sourcePath}"
        return false
    let srcDir = BackendDriverDispatchMinEmitCsgQuerySrcLayoutRoot(destRoot)
    if !chengpath.MkdirP(destRoot, srcDir):
        err = Fmt"backend driver emit-csg: failed to create src layout dir={srcDir}"
        return false
    var srcPath: str
    if !parser.ParserSourceIdentityLexicalPathInto(
           Fmt"{srcDir}/{stem}.cheng", srcPath):
        err = "backend driver emit-csg: src layout path is not a canonical path"
        return false
    if srcPath != sourcePath:
        var emptyRoots: parser.ParserExternalPackageRoot[]
        emptyRoots = []
        var sourceText: str
        if !parser.ParserSourceTextWithExternalPackageRootsInto(
               sourcePath,
               emptyRoots,
               sourceText,
               err):
            if err == "":
                err = Fmt"backend driver emit-csg: source text unavailable source={sourcePath}"
            return false
        if !chengpath.WriteTextFile(destRoot, srcPath, sourceText):
            err = Fmt"backend driver emit-csg: failed to write src layout source={srcPath}"
            return false
    outSrcPath = strings.CloneStr(srcPath)
    err = ""
    return true

fn BackendDriverDispatchMinEmitCsgQueryWorker(raw: ptr) =
    if raw == nil:
        panic("backend driver emit-csg: query worker ctx is nil")
    let work: BackendDriverDispatchMinEmitCsgQueryWork =
        BackendDriverDispatchMinEmitCsgQueryWork(raw)
    if work == nil:
        panic("backend driver emit-csg: query worker ctx is invalid")
    # Var-out formals require live stack-local cells. Nested
    # queryPlan.compilerCsg is not a live mutable place (formal 0).
    var queryPlan: sexec.SystemLinkExecPlan = work.plan
    var queryCsg: ccsg.CompilerCsg = queryPlan.compilerCsg
    var queryErr: str = work.err
    var queryLinkPlan: slplan.SystemLinkPlanStub = work.linkPlan
    var queryReceipt: ccsg.PortableSourceIdentityReceipt = work.receipt
    let queryOk = ccsg.BuildCompilerCsgConsumePortableReceiptInto(
        queryCsg,
        queryErr,
        queryLinkPlan,
        queryReceipt)
    queryPlan.compilerCsg = queryCsg
    work.plan = queryPlan
    work.err = queryErr
    work.linkPlan = queryLinkPlan
    work.receipt = queryReceipt
    work.ok = queryOk

fn BackendDriverDispatchMinEmitCsgQueryOnLargeStack(
        plan: var sexec.SystemLinkExecPlan,
        err: var str,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceReceipt: var ccsg.PortableSourceIdentityReceipt): bool =
    let work = new(BackendDriverDispatchMinEmitCsgQueryWork)
    if work == nil:
        panic("backend driver emit-csg: query worker alloc failed")
    work.plan = plan
    work.linkPlan = linkPlan
    work.receipt = sourceReceipt
    work.err = ""
    work.ok = false
    if BackendDriverDispatchMinCallOnLargeStack(
           &BackendDriverDispatchMinEmitCsgQueryWorker, work) == 0:
        panic("backend driver emit-csg: query large stack call failed")
    plan = work.plan
    linkPlan = work.linkPlan
    sourceReceipt = work.receipt
    err = work.err
    return work.ok

fn BackendDriverDispatchMinSystemLinkExecWorker(raw: ptr) =
    if raw == nil:
        panic("backend driver system-link-exec: worker ctx is nil")
    let work: BackendDriverDispatchMinSystemLinkExecWork =
        BackendDriverDispatchMinSystemLinkExecWork(raw)
    if work == nil:
        panic("backend driver system-link-exec: worker ctx is invalid")
    if !sexec.SystemLinkExecPlanEvidenceInitializeBeforeWorkload():
        work.err = "system_link_exec_plan_evidence_registry_init"
        work.ok = false
        return
    # Var-out formals require live stack-local authority (current-cold
    # managed-param-carrier gate): every var-out actual stages through a
    # frame cell and is republished after the call — the emit-csg query
    # worker 同制。Heap projections of the ptr-cast `work` ref never bind
    # to a var formal directly.
    var queryPlan: sexec.SystemLinkExecPlan = work.plan
    var queryErr: str = work.err
    if !sexec.BuildSystemLinkExecPlanWithWorldAndChannelInto(
           work.workspaceRoot,
           work.req,
           work.worldHead,
           work.lockPath,
           work.baselineSurfacePath,
           work.channel,
           queryPlan,
           queryErr):
        work.err = queryErr
        work.ok = false
        return
    work.plan = queryPlan
    work.err = queryErr
    if work.heldObjectMode:
        var queryResult: sexecrt.SystemLinkExecRuntimeResult =
            work.runtimeResult
        var queryLease: heldfd.HeldOutputFdLease = work.heldObjectLease
        queryErr = work.err
        if !heldruntime.SystemLinkExecHeldObjectRuntimeExecuteInto(
               queryResult,
               queryLease,
               queryErr,
               queryPlan):
            work.runtimeResult = queryResult
            work.heldObjectLease = queryLease
            work.plan = queryPlan
            work.err = queryErr
            work.ok = false
            return
        work.runtimeResult = queryResult
        work.heldObjectLease = queryLease
        work.plan = queryPlan
        work.preExecutionReport =
            Fmt"{work.runtimeResult.planReport}{sexecrt.SystemLinkExecRuntimeResultReport(work.runtimeResult)}"
        work.err = ""
        work.ok = true
        return
    queryPlan = work.plan
    let emitCurrentReceipt =
        work.reportKind == "" &&
        sexec.SystemLinkExecLinuxPassBCurrentReceiptRequest(
            work.workspaceRoot,
            queryPlan)
    work.plan = queryPlan
    var deferReceiptReport: str
    queryPlan = work.plan
    queryErr = work.err
    var deferReceiptOk = true
    if emitCurrentReceipt:
        deferReceiptOk =
            BackendDriverDispatchMinAppendRegallocDeferReceiptReport(
                deferReceiptReport,
                queryPlan,
                queryErr)
    work.plan = queryPlan
    work.err = queryErr
    if emitCurrentReceipt && !deferReceiptOk:
        queryPlan = work.plan
        sexecrt.SystemLinkExecRuntimeDiscardPreparedPlan(
            queryPlan,
            "backend driver: invalid regalloc defer receipt")
        work.plan = queryPlan
        work.ok = false
        return
    work.preExecutionReport = ""
    if work.reportKind == "debug-report":
        queryPlan = work.plan
        work.preExecutionReport =
            sexec.SystemLinkExecPlanDebugReportText(queryPlan)
        work.plan = queryPlan
    elif work.reportKind == "print-symbols":
        queryPlan = work.plan
        work.preExecutionReport =
            sexec.SystemLinkExecPlanSymbolsReportText(queryPlan)
        work.plan = queryPlan
    var queryRuntimeResult: sexecrt.SystemLinkExecRuntimeResult =
        work.runtimeResult
    queryPlan = work.plan
    queryErr = work.err
    if !sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
           queryRuntimeResult,
           queryErr,
           work.workspaceRoot,
           queryPlan,
           ""):
        work.runtimeResult = queryRuntimeResult
        work.plan = queryPlan
        work.err = queryErr
        work.ok = false
        return
    work.runtimeResult = queryRuntimeResult
    work.plan = queryPlan
    work.err = queryErr
    if emitCurrentReceipt:
        var queryReport: str = work.preExecutionReport
        queryErr = work.err
        if !sexecrt.SystemLinkExecRuntimeLinuxPassBCurrentReceiptReportInto(
                queryReport,
                queryErr,
                work.workspaceRoot,
                queryPlan,
                queryRuntimeResult):
            work.preExecutionReport = queryReport
            work.runtimeResult = queryRuntimeResult
            work.plan = queryPlan
            work.err = queryErr
            work.ok = false
            return
        work.preExecutionReport = queryReport
        work.runtimeResult = queryRuntimeResult
        work.plan = queryPlan
        work.err = queryErr
        if len(work.preExecutionReport) > 0:
            work.preExecutionReport =
                Fmt"{work.preExecutionReport}\n{deferReceiptReport}"
        else:
            work.preExecutionReport = deferReceiptReport
    if len(work.preExecutionReport) <= 0:
        work.preExecutionReport =
            Fmt"{work.runtimeResult.planReport}{sexecrt.SystemLinkExecRuntimeResultReport(work.runtimeResult)}"
    work.err = ""
    work.ok = true

@borrows
fn BackendDriverDispatchMinSystemLinkExecOnLargeStack(
        workspaceRoot: str,
        req: var creq.CompilerRequest,
        worldHead: str,
        lockPath: str,
        baselineSurfacePath: str,
        channel: str,
        reportKind: str,
        heldObjectMode: bool,
        heldObjectLease: var heldfd.HeldOutputFdLease,
        plan: var sexec.SystemLinkExecPlan,
        runtimeResult: var sexecrt.SystemLinkExecRuntimeResult,
        preExecutionReport: var str,
        err: var str): bool =
    let work = new(BackendDriverDispatchMinSystemLinkExecWork)
    if work == nil:
        panic("backend driver system-link-exec: worker alloc failed")
    work.workspaceRoot = strings.CloneStr(workspaceRoot)
    work.req = req
    work.worldHead = strings.CloneStr(worldHead)
    work.lockPath = strings.CloneStr(lockPath)
    work.baselineSurfacePath = strings.CloneStr(baselineSurfacePath)
    work.channel = strings.CloneStr(channel)
    work.reportKind = strings.CloneStr(reportKind)
    work.heldObjectMode = heldObjectMode
    if heldObjectMode:
        if !heldfd.HeldOutputFdMove(
               heldObjectLease,
               work.heldObjectLease,
               err) ||
           !heldfd.HeldOutputFdLeaseIsEmpty(
               heldObjectLease):
            if err == "":
                err = "backend driver held object: worker move did not clear source"
            return false
    work.plan = plan
    work.runtimeResult = runtimeResult
    work.preExecutionReport = ""
    work.err = ""
    work.ok = false
    if BackendDriverDispatchMinCallOnLargeStack(
           &BackendDriverDispatchMinSystemLinkExecWorker, work) == 0:
        panic("backend driver system-link-exec: large stack call failed")
    plan = work.plan
    runtimeResult = work.runtimeResult
    preExecutionReport = work.preExecutionReport
    err = work.err
    if heldObjectMode && !work.ok:
        heldfd.HeldOutputFdRetireOrPanic(
            work.heldObjectLease,
            "backend driver held object worker failure retire")
    if heldObjectMode && work.ok:
        var moveErr: str
        if !heldfd.HeldOutputFdMove(
               work.heldObjectLease,
               heldObjectLease,
               moveErr) ||
           !heldfd.HeldOutputFdLeaseIsEmpty(
               work.heldObjectLease):
            err = moveErr
            if err == "":
                err = "backend driver held object: worker return move did not clear source"
            heldfd.HeldOutputFdRetireOrPanic(
                work.heldObjectLease,
                "backend driver held object worker return retire")
            return false
    return work.ok

@borrows
fn BackendDriverDispatchMinExecuteFormalRequestInto(
        workspaceRoot: str,
        req: var creq.CompilerRequest,
        worldHead: str,
        lockPath: str,
        baselineSurfacePath: str,
        channel: str,
        reportKind: str,
        plan: var sexec.SystemLinkExecPlan,
        runtimeResult:
            var sexecrt.SystemLinkExecRuntimeResult,
        preExecutionReport: var str,
        err: var str): bool =
    if !creq.CompilerRequestStrictValidateSealed(req):
        err = "backend driver: formal request is not sealed"
        return false
    if reportKind != "" &&
       reportKind != "debug-report" &&
       reportKind != "print-symbols" &&
       reportKind != "emit-csg":
        err = Fmt"backend driver: unsupported formal report kind: {reportKind}"
        return false
    if reportKind == "emit-csg":
        var queryRootRaw = workspaceRoot
        let reqRoot = creq.CompilerRequestRootDir(req)
        if len(reqRoot) > 0:
            queryRootRaw = reqRoot
        var queryRoot: str
        if !parser.ParserSourceIdentityLexicalPathInto(queryRootRaw, queryRoot):
            err = "backend driver emit-csg: query root is not a canonical path"
            return false
        var sourcePath: str
        if !parser.ParserSourceIdentityLexicalPathInto(
               chengpath.PathAbsolute(
                   queryRoot, creq.CompilerRequestSourcePath(req)),
               sourcePath):
            err = "backend driver emit-csg: source path is not a canonical path"
            return false
        let ownedQueryRoot = strings.CloneStr(queryRoot)
        let ownedSourcePath = strings.CloneStr(sourcePath)
        if !slplan.SystemLinkPlanSourcePathUnderRoot(
               ownedSourcePath, ownedQueryRoot):
            err = Fmt"backend driver emit-csg: source is outside query root source={ownedSourcePath} root={ownedQueryRoot}"
            return false
        var bindSourcePath = strings.CloneStr(ownedSourcePath)
        if !slplan.SystemLinkPlanSourcePathUnderRoot(
               ownedSourcePath,
               BackendDriverDispatchMinEmitCsgQuerySrcLayoutRoot(ownedQueryRoot)):
            var srcSourcePath: str
            if !BackendDriverDispatchMinEmitCsgMaterializeQuerySrcSourceInto(
                   ownedQueryRoot,
                   ownedSourcePath,
                   srcSourcePath,
                   err):
                return false
            bindSourcePath = strings.CloneStr(srcSourcePath)
        if !BackendDriverDispatchMinEmitCsgEnsurePackageManifestInto(
               ownedQueryRoot, err):
            return false
        let externalRoots =
            BackendDriverDispatchMinDefaultExternalPackageRoots(
                ownedQueryRoot, ownedQueryRoot)
        var linkPlan: slplan.SystemLinkPlanStub
        if !slplan.BuildSystemLinkPlanStubWithFieldsAndExternalPackageRoots(
               ownedQueryRoot,
               ownedQueryRoot,
               bindSourcePath,
               creq.CompilerRequestOutputPath(req),
               creq.CompilerRequestTargetTriple(req),
               creq.CompilerRequestEmitKind(req),
               creq.CompilerRequestSymbolVisibility(req),
               creq.CompilerRequestBrowserBridgeObjectPath(req),
               externalRoots,
               linkPlan,
               err):
            return false
        if !slplan.SystemLinkPlanSourceBundleBindingStructuralValidInto(
               linkPlan, err):
            return false
        var sourceReceipt: ccsg.PortableSourceIdentityReceipt
        if !ccsg.PortableSourceIdentityReceiptMakeInto(
               linkPlan.sourceClosurePaths.len,
               linkPlan.importEdges.len,
               linkPlan.unresolvedImportCount,
               linkPlan.packageId,
               linkPlan.ownerModulePaths[linkPlan.sourceBundleEntrySourceIndex],
               linkPlan.sourceBundleCidValue,
               linkPlan.sourceBundleEntrySourceCid,
               linkPlan.sourceBundleImportGraphCid,
               sourceReceipt,
               err):
            return false
        if !BackendDriverDispatchMinEmitCsgQueryOnLargeStack(
               plan,
               err,
               linkPlan,
               sourceReceipt):
            return false
        preExecutionReport =
            sexec.SystemLinkExecPlanCompilerCsgReportText(plan)
        err = ""
        return true
    var unusedHeldObjectLease: heldfd.HeldOutputFdLease
    return BackendDriverDispatchMinSystemLinkExecOnLargeStack(
        workspaceRoot,
        req,
        worldHead,
        lockPath,
        baselineSurfacePath,
        channel,
        reportKind,
        false,
        unusedHeldObjectLease,
        plan,
        runtimeResult,
        preExecutionReport,
        err)

@borrows
fn BackendDriverDispatchMinRunHeldObjectFromCmdline(
        workspaceRoot: str,
        sourcePath: str,
        targetTriple: str,
        emitText: str,
        backendText: str,
        objectFdRaw: str,
        reportFdRaw: str): int32 =
    if emitText != "obj":
        return BackendDriverDispatchMinUnsupported(
            "backend driver held object: --emit:obj is required")
    if BackendDriverDispatchMinFlagPresent("--out") ||
       BackendDriverDispatchMinFlagPresent("--report-out"):
        return BackendDriverDispatchMinUnsupported(
            "backend driver held object: path output flags are forbidden")
    if BackendDriverDispatchMinFlagOccurrenceCount("--out-fd") != 1 ||
       BackendDriverDispatchMinFlagOccurrenceCount("--report-fd") != 1:
        return BackendDriverDispatchMinUnsupported(
            "backend driver held object: exactly one --out-fd and --report-fd are required")
    var objectFd: int32
    var reportFd: int32
    if !cmdline.ParseInt32(objectFdRaw, objectFd) ||
       objectFdRaw != strings.IntToStr(objectFd) ||
       !cmdline.ParseInt32(reportFdRaw, reportFd) ||
       reportFdRaw != strings.IntToStr(reportFd):
        return BackendDriverDispatchMinUnsupported(
            "backend driver held object: fd values must be canonical int32")
    if BackendDriverDispatchMinCanonicalFdFlagOccurrenceCount(
           "--out-fd", objectFdRaw) != 1 ||
       BackendDriverDispatchMinCanonicalFdFlagOccurrenceCount(
           "--report-fd", reportFdRaw) != 1:
        return BackendDriverDispatchMinUnsupported(
            "backend driver held object: fd selectors must use canonical --name:<int32>")
    if !heldfd.HeldOutputFdRegistryInitializeBeforeWorkload():
        return BackendDriverDispatchMinUnsupported(
            "backend driver held object: registry initialization failed")
    var objectLease: heldfd.HeldOutputFdLease
    var reportLease: heldfd.HeldOutputFdLease
    defer:
        heldfd.HeldOutputFdRetireOrPanic(
            objectLease,
            "backend driver held object command object retire")
        heldfd.HeldOutputFdRetireOrPanic(
            reportLease,
            "backend driver held object command report retire")
    var err: str
    if !heldfd.HeldOutputFdClaimEmpty(
           objectFd, objectLease, err):
        return BackendDriverDispatchMinUnsupported(err)
    if !heldfd.HeldOutputFdClaimEmpty(
           reportFd, reportLease, err):
        return BackendDriverDispatchMinUnsupported(err)
    if !heldfd.HeldOutputFdClaimsDistinct(
           objectLease, reportLease):
        return BackendDriverDispatchMinUnsupported(
            "backend driver held object: object/report capabilities alias")
    let emitRes = creq.CompilerEmitFromText(emitText)
    if IsErr(emitRes):
        return BackendDriverDispatchMinUnsupported(Error(emitRes))
    let backendKindRes = creq.CompilerBackendKindFromText(backendText)
    if IsErr(backendKindRes):
        return BackendDriverDispatchMinUnsupported(Error(backendKindRes))
    var req = creq.CompilerRequestNew(
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(sourcePath),
        "",
        strings.CloneStr(targetTriple),
        Value(emitRes),
        "")
    req.backendKind = Value(backendKindRes)
    creq.CompilerRequestSeal(req)
    var args: str[]
    add(args, Fmt"--root:{workspaceRoot}")
    add(args, Fmt"--in:{sourcePath}")
    add(args, Fmt"--target:{targetTriple}")
    add(args, Fmt"--emit:{emitText}")
    add(args, Fmt"--backend:{backendText}")
    let sevenStageConfigErr = ssr.SevenStageReceiptValidateConfig(
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(req.targetTriple),
        req.jobCount)
    if sevenStageConfigErr != "":
        return BackendDriverDispatchMinUnsupported(
            sevenStageConfigErr)
    var runtimeResult: sexecrt.SystemLinkExecRuntimeResult
    var report: str
    var heldPlan: sexec.SystemLinkExecPlan
    if !BackendDriverDispatchMinSystemLinkExecOnLargeStack(
           workspaceRoot,
           req,
           creq.CompilerWorldHeadFromArgs(args),
           creq.CompilerLockPathFromArgs(args),
           creq.CompilerBaselineSurfacePathFromArgs(args),
           creq.CompilerChannelFromArgs(args),
           "",
           true,
           objectLease,
           heldPlan,
           runtimeResult,
           report,
           err):
        return BackendDriverDispatchMinUnsupported(err)
    let outputSha256 = layout.FixedBytes32Hex(
        runtimeResult.outputSha256)
    BackendDriverDispatchMinAppendLine(
        report, "held_output_authority=guard_inherited_fd")
    BackendDriverDispatchMinAppendLine(
        report, "held_output_path_credit=0")
    BackendDriverDispatchMinAppendLine(
        report, "held_output_symlink_resolution=not_applicable_fd_capability")
    BackendDriverDispatchMinAppendLine(
        report, Fmt"held_object_fd={objectFd}")
    BackendDriverDispatchMinAppendLine(
        report, Fmt"held_report_fd={reportFd}")
    BackendDriverDispatchMinAppendLine(
        report, "held_report_credit=1")
    BackendDriverDispatchMinAppendLine(
        report, Fmt"held_object_byte_count={runtimeResult.directObjectBytes}")
    BackendDriverDispatchMinAppendLine(
        report, Fmt"held_object_sha256={outputSha256}")
    BackendDriverDispatchMinAppendLine(
        report, Fmt"emission_receipt_object_byte_count={runtimeResult.directObjectBytes}")
    BackendDriverDispatchMinAppendLine(
        report, Fmt"emission_receipt_object_sha256={outputSha256}")
    BackendDriverDispatchMinAppendLine(
        report, "emission_receipt_byte_binding=exact")
    let reportBytes = rawbytes.BytesFromString(report)
    var reportSha256: layout.FixedBytes32
    if !heldfd.HeldOutputFdPublishBytes(
           reportLease,
           reportBytes,
           "",
           reportSha256,
           err):
        return BackendDriverDispatchMinUnsupported(err)
    if !heldfd.HeldOutputFdClaimsDistinct(
           objectLease, reportLease):
        err = "backend driver held object: final capability alias"
        return BackendDriverDispatchMinUnsupported(err)
    if !heldfd.HeldOutputFdVerifyPublished(
           objectLease,
           runtimeResult.outputSha256,
           err) ||
       !heldfd.HeldOutputFdVerifyPublished(
           reportLease,
           reportSha256,
           err):
        return BackendDriverDispatchMinUnsupported(err)
    return 0

# C4（R2-C2 2026-09-07；v2 RSS 回归修复 2026-09-07 晚）：darwin syscall
# provider 对象组合根预物化。内核 system_link_exec_runtime 的 darwin 臂已转
# consume-or-fail-closed（C6 拒收形），对象必须在本进程进入编译流程前由组合根
# （插件侧）产出。门与内核臂逐字同源：emit==exe && TargetIsDarwinA64；对象
# 路径推导与 runtime 侧逐字节同式（{outputPath}.darwin_syscall_provider.o，
# outputPath 为 --out 原值，与 plan.systemLinkPlan.outputPath 同源同值）。
#
# v1 教训（主线程 m35 终验回滚实录）：v1 以进程内直调 B9 门面发射，发射的
# arena/页驻留垫在本进程编译相 RSS 之下，v6 夹具（编译相 ~1.04GiB 贴帽）被顶
# 穿原 1GiB 帽（1,077,821,440B；新理论极限 768MiB）。provider 对象也是产物，其发射内存必须计入
# 进程树预算且不得与编译相叠加。v2 改子进程隔离物化：spawn 自身
# emit-darwin-syscall-provider 子命令（本文件 :8242 系既有子命令，直达
# WriteObject，不经 system-link-exec，无递归），与兄弟 provider 的
# host_ops.RunFileLogged 子进程形同构（.compile.log 落盘）。子进程为顺序相：
# 进程树峰值 = max(物化相, 编译相)，父进程零残留。@borrows 形参全借用（调用
# 方的 outputPath/targetTriple 已被 req 构建 CloneStr 消费，不得二次移动）。
@borrows
fn BackendDriverDispatchMinPreMaterializeDarwinSyscallProvider(
        rootDir: str,
        outputPath: str,
        targetTriple: str,
        emitKind: creq.CompilerEmit): int32 =
    if emitKind != creq.EmitExe || !tmat.TargetIsDarwinA64(targetTriple):
        return 0
    let objectPath = Fmt"{outputPath}.darwin_syscall_provider.o"
    let objectAbs = chengpath.PathAbsolute(rootDir, objectPath)
    if os.FileExists(objectAbs):
        let _ = os.RemoveFile(objectAbs)
    let logPath = Fmt"{objectPath}.compile.log"
    let logAbs = chengpath.PathAbsolute(rootDir, logPath)
    if os.FileExists(logAbs):
        let _ = os.RemoveFile(logAbs)
    var selfRaw: str
    BackendDriverDispatchMinParamStrInto(0, selfRaw)
    let selfAbs = chengpath.PathAbsolute(rootDir, selfRaw)
    if len(selfRaw) <= 0 || !chengpath.FileExistsNonEmpty(rootDir, selfAbs):
        BackendDriverDispatchMinPrintErr(
            " system link exec: darwin syscall provider emit failed: absolute argv0 required")
        return 1
    var spawnArgv: str[]
    add(spawnArgv, "emit-darwin-syscall-provider")
    add(spawnArgv, Fmt"--out:{objectPath}")
    var noEnvOverrides: str[]
    let run = hostops.RunFileLogged(
        rootDir,
        "backend_driver_darwin_syscall_provider",
        selfAbs,
        spawnArgv,
        noEnvOverrides,
        rootDir,
        0,
        logPath)
    if run.exitCode != 0:
        BackendDriverDispatchMinPrintErr(
            Fmt" system link exec: darwin syscall provider emit failed: rc={strings.IntToStr(run.exitCode)} log={run.logPath}")
        return 1
    if !chengpath.FileExistsNonEmpty(rootDir, objectPath):
        BackendDriverDispatchMinPrintErr(
            Fmt" system link exec: darwin syscall provider emit failed: object missing after emit: {objectPath}")
        return 1
    return 0

fn BackendDriverDispatchMinRunSystemLinkExecFromCmdline(): int32 =
    let workspaceRoot = BackendDriverDispatchMinWorkspaceRootFromCmdline()
    if workspaceRoot.len <= 0:
        return BackendDriverDispatchMinUnsupported(
            "backend driver system-link-exec: workspace root is empty")
    let sourceRaw = BackendDriverDispatchMinReadFlagOrDefault("--in", "")
    let sourcePath = BackendDriverDispatchMinCleanDotPath(
        chengpath.PathAbsoluteBridgeSafe(workspaceRoot, sourceRaw))
    let outputPath = BackendDriverDispatchMinReadFlagOrDefault("--out", "")
    let targetTriple = BackendDriverDispatchMinReadFlagOrDefault(
        "--target", "arm64-apple-darwin")
    let emitText = BackendDriverDispatchMinReadFlagOrDefault("--emit", "exe")
    let reportOut = BackendDriverDispatchMinReadFlagOrDefault("--report-out", "")
    let objectFdRaw = BackendDriverDispatchMinReadFlagOrDefault(
        "--out-fd", "")
    let reportFdRaw = BackendDriverDispatchMinReadFlagOrDefault(
        "--report-fd", "")
    let backendText = BackendDriverDispatchMinReadFlagOrDefault(
        "--backend", "primary")
    if objectFdRaw != "" || reportFdRaw != "" ||
       BackendDriverDispatchMinFlagPresent("--out-fd") ||
       BackendDriverDispatchMinFlagPresent("--report-fd"):
        return BackendDriverDispatchMinRunHeldObjectFromCmdline(
            workspaceRoot,
            sourcePath,
            targetTriple,
            emitText,
            backendText,
            objectFdRaw,
            reportFdRaw)
    let emitRes = creq.CompilerEmitFromText(emitText)
    if IsErr(emitRes):
        return BackendDriverDispatchMinUnsupported(Error(emitRes))
    let backendKindRes = creq.CompilerBackendKindFromText(backendText)
    if IsErr(backendKindRes):
        return BackendDriverDispatchMinUnsupported(Error(backendKindRes))
    # C4（R2-C2）：组合根预物化 darwin syscall provider 对象（插件侧唯一
    # 写点），先于任何编译/链接流程；内核 runtime 臂只消费。预物化 fn 为
    # @borrows 全借用形，置于 req 构建之前——outputPath/targetTriple 尚未
    # 被 CompilerRequestNew 的 CloneStr 消费，借用源活性无争议。
    let preMaterializeCode = BackendDriverDispatchMinPreMaterializeDarwinSyscallProvider(
        workspaceRoot,
        outputPath,
        targetTriple,
        Value(emitRes))
    if preMaterializeCode != 0:
        return preMaterializeCode
    var req = creq.CompilerRequestNew(
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(sourcePath),
        strings.CloneStr(outputPath),
        strings.CloneStr(targetTriple),
        Value(emitRes),
        strings.CloneStr(reportOut))
    req.backendKind = Value(backendKindRes)
    creq.CompilerRequestSeal(req)
    var args: str[]
    add(args, Fmt"--root:{workspaceRoot}")
    add(args, Fmt"--in:{sourcePath}")
    add(args, Fmt"--out:{outputPath}")
    add(args, Fmt"--target:{targetTriple}")
    add(args, Fmt"--emit:{emitText}")
    add(args, Fmt"--backend:{backendText}")
    if len(reportOut) > 0:
        add(args, Fmt"--report-out:{reportOut}")
    let reportPath = strings.CloneStr(req.reportPath)
    let sevenStageConfigErr = ssr.SevenStageReceiptValidateConfig(
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(req.targetTriple),
        req.jobCount)
    if len(sevenStageConfigErr) > 0:
        if len(reportPath) > 0:
            let _ = BackendDriverDispatchMinWriteErrorReportBridge(
                workspaceRoot, reportPath, sevenStageConfigErr)
        return BackendDriverDispatchMinUnsupported(sevenStageConfigErr)
    var plan: sexec.SystemLinkExecPlan
    var runtimeResult:
        sexecrt.SystemLinkExecRuntimeResult
    var preExecutionReport: str
    var err: str
    if !BackendDriverDispatchMinExecuteFormalRequestInto(
           workspaceRoot,
           req,
           creq.CompilerWorldHeadFromArgs(args),
           creq.CompilerLockPathFromArgs(args),
           creq.CompilerBaselineSurfacePathFromArgs(args),
           creq.CompilerChannelFromArgs(args),
           "",
           plan,
           runtimeResult,
           preExecutionReport,
           err):
        if len(reportPath) > 0:
            let _ = BackendDriverDispatchMinWriteErrorReportBridge(
                workspaceRoot, reportPath, err)
        return BackendDriverDispatchMinUnsupported(err)
    if len(preExecutionReport) <= 0:
        preExecutionReport = Fmt"{sexec.SystemLinkExecPlanReport(plan)}{sexecrt.SystemLinkExecRuntimeResultReport(runtimeResult)}"
    # [phase-ledger-report] The dry-compile report already carries the phase
    # memory ledger; the system-link-exec report (this one, the path the
    # acceptance gate runs) did not, so the merge's retention had no named
    # contributor.  Diagnostic only: append, no verdict changes.
    BackendDriverDispatchMinAppendPhaseMemoryLedgerReport(preExecutionReport)
    if len(preExecutionReport) > 0 &&
       !BackendDriverDispatchMinWriteReport(
           workspaceRoot,
           reportPath,
           preExecutionReport):
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver: failed to write formal execution report: {reportPath}")
    return 0

fn BackendDriverDispatchMinRunSystemLinkExecCommandFromCmdline(): int32 =
    return BackendDriverDispatchMinRunSystemLinkExecFromCmdline()

fn BackendDriverDispatchMinElapsedMsText(startNs: int64): str =
    let elapsedNs = BackendDriverDispatchMinNowNs() - startNs
    return BackendDriverDispatchMinPhaseMsText(elapsedNs)

@borrows
fn BackendDriverDispatchMinRemoveIfExists(path: str) =
    if chengpath.PathFileExists(path):
        let _ = os.RemoveFile(path)

@borrows
fn BackendDriverDispatchMinRunShellLogged(rootDir: str,
                                           command: str,
                                           logPath: str): os.ExecCmdResult =
    let run = BackendDriverDispatchMinExecShell(command, rootDir)
    let _ = chengpath.WriteTextFile(rootDir, logPath, run.output)
    return run

@borrows
fn BackendDriverDispatchMinHostSmokeExpectContains(label: str,
                                                    text: str,
                                                    needle: str): bool =
    if chengpath.TextContains(text, needle):
        return true
    BackendDriverDispatchMinPrintErr(Fmt"{label}: missing marker: {needle}")
    return false

fn BackendDriverDispatchMinRunChengSkillConsistencySmoke(rootDir: str): int32 =
    let smokeName = "cheng_skill_consistency_smoke"
    let compilerPath = BackendDriverDispatchMinCurrentCompiler(rootDir)
    if len(compilerPath) <= 0 || !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        return BackendDriverDispatchMinUnsupported(Fmt"backend driver direct: missing compiler: {compilerPath}")
    let label = BackendDriverDispatchMinReadFlagOrDefault("--label", "dispatch_min")
    let outDir = chengpath.PathAbsolute(rootDir, Fmt"artifacts/hostrun/{label}")
    if !BackendDriverDispatchMinEnsureDir(rootDir, outDir):
        return 1
    let src = chengpath.PathAbsolute(rootDir, "src/tests/cheng_skill_consistency_smoke.cheng")
    if !chengpath.FileExistsNonEmpty(rootDir, src):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: missing source: {src}")
        return 1
    let outBin = chengpath.PathJoin(outDir, smokeName)
    let reportPath = Fmt"{outBin}.compile.report.txt"
    let compileLog = Fmt"{outBin}.compile.log"
    let runLog = Fmt"{outBin}.run.log"
    let smokeReport = chengpath.PathJoin(rootDir, "artifacts/cheng_skill_consistency/cheng_cheng_skill_consistency.report.txt")
    BackendDriverDispatchMinRemoveIfExists(outBin)
    BackendDriverDispatchMinRemoveIfExists(reportPath)
    BackendDriverDispatchMinRemoveIfExists(compileLog)
    BackendDriverDispatchMinRemoveIfExists(runLog)
    BackendDriverDispatchMinRemoveIfExists(Fmt"{outBin}.map")
    BackendDriverDispatchMinRemoveIfExists(smokeReport)
    BackendDriverDispatchMinPrintLine("[cheng host smokes] cheng skill consistency")
    var startNs = BackendDriverDispatchMinNowNs()
    let compileCommand = Fmt"CHENG_NO_BACKEND_DRIVER_HANDOFF=1 CHENG_BACKEND_DRIVER_HANDOFF=0 BACKEND_INCREMENTAL=0 BACKEND_MULTI_MODULE_CACHE=0 CHENG_DISABLE_PRIMARY_OBJECT_CACHE=1 BACKEND_BUILD_DRIVER_QUICK_STAMP_CACHE=0 BACKEND_BUILD_DRIVER_QUICK_SHARED_CACHE=0 CHENG_PROGRESS=1 CHENG_PROCESS_MAX_RSS_BYTES=805306368 {os.QuoteShell(compilerPath)} system-link-exec --root:{os.QuoteShell(rootDir)} --in:{os.QuoteShell(src)} --emit:exe --target:arm64-apple-darwin --out:{os.QuoteShell(outBin)} --report-out:{os.QuoteShell(reportPath)}"
    let compileRun = BackendDriverDispatchMinRunShellLogged(rootDir,
                                                            compileCommand,
                                                            compileLog)
    let compileRc = compileRun.exitCode
    BackendDriverDispatchMinPrintLine(Fmt"cheng_skill_compile_ms={BackendDriverDispatchMinElapsedMsText(startNs)} rc={compileRc}")
    if compileRc != 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: cheng skill compile failed log={compileLog}")
        return compileRc
    if !chengpath.FileExistsNonEmpty(rootDir, outBin):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: cheng skill output missing: {outBin}")
        return 1
    startNs = BackendDriverDispatchMinNowNs()
    let runRc = BackendDriverDispatchMinRunExecutable(rootDir, outBin, runLog)
    BackendDriverDispatchMinPrintLine(Fmt"cheng_skill_run_ms={BackendDriverDispatchMinElapsedMsText(startNs)} rc={runRc}")
    let runText = chengpath.ReadTextFile(rootDir, runLog)
    if runRc != 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: cheng skill run failed log={runLog}")
        return runRc
    if !BackendDriverDispatchMinHostSmokeExpectContains(smokeName, runText, " cheng_skill_consistency_smoke ok"):
        return 1
    if !chengpath.FileExistsNonEmpty(rootDir, smokeReport):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: cheng skill report missing: {smokeReport}")
        return 1
    let smokeReportText = chengpath.ReadTextFile(rootDir, smokeReport)
    if !BackendDriverDispatchMinHostSmokeExpectContains(smokeName, smokeReportText, "algebraic_type_match_surface=ok"):
        return 1
    BackendDriverDispatchMinPrintLine(" cheng_skill_consistency_smoke ok")
    return 0

