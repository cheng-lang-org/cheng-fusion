    let compileRun = BackendDriverDispatchMinRunShellLogged(rootDir,
                                                            compileCommand,
                                                            compileLog)
    let compileRc = compileRun.exitCode
    BackendDriverDispatchMinPrintLine(Fmt"std_file_io_smoke_compile_ms={BackendDriverDispatchMinElapsedMsText(startNs)} rc={compileRc}")
    if compileRc != 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: std file IO compile failed log={compileLog}")
        return compileRc
    if !chengpath.FileExistsNonEmpty(rootDir, outBin):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: std file IO output missing: {outBin}")
