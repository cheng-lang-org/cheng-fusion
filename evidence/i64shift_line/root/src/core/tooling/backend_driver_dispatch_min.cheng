    let reportText = chengpath.ReadTextFile(rootDir, reportPath)
    if !BackendDriverDispatchMinHostSmokeExpectContains(smokeName, reportText, "system_link_exec=1"):
        return 1
    if !BackendDriverDispatchMinHostSmokeExpectContains(smokeName, reportText, "real_backend_codegen=1"):
        return 1
    if !BackendDriverDispatchMinHostSmokeExpectContains(smokeName, reportText, "unresolved_symbol_count=0"):
        return 1
    if !chengpath.TextContains(reportText, "provider_object_count=") ||
       chengpath.TextContains(reportText, "provider_object_count=0\n"):
        BackendDriverDispatchMinPrintErr("backend driver direct: std file IO provider closure missing")
        return 1
    startNs = BackendDriverDispatchMinNowNs()
    let runRc = BackendDriverDispatchMinRunExecutable(rootDir, outBin, runLog)
    BackendDriverDispatchMinPrintLine(Fmt"std_file_io_smoke_run_ms={BackendDriverDispatchMinElapsedMsText(startNs)} rc={runRc}")
    if runRc != 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct: std file IO run failed log={runLog}")
        return runRc
    BackendDriverDispatchMinPrintLine(" std_file_io_smoke ok")
    return 0

fn BackendDriverDispatchMinRunHostSmokesFromCmdline(): int32 =
    return BackendDriverDispatchMinUnsupported("backend driver direct: run-host-smokes requires full selfhost command lowering")

fn BackendDriverDispatchMinVpnProxyUsage(): int32 =
    BackendDriverDispatchMinPrintLine("usage: cheng vpn-proxy <local|exit|status|gui> --config:<path>")
    BackendDriverDispatchMinPrintLine("local flags: --ready-path:<path> --accept-count:<n> --probe-interval-ms:<n> --probe-timeout-ms:<n>")
    BackendDriverDispatchMinPrintLine("exit flags: --ready-path:<path> --accept-count:<n>")
    BackendDriverDispatchMinPrintLine("status flags: --probe-timeout-ms:<n>")
    BackendDriverDispatchMinPrintLine("gui flags: --config:<path> --runtime-tool:<path>")
    return 0

fn BackendDriverDispatchMinShellArgsFrom(startIndex: int32,
                                          count: int32): str =
    var out: str
    if startIndex <= 0:
        return out
    if count < startIndex:
        return out
    for i in startIndex..count:
        var arg: str
        BackendDriverDispatchMinParamStrInto(i, arg)
        out = strutil.Join([out, " ", os.QuoteShell(arg)], "")
    return out

fn BackendDriverDispatchMinRunVpnProxyFromCmdline(): int32 =
    let rootDir = "."
    let count = BackendDriverDispatchMinParamCount()
    if count <= 1:
        return BackendDriverDispatchMinVpnProxyUsage()
    var subcmd: str
    BackendDriverDispatchMinParamStrInto(2, subcmd)
    if subcmd == "help":
        return BackendDriverDispatchMinVpnProxyUsage()
    if subcmd == "--help":
        return BackendDriverDispatchMinVpnProxyUsage()
    if subcmd == "-h":
        return BackendDriverDispatchMinVpnProxyUsage()
    let compilerPath = BackendDriverDispatchMinCurrentCompiler(rootDir)
    if len(compilerPath) <= 0 || !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        return BackendDriverDispatchMinUnsupported(Fmt"backend driver direct vpn-proxy: missing compiler: {compilerPath}")
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver_tools/vpn_proxy_runtime_tool")
    if !chengpath.MkdirP(rootDir, outDir):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct vpn-proxy: failed to create output dir: {outDir}")
        return 1
    let outBin = chengpath.PathJoin(outDir, "vpn_proxy_runtime_tool")
    let reportPath = chengpath.PathJoin(outDir, "vpn_proxy_runtime_tool.report.txt")
    let compileLog = chengpath.PathJoin(outDir, "vpn_proxy_runtime_tool.compile.log")
    let runLog = chengpath.PathJoin(outDir, "vpn_proxy_runtime_tool.run.log")
    let sourcePath = chengpath.PathAbsolute(rootDir, "src/apps/vpn_proxy/vpn_proxy_runtime_tool_main.cheng")
    BackendDriverDispatchMinRemoveIfExists(outBin)
    BackendDriverDispatchMinRemoveIfExists(reportPath)
    BackendDriverDispatchMinRemoveIfExists(compileLog)
    BackendDriverDispatchMinRemoveIfExists(runLog)
    BackendDriverDispatchMinRemoveIfExists(Fmt"{outBin}.map")
    let compileCommand = Fmt"CHENG_BACKEND_DRIVER_HANDOFF=0 CHENG_PROCESS_MAX_RSS_BYTES=805306368 {os.QuoteShell(compilerPath)} system-link-exec --root:{os.QuoteShell(rootDir)} --in:{os.QuoteShell(sourcePath)} --emit:exe --link-providers --target:arm64-apple-darwin --out:{os.QuoteShell(outBin)} --report-out:{os.QuoteShell(reportPath)}"
    let compileRun = BackendDriverDispatchMinRunShellLogged(rootDir,
                                                            compileCommand,
                                                            compileLog)
    if compileRun.exitCode != 0:
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct vpn-proxy: compile failed log={compileLog}")
        let compileText = strutil.Strip(compileRun.output)
        if len(compileText) > 0:
            BackendDriverDispatchMinPrintErr(compileText)
        return compileRun.exitCode
    if !chengpath.FileExistsNonEmpty(rootDir, outBin):
        BackendDriverDispatchMinPrintErr(Fmt"backend driver direct vpn-proxy: output missing: {outBin}")
        return 1
    let reportText = chengpath.ReadTextFile(rootDir, reportPath)
    if !BackendDriverDispatchMinHostSmokeExpectContains("vpn-proxy", reportText, "system_link_exec=1"):
        return 1
    if !BackendDriverDispatchMinHostSmokeExpectContains("vpn-proxy", reportText, "real_backend_codegen=1"):
        return 1
    if !BackendDriverDispatchMinHostSmokeExpectContains("vpn-proxy", reportText, "unresolved_symbol_count=0"):
        return 1
    let runCommand = strutil.Join([os.QuoteShell(outBin), BackendDriverDispatchMinShellArgsFrom(2, count)], "")
    let run = BackendDriverDispatchMinRunShellLogged(rootDir, runCommand, runLog)
    let outputText = strutil.Strip(run.output)
    if len(outputText) > 0:
        if run.exitCode == 0:
            BackendDriverDispatchMinPrintLine(outputText)
        else:
            BackendDriverDispatchMinPrintErr(outputText)
    return run.exitCode

@borrows
fn BackendDriverDispatchMinWriteOptionalReport(rootDir: str,
                                                reportPath: str,
                                                text: str): bool =
    let trimmedPath = strutil.Strip(reportPath)
    if len(trimmedPath) <= 0:
        return true
    return BackendDriverDispatchMinWriteReport(rootDir, trimmedPath, text)

fn BackendDriverDispatchMinRunDebugTextCommandFromCmdline(
        commandName: str): int32 =
    if commandName != "debug-report" &&
       commandName != "print-symbols" &&
       commandName != "print-line-map":
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver debug: unsupported command: {commandName}")
    let workspaceRoot = BackendDriverDispatchMinCleanDotPath(
        chengpath.PathAbsolute(os.GetCurrentDir(), "."))
    var args = BackendDriverDispatchMinCollectArgsFrom(
        2, BackendDriverDispatchMinParamCount())
    let sourcePath =
        BackendDriverDispatchMinReadFlagOrDefault("--in", "")
    var outputPath =
        BackendDriverDispatchMinReadFlagOrDefault("--out", "")
    if len(outputPath) <= 0:
        let reportPath =
            BackendDriverDispatchMinReadFlagOrDefault(
                "--report-out", "")
        if len(reportPath) > 0:
            outputPath = Fmt"{reportPath}.object"
        else:
            outputPath = Fmt"{sourcePath}.debug.object"
        add(args, Fmt"--out:{outputPath}")
    if len(BackendDriverDispatchMinReadFlagOrDefault(
               "--emit", "")) <= 0:
        add(args, "--emit:obj")
    let reqRes = creq.CompilerRequestFromArgsForCommand(
        strings.CloneStr(workspaceRoot), BackendDriverDispatchMinCloneStrSeq(args), true)
    if IsErr(reqRes):
        return BackendDriverDispatchMinUnsupported(Error(reqRes))
    var req = Value(reqRes)
    let reportPath = strings.CloneStr(req.reportPath)
    var plan: sexec.SystemLinkExecPlan
    var runtimeResult:
        sexecrt.SystemLinkExecRuntimeResult
    var report: str
    var reportKind = strings.CloneStr(commandName)
    if commandName == "print-line-map":
        reportKind = ""
    var err: str
    if !BackendDriverDispatchMinExecuteFormalRequestInto(
           workspaceRoot,
           req,
           creq.CompilerWorldHeadFromArgs(args),
           creq.CompilerLockPathFromArgs(args),
           creq.CompilerBaselineSurfacePathFromArgs(args),
           creq.CompilerChannelFromArgs(args),
           reportKind,
           plan,
           runtimeResult,
           report,
           err):
        BackendDriverDispatchMinPrintErr(err)
        return 2
    if commandName == "print-line-map":
        if len(runtimeResult.lineMapPath) <= 0 ||
           !chengpath.FileExistsNonEmpty(
               workspaceRoot, runtimeResult.lineMapPath):
            BackendDriverDispatchMinPrintErr(
                "backend driver print-line-map: formal runtime line map missing")
            return 1
        report = chengpath.ReadTextFile(
            workspaceRoot, runtimeResult.lineMapPath)
    if len(report) <= 0:
        BackendDriverDispatchMinPrintErr(
            Fmt"backend driver {commandName}: formal report is empty")
        return 1
    if !BackendDriverDispatchMinWriteOptionalReport(
           workspaceRoot, reportPath, Fmt"{report}\n"):
        BackendDriverDispatchMinPrintErr(
            Fmt"backend driver debug: failed to write report: {reportPath}")
        return 1
    BackendDriverDispatchMinPrintLine(strutil.Strip(report))
    return 0

fn BackendDriverDispatchMinRunDebugReportFromCmdline(): int32 =
    return BackendDriverDispatchMinRunDebugTextCommandFromCmdline("debug-report")

fn BackendDriverDispatchMinRunPrintSymbolsFromCmdline(): int32 =
    return BackendDriverDispatchMinRunDebugTextCommandFromCmdline("print-symbols")

fn BackendDriverDispatchMinRunPrintLineMapFromCmdline(): int32 =
    return BackendDriverDispatchMinRunDebugTextCommandFromCmdline("print-line-map")

@borrows
fn BackendDriverDispatchMinProfileRawPathFromReport(reportPath: str): str =
    if strings.HasSuffix(reportPath, ".txt"):
        let n = len(reportPath)
        if n < 4:
            return strutil.Join([strings.CloneStr(reportPath), ".raw.txt"], "")
        let prefix = strings.CloneStrRange(reportPath, 0, n - 4)
        return strutil.Join([prefix, ".raw.txt"], "")
    return strutil.Join([strings.CloneStr(reportPath), ".raw.txt"], "")

@borrows
fn BackendDriverDispatchMinProfileReportPathFromRaw(rawPath: str): str =
    if strings.HasSuffix(rawPath, ".raw.txt"):
        let n = len(rawPath)
        if n < 8:
            return strutil.Join([strings.CloneStr(rawPath), ".txt"], "")
        let prefix = strings.CloneStrRange(rawPath, 0, n - 8)
        return strutil.Join([prefix, ".txt"], "")
    return strutil.Join([strings.CloneStr(rawPath), ".report.txt"], "")

fn BackendDriverDispatchMinCompilerPhaseNames(): str[] =
    return ["system_link_plan",
            "compiler_csg",
            "lowering_plan",
            "primary_object_plan",
            "direct_object_emit",
            "provider_objects",
            "native_link",
            "line_map"]

@borrows
fn BackendDriverDispatchMinProfileLineValue(line: str,
                                             key: str,
                                             value: var str): bool =
    value = ""
    if len(line) <= len(key) || line[len(key)] != '=':
        return false
    for i in 0..<len(key):
        if line[i] != key[i]:
            return false
    value = chengpath.TextSlice(line, len(key) + 1, len(line) - len(key) - 1)
    return true

@borrows
fn BackendDriverDispatchMinProfileTextValueValid(value: str): bool =
    if len(value) <= 0:
        return false
    for i in 0..<len(value):
        if value[i] == '\n' || value[i] == '\r' || value[i] == '\t':
            return false
    return true

@borrows
fn BackendDriverDispatchMinProfileAddPhase(
        profile: var BackendDriverDispatchMinCompilerPhaseProfile,
        name: str,
        rawNs: str,
        err: var str): bool =
    let ns = BackendDriverDispatchMinParseUnsignedInt64(rawNs)
    if ns < int64(0):
        err = Fmt"backend driver profile: invalid phase duration: {name}={rawNs}"
        return false
    if profile.phaseTotalNs > int64(9223372036854775807) - ns:
        err = "backend driver profile: phase duration total overflow"
        return false
    add(profile.phaseNames, strings.CloneStr(name))
    add(profile.phaseNs, ns)
    profile.phaseTotalNs = profile.phaseTotalNs + ns
    return true

@borrows
fn BackendDriverDispatchMinCompilerPhaseProfileFromCompileReport(
        rootDir: str,
        sourcePathRaw: str,
        outputPathRaw: str,
        compileReport: str,
        profile: var BackendDriverDispatchMinCompilerPhaseProfile,
        err: var str): bool =
    profile = BackendDriverDispatchMinCompilerPhaseProfile()
    let sourcePath = chengpath.PathAbsolute(rootDir, sourcePathRaw)
    let outputPath = chengpath.PathAbsolute(rootDir, outputPathRaw)
    var driverRaw: str
    BackendDriverDispatchMinParamStrInto(0, driverRaw)
    let driverPath = chengpath.PathAbsolute(rootDir, driverRaw)
    if !BackendDriverDispatchMinProfileTextValueValid(sourcePath) ||
       !BackendDriverDispatchMinProfileTextValueValid(outputPath) ||
       !BackendDriverDispatchMinProfileTextValueValid(driverPath):
        err = "backend driver profile: invalid source, output, or driver path"
        return false
    var sourceSha256: str
    var outputSha256: str
    var driverSha256: str
    if !BackendDriverDispatchMinFileSha256Hex("", sourcePath, sourceSha256) ||
       !BackendDriverDispatchMinFileSha256Hex("", outputPath, outputSha256) ||
       !BackendDriverDispatchMinFileSha256Hex("", driverPath, driverSha256):
        err = "backend driver profile: failed to hash source, output, or driver"
        return false
    var reportOutputSha256: str
    var sourceTreeCid: str
    if !BackendDriverDispatchMinProviderStageManifestValue(
           compileReport, "output_sha256", reportOutputSha256) ||
       reportOutputSha256 != outputSha256:
        err = "backend driver profile: compile report output identity mismatch"
        return false
    if !BackendDriverDispatchMinProviderStageManifestValue(
           compileReport, "source_bundle_cid", sourceTreeCid) ||
       !BackendDriverDispatchMinSha256TextValid(sourceTreeCid):
        err = "backend driver profile: compile report source tree identity missing"
        return false
    profile.sourcePath = sourcePath
    profile.sourceSha256 = sourceSha256
    profile.sourceTreeCid = sourceTreeCid
    profile.driverPath = driverPath
    profile.driverSha256 = driverSha256
    profile.outputPath = outputPath
    profile.outputSha256 = outputSha256
    let phaseNames = BackendDriverDispatchMinCompilerPhaseNames()
    for i in 0..<phaseNames.len:
        let phaseName = phaseNames[i]
        var phaseNs: str
        if !BackendDriverDispatchMinProviderStageManifestValue(
               compileReport, Fmt"exec_phase_{phaseName}_ns", phaseNs) ||
           !BackendDriverDispatchMinProfileAddPhase(
               profile, phaseName, phaseNs, err):
            if len(err) <= 0:
                err = Fmt"backend driver profile: compile phase missing: {phaseName}"
            return false
    if profile.phaseNames.len != phaseNames.len ||
       profile.phaseNs.len != phaseNames.len:
        err = "backend driver profile: compiler phase ledger incomplete"
        return false
    var realPhaseSeen = false
    for i in 0..<profile.phaseNs.len:
        if profile.phaseNs[i] > int64(0):
            realPhaseSeen = true
    if !realPhaseSeen || profile.phaseNs[1] <= int64(0):
        err = "backend driver profile: compiler phase ledger has no measured compiler_csg event"
        return false
    err = ""
    return true

@borrows
fn BackendDriverDispatchMinCompilerPhaseRawText(
        profile: BackendDriverDispatchMinCompilerPhaseProfile): str =
    var out = "cheng_profile_raw"
    BackendDriverDispatchMinAppendLine(out, "profile_kind=compiler_phase")
    BackendDriverDispatchMinAppendLine(out, Fmt"source_path={profile.sourcePath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"source_sha256={profile.sourceSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"source_tree_cid={profile.sourceTreeCid}")
    BackendDriverDispatchMinAppendLine(out, Fmt"driver_path={profile.driverPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"driver_sha256={profile.driverSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"output_path={profile.outputPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"output_sha256={profile.outputSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"phase_count={profile.phaseNames.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"phase_total_ns={profile.phaseTotalNs}")
    for i in 0..<profile.phaseNames.len:
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"phase\t{profile.phaseNames[i]}\t{profile.phaseNs[i]}")
    return Fmt"{out}\n"

@borrows
fn BackendDriverDispatchMinCompilerPhaseBefore(
        leftName: str,
        leftNs: int64,
        rightName: str,
        rightNs: int64): bool =
    if leftNs != rightNs:
        return leftNs > rightNs
    return system.Cmp(leftName, rightName) < 0

@borrows
fn BackendDriverDispatchMinCompilerPhaseReportText(
        profile: BackendDriverDispatchMinCompilerPhaseProfile): str =
    var names: str[]
    var values: int64[]
    for phaseIndex in 0..<profile.phaseNames.len:
        add(names, strings.CloneStr(profile.phaseNames[phaseIndex]))
        add(values, profile.phaseNs[phaseIndex])
    for i in 0..<names.len:
        var best = i
        var j = i + 1
        while j < names.len:
            if BackendDriverDispatchMinCompilerPhaseBefore(
                   names[j], values[j], names[best], values[best]):
                best = j
            j = j + 1
        if best != i:
            let nameTmp = strings.CloneStr(names[i])
            let valueTmp = values[i]
            names[i] = names[best]
            values[i] = values[best]
            names[best] = nameTmp
            values[best] = valueTmp
    var out = "cheng_profile"
    BackendDriverDispatchMinAppendLine(out, "profile_kind=compiler_phase")
    BackendDriverDispatchMinAppendLine(out, Fmt"source_path={profile.sourcePath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"source_sha256={profile.sourceSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"source_tree_cid={profile.sourceTreeCid}")
    BackendDriverDispatchMinAppendLine(out, Fmt"driver_path={profile.driverPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"driver_sha256={profile.driverSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"output_path={profile.outputPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"output_sha256={profile.outputSha256}")
    BackendDriverDispatchMinAppendLine(out, Fmt"phase_count={names.len}")
    BackendDriverDispatchMinAppendLine(out, Fmt"phase_total_ns={profile.phaseTotalNs}")
    for i in 0..<names.len:
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"hot_phase[{i}]={values[i]}|{names[i]}")
    return Fmt"{out}\n"

@borrows
fn BackendDriverDispatchMinProfileLineCount(text: str): int32 =
    if len(text) <= 0 || text[len(text) - 1] != '\n':
        return -1
    let lines = strutil.Split(text, '\n')
    var count: int32
    for i in 0..<lines.len:
        if len(lines[i]) <= 0:
            if i != lines.len - 1:
                return -1
            continue
        if strutil.Contains(lines[i], "\r"):
            return -1
        count = count + 1
    return count

@borrows
fn BackendDriverDispatchMinParseCompilerPhaseRaw(
        rawText: str,
        profile: var BackendDriverDispatchMinCompilerPhaseProfile,
        err: var str): bool =
    profile = BackendDriverDispatchMinCompilerPhaseProfile()
    let phaseNames = BackendDriverDispatchMinCompilerPhaseNames()
    let expectedLineCount = int32(11) + phaseNames.len
    if BackendDriverDispatchMinProfileLineCount(rawText) != expectedLineCount:
        err = "backend driver profile-report: raw schema line count mismatch"
        return false
    let lines = strutil.Split(rawText, '\n')
    if lines.len != expectedLineCount + 1 ||
       lines[0] != "cheng_profile_raw" ||
       lines[1] != "profile_kind=compiler_phase":
        err = "backend driver profile-report: invalid raw schema header"
        return false
    if !BackendDriverDispatchMinProfileLineValue(lines[2], "source_path", profile.sourcePath) ||
       !BackendDriverDispatchMinProfileLineValue(lines[3], "source_sha256", profile.sourceSha256) ||
       !BackendDriverDispatchMinProfileLineValue(lines[4], "source_tree_cid", profile.sourceTreeCid) ||
       !BackendDriverDispatchMinProfileLineValue(lines[5], "driver_path", profile.driverPath) ||
       !BackendDriverDispatchMinProfileLineValue(lines[6], "driver_sha256", profile.driverSha256) ||
       !BackendDriverDispatchMinProfileLineValue(lines[7], "output_path", profile.outputPath) ||
       !BackendDriverDispatchMinProfileLineValue(lines[8], "output_sha256", profile.outputSha256):
        err = "backend driver profile-report: raw identity fields malformed"
        return false
    if !BackendDriverDispatchMinProfileTextValueValid(profile.sourcePath) ||
       !BackendDriverDispatchMinProfileTextValueValid(profile.driverPath) ||
       !BackendDriverDispatchMinProfileTextValueValid(profile.outputPath) ||
       !BackendDriverDispatchMinSha256TextValid(profile.sourceSha256) ||
       !BackendDriverDispatchMinSha256TextValid(profile.sourceTreeCid) ||
       !BackendDriverDispatchMinSha256TextValid(profile.driverSha256) ||
       !BackendDriverDispatchMinSha256TextValid(profile.outputSha256):
        err = "backend driver profile-report: raw identity values invalid"
        return false
    var phaseCountText: str
    var phaseTotalText: str
    if !BackendDriverDispatchMinProfileLineValue(
           lines[9], "phase_count", phaseCountText) ||
       BackendDriverDispatchMinParseUnsignedInt64(phaseCountText) !=
           int64(phaseNames.len) ||
       !BackendDriverDispatchMinProfileLineValue(
           lines[10], "phase_total_ns", phaseTotalText):
        err = "backend driver profile-report: raw phase summary malformed"
        return false
    let declaredTotal = BackendDriverDispatchMinParseUnsignedInt64(phaseTotalText)
    if declaredTotal < int64(0):
        err = "backend driver profile-report: raw phase total invalid"
        return false
    for i in 0..<phaseNames.len:
        let parts = strutil.Split(lines[11 + i], '\t')
        if parts.len != 3 || parts[0] != "phase" ||
           parts[1] != phaseNames[i] ||
           !BackendDriverDispatchMinProfileAddPhase(
               profile, parts[1], parts[2], err):
            if len(err) <= 0:
                err = Fmt"backend driver profile-report: raw phase row invalid: {phaseNames[i]}"
            return false
    if profile.phaseTotalNs != declaredTotal ||
       profile.phaseNames.len != phaseNames.len ||
       profile.phaseNs[1] <= int64(0):
        err = "backend driver profile-report: raw phase total or compiler event mismatch"
        return false
    err = ""
    return true

fn BackendDriverDispatchMinRunProfileReportFromCmdline(): int32 =
    let rootDir = BackendDriverDispatchMinReadFlagOrDefault("--root", ".")
    let rawPath = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--in", ""))
    if len(rawPath) <= 0:
        return BackendDriverDispatchMinUnsupported("backend driver profile-report: missing --in")
    if !chengpath.FileExistsNonEmpty(rootDir, rawPath):
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver profile-report: missing raw profile: {rawPath}")
    var profile: BackendDriverDispatchMinCompilerPhaseProfile
    var err: str
    if !BackendDriverDispatchMinParseCompilerPhaseRaw(
           chengpath.ReadTextFile(rootDir, rawPath), profile, err):
        return BackendDriverDispatchMinUnsupported(err)
    var outPath = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--out", ""))
    if len(outPath) <= 0:
        outPath = BackendDriverDispatchMinProfileReportPathFromRaw(rawPath)
    let report = BackendDriverDispatchMinCompilerPhaseReportText(profile)
    if !BackendDriverDispatchMinEnsureParentDir(rootDir, outPath) ||
       !BackendDriverDispatchMinWriteTextAtomic(rootDir, outPath, report):
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver profile-report: failed to write report: {outPath}")
    BackendDriverDispatchMinPrintLine(strutil.Strip(report))
    return 0

fn BackendDriverDispatchMinRunCrashReportFromCmdline(): int32 =
    return BackendDriverDispatchMinUnsupported("backend driver direct: crash-report requires full selfhost debug report lowering")

fn BackendDriverDispatchMinProfileRunDefaultOut(rootDir: str,
                                                 sourcePath: str): str =
    return chengpath.PathJoin(chengpath.PathAbsolute(rootDir, "artifacts/debug_profile"), "profile_run")

fn BackendDriverDispatchMinRunProfileRunFromCmdline(): int32 =
    let rootDir = BackendDriverDispatchMinReadFlagOrDefault("--root", ".")
    let sourcePath = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--in", ""))
    let outputPath = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--out", ""))
    let reportPath = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--report-out", ""))
    let target = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--target", "arm64-apple-darwin"))
    let emit = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--emit", "exe"))
    if len(sourcePath) <= 0:
        return BackendDriverDispatchMinUnsupported("backend driver profile-run: missing --in")
    if len(outputPath) <= 0:
        return BackendDriverDispatchMinUnsupported("backend driver profile-run: missing --out")
    if len(reportPath) <= 0:
        return BackendDriverDispatchMinUnsupported("backend driver profile-run: missing --report-out")
    if target != "arm64-apple-darwin":
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver profile-run: local compiler phase target required: {target}")
    if emit != "exe":
        return BackendDriverDispatchMinUnsupported("backend driver profile-run: requires --emit:exe")
    let rawPath = BackendDriverDispatchMinProfileRawPathFromReport(reportPath)
    let sourceAbs = chengpath.PathAbsolute(rootDir, sourcePath)
    let outputAbs = chengpath.PathAbsolute(rootDir, outputPath)
    let reportAbs = chengpath.PathAbsolute(rootDir, reportPath)
    let rawAbs = chengpath.PathAbsolute(rootDir, rawPath)
    if sourceAbs == outputAbs || sourceAbs == reportAbs || sourceAbs == rawAbs ||
       outputAbs == reportAbs || outputAbs == rawAbs || reportAbs == rawAbs:
        return BackendDriverDispatchMinUnsupported(
            "backend driver profile-run: source, output, raw, and report paths must be distinct")
    let compileCode = BackendDriverDispatchMinRunSystemLinkExecFromCmdline()
    if compileCode != 0:
        return compileCode
    if !chengpath.FileExistsNonEmpty(rootDir, outputPath) ||
       !chengpath.FileExistsNonEmpty(rootDir, reportPath):
        return BackendDriverDispatchMinUnsupported(
            "backend driver profile-run: real compile output or phase ledger missing")
    let compileReport = chengpath.ReadTextFile(rootDir, reportPath)
    var profile: BackendDriverDispatchMinCompilerPhaseProfile
    var err: str
    if !BackendDriverDispatchMinCompilerPhaseProfileFromCompileReport(
           rootDir, sourcePath, outputPath, compileReport, profile, err):
        return BackendDriverDispatchMinUnsupported(err)
    let raw = BackendDriverDispatchMinCompilerPhaseRawText(profile)
    let report = BackendDriverDispatchMinCompilerPhaseReportText(profile)
    if !BackendDriverDispatchMinEnsureParentDir(rootDir, rawPath) ||
       !BackendDriverDispatchMinWriteTextAtomic(rootDir, rawPath, raw):
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver profile-run: failed to write raw profile: {rawPath}")
    if !BackendDriverDispatchMinEnsureParentDir(rootDir, reportPath) ||
       !BackendDriverDispatchMinWriteTextAtomic(rootDir, reportPath, report):
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver profile-run: failed to write profile report: {reportPath}")
    BackendDriverDispatchMinPrintLine(strutil.Strip(report))
    return 0

@borrows
fn BackendDriverDispatchMinWriteDarwinSyscallProviderObject(rootDir: str,
                                                             outPath: str): Result[bool] =
    return darwinprov.CodegenDarwinProviderUnitWriteObject(rootDir, outPath)

fn BackendDriverDispatchMinRunEmitDarwinSyscallProviderFromCmdline(): int32 =
    let rootDir = "."
    let outPath = BackendDriverDispatchMinReadFlagOrDefault("--out", "")
    let writeRes = BackendDriverDispatchMinWriteDarwinSyscallProviderObject(rootDir, outPath)
    if !writeRes.ok:
        BackendDriverDispatchMinPrintErr(writeRes.err.msg)
        return 1
    return 0

fn BackendDriverDispatchMinRunEmitCsgFromCmdline(): int32 =
    let workspaceRoot = BackendDriverDispatchMinCleanDotPath(
        chengpath.PathAbsolute(os.GetCurrentDir(), "."))
    var args = BackendDriverDispatchMinCollectArgsFrom(
        2, BackendDriverDispatchMinParamCount())
    let sourcePath =
        BackendDriverDispatchMinReadFlagOrDefault("--in", "")
    let emitText =
        BackendDriverDispatchMinReadFlagOrDefault("--emit", "")
    if len(emitText) > 0 && emitText != "obj":
        return BackendDriverDispatchMinUnsupported(
            Fmt"backend driver emit-csg: --emit must be obj, got {emitText}")
    if len(emitText) <= 0:
        add(args, "--emit:obj")
    if len(BackendDriverDispatchMinReadFlagOrDefault(
               "--out", "")) <= 0:
        add(args, Fmt"--out:{sourcePath}.csg.object")
    let reqRes = creq.CompilerRequestFromArgsForCommand(
        strings.CloneStr(workspaceRoot), BackendDriverDispatchMinCloneStrSeq(args), true)
    if IsErr(reqRes):
        return BackendDriverDispatchMinUnsupported(Error(reqRes))
    var req = Value(reqRes)
    let reportPath = strings.CloneStr(req.reportPath)
    var plan: sexec.SystemLinkExecPlan
    var runtimeResult:
        sexecrt.SystemLinkExecRuntimeResult
    var report: str
    var err: str
    if !BackendDriverDispatchMinExecuteFormalRequestInto(
           workspaceRoot,
           req,
           creq.CompilerWorldHeadFromArgs(args),
           creq.CompilerLockPathFromArgs(args),
           creq.CompilerBaselineSurfacePathFromArgs(args),
           creq.CompilerChannelFromArgs(args),
           "emit-csg",
           plan,
           runtimeResult,
           report,
           err):
        BackendDriverDispatchMinPrintErr(err)
        return 2
    if len(report) <= 0:
        BackendDriverDispatchMinPrintErr(
            "backend driver emit-csg: formal compiler CSG report is empty")
        return 1
    if !BackendDriverDispatchMinWriteOptionalReport(
           workspaceRoot, reportPath, Fmt"{report}\n"):
        BackendDriverDispatchMinPrintErr(
            Fmt"backend driver emit-csg: failed to write report: {reportPath}")
        return 1
    BackendDriverDispatchMinPrintLine(strutil.Strip(report))
    return 0


# parse-receipt: S1 3.1 driver-side span receipt emission.  Parses --in via the
# ordinary stub (completion point parser.cheng `parsed.normalizedExprLayer =
# exprLayer`), then serializes the valueExprTree DAG (nodes + region side
# table + token stream + statement roots), per-node identity hashes and the
# whole-tree trace root, plus driver/toolchain identity, as
# cheng_driver_parse_receipt JSON to --out.  No obligation binding happens
# here; failure at any step hard-fails with rc=2.
fn BackendDriverDispatchMinRunParseReceiptFromCmdline(): int32 =
    let rootDir = BackendDriverDispatchMinReadFlagOrDefault("--root", ".")
    let sourcePath = BackendDriverDispatchMinReadFlagOrDefault("--in", "")
    let outPath = BackendDriverDispatchMinReadFlagOrDefault("--out", "")
    let driverAbs = chengpath.PathAbsolute(
        rootDir, strutil.Strip(cmdline.ProgramName()))
    let runRes = parsecommand.CompilerParseReceiptCommandRun(
        rootDir,
        sourcePath,
        outPath,
        driverAbs)
    if !runRes.ok:
        BackendDriverDispatchMinPrintErr(
            "backend driver parse-receipt:" + runRes.err.msg)
        return 2
    BackendDriverDispatchMinPrintLine(runRes.value)
    return 0

fn BackendDriverDispatchMinRunCidCaseFromCmdline(): int32 =
    let argc = BackendDriverDispatchMinParamCount()
    var programPath: str
    var command: str
    var caseId: str
    var candidateSha256: str
    BackendDriverDispatchMinParamStrInto(0, programPath)
    BackendDriverDispatchMinParamStrInto(1, command)
    BackendDriverDispatchMinParamStrInto(2, caseId)
    BackendDriverDispatchMinParamStrInto(3, candidateSha256)
    var tarPayload: str
    var err: str
    if !cidcurrent.CidIdentityEvidenceCurrentRunCase(
            argc,
            programPath,
            command,
            caseId,
            candidateSha256,
            tarPayload,
            err):
        BackendDriverDispatchMinPrintErr(err)
        return 2
    os.Write(os.GetStdout(), tarPayload)
    return 0

fn BackendDriverDispatchMinCommandCode(cmd: str): int32 =
    if cmd == "help" || cmd == "-h" || cmd == "--help":
        return 0
    if cmd == "status":
        return 1
    if cmd == "print-build-plan":
        return 2
    if cmd == "verify-export-visibility":
        return 3
    if cmd == "verify-export-visibility-parallel":
        return 4
    if cmd == "system-link-exec":
        return 5
    if cmd == "run-host-smokes":
        return 6
    if cmd == "debug-report":
        return 8
    if cmd == "print-symbols":
        return 9
    if cmd == "print-line-map":
        return 10
    if cmd == "profile-run":
        return 11
    if cmd == "profile-report":
        return 12
    if cmd == "crash-report":
        return 13
    if cmd == "dry-compile":
        return 14
    if cmd == "emit-darwin-syscall-provider":
        return 15
    if cmd == "emit-csg":
        return 16
    if cmd == "parse-receipt":
        return 17
    if cmd == "run-case":
        return 18
    return -1

fn BackendDriverDispatchMinRunCommandWithCmd(cmd: str): int32 =
    let code = BackendDriverDispatchMinCommandCode(cmd)
    if code == 0:
        return BackendDriverDispatchMinHelp()
    if code == 1:
        return BackendDriverDispatchMinStatusFromCmdline()
    if code == 2:
        return BackendDriverDispatchMinPrintBuildPlanCommandFromCmdline()
    if code == 3:
        return BackendDriverDispatchMinVerifyExportVisibilityFromCmdline()
    if code == 4:
        return BackendDriverDispatchMinVerifyExportVisibilityParallelFromCmdline()
    if code == 5:
        return BackendDriverDispatchMinRunSystemLinkExecFromCmdline()
    if code == 6:
        return BackendDriverDispatchMinRunHostSmokesFromCmdline()
    if code == 8:
        return BackendDriverDispatchMinRunDebugReportFromCmdline()
    if code == 9:
        return BackendDriverDispatchMinRunPrintSymbolsFromCmdline()
    if code == 10:
        return BackendDriverDispatchMinRunPrintLineMapFromCmdline()
    if code == 11:
        return BackendDriverDispatchMinRunProfileRunFromCmdline()
    if code == 12:
        return BackendDriverDispatchMinRunProfileReportFromCmdline()
    if code == 13:
        return BackendDriverDispatchMinRunCrashReportFromCmdline()
    if code == 14:
        return BackendDriverDispatchMinRunDryCompileConcreteFields()
    if code == 15:
        return BackendDriverDispatchMinRunEmitDarwinSyscallProviderFromCmdline()
    if code == 16:
        return BackendDriverDispatchMinRunEmitCsgFromCmdline()
    if code == 17:
        return BackendDriverDispatchMinRunParseReceiptFromCmdline()
    if code == 18:
        return BackendDriverDispatchMinRunCidCaseFromCmdline()
    return 2

fn ParamStr(index: int32): str =
    return BackendDriverDispatchMinParamStr(index)

# 同模块 fn-value 包装: cold-hybrid 前端 (cold_parser) 不能取【限定名 (跨模块) 函数】的地址作
# fn-value, 只能取【同模块顶层函数】地址 (限定名仅支持 call, 不支持取址); 故此处包一层同模块
# 函数直调 subfetch.CasSubprocessFetcher (限定 call, cold 支持), 再把本地函数名作 fn-value 注入。
fn backendDriverDispatchMinCasSubprocessFetch(cidHex: str): Result[Bytes] =
    return subfetch.CasSubprocessFetcher(cidHex)

# 同模块 ensure-lock 包装 (同 fetcher 包装理由): 缺锁自举 miss-hook 通过此 fn-value 触发子进程
# 拉取 + TOFU/pin 校验并写 lock。跨模块限定名不能取址作 fn-value, 故同模块包一层直调。
fn backendDriverDispatchMinCasEnsureLock(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    return subfetch.CasSubprocessEnsureLock(channelHex, modulePath, storeRoot)

fn BackendDriverDispatchMinRunCommand(): int32 =
    # S3 CAS fetch-on-miss 接线 (env-gated 特性开关): CHENG_CAS_FETCH_FROM 非空 → 把子进程
    # fetcher 注入 parser 槽, 使依赖 import blob-miss 时 fork+execv 调 net_cas_cli 真 UDP QUIC
    # 按 cid 拉源 (编译器进程本体零 QUIC 闭包, 故 cold-hybrid direct-emit driver 也可用)。默认
    # 未设不注入 → parser 槽恒 false 走旧磁盘路径, 零 QUIC 激活零回归。置于 RunCommand 最早段:
    # 先于任何子命令派发 (system-link-exec 等), 使编译途中 miss-hook 命中已注入 fetcher。
    # 门 gate 拓宽: FETCH_FROM (S3 fetch-on-miss) 或 CHENG_CAS_BOOTSTRAP (P5 缺锁自举) 任一非空即
    # 注入。缺锁自举额外把 ensure-lock 注入 parser 槽, 使外部包 import miss 时 miss-hook 自动
    # fork+execv 拉源 + TOFU/pin 校验 + 写 lock (编译器进程内自动触发, 无需外部独立 ensure 进程)。
    if os.GetEnv("CHENG_CAS_FETCH_FROM") != "" || os.GetEnv("CHENG_CAS_BOOTSTRAP") != "":
        parser.ParserSetCasFetcher(backendDriverDispatchMinCasSubprocessFetch)
        parser.ParserSetCasLockEnsurer(backendDriverDispatchMinCasEnsureLock)
    let count = BackendDriverDispatchMinParamCount()
    if count <= 0:
        return BackendDriverDispatchMinHelp()
    var cmd: str
    BackendDriverDispatchMinParamStrInto(1, cmd)
    return BackendDriverDispatchMinRunCommandWithCmd(cmd)

fn BackendDriverDispatchMinRun(): int32 =
    return BackendDriverDispatchMinRunCommand()

fn main(argc: int32, argv: ptr): int32 =
    # [m1-line] The allocation ledger provider only arms on an empty process
    # heap, so when CHENG_CSG_ALLOC_LEDGER=1 this must precede every
    # allocating operation, argv capture included.  Unset env: no-op.
    ccsg.CompilerCsgAllocLedgerEntryBegin()
    cmdline.CaptureCmdLine(argc, argv)
    # B1（2026-08-25）：驱动=codegen 单元组合根（蓝图 3.0/3.2）。Cheng 无
    # 模块 init，契约单元注册表须在首次派发前显式装载；任一单元注册失败
    # 即显式退出（fail-closed，不留默认臂）。
    if !x8664adapter.RegallocX64CodegenUnitRegister() ||
       !riscvadapter.RegallocRiscvCodegenUnitRegister() ||
       !rega64.RegallocA64CodegenUnitRegister():
        return 70
    return BackendDriverDispatchMinRunCommand()
