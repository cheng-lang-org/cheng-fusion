        exportRootsText: str
        logPath: str
        compilerSha256: str
        closureCid: str
        cacheKey: str
        cacheObjectPath: str
        cacheReportPath: str
        cacheBindingPath: str
        pinnedCacheReportPath: str
        pinnedCacheReportSha256: str
        pinnedCacheObjectPath: str
        pinnedCacheObjectCanonicalPath: str
        pinnedCacheObjectSha256: str
        pinnedCacheObjectSize: str
