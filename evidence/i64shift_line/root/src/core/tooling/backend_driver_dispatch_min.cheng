@borrows
fn BackendDriverDispatchMinPrintErr(text: str) =
    os.WriteLine(os.GetStderr(), text)

@borrows
fn BackendDriverDispatchMinPrintLine(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn BackendDriverDispatchMinParamCount(): int32 =
    return BackendDriverDispatchMinParamCountBridge()

fn BackendDriverDispatchMinParamStr(index: int32): str =
    var out: str
    BackendDriverDispatchMinParamStrPtrCopyInto(index, out)
    return out

fn BackendDriverDispatchMinParamStrInto(index: int32,
                                         out: var str) =
    BackendDriverDispatchMinParamStrPtrCopyInto(index, out)

fn BackendDriverDispatchMinParamStrPtrCopyInto(index: int32,
                                               out: var str) =
    out = ""
    let raw = BackendDriverDispatchMinParamStrPtrBridge(index)
    if raw == nil:
        return
    let rawLen = BackendDriverDispatchMinCStringLenBridge(raw)
    if rawLen <= 0:
        return
    out = system.NewStringCopy(raw, rawLen)

@borrows
fn BackendDriverDispatchMinEnsureParentDir(rootDir: str,
                                            pathRaw: str): bool =
    let parent = chengpath.PathParentDir(chengpath.PathAbsolute(rootDir, pathRaw))
    if len(parent) <= 0:
        return true
    let ownedRootDir = NewStringCopy(rootDir.data, len(rootDir))
    return chengpath.MkdirP(ownedRootDir, parent)

fn BackendDriverDispatchMinReportBuilderReset() =
    backendDriverDispatchMinReportBuilderActive = false
    backendDriverDispatchMinReportBuilderLines = []
    backendDriverDispatchMinReportBuilderTextBytes = int64(0)

fn BackendDriverDispatchMinBeginReportBuilder() =
    backendDriverDispatchMinReportBuilderActive = true
    backendDriverDispatchMinReportBuilderLines = []
    backendDriverDispatchMinReportBuilderTextBytes = int64(0)

fn BackendDriverDispatchMinBeginReportBuilderFrom(out: var str) =
    let seed = out
    BackendDriverDispatchMinBeginReportBuilder()
    if len(seed) > 0:
        add(backendDriverDispatchMinReportBuilderLines, strings.CloneStr(seed))
        backendDriverDispatchMinReportBuilderTextBytes = int64(len(seed))
        out = ""

fn BackendDriverDispatchMinReportBuilderStructuredLiveBytes(): int64 =
    return int64(24) + backendDriverDispatchMinReportBuilderTextBytes

fn BackendDriverDispatchMinFinishReportBuilder(out: var str) =
    if !backendDriverDispatchMinReportBuilderActive:
        return
    out = strutil.Join(backendDriverDispatchMinReportBuilderLines, "\n")
    BackendDriverDispatchMinReportBuilderReset()

@borrows
fn BackendDriverDispatchMinWriteReport(rootDir: str,
                                        reportPath: str,
                                        reportText: str): bool =
    if backendDriverDispatchMinReportBuilderActive:
        if len(reportPath) <= 0:
            BackendDriverDispatchMinReportBuilderReset()
            return true
        var builtReportText: str
        BackendDriverDispatchMinFinishReportBuilder(builtReportText)
        if !BackendDriverDispatchMinEnsureParentDir(rootDir, reportPath):
            return false
        return chengpath.WriteTextFile(rootDir, reportPath, builtReportText)
    if len(reportPath) <= 0:
        return true
    if !BackendDriverDispatchMinEnsureParentDir(rootDir, reportPath):
        return false
    return chengpath.WriteTextFile(rootDir, reportPath, reportText)

fn BackendDriverDispatchMinWritePlanNotReadyReport(rootDir: str,
                                                    reportPath: str): bool =
    if len(reportPath) <= 0:
        return true
    if !BackendDriverDispatchMinEnsureParentDir(rootDir, reportPath):
        return false
    BackendDriverDispatchMinWriteTextFileBridge(reportPath,
                                                 "system_link_exec_runtime_execute=error\nerror=plan_not_ready\n")
    return true

@borrows
fn BackendDriverDispatchMinWriteGateBlockerReport(rootDir: str,
                                                   reportPath: str,
                                                   blockerId: str,
                                                   phase: str,
                                                   targetTriple: str,
                                                   emitText: str,
                                                   reason: str): bool =
    if len(reportPath) <= 0:
        return true
    var out = ""
    BackendDriverDispatchMinAppendLine(out, "system_link_exec_runtime_execute=0")
    BackendDriverDispatchMinAppendLine(out, "system_link_exec=0")
    BackendDriverDispatchMinAppendLine(out, "real_backend_codegen=0")
    BackendDriverDispatchMinAppendLine(out, "cold_system_link_exec=0")
    BackendDriverDispatchMinAppendLine(out, "full_backend_codegen=0")
    BackendDriverDispatchMinAppendLine(out, "gate_blocked=1")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_id={blockerId}")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_phase={phase}")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_target={targetTriple}")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_emit={emitText}")
    let blockerReportPath = chengpath.PathAbsolute(rootDir, reportPath)
    let requestedOutputPath = BackendDriverDispatchMinReadFlagOrDefault("--out", "")
    var blockerArtifactPath = ""
    var blockerMapPath = ""
    var blockerArtifactExists = "0"
    var blockerMapExists = "0"
    if len(requestedOutputPath) > 0:
        blockerArtifactPath = chengpath.PathAbsolute(rootDir, requestedOutputPath)
        blockerMapPath = Fmt"{blockerArtifactPath}.map"
        if chengpath.FileExistsNonEmpty(rootDir, blockerArtifactPath):
            blockerArtifactExists = "1"
        if chengpath.FileExistsNonEmpty(rootDir, blockerMapPath):
            blockerMapExists = "1"
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_report={blockerReportPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_artifact={blockerArtifactPath}")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_map={blockerMapPath}")
    BackendDriverDispatchMinAppendLine(out, "gate_blocker_report_will_write=1")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_artifact_exists={blockerArtifactExists}")
    BackendDriverDispatchMinAppendLine(out, Fmt"gate_blocker_map_exists={blockerMapExists}")
    BackendDriverDispatchMinAppendLine(out, Fmt"report_rss_bytes={BackendDriverDispatchMinCurrentRssBytes()}")
    if blockerId == "required_pure_provenance_unavailable":
        BackendDriverDispatchMinAppendLine(out, "full_backend_blocked=1")
    if blockerId == "forbidden_large_closure_materialize_entry":
        BackendDriverDispatchMinAppendLine(out, "full_backend_blocked=1")
    if blockerId == "windows_linkerless_unsupported":
        BackendDriverDispatchMinAppendLine(out, "windows_linkerless_unsupported=1")
        BackendDriverDispatchMinAppendLine(out, "linkerless_image=0")
        BackendDriverDispatchMinAppendLine(out, "system_link=0")
    BackendDriverDispatchMinAppendLine(out, Fmt"error={reason}")
    return BackendDriverDispatchMinWriteReport(rootDir, reportPath, out)

@borrows
fn BackendDriverDispatchMinAppendLine(out: var str,
                                       line: str) =
    if backendDriverDispatchMinReportBuilderActive:
        if backendDriverDispatchMinReportBuilderLines.len > 0:
            backendDriverDispatchMinReportBuilderTextBytes = backendDriverDispatchMinReportBuilderTextBytes + int64(1)
        backendDriverDispatchMinReportBuilderTextBytes = backendDriverDispatchMinReportBuilderTextBytes + int64(len(line))
        add(backendDriverDispatchMinReportBuilderLines,
            strings.CloneStr(line))
        return
    if len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{line}"

fn BackendDriverDispatchMinNowNs(): int64 =
    return BackendDriverDispatchMinMonoTimeNsBridge()

fn BackendDriverDispatchMinPhaseMsText(ns: int64): str =
    if ns <= int64(0):
        return "0"
    return strings.Int64ToStr(ns / int64(1000000))

fn BackendDriverDispatchMinDivCeilI64(value: int64,
                                      divisorRaw: int32): int64 =
    if value <= int64(0):
        return int64(0)
    var divisor = divisorRaw
    if divisor <= 0:
        divisor = 1
    return (value + int64(divisor) - int64(1)) / int64(divisor)

fn BackendDriverDispatchMinRatioMilliText(numerator: int64,
                                           denominator: int64): str =
    if denominator <= int64(0):
        return "0.000"
    let milli = (numerator * int64(1000)) / denominator
    let whole = milli / int64(1000)
    let frac = milli % int64(1000)
    var fracText = strings.Int64ToStr(frac)
    if frac < int64(10):
        fracText = Fmt"00{fracText}"
    elif frac < int64(100):
        fracText = Fmt"0{fracText}"
    return Fmt"{whole}.{fracText}"

fn BackendDriverDispatchMinPercentMilliText(numerator: int64,
                                             denominator: int64): str =
    if denominator <= int64(0):
        return "0.000"
    let milli = (numerator * int64(100000)) / denominator
    let whole = milli / int64(1000)
    let frac = milli % int64(1000)
    var fracText = strings.Int64ToStr(frac)
    if frac < int64(10):
        fracText = Fmt"00{fracText}"
    elif frac < int64(100):
        fracText = Fmt"0{fracText}"
    return Fmt"{whole}.{fracText}"

fn BackendDriverDispatchMinPositiveJobs(rawJobs: int32): int32 =
    if rawJobs <= 0:
        return 1
    return rawJobs

fn BackendDriverDispatchMinHardwareJobs(): int32 =
    let raw = thread.Parallelism()
    if raw <= 0:
        return 1
    return raw

fn BackendDriverDispatchMinRequestedJobs(): int32 =
    let backendJobsRaw = os.GetEnv("BACKEND_JOBS")
    if len(backendJobsRaw) > 0:
        let parsed = strutil.ParseInt(backendJobsRaw)
        if parsed > 0:
            return parsed
    return 1

fn BackendDriverDispatchMinReadRequestedJobsControl(jobCount: var int32,
                                                     err: var str): bool =
    let raw = strutil.Strip(BackendDriverDispatchMinReadFlagOrDefault("--backend-jobs", ""))
    if len(raw) > 0:
        let parsed = strutil.ParseInt(raw)
        if parsed < 1:
            err = Fmt"backend driver: unsupported --backend-jobs: {raw}"
            return false
        jobCount = parsed
        err = ""
        return true
    jobCount = BackendDriverDispatchMinRequestedJobs()
    err = ""
    return true

fn BackendDriverDispatchMinApplyRequestedJobsControl(linkPlan: var slplan.SystemLinkPlanStub,
                                                      err: var str): bool =
    var jobCount: int32
    if !BackendDriverDispatchMinReadRequestedJobsControl(jobCount, err):
        return false
    linkPlan.jobCount = BackendDriverDispatchMinPositiveJobs(jobCount)
    return true

fn BackendDriverDispatchMinEffectiveJobs(requestedJobs: int32,
                                         hardwareJobs: int32): int32 =
    var jobs = BackendDriverDispatchMinPositiveJobs(requestedJobs)
    let hardware = BackendDriverDispatchMinPositiveJobs(hardwareJobs)
    if jobs > hardware:
        jobs = hardware
    return jobs

fn BackendDriverDispatchMinRefreshPhaseProfile(profile: var BackendDriverDispatchMinPhaseProfile) =
    if profile.totalStartNs > int64(0):
        profile.totalNs = BackendDriverDispatchMinNowNs() - profile.totalStartNs

fn BackendDriverDispatchMinCountSourceLines(text: str): int64 =
    let n = len(text)
    if n <= 0:
        return int64(0)
    var lines: int64
    for i in 0..<n:
        if text[i] == '\n':
            lines = lines + int64(1)
    if text[n - 1] != '\n':
        lines = lines + int64(1)
    return lines

fn BackendDriverDispatchMinMaxI64(a: int64,
                                  b: int64): int64 =
    if a > b:
        return a
    return b

@borrows
fn BackendDriverDispatchMinWorkspaceRootFromCmdline(): str =
    return BackendDriverDispatchMinCleanDotPath(
        chengpath.PathAbsoluteBridgeSafe(
            "",
            BackendDriverDispatchMinReadFlagOrDefault("--root", ".")))

@borrows
fn BackendDriverDispatchMinCleanDotPath(pathRaw: str): str =
    let path = pathRaw
    if path.len <= 0:
        return ""
    var out: str
    var segmentStart: int32
    if path[0] == '/':
        out = "/"
        segmentStart = 1
    var cursor = segmentStart
    while cursor <= path.len:
        let atEnd = cursor >= path.len
        var stop = false
        if atEnd:
            stop = true
        elif path[cursor] == '/' || path[cursor] == '\\':
            stop = true
        if !stop:
            cursor = cursor + 1
            continue
        let segment = chengpath.TextSlice(path,
                                          segmentStart,
                                          cursor - segmentStart)
        if segment != "" && segment != ".":
            if out.len > 0 && out[out.len - 1] != '/':
                out = strutil.Join([out, "/"], "")
            out = strutil.Join([out, segment], "")
        segmentStart = cursor + 1
        cursor = cursor + 1
    return out

@borrows
fn BackendDriverDispatchMinPathSeen(paths: str[],
                                     value: str): bool =
    for i in 0..<paths.len:
        if paths[i] == value:
            return true
    return false

fn BackendDriverDispatchMinPositiveNs(ns: int64): int64 =
    if ns <= int64(0):
        return int64(0)
    return ns

@borrows
fn BackendDriverDispatchMinTextHasAt(text: str,
                                     start: int32,
                                     needle: str): bool =
    if needle.len <= 0:
        return false
    if start < 0 || start + needle.len > text.len:
        return false
    for i in 0..<needle.len:
        if text[start + i] != needle[i]:
            return false
    return true

fn BackendDriverDispatchMinCountLiteral(text: str,
                                        needle: str): int64 =
    if needle.len <= 0 || text.len < needle.len:
        return int64(0)
    var count: int64
    var cursor: int32
    while cursor + needle.len <= text.len:
        if BackendDriverDispatchMinTextHasAt(text, cursor, needle):
            count = count + int64(1)
            cursor = cursor + needle.len
        else:
            cursor = cursor + 1
    return count

fn BackendDriverDispatchMinCountLineStart(text: str,
                                          needle: str): int64 =
    var count: int64
    if BackendDriverDispatchMinTextHasAt(text, 0, needle):
        count = count + int64(1)
    return count + BackendDriverDispatchMinCountLiteral(text, strutil.Join(["\n", needle], ""))

fn BackendDriverDispatchMinIsAsciiUpper(c: char): bool =
    return c >= 'A' && c <= 'Z'

fn BackendDriverDispatchMinCountExportedFnDecls(text: str): int64 =
    var count: int64
    var cursor: int32
    while cursor + 3 < text.len:
        if BackendDriverDispatchMinTextHasAt(text, cursor, "fn ") &&
           BackendDriverDispatchMinIsAsciiUpper(text[cursor + 3]):
            count = count + int64(1)
        cursor = cursor + 1
    return count

@borrows
fn BackendDriverDispatchMinAtLineStart(text: str,
                                        index: int32): bool =
    if index <= 0:
        return true
    if index > text.len:
        return false
    return text[index - 1] == '\n'

@borrows
fn BackendDriverDispatchMinDryCompileScanSourceText(text: str,
                                                     outLines: var int64,
                                                     outFunctionCount: var int64,
                                                     outExportCount: var int64,
                                                     outImportcCount: var int64,
                                                     outCallEdgeCount: var int64,
                                                     outTypeRefCount: var int64,
                                                     outDeclCount: var int64) =
    let n = len(text)
    if n <= 0:
        return
    for cursor in 0..<n:
        let ch = text[cursor]
        if ch == '\n':
            outLines = outLines + int64(1)
        if ch == '(':
            outCallEdgeCount = outCallEdgeCount + int64(1)
        elif ch == ':' || ch == '[':
            outTypeRefCount = outTypeRefCount + int64(1)
        elif ch == 'f':
            if BackendDriverDispatchMinTextHasAt(text, cursor, "fn "):
                outFunctionCount = outFunctionCount + int64(1)
                if cursor + 3 < n && BackendDriverDispatchMinIsAsciiUpper(text[cursor + 3]):
                    outExportCount = outExportCount + int64(1)
        elif ch == 'i':
            if BackendDriverDispatchMinTextHasAt(text, cursor, "iterator "):
                outFunctionCount = outFunctionCount + int64(1)
        elif ch == '@':
            if BackendDriverDispatchMinTextHasAt(text, cursor, "@importc"):
                outImportcCount = outImportcCount + int64(1)
            elif BackendDriverDispatchMinTextHasAt(text, cursor, "@exportc"):
                outExportCount = outExportCount + int64(1)
        elif ch == 't':
            if BackendDriverDispatchMinTextHasAt(text, cursor, "type "):
                outTypeRefCount = outTypeRefCount + int64(1)
    if text[n - 1] != '\n':
        outLines = outLines + int64(1)
    outCallEdgeCount = outCallEdgeCount - outFunctionCount
    if outCallEdgeCount < int64(0):
        outCallEdgeCount = int64(0)
    outTypeRefCount = outTypeRefCount + (outImportcCount * int64(2))
    outDeclCount = outFunctionCount
    for cursor in 0..<n:
        if !BackendDriverDispatchMinAtLineStart(text, cursor):
            continue
        if BackendDriverDispatchMinTextHasAt(text, cursor, "type"):
            outDeclCount = outDeclCount + int64(1)
        elif BackendDriverDispatchMinTextHasAt(text, cursor, "let "):
            outDeclCount = outDeclCount + int64(1)
        elif BackendDriverDispatchMinTextHasAt(text, cursor, "var "):
            outDeclCount = outDeclCount + int64(1)
        elif BackendDriverDispatchMinTextHasAt(text, cursor, "const "):
            outDeclCount = outDeclCount + int64(1)
        elif BackendDriverDispatchMinTextHasAt(text, cursor, "macro "):
            outDeclCount = outDeclCount + int64(1)
        elif BackendDriverDispatchMinTextHasAt(text, cursor, "template "):
            outDeclCount = outDeclCount + int64(1)
        elif BackendDriverDispatchMinTextHasAt(text, cursor, "concept "):
            outDeclCount = outDeclCount + int64(1)
        elif BackendDriverDispatchMinTextHasAt(text, cursor, "trait "):
            outDeclCount = outDeclCount + int64(1)

type
    BackendDriverDispatchMinDryCompileSourceStats =
        files: int64
        lines: int64
        bytes: int64
        maxFileBytes: int64
        declCount: int64
        functionCount: int64
        exportCount: int64
        importcCount: int64
        callEdgeCount: int64
        typeRefCount: int64
        sourcePaths: str[]
        sourceRawBytesCids: layout.FixedBytes32[]
        sourceByteCounts: int64[]
        sourceLineCounts: int64[]
        sourceImportEdgeCounts: int32[]
        sourceDiscoveryKinds: int32[]
        sourceDiscovererSourceIndices: int32[]
        sourceDiscovererEdgeIndices: int32[]
        sourceImportEdges: parser.ImportEdge[]
        sourceBundleEntrySourceIndex: int32
        sourceBundleCid: layout.FixedBytes32
        entrySourceCid: layout.FixedBytes32
        importGraphCid: layout.FixedBytes32
        sourceBundleBindingSeal: layout.FixedBytes32
        unresolvedImportCount: int32
        sourceManifestCid: layout.FixedBytes32

fn BackendDriverDispatchMinDryCompileSourceStatsReset(stats: var BackendDriverDispatchMinDryCompileSourceStats) =
    stats.files = int64(0)
    stats.lines = int64(0)
    stats.bytes = int64(0)
    stats.maxFileBytes = int64(0)
    stats.declCount = int64(0)
    stats.functionCount = int64(0)
    stats.exportCount = int64(0)
    stats.importcCount = int64(0)
    stats.callEdgeCount = int64(0)
    stats.typeRefCount = int64(0)
    stats.sourcePaths = []
    stats.sourceRawBytesCids = []
    stats.sourceByteCounts = []
    stats.sourceLineCounts = []
    stats.sourceImportEdgeCounts = []
    stats.sourceDiscoveryKinds = []
    stats.sourceDiscovererSourceIndices = []
    stats.sourceDiscovererEdgeIndices = []
    stats.sourceImportEdges = []
    stats.sourceBundleEntrySourceIndex = -1
    var emptySourceBundleCid: layout.FixedBytes32
    stats.sourceBundleCid = emptySourceBundleCid
    var emptyEntrySourceCid: layout.FixedBytes32
    stats.entrySourceCid = emptyEntrySourceCid
    var emptyImportGraphCid: layout.FixedBytes32
    stats.importGraphCid = emptyImportGraphCid
    var emptySourceBundleBindingSeal: layout.FixedBytes32
    stats.sourceBundleBindingSeal = emptySourceBundleBindingSeal
    stats.unresolvedImportCount = -1
    var emptyManifestCid: layout.FixedBytes32
    stats.sourceManifestCid = emptyManifestCid

@borrows
fn BackendDriverDispatchMinDryCompileSourceStatsAddText(stats: var BackendDriverDispatchMinDryCompileSourceStats,
                                                        text: str) =
    let fileBytes = int64(len(text))
    stats.files = stats.files + int64(1)
    stats.bytes = stats.bytes + fileBytes
    stats.maxFileBytes = BackendDriverDispatchMinMaxI64(stats.maxFileBytes, fileBytes)
    var lines: int64
    var functionCount: int64
    var exportCount: int64
    var importcCount: int64
    var callEdgeCount: int64
    var typeRefCount: int64
    var declCount: int64
    BackendDriverDispatchMinDryCompileScanSourceText(text,
                                                     lines,
                                                     functionCount,
                                                     exportCount,
                                                     importcCount,
                                                     callEdgeCount,
                                                     typeRefCount,
                                                     declCount)
    stats.lines = stats.lines + lines
    stats.declCount = stats.declCount + declCount
    stats.functionCount = stats.functionCount + functionCount
    stats.exportCount = stats.exportCount + exportCount
    stats.importcCount = stats.importcCount + importcCount
    stats.callEdgeCount = stats.callEdgeCount + callEdgeCount
    stats.typeRefCount = stats.typeRefCount + typeRefCount

fn BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

fn BackendDriverDispatchMinDryCompileManifestAppendU64(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 56) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 48) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 40) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 32) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn BackendDriverDispatchMinDryCompileManifestAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    BackendDriverDispatchMinDryCompileManifestAppendU32(buf, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(buf, int32(value[i]) & 255)

fn BackendDriverDispatchMinDryCompileDiscoveryKindText(
        kind: int32): str =
    if kind == BackendDriverDispatchMinDryCompileDiscoveryEntry:
        return "entry"
    if kind ==
       BackendDriverDispatchMinDryCompileDiscoveryValueIntrinsic:
        return "value_intrinsic"
    if kind == BackendDriverDispatchMinDryCompileDiscoveryImportEdge:
        return "import_edge"
    panic("backend_driver_dry_compile_discovery_kind_invalid")

@borrows
fn BackendDriverDispatchMinImportEdgeOwnedClone(
        edge: var parser.ImportEdge,
        out: var parser.ImportEdge) =
    out.ownerProducerSourceIndex = edge.ownerProducerSourceIndex
    out.importDeclarationSourceLocalRow =
        edge.importDeclarationSourceLocalRow
    out.importItemSourceLocalRow = edge.importItemSourceLocalRow
    out.importDeclarationRow = edge.importDeclarationRow
    out.importItemRow = edge.importItemRow
    out.ownerModulePath =
        NewStringCopy(edge.ownerModulePath.data, edge.ownerModulePath.len)
    out.targetModulePath =
        NewStringCopy(edge.targetModulePath.data, edge.targetModulePath.len)
    out.targetSourcePath =
        NewStringCopy(edge.targetSourcePath.data, edge.targetSourcePath.len)
    out.targetSourcePathLen = edge.targetSourcePathLen
    out.targetSourcePathFirstCode = edge.targetSourcePathFirstCode
    out.targetSourcePathLastCode = edge.targetSourcePathLastCode
    out.targetSourcePathDotCount = edge.targetSourcePathDotCount
    out.targetSourcePathHash = edge.targetSourcePathHash
    out.targetProfileIndex = edge.targetProfileIndex
    out.importAlias =
        NewStringCopy(edge.importAlias.data, edge.importAlias.len)
    out.qualifier =
        NewStringCopy(edge.qualifier.data, edge.qualifier.len)
    out.allowsUnqualifiedCall = edge.allowsUnqualifiedCall
    out.resolved = edge.resolved

@borrows
fn BackendDriverDispatchMinImportEdgeEqual(
        left: var parser.ImportEdge,
        right: var parser.ImportEdge): bool =
    return left.ownerModulePath == right.ownerModulePath &&
           left.targetModulePath == right.targetModulePath &&
           left.targetSourcePath == right.targetSourcePath &&
           left.targetSourcePathLen == right.targetSourcePathLen &&
           left.targetSourcePathFirstCode ==
               right.targetSourcePathFirstCode &&
           left.targetSourcePathLastCode ==
               right.targetSourcePathLastCode &&
           left.targetSourcePathDotCount ==
               right.targetSourcePathDotCount &&
           left.targetSourcePathHash == right.targetSourcePathHash &&
           left.targetProfileIndex == right.targetProfileIndex &&
           left.importAlias == right.importAlias &&
           left.qualifier == right.qualifier &&
           left.allowsUnqualifiedCall == right.allowsUnqualifiedCall &&
           left.resolved == right.resolved

@borrows
fn BackendDriverDispatchMinDryCompileManifestAppendImportEdge(
        buf: var layout.ByteBuf,
        edge: var parser.ImportEdge) =
    BackendDriverDispatchMinDryCompileManifestAppendText(
        buf, edge.ownerModulePath)
    BackendDriverDispatchMinDryCompileManifestAppendText(
        buf, edge.targetModulePath)
    BackendDriverDispatchMinDryCompileManifestAppendText(
        buf, edge.targetSourcePath)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.targetSourcePathLen)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.targetSourcePathFirstCode)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.targetSourcePathLastCode)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.targetSourcePathDotCount)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.targetSourcePathHash)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.targetProfileIndex)
    BackendDriverDispatchMinDryCompileManifestAppendText(
        buf, edge.importAlias)
    BackendDriverDispatchMinDryCompileManifestAppendText(
        buf, edge.qualifier)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.allowsUnqualifiedCall ? 1 : 0)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, edge.resolved ? 1 : 0)

@borrows
fn BackendDriverDispatchMinDryCompileSourceStatsAppendManifestRow(
        stats: var BackendDriverDispatchMinDryCompileSourceStats,
        path: str,
        sourceText: var str,
        fileLineCount: int64,
        fileImportEdgeCount: int32): bool =
    if path.len <= 0 || sourceText.len <= 0 ||
       fileLineCount <= int64(0) || fileImportEdgeCount < 0:
        return false
    let sourceCid = cworld.CompilerWorldSourceRawBytesCidBorrowed(sourceText)
    add(stats.sourcePaths, NewStringCopy(path.data, path.len))
    add(stats.sourceRawBytesCids, sourceCid)
    add(stats.sourceByteCounts, int64(sourceText.len))
    add(stats.sourceLineCounts, fileLineCount)
    add(stats.sourceImportEdgeCounts, fileImportEdgeCount)
    return true

fn BackendDriverDispatchMinDryCompileSourceStatsSealManifest(
        stats: var BackendDriverDispatchMinDryCompileSourceStats,
        importEdgeCount: int32): bool =
    let sourceCount = stats.sourcePaths.len
    if sourceCount <= 0 ||
       stats.sourceRawBytesCids.len != sourceCount ||
       stats.sourceByteCounts.len != sourceCount ||
       stats.sourceLineCounts.len != sourceCount ||
       stats.sourceImportEdgeCounts.len != sourceCount ||
       stats.sourceDiscoveryKinds.len != sourceCount ||
       stats.sourceDiscovererSourceIndices.len != sourceCount ||
       stats.sourceDiscovererEdgeIndices.len != sourceCount ||
       stats.sourceImportEdges.len != importEdgeCount ||
       stats.sourceBundleEntrySourceIndex < 0 ||
       stats.sourceBundleEntrySourceIndex >= sourceCount ||
       stats.unresolvedImportCount != 0:
        return false
    var edgeCountSum: int64
    var byteCountSum: int64
    var lineCountSum: int64
    var maxFileBytes: int64
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    BackendDriverDispatchMinDryCompileManifestAppendText(
        buf, "cheng.backend_driver.dry_compile.source_manifest")
    BackendDriverDispatchMinDryCompileManifestAppendU32(buf, sourceCount)
    for sourceIndex in 0..<sourceCount:
        let byteCount = stats.sourceByteCounts[sourceIndex]
        let lineCount = stats.sourceLineCounts[sourceIndex]
        let sourceEdgeCount = stats.sourceImportEdgeCounts[sourceIndex]
        let discoveryKind = stats.sourceDiscoveryKinds[sourceIndex]
        let discovererSourceIndex =
            stats.sourceDiscovererSourceIndices[sourceIndex]
        let discovererEdgeIndex =
            stats.sourceDiscovererEdgeIndices[sourceIndex]
        if stats.sourcePaths[sourceIndex].len <= 0 ||
           byteCount <= int64(0) || lineCount <= int64(0) ||
           sourceEdgeCount < 0:
            layout.ByteBufFree(buf)
            return false
        if sourceIndex == 0:
            if discoveryKind !=
                   BackendDriverDispatchMinDryCompileDiscoveryEntry ||
               discovererSourceIndex != -1 ||
               discovererEdgeIndex != -1:
                layout.ByteBufFree(buf)
                return false
        else:
            if discovererSourceIndex < 0 ||
               discovererSourceIndex >= sourceIndex:
                layout.ByteBufFree(buf)
                return false
            if discoveryKind ==
               BackendDriverDispatchMinDryCompileDiscoveryValueIntrinsic:
                if discovererEdgeIndex != -1:
                    layout.ByteBufFree(buf)
                    return false
            elif discoveryKind ==
                 BackendDriverDispatchMinDryCompileDiscoveryImportEdge:
                if discovererEdgeIndex < 0 ||
                   discovererEdgeIndex >=
                       stats.sourceImportEdgeCounts[discovererSourceIndex]:
                    layout.ByteBufFree(buf)
                    return false
                var globalEdgeIndex = discovererEdgeIndex
                for ownerSourceIndex in 0..<discovererSourceIndex:
                    globalEdgeIndex = globalEdgeIndex +
                        stats.sourceImportEdgeCounts[ownerSourceIndex]
                if globalEdgeIndex < 0 ||
                   globalEdgeIndex >= stats.sourceImportEdges.len ||
                   !stats.sourceImportEdges[globalEdgeIndex].resolved ||
                   stats.sourceImportEdges[globalEdgeIndex].targetSourcePath !=
                       stats.sourcePaths[sourceIndex]:
                    layout.ByteBufFree(buf)
                    return false
            else:
                layout.ByteBufFree(buf)
                return false
        BackendDriverDispatchMinDryCompileManifestAppendText(
            buf, stats.sourcePaths[sourceIndex])
        layout.ByteBufAppendFixed32(
            buf, stats.sourceRawBytesCids[sourceIndex])
        BackendDriverDispatchMinDryCompileManifestAppendU64(buf, byteCount)
        BackendDriverDispatchMinDryCompileManifestAppendU64(buf, lineCount)
        BackendDriverDispatchMinDryCompileManifestAppendU32(
            buf, sourceEdgeCount)
        BackendDriverDispatchMinDryCompileManifestAppendText(
            buf,
            BackendDriverDispatchMinDryCompileDiscoveryKindText(
                discoveryKind))
        BackendDriverDispatchMinDryCompileManifestAppendU32(
            buf, discovererSourceIndex)
        BackendDriverDispatchMinDryCompileManifestAppendU32(
            buf, discovererEdgeIndex)
        let previousByteCountSum = byteCountSum
        let previousLineCountSum = lineCountSum
        byteCountSum = byteCountSum + byteCount
        lineCountSum = lineCountSum + lineCount
        edgeCountSum = edgeCountSum + int64(sourceEdgeCount)
        if byteCountSum < previousByteCountSum ||
           lineCountSum < previousLineCountSum:
            layout.ByteBufFree(buf)
            return false
        maxFileBytes =
            BackendDriverDispatchMinMaxI64(maxFileBytes, byteCount)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, importEdgeCount)
    for edgeIndex in 0..<stats.sourceImportEdges.len:
        BackendDriverDispatchMinDryCompileManifestAppendImportEdge(
            buf, stats.sourceImportEdges[edgeIndex])
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, stats.sourceBundleEntrySourceIndex)
    layout.ByteBufAppendFixed32(buf, stats.sourceBundleCid)
    layout.ByteBufAppendFixed32(buf, stats.entrySourceCid)
    layout.ByteBufAppendFixed32(buf, stats.importGraphCid)
    layout.ByteBufAppendFixed32(buf, stats.sourceBundleBindingSeal)
    BackendDriverDispatchMinDryCompileManifestAppendU32(
        buf, stats.unresolvedImportCount)
    if edgeCountSum != int64(importEdgeCount) ||
       stats.files != int64(sourceCount) ||
       stats.bytes != byteCountSum ||
       stats.lines != lineCountSum ||
       stats.maxFileBytes != maxFileBytes:
        layout.ByteBufFree(buf)
        return false
    stats.sourceManifestCid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn BackendDriverDispatchMinDryCompileSourceStatsMatchBoundPlan(
        stats: var BackendDriverDispatchMinDryCompileSourceStats,
        plan: var slplan.SystemLinkPlanStub,
        outErr: var str): bool =
    let sourceCount = stats.sourcePaths.len
    if sourceCount <= 0 ||
       plan.sourceClosurePaths.len != sourceCount ||
       plan.ownerModulePaths.len != sourceCount ||
       stats.sourceRawBytesCids.len != sourceCount ||
       stats.sourceByteCounts.len != sourceCount ||
       stats.sourceLineCounts.len != sourceCount ||
       stats.sourceImportEdgeCounts.len != sourceCount ||
       stats.sourceDiscoveryKinds.len != sourceCount ||
       stats.sourceDiscovererSourceIndices.len != sourceCount ||
       stats.sourceDiscovererEdgeIndices.len != sourceCount ||
       plan.importEdges.len != plan.importEdgeCount ||
       plan.sourceBundleEntrySourceIndex < 0 ||
       plan.sourceBundleEntrySourceIndex >= sourceCount:
        outErr = "source manifest/bound-plan count mismatch"
        return false
    stats.sourceImportEdges = []
    for edgeIndex in 0..<plan.importEdges.len:
        var edgeClone: parser.ImportEdge
        BackendDriverDispatchMinImportEdgeOwnedClone(
            plan.importEdges[edgeIndex], edgeClone)
        add(stats.sourceImportEdges, edgeClone)
    stats.sourceBundleEntrySourceIndex =
        plan.sourceBundleEntrySourceIndex
    stats.sourceBundleCid = plan.sourceBundleCidValue
    stats.entrySourceCid = plan.sourceBundleEntrySourceCid
    stats.importGraphCid = plan.sourceBundleImportGraphCid
    stats.sourceBundleBindingSeal = plan.sourceBundleBindingSeal
    stats.unresolvedImportCount = plan.unresolvedImportCount
    if stats.sourcePaths[stats.sourceBundleEntrySourceIndex] !=
       plan.entryPath:
        outErr = "source manifest/bound-plan entry mismatch"
        return false
    let packageRootForSystemPath =
        NewStringCopy(plan.packageRoot.data, plan.packageRoot.len)
    let expectedSystemPath = BackendDriverDispatchMinCleanDotPath(
        chengpath.PathAbsoluteBridgeSafe(
            packageRootForSystemPath, "src/std/system.cheng"))
    var totalEdgeCount: int64
    for sourceIndex in 0..<sourceCount:
        if stats.sourcePaths[sourceIndex] !=
           plan.sourceClosurePaths[sourceIndex]:
            outErr =
                Fmt"source manifest/bound-plan order mismatch index={sourceIndex}"
            return false
        let sourcePath = NewStringCopy(
            plan.sourceClosurePaths[sourceIndex].data,
            plan.sourceClosurePaths[sourceIndex].len)
        var sourceText = chengpath.ReadTextFile("", sourcePath)
        if sourceText.len <= 0 ||
           int64(sourceText.len) != stats.sourceByteCounts[sourceIndex]:
            outErr =
                Fmt"source manifest/bound-plan bytes mismatch index={sourceIndex}"
            return false
        let sourceCid =
            cworld.CompilerWorldSourceRawBytesCidBorrowed(sourceText)
        if !layout.FixedBytes32Equal(
                sourceCid, stats.sourceRawBytesCids[sourceIndex]):
            outErr =
                Fmt"source manifest/bound-plan cid mismatch index={sourceIndex}"
            return false
        var sourceLineCount: int64
        for byteIndex in 0..<sourceText.len:
            if sourceText[byteIndex] == '\n':
                sourceLineCount = sourceLineCount + int64(1)
        if sourceText[sourceText.len - 1] != '\n':
            sourceLineCount = sourceLineCount + int64(1)
        if sourceLineCount != stats.sourceLineCounts[sourceIndex]:
            outErr =
                Fmt"source manifest/bound-plan lines mismatch index={sourceIndex}"
            return false
        if stats.sourceDiscoveryKinds[sourceIndex] ==
               BackendDriverDispatchMinDryCompileDiscoveryValueIntrinsic &&
           stats.sourcePaths[sourceIndex] != expectedSystemPath:
            outErr =
                Fmt"source manifest/bound-plan Value dependency mismatch index={sourceIndex}"
            return false
        var sourceEdgeCount: int32
        for edgeIndex in 0..<plan.importEdges.len:
            if plan.importEdges[edgeIndex].ownerModulePath ==
               plan.ownerModulePaths[sourceIndex]:
                sourceEdgeCount = sourceEdgeCount + 1
        if sourceEdgeCount !=
           stats.sourceImportEdgeCounts[sourceIndex]:
            outErr =
                Fmt"source manifest/bound-plan edge mismatch index={sourceIndex}"
            return false
        totalEdgeCount = totalEdgeCount + int64(sourceEdgeCount)
        sourceText = ""
    if totalEdgeCount != int64(plan.importEdgeCount):
        outErr = "source manifest/bound-plan edge total mismatch"
        return false
    for edgeIndex in 0..<stats.sourceImportEdges.len:
        if !BackendDriverDispatchMinImportEdgeEqual(
                stats.sourceImportEdges[edgeIndex],
                plan.importEdges[edgeIndex]):
            outErr =
                Fmt"source manifest/bound-plan edge row mismatch index={edgeIndex}"
            return false
    if !BackendDriverDispatchMinDryCompileSourceStatsSealManifest(
            stats, plan.importEdgeCount):
        outErr = "source manifest/bound-plan final seal invalid"
        return false
    outErr = ""
    return true

fn BackendDriverDispatchMinDryCompileSourceStats(rootDir: str,
                                                  paths: str[],
                                                  outFiles: var int64,
                                                  outLines: var int64,
                                                  outBytes: var int64,
                                                  outMaxFileBytes: var int64,
                                                  outDeclCount: var int64,
                                                  outFunctionCount: var int64,
                                                  outExportCount: var int64,
                                                  outImportcCount: var int64,
                                                  outCallEdgeCount: var int64,
                                                  outTypeRefCount: var int64,
                                                  outErr: var str): bool =
    outFiles = int64(0)
    outLines = int64(0)
    outBytes = int64(0)
    outMaxFileBytes = int64(0)
    outDeclCount = int64(0)
    outFunctionCount = int64(0)
    outExportCount = int64(0)
    outImportcCount = int64(0)
    outCallEdgeCount = int64(0)
    outTypeRefCount = int64(0)
    outErr = ""
    for i in 0..<paths.len:
        let path = chengpath.PathAbsolute(rootDir, paths[i])
        var text = chengpath.ReadTextFile("", path)
        if len(text) <= 0:
            outErr = Fmt"dry-compile: failed to read source path: {path}"
            return false
        var stats: BackendDriverDispatchMinDryCompileSourceStats
        BackendDriverDispatchMinDryCompileSourceStatsReset(stats)
        BackendDriverDispatchMinDryCompileSourceStatsAddText(stats, text)
        outFiles = outFiles + stats.files
        outBytes = outBytes + stats.bytes
        outMaxFileBytes = BackendDriverDispatchMinMaxI64(outMaxFileBytes, stats.maxFileBytes)
        outLines = outLines + stats.lines
        outDeclCount = outDeclCount + stats.declCount
        outFunctionCount = outFunctionCount + stats.functionCount
        outExportCount = outExportCount + stats.exportCount
        outImportcCount = outImportcCount + stats.importcCount
        outCallEdgeCount = outCallEdgeCount + stats.callEdgeCount
        outTypeRefCount = outTypeRefCount + stats.typeRefCount
        text = ""
    return true

@borrows
fn BackendDriverDispatchMinDefaultExternalPackageRoots(driverRootRaw: str,
                                                       consumerPackageRootRaw: str): parser.ParserExternalPackageRoot[] =
    var roots: parser.ParserExternalPackageRoot[]
    let driverRoot = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe("", driverRootRaw))
    # 消费方 cheng-package.toml 的 [dependencies.X] channel pin: 供缺锁自举 miss-hook 按 modulePath
    # 取 channelId (== sha256(signerPubKey), 信任决定处)。未配 channel 的依赖 chan="" → 行为同旧
    # (无 P5 路径, 零回归)。canonical id 各查一次, bare alias 复用同 chan 保证两种 import 形态一致。
    let manifestText = parser.ParserPackageManifestText(consumerPackageRootRaw)
    # codex/rust-csg-core 是编译器源码树里的自带包: 仅当 driverRoot 下确实存在
    # 该目录时才补为 external root — minimal package (无 [dependencies]) 的
    # packageRoot 通常不含它们, 无条件补会造出虚构 root (/tmp/i14ok/codex 等
    # 不存在), 把 source identity roots 撑到 3 导致相对源路径误拒 ambiguous。
    let codexRoot = chengpath.PathJoin(driverRoot, "codex")
    if fs.Exists(codexRoot):
        let codexChannel = parser.ParserManifestDependencyChannel(manifestText, "cheng/codex")
        add(roots, parser.ParserExternalPackageRootCertifiedNewWithChannel("cheng/codex", "cheng/codex", codexRoot, codexChannel))
        add(roots, parser.ParserExternalPackageRootCertifiedNewWithChannel("codex", "cheng/codex", codexRoot, codexChannel))
    let rustCsgCoreRoot = chengpath.PathJoin(driverRoot, "rust-csg-core")
    if fs.Exists(rustCsgCoreRoot):
        let rustCsgCoreChannel = parser.ParserManifestDependencyChannel(manifestText, "cheng/rust-csg-core")
        add(roots, parser.ParserExternalPackageRootCertifiedNewWithChannel("cheng/rust-csg-core", "cheng/rust-csg-core", rustCsgCoreRoot, rustCsgCoreChannel))
        add(roots, parser.ParserExternalPackageRootCertifiedNewWithChannel("rust-csg-core", "cheng/rust-csg-core", rustCsgCoreRoot, rustCsgCoreChannel))
    return roots

@borrows
fn BackendDriverDispatchMinDryCompileCollectSourceClosure(driverRoot: str,
                                                           packageRootRaw: str,
                                                           entryPathRaw: str,
                                                           externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                           sourcePaths: var str[],
                                                           importEdges: var parser.ImportEdge[],
                                                           importEdgeCount: var int32,
                                                           unresolvedImportCount: var int32,
                                                           outErr: var str): bool =
    var stats: BackendDriverDispatchMinDryCompileSourceStats
    return BackendDriverDispatchMinDryCompileCollectSourceClosureWithStats(driverRoot,
                                                                          packageRootRaw,
                                                                          entryPathRaw,
                                                                          externalPackageRoots,
                                                                          false,
                                                                          stats,
                                                                          sourcePaths,
                                                                          importEdges,
                                                                          importEdgeCount,
                                                                          unresolvedImportCount,
                                                                          outErr)

# F14b auto-seed: Value()/result.Value() synthesize a Panic CallOp in body IR
# (PrimaryBodyIrAppendResultValuePanicGuard). The sixth-wall retain
# (CompilerCsgIsAlwaysRetainedBackendSyntheticRoot /
# LoweringFunctionIsBackendSyntheticRoot) only keeps an existing Panic typed
# row; it cannot invent one. Source closure therefore consumes the parser-owned
# Call/SpaceCall event and the canonical Result intrinsic detail identity.
# Comments, strings, similarly named identifiers and bare `Value` tokens never
# produce a call-event node and cannot inject src/std/system.cheng.
@borrows
fn BackendDriverDispatchMinSourceUsesExactValueIntrinsic(
        sourceText: str,
        usesValueIntrinsic: var bool,
        outErr: var str): bool =
    usesValueIntrinsic = false
    outErr = ""
    var valueTree: parser.ParserValueExprTree
    let parseSourceText = NewStringCopy(sourceText.data, len(sourceText))
    if !parser.ParserValueExprReadTreeFromText(
           parseSourceText, valueTree, outErr):
        parser.ParserValueExprTreeRelease(valueTree)
        return false
    let callEventCount =
        parser.ParserValueExprTreeCallEventCount(valueTree)
    for eventIndex in 0..<callEventCount:
        let nodeIndex =
            parser.ParserValueExprCallEventNodeAt(valueTree, eventIndex)
        let detailKind = parser.ParserResultIntrinsicDetailKind(
            parser.ParserValueExprNodeNameText(valueTree, nodeIndex))
        if detailKind != parser.NormalizedExprDetailResultValue:
            continue
        if parser.ParserValueExprNodeArgumentRootCount(
               valueTree, nodeIndex) != 1:
            continue
        usesValueIntrinsic = true
        break
    parser.ParserValueExprTreeRelease(valueTree)
    return true

@borrows
fn BackendDriverDispatchMinDryCompileCollectSourceClosureWithStats(driverRoot: str,
                                                                    packageRootRaw: str,
                                                                    entryPathRaw: str,
                                                                    externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                                    collectStats: bool,
                                                                    sourceStats: var BackendDriverDispatchMinDryCompileSourceStats,
                                                                    sourcePaths: var str[],
                                                                    importEdges: var parser.ImportEdge[],
                                                                    importEdgeCount: var int32,
                                                                    unresolvedImportCount: var int32,
                                                                    outErr: var str): bool =
    sourcePaths = []
    importEdges = []
    importEdgeCount = 0
    unresolvedImportCount = 0
    outErr = ""
    BackendDriverDispatchMinDryCompileSourceStatsReset(sourceStats)
    let driverRootAbs = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe("", driverRoot))
    let packageRoot = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe(driverRootAbs, packageRootRaw))
    let entryPath = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe(driverRootAbs, entryPathRaw))
    add(sourcePaths, entryPath)
    if collectStats:
        add(sourceStats.sourceDiscoveryKinds,
            BackendDriverDispatchMinDryCompileDiscoveryEntry)
        add(sourceStats.sourceDiscovererSourceIndices, -1)
        add(sourceStats.sourceDiscovererEdgeIndices, -1)
    var scanIndex: int32
    while scanIndex < sourcePaths.len:
        let currentSourceIndex = scanIndex
        let currentPath = sourcePaths[scanIndex]
        scanIndex = scanIndex + 1
        let currentReadPath =
            NewStringCopy(currentPath.data, currentPath.len)
        var currentText = chengpath.ReadTextFile("", currentReadPath)
        if currentText.len <= 0:
            outErr = strutil.Join(["dry-compile: failed to read source path: ", strings.CloneStr(currentPath)], "")
            return false
        var currentSourceLineCount: int64
        if collectStats:
            let previousLineCount = sourceStats.lines
            BackendDriverDispatchMinDryCompileSourceStatsAddText(sourceStats, currentText)
            currentSourceLineCount = sourceStats.lines - previousLineCount
        # F14b: the parser-owned Value intrinsic identity proves the synthetic
        # Panic dependency; no source-text scan participates in closure identity.
        var usesValueIntrinsic: bool
        var valueIntrinsicErr: str
        if !BackendDriverDispatchMinSourceUsesExactValueIntrinsic(
               currentText, usesValueIntrinsic, valueIntrinsicErr):
            outErr = Fmt"dry-compile: canonical Value intrinsic parse failed source={currentPath}: {valueIntrinsicErr}"
            return false
        if usesValueIntrinsic:
            let systemPath = BackendDriverDispatchMinCleanDotPath(chengpath.PathAbsoluteBridgeSafe(packageRoot,
                                                                                                    "src/std/system.cheng"))
            if systemPath.len > 0 &&
               !BackendDriverDispatchMinPathSeen(sourcePaths, systemPath):
                add(sourcePaths, systemPath)
                if collectStats:
                    add(sourceStats.sourceDiscoveryKinds,
                        BackendDriverDispatchMinDryCompileDiscoveryValueIntrinsic)
                    add(sourceStats.sourceDiscovererSourceIndices,
                        currentSourceIndex)
                    add(sourceStats.sourceDiscovererEdgeIndices, -1)
        let ownerModulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(packageRoot,
                                                                                          packageRoot,
                                                                                          externalPackageRoots,
                                                                                          currentPath)
        var edges: parser.ImportEdge[]
        var edgeErr: str
        if !parser.ParserReadImportEdgesWithExternalPackageRoots(packageRoot,
                                                                 packageRoot,
                                                                 externalPackageRoots,
                                                                 ownerModulePath,
                                                                 currentText,
                                                                 edges,
                                                                 edgeErr):
            outErr = edgeErr
            return false
        if collectStats &&
           !BackendDriverDispatchMinDryCompileSourceStatsAppendManifestRow(
               sourceStats,
               currentPath,
               currentText,
               currentSourceLineCount,
               edges.len):
            outErr = Fmt"dry-compile: source manifest row invalid: {currentPath}"
            return false
        for i in 0..<edges.len:
            var edgeClone: parser.ImportEdge
            BackendDriverDispatchMinImportEdgeOwnedClone(
                edges[i], edgeClone)
            add(importEdges, edgeClone)
            let targetPath = BackendDriverDispatchMinCleanDotPath(edges[i].targetSourcePath)
            if targetPath.len <= 0:
                unresolvedImportCount = unresolvedImportCount + 1
                continue
            if !BackendDriverDispatchMinPathSeen(sourcePaths, targetPath):
                add(sourcePaths, targetPath)
                if collectStats:
                    add(sourceStats.sourceDiscoveryKinds,
                        BackendDriverDispatchMinDryCompileDiscoveryImportEdge)
                    add(sourceStats.sourceDiscovererSourceIndices,
                        currentSourceIndex)
                    add(sourceStats.sourceDiscovererEdgeIndices, i)
        currentText = ""
        edges = []
    importEdgeCount = importEdges.len
    if unresolvedImportCount > 0:
        outErr = strutil.Join(["dry-compile: unresolved imports: ", strings.IntToStr(unresolvedImportCount)], "")
        return false
    return true

@borrows
fn BackendDriverDispatchMinDryCompileFormatFloorBytes(targetTriple: str,
                                                       emitText: str): int64 =
    if emitText == "exe":
        if chengpath.TextContains(targetTriple, "apple-darwin"):
            return int64(4096)
        if chengpath.TextContains(targetTriple, "linux") ||
           chengpath.TextContains(targetTriple, "elf"):
            return int64(64)
        if chengpath.TextContains(targetTriple, "wasm32"):
            return int64(8)
        return int64(64)
    if emitText == "obj" || emitText == "shared":
        return int64(64)
    return int64(0)

type
    BackendDriverDispatchMinTypedFactMemoryModel =
        factCount: int64
        physicalColumnCount: int64
        physicalInt32ColumnCount: int64
        physicalU8ColumnCount: int64
        int32ScalarBytes: int64
        u8ScalarBytes: int64
        physicalRowBytes: int64
        physicalStorageBytes: int64
        storageModel: str
        internPayloadModel: str
        allocatorOverheadModel: str

    BackendDriverDispatchMinCheckedMath =
        ok: bool
        reason: str

fn BackendDriverDispatchMinTryCheckedMulI64(left: int64,
                                            right: int64,
                                            outValue: var int64): bool =
    outValue = int64(0)
    if left < int64(0) || right < int64(0):
        return false
    if left == int64(0) || right == int64(0):
        return true
    let maxInt64: int64 = 9223372036854775807
    if left > maxInt64 / right:
        return false
    outValue = left * right
    return true

fn BackendDriverDispatchMinCheckedMathStart(): BackendDriverDispatchMinCheckedMath =
    var state: BackendDriverDispatchMinCheckedMath
    state.ok = true
    return state

fn BackendDriverDispatchMinCheckedMathFail(
    state: var BackendDriverDispatchMinCheckedMath,
    reason: str) =
    if state.ok:
        state.ok = false
        state.reason = reason

fn BackendDriverDispatchMinCheckedMathInput(
    state: var BackendDriverDispatchMinCheckedMath,
    value: int64,
    label: str): int64 =
    if !state.ok:
        return int64(0)
    if value < int64(0):
        BackendDriverDispatchMinCheckedMathFail(state, Fmt"{label}_negative")
        return int64(0)
    return value

fn BackendDriverDispatchMinCheckedMathAdd(
    state: var BackendDriverDispatchMinCheckedMath,
    left: int64,
    right: int64,
    label: str): int64 =
    if !state.ok:
        return int64(0)
    if left < int64(0) || right < int64(0):
        BackendDriverDispatchMinCheckedMathFail(state,
                                                 Fmt"{label}_negative_operand")
        return int64(0)
    let maxInt64: int64 = 9223372036854775807
    if left > maxInt64 - right:
        BackendDriverDispatchMinCheckedMathFail(state, Fmt"{label}_overflow")
        return int64(0)
    return left + right

fn BackendDriverDispatchMinCheckedMathSub(
    state: var BackendDriverDispatchMinCheckedMath,
    left: int64,
    right: int64,
    label: str): int64 =
    if !state.ok:
        return int64(0)
    if left < int64(0) || right < int64(0) || right > left:
        BackendDriverDispatchMinCheckedMathFail(state, Fmt"{label}_underflow")
        return int64(0)
    return left - right

fn BackendDriverDispatchMinCheckedMathMul(
    state: var BackendDriverDispatchMinCheckedMath,
    left: int64,
    right: int64,
    label: str): int64 =
    if !state.ok:
        return int64(0)
    var outValue: int64
    if !BackendDriverDispatchMinTryCheckedMulI64(left, right, outValue):
        BackendDriverDispatchMinCheckedMathFail(state, Fmt"{label}_overflow")
        return int64(0)
    return outValue

fn BackendDriverDispatchMinCheckedMathDivCeil(
    state: var BackendDriverDispatchMinCheckedMath,
    value: int64,
    denominator: int64,
    label: str): int64 =
    if !state.ok:
        return int64(0)
    if value < int64(0) || denominator <= int64(0):
        BackendDriverDispatchMinCheckedMathFail(state,
                                                 Fmt"{label}_invalid_operand")
        return int64(0)
    let quotient = value / denominator
    if value % denominator == int64(0):
        return quotient
    return BackendDriverDispatchMinCheckedMathAdd(state,
                                                   quotient,
                                                   int64(1),
                                                   Fmt"{label}_round")

fn BackendDriverDispatchMinCheckedMathScale(
    state: var BackendDriverDispatchMinCheckedMath,
    value: int64,
    numerator: int64,
    denominator: int64,
    label: str): int64 =
    let product = BackendDriverDispatchMinCheckedMathMul(state,
                                                          value,
                                                          numerator,
                                                          Fmt"{label}_product")
    return BackendDriverDispatchMinCheckedMathDivCeil(state,
                                                       product,
                                                       denominator,
                                                       Fmt"{label}_divide")

fn BackendDriverDispatchMinCheckedMathMax(
    state: var BackendDriverDispatchMinCheckedMath,
    left: int64,
    right: int64,
    label: str): int64 =
    if !state.ok:
        return int64(0)
    if left < int64(0) || right < int64(0):
        BackendDriverDispatchMinCheckedMathFail(state,
                                                 Fmt"{label}_negative_operand")
        return int64(0)
    if left > right:
        return left
    return right

fn BackendDriverDispatchMinCheckedAddI64(left: int64,
                                         right: int64): int64 =
    if left < int64(0) || right < int64(0):
        panic("backend_driver_dispatch_min_memory_model_negative_add_operand")
    let maxInt64: int64 = 9223372036854775807
    if left > maxInt64 - right:
        panic("backend_driver_dispatch_min_memory_model_add_overflow")
    return left + right

fn BackendDriverDispatchMinCheckedMulI64(left: int64,
                                         right: int64): int64 =
    var outValue: int64
    if !BackendDriverDispatchMinTryCheckedMulI64(left, right, outValue):
        panic("backend_driver_dispatch_min_memory_model_mul_overflow")
    return outValue

fn BackendDriverDispatchMinCheckedScaleI64(value: int64,
                                           numerator: int64,
                                           denominator: int64): int64 =
    if denominator <= int64(0):
        panic("backend_driver_dispatch_min_memory_model_scale_denominator")
    let product = BackendDriverDispatchMinCheckedMulI64(value, numerator)
    return BackendDriverDispatchMinCheckedAddI64(product,
                                                  denominator - int64(1)) / denominator

fn BackendDriverDispatchMinTypedFactMemoryModelTryBuild(
    factCount: int64,
    model: var BackendDriverDispatchMinTypedFactMemoryModel,
    reason: var str): bool =
    model.factCount = int64(0)
    model.physicalColumnCount = int64(0)
    model.physicalInt32ColumnCount = int64(0)
    model.physicalU8ColumnCount = int64(0)
    model.int32ScalarBytes = int64(0)
    model.u8ScalarBytes = int64(0)
    model.physicalRowBytes = int64(0)
    model.physicalStorageBytes = int64(0)
    model.storageModel = ""
    model.internPayloadModel = ""
    model.allocatorOverheadModel = ""
    reason = ""
    if factCount < int64(0):
        reason = "negative_fact_count"
        return false
    let physicalColumnCount = int64(texpr.TypedExprFactTablePhysicalColumnCount())
    let physicalInt32ColumnCount =
        int64(texpr.TypedExprFactTablePhysicalInt32ColumnCount())
    let physicalU8ColumnCount =
        int64(texpr.TypedExprFactTablePhysicalU8ColumnCount())
    let int32ScalarBytes = int64(sizeof(int32))
    let u8ScalarBytes = int64(1)
    let physicalRowBytes = int64(texpr.TypedExprFactTablePhysicalRowBytes())
    if physicalInt32ColumnCount < int64(0) ||
       physicalU8ColumnCount < int64(0) ||
       physicalColumnCount !=
           physicalInt32ColumnCount + physicalU8ColumnCount:
        reason = "physical_column_shape_mismatch"
        return false
    if physicalRowBytes !=
       physicalInt32ColumnCount * int32ScalarBytes +
       physicalU8ColumnCount * u8ScalarBytes:
        reason = "physical_row_shape_mismatch"
        return false
    var physicalStorageBytes: int64
    if !BackendDriverDispatchMinTryCheckedMulI64(factCount,
                                                 physicalRowBytes,
                                                 physicalStorageBytes):
        reason = "physical_storage_overflow"
        return false
    model.factCount = factCount
    model.physicalColumnCount = physicalColumnCount
    model.physicalInt32ColumnCount = physicalInt32ColumnCount
    model.physicalU8ColumnCount = physicalU8ColumnCount
    model.int32ScalarBytes = int32ScalarBytes
    model.u8ScalarBytes = u8ScalarBytes
    model.physicalRowBytes = physicalRowBytes
    model.physicalStorageBytes = physicalStorageBytes
    model.storageModel = "mixed_width_presized_soa"
    model.internPayloadModel = "excluded_unmodeled_separate_owner"
    model.allocatorOverheadModel = "excluded_global_allocator_gap"
    return true

fn BackendDriverDispatchMinTypedFactMemoryModelBuild(factCount: int64): BackendDriverDispatchMinTypedFactMemoryModel =
    var model: BackendDriverDispatchMinTypedFactMemoryModel
    var reason: str
    if !BackendDriverDispatchMinTypedFactMemoryModelTryBuild(factCount,
                                                             model,
                                                             reason):
        panic(Fmt"backend_driver_dispatch_min_typed_fact_memory_model_invalid reason={reason}")
    return model

@borrows
fn BackendDriverDispatchMinTypedFactMemoryModelReportJoin(physicalColumnCount: int64,
                                                          physicalInt32ColumnCount: int64,
                                                          physicalU8ColumnCount: int64,
                                                          int32ScalarBytes: int64,
                                                          u8ScalarBytes: int64,
                                                          physicalRowBytes: int64,
                                                          factCount: int64,
                                                          physicalStorageBytes: int64,
                                                          storageModel: str,
                                                          internPayloadModel: str,
                                                          allocatorOverheadModel: str): str =
    return strutil.Join([
        "full_compile_theory_rss_typed_fact_physical_column_count=", strings.Int64ToStr(physicalColumnCount), "\n",
        "full_compile_theory_rss_typed_fact_physical_int32_column_count=", strings.Int64ToStr(physicalInt32ColumnCount), "\n",
        "full_compile_theory_rss_typed_fact_physical_u8_column_count=", strings.Int64ToStr(physicalU8ColumnCount), "\n",
        "full_compile_theory_rss_typed_fact_int32_scalar_bytes=", strings.Int64ToStr(int32ScalarBytes), "\n",
        "full_compile_theory_rss_typed_fact_u8_scalar_bytes=", strings.Int64ToStr(u8ScalarBytes), "\n",
        "full_compile_theory_rss_typed_fact_physical_row_bytes=", strings.Int64ToStr(physicalRowBytes), "\n",
        "full_compile_theory_rss_typed_fact_storage_model=", strings.CloneStr(storageModel), "\n",
        "full_compile_theory_rss_typed_fact_row_count=", strings.Int64ToStr(factCount), "\n",
        "full_compile_theory_rss_typed_fact_intern_payload_model=", strings.CloneStr(internPayloadModel), "\n",
        "full_compile_theory_rss_typed_fact_allocator_overhead_model=", strings.CloneStr(allocatorOverheadModel), "\n",
        "full_compile_theory_rss_typed_facts_bytes=", strings.Int64ToStr(physicalStorageBytes)
    ], "")

@borrows
fn BackendDriverDispatchMinTypedFactMemoryModelReport(model: BackendDriverDispatchMinTypedFactMemoryModel): str =
    return BackendDriverDispatchMinTypedFactMemoryModelReportJoin(model.physicalColumnCount,
                                                                  model.physicalInt32ColumnCount,
                                                                  model.physicalU8ColumnCount,
                                                                  model.int32ScalarBytes,
                                                                  model.u8ScalarBytes,
                                                                  model.physicalRowBytes,
                                                                  model.factCount,
                                                                  model.physicalStorageBytes,
                                                                  model.storageModel,
                                                                  model.internPayloadModel,
                                                                  model.allocatorOverheadModel)

type
    BackendDriverDispatchMinFullRssMemoryModel =
        sourceTextBytes: int64
        csgGraphBytes: int64
        exprLayerBytes: int64
        typedFactsBytes: int64
        typedIrBytes: int64
        loweringBytes: int64
        primaryBytes: int64
        providerBytes: int64
        linkBytes: int64
        reportBytes: int64
        csgIncrementalBytes: int64
        loweringIncrementalBytes: int64
        primaryIncrementalBytes: int64
        reportIncrementalBytes: int64
        csgPhaseBytes: int64
        loweringPhaseBytes: int64
        primaryPhaseBytes: int64
        providerPhaseBytes: int64
        linkPhaseBytes: int64
        reportPhaseBytes: int64
        modeledStructuredPeakBytes: int64
        exclusivePhaseLowerBoundBytes: int64
        consumeWindowLowerBoundBytes: int64
        modeledLowerBoundBytes: int64
        peakPhaseName: str
        legacyRetainedCumulativeEstimateBytes: int64
        capacityBytes: int64
        orcBytes: int64
        arenaBytes: int64
        allocatorHeuristicBytes: int64
        allocatorClassifiedBytes: int64
        allocatorModeledBytes: int64
        allocatorGapBytes: int64
        modeledPeakEstimateBytes: int64
        modeledBudgetEstimateBytes: int64
        modeledGuardEstimateBytes: int64
        hardwareStatus: str

    BackendDriverDispatchMinFullRssParallelMemoryModel =
        memoryLimitBytes: int64
        guardScaleNumerator: int64
        guardScaleDenominator: int64
        guardReserveBytes: int64
        sourceFixedBytes: int64
        sourcePerWorkerBytes: int64
        csgFixedBytes: int64
        csgPerWorkerBytes: int64
        typedIrFixedBytes: int64
        typedIrPerWorkerBytes: int64
        loweringFixedBytes: int64
        loweringPerWorkerBytes: int64
        primaryFixedBytes: int64
        primaryPerWorkerBytes: int64
        providerFixedBytes: int64
        providerPerWorkerBytes: int64
        linkFixedBytes: int64
        linkPerWorkerBytes: int64
        reportFixedBytes: int64
        reportPerWorkerBytes: int64
        serialFloorBytes: int64
        loweringLimitedJobs: int64
        primaryLimitedJobs: int64
        memoryLimitedMaxJobs: int64
        effectiveJobs: int64
        status: str

fn BackendDriverDispatchMinFullRssMemoryModelTryBuild(
    sourceTextBytesRaw: int64,
    csgGraphBytesRaw: int64,
    exprLayerBytesRaw: int64,
    typedFactsBytesRaw: int64,
    typedIrBytesRaw: int64,
    loweringBytesRaw: int64,
    primaryBytesRaw: int64,
    providerBytesRaw: int64,
    linkBytesRaw: int64,
    reportBytesRaw: int64,
    typedIrFunctionsRaw: int64,
    sourceFilesRaw: int64,
    hardwareMemoryBytesRaw: int64,
    model: var BackendDriverDispatchMinFullRssMemoryModel,
    reason: var str): bool =
    model = BackendDriverDispatchMinFullRssMemoryModel()
    reason = ""
    var math = BackendDriverDispatchMinCheckedMathStart()
    let sourceTextBytes = BackendDriverDispatchMinCheckedMathInput(math, sourceTextBytesRaw, "rss_source_text")
    let csgGraphBytes = BackendDriverDispatchMinCheckedMathInput(math, csgGraphBytesRaw, "rss_csg_graph")
    let exprLayerBytes = BackendDriverDispatchMinCheckedMathInput(math, exprLayerBytesRaw, "rss_expr_layer")
    let typedFactsBytes = BackendDriverDispatchMinCheckedMathInput(math, typedFactsBytesRaw, "rss_typed_facts")
    let typedIrBytes = BackendDriverDispatchMinCheckedMathInput(math, typedIrBytesRaw, "rss_typed_ir")
    let loweringBytes = BackendDriverDispatchMinCheckedMathInput(math, loweringBytesRaw, "rss_lowering")
    let primaryBytes = BackendDriverDispatchMinCheckedMathInput(math, primaryBytesRaw, "rss_primary")
    let providerBytes = BackendDriverDispatchMinCheckedMathInput(math, providerBytesRaw, "rss_provider")
    let linkBytes = BackendDriverDispatchMinCheckedMathInput(math, linkBytesRaw, "rss_link")
    let reportBytes = BackendDriverDispatchMinCheckedMathInput(math, reportBytesRaw, "rss_report")
    let typedIrFunctions = BackendDriverDispatchMinCheckedMathInput(math, typedIrFunctionsRaw, "rss_typed_ir_functions")
    let sourceFiles = BackendDriverDispatchMinCheckedMathInput(math, sourceFilesRaw, "rss_source_files")
    let hardwareMemoryBytes = BackendDriverDispatchMinCheckedMathInput(math, hardwareMemoryBytesRaw, "rss_hardware_memory")
    let graphAndExpr = BackendDriverDispatchMinCheckedMathAdd(math, csgGraphBytes, exprLayerBytes, "rss_csg_graph_expr")
    let factsAndIr = BackendDriverDispatchMinCheckedMathAdd(math, typedFactsBytes, typedIrBytes, "rss_csg_facts_ir")
    let csgIncremental = BackendDriverDispatchMinCheckedMathAdd(math, graphAndExpr, factsAndIr, "rss_csg_incremental")
    let loweringHalf = BackendDriverDispatchMinCheckedMathScale(math, loweringBytes, int64(1), int64(2), "rss_lowering_half")
    let primaryIncremental = BackendDriverDispatchMinCheckedMathAdd(math, primaryBytes, loweringHalf, "rss_primary_incremental")
    let sourceAndTypedIr = BackendDriverDispatchMinCheckedMathAdd(math, sourceTextBytes, typedIrBytes, "rss_source_typed_ir")
    let sourceAndPrimary = BackendDriverDispatchMinCheckedMathAdd(math, sourceTextBytes, primaryBytes, "rss_source_primary")
    let csgPhase = BackendDriverDispatchMinCheckedMathAdd(math, sourceTextBytes, csgIncremental, "rss_csg_phase")
    let loweringPhase = BackendDriverDispatchMinCheckedMathAdd(math, sourceAndTypedIr, loweringBytes, "rss_lowering_phase")
    let primaryPhase = BackendDriverDispatchMinCheckedMathAdd(math, sourceAndTypedIr, primaryIncremental, "rss_primary_phase")
    let providerPhase = BackendDriverDispatchMinCheckedMathAdd(math, sourceAndPrimary, providerBytes, "rss_provider_phase")
    let linkPhase = BackendDriverDispatchMinCheckedMathAdd(math, providerPhase, linkBytes, "rss_link_phase")
    let reportPhase = BackendDriverDispatchMinCheckedMathAdd(math, sourceAndPrimary, reportBytes, "rss_report_phase")
    var structuredPeak = csgPhase
    var peakPhaseName = "compiler_csg"
    let csgLoweringMax = BackendDriverDispatchMinCheckedMathMax(math, structuredPeak, loweringPhase, "rss_csg_lowering_max")
    if loweringPhase > structuredPeak:
        peakPhaseName = "lowering_plan"
    structuredPeak = csgLoweringMax
    let primaryMax = BackendDriverDispatchMinCheckedMathMax(math, structuredPeak, primaryPhase, "rss_primary_max")
    if primaryPhase > structuredPeak:
        peakPhaseName = "primary_object_plan"
    structuredPeak = primaryMax
    let providerMax = BackendDriverDispatchMinCheckedMathMax(math, structuredPeak, providerPhase, "rss_provider_max")
    if providerPhase > structuredPeak:
        peakPhaseName = "provider_object"
    structuredPeak = providerMax
    let linkMax = BackendDriverDispatchMinCheckedMathMax(math, structuredPeak, linkPhase, "rss_link_max")
    if linkPhase > structuredPeak:
        peakPhaseName = "native_link"
    structuredPeak = linkMax
    let reportMax = BackendDriverDispatchMinCheckedMathMax(math, structuredPeak, reportPhase, "rss_report_max")
    if reportPhase > structuredPeak:
        peakPhaseName = "report_payload_assembly"
    structuredPeak = reportMax
    let legacySourceCsg = BackendDriverDispatchMinCheckedMathAdd(math, sourceTextBytes, csgIncremental, "rss_legacy_source_csg")
    let legacyLoweringPrimary = BackendDriverDispatchMinCheckedMathAdd(math, loweringBytes, primaryIncremental, "rss_legacy_lowering_primary")
    let legacyBeforeReport = BackendDriverDispatchMinCheckedMathAdd(math, legacySourceCsg, legacyLoweringPrimary, "rss_legacy_before_report")
    let legacyRetained = BackendDriverDispatchMinCheckedMathAdd(math, legacyBeforeReport, reportBytes, "rss_legacy_retained")
    let capacityBytes = BackendDriverDispatchMinCheckedMathScale(math, structuredPeak, int64(1), int64(4), "rss_capacity")
    let orcFunctionBytes = BackendDriverDispatchMinCheckedMathMul(math, typedIrFunctions, int64(48), "rss_orc_functions")
    let orcSourceBytes = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(64), "rss_orc_sources")
    let orcBytes = BackendDriverDispatchMinCheckedMathAdd(math, orcFunctionBytes, orcSourceBytes, "rss_orc")
    let arenaGraphIr = BackendDriverDispatchMinCheckedMathAdd(math, csgGraphBytes, typedIrBytes, "rss_arena_graph_ir")
    let arenaLoweringPrimary = BackendDriverDispatchMinCheckedMathAdd(math, loweringBytes, primaryBytes, "rss_arena_lowering_primary")
    let arenaInputs = BackendDriverDispatchMinCheckedMathAdd(math, arenaGraphIr, arenaLoweringPrimary, "rss_arena_inputs")
    let arenaBytes = BackendDriverDispatchMinCheckedMathScale(math, arenaInputs, int64(1), int64(5), "rss_arena")
    let allocatorHalf = BackendDriverDispatchMinCheckedMathScale(math, structuredPeak, int64(1), int64(2), "rss_allocator_half")
    let allocatorHeuristic = BackendDriverDispatchMinCheckedMathAdd(math, allocatorHalf, int64(4194304), "rss_allocator_heuristic")
    let capacityAndOrc = BackendDriverDispatchMinCheckedMathAdd(math, capacityBytes, orcBytes, "rss_allocator_capacity_orc")
    let allocatorClassified = BackendDriverDispatchMinCheckedMathAdd(math, capacityAndOrc, arenaBytes, "rss_allocator_classified")
    let allocatorModeled = BackendDriverDispatchMinCheckedMathMax(math, allocatorHeuristic, allocatorClassified, "rss_allocator_modeled")
    let allocatorGap = BackendDriverDispatchMinCheckedMathSub(math, allocatorModeled, allocatorClassified, "rss_allocator_gap")
    let modeledPeak = BackendDriverDispatchMinCheckedMathAdd(math, structuredPeak, allocatorModeled, "rss_modeled_peak")
    let doubledPeak = BackendDriverDispatchMinCheckedMathMul(math, modeledPeak, int64(2), "rss_modeled_budget_double")
    let modeledBudget = BackendDriverDispatchMinCheckedMathAdd(math, doubledPeak, int64(16777216), "rss_modeled_budget")
    let modeledGuard = BackendDriverDispatchMinCheckedMathAdd(math, modeledBudget, int64(67108864), "rss_modeled_guard")
    var exclusivePeak = sourceTextBytes
    exclusivePeak = BackendDriverDispatchMinCheckedMathMax(math, exclusivePeak, csgIncremental, "rss_exclusive_csg")
    exclusivePeak = BackendDriverDispatchMinCheckedMathMax(math, exclusivePeak, loweringBytes, "rss_exclusive_lowering")
    exclusivePeak = BackendDriverDispatchMinCheckedMathMax(math, exclusivePeak, primaryBytes, "rss_exclusive_primary")
    exclusivePeak = BackendDriverDispatchMinCheckedMathMax(math, exclusivePeak, providerBytes, "rss_exclusive_provider")
    exclusivePeak = BackendDriverDispatchMinCheckedMathMax(math, exclusivePeak, linkBytes, "rss_exclusive_link")
    exclusivePeak = BackendDriverDispatchMinCheckedMathMax(math, exclusivePeak, reportBytes, "rss_exclusive_report")
    let consumeWindowLowerBound = structuredPeak
    let modeledLowerBound = BackendDriverDispatchMinCheckedMathAdd(math, consumeWindowLowerBound, orcBytes, "rss_theory_lower_bound")
    if !math.ok:
        reason = math.reason
        return false
    model.sourceTextBytes = sourceTextBytes
    model.csgGraphBytes = csgGraphBytes
    model.exprLayerBytes = exprLayerBytes
    model.typedFactsBytes = typedFactsBytes
    model.typedIrBytes = typedIrBytes
    model.loweringBytes = loweringBytes
    model.primaryBytes = primaryBytes
    model.providerBytes = providerBytes
    model.linkBytes = linkBytes
    model.reportBytes = reportBytes
    model.csgIncrementalBytes = csgIncremental
    model.loweringIncrementalBytes = loweringBytes
    model.primaryIncrementalBytes = primaryIncremental
    model.reportIncrementalBytes = reportBytes
    model.csgPhaseBytes = csgPhase
    model.loweringPhaseBytes = loweringPhase
    model.primaryPhaseBytes = primaryPhase
    model.providerPhaseBytes = providerPhase
    model.linkPhaseBytes = linkPhase
    model.reportPhaseBytes = reportPhase
    model.modeledStructuredPeakBytes = structuredPeak
    model.exclusivePhaseLowerBoundBytes = exclusivePeak
    model.consumeWindowLowerBoundBytes = consumeWindowLowerBound
    model.modeledLowerBoundBytes = modeledLowerBound
    model.peakPhaseName = peakPhaseName
    model.legacyRetainedCumulativeEstimateBytes = legacyRetained
    model.capacityBytes = capacityBytes
    model.orcBytes = orcBytes
    model.arenaBytes = arenaBytes
    model.allocatorHeuristicBytes = allocatorHeuristic
    model.allocatorClassifiedBytes = allocatorClassified
    model.allocatorModeledBytes = allocatorModeled
    model.allocatorGapBytes = allocatorGap
    model.modeledPeakEstimateBytes = modeledPeak
    model.modeledBudgetEstimateBytes = modeledBudget
    model.modeledGuardEstimateBytes = modeledGuard
    model.hardwareStatus = "unknown"
    if hardwareMemoryBytes > int64(0):
        model.hardwareStatus = "modeled_estimate_within_hardware"
        if modeledGuard > hardwareMemoryBytes:
            model.hardwareStatus = "modeled_estimate_exceeds_hardware"
    return true

fn BackendDriverDispatchMinFullRssMemoryModelBuild(
    sourceTextBytes: int64,
    csgGraphBytes: int64,
    exprLayerBytes: int64,
    typedFactsBytes: int64,
    typedIrBytes: int64,
    loweringBytes: int64,
    primaryBytes: int64,
    providerBytes: int64,
    linkBytes: int64,
    reportBytes: int64,
    typedIrFunctions: int64,
    sourceFiles: int64,
    hardwareMemoryBytes: int64): BackendDriverDispatchMinFullRssMemoryModel =
    var model: BackendDriverDispatchMinFullRssMemoryModel
    var reason: str
    if !BackendDriverDispatchMinFullRssMemoryModelTryBuild(sourceTextBytes,
                                                           csgGraphBytes,
                                                           exprLayerBytes,
                                                           typedFactsBytes,
                                                           typedIrBytes,
                                                           loweringBytes,
                                                           primaryBytes,
                                                           providerBytes,
                                                           linkBytes,
                                                           reportBytes,
                                                           typedIrFunctions,
                                                           sourceFiles,
                                                           hardwareMemoryBytes,
                                                           model,
                                                           reason):
        panic(Fmt"backend_driver_dispatch_min_full_rss_memory_model_invalid reason={reason}")
    return model

@borrows
fn BackendDriverDispatchMinCompileRssTheoryLowerBoundBytes(
    model: BackendDriverDispatchMinFullRssMemoryModel): int64 =
    return model.modeledLowerBoundBytes

fn BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
    rss: var BackendDriverDispatchMinFullRssMemoryModel,
    requestedJobsRaw: int64,
    hardwareJobsRaw: int64,
    memoryLimitBytesRaw: int64,
    model: var BackendDriverDispatchMinFullRssParallelMemoryModel,
    reason: var str): bool =
    model.memoryLimitBytes = int64(0)
    model.guardScaleNumerator = int64(0)
    model.guardScaleDenominator = int64(0)
    model.guardReserveBytes = int64(0)
    model.sourceFixedBytes = int64(0)
    model.sourcePerWorkerBytes = int64(0)
    model.csgFixedBytes = int64(0)
    model.csgPerWorkerBytes = int64(0)
    model.typedIrFixedBytes = int64(0)
    model.typedIrPerWorkerBytes = int64(0)
    model.loweringFixedBytes = int64(0)
    model.loweringPerWorkerBytes = int64(0)
    model.primaryFixedBytes = int64(0)
    model.primaryPerWorkerBytes = int64(0)
    model.providerFixedBytes = int64(0)
    model.providerPerWorkerBytes = int64(0)
    model.linkFixedBytes = int64(0)
    model.linkPerWorkerBytes = int64(0)
    model.reportFixedBytes = int64(0)
    model.reportPerWorkerBytes = int64(0)
    model.serialFloorBytes = int64(0)
    model.loweringLimitedJobs = int64(0)
    model.primaryLimitedJobs = int64(0)
    model.memoryLimitedMaxJobs = int64(0)
    model.effectiveJobs = int64(0)
    model.status = ""
    reason = ""
    var math = BackendDriverDispatchMinCheckedMathStart()
    let requestedJobs = BackendDriverDispatchMinCheckedMathInput(
        math,
        requestedJobsRaw,
        "rss_parallel_requested_jobs")
    let hardwareJobs = BackendDriverDispatchMinCheckedMathInput(
        math,
        hardwareJobsRaw,
        "rss_parallel_hardware_jobs")
    let memoryLimitBytes = BackendDriverDispatchMinCheckedMathInput(
        math,
        memoryLimitBytesRaw,
        "rss_parallel_memory_limit")
    if requestedJobs <= int64(0):
        BackendDriverDispatchMinCheckedMathFail(
            math,
            "rss_parallel_requested_jobs_non_positive")
    if hardwareJobs <= int64(0):
        BackendDriverDispatchMinCheckedMathFail(
            math,
            "rss_parallel_hardware_jobs_non_positive")
    if memoryLimitBytes <= int64(0):
        BackendDriverDispatchMinCheckedMathFail(
            math,
            "rss_parallel_memory_limit_non_positive")
    let guardScaleNumerator = int64(3)
    let guardScaleDenominator = int64(1)
    let scaledStructuredPeak = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.modeledStructuredPeakBytes,
        guardScaleNumerator,
        "rss_parallel_scaled_structured_peak")
    let guardReserveBytes = BackendDriverDispatchMinCheckedMathSub(
        math,
        rss.modeledGuardEstimateBytes,
        scaledStructuredPeak,
        "rss_parallel_guard_reserve")
    let loweringBaseBytes = BackendDriverDispatchMinCheckedMathSub(
        math,
        rss.loweringPhaseBytes,
        rss.loweringIncrementalBytes,
        "rss_parallel_lowering_base")
    let primaryBaseBytes = BackendDriverDispatchMinCheckedMathSub(
        math,
        rss.primaryPhaseBytes,
        rss.primaryIncrementalBytes,
        "rss_parallel_primary_base")
    let csgScaledBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.csgPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_csg_scaled")
    let sourceScaledBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.sourceTextBytes,
        guardScaleNumerator,
        "rss_parallel_source_scaled")
    let loweringBaseScaledBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        loweringBaseBytes,
        guardScaleNumerator,
        "rss_parallel_lowering_base_scaled")
    let loweringPerWorkerBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.loweringIncrementalBytes,
        guardScaleNumerator,
        "rss_parallel_lowering_per_worker")
    let primaryBaseScaledBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        primaryBaseBytes,
        guardScaleNumerator,
        "rss_parallel_primary_base_scaled")
    let primaryPerWorkerBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.primaryIncrementalBytes,
        guardScaleNumerator,
        "rss_parallel_primary_per_worker")
    let providerScaledBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.providerPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_provider_scaled")
    let linkScaledBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.linkPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_link_scaled")
    let reportScaledBytes = BackendDriverDispatchMinCheckedMathMul(
        math,
        rss.reportPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_report_scaled")
    let csgFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        csgScaledBytes,
        "rss_parallel_csg_fixed")
    let sourceFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        sourceScaledBytes,
        "rss_parallel_source_fixed")
    let typedIrFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        loweringBaseScaledBytes,
        "rss_parallel_typed_ir_fixed")
    let loweringFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        loweringBaseScaledBytes,
        "rss_parallel_lowering_fixed")
    let primaryFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        primaryBaseScaledBytes,
        "rss_parallel_primary_fixed")
    let providerFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        providerScaledBytes,
        "rss_parallel_provider_fixed")
    let linkFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        linkScaledBytes,
        "rss_parallel_link_fixed")
    let reportFixedBytes = BackendDriverDispatchMinCheckedMathAdd(
        math,
        guardReserveBytes,
        reportScaledBytes,
        "rss_parallel_report_fixed")
    var serialFloorBytes = BackendDriverDispatchMinCheckedMathMax(
        math,
        sourceFixedBytes,
        csgFixedBytes,
        "rss_parallel_serial_source_csg")
    serialFloorBytes = BackendDriverDispatchMinCheckedMathMax(
        math,
        serialFloorBytes,
        typedIrFixedBytes,
        "rss_parallel_serial_typed_ir")
    serialFloorBytes = BackendDriverDispatchMinCheckedMathMax(
        math,
        serialFloorBytes,
        loweringFixedBytes,
        "rss_parallel_serial_lowering_fixed")
    serialFloorBytes = BackendDriverDispatchMinCheckedMathMax(
        math,
        serialFloorBytes,
        primaryFixedBytes,
        "rss_parallel_serial_primary_fixed")
    serialFloorBytes = BackendDriverDispatchMinCheckedMathMax(
        math,
        serialFloorBytes,
        providerFixedBytes,
        "rss_parallel_serial_provider")
    serialFloorBytes = BackendDriverDispatchMinCheckedMathMax(
        math,
        serialFloorBytes,
        linkFixedBytes,
        "rss_parallel_serial_link")
    serialFloorBytes = BackendDriverDispatchMinCheckedMathMax(
        math,
        serialFloorBytes,
        reportFixedBytes,
        "rss_parallel_serial_report")
    if !math.ok:
        reason = math.reason
        return false
    if serialFloorBytes > memoryLimitBytes:
        reason = "rss_parallel_serial_floor_exceeds_memory_limit"
        return false
    var loweringLimitedJobs = hardwareJobs
    if loweringPerWorkerBytes > int64(0):
        let loweringAvailableBytes = memoryLimitBytes - loweringFixedBytes
        if loweringAvailableBytes < loweringPerWorkerBytes:
            reason = "rss_parallel_lowering_one_worker_exceeds_memory_limit"
            return false
        loweringLimitedJobs = loweringAvailableBytes / loweringPerWorkerBytes
    var primaryLimitedJobs = hardwareJobs
    if primaryPerWorkerBytes > int64(0):
        let primaryAvailableBytes = memoryLimitBytes - primaryFixedBytes
        if primaryAvailableBytes < primaryPerWorkerBytes:
            reason = "rss_parallel_primary_one_worker_exceeds_memory_limit"
            return false
        primaryLimitedJobs = primaryAvailableBytes / primaryPerWorkerBytes
    var memoryLimitedMaxJobs = hardwareJobs
    if loweringLimitedJobs < memoryLimitedMaxJobs:
        memoryLimitedMaxJobs = loweringLimitedJobs
    if primaryLimitedJobs < memoryLimitedMaxJobs:
        memoryLimitedMaxJobs = primaryLimitedJobs
    if memoryLimitedMaxJobs <= int64(0):
        reason = "rss_parallel_memory_limited_jobs_non_positive"
        return false
    var effectiveJobs = requestedJobs
    if hardwareJobs < effectiveJobs:
        effectiveJobs = hardwareJobs
    if memoryLimitedMaxJobs < effectiveJobs:
        effectiveJobs = memoryLimitedMaxJobs
    if effectiveJobs <= int64(0):
        reason = "rss_parallel_effective_jobs_non_positive"
        return false
    model.memoryLimitBytes = memoryLimitBytes
    model.guardScaleNumerator = guardScaleNumerator
    model.guardScaleDenominator = guardScaleDenominator
    model.guardReserveBytes = guardReserveBytes
    model.sourceFixedBytes = sourceFixedBytes
    model.sourcePerWorkerBytes = int64(0)
    model.csgFixedBytes = csgFixedBytes
    model.csgPerWorkerBytes = int64(0)
    model.typedIrFixedBytes = typedIrFixedBytes
    model.typedIrPerWorkerBytes = int64(0)
    model.loweringFixedBytes = loweringFixedBytes
    model.loweringPerWorkerBytes = loweringPerWorkerBytes
    model.primaryFixedBytes = primaryFixedBytes
    model.primaryPerWorkerBytes = primaryPerWorkerBytes
    model.providerFixedBytes = providerFixedBytes
    model.providerPerWorkerBytes = int64(0)
    model.linkFixedBytes = linkFixedBytes
    model.linkPerWorkerBytes = int64(0)
    model.reportFixedBytes = reportFixedBytes
    model.reportPerWorkerBytes = int64(0)
    model.serialFloorBytes = serialFloorBytes
    model.loweringLimitedJobs = loweringLimitedJobs
    model.primaryLimitedJobs = primaryLimitedJobs
    model.memoryLimitedMaxJobs = memoryLimitedMaxJobs
    model.effectiveJobs = effectiveJobs
    model.status = "modeled_components_within_memory_limit"
    return true

fn BackendDriverDispatchMinFullRssParallelMemoryModelReport(
    model: var BackendDriverDispatchMinFullRssParallelMemoryModel): str =
    var out: str
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_parallel_model=closed_form_phase_fixed_plus_per_worker")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_parallel_model_scope=modeled_components_only")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_memory_limit_bytes={model.memoryLimitBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_parallel_guard_scale_numerator={model.guardScaleNumerator}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_parallel_guard_scale_denominator={model.guardScaleDenominator}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_parallel_guard_reserve_bytes={model.guardReserveBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_source_fixed_bytes={model.sourceFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_source_per_worker_bytes={model.sourcePerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_csg_fixed_bytes={model.csgFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_csg_per_worker_bytes={model.csgPerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_typed_ir_fixed_bytes={model.typedIrFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_typed_ir_per_worker_bytes={model.typedIrPerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_lowering_fixed_bytes={model.loweringFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_lowering_per_worker_bytes={model.loweringPerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_primary_fixed_bytes={model.primaryFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_primary_per_worker_bytes={model.primaryPerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_provider_fixed_bytes={model.providerFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_provider_per_worker_bytes={model.providerPerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_link_fixed_bytes={model.linkFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_link_per_worker_bytes={model.linkPerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_report_fixed_bytes={model.reportFixedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_report_per_worker_bytes={model.reportPerWorkerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_parallel_serial_floor_bytes={model.serialFloorBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_lowering_memory_limited_jobs={model.loweringLimitedJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_primary_memory_limited_jobs={model.primaryLimitedJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_memory_limited_max_jobs={model.memoryLimitedMaxJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_memory_limited_effective_jobs={model.effectiveJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_parallel_status={model.status}")
    return out

fn BackendDriverDispatchMinFullRssMemoryModelReport(
    model: var BackendDriverDispatchMinFullRssMemoryModel,
    typedFacts: var BackendDriverDispatchMinTypedFactMemoryModel): str =
    var out: str
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_model=phase_lifetime_max_checked")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_model_scope=non_exhaustive_modeled_components")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_estimate_status=non_exhaustive_modeled_estimate_not_proven_upper_bound")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_component_coverage=non_exhaustive")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_unmodeled_owner_count=8")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_unmodeled_components=typed_fact_intern_payload,other_string_and_intern_pools,allocator_runtime_metadata,process_runtime_baseline,thread_stacks,device_allocations,linker_allocations,codegen_provider_allocations")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_proven_upper_bound_status=not_proven")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_source_text_bytes={model.sourceTextBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_csg_graph_bytes={model.csgGraphBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_expr_layer_bytes={model.exprLayerBytes}")
    BackendDriverDispatchMinAppendLine(out, BackendDriverDispatchMinTypedFactMemoryModelReport(typedFacts))
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_typed_ir_bytes={model.typedIrBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_lowering_bytes={model.loweringBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_primary_bytes={model.primaryBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_provider_bytes={model.providerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_link_bytes={model.linkBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_report_bytes={model.reportBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_csg_structured_bytes={model.csgPhaseBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_lowering_structured_bytes={model.loweringPhaseBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_primary_structured_bytes={model.primaryPhaseBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_provider_structured_bytes={model.providerPhaseBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_link_structured_bytes={model.linkPhaseBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_phase_report_structured_bytes={model.reportPhaseBytes}")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_modeled_retention_model=phase_lifetime_max_with_explicit_release")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_single_phase_peak_name={model.peakPhaseName}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_single_phase_max_structured_bytes={model.modeledStructuredPeakBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_modeled_structured_peak_bytes={model.modeledStructuredPeakBytes}")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_lower_bound_model=deterministic_phase_lifetime_consume_window_plus_orc")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_exclusive_phase_lower_bound_bytes={model.exclusivePhaseLowerBoundBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_consume_window_lower_bound_bytes={model.consumeWindowLowerBoundBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_lower_bound_bytes={model.modeledLowerBoundBytes}")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_official_hard_gate_bytes=805306368")
    var lowerBoundFitsHardGate = "0"
    if model.modeledLowerBoundBytes <= int64(805306368):
        lowerBoundFitsHardGate = "1"
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_lower_bound_fits_hard_gate={lowerBoundFitsHardGate}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_legacy_retained_cumulative_estimate_bytes={model.legacyRetainedCumulativeEstimateBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_csg_incremental_bytes={model.csgIncrementalBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_lowering_incremental_bytes={model.loweringIncrementalBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_primary_incremental_bytes={model.primaryIncrementalBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_report_incremental_bytes={model.reportIncrementalBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_capacity_bytes={model.capacityBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_orc_bytes={model.orcBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_arena_bytes={model.arenaBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_allocator_heuristic_estimate_bytes={model.allocatorHeuristicBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_allocator_classified_sum_bytes={model.allocatorClassifiedBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_allocator_modeled_bytes={model.allocatorModeledBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_allocator_gap_bytes={model.allocatorGapBytes}")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_allocator_invariant=modeled_gte_capacity_plus_orc_plus_arena")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_peak_phase_name={model.peakPhaseName}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_modeled_peak_estimate_bytes={model.modeledPeakEstimateBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_modeled_budget_estimate_bytes={model.modeledBudgetEstimateBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_modeled_guard_estimate_bytes={model.modeledGuardEstimateBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_rss_modeled_guard_hardware_status={model.hardwareStatus}")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_rss_modeled_guard_hardware_status_semantics=non_exhaustive_modeled_estimate_only")
    return out

fn BackendDriverDispatchMinAppendFullTheoryReport(out: var str,
                                                   sourceFilesRaw: int64,
                                                   sourceLinesRaw: int64,
                                                   sourceBytesRaw: int64,
                                                   importEdgeCount: int32,
                                                   declCountRaw: int64,
                                                   functionCountRaw: int64,
                                                   exportCountRaw: int64,
                                                   importcCountRaw: int64,
                                                   callEdgeCountRaw: int64,
                                                   typeRefCountRaw: int64,
                                                   sourceClosureNsRaw: int64,
                                                   formatFloorBytesRaw: int64,
                                                   requestedJobs: int32,
                                                   hardwareJobs: int32,
                                                   effectiveJobs: int32,
                                                   hardwareMemoryBytesRaw: int64,
                                                   memoryLimitBytesRaw: int64,
                                                   reason: var str): bool =
    reason = ""
    var math = BackendDriverDispatchMinCheckedMathStart()
    let sourceFiles = BackendDriverDispatchMinCheckedMathInput(math, sourceFilesRaw, "source_files")
    let sourceLines = BackendDriverDispatchMinCheckedMathInput(math, sourceLinesRaw, "source_lines")
    let sourceBytes = BackendDriverDispatchMinCheckedMathInput(math, sourceBytesRaw, "source_bytes")
    let importEdges = BackendDriverDispatchMinCheckedMathInput(math, int64(importEdgeCount), "import_edges")
    let declCount = BackendDriverDispatchMinCheckedMathInput(math, declCountRaw, "decl_count")
    let functionCount = BackendDriverDispatchMinCheckedMathInput(math, functionCountRaw, "function_count")
    let exportCount = BackendDriverDispatchMinCheckedMathInput(math, exportCountRaw, "export_count")
    let importcCount = BackendDriverDispatchMinCheckedMathInput(math, importcCountRaw, "importc_count")
    let callEdgeCount = BackendDriverDispatchMinCheckedMathInput(math, callEdgeCountRaw, "call_edge_count")
    let typeRefCount = BackendDriverDispatchMinCheckedMathInput(math, typeRefCountRaw, "type_ref_count")
    let sourceClosureNs = BackendDriverDispatchMinCheckedMathInput(math, sourceClosureNsRaw, "source_closure_ns")
    let formatFloorBytes = BackendDriverDispatchMinCheckedMathInput(math, formatFloorBytesRaw, "format_floor_bytes")
    let requestedJobsValue = BackendDriverDispatchMinCheckedMathInput(math, int64(requestedJobs), "requested_jobs")
    let hardwareJobsValue = BackendDriverDispatchMinCheckedMathInput(math, int64(hardwareJobs), "hardware_jobs")
    let effectiveJobsValue = BackendDriverDispatchMinCheckedMathInput(math, int64(effectiveJobs), "effective_jobs")
    let hardwareMemoryBytes = BackendDriverDispatchMinCheckedMathInput(math, hardwareMemoryBytesRaw, "hardware_memory_bytes")
    let memoryLimitBytes = BackendDriverDispatchMinCheckedMathInput(math, memoryLimitBytesRaw, "memory_limit_bytes")
    if effectiveJobsValue <= int64(0):
        BackendDriverDispatchMinCheckedMathFail(math, "effective_jobs_non_positive")
    var hardwareEffectiveJobs = requestedJobsValue
    if hardwareJobsValue < hardwareEffectiveJobs:
        hardwareEffectiveJobs = hardwareJobsValue
    if effectiveJobsValue != hardwareEffectiveJobs:
        BackendDriverDispatchMinCheckedMathFail(math, "effective_jobs_mismatch")
    if !math.ok:
        reason = math.reason
        return false
    var declEstimate = BackendDriverDispatchMinCheckedMathMax(math, declCount, functionCount, "decl_estimate")
    var functionEstimate = functionCount
    if functionEstimate <= int64(0):
        let lineFunctionEstimate = BackendDriverDispatchMinCheckedMathDivCeil(math, sourceLines, int64(24), "function_estimate_lines")
        functionEstimate = BackendDriverDispatchMinCheckedMathAdd(math, lineFunctionEstimate, sourceFiles, "function_estimate")
    let exportEstimate = BackendDriverDispatchMinCheckedMathMax(math, exportCount, importcCount, "export_estimate")
    let callEdgeEstimate = BackendDriverDispatchMinCheckedMathMax(math, callEdgeCount, functionEstimate, "call_edge_estimate")
    let typeRefEstimate = BackendDriverDispatchMinCheckedMathMax(math, typeRefCount, declEstimate, "type_ref_estimate")
    var typedIrFunctions = BackendDriverDispatchMinCheckedMathAdd(math, functionEstimate, sourceFiles, "typed_ir_functions")
    if typedIrFunctions <= int64(0):
        typedIrFunctions = int64(1)
    let statementLines = BackendDriverDispatchMinCheckedMathDivCeil(math, sourceLines, int64(2), "typed_ir_statement_lines")
    let statementTypes = BackendDriverDispatchMinCheckedMathDivCeil(math, typeRefEstimate, int64(2), "typed_ir_statement_types")
    let statementLinesCalls = BackendDriverDispatchMinCheckedMathAdd(math, statementLines, callEdgeEstimate, "typed_ir_statement_lines_calls")
    let statementEstimate = BackendDriverDispatchMinCheckedMathAdd(math, statementLinesCalls, statementTypes, "typed_ir_statement_estimate")
    let typedIrStatements = BackendDriverDispatchMinCheckedMathMax(math, statementEstimate, typedIrFunctions, "typed_ir_statements")
    let csgExprLines = BackendDriverDispatchMinCheckedMathMul(math, sourceLines, int64(2), "csg_expr_lines")
    let csgExprBytes = BackendDriverDispatchMinCheckedMathDivCeil(math, sourceBytes, int64(24), "csg_expr_bytes")
    let csgExprLineBytes = BackendDriverDispatchMinCheckedMathAdd(math, csgExprLines, csgExprBytes, "csg_expr_line_bytes")
    let csgExprCalls = BackendDriverDispatchMinCheckedMathAdd(math, csgExprLineBytes, callEdgeEstimate, "csg_expr_calls")
    let csgExprEstimate = BackendDriverDispatchMinCheckedMathAdd(math, csgExprCalls, typeRefEstimate, "csg_expr_estimate")
    let csgExprs = BackendDriverDispatchMinCheckedMathMax(math, csgExprEstimate, typedIrStatements, "csg_exprs")
    let csgNodeLines = BackendDriverDispatchMinCheckedMathMul(math, sourceLines, int64(4), "csg_node_lines")
    let csgNodeFiles = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(32), "csg_node_files")
    let csgNodeImports = BackendDriverDispatchMinCheckedMathMul(math, importEdges, int64(8), "csg_node_imports")
    let csgNodeDecls = BackendDriverDispatchMinCheckedMathMul(math, declEstimate, int64(6), "csg_node_decls")
    let csgNodeFunctions = BackendDriverDispatchMinCheckedMathMul(math, functionEstimate, int64(12), "csg_node_functions")
    let csgNodeTypes = BackendDriverDispatchMinCheckedMathMul(math, typeRefEstimate, int64(2), "csg_node_types")
    let csgNodeLineFiles = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeLines, csgNodeFiles, "csg_node_line_files")
    let csgNodeImportsDecls = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeImports, csgNodeDecls, "csg_node_imports_decls")
    let csgNodeFunctionsTypes = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeFunctions, csgNodeTypes, "csg_node_functions_types")
    let csgNodeLeft = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeLineFiles, csgNodeImportsDecls, "csg_node_left")
    let csgNodeRight = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeFunctionsTypes, int64(64), "csg_node_right")
    let csgNodeEstimate = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeLeft, csgNodeRight, "csg_node_estimate")
    let csgNodes = BackendDriverDispatchMinCheckedMathMax(math, csgNodeEstimate, csgExprs, "csg_nodes")
    let csgEdgeNodes = BackendDriverDispatchMinCheckedMathMul(math, csgNodes, int64(2), "csg_edge_nodes")
    let csgEdgeImports = BackendDriverDispatchMinCheckedMathMul(math, importEdges, int64(4), "csg_edge_imports")
    let csgEdgeBase = BackendDriverDispatchMinCheckedMathAdd(math, csgEdgeNodes, csgEdgeImports, "csg_edge_base")
    let csgEdgeCalls = BackendDriverDispatchMinCheckedMathAdd(math, csgEdgeBase, callEdgeEstimate, "csg_edge_calls")
    let csgEdges = BackendDriverDispatchMinCheckedMathAdd(math, csgEdgeCalls, typeRefEstimate, "csg_edges")
    let csgFactNodes = BackendDriverDispatchMinCheckedMathMul(math, csgNodes, int64(3), "csg_fact_nodes")
    let csgFactFiles = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(32), "csg_fact_files")
    let csgFactDecls = BackendDriverDispatchMinCheckedMathMul(math, declEstimate, int64(4), "csg_fact_decls")
    let csgFactExports = BackendDriverDispatchMinCheckedMathMul(math, exportEstimate, int64(2), "csg_fact_exports")
    let csgFactNodeFiles = BackendDriverDispatchMinCheckedMathAdd(math, csgFactNodes, csgFactFiles, "csg_fact_node_files")
    let csgFactDeclExports = BackendDriverDispatchMinCheckedMathAdd(math, csgFactDecls, csgFactExports, "csg_fact_decl_exports")
    let csgFacts = BackendDriverDispatchMinCheckedMathAdd(math, csgFactNodeFiles, csgFactDeclExports, "csg_facts")
    var csgRounds = int64(3)
    if importEdges > int64(32):
        csgRounds = BackendDriverDispatchMinCheckedMathAdd(math, csgRounds, int64(1), "csg_rounds")
    let loweringFunctions = typedIrFunctions
    let loweringStatementOps = BackendDriverDispatchMinCheckedMathMul(math, typedIrStatements, int64(3), "lowering_statement_ops")
    let loweringBodyIrOps = BackendDriverDispatchMinCheckedMathAdd(math, loweringStatementOps, csgExprs, "lowering_body_ir_ops")
    let loweringLineStatements = BackendDriverDispatchMinCheckedMathMul(math, typedIrStatements, int64(12), "lowering_line_statements")
    let loweringLineFiles = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(64), "lowering_line_files")
    let loweringLineMapBytes = BackendDriverDispatchMinCheckedMathAdd(math, loweringLineStatements, loweringLineFiles, "lowering_line_map")
    let primaryBodyWords = BackendDriverDispatchMinCheckedMathMul(math, loweringBodyIrOps, int64(2), "primary_body_words")
    let primaryFunctionWords = BackendDriverDispatchMinCheckedMathMul(math, typedIrFunctions, int64(16), "primary_function_words")
    let primaryInstructionWords = BackendDriverDispatchMinCheckedMathAdd(math, primaryBodyWords, primaryFunctionWords, "primary_instruction_words")
    let primaryImportRelocs = BackendDriverDispatchMinCheckedMathMul(math, importEdges, int64(2), "primary_import_relocs")
    let primaryRelocs = BackendDriverDispatchMinCheckedMathAdd(math, primaryImportRelocs, typedIrFunctions, "primary_relocs")
    let primaryFunctionLabels = BackendDriverDispatchMinCheckedMathDivCeil(math, typedIrFunctions, int64(4), "primary_function_labels")
    let primaryFileLabels = BackendDriverDispatchMinCheckedMathAdd(math, sourceFiles, primaryFunctionLabels, "primary_file_labels")
    let primaryDataLabels = BackendDriverDispatchMinCheckedMathAdd(math, primaryFileLabels, int64(1), "primary_data_labels")
    let primaryInstructionBytes = BackendDriverDispatchMinCheckedMathMul(math, primaryInstructionWords, int64(4), "primary_instruction_bytes")
    let primaryRelocBytes = BackendDriverDispatchMinCheckedMathMul(math, primaryRelocs, int64(24), "primary_reloc_bytes")
    let primaryLabelBytes = BackendDriverDispatchMinCheckedMathMul(math, primaryDataLabels, int64(32), "primary_label_bytes")
    let primaryObjectCodeBytes = BackendDriverDispatchMinCheckedMathAdd(math, primaryInstructionBytes, primaryRelocBytes, "primary_object_code")
    let primaryObjectMetadataBytes = BackendDriverDispatchMinCheckedMathAdd(math, primaryLabelBytes, formatFloorBytes, "primary_object_metadata")
    let primaryObjectLowerBytes = BackendDriverDispatchMinCheckedMathAdd(math, primaryObjectCodeBytes, primaryObjectMetadataBytes, "primary_object_lower")
    let primaryObjectBudgetDouble = BackendDriverDispatchMinCheckedMathMul(math, primaryObjectLowerBytes, int64(2), "primary_object_budget_double")
    let primaryObjectBudgetBytes = BackendDriverDispatchMinCheckedMathAdd(math, primaryObjectBudgetDouble, int64(4096), "primary_object_budget")
    let rssSourcePayloadBytes = BackendDriverDispatchMinCheckedMathMul(math, sourceBytes, int64(2), "rss_source_payload")
    let rssSourceFileBytes = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(128), "rss_source_files")
    let rssSourceTextBytes = BackendDriverDispatchMinCheckedMathAdd(math, rssSourcePayloadBytes, rssSourceFileBytes, "rss_source_text")
    let rssCsgNodeBytes = BackendDriverDispatchMinCheckedMathMul(math, csgNodes, int64(40), "rss_csg_nodes")
    let rssCsgEdgeBytes = BackendDriverDispatchMinCheckedMathMul(math, csgEdges, int64(16), "rss_csg_edges")
    let rssCsgGraphBytes = BackendDriverDispatchMinCheckedMathAdd(math, rssCsgNodeBytes, rssCsgEdgeBytes, "rss_csg_graph")
    let rssExprLayerBytes = BackendDriverDispatchMinCheckedMathMul(math, csgExprs, int64(48), "rss_expr_layer")
    var typedFactMemoryModel: BackendDriverDispatchMinTypedFactMemoryModel
    var typedFactReason: str
    if !BackendDriverDispatchMinTypedFactMemoryModelTryBuild(csgFacts,
                                                              typedFactMemoryModel,
                                                              typedFactReason):
        reason = Fmt"typed_fact_{typedFactReason}"
        return false
    let rssTypedFactsBytes = typedFactMemoryModel.physicalStorageBytes
    let rssTypedIrFunctionBytes = BackendDriverDispatchMinCheckedMathMul(math, typedIrFunctions, int64(192), "rss_typed_ir_functions")
    let rssTypedIrStatementBytes = BackendDriverDispatchMinCheckedMathMul(math, typedIrStatements, int64(64), "rss_typed_ir_statements")
    let rssTypedIrBytes = BackendDriverDispatchMinCheckedMathAdd(math, rssTypedIrFunctionBytes, rssTypedIrStatementBytes, "rss_typed_ir")
    let rssLoweringOpBytes = BackendDriverDispatchMinCheckedMathMul(math, loweringBodyIrOps, int64(48), "rss_lowering_ops")
    let rssLoweringFunctionBytes = BackendDriverDispatchMinCheckedMathMul(math, loweringFunctions, int64(256), "rss_lowering_functions")
    let rssLoweringBytes = BackendDriverDispatchMinCheckedMathAdd(math, rssLoweringOpBytes, rssLoweringFunctionBytes, "rss_lowering")
    let rssPrimaryInstructionBytes = BackendDriverDispatchMinCheckedMathMul(math, primaryInstructionWords, int64(8), "rss_primary_instructions")
    let rssPrimaryRelocBytes = BackendDriverDispatchMinCheckedMathMul(math, primaryRelocs, int64(32), "rss_primary_relocs")
    let rssPrimaryLabelBytes = BackendDriverDispatchMinCheckedMathMul(math, primaryDataLabels, int64(64), "rss_primary_labels")
    let rssPrimaryCodeBytes = BackendDriverDispatchMinCheckedMathAdd(math, rssPrimaryInstructionBytes, rssPrimaryRelocBytes, "rss_primary_code")
    let rssPrimaryBytes = BackendDriverDispatchMinCheckedMathAdd(math, rssPrimaryCodeBytes, rssPrimaryLabelBytes, "rss_primary")
    let rssProviderBytes = int64(0)
    let rssLinkBytes = int64(0)
    let rssReportFileBytes = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(64), "rss_report_files")
    let rssReportBytes = BackendDriverDispatchMinCheckedMathAdd(math, rssReportFileBytes, int64(4096), "rss_report")
    var rssModel: BackendDriverDispatchMinFullRssMemoryModel
    var rssReason: str
    if !BackendDriverDispatchMinFullRssMemoryModelTryBuild(rssSourceTextBytes,
                                                           rssCsgGraphBytes,
                                                           rssExprLayerBytes,
                                                           rssTypedFactsBytes,
                                                           rssTypedIrBytes,
                                                           rssLoweringBytes,
                                                           rssPrimaryBytes,
                                                           rssProviderBytes,
                                                           rssLinkBytes,
                                                           rssReportBytes,
                                                           typedIrFunctions,
                                                           sourceFiles,
                                                           hardwareMemoryBytes,
                                                           rssModel,
                                                           rssReason):
        reason = Fmt"rss_model_{rssReason}"
        return false
    var rssParallelModel: BackendDriverDispatchMinFullRssParallelMemoryModel
    var rssParallelReason: str
    if !BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
           rssModel,
           requestedJobsValue,
           hardwareJobsValue,
           memoryLimitBytes,
           rssParallelModel,
           rssParallelReason):
        reason = Fmt"rss_parallel_model_{rssParallelReason}"
        return false
    let sourceFileTime = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(200000), "time_source_files")
    let sourceByteTime = BackendDriverDispatchMinCheckedMathMul(math, sourceBytes, int64(50), "time_source_bytes")
    let sourceContentTime = BackendDriverDispatchMinCheckedMathAdd(math, sourceFileTime, sourceByteTime, "time_source_content")
    let sourcePhaseNs = BackendDriverDispatchMinCheckedMathMax(math, sourceClosureNs, sourceContentTime, "time_source_phase")
    let csgNodeTime = BackendDriverDispatchMinCheckedMathMul(math, csgNodes, int64(3000), "time_csg_nodes")
    let csgFactTime = BackendDriverDispatchMinCheckedMathMul(math, csgFacts, int64(1200), "time_csg_facts")
    let csgExprTime = BackendDriverDispatchMinCheckedMathMul(math, csgExprs, int64(2000), "time_csg_exprs")
    let csgNodeFactTime = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeTime, csgFactTime, "time_csg_node_facts")
    let csgPhaseNs = BackendDriverDispatchMinCheckedMathAdd(math, csgNodeFactTime, csgExprTime, "time_csg_phase")
    let typedIrFunctionTime = BackendDriverDispatchMinCheckedMathMul(math, typedIrFunctions, int64(70000), "time_typed_ir_functions")
    let typedIrStatementTime = BackendDriverDispatchMinCheckedMathMul(math, typedIrStatements, int64(1200), "time_typed_ir_statements")
    let typedIrPhaseNs = BackendDriverDispatchMinCheckedMathAdd(math, typedIrFunctionTime, typedIrStatementTime, "time_typed_ir_phase")
    let loweringOpTime = BackendDriverDispatchMinCheckedMathMul(math, loweringBodyIrOps, int64(2500), "time_lowering_ops")
    let loweringFunctionTime = BackendDriverDispatchMinCheckedMathMul(math, loweringFunctions, int64(50000), "time_lowering_functions")
    let loweringPhaseNs = BackendDriverDispatchMinCheckedMathAdd(math, loweringOpTime, loweringFunctionTime, "time_lowering_phase")
    let primaryInstructionTime = BackendDriverDispatchMinCheckedMathMul(math, primaryInstructionWords, int64(1000), "time_primary_instructions")
    let primaryRelocTime = BackendDriverDispatchMinCheckedMathMul(math, primaryRelocs, int64(5000), "time_primary_relocs")
    let primaryLabelTime = BackendDriverDispatchMinCheckedMathMul(math, primaryDataLabels, int64(3000), "time_primary_labels")
    let primaryCodeTime = BackendDriverDispatchMinCheckedMathAdd(math, primaryInstructionTime, primaryRelocTime, "time_primary_code")
    let primaryPhaseNs = BackendDriverDispatchMinCheckedMathAdd(math, primaryCodeTime, primaryLabelTime, "time_primary_phase")
    let providerPhaseNs = int64(0)
    var linkPhaseNs = int64(1000000)
    if formatFloorBytes >= int64(4096):
        linkPhaseNs = int64(5000000)
    let reportFileTime = BackendDriverDispatchMinCheckedMathMul(math, sourceFiles, int64(50000), "time_report_files")
    let reportPhaseNs = BackendDriverDispatchMinCheckedMathAdd(math, reportFileTime, int64(250000), "time_report_phase")
    let serialSourceCsg = BackendDriverDispatchMinCheckedMathAdd(math, sourcePhaseNs, csgPhaseNs, "time_serial_source_csg")
    let serialTypedProvider = BackendDriverDispatchMinCheckedMathAdd(math, typedIrPhaseNs, providerPhaseNs, "time_serial_typed_provider")
    let serialLinkReport = BackendDriverDispatchMinCheckedMathAdd(math, linkPhaseNs, reportPhaseNs, "time_serial_link_report")
    let serialLeft = BackendDriverDispatchMinCheckedMathAdd(math, serialSourceCsg, serialTypedProvider, "time_serial_left")
    let serialPhaseNs = BackendDriverDispatchMinCheckedMathAdd(math, serialLeft, serialLinkReport, "time_serial_phase")
    let parallelizablePhaseNs = BackendDriverDispatchMinCheckedMathAdd(math, loweringPhaseNs, primaryPhaseNs, "time_parallelizable_phase")
    let parallelShareNs = BackendDriverDispatchMinCheckedMathDivCeil(math, parallelizablePhaseNs, rssParallelModel.effectiveJobs, "time_parallel_share")
    let lowerBoundNs = BackendDriverDispatchMinCheckedMathAdd(math, serialPhaseNs, parallelShareNs, "time_lower_bound")
    let budgetTripleNs = BackendDriverDispatchMinCheckedMathMul(math, lowerBoundNs, int64(3), "time_budget_triple")
    let budgetUpperNs = BackendDriverDispatchMinCheckedMathAdd(math, budgetTripleNs, int64(20000000), "time_budget")
    let providerLowerBytes = int64(0)
    let providerBudgetBytes = int64(0)
    let finalObjectProviderLower = BackendDriverDispatchMinCheckedMathAdd(math, primaryObjectLowerBytes, providerLowerBytes, "size_final_object_provider_lower")
    let finalArtifactLowerBytes = BackendDriverDispatchMinCheckedMathAdd(math, finalObjectProviderLower, formatFloorBytes, "size_final_artifact_lower")
    let finalObjectProviderBudget = BackendDriverDispatchMinCheckedMathAdd(math, primaryObjectBudgetBytes, providerBudgetBytes, "size_final_object_provider_budget")
    let finalArtifactBudgetBytes = BackendDriverDispatchMinCheckedMathAdd(math, finalObjectProviderBudget, formatFloorBytes, "size_final_artifact_budget")
    if !math.ok:
        reason = math.reason
        return false
    BackendDriverDispatchMinAppendLine(out, "dry_compile_full_theory_model=full_compile_theory_deterministic_framework")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_full_theory_requires_real_validation=1")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_full_theory_executes_codegen=0")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_framework=canonical")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_requires_real_validation=1")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_calibration_source=phase_memory_ledger")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_validation_status=unvalidated")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_scope=non_exhaustive_modeled_compile_estimate_without_codegen_execution")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_bound_status=not_proven_upper_bound")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_model=deterministic_source_closure_hardware_coefficients")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_files={sourceFiles}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_lines={sourceLines}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_bytes={sourceBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_import_edges={importEdges}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_decl_estimate={declEstimate}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_function_estimate={functionEstimate}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_export_estimate={exportEstimate}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_importc_estimate={importcCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_call_edge_estimate={callEdgeEstimate}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_source_closure_type_ref_estimate={typeRefEstimate}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_csg_nodes={csgNodes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_csg_edges={csgEdges}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_csg_facts={csgFacts}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_csg_exprs={csgExprs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_typed_ir_funcs={typedIrFunctions}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_typed_ir_statements={typedIrStatements}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_typed_ir_rounds={csgRounds}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_lowering_funcs={loweringFunctions}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_lowering_body_ir_ops={loweringBodyIrOps}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_lowering_line_map_bytes={loweringLineMapBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_primary_instruction_words={primaryInstructionWords}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_primary_relocs={primaryRelocs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_primary_data_labels={primaryDataLabels}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_phase_primary_object_bytes={primaryObjectLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_phase_provider_object_count=0")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_phase_provider_object_bytes=0")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_phase_native_object_count=0")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_phase_native_object_bytes=0")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_phase_link_input_count=0")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_phase_link_input_bytes=0")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_nodes={csgNodes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_edges={csgEdges}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_facts={csgFacts}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_exprs={csgExprs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_typed_ir_functions={typedIrFunctions}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_typed_ir_statements={typedIrStatements}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_rounds={csgRounds}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_lowering_estimated_functions={loweringFunctions}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_lowering_estimated_body_ir_ops={loweringBodyIrOps}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_lowering_estimated_line_map_bytes={loweringLineMapBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_primary_estimated_instruction_words={primaryInstructionWords}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_primary_estimated_relocs={primaryRelocs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_primary_estimated_data_labels={primaryDataLabels}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_primary_estimated_object_bytes_lower_bound={primaryObjectLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_primary_estimated_object_bytes_budget_upper_bound={primaryObjectBudgetBytes}")
    BackendDriverDispatchMinAppendLine(
        out,
        BackendDriverDispatchMinFullRssMemoryModelReport(rssModel,
                                                          typedFactMemoryModel))
    BackendDriverDispatchMinAppendLine(
        out,
        BackendDriverDispatchMinFullRssParallelMemoryModelReport(
            rssParallelModel))
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_requested_jobs={requestedJobsValue}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_hardware_jobs={hardwareJobsValue}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_effective_jobs={rssParallelModel.effectiveJobs}")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_time_cpu_model=deterministic_source_content_costs")
    BackendDriverDispatchMinAppendLine(out, "full_compile_theory_time_memory_bandwidth_model=not_measured")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_source_closure_phase_ns={sourcePhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_compiler_csg_phase_ns={csgPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_typed_ir_phase_ns={typedIrPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_lowering_phase_ns={loweringPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_primary_phase_ns={primaryPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_provider_phase_ns={providerPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_link_phase_ns={linkPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_report_phase_ns={reportPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_source_ns={sourcePhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_source_ms={BackendDriverDispatchMinPhaseMsText(sourcePhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_csg_ns={csgPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_csg_ms={BackendDriverDispatchMinPhaseMsText(csgPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_typed_ir_ns={typedIrPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_typed_ir_ms={BackendDriverDispatchMinPhaseMsText(typedIrPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_lowering_ns={loweringPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_lowering_ms={BackendDriverDispatchMinPhaseMsText(loweringPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_primary_ns={primaryPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_primary_ms={BackendDriverDispatchMinPhaseMsText(primaryPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_provider_ns={providerPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_provider_ms={BackendDriverDispatchMinPhaseMsText(providerPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_link_ns={linkPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_link_ms={BackendDriverDispatchMinPhaseMsText(linkPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_report_ns={reportPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_phase_report_ms={BackendDriverDispatchMinPhaseMsText(reportPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_serial_phase_ns={serialPhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_serial_phase_ms={BackendDriverDispatchMinPhaseMsText(serialPhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_parallelizable_phase_ns={parallelizablePhaseNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_parallelizable_phase_ms={BackendDriverDispatchMinPhaseMsText(parallelizablePhaseNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_lower_bound_ns={lowerBoundNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_lower_bound_ms={BackendDriverDispatchMinPhaseMsText(lowerBoundNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_budget_upper_bound_ns={budgetUpperNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_budget_upper_bound_ms={BackendDriverDispatchMinPhaseMsText(budgetUpperNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_time_guard_recommended_ms={BackendDriverDispatchMinPhaseMsText(budgetUpperNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_size_object_lower_bound_bytes={primaryObjectLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_size_object_budget_upper_bound_bytes={primaryObjectBudgetBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_size_provider_lower_bound_bytes={providerLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_size_provider_budget_upper_bound_bytes={providerBudgetBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_size_final_artifact_lower_bound_bytes={finalArtifactLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"full_compile_theory_size_final_artifact_budget_upper_bound_bytes={finalArtifactBudgetBytes}")
    return true

@borrows
fn BackendDriverDispatchMinAppendDryCompileImportEdgeReport(
        out: var str,
        edge: var parser.ImportEdge,
        edgeIndex: int32) =
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.owner_module_path_fshex={BackendDriverDispatchMinReportTextHex(edge.ownerModulePath)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_module_path_fshex={BackendDriverDispatchMinReportTextHex(edge.targetModulePath)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_source_path_fshex={BackendDriverDispatchMinReportTextHex(edge.targetSourcePath)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_source_path_len={edge.targetSourcePathLen}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_source_path_first_code={edge.targetSourcePathFirstCode}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_source_path_last_code={edge.targetSourcePathLastCode}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_source_path_dot_count={edge.targetSourcePathDotCount}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_source_path_hash={edge.targetSourcePathHash}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.target_profile_index={edge.targetProfileIndex}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.import_alias_fshex={BackendDriverDispatchMinReportTextHex(edge.importAlias)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.qualifier_fshex={BackendDriverDispatchMinReportTextHex(edge.qualifier)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.allows_unqualified_call={edge.allowsUnqualifiedCall ? 1 : 0}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_edge.{edgeIndex}.resolved={edge.resolved ? 1 : 0}")

@borrows
fn BackendDriverDispatchMinAppendDryCompileReport(out: var str,
                                                   driverRoot: str,
                                                   linkPlan: var slplan.SystemLinkPlanStub,
                                                   sourceStats: var BackendDriverDispatchMinDryCompileSourceStats,
                                                   importEdgeCount: int32,
                                                   unresolvedImportCount: int32,
                                                   sourceClosureNs: int64,
                                                   phaseProfile: var BackendDriverDispatchMinPhaseProfile): bool =
    let sourceFiles = sourceStats.files
    let sourceLines = sourceStats.lines
    let sourceBytes = sourceStats.bytes
    let maxSourceBytes = sourceStats.maxFileBytes
    let declCount = sourceStats.declCount
    let functionCount = sourceStats.functionCount
    let exportCount = sourceStats.exportCount
    let importcCount = sourceStats.importcCount
    let callEdgeCount = sourceStats.callEdgeCount
    let typeRefCount = sourceStats.typeRefCount
    BackendDriverDispatchMinAppendLine(
        out, "schema=cheng.backend_driver.dry_compile_report")
    let sourceManifestCount = sourceStats.sourcePaths.len
    if sourceFiles <= int64(0) ||
       int64(sourceManifestCount) != sourceFiles ||
       sourceStats.sourceRawBytesCids.len != sourceManifestCount ||
       sourceStats.sourceByteCounts.len != sourceManifestCount ||
       sourceStats.sourceLineCounts.len != sourceManifestCount ||
       sourceStats.sourceImportEdgeCounts.len != sourceManifestCount ||
       sourceStats.sourceDiscoveryKinds.len != sourceManifestCount ||
       sourceStats.sourceDiscovererSourceIndices.len != sourceManifestCount ||
       sourceStats.sourceDiscovererEdgeIndices.len != sourceManifestCount ||
       sourceStats.sourceImportEdges.len != importEdgeCount:
        BackendDriverDispatchMinAppendLine(out, "dry_compile=0")
        BackendDriverDispatchMinAppendLine(
            out, "error=dry-compile: source stats or manifest unavailable")
        return false
    let requestedJobs = BackendDriverDispatchMinPositiveJobs(linkPlan.jobCount)
    let hardwareJobs = BackendDriverDispatchMinHardwareJobs()
    let effectiveJobs = BackendDriverDispatchMinEffectiveJobs(requestedJobs, hardwareJobs)
    let hardwareMemoryBytes = os.SystemMemoryTotalBytes()
    let memoryLimitBytes = BackendDriverDispatchMinConfiguredMaxRssBytes()
    let totalNs = BackendDriverDispatchMinPositiveNs(phaseProfile.totalNs)
    let serialNs = BackendDriverDispatchMinPositiveNs(phaseProfile.systemLinkPlanNs)
    let parallelizableNs = BackendDriverDispatchMinPositiveNs(sourceClosureNs)
    let lowerBoundNs = serialNs + BackendDriverDispatchMinDivCeilI64(parallelizableNs, effectiveJobs)
    let textLowerBytes = int64(0)
    let formatFloorBytes = BackendDriverDispatchMinDryCompileFormatFloorBytes(linkPlan.targetTriple,
                                                                              creq.CompilerEmitText(linkPlan.emitKind))
    let outputLowerBytes = textLowerBytes + formatFloorBytes
    let memoryLowerBytes = BackendDriverDispatchMinMaxI64(maxSourceBytes, textLowerBytes)
    BackendDriverDispatchMinAppendLine(out, "dry_compile=1")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_command=dry-compile")
    BackendDriverDispatchMinAppendLine(out, "compiler_impl=pure_cheng_backend_driver")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_input_contract_compiler=pure_cheng_backend_driver")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_input_contract_model=full_compile_theory_deterministic_framework")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_target_triple={linkPlan.targetTriple}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_emit_kind={creq.CompilerEmitText(linkPlan.emitKind)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_entry_source_fshex={BackendDriverDispatchMinReportTextHex(linkPlan.entryPath)}")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_input_contract_provider_state=disabled")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_input_contract_link_state=disabled")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_input_contract_cache_state=none")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_input_contract_provider_cache_state=none")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_hardware_logical_cpus={hardwareJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_hardware_memory_bytes={hardwareMemoryBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_memory_limit_bytes={memoryLimitBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_backend_jobs={requestedJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_contract_effective_jobs={effectiveJobs}")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_model=source_closure_hardware_theory_without_codegen")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_executes_codegen=0")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_source_closure_mode=parser_dependency_bfs")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_entry_fshex={BackendDriverDispatchMinReportTextHex(linkPlan.entryPath)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"target={linkPlan.targetTriple}")
    BackendDriverDispatchMinAppendLine(out, Fmt"emit={creq.CompilerEmitText(linkPlan.emitKind)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_source_file_count={sourceFiles}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_source_line_count={sourceLines}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_source_byte_count={sourceBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_input_source_max_file_bytes={maxSourceBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_import_edge_count={importEdgeCount}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_unresolved_import_count={unresolvedImportCount}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_source_manifest_count={sourceManifestCount}")
    for sourceIndex in 0..<sourceManifestCount:
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.path_fshex={BackendDriverDispatchMinReportTextHex(sourceStats.sourcePaths[sourceIndex])}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.raw_bytes_cid={layout.FixedBytes32Hex(sourceStats.sourceRawBytesCids[sourceIndex])}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.byte_count={sourceStats.sourceByteCounts[sourceIndex]}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.line_count={sourceStats.sourceLineCounts[sourceIndex]}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.import_edge_count={sourceStats.sourceImportEdgeCounts[sourceIndex]}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.discovery_kind={BackendDriverDispatchMinDryCompileDiscoveryKindText(sourceStats.sourceDiscoveryKinds[sourceIndex])}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.discoverer_source_index={sourceStats.sourceDiscovererSourceIndices[sourceIndex]}")
        BackendDriverDispatchMinAppendLine(
            out,
            Fmt"dry_compile_source_manifest.{sourceIndex}.discoverer_edge_index={sourceStats.sourceDiscovererEdgeIndices[sourceIndex]}")
    for edgeIndex in 0..<sourceStats.sourceImportEdges.len:
        BackendDriverDispatchMinAppendDryCompileImportEdgeReport(
            out, sourceStats.sourceImportEdges[edgeIndex], edgeIndex)
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_source_bundle_entry_source_index={sourceStats.sourceBundleEntrySourceIndex}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_source_bundle_cid={layout.FixedBytes32Hex(sourceStats.sourceBundleCid)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_entry_source_cid={layout.FixedBytes32Hex(sourceStats.entrySourceCid)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_import_graph_cid={layout.FixedBytes32Hex(sourceStats.importGraphCid)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_source_bundle_binding_seal={layout.FixedBytes32Hex(sourceStats.sourceBundleBindingSeal)}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_source_bundle_unresolved_import_count={sourceStats.unresolvedImportCount}")
    BackendDriverDispatchMinAppendLine(
        out,
        Fmt"dry_compile_source_manifest_cid={layout.FixedBytes32Hex(sourceStats.sourceManifestCid)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_hardware_logical_cpus={hardwareJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_hardware_memory_bytes={hardwareMemoryBytes}")
    var hardwareMemoryStatusLine = "dry_compile_hardware_memory_status=unavailable"
    if hardwareMemoryBytes > int64(0):
        hardwareMemoryStatusLine = "dry_compile_hardware_memory_status=ok"
    BackendDriverDispatchMinAppendLine(out, hardwareMemoryStatusLine)
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_requested_jobs={requestedJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_hardware_jobs={hardwareJobs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_effective_jobs={effectiveJobs}")
    BackendDriverDispatchMinAppendLine(out, "compile_parallel_theory_scope=dry_compile_precheck")
    BackendDriverDispatchMinAppendLine(out, "compile_parallel_theory_model=dry_compile_precheck_system_plan_plus_source_closure_div_effective_jobs")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_serial_phase_ns={serialNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_serial_phase_ms={BackendDriverDispatchMinPhaseMsText(serialNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallelizable_phase_ns={parallelizableNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallelizable_phase_ms={BackendDriverDispatchMinPhaseMsText(parallelizableNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_theory_lower_bound_ns={lowerBoundNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_theory_lower_bound_ms={BackendDriverDispatchMinPhaseMsText(lowerBoundNs)}")
    BackendDriverDispatchMinAppendLine(out, "compile_parallel_real_scope=dry_compile_precheck")
    BackendDriverDispatchMinAppendLine(out, "compile_parallel_real_executes_codegen=0")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_real_ns={totalNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_real_ms={BackendDriverDispatchMinPhaseMsText(totalNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_real_over_theory_x={BackendDriverDispatchMinRatioMilliText(totalNs, lowerBoundNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_real_over_theory_percent={BackendDriverDispatchMinPercentMilliText(totalNs, lowerBoundNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"compile_parallel_theory_efficiency_percent={BackendDriverDispatchMinPercentMilliText(lowerBoundNs, totalNs)}")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_primary_instruction_word_count=0")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_text_size_lower_bound_bytes={textLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_format_floor_bytes={formatFloorBytes}")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_output_size_theory_lower_bound_bytes={outputLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_memory_theory_scope=dry_compile_source_scan")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_memory_theory_model=max_source_file_bytes_without_codegen")
    BackendDriverDispatchMinAppendLine(out, Fmt"dry_compile_memory_theory_lower_bound_bytes={memoryLowerBytes}")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_predicts_full_compile_rss=0")
    BackendDriverDispatchMinAppendLine(out, "dry_compile_decision_scope=source_closure_triage_only")
    var fullTheoryReason: str
    if !BackendDriverDispatchMinAppendFullTheoryReport(out,
                                                       sourceFiles,
                                                       sourceLines,
                                                       sourceBytes,
                                                       importEdgeCount,
                                                       declCount,
                                                       functionCount,
                                                       exportCount,
                                                       importcCount,
                                                       callEdgeCount,
                                                       typeRefCount,
                                                       sourceClosureNs,
                                                       formatFloorBytes,
                                                       requestedJobs,
                                                       hardwareJobs,
                                                       effectiveJobs,
                                                       hardwareMemoryBytes,
                                                       memoryLimitBytes,
                                                       fullTheoryReason):
        panic(Fmt"backend_driver_dispatch_min_full_theory_report_invalid reason={fullTheoryReason}")
    BackendDriverDispatchMinAppendLine(out, Fmt"exec_phase_system_link_plan_ns={phaseProfile.systemLinkPlanNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"exec_phase_system_link_plan_ms={BackendDriverDispatchMinPhaseMsText(phaseProfile.systemLinkPlanNs)}")
    BackendDriverDispatchMinAppendLine(out, Fmt"exec_phase_source_closure_ns={sourceClosureNs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"exec_phase_source_closure_ms={BackendDriverDispatchMinPhaseMsText(sourceClosureNs)}")
    BackendDriverDispatchMinAppendLine(out, "exec_phase_compiler_csg_ms=0")
    BackendDriverDispatchMinAppendLine(out, "exec_phase_lowering_plan_ms=0")
    BackendDriverDispatchMinAppendLine(out, "exec_phase_primary_object_plan_ms=0")
    BackendDriverDispatchMinAppendLine(out, "exec_phase_direct_object_emit_ms=0")
    BackendDriverDispatchMinAppendLine(out, "exec_phase_provider_objects_ms=0")
    BackendDriverDispatchMinAppendLine(out, "exec_phase_native_link_ms=0")
    BackendDriverDispatchMinAppendLine(out, "exec_phase_line_map_ms=0")
    BackendDriverDispatchMinAppendLine(out, Fmt"exec_phase_total_ms={BackendDriverDispatchMinPhaseMsText(totalNs)}")
    BackendDriverDispatchMinAppendLine(out, "exec_retained_payload_approx_bytes=0")
    BackendDriverDispatchMinAppendLine(out, "exec_retained_lowering_payload_approx_bytes=0")
    BackendDriverDispatchMinAppendLine(out, "exec_retained_primary_payload_approx_bytes=0")
    BackendDriverDispatchMinAppendLine(out, "exec_retained_object_plan_approx_bytes=0")
    BackendDriverDispatchMinAppendLine(out, "exec_retained_native_plan_approx_bytes=0")
    BackendDriverDispatchMinAppendLine(out, "exec_retained_object_plan_item_count=0")
    BackendDriverDispatchMinAppendLine(out, "exec_retained_native_plan_item_count=0")
    return true

fn BackendDriverDispatchMinAppendResourceReport(out: var str) =
    let cpuUs = BackendDriverDispatchMinCurrentCpuUs()
    var cpuMs = int64(-1)
    if cpuUs >= int64(0):
        cpuMs = cpuUs / int64(1000)
    let rssBytes = BackendDriverDispatchMinCurrentRssBytes()
    BackendDriverDispatchMinAppendLine(out, Fmt"report_cpu_ms={cpuMs}")
    BackendDriverDispatchMinAppendLine(out, Fmt"report_rss_bytes={rssBytes}")

fn BackendDriverDispatchMinPhaseMemoryGapBytes(rssBytes: int64,
                                               structuredBytes: int64): int64 =
    if rssBytes < int64(0):
        return int64(-1)
    return rssBytes - structuredBytes

fn BackendDriverDispatchMinPhaseMemoryDeltaBytes(beforeBytes: int64,
                                                 afterBytes: int64): int64 =
    if beforeBytes < int64(0) || afterBytes < int64(0):
        return int64(-1)
    return afterBytes - beforeBytes

@borrows
fn BackendDriverDispatchMinSourceClosureStructuredLiveBytes(sourcePaths: str[],
                                                           identityPaths: str[],
                                                           importEdgeCount: int32): int64 =
    var total = int64(sourcePaths.len) * int64(24)
    for i in 0..<sourcePaths.len:
        total = total + int64(len(sourcePaths[i]))
    total = total + int64(identityPaths.len) * int64(24)
    for identityIndex in 0..<identityPaths.len:
        total = total + int64(len(identityPaths[identityIndex]))
    total = total + int64(importEdgeCount) * int64(16)
    return total

@borrows
fn BackendDriverDispatchMinReportPayloadStructuredLiveBytes(reportText: str): int64 =
    return int64(24) + int64(len(reportText))

@borrows
fn BackendDriverDispatchMinRecordSourceClosureAfter(sourcePaths: str[],
                                                    identityPaths: str[],
                                                    importEdgeCount: int32) =
    let structuredBytes = BackendDriverDispatchMinSourceClosureStructuredLiveBytes(sourcePaths,
                                                                                    identityPaths,
                                                                                    importEdgeCount)
    backendDriverDispatchMinSourceClosureRssAfterBytes = BackendDriverDispatchMinCurrentRssBytes()
    backendDriverDispatchMinSourceClosureStructuredAfterBytes = structuredBytes
    backendDriverDispatchMinSourceClosureGapAfterBytes = BackendDriverDispatchMinPhaseMemoryGapBytes(backendDriverDispatchMinSourceClosureRssAfterBytes, structuredBytes)

fn BackendDriverDispatchMinRecordCompilerCsgBefore(linkPlan: var slplan.SystemLinkPlanStub) =
    let structuredBytes = BackendDriverDispatchMinSourceClosureStructuredLiveBytes(linkPlan.sourceClosurePaths,
                                                                                  linkPlan.sourceBundleIdentityPaths,
                                                                                  linkPlan.importEdgeCount)
    backendDriverDispatchMinCompilerCsgRssBeforeBytes = BackendDriverDispatchMinCurrentRssBytes()
    backendDriverDispatchMinCompilerCsgStructuredBeforeBytes = structuredBytes
    backendDriverDispatchMinCompilerCsgGapBeforeBytes = BackendDriverDispatchMinPhaseMemoryGapBytes(backendDriverDispatchMinCompilerCsgRssBeforeBytes, structuredBytes)

fn BackendDriverDispatchMinRecordReportPayloadAssemblyBefore() =
    let structuredBytes = int64(0)
    backendDriverDispatchMinReportPayloadAssemblyRssBeforeBytes = BackendDriverDispatchMinCurrentRssBytes()
    backendDriverDispatchMinReportPayloadAssemblyStructuredBeforeBytes = structuredBytes
    backendDriverDispatchMinReportPayloadAssemblyGapBeforeBytes = BackendDriverDispatchMinPhaseMemoryGapBytes(backendDriverDispatchMinReportPayloadAssemblyRssBeforeBytes, structuredBytes)

@borrows
fn BackendDriverDispatchMinRecordReportPayloadAssemblyAfter(reportText: str) =
    let beforeStructured = backendDriverDispatchMinReportPayloadAssemblyStructuredBeforeBytes
    var reportStructured = BackendDriverDispatchMinReportPayloadStructuredLiveBytes(reportText)
    if backendDriverDispatchMinReportBuilderActive:
        reportStructured = BackendDriverDispatchMinReportBuilderStructuredLiveBytes()
    let structuredBytes = beforeStructured + reportStructured
    backendDriverDispatchMinReportPayloadAssemblyRssAfterBytes = BackendDriverDispatchMinCurrentRssBytes()
    backendDriverDispatchMinReportPayloadAssemblyStructuredAfterBytes = structuredBytes
    backendDriverDispatchMinReportPayloadAssemblyGapAfterBytes = BackendDriverDispatchMinPhaseMemoryGapBytes(backendDriverDispatchMinReportPayloadAssemblyRssAfterBytes, structuredBytes)

fn BackendDriverDispatchMinRecordCsgTopContributor(kind: str,
                                                   count: int32,
                                                   bytes: int64) =
    if bytes > backendDriverDispatchMinCsgTop0Bytes:
        backendDriverDispatchMinCsgTop2Count = backendDriverDispatchMinCsgTop1Count
        backendDriverDispatchMinCsgTop2Bytes = backendDriverDispatchMinCsgTop1Bytes
        backendDriverDispatchMinCsgTop1Count = backendDriverDispatchMinCsgTop0Count
        backendDriverDispatchMinCsgTop1Bytes = backendDriverDispatchMinCsgTop0Bytes
        backendDriverDispatchMinCsgTop0Count = count
        backendDriverDispatchMinCsgTop0Bytes = bytes
        return
    if bytes > backendDriverDispatchMinCsgTop1Bytes:
        backendDriverDispatchMinCsgTop2Count = backendDriverDispatchMinCsgTop1Count
        backendDriverDispatchMinCsgTop2Bytes = backendDriverDispatchMinCsgTop1Bytes
        backendDriverDispatchMinCsgTop1Count = count
        backendDriverDispatchMinCsgTop1Bytes = bytes
        return
    if bytes > backendDriverDispatchMinCsgTop2Bytes:
        backendDriverDispatchMinCsgTop2Count = count
        backendDriverDispatchMinCsgTop2Bytes = bytes

fn BackendDriverDispatchMinRecordPrimaryTopContributor(kind: str,
                                                       count: int32,
                                                       bytes: int64) =
    if bytes > backendDriverDispatchMinPrimaryTop0Bytes:
        backendDriverDispatchMinPrimaryTop2Count = backendDriverDispatchMinPrimaryTop1Count
        backendDriverDispatchMinPrimaryTop2Bytes = backendDriverDispatchMinPrimaryTop1Bytes
        backendDriverDispatchMinPrimaryTop1Count = backendDriverDispatchMinPrimaryTop0Count
        backendDriverDispatchMinPrimaryTop1Bytes = backendDriverDispatchMinPrimaryTop0Bytes
        backendDriverDispatchMinPrimaryTop0Count = count
        backendDriverDispatchMinPrimaryTop0Bytes = bytes
        return
    if bytes > backendDriverDispatchMinPrimaryTop1Bytes:
        backendDriverDispatchMinPrimaryTop2Count = backendDriverDispatchMinPrimaryTop1Count
        backendDriverDispatchMinPrimaryTop2Bytes = backendDriverDispatchMinPrimaryTop1Bytes
        backendDriverDispatchMinPrimaryTop1Count = count
        backendDriverDispatchMinPrimaryTop1Bytes = bytes
        return
    if bytes > backendDriverDispatchMinPrimaryTop2Bytes:
        backendDriverDispatchMinPrimaryTop2Count = count
        backendDriverDispatchMinPrimaryTop2Bytes = bytes

fn BackendDriverDispatchMinAppendPhaseMemorySnapshotReport(out: var str,
                                                           phaseName: str,
                                                           rssBeforeBytes: int64,
                                                           rssAfterBytes: int64,
                                                           structuredBeforeBytes: int64,
                                                           structuredAfterBytes: int64,
                                                           gapBeforeBytes: int64,
                                                           gapAfterBytes: int64) =
    let prefix = strutil.Join(["phase_memory_ledger_", phaseName, "_"], "")
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "rss_before_bytes=", strings.Int64ToStr(rssBeforeBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "rss_after_bytes=", strings.Int64ToStr(rssAfterBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "rss_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(rssBeforeBytes, rssAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "structured_before_bytes=", strings.Int64ToStr(structuredBeforeBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "structured_after_bytes=", strings.Int64ToStr(structuredAfterBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "structured_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(structuredBeforeBytes, structuredAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "unstructured_gap_before_bytes=", strings.Int64ToStr(gapBeforeBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "unstructured_gap_after_bytes=", strings.Int64ToStr(gapAfterBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join([strings.CloneStr(prefix), "unstructured_gap_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(gapBeforeBytes, gapAfterBytes))], ""))

fn BackendDriverDispatchMinAppendPhaseMemoryLedgerReport(out: var str) =
    BackendDriverDispatchMinRecordReportPayloadAssemblyAfter(out)
    BackendDriverDispatchMinAppendLine(out, "phase_memory_ledger_schema=phase_delta_ledger")
    BackendDriverDispatchMinAppendLine(out, "phase_memory_ledger_phase_count=5")
    BackendDriverDispatchMinAppendPhaseMemorySnapshotReport(out, "source_closure", backendDriverDispatchMinSourceClosureRssBeforeBytes, backendDriverDispatchMinSourceClosureRssAfterBytes, backendDriverDispatchMinSourceClosureStructuredBeforeBytes, backendDriverDispatchMinSourceClosureStructuredAfterBytes, backendDriverDispatchMinSourceClosureGapBeforeBytes, backendDriverDispatchMinSourceClosureGapAfterBytes)
    BackendDriverDispatchMinAppendPhaseMemorySnapshotReport(out, "compiler_csg", backendDriverDispatchMinCompilerCsgRssBeforeBytes, backendDriverDispatchMinCompilerCsgRssAfterBytes, backendDriverDispatchMinCompilerCsgStructuredBeforeBytes, backendDriverDispatchMinCompilerCsgStructuredAfterBytes, backendDriverDispatchMinCompilerCsgGapBeforeBytes, backendDriverDispatchMinCompilerCsgGapAfterBytes)
    BackendDriverDispatchMinAppendPhaseMemorySnapshotReport(out, "lowering_plan", backendDriverDispatchMinLoweringPlanRssBeforeBytes, backendDriverDispatchMinLoweringPlanRssAfterBytes, backendDriverDispatchMinLoweringPlanStructuredBeforeBytes, backendDriverDispatchMinLoweringPlanStructuredAfterBytes, backendDriverDispatchMinLoweringPlanGapBeforeBytes, backendDriverDispatchMinLoweringPlanGapAfterBytes)
    BackendDriverDispatchMinAppendPhaseMemorySnapshotReport(out, "primary_object_plan", backendDriverDispatchMinPrimaryObjectPlanRssBeforeBytes, backendDriverDispatchMinPrimaryObjectPlanRssAfterBytes, backendDriverDispatchMinPrimaryObjectPlanStructuredBeforeBytes, backendDriverDispatchMinPrimaryObjectPlanStructuredAfterBytes, backendDriverDispatchMinPrimaryObjectPlanGapBeforeBytes, backendDriverDispatchMinPrimaryObjectPlanGapAfterBytes)
    BackendDriverDispatchMinAppendPhaseMemorySnapshotReport(out, "report_payload_assembly", backendDriverDispatchMinReportPayloadAssemblyRssBeforeBytes, backendDriverDispatchMinReportPayloadAssemblyRssAfterBytes, backendDriverDispatchMinReportPayloadAssemblyStructuredBeforeBytes, backendDriverDispatchMinReportPayloadAssemblyStructuredAfterBytes, backendDriverDispatchMinReportPayloadAssemblyGapBeforeBytes, backendDriverDispatchMinReportPayloadAssemblyGapAfterBytes)
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_source_closure_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinSourceClosureStructuredAfterBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_source_closure_rss_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinSourceClosureRssBeforeBytes, backendDriverDispatchMinSourceClosureRssAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_source_closure_gap_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinSourceClosureGapBeforeBytes, backendDriverDispatchMinSourceClosureGapAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_csg_graph_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinCompilerCsgNodesLiveBytes + backendDriverDispatchMinCompilerCsgEdgesLiveBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_expr_layer_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinCompilerCsgExprLayerLiveBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_typed_facts_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinCompilerCsgTypedFactsLiveBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_typed_ir_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinCompilerCsgTypedIrLiveBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_compiler_csg_rss_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinCompilerCsgRssBeforeBytes, backendDriverDispatchMinCompilerCsgRssAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_compiler_csg_gap_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinCompilerCsgGapBeforeBytes, backendDriverDispatchMinCompilerCsgGapAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_lowering_plan_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinLoweringPlanStructuredAfterBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_lowering_plan_rss_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinLoweringPlanRssBeforeBytes, backendDriverDispatchMinLoweringPlanRssAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_lowering_plan_gap_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinLoweringPlanGapBeforeBytes, backendDriverDispatchMinLoweringPlanGapAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_primary_object_plan_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinPrimaryObjectPlanStructuredAfterBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_primary_object_plan_rss_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinPrimaryObjectPlanRssBeforeBytes, backendDriverDispatchMinPrimaryObjectPlanRssAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_primary_object_plan_gap_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinPrimaryObjectPlanGapBeforeBytes, backendDriverDispatchMinPrimaryObjectPlanGapAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_report_payload_assembly_structured_bytes=", strings.Int64ToStr(backendDriverDispatchMinReportPayloadAssemblyStructuredAfterBytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_report_payload_assembly_rss_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinReportPayloadAssemblyRssBeforeBytes, backendDriverDispatchMinReportPayloadAssemblyRssAfterBytes))], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["compiler_csg_phase_report_payload_assembly_gap_delta_bytes=", strings.Int64ToStr(BackendDriverDispatchMinPhaseMemoryDeltaBytes(backendDriverDispatchMinReportPayloadAssemblyGapBeforeBytes, backendDriverDispatchMinReportPayloadAssemblyGapAfterBytes))], ""))
    # [c-line retain-ledger] Pull the real top contributors the ccsg merge
    # loop accumulated; the globals below were write-only before this, so the
    # ledger printed zeros and empty kinds.
    var ledgerCsgKind0: int32
    var ledgerCsgBlocks0: int64
    var ledgerCsgBytes0: int64
    var ledgerCsgKind1: int32
    var ledgerCsgBlocks1: int64
    var ledgerCsgBytes1: int64
    var ledgerCsgKind2: int32
    var ledgerCsgBlocks2: int64
    var ledgerCsgBytes2: int64
    ccsg.CompilerCsgPhaseMemoryRetainTopContributors(
        ledgerCsgKind0, ledgerCsgBlocks0, ledgerCsgBytes0,
        ledgerCsgKind1, ledgerCsgBlocks1, ledgerCsgBytes1,
        ledgerCsgKind2, ledgerCsgBlocks2, ledgerCsgBytes2)
    backendDriverDispatchMinCsgTop0Kind =
        ccsg.CompilerCsgPhaseMemoryRetainKindName(ledgerCsgKind0)
    backendDriverDispatchMinCsgTop0Count = int32(ledgerCsgBlocks0)
    backendDriverDispatchMinCsgTop0Bytes = ledgerCsgBytes0
    backendDriverDispatchMinCsgTop1Kind =
        ccsg.CompilerCsgPhaseMemoryRetainKindName(ledgerCsgKind1)
    backendDriverDispatchMinCsgTop1Count = int32(ledgerCsgBlocks1)
    backendDriverDispatchMinCsgTop1Bytes = ledgerCsgBytes1
    backendDriverDispatchMinCsgTop2Kind =
        ccsg.CompilerCsgPhaseMemoryRetainKindName(ledgerCsgKind2)
    backendDriverDispatchMinCsgTop2Count = int32(ledgerCsgBlocks2)
    backendDriverDispatchMinCsgTop2Bytes = ledgerCsgBytes2
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_0_kind=", strings.CloneStr(backendDriverDispatchMinCsgTop0Kind)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_0_count=", strings.IntToStr(backendDriverDispatchMinCsgTop0Count)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_0_bytes=", strings.Int64ToStr(backendDriverDispatchMinCsgTop0Bytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_1_kind=", strings.CloneStr(backendDriverDispatchMinCsgTop1Kind)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_1_count=", strings.IntToStr(backendDriverDispatchMinCsgTop1Count)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_1_bytes=", strings.Int64ToStr(backendDriverDispatchMinCsgTop1Bytes)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_2_kind=", strings.CloneStr(backendDriverDispatchMinCsgTop2Kind)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_2_count=", strings.IntToStr(backendDriverDispatchMinCsgTop2Count)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_compiler_csg_top_contributor_2_bytes=", strings.Int64ToStr(backendDriverDispatchMinCsgTop2Bytes)], ""))
    BackendDriverDispatchMinAppendLine(out, "phase_memory_ledger_primary_object_plan_top_contributor_0_kind=")
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_primary_object_plan_top_contributor_0_count=", strings.IntToStr(backendDriverDispatchMinPrimaryTop0Count)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_primary_object_plan_top_contributor_0_bytes=", strings.Int64ToStr(backendDriverDispatchMinPrimaryTop0Bytes)], ""))
    BackendDriverDispatchMinAppendLine(out, "phase_memory_ledger_primary_object_plan_top_contributor_1_kind=")
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_primary_object_plan_top_contributor_1_count=", strings.IntToStr(backendDriverDispatchMinPrimaryTop1Count)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_primary_object_plan_top_contributor_1_bytes=", strings.Int64ToStr(backendDriverDispatchMinPrimaryTop1Bytes)], ""))
    BackendDriverDispatchMinAppendLine(out, "phase_memory_ledger_primary_object_plan_top_contributor_2_kind=")
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_primary_object_plan_top_contributor_2_count=", strings.IntToStr(backendDriverDispatchMinPrimaryTop2Count)], ""))
    BackendDriverDispatchMinAppendLine(out, strutil.Join(["phase_memory_ledger_primary_object_plan_top_contributor_2_bytes=", strings.Int64ToStr(backendDriverDispatchMinPrimaryTop2Bytes)], ""))

fn BackendDriverDispatchMinAppendOutputFileSizeReport(out: var str,
                                                       rootDir: str,
                                                       outputPath: str) =
    let outputAbs = chengpath.PathAbsolute(rootDir, outputPath)
    var outputBytes: int64
    if chengpath.PathFileExists(outputAbs):
        outputBytes = chengpath.PathFileSize(outputAbs)
    BackendDriverDispatchMinAppendLine(out, Fmt"output_file_size_bytes={outputBytes}")

# bail=631 fmt_eval 根因: Fmt 直接作 seq-add 值不被 pure path 接管; Fmt 在调用实参位
# 与平变量 Fmt 赋值位均为已验证净形 (AppendLine 同形), 故行缓冲走此 helper 而非 add(rows, Fmt).
fn BackendDriverDispatchMinAppendMissingFunctionRow(out: var str,
                                                    row: str) =
    if len(out) > 0:
        out = Fmt"{out};;"
    out = Fmt"{out}{row}"

@borrows
fn BackendDriverDispatchMinCloneStrSeq(src: str[]): str[] =
    var out: str[]
    for i in 0..<src.len:
        add(out, strings.CloneStr(src[i]))
    return out

fn BackendDriverDispatchMinCsv(items: str[]): str =
    return strutil.Join(items, ",")

fn BackendDriverDispatchMinSplitCsv(text: str): str[] =
    var out: str[]
    let parts = strutil.Split(text, ',')
    for i in 0..<parts.len:
        let item = strutil.Strip(parts[i])
        if len(item) > 0:
            add(out, item)
    return out

fn BackendDriverDispatchMinTargetSymbolIs(symbol: str,
                                           publicName: str): bool =
    if symbol == publicName:
        return true
    if len(symbol) != len(publicName) + 1:
        return false
    if symbol[0] != '_':
        return false
    for i in 0..<len(publicName):
        if symbol[i + 1] != publicName[i]:
            return false
    return true

@borrows
@borrow_result
fn BackendDriverDispatchMinPublicRootName(symbol: str): str =
    if len(symbol) > 1 && symbol[0] == '_':
        return strings.DropPrefix(symbol, "_")
    return symbol

@borrows
fn BackendDriverDispatchMinProgramSupportHostRuntimeOwns(symbol: str): bool =
    return BackendDriverDispatchMinPublicRootName(symbol) == "cheng_seq_drop_str_field_tail"

@borrows
fn BackendDriverDispatchMinPlanHasProviderModule(linkPlan: var slplan.SystemLinkPlanStub,
                                                  modulePath: str): bool =
    for i in 0..<linkPlan.providerModules.len:
        if linkPlan.providerModules[i] == modulePath:
            return true
    return false

fn BackendDriverDispatchMinAddProviderModuleUnique(linkPlan: var slplan.SystemLinkPlanStub,
                                                   modulePath: str) =
    if !BackendDriverDispatchMinPlanHasProviderModule(linkPlan, modulePath):
        add(linkPlan.providerModules, modulePath)

fn BackendDriverDispatchMinEnsureDarwinProviderRuntimeModules(linkPlan: var slplan.SystemLinkPlanStub) =
    BackendDriverDispatchMinAddProviderModuleUnique(linkPlan, "runtime/core_runtime")
    BackendDriverDispatchMinAddProviderModuleUnique(linkPlan, "runtime/debug_runtime")
    BackendDriverDispatchMinAddProviderModuleUnique(linkPlan, "runtime/program_support")
    BackendDriverDispatchMinAddProviderModuleUnique(linkPlan, "runtime/program_support_get_env_bridge")
    BackendDriverDispatchMinAddProviderModuleUnique(linkPlan, "runtime/program_support_host_runtime")

@borrows
fn BackendDriverDispatchMinParseUnsignedInt64(raw: str): int64 =
    if len(raw) <= 0:
        return int64(-1)
    var value: uint64
    var hadDigit: bool
    for i in 0..<len(raw):
        let ch = raw[i]
        if ch >= '0' && ch <= '9':
            let digit: uint64 = uint64(int32(ch) - int32('0'))
            if value > uint64(1844674407370955161):
                return int64(-1)
            if value == uint64(1844674407370955161) && digit > uint64(5):
                return int64(-1)
            value = value * uint64(10) + digit
            hadDigit = true
        else:
            return int64(-1)
    if !hadDigit:
        return int64(-1)
    if value > uint64(9223372036854775807):
        return int64(-1)
    return int64(value)

fn BackendDriverDispatchMinDefaultMaxRssBytes(): int64 =
    return int64(805306368)

fn BackendDriverDispatchMinConfiguredMaxRssBytes(): int64 =
    let chengParentGuardRaw = os.GetEnv("CHENG_PARENT_RSS_GUARD")
    if strings.Len(os.GetEnv("PARENT_RSS_GUARD")) > 0 ||
       strings.Len(os.GetEnv("PROCESS_MAX_RSS_BYTES")) > 0 ||
       strings.Len(os.GetEnv("CHENG_MAX_RSS_BYTES")) > 0 ||
       strings.Len(os.GetEnv("MAX_RSS_BYTES")) > 0:
        return int64(-1)
    if strings.Len(chengParentGuardRaw) > 0:
        return int64(0)
    var raw = os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES")
    if strings.Len(raw) <= 0:
        return BackendDriverDispatchMinDefaultMaxRssBytes()
    let parsed = BackendDriverDispatchMinParseUnsignedInt64(raw)
    if parsed <= int64(0):
        return int64(-1)
    return parsed

fn BackendDriverDispatchMinCurrentRssBytes(): int64 =
    # os.ProcessRssBytes normalizes ru_maxrss to bytes (Linux reports KiB, Darwin bytes).
    return os.ProcessRssBytes()

fn BackendDriverDispatchMinCurrentCpuUs(): int64 =
    var usage: BackendDriverDispatchMinRusage
    if BackendDriverDispatchMinGetrusageBridge(0, usage) != 0:
        return int64(-1)
    var userUs = usage.ru_utime.tv_sec
    userUs = userUs * int64(1000000)
    userUs = userUs + usage.ru_utime.tv_usec
    var sysUs = usage.ru_stime.tv_sec
    sysUs = sysUs * int64(1000000)
    sysUs = sysUs + usage.ru_stime.tv_usec
    return userUs + sysUs

fn BackendDriverDispatchMinMemoryLimitExceededLine(rssBytes: int64,
                                                    maxRssBytes: int64): str =
    return Fmt"compile_progress phase=resource_guard status=rss_limit_exceeded rss_bytes={rssBytes} limit_bytes={maxRssBytes}"

fn BackendDriverDispatchMinResourceGuardCheckWithMax(maxRssBytes: int64) =
    if maxRssBytes == int64(0):
        return
    if maxRssBytes < int64(0):
        BackendDriverDispatchMinPrintErr("compile_progress phase=resource_guard status=invalid_max_rss")
        BackendDriverDispatchMinExitBridge(2)
    let rssBytes = BackendDriverDispatchMinCurrentRssBytes()
    if rssBytes <= int64(0):
        BackendDriverDispatchMinPrintErr("compile_progress phase=resource_guard status=rss_unavailable")
        BackendDriverDispatchMinExitBridge(BackendDriverDispatchMinProcessMemoryExceeded)
    if rssBytes > maxRssBytes:
        BackendDriverDispatchMinPrintErr(BackendDriverDispatchMinMemoryLimitExceededLine(rssBytes, maxRssBytes))
        BackendDriverDispatchMinExitBridge(BackendDriverDispatchMinProcessMemoryExceeded)

fn BackendDriverDispatchMinProgressResourceGuardCheck() =
    let maxRssBytes = BackendDriverDispatchMinConfiguredMaxRssBytes()
    BackendDriverDispatchMinResourceGuardCheckWithMax(maxRssBytes)

fn BackendDriverDispatchMinProgressEnabled(): bool =
    if BackendDriverDispatchMinTruthyFlag("--progress"):
        return true
    var raw = os.GetEnv("CHENG_PROGRESS")
    if len(raw) <= 0:
        raw = os.GetEnv("CHENG_DISPATCH_MIN_PROGRESS")
    if len(raw) <= 0:
        raw = os.GetEnv("PROGRESS")
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

fn BackendDriverDispatchMinTruthyEnv(name: str): bool =
    let raw = os.GetEnv(name)
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

@borrows
fn BackendDriverDispatchMinTruthyText(raw: str): bool =
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

fn BackendDriverDispatchMinTruthyFlag(flagName: str): bool =
    let count = BackendDriverDispatchMinParamCount()
    if count < 1:
        return false
    for i in 1..count:
        var arg: str
        BackendDriverDispatchMinParamStrInto(i, arg)
        if arg == flagName:
            return true
        if strutil.StartsWith(arg, Fmt"{flagName}:") ||
           strutil.StartsWith(arg, Fmt"{flagName}="):
            let raw = strings.SliceBytes(arg, len(flagName) + 1, len(arg) - len(flagName) - 1)
            return BackendDriverDispatchMinTruthyText(raw)
    return false

fn BackendDriverDispatchMinRequirePureSystemLinkExec(): bool =
    if BackendDriverDispatchMinTruthyEnv("CHENG_REQUIRE_PURE_SYSTEM_LINK_EXEC"):
        return true
    return BackendDriverDispatchMinTruthyFlag("--require-pure-system-link-exec")

@borrows
fn BackendDriverDispatchMinPureProvenanceReportPath(rootDir: str): str =
    return chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng.report.txt")

fn BackendDriverDispatchMinPureProvenanceReady(rootDir: str): bool =
    let reportPath = BackendDriverDispatchMinPureProvenanceReportPath(rootDir)
    let report = chengpath.ReadTextFile(rootDir, reportPath)
    if len(report) <= 0:
        return false
    if !strings.StrContains(report, "full_backend_codegen=1"):
        return false
    if strings.StrContains(report, "full_backend_codegen=0"):
        return false
    if strings.StrContains(report, "compiler_class=cold_bootstrap"):
        return false
    if !strings.StrContains(report, "compiler_class=ordinary_compiler"):
        return false
    if strings.StrContains(report, "candidate_kind=cold_subset_backend"):
        return false
    if strings.StrContains(report, "backend_driver_candidate=cold_subset_backend"):
        return false
    if strings.StrContains(report, "system_link_exec_scope=cold_subset_direct_macho"):
        return false
    return true

@borrows
fn BackendDriverDispatchMinPathHasSegmentSuffix(path: str,
                                                 suffix: str): bool =
    if len(path) < len(suffix):
        return false
    let start = len(path) - len(suffix)
    if strings.SliceBytes(path, start, len(suffix)) != suffix:
        return false
    if start == 0:
        return true
    let sep = path[start - 1]
    return sep == '/' || sep == '\\'

fn BackendDriverDispatchMinProgress(phase: str,
                                     status: str): int32 =
    if BackendDriverDispatchMinProgressEnabled():
        let rssBytes = BackendDriverDispatchMinCurrentRssBytes()
        let maxRssBytes = BackendDriverDispatchMinConfiguredMaxRssBytes()
        BackendDriverDispatchMinPrintErr(Fmt"compile_progress phase={phase} status={status} rss_bytes={rssBytes} limit_bytes={maxRssBytes}")
    BackendDriverDispatchMinProgressResourceGuardCheck()
    return 0

fn BackendDriverDispatchMinUnsupported(reason: str): int32 =
    BackendDriverDispatchMinPrintErr(reason)
    return 2

@borrows
fn BackendDriverDispatchMinStartsWith(text: str,
                                       prefix: str): bool =
    if len(prefix) > len(text):
        return false
    for i in 0..<len(prefix):
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn BackendDriverDispatchMinPathIsCompilerMain(path: str): bool =
    let suffix = "src/core/tooling/compiler_main.cheng"
    if len(path) < len(suffix):
        return false
    let start = len(path) - len(suffix)
    if strings.SliceBytes(path, start, len(suffix)) != suffix:
        return false
    if start == 0:
        return true
    let sep = path[start - 1]
    return sep == '/' || sep == '\\'

fn BackendDriverDispatchMinForbidLargeClosureMaterialize(rootDir: str,
                                                         reportPath: str,
                                                         sourcePath: str,
                                                         targetTriple: str,
                                                         emitText: str): bool =
    if !BackendDriverDispatchMinPathIsCompilerMain(sourcePath):
        return false
    let reason = Fmt"backend driver direct system-link-exec: refusing compiler_main.cheng large-closure materialize; use backend_driver_dispatch_min.cheng, a small fixture, dry-compile, or an existing report diagnostic"
    let _ = BackendDriverDispatchMinWriteGateBlockerReport(rootDir,
                                                           reportPath,
                                                           "forbidden_large_closure_materialize_entry",
                                                           "full_backend_codegen_materialize_policy",
                                                           targetTriple,
                                                           emitText,
                                                           reason)
    BackendDriverDispatchMinPrintErr(reason)
    return true

@borrows
fn BackendDriverDispatchMinSliceCopyInto(text: str,
                                          start: int32,
                                          count: int32,
                                          out: var str) =
    out = ""
    if count <= 0:
        return
    if start < 0:
        return
    if start >= len(text):
        return
    var kept = count
    if start + kept > len(text):
        kept = len(text) - start
    for i in 0..<kept:
        out = strings.ConcatStr(out, strings.CharToStr(text[start + i]))

fn BackendDriverDispatchMinFlagValueExact(raw: str,
                                           key: str): str =
    var out: str
    BackendDriverDispatchMinFlagValueExactInto(raw, key, out)
    return out

@borrows
fn BackendDriverDispatchMinFlagValueExactInto(raw: str,
                                               key: str,
                                               out: var str): bool =
    out = ""
    let colonKey = Fmt"{key}:"
    if BackendDriverDispatchMinStartsWith(raw, colonKey):
        BackendDriverDispatchMinSliceCopyInto(raw,
                                               len(colonKey),
                                               len(raw) - len(colonKey),
                                               out)
        return true
    let eqKey = Fmt"{key}="
    if BackendDriverDispatchMinStartsWith(raw, eqKey):
        BackendDriverDispatchMinSliceCopyInto(raw,
                                               len(eqKey),
                                               len(raw) - len(eqKey),
                                               out)
        return true
    return false

@borrows
fn BackendDriverDispatchMinFlagHasInlineValue(raw: str,
                                               key: str): bool =
    let colonKey = Fmt"{key}:"
    if BackendDriverDispatchMinStartsWith(raw, colonKey):
        return true
    let eqKey = Fmt"{key}="
    return BackendDriverDispatchMinStartsWith(raw, eqKey)

@borrows
fn BackendDriverDispatchMinEmitKindCode(raw: str): int32 =
    if raw == "exe":
        return 0
    if raw == "obj":
        return 1
    if raw == "shared":
        return 2
    return -1

fn BackendDriverDispatchMinEmitKindText(kind: int32): str =
    if kind == creq.CompilerEmitExeValue():
        return "exe"
    if kind == creq.CompilerEmitObjValue():
        return "obj"
    if kind == creq.CompilerEmitSharedValue():
        return "shared"
    return "unknown"

fn BackendDriverDispatchMinEmitTextSupported(raw: str): bool =
    if raw == "exe":
        return true
    if raw == "obj":
        return true
    if raw == "shared":
        return true
    return false

fn BackendDriverDispatchMinEmitTextIsObj(raw: str): bool =
    return raw == "obj"

fn BackendDriverDispatchMinEmitTextIsShared(raw: str): bool =
    return raw == "shared"

fn BackendDriverDispatchMinSymbolVisibilityValue(raw: str): str =
    if len(raw) <= 0:
        return "public"
    return raw

@borrows
fn BackendDriverDispatchMinSymbolVisibilitySupported(raw: str): bool =
    if len(raw) <= 0:
        return true
    if raw == "public":
        return true
    if raw == "internal":
        return true
    return false

fn BackendDriverDispatchMinCollectArgsFrom(startIndex: int32,
                                            count: int32): str[] =
    var out: str[]
    if startIndex <= 0:
        return out
    if count < startIndex:
        return out
    for i in startIndex..<count:
        var arg: str
        BackendDriverDispatchMinParamStrInto(i, arg)
        add(out, arg)
    return out

fn BackendDriverDispatchMinReadFlagOrDefault(key: str,
                                              defaultValue: str): str =
    var out: str
    out = defaultValue
    let count = BackendDriverDispatchMinParamCount()
    if count > 1:
        for i in 2..count:
            var raw: str
            BackendDriverDispatchMinParamStrInto(i, raw)
            if BackendDriverDispatchMinFlagHasInlineValue(raw, key):
                BackendDriverDispatchMinFlagValueExactInto(raw, key, out)
                return out
            if raw == key:
                if i < count:
                    BackendDriverDispatchMinParamStrInto(i + 1, out)
                    return out
                return out
    return out

@borrows
fn BackendDriverDispatchMinFlagPresent(key: str): bool =
    let count = BackendDriverDispatchMinParamCount()
    if count <= 1:
        return false
    for i in 2..count:
        var raw: str
        BackendDriverDispatchMinParamStrInto(i, raw)
        if raw == key ||
           BackendDriverDispatchMinFlagHasInlineValue(raw, key):
            return true
    return false

@borrows
fn BackendDriverDispatchMinFlagOccurrenceCount(key: str): int32 =
    var out: int32
    let count = BackendDriverDispatchMinParamCount()
    if count <= 1:
        return out
    for i in 2..count:
        var raw: str
        BackendDriverDispatchMinParamStrInto(i, raw)
        if raw == key ||
           BackendDriverDispatchMinFlagHasInlineValue(raw, key):
            out = out + 1
    return out

@borrows
fn BackendDriverDispatchMinCanonicalFdFlagOccurrenceCount(
        key: str,
        canonicalValue: str): int32 =
    var out: int32
    let expected = Fmt"{key}:{canonicalValue}"
    let count = BackendDriverDispatchMinParamCount()
    if count <= 1:
        return out
    for i in 2..count:
        var raw: str
        BackendDriverDispatchMinParamStrInto(i, raw)
        if raw == expected:
            out = out + 1
    return out

@borrows
fn BackendDriverDispatchMinReadFlagCandidate(raw: str,
                                              next: str,
                                              key: str,
                                              out: var str): bool =
    if BackendDriverDispatchMinFlagHasInlineValue(raw, key):
        BackendDriverDispatchMinFlagValueExactInto(raw, key, out)
        return true
    if raw == key && next != "":
        out = NewStringCopy(next.data, len(next))
        return true
    return false

fn BackendDriverDispatchMinReadFlagOrDefaultInto(key: str,
                                                  defaultValue: str,
                                                  out: var str) =
    out = defaultValue
    var arg2: str
    BackendDriverDispatchMinParamStrInto(2, arg2)
    var arg3: str
    BackendDriverDispatchMinParamStrInto(3, arg3)
    if BackendDriverDispatchMinReadFlagCandidate(arg2, arg3, key, out):
        return
    var arg4: str
    BackendDriverDispatchMinParamStrInto(4, arg4)
    if BackendDriverDispatchMinReadFlagCandidate(arg3, arg4, key, out):
        return
    var arg5: str
    BackendDriverDispatchMinParamStrInto(5, arg5)
    if BackendDriverDispatchMinReadFlagCandidate(arg4, arg5, key, out):
        return
    var arg6: str
    BackendDriverDispatchMinParamStrInto(6, arg6)
    if BackendDriverDispatchMinReadFlagCandidate(arg5, arg6, key, out):
        return
    var arg7: str
    BackendDriverDispatchMinParamStrInto(7, arg7)
    if BackendDriverDispatchMinReadFlagCandidate(arg6, arg7, key, out):
        return
    var arg8: str
    BackendDriverDispatchMinParamStrInto(8, arg8)
    if BackendDriverDispatchMinReadFlagCandidate(arg7, arg8, key, out):
        return
    var arg9: str
    BackendDriverDispatchMinParamStrInto(9, arg9)
    if BackendDriverDispatchMinReadFlagCandidate(arg8, arg9, key, out):
        return
    var arg10: str
    BackendDriverDispatchMinParamStrInto(10, arg10)
    if BackendDriverDispatchMinReadFlagCandidate(arg9, arg10, key, out):
        return
    var arg11: str
    BackendDriverDispatchMinParamStrInto(11, arg11)
    if BackendDriverDispatchMinReadFlagCandidate(arg10, arg11, key, out):
        return
    var arg12: str
    BackendDriverDispatchMinParamStrInto(12, arg12)
    if BackendDriverDispatchMinReadFlagCandidate(arg11, arg12, key, out):
        return
    var arg13: str
    BackendDriverDispatchMinParamStrInto(13, arg13)
    if BackendDriverDispatchMinReadFlagCandidate(arg12, arg13, key, out):
        return
    var arg14: str
    BackendDriverDispatchMinParamStrInto(14, arg14)
    if BackendDriverDispatchMinReadFlagCandidate(arg13, arg14, key, out):
        return
    var arg15: str
    BackendDriverDispatchMinParamStrInto(15, arg15)
    if BackendDriverDispatchMinReadFlagCandidate(arg14, arg15, key, out):
        return
    if BackendDriverDispatchMinReadFlagCandidate(arg15, "", key, out):
        return

fn BackendDriverDispatchMinReadFlagOrDefaultPtrInto(key: str,
                                                     defaultValue: str,
                                                     out: var str) =
    out = defaultValue
    let count = BackendDriverDispatchMinParamCount()
    if count <= 1:
        return
    for i in 2..count:
        var raw: str
        BackendDriverDispatchMinParamStrInto(i, raw)
        if BackendDriverDispatchMinFlagHasInlineValue(raw, key):
            BackendDriverDispatchMinFlagValueExactInto(raw, key, out)
            return
        if raw == key:
            if i < count:
                BackendDriverDispatchMinParamStrInto(i + 1, out)
                return

fn BackendDriverDispatchMinReadFlagOrDefaultScalarInto(keyData: ptr,
                                                        keyLen: int32,
                                                        defaultData: ptr,
                                                        defaultLen: int32,
                                                        out: var str) =
    out = ""
    let raw = BackendDriverDispatchMinReadFlagRawPtrBridge(keyData, keyLen, defaultData, defaultLen)
    let rawLen = BackendDriverDispatchMinReadFlagRawLenBridge(keyData, keyLen, defaultData, defaultLen)
    if raw != nil && rawLen > 0:
        out = NewStringCopy(raw, rawLen)

fn BackendDriverDispatchMinReadFlagCodeInto(code: int32,
                                             out: var str) =
    out = ""
    let raw = BackendDriverDispatchMinReadFlagCodeRawPtrBridge(code)
    let rawLen = BackendDriverDispatchMinReadFlagCodeRawLenBridge(code)
    if raw != nil && rawLen > 0:
        out = NewStringCopy(raw, rawLen)

fn BackendDriverDispatchMinReadKnownFlagOrDefault(code: int32,
                                                   key: str,
                                                   defaultValue: str): str =
    var out: str
    BackendDriverDispatchMinReadFlagCodeInto(code, out)
    if len(out) > 0:
        return out
    return BackendDriverDispatchMinReadFlagOrDefault(key, defaultValue)

