import std/fs
import std/result
import std/strformat
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_exec_runtime as sexecrt

type
    StableFileContentIdentity =
        size: int64
        mode: int32
        device: uint64
        inode: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        changeVersion: uint64

@importc("open")
fn StableFileContentOpenReadBridge(path: cstring,
                                   flags: int32,
                                   mode: int32): int32

@importc("close")
fn StableFileContentCloseBridge(fd: int32): int32

@importc("cheng_host_fstat_identity")
fn StableFileContentFstatIdentityBridge(fd: int32,
                                        outSize: var int64,
                                        outMode: var int32,
                                        outDevice: var uint64,
                                        outInode: var uint64,
                                        outMtimeSec: var int64,
                                        outMtimeNsec: var int64,
                                        outCtimeSec: var int64,
                                        outCtimeNsec: var int64,
                                        outChangeVersion: var uint64): int32

fn StableFileContentIdentityRead(fd: int32,
                                 requireExecutable: bool,
                                 out: var StableFileContentIdentity): bool =
    if fd < 0:
        return false
    var next: StableFileContentIdentity
    let rc = StableFileContentFstatIdentityBridge(
        fd,
        next.size,
        next.mode,
        next.device,
        next.inode,
        next.mtimeSec,
        next.mtimeNsec,
        next.ctimeSec,
        next.ctimeNsec,
        next.changeVersion)
    if rc != 0 ||
       next.size <= 0 ||
       (next.mode & int32(61440)) != int32(32768) ||
       (requireExecutable && (next.mode & int32(73)) == 0) ||
       next.device == uint64(0) ||
       next.inode == uint64(0):
        return false
    out = next
    return true

fn StableFileContentIdentityEqual(left: StableFileContentIdentity,
                                  right: StableFileContentIdentity): bool =
    return left.size == right.size &&
           left.mode == right.mode &&
           left.device == right.device &&
           left.inode == right.inode &&
           left.mtimeSec == right.mtimeSec &&
           left.mtimeNsec == right.mtimeNsec &&
           left.ctimeSec == right.ctimeSec &&
           left.ctimeNsec == right.ctimeNsec &&
           left.changeVersion == right.changeVersion

fn StableFileContentSha256Into(path: str,
                               requireExecutable: bool,
                               outSha256: var layout.FixedBytes32,
                               err: var str): bool =
    let canonicalBeforeRes = fs.Realpath(path)
    if IsErr(canonicalBeforeRes) ||
       Value(canonicalBeforeRes) != path:
        err = "stable file content: path is not canonical"
        return false
    let fd = StableFileContentOpenReadBridge(
        StrToCStringTemp(path), int32(0), int32(0))
    if fd < 0:
        err = "stable file content: open failed"
        return false
    var before: StableFileContentIdentity
    var after: StableFileContentIdentity
    var digest: layout.FixedBytes32
    var pinnedOk =
        StableFileContentIdentityRead(
            fd, requireExecutable, before)
    if pinnedOk:
        pinnedOk =
            sexecrt.SystemLinkExecRuntimeFileSha256Into(
                "", Fmt"/dev/fd/{fd}", digest, err)
    if pinnedOk:
        pinnedOk =
            StableFileContentIdentityRead(
                fd, requireExecutable, after)
    let closeRc = StableFileContentCloseBridge(fd)
    if !pinnedOk ||
       closeRc != 0 ||
       !StableFileContentIdentityEqual(before, after):
        err = "stable file content: identity changed during pinned read"
        return false
    let verifyFd = StableFileContentOpenReadBridge(
        StrToCStringTemp(path), int32(0), int32(0))
    if verifyFd < 0:
        err = "stable file content: reopen failed"
        return false
    var current: StableFileContentIdentity
    let currentOk =
        StableFileContentIdentityRead(
            verifyFd, requireExecutable, current)
    let verifyCloseRc = StableFileContentCloseBridge(verifyFd)
    let canonicalAfterRes = fs.Realpath(path)
    if !currentOk ||
       verifyCloseRc != 0 ||
       IsErr(canonicalAfterRes) ||
       Value(canonicalAfterRes) != path ||
       !StableFileContentIdentityEqual(before, current):
        err = "stable file content: path identity is not stable"
        return false
    outSha256 = digest
    err = ""
    return true
