import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/world_resolver as wresolver
import cheng/core/tooling/cheng_lock as clock

type
    // Registry endpoint descriptor
    RegistryEndpoint =
        scheme: str
        path: str

    // Registry publish result
    RegistryPublishResult =
        packageId: str
        version: str
        publishPath: str
        receiptCidHex: str
        success: bool

fn RegistryEndpointParse(endpoint: str): Result[RegistryEndpoint] =
    // Expected formats: "file:///path/to/registry" or "https://registry.example.com"
    var out: RegistryEndpoint
    out.scheme = strings.CloneStr("")
    out.path = strings.CloneStr("")
    // Check for file:// prefix
    if strutil.StartsWith(endpoint, "file://"):
        out.scheme = strings.CloneStr("file")
        let afterScheme = chengpath.TextSlice(endpoint, 7, endpoint.len - 7)
        out.path = strings.CloneStr(afterScheme)
        return Ok[RegistryEndpoint](out)
    // Check for https:// prefix
    if strutil.StartsWith(endpoint, "https://"):
        out.scheme = strings.CloneStr("https")
        let afterScheme = chengpath.TextSlice(endpoint, 8, endpoint.len - 8)
        out.path = strings.CloneStr(afterScheme)
        return Ok[RegistryEndpoint](out)
    return Err[RegistryEndpoint](strutil.Join([" registry: unsupported endpoint scheme: ", strings.CloneStr(endpoint)], ""))

fn RegistryPublish(receipt: wresolver.WorldReceipt,
                    endpoint: str): Result[RegistryPublishResult] =
    let epRes = RegistryEndpointParse(endpoint)
    if IsErr(epRes):
        return Err[RegistryPublishResult](Error(epRes))
    let ep = Value(epRes)
    if ep.scheme != "file":
        return Err[RegistryPublishResult](strutil.Join([" registry: publish only supports file:// scheme, got: ", strings.CloneStr(ep.scheme)], ""))
    if receipt.entryCount <= 0:
        return Err[RegistryPublishResult](" registry: nothing to publish, empty receipt")
    // Build target publish directory: <path>/<packageId>/<version>/
    let pkgId = receipt.entries[0].packageId
    let pkgVersion = receipt.entries[0].version
    let pkgDirName = pkgId
    let versionDir = pkgVersion
    let publishDir = os.JoinPath(os.JoinPath(ep.path, pkgDirName), versionDir)
    // Create package directory structure
    if !chengpath.PathCreateDirAll(publishDir):
        return Err[RegistryPublishResult](strutil.Join([" registry: failed to create publish dir: ", publishDir], ""))
    // Write cheng-package.toml
    var pkgToml = strutil.Join(["package_id = \"", strings.CloneStr(pkgId), "\"\n"], "")
    pkgToml = strutil.Join([pkgToml, "version = \"", strings.CloneStr(pkgVersion), "\"\n"], "")
    pkgToml = strutil.Join([pkgToml, "module_prefix = \"", strings.CloneStr(receipt.entries[0].modulePrefix), "\"\n"], "")
    if receipt.entries[0].channel.len > 0:
        pkgToml = strutil.Join([pkgToml, "channel = \"", strings.CloneStr(receipt.entries[0].channel), "\"\n"], "")
    if !chengpath.WriteTextFile("", os.JoinPath(publishDir, "cheng-package.toml"), pkgToml):
        return Err[RegistryPublishResult](" registry: failed to write cheng-package.toml")
    // Write cheng.lock.toml from receipt
    var lock: clock.ChengLock
    lock.formatVersion = clock.ChengLockFormatVersionLatest
    lock.worldHeadCid = layout.FixedBytes32Hex(receipt.worldHeadCid)
    lock.channel = receipt.entries[0].channel
    lock.epoch = 0
    lock.compilerPackageId = "cheng/compiler"
    lock.compilerCid = layout.FixedBytes32Hex(receipt.snapshotCid)
    lock.stdlibPackageId = "cheng/stdlib"
    lock.stdlibCid = layout.FixedBytes32Hex(receipt.snapshotCid)
    lock.runtimePackageId = "cheng/runtime"
    lock.runtimeCid = layout.FixedBytes32Hex(receipt.snapshotCid)
    var packages: clock.ChengLockPackage[]
    for i in 0..<receipt.entries.len:
        add(packages, clock.ChengLockPackageMake(
            receipt.entries[i].packageId,
            receipt.entries[i].modulePrefix,
            receipt.entries[i].channel,
            receipt.entries[i].version,
            layout.FixedBytes32Hex(receipt.entries[i].cid),
            receipt.entries[i].checksum,
            "registry",
            "cheng"))
    lock.packages = packages
    lock.packageCount = packages.len
    let lockText = clock.ChengLockSerialize(lock)
    if !chengpath.WriteTextFile("", os.JoinPath(publishDir, "cheng.lock.toml"), lockText):
        return Err[RegistryPublishResult](" registry: failed to write cheng.lock.toml")
    var out: RegistryPublishResult
    out.packageId = pkgId
    out.version = pkgVersion
    out.publishPath = publishDir
    out.receiptCidHex = layout.FixedBytes32Hex(receipt.receiptCid)
    out.success = true
    return Ok[RegistryPublishResult](out)

fn RegistryFetch(packageName: str,
                  version: str,
                  endpoint: str): Result[wresolver.WorldReceipt] =
    let epRes = RegistryEndpointParse(endpoint)
    if IsErr(epRes):
        return Err[wresolver.WorldReceipt](Error(epRes))
    let ep = Value(epRes)
    if ep.scheme != "file":
        return Err[wresolver.WorldReceipt](strutil.Join([" registry: fetch only supports file:// scheme, got: ", strings.CloneStr(ep.scheme)], ""))
    // Build package directory path: <path>/<packageName>/<version>/
    let schemePath = strings.CloneStr(ep.path)
    let baseDir = os.JoinPath(schemePath, packageName)
    let pkgDir = os.JoinPath(baseDir, version)
    if !chengpath.PathDirExists(pkgDir):
        return Err[wresolver.WorldReceipt](strutil.Join([" registry: package not found at: ", pkgDir], ""))
    // Read cheng-package.toml for package metadata
    let pkgTomlPath = os.JoinPath(pkgDir, "cheng-package.toml")
    if !chengpath.PathFileExists(pkgTomlPath):
        return Err[wresolver.WorldReceipt](strutil.Join([" registry: missing cheng-package.toml in: ", pkgDir], ""))
    let pkgToml = chengpath.ReadTextFile("", pkgTomlPath)
    // Read cheng.lock.toml for lock data
    let lockPath = os.JoinPath(pkgDir, "cheng.lock.toml")
    if !chengpath.PathFileExists(lockPath):
        return Err[wresolver.WorldReceipt](strutil.Join([" registry: missing cheng.lock.toml in: ", pkgDir], ""))
    let lockRes = clock.ChengLockRead(pkgDir)
    if IsErr(lockRes):
        return Err[wresolver.WorldReceipt](strutil.Join([" registry: invalid lock file: ", strings.CloneStr(Error(lockRes))], ""))
    let lock = Value(lockRes)
    // Build receipt from lock and package dir
    var worldHeadCid = layout.FixedBytes32()
    let headCidRes = layout.FixedBytes32FromHex(lock.worldHeadCid)
    if IsErr(headCidRes):
        return Err[wresolver.WorldReceipt](strutil.Join([" registry: invalid world_head_cid in lock: ", strings.CloneStr(lock.worldHeadCid)], ""))
    worldHeadCid = Value(headCidRes)
    // Build snapshot entries from source files in src/ directory
    let srcDir = os.JoinPath(pkgDir, "src")
    var snapshotEntries: wresolver.WorldSnapshotEntry[]
    var receiptEntries: wresolver.WorldReceiptEntry[]
    if chengpath.PathDirExists(srcDir):
        let rawFiles = os.ListDir(srcDir)
        for i in 0..<rawFiles.len:
            let fileName = rawFiles[i]
            let fullSrcPath = os.JoinPath(srcDir, fileName)
            if !chengpath.PathFileExists(fullSrcPath):
                continue
            let text = chengpath.ReadTextFile("", fullSrcPath)
            let contentCid = wresolver.WorldResolveContentCid(text)
            let contentHash = wresolver.WorldResolveContentHash(text)
            let relPath = os.JoinPath("src", fileName)
            add(snapshotEntries, wresolver.WorldSnapshotEntryMake(relPath, contentCid, contentHash))
    let snapshotCid = wresolver.WorldResolveSnapshotCid(snapshotEntries)
    // Build receipt entries from lock packages
    for i in 0..<lock.packages.len:
        let pkg = lock.packages[i]
        var pkgCid = layout.FixedBytes32()
        let cidRes = layout.FixedBytes32FromHex(pkg.cid)
        if IsErr(cidRes):
            continue
        pkgCid = Value(cidRes)
        add(receiptEntries, wresolver.WorldReceiptEntryMake(
            pkg.packageId,
            pkg.modulePrefix,
            pkg.channel,
            pkg.version,
            pkgCid,
            pkg.checksum))
    let receiptCid = wresolver.WorldResolveReceiptCid(worldHeadCid, snapshotCid, receiptEntries)
    var out: wresolver.WorldReceipt
    out.version = 1
    out.worldHeadCid = worldHeadCid
    out.snapshotCid = snapshotCid
    out.entryCount = receiptEntries.len
    out.entries = receiptEntries
    out.receiptCid = receiptCid
    // Verify CID integrity: the receipt must self-verify
    if !wresolver.WorldVerify(out):
        return Err[wresolver.WorldReceipt](" registry: CID verification failed after fetch")
    return Ok[wresolver.WorldReceipt](out)

fn RegistryCidVerifyFetched(receipt: wresolver.WorldReceipt,
                              expectedChecksum: str): bool =
    let receiptCidHex = layout.FixedBytes32Hex(receipt.receiptCid)
    if expectedChecksum.len <= 0:
        return true
    return receiptCidHex == expectedChecksum

fn RegistryReadPackageTomlValue(packageDir: str, key: str): str =
    let tomlPath = os.JoinPath(packageDir, "cheng-package.toml")
    if !chengpath.PathFileExists(tomlPath):
        return ""
    let text = chengpath.ReadTextFile("", tomlPath)
    let lines = strutil.Split(text, '\n')
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        var matchedLine = false
        if line.len > key.len:
            if line[key.len] == '=':
                matchedLine = true
                for j in 0..<key.len:
                    if line[j] != key[j]:
                        matchedLine = false
                        break
        if matchedLine:
            let rawValue = strutil.Strip(chengpath.TextSlice(line, key.len + 1, line.len - (key.len + 1)))
            let valLen = rawValue.len
            if valLen >= 2:
                if rawValue[0] == '\"' && rawValue[valLen - 1] == '\"':
                    return chengpath.TextSlice(rawValue, 1, valLen - 2)
            return rawValue
    return ""

fn RegistryPublishPackage(packageDir: str, endpoint: str): Result[str] =
    if !chengpath.PathFileExists(os.JoinPath(packageDir, "cheng-package.toml")):
        return Err[str](" registry publish: no cheng-package.toml in package directory")
    let pkgId = RegistryReadPackageTomlValue(packageDir, "package_id")
    let pkgVersion = RegistryReadPackageTomlValue(packageDir, "version")
    let channel = RegistryReadPackageTomlValue(packageDir, "channel")
    let modulePrefix = RegistryReadPackageTomlValue(packageDir, "module_prefix")
    if pkgId.len <= 0:
        return Err[str](" registry publish: missing package_id in cheng-package.toml")
    if pkgVersion.len <= 0:
        return Err[str](" registry publish: missing version in cheng-package.toml")
    let prefix = modulePrefix.len > 0 ? modulePrefix : pkgId
    let ch = channel.len > 0 ? channel : "stable"
    // Collect source files
    let pathsRes = wresolver.WorldResolveCollectSourcePaths(packageDir)
    if IsErr(pathsRes):
        return Err[str](strutil.Join([" registry publish: no source files: ", Error(pathsRes)], ""))
    let srcPaths = Value(pathsRes)
    var snapshotEntries: wresolver.WorldSnapshotEntry[]
    for i in 0..<srcPaths.len:
        let sourcePath = os.JoinPath(packageDir, srcPaths[i])
        let text = chengpath.ReadTextFile("", sourcePath)
        let contentCid = wresolver.WorldResolveContentCid(text)
        let contentHash = wresolver.WorldResolveContentHash(text)
        add(snapshotEntries, wresolver.WorldSnapshotEntryMake(srcPaths[i], contentCid, contentHash))
    let snapshotCid = wresolver.WorldResolveSnapshotCid(snapshotEntries)
    // Build receipt with real package metadata
    var worldHeadCid = layout.FixedBytes32()
    var receiptEntries: wresolver.WorldReceiptEntry[]
    add(receiptEntries, wresolver.WorldReceiptEntryMake(pkgId, prefix, ch, pkgVersion, snapshotCid, ""))
    let receiptCid = wresolver.WorldResolveReceiptCid(worldHeadCid, snapshotCid, receiptEntries)
    var receipt: wresolver.WorldReceipt
    receipt.version = 1
    receipt.worldHeadCid = worldHeadCid
    receipt.snapshotCid = snapshotCid
    receipt.entryCount = receiptEntries.len
    receipt.entries = receiptEntries
    receipt.receiptCid = receiptCid
    // Publish to registry
    let pubRes = RegistryPublish(receipt, endpoint)
    if IsErr(pubRes):
        return Err[str](strutil.Join([" registry publish: ", Error(pubRes)], ""))
    let pubResult = Value(pubRes)
    if !pubResult.success:
        return Err[str](" registry publish: registry returned failure")
    // Copy source files to registry for future fetch
    let srcDir = os.JoinPath(packageDir, "src")
    if chengpath.PathDirExists(srcDir):
        let srcFiles = os.ListDir(srcDir)
        for j in 0..<srcFiles.len:
            let fileName = srcFiles[j]
            let fullSrcPath = os.JoinPath(srcDir, fileName)
            if chengpath.PathFileExists(fullSrcPath):
                let fileText = chengpath.ReadTextFile("", fullSrcPath)
                let publishSrcDir = os.JoinPath(pubResult.publishPath, "src")
                if !chengpath.PathCreateDirAll(publishSrcDir):
                    continue
                let _ = chengpath.WriteTextFile("", os.JoinPath(publishSrcDir, fileName), fileText)
    return Ok[str](pubResult.version)

fn RegistrySearch(endpoint: str, query: str): Result[str[]] =
    let epRes = RegistryEndpointParse(endpoint)
    if IsErr(epRes):
        return Err[str[]](Error(epRes))
    let ep = Value(epRes)
    if ep.scheme != "file":
        return Err[str[]](" registry search: only file:// scheme supported")
    if !chengpath.PathDirExists(ep.path):
        return Err[str[]](strutil.Join([" registry search: registry path does not exist: ", ep.path], ""))
    let entries = os.ListDir(ep.path)
    var results: str[]
    for i in 0..<entries.len:
        let pkgDir = os.JoinPath(ep.path, entries[i])
        if !chengpath.PathDirExists(pkgDir):
            continue
        let pkgName = entries[i]
        if query.len > 0 && !strutil.Contains(pkgName, query):
            continue
        let versions = os.ListDir(pkgDir)
        for j in 0..<versions.len:
            let versionDir = os.JoinPath(pkgDir, versions[j])
            if !chengpath.PathDirExists(versionDir):
                continue
            add(results, strutil.Join([pkgName, " ", versions[j]], ""))
    return Ok[str[]](results)
