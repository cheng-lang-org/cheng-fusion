fn BackendDriverRunFfiHandleTrap(rootDir: str,
                                  label: str,
                                  outputPath: str,
                                  runLog: str,
                                  sourceName: str,
                                  requireDetailStale: bool): int32 =
    let run = BackendDriverRunCompiled(rootDir,
                                        label,
                                        outputPath,
                                        runLog,
                                        false)
    if hostops.LoggedRunOk(run):
        BackendDriverPrintErr(strutil.Join([label, ": expected non-zero exit"], ""))
        return 1
    if !BackendDriverRequireOutput(run.output, "ffi handle invalid", label) ||
       !BackendDriverRequireOutput(run.output, "reason=ffi_handle", label) ||
       !BackendDriverRequireOutput(run.output, strutil.Join([sourceName, ".cheng:"], ""), label):
        return 1
    if requireDetailStale &&
       !BackendDriverRequireOutput(run.output, "detail=stale", label):
        return 1
    return 0

fn BackendDriverBuildFfiHandle(rootDir: str): int32 =
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/ffi_handle")
    let okBin = os.JoinPath(outDir, "ffi_handle_smoke")
    let reuseBin = os.JoinPath(outDir, "ffi_handle_generation_reuse_smoke")
    let trapBin = os.JoinPath(outDir, "ffi_handle_stale_trap_smoke")
    let staleReuseBin = os.JoinPath(outDir, "ffi_handle_generation_stale_trap_smoke")
    let okCompile = BackendDriverCompileDarwinExe(rootDir,
                                                   "build-ffi-handle-ok",
                                                   chengpath.PathAbsolute(rootDir, "src/tests/ffi_handle_smoke.cheng"),
                                                   okBin,
                                                   os.JoinPath(outDir, "ffi_handle_smoke.compile.log"))
    if okCompile != 0:
        return okCompile
    let reuseCompile = BackendDriverCompileDarwinExe(rootDir,
                                                      "build-ffi-handle-generation-reuse",
                                                      chengpath.PathAbsolute(rootDir, "src/tests/ffi_handle_generation_reuse_smoke.cheng"),
                                                      reuseBin,
                                                      os.JoinPath(outDir, "ffi_handle_generation_reuse_smoke.compile.log"))
    if reuseCompile != 0:
        return reuseCompile
    let trapCompile = BackendDriverCompileDarwinExe(rootDir,
                                                     "build-ffi-handle-trap",
                                                     chengpath.PathAbsolute(rootDir, "src/tests/ffi_handle_stale_trap_smoke.cheng"),
                                                     trapBin,
                                                     os.JoinPath(outDir, "ffi_handle_stale_trap_smoke.compile.log"))
    if trapCompile != 0:
        return trapCompile
    let staleReuseCompile = BackendDriverCompileDarwinExe(rootDir,
                                                           "build-ffi-handle-stale-reuse-trap",
                                                           chengpath.PathAbsolute(rootDir, "src/tests/ffi_handle_generation_stale_trap_smoke.cheng"),
                                                           staleReuseBin,
                                                           os.JoinPath(outDir, "ffi_handle_generation_stale_trap_smoke.compile.log"))
    if staleReuseCompile != 0:
        return staleReuseCompile
    if !chengpath.FileExistsNonEmpty(rootDir, strutil.Join([okBin, ".map"], "")) ||
       !chengpath.FileExistsNonEmpty(rootDir, strutil.Join([reuseBin, ".map"], "")) ||
       !chengpath.FileExistsNonEmpty(rootDir, strutil.Join([trapBin, ".map"], "")) ||
       !chengpath.FileExistsNonEmpty(rootDir, strutil.Join([staleReuseBin, ".map"], "")):
        BackendDriverPrintErr("ffi-handle: missing line-map")
        return 1
    let okRun = BackendDriverRunCompiled(rootDir,
                                          "build-ffi-handle-ok",
                                          okBin,
                                          os.JoinPath(outDir, "ffi_handle_smoke.run.log"),
                                          true)
    if !hostops.LoggedRunOk(okRun):
        return okRun.exitCode
    let reuseRun = BackendDriverRunCompiled(rootDir,
                                             "build-ffi-handle-generation-reuse",
                                             reuseBin,
                                             os.JoinPath(outDir, "ffi_handle_generation_reuse_smoke.run.log"),
                                             true)
    if !hostops.LoggedRunOk(reuseRun):
        return reuseRun.exitCode
    let trapRc = BackendDriverRunFfiHandleTrap(rootDir,
                                                "build-ffi-handle-trap",
                                                trapBin,
                                                os.JoinPath(outDir, "ffi_handle_stale_trap_smoke.run.log"),
                                                "ffi_handle_stale_trap_smoke",
                                                false)
    if trapRc != 0:
        return trapRc
    return BackendDriverRunFfiHandleTrap(rootDir,
                                         "build-ffi-handle-stale-reuse-trap",
                                         staleReuseBin,
                                         os.JoinPath(outDir, "ffi_handle_generation_stale_trap_smoke.run.log"),
                                         "ffi_handle_generation_stale_trap_smoke",
                                         true)

fn BackendDriverRunUdpImportcSmoke(rootDir: str,
                                    args: str[]): int32 =
    let compilerPath = BackendDriverHostSmokeCompiler(rootDir, args)
    let label = BackendDriverHostSmokeLabel(args)
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/udp_importc")
    let sourcePath = chengpath.PathAbsolute(rootDir, "src/tests/udp_importc_smoke.cheng")
    let outputPath = os.JoinPath(outDir, strutil.Join(["udp_importc_smoke.", label], ""))
    let compileRc = BackendDriverCompileDarwinExeWithCompiler(rootDir,
                                                               strutil.Join(["run-udp-importc-smoke-", label], ""),
                                                               compilerPath,
                                                               sourcePath,
                                                               outputPath,
                                                               os.JoinPath(outDir, strutil.Join(["udp_importc_smoke.", label, ".compile.log"], "")))
    if compileRc != 0:
        return compileRc
    let run = BackendDriverRunCompiled(rootDir,
                                        strutil.Join(["run-udp-importc-smoke-", label], ""),
                                        outputPath,
                                        os.JoinPath(outDir, strutil.Join(["udp_importc_smoke.", label, ".run.log"], "")),
                                        true)
    if !hostops.LoggedRunOk(run):
        return run.exitCode
    if !BackendDriverRequireOutput(run.output, "udp_importc_smoke ok", "udp importc smoke"):
        return 1
    return 0

fn BackendDriverRunProfileRun(rootDir: str,
                                args: str[]): int32 =
    let sourceRaw = creq.CompilerReadFlagOrDefault(args, "--in", "")
    let sourceTrim = strutil.Strip(sourceRaw)
    let sourceLen = len(sourceTrim)
    if sourceLen <= 0:
        BackendDriverPrintErr("backend driver profile-run: missing --in")
        return 1
    var workspaceRoot = rootDir
    let rootFlag = strutil.Strip(creq.CompilerReadFlagOrDefault(args, "--root", ""))
    let rootFlagLen = len(rootFlag)
    if rootFlagLen > 0:
        workspaceRoot = chengpath.PathAbsolute(rootDir, rootFlag)
    let target = strutil.Strip(creq.CompilerReadFlagOrDefault(args, "--target", "arm64-apple-darwin"))
    if target != "arm64-apple-darwin":
        BackendDriverPrintErr(strutil.Join(["backend driver profile-run: local runnable target required: ", target], ""))
        return 1
    let emit = strutil.Strip(creq.CompilerReadFlagOrDefault(args, "--emit", "exe"))
    if len(emit) > 0 && emit != "exe":
        BackendDriverPrintErr("backend driver profile-run: requires --emit:exe")
        return 1
    let sourcePath = chengpath.PathAbsolute(workspaceRoot, sourceRaw)
    if !chengpath.FileExistsNonEmpty(workspaceRoot, sourcePath):
        BackendDriverPrintErr(strutil.Join(["backend driver profile-run: missing source: ", sourcePath], ""))
        return 1
    let outFlag = strutil.Strip(creq.CompilerReadFlagOrDefault(args, "--out", ""))
    var outputPath = ""
    let outFlagLen = len(outFlag)
    if outFlagLen > 0:
        outputPath = chengpath.PathAbsolute(workspaceRoot, outFlag)
    else:
        outputPath = BackendDriverProfileRunDefaultOut(workspaceRoot, sourcePath)
    let reportFlag = strutil.Strip(creq.CompilerReadFlagOrDefault(args, "--report-out", ""))
    var reportPath = ""
    let reportFlagLen = len(reportFlag)
    if reportFlagLen > 0:
        reportPath = chengpath.PathAbsolute(workspaceRoot, reportFlag)
    else:
        reportPath = strutil.Join([outputPath, ".profile.txt"], "")
    let rawReportPath = debuggate.DebugToolsProfileRawPathFromReport(reportPath)
    let compileLog = strutil.Join([outputPath, ".compile.log"], "")
    let runLog = strutil.Join([outputPath, ".run.log"], "")
    let profileReportLog = strutil.Join([outputPath, ".profile-report.log"], "")
    if !BackendDriverEnsureParentDir(workspaceRoot, outputPath) ||
       !BackendDriverEnsureParentDir(workspaceRoot, reportPath) ||
       !BackendDriverEnsureParentDir(workspaceRoot, rawReportPath):
        BackendDriverPrintErr("backend driver profile-run: failed to create output dirs")
        return 1
    BackendDriverRemoveFileIfExists(outputPath)
    BackendDriverRemoveFileIfExists(strutil.Join([outputPath, ".map"], ""))
    BackendDriverRemoveFileIfExists(reportPath)
    BackendDriverRemoveFileIfExists(rawReportPath)
    BackendDriverRemoveFileIfExists(compileLog)
    BackendDriverRemoveFileIfExists(runLog)
    BackendDriverRemoveFileIfExists(profileReportLog)
    let compilerPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng")
    if !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        BackendDriverPrintErr(strutil.Join(["backend driver profile-run: missing compiler: ", compilerPath], ""))
        return 1
    var compileArgs: str[]
    add(compileArgs, "system-link-exec")
    add(compileArgs, strutil.Join(["--root:", workspaceRoot], ""))
    add(compileArgs, strutil.Join(["--in:", sourcePath], ""))
    add(compileArgs, "--emit:exe")
    add(compileArgs, "--target:arm64-apple-darwin")
    add(compileArgs, strutil.Join(["--out:", outputPath], ""))
    let compileRun = hostops.RunFileLogged(rootDir,
                                             "backend_driver_profile_run_compile",
                                             compilerPath,
                                             compileArgs,
                                             BackendDriverHostSmokeCompileEnv(),
                                             workspaceRoot,
                                             420,
                                             compileLog)
    if !hostops.LoggedRunOk(compileRun):
        let outputText = strutil.Strip(compileRun.output)
        if len(outputText) > 0:
            BackendDriverPrintErr(outputText)
        return compileRun.exitCode
    if !chengpath.FileExistsNonEmpty(workspaceRoot, outputPath):
        BackendDriverPrintErr(strutil.Join(["backend driver profile-run: compile missing output: ", outputPath], ""))
        return 1
    var runEnv: str[]
    add(runEnv, "CHENG_PROFILE_ENABLE=1")
    add(runEnv, strutil.Join(["CHENG_PROFILE_RAW_OUT=", rawReportPath], ""))
    add(runEnv, strutil.Join(["CHENG_PROFILE_HZ=", creq.CompilerReadFlagOrDefault(args, "--profile-hz", "200")], ""))
    let profiledRun = hostops.RunFileLogged(rootDir,
                                             "backend_driver_profile_run_exec",
                                             outputPath,
                                             [],
                                             runEnv,
                                             workspaceRoot,
                                             120,
                                             runLog)
    if !hostops.LoggedRunOk(profiledRun):
        let outputText = strutil.Strip(profiledRun.output)
        if len(outputText) > 0:
            BackendDriverPrintErr(outputText)
        return profiledRun.exitCode
    if !chengpath.FileExistsNonEmpty(workspaceRoot, rawReportPath):
        BackendDriverPrintErr(strutil.Join(["backend driver profile-run: missing raw profile report: ", rawReportPath], ""))
        return 1
    let rawText = chengpath.ReadTextFile(workspaceRoot, rawReportPath)
    let reportRes = debuggate.DebugToolsProfileReportText(rawText)
    if IsErr(reportRes):
        let _ = chengpath.WriteTextFile(workspaceRoot, profileReportLog, strutil.Join([Error(reportRes), "\n"], ""))
        BackendDriverPrintErr(Error(reportRes))
        return 1
    let report = Value(reportRes)
    if !chengpath.WriteTextFile(workspaceRoot, reportPath, report):
        BackendDriverPrintErr(strutil.Join(["backend driver profile-run: failed to write report: ", reportPath], ""))
        return 1
    BackendDriverPrintLine(strutil.Strip(report))
    return 0

fn BackendDriverVerifyDebugProfile(rootDir: str): int32 =
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/debug_profile_verify")
    let src = chengpath.PathAbsolute(rootDir, "src/tests/ordinary_profile_hotspots_fixture.cheng")
    let outBin = os.JoinPath(outDir, "ordinary_profile_hotspots_fixture")
    let report = os.JoinPath(outDir, "profile.txt")
    let rawReport = debuggate.DebugToolsProfileRawPathFromReport(report)
    var args: str[]
    add(args, strutil.Join(["--root:", rootDir], ""))
    add(args, strutil.Join(["--in:", src], ""))
    add(args, "--emit:exe")
    add(args, "--target:arm64-apple-darwin")
    add(args, strutil.Join(["--out:", outBin], ""))
    add(args, strutil.Join(["--report-out:", report], ""))
    add(args, "--profile-hz:200")
    let run = BackendDriverRunProfileRun(rootDir, args)
    if run != 0:
        return run
    if !chengpath.FileExistsNonEmpty(rootDir, rawReport):
        BackendDriverPrintErr(" debug profile: missing raw report")
        return 1
    let rawReportText = chengpath.ReadTextFile(rootDir, rawReport)
    if !strutil.StartsWith(rawReportText, "cheng_profile_raw\n") ||
       !strutil.Contains(rawReportText, "sample\t0x"):
        BackendDriverPrintErr(" debug profile: invalid raw report")
        return 1
    if !chengpath.FileExistsNonEmpty(rootDir, report):
        BackendDriverPrintErr(" debug profile: missing report")
        return 1
    let reportText = chengpath.ReadTextFile(rootDir, report)
    if !strutil.StartsWith(reportText, "cheng_profile\n") ||
       !strutil.Contains(reportText, "hot_function[0]=") ||
       !strutil.Contains(reportText, "hot_pc[0]=") ||
       !strutil.Contains(reportText, "ordinary_profile_hotspots_fixture.cheng"):
        BackendDriverPrintErr(" debug profile: invalid report")
        return 1
    BackendDriverPrintLine(" debug profile: ok")
    return 0

fn BackendDriverVerifyDebugTools(rootDir: str): int32 =
    return BackendDriverRunBuiltinHostSmoke(rootDir,
                                             "verify_debug_tools",
                                             "debug_tools_surface_smoke")

fn BackendDriverSliceGate(rootDir: str): int32 =
    return BackendDriverForward(rootDir, "slice-gate", [])

fn BackendDriverRunR2cReactSurface(rootDir: str): int32 =
    var smokes: str[]
    add(smokes, "--label:verify_r2c_react_surface")
    if os.GetEnv("R2C_REACT_HEAVY_CONTROLLER_SMOKE") == "1":
        add(smokes, "r2c_react_surface_smoke")
        add(smokes, "r2c_react_publish_selector_bundle_smoke")
        add(smokes, "r2c_react_run_native_gui_controller_smoke")
        add(smokes, "r2c_react_discover_truth_routes_controller_smoke")
        add(smokes, "r2c_react_truth_compare_controller_smoke")
        add(smokes, "r2c_react_exec_route_matrix_controller_smoke")
    add(smokes, "r2c_react_render_compare_direct_smoke")
    if os.GetEnv("R2C_REACT_HEAVY_CONTROLLER_SMOKE") == "1":
        add(smokes, "r2c_react_render_compare_controller_smoke")
        add(smokes, "r2c_react_render_compare_matrix_controller_smoke")
    return BackendDriverRunHostSmokesWithR2cController(rootDir, smokes, "")

fn BackendDriverRequestWithAbsoluteSourcePath(rootDir: str,
                                               req: creq.CompilerRequest,
                                               outputPathFallback: str): creq.CompilerRequest =
    var sealedReq = req
    if !creq.CompilerRequestStrictValidateSealed(sealedReq):
        panic("backend driver: parsed compiler request is not sealed")
    var outputPath = req.outputPath
    if len(outputPath) <= 0:
        outputPath = outputPathFallback
    var out = creq.CompilerRequestNew(
        req.rootDir,
        chengpath.PathAbsolute(rootDir, req.sourcePath),
        outputPath,
        req.targetTriple,
        req.emitKind,
        req.reportPath)
    out = creq.CompilerRequestWithSymbolVisibility(
        out, req.symbolVisibility)
    out = creq.CompilerRequestWithBrowserBridgeObject(
        out, req.browserBridgeObjectPath)
    out = creq.CompilerRequestWithExportRootSymbols(
        out, req.exportRootSymbols)
    out = creq.CompilerRequestWithProviderObjectPaths(
        out, req.providerObjectPaths)
    out = creq.CompilerRequestWithRuntimeProviderBundle(
        out, req.runtimeProviderBundle)
    out = creq.CompilerRequestWithMode(out, req.compileMode)
    out = creq.CompilerRequestWithCacheDisabled(out, req.cacheDisabled)
    out.backendKind = req.backendKind
    out.jobCount = req.jobCount
    out.exactFunctionSourcePath = req.exactFunctionSourcePath
    out.exactFunctionName = req.exactFunctionName
    out.exactFunctionDriverPath = req.exactFunctionDriverPath
    creq.CompilerRequestSeal(out)
    return out

fn BackendDriverPositiveJobs(rawJobs: int32): int32 =
    if rawJobs <= 0:
        return 1
    return rawJobs

fn BackendDriverHardwareParallelism(): int32 =
    let raw = thread.Parallelism()
    if raw <= 0:
        return 1
    return raw

fn BackendDriverEffectiveParallelJobs(requestedJobs: int32,
                                       hardwareJobs: int32): int32 =
    var jobs = BackendDriverPositiveJobs(requestedJobs)
    let hardware = BackendDriverPositiveJobs(hardwareJobs)
    if jobs > hardware:
        jobs = hardware
    return jobs

fn BackendDriverDivCeilI64(value: int64,
                            divisorRaw: int32): int64 =
    if value <= int64(0):
        return int64(0)
    let divisor = int64(BackendDriverPositiveJobs(divisorRaw))
    return (value + divisor - int64(1)) / divisor

fn BackendDriverMsText(ns: int64): str =
    if ns <= int64(0):
        return "0"
    return strings.Int64ToStr(ns / int64(1000000))

fn BackendDriverRatioMilliText(numerator: int64,
                                denominator: int64): str =
    if denominator <= int64(0):
        return "0.000"
    let milli = (numerator * int64(1000)) / denominator
    let whole = milli / int64(1000)
    let frac = milli % int64(1000)
    var fracText = strings.Int64ToStr(frac)
    if frac < int64(10):
        fracText = Fmt"00{fracText}"
    elif frac < int64(100):
        fracText = Fmt"0{fracText}"
    return Fmt"{whole}.{fracText}"

fn BackendDriverPercentMilliText(numerator: int64,
                                  denominator: int64): str =
    if denominator <= int64(0):
        return "0.000"
    let milli = (numerator * int64(100000)) / denominator
    let whole = milli / int64(1000)
    let frac = milli % int64(1000)
    var fracText = strings.Int64ToStr(frac)
    if frac < int64(10):
        fracText = Fmt"00{fracText}"
    elif frac < int64(100):
        fracText = Fmt"0{fracText}"
    return Fmt"{whole}.{fracText}"

fn BackendDriverDryCompileAppendLine(out: var str,
                                      line: str) =
    if len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{line}"

fn BackendDriverCountSourceLines(text: str): int64 =
    let n = len(text)
    if n <= 0:
        return int64(0)
    var lines: int64
    for i in 0..<n:
        if text[i] == '\n':
            lines = lines + int64(1)
    if text[n - 1] != '\n':
        lines = lines + int64(1)
    return lines

fn BackendDriverMaxI64(a: int64,
                       b: int64): int64 =
    if a > b:
        return a
    return b

fn BackendDriverCleanDotPath(pathRaw: str): str =
    let path = pathRaw
    if path.len <= 0:
        return ""
    var out: str
    var segmentStart: int32
    if path[0] == '/':
        out = "/"
        segmentStart = 1
    var cursor = segmentStart
    while cursor <= path.len:
        let atEnd = cursor >= path.len
        var stop = false
        if atEnd:
            stop = true
        elif path[cursor] == '/' || path[cursor] == '\\':
            stop = true
        if !stop:
            cursor = cursor + 1
            continue
        let segment = chengpath.TextSlice(path,
                                          segmentStart,
                                          cursor - segmentStart)
        if segment != "" && segment != ".":
            if out.len > 0 && out[out.len - 1] != '/':
                out = strutil.Join([out, "/"], "")
            out = strutil.Join([out, segment], "")
        segmentStart = cursor + 1
        cursor = cursor + 1
    return out

fn BackendDriverPathSeen(paths: str[],
                          value: str): bool =
    for i in 0..<paths.len:
        if paths[i] == value:
            return true
    return false

fn BackendDriverPositiveNs(ns: int64): int64 =
    if ns <= int64(0):
        return int64(0)
    return ns

fn BackendDriverTextHasAt(text: str,
                          start: int32,
                          needle: str): bool =
    if needle.len <= 0:
        return false
    if start < 0 || start + needle.len > text.len:
        return false
    for i in 0..<needle.len:
        if text[start + i] != needle[i]:
            return false
    return true

fn BackendDriverCountLiteral(text: str,
                             needle: str): int64 =
    if needle.len <= 0 || text.len < needle.len:
        return int64(0)
    var count: int64
    var cursor: int32
    while cursor + needle.len <= text.len:
        if BackendDriverTextHasAt(text, cursor, needle):
            count = count + int64(1)
            cursor = cursor + needle.len
        else:
            cursor = cursor + 1
    return count

fn BackendDriverCountLineStart(text: str,
                               needle: str): int64 =
    var count: int64
    if BackendDriverTextHasAt(text, 0, needle):
        count = count + int64(1)
    return count + BackendDriverCountLiteral(text, strutil.Join(["\n", needle], ""))

fn BackendDriverIsAsciiUpper(c: char): bool =
    return c >= 'A' && c <= 'Z'

fn BackendDriverCountExportedFnDecls(text: str): int64 =
    var count: int64
    var cursor: int32
    while cursor + 3 < text.len:
        if BackendDriverTextHasAt(text, cursor, "fn ") &&
           BackendDriverIsAsciiUpper(text[cursor + 3]):
            count = count + int64(1)
        cursor = cursor + 1
    return count

fn BackendDriverDryCompileSourceStats(rootDir: str,
                                       paths: str[],
                                       outFiles: var int64,
                                       outLines: var int64,
                                       outBytes: var int64,
                                       outMaxFileBytes: var int64,
                                       outDeclCount: var int64,
                                       outFunctionCount: var int64,
                                       outExportCount: var int64,
                                       outImportcCount: var int64,
                                       outCallEdgeCount: var int64,
                                       outTypeRefCount: var int64,
                                       outErr: var str): bool =
    outFiles = int64(0)
    outLines = int64(0)
    outBytes = int64(0)
    outMaxFileBytes = int64(0)
    outDeclCount = int64(0)
    outFunctionCount = int64(0)
    outExportCount = int64(0)
    outImportcCount = int64(0)
    outCallEdgeCount = int64(0)
    outTypeRefCount = int64(0)
    outErr = ""
    for i in 0..<paths.len:
        let path = chengpath.PathAbsolute(rootDir, paths[i])
        let text = chengpath.ReadTextFile("", path)
        if len(text) <= 0:
            outErr = Fmt"dry-compile: failed to read source path: {path}"
            return false
        let fileBytes = int64(len(text))
        outFiles = outFiles + int64(1)
        outLines = outLines + BackendDriverCountSourceLines(text)
        outBytes = outBytes + fileBytes
        outMaxFileBytes = BackendDriverMaxI64(outMaxFileBytes, fileBytes)
        let functionCount = BackendDriverCountLiteral(text, "fn ") +
                            BackendDriverCountLiteral(text, "iterator ")
        let importcCount = BackendDriverCountLiteral(text, "@importc")
        let exportCount = BackendDriverCountLiteral(text, "@exportc") +
                          BackendDriverCountExportedFnDecls(text)
        let declCount = functionCount +
                        BackendDriverCountLineStart(text, "type") +
                        BackendDriverCountLineStart(text, "let ") +
                        BackendDriverCountLineStart(text, "var ") +
                        BackendDriverCountLineStart(text, "const ") +
                        BackendDriverCountLineStart(text, "macro ") +
                        BackendDriverCountLineStart(text, "template ") +
                        BackendDriverCountLineStart(text, "concept ") +
                        BackendDriverCountLineStart(text, "trait ")
        var callEdgeCount = BackendDriverCountLiteral(text, "(")
        if callEdgeCount > functionCount:
            callEdgeCount = callEdgeCount - functionCount
        let typeRefCount = BackendDriverCountLiteral(text, ":") +
                           BackendDriverCountLiteral(text, "[") +
                           BackendDriverCountLiteral(text, "type ") +
                           (importcCount * int64(2))
        outDeclCount = outDeclCount + declCount
        outFunctionCount = outFunctionCount + functionCount
        outExportCount = outExportCount + exportCount
        outImportcCount = outImportcCount + importcCount
        outCallEdgeCount = outCallEdgeCount + callEdgeCount
        outTypeRefCount = outTypeRefCount + typeRefCount
    return true

fn BackendDriverDryCompileCollectSourceClosure(rootDir: str,
                                                packageRootRaw: str,
                                                entryPathRaw: str,
                                                sourcePaths: var str[],
                                                importEdgeCount: var int32,
                                                unresolvedImportCount: var int32,
                                                outErr: var str): bool =
    sourcePaths = []
    importEdgeCount = 0
    unresolvedImportCount = 0
    outErr = ""
    let rootAbs = BackendDriverCleanDotPath(chengpath.PathAbsoluteBridgeSafe("", rootDir))
    let packageRoot = BackendDriverCleanDotPath(chengpath.PathAbsoluteBridgeSafe(rootAbs, packageRootRaw))
    let entryPath = BackendDriverCleanDotPath(chengpath.PathAbsoluteBridgeSafe(rootAbs, entryPathRaw))
    add(sourcePaths, entryPath)
    var scanIndex: int32
    while scanIndex < sourcePaths.len:
        let currentPath = sourcePaths[scanIndex]
        scanIndex = scanIndex + 1
        let currentText = chengpath.ReadTextFile("", currentPath)
        if currentText.len <= 0:
            outErr = strutil.Join(["dry-compile: failed to read source path: ", currentPath], "")
            return false
        let ownerModulePath = parser.ParserSourcePathToModulePath(packageRoot,
                                                                  packageRoot,
                                                                  currentPath)
        var edges: parser.ImportEdge[]
        var edgeErr: str
        if !parser.ParserReadImportEdges(packageRoot,
                                         packageRoot,
                                         ownerModulePath,
                                         currentText,
                                         edges,
                                         edgeErr):
            outErr = edgeErr
            return false
        importEdgeCount = importEdgeCount + edges.len
        for i in 0..<edges.len:
            let targetPath = BackendDriverCleanDotPath(edges[i].targetSourcePath)
            if targetPath.len <= 0:
                unresolvedImportCount = unresolvedImportCount + 1
                continue
            if !BackendDriverPathSeen(sourcePaths, targetPath):
                add(sourcePaths, targetPath)
    if unresolvedImportCount > 0:
        outErr = strutil.Join(["dry-compile: unresolved imports: ", strings.IntToStr(unresolvedImportCount)], "")
        return false
    return true

fn BackendDriverDryCompileFormatFloorBytes(targetTriple: str,
                                            emitText: str): int64 =
    if emitText == "exe":
        if chengpath.TextContains(targetTriple, "apple-darwin"):
            return int64(4096)
        if chengpath.TextContains(targetTriple, "linux") ||
           chengpath.TextContains(targetTriple, "elf"):
            return int64(64)
        if chengpath.TextContains(targetTriple, "wasm32"):
            return int64(8)
        return int64(64)
    if emitText == "obj" || emitText == "shared":
        return int64(64)
    return int64(0)

type
    BackendDriverTypedFactMemoryModel =
        factCount: int64
        physicalColumnCount: int64
        physicalInt32ColumnCount: int64
        physicalU8ColumnCount: int64
        int32ScalarBytes: int64
        u8ScalarBytes: int64
        physicalRowBytes: int64
        physicalStorageBytes: int64
        storageModel: str
        internPayloadModel: str
        allocatorOverheadModel: str

    BackendDriverCheckedMath =
        ok: bool
        reason: str

fn BackendDriverTryCheckedMulI64(left: int64,
                                 right: int64,
                                 outValue: var int64): bool =
    outValue = int64(0)
    if left < int64(0) || right < int64(0):
        return false
    if left == int64(0) || right == int64(0):
        return true
    let maxInt64: int64 = 9223372036854775807
    if left > maxInt64 / right:
        return false
    outValue = left * right
    return true

fn BackendDriverCheckedMathStart(): BackendDriverCheckedMath =
    var state: BackendDriverCheckedMath
    state.ok = true
    return state

fn BackendDriverCheckedMathFail(state: var BackendDriverCheckedMath,
                                reason: str) =
    if state.ok:
        state.ok = false
        state.reason = reason

fn BackendDriverCheckedMathInput(state: var BackendDriverCheckedMath,
                                 value: int64,
                                 label: str): int64 =
    if !state.ok:
        return int64(0)
    if value < int64(0):
        BackendDriverCheckedMathFail(state, Fmt"{label}_negative")
        return int64(0)
    return value

fn BackendDriverCheckedMathAdd(state: var BackendDriverCheckedMath,
                               left: int64,
                               right: int64,
                               label: str): int64 =
    if !state.ok:
        return int64(0)
    if left < int64(0) || right < int64(0):
        BackendDriverCheckedMathFail(state, Fmt"{label}_negative_operand")
        return int64(0)
    let maxInt64: int64 = 9223372036854775807
    if left > maxInt64 - right:
        BackendDriverCheckedMathFail(state, Fmt"{label}_overflow")
        return int64(0)
    return left + right

fn BackendDriverCheckedMathSub(state: var BackendDriverCheckedMath,
                               left: int64,
                               right: int64,
                               label: str): int64 =
    if !state.ok:
        return int64(0)
    if left < int64(0) || right < int64(0) || right > left:
        BackendDriverCheckedMathFail(state, Fmt"{label}_underflow")
        return int64(0)
    return left - right

fn BackendDriverCheckedMathMul(state: var BackendDriverCheckedMath,
                               left: int64,
                               right: int64,
                               label: str): int64 =
    if !state.ok:
        return int64(0)
    var outValue: int64
    if !BackendDriverTryCheckedMulI64(left, right, outValue):
        BackendDriverCheckedMathFail(state, Fmt"{label}_overflow")
        return int64(0)
    return outValue

fn BackendDriverCheckedMathDivCeil(state: var BackendDriverCheckedMath,
                                   value: int64,
                                   denominator: int64,
                                   label: str): int64 =
    if !state.ok:
        return int64(0)
    if value < int64(0) || denominator <= int64(0):
        BackendDriverCheckedMathFail(state, Fmt"{label}_invalid_operand")
        return int64(0)
    let quotient = value / denominator
    if value % denominator == int64(0):
        return quotient
    return BackendDriverCheckedMathAdd(state,
                                       quotient,
                                       int64(1),
                                       Fmt"{label}_round")

fn BackendDriverCheckedMathScale(state: var BackendDriverCheckedMath,
                                 value: int64,
                                 numerator: int64,
                                 denominator: int64,
                                 label: str): int64 =
    let product = BackendDriverCheckedMathMul(state,
                                              value,
                                              numerator,
                                              Fmt"{label}_product")
    return BackendDriverCheckedMathDivCeil(state,
                                           product,
                                           denominator,
                                           Fmt"{label}_divide")

fn BackendDriverCheckedMathMax(state: var BackendDriverCheckedMath,
                               left: int64,
                               right: int64,
                               label: str): int64 =
    if !state.ok:
        return int64(0)
    if left < int64(0) || right < int64(0):
        BackendDriverCheckedMathFail(state, Fmt"{label}_negative_operand")
        return int64(0)
    if left > right:
        return left
    return right

fn BackendDriverCheckedAddI64(left: int64,
                              right: int64): int64 =
    if left < int64(0) || right < int64(0):
        panic("backend_driver_memory_model_negative_add_operand")
    let maxInt64: int64 = 9223372036854775807
    if left > maxInt64 - right:
        panic("backend_driver_memory_model_add_overflow")
    return left + right

fn BackendDriverCheckedMulI64(left: int64,
                              right: int64): int64 =
    var outValue: int64
    if !BackendDriverTryCheckedMulI64(left, right, outValue):
        panic("backend_driver_memory_model_mul_overflow")
    return outValue

fn BackendDriverCheckedScaleI64(value: int64,
                                numerator: int64,
                                denominator: int64): int64 =
    if denominator <= int64(0):
        panic("backend_driver_memory_model_scale_denominator")
    let product = BackendDriverCheckedMulI64(value, numerator)
    return BackendDriverCheckedAddI64(product, denominator - int64(1)) / denominator

fn BackendDriverTypedFactMemoryModelTryBuild(factCount: int64,
                                             model: var BackendDriverTypedFactMemoryModel,
                                             reason: var str): bool =
    model = BackendDriverTypedFactMemoryModel()
    reason = ""
    if factCount < int64(0):
        reason = "negative_fact_count"
        return false
    let physicalColumnCount = int64(texpr.TypedExprFactTablePhysicalColumnCount())
    let physicalInt32ColumnCount =
        int64(texpr.TypedExprFactTablePhysicalInt32ColumnCount())
    let physicalU8ColumnCount =
        int64(texpr.TypedExprFactTablePhysicalU8ColumnCount())
    let int32ScalarBytes = int64(sizeof(int32))
    let u8ScalarBytes = int64(1)
    let physicalRowBytes = int64(texpr.TypedExprFactTablePhysicalRowBytes())
    if physicalInt32ColumnCount < int64(0) ||
       physicalU8ColumnCount < int64(0) ||
       physicalColumnCount !=
           physicalInt32ColumnCount + physicalU8ColumnCount:
        reason = "physical_column_shape_mismatch"
        return false
    if physicalRowBytes !=
       physicalInt32ColumnCount * int32ScalarBytes +
       physicalU8ColumnCount * u8ScalarBytes:
        reason = "physical_row_shape_mismatch"
        return false
    var physicalStorageBytes: int64
    if !BackendDriverTryCheckedMulI64(factCount,
                                      physicalRowBytes,
                                      physicalStorageBytes):
        reason = "physical_storage_overflow"
        return false
    model.factCount = factCount
    model.physicalColumnCount = physicalColumnCount
    model.physicalInt32ColumnCount = physicalInt32ColumnCount
    model.physicalU8ColumnCount = physicalU8ColumnCount
    model.int32ScalarBytes = int32ScalarBytes
    model.u8ScalarBytes = u8ScalarBytes
    model.physicalRowBytes = physicalRowBytes
    model.physicalStorageBytes = physicalStorageBytes
    model.storageModel = "mixed_width_presized_soa"
    model.internPayloadModel = "excluded_unmodeled_separate_owner"
    model.allocatorOverheadModel = "excluded_global_allocator_gap"
    return true

fn BackendDriverTypedFactMemoryModelBuild(factCount: int64): BackendDriverTypedFactMemoryModel =
    var model: BackendDriverTypedFactMemoryModel
    var reason: str
    if !BackendDriverTypedFactMemoryModelTryBuild(factCount, model, reason):
        panic(Fmt"backend_driver_typed_fact_memory_model_invalid reason={reason}")
    return model

fn BackendDriverTypedFactMemoryModelReport(model: BackendDriverTypedFactMemoryModel): str =
    return strutil.Join([
        "full_compile_theory_rss_typed_fact_physical_column_count=", strings.Int64ToStr(model.physicalColumnCount), "\n",
        "full_compile_theory_rss_typed_fact_physical_int32_column_count=", strings.Int64ToStr(model.physicalInt32ColumnCount), "\n",
        "full_compile_theory_rss_typed_fact_physical_u8_column_count=", strings.Int64ToStr(model.physicalU8ColumnCount), "\n",
        "full_compile_theory_rss_typed_fact_int32_scalar_bytes=", strings.Int64ToStr(model.int32ScalarBytes), "\n",
        "full_compile_theory_rss_typed_fact_u8_scalar_bytes=", strings.Int64ToStr(model.u8ScalarBytes), "\n",
        "full_compile_theory_rss_typed_fact_physical_row_bytes=", strings.Int64ToStr(model.physicalRowBytes), "\n",
        "full_compile_theory_rss_typed_fact_storage_model=", model.storageModel, "\n",
        "full_compile_theory_rss_typed_fact_row_count=", strings.Int64ToStr(model.factCount), "\n",
        "full_compile_theory_rss_typed_fact_intern_payload_model=", model.internPayloadModel, "\n",
        "full_compile_theory_rss_typed_fact_allocator_overhead_model=", model.allocatorOverheadModel, "\n",
        "full_compile_theory_rss_typed_facts_bytes=", strings.Int64ToStr(model.physicalStorageBytes)
    ], "")

type
    BackendDriverFullRssMemoryModel =
        sourceTextBytes: int64
        csgGraphBytes: int64
        exprLayerBytes: int64
        typedFactsBytes: int64
        typedIrBytes: int64
        loweringBytes: int64
        primaryBytes: int64
        providerBytes: int64
        linkBytes: int64
        reportBytes: int64
        csgIncrementalBytes: int64
        loweringIncrementalBytes: int64
        primaryIncrementalBytes: int64
        reportIncrementalBytes: int64
        csgPhaseBytes: int64
        loweringPhaseBytes: int64
        primaryPhaseBytes: int64
        providerPhaseBytes: int64
        linkPhaseBytes: int64
        reportPhaseBytes: int64
        modeledStructuredPeakBytes: int64
        exclusivePhaseLowerBoundBytes: int64
        consumeWindowLowerBoundBytes: int64
        modeledLowerBoundBytes: int64
        peakPhaseName: str
        legacyRetainedCumulativeEstimateBytes: int64
        capacityBytes: int64
        orcBytes: int64
        arenaBytes: int64
        allocatorHeuristicBytes: int64
        allocatorClassifiedBytes: int64
        allocatorModeledBytes: int64
        allocatorGapBytes: int64
        modeledPeakEstimateBytes: int64
        modeledBudgetEstimateBytes: int64
        modeledGuardEstimateBytes: int64
        hardwareStatus: str

    BackendDriverFullRssParallelMemoryModel =
        memoryLimitBytes: int64
        guardScaleNumerator: int64
        guardScaleDenominator: int64
        guardReserveBytes: int64
        sourceFixedBytes: int64
        sourcePerWorkerBytes: int64
        csgFixedBytes: int64
        csgPerWorkerBytes: int64
        typedIrFixedBytes: int64
        typedIrPerWorkerBytes: int64
        loweringFixedBytes: int64
        loweringPerWorkerBytes: int64
        primaryFixedBytes: int64
        primaryPerWorkerBytes: int64
        providerFixedBytes: int64
        providerPerWorkerBytes: int64
        linkFixedBytes: int64
        linkPerWorkerBytes: int64
        reportFixedBytes: int64
        reportPerWorkerBytes: int64
        serialFloorBytes: int64
        loweringLimitedJobs: int64
        primaryLimitedJobs: int64
        memoryLimitedMaxJobs: int64
        effectiveJobs: int64
        status: str

fn BackendDriverFullRssMemoryModelTryBuild(
    sourceTextBytesRaw: int64,
    csgGraphBytesRaw: int64,
    exprLayerBytesRaw: int64,
    typedFactsBytesRaw: int64,
    typedIrBytesRaw: int64,
    loweringBytesRaw: int64,
    primaryBytesRaw: int64,
    providerBytesRaw: int64,
    linkBytesRaw: int64,
    reportBytesRaw: int64,
    typedIrFunctionsRaw: int64,
    sourceFilesRaw: int64,
    hardwareMemoryBytesRaw: int64,
    model: var BackendDriverFullRssMemoryModel,
    reason: var str): bool =
    model = BackendDriverFullRssMemoryModel()
    reason = ""
    var math = BackendDriverCheckedMathStart()
    let sourceTextBytes = BackendDriverCheckedMathInput(math, sourceTextBytesRaw, "rss_source_text")
    let csgGraphBytes = BackendDriverCheckedMathInput(math, csgGraphBytesRaw, "rss_csg_graph")
    let exprLayerBytes = BackendDriverCheckedMathInput(math, exprLayerBytesRaw, "rss_expr_layer")
    let typedFactsBytes = BackendDriverCheckedMathInput(math, typedFactsBytesRaw, "rss_typed_facts")
    let typedIrBytes = BackendDriverCheckedMathInput(math, typedIrBytesRaw, "rss_typed_ir")
    let loweringBytes = BackendDriverCheckedMathInput(math, loweringBytesRaw, "rss_lowering")
    let primaryBytes = BackendDriverCheckedMathInput(math, primaryBytesRaw, "rss_primary")
    let providerBytes = BackendDriverCheckedMathInput(math, providerBytesRaw, "rss_provider")
    let linkBytes = BackendDriverCheckedMathInput(math, linkBytesRaw, "rss_link")
    let reportBytes = BackendDriverCheckedMathInput(math, reportBytesRaw, "rss_report")
    let typedIrFunctions = BackendDriverCheckedMathInput(math, typedIrFunctionsRaw, "rss_typed_ir_functions")
    let sourceFiles = BackendDriverCheckedMathInput(math, sourceFilesRaw, "rss_source_files")
    let hardwareMemoryBytes = BackendDriverCheckedMathInput(math, hardwareMemoryBytesRaw, "rss_hardware_memory")
    let graphAndExpr = BackendDriverCheckedMathAdd(math, csgGraphBytes, exprLayerBytes, "rss_csg_graph_expr")
    let factsAndIr = BackendDriverCheckedMathAdd(math, typedFactsBytes, typedIrBytes, "rss_csg_facts_ir")
    let csgIncremental = BackendDriverCheckedMathAdd(math, graphAndExpr, factsAndIr, "rss_csg_incremental")
    let loweringHalf = BackendDriverCheckedMathScale(math, loweringBytes, int64(1), int64(2), "rss_lowering_half")
    let primaryIncremental = BackendDriverCheckedMathAdd(math, primaryBytes, loweringHalf, "rss_primary_incremental")
    let sourceAndTypedIr = BackendDriverCheckedMathAdd(math, sourceTextBytes, typedIrBytes, "rss_source_typed_ir")
    let sourceAndPrimary = BackendDriverCheckedMathAdd(math, sourceTextBytes, primaryBytes, "rss_source_primary")
    let csgPhase = BackendDriverCheckedMathAdd(math, sourceTextBytes, csgIncremental, "rss_csg_phase")
    let loweringPhase = BackendDriverCheckedMathAdd(math, sourceAndTypedIr, loweringBytes, "rss_lowering_phase")
    let primaryPhase = BackendDriverCheckedMathAdd(math, sourceAndTypedIr, primaryIncremental, "rss_primary_phase")
    let providerPhase = BackendDriverCheckedMathAdd(math, sourceAndPrimary, providerBytes, "rss_provider_phase")
    let linkPhase = BackendDriverCheckedMathAdd(math, providerPhase, linkBytes, "rss_link_phase")
    let reportPhase = BackendDriverCheckedMathAdd(math, sourceAndPrimary, reportBytes, "rss_report_phase")
    var structuredPeak = csgPhase
    var peakPhaseName = "compiler_csg"
    let csgLoweringMax = BackendDriverCheckedMathMax(math, structuredPeak, loweringPhase, "rss_csg_lowering_max")
    if loweringPhase > structuredPeak:
        peakPhaseName = "lowering_plan"
    structuredPeak = csgLoweringMax
    let primaryMax = BackendDriverCheckedMathMax(math, structuredPeak, primaryPhase, "rss_primary_max")
    if primaryPhase > structuredPeak:
        peakPhaseName = "primary_object_plan"
    structuredPeak = primaryMax
    let providerMax = BackendDriverCheckedMathMax(math, structuredPeak, providerPhase, "rss_provider_max")
    if providerPhase > structuredPeak:
        peakPhaseName = "provider_object"
    structuredPeak = providerMax
    let linkMax = BackendDriverCheckedMathMax(math, structuredPeak, linkPhase, "rss_link_max")
    if linkPhase > structuredPeak:
        peakPhaseName = "native_link"
    structuredPeak = linkMax
    let reportMax = BackendDriverCheckedMathMax(math, structuredPeak, reportPhase, "rss_report_max")
    if reportPhase > structuredPeak:
        peakPhaseName = "report_payload_assembly"
    structuredPeak = reportMax
    let legacySourceCsg = BackendDriverCheckedMathAdd(math, sourceTextBytes, csgIncremental, "rss_legacy_source_csg")
    let legacyLoweringPrimary = BackendDriverCheckedMathAdd(math, loweringBytes, primaryIncremental, "rss_legacy_lowering_primary")
    let legacyBeforeReport = BackendDriverCheckedMathAdd(math, legacySourceCsg, legacyLoweringPrimary, "rss_legacy_before_report")
    let legacyRetained = BackendDriverCheckedMathAdd(math, legacyBeforeReport, reportBytes, "rss_legacy_retained")
    let capacityBytes = BackendDriverCheckedMathScale(math, structuredPeak, int64(1), int64(4), "rss_capacity")
    let orcFunctionBytes = BackendDriverCheckedMathMul(math, typedIrFunctions, int64(48), "rss_orc_functions")
    let orcSourceBytes = BackendDriverCheckedMathMul(math, sourceFiles, int64(64), "rss_orc_sources")
    let orcBytes = BackendDriverCheckedMathAdd(math, orcFunctionBytes, orcSourceBytes, "rss_orc")
    let arenaGraphIr = BackendDriverCheckedMathAdd(math, csgGraphBytes, typedIrBytes, "rss_arena_graph_ir")
    let arenaLoweringPrimary = BackendDriverCheckedMathAdd(math, loweringBytes, primaryBytes, "rss_arena_lowering_primary")
    let arenaInputs = BackendDriverCheckedMathAdd(math, arenaGraphIr, arenaLoweringPrimary, "rss_arena_inputs")
    let arenaBytes = BackendDriverCheckedMathScale(math, arenaInputs, int64(1), int64(5), "rss_arena")
    let allocatorHalf = BackendDriverCheckedMathScale(math, structuredPeak, int64(1), int64(2), "rss_allocator_half")
    let allocatorHeuristic = BackendDriverCheckedMathAdd(math, allocatorHalf, int64(4194304), "rss_allocator_heuristic")
    let capacityAndOrc = BackendDriverCheckedMathAdd(math, capacityBytes, orcBytes, "rss_allocator_capacity_orc")
    let allocatorClassified = BackendDriverCheckedMathAdd(math, capacityAndOrc, arenaBytes, "rss_allocator_classified")
    let allocatorModeled = BackendDriverCheckedMathMax(math, allocatorHeuristic, allocatorClassified, "rss_allocator_modeled")
    let allocatorGap = BackendDriverCheckedMathSub(math, allocatorModeled, allocatorClassified, "rss_allocator_gap")
    let modeledPeak = BackendDriverCheckedMathAdd(math, structuredPeak, allocatorModeled, "rss_modeled_peak")
    let doubledPeak = BackendDriverCheckedMathMul(math, modeledPeak, int64(2), "rss_modeled_budget_double")
    let modeledBudget = BackendDriverCheckedMathAdd(math, doubledPeak, int64(16777216), "rss_modeled_budget")
    let modeledGuard = BackendDriverCheckedMathAdd(math, modeledBudget, int64(67108864), "rss_modeled_guard")
    var exclusivePeak = sourceTextBytes
    exclusivePeak = BackendDriverCheckedMathMax(math, exclusivePeak, csgIncremental, "rss_exclusive_csg")
    exclusivePeak = BackendDriverCheckedMathMax(math, exclusivePeak, loweringBytes, "rss_exclusive_lowering")
    exclusivePeak = BackendDriverCheckedMathMax(math, exclusivePeak, primaryBytes, "rss_exclusive_primary")
    exclusivePeak = BackendDriverCheckedMathMax(math, exclusivePeak, providerBytes, "rss_exclusive_provider")
    exclusivePeak = BackendDriverCheckedMathMax(math, exclusivePeak, linkBytes, "rss_exclusive_link")
    exclusivePeak = BackendDriverCheckedMathMax(math, exclusivePeak, reportBytes, "rss_exclusive_report")
    let consumeWindowLowerBound = structuredPeak
    let modeledLowerBound = BackendDriverCheckedMathAdd(math, consumeWindowLowerBound, orcBytes, "rss_theory_lower_bound")
    if !math.ok:
        reason = math.reason
        return false
    model.sourceTextBytes = sourceTextBytes
    model.csgGraphBytes = csgGraphBytes
    model.exprLayerBytes = exprLayerBytes
    model.typedFactsBytes = typedFactsBytes
    model.typedIrBytes = typedIrBytes
    model.loweringBytes = loweringBytes
    model.primaryBytes = primaryBytes
    model.providerBytes = providerBytes
    model.linkBytes = linkBytes
    model.reportBytes = reportBytes
    model.csgIncrementalBytes = csgIncremental
    model.loweringIncrementalBytes = loweringBytes
    model.primaryIncrementalBytes = primaryIncremental
    model.reportIncrementalBytes = reportBytes
    model.csgPhaseBytes = csgPhase
    model.loweringPhaseBytes = loweringPhase
    model.primaryPhaseBytes = primaryPhase
    model.providerPhaseBytes = providerPhase
    model.linkPhaseBytes = linkPhase
    model.reportPhaseBytes = reportPhase
    model.modeledStructuredPeakBytes = structuredPeak
    model.exclusivePhaseLowerBoundBytes = exclusivePeak
    model.consumeWindowLowerBoundBytes = consumeWindowLowerBound
    model.modeledLowerBoundBytes = modeledLowerBound
    model.peakPhaseName = peakPhaseName
    model.legacyRetainedCumulativeEstimateBytes = legacyRetained
    model.capacityBytes = capacityBytes
    model.orcBytes = orcBytes
    model.arenaBytes = arenaBytes
    model.allocatorHeuristicBytes = allocatorHeuristic
    model.allocatorClassifiedBytes = allocatorClassified
    model.allocatorModeledBytes = allocatorModeled
    model.allocatorGapBytes = allocatorGap
    model.modeledPeakEstimateBytes = modeledPeak
    model.modeledBudgetEstimateBytes = modeledBudget
    model.modeledGuardEstimateBytes = modeledGuard
    model.hardwareStatus = "unknown"
    if hardwareMemoryBytes > int64(0):
        model.hardwareStatus = "modeled_estimate_within_hardware"
        if modeledGuard > hardwareMemoryBytes:
            model.hardwareStatus = "modeled_estimate_exceeds_hardware"
    return true

fn BackendDriverFullRssMemoryModelBuild(sourceTextBytes: int64,
                                        csgGraphBytes: int64,
                                        exprLayerBytes: int64,
                                        typedFactsBytes: int64,
                                        typedIrBytes: int64,
                                        loweringBytes: int64,
                                        primaryBytes: int64,
                                        providerBytes: int64,
                                        linkBytes: int64,
                                        reportBytes: int64,
                                        typedIrFunctions: int64,
                                        sourceFiles: int64,
                                        hardwareMemoryBytes: int64): BackendDriverFullRssMemoryModel =
    var model: BackendDriverFullRssMemoryModel
    var reason: str
    if !BackendDriverFullRssMemoryModelTryBuild(sourceTextBytes,
                                                csgGraphBytes,
                                                exprLayerBytes,
                                                typedFactsBytes,
                                                typedIrBytes,
                                                loweringBytes,
                                                primaryBytes,
                                                providerBytes,
                                                linkBytes,
                                                reportBytes,
                                                typedIrFunctions,
                                                sourceFiles,
                                                hardwareMemoryBytes,
                                                model,
                                                reason):
        panic(Fmt"backend_driver_full_rss_memory_model_invalid reason={reason}")
    return model

@borrows
fn BackendDriverCompileRssTheoryLowerBoundBytes(
    model: BackendDriverFullRssMemoryModel): int64 =
    return model.modeledLowerBoundBytes

fn BackendDriverFullRssParallelMemoryModelTryBuild(
    rss: BackendDriverFullRssMemoryModel,
    requestedJobsRaw: int64,
    hardwareJobsRaw: int64,
    memoryLimitBytesRaw: int64,
    model: var BackendDriverFullRssParallelMemoryModel,
    reason: var str): bool =
    model = BackendDriverFullRssParallelMemoryModel()
    reason = ""
    var math = BackendDriverCheckedMathStart()
    let requestedJobs = BackendDriverCheckedMathInput(
        math,
        requestedJobsRaw,
        "rss_parallel_requested_jobs")
    let hardwareJobs = BackendDriverCheckedMathInput(
        math,
        hardwareJobsRaw,
        "rss_parallel_hardware_jobs")
    let memoryLimitBytes = BackendDriverCheckedMathInput(
        math,
        memoryLimitBytesRaw,
        "rss_parallel_memory_limit")
    if requestedJobs <= int64(0):
        BackendDriverCheckedMathFail(
            math,
            "rss_parallel_requested_jobs_non_positive")
    if hardwareJobs <= int64(0):
        BackendDriverCheckedMathFail(
            math,
            "rss_parallel_hardware_jobs_non_positive")
    if memoryLimitBytes <= int64(0):
        BackendDriverCheckedMathFail(
            math,
            "rss_parallel_memory_limit_non_positive")
    let guardScaleNumerator = int64(3)
    let guardScaleDenominator = int64(1)
    let scaledStructuredPeak = BackendDriverCheckedMathMul(
        math,
        rss.modeledStructuredPeakBytes,
        guardScaleNumerator,
        "rss_parallel_scaled_structured_peak")
    let guardReserveBytes = BackendDriverCheckedMathSub(
        math,
        rss.modeledGuardEstimateBytes,
        scaledStructuredPeak,
        "rss_parallel_guard_reserve")
    let loweringBaseBytes = BackendDriverCheckedMathSub(
        math,
        rss.loweringPhaseBytes,
        rss.loweringIncrementalBytes,
        "rss_parallel_lowering_base")
    let primaryBaseBytes = BackendDriverCheckedMathSub(
        math,
        rss.primaryPhaseBytes,
        rss.primaryIncrementalBytes,
        "rss_parallel_primary_base")
    let csgScaledBytes = BackendDriverCheckedMathMul(
        math,
        rss.csgPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_csg_scaled")
    let sourceScaledBytes = BackendDriverCheckedMathMul(
        math,
        rss.sourceTextBytes,
        guardScaleNumerator,
        "rss_parallel_source_scaled")
    let loweringBaseScaledBytes = BackendDriverCheckedMathMul(
        math,
        loweringBaseBytes,
        guardScaleNumerator,
        "rss_parallel_lowering_base_scaled")
    let loweringPerWorkerBytes = BackendDriverCheckedMathMul(
        math,
        rss.loweringIncrementalBytes,
        guardScaleNumerator,
        "rss_parallel_lowering_per_worker")
    let primaryBaseScaledBytes = BackendDriverCheckedMathMul(
        math,
        primaryBaseBytes,
        guardScaleNumerator,
        "rss_parallel_primary_base_scaled")
    let primaryPerWorkerBytes = BackendDriverCheckedMathMul(
        math,
        rss.primaryIncrementalBytes,
        guardScaleNumerator,
        "rss_parallel_primary_per_worker")
    let providerScaledBytes = BackendDriverCheckedMathMul(
        math,
        rss.providerPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_provider_scaled")
    let linkScaledBytes = BackendDriverCheckedMathMul(
        math,
        rss.linkPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_link_scaled")
    let reportScaledBytes = BackendDriverCheckedMathMul(
        math,
        rss.reportPhaseBytes,
        guardScaleNumerator,
        "rss_parallel_report_scaled")
    let csgFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        csgScaledBytes,
        "rss_parallel_csg_fixed")
    let sourceFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        sourceScaledBytes,
        "rss_parallel_source_fixed")
    let typedIrFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        loweringBaseScaledBytes,
        "rss_parallel_typed_ir_fixed")
    let loweringFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        loweringBaseScaledBytes,
        "rss_parallel_lowering_fixed")
    let primaryFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        primaryBaseScaledBytes,
        "rss_parallel_primary_fixed")
    let providerFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        providerScaledBytes,
        "rss_parallel_provider_fixed")
    let linkFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        linkScaledBytes,
        "rss_parallel_link_fixed")
    let reportFixedBytes = BackendDriverCheckedMathAdd(
        math,
        guardReserveBytes,
        reportScaledBytes,
        "rss_parallel_report_fixed")
    var serialFloorBytes = BackendDriverCheckedMathMax(
        math,
        sourceFixedBytes,
        csgFixedBytes,
        "rss_parallel_serial_source_csg")
    serialFloorBytes = BackendDriverCheckedMathMax(
        math,
        serialFloorBytes,
        typedIrFixedBytes,
        "rss_parallel_serial_typed_ir")
    serialFloorBytes = BackendDriverCheckedMathMax(
        math,
        serialFloorBytes,
        loweringFixedBytes,
        "rss_parallel_serial_lowering_fixed")
    serialFloorBytes = BackendDriverCheckedMathMax(
        math,
        serialFloorBytes,
        primaryFixedBytes,
        "rss_parallel_serial_primary_fixed")
    serialFloorBytes = BackendDriverCheckedMathMax(
        math,
        serialFloorBytes,
        providerFixedBytes,
        "rss_parallel_serial_provider")
    serialFloorBytes = BackendDriverCheckedMathMax(
        math,
        serialFloorBytes,
        linkFixedBytes,
        "rss_parallel_serial_link")
    serialFloorBytes = BackendDriverCheckedMathMax(
        math,
        serialFloorBytes,
        reportFixedBytes,
        "rss_parallel_serial_report")
    if !math.ok:
        reason = math.reason
        return false
    if serialFloorBytes > memoryLimitBytes:
        reason = "rss_parallel_serial_floor_exceeds_memory_limit"
        return false
    var loweringLimitedJobs = hardwareJobs
    if loweringPerWorkerBytes > int64(0):
        let loweringAvailableBytes = memoryLimitBytes - loweringFixedBytes
        if loweringAvailableBytes < loweringPerWorkerBytes:
            reason = "rss_parallel_lowering_one_worker_exceeds_memory_limit"
            return false
        loweringLimitedJobs = loweringAvailableBytes / loweringPerWorkerBytes
    var primaryLimitedJobs = hardwareJobs
    if primaryPerWorkerBytes > int64(0):
        let primaryAvailableBytes = memoryLimitBytes - primaryFixedBytes
        if primaryAvailableBytes < primaryPerWorkerBytes:
            reason = "rss_parallel_primary_one_worker_exceeds_memory_limit"
            return false
        primaryLimitedJobs = primaryAvailableBytes / primaryPerWorkerBytes
    var memoryLimitedMaxJobs = hardwareJobs
    if loweringLimitedJobs < memoryLimitedMaxJobs:
        memoryLimitedMaxJobs = loweringLimitedJobs
    if primaryLimitedJobs < memoryLimitedMaxJobs:
        memoryLimitedMaxJobs = primaryLimitedJobs
    if memoryLimitedMaxJobs <= int64(0):
        reason = "rss_parallel_memory_limited_jobs_non_positive"
        return false
    var effectiveJobs = requestedJobs
    if hardwareJobs < effectiveJobs:
        effectiveJobs = hardwareJobs
    if memoryLimitedMaxJobs < effectiveJobs:
        effectiveJobs = memoryLimitedMaxJobs
    if effectiveJobs <= int64(0):
        reason = "rss_parallel_effective_jobs_non_positive"
        return false
    model.memoryLimitBytes = memoryLimitBytes
    model.guardScaleNumerator = guardScaleNumerator
    model.guardScaleDenominator = guardScaleDenominator
    model.guardReserveBytes = guardReserveBytes
    model.sourceFixedBytes = sourceFixedBytes
    model.sourcePerWorkerBytes = int64(0)
    model.csgFixedBytes = csgFixedBytes
    model.csgPerWorkerBytes = int64(0)
    model.typedIrFixedBytes = typedIrFixedBytes
    model.typedIrPerWorkerBytes = int64(0)
    model.loweringFixedBytes = loweringFixedBytes
    model.loweringPerWorkerBytes = loweringPerWorkerBytes
    model.primaryFixedBytes = primaryFixedBytes
    model.primaryPerWorkerBytes = primaryPerWorkerBytes
    model.providerFixedBytes = providerFixedBytes
    model.providerPerWorkerBytes = int64(0)
    model.linkFixedBytes = linkFixedBytes
    model.linkPerWorkerBytes = int64(0)
    model.reportFixedBytes = reportFixedBytes
    model.reportPerWorkerBytes = int64(0)
    model.serialFloorBytes = serialFloorBytes
    model.loweringLimitedJobs = loweringLimitedJobs
    model.primaryLimitedJobs = primaryLimitedJobs
    model.memoryLimitedMaxJobs = memoryLimitedMaxJobs
    model.effectiveJobs = effectiveJobs
    model.status = "modeled_components_within_memory_limit"
    return true

fn BackendDriverFullRssParallelMemoryModelReport(
    model: BackendDriverFullRssParallelMemoryModel): str =
    var out: str
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_parallel_model=closed_form_phase_fixed_plus_per_worker")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_parallel_model_scope=modeled_components_only")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_memory_limit_bytes={model.memoryLimitBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_parallel_guard_scale_numerator={model.guardScaleNumerator}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_parallel_guard_scale_denominator={model.guardScaleDenominator}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_parallel_guard_reserve_bytes={model.guardReserveBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_source_fixed_bytes={model.sourceFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_source_per_worker_bytes={model.sourcePerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_csg_fixed_bytes={model.csgFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_csg_per_worker_bytes={model.csgPerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_typed_ir_fixed_bytes={model.typedIrFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_typed_ir_per_worker_bytes={model.typedIrPerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_lowering_fixed_bytes={model.loweringFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_lowering_per_worker_bytes={model.loweringPerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_primary_fixed_bytes={model.primaryFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_primary_per_worker_bytes={model.primaryPerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_provider_fixed_bytes={model.providerFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_provider_per_worker_bytes={model.providerPerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_link_fixed_bytes={model.linkFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_link_per_worker_bytes={model.linkPerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_report_fixed_bytes={model.reportFixedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_report_per_worker_bytes={model.reportPerWorkerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_parallel_serial_floor_bytes={model.serialFloorBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_lowering_memory_limited_jobs={model.loweringLimitedJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_primary_memory_limited_jobs={model.primaryLimitedJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_memory_limited_max_jobs={model.memoryLimitedMaxJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_memory_limited_effective_jobs={model.effectiveJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_parallel_status={model.status}")
    return out

fn BackendDriverFullRssMemoryModelReport(model: BackendDriverFullRssMemoryModel,
                                         typedFacts: BackendDriverTypedFactMemoryModel): str =
    var out: str
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_model=phase_lifetime_max_checked")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_model_scope=non_exhaustive_modeled_components")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_estimate_status=non_exhaustive_modeled_estimate_not_proven_upper_bound")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_component_coverage=non_exhaustive")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_unmodeled_owner_count=8")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_unmodeled_components=typed_fact_intern_payload,other_string_and_intern_pools,allocator_runtime_metadata,process_runtime_baseline,thread_stacks,device_allocations,linker_allocations,codegen_provider_allocations")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_proven_upper_bound_status=not_proven")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_source_text_bytes={model.sourceTextBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_csg_graph_bytes={model.csgGraphBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_expr_layer_bytes={model.exprLayerBytes}")
    BackendDriverDryCompileAppendLine(out, BackendDriverTypedFactMemoryModelReport(typedFacts))
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_typed_ir_bytes={model.typedIrBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_lowering_bytes={model.loweringBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_primary_bytes={model.primaryBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_provider_bytes={model.providerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_link_bytes={model.linkBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_report_bytes={model.reportBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_csg_structured_bytes={model.csgPhaseBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_lowering_structured_bytes={model.loweringPhaseBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_primary_structured_bytes={model.primaryPhaseBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_provider_structured_bytes={model.providerPhaseBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_link_structured_bytes={model.linkPhaseBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_phase_report_structured_bytes={model.reportPhaseBytes}")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_modeled_retention_model=phase_lifetime_max_with_explicit_release")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_single_phase_peak_name={model.peakPhaseName}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_single_phase_max_structured_bytes={model.modeledStructuredPeakBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_modeled_structured_peak_bytes={model.modeledStructuredPeakBytes}")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_lower_bound_model=deterministic_phase_lifetime_consume_window_plus_orc")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_exclusive_phase_lower_bound_bytes={model.exclusivePhaseLowerBoundBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_consume_window_lower_bound_bytes={model.consumeWindowLowerBoundBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_lower_bound_bytes={model.modeledLowerBoundBytes}")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_official_hard_gate_bytes=805306368")
    var lowerBoundFitsHardGate = "0"
    if model.modeledLowerBoundBytes <= int64(805306368):
        lowerBoundFitsHardGate = "1"
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_lower_bound_fits_hard_gate={lowerBoundFitsHardGate}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_legacy_retained_cumulative_estimate_bytes={model.legacyRetainedCumulativeEstimateBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_csg_incremental_bytes={model.csgIncrementalBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_lowering_incremental_bytes={model.loweringIncrementalBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_primary_incremental_bytes={model.primaryIncrementalBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_report_incremental_bytes={model.reportIncrementalBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_capacity_bytes={model.capacityBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_orc_bytes={model.orcBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_arena_bytes={model.arenaBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_allocator_heuristic_estimate_bytes={model.allocatorHeuristicBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_allocator_classified_sum_bytes={model.allocatorClassifiedBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_allocator_modeled_bytes={model.allocatorModeledBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_allocator_gap_bytes={model.allocatorGapBytes}")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_allocator_invariant=modeled_gte_capacity_plus_orc_plus_arena")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_peak_phase_name={model.peakPhaseName}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_modeled_peak_estimate_bytes={model.modeledPeakEstimateBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_modeled_budget_estimate_bytes={model.modeledBudgetEstimateBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_modeled_guard_estimate_bytes={model.modeledGuardEstimateBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_rss_modeled_guard_hardware_status={model.hardwareStatus}")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_rss_modeled_guard_hardware_status_semantics=non_exhaustive_modeled_estimate_only")
    return out

fn BackendDriverAppendFullTheoryReport(out: var str,
                                       sourceFilesRaw: int64,
                                       sourceLinesRaw: int64,
                                       sourceBytesRaw: int64,
                                       importEdgeCount: int32,
                                       declCountRaw: int64,
                                       functionCountRaw: int64,
                                       exportCountRaw: int64,
                                       importcCountRaw: int64,
                                       callEdgeCountRaw: int64,
                                       typeRefCountRaw: int64,
                                       sourceClosureNsRaw: int64,
                                       formatFloorBytesRaw: int64,
                                       requestedJobs: int32,
                                       hardwareJobs: int32,
                                       effectiveJobs: int32,
                                       hardwareMemoryBytesRaw: int64,
                                       memoryLimitBytesRaw: int64,
                                       reason: var str): bool =
    reason = ""
    var math = BackendDriverCheckedMathStart()
    let sourceFiles = BackendDriverCheckedMathInput(math, sourceFilesRaw, "source_files")
    let sourceLines = BackendDriverCheckedMathInput(math, sourceLinesRaw, "source_lines")
    let sourceBytes = BackendDriverCheckedMathInput(math, sourceBytesRaw, "source_bytes")
    let importEdges = BackendDriverCheckedMathInput(math, int64(importEdgeCount), "import_edges")
    let declCount = BackendDriverCheckedMathInput(math, declCountRaw, "decl_count")
    let functionCount = BackendDriverCheckedMathInput(math, functionCountRaw, "function_count")
    let exportCount = BackendDriverCheckedMathInput(math, exportCountRaw, "export_count")
    let importcCount = BackendDriverCheckedMathInput(math, importcCountRaw, "importc_count")
    let callEdgeCount = BackendDriverCheckedMathInput(math, callEdgeCountRaw, "call_edge_count")
    let typeRefCount = BackendDriverCheckedMathInput(math, typeRefCountRaw, "type_ref_count")
    let sourceClosureNs = BackendDriverCheckedMathInput(math, sourceClosureNsRaw, "source_closure_ns")
    let formatFloorBytes = BackendDriverCheckedMathInput(math, formatFloorBytesRaw, "format_floor_bytes")
    let requestedJobsValue = BackendDriverCheckedMathInput(math, int64(requestedJobs), "requested_jobs")
    let hardwareJobsValue = BackendDriverCheckedMathInput(math, int64(hardwareJobs), "hardware_jobs")
    let effectiveJobsValue = BackendDriverCheckedMathInput(math, int64(effectiveJobs), "effective_jobs")
    let hardwareMemoryBytes = BackendDriverCheckedMathInput(math, hardwareMemoryBytesRaw, "hardware_memory_bytes")
    let memoryLimitBytes = BackendDriverCheckedMathInput(math, memoryLimitBytesRaw, "memory_limit_bytes")
    if effectiveJobsValue <= int64(0):
        BackendDriverCheckedMathFail(math, "effective_jobs_non_positive")
    var hardwareEffectiveJobs = requestedJobsValue
    if hardwareJobsValue < hardwareEffectiveJobs:
        hardwareEffectiveJobs = hardwareJobsValue
    if effectiveJobsValue != hardwareEffectiveJobs:
        BackendDriverCheckedMathFail(math, "effective_jobs_mismatch")
    if !math.ok:
        reason = math.reason
        return false
    var declEstimate = BackendDriverCheckedMathMax(math, declCount, functionCount, "decl_estimate")
    var functionEstimate = functionCount
    if functionEstimate <= int64(0):
        let lineFunctionEstimate = BackendDriverCheckedMathDivCeil(math, sourceLines, int64(24), "function_estimate_lines")
        functionEstimate = BackendDriverCheckedMathAdd(math, lineFunctionEstimate, sourceFiles, "function_estimate")
    let exportEstimate = BackendDriverCheckedMathMax(math, exportCount, importcCount, "export_estimate")
    let callEdgeEstimate = BackendDriverCheckedMathMax(math, callEdgeCount, functionEstimate, "call_edge_estimate")
    let typeRefEstimate = BackendDriverCheckedMathMax(math, typeRefCount, declEstimate, "type_ref_estimate")
    var typedIrFunctions = BackendDriverCheckedMathAdd(math, functionEstimate, sourceFiles, "typed_ir_functions")
    if typedIrFunctions <= int64(0):
        typedIrFunctions = int64(1)
    let statementLines = BackendDriverCheckedMathDivCeil(math, sourceLines, int64(2), "typed_ir_statement_lines")
    let statementTypes = BackendDriverCheckedMathDivCeil(math, typeRefEstimate, int64(2), "typed_ir_statement_types")
    let statementLinesCalls = BackendDriverCheckedMathAdd(math, statementLines, callEdgeEstimate, "typed_ir_statement_lines_calls")
    let statementEstimate = BackendDriverCheckedMathAdd(math, statementLinesCalls, statementTypes, "typed_ir_statement_estimate")
    let typedIrStatements = BackendDriverCheckedMathMax(math, statementEstimate, typedIrFunctions, "typed_ir_statements")
    let csgExprLines = BackendDriverCheckedMathMul(math, sourceLines, int64(2), "csg_expr_lines")
    let csgExprBytes = BackendDriverCheckedMathDivCeil(math, sourceBytes, int64(24), "csg_expr_bytes")
    let csgExprLineBytes = BackendDriverCheckedMathAdd(math, csgExprLines, csgExprBytes, "csg_expr_line_bytes")
    let csgExprCalls = BackendDriverCheckedMathAdd(math, csgExprLineBytes, callEdgeEstimate, "csg_expr_calls")
    let csgExprEstimate = BackendDriverCheckedMathAdd(math, csgExprCalls, typeRefEstimate, "csg_expr_estimate")
    let csgExprs = BackendDriverCheckedMathMax(math, csgExprEstimate, typedIrStatements, "csg_exprs")
    let csgNodeLines = BackendDriverCheckedMathMul(math, sourceLines, int64(4), "csg_node_lines")
    let csgNodeFiles = BackendDriverCheckedMathMul(math, sourceFiles, int64(32), "csg_node_files")
    let csgNodeImports = BackendDriverCheckedMathMul(math, importEdges, int64(8), "csg_node_imports")
    let csgNodeDecls = BackendDriverCheckedMathMul(math, declEstimate, int64(6), "csg_node_decls")
    let csgNodeFunctions = BackendDriverCheckedMathMul(math, functionEstimate, int64(12), "csg_node_functions")
    let csgNodeTypes = BackendDriverCheckedMathMul(math, typeRefEstimate, int64(2), "csg_node_types")
    let csgNodeLineFiles = BackendDriverCheckedMathAdd(math, csgNodeLines, csgNodeFiles, "csg_node_line_files")
    let csgNodeImportsDecls = BackendDriverCheckedMathAdd(math, csgNodeImports, csgNodeDecls, "csg_node_imports_decls")
    let csgNodeFunctionsTypes = BackendDriverCheckedMathAdd(math, csgNodeFunctions, csgNodeTypes, "csg_node_functions_types")
    let csgNodeLeft = BackendDriverCheckedMathAdd(math, csgNodeLineFiles, csgNodeImportsDecls, "csg_node_left")
    let csgNodeRight = BackendDriverCheckedMathAdd(math, csgNodeFunctionsTypes, int64(64), "csg_node_right")
    let csgNodeEstimate = BackendDriverCheckedMathAdd(math, csgNodeLeft, csgNodeRight, "csg_node_estimate")
    let csgNodes = BackendDriverCheckedMathMax(math, csgNodeEstimate, csgExprs, "csg_nodes")
    let csgEdgeNodes = BackendDriverCheckedMathMul(math, csgNodes, int64(2), "csg_edge_nodes")
    let csgEdgeImports = BackendDriverCheckedMathMul(math, importEdges, int64(4), "csg_edge_imports")
    let csgEdgeBase = BackendDriverCheckedMathAdd(math, csgEdgeNodes, csgEdgeImports, "csg_edge_base")
    let csgEdgeCalls = BackendDriverCheckedMathAdd(math, csgEdgeBase, callEdgeEstimate, "csg_edge_calls")
    let csgEdges = BackendDriverCheckedMathAdd(math, csgEdgeCalls, typeRefEstimate, "csg_edges")
    let csgFactNodes = BackendDriverCheckedMathMul(math, csgNodes, int64(3), "csg_fact_nodes")
    let csgFactFiles = BackendDriverCheckedMathMul(math, sourceFiles, int64(32), "csg_fact_files")
    let csgFactDecls = BackendDriverCheckedMathMul(math, declEstimate, int64(4), "csg_fact_decls")
    let csgFactExports = BackendDriverCheckedMathMul(math, exportEstimate, int64(2), "csg_fact_exports")
    let csgFactNodeFiles = BackendDriverCheckedMathAdd(math, csgFactNodes, csgFactFiles, "csg_fact_node_files")
    let csgFactDeclExports = BackendDriverCheckedMathAdd(math, csgFactDecls, csgFactExports, "csg_fact_decl_exports")
    let csgFacts = BackendDriverCheckedMathAdd(math, csgFactNodeFiles, csgFactDeclExports, "csg_facts")
    var csgRounds = int64(3)
    if importEdges > int64(32):
        csgRounds = BackendDriverCheckedMathAdd(math, csgRounds, int64(1), "csg_rounds")
    let loweringFunctions = typedIrFunctions
    let loweringStatementOps = BackendDriverCheckedMathMul(math, typedIrStatements, int64(3), "lowering_statement_ops")
    let loweringBodyIrOps = BackendDriverCheckedMathAdd(math, loweringStatementOps, csgExprs, "lowering_body_ir_ops")
    let loweringLineStatements = BackendDriverCheckedMathMul(math, typedIrStatements, int64(12), "lowering_line_statements")
    let loweringLineFiles = BackendDriverCheckedMathMul(math, sourceFiles, int64(64), "lowering_line_files")
    let loweringLineMapBytes = BackendDriverCheckedMathAdd(math, loweringLineStatements, loweringLineFiles, "lowering_line_map")
    let primaryBodyWords = BackendDriverCheckedMathMul(math, loweringBodyIrOps, int64(2), "primary_body_words")
    let primaryFunctionWords = BackendDriverCheckedMathMul(math, typedIrFunctions, int64(16), "primary_function_words")
    let primaryInstructionWords = BackendDriverCheckedMathAdd(math, primaryBodyWords, primaryFunctionWords, "primary_instruction_words")
    let primaryImportRelocs = BackendDriverCheckedMathMul(math, importEdges, int64(2), "primary_import_relocs")
    let primaryRelocs = BackendDriverCheckedMathAdd(math, primaryImportRelocs, typedIrFunctions, "primary_relocs")
    let primaryFunctionLabels = BackendDriverCheckedMathDivCeil(math, typedIrFunctions, int64(4), "primary_function_labels")
    let primaryFileLabels = BackendDriverCheckedMathAdd(math, sourceFiles, primaryFunctionLabels, "primary_file_labels")
    let primaryDataLabels = BackendDriverCheckedMathAdd(math, primaryFileLabels, int64(1), "primary_data_labels")
    let primaryInstructionBytes = BackendDriverCheckedMathMul(math, primaryInstructionWords, int64(4), "primary_instruction_bytes")
    let primaryRelocBytes = BackendDriverCheckedMathMul(math, primaryRelocs, int64(24), "primary_reloc_bytes")
    let primaryLabelBytes = BackendDriverCheckedMathMul(math, primaryDataLabels, int64(32), "primary_label_bytes")
    let primaryObjectCodeBytes = BackendDriverCheckedMathAdd(math, primaryInstructionBytes, primaryRelocBytes, "primary_object_code")
    let primaryObjectMetadataBytes = BackendDriverCheckedMathAdd(math, primaryLabelBytes, formatFloorBytes, "primary_object_metadata")
    let primaryObjectLowerBytes = BackendDriverCheckedMathAdd(math, primaryObjectCodeBytes, primaryObjectMetadataBytes, "primary_object_lower")
    let primaryObjectBudgetDouble = BackendDriverCheckedMathMul(math, primaryObjectLowerBytes, int64(2), "primary_object_budget_double")
    let primaryObjectBudgetBytes = BackendDriverCheckedMathAdd(math, primaryObjectBudgetDouble, int64(4096), "primary_object_budget")
    let rssSourcePayloadBytes = BackendDriverCheckedMathMul(math, sourceBytes, int64(2), "rss_source_payload")
    let rssSourceFileBytes = BackendDriverCheckedMathMul(math, sourceFiles, int64(128), "rss_source_files")
    let rssSourceTextBytes = BackendDriverCheckedMathAdd(math, rssSourcePayloadBytes, rssSourceFileBytes, "rss_source_text")
    let rssCsgNodeBytes = BackendDriverCheckedMathMul(math, csgNodes, int64(40), "rss_csg_nodes")
    let rssCsgEdgeBytes = BackendDriverCheckedMathMul(math, csgEdges, int64(16), "rss_csg_edges")
    let rssCsgGraphBytes = BackendDriverCheckedMathAdd(math, rssCsgNodeBytes, rssCsgEdgeBytes, "rss_csg_graph")
    let rssExprLayerBytes = BackendDriverCheckedMathMul(math, csgExprs, int64(48), "rss_expr_layer")
    var typedFactMemoryModel: BackendDriverTypedFactMemoryModel
    var typedFactReason: str
    if !BackendDriverTypedFactMemoryModelTryBuild(csgFacts,
                                                   typedFactMemoryModel,
                                                   typedFactReason):
        reason = Fmt"typed_fact_{typedFactReason}"
        return false
    let rssTypedFactsBytes = typedFactMemoryModel.physicalStorageBytes
    let rssTypedIrFunctionBytes = BackendDriverCheckedMathMul(math, typedIrFunctions, int64(192), "rss_typed_ir_functions")
    let rssTypedIrStatementBytes = BackendDriverCheckedMathMul(math, typedIrStatements, int64(64), "rss_typed_ir_statements")
    let rssTypedIrBytes = BackendDriverCheckedMathAdd(math, rssTypedIrFunctionBytes, rssTypedIrStatementBytes, "rss_typed_ir")
    let rssLoweringOpBytes = BackendDriverCheckedMathMul(math, loweringBodyIrOps, int64(48), "rss_lowering_ops")
    let rssLoweringFunctionBytes = BackendDriverCheckedMathMul(math, loweringFunctions, int64(256), "rss_lowering_functions")
    let rssLoweringBytes = BackendDriverCheckedMathAdd(math, rssLoweringOpBytes, rssLoweringFunctionBytes, "rss_lowering")
    let rssPrimaryInstructionBytes = BackendDriverCheckedMathMul(math, primaryInstructionWords, int64(8), "rss_primary_instructions")
    let rssPrimaryRelocBytes = BackendDriverCheckedMathMul(math, primaryRelocs, int64(32), "rss_primary_relocs")
    let rssPrimaryLabelBytes = BackendDriverCheckedMathMul(math, primaryDataLabels, int64(64), "rss_primary_labels")
    let rssPrimaryCodeBytes = BackendDriverCheckedMathAdd(math, rssPrimaryInstructionBytes, rssPrimaryRelocBytes, "rss_primary_code")
    let rssPrimaryBytes = BackendDriverCheckedMathAdd(math, rssPrimaryCodeBytes, rssPrimaryLabelBytes, "rss_primary")
    let rssProviderBytes = int64(0)
    let rssLinkBytes = int64(0)
    let rssReportFileBytes = BackendDriverCheckedMathMul(math, sourceFiles, int64(64), "rss_report_files")
    let rssReportBytes = BackendDriverCheckedMathAdd(math, rssReportFileBytes, int64(4096), "rss_report")
    var rssModel: BackendDriverFullRssMemoryModel
    var rssReason: str
    if !BackendDriverFullRssMemoryModelTryBuild(rssSourceTextBytes,
                                                rssCsgGraphBytes,
                                                rssExprLayerBytes,
                                                rssTypedFactsBytes,
                                                rssTypedIrBytes,
                                                rssLoweringBytes,
                                                rssPrimaryBytes,
                                                rssProviderBytes,
                                                rssLinkBytes,
                                                rssReportBytes,
                                                typedIrFunctions,
                                                sourceFiles,
                                                hardwareMemoryBytes,
                                                rssModel,
                                                rssReason):
        reason = Fmt"rss_model_{rssReason}"
        return false
    var rssParallelModel: BackendDriverFullRssParallelMemoryModel
    var rssParallelReason: str
    if !BackendDriverFullRssParallelMemoryModelTryBuild(
           rssModel,
           requestedJobsValue,
           hardwareJobsValue,
           memoryLimitBytes,
           rssParallelModel,
           rssParallelReason):
        reason = Fmt"rss_parallel_model_{rssParallelReason}"
        return false
    let sourceFileTime = BackendDriverCheckedMathMul(math, sourceFiles, int64(200000), "time_source_files")
    let sourceByteTime = BackendDriverCheckedMathMul(math, sourceBytes, int64(50), "time_source_bytes")
    let sourceContentTime = BackendDriverCheckedMathAdd(math, sourceFileTime, sourceByteTime, "time_source_content")
    let sourcePhaseNs = BackendDriverCheckedMathMax(math, sourceClosureNs, sourceContentTime, "time_source_phase")
    let csgNodeTime = BackendDriverCheckedMathMul(math, csgNodes, int64(3000), "time_csg_nodes")
    let csgFactTime = BackendDriverCheckedMathMul(math, csgFacts, int64(1200), "time_csg_facts")
    let csgExprTime = BackendDriverCheckedMathMul(math, csgExprs, int64(2000), "time_csg_exprs")
    let csgNodeFactTime = BackendDriverCheckedMathAdd(math, csgNodeTime, csgFactTime, "time_csg_node_facts")
    let csgPhaseNs = BackendDriverCheckedMathAdd(math, csgNodeFactTime, csgExprTime, "time_csg_phase")
    let typedIrFunctionTime = BackendDriverCheckedMathMul(math, typedIrFunctions, int64(70000), "time_typed_ir_functions")
    let typedIrStatementTime = BackendDriverCheckedMathMul(math, typedIrStatements, int64(1200), "time_typed_ir_statements")
    let typedIrPhaseNs = BackendDriverCheckedMathAdd(math, typedIrFunctionTime, typedIrStatementTime, "time_typed_ir_phase")
    let loweringOpTime = BackendDriverCheckedMathMul(math, loweringBodyIrOps, int64(2500), "time_lowering_ops")
    let loweringFunctionTime = BackendDriverCheckedMathMul(math, loweringFunctions, int64(50000), "time_lowering_functions")
    let loweringPhaseNs = BackendDriverCheckedMathAdd(math, loweringOpTime, loweringFunctionTime, "time_lowering_phase")
    let primaryInstructionTime = BackendDriverCheckedMathMul(math, primaryInstructionWords, int64(1000), "time_primary_instructions")
    let primaryRelocTime = BackendDriverCheckedMathMul(math, primaryRelocs, int64(5000), "time_primary_relocs")
    let primaryLabelTime = BackendDriverCheckedMathMul(math, primaryDataLabels, int64(3000), "time_primary_labels")
    let primaryCodeTime = BackendDriverCheckedMathAdd(math, primaryInstructionTime, primaryRelocTime, "time_primary_code")
    let primaryPhaseNs = BackendDriverCheckedMathAdd(math, primaryCodeTime, primaryLabelTime, "time_primary_phase")
    let providerPhaseNs = int64(0)
    var linkPhaseNs = int64(1000000)
    if formatFloorBytes >= int64(4096):
        linkPhaseNs = int64(5000000)
    let reportFileTime = BackendDriverCheckedMathMul(math, sourceFiles, int64(50000), "time_report_files")
    let reportPhaseNs = BackendDriverCheckedMathAdd(math, reportFileTime, int64(250000), "time_report_phase")
    let serialSourceCsg = BackendDriverCheckedMathAdd(math, sourcePhaseNs, csgPhaseNs, "time_serial_source_csg")
    let serialTypedProvider = BackendDriverCheckedMathAdd(math, typedIrPhaseNs, providerPhaseNs, "time_serial_typed_provider")
    let serialLinkReport = BackendDriverCheckedMathAdd(math, linkPhaseNs, reportPhaseNs, "time_serial_link_report")
    let serialLeft = BackendDriverCheckedMathAdd(math, serialSourceCsg, serialTypedProvider, "time_serial_left")
    let serialPhaseNs = BackendDriverCheckedMathAdd(math, serialLeft, serialLinkReport, "time_serial_phase")
    let parallelizablePhaseNs = BackendDriverCheckedMathAdd(math, loweringPhaseNs, primaryPhaseNs, "time_parallelizable_phase")
    let parallelShareNs = BackendDriverCheckedMathDivCeil(math, parallelizablePhaseNs, rssParallelModel.effectiveJobs, "time_parallel_share")
    let lowerBoundNs = BackendDriverCheckedMathAdd(math, serialPhaseNs, parallelShareNs, "time_lower_bound")
    let budgetTripleNs = BackendDriverCheckedMathMul(math, lowerBoundNs, int64(3), "time_budget_triple")
    let budgetUpperNs = BackendDriverCheckedMathAdd(math, budgetTripleNs, int64(20000000), "time_budget")
    let providerLowerBytes = int64(0)
    let providerBudgetBytes = int64(0)
    let finalObjectProviderLower = BackendDriverCheckedMathAdd(math, primaryObjectLowerBytes, providerLowerBytes, "size_final_object_provider_lower")
    let finalArtifactLowerBytes = BackendDriverCheckedMathAdd(math, finalObjectProviderLower, formatFloorBytes, "size_final_artifact_lower")
    let finalObjectProviderBudget = BackendDriverCheckedMathAdd(math, primaryObjectBudgetBytes, providerBudgetBytes, "size_final_object_provider_budget")
    let finalArtifactBudgetBytes = BackendDriverCheckedMathAdd(math, finalObjectProviderBudget, formatFloorBytes, "size_final_artifact_budget")
    if !math.ok:
        reason = math.reason
        return false
    BackendDriverDryCompileAppendLine(out, "dry_compile_full_theory_model=full_compile_theory_deterministic_framework")
    BackendDriverDryCompileAppendLine(out, "dry_compile_full_theory_requires_real_validation=1")
    BackendDriverDryCompileAppendLine(out, "dry_compile_full_theory_executes_codegen=0")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_framework=canonical")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_requires_real_validation=1")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_calibration_source=phase_memory_ledger")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_validation_status=unvalidated")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_scope=non_exhaustive_modeled_compile_estimate_without_codegen_execution")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_bound_status=not_proven_upper_bound")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_model=deterministic_source_closure_hardware_coefficients")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_files={sourceFiles}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_lines={sourceLines}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_bytes={sourceBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_import_edges={importEdges}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_decl_estimate={declEstimate}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_function_estimate={functionEstimate}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_export_estimate={exportEstimate}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_importc_estimate={importcCount}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_call_edge_estimate={callEdgeEstimate}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_source_closure_type_ref_estimate={typeRefEstimate}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_csg_nodes={csgNodes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_csg_edges={csgEdges}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_csg_facts={csgFacts}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_csg_exprs={csgExprs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_typed_ir_funcs={typedIrFunctions}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_typed_ir_statements={typedIrStatements}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_typed_ir_rounds={csgRounds}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_lowering_funcs={loweringFunctions}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_lowering_body_ir_ops={loweringBodyIrOps}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_lowering_line_map_bytes={loweringLineMapBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_primary_instruction_words={primaryInstructionWords}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_primary_relocs={primaryRelocs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_primary_data_labels={primaryDataLabels}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_phase_primary_object_bytes={primaryObjectLowerBytes}")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_phase_provider_object_count=0")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_phase_provider_object_bytes=0")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_phase_native_object_count=0")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_phase_native_object_bytes=0")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_phase_link_input_count=0")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_phase_link_input_bytes=0")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_nodes={csgNodes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_edges={csgEdges}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_facts={csgFacts}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_exprs={csgExprs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_typed_ir_functions={typedIrFunctions}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_typed_ir_statements={typedIrStatements}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_compiler_csg_estimated_rounds={csgRounds}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_lowering_estimated_functions={loweringFunctions}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_lowering_estimated_body_ir_ops={loweringBodyIrOps}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_lowering_estimated_line_map_bytes={loweringLineMapBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_primary_estimated_instruction_words={primaryInstructionWords}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_primary_estimated_relocs={primaryRelocs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_primary_estimated_data_labels={primaryDataLabels}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_primary_estimated_object_bytes_lower_bound={primaryObjectLowerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_primary_estimated_object_bytes_budget_upper_bound={primaryObjectBudgetBytes}")
    BackendDriverDryCompileAppendLine(out,
                                      BackendDriverFullRssMemoryModelReport(rssModel,
                                                                             typedFactMemoryModel))
    BackendDriverDryCompileAppendLine(
        out,
        BackendDriverFullRssParallelMemoryModelReport(rssParallelModel))
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_requested_jobs={requestedJobsValue}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_hardware_jobs={hardwareJobsValue}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_effective_jobs={rssParallelModel.effectiveJobs}")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_time_cpu_model=deterministic_source_content_costs")
    BackendDriverDryCompileAppendLine(out, "full_compile_theory_time_memory_bandwidth_model=not_measured")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_source_closure_phase_ns={sourcePhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_compiler_csg_phase_ns={csgPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_typed_ir_phase_ns={typedIrPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_lowering_phase_ns={loweringPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_primary_phase_ns={primaryPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_provider_phase_ns={providerPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_link_phase_ns={linkPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_report_phase_ns={reportPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_source_ns={sourcePhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_source_ms={BackendDriverMsText(sourcePhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_csg_ns={csgPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_csg_ms={BackendDriverMsText(csgPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_typed_ir_ns={typedIrPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_typed_ir_ms={BackendDriverMsText(typedIrPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_lowering_ns={loweringPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_lowering_ms={BackendDriverMsText(loweringPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_primary_ns={primaryPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_primary_ms={BackendDriverMsText(primaryPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_provider_ns={providerPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_provider_ms={BackendDriverMsText(providerPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_link_ns={linkPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_link_ms={BackendDriverMsText(linkPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_report_ns={reportPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_phase_report_ms={BackendDriverMsText(reportPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_serial_phase_ns={serialPhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_serial_phase_ms={BackendDriverMsText(serialPhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_parallelizable_phase_ns={parallelizablePhaseNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_parallelizable_phase_ms={BackendDriverMsText(parallelizablePhaseNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_lower_bound_ns={lowerBoundNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_lower_bound_ms={BackendDriverMsText(lowerBoundNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_budget_upper_bound_ns={budgetUpperNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_budget_upper_bound_ms={BackendDriverMsText(budgetUpperNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_time_guard_recommended_ms={BackendDriverMsText(budgetUpperNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_size_object_lower_bound_bytes={primaryObjectLowerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_size_object_budget_upper_bound_bytes={primaryObjectBudgetBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_size_provider_lower_bound_bytes={providerLowerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_size_provider_budget_upper_bound_bytes={providerBudgetBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_size_final_artifact_lower_bound_bytes={finalArtifactLowerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"full_compile_theory_size_final_artifact_budget_upper_bound_bytes={finalArtifactBudgetBytes}")
    return true

fn BackendDriverDryCompileParsePositiveInt64(textRaw: str): int64 =
    let text = strutil.Strip(textRaw)
    if len(text) <= 0:
        return int64(-1)
    var value: uint64
    for i in 0..<len(text):
        let ch = text[i]
        if ch < '0' || ch > '9':
            return int64(-1)
        let digit = uint64(int32(ch) - int32('0'))
        if value > uint64(1844674407370955161):
            return int64(-1)
        if value == uint64(1844674407370955161) &&
           digit > uint64(5):
            return int64(-1)
        value = value * uint64(10) + digit
    if value <= uint64(0) ||
       value > uint64(9223372036854775807):
        return int64(-1)
    return int64(value)

fn BackendDriverDryCompileConfiguredMemoryLimitBytes(): int64 =
    let configured = strutil.Strip(
        os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES"))
    if len(configured) <= 0:
        return int64(8589934592)
    return BackendDriverDryCompileParsePositiveInt64(configured)

fn BackendDriverDryCompileReport(rootDir: str,
                                  linkPlan: slplan.SystemLinkPlanStub,
                                  sourcePathsRaw: str[],
                                  importEdgeCount: int32,
                                  unresolvedImportCount: int32,
                                  systemLinkPlanNs: int64,
                                  sourceClosureNs: int64,
                                  totalNsRaw: int64,
                                  outErr: var str): str =
    outErr = ""
    var sourceFiles: int64
    var sourceLines: int64
    var sourceBytes: int64
    var maxSourceBytes: int64
    var declCount: int64
    var functionCount: int64
    var exportCount: int64
    var importcCount: int64
    var callEdgeCount: int64
    var typeRefCount: int64
    var statsErr: str
    var sourcePaths = sourcePathsRaw
    if sourcePaths.len <= 0 && len(linkPlan.entryPath) > 0:
        add(sourcePaths, linkPlan.entryPath)
    if !BackendDriverDryCompileSourceStats(rootDir,
                                           sourcePaths,
                                           sourceFiles,
                                           sourceLines,
                                           sourceBytes,
                                           maxSourceBytes,
                                           declCount,
                                           functionCount,
                                           exportCount,
                                           importcCount,
                                           callEdgeCount,
                                           typeRefCount,
                                           statsErr):
        outErr = statsErr
        return Fmt"dry_compile=0\nerror={statsErr}"
    let requestedJobs = BackendDriverPositiveJobs(linkPlan.jobCount)
    let hardwareJobs = BackendDriverHardwareParallelism()
    let effectiveJobs = BackendDriverEffectiveParallelJobs(requestedJobs, hardwareJobs)
    let hardwareMemoryBytes = os.SystemMemoryTotalBytes()
    let memoryLimitBytes = BackendDriverDryCompileConfiguredMemoryLimitBytes()
    let totalNs = BackendDriverPositiveNs(totalNsRaw)
    let serialNs = BackendDriverPositiveNs(systemLinkPlanNs)
    let parallelizableNs = BackendDriverPositiveNs(sourceClosureNs)
    let lowerBoundNs = serialNs + BackendDriverDivCeilI64(parallelizableNs, effectiveJobs)
    let emitText = creq.CompilerEmitText(linkPlan.emitKind)
    let textLowerBytes = int64(0)
    let formatFloorBytes = BackendDriverDryCompileFormatFloorBytes(linkPlan.targetTriple,
                                                                   emitText)
    let outputLowerBytes = textLowerBytes + formatFloorBytes
    let memoryLowerBytes = BackendDriverMaxI64(maxSourceBytes, textLowerBytes)
    var out = ""
    BackendDriverDryCompileAppendLine(out, "dry_compile=1")
    BackendDriverDryCompileAppendLine(out, "dry_compile_command=dry-compile")
    BackendDriverDryCompileAppendLine(out, "compiler_impl=pure_cheng_backend_driver")
    BackendDriverDryCompileAppendLine(out, "dry_compile_input_contract_compiler=pure_cheng_backend_driver")
    BackendDriverDryCompileAppendLine(out, "dry_compile_input_contract_model=full_compile_theory_deterministic_framework")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_target_triple={linkPlan.targetTriple}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_emit_kind={emitText}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_entry_source={linkPlan.entryPath}")
    BackendDriverDryCompileAppendLine(out, "dry_compile_input_contract_provider_state=disabled")
    BackendDriverDryCompileAppendLine(out, "dry_compile_input_contract_link_state=disabled")
    BackendDriverDryCompileAppendLine(out, "dry_compile_input_contract_cache_state=none")
    BackendDriverDryCompileAppendLine(out, "dry_compile_input_contract_provider_cache_state=none")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_hardware_logical_cpus={hardwareJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_hardware_memory_bytes={hardwareMemoryBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_memory_limit_bytes={memoryLimitBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_backend_jobs={requestedJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_contract_effective_jobs={effectiveJobs}")
    BackendDriverDryCompileAppendLine(out, "dry_compile_model=source_closure_hardware_theory_without_codegen")
    BackendDriverDryCompileAppendLine(out, "dry_compile_executes_codegen=0")
    BackendDriverDryCompileAppendLine(out, "dry_compile_source_closure_mode=import_header_bfs")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_entry={linkPlan.entryPath}")
    BackendDriverDryCompileAppendLine(out, Fmt"target={linkPlan.targetTriple}")
    BackendDriverDryCompileAppendLine(out, Fmt"emit={emitText}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_source_file_count={sourceFiles}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_source_line_count={sourceLines}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_source_byte_count={sourceBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_input_source_max_file_bytes={maxSourceBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_import_edge_count={importEdgeCount}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_unresolved_import_count={unresolvedImportCount}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_hardware_logical_cpus={hardwareJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_hardware_memory_bytes={hardwareMemoryBytes}")
    var hardwareMemoryStatusLine = "dry_compile_hardware_memory_status=unavailable"
    if hardwareMemoryBytes > int64(0):
        hardwareMemoryStatusLine = "dry_compile_hardware_memory_status=ok"
    BackendDriverDryCompileAppendLine(out, hardwareMemoryStatusLine)
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_requested_jobs={requestedJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_hardware_jobs={hardwareJobs}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_effective_jobs={effectiveJobs}")
    BackendDriverDryCompileAppendLine(out, "compile_parallel_theory_scope=dry_compile_precheck")
    BackendDriverDryCompileAppendLine(out, "compile_parallel_theory_model=dry_compile_precheck_system_plan_plus_source_closure_div_effective_jobs")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_serial_phase_ns={serialNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_serial_phase_ms={BackendDriverMsText(serialNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallelizable_phase_ns={parallelizableNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallelizable_phase_ms={BackendDriverMsText(parallelizableNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_theory_lower_bound_ns={lowerBoundNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_theory_lower_bound_ms={BackendDriverMsText(lowerBoundNs)}")
    BackendDriverDryCompileAppendLine(out, "compile_parallel_real_scope=dry_compile_precheck")
    BackendDriverDryCompileAppendLine(out, "compile_parallel_real_executes_codegen=0")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_real_ns={totalNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_real_ms={BackendDriverMsText(totalNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_real_over_theory_x={BackendDriverRatioMilliText(totalNs, lowerBoundNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_real_over_theory_percent={BackendDriverPercentMilliText(totalNs, lowerBoundNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"compile_parallel_theory_efficiency_percent={BackendDriverPercentMilliText(lowerBoundNs, totalNs)}")
    BackendDriverDryCompileAppendLine(out, "dry_compile_primary_instruction_word_count=0")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_text_size_lower_bound_bytes={textLowerBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_format_floor_bytes={formatFloorBytes}")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_output_size_theory_lower_bound_bytes={outputLowerBytes}")
    BackendDriverDryCompileAppendLine(out, "dry_compile_memory_theory_scope=dry_compile_source_scan")
    BackendDriverDryCompileAppendLine(out, "dry_compile_memory_theory_model=max_source_file_bytes_without_codegen")
    BackendDriverDryCompileAppendLine(out, Fmt"dry_compile_memory_theory_lower_bound_bytes={memoryLowerBytes}")
    var fullTheoryReason: str
    if !BackendDriverAppendFullTheoryReport(out,
                                            sourceFiles,
                                            sourceLines,
                                            sourceBytes,
                                            importEdgeCount,
                                            declCount,
                                            functionCount,
                                            exportCount,
                                            importcCount,
                                            callEdgeCount,
                                            typeRefCount,
                                            sourceClosureNs,
                                            formatFloorBytes,
                                            requestedJobs,
                                            hardwareJobs,
                                            effectiveJobs,
                                            hardwareMemoryBytes,
                                            memoryLimitBytes,
                                            fullTheoryReason):
        panic(Fmt"backend_driver_full_theory_report_invalid reason={fullTheoryReason}")
    BackendDriverDryCompileAppendLine(out, Fmt"exec_phase_system_link_plan_ns={systemLinkPlanNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"exec_phase_system_link_plan_ms={BackendDriverMsText(systemLinkPlanNs)}")
    BackendDriverDryCompileAppendLine(out, Fmt"exec_phase_source_closure_ns={sourceClosureNs}")
    BackendDriverDryCompileAppendLine(out, Fmt"exec_phase_source_closure_ms={BackendDriverMsText(sourceClosureNs)}")
    BackendDriverDryCompileAppendLine(out, "exec_phase_source_bundle_ms=0")
    BackendDriverDryCompileAppendLine(out, "exec_phase_compiler_csg_ms=0")
    BackendDriverDryCompileAppendLine(out, "exec_phase_world_ms=0")
    BackendDriverDryCompileAppendLine(out, "exec_phase_lowering_plan_ms=0")
    BackendDriverDryCompileAppendLine(out, "exec_phase_primary_object_plan_ms=0")
    BackendDriverDryCompileAppendLine(out, "exec_phase_provider_sources_ms=0")
    BackendDriverDryCompileAppendLine(out, "exec_phase_object_plan_ms=0")
    BackendDriverDryCompileAppendLine(out, "exec_phase_native_link_plan_ms=0")
    BackendDriverDryCompileAppendLine(out, Fmt"exec_phase_total_ms={BackendDriverMsText(totalNs)}")
    BackendDriverDryCompileAppendLine(out, "exec_retained_payload_approx_bytes=0")
    return out

fn BackendDriverRunDryCompile(rootDir: str,
                               args: str[]): int32 =
    let reqRes = creq.CompilerRequestFromArgsForCommand(rootDir, args, false)
    if IsErr(reqRes):
        let err = Error(reqRes)
        let reportPath = creq.CompilerReadFlagOrDefault(args, "--report-out", "")
        let report = Fmt"dry_compile=0\nerror={err}\n"
        let _ = BackendDriverWriteOptionalReport(rootDir, reportPath, report)
        BackendDriverPrintErr(err)
        return 2
    let req = BackendDriverRequestWithAbsoluteSourcePath(
        rootDir,
        Value(reqRes),
        chengpath.PathAbsolute(
            rootDir, "artifacts/dry-compile/dry-output"))
    let dryCompileStartNs = sexec.SystemLinkExecNowNs()
    var linkPlan: slplan.SystemLinkPlanStub
    var linkErr: str
    let systemPlanStartNs = sexec.SystemLinkExecNowNs()
    if !slplan.BuildSystemLinkPlanStub(rootDir, req, linkPlan, linkErr):
        let report = Fmt"dry_compile=0\nerror={linkErr}\n"
        let _ = BackendDriverWriteOptionalReport(rootDir, req.reportPath, report)
        BackendDriverPrintErr(linkErr)
        return 2
    let systemPlanNs = sexec.SystemLinkExecNowNs() - systemPlanStartNs
    var sourcePaths: str[]
    var importEdgeCount: int32
    var unresolvedImportCount: int32
    var closureErr: str
    let sourceClosureStartNs = sexec.SystemLinkExecNowNs()
    if !BackendDriverDryCompileCollectSourceClosure(rootDir,
                                                    linkPlan.packageRoot,
                                                    linkPlan.entryPath,
                                                    sourcePaths,
                                                    importEdgeCount,
                                                    unresolvedImportCount,
                                                    closureErr):
        let report = Fmt"dry_compile=0\nerror={closureErr}\n"
        let _ = BackendDriverWriteOptionalReport(rootDir, req.reportPath, report)
        BackendDriverPrintErr(closureErr)
        return 2
    let sourceClosureNs = sexec.SystemLinkExecNowNs() - sourceClosureStartNs
    if sourcePaths.len != linkPlan.sourceClosurePaths.len ||
       importEdgeCount != linkPlan.importEdges.len ||
       unresolvedImportCount != linkPlan.unresolvedImportCount:
        let identityErr = Fmt"backend driver dry-compile: independently collected closure disagrees with sealed system link plan closure={sourcePaths.len}/{linkPlan.sourceClosurePaths.len} imports={importEdgeCount}/{linkPlan.importEdges.len} unresolved={unresolvedImportCount}/{linkPlan.unresolvedImportCount}"
        let report = Fmt"dry_compile=0\nerror={identityErr}\n"
        let _ = BackendDriverWriteOptionalReport(rootDir, req.reportPath, report)
        BackendDriverPrintErr(identityErr)
        return 2
    for sourceIndex in 0..<sourcePaths.len:
        if sourcePaths[sourceIndex] != linkPlan.sourceClosurePaths[sourceIndex]:
            let identityErr = Fmt"backend driver dry-compile: independently collected closure row disagrees with sealed system link plan index={sourceIndex}"
            let report = Fmt"dry_compile=0\nerror={identityErr}\n"
            let _ = BackendDriverWriteOptionalReport(rootDir, req.reportPath, report)
            BackendDriverPrintErr(identityErr)
            return 2
    dryCompileStartNs
    let totalNs = systemPlanNs + sourceClosureNs
    var reportErr: str
    let report = BackendDriverDryCompileReport(rootDir,
                                               linkPlan,
                                               sourcePaths,
                                               importEdgeCount,
                                               unresolvedImportCount,
                                               systemPlanNs,
                                               sourceClosureNs,
                                               totalNs,
                                               reportErr)
    if !BackendDriverWriteOptionalReport(rootDir, req.reportPath, Fmt"{report}\n"):
        BackendDriverPrintErr(Fmt"backend driver dry-compile: failed to write report: {req.reportPath}")
        return 1
    BackendDriverPrintLine(report)
    if len(reportErr) > 0:
        return 2
    if linkPlan.missingReasons.len > 0:
        return 2
    return 0

fn BackendDriverRunParseReceipt(rootDir: str,
                                args: str[]): int32 =
    let sourcePath = BackendDriverReadFlag(args, "--in", "")
    let outPath = BackendDriverReadFlag(args, "--out", "")
    let driverPath = BackendDriverCurrentExecutablePath(rootDir)
    let runRes = parsecommand.CompilerParseReceiptCommandRun(
        rootDir, sourcePath, outPath, driverPath)
    if !runRes.ok:
        BackendDriverPrintErr(
            "backend driver parse-receipt:" + runRes.err.msg)
        return 2
    BackendDriverPrintLine(runRes.value)
    return 0

fn BackendDriverForward(rootDir: str,
                          cmd: str,
                          args: str[]): int32 =
    let stage3Path = BackendDriverStage3Path(rootDir)
    let logDir = chengpath.PathAbsolute(rootDir, "artifacts/forward")
    let _ = chengpath.MkdirP(rootDir, logDir)
    let logPath = chengpath.PathAbsolute(rootDir, "artifacts/forward/backend_driver.forward.log")
    var forwardArgs: str[]
    var forwardEnv: str[]
    add(forwardEnv, "CHENG_NO_BACKEND_DRIVER_HANDOFF=1")
    add(forwardArgs, cmd)
    for i in 0..<args.len:
        add(forwardArgs, strings.CloneStr(args[i]))
    let run = hostops.RunFileLogged(rootDir,
                                      "backend_driver_forward",
                                      stage3Path,
                                      forwardArgs,
                                      forwardEnv,
                                      rootDir,
                                      0,
                                      logPath)
    let outputText = strutil.Strip(run.output)
    if len(outputText) > 0:
        if run.exitCode != 0:
            BackendDriverPrintErr(outputText)
        else:
            BackendDriverPrintLine(outputText)
    elif run.exitCode != 0:
        BackendDriverPrintErr(" backend driver: forward failed")
    return run.exitCode

fn BackendDriverStatus(rootDir: str) =
    BackendDriverPrintLine("cheng")
    BackendDriverPrintLine("schema=cheng.compiler_runtime")
    BackendDriverPrintLine("execution=argv_control_plane")
    BackendDriverPrintLine("bootstrap_mode=selfhost")
    let compilerEntry = chengpath.PathAbsolute(rootDir, "src/core/tooling/backend_driver_main.cheng")
    BackendDriverPrintLine(strutil.Join(["compiler_entry=", compilerEntry], ""))
    BackendDriverPrintLine("ordinary_command=system-link-exec")
    BackendDriverPrintLine("ordinary_pipeline=canonical_csg_verified_primary_object_codegen_ready")
    let stage3Path = BackendDriverStage3Path(rootDir)
    BackendDriverPrintLine(strutil.Join(["stage3=", stage3Path], ""))

fn BackendDriverMainDispatch(rootDir: str,
                              count: int32): int32 =
    return BackendDriverToolDispatch(rootDir, count)

fn BackendDriverRunCidCaseFromCmdline(count: int32): int32 =
    let programPath = BackendDriverParamStr(0)
    let command = BackendDriverParamStr(1)
    let caseId = BackendDriverParamStr(2)
    let candidateSha256 = BackendDriverParamStr(3)
    # paramCount excludes argv[0], while the current CID contract binds the
    # complete process vector.  Pass the raw argc used by dispatch_min.
    let argc = count + 1
    var tarPayload: str
    var err: str
    if !cidcurrent.CidIdentityEvidenceCurrentRunCase(
            argc,
            programPath,
            command,
            caseId,
            candidateSha256,
            tarPayload,
            err):
        BackendDriverPrintErr(err)
        return 2
    os.Write(BackendDriverStdoutBridge(), tarPayload)
    return 0

fn BackendDriverToolDispatch(rootDir: str,
                              count: int32): int32 =
    let cmd = BackendDriverParamStr(1)
    if cmd == "run-case":
        return BackendDriverRunCidCaseFromCmdline(count)
    let args = BackendDriverCollectArgsFrom(2, count)
    if len(cmd) > 0:
        if count <= 2 && (cmd == "help" || cmd == "-h" || cmd == "--help"):
            BackendDriverUsage(rootDir)
            return 0
        if count <= 2 && cmd == "status":
            BackendDriverStatus(rootDir)
            return 0
        if cmd == "print-build-plan":
            BackendDriverPrintBuildPlan(rootDir, args)
            return 0
        if cmd == "dry-compile":
            return BackendDriverRunDryCompile(rootDir, args)
        if cmd == "parse-receipt":
            return BackendDriverRunParseReceipt(rootDir, args)
        if cmd == "print-bootstrap":
            BackendDriverPrintBootstrap(rootDir)
            return 0
        if cmd == "support-matrix":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "scan-hotpath":
            return BackendDriverScanHotpath(rootDir)
        if cmd == "host-bridge-audit":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-smokes":
            return BackendDriverRunSmokes(rootDir)
        if cmd == "run-host-smokes":
            return BackendDriverRunHostSmokes(rootDir, args)
        if cmd == "run-stage23-libp2p-smokes":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "slice-gate":
            return BackendDriverSliceGate(rootDir)
        if cmd == "debug-report":
            return BackendDriverRunDebugTextCommand(rootDir, args, cmd)
        if cmd == "print-symbols":
            return BackendDriverRunDebugTextCommand(rootDir, args, cmd)
        if cmd == "print-line-map":
            return BackendDriverRunDebugTextCommand(rootDir, args, cmd)
        if cmd == "print-asm":
            return BackendDriverRunDebugTextCommand(rootDir, args, cmd)
        if cmd == "print-object":
            return BackendDriverRunObjectReportCommand(rootDir, args)
        if cmd == "print-elf":
            return BackendDriverRunObjectReportCommand(rootDir, args)
        if cmd == "profile-run":
            return BackendDriverRunProfileRun(rootDir, args)
        if cmd == "profile-report":
            return BackendDriverRunProfileReport(rootDir, args)
        if cmd == "crash-report":
            return BackendDriverRunCrashReport(rootDir, args)
        if cmd == "run-browser-host-wasm-smoke":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-wasm-smokes":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "build-browser-host-wasm":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "build-linux-nolibc-exe":
            return BackendDriverBuildLinuxNolibcExe(rootDir)
        if cmd == "build-zero-exit":
            return BackendDriverBuildZeroExit(rootDir)
        if cmd == "build-panic-trace":
            return BackendDriverBuildPanicTrace(rootDir)
        if cmd == "build-bounds-trace":
            return BackendDriverBuildBoundsTrace(rootDir)
        if cmd == "build-signal-trace":
            return BackendDriverBuildSignalTrace(rootDir)
        if cmd == "build-call-chain":
            return BackendDriverBuildCallChain(rootDir)
        if cmd == "build-ffi-handle":
            return BackendDriverBuildFfiHandle(rootDir)
        if cmd == "build-program-selfhost":
            return BackendDriverBuildProgramSelfhost(rootDir)
        if cmd == "build-bft-state-machine":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "deploy-bft-validator-three-node":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "verify-bft-validator-three-node":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "status-bft-validator-three-node":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "stop-bft-validator-three-node":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "bench-bft-validator-three-node":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "build-rwad-bft-state-machine":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-udp-importc-smoke":
            return BackendDriverRunUdpImportcSmoke(rootDir, args)
        if cmd == "run-tcp-twoproc-smoke":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-quic-twoproc-smoke":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-tailnet-control-smoke":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-fresh-node-selfhost-gate":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-migration-gate":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-browser-webrtc-smokes":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "r2c-react":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "verify-export-visibility":
            return evgate.ExportVisibilityGateRun(rootDir)
        if cmd == "verify-export-visibility-parallel":
            return evgate.ExportVisibilityGateRunParallel(rootDir)
        if cmd == "verify-orphan-guard":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "verify-backend-driver-command-surface":
            return BackendDriverRunBuiltinHostSmoke(rootDir,
                                                     "verify_backend_driver_command_surface",
                                                     "backend_driver_command_surface_smoke")
        if cmd == "verify-backend-egraph-cost" || cmd == "verify_backend_egraph_cost":
            return BackendDriverVerifyBackendEgraphCost(rootDir, args)
        if cmd == "verify-mobile-shell-build-probe":
            return BackendDriverRunBuiltinHostSmoke(rootDir,
                                                     "verify_mobile_shell_build_probe",
                                                     "mobile_shell_build_probe_smoke")
        if cmd == "verify-r2c-react-surface":
            return BackendDriverRunR2cReactSurface(rootDir)
        if cmd == "verify-debug-profile":
            return BackendDriverVerifyDebugProfile(rootDir)
        if cmd == "verify-debug-tools":
            return BackendDriverVerifyDebugTools(rootDir)
        if cmd == "verify-debug-runtime":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "verify-diloco":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "verify-windows-builtin":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "verify-riscv64-builtin":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "run-cross-target-smokes":
            return BackendDriverForward(rootDir, cmd, args)
        if cmd == "system-link-exec":
            # The argv-driven compile fallback and the fake token consume
            # (return 0 without compiling) are retired.  This driver binary
            # is never the admitted production child: without a live held-exec
            # admission the only honest shape is HARD_RED.
            let heldImport = system.RuntimeHeldExecChildImport()
            if heldImport < 0:
                BackendDriverPrintErr("HARD_RED:production_held_exec_ticket_import_failed")
                return 2
            if heldImport != 1:
                BackendDriverPrintErr("HARD_RED:production_held_exec_launcher_required")
                return 2
            BackendDriverPrintErr("HARD_RED:backend_driver_system_link_exec_not_production_entry")
            return 2
    return BackendDriverForward(rootDir, cmd, args)

fn BackendDriverMain(): int32 =
    let rootDir = BackendDriverRoot()
    BackendDriverEnsureRootEnv(rootDir)
    let count = BackendDriverParamCountBridge()
    if count <= 0:
        BackendDriverUsage(rootDir)
        return 0
    return BackendDriverMainDispatch(rootDir, count)

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    return BackendDriverMain()
