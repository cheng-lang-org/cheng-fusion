    add(i32MaddCompileArgs, strutil.Join(["--in:", i32MaddSrc], ""))
    add(i32MaddCompileArgs, "--emit:obj")
    add(i32MaddCompileArgs, "--target:arm64-apple-darwin")
    add(i32MaddCompileArgs, strutil.Join(["--out:", i32MaddObj], ""))
    add(i32MaddCompileArgs, strutil.Join(["--report-out:", i32MaddReport], ""))
    let i32MaddCompileRun = hostops.RunFileLogged(rootDir,
                                                   strutil.Join(["backend_driver_direct_object_i32_madd_compile_", label], ""),
                                                   compilerPath,
                                                   i32MaddCompileArgs,
                                                   compileEnv,
                                                   rootDir,
                                                   420,
                                                   i32MaddCompileLog)
    if !hostops.LoggedRunOk(i32MaddCompileRun):
        let outputText = strutil.Strip(i32MaddCompileRun.output)
        if len(outputText) > 0:
            BackendDriverPrintErr(outputText)
        return i32MaddCompileRun.exitCode
    if !chengpath.FileExistsNonEmpty(rootDir, i32MaddObj):
        BackendDriverPrintErr(strutil.Join(["direct object writer smoke: missing i32 madd object: ", i32MaddObj], ""))
        return 1
    if !chengpath.FileExistsNonEmpty(rootDir, i32MaddReport):
