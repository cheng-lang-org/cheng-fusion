import std/cmdline
import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/inference/hf_model_graph as hfgraph
import cheng/inference/weight_store as ws

fn hfGlm52ReplayPrintOut(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn hfGlm52ReplayPrintErr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

fn hfGlm52ReplayUsage(): str =
    return "usage: hf_glm52_w4afp8_replay --config <config.json> --index <model.safetensors.index.json> [--model-cid <cid>] [--base-dir <dir>] [--peer-id <peer>] [--tensor-scale <scale>] [--preflight-shards] [--hash-shard-payloads] [--payload-chunk-bytes <bytes>]"

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var configPath: str
    var indexPath: str
    var modelCid = "cid:hf:glm52-w4afp8:audit"
    var baseDir = "/tmp/cheng-glm52-w4afp8-shards"
    var peerId = "peer:hf-glm52-w4afp8-audit"
    var tensorScale: int32 = 1000
    var payloadChunkBytes: int32 = 67108864
    let preflightShards = cmdline.HasFlag("--preflight-shards")
    let hashShardPayloads = cmdline.HasFlag("--hash-shard-payloads")
    if !cmdline.ReadFirstFlagValue("--config", configPath):
        hfGlm52ReplayPrintErr(hfGlm52ReplayUsage())
        return 2
    if !cmdline.ReadFirstFlagValue("--index", indexPath):
        hfGlm52ReplayPrintErr(hfGlm52ReplayUsage())
        return 2
    var optionalText: str
    if cmdline.ReadFirstFlagValue("--model-cid", optionalText):
        modelCid = optionalText
    if cmdline.ReadFirstFlagValue("--base-dir", optionalText):
        baseDir = optionalText
    if cmdline.ReadFirstFlagValue("--peer-id", optionalText):
        peerId = optionalText
    if cmdline.ReadFirstFlagValue("--tensor-scale", optionalText):
        tensorScale = int32(strutil.ParseInt(optionalText))
        if tensorScale <= 0:
            hfGlm52ReplayPrintErr("tensor_scale_error=expected_positive_int32")
            return 2
    if cmdline.ReadFirstFlagValue("--payload-chunk-bytes", optionalText):
        payloadChunkBytes = int32(strutil.ParseInt(optionalText))
        if payloadChunkBytes <= 0 || payloadChunkBytes > 67108864:
            hfGlm52ReplayPrintErr("payload_chunk_bytes_error=expected_1_to_67108864")
            return 2

    let profile = hfgraph.HfGlm52W4Afp8DeployProfileFromConfigPath(
        hfgraph.HfGlm52W4Afp8RepoId,
        configPath
    )
    if IsErr(profile):
        hfGlm52ReplayPrintErr(strutil.Join(["profile_error=", Error(profile)], ""))
        return 1

    let receipt = hfgraph.HfGlm52W4Afp8DeploymentReceiptBuildFromIndexPath(Value(profile), indexPath)
    if IsErr(receipt):
        hfGlm52ReplayPrintErr(strutil.Join(["receipt_error=", Error(receipt)], ""))
        return 1
    let receiptOk = hfgraph.HfGlm52W4Afp8ValidateDeploymentReceiptPath(Value(profile), indexPath, Value(receipt))
    if IsErr(receiptOk):
        hfGlm52ReplayPrintErr(strutil.Join(["receipt_validate_error=", Error(receiptOk)], ""))
        return 1
    let auditReceipt = hfgraph.HfGlm52W4Afp8AuditShardReceiptBuildFromIndexPath(
        Value(profile),
        indexPath,
        modelCid,
        baseDir,
        peerId,
        tensorScale
    )
    if IsErr(auditReceipt):
        hfGlm52ReplayPrintErr(strutil.Join(["audit_receipt_error=", Error(auditReceipt)], ""))
        return 1
    let auditOk = hfgraph.HfGlm52W4Afp8ValidateAuditShardReceiptPath(Value(profile), indexPath, Value(auditReceipt))
    if IsErr(auditOk):
        hfGlm52ReplayPrintErr(strutil.Join(["audit_receipt_validate_error=", Error(auditOk)], ""))
        return 1
    var preflightHash: int64
    var preflightFileReceiptHash: int64
    var preflightFileCount: int32
    var preflightTensorCount: int32
    var payloadPreflightHash: int64
    var payloadTensorReceiptHash: int64
    var payloadTensorCount: int32
    var payloadTotalBytes: int64
    if preflightShards:
        let headerPreflight: Result[ws.WeightSafetensorsShardHeaderPreflight] =
            hfgraph.HfGlm52W4Afp8AuditShardHeaderPreflightBuildFromIndexPath(
                Value(profile),
                indexPath,
                modelCid,
                baseDir,
                peerId,
                tensorScale
            )
        if IsErr(headerPreflight):
            hfGlm52ReplayPrintErr(strutil.Join(["header_preflight_error=", Error(headerPreflight)], ""))
            return 1
        preflightHash = Value(headerPreflight).receiptHash
        preflightFileReceiptHash = Value(headerPreflight).fileReceiptHash
        preflightFileCount = Value(headerPreflight).fileReceipts.len
        preflightTensorCount = Value(headerPreflight).tensorCount
    if hashShardPayloads:
        let payloadPreflight: Result[ws.WeightSafetensorsPayloadHashPreflight] =
            hfgraph.HfGlm52W4Afp8AuditShardPayloadHashPreflightBuildFromIndexPath(
                Value(profile),
                indexPath,
                modelCid,
                baseDir,
                peerId,
                tensorScale,
                payloadChunkBytes
            )
        if IsErr(payloadPreflight):
            hfGlm52ReplayPrintErr(strutil.Join(["payload_hash_preflight_error=", Error(payloadPreflight)], ""))
            return 1
        payloadPreflightHash = Value(payloadPreflight).receiptHash
        payloadTensorReceiptHash = Value(payloadPreflight).tensorReceiptHash
        payloadTensorCount = Value(payloadPreflight).tensorCount
        payloadTotalBytes = Value(payloadPreflight).totalPayloadBytes

    let profileFacts = hfgraph.HfGlm52W4Afp8DeploymentFacts(Value(profile))
    for i in 0..<profileFacts.len:
        hfGlm52ReplayPrintOut(profileFacts[i])
    let receiptFacts = hfgraph.HfGlm52W4Afp8DeploymentReceiptFacts(Value(receipt))
    for i in 0..<receiptFacts.len:
        hfGlm52ReplayPrintOut(receiptFacts[i])
    let auditFacts = hfgraph.HfGlm52W4Afp8AuditShardReceiptFacts(Value(auditReceipt))
    for i in 0..<auditFacts.len:
        hfGlm52ReplayPrintOut(auditFacts[i])
    if preflightShards:
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_header_preflight_hash=", strings.Int64ToStr(preflightHash)], ""))
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_header_preflight_file_receipt_hash=", strings.Int64ToStr(preflightFileReceiptHash)], ""))
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_header_preflight_file_count=", strings.IntToStr(preflightFileCount)], ""))
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_header_preflight_tensor_count=", strings.IntToStr(preflightTensorCount)], ""))
    if hashShardPayloads:
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_payload_hash_preflight_hash=", strings.Int64ToStr(payloadPreflightHash)], ""))
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_payload_tensor_receipt_hash=", strings.Int64ToStr(payloadTensorReceiptHash)], ""))
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_payload_tensor_count=", strings.IntToStr(payloadTensorCount)], ""))
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_payload_total_bytes=", strings.Int64ToStr(payloadTotalBytes)], ""))
        hfGlm52ReplayPrintOut(strutil.Join(["hf_glm52_w4afp8_payload_chunk_bytes=", strings.IntToStr(payloadChunkBytes)], ""))
    hfGlm52ReplayPrintOut("hf_glm52_w4afp8_replay_ok=1")
    return 0
