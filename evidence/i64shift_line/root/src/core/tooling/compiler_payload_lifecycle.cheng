import cheng/core/tooling/lifetime_ledger as lifetime
import cheng/std/bytes_layout as layout
import std/strformat

const
    CompilerPayloadOutcomeSuccess = 1
    CompilerPayloadOutcomeDiagnostic = 2
    CompilerPayloadOutcomeCancel = 3
    CompilerPayloadOutcomeEarlyReturn = 4
    CompilerPayloadOutcomeCacheReuse = 5

    CompilerPayloadKindCompilerCsg = 1
    CompilerPayloadKindLowering = 2
    CompilerPayloadKindFocusedTest = 3
    CompilerPayloadKindSystemLinkOwnerLedger = 4

type
    CompilerPayloadLifecycle =
        ledger: lifetime.LifetimeLedger
        producerOwnerId: int32
        consumerOwnerId: int32
        terminalConsumerOwnerId: int32
        currentOwnerId: int32
        objectId: int32
        consumerBorrowId: int32
        terminalConsumerBorrowId: int32
        byteCount: int64
        physicalBufferCount: int32
        consumerBorrowStarted: bool
        consumerBorrowActive: bool
        terminalConsumerBorrowStarted: bool
        terminalConsumerBorrowActive: bool
        movedToConsumer: bool
        terminalPrepared: bool
        active: bool

    # Minted by the payload's own terminal Arena/Seq release point. Global
    # allocator counters are deliberately absent: unrelated frees cannot
    # satisfy this receipt.
    CompilerPayloadPhysicalReleaseReceipt =
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

    CompilerPayloadLifecycleReceipt =
        outcome: int32
        allocated: int64
        released: int64
        live: int64
        allocatedBytes: int64
        releasedBytes: int64
        liveBytes: int64
        retained: int64
        ownerTransferCount: int64
        borrowReturnCount: int64
        physicalBufferCount: int32
        physicalFreeCount: int64
        storageReleased: bool
        ledgerStorageReleased: bool
        ledgerStorageReleasedSequenceCount: int32
        ledgerStorageReleasedBufferCount: int32
        ledgerStorageReleasedBytes: int64

    # Exact owner/resource state sampled at one monotonic instant.  The owner
    # token is a structural CID minted by the payload producer; no pointer,
    # source line, or textual name participates in identity.
    CompilerPayloadOwnerResourceTracePoint =
        monotonicTimestampNs: int64
        ownerToken: layout.FixedBytes32
        logicalBytes: int64
        retainedBytes: int64
        physicalBufferCount: int32
        allocCount: int64
        allocatedBytes: int64
        releaseCount: int64
        releasedBytes: int64
        liveCount: int64
        released: bool
        storageReleased: bool

    CompilerPayloadOwnerResourceTrace =
        before: CompilerPayloadOwnerResourceTracePoint
        after: CompilerPayloadOwnerResourceTracePoint
        complete: bool

fn compilerPayloadLifecycleFail(message: str) =
    panic(message)

fn CompilerPayloadOutcomeValid(outcome: int32): bool =
    return outcome >= CompilerPayloadOutcomeSuccess &&
           outcome <= CompilerPayloadOutcomeCacheReuse

fn CompilerPayloadOwnerResourceTracePointInto(
        monotonicTimestampNs: int64,
        ownerToken: layout.FixedBytes32,
        logicalBytes: int64,
        retainedBytes: int64,
        physicalBufferCount: int32,
        allocCount: int64,
        allocatedBytes: int64,
        releaseCount: int64,
        releasedBytes: int64,
        liveCount: int64,
        released: bool,
        storageReleased: bool,
        out: var CompilerPayloadOwnerResourceTracePoint) =
    if monotonicTimestampNs <= int64(0) ||
       layout.FixedBytes32Equal(ownerToken, layout.FixedBytes32()) ||
       logicalBytes < int64(0) ||
       retainedBytes < int64(0) ||
       physicalBufferCount < 0 ||
       allocCount < int64(0) ||
       allocatedBytes < int64(0) ||
       releaseCount < int64(0) ||
       releasedBytes < int64(0) ||
       liveCount < int64(0) ||
       allocCount != releaseCount + liveCount ||
       allocatedBytes != releasedBytes + retainedBytes ||
       int64(physicalBufferCount) != liveCount ||
       (storageReleased && !released) ||
       (released &&
        (logicalBytes != int64(0) ||
         retainedBytes != int64(0) ||
         physicalBufferCount != 0 ||
         liveCount != int64(0) ||
         !storageReleased)):
        var releasedCode = 0
        var storageCode = 0
        if released:
            releasedCode = 1
        if storageReleased:
            storageCode = 1
        var tokenZero = 0
        if layout.FixedBytes32Equal(ownerToken, layout.FixedBytes32()):
            tokenZero = 1
        compilerPayloadLifecycleFail(
            Fmt"compiler payload trace: invalid owner/resource point ts={monotonicTimestampNs} tokenZero={tokenZero} logical={logicalBytes} retained={retainedBytes} phys={physicalBufferCount} alloc={allocCount} allocated={allocatedBytes} rel={releaseCount} relBytes={releasedBytes} live={liveCount} released={releasedCode} storage={storageCode}")
    out.monotonicTimestampNs = monotonicTimestampNs
    out.ownerToken = ownerToken
    out.logicalBytes = logicalBytes
    out.retainedBytes = retainedBytes
    out.physicalBufferCount = physicalBufferCount
    out.allocCount = allocCount
    out.allocatedBytes = allocatedBytes
    out.releaseCount = releaseCount
    out.releasedBytes = releasedBytes
    out.liveCount = liveCount
    out.released = released
    out.storageReleased = storageReleased

fn CompilerPayloadOwnerResourceTraceCompleteInto(
        before: CompilerPayloadOwnerResourceTracePoint,
        after: CompilerPayloadOwnerResourceTracePoint,
        out: var CompilerPayloadOwnerResourceTrace) =
    if before.monotonicTimestampNs <= int64(0) ||
       after.monotonicTimestampNs < before.monotonicTimestampNs ||
       !layout.FixedBytes32Equal(before.ownerToken, after.ownerToken) ||
       before.released ||
       before.storageReleased ||
       after.allocCount != before.allocCount ||
       after.allocatedBytes != before.allocatedBytes ||
       after.releaseCount < before.releaseCount ||
       after.releasedBytes < before.releasedBytes ||
       after.liveCount > before.liveCount ||
       after.retainedBytes > before.retainedBytes ||
       !after.released ||
       !after.storageReleased:
        compilerPayloadLifecycleFail(
            "compiler payload trace: invalid terminal transition")
    out.before = before
    out.after = after
    out.complete = true

fn CompilerPayloadOwnerResourceTraceClosed(
        trace: var CompilerPayloadOwnerResourceTrace): bool =
    return trace.complete &&
           trace.before.monotonicTimestampNs > int64(0) &&
           trace.after.monotonicTimestampNs >=
               trace.before.monotonicTimestampNs &&
           layout.FixedBytes32Equal(
               trace.before.ownerToken,
               trace.after.ownerToken) &&
           !trace.before.released &&
           trace.after.released &&
           trace.after.storageReleased &&
           trace.after.logicalBytes == int64(0) &&
           trace.after.retainedBytes == int64(0) &&
           trace.after.physicalBufferCount == 0 &&
           trace.after.liveCount == int64(0) &&
           trace.after.allocCount == trace.after.releaseCount &&
           trace.after.allocatedBytes == trace.after.releasedBytes

fn CompilerPayloadLifecycleBegin(
        state: var CompilerPayloadLifecycle,
        payloadKind: int32,
        byteCount: int64,
        physicalBufferCount: int32) =
    if state.active || byteCount < int64(0) ||
       physicalBufferCount < 0 ||
       (byteCount == int64(0) && physicalBufferCount != 0) ||
       (byteCount > int64(0) && physicalBufferCount <= 0):
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid begin")
    lifetime.LifetimeLedgerInit(state.ledger)
    var categoryId: int32
    if payloadKind == CompilerPayloadKindCompilerCsg:
        categoryId = lifetime.LifetimeLedgerRegisterCategory(
            state.ledger,
            "compiler_csg_committed_payload_lineage")
        state.producerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "backend_driver_system_link_exec")
        state.consumerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "lowering_plan")
        state.terminalConsumerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "production_object_plan")
    elif payloadKind == CompilerPayloadKindLowering:
        categoryId = lifetime.LifetimeLedgerRegisterCategory(
            state.ledger,
            "lowering_produced_payload")
        state.producerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "lowering_plan")
        state.consumerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "production_object_plan")
        state.terminalConsumerOwnerId = state.consumerOwnerId
    elif payloadKind == CompilerPayloadKindFocusedTest:
        categoryId = lifetime.LifetimeLedgerRegisterCategory(
            state.ledger,
            "compiler_payload_focused_test")
        state.producerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "compiler_payload_test_function")
        state.consumerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "compiler_payload_test_consumer")
        state.terminalConsumerOwnerId = state.consumerOwnerId
    elif payloadKind == CompilerPayloadKindSystemLinkOwnerLedger:
        categoryId = lifetime.LifetimeLedgerRegisterCategory(
            state.ledger,
            "system_link_owner_table_arena")
        state.producerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "system_link_plan_builder")
        state.consumerOwnerId =
            lifetime.LifetimeLedgerRegisterOwner(
                state.ledger,
                "system_link_runtime")
        state.terminalConsumerOwnerId = state.consumerOwnerId
    else:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid payload kind")
    state.currentOwnerId = state.producerOwnerId
    state.objectId = 0
    state.consumerBorrowId = 0
    state.terminalConsumerBorrowId = 0
    state.byteCount = byteCount
    state.physicalBufferCount = physicalBufferCount
    state.consumerBorrowStarted = false
    state.consumerBorrowActive = false
    state.terminalConsumerBorrowStarted = false
    state.terminalConsumerBorrowActive = false
    state.movedToConsumer = false
    state.terminalPrepared = false
    if byteCount > int64(0):
        state.objectId = lifetime.LifetimeLedgerReserveObject(
            state.ledger, categoryId, byteCount)
        lifetime.LifetimeLedgerOwn(
            state.ledger, state.objectId, state.producerOwnerId)
    state.active = true

fn CompilerPayloadLifecycleBorrowForConsumer(
        state: var CompilerPayloadLifecycle) =
    if !state.active || state.terminalPrepared ||
       state.consumerBorrowStarted || state.consumerBorrowActive ||
       state.movedToConsumer:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid consumer borrow")
    state.consumerBorrowStarted = true
    state.consumerBorrowActive = true
    if state.objectId > 0:
        state.consumerBorrowId = lifetime.LifetimeLedgerBorrow(
            state.ledger, state.objectId, state.consumerOwnerId)
        let _ = lifetime.LifetimeLedgerRead(
            state.ledger, state.objectId, state.consumerOwnerId)

fn CompilerPayloadLifecycleReturnConsumerBorrow(
        state: var CompilerPayloadLifecycle) =
    if !state.active || !state.consumerBorrowActive:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid consumer borrow return")
    if state.objectId > 0:
        lifetime.LifetimeLedgerReturnBorrow(
            state.ledger,
            state.objectId,
            state.consumerBorrowId,
            state.consumerOwnerId)
    state.consumerBorrowActive = false

fn CompilerPayloadLifecycleMoveToConsumer(
        state: var CompilerPayloadLifecycle) =
    if !state.active || state.consumerBorrowActive ||
       !state.consumerBorrowStarted || state.movedToConsumer:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid consumer move")
    if state.objectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.objectId,
            state.producerOwnerId,
            state.consumerOwnerId)
        let _ = lifetime.LifetimeLedgerRead(
            state.ledger, state.objectId, state.consumerOwnerId)
    state.currentOwnerId = state.consumerOwnerId
    state.movedToConsumer = true

fn CompilerPayloadLifecycleTransferInto(
        state: var CompilerPayloadLifecycle,
        destination: var CompilerPayloadLifecycle) =
    if !state.active ||
       state.consumerBorrowActive ||
       state.terminalConsumerBorrowActive ||
       destination.active:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid controller transfer")
    destination = state
    state = CompilerPayloadLifecycle()

fn CompilerPayloadLifecycleBorrowForTerminalConsumer(
        state: var CompilerPayloadLifecycle) =
    if !state.active || !state.movedToConsumer ||
       state.consumerBorrowActive ||
       state.terminalConsumerBorrowStarted ||
       state.terminalConsumerBorrowActive ||
       state.currentOwnerId == state.terminalConsumerOwnerId:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid terminal consumer borrow")
    state.terminalConsumerBorrowStarted = true
    state.terminalConsumerBorrowActive = true
    if state.objectId > 0:
        state.terminalConsumerBorrowId = lifetime.LifetimeLedgerBorrow(
            state.ledger,
            state.objectId,
            state.terminalConsumerOwnerId)
        let _ = lifetime.LifetimeLedgerRead(
            state.ledger,
            state.objectId,
            state.terminalConsumerOwnerId)

fn CompilerPayloadLifecycleReturnTerminalConsumerBorrow(
        state: var CompilerPayloadLifecycle) =
    if !state.active || !state.terminalConsumerBorrowActive:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid terminal borrow return")
    if state.objectId > 0:
        lifetime.LifetimeLedgerReturnBorrow(
            state.ledger,
            state.objectId,
            state.terminalConsumerBorrowId,
            state.terminalConsumerOwnerId)
    state.terminalConsumerBorrowActive = false

fn CompilerPayloadLifecyclePrepareTerminal(
        state: var CompilerPayloadLifecycle) =
    if !state.active || state.terminalPrepared:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid terminal prepare")
    state.terminalPrepared = true

fn CompilerPayloadLifecycleEnd(
        state: var CompilerPayloadLifecycle,
        outcome: int32,
        physicalRelease: CompilerPayloadPhysicalReleaseReceipt,
        receipt: var CompilerPayloadLifecycleReceipt) =
    if !state.active || !CompilerPayloadOutcomeValid(outcome) ||
       !state.terminalPrepared || !physicalRelease.storageReleased ||
       state.consumerBorrowActive ||
       state.terminalConsumerBorrowActive:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: invalid terminal state")
    if physicalRelease.releasedBufferCount !=
           state.physicalBufferCount ||
       physicalRelease.releasedBytes != state.byteCount:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: physical free receipt incomplete")
    if state.objectId > 0:
        lifetime.LifetimeLedgerRelease(
            state.ledger, state.objectId, state.currentOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.producerOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.consumerOwnerId)
    if state.terminalConsumerOwnerId != state.consumerOwnerId:
        lifetime.LifetimeLedgerAssertOwnerClosed(
            state.ledger, state.terminalConsumerOwnerId)
    lifetime.LifetimeLedgerAssertClosed(state.ledger)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(state.ledger, metrics)
    var expectedCount: int64
    if state.byteCount > int64(0):
        expectedCount = int64(1)
    var expectedBorrowCount: int64
    if state.objectId > 0 && state.consumerBorrowStarted:
        expectedBorrowCount = expectedBorrowCount + int64(1)
    if state.objectId > 0 && state.terminalConsumerBorrowStarted:
        expectedBorrowCount = expectedBorrowCount + int64(1)
    var expectedTransferCount: int64
    if state.objectId > 0 && state.movedToConsumer:
        expectedTransferCount = int64(1)
    if metrics.allocated != expectedCount ||
       metrics.released != expectedCount ||
       metrics.live != int64(0) ||
       metrics.allocatedBytes != state.byteCount ||
       metrics.releasedBytes != state.byteCount ||
       metrics.liveBytes != int64(0) ||
       metrics.retained != expectedBorrowCount ||
       metrics.borrowReturnCount != expectedBorrowCount ||
       metrics.ownerTransferCount != expectedTransferCount:
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: ledger terminal mismatch")

    receipt.outcome = outcome
    receipt.allocated = metrics.allocated
    receipt.released = metrics.released
    receipt.live = metrics.live
    receipt.allocatedBytes = metrics.allocatedBytes
    receipt.releasedBytes = metrics.releasedBytes
    receipt.liveBytes = metrics.liveBytes
    receipt.retained = metrics.retained
    receipt.ownerTransferCount = metrics.ownerTransferCount
    receipt.borrowReturnCount = metrics.borrowReturnCount
    receipt.physicalBufferCount = state.physicalBufferCount
    receipt.physicalFreeCount =
        int64(physicalRelease.releasedBufferCount)
    receipt.storageReleased = physicalRelease.storageReleased

    let ledgerStorageRelease =
        lifetime.LifetimeLedgerReleaseStorage(state.ledger)
    receipt.ledgerStorageReleased = ledgerStorageRelease.storageReleased
    receipt.ledgerStorageReleasedSequenceCount =
        ledgerStorageRelease.releasedSequenceCount
    receipt.ledgerStorageReleasedBufferCount =
        ledgerStorageRelease.releasedSequenceBufferCount
    receipt.ledgerStorageReleasedBytes =
        ledgerStorageRelease.releasedSequenceCapacityBytes
    if !receipt.ledgerStorageReleased ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       receipt.ledgerStorageReleasedBufferCount <= 0 ||
       receipt.ledgerStorageReleasedBytes <= int64(0):
        compilerPayloadLifecycleFail(
            "compiler payload lifecycle: ledger storage release failed")
    state.terminalPrepared = false
    state.active = false

@borrows
fn CompilerPayloadLifecycleReceiptClosed(
        receipt: CompilerPayloadLifecycleReceipt): bool =
    return CompilerPayloadOutcomeValid(receipt.outcome) &&
           receipt.allocated >= int64(0) &&
           receipt.allocated <= int64(1) &&
           receipt.allocated == receipt.released &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes >= int64(0) &&
           receipt.allocatedBytes == receipt.releasedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.retained == receipt.borrowReturnCount &&
           receipt.ownerTransferCount >= int64(0) &&
           receipt.ownerTransferCount <= receipt.allocated &&
           receipt.physicalBufferCount >= 0 &&
           receipt.physicalFreeCount ==
               int64(receipt.physicalBufferCount) &&
           ((receipt.allocated == int64(0) &&
             receipt.allocatedBytes == int64(0) &&
             receipt.retained == int64(0) &&
             receipt.ownerTransferCount == int64(0) &&
             receipt.physicalBufferCount == 0) ||
            (receipt.allocated == int64(1) &&
             receipt.allocatedBytes > int64(0) &&
             receipt.physicalBufferCount > 0)) &&
           receipt.storageReleased &&
           receipt.ledgerStorageReleased &&
           receipt.ledgerStorageReleasedSequenceCount == 6 &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0)
