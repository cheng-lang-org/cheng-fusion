import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/codegen_a64_fill_units as a64fill
import cheng/core/backend/darwin_syscall_provider as darwin_provider
import cheng/core/backend/regalloc_aarch64_adapter as adapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/tooling/compiler_main as compiler

fn main(): int32 =
    if !adapter.RegallocA64CodegenUnitRegister():
        return 70
    if !contract.CodegenCompositionActivateUnit(
           contract.CodegenUnitA64):
        return 71
    return compiler.CompilerMainCompositionProcessEntry()
