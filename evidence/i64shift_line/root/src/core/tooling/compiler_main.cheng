fn CompilerStatusTextPairOwned(edges: str,
                                unresolved: str): CompilerStatusTextPair =
    return CompilerStatusTextPair(
        edges: Fmt"{edges}",
        unresolved: Fmt"{unresolved}")

fn CompilerStatusTextPairEmpty(): CompilerStatusTextPair =
    let edges = ""
    let unresolved = ""
    return CompilerStatusTextPairOwned(edges, unresolved)

@borrows
fn CompilerStatusParse(rootDir: str,
                        sourcePath: str,
                        externalRoots: parser.ParserExternalPackageRoot[],
                        enabled: bool): CompilerStatusTextPair =
    if !enabled:
        return CompilerStatusTextPairEmpty()
    var parsed: parser.ParsedSourceStub
    var err: str
    if parser.ParseOrdinarySourceStubWithExternalPackageRoots(rootDir,
                                                               sourcePath,
                                                               externalRoots,
                                                               parsed,
                                                               err):
        let edges = IntToStr(parsed.importEdges.len)
        let unresolved = IntToStr(parsed.unresolvedImportCount)
        return CompilerStatusTextPairOwned(edges, unresolved)
    let edges = "err"
    let unresolved = strings.CloneStr(err)
    return CompilerStatusTextPairOwned(edges, unresolved)

@borrows
fn CompilerStatusPlan(rootDir: str,
                       req: creq.CompilerRequest,
                       externalRoots: parser.ParserExternalPackageRoot[],
                       enabled: bool): CompilerStatusTextPair =
    if !enabled:
        return CompilerStatusTextPairEmpty()
    var plan: slplan.SystemLinkPlanStub
    var err: str
    if slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(rootDir,
                                                               req,
                                                               externalRoots,
                                                               plan,
                                                               err):
        let edges = IntToStr(plan.importEdgeCount)
        let unresolved = IntToStr(plan.unresolvedImportCount)
        return CompilerStatusTextPairOwned(edges, unresolved)
    let edges = "err"
    let unresolved = strings.CloneStr(err)
    return CompilerStatusTextPairOwned(edges, unresolved)

@borrows
fn CompilerStatusExec(rootDir: str,
                       req: creq.CompilerRequest,
                       enabled: bool): CompilerStatusTextPair =
    if !enabled:
        return CompilerStatusTextPairEmpty()
    if !creq.CompilerRequestStrictValidateSealed(req):
        return CompilerStatusTextPairOwned(
            "err", " compiler: status compiler request is not sealed")
    let emptyChannel = ""
    let execRes = CompilerCanonicalSystemLinkExecPlan(
        rootDir,
        req,
        emptyChannel,
        emptyChannel,
        emptyChannel,
        "stable")
    if IsErr(execRes):
        let edges = "err"
        let unresolved = strings.CloneStr(execRes.err.msg)
        return CompilerStatusTextPairOwned(edges, unresolved)
    let edges =
        IntToStr(execRes.value.systemLinkPlan.importEdgeCount)
    let unresolved =
        IntToStr(execRes.value.systemLinkPlan.unresolvedImportCount)
    return CompilerStatusTextPairOwned(edges, unresolved)

@borrows
fn CompilerStatusWrappedExec(rootDir: str,
                              req: creq.CompilerRequest,
                              symbolVisibilityRaw: str,
                              enabled: bool): CompilerStatusTextPair =
    if !enabled:
        return CompilerStatusTextPairEmpty()
    let symbolRes =
        creq.CompilerSymbolVisibilityFromText(symbolVisibilityRaw)
    if IsErr(symbolRes):
        let edges = "err"
        let unresolved = strings.CloneStr(symbolRes.err.msg)
        return CompilerStatusTextPairOwned(edges, unresolved)
    let ownedReq = creq.CompilerRequestClone(req)
    var wrappedReq = creq.CompilerRequestWithSymbolVisibility(
        ownedReq, Value(symbolRes))
    creq.CompilerRequestSeal(wrappedReq)
    let emptyChannel = ""
    let execRes = CompilerCanonicalSystemLinkExecPlan(
        rootDir,
        wrappedReq,
        emptyChannel,
        emptyChannel,
        emptyChannel,
        "stable")
    if IsErr(execRes):
        let edges = "err"
        let unresolved = strings.CloneStr(execRes.err.msg)
        return CompilerStatusTextPairOwned(edges, unresolved)
    let edges =
        IntToStr(execRes.value.systemLinkPlan.importEdgeCount)
    let unresolved =
        IntToStr(execRes.value.systemLinkPlan.unresolvedImportCount)
    return CompilerStatusTextPairOwned(edges, unresolved)

@borrows
fn CompilerStatusFlagOutputPath(flagOut: str): str =
    if len(flagOut) > 0:
        return Fmt"{flagOut}"
    return "/tmp/cheng_status_flag_probe.out"

@borrows
fn CompilerStatusProbeParse(rootDir: str,
                             sourcePath: str,
                             externalRoots: parser.ParserExternalPackageRoot[]): CompilerStatusTextPair =
    if !os.FileExists(sourcePath):
        let edges = ""
        let unresolved = ""
        return CompilerStatusTextPairOwned(edges, unresolved)
    return CompilerStatusParse(rootDir, sourcePath, externalRoots, true)

@borrows
fn CompilerStatus(rootDir: str) =
    let contract = crun.CompilerRuntimeContract(rootDir)
    let cwd = os.GetCurrentDir()
    let probeSourcePath = os.JoinPath(cwd, "src/main.cheng")
    let flagRoot = cmdline.ReadFlagOrDefault("--root", "")
    let flagIn = cmdline.ReadFlagOrDefault("--in", "")
    let flagOut = cmdline.ReadFlagOrDefault("--out", "")
    let flagReport = cmdline.ReadFlagOrDefault("--report-out", "")
    let flagSymbolRaw = cmdline.ReadFlagOrDefault("--symbol-visibility", "")
    let envRoot = os.GetEnv("CHENG_ROOT")
    let programName = cmdline.ProgramName()
    CompilerPrintLine("cheng")
    CompilerPrintLine(Fmt"schema={contract.schema}")
    CompilerPrintLine(Fmt"execution={contract.executionModel}")
    CompilerPrintLine(Fmt"bootstrap_mode={contract.bootstrapMode}")
    CompilerPrintLine(Fmt"compiler_entry={contract.compilerEntry}")
    CompilerPrintLine(Fmt"ordinary_command={contract.ordinaryCommand}")
    CompilerPrintLine(Fmt"ordinary_pipeline={contract.ordinaryPipelineState}")
    CompilerPrintLine(Fmt"root_dir={rootDir}")
    CompilerPrintLine(Fmt"cwd={cwd}")
    CompilerPrintLine(Fmt"program_name={programName}")
    CompilerPrintLine(Fmt"env_root={envRoot}")
    if flagRoot != "" || flagIn != "":
        CompilerPrintLine(Fmt"flag_root={flagRoot}")
        CompilerPrintLine(Fmt"flag_in={flagIn}")
    var externalRoots: parser.ParserExternalPackageRoot[]
    let probeEnabled = os.FileExists(probeSourcePath)
    let probeParseStatus =
        CompilerStatusProbeParse(cwd, probeSourcePath, externalRoots)
    var probeReq = creq.CompilerRequestNew(cwd,
                                             probeSourcePath,
                                             "/tmp/cheng_status_probe.out",
                                             contracts.BootstrapDefaultTarget(),
                                             creq.EmitExe,
                                             "")
    creq.CompilerRequestSeal(probeReq)
    let probePlanStatus =
        CompilerStatusPlan(rootDir, probeReq, externalRoots, probeEnabled)
    let probeExecStatus =
        CompilerStatusExec(rootDir, probeReq, probeEnabled)
    let flagEnabled = flagRoot != "" && flagIn != ""
    let flagParseStatus =
        CompilerStatusParse(flagRoot, flagIn, externalRoots, flagEnabled)
    let flagOutputPath = CompilerStatusFlagOutputPath(flagOut)
    var flagReq = creq.CompilerRequestNew(flagRoot,
                                            flagIn,
                                            flagOutputPath,
                                            contracts.BootstrapDefaultTarget(),
                                            creq.EmitExe,
                                            flagReport)
    creq.CompilerRequestSeal(flagReq)
    let flagPlanStatus =
        CompilerStatusPlan(rootDir, flagReq, externalRoots, flagEnabled)
    let flagExecStatus =
        CompilerStatusExec(rootDir, flagReq, flagEnabled)
    let flagWrappedExecStatus =
        CompilerStatusWrappedExec(
            rootDir, flagReq, flagSymbolRaw, flagEnabled)
    let currentExecutablePath = CompilerCurrentExecutablePath(rootDir)
    let bridgeCompilerPath = CompilerBridgeCompilerPath(rootDir)
    let probeStdStrings = parser.ParserModulePathToSourcePathWithExternalPackageRoots(cwd,
                                                                                       cwd,
                                                                                       externalRoots,
                                                                                       "std/strings")
    CompilerPrintLine(Fmt"current_executable_path={currentExecutablePath}")
    CompilerPrintLine(Fmt"bridge_compiler={bridgeCompilerPath}")
    CompilerPrintLine(Fmt"probe_std_strings={probeStdStrings}")
    if len(probeParseStatus.edges) > 0:
        CompilerPrintLine(Fmt"probe_parse_edges={probeParseStatus.edges}")
        CompilerPrintLine(Fmt"probe_parse_unresolved={probeParseStatus.unresolved}")
    if len(probePlanStatus.edges) > 0:
        CompilerPrintLine(Fmt"probe_plan_edges={probePlanStatus.edges}")
        CompilerPrintLine(Fmt"probe_plan_unresolved={probePlanStatus.unresolved}")
    if len(probeExecStatus.edges) > 0:
        CompilerPrintLine(Fmt"probe_exec_edges={probeExecStatus.edges}")
        CompilerPrintLine(Fmt"probe_exec_unresolved={probeExecStatus.unresolved}")
    if len(flagParseStatus.edges) > 0:
        CompilerPrintLine(Fmt"flag_parse_edges={flagParseStatus.edges}")
        CompilerPrintLine(Fmt"flag_parse_unresolved={flagParseStatus.unresolved}")
    if len(flagPlanStatus.edges) > 0:
        CompilerPrintLine(Fmt"flag_plan_edges={flagPlanStatus.edges}")
        CompilerPrintLine(Fmt"flag_plan_unresolved={flagPlanStatus.unresolved}")
    if len(flagExecStatus.edges) > 0:
        CompilerPrintLine(Fmt"flag_exec_edges={flagExecStatus.edges}")
        CompilerPrintLine(Fmt"flag_exec_unresolved={flagExecStatus.unresolved}")
    if len(flagWrappedExecStatus.edges) > 0:
        CompilerPrintLine(Fmt"flag_wrapped_exec_edges={flagWrappedExecStatus.edges}")
        CompilerPrintLine(Fmt"flag_wrapped_exec_unresolved={flagWrappedExecStatus.unresolved}")

@borrows
fn CompilerSupportMatrix(rootDir: str) =
    CompilerPrintBlock(smatrix.SupportMatrixReport(rootDir))

@borrows
fn CompilerRuntimeReadFlagValue(flagName: str,
                                  outValue: var str): bool =
    outValue = ""
    let count: int32 = cmdline.ParamCount()
    if count < 1:
        return false
    let colonPrefix: str = Fmt"{flagName}:"
    let equalsPrefix: str = Fmt"{flagName}="
    for i in 1..count:
        let arg: str = cmdline.ParamStr(i)
        if arg == flagName:
            if i < count:
                outValue = cmdline.ParamStr(i + 1)
                return true
            return false
        if strutil.StartsWith(arg, colonPrefix) || strutil.StartsWith(arg, equalsPrefix):
            # SliceBytes is a borrowed view into the loop-local `arg`.
            # outValue crosses this function boundary, so freeze an owned
            # range before `arg` is released.
            outValue = strings.CloneStrRange(
                arg,
                len(flagName) + 1,
                len(arg) - len(flagName) - 1)
            return true
    return false

@borrows
fn CompilerRuntimeFlagOrDefault(flagName: str,
                                  defaultValue: str): str =
    var outValue = ""
    if CompilerRuntimeReadFlagValue(flagName, outValue):
        return outValue
    return strings.CloneStr(defaultValue)

fn CompilerRequestedTarget(): str =
    var targetTriple: str
    if CompilerRuntimeReadFlagValue("--target", targetTriple):
        let trimmed = strutil.Strip(targetTriple)
        if len(trimmed) > 0:
            return trimmed
    return contracts.BootstrapDefaultTarget()

@borrows
fn CompilerStage3CommandPath(rootDir: str): str =
    return chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage3")

@borrows
fn CompilerPrintBuildPlan(rootDir: str,
                            args: var str[]): int32 =
    let stage3Path = CompilerStage3CommandPath(rootDir)
    let logPath = chengpath.PathAbsolute(rootDir, "artifacts/forward/print-build-plan.local.log")
    if !chengpath.FileExistsNonEmpty(rootDir, stage3Path):
        CompilerPrintErr(" compiler: missing stage3 compiler for command: print-build-plan")
        return 2
    var forwardArgs: str[] = ["print-build-plan"]
    for i in 0..<args.len:
        let forwardedArg = Fmt"{args[i]}"
        add(forwardArgs, forwardedArg)
    if !CompilerRunFileEnvLogged(rootDir,
                                   stage3Path,
                                   forwardArgs,
                                   ["CHENG_NO_BACKEND_DRIVER_HANDOFF=1"],
                                   logPath,
                                   "print-build-plan"):
        return 2
    let outputRaw = chengpath.ReadTextFile("", logPath)
    let outputText = strutil.Strip(outputRaw)
    if len(outputText) > 0:
        CompilerPrintBlock(outputText)
    return 0

@borrows
fn CompilerWriteOptionalReport(rootDir: str,
                                 rawPath: str,
                                 report: str): bool =
    if len(rawPath) <= 0:
        return true
    let text = Fmt"{report}\n"
    return chengpath.WriteTextFile(rootDir, rawPath, text)

fn CompilerBackendDriverHandoffDisabled(): bool =
    let handoffText = strutil.Strip(os.GetEnv("CHENG_BACKEND_DRIVER_HANDOFF"))
    let handoffEnabled = len(handoffText) > 0 && handoffText != "0"
    return !handoffEnabled

@borrows
fn CompilerBridgeCandidateReady(rootDir: str,
                                  candidatePath: str): bool =
    if !chengpath.FileExistsNonEmpty(rootDir, candidatePath):
        return false
    let currentPath = CompilerCurrentExecutablePath(rootDir)
    if len(currentPath) > 0 && currentPath == candidatePath:
        return false
    return true

@borrows
fn CompilerBridgeCompilerPath(rootDir: str): str =
    if os.GetEnv("CHENG_NO_BOOTSTRAP_BRIDGE") != "":
        return ""
    if !CompilerBackendDriverHandoffDisabled():
        let backendDriver = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng")
        if CompilerBridgeCandidateReady(rootDir, backendDriver):
            return backendDriver
    else:
        let currentPath = CompilerCurrentExecutablePath(rootDir)
        let stage3 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage3")
        let stage2 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage2")
        let stage1 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage1")
        let stage0 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage0")
        if CompilerBootstrapStageVariantPath(currentPath, stage3) ||
           CompilerBootstrapStageVariantPath(currentPath, stage2) ||
           CompilerBootstrapStageVariantPath(currentPath, stage1) ||
           CompilerBootstrapStageVariantPath(currentPath, stage0):
            return ""
    let stage3 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage3")
    if CompilerBridgeCandidateReady(rootDir, stage3):
        return stage3
    let stage2 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage2")
    if CompilerBridgeCandidateReady(rootDir, stage2):
        return stage2
    let stage1 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage1")
    if CompilerBridgeCandidateReady(rootDir, stage1):
        return stage1
    let stage0 = chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/cheng.stage0")
    if CompilerBridgeCandidateReady(rootDir, stage0):
        return stage0
    return ""

@borrows
fn CompilerBootstrapBridgePath(rootDir: str,
                                 context: str): str =
    let snapshot = contracts.BootstrapSnapshotDefault(rootDir)
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage2Compiler.path):
        return snapshot.stage2Compiler.path
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage1Compiler.path):
        return snapshot.stage1Compiler.path
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage0Compiler.path):
        return snapshot.stage0Compiler.path
    if !CompilerEnsureBootstrapBridge(rootDir, context):
        return ""
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage2Compiler.path):
        return snapshot.stage2Compiler.path
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage1Compiler.path):
        return snapshot.stage1Compiler.path
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage0Compiler.path):
        return snapshot.stage0Compiler.path
    CompilerPrintErr(Fmt" compiler: missing bootstrap bridge inside {context}")
    return ""

@borrows
fn CompilerReadFlagFromArgs(args: str[],
                              flagName: str,
                              defaultValue: str): str =
    let colonPrefix: str = Fmt"{flagName}:"
    let equalsPrefix: str = Fmt"{flagName}="
    var i: int32
    for i in i..<args.len:
        let arg = strutil.Strip(args[i])
        if arg == flagName:
            if i + 1 < args.len:
                return strings.CloneStr(args[i + 1])
            return strings.CloneStr(defaultValue)
        if strutil.StartsWith(arg, colonPrefix) || strutil.StartsWith(arg, equalsPrefix):
            return strings.CloneStrRange(arg, len(flagName) + 1, len(arg) - len(flagName) - 1)
    return strings.CloneStr(defaultValue)

@borrows
fn CompilerFlagEnabledFromArgs(args: str[],
                                 flagName: str): bool =
    let colonPrefix: str = Fmt"{flagName}:"
    let equalsPrefix: str = Fmt"{flagName}="
    var i: int32
    for i in i..<args.len:
        let arg = strutil.Strip(args[i])
        if arg == flagName:
            return true
        if strutil.StartsWith(arg, colonPrefix) || strutil.StartsWith(arg, equalsPrefix):
            let value = strutil.Strip(strings.SliceBytes(arg, len(flagName) + 1, len(arg) - len(flagName) - 1))
            if len(value) <= 0:
                return true
            if value != "0":
                if value != "false":
                    return true
            return false
    return false

@borrows
fn CompilerDebugSystemLinkExecEnabled(args: str[]): bool =
    if CompilerFlagEnabledFromArgs(args, "--debug-system-link-exec"):
        return true
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        return true
    if cmdline.HasFlag("--debug-system-link-exec"):
        return true
    return false

@borrows
fn CompilerArgsWithoutProgress(args: str[]): str[] =
    var out: str[]
    var i: int32
    while i < args.len:
        let arg = strutil.Strip(args[i])
        if arg == "--progress":
            i = i + 1
            continue
        if arg == "--progress-out":
            i = i + 2
            continue
        if strutil.StartsWith(arg, "--progress:") || strutil.StartsWith(arg, "--progress="):
            i = i + 1
            continue
        if strutil.StartsWith(arg, "--progress-out:") || strutil.StartsWith(arg, "--progress-out="):
            i = i + 1
            continue
        let forwardedArg = Fmt"{args[i]}"
        add(out, forwardedArg)
        i = i + 1
    return out

@borrows
fn CompilerProgressRequestedFromArgs(args: str[]): bool =
    if CompilerFlagEnabledFromArgs(args, "--progress"):
        return true
    let progressOut = strutil.Strip(CompilerReadFlagFromArgs(args, "--progress-out", ""))
    if len(progressOut) > 0:
        return true
    return false

@borrows
fn CompilerProgressOutPathFromArgs(rootDir: str,
                                     args: str[]): str =
    let raw = strutil.Strip(CompilerReadFlagFromArgs(args, "--progress-out", ""))
    if len(raw) <= 0:
        return ""
    return chengpath.PathAbsolute(rootDir, raw)

@borrows
fn CompilerApplyProgressEnvFromArgs(rootDir: str,
                                      args: str[]) =
    if CompilerProgressRequestedFromArgs(args):
        os.SetEnv("CHENG_PROGRESS", "1")
    let progressOut = CompilerProgressOutPathFromArgs(rootDir, args)
    if len(progressOut) > 0:
        os.SetEnv("CHENG_PROGRESS_OUT", progressOut)

fn CompilerProgressStdErrEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_PROGRESS"))
    if !(len(raw) > 0):
        return false
    if !(raw != "0"):
        return false
    if !(raw != "false"):
        return false
    return true

fn CompilerProgressPath(): str =
    return strutil.Strip(os.GetEnv("CHENG_PROGRESS_OUT"))

fn CompilerProgressAppendEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_PROGRESS_APPEND"))
    if !(len(raw) > 0):
        return false
    if !(raw != "0"):
        return false
    if !(raw != "false"):
        return false
    return true

@borrows
fn CompilerProgressLine(phase: str,
                          status: str): str =
    status
    return strings.CloneStr(phase)

@borrows
fn CompilerProgressExistingText(raw: str): str =
    if len(raw) > 0 && raw[len(raw) - 1] == '\n':
        return strings.CloneStrRange(raw, 0, len(raw) - 1)
    return strings.CloneStr(raw)

@borrows
fn CompilerProgressSyncExisting(progressPath: str,
                                  progressText: var str) =
    if len(progressPath) <= 0 || !os.FileExists(progressPath):
        return
    let existingRaw = chengpath.ReadTextFile("", progressPath)
    let existing = CompilerProgressExistingText(existingRaw)
    if len(existing) <= 0:
        return
    if len(progressText) <= 0:
        progressText = existing
        return
    if existing == progressText:
        return
    if strutil.StartsWith(existing, progressText):
        progressText = existing
        return
    if strutil.StartsWith(progressText, existing):
        return
    progressText = existing

@borrows
fn CompilerProgressWriteGuardLine(rootDir: str,
                                    progressPath: str,
                                    progressText: str,
                                    line: str) =
    os.WriteLine(os.Get_stderr(), line)

@borrows
fn CompilerProgressResourceGuardCheck(rootDir: str,
                                        progressText: str) =
    let maxRssBytes: int64 = hostops.HostOpsConfiguredMaxRssBytes([])
    if maxRssBytes == int64(0):
        return
    let progressPath = CompilerProgressPath()
    if maxRssBytes < int64(0):
        CompilerProgressWriteGuardLine(rootDir,
                                       progressPath,
                                       progressText,
                                       "compile_progress phase=resource_guard status=invalid_max_rss")
        hostops.HostOpsExitProcess(2)
    let rssBytes: int64 = hostops.HostOpsCurrentRssBytes()
    if rssBytes <= maxRssBytes:
        return
    if rssBytes <= int64(0):
        return
    let guardLine: str = hostops.HostOpsMemoryLimitExceededLine(rssBytes, maxRssBytes)
    CompilerProgressWriteGuardLine(rootDir,
                                   progressPath,
                                   progressText,
                                   guardLine)
    hostops.HostOpsExitProcess(hostops.ProcessMemoryExceeded)

@borrows
fn CompilerProgressEmit(rootDir: str,
                          progressText: str,
                          phase: str,
                          status: str) =
    CompilerProgressResourceGuardCheck(rootDir, progressText)
    let stderrEnabled = CompilerProgressStdErrEnabled()
    let progressPath = CompilerProgressPath()
    if !stderrEnabled && len(progressPath) <= 0:
        return
    let line = CompilerProgressLine(phase, status)
    if stderrEnabled:
        os.WriteLine(os.Get_stderr(), line)
    if len(progressPath) > 0:
        let _ = chengpath.AppendTextFile(rootDir, progressPath, Fmt"{line}\n")

@borrows
fn CompilerProgressEnvOverrides(rootDir: str,
                                  args: str[]): str[] =
    var out: str[]
    if CompilerProgressRequestedFromArgs(args):
        add(out, "CHENG_PROGRESS=1")
    let progressOut = CompilerProgressOutPathFromArgs(rootDir, args)
    if len(progressOut) > 0:
        add(out, Fmt"CHENG_PROGRESS_OUT={progressOut}")
    return out

@borrows
fn CompilerActiveRuntimeEnvOverrides(rootDir: str): str[] =
    var out: str[]
    let rootEnv = strutil.Strip(os.GetEnv("CHENG_ROOT"))
    if len(rootEnv) > 0:
        add(out, Fmt"CHENG_ROOT={rootEnv}")
    elif rootdisco.CompilerRootSeedExists(rootDir):
        add(out, Fmt"CHENG_ROOT={rootDir}")
    let progressEnv = strutil.Strip(os.GetEnv("CHENG_PROGRESS"))
    if len(progressEnv) > 0:
        add(out, Fmt"CHENG_PROGRESS={progressEnv}")
    let progressOutEnv = strutil.Strip(os.GetEnv("CHENG_PROGRESS_OUT"))
    if len(progressOutEnv) > 0:
        add(out, Fmt"CHENG_PROGRESS_OUT={progressOutEnv}")
    return out

@borrows
fn CompilerPlanNeedsBootstrapBridge(plan: sexec.SystemLinkExecPlan): bool =
    if plan.systemLinkPlan.missingReasons.len > 0:
        return false
    if plan.loweringPlan.missingReasons.len > 0:
        return false
    if plan.primaryObjectPlan.missingReasons.len > 0:
        return true
    return false

@borrows
fn CompilerAppendReportLine(out: var str,
                              line: str) =
    if len(line) <= 0:
        return
    if len(out) > 0 && out[len(out) - 1] != '\n':
        CompilerAppendOwnedText(out, "\n")
    CompilerAppendOwnedText(out, line)

fn CompilerSystemLinkExecPhaseMsText(ns: int64): str =
    if ns < int64(0):
        return "-1"
    return strings.Int64ToStr(ns / int64(1000000))

fn CompilerStatusBoolDigit(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn CompilerOwnedTextOrDash(value: str): str =
    if len(value) > 0:
        return "" + value
    return "-"

@borrows
fn CompilerAppendSystemLinkExecPhaseLines(out: var str,
                                            plan: sexec.SystemLinkExecPlan) =
    if strutil.Contains(out, "exec_phase_total_ms="):
        return
    CompilerAppendReportLine(out, Fmt"exec_phase_system_link_plan_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.systemLinkPlanNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_source_bundle_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.sourceBundleNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_compiler_csg_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.compilerCsgNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_world_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.worldNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_lock_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.lockNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_baseline_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.baselineNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_lowering_plan_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.loweringPlanNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_primary_object_plan_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.primaryObjectPlanNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_provider_sources_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.providerSourcesNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_object_plan_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.objectPlanNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_native_link_plan_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.nativeLinkPlanNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_compile_receipt_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.compileReceiptNs)}")
    CompilerAppendReportLine(out, Fmt"exec_phase_total_ms={CompilerSystemLinkExecPhaseMsText(plan.phaseProfile.totalNs)}")

fn CompilerSystemLinkExecSummary(plan: var sexec.SystemLinkExecPlan): str =
    let worldHeadPinned = CompilerStatusBoolDigit(plan.worldHeadPinned)
    let lockCheckEnabled = CompilerStatusBoolDigit(plan.lockCheckEnabled)
    let lockVerified = CompilerStatusBoolDigit(plan.lockVerified)
    let baselineSurfaceChecked =
        CompilerStatusBoolDigit(plan.baselineSurfaceChecked)
    let baselineSurfaceCompatible =
        CompilerStatusBoolDigit(plan.baselineSurfaceCompatible)
    let lockPath = CompilerOwnedTextOrDash(plan.lockPath)
    let baselineSurfacePath =
        CompilerOwnedTextOrDash(plan.baselineSurfacePath)
    var out = ""
    CompilerAppendOwnedText(out, Fmt"entry={plan.compilerEntrySource}\n")
    CompilerAppendOwnedText(out, Fmt"target={plan.systemLinkPlan.targetTriple}\n")
    CompilerAppendOwnedText(out, Fmt"output={plan.systemLinkPlan.outputPath}\n")
    CompilerAppendOwnedText(out, "source_bundle_cid=" + layout.FixedBytes32Hex(plan.sourceBundleCid) + "\n")
    CompilerAppendOwnedText(out, "source_manifest_sha256=" + layout.FixedBytes32Hex(plan.compilerCsg.sourceBundleCid) + "\n")
    CompilerAppendOwnedText(out, "source_snapshot_count=" + IntToStr(plan.compilerCsg.sourceSnapshotCount) + "\n")
    CompilerAppendOwnedText(out, "entry_source_cid=" + layout.FixedBytes32Hex(plan.compilerCsg.entrySourceCid) + "\n")
    CompilerAppendOwnedText(out, "entry_mode=unelaborated\n")
    CompilerAppendOwnedText(out, "canonical_compiler_csg_cid=" + layout.FixedBytes32Hex(plan.compilerCsg.canonicalGraphCid) + "\n")
    CompilerAppendOwnedText(out, "compiler_csg_cid=" + layout.FixedBytes32Hex(plan.compilerCsg.graphCid) + "\n")
    CompilerAppendOwnedText(out, "export_surface_cid=" + layout.FixedBytes32Hex(plan.exportSurface.surfaceCid) + "\n")
    CompilerAppendOwnedText(out, "world_head_cid=" + layout.FixedBytes32Hex(plan.localUniverse.worldHead.headCid) + "\n")
    CompilerAppendOwnedText(out, "manifest_root_cid=" + layout.FixedBytes32Hex(plan.localUniverse.manifest.manifestCid) + "\n")
    CompilerAppendOwnedText(out, "manifest_entry_count=" + IntToStr(plan.localUniverse.manifest.entryCount) + "\n")
    CompilerAppendOwnedText(out, "compiler_pkg_cid=" + layout.FixedBytes32Hex(plan.localUniverse.compilerSnapshot.snapshotCid) + "\n")
    CompilerAppendOwnedText(out, "std_pkg_cid=" + layout.FixedBytes32Hex(plan.localUniverse.stdSnapshot.snapshotCid) + "\n")
    CompilerAppendOwnedText(out, "runtime_pkg_cid=" + layout.FixedBytes32Hex(plan.localUniverse.runtimeSnapshot.snapshotCid) + "\n")
    CompilerAppendOwnedText(out, Fmt"world_head_pinned={worldHeadPinned}\n")
    CompilerAppendOwnedText(out, Fmt"lock_check_enabled={lockCheckEnabled}\n")
    CompilerAppendOwnedText(out, Fmt"lock_verified={lockVerified}\n")
    CompilerAppendOwnedText(out, Fmt"lock_path={lockPath}\n")
    CompilerAppendOwnedText(out, Fmt"baseline_surface_checked={baselineSurfaceChecked}\n")
    CompilerAppendOwnedText(out, Fmt"baseline_surface_compatible={baselineSurfaceCompatible}\n")
    CompilerAppendOwnedText(out, Fmt"baseline_surface_path={baselineSurfacePath}\n")
    CompilerAppendOwnedText(out, "compile_receipt_cid=" + layout.FixedBytes32Hex(plan.compileReceipt.receiptCid) + "\n")
    CompilerAppendOwnedText(out, "compile_canonical_output_digest=" + layout.FixedBytes32Hex(plan.compileReceipt.canonicalOutputDigest) + "\n")
    CompilerAppendOwnedText(out, "compile_output_digest=" + layout.FixedBytes32Hex(plan.compileReceipt.outputDigest) + "\n")
    CompilerAppendOwnedText(out, Fmt"compile_bootstrap_stage={plan.compileReceipt.bootstrapStage}")
    CompilerAppendSystemLinkExecPhaseLines(out, plan)
    return out

@borrows
fn CompilerIdentifierExportedByCase(nameRaw: str): bool =
    let name = strutil.Strip(nameRaw)
    if len(name) <= 0:
        return false
    if !(name[0] >= 'A'):
        return false
    if !(name[0] <= 'Z'):
        return false
    return true

@borrows
fn CompilerPackageRootForSource(rootDir: str,
                                  sourcePath: str): str =
    return creq.CompilerResolvePackageRoot(rootDir,
                                             sourcePath,
                                             creq.CompilerDefaultPackageRoot(rootDir))

@borrows
fn CompilerModulePathWithoutPackageScheme(modulePath: str): str =
    if strutil.StartsWith(modulePath, "pkg://"):
        return strings.CloneStrRange(
            modulePath, 6, len(modulePath) - 6)
    return "" + modulePath

@borrows
fn CompilerModulePackageKey(modulePathRaw: str): str =
    let strippedModulePath = strutil.Strip(modulePathRaw)
    if len(strippedModulePath) <= 0:
        return ""
    let modulePath =
        CompilerModulePathWithoutPackageScheme(strippedModulePath)
    if modulePath == "cheng":
        return "cheng"
    var firstSlash: int32 = -1
    for i in 0..<modulePath.len:
        if modulePath[i] == '/':
            firstSlash = i
            break
    if firstSlash < 0:
        return modulePath
    if strutil.StartsWith(modulePath, "cheng/"):
        var secondSlash: int32 = -1
        for i in firstSlash + 1..<modulePath.len:
            if modulePath[i] == '/':
                secondSlash = i
                break
        if secondSlash > 0:
            return strings.CloneStrRange(modulePath, 0, secondSlash)
    return strings.CloneStrRange(modulePath, 0, firstSlash)

@borrows
fn CompilerModulePathsSharePackage(leftModulePath: str,
                                     rightModulePath: str): bool =
    let leftKey = CompilerModulePackageKey(leftModulePath)
    let rightKey = CompilerModulePackageKey(rightModulePath)
    if len(leftKey) <= 0 || len(rightKey) <= 0:
        return false
    let leftShared = leftKey == "cheng" || leftKey == "std" || leftKey == "stage1"
    let rightShared = rightKey == "cheng" || rightKey == "std" || rightKey == "stage1"
    if leftShared && rightShared:
        return true
    if leftKey == rightKey:
        return true
    return false

@borrows
fn CompilerBuildExprCallProfiles(plan: sexec.SystemLinkExecPlan,
                                   profiles: var parser.NormalizedExprCallProfile[],
                                   lookup: var parser.ParserSourcePathIndexLookup,
                                   err: var str): bool =
    var out: parser.NormalizedExprCallProfile[]
    let linkPlan = plan.systemLinkPlan
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    for i in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[i]
        let sourceText = chengpath.ReadTextFile("", sourcePath)
        if sourceText == "":
            err = " compiler: failed to read source closure text"
            return false
        var profile: parser.NormalizedExprCallProfile
        var profileErr = ""
        if !parser.ParserBuildExprCallProfileWithExternalPackageRoots(linkPlan.workspaceRoot,
                                                                        linkPlan.packageRoot,
                                                                        externalPackageRoots,
                                                                        sourcePath,
                                                                        sourceText,
                                                                        profile,
                                                                        profileErr):
            err = profileErr
            return false
        add(out, profile)
    lookup = parser.ParserSourcePathIndexLookupBuild(out)
    parser.ParserBindImportEdgeTargetProfileIndices(out, lookup)
    profiles = out
    err = ""
    return true

@borrows
fn CompilerImportQualifierRoot(qualifierFull: str): str =
    for i in 0..<qualifierFull.len:
        if qualifierFull[i] == '.':
            return strings.CloneStrRange(qualifierFull, 0, i)
    return "" + qualifierFull

@borrows
fn CompilerImportQualifierTargetModulePath(profile: parser.NormalizedExprCallProfile,
                                             qualifierRaw: str): str =
    let qualifierFull = strutil.Strip(qualifierRaw)
    if qualifierFull == "":
        return ""
    let qualifier = CompilerImportQualifierRoot(qualifierFull)
    for i in 0..<profile.importEdges.len:
        let edge = profile.importEdges[i]
        if strutil.Strip(edge.qualifier) != qualifier:
            continue
        let targetModulePath = strutil.Strip(edge.targetModulePath)
        if targetModulePath != "":
            return strings.CloneStr(targetModulePath)
    for i in 0..<profile.lines.len:
        if parser.ParserHasLeadingIndent(profile.lines[i]):
            continue
        let line = strutil.Strip(parser.ParserStripLineComment(profile.lines[i]))
        if !strutil.StartsWith(line, "import "):
            continue
        var asPos: int32 = -1
        var j: int32
        while j + 4 <= line.len:
            if strings.SliceBytes(line, j, 4) == " as ":
                asPos = j
            j = j + 1
        if asPos < 0:
            continue
        let aliasText = strutil.Strip(strings.SliceBytes(line, asPos + 4, line.len - asPos - 4))
        if aliasText != qualifier:
            continue
        return strutil.Strip(strings.SliceBytes(line, len("import "), asPos - len("import ")))
    return ""

@borrows
fn CompilerAppendPrivateImportDiagnostic(out: var str[],
                                           memberNameRaw: str) =
    let memberName = strutil.Strip(memberNameRaw)
    if memberName == "" || CompilerIdentifierExportedByCase(memberName):
        return
    let diagnostic = " compiler: imported private symbol '" + memberName + "' is not exported; use uppercase initial"
    if !parser.ParserStringSeqContainsExact(out, diagnostic):
        add(out, diagnostic)

@borrows
fn CompilerScanAliasPrivateUsesInLines(lines: str[],
                                         alias: str,
                                         out: var str[]) =
    if alias == "":
        return
    for lineIndex in 0..<lines.len:
        let line = parser.ParserStripLineComment(lines[lineIndex])
        var pos: int32
        var inString = false
        var inChar = false
        while pos < line.len:
            let ch = line[pos]
            if !inChar && ch == char(34) && !parser.ParserQuoteIsEscaped(line, pos):
                inString = !inString
                pos = pos + 1
                continue
            if !inString && ch == char(39) && !parser.ParserQuoteIsEscaped(line, pos):
                inChar = !inChar
                pos = pos + 1
                continue
            if inString || inChar:
                pos = pos + 1
                continue
            if !parser.ParserTextEqualsAt(line, pos, alias):
                pos = pos + 1
                continue
            let aliasEnd = pos + alias.len
            if pos > 0 && parser.ParserIsIdentChar(line[pos - 1]):
                pos = pos + 1
                continue
            if aliasEnd >= line.len || line[aliasEnd] != '.':
                pos = pos + 1
                continue
            let memberStart = aliasEnd + 1
            if memberStart >= line.len || !parser.ParserIsIdentChar(line[memberStart]):
                pos = pos + 1
                continue
            var memberStop = memberStart
            while memberStop < line.len && parser.ParserIsIdentChar(line[memberStop]):
                memberStop = memberStop + 1
            CompilerAppendPrivateImportDiagnostic(out,
                                                    strings.SliceBytes(line,
                                                                       memberStart,
                                                                       memberStop - memberStart))
            pos = memberStop
    return

@borrows
fn CompilerScanSourcePrivateImportDiagnostics(linkPlan: slplan.SystemLinkPlanStub,
                                                out: var str[]) =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    for sourceIndex in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[sourceIndex]
        let text = chengpath.ReadTextFile("", sourcePath)
        if text == "":
            continue
        let lines = parser.ParserSplitChar(text, '\n')
        let ownerModulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(linkPlan.workspaceRoot,
                                                                                             linkPlan.packageRoot,
                                                                                             externalPackageRoots,
                                                                                             sourcePath)
        for lineIndex in 0..<lines.len:
            if parser.ParserHasLeadingIndent(lines[lineIndex]):
                continue
            let line = strutil.Strip(parser.ParserStripLineComment(lines[lineIndex]))
            if !strutil.StartsWith(line, "import "):
                continue
            var asPos: int32 = -1
            var i: int32
            while i + 4 <= line.len:
                if strings.SliceBytes(line, i, 4) == " as ":
                    asPos = i
                i = i + 1
            if asPos < 0:
                continue
            let modulePath = strutil.Strip(strings.SliceBytes(line,
                                                              len("import "),
                                                              asPos - len("import ")))
            let alias = strutil.Strip(strings.SliceBytes(line, asPos + 4, line.len - asPos - 4))
            if modulePath == "" || alias == "":
                continue
            if CompilerModulePathsSharePackage(ownerModulePath, modulePath):
                continue
            CompilerScanAliasPrivateUsesInLines(lines, alias, out)
    return

@borrows
fn CompilerScanProfilePrivateAliasUses(profile: parser.NormalizedExprCallProfile,
                                         out: var str[]) =
    for edgeIndex in 0..<profile.importEdges.len:
        let edge = profile.importEdges[edgeIndex]
        let alias = strutil.Strip(edge.qualifier)
        let targetModulePath = CompilerImportQualifierTargetModulePath(profile, alias)
        if alias == "" || targetModulePath == "":
            continue
        if CompilerModulePathsSharePackage(profile.ownerModulePath, targetModulePath):
            continue
        for lineIndex in 0..<profile.lines.len:
            let line = parser.ParserStripLineComment(profile.lines[lineIndex])
            var pos: int32
            while pos < line.len:
                if !parser.ParserTextEqualsAt(line, pos, alias):
                    pos = pos + 1
                    continue
                let aliasEnd = pos + alias.len
                if pos > 0 && parser.ParserIsIdentChar(line[pos - 1]):
                    pos = pos + 1
                    continue
                if aliasEnd >= line.len || line[aliasEnd] != '.':
                    pos = pos + 1
                    continue
                let memberStart = aliasEnd + 1
                if memberStart >= line.len || !parser.ParserIsIdentChar(line[memberStart]):
                    pos = pos + 1
                    continue
                var memberStop = memberStart
                while memberStop < line.len && parser.ParserIsIdentChar(line[memberStop]):
                    memberStop = memberStop + 1
                CompilerAppendPrivateImportDiagnostic(out,
                                                        strings.SliceBytes(line,
                                                                           memberStart,
                                                                           memberStop - memberStart))
                pos = memberStop
    return

@borrows
fn CompilerSystemLinkExecPrivateImportDiagnostics(plan: sexec.SystemLinkExecPlan): str[] =
    var out: str[]
    let linkPlan = plan.systemLinkPlan
    if linkPlan.unresolvedImportCount <= 0:
        return out
    if linkPlan.exprLayer.exprs.len <= 0:
        CompilerScanSourcePrivateImportDiagnostics(linkPlan, out)
        return out
    CompilerScanSourcePrivateImportDiagnostics(linkPlan, out)
    if out.len > 0:
        return out
    var profiles: parser.NormalizedExprCallProfile[]
    var lookup = parser.ParserSourcePathIndexLookup()
    var buildErr = ""
    if !CompilerBuildExprCallProfiles(plan, profiles, lookup, buildErr):
        let _ = buildErr
        return out
    for i in 0..<profiles.len:
        CompilerScanProfilePrivateAliasUses(profiles[i], out)
    for i in 0..<linkPlan.exprLayer.exprs.len:
        let expr = linkPlan.exprLayer.exprs[i]
        if expr.callSurfaceKind != parser.NormalizedExprSurfaceCallMember:
            continue
        if expr.callResolved:
            continue
        if expr.callReason != parser.NormalizedExprCallReasonUnknownQualifiedTarget:
            continue
        if expr.callQualifier == "" || expr.callCallee == "":
            continue
        if CompilerIdentifierExportedByCase(expr.callCallee):
            continue
        let currentProfileIndex = parser.ParserProfileIndexLookupForNormalizedSourcePathExact(lookup,
                                                                                                 parser.ParserNormalizePath(expr.sourcePath))
        if currentProfileIndex < 0 || currentProfileIndex >= profiles.len:
            continue
        let currentProfile = profiles[currentProfileIndex]
        let targetModulePath = CompilerImportQualifierTargetModulePath(currentProfile,
                                                                         expr.callQualifier)
        if targetModulePath == "":
            continue
        if CompilerModulePathsSharePackage(currentProfile.ownerModulePath, targetModulePath):
            continue
        CompilerAppendPrivateImportDiagnostic(out, expr.callCallee)
    return out

fn CompilerSystemLinkExecFullReport(plan: var sexec.SystemLinkExecPlan): str =
    var out = sexec.SystemLinkExecPlanReport(plan)
    CompilerAppendSystemLinkExecPhaseLines(out, plan)
    return out

@borrows
fn CompilerSystemLinkExecBoundedReport(plan: sexec.SystemLinkExecPlan): str =
    var out = ""
    CompilerAppendReportLine(out, Fmt"entry={plan.compilerEntrySource}")
    CompilerAppendReportLine(out, Fmt"target={plan.systemLinkPlan.targetTriple}")
    CompilerAppendReportLine(out, Fmt"emit={creq.CompilerEmitText(plan.systemLinkPlan.emitKind)}")
    CompilerAppendReportLine(out, Fmt"output={plan.systemLinkPlan.outputPath}")
    CompilerAppendReportLine(out, Fmt"source_bundle_cid={layout.FixedBytes32Hex(plan.compilerCsg.sourceBundleCid)}")
    CompilerAppendReportLine(out, Fmt"source_manifest_sha256={layout.FixedBytes32Hex(plan.compilerCsg.sourceBundleCid)}")
    CompilerAppendReportLine(out, Fmt"source_snapshot_count={plan.compilerCsg.sourceSnapshotCount}")
    CompilerAppendReportLine(out, Fmt"entry_source_cid={layout.FixedBytes32Hex(plan.compilerCsg.entrySourceCid)}")
    CompilerAppendReportLine(out, "entry_mode=unelaborated")
    CompilerAppendReportLine(out, Fmt"canonical_compiler_csg_cid={layout.FixedBytes32Hex(plan.compilerCsg.canonicalGraphCid)}")
    CompilerAppendReportLine(out, Fmt"source_identity_receipt_cid={layout.FixedBytes32Hex(plan.compilerCsg.sourceIdentityReceipt.receiptCid)}")
    CompilerAppendReportLine(out, Fmt"semantic_receipt_cid={layout.FixedBytes32Hex(plan.semanticReceipt.receiptCid)}")
    CompilerAppendReportLine(out, Fmt"source_to_csg_binding_seal={layout.FixedBytes32Hex(plan.sourceToCsgBindingSeal)}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_world_head_cid={layout.FixedBytes32Hex(plan.compileReceipt.worldHeadCid)}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_source_identity_receipt_cid={layout.FixedBytes32Hex(plan.compileReceipt.sourceIdentityReceiptCid)}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_semantic_receipt_cid={layout.FixedBytes32Hex(plan.compileReceipt.semanticReceiptCid)}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_target={plan.compileReceipt.targetTriple}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_output_digest={layout.FixedBytes32Hex(plan.compileReceipt.outputDigest)}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_canonical_output_digest={layout.FixedBytes32Hex(plan.compileReceipt.canonicalOutputDigest)}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_bootstrap_stage={plan.compileReceipt.bootstrapStage}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_runtime_provider_count={plan.compileReceipt.runtimeProviderSet.len}")
    for providerIndex in 0..<plan.compileReceipt.runtimeProviderSet.len:
        CompilerAppendReportLine(
            out,
            Fmt"compile_receipt_runtime_provider.{providerIndex}={plan.compileReceipt.runtimeProviderSet[providerIndex]}")
    CompilerAppendReportLine(out, Fmt"compile_receipt_cid={layout.FixedBytes32Hex(plan.compileReceipt.receiptCid)}")
    if plan.compositionManifestSchema.len > 0:
        CompilerAppendReportLine(
            out,
            Fmt"composition_manifest_schema={plan.compositionManifestSchema}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_manifest_sha256={plan.compositionManifestSha256}")
        let kernelManifestSha256 =
            plan.compositionKernelManifestSha256.len > 0 ?
                strings.CloneStr(
                    plan.compositionKernelManifestSha256) : "-"
        CompilerAppendReportLine(
            out,
            Fmt"composition_kernel_manifest_sha256={kernelManifestSha256}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_kind={plan.compositionKind}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_entry_source={plan.compositionEntrySource}")
        let pluginTriple =
            plan.compositionPluginCanonicalTriple.len > 0 ?
                strings.CloneStr(
                    plan.compositionPluginCanonicalTriple) : "-"
        CompilerAppendReportLine(
            out,
            Fmt"composition_plugin_canonical_triple={pluginTriple}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_declared_source_count={plan.compositionDeclaredSourceCount}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_declared_sources_sha256={plan.compositionDeclaredSourcesSha256}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_source_closure_count={plan.compositionSourceClosureCount}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_source_closure_sha256={plan.compositionSourceClosureSha256}")
        CompilerAppendReportLine(
            out,
            Fmt"composition_source_identity_receipt_cid={layout.FixedBytes32Hex(plan.compositionSourceIdentityReceiptCid)}")
    CompilerAppendReportLine(out, Fmt"ready_code={plan.readyCode}")
    CompilerAppendReportLine(out, Fmt"not_ready_code={plan.notReadyCode}")
    CompilerAppendReportLine(out, Fmt"not_ready_detail_code={plan.notReadyDetailCode}")
    CompilerAppendReportLine(out, Fmt"not_ready_reason={plan.notReadyReason}")
    CompilerAppendReportLine(out, Fmt"compiler_csg_typed_ir_function_count={plan.compilerCsgTypedIrFunctionCount}")
    CompilerAppendReportLine(out, Fmt"compiler_csg_typed_ir_node_count={plan.compilerCsgTypedIrNodeCount}")
    CompilerAppendReportLine(out, Fmt"compiler_csg_typed_ir_statement_count={plan.compilerCsgTypedIrStatementCount}")
    CompilerAppendReportLine(out, Fmt"compiler_csg_expr_layer_expr_count={plan.compilerCsgExprLayerExprCount}")
    CompilerAppendReportLine(out, Fmt"lowering_function_count={plan.loweringFunctionCount}")
    CompilerAppendReportLine(out, Fmt"lowering_typed_ir_function_count={plan.loweringTypedIrFunctionCount}")
    CompilerAppendReportLine(out, Fmt"lowering_typed_ir_node_count={plan.loweringTypedIrNodeCount}")
    CompilerAppendReportLine(out, Fmt"lowering_typed_ir_statement_count={plan.loweringTypedIrStatementCount}")
    CompilerAppendReportLine(out, Fmt"lowering_primary_ir_function_count={plan.loweringPrimaryIrFunctionCount}")
    CompilerAppendReportLine(out, Fmt"lowering_primary_ir_skipped_function_count={plan.loweringPrimaryIrSkippedFunctionCount}")
    CompilerAppendReportLine(out, Fmt"lowering_missing_count={plan.loweringMissingCount}")
    CompilerAppendReportLine(out, Fmt"primary_plan_item_count={plan.primaryPlanItemCount}")
    CompilerAppendReportLine(out, Fmt"primary_plan_reachable_function_count={plan.primaryPlanReachableFunctionCount}")
    CompilerAppendReportLine(out, Fmt"primary_plan_instruction_word_count={plan.primaryPlanInstructionWordCount}")
    CompilerAppendReportLine(out, Fmt"primary_plan_missing_count={plan.primaryPlanMissingCount}")
    CompilerAppendReportLine(out, Fmt"primary_plan_error_body_kind_code={plan.primaryPlanErrorBodyKindCode}")
    CompilerAppendReportLine(out, Fmt"provider_object_count={plan.objectPlan.providerObjectPaths.len}")
    CompilerAppendReportLine(out, Fmt"object_link_input_count={plan.objectPlan.linkInputPaths.len}")
    CompilerAppendSystemLinkExecPhaseLines(out, plan)
    return out

@borrows
fn CompilerWriteSystemLinkExecFullReport(rootDir: str,
                                           reportPath: str,
                                           plan: var sexec.SystemLinkExecPlan): bool =
    if len(reportPath) <= 0:
        return true
    if !CompilerWriteOptionalReport(rootDir, reportPath, CompilerSystemLinkExecSummary(plan)):
        return false
    return CompilerWriteOptionalReport(rootDir, reportPath, CompilerSystemLinkExecFullReport(plan))

fn CompilerRequirePureSystemLinkExec(): bool =
    if cmdline.HasFlag("--require-pure-system-link-exec"):
        return true
    let raw = strutil.Strip(os.GetEnv("CHENG_REQUIRE_PURE_SYSTEM_LINK_EXEC"))
    if !(len(raw) > 0):
        return false
    if !(raw != "0"):
        return false
    if !(raw != "false"):
        return false
    return true

@borrows
fn CompilerFileSha256(path: str): str =
    if !os.FileExists(path):
        return ""
    let content = os.ReadFile(path)
    if len(content) == 0 && os.FileSize(path) > 0:
        return ""
    return strings.Sha256(content)

@borrows
fn CompilerSha256TextValid(value: str): bool =
    if value.len != 64:
        return false
    var nonZero = false
    for i in 0..<value.len:
        let ch = value[i]
        if !((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')):
            return false
        if ch != '0':
            nonZero = true
    return nonZero

@borrows
fn CompilerSha256CidTextValid(value: str): bool =
    if value.len != 71 ||
       !strutil.StartsWith(value, "sha256:"):
        return false
    return CompilerSha256TextValid(
        strings.SliceBytes(value, 7, 64))

@borrows
fn CompilerReportValueExact(report: str,
                             key: str,
                             value: var str): bool =
    value = ""
    let prefix = Fmt"{key}="
    let lines = strutil.Split(report, '\n')
    var found = false
    for i in 0..<lines.len:
        if !strutil.StartsWith(lines[i], prefix):
            continue
        if found:
            return false
        found = true
        value = strings.DropPrefix(lines[i], prefix)
    return found && len(value) > 0

fn CompilerSystemLinkExecEnvDebugEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_DEBUG_SYSTEM_LINK_EXEC"))
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

@borrows
fn CompilerOutputReceiptCidText(
        plan: var sexec.SystemLinkExecPlan,
        outputSha256: str,
        backend2VersionManifestSha256: str): str =
    if outputSha256 == "-" ||
       backend2VersionManifestSha256 == "-":
        return "-"
    let outputSha256Res =
        layout.FixedBytes32FromHex(outputSha256)
    let backend2VersionManifestSha256Res =
        layout.FixedBytes32FromHex(
            backend2VersionManifestSha256)
    if IsErr(outputSha256Res) ||
       IsErr(backend2VersionManifestSha256Res):
        return "-"
    let receiptCid = ccsg.CompileOutputReceiptCid(
        plan.compileReceipt.receiptCid,
        Value(outputSha256Res),
        Value(backend2VersionManifestSha256Res),
        plan.systemLinkPlan.targetTriple)
    return layout.FixedBytes32Hex(receiptCid)

@borrows
fn CompilerGateLoweringSchedule(
        plan: sexec.SystemLinkExecPlan): str =
    if plan.loweringTaskCount <= 0:
        return "none"
    if plan.loweringActiveWorkerCount > 1 &&
       plan.loweringCompletedWorkerCount == plan.loweringActiveWorkerCount:
        return "ws"
    if plan.loweringActiveWorkerCount == 1 &&
       plan.loweringCompletedWorkerCount == 1:
        return "serial"
    return "inactive"

@borrows
fn CompilerWriteSystemLinkExecRuntimeReport(rootDir: str,
                                             reportPath: str,
                                             plan: var sexec.SystemLinkExecPlan,
                                             runtimeReport: str): bool =
    if len(reportPath) <= 0:
        return true
    if plan.compositionManifestSchema.len > 0 &&
       layout.FixedBytes32Equal(
           plan.compositionSourceIdentityReceiptCid,
           layout.FixedBytes32()):
        CompilerPrintErr(
            "HARD_RED:composition_report_source_identity_receipt_missing")
        return false
    var report = CompilerSystemLinkExecBoundedReport(plan)
    if len(runtimeReport) > 0:
        CompilerAppendOwnedText(report, Fmt"\n{runtimeReport}")
    let nativeLogPath = Fmt"{plan.systemLinkPlan.outputPath}.native_link.log"
    if len(nativeLogPath) > 0 && chengpath.PathFileExists(nativeLogPath):
        CompilerAppendReportLine(report, Fmt"native_link_log_path={nativeLogPath}")
        CompilerAppendReportLine(report, Fmt"native_link_log_size_bytes={strings.Int64ToStr(chengpath.PathFileSize(nativeLogPath))}")
    CompilerAppendReportLine(report, "system_link_exec=1")
    CompilerAppendReportLine(report, "real_backend_codegen=1")
    CompilerAppendReportLine(report, "cold_system_link_exec=0")
    CompilerAppendReportLine(report, "system_link_exec_scope=selfhost_direct")
    CompilerAppendReportLine(report, "full_backend_codegen=1")
    let compilerCompositionKind =
        codegen_contract.CodegenCompositionKindText()
    let compilerCompositionUnitId =
        codegen_contract.CodegenCompositionSingleUnitId()
    let compilerCompositionUnitTripleRaw =
        codegen_contract.CodegenCompositionUnitCanonicalTriple()
    let compilerCompositionUnitTriple =
        compilerCompositionUnitTripleRaw.len > 0 ?
            strings.CloneStr(compilerCompositionUnitTripleRaw) : "-"
    CompilerAppendReportLine(
        report,
        Fmt"compiler_composition_kind={compilerCompositionKind}")
    CompilerAppendReportLine(
        report,
        Fmt"compiler_composition_unit_id={compilerCompositionUnitId}")
    CompilerAppendReportLine(
        report,
        Fmt"compiler_composition_unit_triple={compilerCompositionUnitTriple}")
    let compilerExecutableCid =
        system.RuntimeHeldExecChildExecutableCid()
    if !CompilerSha256CidTextValid(compilerExecutableCid):
        CompilerPrintErr(
            "HARD_RED:compiler_report_held_executable_cid_missing")
        return false
    CompilerAppendReportLine(
        report,
        Fmt"compiler_executable_cid={compilerExecutableCid}")
    let outputSha256Raw =
        CompilerFileSha256(plan.systemLinkPlan.outputPath)
    let outputSha256 =
        CompilerOwnedTextOrDash(outputSha256Raw)
    CompilerAppendReportLine(report, Fmt"output_sha256={outputSha256}")
    let backend2VersionManifestPath = chengpath.PathAbsolute(
        rootDir, "tools/backend2_version_manifest.rec")
    let backend2VersionManifestSha256Raw =
        CompilerFileSha256(backend2VersionManifestPath)
    let backend2VersionManifestSha256 =
        CompilerOwnedTextOrDash(
            backend2VersionManifestSha256Raw)
    CompilerAppendReportLine(
        report,
        Fmt"backend2_version_manifest_sha256={backend2VersionManifestSha256}")
    let compilerOutputReceiptCid =
        CompilerOutputReceiptCidText(
            plan,
            outputSha256,
            backend2VersionManifestSha256)
    CompilerAppendReportLine(
        report, Fmt"compiler_output_receipt_cid={compilerOutputReceiptCid}")
    var exactFunctionCoverageReport = ""
    sexec.SystemLinkExecExactFunctionCoverageReportAppend(exactFunctionCoverageReport,
                                                           plan.exactFunctionCoverage)
    if len(exactFunctionCoverageReport) > 0:
        CompilerAppendOwnedText(report, exactFunctionCoverageReport)
    # G-line parallel coverage fields for the perf gate.
    let gateLoweringSchedule = CompilerGateLoweringSchedule(plan)
    CompilerAppendReportLine(report, Fmt"function_task_schedule={gateLoweringSchedule}")
    CompilerAppendReportLine(report, Fmt"lowering_parallel_task_count={strings.IntToStr(plan.loweringTaskCount)}")
    CompilerAppendReportLine(report, "lowering_parallel_merge_order=decl_ordinal")
    CompilerAppendReportLine(report, Fmt"codegen_schedule={plan.primaryObjectPlan.wordFillSchedule}")
    CompilerAppendReportLine(report, Fmt"codegen_task_count={strings.IntToStr(plan.primaryObjectPlan.wordFillTaskCount)}")
    CompilerAppendReportLine(report, Fmt"codegen_worker_count={strings.IntToStr(plan.primaryObjectPlan.wordFillWorkerCount)}")
    CompilerAppendReportLine(report, Fmt"codegen_deterministic_merge={plan.primaryObjectPlan.wordFillMergeOrder}")
    return CompilerWriteOptionalReport(rootDir, reportPath, report)

@borrows
fn CompilerPureSystemLinkExecUnsupported(reason: str): int32 =
    if CompilerRequirePureSystemLinkExec():
        CompilerPrintErr(reason)
        return 2
    return -1

@borrows
fn CompilerWritePureSystemLinkExecErrorReport(rootDir: str,
                                               reportPath: str,
                                               plan: sexec.SystemLinkExecPlan,
                                               reason: str): bool =
    if len(reportPath) <= 0:
        return true
    var report = CompilerSystemLinkExecBoundedReport(plan)
    CompilerAppendReportLine(report, "system_link_exec_runtime_execute=0")
    CompilerAppendReportLine(report, "system_link_exec=0")
    CompilerAppendReportLine(report, "real_backend_codegen=0")
    CompilerAppendReportLine(report, "cold_system_link_exec=0")
    CompilerAppendReportLine(report, "system_link_exec_scope=selfhost_runtime_error")
    CompilerAppendReportLine(report, "full_backend_codegen=0")
    CompilerAppendReportLine(report, Fmt"error={reason}")
    let nativeLogPath = Fmt"{plan.systemLinkPlan.outputPath}.native_link.log"
    if len(nativeLogPath) > 0 && chengpath.PathFileExists(nativeLogPath):
        CompilerAppendReportLine(report, Fmt"native_link_log_path={nativeLogPath}")
        CompilerAppendReportLine(report, Fmt"native_link_log_size_bytes={strings.Int64ToStr(chengpath.PathFileSize(nativeLogPath))}")
    if strutil.Contains(report, "exact_function_codegen_"):
        CompilerPrintErr(" compiler: error report contains actual-codegen exact-function fields")
        return false
    return CompilerWriteOptionalReport(rootDir, reportPath, report)

@borrows
fn CompilerCanonicalSystemLinkExecRuntime(
        rootDir: str,
        plan: var sexec.SystemLinkExecPlan,
        providerCompilerPath: str): Result[sexecrt.SystemLinkExecRuntimeResult] =
    return sexecrt.SystemLinkExecRuntimeExecutePlanWithCompiler(
        rootDir,
        plan,
        providerCompilerPath)

@borrows
fn CompilerTryRunPureSystemLinkExec(rootDir: str,
                                      req: creq.CompilerRequest,
                                      plan: var sexec.SystemLinkExecPlan): int32 =
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=pure_enter")
    if !sexec.SystemLinkExecPlanReady(plan):
        if CompilerSystemLinkExecEnvDebugEnabled():
            CompilerPrintErr("debug_system_link_exec=pure_plan_not_ready")
        return CompilerPureSystemLinkExecUnsupported(" compiler pure system-link-exec: plan not ready")
    let providerCompilerPath: str = CompilerCurrentExecutablePath(rootDir)
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=pure_before_runtime_execute")
    let execRes = CompilerCanonicalSystemLinkExecRuntime(
        rootDir,
        plan,
        providerCompilerPath)
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=pure_after_runtime_execute")
    if IsErr(execRes):
        let reason: str = execRes.err.msg
        if CompilerSystemLinkExecEnvDebugEnabled():
            CompilerPrintErr(Fmt"debug_system_link_exec=pure_runtime_error={reason}")
        let _errorReport = CompilerWritePureSystemLinkExecErrorReport(rootDir,
                                                                      req.reportPath,
                                                                      plan,
                                                                      reason)
        return CompilerPureSystemLinkExecUnsupported(reason)
    let execResult = Value(execRes)
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=pure_before_output_validate")
    if chengpath.PathFileSize(req.outputPath) <= Int64(0) &&
       chengpath.PathReadTextFileWithHandle(req.outputPath) == "":
        CompilerPrintErr(Fmt" compiler pure system-link-exec: output missing after runtime execute: {req.outputPath}")
        return 2
    if req.emitKind == creq.EmitExe:
        let mapPath = Fmt"{req.outputPath}.map"
        if chengpath.PathReadTextFileWithHandle(mapPath) == "":
            CompilerPrintErr(Fmt" compiler pure system-link-exec: map missing after runtime execute: {mapPath}")
            return 2
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=pure_before_report_write")
    let runtimeReport = sexecrt.SystemLinkExecRuntimeResultReport(execResult)
    if !CompilerWriteSystemLinkExecRuntimeReport(rootDir, req.reportPath, plan, runtimeReport):
        CompilerPrintErr(Fmt" compiler: failed to write pure system-link-exec report: {req.reportPath}")
        return 2
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=pure_after_report_write")
    if len(req.reportPath) > 0 && chengpath.PathReadTextFileWithHandle(req.reportPath) == "":
        CompilerPrintErr(Fmt" compiler pure system-link-exec: report missing after runtime execute: {req.reportPath}")
        return 2
    if plan.compositionManifestSchema.len > 0:
        let compositionOutputSha256 =
            layout.FixedBytes32Hex(execResult.outputSha256)
        let compositionReportSha256 =
            CompilerFileSha256(req.reportPath)
        if !CompilerSha256TextValid(compositionReportSha256):
            CompilerPrintErr(
                "HARD_RED:composition_execution_report_identity_missing")
            return 2
        CompilerPrintLine(
            Fmt"composition_execution_output_sha256={compositionOutputSha256}")
        CompilerPrintLine(
            Fmt"composition_execution_report_sha256={compositionReportSha256}")
    let productionOutputCid =
        Fmt"sha256:{layout.FixedBytes32Hex(execResult.outputSha256)}"
    let productionCompileReceiptCid =
        Fmt"sha256:{layout.FixedBytes32Hex(execResult.compileReceiptCid)}"
    let productionCompileReceiptCanonical =
        ccsg.CompileReceiptReport(plan.compileReceipt)
    var productionVerifiedCompileReceipt: ccsg.CompileReceipt
    let productionCompileReceiptParse =
        ccsg.CompileReceiptFromReportText(
            productionCompileReceiptCanonical,
            productionVerifiedCompileReceipt)
    if IsErr(productionCompileReceiptParse) ||
       !layout.FixedBytes32Equal(
           productionVerifiedCompileReceipt.receiptCid,
           execResult.compileReceiptCid):
        CompilerPrintErr(
            "HARD_RED:production_held_exec_compile_receipt_canonical_invalid")
        return 2
    let productionOutputHostPath = chengpath.PathHostFilePath(
        chengpath.PathAbsolute(rootDir, req.outputPath))
    if productionOutputHostPath.len <= 0:
        CompilerPrintErr(
            "HARD_RED:production_held_exec_output_path_invalid")
        return 2
    var productionPublishErr: str
    if !production_launcher.CsgCoreProductionLauncherPublishSystemLinkExecOutputInto(
           productionOutputCid,
           productionCompileReceiptCid,
           productionCompileReceiptCanonical,
           productionOutputHostPath,
           productionPublishErr):
        CompilerPrintErr(
            Fmt"HARD_RED:production_held_exec_output_publish:{productionPublishErr}")
        return 2
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=pure_return_success")
    return 0

@borrows
fn CompilerWriteSystemLinkExecSuccessInvariantReport(rootDir: str,
                                                      req: creq.CompilerRequest,
                                                      reason: str): bool =
    if len(req.reportPath) <= 0:
        return true
    var report = ""
    CompilerAppendReportLine(report, "system_link_exec_runtime_execute=0")
    CompilerAppendReportLine(report, "system_link_exec=0")
    CompilerAppendReportLine(report, "real_backend_codegen=0")
    CompilerAppendReportLine(report, "cold_system_link_exec=0")
    CompilerAppendReportLine(report, "system_link_exec_scope=generated_success_invariant")
    CompilerAppendReportLine(report, "full_backend_codegen=0")
    CompilerAppendReportLine(report, Fmt"error={reason}")
    return CompilerWriteOptionalReport(rootDir, req.reportPath, report)

@borrows
fn CompilerValidateSystemLinkExecSuccess(rootDir: str,
                                          req: creq.CompilerRequest,
                                          phase: str): int32 =
    if req.emitKind == creq.EmitObj:
        return 0
    if chengpath.PathFileSize(req.outputPath) <= Int64(0) &&
       chengpath.PathReadTextFileWithHandle(req.outputPath) == "":
        # Two independent probes: the fopen-based size check is known to
        # miscompile per call site in large cold images; the NUL-safe text
        # read builtin stays reliable there.
        let reason = Fmt" compiler system-link-exec: generated command returned success without output after {phase}: {req.outputPath}"
        let _ = CompilerWriteSystemLinkExecSuccessInvariantReport(rootDir, req, reason)
        CompilerPrintErr(reason)
        return 2
    if req.emitKind == creq.EmitExe:
        let mapPath = Fmt"{req.outputPath}.map"
        if chengpath.PathReadTextFileWithHandle(mapPath) == "":
            let reason = Fmt" compiler system-link-exec: generated command returned success without map after {phase}: {mapPath}"
            let _ = CompilerWriteSystemLinkExecSuccessInvariantReport(rootDir, req, reason)
            CompilerPrintErr(reason)
            return 2
    if len(req.reportPath) > 0 && chengpath.PathReadTextFileWithHandle(req.reportPath) == "":
        let reason = Fmt" compiler system-link-exec: generated command returned success without report after {phase}: {req.reportPath}"
        let _ = CompilerWriteSystemLinkExecSuccessInvariantReport(rootDir, req, reason)
        CompilerPrintErr(reason)
        return 2
    return 0

@borrows
fn CompilerBrowserBridgeCompilerPath(rootDir: str,
                                       plan: sexec.SystemLinkExecPlan): str =
    let bridgeCompiler = CompilerBridgeCompilerPath(rootDir)
    if len(bridgeCompiler) > 0:
        return bridgeCompiler
    if CompilerPlanNeedsBootstrapBridge(plan):
        let bootstrapBridge = CompilerBootstrapBridgePath(rootDir, "browser bridge object")
        if len(bootstrapBridge) > 0:
            return bootstrapBridge
    return CompilerCurrentExecutablePath(rootDir)

@borrows
fn CompilerWriteBrowserBridgeArtifacts(rootDir: str,
                                         plan: sexec.SystemLinkExecPlan): bool =
    if !sexec.SystemLinkExecWriteBrowserBridgeArtifact(rootDir, plan):
        return false
    if !sexec.SystemLinkExecWriteBrowserBridgeSource(rootDir, plan):
        return false
    return true

@borrows
fn CompilerMaterializeBrowserBridgeObject(rootDir: str,
                                            plan: sexec.SystemLinkExecPlan): bool =
    let bridgeObjectPath = sexec.SystemLinkExecBrowserBridgeObjectPath(plan)
    let bridgeObjectBasePath = sexec.SystemLinkExecBrowserBridgeObjectBasePath(plan.systemLinkPlan.outputPath)
    if len(bridgeObjectBasePath) > 0 && len(bridgeObjectPath) <= 0:
        if os.FileExists(bridgeObjectBasePath):
            let _ = os.RemoveFile(bridgeObjectBasePath)
        return true
    if len(bridgeObjectPath) <= 0:
        return true
    let bridgeSourcePath = sexec.SystemLinkExecBrowserBridgeSourcePath(plan)
    if len(bridgeSourcePath) <= 0 || !chengpath.FileExistsNonEmpty(rootDir, bridgeSourcePath):
        return false
    let compilerPath = CompilerBrowserBridgeCompilerPath(rootDir, plan)
    if len(compilerPath) <= 0:
        return false
    if os.FileExists(bridgeObjectPath):
        let _ = os.RemoveFile(bridgeObjectPath)
    let logPath = Fmt"{bridgeObjectPath}.compile.log"
    let compileArgs = [
        "system-link-exec",
        Fmt"--root:{plan.systemLinkPlan.packageRoot}",
        Fmt"--in:{bridgeSourcePath}",
        "--emit:obj",
        Fmt"--target:{plan.systemLinkPlan.targetTriple}",
        Fmt"--symbol-visibility:{creq.CompilerSymbolVisibilityInternal()}",
        Fmt"--out:{bridgeObjectPath}"
    ]
    if !CompilerRunFileEnvLogged(rootDir,
                                   compilerPath,
                                   compileArgs,
                                   ["CHENG_NO_BACKEND_DRIVER_HANDOFF=1"],
                                   logPath,
                                   "browser bridge object compile"):
        return false
    return chengpath.FileExistsNonEmpty(rootDir, bridgeObjectPath)

@borrows
fn CompilerMaterializeBrowserBridgeOutputs(rootDir: str,
                                             plan: sexec.SystemLinkExecPlan): bool =
    if !CompilerWriteBrowserBridgeArtifacts(rootDir, plan):
        return false
    return CompilerMaterializeBrowserBridgeObject(rootDir, plan)

@borrows
fn CompilerCurrentExecutablePath(rootDir: str): str =
    let raw = strutil.Strip(cmdline.ProgramName())
    if len(raw) <= 0:
        return ""
    let resolved = hostops.ResolveProgram(rootDir, raw)
    if len(resolved) > 0:
        return resolved
    return chengpath.PathAbsolute(rootDir, raw)

@borrows
fn CompilerBootstrapStageVariantPath(currentPathRaw: str,
                                       basePathRaw: str): bool =
    let currentPath = strutil.Strip(currentPathRaw)
    let basePath = strutil.Strip(basePathRaw)
    if len(currentPath) <= 0 || len(basePath) <= 0:
        return false
    let currentParts = os.SplitFile(currentPath)
    let baseParts = os.SplitFile(basePath)
    if currentParts.dir != baseParts.dir:
        return false
    let currentName = Fmt"{currentParts.name}{currentParts.ext}"
    let baseName = Fmt"{baseParts.name}{baseParts.ext}"
    if currentName == baseName:
        return true
    let baseVariantPrefix = Fmt"{baseName}."
    return strutil.StartsWith(currentName, baseVariantPrefix)

@borrows
fn CompilerArtifactSetFreshAgainstOutput(rootDir: str,
                                           outputPath: str,
                                           artifacts: str[]): bool =
    for i in 0..<artifacts.len:
        let artifactPath = artifacts[i]
        if !chengpath.PathFileExists(artifactPath):
            return false
        if artifactPath != outputPath &&
           CompilerPathNewerThan(rootDir, outputPath, artifactPath):
            return false
    return true

@borrows
fn CompilerBackendDriverReadyOverride(rootDir: str,
                                        backendDriverPath: str): bool =
    let readyText = strutil.Strip(os.GetEnv("CHENG_BACKEND_DRIVER_READY"))
    if len(readyText) <= 0 || readyText == "0":
        return false
    let currentPath = CompilerCurrentExecutablePath(rootDir)
    if len(currentPath) <= 0:
        return false
    if !(currentPath == backendDriverPath):
        return false
    if !(chengpath.FileExistsNonEmpty(rootDir, backendDriverPath)):
        return false
    return true

@borrows
fn CompilerEnsureBootstrapBridge(rootDir: str,
                                   context: str): bool =
    let snapshot = contracts.BootstrapSnapshotDefault(rootDir)
    if CompilerBootstrapBridgeFresh(rootDir, snapshot):
        return true
    if CompilerBootstrapBridge(rootDir) == 0:
        return true
    CompilerPrintErr(Fmt" compiler: bootstrap bridge failed inside {context}")
    return false

@borrows
fn CompilerBackendDriverFreshForCompiler(rootDir: str,
                                           backendDriverPath: str,
                                           compilerPath: str): bool =
    if !chengpath.FileExistsNonEmpty(rootDir, backendDriverPath):
        return false
    let backendDriverMapPath = Fmt"{backendDriverPath}.map"
    if !chengpath.PathFileExists(backendDriverMapPath):
        return false
    if len(compilerPath) > 0 &&
       compilerPath != backendDriverPath &&
       CompilerPathNewerThan(rootDir, compilerPath, backendDriverPath):
        return false
    let packageRoot = CompilerPackageRootForSource(rootDir,
                                                     buildplan.BackendBuildPlanBackendDriverEntryPath(rootDir))
    var freshInputs: str[]
    var freshErr = ""
    if !CompilerAppendOrdinaryClosure(packageRoot,
                                        buildplan.BackendBuildPlanBackendDriverEntryPath(rootDir),
                                        freshInputs,
                                        freshErr):
        return false
    let dynamicFreshInputs = [
        chengpath.PathAbsolute(rootDir, "src/core/runtime/compiler_runtime_program_entry_provider.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/runtime/compiler_runtime_tooling_entry_provider.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/runtime/core_runtime_provider_darwin.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/runtime/core_runtime_provider_linux.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/runtime/debug_runtime_provider.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_backend.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_get_env_bridge.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_host_runtime.cheng"),
        chengpath.PathAbsolute(rootDir, "src/core/tooling/compiler_main.cheng"),
        chengpath.PathAbsolute(rootDir, "src/std/os_host_process.cheng"),
        chengpath.PathAbsolute(rootDir, "src/std/os.cheng")
    ]
    for i in 0..<dynamicFreshInputs.len:
        CompilerPathSetAdd(freshInputs, dynamicFreshInputs[i])
    for i in 0..<freshInputs.len:
        if CompilerPathNewerThan(rootDir, freshInputs[i], backendDriverPath):
            return false
    return true

@borrows
fn CompilerBackendDriverFresh(rootDir: str,
                                backendDriverPath: str): bool =
    return CompilerBackendDriverFreshForCompiler(rootDir,
                                                   backendDriverPath,
                                                   CompilerBridgeCompilerPath(rootDir))

@borrows
fn CompilerEnsureBackendDriver(rootDir: str,
                                 context: str): bool =
    if !CompilerEnsureBootstrapBridge(rootDir, context):
        return false
    let backendDriver = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng")
    if CompilerBackendDriverReadyOverride(rootDir, backendDriver):
        return true
    if CompilerBackendDriverFresh(rootDir, backendDriver):
        return true
    if CompilerBuildBackendDriver(rootDir) == 0:
        return true
    CompilerPrintErr(Fmt" compiler: backend driver build failed inside {context}")
    return false

@borrows
fn CompilerBootstrapFreshInputsReady(rootDir: str,
                                       stage3Path: str): bool =
    var currentFreshInputs: str[]
    var currentFreshErr = ""
    if contracts.BootstrapFreshInputPaths(rootDir, currentFreshInputs, currentFreshErr):
        var cachedFreshInputs: str[]
        if !contracts.BootstrapCachedFreshInputPaths(rootDir, cachedFreshInputs):
            return false
        if !CompilerPathSetsEqual(cachedFreshInputs, currentFreshInputs):
            return false
        for i in 0..<currentFreshInputs.len:
            if CompilerPathNewerThan(rootDir, currentFreshInputs[i], stage3Path):
                return false
        return true
    let snapshotPath = contracts.BootstrapSnapshotPath(rootDir)
    if chengpath.PathFileExists(snapshotPath):
        let snapshotText = chengpath.ReadTextFile(rootDir, snapshotPath)
        let raw = strutil.Strip(contracts.BootstrapLineValue(snapshotText, "fresh_input_paths"))
        if len(raw) > 0:
            var start: int32
            let n = len(raw)
            var i = 0
            for i in i..n:
                var itemEnd = false
                if i == n:
                    itemEnd = true
                elif raw[i] == ',':
                    itemEnd = true
                if !itemEnd:
                    continue
                let item = strutil.Strip(strings.SliceBytes(raw, start, i - start))
                if len(item) > 0 && CompilerPathNewerThan(rootDir, item, stage3Path):
                    return false
                start = i + 1
            return true
    if !(!CompilerPathNewerThan(rootDir, contracts.BootstrapSeedSourcePath(rootDir), stage3Path)):
        return false
    if !(!CompilerPathNewerThan(rootDir, contracts.BootstrapStage1SourcePath(rootDir), stage3Path)):
        return false
    if !(!CompilerPathNewerThan(rootDir, contracts.BootstrapCompilerEntrySourcePath(rootDir), stage3Path)):
        return false
    if !(!CompilerPathNewerThan(rootDir, contracts.BootstrapCompilerRuntimeSourcePath(rootDir), stage3Path)):
        return false
    if !(!CompilerPathNewerThan(rootDir, contracts.BootstrapCompilerRequestSourcePath(rootDir), stage3Path)):
        return false
    if !(!CompilerPathNewerThan(rootDir, contracts.BootstrapGateMainSourcePath(rootDir), stage3Path)):
        return false
    return true

