type
    CompilerStatusTextPair =
        edges: str
        unresolved: str

fn CompilerStatusSmokeMinimal() =
    CompilerPrintLine("cheng")
    CompilerPrintLine("schema=cheng.compiler_runtime")
    CompilerPrintLine("execution=argv_control_plane")
    CompilerPrintLine("bootstrap_mode=selfhost")

@borrows
fn CompilerPrintLine(text: str) =
    os.WriteLine(os.Get_stdout(), text)

@borrows
fn CompilerPrintErr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

@borrows
fn CompilerConcat3(left: str, middle: str, right: str): str =
    return left + middle + right

@borrows
fn CompilerAppendOwnedText(out: var str,
                            suffix: str) =
    let next = Fmt"{out}{suffix}"
    out = next

@borrows
fn CompilerPathSetAdd(out: var str[],
                        pathRaw: str) =
    let path = chengpath.PathTrim(pathRaw)
    if len(path) <= 0:
        return
    for i in 0..<out.len:
        if out[i] == path:
            return
    add(out, path)

@borrows
fn CompilerPathSetHas(paths: str[],
                        pathRaw: str): bool =
    let path = chengpath.PathTrim(pathRaw)
    if len(path) <= 0:
        return false
    for i in 0..<paths.len:
        if paths[i] == path:
            return true
    return false

@borrows
fn CompilerPathSetsEqual(left: str[],
                           right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if !CompilerPathSetHas(right, left[i]):
            return false
    return true

@borrows
fn CompilerAppendOrdinaryClosure(packageRoot: str,
                                   sourcePath: str,
                                   out: var str[],
                                   err: var str): bool =
    var parsed: parser.ParsedSourceStub
    if !parser.ParseOrdinarySourceStub(packageRoot, sourcePath, parsed, err):
        return false
    for i in 0..<parsed.orderedClosureSourcePaths.len:
        CompilerPathSetAdd(out, parsed.orderedClosureSourcePaths[i])
    err = ""
    return true

@borrows
fn CompilerPrintBlock(text: str) =
    var start: int32
    var i: int32
    for i in i..text.len:
        let atEnd: bool = i == text.len
        if atEnd:
            let line: str = strings.SliceBytes(text, start, i - start)
            CompilerPrintLine(line)
            start = i + 1
        elif text[i] == '\n':
            let line: str = strings.SliceBytes(text, start, i - start)
            CompilerPrintLine(line)
            start = i + 1

fn CompilerRoot(): str =
    return strings.CloneStr(rootdisco.CompilerRootAuto())

@borrows
fn CompilerUsage(rootDir: str) =
    let lines = crun.CompilerUsageLines(rootDir)
    for i in 0..<lines.len:
        CompilerPrintLine(lines[i])

