@borrows
fn CompilerForwardStage3Command(rootDir: str,
                                  cmd: str,
                                  args: str[]): int32 =
    let stage3Path = artifactpaths.ArtifactStage3Path(rootDir)
    if !chengpath.FileExistsNonEmpty(rootDir, stage3Path):
        CompilerPrintErr(Fmt" compiler: missing stage3 compiler for command: {cmd}")
        return 2
    let currentPath = CompilerCurrentExecutablePath(rootDir)
    if len(currentPath) > 0 && currentPath == stage3Path:
        CompilerPrintErr(Fmt" compiler: command unavailable in bootstrap stage3: {cmd}")
        return 2
    return CompilerForwardToBridge(rootDir, stage3Path, cmd, args)

@borrows
fn CompilerForwardToBridgeEnv(rootDir: str,
                                bridgeCompiler: str,
                                cmd: str,
                                args: str[],
                                envOverrides: str[]): int32 =
    let logDir = chengpath.PathAbsolute(rootDir, "artifacts/forward")
    if !chengpath.PathDirExists(logDir):
        let _ = chengpath.MkdirP(rootDir, logDir)
    var logName = Fmt"forward.{cmd}.log"
    let logPath = os.JoinPath(logDir, logName)
    let cleanArgs = CompilerArgsWithoutProgress(args)
    var forwardArgs: str[]
    let forwardedCommand = share(cmd)
    add(forwardArgs, forwardedCommand)
    for i in 0..<cleanArgs.len:
        add(forwardArgs, share(cleanArgs[i]))
    var forwardEnv: str[]
    add(forwardEnv, "CHENG_NO_BACKEND_DRIVER_HANDOFF=1")
    let progressEnv = CompilerProgressEnvOverrides(rootDir, args)
    for i in 0..<progressEnv.len:
        add(forwardEnv, share(progressEnv[i]))
    if CompilerProgressRequestedFromArgs(args):
        add(forwardEnv, "CHENG_PROGRESS_APPEND=1")
    let backendDriverForwardLog = strutil.Strip(os.GetEnv("CHENG_BACKEND_DRIVER_FORWARD_LOG"))
    if len(backendDriverForwardLog) > 0:
        add(forwardEnv, Fmt"CHENG_BACKEND_DRIVER_FORWARD_LOG={backendDriverForwardLog}")
    for i in 0..<envOverrides.len:
        add(forwardEnv, strings.CloneStr(envOverrides[i]))
    let run = hostops.RunFileLogged(rootDir,
                                      Fmt"forward_{cmd}",
                                      bridgeCompiler,
                                      forwardArgs,
                                      forwardEnv,
                                      rootDir,
                                      0,
                                      logPath)
    let outputRaw = Fmt"{run.output}"
    let output = strutil.Strip(outputRaw)
    if len(output) > 0:
        if run.exitCode != 0 || cmd != "system-link-exec":
            CompilerPrintErr(output)
    elif run.exitCode != 0:
        CompilerPrintErr(Fmt" compiler: forward command failed: {cmd}")
    return run.exitCode

@borrows
fn CompilerForwardToBridge(rootDir: str,
                             bridgeCompiler: str,
                             cmd: str,
                             args: str[]): int32 =
    return CompilerForwardToBridgeEnv(rootDir, bridgeCompiler, cmd, args, [])

@borrows
fn CompilerQuoteShell(value: str): str =
    if len(value) <= 0:
        return "''"
    var out = "'"
    for i in 0..<len(value):
        if value[i] == char(39):
            CompilerAppendOwnedText(out, "'\"'\"'")
        else:
            CompilerAppendOwnedText(out, strings.CharToStr(value[i]))
    CompilerAppendOwnedText(out, "'")
    return out

@borrows
fn CompilerFileCommand(filePath: str,
                         argv: str[]): str =
    var command = CompilerQuoteShell(filePath)
    for i in 0..<argv.len:
        CompilerAppendOwnedText(
            command, Fmt" {CompilerQuoteShell(argv[i])}")
    return command

@borrows
fn CompilerEnvLineValue(text: str, key: str): str =
    let prefix = Fmt"{key}="
    var start: int32
    var i: int32
    for i in i..text.len:
        var lineEnd = false
        if i == text.len:
            lineEnd = true
        elif text[i] == '\n':
            lineEnd = true
        if lineEnd:
            let line = strings.SliceBytes(text, start, i - start)
            if line.len >= prefix.len:
                if strings.SliceBytes(line, 0, prefix.len) == prefix:
                    return strings.SliceBytes(line, prefix.len, line.len - prefix.len)
            start = i + 1
    return ""

@borrows
fn CompilerAppendKeyValueLine(out: var str,
                                key: str,
                                value: str) =
    CompilerAppendOwnedText(out, key)
    CompilerAppendOwnedText(out, "=")
    CompilerAppendOwnedText(out, value)
    CompilerAppendOwnedText(out, "\n")

@borrows
fn CompilerAppendSectionLabel(out: var str,
                                label: str) =
    CompilerAppendOwnedText(out, "\n[")
    CompilerAppendOwnedText(out, label)
    CompilerAppendOwnedText(out, "]\n")

@borrows
fn CompilerPipePair(left: str,
                      right: str): str =
    return left + "|" + right

@borrows
fn CompilerUnavailableInBackendDriver(cmd: str): int32 =
    CompilerPrintErr(Fmt" compiler: command unavailable in backend_driver: {cmd}")
    return 2

@borrows
fn CompilerSmokeOkText(smokeName: str): str =
    return " " + smokeName + " ok"

@borrows
fn CompilerJoinCsv(values: str[]): str =
    var out = ""
    for i in 0..<values.len:
        if i > 0:
            CompilerAppendOwnedText(out, ",")
        let value = Fmt"{values[i]}"
        CompilerAppendOwnedText(out, value)
    return out

fn CompilerBoolText(value: bool): str =
    if value:
        return "true"
    return "false"

@borrows
fn CompilerJsonQuote(text: str): str =
    let quote: str = strings.CharToStr(char(34))
    return quote + text + quote

@borrows
fn CompilerR2cReactEffectiveRoot(rootDir: str): str =
    let rawRoot = strutil.Strip(cmdline.ReadFlagOrDefault("--root", strings.CloneStr(rootDir)))
    if len(rawRoot) <= 0:
        return strings.CloneStr(rootDir)
    return chengpath.PathAbsolute(rootDir, rawRoot)

@borrows
fn CompilerWriteR2cReactStatusReport(reportPath: str,
                                         rootDir: str): bool =
    let effectiveRoot = CompilerR2cReactEffectiveRoot(rootDir)
    return r2cstatus.R2cReactWriteStatusReport(reportPath, effectiveRoot)

@borrows
fn CompilerR2cReactStatus(rootDir: str): int32 =
    let effectiveRoot = CompilerR2cReactEffectiveRoot(rootDir)
    let outPathRaw = strutil.Strip(cmdline.ReadFlagOrDefault("--out", ""))
    if len(outPathRaw) > 0:
        let outPath = chengpath.PathAbsolute(effectiveRoot, outPathRaw)
        if !CompilerWriteR2cReactStatusReport(outPath, effectiveRoot):
            CompilerPrintErr(" compiler: failed to write r2c-react status report")
            return 1
        CompilerPrintLine(outPath)
        return 0
    let outPath = os.JoinPath(effectiveRoot, "artifacts/r2c_react_status_report_v1.json")
    if !CompilerWriteR2cReactStatusReport(outPath, effectiveRoot):
        CompilerPrintErr(" compiler: failed to write r2c-react status report")
        return 1
    let body = chengpath.ReadTextFile("", outPath)
    CompilerPrintLine(body)
    return 0

@borrows
fn CompilerRemoteSummaryPath(outDir: str,
                               hostLabel: str): str =
    let ownedOutDir = Fmt"{outDir}"
    return os.JoinPath(ownedOutDir, Fmt"{hostLabel}.summary.txt")

@borrows
fn CompilerRemoteLogPath(outDir: str,
                           hostLabel: str,
                           stem: str): str =
    let ownedOutDir = Fmt"{outDir}"
    return os.JoinPath(ownedOutDir, Fmt"{hostLabel}.{stem}.log")

fn CompilerRemoteOrdinarySmokeNames(): str[] =
    let singleRaw = cmdline.ReadFlagOrDefault("--smoke-name", "")
    let singleSmoke = strutil.Strip(singleRaw)
    var out: str[]
    if len(singleSmoke) > 0:
        add(out, singleSmoke)
        return out
    add(out, "ordinary_zero_exit_fixture")
    add(out, "host_process_exec_file_direct_seq_smoke")
    add(out, "host_process_exec_file_capture_smoke")
    add(out, "msquic_bindtext_expr_smoke")
    return out

@borrows
fn CompilerRemoteSmokeExpectedText(smokeName: str): str =
    if smokeName == "ordinary_zero_exit_fixture":
        return ""
    let ownedSmokeName = Fmt"{smokeName}"
    return CompilerSmokeOkText(ownedSmokeName)

@borrows
fn CompilerRemoteSmokeRequireEmptyOutput(smokeName: str): bool =
    if smokeName == "ordinary_zero_exit_fixture":
        return true
    return false

@borrows
fn CompilerRemotePlanMatches(stage3Text: str,
                               backendText: str): bool =
    let left = strutil.Strip(stage3Text)
    let right = strutil.Strip(backendText)
    if left == right:
        return true
    return false

@borrows
fn CompilerRunProgramCaptureLogged(rootDir: str,
                                     label: str,
                                     programName: str,
                                     argv: str[],
                                     logPath: str,
                                     context: str,
                                     outputOut: var str): bool =
    let run = hostops.RunProgramLogged(rootDir,
                                         label,
                                         programName,
                                         argv,
                                         [],
                                         rootDir,
                                         0,
                                         logPath)
    let ownedOutput = Fmt"{run.output}"
    outputOut = ownedOutput
    if hostops.LoggedRunOk(run):
        return true
    let output = strutil.Strip(run.output)
    if len(output) > 0:
        CompilerPrintErr(output)
    else:
        CompilerPrintErr(Fmt" compiler: {context} failed")
    return false

@borrows
fn CompilerRemoteTransportRetryable(output: str): bool =
    let trimmed = strutil.Strip(output)
    if strutil.Contains(trimmed, "Connection timed out during banner exchange"):
        return true
    if strutil.Contains(trimmed, "Connection to "):
        if strutil.Contains(trimmed, " timed out"):
            return true
    if strutil.Contains(trimmed, "No route to host"):
        return true
    if strutil.Contains(trimmed, "Connection reset by peer"):
        return true
    if strutil.Contains(trimmed, "kex_exchange_identification"):
        return true
    if strutil.Contains(trimmed, "Connection closed by remote host"):
        return true
    return false

@borrows
fn CompilerRunRemoteTransportCommand(rootDir: str,
                                       label: str,
                                       programName: str,
                                       argv: str[],
                                       logPath: str,
                                       context: str,
                                       outputOut: var str): bool =
    var lastOutput = ""
    for attempt in 0..<3:
        var attemptArgv: str[]
        for i in 0..<argv.len:
            let forwardedArg = Fmt"{argv[i]}"
            add(attemptArgv, forwardedArg)
        let attemptRootDir = Fmt"{rootDir}"
        let attemptLabel = share(label)
        let attemptProgramName = share(programName)
        let attemptLogPath = share(logPath)
        let attemptContext = share(context)
        if CompilerRunProgramCaptureLogged(attemptRootDir,
                                             attemptLabel,
                                             attemptProgramName,
                                             attemptArgv,
                                             attemptLogPath,
                                             attemptContext,
                                             lastOutput):
            outputOut = lastOutput
            return true
        if attempt >= 2 || !CompilerRemoteTransportRetryable(lastOutput):
            outputOut = lastOutput
            return false
        let retryAttempt = attempt + 1
        CompilerPrintLine(Fmt"remote transport retry {retryAttempt} {context}")
        os.SleepMs((attempt + 1) * 1000)
    outputOut = lastOutput
    return false

@borrows
fn CompilerRunRemoteCommand(rootDir: str,
                              sshTarget: str,
                              label: str,
                              remoteArgv: str[],
                              logPath: str,
                              context: str,
                              outputOut: var str): bool =
    var argv: str[]
    add(argv, "-n")
    add(argv, "-o")
    add(argv, "BatchMode=yes")
    add(argv, "-o")
    add(argv, "ConnectTimeout=8")
    add(argv, "-o")
    add(argv, "ServerAliveInterval=5")
    add(argv, "-o")
    add(argv, "ServerAliveCountMax=3")
    let ownedSshTarget = Fmt"{sshTarget}"
    add(argv, ownedSshTarget)
    for i in 0..<remoteArgv.len:
        let forwardedArg = Fmt"{remoteArgv[i]}"
        add(argv, forwardedArg)
    let ownedLogPath = Fmt"{logPath}"
    return CompilerRunRemoteTransportCommand(rootDir,
                                               label,
                                               "ssh",
                                               argv,
                                               ownedLogPath,
                                               context,
                                               outputOut)

@borrows
fn CompilerRunRemoteRsync(rootDir: str,
                            sshTarget: str,
                            label: str,
                            localSource: str,
                            remoteRoot: str,
                            logPath: str,
                            context: str,
                            outputOut: var str): bool =
    let remoteShell = "ssh -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=3"
    let rsyncDest = Fmt"{sshTarget}:{remoteRoot}/"
    let argv = [
        "-a",
        "-e", remoteShell,
        "--delete",
        "--exclude", ".git",
        "--exclude", "artifacts",
        "--exclude", "chengcache",
        "--exclude", "node_modules",
        Fmt"{localSource}",
        rsyncDest
    ]
    let ownedLogPath = Fmt"{logPath}"
    return CompilerRunRemoteTransportCommand(rootDir,
                                               label,
                                               "rsync",
                                               argv,
                                               ownedLogPath,
                                               context,
                                               outputOut)

@borrows
fn CompilerWriteRemoteSummary(rootDir: str,
                                summaryPath: str,
                                summaryText: str,
                                verified: bool): bool =
    var out = strings.CloneStr(summaryText)
    CompilerAppendKeyValueLine(out, "verified", CompilerBoolText(verified))
    return chengpath.WriteTextFile(rootDir, summaryPath, out)

@borrows
fn CompilerVerifyRemoteExeSmoke(rootDir: str,
                                  outDir: str,
                                  hostLabel: str,
                                  sshTarget: str,
                                  remoteRoot: str,
                                  smokeName: str,
                                  summaryText: var str): bool =
    let remotePackageRoot = Fmt"{remoteRoot}"
    let remoteBackend = Fmt"{remoteRoot}/artifacts/backend_driver/cheng"
    let remoteSmokeOut = Fmt"{remoteRoot}/artifacts/backend_driver/{smokeName}.selftest"
    let compileLogStem = Fmt"{smokeName}.compile"
    let runLogStem = Fmt"{smokeName}.run"
    let compileLogPath = CompilerRemoteLogPath(outDir, hostLabel, compileLogStem)
    let runLogPath = CompilerRemoteLogPath(outDir, hostLabel, runLogStem)
    let smokeCompileLogKey = Fmt"{smokeName}_compile_log"
    let smokeRunLogKey = Fmt"{smokeName}_run_log"
    let smokeOkKey = Fmt"{smokeName}_ok"
    let remoteSmokeSource = Fmt"{remotePackageRoot}/src/tests/{smokeName}.cheng"
    let remoteEnvRoot = Fmt"CHENG_ROOT={remoteRoot}"
    let compileLabel = Fmt"{hostLabel}_{smokeName}_compile"
    let runLabel = Fmt"{hostLabel}_{smokeName}_run"
    let compileContext = Fmt"remote x86 smoke compile {smokeName}"
    let runContext = Fmt"remote x86 smoke run {smokeName}"
    var compileArgv: str[]
    add(compileArgv, "env")
    add(compileArgv, remoteEnvRoot)
    add(compileArgv, remoteBackend)
    add(compileArgv, "system-link-exec")
    add(compileArgv, Fmt"--root:{remotePackageRoot}")
    let remoteContractIn = Fmt"{remoteRoot}/{contracts.BootstrapStage1SourceRelPath()}"
    add(compileArgv, Fmt"--contract-in:{remoteContractIn}")
    add(compileArgv, Fmt"--in:{remoteSmokeSource}")
    add(compileArgv, "--emit:exe")
    add(compileArgv, "--target:x86_64-unknown-linux-gnu")
    add(compileArgv, Fmt"--out:{remoteSmokeOut}")
    var compileOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   compileLabel,
                                   compileArgv,
                                   compileLogPath,
                                   compileContext,
                                   compileOut):
        CompilerAppendKeyValueLine(summaryText, smokeCompileLogKey, compileLogPath)
        CompilerAppendKeyValueLine(summaryText, smokeRunLogKey, runLogPath)
        CompilerAppendKeyValueLine(summaryText, smokeOkKey, "false")
        return false
    let runArgv = [remoteSmokeOut]
    var runOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   runLabel,
                                   runArgv,
                                   runLogPath,
                                   runContext,
                                   runOut):
        CompilerAppendKeyValueLine(summaryText, smokeCompileLogKey, compileLogPath)
        CompilerAppendKeyValueLine(summaryText, smokeRunLogKey, runLogPath)
        CompilerAppendKeyValueLine(summaryText, smokeOkKey, "false")
        return false
    let runTrimmed = strutil.Strip(runOut)
    let requireEmpty = CompilerRemoteSmokeRequireEmptyOutput(smokeName)
    let expected = CompilerRemoteSmokeExpectedText(smokeName)
    if requireEmpty:
        if len(runTrimmed) > 0:
            CompilerPrintErr(Fmt" compiler: remote x86 smoke expected empty stdout: {smokeName}")
            CompilerPrintErr(runTrimmed)
            CompilerAppendKeyValueLine(summaryText, smokeCompileLogKey, compileLogPath)
            CompilerAppendKeyValueLine(summaryText, smokeRunLogKey, runLogPath)
            CompilerAppendKeyValueLine(summaryText, smokeOkKey, "false")
            return false
    elif !strutil.Contains(runTrimmed, expected):
        CompilerPrintErr(Fmt" compiler: remote x86 smoke output drifted: {smokeName}")
        CompilerPrintErr(runTrimmed)
        CompilerAppendKeyValueLine(summaryText, smokeCompileLogKey, compileLogPath)
        CompilerAppendKeyValueLine(summaryText, smokeRunLogKey, runLogPath)
        CompilerAppendKeyValueLine(summaryText, smokeOkKey, "false")
        return false
    CompilerAppendKeyValueLine(summaryText, smokeCompileLogKey, compileLogPath)
    CompilerAppendKeyValueLine(summaryText, smokeRunLogKey, runLogPath)
    CompilerAppendKeyValueLine(summaryText, smokeOkKey, "true")
    return true

@borrows
fn CompilerVerifyRemoteChainNodeSelfTest(rootDir: str,
                                           outDir: str,
                                           hostLabel: str,
                                           sshTarget: str,
                                           remoteRoot: str,
                                           summaryText: var str): bool =
    let remotePackageRoot = Fmt"{remoteRoot}"
    let remoteBackend = Fmt"{remoteRoot}/artifacts/backend_driver/cheng"
    let remoteOut = Fmt"{remoteRoot}/artifacts/backend_driver/cheng_node_main.remote_selftest"
    let compileLogPath = CompilerRemoteLogPath(outDir, hostLabel, "chain_node_self_test.compile")
    let runLogPath = CompilerRemoteLogPath(outDir, hostLabel, "chain_node_self_test.run")
    let remoteSource = Fmt"{remotePackageRoot}/src/apps/chain_node/cheng_node_main.cheng"
    let remoteEnvRoot = Fmt"CHENG_ROOT={remoteRoot}"
    let chainCompileLabel = Fmt"{hostLabel}_chain_node_compile"
    let chainRunLabel = Fmt"{hostLabel}_chain_node_run"
    var compileArgv: str[]
    add(compileArgv, "env")
    add(compileArgv, remoteEnvRoot)
    add(compileArgv, remoteBackend)
    add(compileArgv, "system-link-exec")
    add(compileArgv, Fmt"--root:{remotePackageRoot}")
    let remoteContractIn = Fmt"{remoteRoot}/{contracts.BootstrapStage1SourceRelPath()}"
    add(compileArgv, Fmt"--contract-in:{remoteContractIn}")
    add(compileArgv, Fmt"--in:{remoteSource}")
    add(compileArgv, "--emit:exe")
    add(compileArgv, "--target:x86_64-unknown-linux-gnu")
    add(compileArgv, Fmt"--out:{remoteOut}")
    var compileOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   chainCompileLabel,
                                   compileArgv,
                                   compileLogPath,
                                   "remote x86 chain_node compile",
                                   compileOut):
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_compile_log", compileLogPath)
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_run_log", runLogPath)
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_ok", "false")
        return false
    let runArgv = [remoteOut, "chain", "self", "test"]
    var runOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   chainRunLabel,
                                   runArgv,
                                   runLogPath,
                                   "remote x86 chain_node self-test",
                                   runOut):
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_compile_log", compileLogPath)
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_run_log", runLogPath)
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_ok", "false")
        return false
    let runTrimmed = strutil.Strip(runOut)
    if !strutil.Contains(runTrimmed, "cheng chain_node self-test ok"):
        CompilerPrintErr(" compiler: remote x86 chain_node self-test drifted")
        CompilerPrintErr(runTrimmed)
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_compile_log", compileLogPath)
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_run_log", runLogPath)
        CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_ok", "false")
        return false
    CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_compile_log", compileLogPath)
    CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_run_log", runLogPath)
    CompilerAppendKeyValueLine(summaryText, "chain_node_self_test_ok", "true")
    return true

@borrows
fn CompilerVerifyX86RemoteHost(rootDir: str,
                                 outDir: str,
                                 hostLabel: str,
                                 sshTarget: str,
                                 remoteRoot: str,
                                 ordinarySmokes: str[],
                                 chainNodeSelfTest: bool): bool =
    let summaryPath =
        CompilerRemoteSummaryPath(outDir, Fmt"{hostLabel}")
    let mkdirLogPath = CompilerRemoteLogPath(outDir, hostLabel, "mkdir")
    let rsyncLogPath = CompilerRemoteLogPath(outDir, hostLabel, "rsync")
    let cleanLogPath = CompilerRemoteLogPath(outDir, hostLabel, "clean")
    let stage0DirLogPath = CompilerRemoteLogPath(outDir, hostLabel, "stage0_dir")
    let stage0CcLogPath = CompilerRemoteLogPath(outDir, hostLabel, "stage0_cc")
    let bootstrapLogPath = CompilerRemoteLogPath(outDir, hostLabel, "bootstrap_bridge")
    let buildBackendLogPath = CompilerRemoteLogPath(outDir, hostLabel, "build_backend_driver")
    let stage3PlanLogPath = CompilerRemoteLogPath(outDir, hostLabel, "stage3_plan")
    let backendPlanLogPath = CompilerRemoteLogPath(outDir, hostLabel, "backend_plan")
    let smokeDirLogPath = CompilerRemoteLogPath(outDir, hostLabel, "smoke_mkdir")
    let remoteStage0 = Fmt"{remoteRoot}/artifacts/bootstrap/cheng.stage0"
    let remoteStage3 = Fmt"{remoteRoot}/artifacts/bootstrap/cheng.stage3"
    let remoteBackend = Fmt"{remoteRoot}/artifacts/backend_driver/cheng"
    var summaryText = ""
    CompilerAppendKeyValueLine(summaryText, "host", Fmt"{hostLabel}")
    CompilerAppendKeyValueLine(summaryText, "ssh_target", Fmt"{sshTarget}")
    CompilerAppendKeyValueLine(summaryText, "remote_root", Fmt"{remoteRoot}")
    CompilerAppendKeyValueLine(summaryText, "ordinary_smoke_count", IntToStr(ordinarySmokes.len))
    CompilerAppendKeyValueLine(summaryText, "ordinary_smoke_names", CompilerJoinCsv(ordinarySmokes))
    CompilerAppendKeyValueLine(summaryText, "chain_node_self_test", CompilerBoolText(chainNodeSelfTest))
    var mkdirArgv = ["mkdir", "-p", strings.CloneStr(Fmt"{remoteRoot}")]
    var mkdirOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_mkdir",
                                   mkdirArgv,
                                   mkdirLogPath,
                                   Fmt"remote x86 mkdir {hostLabel}",
                                   mkdirOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    let rsyncSource = Fmt"{rootDir}/"
    var rsyncOut = ""
    if !CompilerRunRemoteRsync(rootDir,
                                 sshTarget,
                                 Fmt"{hostLabel}_rsync",
                                 rsyncSource,
                                 remoteRoot,
                                 rsyncLogPath,
                                 Fmt"remote x86 rsync {hostLabel}",
                                 rsyncOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    let cleanArgv = [
        "rm",
        "-rf",
        strings.CloneStr(Fmt"{remoteRoot}/chengcache"),
        strings.CloneStr(Fmt"{remoteRoot}/artifacts/backend_driver"),
        strings.CloneStr(Fmt"{remoteRoot}/artifacts/bootstrap")
    ]
    var cleanOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_clean",
                                   cleanArgv,
                                   cleanLogPath,
                                   Fmt"remote x86 clean {hostLabel}",
                                   cleanOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    var stage0DirArgv = [
        "mkdir", "-p", strings.CloneStr(Fmt"{remoteRoot}/artifacts/bootstrap")]
    var stage0DirOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_stage0_dir",
                                   stage0DirArgv,
                                   stage0DirLogPath,
                                   Fmt"remote x86 stage0 dir {hostLabel}",
                                   stage0DirOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    let ccArgv = [
        "sh",
        strings.CloneStr(Fmt"{remoteRoot}/tools/legacy_x86_stage0_build.sh"),
        strings.CloneStr(remoteRoot),
        strings.CloneStr(Fmt"{remoteStage0}")
    ]
    var stage0CcOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_stage0_cc",
                                   ccArgv,
                                   stage0CcLogPath,
                                   Fmt"remote x86 stage0 cc {hostLabel}",
                                   stage0CcOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    let bootstrapArgv = [
        "env",
        strings.CloneStr(Fmt"CHENG_ROOT={remoteRoot}"),
        "CHENG_TARGET=x86_64-unknown-linux-gnu",
        strings.CloneStr(remoteStage0),
        "bootstrap-bridge"
    ]
    var bootstrapOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_bootstrap",
                                   bootstrapArgv,
                                   bootstrapLogPath,
                                   Fmt"remote x86 bootstrap-bridge {hostLabel}",
                                   bootstrapOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    let backendBuildArgv = [
        "env",
        strings.CloneStr(Fmt"CHENG_ROOT={remoteRoot}"),
        "CHENG_TARGET=x86_64-unknown-linux-gnu",
        strings.CloneStr(Fmt"{remoteStage3}"),
        "build-backend-driver",
        "--target:x86_64-unknown-linux-gnu"
    ]
    var backendBuildOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_build_backend_driver",
                                   backendBuildArgv,
                                   buildBackendLogPath,
                                   Fmt"remote x86 build-backend-driver {hostLabel}",
                                   backendBuildOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    let stage3PlanArgv = [
        "env",
        strings.CloneStr(Fmt"CHENG_ROOT={remoteRoot}"),
        strings.CloneStr(remoteStage3),
        "print-build-plan",
        "--target:x86_64-unknown-linux-gnu"
    ]
    var stage3PlanOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_stage3_plan",
                                   stage3PlanArgv,
                                   stage3PlanLogPath,
                                   Fmt"remote x86 stage3 plan {hostLabel}",
                                   stage3PlanOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    var backendPlanOut = ""
    let backendPlanArgv = [
        "env",
        strings.CloneStr(Fmt"CHENG_ROOT={remoteRoot}"),
        strings.CloneStr(remoteBackend),
        "print-build-plan",
        "--target:x86_64-unknown-linux-gnu"
    ]
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_backend_plan",
                                   backendPlanArgv,
                                   backendPlanLogPath,
                                   Fmt"remote x86 backend plan {hostLabel}",
                                   backendPlanOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    let planCoreMatch = CompilerRemotePlanMatches(stage3PlanOut, backendPlanOut)
    CompilerAppendKeyValueLine(summaryText, "stage3_plan_log", stage3PlanLogPath)
    CompilerAppendKeyValueLine(summaryText, "backend_plan_log", backendPlanLogPath)
    CompilerAppendKeyValueLine(summaryText, "plan_core_match", CompilerBoolText(planCoreMatch))
    if !planCoreMatch:
        CompilerPrintErr(Fmt" compiler: remote x86 plan drifted on {hostLabel}")
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    var smokeDirArgv = [
        "mkdir", "-p",
        strings.CloneStr(Fmt"{remoteRoot}/artifacts/backend_driver")]
    var smokeDirOut = ""
    if !CompilerRunRemoteCommand(rootDir,
                                   sshTarget,
                                   Fmt"{hostLabel}_smoke_dir",
                                   smokeDirArgv,
                                   smokeDirLogPath,
                                   Fmt"remote x86 smoke dir {hostLabel}",
                                   smokeDirOut):
        let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
        return false
    for i in 0..<ordinarySmokes.len:
        if !CompilerVerifyRemoteExeSmoke(rootDir,
                                           outDir,
                                           hostLabel,
                                           sshTarget,
                                           remoteRoot,
                                           ordinarySmokes[i],
                                           summaryText):
            let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
            return false
    if chainNodeSelfTest:
        if !CompilerVerifyRemoteChainNodeSelfTest(rootDir,
                                                    outDir,
                                                    hostLabel,
                                                    sshTarget,
                                                    remoteRoot,
                                                    summaryText):
            let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, false)
            return false
    let _ = CompilerWriteRemoteSummary(rootDir, summaryPath, summaryText, true)
    return true

@borrows
fn CompilerVerifyX86LinuxRemote(rootDir: str,
                                  args: str[]): int32 =
    args
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/x86_remote_gate")
    let reportPath = os.JoinPath(outDir, "verify_x86_linux_remote.report.txt")
    let dmitSsh = strutil.Strip(cmdline.ReadFlagOrDefault("--dmit-ssh", "dmit"))
    let dmitRoot = strutil.Strip(cmdline.ReadFlagOrDefault("--dmit-root", "/root/cheng-lang-deploy"))
    let host64Ssh = strutil.Strip(cmdline.ReadFlagOrDefault("--remote64-ssh", "root@64.176.84.12"))
    let host64Root = strutil.Strip(cmdline.ReadFlagOrDefault("--remote64-root", "/root/cheng-lang-deploy"))
    let chainNodeSelfTestText = strutil.Strip(cmdline.ReadFlagOrDefault("--chain-node-self-test", "1"))
    let chainNodeSelfTest = chainNodeSelfTestText != "0"
    let ordinarySmokes = CompilerRemoteOrdinarySmokeNames()
    if ordinarySmokes.len <= 0:
        CompilerPrintErr(" compiler: remote x86 smoke suite is empty")
        return 2
    if !CompilerRemovePathTree(strings.CloneStr(outDir)):
        CompilerPrintErr(Fmt" compiler: failed to clear remote x86 gate dir: {outDir}")
        return 2
    if !chengpath.MkdirP(rootDir, outDir):
        CompilerPrintErr(Fmt" compiler: failed to create remote x86 gate dir: {outDir}")
        return 2
    var reportText = ""
    CompilerAppendKeyValueLine(reportText, "host_count", "2")
    CompilerAppendKeyValueLine(
        reportText, "host_a", CompilerPipePair("dmit", Fmt"{dmitSsh}"))
    CompilerAppendKeyValueLine(
        reportText, "host_b", CompilerPipePair("64", Fmt"{host64Ssh}"))
    CompilerAppendKeyValueLine(reportText, "ordinary_smoke_count", IntToStr(ordinarySmokes.len))
    CompilerAppendKeyValueLine(reportText, "ordinary_smoke_names", CompilerJoinCsv(ordinarySmokes))
    CompilerAppendKeyValueLine(reportText, "chain_node_self_test", CompilerBoolText(chainNodeSelfTest))
    if !CompilerVerifyX86RemoteHost(rootDir,
                                      outDir,
                                      "dmit",
                                      dmitSsh,
                                      dmitRoot,
                                      ordinarySmokes,
                                      chainNodeSelfTest):
        let dmitSummaryPath = CompilerRemoteSummaryPath(outDir, "dmit")
        let dmitSummaryText = chengpath.ReadTextFile("", dmitSummaryPath)
        CompilerAppendSectionLabel(reportText, "dmit")
        CompilerAppendOwnedText(reportText, dmitSummaryText)
        let _ = chengpath.WriteTextFile(rootDir, reportPath, reportText)
        return 2
    let dmitSummaryPath = CompilerRemoteSummaryPath(outDir, "dmit")
    let dmitSummaryText = chengpath.ReadTextFile("", dmitSummaryPath)
    CompilerAppendSectionLabel(reportText, "dmit")
    CompilerAppendOwnedText(reportText, dmitSummaryText)
    if !CompilerVerifyX86RemoteHost(rootDir,
                                      outDir,
                                      "64",
                                      host64Ssh,
                                      host64Root,
                                      ordinarySmokes,
                                      chainNodeSelfTest):
        let host64SummaryPath = CompilerRemoteSummaryPath(outDir, "64")
        let host64SummaryText = chengpath.ReadTextFile("", host64SummaryPath)
        CompilerAppendSectionLabel(reportText, "64")
        CompilerAppendOwnedText(reportText, host64SummaryText)
        let _ = chengpath.WriteTextFile(rootDir, reportPath, reportText)
        return 2
    let host64SummaryPath = CompilerRemoteSummaryPath(outDir, "64")
    let host64SummaryText = chengpath.ReadTextFile("", host64SummaryPath)
    CompilerAppendSectionLabel(reportText, "64")
    CompilerAppendOwnedText(reportText, host64SummaryText)
    if !chengpath.WriteTextFile(rootDir, reportPath, reportText):
        CompilerPrintErr(Fmt" compiler: failed to write remote x86 report: {reportPath}")
        return 2
    CompilerPrintLine("verify-x86-linux-remote: ok")
    CompilerPrintLine(Fmt"report={reportPath}")
    return 0

@borrows
fn CompilerRuntimeAbiContractText(rootDir: str): str =
    let relPath = "src/core/tooling/backend_runtime_abi_contract.env"
    let absPath = chengpath.PathAbsolute(rootDir, relPath)
    return chengpath.ReadTextFile("", absPath)

@borrows
fn CompilerRuntimeAbiPath(rootDir: str,
                            contractText: str,
                            key: str,
                            fallbackRel: str): str =
    let relPathRaw = CompilerEnvLineValue(contractText, key)
    let relPath = strutil.Strip(relPathRaw)
    if len(relPath) > 0:
        return chengpath.PathAbsolute(rootDir, relPath)
    return chengpath.PathAbsolute(rootDir, fallbackRel)

@borrows
fn CompilerRunCommandLogged(rootDir: str,
                              command: str,
                              logPath: str,
                              context: str): bool =
    let fullCommand = command + " > " + CompilerQuoteShell(logPath) + " 2>&1"
    let rc = os.ExecShellCmdStatus(fullCommand, rootDir)
    if rc == 0:
        return true
    let output = strutil.Strip(chengpath.ReadTextFile("", logPath))
    if len(output) > 0:
        CompilerPrintErr(output)
    else:
        CompilerPrintErr(CompilerConcat3(" compiler: ", context, " failed"))
    return false

@borrows
fn CompilerRunFileEnvLogged(rootDir: str,
                              filePath: str,
                              argv: str[],
                              envOverrides: str[],
                              logPath: str,
                              context: str): bool =
    var mergedEnv = CompilerActiveRuntimeEnvOverrides(rootDir)
    for i in 0..<envOverrides.len:
        add(mergedEnv, strings.CloneStr(envOverrides[i]))
    var useSpawnStatus: bool
    for i in 0..<mergedEnv.len:
        if strutil.Strip(mergedEnv[i]) == "CHENG_HOSTOPS_SHELL_STATUS=1":
            useSpawnStatus = true
    if !useSpawnStatus:
        let shellStatusEnv = strutil.Strip(os.GetEnv("CHENG_HOSTOPS_SHELL_STATUS"))
        useSpawnStatus = len(shellStatusEnv) > 0 && shellStatusEnv != "0" && shellStatusEnv != "false"
    if useSpawnStatus:
        let _ensureLogDir = CompilerEnsureFileParentDir(rootDir, logPath)
        let exitCode = hostos.ExecFileStatusLogged(filePath,
                                                    argv,
                                                    mergedEnv,
                                                    rootDir,
                                                    0,
                                                    logPath)
        if exitCode == 0:
            return true
        let output = strutil.Strip(chengpath.ReadTextFile("", logPath))
        if len(output) > 0:
            CompilerPrintErr(output)
        else:
            let failText = CompilerConcat3(" compiler: ", context, " failed")
            CompilerPrintErr(failText)
        return false
    let run = hostops.RunFileLogged(rootDir,
                                      context,
                                      filePath,
                                      argv,
                                      mergedEnv,
                                      rootDir,
                                      0,
                                      logPath)
    if hostops.LoggedRunOk(run):
        return true
    let runOutputRaw = run.output
    let output = strutil.Strip(runOutputRaw)
    if len(output) > 0:
        CompilerPrintErr(output)
    else:
        let failText = CompilerConcat3(" compiler: ", context, " failed")
        CompilerPrintErr(failText)
    return false

@borrows
fn CompilerRunFileLogged(rootDir: str,
                           filePath: str,
                           argv: str[],
                           logPath: str,
                           context: str): bool =
    return CompilerRunFileEnvLogged(rootDir, filePath, argv, [], logPath, context)

@borrows
fn CompilerRunProgramLogged(rootDir: str,
                              programName: str,
                              argv: str[],
                              logPath: str,
                              context: str): bool =
    let run = hostops.RunProgramLogged(rootDir,
                                         context,
                                         programName,
                                         argv,
                                         CompilerActiveRuntimeEnvOverrides(rootDir),
                                         rootDir,
                                         0,
                                         logPath)
    if hostops.LoggedRunOk(run):
        return true
    let runOutputRaw = run.output
    let output = strutil.Strip(runOutputRaw)
    if len(output) > 0:
        CompilerPrintErr(output)
    else:
        let failText = CompilerConcat3(" compiler: ", context, " failed")
        CompilerPrintErr(failText)
    return false

@borrows
fn CompilerSharedEmitExtension(targetTriple: str): str =
    if tmat.TargetIsWindows(targetTriple):
        return ".dll"
    if targetTriple == "arm64-apple-darwin":
        return ".dylib"
    return ".so"

@borrows
fn CompilerSharedEmitFileHint(targetTriple: str): str =
    if tmat.TargetIsWindows(targetTriple):
        return "PE32+"
    if targetTriple == "arm64-apple-darwin":
        return "shared library"
    return "shared object"

fn CompilerSharedEmitRunDirRel(): str =
    var now: monotimes.MonoTime
    now = monotimes.GetMonoTime()
    let nowNs: int64 = monotimes.MonoTimeNs(now)
    return Fmt"artifacts/shared_emit_smokes/{nowNs}"

@borrows
fn CompilerRunSharedEmitSmokes(rootDir: str): int32 =
    let fixtureSource = chengpath.PathAbsolute(rootDir, "src/tests/shared_emit_fixture.cheng")
    let packageRoot = CompilerPackageRootForSource(rootDir, fixtureSource)
    let targetTriple = CompilerRequestedTarget()
    let extension = CompilerSharedEmitExtension(targetTriple)
    let outDirRelRaw = CompilerSharedEmitRunDirRel()
    let outDirRel = newStringCopy(strDataPtr(outDirRelRaw), strLenFast(outDirRelRaw))
    let outDir = chengpath.PathAbsolute(rootDir, outDirRel)
    let outLibRelRaw = Fmt"{outDirRel}/shared_emit_fixture{extension}"
    let outLibRel = newStringCopy(strDataPtr(outLibRelRaw), strLenFast(outLibRelRaw))
    let outLib = chengpath.PathAbsolute(rootDir, outLibRel)
    let reportRelRaw = Fmt"{outDirRel}/shared_emit_fixture.report.txt"
    let compileLogRelRaw = Fmt"{outDirRel}/shared_emit_fixture.compile.log"
    let fileLogRelRaw = Fmt"{outDirRel}/shared_emit_fixture.file.txt"
    let reportRel = newStringCopy(strDataPtr(reportRelRaw), strLenFast(reportRelRaw))
    let compileLogRel = newStringCopy(strDataPtr(compileLogRelRaw), strLenFast(compileLogRelRaw))
    let fileLogRel = newStringCopy(strDataPtr(fileLogRelRaw), strLenFast(fileLogRelRaw))
    let reportPath = chengpath.PathAbsolute(rootDir, reportRel)
    let compileLogPath = chengpath.PathAbsolute(rootDir, compileLogRel)
    let fileLogPath = chengpath.PathAbsolute(rootDir, fileLogRel)
    var currentCompiler = cmdline.ProgramName()
    if len(currentCompiler) <= 0:
        currentCompiler = CompilerBridgeCompilerPath(rootDir)
    if len(currentCompiler) <= 0:
        CompilerPrintErr(" compiler: missing current compiler for run-shared-emit-smokes")
        return 2
    if !chengpath.MkdirP(rootDir, outDir):
        CompilerPrintErr(" compiler: failed to create shared emit smoke dir")
        return 2
    if chengpath.PathFileExists(outLib):
        os.RemoveFile(strings.CloneStr(outLib))
    if chengpath.PathFileExists(reportPath):
        os.RemoveFile(strings.CloneStr(reportPath))
    let compileArgs = [
        "system-link-exec",
        Fmt"--root:{packageRoot}",
        Fmt"--in:{fixtureSource}",
        "--emit:shared",
        Fmt"--target:{targetTriple}",
        Fmt"--out:{outLib}",
        Fmt"--report-out:{reportPath}"
    ]
    if !CompilerRunFileLogged(rootDir,
                                currentCompiler,
                                compileArgs,
                                compileLogPath,
                                "run-shared-emit-smokes compile"):
        return 2
    if !chengpath.FileExistsNonEmpty(rootDir, outLib):
        CompilerPrintErr(Fmt" compiler: shared emit smoke missing output: {outLib}")
        return 2
    if !chengpath.FileExistsNonEmpty(rootDir, reportPath):
        CompilerPrintErr(Fmt" compiler: shared emit smoke missing report: {reportPath}")
        return 2
    let reportText = chengpath.ReadTextFile("", reportPath)
    if !chengpath.TextContains(reportText, "emit=shared") ||
       !chengpath.TextContains(reportText, "main_function_present=0") ||
       !chengpath.TextContains(reportText, "missing_reasons=-") ||
       !chengpath.TextContains(reportText, "native_link_missing_reasons=-"):
        CompilerPrintErr(Fmt" compiler: shared emit smoke report shape mismatch: {reportPath}")
        return 2
    if !CompilerRunProgramLogged(rootDir,
                                   "file",
                                   [share(outLib)],
                                   fileLogPath,
                                   "run-shared-emit-smokes file"):
        return 2
    let fileText = chengpath.ReadTextFile("", fileLogPath)
    let expectedHint = CompilerSharedEmitFileHint(targetTriple)
    if len(expectedHint) > 0 && !chengpath.TextContains(fileText, expectedHint):
        CompilerPrintErr(Fmt" compiler: shared emit smoke expected `{expectedHint}` in file output")
        CompilerPrintErr(strutil.Strip(fileText))
        return 2
    CompilerPrintLine(" shared emit smokes: ok")
    CompilerPrintLine(Fmt"target={targetTriple}")
    CompilerPrintLine(Fmt"out={outLib}")
    CompilerPrintLine(Fmt"report={reportPath}")
    return 0

