@borrows
fn CompilerTextContainsAll(text: str,
                             needles: str[]): bool =
    for i in 0..<needles.len:
        if !strutil.Contains(text, needles[i]):
            return false
    return true

@borrows
fn CompilerBuildPlanCoreLine(line: str): bool =
    if strutil.StartsWith(line, "target="):
        return true
    if strutil.StartsWith(line, "linker="):
        return true
    if strutil.StartsWith(line, "stage2_compiler="):
        return true
    if strutil.StartsWith(line, "entry="):
        return true
    if strutil.StartsWith(line, "output="):
        return true
    if strutil.StartsWith(line, "source["):
        return true
    return false

@borrows
fn CompilerBuildPlanCoreText(text: str): str =
    let lines = strutil.Split(text, '\n')
    var out: str[]
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        if CompilerBuildPlanCoreLine(line):
            add(out, share(line))
    return strutil.Join(out, "\n")

fn CompilerRemovePathTree(path: str): bool =
    if !chengpath.PathNonEmpty(path):
        return true
    if os.FileExists(strings.CloneStr(path)):
        return os.RemoveFile(strings.CloneStr(path))
    if !os.DirExists(path):
        return true
    let entries = os.WalkDir(strings.CloneStr(path))
    for i in 0..<entries.len:
        let child = strings.CloneStr(strings.SliceBytes(
            entries[i], 2, strings.Len(entries[i]) - 2))
        if !CompilerRemovePathTree(child):
            return false
    os.RemoveDir(strings.CloneStr(path))
    return !os.DirExists(path)

@borrows
fn CompilerCleanHostrunArtifacts(rootDir: str,
                                   smokeNames: str[]): bool =
    let hostrunDir = chengpath.PathAbsolute(rootDir, "artifacts/hostrun")
    if !os.DirExists(hostrunDir):
        return true
    let entries = os.WalkDir(hostrunDir)
    for i in 0..<entries.len:
        let child = strings.CloneStr(strings.SliceBytes(
            entries[i], 2, strings.Len(entries[i]) - 2))
        let leaf = os.ExtractFilename(strings.CloneStr(child))
        for j in 0..<smokeNames.len:
            if strutil.StartsWith(leaf, smokeNames[j]):
                if !CompilerRemovePathTree(child):
                    return false
                break
    return true

@borrows
fn CompilerRequestFromRuntimeFlags(workspaceRoot: str,
                                     requireOutput: bool): Result[creq.CompilerRequest] =
    var args =
        CompilerCollectArgsFrom(2, cmdline.ParamCount())
    return creq.CompilerRequestFromArgsForCommand(
        strings.CloneStr(workspaceRoot), args, requireOutput)

@borrows
fn CompilerRequestFromRuntimeFlagsInto(workspaceRoot: str,
                                         requireOutput: bool,
                                         outReq: var creq.CompilerRequest,
                                         outErr: var str): bool =
    let args =
        CompilerCollectArgsFrom(2, cmdline.ParamCount())
    var requestArgs = CompilerOwnedArgv(args)
    let requestRes = creq.CompilerRequestFromArgsForCommand(
        strings.CloneStr(workspaceRoot), requestArgs, requireOutput)
    if IsErr(requestRes):
        outErr = Error(requestRes)
        return false
    outReq = Value(requestRes)
    var compositionEvidence:
        composition_manifest.CompositionManifestEvidence
    var compositionReq = creq.CompilerRequestClone(outReq)
    if !composition_manifest.CompositionManifestValidateRequestInto(
           strings.CloneStr(workspaceRoot),
           args,
           compositionReq,
           compositionEvidence,
           outErr):
        return false
    if compositionEvidence.present:
        outReq = compositionReq
    outErr = ""
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=request_into_done")
    return true

@borrows
fn CompilerCanonicalSystemLinkExecPlan(
        rootDir: str,
        req: creq.CompilerRequest,
        requestedWorldHead: str,
        lockPath: str,
        baselineSurfacePath: str,
        channel: str): Result[sexec.SystemLinkExecPlan] =
    if !creq.CompilerRequestStrictValidateSealed(req):
        return Err[sexec.SystemLinkExecPlan](
            " compiler: canonical system-link-exec request is not sealed")
    return sexec.BuildSystemLinkExecPlanWithWorldAndChannel(
        rootDir,
        req,
        requestedWorldHead,
        lockPath,
        baselineSurfacePath,
        channel)

@borrows
fn CompilerBuildSystemPlanFromRuntimeFlags(rootDir: str,
                                             req: creq.CompilerRequest): Result[sexec.SystemLinkExecPlan] =
    if !creq.CompilerRequestStrictValidateSealed(req):
        return Err[sexec.SystemLinkExecPlan](
            " compiler: runtime compiler request is not sealed")
    var runtimeArgs =
        CompilerCollectArgsFrom(2, cmdline.ParamCount())
    CompilerApplyProgressEnvFromArgs(rootDir, runtimeArgs)
    let worldHead = cmdline.ReadFlagOrDefault("--world-head", "")
    let lockPath = cmdline.ReadFlagOrDefault("--lock", "")
    let baselineSurfacePath = cmdline.ReadFlagOrDefault("--baseline-surface", "")
    return CompilerCanonicalSystemLinkExecPlan(
        rootDir,
        req,
        worldHead,
        lockPath,
        baselineSurfacePath,
        cmdline.ReadFlagOrDefault("--channel", "stable"))

@borrows
fn CompilerBuildSystemPlanForEquivalenceFromRuntimeFlags(rootDir: str,
                                                           req: creq.CompilerRequest): Result[sexec.SystemLinkExecPlan] =
    if !creq.CompilerRequestStrictValidateSealed(req):
        return Err[sexec.SystemLinkExecPlan](
            " compiler: equivalence compiler request is not sealed")
    var runtimeArgs =
        CompilerCollectArgsFrom(2, cmdline.ParamCount())
    CompilerApplyProgressEnvFromArgs(rootDir, runtimeArgs)
    let worldHead = cmdline.ReadFlagOrDefault("--world-head", "")
    let lockPath = cmdline.ReadFlagOrDefault("--lock", "")
    return CompilerCanonicalSystemLinkExecPlan(
        rootDir,
        req,
        worldHead,
        lockPath,
        "",
        cmdline.ReadFlagOrDefault("--channel", "stable"))

fn CompilerCollectArgsFrom(startIndex: int32,
                             count: int32): str[] =
    var out: str[]
    if startIndex > count:
        return out
    for i in startIndex..count:
        let arg = cmdline.ParamStr(i)
        if len(arg) > 0:
            add(out, arg)
    return out


@borrows
fn CompilerBuildSystemPlan(rootDir: str,
                             req: creq.CompilerRequest,
                             args: var str[]): Result[sexec.SystemLinkExecPlan] =
    if !creq.CompilerRequestStrictValidateSealed(req):
        return Err[sexec.SystemLinkExecPlan](
            " compiler: system-link-exec request is not sealed")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_enter")
        CompilerPrintErr(Fmt"debug_system_link_exec_build_plan_args_len={args.len}")
    CompilerApplyProgressEnvFromArgs(rootDir, args)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_after_progress")
    let requestedWorldHead = CompilerRuntimeFlagOrDefault("--world-head", "")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_after_world_head")
    let lockPath = CompilerRuntimeFlagOrDefault("--lock", "")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_after_lock")
    let baselineSurfacePath = CompilerRuntimeFlagOrDefault("--baseline-surface", "")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_after_baseline")
    let channel = CompilerRuntimeFlagOrDefault("--channel", "stable")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_after_channel")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_req_root")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_req_source")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_req_output")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_req_target")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_req_emit")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_req_report")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=build_plan_req_visibility")
    return CompilerCanonicalSystemLinkExecPlan(
        rootDir,
        req,
        requestedWorldHead,
        lockPath,
        baselineSurfacePath,
        channel)

@borrows
fn CompilerRequestWithAbsoluteSourcePath(rootDir: str,
                                          req: var creq.CompilerRequest): creq.CompilerRequest =
    if !creq.CompilerRequestStrictValidateSealed(req):
        panic(" compiler: parsed compiler request is not sealed")
    let ownedReq = creq.CompilerRequestClone(req)
    let absoluteSourcePath = chengpath.PathAbsolute(
        rootDir, req.sourcePath)
    var out = creq.CompilerRequestWithSourcePath(
        ownedReq, absoluteSourcePath)
    creq.CompilerRequestSeal(out)
    return out

@borrows
fn CompilerRunSystemLinkExec(rootDir: str,
                               req: var creq.CompilerRequest,
                               args: var str[]): int32 =
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=enter_run")
        CompilerPrintErr(Fmt"debug_system_link_exec_args_len={args.len}")
        CompilerPrintErr(Fmt"debug_system_link_exec_req_source={req.sourcePath}")
        CompilerPrintErr(Fmt"debug_system_link_exec_req_output={req.outputPath}")
        CompilerPrintErr(Fmt"debug_system_link_exec_req_report={req.reportPath}")
    req = CompilerRequestWithAbsoluteSourcePath(rootDir, req)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr(Fmt"debug_system_link_exec_req_abs_source={req.sourcePath}")
    # Seven-stage receipt (S2): validate flag wiring once at the entry; the
    # per-stage emission itself fires inside the shared lowering/primary/
    # backend2 pipeline points and reads the same global cmdline.
    let sevenStageConfigErr = ssr.SevenStageReceiptValidateConfig(
        rootDir, req.targetTriple, req.jobCount)
    if len(sevenStageConfigErr) > 0:
        CompilerPrintErr(sevenStageConfigErr)
        return 2
    let planRes: Result[sexec.SystemLinkExecPlan] = CompilerBuildSystemPlan(rootDir, req, args)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=after_build_plan")
    if IsErr(planRes):
        CompilerPrintErr(Error(planRes))
        return 2
    var plan = Value(planRes)
    var progressText = ""
    let progressPath = CompilerProgressPath()
    if len(progressPath) > 0 && !CompilerProgressAppendEnabled():
        let _ = chengpath.WriteTextFile(rootDir, progressPath, "")
        os.SetEnv("CHENG_PROGRESS_APPEND", "1")
    var privateImportDiagnostics: str[]
    if plan.systemLinkPlan.unresolvedImportCount > 0:
        privateImportDiagnostics = CompilerSystemLinkExecPrivateImportDiagnostics(plan)
    if privateImportDiagnostics.len > 0:
        if !CompilerWriteSystemLinkExecFullReport(rootDir, req.reportPath, plan):
            CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
            return 2
        for i in 0..<privateImportDiagnostics.len:
            CompilerPrintErr(privateImportDiagnostics[i])
        return 2
    CompilerProgressEmit(rootDir, progressText, "execute", "begin")
    CompilerProgressEmit(rootDir, progressText, "browser_bridge_prepare", "begin")
    if !CompilerMaterializeBrowserBridgeOutputs(rootDir, plan):
        if !CompilerWriteSystemLinkExecFullReport(rootDir, req.reportPath, plan):
            CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
            return 2
        CompilerPrintErr(" compiler: failed to materialize browser bridge outputs")
        return 2
    CompilerProgressEmit(rootDir, progressText, "browser_bridge_prepare", "done")
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr("debug_system_link_exec=run_before_pure")
    let pureRc = CompilerTryRunPureSystemLinkExec(rootDir, req, plan)
    if CompilerSystemLinkExecEnvDebugEnabled():
        CompilerPrintErr(Fmt"debug_system_link_exec=run_after_pure rc={pureRc}")
    if pureRc == 0:
        CompilerProgressEmit(rootDir, progressText, "execute", "done")
        return 0
    if pureRc >= 0:
        CompilerProgressEmit(rootDir, progressText, "execute", "done")
        return pureRc
    CompilerProgressEmit(rootDir, progressText, "execute", "done")
    let summary = CompilerSystemLinkExecSummary(plan)
    if sexec.SystemLinkExecPlanReady(plan):
        if !CompilerWriteSystemLinkExecFullReport(rootDir, req.reportPath, plan):
            CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
            return 2
        CompilerPrintErr(
            " compiler: canonical system-link-exec runtime execution failed")
        CompilerPrintErr(summary)
        return 2
    for i in 0..<privateImportDiagnostics.len:
        CompilerPrintErr(privateImportDiagnostics[i])
    if !CompilerWritePureSystemLinkExecErrorReport(rootDir,
                                                   req.reportPath,
                                                   plan,
                                                   " compiler pure system-link-exec: plan not ready"):
        CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
        return 2
    if plan.primaryObjectPlan.missingReasons.len > 0:
        CompilerPrintErr(" compiler: primary object machine code not emitted")
    else:
        CompilerPrintErr(" compiler: ordinary pipeline blocked")
    CompilerPrintErr(summary)
    return 2

@borrows
fn CompilerPackageRootFromArgs(rootDir: str,
                                 args: var str[]): str =
    let legacySourcePath =
        CompilerReadFlagFromArgs(args, "--legacy-in", "")
    let sourcePath =
        CompilerReadFlagFromArgs(args, "--in", legacySourcePath)
    let defaultPackageRoot = creq.CompilerDefaultPackageRoot(rootDir)
    let packageRootRaw =
        CompilerReadFlagFromArgs(args, "--root", defaultPackageRoot)
    return creq.CompilerResolvePackageRoot(rootDir, sourcePath, packageRootRaw)

@borrows
fn CompilerPackageRootFromRuntimeFlags(rootDir: str): str =
    let sourcePath = cmdline.ReadFlagOrDefault("--in", cmdline.ReadFlagOrDefault("--legacy-in", ""))
    let packageRootRaw = cmdline.ReadFlagOrDefault("--root", creq.CompilerDefaultPackageRoot(rootDir))
    return creq.CompilerResolvePackageRoot(rootDir, sourcePath, packageRootRaw)

@borrows
fn CompilerBackendDriverSelftestArtifactPaths(rootDir: str,
                                                stem: str,
                                                outBin: var str,
                                                outReportPath: var str,
                                                outCompileLogPath: var str,
                                                outRunLogPath: var str,
                                                outReceiptLogPath: var str) =
    var outBinRel = Fmt"artifacts/backend_driver/{stem}.selftest"
    outBin = chengpath.PathAbsolute(rootDir, outBinRel)
    outReportPath = Fmt"{outBin}.report.txt"
    var outCompileLogRel = Fmt"artifacts/backend_driver/{stem}.selftest.compile.log"
    var outRunLogRel = Fmt"artifacts/backend_driver/{stem}.selftest.run.log"
    var outReceiptLogRel = Fmt"artifacts/backend_driver/{stem}.selftest.receipt.log"
    outCompileLogPath = chengpath.PathAbsolute(rootDir, outCompileLogRel)
    outRunLogPath = chengpath.PathAbsolute(rootDir, outRunLogRel)
    outReceiptLogPath = chengpath.PathAbsolute(rootDir, outReceiptLogRel)

@borrows
fn CompilerBackendDriverSelftestBuildStampPath(outBin: str): str =
    return Fmt"{outBin}.build.txt"

@borrows
fn CompilerBackendDriverSelftestBuildStampText(sourcePath: str,
                                                 outBin: str,
                                                 outReportPath: str,
                                                 targetTriple: str,
                                                 compilerPath: str,
                                                 expectedOutput: str): str =
    var out = "format=cheng_backend_driver_selftest_build\n"
    CompilerAppendOwnedText(out, Fmt"entry={sourcePath}\n")
    CompilerAppendOwnedText(out, Fmt"output={outBin}\n")
    CompilerAppendOwnedText(out, Fmt"report={outReportPath}\n")
    CompilerAppendOwnedText(out, Fmt"target={targetTriple}\n")
    CompilerAppendOwnedText(out, Fmt"compiler={compilerPath}\n")
    CompilerAppendOwnedText(out, Fmt"expected_output={expectedOutput}\n")
    return out

@borrows
fn CompilerBackendDriverSelftestFresh(rootDir: str,
                                        packageRoot: str,
                                        compilerPath: str,
                                        targetTriple: str,
                                        sourcePath: str,
                                        expectedOutput: str,
                                        outBin: str,
                                        outReportPath: str,
                                        outCompileLogPath: str,
                                        outRunLogPath: str): bool =
    var freshInputPaths: str[]
    var freshErr = ""
    if !contracts.BootstrapOrdinaryClosurePaths(Fmt"{packageRoot}",
                                                  sourcePath,
                                                  freshInputPaths,
                                                  freshErr):
        return false
    if !CompilerArtifactSetFreshAgainstOutput(rootDir,
                                                outBin,
                                                [
                                                    share(outBin),
                                                    Fmt"{outBin}.map",
                                                    share(outReportPath),
                                                    share(outCompileLogPath),
                                                    share(outRunLogPath)
                                                ]):
        return false
    if len(compilerPath) > 0 &&
       compilerPath != outBin &&
       CompilerPathNewerThan(rootDir, compilerPath, outBin):
        return false
    for i in 0..<freshInputPaths.len:
        if CompilerPathNewerThan(rootDir, freshInputPaths[i], outBin):
            return false
    let runText = strutil.Strip(chengpath.ReadTextFile("", outRunLogPath))
    if len(expectedOutput) <= 0:
        if len(runText) <= 0:
            return true
        return false
    if runText == expectedOutput:
        return true
    return false

@borrows
fn CompilerRunBackendDriverSelftest(rootDir: str,
                                      packageRoot: str,
                                      compilerPath: str,
                                      targetTriple: str,
                                      sourcePath: str,
                                      stem: str,
                                      expectedOutput: str,
                                      outBin: var str,
                                      outReportPath: var str,
                                      outCompileLogPath: var str,
                                      outRunLogPath: var str): bool =
    var outReceiptLogPath = ""
    CompilerBackendDriverSelftestArtifactPaths(rootDir,
                                                 stem,
                                                 outBin,
                                                 outReportPath,
                                                 outCompileLogPath,
                                                 outRunLogPath,
                                                 outReceiptLogPath)
    let outBinPath = strings.CloneStr(outBin)
    let outReport = strings.CloneStr(outReportPath)
    let outCompileLog = strings.CloneStr(outCompileLogPath)
    let outRunLog = strings.CloneStr(outRunLogPath)
    let outReceiptLog = strings.CloneStr(outReceiptLogPath)
    let buildStampPath = CompilerBackendDriverSelftestBuildStampPath(outBinPath)
    let compileContext = CompilerConcat3("build-backend-driver ", stem, " compile")
    let receiptContext = CompilerConcat3("build-backend-driver ", stem, " receipt")
    let runContext = CompilerConcat3("build-backend-driver ", stem, " run")
    let seedDiagText = CompilerConcat3(" compiler: backend driver ", stem, " selftest emitted internal seed diagnostics")
    let emptyStdoutText = CompilerConcat3(" compiler: backend driver ", stem, " selftest expected empty stdout")
    let driftText = CompilerConcat3(" compiler: backend driver ", stem, " selftest output drifted")
    let missingOutputPrefix = CompilerConcat3(" compiler: backend driver ", stem, " selftest missing output: ")
    let missingOutputText = Fmt"{missingOutputPrefix}{outBinPath}"
    var compileArgs: str[]
    add(compileArgs, "system-link-exec")
    add(compileArgs, Fmt"--root:{packageRoot}")
    add(compileArgs, Fmt"--contract-in:{contracts.BootstrapStage1SourcePath(rootDir)}")
    add(compileArgs, Fmt"--in:{sourcePath}")
    add(compileArgs, "--emit:exe")
    add(compileArgs, Fmt"--target:{targetTriple}")
    add(compileArgs, Fmt"--out:{outBinPath}")
    var compileEnv: str[]
    add(compileEnv, "CHENG_NO_BACKEND_DRIVER_HANDOFF=1")
    add(compileEnv, "CHENG_HOSTOPS_SHELL_STATUS=1")
    if strutil.StartsWith(stem, "r2c_react_"):
        add(compileEnv, "BACKEND_INCREMENTAL=0")
        add(compileEnv, "BACKEND_MULTI_MODULE_CACHE=0")
        add(compileEnv, "CHENG_DISABLE_PRIMARY_OBJECT_CACHE=1")
        add(compileEnv, "BACKEND_BUILD_DRIVER_QUICK_STAMP_CACHE=0")
        add(compileEnv, "BACKEND_BUILD_DRIVER_QUICK_SHARED_CACHE=0")
    let fresh = CompilerBackendDriverSelftestFresh(rootDir,
                                                     packageRoot,
                                                     compilerPath,
                                                     targetTriple,
                                                     sourcePath,
                                                     expectedOutput,
                                                     outBinPath,
                                                     outReport,
                                                     outCompileLog,
                                                     outRunLog)
    if !fresh:
        if !CompilerRunFileEnvLogged(rootDir,
                                       compilerPath,
                                       compileArgs,
                                       compileEnv,
                                       outCompileLog,
                                       compileContext):
            return false
        let compileText = chengpath.ReadTextFile("", outCompileLog)
        if strutil.Contains(compileText, "[cheng_seed]"):
            CompilerPrintErr(seedDiagText)
            return false
        let outBinMapPath = Fmt"{outBinPath}.map"
        if !chengpath.PathFileExists(outBinPath) || !chengpath.PathFileExists(outBinMapPath):
            CompilerPrintErr(missingOutputText)
            return false
        if chengpath.PathFileExists(outReport):
            let _ = os.RemoveFile(outReport)
        let receiptArgs = [
            "world-receipt",
            Fmt"--root:{packageRoot}",
            Fmt"--contract-in:{contracts.BootstrapStage1SourcePath(rootDir)}",
            Fmt"--in:{sourcePath}",
            "--emit:exe",
            Fmt"--target:{targetTriple}",
            Fmt"--out:{outBinPath}",
            Fmt"--report-out:{outReport}"
        ]
        if !CompilerRunFileEnvLogged(rootDir,
                                       compilerPath,
                                       receiptArgs,
                                       compileEnv,
                                       outReceiptLog,
                                       receiptContext):
            return false
        if !chengpath.PathFileExists(outReport):
            CompilerPrintErr(Fmt" compiler: backend driver selftest missing receipt report: {outReport}")
            return false
    let runArgs: str[]
    let runEnv = ["CHENG_HOSTOPS_SHELL_STATUS=1"]
    if !fresh:
        if !CompilerRunFileEnvLogged(rootDir,
                                       outBinPath,
                                       runArgs,
                                       runEnv,
                                       outRunLog,
                                       runContext):
            return false
    let runText = strutil.Strip(chengpath.ReadTextFile("", outRunLog))
    if len(expectedOutput) <= 0:
        if len(runText) > 0:
            CompilerPrintErr(emptyStdoutText)
            return false
    elif runText != expectedOutput:
        CompilerPrintErr(driftText)
        if len(runText) > 0:
            CompilerPrintErr(runText)
        return false
    let buildStampText = CompilerBackendDriverSelftestBuildStampText(sourcePath,
                                                                       outBinPath,
                                                                       outReport,
                                                                       targetTriple,
                                                                       compilerPath,
                                                                       expectedOutput)
    if !chengpath.WriteTextFile(rootDir, buildStampPath, buildStampText):
        CompilerPrintErr(Fmt" compiler: failed to write backend driver selftest build stamp: {buildStampPath}")
        return false
    return true

@borrows
fn CompilerBuildBackendDriverInstallReportText(mapRenameStatus: str,
                                                 binaryRenameStatus: str,
                                                 installedStatus: str,
                                                 verifyExportParallelStatus: str,
                                                 selfhostProgressStatus: str): str =
    var out = ""
    CompilerAppendOwnedText(out, "map_rename=" + mapRenameStatus + "\n")
    CompilerAppendOwnedText(out, "binary_rename=" + binaryRenameStatus + "\n")
    CompilerAppendOwnedText(out, "installed_status=" + installedStatus + "\n")
    CompilerAppendOwnedText(out, "installed_verify_export_parallel=" + verifyExportParallelStatus + "\n")
    CompilerAppendOwnedText(out, "installed_selfhost_progress_smoke=" + selfhostProgressStatus + "\n")
    return out

fn CompilerHostLooksWindows(): bool =
    let osName = strutil.Strip(os.GetEnv("OS"))
    let msystem = strutil.Strip(os.GetEnv("MSYSTEM"))
    let windir = strutil.Strip(os.GetEnv("WINDIR"))
    if osName == "Windows_NT":
        return true
    if len(msystem) > 0:
        return true
    if len(windir) > 0:
        return true
    return false

@borrows
fn CompilerBuildBackendDriverCanExecuteTargetOnHost(targetTriple: str): bool =
    if CompilerHostLooksWindows():
        return tmat.TargetIsWindows(targetTriple)
    return true

@borrows
fn CompilerBuildBackendDriverPlanCompiler(
        structuralCrossHostInstall: bool,
        candidateCompiler: str,
        currentCompiler: str): str =
    if structuralCrossHostInstall:
        return Fmt"{currentCompiler}"
    return Fmt"{candidateCompiler}"

fn CompilerBuildBackendDriverPlanContext(
        structuralCrossHostInstall: bool): str =
    if structuralCrossHostInstall:
        return "build-backend-driver structural plan"
    return "build-backend-driver plan"

fn CompilerBuildBackendDriverPlanStatus(
        structuralCrossHostInstall: bool): str =
    if structuralCrossHostInstall:
        return "structural_current_compiler"
    return "ok"

fn CompilerBuildBackendDriverRunnerMode(
        structuralCrossHostInstall: bool): str =
    if structuralCrossHostInstall:
        return "none_cross_host"
    return "host_exec"

fn CompilerBuildBackendDriverInstallMode(
        structuralCrossHostInstall: bool): str =
    if structuralCrossHostInstall:
        return "structural_cross_host_install"
    return "exec_verified_install"

fn CompilerBuildBackendDriverExecutionStatus(
        structuralCrossHostInstall: bool): str =
    if structuralCrossHostInstall:
        return "not_executed_cross_host"
    return "ok"

fn CompilerBuildBackendDriverReferencePlanCheck(
        structuralCrossHostInstall: bool): str =
    if structuralCrossHostInstall:
        return "structural_current_vs_reference_ok"
    return "ok"

@borrows
fn CompilerBuildBackendDriverExecutionReportText(targetTriple: str,
                                                  installMode: str,
                                                  runnerMode: str,
                                                  candidateStatus: str,
                                                  candidateVerifyExportStatus: str,
                                                  candidatePlanStatus: str,
                                                  selftestExecutionStatus: str,
                                                  installedStatus: str,
                                                  installedVerifyExportStatus: str,
                                                  installedSelfhostProgressStatus: str): str =
    var out = ""
    CompilerAppendKeyValueLine(out, "executable_target", targetTriple)
    CompilerAppendKeyValueLine(out, "executable_format", tmat.TargetPrimaryObjectFormat(targetTriple))
    CompilerAppendKeyValueLine(out, "runner", runnerMode)
    CompilerAppendKeyValueLine(out, "install_mode", installMode)
    CompilerAppendKeyValueLine(out, "candidate_status", candidateStatus)
    CompilerAppendKeyValueLine(out, "candidate_verify_export_visibility", candidateVerifyExportStatus)
    CompilerAppendKeyValueLine(out, "candidate_plan_check", candidatePlanStatus)
    CompilerAppendKeyValueLine(out, "selftest_execution", selftestExecutionStatus)
    CompilerAppendKeyValueLine(out, "installed_status", installedStatus)
    CompilerAppendKeyValueLine(out, "installed_verify_export_parallel", installedVerifyExportStatus)
    CompilerAppendKeyValueLine(out, "installed_selfhost_progress_smoke", installedSelfhostProgressStatus)
    if runnerMode == "none_cross_host":
        CompilerAppendKeyValueLine(out, "cross_host_execution_blocker", "target_not_executable_on_windows_host")
    return out

@borrows
fn CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir: str,
                                                       logPath: str,
                                                       label: str,
                                                       targetTriple: str): bool =
    var text = ""
    CompilerAppendKeyValueLine(text, "execution", "not_executed_cross_host")
    CompilerAppendKeyValueLine(text, "label", label)
    CompilerAppendKeyValueLine(text, "executable_target", targetTriple)
    CompilerAppendKeyValueLine(text, "executable_format", tmat.TargetPrimaryObjectFormat(targetTriple))
    CompilerAppendKeyValueLine(text, "runner", "none_cross_host")
    CompilerAppendKeyValueLine(text, "reason", "target_not_executable_on_windows_host")
    let logText = Fmt"{text}\n"
    return chengpath.WriteTextFile(rootDir, logPath, logText)

@borrows
fn CompilerBuildBackendDriverSmokeReport(prefix: str,
                                           sourcePath: str,
                                           outPath: str,
                                           reportPath: str,
                                           compileLogPath: str,
                                           runLogPath: str): str =
    var out = ""
    CompilerAppendOwnedText(out, prefix + "_source=" + sourcePath + "\n")
    CompilerAppendOwnedText(out, prefix + "_output=" + outPath + "\n")
    CompilerAppendOwnedText(out, prefix + "_report=" + reportPath + "\n")
    CompilerAppendOwnedText(out, prefix + "_compile_log=" + compileLogPath + "\n")
    CompilerAppendOwnedText(out, prefix + "_run_log=" + runLogPath + "\n")
    return out

@borrows
fn CompilerBuildBackendDriverStatusArgs(rootDir: str,
                                          packageRoot: str,
                                          compilerEntrySource: str): str[] =
    let statusOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/build_backend_driver.status_probe.out")
    return [
        "status",
        "--root:" + packageRoot,
        "--in:" + compilerEntrySource,
        "--out:" + statusOut
    ]

@borrows
fn CompilerBuildBackendDriverStatusLogOk(logPath: str,
                                           packageRoot: str,
                                           compilerEntrySource: str): bool =
    let statusText = chengpath.ReadTextFile("", logPath)
    if strutil.Contains(statusText, Fmt"flag_root={packageRoot}") &&
       strutil.Contains(statusText, Fmt"flag_in={compilerEntrySource}") &&
       strutil.Contains(statusText, "execution=argv_control_plane") &&
       strutil.Contains(statusText, "flag_exec_edges=") &&
       !strutil.Contains(statusText, "flag_exec_edges=err"):
        return true
    return false

@borrows
fn CompilerBuildBackendDriverInstalledPairOk(backendDriverOut: str,
                                               backendDriverMapOut: str,
                                               candidateBinarySize: int64,
                                               candidateMapSize: int64,
                                               candidateMapText: str,
                                               compilerEntrySource: str,
                                               installReport: var str): bool =
    if !chengpath.PathFileExists(backendDriverOut):
        CompilerAppendOwnedText(installReport, "installed_pair_sync=missing_binary\n")
        return false
    if !chengpath.PathFileExists(backendDriverMapOut):
        CompilerAppendOwnedText(installReport, "installed_pair_sync=missing_map\n")
        return false
    if chengpath.PathFileSize(backendDriverOut) != candidateBinarySize:
        CompilerAppendOwnedText(installReport, "installed_pair_sync=binary_size_drift\n")
        return false
    if chengpath.PathFileSize(backendDriverMapOut) != candidateMapSize:
        CompilerAppendOwnedText(installReport, "installed_pair_sync=map_size_drift\n")
        return false
    let installedMapText = chengpath.ReadTextFile("", backendDriverMapOut)
    if installedMapText != candidateMapText:
        CompilerAppendOwnedText(installReport, "installed_pair_sync=map_content_drift\n")
        return false
    if !strutil.StartsWith(installedMapText, "cheng_line_map\n") ||
       !strutil.Contains(installedMapText, compilerEntrySource):
        CompilerAppendOwnedText(installReport, "installed_pair_sync=map_source_drift\n")
        return false
    CompilerAppendOwnedText(installReport, "installed_pair_sync=ok\n")
    return true

fn CompilerBackendDriverDefaultMaxRssBytesText(): str =
    return "805306368"

fn CompilerBuildBackendDriverMaxRssBytesText(): str =
    let configured = os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES")
    if len(configured) > 0:
        return configured
    return CompilerBackendDriverDefaultMaxRssBytesText()

fn CompilerFollowWorldMaxRssBytesText(): str =
    let configured = os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES")
    if len(configured) > 0:
        return configured
    return CompilerBackendDriverDefaultMaxRssBytesText()

@borrows
fn CompilerBuildBackendDriverCompileLogText(targetTriple: str,
                                              currentCompiler: str,
                                              materializedSource: str,
                                              candidateOutput: str,
                                              candidateMap: str,
                                              compileReportPath: str): str =
    var out = ""
    CompilerAppendKeyValueLine(out, "target", targetTriple)
    CompilerAppendKeyValueLine(out, "current_compiler", currentCompiler)
    CompilerAppendKeyValueLine(out, "materialized_source", materializedSource)
    CompilerAppendKeyValueLine(out, "candidate_output", candidateOutput)
    CompilerAppendKeyValueLine(out, "candidate_map", candidateMap)
    CompilerAppendKeyValueLine(out, "compile_report", compileReportPath)
    return out

@borrows
fn CompilerBuildBackendDriverCompileReportPure(compileReportPath: str): bool =
    if !chengpath.PathFileExists(compileReportPath):
        return false
    let report = chengpath.ReadTextFile("", compileReportPath)
    if !strutil.Contains(report, "full_backend_codegen=1"):
        return false
    if strutil.Contains(report, "full_backend_codegen=0"):
        return false
    if !strutil.Contains(report, "cold_system_link_exec=0"):
        return false
    if strutil.Contains(report, "compiler_class=cold_bootstrap"):
        return false
    if !strutil.Contains(report, "system_link_exec_scope=selfhost_direct") &&
       !strutil.Contains(report, "system_link_exec_scope=selfhost_runtime_execute"):
        return false
    if strutil.Contains(report, "candidate_kind=cold_subset_backend"):
        return false
    if strutil.Contains(report, "backend_driver_candidate=cold_subset_backend"):
        return false
    if strutil.Contains(report, "system_link_exec_scope=cold_subset_direct_macho"):
        return false
    return true

@borrows
fn CompilerMinimalPureSystemLinkExecPath(rootDir: str): str =
    return chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/system_link_exec_pure")

@borrows
fn CompilerMinimalPureSystemLinkExecReportPath(rootDir: str): str =
    return chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/system_link_exec_pure.report.txt")

@borrows
fn CompilerMinimalPureSystemLinkExecReady(rootDir: str): bool =
    let compilerPath = CompilerMinimalPureSystemLinkExecPath(rootDir)
    if !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        return false
    let reportPath = CompilerMinimalPureSystemLinkExecReportPath(rootDir)
    return CompilerBuildBackendDriverCompileReportPure(reportPath)

@borrows
fn CompilerBuildBackendDriverReportText(targetTriple: str,
                                          currentCompiler: str,
                                          referenceCompiler: str,
                                          referencePlanCheck: str,
                                          plannedEntrySource: str,
                                          materializedSource: str,
                                          compilerRuntimeSource: str,
                                          compilerRequestSource: str,
                                          backendDriverCandidateOut: str,
                                          backendDriverCandidateMapOut: str,
                                          backendDriverOut: str,
                                          backendDriverMapOut: str,
                                          statusLogPath: str,
                                          verifyExportLogPath: str,
                                          verifyExportParallelLogPath: str,
                                          planLogPath: str,
                                          referencePlanLogPath: str,
                                          compileLogPath: str,
                                          installLogPath: str,
                                          installedStatusLogPath: str,
                                          installedSelfhostProgressSmokeLogPath: str,
                                          ordinarySmokeReport: str,
                                          runtimeSmokeReport: str,
                                          migrationSmokeReport: str,
                                          freshNodeSmokeReport: str,
                                          sourceTreeSha256: str,
                                          sourceManifestSha256: str,
                                          outputSha256: str,
                                          mapSha256: str,
                                          executionReport: str): str =
    var report = ""
    CompilerAppendKeyValueLine(report, "target", targetTriple)
    CompilerAppendKeyValueLine(report, "bootstrap_kind", "selfhost")
    CompilerAppendKeyValueLine(report, "compiler_class", "ordinary_compiler")
    CompilerAppendKeyValueLine(report, "backend_driver_candidate", "full_backend_codegen")
    CompilerAppendKeyValueLine(report, "full_backend_codegen", "1")
    CompilerAppendKeyValueLine(report, "system_link_exec_scope", "selfhost_direct")
    CompilerAppendKeyValueLine(report, "current_compiler", currentCompiler)
    CompilerAppendKeyValueLine(report, "reference_compiler", referenceCompiler)
    CompilerAppendKeyValueLine(report, "reference_plan_check", referencePlanCheck)
    CompilerAppendKeyValueLine(report, "planned_entry_source", plannedEntrySource)
    CompilerAppendKeyValueLine(report, "planned_runtime_source", compilerRuntimeSource)
    CompilerAppendKeyValueLine(report, "planned_request_source", compilerRequestSource)
    CompilerAppendKeyValueLine(report, "materialized_source", materializedSource)
    CompilerAppendKeyValueLine(report, "candidate_output", backendDriverCandidateOut)
    CompilerAppendKeyValueLine(report, "candidate_map", backendDriverCandidateMapOut)
    CompilerAppendKeyValueLine(report, "output", backendDriverOut)
    CompilerAppendKeyValueLine(report, "output_map", backendDriverMapOut)
    CompilerAppendKeyValueLine(report, "status_log", statusLogPath)
    CompilerAppendKeyValueLine(report, "verify_export_visibility_log", verifyExportLogPath)
    CompilerAppendKeyValueLine(report, "verify_export_visibility_parallel_log", verifyExportParallelLogPath)
    CompilerAppendKeyValueLine(report, "plan_log", planLogPath)
    CompilerAppendKeyValueLine(report, "reference_plan_log", referencePlanLogPath)
    CompilerAppendKeyValueLine(report, "log", compileLogPath)
    CompilerAppendKeyValueLine(report, "install_log", installLogPath)
    CompilerAppendKeyValueLine(report, "installed_status_log", installedStatusLogPath)
    CompilerAppendKeyValueLine(report, "installed_selfhost_progress_smoke_log", installedSelfhostProgressSmokeLogPath)
    CompilerAppendKeyValueLine(report, "source_tree_sha256", sourceTreeSha256)
    CompilerAppendKeyValueLine(report, "source_manifest_sha256", sourceManifestSha256)
    CompilerAppendKeyValueLine(report, "output_sha256", outputSha256)
    CompilerAppendKeyValueLine(report, "map_sha256", mapSha256)
    CompilerAppendOwnedText(report, ordinarySmokeReport)
    CompilerAppendOwnedText(report, runtimeSmokeReport)
    CompilerAppendOwnedText(report, migrationSmokeReport)
    CompilerAppendOwnedText(report, freshNodeSmokeReport)
    CompilerAppendOwnedText(report, executionReport)
    return report

@borrows
fn CompilerBuildBackendDriver(rootDir: str): int32 =
    CompilerPrintErr(" compiler: build-backend-driver trace start")
    let outDir = Fmt"{rootDir}/artifacts/backend_driver"
    os.MkdirAll(outDir, 493)
    CompilerPrintErr(" compiler: build-backend-driver trace mkdir")
    let requireRebuild = true
    CompilerPrintErr(" compiler: build-backend-driver trace flags")
    let buildMaxRssBytesText: str = CompilerBuildBackendDriverMaxRssBytesText()
    let sourceTreeSha256 = strutil.Strip(
        CompilerRuntimeFlagOrDefault("--profile-source-tree-sha256", ""))
    if len(sourceTreeSha256) > 0 &&
       !CompilerSha256TextValid(sourceTreeSha256):
        CompilerPrintErr(" compiler: invalid --profile-source-tree-sha256")
        return 2
    let plannedEntrySource = buildplan.BackendBuildPlanBackendDriverEntryPath(rootDir)
    let compilerEntrySource = share(plannedEntrySource)
    let packageRoot = CompilerPackageRootForSource(rootDir, compilerEntrySource)
    let compilerRuntimeSource = Fmt"{rootDir}/src/core/tooling/compiler_runtime.cheng"
    let compilerRequestSource = Fmt"{rootDir}/src/core/tooling/compiler_request.cheng"
    let backendDriverOut = Fmt"{rootDir}/artifacts/backend_driver/cheng"
    let backendDriverMapOut = Fmt"{rootDir}/artifacts/backend_driver/cheng.map"
    let backendDriverCandidateOut = Fmt"{rootDir}/artifacts/backend_driver/cheng.build_candidate"
    let backendDriverCandidateMapOut = Fmt"{rootDir}/artifacts/backend_driver/cheng.build_candidate.map"
    let backendDriverProvenanceReportPath = Fmt"{rootDir}/artifacts/backend_driver/cheng.report.txt"
    let compileReportPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.compile.report.txt"
    let compileLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.log"
    let reportPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.report.txt"
    let statusLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.status.txt"
    let verifyExportLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.verify_export_visibility.txt"
    let verifyExportParallelLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.verify_export_visibility_parallel.txt"
    let planLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.plan.txt"
    let referencePlanLogPath = Fmt"{rootDir}/artifacts/backend_driver/reference_backend_driver.plan.txt"
    let planCorePath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.plan.core.txt"
    let referencePlanCorePath = Fmt"{rootDir}/artifacts/backend_driver/reference_backend_driver.plan.core.txt"
    let installLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.install.txt"
    let installedStatusLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.installed.status.txt"
    let installedSelfhostProgressSmokeLogPath = Fmt"{rootDir}/artifacts/backend_driver/build_backend_driver.installed.selfhost_progress_smoke.txt"
    let smokeSource = Fmt"{rootDir}/src/tests/ordinary_zero_exit_fixture.cheng"
    let runtimeSmokeSource = Fmt"{rootDir}/src/tests/compiler_runtime_smoke.cheng"
    let migrationSmokeSource = Fmt"{rootDir}/src/tests/compiler_migration_publish_smoke.cheng"
    let freshNodeSmokeSource = Fmt"{rootDir}/src/tests/compiler_world_fresh_node_selfhost_smoke.cheng"
    CompilerPrintErr(" compiler: build-backend-driver trace paths")
    var smokeOut = ""
    var smokeCompileReportPath = ""
    var smokeCompileLogPath = ""
    var smokeRunLogPath = ""
    var runtimeSmokeOut = ""
    var runtimeSmokeCompileReportPath = ""
    var runtimeSmokeCompileLogPath = ""
    var runtimeSmokeRunLogPath = ""
    var migrationSmokeOut = ""
    var migrationSmokeCompileReportPath = ""
    var migrationSmokeCompileLogPath = ""
    var migrationSmokeRunLogPath = ""
    var freshNodeSmokeOut = ""
    var freshNodeSmokeCompileReportPath = ""
    var freshNodeSmokeCompileLogPath = ""
    var freshNodeSmokeRunLogPath = ""
    let targetTriple = CompilerRequestedTarget()
    var noHandoffEnv: str[] = [
        "CHENG_NO_BACKEND_DRIVER_HANDOFF=1",
        "CHENG_PROGRESS=1",
        "CHENG_PROCESS_MAX_RSS_BYTES=" + buildMaxRssBytesText,
        "BACKEND_INCREMENTAL=0",
        "BACKEND_MULTI_MODULE_CACHE=0",
        "CHENG_DISABLE_PRIMARY_OBJECT_CACHE=1",
        "CHENG_FULL_MATERIALIZE_EXE=1",
        "CHENG_HOSTOPS_SHELL_STATUS=1",
        "BACKEND_BUILD_DRIVER_QUICK_STAMP_CACHE=0",
        "BACKEND_BUILD_DRIVER_QUICK_SHARED_CACHE=0",
        # Step 4 fork-join enablement: forward BACKEND_JOBS=8 to Pass B
        # child so lowering_plan.cheng:3291 GetEnv("BACKEND_JOBS") parses
        # jobCount=8, satisfying 5-level gate at L3299-3302 (jobCount>1
        # && materializedFunctionCount>1 → enter FunctionTaskExecuteAuto
        # parallel branch). Default "8" matches cheng_cold.c L4128 fallback.
        # Real activation additionally requires dispatch_min ZC=0 (else
        # plan_not_ready early-bail bypasses lowering_primary_ir_after;
        # see memory passb_plan_not_ready_barrier).
        "BACKEND_JOBS=8"
    ]
    CompilerPrintErr(" compiler: build-backend-driver trace env")
    var currentCompiler = CompilerCurrentExecutablePath(rootDir)
    if len(currentCompiler) > 0 && !chengpath.FileExistsNonEmpty(rootDir, currentCompiler):
        currentCompiler = ""
    if len(currentCompiler) <= 0:
        currentCompiler = CompilerBridgeCompilerPath(rootDir)
    if len(currentCompiler) <= 0:
        CompilerPrintErr(" compiler: missing current compiler for build-backend-driver")
        return 2
    if CompilerMinimalPureSystemLinkExecReady(rootDir):
        currentCompiler = CompilerMinimalPureSystemLinkExecPath(rootDir)
    var ordinaryReceiptLogPath = ""
    smokeOut = Fmt"{rootDir}/artifacts/backend_driver/ordinary_zero_exit_fixture.selftest"
    smokeCompileReportPath = Fmt"{smokeOut}.report.txt"
    smokeCompileLogPath = Fmt"{rootDir}/artifacts/backend_driver/ordinary_zero_exit_fixture.selftest.compile.log"
    smokeRunLogPath = Fmt"{rootDir}/artifacts/backend_driver/ordinary_zero_exit_fixture.selftest.run.log"
    ordinaryReceiptLogPath = Fmt"{rootDir}/artifacts/backend_driver/ordinary_zero_exit_fixture.selftest.receipt.log"
    var runtimeReceiptLogPath = ""
    runtimeSmokeOut = Fmt"{rootDir}/artifacts/backend_driver/compiler_runtime_smoke.selftest"
    runtimeSmokeCompileReportPath = Fmt"{runtimeSmokeOut}.report.txt"
    runtimeSmokeCompileLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_runtime_smoke.selftest.compile.log"
    runtimeSmokeRunLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_runtime_smoke.selftest.run.log"
    runtimeReceiptLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_runtime_smoke.selftest.receipt.log"
    var migrationReceiptLogPath = ""
    migrationSmokeOut = Fmt"{rootDir}/artifacts/backend_driver/compiler_migration_publish_smoke.selftest"
    migrationSmokeCompileReportPath = Fmt"{migrationSmokeOut}.report.txt"
    migrationSmokeCompileLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_migration_publish_smoke.selftest.compile.log"
    migrationSmokeRunLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_migration_publish_smoke.selftest.run.log"
    migrationReceiptLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_migration_publish_smoke.selftest.receipt.log"
    var freshNodeReceiptLogPath = ""
    freshNodeSmokeOut = Fmt"{rootDir}/artifacts/backend_driver/compiler_world_fresh_node_selfhost_smoke.selftest"
    freshNodeSmokeCompileReportPath = Fmt"{freshNodeSmokeOut}.report.txt"
    freshNodeSmokeCompileLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_world_fresh_node_selfhost_smoke.selftest.compile.log"
    freshNodeSmokeRunLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_world_fresh_node_selfhost_smoke.selftest.run.log"
    freshNodeReceiptLogPath = Fmt"{rootDir}/artifacts/backend_driver/compiler_world_fresh_node_selfhost_smoke.selftest.receipt.log"
    CompilerPrintErr(" compiler: build-backend-driver trace selftest paths")
    let ordinarySmokeReport = CompilerBuildBackendDriverSmokeReport("zero_exit_smoke",
                                                                      smokeSource,
                                                                      smokeOut,
                                                                      smokeCompileReportPath,
                                                                      smokeCompileLogPath,
                                                                      smokeRunLogPath)
    let runtimeSmokeReport = CompilerBuildBackendDriverSmokeReport("compiler_runtime_smoke",
                                                                     runtimeSmokeSource,
                                                                     runtimeSmokeOut,
                                                                     runtimeSmokeCompileReportPath,
                                                                     runtimeSmokeCompileLogPath,
                                                                     runtimeSmokeRunLogPath)
    let migrationSmokeReport = CompilerBuildBackendDriverSmokeReport("compiler_migration_publish_smoke",
                                                                       migrationSmokeSource,
                                                                       migrationSmokeOut,
                                                                       migrationSmokeCompileReportPath,
                                                                       migrationSmokeCompileLogPath,
                                                                       migrationSmokeRunLogPath)
    let freshNodeSmokeReport = CompilerBuildBackendDriverSmokeReport("compiler_world_fresh_node_selfhost_smoke",
                                                                       freshNodeSmokeSource,
                                                                       freshNodeSmokeOut,
                                                                       freshNodeSmokeCompileReportPath,
                                                                       freshNodeSmokeCompileLogPath,
                                                                       freshNodeSmokeRunLogPath)
    CompilerPrintErr(" compiler: build-backend-driver trace smoke reports")
    CompilerPrintErr(" compiler: build-backend-driver trace compile args")
    var compileArgs: str[]
    add(compileArgs, "system-link-exec")
    add(compileArgs, Fmt"--root:{packageRoot}")
    add(compileArgs, Fmt"--in:{compilerEntrySource}")
    add(compileArgs, "--emit:exe")
    add(compileArgs, Fmt"--target:{targetTriple}")
    add(compileArgs, Fmt"--out:{backendDriverCandidateOut}")
    add(compileArgs, Fmt"--report-out:{compileReportPath}")
    CompilerPrintErr(" compiler: build-backend-driver trace compile args ready")
    CompilerPrintErr(" compiler: build-backend-driver trace run compile")
    var compileCommand = "env"
    for i in 0..<noHandoffEnv.len:
        let envArgQuoted = CompilerQuoteShell(noHandoffEnv[i])
        CompilerAppendOwnedText(compileCommand, Fmt" {envArgQuoted}")
    let currentCompilerQuoted = CompilerQuoteShell(currentCompiler)
    CompilerAppendOwnedText(compileCommand, Fmt" {currentCompilerQuoted}")
    for i in 0..<compileArgs.len:
        let compileArgQuoted = CompilerQuoteShell(compileArgs[i])
        CompilerAppendOwnedText(compileCommand, Fmt" {compileArgQuoted}")
    let compileLogPathQuoted = CompilerQuoteShell(compileLogPath)
    let compileShellCommand = Fmt"{compileCommand} > {compileLogPathQuoted} 2>&1"
    let compileExitCode = os.ExecShellCmdStatus(compileShellCommand,
                                                 rootDir)
    if compileExitCode != 0:
        CompilerPrintErr(chengpath.ReadTextFile("", compileLogPath))
        return 2
    CompilerPrintErr(" compiler: build-backend-driver trace run compile ok")
    if !chengpath.PathFileExists(compileReportPath):
        CompilerPrintErr(Fmt" compiler: missing backend driver compile report: {compileReportPath}")
        return 2
    if !chengpath.PathFileExists(backendDriverCandidateOut):
        CompilerPrintErr(Fmt" compiler: missing backend driver candidate output: {backendDriverCandidateOut}")
        return 2
    if !chengpath.PathFileExists(backendDriverCandidateMapOut):
        CompilerPrintErr(Fmt" compiler: missing backend driver candidate map: {backendDriverCandidateMapOut}")
        return 2
    if !CompilerBuildBackendDriverCompileReportPure(strings.CloneStr(compileReportPath)):
        CompilerPrintErr(Fmt" compiler: backend driver compile report is not full pure backend codegen: {compileReportPath}")
        return 2
    let compileLogText = CompilerBuildBackendDriverCompileLogText(targetTriple,
                                                                    currentCompiler,
                                                                    compilerEntrySource,
                                                                    backendDriverCandidateOut,
                                                                    backendDriverCandidateMapOut,
                                                                    compileReportPath)
    if !chengpath.WriteTextFile(rootDir, compileLogPath, compileLogText):
        CompilerPrintErr(Fmt" compiler: failed to write backend driver compile log: {compileLogPath}")
        return 2
    let structuralCrossHostInstall = !CompilerBuildBackendDriverCanExecuteTargetOnHost(targetTriple)
    let statusArgs = CompilerBuildBackendDriverStatusArgs(rootDir,
                                                            packageRoot,
                                                            compilerEntrySource)
    let candidateStatus =
        CompilerBuildBackendDriverExecutionStatus(structuralCrossHostInstall)
    let candidateVerifyExportStatus =
        CompilerBuildBackendDriverExecutionStatus(structuralCrossHostInstall)
    let runnerMode =
        CompilerBuildBackendDriverRunnerMode(structuralCrossHostInstall)
    let installMode =
        CompilerBuildBackendDriverInstallMode(structuralCrossHostInstall)
    if structuralCrossHostInstall:
        if !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                statusLogPath,
                                                                "build-backend-driver candidate status",
                                                                targetTriple):
            CompilerPrintErr(Fmt" compiler: failed to write backend driver candidate status skip log: {statusLogPath}")
            return 2
        if !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                verifyExportLogPath,
                                                                "build-backend-driver candidate verify-export-visibility",
                                                                targetTriple):
            CompilerPrintErr(Fmt" compiler: failed to write backend driver candidate verify skip log: {verifyExportLogPath}")
            return 2
    else:
        if !CompilerRunFileEnvLogged(rootDir,
                                       backendDriverCandidateOut,
                                       statusArgs,
                                       noHandoffEnv,
                                       statusLogPath,
                                       "build-backend-driver status"):
            return 2
        if !CompilerBuildBackendDriverStatusLogOk(statusLogPath, packageRoot, compilerEntrySource):
            CompilerPrintErr(" compiler: backend driver candidate status did not exercise argv provider path")
            return 2
        if !CompilerRunFileEnvLogged(rootDir,
                                       backendDriverCandidateOut,
                                       ["verify-export-visibility"],
                                       noHandoffEnv,
                                       verifyExportLogPath,
                                       "build-backend-driver verify-export-visibility"):
            return 2
    let planArgs = ["print-build-plan", Fmt"--target:{targetTriple}"]
    let candidatePlanCompiler =
        CompilerBuildBackendDriverPlanCompiler(
            structuralCrossHostInstall,
            backendDriverCandidateOut,
            currentCompiler)
    let candidatePlanContext =
        CompilerBuildBackendDriverPlanContext(
            structuralCrossHostInstall)
    let candidatePlanStatus =
        CompilerBuildBackendDriverPlanStatus(
            structuralCrossHostInstall)
    if !CompilerRunFileEnvLogged(rootDir,
                                   candidatePlanCompiler,
                                   planArgs,
                                   noHandoffEnv,
                                   planLogPath,
                                   candidatePlanContext):
        return 2
    let backendDriverReference = CompilerBackendDriverPath(rootDir)
    var referenceCompiler = ""
    if len(backendDriverReference) > 0 &&
       (CompilerBackendDriverFresh(rootDir, backendDriverReference) ||
        CompilerBackendDriverReadyOverride(rootDir, backendDriverReference)):
        referenceCompiler = backendDriverReference
    else:
        let bootstrapSnapshot = contracts.BootstrapSnapshotDefault(rootDir)
        let bootstrapReference =
            CompilerBootstrapCompilerPath(rootDir, bootstrapSnapshot)
        if len(bootstrapReference) > 0:
            referenceCompiler = bootstrapReference
    let referencePlanArgs = ["print-build-plan", Fmt"--target:{targetTriple}"]
    if len(referenceCompiler) <= 0:
        CompilerPrintErr(" compiler: missing reference compiler for build-backend-driver plan")
        return 2
    else:
        if !CompilerRunFileEnvLogged(rootDir,
                                       referenceCompiler,
                                       referencePlanArgs,
                                       noHandoffEnv,
                                       referencePlanLogPath,
                                       "build-backend-driver reference-plan"):
            return 2
        let referencePlanText = chengpath.ReadTextFile("", referencePlanLogPath)
        if !CompilerTextContainsAll(referencePlanText, [Fmt"target={targetTriple}"]):
            let fallbackSnapshot = contracts.BootstrapSnapshotDefault(rootDir)
            let fallbackReference =
                CompilerBootstrapCompilerPath(rootDir, fallbackSnapshot)
            if len(fallbackReference) > 0 &&
               fallbackReference != currentCompiler:
                referenceCompiler = fallbackReference
                if !CompilerRunFileEnvLogged(rootDir,
                                               referenceCompiler,
                                               referencePlanArgs,
                                               noHandoffEnv,
                                               referencePlanLogPath,
                                               "build-backend-driver reference-plan"):
                    return 2
        let resolvedReferencePlanText = chengpath.ReadTextFile("", referencePlanLogPath)
        if !CompilerTextContainsAll(resolvedReferencePlanText, [Fmt"target={targetTriple}"]):
            CompilerPrintErr(" compiler: reference build plan target mismatch")
            return 2
        let planCoreText = CompilerBuildPlanCoreText(chengpath.ReadTextFile("", planLogPath))
        let referencePlanCoreText = CompilerBuildPlanCoreText(chengpath.ReadTextFile("", referencePlanLogPath))
        let _planCoreWritten = chengpath.WriteTextFile(rootDir, planCorePath, planCoreText + "\n")
        let _referencePlanCoreWritten = chengpath.WriteTextFile(rootDir, referencePlanCorePath, referencePlanCoreText + "\n")
        if planCoreText != referencePlanCoreText:
            CompilerPrintErr(" compiler: backend driver build plan drift vs current compiler")
            return 2
    let referencePlanCheck =
        CompilerBuildBackendDriverReferencePlanCheck(structuralCrossHostInstall)
    let selftestExecutionStatus =
        CompilerBuildBackendDriverExecutionStatus(structuralCrossHostInstall)
    if structuralCrossHostInstall:
        if !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                smokeCompileLogPath,
                                                                "build-backend-driver ordinary selftest compile",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                smokeRunLogPath,
                                                                "build-backend-driver ordinary selftest run",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                runtimeSmokeCompileLogPath,
                                                                "build-backend-driver runtime selftest compile",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                runtimeSmokeRunLogPath,
                                                                "build-backend-driver runtime selftest run",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                migrationSmokeCompileLogPath,
                                                                "build-backend-driver migration selftest compile",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                migrationSmokeRunLogPath,
                                                                "build-backend-driver migration selftest run",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                freshNodeSmokeCompileLogPath,
                                                                "build-backend-driver fresh-node selftest compile",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                freshNodeSmokeRunLogPath,
                                                                "build-backend-driver fresh-node selftest run",
                                                                targetTriple):
            CompilerPrintErr(" compiler: failed to write backend driver structural selftest skip logs")
            return 2
    else:
        if !CompilerRunBackendDriverSelftest(rootDir,
                                               packageRoot,
                                               backendDriverCandidateOut,
                                               targetTriple,
                                               smokeSource,
                                               "ordinary_zero_exit_fixture",
                                               "",
                                               smokeOut,
                                               smokeCompileReportPath,
                                               smokeCompileLogPath,
                                               smokeRunLogPath):
            return 2
        if !CompilerRunBackendDriverSelftest(rootDir,
                                               packageRoot,
                                               backendDriverCandidateOut,
                                               targetTriple,
                                               runtimeSmokeSource,
                                               "compiler_runtime_smoke",
                                               " compiler_runtime_smoke ok",
                                               runtimeSmokeOut,
                                               runtimeSmokeCompileReportPath,
                                               runtimeSmokeCompileLogPath,
                                               runtimeSmokeRunLogPath):
            return 2
        if !CompilerRunBackendDriverSelftest(rootDir,
                                               packageRoot,
                                               backendDriverCandidateOut,
                                               targetTriple,
                                               migrationSmokeSource,
                                               "compiler_migration_publish_smoke",
                                               " compiler_migration_publish_smoke ok",
                                               migrationSmokeOut,
                                               migrationSmokeCompileReportPath,
                                               migrationSmokeCompileLogPath,
                                               migrationSmokeRunLogPath):
            return 2
        if !CompilerRunBackendDriverSelftest(rootDir,
                                               packageRoot,
                                               backendDriverCandidateOut,
                                               targetTriple,
                                               freshNodeSmokeSource,
                                               "compiler_world_fresh_node_selfhost_smoke",
                                               " compiler_world_fresh_node_selfhost_smoke ok",
                                               freshNodeSmokeOut,
                                               freshNodeSmokeCompileReportPath,
                                               freshNodeSmokeCompileLogPath,
                                               freshNodeSmokeRunLogPath):
            return 2
    let candidateBinarySize = chengpath.PathFileSize(backendDriverCandidateOut)
    let candidateMapSize = chengpath.PathFileSize(backendDriverCandidateMapOut)
    let candidateMapText = chengpath.ReadTextFile("", backendDriverCandidateMapOut)
    if candidateBinarySize <= Int64(0) ||
       candidateMapSize <= Int64(0) ||
       len(candidateMapText) <= 0 ||
       !strutil.StartsWith(candidateMapText, "cheng_line_map\n") ||
       !strutil.Contains(candidateMapText, compilerEntrySource):
        CompilerPrintErr(" compiler: backend driver candidate map is not from current candidate source")
        return 2
    var installReport = ""
    CompilerAppendOwnedText(installReport, "install_mode=" + installMode + "\n")
    CompilerAppendOwnedText(installReport, "runner=" + runnerMode + "\n")
    CompilerAppendOwnedText(installReport, "executable_target=" + targetTriple + "\n")
    CompilerAppendOwnedText(installReport, "executable_format=" + tmat.TargetPrimaryObjectFormat(targetTriple) + "\n")
    CompilerAppendOwnedText(installReport, "candidate_status=" + candidateStatus + "\n")
    CompilerAppendOwnedText(installReport, "candidate_verify_export_visibility=" + candidateVerifyExportStatus + "\n")
    CompilerAppendOwnedText(installReport, "candidate_plan_check=" + candidatePlanStatus + "\n")
    CompilerAppendOwnedText(installReport, "selftest_execution=" + selftestExecutionStatus + "\n")
    if structuralCrossHostInstall:
        CompilerAppendOwnedText(installReport, "cross_host_execution_blocker=target_not_executable_on_windows_host\n")
    if !CompilerBootstrapInstallCandidate(rootDir,
                                            backendDriverCandidateMapOut,
                                            backendDriverMapOut,
                                            installLogPath,
                                            "map",
                                            installReport):
        CompilerPrintErr(Fmt" compiler: failed to install backend driver map: {backendDriverMapOut}")
        return 2
    if !CompilerBootstrapInstallCandidate(rootDir,
                                            backendDriverCandidateOut,
                                            backendDriverOut,
                                            installLogPath,
                                            "binary",
                                            installReport):
        CompilerPrintErr(Fmt" compiler: failed to install backend driver output: {backendDriverOut}")
        return 2
    if !CompilerBuildBackendDriverInstalledPairOk(backendDriverOut,
                                                   backendDriverMapOut,
                                                   candidateBinarySize,
                                                   candidateMapSize,
                                                   candidateMapText,
                                                   compilerEntrySource,
                                                   installReport):
        chengpath.WriteTextFile(rootDir, installLogPath, installReport)
        CompilerPrintErr(" compiler: installed backend driver binary/map are not the same candidate batch")
        return 2
    let installedStatus =
        CompilerBuildBackendDriverExecutionStatus(structuralCrossHostInstall)
    let installedVerifyExportStatus =
        CompilerBuildBackendDriverExecutionStatus(structuralCrossHostInstall)
    let installedSelfhostProgressStatus =
        CompilerBuildBackendDriverExecutionStatus(structuralCrossHostInstall)
    if structuralCrossHostInstall:
        if !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                installedStatusLogPath,
                                                                "build-backend-driver installed status",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                verifyExportParallelLogPath,
                                                                "build-backend-driver installed verify-export-visibility-parallel",
                                                                targetTriple) ||
           !CompilerBuildBackendDriverWriteSkippedExecutionLog(rootDir,
                                                                installedSelfhostProgressSmokeLogPath,
                                                                "build-backend-driver installed selfhost-progress smoke",
                                                                targetTriple):
            CompilerAppendOwnedText(installReport, "installed_status=skip_log_failed\n")
            chengpath.WriteTextFile(rootDir, installLogPath, installReport)
            return 2
        CompilerAppendOwnedText(installReport, "installed_status=not_executed_cross_host\n")
        CompilerAppendOwnedText(installReport, "installed_verify_export_parallel=not_executed_cross_host\n")
        CompilerAppendOwnedText(installReport, "installed_selfhost_progress_smoke=not_executed_cross_host\n")
    else:
        if !CompilerRunFileEnvLogged(rootDir,
                                       backendDriverOut,
                                       statusArgs,
                                       noHandoffEnv,
                                       installedStatusLogPath,
                                       "build-backend-driver installed status"):
            CompilerAppendOwnedText(installReport, "installed_status=failed\n")
            chengpath.WriteTextFile(rootDir, installLogPath, installReport)
            return 2
        if !CompilerBuildBackendDriverStatusLogOk(installedStatusLogPath, packageRoot, compilerEntrySource):
            CompilerAppendOwnedText(installReport, "installed_status=argv_provider_drift\n")
            chengpath.WriteTextFile(rootDir, installLogPath, installReport)
            CompilerPrintErr(" compiler: installed backend driver status did not exercise argv provider path")
            return 2
        CompilerAppendOwnedText(installReport, "installed_status=ok\n")
        if !CompilerRunFileEnvLogged(rootDir,
                                       backendDriverOut,
                                       ["verify-export-visibility-parallel"],
                                       noHandoffEnv,
                                       verifyExportParallelLogPath,
                                       "build-backend-driver installed verify-export-visibility-parallel"):
            CompilerAppendOwnedText(installReport, "installed_verify_export_parallel=failed\n")
            chengpath.WriteTextFile(rootDir, installLogPath, installReport)
            return 2
        CompilerAppendOwnedText(installReport, "installed_verify_export_parallel=ok\n")
        if !CompilerRunFileEnvLogged(rootDir,
                                       backendDriverOut,
                                       ["run-host-smokes",
                                        "--label:build_backend_driver_installed_selfhost_progress",
                                        "backend_driver_selfhost_progress_smoke"],
                                       noHandoffEnv,
                                       installedSelfhostProgressSmokeLogPath,
                                       "build-backend-driver installed selfhost-progress smoke"):
            CompilerAppendOwnedText(installReport, "installed_selfhost_progress_smoke=failed\n")
            chengpath.WriteTextFile(rootDir, installLogPath, installReport)
            return 2
        CompilerAppendOwnedText(installReport, "installed_selfhost_progress_smoke=ok\n")
    if !chengpath.WriteTextFile(rootDir, installLogPath, installReport):
        CompilerPrintErr(Fmt" compiler: failed to write backend driver install log: {installLogPath}")
        return 2
    let compileReportText = chengpath.ReadTextFile("", compileReportPath)
    var sourceManifestSha256: str
    if !CompilerReportValueExact(
           compileReportText,
           "source_manifest_sha256",
           sourceManifestSha256) ||
       !CompilerSha256TextValid(sourceManifestSha256):
        CompilerPrintErr(" compiler: backend driver compile report source manifest identity missing")
        return 2
    let outputSha256 = CompilerFileSha256(backendDriverOut)
    if !CompilerSha256TextValid(outputSha256):
        CompilerPrintErr(" compiler: installed backend driver output identity missing")
        return 2
    let mapSha256 = CompilerFileSha256(backendDriverMapOut)
    if !CompilerSha256TextValid(mapSha256):
        CompilerPrintErr(" compiler: installed backend driver map identity missing")
        return 2
    let report = CompilerBuildBackendDriverReportText(targetTriple,
                                                        currentCompiler,
                                                        referenceCompiler,
                                                        referencePlanCheck,
                                                        plannedEntrySource,
                                                        compilerEntrySource,
                                                        compilerRuntimeSource,
                                                        compilerRequestSource,
                                                        backendDriverCandidateOut,
                                                        backendDriverCandidateMapOut,
                                                        backendDriverOut,
                                                        backendDriverMapOut,
                                                        statusLogPath,
                                                        verifyExportLogPath,
                                                        verifyExportParallelLogPath,
                                                        planLogPath,
                                                        referencePlanLogPath,
                                                        compileLogPath,
                                                        installLogPath,
                                                        installedStatusLogPath,
                                                        installedSelfhostProgressSmokeLogPath,
                                                        ordinarySmokeReport,
                                                        runtimeSmokeReport,
                                                        migrationSmokeReport,
                                                        freshNodeSmokeReport,
                                                        sourceTreeSha256,
                                                        sourceManifestSha256,
                                                        outputSha256,
                                                        mapSha256,
                                                        CompilerBuildBackendDriverExecutionReportText(targetTriple,
                                                                                                      installMode,
                                                                                                      runnerMode,
                                                                                                      candidateStatus,
                                                                                                      candidateVerifyExportStatus,
                                                                                                      candidatePlanStatus,
                                                                                                      selftestExecutionStatus,
                                                                                                      installedStatus,
                                                                                                      installedVerifyExportStatus,
                                                                                                      installedSelfhostProgressStatus))
    if !chengpath.WriteTextFile(rootDir, reportPath, report):
        CompilerPrintErr(Fmt" compiler: failed to write backend driver report: {reportPath}")
        return 2
    if !chengpath.WriteTextFile(rootDir, backendDriverProvenanceReportPath, report):
        CompilerPrintErr(Fmt" compiler: failed to write backend driver provenance report: {backendDriverProvenanceReportPath}")
        return 2
    CompilerPrintLine(Fmt"backend driver ok: {backendDriverOut}")
    return 0


@borrows
fn CompilerBootstrapTarget(rootDir: str): str =
    rootDir
    return CompilerRequestedTarget()

@borrows
fn CompilerBootstrapLog(rootDir: str,
                          name: str): str =
    return chengpath.PathAbsolute(rootDir, "artifacts/bootstrap/" + name)

@borrows
fn CompilerPathNewerThan(rootDir: str,
                           leftPath: str,
                           rightPath: str): bool =
    if !chengpath.PathFileExists(leftPath):
        return false
    if !chengpath.PathFileExists(rightPath):
        return true
    rootDir
    if os.FileMtime(leftPath) > os.FileMtime(rightPath):
        return true
    return false

@borrows
fn CompilerBootstrapEnvText(rootDir: str,
                              snapshot: contracts.BootstrapSnapshot): str =
    var out = ""
    CompilerAppendOwnedText(out, "CHENG_ROOT=" + rootDir + "\n")
    CompilerAppendOwnedText(out, "CHENG_TARGET=" + CompilerBootstrapTarget(rootDir) + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_KIND=" + snapshot.bootstrapMode + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE1_SOURCE=" + snapshot.stage1Source.path + "\n")
    CompilerAppendOwnedText(out, "CHENG_COMPILER_ENTRY_SOURCE=" + contracts.BootstrapCompilerEntrySourcePath(rootDir) + "\n")
    CompilerAppendOwnedText(out, "CHENG_COMPILER_RUNTIME_SOURCE=" + contracts.BootstrapCompilerRuntimeSourcePath(rootDir) + "\n")
    CompilerAppendOwnedText(out, "CHENG_COMPILER_REQUEST_SOURCE=" + contracts.BootstrapCompilerRequestSourcePath(rootDir) + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE0=" + snapshot.stage0Compiler.path + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE1=" + snapshot.stage1Compiler.path + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE2=" + snapshot.stage2Compiler.path + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE3=" + snapshot.stage3Compiler.path + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_ENV=" + snapshot.bootstrapEnv.path + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_SNAPSHOT=" + contracts.BootstrapSnapshotPath(rootDir) + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE1_REPORT=" + CompilerBootstrapLog(rootDir, "cheng.stage1.report.txt") + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE2_REPORT=" + CompilerBootstrapLog(rootDir, "cheng.stage2.report.txt") + "\n")
    CompilerAppendOwnedText(out, "CHENG_BOOTSTRAP_STAGE3_REPORT=" + CompilerBootstrapLog(rootDir, "cheng.stage3.report.txt") + "\n")
    return out

@borrows
fn CompilerBootstrapSnapshotText(rootDir: str,
                                   snapshot: contracts.BootstrapSnapshot): str =
    var out = ""
    var freshErr = ""
    let freshInputPaths = contracts.BootstrapFreshInputPathsCsv(rootDir, freshErr)
    CompilerAppendOwnedText(out, "target=" + CompilerBootstrapTarget(rootDir) + "\n")
    CompilerAppendOwnedText(out, "bootstrap_kind=" + snapshot.bootstrapMode + "\n")
    CompilerAppendOwnedText(out, "fresh_input_paths=" + freshInputPaths + "\n")
    CompilerAppendOwnedText(out, "stage1_source=" + snapshot.stage1Source.path + "\n")
    CompilerAppendOwnedText(out, "compiler_entry_source=" + contracts.BootstrapCompilerEntrySourcePath(rootDir) + "\n")
    CompilerAppendOwnedText(out, "compiler_runtime_source=" + contracts.BootstrapCompilerRuntimeSourcePath(rootDir) + "\n")
    CompilerAppendOwnedText(out, "compiler_request_source=" + contracts.BootstrapCompilerRequestSourcePath(rootDir) + "\n")
    CompilerAppendOwnedText(out, "stage0=" + snapshot.stage0Compiler.path + "\n")
    CompilerAppendOwnedText(out, "stage1=" + snapshot.stage1Compiler.path + "\n")
    CompilerAppendOwnedText(out, "stage2=" + snapshot.stage2Compiler.path + "\n")
    CompilerAppendOwnedText(out, "stage3=" + snapshot.stage3Compiler.path + "\n")
    CompilerAppendOwnedText(out, "stage1_report=" + CompilerBootstrapLog(rootDir, "cheng.stage1.report.txt") + "\n")
    CompilerAppendOwnedText(out, "stage2_report=" + CompilerBootstrapLog(rootDir, "cheng.stage2.report.txt") + "\n")
    CompilerAppendOwnedText(out, "stage3_report=" + CompilerBootstrapLog(rootDir, "cheng.stage3.report.txt") + "\n")
    CompilerAppendOwnedText(out, "stage0_build_log=" + CompilerBootstrapLog(rootDir, "cheng.stage0.build.log") + "\n")
    CompilerAppendOwnedText(out, "stage0_self_check_log=" + CompilerBootstrapLog(rootDir, "cheng.stage0.self-check.log") + "\n")
    CompilerAppendOwnedText(out, "stage1_build_log=" + CompilerBootstrapLog(rootDir, "cheng.stage1.compile.log") + "\n")
    CompilerAppendOwnedText(out, "stage1_self_check_log=" + CompilerBootstrapLog(rootDir, "cheng.stage1.self-check.log") + "\n")
    CompilerAppendOwnedText(out, "stage2_build_log=" + CompilerBootstrapLog(rootDir, "cheng.stage2.compile.log") + "\n")
    CompilerAppendOwnedText(out, "stage2_self_check_log=" + CompilerBootstrapLog(rootDir, "cheng.stage2.self-check.log") + "\n")
    CompilerAppendOwnedText(out, "stage3_build_log=" + CompilerBootstrapLog(rootDir, "cheng.stage3.compile.log") + "\n")
    CompilerAppendOwnedText(out, "stage3_self_check_log=" + CompilerBootstrapLog(rootDir, "cheng.stage3.self-check.log") + "\n")
    CompilerAppendOwnedText(out, "stage2_contract_log=" + CompilerBootstrapLog(rootDir, "cheng.stage2.contract.txt") + "\n")
    CompilerAppendOwnedText(out, "stage3_contract_log=" + CompilerBootstrapLog(rootDir, "cheng.stage3.contract.txt") + "\n")
    CompilerAppendOwnedText(out, "bootstrap_install_log=" + CompilerBootstrapLog(rootDir, "bootstrap_bridge.install.txt") + "\n")
    CompilerAppendOwnedText(out, "fixed_point=stage2_stage3_contract_match\n")
    return out

@borrows
fn CompilerBootstrapStageRun(rootDir: str,
                               label: str,
                               binPath: str,
                               args: str[],
                               logPath: str): bool =
    let context = Fmt"bootstrap-bridge {label}"
    return CompilerRunFileLogged(rootDir,
                                   binPath,
                                   args,
                                   logPath,
                                   context)

@borrows
fn CompilerBootstrapCompilerFresh(rootDir: str,
                                    compilerPath: str): bool =
    if !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        return false
    let compilerMtime = os.FileMtime(compilerPath)
    if compilerMtime <= int64(0):
        return false
    if !(os.FileMtime(contracts.BootstrapSeedSourcePath(rootDir)) <= compilerMtime):
        return false
    if !(os.FileMtime(contracts.BootstrapStage1SourcePath(rootDir)) <= compilerMtime):
        return false
    return true

@borrows
fn CompilerBootstrapCompilerPath(rootDir: str,
                                   snapshot: contracts.BootstrapSnapshot): str =
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage3Compiler.path) &&
       CompilerBootstrapCompilerFresh(rootDir, snapshot.stage3Compiler.path):
        return snapshot.stage3Compiler.path
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage2Compiler.path) &&
       CompilerBootstrapCompilerFresh(rootDir, snapshot.stage2Compiler.path):
        return snapshot.stage2Compiler.path
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage1Compiler.path) &&
       CompilerBootstrapCompilerFresh(rootDir, snapshot.stage1Compiler.path):
        return snapshot.stage1Compiler.path
    if chengpath.FileExistsNonEmpty(rootDir, snapshot.stage0Compiler.path) &&
       CompilerBootstrapCompilerFresh(rootDir, snapshot.stage0Compiler.path):
        return snapshot.stage0Compiler.path
    return ""

@borrows
fn CompilerBootstrapBridgeFresh(rootDir: str,
                                  snapshot: contracts.BootstrapSnapshot): bool =
    if !chengpath.FileExistsNonEmpty(rootDir, snapshot.stage2Compiler.path):
        return false
    if !chengpath.FileExistsNonEmpty(rootDir, snapshot.stage3Compiler.path):
        return false
    if !chengpath.PathFileExists(snapshot.bootstrapEnv.path):
        return false
    if !CompilerBootstrapFreshInputsReady(rootDir, snapshot.stage2Compiler.path):
        return false
    if !CompilerBootstrapFreshInputsReady(rootDir, snapshot.stage3Compiler.path):
        return false
    return true

@borrows
fn CompilerBootstrapMaterializeStage0Candidate(rootDir: str,
                                                 compilerPath: str,
                                                 finalPath: str,
                                                 candidatePath: str): bool =
    let logPath = CompilerBootstrapLog(rootDir, "cheng.stage0.materialize.log")
    let buildLogPath = CompilerBootstrapLog(rootDir, "cheng.stage0.build.log")
    let _ = os.RemoveFile(candidatePath)
    if compilerPath == finalPath:
        let copied = os.ReadFile(compilerPath)
        if len(copied) <= 0:
            return false
        if !chengpath.WriteTextFile(rootDir, candidatePath, copied):
            return false
        if !CompilerRunProgramLogged(rootDir,
                                       "chmod",
                                       ["755", share(candidatePath)],
                                       logPath,
                                       "bootstrap-bridge stage0-chmod"):
            return false
        let buildText = CompilerConcat3("stage0_candidate_copied_from=", compilerPath, "\n")
        return chengpath.WriteTextFile(rootDir,
                                      buildLogPath,
                                      buildText)
    if chengpath.PathFileExists(candidatePath):
        os.RemoveFile(candidatePath)
    if !CompilerRunProgramLogged(rootDir,
                                   "ln",
                                   ["-s", share(compilerPath), share(candidatePath)],
                                   logPath,
                                   "bootstrap-bridge stage0-symlink"):
        return false
    let buildText = CompilerConcat3("stage0_symlinked_from=", compilerPath, "\n")
    if !chengpath.WriteTextFile(rootDir,
                               buildLogPath,
                               buildText):
        return false
    return chengpath.PathFileExists(candidatePath)

@borrows
fn CompilerBootstrapInstallCandidate(rootDir: str,
                                       candidatePath: str,
                                       finalPath: str,
                                       installLogPath: str,
                                       label: str,
                                       installReport: var str): bool =
    if !chengpath.PathFileExists(candidatePath):
        CompilerAppendOwnedText(installReport, label + "_rename=missing_candidate\n")
        let ignoredWriteInstallLog = chengpath.WriteTextFile(rootDir, installLogPath, installReport)
        return false
    if !os.RenameFile(candidatePath, finalPath):
        CompilerAppendOwnedText(installReport, label + "_rename=failed\n")
        let ignoredWriteInstallLog = chengpath.WriteTextFile(rootDir, installLogPath, installReport)
        return false
    CompilerAppendOwnedText(installReport, label + "_rename=ok\n")
    return chengpath.WriteTextFile(rootDir, installLogPath, installReport)

@borrows
fn CompilerBootstrapBridge(rootDir: str): int32 =
    let snapshot = contracts.BootstrapSnapshotDefault(rootDir)
    let outDir = contracts.BootstrapOutDir(rootDir)
    if !chengpath.MkdirP(rootDir, outDir):
        CompilerPrintErr(" compiler: failed to create bootstrap dir")
        return 2
    if !chengpath.PathFileExists(snapshot.stage1Source.path):
        CompilerPrintErr(Fmt" compiler: missing stage1 source: {snapshot.stage1Source.path}")
        return 2
    if CompilerBootstrapBridgeFresh(rootDir, snapshot):
        if !chengpath.WriteTextFile(rootDir, snapshot.bootstrapEnv.path, CompilerBootstrapEnvText(rootDir, snapshot)):
            CompilerPrintErr(Fmt" compiler: failed to write bootstrap env: {snapshot.bootstrapEnv.path}")
            return 2
        if !chengpath.WriteTextFile(rootDir,
                                   contracts.BootstrapSnapshotPath(rootDir),
                                   CompilerBootstrapSnapshotText(rootDir, snapshot)):
            let freshSnapshotPath = contracts.BootstrapSnapshotPath(rootDir)
            CompilerPrintErr(Fmt" compiler: failed to write bootstrap snapshot: {freshSnapshotPath}")
            return 2
        CompilerPrintLine(Fmt"bootstrap bridge ok: {snapshot.stage2Compiler.path}")
        return 0
    let bootstrapCompiler = CompilerBootstrapCompilerPath(rootDir, snapshot)
    if len(bootstrapCompiler) <= 0:
        CompilerPrintErr(" compiler: bootstrap inputs newer than live bootstrap compiler; rebuild stage0 and rerun bootstrap-bridge")
        return 2
    if !CompilerBootstrapCompilerFresh(rootDir, bootstrapCompiler):
        CompilerPrintErr(" compiler: bootstrap inputs newer than live bootstrap compiler; rebuild stage0 and rerun bootstrap-bridge")
        return 2
    let stage0Candidate = Fmt"{snapshot.stage0Compiler.path}.next"
    let stage1Candidate = Fmt"{snapshot.stage1Compiler.path}.next"
    let stage2Candidate = Fmt"{snapshot.stage2Compiler.path}.next"
    let stage3Candidate = Fmt"{snapshot.stage3Compiler.path}.next"
    let stage1ReportPath = CompilerBootstrapLog(rootDir, "cheng.stage1.report.txt")
    let stage2ReportPath = CompilerBootstrapLog(rootDir, "cheng.stage2.report.txt")
    let stage3ReportPath = CompilerBootstrapLog(rootDir, "cheng.stage3.report.txt")
    let installLogPath = CompilerBootstrapLog(rootDir, "bootstrap_bridge.install.txt")
    if !CompilerBootstrapMaterializeStage0Candidate(rootDir,
                                                      bootstrapCompiler,
                                                      snapshot.stage0Compiler.path,
                                                      stage0Candidate):
        CompilerPrintErr(Fmt" compiler: failed to materialize stage0 candidate: {stage0Candidate}")
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage0_self_check",
                                    stage0Candidate,
                                    ["self-check", Fmt"--in:{snapshot.stage1Source.path}"],
                                    CompilerBootstrapLog(rootDir, "cheng.stage0.self-check.log")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage1_compile",
                                    stage0Candidate,
                                    [
                                        "compile-bootstrap",
                                        Fmt"--in:{snapshot.stage1Source.path}",
                                        Fmt"--out:{stage1Candidate}"
                                    ],
                                    CompilerBootstrapLog(rootDir, "cheng.stage1.compile.log")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage1_self_check",
                                    stage1Candidate,
                                    ["self-check", Fmt"--in:{snapshot.stage1Source.path}"],
                                    CompilerBootstrapLog(rootDir, "cheng.stage1.self-check.log")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage2_compile",
                                    stage1Candidate,
                                    [
                                        "compile-bootstrap",
                                        Fmt"--in:{snapshot.stage1Source.path}",
                                        Fmt"--out:{stage2Candidate}"
                                    ],
                                    CompilerBootstrapLog(rootDir, "cheng.stage2.compile.log")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage2_self_check",
                                    stage2Candidate,
                                    ["self-check", Fmt"--in:{snapshot.stage1Source.path}"],
                                    CompilerBootstrapLog(rootDir, "cheng.stage2.self-check.log")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage3_compile",
                                    stage2Candidate,
                                    [
                                        "compile-bootstrap",
                                        Fmt"--in:{snapshot.stage1Source.path}",
                                        Fmt"--out:{stage3Candidate}"
                                    ],
                                    CompilerBootstrapLog(rootDir, "cheng.stage3.compile.log")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage3_self_check",
                                    stage3Candidate,
                                    ["self-check", Fmt"--in:{snapshot.stage1Source.path}"],
                                    CompilerBootstrapLog(rootDir, "cheng.stage3.self-check.log")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage2_contract",
                                    stage2Candidate,
                                    ["print-contract", Fmt"--in:{snapshot.stage1Source.path}"],
                                    CompilerBootstrapLog(rootDir, "cheng.stage2.contract.txt")):
        return 2
    if !CompilerBootstrapStageRun(rootDir,
                                    "stage3_contract",
                                    stage3Candidate,
                                    ["print-contract", Fmt"--in:{snapshot.stage1Source.path}"],
                                    CompilerBootstrapLog(rootDir, "cheng.stage3.contract.txt")):
        return 2
    let stage2Contract = chengpath.ReadTextFile("", CompilerBootstrapLog(rootDir, "cheng.stage2.contract.txt"))
    let stage3Contract = chengpath.ReadTextFile("", CompilerBootstrapLog(rootDir, "cheng.stage3.contract.txt"))
    if stage2Contract != stage3Contract:
        CompilerPrintErr(" compiler: fixed point mismatch stage2/stage3 contract drift")
        return 2
    var installReport = ""
    if bootstrapCompiler == snapshot.stage0Compiler.path:
        if chengpath.PathFileExists(stage0Candidate) && !os.RemoveFile(stage0Candidate):
            CompilerAppendOwnedText(installReport, "stage0_reuse=cleanup_failed\n")
            let ignoredWriteInstallLog = chengpath.WriteTextFile(rootDir, installLogPath, installReport)
            CompilerPrintErr(Fmt" compiler: failed to discard bootstrap stage0 candidate: {stage0Candidate}")
            return 2
        CompilerAppendOwnedText(installReport, "stage0_reuse=ok\n")
    else:
        if !CompilerBootstrapInstallCandidate(rootDir,
                                                stage0Candidate,
                                                snapshot.stage0Compiler.path,
                                                installLogPath,
                                                "stage0",
                                                installReport):
            CompilerPrintErr(Fmt" compiler: failed to install bootstrap stage0: {snapshot.stage0Compiler.path}")
            return 2
    if !CompilerBootstrapInstallCandidate(rootDir,
                                            stage1Candidate,
                                            snapshot.stage1Compiler.path,
                                            installLogPath,
                                            "stage1",
                                            installReport):
        CompilerPrintErr(Fmt" compiler: failed to install bootstrap stage1: {snapshot.stage1Compiler.path}")
        return 2
    if !CompilerBootstrapInstallCandidate(rootDir,
                                            stage2Candidate,
                                            snapshot.stage2Compiler.path,
                                            installLogPath,
                                            "stage2",
                                            installReport):
        CompilerPrintErr(Fmt" compiler: failed to install bootstrap stage2: {snapshot.stage2Compiler.path}")
        return 2
    if !CompilerBootstrapInstallCandidate(rootDir,
                                            stage3Candidate,
                                            snapshot.stage3Compiler.path,
                                            installLogPath,
                                            "stage3",
                                            installReport):
        CompilerPrintErr(Fmt" compiler: failed to install bootstrap stage3: {snapshot.stage3Compiler.path}")
        return 2
    if !chengpath.WriteTextFile(rootDir, snapshot.bootstrapEnv.path, CompilerBootstrapEnvText(rootDir, snapshot)):
        CompilerPrintErr(Fmt" compiler: failed to write bootstrap env: {snapshot.bootstrapEnv.path}")
        return 2
    if !chengpath.WriteTextFile(rootDir,
                               contracts.BootstrapSnapshotPath(rootDir),
                               CompilerBootstrapSnapshotText(rootDir, snapshot)):
        let finalSnapshotPath = contracts.BootstrapSnapshotPath(rootDir)
        CompilerPrintErr(Fmt" compiler: failed to write bootstrap snapshot: {finalSnapshotPath}")
        return 2
    CompilerPrintLine(Fmt"bootstrap bridge ok: {snapshot.stage2Compiler.path}")
    return 0

@borrows
fn CompilerR2cReactFreshCleanGate(rootDir: str,
                                    args: str[]): int32 =
    let repoRaw = cmdline.ReadFlagOrDefault("--repo", "/Users/lbcheng/UniMaker/React.js")
    let repo = chengpath.PathAbsolute(rootDir, repoRaw)
    if !os.DirExists(repo):
        CompilerPrintErr(Fmt" compiler: missing React.js repo: {repo}")
        return 2
    let statusOut = "/tmp/r2c-status-fresh-clean-gate.json"
    let smokeNames: str[] = [
        "compiler_runtime_smoke",
        "host_process_pipe_spawn_bridge_smoke",
        "host_process_pipe_spawn_api_smoke",
        "host_process_exec_file_capture_smoke",
        "host_process_exec_file_direct_seq_smoke"
    ]
    let routeStates: str[] = ["home_default", "content_detail", "publish_selector"]
    let codegenSmokeOutDir = "/tmp/r2c-codegen-surface-fresh-clean-gate"
    let statusNeedles: str[] = r2cstatus.R2cReactExpectedStatusNeedles()
    let reportNeedles: str[] = [
        "\"ok\": true",
        "\"native_gui_host_ready\": true",
        "\"native_gui_renderer_ready\": true"
    ]
    if !CompilerRemovePathTree(strings.CloneStr(statusOut)):
        CompilerPrintErr(Fmt" compiler: failed to clear status report: {statusOut}")
        return 2
    for i in 0..<routeStates.len:
        let bundleOutDir = Fmt"/tmp/r2c-native-gui-fresh-clean-gate-{routeStates[i]}"
        if !CompilerRemovePathTree(strings.CloneStr(bundleOutDir)):
            CompilerPrintErr(Fmt" compiler: failed to clear bundle dir: {bundleOutDir}")
            return 2
    if !CompilerRemovePathTree(strings.CloneStr(codegenSmokeOutDir)):
        CompilerPrintErr(Fmt" compiler: failed to clear codegen smoke dir: {codegenSmokeOutDir}")
        return 2
    if !CompilerCleanHostrunArtifacts(rootDir, smokeNames):
        CompilerPrintErr(" compiler: failed to clear stale hostrun artifacts")
        return 2
    if !CompilerEnsureBackendDriver(rootDir, "r2c fresh gate"):
        return 2
    let backendDriverPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng")
    if !chengpath.FileExistsNonEmpty(rootDir, backendDriverPath):
        CompilerPrintErr(Fmt" compiler: missing backend driver for r2c fresh gate: {backendDriverPath}")
        return 2
    let bootstrapSnapshot = contracts.BootstrapSnapshotDefault(rootDir)
    let stage3Path = Fmt"{bootstrapSnapshot.stage3Compiler.path}"
    if !chengpath.FileExistsNonEmpty(rootDir, stage3Path):
        CompilerPrintErr(Fmt" compiler: missing stage3 for r2c fresh gate: {stage3Path}")
        return 2
    if CompilerForwardToBridge(rootDir, stage3Path, "run-host-smokes", smokeNames) != 0:
        CompilerPrintErr(" compiler: run-host-smokes failed inside r2c fresh gate")
        return 2
    let auditText = hbagate.HostBridgeAuditGateText(rootDir)
    CompilerPrintLine(auditText)
    if !strutil.Contains(auditText, "pure_cheng_zero_c_ready=1") ||
       !strutil.Contains(auditText, "remaining_non_pure_cheng_boundary=none"):
        CompilerPrintErr(" compiler: host bridge audit not ready for r2c fresh gate")
        return 2
    if CompilerForwardToBridge(rootDir,
                                 stage3Path,
                                 "r2c-react",
                                 ["status", "--out", share(statusOut)]) != 0:
        CompilerPrintErr(" compiler: r2c-react status failed inside fresh gate")
        return 2
    if !chengpath.PathFileExists(statusOut):
        CompilerPrintErr(Fmt" compiler: missing r2c status report: {statusOut}")
        return 2
    let statusText = chengpath.ReadTextFile("", statusOut)
    if !CompilerTextContainsAll(statusText, statusNeedles):
        CompilerPrintErr(" compiler: r2c status report drifted from expected helper contract")
        return 2
    if CompilerForwardToBridgeEnv(rootDir,
                                    backendDriverPath,
                                    "r2c-react-codegen-surface-smoke",
                                    [
                                        "--repo", share(repo),
                                        "--out-dir", share(codegenSmokeOutDir)
                                    ],
                                    ["CHENG_BACKEND_DRIVER_READY=1"]) != 0:
        CompilerPrintErr(" compiler: r2c codegen surface smoke failed inside fresh gate")
        return 2
    for i in 0..<routeStates.len:
        let routeState = routeStates[i]
        let bundleOutDir = Fmt"/tmp/r2c-native-gui-fresh-clean-gate-{routeState}"
        if CompilerForwardToBridge(rootDir,
                                     stage3Path,
                                     "r2c-react",
                                     [
                                         "native-gui-bundle",
                                         "--repo", share(repo),
                                         "--out-dir", share(bundleOutDir),
                                         "--route-state", share(routeState)
                                     ]) != 0:
            CompilerPrintErr(Fmt" compiler: native-gui-bundle failed for route: {routeState}")
            return 2
        let bundleReport = os.JoinPath(bundleOutDir, "native_gui_bundle_report_v1.json")
        let bundleSummary = os.JoinPath(bundleOutDir, "native_gui_bundle.summary.env")
        let bundleJson = os.JoinPath(bundleOutDir, "native_gui_bundle_v1.json")
        if !chengpath.PathFileExists(bundleReport) || !chengpath.PathFileExists(bundleSummary) || !chengpath.PathFileExists(bundleJson):
            CompilerPrintErr(Fmt" compiler: missing bundle artifacts for route: {routeState}")
            return 2
        let reportText = chengpath.ReadTextFile("", bundleReport)
        let summaryText = chengpath.ReadTextFile("", bundleSummary)
        if !CompilerTextContainsAll(reportText, reportNeedles):
            CompilerPrintErr(Fmt" compiler: bundle report drifted for route: {routeState}")
            return 2
        if !strutil.Contains(summaryText, "native_gui_runtime_mode=cheng_compiled_json_v1") ||
           !strutil.Contains(summaryText, Fmt"native_gui_route_state={routeState}"):
            CompilerPrintErr(Fmt" compiler: bundle runtime mode drifted for route: {routeState}")
            return 2
    CompilerPrintLine("r2c-react fresh clean gate: ok")
    CompilerPrintLine(Fmt"status_report={statusOut}")
    for i in 0..<routeStates.len:
        let routeState = routeStates[i]
        let bundleOutDir = Fmt"/tmp/r2c-native-gui-fresh-clean-gate-{routeState}"
        let bundleReport = os.JoinPath(bundleOutDir, "native_gui_bundle_report_v1.json")
        var bundleLine = "bundle_report_"
        CompilerAppendOwnedText(bundleLine, strings.CloneStr(routeState))
        CompilerAppendOwnedText(bundleLine, "=")
        CompilerAppendOwnedText(bundleLine, bundleReport)
        CompilerPrintLine(bundleLine)
    return 0

@borrows
fn CompilerLegacyMigrationBuild(rootDir: str,
                                  packageRoot: str,
                                  legacySourcePathRaw: str,
                                  packageIdHint: str,
                                  entryModulePath: str,
                                  out: var ccsg.CompilerLegacyMigration): Result[bool] =
    let legacySourcePath = chengpath.PathAbsolute(rootDir, legacySourcePathRaw)
    if len(legacySourcePath) <= 0:
        return Err[bool](" compiler migration: missing --legacy-in")
    # Production path writes the caller's out directly: no Result temporary,
    # no deep clone of the whole CompilerCsg payload.
    return ccsg.BuildCompilerLegacyMigrationInto(rootDir,
                                                   packageRoot,
                                                   legacySourcePath,
                                                   packageIdHint,
                                                   entryModulePath,
                                                   out)

@borrows
fn CompilerMigrationSemanticProofBuild(
        plan: sexec.SystemLinkExecPlan,
        migration: ccsg.CompilerLegacyMigration,
        outEvidence: var ceq.CompilerMigrationEvidence,
        outProof: var ceq.CompilerMigrationSemanticProof): Result[bool] =
    let baselineCsgText = migration.baselineArtifact.canonicalCsgReport
    let migratedCsgText = migration.migratedArtifact.canonicalCsgReport
    var baselineGraphCid = layout.FixedBytes32()
    var migratedGraphCid = layout.FixedBytes32()
    var graphEquivalent = 0
    let graphRes = ceq.CompilerEquivalenceGraphCompareTexts(
        baselineCsgText,
        migratedCsgText,
        baselineGraphCid,
        migratedGraphCid,
        graphEquivalent)
    if IsErr(graphRes):
        return Err[bool](Error(graphRes))
    if !layout.FixedBytes32Equal(
            baselineGraphCid,
            migration.baselineArtifact.canonicalGraphCid) ||
       !layout.FixedBytes32Equal(
            migratedGraphCid,
            migration.migratedArtifact.canonicalGraphCid):
        return Err[bool](
            " compiler migration: compact canonical sidecar identity mismatch")
    let baselineSurfaceText = ccsg.CompilerExportSurfaceReport(
        migration.baselineArtifact.exportSurface)
    let migratedSurfaceText = ccsg.CompilerExportSurfaceReport(
        migration.migratedArtifact.exportSurface)
    var baselineSurfaceCid = layout.FixedBytes32()
    var migratedSurfaceCid = layout.FixedBytes32()
    var exportSurfaceCompatible = 0
    let surfaceRes = ceq.CompilerEquivalenceSurfaceCompareTexts(
        baselineSurfaceText,
        migratedSurfaceText,
        baselineSurfaceCid,
        migratedSurfaceCid,
        exportSurfaceCompatible)
    if IsErr(surfaceRes):
        return Err[bool](Error(surfaceRes))
    if !ceq.CompilerMigrationSourceReceiptEqual(
            plan.compilerCsg.sourceIdentityReceipt,
            migration.migratedArtifact.sourceIdentityReceipt) ||
       !layout.FixedBytes32Equal(plan.compilerCsg.canonicalGraphCid,
                                 migration.migratedArtifact.canonicalGraphCid) ||
       !layout.FixedBytes32Equal(plan.exportSurface.surfaceCid,
                                 migration.migratedArtifact.exportSurface.surfaceCid):
        return Err[bool](
            " compiler migration: published source is not the migrated fixed point")
    let evidenceRes = ceq.CompilerMigrationEvidenceMake(
        migration,
        outEvidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    var baselineSemanticReceipt: sexec.CompileSemanticReceipt
    var migratedSemanticReceipt: sexec.CompileSemanticReceipt
    var semanticErr: str
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.baselineArtifact.sourceIdentityReceipt,
            migration.baselineArtifact.canonicalGraphCid,
            plan.semanticReceipt.canonicalOutputDigest,
            plan.systemLinkPlan.targetTriple,
            "stage3_local",
            plan.systemLinkPlan.providerModules,
            baselineSemanticReceipt,
            semanticErr):
        return Err[bool](Fmt" compiler migration: baseline semantic receipt invalid: {semanticErr}")
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.migratedArtifact.sourceIdentityReceipt,
            migration.migratedArtifact.canonicalGraphCid,
            plan.semanticReceipt.canonicalOutputDigest,
            plan.systemLinkPlan.targetTriple,
            "stage3_local",
            plan.systemLinkPlan.providerModules,
            migratedSemanticReceipt,
            semanticErr):
        return Err[bool](Fmt" compiler migration: migrated semantic receipt invalid: {semanticErr}")
    if !layout.FixedBytes32Equal(plan.semanticReceipt.receiptCid,
                                 migratedSemanticReceipt.receiptCid):
        return Err[bool](
            " compiler migration: published semantic receipt is not migrated fixed point")
    return ceq.CompilerMigrationSemanticProofMake(
        plan.systemLinkPlan.packageId,
        plan.localUniverse.worldHead.channel,
        outEvidence,
        baselineGraphCid,
        migratedGraphCid,
        migration.baselineArtifact.exportSurface,
        migration.migratedArtifact.exportSurface,
        baselineSemanticReceipt,
        migratedSemanticReceipt,
        plan.systemLinkPlan.targetTriple,
        outProof)

@borrows
fn CompilerMigrationEntryModulePathInto(
        packageRoot: str,
        req: creq.CompilerRequest,
        plan: sexec.SystemLinkExecPlan,
        outEntryModulePath: var str,
        err: var str): bool =
    outEntryModulePath = ""
    err = ""
    if !sexec.SystemLinkExecPlanSourceBundleReceiptValidInto(
            plan,
            outEntryModulePath,
            err):
        err = Fmt" compiler migration: invalid consumed source receipt: {err}"
        return false
    var planWorkspaceRoot: str
    if !parser.ParserSourceIdentityLexicalPathInto(
            plan.systemLinkPlan.workspaceRoot,
            planWorkspaceRoot) ||
       planWorkspaceRoot != plan.systemLinkPlan.workspaceRoot:
        err = " compiler migration: consumed workspace root identity invalid"
        return false
    var planPackageRoot: str
    if !parser.ParserSourceIdentityLexicalPathInto(
            plan.systemLinkPlan.packageRoot,
            planPackageRoot) ||
       planPackageRoot != plan.systemLinkPlan.packageRoot:
        err = " compiler migration: consumed package root identity invalid"
        return false
    var requestPackageRoot: str
    if !parser.ParserSourceIdentityLexicalPathInto(packageRoot,
                                                   requestPackageRoot) ||
       requestPackageRoot != planPackageRoot:
        err = " compiler migration: request/consumed package root identity mismatch"
        return false
    var requestSourcePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(
            chengpath.PathAbsolute(planPackageRoot,
                                   creq.CompilerRequestSourcePath(req)),
            requestSourcePath):
        err = " compiler migration: request entry source identity invalid"
        return false
    var preservedSourcePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(plan.compilerEntrySource,
                                                    preservedSourcePath) ||
       preservedSourcePath != plan.compilerEntrySource:
        err = " compiler migration: preserved entry source identity invalid"
        return false
    var consumedPlanSourcePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(
            plan.systemLinkPlan.buildEntryPath,
            consumedPlanSourcePath) ||
       consumedPlanSourcePath != plan.systemLinkPlan.buildEntryPath:
        err = " compiler migration: consumed plan entry source identity invalid"
        return false
    if requestSourcePath != preservedSourcePath ||
       consumedPlanSourcePath != preservedSourcePath:
        err = " compiler migration: request/preserved entry source identity mismatch"
        return false
    return true

@borrows
fn CompilerMigrationProofFromArgs(rootDir: str,
                                    args: str[],
                                    req: creq.CompilerRequest,
                                    plan: sexec.SystemLinkExecPlan,
                                    outMigration: var ccsg.CompilerLegacyMigration,
                                    outEvidence: var ceq.CompilerMigrationEvidence,
                                    out: var ceq.CompilerMigrationSemanticProof): Result[bool] =
    let legacySourcePath = creq.CompilerLegacyInPathFromArgs(args)
    if len(legacySourcePath) <= 0:
        return Err[bool](" compiler migration: missing --legacy-in")
    let packageRoot = creq.CompilerRequestRootDir(req)
    var entryModulePath: str
    var entryIdentityErr: str
    if !CompilerMigrationEntryModulePathInto(packageRoot,
                                              req,
                                              plan,
                                              entryModulePath,
                                              entryIdentityErr):
        return Err[bool](entryIdentityErr)
    let migrationRes = CompilerLegacyMigrationBuild(rootDir,
                                                      packageRoot,
                                                      legacySourcePath,
                                                      plan.systemLinkPlan.packageId,
                                                      entryModulePath,
                                                      outMigration)
    if IsErr(migrationRes):
        return Err[bool](Error(migrationRes))
    return CompilerMigrationSemanticProofBuild(plan,
                                                outMigration,
                                                outEvidence,
                                                out)

@borrows
fn CompilerMigrationProofFromRuntimeFlags(rootDir: str,
                                            req: creq.CompilerRequest,
                                            plan: sexec.SystemLinkExecPlan,
                                            outMigration: var ccsg.CompilerLegacyMigration,
                                            outEvidence: var ceq.CompilerMigrationEvidence,
                                            out: var ceq.CompilerMigrationSemanticProof): Result[bool] =
    let legacySourcePath = cmdline.ReadFlagOrDefault("--legacy-in", "")
    if len(legacySourcePath) <= 0:
        return Err[bool](" compiler migration: missing --legacy-in")
    let packageRoot = creq.CompilerRequestRootDir(req)
    var entryModulePath: str
    var entryIdentityErr: str
    if !CompilerMigrationEntryModulePathInto(packageRoot,
                                              req,
                                              plan,
                                              entryModulePath,
                                              entryIdentityErr):
        return Err[bool](entryIdentityErr)
    let migrationRes = CompilerLegacyMigrationBuild(rootDir,
                                                      packageRoot,
                                                      legacySourcePath,
                                                      plan.systemLinkPlan.packageId,
                                                      entryModulePath,
                                                      outMigration)
    if IsErr(migrationRes):
        return Err[bool](Error(migrationRes))
    return CompilerMigrationSemanticProofBuild(plan,
                                                outMigration,
                                                outEvidence,
                                                out)

fn CompilerProofModeFromRuntimeFlags(required: bool,
                                       outMode: var str): Result[bool] =
    let legacySourcePath = strutil.Strip(
        cmdline.ReadFlagOrDefault("--legacy-in", ""))
    if legacySourcePath == "":
        if required:
            return Err[bool](
                " compiler proof: current production schema requires --legacy-in")
        outMode = ""
        return Ok[bool](false)
    outMode = "migration"
    return Ok[bool](true)

@borrows
fn CompilerLegacyArtifactsWrite(rootDir: str,
                                  prefix: str,
                                  migration: ccsg.CompilerLegacyMigration,
                                  evidence: ceq.CompilerMigrationEvidence,
                                  proof: ceq.CompilerMigrationSemanticProof): bool =
    if len(prefix) <= 0:
        return true
    if !ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence):
        return false
    let migrationPath = Fmt"{prefix}.migration.txt"
    if !chengpath.WriteTextFile(rootDir,
                                migrationPath,
                                ccsg.CompilerLegacyMigrationReport(migration)):
        return false
    let csgPath = Fmt"{prefix}.migration.csg.txt"
    let csgText = migration.migratedArtifact.canonicalCsgReport
    if !chengpath.WriteTextFile(rootDir, csgPath, csgText):
        return false
    let surfacePath = Fmt"{prefix}.migration.surface.txt"
    let surfaceText = ccsg.CompilerExportSurfaceReport(
        migration.migratedArtifact.exportSurface)
    if !chengpath.WriteTextFile(rootDir, surfacePath, surfaceText):
        return false
    let evidencePath = Fmt"{prefix}.evidence.txt"
    if !chengpath.WriteTextFile(
            rootDir,
            evidencePath,
            ceq.CompilerMigrationEvidenceReport(evidence)):
        return false
    let baselineSemantic =
        ceq.CompilerMigrationSemanticProofSemanticReceipt(
            proof.baselineSemanticSourceIdentityReceiptCid,
            proof.baselineSemanticCompilerCsgCid,
            proof.baselineSemanticOutputDigest,
            proof.baselineSemanticTargetTripleCid,
            proof.baselineSemanticBootstrapStageCid,
            proof.baselineSemanticProviderSetCid,
            proof.baselineSemanticReceiptCid)
    let migratedSemantic =
        ceq.CompilerMigrationSemanticProofSemanticReceipt(
            proof.migratedSemanticSourceIdentityReceiptCid,
            proof.migratedSemanticCompilerCsgCid,
            proof.migratedSemanticOutputDigest,
            proof.migratedSemanticTargetTripleCid,
            proof.migratedSemanticBootstrapStageCid,
            proof.migratedSemanticProviderSetCid,
            proof.migratedSemanticReceiptCid)
    var semanticErr: str
    if !sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            baselineSemantic,
            semanticErr) ||
       !sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            migratedSemantic,
            semanticErr):
        return false
    if !chengpath.WriteTextFile(
            rootDir,
            Fmt"{prefix}.baseline.semantic.txt",
            sexec.SystemLinkExecCompileSemanticReceiptReport(
                baselineSemantic)) ||
       !chengpath.WriteTextFile(
            rootDir,
            Fmt"{prefix}.migrated.semantic.txt",
            sexec.SystemLinkExecCompileSemanticReceiptReport(
                migratedSemantic)):
        return false
    let proofPath = Fmt"{prefix}.proof.txt"
    if !chengpath.WriteTextFile(
            rootDir,
            proofPath,
            ceq.CompilerMigrationSemanticProofReport(proof)):
        return false
    return true

@borrows
fn CompilerPublishSummary(prefix: str,
                            channel: str,
                            snapshot: sexec.SystemLinkExecPublicationSnapshot,
                            receipt: ccsg.CompileReceipt,
                            proofMode: str,
                            equivalenceChecked: bool,
                            equivalencePassed: int32,
                            publishAllowed: int32,
                            proofCid: layout.FixedBytes32): str =
    var checked = "0"
    var passed = IntToStr(equivalencePassed)
    var proofModeText = "-"
    if equivalenceChecked:
        checked = "1"
    if len(proofMode) > 0:
        proofModeText = proofMode
    var out = ""
    CompilerAppendOwnedText(out, "bundle_prefix=" + prefix + "\n")
    CompilerAppendOwnedText(out, "channel=" + channel + "\n")
    CompilerAppendOwnedText(out, "world_head_cid=" + layout.FixedBytes32Hex(snapshot.localUniverse.worldHead.headCid) + "\n")
    CompilerAppendOwnedText(out, "manifest_root_cid=" + layout.FixedBytes32Hex(snapshot.localUniverse.manifest.manifestCid) + "\n")
    CompilerAppendOwnedText(out, "manifest_entry_count=" + IntToStr(snapshot.localUniverse.manifest.entryCount) + "\n")
    CompilerAppendOwnedText(out, "csg_root_cid=" + layout.FixedBytes32Hex(snapshot.localUniverse.worldHead.csgRootCid) + "\n")
    CompilerAppendOwnedText(out, "surface_cid=" + layout.FixedBytes32Hex(snapshot.exportSurface.surfaceCid) + "\n")
    CompilerAppendOwnedText(out, "receipt_cid=" + layout.FixedBytes32Hex(receipt.receiptCid) + "\n")
    CompilerAppendOwnedText(out, "proof_mode=" + proofModeText + "\n")
    CompilerAppendOwnedText(out, "equivalence_checked=" + checked + "\n")
    CompilerAppendOwnedText(out, "equivalence_passed=" + passed + "\n")
    CompilerAppendOwnedText(out, "publish_allowed=" + IntToStr(publishAllowed) + "\n")
    CompilerAppendOwnedText(out, "proof_cid=" + layout.FixedBytes32Hex(proofCid))
    return out

@borrows
fn CompilerEmitCsg(rootDir: str,
                     args: str[]): int32 =
    args
    let reqRes = CompilerRequestFromRuntimeFlags(rootDir, false)
    if IsErr(reqRes):
        CompilerPrintErr(Error(reqRes))
        return 2
    let req = Value(reqRes)
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    if !slplan.BuildSystemLinkPlanStub(rootDir, req, linkPlan, err):
        CompilerPrintErr(err)
        return 2
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(linkPlan)
    if IsErr(sourceBundleRes):
        CompilerPrintErr(Error(sourceBundleRes))
        return 2
    let sourceBundleCid = Value(sourceBundleRes)
    var csg: ccsg.CompilerCsg
    var csgErr = ""
    if !ccsg.BuildCompilerCsgInto(linkPlan,
                                   sourceBundleCid,
                                   csg,
                                   csgErr):
        if len(csgErr) <= 0:
            csgErr = "compiler emit csg: compiler csg build failed"
        CompilerPrintErr(csgErr)
        return 2
    let report = ccsg.CompilerCsgReport(csg)
    if !CompilerWriteOptionalReport(rootDir, req.reportPath, report):
        CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
        return 2
    CompilerPrintLine(report)
    return 0

@borrows
fn CompilerVerifyBackendEgraphCost(rootDir: str,
                                    args: str[]): int32 =
    args
    let report = ccsg.CompilerCsgEgraphActiveContractReport()
    let reportPath = cmdline.ReadFlagOrDefault("--report-out", "")
    if !CompilerWriteOptionalReport(rootDir, reportPath, report):
        CompilerPrintErr(Fmt" compiler: failed to write report: {reportPath}")
        return 2
    CompilerPrintErr(report)
    return ccsg.CompilerCsgUirEgraphUnavailableExitCode()

@borrows
fn CompilerMigrateCsg(rootDir: str,
                        args: str[]): int32 =
    args
    let legacySourcePath = cmdline.ReadFlagOrDefault("--legacy-in", "")
    if len(legacySourcePath) <= 0:
        CompilerPrintErr(" compiler migration: missing --legacy-in")
        return 2
    let reqRes = CompilerRequestFromRuntimeFlags(rootDir, false)
    if IsErr(reqRes):
        CompilerPrintErr(Error(reqRes))
        return 2
    let req = Value(reqRes)
    let planRes = CompilerBuildSystemPlanForEquivalenceFromRuntimeFlags(
        rootDir,
        req)
    if IsErr(planRes):
        CompilerPrintErr(Error(planRes))
        return 2
    let plan = Value(planRes)
    var migration: ccsg.CompilerLegacyMigration
    var evidence: ceq.CompilerMigrationEvidence
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = CompilerMigrationProofFromRuntimeFlags(rootDir,
                                                           req,
                                                           plan,
                                                           migration,
                                                           evidence,
                                                           proof)
    if IsErr(proofRes):
        CompilerPrintErr(Error(proofRes))
        return 2
    let prefix = cmdline.ReadFlagOrDefault("--out", "")
    if !CompilerLegacyArtifactsWrite(rootDir,
                                      prefix,
                                      migration,
                                      evidence,
                                      proof):
        CompilerPrintErr(Fmt" compiler migration: failed to write migration artifacts: {prefix}")
        return 2
    let report = ccsg.CompilerLegacyMigrationReport(migration)
    let reportPath = cmdline.ReadFlagOrDefault("--report-out", "")
    if !CompilerWriteOptionalReport(rootDir, reportPath, report):
        CompilerPrintErr(Fmt" compiler: failed to write report: {reportPath}")
        return 2
    CompilerPrintLine(report)
    return 0

@borrows
fn CompilerVerifyWorld(rootDir: str,
                         args: str[]): int32 =
