fn CompilerTextContainsLegacyToolingMarker(text: str): bool =
    let markers = CompilerLegacyToolingMarkers()
    var start = 0
    for i in 0..len(markers):
        var lineEnd = false
        if i == len(markers):
            lineEnd = true
        elif markers[i] == '\n':
            lineEnd = true
        if lineEnd:
            let marker = strings.SliceBytes(markers, start, i - start)
            if len(marker) > 0 && strutil.Contains(text, marker):
                return true
            start = i + 1
    return false

@borrows
fn CompilerVerifyOrphanGuard(rootDir: str): int32 =
    let toolingDir = chengpath.PathAbsolute(rootDir, "tools")
    let toolingDirQuoted = CompilerQuoteShell(toolingDir)
    let shellScanCommand = Fmt"find {toolingDirQuoted} -maxdepth 1 -type f -name '*.sh'"
    let pyScanCommand = Fmt"find {toolingDirQuoted} -maxdepth 1 -type f -name '*.py'"
    let shellScan = CompilerRunShellLogged(rootDir,
                                             "verify_orphan_guard_shell_scan",
                                             shellScanCommand,
                                             "artifacts/gate/orphan_guard_shell_scan.log",
                                             10)
    if CompilerLoggedRunFailed(shellScan):
        return shellScan.exitCode
    let shellText = strutil.Strip(shellScan.output)
    if len(shellText) > 0:
        CompilerPrintErr(Fmt"verify_orphan_guard: shell tooling entry not allowed: {shellText}")
        return 1
    let pyScan = CompilerRunShellLogged(rootDir,
                                          "verify_orphan_guard_py_scan",
                                          pyScanCommand,
                                          "artifacts/gate/orphan_guard_py_scan.log",
                                          10)
    if CompilerLoggedRunFailed(pyScan):
        return pyScan.exitCode
    var pathStart = 0
    let n = len(pyScan.output)
    var i = 0
    while i <= n:
        var lineEnd = false
        if i == n:
            lineEnd = true
        elif pyScan.output[i] == '\n':
            lineEnd = true
        elif pyScan.output[i] == '\r':
            lineEnd = true
        if !lineEnd:
            i = i + 1
            continue
        let path = strutil.Strip(strings.SliceBytes(pyScan.output, pathStart, i - pathStart))
        if len(path) > 0:
            let parts = os.SplitFile(path)
            let fileName = Fmt"{parts.name}{parts.ext}"
            if CompilerTextContainsLegacyToolingMarker(fileName):
                CompilerPrintErr(Fmt"verify_orphan_guard: banned tooling entry name: {path}")
                return 1
            let text = chengpath.ReadTextFile("", path)
            if CompilerTextContainsLegacyToolingMarker(text):
                CompilerPrintErr(Fmt"verify_orphan_guard: banned direct process guard ref in {path}")
                return 1
        pathStart = i + 1
        i = i + 1
    var orphanBefore: str[]
    if CompilerReadChengOrphanSnapshot(rootDir,
                                         "orphan_guard_before",
                                         "artifacts/gate/orphan_guard_before.log",
                                         orphanBefore) != 0:
        return 1
    if CompilerBootstrapBridge(rootDir) != 0:
        return 1
    if CompilerBuildBackendDriver(rootDir) != 0:
        return 1
    var orphanAfter: str[]
    if CompilerReadChengOrphanSnapshot(rootDir,
                                         "orphan_guard_after",
                                         "artifacts/gate/orphan_guard_after.log",
                                         orphanAfter) != 0:
        return 1
    let orphanDelta = CompilerCollectNewOrphanKeys(orphanBefore, orphanAfter)
    if orphanDelta.len > 0:
        CompilerPrintErr("verify_orphan_guard: new Cheng U/UE process leaked after bootstrap/build")
        for i in 0..<orphanDelta.len:
            CompilerPrintErr(orphanDelta[i])
        return 1
    CompilerPrintLine("verify_orphan_guard ok")
    return 0

# 同模块 fn-value 包装 (与 dispatch_min 一致): 限定名 (跨模块) 函数只能 call 不能取址作 fn-value
# (cold-hybrid 前端硬限制; driver-bake 无此限但统一用同模块包装最稳)。包一层同模块函数直调
# subfetch.CasSubprocessFetcher, 再把本地函数名作 fn-value 注入 parser 槽。
fn compilerMainCasSubprocessFetch(cidHex: str): Result[Bytes] =
    return subfetch.CasSubprocessFetcher(cidHex)

# 同模块 ensure-lock 包装 (镜像 dispatch_min): 缺锁自举 miss-hook 经此 fn-value 触发子进程拉源
# + TOFU/pin 校验并写 lock。跨模块限定名不能取址作 fn-value, 故同模块包一层直调。
fn compilerMainCasEnsureLock(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    return subfetch.CasSubprocessEnsureLock(channelHex, modulePath, storeRoot)

@borrows
fn CompilerBootstrapBridgeShouldRun(rootDir: str): bool =
    let currentPath = CompilerCurrentExecutablePath(rootDir)
    if len(currentPath) <= 0:
        return false
    let stage3Path = artifactpaths.ArtifactStage3Path(rootDir)
    return CompilerBootstrapStageVariantPath(currentPath, stage3Path)

@borrows
fn CompilerOwnedArgv(args: str[]): str[] =
    var out: str[]
    for i in 0..<args.len:
        add(out, strings.CloneStr(args[i]))
    return out

@borrows
fn CompilerMainProductionChildValidatePreExecInto(
        rootDir: str,
        req: var creq.CompilerRequest,
        handle:
            var held_exec_provider.CsgCoreProductionPreExecInputChildHandle,
        err: var str): bool =
    if !production_launcher.CsgCoreProductionLauncherChildAdmissionActive():
        err = ""
        return true
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var plan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(
           rootDir,
           req,
           externalPackageRoots,
           plan,
           err):
        return false
    var compositionEvidence:
        composition_manifest.CompositionManifestEvidence
    if !composition_manifest.CompositionManifestBindPlanInto(
           rootDir,
           req,
           plan,
           compositionEvidence,
           err):
        return false
    var ownerReceipt: held_exec_provider.CsgCoreProductionPreExecInputOwnerReceipt
    if !production_launcher.CsgCoreProductionPreExecInputChildValidateAndConsumeInto(
           handle, req, plan, ownerReceipt, err):
        return false
    return true

@borrows
fn CompilerMainSystemLinkExecPrepared(
        rootDir: str,
        args: str[],
        req: var creq.CompilerRequest): int32 =
    if !creq.CompilerRequestStrictValidateSealed(req):
        CompilerPrintErr(
            "HARD_RED:compiler_system_link_exec_prepared_request_unsealed")
        return 2
    if creq.CompilerRequestCompositionPresent(req) &&
       !creq.CompilerRequestCompositionSourceBundleBound(req):
        CompilerPrintErr(
            "HARD_RED:composition_manifest_source_bundle_identity_unbound")
        return 2
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=main_req")
        CompilerPrintErr(Fmt"debug_system_link_exec_main_args_len={args.len}")
        CompilerPrintErr(Fmt"debug_system_link_exec_main_req_source={req.sourcePath}")
        CompilerPrintErr(Fmt"debug_system_link_exec_main_req_output={req.outputPath}")
        CompilerPrintErr(Fmt"debug_system_link_exec_main_req_report={req.reportPath}")
    if strutil.Strip(os.GetEnv("CHENG_DEBUG_REQ_PROBE")) != "":
        var probeArgs = CompilerOwnedArgv(args)
        let planRes = CompilerBuildSystemPlan(rootDir, req, probeArgs)
        if IsErr(planRes):
            CompilerPrintErr(Error(planRes))
            return 2
        var plan = Value(planRes)
        CompilerPrintErr(Fmt"debug_req_probe_edges={plan.systemLinkPlan.importEdgeCount}")
        CompilerPrintErr(Fmt"debug_req_probe_unresolved={plan.systemLinkPlan.unresolvedImportCount}")
    var runArgs = CompilerOwnedArgv(args)
    let systemLinkExecRc = CompilerRunSystemLinkExec(
        rootDir, req, runArgs)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr(Fmt"debug_system_link_exec_run_rc={systemLinkExecRc}")
        CompilerPrintErr(Fmt"debug_system_link_exec_post_req_output={req.outputPath}")
        CompilerPrintErr(Fmt"debug_system_link_exec_post_req_report={req.reportPath}")
    if systemLinkExecRc != 0:
        return systemLinkExecRc
    if ssr.SevenStageReceiptEnabled():
        let sevenStageFinalizeErr =
            ssr.SevenStageReceiptFinalize()
        if len(sevenStageFinalizeErr) > 0:
            CompilerPrintErr(sevenStageFinalizeErr)
            return 2
    return CompilerValidateSystemLinkExecSuccess(
        rootDir, req, "compiler command")

fn CompilerMainSystemLinkExec(rootDir: str,
                                cmd: str,
                                args: str[],
                                count: int32): int32 =
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        CompilerPrintErr("debug_system_link_exec=main_branch")
        CompilerPrintErr(Fmt"debug_system_link_exec_cmd={cmd}")
        CompilerPrintErr(Fmt"debug_system_link_exec_param_count={count}")
        let debugParam2 = cmdline.ParamStr(2)
        CompilerPrintErr(Fmt"debug_system_link_exec_param2={debugParam2}")
    let reqArgs = CompilerOwnedArgv(args)
    let reqRes =
        creq.CompilerRequestFromArgsForCommand(
            strings.CloneStr(rootDir), reqArgs, true)
    if IsErr(reqRes):
        CompilerPrintErr(Error(reqRes))
        return 2
    var req = Value(reqRes)
    var compositionEvidence:
        composition_manifest.CompositionManifestEvidence
    var compositionErr: str
    var compositionArgs = CompilerOwnedArgv(args)
    var compositionReq = creq.CompilerRequestClone(req)
    if !composition_manifest.CompositionManifestValidateRequestInto(
           strings.CloneStr(rootDir),
           compositionArgs,
           compositionReq,
           compositionEvidence,
           compositionErr):
        CompilerPrintErr(compositionErr)
        return 2
    if compositionEvidence.present:
        req = compositionReq
    if compositionEvidence.present:
        var compositionPlanRoots: parser.ParserExternalPackageRoot[]
        var compositionPlan: slplan.SystemLinkPlanStub
        if !slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(
               rootDir,
               req,
               compositionPlanRoots,
               compositionPlan,
               compositionErr) ||
           !composition_manifest.CompositionManifestBindPlanInto(
               rootDir,
               req,
               compositionPlan,
               compositionEvidence,
               compositionErr):
            CompilerPrintErr(compositionErr)
            return 2
    return CompilerMainSystemLinkExecPrepared(rootDir, args, req)

fn CompilerMainBuildBackendDriverFromCmdline(): int32 =
    var rootDir: str
    if cmdline.ReadFirstFlagValue("--root", rootDir) && len(rootDir) > 0:
        return CompilerBuildBackendDriver(strings.CloneStr(rootDir))
    return -1

@borrows
fn CompilerMainR2cReactEarly(rootDir: str, args: str[]): int32 =
    if args.len <= 0:
        CompilerR2cReactHelp()
        return 0
    if args[0] == "help" || args[0] == "--help" || args[0] == "-h":
        CompilerR2cReactHelp()
        return 0
    if args[0] == "status":
        return CompilerR2cReactStatus(rootDir)
    return -1

fn CompilerMainBuildBackendDriverVerified(rootDir: str): int32 =
    let buildRc = CompilerBuildBackendDriver(strings.CloneStr(rootDir))
    if buildRc != 0:
        return buildRc
    let backendDriverOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng")
    let backendDriverMapOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng.map")
    let backendDriverReport = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng.report.txt")
    if !chengpath.FileExistsNonEmpty(rootDir, backendDriverOut) ||
       !chengpath.FileExistsNonEmpty(rootDir, backendDriverMapOut) ||
       !chengpath.FileExistsNonEmpty(rootDir, backendDriverReport):
        CompilerPrintErr(" compiler: build-backend-driver completed without required driver/map/provenance outputs")
        return 2
    if !CompilerBuildBackendDriverCompileReportPure(backendDriverReport):
        CompilerPrintErr(Fmt" compiler: backend driver provenance report is not full pure backend codegen: {backendDriverReport}")
        return 2
    return 0

@borrows
fn CompilerMainBootstrapBridge(rootDir: str): int32 =
    if CompilerBootstrapBridgeShouldRun(rootDir):
        return CompilerBootstrapBridge(strings.CloneStr(rootDir))
    return -1

fn CompilerMainRun(): int32 =
    # S3 CAS fetch-on-miss 接线 (env-gated 特性开关): CHENG_CAS_FETCH_FROM 非空 → 把子进程
    # fetcher 注入 parser 槽, 使依赖 import blob-miss 时 fork+execv 调 net_cas_cli 真 UDP QUIC
    # 按 cid 拉源 + cid 自校验 + ingest (peer 由 CHENG_CAS_FETCH_FROM host:port, CLI 由 CHENG_CAS_CLI
    # 配置, 见 cas_fetch_subprocess)。子进程 fetcher 编译器进程本体零 QUIC 闭包, 故 cold-hybrid 与
    # driver-bake 双态皆可用 (in-process cwlp.CompilerWorldCasQuicFetch 仅 driver-bake 可用, 已弃用)。
    # 默认 (未设) 不注入 → parser 槽恒 false 走旧磁盘路径, 零 QUIC 激活零回归。
    # 门 gate 拓宽 (镜像 dispatch_min): FETCH_FROM (S3 fetch-on-miss) 或 CHENG_CAS_BOOTSTRAP (P5 缺锁
    # 自举) 任一非空即注入 fetcher; 缺锁自举额外注入 ensure-lock, miss-hook 自动触发拉源 + 校验 + 写 lock。
    if os.GetEnv("CHENG_CAS_FETCH_FROM") != "" || os.GetEnv("CHENG_CAS_BOOTSTRAP") != "":
        parser.ParserSetCasFetcher(compilerMainCasSubprocessFetch)
        parser.ParserSetCasLockEnsurer(compilerMainCasEnsureLock)
    if cmdline.RawParamEquals(1, "status"):
        CompilerStatusSmokeMinimal()
        return 0
    if cmdline.RawParamEquals(1, "build-backend-driver"):
        let rawBbdRc = CompilerMainBuildBackendDriverFromCmdline()
        if rawBbdRc >= 0:
            return rawBbdRc
    let rootDir = CompilerRoot()
    if strutil.Strip(os.GetEnv("CHENG_ROOT")) == "":
        if rootdisco.CompilerRootSeedExists(rootDir):
            os.SetEnv("CHENG_ROOT", strings.CloneStr(rootDir))
    let count: int32 = cmdline.ParamCount()
    if count <= 0:
        CompilerUsage(rootDir)
        return 0
    let cmd = strings.CloneStr(cmdline.ParamStr(1))
    let args = CompilerCollectArgsFrom(2, count)
    let allArgs = CompilerCollectArgsFrom(1, count)
    CompilerApplyProgressEnvFromArgs(rootDir, allArgs)
    return CompilerMainDispatch(rootDir, cmd, args, count)

fn CompilerMainCallPrintBuildPlan(rootDir: str, args: str[]): int32 =
    var callArgs = CompilerOwnedArgv(args)
    return CompilerPrintBuildPlan(rootDir, callArgs)

fn CompilerMainCallSystemLinkExec(rootDir: str,
                                    cmd: str,
                                    args: str[],
                                    count: int32): int32 =
    var callArgs = CompilerOwnedArgv(args)
    return CompilerMainSystemLinkExec(rootDir, cmd, callArgs, count)

fn CompilerMainDispatch(rootDir: str,
                          cmd: str,
                          args: str[],
                          count: int32): int32 =
    if cmd == "--help" || cmd == "-h" || cmd == "help":
        CompilerUsage(rootDir)
        return 0
    if cmd == "status":
        CompilerStatus(rootDir)
        return 0
    if cmd == "support-matrix":
        CompilerSupportMatrix(rootDir)
        return 0
    if cmd == "print-build-plan":
        return CompilerMainCallPrintBuildPlan(rootDir, args)
    if cmd == "verify-export-visibility":
        return evgate.ExportVisibilityGateRun(rootDir)
    if cmd == "verify-export-visibility-parallel":
        return evgate.ExportVisibilityGateRunParallel(rootDir)
    if cmd == "verify-mobile-shell-build-probe":
        return CompilerVerifyMobileShellBuildProbe(rootDir)
    if cmd == "host-bridge-audit":
        return hbagate.HostBridgeAuditGateRun(rootDir)
    if cmd == "r2c-react":
        let r2cRc = CompilerMainR2cReactEarly(rootDir, args)
        if r2cRc >= 0:
            return r2cRc
        return CompilerForwardStage3Command(rootDir, cmd, args)
    if cmd == "system-link-exec":
        return CompilerMainCallSystemLinkExec(rootDir, cmd, args, count)
    if cmd == "world-receipt":
        return CompilerWorldReceipt(rootDir, args)
    if cmd == "emit-csg":
        return CompilerEmitCsg(rootDir, args)
    if cmd == "verify-backend-egraph-cost" || cmd == "verify_backend_egraph_cost":
        return CompilerVerifyBackendEgraphCost(rootDir, args)
    if cmd == "migrate-csg":
        return CompilerMigrateCsg(rootDir, args)
    if cmd == "verify-world":
        return CompilerVerifyWorld(rootDir, args)
    if cmd == "world-sync":
        return compilerMainWorldSync(rootDir, args)
    if cmd == "materialize-world-mirrors":
        return CompilerMaterializeWorldMirrors(rootDir, args)
    if cmd == "prove-migration":
        return CompilerProveMigration(rootDir, args)
    if cmd == "publish-world":
        return CompilerPublishWorld(rootDir, args)
    if cmd == "fresh-node-selfhost":
        return CompilerFreshNodeSelfhost(rootDir, args)
    if cmd == "follow-world":
        return CompilerFollowWorld(rootDir, args)
    if cmd == "selfhost-build":
        return CompilerSelfhostBuild(rootDir, args)
    if cmd == "build-backend-driver":
        return CompilerMainBuildBackendDriverVerified(rootDir)
    if cmd == "bootstrap-bridge":
        let bridgeRc = CompilerMainBootstrapBridge(rootDir)
        if bridgeRc >= 0:
            return bridgeRc
        return CompilerForwardStage3Command(rootDir, cmd, args)
    if cmd == "verify-x86-linux-remote" ||
       cmd == "run-shared-emit-smokes" ||
       cmd == "r2c-react-fresh-clean-gate" ||
       cmd == "r2c-react-codegen-surface-smoke" ||
       cmd == "r2c-react-truth-compare-smoke" ||
       cmd == "r2c-react-compile-smoke" ||
       cmd == "r2c-react-native-gui-bundle-smoke":
        return CompilerUnavailableInBackendDriver(cmd)
    if CompilerForwardsToStage3(cmd):
        return CompilerForwardStage3Command(rootDir, cmd, args)
    CompilerPrintErr(Fmt" compiler: unknown command: {cmd}")
    CompilerUsage(rootDir)
    return 2

# This helper is the explicit inner ownership scope for the production parent.
# Returning from it drops request/plan/outputPath/producer value-defs before
# the process-entry epilogue consumes provider CloseReady and closes the sole
# allocation-ledger session capability.
fn CompilerMainRunProductionParentCommand(
        preflightCloseOwner: var int32): int32 =
    let rootDir = CompilerRoot()
    var req: creq.CompilerRequest
    var requestErr: str
    if !CompilerRequestFromRuntimeFlagsInto(
           rootDir, true, req, requestErr):
        CompilerPrintErr(requestErr)
        return 2
    # Composition target admission must consume the single sealed request.
    # Doing this in CompilerMainCompositionProcessEntry would parse argv and
    # allocate managed strings before the process-entry allocation-ledger
    # session exists, permanently violating its pristine-heap precondition.
    # At this point the session has already moved into the provider; every
    # early return is therefore retired by the existing preflight CloseReady
    # path in CompilerMainProcessEntry.
    if codegen_contract.CodegenCompositionActive():
        let targetTriple = creq.CompilerRequestTargetTriple(req)
        if !codegen_contract.CodegenCompositionTargetAdmitted(
               targetTriple):
            CompilerPrintErr(
                codegen_contract.CodegenCompositionMissingError(
                    targetTriple))
            return 9
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var plan: slplan.SystemLinkPlanStub
    var planErr: str
    if !slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(
           rootDir,
           req,
           externalPackageRoots,
           plan,
           planErr):
        CompilerPrintErr(planErr)
        return 2
    var compositionEvidence:
        composition_manifest.CompositionManifestEvidence
    if !composition_manifest.CompositionManifestBindPlanInto(
           rootDir,
           req,
           plan,
           compositionEvidence,
           planErr):
        CompilerPrintErr(planErr)
        return 2
    let outputPath = chengpath.PathHostFilePath(
        chengpath.PathAbsolute(
            rootDir,
            creq.CompilerRequestOutputPath(req)))
    if outputPath.len == 0:
        CompilerPrintErr("HARD_RED:production_pre_exec_output_locator")
        return 2
    var retainedBinaryFd: int32 = -1
    var producerHandle: production_launcher.CsgCoreProductionPreExecInputProducerHandle
    var producerErr: str
    if !production_launcher.CsgCoreProductionPreExecInputOpenHeldBinaryAndProduceInto(
           req,
           plan,
           retainedBinaryFd,
           producerHandle,
           producerErr):
        CompilerPrintErr(
            Fmt"HARD_RED:production_pre_exec_producer:{producerErr}")
        return 2
    return production_parent_launcher.CsgCoreProductionLauncherRunPreparedSystemLinkExecParent(
        preflightCloseOwner,
        producerHandle,
        retainedBinaryFd,
        outputPath)

fn CompilerMainProcessEntry(): int32 =
    let heldImport =
        production_launcher.CsgCoreProductionLauncherChildImportAtEntry()
    if heldImport < 0:
        os.WriteLine(
            os.Get_stderr(),
            "HARD_RED:production_held_exec_ticket_import_failed")
        return 2
    let productionChild = heldImport == 1
    if productionChild &&
       !cmdline.RawParamEquals(1, "system-link-exec"):
        os.WriteLine(
            os.Get_stderr(),
            "HARD_RED:production_held_exec_child_command_not_admitted")
        return 2
    let productionCommand =
        cmdline.RawParamEquals(1, "system-link-exec")
    var session: system.RuntimeAllocationLedgerSessionCapability
    var preflightCloseOwner: int32 = -1
    if productionCommand:
        if !production_launcher.CsgCoreProductionLauncherBeginHeldSystemLinkSessionInto(
               session):
            os.WriteLine(
                os.Get_stderr(),
                "HARD_RED:production_held_exec_session_owner_begin_failed")
            return 2
        if session.handle == uint64(0):
            panic("production process-entry session owner missing")
    if !productionChild && productionCommand:
        var sessionMoveErr: str
        if !production_parent_launcher.CsgCoreProductionLauncherMoveProcessEntrySessionIntoProvider(
               session, preflightCloseOwner, sessionMoveErr):
            # There is no recoverable ledger-session abort API.  The provider
            # has not published READY and still leaves this exact value-def
            # with the caller; a failed move is therefore process-terminal.
            panic(Fmt"production admitted-input session move failed:{sessionMoveErr}")
    var childCapsuleOwner: int32 = -1
    var productionChildRequest: creq.CompilerRequest
    var productionChildRootDir: str
    if productionChild:
        var childCapsuleErr: str
        if !production_launcher.CsgCoreProductionLauncherChildTerminalCapsuleImportInto(
               childCapsuleOwner, childCapsuleErr):
            panic(Fmt"production terminal capsule child import failed:{childCapsuleErr}")
    if !productionChild && productionCommand:
        let parentRc = CompilerMainRunProductionParentCommand(
            preflightCloseOwner)
        var closeReadyErr: str
        if held_exec_provider.CsgCoreProductionAdmittedInputAuthorityCloseReady():
            if preflightCloseOwner != -1:
                panic("production provider full CloseReady retained preflight owner")
            if !production_parent_launcher.CsgCoreProductionLauncherConsumeProviderCloseReadyAndCloseInto(
                   closeReadyErr):
                panic(Fmt"production provider CloseReady close failed:{closeReadyErr}")
        elif preflightCloseOwner > 0:
            if !production_parent_launcher.CsgCoreProductionLauncherConsumeProviderPreflightCloseReadyAndCloseInto(
                   preflightCloseOwner,
                   closeReadyErr):
                panic(Fmt"production provider preflight close failed:{closeReadyErr}")
        else:
            panic("production provider started without terminal CloseReady")
        return parentRc
    if productionChild:
        # RuntimeHeldExecChildImport is the zero-read admission.  The exact
        # source identity and output contract are bound later from immutable
        # plan value-defs by the production system-link capability handshake.
        var childInputHandle: held_exec_provider.CsgCoreProductionPreExecInputChildHandle
        var childInputErr: str
        if !production_launcher.CsgCoreProductionLauncherConsumeAdmittedInputAtEntryInto(
               childInputHandle, childInputErr):
            panic(Fmt"production held-exec child input failed:{childInputErr}")
        productionChildRootDir = CompilerRoot()
        var childRequestErr: str
        if !CompilerRequestFromRuntimeFlagsInto(
               productionChildRootDir,
               true,
               productionChildRequest,
               childRequestErr):
            panic(Fmt"production held-exec child request failed:{childRequestErr}")
        if !CompilerMainProductionChildValidatePreExecInto(
               productionChildRootDir,
               productionChildRequest,
               childInputHandle,
               childInputErr):
            panic(Fmt"production held-exec child validation failed:{childInputErr}")
        if !sexec.SystemLinkExecPlanEvidenceInitializeBeforeWorkload():
            panic("production plan evidence registry initialization failed")
    var runRc: int32
    if productionChild:
        if os.GetEnv("CHENG_CAS_FETCH_FROM") != "" ||
           os.GetEnv("CHENG_CAS_BOOTSTRAP") != "":
            parser.ParserSetCasFetcher(compilerMainCasSubprocessFetch)
            parser.ParserSetCasLockEnsurer(compilerMainCasEnsureLock)
        if strutil.Strip(os.GetEnv("CHENG_ROOT")) == "" &&
           rootdisco.CompilerRootSeedExists(productionChildRootDir):
            os.SetEnv(
                "CHENG_ROOT",
                strings.CloneStr(productionChildRootDir))
        let childCount = cmdline.ParamCount()
        var childArgs = CompilerCollectArgsFrom(2, childCount)
        let childAllArgs = CompilerCollectArgsFrom(1, childCount)
        CompilerApplyProgressEnvFromArgs(
            productionChildRootDir, childAllArgs)
        runRc = CompilerMainSystemLinkExecPrepared(
            productionChildRootDir,
            childArgs,
            productionChildRequest)
    else:
        runRc = CompilerMainRun()
    if productionChild:
        var allocationReceipt: system.RuntimeAllocationLedgerReceipt
        var terminalReceiptCid: str
        var terminalErr: str
        if !production_launcher.CsgCoreProductionLauncherCloseHeldSystemLinkSessionReceiptInto(
               session,
               allocationReceipt,
               terminalErr):
            panic("production held-exec session owner close failed")
        if !production_launcher.CsgCoreProductionLauncherFinishSystemLinkExecChildInto(
               childCapsuleOwner,
               runRc,
               allocationReceipt,
               terminalReceiptCid,
               terminalErr):
            os.WriteLine(
                os.Get_stderr(),
                Fmt"HARD_RED:production_held_exec_terminal:{terminalErr}")
            return 2
    return runRc

fn CompilerMainCompositionProcessEntry(): int32 =
    if !codegen_contract.CodegenCompositionActive():
        os.WriteLine(
            os.Get_stderr(),
            "HARD_RED:codegen_composition_descriptor_missing")
        return 2
    # No argv decoding or managed allocation is legal before
    # CompilerMainProcessEntry issues the allocation-ledger session owner.
    # The production parent admits the target from its sealed request after
    # that owner has moved into the provider.
    return CompilerMainProcessEntry()

fn main(): int32 =
    return CompilerMainProcessEntry()
