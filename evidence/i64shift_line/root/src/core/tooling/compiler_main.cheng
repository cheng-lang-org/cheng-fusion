       !CompilerOutputContains(reportText, "hot_function[0]=") ||
       !CompilerOutputContains(reportText, "hot_pc[0]=") ||
       !CompilerOutputContains(reportText, "ordinary_profile_hotspots_fixture.cheng"):
        CompilerPrintErr(" debug profile: invalid report")
        return 1
    CompilerPrintLine(strutil.Strip(reportText))
    CompilerPrintLine(" debug profile: ok")
    return 0

