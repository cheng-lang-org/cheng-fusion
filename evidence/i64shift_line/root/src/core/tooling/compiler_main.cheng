@borrows
fn CompilerWorldPublicationBindInto(
        rootDir: str,
        plan: var sexec.SystemLinkExecPlan,
        migration: ccsg.CompilerLegacyMigration,
        evidence: ceq.CompilerMigrationEvidence,
        proof: ceq.CompilerMigrationSemanticProof,
        outCompilerMirror: var cwlp.CompilerManagedMirrorBundle,
        outSnapshot: var sexec.SystemLinkExecPublicationSnapshot,
        err: var str): bool =
    let mirrorRes = cwlp.CompilerWorldManagedMirrorBundleMake(
        plan,
        migration,
        evidence,
        proof,
        outCompilerMirror)
    if IsErr(mirrorRes):
        err = Error(mirrorRes)
        return false
    if !sexec.SystemLinkExecPlanRebuildWorldAfterMigrationInto(
            plan,
            proof.proofCid,
            outCompilerMirror.bundleCid,
            err):
        return false
    if plan.worldHeadPinned:
        let pinRes = cworld.CompilerWorldHeadMatchesHex(
            plan.localUniverse.worldHead,
            cmdline.ReadFlagOrDefault("--world-head", ""))
        if IsErr(pinRes):
            err = Error(pinRes)
            return false
    if plan.lockCheckEnabled:
        let lockRes = cworld.CompilerLockSnapshotRead(rootDir,
                                                       plan.lockPath)
        if IsErr(lockRes):
            err = Error(lockRes)
            return false
        let verifyLockRes = cworld.CompilerWorldVerifyLock(
            plan.localUniverse,
            Value(lockRes))
        if IsErr(verifyLockRes):
            err = Error(verifyLockRes)
            return false
        plan.lockVerified = true
    if !sexec.SystemLinkExecPublicationSnapshotMakeInto(
            plan,
            outSnapshot,
            err):
        return false
    err = ""
    return true

fn CompilerWorldSyncWriteBundle(
        rootDir: str,
        prefix: str,
        plan: var sexec.SystemLinkExecPlan,
        snapshot: sexec.SystemLinkExecPublicationSnapshot,
        evidence: ceq.CompilerMigrationEvidence,
        proof: ceq.CompilerMigrationSemanticProof,
        compilerMirror: cwlp.CompilerManagedMirrorBundle,
        managedDependencyReceipt: cwlp.CompilerManagedDependencyReceipt,
        managedMirrorBundles: cwlp.CompilerManagedMirrorBundle[],
        outReceipt: var ccsg.CompileReceipt): Result[str] =
    var compilerPath = CompilerCurrentExecutablePath(rootDir)
    if compilerPath == "" ||
       !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        return Err[str](
            " compiler: current publication executable identity unavailable")
    let compilerSha256 = CompilerFileSha256(compilerPath)
    if compilerSha256 == "":
        return Err[str](
            " compiler: current publication executable bytes unavailable")
    let executeRes = CompilerCanonicalSystemLinkExecRuntime(
        rootDir,
        plan,
        compilerPath)
    if IsErr(executeRes):
        return Err[str](Error(executeRes))
    if CompilerFileSha256(compilerPath) != compilerSha256:
        return Err[str](
            " compiler: current publication executable identity drift")
    let execute = Value(executeRes)
    if !layout.FixedBytes32Equal(execute.sourceIdentityReceiptCid,
                                 snapshot.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(execute.semanticReceiptCid,
                                 snapshot.semanticReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(execute.worldHeadCid,
                                 snapshot.localUniverse.worldHead.headCid) ||
       !layout.FixedBytes32Equal(execute.canonicalOutputDigest,
                                 snapshot.semanticReceipt.canonicalOutputDigest):
        return Err[str](
            " compiler: runtime/publication snapshot receipt mismatch")
    var finalReceipt: ccsg.CompileReceipt
    var receiptErr: str
    if !sexec.SystemLinkExecPublicationSnapshotFinalizeReceiptInto(
            snapshot,
            execute.outputSha256,
            finalReceipt,
            receiptErr):
        return Err[str](receiptErr)
    if !layout.FixedBytes32Equal(execute.compileReceiptCid,
                                 finalReceipt.receiptCid):
        return Err[str](
            " compiler: runtime/final compile receipt mismatch")
    var installReceipt: ccsg.CompileReceipt
    var installReceiptErr: str
    if !ccsg.CompileReceiptMakeInto(
            finalReceipt.worldHeadCid,
            finalReceipt.sourceIdentityReceiptCid,
            finalReceipt.semanticReceiptCid,
            strings.CloneStr(finalReceipt.targetTriple),
            finalReceipt.outputDigest,
            finalReceipt.canonicalOutputDigest,
            strings.CloneStr(finalReceipt.bootstrapStage),
            finalReceipt.runtimeProviderSet,
            installReceipt,
            installReceiptErr):
        return Err[str](installReceiptErr)
    let installRes = cwbundle.CompilerWorldBundleInstallAtomic(
        rootDir,
        prefix,
        snapshot,
        installReceipt,
        evidence,
        proof,
        compilerMirror,
        managedDependencyReceipt,
        managedMirrorBundles)
    if IsErr(installRes):
        return Err[str](Error(installRes))
    outReceipt = finalReceipt
    return installRes

@borrows
fn CompilerWorldFreshRebuildFromBundle(
        rootDir: str,
        req: var creq.CompilerRequest,
        snapshot: sexec.SystemLinkExecPublicationSnapshot,
        receipt: ccsg.CompileReceipt,
        evidence: ceq.CompilerMigrationEvidence,
        proof: ceq.CompilerMigrationSemanticProof,
        compilerMirror: cwlp.CompilerManagedMirrorBundle,
        managedDependencyReceipt: cwlp.CompilerManagedDependencyReceipt,
        managedMirrorBundles: cwlp.CompilerManagedMirrorBundle[]): Result[str] =
    if !creq.CompilerRequestStrictValidateSealed(req):
        return Err[str](
            " compiler: fresh rebuild request is not sealed")
    var installedBundle: cwbundle.CompilerWorldBundle
    let bundleRes = cwbundle.CompilerWorldBundleReadAndVerify(
        rootDir,
        req.outputPath,
        installedBundle)
    if IsErr(bundleRes):
        return Err[str](Error(bundleRes))
    let sourceRoot = os.JoinPath(
        os.ParentDir(installedBundle.bundlePrefix),
        "source")
    var entryRelativePath: str
    let entryPathRes = cwlp.CompilerWorldManagedMirrorSourceRelativePath(
        compilerMirror.packageId,
        evidence.entryModulePath,
        entryRelativePath)
    if IsErr(entryPathRes):
        return Err[str](Error(entryPathRes))
    let entryPath = os.JoinPath(sourceRoot, entryRelativePath)
    if !chengpath.PathDirExists(sourceRoot) ||
       !chengpath.PathFileExists(entryPath):
        return Err[str](
            " compiler: fresh rebuild source tree is incomplete")
    let freshOutputPath = req.outputPath + ".fresh_node"
    let freshReq0 = creq.CompilerRequestNew(
        sourceRoot,
        entryPath,
        freshOutputPath,
        strings.CloneStr(creq.CompilerRequestTargetTriple(req)),
        creq.CompilerRequestEmitKind(req),
        "")
    let freshReq1 = creq.CompilerRequestWithSymbolVisibility(
        freshReq0,
        strings.CloneStr(creq.CompilerRequestSymbolVisibility(req)))
    var freshReq = creq.CompilerRequestWithBrowserBridgeObject(
        freshReq1,
        strings.CloneStr(creq.CompilerRequestBrowserBridgeObjectPath(req)))
    freshReq = creq.CompilerRequestWithExportRootSymbols(
        freshReq,
        CompilerOwnedArgv(req.exportRootSymbols))
    freshReq = creq.CompilerRequestWithProviderObjectPaths(
        freshReq,
        CompilerOwnedArgv(req.providerObjectPaths))
    freshReq = creq.CompilerRequestWithRuntimeProviderBundle(
        freshReq,
        strings.CloneStr(req.runtimeProviderBundle))
    freshReq = creq.CompilerRequestWithMode(
        freshReq,
        strings.CloneStr(req.compileMode))
    freshReq.backendKind = req.backendKind
    freshReq.jobCount = req.jobCount
    creq.CompilerRequestSeal(freshReq)
    let freshPlanRes = CompilerCanonicalSystemLinkExecPlan(
        rootDir,
        freshReq,
        "",
        "",
        "",
        snapshot.localUniverse.worldHead.channel)
    if IsErr(freshPlanRes):
        return Err[str](strutil.Join([
            " compiler: fresh bundle plan failed: ",
            Error(freshPlanRes)
        ], ""))
    var freshPlan = Value(freshPlanRes)
    var freshMigration: ccsg.CompilerLegacyMigration
    var freshEvidence: ceq.CompilerMigrationEvidence
    var freshProof: ceq.CompilerMigrationSemanticProof
    let freshProofRes = CompilerMigrationProofFromRuntimeFlags(
        rootDir,
        freshReq,
        freshPlan,
        freshMigration,
        freshEvidence,
        freshProof)
    if IsErr(freshProofRes):
        return Err[str](Error(freshProofRes))
    if ceq.CompilerMigrationEvidenceReport(freshEvidence) !=
           ceq.CompilerMigrationEvidenceReport(evidence) ||
       ceq.CompilerMigrationSemanticProofReport(freshProof) !=
           ceq.CompilerMigrationSemanticProofReport(proof):
        return Err[str](
            " compiler: fresh migration proof fixed point drift")
    var freshManagedReceipt: cwlp.CompilerManagedDependencyReceipt
    let freshManagedReceiptRes =
        cwlp.CompilerWorldManagedDependencyReceiptFromPlanProjection(
            freshPlan.managedDependencyReceipt,
            freshManagedReceipt)
    if IsErr(freshManagedReceiptRes):
        return Err[str](Error(freshManagedReceiptRes))
    let managedReceiptPresent = managedDependencyReceipt.dependencyCount > 0
    let freshManagedReceiptPresent = freshManagedReceipt.dependencyCount > 0
    if managedReceiptPresent != freshManagedReceiptPresent ||
       (managedReceiptPresent &&
        cwlp.CompilerWorldManagedDependencyReceiptReport(
            freshManagedReceipt) !=
        cwlp.CompilerWorldManagedDependencyReceiptReport(
            managedDependencyReceipt)):
        return Err[str](
            " compiler: fresh managed dependency receipt drift")
    let freshManagedBundlesRes =
        cwlp.CompilerWorldManagedMirrorBundlesFromReceipt(
            rootDir,
            freshPlan.localUniverse.manifest,
            freshManagedReceipt)
    if IsErr(freshManagedBundlesRes):
        return Err[str](Error(freshManagedBundlesRes))
    let freshManagedBundles = Value(freshManagedBundlesRes)
    if freshManagedBundles.len != managedMirrorBundles.len:
        return Err[str](" compiler: fresh managed mirror count drift")
    for mirrorIndex in 0..<managedMirrorBundles.len:
        if cwlp.CompilerWorldManagedMirrorBundleReport(
                freshManagedBundles[mirrorIndex]) !=
           cwlp.CompilerWorldManagedMirrorBundleReport(
                managedMirrorBundles[mirrorIndex]):
            return Err[str](
                " compiler: fresh managed mirror fixed point drift")
    var freshCompilerMirror: cwlp.CompilerManagedMirrorBundle
    var freshSnapshot: sexec.SystemLinkExecPublicationSnapshot
    var publicationErr: str
    if !CompilerWorldPublicationBindInto(
            rootDir,
            freshPlan,
            freshMigration,
            freshEvidence,
            freshProof,
            freshCompilerMirror,
            freshSnapshot,
            publicationErr):
        return Err[str](publicationErr)
    if cwlp.CompilerWorldManagedMirrorBundleReport(freshCompilerMirror) !=
           cwlp.CompilerWorldManagedMirrorBundleReport(compilerMirror) ||
       !ceq.CompilerMigrationSourceReceiptEqual(
            freshSnapshot.sourceIdentityReceipt,
            snapshot.sourceIdentityReceipt) ||
       !layout.FixedBytes32Equal(
            freshSnapshot.semanticReceipt.receiptCid,
            snapshot.semanticReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            freshSnapshot.localUniverse.manifest.manifestCid,
            snapshot.localUniverse.manifest.manifestCid) ||
       !layout.FixedBytes32Equal(
            freshSnapshot.localUniverse.worldHead.headCid,
            snapshot.localUniverse.worldHead.headCid):
        return Err[str](" compiler: fresh publication identity drift")
    var compilerPath = CompilerCurrentExecutablePath(rootDir)
    if compilerPath == "" ||
       !chengpath.FileExistsNonEmpty(rootDir, compilerPath):
        return Err[str](
            " compiler: current fresh publication executable identity unavailable")
    let compilerSha256 = CompilerFileSha256(compilerPath)
    if compilerSha256 == "":
        return Err[str](
            " compiler: current fresh publication executable bytes unavailable")
    let executeRes = CompilerCanonicalSystemLinkExecRuntime(
        rootDir,
        freshPlan,
        compilerPath)
    if IsErr(executeRes):
        return Err[str](Error(executeRes))
    if CompilerFileSha256(compilerPath) != compilerSha256:
        return Err[str](
            " compiler: current fresh publication executable identity drift")
    let execute = Value(executeRes)
    var freshReceipt: ccsg.CompileReceipt
    var receiptErr: str
    if !sexec.SystemLinkExecPublicationSnapshotFinalizeReceiptInto(
            freshSnapshot,
            execute.outputSha256,
            freshReceipt,
            receiptErr):
        return Err[str](receiptErr)
    if !ccsg.CompileReceiptEquivalent(receipt, freshReceipt) ||
       !layout.FixedBytes32Equal(receipt.receiptCid,
                                 freshReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(execute.compileReceiptCid,
                                 freshReceipt.receiptCid):
        return Err[str](" compiler: fresh runtime receipt fixed point drift")
    var out = "fresh_rebuild=ok\n"
    out = out + "fresh_world_head_cid=" +
        layout.FixedBytes32Hex(freshSnapshot.localUniverse.worldHead.headCid) +
        "\n"
    out = out + "fresh_receipt_cid=" +
        layout.FixedBytes32Hex(freshReceipt.receiptCid)
    return Ok[str](out)

fn compilerMainWorldSync(rootDir: str,
                           args: str[]): int32 =
    return CompilerPublishWorld(rootDir, args)

@borrows
fn CompilerMaterializeWorldMirrors(rootDir: str,
                                     args: str[]): int32 =
    args
    let bundlePrefix = cmdline.ReadFlagOrDefault("--in", "")
    if len(bundlePrefix) <= 0:
        CompilerPrintErr(" compiler: missing --in")
        return 2
    var bundle: cwbundle.CompilerWorldBundle
    let bundleRes = cwbundle.CompilerWorldBundleReadAndVerify(
        rootDir,
        strings.CloneStr(bundlePrefix),
        bundle)
    if IsErr(bundleRes):
        CompilerPrintErr(Error(bundleRes))
        return 2
    let materializeRes = cwlp.CompilerWorldMaterializeManagedMirrorBundles(
        rootDir,
        bundle.manifest,
        bundle.managedDependencyReceipt,
        bundle.managedMirrorBundles)
    if IsErr(materializeRes):
        CompilerPrintErr(Error(materializeRes))
        return 2
    let report = cwlp.CompilerWorldManagedMirrorMaterializeReport(bundlePrefix, Value(materializeRes))
    let reportPath = cmdline.ReadFlagOrDefault("--report-out", "")
    if !CompilerWriteOptionalReport(rootDir, reportPath, report):
        CompilerPrintErr(Fmt" compiler: failed to write report: {reportPath}")
        return 2
    CompilerPrintLine(report)
    return 0

@borrows
fn CompilerProveMigration(rootDir: str,
                            args: str[]): int32 =
    args
    let reqRes = CompilerRequestFromRuntimeFlags(rootDir, false)
    if IsErr(reqRes):
        CompilerPrintErr(Error(reqRes))
        return 2
    let legacySourcePath = cmdline.ReadFlagOrDefault("--legacy-in", "")
    if len(legacySourcePath) <= 0:
        CompilerPrintErr(" compiler migration: missing --legacy-in")
        return 2
    let req = Value(reqRes)
    let planRes = CompilerBuildSystemPlanForEquivalenceFromRuntimeFlags(rootDir, req)
    if IsErr(planRes):
        CompilerPrintErr(Error(planRes))
        return 2
    let plan = Value(planRes)
    var migration: ccsg.CompilerLegacyMigration
    var evidence: ceq.CompilerMigrationEvidence
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = CompilerMigrationProofFromRuntimeFlags(rootDir,
                                                           req,
                                                           plan,
                                                           migration,
                                                           evidence,
                                                           proof)
    if IsErr(proofRes):
        CompilerPrintErr(Error(proofRes))
        return 2
    let prefix = req.outputPath
    let evidenceReport = ceq.CompilerMigrationEvidenceReport(evidence)
    let proofReport = ceq.CompilerMigrationSemanticProofReport(proof)
    if !CompilerLegacyArtifactsWrite(rootDir,
                                     prefix,
                                     migration,
                                     evidence,
                                     proof):
        CompilerPrintErr(
            Fmt" compiler: failed to write migration proof artifacts: {prefix}")
        return 2
    let migrationReport = ccsg.CompilerLegacyMigrationReport(migration)
    let report = Fmt"{migrationReport}\n{evidenceReport}\n{proofReport}"
    if !CompilerWriteOptionalReport(rootDir, req.reportPath, report):
        CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
        return 2
    CompilerPrintLine(report)
    return 0

@borrows
fn CompilerPublishWorld(rootDir: str,
                          args: str[]): int32 =
    args
    let reqRes = CompilerRequestFromRuntimeFlags(rootDir, true)
    if IsErr(reqRes):
        CompilerPrintErr(Error(reqRes))
        return 2
    var req = Value(reqRes)
    let planRes = CompilerBuildSystemPlanForEquivalenceFromRuntimeFlags(rootDir, req)
    if IsErr(planRes):
        CompilerPrintErr(Error(planRes))
        return 2
    var plan = Value(planRes)
    let channel = plan.localUniverse.worldHead.channel
    var proofMode = ""
    let proofModeRes = CompilerProofModeFromRuntimeFlags(true, proofMode)
    if IsErr(proofModeRes):
        CompilerPrintErr(Error(proofModeRes))
        return 2
    if !Value(proofModeRes):
        CompilerPrintErr(" compiler proof: migration proof is required")
        return 2
    var equivalenceChecked = true
    var migration: ccsg.CompilerLegacyMigration
    var evidence: ceq.CompilerMigrationEvidence
    var proof: ceq.CompilerMigrationSemanticProof
    var proofReport = ""
    var evidenceReport = ""
    var migrationReport = ""
    let proofRes = CompilerMigrationProofFromRuntimeFlags(rootDir,
                                                           req,
                                                           plan,
                                                           migration,
                                                           evidence,
                                                           proof)
    if IsErr(proofRes):
        CompilerPrintErr(Error(proofRes))
        return 2
    migrationReport = ccsg.CompilerLegacyMigrationReport(migration)
    evidenceReport = ceq.CompilerMigrationEvidenceReport(evidence)
    proofReport = ceq.CompilerMigrationSemanticProofReport(proof)
    var managedDependencyReceipt: cwlp.CompilerManagedDependencyReceipt
    let managedDependencyReceiptRes =
        cwlp.CompilerWorldManagedDependencyReceiptFromPlanProjection(
            plan.managedDependencyReceipt,
            managedDependencyReceipt)
    if IsErr(managedDependencyReceiptRes):
        CompilerPrintErr(Error(managedDependencyReceiptRes))
        return 2
    var compilerMirror: cwlp.CompilerManagedMirrorBundle
    var publicationSnapshot: sexec.SystemLinkExecPublicationSnapshot
    var publicationErr: str
    if !CompilerWorldPublicationBindInto(rootDir,
                                          plan,
                                          migration,
                                          evidence,
                                          proof,
                                          compilerMirror,
                                          publicationSnapshot,
                                          publicationErr):
        CompilerPrintErr(publicationErr)
        return 2
    var publishChannel = ""
    var stableGateRequired = 0
    var equivalenceCheckedFlag = 0
    var equivalencePassed = 0
    var publishAllowed = 0
    var proofCid = layout.FixedBytes32()
    let decisionRes = cpub.CompilerPublishDecisionEvaluate(
        channel,
        plan.localUniverse.worldHead.headCid,
        equivalenceChecked,
        proof,
        evidence,
        publishChannel,
        stableGateRequired,
        equivalenceCheckedFlag,
        equivalencePassed,
        publishAllowed,
        proofCid)
    if IsErr(decisionRes):
        CompilerPrintErr(Error(decisionRes))
        return 2
    let decisionReport = cpub.CompilerPublishDecisionReport(publishChannel,
                                                              stableGateRequired,
                                                              equivalenceCheckedFlag,
                                                              equivalencePassed,
                                                              publishAllowed,
                                                              plan.localUniverse.worldHead.headCid,
                                                              proofCid)
    if publishAllowed == 0:
        if !CompilerWriteOptionalReport(rootDir, req.reportPath, decisionReport):
            CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
            return 2
        CompilerPrintErr(" compiler: publish blocked by canonical equivalence gate")
        CompilerPrintErr(decisionReport)
        if equivalenceChecked:
            if len(migrationReport) > 0:
                CompilerPrintErr(migrationReport)
            CompilerPrintErr(proofReport)
        return 2
    var freshReport = ""
    let managedMirrorBundlesRes =
        cwlp.CompilerWorldManagedMirrorBundlesFromReceipt(
            rootDir,
            plan.localUniverse.manifest,
            managedDependencyReceipt)
    if IsErr(managedMirrorBundlesRes):
        CompilerPrintErr(Error(managedMirrorBundlesRes))
        return 2
    let managedMirrorBundles = Value(managedMirrorBundlesRes)
    var finalReceipt: ccsg.CompileReceipt
    let bundleInstallRes = CompilerWorldSyncWriteBundle(
                                                         strings.CloneStr(rootDir),
                                                         strings.CloneStr(req.outputPath),
                                                         plan,
                                                         share(publicationSnapshot),
                                                         share(evidence),
                                                         share(proof),
                                                         share(compilerMirror),
                                                         share(managedDependencyReceipt),
                                                         share(managedMirrorBundles),
                                                         finalReceipt)
    if IsErr(bundleInstallRes):
        CompilerPrintErr(Error(bundleInstallRes))
        return 2
    if channel == "stable":
        let freshRes = CompilerWorldFreshRebuildFromBundle(
            rootDir,
            req,
            publicationSnapshot,
            finalReceipt,
            evidence,
            proof,
            compilerMirror,
            managedDependencyReceipt,
            managedMirrorBundles)
        if IsErr(freshRes):
            CompilerPrintErr(
                " compiler: stable publish requires fresh bundle rebuild")
            CompilerPrintErr(Error(freshRes))
            return 2
        freshReport = Value(freshRes)
        let freshReportPath = Fmt"{req.outputPath}.fresh.txt"
        if !chengpath.WriteTextFile(rootDir,
                                    freshReportPath,
                                    Fmt"{freshReport}\n"):
            CompilerPrintErr(
                Fmt" compiler: failed to write fresh rebuild report: {freshReportPath}")
            return 2
    if !CompilerLegacyArtifactsWrite(rootDir,
                                     req.outputPath,
                                     migration,
                                     evidence,
                                     proof):
        CompilerPrintErr(
            " compiler: failed to write authenticated migration artifacts")
        return 2
    let publishReportPath = Fmt"{req.outputPath}.publish.txt"
    let publishReportText = Fmt"{decisionReport}\n"
    if !chengpath.WriteTextFile(rootDir, publishReportPath, publishReportText):
        CompilerPrintErr(Fmt" compiler: failed to write publish gate report: {publishReportPath}")
        return 2
    var summary = CompilerPublishSummary(req.outputPath,
                                           channel,
                                           publicationSnapshot,
                                           finalReceipt,
                                           proofMode,
                                           equivalenceChecked,
                                           equivalencePassed,
                                           publishAllowed,
                                           proofCid)
    if len(freshReport) > 0:
        CompilerAppendOwnedText(summary, "\n" + freshReport)
    if !CompilerWriteOptionalReport(rootDir, req.reportPath, summary):
        CompilerPrintErr(Fmt" compiler: failed to write report: {req.reportPath}")
        return 2
    CompilerPrintLine(summary)
    return 0

@borrows
fn CompilerFreshNodeSelfhost(rootDir: str,
                               args: str[]): int32 =
    return CompilerPublishWorld(rootDir, args)

type
    CompilerFollowInstallResult =
        backendDriverPath: str
        targetReceiptCid: layout.FixedBytes32
        candidateReceiptCid: layout.FixedBytes32

fn CompilerBridgeSurfaceStageRoot(): str =
    return "artifacts/backend_driver/bridge_surface_source"

fn CompilerBridgeIsIdentChar(ch: char): bool =
    let digit = ch >= '0' && ch <= '9'
    let upper = ch >= 'A' && ch <= 'Z'
    let lower = ch >= 'a' && ch <= 'z'
    if digit:
        return true
    if upper:
        return true
    if lower:
        return true
    if ch == '_':
        return true
    return false

fn CompilerBridgeIsInlineSpace(ch: char): bool =
    if ch == ' ':
        return true
    if ch == '\t':
        return true
    return false

@borrows
fn CompilerBridgeSkipInlineSpaces(text: str,
                                    startRaw: int32): int32 =
    var start = startRaw
    if start < 0:
        start = 0
    while start < text.len:
        if !CompilerBridgeIsInlineSpace(text[start]):
            break
        start = start + 1
    return start

@borrows
fn CompilerBridgeQuoteIsEscaped(text: str,
                                  pos: int32): bool =
    if pos <= 0 || pos > text.len:
        return false
    var slashCount: int32
    let iStart = pos - 1
    if iStart >= 0:
        for iOffset in 0..iStart:
            let i = iStart - iOffset
            if int32(text[i]) != 92:
                break
            slashCount = slashCount + 1
    if (slashCount % 2) != 0:
        return true
    return false

@borrows
fn CompilerBridgeFindMatchingParen(text: str,
                                     openPos: int32): int32 =
    if openPos < 0 || openPos >= text.len || text[openPos] != '(':
        return -1
    var depth: int32 = 1
    var inString = false
    var inChar = false
    var i = openPos + 1
    for i in i..<text.len:
        let ch = text[i]
        if !inChar && ch == char(34) && !CompilerBridgeQuoteIsEscaped(text, i):
            inString = !inString
            continue
        if !inString && ch == char(39) && !CompilerBridgeQuoteIsEscaped(text, i):
            inChar = !inChar
            continue
        if inString || inChar:
            continue
        if ch == '(':
            depth = depth + 1
        elif ch == ')':
            depth = depth - 1
            if depth == 0:
                return i
    return -1

@borrows
fn CompilerBridgeAppendFmtPiece(out: var str,
                                  pieceCount: var int32,
                                  piece: str) =
    if pieceCount > 0:
        CompilerAppendOwnedText(out, ", ")
    CompilerAppendOwnedText(out, piece)
    pieceCount = pieceCount + 1

@borrows
fn CompilerBridgeFmtQuotedPiece(raw: str): str =
    return Fmt"\"{raw}\""

@borrows
fn CompilerBridgeRewriteSimplePrefixStringify(lineRaw: str,
                                                dollarPos: int32,
                                                rewrittenOut: var str,
                                                stopExclusiveOut: var int32): bool =
    rewrittenOut = ""
    stopExclusiveOut = dollarPos
    if dollarPos < 0 || dollarPos >= lineRaw.len || lineRaw[dollarPos] != '$':
        return false
    if dollarPos + 1 >= lineRaw.len:
        return false
    let first = lineRaw[dollarPos + 1]
    if first == '(' || !CompilerBridgeIsIdentChar(first):
        return false
    var stop = dollarPos + 1
    while stop < lineRaw.len:
        let ch = lineRaw[stop]
        if CompilerBridgeIsIdentChar(ch) || ch == '.':
            stop = stop + 1
            continue
        break
    let operand = strings.SliceBytes(lineRaw, dollarPos + 1, stop - dollarPos - 1)
    let operandTrimmed = strutil.Strip(operand)
    if len(operandTrimmed) <= 0:
        return false
    rewrittenOut = CompilerConcat3("$(", operand, ")")
    stopExclusiveOut = stop
    return true

@borrows
fn CompilerBridgeRewriteParenStringify(lineRaw: str,
                                         dollarPos: int32,
                                         rewrittenOut: var str,
                                         stopExclusiveOut: var int32): bool =
    rewrittenOut = ""
    stopExclusiveOut = dollarPos
    if dollarPos < 0 || dollarPos + 1 >= lineRaw.len:
        return false
    if lineRaw[dollarPos] != '$' || lineRaw[dollarPos + 1] != '(':
        return false
    let closePos = CompilerBridgeFindMatchingParen(lineRaw, dollarPos + 1)
    if closePos <= dollarPos + 1:
        return false
    let inner = strings.SliceBytes(lineRaw, dollarPos + 2, closePos - dollarPos - 2)
    rewrittenOut = CompilerConcat3("$(", inner, ")")
    stopExclusiveOut = closePos + 1
    return true

@borrows
fn CompilerBridgeRewriteFmtLiteral(lineRaw: str,
                                     fmtPos: int32,
                                     rewrittenOut: var str,
                                     stopExclusiveOut: var int32): bool =
    rewrittenOut = ""
    stopExclusiveOut = fmtPos
    if fmtPos < 0 || fmtPos + 3 > lineRaw.len:
        return false
    if strings.SliceBytes(lineRaw, fmtPos, 3) != "Fmt":
        return false
    if fmtPos > 0 && CompilerBridgeIsIdentChar(lineRaw[fmtPos - 1]):
        return false
    if fmtPos + 3 < lineRaw.len && CompilerBridgeIsIdentChar(lineRaw[fmtPos + 3]):
        return false
    let quotePos = CompilerBridgeSkipInlineSpaces(lineRaw, fmtPos + 3)
    if quotePos >= lineRaw.len || lineRaw[quotePos] != char(34):
        return false
    var closePos = quotePos + 1
    while closePos < lineRaw.len:
        if lineRaw[closePos] == char(34) && !CompilerBridgeQuoteIsEscaped(lineRaw, closePos):
            break
        closePos = closePos + 1
    if closePos >= lineRaw.len:
        return false
    let literalRaw = strings.SliceBytes(lineRaw, quotePos + 1, closePos - quotePos - 1)
    var fmtOut = "strutil.Join(["
    var pieceCount: int32
    var currentLiteral = ""
    var i: int32
    while i < literalRaw.len:
        let ch = literalRaw[i]
        if ch == '{':
            if i + 1 < literalRaw.len && literalRaw[i + 1] == '{':
                CompilerAppendOwnedText(currentLiteral, "{")
                i = i + 2
                continue
            if len(currentLiteral) > 0:
                CompilerBridgeAppendFmtPiece(fmtOut,
                                               pieceCount,
                                               CompilerBridgeFmtQuotedPiece(currentLiteral))
                currentLiteral = ""
            var exprStart = i + 1
            var exprEnd = -1
            var inExprString = false
            var inExprChar = false
            var parenDepth: int32
            var bracketDepth: int32
            var braceDepth: int32
            var cursor = exprStart
            for cursor in cursor..<literalRaw.len:
                let exprCh = literalRaw[cursor]
                if !inExprChar && exprCh == char(34) && !CompilerBridgeQuoteIsEscaped(literalRaw, cursor):
                    inExprString = !inExprString
                    continue
                if !inExprString && exprCh == char(39) && !CompilerBridgeQuoteIsEscaped(literalRaw, cursor):
                    inExprChar = !inExprChar
                    continue
                if inExprString || inExprChar:
                    continue
                if exprCh == '(':
                    parenDepth = parenDepth + 1
                    continue
                if exprCh == ')':
                    if parenDepth > 0:
                        parenDepth = parenDepth - 1
                    continue
                if exprCh == '[':
                    bracketDepth = bracketDepth + 1
                    continue
                if exprCh == ']':
                    if bracketDepth > 0:
                        bracketDepth = bracketDepth - 1
                    continue
                if exprCh == '{':
                    braceDepth = braceDepth + 1
                    continue
                if exprCh == '}':
                    if parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
                        exprEnd = cursor
                        break
                    braceDepth = braceDepth - 1
                    continue
            if exprEnd < exprStart:
                return false
            let exprText = strutil.Strip(strings.SliceBytes(literalRaw, exprStart, exprEnd - exprStart))
            if len(exprText) <= 0:
                return false
            if exprText[0] == char(39) && exprText[exprText.len - 1] == char(39) && exprText.len >= 2:
                let inner = strings.SliceBytes(exprText, 1, exprText.len - 2)
                CompilerBridgeAppendFmtPiece(fmtOut,
                                               pieceCount,
                                               CompilerBridgeFmtQuotedPiece(inner))
            else:
                CompilerBridgeAppendFmtPiece(fmtOut,
                                               pieceCount,
                                               CompilerConcat3("$(", exprText, ")"))
            i = exprEnd + 1
            continue
        if ch == '}':
            if i + 1 < literalRaw.len && literalRaw[i + 1] == '}':
                CompilerAppendOwnedText(currentLiteral, "}")
                i = i + 2
                continue
            return false
        CompilerAppendOwnedText(currentLiteral, strings.CharToStr(ch))
        i = i + 1
    if len(currentLiteral) > 0 || pieceCount == 0:
        CompilerBridgeAppendFmtPiece(fmtOut,
                                       pieceCount,
                                       CompilerBridgeFmtQuotedPiece(currentLiteral))
    CompilerAppendOwnedText(fmtOut, "], \"\")")
    rewrittenOut = fmtOut
    stopExclusiveOut = closePos + 1
    return true

@borrows
fn CompilerBridgeNextRewriteCandidate(lineRaw: str,
                                        startRaw: int32): int32 =
    var i = startRaw
    if i < 0:
        i = 0
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inString && !inChar:
            if ch == char(35):
                return -1
            if int32(ch) == 96:
                var closePos = i + 1
                while closePos < lineRaw.len:
                    if int32(lineRaw[closePos]) == 96:
                        closePos = closePos + 1
                        break
                    closePos = closePos + 1
                i = closePos
                continue
            if ch == char(70) || ch == char(36):
                return i
            if ch == char(34):
                inString = true
                i = i + 1
                continue
            if int32(ch) == 39:
                inChar = true
                i = i + 1
                continue
            i = i + 1
            continue
        if inString && ch == char(34) && !CompilerBridgeQuoteIsEscaped(lineRaw, i):
            inString = false
        elif inChar && int32(ch) == 39 && !CompilerBridgeQuoteIsEscaped(lineRaw, i):
            inChar = false
        i = i + 1
    return -1

@borrows
fn CompilerBridgeRewriteLine(lineRaw: str): str =
    var out = ""
    var cursor: int32
    while cursor < lineRaw.len:
        let candidate = CompilerBridgeNextRewriteCandidate(lineRaw, cursor)
        if candidate < 0:
            CompilerAppendOwnedText(
                out, strings.SliceBytes(lineRaw, cursor, lineRaw.len - cursor))
            break
        if candidate > cursor:
            CompilerAppendOwnedText(
                out, strings.SliceBytes(lineRaw, cursor, candidate - cursor))
        var rewritten = ""
        var stop = candidate
        var didRewrite = false
        if lineRaw[candidate] == char(70):
            didRewrite = CompilerBridgeRewriteFmtLiteral(lineRaw, candidate, rewritten, stop)
        elif lineRaw[candidate] == char(36):
            didRewrite = CompilerBridgeRewriteParenStringify(lineRaw, candidate, rewritten, stop)
            if !didRewrite:
                didRewrite = CompilerBridgeRewriteSimplePrefixStringify(lineRaw, candidate, rewritten, stop)
        if didRewrite:
            CompilerAppendOwnedText(out, rewritten)
            cursor = stop
            continue
        CompilerAppendOwnedText(out, strings.CharToStr(lineRaw[candidate]))
        cursor = candidate + 1
    return out

@borrows
fn CompilerBridgeRewriteSourceTextChecked(text: str,
                                            rewrittenOut: var str,
                                            err: var str): bool =
    var normalizedText = ""
    if !parser.ParserRewriteMultilineStringSourceText(text, normalizedText, err):
        return false
    var out = ""
    var start: int32
    var i: int32
    for i in i..normalizedText.len:
        var atLineEnd = false
        if i == normalizedText.len:
            atLineEnd = true
        elif normalizedText[i] == '\n':
            atLineEnd = true
        if !atLineEnd:
            continue
        let lineRaw = strings.SliceBytes(normalizedText, start, i - start)
        CompilerAppendOwnedText(out, CompilerBridgeRewriteLine(lineRaw))
        if i < normalizedText.len:
            CompilerAppendOwnedText(out, "\n")
        start = i + 1
    rewrittenOut = out
    err = ""
    return true

fn CompilerBridgeRewriteSourceText(text: str): str =
    var out = ""
    var err = ""
    if !CompilerBridgeRewriteSourceTextChecked(text, out, err):
        return text
    return out

@borrows
fn CompilerBridgeSourceNeedsRewrite(text: str): bool =
    if parser.ParserSourceHasMultilineString(text):
        return true
    var out = ""
    var err = ""
    if !CompilerBridgeRewriteSourceTextChecked(text, out, err):
        return true
    if out != text:
        return true
    return false

@borrows
fn CompilerBridgeCopyTextFile(srcPath: str,
                                destPath: str): bool =
    let parts = os.SplitFile(destPath)
    if len(parts.dir) > 0:
        let _mkdirBridgeCopyFile = chengpath.MkdirP(chengpath.PathCurrentDir(), parts.dir)
    let text = os.ReadFile(srcPath)
    os.WriteFile(destPath, text)
    return os.ReadFile(destPath) == text

@borrows
fn CompilerBridgeCopyTextTree(srcDir: str,
                                destDir: str): bool =
    let _mkdirBridgeCopyTree = chengpath.MkdirP(chengpath.PathCurrentDir(), destDir)
    let entries = os.WalkDir(srcDir)
    for i in 0..<entries.len:
        let child = strings.CloneStr(strings.SliceBytes(
            entries[i], 2, strings.Len(entries[i]) - 2))
        let destChild = os.JoinPath(strings.CloneStr(destDir), os.ExtractFilename(strings.CloneStr(child)))
        if os.DirExists(child):
            if !CompilerBridgeCopyTextTree(child, destChild):
                return false
        elif os.FileExists(child):
            if !CompilerBridgeCopyTextFile(child, destChild):
                return false
    return true

@borrows
fn CompilerBridgeStageCopyRequired(rootDir: str,
                                     srcPath: str,
                                     destDir: str,
                                     logRel: str,
                                     context: str): Result[bool] =
    let _logPath = chengpath.PathAbsolute(rootDir, logRel)
    let leaf = os.ExtractFilename(strings.CloneStr(srcPath))
    let destPath = os.JoinPath(destDir, leaf)
    if os.DirExists(srcPath) && CompilerBridgeCopyTextTree(srcPath, destPath):
        return Ok[bool](true)
    if os.FileExists(srcPath) && CompilerBridgeCopyTextFile(srcPath, destPath):
        return Ok[bool](true)
    return Err[bool](" compiler: " + context + " failed: " + srcPath)

@borrows
fn CompilerBridgeStageCopyOptional(rootDir: str,
                                     srcPath: str,
                                     destDir: str,
                                     logRel: str,
                                     context: str): Result[bool] =
    if !chengpath.PathFileExists(srcPath):
        return Ok[bool](true)
    return CompilerBridgeStageCopyRequired(rootDir, srcPath, destDir, logRel, context)

@borrows
fn CompilerBridgeRewriteStagedTree(rootDir: str,
                                     stageRoot: str): Result[bool] =
    if !chengpath.PathDirExists(stageRoot):
        return Err[bool](Fmt" compiler: missing bridge surface stage root: {stageRoot}")
    let files = os.WalkDirRec(stageRoot)
    for i in 0..<files.len:
        let path = files[i]
        if !strings.HasSuffix(path, ".cheng"):
            continue
        let sourceText = chengpath.ReadTextFile("", path)
        if len(sourceText) <= 0:
            continue
        var rewritten = ""
        var rewriteErr = ""
        if !CompilerBridgeRewriteSourceTextChecked(sourceText, rewritten, rewriteErr):
            return Err[bool](CompilerConcat3(" compiler: ", rewriteErr, ""))
        if rewritten == sourceText:
            continue
        if !chengpath.WriteTextFile("", path, rewritten):
            return Err[bool](Fmt" compiler: failed to rewrite staged source: {path}")
    return Ok[bool](true)

@borrows
fn CompilerBridgeRequestNeedsSurfaceRewrite(rootDir: str,
                                              req: creq.CompilerRequest): bool =
    var closure: str[]
    var err = ""
    if CompilerAppendOrdinaryClosure(creq.CompilerRequestRootDir(req),
                                       creq.CompilerRequestSourcePath(req),
                                       closure,
                                       err):
        for i in 0..<closure.len:
            let sourceText = chengpath.ReadTextFile("", closure[i])
            if CompilerBridgeSourceNeedsRewrite(sourceText):
                return true
        return false
    let entryText = chengpath.ReadTextFile("", creq.CompilerRequestSourcePath(req))
    return CompilerBridgeSourceNeedsRewrite(entryText)

fn CompilerArgsWithoutPathFlag(args: var str[],
                                 flagName: str): str[] =
    var out: str[]
    var i: int32
    while i < args.len:
        let arg = strutil.Strip(args[i])
        if arg == flagName:
            i = i + 2
            continue
        let colonPrefix = Fmt"{flagName}:"
        let equalsPrefix = Fmt"{flagName}="
        if strutil.StartsWith(arg, colonPrefix) || strutil.StartsWith(arg, equalsPrefix):
            i = i + 1
            continue
        let forwardedArg = Fmt"{args[i]}"
        add(out, forwardedArg)
        i = i + 1
    return out

fn CompilerArgsWithBridgeStagedRequest(args: var str[],
                                         stagedReq: creq.CompilerRequest): str[] =
    var out = CompilerArgsWithoutPathFlag(args, "--root")
    let nextOut = CompilerArgsWithoutPathFlag(out, "--in")
    out = nextOut
    add(out, Fmt"--root:{creq.CompilerRequestRootDir(stagedReq)}")
    add(out, Fmt"--in:{creq.CompilerRequestSourcePath(stagedReq)}")
    return out

@borrows
fn CompilerBridgeEntryRelativePath(
        compilerEntrySource: str,
        packagePrefix: str): str =
    let stripped = strutil.Strip(strings.CloneStr(compilerEntrySource))
    if strutil.StartsWith(stripped, packagePrefix):
        return strings.CloneStrRange(
            stripped,
            len(packagePrefix),
            len(stripped) - len(packagePrefix))
    return Fmt"{stripped}"

@borrows
fn CompilerBridgeSurfaceStageRequest(rootDir: str,
                                       req: creq.CompilerRequest): Result[creq.CompilerRequest] =
    let stageRoot = chengpath.PathAbsolute(rootDir, CompilerBridgeSurfaceStageRoot())
    if chengpath.PathDirExists(stageRoot) || chengpath.PathFileExists(stageRoot):
        let _resetBridgeSurfaceStage = CompilerRemovePathTree(strings.CloneStr(stageRoot))
    let _prepareBridgeSurfaceStageRoot = chengpath.MkdirP(rootDir, stageRoot)
    let packageRoot = creq.CompilerRequestRootDir(req)
    let compilerEntrySource = creq.CompilerRequestSourcePath(req)
    let packageLeaf = os.ExtractFilename(strings.CloneStr(packageRoot))
    if len(packageLeaf) <= 0:
        return Err[creq.CompilerRequest](Fmt" compiler: invalid bridge surface package root: {packageRoot}")
    let stagedPackageRoot = os.JoinPath(stageRoot, packageLeaf)
    let packagePrefix = Fmt"{packageRoot}/"
    let entryRel =
        CompilerBridgeEntryRelativePath(
            compilerEntrySource, packagePrefix)
    if len(entryRel) <= 0 ||
       strutil.StartsWith(entryRel, "/") ||
       strutil.StartsWith(entryRel, ".."):
        return Err[creq.CompilerRequest](Fmt" compiler: bridge surface entry is outside package root: {compilerEntrySource}")
    let _prepareBridgeSurfacePackageRoot = chengpath.MkdirP(rootDir, stagedPackageRoot)
    let manifestCopyRes = CompilerBridgeStageCopyRequired(rootDir,
                                                            os.JoinPath(packageRoot, "cheng-package.toml"),
                                                            stagedPackageRoot,
                                                            "artifacts/backend_driver/bridge_surface.manifest.copy.log",
                                                            "bridge_surface_stage_manifest")
    if IsErr(manifestCopyRes):
        return Err[creq.CompilerRequest](Error(manifestCopyRes))
    let lockCopyRes = CompilerBridgeStageCopyOptional(rootDir,
                                                        os.JoinPath(packageRoot, "cheng.lock.toml"),
                                                        stagedPackageRoot,
                                                        "artifacts/backend_driver/bridge_surface.lock.copy.log",
                                                        "bridge_surface_stage_lock")
    if IsErr(lockCopyRes):
        return Err[creq.CompilerRequest](Error(lockCopyRes))
    let srcCopyRes = CompilerBridgeStageCopyRequired(rootDir,
                                                       os.JoinPath(packageRoot, "src"),
                                                       stagedPackageRoot,
                                                       "artifacts/backend_driver/bridge_surface.src.copy.log",
                                                       "bridge_surface_stage_src")
    if IsErr(srcCopyRes):
        return Err[creq.CompilerRequest](Error(srcCopyRes))
    let workspaceRoot = parser.ParserWorkspaceRoot(packageRoot)
    if workspaceRoot != "" && workspaceRoot != packageRoot:
        let workspaceSrc = os.JoinPath(workspaceRoot, "src")
        if !chengpath.PathDirExists(workspaceSrc):
            return Err[creq.CompilerRequest](Fmt" compiler: missing bridge surface shared workspace src: {workspaceSrc}")
        let workspaceCopyRes = CompilerBridgeStageCopyRequired(rootDir,
                                                                 workspaceSrc,
                                                                 stageRoot,
                                                                 "artifacts/backend_driver/bridge_surface.workspace_src.copy.log",
                                                                 "bridge_surface_stage_workspace_src")
        if IsErr(workspaceCopyRes):
            return Err[creq.CompilerRequest](Error(workspaceCopyRes))
    let rewriteRes = CompilerBridgeRewriteStagedTree(rootDir, stageRoot)
    if IsErr(rewriteRes):
        return Err[creq.CompilerRequest](Error(rewriteRes))
    let stagedEntry = os.JoinPath(stagedPackageRoot, entryRel)
    if !chengpath.PathFileExists(stagedEntry):
        return Err[creq.CompilerRequest](Fmt" compiler: missing staged bridge surface entry source: {stagedEntry}")
    let stagedReq0 = creq.CompilerRequestNew(stagedPackageRoot,
                                               stagedEntry,
                                               strings.CloneStr(
                                                   creq.CompilerRequestOutputPath(req)),
                                               strings.CloneStr(
                                                   creq.CompilerRequestTargetTriple(req)),
                                               creq.CompilerRequestEmitKind(req),
                                               strings.CloneStr(req.reportPath))
    let stagedReq1 = creq.CompilerRequestWithSymbolVisibility(
        stagedReq0,
        strings.CloneStr(creq.CompilerRequestSymbolVisibility(req)))
    let stagedReq = creq.CompilerRequestWithBrowserBridgeObject(
        stagedReq1,
        strings.CloneStr(creq.CompilerRequestBrowserBridgeObjectPath(req)))
    return Ok[creq.CompilerRequest](stagedReq)

@borrows
fn CompilerWorldBundleSourcePaths(
        bundle: cwbundle.CompilerWorldBundle,
        outPackageRoot: var str,
        outCompilerEntrySource: var str): Result[bool] =
    let sourceRoot = os.JoinPath(os.ParentDir(bundle.bundlePrefix), "source")
    if !chengpath.PathDirExists(sourceRoot):
        return Err[bool](
            " compiler: verified world bundle source tree is missing")
    var entryRelativePath: str
    let entryPathRes = cwlp.CompilerWorldManagedMirrorSourceRelativePath(
        bundle.compilerMirrorBundle.packageId,
        bundle.evidence.entryModulePath,
        entryRelativePath)
    if IsErr(entryPathRes):
        return Err[bool](Error(entryPathRes))
    let entryPath = os.JoinPath(sourceRoot, entryRelativePath)
    if !chengpath.PathFileExists(
            os.JoinPath(sourceRoot, "cheng-package.toml")) ||
       !chengpath.PathFileExists(
            os.JoinPath(sourceRoot, "sources.list.txt")) ||
       !chengpath.PathFileExists(entryPath):
        return Err[bool](
            " compiler: verified world bundle source identity is incomplete")
    outPackageRoot = sourceRoot
    outCompilerEntrySource = entryPath
    return Ok[bool](true)

@borrows
fn CompilerFollowWorldInstallBackendDriver(rootDir: str,
                                             packageRoot: str,
                                             compilerEntrySource: str,
                                             targetTriple: str,
                                             requestedWorldHeadHex: str,
                                             lockPath: str,
                                             channel: str,
                                             expectedReceipt: ccsg.CompileReceipt,
                                             enforceExpectedReceipt: bool): Result[CompilerFollowInstallResult] =
    let backendDriverOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng")
    let backendDriverMapOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng.map")
    let backendDriverCandidateOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng.follow.next")
    let backendDriverCandidateMapOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng.follow.next.map")
    let backendDriverCandidateBuildOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng_follow_candidate")
    let backendDriverCandidateBuildMapOut = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/cheng_follow_candidate.map")
    let compileReportPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/follow_world.compile.report.txt")
    let compileLogPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/follow_world.compile.log")
    let receiptLogPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/follow_world.receipt.log")
    let statusLogPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/follow_world.status.txt")
    let verifyLogPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/follow_world.verify_world.txt")
    let installLogPath = chengpath.PathAbsolute(rootDir, "artifacts/backend_driver/follow_world.install.txt")
    let followMaxRssBytesText: str = CompilerFollowWorldMaxRssBytesText()
    let followMaxRssEnv = "CHENG_PROCESS_MAX_RSS_BYTES=" + strings.CloneStr(followMaxRssBytesText)
    os.SetEnv("CHENG_PROGRESS", "1")
    os.SetEnv("CHENG_PROCESS_MAX_RSS_BYTES", followMaxRssBytesText)
    let followGuardEnv: str[] = [
        "CHENG_NO_BACKEND_DRIVER_HANDOFF=1",
        "CHENG_PROGRESS=1",
        followMaxRssEnv,
        "BACKEND_INCREMENTAL=0",
        "BACKEND_MULTI_MODULE_CACHE=0",
        "CHENG_DISABLE_PRIMARY_OBJECT_CACHE=1",
        "BACKEND_BUILD_DRIVER_QUICK_STAMP_CACHE=0",
        "BACKEND_BUILD_DRIVER_QUICK_SHARED_CACHE=0"
    ]
    let stagedPackageRoot = share(packageRoot)
    let stagedCompilerEntrySource = share(compilerEntrySource)
    var installReq = creq.CompilerRequestNew(stagedPackageRoot,
                                               stagedCompilerEntrySource,
                                               backendDriverCandidateBuildOut,
                                               targetTriple,
                                               creq.EmitExe,
                                               "")
    creq.CompilerRequestSeal(installReq)
    var targetReceiptCid = expectedReceipt.receiptCid
    if !enforceExpectedReceipt:
        let installPlanRes = CompilerCanonicalSystemLinkExecPlan(
            rootDir,
            installReq,
            requestedWorldHeadHex,
            lockPath,
            "",
            channel)
        if IsErr(installPlanRes):
            return Err[CompilerFollowInstallResult](Fmt" compiler: follow-world install plan failed: {Error(installPlanRes)}")
        let installPlan = Value(installPlanRes)
        targetReceiptCid = installPlan.compileReceipt.receiptCid
    var currentCompiler = CompilerCurrentExecutablePath(rootDir)
    if len(currentCompiler) > 0 && !chengpath.FileExistsNonEmpty(rootDir, currentCompiler):
        currentCompiler = ""
    if len(currentCompiler) <= 0:
        currentCompiler = CompilerBridgeCompilerPath(rootDir)
    if len(currentCompiler) <= 0:
        return Err[CompilerFollowInstallResult](" compiler: missing live Cheng bridge for follow-world")
    if chengpath.PathFileExists(backendDriverCandidateBuildOut):
        let _ = os.RemoveFile(backendDriverCandidateBuildOut)
    if chengpath.PathFileExists(backendDriverCandidateBuildMapOut):
        let _ = os.RemoveFile(backendDriverCandidateBuildMapOut)
    if chengpath.PathFileExists(backendDriverCandidateOut):
        let _ = os.RemoveFile(backendDriverCandidateOut)
    if chengpath.PathFileExists(backendDriverCandidateMapOut):
        let _ = os.RemoveFile(backendDriverCandidateMapOut)
    let compileArgs = [
        "system-link-exec",
        Fmt"--root:{stagedPackageRoot}",
        Fmt"--in:{stagedCompilerEntrySource}",
        "--emit:exe",
        Fmt"--target:{targetTriple}",
        Fmt"--out:{backendDriverCandidateBuildOut}",
        Fmt"--world-head:{requestedWorldHeadHex}",
        Fmt"--lock:{lockPath}",
        Fmt"--channel:{channel}"
    ]
    if !CompilerRunFileEnvLogged(rootDir,
                                   currentCompiler,
                                   compileArgs,
                                   followGuardEnv,
                                   compileLogPath,
                                   "follow-world compile"):
        return Err[CompilerFollowInstallResult](" compiler: follow-world compile failed")
    if chengpath.PathFileExists(compileReportPath):
        let _ = os.RemoveFile(compileReportPath)
    let receiptArgs = [
        "world-receipt",
        Fmt"--root:{stagedPackageRoot}",
        Fmt"--in:{stagedCompilerEntrySource}",
        "--emit:exe",
        Fmt"--target:{targetTriple}",
        Fmt"--out:{backendDriverCandidateBuildOut}",
        Fmt"--report-out:{compileReportPath}",
        Fmt"--world-head:{requestedWorldHeadHex}",
        Fmt"--lock:{lockPath}",
        Fmt"--channel:{channel}"
    ]
    if !CompilerRunFileEnvLogged(rootDir,
                                   currentCompiler,
                                   receiptArgs,
                                   followGuardEnv,
                                   receiptLogPath,
                                   "follow-world receipt"):
        return Err[CompilerFollowInstallResult](" compiler: follow-world receipt failed")
    if !chengpath.PathFileExists(backendDriverCandidateBuildOut):
        return Err[CompilerFollowInstallResult](Fmt" compiler: missing follow-world backend driver candidate: {backendDriverCandidateBuildOut}")
    if !chengpath.PathFileExists(backendDriverCandidateBuildMapOut):
        return Err[CompilerFollowInstallResult](Fmt" compiler: missing follow-world backend driver candidate map: {backendDriverCandidateBuildMapOut}")
    if !os.RenameFile(backendDriverCandidateBuildMapOut, backendDriverCandidateMapOut):
        return Err[CompilerFollowInstallResult](Fmt" compiler: failed to stage follow-world backend driver candidate map: {backendDriverCandidateMapOut}")
    if !os.RenameFile(backendDriverCandidateBuildOut, backendDriverCandidateOut):
        return Err[CompilerFollowInstallResult](Fmt" compiler: failed to stage follow-world backend driver candidate output: {backendDriverCandidateOut}")
    if !CompilerRunFileEnvLogged(rootDir,
                                   backendDriverCandidateOut,
                                   ["status"],
                                   followGuardEnv,
                                   statusLogPath,
                                   "follow-world status"):
        return Err[CompilerFollowInstallResult](" compiler: follow-world status failed")
    let verifyArgs = [
        "verify-world",
        Fmt"--root:{stagedPackageRoot}",
        Fmt"--in:{stagedCompilerEntrySource}",
        Fmt"--target:{targetTriple}",
        Fmt"--world-head:{requestedWorldHeadHex}",
        Fmt"--lock:{lockPath}",
        Fmt"--channel:{channel}"
    ]
    if !CompilerRunFileEnvLogged(rootDir,
                                   backendDriverCandidateOut,
                                   verifyArgs,
                                   followGuardEnv,
                                   verifyLogPath,
                                   "follow-world verify-world"):
        return Err[CompilerFollowInstallResult](" compiler: follow-world verify-world failed")
    let compileReportText = chengpath.ReadTextFile("", compileReportPath)
    var candidateReceipt: ccsg.CompileReceipt
    let candidateReceiptRes = ccsg.CompileReceiptFromReportText(
        compileReportText,
        candidateReceipt)
    var candidateReceiptErr: str
    if IsErr(candidateReceiptRes) ||
       !ccsg.CompileReceiptStrictValidateInto(candidateReceipt,
                                               candidateReceiptErr) ||
       ccsg.CompileReceiptReport(candidateReceipt) != compileReportText:
        if IsErr(candidateReceiptRes):
            return Err[CompilerFollowInstallResult](Error(candidateReceiptRes))
        return Err[CompilerFollowInstallResult](strutil.Join([
            " compiler: follow-world invalid exact candidate compile receipt: ",
            candidateReceiptErr
        ], ""))
    if !layout.FixedBytes32Equal(candidateReceipt.receiptCid,
                                 targetReceiptCid):
        return Err[CompilerFollowInstallResult](" compiler: follow-world backend driver receipt drift")
    var installReport = ""
    if !CompilerBootstrapInstallCandidate(rootDir,
                                            backendDriverCandidateMapOut,
                                            backendDriverMapOut,
                                            installLogPath,
                                            "map",
                                            installReport):
        return Err[CompilerFollowInstallResult](Fmt" compiler: failed to install follow-world backend driver map: {backendDriverMapOut}")
    if !CompilerBootstrapInstallCandidate(rootDir,
                                            backendDriverCandidateOut,
                                            backendDriverOut,
                                            installLogPath,
                                            "binary",
                                            installReport):
        return Err[CompilerFollowInstallResult](Fmt" compiler: failed to install follow-world backend driver output: {backendDriverOut}")
    var out: CompilerFollowInstallResult
    out.backendDriverPath = backendDriverOut
    out.targetReceiptCid = targetReceiptCid
    out.candidateReceiptCid = candidateReceipt.receiptCid
    return Ok[CompilerFollowInstallResult](out)

@borrows
fn CompilerFollowWorldOfflineLockPath(rootDir: str,
                                        bundle: var cwbundle.CompilerWorldBundle,
                                        outLockPath: var str): Result[bool] =
    let lockPathRaw = strutil.Strip(cmdline.ReadFlagOrDefault("--lock", ""))
    if len(lockPathRaw) <= 0:
        let ownedLockPath = Fmt"{bundle.bundlePrefix}.lock.toml"
        outLockPath = ownedLockPath
        return Ok[bool](true)
    let lockRes = cworld.CompilerLockSnapshotRead(rootDir, lockPathRaw)
    if IsErr(lockRes):
        return Err[bool](Error(lockRes))
    let verifyRes = cworld.CompilerWorldVerifyLock(cwbundle.CompilerWorldBundleUniverse(bundle),
                                                     Value(lockRes))
    if IsErr(verifyRes):
        return Err[bool](Fmt" compiler: follow-world provided lock mismatches bundle: {Error(verifyRes)}")
    outLockPath = chengpath.PathAbsolute(rootDir, lockPathRaw)
    return Ok[bool](true)

@borrows
fn CompilerFollowWorldOfflineSummary(bundle: cwbundle.CompilerWorldBundle,
                                       managedMirrorCount: int32,
                                       install: CompilerFollowInstallResult,
                                       targetTriple: str): str =
    var out = ""
    CompilerAppendOwnedText(out, "follow_mode=offline_bundle\n")
    CompilerAppendOwnedText(out, Fmt"bundle_prefix={bundle.bundlePrefix}\n")
    CompilerAppendOwnedText(out, Fmt"channel={bundle.worldHead.channel}\n")
    CompilerAppendOwnedText(out, "world_head_cid=" + layout.FixedBytes32Hex(bundle.worldHead.headCid) + "\n")
    CompilerAppendOwnedText(out, "manifest_root_cid=" + layout.FixedBytes32Hex(bundle.manifest.manifestCid) + "\n")
    CompilerAppendOwnedText(out, "manifest_entry_count=" + IntToStr(bundle.manifest.entryCount) + "\n")
    CompilerAppendOwnedText(out, "managed_mirror_count=" + IntToStr(managedMirrorCount) + "\n")
    CompilerAppendOwnedText(out, "receipt_cid=" + layout.FixedBytes32Hex(bundle.receipt.receiptCid) + "\n")
    CompilerAppendOwnedText(out, "follow_target=" + targetTriple + "\n")
    CompilerAppendOwnedText(out, Fmt"follow_backend_driver={install.backendDriverPath}\n")
    CompilerAppendOwnedText(out, "follow_target_receipt_cid=" + layout.FixedBytes32Hex(install.targetReceiptCid) + "\n")
    CompilerAppendOwnedText(out, "follow_candidate_receipt_cid=" + layout.FixedBytes32Hex(install.candidateReceiptCid) + "\n")
    CompilerAppendOwnedText(out, "follow_candidate_receipt_match=1\n")
    CompilerAppendOwnedText(out, "follow_candidate_status=ok\n")
    CompilerAppendOwnedText(out, "follow_candidate_verify_world=ok\n")
    CompilerAppendOwnedText(out, "follow_install=ok")
    return out

@borrows
fn CompilerFollowWorldTargetTriple(
        requestedTarget: str,
        bundle: cwbundle.CompilerWorldBundle): str =
    if len(requestedTarget) > 0:
        return Fmt"{requestedTarget}"
    return Fmt"{bundle.receipt.targetTriple}"

@borrows
fn CompilerFollowWorldOffline(rootDir: str): int32 =
    let bundlePrefix = strutil.Strip(cmdline.ReadFlagOrDefault("--bundle-prefix", ""))
    if len(bundlePrefix) <= 0:
        CompilerPrintErr(" compiler: missing --bundle-prefix")
        return 2
    var bundle: cwbundle.CompilerWorldBundle
    let bundleRes = cwbundle.CompilerWorldBundleReadAndVerify(rootDir, bundlePrefix, bundle)
    if IsErr(bundleRes):
        CompilerPrintErr(Error(bundleRes))
        return 2
    let requestedChannelRaw = strutil.Strip(cmdline.ReadFlagOrDefault("--channel", ""))
    if len(requestedChannelRaw) > 0:
        let requestedChannelRes = cworld.CompilerWorldNormalizeChannel(requestedChannelRaw)
        if IsErr(requestedChannelRes):
            CompilerPrintErr(Error(requestedChannelRes))
            return 2
        if Value(requestedChannelRes) != bundle.worldHead.channel:
            CompilerPrintErr(" compiler: follow-world bundle channel mismatch")
            return 2
    let worldHeadMatchRes = cworld.CompilerWorldHeadMatchesHex(bundle.worldHead,
                                                                 strutil.Strip(cmdline.ReadFlagOrDefault("--world-head", "")))
    if IsErr(worldHeadMatchRes):
        CompilerPrintErr(Error(worldHeadMatchRes))
        return 2
    let requestedTarget =
        strutil.Strip(cmdline.ReadFlagOrDefault("--target", ""))
    let targetTriple =
        CompilerFollowWorldTargetTriple(requestedTarget, bundle)
    if len(targetTriple) <= 0:
        CompilerPrintErr(" compiler: follow-world bundle target missing")
        return 2
    if targetTriple != bundle.receipt.targetTriple:
        CompilerPrintErr(" compiler: follow-world bundle target mismatch")
        return 2
    var lockPath = ""
    let lockPathRes = CompilerFollowWorldOfflineLockPath(rootDir, bundle, lockPath)
    if IsErr(lockPathRes):
        CompilerPrintErr(Error(lockPathRes))
        return 2
    let materializeRes = cwlp.CompilerWorldMaterializeManagedMirrorBundles(
        rootDir,
        bundle.manifest,
        bundle.managedDependencyReceipt,
        bundle.managedMirrorBundles)
    if IsErr(materializeRes):
        CompilerPrintErr(Error(materializeRes))
        return 2
    var packageRoot = ""
    var compilerEntrySource = ""
    let sourcePathsRes = CompilerWorldBundleSourcePaths(bundle,
                                                          packageRoot,
                                                          compilerEntrySource)
    if IsErr(sourcePathsRes):
        CompilerPrintErr(Error(sourcePathsRes))
        return 2
    let installRes = CompilerFollowWorldInstallBackendDriver(rootDir,
                                                               packageRoot,
                                                               compilerEntrySource,
                                                               targetTriple,
                                                               layout.FixedBytes32Hex(bundle.worldHead.headCid),
                                                               lockPath,
                                                               bundle.worldHead.channel,
                                                               bundle.receipt,
                                                               true)
    if IsErr(installRes):
        CompilerPrintErr(Error(installRes))
        return 2
    let summary = CompilerFollowWorldOfflineSummary(bundle,
                                                      Value(materializeRes),
                                                      Value(installRes),
                                                      targetTriple)
    let reportPath = cmdline.ReadFlagOrDefault("--report-out", "")
    if !CompilerWriteOptionalReport(rootDir, reportPath, summary):
        CompilerPrintErr(Fmt" compiler: failed to write report: {reportPath}")
        return 2
    CompilerPrintLine(summary)
    return 0

@borrows
fn CompilerFollowWorld(rootDir: str,
                         args: str[]): int32 =
    let bundlePrefix = strutil.Strip(
        cmdline.ReadFlagOrDefault("--bundle-prefix", ""))
    if bundlePrefix != "":
        return CompilerFollowWorldOffline(rootDir)
    return CompilerPublishWorld(rootDir, args)

@borrows
fn CompilerSelfhostBuild(rootDir: str,
                           args: str[]): int32 =
    let reqRes = CompilerRequestFromRuntimeFlags(rootDir, true)
    if IsErr(reqRes):
        CompilerPrintErr(Error(reqRes))
        return 2
    var req = Value(reqRes)
    var canonicalArgs: str[]
    for i in 0..<args.len:
        add(canonicalArgs, strings.CloneStr(args[i]))
    return CompilerRunSystemLinkExec(
        rootDir,
        req,
        canonicalArgs)

@borrows
fn CompilerTextEndsWith(text: str, suffix: str): bool =
    if len(suffix) > len(text):
        return false
    let start = len(text) - len(suffix)
    for i in 0..<len(suffix):
        if text[start + i] != suffix[i]:
            return false
    return true

@borrows
fn CompilerOutputContains(text: str, needle: str): bool =
    return strutil.Contains(text, needle)

@borrows
fn CompilerRequireOutput(run: hostops.LoggedRun,
                           needle: str,
                           label: str): bool =
    if CompilerOutputContains(run.output, needle):
        return true
    CompilerPrintErr(Fmt"{label}: missing output: {needle}")
    return false

@borrows
fn CompilerLoggedRunFailed(run: hostops.LoggedRun): bool =
    if hostops.LoggedRunOk(run):
        return false
    CompilerPrintErr(hostops.LoggedRunSummary(run))
    let outputText = strutil.Strip(run.output)
    if len(outputText) > 0:
        CompilerPrintErr(outputText)
    return true

@borrows
fn CompilerEnsureFileParentDir(rootDir: str, path: str): bool =
    let parts = os.SplitFile(path)
    if len(parts.dir) <= 0:
        return true
    return chengpath.MkdirP(rootDir, parts.dir)

@borrows
fn CompilerBackendDriverPath(rootDir: str): str =
    let snapshot = contracts.BootstrapSnapshotDefault(rootDir)
    return snapshot.backendDriverOut.path

@borrows
fn CompilerEnsureBackendDriverPath(rootDir: str,
                                     context: str,
                                     outCompiler: var str): bool =
    outCompiler = CompilerBackendDriverPath(rootDir)
    if chengpath.FileExistsNonEmpty(rootDir, outCompiler):
        return true
    if !CompilerEnsureBackendDriver(rootDir, context):
        return false
    return chengpath.FileExistsNonEmpty(rootDir, outCompiler)

fn CompilerCompileTimeoutSec(): int32 =
    return 300

fn CompilerCommandText(filePath: str,
                         argv: var str[],
                         envOverrides: var str[]): str =
    var parts: str[]
    if envOverrides.len > 0:
        add(parts, "env")
        for i in 0..<envOverrides.len:
            let envText = Fmt"{envOverrides[i]}"
            if len(envText) > 0:
                add(parts, CompilerQuoteShell(envText))
    if len(filePath) > 0:
        add(parts, CompilerQuoteShell(filePath))
    for i in 0..<argv.len:
        add(parts, CompilerQuoteShell(argv[i]))
    return strutil.Join(parts, " ")

@borrows
fn CompilerRunCommandCaptureLogged(rootDir: str,
                                     label: str,
                                     filePath: str,
                                     command: str,
                                     logPath: str): hostops.LoggedRun =
    let _ = CompilerEnsureFileParentDir(rootDir, logPath)
    let fullCommand = command + " > " + CompilerQuoteShell(logPath) + " 2>&1"
    let exitCode = os.ExecShellCmdStatus(fullCommand, rootDir)
    let outputText = chengpath.ReadTextFile("", logPath)
    let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
    return hostops.LoggedRunZero(label, filePath, logPath, exitCode, outputText)

@borrows
fn CompilerRunFileLoggedEnv(rootDir: str,
                              label: str,
                              filePath: str,
                              argv: str[],
                              envOverrides: str[],
                              timeoutSec: int32,
                              logPath: str): hostops.LoggedRun =
    let _ = CompilerEnsureFileParentDir(rootDir, logPath)
    let filePathAbs = chengpath.PathAbsolute(rootDir, filePath)
    if !chengpath.FileExistsNonEmpty(rootDir, filePathAbs):
        let missingText = hostops.HostOpsMissingExecutableText(filePathAbs)
        let _logged = chengpath.WriteTextFile(rootDir, logPath, missingText)
        return hostops.LoggedRunZero(label, filePathAbs, logPath, 127, missingText)
    return hostops.RunFileLogged(rootDir,
                                   label,
                                   filePathAbs,
                                   argv,
                                   envOverrides,
                                   rootDir,
                                   timeoutSec,
                                   logPath)

@borrows
fn CompilerCompileExeEnv(rootDir: str,
                           label: str,
                           compilerPath: str,
                           packageRoot: str,
                           sourcePath: str,
                           outPath: str,
                           target: str,
                           logPath: str,
                           envOverrides: str[]): hostops.LoggedRun =
    let compilerAbs = chengpath.PathAbsolute(rootDir, compilerPath)
    let _ = CompilerEnsureFileParentDir(rootDir, outPath)
    let _ = CompilerEnsureFileParentDir(rootDir, logPath)
    let run = CompilerRunFileLoggedEnv(rootDir,
                                         label,
                                         compilerAbs,
                                         [
                                             "system-link-exec",
                                             "--root", share(packageRoot),
                                             "--in", share(sourcePath),
                                             "--emit", "exe",
                                             "--target", share(target),
                                             "--out", share(outPath)
                                         ],
                                         envOverrides,
                                         CompilerCompileTimeoutSec(),
                                         logPath)
    if hostops.LoggedRunOk(run) && !os.FileExists(outPath):
        let outputText = Fmt"{run.output} compiler: compile missing output: {outPath}\n"
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, compilerAbs, logPath, 1, outputText)
    return run

@borrows
fn CompilerCompileExe(rootDir: str,
                        label: str,
                        compilerPath: str,
                        packageRoot: str,
                        sourcePath: str,
                        outPath: str,
                        target: str,
                        logPath: str): hostops.LoggedRun =
    return CompilerCompileExeEnv(rootDir,
                                   label,
                                   compilerPath,
                                   packageRoot,
                                   sourcePath,
                                   outPath,
                                   target,
                                   logPath,
                                   [])

@borrows
fn CompilerProviderSourcesAllPureCheng(paths: str[]): bool =
    if paths.len <= 0:
        return false
    for i in 0..<paths.len:
        if !CompilerTextEndsWith(paths[i], ".cheng"):
            return false
    return true

@borrows
fn CompilerProviderSourcesContain(paths: str[], expected: str): bool =
    for i in 0..<paths.len:
        if paths[i] == expected:
            return true
    return false

@borrows
fn CompilerProviderSourcesLeakLinuxForDarwin(target: str,
                                              paths: str[]): bool =
    if !tmat.TargetIsDarwin(target):
        return false
    for i in 0..<paths.len:
        if strutil.Contains(paths[i], "core_runtime_provider_linux.cheng") ||
           strutil.Contains(paths[i], "system_helpers_backend_nolibc_linux_aarch64.cheng"):
            return true
    return false

@borrows
fn CompilerVerifyPureChengProviderPlan(rootDir: str,
                                         packageRoot: str,
                                         sourcePath: str,
                                         outputPath: str,
                                         target: str,
                                         expectedSources: str[]): bool =
    var req = creq.CompilerRequestNew(Fmt"{packageRoot}",
                                        Fmt"{sourcePath}",
                                        Fmt"{outputPath}",
                                        Fmt"{target}",
                                        creq.EmitExe,
                                        "")
    creq.CompilerRequestSeal(req)
    let planRes = CompilerCanonicalSystemLinkExecPlan(
        rootDir, req, "", "", "", "stable")
    if IsErr(planRes):
        CompilerPrintErr(Fmt" pure provider plan: {Error(planRes)}")
        return false
    let plan = Value(planRes)
    if !CompilerProviderSourcesAllPureCheng(plan.objectPlan.providerSourcePaths):
        CompilerPrintErr(" pure provider plan: non-Cheng provider source detected")
        return false
    if CompilerProviderSourcesLeakLinuxForDarwin(target, plan.objectPlan.providerSourcePaths):
        CompilerPrintErr(" pure provider plan: Darwin target selected Linux provider source")
        return false
    for i in 0..<expectedSources.len:
        if !CompilerProviderSourcesContain(plan.objectPlan.providerSourcePaths, expectedSources[i]):
            CompilerPrintErr(Fmt" pure provider plan: missing provider source: {expectedSources[i]}")
            return false
    return true

fn CompilerHostTarget(): str =
    let detected = contracts.BootstrapDetectHostTarget()
    if detected == "arm64-apple-darwin" ||
       detected == "x86_64-apple-darwin" ||
       detected == "x86_64-unknown-linux-gnu" ||
       detected == "aarch64-unknown-linux-gnu":
        return detected
    return ""

@borrows
fn CompilerBuildPanicTrace(rootDir: str): int32 =
    var compiler = ""
    if !CompilerEnsureBackendDriverPath(rootDir, "verify-debug-runtime panic", compiler):
        return 1
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/panic_trace")
    let packageRoot = share(rootDir)
    let src = chengpath.PathAbsolute(rootDir, "src/tests/ordinary_panic_fixture.cheng")
    let outBin = os.JoinPath(outDir, "ordinary_panic_fixture")
    let reportPath = os.JoinPath(outDir, "ordinary_panic_fixture.report.txt")
    let compileRun = CompilerCompileExe(rootDir,
                                          "build_panic_trace",
                                          compiler,
                                          packageRoot,
                                          src,
                                          outBin,
                                          "arm64-apple-darwin",
                                          "artifacts/panic_trace/ordinary_panic_fixture.compile.log")
    if CompilerLoggedRunFailed(compileRun):
        return compileRun.exitCode
    let lineMap = Fmt"{outBin}.map"
    if !os.FileExists(lineMap):
        CompilerPrintErr(" panic-trace: missing line-map sidecar")
        return 1
    let lineMapText = chengpath.ReadTextFile("", lineMap)
    if !strutil.StartsWith(lineMapText, "cheng_line_map\n") ||
       !CompilerOutputContains(lineMapText, "ordinary_panic_fixture.cheng") ||
       !linemap.LineMapTextHasRequiredDebugFields(lineMapText):
        CompilerPrintErr(" panic-trace: invalid line-map")
        return 1
    let run = CompilerRunFileLoggedEnv(rootDir,
                                         "build_panic_trace_run",
                                         outBin,
                                         [],
                                         [],
                                         20,
                                         "artifacts/panic_trace/ordinary_panic_fixture.run.log")
    let runText = strutil.Strip(run.output)
    if len(runText) > 0:
        CompilerPrintLine(runText)
    if run.exitCode == 0:
        CompilerPrintErr(" panic-trace: expected non-zero exit")
        return 1
    let transformRun = CompilerRunFileLoggedEnv(rootDir,
                                                  "build_panic_trace_report",
                                                  compiler,
                                                  [
                                                      "crash-report",
                                                      Fmt"--in:{run.logPath}",
                                                      Fmt"--out:{reportPath}"
                                                  ],
                                                  [],
                                                  20,
                                                  "artifacts/panic_trace/ordinary_panic_fixture.crash-report.log")
    if CompilerLoggedRunFailed(transformRun):
        return transformRun.exitCode
    if !os.FileExists(reportPath):
        CompilerPrintErr(" panic-trace: missing report")
        return 1
    let reportText = chengpath.ReadTextFile("", reportPath)
    if !CompilerRequireOutput(run, " panic fixture", " panic-trace") ||
       !CompilerRequireOutput(run, "cheng_crash_raw", " panic-trace") ||
       !CompilerRequireOutput(run, "reason=panic mode=backtrace", " panic-trace") ||
       !CompilerRequireOutput(run, "ordinary_panic_fixture.cheng:", " panic-trace") ||
       !CompilerOutputContains(reportText, "[cheng] cheng_crash_report") ||
       !CompilerOutputContains(reportText, "[cheng] reason=panic mode=backtrace") ||
       !CompilerOutputContains(reportText, "ordinary_panic_fixture.cheng:"):
        return 1
    CompilerPrintLine(strutil.Strip(reportText))
    return 0

@borrows
fn CompilerBuildBoundsTrace(rootDir: str): int32 =
    var compiler = ""
    if !CompilerEnsureBackendDriverPath(rootDir, "verify-debug-runtime bounds", compiler):
        return 1
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/bounds_trace")
    let packageRoot = share(rootDir)
    let src = chengpath.PathAbsolute(rootDir, "src/tests/ordinary_bounds_trace_fixture.cheng")
    let outBin = os.JoinPath(outDir, "ordinary_bounds_trace_fixture")
    let reportPath = os.JoinPath(outDir, "ordinary_bounds_trace_fixture.report.txt")
    let compileRun = CompilerCompileExe(rootDir,
                                          "build_bounds_trace",
                                          compiler,
                                          packageRoot,
                                          src,
                                          outBin,
                                          "arm64-apple-darwin",
                                          "artifacts/bounds_trace/ordinary_bounds_trace_fixture.compile.log")
    if CompilerLoggedRunFailed(compileRun):
        return compileRun.exitCode
    let outBinMapPath = Fmt"{outBin}.map"
    if !os.FileExists(outBinMapPath):
        CompilerPrintErr(" bounds-trace: missing line-map sidecar")
        return 1
    let run = CompilerRunFileLoggedEnv(rootDir,
                                         "build_bounds_trace_run",
                                         outBin,
                                         [],
                                         [],
                                         20,
                                         "artifacts/bounds_trace/ordinary_bounds_trace_fixture.run.log")
    let runText = strutil.Strip(run.output)
    if len(runText) > 0:
        CompilerPrintLine(runText)
    if run.exitCode == 0:
        CompilerPrintErr(" bounds-trace: expected non-zero exit")
        return 1
    let transformRun = CompilerRunFileLoggedEnv(rootDir,
                                                  "build_bounds_trace_report",
                                                  compiler,
                                                  [
                                                      "crash-report",
                                                      Fmt"--in:{run.logPath}",
                                                      Fmt"--out:{reportPath}"
                                                  ],
                                                  [],
                                                  20,
                                                  "artifacts/bounds_trace/ordinary_bounds_trace_fixture.crash-report.log")
    if CompilerLoggedRunFailed(transformRun):
        return transformRun.exitCode
    if !os.FileExists(reportPath):
        CompilerPrintErr(" bounds-trace: missing report")
        return 1
    let reportText = chengpath.ReadTextFile("", reportPath)
    if !CompilerRequireOutput(run, "bounds check failed", " bounds-trace") ||
       !CompilerRequireOutput(run, "cheng_crash_raw", " bounds-trace") ||
       !CompilerRequireOutput(run, "reason=bounds mode=backtrace", " bounds-trace") ||
       !CompilerRequireOutput(run, "ordinary_bounds_trace_fixture.cheng:", " bounds-trace") ||
       !CompilerOutputContains(reportText, "[cheng] cheng_crash_report") ||
       !CompilerOutputContains(reportText, "[cheng] reason=bounds mode=backtrace") ||
       !CompilerOutputContains(reportText, "ordinary_bounds_trace_fixture.cheng:"):
        return 1
    CompilerPrintLine(strutil.Strip(reportText))
    return 0

@borrows
fn CompilerBuildSignalTrace(rootDir: str): int32 =
    var compiler = ""
    if !CompilerEnsureBackendDriverPath(rootDir, "verify-debug-runtime signal", compiler):
        return 1
    let outDir = chengpath.PathAbsolute(rootDir, "artifacts/signal_trace")
    let packageRoot = share(rootDir)
    let src = chengpath.PathAbsolute(rootDir, "src/tests/ordinary_signal_trace_fixture.cheng")
    let outBin = os.JoinPath(outDir, "ordinary_signal_trace_fixture")
    let reportPath = os.JoinPath(outDir, "ordinary_signal_trace_fixture.report.txt")
    let compileRun = CompilerCompileExe(rootDir,
                                          "build_signal_trace",
                                          compiler,
                                          packageRoot,
                                          src,
                                          outBin,
                                          "arm64-apple-darwin",
                                          "artifacts/signal_trace/ordinary_signal_trace_fixture.compile.log")
    if CompilerLoggedRunFailed(compileRun):
        return compileRun.exitCode
    let outBinMapPath = Fmt"{outBin}.map"
    if !os.FileExists(outBinMapPath):
        CompilerPrintErr(" signal-trace: missing line-map sidecar")
        return 1
    let run = CompilerRunFileLoggedEnv(rootDir,
                                         "build_signal_trace_run",
                                         outBin,
                                         [],
                                         [],
                                         20,
                                         "artifacts/signal_trace/ordinary_signal_trace_fixture.run.log")
    let runText = strutil.Strip(run.output)
    if len(runText) > 0:
        CompilerPrintLine(runText)
    if run.exitCode == 0:
        CompilerPrintErr(" signal-trace: expected non-zero exit")
        return 1
    let transformRun = CompilerRunFileLoggedEnv(rootDir,
                                                  "build_signal_trace_report",
                                                  compiler,
                                                  [
                                                      "crash-report",
                                                      Fmt"--in:{run.logPath}",
                                                      Fmt"--out:{reportPath}"
                                                  ],
                                                  [],
                                                  20,
                                                  "artifacts/signal_trace/ordinary_signal_trace_fixture.crash-report.log")
    if CompilerLoggedRunFailed(transformRun):
        return transformRun.exitCode
    if !os.FileExists(reportPath):
        CompilerPrintErr(" signal-trace: missing report")
        return 1
    let reportText = chengpath.ReadTextFile("", reportPath)
    if !CompilerRequireOutput(run, "cheng_crash_raw", " signal-trace") ||
       !CompilerRequireOutput(run, "reason=signal mode=signal", " signal-trace") ||
       !CompilerRequireOutput(run, "ordinary_signal_trace_fixture.cheng:", " signal-trace") ||
       !CompilerOutputContains(reportText, "[cheng] cheng_crash_report") ||
       !CompilerOutputContains(reportText, "[cheng] reason=signal mode=signal") ||
       !CompilerOutputContains(reportText, "ordinary_signal_trace_fixture.cheng:"):
        return 1
    CompilerPrintLine(strutil.Strip(reportText))
    return 0

@borrows
fn CompilerVerifyDebugRuntime(rootDir: str): int32 =
    let hostTarget = CompilerHostTarget()
    if len(hostTarget) <= 0:
        CompilerPrintErr(" debug runtime: unsupported host target")
        return 1
    let packageRoot = share(rootDir)
    let ordinarySource = chengpath.PathAbsolute(rootDir, "src/tests/ordinary_panic_fixture.cheng")
    let toolingSource = chengpath.PathAbsolute(rootDir, "src/core/tooling/compiler_main.cheng")
    let ordinaryOutput = chengpath.PathAbsolute(rootDir, "artifacts/debug_runtime_verify/provider_plan_ordinary")
    let toolingOutput = chengpath.PathAbsolute(rootDir, "artifacts/debug_runtime_verify/provider_plan_tooling")
    var expectedCoreSource = ""
    if tmat.TargetIsDarwin(hostTarget):
        expectedCoreSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/core_runtime_provider_darwin.cheng")
    else:
        expectedCoreSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/core_runtime_provider_linux.cheng")
    let expectedDebugSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/debug_runtime_provider.cheng")
    let expectedProgramSupportSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_backend.cheng")
    let expectedProgramSupportGetEnvSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_get_env_bridge.cheng")
    let expectedProgramSupportHostSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/program_support_host_runtime.cheng")
    let expectedProgramArgvSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/compiler_runtime_program_entry_provider.cheng")
    let expectedToolingArgvSource = chengpath.PathAbsolute(rootDir, "src/core/runtime/compiler_runtime_tooling_entry_provider.cheng")
    var ordinarySources: str[]
    add(ordinarySources, expectedProgramArgvSource)
    add(ordinarySources, share(expectedCoreSource))
    add(ordinarySources, share(expectedDebugSource))
    add(ordinarySources, share(expectedProgramSupportSource))
    add(ordinarySources, share(expectedProgramSupportGetEnvSource))
    add(ordinarySources, share(expectedProgramSupportHostSource))
    if !CompilerVerifyPureChengProviderPlan(rootDir,
                                              packageRoot,
                                              ordinarySource,
                                              ordinaryOutput,
                                              hostTarget,
                                              ordinarySources):
        return 1
    var toolingSources: str[]
    add(toolingSources, expectedToolingArgvSource)
    add(toolingSources, expectedCoreSource)
    add(toolingSources, expectedDebugSource)
    add(toolingSources, expectedProgramSupportSource)
    add(toolingSources, expectedProgramSupportGetEnvSource)
    add(toolingSources, expectedProgramSupportHostSource)
    if !CompilerVerifyPureChengProviderPlan(rootDir,
                                              packageRoot,
                                              toolingSource,
                                              toolingOutput,
                                              hostTarget,
                                              toolingSources):
        return 1
    if CompilerBuildPanicTrace(rootDir) != 0:
        return 1
    if CompilerBuildBoundsTrace(rootDir) != 0:
        return 1
    if CompilerBuildSignalTrace(rootDir) != 0:
        return 1
    CompilerPrintLine(" debug runtime: ok")
    return 0

