# Generated from the unique current CsgCompilerSnapshotTables schema:
# 434 direct snapshot columns plus 15 declaration-table columns.
# [phaseB-enum-schema] +5: the enum variant payload CSR columns
# (variantStarts/variantCounts/variantNameTextIds/variantOrdinals/
# variantPayloadTypeIds) joined CsgCompilerTypeTable.
const CompilerSnapshotForLoweringCurrentSchemaSequenceFieldCount: int32 = 449
const compilerSnapshotLoweringBridgeMerklePolicyDomain: str =
    "cheng.compiler.snapshot_merkle.production_policy"
const compilerSnapshotLoweringBridgeMerkleStoreName: str =
    ".cheng-csg-core-soa-v1"
const compilerSnapshotLoweringBridgeCargoStorePrefix: str =
    ".cheng-csg-cargo-"
const compilerSnapshotLoweringBridgeEnvelopeStorePrefix: str =
    ".cheng-csg-envelope-"
const compilerSnapshotLoweringBridgeCompilerCsgArtifactDomain: str =
    "cheng.compiler.snapshot_lowering.compiler_csg_artifact"
const compilerSnapshotLoweringBridgeCargoObjectPathDomain: str =
    "cheng.compiler.snapshot_lowering.cargo_object.absolute_path.v1"
const compilerSnapshotLoweringBridgeCargoObjectReadDomain: str =
    "cheng.compiler.snapshot_lowering.cargo_object.stable_read.v1"
const compilerSnapshotLoweringBridgeCargoObjectReceiptDomain: str =
    "cheng.compiler.snapshot_lowering.cargo_object.receipt.v1"
const compilerSnapshotLoweringBridgeCanonicalEncoderModulePath: str =
    "src/core/backend/riscv64_encode.cheng"
const compilerSnapshotLoweringBridgeIssueReceiptDomain: str =
    "cheng.compiler.snapshot_lowering.issue_receipt"
const compilerSnapshotLoweringBridgeTextIdentityDomain: str =
    "cheng.compiler.snapshot_lowering.text_identity"

type
    compilerSnapshotLoweringBridgeIssueReceipt =
        ownerId: int32
        generation: int32
        workspaceRootCid: layout.FixedBytes32
        packageIdCid: layout.FixedBytes32
        targetTripleCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerExecutionCid: layout.FixedBytes32
        compilerPackageCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        sourceIdentityReceiptCid: layout.FixedBytes32
        graphCid: layout.FixedBytes32
        canonicalGraphCid: layout.FixedBytes32
        snapshotPredecessorReceiptCid: layout.FixedBytes32
        compilerCsgArtifactCid: layout.FixedBytes32
        storage:
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding
        admission: builder.CompilerSnapshotProductionAdmissionReceipt
        receiptCid: layout.FixedBytes32

    CompilerSnapshotLoweringAuthority =
        ownerId: int32
        generation: int32
        core: snapshot_authority.CompilerSnapshotLoweringAuthorityHandle
        issue: compilerSnapshotLoweringBridgeIssueReceipt

    CompilerSnapshotLoweringAuthorityCompilerCsgProjection =
        compilerCsgArtifactCid: layout.FixedBytes32
        graphCid: layout.FixedBytes32
        canonicalGraphCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        sourceIdentityReceiptCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        cargoFactsRootCid: layout.FixedBytes32
        cargoSchemaCid: layout.FixedBytes32
        cargoProfileSetCid: layout.FixedBytes32
        cargoProofCargoCid: layout.FixedBytes32
        cargoFactCount: int32
        cargoComplete: bool
        cargoStoreIdentityCid: layout.FixedBytes32
        cargoStoreHeadCid: layout.FixedBytes32
        cargoStoreManifestCid: layout.FixedBytes32
        cargoStoreReceiptCid: layout.FixedBytes32
        cargoStoreCsgcObjectCid: layout.FixedBytes32
        envelopeStoreIdentityCid: layout.FixedBytes32
        envelopeHeadCid: layout.FixedBytes32
        envelopeManifestCid: layout.FixedBytes32
        envelopeReceiptCid: layout.FixedBytes32
        envelopeMigrationReceiptCid: layout.FixedBytes32
        envelopeCsgcObjectCid: layout.FixedBytes32

    CompilerSnapshotLoweringAuthorityCanonicalSourceProjection =
        sourceRow: int32
        producerRow: int32
        modulePathTextId: int32
        documentCid: layout.FixedBytes32
        contentCid: layout.FixedBytes32
        interfaceCid: layout.FixedBytes32

    # Fixed-width evidence for the immutable Cargo object selected by the
    # lowering-authority SoA row.  authoritySlot/cargoObjectRow are the exact
    # registry row, never a path-derived or terminal merkle-owner identity.
    CompilerSnapshotLoweringAuthorityCargoObjectReceipt =
        authoritySlot: int32
        authorityGeneration: int32
        cargoObjectRow: int32
        storeGeneration: int64
        cargoStoreIdentityCid: layout.FixedBytes32
        beforeStoreIdentityCid: layout.FixedBytes32
        cargoHeadCid: layout.FixedBytes32
        cargoManifestCid: layout.FixedBytes32
        cargoStoreReceiptCid: layout.FixedBytes32
        cargoCsgcObjectCid: layout.FixedBytes32
        cargoAbsolutePathCid: layout.FixedBytes32
        cargoByteCount: int32
        cargoCid: layout.FixedBytes32
        factsRootCid: layout.FixedBytes32
        contentCid: layout.FixedBytes32
        beforeReadObservationCid: layout.FixedBytes32
        afterReadObservationCid: layout.FixedBytes32
        receiptCid: layout.FixedBytes32

    CompilerSnapshotForLoweringReleaseTally =
        releaseStorage: bool
        releasedSequenceFieldCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        unreleasedSequenceFieldCount: int32
        unreleasedBufferCount: int32

    CompilerSnapshotForLoweringReleaseReceipt =
        ownerToken: layout.FixedBytes32
        schemaVersion: int32
        semanticEpoch: int64
        predecessorReceiptCid: layout.FixedBytes32
        releasedSequenceFieldCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

    CompilerSnapshotForLoweringReleaseState =
        terminalOwnerToken: layout.FixedBytes32
        terminalSchemaVersion: int32
        terminalSemanticEpoch: int64
        terminalPredecessorReceiptCid: layout.FixedBytes32
        terminalReleasedSequenceFieldCount: int32
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        terminalStorageReleased: bool
        terminalReceiptConsumed: bool

    # Only this module can name or construct the store policy. The parent is
    # the canonical workspace already consumed by CompilerCSG; the store name
    # is fixed, and the expected HEAD is read from that store at issuance.
    compilerSnapshotLoweringBridgeMerklePolicy =
        admitted: bool
        parentPath: str
        storeName: str
        expectedHeadCid: str
        expectedManifestCid: str
        packageId: str
        worldHeadCid: layout.FixedBytes32
        executionCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        factsRootCid: layout.FixedBytes32
        factCount: int32
        bindingCid: str

    CsgCompilerSnapshotImmutableCargoStoreBinding =
        ok: bool
        error: str
        storeName: str
        storeIdentityCid: str
        headCid: str
        manifestCid: str
        receiptCid: str
        csgcObjectCid: str
        factsRoot: str
        dagRootCid: str
        generation: int64
        reused: bool

    CsgCompilerSnapshotLegacyMigrationInput =
        ok: bool
        error: str
        originKind: int32
        originCid: str
        legacyPresent: bool
        freshOrigin: bool
        inputCid: str
        legacyHeadCid: str
        legacyManifestCid: str
        legacyReceiptCid: str
        legacyCsgcObjectCid: str
        legacyFactsRoot: str
        legacyDagRootCid: str
        legacyGeneration: int64

    CsgCompilerSnapshotEnvelopeStoreReceipt =
        ok: bool
        error: str
        storeName: str
        storeIdentityCid: str
        migrationReceiptCid: str
        headCid: str
        manifestCid: str
        receiptCid: str
        requestCid: str
        planRoot: str
        generation: int64
        bootstrapApplied: bool
        operationCount: int32
        operationKind: int32

fn CsgCompilerSnapshotImmutableCargoStoreBindingRelease(
        binding: var CsgCompilerSnapshotImmutableCargoStoreBinding) =
    binding = CsgCompilerSnapshotImmutableCargoStoreBinding()

fn CsgCompilerSnapshotLegacyMigrationInputRelease(
        input: var CsgCompilerSnapshotLegacyMigrationInput) =
    input = CsgCompilerSnapshotLegacyMigrationInput()

fn CsgCompilerSnapshotEnvelopeStoreReceiptRelease(
        receipt: var CsgCompilerSnapshotEnvelopeStoreReceipt) =
    receipt = CsgCompilerSnapshotEnvelopeStoreReceipt()

@borrows
fn compilerSnapshotLoweringBridgeReadHeadOrAbsent(
        canonicalWorkspaceRoot: str,
        storeName: str): merkle_store.CsgCoreMerkleHeadReadResult =
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        canonicalWorkspaceRoot, storeName)
    if result.IsErr(opened):
        var failed: merkle_store.CsgCoreMerkleHeadReadResult
        failed.error = result.Error(opened)
        return failed
    let probe = result.Value(opened)
    let kind = probe.kind
    let closed = os.AtomicTreeClose(probe.tree)
    if result.IsErr(closed):
        var failed: merkle_store.CsgCoreMerkleHeadReadResult
        failed.error = result.Error(closed)
        return failed
    if kind == os.AtomicTreeExclusiveAbsent:
        var absent: merkle_store.CsgCoreMerkleHeadReadResult
        absent.ok = true
        absent.present = false
        return absent
    if kind != os.AtomicTreeExclusiveOpened:
        var failed: merkle_store.CsgCoreMerkleHeadReadResult
        failed.error =
            "compiler_snapshot_envelope_store_presence_kind_invalid"
        return failed
    return merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, storeName)

@borrows
fn compilerSnapshotLoweringBridgeCidLess(
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): bool =
    for byteIndex in 0..<layout.FixedBytes32Size:
        let leftByte = Int32(left.data[byteIndex]) & 255
        let rightByte = Int32(right.data[byteIndex]) & 255
        if leftByte < rightByte:
            return true
        if leftByte > rightByte:
            return false
    return false

@borrows
fn compilerSnapshotLoweringBridgeFail(message: str) =
    system.panicStr(message)

fn compilerSnapshotLoweringBridgeAbortIssued(
        authority: var CompilerSnapshotLoweringAuthority) =
    snapshot_authority.CompilerSnapshotLoweringAuthorityAbortIssued(
        authority.core)
    authority = CompilerSnapshotLoweringAuthority()

fn compilerSnapshotLoweringBridgeAbortPlanOwned(
        authority: var CompilerSnapshotLoweringAuthority) =
    snapshot_authority.CompilerSnapshotLoweringAuthorityAbortPlanOwned(
        authority.core)
    authority = CompilerSnapshotLoweringAuthority()

@borrows
fn CompilerSnapshotLoweringAuthorityCanonicalEmpty(
        authority: var CompilerSnapshotLoweringAuthority): bool =
    return authority.ownerId == 0 && authority.generation == 0 &&
        layout.FixedBytes32Equal(
            authority.issue.receiptCid, layout.FixedBytes32()) &&
        snapshot_authority.CompilerSnapshotLoweringAuthorityCanonicalEmpty(authority.core)

@borrows
fn CompilerSnapshotLoweringAuthorityStrictValidateInto(
        authority: CompilerSnapshotLoweringAuthority,
        err: var str): bool =
    if authority.ownerId != authority.core.ownerId ||
       authority.generation != authority.core.generation ||
       !compilerSnapshotLoweringBridgeIssueReceiptStrictValidateInto(
           authority.issue, err):
        if err.len == 0:
            err =
                " compiler snapshot lowering bridge: issue receipt rejected"
        return false
    return snapshot_authority.CompilerSnapshotLoweringAuthorityPlanOwnedStrictValidateInto(
            authority.core, err)

@borrows
fn CompilerSnapshotLoweringAuthorityCid(
        authority: var CompilerSnapshotLoweringAuthority):
        layout.FixedBytes32 =
    return snapshot_authority.CompilerSnapshotLoweringAuthorityIdentityCid(
        authority.core)

@borrows
fn CompilerSnapshotLoweringAuthorityFactsRootCid(
        authority: var CompilerSnapshotLoweringAuthority):
        layout.FixedBytes32 =
    return snapshot_authority.CompilerSnapshotLoweringAuthorityFactsRootCid(
        authority.core)

@borrows
fn CompilerSnapshotLoweringAuthorityCargoCid(
        authority: var CompilerSnapshotLoweringAuthority):
        layout.FixedBytes32 =
    return snapshot_authority.CompilerSnapshotLoweringAuthorityCargoCid(
        authority.core)

@borrows
fn compilerSnapshotLoweringBridgeCidTextInto(
        text: str,
        out: var layout.FixedBytes32): bool =
    out = layout.FixedBytes32()
    if !merkle_codec.CsgCoreMerkleStoreCidValid(text):
        return false
    let hexText = strings.CloneStrRange(text, 7, 64)
    let parsed = layout.FixedBytes32FromHex(hexText)
    if result.IsErr(parsed):
        return false
    out = result.Value(parsed)
    return layout.FixedBytes32Hex(out) == hexText

@borrows
fn compilerSnapshotLoweringBridgeFixedObserved(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn compilerSnapshotLoweringBridgeStoreBindingObserved(
        value:
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding):
        bool =
    return compilerSnapshotLoweringBridgeFixedObserved(
               value.cargoStoreIdentityCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.cargoStoreHeadCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.cargoStoreManifestCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.cargoStoreReceiptCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.cargoStoreCsgcObjectCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.envelopeStoreIdentityCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.envelopeHeadCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.envelopeManifestCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.envelopeReceiptCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.envelopeMigrationReceiptCid) &&
        compilerSnapshotLoweringBridgeFixedObserved(
            value.envelopeCsgcObjectCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreIdentityCid,
            value.envelopeStoreIdentityCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreHeadCid, value.envelopeHeadCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreManifestCid, value.envelopeManifestCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreReceiptCid, value.envelopeReceiptCid) &&
        !layout.FixedBytes32Equal(
            value.cargoStoreCsgcObjectCid,
            value.envelopeCsgcObjectCid)

@borrows
fn compilerSnapshotLoweringBridgeStoreBindingEqual(
        left:
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding,
        right:
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding):
        bool =
    return layout.FixedBytes32Equal(
               left.cargoStoreIdentityCid,
               right.cargoStoreIdentityCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreHeadCid, right.cargoStoreHeadCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreManifestCid, right.cargoStoreManifestCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreReceiptCid, right.cargoStoreReceiptCid) &&
        layout.FixedBytes32Equal(
            left.cargoStoreCsgcObjectCid,
            right.cargoStoreCsgcObjectCid) &&
        layout.FixedBytes32Equal(
            left.envelopeStoreIdentityCid,
            right.envelopeStoreIdentityCid) &&
        layout.FixedBytes32Equal(
            left.envelopeHeadCid, right.envelopeHeadCid) &&
        layout.FixedBytes32Equal(
            left.envelopeManifestCid, right.envelopeManifestCid) &&
        layout.FixedBytes32Equal(
            left.envelopeReceiptCid, right.envelopeReceiptCid) &&
        layout.FixedBytes32Equal(
            left.envelopeMigrationReceiptCid,
            right.envelopeMigrationReceiptCid) &&
        layout.FixedBytes32Equal(
            left.envelopeCsgcObjectCid,
            right.envelopeCsgcObjectCid)

@borrows
fn CompilerSnapshotLoweringAuthorityProductionAdmissionMatchesInto(
        authority: var CompilerSnapshotLoweringAuthority,
        currentHeadCid: str,
        manifestCid: str,
        csgcObjectCid: str,
        factsRootCid: str,
        proofCargoCid: str,
        transactionReceiptCid: str,
        err: var str): bool =
    var currentHeadCidFixed: layout.FixedBytes32
    var manifestCidFixed: layout.FixedBytes32
    var csgcObjectCidFixed: layout.FixedBytes32
    var factsRootCidFixed: layout.FixedBytes32
    var proofCargoCidFixed: layout.FixedBytes32
    var transactionReceiptCidFixed: layout.FixedBytes32
    if authority.ownerId != authority.core.ownerId ||
       authority.generation != authority.core.generation ||
       !compilerSnapshotLoweringBridgeIssueReceiptStrictValidateInto(
           authority.issue, err):
        if err.len == 0:
            err =
                " compiler snapshot lowering bridge: production authority rejected"
        return false
    if !compilerSnapshotLoweringBridgeCidTextInto(
           currentHeadCid, currentHeadCidFixed) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           manifestCid, manifestCidFixed) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           csgcObjectCid, csgcObjectCidFixed) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           factsRootCid, factsRootCidFixed) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           proofCargoCid, proofCargoCidFixed) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           transactionReceiptCid, transactionReceiptCidFixed):
        err =
            " compiler snapshot lowering bridge: production CID invalid"
        return false
    return snapshot_authority.CompilerSnapshotLoweringAuthorityProductionArtifactsBoundStrictValidateInto(
            authority.core,
            currentHeadCidFixed,
            manifestCidFixed,
            csgcObjectCidFixed,
            factsRootCidFixed,
            proofCargoCidFixed,
            transactionReceiptCidFixed,
            err)

@borrows
fn CompilerSnapshotLoweringAuthorityProductionBindingCidsInto(
        authority: var CompilerSnapshotLoweringAuthority,
        outCurrentHeadCid: var str,
        outManifestCid: var str,
        outCsgcObjectCid: var str,
        outFactsRootCid: var str,
        outProofCargoCid: var str,
        outTransactionReceiptCid: var str,
        err: var str): bool =
    outCurrentHeadCid = ""
    outManifestCid = ""
    outCsgcObjectCid = ""
    outFactsRootCid = ""
    outProofCargoCid = ""
    outTransactionReceiptCid = ""
    if !CompilerSnapshotLoweringAuthorityStrictValidateInto(authority, err):
        return false
    var binding: snapshot_authority.CompilerSnapshotLoweringAuthorityProductionBinding
    if !snapshot_authority.CompilerSnapshotLoweringAuthorityProductionBindingInto(
           authority.core,
           binding,
           err):
        return false
    outCurrentHeadCid =
        Fmt"sha256:{layout.FixedBytes32Hex(binding.currentHeadCid)}"
    outManifestCid =
        Fmt"sha256:{layout.FixedBytes32Hex(binding.manifestCid)}"
    outCsgcObjectCid =
        Fmt"sha256:{layout.FixedBytes32Hex(binding.csgcObjectCid)}"
    outFactsRootCid =
        Fmt"sha256:{layout.FixedBytes32Hex(binding.factsRootCid)}"
    outProofCargoCid =
        Fmt"sha256:{layout.FixedBytes32Hex(binding.proofCargoCid)}"
    outTransactionReceiptCid =
        Fmt"sha256:{layout.FixedBytes32Hex(binding.transactionReceiptCid)}"
    err = ""
    return true

@borrows
fn CompilerSnapshotLoweringAuthorityCompilerCsgProjectionInto(
        authority: var CompilerSnapshotLoweringAuthority,
        out: var
            CompilerSnapshotLoweringAuthorityCompilerCsgProjection,
        err: var str): bool =
    out = CompilerSnapshotLoweringAuthorityCompilerCsgProjection()
    if !CompilerSnapshotLoweringAuthorityStrictValidateInto(authority, err):
        return false
    var binding: snapshot_authority.CompilerSnapshotLoweringAuthorityProductionBinding
    if !snapshot_authority.CompilerSnapshotLoweringAuthorityProductionBindingInto(
           authority.core, binding, err):
        return false
    var stored: snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding
    stored.cargoStoreIdentityCid = binding.cargoStoreIdentityCid
    stored.cargoStoreHeadCid = binding.currentHeadCid
    stored.cargoStoreManifestCid = binding.manifestCid
    stored.cargoStoreReceiptCid = binding.transactionReceiptCid
    stored.cargoStoreCsgcObjectCid = binding.csgcObjectCid
    stored.envelopeStoreIdentityCid = binding.envelopeStoreIdentityCid
    stored.envelopeHeadCid = binding.envelopeHeadCid
    stored.envelopeManifestCid = binding.envelopeManifestCid
    stored.envelopeReceiptCid = binding.envelopeReceiptCid
    stored.envelopeMigrationReceiptCid =
        binding.envelopeMigrationReceiptCid
    stored.envelopeCsgcObjectCid = binding.envelopeCsgcObjectCid
    if !compilerSnapshotLoweringBridgeStoreBindingEqual(
           stored, authority.issue.storage):
        err =
            "compiler_snapshot_lowering_authority_compiler_csg_projection_storage_drift"
        return false
    out.compilerCsgArtifactCid = authority.issue.compilerCsgArtifactCid
    out.graphCid = authority.issue.graphCid
    out.canonicalGraphCid = authority.issue.canonicalGraphCid
    out.sourceBundleCid = authority.issue.sourceBundleCid
    out.sourceIdentityReceiptCid =
        authority.issue.sourceIdentityReceiptCid
    out.cargoCid = binding.cargoCid
    out.cargoFactsRootCid = binding.factsRootCid
    out.cargoSchemaCid = binding.cargoSchemaCid
    out.cargoProfileSetCid = binding.cargoProfileSetCid
    out.cargoProofCargoCid = binding.proofCargoCid
    out.cargoFactCount = binding.cargoFactCount
    out.cargoComplete = binding.cargoComplete
    out.cargoStoreIdentityCid = binding.cargoStoreIdentityCid
    out.cargoStoreHeadCid = binding.currentHeadCid
    out.cargoStoreManifestCid = binding.manifestCid
    out.cargoStoreReceiptCid = binding.transactionReceiptCid
    out.cargoStoreCsgcObjectCid = binding.csgcObjectCid
    out.envelopeStoreIdentityCid = binding.envelopeStoreIdentityCid
    out.envelopeHeadCid = binding.envelopeHeadCid
    out.envelopeManifestCid = binding.envelopeManifestCid
    out.envelopeReceiptCid = binding.envelopeReceiptCid
    out.envelopeMigrationReceiptCid =
        binding.envelopeMigrationReceiptCid
    out.envelopeCsgcObjectCid = binding.envelopeCsgcObjectCid
    if !compilerSnapshotLoweringBridgeFixedObserved(
           out.compilerCsgArtifactCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(out.graphCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           out.canonicalGraphCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(out.sourceBundleCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           out.sourceIdentityReceiptCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(out.cargoCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           out.cargoFactsRootCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           out.cargoSchemaCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           out.cargoProfileSetCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           out.cargoProofCargoCid) ||
       out.cargoFactCount <= 0 || !out.cargoComplete ||
       !compilerSnapshotLoweringBridgeStoreBindingObserved(stored):
        out = CompilerSnapshotLoweringAuthorityCompilerCsgProjection()
        err =
            "compiler_snapshot_lowering_authority_compiler_csg_projection_incomplete"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeCargoObjectPathCid(
        absolutePath: str): layout.FixedBytes32 =
    var payload = layout.ByteBufInit(160 + absolutePath.len)
    compilerSnapshotLoweringBridgeAppendText(
        payload, compilerSnapshotLoweringBridgeCargoObjectPathDomain)
    compilerSnapshotLoweringBridgeAppendText(payload, absolutePath)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerSnapshotLoweringBridgeCargoObjectReadIdentityCid(
        receipt: CompilerSnapshotLoweringAuthorityCargoObjectReceipt,
        readOrdinal: int32): layout.FixedBytes32 =
    var payload = layout.ByteBufInit(896)
    compilerSnapshotLoweringBridgeAppendText(
        payload, compilerSnapshotLoweringBridgeCargoObjectReadDomain)
    compilerSnapshotLoweringBridgeAppendI32(payload, readOrdinal)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.authoritySlot)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.authorityGeneration)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.cargoObjectRow)
    compilerSnapshotLoweringBridgeAppendI64(
        payload, receipt.storeGeneration)
    layout.ByteBufAppendFixed32(payload, receipt.cargoStoreIdentityCid)
    layout.ByteBufAppendFixed32(payload, receipt.beforeStoreIdentityCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoHeadCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoManifestCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoStoreReceiptCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoCsgcObjectCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoAbsolutePathCid)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.cargoByteCount)
    layout.ByteBufAppendFixed32(payload, receipt.cargoCid)
    layout.ByteBufAppendFixed32(payload, receipt.factsRootCid)
    layout.ByteBufAppendFixed32(payload, receipt.contentCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerSnapshotLoweringBridgeCargoObjectReceiptCid(
        receipt: CompilerSnapshotLoweringAuthorityCargoObjectReceipt):
        layout.FixedBytes32 =
    var payload = layout.ByteBufInit(1024)
    compilerSnapshotLoweringBridgeAppendText(
        payload, compilerSnapshotLoweringBridgeCargoObjectReceiptDomain)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.authoritySlot)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.authorityGeneration)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.cargoObjectRow)
    compilerSnapshotLoweringBridgeAppendI64(
        payload, receipt.storeGeneration)
    layout.ByteBufAppendFixed32(payload, receipt.cargoStoreIdentityCid)
    layout.ByteBufAppendFixed32(payload, receipt.beforeStoreIdentityCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoHeadCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoManifestCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoStoreReceiptCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoCsgcObjectCid)
    layout.ByteBufAppendFixed32(payload, receipt.cargoAbsolutePathCid)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, receipt.cargoByteCount)
    layout.ByteBufAppendFixed32(payload, receipt.cargoCid)
    layout.ByteBufAppendFixed32(payload, receipt.factsRootCid)
    layout.ByteBufAppendFixed32(payload, receipt.contentCid)
    layout.ByteBufAppendFixed32(payload, receipt.beforeReadObservationCid)
    layout.ByteBufAppendFixed32(payload, receipt.afterReadObservationCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn CompilerSnapshotLoweringAuthorityCargoObjectReceiptStrictValid(
        receipt: CompilerSnapshotLoweringAuthorityCargoObjectReceipt): bool =
    if receipt.authoritySlot < 0 ||
       receipt.authorityGeneration <= 0 ||
       receipt.cargoObjectRow != receipt.authoritySlot ||
       receipt.storeGeneration < int64(1) ||
       receipt.cargoByteCount <= 0 ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.cargoStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.beforeStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(receipt.cargoHeadCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.cargoManifestCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.cargoStoreReceiptCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.cargoCsgcObjectCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.cargoAbsolutePathCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(receipt.cargoCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(receipt.factsRootCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(receipt.contentCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.beforeReadObservationCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(
           receipt.afterReadObservationCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(receipt.receiptCid):
        return false
    return layout.FixedBytes32Equal(
               receipt.beforeReadObservationCid,
               compilerSnapshotLoweringBridgeCargoObjectReadIdentityCid(
                   receipt, 0)) &&
        layout.FixedBytes32Equal(
            receipt.afterReadObservationCid,
            compilerSnapshotLoweringBridgeCargoObjectReadIdentityCid(
                receipt, 1)) &&
        layout.FixedBytes32Equal(
            receipt.receiptCid,
            compilerSnapshotLoweringBridgeCargoObjectReceiptCid(receipt))

@borrows
fn CompilerSnapshotLoweringAuthorityCargoObjectAbsolutePath(
        workspaceRoot: str,
        receipt: CompilerSnapshotLoweringAuthorityCargoObjectReceipt): str =
    if !os.IsAbsolute(workspaceRoot) ||
       !CompilerSnapshotLoweringAuthorityCargoObjectReceiptStrictValid(
           receipt):
        return ""
    let storeName = Fmt"{compilerSnapshotLoweringBridgeCargoStorePrefix}{layout.FixedBytes32Hex(receipt.cargoStoreIdentityCid)}"
    let objectCid = Fmt"sha256:{layout.FixedBytes32Hex(receipt.cargoCsgcObjectCid)}"
    let relativePath =
        merkle_store.CsgCoreMerkleStoreCanonicalCsgcRelativePath(
            objectCid)
    if relativePath.len == 0:
        return ""
    let absolutePath = chengpath.PathJoin(
        chengpath.PathJoin(workspaceRoot, storeName), relativePath)
    if !os.IsAbsolute(absolutePath) ||
       !layout.FixedBytes32Equal(
           compilerSnapshotLoweringBridgeCargoObjectPathCid(
               absolutePath),
           receipt.cargoAbsolutePathCid):
        return ""
    return absolutePath

@borrows
fn CompilerSnapshotLoweringAuthorityCargoObjectReceiptInto(
        authority: var CompilerSnapshotLoweringAuthority,
        workspaceRoot: str,
        contentCid: layout.FixedBytes32,
        out: var CompilerSnapshotLoweringAuthorityCargoObjectReceipt,
        err: var str): bool =
    out = CompilerSnapshotLoweringAuthorityCargoObjectReceipt()
    if !os.IsAbsolute(workspaceRoot) ||
       !compilerSnapshotLoweringBridgeFixedObserved(contentCid) ||
       !CompilerSnapshotLoweringAuthorityStrictValidateInto(
           authority, err):
        if err.len == 0:
            err =
                "compiler_snapshot_lowering_authority_cargo_object_input_invalid"
        return false
    if !layout.FixedBytes32Equal(
           compilerSnapshotLoweringBridgeTextIdentityCid(workspaceRoot),
           authority.issue.workspaceRootCid):
        err =
            "compiler_snapshot_lowering_authority_cargo_object_workspace_drift"
        return false
    var binding: snapshot_authority.CompilerSnapshotLoweringAuthorityProductionBinding
    if !snapshot_authority.CompilerSnapshotLoweringAuthorityProductionBindingInto(
           authority.core, binding, err):
        return false
    let authoritySlot = authority.ownerId - 1
    if authoritySlot < 0 || authority.generation <= 0:
        err =
            "compiler_snapshot_lowering_authority_cargo_object_row_invalid"
        return false
    let storeName = Fmt"{compilerSnapshotLoweringBridgeCargoStorePrefix}{layout.FixedBytes32Hex(binding.cargoStoreIdentityCid)}"
    let objectCid = Fmt"sha256:{layout.FixedBytes32Hex(binding.csgcObjectCid)}"
    let relativePath =
        merkle_store.CsgCoreMerkleStoreCanonicalCsgcRelativePath(
            objectCid)
    let storeRoot = chengpath.PathJoin(workspaceRoot, storeName)
    let absolutePath = chengpath.PathJoin(storeRoot, relativePath)
    if relativePath.len == 0 || !os.IsAbsolute(storeRoot) ||
       !os.IsAbsolute(absolutePath):
        err =
            "compiler_snapshot_lowering_authority_cargo_object_path_invalid"
        return false
    let beforeHead = merkle_store.CsgCoreMerkleStoreReadHead(
        workspaceRoot, storeName)
    var beforeRead = merkle_store.CsgCoreMerkleStoreReadObject(
        storeRoot,
        merkle_store.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
        objectCid)
    defer:
        rawbytes.BytesFree(beforeRead.bytes)
    var afterRead = merkle_store.CsgCoreMerkleStoreReadObject(
        storeRoot,
        merkle_store.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
        objectCid)
    defer:
        rawbytes.BytesFree(afterRead.bytes)
    let afterHead = merkle_store.CsgCoreMerkleStoreReadHead(
        workspaceRoot, storeName)
    var beforeStoreIdentityCid: layout.FixedBytes32
    var afterStoreIdentityCid: layout.FixedBytes32
    var beforeHeadCid: layout.FixedBytes32
    var afterHeadCid: layout.FixedBytes32
    var beforeManifestCid: layout.FixedBytes32
    var afterManifestCid: layout.FixedBytes32
    var beforeReceiptCid: layout.FixedBytes32
    var afterReceiptCid: layout.FixedBytes32
    if !beforeHead.ok || !beforeHead.present ||
       !beforeHead.identityProven || beforeHead.error.len != 0 ||
       !afterHead.ok || !afterHead.present ||
       !afterHead.identityProven || afterHead.error.len != 0 ||
       beforeHead.storeRoot != storeRoot ||
       afterHead.storeRoot != storeRoot ||
       beforeHead.storeIdentityCid != afterHead.storeIdentityCid ||
       beforeHead.beforeStoreIdentity != afterHead.beforeStoreIdentity ||
       beforeHead.storeLayoutCid != afterHead.storeLayoutCid ||
       beforeHead.head.generation != afterHead.head.generation ||
       beforeHead.head.headCid != afterHead.head.headCid ||
       beforeHead.head.manifestCid != afterHead.head.manifestCid ||
       beforeHead.head.receiptCid != afterHead.head.receiptCid ||
       beforeHead.manifest.csgcObjectCid !=
           afterHead.manifest.csgcObjectCid ||
       beforeHead.manifest.csgcByteCount !=
           afterHead.manifest.csgcByteCount ||
       beforeHead.manifest.factsRoot != afterHead.manifest.factsRoot ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.storeIdentityCid, beforeStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.storeIdentityCid, afterStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.head.headCid, beforeHeadCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.head.headCid, afterHeadCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.head.manifestCid, beforeManifestCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.head.manifestCid, afterManifestCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.head.receiptCid, beforeReceiptCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.head.receiptCid, afterReceiptCid) ||
       !layout.FixedBytes32Equal(
           beforeStoreIdentityCid, binding.cargoStoreIdentityCid) ||
       !layout.FixedBytes32Equal(
           beforeStoreIdentityCid, afterStoreIdentityCid) ||
       !layout.FixedBytes32Equal(beforeHeadCid, binding.currentHeadCid) ||
       !layout.FixedBytes32Equal(beforeHeadCid, afterHeadCid) ||
       !layout.FixedBytes32Equal(
           beforeManifestCid, binding.manifestCid) ||
       !layout.FixedBytes32Equal(beforeManifestCid, afterManifestCid) ||
       !layout.FixedBytes32Equal(
           beforeReceiptCid, binding.transactionReceiptCid) ||
       !layout.FixedBytes32Equal(beforeReceiptCid, afterReceiptCid) ||
       beforeHead.head.generation < int64(1) ||
       beforeHead.manifest.csgcObjectCid != objectCid ||
       beforeHead.manifest.csgcByteCount <= 0 ||
       beforeHead.manifest.factCount != binding.cargoFactCount ||
       !beforeHead.manifest.complete ||
       !beforeRead.ok || beforeRead.error.len != 0 ||
       !afterRead.ok || afterRead.error.len != 0 ||
       beforeRead.cid != objectCid || afterRead.cid != objectCid ||
       rawbytes.BytesLen(beforeRead.bytes) !=
           beforeHead.manifest.csgcByteCount ||
       rawbytes.BytesLen(afterRead.bytes) !=
           beforeHead.manifest.csgcByteCount ||
       !rawbytes.BytesEqual(beforeRead.bytes, afterRead.bytes):
        err =
            "compiler_snapshot_lowering_authority_cargo_object_stable_read_invalid"
        return false
    let cargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(beforeRead.bytes))
    let verified = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        beforeRead.bytes, binding.factsRootCid)
    if !layout.FixedBytes32Equal(cargoCid, binding.cargoCid) ||
       !verified.ok || verified.error.len != 0 ||
       !layout.FixedBytes32Equal(verified.cargoCid, binding.cargoCid) ||
       !layout.FixedBytes32Equal(
           verified.factsRootCid, binding.factsRootCid) ||
       verified.factCount != binding.cargoFactCount:
        err =
            "compiler_snapshot_lowering_authority_cargo_object_content_invalid"
        return false
    var receipt: CompilerSnapshotLoweringAuthorityCargoObjectReceipt
    receipt.authoritySlot = authoritySlot
    receipt.authorityGeneration = authority.generation
    receipt.cargoObjectRow = authoritySlot
    receipt.storeGeneration = beforeHead.head.generation
    receipt.cargoStoreIdentityCid = binding.cargoStoreIdentityCid
    if !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.beforeStoreIdentity,
           receipt.beforeStoreIdentityCid):
        err =
            "compiler_snapshot_lowering_authority_cargo_object_before_identity_invalid"
        return false
    receipt.cargoHeadCid = binding.currentHeadCid
    receipt.cargoManifestCid = binding.manifestCid
    receipt.cargoStoreReceiptCid = binding.transactionReceiptCid
    receipt.cargoCsgcObjectCid = binding.csgcObjectCid
    receipt.cargoAbsolutePathCid =
        compilerSnapshotLoweringBridgeCargoObjectPathCid(absolutePath)
    receipt.cargoByteCount = rawbytes.BytesLen(beforeRead.bytes)
    receipt.cargoCid = cargoCid
    receipt.factsRootCid = binding.factsRootCid
    receipt.contentCid = contentCid
    receipt.beforeReadObservationCid =
        compilerSnapshotLoweringBridgeCargoObjectReadIdentityCid(
            receipt, 0)
    receipt.afterReadObservationCid =
        compilerSnapshotLoweringBridgeCargoObjectReadIdentityCid(
            receipt, 1)
    receipt.receiptCid =
        compilerSnapshotLoweringBridgeCargoObjectReceiptCid(receipt)
    if !CompilerSnapshotLoweringAuthorityCargoObjectReceiptStrictValid(
           receipt) ||
       CompilerSnapshotLoweringAuthorityCargoObjectAbsolutePath(
           workspaceRoot, receipt) != absolutePath:
        err =
            "compiler_snapshot_lowering_authority_cargo_object_receipt_invalid"
        return false
    out = receipt
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeCanonicalLineInto(
        lines: str[],
        expectedKind: str,
        out: var str,
        err: var str): bool =
    var matched: int32 = -1
    for row in 0..<lines.len:
        let kind = json_field.CsgCoreJsonKind(lines[row])
        if kind.found && kind.value == expectedKind:
            if matched >= 0:
                err =
                    "compiler_snapshot_lowering_authority_projection_kind_duplicate"
                return false
            matched = row
    if matched < 0:
        err =
            "compiler_snapshot_lowering_authority_projection_kind_missing"
        return false
    out = strings.CloneStr(lines[matched])
    return true

@borrows
fn compilerSnapshotLoweringBridgeCanonicalRawFieldInto(
        line: str,
        fieldName: str,
        out: var str,
        err: var str): bool =
    let field = json_field.CsgCoreJsonTopRawField(line, fieldName)
    if !field.found || field.value.len <= 0:
        err =
            "compiler_snapshot_lowering_authority_projection_field_missing"
        return false
    out = strings.CloneStr(field.value)
    return true

@borrows
fn compilerSnapshotLoweringBridgeCanonicalTextMatchesInto(
        raw: str,
        expected: str,
        matches: var bool[],
        err: var str): bool =
    if raw.len < 2 || raw[0] != '[':
        err =
            "compiler_snapshot_lowering_authority_projection_texts_invalid"
        return false
    var cursor: int32 = 1
    if cursor < raw.len && raw[cursor] == ']':
        return cursor + 1 == raw.len
    while cursor < raw.len:
        if raw[cursor] != '"':
            err =
                "compiler_snapshot_lowering_authority_projection_text_invalid"
            return false
        let start = cursor
        cursor = cursor + 1
        while cursor < raw.len && raw[cursor] != '"':
            if raw[cursor] == '\\':
                cursor = cursor + 2
            else:
                cursor = cursor + 1
        if cursor >= raw.len || raw[cursor] != '"':
            err =
                "compiler_snapshot_lowering_authority_projection_text_unterminated"
            return false
        var exact = cursor - start - 1 == expected.len
        if exact:
            for byteIndex in 0..<expected.len:
                if raw[start + 1 + byteIndex] != expected[byteIndex]:
                    exact = false
                    break
        add(matches, exact)
        cursor = cursor + 1
        if cursor >= raw.len:
            err =
                "compiler_snapshot_lowering_authority_projection_texts_truncated"
            return false
        if raw[cursor] == ']':
            return cursor + 1 == raw.len
        if raw[cursor] != ',':
            err =
                "compiler_snapshot_lowering_authority_projection_text_separator_invalid"
            return false
        cursor = cursor + 1
    err =
        "compiler_snapshot_lowering_authority_projection_texts_truncated"
    return false

@borrows
fn compilerSnapshotLoweringBridgeCanonicalI32ArrayInto(
        raw: str,
        values: var int32[],
        err: var str): bool =
    if raw.len < 2 || raw[0] != '[':
        err =
            "compiler_snapshot_lowering_authority_projection_i32_array_invalid"
        return false
    var cursor: int32 = 1
    if cursor < raw.len && raw[cursor] == ']':
        return cursor + 1 == raw.len
    while cursor < raw.len:
        var negative = false
        if raw[cursor] == '-':
            negative = true
            cursor = cursor + 1
        if cursor >= raw.len || raw[cursor] < '0' || raw[cursor] > '9':
            err =
                "compiler_snapshot_lowering_authority_projection_i32_invalid"
            return false
        if raw[cursor] == '0' && cursor + 1 < raw.len &&
           raw[cursor + 1] >= '0' && raw[cursor + 1] <= '9':
            err =
                "compiler_snapshot_lowering_authority_projection_i32_noncanonical"
            return false
        var magnitude: int64
        while cursor < raw.len &&
              raw[cursor] >= '0' && raw[cursor] <= '9':
            magnitude = magnitude * int64(10) +
                int64(int32(raw[cursor]) - int32('0'))
            if magnitude > int64(2147483648):
                err =
                    "compiler_snapshot_lowering_authority_projection_i32_overflow"
                return false
            cursor = cursor + 1
        if (!negative && magnitude > int64(2147483647)) ||
           (negative && magnitude == int64(0)):
            err =
                "compiler_snapshot_lowering_authority_projection_i32_noncanonical"
            return false
        let value = negative ?
            int32(-magnitude) : int32(magnitude)
        add(values, value)
        if cursor >= raw.len:
            err =
                "compiler_snapshot_lowering_authority_projection_i32_array_truncated"
            return false
        if raw[cursor] == ']':
            return cursor + 1 == raw.len
        if raw[cursor] != ',':
            err =
                "compiler_snapshot_lowering_authority_projection_i32_separator_invalid"
            return false
        cursor = cursor + 1
    err =
        "compiler_snapshot_lowering_authority_projection_i32_array_truncated"
    return false

@borrows
fn compilerSnapshotLoweringBridgeCanonicalCidArrayInto(
        raw: str,
        values: var layout.FixedBytes32[],
        err: var str): bool =
    if raw.len < 2 || raw[0] != '[':
        err =
            "compiler_snapshot_lowering_authority_projection_cid_array_invalid"
        return false
    var cursor: int32 = 1
    if cursor < raw.len && raw[cursor] == ']':
        return cursor + 1 == raw.len
    while cursor < raw.len:
        if cursor > raw.len - 73 || raw[cursor] != '"' ||
           raw[cursor + 1] != 's' || raw[cursor + 2] != 'h' ||
           raw[cursor + 3] != 'a' || raw[cursor + 4] != '2' ||
           raw[cursor + 5] != '5' || raw[cursor + 6] != '6' ||
           raw[cursor + 7] != ':' || raw[cursor + 72] != '"':
            err =
                "compiler_snapshot_lowering_authority_projection_cid_invalid"
            return false
        let hex = strings.SliceBytes(raw, cursor + 8, 64)
        let parsed = layout.FixedBytes32FromHex(hex)
        if IsErr(parsed):
            err =
                "compiler_snapshot_lowering_authority_projection_cid_invalid"
            return false
        add(values, Value(parsed))
        cursor = cursor + 73
        if cursor >= raw.len:
            err =
                "compiler_snapshot_lowering_authority_projection_cid_array_truncated"
            return false
        if raw[cursor] == ']':
            return cursor + 1 == raw.len
        if raw[cursor] != ',':
            err =
                "compiler_snapshot_lowering_authority_projection_cid_separator_invalid"
            return false
        cursor = cursor + 1
    err =
        "compiler_snapshot_lowering_authority_projection_cid_array_truncated"
    return false

@borrows
fn compilerSnapshotLoweringBridgeCanonicalProjectionMatchesInto(
        lines: str[],
        projection:
            execution.CompilerToolchainEncoderAuthorityBuildProjectionReceipt,
        err: var str): bool =
    var textsLine: str
    var sourcesLine: str
    var sidecarsLine: str
    if !compilerSnapshotLoweringBridgeCanonicalLineInto(
           lines, "csg_dialect::cheng_compiler::texts",
           textsLine, err) ||
       !compilerSnapshotLoweringBridgeCanonicalLineInto(
           lines, "csg_dialect::cheng_compiler::sources",
           sourcesLine, err) ||
       !compilerSnapshotLoweringBridgeCanonicalLineInto(
           lines, "csg_dialect::cheng_compiler::parser_sidecars",
           sidecarsLine, err):
        return false
    var textsRaw: str
    var modulePathTextIdsRaw: str
    var documentCidsRaw: str
    var contentCidsRaw: str
    var producerRowsRaw: str
    if !compilerSnapshotLoweringBridgeCanonicalRawFieldInto(
           textsLine, "texts", textsRaw, err) ||
       !compilerSnapshotLoweringBridgeCanonicalRawFieldInto(
           sourcesLine, "modulePathTextIds", modulePathTextIdsRaw, err) ||
       !compilerSnapshotLoweringBridgeCanonicalRawFieldInto(
           sourcesLine, "documentCids", documentCidsRaw, err) ||
       !compilerSnapshotLoweringBridgeCanonicalRawFieldInto(
           sourcesLine, "contentCids", contentCidsRaw, err) ||
       !compilerSnapshotLoweringBridgeCanonicalRawFieldInto(
           sidecarsLine, "producerSourceIndexes", producerRowsRaw, err):
        return false
    var textMatches: bool[]
    var modulePathTextIds: int32[]
    var documentCids: layout.FixedBytes32[]
    var contentCids: layout.FixedBytes32[]
    var producerRows: int32[]
    if !compilerSnapshotLoweringBridgeCanonicalTextMatchesInto(
           textsRaw,
           compilerSnapshotLoweringBridgeCanonicalEncoderModulePath,
           textMatches, err) ||
       !compilerSnapshotLoweringBridgeCanonicalI32ArrayInto(
           modulePathTextIdsRaw, modulePathTextIds, err) ||
       !compilerSnapshotLoweringBridgeCanonicalCidArrayInto(
           documentCidsRaw, documentCids, err) ||
       !compilerSnapshotLoweringBridgeCanonicalCidArrayInto(
           contentCidsRaw, contentCids, err) ||
       !compilerSnapshotLoweringBridgeCanonicalI32ArrayInto(
           producerRowsRaw, producerRows, err):
        return false
    let count = modulePathTextIds.len
    if count <= 0 || count != documentCids.len ||
       count != contentCids.len || count != producerRows.len:
        err =
            "compiler_snapshot_lowering_authority_projection_source_shape_invalid"
        return false
    var matchedRow: int32 = -1
    for sourceRow in 0..<count:
        let textId = modulePathTextIds[sourceRow]
        if textId < 0 || textId >= textMatches.len:
            err =
                "compiler_snapshot_lowering_authority_projection_text_id_invalid"
            return false
        if textMatches[textId]:
            if matchedRow >= 0:
                err =
                    "compiler_snapshot_lowering_authority_projection_module_not_unique"
                return false
            matchedRow = sourceRow
    if matchedRow < 0 || projection.canonicalRow != matchedRow ||
       projection.modulePathTextId != modulePathTextIds[matchedRow] ||
       projection.producerRow != producerRows[matchedRow] ||
       projection.producerRow < 0 || projection.producerRow >= count ||
       !layout.FixedBytes32Equal(
           projection.documentCid, documentCids[matchedRow]) ||
       !layout.FixedBytes32Equal(
           projection.contentCid, contentCids[matchedRow]):
        err =
            "compiler_snapshot_lowering_authority_projection_lineage_mismatch"
        return false
    return true

@borrows
fn CompilerSnapshotLoweringAuthorityCargoObjectProjectionReopenStrictInto(
        workspaceRoot: str,
        absolutePath: str,
        receipt: CompilerSnapshotLoweringAuthorityCargoObjectReceipt,
        projection:
            execution.CompilerToolchainEncoderAuthorityBuildProjectionReceipt,
        err: var str): bool =
    let projectionValid =
        execution.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
            projection)
    if IsErr(projectionValid) || !Value(projectionValid) ||
       !CompilerSnapshotLoweringAuthorityCargoObjectReceiptStrictValid(
           receipt) ||
       !layout.FixedBytes32Equal(
           projection.compilerCsgCargoObjectReceiptCid,
           receipt.receiptCid) ||
       !layout.FixedBytes32Equal(
           projection.compilerCsgCargoCid, receipt.cargoCid) ||
       !layout.FixedBytes32Equal(
           projection.compilerCsgFactsRootCid, receipt.factsRootCid) ||
       !layout.FixedBytes32Equal(
           projection.contentCid, receipt.contentCid):
        err =
            "compiler_snapshot_lowering_authority_projection_receipt_join_invalid"
        return false
    let expectedPath =
        CompilerSnapshotLoweringAuthorityCargoObjectAbsolutePath(
            workspaceRoot, receipt)
    let physicalWorkspaceRoot = fs.Realpath(workspaceRoot)
    let physicalAbsolutePath = fs.Realpath(absolutePath)
    if expectedPath.len == 0 || expectedPath != absolutePath ||
       !os.IsAbsolute(absolutePath) ||
       IsErr(physicalWorkspaceRoot) || IsErr(physicalAbsolutePath) ||
       Value(physicalWorkspaceRoot) != workspaceRoot ||
       Value(physicalAbsolutePath) != absolutePath:
        err =
            "compiler_snapshot_lowering_authority_projection_absolute_path_invalid"
        return false
    let storeName = Fmt"{compilerSnapshotLoweringBridgeCargoStorePrefix}{layout.FixedBytes32Hex(receipt.cargoStoreIdentityCid)}"
    let storeRoot = chengpath.PathJoin(workspaceRoot, storeName)
    let objectCid = Fmt"sha256:{layout.FixedBytes32Hex(receipt.cargoCsgcObjectCid)}"
    let beforeHead = merkle_store.CsgCoreMerkleStoreReadHead(
        workspaceRoot, storeName)
    var firstRead = chengpath.PathStableReadBytes(absolutePath)
    defer:
        rawbytes.BytesFree(firstRead.bytes)
    var objectRead = merkle_store.CsgCoreMerkleStoreReadObject(
        storeRoot,
        merkle_store.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
        objectCid)
    defer:
        rawbytes.BytesFree(objectRead.bytes)
    var secondRead = chengpath.PathStableReadBytes(absolutePath)
    defer:
        rawbytes.BytesFree(secondRead.bytes)
    let afterHead = merkle_store.CsgCoreMerkleStoreReadHead(
        workspaceRoot, storeName)
    var beforeStoreIdentityCid: layout.FixedBytes32
    var afterStoreIdentityCid: layout.FixedBytes32
    var beforeIdentityCid: layout.FixedBytes32
    var afterIdentityCid: layout.FixedBytes32
    var beforeHeadCid: layout.FixedBytes32
    var afterHeadCid: layout.FixedBytes32
    var beforeManifestCid: layout.FixedBytes32
    var afterManifestCid: layout.FixedBytes32
    var beforeReceiptCid: layout.FixedBytes32
    var afterReceiptCid: layout.FixedBytes32
    if !beforeHead.ok || !beforeHead.present ||
       !beforeHead.identityProven || beforeHead.error.len != 0 ||
       !afterHead.ok || !afterHead.present ||
       !afterHead.identityProven || afterHead.error.len != 0 ||
       beforeHead.storeRoot != storeRoot || afterHead.storeRoot != storeRoot ||
       beforeHead.storeIdentityCid != afterHead.storeIdentityCid ||
       beforeHead.beforeStoreIdentity != afterHead.beforeStoreIdentity ||
       beforeHead.storeLayoutCid != afterHead.storeLayoutCid ||
       beforeHead.head.generation != afterHead.head.generation ||
       beforeHead.head.headCid != afterHead.head.headCid ||
       beforeHead.head.manifestCid != afterHead.head.manifestCid ||
       beforeHead.head.receiptCid != afterHead.head.receiptCid ||
       beforeHead.manifest.csgcObjectCid !=
           afterHead.manifest.csgcObjectCid ||
       beforeHead.manifest.csgcByteCount !=
           afterHead.manifest.csgcByteCount ||
       beforeHead.manifest.factCount != afterHead.manifest.factCount ||
       beforeHead.manifest.factsRoot != afterHead.manifest.factsRoot ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.storeIdentityCid, beforeStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.storeIdentityCid, afterStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.beforeStoreIdentity, beforeIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.beforeStoreIdentity, afterIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.head.headCid, beforeHeadCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.head.headCid, afterHeadCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.head.manifestCid, beforeManifestCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.head.manifestCid, afterManifestCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           beforeHead.head.receiptCid, beforeReceiptCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           afterHead.head.receiptCid, afterReceiptCid) ||
       !layout.FixedBytes32Equal(
           beforeStoreIdentityCid, receipt.cargoStoreIdentityCid) ||
       !layout.FixedBytes32Equal(
           beforeStoreIdentityCid, afterStoreIdentityCid) ||
       !layout.FixedBytes32Equal(
           beforeIdentityCid, receipt.beforeStoreIdentityCid) ||
       !layout.FixedBytes32Equal(beforeIdentityCid, afterIdentityCid) ||
       !layout.FixedBytes32Equal(beforeHeadCid, receipt.cargoHeadCid) ||
       !layout.FixedBytes32Equal(beforeHeadCid, afterHeadCid) ||
       !layout.FixedBytes32Equal(
           beforeManifestCid, receipt.cargoManifestCid) ||
       !layout.FixedBytes32Equal(beforeManifestCid, afterManifestCid) ||
       !layout.FixedBytes32Equal(
           beforeReceiptCid, receipt.cargoStoreReceiptCid) ||
       !layout.FixedBytes32Equal(beforeReceiptCid, afterReceiptCid) ||
       beforeHead.head.generation != receipt.storeGeneration ||
       beforeHead.manifest.csgcObjectCid != objectCid ||
       beforeHead.manifest.csgcByteCount != receipt.cargoByteCount ||
       beforeHead.manifest.factCount <= 0 ||
       !beforeHead.manifest.complete ||
       beforeHead.manifest.factsRoot !=
           Fmt"sha256:{layout.FixedBytes32Hex(receipt.factsRootCid)}" ||
       !firstRead.ok || firstRead.error.len != 0 ||
       !objectRead.ok || objectRead.error.len != 0 ||
       !secondRead.ok || secondRead.error.len != 0 ||
       objectRead.cid != objectCid ||
       rawbytes.BytesLen(firstRead.bytes) != receipt.cargoByteCount ||
       rawbytes.BytesLen(objectRead.bytes) != receipt.cargoByteCount ||
       rawbytes.BytesLen(secondRead.bytes) != receipt.cargoByteCount ||
       !rawbytes.BytesEqual(firstRead.bytes, objectRead.bytes) ||
       !rawbytes.BytesEqual(firstRead.bytes, secondRead.bytes):
        err =
            "compiler_snapshot_lowering_authority_projection_reopen_invalid"
        return false
    let cargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(firstRead.bytes))
    let verified = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        firstRead.bytes, receipt.factsRootCid)
    if !layout.FixedBytes32Equal(cargoCid, receipt.cargoCid) ||
       !verified.ok || verified.error.len != 0 ||
       !layout.FixedBytes32Equal(verified.cargoCid, receipt.cargoCid) ||
       !layout.FixedBytes32Equal(
           verified.factsRootCid, receipt.factsRootCid) ||
       verified.factCount != beforeHead.manifest.factCount ||
       !compilerSnapshotLoweringBridgeCanonicalProjectionMatchesInto(
           verified.canonicalLines, projection, err):
        if err.len == 0:
            err =
                "compiler_snapshot_lowering_authority_projection_cargo_invalid"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeCoreClaimInto(
        authority: var CompilerSnapshotLoweringAuthority,
        workspaceRoot: str,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        err: var str): bool =
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    defer:
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    if !cargo.ok:
        compilerSnapshotLoweringBridgeAbortIssued(authority)
        err = cargo.error.len > 0 ?
            strings.CloneStr(cargo.error) :
            " compiler snapshot lowering bridge: claim Cargo rejected"
        return false
    var currentStorage: snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding
    if !compilerSnapshotLoweringBridgeAuthorityStoreBindingCurrentInto(
           workspaceRoot,
           cargo,
           authority.issue.storage,
           currentStorage,
           err):
        compilerSnapshotLoweringBridgeAbortIssued(authority)
        return false
    let claimed = snapshot_authority.CompilerSnapshotLoweringAuthorityClaimPlanOwnedInto(
            authority.core,
            currentStorage,
            snapshot,
            csg.sourceIdentityReceipt.sourceSnapshotCount,
            csg.sourceIdentityReceipt.importEdgeCount,
            csg.sourceIdentityReceipt.unresolvedImportCount,
            csg.sourceIdentityReceipt.sourcePackageIdCid,
            csg.sourceIdentityReceipt.entryModulePathCid,
            csg.sourceIdentityReceipt.sourceBundleCid,
            csg.sourceIdentityReceipt.entrySourceCid,
            csg.sourceIdentityReceipt.importGraphCid,
            csg.sourceIdentityReceipt.receiptCid,
            csg.parserNormalizedExprReceipt.envelope.receiptRaw32,
            csg.graphCid,
            csg.canonicalGraphCid,
            csg.csgTransitionReceipt.receiptCid,
            err)
    if !claimed:
        authority = CompilerSnapshotLoweringAuthority()
        return false
    authority.ownerId = authority.core.ownerId
    authority.generation = authority.core.generation
    var stableStorage: snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding
    if !compilerSnapshotLoweringBridgeAuthorityStoreBindingCurrentInto(
           workspaceRoot,
           cargo,
           authority.issue.storage,
           stableStorage,
           err):
        compilerSnapshotLoweringBridgeAbortPlanOwned(authority)
        return false
    return claimed

@borrows
fn CompilerSnapshotLoweringAuthorityClaimCurrentInto(
        authority: var CompilerSnapshotLoweringAuthority,
        linkPlan: var slplan.SystemLinkPlanStub,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        err: var str): bool =
    var currentArtifactCid: layout.FixedBytes32
    if !compilerSnapshotLoweringBridgeCurrentArtifactStrictValidateInto(
           authority, snapshot, csg, currentArtifactCid, err):
        compilerSnapshotLoweringBridgeAbortIssued(authority)
        return false
    var predecessor: production.SemanticSnapshotCompilerPredecessorReceipt
    if !production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
           csg, universe, compilerExecution, predecessor, err):
        compilerSnapshotLoweringBridgeAbortIssued(authority)
        return false
    if compilerExecution.targetTriple != linkPlan.targetTriple ||
       linkPlan.packageId != csg.packageId ||
       !layout.FixedBytes32Equal(
           linkPlan.sourceBundleCidValue, csg.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
           compilerSnapshotLoweringBridgeTextIdentityCid(
               linkPlan.workspaceRoot),
           authority.issue.workspaceRootCid) ||
       !layout.FixedBytes32Equal(
           compilerSnapshotLoweringBridgeTextIdentityCid(
               linkPlan.packageId),
           authority.issue.packageIdCid) ||
       !layout.FixedBytes32Equal(
           compilerSnapshotLoweringBridgeTextIdentityCid(
               linkPlan.targetTriple),
           authority.issue.targetTripleCid) ||
       !layout.FixedBytes32Equal(
           predecessor.worldHeadCid,
           authority.issue.worldHeadCid) ||
       !layout.FixedBytes32Equal(
           predecessor.compilerExecutionCid,
           authority.issue.compilerExecutionCid) ||
       !layout.FixedBytes32Equal(
           predecessor.compilerPackageCid,
           authority.issue.compilerPackageCid) ||
       !layout.FixedBytes32Equal(
           predecessor.sourceBundleCid,
           authority.issue.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
           csg.sourceIdentityReceipt.receiptCid,
           authority.issue.sourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(
           predecessor.receiptCid,
           authority.issue.snapshotPredecessorReceiptCid) ||
       !layout.FixedBytes32Equal(
           currentArtifactCid,
           authority.issue.compilerCsgArtifactCid):
        err =
            " compiler snapshot lowering bridge: current lowering identity differs from issue receipt"
        compilerSnapshotLoweringBridgeAbortIssued(authority)
        return false
    return compilerSnapshotLoweringBridgeCoreClaimInto(
        authority, strings.CloneStr(linkPlan.workspaceRoot), snapshot, csg, err)

fn CompilerSnapshotLoweringAuthoritySnapshotMatchesInto(
        authority: var CompilerSnapshotLoweringAuthority,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    return snapshot_authority.CompilerSnapshotLoweringAuthorityPlanOwnedSnapshotMatchesInto(
            authority.core,
            snapshot,
            authority.issue.graphCid,
            authority.issue.canonicalGraphCid,
            authority.issue.sourceBundleCid,
            err)

@borrows
fn CompilerSnapshotLoweringAuthorityCanonicalSourceProjectionInto(
        authority: var CompilerSnapshotLoweringAuthority,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        canonicalModulePath: str,
        out: var
            CompilerSnapshotLoweringAuthorityCanonicalSourceProjection,
        err: var str): bool =
    out = CompilerSnapshotLoweringAuthorityCanonicalSourceProjection()
    out.sourceRow = -1
    out.producerRow = -1
    out.modulePathTextId = -1
    if canonicalModulePath.len == 0 ||
       !CompilerSnapshotLoweringAuthoritySnapshotMatchesInto(
           authority, snapshot, err):
        if err.len == 0:
            err =
                "compiler_snapshot_lowering_authority_canonical_source_input_invalid"
        return false
    let count = snapshot.sources.documentCids.len
    if count <= 0 ||
       count != snapshot.sources.modulePathTextIds.len ||
       count != snapshot.sources.contentCids.len ||
       count != snapshot.sources.interfaceCids.len ||
       count != snapshot.parserSidecars.producerSourceIndexes.len:
        err =
            "compiler_snapshot_lowering_authority_canonical_source_shape_invalid"
        return false
    var matchedRow: int32 = -1
    for sourceRow in 0..<count:
        let textId = snapshot.sources.modulePathTextIds[sourceRow]
        if textId < 0 || textId >= snapshot.texts.len:
            err =
                "compiler_snapshot_lowering_authority_canonical_source_text_invalid"
            return false
        if snapshot.texts[textId] == canonicalModulePath:
            if matchedRow >= 0:
                err =
                    "compiler_snapshot_lowering_authority_canonical_source_not_unique"
                return false
            matchedRow = sourceRow
    if matchedRow < 0:
        err =
            "compiler_snapshot_lowering_authority_canonical_source_absent"
        return false
    let documentCid = snapshot.sources.documentCids[matchedRow]
    let contentCid = snapshot.sources.contentCids[matchedRow]
    let interfaceCid = snapshot.sources.interfaceCids[matchedRow]
    let producerRow =
        snapshot.parserSidecars.producerSourceIndexes[matchedRow]
    let modulePathTextId =
        snapshot.sources.modulePathTextIds[matchedRow]
    if producerRow < 0 || producerRow >= count ||
       modulePathTextId < 0 || modulePathTextId >= snapshot.texts.len ||
       snapshot.texts[modulePathTextId] != canonicalModulePath ||
       !compilerSnapshotLoweringBridgeFixedObserved(documentCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(contentCid) ||
       !compilerSnapshotLoweringBridgeFixedObserved(interfaceCid):
        err =
            "compiler_snapshot_lowering_authority_canonical_source_cid_invalid"
        return false
    out.sourceRow = matchedRow
    out.producerRow = producerRow
    out.modulePathTextId = modulePathTextId
    out.documentCid = documentCid
    out.contentCid = contentCid
    out.interfaceCid = interfaceCid
    err = ""
    return true

fn CompilerSnapshotLoweringAuthorityBindFunctionProjectionInto(
        authority: var CompilerSnapshotLoweringAuthority,
        functionProjectionCid: layout.FixedBytes32,
        err: var str): bool =
    let bound = snapshot_authority.CompilerSnapshotLoweringAuthorityBindFunctionProjectionInto(
            authority.core, functionProjectionCid, err)
    if !bound:
        authority = CompilerSnapshotLoweringAuthority()
    return bound

@borrows
fn CompilerSnapshotLoweringAuthorityFunctionProjectionMatchesInto(
        authority: CompilerSnapshotLoweringAuthority,
        functionProjectionCid: layout.FixedBytes32,
        err: var str): bool =
    return snapshot_authority.CompilerSnapshotLoweringAuthorityFunctionProjectionMatchesInto(
            authority.core, functionProjectionCid, err)

fn CompilerSnapshotLoweringAuthorityReleaseInto(
        authority: var CompilerSnapshotLoweringAuthority,
        expectedIdentityCid: layout.FixedBytes32,
        expectedFunctionProjectionCid: layout.FixedBytes32,
        releaseCid: var layout.FixedBytes32,
        err: var str): bool =
    if !compilerSnapshotLoweringBridgeIssueReceiptStrictValidateInto(
           authority.issue, err):
        compilerSnapshotLoweringBridgeAbortPlanOwned(authority)
        return false
    let released = snapshot_authority.CompilerSnapshotLoweringAuthorityReleasePlanOwnedInto(
            authority.core,
            expectedIdentityCid,
            expectedFunctionProjectionCid,
            releaseCid,
            err)
    authority = CompilerSnapshotLoweringAuthority()
    return released

fn compilerSnapshotLoweringBridgeAppendI32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, (value >> 24) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, value & 255)

fn compilerSnapshotLoweringBridgeAppendI64(
        out: var layout.ByteBuf,
        value: int64) =
    compilerSnapshotLoweringBridgeAppendI32(out, Int32(value >> 32))
    compilerSnapshotLoweringBridgeAppendI32(out, Int32(value))

@borrows
fn compilerSnapshotLoweringBridgeAppendText(
        out: var layout.ByteBuf,
        value: str) =
    compilerSnapshotLoweringBridgeAppendI32(out, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(out, Int32(value[index]) & 255)

@borrows
fn compilerSnapshotLoweringBridgeTextIdentityCid(
        value: str): layout.FixedBytes32 =
    var payload = layout.ByteBufInit(128 + value.len)
    compilerSnapshotLoweringBridgeAppendText(
        payload, compilerSnapshotLoweringBridgeTextIdentityDomain)
    compilerSnapshotLoweringBridgeAppendText(payload, value)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerSnapshotLoweringBridgeCompilerCsgArtifactCid(
        csg: var ccsg.CompilerCsg,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        admission: var builder.CompilerSnapshotProductionAdmissionReceipt,
        cargo: var snapshot_cargo.CsgCompilerSnapshotCargo):
        layout.FixedBytes32 =
    var payload = layout.ByteBufInit(1024)
    compilerSnapshotLoweringBridgeAppendText(
        payload,
        compilerSnapshotLoweringBridgeCompilerCsgArtifactDomain)
    compilerSnapshotLoweringBridgeAppendText(payload, csg.packageId)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, csg.sourceIdentityReceipt.sourceSnapshotCount)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, csg.sourceIdentityReceipt.importEdgeCount)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, csg.sourceIdentityReceipt.unresolvedImportCount)
    layout.ByteBufAppendFixed32(
        payload, csg.sourceIdentityReceipt.sourcePackageIdCid)
    layout.ByteBufAppendFixed32(
        payload, csg.sourceIdentityReceipt.entryModulePathCid)
    layout.ByteBufAppendFixed32(
        payload, csg.sourceIdentityReceipt.sourceBundleCid)
    layout.ByteBufAppendFixed32(
        payload, csg.sourceIdentityReceipt.entrySourceCid)
    layout.ByteBufAppendFixed32(
        payload, csg.sourceIdentityReceipt.importGraphCid)
    layout.ByteBufAppendFixed32(
        payload, csg.sourceIdentityReceipt.receiptCid)
    layout.ByteBufAppendFixed32(
        payload, csg.parserNormalizedExprReceipt.envelope.receiptRaw32)
    layout.ByteBufAppendFixed32(payload, csg.graphCid)
    layout.ByteBufAppendFixed32(payload, csg.canonicalGraphCid)
    layout.ByteBufAppendFixed32(
        payload, csg.csgTransitionReceipt.receiptCid)
    layout.ByteBufAppendFixed32(payload, admission.receiptCid)
    layout.ByteBufAppendFixed32(payload, admission.retainedFactsCid)
    layout.ByteBufAppendFixed32(payload, admission.typeArenaArtifactCid)
    layout.ByteBufAppendFixed32(payload, admission.dependencyProofCid)
    layout.ByteBufAppendFixed32(payload, admission.sourceInterfaceProofCid)
    layout.ByteBufAppendFixed32(payload, admission.symbolInterfaceProofCid)
    layout.ByteBufAppendFixed32(payload, admission.functionInterfaceProofCid)
    layout.ByteBufAppendFixed32(payload, admission.typedNodeProofCid)
    layout.ByteBufAppendFixed32(payload, admission.referenceProofCid)
    layout.ByteBufAppendFixed32(payload, admission.lexicalScopeProofCid)
    layout.ByteBufAppendFixed32(payload, admission.diagnosticProofCid)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, snapshot.schemaVersion)
    compilerSnapshotLoweringBridgeAppendI64(
        payload, snapshot.semanticEpoch)
    layout.ByteBufAppendFixed32(
        payload, snapshot.predecessorReceiptCid)
    layout.ByteBufAppendFixed32(payload, cargo.cargoCid)
    layout.ByteBufAppendFixed32(payload, cargo.factsRootCid)
    compilerSnapshotLoweringBridgeAppendI32(payload, cargo.factCount)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerSnapshotLoweringBridgeIssueReceiptCid(
        receipt: compilerSnapshotLoweringBridgeIssueReceipt):
        layout.FixedBytes32 =
    var payload = layout.ByteBufInit(640)
    compilerSnapshotLoweringBridgeAppendText(
        payload, compilerSnapshotLoweringBridgeIssueReceiptDomain)
    compilerSnapshotLoweringBridgeAppendI32(payload, receipt.ownerId)
    compilerSnapshotLoweringBridgeAppendI32(payload, receipt.generation)
    layout.ByteBufAppendFixed32(payload, receipt.workspaceRootCid)
    layout.ByteBufAppendFixed32(payload, receipt.packageIdCid)
    layout.ByteBufAppendFixed32(payload, receipt.targetTripleCid)
    layout.ByteBufAppendFixed32(payload, receipt.worldHeadCid)
    layout.ByteBufAppendFixed32(payload, receipt.compilerExecutionCid)
    layout.ByteBufAppendFixed32(payload, receipt.compilerPackageCid)
    layout.ByteBufAppendFixed32(payload, receipt.sourceBundleCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.sourceIdentityReceiptCid)
    layout.ByteBufAppendFixed32(payload, receipt.graphCid)
    layout.ByteBufAppendFixed32(payload, receipt.canonicalGraphCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.snapshotPredecessorReceiptCid)
    layout.ByteBufAppendFixed32(payload, receipt.compilerCsgArtifactCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.cargoStoreIdentityCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.cargoStoreHeadCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.cargoStoreManifestCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.cargoStoreReceiptCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.cargoStoreCsgcObjectCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.envelopeStoreIdentityCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.envelopeHeadCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.envelopeManifestCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.envelopeReceiptCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.envelopeMigrationReceiptCid)
    layout.ByteBufAppendFixed32(
        payload, receipt.storage.envelopeCsgcObjectCid)
    layout.ByteBufAppendFixed32(payload, receipt.admission.receiptCid)
    layout.ByteBufAppendFixed32(payload, receipt.admission.retainedFactsCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerSnapshotLoweringBridgeIssueReceiptStrictValidateInto(
        receipt: compilerSnapshotLoweringBridgeIssueReceipt,
        err: var str): bool =
    if receipt.ownerId <= 0 || receipt.generation <= 0 ||
       layout.FixedBytes32Equal(
           receipt.workspaceRootCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.packageIdCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.targetTripleCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.worldHeadCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.compilerExecutionCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.compilerPackageCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.sourceBundleCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.sourceIdentityReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.graphCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.canonicalGraphCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.snapshotPredecessorReceiptCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.compilerCsgArtifactCid, layout.FixedBytes32()) ||
       !compilerSnapshotLoweringBridgeStoreBindingObserved(
           receipt.storage) ||
       layout.FixedBytes32Equal(
           receipt.admission.receiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.admission.retainedFactsCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.receiptCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           receipt.receiptCid,
           compilerSnapshotLoweringBridgeIssueReceiptCid(receipt)):
        err =
            " compiler snapshot lowering bridge: malformed issue receipt"
        return false
    err = ""
    return true

fn compilerSnapshotLoweringBridgeCurrentArtifactStrictValidateInto(
        authority: var CompilerSnapshotLoweringAuthority,
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        csg: var ccsg.CompilerCsg,
        artifactCid: var layout.FixedBytes32,
        err: var str): bool =
    artifactCid = layout.FixedBytes32()
    if !ccsg.CompilerCsgOwnTransitionReceiptStrictValidateInto(csg, err) ||
       !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err) ||
       !compilerSnapshotLoweringBridgeIssueReceiptStrictValidateInto(
           authority.issue, err):
        return false
    var issueAdmission = authority.issue.admission
    if !builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
           csg, snapshot, issueAdmission, err):
        return false
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    defer:
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    if !cargo.ok:
        err = cargo.error.len > 0 ?
            strings.CloneStr(cargo.error) :
            " compiler snapshot lowering bridge: current Cargo build failed"
        return false
    let currentArtifactCid =
        compilerSnapshotLoweringBridgeCompilerCsgArtifactCid(
            csg, snapshot, issueAdmission, cargo)
    if layout.FixedBytes32Equal(
           currentArtifactCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           currentArtifactCid,
           authority.issue.compilerCsgArtifactCid):
        err =
            " compiler snapshot lowering bridge: current CompilerCSG artifact differs from issue receipt"
        return false
    artifactCid = currentArtifactCid
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeMerklePolicyBindingCid(
        policy: compilerSnapshotLoweringBridgeMerklePolicy): str =
    var payload = layout.ByteBufInit(768)
    compilerSnapshotLoweringBridgeAppendText(
        payload, compilerSnapshotLoweringBridgeMerklePolicyDomain)
    compilerSnapshotLoweringBridgeAppendText(payload, policy.parentPath)
    compilerSnapshotLoweringBridgeAppendText(payload, policy.storeName)
    compilerSnapshotLoweringBridgeAppendText(
        payload, policy.expectedHeadCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, policy.expectedManifestCid)
    compilerSnapshotLoweringBridgeAppendText(payload, policy.packageId)
    layout.ByteBufAppendFixed32(payload, policy.worldHeadCid)
    layout.ByteBufAppendFixed32(payload, policy.executionCid)
    layout.ByteBufAppendFixed32(payload, policy.sourceBundleCid)
    layout.ByteBufAppendFixed32(payload, policy.cargoCid)
    layout.ByteBufAppendFixed32(payload, policy.factsRootCid)
    compilerSnapshotLoweringBridgeAppendI32(payload, policy.factCount)
    var bytes = layout.ByteBufToBytes(payload)
    let out = merkle_codec.CsgCoreMerkleStoreDomainBytesCid(
        compilerSnapshotLoweringBridgeMerklePolicyDomain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerSnapshotLoweringBridgeMerklePolicyValid(
        policy: compilerSnapshotLoweringBridgeMerklePolicy,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo): bool =
    var canonicalParentPath: str
    if !policy.admitted ||
       policy.storeName !=
           compilerSnapshotLoweringBridgeMerkleStoreName ||
       !parser.ParserSourceIdentityLexicalPathInto(
           policy.parentPath, canonicalParentPath) ||
       canonicalParentPath != policy.parentPath ||
       !parser.ParserSourceIdentityPathAbsolute(canonicalParentPath) ||
       policy.packageId.len == 0 || policy.factCount <= 0 ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           policy.expectedHeadCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           policy.expectedManifestCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(policy.bindingCid) ||
       layout.FixedBytes32Equal(
           policy.worldHeadCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           policy.executionCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           policy.sourceBundleCid, layout.FixedBytes32()) ||
       !cargo.ok || policy.factCount != cargo.factCount ||
       !layout.FixedBytes32Equal(policy.cargoCid, cargo.cargoCid) ||
       !layout.FixedBytes32Equal(
           policy.factsRootCid, cargo.factsRootCid):
        return false
    return compilerSnapshotLoweringBridgeMerklePolicyBindingCid(policy) ==
        policy.bindingCid

@borrows
fn compilerSnapshotLoweringBridgeCargoExact(
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo): bool =
    if !cargo.ok || cargo.error.len != 0 || cargo.factCount <= 0 ||
       cargo.csgcByteCount <= 0 ||
       rawbytes.BytesLen(cargo.csgcBytes) != cargo.csgcByteCount:
        return false
    let verified =
        snapshot_cargo.CsgCompilerSnapshotVerifiedCargoFromBuiltCargo(cargo)
    if !verified.ok || verified.error.len != 0 ||
       !layout.FixedBytes32Equal(verified.cargoCid, cargo.cargoCid) ||
       !layout.FixedBytes32Equal(
           verified.factsRootCid, cargo.factsRootCid) ||
       verified.standard != cargo.standard ||
       !validator.CsgCoreProfilesEqual(
           verified.profiles, cargo.profiles) ||
       verified.profileSetCid != cargo.profileSetCid ||
       verified.schemaNamespace != cargo.schemaNamespace ||
       verified.schemaCid != cargo.schemaCid ||
       verified.factsRoot != cargo.factsRoot ||
       verified.factsSubgraphCid != cargo.factsSubgraphCid ||
       verified.dagRootCid != cargo.dagRootCid ||
       verified.factCount != cargo.factCount ||
       verified.canonicalLines.len != cargo.canonicalLines.len:
        return false
    for index in 0..<verified.canonicalLines.len:
        if verified.canonicalLines[index] != cargo.canonicalLines[index]:
            return false
    return layout.FixedBytes32Equal(
               verified.proofRoots.parserRootCid,
               cargo.proofRoots.parserRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.typeRootCid,
            cargo.proofRoots.typeRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.ownershipRootCid,
            cargo.proofRoots.ownershipRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.callRootCid,
            cargo.proofRoots.callRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.layoutRootCid,
            cargo.proofRoots.layoutRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.dependencyRootCid,
            cargo.proofRoots.dependencyRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.readSetRootCid,
            cargo.proofRoots.readSetRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.reachabilityRootCid,
            cargo.proofRoots.reachabilityRootCid) &&
        layout.FixedBytes32Equal(
            verified.proofRoots.lifecycleRootCid,
            cargo.proofRoots.lifecycleRootCid)

@borrows
fn CsgCompilerSnapshotCargoStoreIdentityCid(
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo): str =
    if !compilerSnapshotLoweringBridgeCargoExact(cargo):
        return ""
    let domain = "csg_core.compiler_snapshot.immutable_cargo_store"
    var payload = layout.ByteBufInit(1024)
    compilerSnapshotLoweringBridgeAppendText(payload, domain)
    compilerSnapshotLoweringBridgeAppendText(payload, cargo.standard)
    compilerSnapshotLoweringBridgeAppendI32(payload, cargo.profiles.len)
    for index in 0..<cargo.profiles.len:
        compilerSnapshotLoweringBridgeAppendText(
            payload, cargo.profiles[index])
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargo.profileSetCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargo.schemaNamespace)
    compilerSnapshotLoweringBridgeAppendText(payload, cargo.schemaCid)
    layout.ByteBufAppendFixed32(payload, cargo.cargoCid)
    layout.ByteBufAppendFixed32(payload, cargo.factsRootCid)
    compilerSnapshotLoweringBridgeAppendText(payload, cargo.factsRoot)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargo.factsSubgraphCid)
    compilerSnapshotLoweringBridgeAppendText(payload, cargo.dagRootCid)
    compilerSnapshotLoweringBridgeAppendI32(payload, cargo.factCount)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, cargo.csgcByteCount)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.parserRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.typeRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.ownershipRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.callRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.layoutRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.dependencyRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.readSetRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.reachabilityRootCid)
    layout.ByteBufAppendFixed32(payload, cargo.proofRoots.lifecycleRootCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, snapshot_cargo.CsgCompilerSnapshotEnvelopeSchemaLine())
    compilerSnapshotLoweringBridgeAppendText(
        payload, "csg_core::compiler_snapshot_envelope")
    var bytes = layout.ByteBufToBytes(payload)
    let out = merkle_codec.CsgCoreMerkleStoreDomainBytesCid(domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn CsgCompilerSnapshotCargoStoreName(
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo): str =
    let identityCid = CsgCompilerSnapshotCargoStoreIdentityCid(cargo)
    if !merkle_codec.CsgCoreMerkleStoreCidValid(identityCid):
        return ""
    return Fmt"{compilerSnapshotLoweringBridgeCargoStorePrefix}{strings.CloneStrRange(identityCid, 7, 64)}"

@borrows
fn CsgCompilerSnapshotEnvelopeStoreIdentityCid(
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo): str =
    let cargoStoreIdentity =
        CsgCompilerSnapshotCargoStoreIdentityCid(cargo)
    if !merkle_codec.CsgCoreMerkleStoreCidValid(cargoStoreIdentity):
        return ""
    let domain = "csg_core.compiler_snapshot.envelope_store"
    var payload = layout.ByteBufInit(768)
    compilerSnapshotLoweringBridgeAppendText(payload, domain)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest)
    compilerSnapshotLoweringBridgeAppendText(payload, cargo.standard)
    compilerSnapshotLoweringBridgeAppendI32(payload, cargo.profiles.len)
    for index in 0..<cargo.profiles.len:
        compilerSnapshotLoweringBridgeAppendText(
            payload, cargo.profiles[index])
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargo.profileSetCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargo.schemaNamespace)
    compilerSnapshotLoweringBridgeAppendText(payload, cargo.schemaCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, snapshot_cargo.CsgCompilerSnapshotEnvelopeSchemaLine())
    compilerSnapshotLoweringBridgeAppendText(
        payload, "csg_core::compiler_snapshot_envelope")
    var bytes = layout.ByteBufToBytes(payload)
    let out = merkle_codec.CsgCoreMerkleStoreDomainBytesCid(domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn CsgCompilerSnapshotEnvelopeStoreName(
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo): str =
    let identityCid = CsgCompilerSnapshotEnvelopeStoreIdentityCid(cargo)
    if !merkle_codec.CsgCoreMerkleStoreCidValid(identityCid):
        return ""
    return Fmt"{compilerSnapshotLoweringBridgeEnvelopeStorePrefix}{strings.CloneStrRange(identityCid, 7, 64)}"

fn compilerSnapshotLoweringBridgeMerkleGenesisPredecessorCid(): layout.FixedBytes32 =
    let domain =
        "csg_core.compiler_snapshot.merkle_genesis.predecessor"
    var buf = layout.ByteBufInit(domain.len)
    for byteIndex in 0..<domain.len:
        layout.ByteBufAppendByte(
            buf, Int32(domain[byteIndex]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn compilerSnapshotLoweringBridgeRewriteSnapshotPredecessorInto(
        line: str,
        predecessor: layout.FixedBytes32,
        rewritten: var str,
        err: var str): bool =
    let marker = "\"predecessorReceiptCid\":\"sha256:"
    var markerAt: int32 = -1
    if line.len >= marker.len:
        for start in 0..<(line.len - marker.len + 1):
            var matched = true
            for offset in 0..<marker.len:
                if line[start + offset] != marker[offset]:
                    matched = false
            if matched:
                if markerAt >= 0:
                    err =
                        " compiler snapshot lowering bridge: snapshot predecessor field ambiguous"
                    return false
                markerAt = start
    let hexAt = markerAt + marker.len
    if markerAt < 0 || hexAt + 64 > line.len:
        err =
            " compiler snapshot lowering bridge: snapshot predecessor field missing"
        return false
    let hex = layout.FixedBytes32Hex(predecessor)
    if hex.len != 64:
        err =
            " compiler snapshot lowering bridge: genesis predecessor cid invalid"
        return false
    var buf = layout.ByteBufInit(line.len)
    for index in 0..<hexAt:
        layout.ByteBufAppendByte(buf, Int32(line[index]) & 255)
    for index in 0..<64:
        layout.ByteBufAppendByte(buf, Int32(hex[index]) & 255)
    for index in hexAt + 64..<line.len:
        layout.ByteBufAppendByte(buf, Int32(line[index]) & 255)
    var unchanged = true
    for index in 0..<64:
        if line[hexAt + index] != hex[index]:
            unchanged = false
    if unchanged:
        layout.ByteBufFree(buf)
        err =
            " compiler snapshot lowering bridge: genesis snapshot predecessor was not distinct"
        return false
    var bytes = layout.ByteBufToBytes(buf)
    rewritten = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeMerkleGenesisHeadMatches(
        current: merkle_store.CsgCoreMerkleHeadReadResult,
        verified: snapshot_cargo.CsgCompilerSnapshotVerifiedCargo,
        sourceId: str,
        expectedHeadCid: str,
        expectedManifestCid: str): bool =
    if !current.ok || !current.present ||
       current.head.headCid != expectedHeadCid ||
       current.head.manifestCid != expectedManifestCid ||
       current.head.generation != int64(0) ||
       current.head.previousHeadCid != "none" ||
       current.head.receiptCid != "none" ||
       current.manifest.standard != verified.standard ||
       !validator.CsgCoreProfilesEqual(
           current.manifest.profiles, verified.profiles) ||
       current.manifest.profileSetCid != verified.profileSetCid ||
       current.manifest.schemaCid != verified.schemaCid ||
       current.manifest.factCount != verified.factCount ||
       current.manifest.factCount != verified.canonicalLines.len ||
       current.manifest.factsRoot == verified.factsRoot ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0 ||
       current.manifest.runtimeRequirementCount != 0 ||
       current.manifest.partitions.len == 0:
        return false
    for i in 0..<current.manifest.partitions.len:
        if current.manifest.partitions[i].sourceId != sourceId:
            return false
    return true

@borrows
fn compilerSnapshotLoweringBridgeMerkleHeadMatchesVerified(
        current: merkle_store.CsgCoreMerkleHeadReadResult,
        verified: snapshot_cargo.CsgCompilerSnapshotVerifiedCargo,
        sourceId: str,
        expectedHeadCid: str,
        expectedManifestCid: str,
        expectedGeneration: int64,
        expectedPreviousHeadCid: str,
        expectedReceiptCid: str): bool =
    if !current.ok || !current.present ||
       current.head.headCid != expectedHeadCid ||
       current.head.manifestCid != expectedManifestCid ||
       current.head.generation != expectedGeneration ||
       current.head.previousHeadCid != expectedPreviousHeadCid ||
       current.head.receiptCid != expectedReceiptCid ||
       current.manifest.standard != verified.standard ||
       !validator.CsgCoreProfilesEqual(
           current.manifest.profiles, verified.profiles) ||
       current.manifest.profileSetCid != verified.profileSetCid ||
       current.manifest.schemaCid != verified.schemaCid ||
       current.manifest.factsRoot != verified.factsRoot ||
       current.manifest.dagRootCid != verified.dagRootCid ||
       current.manifest.factCount != verified.factCount ||
       current.manifest.factCount != verified.canonicalLines.len ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0 ||
       current.manifest.runtimeRequirementCount != 0 ||
       current.manifest.partitions.len == 0:
        return false
    for i in 0..<current.manifest.partitions.len:
        if current.manifest.partitions[i].sourceId != sourceId:
            return false
    return true

@borrows
fn compilerSnapshotLoweringBridgeMerkleBootstrapAtInto(
        canonicalWorkspaceRoot: str,
        storeName: str,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        out: var snapshot_cargo.CsgCompilerSnapshotMerkleTransaction,
        err: var str): bool =
    let verified =
        snapshot_cargo.CsgCompilerSnapshotVerifiedCargoFromBuiltCargo(cargo)
    if !verified.ok || verified.error.len != 0:
        err = verified.error.len == 0 ?
            " compiler snapshot lowering bridge: bootstrap Cargo verification mismatch" :
            strings.ConcatStr(
                " compiler snapshot lowering bridge: bootstrap Cargo verification mismatch",
                verified.error)
        return false
    if verified.standard != cargo.standard ||
       !validator.CsgCoreProfilesEqual(
           verified.profiles, cargo.profiles) ||
       verified.profileSetCid != cargo.profileSetCid ||
       verified.schemaNamespace != cargo.schemaNamespace ||
       verified.schemaCid != cargo.schemaCid ||
       verified.factsRoot != cargo.factsRoot ||
       verified.factsSubgraphCid != cargo.factsSubgraphCid ||
       verified.dagRootCid != cargo.dagRootCid ||
       verified.factCount != cargo.factCount ||
       verified.canonicalLines.len != cargo.canonicalLines.len ||
       !layout.FixedBytes32Equal(
           verified.factsRootCid, cargo.factsRootCid) ||
       !layout.FixedBytes32Equal(verified.cargoCid, cargo.cargoCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.parserRootCid,
           cargo.proofRoots.parserRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.typeRootCid,
           cargo.proofRoots.typeRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.ownershipRootCid,
           cargo.proofRoots.ownershipRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.callRootCid,
           cargo.proofRoots.callRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.layoutRootCid,
           cargo.proofRoots.layoutRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.dependencyRootCid,
           cargo.proofRoots.dependencyRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.readSetRootCid,
           cargo.proofRoots.readSetRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.reachabilityRootCid,
           cargo.proofRoots.reachabilityRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.lifecycleRootCid,
           cargo.proofRoots.lifecycleRootCid):
        err =
            " compiler snapshot lowering bridge: bootstrap Cargo verification mismatch"
        return false
    for i in 0..<verified.canonicalLines.len:
        if verified.canonicalLines[i] != cargo.canonicalLines[i]:
            err =
                " compiler snapshot lowering bridge: bootstrap Cargo facts mismatch"
            return false
    let sourceId =
        snapshot_cargo.CsgCompilerSnapshotCargoMerkleSourceId()
    let genesisPredecessor =
        compilerSnapshotLoweringBridgeMerkleGenesisPredecessorCid()
    var genesisSnapshotLine: str
    if verified.canonicalLines.len < 2 ||
       !compilerSnapshotLoweringBridgeRewriteSnapshotPredecessorInto(
           verified.canonicalLines[1],
           genesisPredecessor,
           genesisSnapshotLine,
           err):
        if err == "":
            err =
                " compiler snapshot lowering bridge: genesis snapshot line missing"
        return false
    var source: merkle_builder.CsgCoreMerkleBuilderSource
    source.sourceId = strings.CloneStr(sourceId)
    source.sourceCid = strings.CloneStr(verified.factsSubgraphCid)
    source.factsProvenCanonical = true
    add(
        source.facts,
        strings.CloneStr(verified.canonicalLines[0]))
    add(source.facts, genesisSnapshotLine)
    for i in 2..<verified.canonicalLines.len:
        add(
            source.facts,
            strings.CloneStr(verified.canonicalLines[i]))
    var closure = merkle_builder.CsgCoreMerkleBuildClosure(
        verified.standard, verified.profiles, [source], [])
    defer:
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
    if !closure.ok || !closure.admission.ok ||
       closure.standard != verified.standard ||
       !validator.CsgCoreProfilesEqual(
           closure.profiles, verified.profiles) ||
       closure.profileSetCid != verified.profileSetCid ||
       closure.schemaCid != verified.schemaCid ||
       closure.factsRoot == verified.factsRoot ||
       closure.factCount != verified.factCount ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           closure.manifestArtifact.cid):
        var detail = closure.error
        if detail.len == 0:
            detail = closure.admission.error
        err = detail.len == 0 ?
            " compiler snapshot lowering bridge: bootstrap closure mismatch" :
            strings.ConcatStr(
                " compiler snapshot lowering bridge: bootstrap closure mismatch",
                detail)
        return false
    let bootstrap =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrapExclusive(
            canonicalWorkspaceRoot,
            storeName,
            closure)
    if !bootstrap.ok || !bootstrap.published || bootstrap.reused ||
       bootstrap.head.generation != int64(0) ||
       bootstrap.head.previousHeadCid != "none" ||
       bootstrap.head.receiptCid != "none" ||
       bootstrap.head.manifestCid != closure.manifestArtifact.cid:
        err = bootstrap.error.len > 0 ?
            strings.CloneStr(bootstrap.error) :
            " compiler snapshot lowering bridge: bootstrap genesis rejected"
        return false
    let genesis = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot,
        storeName)
    if !compilerSnapshotLoweringBridgeMerkleGenesisHeadMatches(
           genesis,
           verified,
           sourceId,
           bootstrap.head.headCid,
           closure.manifestArtifact.cid):
        err =
            " compiler snapshot lowering bridge: bootstrap genesis mismatch"
        return false
    let applied = snapshot_cargo.CsgCompilerSnapshotCargoMerkleApply(
        canonicalWorkspaceRoot,
        storeName,
        bootstrap.head.headCid,
        cargo)
    if !applied.ok || !applied.planReady ||
       !applied.productionApplied || applied.reused ||
       applied.error.len != 0 ||
       applied.manifestCid == closure.manifestArtifact.cid:
        err = applied.error.len > 0 ?
            strings.CloneStr(applied.error) :
            " compiler snapshot lowering bridge: bootstrap transaction rejected"
        return false
    let committed = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot,
        storeName)
    if !compilerSnapshotLoweringBridgeMerkleHeadMatchesVerified(
           committed,
           verified,
           sourceId,
           applied.headCid,
           applied.manifestCid,
           int64(1),
           bootstrap.head.headCid,
           applied.receiptCid):
        err =
            " compiler snapshot lowering bridge: bootstrap generation one mismatch"
        return false
    out = applied
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeMerkleBootstrapInto(
        canonicalWorkspaceRoot: str,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        out: var snapshot_cargo.CsgCompilerSnapshotMerkleTransaction,
        err: var str): bool =
    return compilerSnapshotLoweringBridgeMerkleBootstrapAtInto(
        canonicalWorkspaceRoot,
        compilerSnapshotLoweringBridgeMerkleStoreName,
        cargo,
        out,
        err)

@borrows
fn compilerSnapshotLoweringBridgeImmutableCargoHeadExact(
        canonicalWorkspaceRoot: str,
        storeName: str,
        storeIdentityCid: str,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        current: merkle_store.CsgCoreMerkleHeadReadResult,
        out: var CsgCompilerSnapshotImmutableCargoStoreBinding,
        err: var str): bool =
    let expectedStoreName = CsgCompilerSnapshotCargoStoreName(cargo)
    let expectedStoreIdentity =
        CsgCompilerSnapshotCargoStoreIdentityCid(cargo)
    if storeName != expectedStoreName ||
       storeIdentityCid != expectedStoreIdentity ||
       !current.ok || !current.present || current.error.len != 0 ||
       current.head.generation < int64(1) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(current.head.headCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.manifestCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.receiptCid) ||
       current.manifest.standard != cargo.standard ||
       !validator.CsgCoreProfilesEqual(
           current.manifest.profiles, cargo.profiles) ||
       current.manifest.profileSetCid != cargo.profileSetCid ||
       current.manifest.schemaCid != cargo.schemaCid ||
       current.manifest.factsRoot != cargo.factsRoot ||
       current.manifest.dagRootCid != cargo.dagRootCid ||
       current.manifest.factCount != cargo.factCount ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.manifest.csgcObjectCid) ||
       current.manifest.partitions.len == 0:
        err =
            " compiler snapshot lowering bridge: immutable Cargo HEAD mismatch"
        return false
    let cargoSourceId =
        snapshot_cargo.CsgCompilerSnapshotCargoMerkleSourceId()
    for index in 0..<current.manifest.partitions.len:
        if current.manifest.partitions[index].sourceId != cargoSourceId:
            err =
                " compiler snapshot lowering bridge: immutable Cargo source mismatch"
            return false
    let storeRoot = chengpath.PathJoin(
        canonicalWorkspaceRoot, storeName)
    var read = merkle_store.CsgCoreMerkleStoreReadObject(
        storeRoot,
        merkle_store.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
        current.manifest.csgcObjectCid)
    defer:
        rawbytes.BytesFree(read.bytes)
    if !read.ok || read.error.len != 0 ||
       read.cid != current.manifest.csgcObjectCid ||
       rawbytes.BytesLen(read.bytes) != cargo.csgcByteCount ||
       !rawbytes.BytesEqual(read.bytes, cargo.csgcBytes):
        err =
            " compiler snapshot lowering bridge: immutable Cargo bytes mismatch"
        return false
    let rawCargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(read.bytes))
    if !layout.FixedBytes32Equal(rawCargoCid, cargo.cargoCid) ||
       !compilerSnapshotLoweringBridgeCargoExact(cargo):
        err =
            " compiler snapshot lowering bridge: immutable Cargo CID mismatch"
        return false
    var binding: CsgCompilerSnapshotImmutableCargoStoreBinding
    binding.ok = true
    binding.storeName = strings.CloneStr(storeName)
    binding.storeIdentityCid = strings.CloneStr(storeIdentityCid)
    binding.headCid = strings.CloneStr(current.head.headCid)
    binding.manifestCid = strings.CloneStr(current.head.manifestCid)
    binding.receiptCid = strings.CloneStr(current.head.receiptCid)
    binding.csgcObjectCid =
        strings.CloneStr(current.manifest.csgcObjectCid)
    binding.factsRoot = strings.CloneStr(current.manifest.factsRoot)
    binding.dagRootCid = strings.CloneStr(current.manifest.dagRootCid)
    binding.generation = current.head.generation
    out = binding
    err = ""
    return true

@borrows
fn CsgCompilerSnapshotImmutableCargoStoreEnsureInto(
        canonicalWorkspaceRoot: str,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        out: var CsgCompilerSnapshotImmutableCargoStoreBinding,
        err: var str): bool =
    out = CsgCompilerSnapshotImmutableCargoStoreBinding()
    var canonicalRoot: str
    let storeIdentityCid =
        CsgCompilerSnapshotCargoStoreIdentityCid(cargo)
    let storeName = CsgCompilerSnapshotCargoStoreName(cargo)
    if !parser.ParserSourceIdentityLexicalPathInto(
           canonicalWorkspaceRoot, canonicalRoot) ||
       canonicalRoot != canonicalWorkspaceRoot ||
       !parser.ParserSourceIdentityPathAbsolute(canonicalRoot) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(storeIdentityCid) ||
       storeName.len == 0 ||
       !compilerSnapshotLoweringBridgeCargoExact(cargo):
        err =
            " compiler snapshot lowering bridge: immutable Cargo store input invalid"
        return false
    var current = compilerSnapshotLoweringBridgeReadHeadOrAbsent(
        canonicalRoot, storeName)
    var created = false
    if !current.ok:
        err = current.error.len > 0 ?
            strings.CloneStr(current.error) :
            " compiler snapshot lowering bridge: immutable Cargo store read failed"
        return false
    if !current.present:
        var receipt: snapshot_cargo.CsgCompilerSnapshotMerkleTransaction
        if !compilerSnapshotLoweringBridgeMerkleBootstrapAtInto(
               canonicalRoot, storeName, cargo, receipt, err):
            return false
        if !receipt.ok || !receipt.productionApplied || receipt.reused ||
           receipt.error.len != 0:
            err = receipt.error.len > 0 ?
                strings.CloneStr(receipt.error) :
                " compiler snapshot lowering bridge: immutable Cargo bootstrap failed"
            return false
        created = true
        current = merkle_store.CsgCoreMerkleStoreReadHead(
            canonicalRoot, storeName)
    var binding: CsgCompilerSnapshotImmutableCargoStoreBinding
    if !compilerSnapshotLoweringBridgeImmutableCargoHeadExact(
           canonicalRoot,
           storeName,
           storeIdentityCid,
           cargo,
           current,
           binding,
           err):
        return false
    binding.reused = !created
    out = binding
    err = ""
    return true

@borrows
fn CsgCompilerSnapshotFreshOriginCid(
        cargoStoreIdentityCid: str,
        sourceBundleCid: layout.FixedBytes32,
        sourceIdentityReceiptCid: layout.FixedBytes32): str =
    if !merkle_codec.CsgCoreMerkleStoreCidValid(cargoStoreIdentityCid) ||
       layout.FixedBytes32Equal(
           sourceBundleCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           sourceIdentityReceiptCid, layout.FixedBytes32()):
        return ""
    let domain = "csg_core.compiler_snapshot.fresh_origin"
    var payload = layout.ByteBufInit(256)
    compilerSnapshotLoweringBridgeAppendText(payload, domain)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginFresh)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargoStoreIdentityCid)
    layout.ByteBufAppendFixed32(payload, sourceBundleCid)
    layout.ByteBufAppendFixed32(payload, sourceIdentityReceiptCid)
    var bytes = layout.ByteBufToBytes(payload)
    let out = merkle_codec.CsgCoreMerkleStoreDomainBytesCid(domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn CsgCompilerSnapshotLegacyMigrationInputInto(
        canonicalWorkspaceRoot: str,
        cargoStoreIdentityCid: str,
        sourceBundleCid: layout.FixedBytes32,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        out: var CsgCompilerSnapshotLegacyMigrationInput,
        err: var str): bool =
    out = CsgCompilerSnapshotLegacyMigrationInput()
    var canonicalRoot: str
    if !parser.ParserSourceIdentityLexicalPathInto(
           canonicalWorkspaceRoot, canonicalRoot) ||
       canonicalRoot != canonicalWorkspaceRoot ||
       !parser.ParserSourceIdentityPathAbsolute(canonicalRoot) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(cargoStoreIdentityCid) ||
       layout.FixedBytes32Equal(
           sourceBundleCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           sourceIdentityReceiptCid, layout.FixedBytes32()):
        err =
            " compiler snapshot lowering bridge: migration input invalid"
        return false
    let current = compilerSnapshotLoweringBridgeReadHeadOrAbsent(
        canonicalRoot, compilerSnapshotLoweringBridgeMerkleStoreName)
    if !current.ok:
        err = current.error.len > 0 ?
            strings.CloneStr(current.error) :
            " compiler snapshot lowering bridge: legacy store read failed"
        return false
    if !current.present:
        let freshCid = CsgCompilerSnapshotFreshOriginCid(
            cargoStoreIdentityCid,
            sourceBundleCid,
            sourceIdentityReceiptCid)
        if !merkle_codec.CsgCoreMerkleStoreCidValid(freshCid):
            err =
                " compiler snapshot lowering bridge: fresh origin invalid"
            return false
        var fresh: CsgCompilerSnapshotLegacyMigrationInput
        fresh.ok = true
        fresh.originKind =
            snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginFresh
        fresh.originCid = strings.CloneStr(freshCid)
        fresh.freshOrigin = true
        fresh.inputCid = freshCid
        out = fresh
        err = ""
        return true
    if current.head.generation < int64(1) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(current.head.headCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.manifestCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.receiptCid) ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0 ||
       current.manifest.runtimeRequirementCount != 0 ||
       current.manifest.factCount <= 0 ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.manifest.csgcObjectCid):
        err =
            " compiler snapshot lowering bridge: legacy store HEAD invalid"
        return false
    let legacyRoot = chengpath.PathJoin(
        canonicalRoot, compilerSnapshotLoweringBridgeMerkleStoreName)
    var read = merkle_store.CsgCoreMerkleStoreReadObject(
        legacyRoot,
        merkle_store.CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
        current.manifest.csgcObjectCid)
    defer:
        rawbytes.BytesFree(read.bytes)
    var factsRootCid: layout.FixedBytes32
    if !read.ok || read.error.len != 0 ||
       read.cid != current.manifest.csgcObjectCid ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           current.manifest.factsRoot, factsRootCid):
        err =
            " compiler snapshot lowering bridge: legacy Cargo object invalid"
        return false
    let verified = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        read.bytes, factsRootCid)
    if !verified.ok || verified.error.len != 0 ||
       verified.standard != current.manifest.standard ||
       !validator.CsgCoreProfilesEqual(
           verified.profiles, current.manifest.profiles) ||
       verified.profileSetCid != current.manifest.profileSetCid ||
       verified.schemaCid != current.manifest.schemaCid ||
       verified.factsRoot != current.manifest.factsRoot ||
       verified.dagRootCid != current.manifest.dagRootCid ||
       verified.factCount != current.manifest.factCount:
        err =
            " compiler snapshot lowering bridge: legacy Cargo verification failed"
        return false
    let legacyRawCargoCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(read.bytes))
    let domain = "csg_core.compiler_snapshot.legacy_migration_input"
    var payload = layout.ByteBufInit(1024)
    compilerSnapshotLoweringBridgeAppendText(payload, domain)
    compilerSnapshotLoweringBridgeAppendI32(
        payload,
        snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginLegacyMigration)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargoStoreIdentityCid)
    layout.ByteBufAppendFixed32(payload, sourceBundleCid)
    layout.ByteBufAppendFixed32(payload, sourceIdentityReceiptCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, "csg_core.compiler_snapshot.legacy_store")
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.head.headCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.head.manifestCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.head.receiptCid)
    compilerSnapshotLoweringBridgeAppendI64(
        payload, current.head.generation)
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.manifest.csgcObjectCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.manifest.factsRoot)
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.manifest.dagRootCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.manifest.standard)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, current.manifest.profiles.len)
    for index in 0..<current.manifest.profiles.len:
        compilerSnapshotLoweringBridgeAppendText(
            payload, current.manifest.profiles[index])
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.manifest.profileSetCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, current.manifest.schemaCid)
    compilerSnapshotLoweringBridgeAppendI32(
        payload, current.manifest.factCount)
    layout.ByteBufAppendFixed32(payload, legacyRawCargoCid)
    var bytes = layout.ByteBufToBytes(payload)
    let inputCid = merkle_codec.CsgCoreMerkleStoreDomainBytesCid(
        domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    if !merkle_codec.CsgCoreMerkleStoreCidValid(inputCid):
        err =
            " compiler snapshot lowering bridge: legacy migration CID invalid"
        return false
    var migration: CsgCompilerSnapshotLegacyMigrationInput
    migration.ok = true
    migration.originKind =
        snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginLegacyMigration
    migration.originCid = strings.CloneStr(inputCid)
    migration.legacyPresent = true
    migration.inputCid = inputCid
    migration.legacyHeadCid = strings.CloneStr(current.head.headCid)
    migration.legacyManifestCid =
        strings.CloneStr(current.head.manifestCid)
    migration.legacyReceiptCid =
        strings.CloneStr(current.head.receiptCid)
    migration.legacyCsgcObjectCid =
        strings.CloneStr(current.manifest.csgcObjectCid)
    migration.legacyFactsRoot =
        strings.CloneStr(current.manifest.factsRoot)
    migration.legacyDagRootCid =
        strings.CloneStr(current.manifest.dagRootCid)
    migration.legacyGeneration = current.head.generation
    out = migration
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeEnvelopeGenesisMarkerCid(
        envelopeStoreIdentityCid: str,
        originKind: int32,
        originCid: str): str =
    if !merkle_codec.CsgCoreMerkleStoreCidValid(
           envelopeStoreIdentityCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(originCid) ||
       (originKind !=
            snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginFresh &&
        originKind !=
            snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginLegacyMigration):
        return ""
    let domain = "csg_core.compiler_snapshot.envelope_genesis_marker"
    var payload = layout.ByteBufInit(256)
    compilerSnapshotLoweringBridgeAppendText(payload, domain)
    compilerSnapshotLoweringBridgeAppendText(
        payload, envelopeStoreIdentityCid)
    compilerSnapshotLoweringBridgeAppendI32(payload, originKind)
    compilerSnapshotLoweringBridgeAppendText(payload, originCid)
    var bytes = layout.ByteBufToBytes(payload)
    let out = merkle_codec.CsgCoreMerkleStoreDomainBytesCid(domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerSnapshotLoweringBridgeEnvelopeBindingInto(
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        cargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding,
        migration: CsgCompilerSnapshotLegacyMigrationInput,
        snapshotSchemaVersion: int32,
        semanticEpoch: int64,
        snapshotPredecessorReceiptCid: layout.FixedBytes32,
        worldHeadCid: layout.FixedBytes32,
        executionCid: layout.FixedBytes32,
        sourceBundleCid: layout.FixedBytes32,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        previousEnvelopeHeadCid: str,
        previousEnvelopeReceiptCid: str,
        out: var snapshot_cargo.CsgCompilerSnapshotEnvelopeBinding,
        err: var str): bool =
    let cargoStoreIdentity =
        CsgCompilerSnapshotCargoStoreIdentityCid(cargo)
    if !cargoStore.ok || cargoStore.error.len != 0 ||
       cargoStore.storeIdentityCid != cargoStoreIdentity ||
       !migration.ok || migration.error.len != 0 ||
       migration.legacyPresent == migration.freshOrigin ||
       (migration.originKind !=
            snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginFresh &&
        migration.originKind !=
            snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginLegacyMigration) ||
       migration.originCid != migration.inputCid ||
       (migration.freshOrigin &&
        migration.originKind !=
            snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginFresh) ||
       (migration.legacyPresent &&
        migration.originKind !=
            snapshot_cargo.CsgCompilerSnapshotEnvelopeOriginLegacyMigration) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(migration.originCid):
        err =
            " compiler snapshot lowering bridge: envelope binding input invalid"
        return false
    var binding: snapshot_cargo.CsgCompilerSnapshotEnvelopeBinding
    binding.ok = true
    binding.snapshotSchemaVersion = snapshotSchemaVersion
    binding.semanticEpoch = semanticEpoch
    binding.snapshotPredecessorReceiptCid =
        snapshotPredecessorReceiptCid
    binding.worldHeadCid = worldHeadCid
    binding.executionCid = executionCid
    binding.sourceBundleCid = sourceBundleCid
    binding.sourceIdentityReceiptCid = sourceIdentityReceiptCid
    binding.originKind = migration.originKind
    binding.originCid = strings.CloneStr(migration.originCid)
    binding.previousEnvelopeHeadCid =
        strings.CloneStr(previousEnvelopeHeadCid)
    binding.previousEnvelopeReceiptCid =
        strings.CloneStr(previousEnvelopeReceiptCid)
    binding.cargoStoreIdentityCid =
        strings.CloneStr(cargoStore.storeIdentityCid)
    binding.cargoStoreHeadCid = strings.CloneStr(cargoStore.headCid)
    binding.cargoStoreManifestCid =
        strings.CloneStr(cargoStore.manifestCid)
    binding.cargoStoreReceiptCid =
        strings.CloneStr(cargoStore.receiptCid)
    binding.cargoStoreCsgcObjectCid =
        strings.CloneStr(cargoStore.csgcObjectCid)
    binding.cargoCid = cargo.cargoCid
    binding.cargoByteCount = cargo.csgcByteCount
    binding.standard = strings.CloneStr(cargo.standard)
    binding.profiles = validator.CsgCoreProfilesClone(cargo.profiles)
    binding.profileSetCid = strings.CloneStr(cargo.profileSetCid)
    binding.schemaNamespace = strings.CloneStr(cargo.schemaNamespace)
    binding.schemaCid = strings.CloneStr(cargo.schemaCid)
    binding.factsRoot = strings.CloneStr(cargo.factsRoot)
    binding.factsSubgraphCid = strings.CloneStr(cargo.factsSubgraphCid)
    binding.dagRootCid = strings.CloneStr(cargo.dagRootCid)
    binding.proofRoots = cargo.proofRoots
    var identity =
        snapshot_cargo.CsgCompilerSnapshotEnvelopeIdentityBuild(binding)
    defer:
        snapshot_cargo.CsgCompilerSnapshotEnvelopeIdentityRelease(identity)
    if !identity.ok || identity.error.len != 0:
        snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
        err = identity.error.len > 0 ?
            strings.CloneStr(identity.error) :
            " compiler snapshot lowering bridge: envelope binding rejected"
        return false
    out = binding
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeEnvelopeBootstrapInto(
        canonicalWorkspaceRoot: str,
        storeName: str,
        storeIdentityCid: str,
        genesisBinding: snapshot_cargo.CsgCompilerSnapshotEnvelopeBinding,
        outHead: var merkle_store.CsgCoreMerkleHead,
        err: var str): bool =
    let expectedStoreName = Fmt"{compilerSnapshotLoweringBridgeEnvelopeStorePrefix}{strings.CloneStrRange(storeIdentityCid, 7, 64)}"
    if !merkle_codec.CsgCoreMerkleStoreCidValid(storeIdentityCid) ||
       storeName != expectedStoreName:
        err =
            " compiler snapshot lowering bridge: envelope store identity mismatch"
        return false
    var identity =
        snapshot_cargo.CsgCompilerSnapshotEnvelopeIdentityBuild(
            genesisBinding)
    if !identity.ok || identity.canonicalLines.len != 2:
        err = identity.error.len > 0 ?
            strings.CloneStr(identity.error) :
            " compiler snapshot lowering bridge: envelope genesis invalid"
        snapshot_cargo.CsgCompilerSnapshotEnvelopeIdentityRelease(identity)
        return false
    var source: merkle_builder.CsgCoreMerkleBuilderSource
    source.sourceId = strings.CloneStr(identity.sourceId)
    source.sourceCid = strings.CloneStr(identity.sourceCid)
    source.factsProvenCanonical = true
    for index in 0..<identity.canonicalLines.len:
        add(source.facts, strings.CloneStr(identity.canonicalLines[index]))
    var closure = merkle_builder.CsgCoreMerkleBuildClosure(
        validator.CsgCoreStandardIdentity(),
        [validator.CsgCoreBaseProfileIdentity()],
        [source],
        [])
    if !closure.ok || !closure.admission.ok || closure.factCount != 2 ||
       closure.partitions.len == 0:
        err = closure.error.len > 0 ?
            strings.CloneStr(closure.error) :
            " compiler snapshot lowering bridge: envelope genesis closure invalid"
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
        snapshot_cargo.CsgCompilerSnapshotEnvelopeIdentityRelease(identity)
        return false
    let bootstrap =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrapExclusive(
            canonicalWorkspaceRoot, storeName, closure)
    if !bootstrap.ok || !bootstrap.published || bootstrap.reused ||
       bootstrap.head.generation != int64(0) ||
       bootstrap.head.previousHeadCid != "none" ||
       bootstrap.head.receiptCid != "none" ||
       bootstrap.head.manifestCid != closure.manifestArtifact.cid:
        err = bootstrap.error.len > 0 ?
            strings.CloneStr(bootstrap.error) :
            " compiler snapshot lowering bridge: envelope genesis publish failed"
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
        snapshot_cargo.CsgCompilerSnapshotEnvelopeIdentityRelease(identity)
        return false
    outHead = bootstrap.head
    merkle_builder.CsgCoreMerkleBuilderFree(closure)
    snapshot_cargo.CsgCompilerSnapshotEnvelopeIdentityRelease(identity)
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeMigrationReceiptCid(
        envelopeStoreIdentityCid: str,
        cargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding,
        migration: CsgCompilerSnapshotLegacyMigrationInput,
        applied: snapshot_cargo.CsgCompilerSnapshotMerkleTransaction,
        generation: int64): str =
    if !merkle_codec.CsgCoreMerkleStoreCidValid(
           envelopeStoreIdentityCid) ||
       !cargoStore.ok || !migration.ok || !applied.ok ||
       !applied.productionApplied || generation < int64(1):
        return ""
    let domain = "csg_core.compiler_snapshot.migration_receipt"
    var payload = layout.ByteBufInit(1024)
    compilerSnapshotLoweringBridgeAppendText(payload, domain)
    compilerSnapshotLoweringBridgeAppendText(
        payload, envelopeStoreIdentityCid)
    compilerSnapshotLoweringBridgeAppendI32(
        payload,
        migration.originKind)
    compilerSnapshotLoweringBridgeAppendText(
        payload, migration.originCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargoStore.storeIdentityCid)
    compilerSnapshotLoweringBridgeAppendText(payload, cargoStore.headCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargoStore.manifestCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargoStore.receiptCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, cargoStore.csgcObjectCid)
    compilerSnapshotLoweringBridgeAppendText(payload, applied.requestCid)
    compilerSnapshotLoweringBridgeAppendText(
        payload, applied.transactionPlanRoot)
    compilerSnapshotLoweringBridgeAppendText(payload, applied.planRoot)
    compilerSnapshotLoweringBridgeAppendText(payload, applied.receiptCid)
    compilerSnapshotLoweringBridgeAppendText(payload, applied.headCid)
    compilerSnapshotLoweringBridgeAppendText(payload, applied.manifestCid)
    compilerSnapshotLoweringBridgeAppendI64(payload, generation)
    var bytes = layout.ByteBufToBytes(payload)
    let out = merkle_codec.CsgCoreMerkleStoreDomainBytesCid(domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return out

@borrows
fn CsgCompilerSnapshotEnvelopeStoreCommitInto(
        canonicalWorkspaceRoot: str,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        cargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding,
        migration: CsgCompilerSnapshotLegacyMigrationInput,
        snapshotSchemaVersion: int32,
        semanticEpoch: int64,
        snapshotPredecessorReceiptCid: layout.FixedBytes32,
        worldHeadCid: layout.FixedBytes32,
        executionCid: layout.FixedBytes32,
        sourceBundleCid: layout.FixedBytes32,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        out: var CsgCompilerSnapshotEnvelopeStoreReceipt,
        err: var str): bool =
    out = CsgCompilerSnapshotEnvelopeStoreReceipt()
    let expectedCargoStoreName =
        CsgCompilerSnapshotCargoStoreName(cargo)
    let cargoCurrent = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, expectedCargoStoreName)
    var exactCargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding
    defer:
        CsgCompilerSnapshotImmutableCargoStoreBindingRelease(
            exactCargoStore)
    if !compilerSnapshotLoweringBridgeImmutableCargoHeadExact(
           canonicalWorkspaceRoot,
           expectedCargoStoreName,
           CsgCompilerSnapshotCargoStoreIdentityCid(cargo),
           cargo,
           cargoCurrent,
           exactCargoStore,
           err) ||
       exactCargoStore.headCid != cargoStore.headCid ||
       exactCargoStore.manifestCid != cargoStore.manifestCid ||
       exactCargoStore.receiptCid != cargoStore.receiptCid ||
       exactCargoStore.csgcObjectCid != cargoStore.csgcObjectCid:
        if err.len == 0:
            err =
                " compiler snapshot lowering bridge: envelope Cargo authority mismatch"
        return false
    let storeIdentityCid =
        CsgCompilerSnapshotEnvelopeStoreIdentityCid(cargo)
    let storeName = CsgCompilerSnapshotEnvelopeStoreName(cargo)
    if !merkle_codec.CsgCoreMerkleStoreCidValid(storeIdentityCid) ||
       storeName.len == 0:
        err =
            " compiler snapshot lowering bridge: envelope store identity invalid"
        return false
    var current = compilerSnapshotLoweringBridgeReadHeadOrAbsent(
        canonicalWorkspaceRoot, storeName)
    if !current.ok:
        err = current.error.len > 0 ?
            strings.CloneStr(current.error) :
            " compiler snapshot lowering bridge: envelope store read failed"
        return false
    var bootstrapApplied = false
    var previousHeadCid: str
    var previousReceiptCid: str
    if !current.present:
        let marker =
            compilerSnapshotLoweringBridgeEnvelopeGenesisMarkerCid(
                storeIdentityCid,
                migration.originKind,
                migration.originCid)
        var genesisBinding: snapshot_cargo.CsgCompilerSnapshotEnvelopeBinding
        if !compilerSnapshotLoweringBridgeEnvelopeBindingInto(
               cargo,
               exactCargoStore,
               migration,
               snapshotSchemaVersion,
               semanticEpoch,
               snapshotPredecessorReceiptCid,
               worldHeadCid,
               executionCid,
               sourceBundleCid,
               sourceIdentityReceiptCid,
               marker,
               marker,
               genesisBinding,
               err):
            return false
        var genesisHead: merkle_store.CsgCoreMerkleHead
        let genesisOk =
            compilerSnapshotLoweringBridgeEnvelopeBootstrapInto(
                canonicalWorkspaceRoot,
                storeName,
                storeIdentityCid,
                genesisBinding,
                genesisHead,
                err)
        snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(
            genesisBinding)
        if !genesisOk:
            return false
        bootstrapApplied = true
        previousHeadCid = strings.CloneStr(genesisHead.headCid)
        previousReceiptCid = strings.CloneStr(marker)
        current = merkle_store.CsgCoreMerkleStoreReadHead(
            canonicalWorkspaceRoot, storeName)
    else:
        if current.head.generation < int64(1) ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(
               current.head.receiptCid):
            err =
                " compiler snapshot lowering bridge: envelope predecessor invalid"
            return false
        previousHeadCid = strings.CloneStr(current.head.headCid)
        previousReceiptCid = strings.CloneStr(current.head.receiptCid)
    if !current.ok || !current.present ||
       current.head.headCid != previousHeadCid ||
       current.manifest.factCount != 2 ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0 ||
       current.manifest.runtimeRequirementCount != 0 ||
       current.manifest.partitions.len == 0:
        err =
            " compiler snapshot lowering bridge: envelope HEAD invalid"
        return false
    var binding: snapshot_cargo.CsgCompilerSnapshotEnvelopeBinding
    if !compilerSnapshotLoweringBridgeEnvelopeBindingInto(
           cargo,
           exactCargoStore,
           migration,
           snapshotSchemaVersion,
           semanticEpoch,
           snapshotPredecessorReceiptCid,
           worldHeadCid,
           executionCid,
           sourceBundleCid,
           sourceIdentityReceiptCid,
           previousHeadCid,
           previousReceiptCid,
           binding,
           err):
        return false
    let expectedSourceId =
        snapshot_cargo.CsgCompilerSnapshotEnvelopeSourceId(binding)
    for index in 0..<current.manifest.partitions.len:
        if current.manifest.partitions[index].sourceId != expectedSourceId:
            snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
            err =
                " compiler snapshot lowering bridge: envelope source identity mismatch"
            return false
    var planned =
        snapshot_cargo.csgCompilerSnapshotEnvelopeMerklePlan(
            canonicalWorkspaceRoot,
            storeName,
            previousHeadCid,
            binding)
    if !planned.ok || !planned.planReady || planned.productionApplied ||
       planned.error.len != 0 || planned.operationCount != 1 ||
       planned.operationKind !=
           merkle_transaction.CsgTransactionReplace:
        err = planned.error.len > 0 ?
            strings.CloneStr(planned.error) :
            " compiler snapshot lowering bridge: envelope plan rejected"
        snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(planned)
        snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
        return false
    var applied =
        snapshot_cargo.csgCompilerSnapshotEnvelopeMerkleApply(
            canonicalWorkspaceRoot,
            storeName,
            previousHeadCid,
            binding)
    if !applied.ok || !applied.planReady ||
       !applied.productionApplied || applied.reused ||
       applied.error.len != 0 ||
       applied.operationCount != 1 ||
       applied.operationKind !=
           merkle_transaction.CsgTransactionReplace ||
       applied.requestCid != planned.requestCid ||
       applied.transactionPlanRoot != planned.transactionPlanRoot ||
       applied.headCid == previousHeadCid:
        err = applied.error.len > 0 ?
            strings.CloneStr(applied.error) :
            " compiler snapshot lowering bridge: envelope apply rejected"
        snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(applied)
        snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(planned)
        snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
        return false
    let committed = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, storeName)
    if !committed.ok || !committed.present ||
       committed.head.headCid != applied.headCid ||
       committed.head.manifestCid != applied.manifestCid ||
       committed.head.receiptCid != applied.receiptCid ||
       committed.head.previousHeadCid != previousHeadCid ||
       committed.head.generation != current.head.generation + int64(1) ||
       committed.manifest.factCount != 2:
        err =
            " compiler snapshot lowering bridge: envelope commit mismatch"
        snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(applied)
        snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(planned)
        snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
        return false
    let migrationReceiptCid =
        compilerSnapshotLoweringBridgeMigrationReceiptCid(
            storeIdentityCid,
            exactCargoStore,
            migration,
            applied,
            committed.head.generation)
    if !merkle_codec.CsgCoreMerkleStoreCidValid(migrationReceiptCid):
        err =
            " compiler snapshot lowering bridge: migration receipt invalid"
        snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(applied)
        snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(planned)
        snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
        return false
    var receipt: CsgCompilerSnapshotEnvelopeStoreReceipt
    receipt.ok = true
    receipt.storeName = strings.CloneStr(storeName)
    receipt.storeIdentityCid = strings.CloneStr(storeIdentityCid)
    receipt.migrationReceiptCid = strings.CloneStr(migrationReceiptCid)
    receipt.headCid = strings.CloneStr(applied.headCid)
    receipt.manifestCid = strings.CloneStr(applied.manifestCid)
    receipt.receiptCid = strings.CloneStr(applied.receiptCid)
    receipt.requestCid = strings.CloneStr(applied.requestCid)
    receipt.planRoot = strings.CloneStr(applied.planRoot)
    receipt.generation = committed.head.generation
    receipt.bootstrapApplied = bootstrapApplied
    receipt.operationCount = applied.operationCount
    receipt.operationKind = applied.operationKind
    snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(applied)
    snapshot_cargo.CsgCompilerSnapshotMerkleTransactionRelease(planned)
    snapshot_cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
    out = receipt
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeAuthorityStoreBindingInto(
        canonicalWorkspaceRoot: str,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        cargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding,
        envelope: CsgCompilerSnapshotEnvelopeStoreReceipt,
        out: var
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding,
        err: var str): bool =
    out =
        snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding()
    let cargoStoreName = CsgCompilerSnapshotCargoStoreName(cargo)
    let cargoStoreIdentityCid =
        CsgCompilerSnapshotCargoStoreIdentityCid(cargo)
    var exactCargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding
    defer:
        CsgCompilerSnapshotImmutableCargoStoreBindingRelease(
            exactCargoStore)
    let cargoCurrent = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, cargoStoreName)
    if !compilerSnapshotLoweringBridgeImmutableCargoHeadExact(
           canonicalWorkspaceRoot,
           cargoStoreName,
           cargoStoreIdentityCid,
           cargo,
           cargoCurrent,
           exactCargoStore,
           err) ||
       exactCargoStore.headCid != cargoStore.headCid ||
       exactCargoStore.manifestCid != cargoStore.manifestCid ||
       exactCargoStore.receiptCid != cargoStore.receiptCid ||
       exactCargoStore.csgcObjectCid != cargoStore.csgcObjectCid:
        if err.len == 0:
            err =
                " compiler snapshot lowering bridge: authority Cargo store changed"
        return false
    let envelopeStoreName = CsgCompilerSnapshotEnvelopeStoreName(cargo)
    let envelopeStoreIdentityCid =
        CsgCompilerSnapshotEnvelopeStoreIdentityCid(cargo)
    let envelopeCurrent = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, envelopeStoreName)
    if !envelope.ok || envelope.error.len != 0 ||
       envelope.storeName != envelopeStoreName ||
       envelope.storeIdentityCid != envelopeStoreIdentityCid ||
       envelope.operationCount != 1 ||
       envelope.operationKind !=
           merkle_transaction.CsgTransactionReplace ||
       !envelopeCurrent.ok || !envelopeCurrent.present ||
       envelopeCurrent.head.headCid != envelope.headCid ||
       envelopeCurrent.head.manifestCid != envelope.manifestCid ||
       envelopeCurrent.head.receiptCid != envelope.receiptCid ||
       envelopeCurrent.manifest.factCount != 2 ||
       !envelopeCurrent.manifest.complete ||
       envelopeCurrent.manifest.unsupportedCount != 0 ||
       envelopeCurrent.manifest.tombstoneCount != 0 ||
       envelopeCurrent.manifest.runtimeRequirementCount != 0 ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           envelopeCurrent.manifest.csgcObjectCid):
        err =
            " compiler snapshot lowering bridge: authority envelope store changed"
        return false
    if !compilerSnapshotLoweringBridgeCidTextInto(
           cargoStoreIdentityCid, out.cargoStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           exactCargoStore.headCid, out.cargoStoreHeadCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           exactCargoStore.manifestCid, out.cargoStoreManifestCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           exactCargoStore.receiptCid, out.cargoStoreReceiptCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           exactCargoStore.csgcObjectCid,
           out.cargoStoreCsgcObjectCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           envelopeStoreIdentityCid, out.envelopeStoreIdentityCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           envelopeCurrent.head.headCid, out.envelopeHeadCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           envelopeCurrent.head.manifestCid,
           out.envelopeManifestCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           envelopeCurrent.head.receiptCid,
           out.envelopeReceiptCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           envelope.migrationReceiptCid,
           out.envelopeMigrationReceiptCid) ||
       !compilerSnapshotLoweringBridgeCidTextInto(
           envelopeCurrent.manifest.csgcObjectCid,
           out.envelopeCsgcObjectCid) ||
       !compilerSnapshotLoweringBridgeStoreBindingObserved(out):
        out =
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding()
        err =
            " compiler snapshot lowering bridge: authority store CID decode rejected"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeAuthorityStoreBindingCurrentInto(
        canonicalWorkspaceRoot: str,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        expected:
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding,
        out: var
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding,
        err: var str): bool =
    out =
        snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding()
    var cargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding
    var envelopeReceipt: CsgCompilerSnapshotEnvelopeStoreReceipt
    defer:
        CsgCompilerSnapshotImmutableCargoStoreBindingRelease(cargoStore)
        CsgCompilerSnapshotEnvelopeStoreReceiptRelease(envelopeReceipt)
    let cargoStoreName = CsgCompilerSnapshotCargoStoreName(cargo)
    let cargoCurrent = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, cargoStoreName)
    if !compilerSnapshotLoweringBridgeImmutableCargoHeadExact(
           canonicalWorkspaceRoot,
           cargoStoreName,
           CsgCompilerSnapshotCargoStoreIdentityCid(cargo),
           cargo,
           cargoCurrent,
           cargoStore,
           err):
        return false
    let envelopeStoreName = CsgCompilerSnapshotEnvelopeStoreName(cargo)
    let envelopeCurrent = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, envelopeStoreName)
    if !envelopeCurrent.ok || !envelopeCurrent.present ||
       envelopeCurrent.manifest.factCount != 2 ||
       !envelopeCurrent.manifest.complete:
        err =
            " compiler snapshot lowering bridge: current envelope missing"
        return false
    envelopeReceipt.ok = true
    envelopeReceipt.storeName = strings.CloneStr(envelopeStoreName)
    envelopeReceipt.storeIdentityCid =
        CsgCompilerSnapshotEnvelopeStoreIdentityCid(cargo)
    envelopeReceipt.migrationReceiptCid = Fmt"sha256:{layout.FixedBytes32Hex(expected.envelopeMigrationReceiptCid)}"
    envelopeReceipt.headCid =
        strings.CloneStr(envelopeCurrent.head.headCid)
    envelopeReceipt.manifestCid =
        strings.CloneStr(envelopeCurrent.head.manifestCid)
    envelopeReceipt.receiptCid =
        strings.CloneStr(envelopeCurrent.head.receiptCid)
    envelopeReceipt.operationCount = 1
    envelopeReceipt.operationKind =
        merkle_transaction.CsgTransactionReplace
    if !compilerSnapshotLoweringBridgeAuthorityStoreBindingInto(
           canonicalWorkspaceRoot,
           cargo,
           cargoStore,
           envelopeReceipt,
           out,
           err):
        return false
    if !compilerSnapshotLoweringBridgeStoreBindingEqual(out, expected):
        out =
            snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding()
        err =
            " compiler snapshot lowering bridge: current authority stores changed"
        return false
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeMerklePolicyIssueInto(
        linkPlan: var slplan.SystemLinkPlanStub,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        out: var compilerSnapshotLoweringBridgeMerklePolicy,
        bootstrapReceipt:
            var snapshot_cargo.CsgCompilerSnapshotMerkleTransaction,
        bootstrapApplied: var bool,
        err: var str): bool =
    var canonicalWorkspaceRoot: str
    if !linkPlan.compilerInputReleaseReceiptConsumed ||
       !linkPlan.compilerInputReleaseReceipt.storageReleased ||
       !linkPlan.compilerInputReleaseReceipt.sourceBundleMoved ||
       layout.FixedBytes32Equal(
           linkPlan.compilerInputReleaseReceipt.ownerToken,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           linkPlan.compilerInputReleaseReceipt.sourceBundleOwnerToken,
           layout.FixedBytes32()) ||
       !parser.ParserSourceIdentityLexicalPathInto(
           linkPlan.workspaceRoot, canonicalWorkspaceRoot) ||
       canonicalWorkspaceRoot != linkPlan.workspaceRoot ||
       !parser.ParserSourceIdentityPathAbsolute(canonicalWorkspaceRoot) ||
       linkPlan.packageId.len == 0 ||
       compilerExecution.targetTriple != linkPlan.targetTriple ||
       !cargo.ok || cargo.factCount <= 0:
        err =
            " compiler snapshot lowering bridge: Merkle policy input invalid"
        return false
    let executionVerified =
        execution.CompilerExecutionIdentityVerify(compilerExecution)
    if IsErr(executionVerified):
        err = Error(executionVerified)
        return false
    if !cworld.CompilerLocalUniverseStrictValidateInto(universe, err) ||
       !layout.FixedBytes32Equal(
           compilerExecution.sourceBundleRaw32,
           universe.compilerSnapshot.sourceBundleCid):
        if err.len == 0:
            err =
                " compiler snapshot lowering bridge: compiler universe identity mismatch"
        return false
    var current = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot,
        compilerSnapshotLoweringBridgeMerkleStoreName)
    bootstrapApplied = false
    if !current.ok || !current.present:
        var bootstrap: snapshot_cargo.CsgCompilerSnapshotMerkleTransaction
        if !compilerSnapshotLoweringBridgeMerkleBootstrapInto(
               canonicalWorkspaceRoot, cargo, bootstrap, err):
            return false
        if !bootstrap.ok || !bootstrap.planReady ||
           !bootstrap.productionApplied || bootstrap.reused ||
           bootstrap.error.len != 0 ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(
               bootstrap.requestCid) ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(
               bootstrap.transactionPlanRoot) ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(
               bootstrap.planRoot) ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(
               bootstrap.receiptCid) ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(
               bootstrap.headCid) ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(
               bootstrap.manifestCid) ||
           bootstrap.factsRoot != cargo.factsRoot ||
           bootstrap.factsSubgraphCid != cargo.factsSubgraphCid ||
           bootstrap.sourceId !=
               snapshot_cargo.CsgCompilerSnapshotCargoMerkleSourceId():
            err = bootstrap.error.len > 0 ?
                strings.CloneStr(bootstrap.error) :
                " compiler snapshot lowering bridge: Merkle bootstrap rejected"
            return false
        bootstrapReceipt = bootstrap
        bootstrapApplied = true
        current = merkle_store.CsgCoreMerkleStoreReadHead(
            canonicalWorkspaceRoot,
            compilerSnapshotLoweringBridgeMerkleStoreName)
    if !current.ok || !current.present ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.headCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.manifestCid) ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0 ||
       current.manifest.runtimeRequirementCount != 0 ||
       current.manifest.factCount <= 0 ||
       current.manifest.standard != cargo.standard ||
       current.manifest.profileSetCid != cargo.profileSetCid ||
       current.manifest.schemaCid != cargo.schemaCid ||
       (bootstrapApplied &&
        (current.head.headCid != bootstrapReceipt.headCid ||
         current.head.manifestCid != bootstrapReceipt.manifestCid ||
         current.manifest.factsRoot != cargo.factsRoot ||
         current.manifest.dagRootCid != cargo.dagRootCid ||
         current.manifest.factCount != cargo.factCount)):
        err = current.error.len > 0 ?
            strings.CloneStr(current.error) :
            " compiler snapshot lowering bridge: production Merkle HEAD not admitted"
        return false
    var policy: compilerSnapshotLoweringBridgeMerklePolicy
    policy.parentPath = strings.CloneStr(canonicalWorkspaceRoot)
    policy.storeName = strings.CloneStr(
        compilerSnapshotLoweringBridgeMerkleStoreName)
    policy.expectedHeadCid = strings.CloneStr(current.head.headCid)
    policy.expectedManifestCid =
        strings.CloneStr(current.head.manifestCid)
    policy.packageId = strings.CloneStr(linkPlan.packageId)
    policy.worldHeadCid = universe.worldHead.headCid
    policy.executionCid = compilerExecution.executionRaw32
    policy.sourceBundleCid = linkPlan.sourceBundleCidValue
    policy.cargoCid = cargo.cargoCid
    policy.factsRootCid = cargo.factsRootCid
    policy.factCount = cargo.factCount
    policy.bindingCid =
        compilerSnapshotLoweringBridgeMerklePolicyBindingCid(policy)
    policy.admitted = true
    if !compilerSnapshotLoweringBridgeMerklePolicyValid(policy, cargo):
        err =
            " compiler snapshot lowering bridge: production Merkle policy invalid"
        return false
    out = policy
    err = ""
    return true

fn compilerSnapshotLoweringBridgeOwnerToken(
        tables: var snapshot_schema.CsgCompilerSnapshotTables): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        192 + tables.sources.documentCids.len * 96 +
        tables.functions.fragmentCids.len * 96)
    let domain = "cheng.compiler.snapshot_for_lowering.release"
    for byteIndex in 0..<domain.len:
        layout.ByteBufAppendByte(buf, Int32(domain[byteIndex]) & 255)
    compilerSnapshotLoweringBridgeAppendI32(
        buf, tables.schemaVersion)
    compilerSnapshotLoweringBridgeAppendI64(
        buf, tables.semanticEpoch)
    layout.ByteBufAppendFixed32(buf, tables.predecessorReceiptCid)
    layout.ByteBufAppendFixed32(buf, tables.declarations.tableCid)
    layout.ByteBufAppendFixed32(
        buf, tables.diagnosticCompletions.requiredDomainCid)
    compilerSnapshotLoweringBridgeAppendI32(
        buf, tables.sources.documentCids.len)
    for sourceId in 0..<tables.sources.documentCids.len:
        layout.ByteBufAppendFixed32(
            buf, tables.sources.documentCids[sourceId])
        if sourceId < tables.sources.contentCids.len:
            layout.ByteBufAppendFixed32(
                buf, tables.sources.contentCids[sourceId])
        if sourceId < tables.sources.interfaceCids.len:
            layout.ByteBufAppendFixed32(
                buf, tables.sources.interfaceCids[sourceId])
    compilerSnapshotLoweringBridgeAppendI32(
        buf, tables.functions.fragmentCids.len)
    for functionId in 0..<tables.functions.fragmentCids.len:
        layout.ByteBufAppendFixed32(
            buf, tables.functions.fragmentCids[functionId])
        if functionId < tables.functions.bodyContentCids.len:
            layout.ByteBufAppendFixed32(
                buf, tables.functions.bodyContentCids[functionId])
        if functionId < tables.functions.interfaceCids.len:
            layout.ByteBufAppendFixed32(
                buf, tables.functions.interfaceCids[functionId])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn compilerSnapshotLoweringBridgeRecordSequenceFacts(
        valuesLen: int32,
        valuesCap: int32,
        elemSize: int32,
        releaseStorage: bool,
        releasedSequenceFieldCount: int32,
        releasedBufferCount: int32,
        releasedBytes: int64,
        unreleasedSequenceFieldCount: int32,
        unreleasedBufferCount: int32,
        expectReleased: bool): CompilerSnapshotForLoweringReleaseTally =
    var next: CompilerSnapshotForLoweringReleaseTally
    next.releaseStorage = releaseStorage
    next.releasedSequenceFieldCount = releasedSequenceFieldCount + 1
    next.releasedBufferCount = releasedBufferCount
    next.releasedBytes = releasedBytes
    next.unreleasedSequenceFieldCount = unreleasedSequenceFieldCount
    next.unreleasedBufferCount = unreleasedBufferCount
    if valuesCap < 0:
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: negative sequence capacity")
    if valuesCap > 0:
        next.releasedBufferCount = next.releasedBufferCount + 1
        next.releasedBytes =
            next.releasedBytes +
            int64(valuesCap) * int64(elemSize)
    if expectReleased &&
       (valuesLen != 0 || valuesCap != 0):
        next.unreleasedSequenceFieldCount =
            next.unreleasedSequenceFieldCount + 1
    return next

fn compilerSnapshotLoweringBridgeReleaseSequence(
        values: var T[],
        tally: var CompilerSnapshotForLoweringReleaseTally) =
    if values.cap < 0:
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: negative sequence capacity")
    tally.releasedSequenceFieldCount =
        tally.releasedSequenceFieldCount + 1
    if values.cap > 0:
        tally.releasedBufferCount =
            tally.releasedBufferCount + 1
        tally.releasedBytes =
            tally.releasedBytes +
            int64(values.cap) * int64(sizeof(T))
    if !tally.releaseStorage &&
       (values.len != 0 || values.cap != 0):
        tally.unreleasedSequenceFieldCount =
            tally.unreleasedSequenceFieldCount + 1
    if tally.releaseStorage:
        if values.cap > 0 &&
           (values.buffer == nil ||
            system.memRefCount(values.buffer) != 1):
            compilerSnapshotLoweringBridgeFail(
                "compiler snapshot lowering bridge: sequence storage is shared")
        seqs.freeSeq(values)
    if values.len != 0 || values.cap != 0:
        if tally.releaseStorage:
            compilerSnapshotLoweringBridgeFail(
                "compiler snapshot lowering bridge: sequence physical release incomplete")

fn compilerSnapshotLoweringBridgeReleaseTextSequence(
        values: var str[],
        tally: var CompilerSnapshotForLoweringReleaseTally) =
    if values.cap < 0:
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: negative sequence capacity")
    tally.releasedSequenceFieldCount =
        tally.releasedSequenceFieldCount + 1
    if values.cap > 0:
        tally.releasedBufferCount =
            tally.releasedBufferCount + 1
        tally.releasedBytes =
            tally.releasedBytes +
            int64(values.cap) * int64(sizeof(str))
    if !tally.releaseStorage &&
       (values.len != 0 || values.cap != 0):
        tally.unreleasedSequenceFieldCount =
            tally.unreleasedSequenceFieldCount + 1
    if tally.releaseStorage:
        if values.cap > 0 &&
           (values.buffer == nil ||
            system.memRefCount(values.buffer) != 1):
            compilerSnapshotLoweringBridgeFail(
                "compiler snapshot lowering bridge: text sequence storage is shared")
        seqs.freeSeqStrRelease(values)
    if values.len != 0 || values.cap != 0:
        if tally.releaseStorage:
            compilerSnapshotLoweringBridgeFail(
                "compiler snapshot lowering bridge: text sequence physical release incomplete")

fn compilerSnapshotLoweringBridgeReleaseDeclarationInto(
        table: var declaration.SemanticSnapshotDeclarationTable,
        tally: var CompilerSnapshotForLoweringReleaseTally) =
    let expectReleased = !tally.releaseStorage
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.declIds.len, table.declIds.cap, sizeof(int32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.portableDocumentPackageIds.len, table.portableDocumentPackageIds.cap, sizeof(str),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.portableDocumentModulePaths.len, table.portableDocumentModulePaths.cap, sizeof(str),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.portableDocumentIdentityCids.len, table.portableDocumentIdentityCids.cap, sizeof(layout.FixedBytes32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.ownerDeclIds.len, table.ownerDeclIds.cap, sizeof(int32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.declarationKinds.len, table.declarationKinds.cap, sizeof(int32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.nameSurfaceKinds.len, table.nameSurfaceKinds.cap, sizeof(int32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.canonicalNames.len, table.canonicalNames.cap, sizeof(str),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.parserValidatedNameProofCids.len, table.parserValidatedNameProofCids.cap, sizeof(layout.FixedBytes32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.portableSignatureTypeExpressionCids.len,
        table.portableSignatureTypeExpressionCids.cap,
        sizeof(layout.FixedBytes32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.lexicalScopeCids.len, table.lexicalScopeCids.cap, sizeof(layout.FixedBytes32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.declKeyCids.len, table.declKeyCids.cap, sizeof(layout.FixedBytes32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.ownerDepths.len, table.ownerDepths.cap, sizeof(int32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.spanStartBytes.len, table.spanStartBytes.cap, sizeof(int32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    tally = compilerSnapshotLoweringBridgeRecordSequenceFacts(
        table.spanEndBytes.len, table.spanEndBytes.cap, sizeof(int32),
        tally.releaseStorage, tally.releasedSequenceFieldCount,
        tally.releasedBufferCount, tally.releasedBytes,
        tally.unreleasedSequenceFieldCount, tally.unreleasedBufferCount,
        expectReleased)
    let canonicalByteCount = rawbytes.BytesLen(table.canonicalBytes)
    if canonicalByteCount > 0:
        tally.releasedBufferCount =
            tally.releasedBufferCount + 1
        tally.releasedBytes =
            tally.releasedBytes + int64(canonicalByteCount)
        if expectReleased:
            tally.unreleasedBufferCount =
                tally.unreleasedBufferCount + 1
    if tally.releaseStorage:
        declaration.SemanticSnapshotDeclarationTableReleaseInto(table)
    if !declaration.SemanticSnapshotDeclarationTableStorageReleased(
           table):
        if tally.releaseStorage:
            compilerSnapshotLoweringBridgeFail(
                "compiler snapshot lowering bridge: declaration physical release incomplete")

