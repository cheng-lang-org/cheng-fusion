        tables.declarations, tally)

fn CompilerSnapshotForLoweringStorageReleased(
        tables: var snapshot_schema.CsgCompilerSnapshotTables): bool =
    var tally: CompilerSnapshotForLoweringReleaseTally
    compilerSnapshotLoweringBridgeReleaseTablesInto(tables, tally)
    return tally.releasedSequenceFieldCount ==
               CompilerSnapshotForLoweringCurrentSchemaSequenceFieldCount &&
           tally.unreleasedSequenceFieldCount == 0 &&
           tally.unreleasedBufferCount == 0 &&
           tables.schemaVersion == 0 &&
           tables.semanticEpoch == int64(0) &&
           layout.FixedBytes32Equal(
               tables.predecessorReceiptCid, layout.FixedBytes32()) &&
           declaration.SemanticSnapshotDeclarationTableStorageReleased(
               tables.declarations)

fn CompilerSnapshotForLoweringReleaseWithReceipt(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        state: var CompilerSnapshotForLoweringReleaseState,
        receipt: var CompilerSnapshotForLoweringReleaseReceipt) =
    if state.terminalStorageReleased ||
       state.terminalReceiptConsumed ||
       !layout.FixedBytes32Equal(
           state.terminalOwnerToken, layout.FixedBytes32()) ||
       state.terminalSchemaVersion != 0 ||
       state.terminalSemanticEpoch != int64(0) ||
       !layout.FixedBytes32Equal(
           state.terminalPredecessorReceiptCid,
           layout.FixedBytes32()) ||
       state.terminalReleasedSequenceFieldCount != 0 ||
       state.terminalReleasedBufferCount != 0 ||
       state.terminalReleasedBytes != int64(0) ||
       receipt.storageReleased ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken, layout.FixedBytes32()) ||
       receipt.schemaVersion != 0 ||
       receipt.semanticEpoch != int64(0) ||
       !layout.FixedBytes32Equal(
           receipt.predecessorReceiptCid, layout.FixedBytes32()) ||
       receipt.releasedSequenceFieldCount != 0 ||
       receipt.releasedBufferCount != 0 ||
       receipt.releasedBytes != int64(0):
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: duplicate or corrupt release")
    if tables.schemaVersion == 0 &&
       CompilerSnapshotForLoweringStorageReleased(tables):
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: terminal storage released twice")
    if tables.schemaVersion != 0 &&
       tables.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest:
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: obsolete schema release rejected")
    let ownerToken =
        compilerSnapshotLoweringBridgeOwnerToken(tables)
    let schemaVersion = tables.schemaVersion
    let semanticEpoch = tables.semanticEpoch
    let predecessorReceiptCid = tables.predecessorReceiptCid
    if layout.FixedBytes32Equal(ownerToken, layout.FixedBytes32()):
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: release owner token missing")
    var tally: CompilerSnapshotForLoweringReleaseTally
    tally.releaseStorage = true
    compilerSnapshotLoweringBridgeReleaseTablesInto(tables, tally)
    if tally.releasedSequenceFieldCount !=
           CompilerSnapshotForLoweringCurrentSchemaSequenceFieldCount ||
       tally.releasedBufferCount < 0 ||
       tally.releasedBytes < int64(0) ||
       tally.unreleasedSequenceFieldCount != 0 ||
       tally.unreleasedBufferCount != 0:
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: release tally incomplete")
    tables.schemaVersion = 0
    tables.semanticEpoch = int64(0)
    tables.predecessorReceiptCid = layout.FixedBytes32()
    if !CompilerSnapshotForLoweringStorageReleased(tables):
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: terminal storage still live")
    state.terminalOwnerToken = ownerToken
    state.terminalSchemaVersion = schemaVersion
    state.terminalSemanticEpoch = semanticEpoch
    state.terminalPredecessorReceiptCid = predecessorReceiptCid
    state.terminalReleasedSequenceFieldCount =
        tally.releasedSequenceFieldCount
    state.terminalReleasedBufferCount =
        tally.releasedBufferCount
    state.terminalReleasedBytes = tally.releasedBytes
    state.terminalStorageReleased = true
    receipt.ownerToken = ownerToken
    receipt.schemaVersion = schemaVersion
    receipt.semanticEpoch = semanticEpoch
    receipt.predecessorReceiptCid = predecessorReceiptCid
    receipt.releasedSequenceFieldCount =
        tally.releasedSequenceFieldCount
    receipt.releasedBufferCount = tally.releasedBufferCount
    receipt.releasedBytes = tally.releasedBytes
    receipt.storageReleased = true

fn CompilerSnapshotForLoweringReleaseReceiptConsumeStrictInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        state: var CompilerSnapshotForLoweringReleaseState,
        receipt: var CompilerSnapshotForLoweringReleaseReceipt,
        err: var str): bool =
    err = ""
    if !state.terminalStorageReleased ||
       state.terminalReceiptConsumed ||
       !receipt.storageReleased ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken, state.terminalOwnerToken) ||
       receipt.schemaVersion != state.terminalSchemaVersion ||
       receipt.semanticEpoch != state.terminalSemanticEpoch ||
       !layout.FixedBytes32Equal(
           receipt.predecessorReceiptCid,
           state.terminalPredecessorReceiptCid) ||
       receipt.releasedSequenceFieldCount !=
           state.terminalReleasedSequenceFieldCount ||
       receipt.releasedBufferCount !=
           state.terminalReleasedBufferCount ||
       receipt.releasedBytes != state.terminalReleasedBytes ||
       receipt.releasedSequenceFieldCount !=
           CompilerSnapshotForLoweringCurrentSchemaSequenceFieldCount ||
       !CompilerSnapshotForLoweringStorageReleased(tables):
        err =
            " compiler snapshot lowering bridge: release receipt mismatch"
        return false
    state.terminalReceiptConsumed = true
    return true

fn CompilerSnapshotForLoweringRelease(
        tables: var snapshot_schema.CsgCompilerSnapshotTables) =
    var state: CompilerSnapshotForLoweringReleaseState
    var receipt: CompilerSnapshotForLoweringReleaseReceipt
    CompilerSnapshotForLoweringReleaseWithReceipt(
        tables, state, receipt)
    var err: str
    if !CompilerSnapshotForLoweringReleaseReceiptConsumeStrictInto(
           tables, state, receipt, err):
        compilerSnapshotLoweringBridgeFail(err)
    let _releasedTableRelief = os.ProcessMemoryPressureRelief()

fn compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(
        tables: var snapshot_schema.CsgCompilerSnapshotTables) =
    if !CompilerSnapshotForLoweringStorageReleased(tables):
        CompilerSnapshotForLoweringRelease(tables)

@borrows
fn compilerSnapshotLoweringBridgeSessionCid(
        csg: ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    let domain = "cheng.compiler.snapshot_lowering_session"
    for byteIndex in 0..<domain.len:
        layout.ByteBufAppendByte(buf, Int32(domain[byteIndex]) & 255)
    layout.ByteBufAppendFixed32(
        buf, csg.sourceIdentityReceipt.receiptCid)
    layout.ByteBufAppendFixed32(buf, universe.worldHead.headCid)
    layout.ByteBufAppendFixed32(
        buf, compilerExecution.executionRaw32)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn compilerSnapshotLoweringBridgeCanonicalScratchRelease(
        producerDocumentCids: var layout.FixedBytes32[],
        producerSourceTexts: var str[],
        order: var int32[],
        canonicalDocumentCids: var layout.FixedBytes32[],
        canonicalSourceByProducer: var int32[],
        canonicalSourceTexts: var str[],
        releaseCanonicalOutputs: bool) =
    seqs.chengSeqFreeTyped(producerDocumentCids)
    seqs.freeSeqStrRelease(producerSourceTexts)
    seqs.chengSeqFreeTyped(order)
    if releaseCanonicalOutputs:
        seqs.chengSeqFreeTyped(canonicalDocumentCids)
        seqs.chengSeqFreeTyped(canonicalSourceByProducer)
        seqs.freeSeqStrRelease(canonicalSourceTexts)
    if producerDocumentCids.len != 0 ||
       producerDocumentCids.cap != 0 ||
       producerSourceTexts.len != 0 ||
       producerSourceTexts.cap != 0 ||
       order.len != 0 || order.cap != 0 ||
       (releaseCanonicalOutputs &&
        (canonicalDocumentCids.len != 0 ||
         canonicalDocumentCids.cap != 0 ||
         canonicalSourceByProducer.len != 0 ||
         canonicalSourceByProducer.cap != 0 ||
         canonicalSourceTexts.len != 0 ||
         canonicalSourceTexts.cap != 0)):
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: canonical scratch release incomplete")

fn compilerSnapshotLoweringBridgeEventStateRelease(
        eventState: var snapshot_core.WorkspaceSourceEventState) =
    seqs.chengSeqFreeTyped(eventState.documentCids)
    seqs.chengSeqFreeTyped(eventState.clientVersions)
    seqs.chengSeqFreeTyped(eventState.documentOpenStates)
    seqs.chengSeqFreeTyped(
        eventState.documentLastEventSourceVersions)
    seqs.chengSeqFreeTyped(eventState.documentLastEventKinds)
    if eventState.documentCids.len != 0 ||
       eventState.documentCids.cap != 0 ||
       eventState.clientVersions.len != 0 ||
       eventState.clientVersions.cap != 0 ||
       eventState.documentOpenStates.len != 0 ||
       eventState.documentOpenStates.cap != 0 ||
       eventState.documentLastEventSourceVersions.len != 0 ||
       eventState.documentLastEventSourceVersions.cap != 0 ||
       eventState.documentLastEventKinds.len != 0 ||
       eventState.documentLastEventKinds.cap != 0:
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: event scratch release incomplete")

fn compilerSnapshotLoweringBridgeBuildScratchRelease(
        canonicalDocumentCids: var layout.FixedBytes32[],
        canonicalSourceByProducer: var int32[],
        canonicalSourceTexts: var str[],
        eventState: var snapshot_core.WorkspaceSourceEventState) =
    seqs.chengSeqFreeTyped(canonicalDocumentCids)
    seqs.chengSeqFreeTyped(canonicalSourceByProducer)
    seqs.freeSeqStrRelease(canonicalSourceTexts)
    compilerSnapshotLoweringBridgeEventStateRelease(eventState)
    if canonicalDocumentCids.len != 0 ||
       canonicalDocumentCids.cap != 0 ||
       canonicalSourceByProducer.len != 0 ||
       canonicalSourceByProducer.cap != 0 ||
       canonicalSourceTexts.len != 0 ||
       canonicalSourceTexts.cap != 0:
        compilerSnapshotLoweringBridgeFail(
            "compiler snapshot lowering bridge: build scratch release incomplete")

@borrows
fn compilerSnapshotLoweringBridgeCanonicalSourcesInto(
        workspaceRoot: str,
        csg: ccsg.CompilerCsg,
        canonicalDocumentCids: var layout.FixedBytes32[],
        canonicalSourceByProducer: var int32[],
        canonicalSourceTexts: var str[],
        eventState: var snapshot_core.WorkspaceSourceEventState,
        err: var str): bool =
    if canonicalDocumentCids.len != 0 ||
       canonicalDocumentCids.cap != 0 ||
       canonicalSourceByProducer.len != 0 ||
       canonicalSourceByProducer.cap != 0 ||
       canonicalSourceTexts.len != 0 ||
       canonicalSourceTexts.cap != 0:
        err =
            " compiler snapshot lowering bridge: canonical outputs already owned"
        return false
    let sourceCount =
        csg.semanticGraph.sourceTable.sourcePaths.len
    if sourceCount <= 0 ||
       sourceCount !=
           csg.semanticGraph.sourceTable.modulePaths.len ||
       sourceCount !=
           csg.parserNormalizedExprReceipt.sourceSidecars.len:
        err =
            " compiler snapshot lowering bridge: source authority shape invalid"
        return false
    var producerDocumentCids: layout.FixedBytes32[]
    var producerSourceTexts: str[]
    var order: int32[]
    for producerSourceIndex in 0..<sourceCount:
        var documentCid: layout.FixedBytes32
        if !cworld.CompilerWorldDocumentCidInto(
               csg.packageId,
               csg.semanticGraph.sourceTable.modulePaths[
                   producerSourceIndex],
               documentCid,
               err):
            compilerSnapshotLoweringBridgeCanonicalScratchRelease(
                producerDocumentCids,
                producerSourceTexts,
                order,
                canonicalDocumentCids,
                canonicalSourceByProducer,
                canonicalSourceTexts,
                true)
            return false
        let sourcePathRaw =
            csg.semanticGraph.sourceTable.sourcePaths[
                producerSourceIndex]
        let sourcePath =
            chengpath.PathAbsolute(workspaceRoot, sourcePathRaw)
        if sourcePath == "" ||
           !chengpath.PathFileExists(sourcePath):
            err =
                Fmt" compiler snapshot lowering bridge: frozen source missing path={sourcePath}"
            compilerSnapshotLoweringBridgeCanonicalScratchRelease(
                producerDocumentCids,
                producerSourceTexts,
                order,
                canonicalDocumentCids,
                canonicalSourceByProducer,
                canonicalSourceTexts,
                true)
            return false
        add(producerDocumentCids, layout.FixedBytes32Copy(documentCid))
        add(
            producerSourceTexts,
            chengpath.ReadTextFile("", sourcePath))
        var insertAt = order.len
        while insertAt > 0 &&
              compilerSnapshotLoweringBridgeCidLess(
                  documentCid,
                  producerDocumentCids[order[insertAt - 1]]):
            insertAt = insertAt - 1
        add(order, producerSourceIndex)
        var moveIndex = order.len - 1
        while moveIndex > insertAt:
            order[moveIndex] = order[moveIndex - 1]
            moveIndex = moveIndex - 1
        order[insertAt] = producerSourceIndex
    setLen(canonicalSourceByProducer, sourceCount)
    for canonicalSourceIndex in 0..<sourceCount:
        let producerSourceIndex = order[canonicalSourceIndex]
        if canonicalSourceIndex > 0 &&
           layout.FixedBytes32Equal(
               producerDocumentCids[
                   order[canonicalSourceIndex - 1]],
               producerDocumentCids[producerSourceIndex]):
            err =
                " compiler snapshot lowering bridge: duplicate document identity"
            compilerSnapshotLoweringBridgeCanonicalScratchRelease(
                producerDocumentCids,
                producerSourceTexts,
                order,
                canonicalDocumentCids,
                canonicalSourceByProducer,
                canonicalSourceTexts,
                true)
            return false
        add(
            canonicalDocumentCids,
            layout.FixedBytes32Copy(
                producerDocumentCids[producerSourceIndex]))
        add(
            canonicalSourceTexts,
            share(producerSourceTexts[producerSourceIndex]))
        canonicalSourceByProducer[producerSourceIndex] =
            canonicalSourceIndex
        var acceptedSourceVersion: int64
        let eventDocumentCid = layout.FixedBytes32Copy(
            producerDocumentCids[producerSourceIndex])
        if !snapshot_core.WorkspaceSourceEventAcceptInto(
               eventState,
               snapshot_core.SemanticSourceEventOpen,
               eventDocumentCid,
               int64(0),
               acceptedSourceVersion,
               err) ||
           acceptedSourceVersion != int64(canonicalSourceIndex + 1):
            if err == "":
                err =
                    " compiler snapshot lowering bridge: source event order drift"
            compilerSnapshotLoweringBridgeCanonicalScratchRelease(
                producerDocumentCids,
                producerSourceTexts,
                order,
                canonicalDocumentCids,
                canonicalSourceByProducer,
                canonicalSourceTexts,
                true)
            return false
    compilerSnapshotLoweringBridgeCanonicalScratchRelease(
        producerDocumentCids,
        producerSourceTexts,
        order,
        canonicalDocumentCids,
        canonicalSourceByProducer,
        canonicalSourceTexts,
        false)
    err = ""
    return true

@borrows
fn compilerSnapshotLoweringBridgeBootstrapReceiptCurrent(
        policy: compilerSnapshotLoweringBridgeMerklePolicy,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        bootstrapReceipt:
            snapshot_cargo.CsgCompilerSnapshotMerkleTransaction): bool =
    let current = merkle_store.CsgCoreMerkleStoreReadHead(
        policy.parentPath, policy.storeName)
    return bootstrapReceipt.ok &&
        bootstrapReceipt.planReady &&
        bootstrapReceipt.productionApplied &&
        !bootstrapReceipt.reused &&
        bootstrapReceipt.error.len == 0 &&
        bootstrapReceipt.factsRoot == cargo.factsRoot &&
        bootstrapReceipt.factsSubgraphCid ==
            cargo.factsSubgraphCid &&
        bootstrapReceipt.sourceId ==
            snapshot_cargo.CsgCompilerSnapshotCargoMerkleSourceId() &&
        bootstrapReceipt.headCid == policy.expectedHeadCid &&
        bootstrapReceipt.manifestCid ==
            policy.expectedManifestCid &&
        current.ok && current.present &&
        current.head.headCid == bootstrapReceipt.headCid &&
        current.head.manifestCid ==
            bootstrapReceipt.manifestCid &&
        current.head.receiptCid ==
            bootstrapReceipt.receiptCid &&
        current.manifest.factsRoot == cargo.factsRoot &&
        current.manifest.dagRootCid == cargo.dagRootCid &&
        current.manifest.factCount == cargo.factCount

@borrows
fn compilerSnapshotLoweringBridgeCurrentHeadMatchesCargo(
        policy: compilerSnapshotLoweringBridgeMerklePolicy,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        current: merkle_store.CsgCoreMerkleHeadReadResult): bool =
    let sourceId =
        snapshot_cargo.CsgCompilerSnapshotCargoMerkleSourceId()
    if !current.ok || !current.present ||
       current.head.headCid != policy.expectedHeadCid ||
       current.head.manifestCid != policy.expectedManifestCid ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.headCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.manifestCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.receiptCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           current.head.previousHeadCid) ||
       current.manifest.factsRoot != cargo.factsRoot ||
       current.manifest.dagRootCid != cargo.dagRootCid ||
       current.manifest.factCount != cargo.factCount ||
       current.manifest.standard != cargo.standard ||
       current.manifest.schemaCid != cargo.schemaCid ||
       current.manifest.profileSetCid != cargo.profileSetCid ||
       !current.manifest.complete ||
       current.manifest.unsupportedCount != 0 ||
       current.manifest.tombstoneCount != 0 ||
       current.manifest.runtimeRequirementCount != 0 ||
       current.manifest.partitions.len == 0:
        return false
    for partitionIndex in 0..<current.manifest.partitions.len:
        if current.manifest.partitions[partitionIndex].sourceId !=
               sourceId:
            return false
    return true

@borrows
fn compilerSnapshotLoweringBridgeMerkleCommitInto(
        policy: compilerSnapshotLoweringBridgeMerklePolicy,
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo,
        bootstrapReceipt:
            snapshot_cargo.CsgCompilerSnapshotMerkleTransaction,
        bootstrapApplied: bool,
        receipt:
            var snapshot_cargo.CsgCompilerSnapshotMerkleTransaction,
        err: var str): bool =
    if !compilerSnapshotLoweringBridgeMerklePolicyValid(policy, cargo):
        err =
            " compiler snapshot lowering bridge: Merkle policy rejected"
        return false
    let verified =
        snapshot_cargo.CsgCompilerSnapshotVerifiedCargoFromBuiltCargo(cargo)
    if !verified.ok || verified.error.len != 0 ||
       !layout.FixedBytes32Equal(
           verified.factsRootCid, cargo.factsRootCid) ||
       !layout.FixedBytes32Equal(verified.cargoCid, cargo.cargoCid) ||
       verified.standard != cargo.standard ||
       !validator.CsgCoreProfilesEqual(
           verified.profiles, cargo.profiles) ||
       verified.profileSetCid != cargo.profileSetCid ||
       verified.schemaNamespace != cargo.schemaNamespace ||
       verified.schemaCid != cargo.schemaCid ||
       verified.factsRoot != cargo.factsRoot ||
       verified.factsSubgraphCid != cargo.factsSubgraphCid ||
       verified.dagRootCid != cargo.dagRootCid ||
       verified.factCount != cargo.factCount ||
       verified.canonicalLines.len != cargo.canonicalLines.len ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.parserRootCid,
           cargo.proofRoots.parserRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.typeRootCid,
           cargo.proofRoots.typeRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.ownershipRootCid,
           cargo.proofRoots.ownershipRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.callRootCid,
           cargo.proofRoots.callRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.layoutRootCid,
           cargo.proofRoots.layoutRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.dependencyRootCid,
           cargo.proofRoots.dependencyRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.readSetRootCid,
           cargo.proofRoots.readSetRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.reachabilityRootCid,
           cargo.proofRoots.reachabilityRootCid) ||
       !layout.FixedBytes32Equal(
           verified.proofRoots.lifecycleRootCid,
           cargo.proofRoots.lifecycleRootCid):
        err =
            " compiler snapshot lowering bridge: verified Cargo identity mismatch"
        return false
    for lineIndex in 0..<verified.canonicalLines.len:
        if verified.canonicalLines[lineIndex] !=
           cargo.canonicalLines[lineIndex]:
            err =
                " compiler snapshot lowering bridge: verified Cargo facts mismatch"
            return false
    if bootstrapApplied:
        if !compilerSnapshotLoweringBridgeBootstrapReceiptCurrent(
               policy, cargo, bootstrapReceipt):
            err =
                " compiler snapshot lowering bridge: Merkle bootstrap receipt rejected"
            return false
        receipt = bootstrapReceipt
        err = ""
        return true
    if bootstrapReceipt.ok || bootstrapReceipt.planReady ||
       bootstrapReceipt.productionApplied ||
       bootstrapReceipt.requestCid.len != 0 ||
       bootstrapReceipt.receiptCid.len != 0 ||
       bootstrapReceipt.headCid.len != 0 ||
       bootstrapReceipt.manifestCid.len != 0:
        err =
            " compiler snapshot lowering bridge: unexpected Merkle bootstrap receipt"
        return false
    let currentHead = merkle_store.CsgCoreMerkleStoreReadHead(
        policy.parentPath, policy.storeName)
    if compilerSnapshotLoweringBridgeCurrentHeadMatchesCargo(
           policy, cargo, currentHead):
        let replayedPlan =
            snapshot_cargo.CsgCompilerSnapshotCargoMerklePlan(
                policy.parentPath,
                policy.storeName,
                currentHead.head.previousHeadCid,
                cargo)
        let replayedApply =
            snapshot_cargo.CsgCompilerSnapshotCargoMerkleApply(
                policy.parentPath,
                policy.storeName,
                currentHead.head.previousHeadCid,
                cargo)
        if replayedPlan.ok && replayedPlan.planReady &&
           replayedPlan.productionApplied && replayedPlan.reused &&
           replayedPlan.error.len == 0 &&
           replayedApply.ok && replayedApply.planReady &&
           replayedApply.productionApplied && replayedApply.reused &&
           replayedApply.error.len == 0 &&
           replayedApply.requestCid == replayedPlan.requestCid &&
           replayedApply.transactionPlanRoot ==
               replayedPlan.transactionPlanRoot &&
           replayedApply.planRoot == replayedPlan.planRoot &&
           replayedApply.receiptCid == replayedPlan.receiptCid &&
           replayedApply.headCid == policy.expectedHeadCid &&
           replayedApply.manifestCid == policy.expectedManifestCid &&
           replayedApply.factsRoot == cargo.factsRoot &&
           replayedApply.factsSubgraphCid == cargo.factsSubgraphCid &&
           replayedApply.sourceId ==
               snapshot_cargo.CsgCompilerSnapshotCargoMerkleSourceId() &&
           replayedApply.receiptCid == currentHead.head.receiptCid &&
           merkle_codec.CsgCoreMerkleStoreCidValid(
               replayedApply.requestCid) &&
           merkle_codec.CsgCoreMerkleStoreCidValid(
               replayedApply.transactionPlanRoot) &&
           merkle_codec.CsgCoreMerkleStoreCidValid(
               replayedApply.planRoot) &&
           merkle_codec.CsgCoreMerkleStoreCidValid(
               replayedApply.receiptCid):
            receipt = replayedApply
            err = ""
            return true
        err =
            " compiler snapshot lowering bridge: current Merkle cargo replay rejected"
        return false
    let sourceId =
        snapshot_cargo.CsgCompilerSnapshotCargoMerkleSourceId()
    let planned = snapshot_cargo.CsgCompilerSnapshotCargoMerklePlan(
        policy.parentPath,
        policy.storeName,
        policy.expectedHeadCid,
        cargo)
    if !planned.ok || !planned.planReady || planned.error.len != 0:
        err = planned.error.len > 0 ?
            strings.CloneStr(planned.error) :
            " compiler snapshot lowering bridge: Merkle plan rejected"
        return false
    if planned.factsRoot != cargo.factsRoot ||
       planned.factsSubgraphCid != cargo.factsSubgraphCid ||
       planned.sourceId != sourceId ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(planned.requestCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           planned.transactionPlanRoot) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(planned.headCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(planned.manifestCid):
        err =
            " compiler snapshot lowering bridge: Merkle plan identity rejected"
        return false
    if planned.productionApplied:
        if !planned.reused ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(planned.planRoot) ||
           !merkle_codec.CsgCoreMerkleStoreCidValid(planned.receiptCid):
            err =
                " compiler snapshot lowering bridge: replay plan receipt invalid"
            return false
    elif planned.reused || planned.planRoot.len != 0 ||
         planned.receiptCid.len != 0:
        err =
            " compiler snapshot lowering bridge: unapplied plan carried receipt"
        return false
    let applied = snapshot_cargo.CsgCompilerSnapshotCargoMerkleApply(
        policy.parentPath,
        policy.storeName,
        policy.expectedHeadCid,
        cargo)
    if !applied.ok || !applied.planReady ||
       !applied.productionApplied || applied.error.len != 0 ||
       applied.factsRoot != cargo.factsRoot ||
       applied.factsSubgraphCid != cargo.factsSubgraphCid ||
       applied.sourceId != sourceId ||
       applied.requestCid != planned.requestCid ||
       applied.transactionPlanRoot != planned.transactionPlanRoot ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(applied.requestCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           applied.transactionPlanRoot) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(applied.planRoot) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(applied.receiptCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(applied.headCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(applied.manifestCid) ||
       (!applied.reused &&
        applied.headCid == policy.expectedHeadCid):
        err =
            " compiler snapshot lowering bridge: Merkle apply rejected"
        return false
    if planned.productionApplied &&
       (applied.planRoot != planned.planRoot ||
        applied.receiptCid != planned.receiptCid ||
        applied.headCid != planned.headCid ||
        applied.manifestCid != planned.manifestCid):
        err =
            " compiler snapshot lowering bridge: replay receipt drift"
        return false
    receipt = applied
    err = ""
    return true

@borrows
fn CompilerSnapshotForLoweringBuildLatestInto(
        linkPlan: var slplan.SystemLinkPlanStub,
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        authority: var CompilerSnapshotLoweringAuthority,
        err: var str): bool =
    authority = CompilerSnapshotLoweringAuthority()
    if !CompilerSnapshotForLoweringStorageReleased(tables):
        err =
            " compiler snapshot lowering bridge: output storage already owned"
        return false
    var predecessor: production.SemanticSnapshotCompilerPredecessorReceipt
    if !production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
           csg,
           universe,
           compilerExecution,
           predecessor,
           err):
        return false
    if !layout.FixedBytes32Equal(
           linkPlan.sourceBundleCidValue,
           csg.sourceBundleCid):
        err =
            " compiler snapshot lowering bridge: source bundle identity drift"
        return false
    var eventState: snapshot_core.WorkspaceSourceEventState
    let workspaceSessionCid =
        compilerSnapshotLoweringBridgeSessionCid(
            csg, universe, compilerExecution)
    if !snapshot_core.WorkspaceSourceEventStateInitInto(
           workspaceSessionCid, eventState, err):
        return false
    var canonicalDocumentCids: layout.FixedBytes32[]
    var canonicalSourceByProducer: int32[]
    var canonicalSourceTexts: str[]
    if !compilerSnapshotLoweringBridgeCanonicalSourcesInto(
           linkPlan.workspaceRoot,
           csg,
           canonicalDocumentCids,
           canonicalSourceByProducer,
           canonicalSourceTexts,
           eventState,
           err):
        compilerSnapshotLoweringBridgeBuildScratchRelease(
            canonicalDocumentCids,
            canonicalSourceByProducer,
            canonicalSourceTexts,
            eventState)
        return false
    var admission: builder.CompilerSnapshotProductionAdmissionReceipt
    if !builder.CompilerSnapshotProductionCandidateBuildUnsealedInto(
           csg,
           canonicalDocumentCids,
           canonicalSourceByProducer,
           canonicalSourceTexts,
           eventState,
           universe.worldHead.headCid,
           compilerExecution.executionRaw32,
           predecessor.receiptCid,
           tables,
           admission,
           err):
        compilerSnapshotLoweringBridgeBuildScratchRelease(
            canonicalDocumentCids,
            canonicalSourceByProducer,
            canonicalSourceTexts,
            eventState)
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    if !admission.admissionBlocked ||
       admission.missingFactBitmap !=
           builder.CompilerSnapshotAdmissionMissingSourceInterface ||
       admission.missingSourceInterfaceCount !=
           tables.sources.documentCids.len:
        err =
            Fmt" compiler snapshot lowering bridge: canonical admission blocked missingFactBitmap={admission.missingFactBitmap}"
        compilerSnapshotLoweringBridgeBuildScratchRelease(
            canonicalDocumentCids,
            canonicalSourceByProducer,
            canonicalSourceTexts,
            eventState)
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    if !builder.CompilerSnapshotProductionCandidateSealInto(
           csg,
           canonicalDocumentCids,
           canonicalSourceByProducer,
           tables,
           admission,
           err):
        compilerSnapshotLoweringBridgeBuildScratchRelease(
            canonicalDocumentCids,
            canonicalSourceByProducer,
            canonicalSourceTexts,
            eventState)
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    if admission.admissionBlocked ||
       admission.missingFactBitmap != 0 ||
       admission.missingSourceInterfaceCount != 0:
        err =
            Fmt" compiler snapshot lowering bridge: sealed canonical admission blocked missingFactBitmap={admission.missingFactBitmap}"
        compilerSnapshotLoweringBridgeBuildScratchRelease(
            canonicalDocumentCids,
            canonicalSourceByProducer,
            canonicalSourceTexts,
            eventState)
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
           tables, err):
        compilerSnapshotLoweringBridgeBuildScratchRelease(
            canonicalDocumentCids,
            canonicalSourceByProducer,
            canonicalSourceTexts,
            eventState)
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    compilerSnapshotLoweringBridgeBuildScratchRelease(
        canonicalDocumentCids,
        canonicalSourceByProducer,
        canonicalSourceTexts,
        eventState)
    if !ccsg.CompilerCsgOwnTransitionReceiptStrictValidateInto(csg, err) ||
       !builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
           csg, tables, admission, err):
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(tables)
    defer:
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    if !cargo.ok:
        err = cargo.error.len > 0 ?
            strings.CloneStr(cargo.error) :
            " compiler snapshot lowering bridge: Cargo build failed"
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    let compilerCsgArtifactCid =
        compilerSnapshotLoweringBridgeCompilerCsgArtifactCid(
            csg, tables, admission, cargo)
    if layout.FixedBytes32Equal(
           compilerCsgArtifactCid, layout.FixedBytes32()):
        err =
            " compiler snapshot lowering bridge: zero CompilerCSG artifact CID"
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    var cargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding
    var migration: CsgCompilerSnapshotLegacyMigrationInput
    var envelope: CsgCompilerSnapshotEnvelopeStoreReceipt
    defer:
        CsgCompilerSnapshotImmutableCargoStoreBindingRelease(cargoStore)
        CsgCompilerSnapshotLegacyMigrationInputRelease(migration)
        CsgCompilerSnapshotEnvelopeStoreReceiptRelease(envelope)
    if !CsgCompilerSnapshotImmutableCargoStoreEnsureInto(
           linkPlan.workspaceRoot, cargo, cargoStore, err):
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    # Memory line w125b ①: the Cargo store ensure path (genesis bootstrap,
    # per-object write plus readback verification, session identity
    # revalidation) churns the allocator with millions of short-lived block
    # headers.  This store commit-chain phase boundary is the release window:
    # hand the freed but allocator-retained pages back before the envelope
    # phase builds on top of them.
    let _cargoStoreEnsureRelief = os.ProcessMemoryPressureRelief()
    if !CsgCompilerSnapshotLegacyMigrationInputInto(
           linkPlan.workspaceRoot,
           cargoStore.storeIdentityCid,
           csg.sourceIdentityReceipt.sourceBundleCid,
           csg.sourceIdentityReceipt.receiptCid,
           migration,
           err):
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    if !CsgCompilerSnapshotEnvelopeStoreCommitInto(
           linkPlan.workspaceRoot,
           cargo,
           cargoStore,
           migration,
           tables.schemaVersion,
           tables.semanticEpoch,
           predecessor.receiptCid,
           predecessor.worldHeadCid,
           predecessor.compilerExecutionCid,
           csg.sourceIdentityReceipt.sourceBundleCid,
           csg.sourceIdentityReceipt.receiptCid,
           envelope,
           err):
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    # Memory line w125b ②: the envelope store commit re-walks the persistent
    # head chain from genesis on every read, so this transaction window is the
    # allocator churn peak of the whole snapshot build.  Physically release
    # the freed pages at the commit boundary.
    let _envelopeCommitRelief = os.ProcessMemoryPressureRelief()
    var storage: snapshot_authority.CompilerSnapshotLoweringAuthorityStoreBinding
    if !compilerSnapshotLoweringBridgeAuthorityStoreBindingInto(
           linkPlan.workspaceRoot,
           cargo,
           cargoStore,
           envelope,
           storage,
           err):
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        return false
    var issuedCore: snapshot_authority.CompilerSnapshotLoweringAuthorityHandle
    var authorityCargoStore: CsgCompilerSnapshotImmutableCargoStoreBinding
    defer:
        CsgCompilerSnapshotImmutableCargoStoreBindingRelease(
            authorityCargoStore)
    let authorityCargoCurrent =
        merkle_store.CsgCoreMerkleStoreReadHead(
            linkPlan.workspaceRoot, cargoStore.storeName)
    if !compilerSnapshotLoweringBridgeImmutableCargoHeadExact(
           linkPlan.workspaceRoot,
           cargoStore.storeName,
           cargoStore.storeIdentityCid,
           cargo,
           authorityCargoCurrent,
           authorityCargoStore,
           err) ||
       authorityCargoStore.headCid != cargoStore.headCid ||
       authorityCargoStore.manifestCid != cargoStore.manifestCid ||
       authorityCargoStore.receiptCid != cargoStore.receiptCid ||
       authorityCargoStore.csgcObjectCid != cargoStore.csgcObjectCid:
        if err.len == 0:
            err =
                " compiler snapshot lowering bridge: authority Cargo reread changed"
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        authority = CompilerSnapshotLoweringAuthority()
        return false
    if !snapshot_authority.CompilerSnapshotLoweringAuthorityIssueCurrentInto(
           cargo,
           storage,
           authorityCargoCurrent,
           tables.schemaVersion,
           tables.semanticEpoch,
           csg.sourceIdentityReceipt.sourceSnapshotCount,
           csg.sourceIdentityReceipt.importEdgeCount,
           csg.sourceIdentityReceipt.unresolvedImportCount,
           csg.sourceIdentityReceipt.sourcePackageIdCid,
           csg.sourceIdentityReceipt.entryModulePathCid,
           csg.sourceIdentityReceipt.sourceBundleCid,
           csg.sourceIdentityReceipt.entrySourceCid,
           csg.sourceIdentityReceipt.importGraphCid,
           csg.sourceIdentityReceipt.receiptCid,
           csg.parserNormalizedExprReceipt.envelope.receiptRaw32,
           csg.graphCid,
           csg.canonicalGraphCid,
           csg.csgTransitionReceipt.receiptCid,
           predecessor.worldHeadCid,
           predecessor.compilerExecutionCid,
           predecessor.compilerPackageCid,
           predecessor.receiptCid,
           issuedCore,
           err):
        compilerSnapshotLoweringBridgeReleaseOwnedIfNeeded(tables)
        authority = CompilerSnapshotLoweringAuthority()
        return false
    # Memory line w125b ③: the authority cargo re-read plus immutable Cargo
    # re-verification window is complete.  This is the snapshot-build ->
    # lowering-bind phase boundary; release allocator-retained pages so the
    # lowering and emit phases do not stack on the snapshot window's
    # high-water mark.
    let _authorityIssueRelief = os.ProcessMemoryPressureRelief()
    var issue: compilerSnapshotLoweringBridgeIssueReceipt
    issue.ownerId = issuedCore.ownerId
    issue.generation = issuedCore.generation
    issue.workspaceRootCid =
        compilerSnapshotLoweringBridgeTextIdentityCid(
            linkPlan.workspaceRoot)
    issue.packageIdCid =
        compilerSnapshotLoweringBridgeTextIdentityCid(linkPlan.packageId)
    issue.targetTripleCid =
        compilerSnapshotLoweringBridgeTextIdentityCid(
            compilerExecution.targetTriple)
    issue.worldHeadCid = predecessor.worldHeadCid
    issue.compilerExecutionCid = predecessor.compilerExecutionCid
    issue.compilerPackageCid = predecessor.compilerPackageCid
    issue.sourceBundleCid = predecessor.sourceBundleCid
    issue.sourceIdentityReceiptCid =
        csg.sourceIdentityReceipt.receiptCid
    issue.graphCid = csg.graphCid
    issue.canonicalGraphCid = csg.canonicalGraphCid
    issue.snapshotPredecessorReceiptCid = predecessor.receiptCid
    issue.compilerCsgArtifactCid = compilerCsgArtifactCid
    issue.storage = storage
    issue.admission = admission
    issue.receiptCid =
        compilerSnapshotLoweringBridgeIssueReceiptCid(issue)
    var issueErr: str
    if !compilerSnapshotLoweringBridgeIssueReceiptStrictValidateInto(
           issue, issueErr):
        panic(issueErr)
    authority.ownerId = issuedCore.ownerId
    authority.generation = issuedCore.generation
    authority.core = issuedCore
    authority.issue = issue
    err = ""
    return true
