    compilerSnapshotLoweringBridgeReleaseSequence(tables.layoutFields.offsetBytes, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.layoutFields.sizeBytes, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.layoutFields.alignBytes, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedStatements.typedIrStatementIndexes, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedStatements.functionIds, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedStatements.rootStarts, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedStatements.rootCounts, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedStatements.rootTypedNodeIds, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.typedIrNodeIndexes, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.bindingProducerSourceIndexes, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.bindingParserSourceLocalNodeRows, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.bindingDeclarationSourceLocalRows, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.bindingPatternSourceLocalRows, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.bindingValueDefinitionRows, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.producedValueDefinitionRows, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.ownerStatementIds, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.originParserNodeIds, tally)
    compilerSnapshotLoweringBridgeReleaseSequence(tables.typedNodes.syntheticOriginKinds, tally)
