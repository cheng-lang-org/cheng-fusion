import std/os
import std/strings
import std/strutils as strutil
import cheng/core/lang/intern as langintern

type
    DeterminismGate =
        pathA: str
        pathB: str
        pass: bool
        report: str

@borrows
fn DeterminismGateNew(pathA: str, pathB: str): DeterminismGate =
    return DeterminismGate(pathA: strings.CloneStr(pathA), pathB: strings.CloneStr(pathB), pass: false, report: "")

@borrows
fn DeterminismGateSha256File(path: str): str =
    if !os.FileExists(path):
        return ""
    let content = os.ReadFile(path)
    if len(content) == 0 && os.FileSize(path) > 0:
        return ""
    var out: str = strings.Sha256(content)
    return out

@borrows
fn DeterminismGateCompareShas(shaA: str, shaB: str): bool =
    return shaA == shaB

fn DeterminismGateVerifyOutputDeterminism(gate: var DeterminismGate): bool =
    let shaA = DeterminismGateSha256File(strings.CloneStr(gate.pathA))
    let shaB = DeterminismGateSha256File(strings.CloneStr(gate.pathB))
    let ok = DeterminismGateCompareShas(strings.CloneStr(shaA), strings.CloneStr(shaB))
    var report = ""
    report = strutil.Join([report, "output_determinism\n"], "")
    report = strutil.Join([report, strutil.Join(["path_a=", strings.CloneStr(gate.pathA)], ""), "\n"], "")
    report = strutil.Join([report, strutil.Join(["path_b=", strings.CloneStr(gate.pathB)], ""), "\n"], "")
    report = strutil.Join([report, strutil.Join(["sha_a=", strings.CloneStr(shaA)], ""), "\n"], "")
    report = strutil.Join([report, strutil.Join(["sha_b=", strings.CloneStr(shaB)], ""), "\n"], "")
    report = strutil.Join([report, strutil.Join(["pass=", strings.IntToStr(boolToInt(ok))], ""), "\n"], "")
    gate.pass = ok
    gate.report = report
    return ok

@borrows
fn DeterminismGateVerifyRelocDeterminism(relocPathA: str, relocPathB: str): bool =
    let shaA = DeterminismGateSha256File(relocPathA)
    let shaB = DeterminismGateSha256File(relocPathB)
    return DeterminismGateCompareShas(shaA, shaB)

@borrows
fn DeterminismGateVerifyCstringDeterminism(cstringPathA: str, cstringPathB: str): bool =
    let shaA = DeterminismGateSha256File(cstringPathA)
    let shaB = DeterminismGateSha256File(cstringPathB)
    return DeterminismGateCompareShas(shaA, shaB)

fn boolToInt(b: bool): int32 =
    if b:
        return 1
    return 0
