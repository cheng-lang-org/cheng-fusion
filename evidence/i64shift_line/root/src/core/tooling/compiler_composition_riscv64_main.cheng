import cheng/core/backend/riscv64_encode as rv64
import cheng/core/backend/elf_riscv64_writer as elf_rv64
import cheng/core/backend/elf_riscv64_linker as link_rv64
import cheng/core/backend/regalloc_riscv_adapter as adapter
import cheng/core/backend/regalloc_production_encoder_events as events
import cheng/core/backend/codegen_contract as contract
import cheng/core/tooling/compiler_main as compiler

fn main(): int32 =
    if !adapter.RegallocRiscvCodegenUnitRegister():
        return 70
    if !contract.CodegenCompositionActivateUnit(
           contract.CodegenUnitRv64):
        return 71
    return compiler.CompilerMainCompositionProcessEntry()
