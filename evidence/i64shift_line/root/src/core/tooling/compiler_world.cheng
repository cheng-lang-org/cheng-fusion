import std/result
import std/system
import std/strutils as strutil
import std/strings
import std/os
import std/rawbytes
import std/monotimes
import std/buffer
import std/seqs
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/path as chengpath
import cheng/core/lang/parser

type
    CompilerPackageSnapshot =
        packageId: str
        channel: str
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        exportSurfaceCid: layout.FixedBytes32
        syntaxSurfaceCid: layout.FixedBytes32
        depsManifestCid: layout.FixedBytes32
        migrationProofCid: layout.FixedBytes32
        signature: str
        snapshotCid: layout.FixedBytes32

    CompilerUniverseManifestEntry =
        packageId: str
        snapshotCid: layout.FixedBytes32
        syntaxSurfaceCid: layout.FixedBytes32
        migrationProofCid: layout.FixedBytes32
        managedMirrorBundleCid: layout.FixedBytes32

    CompilerUniverseManifest =
        channel: str
        entryCount: int32
        managedDependencyReceiptCid: layout.FixedBytes32
        entries: CompilerUniverseManifestEntry[]
        manifestCid: layout.FixedBytes32

    CompilerWorldHead =
        universeId: str
        channel: str
        headEpoch: int32
        prevHeadCid: layout.FixedBytes32
        manifestRootCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        compilerPkgCid: layout.FixedBytes32
        stdPkgCid: layout.FixedBytes32
        runtimePkgCid: layout.FixedBytes32
        signature: str
        headCid: layout.FixedBytes32

    CompilerLockSnapshot =
        channel: str
        worldHeadCid: layout.FixedBytes32
        manifestRootCid: layout.FixedBytes32
        compilerPkgCid: layout.FixedBytes32
        stdPkgCid: layout.FixedBytes32
        runtimePkgCid: layout.FixedBytes32
        managedDependencyReceiptCid: layout.FixedBytes32
        entryCount: int32
        entries: CompilerUniverseManifestEntry[]
        lockPath: str

    CompilerManagedMirrorCommitFile =
        relativePath: str
        rawByteLength: int32
        contentCid: layout.FixedBytes32

    CompilerManagedMirrorCommit =
        bundleCid: layout.FixedBytes32
        fileCount: int32
        files: CompilerManagedMirrorCommitFile[]

    CompilerManagedMirrorBundleWireUnit =
        modulePath: str
        legacySourceRawByteLength: int32
        legacySourceCid: layout.FixedBytes32
        legacySourceText: str
        migratedSourceRawByteLength: int32
        migratedSourceCid: layout.FixedBytes32
        migratedSourceText: str

    # Pure mirror wire schema.  Semantic proof verification stays above this
    # module, while installers and system-link consumers share this exact
    # parser/CID/source-manifest authority without an import cycle.
    CompilerManagedMirrorBundleWire =
        channel: str
        packageId: str
        migrationProofCid: layout.FixedBytes32
        legacySourceIdentityReceiptCid: layout.FixedBytes32
        migratedSourceIdentityReceiptCid: layout.FixedBytes32
        compileSemanticReceiptCid: layout.FixedBytes32
        unitCount: int32
        units: CompilerManagedMirrorBundleWireUnit[]
        baselineCsgText: str
        migratedCsgText: str
        baselineSurfaceText: str
        migratedSurfaceText: str
        baselineSemanticReceiptText: str
        migratedSemanticReceiptText: str
        evidenceText: str
        proofText: str
        bundleCid: layout.FixedBytes32

    CompilerLocalUniverse =
        compilerSnapshot: CompilerPackageSnapshot
        stdSnapshot: CompilerPackageSnapshot
        runtimeSnapshot: CompilerPackageSnapshot
        manifest: CompilerUniverseManifest
        worldHead: CompilerWorldHead

fn CompilerWorldUniverseId(): str =
    return "cheng/compiler_universe"

var compilerWorldTraceReady: bool
var compilerWorldTraceEnabled: bool
var compilerWorldTraceLastNs: int64

@borrows
fn CompilerWorldTraceLine(text: str) =
    if !compilerWorldTraceReady:
        compilerWorldTraceEnabled = os.GetEnv("CHENG_COMPILER_WORLD_TRACE") == "1"
        compilerWorldTraceLastNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        compilerWorldTraceReady = true
    if compilerWorldTraceEnabled:
        let nowNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        let sinceMs = (nowNs - compilerWorldTraceLastNs) / int64(1000000)
        compilerWorldTraceLastNs = nowNs
        echo(Fmt"{text} since_ms={strings.Int64ToStr(sinceMs)}")

fn CompilerWorldDefaultChannel(): str =
    return "stable"

@borrows
fn CompilerWorldOwnText(text: str): str =
    return strings.CloneStr(text)

@borrows
fn CompilerWorldNormalizeChannel(raw: str): Result[str] =
    let rawOwned = parser.ParserOwnedText(raw)
    var start = 0
    var stop = rawOwned.len
    while start < stop:
        let ch = rawOwned[start]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        start = start + 1
    while stop > start:
        let ch = rawOwned[stop - 1]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        stop = stop - 1
    if start >= stop:
        return Ok[str](parser.ParserOwnedText(CompilerWorldDefaultChannel()))
    let channel = parser.ParserOwnedTextRange(rawOwned, start, stop - start)
    if channel != "stable":
        if channel != "edge":
            return Err[str](parser.ParserConcat2(
                " compiler world: unsupported channel: ",
                channel))
    return Ok[str](channel)

@borrows
fn CompilerManagedMirrorKey(text: str): str =
    var out = ""
    for i in 0..<text.len:
        let ch = text[i]
        let digit = ch >= '0' && ch <= '9'
        let upper = ch >= 'A' && ch <= 'Z'
        let lower = ch >= 'a' && ch <= 'z'
        if digit || upper || lower || ch == '_' || ch == '-' || ch == '.':
            out = strutil.Join([strings.CloneStr(out), chengpath.TextSlice(text, i, 1)], "")
        else:
            out = strutil.Join([strings.CloneStr(out), "_"], "")
    if out.len <= 0:
        return "pkg"
    return out

@borrows
fn CompilerManagedMirrorRel(channel: str,
                              packageId: str,
                              managedMirrorBundleCid: layout.FixedBytes32): str =
    let bundleHex = layout.FixedBytes32Hex(managedMirrorBundleCid)
    return strutil.Join(["chengcache/cheng_managed_dependency_mirror/", CompilerManagedMirrorKey(channel), "/", CompilerManagedMirrorKey(packageId), "/", bundleHex], "")

@borrows
fn CompilerManagedMirrorRoot(rootDir: str,
                               channel: str,
                               packageId: str,
                               managedMirrorBundleCid: layout.FixedBytes32): str =
    return chengpath.PathAbsolute(rootDir,
                                 CompilerManagedMirrorRel(channel,
                                                            packageId,
                                                            managedMirrorBundleCid))

fn CompilerWorldAppendU32BE(buf: var layout.ByteBuf, value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn CompilerWorldAppendText(buf: var layout.ByteBuf, text: str) =
    CompilerWorldAppendU32BE(buf, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[i])

@borrows
fn CompilerWorldAppendFixed32(buf: var layout.ByteBuf, value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

fn CompilerWorldAppendU32Field(buf: var layout.ByteBuf, value: int64) =
    CompilerWorldAppendU32BE(buf, 4)
    CompilerWorldAppendU32BE(buf, value)

@borrows
fn CompilerWorldAppendFixed32Field(buf: var layout.ByteBuf,
                                    value: layout.FixedBytes32) =
    CompilerWorldAppendU32BE(buf, 32)
    CompilerWorldAppendFixed32(buf, value)

fn CompilerWorldBufCid(buf: var layout.ByteBuf): layout.FixedBytes32 =
    let cid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return cid

fn CompilerWorldStableTextCidInto(material: str,
                                  outCid: var layout.FixedBytes32) =
    var buf: layout.ByteBuf = layout.ByteBufInit(material.len + 96)
    CompilerWorldAppendText(buf, "cheng.compiler.stable_text")
    CompilerWorldAppendText(buf, material)
    outCid = CompilerWorldBufCid(buf)

# Stable source-document identity owned by the compiler.  Source text is
# deliberately absent: edits advance sourceVersion/contentCid while the same
# package/module declaration keeps one portable documentCid.
@borrows
fn CompilerWorldDocumentCidInto(
        packageIdRaw: str,
        modulePath: str,
        outCid: var layout.FixedBytes32,
        err: var str): bool =
    outCid = layout.FixedBytes32()
    err = ""
    let packageId = parser.ParserManifestNormalizePackageId(packageIdRaw)
    if packageId == "" || packageId != packageIdRaw:
        err = " compiler world: non-canonical document package id"
        return false
    if !parser.ParserSourceIdentityModuleTextValid(modulePath):
        err = " compiler world: invalid document module path"
        return false
    let packagePrefix = strutil.Join([share(packageId), "/"], "")
    var owned = parser.ParserStartsWithExact(modulePath, packagePrefix) &&
                modulePath.len > packagePrefix.len
    if packageId == "cheng":
        owned = owned ||
                (parser.ParserStartsWithExact(modulePath, "std/") &&
                 modulePath.len > 4) ||
                (parser.ParserStartsWithExact(modulePath, "runtime/") &&
                 modulePath.len > 8)
    if !owned:
        err = " compiler world: document module is not owned by package"
        return false
    var buf = layout.ByteBufInit(
        96 + packageId.len + modulePath.len)
    CompilerWorldAppendText(buf, "cheng.compiler.document_identity")
    CompilerWorldAppendText(buf, packageId)
    CompilerWorldAppendText(buf, modulePath)
    outCid = CompilerWorldBufCid(buf)
    return true

@borrows
fn CompilerWorldStrLess(left: str,
                          right: str): bool =
    if left == right:
        return false
    let leftLen = left.len
    let rightLen = right.len
    let sharedLen = leftLen < rightLen ? leftLen : rightLen
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return left[i] < right[i]
    return leftLen < rightLen

fn CompilerWorldSortPaths(items: var str[]) =
    if items.len <= 1:
        return
    for i in 1..<items.len:
        let value = items[i]
        var j = i
        while j > 0:
            if !CompilerWorldStrLess(value, items[j - 1]):
                break
            items[j] = share(items[j - 1])
            j = j - 1
        items[j] = share(value)

@borrows
fn CompilerWorldPathOrderInto(paths: str[],
                               outOrder: var int32[]) =
    var order: int32[]
    for pathIndex in 0..<paths.len:
        add(order, pathIndex)
    for i in 1..<order.len:
        let valueIndex = order[i]
        var j = i
        while j > 0:
            if !CompilerWorldStrLess(paths[valueIndex],
                                     paths[order[j - 1]]):
                break
            order[j] = order[j - 1]
            j = j - 1
        order[j] = valueIndex
    outOrder = order

@borrows
fn CompilerWorldHashText(tag: str, values: str[]): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerWorldAppendText(buf, "cheng.compiler.hash_text")
    CompilerWorldAppendText(buf, tag)
    CompilerWorldAppendU32Field(buf, values.len)
    for i in 0..<values.len:
        CompilerWorldAppendText(buf, values[i])
    return CompilerWorldBufCid(buf)

@borrows
fn CompilerWorldDefaultSyntaxSurfaceCid(packageId: str,
                                          channel: str,
                                          exportSurfaceCid: layout.FixedBytes32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    CompilerWorldDefaultSyntaxSurfaceCidInto(packageId, channel, exportSurfaceCid, out)
    return out

@borrows
fn CompilerWorldDefaultSyntaxSurfaceCidInto(packageId: str,
                                            channel: str,
                                            exportSurfaceCid: layout.FixedBytes32,
                                            out: var layout.FixedBytes32) =
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(packageId)
    let channelRes = CompilerWorldNormalizeChannel(channel)
    if canonicalPackageId == "" || canonicalPackageId != packageId ||
       IsErr(channelRes):
        system.Panic(" compiler world: syntax surface identity invalid")
    var buf: layout.ByteBuf = layout.ByteBufInit(160)
    CompilerWorldAppendText(buf, "cheng.compiler.syntax_surface")
    CompilerWorldAppendText(buf, canonicalPackageId)
    CompilerWorldAppendText(buf, Value(channelRes))
    CompilerWorldAppendFixed32Field(buf, exportSurfaceCid)
    out = CompilerWorldBufCid(buf)

@borrows
fn CompilerWorldManifestEntryLess(left: CompilerUniverseManifestEntry,
                                    right: CompilerUniverseManifestEntry): bool =
    return CompilerWorldStrLess(left.packageId, right.packageId)

fn CompilerWorldSortManifestEntries(entries: var CompilerUniverseManifestEntry[]) =
    if entries.len <= 1:
        return
    var order: int32[]
    for entryIndex in 0..<entries.len:
        add(order, entryIndex)
    for i in 1..<order.len:
        let valueIndex = order[i]
        var j = i
        while j > 0:
            if !CompilerWorldManifestEntryLess(entries[valueIndex],
                                               entries[order[j - 1]]):
                break
            order[j] = order[j - 1]
            j = j - 1
        order[j] = valueIndex
    var ordered: CompilerUniverseManifestEntry[]
    for i in 0..<order.len:
        add(ordered, CompilerWorldOwnManifestEntry(entries[order[i]]))
    entries = ordered

@borrows
fn CompilerUniverseManifestEntryMake(packageId: str,
                                       snapshotCid: layout.FixedBytes32,
                                       syntaxSurfaceCid: layout.FixedBytes32,
                                       migrationProofCid: layout.FixedBytes32): CompilerUniverseManifestEntry =
    return CompilerUniverseManifestEntryMake(packageId,
                                                snapshotCid,
                                                syntaxSurfaceCid,
                                                migrationProofCid,
                                                layout.FixedBytes32())

@borrows
fn CompilerUniverseManifestEntryMake(
        packageId: str,
        snapshotCid: layout.FixedBytes32,
        syntaxSurfaceCid: layout.FixedBytes32,
        migrationProofCid: layout.FixedBytes32,
        managedMirrorBundleCid: layout.FixedBytes32): CompilerUniverseManifestEntry =
    var out: CompilerUniverseManifestEntry
    CompilerUniverseManifestEntryMakeInto(packageId,
                                             snapshotCid,
                                             syntaxSurfaceCid,
                                             migrationProofCid,
                                             managedMirrorBundleCid,
                                             out)
    return out

@borrows
fn CompilerUniverseManifestEntryMakeInto(packageId: str,
                                         snapshotCid: layout.FixedBytes32,
                                         syntaxSurfaceCid: layout.FixedBytes32,
                                         migrationProofCid: layout.FixedBytes32,
                                         out: var CompilerUniverseManifestEntry) =
    CompilerUniverseManifestEntryMakeInto(packageId,
                                             snapshotCid,
                                             syntaxSurfaceCid,
                                             migrationProofCid,
                                             layout.FixedBytes32(),
                                             out)

@borrows
fn CompilerUniverseManifestEntryMakeInto(
        packageId: str,
        snapshotCid: layout.FixedBytes32,
        syntaxSurfaceCid: layout.FixedBytes32,
        migrationProofCid: layout.FixedBytes32,
        managedMirrorBundleCid: layout.FixedBytes32,
        out: var CompilerUniverseManifestEntry) =
    out.packageId = CompilerWorldOwnText(packageId)
    out.snapshotCid = layout.FixedBytes32Copy(snapshotCid)
    out.syntaxSurfaceCid = layout.FixedBytes32Copy(syntaxSurfaceCid)
    out.migrationProofCid = layout.FixedBytes32Copy(migrationProofCid)
    out.managedMirrorBundleCid = layout.FixedBytes32Copy(managedMirrorBundleCid)

@borrows
fn CompilerWorldOwnManifestEntry(entry: CompilerUniverseManifestEntry): CompilerUniverseManifestEntry =
    var out: CompilerUniverseManifestEntry
    out.packageId = CompilerWorldOwnText(entry.packageId)
    out.snapshotCid = entry.snapshotCid
    out.syntaxSurfaceCid = entry.syntaxSurfaceCid
    out.migrationProofCid = entry.migrationProofCid
    out.managedMirrorBundleCid = entry.managedMirrorBundleCid
    return out

@borrows
fn CompilerWorldOwnManifestEntries(entries: CompilerUniverseManifestEntry[]): CompilerUniverseManifestEntry[] =
    var out: CompilerUniverseManifestEntry[]
    for i in 0..<entries.len:
        add(out, CompilerWorldOwnManifestEntry(entries[i]))
    return out

@borrows
fn CompilerWorldManifestEntryAppendOrReplace(entries: var CompilerUniverseManifestEntry[],
                                               entry: CompilerUniverseManifestEntry) =
    for i in 0..<entries.len:
        if entries[i].packageId != entry.packageId:
            continue
        entries[i] = CompilerWorldOwnManifestEntry(entry)
        return
    add(entries, CompilerWorldOwnManifestEntry(entry))

@borrows
fn CompilerWorldManifestEntryOrderInto(
        entries: CompilerUniverseManifestEntry[],
        excludedIndex: int32,
        outOrder: var int32[]) =
    var order: int32[]
    for entryIndex in 0..<entries.len:
        if entryIndex != excludedIndex:
            add(order, entryIndex)
    for index in 1..<order.len:
        let valueIndex = order[index]
        var targetIndex = index
        while targetIndex > 0:
            if !CompilerWorldStrLess(
                    entries[valueIndex].packageId,
                    entries[order[targetIndex - 1]].packageId):
                break
            order[targetIndex] = order[targetIndex - 1]
            targetIndex = targetIndex - 1
        order[targetIndex] = valueIndex
    outOrder = order

@borrows
fn CompilerWorldHashUniverseManifest(channel: str,
                                      managedDependencyReceiptCid: layout.FixedBytes32,
                                      entries: CompilerUniverseManifestEntry[]): layout.FixedBytes32 =
    var order: int32[]
    CompilerWorldManifestEntryOrderInto(entries, -1, order)
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerWorldAppendText(buf, "cheng.compiler.universe_manifest")
    CompilerWorldAppendText(buf, channel)
    CompilerWorldAppendFixed32Field(buf, managedDependencyReceiptCid)
    CompilerWorldAppendU32Field(buf, order.len)
    for index in 0..<order.len:
        let entryIndex = order[index]
        CompilerWorldAppendText(buf, entries[entryIndex].packageId)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].snapshotCid)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].syntaxSurfaceCid)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].migrationProofCid)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].managedMirrorBundleCid)
    return CompilerWorldBufCid(buf)

fn CompilerUniverseManifestMake(channelRaw: str,
                                  entries: CompilerUniverseManifestEntry[]): Result[CompilerUniverseManifest] =
    return CompilerUniverseManifestMake(channelRaw,
                                           entries,
                                           layout.FixedBytes32())

fn CompilerUniverseManifestMake(
        channelRaw: str,
        entries: CompilerUniverseManifestEntry[],
        managedDependencyReceiptCid: layout.FixedBytes32): Result[CompilerUniverseManifest] =
    var out: CompilerUniverseManifest
    var err: str
    if !CompilerUniverseManifestMakeInto(channelRaw,
                                            entries,
                                            managedDependencyReceiptCid,
                                            out,
                                            err):
        return Err[CompilerUniverseManifest](err)
    return Ok[CompilerUniverseManifest](out)

@borrows
fn CompilerUniverseManifestMakeInto(channelRaw: str,
                                    entries: CompilerUniverseManifestEntry[],
                                    out: var CompilerUniverseManifest,
                                    outErr: var str): bool =
    return CompilerUniverseManifestMakeInto(channelRaw,
                                               entries,
                                               layout.FixedBytes32(),
                                               out,
                                               outErr)

@borrows
fn CompilerUniverseManifestMakeInto(
        channelRaw: str,
        entries: CompilerUniverseManifestEntry[],
        managedDependencyReceiptCid: layout.FixedBytes32,
        out: var CompilerUniverseManifest,
        outErr: var str): bool =
    outErr = ""
    let channelRes = CompilerWorldNormalizeChannel(channelRaw)
    if IsErr(channelRes):
        outErr = Error(channelRes)
        return false
    let channel = Value(channelRes)
    var ordered: CompilerUniverseManifestEntry[]
    for i in 0..<entries.len:
        add(ordered, CompilerWorldOwnManifestEntry(entries[i]))
    CompilerWorldSortManifestEntries(ordered)
    var hasManagedMirror = false
    for i in 0..<ordered.len:
        let canonicalPackageId = parser.ParserManifestNormalizePackageId(
            ordered[i].packageId)
        if canonicalPackageId == "" ||
           canonicalPackageId != ordered[i].packageId:
            outErr = Fmt" compiler world: manifest package identity invalid index={i}"
            return false
        if i > 0 && ordered[i - 1].packageId == ordered[i].packageId:
            outErr = Fmt" compiler world: duplicate manifest package identity index={i}"
            return false
        if layout.FixedBytes32Equal(ordered[i].snapshotCid,
                                    layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(ordered[i].syntaxSurfaceCid,
                                    layout.FixedBytes32()):
            outErr = Fmt" compiler world: manifest identity cid missing index={i}"
            return false
        let proofMissing = layout.FixedBytes32Equal(
            ordered[i].migrationProofCid,
            layout.FixedBytes32())
        let mirrorMissing = layout.FixedBytes32Equal(
            ordered[i].managedMirrorBundleCid,
            layout.FixedBytes32())
        if channel == "stable" && proofMissing != mirrorMissing:
            outErr = Fmt" compiler world: stable manifest proof/mirror pair incomplete index={i}"
            return false
        if !mirrorMissing:
            hasManagedMirror = true
    let dependencyReceiptMissing = layout.FixedBytes32Equal(
        managedDependencyReceiptCid,
        layout.FixedBytes32())
    if channel == "stable" && hasManagedMirror == dependencyReceiptMissing:
        outErr = " compiler world: stable manifest managed dependency receipt presence mismatch"
        return false
    out.channel = CompilerWorldOwnText(channel)
    out.entryCount = ordered.len
    out.managedDependencyReceiptCid = managedDependencyReceiptCid
    out.entries = CompilerWorldOwnManifestEntries(ordered)
    out.manifestCid = CompilerWorldHashUniverseManifest(
        channel,
        managedDependencyReceiptCid,
        ordered)
    if !CompilerUniverseManifestStrictValidateInto(out, outErr):
        return false
    return true

@borrows
fn CompilerUniverseManifestStrictValidateInto(
        manifest: CompilerUniverseManifest,
        err: var str): bool =
    let channelRes = CompilerWorldNormalizeChannel(manifest.channel)
    if IsErr(channelRes) || Value(channelRes) != manifest.channel ||
       manifest.entryCount <= 0 ||
       manifest.entryCount != manifest.entries.len:
        err = " compiler world: universe manifest shape invalid"
        return false
    let zero = layout.FixedBytes32()
    var hasManagedMirror = false
    for entryIndex in 0..<manifest.entries.len:
        let canonicalPackageId = parser.ParserManifestNormalizePackageId(
            manifest.entries[entryIndex].packageId)
        if canonicalPackageId == "" ||
           canonicalPackageId != manifest.entries[entryIndex].packageId ||
           !parser.ParserSourceIdentityModuleTextValid(
               manifest.entries[entryIndex].packageId):
            err = Fmt" compiler world: universe manifest package identity invalid index={entryIndex}"
            return false
        if entryIndex > 0 &&
           !CompilerWorldStrLess(
               manifest.entries[entryIndex - 1].packageId,
               manifest.entries[entryIndex].packageId):
            err = Fmt" compiler world: universe manifest entry order invalid index={entryIndex}"
            return false
        if layout.FixedBytes32Equal(
               manifest.entries[entryIndex].snapshotCid, zero) ||
           layout.FixedBytes32Equal(
               manifest.entries[entryIndex].syntaxSurfaceCid, zero):
            err = Fmt" compiler world: universe manifest identity cid missing index={entryIndex}"
            return false
        let proofMissing = layout.FixedBytes32Equal(
            manifest.entries[entryIndex].migrationProofCid,
            zero)
        let mirrorMissing = layout.FixedBytes32Equal(
            manifest.entries[entryIndex].managedMirrorBundleCid,
            zero)
        if manifest.channel == "stable" && proofMissing != mirrorMissing:
            err = Fmt" compiler world: stable universe manifest proof/mirror pair incomplete index={entryIndex}"
            return false
        if !mirrorMissing:
            hasManagedMirror = true
    let dependencyReceiptMissing = layout.FixedBytes32Equal(
        manifest.managedDependencyReceiptCid,
        zero)
    if manifest.channel == "stable" &&
       hasManagedMirror == dependencyReceiptMissing:
        err = " compiler world: stable universe manifest managed dependency receipt presence mismatch"
        return false
    let expectedCid = CompilerWorldHashUniverseManifest(
        manifest.channel,
        manifest.managedDependencyReceiptCid,
        manifest.entries)
    if layout.FixedBytes32Equal(manifest.manifestCid, zero) ||
       !layout.FixedBytes32Equal(manifest.manifestCid, expectedCid):
        err = " compiler world: universe manifest cid mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerWorldEmptyManifestCid(channelRaw: str): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    CompilerWorldEmptyManifestCidInto(channelRaw, out)
    return out

@borrows
fn CompilerWorldEmptyManifestCidInto(channelRaw: str,
                                     out: var layout.FixedBytes32) =
    var entries: CompilerUniverseManifestEntry[]
    CompilerWorldDepsManifestCidInto(channelRaw, entries, out)

@borrows
fn CompilerWorldDepsManifestCid(channelRaw: str,
                                  entries: CompilerUniverseManifestEntry[]): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    CompilerWorldDepsManifestCidInto(channelRaw, entries, out)
    return out

@borrows
fn CompilerWorldDepsManifestCidInto(channelRaw: str,
                                    entries: CompilerUniverseManifestEntry[],
                                    out: var layout.FixedBytes32) =
    CompilerWorldDepsManifestCidExcludingIndexInto(
        channelRaw, entries, -1, out)

@borrows
fn CompilerWorldDepsManifestCidExcludingIndexInto(
        channelRaw: str,
        entries: CompilerUniverseManifestEntry[],
        excludedIndex: int32,
        out: var layout.FixedBytes32) =
    let channelRes = CompilerWorldNormalizeChannel(channelRaw)
    if IsErr(channelRes):
        system.Panic(Error(channelRes))
    let channel = Value(channelRes)
    var order: int32[]
    CompilerWorldManifestEntryOrderInto(entries, excludedIndex, order)
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerWorldAppendText(buf, "cheng.compiler.deps_manifest")
    CompilerWorldAppendText(buf, channel)
    CompilerWorldAppendU32Field(buf, order.len)
    for index in 0..<order.len:
        let entryIndex = order[index]
        CompilerWorldAppendText(buf, entries[entryIndex].packageId)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].snapshotCid)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].syntaxSurfaceCid)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].migrationProofCid)
        CompilerWorldAppendFixed32Field(
            buf, entries[entryIndex].managedMirrorBundleCid)
    out = CompilerWorldBufCid(buf)

@borrows
fn CompilerWorldDepsManifestCidExcludingIndex(
        channelRaw: str,
        entries: CompilerUniverseManifestEntry[],
        excludedIndex: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    CompilerWorldDepsManifestCidExcludingIndexInto(
        channelRaw, entries, excludedIndex, out)
    return out

@borrows
fn CompilerWorldHashPackageSnapshot(packageId: str,
                                      channel: str,
                                      sourceBundleCid: layout.FixedBytes32,
                                      csgRootCid: layout.FixedBytes32,
                                      exportSurfaceCid: layout.FixedBytes32,
                                      syntaxSurfaceCid: layout.FixedBytes32,
                                      depsManifestCid: layout.FixedBytes32,
                                      migrationProofCid: layout.FixedBytes32,
                                      signature: str): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerWorldAppendText(buf, "cheng.compiler.package_snapshot")
    CompilerWorldAppendText(buf, packageId)
    CompilerWorldAppendText(buf, channel)
    CompilerWorldAppendFixed32Field(buf, sourceBundleCid)
    CompilerWorldAppendFixed32Field(buf, csgRootCid)
    CompilerWorldAppendFixed32Field(buf, exportSurfaceCid)
    CompilerWorldAppendFixed32Field(buf, syntaxSurfaceCid)
    CompilerWorldAppendFixed32Field(buf, depsManifestCid)
    CompilerWorldAppendFixed32Field(buf, migrationProofCid)
    CompilerWorldAppendText(buf, signature)
    return CompilerWorldBufCid(buf)

@borrows
fn CompilerWorldManifestRootCid(manifest: CompilerUniverseManifest): layout.FixedBytes32 =
    var err: str
    if !CompilerUniverseManifestStrictValidateInto(manifest, err):
        system.Panic(err)
    return manifest.manifestCid

@borrows
fn CompilerWorldHashHead(universeId: str,
                           channel: str,
                           headEpoch: int32,
                           prevHeadCid: layout.FixedBytes32,
                           manifestRootCid: layout.FixedBytes32,
                           csgRootCid: layout.FixedBytes32,
                           compilerPkgCid: layout.FixedBytes32,
                           stdPkgCid: layout.FixedBytes32,
                           runtimePkgCid: layout.FixedBytes32,
                           signature: str): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerWorldAppendText(buf, "cheng.compiler.world_head")
    CompilerWorldAppendText(buf, universeId)
    CompilerWorldAppendText(buf, channel)
    CompilerWorldAppendU32Field(buf, headEpoch)
    CompilerWorldAppendFixed32Field(buf, prevHeadCid)
    CompilerWorldAppendFixed32Field(buf, manifestRootCid)
    CompilerWorldAppendFixed32Field(buf, csgRootCid)
    CompilerWorldAppendFixed32Field(buf, compilerPkgCid)
    CompilerWorldAppendFixed32Field(buf, stdPkgCid)
    CompilerWorldAppendFixed32Field(buf, runtimePkgCid)
    CompilerWorldAppendText(buf, signature)
    return CompilerWorldBufCid(buf)

@borrows
@borrow_result
fn CompilerWorldTextSliceFast(text: str,
                               startRaw: int32,
                               countRaw: int32): str =
    if countRaw <= 0:
        return ""
    let textLen = text.len
    if textLen <= 0:
        return ""
    var start = startRaw
    if start < 0:
        start = 0
    if start >= textLen:
        return ""
    var count = countRaw
    if start + count > textLen:
        count = textLen - start
    if count <= 0:
        return ""
    if system.StrDataPtr(text) == nil:
        return ""
    return StrSubView(text, start, count)

fn CompilerWorldFindText(text: str, needle: str): int32 =
    if needle.len <= 0:
        return 0
    if needle.len > text.len:
        return -1
    for i in 0..<(text.len - needle.len + 1):
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return i
    return -1

@borrows
fn CompilerWorldCanonicalSourcePathInto(sourcePathRaw: str,
                                        outSourcePath: var str): bool =
    outSourcePath = ""
    if sourcePathRaw == "":
        return false
    let ownedSourcePath = CompilerWorldOwnText(sourcePathRaw)
    let hostSourcePath = chengpath.PathHostFilePath(ownedSourcePath)
    var absoluteSourcePath: str
    if parser.ParserSourceIdentityPathAbsolute(hostSourcePath):
        absoluteSourcePath = hostSourcePath
    else:
        absoluteSourcePath = strutil.Join([os.GetCurrentDir(),
                                           "/",
                                           hostSourcePath],
                                          "")
    var canonicalSourcePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(absoluteSourcePath,
                                                   canonicalSourcePath):
        return false
    if !parser.ParserSourceIdentityPathAbsolute(canonicalSourcePath):
        return false
    outSourcePath = CompilerWorldOwnText(canonicalSourcePath)
    return true

@borrows
fn CompilerWorldSourceBundleCidFromIdentityTexts(packageId: str,
                                                   identityPaths: str[],
                                                   sourceTexts: str[]): Result[layout.FixedBytes32] =
    var cid: layout.FixedBytes32
    if !CompilerWorldSourceBundleCidFromIdentityTextsInto(packageId,
                                                          identityPaths,
                                                          sourceTexts,
                                                          cid):
        return Err[layout.FixedBytes32](" compiler world: source bundle identity build failed")
    return Ok[layout.FixedBytes32](cid)

@borrows
fn CompilerWorldSourceRawBytesCidFromSpan(
        sourceBytes: layout.ByteSpan): layout.FixedBytes32 =
    var header: layout.ByteBuf = layout.ByteBufInit(64)
    CompilerWorldAppendText(header, "cheng.compiler.source_raw_bytes")
    CompilerWorldAppendU32BE(header, layout.ByteSpanLen(sourceBytes))
    let cid = hash256.Sha256FixedTwo(layout.ByteBufView(header), sourceBytes)
    layout.ByteBufFree(header)
    return cid

@borrows
fn CompilerWorldSourceRawBytesCidBorrowed(
        sourceText: str): layout.FixedBytes32 =
    let sourceBytes = rawbytes.BytesFromString(sourceText)
    return CompilerWorldSourceRawBytesCidFromSpan(
        layout.ByteSpanFromBytes(sourceBytes))

@borrows
fn CompilerWorldSourceRawBytesCid(sourceText: str): layout.FixedBytes32 =
    return CompilerWorldSourceRawBytesCidBorrowed(sourceText)

@borrows
fn CompilerWorldPortableImportEdgeLess(left: parser.ImportEdge,
                                        right: parser.ImportEdge): bool =
    if left.ownerModulePath != right.ownerModulePath:
        return CompilerWorldStrLess(left.ownerModulePath,
                                    right.ownerModulePath)
    if left.targetModulePath != right.targetModulePath:
        return CompilerWorldStrLess(left.targetModulePath,
                                    right.targetModulePath)
    if left.importAlias != right.importAlias:
        return CompilerWorldStrLess(left.importAlias, right.importAlias)
    if left.qualifier != right.qualifier:
        return CompilerWorldStrLess(left.qualifier, right.qualifier)
    if left.allowsUnqualifiedCall != right.allowsUnqualifiedCall:
        return !left.allowsUnqualifiedCall
    return !left.resolved && right.resolved

@borrows
fn CompilerWorldPortableImportEdgeEqual(left: parser.ImportEdge,
                                         right: parser.ImportEdge): bool =
    return left.ownerModulePath == right.ownerModulePath &&
           left.targetModulePath == right.targetModulePath &&
           left.importAlias == right.importAlias &&
           left.qualifier == right.qualifier &&
           left.allowsUnqualifiedCall == right.allowsUnqualifiedCall &&
           left.resolved == right.resolved

@borrows
fn CompilerWorldSortPortableImportEdgesMergePassRec(
        src: var parser.ImportEdge[],
        dst: var parser.ImportEdge[],
        width: int32,
        leftStart: int32) =
    let count = src.len
    if leftStart >= count:
        return
    if leftStart % 4096 == 0:
        os.ProcessResourceGuardCheck()
    let midRaw = leftStart + width
    var mid = count
    if midRaw < count:
        mid = midRaw
    let rightEndRaw = leftStart + width * 2
    var rightEnd = count
    if rightEndRaw < count:
        rightEnd = rightEndRaw
    var left = leftStart
    var right = mid
    for outIndex in leftStart..<rightEnd:
        if left < mid &&
           (right >= rightEnd ||
            !CompilerWorldPortableImportEdgeLess(src[right], src[left])):
            dst[outIndex] = src[left]
            left = left + 1
        else:
            dst[outIndex] = src[right]
            right = right + 1
    CompilerWorldSortPortableImportEdgesMergePassRec(
        src, dst, width, leftStart + width * 2)

@borrows
fn CompilerWorldClonePortableImportEdgesRec(
        dst: var parser.ImportEdge[],
        src: var parser.ImportEdge[],
        index: int32,
        count: int32) =
    if index >= count:
        return
    add(dst, share(src[index]))
    CompilerWorldClonePortableImportEdgesRec(dst, src, index + 1, count)

@borrows
fn CompilerWorldCopyPortableImportEdgesRec(
        dst: var parser.ImportEdge[],
        src: var parser.ImportEdge[],
        index: int32,
        count: int32) =
    if index >= count:
        return
    dst[index] = src[index]
    CompilerWorldCopyPortableImportEdgesRec(dst, src, index + 1, count)

@borrows
fn CompilerWorldSortPortableImportEdgesWidthRec(
        edges: var parser.ImportEdge[],
        scratch: var parser.ImportEdge[],
        count: int32,
        width: int32,
        readScratch: bool): bool =
    if width >= count:
        return readScratch
    if readScratch:
        CompilerWorldSortPortableImportEdgesMergePassRec(scratch, edges, width, 0)
    else:
        CompilerWorldSortPortableImportEdgesMergePassRec(edges, scratch, width, 0)
    var nextWidth = width * 2
    if width > count / 2:
        nextWidth = count
    return CompilerWorldSortPortableImportEdgesWidthRec(
        edges, scratch, count, nextWidth, !readScratch)

fn CompilerWorldSortPortableImportEdges(edges: var parser.ImportEdge[]) =
    if edges.len <= 1:
        return
    let count = edges.len
    var scratch: parser.ImportEdge[]
    CompilerWorldClonePortableImportEdgesRec(scratch, edges, 0, count)
    let readScratch = CompilerWorldSortPortableImportEdgesWidthRec(
        edges, scratch, count, 1, false)
    if readScratch:
        CompilerWorldCopyPortableImportEdgesRec(edges, scratch, 0, count)

fn CompilerWorldPortableAppendU32Field(buf: var layout.ByteBuf,
                                       value: int32) =
    CompilerWorldAppendU32Field(buf, value)

@borrows
fn CompilerWorldPortableImportGraphCidInto(
        packageId: str,
        importEdges: parser.ImportEdge[],
        unresolvedImportCount: int32,
        outCid: var layout.FixedBytes32,
        err: var str): bool =
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(packageId)
    if canonicalPackageId == "" || canonicalPackageId != packageId:
        err = " compiler world: portable import graph package identity invalid"
        return false
    if unresolvedImportCount != 0:
        err = Fmt" compiler world: portable import graph unresolved imports count={unresolvedImportCount}"
        return false
    var ordered: parser.ImportEdge[]
    for edgeIndex in 0..<importEdges.len:
        let edge = importEdges[edgeIndex]
        # Owner/target identities are either exact module paths or, for
        # root-out sources, canonical absolute source file paths; the two
        # domains never collide because module paths are never absolute.
        if !edge.resolved:
            err = Fmt" compiler world: portable import graph contains unresolved or invalid edge index={edgeIndex}"
            return false
        if !parser.ParserSourceIdentityPathAbsolute(edge.ownerModulePath) &&
           !parser.ParserSourceIdentityModuleTextValid(
                edge.ownerModulePath):
            err = Fmt" compiler world: portable import graph contains unresolved or invalid edge index={edgeIndex}"
            return false
        if !parser.ParserSourceIdentityPathAbsolute(
                edge.targetModulePath) &&
           !parser.ParserSourceIdentityModuleTextValid(
                edge.targetModulePath):
            err = Fmt" compiler world: portable import graph contains unresolved or invalid edge index={edgeIndex}"
            return false
        add(ordered, share(edge))
    CompilerWorldSortPortableImportEdges(ordered)
    for edgeIndex in 1..<ordered.len:
        if CompilerWorldPortableImportEdgeEqual(ordered[edgeIndex - 1],
                                                ordered[edgeIndex]):
            err = Fmt" compiler world: portable import graph contains duplicate edge index={edgeIndex}"
            return false
    var buf: layout.ByteBuf = layout.ByteBufInit(128 + ordered.len * 96)
    CompilerWorldAppendText(buf,
                            "cheng.compiler.portable_import_graph")
    CompilerWorldAppendText(buf, canonicalPackageId)
    CompilerWorldPortableAppendU32Field(buf, ordered.len)
    for edgeIndex in 0..<ordered.len:
        let edge = ordered[edgeIndex]
        CompilerWorldAppendText(buf, edge.ownerModulePath)
        CompilerWorldAppendText(buf, edge.targetModulePath)
        CompilerWorldAppendText(buf, edge.importAlias)
        CompilerWorldAppendText(buf, edge.qualifier)
        CompilerWorldPortableAppendU32Field(
            buf,
            edge.allowsUnqualifiedCall ? 1 : 0)
        CompilerWorldPortableAppendU32Field(buf, 1)
    CompilerWorldPortableAppendU32Field(buf, unresolvedImportCount)
    outCid = CompilerWorldBufCid(buf)
    err = ""
    return true

@borrows
fn CompilerWorldSourceBundleCidFromIdentityTextsBorrowedInto(
        packageId: str,
        identityPaths: str[],
        sourceTexts: str[],
        outCid: var layout.FixedBytes32): bool =
    CompilerWorldTraceLine("cworld:identity-start")
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(packageId)
    if canonicalPackageId == "" || canonicalPackageId != packageId ||
       !parser.ParserSourceIdentityModuleTextValid(canonicalPackageId):
        return false
    if identityPaths.len <= 0 ||
       identityPaths.len != sourceTexts.len:
        return false
    for i in 0..<identityPaths.len:
        let identityPath = identityPaths[i]
        if !parser.ParserSourceIdentityModuleTextValid(identityPath) ||
           (identityPath.len >= 6 &&
            chengpath.TextSlice(identityPath,
                                identityPath.len - 6,
                                6) == ".cheng"):
            return false
    var pathOrder: int32[]
    CompilerWorldTraceLine("cworld:identity-before-sort")
    CompilerWorldPathOrderInto(identityPaths, pathOrder)
    CompilerWorldTraceLine("cworld:identity-after-sort")
    for i in 0..<pathOrder.len:
        if identityPaths[pathOrder[i]] == "":
            return false
    for i in 1..<pathOrder.len:
        if identityPaths[pathOrder[i]] !=
           identityPaths[pathOrder[i - 1]]:
            continue
        let duplicatePath = identityPaths[pathOrder[i]]
        CompilerWorldTraceLine("cworld:duplicate")
        CompilerWorldTraceLine(duplicatePath)
        return false
    CompilerWorldTraceLine("cworld:identity-before-buf")
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerWorldTraceLine("cworld:identity-buf")
    CompilerWorldAppendText(buf, "cheng.compiler.source_bundle.portable")
    CompilerWorldTraceLine("cworld:identity-tag")
    CompilerWorldAppendText(buf, packageId)
    CompilerWorldTraceLine("cworld:identity-package")
    CompilerWorldAppendU32Field(buf, pathOrder.len)
    CompilerWorldTraceLine("cworld:identity-count")
    for i in 0..<pathOrder.len:
        let sourceIndex = pathOrder[i]
        CompilerWorldTraceLine("cworld:identity-append-loop")
        CompilerWorldAppendText(buf, identityPaths[sourceIndex])
        CompilerWorldAppendU32Field(buf, sourceTexts[sourceIndex].len)
        CompilerWorldAppendFixed32Field(
            buf,
            CompilerWorldSourceRawBytesCidBorrowed(
                sourceTexts[sourceIndex]))
    CompilerWorldTraceLine("cworld:identity-before-hash")
    outCid = CompilerWorldBufCid(buf)
    return true

@borrows
fn CompilerWorldSourceBundleCidFromIdentityTextsInto(packageId: str,
                                                     identityPaths: str[],
                                                     sourceTexts: str[],
                                                     outCid: var layout.FixedBytes32): bool =
    return CompilerWorldSourceBundleCidFromIdentityTextsBorrowedInto(
        packageId,
        identityPaths,
        sourceTexts,
        outCid)

@borrows
fn CompilerWorldSourceBundleModulePathInto(workspaceRootRaw: str,
                                            packageRootRaw: str,
                                            packageIdRaw: str,
                                            externalPackageRoots: parser.ParserExternalPackageRoot[],
                                            sourcePathRaw: str,
                                            out: var str) =
    out = ""
    var exactModulePath: str
    if !parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
            workspaceRootRaw,
            packageRootRaw,
            packageIdRaw,
            externalPackageRoots,
            sourcePathRaw,
            exactModulePath):
        return
    out = exactModulePath

@borrows
fn CompilerWorldSourceBundleModulePath(workspaceRootRaw: str,
                                         packageRootRaw: str,
                                         packageIdRaw: str,
                                         externalPackageRoots: parser.ParserExternalPackageRoot[],
                                         sourcePathRaw: str): str =
    var out: str
    CompilerWorldSourceBundleModulePathInto(workspaceRootRaw,
                                            packageRootRaw,
                                            packageIdRaw,
                                            externalPackageRoots,
                                            sourcePathRaw,
                                            out)
    return out

@borrows
fn CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
        workspaceRootRaw: str,
        packageRootRaw: str,
        packageIdRaw: str,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        sourcePaths: str[],
        outIdentityPaths: var str[]): bool =
    if sourcePaths.len <= 0:
        return false
    var identityPaths: str[]
    for sourceIndex in 0..<sourcePaths.len:
        let sourcePath = sourcePaths[sourceIndex]
        if sourcePath == "":
            return false
        var identityPath: str
        CompilerWorldSourceBundleModulePathInto(workspaceRootRaw,
                                                packageRootRaw,
                                                packageIdRaw,
                                                externalPackageRoots,
                                                sourcePath,
                                                identityPath)
        if identityPath == "":
            return false
        add(identityPaths, identityPath)
    var orderedIdentityPaths: str[]
    for identityIndex in 0..<identityPaths.len:
        add(orderedIdentityPaths,
            strings.CloneStr(identityPaths[identityIndex]))
    CompilerWorldSortPaths(orderedIdentityPaths)
    for identityIndex in 1..<orderedIdentityPaths.len:
        if orderedIdentityPaths[identityIndex] ==
           orderedIdentityPaths[identityIndex - 1]:
            return false
    outIdentityPaths = identityPaths
    return true

@borrows
fn CompilerWorldSourceBundleCidFromIdentitySourceFilesInto(
        packageId: str,
        identityPaths: str[],
        sourcePaths: str[],
        outCid: var layout.FixedBytes32): bool =
    if identityPaths.len <= 0 || identityPaths.len != sourcePaths.len:
        return false
    var sourceTexts: str[]
    for sourceIndex in 0..<sourcePaths.len:
        if identityPaths[sourceIndex] == "" || sourcePaths[sourceIndex] == "":
            return false
        let sourceFilePath = system.SystemToStringStr(sourcePaths[sourceIndex])
        if !os.FileExists(sourceFilePath):
            return false
        add(sourceTexts, chengpath.ReadTextFile("", sourceFilePath))
    return CompilerWorldSourceBundleCidFromIdentityTextsInto(packageId,
                                                              identityPaths,
                                                              sourceTexts,
                                                              outCid)

@borrows
fn CompilerWorldSourceBundleCidWithExternalPackageRoots(packageId: str,
                                                          workspaceRootRaw: str,
                                                          packageRootRaw: str,
                                                          externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                          sourcePaths: str[]): Result[layout.FixedBytes32] =
    var cid: layout.FixedBytes32
    if !CompilerWorldSourceBundleCidWithExternalPackageRootsInto(packageId,
                                                                 workspaceRootRaw,
                                                                 packageRootRaw,
                                                                 externalPackageRoots,
                                                                 sourcePaths,
                                                                 cid):
        return Err[layout.FixedBytes32](" compiler world: source bundle cid unavailable")
    return Ok[layout.FixedBytes32](cid)

@borrows
fn CompilerWorldSourceBundleCidWithExternalPackageRootsInto(packageId: str,
                                                            workspaceRootRaw: str,
                                                            packageRootRaw: str,
                                                            externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                            sourcePaths: str[],
                                                            outCid: var layout.FixedBytes32): bool =
    CompilerWorldTraceLine("cworld:cid-start")
    var modulePaths: str[]
    if !CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
            workspaceRootRaw,
            packageRootRaw,
            packageId,
            externalPackageRoots,
            sourcePaths,
            modulePaths):
        CompilerWorldTraceLine("cworld:module-path-unresolved")
        return false
    CompilerWorldTraceLine("cworld:cid-before-identity")
    return CompilerWorldSourceBundleCidFromIdentitySourceFilesInto(packageId,
                                                                    modulePaths,
                                                                    sourcePaths,
                                                                    outCid)

@borrows
fn CompilerWorldSourceBundleCidSingleModuleSourceInto(
        packageId: str,
        modulePath: str,
        sourcePath: str,
        outCid: var layout.FixedBytes32): bool =
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(
        packageId)
    if canonicalPackageId == "" || canonicalPackageId != packageId ||
       !parser.ParserSourceIdentityModuleTextValid(packageId) ||
       !parser.ParserSourceIdentityModuleTextValid(modulePath) ||
       modulePath.len <= packageId.len ||
       modulePath[packageId.len] != '/':
        return false
    for packageIndex in 0..<packageId.len:
        if modulePath[packageIndex] != packageId[packageIndex]:
            return false
    var canonicalSourcePath: str
    if !CompilerWorldCanonicalSourcePathInto(sourcePath,
                                             canonicalSourcePath) ||
       !os.FileExists(canonicalSourcePath):
        return false
    return CompilerWorldSourceBundleCidFromIdentityTextsInto(
        packageId,
        [CompilerWorldOwnText(modulePath)],
        [chengpath.ReadTextFile("", canonicalSourcePath)],
        outCid)

@borrows
fn CompilerWorldSourceBundleCidFromModuleTexts(packageId: str,
                                                 modulePaths: str[],
                                                 sourceTexts: str[]): Result[layout.FixedBytes32] =
    return CompilerWorldSourceBundleCidFromIdentityTexts(
        packageId,
        modulePaths,
        sourceTexts)

@borrows
fn CompilerPackageSnapshotMake(packageId: str,
                                 channel: str,
                                 sourceBundleCid: layout.FixedBytes32,
                                 csgRootCid: layout.FixedBytes32,
                                 exportSurfaceCid: layout.FixedBytes32,
                                 syntaxSurfaceCid: layout.FixedBytes32,
                                 depsManifestCid: layout.FixedBytes32,
                                 migrationProofCid: layout.FixedBytes32,
                                 signature: str): CompilerPackageSnapshot =
    let packageIdOwned = CompilerWorldOwnText(packageId)
    let channelOwned = CompilerWorldOwnText(channel)
    let signatureOwned = CompilerWorldOwnText(signature)
    let sourceBundleCidOwned = layout.FixedBytes32Copy(sourceBundleCid)
    let csgRootCidOwned = layout.FixedBytes32Copy(csgRootCid)
    let exportSurfaceCidOwned = layout.FixedBytes32Copy(exportSurfaceCid)
    let syntaxSurfaceCidOwned = layout.FixedBytes32Copy(syntaxSurfaceCid)
    let depsManifestCidOwned = layout.FixedBytes32Copy(depsManifestCid)
    let migrationProofCidOwned = layout.FixedBytes32Copy(migrationProofCid)
    var out: CompilerPackageSnapshot
    out.packageId = share(packageIdOwned)
    out.channel = share(channelOwned)
    out.sourceBundleCid = sourceBundleCidOwned
    out.csgRootCid = csgRootCidOwned
    out.exportSurfaceCid = exportSurfaceCidOwned
    out.syntaxSurfaceCid = syntaxSurfaceCidOwned
    out.depsManifestCid = depsManifestCidOwned
    out.migrationProofCid = migrationProofCidOwned
    out.signature = share(signatureOwned)
    out.snapshotCid = CompilerWorldHashPackageSnapshot(packageIdOwned,
                                                         channelOwned,
                                                         sourceBundleCidOwned,
                                                         csgRootCidOwned,
                                                         exportSurfaceCidOwned,
                                                         syntaxSurfaceCidOwned,
                                                         depsManifestCidOwned,
                                                         migrationProofCidOwned,
                                                         signatureOwned)
    var snapshotErr: str
    if !CompilerPackageSnapshotStrictValidateInto(out, snapshotErr):
        system.Panic(snapshotErr)
    return out

@borrows
fn CompilerPackageSnapshotStrictValidateInto(
        snapshot: CompilerPackageSnapshot,
        err: var str): bool =
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(
        snapshot.packageId)
    let channelRes = CompilerWorldNormalizeChannel(snapshot.channel)
    if canonicalPackageId == "" || canonicalPackageId != snapshot.packageId ||
       IsErr(channelRes) || Value(channelRes) != snapshot.channel ||
       snapshot.signature == "":
        err = " compiler world: package snapshot identity invalid"
        return false
    let zero = layout.FixedBytes32()
    if layout.FixedBytes32Equal(snapshot.sourceBundleCid, zero) ||
       layout.FixedBytes32Equal(snapshot.csgRootCid, zero) ||
       layout.FixedBytes32Equal(snapshot.exportSurfaceCid, zero) ||
       layout.FixedBytes32Equal(snapshot.syntaxSurfaceCid, zero) ||
       layout.FixedBytes32Equal(snapshot.depsManifestCid, zero) ||
       layout.FixedBytes32Equal(snapshot.snapshotCid, zero):
        err = " compiler world: package snapshot contains zero identity cid"
        return false
    let expectedCid = CompilerWorldHashPackageSnapshot(
        snapshot.packageId,
        snapshot.channel,
        snapshot.sourceBundleCid,
        snapshot.csgRootCid,
        snapshot.exportSurfaceCid,
        snapshot.syntaxSurfaceCid,
        snapshot.depsManifestCid,
        snapshot.migrationProofCid,
        snapshot.signature)
    if !layout.FixedBytes32Equal(snapshot.snapshotCid, expectedCid):
        err = " compiler world: package snapshot cid mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerWorldOwnPackageSnapshot(snapshot: CompilerPackageSnapshot): CompilerPackageSnapshot =
    var out: CompilerPackageSnapshot
    out.packageId = CompilerWorldOwnText(snapshot.packageId)
    out.channel = CompilerWorldOwnText(snapshot.channel)
    out.sourceBundleCid = snapshot.sourceBundleCid
    out.csgRootCid = snapshot.csgRootCid
    out.exportSurfaceCid = snapshot.exportSurfaceCid
    out.syntaxSurfaceCid = snapshot.syntaxSurfaceCid
    out.depsManifestCid = snapshot.depsManifestCid
    out.migrationProofCid = snapshot.migrationProofCid
    out.signature = CompilerWorldOwnText(snapshot.signature)
    out.snapshotCid = snapshot.snapshotCid
    return out

@borrows
fn CompilerWorldOwnUniverseManifest(manifest: CompilerUniverseManifest): CompilerUniverseManifest =
    var out: CompilerUniverseManifest
    out.channel = CompilerWorldOwnText(manifest.channel)
    out.entryCount = manifest.entryCount
    out.managedDependencyReceiptCid =
        manifest.managedDependencyReceiptCid
    out.entries = CompilerWorldOwnManifestEntries(manifest.entries)
    out.manifestCid = manifest.manifestCid
    return out

@borrows
fn CompilerWorldOwnWorldHead(head: CompilerWorldHead): CompilerWorldHead =
    var out: CompilerWorldHead
    out.universeId = CompilerWorldOwnText(head.universeId)
    out.channel = CompilerWorldOwnText(head.channel)
    out.headEpoch = head.headEpoch
    out.prevHeadCid = head.prevHeadCid
    out.manifestRootCid = head.manifestRootCid
    out.csgRootCid = head.csgRootCid
    out.compilerPkgCid = head.compilerPkgCid
    out.stdPkgCid = head.stdPkgCid
    out.runtimePkgCid = head.runtimePkgCid
    out.signature = CompilerWorldOwnText(head.signature)
    out.headCid = head.headCid
    return out

@borrows
fn CompilerWorldOwnLocalUniverse(universe: CompilerLocalUniverse): CompilerLocalUniverse =
    var out: CompilerLocalUniverse
    out.compilerSnapshot = CompilerWorldOwnPackageSnapshot(universe.compilerSnapshot)
    out.stdSnapshot = CompilerWorldOwnPackageSnapshot(universe.stdSnapshot)
    out.runtimeSnapshot = CompilerWorldOwnPackageSnapshot(universe.runtimeSnapshot)
    out.manifest = CompilerWorldOwnUniverseManifest(universe.manifest)
    out.worldHead = CompilerWorldOwnWorldHead(universe.worldHead)
    return out

fn compilerLocalUniverseManifestEntriesCapacity(
        entries: var CompilerUniverseManifestEntry[]): int32 =
    return entries.cap

fn CompilerLocalUniverseRetainedBufferCount(
        universe: var CompilerLocalUniverse): int32 =
    if compilerLocalUniverseManifestEntriesCapacity(
           universe.manifest.entries) > 0:
        return 1
    return 0

fn CompilerLocalUniverseRetainedBytes(
        universe: var CompilerLocalUniverse): int64 =
    var retainedBytes =
        int64(universe.compilerSnapshot.packageId.len) +
        int64(universe.compilerSnapshot.channel.len) +
        int64(universe.compilerSnapshot.signature.len) +
        int64(universe.stdSnapshot.packageId.len) +
        int64(universe.stdSnapshot.channel.len) +
        int64(universe.stdSnapshot.signature.len) +
        int64(universe.runtimeSnapshot.packageId.len) +
        int64(universe.runtimeSnapshot.channel.len) +
        int64(universe.runtimeSnapshot.signature.len) +
        int64(universe.manifest.channel.len) +
        int64(compilerLocalUniverseManifestEntriesCapacity(
            universe.manifest.entries)) *
            int64(sizeof(CompilerUniverseManifestEntry)) +
        int64(universe.worldHead.universeId.len) +
        int64(universe.worldHead.channel.len) +
        int64(universe.worldHead.signature.len)
    for entryIndex in 0..<universe.manifest.entries.len:
        retainedBytes =
            retainedBytes +
            int64(universe.manifest.entries[entryIndex].packageId.len)
    return retainedBytes

fn CompilerLocalUniverseStorageReleased(
        universe: var CompilerLocalUniverse): bool =
    return universe.compilerSnapshot.packageId == "" &&
           universe.compilerSnapshot.channel == "" &&
           universe.compilerSnapshot.signature == "" &&
           universe.stdSnapshot.packageId == "" &&
           universe.stdSnapshot.channel == "" &&
           universe.stdSnapshot.signature == "" &&
           universe.runtimeSnapshot.packageId == "" &&
           universe.runtimeSnapshot.channel == "" &&
           universe.runtimeSnapshot.signature == "" &&
           universe.manifest.channel == "" &&
           compilerLocalUniverseManifestEntriesCapacity(
               universe.manifest.entries) == 0 &&
           universe.worldHead.universeId == "" &&
           universe.worldHead.channel == "" &&
           universe.worldHead.signature == ""

fn CompilerLocalUniverseReleaseOwned(
        universe: var CompilerLocalUniverse) =
    universe.compilerSnapshot.packageId = ""
    universe.compilerSnapshot.channel = ""
    universe.compilerSnapshot.signature = ""
    universe.stdSnapshot.packageId = ""
    universe.stdSnapshot.channel = ""
    universe.stdSnapshot.signature = ""
    universe.runtimeSnapshot.packageId = ""
    universe.runtimeSnapshot.channel = ""
    universe.runtimeSnapshot.signature = ""
    universe.manifest.channel = ""
    for entryIndex in 0..<universe.manifest.entries.len:
        universe.manifest.entries[entryIndex].packageId = ""
    seqs.chengSeqFreeTyped(universe.manifest.entries)
    universe.worldHead.universeId = ""
    universe.worldHead.channel = ""
    universe.worldHead.signature = ""

@borrows
fn CompilerWorldHeadMake(channel: str,
                           headEpoch: int32,
                           prevHeadCid: layout.FixedBytes32,
                           manifest: CompilerUniverseManifest,
                           csgRootCid: layout.FixedBytes32,
                           compilerPkgCid: layout.FixedBytes32,
                           stdPkgCid: layout.FixedBytes32,
                           runtimePkgCid: layout.FixedBytes32,
                           signature: str): CompilerWorldHead =
    var manifestErr: str
    if !CompilerUniverseManifestStrictValidateInto(manifest,
                                                       manifestErr) ||
       manifest.channel != channel:
        if manifestErr == "":
            manifestErr = " compiler world: world head manifest mismatch"
        system.Panic(manifestErr)
    let universeId = CompilerWorldOwnText(CompilerWorldUniverseId())
    let channelOwned = CompilerWorldOwnText(channel)
    let signatureOwned = CompilerWorldOwnText(signature)
    let manifestRootCid = CompilerWorldManifestRootCid(manifest)
    var out: CompilerWorldHead
    out.universeId = share(universeId)
    out.channel = share(channelOwned)
    out.headEpoch = headEpoch
    out.prevHeadCid = prevHeadCid
    out.manifestRootCid = manifestRootCid
    out.csgRootCid = csgRootCid
    out.compilerPkgCid = compilerPkgCid
    out.stdPkgCid = stdPkgCid
    out.runtimePkgCid = runtimePkgCid
    out.signature = share(signatureOwned)
    out.headCid = CompilerWorldHashHead(universeId,
                                        channelOwned,
                                        headEpoch,
                                        prevHeadCid,
                                        manifestRootCid,
                                        csgRootCid,
                                        compilerPkgCid,
                                        stdPkgCid,
                                        runtimePkgCid,
                                        signatureOwned)
    var headErr: str
    if !CompilerWorldHeadStrictValidateInto(out, headErr):
        system.Panic(headErr)
    return out

@borrows
fn CompilerWorldHeadStrictValidateInto(head: CompilerWorldHead,
                                         err: var str): bool =
    let channelRes = CompilerWorldNormalizeChannel(head.channel)
    if head.universeId != CompilerWorldUniverseId() ||
       IsErr(channelRes) || Value(channelRes) != head.channel ||
       head.headEpoch <= 0 || head.signature == "":
        err = " compiler world: world head identity invalid"
        return false
    let zero = layout.FixedBytes32()
    let previousMissing = layout.FixedBytes32Equal(head.prevHeadCid, zero)
    if (head.headEpoch == 1) != previousMissing:
        err = " compiler world: world head epoch/previous-head binding invalid"
        return false
    if layout.FixedBytes32Equal(head.manifestRootCid, zero) ||
       layout.FixedBytes32Equal(head.csgRootCid, zero) ||
       layout.FixedBytes32Equal(head.compilerPkgCid, zero) ||
       layout.FixedBytes32Equal(head.stdPkgCid, zero) ||
       layout.FixedBytes32Equal(head.runtimePkgCid, zero) ||
       layout.FixedBytes32Equal(head.headCid, zero):
        err = " compiler world: world head contains zero identity cid"
        return false
    let expectedCid = CompilerWorldHashHead(head.universeId,
                                            head.channel,
                                            head.headEpoch,
                                            head.prevHeadCid,
                                            head.manifestRootCid,
                                            head.csgRootCid,
                                            head.compilerPkgCid,
                                            head.stdPkgCid,
                                            head.runtimePkgCid,
                                            head.signature)
    if !layout.FixedBytes32Equal(head.headCid, expectedCid):
        err = " compiler world: world head cid mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(out: var CompilerLocalUniverse,
                                                               outErr: var str,
                                                               channelRaw: str,
                                                               sourceBundleCid: layout.FixedBytes32,
                                                               csgRootCid: layout.FixedBytes32,
                                                               exportSurfaceCid: layout.FixedBytes32,
                                                               compilerMigrationProofCid: layout.FixedBytes32,
                                                               extraManifestEntries: var CompilerUniverseManifestEntry[]): bool =
    return CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
        out,
        outErr,
        channelRaw,
        sourceBundleCid,
        csgRootCid,
        exportSurfaceCid,
        compilerMigrationProofCid,
        layout.FixedBytes32(),
        extraManifestEntries)

@borrows
fn CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
        out: var CompilerLocalUniverse,
        outErr: var str,
        channelRaw: str,
        sourceBundleCid: layout.FixedBytes32,
        csgRootCid: layout.FixedBytes32,
        exportSurfaceCid: layout.FixedBytes32,
        compilerMigrationProofCid: layout.FixedBytes32,
        managedDependencyReceiptCid: layout.FixedBytes32,
        extraManifestEntries: var CompilerUniverseManifestEntry[]): bool =
    outErr = ""
    CompilerWorldTraceLine("world_into_enter")
    let channelRes = CompilerWorldNormalizeChannel(channelRaw)
    if IsErr(channelRes):
        outErr = Error(channelRes)
        return false
    let channel = CompilerWorldOwnText(Value(channelRes))
    let zeroCid = layout.FixedBytes32()
    if layout.FixedBytes32Equal(sourceBundleCid, zeroCid) ||
       layout.FixedBytes32Equal(csgRootCid, zeroCid) ||
       layout.FixedBytes32Equal(exportSurfaceCid, zeroCid):
        outErr = " compiler world: universe build identity cid missing"
        return false
    var compilerManagedMirrorBundleCid: layout.FixedBytes32
    var compilerManifestInputCount: int32
    for i in 0..<extraManifestEntries.len:
        if extraManifestEntries[i].packageId != "cheng/compiler":
            continue
        compilerManifestInputCount = compilerManifestInputCount + 1
        if compilerManifestInputCount != 1 ||
           !layout.FixedBytes32Equal(
               extraManifestEntries[i].migrationProofCid,
               compilerMigrationProofCid):
            outErr = " compiler world: compiler proof/mirror input mismatch"
            return false
        compilerManagedMirrorBundleCid =
            extraManifestEntries[i].managedMirrorBundleCid
    if channel == "stable" &&
       layout.FixedBytes32Equal(compilerMigrationProofCid, zeroCid) !=
       layout.FixedBytes32Equal(compilerManagedMirrorBundleCid, zeroCid):
        outErr = " compiler world: stable compiler proof/mirror pair incomplete"
        return false
    CompilerWorldTraceLine("world_into_after_channel")
    var compilerSyntaxCid: layout.FixedBytes32
    CompilerWorldDefaultSyntaxSurfaceCidInto("cheng/compiler", channel, exportSurfaceCid, compilerSyntaxCid)
    CompilerWorldTraceLine("world_into_after_compiler_syntax")
    var stdSyntaxCid: layout.FixedBytes32
    CompilerWorldDefaultSyntaxSurfaceCidInto("cheng/std", channel, exportSurfaceCid, stdSyntaxCid)
    CompilerWorldTraceLine("world_into_after_std_syntax")
    var runtimeSyntaxCid: layout.FixedBytes32
    CompilerWorldDefaultSyntaxSurfaceCidInto("cheng/runtime", channel, exportSurfaceCid, runtimeSyntaxCid)
    CompilerWorldTraceLine("world_into_after_runtime_syntax")
    var emptyDepsManifestCid: layout.FixedBytes32
    CompilerWorldEmptyManifestCidInto(channel, emptyDepsManifestCid)
    CompilerWorldTraceLine("world_into_after_empty_manifest")
    let stdSnapshot = CompilerPackageSnapshotMake("cheng/std",
                                                    channel,
                                                    layout.FixedBytes32Copy(sourceBundleCid),
                                                    layout.FixedBytes32Copy(csgRootCid),
                                                    layout.FixedBytes32Copy(exportSurfaceCid),
                                                    stdSyntaxCid,
                                                    emptyDepsManifestCid,
                                                    layout.FixedBytes32(),
                                                    "local:std")
    let runtimeSnapshot = CompilerPackageSnapshotMake("cheng/runtime",
                                                        channel,
                                                        layout.FixedBytes32Copy(sourceBundleCid),
                                                        layout.FixedBytes32Copy(csgRootCid),
                                                        layout.FixedBytes32Copy(exportSurfaceCid),
                                                        runtimeSyntaxCid,
                                                        emptyDepsManifestCid,
                                                        layout.FixedBytes32(),
                                                        "local:runtime")
    CompilerWorldTraceLine("world_into_after_builtin_snapshots")
    var compilerDepsEntries: CompilerUniverseManifestEntry[]
    var stdDepEntry: CompilerUniverseManifestEntry
    CompilerUniverseManifestEntryMakeInto(
        CompilerWorldOwnText(stdSnapshot.packageId),
        layout.FixedBytes32Copy(stdSnapshot.snapshotCid),
        layout.FixedBytes32Copy(stdSnapshot.syntaxSurfaceCid),
        layout.FixedBytes32Copy(stdSnapshot.migrationProofCid),
        stdDepEntry)
    CompilerWorldManifestEntryAppendOrReplace(compilerDepsEntries, stdDepEntry)
    var runtimeDepEntry: CompilerUniverseManifestEntry
    CompilerUniverseManifestEntryMakeInto(
        CompilerWorldOwnText(runtimeSnapshot.packageId),
        layout.FixedBytes32Copy(runtimeSnapshot.snapshotCid),
        layout.FixedBytes32Copy(runtimeSnapshot.syntaxSurfaceCid),
        layout.FixedBytes32Copy(runtimeSnapshot.migrationProofCid),
        runtimeDepEntry)
    CompilerWorldManifestEntryAppendOrReplace(compilerDepsEntries, runtimeDepEntry)
    for i in 0..<extraManifestEntries.len:
        let entry = extraManifestEntries[i]
        if entry.packageId == "cheng/compiler":
            continue
        if entry.packageId == "cheng/std":
            continue
        if entry.packageId == "cheng/runtime":
            continue
        CompilerWorldManifestEntryAppendOrReplace(compilerDepsEntries, entry)
    let compilerDepsManifestCid = CompilerWorldDepsManifestCid(channel,
                                                                 compilerDepsEntries)
    let compilerSnapshot = CompilerPackageSnapshotMake("cheng/compiler",
                                                         channel,
                                                         layout.FixedBytes32Copy(sourceBundleCid),
                                                         layout.FixedBytes32Copy(csgRootCid),
                                                         layout.FixedBytes32Copy(exportSurfaceCid),
                                                         compilerSyntaxCid,
                                                         compilerDepsManifestCid,
                                                         layout.FixedBytes32Copy(compilerMigrationProofCid),
                                                         "local:compiler")
    CompilerWorldTraceLine("world_into_after_compiler_snapshot")
    var manifestEntries: CompilerUniverseManifestEntry[]
    CompilerWorldTraceLine("world_into_before_compiler_entry")
    var compilerEntry: CompilerUniverseManifestEntry
    CompilerUniverseManifestEntryMakeInto(
        CompilerWorldOwnText(compilerSnapshot.packageId),
        layout.FixedBytes32Copy(compilerSnapshot.snapshotCid),
        layout.FixedBytes32Copy(compilerSnapshot.syntaxSurfaceCid),
        layout.FixedBytes32Copy(compilerSnapshot.migrationProofCid),
        compilerManagedMirrorBundleCid,
        compilerEntry)
    CompilerWorldTraceLine("world_into_after_compiler_entry")
    CompilerWorldManifestEntryAppendOrReplace(manifestEntries, compilerEntry)
    CompilerWorldTraceLine("world_into_after_compiler_entry_append")
    var stdEntry: CompilerUniverseManifestEntry
    CompilerUniverseManifestEntryMakeInto(
        CompilerWorldOwnText(stdSnapshot.packageId),
        layout.FixedBytes32Copy(stdSnapshot.snapshotCid),
        layout.FixedBytes32Copy(stdSnapshot.syntaxSurfaceCid),
        layout.FixedBytes32Copy(stdSnapshot.migrationProofCid),
        stdEntry)
    CompilerWorldTraceLine("world_into_after_std_entry")
    CompilerWorldManifestEntryAppendOrReplace(manifestEntries, stdEntry)
    CompilerWorldTraceLine("world_into_after_std_entry_append")
    var runtimeEntry: CompilerUniverseManifestEntry
    CompilerUniverseManifestEntryMakeInto(
        CompilerWorldOwnText(runtimeSnapshot.packageId),
        layout.FixedBytes32Copy(runtimeSnapshot.snapshotCid),
        layout.FixedBytes32Copy(runtimeSnapshot.syntaxSurfaceCid),
        layout.FixedBytes32Copy(runtimeSnapshot.migrationProofCid),
        runtimeEntry)
    CompilerWorldTraceLine("world_into_after_runtime_entry")
    CompilerWorldManifestEntryAppendOrReplace(manifestEntries, runtimeEntry)
    CompilerWorldTraceLine("world_into_after_runtime_entry_append")
    for i in 0..<extraManifestEntries.len:
        let entry = extraManifestEntries[i]
        if entry.packageId == "cheng/compiler":
            continue
        if entry.packageId == "cheng/std":
            continue
        if entry.packageId == "cheng/runtime":
            continue
        CompilerWorldManifestEntryAppendOrReplace(manifestEntries, entry)
    var manifest: CompilerUniverseManifest
    var manifestErr: str
    let manifestOk = CompilerUniverseManifestMakeInto(
        channel,
        manifestEntries,
        managedDependencyReceiptCid,
        manifest,
        manifestErr)
    CompilerWorldTraceLine("world_into_after_manifest_call")
    if !manifestOk:
        outErr = manifestErr
        return false
    CompilerWorldTraceLine("world_into_after_manifest_value")
    let worldHead = CompilerWorldHeadMake(channel,
                                            1,
                                            layout.FixedBytes32(),
                                            manifest,
                                            csgRootCid,
                                            compilerSnapshot.snapshotCid,
                                            stdSnapshot.snapshotCid,
                                            runtimeSnapshot.snapshotCid,
                                            "local:world_head")
    CompilerWorldTraceLine("world_into_after_world_head")
    var ownedUniverse: CompilerLocalUniverse
    ownedUniverse.compilerSnapshot = compilerSnapshot
    ownedUniverse.stdSnapshot = stdSnapshot
    ownedUniverse.runtimeSnapshot = runtimeSnapshot
    ownedUniverse.manifest = manifest
    ownedUniverse.worldHead = worldHead
    out = CompilerWorldOwnLocalUniverse(ownedUniverse)
    if !CompilerLocalUniverseStrictValidateInto(out, outErr):
        return false
    CompilerWorldTraceLine("world_into_done")
    return true

fn CompilerLocalUniverseBuildForChannelWithManifestEntries(channelRaw: str,
                                                             sourceBundleCid: layout.FixedBytes32,
                                                             csgRootCid: layout.FixedBytes32,
                                                             exportSurfaceCid: layout.FixedBytes32,
                                                             compilerMigrationProofCid: layout.FixedBytes32,
                                                             extraManifestEntries: var CompilerUniverseManifestEntry[]): Result[CompilerLocalUniverse] =
    var out: CompilerLocalUniverse
    var err: str
    if !CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(out,
                                                                    err,
                                                                    channelRaw,
                                                                    sourceBundleCid,
                                                                    csgRootCid,
                                                                    exportSurfaceCid,
                                                                    compilerMigrationProofCid,
                                                                    extraManifestEntries):
        return Err[CompilerLocalUniverse](err)
    return Ok[CompilerLocalUniverse](out)

fn CompilerLocalUniverseBuildForChannelWithManifestEntries(
        channelRaw: str,
        sourceBundleCid: layout.FixedBytes32,
        csgRootCid: layout.FixedBytes32,
        exportSurfaceCid: layout.FixedBytes32,
        compilerMigrationProofCid: layout.FixedBytes32,
        managedDependencyReceiptCid: layout.FixedBytes32,
        extraManifestEntries: var CompilerUniverseManifestEntry[]): Result[CompilerLocalUniverse] =
    var out: CompilerLocalUniverse
    var err: str
    if !CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
            out,
            err,
            channelRaw,
            sourceBundleCid,
            csgRootCid,
            exportSurfaceCid,
            compilerMigrationProofCid,
            managedDependencyReceiptCid,
            extraManifestEntries):
        return Err[CompilerLocalUniverse](err)
    return Ok[CompilerLocalUniverse](out)

fn CompilerLocalUniverseBuildForChannel(channelRaw: str,
                                          sourceBundleCid: layout.FixedBytes32,
                                          csgRootCid: layout.FixedBytes32,
                                          exportSurfaceCid: layout.FixedBytes32,
                                          compilerMigrationProofCid: layout.FixedBytes32): Result[CompilerLocalUniverse] =
    var extraManifestEntries: CompilerUniverseManifestEntry[]
    return CompilerLocalUniverseBuildForChannelWithManifestEntries(channelRaw,
                                                                     sourceBundleCid,
                                                                     csgRootCid,
                                                                     exportSurfaceCid,
                                                                     compilerMigrationProofCid,
                                                                     extraManifestEntries)

fn CompilerLocalUniverseBuild(sourceBundleCid: layout.FixedBytes32,
                                csgRootCid: layout.FixedBytes32,
                                exportSurfaceCid: layout.FixedBytes32): CompilerLocalUniverse =
    let universeRes = CompilerLocalUniverseBuildForChannel(CompilerWorldDefaultChannel(),
                                                             sourceBundleCid,
                                                             csgRootCid,
                                                             exportSurfaceCid,
                                                             layout.FixedBytes32())
    return Value(universeRes)

@borrows
fn CompilerWorldQuotedValue(text: str): str =
    let value = strutil.Strip(text)
    if value.len < 2:
        return value
    return chengpath.TextSlice(value, 1, value.len - 2)

@borrows
fn CompilerWorldLineValue(text: str, key: str): str =
    let lines = strutil.Split(share(text), '\n')
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        var plainMatch = false
        if line.len > key.len:
            if line[key.len] == '=':
                plainMatch = true
        if plainMatch:
            for j in 0..<key.len:
                if line[j] != key[j]:
                    plainMatch = false
                    break
        if plainMatch:
            let rawValue = chengpath.TextSlice(line, key.len + 1, line.len - (key.len + 1))
            return strutil.Strip(rawValue)
        var quotedMatch = false
        if line.len > key.len + 2:
            if line[key.len] == ' ':
                if line[key.len + 1] == '=':
                    if line[key.len + 2] == ' ':
                        quotedMatch = true
        if quotedMatch:
            for j in 0..<key.len:
                if line[j] != key[j]:
                    quotedMatch = false
                    break
        if quotedMatch:
            let rawValue = chengpath.TextSlice(line, key.len + 3, line.len - (key.len + 3))
            return CompilerWorldQuotedValue(rawValue)
    return ""

@borrows
fn CompilerWorldFixed32Value(text: str, key: str): Result[layout.FixedBytes32] =
    let value = CompilerWorldLineValue(text, key)
    if value.len <= 0:
        return Err[layout.FixedBytes32](strutil.Join([" compiler world: missing key: ", share(key)], ""))
    let valueRes = layout.FixedBytes32FromHex(value)
    if IsErr(valueRes):
        return Err[layout.FixedBytes32](strutil.Join([" compiler world: invalid fixed32 for key: ", share(key)], ""))
    return Ok[layout.FixedBytes32](Value(valueRes))

@borrows
fn CompilerWorldInt32Value(text: str, key: str): Result[int32] =
    let value = CompilerWorldLineValue(text, key)
    if value.len <= 0:
        return Err[int32](strutil.Join(
            [" compiler world: missing key: ", strings.CloneStr(key)],
            ""))
    return Ok[int32](parseInt(value))

@borrows
fn CompilerWorldSourceRawBytesCidFromBytes(
        sourceBytes: Bytes): layout.FixedBytes32 =
    return CompilerWorldSourceRawBytesCidFromSpan(
        layout.ByteSpanFromBytes(sourceBytes))

@borrows
fn CompilerManagedMirrorBundleHexEncode(text: str): str =
    let bytes = rawbytes.BytesFromString(text)
    return rawbytes.BytesToHex(bytes)

fn CompilerManagedMirrorBundleHexValue(ch: uint8): int32 =
    if ch >= uint8('0') && ch <= uint8('9'):
        return int32(ch) - int32('0')
    if ch >= uint8('a') && ch <= uint8('f'):
        return 10 + int32(ch) - int32('a')
    return -1

@borrows
fn CompilerManagedMirrorBundleHexDecodeInto(
        text: str,
        out: var str): Result[bool] =
    out = ""
    if text == "":
        return Ok[bool](true)
    if text.len % 2 != 0:
        return Err[bool](
            " compiler world: managed mirror hex length invalid")
    var bytes = rawbytes.BytesAlloc(text.len / 2)
    var index: int32
    while index < text.len:
        let high = CompilerManagedMirrorBundleHexValue(uint8(text[index]))
        let low = CompilerManagedMirrorBundleHexValue(
            uint8(text[index + 1]))
        if high < 0 || low < 0:
            rawbytes.BytesFree(bytes)
            return Err[bool](
                " compiler world: managed mirror hex payload invalid")
        rawbytes.BytesSet(bytes, index / 2, high * 16 + low)
        index = index + 2
    out = CompilerWorldOwnText(rawbytes.BytesToString(bytes))
    rawbytes.BytesFree(bytes)
    return Ok[bool](true)

@borrows
fn CompilerManagedMirrorBundleInt32ValueInto(
        text: str,
        key: str,
        out: var int32): bool =
    let valueText = CompilerWorldLineValue(text, key)
    if valueText == "":
        return false
    let value = int32(parseInt(valueText))
    if IntToStr(value) != valueText:
        return false
    out = value
    return true

@borrows
fn CompilerManagedMirrorBundleWireCid(
        bundle: CompilerManagedMirrorBundleWire): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(512)
    CompilerWorldAppendText(buf, "cheng.compiler.managed_mirror_bundle")
    CompilerWorldAppendText(buf, bundle.channel)
    CompilerWorldAppendText(buf, bundle.packageId)
    CompilerWorldAppendFixed32Field(buf, bundle.migrationProofCid)
    CompilerWorldAppendFixed32Field(
        buf,
        bundle.legacySourceIdentityReceiptCid)
    CompilerWorldAppendFixed32Field(
        buf,
        bundle.migratedSourceIdentityReceiptCid)
    CompilerWorldAppendFixed32Field(buf, bundle.compileSemanticReceiptCid)
    CompilerWorldAppendU32Field(buf, bundle.unitCount)
    for unitIndex in 0..<bundle.units.len:
        CompilerWorldAppendText(buf, bundle.units[unitIndex].modulePath)
        CompilerWorldAppendU32Field(
            buf,
            bundle.units[unitIndex].legacySourceRawByteLength)
        CompilerWorldAppendFixed32Field(
            buf,
            bundle.units[unitIndex].legacySourceCid)
        CompilerWorldAppendU32Field(
            buf,
            bundle.units[unitIndex].migratedSourceRawByteLength)
        CompilerWorldAppendFixed32Field(
            buf,
            bundle.units[unitIndex].migratedSourceCid)
    CompilerWorldAppendText(buf, bundle.baselineCsgText)
    CompilerWorldAppendText(buf, bundle.migratedCsgText)
    CompilerWorldAppendText(buf, bundle.baselineSurfaceText)
    CompilerWorldAppendText(buf, bundle.migratedSurfaceText)
    CompilerWorldAppendText(buf, bundle.baselineSemanticReceiptText)
    CompilerWorldAppendText(buf, bundle.migratedSemanticReceiptText)
    CompilerWorldAppendText(buf, bundle.evidenceText)
    CompilerWorldAppendText(buf, bundle.proofText)
    return CompilerWorldBufCid(buf)

@borrows
fn CompilerManagedMirrorBundleModuleOwnedByPackage(
        modulePath: str,
        packageId: str): bool =
    if modulePath.len <= packageId.len ||
       modulePath[packageId.len] != '/':
        return false
    for index in 0..<packageId.len:
        if modulePath[index] != packageId[index]:
            return false
    return true

@borrows
fn CompilerManagedMirrorBundleWireVerify(
        bundle: CompilerManagedMirrorBundleWire): Result[bool] =
    let channelRes = CompilerWorldNormalizeChannel(bundle.channel)
    if IsErr(channelRes) || Value(channelRes) != bundle.channel:
        return Err[bool](
            " compiler world: managed mirror channel is not canonical")
    if parser.ParserManifestNormalizePackageId(bundle.packageId) !=
           bundle.packageId ||
       !parser.ParserSourceIdentityModuleTextValid(bundle.packageId):
        return Err[bool](
            " compiler world: managed mirror package is not canonical")
    if bundle.unitCount <= 0 || bundle.unitCount > 262144 ||
       bundle.unitCount != bundle.units.len:
        return Err[bool](
            " compiler world: managed mirror unit count invalid")
    let zeroCid = layout.FixedBytes32()
    if layout.FixedBytes32Equal(bundle.migrationProofCid, zeroCid) ||
       layout.FixedBytes32Equal(
            bundle.legacySourceIdentityReceiptCid,
            zeroCid) ||
       layout.FixedBytes32Equal(
            bundle.migratedSourceIdentityReceiptCid,
            zeroCid) ||
       layout.FixedBytes32Equal(bundle.compileSemanticReceiptCid, zeroCid) ||
       bundle.baselineCsgText == "" || bundle.migratedCsgText == "" ||
       bundle.baselineSurfaceText == "" ||
       bundle.migratedSurfaceText == "" ||
       bundle.baselineSemanticReceiptText == "" ||
       bundle.migratedSemanticReceiptText == "" ||
       bundle.evidenceText == "" || bundle.proofText == "":
        return Err[bool](
            " compiler world: managed mirror predecessor chain missing")
    for unitIndex in 0..<bundle.units.len:
        let unit = bundle.units[unitIndex]
        if !parser.ParserSourceIdentityModuleTextValid(unit.modulePath) ||
           !CompilerManagedMirrorBundleModuleOwnedByPackage(
                unit.modulePath,
                bundle.packageId) ||
           (unitIndex > 0 &&
            !CompilerWorldStrLess(
                bundle.units[unitIndex - 1].modulePath,
                unit.modulePath)) ||
           unit.legacySourceRawByteLength != unit.legacySourceText.len ||
           unit.migratedSourceRawByteLength != unit.migratedSourceText.len ||
           !layout.FixedBytes32Equal(
                unit.legacySourceCid,
                CompilerWorldSourceRawBytesCid(unit.legacySourceText)) ||
           !layout.FixedBytes32Equal(
                unit.migratedSourceCid,
                CompilerWorldSourceRawBytesCid(unit.migratedSourceText)):
            return Err[bool](
                " compiler world: managed mirror source manifest invalid")
    if !layout.FixedBytes32Equal(
            bundle.bundleCid,
            CompilerManagedMirrorBundleWireCid(bundle)):
        return Err[bool](
            " compiler world: managed mirror bundle cid mismatch")
    return Ok[bool](true)

@borrows
fn CompilerManagedMirrorBundleWireReport(
        bundle: CompilerManagedMirrorBundleWire): str =
    var out = strutil.Join([
        "channel=", strings.CloneStr(bundle.channel),
        "\npackage_id=", strings.CloneStr(bundle.packageId),
        "\nmigration_proof_cid=",
        layout.FixedBytes32Hex(bundle.migrationProofCid),
        "\nlegacy_source_identity_receipt_cid=",
        layout.FixedBytes32Hex(bundle.legacySourceIdentityReceiptCid),
        "\nmigrated_source_identity_receipt_cid=",
        layout.FixedBytes32Hex(bundle.migratedSourceIdentityReceiptCid),
        "\ncompile_semantic_receipt_cid=",
        layout.FixedBytes32Hex(bundle.compileSemanticReceiptCid),
        "\nunit_count=", IntToStr(bundle.unitCount)
    ], "")
    for unitIndex in 0..<bundle.units.len:
        let indexText = IntToStr(unitIndex)
        let unit = bundle.units[unitIndex]
        out = strutil.Join([
            strings.CloneStr(out),
            "\nunit[", strings.CloneStr(indexText), "].module_path=",
            strings.CloneStr(unit.modulePath),
            "\nunit[", strings.CloneStr(indexText),
            "].legacy_source_raw_byte_length=",
            IntToStr(unit.legacySourceRawByteLength),
            "\nunit[", strings.CloneStr(indexText), "].legacy_source_cid=",
            layout.FixedBytes32Hex(unit.legacySourceCid),
            "\nunit[", strings.CloneStr(indexText),
            "].legacy_source_text_hex=",
            CompilerManagedMirrorBundleHexEncode(unit.legacySourceText),
            "\nunit[", strings.CloneStr(indexText),
            "].migrated_source_raw_byte_length=",
            IntToStr(unit.migratedSourceRawByteLength),
            "\nunit[", strings.CloneStr(indexText), "].migrated_source_cid=",
            layout.FixedBytes32Hex(unit.migratedSourceCid),
            "\nunit[", strings.CloneStr(indexText),
            "].migrated_source_text_hex=",
            CompilerManagedMirrorBundleHexEncode(unit.migratedSourceText)
        ], "")
    out = strutil.Join([
        strings.CloneStr(out),
        "\nbaseline_csg_text_hex=",
        CompilerManagedMirrorBundleHexEncode(bundle.baselineCsgText),
        "\nmigrated_csg_text_hex=",
        CompilerManagedMirrorBundleHexEncode(bundle.migratedCsgText),
        "\nbaseline_surface_text_hex=",
        CompilerManagedMirrorBundleHexEncode(bundle.baselineSurfaceText),
        "\nmigrated_surface_text_hex=",
        CompilerManagedMirrorBundleHexEncode(bundle.migratedSurfaceText),
        "\nbaseline_semantic_receipt_text_hex=",
        CompilerManagedMirrorBundleHexEncode(
            bundle.baselineSemanticReceiptText),
        "\nmigrated_semantic_receipt_text_hex=",
        CompilerManagedMirrorBundleHexEncode(
            bundle.migratedSemanticReceiptText),
        "\nevidence_text_hex=",
        CompilerManagedMirrorBundleHexEncode(bundle.evidenceText),
        "\nproof_text_hex=",
        CompilerManagedMirrorBundleHexEncode(bundle.proofText),
        "\nbundle_cid=", layout.FixedBytes32Hex(bundle.bundleCid)
    ], "")
    return out

@borrows
fn CompilerManagedMirrorBundleWireFromReportText(
        text: str,
        out: var CompilerManagedMirrorBundleWire): Result[bool] =
    let channelRes = CompilerWorldNormalizeChannel(
        CompilerWorldLineValue(text, "channel"))
    let proofRes = CompilerWorldFixed32Value(text, "migration_proof_cid")
    let legacyReceiptRes = CompilerWorldFixed32Value(
        text,
        "legacy_source_identity_receipt_cid")
    let migratedReceiptRes = CompilerWorldFixed32Value(
        text,
        "migrated_source_identity_receipt_cid")
    let semanticReceiptRes = CompilerWorldFixed32Value(
        text,
        "compile_semantic_receipt_cid")
    let bundleCidRes = CompilerWorldFixed32Value(text, "bundle_cid")
    if IsErr(channelRes) || IsErr(proofRes) ||
       IsErr(legacyReceiptRes) || IsErr(migratedReceiptRes) ||
       IsErr(semanticReceiptRes) || IsErr(bundleCidRes):
        return Err[bool](
            " compiler world: managed mirror fixed identity invalid")
    var unitCount: int32
    if !CompilerManagedMirrorBundleInt32ValueInto(
            text,
            "unit_count",
            unitCount) ||
       unitCount <= 0 || unitCount > 262144:
        return Err[bool](
            " compiler world: managed mirror unit count invalid")
    var units: CompilerManagedMirrorBundleWireUnit[]
    for unitIndex in 0..<unitCount:
        let prefix = strutil.Join([
            "unit[",
            IntToStr(unitIndex),
            "]."
        ], "")
        var legacyLength: int32
        var migratedLength: int32
        if !CompilerManagedMirrorBundleInt32ValueInto(
                text,
                strutil.Join([strings.CloneStr(prefix),
                              "legacy_source_raw_byte_length"], ""),
                legacyLength) ||
           !CompilerManagedMirrorBundleInt32ValueInto(
                text,
                strutil.Join([strings.CloneStr(prefix),
                              "migrated_source_raw_byte_length"], ""),
                migratedLength) ||
           legacyLength < 0 || migratedLength < 0:
            return Err[bool](
                " compiler world: managed mirror source length invalid")
        let legacyCidRes = CompilerWorldFixed32Value(
            text,
            strutil.Join([strings.CloneStr(prefix), "legacy_source_cid"], ""))
        let migratedCidRes = CompilerWorldFixed32Value(
            text,
            strutil.Join([strings.CloneStr(prefix), "migrated_source_cid"], ""))
        if IsErr(legacyCidRes) || IsErr(migratedCidRes):
            return Err[bool](
                " compiler world: managed mirror source cid invalid")
        var legacyText: str
        var migratedText: str
        let legacyDecodeRes = CompilerManagedMirrorBundleHexDecodeInto(
            CompilerWorldLineValue(
                text,
                strutil.Join([strings.CloneStr(prefix),
                              "legacy_source_text_hex"], "")),
            legacyText)
        let migratedDecodeRes = CompilerManagedMirrorBundleHexDecodeInto(
            CompilerWorldLineValue(
                text,
                strutil.Join([strings.CloneStr(prefix),
                              "migrated_source_text_hex"], "")),
            migratedText)
        if IsErr(legacyDecodeRes) || IsErr(migratedDecodeRes):
            return Err[bool](
                " compiler world: managed mirror source text invalid")
        var unit: CompilerManagedMirrorBundleWireUnit
        unit.modulePath = CompilerWorldLineValue(
            text,
            strutil.Join([strings.CloneStr(prefix), "module_path"], ""))
        unit.legacySourceRawByteLength = legacyLength
        unit.legacySourceCid = Value(legacyCidRes)
        unit.legacySourceText = legacyText
        unit.migratedSourceRawByteLength = migratedLength
        unit.migratedSourceCid = Value(migratedCidRes)
        unit.migratedSourceText = migratedText
        add(units, unit)
    var baselineCsgText: str
    var migratedCsgText: str
    var baselineSurfaceText: str
    var migratedSurfaceText: str
    var baselineSemanticText: str
    var migratedSemanticText: str
    var evidenceText: str
    var proofText: str
    let baselineCsgRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(text, "baseline_csg_text_hex"),
        baselineCsgText)
    let migratedCsgRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(text, "migrated_csg_text_hex"),
        migratedCsgText)
    let baselineSurfaceRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(text, "baseline_surface_text_hex"),
        baselineSurfaceText)
    let migratedSurfaceRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(text, "migrated_surface_text_hex"),
        migratedSurfaceText)
    let baselineSemanticRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(
            text,
            "baseline_semantic_receipt_text_hex"),
        baselineSemanticText)
    let migratedSemanticRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(
            text,
            "migrated_semantic_receipt_text_hex"),
        migratedSemanticText)
    let evidenceRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(text, "evidence_text_hex"),
        evidenceText)
    let proofTextRes = CompilerManagedMirrorBundleHexDecodeInto(
        CompilerWorldLineValue(text, "proof_text_hex"),
        proofText)
    if IsErr(baselineCsgRes) || IsErr(migratedCsgRes) ||
       IsErr(baselineSurfaceRes) || IsErr(migratedSurfaceRes) ||
       IsErr(baselineSemanticRes) || IsErr(migratedSemanticRes) ||
       IsErr(evidenceRes) || IsErr(proofTextRes):
        return Err[bool](
            " compiler world: managed mirror predecessor text invalid")
    var next: CompilerManagedMirrorBundleWire
    next.channel = Value(channelRes)
    next.packageId = CompilerWorldLineValue(text, "package_id")
    next.migrationProofCid = Value(proofRes)
    next.legacySourceIdentityReceiptCid = Value(legacyReceiptRes)
    next.migratedSourceIdentityReceiptCid = Value(migratedReceiptRes)
    next.compileSemanticReceiptCid = Value(semanticReceiptRes)
    next.unitCount = unitCount
    next.units = units
    next.baselineCsgText = baselineCsgText
    next.migratedCsgText = migratedCsgText
    next.baselineSurfaceText = baselineSurfaceText
    next.migratedSurfaceText = migratedSurfaceText
    next.baselineSemanticReceiptText = baselineSemanticText
    next.migratedSemanticReceiptText = migratedSemanticText
    next.evidenceText = evidenceText
    next.proofText = proofText
    next.bundleCid = Value(bundleCidRes)
    let verifyRes = CompilerManagedMirrorBundleWireVerify(next)
    if IsErr(verifyRes):
        return Err[bool](Error(verifyRes))
    if text != CompilerManagedMirrorBundleWireReport(next):
        return Err[bool](
            " compiler world: managed mirror report is not canonical")
    out = next
    return Ok[bool](true)

@borrows
fn CompilerManagedMirrorSourceRelativePath(
        packageId: str,
        modulePath: str,
        out: var str): Result[bool] =
    out = ""
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var canonicalModulePath: str
    var absoluteSourcePath: str
    let canonicalRoot = "/cheng-managed-mirror-root"
    if !parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
            canonicalRoot,
            canonicalRoot,
            packageId,
            noExternalPackageRoots,
            modulePath,
            canonicalModulePath,
            absoluteSourcePath) ||
       canonicalModulePath != modulePath:
        return Err[bool](
            " compiler world: managed mirror module has no source path")
    let prefix = strutil.Join([canonicalRoot, "/"], "")
    if !chengpath.TextStartsWith(absoluteSourcePath, prefix) ||
       absoluteSourcePath.len <= prefix.len:
        return Err[bool](
            " compiler world: managed mirror source escaped root")
    let relativePath = chengpath.TextSlice(
        absoluteSourcePath,
        prefix.len,
        absoluteSourcePath.len - prefix.len)
    var canonicalRelativePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(
            relativePath,
            canonicalRelativePath) ||
       canonicalRelativePath != relativePath ||
       parser.ParserSourceIdentityPathAbsolute(relativePath):
        return Err[bool](
            " compiler world: managed mirror source path is not canonical")
    out = relativePath
    return Ok[bool](true)

@borrows
fn CompilerManagedMirrorCommitReport(
        commit: CompilerManagedMirrorCommit): str =
    var out = strutil.Join([
        "bundle_cid=",
        layout.FixedBytes32Hex(commit.bundleCid),
        "\nfile_count=",
        IntToStr(commit.fileCount)
    ], "")
    for fileIndex in 0..<commit.files.len:
        let prefix = strutil.Join([
            "\nfile[",
            IntToStr(fileIndex),
            "]."
        ], "")
        out = strutil.Join([
            strings.CloneStr(out),
            strings.CloneStr(prefix),
            "path=",
            strings.CloneStr(commit.files[fileIndex].relativePath),
            strings.CloneStr(prefix),
            "raw_byte_length=",
            IntToStr(commit.files[fileIndex].rawByteLength),
            strings.CloneStr(prefix),
            "content_cid=",
            layout.FixedBytes32Hex(commit.files[fileIndex].contentCid)
        ], "")
    return out

@borrows
fn CompilerManagedMirrorCommitFromText(
        text: str,
        expectedBundleCid: layout.FixedBytes32,
        out: var CompilerManagedMirrorCommit): Result[bool] =
    let zeroCid = layout.FixedBytes32()
    if layout.FixedBytes32Equal(expectedBundleCid, zeroCid):
        return Err[bool](
            " compiler world: managed mirror expected bundle cid missing")
    let bundleCidRes = CompilerWorldFixed32Value(text, "bundle_cid")
    if IsErr(bundleCidRes) ||
       !layout.FixedBytes32Equal(Value(bundleCidRes), expectedBundleCid):
        return Err[bool](
            " compiler world: managed mirror commit bundle cid mismatch")
    let fileCountText = CompilerWorldLineValue(text, "file_count")
    if fileCountText == "":
        return Err[bool](
            " compiler world: managed mirror commit file count missing")
    let fileCount = int32(strutil.ParseInt(fileCountText))
    if fileCount <= 0 || fileCount > 262144 ||
       IntToStr(fileCount) != fileCountText:
        return Err[bool](
            " compiler world: managed mirror commit file count invalid")
    var files: CompilerManagedMirrorCommitFile[]
    var bundleFilePresent = false
    for fileIndex in 0..<fileCount:
        let prefix = strutil.Join([
            "file[",
            IntToStr(fileIndex),
            "]."
        ], "")
        let relativePath = CompilerWorldLineValue(
            text,
            strutil.Join([strings.CloneStr(prefix), "path"], ""))
        var canonicalPath: str
        if relativePath == "" ||
           relativePath == ".cheng-mirror/commit.txt" ||
           !parser.ParserSourceIdentityLexicalPathInto(relativePath,
                                                        canonicalPath) ||
           canonicalPath != relativePath ||
           parser.ParserSourceIdentityPathAbsolute(relativePath):
            return Err[bool](
                " compiler world: managed mirror commit path invalid")
        for previousIndex in 0..<files.len:
            if files[previousIndex].relativePath == relativePath:
                return Err[bool](
                    " compiler world: managed mirror commit path duplicated")
        let lengthText = CompilerWorldLineValue(
            text,
            strutil.Join([strings.CloneStr(prefix), "raw_byte_length"], ""))
        if lengthText == "":
            return Err[bool](
                " compiler world: managed mirror commit length missing")
        let rawByteLength = int32(strutil.ParseInt(lengthText))
        if rawByteLength < 0 || IntToStr(rawByteLength) != lengthText:
            return Err[bool](
                " compiler world: managed mirror commit length invalid")
        let contentCidRes = CompilerWorldFixed32Value(
            text,
            strutil.Join([strings.CloneStr(prefix), "content_cid"], ""))
        if IsErr(contentCidRes) ||
           layout.FixedBytes32Equal(Value(contentCidRes), zeroCid):
            return Err[bool](
                " compiler world: managed mirror commit content cid invalid")
        var file: CompilerManagedMirrorCommitFile
        file.relativePath = CompilerWorldOwnText(relativePath)
        file.rawByteLength = rawByteLength
        file.contentCid = Value(contentCidRes)
        add(files, file)
        if relativePath == "bundle.txt":
            bundleFilePresent = true
    if !bundleFilePresent:
        return Err[bool](
            " compiler world: managed mirror commit bundle file missing")
    var commit: CompilerManagedMirrorCommit
    commit.bundleCid = expectedBundleCid
    commit.fileCount = fileCount
    commit.files = files
    if text != CompilerManagedMirrorCommitReport(commit):
        return Err[bool](
            " compiler world: managed mirror commit is not canonical")
    out = commit
    return Ok[bool](true)

@borrows
fn CompilerManagedMirrorCommitExpectedTree(
        commit: CompilerManagedMirrorCommit,
        outDirs: var str[],
        outFiles: var str[]): Result[bool] =
    var dirs: str[]
    var files: str[]
    for fileIndex in 0..<commit.files.len:
        let relativePath = strings.CloneStr(
            commit.files[fileIndex].relativePath)
        add(files, strings.CloneStr(relativePath))
        for charIndex in 0..<relativePath.len:
            if relativePath[charIndex] != '/':
                continue
            let dir = chengpath.TextSlice(relativePath, 0, charIndex)
            var present = false
            for dirIndex in 0..<dirs.len:
                if dirs[dirIndex] == dir:
                    present = true
                    break
            if !present:
                add(dirs, dir)
    var markerDirPresent = false
    for dirIndex in 0..<dirs.len:
        if dirs[dirIndex] == ".cheng-mirror":
            markerDirPresent = true
            break
    if !markerDirPresent:
        add(dirs, ".cheng-mirror")
    add(files, ".cheng-mirror/commit.txt")
    CompilerWorldSortPaths(dirs)
    CompilerWorldSortPaths(files)
    for dirIndex in 0..<dirs.len:
        for fileIndex in 0..<files.len:
            if dirs[dirIndex] == files[fileIndex]:
                return Err[bool](
                    " compiler world: managed mirror file/directory collision")
    outDirs = dirs
    outFiles = files
    return Ok[bool](true)

@borrows
fn CompilerManagedMirrorCommittedTreeVerifyInto(
        handle: os.AtomicTree,
        expectedBundleCid: layout.FixedBytes32,
        outCommit: var CompilerManagedMirrorCommit): Result[bool] =
    let commitReadRes = os.AtomicTreeReadStable(
        handle,
        ".cheng-mirror/commit.txt")
    if IsErr(commitReadRes):
        return Err[bool](Error(commitReadRes))
    var commitBytes = Value(commitReadRes)
    let commitText = CompilerWorldOwnText(
        rawbytes.BytesToString(commitBytes))
    rawbytes.BytesFree(commitBytes)
    var commit: CompilerManagedMirrorCommit
    let commitRes = CompilerManagedMirrorCommitFromText(
        commitText,
        expectedBundleCid,
        commit)
    if IsErr(commitRes):
        return Err[bool](Error(commitRes))
    var expectedDirs: str[]
    var expectedFiles: str[]
    let treeRes = CompilerManagedMirrorCommitExpectedTree(
        commit,
        expectedDirs,
        expectedFiles)
    if IsErr(treeRes):
        return Err[bool](Error(treeRes))
    let exactRes = os.AtomicTreeVerifyExact(handle,
                                            expectedDirs,
                                            expectedFiles)
    if IsErr(exactRes):
        return Err[bool](Error(exactRes))
    for fileIndex in 0..<commit.files.len:
        let readRes = os.AtomicTreeReadStable(
            handle,
            commit.files[fileIndex].relativePath)
        if IsErr(readRes):
            return Err[bool](Error(readRes))
        var fileBytes = Value(readRes)
        let actualLength = rawbytes.BytesLen(fileBytes)
        let actualCid = CompilerWorldSourceRawBytesCidFromBytes(fileBytes)
        rawbytes.BytesFree(fileBytes)
        if actualLength != commit.files[fileIndex].rawByteLength ||
           !layout.FixedBytes32Equal(
                actualCid,
                commit.files[fileIndex].contentCid):
            return Err[bool](strutil.Join([
                " compiler world: managed mirror committed file mismatch: ",
                strings.CloneStr(commit.files[fileIndex].relativePath)
            ], ""))
    outCommit = commit
    return Ok[bool](true)

@borrows
fn CompilerManagedMirrorCommittedTreeVerifyHandle(
        handle: os.AtomicTree,
        expectedBundleCid: layout.FixedBytes32): Result[bool] =
    var commit: CompilerManagedMirrorCommit
    return CompilerManagedMirrorCommittedTreeVerifyInto(handle,
                                                          expectedBundleCid,
                                                          commit)

@borrows
fn CompilerUniverseManifestReport(manifest: CompilerUniverseManifest): str =
    var manifestErr: str
    if !CompilerUniverseManifestStrictValidateInto(manifest,
                                                       manifestErr):
        system.Panic(manifestErr)
    var out = ""
    out = strutil.Join([strings.CloneStr(out), "channel=", strings.CloneStr(manifest.channel), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "entry_count=", IntToStr(manifest.entryCount), "\n"], "")
    out = strutil.Join(
        [strings.CloneStr(out),
         "managed_dependency_receipt_cid=",
         layout.FixedBytes32Hex(manifest.managedDependencyReceiptCid),
         "\n"],
        "")
    for i in 0..<manifest.entries.len:
        out = Fmt"{out}entry[{IntToStr(i)}].package_id={manifest.entries[i].packageId}\n"
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].snapshot_cid=", layout.FixedBytes32Hex(manifest.entries[i].snapshotCid), "\n"], "")
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].syntax_surface_cid=", layout.FixedBytes32Hex(manifest.entries[i].syntaxSurfaceCid), "\n"], "")
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].migration_proof_cid=", layout.FixedBytes32Hex(manifest.entries[i].migrationProofCid), "\n"], "")
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].managed_mirror_bundle_cid=", layout.FixedBytes32Hex(manifest.entries[i].managedMirrorBundleCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "manifest_cid=", layout.FixedBytes32Hex(manifest.manifestCid)], "")
    return out

@borrows
fn CompilerUniverseManifestFromReportText(text: str,
                                            out: var CompilerUniverseManifest): Result[bool] =
    let channelRes = CompilerWorldNormalizeChannel(CompilerWorldLineValue(text, "channel"))
    if IsErr(channelRes):
        return Err[bool](Error(channelRes))
    let entryCountRes = CompilerWorldInt32Value(text, "entry_count")
    if IsErr(entryCountRes):
        return Err[bool](Error(entryCountRes))
    let manifestCidRes = CompilerWorldFixed32Value(text, "manifest_cid")
    if IsErr(manifestCidRes):
        return Err[bool](Error(manifestCidRes))
    let dependencyReceiptRes = CompilerWorldFixed32Value(
        text,
        "managed_dependency_receipt_cid")
    if IsErr(dependencyReceiptRes):
        return Err[bool](Error(dependencyReceiptRes))
    let entryCount = Value(entryCountRes)
    if entryCount <= 0:
        return Err[bool](" compiler world: manifest entry_count invalid")
    var entries: CompilerUniverseManifestEntry[]
    for i in 0..<entryCount:
        let prefix = strutil.Join(["entry[", IntToStr(i), "]."], "")
        let packageId = CompilerWorldLineValue(text, strutil.Join([strings.CloneStr(prefix), "package_id"], ""))
        if packageId.len <= 0:
            return Err[bool](" compiler world: manifest entry package_id missing")
        let snapshotRes = CompilerWorldFixed32Value(text, strutil.Join([strings.CloneStr(prefix), "snapshot_cid"], ""))
        if IsErr(snapshotRes):
            return Err[bool](Error(snapshotRes))
        let syntaxRes = CompilerWorldFixed32Value(text, strutil.Join([strings.CloneStr(prefix), "syntax_surface_cid"], ""))
        if IsErr(syntaxRes):
            return Err[bool](Error(syntaxRes))
        let proofValue = CompilerWorldLineValue(text, strutil.Join([strings.CloneStr(prefix), "migration_proof_cid"], ""))
        var proofCid = layout.FixedBytes32()
        if proofValue.len > 0:
            let proofRes = layout.FixedBytes32FromHex(proofValue)
            if IsErr(proofRes):
                return Err[bool](" compiler world: invalid manifest migration proof cid")
            proofCid = Value(proofRes)
        let mirrorRes = CompilerWorldFixed32Value(
            text,
            strutil.Join([strings.CloneStr(prefix), "managed_mirror_bundle_cid"], ""))
        if IsErr(mirrorRes):
            return Err[bool](Error(mirrorRes))
        add(entries, CompilerUniverseManifestEntryMake(
                         packageId,
                         Value(snapshotRes),
                         Value(syntaxRes),
                         proofCid,
                         Value(mirrorRes)))
    let manifestRes = CompilerUniverseManifestMake(
        Value(channelRes),
        entries,
        Value(dependencyReceiptRes))
    if IsErr(manifestRes):
        return Err[bool](Error(manifestRes))
    let manifest = Value(manifestRes)
    if !layout.FixedBytes32Equal(manifest.manifestCid, Value(manifestCidRes)):
        return Err[bool](" compiler world: manifest cid mismatch")
    if CompilerUniverseManifestReport(manifest) != text:
        return Err[bool](
            " compiler world: manifest report is not exact canonical schema")
    out = manifest
    return Ok[bool](true)

@borrows
fn CompilerLockSnapshotText(lock: CompilerLockSnapshot): str =
    var lockErr: str
    if !CompilerLockSnapshotStrictValidateInto(lock, lockErr):
        system.Panic(lockErr)
    var out = ""
    out = strutil.Join([strings.CloneStr(out), "channel = \"", strings.CloneStr(lock.channel), "\"\n"], "")
    out = strutil.Join([strings.CloneStr(out), "world_head_cid = \"", layout.FixedBytes32Hex(lock.worldHeadCid), "\"\n"], "")
    out = strutil.Join([strings.CloneStr(out), "manifest_root_cid = \"", layout.FixedBytes32Hex(lock.manifestRootCid), "\"\n"], "")
    out = strutil.Join([strings.CloneStr(out), "compiler_pkg_cid = \"", layout.FixedBytes32Hex(lock.compilerPkgCid), "\"\n"], "")
    out = strutil.Join([strings.CloneStr(out), "std_pkg_cid = \"", layout.FixedBytes32Hex(lock.stdPkgCid), "\"\n"], "")
    out = strutil.Join([strings.CloneStr(out), "runtime_pkg_cid = \"", layout.FixedBytes32Hex(lock.runtimePkgCid), "\"\n"], "")
    out = strutil.Join(
        [strings.CloneStr(out),
         "managed_dependency_receipt_cid = \"",
         layout.FixedBytes32Hex(lock.managedDependencyReceiptCid),
         "\"\n"],
        "")
    out = strutil.Join([strings.CloneStr(out), "entry_count = \"", IntToStr(lock.entryCount), "\"\n"], "")
    for i in 0..<lock.entries.len:
        out = Fmt"{out}entry[{IntToStr(i)}].package_id = \"{lock.entries[i].packageId}\"\n"
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].snapshot_cid = \"", layout.FixedBytes32Hex(lock.entries[i].snapshotCid), "\"\n"], "")
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].syntax_surface_cid = \"", layout.FixedBytes32Hex(lock.entries[i].syntaxSurfaceCid), "\"\n"], "")
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].migration_proof_cid = \"", layout.FixedBytes32Hex(lock.entries[i].migrationProofCid), "\"\n"], "")
        out = strutil.Join([strings.CloneStr(out), "entry[", IntToStr(i), "].managed_mirror_bundle_cid = \"", layout.FixedBytes32Hex(lock.entries[i].managedMirrorBundleCid), "\"\n"], "")
    return out

@borrows
fn CompilerLockSnapshotStrictValidateInto(
        lock: CompilerLockSnapshot,
        err: var str): bool =
    let channelRes = CompilerWorldNormalizeChannel(lock.channel)
    if IsErr(channelRes) || Value(channelRes) != lock.channel ||
       lock.entryCount <= 0 || lock.entryCount != lock.entries.len:
        err = " compiler world: lock shape invalid"
        return false
    let zero = layout.FixedBytes32()
    if layout.FixedBytes32Equal(lock.worldHeadCid, zero) ||
       layout.FixedBytes32Equal(lock.manifestRootCid, zero) ||
       layout.FixedBytes32Equal(lock.compilerPkgCid, zero) ||
       layout.FixedBytes32Equal(lock.stdPkgCid, zero) ||
       layout.FixedBytes32Equal(lock.runtimePkgCid, zero):
        err = " compiler world: lock root identity missing"
        return false
    var hasManagedMirror = false
    for entryIndex in 0..<lock.entries.len:
        let entry = lock.entries[entryIndex]
        let canonicalPackageId = parser.ParserManifestNormalizePackageId(
            entry.packageId)
        if canonicalPackageId == "" ||
           canonicalPackageId != entry.packageId ||
           !parser.ParserSourceIdentityModuleTextValid(entry.packageId):
            err = Fmt" compiler world: lock package identity invalid index={entryIndex}"
            return false
        if entryIndex > 0 &&
           !CompilerWorldStrLess(lock.entries[entryIndex - 1].packageId,
                                 entry.packageId):
            err = Fmt" compiler world: lock entry order invalid index={entryIndex}"
            return false
        if layout.FixedBytes32Equal(entry.snapshotCid, zero) ||
           layout.FixedBytes32Equal(entry.syntaxSurfaceCid, zero):
            err = Fmt" compiler world: lock entry identity cid missing index={entryIndex}"
            return false
        let proofMissing = layout.FixedBytes32Equal(
            entry.migrationProofCid,
            zero)
        let mirrorMissing = layout.FixedBytes32Equal(
            entry.managedMirrorBundleCid,
            zero)
        if lock.channel == "stable" && proofMissing != mirrorMissing:
            err = Fmt" compiler world: stable lock proof/mirror pair incomplete index={entryIndex}"
            return false
        if !mirrorMissing:
            hasManagedMirror = true
    let dependencyReceiptMissing = layout.FixedBytes32Equal(
        lock.managedDependencyReceiptCid,
        zero)
    if lock.channel == "stable" &&
       hasManagedMirror == dependencyReceiptMissing:
        err = " compiler world: stable lock managed dependency receipt presence mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerLockSnapshotFromText(text: str,
                                  lockPath: str): Result[CompilerLockSnapshot] =
    let channelRes = CompilerWorldNormalizeChannel(CompilerWorldLineValue(text, "channel"))
    if IsErr(channelRes):
        return Err[CompilerLockSnapshot](Error(channelRes))
    let worldHeadRes = CompilerWorldFixed32Value(text, "world_head_cid")
    if IsErr(worldHeadRes):
        return Err[CompilerLockSnapshot](Error(worldHeadRes))
    let manifestRootRes = CompilerWorldFixed32Value(text,
                                                     "manifest_root_cid")
    if IsErr(manifestRootRes):
        return Err[CompilerLockSnapshot](Error(manifestRootRes))
    let compilerRes = CompilerWorldFixed32Value(text, "compiler_pkg_cid")
    if IsErr(compilerRes):
        return Err[CompilerLockSnapshot](Error(compilerRes))
    let stdRes = CompilerWorldFixed32Value(text, "std_pkg_cid")
    if IsErr(stdRes):
        return Err[CompilerLockSnapshot](Error(stdRes))
    let runtimeRes = CompilerWorldFixed32Value(text, "runtime_pkg_cid")
    if IsErr(runtimeRes):
        return Err[CompilerLockSnapshot](Error(runtimeRes))
    let dependencyReceiptRes = CompilerWorldFixed32Value(
        text,
        "managed_dependency_receipt_cid")
    if IsErr(dependencyReceiptRes):
        return Err[CompilerLockSnapshot](Error(dependencyReceiptRes))
    let entryCountValue = CompilerWorldLineValue(text, "entry_count")
    if entryCountValue.len <= 0:
        return Err[CompilerLockSnapshot](
            " compiler world: lock entry_count missing")
    let entryCount = parseInt(entryCountValue)
    if entryCount <= 0 || IntToStr(entryCount) != entryCountValue:
        return Err[CompilerLockSnapshot](
            " compiler world: lock entry_count invalid")
    var entries: CompilerUniverseManifestEntry[]
    var hasManagedMirror = false
    for i in 0..<entryCount:
        let prefix = strutil.Join(["entry[", IntToStr(i), "]."], "")
        let packageId = CompilerWorldLineValue(text, strutil.Join([strings.CloneStr(prefix), "package_id"], ""))
        if packageId.len <= 0 ||
           parser.ParserManifestNormalizePackageId(packageId) != packageId:
            return Err[CompilerLockSnapshot](
                " compiler world: lock entry package_id invalid")
        if i > 0 && !CompilerWorldStrLess(entries[i - 1].packageId,
                                           packageId):
            return Err[CompilerLockSnapshot](
                " compiler world: lock entries are not canonical strictly ordered")
        let snapshotRes = CompilerWorldFixed32Value(text, strutil.Join([strings.CloneStr(prefix), "snapshot_cid"], ""))
        if IsErr(snapshotRes):
            return Err[CompilerLockSnapshot](Error(snapshotRes))
        let syntaxRes = CompilerWorldFixed32Value(text, strutil.Join([strings.CloneStr(prefix), "syntax_surface_cid"], ""))
        if IsErr(syntaxRes):
            return Err[CompilerLockSnapshot](Error(syntaxRes))
        let proofRes = CompilerWorldFixed32Value(
            text,
            strutil.Join([strings.CloneStr(prefix), "migration_proof_cid"], ""))
        if IsErr(proofRes):
            return Err[CompilerLockSnapshot](Error(proofRes))
        let mirrorRes = CompilerWorldFixed32Value(
            text,
            strutil.Join([strings.CloneStr(prefix), "managed_mirror_bundle_cid"], ""))
        if IsErr(mirrorRes):
            return Err[CompilerLockSnapshot](Error(mirrorRes))
        if layout.FixedBytes32Equal(Value(snapshotRes),
                                    layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(Value(syntaxRes),
                                    layout.FixedBytes32()):
            return Err[CompilerLockSnapshot](
                " compiler world: lock entry identity cid missing")
        if Value(channelRes) == "stable" &&
           layout.FixedBytes32Equal(Value(proofRes),
                                    layout.FixedBytes32()) !=
           layout.FixedBytes32Equal(Value(mirrorRes),
                                    layout.FixedBytes32()):
            return Err[CompilerLockSnapshot](
                " compiler world: stable lock proof/mirror pair incomplete")
        if !layout.FixedBytes32Equal(Value(mirrorRes),
                                     layout.FixedBytes32()):
            hasManagedMirror = true
        add(entries, CompilerUniverseManifestEntryMake(
                         packageId,
                         Value(snapshotRes),
                         Value(syntaxRes),
                         Value(proofRes),
                         Value(mirrorRes)))
    let nextPrefix = strutil.Join(
        ["entry[", IntToStr(entryCount), "].package_id"],
        "")
    if CompilerWorldLineValue(text, nextPrefix) != "":
        return Err[CompilerLockSnapshot](
            " compiler world: lock entry_count is smaller than parsed entries")
    let dependencyReceiptMissing = layout.FixedBytes32Equal(
        Value(dependencyReceiptRes),
        layout.FixedBytes32())
    if Value(channelRes) == "stable" &&
       hasManagedMirror == dependencyReceiptMissing:
        return Err[CompilerLockSnapshot](
            " compiler world: stable lock managed dependency receipt presence mismatch")
    var out: CompilerLockSnapshot
    out.channel = Value(channelRes)
    out.worldHeadCid = Value(worldHeadRes)
    out.manifestRootCid = Value(manifestRootRes)
    out.compilerPkgCid = Value(compilerRes)
    out.stdPkgCid = Value(stdRes)
    out.runtimePkgCid = Value(runtimeRes)
    out.managedDependencyReceiptCid = Value(dependencyReceiptRes)
    out.entryCount = entryCount
    out.entries = entries
    out.lockPath = lockPath
    var lockErr: str
    if !CompilerLockSnapshotStrictValidateInto(out, lockErr):
        return Err[CompilerLockSnapshot](lockErr)
    if CompilerLockSnapshotText(out) != text:
        return Err[CompilerLockSnapshot](
            " compiler world: lock report is not exact canonical schema")
    return Ok[CompilerLockSnapshot](out)

@borrows
fn CompilerLockSnapshotRead(rootDir: str,
                              rawPath: str): Result[CompilerLockSnapshot] =
    let path = chengpath.PathAbsolute(rootDir, rawPath)
    if !chengpath.PathFileExists(path):
        return Err[CompilerLockSnapshot](strutil.Join([" compiler world: missing lock path: ", path], ""))
    let text = chengpath.ReadTextFile("", path)
    return CompilerLockSnapshotFromText(text, path)

@borrows
fn CompilerWorldManifestEntryIndex(
        entries: CompilerUniverseManifestEntry[],
        packageId: str): int32 =
    for entryIndex in 0..<entries.len:
        if entries[entryIndex].packageId == packageId:
            return entryIndex
    return -1

@borrows
fn CompilerWorldManifestEntryMatchesSnapshot(
        entry: CompilerUniverseManifestEntry,
        snapshot: CompilerPackageSnapshot): bool =
    return entry.packageId == snapshot.packageId &&
           layout.FixedBytes32Equal(entry.snapshotCid,
                                    snapshot.snapshotCid) &&
           layout.FixedBytes32Equal(entry.syntaxSurfaceCid,
                                    snapshot.syntaxSurfaceCid) &&
           layout.FixedBytes32Equal(entry.migrationProofCid,
                                    snapshot.migrationProofCid)

@borrows
fn CompilerLocalUniverseStrictValidateInto(
        universe: CompilerLocalUniverse,
        err: var str): bool =
    if !CompilerPackageSnapshotStrictValidateInto(
            universe.compilerSnapshot,
            err) ||
       !CompilerPackageSnapshotStrictValidateInto(
            universe.stdSnapshot,
            err) ||
       !CompilerPackageSnapshotStrictValidateInto(
            universe.runtimeSnapshot,
            err) ||
       !CompilerUniverseManifestStrictValidateInto(
            universe.manifest,
            err) ||
       !CompilerWorldHeadStrictValidateInto(universe.worldHead, err):
        return false
    let channel = universe.worldHead.channel
    if universe.compilerSnapshot.packageId != "cheng/compiler" ||
       universe.stdSnapshot.packageId != "cheng/std" ||
       universe.runtimeSnapshot.packageId != "cheng/runtime" ||
       universe.compilerSnapshot.channel != channel ||
       universe.stdSnapshot.channel != channel ||
       universe.runtimeSnapshot.channel != channel ||
       universe.manifest.channel != channel:
        err = " compiler world: local universe package/channel binding mismatch"
        return false
    if !layout.FixedBytes32Equal(universe.worldHead.manifestRootCid,
                                 universe.manifest.manifestCid) ||
       !layout.FixedBytes32Equal(universe.worldHead.csgRootCid,
                                 universe.compilerSnapshot.csgRootCid) ||
       !layout.FixedBytes32Equal(universe.worldHead.compilerPkgCid,
                                 universe.compilerSnapshot.snapshotCid) ||
       !layout.FixedBytes32Equal(universe.worldHead.stdPkgCid,
                                 universe.stdSnapshot.snapshotCid) ||
       !layout.FixedBytes32Equal(universe.worldHead.runtimePkgCid,
                                 universe.runtimeSnapshot.snapshotCid):
        err = " compiler world: local universe head binding mismatch"
        return false
    let compilerIndex = CompilerWorldManifestEntryIndex(
        universe.manifest.entries,
        universe.compilerSnapshot.packageId)
    let stdIndex = CompilerWorldManifestEntryIndex(
        universe.manifest.entries,
        universe.stdSnapshot.packageId)
    let runtimeIndex = CompilerWorldManifestEntryIndex(
        universe.manifest.entries,
        universe.runtimeSnapshot.packageId)
    if compilerIndex < 0 || stdIndex < 0 || runtimeIndex < 0 ||
       !CompilerWorldManifestEntryMatchesSnapshot(
           universe.manifest.entries[compilerIndex],
           universe.compilerSnapshot) ||
       !CompilerWorldManifestEntryMatchesSnapshot(
           universe.manifest.entries[stdIndex],
           universe.stdSnapshot) ||
       !CompilerWorldManifestEntryMatchesSnapshot(
           universe.manifest.entries[runtimeIndex],
           universe.runtimeSnapshot):
        err = " compiler world: local universe manifest/package snapshot mismatch"
        return false
    let expectedCompilerDepsCid =
        CompilerWorldDepsManifestCidExcludingIndex(
            channel,
            universe.manifest.entries,
            compilerIndex)
    let expectedLeafDepsCid = CompilerWorldEmptyManifestCid(channel)
    if !layout.FixedBytes32Equal(
            universe.compilerSnapshot.depsManifestCid,
            expectedCompilerDepsCid) ||
       !layout.FixedBytes32Equal(universe.stdSnapshot.depsManifestCid,
                                 expectedLeafDepsCid) ||
       !layout.FixedBytes32Equal(universe.runtimeSnapshot.depsManifestCid,
                                 expectedLeafDepsCid):
        err = " compiler world: local universe dependency manifest mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerWorldVerifyLock(universe: CompilerLocalUniverse,
                             lock: CompilerLockSnapshot): Result[bool] =
    var strictErr: str
    if !CompilerLocalUniverseStrictValidateInto(universe, strictErr):
        return Err[bool](strictErr)
    if !CompilerLockSnapshotStrictValidateInto(lock, strictErr):
        return Err[bool](strictErr)
    if lock.entryCount != lock.entries.len:
        return Err[bool](" compiler world: lock/world shape mismatch")
    if universe.worldHead.channel != lock.channel:
        return Err[bool](" compiler world: lock channel mismatch")
    if !layout.FixedBytes32Equal(universe.worldHead.headCid, lock.worldHeadCid):
        return Err[bool](" compiler world: lock world head mismatch")
    if !layout.FixedBytes32Equal(universe.worldHead.manifestRootCid,
                                 lock.manifestRootCid):
        return Err[bool](" compiler world: lock manifest root mismatch")
    if !layout.FixedBytes32Equal(universe.compilerSnapshot.snapshotCid, lock.compilerPkgCid):
        return Err[bool](" compiler world: lock compiler snapshot mismatch")
    if !layout.FixedBytes32Equal(universe.stdSnapshot.snapshotCid, lock.stdPkgCid):
        return Err[bool](" compiler world: lock std snapshot mismatch")
    if !layout.FixedBytes32Equal(universe.runtimeSnapshot.snapshotCid, lock.runtimePkgCid):
        return Err[bool](" compiler world: lock runtime snapshot mismatch")
    if !layout.FixedBytes32Equal(
            universe.manifest.managedDependencyReceiptCid,
            lock.managedDependencyReceiptCid):
        return Err[bool](
            " compiler world: lock managed dependency receipt mismatch")
    if universe.manifest.entryCount != lock.entryCount:
        return Err[bool](" compiler world: lock manifest entry count mismatch")
    for i in 0..<universe.manifest.entries.len:
        if universe.manifest.entries[i].packageId != lock.entries[i].packageId:
            return Err[bool](" compiler world: lock manifest package mismatch")
        if !layout.FixedBytes32Equal(universe.manifest.entries[i].snapshotCid, lock.entries[i].snapshotCid):
            return Err[bool](" compiler world: lock manifest snapshot mismatch")
        if !layout.FixedBytes32Equal(universe.manifest.entries[i].syntaxSurfaceCid,
                                     lock.entries[i].syntaxSurfaceCid):
            return Err[bool](" compiler world: lock manifest syntax mismatch")
        if !layout.FixedBytes32Equal(universe.manifest.entries[i].migrationProofCid,
                                     lock.entries[i].migrationProofCid):
            return Err[bool](" compiler world: lock manifest proof mismatch")
        if !layout.FixedBytes32Equal(
                universe.manifest.entries[i].managedMirrorBundleCid,
                lock.entries[i].managedMirrorBundleCid):
            return Err[bool](" compiler world: lock manifest mirror mismatch")
    if !layout.FixedBytes32Equal(lock.manifestRootCid,
                                 universe.manifest.manifestCid):
        return Err[bool](" compiler world: lock manifest cid drift")
    return Ok[bool](true)

@borrows
fn CompilerWorldHeadMatchesHex(head: CompilerWorldHead,
                                 rawHex: str): Result[bool] =
    var headErr: str
    if !CompilerWorldHeadStrictValidateInto(head, headErr):
        return Err[bool](headErr)
    let value = strutil.Strip(rawHex)
    if value.len <= 0:
        return Err[bool](" compiler world: requested world head missing")
    let headRes = layout.FixedBytes32FromHex(value)
    if IsErr(headRes):
        return Err[bool](" compiler world: invalid world head hex")
    if !layout.FixedBytes32Equal(head.headCid, Value(headRes)):
        return Err[bool](" compiler world: requested world head mismatch")
    return Ok[bool](true)

@borrows
fn CompilerPackageSnapshotReport(snapshot: CompilerPackageSnapshot): str =
    var snapshotErr: str
    if !CompilerPackageSnapshotStrictValidateInto(snapshot, snapshotErr):
        system.Panic(snapshotErr)
    var out = ""
    out = strutil.Join([strings.CloneStr(out), "package_id=",
                        strings.CloneStr(snapshot.packageId), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "channel=",
                        strings.CloneStr(snapshot.channel), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "source_bundle_cid=", layout.FixedBytes32Hex(snapshot.sourceBundleCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "csg_root_cid=", layout.FixedBytes32Hex(snapshot.csgRootCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "export_surface_cid=", layout.FixedBytes32Hex(snapshot.exportSurfaceCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "syntax_surface_cid=", layout.FixedBytes32Hex(snapshot.syntaxSurfaceCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "deps_manifest_cid=", layout.FixedBytes32Hex(snapshot.depsManifestCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "migration_proof_cid=", layout.FixedBytes32Hex(snapshot.migrationProofCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "signature=",
                        strings.CloneStr(snapshot.signature), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "snapshot_cid=", layout.FixedBytes32Hex(snapshot.snapshotCid)], "")
    return out

@borrows
fn CompilerPackageSnapshotFromReportText(text: str,
                                           out: var CompilerPackageSnapshot): Result[bool] =
    let packageId = CompilerWorldLineValue(text, "package_id")
    if packageId.len <= 0 ||
       parser.ParserManifestNormalizePackageId(packageId) != packageId:
        return Err[bool](" compiler world: report package_id invalid")
    let channelRes = CompilerWorldNormalizeChannel(CompilerWorldLineValue(text, "channel"))
    if IsErr(channelRes):
        return Err[bool](Error(channelRes))
    let sourceRes = CompilerWorldFixed32Value(text, "source_bundle_cid")
    if IsErr(sourceRes):
        return Err[bool](Error(sourceRes))
    let csgRes = CompilerWorldFixed32Value(text, "csg_root_cid")
    if IsErr(csgRes):
        return Err[bool](Error(csgRes))
    let exportRes = CompilerWorldFixed32Value(text, "export_surface_cid")
    if IsErr(exportRes):
        return Err[bool](Error(exportRes))
    let syntaxRes = CompilerWorldFixed32Value(text, "syntax_surface_cid")
    if IsErr(syntaxRes):
        return Err[bool](Error(syntaxRes))
    let depsManifestRes = CompilerWorldFixed32Value(text,
                                                    "deps_manifest_cid")
    if IsErr(depsManifestRes):
        return Err[bool](Error(depsManifestRes))
    let migrationProofRes = CompilerWorldFixed32Value(
        text,
        "migration_proof_cid")
    if IsErr(migrationProofRes):
        return Err[bool](Error(migrationProofRes))
    let snapshotCidRes = CompilerWorldFixed32Value(text, "snapshot_cid")
    if IsErr(snapshotCidRes):
        return Err[bool](Error(snapshotCidRes))
    let signature = CompilerWorldLineValue(text, "signature")
    if signature == "":
        return Err[bool](" compiler world: package snapshot signature missing")
    let zero = layout.FixedBytes32()
    if layout.FixedBytes32Equal(Value(sourceRes), zero) ||
       layout.FixedBytes32Equal(Value(csgRes), zero) ||
       layout.FixedBytes32Equal(Value(exportRes), zero) ||
       layout.FixedBytes32Equal(Value(syntaxRes), zero) ||
       layout.FixedBytes32Equal(Value(depsManifestRes), zero):
        return Err[bool](" compiler world: package snapshot contains zero identity cid")
    let snapshot = CompilerPackageSnapshotMake(packageId,
                                                Value(channelRes),
                                                Value(sourceRes),
                                                Value(csgRes),
                                                Value(exportRes),
                                                Value(syntaxRes),
                                                Value(depsManifestRes),
                                                Value(migrationProofRes),
                                                signature)
    if !layout.FixedBytes32Equal(snapshot.snapshotCid, Value(snapshotCidRes)):
        return Err[bool](" compiler world: package snapshot cid mismatch")
    if CompilerPackageSnapshotReport(snapshot) != text:
        return Err[bool](
            " compiler world: package snapshot report is not exact canonical schema")
    out = snapshot
    return Ok[bool](true)

@borrows
fn CompilerWorldHeadReport(head: CompilerWorldHead): str =
    var headErr: str
    if !CompilerWorldHeadStrictValidateInto(head, headErr):
        system.Panic(headErr)
    var out = ""
    out = strutil.Join([strings.CloneStr(out), "universe_id=",
                        strings.CloneStr(head.universeId), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "channel=",
                        strings.CloneStr(head.channel), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "head_epoch=", IntToStr(head.headEpoch), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "prev_head_cid=", layout.FixedBytes32Hex(head.prevHeadCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "manifest_root_cid=", layout.FixedBytes32Hex(head.manifestRootCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "csg_root_cid=", layout.FixedBytes32Hex(head.csgRootCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "compiler_pkg_cid=", layout.FixedBytes32Hex(head.compilerPkgCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "std_pkg_cid=", layout.FixedBytes32Hex(head.stdPkgCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "runtime_pkg_cid=", layout.FixedBytes32Hex(head.runtimePkgCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "signature=",
                        strings.CloneStr(head.signature), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "head_cid=", layout.FixedBytes32Hex(head.headCid)], "")
    return out

@borrows
fn CompilerWorldHeadFromReportText(text: str,
                                     out: var CompilerWorldHead): Result[bool] =
    let headEpochText = CompilerWorldLineValue(text, "head_epoch")
    if headEpochText.len <= 0:
        return Err[bool](" compiler world: report head_epoch missing")
    let headEpoch = parseInt(headEpochText)
    if headEpoch < 0 || IntToStr(headEpoch) != headEpochText:
        return Err[bool](" compiler world: report head_epoch invalid")
    let universeId = CompilerWorldLineValue(text, "universe_id")
    if universeId != CompilerWorldUniverseId():
        return Err[bool](" compiler world: report universe_id invalid")
    let channelRes = CompilerWorldNormalizeChannel(
        CompilerWorldLineValue(text, "channel"))
    if IsErr(channelRes):
        return Err[bool](Error(channelRes))
    let signature = CompilerWorldLineValue(text, "signature")
    if signature == "":
        return Err[bool](" compiler world: report world head signature missing")
    let prevHeadRes = CompilerWorldFixed32Value(text, "prev_head_cid")
    if IsErr(prevHeadRes):
        return Err[bool](Error(prevHeadRes))
    let manifestRes = CompilerWorldFixed32Value(text, "manifest_root_cid")
    if IsErr(manifestRes):
        return Err[bool](Error(manifestRes))
    let csgRes = CompilerWorldFixed32Value(text, "csg_root_cid")
    if IsErr(csgRes):
        return Err[bool](Error(csgRes))
    let compilerRes = CompilerWorldFixed32Value(text, "compiler_pkg_cid")
    if IsErr(compilerRes):
        return Err[bool](Error(compilerRes))
    let stdRes = CompilerWorldFixed32Value(text, "std_pkg_cid")
    if IsErr(stdRes):
        return Err[bool](Error(stdRes))
    let runtimeRes = CompilerWorldFixed32Value(text, "runtime_pkg_cid")
    if IsErr(runtimeRes):
        return Err[bool](Error(runtimeRes))
    let headCidRes = CompilerWorldFixed32Value(text, "head_cid")
    if IsErr(headCidRes):
        return Err[bool](Error(headCidRes))
    out.universeId = universeId
    out.channel = Value(channelRes)
    out.headEpoch = headEpoch
    out.prevHeadCid = Value(prevHeadRes)
    out.manifestRootCid = Value(manifestRes)
    out.csgRootCid = Value(csgRes)
    out.compilerPkgCid = Value(compilerRes)
    out.stdPkgCid = Value(stdRes)
    out.runtimePkgCid = Value(runtimeRes)
    out.signature = signature
    out.headCid = Value(headCidRes)
    var headErr: str
    if !CompilerWorldHeadStrictValidateInto(out, headErr):
        return Err[bool](headErr)
    if CompilerWorldHeadReport(out) != text:
        return Err[bool](
            " compiler world: world head report is not exact canonical schema")
    return Ok[bool](true)

@borrows
fn CompilerLockText(universe: CompilerLocalUniverse): str =
    var universeErr: str
    if !CompilerLocalUniverseStrictValidateInto(universe, universeErr):
        system.Panic(universeErr)
    var lock: CompilerLockSnapshot
    lock.channel = universe.worldHead.channel
    lock.worldHeadCid = universe.worldHead.headCid
    lock.manifestRootCid = universe.worldHead.manifestRootCid
    lock.compilerPkgCid = universe.compilerSnapshot.snapshotCid
    lock.stdPkgCid = universe.stdSnapshot.snapshotCid
    lock.runtimePkgCid = universe.runtimeSnapshot.snapshotCid
    lock.managedDependencyReceiptCid =
        universe.manifest.managedDependencyReceiptCid
    lock.entryCount = universe.manifest.entryCount
    lock.entries = universe.manifest.entries
    return CompilerLockSnapshotText(lock)

@borrows
fn CompilerWorldSummaryReport(universe: CompilerLocalUniverse): str =
    var universeErr: str
    if !CompilerLocalUniverseStrictValidateInto(universe, universeErr):
        system.Panic(universeErr)
    var out = ""
    out = strutil.Join([strings.CloneStr(out), "channel=",
                        strings.CloneStr(universe.worldHead.channel), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "world_head_cid=", layout.FixedBytes32Hex(universe.worldHead.headCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "manifest_root_cid=", layout.FixedBytes32Hex(universe.worldHead.manifestRootCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "compiler_pkg_cid=", layout.FixedBytes32Hex(universe.compilerSnapshot.snapshotCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "std_pkg_cid=", layout.FixedBytes32Hex(universe.stdSnapshot.snapshotCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "runtime_pkg_cid=", layout.FixedBytes32Hex(universe.runtimeSnapshot.snapshotCid), "\n"], "")
    out = strutil.Join([strings.CloneStr(out), "manifest_entry_count=", IntToStr(universe.manifest.entryCount)], "")
    return out
