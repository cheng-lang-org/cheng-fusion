type
    PerfMemoryThreshold =
        maxElapsedMs: int64
        maxRssBytes: int64
        maxOutputFileSizeBytes: int64

    PerfMemoryExecPhaseSummary =
        systemLinkPlanMs: int64
        sourceBundleMs: int64
        compilerCsgMs: int64
        worldMs: int64
        lockMs: int64
        baselineMs: int64
        loweringPlanMs: int64
        primaryObjectPlanMs: int64
        providerSourcesMs: int64
        objectPlanMs: int64
        nativeLinkPlanMs: int64
        compileReceiptMs: int64
        totalMs: int64
        linuxNolibcObjectsMs: int64
        providerObjectsMs: int64
        providerCacheLookupMs: int64
        providerCacheCopyMs: int64
        providerCacheStoreMs: int64
        chengProviderCompileMs: int64
        cProviderCompileMs: int64
        providerObjectCacheHitCount: int64
        providerObjectCacheMissCount: int64
        primaryObjectCacheLookupMs: int64
        primaryObjectCacheCopyMs: int64
        primaryObjectCacheStoreMs: int64
        primaryObjectCacheHitCount: int64
        primaryObjectCacheMissCount: int64
        primaryObjectEmitMs: int64
        primaryObjectGlobalStorageMs: int64
        primaryObjectModuleInitMs: int64
        primaryObjectFunctionEmitMs: int64
        primaryObjectEntryBridgeMs: int64
        primaryObjectLineMapEmbedMs: int64
        primaryObjectSymbolTrailerMs: int64
        primaryObjectAsmWriteMs: int64
        primaryObjectAsmCompileMs: int64
        primaryObjectAsmBytes: int64
        primaryObjectLineMapAsmBytes: int64
        nativeLinkMs: int64
        lineMapMs: int64
        materializeTotalMs: int64
        backendTotalMs: int64

    PerfMemoryRun =
        label: str
        compilerPath: str
        target: str
        fixturePath: str
        sourceBytes: int64
        logPath: str
        exitCode: int32
        elapsedMs: int64
        throughputBytesPerMs: int64
        maxRssBytes: int64
        peakFootprintBytes: int64
        outputFileSizeBytes: int64
        output: str

    PerfMemoryColdPureComparison =
        label: str
        fixturePath: str
        target: str
        sourceBytes: int64
        coldCompilerPath: str
        pureCompilerPath: str
        coldElapsedMs: int64
        pureElapsedMs: int64
        coldThroughputBytesPerMs: int64
        pureThroughputBytesPerMs: int64
        coldOutputBytes: int64
        pureOutputBytes: int64
        coldExitCode: int32
        pureExitCode: int32
        ok: bool

    PerfMemoryRuntimeCBaselineContract =
        ok: bool
        report: str

fn PerfMemoryThresholdNew(maxElapsedMs: int64,
                            maxRssBytes: int64): PerfMemoryThreshold =
    return PerfMemoryThreshold(maxElapsedMs: maxElapsedMs,
                                maxRssBytes: maxRssBytes,
                                maxOutputFileSizeBytes: int64(0))

fn PerfMemoryThresholdWithOutputFileSize(maxElapsedMs: int64,
                                          maxRssBytes: int64,
                                          maxOutputFileSizeBytes: int64): PerfMemoryThreshold =
    return PerfMemoryThreshold(maxElapsedMs: maxElapsedMs,
                                maxRssBytes: maxRssBytes,
                                maxOutputFileSizeBytes: maxOutputFileSizeBytes)

fn perfMemoryRowPiece(row: str,
                      piece: str): str =
    return strings.ConcatStr(row, piece)

fn perfMemoryRowText(row: str,
                     key: str,
                     value: str): str =
    return strings.ConcatStr(strings.ConcatStr(row, key), value)

fn perfMemoryRowInt64(row: str,
                      key: str,
                      value: int64): str =
    return perfMemoryRowText(row, key, strings.Int64ToStr(value))

fn perfMemoryRowInt32(row: str,
                      key: str,
                      value: int32): str =
    return perfMemoryRowText(row, key, strings.IntToStr(value))

