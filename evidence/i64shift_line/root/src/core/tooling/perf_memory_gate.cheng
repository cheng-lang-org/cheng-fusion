fn PerfMemoryRunNew(label: str,
                      logPath: str,
                      exitCode: int32,
                      elapsedMs: int64,
                      maxRssBytes: int64,
                      peakFootprintBytes: int64,
                      outputFileSizeBytes: int64,
                      output: str): PerfMemoryRun =
    return PerfMemoryRunDetailed(label,
                                 "",
                                 "",
                                 "",
                                 int64(-1),
                                 logPath,
                                 exitCode,
                                 elapsedMs,
                                 maxRssBytes,
                                 peakFootprintBytes,
                                 outputFileSizeBytes,
                                 output)

fn PerfMemoryRunDetailed(label: str,
                           compilerPath: str,
                           target: str,
                           fixturePath: str,
                           sourceBytes: int64,
                           logPath: str,
                           exitCode: int32,
                           elapsedMs: int64,
                           maxRssBytes: int64,
                           peakFootprintBytes: int64,
                           outputFileSizeBytes: int64,
                           output: str): PerfMemoryRun =
    let throughput = PerfMemoryThroughputBytesPerMs(sourceBytes, elapsedMs)
    return PerfMemoryRun(label: label,
                           compilerPath: compilerPath,
                           target: target,
                           fixturePath: fixturePath,
                           sourceBytes: sourceBytes,
                           logPath: logPath,
                           exitCode: exitCode,
                           elapsedMs: elapsedMs,
                           throughputBytesPerMs: throughput,
                           maxRssBytes: maxRssBytes,
                           peakFootprintBytes: peakFootprintBytes,
                           outputFileSizeBytes: outputFileSizeBytes,
                           output: output)

fn PerfMemoryColdSelfBuildBudgetMs(): int64 =
    return int64(80)

fn PerfMemoryColdSelfBuildScopeText(): str =
    return "driver_start+source_closure_digest+outline_all_sources+function_task_schedule+lowering_codegen+candidate_exe_emit+candidate_map_write+runtime_provider_or_global_memory"

fn PerfMemoryColdSelfBuildExcludeText(): str =
    return "c_seed+stage0_rebuild+bootstrap_bridge_stage_chain+run_production_regression+host_smokes+network_download+external_scripts+hotpatch_warm_state"

fn PerfMemoryColdSelfBuildBudgetMultiple(observedMs: int64): int64 =
    let budgetMs: int64 = PerfMemoryColdSelfBuildBudgetMs()
    if observedMs < int64(0):
        return int64(-1)
    return observedMs / budgetMs

fn PerfMemoryFlag(prefix: str, value: str): str =
    return strutil.Join([prefix, value], "")

fn PerfMemoryCompileReportPath(outputPath: str): str =
    return strutil.Join([outputPath, ".compile.report.txt"], "")

fn PerfMemoryResolveCompiler(root: str): str =
    let compilerEnv = os.GetEnv("CHENG_SMOKE_COMPILER")
    if len(compilerEnv) > 0:
        if os.IsAbsolute(compilerEnv):
            return compilerEnv
        return os.JoinPath(root, compilerEnv)
    let backendDriver = os.JoinPath(root, "artifacts/backend_driver/cheng")
    if os.FileExists(backendDriver):
        return backendDriver
    let compilerRaw = "artifacts/bootstrap/cheng.stage3"
    if os.IsAbsolute(compilerRaw):
        return compilerRaw
    return os.JoinPath(root, compilerRaw)

fn PerfMemoryParseUnsignedInt64(raw: str): int64 =
    let text: str = strutil.Strip(raw)
    if len(text) <= 0:
        return int64(-1)
    var value: int64 = int64(0)
    var hadDigit: bool
    for i in 0..<len(text):
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            return int64(-1)
        value = value * int64(10) + int64(int32(ch) - int32('0'))
        hadDigit = true
    if !hadDigit:
        return int64(-1)
    return value

fn PerfMemoryThroughputBytesPerMs(sourceBytes: int64,
                                   elapsedMs: int64): int64 =
    if sourceBytes <= int64(0) || elapsedMs <= int64(0):
        return int64(-1)
    return sourceBytes / elapsedMs

fn PerfMemoryParseDecimalMilli(raw: str): int64 =
    if len(raw) <= 0:
        return int64(-1)
    var whole: int64 = int64(0)
    var frac: int64 = int64(0)
    var fracDigits: int32
    var seenDot: bool
    for i in 0..<len(raw):
        let ch: char = raw[i]
        if ch == '.':
            if seenDot:
                return int64(-1)
            seenDot = true
        elif ch >= '0' && ch <= '9':
            let digit: int64 = int64(int32(ch) - int32('0'))
            if !seenDot:
                whole = whole * int64(10) + digit
            elif fracDigits < 3:
                frac = frac * int64(10) + digit
                fracDigits = fracDigits + int32(1)
        else:
            return int64(-1)
    for _ in range(3 - fracDigits):
        frac = frac * int64(10)
        fracDigits = fracDigits + int32(1)
    return whole * int64(1000) + frac

fn PerfMemoryHostFlavor(): str =
    let hostTarget: str = boot.BootstrapDetectHostTarget()
    if strutil.Contains(hostTarget, "apple-darwin"):
        return "darwin"
    if strutil.Contains(hostTarget, "linux"):
        return "linux"
    return ""

fn PerfMemoryAppendArgs(out: var str[], extra: str[]) =
    for i in 0..<extra.len:
        add(out, extra[i])

fn PerfMemoryTimedArgv(filePath: str, argv: str[]): str[] =
    let hostFlavor: str = PerfMemoryHostFlavor()
    var out: str[]
    if hostFlavor == "darwin":
        add(out, "-l")
    elif hostFlavor == "linux":
        add(out, "-f")
        add(out, "cheng_perf_real_seconds=%e\ncheng_perf_max_rss_kb=%M\n")
    else:
        system.Assert(false, " perf memory: unsupported host flavor")
    add(out, filePath)
    PerfMemoryAppendArgs(out, argv)
    return out

fn perfMemoryIsLineTrimChar(ch: char): bool =
    let code: int32 = Int32(ch)
    if code == 32:
        return true
    if code == 9:
        return true
    if code == 10:
        return true
    if code == 13:
        return true
    return false

fn perfMemoryFirstField(line: str): str =
    let lineLen: int32 = len(line)
    var start: int32
    while start < lineLen && perfMemoryIsLineTrimChar(line[start]):
        start = start + int32(1)
    if start >= lineLen:
        return ""
    var stop: int32 = start
    while stop < lineLen:
        if perfMemoryIsLineTrimChar(line[stop]):
            break
        stop = stop + int32(1)
    return strings.SliceBytes(line, start, stop - start)

fn perfMemoryLineSlice(text: str,
                       start: int32,
                       stopExclusive: int32): str =
    if stopExclusive <= start:
        return ""
    return strings.SliceBytes(text, start, stopExclusive - start)

fn PerfMemoryParseDarwinMetrics(output: str,
                                  outElapsedMs: var int64,
                                  outMaxRssBytes: var int64,
                                  outPeakFootprintBytes: var int64) =
    let outputLen: int32 = len(output)
    var lineStart: int32
    while lineStart < outputLen:
        var lineEnd: int32 = lineStart
        while lineEnd < outputLen:
            if output[lineEnd] == '\n':
                break
            lineEnd = lineEnd + int32(1)
        let line: str = strutil.Strip(perfMemoryLineSlice(output, lineStart, lineEnd))
        if strutil.Contains(line, " real") && strutil.Contains(line, " user") && strutil.Contains(line, " sys"):
            let firstField: str = perfMemoryFirstField(line)
            let elapsedMs: int64 = PerfMemoryParseDecimalMilli(firstField)
            if elapsedMs > int64(0):
                outElapsedMs = elapsedMs
            elif elapsedMs == int64(0):
                # `/usr/bin/time -l` prints only centiseconds; sub-10ms runs show as 0.00.
                outElapsedMs = int64(1)
        elif strutil.Contains(line, "maximum resident set size"):
            let firstField: str = perfMemoryFirstField(line)
            let rssBytes: int64 = PerfMemoryParseUnsignedInt64(firstField)
            if rssBytes > int64(0):
                outMaxRssBytes = rssBytes
        elif strutil.Contains(line, "peak memory footprint"):
            let firstField: str = perfMemoryFirstField(line)
            let peakBytes: int64 = PerfMemoryParseUnsignedInt64(firstField)
            if peakBytes > int64(0):
                outPeakFootprintBytes = peakBytes
        lineStart = lineEnd + int32(1)
    # Darwin `/usr/bin/time -l` reports both metrics, but `maximum resident set size`
    # can drift badly for compiler subprocess trees. Use peak footprint as the
    # comparable contract metric when it is available.
    if outPeakFootprintBytes > int64(0):
        outMaxRssBytes = outPeakFootprintBytes

fn PerfMemoryParseLinuxMetrics(output: str,
                                 outElapsedMs: var int64,
                                 outMaxRssBytes: var int64) =
    let elapsedPrefix = "cheng_perf_real_seconds="
    let rssPrefix = "cheng_perf_max_rss_kb="
    let outputLen: int32 = len(output)
    var lineStart: int32
    while lineStart < outputLen:
        var lineEnd: int32 = lineStart
        while lineEnd < outputLen:
            if output[lineEnd] == '\n':
                break
            lineEnd = lineEnd + int32(1)
        let line: str = strutil.Strip(perfMemoryLineSlice(output, lineStart, lineEnd))
        if strutil.StartsWith(line, elapsedPrefix):
            let raw: str = strings.SliceBytes(line, len(elapsedPrefix), len(line) - len(elapsedPrefix))
            let elapsedMs: int64 = PerfMemoryParseDecimalMilli(raw)
            if elapsedMs > int64(0):
                outElapsedMs = elapsedMs
        elif strutil.StartsWith(line, rssPrefix):
            let raw: str = strings.SliceBytes(line, len(rssPrefix), len(line) - len(rssPrefix))
            let rssKb: int64 = PerfMemoryParseUnsignedInt64(raw)
            if rssKb > int64(0):
                outMaxRssBytes = rssKb * int64(1024)
        lineStart = lineEnd + int32(1)

fn PerfMemoryParseMetrics(output: str,
                            outElapsedMs: var int64,
                            outMaxRssBytes: var int64,
                            outPeakFootprintBytes: var int64) =
    outElapsedMs = int64(-1)
    outMaxRssBytes = int64(-1)
    outPeakFootprintBytes = int64(-1)
    let hostFlavor: str = PerfMemoryHostFlavor()
    if hostFlavor == "darwin":
        PerfMemoryParseDarwinMetrics(output, outElapsedMs, outMaxRssBytes, outPeakFootprintBytes)
        return
    if hostFlavor == "linux":
        PerfMemoryParseLinuxMetrics(output, outElapsedMs, outMaxRssBytes)
        return
    system.Assert(false, " perf memory: parse unsupported host flavor")

fn perfMemoryLineStartsWith(text: str,
                            start: int32,
                            stop: int32,
                            prefix: str): bool =
    let prefixLen: int32 = len(prefix)
    if stop - start + 1 < prefixLen:
        return false
    for i in 0..<prefixLen:
        if text[start + i] != prefix[i]:
            return false
    return true

fn PerfMemoryLineValue(text: str,
                         key: str): str =
    let prefix = strings.ConcatStr(key, "=")
    let prefixLen: int32 = len(prefix)
    let textLen: int32 = len(text)
    var lineStart: int32
    while lineStart < textLen:
        var lineEnd: int32 = lineStart
        while lineEnd < textLen:
            if text[lineEnd] == '\n':
                break
            lineEnd = lineEnd + int32(1)
        var start: int32 = lineStart
        var stop: int32 = lineEnd - int32(1)
        while start <= stop && perfMemoryIsLineTrimChar(text[start]):
            start = start + int32(1)
        while stop >= start && perfMemoryIsLineTrimChar(text[stop]):
            stop = stop - int32(1)
        if perfMemoryLineStartsWith(text, start, stop, prefix):
            let valueStart: int32 = start + prefixLen
            let valueCount: int32 = stop - valueStart + int32(1)
            if valueCount <= int32(0):
                return ""
            return strings.SliceBytes(text, valueStart, valueCount)
        lineStart = lineEnd + int32(1)
    return ""

fn PerfMemoryParseOutputInt64(text: str,
                                key: str): int64 =
    let value: str = PerfMemoryLineValue(text, key)
    if len(value) <= 0:
        return int64(-1)
    return PerfMemoryParseUnsignedInt64(value)

fn PerfMemoryParseOutputDecimalMs(text: str,
                                    key: str): int64 =
    let value: str = PerfMemoryLineValue(text, key)
    if len(value) <= 0:
        return int64(-1)
    let milli = PerfMemoryParseDecimalMilli(value)
    if milli <= int64(0):
        return int64(-1)
    let rounded = (milli + int64(500)) / int64(1000)
    if rounded <= int64(0):
        return int64(1)
    return rounded

fn PerfMemoryRunHasStrictCompileData(sample: PerfMemoryRun): bool =
    if len(sample.compilerPath) <= 0:
        return false
    if len(sample.target) <= 0:
        return false
    if len(sample.fixturePath) <= 0:
        return false
    if sample.sourceBytes <= int64(0):
        return false
    if sample.elapsedMs <= int64(0):
        return false
    if sample.throughputBytesPerMs < int64(0):
        return false
    if sample.outputFileSizeBytes <= int64(0):
        return false
    if sample.exitCode != 0:
        return false
    return true

fn PerfMemorySortInt64(values: var int64[]) =
    for i in 0..<values.len:
        var minIndex = i
        for j in (i + 1)..<values.len:
            if values[j] < values[minIndex]:
                minIndex = j
        if minIndex != i:
            let tmp = values[i]
            values[i] = values[minIndex]
            values[minIndex] = tmp

fn PerfMemoryMedianInt64(valuesRaw: int64[]): int64 =
    system.Assert(valuesRaw.len >= 3, " perf memory: strict median repeat count")
    var values: int64[]
    for i in 0..<valuesRaw.len:
        system.Assert(valuesRaw[i] >= int64(0), " perf memory: strict median value")
        add(values, valuesRaw[i])
    PerfMemorySortInt64(values)
    return values[values.len / 2]

fn PerfMemoryMedianRun(label: str,
                         samples: PerfMemoryRun[]): PerfMemoryRun =
    system.Assert(samples.len >= 3, " perf memory: strict sample repeat count")
    var elapsedValues: int64[]
    var throughputValues: int64[]
    var outputValues: int64[]
    var exitCode: int32
    for i in 0..<samples.len:
        system.Assert(PerfMemoryRunHasStrictCompileData(samples[i]),
                      " perf memory: strict sample has real data")
        add(elapsedValues, samples[i].elapsedMs)
        add(throughputValues, samples[i].throughputBytesPerMs)
        add(outputValues, samples[i].outputFileSizeBytes)
        if samples[i].exitCode != 0:
            exitCode = samples[i].exitCode
    var out = PerfMemoryRunDetailed(label,
                                    samples[0].compilerPath,
                                    samples[0].target,
                                    samples[0].fixturePath,
                                    samples[0].sourceBytes,
                                    samples[0].logPath,
                                    exitCode,
                                    PerfMemoryMedianInt64(elapsedValues),
                                    samples[0].maxRssBytes,
                                    samples[0].peakFootprintBytes,
                                    PerfMemoryMedianInt64(outputValues),
                                    samples[0].output)
    out.throughputBytesPerMs = PerfMemoryMedianInt64(throughputValues)
    return out

fn PerfMemoryColdPureComparisonNew(label: str,
                                     cold: PerfMemoryRun,
                                     pure: PerfMemoryRun): PerfMemoryColdPureComparison =
    system.Assert(PerfMemoryRunHasStrictCompileData(cold),
                  " perf memory: cold strict compile data")
    system.Assert(PerfMemoryRunHasStrictCompileData(pure),
                  " perf memory: pure strict compile data")
    system.Assert(cold.fixturePath == pure.fixturePath,
                  " perf memory: cold pure same fixture")
    system.Assert(cold.target == pure.target,
                  " perf memory: cold pure same target")
    system.Assert(cold.sourceBytes == pure.sourceBytes,
                  " perf memory: cold pure same source bytes")
    let ok = pure.elapsedMs <= cold.elapsedMs &&
             pure.throughputBytesPerMs >= cold.throughputBytesPerMs &&
             pure.outputFileSizeBytes <= cold.outputFileSizeBytes
    return PerfMemoryColdPureComparison(label: label,
                                         fixturePath: cold.fixturePath,
                                         target: cold.target,
                                         sourceBytes: cold.sourceBytes,
                                         coldCompilerPath: cold.compilerPath,
                                         pureCompilerPath: pure.compilerPath,
                                         coldElapsedMs: cold.elapsedMs,
                                         pureElapsedMs: pure.elapsedMs,
                                         coldThroughputBytesPerMs: cold.throughputBytesPerMs,
                                         pureThroughputBytesPerMs: pure.throughputBytesPerMs,
                                         coldOutputBytes: cold.outputFileSizeBytes,
                                         pureOutputBytes: pure.outputFileSizeBytes,
                                         coldExitCode: cold.exitCode,
                                         pureExitCode: pure.exitCode,
                                         ok: ok)

fn PerfMemoryBoolIntText(value: bool): str =
    if value:
        return "1"
    return "0"

fn PerfMemoryExecPhaseSummaryFromOutput(text: str): PerfMemoryExecPhaseSummary =
    var out = PerfMemoryExecPhaseSummaryEmpty()
    out.systemLinkPlanMs = PerfMemoryParseOutputInt64(text, "exec_phase_system_link_plan_ms")
    out.sourceBundleMs = PerfMemoryParseOutputInt64(text, "exec_phase_source_bundle_ms")
    out.compilerCsgMs = PerfMemoryParseOutputInt64(text, "exec_phase_compiler_csg_ms")
    out.worldMs = PerfMemoryParseOutputInt64(text, "exec_phase_world_ms")
    out.lockMs = PerfMemoryParseOutputInt64(text, "exec_phase_lock_ms")
    out.baselineMs = PerfMemoryParseOutputInt64(text, "exec_phase_baseline_ms")
    out.loweringPlanMs = PerfMemoryParseOutputInt64(text, "exec_phase_lowering_plan_ms")
    out.primaryObjectPlanMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_plan_ms")
    out.providerSourcesMs = PerfMemoryParseOutputInt64(text, "exec_phase_provider_sources_ms")
    out.objectPlanMs = PerfMemoryParseOutputInt64(text, "exec_phase_object_plan_ms")
    out.nativeLinkPlanMs = PerfMemoryParseOutputInt64(text, "exec_phase_native_link_plan_ms")
    out.compileReceiptMs = PerfMemoryParseOutputInt64(text, "exec_phase_compile_receipt_ms")
    out.totalMs = PerfMemoryParseOutputInt64(text, "exec_phase_total_ms")
    out.linuxNolibcObjectsMs = PerfMemoryParseOutputInt64(text, "exec_phase_linux_nolibc_objects_ms")
    out.providerObjectsMs = PerfMemoryParseOutputInt64(text, "exec_phase_provider_objects_ms")
    out.providerCacheLookupMs = PerfMemoryParseOutputInt64(text, "exec_phase_provider_cache_lookup_ms")
    out.providerCacheCopyMs = PerfMemoryParseOutputInt64(text, "exec_phase_provider_cache_copy_ms")
    out.providerCacheStoreMs = PerfMemoryParseOutputInt64(text, "exec_phase_provider_cache_store_ms")
    out.chengProviderCompileMs = PerfMemoryParseOutputInt64(text, "exec_phase_cheng_provider_compile_ms")
    out.cProviderCompileMs = PerfMemoryParseOutputInt64(text, "exec_phase_c_provider_compile_ms")
    out.providerObjectCacheHitCount = PerfMemoryParseOutputInt64(text, "provider_object_cache_hit_count")
    out.providerObjectCacheMissCount = PerfMemoryParseOutputInt64(text, "provider_object_cache_miss_count")
    out.primaryObjectCacheLookupMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_cache_lookup_ms")
    out.primaryObjectCacheCopyMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_cache_copy_ms")
    out.primaryObjectCacheStoreMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_cache_store_ms")
    out.primaryObjectCacheHitCount = PerfMemoryParseOutputInt64(text, "primary_object_cache_hit_count")
    out.primaryObjectCacheMissCount = PerfMemoryParseOutputInt64(text, "primary_object_cache_miss_count")
    out.primaryObjectEmitMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_emit_ms")
    out.primaryObjectGlobalStorageMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_global_storage_ms")
    out.primaryObjectModuleInitMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_module_init_ms")
    out.primaryObjectFunctionEmitMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_function_emit_ms")
    out.primaryObjectEntryBridgeMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_entry_bridge_ms")
    out.primaryObjectLineMapEmbedMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_line_map_embed_ms")
    out.primaryObjectSymbolTrailerMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_symbol_trailer_ms")
    out.primaryObjectAsmWriteMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_asm_write_ms")
    out.primaryObjectAsmCompileMs = PerfMemoryParseOutputInt64(text, "exec_phase_primary_object_asm_compile_ms")
    out.primaryObjectAsmBytes = PerfMemoryParseOutputInt64(text, "primary_object_asm_bytes")
    out.primaryObjectLineMapAsmBytes = PerfMemoryParseOutputInt64(text, "primary_object_line_map_asm_bytes")
    out.nativeLinkMs = PerfMemoryParseOutputInt64(text, "exec_phase_native_link_ms")
    out.lineMapMs = PerfMemoryParseOutputInt64(text, "exec_phase_line_map_ms")
    out.materializeTotalMs = PerfMemoryParseOutputInt64(text, "exec_phase_materialize_total_ms")
    out.backendTotalMs = PerfMemoryParseOutputInt64(text, "exec_phase_backend_total_ms")
    return out

fn PerfMemoryExecPhaseSummaryReady(summary: PerfMemoryExecPhaseSummary): bool =
    if summary.totalMs >= int64(0):
        return true
    return false

fn PerfMemoryCompileExecPhaseSummary(root: str,
                                       outputPath: str,
                                       fallbackText: str): PerfMemoryExecPhaseSummary =
    let reportPath: str = PerfMemoryCompileReportPath(outputPath)
    if os.FileExists(reportPath):
        let reportText: str = chengpath.ReadTextFile(root, reportPath)
        let reportSummary = PerfMemoryExecPhaseSummaryFromOutput(reportText)
        if PerfMemoryExecPhaseSummaryReady(reportSummary):
            return reportSummary
    return PerfMemoryExecPhaseSummaryFromOutput(fallbackText)

fn PerfMemoryCompileReportElapsedMs(root: str,
                                      outputPath: str): int64 =
    let reportPath: str = PerfMemoryCompileReportPath(outputPath)
    if !os.FileExists(reportPath):
        return int64(-1)
    let reportText: str = chengpath.ReadTextFile(root, reportPath)
    let coldElapsed = PerfMemoryParseOutputDecimalMs(reportText, "cold_compile_elapsed_ms")
    if coldElapsed > int64(0):
        return coldElapsed
    let realElapsed = PerfMemoryParseOutputDecimalMs(reportText, "compile_real_elapsed_ms")
    if realElapsed > int64(0):
        return realElapsed
    return int64(-1)

fn PerfMemoryExecPhaseGapMs(sample: PerfMemoryRun,
                              summary: PerfMemoryExecPhaseSummary): int64 =
    if sample.elapsedMs < int64(0) || summary.totalMs < int64(0):
        return int64(-1)
    return sample.elapsedMs - summary.totalMs

fn PerfMemoryExecPhaseMaterializeMs(summary: PerfMemoryExecPhaseSummary): int64 =
    if summary.materializeTotalMs >= int64(0):
        return summary.materializeTotalMs
    if summary.linuxNolibcObjectsMs < int64(0) ||
       summary.providerObjectsMs < int64(0) ||
       summary.primaryObjectEmitMs < int64(0):
        return int64(-1)
    return summary.linuxNolibcObjectsMs + summary.providerObjectsMs + summary.primaryObjectEmitMs

fn PerfMemoryExecPhaseAttributedMs(summary: PerfMemoryExecPhaseSummary): int64 =
    if summary.backendTotalMs >= int64(0):
        return summary.backendTotalMs
    let materializeMs: int64 = PerfMemoryExecPhaseMaterializeMs(summary)
    if summary.totalMs < int64(0) ||
       materializeMs < int64(0) ||
       summary.nativeLinkMs < int64(0) ||
       summary.lineMapMs < int64(0):
        return int64(-1)
    return summary.totalMs + materializeMs + summary.nativeLinkMs + summary.lineMapMs

fn PerfMemoryCompileGapBreakdownReady(summary: PerfMemoryExecPhaseSummary): bool =
    if PerfMemoryExecPhaseAttributedMs(summary) >= int64(0):
        return true
    return false

fn PerfMemoryCompileGapBreakdownMs(sample: PerfMemoryRun,
                                     summary: PerfMemoryExecPhaseSummary): int64 =
    let attributedMs: int64 = PerfMemoryExecPhaseAttributedMs(summary)
    if sample.elapsedMs < int64(0) || attributedMs < int64(0):
        return int64(-1)
    let gapMs: int64 = sample.elapsedMs - attributedMs
    if gapMs < int64(0) && gapMs >= int64(-20):
        return int64(0)
    return gapMs

fn PerfMemoryExecPhaseReportRow(sample: PerfMemoryRun,
                                  summary: PerfMemoryExecPhaseSummary): str =
    var row = perfMemoryRowPiece(sample.label, "_exec_phase_summary")
    row = perfMemoryRowInt64(row, " system_link_plan_ms=", summary.systemLinkPlanMs)
    row = perfMemoryRowInt64(row, " source_bundle_ms=", summary.sourceBundleMs)
    row = perfMemoryRowInt64(row, " compiler_csg_ms=", summary.compilerCsgMs)
    row = perfMemoryRowInt64(row, " world_ms=", summary.worldMs)
    row = perfMemoryRowInt64(row, " lock_ms=", summary.lockMs)
    row = perfMemoryRowInt64(row, " baseline_ms=", summary.baselineMs)
    row = perfMemoryRowInt64(row, " lowering_plan_ms=", summary.loweringPlanMs)
    row = perfMemoryRowInt64(row, " primary_object_plan_ms=", summary.primaryObjectPlanMs)
    row = perfMemoryRowInt64(row, " provider_sources_ms=", summary.providerSourcesMs)
    row = perfMemoryRowInt64(row, " object_plan_ms=", summary.objectPlanMs)
    row = perfMemoryRowInt64(row, " native_link_plan_ms=", summary.nativeLinkPlanMs)
    row = perfMemoryRowInt64(row, " compile_receipt_ms=", summary.compileReceiptMs)
    row = perfMemoryRowInt64(row, " planner_total_ms=", summary.totalMs)
    row = perfMemoryRowInt64(row, " compile_gap_ms=", PerfMemoryExecPhaseGapMs(sample, summary))
    return row

fn PerfMemoryCompileGapBreakdownRow(sample: PerfMemoryRun,
                                      summary: PerfMemoryExecPhaseSummary): str =
    let materializeMs: int64 = PerfMemoryExecPhaseMaterializeMs(summary)
    let attributedMs: int64 = PerfMemoryExecPhaseAttributedMs(summary)
    var row = perfMemoryRowPiece(sample.label, "_gap_breakdown")
    row = perfMemoryRowInt64(row, " planner_total_ms=", summary.totalMs)
    row = perfMemoryRowInt64(row, " linux_nolibc_objects_ms=", summary.linuxNolibcObjectsMs)
    row = perfMemoryRowInt64(row, " provider_objects_ms=", summary.providerObjectsMs)
    row = perfMemoryRowInt64(row, " provider_cache_lookup_ms=", summary.providerCacheLookupMs)
    row = perfMemoryRowInt64(row, " provider_cache_copy_ms=", summary.providerCacheCopyMs)
    row = perfMemoryRowInt64(row, " provider_cache_store_ms=", summary.providerCacheStoreMs)
    row = perfMemoryRowInt64(row, " cheng_provider_compile_ms=", summary.chengProviderCompileMs)
    row = perfMemoryRowInt64(row, " c_provider_compile_ms=", summary.cProviderCompileMs)
    row = perfMemoryRowInt64(row, " provider_cache_hits=", summary.providerObjectCacheHitCount)
    row = perfMemoryRowInt64(row, " provider_cache_misses=", summary.providerObjectCacheMissCount)
    row = perfMemoryRowInt64(row, " primary_object_cache_lookup_ms=", summary.primaryObjectCacheLookupMs)
    row = perfMemoryRowInt64(row, " primary_object_cache_copy_ms=", summary.primaryObjectCacheCopyMs)
    row = perfMemoryRowInt64(row, " primary_object_cache_store_ms=", summary.primaryObjectCacheStoreMs)
    row = perfMemoryRowInt64(row, " primary_object_cache_hits=", summary.primaryObjectCacheHitCount)
    row = perfMemoryRowInt64(row, " primary_object_cache_misses=", summary.primaryObjectCacheMissCount)
    row = perfMemoryRowInt64(row, " primary_object_emit_ms=", summary.primaryObjectEmitMs)
    row = perfMemoryRowInt64(row, " primary_object_global_storage_ms=", summary.primaryObjectGlobalStorageMs)
    row = perfMemoryRowInt64(row, " primary_object_module_init_ms=", summary.primaryObjectModuleInitMs)
    row = perfMemoryRowInt64(row, " primary_object_function_emit_ms=", summary.primaryObjectFunctionEmitMs)
    row = perfMemoryRowInt64(row, " primary_object_entry_bridge_ms=", summary.primaryObjectEntryBridgeMs)
    row = perfMemoryRowInt64(row, " primary_object_line_map_embed_ms=", summary.primaryObjectLineMapEmbedMs)
    row = perfMemoryRowInt64(row, " primary_object_symbol_trailer_ms=", summary.primaryObjectSymbolTrailerMs)
    row = perfMemoryRowInt64(row, " primary_object_asm_write_ms=", summary.primaryObjectAsmWriteMs)
    row = perfMemoryRowInt64(row, " primary_object_asm_compile_ms=", summary.primaryObjectAsmCompileMs)
    row = perfMemoryRowInt64(row, " primary_object_asm_bytes=", summary.primaryObjectAsmBytes)
    row = perfMemoryRowInt64(row, " primary_object_line_map_asm_bytes=", summary.primaryObjectLineMapAsmBytes)
    row = perfMemoryRowInt64(row, " materialize_total_ms=", materializeMs)
    row = perfMemoryRowInt64(row, " native_link_ms=", summary.nativeLinkMs)
    row = perfMemoryRowInt64(row, " line_map_ms=", summary.lineMapMs)
    row = perfMemoryRowInt64(row, " attributed_ms=", attributedMs)
    row = perfMemoryRowInt64(row, " unattributed_gap_ms=", PerfMemoryCompileGapBreakdownMs(sample, summary))
    return row

fn PerfMemoryMeasureFileRun(root: str,
                              label: str,
                              filePath: str,
                              argv: str[],
                              envOverrides: str[],
                              workingDir: str,
                              timeoutSec: int32,
                              logPath: str): PerfMemoryRun =
    let timePath = "/usr/bin/time"
    system.Assert(chengpath.FileExistsNonEmpty(root, timePath), " perf memory: /usr/bin/time")
    let timedArgv: str[] = PerfMemoryTimedArgv(filePath, argv)
    let logged: hostops.LoggedRun = hostops.RunFileLogged(root,
                                                              label,
                                                              timePath,
                                                              timedArgv,
                                                              envOverrides,
                                                              workingDir,
                                                              timeoutSec,
                                                              logPath)
    var elapsedMs: int64 = int64(-1)
    var maxRssBytes: int64 = int64(-1)
    var peakFootprintBytes: int64 = int64(-1)
    PerfMemoryParseMetrics(logged.output, elapsedMs, maxRssBytes, peakFootprintBytes)
    return PerfMemoryRunNew(label,
                              logged.logPath,
                              logged.exitCode,
                              elapsedMs,
                              maxRssBytes,
                              peakFootprintBytes,
                              int64(-1),
                              logged.output)

fn PerfMemoryCompileExe(root: str,
                          label: str,
                          compilerPath: str,
                          target: str,
                          sourcePath: str,
                          outputPath: str,
                          timeoutSec: int32,
                          logPath: str): PerfMemoryRun =
    return PerfMemoryCompileExeWithEnv(root,
                                         label,
                                         compilerPath,
                                         target,
                                         sourcePath,
                                         outputPath,
                                         [],
                                         timeoutSec,
                                         logPath)

fn PerfMemoryCompileExeWithEnv(root: str,
                                 label: str,
                                 compilerPath: str,
                                 target: str,
                                 sourcePath: str,
                                 outputPath: str,
                                 envOverrides: str[],
                                 timeoutSec: int32,
                                 logPath: str): PerfMemoryRun =
    var sample = PerfMemoryMeasureFileRun(root,
                                           label,
                                           compilerPath,
                                           [
                                               "system-link-exec",
                                               PerfMemoryFlag("--root:", root),
                                               PerfMemoryFlag("--in:", sourcePath),
                                               "--emit:exe",
                                               PerfMemoryFlag("--target:", target),
                                               PerfMemoryFlag("--out:", outputPath),
                                               PerfMemoryFlag("--report-out:", PerfMemoryCompileReportPath(outputPath))
                                           ],
                                           envOverrides,
                                           root,
                                           timeoutSec,
                                           logPath)
    sample.outputFileSizeBytes = os.FileSize(outputPath)
    sample.compilerPath = compilerPath
    sample.target = target
    sample.fixturePath = sourcePath
    sample.sourceBytes = os.FileSize(sourcePath)
    let reportElapsedMs = PerfMemoryCompileReportElapsedMs(root, outputPath)
    if reportElapsedMs > int64(0):
        sample.elapsedMs = reportElapsedMs
    sample.throughputBytesPerMs = PerfMemoryThroughputBytesPerMs(sample.sourceBytes, sample.elapsedMs)
    return sample

fn PerfMemoryRunBinary(root: str,
                         label: str,
                         binaryPath: str,
                         argv: str[],
                         envOverrides: str[],
                         workingDir: str,
                         timeoutSec: int32,
                         logPath: str): PerfMemoryRun =
    var sample = PerfMemoryMeasureFileRun(root,
                                           label,
                                           binaryPath,
                                           argv,
                                           envOverrides,
                                           workingDir,
                                           timeoutSec,
                                           logPath)
    sample.outputFileSizeBytes = os.FileSize(binaryPath)
    return sample

fn PerfMemoryOutputFileSizeWithinThreshold(sample: PerfMemoryRun,
                                            threshold: PerfMemoryThreshold): bool =
    if threshold.maxOutputFileSizeBytes <= int64(0):
        return true
    if sample.outputFileSizeBytes < int64(0):
        return false
    if sample.outputFileSizeBytes > threshold.maxOutputFileSizeBytes:
        return false
    return true

fn PerfMemoryReportRow(sample: PerfMemoryRun,
                         threshold: PerfMemoryThreshold): str =
    var peakText = "-"
    if sample.peakFootprintBytes > int64(0):
        peakText = strings.Int64ToStr(sample.peakFootprintBytes)
    var row = sample.label
    row = perfMemoryRowInt64(row, " elapsed_ms=", sample.elapsedMs)
    row = perfMemoryRowInt64(row, " throughput_bytes_per_ms=", sample.throughputBytesPerMs)
    row = perfMemoryRowInt64(row, " max_rss_bytes=", sample.maxRssBytes)
    row = perfMemoryRowText(row, " peak_footprint_bytes=", peakText)
    row = perfMemoryRowInt64(row, " output_file_size_bytes=", sample.outputFileSizeBytes)
    row = perfMemoryRowText(row, " compiler_path=", sample.compilerPath)
    row = perfMemoryRowText(row, " target=", sample.target)
    row = perfMemoryRowText(row, " fixture_path=", sample.fixturePath)
    row = perfMemoryRowInt64(row, " source_bytes=", sample.sourceBytes)
    row = perfMemoryRowInt64(row, " limit_elapsed_ms=", threshold.maxElapsedMs)
    row = perfMemoryRowInt64(row, " limit_max_rss_bytes=", threshold.maxRssBytes)
    row = perfMemoryRowInt64(row, " limit_output_file_size_bytes=", threshold.maxOutputFileSizeBytes)
    row = perfMemoryRowInt32(row, " exit_code=", sample.exitCode)
    row = perfMemoryRowText(row, " log=", sample.logPath)
    return row

fn PerfMemoryStrictCompileReportRow(sample: PerfMemoryRun): str =
    var row = sample.label
    row = perfMemoryRowText(row, " compiler_path=", sample.compilerPath)
    row = perfMemoryRowText(row, " target=", sample.target)
    row = perfMemoryRowText(row, " fixture_path=", sample.fixturePath)
    row = perfMemoryRowInt64(row, " source_bytes=", sample.sourceBytes)
    row = perfMemoryRowInt64(row, " elapsed_ms=", sample.elapsedMs)
    row = perfMemoryRowInt64(row, " throughput_bytes_per_ms=", sample.throughputBytesPerMs)
    row = perfMemoryRowInt64(row, " output_file_size_bytes=", sample.outputFileSizeBytes)
    row = perfMemoryRowInt32(row, " exit_code=", sample.exitCode)
    row = perfMemoryRowText(row, " log=", sample.logPath)
    return row

fn PerfMemoryColdPureComparisonReportRow(result: PerfMemoryColdPureComparison): str =
    var row = result.label
    row = perfMemoryRowText(row, " cold_vs_pure_strict_gate=", PerfMemoryBoolIntText(result.ok))
    row = perfMemoryRowText(row, " target=", result.target)
    row = perfMemoryRowText(row, " fixture_path=", result.fixturePath)
    row = perfMemoryRowInt64(row, " source_bytes=", result.sourceBytes)
    row = perfMemoryRowText(row, " cold_compiler_path=", result.coldCompilerPath)
    row = perfMemoryRowText(row, " pure_compiler_path=", result.pureCompilerPath)
    row = perfMemoryRowInt64(row, " cold_elapsed_ms=", result.coldElapsedMs)
    row = perfMemoryRowInt64(row, " pure_elapsed_ms=", result.pureElapsedMs)
    row = perfMemoryRowInt64(row, " cold_throughput_bytes_per_ms=", result.coldThroughputBytesPerMs)
    row = perfMemoryRowInt64(row, " pure_throughput_bytes_per_ms=", result.pureThroughputBytesPerMs)
    row = perfMemoryRowInt64(row, " cold_output_file_size_bytes=", result.coldOutputBytes)
    row = perfMemoryRowInt64(row, " pure_output_file_size_bytes=", result.pureOutputBytes)
    row = perfMemoryRowInt32(row, " cold_exit_code=", result.coldExitCode)
    row = perfMemoryRowInt32(row, " pure_exit_code=", result.pureExitCode)
    return row

fn PerfMemoryRuntimeCBaselineThresholds(): runtimebase.RuntimeCBaselineThreshold[] =
    var out: runtimebase.RuntimeCBaselineThreshold[]
    add(out, runtimebase.RuntimeCBaselineOrcRetainReleaseThreshold())
    add(out, runtimebase.RuntimeCBaselineAtomicI32AddThreshold())
    add(out, runtimebase.RuntimeCBaselineThreadSpawnJoinThreshold())
    add(out, runtimebase.RuntimeCBaselineSliceBoundsLoopThreshold())
    add(out, runtimebase.RuntimeCBaselineHashLookupThreshold())
    add(out, runtimebase.RuntimeCBaselineSyscallWriteThreshold())
    return out

fn PerfMemoryRuntimeCBaselineUnavailableContract(reason: str): PerfMemoryRuntimeCBaselineContract =
    let thresholds = PerfMemoryRuntimeCBaselineThresholds()
    var rows: str[]
    for i in 0..<thresholds.len:
        add(rows, runtimebase.RuntimeCBaselineUnavailableReport(thresholds[i].caseName, reason))
    return PerfMemoryRuntimeCBaselineContract(ok: false,
                                               report: strutil.Join(rows, "\n"))

fn PerfMemoryRuntimeCBaselineSampleFromText(text: str,
                                             threshold: runtimebase.RuntimeCBaselineThreshold): runtimebase.RuntimeCBaselineSample =
    let cKey = strutil.Join([threshold.caseName, "_c_ns_per_op"], "")
    let chengKey = strutil.Join([threshold.caseName, "_cheng_ns_per_op"], "")
    let cNsPerOp = PerfMemoryParseOutputInt64(text, cKey)
    let chengNsPerOp = PerfMemoryParseOutputInt64(text, chengKey)
    return runtimebase.RuntimeCBaselineSampleNew(threshold.caseName,
                                                 cNsPerOp,
                                                 chengNsPerOp)

fn PerfMemoryRuntimeCBaselineContractFromText(text: str): PerfMemoryRuntimeCBaselineContract =
    let thresholds = PerfMemoryRuntimeCBaselineThresholds()
    var rows: str[]
    var ok = true
    for i in 0..<thresholds.len:
        let threshold = thresholds[i]
        let sample = PerfMemoryRuntimeCBaselineSampleFromText(text, threshold)
        if sample.cNsPerOp <= int64(0) || sample.chengNsPerOp < int64(0):
            add(rows, runtimebase.RuntimeCBaselineUnavailableReport(threshold.caseName,
                                                                    "missing_real_c_measurement"))
            ok = false
        else:
            add(rows, runtimebase.RuntimeCBaselineReportRow(sample, threshold))
            if !runtimebase.RuntimeCBaselineSampleOk(sample, threshold):
                ok = false
    return PerfMemoryRuntimeCBaselineContract(ok: ok,
                                               report: strutil.Join(rows, "\n"))

fn PerfMemoryRuntimeCBaselineContractFromFile(root: str,
                                               reportPathRaw: str): PerfMemoryRuntimeCBaselineContract =
    let reportPath = strutil.Strip(reportPathRaw)
    if len(reportPath) <= 0:
        return PerfMemoryRuntimeCBaselineUnavailableContract("missing_cheng_runtime_c_baseline_report")
    let absolutePath = chengpath.PathAbsolute(root, reportPath)
    let text = chengpath.ReadTextFile("", absolutePath)
    if len(strutil.Strip(text)) <= 0:
        return PerfMemoryRuntimeCBaselineUnavailableContract("empty_cheng_runtime_c_baseline_report")
    return PerfMemoryRuntimeCBaselineContractFromText(text)
