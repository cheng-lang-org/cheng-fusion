import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/strings
import std/strformat
import std/strutils as strutil
import cheng/core/tooling/compiler_execution_stage_receipt as execution_receipt
import cheng/core/tooling/compiler_execution_stage_receipt_wire as receipt_wire
import cheng/core/tooling/path as chengpath
import cheng/std/bytes_layout as layout

const
    SevenStageReceiptEnableFlag = "--seven-stage"
    SevenStageReceiptStageTypedExpr = "typed_expr"
    SevenStageReceiptStageCsg = "csg"
    SevenStageReceiptStageLowering = "lowering"
    SevenStageReceiptStagePrimary = "primary"
    SevenStageReceiptStagePrimaryRegalloc = "primary_regalloc"
    SevenStageReceiptStageBackend2 = "backend2"
    SevenStageReceiptStageBackend2Regalloc = "backend2_regalloc"
    SevenStageReceiptLaneShared = "shared"
    SevenStageReceiptLanePrimary = "primary"
    SevenStageReceiptLaneBackend2 = "backend2"

    sevenStageIdentitySourceBundlePath = "identity/source-bundle.bin"
    sevenStageIdentityMaterializerPath = "identity/materializer.bin"
    sevenStageIdentityGrammarObligationPath = "identity/grammar-obligation.bin"
    sevenStageIdentityCompilerSourceClosurePath = "identity/compiler-source-closure.bin"
    sevenStageIdentityDriverPath = "identity/driver.bin"
    sevenStageIdentityToolchainManifestPath = "identity/toolchain-manifest.bin"
    sevenStageIdentityCommandManifestPath = "identity/command-manifest.bin"
    sevenStageReceiptDocumentPath = "execution-stage-receipt.json"

type
    # A producer receives only this capability.  It cannot substitute a
    # textual/name-based identity for the execution identity installed by
    # compiler_main.
    SevenStageSourceIdentity =
        valid: bool
        sourceBundleCidRaw32: layout.FixedBytes32
        executionRaw32: layout.FixedBytes32

    SevenStagePendingObservation =
        stage: str
        lane: str
        producerSourcePath: str
        sidecarPath: str
        artifactPath: str
        producerByteLength: int32
        sidecarByteLength: int32
        artifactByteLength: int32
        producerRaw32: layout.FixedBytes32
        sidecarRaw32: layout.FixedBytes32
        artifactRaw32: layout.FixedBytes32

var
    sevenStageConfigured: bool
    sevenStageSealed: bool
    sevenStageFailure: str
    sevenStageSourceRoot: str
    sevenStageOutputRoot: str
    sevenStageSourceBundleCidHex: str
    sevenStageSourceBundleCidRaw32: layout.FixedBytes32
    sevenStageExecutionIdentity: execution_receipt.CompilerExecutionIdentity
    sevenStageParserReceiptRaw32: layout.FixedBytes32
    sevenStageParserSemanticRaw32: layout.FixedBytes32
    sevenStageValidator: execution_receipt.CompilerSevenStageReceiptValidator
    sevenStageReceipts: execution_receipt.ExecutionStageReceipt[]
    sevenStageProducerSourcePaths: str[]
    sevenStagePendingBackend2: SevenStagePendingObservation[]

fn SevenStageReceiptEnabled(): bool =
    for index in 0..<cmdline.ParamCount():
        let arg = cmdline.ParamStr(index)
        if arg == SevenStageReceiptEnableFlag ||
           arg == "--seven-stage:1" ||
           arg == "--seven-stage:true" ||
           arg == "--seven-stage:on":
            return true
    return false

fn SevenStageReceiptActive(): bool =
    return sevenStageConfigured && !sevenStageSealed &&
           len(sevenStageFailure) <= 0

@borrows
fn SevenStageReceiptLaneObjectPath(lane: str): str =
    if !SevenStageReceiptActive():
        return ""
    if lane != SevenStageReceiptLanePrimary &&
       lane != SevenStageReceiptLaneBackend2:
        return ""
    let ownedLane = strings.CloneStr(lane)
    return sevenStageJoinOutput(Fmt"stages/{ownedLane}.production-object.bin")

@borrows
fn sevenStageJoinOutput(relativePath: str): str =
    let ownedRoot = strings.CloneStr(sevenStageOutputRoot)
    let ownedRel = strings.CloneStr(relativePath)
    return chengpath.PathJoin(ownedRoot, ownedRel)

@borrows
fn sevenStageJoinSource(relativePath: str): str =
    let ownedRoot = strings.CloneStr(sevenStageSourceRoot)
    let ownedRel = strings.CloneStr(relativePath)
    return chengpath.PathAbsolute(ownedRoot, ownedRel)

fn sevenStageReadFlag(flagName: str): str =
    let colonPrefix = Fmt"{flagName}:"
    let equalsPrefix = Fmt"{flagName}="
    for index in 0..<cmdline.ParamCount():
        let arg = cmdline.ParamStr(index)
        if arg == flagName:
            if index + 1 < cmdline.ParamCount():
                return cmdline.ParamStr(index + 1)
            return ""
        if strutil.StartsWith(arg, colonPrefix) ||
           strutil.StartsWith(arg, equalsPrefix):
            return strings.SliceBytes(
                arg, len(flagName) + 1,
                len(arg) - len(flagName) - 1)
    return ""

@borrows
fn sevenStageObservedRaw32(text: str): Result[layout.FixedBytes32] =
    return execution_receipt.CompilerExecutionIdentityObservedRaw32(
        rawbytes.BytesFromString(text))

fn sevenStageReadRequired(path: str,
                          label: str,
                          out: var str): str =
    if len(path) <= 0:
        return Fmt" compiler: --seven-stage missing {label}"
    let readRes = os.ReadFileResult(path)
    if IsErr(readRes):
        return Fmt" compiler: --seven-stage cannot read {label}: {Error(readRes)}"
    out = Value(readRes)
    if len(out) <= 0:
        return Fmt" compiler: --seven-stage empty {label}"
    return ""

@borrows
fn sevenStageWriteObserved(relativePath: str,
                           bytes: rawbytes.Bytes): bool =
    if !SevenStageReceiptActive() ||
       rawbytes.BytesLen(bytes) <= 0:
        return false
    let ownedPath = strings.CloneStr(relativePath)
    let ownedRoot = strings.CloneStr(sevenStageOutputRoot)
    let absolutePath = chengpath.PathJoin(ownedRoot, ownedPath)
    return chengpath.WriteTextFile(
        "", absolutePath, rawbytes.BytesToString(bytes))

@borrows
fn sevenStageWriteIdentity(relativePath: str,
                           text: str): bool =
    return sevenStageWriteObserved(
        relativePath, rawbytes.BytesFromString(text))

fn sevenStageResetState() =
    sevenStageConfigured = false
    sevenStageSealed = false
    sevenStageFailure = ""
    sevenStageSourceRoot = ""
    sevenStageOutputRoot = ""
    sevenStageSourceBundleCidHex = ""
    sevenStageSourceBundleCidRaw32 = layout.FixedBytes32()
    sevenStageExecutionIdentity =
        execution_receipt.CompilerExecutionIdentity()
    sevenStageParserReceiptRaw32 = layout.FixedBytes32()
    sevenStageParserSemanticRaw32 = layout.FixedBytes32()
    sevenStageValidator =
        execution_receipt.CompilerSevenStageReceiptValidator()
    sevenStageReceipts = []
    sevenStageProducerSourcePaths = []
    sevenStagePendingBackend2 = []

@borrows
fn sevenStageCommandManifestValid(commandManifest: str,
                                  sourceBundleCidHex: str,
                                  backend2Epoch: str,
                                  targetTriple: str,
                                  jobs: int32): bool =
    if len(sourceBundleCidHex) != 64 ||
       len(backend2Epoch) != 64 ||
       jobs <= 0:
        return false
    let ingressExpected = "ingress=compiler_main"
    let sourceExpected =
        Fmt"source_bundle_cid={sourceBundleCidHex}"
    let backend2Expected = Fmt"backend2_epoch={backend2Epoch}"
    let targetExpected = Fmt"target={targetTriple}"
    let jobsExpected = Fmt"jobs={strings.IntToStr(jobs)}"
    var ingressCount: int32
    var sourceCount: int32
    var backend2Count: int32
    var targetCount: int32
    var jobsCount: int32
    let lines = strutil.Split(commandManifest, '\n')
    for index in 0..<lines.len:
        let line = lines[index]
        if strutil.StartsWith(line, "ingress="):
            if line != ingressExpected:
                return false
            ingressCount = ingressCount + 1
        elif strutil.StartsWith(line, "source_bundle_cid="):
            if line != sourceExpected:
                return false
            sourceCount = sourceCount + 1
        elif strutil.StartsWith(line, "backend2_epoch="):
            if line != backend2Expected:
                return false
            backend2Count = backend2Count + 1
        elif strutil.StartsWith(line, "target="):
            if line != targetExpected:
                return false
            targetCount = targetCount + 1
        elif strutil.StartsWith(line, "jobs="):
            if line != jobsExpected:
                return false
            jobsCount = jobsCount + 1
    return ingressCount == 1 &&
           sourceCount == 1 &&
           backend2Count == 1 &&
           targetCount == 1 &&
           jobsCount == 1

fn sevenStageConfigureObserved(
        sourceRoot: str,
        outputRoot: str,
        caseId: str,
        sourceBundleCidHex: str,
        sourceBundle: str,
        materializer: str,
        grammarObligation: str,
        compilerSourceClosure: str,
        driver: str,
        toolchainManifest: str,
        commandManifest: str,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        targetTriple: str): str =
    if sevenStageConfigured || sevenStageSealed:
        return " compiler: --seven-stage collector already initialized"
    if len(sourceRoot) <= 0 || len(outputRoot) <= 0 ||
       len(caseId) <= 0 || len(sourceBundleCidHex) != 64 ||
       len(targetTriple) <= 0:
        return " compiler: --seven-stage observed identity is incomplete"
    let sourceBundleCidRes =
        layout.FixedBytes32FromHex(sourceBundleCidHex)
    if IsErr(sourceBundleCidRes):
        return " compiler: --seven-stage source bundle CID is invalid"
    if os.FileExists(outputRoot) || os.DirExists(outputRoot):
        return " compiler: --seven-stage output must be a new path"
    let identityDir = chengpath.PathJoin(outputRoot, "identity")
    let producersDir = chengpath.PathJoin(outputRoot, "producers")
    let stagesDir = chengpath.PathJoin(outputRoot, "stages")
    os.MkdirAll(identityDir, 493)
    os.MkdirAll(producersDir, 493)
    os.MkdirAll(stagesDir, 493)
    if !os.DirExists(identityDir) ||
       !os.DirExists(producersDir) ||
       !os.DirExists(stagesDir):
        return " compiler: --seven-stage output directory creation failed"

    let sourceBundleRaw32Res = sevenStageObservedRaw32(sourceBundle)
    let materializerRaw32Res = sevenStageObservedRaw32(materializer)
    let grammarObligationRaw32Res =
        sevenStageObservedRaw32(grammarObligation)
    let compilerSourceClosureRaw32Res =
        sevenStageObservedRaw32(compilerSourceClosure)
    let driverRaw32Res = sevenStageObservedRaw32(driver)
    let toolchainManifestRaw32Res =
        sevenStageObservedRaw32(toolchainManifest)
    let commandManifestRaw32Res =
        sevenStageObservedRaw32(commandManifest)
    if IsErr(sourceBundleRaw32Res) ||
       IsErr(materializerRaw32Res) ||
       IsErr(grammarObligationRaw32Res) ||
       IsErr(compilerSourceClosureRaw32Res) ||
       IsErr(driverRaw32Res) ||
       IsErr(toolchainManifestRaw32Res) ||
       IsErr(commandManifestRaw32Res):
        return " compiler: --seven-stage identity observation failed"

    let identityRes = execution_receipt.CompilerExecutionIdentityMake(
        caseId,
        Value(sourceBundleRaw32Res),
        Value(materializerRaw32Res),
        Value(grammarObligationRaw32Res),
        Value(compilerSourceClosureRaw32Res),
        Value(driverRaw32Res),
        Value(toolchainManifestRaw32Res),
        Value(commandManifestRaw32Res),
        targetTriple)
    if IsErr(identityRes):
        return Error(identityRes)
    let validatorRes =
        execution_receipt.CompilerSevenStageReceiptValidatorInit(
            Value(identityRes),
            parserReceiptRaw32,
            parserSemanticRaw32)
    if IsErr(validatorRes):
        return Error(validatorRes)

    sevenStageSourceRoot = sourceRoot
    sevenStageOutputRoot = outputRoot
    sevenStageSourceBundleCidHex = sourceBundleCidHex
    sevenStageSourceBundleCidRaw32 = Value(sourceBundleCidRes)
    sevenStageExecutionIdentity = Value(identityRes)
    sevenStageParserReceiptRaw32 = parserReceiptRaw32
    sevenStageParserSemanticRaw32 = parserSemanticRaw32
    sevenStageValidator = Value(validatorRes)
    sevenStageConfigured = true
    if !sevenStageWriteIdentity(
           sevenStageIdentitySourceBundlePath, sourceBundle) ||
       !sevenStageWriteIdentity(
           sevenStageIdentityMaterializerPath, materializer) ||
       !sevenStageWriteIdentity(
           sevenStageIdentityGrammarObligationPath,
           grammarObligation) ||
       !sevenStageWriteIdentity(
           sevenStageIdentityCompilerSourceClosurePath,
           compilerSourceClosure) ||
       !sevenStageWriteIdentity(
           sevenStageIdentityDriverPath, driver) ||
       !sevenStageWriteIdentity(
           sevenStageIdentityToolchainManifestPath,
           toolchainManifest) ||
       !sevenStageWriteIdentity(
           sevenStageIdentityCommandManifestPath,
           commandManifest):
        sevenStageFailure =
            " compiler: --seven-stage identity evidence write failed"
        return sevenStageFailure
    return ""

@borrows
fn SevenStageReceiptValidateConfig(
        sourceRoot: str,
        targetTriple: str,
        jobs: int32): str =
    if !SevenStageReceiptEnabled():
        return ""
    sevenStageResetState()
    let outputRoot = sevenStageReadFlag("--seven-stage-out")
    let caseId = sevenStageReadFlag("--seven-stage-case")
    let sourceBundleCidHex =
        sevenStageReadFlag("--seven-stage-source-bundle-cid")
    let sourceBundlePath =
        sevenStageReadFlag("--seven-stage-source-manifest")
    let materializerPath =
        sevenStageReadFlag("--seven-stage-materializer")
    let grammarObligationPath =
        sevenStageReadFlag("--seven-stage-grammar-obligation")
    let compilerSourceClosurePath =
        sevenStageReadFlag("--seven-stage-compiler-source-closure")
    let driverPath = sevenStageReadFlag("--seven-stage-driver")
    let toolchainManifestPath =
        sevenStageReadFlag("--seven-stage-toolchain-manifest")
    let commandManifestPath =
        sevenStageReadFlag("--seven-stage-command-manifest")
    let backend2Epoch =
        sevenStageReadFlag("--seven-stage-backend2-epoch")
    let parserReceiptHex =
        sevenStageReadFlag("--seven-stage-parser-receipt")
    let parserSemanticHex =
        sevenStageReadFlag("--seven-stage-parser-semantic")

    var sourceBundle = ""
    var materializer = ""
    var grammarObligation = ""
    var compilerSourceClosure = ""
    var driver = ""
    var toolchainManifest = ""
    var commandManifest = ""
    let sourceBundleReadErr = sevenStageReadRequired(
        sourceBundlePath, "source manifest", sourceBundle)
    if len(sourceBundleReadErr) > 0:
        return sourceBundleReadErr
    let materializerReadErr = sevenStageReadRequired(
        materializerPath, "materializer", materializer)
    if len(materializerReadErr) > 0:
        return materializerReadErr
    let grammarObligationReadErr = sevenStageReadRequired(
        grammarObligationPath,
        "grammar obligation", grammarObligation)
    if len(grammarObligationReadErr) > 0:
        return grammarObligationReadErr
    let compilerSourceClosureReadErr = sevenStageReadRequired(
        compilerSourceClosurePath,
        "compiler source closure", compilerSourceClosure)
    if len(compilerSourceClosureReadErr) > 0:
        return compilerSourceClosureReadErr
    let driverReadErr = sevenStageReadRequired(
        driverPath, "driver", driver)
    if len(driverReadErr) > 0:
        return driverReadErr
    let toolchainManifestReadErr = sevenStageReadRequired(
        toolchainManifestPath,
        "toolchain manifest", toolchainManifest)
    if len(toolchainManifestReadErr) > 0:
        return toolchainManifestReadErr
    let commandManifestReadErr = sevenStageReadRequired(
        commandManifestPath,
        "command manifest", commandManifest)
    if len(commandManifestReadErr) > 0:
        return commandManifestReadErr
    if !sevenStageCommandManifestValid(
           commandManifest, sourceBundleCidHex, backend2Epoch,
           targetTriple, jobs):
        return " compiler: --seven-stage command manifest identity mismatch"
    let parserReceiptRes =
        layout.FixedBytes32FromHex(parserReceiptHex)
    let parserSemanticRes =
        layout.FixedBytes32FromHex(parserSemanticHex)
    if IsErr(parserReceiptRes) || IsErr(parserSemanticRes):
        return " compiler: --seven-stage parser roots must be exact raw32 hex"
    return sevenStageConfigureObserved(
        strings.CloneStr(sourceRoot),
        chengpath.PathAbsolute(sourceRoot, outputRoot),
        caseId,
        sourceBundleCidHex,
        sourceBundle,
        materializer,
        grammarObligation,
        compilerSourceClosure,
        driver,
        toolchainManifest,
        commandManifest,
        Value(parserReceiptRes),
        Value(parserSemanticRes),
        strings.CloneStr(targetTriple))

fn SevenStageSourceIdentityResolve(
        sourceBundleCidHex: str): SevenStageSourceIdentity =
    var out: SevenStageSourceIdentity
    if !SevenStageReceiptActive() ||
       sourceBundleCidHex != sevenStageSourceBundleCidHex:
        return out
    out.valid = true
    out.sourceBundleCidRaw32 = sevenStageSourceBundleCidRaw32
    out.executionRaw32 = sevenStageExecutionIdentity.executionRaw32
    return out

fn SevenStageSourceIdentityCurrent(): SevenStageSourceIdentity =
    var out: SevenStageSourceIdentity
    if !SevenStageReceiptActive():
        return out
    out.valid = true
    out.sourceBundleCidRaw32 = sevenStageSourceBundleCidRaw32
    out.executionRaw32 = sevenStageExecutionIdentity.executionRaw32
    return out

fn SevenStageCompilerExecutionIdentityCurrent(
        out: var execution_receipt.CompilerExecutionIdentity,
        err: var str): bool =
    if !SevenStageReceiptActive():
        err = " compiler: canonical compiler execution identity is inactive"
        return false
    let verified =
        execution_receipt.CompilerExecutionIdentityVerify(
            sevenStageExecutionIdentity)
    if IsErr(verified):
        err = Error(verified)
        return false
    out = sevenStageExecutionIdentity
    err = ""
    return true

fn sevenStageExpectedPredecessorRaw32(
        ordinal: int32): layout.FixedBytes32 =
    if ordinal == 1:
        return layout.FixedBytes32Copy(
            sevenStageParserReceiptRaw32)
    if ordinal == 2:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[0].receiptRaw32)
    if ordinal == 3:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[1].receiptRaw32)
    if ordinal == 4:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[2].receiptRaw32)
    if ordinal == 5:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[3].receiptRaw32)
    if ordinal == 6:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[2].receiptRaw32)
    if ordinal == 7:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[5].receiptRaw32)
    return layout.FixedBytes32()

fn sevenStageExpectedInputSemanticRaw32(
        ordinal: int32): layout.FixedBytes32 =
    if ordinal == 1:
        return layout.FixedBytes32Copy(
            sevenStageParserSemanticRaw32)
    if ordinal == 2:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[0].outputSemanticRaw32)
    if ordinal == 3:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[1].outputSemanticRaw32)
    if ordinal == 4:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[2].outputSemanticRaw32)
    if ordinal == 5:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[3].outputSemanticRaw32)
    if ordinal == 6:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[2].outputSemanticRaw32)
    if ordinal == 7:
        return layout.FixedBytes32Copy(
            sevenStageReceipts[5].outputSemanticRaw32)
    return layout.FixedBytes32()

@borrows
fn sevenStageCommitObserved(
        stage: str,
        lane: str,
        producerEvidencePath: str,
        producerBytes: rawbytes.Bytes,
        sidecarPath: str,
        sidecarBytes: rawbytes.Bytes,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes): bool =
    let ordinal =
        execution_receipt.ExecutionStageReceiptStageOrdinal(stage)
    if ordinal != sevenStageReceipts.len + 1:
        sevenStageFailure =
            " compiler: seven-stage stage missing or out of order"
        return false
    let receiptRes =
        execution_receipt.ExecutionStageReceiptMakeObserved(
            sevenStageExecutionIdentity,
            stage,
            lane,
            producerBytes,
            execution_receipt.ExecutionStageReceiptPredecessorExpected(
                stage),
            sevenStageExpectedPredecessorRaw32(ordinal),
            sevenStageExpectedInputSemanticRaw32(ordinal),
            sidecarPath,
            sidecarBytes,
            artifactPath,
            artifactBytes)
    if IsErr(receiptRes):
        sevenStageFailure = Error(receiptRes)
        return false
    let observeRes =
        execution_receipt.CompilerSevenStageReceiptValidatorObserve(
            sevenStageValidator,
            sevenStageExecutionIdentity,
            Value(receiptRes),
            producerBytes,
            sidecarBytes,
            artifactBytes)
    if IsErr(observeRes):
        sevenStageFailure = Error(observeRes)
        return false
    add(sevenStageReceipts, Value(receiptRes))
    add(sevenStageProducerSourcePaths,
        strings.CloneStr(producerEvidencePath))
    return true

@borrows
fn sevenStagePendingRaw32Matches(
        text: str,
        expectedLength: int32,
        expectedRaw32: layout.FixedBytes32): bool =
    if len(text) != expectedLength:
        return false
    let observedRes = sevenStageObservedRaw32(text)
    return IsOk(observedRes) &&
           layout.FixedBytes32Equal(
               Value(observedRes), expectedRaw32)

fn sevenStageFlushPendingBackend2(): bool =
    if sevenStageReceipts.len != 5 ||
       sevenStagePendingBackend2.len != 2:
        sevenStageFailure =
            " compiler: seven-stage backend2 observations incomplete"
        return false
    for index in 0..<sevenStagePendingBackend2.len:
        let producerPath = strings.CloneStr(
            sevenStagePendingBackend2[index].producerSourcePath)
        let sidecarPath = strings.CloneStr(
            sevenStagePendingBackend2[index].sidecarPath)
        let artifactPath = strings.CloneStr(
            sevenStagePendingBackend2[index].artifactPath)
        let stage = strings.CloneStr(sevenStagePendingBackend2[index].stage)
        let lane = strings.CloneStr(sevenStagePendingBackend2[index].lane)
        var producerRes = os.ReadFileResult(sevenStageJoinOutput(producerPath))
        if IsErr(producerRes):
            sevenStageFailure =
                " compiler: seven-stage pending backend2 artifact unavailable"
            return false
        var sidecarRes = os.ReadFileResult(sevenStageJoinOutput(sidecarPath))
        if IsErr(sidecarRes):
            sevenStageFailure =
                " compiler: seven-stage pending backend2 artifact unavailable"
            return false
        var artifactRes = os.ReadFileResult(sevenStageJoinOutput(artifactPath))
        if IsErr(artifactRes):
            sevenStageFailure =
                " compiler: seven-stage pending backend2 artifact unavailable"
            return false
        let producerText = Value(producerRes)
        let sidecarText = Value(sidecarRes)
        let artifactText = Value(artifactRes)
        if !sevenStagePendingRaw32Matches(
               producerText,
               sevenStagePendingBackend2[index].producerByteLength,
               sevenStagePendingBackend2[index].producerRaw32) ||
           !sevenStagePendingRaw32Matches(
               sidecarText,
               sevenStagePendingBackend2[index].sidecarByteLength,
               sevenStagePendingBackend2[index].sidecarRaw32) ||
           !sevenStagePendingRaw32Matches(
               artifactText,
               sevenStagePendingBackend2[index].artifactByteLength,
               sevenStagePendingBackend2[index].artifactRaw32):
            sevenStageFailure =
                " compiler: seven-stage pending backend2 artifact changed"
            return false
        if !sevenStageCommitObserved(
               stage,
               lane,
               producerPath,
               rawbytes.BytesFromString(producerText),
               sidecarPath,
               rawbytes.BytesFromString(sidecarText),
               artifactPath,
               rawbytes.BytesFromString(artifactText)):
            return false
    sevenStagePendingBackend2 = []
    return true

@borrows
fn SevenStageReceiptObserve(
        stage: str,
        lane: str,
        identity: var SevenStageSourceIdentity,
        producerSourcePath: str,
        sidecarBytes: rawbytes.Bytes,
        artifactBytes: rawbytes.Bytes): bool =
    if !SevenStageReceiptActive() || !identity.valid ||
       !layout.FixedBytes32Equal(
           identity.sourceBundleCidRaw32,
           sevenStageSourceBundleCidRaw32) ||
       !layout.FixedBytes32Equal(
           identity.executionRaw32,
           sevenStageExecutionIdentity.executionRaw32):
        sevenStageFailure =
            " compiler: seven-stage source identity drift"
        return false
    let ordinal =
        execution_receipt.ExecutionStageReceiptStageOrdinal(stage)
    if ordinal <= 0 ||
       lane != execution_receipt.ExecutionStageReceiptLaneExpected(stage) ||
       rawbytes.BytesLen(sidecarBytes) <= 0 ||
       rawbytes.BytesLen(artifactBytes) <= 0:
        sevenStageFailure =
            " compiler: seven-stage producer observation invalid"
        return false
    let ownedProducerPath = strings.CloneStr(producerSourcePath)
    let producerAbsolutePath = sevenStageJoinSource(ownedProducerPath)
    let producerReadRes = os.ReadFileResult(producerAbsolutePath)
    if IsErr(producerReadRes) || len(Value(producerReadRes)) <= 0:
        sevenStageFailure =
            " compiler: seven-stage producer source unavailable"
        return false
    let producerBytes = rawbytes.BytesFromString(Value(producerReadRes))
    let stagePrefix =
        Fmt"stages/{strings.IntToStr(ordinal)}-{stage}"
    let sidecarPath = Fmt"{stagePrefix}.semantic.bin"
    let artifactPath = Fmt"{stagePrefix}.artifact.bin"
    let producerEvidencePath =
        Fmt"producers/{strings.IntToStr(ordinal)}-{stage}.cheng"
    if !sevenStageWriteObserved(sidecarPath, sidecarBytes) ||
       !sevenStageWriteObserved(artifactPath, artifactBytes) ||
       !sevenStageWriteObserved(producerEvidencePath, producerBytes):
        sevenStageFailure =
            " compiler: seven-stage observed byte write failed"
        return false

    # backend2 consumes the pristine lowering plan before primary is allowed
    # to materialize/release lazy rows.  Its bytes remain transaction-local
    # and are admitted only after stages four and five have been observed.
    if ordinal == 6 || ordinal == 7:
        if sevenStageReceipts.len != 3 ||
           ordinal != 6 + sevenStagePendingBackend2.len:
            sevenStageFailure =
                " compiler: seven-stage backend2 transaction order invalid"
            return false
        let producerRaw32Res =
            execution_receipt.CompilerExecutionIdentityObservedRaw32(
                producerBytes)
        let sidecarRaw32Res =
            execution_receipt.CompilerExecutionIdentityObservedRaw32(
                sidecarBytes)
        let artifactRaw32Res =
            execution_receipt.CompilerExecutionIdentityObservedRaw32(
                artifactBytes)
        if IsErr(producerRaw32Res) ||
           IsErr(sidecarRaw32Res) ||
           IsErr(artifactRaw32Res):
            sevenStageFailure =
                " compiler: seven-stage backend2 observation hash failed"
            return false
        var pending: SevenStagePendingObservation
        pending.stage = strings.CloneStr(stage)
        pending.lane = strings.CloneStr(lane)
        pending.producerSourcePath = producerEvidencePath
        pending.sidecarPath = sidecarPath
        pending.artifactPath = artifactPath
        pending.producerByteLength = rawbytes.BytesLen(producerBytes)
        pending.sidecarByteLength = rawbytes.BytesLen(sidecarBytes)
        pending.artifactByteLength = rawbytes.BytesLen(artifactBytes)
        pending.producerRaw32 = Value(producerRaw32Res)
        pending.sidecarRaw32 = Value(sidecarRaw32Res)
        pending.artifactRaw32 = Value(artifactRaw32Res)
        add(sevenStagePendingBackend2, pending)
        return true
    if ordinal != sevenStageReceipts.len + 1 ||
       !sevenStageCommitObserved(
           stage,
           lane,
           producerEvidencePath,
           producerBytes,
           sidecarPath,
           sidecarBytes,
           artifactPath,
           artifactBytes):
        return false
    if ordinal == 5:
        return sevenStageFlushPendingBackend2()
    return true

@borrows
fn sevenStageIdentityOwnedCopy(
        identity: execution_receipt.CompilerExecutionIdentity): execution_receipt.CompilerExecutionIdentity =
    var out: execution_receipt.CompilerExecutionIdentity
    out.caseId = strings.CloneStr(identity.caseId)
    out.sourceBundleRaw32 = identity.sourceBundleRaw32
    out.materializerBytesRaw32 = identity.materializerBytesRaw32
    out.grammarObligationRootRaw32 = identity.grammarObligationRootRaw32
    out.compilerSourceClosureRaw32 = identity.compilerSourceClosureRaw32
    out.driverBytesRaw32 = identity.driverBytesRaw32
    out.toolchainManifestRaw32 = identity.toolchainManifestRaw32
    out.commandManifestRaw32 = identity.commandManifestRaw32
    out.targetTriple = strings.CloneStr(identity.targetTriple)
    out.executionRaw32 = identity.executionRaw32
    return out

@borrows
fn sevenStageReceiptOwnedCopy(
        receipt: execution_receipt.ExecutionStageReceipt): execution_receipt.ExecutionStageReceipt =
    var out: execution_receipt.ExecutionStageReceipt
    out.stageOrdinal = receipt.stageOrdinal
    out.stageKind = strings.CloneStr(receipt.stageKind)
    out.laneKind = strings.CloneStr(receipt.laneKind)
    out.producerSourceRaw32 = receipt.producerSourceRaw32
    out.executionRaw32 = receipt.executionRaw32
    out.predecessorStageKind = strings.CloneStr(receipt.predecessorStageKind)
    out.predecessorReceiptRaw32 = receipt.predecessorReceiptRaw32
    out.inputSemanticRaw32 = receipt.inputSemanticRaw32
    out.outputSemanticRaw32 = receipt.outputSemanticRaw32
    out.sidecarSchema = strings.CloneStr(receipt.sidecarSchema)
    out.sidecarPath = strings.CloneStr(receipt.sidecarPath)
    out.sidecarByteLength = receipt.sidecarByteLength
    out.sidecarBytesRaw32 = receipt.sidecarBytesRaw32
    out.artifactKind = strings.CloneStr(receipt.artifactKind)
    out.artifactPath = strings.CloneStr(receipt.artifactPath)
    out.artifactByteLength = receipt.artifactByteLength
    out.artifactBytesRaw32 = receipt.artifactBytesRaw32
    out.receiptRaw32 = receipt.receiptRaw32
    return out

fn SevenStageReceiptFinalize(): str =
    if !SevenStageReceiptEnabled():
        return ""
    if !sevenStageConfigured:
        return " compiler: seven-stage collector was not initialized"
    if len(sevenStageFailure) > 0:
        return strings.CloneStr(sevenStageFailure)
    if sevenStageReceipts.len != 7:
        return " compiler: seven-stage observed stage count is not seven"
    var validator =
        execution_receipt.CompilerSevenStageReceiptValidator()
    validator.active = sevenStageValidator.active
    validator.executionRaw32 = sevenStageValidator.executionRaw32
    validator.parserReceiptRaw32 = sevenStageValidator.parserReceiptRaw32
    validator.parserSemanticRaw32 = sevenStageValidator.parserSemanticRaw32
    validator.nextStageOrdinal = sevenStageValidator.nextStageOrdinal
    for index in 0..<sevenStageValidator.stageReceiptRaw32s.len:
        add(validator.stageReceiptRaw32s,
            sevenStageValidator.stageReceiptRaw32s[index])
    for index in 0..<sevenStageValidator.stageOutputSemanticRaw32s.len:
        add(validator.stageOutputSemanticRaw32s,
            sevenStageValidator.stageOutputSemanticRaw32s[index])
    let rootRes =
        execution_receipt.CompilerSevenStageReceiptValidatorFinalize(
            validator)
    if IsErr(rootRes):
        return strings.CloneStr(Error(rootRes))
    let observedPaths =
        receipt_wire.CompilerExecutionObservedPathsMake(
            sevenStageIdentitySourceBundlePath,
            sevenStageIdentityMaterializerPath,
            sevenStageIdentityGrammarObligationPath,
            sevenStageIdentityCompilerSourceClosurePath,
            sevenStageIdentityDriverPath,
            sevenStageIdentityToolchainManifestPath,
            sevenStageIdentityCommandManifestPath)
    var producerPaths: str[]
    for pathIndex in 0..<sevenStageProducerSourcePaths.len:
        add(producerPaths, strings.CloneStr(sevenStageProducerSourcePaths[pathIndex]))
    var stageReceipts: execution_receipt.ExecutionStageReceipt[]
    for receiptIndex in 0..<sevenStageReceipts.len:
        let receipt = sevenStageReceipts[receiptIndex]
        add(stageReceipts, sevenStageReceiptOwnedCopy(receipt))
    let identity = sevenStageIdentityOwnedCopy(sevenStageExecutionIdentity)
    let wireRes =
        receipt_wire.CompilerExecutionStageBundleCanonicalJson(
            identity,
            observedPaths,
            sevenStageParserReceiptRaw32,
            sevenStageParserSemanticRaw32,
            stageReceipts,
            producerPaths,
            Value(rootRes))
    if IsErr(wireRes):
        return strings.CloneStr(Error(wireRes))
    let receiptFinalPath = sevenStageJoinOutput(sevenStageReceiptDocumentPath)
    let receiptPendingPath = sevenStageJoinOutput(
        ".execution-stage-receipt.pending")
    if os.FileExists(receiptFinalPath) ||
       os.FileExists(receiptPendingPath) ||
       !chengpath.WriteTextFile(
           "", receiptPendingPath, Value(wireRes)) ||
       !os.RenamePath(receiptPendingPath, receiptFinalPath):
        return " compiler: seven-stage canonical receipt write failed"
    sevenStageSealed = true
    return ""
