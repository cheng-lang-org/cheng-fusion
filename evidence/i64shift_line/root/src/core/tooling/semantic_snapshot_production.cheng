    return true

fn SemanticSnapshotProductionStoreReleasePinInto(
        store: var SemanticSnapshotProductionStore,
        pin: var SemanticSnapshotProductionPin,
        err: var str): bool =
    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    let snapshotIndex = pin.corePin.snapshotIndex
    if payloadIndex != pin.payloadIndex ||
       !snapshot_core.SemanticSnapshotStoreReleasePinInto(
            store.core, pin.corePin, err):
        return false
    if store.core.states[snapshotIndex] ==
           snapshot_core.SemanticSnapshotStateReleased:
        store.payloadStates[payloadIndex] =
            SemanticSnapshotProductionPayloadPendingReclaim
        semanticSnapshotProductionReleasePayloadForSnapshot(
            store, snapshotIndex)
    pin = SemanticSnapshotProductionPin()
    err = ""
    return true

fn SemanticSnapshotProductionStoreReleaseInto(
        store: var SemanticSnapshotProductionStore,
        err: var str): bool =
    if !semanticSnapshotProductionStoreShapeValidNoAlloc(store):
        err = " semantic snapshot production store: invalid release shape"
        return false
    for snapshotIndex in 0..<store.core.borrowCounts.len:
        if store.core.borrowCounts[snapshotIndex] != 0:
            err = " semantic snapshot production store: active pin at release"
            return false
    for payloadIndex in 0..<store.payloadCsgcBytes.len:
        rawbytes.BytesFree(store.payloadCsgcBytes[payloadIndex])
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            store.payloadTables[payloadIndex].declarations)
    for rejectionIndex in 0..<store.rejectionCsgcBytes.len:
        rawbytes.BytesFree(store.rejectionCsgcBytes[rejectionIndex])
        var failureFactsReleaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            store.rejectionFacts[rejectionIndex],
            failureFactsReleaseReceipt)
    store = SemanticSnapshotProductionStore()
    err = ""
    return true

fn SemanticSnapshotProductionCandidateRelease(
        candidate: var SemanticSnapshotProductionCandidate) =
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(candidate.cargo)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        candidate.tables.declarations)
    candidate = SemanticSnapshotProductionCandidate()
