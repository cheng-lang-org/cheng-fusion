    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    var bundle: debug_facts.DebugFactBundle
    if !debug_facts.DebugFactsFromSemanticSnapshotInto(
            store.payloadTables[payloadIndex],
            store.payloadIdentities[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadValidations[payloadIndex],
            store.payloadTables[payloadIndex].predecessorReceiptCid,
            store.payloadPackageIds[payloadIndex], bundle, err):
