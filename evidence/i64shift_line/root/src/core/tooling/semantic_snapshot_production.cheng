        return false
    out = bundle
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionPinnedDebugFactsInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        out: var debug_facts.DebugFactBundle,
