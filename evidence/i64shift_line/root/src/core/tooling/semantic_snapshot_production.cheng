import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_snapshot_builder as snapshot_builder
import cheng/core/tooling/compiler_execution_stage_receipt as execution
import cheng/core/tooling/compiler_world as cworld
import cheng/core/lang/parser
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/csg_core/compiler_snapshot_cargo as snapshot_cargo
import cheng/core/tooling/semantic_snapshot as snapshot_core
import cheng/core/tooling/semantic_snapshot_query_projection as query_projection
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration
import cheng/core/backend/compiler_facts
import cheng/core/backend/semantic_facts
import cheng/core/backend/debug_facts

const
    SemanticSnapshotProductionPayloadStaged: int32 = 1
    SemanticSnapshotProductionPayloadLive: int32 = 2
    SemanticSnapshotProductionPayloadPendingReclaim: int32 = 3
    SemanticSnapshotProductionPayloadReleased: int32 = 4
    SemanticSnapshotProductionRejectionStaged: int32 = 1
    SemanticSnapshotProductionRejectionCommitted: int32 = 2
    SemanticSnapshotProductionFailureAdmissionGap: int32 = 1
    SemanticSnapshotProductionJobQueued: int32 = 1
    SemanticSnapshotProductionJobRunning: int32 = 2
    SemanticSnapshotProductionJobCancelled: int32 = 3
    SemanticSnapshotProductionJobCompletionAdmitted: int32 = 4
    SemanticSnapshotProductionJobPublished: int32 = 5
    SemanticSnapshotProductionJobRejected: int32 = 6
    SemanticSnapshotProductionJobCompletionCancelled: int32 = 1
    SemanticSnapshotProductionJobCompletionLate: int32 = 2
    SemanticSnapshotProductionJobCompletionDuplicate: int32 = 3

type
    SemanticSnapshotCompilerPredecessorReceipt =
        sourceIdentityReceiptCid: layout.FixedBytes32
        compilerCsgTransitionReceiptCid: layout.FixedBytes32
        sourceGraphCid: layout.FixedBytes32
        canonicalSourceGraphCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerExecutionCid: layout.FixedBytes32
        compilerPackageCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        receiptCid: layout.FixedBytes32

    SemanticSnapshotProductionCandidate =
        predecessor: SemanticSnapshotCompilerPredecessorReceipt
        identity: snapshot_core.PortableSemanticSnapshotIdentity
        binding: snapshot_core.LocalSourceVersionBinding
        validation: snapshot_core.SemanticSnapshotValidationReceipt
        tables: snapshot_schema.CsgCompilerSnapshotTables
        cargo: snapshot_cargo.CsgCompilerSnapshotCargo
        queryProjection: query_projection.SemanticSnapshotQueryProjection

    # Snapshot rows and payload rows are stable int32 indexes. The semantic
    # tables remain Arena/SoA; queries never receive mutable table owners.
    SemanticSnapshotProductionStore =
        core: snapshot_core.SemanticSnapshotStore
        payloadIndexesBySnapshot: int32[]
        payloadStates: int32[]
        payloadSnapshotIndexes: int32[]
        payloadSourceVersions: int64[]
        payloadBindingReceiptCids: layout.FixedBytes32[]
        payloadSemanticSnapshotCids: layout.FixedBytes32[]
        payloadFactsRootCids: layout.FixedBytes32[]
        payloadCargoCids: layout.FixedBytes32[]
        payloadCompilerFactProjectionCids: layout.FixedBytes32[]
        payloadCompilerFactCounts: int32[]
        payloadSemanticFactProjectionCids: layout.FixedBytes32[]
        payloadSemanticFactCounts: int32[]
        payloadDebugFactProjectionCids: layout.FixedBytes32[]
        payloadDebugFactCounts: int32[]
        payloadQueryProjectionCids: layout.FixedBytes32[]
        payloadQueryIndexCids: layout.FixedBytes32[]
        payloadQueryIndexRootCids: layout.FixedBytes32[]
        payloadDeclarationTableCids: layout.FixedBytes32[]
        payloadPackageIds: str[]
        payloadIdentities: snapshot_core.PortableSemanticSnapshotIdentity[]
        payloadBindings: snapshot_core.LocalSourceVersionBinding[]
        payloadValidations: snapshot_core.SemanticSnapshotValidationReceipt[]
        payloadTables: snapshot_schema.CsgCompilerSnapshotTables[]
        payloadQueryProjections: query_projection.SemanticSnapshotQueryProjection[]
        payloadCsgcBytes: rawbytes.Bytes[]
        rejectionStates: int32[]
        rejectionSnapshotIndexes: int32[]
        rejectionSourceVersions: int64[]
        rejectionFactsRootCids: layout.FixedBytes32[]
        rejectionCargoCids: layout.FixedBytes32[]
        rejectionDiagnosticRootCids: layout.FixedBytes32[]
        rejectionIdentities: snapshot_core.PortableSemanticSnapshotIdentity[]
        rejectionBindings: snapshot_core.LocalSourceVersionBinding[]
        rejectionReceipts: snapshot_core.SemanticSnapshotFailureReceipt[]
        rejectionFacts: snapshot_cargo.CsgCompilerSnapshotFailureFacts[]
        rejectionCsgcBytes: rawbytes.Bytes[]

    SemanticSnapshotProductionPin =
        corePin: snapshot_core.SemanticSnapshotPin
        payloadIndex: int32
        semanticSnapshotCid: layout.FixedBytes32
        factsRootCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        queryIndexRootCid: layout.FixedBytes32
        active: bool

    SemanticSnapshotProductionRejectedDiagnostics =
        sourceVersion: int64
        semanticSnapshotCid: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32
        factsRootCid: layout.FixedBytes32
        cargoCid: layout.FixedBytes32
        diagnosticRootCid: layout.FixedBytes32
        facts: snapshot_cargo.CsgCompilerSnapshotFailureFacts

    # The ticket is the only logical identity crossing the worker boundary.
    # Physical thread contexts may use the runtime's opaque thread handle, but
    # no pointer, source line, path or name participates in admission.
    SemanticSnapshotProductionJobTicket =
        workspaceSessionCid: layout.FixedBytes32
        schemaVersion: int32
        semanticEpoch: int64
        sourceVersion: int64
        changedDocumentRows: int32[]
        changedDocumentCids: layout.FixedBytes32[]
        changedDocumentEventSourceVersions: int64[]
        changedDocumentEventKinds: int32[]
        changedDocumentPresenceStates: int32[]
        changedDocumentRenamePeerRows: int32[]
        changedDocumentEventCids: layout.FixedBytes32[]
        sourceEventStateReceiptCid: layout.FixedBytes32
        predecessorSourceVersion: int64
        predecessorBindingReceiptCid: layout.FixedBytes32
        predecessorSemanticSnapshotCid: layout.FixedBytes32
        predecessorFactsRootCid: layout.FixedBytes32
        predecessorCargoCid: layout.FixedBytes32
        predecessorDeclarationTableCid: layout.FixedBytes32
        predecessorQueryIndexRootCid: layout.FixedBytes32
        admittedCompletionAuthorityCid: layout.FixedBytes32
        jobCid: layout.FixedBytes32
        state: int32

    SemanticSnapshotProductionJobCompletionRejection =
        jobCid: layout.FixedBytes32
        sourceVersion: int64
        observedCurrentSourceVersion: int64
        completionAuthorityCid: layout.FixedBytes32
        reasonKind: int32
        receiptCid: layout.FixedBytes32

fn semanticSnapshotProductionAppendU32(buf: var layout.ByteBuf,
                                        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn semanticSnapshotProductionAppendI64(buf: var layout.ByteBuf,
                                        value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 56) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 48) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 40) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 32) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 24) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & int64(255)))
    layout.ByteBufAppendByte(buf, int32(value & int64(255)))

fn semanticSnapshotProductionAppendText(buf: var layout.ByteBuf,
                                         value: str) =
    semanticSnapshotProductionAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

fn semanticSnapshotProductionAppendFixed32(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    semanticSnapshotProductionAppendU32(buf, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn semanticSnapshotProductionCidObserved(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(
        value, layout.FixedBytes32())

@borrows
fn semanticSnapshotProductionJobCid(
        ticket: SemanticSnapshotProductionJobTicket):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(1024)
    semanticSnapshotProductionAppendText(
        buf, "cheng.semantic_snapshot.production_job")
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.workspaceSessionCid)
    semanticSnapshotProductionAppendU32(buf, ticket.schemaVersion)
    semanticSnapshotProductionAppendI64(buf, ticket.semanticEpoch)
    semanticSnapshotProductionAppendI64(buf, ticket.sourceVersion)
    semanticSnapshotProductionAppendU32(
        buf, ticket.changedDocumentRows.len)
    for index in 0..<ticket.changedDocumentRows.len:
        semanticSnapshotProductionAppendU32(
            buf, ticket.changedDocumentRows[index])
        semanticSnapshotProductionAppendFixed32(
            buf, ticket.changedDocumentCids[index])
        semanticSnapshotProductionAppendI64(
            buf, ticket.changedDocumentEventSourceVersions[index])
        semanticSnapshotProductionAppendU32(
            buf, ticket.changedDocumentEventKinds[index])
        semanticSnapshotProductionAppendU32(
            buf, ticket.changedDocumentPresenceStates[index])
        semanticSnapshotProductionAppendU32(
            buf, ticket.changedDocumentRenamePeerRows[index])
        semanticSnapshotProductionAppendFixed32(
            buf, ticket.changedDocumentEventCids[index])
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.sourceEventStateReceiptCid)
    semanticSnapshotProductionAppendI64(
        buf, ticket.predecessorSourceVersion)
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.predecessorBindingReceiptCid)
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.predecessorSemanticSnapshotCid)
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.predecessorFactsRootCid)
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.predecessorCargoCid)
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.predecessorDeclarationTableCid)
    semanticSnapshotProductionAppendFixed32(
        buf, ticket.predecessorQueryIndexRootCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotProductionJobCompletionRejectionCid(
        receipt: SemanticSnapshotProductionJobCompletionRejection):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    semanticSnapshotProductionAppendText(
        buf, "cheng.semantic_snapshot.production_job_completion_rejection")
    semanticSnapshotProductionAppendFixed32(buf, receipt.jobCid)
    semanticSnapshotProductionAppendI64(buf, receipt.sourceVersion)
    semanticSnapshotProductionAppendI64(
        buf, receipt.observedCurrentSourceVersion)
    semanticSnapshotProductionAppendFixed32(
        buf, receipt.completionAuthorityCid)
    semanticSnapshotProductionAppendU32(buf, receipt.reasonKind)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn SemanticSnapshotProductionJobTicketStrictValidateInto(
        ticket: SemanticSnapshotProductionJobTicket,
        err: var str): bool =
    let changedCount = ticket.changedDocumentRows.len
    let predecessorPresent = ticket.predecessorSourceVersion > 0
    if !semanticSnapshotProductionCidObserved(
           ticket.workspaceSessionCid) ||
       ticket.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       ticket.semanticEpoch != ticket.sourceVersion ||
       ticket.sourceVersion <= 0 ||
       changedCount <= 0 ||
       changedCount != ticket.changedDocumentCids.len ||
       changedCount !=
           ticket.changedDocumentEventSourceVersions.len ||
       changedCount != ticket.changedDocumentEventKinds.len ||
       changedCount != ticket.changedDocumentPresenceStates.len ||
       changedCount != ticket.changedDocumentRenamePeerRows.len ||
       changedCount != ticket.changedDocumentEventCids.len ||
       !semanticSnapshotProductionCidObserved(
           ticket.sourceEventStateReceiptCid) ||
       ticket.predecessorSourceVersion < 0 ||
       ticket.predecessorSourceVersion >= ticket.sourceVersion ||
       predecessorPresent !=
           semanticSnapshotProductionCidObserved(
               ticket.predecessorBindingReceiptCid) ||
       predecessorPresent !=
           semanticSnapshotProductionCidObserved(
               ticket.predecessorSemanticSnapshotCid) ||
       predecessorPresent !=
           semanticSnapshotProductionCidObserved(
               ticket.predecessorFactsRootCid) ||
       predecessorPresent !=
           semanticSnapshotProductionCidObserved(
               ticket.predecessorCargoCid) ||
       predecessorPresent !=
           semanticSnapshotProductionCidObserved(
               ticket.predecessorDeclarationTableCid) ||
       predecessorPresent !=
           semanticSnapshotProductionCidObserved(
               ticket.predecessorQueryIndexRootCid) ||
       !semanticSnapshotProductionCidObserved(ticket.jobCid):
        err = " semantic snapshot production job: invalid ticket shape"
        return false
    for index in 0..<changedCount:
        if ticket.changedDocumentRows[index] < 0 ||
           (index > 0 &&
            ticket.changedDocumentRows[index] <=
                ticket.changedDocumentRows[index - 1]) ||
           !semanticSnapshotProductionCidObserved(
               ticket.changedDocumentCids[index]) ||
           ticket.changedDocumentEventSourceVersions[index] <=
               ticket.predecessorSourceVersion ||
           ticket.changedDocumentEventSourceVersions[index] >
               ticket.sourceVersion ||
           (ticket.changedDocumentPresenceStates[index] !=
                snapshot_core.SemanticSourcePresenceAbsent &&
            ticket.changedDocumentPresenceStates[index] !=
                snapshot_core.SemanticSourcePresencePresent) ||
           !semanticSnapshotProductionCidObserved(
               ticket.changedDocumentEventCids[index]) ||
           (ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventOpen &&
            ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventChange &&
            ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventClose &&
            ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventAdd &&
            ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventRemove &&
            ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventRename) ||
           (ticket.changedDocumentEventKinds[index] ==
                snapshot_core.SemanticSourceEventRemove &&
            ticket.changedDocumentPresenceStates[index] !=
                snapshot_core.SemanticSourcePresenceAbsent) ||
           (ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventRemove &&
            ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventRename &&
            ticket.changedDocumentPresenceStates[index] !=
                snapshot_core.SemanticSourcePresencePresent) ||
           (ticket.changedDocumentEventKinds[index] ==
                snapshot_core.SemanticSourceEventRename &&
            ticket.changedDocumentRenamePeerRows[index] < 0) ||
           (ticket.changedDocumentEventKinds[index] !=
                snapshot_core.SemanticSourceEventRename &&
            ticket.changedDocumentRenamePeerRows[index] != -1):
            err = " semantic snapshot production job: invalid changed document"
            return false
    let completionAdmitted =
        ticket.state ==
            SemanticSnapshotProductionJobCompletionAdmitted ||
        ticket.state == SemanticSnapshotProductionJobPublished ||
        ticket.state == SemanticSnapshotProductionJobRejected
    if (ticket.state != SemanticSnapshotProductionJobQueued &&
        ticket.state != SemanticSnapshotProductionJobRunning &&
        ticket.state != SemanticSnapshotProductionJobCancelled &&
        !completionAdmitted) ||
       completionAdmitted !=
           semanticSnapshotProductionCidObserved(
               ticket.admittedCompletionAuthorityCid) ||
       !layout.FixedBytes32Equal(
           ticket.jobCid,
           semanticSnapshotProductionJobCid(ticket)):
        err = " semantic snapshot production job: invalid ticket state"
        return false
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
        receipt: SemanticSnapshotProductionJobCompletionRejection,
        err: var str): bool =
    if !semanticSnapshotProductionCidObserved(receipt.jobCid) ||
       receipt.sourceVersion <= 0 ||
       receipt.observedCurrentSourceVersion <= 0 ||
       !semanticSnapshotProductionCidObserved(
           receipt.completionAuthorityCid) ||
       (receipt.reasonKind !=
            SemanticSnapshotProductionJobCompletionCancelled &&
        receipt.reasonKind !=
            SemanticSnapshotProductionJobCompletionLate &&
        receipt.reasonKind !=
            SemanticSnapshotProductionJobCompletionDuplicate) ||
       !semanticSnapshotProductionCidObserved(receipt.receiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.receiptCid,
           semanticSnapshotProductionJobCompletionRejectionCid(receipt)):
        err =
            " semantic snapshot production job: invalid completion rejection"
        return false
    err = ""
    return true

fn semanticSnapshotProductionJobCompletionRejectInto(
        ticket: var SemanticSnapshotProductionJobTicket,
        observedCurrentSourceVersion: int64,
        completionAuthorityCid: layout.FixedBytes32,
        reasonKind: int32,
        out: var SemanticSnapshotProductionJobCompletionRejection,
        err: var str): bool =
    var receipt: SemanticSnapshotProductionJobCompletionRejection
    receipt.jobCid = layout.FixedBytes32Copy(ticket.jobCid)
    receipt.sourceVersion = ticket.sourceVersion
    receipt.observedCurrentSourceVersion = observedCurrentSourceVersion
    receipt.completionAuthorityCid =
        layout.FixedBytes32Copy(completionAuthorityCid)
    receipt.reasonKind = reasonKind
    receipt.receiptCid =
        semanticSnapshotProductionJobCompletionRejectionCid(receipt)
    if !SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
           receipt, err):
        return false
    out = receipt
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionJobTicketMakeInto(
        eventState: snapshot_core.WorkspaceSourceEventState,
        store: var SemanticSnapshotProductionStore,
        out: var SemanticSnapshotProductionJobTicket,
        err: var str): bool =
    out = SemanticSnapshotProductionJobTicket()
    if !SemanticSnapshotProductionStoreStrictValidateInto(store, err) ||
       store.core.currentSourceVersion <= 0 ||
       store.core.currentSourceVersion !=
           eventState.lastAcceptedSourceVersion ||
       store.core.candidateIndex != -1:
        err = " semantic snapshot production job: current event mismatch"
        return false
    var ticket: SemanticSnapshotProductionJobTicket
    ticket.workspaceSessionCid =
        layout.FixedBytes32Copy(store.core.workspaceSessionCid)
    ticket.schemaVersion =
        snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    ticket.semanticEpoch = store.core.currentSourceVersion
    ticket.sourceVersion = store.core.currentSourceVersion
    ticket.sourceEventStateReceiptCid =
        layout.FixedBytes32Copy(eventState.eventStateReceiptCid)
    var predecessorPin: SemanticSnapshotProductionPin
    if store.core.publishedIndex >= 0:
        if !SemanticSnapshotProductionStorePinPublishedPredecessorInto(
               store, ticket.sourceVersion, predecessorPin, err):
            return false
        ticket.predecessorSourceVersion =
            predecessorPin.corePin.sourceVersion
        ticket.predecessorBindingReceiptCid =
            layout.FixedBytes32Copy(
                predecessorPin.corePin.bindingReceiptCid)
        ticket.predecessorSemanticSnapshotCid =
            layout.FixedBytes32Copy(predecessorPin.semanticSnapshotCid)
        ticket.predecessorFactsRootCid =
            layout.FixedBytes32Copy(predecessorPin.factsRootCid)
        ticket.predecessorCargoCid =
            layout.FixedBytes32Copy(predecessorPin.cargoCid)
        ticket.predecessorDeclarationTableCid =
            layout.FixedBytes32Copy(predecessorPin.declarationTableCid)
        ticket.predecessorQueryIndexRootCid =
            layout.FixedBytes32Copy(predecessorPin.queryIndexRootCid)
    var changedRows: int32[]
    if !snapshot_core.WorkspaceSourceEventChangedDocumentRowsSinceInto(
           eventState, ticket.predecessorSourceVersion,
           changedRows, err):
        if predecessorPin.active:
            var releaseErr: str
            if !SemanticSnapshotProductionStoreReleasePinInto(
                   store, predecessorPin, releaseErr):
                err = releaseErr
        return false
    for index in 0..<changedRows.len:
        let row = changedRows[index]
        if row < 0 || row >= eventState.documentCids.len ||
           row >= eventState.documentLastEventSourceVersions.len ||
           row >= eventState.documentLastEventKinds.len ||
           row >= eventState.documentPresenceStates.len ||
           row >= eventState.documentRenamePeerRows.len ||
           row >= eventState.documentLastEventCids.len:
            if predecessorPin.active:
                var releaseErr: str
                if !SemanticSnapshotProductionStoreReleasePinInto(
                       store, predecessorPin, releaseErr):
                    err = releaseErr
                    return false
            err =
                " semantic snapshot production job: changed document missing"
            return false
        add(ticket.changedDocumentRows, row)
        add(ticket.changedDocumentCids,
            layout.FixedBytes32Copy(eventState.documentCids[row]))
        add(ticket.changedDocumentEventSourceVersions,
            eventState.documentLastEventSourceVersions[row])
        add(ticket.changedDocumentEventKinds,
            eventState.documentLastEventKinds[row])
        add(ticket.changedDocumentPresenceStates,
            eventState.documentPresenceStates[row])
        add(ticket.changedDocumentRenamePeerRows,
            eventState.documentRenamePeerRows[row])
        add(ticket.changedDocumentEventCids,
            layout.FixedBytes32Copy(
                eventState.documentLastEventCids[row]))
    if predecessorPin.active:
        if !SemanticSnapshotProductionStoreReleasePinInto(
               store, predecessorPin, err):
            return false
    ticket.state = SemanticSnapshotProductionJobQueued
    ticket.jobCid = semanticSnapshotProductionJobCid(ticket)
    if !SemanticSnapshotProductionJobTicketStrictValidateInto(
           ticket, err):
        return false
    out = ticket
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionJobTicketStartInto(
        ticket: var SemanticSnapshotProductionJobTicket,
        expectedJobCid: layout.FixedBytes32,
        err: var str): bool =
    if !SemanticSnapshotProductionJobTicketStrictValidateInto(
           ticket, err) ||
       ticket.state != SemanticSnapshotProductionJobQueued ||
       !layout.FixedBytes32Equal(ticket.jobCid, expectedJobCid):
        err = " semantic snapshot production job: start mismatch"
        return false
    ticket.state = SemanticSnapshotProductionJobRunning
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionJobTicketCancelInto(
        ticket: var SemanticSnapshotProductionJobTicket,
        expectedJobCid: layout.FixedBytes32,
        expectedSourceVersion: int64,
        cancelledOut: var bool,
        err: var str): bool =
    cancelledOut = false
    if !SemanticSnapshotProductionJobTicketStrictValidateInto(
           ticket, err) ||
       !layout.FixedBytes32Equal(ticket.jobCid, expectedJobCid) ||
       ticket.sourceVersion != expectedSourceVersion:
        err = " semantic snapshot production job: cancel mismatch"
        return false
    if ticket.state == SemanticSnapshotProductionJobCancelled:
        err = ""
        return true
    if ticket.state != SemanticSnapshotProductionJobQueued &&
       ticket.state != SemanticSnapshotProductionJobRunning:
        err = " semantic snapshot production job: cancel after completion"
        return false
    ticket.state = SemanticSnapshotProductionJobCancelled
    cancelledOut = true
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionJobCompletionBoundAdmitInto(
        store: var SemanticSnapshotProductionStore,
        ticket: var SemanticSnapshotProductionJobTicket,
        completionJobCid: layout.FixedBytes32,
        completionSourceVersion: int64,
        completionSourceEventStateReceiptCid: layout.FixedBytes32,
        completionAuthorityCid: layout.FixedBytes32,
        rejectionOut:
            var SemanticSnapshotProductionJobCompletionRejection,
        err: var str): bool =
    rejectionOut =
        SemanticSnapshotProductionJobCompletionRejection()
    if !SemanticSnapshotProductionStoreStrictValidateInto(store, err) ||
       !SemanticSnapshotProductionJobTicketStrictValidateInto(
           ticket, err) ||
       !layout.FixedBytes32Equal(
           ticket.workspaceSessionCid, store.core.workspaceSessionCid) ||
       !layout.FixedBytes32Equal(ticket.jobCid, completionJobCid) ||
       ticket.sourceVersion != completionSourceVersion ||
       !layout.FixedBytes32Equal(
           ticket.sourceEventStateReceiptCid,
           completionSourceEventStateReceiptCid) ||
       !semanticSnapshotProductionCidObserved(
           completionAuthorityCid):
        err = " semantic snapshot production job: completion identity mismatch"
        return false
    if ticket.state == SemanticSnapshotProductionJobCancelled:
        if !semanticSnapshotProductionJobCompletionRejectInto(
               ticket, store.core.currentSourceVersion,
               completionAuthorityCid,
               SemanticSnapshotProductionJobCompletionCancelled,
               rejectionOut, err):
            return false
        err = ""
        return false
    if ticket.state ==
           SemanticSnapshotProductionJobCompletionAdmitted ||
       ticket.state == SemanticSnapshotProductionJobPublished ||
       ticket.state == SemanticSnapshotProductionJobRejected:
        if !semanticSnapshotProductionJobCompletionRejectInto(
               ticket, store.core.currentSourceVersion,
               completionAuthorityCid,
               SemanticSnapshotProductionJobCompletionDuplicate,
               rejectionOut, err):
            return false
        err = ""
        return false
    if ticket.state != SemanticSnapshotProductionJobRunning:
        err =
            " semantic snapshot production job: completion before start"
        return false
    if store.core.currentSourceVersion != ticket.sourceVersion:
        if !semanticSnapshotProductionJobCompletionRejectInto(
               ticket, store.core.currentSourceVersion,
               completionAuthorityCid,
               SemanticSnapshotProductionJobCompletionLate,
               rejectionOut, err):
            return false
        ticket.admittedCompletionAuthorityCid =
            layout.FixedBytes32Copy(completionAuthorityCid)
        ticket.state = SemanticSnapshotProductionJobRejected
        err = ""
        return false
    ticket.admittedCompletionAuthorityCid =
        layout.FixedBytes32Copy(completionAuthorityCid)
    ticket.state =
        SemanticSnapshotProductionJobCompletionAdmitted
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionJobCompletionCommitInto(
        ticket: var SemanticSnapshotProductionJobTicket,
        completionJobCid: layout.FixedBytes32,
        completionAuthorityCid: layout.FixedBytes32,
        published: bool,
        err: var str): bool =
    if !SemanticSnapshotProductionJobTicketStrictValidateInto(
           ticket, err) ||
       ticket.state !=
           SemanticSnapshotProductionJobCompletionAdmitted ||
       !layout.FixedBytes32Equal(ticket.jobCid, completionJobCid) ||
       !layout.FixedBytes32Equal(
           ticket.admittedCompletionAuthorityCid,
           completionAuthorityCid):
        err =
            " semantic snapshot production job: completion commit mismatch"
        return false
    ticket.state =
        published ?
            SemanticSnapshotProductionJobPublished :
            SemanticSnapshotProductionJobRejected
    err = ""
    return true

fn semanticSnapshotProductionPredecessorCid(
        receipt: SemanticSnapshotCompilerPredecessorReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(384)
    semanticSnapshotProductionAppendText(
        buf, "cheng.semantic_snapshot.compiler_predecessor")
    semanticSnapshotProductionAppendFixed32(
        buf, receipt.sourceIdentityReceiptCid)
    semanticSnapshotProductionAppendFixed32(
        buf, receipt.compilerCsgTransitionReceiptCid)
    semanticSnapshotProductionAppendFixed32(buf, receipt.sourceGraphCid)
    semanticSnapshotProductionAppendFixed32(
        buf, receipt.canonicalSourceGraphCid)
    semanticSnapshotProductionAppendFixed32(buf, receipt.worldHeadCid)
    semanticSnapshotProductionAppendFixed32(buf, receipt.compilerExecutionCid)
    semanticSnapshotProductionAppendFixed32(buf, receipt.compilerPackageCid)
    semanticSnapshotProductionAppendFixed32(buf, receipt.sourceBundleCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotProductionUniverseStrictValidateInto(
        universe: cworld.CompilerLocalUniverse,
        err: var str): bool =
    if !cworld.CompilerPackageSnapshotStrictValidateInto(
            universe.compilerSnapshot, err) ||
       !cworld.CompilerPackageSnapshotStrictValidateInto(
            universe.stdSnapshot, err) ||
       !cworld.CompilerPackageSnapshotStrictValidateInto(
            universe.runtimeSnapshot, err) ||
       !cworld.CompilerWorldHeadStrictValidateInto(
            universe.worldHead, err):
        return false
    if universe.compilerSnapshot.packageId != "cheng/compiler" ||
       universe.stdSnapshot.packageId != "cheng/std" ||
       universe.runtimeSnapshot.packageId != "cheng/runtime":
        err = " semantic snapshot production: package identity mismatch"
        return false
    if universe.manifest.channel != universe.worldHead.channel ||
       universe.manifest.entryCount != universe.manifest.entries.len ||
       !layout.FixedBytes32Equal(
           universe.manifest.manifestCid,
           cworld.CompilerWorldHashUniverseManifest(
               universe.manifest.channel,
               universe.manifest.managedDependencyReceiptCid,
               universe.manifest.entries)) ||
       !layout.FixedBytes32Equal(
           universe.manifest.manifestCid,
           universe.worldHead.manifestRootCid):
        err = " semantic snapshot production: manifest binding mismatch"
        return false
    var compilerEntryCount: int32
    var stdEntryCount: int32
    var runtimeEntryCount: int32
    var hasManagedMirror = false
    for entryIndex in 0..<universe.manifest.entries.len:
        let entry = universe.manifest.entries[entryIndex]
        if entry.packageId == "" ||
           parser.ParserManifestNormalizePackageId(entry.packageId) !=
               entry.packageId ||
           layout.FixedBytes32Equal(entry.snapshotCid,
                                    layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(entry.syntaxSurfaceCid,
                                    layout.FixedBytes32()):
            err = " semantic snapshot production: invalid manifest entry"
            return false
        for earlierIndex in 0..<entryIndex:
            if universe.manifest.entries[earlierIndex].packageId ==
               entry.packageId:
                err = " semantic snapshot production: duplicate manifest entry"
                return false
        let proofMissing = layout.FixedBytes32Equal(
            entry.migrationProofCid, layout.FixedBytes32())
        let mirrorMissing = layout.FixedBytes32Equal(
            entry.managedMirrorBundleCid, layout.FixedBytes32())
        if universe.manifest.channel == "stable" &&
           proofMissing != mirrorMissing:
            err = " semantic snapshot production: manifest proof/mirror split"
            return false
        if !mirrorMissing:
            hasManagedMirror = true
        if entry.packageId == "cheng/compiler":
            compilerEntryCount = compilerEntryCount + 1
            if !layout.FixedBytes32Equal(
                    entry.snapshotCid,
                    universe.compilerSnapshot.snapshotCid) ||
               !layout.FixedBytes32Equal(
                    entry.syntaxSurfaceCid,
                    universe.compilerSnapshot.syntaxSurfaceCid) ||
               !layout.FixedBytes32Equal(
                    entry.migrationProofCid,
                    universe.compilerSnapshot.migrationProofCid):
                err = " semantic snapshot production: compiler manifest split"
                return false
            if universe.manifest.channel == "stable" &&
               layout.FixedBytes32Equal(
                   entry.migrationProofCid,
                   layout.FixedBytes32()) !=
               layout.FixedBytes32Equal(
                   entry.managedMirrorBundleCid,
                   layout.FixedBytes32()):
                err = " semantic snapshot production: compiler mirror split"
                return false
        elif entry.packageId == "cheng/std":
            stdEntryCount = stdEntryCount + 1
            if !layout.FixedBytes32Equal(
                    entry.snapshotCid,
                    universe.stdSnapshot.snapshotCid) ||
               !layout.FixedBytes32Equal(
                    entry.syntaxSurfaceCid,
                    universe.stdSnapshot.syntaxSurfaceCid) ||
               !layout.FixedBytes32Equal(
                    entry.migrationProofCid,
                    universe.stdSnapshot.migrationProofCid):
                err = " semantic snapshot production: std manifest split"
                return false
            if !layout.FixedBytes32Equal(
                    entry.managedMirrorBundleCid,
                    layout.FixedBytes32()):
                err = " semantic snapshot production: std mirror split"
                return false
        elif entry.packageId == "cheng/runtime":
            runtimeEntryCount = runtimeEntryCount + 1
            if !layout.FixedBytes32Equal(
                    entry.snapshotCid,
                    universe.runtimeSnapshot.snapshotCid) ||
               !layout.FixedBytes32Equal(
                    entry.syntaxSurfaceCid,
                    universe.runtimeSnapshot.syntaxSurfaceCid) ||
               !layout.FixedBytes32Equal(
                    entry.migrationProofCid,
                    universe.runtimeSnapshot.migrationProofCid):
                err = " semantic snapshot production: runtime manifest split"
                return false
            if !layout.FixedBytes32Equal(
                    entry.managedMirrorBundleCid,
                    layout.FixedBytes32()):
                err = " semantic snapshot production: runtime mirror split"
                return false
    if compilerEntryCount != 1 || stdEntryCount != 1 ||
       runtimeEntryCount != 1:
        err = " semantic snapshot production: required manifest entry missing"
        return false
    let dependencyReceiptMissing = layout.FixedBytes32Equal(
        universe.manifest.managedDependencyReceiptCid,
        layout.FixedBytes32())
    if universe.manifest.channel == "stable" &&
       hasManagedMirror == dependencyReceiptMissing:
        err = " semantic snapshot production: managed dependency split"
        return false
    if !layout.FixedBytes32Equal(
            universe.worldHead.compilerPkgCid,
            universe.compilerSnapshot.snapshotCid) ||
       !layout.FixedBytes32Equal(
            universe.worldHead.stdPkgCid,
            universe.stdSnapshot.snapshotCid) ||
       !layout.FixedBytes32Equal(
            universe.worldHead.runtimePkgCid,
            universe.runtimeSnapshot.snapshotCid) ||
       !layout.FixedBytes32Equal(
            universe.worldHead.csgRootCid,
            universe.compilerSnapshot.csgRootCid):
        err = " semantic snapshot production: world package binding mismatch"
        return false
    return true

@borrows
fn semanticSnapshotProductionPredecessorInputsStrictValidateInto(
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        err: var str): bool =
    err = ""
    if csg.packageId == "" ||
       parser.ParserManifestNormalizePackageId(csg.packageId) !=
           csg.packageId ||
       csg.sourceSnapshotCount <= 0 ||
       csg.nodeCount != csg.nodes.len ||
       csg.edgeCount != csg.edges.len ||
       csg.sourceSnapshotCount !=
           csg.sourceIdentityReceipt.sourceSnapshotCount ||
       layout.FixedBytes32Equal(csg.sourceBundleCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(csg.entrySourceCid,
                                layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           csg.entrySourceCid,
           csg.sourceIdentityReceipt.entrySourceCid) ||
       layout.FixedBytes32Equal(
           csg.parserNormalizedExprReceipt.envelope.receiptRaw32,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(csg.graphCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(csg.canonicalGraphCid,
                                layout.FixedBytes32()):
        err = " semantic snapshot production: invalid CompilerCSG"
        return false
    let executionVerify =
        execution.CompilerExecutionIdentityVerify(compilerExecution)
    if IsErr(executionVerify):
        err = Error(executionVerify)
        return false
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            csg.sourceIdentityReceipt, err) ||
       !ccsg.CompilerCsgOwnTransitionReceiptStrictValidateInto(csg, err) ||
       !semanticSnapshotProductionUniverseStrictValidateInto(universe, err):
        return false
    if !layout.FixedBytes32Equal(
            ccsg.CompilerCsgPortableSourcePackageIdCid(csg.packageId),
            csg.sourceIdentityReceipt.sourcePackageIdCid) ||
       !layout.FixedBytes32Equal(
           csg.sourceBundleCid,
           csg.sourceIdentityReceipt.sourceBundleCid):
        err = " semantic snapshot production: source identity mismatch"
        return false
    if !layout.FixedBytes32Equal(
            compilerExecution.sourceBundleRaw32,
            universe.compilerSnapshot.sourceBundleCid):
        err = " semantic snapshot production: compiler source identity mismatch"
        return false
    return true

@borrows
fn SemanticSnapshotCompilerPredecessorReceiptMakeInto(
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        out: var SemanticSnapshotCompilerPredecessorReceipt,
        err: var str): bool =
    if !semanticSnapshotProductionPredecessorInputsStrictValidateInto(
            csg, universe, compilerExecution, err):
        return false
    var receipt: SemanticSnapshotCompilerPredecessorReceipt
    receipt.sourceIdentityReceiptCid = csg.sourceIdentityReceipt.receiptCid
    receipt.compilerCsgTransitionReceiptCid =
        csg.csgTransitionReceipt.receiptCid
    receipt.sourceGraphCid = csg.graphCid
    receipt.canonicalSourceGraphCid = csg.canonicalGraphCid
    receipt.worldHeadCid = universe.worldHead.headCid
    receipt.compilerExecutionCid = compilerExecution.executionRaw32
    receipt.compilerPackageCid = universe.compilerSnapshot.snapshotCid
    receipt.sourceBundleCid = csg.sourceBundleCid
    receipt.receiptCid = semanticSnapshotProductionPredecessorCid(receipt)
    out = receipt
    err = ""
    return true

@borrows
fn SemanticSnapshotCompilerPredecessorReceiptStrictValidateInto(
        receipt: SemanticSnapshotCompilerPredecessorReceipt,
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        err: var str): bool =
    if !semanticSnapshotProductionPredecessorInputsStrictValidateInto(
            csg, universe, compilerExecution, err):
        return false
    if !layout.FixedBytes32Equal(
            receipt.sourceIdentityReceiptCid,
            csg.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            receipt.compilerCsgTransitionReceiptCid,
            csg.csgTransitionReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(receipt.sourceGraphCid, csg.graphCid) ||
       !layout.FixedBytes32Equal(
            receipt.canonicalSourceGraphCid,
            csg.canonicalGraphCid) ||
       !layout.FixedBytes32Equal(
            receipt.worldHeadCid,
            universe.worldHead.headCid) ||
       !layout.FixedBytes32Equal(
            receipt.compilerExecutionCid,
            compilerExecution.executionRaw32) ||
       !layout.FixedBytes32Equal(
            receipt.compilerPackageCid,
            universe.compilerSnapshot.snapshotCid) ||
       !layout.FixedBytes32Equal(
            receipt.sourceBundleCid,
            csg.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
            receipt.receiptCid,
            semanticSnapshotProductionPredecessorCid(receipt)):
        err = " semantic snapshot production: predecessor receipt mismatch"
        return false
    err = ""
    return true

fn semanticSnapshotProductionProofRootsEqual(
        left: snapshot_cargo.CsgCompilerSnapshotProofRoots,
        right: snapshot_cargo.CsgCompilerSnapshotProofRoots): bool =
    return layout.FixedBytes32Equal(left.parserRootCid,
                                    right.parserRootCid) &&
           layout.FixedBytes32Equal(left.typeRootCid,
                                    right.typeRootCid) &&
           layout.FixedBytes32Equal(left.ownershipRootCid,
                                    right.ownershipRootCid) &&
           layout.FixedBytes32Equal(left.callRootCid,
                                    right.callRootCid) &&
           layout.FixedBytes32Equal(left.layoutRootCid,
                                    right.layoutRootCid) &&
           layout.FixedBytes32Equal(left.dependencyRootCid,
                                    right.dependencyRootCid) &&
           layout.FixedBytes32Equal(left.readSetRootCid,
                                    right.readSetRootCid) &&
           layout.FixedBytes32Equal(left.reachabilityRootCid,
                                    right.reachabilityRootCid) &&
           layout.FixedBytes32Equal(left.lifecycleRootCid,
                                    right.lifecycleRootCid)

@borrows
fn semanticSnapshotProductionValidationProofRoots(
        validation: snapshot_core.SemanticSnapshotValidationReceipt):
        snapshot_cargo.CsgCompilerSnapshotProofRoots =
    var out: snapshot_cargo.CsgCompilerSnapshotProofRoots
    out.parserRootCid = layout.FixedBytes32Copy(validation.parserRootCid)
    out.typeRootCid = layout.FixedBytes32Copy(validation.typeRootCid)
    out.ownershipRootCid =
        layout.FixedBytes32Copy(validation.ownershipRootCid)
    out.callRootCid = layout.FixedBytes32Copy(validation.callRootCid)
    out.layoutRootCid = layout.FixedBytes32Copy(validation.layoutRootCid)
    out.dependencyRootCid =
        layout.FixedBytes32Copy(validation.dependencyRootCid)
    out.readSetRootCid = layout.FixedBytes32Copy(validation.readSetRootCid)
    out.reachabilityRootCid =
        layout.FixedBytes32Copy(validation.reachabilityRootCid)
    out.lifecycleRootCid =
        layout.FixedBytes32Copy(validation.lifecycleRootCid)
    return out

@borrows
fn semanticSnapshotProductionBindingClone(
        binding: snapshot_core.LocalSourceVersionBinding):
        snapshot_core.LocalSourceVersionBinding =
    var out: snapshot_core.LocalSourceVersionBinding
    out.workspaceSessionCid =
        layout.FixedBytes32Copy(binding.workspaceSessionCid)
    out.schemaVersion = binding.schemaVersion
    out.semanticEpoch = binding.semanticEpoch
    out.sourceVersion = binding.sourceVersion
    out.semanticSnapshotCid =
        layout.FixedBytes32Copy(binding.semanticSnapshotCid)
    out.worldHeadCid = layout.FixedBytes32Copy(binding.worldHeadCid)
    out.compilerCid = layout.FixedBytes32Copy(binding.compilerCid)
    out.sourceBundleCid = layout.FixedBytes32Copy(binding.sourceBundleCid)
    out.csgRootCid = layout.FixedBytes32Copy(binding.csgRootCid)
    out.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    out.sourceEventStateReceiptCid =
        layout.FixedBytes32Copy(
            binding.sourceEventStateReceiptCid)
    for index in 0..<binding.documentCids.len:
        add(out.documentCids,
            layout.FixedBytes32Copy(binding.documentCids[index]))
        add(out.clientVersions, binding.clientVersions[index])
        add(out.documentOpenStates, binding.documentOpenStates[index])
        add(out.activeSourceStableRows,
            binding.activeSourceStableRows[index])
    return out

@borrows
fn semanticSnapshotProductionIdentityClone(
        identity: snapshot_core.PortableSemanticSnapshotIdentity):
        snapshot_core.PortableSemanticSnapshotIdentity =
    var out: snapshot_core.PortableSemanticSnapshotIdentity
    out.sourceIdentityReceiptCid =
        layout.FixedBytes32Copy(identity.sourceIdentityReceiptCid)
    out.worldHeadCid = layout.FixedBytes32Copy(identity.worldHeadCid)
    out.compilerCid = layout.FixedBytes32Copy(identity.compilerCid)
    out.sourceBundleCid =
        layout.FixedBytes32Copy(identity.sourceBundleCid)
    out.csgRootCid = layout.FixedBytes32Copy(identity.csgRootCid)
    out.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    return out

@borrows
fn semanticSnapshotProductionValidationClone(
        validation: snapshot_core.SemanticSnapshotValidationReceipt):
        snapshot_core.SemanticSnapshotValidationReceipt =
    var out: snapshot_core.SemanticSnapshotValidationReceipt
    out.bindingReceiptCid =
        layout.FixedBytes32Copy(validation.bindingReceiptCid)
    out.semanticSnapshotCid =
        layout.FixedBytes32Copy(validation.semanticSnapshotCid)
    out.parserRootCid = layout.FixedBytes32Copy(validation.parserRootCid)
    out.typeRootCid = layout.FixedBytes32Copy(validation.typeRootCid)
    out.ownershipRootCid =
        layout.FixedBytes32Copy(validation.ownershipRootCid)
    out.callRootCid = layout.FixedBytes32Copy(validation.callRootCid)
    out.layoutRootCid = layout.FixedBytes32Copy(validation.layoutRootCid)
    out.dependencyRootCid =
        layout.FixedBytes32Copy(validation.dependencyRootCid)
    out.readSetRootCid =
        layout.FixedBytes32Copy(validation.readSetRootCid)
    out.reachabilityRootCid =
        layout.FixedBytes32Copy(validation.reachabilityRootCid)
    out.canonicalRootCid =
        layout.FixedBytes32Copy(validation.canonicalRootCid)
    out.lifecycleRootCid =
        layout.FixedBytes32Copy(validation.lifecycleRootCid)
    out.queryIndexRootCid =
        layout.FixedBytes32Copy(validation.queryIndexRootCid)
    out.validationReceiptCid =
        layout.FixedBytes32Copy(validation.validationReceiptCid)
    return out

@borrows
fn semanticSnapshotProductionPredecessorClone(
        predecessor: SemanticSnapshotCompilerPredecessorReceipt):
        SemanticSnapshotCompilerPredecessorReceipt =
    var out: SemanticSnapshotCompilerPredecessorReceipt
    out.sourceIdentityReceiptCid =
        layout.FixedBytes32Copy(predecessor.sourceIdentityReceiptCid)
    out.compilerCsgTransitionReceiptCid =
        layout.FixedBytes32Copy(
            predecessor.compilerCsgTransitionReceiptCid)
    out.sourceGraphCid =
        layout.FixedBytes32Copy(predecessor.sourceGraphCid)
    out.canonicalSourceGraphCid =
        layout.FixedBytes32Copy(predecessor.canonicalSourceGraphCid)
    out.worldHeadCid =
        layout.FixedBytes32Copy(predecessor.worldHeadCid)
    out.compilerExecutionCid =
        layout.FixedBytes32Copy(predecessor.compilerExecutionCid)
    out.compilerPackageCid =
        layout.FixedBytes32Copy(predecessor.compilerPackageCid)
    out.sourceBundleCid =
        layout.FixedBytes32Copy(predecessor.sourceBundleCid)
    out.receiptCid = layout.FixedBytes32Copy(predecessor.receiptCid)
    return out

fn semanticSnapshotProductionCandidateBuildFailureReleaseInto(
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        cargo: var snapshot_cargo.CsgCompilerSnapshotCargo) =
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        tables.declarations)

@borrows
fn SemanticSnapshotProductionCandidateMakeInto(
        predecessor: SemanticSnapshotCompilerPredecessorReceipt,
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        eventState: snapshot_core.WorkspaceSourceEventState,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sourceDocuments: query_projection.SemanticSnapshotSourceDocument[],
        out: var SemanticSnapshotProductionCandidate,
        err: var str): bool =
    err = ""
    if !SemanticSnapshotCompilerPredecessorReceiptStrictValidateInto(
            predecessor, csg, universe, compilerExecution, err):
        return false
    if tables.schemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       tables.semanticEpoch <= 0 ||
       tables.semanticEpoch != eventState.lastAcceptedSourceVersion ||
       !layout.FixedBytes32Equal(tables.predecessorReceiptCid,
                                 predecessor.receiptCid):
        err = " semantic snapshot production: CSG predecessor mismatch"
        return false
    var candidateTables =
        snapshot_schema.CsgCompilerSnapshotTablesClone(tables)
    var cargo =
        snapshot_cargo.CsgCompilerSnapshotCargoBuild(candidateTables)
    if !cargo.ok:
        let cargoError = parser.ParserOwnedText(cargo.error)
        semanticSnapshotProductionCandidateBuildFailureReleaseInto(
            candidateTables, cargo)
        err = cargoError
        return false
    var identity: snapshot_core.PortableSemanticSnapshotIdentity
    if !snapshot_core.PortableSemanticSnapshotIdentityMakeInto(
            csg.sourceIdentityReceipt.receiptCid,
            universe.worldHead.headCid,
            compilerExecution.executionRaw32,
            csg.sourceBundleCid,
            cargo.factsRootCid,
            identity,
            err):
        semanticSnapshotProductionCandidateBuildFailureReleaseInto(
            candidateTables, cargo)
        return false
    var binding: snapshot_core.LocalSourceVersionBinding
    if !snapshot_core.LocalSourceVersionBindingMakeInto(
            eventState, identity, binding, err):
        semanticSnapshotProductionCandidateBuildFailureReleaseInto(
            candidateTables, cargo)
        return false
    var queryProjection: query_projection.SemanticSnapshotQueryProjection
    if !query_projection.SemanticSnapshotQueryProjectionBuildInto(
            candidateTables, binding, identity, sourceDocuments,
            queryProjection, err):
        semanticSnapshotProductionCandidateBuildFailureReleaseInto(
            candidateTables, cargo)
        return false
    var validation: snapshot_core.SemanticSnapshotValidationReceipt
    if !snapshot_core.SemanticSnapshotValidationReceiptMakeInto(
            binding,
            identity,
            cargo.proofRoots.parserRootCid,
            cargo.proofRoots.typeRootCid,
            cargo.proofRoots.ownershipRootCid,
            cargo.proofRoots.callRootCid,
            cargo.proofRoots.layoutRootCid,
            cargo.proofRoots.dependencyRootCid,
            cargo.proofRoots.readSetRootCid,
            cargo.proofRoots.reachabilityRootCid,
            cargo.proofRoots.lifecycleRootCid,
            queryProjection.queryIndex.rootCid,
            validation,
            err):
        semanticSnapshotProductionCandidateBuildFailureReleaseInto(
            candidateTables, cargo)
        return false
    var candidate: SemanticSnapshotProductionCandidate
    candidate.predecessor =
        semanticSnapshotProductionPredecessorClone(predecessor)
    candidate.identity = identity
    candidate.binding = binding
    candidate.validation = validation
    candidate.tables = candidateTables
    candidate.cargo = cargo
    candidate.queryProjection = queryProjection
    out = candidate
    err = ""
    return true

@borrows
fn semanticSnapshotProductionCandidateAdmissionStrictValidateInto(
        candidate: var SemanticSnapshotProductionCandidate,
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        err: var str): bool =
    err = ""
    if !SemanticSnapshotCompilerPredecessorReceiptStrictValidateInto(
            candidate.predecessor, csg, universe, compilerExecution, err) ||
       !layout.FixedBytes32Equal(
            candidate.tables.predecessorReceiptCid,
            candidate.predecessor.receiptCid) ||
       !snapshot_core.PortableSemanticSnapshotIdentityStrictValidateInto(
            candidate.identity, err) ||
       !snapshot_core.LocalSourceVersionBindingStrictValidateInto(
            candidate.binding, candidate.identity, err) ||
       !snapshot_core.SemanticSnapshotValidationReceiptStrictValidateInto(
            candidate.validation, candidate.binding, candidate.identity, err) ||
       !query_projection.SemanticSnapshotQueryProjectionStrictValidateInto(
            candidate.queryProjection, candidate.tables,
            candidate.binding, candidate.identity, err) ||
       !layout.FixedBytes32Equal(
            candidate.validation.queryIndexRootCid,
            candidate.queryProjection.queryIndex.rootCid):
        if err == "":
            err = " semantic snapshot production: invalid candidate binding"
        return false
    if candidate.tables.schemaVersion != candidate.binding.schemaVersion ||
       candidate.tables.semanticEpoch != candidate.binding.semanticEpoch ||
       candidate.tables.semanticEpoch != candidate.binding.sourceVersion:
        err = " semantic snapshot production: candidate schema/epoch split"
        return false
    if !layout.FixedBytes32Equal(
            candidate.identity.sourceIdentityReceiptCid,
            csg.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(candidate.identity.worldHeadCid,
                                 universe.worldHead.headCid) ||
       !layout.FixedBytes32Equal(candidate.identity.compilerCid,
                                 compilerExecution.executionRaw32) ||
       !layout.FixedBytes32Equal(candidate.identity.sourceBundleCid,
                                 csg.sourceBundleCid) ||
       !layout.FixedBytes32Equal(candidate.identity.csgRootCid,
                                 candidate.cargo.factsRootCid):
        err = " semantic snapshot production: candidate identity split"
        return false
    let admitted = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        candidate.cargo.csgcBytes, candidate.identity.csgRootCid)
    if !admitted.ok:
        err = admitted.error
        return false
    if !layout.FixedBytes32Equal(admitted.cargoCid,
                                 candidate.cargo.cargoCid) ||
       !semanticSnapshotProductionProofRootsEqual(
            admitted.proofRoots, candidate.cargo.proofRoots) ||
       !layout.FixedBytes32Equal(
            candidate.validation.parserRootCid,
            admitted.proofRoots.parserRootCid) ||
       !layout.FixedBytes32Equal(candidate.validation.typeRootCid,
                                 admitted.proofRoots.typeRootCid) ||
       !layout.FixedBytes32Equal(
            candidate.validation.ownershipRootCid,
            admitted.proofRoots.ownershipRootCid) ||
       !layout.FixedBytes32Equal(candidate.validation.callRootCid,
                                 admitted.proofRoots.callRootCid) ||
       !layout.FixedBytes32Equal(candidate.validation.layoutRootCid,
                                 admitted.proofRoots.layoutRootCid) ||
       !layout.FixedBytes32Equal(
            candidate.validation.dependencyRootCid,
            admitted.proofRoots.dependencyRootCid) ||
       !layout.FixedBytes32Equal(candidate.validation.readSetRootCid,
                                 admitted.proofRoots.readSetRootCid) ||
       !layout.FixedBytes32Equal(
            candidate.validation.reachabilityRootCid,
            admitted.proofRoots.reachabilityRootCid) ||
       !layout.FixedBytes32Equal(
            candidate.validation.lifecycleRootCid,
            admitted.proofRoots.lifecycleRootCid):
        err = " semantic snapshot production: candidate proof split"
        return false
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionCandidateStrictValidateInto(
        candidate: var SemanticSnapshotProductionCandidate,
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        err: var str): bool =
    if !semanticSnapshotProductionCandidateAdmissionStrictValidateInto(
            candidate, csg, universe, compilerExecution, err):
        return false
    # Audit callers additionally prove the retained candidate tables. The
    # production commit performs the same proof against its independent owner
    # and therefore does not rebuild the candidate cargo a second time.
    var rebuilt = snapshot_cargo.CsgCompilerSnapshotCargoBuild(
        candidate.tables)
    if !rebuilt.ok:
        err = rebuilt.error
        return false
    let tablesMatch = layout.FixedBytes32Equal(
        rebuilt.factsRootCid, candidate.identity.csgRootCid) &&
        layout.FixedBytes32Equal(rebuilt.cargoCid,
                                 candidate.cargo.cargoCid) &&
        semanticSnapshotProductionProofRootsEqual(
            rebuilt.proofRoots, candidate.cargo.proofRoots)
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(rebuilt)
    if !tablesMatch:
        err = " semantic snapshot production: retained CSG tables mutated"
        return false
    err = ""
    return true

fn semanticSnapshotProductionStoreColumnShapeValidNoAlloc(
        store: var SemanticSnapshotProductionStore): bool =
    let payloadCount = store.payloadStates.len
    let rejectionCount = store.rejectionStates.len
    if !snapshot_core.SemanticSnapshotStoreShapeValid(store.core) ||
       store.payloadIndexesBySnapshot.len != store.core.states.len ||
       payloadCount != store.payloadSnapshotIndexes.len ||
       payloadCount != store.payloadSourceVersions.len ||
       payloadCount != store.payloadBindingReceiptCids.len ||
       payloadCount != store.payloadSemanticSnapshotCids.len ||
       payloadCount != store.payloadFactsRootCids.len ||
       payloadCount != store.payloadCargoCids.len ||
       payloadCount != store.payloadCompilerFactProjectionCids.len ||
       payloadCount != store.payloadCompilerFactCounts.len ||
       payloadCount != store.payloadSemanticFactProjectionCids.len ||
       payloadCount != store.payloadSemanticFactCounts.len ||
       payloadCount != store.payloadDebugFactProjectionCids.len ||
       payloadCount != store.payloadDebugFactCounts.len ||
       payloadCount != store.payloadQueryProjectionCids.len ||
       payloadCount != store.payloadQueryIndexCids.len ||
       payloadCount != store.payloadQueryIndexRootCids.len ||
       payloadCount != store.payloadDeclarationTableCids.len ||
       payloadCount != store.payloadPackageIds.len ||
       payloadCount != store.payloadIdentities.len ||
       payloadCount != store.payloadBindings.len ||
       payloadCount != store.payloadValidations.len ||
       payloadCount != store.payloadTables.len ||
       payloadCount != store.payloadQueryProjections.len ||
       payloadCount != store.payloadCsgcBytes.len ||
       rejectionCount != store.rejectionSnapshotIndexes.len ||
       rejectionCount != store.rejectionSourceVersions.len ||
       rejectionCount != store.rejectionFactsRootCids.len ||
       rejectionCount != store.rejectionCargoCids.len ||
       rejectionCount != store.rejectionDiagnosticRootCids.len ||
       rejectionCount != store.rejectionIdentities.len ||
       rejectionCount != store.rejectionBindings.len ||
       rejectionCount != store.rejectionReceipts.len ||
       rejectionCount != store.rejectionFacts.len ||
       rejectionCount != store.rejectionCsgcBytes.len:
        return false
    return true

fn semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(
        store: var SemanticSnapshotProductionStore): bool =
    if !semanticSnapshotProductionStoreColumnShapeValidNoAlloc(store):
        return false
    let payloadCount = store.payloadStates.len
    for snapshotIndex in 0..<store.payloadIndexesBySnapshot.len:
        let payloadIndex = store.payloadIndexesBySnapshot[snapshotIndex]
        if payloadIndex < 0:
            if store.core.states[snapshotIndex] !=
                   snapshot_core.SemanticSnapshotStateReleased &&
               store.core.states[snapshotIndex] !=
                   snapshot_core.SemanticSnapshotStateRejected &&
               store.core.states[snapshotIndex] !=
                   snapshot_core.SemanticSnapshotStateCancelled &&
               (store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateBuilding ||
                snapshotIndex != store.core.candidateIndex):
                return false
            continue
        if payloadIndex >= payloadCount ||
           store.payloadSnapshotIndexes[payloadIndex] != snapshotIndex:
            return false
        let payloadState = store.payloadStates[payloadIndex]
        let coreState = store.core.states[snapshotIndex]
        if payloadState == SemanticSnapshotProductionPayloadStaged:
            if snapshotIndex != store.core.candidateIndex ||
               (coreState != snapshot_core.SemanticSnapshotStateBuilding &&
                coreState != snapshot_core.SemanticSnapshotStateValidated):
                return false
        elif payloadState == SemanticSnapshotProductionPayloadLive:
            if coreState != snapshot_core.SemanticSnapshotStatePublished &&
               coreState != snapshot_core.SemanticSnapshotStateRetired:
                return false
        elif payloadState ==
                 SemanticSnapshotProductionPayloadPendingReclaim:
            if coreState != snapshot_core.SemanticSnapshotStateReleased &&
               coreState != snapshot_core.SemanticSnapshotStateCancelled:
                return false
        else:
            return false
    for payloadIndex in 0..<payloadCount:
        let snapshotIndex = store.payloadSnapshotIndexes[payloadIndex]
        if snapshotIndex < 0 || snapshotIndex >= store.core.states.len ||
           (payloadIndex > 0 && snapshotIndex <=
               store.payloadSnapshotIndexes[payloadIndex - 1]):
            return false
        if store.payloadStates[payloadIndex] ==
               SemanticSnapshotProductionPayloadStaged:
            if store.payloadIndexesBySnapshot[snapshotIndex] != payloadIndex ||
               snapshotIndex != store.core.candidateIndex ||
               (store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateBuilding &&
                store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateValidated):
                return false
        elif store.payloadStates[payloadIndex] ==
               SemanticSnapshotProductionPayloadLive:
            if store.payloadIndexesBySnapshot[snapshotIndex] != payloadIndex ||
               (store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStatePublished &&
                store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateRetired):
                return false
        elif store.payloadStates[payloadIndex] ==
                 SemanticSnapshotProductionPayloadPendingReclaim:
            if store.payloadIndexesBySnapshot[snapshotIndex] != payloadIndex ||
               (store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateReleased &&
                store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateCancelled):
                return false
        elif store.payloadStates[payloadIndex] ==
                 SemanticSnapshotProductionPayloadReleased:
            if store.payloadIndexesBySnapshot[snapshotIndex] >= 0 ||
               (store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateReleased &&
                store.core.states[snapshotIndex] !=
                    snapshot_core.SemanticSnapshotStateCancelled) ||
               rawbytes.BytesLen(store.payloadCsgcBytes[payloadIndex]) != 0 ||
               !layout.FixedBytes32Equal(
                   store.payloadDeclarationTableCids[payloadIndex],
                   layout.FixedBytes32()):
                return false
        else:
            return false
    var previousRejectionSnapshot: int32 = -1
    var stagedRejectionCount: int32
    var stagedRejectionSnapshotIndex: int32 = -1
    for rejectionIndex in 0..<store.rejectionStates.len:
        let snapshotIndex = store.rejectionSnapshotIndexes[rejectionIndex]
        if snapshotIndex <= previousRejectionSnapshot || snapshotIndex < 0 ||
           snapshotIndex >= store.core.states.len ||
           store.payloadIndexesBySnapshot[snapshotIndex] >= 0:
            return false
        previousRejectionSnapshot = snapshotIndex
        if store.rejectionStates[rejectionIndex] ==
               SemanticSnapshotProductionRejectionStaged:
            if snapshotIndex != store.core.candidateIndex ||
               store.core.states[snapshotIndex] !=
                   snapshot_core.SemanticSnapshotStateBuilding:
                return false
            stagedRejectionCount = stagedRejectionCount + 1
            stagedRejectionSnapshotIndex = snapshotIndex
        elif store.rejectionStates[rejectionIndex] ==
                 SemanticSnapshotProductionRejectionCommitted:
            if store.core.states[snapshotIndex] !=
                   snapshot_core.SemanticSnapshotStateRejected:
                return false
        else:
            return false
    if stagedRejectionCount > 1:
        return false
    if store.core.candidateIndex >= 0 &&
       store.core.states[store.core.candidateIndex] ==
           snapshot_core.SemanticSnapshotStateBuilding &&
       store.payloadIndexesBySnapshot[store.core.candidateIndex] < 0 &&
       (stagedRejectionCount != 1 ||
        stagedRejectionSnapshotIndex != store.core.candidateIndex):
        return false
    return true

fn semanticSnapshotProductionStoreShapeValidNoAlloc(
        store: var SemanticSnapshotProductionStore): bool =
    return semanticSnapshotProductionStoreColumnShapeValidNoAlloc(store)

fn SemanticSnapshotProductionStoreInitInto(
        workspaceSessionCid: layout.FixedBytes32,
        out: var SemanticSnapshotProductionStore,
        err: var str): bool =
    var core: snapshot_core.SemanticSnapshotStore
    if !snapshot_core.SemanticSnapshotStoreInitInto(
            workspaceSessionCid, core, err):
        return false
    var store: SemanticSnapshotProductionStore
    store.core = core
    store.payloadIndexesBySnapshot = []
    store.payloadStates = []
    store.payloadSnapshotIndexes = []
    store.payloadSourceVersions = []
    store.payloadBindingReceiptCids = []
    store.payloadSemanticSnapshotCids = []
    store.payloadFactsRootCids = []
    store.payloadCargoCids = []
    store.payloadCompilerFactProjectionCids = []
    store.payloadCompilerFactCounts = []
    store.payloadSemanticFactProjectionCids = []
    store.payloadSemanticFactCounts = []
    store.payloadDebugFactProjectionCids = []
    store.payloadDebugFactCounts = []
    store.payloadQueryProjectionCids = []
    store.payloadQueryIndexCids = []
    store.payloadQueryIndexRootCids = []
    store.payloadDeclarationTableCids = []
    store.payloadPackageIds = []
    store.payloadIdentities = []
    store.payloadBindings = []
    store.payloadValidations = []
    store.payloadTables = []
    store.payloadQueryProjections = []
    store.payloadCsgcBytes = []
    store.rejectionStates = []
    store.rejectionSnapshotIndexes = []
    store.rejectionSourceVersions = []
    store.rejectionFactsRootCids = []
    store.rejectionCargoCids = []
    store.rejectionDiagnosticRootCids = []
    store.rejectionIdentities = []
    store.rejectionBindings = []
    store.rejectionReceipts = []
    store.rejectionFacts = []
    store.rejectionCsgcBytes = []
    out = store
    err = ""
    return true

fn semanticSnapshotProductionPayloadStrictValidateInto(
        store: var SemanticSnapshotProductionStore,
        payloadIndex: int32,
        err: var str): bool =
    if payloadIndex < 0 || payloadIndex >= store.payloadStates.len:
        err = " semantic snapshot production store: payload index invalid"
        return false
    let snapshotIndex = store.payloadSnapshotIndexes[payloadIndex]
    if snapshotIndex < 0 || snapshotIndex >= store.core.states.len ||
       store.payloadSourceVersions[payloadIndex] !=
           store.core.sourceVersions[snapshotIndex] ||
       !layout.FixedBytes32Equal(
           store.payloadBindingReceiptCids[payloadIndex],
           store.core.bindingReceiptCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadSemanticSnapshotCids[payloadIndex],
           store.core.semanticSnapshotCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadFactsRootCids[payloadIndex],
           store.core.csgRootCids[snapshotIndex]):
        err = " semantic snapshot production store: payload binding split"
        return false
    if store.payloadStates[payloadIndex] ==
           SemanticSnapshotProductionPayloadReleased:
        err = ""
        return true
    if store.payloadPackageIds[payloadIndex] == "" ||
       !snapshot_core.PortableSemanticSnapshotIdentityStrictValidateInto(
           store.payloadIdentities[payloadIndex], err) ||
       !snapshot_core.LocalSourceVersionBindingStrictValidateInto(
           store.payloadBindings[payloadIndex],
           store.payloadIdentities[payloadIndex], err) ||
       !snapshot_core.SemanticSnapshotValidationReceiptStrictValidateInto(
           store.payloadValidations[payloadIndex],
           store.payloadBindings[payloadIndex],
           store.payloadIdentities[payloadIndex], err) ||
       store.payloadBindings[payloadIndex].sourceVersion !=
           store.payloadSourceVersions[payloadIndex] ||
       store.payloadTables[payloadIndex].schemaVersion !=
           store.payloadBindings[payloadIndex].schemaVersion ||
       store.payloadTables[payloadIndex].semanticEpoch !=
           store.payloadBindings[payloadIndex].semanticEpoch ||
       !layout.FixedBytes32Equal(
           store.payloadBindings[payloadIndex].bindingReceiptCid,
           store.payloadBindingReceiptCids[payloadIndex]):
        if err == "":
            err = " semantic snapshot production store: retained proof drift"
        return false
    if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
            store.payloadTables[payloadIndex], err) ||
       !query_projection.SemanticSnapshotQueryProjectionStrictValidateInto(
            store.payloadQueryProjections[payloadIndex],
            store.payloadTables[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadIdentities[payloadIndex], err):
        return false
    if !layout.FixedBytes32Equal(
            store.payloadQueryProjectionCids[payloadIndex],
            store.payloadQueryProjections[payloadIndex].projectionCid) ||
       !layout.FixedBytes32Equal(
            store.payloadQueryIndexCids[payloadIndex],
            store.payloadQueryProjections[
                payloadIndex].queryIndex.indexCid) ||
       !layout.FixedBytes32Equal(
            store.payloadQueryIndexRootCids[payloadIndex],
            store.payloadQueryProjections[
                payloadIndex].queryIndex.rootCid) ||
       !layout.FixedBytes32Equal(
            store.payloadValidations[payloadIndex].queryIndexRootCid,
            store.payloadQueryIndexRootCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
            store.payloadDeclarationTableCids[payloadIndex],
            store.payloadTables[payloadIndex].declarations.tableCid) ||
       !layout.FixedBytes32Equal(
            store.payloadDeclarationTableCids[payloadIndex],
            store.payloadQueryProjections[
                payloadIndex].queryIndex.declarationTableCid):
        err = " semantic snapshot production store: query receipt drift"
        return false
    let admitted = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        store.payloadCsgcBytes[payloadIndex],
        store.payloadFactsRootCids[payloadIndex])
    if !admitted.ok ||
       !layout.FixedBytes32Equal(
           admitted.cargoCid, store.payloadCargoCids[payloadIndex]):
        err = " semantic snapshot production store: cargo admission failed"
        return false
    var rebuilt = snapshot_cargo.CsgCompilerSnapshotCargoBuild(
        store.payloadTables[payloadIndex])
    let rebuiltMatches = rebuilt.ok &&
        layout.FixedBytes32Equal(
            rebuilt.factsRootCid,
            store.payloadFactsRootCids[payloadIndex]) &&
        layout.FixedBytes32Equal(
            rebuilt.cargoCid, store.payloadCargoCids[payloadIndex]) &&
        semanticSnapshotProductionProofRootsEqual(
            rebuilt.proofRoots, admitted.proofRoots)
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(rebuilt)
    if !rebuiltMatches:
        err = " semantic snapshot production store: retained tables drifted"
        return false
    if !semanticSnapshotProductionProofRootsEqual(
            semanticSnapshotProductionValidationProofRoots(
                store.payloadValidations[payloadIndex]),
            admitted.proofRoots):
        err = " semantic snapshot production store: validation roots drifted"
        return false
    var compilerFactBundle: compiler_facts.CompilerFactBundle
    if !compiler_facts.CompilerFactsFromSemanticSnapshotInto(
            store.payloadTables[payloadIndex],
            store.payloadIdentities[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadValidations[payloadIndex],
            store.payloadTables[payloadIndex].predecessorReceiptCid,
            store.payloadPackageIds[payloadIndex], compilerFactBundle,
            err) ||
       compilerFactBundle.factCount !=
           store.payloadCompilerFactCounts[payloadIndex] ||
       !layout.FixedBytes32Equal(
           compilerFactBundle.projectionCid,
           store.payloadCompilerFactProjectionCids[payloadIndex]):
        if err == "":
            err = " semantic snapshot production store: CompilerFact drift"
        return false
    var semanticFactBundle: semantic_facts.SemanticFactBundle
    if !semantic_facts.SemanticFactsFromSemanticSnapshotInto(
            store.payloadTables[payloadIndex],
            store.payloadIdentities[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadValidations[payloadIndex],
            store.payloadTables[payloadIndex].predecessorReceiptCid,
            store.payloadPackageIds[payloadIndex], semanticFactBundle,
            err) ||
       semanticFactBundle.factCount !=
           store.payloadSemanticFactCounts[payloadIndex] ||
       !layout.FixedBytes32Equal(
           semanticFactBundle.projectionCid,
           store.payloadSemanticFactProjectionCids[payloadIndex]):
        if err == "":
            err = " semantic snapshot production store: SemanticFact drift"
        return false
    var debugFactBundle: debug_facts.DebugFactBundle
    if !debug_facts.DebugFactsFromSemanticSnapshotInto(
            store.payloadTables[payloadIndex],
            store.payloadIdentities[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadValidations[payloadIndex],
            store.payloadTables[payloadIndex].predecessorReceiptCid,
            store.payloadPackageIds[payloadIndex], debugFactBundle,
            err) ||
       debugFactBundle.factCount !=
           store.payloadDebugFactCounts[payloadIndex] ||
       !layout.FixedBytes32Equal(
           debugFactBundle.projectionCid,
           store.payloadDebugFactProjectionCids[payloadIndex]):
        if err == "":
            err = " semantic snapshot production store: DebugFact drift"
        return false
    err = ""
    return true

fn SemanticSnapshotProductionStoreStrictValidateInto(
        store: var SemanticSnapshotProductionStore,
        err: var str): bool =
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       !snapshot_core.SemanticSnapshotStoreStrictValidateInto(
            store.core, err):
        if err == "":
            err = " semantic snapshot production store: invalid shape"
        return false
    for payloadIndex in 0..<store.payloadStates.len:
        if !semanticSnapshotProductionPayloadStrictValidateInto(
                store, payloadIndex, err):
            return false
    for rejectionIndex in 0..<store.rejectionSnapshotIndexes.len:
        let snapshotIndex = store.rejectionSnapshotIndexes[rejectionIndex]
        let rejectionState = store.rejectionStates[rejectionIndex]
        if snapshotIndex < 0 || snapshotIndex >= store.core.states.len ||
           (rejectionState != SemanticSnapshotProductionRejectionStaged &&
            rejectionState !=
                SemanticSnapshotProductionRejectionCommitted) ||
           (rejectionState == SemanticSnapshotProductionRejectionStaged &&
            (snapshotIndex != store.core.candidateIndex ||
             store.core.states[snapshotIndex] !=
                 snapshot_core.SemanticSnapshotStateBuilding ||
             !layout.FixedBytes32Equal(
                 store.core.failureReceiptCids[snapshotIndex],
                 layout.FixedBytes32()))) ||
           (rejectionState == SemanticSnapshotProductionRejectionCommitted &&
            store.core.states[snapshotIndex] !=
                snapshot_core.SemanticSnapshotStateRejected) ||
           store.rejectionSourceVersions[rejectionIndex] !=
               store.core.sourceVersions[snapshotIndex] ||
           store.rejectionBindings[rejectionIndex].sourceVersion !=
               store.rejectionSourceVersions[rejectionIndex] ||
           store.rejectionFacts[rejectionIndex].sourceVersion !=
               store.rejectionBindings[rejectionIndex].sourceVersion ||
           !layout.FixedBytes32Equal(
               store.rejectionFacts[
                   rejectionIndex].sourceIdentityReceiptCid,
               store.rejectionIdentities[
                   rejectionIndex].sourceIdentityReceiptCid) ||
           !layout.FixedBytes32Equal(
               store.rejectionFacts[rejectionIndex].worldHeadCid,
               store.rejectionIdentities[rejectionIndex].worldHeadCid) ||
           !layout.FixedBytes32Equal(
               store.rejectionFacts[rejectionIndex].compilerExecutionCid,
               store.rejectionIdentities[rejectionIndex].compilerCid) ||
           !layout.FixedBytes32Equal(
               store.rejectionFacts[rejectionIndex].sourceBundleCid,
               store.rejectionIdentities[rejectionIndex].sourceBundleCid) ||
           !layout.FixedBytes32Equal(
               store.rejectionFactsRootCids[rejectionIndex],
               store.rejectionIdentities[rejectionIndex].csgRootCid) ||
           !layout.FixedBytes32Equal(
               store.rejectionFactsRootCids[rejectionIndex],
               store.core.csgRootCids[snapshotIndex]) ||
           !layout.FixedBytes32Equal(
               store.rejectionCargoCids[rejectionIndex],
               hash256.Sha256Fixed(layout.ByteSpanFromBytes(
                   store.rejectionCsgcBytes[rejectionIndex]))) ||
           !snapshot_core.LocalSourceVersionBindingStrictValidateInto(
               store.rejectionBindings[rejectionIndex],
               store.rejectionIdentities[rejectionIndex], err) ||
           !snapshot_core.SemanticSnapshotFailureReceiptStrictValidateInto(
               store.rejectionReceipts[rejectionIndex],
               store.rejectionBindings[rejectionIndex],
               store.rejectionIdentities[rejectionIndex], err) ||
           (rejectionState == SemanticSnapshotProductionRejectionCommitted &&
            !layout.FixedBytes32Equal(
                store.rejectionReceipts[
                    rejectionIndex].failureReceiptCid,
                store.core.failureReceiptCids[snapshotIndex])) ||
           !layout.FixedBytes32Equal(
               store.rejectionReceipts[
                   rejectionIndex].diagnosticRootCid,
               store.rejectionDiagnosticRootCids[rejectionIndex]) ||
           !snapshot_cargo.CsgCompilerSnapshotFailureFactsStrictValidateInto(
               store.rejectionFacts[rejectionIndex], err):
            if err == "":
                err = " semantic snapshot production store: rejected payload binding split"
            return false
        let admitted = snapshot_cargo.CsgCompilerSnapshotFailureCargoVerify(
            store.rejectionCsgcBytes[rejectionIndex],
            store.rejectionFactsRootCids[rejectionIndex])
        var rebuilt =
            snapshot_cargo.CsgCompilerSnapshotFailureCargoBuild(
                store.rejectionFacts[rejectionIndex])
        let matches = admitted.ok && rebuilt.ok &&
            layout.FixedBytes32Equal(
                admitted.cargoCid,
                store.rejectionCargoCids[rejectionIndex]) &&
            layout.FixedBytes32Equal(
                admitted.diagnosticRootCid,
                store.rejectionDiagnosticRootCids[rejectionIndex]) &&
            layout.FixedBytes32Equal(
                rebuilt.factsRootCid,
                store.rejectionFactsRootCids[rejectionIndex]) &&
            layout.FixedBytes32Equal(
                rebuilt.cargoCid,
                store.rejectionCargoCids[rejectionIndex]) &&
            layout.FixedBytes32Equal(
                rebuilt.diagnosticRootCid,
                store.rejectionDiagnosticRootCids[rejectionIndex])
        snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(rebuilt)
        if !matches:
            err = " semantic snapshot production store: rejected CSG cargo drift"
            return false
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionAcceptSourceEventInto(
        eventState: var snapshot_core.WorkspaceSourceEventState,
        store: var SemanticSnapshotProductionStore,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        clientVersion: int64,
        sourceVersionOut: var int64,
        err: var str): bool =
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store):
        err = " semantic snapshot production store: invalid event store"
        return false
    let cancelledSnapshotIndex = store.core.candidateIndex
    var cancelledPayloadIndex: int32 = -1
    if cancelledSnapshotIndex >= 0:
        cancelledPayloadIndex =
            store.payloadIndexesBySnapshot[cancelledSnapshotIndex]
        if cancelledPayloadIndex < 0 ||
           store.payloadStates[cancelledPayloadIndex] !=
               SemanticSnapshotProductionPayloadStaged:
            err = " semantic snapshot production store: candidate payload split"
            return false
    if !snapshot_core.SemanticSnapshotAcceptSourceEventInto(
        eventState, store.core, eventKind, documentCid, clientVersion,
        sourceVersionOut, err):
        return false
    if cancelledPayloadIndex >= 0:
        if store.core.states[cancelledSnapshotIndex] !=
               snapshot_core.SemanticSnapshotStateCancelled:
            panic("semantic_snapshot_production_cancel_commit_drift")
        store.payloadStates[cancelledPayloadIndex] =
            SemanticSnapshotProductionPayloadPendingReclaim
        semanticSnapshotProductionReleasePayloadForSnapshot(
            store, cancelledSnapshotIndex)
    return true

@borrows
fn SemanticSnapshotProductionAcceptSourceFileEventInto(
        eventState: var snapshot_core.WorkspaceSourceEventState,
        store: var SemanticSnapshotProductionStore,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        renameTargetDocumentCid: layout.FixedBytes32,
        sourceVersionOut: var int64,
        err: var str): bool =
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store):
        err = " semantic snapshot production store: invalid file event store"
        return false
    let cancelledSnapshotIndex = store.core.candidateIndex
    var cancelledPayloadIndex: int32 = -1
    if cancelledSnapshotIndex >= 0:
        cancelledPayloadIndex =
            store.payloadIndexesBySnapshot[cancelledSnapshotIndex]
        if cancelledPayloadIndex < 0 ||
           store.payloadStates[cancelledPayloadIndex] !=
               SemanticSnapshotProductionPayloadStaged:
            err = " semantic snapshot production store: candidate payload split"
            return false
    if !snapshot_core.SemanticSnapshotAcceptSourceFileEventInto(
            eventState, store.core, eventKind, documentCid,
            renameTargetDocumentCid, sourceVersionOut, err):
        return false
    if cancelledPayloadIndex >= 0:
        if store.core.states[cancelledSnapshotIndex] !=
               snapshot_core.SemanticSnapshotStateCancelled:
            panic("semantic_snapshot_production_file_cancel_commit_drift")
        store.payloadStates[cancelledPayloadIndex] =
            SemanticSnapshotProductionPayloadPendingReclaim
        semanticSnapshotProductionReleasePayloadForSnapshot(
            store, cancelledSnapshotIndex)
    return true

# The failure CSGC bytes are independently rebuilt and admitted before a
# Building row is created; the row is then synchronously moved to Rejected.
fn semanticSnapshotProductionRejectFailureCargoInto(
        eventState: snapshot_core.WorkspaceSourceEventState,
        store: var SemanticSnapshotProductionStore,
        worldHeadCid: layout.FixedBytes32,
        compilerExecution: execution.CompilerExecutionIdentity,
        facts: var snapshot_cargo.CsgCompilerSnapshotFailureFacts,
        expectedSourceIdentityKind: int32,
        rejectedIndexOut: var int32,
        err: var str): bool =
    rejectedIndexOut = -1
    let executionVerified =
        execution.CompilerExecutionIdentityVerify(compilerExecution)
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       IsErr(executionVerified) ||
       eventState.lastAcceptedSourceVersion !=
           store.core.currentSourceVersion ||
       eventState.lastAcceptedSourceVersion != facts.sourceVersion ||
       !layout.FixedBytes32Equal(
           eventState.workspaceSessionCid, store.core.workspaceSessionCid) ||
       facts.sourceIdentityKind != expectedSourceIdentityKind ||
       !layout.FixedBytes32Equal(facts.worldHeadCid, worldHeadCid) ||
       !layout.FixedBytes32Equal(
           facts.compilerExecutionCid,
           compilerExecution.executionRaw32) ||
       !snapshot_cargo.CsgCompilerSnapshotFailureFactsStrictValidateInto(
           facts, err):
        if err == "":
            err = IsErr(executionVerified) ? Error(executionVerified) :
                " semantic snapshot production: invalid canonical failure"
        return false
    var cargo = snapshot_cargo.CsgCompilerSnapshotFailureCargoBuild(facts)
    if !cargo.ok:
        err = cargo.error
        return false
    let admitted = snapshot_cargo.CsgCompilerSnapshotFailureCargoVerify(
        cargo.csgcBytes, cargo.factsRootCid)
    if !admitted.ok ||
       !layout.FixedBytes32Equal(admitted.cargoCid, cargo.cargoCid) ||
       !layout.FixedBytes32Equal(
           admitted.diagnosticRootCid, cargo.diagnosticRootCid):
        snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(cargo)
        err = " semantic snapshot production: canonical failure admission split"
        return false
    var identity: snapshot_core.PortableSemanticSnapshotIdentity
    if !snapshot_core.PortableSemanticSnapshotIdentityMakeInto(
            facts.sourceIdentityReceiptCid, worldHeadCid,
            compilerExecution.executionRaw32, facts.sourceBundleCid,
            cargo.factsRootCid, identity, err):
        snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(cargo)
        return false
    var binding: snapshot_core.LocalSourceVersionBinding
    if !snapshot_core.LocalSourceVersionBindingMakeInto(
            eventState, identity, binding, err):
        snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(cargo)
        return false
    var failure: snapshot_core.SemanticSnapshotFailureReceipt
    if !snapshot_core.SemanticSnapshotFailureReceiptMakeInto(
            binding, identity,
            SemanticSnapshotProductionFailureAdmissionGap,
            cargo.diagnosticRootCid, failure, err):
        snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(cargo)
        return false
    var candidateIndex: int32
    if !snapshot_core.SemanticSnapshotStoreBeginCandidateInto(
            store.core, binding, identity, candidateIndex, err):
        snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(cargo)
        return false
    if candidateIndex != store.payloadIndexesBySnapshot.len:
        panic("semantic_snapshot_production_canonical_failure_index_drift")
    var failureStage: snapshot_core.SemanticSnapshotCandidateFailureStage
    if !snapshot_core.SemanticSnapshotStoreStageCandidateFailureInto(
            store.core, binding, identity, failure, failureStage, err):
        panic("semantic_snapshot_production_canonical_failure_stage_drift")
    add(store.payloadIndexesBySnapshot, -1)
    var ownedBytes = cargo.csgcBytes
    cargo.csgcBytes = rawbytes.EmptyBytes()
    snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(cargo)
    add(store.rejectionStates,
        SemanticSnapshotProductionRejectionStaged)
    add(store.rejectionSnapshotIndexes, candidateIndex)
    add(store.rejectionSourceVersions, binding.sourceVersion)
    add(store.rejectionFactsRootCids, identity.csgRootCid)
    add(store.rejectionCargoCids, admitted.cargoCid)
    add(store.rejectionDiagnosticRootCids,
        admitted.diagnosticRootCid)
    add(store.rejectionIdentities, identity)
    add(store.rejectionBindings,
        semanticSnapshotProductionBindingClone(binding))
    add(store.rejectionReceipts, failure)
    add(store.rejectionFacts,
        snapshot_cargo.CsgCompilerSnapshotFailureFactsClone(facts))
    add(store.rejectionCsgcBytes, ownedBytes)
    snapshot_core.SemanticSnapshotStoreCommitRejectedCandidateInto(
        store.core, failureStage, rejectedIndexOut)
    store.rejectionStates[store.rejectionStates.len - 1] =
        SemanticSnapshotProductionRejectionCommitted
    if rejectedIndexOut != candidateIndex:
        panic("semantic_snapshot_production_canonical_failure_commit_drift")
    err = ""
    return true

fn SemanticSnapshotProductionRejectCanonicalFailureInto(
        eventState: snapshot_core.WorkspaceSourceEventState,
        store: var SemanticSnapshotProductionStore,
        worldHeadCid: layout.FixedBytes32,
        compilerExecution: execution.CompilerExecutionIdentity,
        facts: var snapshot_cargo.CsgCompilerSnapshotFailureFacts,
        rejectedIndexOut: var int32,
        err: var str): bool =
    return semanticSnapshotProductionRejectFailureCargoInto(
        eventState, store, worldHeadCid, compilerExecution, facts,
        snapshot_cargo.CsgCompilerSnapshotFailureSourceIdentityCanonicalFacts,
        rejectedIndexOut, err)

fn SemanticSnapshotProductionRejectPortableFailureInto(
        eventState: snapshot_core.WorkspaceSourceEventState,
        store: var SemanticSnapshotProductionStore,
        worldHeadCid: layout.FixedBytes32,
        compilerExecution: execution.CompilerExecutionIdentity,
        facts: var snapshot_cargo.CsgCompilerSnapshotFailureFacts,
        rejectedIndexOut: var int32,
        err: var str): bool =
    return semanticSnapshotProductionRejectFailureCargoInto(
        eventState, store, worldHeadCid, compilerExecution, facts,
        snapshot_cargo.CsgCompilerSnapshotFailureSourceIdentityPortableReceipt,
        rejectedIndexOut, err)

fn SemanticSnapshotProductionRejectFailureInto(
        eventState: snapshot_core.WorkspaceSourceEventState,
        store: var SemanticSnapshotProductionStore,
        csg: var ccsg.CompilerCsg,
        tables: var snapshot_schema.CsgCompilerSnapshotTables,
        admission:
            var snapshot_builder.CompilerSnapshotProductionAdmissionReceipt,
        worldHeadCid: layout.FixedBytes32,
        compilerExecution: execution.CompilerExecutionIdentity,
        facts: var snapshot_cargo.CsgCompilerSnapshotFailureFacts,
        rejectedIndexOut: var int32,
        err: var str): bool =
    rejectedIndexOut = -1
    let executionVerified =
        execution.CompilerExecutionIdentityVerify(compilerExecution)
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       IsErr(executionVerified) ||
       eventState.lastAcceptedSourceVersion !=
           store.core.currentSourceVersion ||
       eventState.lastAcceptedSourceVersion != facts.sourceVersion ||
       !layout.FixedBytes32Equal(
           eventState.workspaceSessionCid, store.core.workspaceSessionCid) ||
       !snapshot_builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
           csg, tables, admission, err) ||
       !snapshot_cargo.CsgCompilerSnapshotFailureFactsStrictValidateInto(
           facts, err):
        if err == "":
            err = IsErr(executionVerified) ? Error(executionVerified) :
                " semantic snapshot production: invalid rejected candidate"
        return false
    var structuredAuthorityMatches =
        facts.structuredDiagnosticAuthority.authorityKinds.len ==
            csg.diagnosticFailureAuthority.authorityKinds.len &&
        layout.FixedBytes32Equal(
            facts.structuredDiagnosticAuthority.authorityRootCid,
            csg.diagnosticFailureAuthority.authorityRootCid) &&
        facts.structuredDiagnosticProducerProjectionCids.len ==
            csg.diagnosticFailureProducerProjectionCids.len
    if structuredAuthorityMatches:
        for row in 0..<
                facts.structuredDiagnosticProducerProjectionCids.len:
            if !layout.FixedBytes32Equal(
                    facts.structuredDiagnosticProducerProjectionCids[row],
                    csg.diagnosticFailureProducerProjectionCids[row]):
                structuredAuthorityMatches = false
    if !layout.FixedBytes32Equal(facts.worldHeadCid, worldHeadCid) ||
       !layout.FixedBytes32Equal(
           facts.compilerExecutionCid, compilerExecution.executionRaw32) ||
       !layout.FixedBytes32Equal(
           facts.sourceIdentityReceiptCid,
           csg.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(facts.sourceBundleCid,
                                 csg.sourceBundleCid) ||
       !layout.FixedBytes32Equal(facts.parserReceiptCid,
           csg.parserNormalizedExprReceipt.envelope.receiptRaw32) ||
       !layout.FixedBytes32Equal(facts.compilerCsgTransitionReceiptCid,
           csg.csgTransitionReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(facts.importGraphCid,
           csg.sourceIdentityReceipt.importGraphCid) ||
       !layout.FixedBytes32Equal(facts.canonicalGraphCid,
                                 csg.canonicalGraphCid) ||
       !layout.FixedBytes32Equal(facts.graphCid, csg.graphCid) ||
       !structuredAuthorityMatches ||
       !layout.FixedBytes32Equal(facts.retainedFactsCid,
                                 admission.retainedFactsCid) ||
       !layout.FixedBytes32Equal(facts.admissionReceiptCid,
                                 admission.receiptCid) ||
       facts.completedStageBitmap != admission.completedStageBitmap ||
       facts.missingFactBitmap != admission.missingFactBitmap:
        err = " semantic snapshot production: rejected CSG identity split"
        return false
    return semanticSnapshotProductionRejectFailureCargoInto(
        eventState, store, worldHeadCid, compilerExecution, facts,
        snapshot_cargo.CsgCompilerSnapshotFailureSourceIdentityPortableReceipt,
        rejectedIndexOut, err)

fn SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
        store: var SemanticSnapshotProductionStore,
        out: var SemanticSnapshotProductionRejectedDiagnostics,
        err: var str): bool =
    if !snapshot_cargo.CsgCompilerSnapshotFailureFactsReleased(out.facts):
        var releaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            out.facts, releaseReceipt)
    out = SemanticSnapshotProductionRejectedDiagnostics()
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       store.rejectionSnapshotIndexes.len <= 0:
        err = " semantic snapshot production: current version is not rejected"
        return false
    let rejectionIndex = store.rejectionSnapshotIndexes.len - 1
    let snapshotIndex = store.rejectionSnapshotIndexes[rejectionIndex]
    if snapshotIndex < 0 || snapshotIndex >= store.core.states.len ||
       store.rejectionStates[rejectionIndex] !=
           SemanticSnapshotProductionRejectionCommitted ||
       store.core.states[snapshotIndex] !=
           snapshot_core.SemanticSnapshotStateRejected ||
       store.core.sourceVersions[snapshotIndex] !=
           store.core.currentSourceVersion ||
       store.rejectionSourceVersions[rejectionIndex] !=
           store.core.currentSourceVersion:
        err = " semantic snapshot production: current version is not rejected"
        return false
    if !snapshot_core.PortableSemanticSnapshotIdentityStrictValidateInto(
            store.rejectionIdentities[rejectionIndex], err) ||
       !snapshot_core.LocalSourceVersionBindingStrictValidateInto(
            store.rejectionBindings[rejectionIndex],
            store.rejectionIdentities[rejectionIndex], err) ||
       !snapshot_core.SemanticSnapshotFailureReceiptStrictValidateInto(
            store.rejectionReceipts[rejectionIndex],
            store.rejectionBindings[rejectionIndex],
            store.rejectionIdentities[rejectionIndex], err) ||
       !layout.FixedBytes32Equal(
           store.rejectionBindings[rejectionIndex].bindingReceiptCid,
           store.core.bindingReceiptCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.rejectionIdentities[
               rejectionIndex].semanticSnapshotCid,
           store.core.semanticSnapshotCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.rejectionIdentities[rejectionIndex].csgRootCid,
           store.rejectionFactsRootCids[rejectionIndex]) ||
       !layout.FixedBytes32Equal(
           store.rejectionIdentities[rejectionIndex].csgRootCid,
           store.core.csgRootCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.rejectionReceipts[rejectionIndex].failureReceiptCid,
           store.core.failureReceiptCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.rejectionReceipts[rejectionIndex].diagnosticRootCid,
           store.rejectionDiagnosticRootCids[rejectionIndex]) ||
       store.rejectionBindings[rejectionIndex].sourceVersion !=
           store.rejectionSourceVersions[rejectionIndex] ||
       store.rejectionFacts[rejectionIndex].sourceVersion !=
           store.rejectionBindings[rejectionIndex].sourceVersion ||
       !layout.FixedBytes32Equal(
           store.rejectionFacts[rejectionIndex].sourceIdentityReceiptCid,
           store.rejectionIdentities[
               rejectionIndex].sourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(
           store.rejectionFacts[rejectionIndex].worldHeadCid,
           store.rejectionIdentities[rejectionIndex].worldHeadCid) ||
       !layout.FixedBytes32Equal(
           store.rejectionFacts[rejectionIndex].compilerExecutionCid,
           store.rejectionIdentities[rejectionIndex].compilerCid) ||
       !layout.FixedBytes32Equal(
           store.rejectionFacts[rejectionIndex].sourceBundleCid,
           store.rejectionIdentities[rejectionIndex].sourceBundleCid):
        if err == "":
            err = " semantic snapshot production: rejected diagnostics binding drift"
        return false
    let admitted = snapshot_cargo.CsgCompilerSnapshotFailureCargoVerify(
        store.rejectionCsgcBytes[rejectionIndex],
        store.rejectionFactsRootCids[rejectionIndex])
    var factsErr: str
    var rebuilt =
        snapshot_cargo.CsgCompilerSnapshotFailureCargoBuild(
            store.rejectionFacts[rejectionIndex])
    let admittedFactsMatch = admitted.ok && rebuilt.ok &&
        snapshot_cargo.CsgCompilerSnapshotFailureFactsStrictValidateInto(
            store.rejectionFacts[rejectionIndex], factsErr) &&
        layout.FixedBytes32Equal(
            admitted.cargoCid, store.rejectionCargoCids[rejectionIndex]) &&
        layout.FixedBytes32Equal(
            admitted.diagnosticRootCid,
            store.rejectionDiagnosticRootCids[rejectionIndex]) &&
        layout.FixedBytes32Equal(
            rebuilt.factsRootCid,
            store.rejectionFactsRootCids[rejectionIndex]) &&
        layout.FixedBytes32Equal(
            rebuilt.cargoCid, store.rejectionCargoCids[rejectionIndex]) &&
        layout.FixedBytes32Equal(
            rebuilt.diagnosticRootCid,
            store.rejectionDiagnosticRootCids[rejectionIndex])
    snapshot_cargo.CsgCompilerSnapshotFailureCargoRelease(rebuilt)
    if !admittedFactsMatch:
        err = " semantic snapshot production: rejected diagnostics cargo drift"
        return false
    var result: SemanticSnapshotProductionRejectedDiagnostics
    result.sourceVersion = store.rejectionSourceVersions[rejectionIndex]
    result.semanticSnapshotCid =
        store.rejectionIdentities[rejectionIndex].semanticSnapshotCid
    result.bindingReceiptCid =
        store.rejectionBindings[rejectionIndex].bindingReceiptCid
    result.factsRootCid = store.rejectionFactsRootCids[rejectionIndex]
    result.cargoCid = store.rejectionCargoCids[rejectionIndex]
    result.diagnosticRootCid =
        store.rejectionDiagnosticRootCids[rejectionIndex]
    result.facts =
        snapshot_cargo.CsgCompilerSnapshotFailureFactsClone(
            store.rejectionFacts[rejectionIndex])
    out = result
    err = ""
    return true

fn semanticSnapshotProductionReleasePayloadForSnapshot(
        store: var SemanticSnapshotProductionStore,
        snapshotIndex: int32) =
    if snapshotIndex < 0 || snapshotIndex >=
           store.payloadIndexesBySnapshot.len:
        panic("semantic_snapshot_production_release_snapshot_index")
    let payloadIndex = store.payloadIndexesBySnapshot[snapshotIndex]
    if payloadIndex < 0:
        return
    if (store.core.states[snapshotIndex] !=
            snapshot_core.SemanticSnapshotStateReleased &&
        store.core.states[snapshotIndex] !=
            snapshot_core.SemanticSnapshotStateCancelled) ||
       store.payloadStates[payloadIndex] !=
           SemanticSnapshotProductionPayloadPendingReclaim:
        panic("semantic_snapshot_production_release_state")
    rawbytes.BytesFree(store.payloadCsgcBytes[payloadIndex])
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        store.payloadTables[payloadIndex].declarations)
    store.payloadTables[payloadIndex] =
        snapshot_schema.CsgCompilerSnapshotTables()
    store.payloadQueryProjections[payloadIndex] =
        query_projection.SemanticSnapshotQueryProjection()
    store.payloadQueryProjectionCids[payloadIndex] = layout.FixedBytes32()
    store.payloadQueryIndexCids[payloadIndex] = layout.FixedBytes32()
    store.payloadQueryIndexRootCids[payloadIndex] = layout.FixedBytes32()
    store.payloadDeclarationTableCids[payloadIndex] = layout.FixedBytes32()
    store.payloadPackageIds[payloadIndex] = ""
    store.payloadIdentities[payloadIndex] =
        snapshot_core.PortableSemanticSnapshotIdentity()
    store.payloadBindings[payloadIndex] =
        snapshot_core.LocalSourceVersionBinding()
    store.payloadValidations[payloadIndex] =
        snapshot_core.SemanticSnapshotValidationReceipt()
    store.payloadStates[payloadIndex] =
        SemanticSnapshotProductionPayloadReleased
    store.payloadIndexesBySnapshot[snapshotIndex] = -1

fn SemanticSnapshotProductionStoreReclaimSnapshotInto(
        store: var SemanticSnapshotProductionStore,
        snapshotIndex: int32,
        err: var str): bool =
    if !semanticSnapshotProductionStoreColumnShapeValidNoAlloc(store) ||
       snapshotIndex < 0 ||
       snapshotIndex >= store.payloadIndexesBySnapshot.len:
        err = " semantic snapshot production store: invalid reclaim state"
        return false
    let payloadIndex = store.payloadIndexesBySnapshot[snapshotIndex]
    if payloadIndex < 0 || payloadIndex >= store.payloadStates.len ||
       store.payloadStates[payloadIndex] !=
           SemanticSnapshotProductionPayloadPendingReclaim ||
       store.payloadSnapshotIndexes[payloadIndex] != snapshotIndex ||
       (store.core.states[snapshotIndex] !=
            snapshot_core.SemanticSnapshotStateReleased &&
        store.core.states[snapshotIndex] !=
            snapshot_core.SemanticSnapshotStateCancelled):
        err = " semantic snapshot production store: snapshot is not reclaimable"
        return false
    semanticSnapshotProductionReleasePayloadForSnapshot(store, snapshotIndex)
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionStageCandidateInto(
        store: var SemanticSnapshotProductionStore,
        candidate: var SemanticSnapshotProductionCandidate,
        csg: var ccsg.CompilerCsg,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        stagedIndexOut: var int32,
        err: var str): bool =
    stagedIndexOut = -1
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       !semanticSnapshotProductionCandidateAdmissionStrictValidateInto(
            candidate, csg, universe, compilerExecution, err):
        if err == "":
            err = " semantic snapshot production store: invalid commit input"
        return false
    var ownedTables = snapshot_schema.CsgCompilerSnapshotTablesClone(
        candidate.tables)
    let ownedQueryProjection =
        query_projection.SemanticSnapshotQueryProjectionClone(
            candidate.queryProjection)
    if !query_projection.SemanticSnapshotQueryProjectionStrictValidateInto(
            ownedQueryProjection, ownedTables,
            candidate.binding, candidate.identity, err):
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            ownedTables.declarations)
        return false
    if !layout.FixedBytes32Equal(
            ownedTables.declarations.tableCid,
            ownedQueryProjection.queryIndex.declarationTableCid):
        err = " semantic snapshot production store: declaration table split"
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            ownedTables.declarations)
        return false
    var ownedCargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(
        ownedTables)
    if !ownedCargo.ok ||
       !layout.FixedBytes32Equal(
           ownedCargo.factsRootCid, candidate.identity.csgRootCid) ||
       !layout.FixedBytes32Equal(
           ownedCargo.cargoCid, candidate.cargo.cargoCid) ||
       !semanticSnapshotProductionProofRootsEqual(
           ownedCargo.proofRoots, candidate.cargo.proofRoots):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(ownedCargo)
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            ownedTables.declarations)
        err = " semantic snapshot production store: owned payload mismatch"
        return false
    var compilerFactBundle: compiler_facts.CompilerFactBundle
    if !compiler_facts.CompilerFactsFromSemanticSnapshotInto(
            ownedTables, candidate.identity, candidate.binding,
            candidate.validation, candidate.predecessor.receiptCid,
            csg.packageId, compilerFactBundle, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(ownedCargo)
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            ownedTables.declarations)
        return false
    var semanticFactBundle: semantic_facts.SemanticFactBundle
    if !semantic_facts.SemanticFactsFromSemanticSnapshotInto(
            ownedTables, candidate.identity, candidate.binding,
            candidate.validation, candidate.predecessor.receiptCid,
            csg.packageId, semanticFactBundle, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(ownedCargo)
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            ownedTables.declarations)
        return false
    var debugFactBundle: debug_facts.DebugFactBundle
    if !debug_facts.DebugFactsFromSemanticSnapshotInto(
            ownedTables, candidate.identity, candidate.binding,
            candidate.validation, candidate.predecessor.receiptCid,
            csg.packageId, debugFactBundle, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(ownedCargo)
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            ownedTables.declarations)
        return false
    var candidateIndex: int32
    if !snapshot_core.SemanticSnapshotStoreBeginCandidateInto(
            store.core, candidate.binding, candidate.identity,
            candidateIndex, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(ownedCargo)
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            ownedTables.declarations)
        return false
    if candidateIndex != store.payloadIndexesBySnapshot.len:
        panic("semantic_snapshot_production_payload_index_drift")
    if !snapshot_core.SemanticSnapshotStoreValidateCandidateInto(
            store.core, candidate.binding, candidate.identity,
            candidate.validation, err):
        panic("semantic_snapshot_production_candidate_validation_drift")
    let payloadIndex = store.payloadStates.len
    var ownedBytes = ownedCargo.csgcBytes
    ownedCargo.csgcBytes = rawbytes.EmptyBytes()
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(ownedCargo)
    let ownedBinding =
        semanticSnapshotProductionBindingClone(candidate.binding)
    let ownedIdentity =
        semanticSnapshotProductionIdentityClone(candidate.identity)
    let ownedValidation =
        semanticSnapshotProductionValidationClone(candidate.validation)
    add(store.payloadIndexesBySnapshot, payloadIndex)
    add(store.payloadStates, SemanticSnapshotProductionPayloadStaged)
    add(store.payloadSnapshotIndexes, candidateIndex)
    add(store.payloadSourceVersions, candidate.binding.sourceVersion)
    add(store.payloadBindingReceiptCids,
        layout.FixedBytes32Copy(candidate.binding.bindingReceiptCid))
    add(store.payloadSemanticSnapshotCids,
        layout.FixedBytes32Copy(candidate.identity.semanticSnapshotCid))
    add(store.payloadFactsRootCids,
        layout.FixedBytes32Copy(candidate.identity.csgRootCid))
    add(store.payloadCargoCids,
        layout.FixedBytes32Copy(candidate.cargo.cargoCid))
    add(store.payloadCompilerFactProjectionCids,
        layout.FixedBytes32Copy(compilerFactBundle.projectionCid))
    add(store.payloadCompilerFactCounts, compilerFactBundle.factCount)
    add(store.payloadSemanticFactProjectionCids,
        layout.FixedBytes32Copy(semanticFactBundle.projectionCid))
    add(store.payloadSemanticFactCounts, semanticFactBundle.factCount)
    add(store.payloadDebugFactProjectionCids,
        layout.FixedBytes32Copy(debugFactBundle.projectionCid))
    add(store.payloadDebugFactCounts, debugFactBundle.factCount)
    add(store.payloadQueryProjectionCids,
        layout.FixedBytes32Copy(ownedQueryProjection.projectionCid))
    add(store.payloadQueryIndexCids,
        layout.FixedBytes32Copy(ownedQueryProjection.queryIndex.indexCid))
    add(store.payloadQueryIndexRootCids,
        layout.FixedBytes32Copy(ownedQueryProjection.queryIndex.rootCid))
    add(store.payloadDeclarationTableCids,
        layout.FixedBytes32Copy(ownedTables.declarations.tableCid))
    add(store.payloadPackageIds, parser.ParserOwnedText(csg.packageId))
    add(store.payloadBindings, ownedBinding)
    add(store.payloadIdentities, ownedIdentity)
    add(store.payloadValidations, ownedValidation)
    add(store.payloadTables, ownedTables)
    add(store.payloadQueryProjections, ownedQueryProjection)
    add(store.payloadCsgcBytes, ownedBytes)
    stagedIndexOut = candidateIndex
    err = ""
    return true

# Stage owns every allocation, clone, cargo admission and fact projection.
# Commit accepts only the already-validated row and flips scalar state/index
# fields under the same exclusive store borrow. Reclaim is deliberately
# separate, so publication cannot free the previous payload.
fn SemanticSnapshotProductionCommitCandidateInto(
        store: var SemanticSnapshotProductionStore,
        stagedIndex: int32,
        publishedIndexOut: var int32,
        reclaimSnapshotIndexOut: var int32) =
    publishedIndexOut = -1
    reclaimSnapshotIndexOut = -1
    if !semanticSnapshotProductionStoreColumnShapeValidNoAlloc(store) ||
       stagedIndex < 0 || stagedIndex != store.core.candidateIndex ||
       stagedIndex >= store.payloadIndexesBySnapshot.len ||
       store.core.states[stagedIndex] !=
           snapshot_core.SemanticSnapshotStateValidated:
        panic("semantic_snapshot_production_publish_commit_stage_drift")
    let payloadIndex = store.payloadIndexesBySnapshot[stagedIndex]
    if payloadIndex < 0 || payloadIndex >= store.payloadStates.len ||
       store.payloadStates[payloadIndex] !=
           SemanticSnapshotProductionPayloadStaged ||
       store.payloadSnapshotIndexes[payloadIndex] != stagedIndex ||
       store.payloadSourceVersions[payloadIndex] !=
           store.core.sourceVersions[stagedIndex] ||
       !layout.FixedBytes32Equal(
           store.payloadBindingReceiptCids[payloadIndex],
           store.core.bindingReceiptCids[stagedIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadSemanticSnapshotCids[payloadIndex],
           store.core.semanticSnapshotCids[stagedIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadFactsRootCids[payloadIndex],
           store.core.csgRootCids[stagedIndex]) ||
       layout.FixedBytes32Equal(
           store.payloadDeclarationTableCids[payloadIndex],
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           store.payloadDeclarationTableCids[payloadIndex],
           store.payloadTables[payloadIndex].declarations.tableCid) ||
       !layout.FixedBytes32Equal(
           store.payloadDeclarationTableCids[payloadIndex],
           store.payloadQueryProjections[
               payloadIndex].queryIndex.declarationTableCid):
        panic("semantic_snapshot_production_publish_commit_payload_drift")
    let previousPublished = store.core.publishedIndex
    var previousPayloadIndex: int32 = -1
    if previousPublished >= 0:
        previousPayloadIndex =
            store.payloadIndexesBySnapshot[previousPublished]
        if previousPayloadIndex < 0 ||
           store.payloadStates[previousPayloadIndex] !=
               SemanticSnapshotProductionPayloadLive ||
           store.payloadSnapshotIndexes[previousPayloadIndex] !=
               previousPublished ||
           store.payloadSourceVersions[previousPayloadIndex] !=
               store.core.sourceVersions[previousPublished] ||
           !layout.FixedBytes32Equal(
               store.payloadBindingReceiptCids[previousPayloadIndex],
               store.core.bindingReceiptCids[previousPublished]) ||
           !layout.FixedBytes32Equal(
               store.payloadSemanticSnapshotCids[previousPayloadIndex],
               store.core.semanticSnapshotCids[previousPublished]) ||
           !layout.FixedBytes32Equal(
               store.payloadFactsRootCids[previousPayloadIndex],
               store.core.csgRootCids[previousPublished]) ||
           !layout.FixedBytes32Equal(
               store.payloadDeclarationTableCids[previousPayloadIndex],
               store.payloadTables[
                   previousPayloadIndex].declarations.tableCid) ||
           !layout.FixedBytes32Equal(
               store.payloadDeclarationTableCids[previousPayloadIndex],
               store.payloadQueryProjections[
                   previousPayloadIndex].queryIndex.declarationTableCid):
            panic("semantic_snapshot_production_publish_commit_previous_drift")
    snapshot_core.SemanticSnapshotStoreCommitCandidateInto(
        store.core, publishedIndexOut)
    store.payloadStates[payloadIndex] =
        SemanticSnapshotProductionPayloadLive
    if previousPublished >= 0 &&
       store.core.states[previousPublished] ==
           snapshot_core.SemanticSnapshotStateReleased:
        store.payloadStates[previousPayloadIndex] =
            SemanticSnapshotProductionPayloadPendingReclaim
        reclaimSnapshotIndexOut = previousPublished
    if publishedIndexOut != stagedIndex:
        panic("semantic_snapshot_production_publish_commit_index_drift")

@borrows
fn semanticSnapshotProductionPinnedPayloadInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        payloadIndexOut: var int32,
        err: var str): bool =
    payloadIndexOut = -1
    if !pin.active || !pin.corePin.active ||
       !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       pin.corePin.snapshotIndex < 0 ||
       pin.corePin.snapshotIndex >= store.core.states.len:
        err = " semantic snapshot production pin: invalid shape"
        return false
    let snapshotIndex = pin.corePin.snapshotIndex
    if (store.core.states[snapshotIndex] !=
            snapshot_core.SemanticSnapshotStatePublished &&
        store.core.states[snapshotIndex] !=
            snapshot_core.SemanticSnapshotStateRetired) ||
       store.core.borrowCounts[snapshotIndex] <= 0 ||
       pin.corePin.schemaVersion !=
           store.core.schemaVersions[snapshotIndex] ||
       pin.corePin.semanticEpoch !=
           store.core.semanticEpochs[snapshotIndex] ||
       pin.corePin.sourceVersion != store.core.sourceVersions[snapshotIndex] ||
       !layout.FixedBytes32Equal(
           pin.corePin.bindingReceiptCid,
           store.core.bindingReceiptCids[snapshotIndex]):
        err = " semantic snapshot production pin: core identity mismatch"
        return false
    let payloadIndex = store.payloadIndexesBySnapshot[snapshotIndex]
    if payloadIndex < 0 || payloadIndex != pin.payloadIndex ||
       store.payloadStates[payloadIndex] !=
           SemanticSnapshotProductionPayloadLive ||
       store.payloadSourceVersions[payloadIndex] !=
           pin.corePin.sourceVersion ||
       !layout.FixedBytes32Equal(
           store.payloadBindingReceiptCids[payloadIndex],
           pin.corePin.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           store.payloadSemanticSnapshotCids[payloadIndex],
           pin.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(
           store.payloadFactsRootCids[payloadIndex], pin.factsRootCid) ||
       !layout.FixedBytes32Equal(
           store.payloadCargoCids[payloadIndex], pin.cargoCid) ||
       !layout.FixedBytes32Equal(
           store.payloadDeclarationTableCids[payloadIndex],
           pin.declarationTableCid) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryIndexRootCids[payloadIndex],
           pin.queryIndexRootCid) ||
       !layout.FixedBytes32Equal(
           store.payloadDeclarationTableCids[payloadIndex],
           store.payloadTables[payloadIndex].declarations.tableCid) ||
       store.payloadQueryProjections[payloadIndex].sourceVersion !=
           pin.corePin.sourceVersion ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[payloadIndex].bindingReceiptCid,
           pin.corePin.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[payloadIndex].csgRootCid,
           pin.factsRootCid) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[payloadIndex].projectionCid,
           store.payloadQueryProjectionCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.indexCid,
           store.payloadQueryIndexCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.rootCid,
           store.payloadQueryIndexRootCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
            store.payloadValidations[payloadIndex].queryIndexRootCid,
            pin.queryIndexRootCid) ||
       !layout.FixedBytes32Equal(
            store.payloadValidations[payloadIndex].queryIndexRootCid,
            store.payloadQueryIndexRootCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.declarationTableCid,
           pin.declarationTableCid) ||
       layout.FixedBytes32Equal(
           store.payloadQueryProjectionCids[payloadIndex],
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           store.payloadQueryIndexCids[payloadIndex],
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           store.payloadQueryIndexRootCids[payloadIndex],
           layout.FixedBytes32()):
        err = " semantic snapshot production pin: payload identity mismatch"
        return false
    payloadIndexOut = payloadIndex
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionPinnedQueryProjectionInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        out: var query_projection.SemanticSnapshotQueryProjection,
        err: var str): bool =
    out = query_projection.SemanticSnapshotQueryProjection()
    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    if !query_projection.SemanticSnapshotQueryProjectionStrictValidateInto(
            store.payloadQueryProjections[payloadIndex],
            store.payloadTables[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadIdentities[payloadIndex], err):
        return false
    out = query_projection.SemanticSnapshotQueryProjectionClone(
        store.payloadQueryProjections[payloadIndex])
    err = ""
    return true

fn SemanticSnapshotProductionStorePinCurrentInto(
        store: var SemanticSnapshotProductionStore,
        pinOut: var SemanticSnapshotProductionPin,
        err: var str): bool =
    if pinOut.active:
        err = " semantic snapshot production pin: output pin is active"
        return false
    pinOut = SemanticSnapshotProductionPin()
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       store.core.publishedIndex < 0:
        err = " semantic snapshot production pin: no current payload"
        return false
    let snapshotIndex = store.core.publishedIndex
    if store.core.candidateIndex >= 0 ||
       store.core.states[snapshotIndex] !=
           snapshot_core.SemanticSnapshotStatePublished ||
       store.core.sourceVersions[snapshotIndex] !=
           store.core.currentSourceVersion:
        err = " semantic snapshot production pin: current version is not ready"
        return false
    let payloadIndex = store.payloadIndexesBySnapshot[snapshotIndex]
    if payloadIndex < 0 ||
       store.payloadStates[payloadIndex] !=
           SemanticSnapshotProductionPayloadLive ||
       store.payloadSourceVersions[payloadIndex] !=
           store.core.sourceVersions[snapshotIndex] ||
       store.payloadTables[payloadIndex].schemaVersion !=
           store.core.schemaVersions[snapshotIndex] ||
       store.payloadTables[payloadIndex].semanticEpoch !=
           store.core.semanticEpochs[snapshotIndex] ||
       !layout.FixedBytes32Equal(
           store.payloadBindingReceiptCids[payloadIndex],
           store.core.bindingReceiptCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadSemanticSnapshotCids[payloadIndex],
           store.core.semanticSnapshotCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadFactsRootCids[payloadIndex],
           store.core.csgRootCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[payloadIndex].projectionCid,
           store.payloadQueryProjectionCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.indexCid,
           store.payloadQueryIndexCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
            store.payloadQueryProjections[
                payloadIndex].queryIndex.rootCid,
            store.payloadQueryIndexRootCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
            store.payloadValidations[payloadIndex].queryIndexRootCid,
            store.payloadQueryIndexRootCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadDeclarationTableCids[payloadIndex],
           store.payloadTables[payloadIndex].declarations.tableCid) ||
       !layout.FixedBytes32Equal(
           store.payloadDeclarationTableCids[payloadIndex],
           store.payloadQueryProjections[
               payloadIndex].queryIndex.declarationTableCid):
        err = " semantic snapshot production pin: payload unavailable"
        return false
    var corePin: snapshot_core.SemanticSnapshotPin
    if !snapshot_core.SemanticSnapshotStorePinCurrentInto(
            store.core, corePin, err):
        return false
    pinOut.corePin = corePin
    pinOut.payloadIndex = payloadIndex
    pinOut.semanticSnapshotCid =
        store.payloadSemanticSnapshotCids[payloadIndex]
    pinOut.factsRootCid = store.payloadFactsRootCids[payloadIndex]
    pinOut.cargoCid = store.payloadCargoCids[payloadIndex]
    pinOut.declarationTableCid =
        store.payloadDeclarationTableCids[payloadIndex]
    pinOut.queryIndexRootCid =
        store.payloadQueryIndexRootCids[payloadIndex]
    pinOut.active = true
    err = ""
    return true

fn semanticSnapshotProductionPublishedPredecessorPayloadStrictValidateInto(
        store: var SemanticSnapshotProductionStore,
        expectedCurrentSourceVersion: int64,
        snapshotIndexOut: var int32,
        payloadIndexOut: var int32,
        err: var str): bool =
    snapshotIndexOut = -1
    payloadIndexOut = -1
    if !semanticSnapshotProductionStoreMappingsStrictValidNoAlloc(store) ||
       expectedCurrentSourceVersion <= 0 ||
       store.core.currentSourceVersion != expectedCurrentSourceVersion ||
       store.core.candidateIndex != -1 ||
       store.core.publishedIndex < 0:
        err = " semantic snapshot production pin: invalid predecessor state"
        return false
    let snapshotIndex = store.core.publishedIndex
    if store.core.states[snapshotIndex] !=
           snapshot_core.SemanticSnapshotStatePublished ||
       store.core.sourceVersions[snapshotIndex] <= 0 ||
       store.core.sourceVersions[snapshotIndex] >=
           expectedCurrentSourceVersion:
        err = " semantic snapshot production pin: predecessor version mismatch"
        return false
    let payloadIndex = store.payloadIndexesBySnapshot[snapshotIndex]
    if payloadIndex < 0 ||
       payloadIndex >= store.payloadStates.len ||
       store.payloadStates[payloadIndex] !=
           SemanticSnapshotProductionPayloadLive ||
       store.payloadSnapshotIndexes[payloadIndex] != snapshotIndex ||
       store.payloadSourceVersions[payloadIndex] !=
           store.core.sourceVersions[snapshotIndex] ||
       !layout.FixedBytes32Equal(
           store.payloadBindingReceiptCids[payloadIndex],
           store.core.bindingReceiptCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadSemanticSnapshotCids[payloadIndex],
           store.core.semanticSnapshotCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadFactsRootCids[payloadIndex],
           store.core.csgRootCids[snapshotIndex]):
        err = " semantic snapshot production pin: predecessor payload mismatch"
        return false
    if !semanticSnapshotProductionPayloadStrictValidateInto(
            store, payloadIndex, err) ||
       store.payloadBindings[payloadIndex].sourceVersion !=
           store.core.sourceVersions[snapshotIndex] ||
       !layout.FixedBytes32Equal(
           store.payloadIdentities[
               payloadIndex].sourceIdentityReceiptCid,
           store.core.sourceIdentityReceiptCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadIdentities[payloadIndex].worldHeadCid,
           store.core.worldHeadCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadIdentities[payloadIndex].compilerCid,
           store.core.compilerCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadIdentities[payloadIndex].sourceBundleCid,
           store.core.sourceBundleCids[snapshotIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadIdentities[payloadIndex].semanticSnapshotCid,
           store.payloadSemanticSnapshotCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadIdentities[payloadIndex].csgRootCid,
           store.payloadFactsRootCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadBindings[payloadIndex].bindingReceiptCid,
           store.payloadBindingReceiptCids[payloadIndex]) ||
       !layout.FixedBytes32Equal(
           store.payloadValidations[payloadIndex].validationReceiptCid,
           store.core.validationReceiptCids[snapshotIndex]):
        if err == "":
            err = " semantic snapshot production pin: predecessor proof mismatch"
        return false
    snapshotIndexOut = snapshotIndex
    payloadIndexOut = payloadIndex
    err = ""
    return true

# This pin is reserved for the compiler-owned incremental builder. It never
# relaxes PinCurrentInto: the expected current version must already be newer
# than the last atomically published payload.
fn SemanticSnapshotProductionStorePinPublishedPredecessorInto(
        store: var SemanticSnapshotProductionStore,
        expectedCurrentSourceVersion: int64,
        pinOut: var SemanticSnapshotProductionPin,
        err: var str): bool =
    if pinOut.active:
        err = " semantic snapshot production pin: output pin is active"
        return false
    var snapshotIndex: int32
    var payloadIndex: int32
    if !semanticSnapshotProductionPublishedPredecessorPayloadStrictValidateInto(
            store, expectedCurrentSourceVersion,
            snapshotIndex, payloadIndex, err):
        return false
    var corePin: snapshot_core.SemanticSnapshotPin
    if !snapshot_core.SemanticSnapshotStorePinPublishedPredecessorInto(
            store.core, expectedCurrentSourceVersion, corePin, err):
        return false
    var candidatePin: SemanticSnapshotProductionPin
    candidatePin.corePin = corePin
    candidatePin.payloadIndex = payloadIndex
    candidatePin.semanticSnapshotCid =
        store.payloadSemanticSnapshotCids[payloadIndex]
    candidatePin.factsRootCid =
        store.payloadFactsRootCids[payloadIndex]
    candidatePin.cargoCid = store.payloadCargoCids[payloadIndex]
    candidatePin.declarationTableCid =
        store.payloadDeclarationTableCids[payloadIndex]
    candidatePin.queryIndexRootCid =
        store.payloadQueryIndexRootCids[payloadIndex]
    candidatePin.active = true
    var verifiedPayloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, candidatePin, verifiedPayloadIndex, err) ||
       verifiedPayloadIndex != payloadIndex ||
       snapshotIndex != corePin.snapshotIndex:
        var releaseErr: str
        if !snapshot_core.SemanticSnapshotStoreReleasePinInto(
                store.core, corePin, releaseErr):
            panic("semantic_snapshot_production_predecessor_pin_rollback")
        if err == "":
            err = " semantic snapshot production pin: predecessor postcheck mismatch"
        return false
    pinOut = candidatePin
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionPinnedSymbolIdentityInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        symbolId: int32,
        symbolCidOut: var layout.FixedBytes32,
        sourceIdOut: var int32,
        declarationSpanIdOut: var int32,
        typeIdOut: var int32,
        symbolKindOut: var int32,
        err: var str): bool =
    symbolCidOut = layout.FixedBytes32()
    sourceIdOut = -1
    declarationSpanIdOut = -1
    typeIdOut = -1
    symbolKindOut = 0
    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    if symbolId < 0 ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.symbolCids.len ||
       symbolId >= store.payloadTables[payloadIndex].symbols.sourceIds.len ||
       symbolId >=
           store.payloadTables[
               payloadIndex].symbols.declarationSpanIds.len ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.nameSpanIds.len ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.nameTokenIds.len ||
       symbolId >= store.payloadTables[payloadIndex].symbols.typeIds.len ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.symbolKinds.len ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.ownerSymbolIds.len ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.functionIds.len:
        err = " semantic snapshot production query: invalid SymbolId"
        return false
    let declarationSpanId =
        store.payloadTables[
            payloadIndex].symbols.declarationSpanIds[symbolId]
    let nameSpanId =
        store.payloadTables[payloadIndex].symbols.nameSpanIds[symbolId]
    let nameTokenId =
        store.payloadTables[payloadIndex].symbols.nameTokenIds[symbolId]
    let symbolKind =
        store.payloadTables[payloadIndex].symbols.symbolKinds[symbolId]
    let typeId =
        store.payloadTables[payloadIndex].symbols.typeIds[symbolId]
    let ownerSymbolId =
        store.payloadTables[payloadIndex].symbols.ownerSymbolIds[symbolId]
    let functionId =
        store.payloadTables[payloadIndex].symbols.functionIds[symbolId]
    let coordinateLess =
        declarationSpanId < 0 || nameSpanId < 0 || nameTokenId < 0
    if coordinateLess &&
       (declarationSpanId != -1 || nameSpanId != -1 ||
        nameTokenId != -1 ||
        symbolKind != snapshot_schema.CsgCompilerSymbolModule ||
        typeId != -1 || ownerSymbolId != -1 || functionId != -1):
        err = " semantic snapshot production query: coordinate-less non-Module Symbol"
        return false
    if (symbolKind == snapshot_schema.CsgCompilerSymbolModule &&
        (typeId != -1 || ownerSymbolId != -1 || functionId != -1)) ||
       (symbolKind != snapshot_schema.CsgCompilerSymbolModule &&
        (coordinateLess || typeId < 0 || ownerSymbolId < 0)):
        err = " semantic snapshot production query: Symbol discriminant drift"
        return false
    symbolCidOut =
        store.payloadTables[payloadIndex].symbols.symbolCids[symbolId]
    sourceIdOut =
        store.payloadTables[payloadIndex].symbols.sourceIds[symbolId]
    declarationSpanIdOut = declarationSpanId
    typeIdOut = typeId
    symbolKindOut = symbolKind
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionPinnedSymbolDeclarationInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        symbolId: int32,
        declIdOut: var int32,
        declKeyCidOut: var layout.FixedBytes32,
        ownerDeclIdOut: var int32,
        typeExpressionCidOut: var layout.FixedBytes32,
        nameProofCidOut: var layout.FixedBytes32,
        declarationTableCidOut: var layout.FixedBytes32,
        err: var str): bool =
    declIdOut = -1
    declKeyCidOut = layout.FixedBytes32()
    ownerDeclIdOut = -1
    typeExpressionCidOut = layout.FixedBytes32()
    nameProofCidOut = layout.FixedBytes32()
    declarationTableCidOut = layout.FixedBytes32()
    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    if store.payloadQueryProjections[
           payloadIndex].queryIndex.sourceVersion !=
           pin.corePin.sourceVersion ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.csgRootCid,
           pin.factsRootCid) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.indexCid,
           store.payloadQueryIndexCids[payloadIndex]) ||
       symbolId < 0 ||
       symbolId >= store.payloadQueryProjections[
           payloadIndex].queryIndex.symbolDeclIds.len ||
       symbolId >= store.payloadQueryProjections[
           payloadIndex].queryIndex.symbolDeclKeyCids.len ||
       symbolId >=
           store.payloadQueryProjections[
               payloadIndex].queryIndex.symbolDeclarationRowCids.len ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.declIds.len ||
       symbolId >=
           store.payloadTables[payloadIndex].symbols.declKeyCids.len:
        err = " semantic snapshot production query: invalid SymbolId"
        return false
    let declId = store.payloadQueryProjections[
        payloadIndex].queryIndex.symbolDeclIds[symbolId]
    if declId < 0 ||
       declId >=
           store.payloadTables[payloadIndex].declarations.declIds.len ||
       store.payloadTables[
           payloadIndex].declarations.declIds[declId] != declId ||
       store.payloadTables[
           payloadIndex].symbols.declIds[symbolId] != declId ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.symbolDeclarationRowCids[symbolId],
           query_projection.SemanticSnapshotQueryDeclarationRowCid(
               store.payloadTables[payloadIndex].declarations, declId)) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.symbolDeclKeyCids[symbolId],
           store.payloadTables[
               payloadIndex].symbols.declKeyCids[symbolId]) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.symbolDeclKeyCids[symbolId],
           store.payloadTables[
               payloadIndex].declarations.declKeyCids[declId]) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.declarationTableCid,
           store.payloadTables[payloadIndex].declarations.tableCid) ||
       !layout.FixedBytes32Equal(
           store.payloadQueryProjections[
               payloadIndex].queryIndex.declarationTableCid,
           pin.declarationTableCid):
        err = " semantic snapshot production query: declaration binding drift"
        return false
    declIdOut = declId
    declKeyCidOut =
        store.payloadTables[
            payloadIndex].declarations.declKeyCids[declId]
    ownerDeclIdOut =
        store.payloadTables[
            payloadIndex].declarations.ownerDeclIds[declId]
    typeExpressionCidOut =
        store.payloadTables[payloadIndex].declarations.portableSignatureTypeExpressionCids[
            declId]
    nameProofCidOut =
        store.payloadTables[
            payloadIndex].declarations.parserValidatedNameProofCids[declId]
    declarationTableCidOut =
        store.payloadTables[payloadIndex].declarations.tableCid
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionPinnedReferenceTargetInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        referenceId: int32,
        targetSymbolIdOut: var int32,
        sourceIdOut: var int32,
        spanIdOut: var int32,
        referenceKindOut: var int32,
        bindingTypedNodeIdOut: var int32,
        err: var str): bool =
    targetSymbolIdOut = -1
    sourceIdOut = -1
    spanIdOut = -1
    referenceKindOut = 0
    bindingTypedNodeIdOut = -1
    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    if referenceId < 0 ||
       referenceId >= store.payloadTables[
           payloadIndex].references.targetSymbolIds.len ||
       referenceId >= store.payloadTables[
           payloadIndex].references.bindingTypedNodeIds.len:
        err = " semantic snapshot production query: invalid ReferenceId"
        return false
    targetSymbolIdOut = store.payloadTables[
        payloadIndex].references.targetSymbolIds[referenceId]
    sourceIdOut =
        store.payloadTables[payloadIndex].references.sourceIds[referenceId]
    spanIdOut =
        store.payloadTables[payloadIndex].references.spanIds[referenceId]
    referenceKindOut = store.payloadTables[
        payloadIndex].references.referenceKinds[referenceId]
    bindingTypedNodeIdOut = store.payloadTables[
        payloadIndex].references.bindingTypedNodeIds[referenceId]
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionPinnedCompilerFactsInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        out: var compiler_facts.CompilerFactBundle,
        err: var str): bool =
    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    var bundle: compiler_facts.CompilerFactBundle
    if !compiler_facts.CompilerFactsFromSemanticSnapshotInto(
            store.payloadTables[payloadIndex],
            store.payloadIdentities[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadValidations[payloadIndex],
            store.payloadTables[payloadIndex].predecessorReceiptCid,
            store.payloadPackageIds[payloadIndex], bundle, err):
        return false
    if bundle.factCount != store.payloadCompilerFactCounts[payloadIndex] ||
       !layout.FixedBytes32Equal(
           bundle.projectionCid,
           store.payloadCompilerFactProjectionCids[payloadIndex]):
        err = " semantic snapshot production query: CompilerFact drift"
        return false
    out = bundle
    err = ""
    return true

@borrows
fn SemanticSnapshotProductionPinnedSemanticFactsInto(
        store: SemanticSnapshotProductionStore,
        pin: SemanticSnapshotProductionPin,
        out: var semantic_facts.SemanticFactBundle,
        err: var str): bool =
    var payloadIndex: int32
    if !semanticSnapshotProductionPinnedPayloadInto(
            store, pin, payloadIndex, err):
        return false
    var bundle: semantic_facts.SemanticFactBundle
    if !semantic_facts.SemanticFactsFromSemanticSnapshotInto(
            store.payloadTables[payloadIndex],
            store.payloadIdentities[payloadIndex],
            store.payloadBindings[payloadIndex],
            store.payloadValidations[payloadIndex],
            store.payloadTables[payloadIndex].predecessorReceiptCid,
            store.payloadPackageIds[payloadIndex], bundle, err):
        return false
    if bundle.factCount != store.payloadSemanticFactCounts[payloadIndex] ||
       !layout.FixedBytes32Equal(
           bundle.projectionCid,
           store.payloadSemanticFactProjectionCids[payloadIndex]):
