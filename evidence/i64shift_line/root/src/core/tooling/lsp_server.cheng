# --- Message dispatcher ---

fn LspDispatchMessage(msgJson: json.JsonNode) =
    let method: str = json.GetStr(msgJson["method"])
    let hasId: bool = msgJson["id"].kind == json.JInt || msgJson["id"].kind == json.JString
    let id: json.JsonNode = msgJson["id"]
    let params: json.JsonNode = json.JsonGetField(msgJson, "params")

    if gShutdownRequested:
        if method == "exit":
            LspHandleExit()
        if hasId:
            LspWriteMessage(json.Stringify(LspMakeError(id, int32(lsp.InvalidRequest),
                                                         "server is shutting down")))
        return

    if !gInitialized:
        if method == "initialize":
            LspHandleInitialize(id, params)
            return
        if method == "exit":
            LspHandleExit()
            return
        if hasId:
            LspWriteMessage(json.Stringify(LspMakeError(id, int32(lsp.ServerNotInitialized),
                                                         "server not initialized")))
        return

    let exactQuery = method == "textDocument/definition" ||
        method == "textDocument/references" ||
        method == "textDocument/rename" ||
        method == "textDocument/hover" ||
        method == "textDocument/completion" ||
        method == "textDocument/diagnostic" ||
        method == "cheng/lineMap"
    var exactQueryStartedNs: int64
    if exactQuery:
        exactQueryStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    if method == "shutdown":
        LspHandleShutdown(id)
    elif method == "exit":
        LspHandleExit()
    elif method == "cheng/configureCompilerSource":
        LspHandleConfigureCompilerSource(params)
    elif method == "textDocument/didOpen":
        LspHandleDidOpen(params)
    elif method == "textDocument/didChange":
        LspHandleDidChange(params)
    elif method == "textDocument/didClose":
        LspHandleDidClose(params)
    elif method == "workspace/didCreateFiles":
        LspHandleDidCreateFiles(params)
    elif method == "workspace/didDeleteFiles":
        LspHandleDidDeleteFiles(params)
    elif method == "workspace/didRenameFiles":
        LspHandleDidRenameFiles(params)
    elif method == "textDocument/definition":
        LspHandleDefinition(id, params)
    elif method == "textDocument/references":
        LspHandleReferences(id, params)
    elif method == "textDocument/rename":
        LspHandleRename(id, params)
    elif method == "textDocument/hover":
        LspHandleHover(id, params)
    elif method == "textDocument/completion":
        LspHandleCompletion(id, params)
    elif method == "textDocument/diagnostic":
        LspHandleDiagnostic(id, params)
    elif method == "cheng/snapshotMetrics":
        LspHandleSnapshotMetrics(id)
    elif method == "cheng/snapshotBarrier":
        LspHandleSnapshotBarrier(id, params)
    elif method == "textDocument/codeAction":
        LspHandleCodeAction(id, params)
    elif method == "textDocument/documentSymbol":
        LspHandleDocumentSymbol(id, params)
    elif method == "cheng/lineMap":
        LspHandleChengLineMap(id, params)
    elif method == "workspace/symbol":
        LspHandleWorkspaceSymbol(id, params)
    elif method == "textDocument/foldingRange":
        LspHandleFoldingRange(id, params)
    elif method == "textDocument/formatting":
        LspHandleFormatting(id, params)
    elif method == "textDocument/signatureHelp":
        LspHandleSignatureHelp(id, params)
    elif method == "textDocument/typeDefinition":
        LspHandleTypeDefinition(id, params)
    elif method == "$cancelRequest":
        LspHandleCancelRequest(params)
    elif method == "initialized":
        return
    else:
        if hasId:
            let methodNotFoundMsg: str = strutil.Join(["method not found: ", method], "")
            LspWriteMessage(json.Stringify(LspMakeError(id, int32(lsp.MethodNotFound),
                                                         methodNotFoundMsg)))
    if exactQuery:
        let elapsedNs =
            monotimes.MonoTimeNs(monotimes.GetMonoTime()) - exactQueryStartedNs
        gWorkspace.metrics.queryAttemptCount =
            gWorkspace.metrics.queryAttemptCount + int64(1)
        gWorkspace.metrics.queryWallNs =
            gWorkspace.metrics.queryWallNs + elapsedNs
        if method == "textDocument/definition":
            gWorkspace.metrics.definitionQueryCount =
                gWorkspace.metrics.definitionQueryCount + int64(1)
            gWorkspace.metrics.definitionQueryWallNs =
                gWorkspace.metrics.definitionQueryWallNs + elapsedNs
        elif method == "textDocument/references":
            gWorkspace.metrics.referencesQueryCount =
                gWorkspace.metrics.referencesQueryCount + int64(1)
            gWorkspace.metrics.referencesQueryWallNs =
                gWorkspace.metrics.referencesQueryWallNs + elapsedNs
        elif method == "textDocument/rename":
            gWorkspace.metrics.renameQueryCount =
                gWorkspace.metrics.renameQueryCount + int64(1)
            gWorkspace.metrics.renameQueryWallNs =
                gWorkspace.metrics.renameQueryWallNs + elapsedNs
        elif method == "textDocument/hover":
            gWorkspace.metrics.hoverQueryCount =
                gWorkspace.metrics.hoverQueryCount + int64(1)
            gWorkspace.metrics.hoverQueryWallNs =
                gWorkspace.metrics.hoverQueryWallNs + elapsedNs
        elif method == "textDocument/completion":
            gWorkspace.metrics.completionQueryCount =
                gWorkspace.metrics.completionQueryCount + int64(1)
            gWorkspace.metrics.completionQueryWallNs =
                gWorkspace.metrics.completionQueryWallNs + elapsedNs
        elif method == "textDocument/diagnostic":
            gWorkspace.metrics.diagnosticsQueryCount =
                gWorkspace.metrics.diagnosticsQueryCount + int64(1)
            gWorkspace.metrics.diagnosticsQueryWallNs =
                gWorkspace.metrics.diagnosticsQueryWallNs + elapsedNs
        else:
            panic("lsp_metric_query_kind_invalid")

# --- Entry point ---

fn lspRandomWorkspaceSessionCidInto(
        out: var layout.FixedBytes32,
        err: var str): bool =
    let randomResult = rand.RandomBytes(layout.FixedBytes32Size)
    if IsErr(randomResult):
        err = strutil.Join([
            " lsp workspace: system entropy unavailable: ",
            Error(randomResult)], "")
        return false
    var randomBytes = Value(randomResult)
    let fixedResult = layout.FixedBytes32FromBytes(randomBytes)
    rawbytes.BytesFree(randomBytes)
    if IsErr(fixedResult):
        err = Error(fixedResult)
        return false
    out = Value(fixedResult)
    err = ""
    return true

fn lspServerIdentityArgInto(args: str[], name: str,
                            out: var str, err: var str): bool =
    let prefix = strutil.Join(["--", name, "="], "")
    var found = false
    for index in 0..<args.len:
        if strings.HasPrefix(args[index], prefix):
            if found || args[index].len <= prefix.len:
                err = strutil.Join([
                    " lsp workspace: invalid identity argument ", name], "")
                return false
            out = args[index][prefix.len..<args[index].len]
            found = true
    if !found:
        err = strutil.Join([
            " lsp workspace: missing identity argument ", name], "")
        return false
    err = ""
    return true

fn lspServerIdentityCidArgInto(args: str[], name: str,
                               out: var layout.FixedBytes32,
                               err: var str): bool =
    var value: str
    if !lspServerIdentityArgInto(args, name, value, err):
        return false
    let decoded = layout.FixedBytes32FromHex(value)
    if IsErr(decoded):
        err = Fmt" lsp workspace: invalid identity CID {name}: {Error(decoded)} length={value.len}"
        return false
    if layout.FixedBytes32Equal(Value(decoded), layout.FixedBytes32()):
        err = Fmt" lsp workspace: zero identity CID {name}"
        return false
    out = Value(decoded)
    err = ""
    return true

fn lspServerIdentityCidAllowZeroArgInto(
        args: str[], name: str,
        out: var layout.FixedBytes32,
        err: var str): bool =
    var value: str
    if !lspServerIdentityArgInto(args, name, value, err):
        return false
    let decoded = layout.FixedBytes32FromHex(value)
    if IsErr(decoded):
        err = Fmt" lsp workspace: invalid identity CID {name}: {Error(decoded)} length={value.len}"
        return false
    out = Value(decoded)
    err = ""
    return true

fn lspServerImmutableCompilerIdentityInto(
        args: str[],
        compilerUniverseOut: var compiler_world.CompilerLocalUniverse,
        compilerExecutionOut: var execution.CompilerExecutionIdentity,
        err: var str): bool =
    if args.len != 13:
        err = " lsp workspace: invalid identity argument count"
        return false
    var caseId: str
    var channel: str
    var targetTriple: str
    var compilerSourceBundle: layout.FixedBytes32
    var compilerCsgRoot: layout.FixedBytes32
    var compilerExportSurface: layout.FixedBytes32
    var compilerMigrationProof: layout.FixedBytes32
    var materializer: layout.FixedBytes32
    var grammar: layout.FixedBytes32
    var compilerSourceClosure: layout.FixedBytes32
    var driver: layout.FixedBytes32
    var toolchain: layout.FixedBytes32
    var command: layout.FixedBytes32
    if !lspServerIdentityArgInto(args, "compiler-case-id", caseId, err) ||
       !lspServerIdentityArgInto(
            args, "compiler-world-channel", channel, err) ||
       !lspServerIdentityArgInto(
            args, "compiler-target-triple", targetTriple, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-source-bundle-cid",
            compilerSourceBundle, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-csg-root-cid", compilerCsgRoot, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-export-surface-cid",
            compilerExportSurface, err) ||
       !lspServerIdentityCidAllowZeroArgInto(
            args, "compiler-migration-proof-cid",
            compilerMigrationProof, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-materializer-cid", materializer, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-grammar-cid", grammar, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-source-closure-cid",
            compilerSourceClosure, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-driver-cid", driver, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-toolchain-cid", toolchain, err) ||
       !lspServerIdentityCidArgInto(
            args, "compiler-command-cid", command, err):
        return false
    let identity = execution.CompilerExecutionIdentityMake(
        caseId, compilerSourceBundle, materializer, grammar,
        compilerSourceClosure, driver, toolchain, command, targetTriple)
    if IsErr(identity):
        err = Error(identity)
        return false
    compilerExecutionOut = Value(identity)
    var noExtraManifestEntries: compiler_world.CompilerUniverseManifestEntry[]
    if !compiler_world.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
            compilerUniverseOut,
            err,
            channel,
            compilerExecutionOut.sourceBundleRaw32,
            compilerCsgRoot,
            compilerExportSurface,
            compilerMigrationProof,
            noExtraManifestEntries):
        return false
    err = ""
    return true

fn LspServerMain(args: str[]): int32 =
    gInitialized = false
    gShutdownRequested = false
    gExitRequested = false
    var workspaceSessionCid: layout.FixedBytes32
    var compilerUniverse: compiler_world.CompilerLocalUniverse
    var compilerExecution: execution.CompilerExecutionIdentity
    var workspaceErr: str
    if !lspRandomWorkspaceSessionCidInto(
            workspaceSessionCid, workspaceErr) ||
       !lspServerImmutableCompilerIdentityInto(
            args, compilerUniverse, compilerExecution, workspaceErr) ||
       !LspWorkspaceInitInto(
            workspaceSessionCid, compilerUniverse, compilerExecution,
            gWorkspace, workspaceErr):
        LspLog(strutil.Join(["startup failed:", workspaceErr], ""))
        return 1
    lspInputReaderInit()
    if !lspCandidateSchedulerInitInto(workspaceErr):
        LspLog(strutil.Join(
            ["candidate scheduler startup failed:", workspaceErr], ""))
        lspReleaseWorkspace()
        lspInputReaderRelease()
        return 1

    LspLog("cheng-lsp starting (versioned semantic snapshot mode)")

    var inputWorkerStopped: bool
    while !gExitRequested:
        let event =
            lspChannelReceiveByte(
                gCandidateScheduler.eventReadFd)
        if event == lspSchedulerEventCandidate:
            lspCandidateSchedulerHandleCompletionInto(
                gWorkspace)
            continue
        if event != lspSchedulerEventInput:
            panic("lsp_candidate_scheduler_event_invalid")
        let readStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        let msgResult =
            gCandidateScheduler.inputContext.message
        gCandidateScheduler.inputContext.message =
            LspReadMessageResult()
        gWorkspace.metrics.messageReadCount =
            gWorkspace.metrics.messageReadCount + int64(1)
        gWorkspace.metrics.messageReadWallNs =
            gWorkspace.metrics.messageReadWallNs +
            monotimes.MonoTimeNs(monotimes.GetMonoTime()) - readStartedNs
        if !msgResult.ok:
            if strings.Len(msgResult.errorText) > 0:
                LspLog(strutil.Join(["read error: ", msgResult.errorText], ""))
            lspChannelSendByte(
                gCandidateScheduler.acknowledgementWriteFd,
                lspSchedulerInputStop)
            if !thread.JoinThread(
                   gCandidateScheduler.inputWorker):
                panic("lsp_input_worker_join_failed")
            inputWorkerStopped = true
            break
        let parseStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        let parsed: json.JsonParseResult = json.ParseJsonSafe(msgResult.content)
        gWorkspace.metrics.jsonParseWallNs =
            gWorkspace.metrics.jsonParseWallNs +
            monotimes.MonoTimeNs(monotimes.GetMonoTime()) - parseStartedNs
        if !parsed.success:
            LspLog(strutil.Join(["json parse error: ", parsed.message], ""))
            lspChannelSendByte(
                gCandidateScheduler.acknowledgementWriteFd,
                lspSchedulerInputContinue)
            continue
        let dispatchStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        LspDispatchMessage(parsed.value)
        gWorkspace.metrics.dispatchWallNs =
            gWorkspace.metrics.dispatchWallNs +
            monotimes.MonoTimeNs(monotimes.GetMonoTime()) - dispatchStartedNs
        lspChannelSendByte(
            gCandidateScheduler.acknowledgementWriteFd,
            gExitRequested ?
                lspSchedulerInputStop :
                lspSchedulerInputContinue)
        if gExitRequested:
            if !thread.JoinThread(
                   gCandidateScheduler.inputWorker):
                panic("lsp_input_worker_join_failed")
            inputWorkerStopped = true

    lspCandidateSchedulerFinishInto(
        gWorkspace, inputWorkerStopped)
    lspReleaseWorkspace()
    lspInputReaderRelease()
    LspLog("cheng-lsp exiting")
    return 0
