    LspInputReader =
        buffer: rawbytes.Bytes
        position: int32
        length: int32

    LspFdPair =
        readFd: int32
        writeFd: int32

@importc("libc_read")
fn lspReadFd(fd: int32, data: ptr, count: int64): int64
@importc("libc_write")
fn lspWriteFd(fd: int32, data: ptr, count: int64): int64
@importc("libc_close")
fn lspCloseFd(fd: int32): int32
@importc("cheng_host_pipe_runtime")
fn lspPipeInto(pair: var LspFdPair): int32

const lspInputBufferCapacity: int32 = 65536
const lspCandidateCompletionPublished: int32 = 1
const lspCandidateCompletionEarlyRejected: int32 = 2
const lspCandidateCompletionCsgRejected: int32 = 3
const lspCandidateCompletionAdmissionRejected: int32 = 4
const lspSchedulerEventInput: int32 = 1
const lspSchedulerEventCandidate: int32 = 2
const lspSchedulerInputContinue: int32 = 1
const lspSchedulerInputStop: int32 = 2

var
    gInitialized: bool
    gShutdownRequested: bool
    gExitRequested: bool
    gWorkspace: LspWorkspace
    gInputReader: LspInputReader
    gCandidateScheduler: LspCandidateScheduler

# --- Logging ---

fn LspLog(text: str) =
    os.Write(os.Get_stderr(), "[cheng-lsp] ")
    os.WriteLine(os.Get_stderr(), text)

fn LspWriteStdout(data: str) =
    os.Write(os.Get_stdout(), data)

# --- Content-Length header framing ---

fn lspInputReaderInit() =
    gInputReader = LspInputReader()
    gInputReader.buffer = rawbytes.BytesAlloc(lspInputBufferCapacity)
    if gInputReader.buffer.data == nil ||
       rawbytes.BytesLen(gInputReader.buffer) != lspInputBufferCapacity:
        panic("lsp_input_buffer_alloc_failed")

fn lspInputReaderRelease() =
    rawbytes.BytesFree(gInputReader.buffer)
    gInputReader = LspInputReader()

fn lspInputReaderFill(): bool =
    let got = lspReadFd(
        0, gInputReader.buffer.data, int64(lspInputBufferCapacity))
    if got < int64(0) || got > int64(lspInputBufferCapacity):
        panic("lsp_input_read_failed")
    gInputReader.position = 0
    gInputReader.length = int32(got)
    return got > int64(0)

fn lspInputReadByte(): int32 =
    if gInputReader.position >= gInputReader.length &&
       !lspInputReaderFill():
        return -1
    let out = rawbytes.BytesGet(
        gInputReader.buffer, gInputReader.position)
    gInputReader.position = gInputReader.position + 1
    return out

fn lspInputReadInto(destination: ptr, byteCount: int32): int32 =
    var copied: int32
    while copied < byteCount:
        if gInputReader.position >= gInputReader.length &&
           !lspInputReaderFill():
            break
        let available = gInputReader.length - gInputReader.position
        var take = byteCount - copied
        if take > available:
            take = available
        rawmem_support.RawmemCopy(
            rawmem_support.RawmemPtrAdd(destination, copied),
            rawmem_support.RawmemPtrAdd(
                gInputReader.buffer.data, gInputReader.position),
            take)
        copied = copied + take
        gInputReader.position = gInputReader.position + take
    return copied

# Read one line from stdin. The line does not include the terminating \n.
fn LspReadLine(): str =
    var out: str
    var ch: int32
    var temp: str
    var afterCr: int32
    while true:
        ch = lspInputReadByte()
        if ch < 0:
            break
        if ch == 10:
            panic("lsp_header_requires_crlf")
        if ch == 13:   # \r -- LSP header lines end with \r\n
            afterCr = lspInputReadByte()
            if afterCr == 10:   # \n after \r
                break
            panic("lsp_invalid_header_line_ending")
        temp = strings.CharToStr(sys.Char(ch))
        if len(temp) > 0:
            out = strutil.Join([out, temp], "")
    return out

fn LspReadContentBody(contentLength: int32): str =
    if contentLength <= 0:
        return ""
    # Read into a fixed-size buffer allocated once (contentLength is known
    # up front). BytesSet writes are O(1); the buffer is freed after the
    # one-shot str copy so no per-request memory is left behind.
    var buf: rawbytes.Bytes = rawbytes.BytesAlloc(contentLength)
    let actualLen = lspInputReadInto(buf.data, contentLength)
    let view: rawbytes.Bytes = rawbytes.BytesSliceView(buf, 0, actualLen)
    let out: str = rawbytes.BytesToString(view)
    rawbytes.BytesFree(buf)
    return out

fn LspReadMessage(): LspReadMessageResult =
    var result: LspReadMessageResult
    result.ok = false
    result.content = ""
    result.errorText = ""

    var contentLength: int32 = -1
    var contentLengthSeen: bool
    # Loop reads multiple headers until blank line (LSP allows Content-Type etc.)
    var moreHeaders: bool = true
    while moreHeaders:
        let headerLine: str = LspReadLine()
        # LspReadLine already excludes the terminating \r and \n (it breaks at \r
        # without appending, then consumes the following \n), so use the line as-is.
        let trimmed: str = headerLine
        if strings.Len(trimmed) <= 0:
            moreHeaders = false
            continue

        let colonPos: int32 = LspFindCharIndex(trimmed, ':')
        if colonPos < 0:
            result.errorText = "header line missing colon"
            return result

        let headerName: str = strings.SliceBytes(trimmed, 0, colonPos)
        let headerValue: str = strutil.Strip(
            strings.SliceBytes(trimmed, colonPos + 1, strings.Len(trimmed) - colonPos - 1))

        if strutil.ToLowerAscii(headerName) == "content-length":
            if contentLengthSeen:
                result.errorText = "duplicate content-length header"
                return result
            contentLengthSeen = true
            if !lspAsciiDecimalStrict(headerValue):
                result.errorText = "invalid content-length"
                return result
            let parseCount: int = parseutils.ParseInt32(headerValue, contentLength)
            if parseCount != int(headerValue.len) || contentLength <= 0:
                result.errorText = "invalid content-length"
                return result
        # Ignore other headers (Content-Type, etc.)

    if contentLength < 0:
        result.errorText = "missing content-length header"
        return result

    let body: str = LspReadContentBody(contentLength)
    if strings.Len(body) != contentLength:
        result.errorText = "incomplete body read"
        return result

    result.ok = true
    result.content = body
    return result

fn lspChannelSendByte(fd: int32, value: int32) =
    if fd < 0 || value < 0 || value > 255:
        panic("lsp_channel_send_invalid")
    var one = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(one, 0, value)
    let wrote = lspWriteFd(fd, one.data, int64(1))
    rawbytes.BytesFree(one)
    if wrote != int64(1):
        panic("lsp_channel_send_failed")

fn lspChannelReceiveByte(fd: int32): int32 =
    if fd < 0:
        panic("lsp_channel_receive_invalid")
    var one = rawbytes.BytesAlloc(1)
    let got = lspReadFd(fd, one.data, int64(1))
    if got != int64(1):
        rawbytes.BytesFree(one)
        panic("lsp_channel_receive_failed")
    let value = rawbytes.BytesGet(one, 0)
    rawbytes.BytesFree(one)
    return value

fn lspChannelCloseFd(fd: var int32) =
    if fd < 0:
        return
    if lspCloseFd(fd) != 0:
        panic("lsp_channel_close_failed")
    fd = -1

fn lspInputWorkerMain(context: LspInputWorkerContext) =
    if context == nil:
        panic("lsp_input_worker_context_missing")
    if context.eventWriteFd < 0 ||
       context.acknowledgementReadFd < 0:
        panic("lsp_input_worker_context_invalid")
    var running = true
    while running:
        let message: LspReadMessageResult = LspReadMessage()
        context.message = message
        lspChannelSendByte(
            context.eventWriteFd, lspSchedulerEventInput)
        let command =
            lspChannelReceiveByte(context.acknowledgementReadFd)
        if command == lspSchedulerInputStop:
            running = false
        elif command != lspSchedulerInputContinue:
            panic("lsp_input_worker_acknowledgement_invalid")
    memRelease(context)

fn LspWriteMessage(content: str) =
    let header: str = strutil.Join(["Content-Length: ", LspInt32ToStr(len(content)), "\r\n\r\n"], "")
    LspWriteStdout(strutil.Join([header, content], ""))

# --- JSON-RPC message construction ---

fn LspMakeResponse(id: json.JsonNode, result: json.JsonNode): json.JsonNode =
    var out: json.JsonNode = json.NewJObject()
    out["jsonrpc"] = "2.0"
    if id.kind == json.JInt || id.kind == json.JString:
        out["id"] = id
    else:
        out["id"] = json.NewJNull()
    out["result"] = result
    return out

fn LspMakeError(id: json.JsonNode, code: int32, message: str): json.JsonNode =
    var out: json.JsonNode = json.NewJObject()
    out["jsonrpc"] = "2.0"
    if id.kind == json.JInt || id.kind == json.JString:
        out["id"] = id
    else:
        out["id"] = json.NewJNull()
    var errObj: json.JsonNode = json.NewJObject()
    errObj["code"] = json.NewJInt(int64(code))
    errObj["message"] = message
    out["error"] = errObj
    return out

# --- Position helpers ---

fn LspPositionToJson(line: int32, character: int32): json.JsonNode =
    var out: json.JsonNode = json.NewJObject()
    out["line"] = json.NewJInt(int64(line))
    out["character"] = json.NewJInt(int64(character))
    return out

fn LspRangeToJson(startLine: int32, startChar: int32,
                  endLine: int32, endChar: int32): json.JsonNode =
    var out: json.JsonNode = json.NewJObject()
    out["start"] = LspPositionToJson(startLine, startChar)
    out["end"] = LspPositionToJson(endLine, endChar)
    return out

fn LspLocationToJson(uri: str,
                     startLine: int32, startChar: int32,
                     endLine: int32, endChar: int32): json.JsonNode =
    var out: json.JsonNode = json.NewJObject()
    out["uri"] = uri
    out["range"] = LspRangeToJson(startLine, startChar, endLine, endChar)
    return out

@borrows
fn lspWorkspaceFindDocumentByUri(workspace: LspWorkspace, uri: str): int32 =
    for index in 0..<workspace.documents.len:
        if workspace.documents[index].uri == uri:
            return index
    return -1

@borrows
fn lspWorkspaceFindDocumentByCid(
        workspace: LspWorkspace,
        documentCid: layout.FixedBytes32): int32 =
    for index in 0..<workspace.documents.len:
        if layout.FixedBytes32Equal(
                workspace.documents[index].documentCid, documentCid):
            return index
    return -1

fn LspWorkspaceInitInto(
        workspaceSessionCid: layout.FixedBytes32,
        compilerUniverse: compiler_world.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        out: var LspWorkspace,
        err: var str): bool =
    let executionVerified =
        execution.CompilerExecutionIdentityVerify(compilerExecution)
    if IsErr(executionVerified):
        err = Error(executionVerified)
        return false
    if !compiler_world.CompilerLocalUniverseStrictValidateInto(
            compilerUniverse, err):
        return false
    if !layout.FixedBytes32Equal(
            compilerUniverse.compilerSnapshot.sourceBundleCid,
            compilerExecution.sourceBundleRaw32):
        err = " lsp workspace: compiler universe/execution source bundle mismatch"
        return false
    var eventState: snapshot_core.WorkspaceSourceEventState
    if !snapshot_core.WorkspaceSourceEventStateInitInto(
            workspaceSessionCid, eventState, err):
        return false
    var store: snapshot_production.SemanticSnapshotProductionStore
    if !snapshot_production.SemanticSnapshotProductionStoreInitInto(
            workspaceSessionCid, store, err):
        return false
    var workspace: LspWorkspace
    workspace.eventState = eventState
    workspace.snapshotStore = store
    workspace.compilerUniverse =
        compiler_world.CompilerWorldOwnLocalUniverse(compilerUniverse)
    workspace.compilerExecution = compilerExecution
    workspace.documents = []
    workspace.initialized = true
    out = workspace
    err = ""
    return true

fn lspWorkspaceCommitCompilerDocumentIdentityInto(
        workspace: var LspWorkspace,
        uri: str,
        documentCid: layout.FixedBytes32,
        err: var str): bool =
    if !workspace.initialized || uri == "" ||
       layout.FixedBytes32Equal(documentCid, layout.FixedBytes32()):
        err = " lsp workspace: invalid document identity binding"
        return false
    let uriRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    let cidRow = lspWorkspaceFindDocumentByCid(workspace, documentCid)
    if uriRow >= 0 || cidRow >= 0:
        if uriRow == cidRow && uriRow >= 0 &&
           layout.FixedBytes32Equal(
               workspace.documents[uriRow].documentCid, documentCid):
            err = ""
            return true
        err = " lsp workspace: document identity is not one-to-one"
        return false
    var document: DocumentOverlay
    document.uri = uri
    document.documentCid = documentCid
    add(workspace.documents, document)
    err = ""
    return true

@borrows
fn lspDocumentSealedBaseStrictValidateInto(
        document: DocumentOverlay,
        err: var str): bool =
    if !document.compilerIdentityBound ||
       !document.sealedBaseSourceBound ||
       document.sourcePath == "" ||
       layout.FixedBytes32Equal(
           document.sealedBaseSourceContentCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           snapshot_schema.CsgCompilerSourceContentCid(
               document.sealedBaseSourceText),
           document.sealedBaseSourceContentCid):
        err = " lsp workspace: sealed base source binding is corrupt"
        return false
    err = ""
    return true

@borrows
fn LspWorkspaceBindDocumentCompilerIdentityInto(
        workspace: var LspWorkspace,
        uri: str,
        workspaceRoot: str,
        packageRoot: str,
        packageId: str,
        targetTriple: str,
        sourcePath: str,
        modulePath: str,
        entrySource: bool,
        err: var str): bool =
    if workspaceRoot == "" || packageRoot == "" || packageId == "" ||
       targetTriple == "" || sourcePath == "" || modulePath == "" ||
       targetTriple != workspace.compilerExecution.targetTriple:
        err = " lsp workspace: compiler source identity is incomplete"
        return false
    var uriSourcePath: str
    var canonicalSourcePath: str
    if !lspFileUriCanonicalPathInto(uri, uriSourcePath, err) ||
       !parser.ParserSourceIdentityLexicalPathInto(
           sourcePath, canonicalSourcePath) ||
       canonicalSourcePath != sourcePath || uriSourcePath != sourcePath:
        err = " lsp workspace: URI and compiler source path disagree"
        return false
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    var expectedModulePath: str
    if !parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
            workspaceRoot, packageRoot, packageId, noExternalRoots,
            sourcePath, expectedModulePath) ||
       expectedModulePath != modulePath:
        err = " lsp workspace: source path and module identity disagree"
        return false
    var documentCid: layout.FixedBytes32
    if !compiler_world.CompilerWorldDocumentCidInto(
            packageId, modulePath, documentCid, err):
        err = " lsp workspace: compiler document CID unavailable"
        return false
    if workspace.workspaceRoot != "" &&
       (workspace.workspaceRoot != workspaceRoot ||
        workspace.packageRoot != packageRoot ||
        workspace.packageId != packageId ||
        workspace.targetTriple != targetTriple):
        err = " lsp workspace: compiler workspace identity split"
        return false
    let existingRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if existingRow >= 0 && workspace.documents[existingRow].compilerIdentityBound:
        if !layout.FixedBytes32Equal(
               workspace.documents[existingRow].documentCid, documentCid) ||
           workspace.documents[existingRow].sourcePath != sourcePath ||
           workspace.documents[existingRow].modulePath != modulePath ||
           workspace.documents[existingRow].entrySource != entrySource:
            err = " lsp workspace: compiler document identity changed"
            return false
        if !lspDocumentSealedBaseStrictValidateInto(
                workspace.documents[existingRow], err):
            return false
        err = ""
        return true
    if workspace.eventState.lastAcceptedSourceVersion > 0:
        err = " lsp workspace: compiler source identity bound after source event"
        return false
    for documentIndex in 0..<workspace.documents.len:
        if documentIndex == existingRow ||
           !workspace.documents[documentIndex].compilerIdentityBound:
            continue
        if workspace.documents[documentIndex].sourcePath == sourcePath ||
           workspace.documents[documentIndex].modulePath == modulePath:
            err = " lsp workspace: compiler source identity is not one-to-one"
            return false
    if entrySource &&
       !layout.FixedBytes32Equal(
           workspace.entryDocumentCid, layout.FixedBytes32()) &&
       !layout.FixedBytes32Equal(workspace.entryDocumentCid, documentCid):
        err = " lsp workspace: compiler entry identity changed"
        return false
    let baseRead = os.ReadFileResult(sourcePath)
    if IsErr(baseRead):
        err = strutil.Join([
            " lsp workspace: base source read failed: ",
            Error(baseRead)], "")
        return false
    let sealedBaseSourceText = Value(baseRead)
    let sealedBaseSourceByteCount = sealedBaseSourceText.len
    if !lspUtf8TextValidInto(sealedBaseSourceText, err):
        err = " lsp workspace: base source bytes are not valid UTF-8"
        return false
    let sealedBaseSourceContentCid =
        snapshot_schema.CsgCompilerSourceContentCid(sealedBaseSourceText)
    if layout.FixedBytes32Equal(
           sealedBaseSourceContentCid, layout.FixedBytes32()):
        err = " lsp workspace: base source content CID is unavailable"
        return false
    let existingCidRow =
        lspWorkspaceFindDocumentByCid(workspace, documentCid)
    if (existingRow >= 0 &&
        !layout.FixedBytes32Equal(
            workspace.documents[existingRow].documentCid,
            documentCid)) ||
       (existingCidRow >= 0 && existingCidRow != existingRow):
        err = " lsp workspace: unbound document identity is split"
        return false
    let expectedStableRow =
        existingRow >= 0 ? existingRow : workspace.documents.len
    var stableEventRow: int32
    if !snapshot_core.WorkspaceSourceEventRegisterInitialDocumentInto(
            workspace.eventState, documentCid, stableEventRow, err):
        return false
    if stableEventRow != expectedStableRow:
        panic("lsp_initial_document_stable_row_split")
    if !lspWorkspaceCommitCompilerDocumentIdentityInto(
            workspace, parser.ParserOwnedText(uri), documentCid, err):
        panic("lsp_initial_document_commit_rejected_after_registration")
    let row = lspWorkspaceFindDocumentByCid(workspace, documentCid)
    if row < 0:
        panic("lsp_compiler_document_binding_missing_after_commit")
    workspace.workspaceRoot = parser.ParserOwnedText(workspaceRoot)
    workspace.packageRoot = parser.ParserOwnedText(packageRoot)
    workspace.packageId = parser.ParserOwnedText(packageId)
    workspace.targetTriple = parser.ParserOwnedText(targetTriple)
    workspace.documents[row].sourcePath = parser.ParserOwnedText(sourcePath)
    workspace.documents[row].modulePath = parser.ParserOwnedText(modulePath)
    workspace.documents[row].sealedBaseSourceText =
        parser.ParserOwnedText(sealedBaseSourceText)
    workspace.documents[row].sealedBaseSourceContentCid =
        sealedBaseSourceContentCid
    workspace.documents[row].sealedBaseSourceBound = true
    workspace.documents[row].sourceText = sealedBaseSourceText
    workspace.documents[row].sourceContentCid =
        sealedBaseSourceContentCid
    workspace.documents[row].compilerIdentityBound = true
    workspace.documents[row].present = true
    workspace.documents[row].stableEventRow = stableEventRow
    workspace.documents[row].entrySource = entrySource
    workspace.metrics.explicitSourceFileReadCount =
        workspace.metrics.explicitSourceFileReadCount + int64(1)
    workspace.metrics.explicitSourceFileReadBytes =
        workspace.metrics.explicitSourceFileReadBytes +
        int64(sealedBaseSourceByteCount)
    if entrySource:
        workspace.entryDocumentCid = documentCid
    err = ""
    return true

@borrows
fn lspSourceHashStateAppend(
        states: var int64[],
        stateBytes: rawbytes.Bytes) =
    for wordIndex in 0..<8:
        add(states, lsp_sha256.LoadU32LE(stateBytes, wordIndex * 4))

@borrows
fn lspSourceHashStateLoad(
        states: int64[],
        blockIndex: int32,
        stateBytes: var rawbytes.Bytes) =
    let wordBase = blockIndex * 8
    for wordIndex in 0..<8:
        lsp_sha256.StoreU32LE(
            stateBytes, wordIndex * 4, states[wordBase + wordIndex])

@borrows
fn lspSourceHashCacheShapeValid(
        contentCid: layout.FixedBytes32,
        textLength: int32,
        states: int64[],
        mirror: int64[]): bool =
    if textLength < 0 ||
       layout.FixedBytes32Equal(contentCid, layout.FixedBytes32()) ||
       states.len != (textLength / 64) * 8 ||
       states.len != mirror.len:
        return false
    for stateIndex in 0..<states.len:
        if states[stateIndex] != mirror[stateIndex]:
            return false
    return true

@borrows
fn lspSourceContentCidCachedInto(
        text: str,
        reusablePrefixBytes: int32,
        previousContentCid: layout.FixedBytes32,
        previousTextLength: int32,
        previousStates: int64[],
        previousMirror: int64[],
        outCid: var layout.FixedBytes32,
        outStates: var int64[],
        outMirror: var int64[],
        err: var str): bool =
    outCid = layout.FixedBytes32()
    outStates = []
    outMirror = []
    if reusablePrefixBytes < 0 || reusablePrefixBytes > text.len:
        err = " lsp source hash: reusable prefix is invalid"
        return false
    var reuseBlockCount: int32
    if previousTextLength >= 0:
        if !lspSourceHashCacheShapeValid(
                previousContentCid, previousTextLength,
                previousStates, previousMirror):
            err = " lsp source hash: previous block-state cache is corrupt"
            return false
        reuseBlockCount = reusablePrefixBytes / 64
        let previousBlockCount = previousTextLength / 64
        let nextBlockCount = text.len / 64
        if reuseBlockCount > previousBlockCount:
            reuseBlockCount = previousBlockCount
        if reuseBlockCount > nextBlockCount:
            reuseBlockCount = nextBlockCount
    elif previousStates.len != 0 || previousMirror.len != 0:
        err = " lsp source hash: unexpected initial block-state cache"
        return false

    var states: int64[]
    for stateIndex in 0..<(reuseBlockCount * 8):
        add(states, previousStates[stateIndex])
    var stateBytes = rawbytes.BytesAlloc(32)
    if reuseBlockCount > 0:
        lspSourceHashStateLoad(
            states, reuseBlockCount - 1, stateBytes)
    else:
        lsp_sha256.StoreU32LE(
            stateBytes, 0, lsp_sha256.U32FromBytes(0x6a, 0x09, 0xe6, 0x67))
        lsp_sha256.StoreU32LE(
            stateBytes, 4, lsp_sha256.U32FromBytes(0xbb, 0x67, 0xae, 0x85))
        lsp_sha256.StoreU32LE(
            stateBytes, 8, lsp_sha256.U32FromBytes(0x3c, 0x6e, 0xf3, 0x72))
        lsp_sha256.StoreU32LE(
            stateBytes, 12, lsp_sha256.U32FromBytes(0xa5, 0x4f, 0xf5, 0x3a))
        lsp_sha256.StoreU32LE(
            stateBytes, 16, lsp_sha256.U32FromBytes(0x51, 0x0e, 0x52, 0x7f))
        lsp_sha256.StoreU32LE(
            stateBytes, 20, lsp_sha256.U32FromBytes(0x9b, 0x05, 0x68, 0x8c))
        lsp_sha256.StoreU32LE(
            stateBytes, 24, lsp_sha256.U32FromBytes(0x1f, 0x83, 0xd9, 0xab))
        lsp_sha256.StoreU32LE(
            stateBytes, 28, lsp_sha256.U32FromBytes(0x5b, 0xe0, 0xcd, 0x19))
    var kTable = rawbytes.BytesAlloc(256)
    for roundIndex in 0..<64:
        lsp_sha256.StoreU32LE(
            kTable, roundIndex * 4, lsp_sha256.K256(roundIndex))
    let sourceBytes = rawbytes.BytesFromString(text)
    var hashSchedule: int64[]
    setLen(hashSchedule, 64)
    var sourceOffset = reuseBlockCount * 64
    while sourceOffset + 64 <= text.len:
        lsp_sha256.Sha256CompressBlockReuse(
            stateBytes,
            rawbytes.BytesView(
                rawmem_support.RawmemPtrAdd(
                    sourceBytes.data, sourceOffset), 64),
            kTable,
            hashSchedule)
        lspSourceHashStateAppend(states, stateBytes)
        sourceOffset = sourceOffset + 64

    let remaining = text.len - sourceOffset
    let paddingLength = remaining < 56 ? 64 : 128
    var padding = rawbytes.BytesAlloc(paddingLength)
    if remaining > 0:
        rawmem_support.RawmemCopy(
            padding.data,
            rawmem_support.RawmemPtrAdd(sourceBytes.data, sourceOffset),
            remaining)
    rawbytes.BytesSet(padding, remaining, 0x80)
    var bitLength = int64(text.len) * int64(8)
    for lengthIndex in 0..<8:
        rawbytes.BytesSet(
            padding, paddingLength - 1 - lengthIndex,
            int32(bitLength & int64(255)))
        bitLength = bitLength >> 8
    var paddingOffset: int32
    while paddingOffset < paddingLength:
        lsp_sha256.Sha256CompressBlockReuse(
            stateBytes,
            rawbytes.BytesView(
                rawmem_support.RawmemPtrAdd(
                    padding.data, paddingOffset), 64),
            kTable,
            hashSchedule)
        paddingOffset = paddingOffset + 64
    var digestBytes = rawbytes.BytesAlloc(layout.FixedBytes32Size)
    for wordIndex in 0..<8:
        lsp_sha256.SetU32BE(
            digestBytes, wordIndex * 4,
            lsp_sha256.LoadU32LE(stateBytes, wordIndex * 4))
    let fixedResult = layout.FixedBytes32FromBytes(digestBytes)
    if IsErr(fixedResult):
        panic("lsp_source_hash_digest_width")
    let contentCid = Value(fixedResult)
    var mirror: int64[]
    for stateIndex in 0..<states.len:
        add(mirror, states[stateIndex])
    rawbytes.BytesFree(digestBytes)
    rawbytes.BytesFree(padding)
    rawbytes.BytesFree(kTable)
    rawbytes.BytesFree(stateBytes)
    outCid = contentCid
    outStates = states
    outMirror = mirror
    err = ""
    return true

@borrows
fn lspUtf8ScalarAtInto(
        text: str,
        byteOffset: int32,
        scalarOut: var int32,
        widthOut: var int32,
        err: var str): bool =
    scalarOut = 0
    widthOut = 0
    if byteOffset < 0 || byteOffset >= text.len:
        err = " lsp text: UTF-8 offset out of range"
        return false
    let b0 = Int32(text[byteOffset]) & 255
    if b0 < 128:
        scalarOut = b0
        widthOut = 1
        return true
    var width: int32
    var scalar: int32
    var minimum: int32
    if (b0 & 224) == 192:
        width = 2
        scalar = b0 & 31
        minimum = 128
    elif (b0 & 240) == 224:
        width = 3
        scalar = b0 & 15
        minimum = 2048
    elif (b0 & 248) == 240:
        width = 4
        scalar = b0 & 7
        minimum = 65536
    else:
        err = " lsp text: invalid UTF-8 leading byte"
        return false
    if byteOffset + width > text.len:
        err = " lsp text: truncated UTF-8 scalar"
        return false
    for offset in 1..<width:
        let continuation = Int32(text[byteOffset + offset]) & 255
        if (continuation & 192) != 128:
            err = " lsp text: invalid UTF-8 continuation byte"
            return false
        scalar = (scalar << 6) | (continuation & 63)
    if scalar < minimum || scalar > 1114111 ||
       (scalar >= 55296 && scalar <= 57343):
        err = " lsp text: non-canonical UTF-8 scalar"
        return false
    scalarOut = scalar
    widthOut = width
    return true

@borrows
fn lspUtf8TextValidInto(text: str, err: var str): bool =
    var byteOffset: int32
    while byteOffset < text.len:
        var scalar: int32
        var width: int32
        if !lspUtf8ScalarAtInto(
                text, byteOffset, scalar, width, err):
            return false
        byteOffset = byteOffset + width
    err = ""
    return true

@borrows
fn lspPositionToByteOffsetInto(
        text: str,
        line: int32,
        utf16Character: int32,
        byteOffsetOut: var int32,
        err: var str): bool =
    byteOffsetOut = -1
    if line < 0 || utf16Character < 0:
        err = " lsp text: negative position"
        return false
    var byteOffset: int32
    var currentLine: int32
    var currentCharacter: int32
    while byteOffset < text.len:
        if currentLine == line && currentCharacter == utf16Character:
            byteOffsetOut = byteOffset
            return true
        var scalar: int32
        var width: int32
        if !lspUtf8ScalarAtInto(text, byteOffset, scalar, width, err):
            return false
        if scalar == 10:
            if currentLine == line:
                err = " lsp text: character exceeds line"
                return false
            currentLine = currentLine + 1
            currentCharacter = 0
        else:
            if currentLine == line:
                let units: int32 = scalar > 65535 ? 2 : 1
                if currentCharacter + units > utf16Character:
                    err = " lsp text: position splits a UTF-16 surrogate pair"
                    return false
                currentCharacter = currentCharacter + units
        byteOffset = byteOffset + width
    if currentLine == line && currentCharacter == utf16Character:
        byteOffsetOut = byteOffset
        return true
    err = " lsp text: position exceeds document"
    return false

@borrows
fn lspBuildLineStartsAndValidateInto(
        text: str,
        lineStartsOut: var int32[],
        err: var str): bool =
    var lineStarts: int32[]
    add(lineStarts, 0)
    var byteOffset: int32
    while byteOffset < text.len:
        var scalar: int32
        var width: int32
        if !lspUtf8ScalarAtInto(
                text, byteOffset, scalar, width, err):
            return false
        byteOffset = byteOffset + width
        if scalar == 10:
            add(lineStarts, byteOffset)
    lineStartsOut = lineStarts
    err = ""
    return true

@borrows
fn lspLineStartsShapeValid(
        text: str,
        lineStarts: int32[]): bool =
    if lineStarts.len <= 0 || lineStarts[0] != 0:
        return false
    for index in 1..<lineStarts.len:
        if lineStarts[index] <= lineStarts[index - 1] ||
           lineStarts[index] > text.len ||
           text[lineStarts[index] - 1] != '\n':
            return false
    return true

@borrows
fn lspIndexedPositionToByteOffsetInto(
        text: str,
        lineStarts: int32[],
        line: int32,
        utf16Character: int32,
        byteOffsetOut: var int32,
        err: var str): bool =
    byteOffsetOut = -1
    if !lspLineStartsShapeValid(text, lineStarts) ||
       line < 0 || line >= lineStarts.len || utf16Character < 0:
        err = " lsp didChange: invalid indexed position"
        return false
    var byteOffset = lineStarts[line]
    var lineEnd = text.len
    if line + 1 < lineStarts.len:
        lineEnd = lineStarts[line + 1] - 1
    var currentCharacter: int32
    while byteOffset < lineEnd:
        if currentCharacter == utf16Character:
            byteOffsetOut = byteOffset
            err = ""
            return true
        var scalar: int32
        var width: int32
        if !lspUtf8ScalarAtInto(
                text, byteOffset, scalar, width, err):
            return false
        let units: int32 = scalar > 65535 ? 2 : 1
        if currentCharacter + units > utf16Character:
            err = " lsp didChange: position splits a UTF-16 surrogate pair"
            return false
        currentCharacter = currentCharacter + units
        byteOffset = byteOffset + width
    if currentCharacter == utf16Character:
        byteOffsetOut = byteOffset
        err = ""
        return true
    err = " lsp didChange: character exceeds line"
    return false

@borrows
fn lspUtf16LengthInto(
        text: str,
        startByte: int32,
        endByte: int32,
        lengthOut: var int32,
        err: var str): bool =
    lengthOut = 0
    if startByte < 0 || endByte < startByte || endByte > text.len:
        err = " lsp text: invalid UTF-16 length range"
        return false
    var byteOffset = startByte
    var length: int32
    while byteOffset < endByte:
        var scalar: int32
        var width: int32
        if !lspUtf8ScalarAtInto(text, byteOffset, scalar, width, err) ||
           byteOffset + width > endByte:
            if err == "":
                err = " lsp text: range splits UTF-8 scalar"
            return false
        length = length + (scalar > 65535 ? 2 : 1)
        byteOffset = byteOffset + width
    lengthOut = length
    return true

@borrows
fn lspPositionToSnapshotColumnInto(
        text: str,
        line: int32,
        utf16Character: int32,
        columnOut: var int32,
        err: var str): bool =
    columnOut = -1
    var byteOffset: int32
    if !lspPositionToByteOffsetInto(
            text, line, utf16Character, byteOffset, err):
        return false
    var lineStart = byteOffset
    while lineStart > 0 && text[lineStart - 1] != '\n':
        lineStart = lineStart - 1
    columnOut = byteOffset - lineStart
    err = ""
    return true

@borrows
fn lspByteOffsetToSnapshotPositionInto(
        text: str,
        targetByteOffset: int32,
        lineOut: var int32,
        columnOut: var int32,
        err: var str): bool =
    lineOut = -1
    columnOut = -1
    if targetByteOffset < 0 || targetByteOffset > text.len:
        err = " lsp snapshot position: byte offset exceeds source"
        return false
    var byteOffset: int32
    var line: int32
    var column: int32
    while byteOffset < targetByteOffset:
        var scalar: int32
        var width: int32
        if !lspUtf8ScalarAtInto(
               text, byteOffset, scalar, width, err) ||
           byteOffset + width > targetByteOffset:
            if err == "":
                err = " lsp snapshot position: byte offset splits UTF-8 scalar"
            return false
        byteOffset = byteOffset + width
        if scalar == 10:
            line = line + 1
            column = 0
        else:
            column = column + width
    lineOut = line
    columnOut = column
    err = ""
    return true

@borrows
fn lspSnapshotColumnToUtf16Into(
        text: str,
        line: int32,
        byteColumn: int32,
        utf16CharacterOut: var int32,
        err: var str): bool =
    utf16CharacterOut = -1
    var lineStart: int32
    if !lspPositionToByteOffsetInto(text, line, 0, lineStart, err):
        return false
    var lineEnd = lineStart
    while lineEnd < text.len && text[lineEnd] != '\n':
        lineEnd = lineEnd + 1
    if byteColumn < 0 || lineStart + byteColumn > lineEnd:
        err = " lsp snapshot position: byte column exceeds line"
        return false
    if !lspUtf16LengthInto(
            text, lineStart, lineStart + byteColumn,
            utf16CharacterOut, err):
        return false
    err = ""
    return true

@borrows
fn lspLineStartsAfterEditInto(
        previous: int32[],
        startLine: int32,
        endLine: int32,
        startByte: int32,
        endByte: int32,
        replacement: str,
        out: var int32[],
        err: var str): bool =
    if previous.len <= 0 || startLine < 0 || endLine < startLine ||
       endLine >= previous.len || startByte < previous[startLine] ||
       endByte < previous[endLine] || endByte < startByte:
        err = " lsp didChange: line index edit mismatch"
        return false
    var next: int32[]
    for lineIndex in 0..startLine:
        add(next, previous[lineIndex])
    for byteIndex in 0..<replacement.len:
        if replacement[byteIndex] == '\n':
            add(next, startByte + byteIndex + 1)
    let delta = replacement.len - (endByte - startByte)
    for lineIndex in (endLine + 1)..<previous.len:
        add(next, previous[lineIndex] + delta)
    out = next
    err = ""
    return true

@borrows
fn lspApplyContentChangesInto(
        originalText: str,
        originalLineStarts: int32[],
        changes: LspContentChange[],
        out: var str,
        lineStartsOut: var int32[],
        reusablePrefixBytesOut: var int32,
        err: var str): bool =
    reusablePrefixBytesOut = 0
    if changes.len <= 0:
        err = " lsp didChange: empty contentChanges"
        return false
    var reusablePrefixBytes = originalText.len
    var nextText = originalText
    var nextLineStarts: int32[]
    for lineIndex in 0..<originalLineStarts.len:
        add(nextLineStarts, originalLineStarts[lineIndex])
    if !lspLineStartsShapeValid(nextText, nextLineStarts):
        err = " lsp didChange: invalid line index"
        return false
    for index in 0..<changes.len:
        if !changes[index].rangePresent:
            err = " lsp didChange: full-document replacement is disabled"
            return false
        if !lspUtf8TextValidInto(changes[index].text, err):
            return false
        var startByte: int32
        var endByte: int32
        if changes[index].endLine < changes[index].startLine ||
           (changes[index].endLine == changes[index].startLine &&
                changes[index].endCharacter <
                    changes[index].startCharacter) ||
           !lspIndexedPositionToByteOffsetInto(
                nextText, nextLineStarts,
                changes[index].startLine, changes[index].startCharacter,
                startByte, err) ||
           !lspIndexedPositionToByteOffsetInto(
                nextText, nextLineStarts,
                changes[index].endLine, changes[index].endCharacter,
                endByte, err):
            if err == "":
                err = " lsp didChange: invalid range"
            return false
        if startByte < reusablePrefixBytes:
            reusablePrefixBytes = startByte
        if changes[index].rangeLengthPresent:
            var actualLength: int32
            if changes[index].rangeLength < 0 ||
               !lspUtf16LengthInto(
                   nextText, startByte, endByte, actualLength, err) ||
               actualLength != changes[index].rangeLength:
                if err == "":
                    err = " lsp didChange: rangeLength mismatch"
                return false
        let prefix = strings.SliceBytes(nextText, 0, startByte)
        let suffix = strings.SliceBytes(
            nextText, endByte, nextText.len - endByte)
        var updatedLineStarts: int32[]
        if !lspLineStartsAfterEditInto(
                nextLineStarts,
                changes[index].startLine, changes[index].endLine,
                startByte, endByte, changes[index].text,
                updatedLineStarts, err):
            return false
        nextText = parser.ParserConcat3(
            prefix, changes[index].text, suffix)
        if !lspLineStartsShapeValid(nextText, updatedLineStarts):
            err = " lsp didChange: updated line index invalid"
            return false
        nextLineStarts = updatedLineStarts
    out = nextText
    lineStartsOut = nextLineStarts
    reusablePrefixBytesOut = reusablePrefixBytes
    err = ""
    return true

const lspMetricEventOpenKind: int32 = 1
const lspMetricEventChangeKind: int32 = 2
const lspMetricEventCloseKind: int32 = 3
const lspMetricEventCreateKind: int32 = 4
const lspMetricEventDeleteKind: int32 = 5
const lspMetricEventRenameKind: int32 = 6

fn lspWorkspaceRecordSourceHashWork(
        workspace: var LspWorkspace,
        textLength: int32,
        reusedBlockCount: int32,
        cacheHit: bool) =
    if cacheHit:
        workspace.metrics.sourceHashCacheHitCount =
            workspace.metrics.sourceHashCacheHitCount + int64(1)
    else:
        workspace.metrics.sourceHashCacheColdCount =
            workspace.metrics.sourceHashCacheColdCount + int64(1)
    let fullBlockCount = textLength / 64
    let paddingBlockCount: int32 = (textLength % 64) < 56 ? 1 : 2
    workspace.metrics.sourceHashReusedBlockCount =
        workspace.metrics.sourceHashReusedBlockCount + int64(reusedBlockCount)
    workspace.metrics.sourceHashCompressedBlockCount =
        workspace.metrics.sourceHashCompressedBlockCount +
        int64(fullBlockCount - reusedBlockCount + paddingBlockCount)

fn lspWorkspaceRecordEventWall(
        workspace: var LspWorkspace,
        startedNs: int64,
        eventKind: int32): int64 =
    let elapsedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - startedNs
    workspace.metrics.eventAttemptWallNs =
        workspace.metrics.eventAttemptWallNs + elapsedNs
    if eventKind == lspMetricEventOpenKind:
        workspace.metrics.didOpenAttemptWallNs =
            workspace.metrics.didOpenAttemptWallNs + elapsedNs
    elif eventKind == lspMetricEventChangeKind:
        workspace.metrics.didChangeAttemptWallNs =
            workspace.metrics.didChangeAttemptWallNs + elapsedNs
    elif eventKind == lspMetricEventCloseKind:
        workspace.metrics.didCloseAttemptWallNs =
            workspace.metrics.didCloseAttemptWallNs + elapsedNs
    elif eventKind == lspMetricEventCreateKind:
        workspace.metrics.didCreateAttemptWallNs =
            workspace.metrics.didCreateAttemptWallNs + elapsedNs
    elif eventKind == lspMetricEventDeleteKind:
        workspace.metrics.didDeleteAttemptWallNs =
            workspace.metrics.didDeleteAttemptWallNs + elapsedNs
    elif eventKind == lspMetricEventRenameKind:
        workspace.metrics.didRenameAttemptWallNs =
            workspace.metrics.didRenameAttemptWallNs + elapsedNs
    else:
        panic("lsp_metric_event_kind_invalid")
    return elapsedNs

fn lspWorkspaceEventReject(
        workspace: var LspWorkspace,
        startedNs: int64,
        eventKind: int32): bool =
    let _ = lspWorkspaceRecordEventWall(workspace, startedNs, eventKind)
    return false

@borrows
fn lspWorkspaceCurrentSourceVersionTerminal(
        workspace: LspWorkspace): bool =
    let currentSourceVersion =
        workspace.snapshotStore.core.currentSourceVersion
    let count = workspace.snapshotStore.core.states.len
    if currentSourceVersion <= 0 ||
       currentSourceVersion !=
           workspace.eventState.lastAcceptedSourceVersion ||
       workspace.snapshotStore.core.candidateIndex != -1 || count <= 0 ||
       workspace.snapshotStore.core.sourceVersions.len != count:
        return false
    let snapshotIndex = count - 1
    let state = workspace.snapshotStore.core.states[snapshotIndex]
    return workspace.snapshotStore.core.sourceVersions[snapshotIndex] ==
               currentSourceVersion &&
        (state == snapshot_core.SemanticSnapshotStatePublished ||
         state == snapshot_core.SemanticSnapshotStateRejected)

fn lspWorkspaceProduceAcceptedSourceVersionInto(
        workspace: var LspWorkspace,
        acceptedSourceVersion: int64) =
    if acceptedSourceVersion <= 0 ||
       acceptedSourceVersion !=
           workspace.eventState.lastAcceptedSourceVersion ||
       acceptedSourceVersion !=
           workspace.snapshotStore.core.currentSourceVersion:
        panic("lsp_accepted_source_version_candidate_input_drift")
    if gCandidateScheduler.enabled:
        var scheduleErr: str
        if !lspCandidateSchedulerEnqueueInto(
               workspace, acceptedSourceVersion, scheduleErr):
            panic(Fmt"lsp_candidate_job_enqueue_failed {scheduleErr}")
        return
    let attemptCountBefore = workspace.metrics.candidateAttemptCount
    let publishedCountBefore =
        workspace.metrics.candidatePublishedCount
    let rejectedCountBefore =
        workspace.metrics.candidateRejectedCount
    var candidateErr: str
    let published = lspWorkspaceTryProduceCurrentCompilerSnapshotInto(
        workspace, candidateErr)
    if workspace.metrics.candidateAttemptCount !=
           attemptCountBefore + int64(1) ||
       !lspWorkspaceCurrentSourceVersionTerminal(workspace):
        panic("lsp_accepted_source_version_not_terminal")
    let snapshotIndex = workspace.snapshotStore.core.states.len - 1
    let state = workspace.snapshotStore.core.states[snapshotIndex]
    if published:
        if state != snapshot_core.SemanticSnapshotStatePublished ||
           candidateErr != "" ||
           workspace.candidateBlockedReason != "" ||
           workspace.metrics.candidatePublishedCount !=
               publishedCountBefore + int64(1) ||
           workspace.metrics.candidateRejectedCount !=
               rejectedCountBefore:
            panic("lsp_published_candidate_outcome_drift")
    elif state != snapshot_core.SemanticSnapshotStateRejected ||
         candidateErr == "" ||
         workspace.candidateBlockedReason == "" ||
         workspace.metrics.candidatePublishedCount !=
             publishedCountBefore ||
         workspace.metrics.candidateRejectedCount !=
             rejectedCountBefore + int64(1):
        panic("lsp_rejected_candidate_outcome_drift")

@borrows
fn LspWorkspaceDidOpenInto(
        workspace: var LspWorkspace,
        uri: str,
        clientVersion: int64,
        text: str,
        sourceVersionOut: var int64,
        err: var str): bool =
    let startedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    workspace.metrics.eventAttemptCount =
        workspace.metrics.eventAttemptCount + int64(1)
    sourceVersionOut = 0
    let textLength = text.len
    let row = lspWorkspaceFindDocumentByUri(workspace, uri)
    if row < 0 || !workspace.documents[row].present:
        err = " lsp didOpen: canonical document identity is not bound"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventOpenKind)
    var lineStarts: int32[]
    let lineIndexStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let lineIndexBuilt =
        lspBuildLineStartsAndValidateInto(text, lineStarts, err)
    workspace.metrics.lineIndexBuildWallNs =
        workspace.metrics.lineIndexBuildWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - lineIndexStartedNs
    if !lineIndexBuilt:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventOpenKind)
    let hashStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    var contentCid: layout.FixedBytes32
    var hashStates: int64[]
    var hashMirror: int64[]
    let contentHashed = lspSourceContentCidCachedInto(
        text, 0, layout.FixedBytes32(), -1, [], [],
        contentCid, hashStates, hashMirror, err)
    let hashElapsedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - hashStartedNs
    workspace.metrics.sourceContentHashWallNs =
        workspace.metrics.sourceContentHashWallNs + hashElapsedNs
    workspace.metrics.didOpenSourceContentHashWallNs =
        workspace.metrics.didOpenSourceContentHashWallNs + hashElapsedNs
    if !contentHashed:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventOpenKind)
    lspWorkspaceRecordSourceHashWork(workspace, textLength, 0, false)
    let eventAcceptanceStartedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let eventAccepted =
        snapshot_production.SemanticSnapshotProductionAcceptSourceEventInto(
            workspace.eventState, workspace.snapshotStore,
            snapshot_core.SemanticSourceEventOpen,
            workspace.documents[row].documentCid, clientVersion,
            sourceVersionOut, err)
    workspace.metrics.sourceEventAcceptanceWallNs =
        workspace.metrics.sourceEventAcceptanceWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) -
        eventAcceptanceStartedNs
    if !eventAccepted:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventOpenKind)
    workspace.documents[row].text = parser.ParserOwnedText(text)
    workspace.documents[row].contentCid = contentCid
    workspace.documents[row].lineStartByteOffsets = lineStarts
    workspace.documents[row].sourceHashBlockStates = hashStates
    workspace.documents[row].sourceHashBlockStatesMirror = hashMirror
    workspace.documents[row].sourceHashCacheContentCid = contentCid
    workspace.documents[row].sourceHashCacheTextLength = textLength
    workspace.documents[row].sourceText = parser.ParserOwnedText(text)
    workspace.documents[row].sourceContentCid = contentCid
    workspace.documents[row].clientVersion = clientVersion
    workspace.documents[row].open = true
    workspace.metrics.eventAcceptedCount =
        workspace.metrics.eventAcceptedCount + int64(1)
    workspace.metrics.didOpenAcceptedCount =
        workspace.metrics.didOpenAcceptedCount + int64(1)
    lspWorkspaceProduceAcceptedSourceVersionInto(
        workspace, sourceVersionOut)
    let elapsedNs = lspWorkspaceRecordEventWall(
        workspace, startedNs, lspMetricEventOpenKind)
    workspace.metrics.acceptedEventWallNs =
        workspace.metrics.acceptedEventWallNs + elapsedNs
    err = ""
    return true

@borrows
fn LspWorkspaceDidChangeInto(
        workspace: var LspWorkspace,
        uri: str,
        clientVersion: int64,
        changes: LspContentChange[],
        sourceVersionOut: var int64,
        err: var str): bool =
    let startedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    workspace.metrics.eventAttemptCount =
        workspace.metrics.eventAttemptCount + int64(1)
    sourceVersionOut = 0
    let row = lspWorkspaceFindDocumentByUri(workspace, uri)
    if row < 0 || !workspace.documents[row].present ||
       !workspace.documents[row].open:
        err = " lsp didChange: document is not open"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventChangeKind)
    var nextText: str
    var nextLineStarts: int32[]
    var reusablePrefixBytes: int32
    let contentChangeStartedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let contentChangeApplied = lspApplyContentChangesInto(
            workspace.documents[row].text,
            workspace.documents[row].lineStartByteOffsets,
            changes, nextText, nextLineStarts,
            reusablePrefixBytes, err)
    workspace.metrics.contentChangeApplyWallNs =
        workspace.metrics.contentChangeApplyWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - contentChangeStartedNs
    if !contentChangeApplied:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventChangeKind)
    let nextTextLength = nextText.len
    if workspace.documents[row].sourceHashCacheTextLength !=
           workspace.documents[row].text.len ||
       !layout.FixedBytes32Equal(
           workspace.documents[row].sourceHashCacheContentCid,
           workspace.documents[row].contentCid):
        err = " lsp source hash: document cache binding is corrupt"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventChangeKind)
    let hashStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    var contentCid: layout.FixedBytes32
    var hashStates: int64[]
    var hashMirror: int64[]
    let contentHashed = lspSourceContentCidCachedInto(
        nextText, reusablePrefixBytes,
        workspace.documents[row].sourceHashCacheContentCid,
        workspace.documents[row].sourceHashCacheTextLength,
        workspace.documents[row].sourceHashBlockStates,
        workspace.documents[row].sourceHashBlockStatesMirror,
        contentCid, hashStates, hashMirror, err)
    let hashElapsedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - hashStartedNs
    workspace.metrics.sourceContentHashWallNs =
        workspace.metrics.sourceContentHashWallNs + hashElapsedNs
    workspace.metrics.didChangeSourceContentHashWallNs =
        workspace.metrics.didChangeSourceContentHashWallNs + hashElapsedNs
    if !contentHashed:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventChangeKind)
    var reusedBlockCount = reusablePrefixBytes / 64
    let previousBlockCount =
        workspace.documents[row].sourceHashCacheTextLength / 64
    let nextBlockCount = nextTextLength / 64
    if reusedBlockCount > previousBlockCount:
        reusedBlockCount = previousBlockCount
    if reusedBlockCount > nextBlockCount:
        reusedBlockCount = nextBlockCount
    lspWorkspaceRecordSourceHashWork(
        workspace, nextTextLength, reusedBlockCount, reusedBlockCount > 0)
    let eventAcceptanceStartedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let eventAccepted =
        snapshot_production.SemanticSnapshotProductionAcceptSourceEventInto(
            workspace.eventState, workspace.snapshotStore,
            snapshot_core.SemanticSourceEventChange,
            workspace.documents[row].documentCid, clientVersion,
            sourceVersionOut, err)
    workspace.metrics.sourceEventAcceptanceWallNs =
        workspace.metrics.sourceEventAcceptanceWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) -
        eventAcceptanceStartedNs
    if !eventAccepted:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventChangeKind)
    workspace.documents[row].text = parser.ParserOwnedText(nextText)
    workspace.documents[row].contentCid = contentCid
    workspace.documents[row].lineStartByteOffsets = nextLineStarts
    workspace.documents[row].sourceHashBlockStates = hashStates
    workspace.documents[row].sourceHashBlockStatesMirror = hashMirror
    workspace.documents[row].sourceHashCacheContentCid = contentCid
    workspace.documents[row].sourceHashCacheTextLength = nextTextLength
    workspace.documents[row].sourceText = nextText
    workspace.documents[row].sourceContentCid = contentCid
    workspace.documents[row].clientVersion = clientVersion
    workspace.metrics.eventAcceptedCount =
        workspace.metrics.eventAcceptedCount + int64(1)
    workspace.metrics.didChangeAcceptedCount =
        workspace.metrics.didChangeAcceptedCount + int64(1)
    lspWorkspaceProduceAcceptedSourceVersionInto(
        workspace, sourceVersionOut)
    let elapsedNs = lspWorkspaceRecordEventWall(
        workspace, startedNs, lspMetricEventChangeKind)
    workspace.metrics.acceptedEventWallNs =
        workspace.metrics.acceptedEventWallNs + elapsedNs
    err = ""
    return true

@borrows
fn LspWorkspaceDidCloseInto(
        workspace: var LspWorkspace,
        uri: str,
        sourceVersionOut: var int64,
        err: var str): bool =
    let startedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    workspace.metrics.eventAttemptCount =
        workspace.metrics.eventAttemptCount + int64(1)
    sourceVersionOut = 0
    let row = lspWorkspaceFindDocumentByUri(workspace, uri)
    if row < 0 || !workspace.documents[row].present ||
       !workspace.documents[row].open:
        err = " lsp didClose: document is not open"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventCloseKind)
    if !lspDocumentSealedBaseStrictValidateInto(
            workspace.documents[row], err):
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventCloseKind)
    let eventAcceptanceStartedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let eventAccepted =
        snapshot_production.SemanticSnapshotProductionAcceptSourceEventInto(
            workspace.eventState, workspace.snapshotStore,
            snapshot_core.SemanticSourceEventClose,
            workspace.documents[row].documentCid, int64(-1),
            sourceVersionOut, err)
    workspace.metrics.sourceEventAcceptanceWallNs =
        workspace.metrics.sourceEventAcceptanceWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) -
        eventAcceptanceStartedNs
    if !eventAccepted:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventCloseKind)
    workspace.documents[row].text = ""
    workspace.documents[row].contentCid = layout.FixedBytes32()
    workspace.documents[row].lineStartByteOffsets = []
    workspace.documents[row].sourceHashBlockStates = []
    workspace.documents[row].sourceHashBlockStatesMirror = []
    workspace.documents[row].sourceHashCacheContentCid = layout.FixedBytes32()
    workspace.documents[row].sourceHashCacheTextLength = 0
    workspace.documents[row].sourceText =
        parser.ParserOwnedText(
            workspace.documents[row].sealedBaseSourceText)
    workspace.documents[row].sourceContentCid =
        workspace.documents[row].sealedBaseSourceContentCid
    workspace.documents[row].open = false
    workspace.metrics.eventAcceptedCount =
        workspace.metrics.eventAcceptedCount + int64(1)
    workspace.metrics.didCloseAcceptedCount =
        workspace.metrics.didCloseAcceptedCount + int64(1)
    lspWorkspaceProduceAcceptedSourceVersionInto(
        workspace, sourceVersionOut)
    let elapsedNs = lspWorkspaceRecordEventWall(
        workspace, startedNs, lspMetricEventCloseKind)
    workspace.metrics.acceptedEventWallNs =
        workspace.metrics.acceptedEventWallNs + elapsedNs
    err = ""
    return true

@borrows
fn lspWorkspaceFindEventRowByCid(
        workspace: LspWorkspace,
        documentCid: layout.FixedBytes32): int32 =
    for row in 0..<workspace.eventState.documentCids.len:
        if layout.FixedBytes32Equal(
                workspace.eventState.documentCids[row], documentCid):
            return row
    return -1

@borrows
fn lspWorkspaceBuildClosedFileDocumentInto(
        workspace: LspWorkspace,
        uri: str,
        out: var DocumentOverlay,
        err: var str): bool =
    out = DocumentOverlay()
    if !workspace.initialized || workspace.workspaceRoot == "" ||
       workspace.packageRoot == "" || workspace.packageId == "" ||
       workspace.targetTriple == "":
        err = " lsp file event: compiler workspace identity is unavailable"
        return false
    var sourcePath: str
    if !lspFileUriCanonicalPathInto(uri, sourcePath, err):
        return false
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    var modulePath: str
    if !parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
            workspace.workspaceRoot, workspace.packageRoot,
            workspace.packageId, noExternalRoots,
            sourcePath, modulePath):
        err = " lsp file event: source path is outside the workspace package"
        return false
    var documentCid: layout.FixedBytes32
    if !compiler_world.CompilerWorldDocumentCidInto(
            workspace.packageId, modulePath, documentCid, err):
        err = " lsp file event: compiler document CID unavailable"
        return false
    let sourceRead = os.ReadFileResult(sourcePath)
    if IsErr(sourceRead):
        err = strutil.Join([
            " lsp file event: source read failed: ",
            Error(sourceRead)], "")
        return false
    let sourceText = Value(sourceRead)
    if !lspUtf8TextValidInto(sourceText, err):
        err = " lsp file event: source bytes are not valid UTF-8"
        return false
    let contentCid =
        snapshot_schema.CsgCompilerSourceContentCid(sourceText)
    if layout.FixedBytes32Equal(contentCid, layout.FixedBytes32()):
        err = " lsp file event: source content CID is unavailable"
        return false
    var document: DocumentOverlay
    document.uri = strings.ConcatStr("", uri)
    document.documentCid = layout.FixedBytes32Copy(documentCid)
    document.sourcePath = sourcePath
    document.modulePath = modulePath
    document.sealedBaseSourceText = sourceText
    document.sealedBaseSourceContentCid =
        layout.FixedBytes32Copy(contentCid)
    document.sealedBaseSourceBound = true
    document.sourceText =
        strings.ConcatStr("", document.sealedBaseSourceText)
    document.sourceContentCid = layout.FixedBytes32Copy(contentCid)
    document.compilerIdentityBound = true
    document.present = true
    out = document
    err = ""
    return true

@borrows
fn LspWorkspaceDidCreateFileInto(
        workspace: var LspWorkspace,
        uri: str,
        sourceVersionOut: var int64,
        err: var str): bool =
    let startedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    workspace.metrics.eventAttemptCount =
        workspace.metrics.eventAttemptCount + int64(1)
    sourceVersionOut = 0
    var document: DocumentOverlay
    if !lspWorkspaceBuildClosedFileDocumentInto(
            workspace, uri, document, err):
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventCreateKind)
    let uriRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    let cidRow =
        lspWorkspaceFindDocumentByCid(workspace, document.documentCid)
    if uriRow != cidRow ||
       (uriRow >= 0 && workspace.documents[uriRow].present):
        err = " lsp didCreateFiles: duplicate or split document identity"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventCreateKind)
    for row in 0..<workspace.documents.len:
        if row == uriRow || !workspace.documents[row].present:
            continue
        if workspace.documents[row].sourcePath == document.sourcePath ||
           workspace.documents[row].modulePath == document.modulePath:
            err = " lsp didCreateFiles: target identity collision"
            return lspWorkspaceEventReject(
                workspace, startedNs, lspMetricEventCreateKind)
    let expectedStableRow =
        uriRow >= 0 ? uriRow : workspace.documents.len
    let eventAccepted =
        snapshot_production.SemanticSnapshotProductionAcceptSourceFileEventInto(
            workspace.eventState, workspace.snapshotStore,
            snapshot_core.SemanticSourceEventAdd,
            document.documentCid, layout.FixedBytes32(),
            sourceVersionOut, err)
    if !eventAccepted:
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventCreateKind)
    let stableRow =
        lspWorkspaceFindEventRowByCid(workspace, document.documentCid)
    if stableRow != expectedStableRow:
        panic("lsp_file_create_stable_row_split")
    document.stableEventRow = stableRow
    if uriRow >= 0:
        workspace.documents[uriRow] = document
    else:
        add(workspace.documents, document)
    workspace.metrics.explicitSourceFileReadCount =
        workspace.metrics.explicitSourceFileReadCount + int64(1)
    workspace.metrics.explicitSourceFileReadBytes =
        workspace.metrics.explicitSourceFileReadBytes +
        int64(workspace.documents[stableRow].sourceText.len)
    workspace.metrics.eventAcceptedCount =
        workspace.metrics.eventAcceptedCount + int64(1)
    workspace.metrics.didCreateAcceptedCount =
        workspace.metrics.didCreateAcceptedCount + int64(1)
    lspWorkspaceProduceAcceptedSourceVersionInto(
        workspace, sourceVersionOut)
    let elapsedNs = lspWorkspaceRecordEventWall(
        workspace, startedNs, lspMetricEventCreateKind)
    workspace.metrics.acceptedEventWallNs =
        workspace.metrics.acceptedEventWallNs + elapsedNs
    err = ""
    return true

@borrows
fn LspWorkspaceDidDeleteFileInto(
        workspace: var LspWorkspace,
        uri: str,
        sourceVersionOut: var int64,
        err: var str): bool =
    let startedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    workspace.metrics.eventAttemptCount =
        workspace.metrics.eventAttemptCount + int64(1)
    sourceVersionOut = 0
    let row = lspWorkspaceFindDocumentByUri(workspace, uri)
    if row < 0 || !workspace.documents[row].present:
        err = " lsp didDeleteFiles: remove for absent document"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventDeleteKind)
    if workspace.documents[row].entrySource ||
       layout.FixedBytes32Equal(
           workspace.documents[row].documentCid,
           workspace.entryDocumentCid):
        err = " lsp didDeleteFiles: entry source removal is forbidden"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventDeleteKind)
    if workspace.documents[row].stableEventRow != row:
        panic("lsp_file_delete_stable_row_split")
    if !snapshot_production.SemanticSnapshotProductionAcceptSourceFileEventInto(
            workspace.eventState, workspace.snapshotStore,
            snapshot_core.SemanticSourceEventRemove,
            workspace.documents[row].documentCid,
            layout.FixedBytes32(), sourceVersionOut, err):
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventDeleteKind)
    workspace.documents[row].text = ""
    workspace.documents[row].contentCid = layout.FixedBytes32()
    workspace.documents[row].lineStartByteOffsets = []
    workspace.documents[row].sourceHashBlockStates = []
    workspace.documents[row].sourceHashBlockStatesMirror = []
    workspace.documents[row].sourceHashCacheContentCid =
        layout.FixedBytes32()
    workspace.documents[row].sourceHashCacheTextLength = 0
    workspace.documents[row].sealedBaseSourceText = ""
    workspace.documents[row].sealedBaseSourceContentCid =
        layout.FixedBytes32()
    workspace.documents[row].sealedBaseSourceBound = false
    workspace.documents[row].sourceText = ""
    workspace.documents[row].sourceContentCid = layout.FixedBytes32()
    workspace.documents[row].open = false
    workspace.documents[row].present = false
    workspace.metrics.eventAcceptedCount =
        workspace.metrics.eventAcceptedCount + int64(1)
    workspace.metrics.didDeleteAcceptedCount =
        workspace.metrics.didDeleteAcceptedCount + int64(1)
    lspWorkspaceProduceAcceptedSourceVersionInto(
        workspace, sourceVersionOut)
    let elapsedNs = lspWorkspaceRecordEventWall(
        workspace, startedNs, lspMetricEventDeleteKind)
    workspace.metrics.acceptedEventWallNs =
        workspace.metrics.acceptedEventWallNs + elapsedNs
    err = ""
    return true

@borrows
fn LspWorkspaceDidRenameFileInto(
        workspace: var LspWorkspace,
        oldUri: str,
        newUri: str,
        sourceVersionOut: var int64,
        err: var str): bool =
    let startedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    workspace.metrics.eventAttemptCount =
        workspace.metrics.eventAttemptCount + int64(1)
    sourceVersionOut = 0
    let oldRow = lspWorkspaceFindDocumentByUri(workspace, oldUri)
    if oldRow < 0 || !workspace.documents[oldRow].present ||
       oldUri == newUri:
        err = " lsp didRenameFiles: rename source is absent or unchanged"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventRenameKind)
    var diskTarget: DocumentOverlay
    if !lspWorkspaceBuildClosedFileDocumentInto(
            workspace, newUri, diskTarget, err):
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventRenameKind)
    if !layout.FixedBytes32Equal(
            workspace.documents[oldRow].sealedBaseSourceContentCid,
            diskTarget.sealedBaseSourceContentCid):
        err = " lsp didRenameFiles: renamed source bytes changed"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventRenameKind)
    let uriRow = lspWorkspaceFindDocumentByUri(workspace, newUri)
    let cidRow =
        lspWorkspaceFindDocumentByCid(workspace, diskTarget.documentCid)
    if uriRow != cidRow ||
       (uriRow >= 0 && workspace.documents[uriRow].present) ||
       uriRow == oldRow:
        err = " lsp didRenameFiles: target identity collision"
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventRenameKind)
    for row in 0..<workspace.documents.len:
        if row == oldRow || row == uriRow ||
           !workspace.documents[row].present:
            continue
        if workspace.documents[row].sourcePath == diskTarget.sourcePath ||
           workspace.documents[row].modulePath == diskTarget.modulePath:
            err = " lsp didRenameFiles: target identity collision"
            return lspWorkspaceEventReject(
                workspace, startedNs, lspMetricEventRenameKind)
    let expectedTargetStableRow =
        uriRow >= 0 ? uriRow : workspace.documents.len
    var renamed =
        lspDocumentOverlayClone(workspace.documents[oldRow])
    renamed.uri = strings.ConcatStr("", diskTarget.uri)
    renamed.documentCid =
        layout.FixedBytes32Copy(diskTarget.documentCid)
    renamed.sourcePath =
        strings.ConcatStr("", diskTarget.sourcePath)
    renamed.modulePath =
        strings.ConcatStr("", diskTarget.modulePath)
    renamed.sealedBaseSourceText =
        strings.ConcatStr("", diskTarget.sealedBaseSourceText)
    renamed.sealedBaseSourceContentCid =
        layout.FixedBytes32Copy(
            diskTarget.sealedBaseSourceContentCid)
    renamed.sealedBaseSourceBound = true
    renamed.present = true
    renamed.stableEventRow = expectedTargetStableRow
    if !snapshot_production.SemanticSnapshotProductionAcceptSourceFileEventInto(
            workspace.eventState, workspace.snapshotStore,
            snapshot_core.SemanticSourceEventRename,
            workspace.documents[oldRow].documentCid,
            renamed.documentCid, sourceVersionOut, err):
        return lspWorkspaceEventReject(
            workspace, startedNs, lspMetricEventRenameKind)
    let targetStableRow =
        lspWorkspaceFindEventRowByCid(workspace, renamed.documentCid)
    if targetStableRow != expectedTargetStableRow:
        panic("lsp_file_rename_stable_row_split")
    renamed.stableEventRow = targetStableRow
    let renamedDocumentCid =
        layout.FixedBytes32Copy(renamed.documentCid)
    let renamedEntry = workspace.documents[oldRow].entrySource
    workspace.documents[oldRow].text = ""
    workspace.documents[oldRow].contentCid = layout.FixedBytes32()
    workspace.documents[oldRow].lineStartByteOffsets = []
    workspace.documents[oldRow].sourceHashBlockStates = []
    workspace.documents[oldRow].sourceHashBlockStatesMirror = []
    workspace.documents[oldRow].sourceHashCacheContentCid =
        layout.FixedBytes32()
    workspace.documents[oldRow].sourceHashCacheTextLength = 0
    workspace.documents[oldRow].sealedBaseSourceText = ""
    workspace.documents[oldRow].sealedBaseSourceContentCid =
        layout.FixedBytes32()
    workspace.documents[oldRow].sealedBaseSourceBound = false
    workspace.documents[oldRow].sourceText = ""
    workspace.documents[oldRow].sourceContentCid = layout.FixedBytes32()
    workspace.documents[oldRow].open = false
    workspace.documents[oldRow].present = false
    workspace.documents[oldRow].entrySource = false
    if uriRow >= 0:
        workspace.documents[uriRow] = renamed
    else:
        add(workspace.documents, renamed)
    if renamedEntry:
        workspace.entryDocumentCid =
            renamedDocumentCid
    workspace.metrics.explicitSourceFileReadCount =
        workspace.metrics.explicitSourceFileReadCount + int64(1)
    workspace.metrics.explicitSourceFileReadBytes =
        workspace.metrics.explicitSourceFileReadBytes +
        int64(diskTarget.sourceText.len)
    workspace.metrics.eventAcceptedCount =
        workspace.metrics.eventAcceptedCount + int64(1)
    workspace.metrics.didRenameAcceptedCount =
        workspace.metrics.didRenameAcceptedCount + int64(1)
    lspWorkspaceProduceAcceptedSourceVersionInto(
        workspace, sourceVersionOut)
    let elapsedNs = lspWorkspaceRecordEventWall(
        workspace, startedNs, lspMetricEventRenameKind)
    workspace.metrics.acceptedEventWallNs =
        workspace.metrics.acceptedEventWallNs + elapsedNs
    err = ""
    return true

fn lspWorkspaceCandidateReject(
        workspace: var LspWorkspace,
        startedNs: int64): bool =
    workspace.metrics.candidateRejectedCount =
        workspace.metrics.candidateRejectedCount + int64(1)
    workspace.metrics.candidateAdmissionPublishWallNs =
        workspace.metrics.candidateAdmissionPublishWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - startedNs
    return false

fn lspWorkspaceCompilerBindingConfigured(
        workspace: LspWorkspace): bool =
    return workspace.workspaceRoot != "" || workspace.packageRoot != "" ||
        workspace.packageId != "" || workspace.targetTriple != "" ||
        !layout.FixedBytes32Equal(
            workspace.entryDocumentCid, layout.FixedBytes32())

fn lspWorkspaceAutomaticCandidateReject(
        workspace: var LspWorkspace,
        startedNs: int64,
        diagnosticProducerKind: int32,
        reason: str,
        err: var str): bool =
    let versionedReason =
        Fmt"source_version={workspace.snapshotStore.core.currentSourceVersion} {reason}"
    if workspace.candidateCaptureOnly:
        if layout.FixedBytes32Equal(
               workspace.candidateCaptureJobCid,
               layout.FixedBytes32()):
            panic("lsp_candidate_capture_job_identity_missing")
        var completion: LspCandidateJobCompletion
        completion.jobCid =
            layout.FixedBytes32Copy(
                workspace.candidateCaptureJobCid)
        completion.sourceVersion =
            workspace.snapshotStore.core.currentSourceVersion
        completion.kind = lspCandidateCompletionEarlyRejected
        completion.diagnosticProducerKind =
            diagnosticProducerKind
        completion.reason =
            strings.ConcatStr("", versionedReason)
        completion.startedNs = startedNs
        completion.completionAuthorityCid =
            lspCandidateCompletionAuthorityCid(
                completion.jobCid,
                completion.sourceVersion,
                completion.kind,
                completion.reason,
                layout.FixedBytes32())
        workspace.candidateCapturedCompletion = completion
        err = versionedReason
        return false
    workspace.candidateBlockedReason = versionedReason
    var rejectionErr: str
    if workspace.snapshotStore.core.currentSourceVersion > 0 &&
       !lspWorkspaceCurrentVersionRejected(workspace) &&
       !lspWorkspaceRecordEarlyFailureInto(
            workspace, diagnosticProducerKind,
            versionedReason, rejectionErr):
        err = rejectionErr
        return lspWorkspaceCandidateReject(workspace, startedNs)
    err = versionedReason
    return lspWorkspaceCandidateReject(workspace, startedNs)

fn lspImmutableSourceDocumentsSort(
        documents:
            var query_projection.SemanticSnapshotSourceDocument[]) =
    for index in 1..<documents.len:
        let selected = documents[index]
        var cursor = index
        while cursor > 0 &&
              lspCidLess(selected.documentCid,
                         documents[cursor - 1].documentCid):
            documents[cursor] = documents[cursor - 1]
            cursor = cursor - 1
        documents[cursor] = selected

fn lspWorkspaceRecordCanonicalFailureInto(
        workspace: var LspWorkspace,
        dependencyRows: LspFailureDependencyRow[],
        diagnosticProducerKind: int32,
        producerDocumentCids: layout.FixedBytes32[],
        portableSourceBundleCid: layout.FixedBytes32,
        portableSourceIdentityReceiptCid: layout.FixedBytes32,
        structuredDiagnosticArtifact:
            var diagnostic_failure.DiagnosticFailureArtifact,
        structuredDiagnosticAuthority:
            var diagnostic_authority.ParserDiagnosticAuthority,
        structuredDiagnosticProducerProjectionCids:
            layout.FixedBytes32[],
        reason: str,
        err: var str): bool =
    var canonicalRows: int32[]
    for documentIndex in 0..<workspace.documents.len:
        if !workspace.documents[documentIndex].present:
            continue
        if !workspace.documents[documentIndex].compilerIdentityBound ||
           layout.FixedBytes32Equal(
               workspace.documents[documentIndex].documentCid,
               layout.FixedBytes32()) ||
           workspace.documents[documentIndex].modulePath == "":
            err = " lsp snapshot producer: early failure source identity incomplete"
            return false
        var insertAt = canonicalRows.len
        while insertAt > 0 && lspCidLess(
              workspace.documents[documentIndex].documentCid,
              workspace.documents[canonicalRows[insertAt - 1]].documentCid):
            insertAt = insertAt - 1
        add(canonicalRows, documentIndex)
        var cursor = canonicalRows.len - 1
        while cursor > insertAt:
            canonicalRows[cursor] = canonicalRows[cursor - 1]
            cursor = cursor - 1
        canonicalRows[insertAt] = documentIndex
    if canonicalRows.len <= 0:
        err = " lsp snapshot producer: early failure source domain empty"
        return false
    let portableIdentity =
        !layout.FixedBytes32Equal(
            portableSourceIdentityReceiptCid, layout.FixedBytes32())
    if (portableIdentity &&
        (producerDocumentCids.len != canonicalRows.len ||
         layout.FixedBytes32Equal(
             portableSourceBundleCid, layout.FixedBytes32()))) ||
       (!portableIdentity &&
        (producerDocumentCids.len != 0 ||
         !layout.FixedBytes32Equal(
             portableSourceBundleCid, layout.FixedBytes32()))) ||
       (structuredDiagnosticArtifact.producerKinds.len > 0 &&
        !portableIdentity):
        err = " lsp snapshot producer: failure source authority incomplete"
        return false
    if structuredDiagnosticArtifact.producerKinds.len > 0 &&
       (!diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
            structuredDiagnosticArtifact, err) ||
        structuredDiagnosticArtifact.producerKinds.len != 1):
        if err == "":
            err = " lsp snapshot producer: structured diagnostic shape invalid"
        return false
    var facts: snapshot_cargo.CsgCompilerSnapshotFailureFacts
    facts.schemaVersion =
        snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    facts.semanticEpoch =
        workspace.snapshotStore.core.currentSourceVersion
    facts.sourceVersion = workspace.snapshotStore.core.currentSourceVersion
    facts.worldHeadCid = workspace.compilerUniverse.worldHead.headCid
    facts.compilerExecutionCid =
        workspace.compilerExecution.executionRaw32
    facts.sourceIdentityKind =
        portableIdentity ?
            snapshot_cargo.CsgCompilerSnapshotFailureSourceIdentityPortableReceipt :
            snapshot_cargo.CsgCompilerSnapshotFailureSourceIdentityCanonicalFacts
    facts.missingFactBitmap = 1
    var diagnosticCode: str
    if diagnosticProducerKind ==
           snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission:
        diagnosticCode = "CHENG-SNAPSHOT-SOURCE-ADMISSION"
        facts.completedStageBitmap =
            snapshot_cargo.CsgCompilerSnapshotFailureStageSourceEvent
    elif diagnosticProducerKind ==
             snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSystemLinkPlan:
        diagnosticCode = "CHENG-SNAPSHOT-SYSTEM-LINK-PLAN"
        facts.completedStageBitmap =
            snapshot_cargo.CsgCompilerSnapshotFailureStageSourceEvent
    elif diagnosticProducerKind ==
             snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticCompilerCsg:
        diagnosticCode = "CHENG-SNAPSHOT-COMPILER-CSG"
        facts.completedStageBitmap =
            snapshot_cargo.CsgCompilerSnapshotFailureStageSourceEvent |
            snapshot_cargo.CsgCompilerSnapshotFailureStageSystemLinkPlan
    else:
        err = " lsp snapshot producer: invalid canonical failure producer"
        return false
    for sourceId in 0..<canonicalRows.len:
        let document = workspace.documents[canonicalRows[sourceId]]
        var producerSourceIndex = sourceId
        if portableIdentity:
            producerSourceIndex = -1
            for producerIndex in 0..<producerDocumentCids.len:
                if layout.FixedBytes32Equal(
                       producerDocumentCids[producerIndex],
                       document.documentCid):
                    if producerSourceIndex >= 0:
                        err = " lsp snapshot producer: duplicate producer document identity"
                        return false
                    producerSourceIndex = producerIndex
            if producerSourceIndex < 0:
                err = " lsp snapshot producer: producer document identity missing"
                return false
        let contentPresent =
            !layout.FixedBytes32Equal(
                document.sourceContentCid, layout.FixedBytes32()) &&
            layout.FixedBytes32Equal(
                snapshot_schema.CsgCompilerSourceContentCid(
                    document.sourceText),
                document.sourceContentCid)
        add(facts.sourceDocumentCids, document.documentCid)
        add(facts.sourceContentPresent, contentPresent)
        add(facts.sourceContentCids,
            contentPresent ? document.sourceContentCid :
                layout.FixedBytes32())
        add(facts.sourceModulePaths, document.modulePath)
        add(facts.sourceProducerIndexes, producerSourceIndex)
        add(facts.diagnosticSourceIds, sourceId)
        var diagnosticStartByte: int32
        var diagnosticEndByte: int32
        var diagnosticStartLine: int32
        var diagnosticStartColumn: int32
        var diagnosticEndLine: int32
        var diagnosticEndColumn: int32
        var sourceDiagnosticCode = diagnosticCode
        var sourceDiagnosticMessage = reason
        if structuredDiagnosticArtifact.producerKinds.len > 0 &&
           structuredDiagnosticArtifact.producerSourceIndexes[0] ==
               producerSourceIndex:
            diagnosticStartByte =
                structuredDiagnosticArtifact.spanStartBytes[0]
            diagnosticEndByte =
                structuredDiagnosticArtifact.spanEndBytes[0]
            sourceDiagnosticCode =
                structuredDiagnosticArtifact.codes[0]
            sourceDiagnosticMessage =
                structuredDiagnosticArtifact.messages[0]
            if !lspByteOffsetToSnapshotPositionInto(
                   document.sourceText,
                   diagnosticStartByte,
                   diagnosticStartLine,
                   diagnosticStartColumn,
                   err) ||
               !lspByteOffsetToSnapshotPositionInto(
                   document.sourceText,
                   diagnosticEndByte,
                   diagnosticEndLine,
                   diagnosticEndColumn,
                   err):
                return false
        add(facts.diagnosticStartBytes, diagnosticStartByte)
        add(facts.diagnosticEndBytes, diagnosticEndByte)
        add(facts.diagnosticStartLines, diagnosticStartLine)
        add(facts.diagnosticStartColumns, diagnosticStartColumn)
        add(facts.diagnosticEndLines, diagnosticEndLine)
        add(facts.diagnosticEndColumns, diagnosticEndColumn)
        add(facts.diagnosticProducerKinds,
            diagnosticProducerKind)
        add(facts.diagnosticSeverities,
            snapshot_schema.CsgCompilerDiagnosticSeverityError)
        add(facts.diagnosticCodes, sourceDiagnosticCode)
        add(facts.diagnosticMessages, sourceDiagnosticMessage)
    var dependencies: LspFailureDependencyRow[]
    for row in 0..<dependencyRows.len:
        add(dependencies, dependencyRows[row])
    lspFailureDependenciesSort(dependencies)
    for row in 0..<dependencies.len:
        if dependencies[row].sourceId < 0 ||
           dependencies[row].sourceId >= canonicalRows.len ||
           dependencies[row].targetSourceId < 0 ||
           dependencies[row].targetSourceId >= canonicalRows.len ||
           dependencies[row].sourceId ==
               dependencies[row].targetSourceId ||
           dependencies[row].kind <= 0 ||
           dependencies[row].producerRow < 0 ||
           (row > 0 &&
            dependencies[row - 1].sourceId ==
                dependencies[row].sourceId &&
            dependencies[row - 1].targetSourceId ==
                dependencies[row].targetSourceId &&
            dependencies[row - 1].kind == dependencies[row].kind &&
            dependencies[row - 1].producerRow ==
                dependencies[row].producerRow):
            err = " lsp snapshot producer: canonical failure dependency invalid"
            return false
        add(facts.dependencySourceIds, dependencies[row].sourceId)
        add(facts.dependencyTargetSourceIds,
            dependencies[row].targetSourceId)
        add(facts.dependencyKinds, dependencies[row].kind)
        add(facts.dependencyProducerRows,
            dependencies[row].producerRow)
    if portableIdentity:
        facts.sourceBundleCid = portableSourceBundleCid
        facts.sourceIdentityReceiptCid =
            portableSourceIdentityReceiptCid
    else:
        facts.sourceBundleCid =
            snapshot_cargo.CsgCompilerSnapshotFailureCanonicalSourceBundleCid(
                facts)
        facts.sourceIdentityReceiptCid =
            snapshot_cargo.CsgCompilerSnapshotFailureCanonicalSourceIdentityReceiptCid(
                facts)
    if structuredDiagnosticArtifact.producerKinds.len > 0 &&
       !diagnostic_failure.DiagnosticFailureArtifactCloneInto(
           structuredDiagnosticArtifact,
           facts.structuredDiagnosticArtifact,
           err):
        var releaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            facts, releaseReceipt)
        return false
    if structuredDiagnosticAuthority.authorityKinds.len > 0:
        if !diagnostic_authority.ParserDiagnosticAuthorityCloneInto(
                structuredDiagnosticAuthority,
                structuredDiagnosticProducerProjectionCids,
                facts.structuredDiagnosticAuthority,
                err):
            var releaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
            snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
                facts, releaseReceipt)
            return false
        for row in 0..<structuredDiagnosticProducerProjectionCids.len:
            add(facts.structuredDiagnosticProducerProjectionCids,
                structuredDiagnosticProducerProjectionCids[row])
    if !snapshot_cargo.CsgCompilerSnapshotFailureFactsStrictValidateInto(
            facts, err):
        var releaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            facts, releaseReceipt)
        return false
    var rejectedIndex: int32
    var recorded = false
    if portableIdentity:
        recorded =
            snapshot_production.SemanticSnapshotProductionRejectPortableFailureInto(
                workspace.eventState, workspace.snapshotStore,
                workspace.compilerUniverse.worldHead.headCid,
                workspace.compilerExecution,
                facts, rejectedIndex, err)
    else:
        recorded =
            snapshot_production.SemanticSnapshotProductionRejectCanonicalFailureInto(
                workspace.eventState, workspace.snapshotStore,
                workspace.compilerUniverse.worldHead.headCid,
                workspace.compilerExecution,
                facts, rejectedIndex, err)
    var releaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
    snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
        facts, releaseReceipt)
    return recorded

fn lspWorkspaceRecordEarlyFailureInto(
        workspace: var LspWorkspace,
        diagnosticProducerKind: int32,
        reason: str,
        err: var str): bool =
    var noDependencies: LspFailureDependencyRow[]
    var noProducerDocumentCids: layout.FixedBytes32[]
    var noArtifact: diagnostic_failure.DiagnosticFailureArtifact
    var noAuthority: diagnostic_authority.ParserDiagnosticAuthority
    var noProducerProjectionCids: layout.FixedBytes32[]
    return lspWorkspaceRecordCanonicalFailureInto(
        workspace, noDependencies, diagnosticProducerKind,
        noProducerDocumentCids,
        layout.FixedBytes32(), layout.FixedBytes32(),
        noArtifact, noAuthority, noProducerProjectionCids,
        reason, err)

fn lspFailureDependencyLess(left: LspFailureDependencyRow,
                            right: LspFailureDependencyRow): bool =
    if left.sourceId != right.sourceId:
        return left.sourceId < right.sourceId
    if left.targetSourceId != right.targetSourceId:
        return left.targetSourceId < right.targetSourceId
    if left.kind != right.kind:
        return left.kind < right.kind
    return left.producerRow < right.producerRow

fn lspFailureDependenciesSort(rows: var LspFailureDependencyRow[]) =
    for index in 1..<rows.len:
        let selected = rows[index]
        var cursor = index
        while cursor > 0 &&
              lspFailureDependencyLess(selected, rows[cursor - 1]):
            rows[cursor] = rows[cursor - 1]
            cursor = cursor - 1
        rows[cursor] = selected

fn lspCandidateSourceIdForDocumentCid(
        workspace: LspWorkspace,
        documentCid: layout.FixedBytes32): int32 =
    var low: int32
    var high = workspace.candidateSourceDocuments.len
    while low < high:
        let middle = low + (high - low) / 2
        if lspCidLess(
                workspace.candidateSourceDocuments[middle].documentCid,
                documentCid):
            low = middle + 1
        else:
            high = middle
    if low < workspace.candidateSourceDocuments.len &&
       layout.FixedBytes32Equal(
           workspace.candidateSourceDocuments[low].documentCid,
           documentCid):
        return low
    return -1

fn lspWorkspacePlanFailureDependenciesInto(
        workspace: LspWorkspace,
        plan: var system_link_plan.SystemLinkPlanStub,
        out: var LspFailureDependencyRow[],
        err: var str): bool =
    out = []
    if plan.packageId != workspace.packageId ||
       plan.sourceClosurePaths.len !=
           workspace.candidateSourceDocuments.len:
        err = " lsp snapshot producer: failure plan source domain split"
        return false
    for edgeIndex in 0..<plan.importEdges.len:
        let edge = plan.importEdges[edgeIndex]
        if !edge.resolved:
            err = " lsp snapshot producer: unresolved failure plan dependency"
            return false
        var ownerDocumentCid: layout.FixedBytes32
        var targetDocumentCid: layout.FixedBytes32
        if !compiler_world.CompilerWorldDocumentCidInto(
                plan.packageId, edge.ownerModulePath,
                ownerDocumentCid, err) ||
           !compiler_world.CompilerWorldDocumentCidInto(
                plan.packageId, edge.targetModulePath,
                targetDocumentCid, err):
            return false
        let ownerSourceId = lspCandidateSourceIdForDocumentCid(
            workspace, ownerDocumentCid)
        let targetSourceId = lspCandidateSourceIdForDocumentCid(
            workspace, targetDocumentCid)
        if ownerSourceId < 0 || targetSourceId < 0 ||
           ownerSourceId == targetSourceId:
            err = " lsp snapshot producer: failure plan dependency identity split"
            return false
        var dependency: LspFailureDependencyRow
        dependency.sourceId = ownerSourceId
        dependency.targetSourceId = targetSourceId
        dependency.kind = snapshot_schema.CsgCompilerReferenceImport
        dependency.producerRow = edgeIndex
        add(out, dependency)
    err = ""
    return true

fn lspWorkspacePlanProducerDocumentCidsInto(
        workspace: LspWorkspace,
        plan: var system_link_plan.SystemLinkPlanStub,
        out: var layout.FixedBytes32[],
        err: var str): bool =
    out = []
    if plan.packageId != workspace.packageId ||
       plan.ownerModulePaths.len <= 0 ||
       plan.ownerModulePaths.len != plan.sourceClosurePaths.len ||
       plan.ownerModulePaths.len !=
           workspace.candidateSourceDocuments.len:
        err = " lsp snapshot producer: plan producer source domain split"
        return false
    for producerIndex in 0..<plan.ownerModulePaths.len:
        var documentCid: layout.FixedBytes32
        if !compiler_world.CompilerWorldDocumentCidInto(
               plan.packageId,
               plan.ownerModulePaths[producerIndex],
               documentCid,
               err) ||
           lspCandidateSourceIdForDocumentCid(
               workspace, documentCid) < 0:
            if err == "":
                err = " lsp snapshot producer: plan producer document missing"
            return false
        for priorIndex in 0..<out.len:
            if layout.FixedBytes32Equal(
                   out[priorIndex], documentCid):
                err = " lsp snapshot producer: duplicate plan producer document"
                return false
        add(out, documentCid)
    err = ""
    return true

fn lspWorkspaceFailureFactsBuildInto(
        workspace: var LspWorkspace,
        csg: var compiler_csg.CompilerCsg,
        admission:
            var snapshot_builder.CompilerSnapshotProductionAdmissionReceipt,
        canonicalSourceByProducer: int32[],
        out: var snapshot_cargo.CsgCompilerSnapshotFailureFacts,
        err: var str): bool =
    out = snapshot_cargo.CsgCompilerSnapshotFailureFacts()
    if canonicalSourceByProducer.len != csg.sourceSnapshotCount ||
       csg.parserNormalizedExprReceipt.sourceSidecars.len !=
           csg.sourceSnapshotCount ||
       workspace.candidateSourceDocuments.len != csg.sourceSnapshotCount:
        err = " lsp snapshot producer: failure source domain split"
        return false
    var producerByCanonical: int32[]
    setLen(producerByCanonical, csg.sourceSnapshotCount)
    for sourceId in 0..<producerByCanonical.len:
        producerByCanonical[sourceId] = -1
    for producerIndex in 0..<canonicalSourceByProducer.len:
        let sourceId = canonicalSourceByProducer[producerIndex]
        if sourceId < 0 || sourceId >= producerByCanonical.len ||
           producerByCanonical[sourceId] >= 0:
            err = " lsp snapshot producer: failure source identity is not bijective"
            return false
        producerByCanonical[sourceId] = producerIndex
    var facts: snapshot_cargo.CsgCompilerSnapshotFailureFacts
    let admissionFailureMessage =
        Fmt"semantic snapshot admission blocked source_version={workspace.snapshotStore.core.currentSourceVersion} missing_fact_bitmap={admission.missingFactBitmap} source_interfaces={admission.missingSourceInterfaceCount} type_arena_bindings={admission.missingTypeArenaSourceBindingCount} type_arena_resolution_authorities={admission.missingTypeArenaResolutionAuthorityCount} symbol_interfaces={admission.missingSymbolInterfaceCount} symbol_declarations={admission.missingSymbolDeclarationInterfaceCount} symbol_generics={admission.missingSymbolGenericInterfaceCount} symbol_annotation_targets={admission.missingSymbolAnnotationTargetBindingCount} function_interfaces={admission.missingFunctionInterfaceCount} function_owner_identities={admission.missingFunctionOwnerIdentityCount} function_param_types={admission.missingFunctionParameterTypeCount} function_param_ownerships={admission.missingFunctionParameterOwnershipCount} function_return_types={admission.missingFunctionReturnTypeCount} function_generics={admission.missingFunctionGenericIdentityCount} function_source_bindings={admission.missingFunctionSourceBindingCount} typed_node_proofs={admission.missingTypedNodeProofCount} parser_typed_expr_identities={admission.missingParserTypedExpressionIdentityCount} typed_node_declarations={admission.missingTypedNodeDeclarationIdentityCount} typed_node_type_ids={admission.missingTypedNodeTypeIdCount} typed_node_value_defs={admission.missingTypedNodeValueDefinitionCount} typed_node_ownerships={admission.missingTypedNodeOwnershipProofCount} typed_node_captures={admission.missingTypedNodeCaptureProofCount} typed_node_source_bindings={admission.missingTypedNodeSourceBindingCount} reference_proofs={admission.missingReferenceProofCount} reference_parser_nodes={admission.missingReferenceParserNodeIdentityCount} reference_owner_functions={admission.missingReferenceOwnerFunctionIdentityCount} reference_spans={admission.missingReferenceSpanCount} reference_target_declarations={admission.missingReferenceTargetDeclarationIdentityCount} reference_target_symbol_cids={admission.missingReferenceTargetSymbolCidCount} reference_result_type_ids={admission.missingReferenceResultTypeIdCount} reference_result_ownerships={admission.missingReferenceResultOwnershipProofCount} lexical_scope_proofs={admission.missingLexicalScopeProofCount} parser_lexical_scopes={admission.parserLexicalScopeCount} typed_lexical_scopes={admission.typedLexicalScopeCount} statement_scope_uses={admission.statementLexicalScopeUseCount} lexical_scope_required={admission.lexicalScopeRequiredCount} lexical_scope_parser_identities={admission.missingParserLexicalScopeIdentityCount} lexical_scope_typed_identities={admission.missingTypedLexicalScopeIdentityCount} lexical_scope_statement_uses={admission.missingStatementLexicalScopeUseCount} lexical_scope_bridges={admission.missingLexicalScopeBridgeCount} lexical_scope_owner_declarations={admission.missingLexicalScopeOwnerDeclarationIdentityCount} lexical_scope_owner_functions={admission.missingLexicalScopeOwnerFunctionIdentityCount} lexical_scope_spans={admission.missingLexicalScopeSpanCount} lexical_scope_visible_symbols={admission.missingLexicalScopeVisibleSymbolProofCount} dependency_proofs={admission.missingDependencyProofCount} diagnostic_producer_kinds={admission.diagnosticProducerKindCount} diagnostic_completions_required={admission.diagnosticCompletionRequiredCount} diagnostic_rows={admission.diagnosticProducedRowCount} diagnostic_completions_missing={admission.missingDiagnosticCompletionCount} diagnostic_source_identities={admission.missingDiagnosticSourceIdentityCount} diagnostic_producer_kind_identities={admission.missingDiagnosticProducerKindCount} diagnostic_spans={admission.missingDiagnosticSpanIdentityCount} diagnostic_parser_nodes={admission.missingDiagnosticParserNodeIdentityCount} diagnostic_owner_declarations={admission.missingDiagnosticOwnerDeclarationIdentityCount} diagnostic_proofs={admission.missingDiagnosticProofCount}"
    facts.schemaVersion =
        snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest
    facts.semanticEpoch =
        workspace.snapshotStore.core.currentSourceVersion
    facts.sourceVersion = workspace.snapshotStore.core.currentSourceVersion
    facts.worldHeadCid = workspace.compilerUniverse.worldHead.headCid
    facts.compilerExecutionCid =
        workspace.compilerExecution.executionRaw32
    facts.sourceIdentityReceiptCid =
        csg.sourceIdentityReceipt.receiptCid
    facts.sourceIdentityKind =
        snapshot_cargo.CsgCompilerSnapshotFailureSourceIdentityPortableReceipt
    facts.sourceBundleCid = csg.sourceBundleCid
    facts.parserReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    facts.compilerCsgTransitionReceiptCid =
        csg.csgTransitionReceipt.receiptCid
    facts.importGraphCid = csg.sourceIdentityReceipt.importGraphCid
    facts.canonicalGraphCid = csg.canonicalGraphCid
    facts.graphCid = csg.graphCid
    facts.retainedFactsCid = admission.retainedFactsCid
    facts.admissionReceiptCid = admission.receiptCid
    facts.completedStageBitmap = admission.completedStageBitmap
    facts.missingFactBitmap = admission.missingFactBitmap
    for sourceId in 0..<producerByCanonical.len:
        let producerIndex = producerByCanonical[sourceId]
        if producerIndex < 0:
            err = " lsp snapshot producer: failure canonical source missing"
            return false
        if canonicalSourceByProducer[producerIndex] != sourceId:
            err = " lsp snapshot producer: failure document binding missing"
            return false
        let documentCid =
            workspace.candidateSourceDocuments[sourceId].documentCid
        let documentIndex =
            lspWorkspaceFindDocumentByCid(workspace, documentCid)
        if documentIndex < 0 ||
           workspace.documents[documentIndex].modulePath !=
               csg.semanticGraph.sourceTable.modulePaths[producerIndex] ||
           workspace.documents[documentIndex].sourcePath !=
               csg.semanticGraph.sourceTable.sourcePaths[producerIndex]:
            err = " lsp snapshot producer: failure document binding split"
            return false
        let document = workspace.documents[documentIndex]
        add(facts.sourceDocumentCids, document.documentCid)
        add(facts.sourceContentPresent, true)
        add(facts.sourceContentCids, document.sourceContentCid)
        add(facts.sourceModulePaths, document.modulePath)
        add(facts.sourceProducerIndexes, producerIndex)
        add(facts.diagnosticSourceIds, sourceId)
        # Semantic admission is a source-level failure, not a parser-node
        # failure.  Its exact canonical anchor is the start of each immutable
        # source; parser root rows are optional and cannot define this domain.
        add(facts.diagnosticStartBytes, 0)
        add(facts.diagnosticEndBytes, 0)
        add(facts.diagnosticStartLines, 0)
        add(facts.diagnosticStartColumns, 0)
        add(facts.diagnosticEndLines, 0)
        add(facts.diagnosticEndColumns, 0)
        add(facts.diagnosticProducerKinds,
            snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSemanticAdmission)
        add(facts.diagnosticSeverities,
            snapshot_schema.CsgCompilerDiagnosticSeverityError)
        add(facts.diagnosticCodes, "CHENG-SNAPSHOT-SEMANTIC-ADMISSION")
        add(facts.diagnosticMessages, admissionFailureMessage)
    var dependencies: LspFailureDependencyRow[]
    for row in 0..<csg.semanticGraph.importEdgeTable.ownerSourceIndex.len:
        let ownerProducer =
            csg.semanticGraph.importEdgeTable.ownerSourceIndex[row]
        let targetProducer =
            csg.semanticGraph.importEdgeTable.targetSourceIndex[row]
        if !csg.semanticGraph.importEdgeTable.resolved[row] ||
           ownerProducer < 0 ||
           ownerProducer >= canonicalSourceByProducer.len ||
           targetProducer < 0 ||
           targetProducer >= canonicalSourceByProducer.len:
            err = " lsp snapshot producer: failure dependency is unresolved"
            return false
        var dependency: LspFailureDependencyRow
        dependency.sourceId = canonicalSourceByProducer[ownerProducer]
        dependency.targetSourceId =
            canonicalSourceByProducer[targetProducer]
        dependency.kind = snapshot_schema.CsgCompilerReferenceImport
        dependency.producerRow = row
        add(dependencies, dependency)
    lspFailureDependenciesSort(dependencies)
    for row in 0..<dependencies.len:
        if row > 0 &&
           dependencies[row - 1].sourceId == dependencies[row].sourceId &&
           dependencies[row - 1].targetSourceId ==
               dependencies[row].targetSourceId &&
           dependencies[row - 1].kind == dependencies[row].kind &&
           dependencies[row - 1].producerRow ==
               dependencies[row].producerRow:
            err = " lsp snapshot producer: duplicate failure dependency"
            return false
        add(facts.dependencySourceIds, dependencies[row].sourceId)
        add(facts.dependencyTargetSourceIds,
            dependencies[row].targetSourceId)
        add(facts.dependencyKinds, dependencies[row].kind)
        add(facts.dependencyProducerRows,
            dependencies[row].producerRow)
    if !snapshot_cargo.CsgCompilerSnapshotFailureFactsStrictValidateInto(
            facts, err):
        return false
    out = facts
    err = ""
    return true

fn lspWorkspaceMakeStageValidateCommitCandidateInto(
        workspace: var LspWorkspace,
        predecessor:
            snapshot_production.SemanticSnapshotCompilerPredecessorReceipt,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        csg: var compiler_csg.CompilerCsg,
        startedNs: int64,
        err: var str): bool =
    let sourceVersion = workspace.snapshotStore.core.currentSourceVersion
    if sourceVersion <= 0 ||
       sourceVersion != workspace.eventState.lastAcceptedSourceVersion ||
       workspace.snapshotStore.core.candidateIndex != -1:
        panic("lsp_snapshot_candidate_source_version_drift")
    var candidate: snapshot_production.SemanticSnapshotProductionCandidate
    if !snapshot_production.SemanticSnapshotProductionCandidateMakeInto(
            predecessor, csg, workspace.compilerUniverse,
            workspace.compilerExecution, workspace.eventState,
            tables, workspace.candidateSourceDocuments,
            candidate, err):
        panic(Fmt"lsp_snapshot_candidate_make_invalid {err}")
    if candidate.binding.sourceVersion != sourceVersion:
        snapshot_production.SemanticSnapshotProductionCandidateRelease(
            candidate)
        panic("lsp_snapshot_built_candidate_source_version_drift")
    if !snapshot_production.SemanticSnapshotProductionCandidateStrictValidateInto(
            candidate, csg, workspace.compilerUniverse,
            workspace.compilerExecution, err):
        snapshot_production.SemanticSnapshotProductionCandidateRelease(
            candidate)
        panic(Fmt"lsp_snapshot_candidate_strict_validation_invalid {err}")
    if workspace.candidateCaptureOnly:
        var completion: LspCandidateJobCompletion
        completion.jobCid =
            layout.FixedBytes32Copy(
                workspace.candidateCaptureJobCid)
        completion.sourceVersion = sourceVersion
        completion.kind = lspCandidateCompletionPublished
        completion.predecessor = predecessor
        completion.completionAuthorityCid =
            layout.FixedBytes32Copy(
                candidate.binding.bindingReceiptCid)
        completion.candidate = candidate
        completion.startedNs = startedNs
        workspace.candidateCapturedCompletion = completion
        err = ""
        return true
    var stagedIndex: int32
    if !snapshot_production.SemanticSnapshotProductionStageCandidateInto(
            workspace.snapshotStore, candidate, csg,
            workspace.compilerUniverse, workspace.compilerExecution,
            stagedIndex, err):
        snapshot_production.SemanticSnapshotProductionCandidateRelease(
            candidate)
        panic(Fmt"lsp_snapshot_candidate_stage_invalid {err}")
    if stagedIndex < 0 ||
       stagedIndex != workspace.snapshotStore.core.candidateIndex ||
       workspace.snapshotStore.core.sourceVersions[stagedIndex] !=
           sourceVersion ||
       !snapshot_production.SemanticSnapshotProductionStoreStrictValidateInto(
            workspace.snapshotStore, err):
        panic("lsp_snapshot_staged_candidate_validation_invalid")
    var publishedIndex: int32
    var reclaimSnapshotIndex: int32
    snapshot_production.SemanticSnapshotProductionCommitCandidateInto(
        workspace.snapshotStore, stagedIndex,
        publishedIndex, reclaimSnapshotIndex)
    if publishedIndex != stagedIndex ||
       workspace.snapshotStore.core.publishedIndex != publishedIndex ||
       workspace.snapshotStore.core.sourceVersions[publishedIndex] !=
           sourceVersion ||
       !snapshot_production.SemanticSnapshotProductionStoreStrictValidateInto(
            workspace.snapshotStore, err):
        panic("lsp_snapshot_committed_candidate_validation_invalid")
    if reclaimSnapshotIndex >= 0:
        if !snapshot_production.SemanticSnapshotProductionStoreReclaimSnapshotInto(
                workspace.snapshotStore, reclaimSnapshotIndex, err) ||
           !snapshot_production.SemanticSnapshotProductionStoreStrictValidateInto(
                workspace.snapshotStore, err):
            panic("lsp_snapshot_previous_payload_reclaim_invalid")
    snapshot_production.SemanticSnapshotProductionCandidateRelease(candidate)
    workspace.candidateBlockedReason = ""
    workspace.metrics.candidatePublishedCount =
        workspace.metrics.candidatePublishedCount + int64(1)
    workspace.metrics.candidateAdmissionPublishWallNs =
        workspace.metrics.candidateAdmissionPublishWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - startedNs
    err = ""
    return true

fn LspWorkspaceEntryDocumentCoordinateStrictValidateInto(
        workspace: var LspWorkspace,
        sourceVersion: int64,
        entryDocumentIndex: int32,
        err: var str): bool =
    if sourceVersion <= 0 ||
       sourceVersion !=
           workspace.snapshotStore.core.currentSourceVersion ||
       sourceVersion != workspace.eventState.lastAcceptedSourceVersion ||
       workspace.documents.len !=
           workspace.eventState.documentCids.len ||
       entryDocumentIndex < 0 ||
       entryDocumentIndex >= workspace.documents.len:
        err = " lsp snapshot producer: entry coordinate version drift"
        return false
    let entryDocument = workspace.documents[entryDocumentIndex]
    if !entryDocument.compilerIdentityBound ||
       !entryDocument.present ||
       entryDocument.stableEventRow != entryDocumentIndex ||
       !entryDocument.entrySource ||
       entryDocument.sourcePath == "" ||
       !layout.FixedBytes32Equal(
           entryDocument.documentCid,
           workspace.entryDocumentCid):
        err = " lsp snapshot producer: entry coordinate identity drift"
        return false
    var entryDocumentCount: int32
    for documentIndex in 0..<workspace.documents.len:
        if workspace.documents[documentIndex].present &&
           workspace.documents[documentIndex].entrySource:
            entryDocumentCount = entryDocumentCount + 1
            if documentIndex != entryDocumentIndex ||
               !layout.FixedBytes32Equal(
                   workspace.documents[documentIndex].documentCid,
                   workspace.entryDocumentCid):
                err = " lsp snapshot producer: entry coordinate split"
                return false
    var entryEventCount: int32
    for eventDocumentIndex in 0..<
            workspace.eventState.documentCids.len:
        if layout.FixedBytes32Equal(
                workspace.eventState.documentCids[eventDocumentIndex],
                workspace.entryDocumentCid):
            entryEventCount = entryEventCount + 1
            if workspace.eventState.documentLastEventSourceVersions[
                    eventDocumentIndex] < 0 ||
               workspace.eventState.documentLastEventSourceVersions[
                    eventDocumentIndex] > sourceVersion:
                err = " lsp snapshot producer: entry coordinate event drift"
                return false
            if workspace.eventState.documentPresenceStates[
                    eventDocumentIndex] !=
                   snapshot_core.SemanticSourcePresencePresent:
                err = " lsp snapshot producer: entry coordinate is absent"
                return false
    if entryDocumentCount != 1 || entryEventCount != 1:
        err = " lsp snapshot producer: entry coordinate coverage drift"
        return false
    err = ""
    return true

fn lspWorkspaceTryProduceCurrentCompilerSnapshotInto(
        workspace: var LspWorkspace,
        err: var str): bool =
    err = ""
    if !lspWorkspaceCompilerBindingConfigured(workspace):
        return true
    let candidateSourceVersion =
        workspace.snapshotStore.core.currentSourceVersion
    var universeErr: str
    if !compiler_world.CompilerLocalUniverseStrictValidateInto(
            workspace.compilerUniverse, universeErr):
        panic(Fmt"lsp_compiler_universe_invalid {universeErr}")
    let executionVerified =
        execution.CompilerExecutionIdentityVerify(workspace.compilerExecution)
    if IsErr(executionVerified):
        panic(Fmt"lsp_compiler_execution_invalid {Error(executionVerified)}")
    if !layout.FixedBytes32Equal(
            workspace.compilerUniverse.compilerSnapshot.sourceBundleCid,
            workspace.compilerExecution.sourceBundleRaw32):
        panic("lsp_compiler_universe_execution_source_bundle_split")
    let startedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    workspace.metrics.candidateAttemptCount =
        workspace.metrics.candidateAttemptCount + int64(1)
    workspace.candidateSourceDocuments = []
    workspace.candidateAdmissionReceiptCid = layout.FixedBytes32()
    workspace.candidateAdmissionCompletedStageBitmap = 0
    workspace.candidateAdmissionMissingFactBitmap = 0
    if workspace.workspaceRoot == "" || workspace.packageRoot == "" ||
       workspace.packageId == "" || workspace.targetTriple == "" ||
       layout.FixedBytes32Equal(
           workspace.entryDocumentCid, layout.FixedBytes32()) ||
       workspace.eventState.documentCids.len != workspace.documents.len:
        return lspWorkspaceAutomaticCandidateReject(
            workspace, startedNs,
            snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
            " lsp snapshot producer: immutable workspace binding incomplete",
            err)
    var sourcePaths: str[]
    var modulePaths: str[]
    var sourceTexts: str[]
    var overrides: compiler_csg.CompilerCsgSourceText[]
    var entryDocumentIndex: int32 = -1
    var sourceDocuments: query_projection.SemanticSnapshotSourceDocument[]
    for documentIndex in 0..<workspace.documents.len:
        let document = workspace.documents[documentIndex]
        if document.stableEventRow != documentIndex ||
           !layout.FixedBytes32Equal(
               workspace.eventState.documentCids[documentIndex],
               document.documentCid) ||
           workspace.eventState.documentPresenceStates[documentIndex] !=
               (document.present ?
                    snapshot_core.SemanticSourcePresencePresent :
                    snapshot_core.SemanticSourcePresenceAbsent):
            return lspWorkspaceAutomaticCandidateReject(
                workspace, startedNs,
                snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
                " lsp snapshot producer: stable source membership split",
                err)
        if !document.present:
            continue
        if !document.compilerIdentityBound || document.sourcePath == "" ||
           document.modulePath == "" ||
           layout.FixedBytes32Equal(
               document.sourceContentCid, layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               snapshot_schema.CsgCompilerSourceContentCid(
                   document.sourceText),
               document.sourceContentCid):
            return lspWorkspaceAutomaticCandidateReject(
                workspace, startedNs,
                snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
                " lsp snapshot producer: immutable source bytes incomplete",
                err)
        add(sourcePaths, document.sourcePath)
        add(modulePaths, document.modulePath)
        add(sourceTexts, document.sourceText)
        var immutableDocument: query_projection.SemanticSnapshotSourceDocument
        immutableDocument.uri = document.uri
        immutableDocument.documentCid = document.documentCid
        immutableDocument.contentCid = document.sourceContentCid
        immutableDocument.text = document.sourceText
        immutableDocument.clientVersion = document.clientVersion
        immutableDocument.open = document.open
        add(sourceDocuments, immutableDocument)
        var override: compiler_csg.CompilerCsgSourceText
        override.sourcePath = document.sourcePath
        override.modulePath = document.modulePath
        override.text = document.sourceText
        add(overrides, override)
        if document.entrySource:
            if entryDocumentIndex >= 0 ||
               !layout.FixedBytes32Equal(
                   document.documentCid, workspace.entryDocumentCid):
                return lspWorkspaceAutomaticCandidateReject(
                    workspace, startedNs,
                    snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
                    " lsp snapshot producer: immutable entry binding split",
                    err)
            entryDocumentIndex = documentIndex
    if sourceDocuments.len <= 0 || entryDocumentIndex < 0:
        return lspWorkspaceAutomaticCandidateReject(
            workspace, startedNs,
            snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
            " lsp snapshot producer: active source universe is empty",
            err)
    if !LspWorkspaceEntryDocumentCoordinateStrictValidateInto(
            workspace,
            candidateSourceVersion,
            entryDocumentIndex,
            err):
        return lspWorkspaceAutomaticCandidateReject(
            workspace, startedNs,
            snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
            err,
            err)
    lspImmutableSourceDocumentsSort(sourceDocuments)
    for sourceIndex in 1..<sourceDocuments.len:
        if layout.FixedBytes32Equal(
                sourceDocuments[sourceIndex - 1].documentCid,
                sourceDocuments[sourceIndex].documentCid):
            return lspWorkspaceAutomaticCandidateReject(
                workspace, startedNs,
                snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
                " lsp snapshot producer: duplicate immutable document CID",
                err)
    workspace.candidateSourceDocuments = sourceDocuments
    var plan: system_link_plan.SystemLinkPlanStub
    if !system_link_plan.SystemLinkPlanBuildImmutableSourceOverlayInto(
            workspace.workspaceRoot,
            workspace.packageRoot,
            workspace.packageId,
            workspace.targetTriple,
            workspace.documents[entryDocumentIndex].sourcePath,
            sourcePaths,
            modulePaths,
            sourceTexts,
            plan,
            err):
        return lspWorkspaceAutomaticCandidateReject(
            workspace, startedNs,
            snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSystemLinkPlan,
            err, err)
    if !LspWorkspaceEntryDocumentCoordinateStrictValidateInto(
            workspace,
            candidateSourceVersion,
            entryDocumentIndex,
            err):
        return lspWorkspaceAutomaticCandidateReject(
            workspace, startedNs,
            snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission,
            err, err)
    var planFailureDependencies: LspFailureDependencyRow[]
    if !lspWorkspacePlanFailureDependenciesInto(
            workspace, plan, planFailureDependencies, err):
        panic("lsp_snapshot_plan_dependency_projection_invalid")
    var planProducerDocumentCids: layout.FixedBytes32[]
    if !lspWorkspacePlanProducerDocumentCidsInto(
            workspace, plan, planProducerDocumentCids, err):
        panic("lsp_snapshot_plan_producer_projection_invalid")
    var sourceReceipt: compiler_csg.PortableSourceIdentityReceipt
    if !compiler_csg.PortableSourceIdentityReceiptMakeInto(
            plan.sourceClosurePaths.len,
            plan.importEdges.len,
            plan.unresolvedImportCount,
            plan.packageId,
            plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
            plan.sourceBundleCidValue,
            plan.sourceBundleEntrySourceCid,
            plan.sourceBundleImportGraphCid,
            sourceReceipt,
            err):
        panic("lsp_snapshot_portable_source_receipt_invalid")
    let csgStartedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    var csg: compiler_csg.CompilerCsg
    let csgBuilt =
        compiler_csg.BuildCompilerCsgConsumePortableReceiptWithOverridesInto(
            csg, err,
            plan, sourceReceipt, "", "", overrides)
    let csgElapsedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) - csgStartedNs
    workspace.metrics.compilerCsgBuildWallNs =
        workspace.metrics.compilerCsgBuildWallNs + csgElapsedNs
    if !csgBuilt:
        let failureReason =
            Fmt"source_version={workspace.snapshotStore.core.currentSourceVersion} {err}"
        if workspace.candidateCaptureOnly:
            var completion: LspCandidateJobCompletion
            completion.jobCid =
                layout.FixedBytes32Copy(
                    workspace.candidateCaptureJobCid)
            completion.sourceVersion =
                workspace.snapshotStore.core.currentSourceVersion
            completion.kind = lspCandidateCompletionCsgRejected
            completion.diagnosticProducerKind =
                snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticCompilerCsg
            completion.reason =
                strings.ConcatStr("", failureReason)
            completion.failureDependencies =
                planFailureDependencies
            completion.failureProducerDocumentCids =
                planProducerDocumentCids
            completion.portableSourceBundleCid =
                layout.FixedBytes32Copy(plan.sourceBundleCidValue)
            completion.portableSourceIdentityReceiptCid =
                layout.FixedBytes32Copy(sourceReceipt.receiptCid)
            completion.completionAuthorityCid =
                lspCandidateCompletionAuthorityCid(
                    completion.jobCid,
                    completion.sourceVersion,
                    completion.kind,
                    completion.reason,
                    sourceReceipt.receiptCid)
            completion.csg = csg
            csg = compiler_csg.CompilerCsg()
            completion.startedNs = startedNs
            workspace.candidateCapturedCompletion = completion
            err = failureReason
            return false
        var rejectionErr: str
        let rejectionRecorded =
            lspWorkspaceRecordCanonicalFailureInto(
                workspace, planFailureDependencies,
                snapshot_cargo.CsgCompilerSnapshotFailureDiagnosticCompilerCsg,
                planProducerDocumentCids,
                plan.sourceBundleCidValue,
                sourceReceipt.receiptCid,
                csg.diagnosticFailureArtifact,
                csg.diagnosticFailureAuthority,
                csg.diagnosticFailureProducerProjectionCids,
                failureReason, rejectionErr)
        compiler_csg.CompilerCsgTerminalRelease(csg)
        if !rejectionRecorded:
            panic("lsp_snapshot_compiler_csg_failure_rejection_invalid")
        workspace.candidateBlockedReason = failureReason
        err = failureReason
        return lspWorkspaceCandidateReject(workspace, startedNs)
    workspace.metrics.compilerCsgBuildObserved = true
    workspace.metrics.parserBuildObserved = true
    workspace.metrics.parserBuildWallNs =
        workspace.metrics.parserBuildWallNs + csg.csgPhaseA1Ns
    var canonicalSourceByProducer: int32[]
    setLen(canonicalSourceByProducer,
           csg.parserNormalizedExprReceipt.sourceSidecars.len)
    for producerIndex in 0..<canonicalSourceByProducer.len:
        canonicalSourceByProducer[producerIndex] = -1
    for producerIndex in 0..<csg.parserNormalizedExprReceipt.sourceSidecars.len:
        if producerIndex >= sourceDocuments.len:
            compiler_csg.CompilerCsgTerminalRelease(csg)
            panic("lsp_snapshot_parser_source_coverage_split")
        var producerDocumentCid: layout.FixedBytes32
        if !compiler_world.CompilerWorldDocumentCidInto(
                csg.packageId,
                csg.semanticGraph.sourceTable.modulePaths[producerIndex],
                producerDocumentCid, err):
            compiler_csg.CompilerCsgTerminalRelease(csg)
            panic("lsp_snapshot_parser_document_cid_invalid")
        var low: int32
        var high = sourceDocuments.len
        while low < high:
            let middle = low + (high - low) / 2
            if lspCidLess(
                    sourceDocuments[middle].documentCid,
                    producerDocumentCid):
                low = middle + 1
            else:
                high = middle
        if low >= sourceDocuments.len ||
           !layout.FixedBytes32Equal(
               sourceDocuments[low].documentCid, producerDocumentCid):
            compiler_csg.CompilerCsgTerminalRelease(csg)
            panic("lsp_snapshot_parser_document_cid_missing")
        let documentIndex =
            lspWorkspaceFindDocumentByCid(workspace, producerDocumentCid)
        if documentIndex < 0 ||
           workspace.documents[documentIndex].sourcePath !=
               csg.semanticGraph.sourceTable.sourcePaths[producerIndex]:
            compiler_csg.CompilerCsgTerminalRelease(csg)
            panic("lsp_snapshot_parser_document_binding_split")
        if workspace.documents[documentIndex].modulePath !=
               csg.semanticGraph.sourceTable.modulePaths[producerIndex]:
            compiler_csg.CompilerCsgTerminalRelease(csg)
            panic("lsp_snapshot_parser_module_identity_split")
        canonicalSourceByProducer[producerIndex] = low
    workspace.metrics.compilerSnapshotBuilderAttemptCount =
        workspace.metrics.compilerSnapshotBuilderAttemptCount + int64(1)
    var predecessor: snapshot_production.SemanticSnapshotCompilerPredecessorReceipt
    if !snapshot_production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
            csg,
            workspace.compilerUniverse,
            workspace.compilerExecution,
            predecessor,
            err):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        panic(Fmt"lsp_snapshot_predecessor_receipt_invalid {err}")
    var canonicalDocumentCids: layout.FixedBytes32[]
    var canonicalSourceTexts: str[]
    for sourceId in 0..<sourceDocuments.len:
        add(canonicalDocumentCids, sourceDocuments[sourceId].documentCid)
        add(canonicalSourceTexts, sourceDocuments[sourceId].text)
    var tables: snapshot_schema.CsgCompilerSnapshotTables
    var admission: snapshot_builder.CompilerSnapshotProductionAdmissionReceipt
    let candidateBuilt =
        snapshot_builder.CompilerSnapshotProductionCandidateBuildUnsealedInto(
            csg,
            canonicalDocumentCids,
            canonicalSourceByProducer,
            canonicalSourceTexts,
            workspace.eventState,
            workspace.compilerUniverse.worldHead.headCid,
            workspace.compilerExecution.executionRaw32,
            predecessor.receiptCid,
            tables,
            admission,
            err)
    if !candidateBuilt:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        panic(Fmt"lsp_snapshot_production_candidate_build_unsealed_invalid {err}")
    let candidateSealed =
        snapshot_builder.CompilerSnapshotProductionCandidateSealInto(
            csg,
            canonicalDocumentCids,
            canonicalSourceByProducer,
            tables,
            admission,
            err)
    if !candidateSealed:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        panic(Fmt"lsp_snapshot_production_candidate_seal_invalid {err}")
    workspace.candidateAdmissionReceiptCid = admission.receiptCid
    workspace.candidateAdmissionCompletedStageBitmap =
        admission.completedStageBitmap
    workspace.candidateAdmissionMissingFactBitmap =
        admission.missingFactBitmap
    if !admission.admissionBlocked &&
       admission.missingFactBitmap == 0:
        let published =
            lspWorkspaceMakeStageValidateCommitCandidateInto(
                workspace,
                predecessor,
                tables,
                csg,
                startedNs,
                err)
        if workspace.candidateCaptureOnly:
            workspace.candidateCapturedCompletion.csg = csg
            csg = compiler_csg.CompilerCsg()
            return published
        compiler_csg.CompilerCsgTerminalRelease(csg)
        return published
    if !admission.admissionBlocked ||
       admission.missingFactBitmap == 0:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        panic("lsp_snapshot_candidate_admission_state_split")
    var failureFacts: snapshot_cargo.CsgCompilerSnapshotFailureFacts
    if !lspWorkspaceFailureFactsBuildInto(
            workspace, csg, admission, canonicalSourceByProducer,
            failureFacts, err):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        panic(Fmt"lsp_snapshot_failure_fact_construction_invalid {err}")
    if workspace.candidateCaptureOnly:
        var completion: LspCandidateJobCompletion
        completion.jobCid =
            layout.FixedBytes32Copy(
                workspace.candidateCaptureJobCid)
        completion.sourceVersion =
            workspace.snapshotStore.core.currentSourceVersion
        completion.kind =
            lspCandidateCompletionAdmissionRejected
        completion.reason =
            strings.ConcatStr(
                "", failureFacts.diagnosticMessages[0])
        completion.completionAuthorityCid =
            layout.FixedBytes32Copy(
                failureFacts.admissionReceiptCid)
        completion.predecessor = predecessor
        completion.csg = csg
        csg = compiler_csg.CompilerCsg()
        completion.tables = tables
        completion.admission = admission
        completion.failureFacts = failureFacts
        completion.startedNs = startedNs
        workspace.candidateCapturedCompletion = completion
        err = workspace.candidateCapturedCompletion.reason
        return false
    var rejectedIndex: int32
    let rejected =
        snapshot_production.SemanticSnapshotProductionRejectFailureInto(
            workspace.eventState, workspace.snapshotStore, csg,
            tables, admission,
            workspace.compilerUniverse.worldHead.headCid,
            workspace.compilerExecution, failureFacts,
            rejectedIndex, err)
    compiler_csg.CompilerCsgTerminalRelease(csg)
    if !rejected:
        panic("lsp_snapshot_canonical_rejection_invalid")
    let failureReason =
        strings.ConcatStr("", failureFacts.diagnosticMessages[0])
    let failureErr =
        strings.ConcatStr("", failureFacts.diagnosticMessages[0])
    var failureFactsReleaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
    snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
        failureFacts, failureFactsReleaseReceipt)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        tables.declarations)
    workspace.candidateBlockedReason = failureReason
    let _ = lspWorkspaceCandidateReject(workspace, startedNs)
    err = failureErr
    return false

@borrows
fn lspCloneInt32Sequence(source: int32[]): int32[] =
    var out: int32[]
    for index in 0..<source.len:
        add(out, source[index])
    return out

@borrows
fn lspCloneInt64Sequence(source: int64[]): int64[] =
    var out: int64[]
    for index in 0..<source.len:
        add(out, source[index])
    return out

@borrows
fn lspCloneFixed32Sequence(
        source: layout.FixedBytes32[]):
        layout.FixedBytes32[] =
    var out: layout.FixedBytes32[]
    for index in 0..<source.len:
        add(out, layout.FixedBytes32Copy(source[index]))
    return out

@borrows
fn lspWorkspaceEventStateClone(
        source: snapshot_core.WorkspaceSourceEventState):
        snapshot_core.WorkspaceSourceEventState =
    var out: snapshot_core.WorkspaceSourceEventState
    out.workspaceSessionCid =
        layout.FixedBytes32Copy(source.workspaceSessionCid)
    out.nextSourceVersion = source.nextSourceVersion
    out.lastAcceptedSourceVersion =
        source.lastAcceptedSourceVersion
    out.documentCids =
        lspCloneFixed32Sequence(source.documentCids)
    out.clientVersions =
        lspCloneInt64Sequence(source.clientVersions)
    out.documentOpenStates =
        lspCloneInt32Sequence(source.documentOpenStates)
    out.documentPresenceStates =
        lspCloneInt32Sequence(source.documentPresenceStates)
    out.documentRenamePeerRows =
        lspCloneInt32Sequence(source.documentRenamePeerRows)
    out.documentLastEventCids =
        lspCloneFixed32Sequence(source.documentLastEventCids)
    out.documentLastEventSourceVersions =
        lspCloneInt64Sequence(
            source.documentLastEventSourceVersions)
    out.documentLastEventKinds =
        lspCloneInt32Sequence(source.documentLastEventKinds)
    out.eventStateReceiptCid =
        layout.FixedBytes32Copy(source.eventStateReceiptCid)
    return out

@borrows
fn lspDocumentOverlayClone(source: DocumentOverlay):
        DocumentOverlay =
    var out: DocumentOverlay
    out.uri = strings.ConcatStr("", source.uri)
    out.documentCid =
        layout.FixedBytes32Copy(source.documentCid)
    out.contentCid =
        layout.FixedBytes32Copy(source.contentCid)
    out.text = strings.ConcatStr("", source.text)
    out.lineStartByteOffsets =
        lspCloneInt32Sequence(source.lineStartByteOffsets)
    out.sourceHashBlockStates =
        lspCloneInt64Sequence(source.sourceHashBlockStates)
    out.sourceHashBlockStatesMirror =
        lspCloneInt64Sequence(
            source.sourceHashBlockStatesMirror)
    out.sourceHashCacheContentCid =
        layout.FixedBytes32Copy(
            source.sourceHashCacheContentCid)
    out.sourceHashCacheTextLength =
        source.sourceHashCacheTextLength
    out.sourcePath =
        strings.ConcatStr("", source.sourcePath)
    out.modulePath =
        strings.ConcatStr("", source.modulePath)
    out.sealedBaseSourceText =
        strings.ConcatStr("", source.sealedBaseSourceText)
    out.sealedBaseSourceContentCid =
        layout.FixedBytes32Copy(
            source.sealedBaseSourceContentCid)
    out.sealedBaseSourceBound =
        source.sealedBaseSourceBound
    out.sourceText =
        strings.ConcatStr("", source.sourceText)
    out.sourceContentCid =
        layout.FixedBytes32Copy(source.sourceContentCid)
    out.clientVersion = source.clientVersion
    out.open = source.open
    out.present = source.present
    out.stableEventRow = source.stableEventRow
    out.compilerIdentityBound =
        source.compilerIdentityBound
    out.entrySource = source.entrySource
    return out

@borrows
fn lspCompilerExecutionIdentityCloneInto(
        source: execution.CompilerExecutionIdentity,
        out: var execution.CompilerExecutionIdentity,
        err: var str): bool =
    let cloned =
        execution.CompilerExecutionIdentityMake(
            strings.ConcatStr("", source.caseId),
            source.sourceBundleRaw32,
            source.materializerBytesRaw32,
            source.grammarObligationRootRaw32,
            source.compilerSourceClosureRaw32,
            source.driverBytesRaw32,
            source.toolchainManifestRaw32,
            source.commandManifestRaw32,
            strings.ConcatStr("", source.targetTriple))
    if IsErr(cloned):
        err = Error(cloned)
        return false
    out = Value(cloned)
    if !layout.FixedBytes32Equal(
           out.executionRaw32, source.executionRaw32):
        err = " lsp candidate job: execution clone drift"
        return false
    err = ""
    return true

@borrows
fn lspCompilerPackageSnapshotClone(
        source: compiler_world.CompilerPackageSnapshot):
        compiler_world.CompilerPackageSnapshot =
    var out: compiler_world.CompilerPackageSnapshot
    out.packageId = strings.ConcatStr("", source.packageId)
    out.channel = strings.ConcatStr("", source.channel)
    out.sourceBundleCid =
        layout.FixedBytes32Copy(source.sourceBundleCid)
    out.csgRootCid =
        layout.FixedBytes32Copy(source.csgRootCid)
    out.exportSurfaceCid =
        layout.FixedBytes32Copy(source.exportSurfaceCid)
    out.syntaxSurfaceCid =
        layout.FixedBytes32Copy(source.syntaxSurfaceCid)
    out.depsManifestCid =
        layout.FixedBytes32Copy(source.depsManifestCid)
    out.migrationProofCid =
        layout.FixedBytes32Copy(source.migrationProofCid)
    out.signature = strings.ConcatStr("", source.signature)
    out.snapshotCid =
        layout.FixedBytes32Copy(source.snapshotCid)
    return out

@borrows
fn lspCompilerLocalUniverseClone(
        source: compiler_world.CompilerLocalUniverse):
        compiler_world.CompilerLocalUniverse =
    var out: compiler_world.CompilerLocalUniverse
    out.compilerSnapshot =
        lspCompilerPackageSnapshotClone(
            source.compilerSnapshot)
    out.stdSnapshot =
        lspCompilerPackageSnapshotClone(source.stdSnapshot)
    out.runtimeSnapshot =
        lspCompilerPackageSnapshotClone(
            source.runtimeSnapshot)
    out.manifest.channel =
        strings.ConcatStr("", source.manifest.channel)
    out.manifest.entryCount = source.manifest.entryCount
    out.manifest.managedDependencyReceiptCid =
        layout.FixedBytes32Copy(
            source.manifest.managedDependencyReceiptCid)
    for index in 0..<source.manifest.entries.len:
        var entry: compiler_world.CompilerUniverseManifestEntry
        entry.packageId =
            strings.ConcatStr(
                "", source.manifest.entries[index].packageId)
        entry.snapshotCid =
            layout.FixedBytes32Copy(
                source.manifest.entries[index].snapshotCid)
        entry.syntaxSurfaceCid =
            layout.FixedBytes32Copy(
                source.manifest.entries[index].syntaxSurfaceCid)
        entry.migrationProofCid =
            layout.FixedBytes32Copy(
                source.manifest.entries[index].migrationProofCid)
        entry.managedMirrorBundleCid =
            layout.FixedBytes32Copy(
                source.manifest.entries[index].
                    managedMirrorBundleCid)
        add(out.manifest.entries, entry)
    out.manifest.manifestCid =
        layout.FixedBytes32Copy(source.manifest.manifestCid)
    out.worldHead.universeId =
        strings.ConcatStr("", source.worldHead.universeId)
    out.worldHead.channel =
        strings.ConcatStr("", source.worldHead.channel)
    out.worldHead.headEpoch = source.worldHead.headEpoch
    out.worldHead.prevHeadCid =
        layout.FixedBytes32Copy(source.worldHead.prevHeadCid)
    out.worldHead.manifestRootCid =
        layout.FixedBytes32Copy(
            source.worldHead.manifestRootCid)
    out.worldHead.csgRootCid =
        layout.FixedBytes32Copy(source.worldHead.csgRootCid)
    out.worldHead.compilerPkgCid =
        layout.FixedBytes32Copy(
            source.worldHead.compilerPkgCid)
    out.worldHead.stdPkgCid =
        layout.FixedBytes32Copy(source.worldHead.stdPkgCid)
    out.worldHead.runtimePkgCid =
        layout.FixedBytes32Copy(
            source.worldHead.runtimePkgCid)
    out.worldHead.signature =
        strings.ConcatStr("", source.worldHead.signature)
    out.worldHead.headCid =
        layout.FixedBytes32Copy(source.worldHead.headCid)
    return out

@borrows
fn lspCandidateWorkerWorkspaceCloneInto(
        source: var LspWorkspace,
        jobCid: layout.FixedBytes32,
        sourceVersion: int64,
        out: var LspWorkspace,
        err: var str): bool =
    out = LspWorkspace()
    if sourceVersion <= 0 ||
       sourceVersion !=
           source.eventState.lastAcceptedSourceVersion ||
       sourceVersion !=
           source.snapshotStore.core.currentSourceVersion ||
       layout.FixedBytes32Equal(jobCid, layout.FixedBytes32()):
        err = " lsp candidate job: workspace version mismatch"
        return false
    out.eventState =
        lspWorkspaceEventStateClone(source.eventState)
    if !snapshot_production.SemanticSnapshotProductionStoreInitInto(
           out.eventState.workspaceSessionCid,
           out.snapshotStore,
           err):
        return false
    out.snapshotStore.core.currentSourceVersion =
        sourceVersion
    out.compilerUniverse =
        lspCompilerLocalUniverseClone(
            source.compilerUniverse)
    if !lspCompilerExecutionIdentityCloneInto(
           source.compilerExecution,
           out.compilerExecution,
           err):
        var releaseErr: str
        if !snapshot_production.SemanticSnapshotProductionStoreReleaseInto(
               out.snapshotStore, releaseErr):
            panic(Fmt"lsp_candidate_worker_clone_release_failed {releaseErr}")
        out = LspWorkspace()
        return false
    for index in 0..<source.documents.len:
        add(out.documents,
            lspDocumentOverlayClone(source.documents[index]))
    out.workspaceRoot =
        strings.ConcatStr("", source.workspaceRoot)
    out.packageRoot =
        strings.ConcatStr("", source.packageRoot)
    out.packageId =
        strings.ConcatStr("", source.packageId)
    out.targetTriple =
        strings.ConcatStr("", source.targetTriple)
    out.entryDocumentCid =
        layout.FixedBytes32Copy(source.entryDocumentCid)
    out.candidateCaptureOnly = true
    out.candidateCaptureJobCid =
        layout.FixedBytes32Copy(jobCid)
    out.initialized = true
    err = ""
    return true

fn lspCandidateJobCompletionReleaseInto(
        completion: var LspCandidateJobCompletion) =
    if completion.kind <= 0:
        panic("lsp_candidate_completion_double_release")
    if completion.kind == lspCandidateCompletionPublished:
        snapshot_production.SemanticSnapshotProductionCandidateRelease(
            completion.candidate)
        compiler_csg.CompilerCsgTerminalRelease(completion.csg)
    elif completion.kind ==
             lspCandidateCompletionCsgRejected:
        compiler_csg.CompilerCsgTerminalRelease(completion.csg)
    elif completion.kind ==
             lspCandidateCompletionAdmissionRejected:
        var releaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            completion.failureFacts, releaseReceipt)
        declaration.SemanticSnapshotDeclarationTableReleaseInto(
            completion.tables.declarations)
        compiler_csg.CompilerCsgTerminalRelease(completion.csg)
    gCandidateScheduler.completionReleaseCount =
        gCandidateScheduler.completionReleaseCount + int64(1)
    completion = LspCandidateJobCompletion()

fn lspCandidateWorkerMain(context: LspCandidateWorkerContext) =
    if context == nil:
        panic("lsp_candidate_worker_context_missing")
    if context.eventWriteFd < 0 ||
       !context.workspace.candidateCaptureOnly:
        panic("lsp_candidate_worker_context_invalid")
    var buildErr: str
    let _ =
        lspWorkspaceTryProduceCurrentCompilerSnapshotInto(
            context.workspace, buildErr)
    if context.workspace.candidateCapturedCompletion.kind <= 0 ||
       !layout.FixedBytes32Equal(
           context.workspace.candidateCapturedCompletion.jobCid,
           context.workspace.candidateCaptureJobCid) ||
       context.workspace.candidateCapturedCompletion.sourceVersion !=
           context.workspace.snapshotStore.core.currentSourceVersion ||
       !layout.FixedBytes32Equal(
           context.workspace.eventState.eventStateReceiptCid,
           context.ticket.sourceEventStateReceiptCid) ||
       layout.FixedBytes32Equal(
           context.workspace.candidateCapturedCompletion.
               completionAuthorityCid,
           layout.FixedBytes32()):
        panic("lsp_candidate_worker_completion_missing")
    context.completion =
        context.workspace.candidateCapturedCompletion
    context.workspace.candidateCapturedCompletion =
        LspCandidateJobCompletion()
    context.completion.sourceEventStateReceiptCid =
        layout.FixedBytes32Copy(
            context.workspace.eventState.eventStateReceiptCid)
    context.completion.admissionReceiptCid =
        layout.FixedBytes32Copy(
            context.workspace.candidateAdmissionReceiptCid)
    context.completion.admissionCompletedStageBitmap =
        context.workspace.candidateAdmissionCompletedStageBitmap
    context.completion.admissionMissingFactBitmap =
        context.workspace.candidateAdmissionMissingFactBitmap
    context.completion.workerMetrics =
        context.workspace.metrics
    var releaseErr: str
    if !LspWorkspaceReleaseInto(
           context.workspace, releaseErr):
        panic(Fmt"lsp_candidate_worker_workspace_release_failed {releaseErr}")
    lspChannelSendByte(
        context.eventWriteFd, lspSchedulerEventCandidate)
    memRelease(context)

@borrows
fn lspCandidateRequestBindingId(
        binding: var LspCandidateRequestBinding): json.JsonNode =
    if binding.requestIdIsInt:
        return json.NewJInt(binding.requestIdInt)
    return json.NewJString(
        strings.ConcatStr("", binding.requestIdText))

@borrows
fn lspCandidateSchedulerResolveTerminalBindings(
        jobCid: layout.FixedBytes32,
        sourceVersion: int64,
        published: bool,
        completionAuthorityCid: layout.FixedBytes32) =
    for index in 0..<gCandidateScheduler.requestBindings.len:
        if !gCandidateScheduler.requestBindings[index].active ||
           gCandidateScheduler.requestBindings[index].sourceVersion !=
               sourceVersion ||
           !layout.FixedBytes32Equal(
               gCandidateScheduler.requestBindings[index].jobCid,
               jobCid):
            continue
        let id =
            lspCandidateRequestBindingId(
                gCandidateScheduler.requestBindings[index])
        var result = json.NewJObject()
        result["sourceVersion"] = json.NewJInt(sourceVersion)
        result["jobCid"] = layout.FixedBytes32Hex(jobCid)
        result["completionAuthorityCid"] =
            layout.FixedBytes32Hex(completionAuthorityCid)
        result["published"] = json.NewJBool(published)
        result["terminal"] = json.NewJBool(true)
        LspWriteMessage(json.Stringify(
            LspMakeResponse(id, result)))
        gCandidateScheduler.requestBindings[index].active = false

@borrows
fn lspCandidateSchedulerResolveRejectionBindings(
        receipt:
            snapshot_production.SemanticSnapshotProductionJobCompletionRejection) =
    for index in 0..<gCandidateScheduler.requestBindings.len:
        if !gCandidateScheduler.requestBindings[index].active ||
           gCandidateScheduler.requestBindings[index].sourceVersion !=
               receipt.sourceVersion ||
           !layout.FixedBytes32Equal(
               gCandidateScheduler.requestBindings[index].jobCid,
               receipt.jobCid):
            continue
        let id =
            lspCandidateRequestBindingId(
                gCandidateScheduler.requestBindings[index])
        let code =
            receipt.reasonKind ==
                snapshot_production.SemanticSnapshotProductionJobCompletionCancelled ?
                int32(lsp.RequestCancelled) :
                int32(lsp.ContentModified)
        let reason =
            receipt.reasonKind ==
                snapshot_production.SemanticSnapshotProductionJobCompletionCancelled ?
                "candidate job cancelled" :
                "candidate job completion is not current"
        LspWriteMessage(json.Stringify(
            LspMakeError(
                id, code,
                Fmt"{reason} receipt={layout.FixedBytes32Hex(receipt.receiptCid)}")))
        gCandidateScheduler.requestBindings[index].active = false

fn lspCandidateSchedulerRecordRejection(
        receipt:
            snapshot_production.SemanticSnapshotProductionJobCompletionRejection) =
    var err: str
    if !snapshot_production.SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
           receipt, err):
        panic(Fmt"lsp_candidate_rejection_receipt_invalid {err}")
    if receipt.reasonKind ==
           snapshot_production.SemanticSnapshotProductionJobCompletionCancelled:
        gCandidateScheduler.cancelledCompletionCount =
            gCandidateScheduler.cancelledCompletionCount + int64(1)
    elif receipt.reasonKind ==
             snapshot_production.SemanticSnapshotProductionJobCompletionLate:
        gCandidateScheduler.lateCompletionCount =
            gCandidateScheduler.lateCompletionCount + int64(1)
    elif receipt.reasonKind ==
             snapshot_production.SemanticSnapshotProductionJobCompletionDuplicate:
        gCandidateScheduler.duplicateCompletionCount =
            gCandidateScheduler.duplicateCompletionCount + int64(1)
    lspCandidateSchedulerResolveRejectionBindings(receipt)
    add(gCandidateScheduler.completionRejections, receipt)

fn lspCandidateSchedulerRejectCancelledPendingInto(
        workspace: var LspWorkspace,
        ticket:
            var snapshot_production.SemanticSnapshotProductionJobTicket) =
    var cancelled: bool
    var err: str
    if !snapshot_production.SemanticSnapshotProductionJobTicketCancelInto(
           ticket, ticket.jobCid, ticket.sourceVersion,
           cancelled, err):
        panic(Fmt"lsp_pending_candidate_cancel_failed {err}")
    if cancelled:
        gCandidateScheduler.cancelledCount =
            gCandidateScheduler.cancelledCount + int64(1)
    var rejection: snapshot_production.SemanticSnapshotProductionJobCompletionRejection
    let admitted =
        snapshot_production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
            workspace.snapshotStore,
            ticket,
            ticket.jobCid,
            ticket.sourceVersion,
            ticket.sourceEventStateReceiptCid,
            ticket.jobCid,
            rejection,
            err)
    if admitted || layout.FixedBytes32Equal(
           rejection.receiptCid, layout.FixedBytes32()):
        panic("lsp_pending_candidate_cancel_admission_split")
    lspCandidateSchedulerRecordRejection(rejection)

fn lspCandidateSchedulerCancelActiveInto(
        sourceVersion: int64,
        exactRequired: bool): bool =
    let context = gCandidateScheduler.activeContext
    if context == nil:
        return false
    if sourceVersion > 0 &&
       context.ticket.sourceVersion != sourceVersion:
        return false
    var cancelled: bool
    var err: str
    if !snapshot_production.SemanticSnapshotProductionJobTicketCancelInto(
           context.ticket,
           context.ticket.jobCid,
           context.ticket.sourceVersion,
           cancelled,
           err):
        if exactRequired:
            panic(Fmt"lsp_active_candidate_cancel_failed {err}")
        return false
    if cancelled:
        gCandidateScheduler.cancelledCount =
            gCandidateScheduler.cancelledCount + int64(1)
    return true

fn lspCandidateSchedulerDropPendingInto(
        workspace: var LspWorkspace,
        sourceVersion: int64,
        exactRequired: bool): bool =
    if gCandidateScheduler.pendingTicket.state == 0:
        return false
    if sourceVersion > 0 &&
       gCandidateScheduler.pendingTicket.sourceVersion !=
           sourceVersion:
        return false
    lspCandidateSchedulerRejectCancelledPendingInto(
        workspace, gCandidateScheduler.pendingTicket)
    var releaseErr: str
    if gCandidateScheduler.pendingWorkspace.initialized &&
       !LspWorkspaceReleaseInto(
           gCandidateScheduler.pendingWorkspace, releaseErr):
        panic(Fmt"lsp_pending_candidate_release_failed {releaseErr}")
    gCandidateScheduler.pendingTicket =
        snapshot_production.SemanticSnapshotProductionJobTicket()
    gCandidateScheduler.pendingWorkspace = LspWorkspace()
    let _ = exactRequired
    return true

fn lspCandidateSchedulerStartPendingInto(
        workspace: var LspWorkspace) =
    if !gCandidateScheduler.enabled ||
       gCandidateScheduler.activeContext != nil ||
       gCandidateScheduler.pendingTicket.state == 0:
        return
    let context = new(LspCandidateWorkerContext)
    if context == nil:
        panic("lsp_candidate_worker_alloc_failed")
    context.ticket = gCandidateScheduler.pendingTicket
    context.workspace = gCandidateScheduler.pendingWorkspace
    context.eventWriteFd =
        gCandidateScheduler.eventWriteFd
    gCandidateScheduler.pendingTicket =
        snapshot_production.SemanticSnapshotProductionJobTicket()
    gCandidateScheduler.pendingWorkspace = LspWorkspace()
    var err: str
    if !snapshot_production.SemanticSnapshotProductionJobTicketStartInto(
           context.ticket, context.ticket.jobCid, err):
        panic(Fmt"lsp_candidate_worker_ticket_start_failed {err}")
    memRetain(context)
    let worker =
        thread.StartPtr(&lspCandidateWorkerMain, context)
    if worker == nil:
        memRelease(context)
        panic("lsp_candidate_worker_start_failed")
    gCandidateScheduler.activeContext = context
    gCandidateScheduler.activeWorker = worker
    gCandidateScheduler.startedCount =
        gCandidateScheduler.startedCount + int64(1)
    workspace.metrics.candidateAttemptCount =
        workspace.metrics.candidateAttemptCount + int64(1)

fn lspCandidateSchedulerEnqueueInto(
        workspace: var LspWorkspace,
        sourceVersion: int64,
        err: var str): bool =
    if !gCandidateScheduler.enabled ||
       sourceVersion <= 0 ||
       sourceVersion !=
           workspace.eventState.lastAcceptedSourceVersion ||
       sourceVersion !=
           workspace.snapshotStore.core.currentSourceVersion:
        err = " lsp candidate scheduler: enqueue version mismatch"
        return false
    let _ =
        lspCandidateSchedulerCancelActiveInto(0, true)
    let _ =
        lspCandidateSchedulerDropPendingInto(
            workspace, 0, true)
    var ticket: snapshot_production.SemanticSnapshotProductionJobTicket
    if !snapshot_production.SemanticSnapshotProductionJobTicketMakeInto(
           workspace.eventState,
           workspace.snapshotStore,
           ticket,
           err):
        return false
    var workerWorkspace: LspWorkspace
    if !lspCandidateWorkerWorkspaceCloneInto(
           workspace, ticket.jobCid, sourceVersion,
           workerWorkspace, err):
        return false
    gCandidateScheduler.pendingTicket = ticket
    gCandidateScheduler.pendingWorkspace =
        workerWorkspace
    lspCandidateSchedulerStartPendingInto(workspace)
    err = ""
    return true

fn lspWorkspaceStageCapturedCandidateInto(
        workspace: var LspWorkspace,
        ticket:
            var snapshot_production.SemanticSnapshotProductionJobTicket,
        completion: var LspCandidateJobCompletion,
        err: var str): bool =
    let sourceVersion =
        workspace.snapshotStore.core.currentSourceVersion
    if completion.sourceVersion != sourceVersion ||
       !layout.FixedBytes32Equal(
           ticket.sourceEventStateReceiptCid,
           completion.sourceEventStateReceiptCid) ||
       !layout.FixedBytes32Equal(
           ticket.sourceEventStateReceiptCid,
           completion.candidate.binding.sourceEventStateReceiptCid) ||
       !layout.FixedBytes32Equal(
           completion.completionAuthorityCid,
           completion.candidate.binding.bindingReceiptCid) ||
       !snapshot_production.SemanticSnapshotProductionCandidateStrictValidateInto(
           completion.candidate,
           completion.csg,
           workspace.compilerUniverse,
           workspace.compilerExecution,
           err):
        if err == "":
            err = " lsp candidate scheduler: captured candidate mismatch"
        return false
    var stagedIndex: int32
    if !snapshot_production.SemanticSnapshotProductionStageCandidateInto(
           workspace.snapshotStore,
           completion.candidate,
           completion.csg,
           workspace.compilerUniverse,
           workspace.compilerExecution,
           stagedIndex,
           err):
        return false
    if stagedIndex < 0 ||
       stagedIndex != workspace.snapshotStore.core.candidateIndex ||
       workspace.snapshotStore.core.sourceVersions[stagedIndex] !=
           sourceVersion:
        panic("lsp_candidate_scheduler_stage_split")
    var publishedIndex: int32
    var reclaimSnapshotIndex: int32
    snapshot_production.SemanticSnapshotProductionCommitCandidateInto(
        workspace.snapshotStore,
        stagedIndex,
        publishedIndex,
        reclaimSnapshotIndex)
    if publishedIndex != stagedIndex ||
       workspace.snapshotStore.core.publishedIndex !=
           publishedIndex ||
       workspace.snapshotStore.core.sourceVersions[publishedIndex] !=
           sourceVersion:
        panic("lsp_candidate_scheduler_commit_split")
    if reclaimSnapshotIndex >= 0 &&
       !snapshot_production.SemanticSnapshotProductionStoreReclaimSnapshotInto(
           workspace.snapshotStore,
           reclaimSnapshotIndex,
           err):
        return false
    workspace.candidateBlockedReason = ""
    workspace.metrics.candidatePublishedCount =
        workspace.metrics.candidatePublishedCount + int64(1)
    workspace.metrics.candidateAdmissionPublishWallNs =
        workspace.metrics.candidateAdmissionPublishWallNs +
        monotimes.MonoTimeNs(monotimes.GetMonoTime()) -
            completion.startedNs
    err = ""
    return true

@borrows
fn lspCandidateSchedulerMergeWorkerMetrics(
        workspace: var LspWorkspace,
        completion: var LspCandidateJobCompletion) =
    workspace.metrics.parserBuildObserved =
        workspace.metrics.parserBuildObserved ||
        completion.workerMetrics.parserBuildObserved
    workspace.metrics.parserBuildWallNs =
        workspace.metrics.parserBuildWallNs +
        completion.workerMetrics.parserBuildWallNs
    workspace.metrics.compilerCsgBuildObserved =
        workspace.metrics.compilerCsgBuildObserved ||
        completion.workerMetrics.compilerCsgBuildObserved
    workspace.metrics.compilerCsgBuildWallNs =
        workspace.metrics.compilerCsgBuildWallNs +
        completion.workerMetrics.compilerCsgBuildWallNs
    workspace.metrics.compilerSnapshotBuilderAttemptCount =
        workspace.metrics.compilerSnapshotBuilderAttemptCount +
        completion.workerMetrics.compilerSnapshotBuilderAttemptCount
    workspace.metrics.explicitSourceFileReadCount =
        workspace.metrics.explicitSourceFileReadCount +
        completion.workerMetrics.explicitSourceFileReadCount
    workspace.metrics.explicitSourceFileReadBytes =
        workspace.metrics.explicitSourceFileReadBytes +
        completion.workerMetrics.explicitSourceFileReadBytes

fn lspCandidateSchedulerCommitCompletionInto(
        workspace: var LspWorkspace,
        context: LspCandidateWorkerContext,
        err: var str): bool =
    if context == nil:
        err = " lsp candidate scheduler: completion context missing"
        return false
    lspCandidateSchedulerMergeWorkerMetrics(
        workspace, context.completion)
    var rejection: snapshot_production.SemanticSnapshotProductionJobCompletionRejection
    let admitted =
        snapshot_production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
            workspace.snapshotStore,
            context.ticket,
            context.completion.jobCid,
            context.completion.sourceVersion,
            context.completion.sourceEventStateReceiptCid,
            context.completion.completionAuthorityCid,
            rejection,
            err)
    if !admitted:
        if layout.FixedBytes32Equal(
               rejection.receiptCid, layout.FixedBytes32()):
            return false
        lspCandidateSchedulerRecordRejection(rejection)
        lspCandidateJobCompletionReleaseInto(
            context.completion)
        err = ""
        return false
    workspace.candidateAdmissionReceiptCid =
        layout.FixedBytes32Copy(
            context.completion.admissionReceiptCid)
    workspace.candidateAdmissionCompletedStageBitmap =
        context.completion.admissionCompletedStageBitmap
    workspace.candidateAdmissionMissingFactBitmap =
        context.completion.admissionMissingFactBitmap
    var published: bool
    if context.completion.kind ==
           lspCandidateCompletionPublished:
        published =
            lspWorkspaceStageCapturedCandidateInto(
                workspace, context.ticket, context.completion, err)
        if !published:
            return false
    elif context.completion.kind ==
             lspCandidateCompletionEarlyRejected:
        let expectedAuthority =
            lspCandidateCompletionAuthorityCid(
                context.completion.jobCid,
                context.completion.sourceVersion,
                context.completion.kind,
                context.completion.reason,
                layout.FixedBytes32())
        if !layout.FixedBytes32Equal(
               expectedAuthority,
               context.completion.completionAuthorityCid):
            err = " lsp candidate scheduler: early rejection authority drift"
            return false
        let _ =
            lspWorkspaceAutomaticCandidateReject(
                workspace,
                context.completion.startedNs,
                context.completion.diagnosticProducerKind,
                context.completion.reason,
                err)
        if !lspWorkspaceCurrentVersionRejected(workspace):
            return false
        err = ""
    elif context.completion.kind ==
             lspCandidateCompletionCsgRejected:
        let expectedAuthority =
            lspCandidateCompletionAuthorityCid(
                context.completion.jobCid,
                context.completion.sourceVersion,
                context.completion.kind,
                context.completion.reason,
                context.completion.
                    portableSourceIdentityReceiptCid)
        if !layout.FixedBytes32Equal(
               expectedAuthority,
               context.completion.completionAuthorityCid) ||
           !lspWorkspaceRecordCanonicalFailureInto(
                workspace,
                context.completion.failureDependencies,
                context.completion.diagnosticProducerKind,
                context.completion.failureProducerDocumentCids,
                context.completion.portableSourceBundleCid,
                context.completion.
                    portableSourceIdentityReceiptCid,
                context.completion.csg.diagnosticFailureArtifact,
                context.completion.csg.diagnosticFailureAuthority,
                context.completion.csg.
                    diagnosticFailureProducerProjectionCids,
                context.completion.reason,
                err):
            return false
        workspace.candidateBlockedReason =
            strings.ConcatStr("", context.completion.reason)
        let _ =
            lspWorkspaceCandidateReject(
                workspace, context.completion.startedNs)
    elif context.completion.kind ==
             lspCandidateCompletionAdmissionRejected:
        if !layout.FixedBytes32Equal(
               context.completion.completionAuthorityCid,
               context.completion.failureFacts.admissionReceiptCid):
            err =
                " lsp candidate scheduler: admission rejection authority drift"
            return false
        var rejectedIndex: int32
        if !snapshot_production.SemanticSnapshotProductionRejectFailureInto(
               workspace.eventState,
               workspace.snapshotStore,
               context.completion.csg,
               context.completion.tables,
               context.completion.admission,
               workspace.compilerUniverse.worldHead.headCid,
               workspace.compilerExecution,
               context.completion.failureFacts,
               rejectedIndex,
               err):
            return false
        workspace.candidateBlockedReason =
            strings.ConcatStr("", context.completion.reason)
        let _ =
            lspWorkspaceCandidateReject(
                workspace, context.completion.startedNs)
    else:
        err = " lsp candidate scheduler: unknown completion kind"
        return false
    if !snapshot_production.SemanticSnapshotProductionJobCompletionCommitInto(
           context.ticket,
           context.completion.jobCid,
           context.completion.completionAuthorityCid,
           published,
           err):
        return false
    lspCandidateSchedulerResolveTerminalBindings(
        context.completion.jobCid,
        context.completion.sourceVersion,
        published,
        context.completion.completionAuthorityCid)
    lspCandidateJobCompletionReleaseInto(context.completion)
    err = ""
    return published

fn lspCandidateSchedulerHandleCompletionInto(
        workspace: var LspWorkspace) =
    let context = gCandidateScheduler.activeContext
    if context == nil || gCandidateScheduler.activeWorker == nil:
        panic("lsp_candidate_scheduler_completion_without_worker")
    if !thread.JoinThread(gCandidateScheduler.activeWorker):
        panic("lsp_candidate_scheduler_worker_join_failed")
    gCandidateScheduler.completionCount =
        gCandidateScheduler.completionCount + int64(1)
    var err: str
    let _ =
        lspCandidateSchedulerCommitCompletionInto(
            workspace, context, err)
    if err != "":
        panic(Fmt"lsp_candidate_scheduler_completion_failed {err}")
    gCandidateScheduler.activeWorker = nil
    gCandidateScheduler.activeContext = nil
    lspCandidateSchedulerStartPendingInto(workspace)

@borrows
fn lspCandidateRequestIdMatches(
        binding: var LspCandidateRequestBinding,
        id: var json.JsonNode): bool =
    if !binding.active:
        return false
    if id.kind == json.JInt:
        return binding.requestIdIsInt &&
            binding.requestIdInt == json.GetInt64(id, int64(-1))
    if id.kind == json.JString:
        return !binding.requestIdIsInt &&
            binding.requestIdText == json.GetStr(id)
    return false

fn lspCandidateSchedulerRegisterBarrierInto(
        id: var json.JsonNode,
        sourceVersion: int64,
        err: var str): bool =
    if !gCandidateScheduler.enabled ||
       sourceVersion <= 0 ||
       (id.kind != json.JInt && id.kind != json.JString):
        err = " lsp candidate barrier: invalid request identity"
        return false
    for index in 0..<gCandidateScheduler.requestBindings.len:
        if lspCandidateRequestIdMatches(
               gCandidateScheduler.requestBindings[index], id):
            err = " lsp candidate barrier: duplicate active request id"
            return false
    var jobCid: layout.FixedBytes32
    let active = gCandidateScheduler.activeContext
    if active != nil &&
       active.ticket.sourceVersion == sourceVersion:
        jobCid = layout.FixedBytes32Copy(
            active.ticket.jobCid)
    elif gCandidateScheduler.pendingTicket.state != 0 &&
         gCandidateScheduler.pendingTicket.sourceVersion ==
             sourceVersion:
        jobCid = layout.FixedBytes32Copy(
            gCandidateScheduler.pendingTicket.jobCid)
    else:
        err = " lsp candidate barrier: source version job is not active"
        return false
    var binding: LspCandidateRequestBinding
    binding.requestIdIsInt = id.kind == json.JInt
    if binding.requestIdIsInt:
        binding.requestIdInt =
            json.GetInt64(id, int64(-1))
    else:
        binding.requestIdText =
            strings.ConcatStr("", json.GetStr(id))
    binding.jobCid = jobCid
    binding.sourceVersion = sourceVersion
    binding.active = true
    add(gCandidateScheduler.requestBindings, binding)
    err = ""
    return true

fn lspCandidateSchedulerCancelRequestInto(
        workspace: var LspWorkspace,
        id: var json.JsonNode,
        err: var str): bool =
    for index in 0..<gCandidateScheduler.requestBindings.len:
        if !lspCandidateRequestIdMatches(
               gCandidateScheduler.requestBindings[index], id):
            continue
        let context = gCandidateScheduler.activeContext
        if context != nil &&
           layout.FixedBytes32Equal(
               context.ticket.jobCid,
               gCandidateScheduler.requestBindings[index].jobCid) &&
           context.ticket.sourceVersion ==
               gCandidateScheduler.requestBindings[index].sourceVersion:
            let cancelled =
                lspCandidateSchedulerCancelActiveInto(
                    gCandidateScheduler.requestBindings[
                        index].sourceVersion,
                    true)
            if !cancelled:
                err =
                    " lsp candidate scheduler: bound active cancel failed"
                return false
            err = ""
            return true
        if gCandidateScheduler.pendingTicket.state != 0 &&
           layout.FixedBytes32Equal(
               gCandidateScheduler.pendingTicket.jobCid,
               gCandidateScheduler.requestBindings[index].jobCid) &&
           gCandidateScheduler.pendingTicket.sourceVersion ==
               gCandidateScheduler.requestBindings[index].sourceVersion:
            if !lspCandidateSchedulerDropPendingInto(
                   workspace,
                   gCandidateScheduler.requestBindings[
                       index].sourceVersion,
                   true):
                err =
                    " lsp candidate scheduler: bound pending cancel failed"
                return false
            err = ""
            return true
        gCandidateScheduler.requestBindings[index].active = false
        err =
            " lsp candidate scheduler: cancel request job is no longer active"
        return false
    err =
        " lsp candidate scheduler: cancel request id is not bound"
    return false

fn lspCandidateSchedulerInitInto(err: var str): bool =
    gCandidateScheduler = LspCandidateScheduler()
    gCandidateScheduler.eventReadFd = -1
    gCandidateScheduler.eventWriteFd = -1
    gCandidateScheduler.acknowledgementReadFd = -1
    gCandidateScheduler.acknowledgementWriteFd = -1
    var eventPair: LspFdPair
    eventPair.readFd = -1
    eventPair.writeFd = -1
    if lspPipeInto(eventPair) != 0 ||
       eventPair.readFd < 0 || eventPair.writeFd < 0:
        err = " lsp candidate scheduler: event pipe failed"
        return false
    var acknowledgementPair: LspFdPair
    acknowledgementPair.readFd = -1
    acknowledgementPair.writeFd = -1
    if lspPipeInto(acknowledgementPair) != 0 ||
       acknowledgementPair.readFd < 0 ||
       acknowledgementPair.writeFd < 0:
        lspChannelCloseFd(eventPair.readFd)
        lspChannelCloseFd(eventPair.writeFd)
        lspChannelCloseFd(acknowledgementPair.readFd)
        lspChannelCloseFd(acknowledgementPair.writeFd)
        err = " lsp candidate scheduler: acknowledgement pipe failed"
        return false
    gCandidateScheduler.eventReadFd = eventPair.readFd
    gCandidateScheduler.eventWriteFd = eventPair.writeFd
    gCandidateScheduler.acknowledgementReadFd =
        acknowledgementPair.readFd
    gCandidateScheduler.acknowledgementWriteFd =
        acknowledgementPair.writeFd
    let context = new(LspInputWorkerContext)
    if context == nil:
        lspChannelCloseFd(gCandidateScheduler.eventReadFd)
        lspChannelCloseFd(gCandidateScheduler.eventWriteFd)
        lspChannelCloseFd(
            gCandidateScheduler.acknowledgementReadFd)
        lspChannelCloseFd(
            gCandidateScheduler.acknowledgementWriteFd)
        err = " lsp candidate scheduler: input worker allocation failed"
        return false
    context.eventWriteFd = gCandidateScheduler.eventWriteFd
    context.acknowledgementReadFd =
        gCandidateScheduler.acknowledgementReadFd
    memRetain(context)
    let worker =
        thread.StartPtr(&lspInputWorkerMain, context)
    if worker == nil:
        memRelease(context)
        lspChannelCloseFd(gCandidateScheduler.eventReadFd)
        lspChannelCloseFd(gCandidateScheduler.eventWriteFd)
        lspChannelCloseFd(
            gCandidateScheduler.acknowledgementReadFd)
        lspChannelCloseFd(
            gCandidateScheduler.acknowledgementWriteFd)
        err = " lsp candidate scheduler: input worker start failed"
        return false
    gCandidateScheduler.inputContext = context
    gCandidateScheduler.inputWorker = worker
    gCandidateScheduler.enabled = true
    err = ""
    return true

fn lspCandidateSchedulerStopCandidateInto(
        workspace: var LspWorkspace) =
    let _ = lspCandidateSchedulerCancelActiveInto(0, true)
    let _ =
        lspCandidateSchedulerDropPendingInto(
            workspace, 0, true)
    if gCandidateScheduler.activeWorker != nil:
        if !thread.JoinThread(gCandidateScheduler.activeWorker):
            panic("lsp_candidate_scheduler_shutdown_join_failed")
        let context = gCandidateScheduler.activeContext
        if context == nil:
            panic("lsp_candidate_scheduler_shutdown_context_missing")
        var err: str
        let _ =
            lspCandidateSchedulerCommitCompletionInto(
                workspace, context, err)
        if err != "":
            panic(Fmt"lsp_candidate_scheduler_shutdown_completion_failed {err}")
    gCandidateScheduler.activeWorker = nil
    gCandidateScheduler.activeContext = nil

fn lspCandidateSchedulerFinishInto(
        workspace: var LspWorkspace,
        inputWorkerStopped: bool) =
    if !gCandidateScheduler.enabled:
        return
    lspCandidateSchedulerStopCandidateInto(workspace)
    if !inputWorkerStopped:
        panic("lsp_candidate_scheduler_input_worker_not_stopped")
    lspChannelCloseFd(gCandidateScheduler.eventReadFd)
    lspChannelCloseFd(gCandidateScheduler.eventWriteFd)
    lspChannelCloseFd(
        gCandidateScheduler.acknowledgementReadFd)
    lspChannelCloseFd(
        gCandidateScheduler.acknowledgementWriteFd)
    gCandidateScheduler = LspCandidateScheduler()

fn lspSpanContains(
        startLine: int32,
        startColumn: int32,
        endLine: int32,
        endColumn: int32,
        line: int32,
        column: int32): bool =
    if line < startLine || line > endLine:
        return false
    if line == startLine && column < startColumn:
        return false
    if line == endLine && column >= endColumn:
        return false
    return true

@borrows
fn lspPinnedBindingMatchesQueryProjection(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin): bool =
    if pin.payloadIndex < 0 ||
       pin.payloadIndex >= workspace.snapshotStore.payloadBindings.len ||
       pin.payloadIndex >= workspace.snapshotStore.payloadIdentities.len ||
       pin.payloadIndex >= workspace.snapshotStore.payloadFactsRootCids.len ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryProjectionCids.len ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryIndexCids.len ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryProjections.len:
        return false
    let binding = workspace.snapshotStore.payloadBindings[pin.payloadIndex]
    let identity = workspace.snapshotStore.payloadIdentities[pin.payloadIndex]
    let projection = workspace.snapshotStore.payloadQueryProjections[
        pin.payloadIndex]
    return projection.sourceVersion == pin.corePin.sourceVersion &&
        projection.sourceVersion == binding.sourceVersion &&
        projection.documents.len > 0 &&
        layout.FixedBytes32Equal(
            projection.projectionCid,
            workspace.snapshotStore.payloadQueryProjectionCids[
                pin.payloadIndex]) &&
        layout.FixedBytes32Equal(
            projection.queryIndex.indexCid,
            workspace.snapshotStore.payloadQueryIndexCids[
                pin.payloadIndex]) &&
        layout.FixedBytes32Equal(
            binding.workspaceSessionCid,
            projection.workspaceSessionCid) &&
        layout.FixedBytes32Equal(
            projection.bindingReceiptCid, pin.corePin.bindingReceiptCid) &&
        layout.FixedBytes32Equal(
            projection.bindingReceiptCid, binding.bindingReceiptCid) &&
        layout.FixedBytes32Equal(
            projection.sourceBundleCid, binding.sourceBundleCid) &&
        layout.FixedBytes32Equal(
            projection.sourceBundleCid, identity.sourceBundleCid) &&
        layout.FixedBytes32Equal(projection.csgRootCid, pin.factsRootCid) &&
        layout.FixedBytes32Equal(
            projection.csgRootCid, binding.csgRootCid) &&
        layout.FixedBytes32Equal(
            projection.csgRootCid, identity.csgRootCid) &&
        layout.FixedBytes32Equal(
            projection.csgRootCid,
            workspace.snapshotStore.payloadFactsRootCids[pin.payloadIndex]) &&
        projection.queryIndex.sourceVersion == projection.sourceVersion &&
        layout.FixedBytes32Equal(
            projection.queryIndex.csgRootCid, projection.csgRootCid) &&
        !layout.FixedBytes32Equal(
            workspace.snapshotStore.payloadQueryIndexCids[
                pin.payloadIndex], layout.FixedBytes32())

@borrows
fn lspPinnedSourceDocumentInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        documentCid: layout.FixedBytes32,
        out: var query_projection.SemanticSnapshotSourceDocument,
        err: var str): bool =
    if !pin.active || pin.payloadIndex < 0 ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryProjections.len ||
       workspace.snapshotStore.payloadQueryProjections[
           pin.payloadIndex].sourceVersion != pin.corePin.sourceVersion:
        err = " lsp content modified: immutable source bundle is unavailable"
        return false
    let projection = workspace.snapshotStore.payloadQueryProjections[
        pin.payloadIndex]
    var low: int32
    var high = projection.documents.len
    while low < high:
        let middle = low + (high - low) / 2
        let document = projection.documents[middle]
        if layout.FixedBytes32Equal(document.documentCid, documentCid):
            out = query_projection.SemanticSnapshotSourceDocumentOwnedClone(
                document)
            err = ""
            return true
        if lspCidLess(document.documentCid, documentCid):
            low = middle + 1
        else:
            high = middle
    panic("lsp_snapshot_fact_document_cid_not_in_source_bundle")

fn lspWorkspacePinCompilerFactsInto(
        workspace: var LspWorkspace,
        pinOut: var snapshot_production.SemanticSnapshotProductionPin,
        receiptOut: var LspExactQueryReceipt,
        err: var str): bool =
    let acceptedVersion = workspace.eventState.lastAcceptedSourceVersion
    if !workspace.initialized || acceptedVersion <= 0 ||
       workspace.snapshotStore.core.currentSourceVersion != acceptedVersion:
        err = " lsp content modified: workspace sourceVersion is not current"
        return false
    let publishedIndex = workspace.snapshotStore.core.publishedIndex
    if publishedIndex < 0 ||
       publishedIndex >= workspace.snapshotStore.core.sourceVersions.len ||
       publishedIndex >= workspace.snapshotStore.core.states.len ||
       workspace.snapshotStore.core.sourceVersions[publishedIndex] !=
           acceptedVersion ||
       workspace.snapshotStore.core.states[publishedIndex] !=
           snapshot_core.SemanticSnapshotStatePublished:
        err = " lsp content modified: exact sourceVersion is not atomically published"
        return false
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var pinErr: str
    if !snapshot_production.SemanticSnapshotProductionStorePinCurrentInto(
            workspace.snapshotStore, pin, pinErr):
        err = strutil.Join([
            " lsp content modified: exact semantic snapshot is not published:",
            pinErr], "")
        return false
    if pin.corePin.sourceVersion != acceptedVersion:
        lspWorkspaceReleasePin(workspace, pin)
        err = " lsp content modified: pinned sourceVersion changed"
        return false
    if pin.payloadIndex < 0 ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryProjections.len ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadBindings.len ||
       workspace.snapshotStore.payloadQueryProjections[
           pin.payloadIndex].sourceVersion != acceptedVersion ||
       workspace.snapshotStore.payloadQueryProjections[
           pin.payloadIndex].documents.len <= 0:
        lspWorkspaceReleasePin(workspace, pin)
        err = " lsp content modified: immutable source bundle is unavailable"
        return false
    if !layout.FixedBytes32Equal(
           workspace.eventState.eventStateReceiptCid,
           workspace.snapshotStore.payloadBindings[
               pin.payloadIndex].sourceEventStateReceiptCid):
        lspWorkspaceReleasePin(workspace, pin)
        err =
            " lsp content modified: source membership receipt is not current"
        return false
    if !lspPinnedBindingMatchesQueryProjection(workspace, pin):
        lspWorkspaceReleasePin(workspace, pin)
        panic("lsp_snapshot_immutable_source_binding_split")
    let projection = workspace.snapshotStore.payloadQueryProjections[
        pin.payloadIndex]
    let queryIndex = projection.queryIndex
    if queryIndex.sourceVersion != acceptedVersion ||
       !layout.FixedBytes32Equal(queryIndex.csgRootCid, pin.factsRootCid) ||
       layout.FixedBytes32Equal(queryIndex.indexCid, layout.FixedBytes32()) ||
       queryIndex.referenceStartsBySource.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].sources.documentCids.len ||
       queryIndex.referenceCountsBySource.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].sources.documentCids.len ||
       queryIndex.referenceRowIdsBySource.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].references.sourceIds.len ||
       queryIndex.symbolStartsBySource.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].sources.documentCids.len ||
       queryIndex.symbolCountsBySource.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].sources.documentCids.len ||
       queryIndex.symbolRowIdsBySource.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].symbols.sourceIds.len ||
       queryIndex.symbolNameSpanIds.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].symbols.symbolCids.len ||
       queryIndex.symbolNameTokenIds.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].symbols.symbolCids.len ||
       queryIndex.symbolDeclarationRowCids.len !=
           workspace.snapshotStore.payloadTables[
               pin.payloadIndex].symbols.symbolCids.len:
        lspWorkspaceReleasePin(workspace, pin)
        err = " lsp content modified: published semantic query index is unavailable"
        return false
    if pin.payloadIndex >=
           workspace.snapshotStore.payloadCompilerFactProjectionCids.len ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadCompilerFactCounts.len ||
       layout.FixedBytes32Equal(
           workspace.snapshotStore.payloadCompilerFactProjectionCids[
               pin.payloadIndex], layout.FixedBytes32()) ||
       workspace.snapshotStore.payloadCompilerFactCounts[
           pin.payloadIndex] <= 0:
        lspWorkspaceReleasePin(workspace, pin)
        panic("lsp_snapshot_compiler_fact_projection_receipt_corrupt")
    let expectedCompilerFactProjectionCid =
        facts.CompilerFactSnapshotProjectionCid(
            workspace.snapshotStore.payloadTables[
                pin.payloadIndex].predecessorReceiptCid,
            workspace.snapshotStore.payloadBindings[pin.payloadIndex],
            workspace.snapshotStore.payloadValidations[pin.payloadIndex])
    if !layout.FixedBytes32Equal(
            workspace.snapshotStore.payloadCompilerFactProjectionCids[
                pin.payloadIndex],
            expectedCompilerFactProjectionCid):
        lspWorkspaceReleasePin(workspace, pin)
        err = " lsp content modified: CompilerFact projection receipt changed"
        return false
    var receipt: LspExactQueryReceipt
    receipt.sourceVersion = pin.corePin.sourceVersion
    receipt.semanticSnapshotCid = pin.semanticSnapshotCid
    receipt.bindingReceiptCid = pin.corePin.bindingReceiptCid
    receipt.csgRootCid = pin.factsRootCid
    receipt.queryProjectionCid = projection.projectionCid
    receipt.queryIndexCid = queryIndex.indexCid
    receipt.openDocumentUniverseCid =
        projection.openDocumentUniverseCid
    receipt.declarationTableCid = pin.declarationTableCid
    receipt.compilerFactProjectionCid =
        workspace.snapshotStore.payloadCompilerFactProjectionCids[
            pin.payloadIndex]
    pinOut = pin
    receiptOut = receipt
    err = ""
    return true

fn lspWorkspaceReleasePin(
        workspace: var LspWorkspace,
        pin: var snapshot_production.SemanticSnapshotProductionPin) =
    if !pin.active || pin.payloadIndex < 0:
        panic("lsp_snapshot_pin_release_invalid")
    var releaseErr: str
    if !snapshot_production.SemanticSnapshotProductionStoreReleasePinInto(
            workspace.snapshotStore, pin, releaseErr):
        panic("lsp_snapshot_pin_release_failed")

fn lspPublishedSemanticRawReleaseInto(
        bindingRaw: var rawbytes.Bytes,
        queryProjectionRaw: var rawbytes.Bytes,
        openDocumentUniverseRaw: var rawbytes.Bytes,
        snapshotPayloadRaw: var rawbytes.Bytes) =
    rawbytes.BytesFree(bindingRaw)
    rawbytes.BytesFree(queryProjectionRaw)
    rawbytes.BytesFree(openDocumentUniverseRaw)
    rawbytes.BytesFree(snapshotPayloadRaw)

fn lspPublishedSemanticRawAbort(
        workspace: var LspWorkspace,
        pin: var snapshot_production.SemanticSnapshotProductionPin,
        bindingRaw: var rawbytes.Bytes,
        queryProjectionRaw: var rawbytes.Bytes,
        openDocumentUniverseRaw: var rawbytes.Bytes,
        snapshotPayloadRaw: var rawbytes.Bytes,
        failure: str,
        err: var str): bool =
    lspPublishedSemanticRawReleaseInto(
        bindingRaw, queryProjectionRaw,
        openDocumentUniverseRaw, snapshotPayloadRaw)
    lspWorkspaceReleasePin(workspace, pin)
    err = failure
    return false

@borrows
fn lspPublishedSemanticRawNextPathsValid(
        bindingNextPath: str,
        queryProjectionNextPath: str,
        openDocumentUniverseNextPath: str,
        snapshotPayloadNextPath: str): bool =
    return bindingNextPath.len > 1 &&
           queryProjectionNextPath.len > 1 &&
           openDocumentUniverseNextPath.len > 1 &&
           snapshotPayloadNextPath.len > 1 &&
           bindingNextPath[0] == '/' &&
           queryProjectionNextPath[0] == '/' &&
           openDocumentUniverseNextPath[0] == '/' &&
           snapshotPayloadNextPath[0] == '/' &&
           bindingNextPath != queryProjectionNextPath &&
           bindingNextPath != openDocumentUniverseNextPath &&
           bindingNextPath != snapshotPayloadNextPath &&
           queryProjectionNextPath != openDocumentUniverseNextPath &&
           queryProjectionNextPath != snapshotPayloadNextPath &&
           openDocumentUniverseNextPath != snapshotPayloadNextPath

fn LspWorkspaceWriteCurrentPublishedSemanticRawNextInto(
        workspace: var LspWorkspace,
        bindingNextPath: str,
        queryProjectionNextPath: str,
        openDocumentUniverseNextPath: str,
        snapshotPayloadNextPath: str,
        receiptOut: var LspExactQueryReceipt,
        snapshotPayloadCidOut: var layout.FixedBytes32,
        err: var str): bool =
    receiptOut = LspExactQueryReceipt()
    snapshotPayloadCidOut = layout.FixedBytes32()
    err = ""
    if !lspPublishedSemanticRawNextPathsValid(
            bindingNextPath, queryProjectionNextPath,
            openDocumentUniverseNextPath, snapshotPayloadNextPath):
        err = " lsp published semantic raw: four distinct absolute next paths required"
        return false

    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false

    var bindingRaw: rawbytes.Bytes
    var queryProjectionRaw: rawbytes.Bytes
    var openDocumentUniverseRaw: rawbytes.Bytes
    var snapshotPayloadRaw: rawbytes.Bytes
    let payloadIndex = pin.payloadIndex
    if payloadIndex < 0 ||
       payloadIndex >= workspace.snapshotStore.payloadBindings.len ||
       payloadIndex >=
           workspace.snapshotStore.payloadQueryProjections.len ||
       payloadIndex >= workspace.snapshotStore.payloadCsgcBytes.len:
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: pinned payload row unavailable",
            err)

    snapshot_core.LocalSourceVersionBindingCanonicalRawInto(
        workspace.snapshotStore.payloadBindings[payloadIndex],
        bindingRaw)
    query_projection.SemanticSnapshotQueryProjectionCanonicalRawInto(
        workspace.snapshotStore.payloadQueryProjections[payloadIndex],
        queryProjectionRaw)
    if !query_projection.SemanticSnapshotOpenDocumentUniverseCanonicalRawInto(
            workspace.snapshotStore.payloadQueryProjections[payloadIndex],
            openDocumentUniverseRaw):
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: open document universe is invalid",
            err)

    let snapshotPayloadLength = rawbytes.BytesLen(
        workspace.snapshotStore.payloadCsgcBytes[payloadIndex])
    if snapshotPayloadLength <= 0:
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: pinned snapshot payload is empty",
            err)
    snapshotPayloadRaw = rawbytes.BytesAlloc(snapshotPayloadLength)
    if snapshotPayloadRaw.data == nil ||
       rawbytes.BytesLen(snapshotPayloadRaw) != snapshotPayloadLength:
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: snapshot payload copy allocation failed",
            err)
    rawbytes.BytesCopyInto(
        snapshotPayloadRaw, 0,
        workspace.snapshotStore.payloadCsgcBytes[payloadIndex])

    if rawbytes.BytesLen(bindingRaw) <= 0 ||
       rawbytes.BytesLen(queryProjectionRaw) <= 0 ||
       rawbytes.BytesLen(openDocumentUniverseRaw) <= 0 ||
       !layout.FixedBytes32Equal(
           lsp_hash256.Sha256Fixed(
               layout.ByteSpanFromBytes(bindingRaw)),
           receipt.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           lsp_hash256.Sha256Fixed(
               layout.ByteSpanFromBytes(queryProjectionRaw)),
           receipt.queryProjectionCid) ||
       !layout.FixedBytes32Equal(
           lsp_hash256.Sha256Fixed(
               layout.ByteSpanFromBytes(openDocumentUniverseRaw)),
           receipt.openDocumentUniverseCid) ||
       !layout.FixedBytes32Equal(
           lsp_hash256.Sha256Fixed(
               layout.ByteSpanFromBytes(snapshotPayloadRaw)),
           pin.cargoCid):
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: canonical raw CID mismatch",
            err)

    let verifiedSnapshot = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        snapshotPayloadRaw, pin.factsRootCid)
    if !verifiedSnapshot.ok ||
       !layout.FixedBytes32Equal(
           verifiedSnapshot.factsRootCid, pin.factsRootCid) ||
       !layout.FixedBytes32Equal(
           verifiedSnapshot.cargoCid, pin.cargoCid):
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: snapshot CSGC verification failed",
            err)

    let bindingWrite =
        os.WriteFileBytesResult(bindingNextPath, bindingRaw)
    if IsErr(bindingWrite):
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: binding next write failed",
            err)
    let queryProjectionWrite =
        os.WriteFileBytesResult(
            queryProjectionNextPath, queryProjectionRaw)
    if IsErr(queryProjectionWrite):
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: query projection next write failed",
            err)
    let openDocumentUniverseWrite =
        os.WriteFileBytesResult(
            openDocumentUniverseNextPath, openDocumentUniverseRaw)
    if IsErr(openDocumentUniverseWrite):
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: open document universe next write failed",
            err)
    let snapshotPayloadWrite =
        os.WriteFileBytesResult(
            snapshotPayloadNextPath, snapshotPayloadRaw)
    if IsErr(snapshotPayloadWrite):
        return lspPublishedSemanticRawAbort(
            workspace, pin, bindingRaw, queryProjectionRaw,
            openDocumentUniverseRaw, snapshotPayloadRaw,
            " lsp published semantic raw: snapshot payload next write failed",
            err)

    let snapshotPayloadCid = layout.FixedBytes32Copy(pin.cargoCid)
    lspPublishedSemanticRawReleaseInto(
        bindingRaw, queryProjectionRaw,
        openDocumentUniverseRaw, snapshotPayloadRaw)
    lspWorkspaceReleasePin(workspace, pin)
    receiptOut = receipt
    snapshotPayloadCidOut = snapshotPayloadCid
    err = ""
    return true

@borrows
fn lspPinnedSymbolNameSpanIdInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        symbolId: int32,
        spanIdOut: var int32,
        err: var str): bool =
    spanIdOut = -1
    if !pin.active || pin.payloadIndex < 0 ||
       pin.payloadIndex >= workspace.snapshotStore.payloadTables.len:
        err = " lsp content modified: pinned symbol table is unavailable"
        return false
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    if pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryProjections.len:
        err = " lsp content modified: pinned query index is unavailable"
        return false
    let queryIndex = workspace.snapshotStore.payloadQueryProjections[
        pin.payloadIndex].queryIndex
    if symbolId < 0 || symbolId >= tables.symbols.sourceIds.len:
        panic("lsp_snapshot_symbol_id_out_of_range")
    var exactSymbolCid: layout.FixedBytes32
    var exactSourceId: int32
    var exactDeclarationSpanId: int32
    var exactTypeId: int32
    var exactSymbolKind: int32
    if !snapshot_production.SemanticSnapshotProductionPinnedSymbolIdentityInto(
            workspace.snapshotStore, pin, symbolId,
            exactSymbolCid, exactSourceId, exactDeclarationSpanId,
            exactTypeId, exactSymbolKind, err):
        return false
    if !layout.FixedBytes32Equal(
            exactSymbolCid, tables.symbols.symbolCids[symbolId]) ||
       exactSourceId != tables.symbols.sourceIds[symbolId] ||
       exactDeclarationSpanId !=
           tables.symbols.declarationSpanIds[symbolId] ||
       exactTypeId != tables.symbols.typeIds[symbolId] ||
       exactSymbolKind != tables.symbols.symbolKinds[symbolId]:
        panic("lsp_snapshot_symbol_identity_row_split")
    let nameSpanId = queryIndex.symbolNameSpanIds[symbolId]
    let nameTokenId = queryIndex.symbolNameTokenIds[symbolId]
    let declarationSpanId = tables.symbols.declarationSpanIds[symbolId]
    if nameSpanId < 0:
        if exactSymbolKind != snapshot_schema.CsgCompilerSymbolModule ||
           nameTokenId != -1 || declarationSpanId != -1:
            panic("lsp_snapshot_implicit_module_coordinate_split")
        spanIdOut = -1
        err = ""
        return true
    if nameTokenId < 0 || nameTokenId >= tables.tokens.sourceIds.len ||
       nameSpanId >= tables.spans.sourceIds.len ||
       declarationSpanId < 0 ||
       declarationSpanId >= tables.spans.sourceIds.len ||
       tables.symbols.nameTokenIds[symbolId] != nameTokenId ||
       tables.symbols.nameSpanIds[symbolId] != nameSpanId ||
       tables.tokens.spanIds[nameTokenId] != nameSpanId ||
       tables.tokens.sourceIds[nameTokenId] !=
           tables.symbols.sourceIds[symbolId] ||
       tables.tokens.valueTextIds[nameTokenId] !=
           tables.symbols.nameTextIds[symbolId] ||
       tables.spans.sourceIds[nameSpanId] !=
           tables.symbols.sourceIds[symbolId] ||
       tables.spans.sourceIds[declarationSpanId] !=
           tables.symbols.sourceIds[symbolId] ||
       tables.spans.startBytes[nameSpanId] <
           tables.spans.startBytes[declarationSpanId] ||
       tables.spans.endBytes[nameSpanId] >
           tables.spans.endBytes[declarationSpanId] ||
       tables.spans.startBytes[nameSpanId] >=
           tables.spans.endBytes[nameSpanId]:
        panic("lsp_snapshot_symbol_name_span_binding_split")
    spanIdOut = nameSpanId
    err = ""
    return true

@borrows
fn lspPinnedSymbolDeclarationInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        symbolId: int32,
        declIdOut: var int32,
        declKeyCidOut: var layout.FixedBytes32,
        err: var str): bool =
    declIdOut = -1
    declKeyCidOut = layout.FixedBytes32()
    var ownerDeclId: int32
    var typeExpressionCid: layout.FixedBytes32
    var nameProofCid: layout.FixedBytes32
    var declarationTableCid: layout.FixedBytes32
    if !snapshot_production.SemanticSnapshotProductionPinnedSymbolDeclarationInto(
            workspace.snapshotStore, pin, symbolId,
            declIdOut, declKeyCidOut, ownerDeclId,
            typeExpressionCid, nameProofCid, declarationTableCid, err):
        err = " lsp content modified: pinned declaration identity changed"
        return false
    if !layout.FixedBytes32Equal(
            declarationTableCid, pin.declarationTableCid) ||
       declIdOut < 0 ||
       layout.FixedBytes32Equal(declKeyCidOut, layout.FixedBytes32()):
        err = " lsp content modified: pinned declaration identity changed"
        return false
    err = ""
    return true

@borrows
fn lspPinnedSourceIdForDocumentCid(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        documentCid: layout.FixedBytes32): int32 =
    let sources =
        workspace.snapshotStore.payloadTables[pin.payloadIndex].sources
    var low: int32
    var high = sources.documentCids.len
    while low < high:
        let middle = low + (high - low) / 2
        if layout.FixedBytes32Equal(
                sources.documentCids[middle], documentCid):
            return middle
        if lspCidLess(sources.documentCids[middle], documentCid):
            low = middle + 1
        else:
            high = middle
    panic("lsp_snapshot_document_cid_not_in_source_table")

@borrows
fn lspPinnedReferenceIdentityInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        referenceId: int32,
        targetSymbolIdOut: var int32,
        ownerSymbolIdOut: var int32,
        sourceIdOut: var int32,
        spanIdOut: var int32,
        referenceKindOut: var int32,
        err: var str): bool =
    if pin.payloadIndex < 0 ||
       pin.payloadIndex >= workspace.snapshotStore.payloadTables.len:
        err = " lsp content modified: pinned reference table is unavailable"
        return false
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    if referenceId < 0 ||
       referenceId >= tables.references.targetSymbolIds.len ||
       referenceId >= tables.references.ownerSymbolIds.len ||
       referenceId >= tables.references.sourceIds.len ||
       referenceId >= tables.references.spanIds.len ||
       referenceId >= tables.references.referenceKinds.len ||
       referenceId >= tables.references.bindingTypedNodeIds.len:
        panic("lsp_snapshot_reference_id_out_of_range")
    let compilerFact = facts.CompilerFactSnapshotFillReference(
        tables, referenceId, pin.corePin.sourceVersion)
    if compilerFact.kind != facts.FactKindReference ||
       compilerFact.sourceVersion != pin.corePin.sourceVersion ||
       compilerFact.referenceFact.rowId != referenceId ||
       compilerFact.referenceFact.bindingTypedNodeId !=
           tables.references.bindingTypedNodeIds[referenceId]:
        panic("lsp_snapshot_compiler_reference_fact_projection_split")
    # A published Reference row is not itself sufficient authority for a
    # local/parameter lookup.  Replay the exact ReferenceId -> TypedNodeId ->
    # origin ParserNodeId -> source-local declaration/Pattern/value-definition
    # chain at the query boundary.  The validator consumes only snapshot-local
    # int32 indexes; names and source coordinates are never lookup keys.
    var bindingAuthorityErr: str
    if !snapshot_schema.CsgCompilerBindingReferenceTargetStrictValidateInto(
            tables, referenceId, bindingAuthorityErr):
        err = strutil.Join([
            " lsp content modified: binding reference authority changed:",
            bindingAuthorityErr], "")
        return false
    targetSymbolIdOut = compilerFact.referenceFact.targetSymbolId
    ownerSymbolIdOut = compilerFact.referenceFact.ownerSymbolId
    sourceIdOut = compilerFact.referenceFact.sourceId
    spanIdOut = compilerFact.referenceFact.spanId
    referenceKindOut = compilerFact.referenceFact.referenceKind
    if targetSymbolIdOut !=
           tables.references.targetSymbolIds[referenceId] ||
       ownerSymbolIdOut != tables.references.ownerSymbolIds[referenceId] ||
       sourceIdOut != tables.references.sourceIds[referenceId] ||
       spanIdOut != tables.references.spanIds[referenceId] ||
       referenceKindOut != tables.references.referenceKinds[referenceId] ||
       targetSymbolIdOut < 0 ||
       targetSymbolIdOut >= tables.symbols.symbolCids.len ||
       ownerSymbolIdOut < 0 ||
       ownerSymbolIdOut >= tables.symbols.symbolCids.len ||
       tables.symbols.sourceIds[ownerSymbolIdOut] != sourceIdOut ||
       !layout.FixedBytes32Equal(
           compilerFact.referenceFact.ownerSymbolCid,
           tables.symbols.symbolCids[ownerSymbolIdOut]) ||
       compilerFact.referenceFact.ownerDeclId !=
           tables.symbols.declIds[ownerSymbolIdOut] ||
       !layout.FixedBytes32Equal(
           compilerFact.referenceFact.ownerDeclKeyCid,
           tables.symbols.declKeyCids[ownerSymbolIdOut]) ||
       !layout.FixedBytes32Equal(
           compilerFact.referenceFact.targetSymbolCid,
           tables.symbols.symbolCids[targetSymbolIdOut]) ||
       compilerFact.referenceFact.targetDeclId !=
           tables.symbols.declIds[targetSymbolIdOut] ||
       !layout.FixedBytes32Equal(
           compilerFact.referenceFact.targetDeclKeyCid,
           tables.symbols.declKeyCids[targetSymbolIdOut]) ||
       !layout.FixedBytes32Equal(
           compilerFact.referenceFact.declarationTableCid,
           tables.declarations.tableCid) ||
       sourceIdOut < 0 || sourceIdOut >= tables.sources.documentCids.len ||
       spanIdOut < 0 || spanIdOut >= tables.spans.sourceIds.len ||
       tables.spans.sourceIds[spanIdOut] != sourceIdOut:
        panic("lsp_snapshot_reference_identity_row_split")
    err = ""
    return true

@borrows
fn lspPinnedSourceQueryIndexStrictValidateInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        sourceId: int32,
        expectedDocumentCid: layout.FixedBytes32,
        err: var str): bool =
    if pin.payloadIndex < 0 ||
       pin.payloadIndex >= workspace.snapshotStore.payloadTables.len ||
       pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryProjections.len:
        err = " lsp content modified: pinned query index is unavailable"
        return false
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    let index = workspace.snapshotStore.payloadQueryProjections[
        pin.payloadIndex].queryIndex
    var validationErr: str
    if !query_projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            index, tables, pin.corePin.sourceVersion,
            pin.factsRootCid, sourceId, expectedDocumentCid,
            pin.queryIndexRootCid, validationErr):
        err = strutil.Join([
            " lsp content modified: pinned source query index changed:",
            validationErr], "")
        return false
    err = ""
    return true

@borrows
fn lspFindTargetSymbolIdAtPositionInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        documentCid: layout.FixedBytes32,
        line: int32,
        column: int32,
        symbolIdOut: var int32,
        foundOut: var bool,
        err: var str): bool =
    symbolIdOut = -1
    foundOut = false
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    if pin.payloadIndex >=
           workspace.snapshotStore.payloadQueryProjections.len:
        err = " lsp content modified: pinned query index is unavailable"
        return false
    let queryIndex = workspace.snapshotStore.payloadQueryProjections[
        pin.payloadIndex].queryIndex
    let sourceId = lspPinnedSourceIdForDocumentCid(
        workspace, pin, documentCid)
    if !lspPinnedSourceQueryIndexStrictValidateInto(
            workspace, pin, sourceId, documentCid, err):
        return false
    let referenceStart = queryIndex.referenceStartsBySource[sourceId]
    let referenceCount = queryIndex.referenceCountsBySource[sourceId]
    if referenceStart < 0 || referenceCount < 0 ||
       referenceStart > queryIndex.referenceRowIdsBySource.len ||
       referenceCount >
           queryIndex.referenceRowIdsBySource.len - referenceStart:
        panic("lsp_snapshot_reference_source_csr_corrupt")
    var matchingReference = -1
    for offset in 0..<referenceCount:
        let referenceRow =
            queryIndex.referenceRowIdsBySource[referenceStart + offset]
        var targetSymbolId: int32
        var ownerSymbolId: int32
        var referenceSourceId: int32
        var referenceSpanId: int32
        var referenceKind: int32
        if !lspPinnedReferenceIdentityInto(
                workspace, pin, referenceRow,
                targetSymbolId, ownerSymbolId,
                referenceSourceId, referenceSpanId,
                referenceKind, err):
            return false
        if referenceSourceId != sourceId:
            panic("lsp_snapshot_reference_source_csr_row_corrupt")
        let spanId = referenceSpanId
        if !lspSpanContains(
                tables.spans.startLines[spanId],
                tables.spans.startColumns[spanId],
                tables.spans.endLines[spanId],
                tables.spans.endColumns[spanId],
                line, column):
            continue
        if matchingReference >= 0:
            panic("lsp_snapshot_overlapping_exact_reference_spans")
        matchingReference = targetSymbolId
    if matchingReference >= 0:
        symbolIdOut = matchingReference
        foundOut = true
        err = ""
        return true
    var matchingSymbol = -1
    let symbolStart = queryIndex.symbolStartsBySource[sourceId]
    let symbolCount = queryIndex.symbolCountsBySource[sourceId]
    if symbolStart < 0 || symbolCount < 0 ||
       symbolStart > queryIndex.symbolRowIdsBySource.len ||
       symbolCount > queryIndex.symbolRowIdsBySource.len - symbolStart:
        panic("lsp_snapshot_symbol_source_csr_corrupt")
    for offset in 0..<symbolCount:
        let symbolId = queryIndex.symbolRowIdsBySource[symbolStart + offset]
        if symbolId < 0 ||
           symbolId >= queryIndex.symbolNameSpanIds.len:
            panic("lsp_snapshot_symbol_source_csr_row_corrupt")
        var nameSpanId: int32
        if !lspPinnedSymbolNameSpanIdInto(
                workspace, pin, symbolId, nameSpanId, err):
            return false
        if tables.symbols.sourceIds[symbolId] != sourceId:
            panic("lsp_snapshot_symbol_source_csr_row_corrupt")
        if nameSpanId < 0:
            continue
        if lspSpanContains(
                tables.spans.startLines[nameSpanId],
                tables.spans.startColumns[nameSpanId],
                tables.spans.endLines[nameSpanId],
                tables.spans.endColumns[nameSpanId],
                line, column):
            if matchingSymbol >= 0:
                panic("lsp_snapshot_overlapping_symbol_name_spans")
            matchingSymbol = symbolId
    if matchingSymbol >= 0:
        symbolIdOut = matchingSymbol
        foundOut = true
    err = ""
    return true

@borrows
fn lspFindSymbolFactInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        symbolId: int32,
        symbolOut: var facts.SymbolFact,
        err: var str): bool =
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    if symbolId < 0 || symbolId >= tables.symbols.symbolCids.len:
        panic("lsp_snapshot_symbol_id_out_of_range")
    var nameSpanId: int32
    if !lspPinnedSymbolNameSpanIdInto(
            workspace, pin, symbolId, nameSpanId, err):
        return false
    let sourceId = tables.symbols.sourceIds[symbolId]
    let compilerFact = facts.CompilerFactSnapshotFillSymbol(
        tables, symbolId, pin.corePin.sourceVersion)
    if compilerFact.kind != facts.FactKindSymbol ||
       compilerFact.sourceVersion != pin.corePin.sourceVersion ||
       compilerFact.symbolFact.symbolId != symbolId ||
       compilerFact.symbolFact.sourceId != sourceId:
        panic("lsp_snapshot_compiler_symbol_fact_projection_split")
    symbolOut = compilerFact.symbolFact
    err = ""
    return true

@borrows
fn lspPinnedSymbolNavigationLocationInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        symbolId: int32,
        out: var LspExactLocation,
        err: var str): bool =
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    var nameSpanId: int32
    if !lspPinnedSymbolNameSpanIdInto(
            workspace, pin, symbolId, nameSpanId, err):
        return false
    let sourceId = tables.symbols.sourceIds[symbolId]
    let documentCid = tables.sources.documentCids[sourceId]
    if nameSpanId < 0:
        return lspLocationFromSpanInto(
            workspace, pin, documentCid, 0, 0, 0, 0, out, err)
    return lspLocationFromSpanInto(
        workspace, pin, documentCid,
        tables.spans.startLines[nameSpanId],
        tables.spans.startColumns[nameSpanId],
        tables.spans.endLines[nameSpanId],
        tables.spans.endColumns[nameSpanId],
        out, err)

@borrows
fn lspLocationFromSpanInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        documentCid: layout.FixedBytes32,
        startLine: int32,
        startColumn: int32,
        endLine: int32,
        endColumn: int32,
        out: var LspExactLocation,
        err: var str): bool =
    var document: query_projection.SemanticSnapshotSourceDocument
    if !lspPinnedSourceDocumentInto(
            workspace, pin, documentCid, document, err):
        return false
    var location: LspExactLocation
    location.uri = document.uri
    location.documentCid = documentCid
    location.startLine = startLine
    location.endLine = endLine
    if !lspSnapshotColumnToUtf16Into(
            document.text,
            startLine, startColumn, location.startColumn, err) ||
       !lspSnapshotColumnToUtf16Into(
            document.text,
            endLine, endColumn, location.endColumn, err):
        panic("lsp_snapshot_fact_span_outside_immutable_source")
    out = location
    err = ""
    return true

@borrows
fn lspLocationEqual(left: LspExactLocation,
                    right: LspExactLocation): bool =
    return layout.FixedBytes32Equal(left.documentCid, right.documentCid) &&
           left.startLine == right.startLine &&
           left.startColumn == right.startColumn &&
           left.endLine == right.endLine &&
           left.endColumn == right.endColumn

@borrows
fn lspPinnedOpenDocumentInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        uri: str,
        documentCid: layout.FixedBytes32,
        out: var query_projection.SemanticSnapshotSourceDocument,
        err: var str): bool =
    var document: query_projection.SemanticSnapshotSourceDocument
    if !lspPinnedSourceDocumentInto(
            workspace, pin, documentCid, document, err):
        return false
    let projection = workspace.snapshotStore.payloadQueryProjections[
        pin.payloadIndex]
    var sourceId: int32 = -1
    var low: int32
    var high = projection.documents.len
    while low < high:
        let middle = low + (high - low) / 2
        if lspCidLess(
                projection.documents[middle].documentCid,
                documentCid):
            low = middle + 1
        else:
            high = middle
    if low < projection.documents.len &&
       layout.FixedBytes32Equal(
           projection.documents[low].documentCid,
           documentCid):
        sourceId = low
    low = 0
    high = projection.openDocumentSourceIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if projection.openDocumentSourceIds[middle] < sourceId:
            low = middle + 1
        else:
            high = middle
    if sourceId < 0 ||
       low >= projection.openDocumentSourceIds.len ||
       projection.openDocumentSourceIds[low] != sourceId ||
       !document.open || document.uri != uri:
        err = " lsp content modified: request document is not open in pinned sourceVersion"
        return false
    out = document
    err = ""
    return true

@borrows
fn lspPinnedRequestPositionInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        uri: str,
        documentCid: layout.FixedBytes32,
        line: int32,
        utf16Column: int32,
        snapshotColumnOut: var int32,
        err: var str): bool =
    var document: query_projection.SemanticSnapshotSourceDocument
    if !lspPinnedOpenDocumentInto(
            workspace, pin, uri, documentCid, document, err):
        return false
    return lspPositionToSnapshotColumnInto(
        document.text, line, utf16Column, snapshotColumnOut, err)

@borrows
fn lspExactReferencesFromPinnedInto(
        workspace: LspWorkspace,
        pin: snapshot_production.SemanticSnapshotProductionPin,
        receipt: LspExactQueryReceipt,
        documentCid: layout.FixedBytes32,
        line: int32,
        snapshotColumn: int32,
        includeDeclaration: bool,
        out: var LspExactReferencesResult,
        err: var str): bool =
    var symbolId: int32
    var found: bool
    if !lspFindTargetSymbolIdAtPositionInto(
            workspace, pin, documentCid, line, snapshotColumn,
            symbolId, found, err):
        return false
    var result: LspExactReferencesResult
    result.receipt = receipt
    result.targetSymbolId = symbolId
    result.found = found
    var targetSymbol: facts.SymbolFact
    if found:
        if !lspFindSymbolFactInto(
                workspace, pin, symbolId, targetSymbol, err) ||
           !lspPinnedSymbolDeclarationInto(
                workspace, pin, symbolId,
                result.targetDeclId, result.targetDeclKeyCid, err):
            return false
        result.targetSymbolCid = targetSymbol.symbolCid
        if includeDeclaration:
            var declaration: LspExactLocation
            if !lspPinnedSymbolNavigationLocationInto(
                    workspace, pin, symbolId, declaration, err):
                return false
            add(result.locations, declaration)
    if found:
        let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
        var low: int32
        var high = tables.references.targetSymbolIds.len
        while low < high:
            let middle = low + (high - low) / 2
            var middleTargetSymbolId: int32
            var middleOwnerSymbolId: int32
            var middleSourceId: int32
            var middleSpanId: int32
            var middleReferenceKind: int32
            if !lspPinnedReferenceIdentityInto(
                    workspace, pin, middle,
                    middleTargetSymbolId, middleOwnerSymbolId,
                    middleSourceId, middleSpanId,
                    middleReferenceKind, err):
                return false
            if middleTargetSymbolId < symbolId:
                low = middle + 1
            else:
                high = middle
        let referenceStart = low
        high = tables.references.targetSymbolIds.len
        while low < high:
            let middle = low + (high - low) / 2
            var middleTargetSymbolId: int32
            var middleOwnerSymbolId: int32
            var middleSourceId: int32
            var middleSpanId: int32
            var middleReferenceKind: int32
            if !lspPinnedReferenceIdentityInto(
                    workspace, pin, middle,
                    middleTargetSymbolId, middleOwnerSymbolId,
                    middleSourceId, middleSpanId,
                    middleReferenceKind, err):
                return false
            if middleTargetSymbolId <= symbolId:
                low = middle + 1
            else:
                high = middle
        let referenceEnd = low
        var previousReference: LspExactLocation
        var hasPreviousReference = false
        for referenceRow in referenceStart..<referenceEnd:
            var targetSymbolId: int32
            var ownerSymbolId: int32
            var sourceId: int32
            var spanId: int32
            var referenceKind: int32
            if !lspPinnedReferenceIdentityInto(
                    workspace, pin, referenceRow,
                    targetSymbolId, ownerSymbolId,
                    sourceId, spanId, referenceKind, err):
                return false
            if targetSymbolId != symbolId:
                panic("lsp_snapshot_reference_target_binary_range_corrupt")
            var location: LspExactLocation
            if !lspLocationFromSpanInto(
                    workspace, pin,
                    tables.sources.documentCids[sourceId],
                    tables.spans.startLines[spanId],
                    tables.spans.startColumns[spanId],
                    tables.spans.endLines[spanId],
                    tables.spans.endColumns[spanId],
                    location, err):
                return false
            if includeDeclaration && result.locations.len > 0 &&
               lspLocationEqual(result.locations[0], location):
                continue
            if hasPreviousReference &&
               lspLocationsOverlap(previousReference, location):
                panic("lsp_snapshot_overlapping_reverse_reference_spans")
            if includeDeclaration && result.locations.len > 0 &&
               lspLocationsOverlap(result.locations[0], location):
                panic("lsp_snapshot_declaration_reference_span_overlap")
            previousReference = location
            hasPreviousReference = true
            add(result.locations, share(previousReference))
    out = result
    err = ""
    return true

@borrows
fn LspWorkspaceExactDefinitionInto(
        workspace: var LspWorkspace,
        uri: str,
        line: int32,
        column: int32,
        out: var LspExactDefinitionResult,
        err: var str): bool =
    out = LspExactDefinitionResult()
    let documentRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if documentRow < 0 || !workspace.documents[documentRow].open:
        err = " lsp definition: document is not open"
        return false
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false
    var snapshotColumn: int32
    if !lspPinnedRequestPositionInto(
            workspace, pin, uri, documentCid,
            line, column, snapshotColumn, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var symbolId: int32
    var found: bool
    if !lspFindTargetSymbolIdAtPositionInto(
            workspace, pin, documentCid,
            line, snapshotColumn, symbolId, found, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var result: LspExactDefinitionResult
    result.receipt = receipt
    if found:
        var symbol: facts.SymbolFact
        if !lspFindSymbolFactInto(
                workspace, pin, symbolId, symbol, err) ||
           !lspPinnedSymbolDeclarationInto(
                workspace, pin, symbolId,
                result.targetDeclId, result.targetDeclKeyCid, err) ||
           !lspPinnedSymbolNavigationLocationInto(
                workspace, pin, symbolId, result.location, err):
            lspWorkspaceReleasePin(workspace, pin)
            return false
        result.found = true
        result.targetSymbolId = symbolId
        result.targetSymbolCid = symbol.symbolCid
    lspWorkspaceReleasePin(workspace, pin)
    out = result
    err = ""
    return true

@borrows
fn LspWorkspaceExactReferencesInto(
        workspace: var LspWorkspace,
        uri: str,
        line: int32,
        column: int32,
        includeDeclaration: bool,
        out: var LspExactReferencesResult,
        err: var str): bool =
    out = LspExactReferencesResult()
    let documentRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if documentRow < 0 || !workspace.documents[documentRow].open:
        err = " lsp references: document is not open"
        return false
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false
    var snapshotColumn: int32
    if !lspPinnedRequestPositionInto(
            workspace, pin, uri, documentCid,
            line, column, snapshotColumn, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var result: LspExactReferencesResult
    if !lspExactReferencesFromPinnedInto(
            workspace, pin, receipt, documentCid,
            line, snapshotColumn, includeDeclaration, result, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    lspWorkspaceReleasePin(workspace, pin)
    out = result
    err = ""
    return true

fn lspPositionLess(
        leftLine: int32,
        leftColumn: int32,
        rightLine: int32,
        rightColumn: int32): bool =
    return leftLine < rightLine ||
           (leftLine == rightLine && leftColumn < rightColumn)

@borrows
fn lspLocationsOverlap(
        left: LspExactLocation,
        right: LspExactLocation): bool =
    if !layout.FixedBytes32Equal(left.documentCid, right.documentCid):
        return false
    let leftBeforeRight = !lspPositionLess(
        right.startLine, right.startColumn,
        left.endLine, left.endColumn)
    let rightBeforeLeft = !lspPositionLess(
        left.startLine, left.startColumn,
        right.endLine, right.endColumn)
    return !leftBeforeRight && !rightBeforeLeft

@borrows
fn LspWorkspaceExactRenameInto(
        workspace: var LspWorkspace,
        uri: str,
        line: int32,
        column: int32,
        newName: str,
        out: var LspExactRenameResult,
        err: var str): bool =
    out = LspExactRenameResult()
    if !parser_receipt.ParserRenameIdentifierStrictValidateInto(
            newName, err):
        return false
    let documentRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if documentRow < 0 || !workspace.documents[documentRow].open:
        err = " lsp rename: document is not open"
        return false
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false
    var snapshotColumn: int32
    if !lspPinnedRequestPositionInto(
            workspace, pin, uri, documentCid,
            line, column, snapshotColumn, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var references: LspExactReferencesResult
    if !lspExactReferencesFromPinnedInto(
            workspace, pin, receipt, documentCid,
            line, snapshotColumn, true, references, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    if !references.found || references.targetSymbolId < 0 ||
       references.locations.len <= 0:
        err = " lsp rename: exact SymbolId is not available at position"
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var result: LspExactRenameResult
    result.targetSymbolId = references.targetSymbolId
    result.targetSymbolCid = references.targetSymbolCid
    result.targetDeclId = references.targetDeclId
    result.targetDeclKeyCid = references.targetDeclKeyCid
    result.receipt = references.receipt
    for locationIndex in 0..<references.locations.len:
        let location = references.locations[locationIndex]
        var targetDocument: query_projection.SemanticSnapshotSourceDocument
        if !lspPinnedSourceDocumentInto(
                workspace, pin, location.documentCid,
                targetDocument, err):
            lspWorkspaceReleasePin(workspace, pin)
            return false
        var edit: LspExactRenameEdit
        edit.location = location
        edit.clientVersion = targetDocument.clientVersion
        edit.newText = parser.ParserOwnedText(newName)
        add(result.edits, edit)
    lspWorkspaceReleasePin(workspace, pin)
    out = result
    err = ""
    return true

@borrows
fn LspWorkspaceExactHoverInto(
        workspace: var LspWorkspace,
        uri: str,
        line: int32,
        column: int32,
        out: var LspExactHoverResult,
        err: var str): bool =
    out = LspExactHoverResult()
    let documentRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if documentRow < 0 || !workspace.documents[documentRow].open:
        err = " lsp hover: document is not open"
        return false
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false
    var snapshotColumn: int32
    if !lspPinnedRequestPositionInto(
            workspace, pin, uri, documentCid,
            line, column, snapshotColumn, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var symbolId: int32
    var found: bool
    if !lspFindTargetSymbolIdAtPositionInto(
            workspace, pin, documentCid,
            line, snapshotColumn, symbolId, found, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var result: LspExactHoverResult
    result.receipt = receipt
    result.targetSymbolId = symbolId
    result.found = found
    if found:
        if !lspFindSymbolFactInto(
                workspace, pin, symbolId, result.symbol, err) ||
           !lspPinnedSymbolDeclarationInto(
                workspace, pin, symbolId,
                result.targetDeclId, result.targetDeclKeyCid, err):
            lspWorkspaceReleasePin(workspace, pin)
            return false
    lspWorkspaceReleasePin(workspace, pin)
    out = result
    err = ""
    return true

@borrows
fn LspWorkspaceExactCompletionInto(
        workspace: var LspWorkspace,
        uri: str,
        line: int32,
        column: int32,
        out: var LspExactCompletionResult,
        err: var str): bool =
    out = LspExactCompletionResult()
    let documentRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if documentRow < 0 || !workspace.documents[documentRow].open:
        err = " lsp completion: document is not open"
        return false
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false
    var snapshotColumn: int32
    if !lspPinnedRequestPositionInto(
            workspace, pin, uri, documentCid,
            line, column, snapshotColumn, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    let sourceId = lspPinnedSourceIdForDocumentCid(
        workspace, pin, documentCid)
    var low: int32
    var high = tables.lexicalScopes.sourceIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if tables.lexicalScopes.sourceIds[middle] < sourceId:
            low = middle + 1
        else:
            high = middle
    let scopeStart = low
    high = tables.lexicalScopes.sourceIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if tables.lexicalScopes.sourceIds[middle] <= sourceId:
            low = middle + 1
        else:
            high = middle
    let scopeEnd = low
    var selectedScopeId: int32 = -1
    var selectedDepth: int32 = -1
    for scopeId in scopeStart..<scopeEnd:
        let spanId = tables.lexicalScopes.spanIds[scopeId]
        if spanId < 0 || spanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[spanId] != sourceId:
            lspWorkspaceReleasePin(workspace, pin)
            panic("lsp_snapshot_lexical_scope_span_corrupt")
        if !lspSpanContains(
               tables.spans.startLines[spanId],
               tables.spans.startColumns[spanId],
               tables.spans.endLines[spanId],
               tables.spans.endColumns[spanId],
               line, snapshotColumn):
            continue
        var depth: int32
        var parentScopeId = tables.lexicalScopes.parentScopeIds[scopeId]
        while parentScopeId >= 0:
            if parentScopeId >= scopeId ||
               tables.lexicalScopes.sourceIds[parentScopeId] != sourceId ||
               depth >= tables.lexicalScopes.sourceIds.len:
                lspWorkspaceReleasePin(workspace, pin)
                panic("lsp_snapshot_broken_lexical_scope_parent")
            parentScopeId =
                tables.lexicalScopes.parentScopeIds[parentScopeId]
            depth = depth + 1
        if depth > selectedDepth:
            selectedDepth = depth
            selectedScopeId = scopeId
        elif depth == selectedDepth:
            lspWorkspaceReleasePin(workspace, pin)
            panic("lsp_snapshot_innermost_lexical_scope_not_unique")
    if selectedScopeId < 0:
        err = " lsp completion: exact lexical scope is unavailable"
        lspWorkspaceReleasePin(workspace, pin)
        return false
    let scopeFact = facts.CompilerFactSnapshotFillLexicalScope(
        tables, selectedScopeId, pin.corePin.sourceVersion)
    if scopeFact.kind != facts.FactKindLexicalScope ||
       scopeFact.sourceVersion != pin.corePin.sourceVersion ||
       scopeFact.lexicalScopeFact.scopeId != selectedScopeId ||
       scopeFact.lexicalScopeFact.sourceId != sourceId ||
       scopeFact.lexicalScopeFact.visibleSymbolIds.len !=
           scopeFact.lexicalScopeFact.visibleDeclIds.len ||
       scopeFact.lexicalScopeFact.visibleSymbolIds.len !=
           scopeFact.lexicalScopeFact.visibleDeclKeyCids.len:
        lspWorkspaceReleasePin(workspace, pin)
        panic("lsp_snapshot_compiler_lexical_scope_fact_projection_split")
    let visibleCount = scopeFact.lexicalScopeFact.visibleSymbolIds.len
    var result: LspExactCompletionResult
    setLen(result.items, visibleCount)
    result.receipt = receipt
    for visibleIndex in 0..<visibleCount:
        let symbolId =
            scopeFact.lexicalScopeFact.visibleSymbolIds[visibleIndex]
        var symbol: facts.SymbolFact
        if !lspFindSymbolFactInto(
                workspace, pin, symbolId, symbol, err):
            lspWorkspaceReleasePin(workspace, pin)
            return false
        var item: LspExactCompletionItem
        item.symbolId = symbol.symbolId
        item.symbolCid = symbol.symbolCid
        if !lspPinnedSymbolDeclarationInto(
                workspace, pin, symbolId,
                item.declId, item.declKeyCid, err):
            lspWorkspaceReleasePin(workspace, pin)
            return false
        if item.declId !=
               scopeFact.lexicalScopeFact.visibleDeclIds[visibleIndex] ||
           !layout.FixedBytes32Equal(
               item.declKeyCid,
               scopeFact.lexicalScopeFact.visibleDeclKeyCids[
                   visibleIndex]):
            lspWorkspaceReleasePin(workspace, pin)
            panic("lsp_snapshot_lexical_scope_declaration_projection_split")
        item.documentCid = symbol.documentCid
        item.name = symbol.name
        item.modulePath = symbol.modulePath
        item.typeText = symbol.typeText
        item.kind = symbol.kind
        item.visibility = symbol.visibility
        result.items[visibleIndex] = item
    lspWorkspaceReleasePin(workspace, pin)
    out = result
    err = ""
    return true

fn lspDiagnosticSeverityInto(
        compilerSeverity: int32,
        severityOut: var int32,
        err: var str): bool =
    if compilerSeverity < int32(lsp.DsError) ||
       compilerSeverity > int32(lsp.DsHint):
        err = " lsp diagnostics: unknown compiler severity"
        return false
    severityOut = compilerSeverity
    err = ""
    return true

fn lspWorkspaceCurrentVersionRejected(workspace: LspWorkspace): bool =
    let count = workspace.snapshotStore.core.states.len
    if count <= 0:
        return false
    let row = count - 1
    return workspace.snapshotStore.core.sourceVersions[row] ==
               workspace.snapshotStore.core.currentSourceVersion &&
           workspace.snapshotStore.core.states[row] ==
               snapshot_core.SemanticSnapshotStateRejected

fn lspWorkspaceRejectedDiagnosticsInto(
        workspace: var LspWorkspace,
        documentRow: int32,
        out: var LspExactDiagnosticsResult,
        err: var str): bool =
    var rejected: snapshot_production.SemanticSnapshotProductionRejectedDiagnostics
    if !snapshot_production.SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
            workspace.snapshotStore, rejected, err):
        return false
    var rejectedReleaseReceipt: snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseReceipt
    if rejected.sourceVersion !=
           workspace.eventState.lastAcceptedSourceVersion ||
       rejected.sourceVersion !=
           workspace.snapshotStore.core.currentSourceVersion:
        err = " lsp content modified: rejected sourceVersion changed"
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            rejected.facts, rejectedReleaseReceipt)
        return false
    let documentCid = workspace.documents[documentRow].documentCid
    var sourceId: int32 = -1
    for candidateId in 0..<rejected.facts.sourceDocumentCids.len:
        if layout.FixedBytes32Equal(
               rejected.facts.sourceDocumentCids[candidateId], documentCid):
            sourceId = candidateId
    if sourceId < 0 || sourceId >= rejected.facts.diagnosticSourceIds.len ||
       rejected.facts.diagnosticSourceIds[sourceId] != sourceId:
        err = " lsp diagnostics: rejected source identity missing"
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            rejected.facts, rejectedReleaseReceipt)
        return false
    if !lspRejectedSourceBytesMatchFacts(
            workspace, rejected, documentRow, sourceId, err):
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            rejected.facts, rejectedReleaseReceipt)
        return false
    var result: LspExactDiagnosticsResult
    result.receipt.sourceVersion = rejected.sourceVersion
    result.receipt.semanticSnapshotCid = rejected.semanticSnapshotCid
    result.receipt.bindingReceiptCid = rejected.bindingReceiptCid
    result.receipt.csgRootCid = rejected.factsRootCid
    result.receipt.rejected = true
    result.receipt.failureDiagnosticRootCid =
        rejected.diagnosticRootCid
    result.receipt.failureCargoCid = rejected.cargoCid
    result.receipt.failureAdmissionReceiptCid =
        rejected.facts.admissionReceiptCid
    result.receipt.failureParserDiagnosticAuthorityRootCid =
        rejected.facts.structuredDiagnosticAuthority.authorityRootCid
    var diagnostic: LspExactDiagnostic
    diagnostic.diagnosticId = sourceId
    diagnostic.spanId = sourceId
    diagnostic.location.uri = workspace.documents[documentRow].uri
    diagnostic.location.documentCid = documentCid
    diagnostic.location.startLine =
        rejected.facts.diagnosticStartLines[sourceId]
    diagnostic.location.endLine =
        rejected.facts.diagnosticEndLines[sourceId]
    if !lspSnapshotColumnToUtf16Into(
            workspace.documents[documentRow].sourceText,
            diagnostic.location.startLine,
            rejected.facts.diagnosticStartColumns[sourceId],
            diagnostic.location.startColumn, err) ||
       !lspSnapshotColumnToUtf16Into(
            workspace.documents[documentRow].sourceText,
            diagnostic.location.endLine,
            rejected.facts.diagnosticEndColumns[sourceId],
            diagnostic.location.endColumn, err):
        err = " lsp diagnostics: rejected span is outside immutable source"
        snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
            rejected.facts, rejectedReleaseReceipt)
        return false
    diagnostic.producerKind =
        rejected.facts.diagnosticProducerKinds[sourceId]
    diagnostic.severity = rejected.facts.diagnosticSeverities[sourceId]
    diagnostic.code = rejected.facts.diagnosticCodes[sourceId]
    diagnostic.message = rejected.facts.diagnosticMessages[sourceId]
    add(result.items, diagnostic)
    snapshot_cargo.CsgCompilerSnapshotFailureFactsReleaseInto(
        rejected.facts, rejectedReleaseReceipt)
    out = result
    err = ""
    return true

fn lspRejectedSourceBytesMatchFacts(
        workspace: LspWorkspace,
        rejected:
            snapshot_production.SemanticSnapshotProductionRejectedDiagnostics,
        documentRow: int32,
        sourceId: int32,
        err: var str): bool =
    if documentRow < 0 || documentRow >= workspace.documents.len ||
       sourceId < 0 ||
       sourceId >= rejected.facts.sourceDocumentCids.len ||
       sourceId >= rejected.facts.sourceContentPresent.len ||
       sourceId >= rejected.facts.sourceContentCids.len ||
       !rejected.facts.sourceContentPresent[sourceId] ||
       !layout.FixedBytes32Equal(
            rejected.facts.sourceDocumentCids[sourceId],
            workspace.documents[documentRow].documentCid) ||
       !layout.FixedBytes32Equal(
            rejected.facts.sourceContentCids[sourceId],
            workspace.documents[documentRow].sourceContentCid) ||
       !layout.FixedBytes32Equal(
            snapshot_schema.CsgCompilerSourceContentCid(
                workspace.documents[documentRow].sourceText),
            rejected.facts.sourceContentCids[sourceId]):
        err = " lsp content modified: rejected immutable source bytes changed"
        return false
    err = ""
    return true

@borrows
fn LspWorkspaceExactDiagnosticsInto(
        workspace: var LspWorkspace,
        uri: str,
        out: var LspExactDiagnosticsResult,
        err: var str): bool =
    out = LspExactDiagnosticsResult()
    let documentRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if documentRow < 0 || !workspace.documents[documentRow].open:
        err = " lsp diagnostics: document is not open"
        return false
    if lspWorkspaceCurrentVersionRejected(workspace):
        return lspWorkspaceRejectedDiagnosticsInto(
            workspace, documentRow, out, err)
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false
    var pinnedDocument: query_projection.SemanticSnapshotSourceDocument
    if !lspPinnedOpenDocumentInto(
            workspace, pin, uri, documentCid, pinnedDocument, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    let tables = workspace.snapshotStore.payloadTables[pin.payloadIndex]
    let sourceId = lspPinnedSourceIdForDocumentCid(
        workspace, pin, documentCid)
    var low: int32
    var high = tables.diagnostics.sourceIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if tables.diagnostics.sourceIds[middle] < sourceId:
            low = middle + 1
        else:
            high = middle
    let diagnosticStart = low
    high = tables.diagnostics.sourceIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if tables.diagnostics.sourceIds[middle] <= sourceId:
            low = middle + 1
        else:
            high = middle
    let diagnosticEnd = low
    var result: LspExactDiagnosticsResult
    result.receipt = receipt
    for diagnosticRow in diagnosticStart..<diagnosticEnd:
        let compilerFact = facts.CompilerFactSnapshotFillDiagnostic(
            tables, diagnosticRow, pin.corePin.sourceVersion)
        if compilerFact.kind != facts.FactKindParseDiagnostic ||
           compilerFact.sourceVersion != pin.corePin.sourceVersion ||
           compilerFact.parseDiagnosticFact.sourceId != sourceId ||
           tables.diagnostics.sourceIds[diagnosticRow] != sourceId:
            lspWorkspaceReleasePin(workspace, pin)
            panic("lsp_snapshot_compiler_diagnostic_fact_projection_split")
        let diagnosticFact = compilerFact.parseDiagnosticFact
        let spanId = diagnosticFact.spanId
        if spanId < 0 || spanId >= tables.spans.sourceIds.len ||
           tables.spans.sourceIds[spanId] != sourceId:
            lspWorkspaceReleasePin(workspace, pin)
            panic("lsp_snapshot_diagnostic_span_corrupt")
        let producerKind = diagnosticFact.producerKind
        if producerKind < snapshot_schema.CsgCompilerDiagnosticParser ||
           producerKind > snapshot_schema.CsgCompilerDiagnosticLayout:
            lspWorkspaceReleasePin(workspace, pin)
            panic("lsp_snapshot_diagnostic_producer_kind_corrupt")
        var diagnostic: LspExactDiagnostic
        diagnostic.diagnosticId = diagnosticRow
        diagnostic.spanId = spanId
        if !lspLocationFromSpanInto(
                workspace, pin, documentCid,
                diagnosticFact.startLine,
                diagnosticFact.startColumn,
                diagnosticFact.endLine,
                diagnosticFact.endColumn,
                diagnostic.location, err) ||
           !lspDiagnosticSeverityInto(
                diagnosticFact.severity,
                diagnostic.severity, err):
            lspWorkspaceReleasePin(workspace, pin)
            return false
        diagnostic.code = diagnosticFact.codeText
        diagnostic.message = diagnosticFact.message
        diagnostic.producerKind = producerKind
        add(result.items, diagnostic)
    lspWorkspaceReleasePin(workspace, pin)
    out = result
    err = ""
    return true

fn lspExactLineMapFromPinnedTablesInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        queryIndex: query_projection.SemanticSnapshotQueryIndex,
        sourcePath: str,
        sourceModulePath: str,
        sourceId: int32,
        documentCid: layout.FixedBytes32,
        debugProjectionCid: layout.FixedBytes32,
        receipt: LspExactQueryReceipt,
        out: var LspExactLineMapResult,
        err: var str): bool =
    out = LspExactLineMapResult()
    if sourcePath == "" ||
       sourceModulePath == "" ||
       sourceId < 0 || sourceId >= tables.sources.documentCids.len ||
       sourceId >= tables.sources.modulePathTextIds.len ||
       sourceId >= queryIndex.symbolStartsBySource.len ||
       sourceId >= queryIndex.symbolCountsBySource.len ||
       tables.sources.modulePathTextIds[sourceId] < 0 ||
       tables.sources.modulePathTextIds[sourceId] >= tables.texts.len ||
       tables.texts[
           tables.sources.modulePathTextIds[sourceId]] != sourceModulePath ||
       layout.FixedBytes32Equal(documentCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           debugProjectionCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           tables.sources.documentCids[sourceId], documentCid) ||
       !layout.FixedBytes32Equal(
           queryIndex.csgRootCid, receipt.csgRootCid) ||
       !layout.FixedBytes32Equal(
           queryIndex.declarationTableCid,
           receipt.declarationTableCid):
        err = " lsp lineMap: pinned debug projection identity mismatch"
        return false
    var result: LspExactLineMapResult
    result.sourcePath = sourcePath
    result.documentCid = documentCid
    result.debugProjectionCid = debugProjectionCid
    result.receipt = receipt
    let symbolStart = queryIndex.symbolStartsBySource[sourceId]
    let symbolCount = queryIndex.symbolCountsBySource[sourceId]
    if symbolStart < 0 || symbolCount < 0 ||
       symbolStart >
           queryIndex.symbolRowIdsBySource.len - symbolCount:
        panic("lsp_line_map_source_symbol_index_corrupt")
    for symbolOffset in 0..<symbolCount:
        let symbolId =
            queryIndex.symbolRowIdsBySource[
                symbolStart + symbolOffset]
        if symbolId < 0 ||
           symbolId >= tables.symbols.symbolCids.len ||
           tables.symbols.sourceIds[symbolId] != sourceId:
            panic("lsp_line_map_source_symbol_identity_corrupt")
        if tables.symbols.symbolKinds[symbolId] !=
               snapshot_schema.CsgCompilerSymbolFunction:
            continue
        let functionId = tables.symbols.functionIds[symbolId]
        var functionFact: debug_facts.DebugFunctionFact
        if !debug_facts.DebugFunctionFactFromSemanticSnapshotInto(
                tables, functionId, functionFact, err):
            return false
        if functionFact.functionId < 0 ||
           functionFact.functionId >= tables.functions.symbolIds.len ||
           functionFact.symbolId != symbolId ||
           functionFact.sourceId != sourceId ||
           !layout.FixedBytes32Equal(
               functionFact.documentCid, documentCid) ||
           functionFact.modulePath != sourceModulePath ||
           functionFact.functionName == "":
            panic("lsp_line_map_function_identity_corrupt")
        add(result.functions, functionFact)
    for functionIndex in 0..<result.functions.len:
        let functionFact = result.functions[functionIndex]
        let functionId = functionFact.functionId
        let nodeStart = tables.functions.nodeStarts[functionId]
        let nodeCount = tables.functions.nodeCounts[functionId]
        if nodeStart < 0 || nodeCount < 0 ||
           nodeStart > tables.typedNodes.functionIds.len - nodeCount:
            panic("lsp_line_map_function_node_range_corrupt")
        let nodeEnd = nodeStart + nodeCount
        var low: int32
        var high = tables.debugOps.typedNodeIds.len
        while low < high:
            let middle = low + (high - low) / 2
            if tables.debugOps.typedNodeIds[middle] < nodeStart:
                low = middle + 1
            else:
                high = middle
        let debugStart = low
        high = tables.debugOps.typedNodeIds.len
        while low < high:
            let middle = low + (high - low) / 2
            if tables.debugOps.typedNodeIds[middle] < nodeEnd:
                low = middle + 1
            else:
                high = middle
        let debugEnd = low
        for debugOpId in debugStart..<debugEnd:
            var operation: debug_facts.DebugOperationFact
            if !debug_facts.DebugOperationFactFromSemanticSnapshotInto(
                    tables, debugOpId, operation, err):
                return false
            if operation.functionId != functionId ||
               operation.sourceId != sourceId ||
               !layout.FixedBytes32Equal(
                   operation.documentCid, documentCid) ||
               operation.modulePath != sourceModulePath:
                panic("lsp_line_map_operation_function_identity_corrupt")
            if operation.functionDeclId != functionFact.declId ||
               operation.functionSymbolId != functionFact.symbolId ||
               !layout.FixedBytes32Equal(
                   operation.functionDeclKeyCid,
                   functionFact.declKeyCid) ||
               !layout.FixedBytes32Equal(
                   operation.functionSymbolCid,
                   functionFact.symbolCid) ||
               operation.modulePath != functionFact.modulePath:
                panic("lsp_line_map_operation_identity_split")
            if operation.syntheticOriginKind == 0:
                if operation.originParserNodeId < 0 ||
                   operation.spanAuthorityKind != 1 ||
                   operation.spanId < 0:
                    panic("lsp_line_map_location_span_identity_corrupt")
                add(result.locations, operation)
            else:
                if operation.originParserNodeId != -1 ||
                   operation.spanAuthorityKind != 2 ||
                   operation.spanId != -1:
                    panic("lsp_line_map_synthetic_identity_corrupt")
                add(result.syntheticLocations, operation)
    if result.functions.len <= 0:
        err = " lsp lineMap: pinned debug projection has no function for requested document"
        return false
    if result.locations.len + result.syntheticLocations.len <= 0:
        err = " lsp lineMap: pinned debug projection has no location for requested document"
        return false
    out = result
    err = ""
    return true

fn LspWorkspaceExactLineMapInto(
        workspace: var LspWorkspace,
        uri: str,
        out: var LspExactLineMapResult,
        err: var str): bool =
    out = LspExactLineMapResult()
    let documentRow = lspWorkspaceFindDocumentByUri(workspace, uri)
    if documentRow < 0 || !workspace.documents[documentRow].open:
        err = " lsp lineMap: document is not open"
        return false
    var sourcePath: str
    if !lspFileUriCanonicalPathInto(uri, sourcePath, err):
        return false
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: LspExactQueryReceipt
    if !lspWorkspacePinCompilerFactsInto(
            workspace, pin, receipt, err):
        return false
    var pinnedDocument: query_projection.SemanticSnapshotSourceDocument
    if !lspPinnedOpenDocumentInto(
            workspace, pin, uri, documentCid, pinnedDocument, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    var pinnedSourcePath: str
    if !lspFileUriCanonicalPathInto(
            pinnedDocument.uri, pinnedSourcePath, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    if pinnedSourcePath != sourcePath:
        lspWorkspaceReleasePin(workspace, pin)
        panic("lsp_line_map_pinned_source_path_split")
    let tables =
        workspace.snapshotStore.payloadTables[pin.payloadIndex]
    let queryIndex =
        workspace.snapshotStore.payloadQueryProjections[
            pin.payloadIndex].queryIndex
    let sourceId = lspPinnedSourceIdForDocumentCid(
        workspace, pin, documentCid)
    let sourceModulePathTextId =
        tables.sources.modulePathTextIds[sourceId]
    if sourceModulePathTextId < 0 ||
       sourceModulePathTextId >= tables.texts.len:
        lspWorkspaceReleasePin(workspace, pin)
        panic("lsp_line_map_source_module_identity_corrupt")
    let sourceModulePath = tables.texts[sourceModulePathTextId]
    let debugProjectionCid =
        workspace.snapshotStore.payloadDebugFactProjectionCids[
            pin.payloadIndex]
    var result: LspExactLineMapResult
    if !lspExactLineMapFromPinnedTablesInto(
            tables, queryIndex, sourcePath, sourceModulePath,
            sourceId, documentCid,
            debugProjectionCid, receipt, result, err):
        lspWorkspaceReleasePin(workspace, pin)
        return false
    if workspace.eventState.lastAcceptedSourceVersion !=
           pin.corePin.sourceVersion ||
       workspace.snapshotStore.core.currentSourceVersion !=
           pin.corePin.sourceVersion ||
       workspace.snapshotStore.core.publishedIndex !=
           pin.corePin.snapshotIndex:
        lspWorkspaceReleasePin(workspace, pin)
        err = " lsp content modified: lineMap sourceVersion changed"
        return false
    lspWorkspaceReleasePin(workspace, pin)
    out = result
    err = ""
    return true

# === Handlers ===

fn LspHandleInitialize(id: json.JsonNode, params: json.JsonNode) =
    let _ = params
    if gInitialized:
        LspWriteMessage(json.Stringify(LspMakeError(id, int32(lsp.ServerNotInitialized),
                                                     "server already initialized")))
        return
    gInitialized = true

    var result: json.JsonNode = json.NewJObject()
    var caps: json.JsonNode = json.NewJObject()
    caps["textDocumentSync"] = json.NewJInt(int64(2))
    caps["hoverProvider"] = json.NewJBool(true)
    caps["definitionProvider"] = json.NewJBool(true)
    caps["referencesProvider"] = json.NewJBool(true)
    caps["documentSymbolProvider"] = json.NewJBool(false)
    caps["workspaceSymbolProvider"] = json.NewJBool(false)
    caps["renameProvider"] = json.NewJBool(true)
    caps["foldingRangeProvider"] = json.NewJBool(false)
    caps["documentFormattingProvider"] = json.NewJBool(false)
    caps["typeDefinitionProvider"] = json.NewJBool(false)

    var completionOptions: json.JsonNode = json.NewJObject()
    completionOptions["resolveProvider"] = json.NewJBool(false)
    caps["completionProvider"] = completionOptions

    var diagnosticOptions: json.JsonNode = json.NewJObject()
    diagnosticOptions["identifier"] = "cheng"
    diagnosticOptions["interFileDependencies"] = json.NewJBool(true)
    diagnosticOptions["workspaceDiagnostics"] = json.NewJBool(false)
    caps["diagnosticProvider"] = diagnosticOptions

    result["capabilities"] = caps

    var serverInfo: json.JsonNode = json.NewJObject()
    serverInfo["name"] = "cheng-lsp"
    serverInfo["version"] = "0.1.0"
    result["serverInfo"] = serverInfo

    LspWriteMessage(json.Stringify(LspMakeResponse(id, result)))
    LspLog("initialized")

fn LspHandleShutdown(id: json.JsonNode) =
    gShutdownRequested = true
    LspWriteMessage(json.Stringify(LspMakeResponse(id, json.NewJNull())))
    LspLog("shutdown requested")

fn LspWorkspaceReleaseInto(
        workspace: var LspWorkspace,
        err: var str): bool =
    if !workspace.initialized:
        workspace = LspWorkspace()
        err = ""
        return true
    if !snapshot_production.SemanticSnapshotProductionStoreReleaseInto(
            workspace.snapshotStore, err):
        return false
    workspace = LspWorkspace()
    err = ""
    return true

fn lspReleaseWorkspace() =
    var err: str
    if !LspWorkspaceReleaseInto(gWorkspace, err):
        panic(Fmt"lsp_workspace_release_failed {err}")

fn LspHandleExit() =
    LspLog("exiting")
    gExitRequested = true

fn LspHandleCancelRequest(params: json.JsonNode) =
    var id = json.JsonGetField(params, "id")
    var err: str
    if !lspCandidateSchedulerCancelRequestInto(
           gWorkspace, id, err):
        LspLog(err)

fn LspHandleSnapshotBarrier(
        id: json.JsonNode,
        params: json.JsonNode) =
    let sourceVersionNode =
        json.JsonGetField(params, "sourceVersion")
    if sourceVersionNode.kind != json.JInt:
        LspWriteMessage(json.Stringify(
            LspMakeError(
                id, int32(lsp.InvalidParams),
                "snapshotBarrier requires integer sourceVersion")))
        return
    let sourceVersion =
        json.GetInt64(sourceVersionNode, int64(-1))
    var requestId = id
    var err: str
    if lspCandidateSchedulerRegisterBarrierInto(
           requestId, sourceVersion, err):
        return
    if sourceVersion ==
           gWorkspace.snapshotStore.core.currentSourceVersion &&
       lspWorkspaceCurrentSourceVersionTerminal(gWorkspace):
        let snapshotIndex =
            gWorkspace.snapshotStore.core.states.len - 1
        let published =
            gWorkspace.snapshotStore.core.states[snapshotIndex] ==
                snapshot_core.SemanticSnapshotStatePublished
        var result = json.NewJObject()
        result["sourceVersion"] =
            json.NewJInt(sourceVersion)
        result["jobCid"] =
            layout.FixedBytes32Hex(layout.FixedBytes32())
        result["completionAuthorityCid"] =
            layout.FixedBytes32Hex(layout.FixedBytes32())
        result["published"] = json.NewJBool(published)
        result["terminal"] = json.NewJBool(true)
        LspWriteMessage(json.Stringify(
            LspMakeResponse(requestId, result)))
        return
    LspWriteMessage(json.Stringify(
        LspMakeError(
            requestId, int32(lsp.ContentModified), err)))

fn LspHandleConfigureCompilerSource(params: json.JsonNode) =
    let uri = json.GetStr(json.JsonGetField(params, "uri"))
    let workspaceRoot = json.GetStr(
        json.JsonGetField(params, "workspaceRoot"))
    let packageRoot = json.GetStr(
        json.JsonGetField(params, "packageRoot"))
    let packageId = json.GetStr(json.JsonGetField(params, "packageId"))
    let targetTriple = json.GetStr(
        json.JsonGetField(params, "targetTriple"))
    let sourcePath = json.GetStr(
        json.JsonGetField(params, "sourcePath"))
    let modulePath = json.GetStr(
        json.JsonGetField(params, "modulePath"))
    let entrySource = json.GetBool(
        json.JsonGetField(params, "entry"), false)
    let compilerBindingPresent = workspaceRoot != "" || packageRoot != "" ||
        packageId != "" || targetTriple != "" || sourcePath != "" ||
        modulePath != ""
    var err: str
    if !compilerBindingPresent:
        LspLog("configureCompilerSource rejected: compiler identity is required")
        return
    let accepted = LspWorkspaceBindDocumentCompilerIdentityInto(
        gWorkspace,
        uri,
        workspaceRoot,
        packageRoot,
        packageId,
        targetTriple,
        sourcePath,
        modulePath,
        entrySource,
        err)
    if !accepted:
        LspLog(strutil.Join(["configureCompilerSource rejected:", err], ""))

fn LspHandleDidOpen(params: json.JsonNode) =
    let textDocument: json.JsonNode = params["textDocument"]
    let uri: str = json.GetStr(textDocument["uri"])
    let text: str = json.GetStr(textDocument["text"])
    let version: int64 = json.GetInt64(textDocument["version"], -1)
    var sourceVersion: int64
    var err: str
    if !LspWorkspaceDidOpenInto(
            gWorkspace, uri, version, text, sourceVersion, err):
        LspLog(strutil.Join(["didOpen rejected:", err], ""))

fn LspHandleDidChange(params: json.JsonNode) =
    let textDocument: json.JsonNode = params["textDocument"]
    let uri: str = json.GetStr(textDocument["uri"])
    let version: int64 = json.GetInt64(textDocument["version"], -1)
    let contentChanges: json.JsonNode = params["contentChanges"]
    var changes: LspContentChange[]
    var parseErr: str
    if contentChanges.kind == json.JArray:
        for index in 0..<contentChanges.a.len:
            let rawChange = contentChanges.a[index]
            if rawChange.kind != json.JObject:
                LspLog("didChange rejected: content change object is required")
                return
            let rawText = json.JsonGetField(rawChange, "text")
            if rawText.kind != json.JString:
                LspLog("didChange rejected: content change text is required")
                return
            let rawRange = json.JsonGetField(rawChange, "range")
            var change: LspContentChange
            change.text = json.GetStr(rawText)
            if rawRange.kind == json.JObject:
                let rawStart = json.JsonGetField(rawRange, "start")
                let rawEnd = json.JsonGetField(rawRange, "end")
                if rawStart.kind != json.JObject ||
                   rawEnd.kind != json.JObject:
                    LspLog("didChange rejected: range endpoints are required")
                    return
                change.rangePresent = true
                if !lspJsonNonNegativeInt32Into(
                        json.JsonGetField(rawStart, "line"),
                        "range.start.line", change.startLine, parseErr) ||
                   !lspJsonNonNegativeInt32Into(
                        json.JsonGetField(rawStart, "character"),
                        "range.start.character", change.startCharacter,
                        parseErr) ||
                   !lspJsonNonNegativeInt32Into(
                        json.JsonGetField(rawEnd, "line"),
                        "range.end.line", change.endLine, parseErr) ||
                   !lspJsonNonNegativeInt32Into(
                        json.JsonGetField(rawEnd, "character"),
                        "range.end.character", change.endCharacter,
                        parseErr):
                    LspLog(strutil.Join(["didChange rejected:", parseErr], ""))
                    return
            elif rawRange.kind != json.JNull:
                LspLog("didChange rejected: range must be an object")
                return
            let rawRangeLength = json.JsonGetField(rawChange, "rangeLength")
            if rawRangeLength.kind == json.JInt:
                change.rangeLengthPresent = true
                if !lspJsonNonNegativeInt32Into(
                        rawRangeLength, "rangeLength",
                        change.rangeLength, parseErr):
                    LspLog(strutil.Join(["didChange rejected:", parseErr], ""))
                    return
            elif rawRangeLength.kind != json.JNull:
                LspLog("didChange rejected: rangeLength must be an integer")
                return
            add(changes, change)
    var sourceVersion: int64
    var err: str
    if !LspWorkspaceDidChangeInto(
            gWorkspace, uri, version, changes, sourceVersion, err):
        LspLog(strutil.Join(["didChange rejected:", err], ""))

fn LspHandleDidClose(params: json.JsonNode) =
    let textDocument: json.JsonNode = params["textDocument"]
    let uri: str = json.GetStr(textDocument["uri"])
    var sourceVersion: int64
    var err: str
    if !LspWorkspaceDidCloseInto(
            gWorkspace, uri, sourceVersion, err):
        LspLog(strutil.Join(["didClose rejected:", err], ""))

fn LspHandleDidCreateFiles(params: json.JsonNode) =
    let files = json.JsonGetField(params, "files")
    if files.kind != json.JArray || files.a.len <= 0:
        LspLog("didCreateFiles rejected: non-empty files array is required")
        return
    for index in 0..<files.a.len:
        let file = files.a[index]
        let uriNode = json.JsonGetField(file, "uri")
        if file.kind != json.JObject || uriNode.kind != json.JString:
            LspLog("didCreateFiles rejected: file URI is required")
            return
        var sourceVersion: int64
        var err: str
        if !LspWorkspaceDidCreateFileInto(
                gWorkspace, json.GetStr(uriNode),
                sourceVersion, err):
            LspLog(strutil.Join(["didCreateFiles rejected:", err], ""))
            return

fn LspHandleDidDeleteFiles(params: json.JsonNode) =
    let files = json.JsonGetField(params, "files")
    if files.kind != json.JArray || files.a.len <= 0:
        LspLog("didDeleteFiles rejected: non-empty files array is required")
        return
    for index in 0..<files.a.len:
        let file = files.a[index]
        let uriNode = json.JsonGetField(file, "uri")
        if file.kind != json.JObject || uriNode.kind != json.JString:
            LspLog("didDeleteFiles rejected: file URI is required")
            return
        var sourceVersion: int64
        var err: str
        if !LspWorkspaceDidDeleteFileInto(
                gWorkspace, json.GetStr(uriNode),
                sourceVersion, err):
            LspLog(strutil.Join(["didDeleteFiles rejected:", err], ""))
            return

fn LspHandleDidRenameFiles(params: json.JsonNode) =
    let files = json.JsonGetField(params, "files")
    if files.kind != json.JArray || files.a.len <= 0:
        LspLog("didRenameFiles rejected: non-empty files array is required")
        return
    for index in 0..<files.a.len:
        let file = files.a[index]
        let oldUriNode = json.JsonGetField(file, "oldUri")
        let newUriNode = json.JsonGetField(file, "newUri")
        if file.kind != json.JObject ||
           oldUriNode.kind != json.JString ||
           newUriNode.kind != json.JString:
            LspLog("didRenameFiles rejected: oldUri/newUri are required")
            return
        var sourceVersion: int64
        var err: str
        if !LspWorkspaceDidRenameFileInto(
                gWorkspace, json.GetStr(oldUriNode),
                json.GetStr(newUriNode), sourceVersion, err):
            LspLog(strutil.Join(["didRenameFiles rejected:", err], ""))
            return

fn lspWriteExactQueryError(id: json.JsonNode, message: str) =
    var code: int32 = int32(lsp.InternalError)
    if strings.StrContains(message, "content modified"):
        code = int32(lsp.ContentModified)
    elif strings.StrContains(message, " lsp request:") ||
         strings.StrContains(message, " lsp text:") ||
         strings.StrContains(message, "parser receipt rename:") ||
         strings.StrContains(message, "exact SymbolId is not available"):
        code = int32(lsp.InvalidParams)
    LspWriteMessage(json.Stringify(LspMakeError(id, code, message)))

fn lspAddExactReceipt(
        out: var json.JsonNode,
        receipt: LspExactQueryReceipt) =
    out["chengSourceVersion"] = json.NewJInt(receipt.sourceVersion)
    out["chengSemanticSnapshotCid"] =
        layout.FixedBytes32Hex(receipt.semanticSnapshotCid)
    out["chengBindingReceiptCid"] =
        layout.FixedBytes32Hex(receipt.bindingReceiptCid)
    out["chengCsgRootCid"] = layout.FixedBytes32Hex(receipt.csgRootCid)
    out["chengQueryProjectionCid"] =
        layout.FixedBytes32Hex(receipt.queryProjectionCid)
    out["chengQueryIndexCid"] =
        layout.FixedBytes32Hex(receipt.queryIndexCid)
    out["chengOpenDocumentUniverseCid"] =
        layout.FixedBytes32Hex(receipt.openDocumentUniverseCid)
    out["chengDeclarationTableCid"] =
        layout.FixedBytes32Hex(receipt.declarationTableCid)
    out["chengCompilerFactProjectionCid"] =
        layout.FixedBytes32Hex(receipt.compilerFactProjectionCid)
    out["chengSnapshotRejected"] = json.NewJBool(receipt.rejected)
    out["chengFailureDiagnosticRootCid"] =
        layout.FixedBytes32Hex(receipt.failureDiagnosticRootCid)
    out["chengFailureCargoCid"] =
        layout.FixedBytes32Hex(receipt.failureCargoCid)
    out["chengFailureAdmissionReceiptCid"] =
        layout.FixedBytes32Hex(receipt.failureAdmissionReceiptCid)
    out["chengFailureParserDiagnosticAuthorityRootCid"] =
        layout.FixedBytes32Hex(
            receipt.failureParserDiagnosticAuthorityRootCid)

fn lspCompletionKindFromCompilerSymbolKind(
        compilerKind: int32,
        out: var int32,
        err: var str): bool =
    if compilerKind == snapshot_schema.CsgCompilerSymbolModule:
        out = int32(lsp.CikModule)
    elif compilerKind == snapshot_schema.CsgCompilerSymbolType:
        out = int32(lsp.CikStruct)
    elif compilerKind == snapshot_schema.CsgCompilerSymbolFunction:
        out = int32(lsp.CikFunction)
    elif compilerKind == snapshot_schema.CsgCompilerSymbolField:
        out = int32(lsp.CikField)
    elif compilerKind == snapshot_schema.CsgCompilerSymbolParameter ||
         compilerKind == snapshot_schema.CsgCompilerSymbolLocal:
        out = int32(lsp.CikVariable)
    else:
        err = " lsp completion: unknown compiler symbol kind"
        return false
    err = ""
    return true

fn LspExactLocationToJson(
        location: LspExactLocation,
        receipt: LspExactQueryReceipt): json.JsonNode =
    var out = LspLocationToJson(
        location.uri,
        location.startLine, location.startColumn,
        location.endLine, location.endColumn)
    out["chengDocumentCid"] = layout.FixedBytes32Hex(location.documentCid)
    lspAddExactReceipt(out, receipt)
    return out

fn LspHandleDefinition(id: json.JsonNode, params: json.JsonNode) =
    if !gInitialized:
        LspWriteMessage(json.Stringify(LspMakeError(id, int32(lsp.InvalidRequest),
                                                     "server not initialized")))
        return

    var uri: str
    var line: int32
    var character: int32
    var err: str
    if !lspRequestPositionInto(
            params, uri, line, character, err):
        lspWriteExactQueryError(id, err)
        return
    var definition: LspExactDefinitionResult
    if !LspWorkspaceExactDefinitionInto(
            gWorkspace, uri, line, character, definition, err):
        lspWriteExactQueryError(id, err)
        return
    var result: json.JsonNode = json.NewJNull()
    if definition.found:
        result = LspExactLocationToJson(
            definition.location, definition.receipt)
        result["chengTargetSymbolId"] = json.NewJInt(
            int64(definition.targetSymbolId))
        result["chengTargetSymbolCid"] = layout.FixedBytes32Hex(
            definition.targetSymbolCid)
        result["chengTargetDeclId"] = json.NewJInt(
            int64(definition.targetDeclId))
        result["chengTargetDeclKeyCid"] = layout.FixedBytes32Hex(
            definition.targetDeclKeyCid)

    var response = LspMakeResponse(id, result)
    if definition.found:
        response["chengTargetSymbolId"] = json.NewJInt(
            int64(definition.targetSymbolId))
        response["chengTargetSymbolCid"] = layout.FixedBytes32Hex(
            definition.targetSymbolCid)
        response["chengTargetDeclId"] = json.NewJInt(
            int64(definition.targetDeclId))
        response["chengTargetDeclKeyCid"] = layout.FixedBytes32Hex(
            definition.targetDeclKeyCid)
    lspAddExactReceipt(response, definition.receipt)
    LspWriteMessage(json.Stringify(response))

fn LspHandleReferences(id: json.JsonNode, params: json.JsonNode) =
    if !gInitialized:
        LspWriteMessage(json.Stringify(LspMakeError(id, int32(lsp.InvalidRequest),
                                                     "server not initialized")))
        return

    var uri: str
    var line: int32
    var character: int32
    var err: str
    if !lspRequestPositionInto(
            params, uri, line, character, err):
        lspWriteExactQueryError(id, err)
        return
    let context = json.JsonGetField(params, "context")
    let includeDeclaration = json.GetBool(
        json.JsonGetField(context, "includeDeclaration"), false)
    var references: LspExactReferencesResult
    if !LspWorkspaceExactReferencesInto(
            gWorkspace, uri, line, character, includeDeclaration,
            references, err):
        lspWriteExactQueryError(id, err)
        return

    var result: json.JsonNode = json.NewJArray()
    for index in 0..<references.locations.len:
        var location = LspExactLocationToJson(
            references.locations[index], references.receipt)
        location["chengTargetSymbolId"] = json.NewJInt(
            int64(references.targetSymbolId))
        location["chengTargetSymbolCid"] = layout.FixedBytes32Hex(
            references.targetSymbolCid)
        location["chengTargetDeclId"] = json.NewJInt(
            int64(references.targetDeclId))
        location["chengTargetDeclKeyCid"] = layout.FixedBytes32Hex(
            references.targetDeclKeyCid)
        json.JsonAdd(result, location)

    var response = LspMakeResponse(id, result)
    if references.found:
        response["chengTargetSymbolId"] = json.NewJInt(
            int64(references.targetSymbolId))
        response["chengTargetSymbolCid"] = layout.FixedBytes32Hex(
            references.targetSymbolCid)
        response["chengTargetDeclId"] = json.NewJInt(
            int64(references.targetDeclId))
        response["chengTargetDeclKeyCid"] = layout.FixedBytes32Hex(
            references.targetDeclKeyCid)
    lspAddExactReceipt(response, references.receipt)
    LspWriteMessage(json.Stringify(response))

fn LspHandleRename(id: json.JsonNode, params: json.JsonNode) =
    var uri: str
    var line: int32
    var character: int32
    var err: str
    if !lspRequestPositionInto(
            params, uri, line, character, err):
        lspWriteExactQueryError(id, err)
        return
    let newName = json.GetStr(json.JsonGetField(params, "newName"))
    var rename: LspExactRenameResult
    if !LspWorkspaceExactRenameInto(
            gWorkspace, uri, line, character, newName, rename, err):
        lspWriteExactQueryError(id, err)
        return

    var result = json.NewJObject()
    var documentChanges = json.NewJArray()
    for editIndex in 0..<rename.edits.len:
        let edit = rename.edits[editIndex]
        var alreadyEmitted = false
        for priorIndex in 0..<editIndex:
            if layout.FixedBytes32Equal(
                    rename.edits[priorIndex].location.documentCid,
                    edit.location.documentCid):
                alreadyEmitted = true
                break
        if alreadyEmitted:
            continue
        var textDocumentEdit = json.NewJObject()
        var versionedDocument = json.NewJObject()
        versionedDocument["uri"] = edit.location.uri
        versionedDocument["version"] = json.NewJInt(edit.clientVersion)
        versionedDocument["chengDocumentCid"] =
            layout.FixedBytes32Hex(edit.location.documentCid)
        textDocumentEdit["textDocument"] = versionedDocument
        var edits = json.NewJArray()
        for groupedIndex in 0..<rename.edits.len:
            let grouped = rename.edits[groupedIndex]
            if !layout.FixedBytes32Equal(
                    grouped.location.documentCid,
                    edit.location.documentCid):
                continue
            if grouped.clientVersion != edit.clientVersion:
                panic("lsp_rename_document_version_split")
            var textEdit = json.NewJObject()
            textEdit["range"] = LspRangeToJson(
                grouped.location.startLine,
                grouped.location.startColumn,
                grouped.location.endLine,
                grouped.location.endColumn)
            textEdit["newText"] = grouped.newText
            textEdit["chengSymbolId"] = json.NewJInt(
                int64(rename.targetSymbolId))
            textEdit["chengSymbolCid"] = layout.FixedBytes32Hex(
                rename.targetSymbolCid)
            textEdit["chengDeclId"] = json.NewJInt(
                int64(rename.targetDeclId))
            textEdit["chengDeclKeyCid"] = layout.FixedBytes32Hex(
                rename.targetDeclKeyCid)
            lspAddExactReceipt(textEdit, rename.receipt)
            json.JsonAdd(edits, textEdit)
        textDocumentEdit["edits"] = edits
        json.JsonAdd(documentChanges, textDocumentEdit)
    result["documentChanges"] = documentChanges
    result["chengTargetSymbolId"] = json.NewJInt(
        int64(rename.targetSymbolId))
    result["chengTargetSymbolCid"] = layout.FixedBytes32Hex(
        rename.targetSymbolCid)
    result["chengTargetDeclId"] = json.NewJInt(
        int64(rename.targetDeclId))
    result["chengTargetDeclKeyCid"] = layout.FixedBytes32Hex(
        rename.targetDeclKeyCid)
    lspAddExactReceipt(result, rename.receipt)
    LspWriteMessage(json.Stringify(LspMakeResponse(id, result)))

fn LspHandleHover(id: json.JsonNode, params: json.JsonNode) =
    var uri: str
    var line: int32
    var character: int32
    var err: str
    if !lspRequestPositionInto(
            params, uri, line, character, err):
        lspWriteExactQueryError(id, err)
        return
    var hover: LspExactHoverResult
    if !LspWorkspaceExactHoverInto(
            gWorkspace, uri, line, character, hover, err):
        lspWriteExactQueryError(id, err)
        return
    var result = json.NewJNull()
    if hover.found:
        result = json.NewJObject()
        var contents = json.NewJObject()
        contents["kind"] = "plaintext"
        contents["value"] = strutil.Join([
            hover.symbol.modulePath, ".", hover.symbol.name,
            ": ", hover.symbol.typeText], "")
        result["contents"] = contents
        result["chengSymbolId"] = json.NewJInt(
            int64(hover.targetSymbolId))
        result["chengSymbolCid"] = layout.FixedBytes32Hex(
            hover.symbol.symbolCid)
        result["chengDeclId"] = json.NewJInt(
            int64(hover.targetDeclId))
        result["chengDeclKeyCid"] = layout.FixedBytes32Hex(
            hover.targetDeclKeyCid)
        result["chengDocumentCid"] = layout.FixedBytes32Hex(
            hover.symbol.documentCid)
        result["chengSymbolKind"] = json.NewJInt(
            int64(hover.symbol.kind))
        result["chengTypeId"] = json.NewJInt(
            int64(hover.symbol.typeId))
        lspAddExactReceipt(result, hover.receipt)
    var response = LspMakeResponse(id, result)
    lspAddExactReceipt(response, hover.receipt)
    LspWriteMessage(json.Stringify(response))

fn LspHandleCompletion(id: json.JsonNode, params: json.JsonNode) =
    var uri: str
    var line: int32
    var character: int32
    var err: str
    if !lspRequestPositionInto(
            params, uri, line, character, err):
        lspWriteExactQueryError(id, err)
        return
    var completion: LspExactCompletionResult
    if !LspWorkspaceExactCompletionInto(
            gWorkspace, uri, line, character, completion, err):
        lspWriteExactQueryError(id, err)
        return
    var result = json.NewJObject()
    result["isIncomplete"] = json.NewJBool(false)
    var items = json.NewJArray()
    for index in 0..<completion.items.len:
        let exact = completion.items[index]
        var completionKind: int32
        if !lspCompletionKindFromCompilerSymbolKind(
                exact.kind, completionKind, err):
            lspWriteExactQueryError(id, err)
            return
        var item = json.NewJObject()
        item["label"] = exact.name
        item["kind"] = json.NewJInt(int64(completionKind))
        item["detail"] = exact.typeText
        var data = json.NewJObject()
        data["symbolId"] = json.NewJInt(int64(exact.symbolId))
        data["symbolCid"] = layout.FixedBytes32Hex(exact.symbolCid)
        data["declId"] = json.NewJInt(int64(exact.declId))
        data["declKeyCid"] = layout.FixedBytes32Hex(exact.declKeyCid)
        data["documentCid"] = layout.FixedBytes32Hex(exact.documentCid)
        data["modulePath"] = exact.modulePath
        data["compilerSymbolKind"] = json.NewJInt(int64(exact.kind))
        data["visibility"] = json.NewJInt(int64(exact.visibility))
        lspAddExactReceipt(data, completion.receipt)
        item["data"] = data
        json.JsonAdd(items, item)
    result["items"] = items
    lspAddExactReceipt(result, completion.receipt)
    var response = LspMakeResponse(id, result)
    lspAddExactReceipt(response, completion.receipt)
    LspWriteMessage(json.Stringify(response))

fn LspHandleDiagnostic(id: json.JsonNode, params: json.JsonNode) =
    var uri: str
    var err: str
    if !lspRequestUriInto(params, uri, err):
        lspWriteExactQueryError(id, err)
        return
    var diagnostics: LspExactDiagnosticsResult
    if !LspWorkspaceExactDiagnosticsInto(
            gWorkspace, uri, diagnostics, err):
        lspWriteExactQueryError(id, err)
        return
    var result = json.NewJObject()
    result["kind"] = "full"
    result["resultId"] = layout.FixedBytes32Hex(
        diagnostics.receipt.semanticSnapshotCid)
    var items = json.NewJArray()
    for index in 0..<diagnostics.items.len:
        let exact = diagnostics.items[index]
        var diagnostic = json.NewJObject()
        diagnostic["range"] = LspRangeToJson(
            exact.location.startLine, exact.location.startColumn,
            exact.location.endLine, exact.location.endColumn)
        diagnostic["severity"] = json.NewJInt(int64(exact.severity))
        diagnostic["chengProducerKind"] = json.NewJInt(
            int64(exact.producerKind))
        diagnostic["chengDiagnosticId"] = json.NewJInt(
            int64(exact.diagnosticId))
        diagnostic["chengSpanId"] = json.NewJInt(int64(exact.spanId))
        diagnostic["code"] = exact.code
        diagnostic["source"] = "cheng-compiler"
        diagnostic["message"] = exact.message
        diagnostic["chengDocumentCid"] = layout.FixedBytes32Hex(
            exact.location.documentCid)
        lspAddExactReceipt(diagnostic, diagnostics.receipt)
        json.JsonAdd(items, diagnostic)
    result["items"] = items
    lspAddExactReceipt(result, diagnostics.receipt)
    var response = LspMakeResponse(id, result)
    lspAddExactReceipt(response, diagnostics.receipt)
    LspWriteMessage(json.Stringify(response))

fn LspHandleSnapshotMetrics(id: json.JsonNode) =
    var overlayBytes: int64
    var sealedBaseSourceBytes: int64
    var closedSourceSnapshotBytes: int64
    var overlayLineIndexBytes: int64
    var sourceHashCacheBytes: int64
    var openDocumentCount: int64
    for documentIndex in 0..<gWorkspace.documents.len:
        overlayBytes = overlayBytes +
            int64(gWorkspace.documents[documentIndex].text.len)
        overlayLineIndexBytes = overlayLineIndexBytes +
            int64(gWorkspace.documents[documentIndex].lineStartByteOffsets.len) *
            int64(4)
        sourceHashCacheBytes = sourceHashCacheBytes +
            int64(gWorkspace.documents[documentIndex].sourceHashBlockStates.len +
                  gWorkspace.documents[documentIndex].sourceHashBlockStatesMirror.len) *
            int64(8)
        if gWorkspace.documents[documentIndex].open:
            openDocumentCount = openDocumentCount + int64(1)
            sealedBaseSourceBytes = sealedBaseSourceBytes +
                int64(gWorkspace.documents[
                    documentIndex].sealedBaseSourceText.len)
        else:
            closedSourceSnapshotBytes = closedSourceSnapshotBytes +
                int64(gWorkspace.documents[documentIndex].sourceText.len)
    var payloadBytes: int64
    var livePayloadCount: int64
    var releasedPayloadCount: int64
    for payloadIndex in 0..<gWorkspace.snapshotStore.payloadStates.len:
        payloadBytes = payloadBytes + int64(rawbytes.BytesLen(
            gWorkspace.snapshotStore.payloadCsgcBytes[payloadIndex]))
        if gWorkspace.snapshotStore.payloadStates[payloadIndex] ==
               snapshot_production.SemanticSnapshotProductionPayloadLive:
            livePayloadCount = livePayloadCount + int64(1)
        elif gWorkspace.snapshotStore.payloadStates[payloadIndex] ==
                 snapshot_production.SemanticSnapshotProductionPayloadReleased:
            releasedPayloadCount = releasedPayloadCount + int64(1)
    var publishedSourceVersion: int64
    let publishedIndex = gWorkspace.snapshotStore.core.publishedIndex
    if publishedIndex >= 0:
        publishedSourceVersion =
            gWorkspace.snapshotStore.core.sourceVersions[publishedIndex]
    let metrics = gWorkspace.metrics
    var result = json.NewJObject()
    result["schema"] = "cheng.lsp.semantic_snapshot.metrics"
    result["eventAttemptCount"] = json.NewJInt(metrics.eventAttemptCount)
    result["eventAcceptedCount"] = json.NewJInt(metrics.eventAcceptedCount)
    result["eventRejectedCount"] = json.NewJInt(
        metrics.eventAttemptCount - metrics.eventAcceptedCount)
    result["didOpenAcceptedCount"] =
        json.NewJInt(metrics.didOpenAcceptedCount)
    result["didChangeAcceptedCount"] =
        json.NewJInt(metrics.didChangeAcceptedCount)
    result["didCloseAcceptedCount"] =
        json.NewJInt(metrics.didCloseAcceptedCount)
    result["didCreateAcceptedCount"] =
        json.NewJInt(metrics.didCreateAcceptedCount)
    result["didDeleteAcceptedCount"] =
        json.NewJInt(metrics.didDeleteAcceptedCount)
    result["didRenameAcceptedCount"] =
        json.NewJInt(metrics.didRenameAcceptedCount)
    result["didOpenAttemptWallNs"] =
        json.NewJInt(metrics.didOpenAttemptWallNs)
    result["didChangeAttemptWallNs"] =
        json.NewJInt(metrics.didChangeAttemptWallNs)
    result["didCloseAttemptWallNs"] =
        json.NewJInt(metrics.didCloseAttemptWallNs)
    result["didCreateAttemptWallNs"] =
        json.NewJInt(metrics.didCreateAttemptWallNs)
    result["didDeleteAttemptWallNs"] =
        json.NewJInt(metrics.didDeleteAttemptWallNs)
    result["didRenameAttemptWallNs"] =
        json.NewJInt(metrics.didRenameAttemptWallNs)
    result["lineIndexBuildWallNs"] =
        json.NewJInt(metrics.lineIndexBuildWallNs)
    result["contentChangeApplyWallNs"] =
        json.NewJInt(metrics.contentChangeApplyWallNs)
    result["sourceContentHashWallNs"] =
        json.NewJInt(metrics.sourceContentHashWallNs)
    result["didOpenSourceContentHashWallNs"] =
        json.NewJInt(metrics.didOpenSourceContentHashWallNs)
    result["didChangeSourceContentHashWallNs"] =
        json.NewJInt(metrics.didChangeSourceContentHashWallNs)
    result["sourceEventAcceptanceWallNs"] =
        json.NewJInt(metrics.sourceEventAcceptanceWallNs)
    result["sourceHashCacheHitCount"] =
        json.NewJInt(metrics.sourceHashCacheHitCount)
    result["sourceHashCacheColdCount"] =
        json.NewJInt(metrics.sourceHashCacheColdCount)
    result["sourceHashReusedBlockCount"] =
        json.NewJInt(metrics.sourceHashReusedBlockCount)
    result["sourceHashCompressedBlockCount"] =
        json.NewJInt(metrics.sourceHashCompressedBlockCount)
    result["messageReadCount"] = json.NewJInt(metrics.messageReadCount)
    result["messageReadWallNs"] = json.NewJInt(metrics.messageReadWallNs)
    result["jsonParseWallNs"] = json.NewJInt(metrics.jsonParseWallNs)
    result["dispatchWallNs"] = json.NewJInt(metrics.dispatchWallNs)
    result["eventAttemptWallNs"] =
        json.NewJInt(metrics.eventAttemptWallNs)
    result["acceptedEventWallNs"] =
        json.NewJInt(metrics.acceptedEventWallNs)
    result["candidateAttemptCount"] =
        json.NewJInt(metrics.candidateAttemptCount)
    result["candidatePublishedCount"] =
        json.NewJInt(metrics.candidatePublishedCount)
    result["candidateRejectedCount"] =
        json.NewJInt(metrics.candidateRejectedCount)
    result["candidateAdmissionPublishWallNs"] =
        json.NewJInt(metrics.candidateAdmissionPublishWallNs)
    result["candidateJobStartedCount"] =
        json.NewJInt(gCandidateScheduler.startedCount)
    result["candidateJobCancelledCount"] =
        json.NewJInt(gCandidateScheduler.cancelledCount)
    result["candidateJobCompletionCount"] =
        json.NewJInt(gCandidateScheduler.completionCount)
    result["candidateJobCompletionReleaseCount"] =
        json.NewJInt(gCandidateScheduler.completionReleaseCount)
    result["candidateJobCancelledCompletionCount"] =
        json.NewJInt(
            gCandidateScheduler.cancelledCompletionCount)
    result["candidateJobLateCompletionCount"] =
        json.NewJInt(gCandidateScheduler.lateCompletionCount)
    result["candidateJobDuplicateCompletionCount"] =
        json.NewJInt(
            gCandidateScheduler.duplicateCompletionCount)
    result["candidateJobCompletionRejectionCount"] =
        json.NewJInt(
            int64(gCandidateScheduler.completionRejections.len))
    if gCandidateScheduler.completionRejections.len > 0:
        let rejectionIndex: int32 =
            gCandidateScheduler.completionRejections.len - 1
        result["candidateJobLatestRejectionReceiptCid"] =
            layout.FixedBytes32Hex(
                gCandidateScheduler.completionRejections[
                    rejectionIndex].receiptCid)
        result["candidateJobLatestRejectionKind"] =
            json.NewJInt(
                int64(
                    gCandidateScheduler.completionRejections[
                        rejectionIndex].reasonKind))
    else:
        result["candidateJobLatestRejectionReceiptCid"] =
            layout.FixedBytes32Hex(layout.FixedBytes32())
        result["candidateJobLatestRejectionKind"] =
            json.NewJInt(int64(0))
    result["compilerSnapshotBuilderAttemptCount"] =
        json.NewJInt(metrics.compilerSnapshotBuilderAttemptCount)
    result["candidateBlockedReason"] = gWorkspace.candidateBlockedReason
    result["candidateAdmissionReceiptCid"] = layout.FixedBytes32Hex(
        gWorkspace.candidateAdmissionReceiptCid)
    result["candidateAdmissionCompletedStageBitmap"] = json.NewJInt(
        int64(gWorkspace.candidateAdmissionCompletedStageBitmap))
    result["candidateAdmissionMissingFactBitmap"] = json.NewJInt(
        int64(gWorkspace.candidateAdmissionMissingFactBitmap))
    result["queryAttemptCount"] =
        json.NewJInt(metrics.queryAttemptCount)
    result["queryWallNs"] = json.NewJInt(metrics.queryWallNs)
    result["definitionQueryCount"] =
        json.NewJInt(metrics.definitionQueryCount)
    result["definitionQueryWallNs"] =
        json.NewJInt(metrics.definitionQueryWallNs)
    result["referencesQueryCount"] =
        json.NewJInt(metrics.referencesQueryCount)
    result["referencesQueryWallNs"] =
        json.NewJInt(metrics.referencesQueryWallNs)
    result["renameQueryCount"] = json.NewJInt(metrics.renameQueryCount)
    result["renameQueryWallNs"] =
        json.NewJInt(metrics.renameQueryWallNs)
    result["hoverQueryCount"] = json.NewJInt(metrics.hoverQueryCount)
    result["hoverQueryWallNs"] = json.NewJInt(metrics.hoverQueryWallNs)
    result["completionQueryCount"] =
        json.NewJInt(metrics.completionQueryCount)
    result["completionQueryWallNs"] =
        json.NewJInt(metrics.completionQueryWallNs)
    result["diagnosticsQueryCount"] =
        json.NewJInt(metrics.diagnosticsQueryCount)
    result["diagnosticsQueryWallNs"] =
        json.NewJInt(metrics.diagnosticsQueryWallNs)
    result["currentSourceVersion"] = json.NewJInt(
        gWorkspace.eventState.lastAcceptedSourceVersion)
    result["publishedSourceVersion"] =
        json.NewJInt(publishedSourceVersion)
    result["openDocumentCount"] = json.NewJInt(openDocumentCount)
    result["livePayloadCount"] = json.NewJInt(livePayloadCount)
    result["releasedPayloadCount"] = json.NewJInt(releasedPayloadCount)
    result["overlaySourceBytes"] = json.NewJInt(overlayBytes)
    result["sealedBaseSourceBytes"] =
        json.NewJInt(sealedBaseSourceBytes)
    result["closedSourceSnapshotBytes"] =
        json.NewJInt(closedSourceSnapshotBytes)
    result["overlayLineIndexBytes"] =
        json.NewJInt(overlayLineIndexBytes)
    result["sourceHashCacheBytes"] = json.NewJInt(sourceHashCacheBytes)
    result["inputBufferBytes"] =
        json.NewJInt(int64(rawbytes.BytesLen(gInputReader.buffer)))
    result["payloadCsgcBytes"] = json.NewJInt(payloadBytes)
    result["accountedRetainedBytes"] =
        json.NewJInt(
            overlayBytes + overlayLineIndexBytes +
            sourceHashCacheBytes + payloadBytes +
            sealedBaseSourceBytes + closedSourceSnapshotBytes +
            int64(rawbytes.BytesLen(gInputReader.buffer)))
    result["explicitSourceFileReadCount"] =
        json.NewJInt(metrics.explicitSourceFileReadCount)
    result["explicitSourceFileReadBytes"] =
        json.NewJInt(metrics.explicitSourceFileReadBytes)
    result["parserBuildObserved"] =
        json.NewJBool(metrics.parserBuildObserved)
    result["parserBuildWallNs"] =
        json.NewJInt(metrics.parserBuildWallNs)
    result["compilerCsgBuildObserved"] =
        json.NewJBool(metrics.compilerCsgBuildObserved)
    result["compilerCsgBuildWallNs"] =
        json.NewJInt(metrics.compilerCsgBuildWallNs)
    LspWriteMessage(json.Stringify(LspMakeResponse(id, result)))

