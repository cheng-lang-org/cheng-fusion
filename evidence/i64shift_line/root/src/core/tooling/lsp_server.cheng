fn lspLineMapFunctionToJson(
        fact: debug_facts.DebugFunctionFact): json.JsonNode =
    var out = json.NewJObject()
    out["functionId"] = json.NewJInt(int64(fact.functionId))
    out["typedFunctionIndex"] =
        json.NewJInt(int64(fact.typedFunctionIndex))
    out["functionDeclId"] = json.NewJInt(int64(fact.declId))
    out["functionSymbolId"] = json.NewJInt(int64(fact.symbolId))
    out["sourceId"] = json.NewJInt(int64(fact.sourceId))
    out["declarationSpanId"] =
        json.NewJInt(int64(fact.declarationSpanId))
    out["bodySpanId"] = json.NewJInt(int64(fact.bodySpanId))
    out["documentCid"] = layout.FixedBytes32Hex(fact.documentCid)
    out["functionDeclKeyCid"] =
        layout.FixedBytes32Hex(fact.declKeyCid)
    out["functionSymbolCid"] = layout.FixedBytes32Hex(fact.symbolCid)
    out["interfaceCid"] = layout.FixedBytes32Hex(fact.interfaceCid)
    out["fragmentCid"] = layout.FixedBytes32Hex(fact.fragmentCid)
    out["modulePath"] = fact.modulePath
    out["functionName"] = fact.functionName
    out["qualifiedName"] = fact.qualifiedName
    out["bodyStartByte"] = json.NewJInt(int64(fact.bodyStartByte))
    out["bodyEndByte"] = json.NewJInt(int64(fact.bodyEndByte))
    out["bodyStartLine"] = json.NewJInt(int64(fact.bodyStartLine))
    out["bodyStartColumn"] =
        json.NewJInt(int64(fact.bodyStartColumn))
    out["bodyEndLine"] = json.NewJInt(int64(fact.bodyEndLine))
    out["bodyEndColumn"] = json.NewJInt(int64(fact.bodyEndColumn))
    out["threadBoundary"] = json.NewJBool(fact.threadBoundary)
    return out

fn lspLineMapOperationToJson(
        fact: debug_facts.DebugOperationFact): json.JsonNode =
    var out = json.NewJObject()
    out["debugOpId"] = json.NewJInt(int64(fact.debugOpId))
    out["typedNodeId"] = json.NewJInt(int64(fact.typedNodeId))
    out["typedIrNodeIndex"] =
        json.NewJInt(int64(fact.typedIrNodeIndex))
    out["originParserNodeId"] =
        json.NewJInt(int64(fact.originParserNodeId))
    out["syntheticOriginKind"] =
        json.NewJInt(int64(fact.syntheticOriginKind))
    out["spanAuthorityKind"] =
        json.NewJInt(int64(fact.spanAuthorityKind))
    out["functionId"] = json.NewJInt(int64(fact.functionId))
    out["functionDeclId"] =
        json.NewJInt(int64(fact.functionDeclId))
    out["functionSymbolId"] =
        json.NewJInt(int64(fact.functionSymbolId))
    out["symbolDeclId"] = json.NewJInt(int64(fact.symbolDeclId))
    out["symbolId"] = json.NewJInt(int64(fact.symbolId))
    out["sourceId"] = json.NewJInt(int64(fact.sourceId))
    out["spanId"] = json.NewJInt(int64(fact.spanId))
    out["opKind"] = json.NewJInt(int64(fact.opKind))
    out["typedOpKind"] = json.NewJInt(int64(fact.typedOpKind))
    out["typeId"] = json.NewJInt(int64(fact.typeId))
    out["ownershipKind"] = json.NewJInt(int64(fact.ownershipKind))
    out["documentCid"] = layout.FixedBytes32Hex(fact.documentCid)
    out["functionDeclKeyCid"] =
        layout.FixedBytes32Hex(fact.functionDeclKeyCid)
    out["functionSymbolCid"] =
        layout.FixedBytes32Hex(fact.functionSymbolCid)
    out["symbolDeclKeyCid"] =
        layout.FixedBytes32Hex(fact.symbolDeclKeyCid)
    out["symbolCid"] = layout.FixedBytes32Hex(fact.symbolCid)
    out["modulePath"] = fact.modulePath
    out["startByte"] = json.NewJInt(int64(fact.startByte))
    out["endByte"] = json.NewJInt(int64(fact.endByte))
    out["startLine"] = json.NewJInt(int64(fact.startLine))
    out["startColumn"] = json.NewJInt(int64(fact.startColumn))
    out["endLine"] = json.NewJInt(int64(fact.endLine))
    out["endColumn"] = json.NewJInt(int64(fact.endColumn))
    return out

fn LspHandleChengLineMap(id: json.JsonNode, params: json.JsonNode) =
    var uri: str
    var err: str
    if !lspRequestUriInto(params, uri, err):
        lspWriteExactQueryError(id, err)
        return
    var lineMap: LspExactLineMapResult
    if !LspWorkspaceExactLineMapInto(
            gWorkspace, uri, lineMap, err):
        lspWriteExactQueryError(id, err)
        return
    var result = json.NewJObject()
    result["schema"] = "cheng_line_map"
    result["source"] = lineMap.sourcePath
    result["sourceVersion"] =
        json.NewJInt(lineMap.receipt.sourceVersion)
    result["semanticSnapshotCid"] =
        layout.FixedBytes32Hex(lineMap.receipt.semanticSnapshotCid)
    result["bindingReceiptCid"] =
        layout.FixedBytes32Hex(lineMap.receipt.bindingReceiptCid)
    result["csgRootCid"] =
        layout.FixedBytes32Hex(lineMap.receipt.csgRootCid)
    result["declarationTableCid"] =
        layout.FixedBytes32Hex(lineMap.receipt.declarationTableCid)
    result["debugProjectionCid"] =
        layout.FixedBytes32Hex(lineMap.debugProjectionCid)
    result["documentCid"] =
        layout.FixedBytes32Hex(lineMap.documentCid)
    result["entryCount"] =
        json.NewJInt(int64(lineMap.functions.len))
    result["functionCount"] =
        json.NewJInt(int64(lineMap.functions.len))
    result["locationCount"] =
        json.NewJInt(int64(lineMap.locations.len))
    result["syntheticCount"] =
        json.NewJInt(int64(lineMap.syntheticLocations.len))
    var functionsJson = json.NewJArray()
    for index in 0..<lineMap.functions.len:
        json.JsonAdd(
            functionsJson,
            lspLineMapFunctionToJson(lineMap.functions[index]))
    result["functions"] = functionsJson
    var locationsJson = json.NewJArray()
    for index in 0..<lineMap.locations.len:
        json.JsonAdd(
            locationsJson,
            lspLineMapOperationToJson(lineMap.locations[index]))
    result["locations"] = locationsJson
    var syntheticJson = json.NewJArray()
    for index in 0..<lineMap.syntheticLocations.len:
        json.JsonAdd(
            syntheticJson,
            lspLineMapOperationToJson(
                lineMap.syntheticLocations[index]))
    result["syntheticLocations"] = syntheticJson
    lspAddExactReceipt(result, lineMap.receipt)
    var response = LspMakeResponse(id, result)
    lspAddExactReceipt(response, lineMap.receipt)
    LspWriteMessage(json.Stringify(response))

