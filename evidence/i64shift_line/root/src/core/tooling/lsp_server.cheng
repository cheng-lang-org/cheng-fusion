# --- Helpers not in the standard library ---

@borrows
fn LspFindCharIndex(text: str, ch: char): int32 =
    let n: int32 = strings.Len(text)
    for i in 0..<n:
        if text[i] == ch:
            return i
    return -1

@borrows
fn lspAsciiDecimalStrict(text: str): bool =
    if text.len <= 0:
        return false
    for index in 0..<text.len:
        if text[index] < '0' || text[index] > '9':
            return false
    return true

fn lspUriHexNibble(value: char): int32 =
    if value >= '0' && value <= '9':
        return Int32(value) - Int32('0')
    if value >= 'a' && value <= 'f':
        return Int32(value) - Int32('a') + 10
    if value >= 'A' && value <= 'F':
        return Int32(value) - Int32('A') + 10
    return -1

@borrows
fn lspFileUriCanonicalPathInto(uri: str,
                               out: var str,
                               err: var str): bool =
    out = ""
    err = ""
    if !strutil.StartsWith(uri, "file://") || uri.len <= 7 || uri[7] != '/':
        err = " lsp workspace: only local absolute file URIs are supported"
        return false
    var bytes = layout.ByteBufInit(uri.len - 7)
    var index: int32 = 7
    while index < uri.len:
        var value = Int32(uri[index]) & 255
        if uri[index] == '%':
            if index + 2 >= uri.len:
                layout.ByteBufFree(bytes)
                err = " lsp workspace: truncated file URI escape"
                return false
            let high = lspUriHexNibble(uri[index + 1])
            let low = lspUriHexNibble(uri[index + 2])
            if high < 0 || low < 0:
                layout.ByteBufFree(bytes)
                err = " lsp workspace: invalid file URI escape"
                return false
            value = high * 16 + low
            index = index + 2
        elif uri[index] == '?' || uri[index] == '#':
            layout.ByteBufFree(bytes)
            err = " lsp workspace: file URI query or fragment is forbidden"
            return false
        if value == 0:
            layout.ByteBufFree(bytes)
            err = " lsp workspace: file URI contains NUL"
            return false
        layout.ByteBufAppendByte(bytes, value)
        index = index + 1
    let decoded = rawbytes.BytesToString(layout.ByteBufView(bytes).data)
    layout.ByteBufFree(bytes)
    var canonical: str
    if !parser.ParserSourceIdentityLexicalPathInto(decoded, canonical) ||
       !parser.ParserSourceIdentityPathAbsolute(canonical):
        err = " lsp workspace: file URI path is not canonicalizable"
        return false
    out = canonical
    return true

fn LspInt32ToStr(value: int32): str =
    return strings.IntToStr(value)

fn lspJsonNonNegativeInt32Into(
        valueNode: json.JsonNode,
        label: str,
        out: var int32,
        err: var str): bool =
    out = -1
    if valueNode.kind != json.JInt:
        err = strutil.Join([" lsp request: missing integer ", label], "")
        return false
    let value = json.GetInt64(valueNode, -1)
    if value < int64(0) || value > int64(2147483647):
        err = strutil.Join([" lsp request: integer out of range ", label], "")
        return false
    out = int32(value)
    err = ""
    return true

@borrows
fn lspRequestUriInto(
        params: json.JsonNode,
        uriOut: var str,
        err: var str): bool =
    uriOut = ""
    let textDocument = json.JsonGetField(params, "textDocument")
    if textDocument.kind != json.JObject:
        err = " lsp request: textDocument object is required"
        return false
    let uriNode = json.JsonGetField(textDocument, "uri")
    if uriNode.kind != json.JString:
        err = " lsp request: textDocument URI is required"
        return false
    let uri = json.GetStr(uriNode)
    if uri == "":
        err = " lsp request: textDocument URI is empty"
        return false
    uriOut = uri
    err = ""
    return true

@borrows
fn lspRequestPositionInto(
        params: json.JsonNode,
        uriOut: var str,
        lineOut: var int32,
        characterOut: var int32,
        err: var str): bool =
    lineOut = -1
    characterOut = -1
    if !lspRequestUriInto(params, uriOut, err):
        return false
    let position = json.JsonGetField(params, "position")
    if position.kind != json.JObject:
        err = " lsp request: position object is required"
        return false
    if !lspJsonNonNegativeInt32Into(
            json.JsonGetField(position, "line"), "position.line",
            lineOut, err) ||
       !lspJsonNonNegativeInt32Into(
            json.JsonGetField(position, "character"),
            "position.character", characterOut, err):
        return false
    err = ""
    return true

fn lspCidLess(
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] != right.data[index]:
            return left.data[index] < right.data[index]
    return false

fn lspCandidateCompletionAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn lspCandidateCompletionAppendI64(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 56) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 48) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 40) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 32) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 24) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & int64(255)))
    layout.ByteBufAppendByte(buf, int32(value & int64(255)))

@borrows
fn lspCandidateCompletionAppendText(
        buf: var layout.ByteBuf,
        text: str) =
    lspCandidateCompletionAppendU32(buf, text.len)
    for index in 0..<text.len:
        layout.ByteBufAppendByte(buf, Int32(text[index]) & 255)

@borrows
fn lspCandidateCompletionAuthorityCid(
        jobCid: layout.FixedBytes32,
        sourceVersion: int64,
        kind: int32,
        reason: str,
        producerCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256 + reason.len)
    lspCandidateCompletionAppendText(
        buf, "cheng.lsp.candidate_job_completion")
    layout.ByteBufAppendFixed32(buf, jobCid)
    lspCandidateCompletionAppendI64(buf, sourceVersion)
    lspCandidateCompletionAppendU32(buf, kind)
    lspCandidateCompletionAppendText(buf, reason)
    layout.ByteBufAppendFixed32(buf, producerCid)
    let out = lsp_hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

