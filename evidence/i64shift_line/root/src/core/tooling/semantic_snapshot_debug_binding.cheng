import cheng/std/bytes_layout as layout
import cheng/core/backend/compiler_facts
import cheng/core/backend/debug_facts
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/semantic_snapshot_debug_binding_receipt as bindingreceipt
import cheng/core/csg_core/compiler_snapshot_cargo as snapshot_cargo
import cheng/core/tooling/semantic_snapshot as snapshot_core
import cheng/core/tooling/semantic_snapshot_production as production

fn semanticSnapshotDebugCidObserved(value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

fn semanticSnapshotDebugFactIdentitiesEqual(
        compiler: var compiler_facts.CompilerFactBundle,
        debug: var debug_facts.DebugFactBundle): bool =
    return compiler.sourceVersion == debug.sourceVersion &&
           compiler.packageId == debug.packageId &&
           layout.FixedBytes32Equal(
               compiler.predecessorReceiptCid,
               debug.predecessorReceiptCid) &&
           layout.FixedBytes32Equal(
               compiler.bindingReceiptCid, debug.bindingReceiptCid) &&
           layout.FixedBytes32Equal(
               compiler.semanticSnapshotCid, debug.semanticSnapshotCid) &&
           layout.FixedBytes32Equal(
               compiler.worldHeadCidRaw, debug.worldHeadCid) &&
           layout.FixedBytes32Equal(compiler.compilerCid,
                                    debug.compilerCid) &&
           layout.FixedBytes32Equal(compiler.sourceBundleCid,
                                    debug.sourceBundleCid) &&
           layout.FixedBytes32Equal(compiler.csgRootCid,
                                    debug.csgRootCid) &&
           layout.FixedBytes32Equal(
               compiler.validationReceiptCid,
               debug.validationReceiptCid) &&
           semanticSnapshotDebugCidObserved(debug.declarationTableCid) &&
           semanticSnapshotDebugCidObserved(debug.declarationIdentityCid)

fn semanticSnapshotDebugProofRootsMatch(
        roots: snapshot_cargo.CsgCompilerSnapshotProofRoots,
        validation: snapshot_core.SemanticSnapshotValidationReceipt): bool =
    return layout.FixedBytes32Equal(roots.parserRootCid,
                                    validation.parserRootCid) &&
           layout.FixedBytes32Equal(roots.typeRootCid,
                                    validation.typeRootCid) &&
           layout.FixedBytes32Equal(roots.ownershipRootCid,
                                    validation.ownershipRootCid) &&
           layout.FixedBytes32Equal(roots.callRootCid,
                                    validation.callRootCid) &&
           layout.FixedBytes32Equal(roots.layoutRootCid,
                                    validation.layoutRootCid) &&
           layout.FixedBytes32Equal(roots.dependencyRootCid,
                                    validation.dependencyRootCid) &&
           layout.FixedBytes32Equal(roots.readSetRootCid,
                                    validation.readSetRootCid) &&
           layout.FixedBytes32Equal(roots.reachabilityRootCid,
                                    validation.reachabilityRootCid) &&
           layout.FixedBytes32Equal(roots.lifecycleRootCid,
                                    validation.lifecycleRootCid)

fn semanticSnapshotDebugPinnedBundlesInto(
        store: var production.SemanticSnapshotProductionStore,
        pin: var production.SemanticSnapshotProductionPin,
        compilerOut: var compiler_facts.CompilerFactBundle,
        debugOut: var debug_facts.DebugFactBundle,
        err: var str): bool =
    if !production.SemanticSnapshotProductionPinnedCompilerFactsInto(
            store, pin, compilerOut, err) ||
       !production.SemanticSnapshotProductionPinnedDebugFactsInto(
            store, pin, debugOut, err):
        return false
    if !semanticSnapshotDebugFactIdentitiesEqual(compilerOut, debugOut):
        err = " semantic snapshot debug binding: CompilerFact/DebugFact identity split"
        return false
    if !layout.FixedBytes32Equal(
           debugOut.declarationTableCid, pin.declarationTableCid):
        err = " semantic snapshot debug binding: declaration table split"
        return false
    if pin.payloadIndex < 0 ||
       pin.payloadIndex >= store.payloadCsgcBytes.len ||
       pin.payloadIndex >= store.payloadValidations.len:
        err = " semantic snapshot debug binding: pinned cargo unavailable"
        return false
    let admitted = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        store.payloadCsgcBytes[pin.payloadIndex], pin.factsRootCid)
    if !admitted.ok ||
       !layout.FixedBytes32Equal(admitted.cargoCid, pin.cargoCid) ||
       !semanticSnapshotDebugProofRootsMatch(
           admitted.proofRoots,
           store.payloadValidations[pin.payloadIndex]):
        err = " semantic snapshot debug binding: pinned cargo proof mismatch"
        return false
    return true

fn semanticSnapshotDebugBindingReceiptMatchesInto(
        pin: var production.SemanticSnapshotProductionPin,
        plan: var lower.LoweringPlanStub,
        compiler: var compiler_facts.CompilerFactBundle,
        debug: var debug_facts.DebugFactBundle,
        receipt: bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        err: var str): bool =
    err = ""
    if !lower.LoweringPlanPublishedDebugFactsStrictValidateInto(plan, err):
        return false
    if !layout.FixedBytes32Equal(plan.sourceBundleCid,
                                 debug.sourceBundleCid):
        err = " semantic snapshot debug binding: lowering source bundle split"
        return false
    if receipt.sourceVersion <= 0 || receipt.snapshotIndex < 0 ||
       receipt.payloadIndex < 0 || receipt.typedFunctionCount < 0 ||
       receipt.typedNodeCount < 0 ||
       !semanticSnapshotDebugCidObserved(receipt.predecessorReceiptCid) ||
       !semanticSnapshotDebugCidObserved(receipt.bindingReceiptCid) ||
       !semanticSnapshotDebugCidObserved(receipt.semanticSnapshotCid) ||
       !semanticSnapshotDebugCidObserved(receipt.worldHeadCid) ||
       !semanticSnapshotDebugCidObserved(receipt.compilerCid) ||
       !semanticSnapshotDebugCidObserved(receipt.sourceBundleCid) ||
       !semanticSnapshotDebugCidObserved(receipt.csgRootCid) ||
       !semanticSnapshotDebugCidObserved(receipt.validationReceiptCid) ||
       !semanticSnapshotDebugCidObserved(receipt.declarationTableCid) ||
       !semanticSnapshotDebugCidObserved(receipt.declarationIdentityCid) ||
       !semanticSnapshotDebugCidObserved(
           receipt.compilerFactProjectionCid) ||
       !semanticSnapshotDebugCidObserved(receipt.debugFactProjectionCid) ||
       !semanticSnapshotDebugCidObserved(receipt.loweringBridgeRootCid) ||
       !semanticSnapshotDebugCidObserved(receipt.receiptCid):
        err = " semantic snapshot debug binding: invalid receipt shape"
        return false
    if receipt.sourceVersion != pin.corePin.sourceVersion ||
       receipt.snapshotIndex != pin.corePin.snapshotIndex ||
       receipt.payloadIndex != pin.payloadIndex ||
       receipt.sourceVersion != debug.sourceVersion ||
       receipt.typedFunctionCount != debug.functionCount ||
       receipt.typedNodeCount != debug.typedNodeCount ||
       !layout.FixedBytes32Equal(
           receipt.predecessorReceiptCid,
           debug.predecessorReceiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.bindingReceiptCid, pin.corePin.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.bindingReceiptCid, debug.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.semanticSnapshotCid, pin.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(
           receipt.semanticSnapshotCid, debug.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(receipt.worldHeadCid,
                                 debug.worldHeadCid) ||
       !layout.FixedBytes32Equal(receipt.compilerCid,
                                 debug.compilerCid) ||
       !layout.FixedBytes32Equal(receipt.sourceBundleCid,
                                 debug.sourceBundleCid) ||
       !layout.FixedBytes32Equal(receipt.csgRootCid, pin.factsRootCid) ||
       !layout.FixedBytes32Equal(receipt.csgRootCid,
                                 debug.csgRootCid) ||
       !layout.FixedBytes32Equal(receipt.validationReceiptCid,
                                 debug.validationReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.declarationTableCid,
                                 pin.declarationTableCid) ||
       !layout.FixedBytes32Equal(receipt.declarationTableCid,
                                 debug.declarationTableCid) ||
       !layout.FixedBytes32Equal(receipt.declarationIdentityCid,
                                 debug.declarationIdentityCid) ||
       !layout.FixedBytes32Equal(
           receipt.compilerFactProjectionCid, compiler.projectionCid) ||
       !layout.FixedBytes32Equal(
           receipt.debugFactProjectionCid, debug.projectionCid) ||
       !layout.FixedBytes32Equal(
           receipt.loweringBridgeRootCid,
           lower.LoweringPlanSemanticDebugBridgeRoot(plan)) ||
       !layout.FixedBytes32Equal(
           receipt.receiptCid,
           bindingreceipt.SemanticSnapshotDebugBindingReceiptCid(receipt)):
        err = " semantic snapshot debug binding: receipt identity drift"
        return false
    return true

fn SemanticSnapshotDebugBindingReceiptStrictValidateInto(
        store: var production.SemanticSnapshotProductionStore,
        pin: var production.SemanticSnapshotProductionPin,
        plan: var lower.LoweringPlanStub,
        receipt: bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        err: var str): bool =
    var compiler: compiler_facts.CompilerFactBundle
    var debug: debug_facts.DebugFactBundle
    if !semanticSnapshotDebugPinnedBundlesInto(
            store, pin, compiler, debug, err):
        return false
    if !semanticSnapshotDebugBindingReceiptMatchesInto(
           pin, plan, compiler, debug, receipt, err) ||
       !lower.LoweringPlanPublishedDebugBindingReceiptStrictValidateInto(
           plan, err):
        return false
    if !bindingreceipt.SemanticSnapshotDebugBindingReceiptEqual(
           plan.semanticDebugBinding, receipt):
        err = " semantic snapshot debug binding: lowering receipt split"
        return false
    return true

# Downstream immutable consumers no longer own the snapshot store/pin. This
# boundary validates the published bridge receipt against the exact retained
# DebugFact bundle and replays the receipt CID before accepting it as input to
# a debug-section emission plan.
fn SemanticSnapshotDebugBindingReceiptValidatePublishedFactsInto(
        receipt: bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        debug: var debug_facts.DebugFactBundle,
        err: var str): bool =
    return bindingreceipt.SemanticSnapshotDebugBindingReceiptValidateFactsInto(
        receipt, debug, err)

# Production bridge: only a live pin to an atomically published, fully
# revalidated snapshot can reach lowering. No source text or approximate symbol
# lookup participates, and every failure occurs before the lowering owner is
# changed.
fn SemanticSnapshotBindPinnedDebugFactsInto(
        store: var production.SemanticSnapshotProductionStore,
        pin: var production.SemanticSnapshotProductionPin,
        plan: var lower.LoweringPlanStub,
        out: var bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        err: var str): bool =
    err = ""
    var compiler: compiler_facts.CompilerFactBundle
    var debug: debug_facts.DebugFactBundle
    if !semanticSnapshotDebugPinnedBundlesInto(
            store, pin, compiler, debug, err):
        return false
    if !layout.FixedBytes32Equal(plan.sourceBundleCid,
                                 debug.sourceBundleCid):
        err = " semantic snapshot debug binding: lowering source bundle split"
        return false
    if !lower.LoweringPlanBindPublishedDebugFactsInto(plan, debug, err):
        return false
    if !lower.LoweringPlanPublishedDebugFactsStrictValidateInto(plan, err):
        panic("semantic_snapshot_debug_binding_post_bind_drift")
    var receipt: bindingreceipt.SemanticSnapshotDebugBindingReceipt
    receipt.sourceVersion = debug.sourceVersion
    receipt.snapshotIndex = pin.corePin.snapshotIndex
    receipt.payloadIndex = pin.payloadIndex
    receipt.predecessorReceiptCid = debug.predecessorReceiptCid
    receipt.bindingReceiptCid = debug.bindingReceiptCid
    receipt.semanticSnapshotCid = debug.semanticSnapshotCid
    receipt.worldHeadCid = debug.worldHeadCid
    receipt.compilerCid = debug.compilerCid
    receipt.sourceBundleCid = debug.sourceBundleCid
    receipt.csgRootCid = debug.csgRootCid
    receipt.validationReceiptCid = debug.validationReceiptCid
    receipt.declarationTableCid = debug.declarationTableCid
    receipt.declarationIdentityCid = debug.declarationIdentityCid
    receipt.compilerFactProjectionCid = compiler.projectionCid
    receipt.debugFactProjectionCid = debug.projectionCid
    receipt.loweringBridgeRootCid =
        lower.LoweringPlanSemanticDebugBridgeRoot(plan)
    receipt.typedFunctionCount = debug.functionCount
    receipt.typedNodeCount = debug.typedNodeCount
    receipt.receiptCid =
        bindingreceipt.SemanticSnapshotDebugBindingReceiptCid(receipt)
    if !semanticSnapshotDebugBindingReceiptMatchesInto(
            pin, plan, compiler, debug, receipt, err):
        panic("semantic_snapshot_debug_binding_receipt_drift")
    if !lower.LoweringPlanBindPublishedDebugBindingReceiptInto(
           plan, receipt, err) ||
       !lower.LoweringPlanPublishedDebugBindingReceiptStrictValidateInto(
           plan, err):
        panic("semantic_snapshot_debug_binding_lowering_receipt_drift")
    out = receipt
    err = ""
    return true
