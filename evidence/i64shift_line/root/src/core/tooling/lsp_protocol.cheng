# src/core/tooling/lsp_protocol.cheng
# LSP protocol types and JSON-RPC message structures.
# Facts-driven architecture: all types mirror canonical compiler facts,
# not raw parser output.

import std/json

# --- JSON-RPC 2.0 message types ---

type
    JsonRpcMessageKind = enum
        RpcRequest
        RpcNotification
        RpcResponse
        RpcError

    JsonRpcErrorCode = enum
        ParseError = -32700
        InvalidRequest = -32600
        MethodNotFound = -32601
        InvalidParams = -32602
        InternalError = -32603
        ServerNotInitialized = -32002
        RequestCancelled = -32800
        ContentModified = -32801

    JsonRpcError =
        code: int32
        message: str
        data: json.JsonNode

# --- LSP protocol base types ---

type
    Position =
        line: int32
        character: int32

    Range =
        start: Position
        end: Position

    Location =
        uri: str
        range: Range

    DiagnosticSeverity = enum
        DsError = 1
        DsWarning = 2
        DsInformation = 3
        DsHint = 4

    Diagnostic =
        range: Range
        severity: DiagnosticSeverity
        code: str
        source: str
        message: str
        tags: int32[]
        relatedInformation: DiagnosticRelatedInformation[]

    DiagnosticRelatedInformation =
        location: Location
        message: str

    TextDocumentItem =
        uri: str
        languageId: str
        version: int32
        text: str

    VersionedTextDocumentIdentifier =
        uri: str
        version: int32

    CompletionItemKind = enum
        CikText = 1
        CikMethod = 2
        CikFunction = 3
        CikConstructor = 4
        CikField = 5
        CikVariable = 6
        CikClass = 7
        CikInterface = 8
        CikModule = 9
        CikProperty = 10
        CikUnit = 11
        CikValue = 12
        CikEnum = 13
        CikKeyword = 14
        CikSnippet = 15
        CikColor = 16
        CikFile = 17
        CikReference = 18
        CikFolder = 19
        CikEnumMember = 20
        CikConstant = 21
        CikStruct = 22
        CikEvent = 23
        CikOperator = 24
        CikTypeParameter = 25

    CompletionItem =
        label: str
        kind: CompletionItemKind
        detail: str
        documentation: str
        sortText: str
        filterText: str
        insertText: str
        data: json.JsonNode

    CompletionList =
        isIncomplete: bool
        items: CompletionItem[]

    SymbolKind = enum
        SkFile = 1
        SkModule = 2
        SkNamespace = 3
        SkPackage = 4
        SkClass = 5
        SkMethod = 6
        SkProperty = 7
        SkField = 8
        SkConstructor = 9
        SkEnum = 10
        SkInterface = 11
        SkFunction = 12
        SkVariable = 13
        SkConstant = 14
        SkString = 15
        SkNumber = 16
        SkBoolean = 17
        SkArray = 18
        SkObject = 19
        SkKey = 20
        SkNull = 21
        SkEnumMember = 22
        SkStruct = 23
        SkEvent = 24
        SkOperator = 25
        SkTypeParameter = 26

    ServerCapabilities =
        textDocumentSync: int32
        hoverProvider: bool
        definitionProvider: bool
        referencesProvider: bool
        documentSymbolProvider: bool
        workspaceSymbolProvider: bool
        completionProvider: CompletionOptions
        diagnosticProvider: DiagnosticOptions
        foldingRangeProvider: bool
        documentFormattingProvider: bool

    CompletionOptions =
        triggerCharacters: str[]
        resolveProvider: bool

    DiagnosticOptions =
        identifier: str
        interFileDependencies: bool
        workspaceDiagnostics: bool

# --- Factory helpers ---

fn LspMakePosition(line: int32, character: int32): Position =
    var out: Position
    out.line = line
    out.character = character
    return out

fn LspMakeRange(startLine: int32, startChar: int32,
                endLine: int32, endChar: int32): Range =
    var out: Range
    out.start = LspMakePosition(startLine, startChar)
    out.end = LspMakePosition(endLine, endChar)
    return out

fn LspMakeLocation(uri: str, range: Range): Location =
    var out: Location
    out.uri = uri
    out.range = range
    return out

fn LspMakeCompletionItem(label: str, kind: CompletionItemKind,
                          detail: str, documentation: str,
                          sortText: str, filterText: str,
                          insertText: str): CompletionItem =
    var out: CompletionItem
    out.label = label
    out.kind = kind
    out.detail = detail
    out.documentation = documentation
    out.sortText = sortText
    out.filterText = filterText
    out.insertText = insertText
    return out

fn LspMakeDiagnostic(range: Range, severity: DiagnosticSeverity,
                     code: str, source: str, message: str): Diagnostic =
    var out: Diagnostic
    out.range = range
    out.severity = severity
    out.code = code
    out.source = source
    out.message = message
    return out

# --- Document Symbol types ---

type
    DocumentSymbol =
        name: str
        kind: SymbolKind
        range: Range
        selectionRange: Range
        children: DocumentSymbol[]

    SymbolInformation =
        name: str
        kind: SymbolKind
        location: Location

fn LspMakeDocumentSymbol(name: str, kind: SymbolKind,
                          range: Range,
                          selectionRange: Range,
                          children: DocumentSymbol[]): DocumentSymbol =
    var out: DocumentSymbol
    out.name = name
    out.kind = kind
    out.range = range
    out.selectionRange = selectionRange
    out.children = children
    return out

fn LspMakeSymbolInformation(name: str, kind: SymbolKind,
                             location: Location): SymbolInformation =
    var out: SymbolInformation
    out.name = name
    out.kind = kind
    out.location = location
    return out

# --- Code Action types ---

type
    CodeAction =
        title: str
        kind: str
        diagnostics: int32[]
        edit: json.JsonNode

fn LspMakeCodeAction(title: str, kind: str,
                      diagnostics: int32[],
                      edit: json.JsonNode): CodeAction =
    var out: CodeAction
    out.title = title
    out.kind = kind
    out.diagnostics = diagnostics
    out.edit = edit
    return out

# --- Folding Range types ---

type
    FoldingRange =
        startLine: int32
        endLine: int32
        kind: str

# --- Formatting types ---

type
    FormattingOptions =
        tabSize: int32
        insertSpaces: bool

    TextEdit =
        range: Range
        newText: str

# --- Signature Help types ---

type
    ParameterInformation =
        label: str
        documentation: str

    SignatureInformation =
        label: str
        documentation: str
        parameters: ParameterInformation[]

    SignatureHelp =
        signatures: SignatureInformation[]
        activeSignature: int32
        activeParameter: int32

fn LspMakeParameterInformation(label: str, documentation: str): ParameterInformation =
    var out: ParameterInformation
    out.label = label
    out.documentation = documentation
    return out

fn LspMakeSignatureInformation(label: str, documentation: str,
                                parameters: ParameterInformation[]): SignatureInformation =
    var out: SignatureInformation
    out.label = label
    out.documentation = documentation
    out.parameters = parameters
    return out

fn LspMakeSignatureHelp(signatures: SignatureInformation[],
                         activeSignature: int32,
                         activeParameter: int32): SignatureHelp =
    var out: SignatureHelp
    out.signatures = signatures
    out.activeSignature = activeSignature
    out.activeParameter = activeParameter
    return out

fn LspMakeFoldingRange(startLine: int32, endLine: int32, kind: str): FoldingRange =
    var out: FoldingRange
    out.startLine = startLine
    out.endLine = endLine
    out.kind = kind
    return out

fn LspMakeFormattingOptions(tabSize: int32, insertSpaces: bool): FormattingOptions =
    var out: FormattingOptions
    out.tabSize = tabSize
    out.insertSpaces = insertSpaces
    return out

fn LspMakeTextEdit(range: Range, newText: str): TextEdit =
    var out: TextEdit
    out.range = range
    out.newText = newText
    return out
