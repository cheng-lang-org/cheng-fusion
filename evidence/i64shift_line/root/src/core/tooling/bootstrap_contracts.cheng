fn BootstrapArtifactNew(kind: BootstrapArtifactKind, stage: BootstrapStage,
                          path: str, executable: bool): BootstrapArtifact =
    return BootstrapArtifact(kind: kind, stage: stage, path: path, executable: executable)

@borrows
fn BootstrapSnapshotDefault(rootDir: str): BootstrapSnapshot =
    return BootstrapSnapshot(
        rootDir: strings.CloneStr(rootDir),
        targetTriple: BootstrapDefaultTarget(),
        bootstrapMode: "selfhost",
        stage1Source: BootstrapArtifactNew(
            ArtifactStage1Source, Stage1, BootstrapStage1SourcePath(rootDir), false),
        stage0Compiler: BootstrapArtifactNew(
            ArtifactStage0Compiler, Stage0, BootstrapStage0Path(rootDir), true),
        stage1Compiler: BootstrapArtifactNew(
            ArtifactStage1Compiler, Stage1, BootstrapStage1Path(rootDir), true),
        stage2Compiler: BootstrapArtifactNew(
            ArtifactStage2Compiler, Stage2, BootstrapStage2Path(rootDir), true),
        stage3Compiler: BootstrapArtifactNew(
            ArtifactStage3Compiler, Stage3,
            artifactpaths.ArtifactStage3Path(rootDir), true),
        bootstrapEnv: BootstrapArtifactNew(
            ArtifactBootstrapEnv, Stage3, BootstrapEnvPath(rootDir), false),
        backendDriverOut: BootstrapArtifactNew(
            ArtifactBackendDriver, Stage2, BootstrapBackendDriverOutPath(rootDir), true),
        chainNodeOut: BootstrapArtifactNew(
            ArtifactChainNode, Stage2, BootstrapChainNodeOutPath(rootDir), true)
    )

fn BootstrapStageText(stage: BootstrapStage): str =
    if stage == Stage0:
        return "stage0"
    if stage == Stage1:
        return "stage1"
    if stage == Stage2:
        return "stage2"
    return "stage3"

fn BootstrapArtifactKindText(kind: BootstrapArtifactKind): str =
    if kind == ArtifactStage1Source:
        return "stage1_source"
    if kind == ArtifactStage0Compiler:
        return "stage0"
    if kind == ArtifactStage1Compiler:
        return "stage1"
    if kind == ArtifactStage2Compiler:
        return "stage2"
    if kind == ArtifactStage3Compiler:
        return "stage3"
    if kind == ArtifactBootstrapEnv:
        return "bootstrap_env"
    if kind == ArtifactBackendDriver:
        return "backend_driver"
    return "chain_node"

@borrows
fn BootstrapArtifactReady(artifact: BootstrapArtifact): bool =
    if !os.FileExists(artifact.path):
        return false
    if os.FileSize(artifact.path) > Int64(0):
        return true
    return false

@borrows
fn BootstrapPathSetAdd(out: var str[], pathRaw: str) =
    let path: str = chengpath.PathTrim(pathRaw)
    if Len(path) <= 0:
        return
    for i in 0..<out.len:
        if out[i] == path:
            return
    add(out, path)

@borrows
fn BootstrapAppendOrdinaryClosure(packageRoot: str,
                                    sourcePath: str,
                                    out: var str[],
                                    err: var str): bool =
    var parsed: parser.ParsedSourceStub
    if !parser.ParseOrdinarySourceStub(packageRoot, sourcePath, parsed, err):
        return false
    for i in 0..<parsed.orderedClosureSourcePaths.len:
        BootstrapPathSetAdd(out, parsed.orderedClosureSourcePaths[i])
    err = ""
    return true

@borrows
fn BootstrapOrdinaryClosurePaths(packageRoot: str,
                                   sourcePath: str,
                                   out: var str[],
                                   err: var str): bool =
    out = []
    err = ""
    return BootstrapAppendOrdinaryClosure(packageRoot, sourcePath, out, err)

@borrows
fn BootstrapChainNodeFreshInputPaths(rootDir: str,
                                       out: var str[],
                                       err: var str): bool =
    let packageRoot: str = share(rootDir)
    return BootstrapOrdinaryClosurePaths(packageRoot,
                                           BootstrapChainNodeEntrySourcePath(rootDir),
                                           out,
                                           err)

@borrows
fn BootstrapFreshInputPaths(rootDir: str, out: var str[], err: var str): bool =
    out = []
    err = ""
    BootstrapPathSetAdd(out, BootstrapSeedSourcePath(share(rootDir)))
    BootstrapPathSetAdd(out, BootstrapStage1SourcePath(share(rootDir)))
    BootstrapPathSetAdd(out, BackendSystemLinkExecRuntimeSourcePath(share(rootDir)))
    BootstrapPathSetAdd(out, BackendLineMapSourcePath(share(rootDir)))
    BootstrapPathSetAdd(out, BackendBuildPlanSourcePath(share(rootDir)))
    let packageRoot: str = share(rootDir)
    if !BootstrapAppendOrdinaryClosure(share(packageRoot),
                                         BootstrapCompilerEntrySourcePath(share(rootDir)),
                                         out,
                                         err):
        return false
    if !BootstrapAppendOrdinaryClosure(packageRoot,
                                         BootstrapGateMainSourcePath(rootDir),
                                         out,
                                         err):
        return false
    return true

@borrows
fn BootstrapJoinCsv(items: str[]): str =
    var out = ""
    for i in 0..<items.len:
        if Len(out) > 0:
            out = strutil.Join([out, ","], "")
        out = strutil.Join([out, share(items[i])], "")
    return out

@borrows
fn BootstrapFreshInputPathsCsv(rootDir: str, err: var str): str =
    var paths: str[]
    if !BootstrapFreshInputPaths(rootDir, paths, err):
        return ""
    err = ""
    return BootstrapJoinCsv(paths)

@borrows
fn BootstrapLineValue(text: str, key: str): str =
    let prefix = strutil.Join([share(key), "="], "")
    var start: int32
    for i in 0..text.len:
        var lineEnd = false
        if i == text.len:
            lineEnd = true
        elif text[i] == '\n':
            lineEnd = true
        if lineEnd:
            let line = strings.SliceBytes(text, start, i - start)
            if Len(line) >= Len(prefix):
                if strings.SliceBytes(line, 0, Len(prefix)) == prefix:
                    return strings.SliceBytes(line, Len(prefix), Len(line) - Len(prefix))
            start = i + 1
    return ""

@borrows
fn BootstrapCachedFreshInputPaths(rootDir: str, out: var str[]): bool =
    out = []
    let snapshotPath: str = BootstrapSnapshotPath(rootDir)
    if !chengpath.PathFileExists(snapshotPath):
        return false
    let snapshotText: str = chengpath.ReadTextFile(rootDir, snapshotPath)
    let raw: str = strutil.Strip(BootstrapLineValue(snapshotText, "fresh_input_paths"))
    if Len(raw) <= 0:
        return false
    var start: int32
    let n = Len(raw)
    for i in 0..n:
        var itemEnd = false
        if i == n:
            itemEnd = true
        elif raw[i] == ',':
            itemEnd = true
        if !itemEnd:
            continue
        let item: str = strutil.Strip(strings.SliceBytes(raw, start, i - start))
        if Len(item) > 0:
            BootstrapPathSetAdd(out, item)
        start = i + 1
    if out.len > 0:
        return true
    return false

@borrows
fn BootstrapBridgeReady(snapshot: BootstrapSnapshot): bool =
    if !BootstrapArtifactReady(snapshot.stage2Compiler):
        return false
    if !BootstrapArtifactReady(snapshot.stage3Compiler):
        return false
    if !BootstrapArtifactReady(snapshot.bootstrapEnv):
        return false
    return true

fn BootstrapSnapshotReport(snapshot: BootstrapSnapshot): str =
    var out = ""
    out = strutil.Join([out, "target=", strings.CloneStr(snapshot.targetTriple), "\n"], "")
    out = strutil.Join([out, "bootstrap_kind=", strings.CloneStr(snapshot.bootstrapMode), "\n"], "")
    out = strutil.Join([out, "stage1_source=", strings.CloneStr(snapshot.stage1Source.path), "\n"], "")
    out = strutil.Join([out, "compiler_entry_source=", BootstrapCompilerEntrySourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "compiler_runtime_source=", BootstrapCompilerRuntimeSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "compiler_support_matrix_source=", BootstrapCompilerSupportMatrixSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "compiler_request_source=", BootstrapCompilerRequestSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "tooling_gate_source=", BootstrapGateMainSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "lang_parser_source=", LangParserSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "lang_typed_expr_source=", LangTypedExprSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "core_ir_type_abi_source=", CoreIrTypeAbiSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_system_link_plan_source=", BackendSystemLinkPlanSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_lowering_plan_source=", BackendLoweringPlanSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_primary_object_plan_source=", BackendPrimaryObjectPlanSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_aarch64_encode_source=", BackendA64EncodeSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_direct_object_emit_source=", BackendDirectObjectEmitSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_object_buffer_source=", BackendObjectBufferSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_object_symbols_source=", BackendObjectSymbolsSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_object_relocs_source=", BackendObjectRelocsSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_macho_object_writer_source=", BackendMachOObjectWriterSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_macho_provider_linker_source=", BackendMachOProviderLinkerSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_object_plan_source=", BackendObjectPlanSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_native_link_plan_source=", BackendNativeLinkPlanSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_native_link_exec_source=", BackendNativeLinkExecSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_system_link_exec_source=", BackendSystemLinkExecSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_system_link_exec_runtime_source=", BackendSystemLinkExecRuntimeSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_line_map_source=", BackendLineMapSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_build_plan_source=", BackendBuildPlanSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "runtime_core_runtime_source=", RuntimeCoreRuntimeSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "runtime_compiler_runtime_source=", RuntimeCompilerRuntimeSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "runtime_debug_runtime_source=", RuntimeDebugRuntimeSourcePath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "stage0=", strings.CloneStr(snapshot.stage0Compiler.path), "\n"], "")
    out = strutil.Join([out, "stage1=", strings.CloneStr(snapshot.stage1Compiler.path), "\n"], "")
    out = strutil.Join([out, "stage2=", strings.CloneStr(snapshot.stage2Compiler.path), "\n"], "")
    out = strutil.Join([out, "stage3=", strings.CloneStr(snapshot.stage3Compiler.path), "\n"], "")
    out = strutil.Join([out, "bootstrap_env=", strings.CloneStr(snapshot.bootstrapEnv.path), "\n"], "")
    out = strutil.Join([out, "bootstrap_snapshot=", BootstrapSnapshotPath(snapshot.rootDir), "\n"], "")
    out = strutil.Join([out, "backend_driver_out=", strings.CloneStr(snapshot.backendDriverOut.path), "\n"], "")
    out = strutil.Join([out, "chain_node_out=", strings.CloneStr(snapshot.chainNodeOut.path), "\n"], "")
    return out
