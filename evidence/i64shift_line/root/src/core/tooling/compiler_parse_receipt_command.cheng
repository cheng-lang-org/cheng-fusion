import std/result
import std/os
import std/strings
import cheng/core/lang/parser
import cheng/core/tooling/compiler_parser_receipt as preceipt
import cheng/core/tooling/path as chengpath

@borrows
fn compilerParseReceiptFileSha256Hex(path: str): Result[str] =
    if !os.FileExists(path):
        return Err[str](
            " compiler parse receipt command: driver bytes unavailable")
    let fileBytes = os.ReadFile(strings.CloneStr(path))
    if len(fileBytes) <= 0:
        return Err[str](
            " compiler parse receipt command: driver bytes unavailable")
    let outHex = preceipt.ParserSpanReceiptTextSha256Hex(fileBytes)
    if len(outHex) != 64:
        return Err[str](
            " compiler parse receipt command: driver bytes sha256 invalid")
    return Ok[str](outHex)

fn compilerParseReceiptBuildAndWrite(rootDir: str,
                                    sourcePath: str,
                                    sourceAbs: str,
                                    outPath: str,
                                    driverAbs: str,
                                    packageRoot: str,
                                    sourceSha256: str,
                                    driverSha256: str,
                                    parsed: var parser.ParsedSourceStub):
        Result[str] =
    let manifestRes = preceipt.ParserSpanReceiptToolchainManifestBuild(
        driverAbs, driverSha256, packageRoot, packageRoot)
    if !manifestRes.ok:
        return Err[str](strings.CloneStr(manifestRes.err.msg))
    let jsonRes = preceipt.ParserSpanReceiptJsonBuild(
        parsed.normalizedExprLayer,
        sourcePath,
        sourceAbs,
        sourceSha256,
        driverSha256,
        manifestRes.value,
        parsed.orderedClosureSourcePaths,
        parsed.ownerModulePaths,
        parsed.importEdges)
    if !jsonRes.ok:
        return Err[str](strings.CloneStr(jsonRes.err.msg))
    if !chengpath.WriteTextFile(rootDir, outPath, jsonRes.value):
        return Err[str](
            " compiler parse receipt command: failed to write: " + outPath)
    var nodeCount: int32
    var regionCount: int32
    if parsed.normalizedExprLayer.valueExprTree != nil:
        var summaryTree = parser.ParserValueExprTreeBorrow(
            parsed.normalizedExprLayer.valueExprTree)
        nodeCount = summaryTree.nodeCount
        regionCount = summaryTree.regionCount
        parser.ParserValueExprTreeReleaseBorrow(summaryTree)
    return Ok[str](
        "parse_receipt=1 source=" + sourcePath +
        " nodes=" + strings.IntToStr(nodeCount) +
        " regions=" + strings.IntToStr(regionCount) +
        " out=" + outPath)

fn CompilerParseReceiptCommandRun(rootDir: str,
                                  sourcePath: str,
                                  outPath: str,
                                  driverPath: str): Result[str] =
    if len(rootDir) <= 0:
        return Err[str](" compiler parse receipt command: root missing")
    if len(sourcePath) <= 0:
        return Err[str](" compiler parse receipt command: --in missing")
    if len(outPath) <= 0:
        return Err[str](" compiler parse receipt command: --out missing")
    let packageRoot = chengpath.PathAbsolute(rootDir, ".")
    let sourceAbs = chengpath.PathAbsolute(rootDir, sourcePath)
    let driverAbs = chengpath.PathAbsolute(rootDir, driverPath)
    if !chengpath.FileExistsNonEmpty(rootDir, sourceAbs):
        return Err[str](
            " compiler parse receipt command: source missing: " + sourcePath)
    if !chengpath.FileExistsNonEmpty(rootDir, driverAbs):
        return Err[str](
            " compiler parse receipt command: driver missing: " + driverPath)
    let driverShaRes = compilerParseReceiptFileSha256Hex(
        strings.CloneStr(driverAbs))
    if !driverShaRes.ok:
        return Err[str](strings.CloneStr(driverShaRes.err.msg))
    let driverSha256 = driverShaRes.value
    let sourceText = chengpath.ReadTextFile("", sourceAbs)
    if len(sourceText) <= 0:
        return Err[str](
            " compiler parse receipt command: source read failed: " + sourcePath)
    let sourceSha256 = preceipt.ParserSpanReceiptTextSha256Hex(sourceText)
    var parsed: parser.ParsedSourceStub
    var parseErr: str
    defer:
        var releaseReceipt: parser.ParsedSourceStubTerminalReleaseReceipt
        parser.ParsedSourceStubTerminalReleaseWithReceipt(
            parsed, releaseReceipt)
    if !parser.ParseOrdinarySourceStub(
            strings.CloneStr(packageRoot),
            strings.CloneStr(sourceAbs),
            parsed, parseErr):
        return Err[str](
            " compiler parse receipt command: parse failed:" + parseErr)
    return compilerParseReceiptBuildAndWrite(
        strings.CloneStr(rootDir),
        strings.CloneStr(sourcePath),
        strings.CloneStr(sourceAbs),
        strings.CloneStr(outPath),
        strings.CloneStr(driverAbs),
        strings.CloneStr(packageRoot),
        strings.CloneStr(sourceSha256),
        strings.CloneStr(driverSha256),
        parsed)
