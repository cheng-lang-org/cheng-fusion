-- Determinism driver: compiles source twice with different output paths,
-- compares SHA256, reloc, and cstring for deterministic output.

import std/os
import std/strings
import std/strutils as strutil
import cheng/core/tooling/determinism_gate as detgate
import cheng/core/tooling/gate_main as gateref

@borrows
fn DeterminismGateVerifyBackendDriverOutput(root: str,
                                              sourcePath: str): int32 =
    if !os.FileExists(sourcePath):
        gateref.GatePrintErr(strutil.Join(["determinism_driver: source missing: ", strings.CloneStr(sourcePath)], ""))
        return 1
    let detDir = strutil.Join([strings.CloneStr(root), "/artifacts/determinism"], "")
    os.MkdirAll(strings.CloneStr(detDir), 0x1FF)
    let outPathA = strutil.Join([strings.CloneStr(detDir), "/det_a"], "")
    let outPathB = strutil.Join([strings.CloneStr(detDir), "/det_b"], "")
    let stageCmd = "compile-exe"
    var detArgs: str[]
    add(detArgs, strutil.Join(["--in:", strings.CloneStr(sourcePath)], ""))
    add(detArgs, strutil.Join(["--out:", strings.CloneStr(outPathA)], ""))
    let rcA = gateref.GateRunStage3Command(strings.CloneStr(root),
        "determinism_a",
        stageCmd,
        detArgs,
        "determinism_a.log",
        false)
    if rcA != 0:
        gateref.GatePrintErr(strutil.Join(["determinism_driver: run A exit=", strings.IntToStr(rcA)], ""))
        return 1
    var detArgsB: str[]
    add(detArgsB, strutil.Join(["--in:", strings.CloneStr(sourcePath)], ""))
    add(detArgsB, strutil.Join(["--out:", strings.CloneStr(outPathB)], ""))
    let rcB = gateref.GateRunStage3Command(strings.CloneStr(root),
        "determinism_b",
        stageCmd,
        detArgsB,
        "determinism_b.log",
        false)
    if rcB != 0:
        gateref.GatePrintErr(strutil.Join(["determinism_driver: run B exit=", strings.IntToStr(rcB)], ""))
        return 1
    var gate = detgate.DeterminismGateNew(strings.CloneStr(outPathA), strings.CloneStr(outPathB))
    if !detgate.DeterminismGateVerifyOutputDeterminism(gate):
        gateref.GatePrintErr("determinism_driver: binary SHA mismatch")
        gateref.GatePrintLine(strutil.Strip(gate.report))
        os.RemoveFile(strings.CloneStr(outPathA))
        os.RemoveFile(strings.CloneStr(outPathB))
        return 1
    let relocA = strutil.Join([strings.CloneStr(outPathA), ".reloc"], "")
    let relocB = strutil.Join([strings.CloneStr(outPathB), ".reloc"], "")
    if os.FileExists(relocA) || os.FileExists(relocB):
        if !detgate.DeterminismGateVerifyRelocDeterminism(strings.CloneStr(relocA), strings.CloneStr(relocB)):
            gateref.GatePrintErr("determinism_driver: reloc SHA mismatch")
            os.RemoveFile(strings.CloneStr(outPathA))
            os.RemoveFile(strings.CloneStr(outPathB))
            os.RemoveFile(strings.CloneStr(relocA))
            os.RemoveFile(strings.CloneStr(relocB))
            return 1
        os.RemoveFile(strings.CloneStr(relocA))
        os.RemoveFile(strings.CloneStr(relocB))
    let cstringA = strutil.Join([strings.CloneStr(outPathA), ".cstring"], "")
    let cstringB = strutil.Join([strings.CloneStr(outPathB), ".cstring"], "")
    if os.FileExists(cstringA) || os.FileExists(cstringB):
        if !detgate.DeterminismGateVerifyCstringDeterminism(strings.CloneStr(cstringA), strings.CloneStr(cstringB)):
            gateref.GatePrintErr("determinism_driver: cstring SHA mismatch")
            os.RemoveFile(strings.CloneStr(outPathA))
            os.RemoveFile(strings.CloneStr(outPathB))
            os.RemoveFile(strings.CloneStr(cstringA))
            os.RemoveFile(strings.CloneStr(cstringB))
            return 1
        os.RemoveFile(strings.CloneStr(cstringA))
        os.RemoveFile(strings.CloneStr(cstringB))
    os.RemoveFile(strings.CloneStr(outPathA))
    os.RemoveFile(strings.CloneStr(outPathB))
    gateref.GatePrintLine(" determinism_driver: PASS")
    return 0
