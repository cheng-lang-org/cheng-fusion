import std/result
import std/strutils as strutil
import std/strings as strcore
import cheng/core/tooling/path as chengpath

type
    TomlNodeKind = enum
        TomlTable
        TomlArray
        TomlString
        TomlInt
        TomlBool

    TomlNode =
        kind: TomlNodeKind
        name: str
        strValue: str
        intValue: int32
        boolValue: bool
        children: TomlNode[]
        childCount: int32

fn TomlNodeMake(kind: TomlNodeKind, name: str): TomlNode =
    var out: TomlNode
    out.kind = kind
    out.name = name
    out.strValue = ""
    out.intValue = 0
    out.boolValue = false
    out.children = []
    out.childCount = 0
    return out

fn TomlNodeMakeString(name: str, value: str): TomlNode =
    var out: TomlNode
    out.kind = TomlString
    out.name = name
    out.strValue = value
    out.intValue = 0
    out.boolValue = false
    out.children = []
    out.childCount = 0
    return out

fn TomlNodeMakeInt(name: str, value: int32): TomlNode =
    var out: TomlNode
    out.kind = TomlInt
    out.name = name
    out.strValue = ""
    out.intValue = value
    out.boolValue = false
    out.children = []
    out.childCount = 0
    return out

fn TomlNodeMakeBool(name: str, value: bool): TomlNode =
    var out: TomlNode
    out.kind = TomlBool
    out.name = name
    out.strValue = ""
    out.intValue = 0
    out.boolValue = value
    out.children = []
    out.childCount = 0
    return out

fn TomlNodeAddChild(parent: var TomlNode, child: TomlNode) =
    add(parent.children, child)
    parent.childCount = parent.childCount + 1

fn TomlNodeFindChild(parent: TomlNode, name: str): Result[TomlNode] =
    for i in 0..<parent.childCount:
        if parent.children[i].name == name:
            return Ok[TomlNode](parent.children[i])
    return Err[TomlNode](" toml: child not found")

fn TomlNodeGetString(parent: TomlNode, name: str): Result[str] =
    let childRes = TomlNodeFindChild(parent, name)
    if IsErr(childRes):
        return Err[str](strutil.Join([" toml: string key not found: ", name], ""))
    let child = Value(childRes)
    if child.kind != TomlString:
        return Err[str](strutil.Join([" toml: not a string: ", name], ""))
    return Ok[str](child.strValue)

fn TomlNodeGetInt(parent: TomlNode, name: str): Result[int32] =
    let childRes = TomlNodeFindChild(parent, name)
    if IsErr(childRes):
        return Err[int32](strutil.Join([" toml: int key not found: ", name], ""))
    let child = Value(childRes)
    if child.kind != TomlInt:
        return Err[int32](strutil.Join([" toml: not an int: ", name], ""))
    return Ok[int32](child.intValue)

fn TomlNodeGetBool(parent: TomlNode, name: str): Result[bool] =
    let childRes = TomlNodeFindChild(parent, name)
    if IsErr(childRes):
        return Err[bool](strutil.Join([" toml: bool key not found: ", name], ""))
    let child = Value(childRes)
    if child.kind != TomlBool:
        return Err[bool](strutil.Join([" toml: not a bool: ", name], ""))
    return Ok[bool](child.boolValue)

fn TomlNodeGetTable(parent: TomlNode, name: str): Result[TomlNode] =
    let childRes = TomlNodeFindChild(parent, name)
    if IsErr(childRes):
        return Err[TomlNode](strutil.Join([" toml: table key not found: ", name], ""))
    let child = Value(childRes)
    if child.kind != TomlTable:
        return Err[TomlNode](strutil.Join([" toml: not a table: ", name], ""))
    return Ok[TomlNode](child)

// Parse a TOML basic string (double-quoted, no escape sequences)
fn TomlParseStringValue(raw: str): Result[str] =
    if raw.len < 2 || raw[0] != '"':
        return Err[str](" toml: not a quoted string")
    var end: int32 = 1
    while end < raw.len:
        if raw[end] == '"':
            return Ok[str](chengpath.TextSlice(raw, 1, end - 1))
        if raw[end] == '\\':
            end = end + 1
        end = end + 1
    return Err[str](" toml: unclosed string")

// Parse a TOML integer value
fn TomlParseIntValue(raw: str): Result[int32] =
    var start: int32
    var sign: int32 = 1
    if raw[0] == '+':
        start = 1
    elif raw[0] == '-':
        sign = -1
        start = 1
    if start >= raw.len:
        return Err[int32](" toml: empty integer")
    var value: int32
    for i in start..<raw.len:
        let ch = raw[i]
        if ch < '0' || ch > '9':
            return Err[int32](" toml: invalid integer")
        value = value * 10 + Int32(ch - '0')
    return Ok[int32](value * sign)

// Parse a TOML array value [elem1, elem2, ...]
fn TomlParseArrayValue(name: str, raw: str): Result[TomlNode] =
    var arr = TomlNodeMake(TomlArray, name)
    var i: int32 = 1
    while i < raw.len && raw[i] != ']':
        if raw[i] == ' ' || raw[i] == ',' || raw[i] == '\t' || raw[i] == '\n':
            i = i + 1
            continue
        var j = i
        if raw[j] == '"':
            j = j + 1
            while j < raw.len && raw[j] != '"':
                if raw[j] == '\\':
                    j = j + 1
                j = j + 1
            j = j + 1
        else:
            while j < raw.len && raw[j] != ',' && raw[j] != ']' && raw[j] != ' ' && raw[j] != '\t':
                j = j + 1
        if j > i:
            let elemText = strutil.Strip(chengpath.TextSlice(raw, i, j - i))
            if elemText.len > 0:
                let elemRes = TomlParseValue("", elemText)
                if !IsErr(elemRes):
                    TomlNodeAddChild(arr, Value(elemRes))
        i = j
    return Ok[TomlNode](arr)

// Parse a TOML value (string, int, bool, array) into a node
fn TomlParseValue(name: str, raw: str): Result[TomlNode] =
    let trimmed = strutil.Strip(raw)
    if trimmed.len <= 0:
        return Err[TomlNode](" toml: empty value")

    // Quoted string
    if trimmed[0] == '"':
        let strRes = TomlParseStringValue(trimmed)
        if IsErr(strRes):
            return Err[TomlNode](Error(strRes))
        return Ok[TomlNode](TomlNodeMakeString(name, Value(strRes)))

    // Boolean
    if trimmed == "true":
        return Ok[TomlNode](TomlNodeMakeBool(name, true))
    if trimmed == "false":
        return Ok[TomlNode](TomlNodeMakeBool(name, false))

    // Array
    if trimmed[0] == '[':
        return TomlParseArrayValue(name, trimmed)

    // Integer
    let intRes = TomlParseIntValue(trimmed)
    if !IsErr(intRes):
        return Ok[TomlNode](TomlNodeMakeInt(name, Value(intRes)))

    return Err[TomlNode](strutil.Join([" toml: unknown value: ", trimmed], ""))

// Strip comment from a line (remove everything after # not inside quotes)
fn TomlStripComment(line: str): str =
    if line.len <= 0:
        return line
    var inQuote = false
    for i in 0..<line.len:
        if line[i] == '"':
            inQuote = !inQuote
        if !inQuote && line[i] == '#':
            return strutil.Strip(chengpath.TextSlice(line, 0, i))
    return line

// Parse a TOML document into a tree of TomlNode
// Supports: [section], [[array]], key = value
// Value types: strings, integers, booleans, arrays
fn TomlParse(text: str): TomlNode =
    var root = TomlNodeMake(TomlTable, "")
    var sectName: str
    var sectIdx: int32 = -1

    let lines = strutil.Split(text, '\n')
    for i in 0..<lines.len:
        let rawLine = strutil.Strip(lines[i])
        if rawLine.len <= 0 || rawLine[0] == '#':
            continue

        // Check for section header
        if rawLine[0] == '[':
            // Parse section name from [section] or [[section]]
            var newSect: str
            var closeBracket: int32 = rawLine.len - 1
            if rawLine.len >= 3 && rawLine[1] == '[':
                // [[array]]  (array of tables)
                if rawLine.len >= 4 && rawLine[rawLine.len - 1] == ']' && rawLine[rawLine.len - 2] == ']':
                    newSect = strutil.Strip(chengpath.TextSlice(rawLine, 2, rawLine.len - 4))
                closeBracket = -1
            elif rawLine[rawLine.len - 1] == ']':
                // [section]
                newSect = strutil.Strip(chengpath.TextSlice(rawLine, 1, rawLine.len - 2))
                closeBracket = -1
            if newSect.len > 0:
                sectName = newSect
                // Find or create the section table under root
                sectIdx = -1
                for ci in 0..<root.childCount:
                    if root.children[ci].name == sectName && root.children[ci].kind == TomlTable:
                        sectIdx = ci
                        break
                if sectIdx < 0:
                    var newTable = TomlNodeMake(TomlTable, sectName)
                    TomlNodeAddChild(root, newTable)
                    sectIdx = root.childCount - 1
            continue

        // Key-value pair
        let line = TomlStripComment(rawLine)
        if line.len <= 0:
            continue

        var eqPos: int32 = -1
        for j in 0..<line.len:
            if line[j] == '=':
                eqPos = j
                break
        if eqPos < 0:
            continue

        let key = strutil.Strip(chengpath.TextSlice(line, 0, eqPos))
        if key.len <= 0:
            continue
        let rawVal = chengpath.TextSlice(line, eqPos + 1, line.len - eqPos - 1)
        let valRes = TomlParseValue(key, rawVal)
        if IsErr(valRes):
            continue

        let node = Value(valRes)
        if sectIdx < 0:
            TomlNodeAddChild(root, node)
        else:
            add(root.children[sectIdx].children, node)
            root.children[sectIdx].childCount = root.children[sectIdx].childCount + 1

    return root
