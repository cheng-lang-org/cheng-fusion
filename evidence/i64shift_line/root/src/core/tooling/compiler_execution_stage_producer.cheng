# Canonical sidecar byte producers for the seven execution stages (slice 1).
#
# The canonical schema lives in compiler_execution_stage_receipt.cheng.  This
# module turns the exact per-stage semantic row data that the legacy hex-root
# builders consumed (LoweringSevenStageTypedExprRoot typed-fact SoA columns,
# the csg canonical-graph CID plus graph counts, the lowering plan function
# table, and the backend content symbol table plus per-function regalloc sha
# columns from PrimaryObjectPlanSevenStageReceiptEmit) into canonical byte
# streams, then binds them together with each stage's observed artifact bytes
# through ExecutionStageReceiptMakeObserved.  No driver wiring happens here and
# the rejected legacy emit surface stays inert.
#
# Canonical encoding: every field is length-prefixed (u32 BE length, then the
# payload), int32 as 4 big-endian bytes, int64 as 8 big-endian bytes, raw32 as
# 32 bytes, text as raw bytes.  Every sidecar starts with its stage-distinct
# schema domain string, so equal row content in different stages or lanes can
# never produce equal sidecar bytes.
#
# Artifact byte binding per stage (enforced through the receipt artifact kind):
#   typed_expr        -> typed_expr_fact_table bytes
#   csg               -> compiler_csg_facts bytes
#   lowering          -> lowering_body_ir bytes
#   primary           -> primary_emission_ledger bytes
#   primary_regalloc  -> primary_regalloc_plan_action_fragment_symbol_bytes
#   backend2          -> backend2_emission_ledger bytes
#   backend2_regalloc -> backend2_regalloc_plan_action_fragment_symbol_bytes

import std/rawbytes
import std/result
import cheng/core/tooling/compiler_execution_stage_receipt as execution_receipt
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

type
    # Typed-fact SoA identity columns exactly as carried by the semantic-graph
    # typed-fact table at lowering entry (source row, function row, int64
    # semantic identity certificate, value/place/lowering kind columns).
    ExecutionStageTypedExprSidecarInput =
        typedFactCount: int32
        typedIrFunctionCount: int32
        resolvedCallRowCount: int32
        sourceIndexes: int32[]
        functionIndexes: int32[]
        semanticIdentityCertificates: int64[]
        valueKinds: int32[]
        placeKinds: int32[]
        loweringModes: int32[]

    # Canonical semantic graph identity: the csg CID plus the graph counts the
    # csg stage observes at lowering entry.
    ExecutionStageCsgSidecarInput =
        canonicalGraphCid: layout.FixedBytes32
        nodeCount: int32
        edgeCount: int32
        nodeRowCount: int32
        typedIrFunctionCount: int32

    # Lowering plan function table plus the plan-level counts.
    ExecutionStageLoweringSidecarInput =
        typedIrFunctionCount: int32
        primaryObjectIrFunctionCount: int32
        typedFactCount: int32
        missingReasonCount: int32
        functionNames: str[]

    # Backend content stage (primary or backend2): the emitted symbol table
    # plus the emission counts recorded into the object plan.
    ExecutionStageBackendContentSidecarInput =
        instructionWordCount: int32
        itemCount: int32
        missingReasonCount: int32
        reachableFunctionCount: int32
        symbolNames: str[]

    # Backend regalloc stage (primary or backend2): the per-function symbol,
    # ir-index and kind rows plus the five production sha columns recorded as
    # 64-hex evidence into the object plan, decoded here to raw 32 bytes, and
    # the per-function action counts.
    ExecutionStageBackendRegallocSidecarInput =
        functionSymbols: str[]
        functionIrIndexes: int32[]
        functionKinds: int32[]
        planSha256Hexes: str[]
        machineFragmentRootSha256Hexes: str[]
        abiIngressRootSha256Hexes: str[]
        actionSemanticRootSha256Hexes: str[]
        symbolBytesSha256Hexes: str[]
        actionCounts: int32[]
        registerAssignmentCounts: int32[]
        spillActionCounts: int32[]
        reloadActionCounts: int32[]

fn executionStageProducerAppendU32BE(buf: var layout.ByteBuf,
                                       value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn executionStageProducerAppendU64BE(buf: var layout.ByteBuf,
                                       value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn executionStageProducerAppendText(buf: var layout.ByteBuf, value: str) =
    executionStageProducerAppendU32BE(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

fn executionStageProducerAppendI32(buf: var layout.ByteBuf, value: int32) =
    executionStageProducerAppendU32BE(buf, 4)
    executionStageProducerAppendU32BE(buf, value)

fn executionStageProducerAppendI64(buf: var layout.ByteBuf, value: int64) =
    executionStageProducerAppendU32BE(buf, 8)
    executionStageProducerAppendU64BE(buf, value)

fn executionStageProducerAppendFixed32(buf: var layout.ByteBuf,
                                         value: layout.FixedBytes32) =
    executionStageProducerAppendU32BE(buf, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(buf, value)

fn executionStageProducerRaw32Observed(value: layout.FixedBytes32): bool =
    if layout.FixedBytes32Equal(value, layout.FixedBytes32()):
        return false
    var emptyBuf = layout.ByteBufInit(0)
    let emptyRaw32 = hash256.Sha256Fixed(layout.ByteBufView(emptyBuf))
    layout.ByteBufFree(emptyBuf)
    return !layout.FixedBytes32Equal(value, emptyRaw32)

fn executionStageProducerFinishBytes(buf: var layout.ByteBuf): rawbytes.Bytes =
    let out = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    return out

fn ExecutionStageProducerTypedExprSidecarBytes(
        input: ExecutionStageTypedExprSidecarInput): Result[rawbytes.Bytes] =
    if input.typedFactCount < 0 ||
       input.typedIrFunctionCount < 0 ||
       input.resolvedCallRowCount < 0:
        return Err[rawbytes.Bytes](
            " execution stage producer: typed_expr count is negative")
    let rowCount = input.sourceIndexes.len
    if input.functionIndexes.len != rowCount ||
       input.semanticIdentityCertificates.len != rowCount ||
       input.valueKinds.len != rowCount ||
       input.placeKinds.len != rowCount ||
       input.loweringModes.len != rowCount:
        return Err[rawbytes.Bytes](
            " execution stage producer: typed_expr fact columns disagree")
    var buf = layout.ByteBufInit(256)
    executionStageProducerAppendText(
        buf, execution_receipt.ExecutionStageReceiptTypedExprSidecarSchema)
    executionStageProducerAppendI32(buf, input.typedFactCount)
    executionStageProducerAppendI32(buf, input.typedIrFunctionCount)
    executionStageProducerAppendI32(buf, input.resolvedCallRowCount)
    executionStageProducerAppendI32(buf, rowCount)
    for index in 0..<rowCount:
        executionStageProducerAppendI32(buf, input.sourceIndexes[index])
        executionStageProducerAppendI32(buf, input.functionIndexes[index])
        executionStageProducerAppendI64(
            buf, input.semanticIdentityCertificates[index])
        executionStageProducerAppendI32(buf, input.valueKinds[index])
        executionStageProducerAppendI32(buf, input.placeKinds[index])
        executionStageProducerAppendI32(buf, input.loweringModes[index])
    return Ok[rawbytes.Bytes](executionStageProducerFinishBytes(buf))

fn ExecutionStageProducerCsgSidecarBytes(
        input: ExecutionStageCsgSidecarInput): Result[rawbytes.Bytes] =
    if !executionStageProducerRaw32Observed(input.canonicalGraphCid):
        return Err[rawbytes.Bytes](
            " execution stage producer: csg canonical graph cid is absent")
    if input.nodeCount < 0 ||
       input.edgeCount < 0 ||
       input.nodeRowCount < 0 ||
       input.typedIrFunctionCount < 0:
        return Err[rawbytes.Bytes](
            " execution stage producer: csg count is negative")
    var buf = layout.ByteBufInit(256)
    executionStageProducerAppendText(
        buf, execution_receipt.ExecutionStageReceiptCsgSidecarSchema)
    executionStageProducerAppendFixed32(buf, input.canonicalGraphCid)
    executionStageProducerAppendI32(buf, input.nodeCount)
    executionStageProducerAppendI32(buf, input.edgeCount)
    executionStageProducerAppendI32(buf, input.nodeRowCount)
    executionStageProducerAppendI32(buf, input.typedIrFunctionCount)
    return Ok[rawbytes.Bytes](executionStageProducerFinishBytes(buf))

fn ExecutionStageProducerLoweringSidecarBytes(
        input: ExecutionStageLoweringSidecarInput): Result[rawbytes.Bytes] =
    if input.typedIrFunctionCount < 0 ||
       input.primaryObjectIrFunctionCount < 0 ||
       input.typedFactCount < 0 ||
       input.missingReasonCount < 0:
        return Err[rawbytes.Bytes](
            " execution stage producer: lowering count is negative")
    for index in 0..<input.functionNames.len:
        if input.functionNames[index].len <= 0:
            return Err[rawbytes.Bytes](
                " execution stage producer: lowering function name is empty")
    var buf = layout.ByteBufInit(256)
    executionStageProducerAppendText(
        buf, execution_receipt.ExecutionStageReceiptLoweringSidecarSchema)
    executionStageProducerAppendI32(buf, input.typedIrFunctionCount)
    executionStageProducerAppendI32(buf, input.primaryObjectIrFunctionCount)
    executionStageProducerAppendI32(buf, input.typedFactCount)
    executionStageProducerAppendI32(buf, input.missingReasonCount)
    executionStageProducerAppendI32(buf, input.functionNames.len)
    for index in 0..<input.functionNames.len:
        executionStageProducerAppendText(buf, input.functionNames[index])
    return Ok[rawbytes.Bytes](executionStageProducerFinishBytes(buf))

fn ExecutionStageProducerBackendContentSidecarBytes(
        stageKind: str,
        input: ExecutionStageBackendContentSidecarInput): Result[rawbytes.Bytes] =
    if stageKind != execution_receipt.ExecutionStageReceiptStagePrimary &&
       stageKind != execution_receipt.ExecutionStageReceiptStageBackend2:
        return Err[rawbytes.Bytes](
            " execution stage producer: content stage kind invalid")
    if input.instructionWordCount < 0 ||
       input.itemCount < 0 ||
       input.missingReasonCount < 0 ||
       input.reachableFunctionCount < 0:
        return Err[rawbytes.Bytes](
            " execution stage producer: content count is negative")
    for index in 0..<input.symbolNames.len:
        if input.symbolNames[index].len <= 0:
            return Err[rawbytes.Bytes](
                " execution stage producer: content symbol name is empty")
    var buf = layout.ByteBufInit(256)
    executionStageProducerAppendText(
        buf,
        execution_receipt.ExecutionStageReceiptSidecarSchemaExpected(stageKind))
    executionStageProducerAppendI32(buf, input.instructionWordCount)
    executionStageProducerAppendI32(buf, input.itemCount)
    executionStageProducerAppendI32(buf, input.missingReasonCount)
    executionStageProducerAppendI32(buf, input.reachableFunctionCount)
    executionStageProducerAppendI32(buf, input.symbolNames.len)
    for index in 0..<input.symbolNames.len:
        executionStageProducerAppendText(buf, input.symbolNames[index])
    return Ok[rawbytes.Bytes](executionStageProducerFinishBytes(buf))

@borrows
fn executionStageProducerRegallocShaColumnAppend(
        buf: var layout.ByteBuf,
        hexes: str[],
        rowIndex: int32): Result[bool] =
    let raw32Res = layout.FixedBytes32FromHex(hexes[rowIndex])
    if IsErr(raw32Res):
        return Err[bool](
            " execution stage producer: regalloc sha column is not 64-hex")
    let raw32 = Value(raw32Res)
    if !executionStageProducerRaw32Observed(raw32):
        return Err[bool](
            " execution stage producer: regalloc sha column is a placeholder")
    executionStageProducerAppendFixed32(buf, raw32)
    return Ok[bool](true)

fn ExecutionStageProducerBackendRegallocSidecarBytes(
        stageKind: str,
        input: ExecutionStageBackendRegallocSidecarInput): Result[rawbytes.Bytes] =
    if stageKind !=
           execution_receipt.ExecutionStageReceiptStagePrimaryRegalloc &&
       stageKind !=
           execution_receipt.ExecutionStageReceiptStageBackend2Regalloc:
        return Err[rawbytes.Bytes](
            " execution stage producer: regalloc stage kind invalid")
    let rowCount = input.functionSymbols.len
    if input.functionIrIndexes.len != rowCount ||
       input.functionKinds.len != rowCount ||
       input.planSha256Hexes.len != rowCount ||
       input.machineFragmentRootSha256Hexes.len != rowCount ||
       input.abiIngressRootSha256Hexes.len != rowCount ||
       input.actionSemanticRootSha256Hexes.len != rowCount ||
       input.symbolBytesSha256Hexes.len != rowCount ||
       input.actionCounts.len != rowCount ||
       input.registerAssignmentCounts.len != rowCount ||
       input.spillActionCounts.len != rowCount ||
       input.reloadActionCounts.len != rowCount:
        return Err[rawbytes.Bytes](
            " execution stage producer: regalloc function columns disagree")
    for index in 0..<rowCount:
        if input.functionSymbols[index].len <= 0:
            return Err[rawbytes.Bytes](
                " execution stage producer: regalloc function symbol is empty")
        if input.actionCounts[index] < 0 ||
           input.registerAssignmentCounts[index] < 0 ||
           input.spillActionCounts[index] < 0 ||
           input.reloadActionCounts[index] < 0:
            return Err[rawbytes.Bytes](
                " execution stage producer: regalloc count is negative")
    var buf = layout.ByteBufInit(512)
    executionStageProducerAppendText(
        buf,
        execution_receipt.ExecutionStageReceiptSidecarSchemaExpected(stageKind))
    executionStageProducerAppendI32(buf, rowCount)
    for index in 0..<rowCount:
        executionStageProducerAppendText(buf, input.functionSymbols[index])
        executionStageProducerAppendI32(buf, input.functionIrIndexes[index])
        executionStageProducerAppendI32(buf, input.functionKinds[index])
        let planRes = executionStageProducerRegallocShaColumnAppend(
            buf, input.planSha256Hexes, index)
        if IsErr(planRes):
            layout.ByteBufFree(buf)
            return Err[rawbytes.Bytes](Error(planRes))
        let machineRes = executionStageProducerRegallocShaColumnAppend(
            buf, input.machineFragmentRootSha256Hexes, index)
        if IsErr(machineRes):
            layout.ByteBufFree(buf)
            return Err[rawbytes.Bytes](Error(machineRes))
        let abiRes = executionStageProducerRegallocShaColumnAppend(
            buf, input.abiIngressRootSha256Hexes, index)
        if IsErr(abiRes):
            layout.ByteBufFree(buf)
            return Err[rawbytes.Bytes](Error(abiRes))
        let actionRes = executionStageProducerRegallocShaColumnAppend(
            buf, input.actionSemanticRootSha256Hexes, index)
        if IsErr(actionRes):
            layout.ByteBufFree(buf)
            return Err[rawbytes.Bytes](Error(actionRes))
        let symbolBytesRes = executionStageProducerRegallocShaColumnAppend(
            buf, input.symbolBytesSha256Hexes, index)
        if IsErr(symbolBytesRes):
            layout.ByteBufFree(buf)
            return Err[rawbytes.Bytes](Error(symbolBytesRes))
        executionStageProducerAppendI32(buf, input.actionCounts[index])
        executionStageProducerAppendI32(
            buf, input.registerAssignmentCounts[index])
        executionStageProducerAppendI32(buf, input.spillActionCounts[index])
        executionStageProducerAppendI32(buf, input.reloadActionCounts[index])
    return Ok[rawbytes.Bytes](executionStageProducerFinishBytes(buf))

# Links a produced sidecar to its verified predecessor receipt and binds the
# observed artifact bytes.  Stage kind, lane, predecessor kind, sidecar schema
# and artifact kind are all derived from the canonical schema tables; callers
# cannot cross lanes or reorder the seven-stage DAG through this surface.
fn executionStageProducerLinkedMakeObserved(
        identity: execution_receipt.CompilerExecutionIdentity,
        stageKind: str,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        sidecarPath: str,
        sidecarBytes: rawbytes.Bytes,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    let predecessorRes = execution_receipt.ExecutionStageReceiptVerify(
        predecessor)
    if IsErr(predecessorRes):
        return Err[execution_receipt.ExecutionStageReceipt](
            Error(predecessorRes))
    if predecessor.stageKind !=
       execution_receipt.ExecutionStageReceiptPredecessorExpected(stageKind):
        return Err[execution_receipt.ExecutionStageReceipt](
            " execution stage producer: predecessor stage kind mismatch")
    if !layout.FixedBytes32Equal(predecessor.executionRaw32,
                                 identity.executionRaw32):
        return Err[execution_receipt.ExecutionStageReceipt](
            " execution stage producer: predecessor execution identity drift")
    return execution_receipt.ExecutionStageReceiptMakeObserved(
        identity,
        stageKind,
        execution_receipt.ExecutionStageReceiptLaneExpected(stageKind),
        producerSourceBytes,
        predecessor.stageKind,
        predecessor.receiptRaw32,
        predecessor.outputSemanticRaw32,
        sidecarPath,
        sidecarBytes,
        artifactPath,
        artifactBytes)

fn executionStageProducerFinishLinkedProduce(
        identity: execution_receipt.CompilerExecutionIdentity,
        stageKind: str,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        sidecarPath: str,
        sidecarBytesRes: Result[rawbytes.Bytes],
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    if IsErr(sidecarBytesRes):
        return Err[execution_receipt.ExecutionStageReceipt](
            Error(sidecarBytesRes))
    var sidecarBytes = Value(sidecarBytesRes)
    let receiptRes = executionStageProducerLinkedMakeObserved(
        identity,
        stageKind,
        producerSourceBytes,
        predecessor,
        sidecarPath,
        sidecarBytes,
        artifactPath,
        artifactBytes)
    if IsErr(receiptRes):
        rawbytes.BytesFree(sidecarBytes)
        return Err[execution_receipt.ExecutionStageReceipt](Error(receiptRes))
    sidecarBytesOut = sidecarBytes
    return receiptRes

# Stage 1 (typed_expr, shared lane): predecessor is the parser receipt pair.
# Artifact bytes must be the real typed_expr fact-table byte stream.
fn ExecutionStageProducerTypedExprProduce(
        identity: execution_receipt.CompilerExecutionIdentity,
        producerSourceBytes: rawbytes.Bytes,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        input: ExecutionStageTypedExprSidecarInput,
        sidecarPath: str,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    if !executionStageProducerRaw32Observed(parserReceiptRaw32) ||
       !executionStageProducerRaw32Observed(parserSemanticRaw32):
        return Err[execution_receipt.ExecutionStageReceipt](
            " execution stage producer: parser prerequisite absent")
    let sidecarBytesRes = ExecutionStageProducerTypedExprSidecarBytes(input)
    if IsErr(sidecarBytesRes):
        return Err[execution_receipt.ExecutionStageReceipt](
            Error(sidecarBytesRes))
    var sidecarBytes = Value(sidecarBytesRes)
    let receiptRes = execution_receipt.ExecutionStageReceiptMakeObserved(
        identity,
        execution_receipt.ExecutionStageReceiptStageTypedExpr,
        execution_receipt.ExecutionStageReceiptLaneShared,
        producerSourceBytes,
        execution_receipt.ExecutionStageReceiptStageParser,
        parserReceiptRaw32,
        parserSemanticRaw32,
        sidecarPath,
        sidecarBytes,
        artifactPath,
        artifactBytes)
    if IsErr(receiptRes):
        rawbytes.BytesFree(sidecarBytes)
        return Err[execution_receipt.ExecutionStageReceipt](Error(receiptRes))
    sidecarBytesOut = sidecarBytes
    return receiptRes

# Stage 2 (csg, shared lane): predecessor is the typed_expr receipt.
# Artifact bytes must be the real compiler csg facts byte stream.
fn ExecutionStageProducerCsgProduce(
        identity: execution_receipt.CompilerExecutionIdentity,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        input: ExecutionStageCsgSidecarInput,
        sidecarPath: str,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    return executionStageProducerFinishLinkedProduce(
        identity,
        execution_receipt.ExecutionStageReceiptStageCsg,
        producerSourceBytes,
        predecessor,
        sidecarPath,
        ExecutionStageProducerCsgSidecarBytes(input),
        artifactPath,
        artifactBytes,
        sidecarBytesOut)

# Stage 3 (lowering, shared lane): predecessor is the csg receipt.
# Artifact bytes must be the real lowering body-ir byte stream.
fn ExecutionStageProducerLoweringProduce(
        identity: execution_receipt.CompilerExecutionIdentity,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        input: ExecutionStageLoweringSidecarInput,
        sidecarPath: str,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    return executionStageProducerFinishLinkedProduce(
        identity,
        execution_receipt.ExecutionStageReceiptStageLowering,
        producerSourceBytes,
        predecessor,
        sidecarPath,
        ExecutionStageProducerLoweringSidecarBytes(input),
        artifactPath,
        artifactBytes,
        sidecarBytesOut)

# Stage 4 (primary, primary lane): predecessor is the lowering receipt.
# Artifact bytes must be the real primary emission ledger byte stream.
fn ExecutionStageProducerPrimaryProduce(
        identity: execution_receipt.CompilerExecutionIdentity,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        input: ExecutionStageBackendContentSidecarInput,
        sidecarPath: str,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    return executionStageProducerFinishLinkedProduce(
        identity,
        execution_receipt.ExecutionStageReceiptStagePrimary,
        producerSourceBytes,
        predecessor,
        sidecarPath,
        ExecutionStageProducerBackendContentSidecarBytes(
            execution_receipt.ExecutionStageReceiptStagePrimary, input),
        artifactPath,
        artifactBytes,
        sidecarBytesOut)

# Stage 5 (primary_regalloc, primary lane): predecessor is the primary receipt.
# Artifact bytes must be the real primary regalloc
# plan-action-fragment-symbol byte stream.
fn ExecutionStageProducerPrimaryRegallocProduce(
        identity: execution_receipt.CompilerExecutionIdentity,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        input: ExecutionStageBackendRegallocSidecarInput,
        sidecarPath: str,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    return executionStageProducerFinishLinkedProduce(
        identity,
        execution_receipt.ExecutionStageReceiptStagePrimaryRegalloc,
        producerSourceBytes,
        predecessor,
        sidecarPath,
        ExecutionStageProducerBackendRegallocSidecarBytes(
            execution_receipt.ExecutionStageReceiptStagePrimaryRegalloc,
            input),
        artifactPath,
        artifactBytes,
        sidecarBytesOut)

# Stage 6 (backend2, backend2 lane): predecessor is the lowering receipt (the
# canonical DAG branches at lowering; ordinal 6 links back to ordinal 3).
# Artifact bytes must be the real backend2 emission ledger byte stream.
fn ExecutionStageProducerBackend2Produce(
        identity: execution_receipt.CompilerExecutionIdentity,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        input: ExecutionStageBackendContentSidecarInput,
        sidecarPath: str,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    return executionStageProducerFinishLinkedProduce(
        identity,
        execution_receipt.ExecutionStageReceiptStageBackend2,
        producerSourceBytes,
        predecessor,
        sidecarPath,
        ExecutionStageProducerBackendContentSidecarBytes(
            execution_receipt.ExecutionStageReceiptStageBackend2, input),
        artifactPath,
        artifactBytes,
        sidecarBytesOut)

# Stage 7 (backend2_regalloc, backend2 lane): predecessor is the backend2
# receipt.  Artifact bytes must be the real backend2 regalloc
# plan-action-fragment-symbol byte stream.
fn ExecutionStageProducerBackend2RegallocProduce(
        identity: execution_receipt.CompilerExecutionIdentity,
        producerSourceBytes: rawbytes.Bytes,
        predecessor: execution_receipt.ExecutionStageReceipt,
        input: ExecutionStageBackendRegallocSidecarInput,
        sidecarPath: str,
        artifactPath: str,
        artifactBytes: rawbytes.Bytes,
        sidecarBytesOut: var rawbytes.Bytes): Result[execution_receipt.ExecutionStageReceipt] =
    return executionStageProducerFinishLinkedProduce(
        identity,
        execution_receipt.ExecutionStageReceiptStageBackend2Regalloc,
        producerSourceBytes,
        predecessor,
        sidecarPath,
        ExecutionStageProducerBackendRegallocSidecarBytes(
            execution_receipt.ExecutionStageReceiptStageBackend2Regalloc,
            input),
        artifactPath,
        artifactBytes,
        sidecarBytesOut)
