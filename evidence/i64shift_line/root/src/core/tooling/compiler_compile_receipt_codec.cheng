import std/result
import std/rawbytes
import std/strutils as strutil
import std/strings
import cheng/std/bytes_layout as layout
import std/crypto/hash256

type
    CompileReceipt =
        worldHeadCid: layout.FixedBytes32
        sourceIdentityReceiptCid: layout.FixedBytes32
        semanticReceiptCid: layout.FixedBytes32
        targetTriple: str
        outputDigest: layout.FixedBytes32
        canonicalOutputDigest: layout.FixedBytes32
        bootstrapStage: str
        runtimeProviderSet: str[]
        receiptCid: layout.FixedBytes32

fn compileReceiptCodecAppendU32BE(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn compileReceiptCodecAppendText(
        buf: var layout.ByteBuf,
        text: str) =
    compileReceiptCodecAppendU32BE(buf, text.len)
    for index in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[index])

fn compileReceiptCodecAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    compileReceiptCodecAppendU32BE(buf, 32)
    layout.ByteBufAppendFixed32(buf, value)

fn compileReceiptCodecAppendU32Field(
        buf: var layout.ByteBuf,
        value: int32) =
    compileReceiptCodecAppendU32BE(buf, 4)
    compileReceiptCodecAppendU32BE(buf, value)

@borrows
fn CompileReceiptCodecCid(
        receipt: CompileReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(384)
    compileReceiptCodecAppendText(buf, "cheng.compiler.compile_receipt")
    compileReceiptCodecAppendFixed32Field(buf, receipt.worldHeadCid)
    compileReceiptCodecAppendFixed32Field(
        buf, receipt.sourceIdentityReceiptCid)
    compileReceiptCodecAppendFixed32Field(buf, receipt.semanticReceiptCid)
    compileReceiptCodecAppendFixed32Field(buf, receipt.outputDigest)
    compileReceiptCodecAppendFixed32Field(
        buf, receipt.canonicalOutputDigest)
    compileReceiptCodecAppendText(buf, receipt.targetTriple)
    compileReceiptCodecAppendText(buf, receipt.bootstrapStage)
    compileReceiptCodecAppendU32Field(buf, receipt.runtimeProviderSet.len)
    for providerIndex in 0..<receipt.runtimeProviderSet.len:
        compileReceiptCodecAppendText(
            buf, receipt.runtimeProviderSet[providerIndex])
    let cid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return cid

@borrows
fn compileReceiptCodecTextValid(value: str): bool =
    if value == "" || strutil.Strip(value) != value:
        return false
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 || code == 127:
            return false
    return true

@borrows
fn compileReceiptCodecTextLess(left: str, right: str): bool =
    if left == right:
        return false
    var sharedLen = right.len
    if left.len < right.len:
        sharedLen = left.len
    for index in 0..<sharedLen:
        if left[index] == right[index]:
            continue
        return left[index] < right[index]
    return left.len < right.len

@borrows
fn CompileReceiptCodecStrictValidateInto(
        receipt: CompileReceipt,
        err: var str): bool =
    if layout.FixedBytes32Equal(
           receipt.worldHeadCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.sourceIdentityReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.semanticReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.outputDigest, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.canonicalOutputDigest, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           receipt.receiptCid, layout.FixedBytes32()):
        err = " compiler compile receipt: zero portable cid"
        return false
    if !compileReceiptCodecTextValid(receipt.targetTriple) ||
       !compileReceiptCodecTextValid(receipt.bootstrapStage):
        err = " compiler compile receipt: target/stage identity invalid"
        return false
    for providerIndex in 0..<receipt.runtimeProviderSet.len:
        if !compileReceiptCodecTextValid(
               receipt.runtimeProviderSet[providerIndex]):
            err = " compiler compile receipt: provider identity invalid"
            return false
        if providerIndex > 0 &&
           !compileReceiptCodecTextLess(
               receipt.runtimeProviderSet[providerIndex - 1],
               receipt.runtimeProviderSet[providerIndex]):
            err = " compiler compile receipt: provider order invalid"
            return false
    if !layout.FixedBytes32Equal(
           receipt.receiptCid, CompileReceiptCodecCid(receipt)):
        err = " compiler compile receipt: receipt cid mismatch"
        return false
    err = ""
    return true

@borrows
fn compileReceiptCodecReportAppend(
        buf: var layout.ByteBuf,
        value: str) =
    layout.ByteBufAppendBytes(buf, rawbytes.BytesFromString(value))

fn compileReceiptCodecReportTake(buf: var layout.ByteBuf): str =
    let out = rawbytes.BytesToString(layout.ByteBufView(buf).data)
    layout.ByteBufFree(buf)
    return out

@borrows
fn CompileReceiptCodecProviderReportLine(
        provider: str,
        index: int32): str =
    var buf = layout.ByteBufInit(64)
    compileReceiptCodecReportAppend(buf, "runtime_provider[")
    compileReceiptCodecReportAppend(buf, IntToStr(index))
    compileReceiptCodecReportAppend(buf, "]=")
    compileReceiptCodecReportAppend(buf, provider)
    return compileReceiptCodecReportTake(buf)

@borrows
fn CompileReceiptCodecReport(receipt: CompileReceipt): str =
    var buf = layout.ByteBufInit(512)
    compileReceiptCodecReportAppend(buf, "world_head_cid=")
    compileReceiptCodecReportAppend(
        buf, layout.FixedBytes32Hex(receipt.worldHeadCid))
    compileReceiptCodecReportAppend(buf, "\nsource_identity_receipt_cid=")
    compileReceiptCodecReportAppend(
        buf, layout.FixedBytes32Hex(receipt.sourceIdentityReceiptCid))
    compileReceiptCodecReportAppend(buf, "\nsemantic_receipt_cid=")
    compileReceiptCodecReportAppend(
        buf, layout.FixedBytes32Hex(receipt.semanticReceiptCid))
    compileReceiptCodecReportAppend(buf, "\ntarget=")
    compileReceiptCodecReportAppend(buf, receipt.targetTriple)
    compileReceiptCodecReportAppend(buf, "\noutput_raw_sha256=")
    compileReceiptCodecReportAppend(
        buf, layout.FixedBytes32Hex(receipt.outputDigest))
    compileReceiptCodecReportAppend(buf, "\ncanonical_output_sha256=")
    compileReceiptCodecReportAppend(
        buf, layout.FixedBytes32Hex(receipt.canonicalOutputDigest))
    compileReceiptCodecReportAppend(buf, "\nbootstrap_stage=")
    compileReceiptCodecReportAppend(buf, receipt.bootstrapStage)
    compileReceiptCodecReportAppend(buf, "\nruntime_provider_count=")
    compileReceiptCodecReportAppend(
        buf, IntToStr(receipt.runtimeProviderSet.len))
    compileReceiptCodecReportAppend(buf, "\nreceipt_cid=")
    compileReceiptCodecReportAppend(
        buf, layout.FixedBytes32Hex(receipt.receiptCid))
    for providerIndex in 0..<receipt.runtimeProviderSet.len:
        compileReceiptCodecReportAppend(buf, "\n")
        compileReceiptCodecReportAppend(
            buf,
            CompileReceiptCodecProviderReportLine(
                receipt.runtimeProviderSet[providerIndex], providerIndex))
    return compileReceiptCodecReportTake(buf)

@borrows
fn compileReceiptCodecStartsWith(text: str, prefix: str): bool =
    if text.len < prefix.len:
        return false
    for index in 0..<prefix.len:
        if text[index] != prefix[index]:
            return false
    return true

@borrows
fn compileReceiptCodecLineValue(text: str, key: str): str =
    let lines = strutil.Split(text, '\n')
    for lineIndex in 0..<lines.len:
        let line = strutil.Strip(lines[lineIndex])
        if line.len <= key.len || line[key.len] != '=':
            continue
        var matched = true
        for keyIndex in 0..<key.len:
            if line[keyIndex] != key[keyIndex]:
                matched = false
                break
        if matched:
            return strutil.Strip(
                strutil.SliceStr(line, key.len + 1, line.len - 1))
    return ""

@borrows
fn compileReceiptCodecParseCount(text: str, outOk: var bool): int32 =
    outOk = false
    if text.len <= 0:
        return 0
    var value: int32
    for index in 0..<text.len:
        if text[index] < '0' || text[index] > '9' ||
           value > 214748364 ||
           (value == 214748364 && text[index] > '7'):
            return 0
        value = value * 10 + Int32(text[index]) - Int32('0')
    outOk = true
    return value

@borrows
fn CompileReceiptCodecDecodeStrictInto(
        canonical: str,
        out: var CompileReceipt,
        err: var str): bool =
    let worldHead = layout.FixedBytes32FromHex(
        compileReceiptCodecLineValue(canonical, "world_head_cid"))
    let sourceIdentity = layout.FixedBytes32FromHex(
        compileReceiptCodecLineValue(
            canonical, "source_identity_receipt_cid"))
    let semantic = layout.FixedBytes32FromHex(
        compileReceiptCodecLineValue(canonical, "semantic_receipt_cid"))
    let outputRaw = layout.FixedBytes32FromHex(
        compileReceiptCodecLineValue(canonical, "output_raw_sha256"))
    let canonicalOutput = layout.FixedBytes32FromHex(
        compileReceiptCodecLineValue(
            canonical, "canonical_output_sha256"))
    let receiptCid = layout.FixedBytes32FromHex(
        compileReceiptCodecLineValue(canonical, "receipt_cid"))
    if IsErr(worldHead) || IsErr(sourceIdentity) || IsErr(semantic) ||
       IsErr(outputRaw) || IsErr(canonicalOutput) || IsErr(receiptCid):
        err = " compiler compile receipt: invalid cid text"
        return false
    var next: CompileReceipt
    next.worldHeadCid = Value(worldHead)
    next.sourceIdentityReceiptCid = Value(sourceIdentity)
    next.semanticReceiptCid = Value(semantic)
    next.targetTriple = compileReceiptCodecLineValue(canonical, "target")
    next.outputDigest = Value(outputRaw)
    next.canonicalOutputDigest = Value(canonicalOutput)
    next.bootstrapStage =
        compileReceiptCodecLineValue(canonical, "bootstrap_stage")
    let lines = strutil.Split(canonical, '\n')
    for lineIndex in 0..<lines.len:
        let line = strutil.Strip(lines[lineIndex])
        if !compileReceiptCodecStartsWith(line, "runtime_provider["):
            continue
        var equalIndex: int32 = -1
        for charIndex in 0..<line.len:
            if line[charIndex] == '=':
                equalIndex = charIndex
                break
        if equalIndex <= 17 || equalIndex >= line.len - 1:
            err = " compiler compile receipt: malformed provider row"
            return false
        let expectedKey =
            "runtime_provider[" + IntToStr(next.runtimeProviderSet.len) + "]"
        if strutil.SliceStr(line, 0, equalIndex - 1) != expectedKey:
            err = " compiler compile receipt: provider index invalid"
            return false
        add(
            next.runtimeProviderSet,
            strutil.SliceStr(line, equalIndex + 1, line.len - 1))
    var countOk = false
    let providerCount = compileReceiptCodecParseCount(
        compileReceiptCodecLineValue(canonical, "runtime_provider_count"),
        countOk)
    if !countOk || providerCount != next.runtimeProviderSet.len:
        err = " compiler compile receipt: provider count mismatch"
        return false
    next.receiptCid = Value(receiptCid)
    if !CompileReceiptCodecStrictValidateInto(next, err):
        return false
    let reencoded = CompileReceiptCodecReport(next)
    if canonical != reencoded && canonical != reencoded + "\n":
        err = " compiler compile receipt: non-canonical bytes"
        return false
    out = next
    err = ""
    return true
