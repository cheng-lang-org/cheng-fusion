fn WriteTextFileWithHandleHostBridge(root: str, raw: str, text: str): bool =
    if raw.len <= 0:
        return false
    var path: str
    if raw[0] == '/':
        path = raw
    elif raw.len >= 3 && PathIsAsciiDrive(raw[0]) && raw[1] == ':' && PathIsSepChar(raw[2]):
        path = raw
    elif root.len > 0:
        path = PathJoin(root, raw)
    else:
        path = PathJoin(PathCurrentDir(), raw)
    let hostPath = PathHostFilePath(path)
    var openErr: str
    let openPath = share(hostPath)
    let handle = PathFileHandleOpenWriteTruncateBridge(openPath, openErr)
    if handle == uint64(0):
        return false
    var writeErr: str
    let writeRc = PathHostFileHandleWriteAll(handle, text, text.len, writeErr)
    var closeErr: str
    let closeRc = PathFileHandleCloseBridge(handle, closeErr)
    if writeRc == 0 || closeRc == 0:
        return false
