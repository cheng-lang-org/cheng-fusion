fn WriteRootedTextFile(root: str, raw: str, text: str): bool =
    let path: str = PathRootedAbsolute(root, raw)
    if !PathNonEmpty(path):
        return false
    let parent: str = PathParentDir(path)
    if PathNonEmpty(parent):
        if !PathCreateDirAll(parent):
            return false
    let hostPath = PathHostFilePath(path)
    PathWriteTextFileBridge(hostPath, text)
    return os.FileExists(hostPath)

# Read-only over `root`/`raw`: both are only joined into a fresh absolute
# path (PathAbsolute already borrows them); neither is rebound or released.
fn ReadTextFile(root: str, raw: str): str =
    return PathReadTextFileWithHandle(PathAbsolute(root, raw))

@borrows
fn ReadTextFileViaHandle(raw: str): str =
    return PathReadTextFileWithHandle(raw)

@borrows
fn ReadRootedTextFile(root: str, raw: str): str =
    let path: str = PathRootedAbsolute(root, raw)
    if !PathNonEmpty(path):
        return ""
    return PathReadTextFileWithHandle(path)

@borrows
fn PathCStringFromText(text: str): cstring =
    let n = StrLenFast(text)
    if n <= 0:
        return PathCStringAlloc(0)
    let out = PathCStringAlloc(n)
    let raw = StrDataPtr(text)
    if out == nil || raw == nil:
        return out
    for i in 0..<n:
        rawmem_support.RawmemWriteI8(out, i, Int8(Int32(text[i])))
    return out

@borrows
fn PathReadTextFileWithHandle(path: str): str =
    PathDebugLine(Fmt"path_read_input={path}")
    let hostPath = PathHostFilePath(strings.CloneStr(path))
    PathDebugLine(Fmt"path_read_host={hostPath}")
    var openErr: str
    let handle = PathFileHandleOpenReadBridge(hostPath, openErr)
    if handle == uint64(0):
        PathDebugLine(Fmt"path_read_open_failed err={openErr}")
        return ""
    var out: str
    var readErr: str
    let readOk = PathFileHandleReadAllBridge(handle, out, readErr)
    var closeErr: str
    let _ = PathFileHandleCloseBridge(handle, closeErr)
    if readOk == 0:
        PathDebugLine(Fmt"path_read_read_failed err={readErr}")
        return ""
    PathDebugLine(Fmt"path_read_len={out.len}")
    return out

type
    PathStableFileIdentity =
        size: int64
        mode: int32
        device: uint64
        inode: uint64
        ownerUid: uint64
        ownerGid: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        changeVersion: uint64
        linkCount: uint64

    PathStablePath =
        ok: bool
        error: str
        fullPath: str
        parentPath: str
        leaf: str

    PathStableBytesResult =
        ok: bool
        error: str
        bytes: rawbytes.Bytes

