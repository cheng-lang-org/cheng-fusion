@importc("driver_c_write_text_file_bridge")
fn PathWriteTextFileBridge(path: str, content: str)

@borrows
fn PathSegmentIsParent(path: str, start: int32, stop: int32): bool =
    if stop - start != 2:
        return false
    if path[start] != '.':
        return false
    let next: int32 = start + 1
    if path[next] != '.':
        return false
    return true

fn PathIsSepChar(ch: char): bool =
    if ch == '/':
        return true
    if ch == '\\':
        return true
    return false

@borrows
fn PathLooksAbsolute(raw: str): bool =
    if !PathNonEmpty(raw):
        return false
    if raw[0] == '/':
        return true
    if raw.len >= 3:
        if PathIsAsciiDrive(raw[0]):
            if raw[1] == ':':
                if PathIsSepChar(raw[2]):
                    return true
    return false

@borrows
fn PathHasParentTraversal(raw: str): bool =
    let path = raw
    if !PathNonEmpty(path):
        return false
    var segmentStart: int32
    for i in 0..<path.len:
        if PathIsSepChar(path[i]):
            if PathSegmentIsParent(path, segmentStart, i):
                return true
            segmentStart = i + 1
    return PathSegmentIsParent(path, segmentStart, path.len)

fn PathJoin(left: str, right: str): str =
    let leftPath = left
    let rightPath = right
    if !PathNonEmpty(leftPath):
        return NewStringCopy(rightPath.data, rightPath.len)
    if !PathNonEmpty(rightPath):
        return NewStringCopy(leftPath.data, leftPath.len)
    let leftLast = leftPath[leftPath.len - 1]
    let rightFirst = rightPath[0]
    if PathIsSepChar(leftLast) || PathIsSepChar(rightFirst):
        return leftPath + rightPath
    return leftPath + "/" + rightPath

@borrows
fn PathJoinBridgeSafe(left: str, right: str): str =
    let leftPath = left
    let rightPath = right
    return PathJoin(leftPath, rightPath)

@borrows
fn PathRootedAbsolute(root: str, raw: str): str =
    let rootPath = root
    if rootPath.len <= 0 || raw.len <= 0:
        return ""
    if raw[0] == '/':
        return ""
    if raw.len >= 3 && PathIsAsciiDrive(raw[0]) && raw[1] == ':' && PathIsSepChar(raw[2]):
        return ""
    if PathHasParentTraversal(raw):
        return ""
    return PathJoin(rootPath, raw)

@borrows
fn PathAbsolute(root: str, raw: str): str =
    let rootPath = root
    if raw.len <= 0:
        return PathCurrentDir()
    if raw[0] == '/':
        return NewStringCopy(raw.data, raw.len)
    if raw.len >= 3 && PathIsAsciiDrive(raw[0]) && raw[1] == ':' && PathIsSepChar(raw[2]):
        return NewStringCopy(raw.data, raw.len)
    if rootPath.len > 0:
        return PathJoin(rootPath, raw)
    return PathJoin(PathCurrentDir(), raw)

@borrows
fn PathAbsoluteBridgeSafe(root: str, raw: str): str =
    let rootPath = root
    let text: str = raw
    if !PathNonEmpty(text):
        return PathCurrentDir()
    if PathLooksAbsolute(text):
        return NewStringCopy(text.data, text.len)
    if PathNonEmpty(rootPath):
        return PathJoin(rootPath, text)
    return PathJoin(PathCurrentDir(), text)

@borrows
fn PathFileExists(pathRaw: str): bool =
    let owned = strings.CloneStrRange(pathRaw, 0, 2147483647)
    return os.FileExists(owned)

@borrows
fn PathDirExists(pathRaw: str): bool =
    let owned = strings.CloneStrRange(pathRaw, 0, 2147483647)
    return os.DirExists(owned)

@borrows
fn PathFileSize(pathRaw: str): int64 =
    let path = PathTrim(pathRaw)
    if !PathNonEmpty(path):
        return Int64(0)
    let hostPath = PathHostFilePath(path)
    return os.FileSize(hostPath)

@borrows
fn PathFileNonEmpty(pathRaw: str): bool =
    let path = PathTrim(strings.CloneStr(pathRaw))
    if !PathNonEmpty(path):
        return false
    let hostPath = PathHostFilePath(path)
    return os.FileSize(hostPath) > Int64(0)

fn PathBoolText(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn PathFileSizeDiagnostic(pathRaw: str): str =
    let path = PathTrim(strings.CloneStr(pathRaw))
    let hostPath = PathHostFilePath(share(path))
    var out: str
    out = out + "path_file_size_diag_path_non_empty=" + PathBoolText(PathNonEmpty(path)) + "\n"
    out = out + "path_file_size_diag_exists=" + PathBoolText(PathFileExists(path)) + "\n"
    out = out + "path_file_size_diag_host_exists=" + PathBoolText(os.FileExists(hostPath)) + "\n"
    out = out + "path_file_size_diag_stat_size=" + strings.Int64ToStr(os.FileSize(hostPath)) + "\n"
    var openErr: str
    let handle = PathFileHandleOpenReadBridge(hostPath, openErr)
    if handle == uint64(0):
        out = out + "path_file_size_diag_open_handle=0\n"
        out = out + "path_file_size_diag_open_err_len=" + strings.IntToStr(openErr.len) + "\n"
        return out
    out = out + "path_file_size_diag_open_handle=1\n"
    var content: str
    var readErr: str
    let ok = PathFileHandleReadAllBridge(handle, content, readErr)
    out = out + "path_file_size_diag_read_ok=" + strings.IntToStr(ok) + "\n"
    out = out + "path_file_size_diag_read_len=" + strings.IntToStr(content.len) + "\n"
    out = out + "path_file_size_diag_read_err_len=" + strings.IntToStr(readErr.len) + "\n"
    var closeErr: str
    let closed = PathFileHandleCloseBridge(handle, closeErr)
    out = out + "path_file_size_diag_close_ok=" + strings.IntToStr(closed) + "\n"
    out = out + "path_file_size_diag_close_err_len=" + strings.IntToStr(closeErr.len) + "\n"
    return out

@borrows
fn PathExists(root: str, raw: str): bool =
    let path: str = PathAbsolute(root, raw)
    if !PathNonEmpty(path):
        return false
    return PathFileExists(path) || PathDirExists(path)

@borrows
fn FileExistsNonEmpty(root: str, raw: str): bool =
    let path: str = PathAbsolute(root, raw)
    if !PathNonEmpty(path):
        return false
    let hostPath = PathHostFilePath(path)
    let existsPath = share(hostPath)
    if !os.FileExists(existsPath):
        return false
    return os.FileSize(hostPath) > Int64(0)

@borrows
fn PathLastSep(path: str): int32 =
    var last: int32 = -1
    for i in 0..<path.len:
        if PathIsSepChar(path[i]):
            last = i
    return last

@borrows
fn PathLastDot(name: str): int32 =
    var last: int32 = -1
    for i in 0..<name.len:
        if name[i] == '.':
            last = i
    return last

@borrows
fn PathBaseName(pathRaw: str): str =
    let path = pathRaw
    if !PathNonEmpty(path):
        return ""
    let lastSep = PathLastSep(path)
    if lastSep < 0:
        return strings.CloneStr(path)
    return TextSlice(path, lastSep + 1, path.len - (lastSep + 1))

@borrows
fn PathParentDir(pathRaw: str): str =
    let path = pathRaw
    if !PathNonEmpty(path):
        return ""
    let lastSep = PathLastSep(path)
    if lastSep < 0:
        return ""
    if lastSep == 0:
        return ""
    return TextSlice(path, 0, lastSep)

@borrows
fn PathSplitFile(pathRaw: str): PathSplitFileResult =
    let path = pathRaw
    let base = PathBaseName(share(path))
    let dir = PathParentDir(path)
    if !PathNonEmpty(base):
        return PathSplitFileResultMake(dir, "", "")
    let lastDot = PathLastDot(base)
    if lastDot <= 0:
        return PathSplitFileResultMake(dir, base, "")
    let name = TextSlice(base, 0, lastDot)
    let ext = TextSlice(base, lastDot, base.len - lastDot)
    return PathSplitFileResultMake(dir, name, ext)

@borrows
fn PathCreateDirSegment(hostPath: str, stop: int32): bool =
    if stop <= 0:
        return true
    let dir = TextSlice(hostPath, 0, stop)
    if !PathNonEmpty(dir):
        return true
    if os.DirExists(dir):
        return true
    if os.FileExists(dir):
        return false
    let made = os.MakeDir(dir)
    if made:
        return os.DirExists(dir)
    return os.DirExists(dir)

@borrows
fn PathCreateDirAll(path: str): bool =
    let cleanPath = path
    if !PathNonEmpty(cleanPath):
        return false
    let hostPath = PathHostFilePath(strings.CloneStr(cleanPath))
    if os.DirExists(hostPath):
        return true
    if os.FileExists(hostPath):
        return false
    for i in 0..<hostPath.len:
        if PathIsSepChar(hostPath[i]):
            if i > 0:
                var skip = false
                if i == 2:
                    if hostPath[1] == ':':
                        skip = true
                if !skip:
                    if !PathCreateDirSegment(hostPath, i):
                        return false
    if !PathCreateDirSegment(hostPath, hostPath.len):
        return false
    return os.DirExists(hostPath)

fn MkdirP(root: str, raw: str): bool =
    if !PathNonEmpty(raw):
        return false
    if PathLooksAbsolute(raw):
        if !PathCreateDirAll(raw):
            return false
        return PathDirExists(raw)
    let path: str = PathAbsolute(root, raw)
    if !PathNonEmpty(path):
        return false
    if !PathCreateDirAll(path):
        return false
    return PathDirExists(path)

fn MkdirRooted(root: str, raw: str): bool =
    let path: str = PathRootedAbsolute(root, raw)
    if !PathNonEmpty(path):
        return false
    return PathCreateDirAll(path)

@borrows
fn PathWriteHandleBytes(handle: uint64,
                        bytes: rawbytes.Bytes,
                        outErr: var str): int32 =
    return PathHostBytesHandleWriteAll(handle, bytes, outErr)

@borrows
fn WriteTextFile(root: str, raw: str, text: str): bool =
    if raw.len <= 0:
        return false
    var path: str
    if raw[0] == '/':
        path = NewStringCopy(raw.data, raw.len)
    elif raw.len >= 3 && PathIsAsciiDrive(raw[0]) && raw[1] == ':' && PathIsSepChar(raw[2]):
        path = NewStringCopy(raw.data, raw.len)
    elif root.len > 0:
        path = PathJoin(root, raw)
    else:
        path = PathJoin(PathCurrentDir(), raw)
    let hostPath = PathHostFilePath(path)
    var openErr: str
    let openPath = share(hostPath)
    let handle = PathFileHandleOpenWriteTruncateBridge(openPath, openErr)
    if handle == uint64(0):
        return false
    var writeErr: str
    let writeRc = PathHostFileHandleWriteAll(handle, text, text.len, writeErr)
    var closeErr: str
    let closeRc = PathFileHandleCloseBridge(handle, closeErr)
    if writeRc == 0 || closeRc == 0:
        return false
    if text.len <= 0:
        return os.FileExists(hostPath)
    return os.FileSize(hostPath) > Int64(0)

@borrows
fn AppendTextFile(root: str, raw: str, text: str): bool =
    if raw.len <= 0:
        return false
    var path: str
    if raw[0] == '/':
        path = NewStringCopy(raw.data, raw.len)
    elif raw.len >= 3 && PathIsAsciiDrive(raw[0]) && raw[1] == ':' && PathIsSepChar(raw[2]):
        path = NewStringCopy(raw.data, raw.len)
    elif root.len > 0:
        path = PathJoin(root, raw)
    else:
        path = PathJoin(PathCurrentDir(), raw)
    let hostPath = PathHostFilePath(path)
    var openErr: str
    let openPath = share(hostPath)
    let handle = PathFileHandleOpenAppendBridge(openPath, openErr)
    if handle == uint64(0):
        return false
    var writeErr: str
    let writeRc = PathHostFileHandleWriteAll(handle, text, text.len, writeErr)
    var closeErr: str
    let closeRc = PathFileHandleCloseBridge(handle, closeErr)
    if writeRc == 0 || closeRc == 0:
        return false
    if text.len <= 0:
        return os.FileExists(hostPath)
    return os.FileSize(hostPath) > Int64(0)

fn WriteTextFileWithHandle(root: str, raw: str, text: str): bool =
    if raw.len <= 0:
        return false
    var path: str
    if raw[0] == '/':
        path = raw
    elif raw.len >= 3 && PathIsAsciiDrive(raw[0]) && raw[1] == ':' && PathIsSepChar(raw[2]):
        path = raw
    elif root.len > 0:
        path = PathJoin(root, raw)
    else:
        path = PathJoin(PathCurrentDir(), raw)
    let hostPath = PathHostFilePath(path)
    var openErr: str
    let openPath = share(hostPath)
    let handle = PathFileHandleOpenWriteTruncateBridge(openPath, openErr)
    if handle == uint64(0):
        return false
    var writeErr: str
    let writeRc = PathHostFileHandleWriteAll(handle, text, text.len, writeErr)
    var closeErr: str
    let closeRc = PathFileHandleCloseBridge(handle, closeErr)
    if writeRc == 0 || closeRc == 0:
        return false
    return os.FileExists(hostPath) && os.FileSize(hostPath) > Int64(0)

