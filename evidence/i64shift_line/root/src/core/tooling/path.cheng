type
    PathSplitFileResult =
        dir: str
        name: str
        ext: str

@borrows
fn PathDebugLine(line: str) =
    if os.GetEnv("CHENG_PATH_TRACE") == "1":
        os.WriteLine(os.Get_stderr(), line)

fn PathSplitFileResultMake(dir: str, name: str, ext: str): PathSplitFileResult =
    var out: PathSplitFileResult
    out.dir = dir
    out.name = name
    out.ext = ext
    return out

@borrows
fn PathTrim(raw: str): str =
    # Hot: compiler path traffic is overwhelmingly already-clean. Early-exit
    # empty + dual-end non-space before any loop; drop bool flag while+break.
    let n = raw.len
    if n <= 0:
        return ""
    let head = raw[0]
    let tail = raw[n - 1]
    if head != ' ' && head != '\t' && head != '\n' && head != '\r' &&
       tail != ' ' && tail != '\t' && tail != '\n' && tail != '\r':
        return strings.CloneStr(raw)
    var start: int32
    var stop: int32 = n
    while start < stop:
        let ch = raw[start]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        start = start + 1
    while stop > start:
        let ch = raw[stop - 1]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        stop = stop - 1
    if start <= 0 && stop >= n:
        return strings.CloneStr(raw)
    return TextSlice(raw, start, stop - start)

@borrows
fn PathNonEmpty(raw: str): bool =
    return strings.Len(raw) > 0

@borrows
fn TextSlice(text: str, start: int32, count: int32): str =
    if count <= 0:
        return ""
    var start0 = start
    if start0 < 0:
        start0 = 0
    if start0 >= text.len || text.data == nil:
        return ""
    var kept = count
    if start0 + kept > text.len:
        kept = text.len - start0
    if kept <= 0:
        return ""
    return NewStringCopy(rawmem_support.RawmemPtrAdd(text.data, start0), kept)

@borrows
fn TextStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn TextContains(text: str, sub: str): bool =
    if sub == "":
        return true
    if text.len < sub.len:
        return false
    for i in 0..<(text.len - sub.len + 1):
        var matched = true
        for j in 0..<sub.len:
            if text[i + j] != sub[j]:
                matched = false
                break
        if matched:
            return true
    return false

fn PathIsAsciiDrive(ch: char): bool =
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')

fn PathDriveLowerText(ch: char): str =
    if ch >= 'A' && ch <= 'Z':
        return strings.CharToStr(char(Int32(ch) + 32))
    return strings.CharToStr(ch)

@borrows
fn PathSlashNormalized(text: str): str =
    var out: str
    for i in 0..<text.len:
        if text[i] == '\\':
            out = out + "/"
        else:
            out = out + strings.CharToStr(text[i])
    return out

@borrows
fn PathHostFilePath(path: str): str =
    if path.len >= 3 && path[0] == '/' && path[2] == '/' && PathIsAsciiDrive(path[1]):
        let drive = PathDriveLowerText(path[1])
        var out: str = drive + ":/"
        for i in 3..<path.len:
            if path[i] == '\\':
                out = out + "/"
            else:
                out = out + strings.CharToStr(path[i])
        return out
    if path.len >= 3 && path[1] == ':' && (path[2] == '/' || path[2] == '\\') && PathIsAsciiDrive(path[0]):
        let drive = PathDriveLowerText(path[0])
        var out: str = drive + ":/"
        for i in 3..<path.len:
            if path[i] == '\\':
                out = out + "/"
            else:
                out = out + strings.CharToStr(path[i])
        return out
    return strings.CloneStr(path)

@borrows
fn PathProviderFilePath(path: str): str =
    if path.len >= 3 && path[0] == '/' && path[2] == '/' && PathIsAsciiDrive(path[1]):
        let drive = strings.CharToStr(path[1])
        var out: str = drive + ":/"
        for i in 3..<path.len:
            if path[i] == '\\':
                out = out + "/"
            else:
                out = out + strings.CharToStr(path[i])
        return out
    return strings.CloneStr(path)

fn PathCurrentDir(): str =
    let out = os.GetCurrentDir()
    return out

