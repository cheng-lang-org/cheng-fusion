fn PathStableUnlinkAtBridge(
        dirFd: int32, path: cstring, flags: int32): int32

@importc("cheng_host_renameat_noreplace")
fn PathStableRenameAtNoReplaceBridge(
        parentFd: int32,
        oldName: cstring,
        newName: cstring): int32

@importc("cheng_host_lseek_runtime")
fn PathStableSeekBridge(
        fd: int32, offset: int64, whence: int32): int64

@importc("cheng_errno")
fn PathStableErrnoBridge(): int32

@importc("cheng_system_os_name_bridge")
fn PathStableOsNameBridge(): cstring

@borrows
fn PathStableCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn PathStableCat3(a: str, b: str, c: str): str =
    return PathStableCat(PathStableCat(a, b), c)

@borrows
fn PathStableCat4(a: str, b: str, c: str, d: str): str =
    return PathStableCat(PathStableCat3(a, b, c), d)

fn PathStablePlatformCode(error: var str): int32 =
    let rawName = PathStableOsNameBridge()
    if rawName == nil:
        error = "stable_file_platform_unavailable"
        return 0
    let name = strFromCStringCopy(rawName)
    if name == "Linux":
        return 1
    if name == "Darwin":
        return 2
    error = PathStableCat(
        "stable_file_platform_unsupported ", name)
    return 0

fn PathStableReadFlags(platformCode: int32): int32 =
    if platformCode == 1:
        return 655360
    if platformCode == 2:
        return 16777472
    return -1

fn PathStableDirectoryFlags(platformCode: int32): int32 =
    if platformCode == 1:
        return 720896
    if platformCode == 2:
        return 17826048
    return -1

fn PathStableWriteNewFlags(platformCode: int32): int32 =
    if platformCode == 1:
        return 655553
    if platformCode == 2:
        return 16780033
    return -1

fn PathStableNoFollowAtFlag(
        platformCode: int32): int32 =
    if platformCode == 1:
        return 256
    if platformCode == 2:
        return 32
    return -1

fn PathStableAtCurrentWorkingDirectory(
        platformCode: int32): int32 =
    if platformCode == 1:
        return -100
    if platformCode == 2:
        return -2
    return 0

@borrows
fn PathStablePathResolve(path: str): PathStablePath =
    var out: PathStablePath
    if path.len == 0:
        out.error = "stable_file_path_empty"
        return out
    for i in 0..<path.len:
        if int32(path[i]) == 0:
            out.error = "stable_file_path_nul"
            return out
    let absolute = os.AbsolutePath(path)
    var separator: int32 = -1
    for i in 0..<absolute.len:
        if absolute[i] == '/':
            separator = i
    if separator < 0 || separator >= absolute.len - 1:
        out.error = "stable_file_leaf_missing"
        return out
    var parentCandidate: str
    if separator == 0:
        parentCandidate = "/"
    else:
        parentCandidate = strings.CloneStrRange(
            absolute, 0, separator)
    let parentResult = fs.Realpath(parentCandidate)
    if result.IsErr(parentResult):
        out.error = "stable_file_parent_realpath_failed"
        return out
    let parentPath = result.Value(parentResult)
    let leaf = strings.CloneStrRange(
        absolute,
        separator + 1,
        absolute.len - separator - 1)
    if leaf.len == 0 || leaf == "." || leaf == "..":
        out.error = "stable_file_leaf_invalid"
        return out
    for i in 0..<leaf.len:
        if leaf[i] == '/' || int32(leaf[i]) == 0:
            out.error = "stable_file_leaf_invalid"
            return out
    out.ok = true
    out.parentPath = strings.CloneStr(parentPath)
    out.leaf = strings.CloneStr(leaf)
    if parentPath == "/":
        out.fullPath = PathStableCat(parentPath, leaf)
    else:
        out.fullPath = PathStableCat3(parentPath, "/", leaf)
    return out

@borrows
fn PathStablePathClone(path: PathStablePath): PathStablePath =
    var out: PathStablePath
    out.ok = path.ok
    out.error = strings.CloneStr(path.error)
    out.fullPath = strings.CloneStr(path.fullPath)
    out.parentPath = strings.CloneStr(path.parentPath)
    out.leaf = strings.CloneStr(path.leaf)
    return out

fn PathStableIdentityFromStat(
        bytes: rawbytes.Bytes,
        platformCode: int32,
        expectedType: int32,
        requireSingleLink: bool,
        out: var PathStableFileIdentity): bool =
    var fields: PathHostStatFields
    if !PathHostStatDecode(bytes,
                           platformCode,
                           expectedType,
                           requireSingleLink,
                           fields):
        return false
    out.device = fields.device
    out.mode = fields.mode
    out.linkCount = fields.linkCount
    out.inode = fields.inode
    out.ownerUid = fields.ownerUid
    out.ownerGid = fields.ownerGid
    out.size = fields.size
    out.mtimeSec = fields.mtimeSec
    out.mtimeNsec = fields.mtimeNsec
    out.ctimeSec = fields.ctimeSec
    out.ctimeNsec = fields.ctimeNsec
    out.changeVersion = fields.changeVersion
    return true

fn PathStableIdentityRead(
        fd: int32,
        platformCode: int32,
        expectedType: int32,
        requireSingleLink: bool,
        out: var PathStableFileIdentity): bool =
    if fd < 0:
        return false
    var statBytes = rawbytes.BytesAlloc(256)
    if rawbytes.BytesLen(statBytes) != 256:
        rawbytes.BytesFree(statBytes)
        return false
    while true:
        if PathHostFstatInto(fd, statBytes) == 0:
            break
        if PathStableErrnoBridge() != 4:
            rawbytes.BytesFree(statBytes)
            return false
    let ok = PathStableIdentityFromStat(
        statBytes,
        platformCode,
        expectedType,
        requireSingleLink,
        out)
    rawbytes.BytesFree(statBytes)
    return ok

@borrows
fn PathStableNamedIdentityRead(
        dirFd: int32,
        leaf: str,
        platformCode: int32,
        expectedType: int32,
        requireSingleLink: bool,
        out: var PathStableFileIdentity): bool =
    if leaf.len == 0 ||
       (dirFd < 0 &&
        dirFd !=
            PathStableAtCurrentWorkingDirectory(
                platformCode)):
        return false
    var statBytes = rawbytes.BytesAlloc(256)
    if rawbytes.BytesLen(statBytes) != 256:
        rawbytes.BytesFree(statBytes)
        return false
    var rc: int32
    while true:
        rc = PathHostFstatAtInto(
            dirFd,
            leaf,
            statBytes,
            PathStableNoFollowAtFlag(platformCode))
        if rc == 0:
            break
        if PathStableErrnoBridge() != 4:
            rawbytes.BytesFree(statBytes)
            return false
    let ok = PathStableIdentityFromStat(
        statBytes,
        platformCode,
        expectedType,
        requireSingleLink,
        out)
    rawbytes.BytesFree(statBytes)
    return ok

@borrows
fn PathStableNamedStatus(
        dirFd: int32,
        leaf: str,
        platformCode: int32): int32 =
    if dirFd < 0 || leaf.len == 0:
        return -1
    var statBytes = rawbytes.BytesAlloc(256)
    if rawbytes.BytesLen(statBytes) != 256:
        rawbytes.BytesFree(statBytes)
        return -1
    while true:
        let rc = PathHostFstatAtInto(
            dirFd,
            leaf,
            statBytes,
            PathStableNoFollowAtFlag(platformCode))
        if rc == 0:
            rawbytes.BytesFree(statBytes)
            return 1
        let errorCode = PathStableErrnoBridge()
        if errorCode == 4:
            continue
        rawbytes.BytesFree(statBytes)
        if errorCode == 2:
            return 0
        return -1

@borrows
fn PathStableIdentityEqual(
        left: PathStableFileIdentity,
        right: PathStableFileIdentity): bool =
    return left.size == right.size &&
        left.mode == right.mode &&
        left.device == right.device &&
        left.inode == right.inode &&
        left.ownerUid == right.ownerUid &&
        left.ownerGid == right.ownerGid &&
        left.mtimeSec == right.mtimeSec &&
        left.mtimeNsec == right.mtimeNsec &&
        left.ctimeSec == right.ctimeSec &&
        left.ctimeNsec == right.ctimeNsec &&
        left.changeVersion == right.changeVersion &&
        left.linkCount == right.linkCount

fn PathStableSameNode(
        left: PathStableFileIdentity,
        right: PathStableFileIdentity): bool =
    return left.device == right.device &&
        left.inode == right.inode &&
        left.mode == right.mode &&
        left.ownerUid == right.ownerUid &&
        left.ownerGid == right.ownerGid

fn PathStableRenameIdentityEqual(
        staging: PathStableFileIdentity,
        published: PathStableFileIdentity): bool =
    return staging.size == published.size &&
        staging.mode == published.mode &&
        staging.device == published.device &&
        staging.inode == published.inode &&
        staging.ownerUid == published.ownerUid &&
        staging.ownerGid == published.ownerGid &&
        staging.mtimeSec == published.mtimeSec &&
        staging.mtimeNsec == published.mtimeNsec &&
        staging.linkCount == published.linkCount

fn PathStableParentOpen(
        path: PathStablePath,
        platformCode: int32,
        requirePrivateOwner: bool,
        fd: var int32,
        identity: var PathStableFileIdentity,
        error: var str): bool =
    fd = PathStableOpenBridge(
        StrToCStringTemp(path.parentPath),
        PathStableDirectoryFlags(platformCode),
        0)
    if fd < 0 ||
       !PathStableIdentityRead(
           fd,
           platformCode,
           int32(16384),
           false,
           identity):
        if fd >= 0:
            if PathStableCloseBridge(fd) != 0:
                fd = -1
                error = "stable_file_parent_close_failed"
                return false
        fd = -1
        error = "stable_file_parent_open_failed"
        return false
    let effectiveUid = os.EffectiveUserId()
    if requirePrivateOwner &&
       (effectiveUid < Int64(0) ||
        identity.ownerUid != uint64(effectiveUid) ||
        (identity.mode & int32(18)) != 0):
        let closeRc = PathStableCloseBridge(fd)
        fd = -1
        if closeRc != 0:
            error = "stable_file_parent_close_failed"
        else:
            error = "stable_file_parent_owner_or_mode_invalid"
        return false
    return true

fn PathStableParentStillBound(
        path: PathStablePath,
        platformCode: int32,
        expected: PathStableFileIdentity): bool =
    var current: PathStableFileIdentity
    let currentOk = PathStableNamedIdentityRead(
        PathStableAtCurrentWorkingDirectory(platformCode),
        path.parentPath,
        platformCode,
        int32(16384),
        false,
        current)
    return currentOk &&
        PathStableSameNode(expected, current)

fn PathStableSeekStart(fd: int32): bool =
    if fd < 0:
        return false
    while true:
        let offset = PathStableSeekBridge(
            fd, Int64(0), 0)
        if offset == Int64(0):
            return true
        if offset >= Int64(0) ||
           PathStableErrnoBridge() != 4:
            return false

fn PathStableFsync(fd: int32): bool =
    if fd < 0:
        return false
    while true:
        if PathStableFsyncBridge(fd) == 0:
            return true
        if PathStableErrnoBridge() != 4:
            return false

fn PathStableReadExact(
        fd: int32,
        expectedSize: int64): PathStableBytesResult =
    var out: PathStableBytesResult
    if fd < 0 ||
       expectedSize < Int64(0) ||
       expectedSize > Int64(2147483647):
        out.error = "stable_file_read_size_invalid"
        return out
    if !PathStableSeekStart(fd):
        out.error = "stable_file_read_seek_failed"
        return out
    let length = int32(expectedSize)
    var bytes = rawbytes.EmptyBytes()
    if length > 0:
        bytes = rawbytes.BytesAlloc(length)
        if rawbytes.BytesDataPtr(bytes) == nil || bytes.len != length:
            rawbytes.BytesFree(bytes)
            out.error = "stable_file_read_alloc_failed"
            return out
        var offset: int32
        while offset < length:
            let remaining = length - offset
            let count = PathHostReadInto(fd, bytes, offset, remaining)
            if count < Int64(0):
                if PathStableErrnoBridge() == 4:
                    continue
                rawbytes.BytesFree(bytes)
                out.error = "stable_file_read_failed"
                return out
            if count == Int64(0):
                rawbytes.BytesFree(bytes)
                out.error = "stable_file_read_truncated"
                return out
            let nextOffset = Int64(offset) + count
            if count > Int64(remaining) ||
               nextOffset <= Int64(offset) ||
               nextOffset > Int64(length):
                rawbytes.BytesFree(bytes)
                out.error = "stable_file_read_offset_overflow"
                return out
            offset = int32(nextOffset)
    var tail = rawbytes.BytesAlloc(1)
    while true:
        let tailCount = PathHostReadInto(fd, tail, 0, 1)
        if tailCount == Int64(0):
            break
        if tailCount < Int64(0) &&
           PathStableErrnoBridge() == 4:
            continue
        rawbytes.BytesFree(bytes)
        rawbytes.BytesFree(tail)
        if tailCount > Int64(0):
            out.error = "stable_file_read_size_changed"
        else:
            out.error = "stable_file_read_tail_failed"
        return out
    rawbytes.BytesFree(tail)
    out.ok = true
    out.bytes = rawbytes.BytesTake(bytes)
    return out

@borrows
fn PathStableReadBytes(path: str): PathStableBytesResult =
    var out: PathStableBytesResult
    var platformError: str
    let platformCode = PathStablePlatformCode(platformError)
    if platformCode == 0:
        out.error = strings.CloneStr(platformError)
        return out
    let stablePath = PathStablePathResolve(path)
    if !stablePath.ok:
        out.error = strings.CloneStr(stablePath.error)
        return out
    var parentFd: int32
    var parentIdentity: PathStableFileIdentity
    var parentError: str
    if !PathStableParentOpen(
            PathStablePathClone(stablePath),
            platformCode,
            false,
            parentFd,
            parentIdentity,
            parentError):
        out.error = strings.CloneStr(parentError)
        return out
    let readFlags = PathStableReadFlags(platformCode)
    let fd = PathStableOpenAtBridge(
        parentFd,
        StrToCStringTemp(stablePath.leaf),
        readFlags,
        0)
    if fd < 0:
        if PathStableCloseBridge(parentFd) != 0:
            out.error = "stable_file_parent_close_failed"
        else:
            out.error = "stable_file_open_failed"
        return out
    var before: PathStableFileIdentity
    if !PathStableIdentityRead(
            fd,
            platformCode,
            int32(32768),
            true,
            before) ||
       before.size > Int64(2147483647):
        let closeRc = PathStableCloseBridge(fd)
        let parentCloseRc = PathStableCloseBridge(parentFd)
        if closeRc != 0 || parentCloseRc != 0:
            out.error = "stable_file_close_failed"
        else:
            out.error = "stable_file_identity_invalid"
        return out
    var bytesResult = PathStableReadExact(
        fd, before.size)
    var after: PathStableFileIdentity
    let afterOk = PathStableIdentityRead(
        fd,
        platformCode,
        int32(32768),
        true,
        after)
    var current: PathStableFileIdentity
    let currentOk = PathStableNamedIdentityRead(
        parentFd,
        stablePath.leaf,
        platformCode,
        int32(32768),
        true,
        current)
    let parentStillBound = PathStableParentStillBound(
        PathStablePathClone(stablePath),
        platformCode,
        parentIdentity)
    let closeRc = PathStableCloseBridge(fd)
    let parentCloseRc = PathStableCloseBridge(parentFd)
    if !bytesResult.ok:
        rawbytes.BytesFree(bytesResult.bytes)
        if closeRc != 0 || parentCloseRc != 0:
            out.error = "stable_file_close_failed"
        else:
            out.error = PathStableCat(
                "stable_file_pinned_read_failed ",
                bytesResult.error)
        return out
    var bytes = rawbytes.BytesTake(bytesResult.bytes)
    if !afterOk ||
       closeRc != 0 ||
       !currentOk ||
       !parentStillBound ||
       parentCloseRc != 0 ||
       !PathStableIdentityEqual(before, after) ||
       !PathStableIdentityEqual(before, current) ||
       Int64(rawbytes.BytesLen(bytes)) != before.size:
        rawbytes.BytesFree(bytes)
        out.error = "stable_file_identity_changed"
        return out
    out.ok = true
    out.bytes = bytes
    return out

@borrows
fn PathStableWriteAll(
        fd: int32, bytes: rawbytes.Bytes): bool =
    if fd < 0 || bytes.len < 0 ||
       (bytes.len > 0 && bytes.data == nil):
        return false
    var written: int32
    while written < bytes.len:
        let remaining = bytes.len - written
        let count = PathHostWriteFrom(fd, bytes, written, remaining)
        if count < Int64(0):
            if PathStableErrnoBridge() == 4:
                continue
            return false
        if count == Int64(0):
            return false
        let nextWritten = Int64(written) + count
        if count > Int64(remaining) ||
           nextWritten <= Int64(written) ||
           nextWritten > Int64(bytes.len):
            return false
        written = int32(nextWritten)
    return true

fn PathStableUniqueStagingLeaf(
        error: var str): str =
    var nonceBytes = rawbytes.BytesAlloc(16)
    if rawbytes.BytesDataPtr(nonceBytes) == nil || nonceBytes.len != 16:
        rawbytes.BytesFree(nonceBytes)
        error = "stable_file_staging_nonce_alloc_failed"
        return ""
    while true:
        if PathHostEntropyInto(nonceBytes, 0, 16) == 0:
            break
        if PathStableErrnoBridge() != 4:
            rawbytes.BytesFree(nonceBytes)
            error = "stable_file_staging_entropy_failed"
            return ""
    let nonce = rawbytes.BytesToHex(nonceBytes)
    rawbytes.BytesFree(nonceBytes)
    if nonce.len != 32:
        error = "stable_file_staging_nonce_invalid"
        return ""
    return PathStableCat(
        PathStableCat4(
            ".csg-relfacts.",
            strings.IntToStr(os.ProcessId()),
            ".",
            nonce),
        ".tmp")

@borrows
fn PathStableAbortStaging(
        parentFd: int32,
        stagingFd: int32,
        stagingLeaf: str,
        platformCode: int32): bool =
    var held: PathStableFileIdentity
    var named: PathStableFileIdentity
    let heldOk = PathStableIdentityRead(
        stagingFd,
        platformCode,
        int32(32768),
        true,
        held)
    let namedOk = PathStableNamedIdentityRead(
        parentFd,
        stagingLeaf,
        platformCode,
        int32(32768),
        true,
        named)
    var unlinkOk: bool
    if heldOk && namedOk &&
       PathStableIdentityEqual(held, named):
        unlinkOk = PathStableUnlinkAtBridge(
            parentFd,
            StrToCStringTemp(stagingLeaf),
            0) == 0
    var parentSyncOk: bool
    if unlinkOk:
        parentSyncOk = PathStableFsync(parentFd)
    let stagingCloseRc = PathStableCloseBridge(stagingFd)
    let parentCloseRc = PathStableCloseBridge(parentFd)
    return heldOk && namedOk && unlinkOk &&
        parentSyncOk && stagingCloseRc == 0 &&
        parentCloseRc == 0

@borrows
fn PathStableWriteNewText(
        path: str, text: str, error: var str): bool =
    var platformError: str
    let platformCode = PathStablePlatformCode(platformError)
    if platformCode == 0:
        error = strings.CloneStr(platformError)
        return false
    let stablePath = PathStablePathResolve(path)
    if !stablePath.ok:
        error = strings.CloneStr(stablePath.error)
        return false
    var parentFd: int32
    var parentIdentity: PathStableFileIdentity
    if !PathStableParentOpen(
            PathStablePathClone(stablePath),
            platformCode,
            true,
            parentFd,
            parentIdentity,
            error):
        return false
    let initialTargetStatus = PathStableNamedStatus(
        parentFd, stablePath.leaf, platformCode)
    if initialTargetStatus != 0:
        let parentCloseRc = PathStableCloseBridge(parentFd)
        if parentCloseRc != 0:
            error = "stable_file_parent_close_failed"
        elif initialTargetStatus > 0:
            error = "stable_file_destination_exists"
        else:
            error = "stable_file_destination_probe_failed"
        return false
    var stagingError: str
    let stagingLeaf = PathStableUniqueStagingLeaf(
        stagingError)
    if stagingLeaf.len == 0:
        let parentCloseRc = PathStableCloseBridge(parentFd)
        if parentCloseRc != 0:
            error = "stable_file_parent_close_failed"
        else:
            error = strings.CloneStr(stagingError)
        return false
    let stagingFd = PathStableOpenAtBridge(
        parentFd,
        StrToCStringTemp(stagingLeaf),
        PathStableWriteNewFlags(platformCode),
        384)
    if stagingFd < 0:
        if PathStableCloseBridge(parentFd) != 0:
            error = "stable_file_parent_close_failed"
        else:
            error = "stable_file_staging_create_failed"
        return false
    let bytes = rawbytes.BytesFromString(text)
    let writeOk = PathStableWriteAll(stagingFd, bytes)
    let syncOk = PathStableFsync(stagingFd)
    var stagingIdentity: PathStableFileIdentity
    let identityOk = PathStableIdentityRead(
        stagingFd,
        platformCode,
        int32(32768),
        true,
        stagingIdentity)
    var namedStaging: PathStableFileIdentity
    let namedStagingOk = PathStableNamedIdentityRead(
        parentFd,
        stagingLeaf,
        platformCode,
        int32(32768),
        true,
        namedStaging)
    let effectiveUid = os.EffectiveUserId()
    let stagingOwnerOk =
        effectiveUid >= Int64(0) &&
        stagingIdentity.ownerUid == uint64(effectiveUid)
    let parentStillBoundBeforePublish =
        PathStableParentStillBound(
            PathStablePathClone(stablePath),
            platformCode,
            parentIdentity)
    if !writeOk ||
       !syncOk ||
       !identityOk ||
       !namedStagingOk ||
       !PathStableIdentityEqual(
           stagingIdentity, namedStaging) ||
       stagingIdentity.size != Int64(text.len) ||
       (stagingIdentity.mode & int32(511)) != int32(384) ||
       !stagingOwnerOk ||
       !parentStillBoundBeforePublish:
        if !PathStableAbortStaging(
               parentFd,
               stagingFd,
               stagingLeaf,
               platformCode):
            error = "stable_file_staging_cleanup_failed"
        else:
            error = "stable_file_staging_verify_failed"
        return false
    let targetStatusBeforePublish = PathStableNamedStatus(
        parentFd, stablePath.leaf, platformCode)
    if targetStatusBeforePublish != 0:
        if !PathStableAbortStaging(
               parentFd,
               stagingFd,
               stagingLeaf,
               platformCode):
            error = "stable_file_staging_cleanup_failed"
        elif targetStatusBeforePublish > 0:
            error = "stable_file_destination_exists"
        else:
            error = "stable_file_destination_probe_failed"
        return false
    let renameRc = PathStableRenameAtNoReplaceBridge(
        parentFd,
        StrToCStringTemp(stagingLeaf),
        StrToCStringTemp(stablePath.leaf))
    if renameRc != 0:
        if !PathStableAbortStaging(
               parentFd,
               stagingFd,
               stagingLeaf,
               platformCode):
            panic("stable_file_rename_failure_state_unknown")
        error = "stable_file_destination_exists_or_rename_failed"
        return false
    if !PathStableFsync(parentFd):
        panic("stable_file_parent_sync_failed_after_commit")
    var finalBefore: PathStableFileIdentity
    var finalAfter: PathStableFileIdentity
    let finalBeforeOk = PathStableIdentityRead(
        stagingFd,
        platformCode,
        int32(32768),
        true,
        finalBefore)
    if !finalBeforeOk ||
       !PathStableRenameIdentityEqual(
           stagingIdentity, finalBefore):
        panic("stable_file_published_identity_changed")
    var finalRead = PathStableReadExact(
        stagingFd, finalBefore.size)
    if !finalRead.ok:
        panic("stable_file_published_readback_failed")
    var finalBytes = rawbytes.BytesTake(finalRead.bytes)
    let finalAfterOk = PathStableIdentityRead(
        stagingFd,
        platformCode,
        int32(32768),
        true,
        finalAfter)
    var namedFinal: PathStableFileIdentity
    let namedFinalOk = PathStableNamedIdentityRead(
        parentFd,
        stablePath.leaf,
        platformCode,
        int32(32768),
        true,
        namedFinal)
    let parentStillBound = PathStableParentStillBound(
        PathStablePathClone(stablePath),
        platformCode,
        parentIdentity)
    let stagingCloseRc = PathStableCloseBridge(stagingFd)
    let parentCloseRc = PathStableCloseBridge(parentFd)
    let finalText = rawbytes.BytesToString(finalBytes)
    rawbytes.BytesFree(finalBytes)
    if !finalAfterOk ||
       !namedFinalOk ||
       stagingCloseRc != 0 ||
       !parentStillBound ||
       parentCloseRc != 0 ||
       !PathStableIdentityEqual(finalBefore, finalAfter) ||
       !PathStableIdentityEqual(finalAfter, namedFinal) ||
       finalText != text:
        panic("stable_file_publication_verify_failed_after_commit")
    return true

@borrows
fn WriteTextFileNoReplace(root: str, raw: str, text: str): bool =
    if raw.len <= 0:
        return false
    let path = PathAbsolute(root, raw)
    if path.len <= 0:
        return false
    var writeError: str
    return PathStableWriteNewText(path, text, writeError)
