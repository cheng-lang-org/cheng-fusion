import std/buffer
import std/result
import std/strformat
import std/strings
import cheng/core/tooling/compiler_execution_stage_receipt as execution_receipt
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    CompilerToolchainEncoderAuthorityBuildProjectionWireSchema: str =
        "cheng.compiler.toolchain_encoder_authority_build_projection_receipt"
    CompilerToolchainEncoderAuthorityBuildProjectionWireFieldCount: int32 = 16

type
    # Paths are canonical bundle-relative names. They are evidence locators,
    # not hash inputs: the identity hash remains the canonical
    # CompilerExecutionIdentity contract. An independent consumer must open
    # every path without following symlinks and recompute the bound raw32.
    CompilerExecutionObservedPaths =
        sourceBundlePath: str
        materializerBytesPath: str
        grammarObligationPath: str
        compilerSourceClosurePath: str
        driverBytesPath: str
        toolchainManifestPath: str
        commandManifestPath: str

@borrows
fn CompilerExecutionObservedPathsMake(
        sourceBundlePath: str,
        materializerBytesPath: str,
        grammarObligationPath: str,
        compilerSourceClosurePath: str,
        driverBytesPath: str,
        toolchainManifestPath: str,
        commandManifestPath: str): CompilerExecutionObservedPaths =
    var out: CompilerExecutionObservedPaths
    out.sourceBundlePath = strings.CloneStr(sourceBundlePath)
    out.materializerBytesPath = strings.CloneStr(materializerBytesPath)
    out.grammarObligationPath = strings.CloneStr(grammarObligationPath)
    out.compilerSourceClosurePath = strings.CloneStr(compilerSourceClosurePath)
    out.driverBytesPath = strings.CloneStr(driverBytesPath)
    out.toolchainManifestPath = strings.CloneStr(toolchainManifestPath)
    out.commandManifestPath = strings.CloneStr(commandManifestPath)
    return out

@borrows
fn compilerExecutionWireAppendJsonString(
        out: var buffer.GrowByteBuffer,
        value: str) =
    buffer.AppendByte(out, 34)
    for index in 0..<value.len:
        let code = Int32(value[index]) & 255
        if code == 34 || code == 92:
            buffer.AppendByte(out, 92)
            buffer.AppendByte(out, code)
        elif code < 32:
            buffer.AppendText(out, "\\u00")
            let high = (code >> 4) & 15
            let low = code & 15
            buffer.AppendByte(out, high < 10 ? 48 + high : 87 + high)
            buffer.AppendByte(out, low < 10 ? 48 + low : 87 + low)
        else:
            buffer.AppendByte(out, code)
    buffer.AppendByte(out, 34)

@borrows
fn compilerExecutionWireAppendKey(out: var buffer.GrowByteBuffer,
                                  key: str) =
    compilerExecutionWireAppendJsonString(out, key)
    buffer.AppendByte(out, 58)

@borrows
fn compilerExecutionWireAppendStringField(
        out: var buffer.GrowByteBuffer,
        key: str,
        value: str,
        comma: bool) =
    compilerExecutionWireAppendKey(out, key)
    compilerExecutionWireAppendJsonString(out, value)
    if comma:
        buffer.AppendByte(out, 44)

@borrows
fn compilerExecutionWireAppendI32Field(
        out: var buffer.GrowByteBuffer,
        key: str,
        value: int32,
        comma: bool) =
    compilerExecutionWireAppendKey(out, key)
    buffer.AppendText(out, strings.IntToStr(value))
    if comma:
        buffer.AppendByte(out, 44)

@borrows
fn compilerExecutionWireAppendI64Field(
        out: var buffer.GrowByteBuffer,
        key: str,
        value: int64,
        comma: bool) =
    compilerExecutionWireAppendKey(out, key)
    buffer.AppendText(out, strings.Int64ToStr(value))
    if comma:
        buffer.AppendByte(out, 44)

@borrows
fn compilerExecutionWireAppendRaw32Field(
        out: var buffer.GrowByteBuffer,
        key: str,
        value: layout.FixedBytes32,
        comma: bool) =
    compilerExecutionWireAppendStringField(
        out, key, layout.FixedBytes32Hex(value), comma)

# Emits exactly sixteen recursively sorted keys and one trailing LF.  This is
# only the inner build projection wire; official compiler bytes and a live
# CompilerSnapshotLoweringAuthority remain mandatory outer issuer evidence.
@borrows
fn CompilerToolchainEncoderAuthorityBuildProjectionCanonicalJson(
        buildIdentity: execution_receipt.CompilerExecutionIdentity,
        receipt:
            execution_receipt.CompilerToolchainEncoderAuthorityBuildProjectionReceipt):
        Result[str] =
    let verifyRes =
        execution_receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerifyForBuild(
            receipt,
            buildIdentity)
    if IsErr(verifyRes):
        return Err[str](strings.CloneStr(Error(verifyRes)))
    var out = buffer.NewByteBuffer()
    buffer.AppendByte(out, 123)
    compilerExecutionWireAppendRaw32Field(
        out, "buildAuthorityCid", receipt.buildAuthorityCid, true)
    compilerExecutionWireAppendI32Field(
        out, "canonicalRow", receipt.canonicalRow, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerCsgArtifactCid",
        receipt.compilerCsgArtifactCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerCsgCanonicalGraphCid",
        receipt.compilerCsgCanonicalGraphCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerCsgCargoCid", receipt.compilerCsgCargoCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerCsgCargoObjectReceiptCid",
        receipt.compilerCsgCargoObjectReceiptCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerCsgFactsRootCid",
        receipt.compilerCsgFactsRootCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerCsgGraphCid", receipt.compilerCsgGraphCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerCsgSourceBundleCid",
        receipt.compilerCsgSourceBundleCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "contentCid", receipt.contentCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "documentCid", receipt.documentCid, true)
    compilerExecutionWireAppendI32Field(
        out, "modulePathTextId", receipt.modulePathTextId, true)
    compilerExecutionWireAppendI32Field(
        out, "producerRow", receipt.producerRow, true)
    compilerExecutionWireAppendRaw32Field(
        out, "projectionCid", receipt.projectionCid, true)
    compilerExecutionWireAppendRaw32Field(
        out, "receiptCid", receipt.receiptCid, true)
    compilerExecutionWireAppendStringField(
        out,
        "schema",
        CompilerToolchainEncoderAuthorityBuildProjectionWireSchema,
        false)
    buffer.AppendByte(out, 125)
    buffer.AppendByte(out, 10)
    return Ok[str](buffer.FinishString(out))

@borrows
fn compilerExecutionWireAppendIdentity(
        out: var buffer.GrowByteBuffer,
        identity: execution_receipt.CompilerExecutionIdentity) =
    buffer.AppendByte(out, 123)
    # Recursive canonical key order (ASCII; all schema keys are ASCII).
    compilerExecutionWireAppendStringField(out, "caseId", identity.caseId, true)
    compilerExecutionWireAppendRaw32Field(
        out, "commandManifestRaw32", identity.commandManifestRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "compilerSourceClosureRaw32",
        identity.compilerSourceClosureRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "driverBytesRaw32", identity.driverBytesRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "executionRaw32", identity.executionRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "grammarObligationRootRaw32",
        identity.grammarObligationRootRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "materializerBytesRaw32", identity.materializerBytesRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "sourceBundleRaw32", identity.sourceBundleRaw32, true)
    compilerExecutionWireAppendStringField(
        out, "targetTriple", identity.targetTriple, true)
    compilerExecutionWireAppendRaw32Field(
        out, "toolchainManifestRaw32", identity.toolchainManifestRaw32, false)
    buffer.AppendByte(out, 125)

@borrows
fn compilerExecutionWireAppendObservedPaths(
        out: var buffer.GrowByteBuffer,
        paths: CompilerExecutionObservedPaths) =
    buffer.AppendByte(out, 123)
    compilerExecutionWireAppendStringField(
        out, "commandManifestPath", paths.commandManifestPath, true)
    compilerExecutionWireAppendStringField(
        out, "compilerSourceClosurePath",
        paths.compilerSourceClosurePath, true)
    compilerExecutionWireAppendStringField(
        out, "driverBytesPath", paths.driverBytesPath, true)
    compilerExecutionWireAppendStringField(
        out, "grammarObligationPath", paths.grammarObligationPath, true)
    compilerExecutionWireAppendStringField(
        out, "materializerBytesPath", paths.materializerBytesPath, true)
    compilerExecutionWireAppendStringField(
        out, "sourceBundlePath", paths.sourceBundlePath, true)
    compilerExecutionWireAppendStringField(
        out, "toolchainManifestPath", paths.toolchainManifestPath, false)
    buffer.AppendByte(out, 125)

@borrows
fn compilerExecutionWireAppendStage(
        out: var buffer.GrowByteBuffer,
        stage: execution_receipt.ExecutionStageReceipt,
        producerSourcePath: str) =
    buffer.AppendByte(out, 123)
    compilerExecutionWireAppendI64Field(
        out, "artifactByteLength", stage.artifactByteLength, true)
    compilerExecutionWireAppendRaw32Field(
        out, "artifactBytesRaw32", stage.artifactBytesRaw32, true)
    compilerExecutionWireAppendStringField(
        out, "artifactKind", stage.artifactKind, true)
    compilerExecutionWireAppendStringField(
        out, "artifactPath", stage.artifactPath, true)
    compilerExecutionWireAppendRaw32Field(
        out, "executionRaw32", stage.executionRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "inputSemanticRaw32", stage.inputSemanticRaw32, true)
    compilerExecutionWireAppendStringField(
        out, "laneKind", stage.laneKind, true)
    compilerExecutionWireAppendRaw32Field(
        out, "outputSemanticRaw32", stage.outputSemanticRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "predecessorReceiptRaw32",
        stage.predecessorReceiptRaw32, true)
    compilerExecutionWireAppendStringField(
        out, "predecessorStageKind", stage.predecessorStageKind, true)
    compilerExecutionWireAppendStringField(
        out, "producerSourcePath", producerSourcePath, true)
    compilerExecutionWireAppendRaw32Field(
        out, "producerSourceRaw32", stage.producerSourceRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "receiptRaw32", stage.receiptRaw32, true)
    compilerExecutionWireAppendI64Field(
        out, "sidecarByteLength", stage.sidecarByteLength, true)
    compilerExecutionWireAppendRaw32Field(
        out, "sidecarBytesRaw32", stage.sidecarBytesRaw32, true)
    compilerExecutionWireAppendStringField(
        out, "sidecarPath", stage.sidecarPath, true)
    compilerExecutionWireAppendStringField(
        out, "sidecarSchema", stage.sidecarSchema, true)
    compilerExecutionWireAppendStringField(
        out, "stageKind", stage.stageKind, true)
    compilerExecutionWireAppendI32Field(
        out, "stageOrdinal", stage.stageOrdinal, false)
    buffer.AppendByte(out, 125)

@borrows
fn compilerExecutionWireCanonicalJson(
        identity: execution_receipt.CompilerExecutionIdentity,
        paths: CompilerExecutionObservedPaths,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        stages: execution_receipt.ExecutionStageReceipt[],
        producerSourcePaths: var str[],
        sevenStageRootRaw32: layout.FixedBytes32,
        includeReceiptSha256: bool,
        receiptSha256: str): str =
    var out = buffer.NewByteBuffer()
    buffer.AppendByte(out, 123)
    compilerExecutionWireAppendKey(out, "identity")
    compilerExecutionWireAppendIdentity(out, identity)
    buffer.AppendByte(out, 44)
    compilerExecutionWireAppendKey(out, "observedIdentityPaths")
    compilerExecutionWireAppendObservedPaths(out, paths)
    buffer.AppendByte(out, 44)
    compilerExecutionWireAppendRaw32Field(
        out, "parserReceiptRaw32", parserReceiptRaw32, true)
    compilerExecutionWireAppendRaw32Field(
        out, "parserSemanticRaw32", parserSemanticRaw32, true)
    if includeReceiptSha256:
        compilerExecutionWireAppendStringField(
            out, "receiptSha256", receiptSha256, true)
    compilerExecutionWireAppendStringField(
        out, "runnerKind",
        "cheng-real-source-bound-seven-stage-pipeline", true)
    compilerExecutionWireAppendStringField(
        out, "schema", "cheng.compiler.execution_stage_bundle", true)
    compilerExecutionWireAppendRaw32Field(
        out, "sevenStageRootRaw32", sevenStageRootRaw32, true)
    compilerExecutionWireAppendKey(out, "stages")
    buffer.AppendByte(out, 91)
    for index in 0..<stages.len:
        compilerExecutionWireAppendStage(
            out, stages[index], producerSourcePaths[index])
        if index + 1 < stages.len:
            buffer.AppendByte(out, 44)
    buffer.AppendByte(out, 93)
    buffer.AppendByte(out, 125)
    return buffer.FinishString(out)

@borrows
fn compilerExecutionWirePathsValid(
        paths: CompilerExecutionObservedPaths,
        stages: execution_receipt.ExecutionStageReceipt[],
        producerSourcePaths: var str[]): bool =
    let identityPaths = [strings.CloneStr(paths.commandManifestPath),
                         strings.CloneStr(paths.compilerSourceClosurePath),
                         strings.CloneStr(paths.driverBytesPath),
                         strings.CloneStr(paths.grammarObligationPath),
                         strings.CloneStr(paths.materializerBytesPath),
                         strings.CloneStr(paths.sourceBundlePath),
                         strings.CloneStr(paths.toolchainManifestPath)]
    for index in 0..<identityPaths.len:
        if !execution_receipt.CompilerExecutionReceiptCanonicalRelativePath(
               identityPaths[index]):
            return false
        for previous in 0..<index:
            if identityPaths[previous] == identityPaths[index]:
                return false
    for index in 0..<producerSourcePaths.len:
        if !execution_receipt.CompilerExecutionReceiptCanonicalRelativePath(
               producerSourcePaths[index]):
            return false
    # A stage artifact may not impersonate another stage's sidecar/artifact.
    # The independent verifier enforces the same fourteen-path uniqueness.
    for index in 0..<stages.len:
        # JSON numbers must stay inside the exact interoperable integer range.
        if stages[index].sidecarByteLength > int64(9007199254740991) ||
           stages[index].artifactByteLength > int64(9007199254740991):
            return false
        for previous in 0..<index:
            if stages[index].sidecarPath == stages[previous].sidecarPath ||
               stages[index].sidecarPath == stages[previous].artifactPath ||
               stages[index].artifactPath == stages[previous].sidecarPath ||
               stages[index].artifactPath == stages[previous].artifactPath:
                return false
    return true

fn compilerExecutionWireSha256Hex(text: str): str =
    var hashInput = layout.ByteBufInit(text.len)
    for index in 0..<text.len:
        layout.ByteBufAppendByte(hashInput, Int32(text[index]) & 255)
    let raw32 = hash256.Sha256Fixed(layout.ByteBufView(hashInput))
    layout.ByteBufFree(hashInput)
    return layout.FixedBytes32Hex(raw32)

# Returns one canonical JSON line terminated by exactly one LF. receiptSha256
# hashes the same recursively sorted object with that one key omitted and with
# no trailing LF, avoiding a circular self hash.
@borrows
fn CompilerExecutionStageBundleCanonicalJson(
        identity: execution_receipt.CompilerExecutionIdentity,
        paths: CompilerExecutionObservedPaths,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        stages: execution_receipt.ExecutionStageReceipt[],
        producerSourcePaths: var str[],
        sevenStageRootRaw32: layout.FixedBytes32): Result[str] =
    let identityRes = execution_receipt.CompilerExecutionIdentityVerify(identity)
    if IsErr(identityRes):
        return Err[str](strings.CloneStr(Error(identityRes)))
    if stages.len != 7 || producerSourcePaths.len != 7:
        return Err[str](
            " compiler execution stage bundle: seven stages and producer paths required")
    if !compilerExecutionWirePathsValid(paths, stages, producerSourcePaths):
        return Err[str](
            " compiler execution stage bundle: evidence path invalid")
    let structureRes = execution_receipt.CompilerSevenStageReceiptValidateStructure(
        identity, parserReceiptRaw32, parserSemanticRaw32, stages)
    if IsErr(structureRes):
        return Err[str](strings.CloneStr(Error(structureRes)))
    if !layout.FixedBytes32Equal(Value(structureRes), sevenStageRootRaw32):
        return Err[str](
            " compiler execution stage bundle: seven-stage root mismatch")
    let payload = compilerExecutionWireCanonicalJson(
        identity,
        paths,
        parserReceiptRaw32,
        parserSemanticRaw32,
        stages,
        producerSourcePaths,
        sevenStageRootRaw32,
        false,
        "")
    let receiptSha256 = compilerExecutionWireSha256Hex(payload)
    let document = compilerExecutionWireCanonicalJson(
        identity,
        paths,
        parserReceiptRaw32,
        parserSemanticRaw32,
        stages,
        producerSourcePaths,
        sevenStageRootRaw32,
        true,
        receiptSha256)
    return Ok[str](Fmt"{document}\n")
