import std/result
import std/strings
import cheng/std/bytes_layout as layout
import cheng/chain/lsmr_types as lt
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec
import cheng/core/lang/parser
import std/strutils as strutil
import std/path as chengpath

type
    CompilerMigrationSemanticProof =
        proofKind: str
        packageId: str
        channel: str
        migrationEvidenceCid: layout.FixedBytes32
        legacySourceIdentityReceiptCid: layout.FixedBytes32
        migratedSourceIdentityReceiptCid: layout.FixedBytes32
        baselineGraphCid: layout.FixedBytes32
        migratedGraphCid: layout.FixedBytes32
        baselineSurfaceCid: layout.FixedBytes32
        migratedSurfaceCid: layout.FixedBytes32
        baselineSemanticReceiptCid: layout.FixedBytes32
        migratedSemanticReceiptCid: layout.FixedBytes32
        baselineSemanticSourceIdentityReceiptCid: layout.FixedBytes32
        migratedSemanticSourceIdentityReceiptCid: layout.FixedBytes32
        baselineSemanticCompilerCsgCid: layout.FixedBytes32
        migratedSemanticCompilerCsgCid: layout.FixedBytes32
        baselineSemanticOutputDigest: layout.FixedBytes32
        migratedSemanticOutputDigest: layout.FixedBytes32
        baselineSemanticTargetTripleCid: layout.FixedBytes32
        migratedSemanticTargetTripleCid: layout.FixedBytes32
        baselineSemanticBootstrapStageCid: layout.FixedBytes32
        migratedSemanticBootstrapStageCid: layout.FixedBytes32
        baselineSemanticProviderSetCid: layout.FixedBytes32
        migratedSemanticProviderSetCid: layout.FixedBytes32
        targetTriple: str
        graphEquivalent: int32
        exportSurfaceCompatible: int32
        semanticEquivalent: int32
        equivalenceLabel: str
        proofCid: layout.FixedBytes32

    CompilerMigrationEvidence =
        packageId: str
        entryModulePath: str
        unitCount: int32
        orderedModulePaths: str[]
        legacyRawByteLengths: int32[]
        legacyRawCids: layout.FixedBytes32[]
        migratedRawByteLengths: int32[]
        migratedRawCids: layout.FixedBytes32[]
        ruleIds: str[]
        legacySourceBundleCid: layout.FixedBytes32
        migratedSourceBundleCid: layout.FixedBytes32
        legacySourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
        migratedSourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
        evidenceCid: layout.FixedBytes32

@borrows
fn CompilerEquivalenceAppendText(buf: var layout.ByteBuf, text: str) =
    lt.AppendU32BE(buf, len(text))
    for i in 0..<len(text):
        layout.ByteBufAppendByte(buf, int32(text[i]) & 255)

fn CompilerEquivalenceAppendU32Field(buf: var layout.ByteBuf,
                                      value: int32) =
    lt.AppendU32BE(buf, 4)
    lt.AppendU32BE(buf, value)

@borrows
fn CompilerEquivalenceAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    lt.AppendU32BE(buf, 32)
    lt.AppendFixed32(buf, value)

fn CompilerEquivalenceFlag(value: bool): int32 =
    if value:
        return 1
    return 0

fn CompilerEquivalenceKind(graphEquivalent: bool,
                             exportSurfaceCompatible: bool,
                             semanticEquivalent: bool): str =
    if graphEquivalent:
        if exportSurfaceCompatible:
            if semanticEquivalent:
                return "canonical_semantic_identity"
    return "incompatible"

@borrows
fn CompilerEquivalenceModulePathValid(modulePath: str): bool =
    if modulePath == "" || modulePath[0] == '/' ||
       modulePath[modulePath.len - 1] == '/':
        return false
    var partStart: int32
    for i in 0..<modulePath.len:
        let ch = modulePath[i]
        if ch == '\\' || ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r':
            return false
        if ch != '/':
            continue
        if i <= partStart:
            return false
        let part = chengpath.TextSlice(modulePath, partStart, i - partStart)
        if part == "." || part == "..":
            return false
        partStart = i + 1
    if partStart >= modulePath.len:
        return false
    let tail = chengpath.TextSlice(modulePath, partStart, modulePath.len - partStart)
    return tail != "." && tail != ".."

@borrows
fn CompilerEquivalencePackageIdValid(packageId: str): bool =
    return parser.ParserManifestNormalizePackageId(packageId) == packageId &&
           parser.ParserSourceIdentityModuleTextValid(packageId)

@borrows
fn CompilerEquivalenceModuleOwnedByPackage(modulePath: str,
                                            packageId: str): bool =
    if modulePath.len <= packageId.len || modulePath[packageId.len] != '/':
        return false
    for i in 0..<packageId.len:
        if modulePath[i] != packageId[i]:
            return false
    return true

@borrows
fn CompilerEquivalenceReportValue(text: str, key: str): str =
    let lines = strutil.Split(text, '\n')
    let prefix = strutil.Join([share(key), "="], "")
    for i in 0..<lines.len:
        if !strutil.StartsWith(lines[i], prefix):
            continue
        return chengpath.TextSlice(lines[i], prefix.len,
                                   lines[i].len - prefix.len)
    return ""

@borrows
fn CompilerEquivalenceParseInt32Exact(text: str,
                                      out: var int32): bool =
    if text == "":
        return false
    let value = int32(strutil.ParseInt(text))
    if IntToStr(value) != text:
        return false
    out = value
    return true

@borrows
fn CompilerEquivalenceStrLess(left: str, right: str): bool =
    if left == right:
        return false
    var sharedLen = right.len
    if left.len < right.len:
        sharedLen = left.len
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return left[i] < right[i]
    return left.len < right.len

@borrows
fn CompilerMigrationCanonicalUnitOrder(migration: ccsg.CompilerLegacyMigration,
                                         outOrder: var int32[]): Result[bool] =
    if migration.unitCount <= 0 ||
       migration.unitCount != migration.units.len ||
       !CompilerEquivalencePackageIdValid(migration.packageId) ||
       !CompilerEquivalenceModulePathValid(migration.entryModulePath):
        return Err[bool](" compiler equivalence: invalid migration identity")
    var entryCount: int32
    for i in 0..<migration.units.len:
        let modulePath = migration.units[i].modulePath
        if !CompilerEquivalenceModulePathValid(modulePath) ||
           !CompilerEquivalenceModuleOwnedByPackage(modulePath,
                                                    migration.packageId):
            return Err[bool](" compiler equivalence: non-canonical migration module path")
        for j in 0..<i:
            if migration.units[j].modulePath == modulePath:
                return Err[bool](" compiler equivalence: duplicate migration module path")
        if modulePath == migration.entryModulePath:
            entryCount = entryCount + 1
        var insertAt = outOrder.len
        while insertAt > 0 && CompilerEquivalenceStrLess(
                modulePath,
                migration.units[outOrder[insertAt - 1]].modulePath):
            insertAt = insertAt - 1
        add(outOrder, i)
        var cursor = outOrder.len - 1
        while cursor > insertAt:
            outOrder[cursor] = outOrder[cursor - 1]
            cursor = cursor - 1
        outOrder[insertAt] = i
    if entryCount != 1 || !CompilerEquivalenceModuleOwnedByPackage(
            migration.entryModulePath,
            migration.packageId):
        return Err[bool](" compiler equivalence: migration entry module mismatch")
    return Ok[bool](true)

@borrows
fn CompilerMigrationPortableSourceBundleCid(packageId: str,
                                              modulePaths: str[],
                                              rawByteLengths: int32[],
                                              rawCids: layout.FixedBytes32[]): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(320)
    CompilerEquivalenceAppendText(buf, "cheng.compiler.source_bundle.portable")
    CompilerEquivalenceAppendText(buf, packageId)
    CompilerEquivalenceAppendU32Field(buf, modulePaths.len)
    for i in 0..<modulePaths.len:
        CompilerEquivalenceAppendText(buf, modulePaths[i])
        CompilerEquivalenceAppendU32Field(buf, rawByteLengths[i])
        CompilerEquivalenceAppendFixed32Field(buf, rawCids[i])
    let out = lt.FixedCidFromBuf(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn CompilerMigrationRawBytesCid(text: str): layout.FixedBytes32 =
    return cworld.CompilerWorldSourceRawBytesCid(text)

@borrows
fn CompilerMigrationSourceReceiptEqual(
        left: ccsg.PortableSourceIdentityReceipt,
        right: ccsg.PortableSourceIdentityReceipt): bool =
    return left.sourceSnapshotCount == right.sourceSnapshotCount &&
           left.importEdgeCount == right.importEdgeCount &&
           left.unresolvedImportCount == right.unresolvedImportCount &&
           layout.FixedBytes32Equal(left.sourcePackageIdCid,
                                    right.sourcePackageIdCid) &&
           layout.FixedBytes32Equal(left.entryModulePathCid,
                                    right.entryModulePathCid) &&
           layout.FixedBytes32Equal(left.sourceBundleCid,
                                    right.sourceBundleCid) &&
           layout.FixedBytes32Equal(left.entrySourceCid,
                                    right.entrySourceCid) &&
           layout.FixedBytes32Equal(left.importGraphCid,
                                    right.importGraphCid) &&
           layout.FixedBytes32Equal(left.receiptCid,
                                    right.receiptCid)

@borrows
fn CompilerMigrationSourceReceiptMismatchField(
        actual: ccsg.PortableSourceIdentityReceipt,
        expected: ccsg.PortableSourceIdentityReceipt): str =
    if actual.sourceSnapshotCount != expected.sourceSnapshotCount:
        return "source_snapshot_count"
    if actual.importEdgeCount != expected.importEdgeCount:
        return "import_edge_count"
    if actual.unresolvedImportCount != expected.unresolvedImportCount:
        return "unresolved_import_count"
    if !layout.FixedBytes32Equal(actual.sourcePackageIdCid,
                                 expected.sourcePackageIdCid):
        return "source_package_id_cid"
    if !layout.FixedBytes32Equal(actual.entryModulePathCid,
                                 expected.entryModulePathCid):
        return "entry_module_path_cid"
    if !layout.FixedBytes32Equal(actual.sourceBundleCid,
                                 expected.sourceBundleCid):
        return "source_bundle_cid"
    if !layout.FixedBytes32Equal(actual.entrySourceCid,
                                 expected.entrySourceCid):
        return "entry_source_cid"
    if !layout.FixedBytes32Equal(actual.importGraphCid,
                                 expected.importGraphCid):
        return "import_graph_cid"
    if !layout.FixedBytes32Equal(actual.receiptCid,
                                 expected.receiptCid):
        return "receipt_cid"
    return ""

@borrows
fn CompilerMigrationSourceReceiptFromTextsInto(
        packageId: str,
        entryModulePath: str,
        modulePaths: str[],
        sourceTexts: str[],
        out: var ccsg.PortableSourceIdentityReceipt,
        err: var str): bool =
    var importEdges: parser.ImportEdge[]
    if !slplan.SystemLinkPlanPortableImportEdgesFromTextsInto(
            modulePaths,
            sourceTexts,
            importEdges,
            err):
        return false
    var binding: slplan.SystemLinkPlanPortableSourceBinding
    if !slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
            share(packageId),
            share(entryModulePath),
            modulePaths,
            sourceTexts,
            importEdges,
            binding,
            err):
        return false
    if !ccsg.PortableSourceIdentityReceiptMakeInto(
            binding.sourceCount,
            binding.importEdgeCount,
            0,
            packageId,
            entryModulePath,
            binding.sourceBundleCid,
            binding.entrySourceCid,
            binding.importGraphCid,
            out,
            err):
        return false
    if !layout.FixedBytes32Equal(out.sourceBundleCid,
                                 binding.sourceBundleCid) ||
       !layout.FixedBytes32Equal(out.entrySourceCid,
                                 binding.entrySourceCid) ||
       !layout.FixedBytes32Equal(out.importGraphCid,
                                 binding.importGraphCid):
        err = " compiler equivalence: portable source receipt/binding mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerMigrationEvidenceReceiptAppend(
        buf: var layout.ByteBuf,
        receipt: ccsg.PortableSourceIdentityReceipt) =
    CompilerEquivalenceAppendU32Field(buf, receipt.sourceSnapshotCount)
    CompilerEquivalenceAppendU32Field(buf, receipt.importEdgeCount)
    CompilerEquivalenceAppendU32Field(buf, receipt.unresolvedImportCount)
    CompilerEquivalenceAppendFixed32Field(buf, receipt.sourcePackageIdCid)
    CompilerEquivalenceAppendFixed32Field(buf, receipt.entryModulePathCid)
    CompilerEquivalenceAppendFixed32Field(buf, receipt.sourceBundleCid)
    CompilerEquivalenceAppendFixed32Field(buf, receipt.entrySourceCid)
    CompilerEquivalenceAppendFixed32Field(buf, receipt.importGraphCid)
    CompilerEquivalenceAppendFixed32Field(buf, receipt.receiptCid)

@borrows
fn CompilerMigrationCanonicalRules(rules: str[],
                                     outRules: var str[]): Result[bool] =
    for i in 0..<rules.len:
        if rules[i] == "":
            return Err[bool](" compiler equivalence: empty migration rule id")
        for j in 0..<i:
            if rules[j] == rules[i]:
                return Err[bool](" compiler equivalence: duplicate migration rule id")
        var insertAt = outRules.len
        while insertAt > 0 &&
              CompilerEquivalenceStrLess(rules[i], outRules[insertAt - 1]):
            insertAt = insertAt - 1
        add(outRules, share(rules[i]))
        var cursor = outRules.len - 1
        while cursor > insertAt:
            outRules[cursor] = outRules[cursor - 1]
            cursor = cursor - 1
        outRules[insertAt] = share(rules[i])
    return Ok[bool](true)

@borrows
fn CompilerMigrationEvidenceMake(
        migration: ccsg.CompilerLegacyMigration,
        out: var CompilerMigrationEvidence): Result[bool] =
    let legacySourceIdentityReceipt =
        migration.baselineArtifact.sourceIdentityReceipt
    let migratedSourceIdentityReceipt =
        migration.migratedArtifact.sourceIdentityReceipt
    var order: int32[]
    let orderRes = CompilerMigrationCanonicalUnitOrder(migration, order)
    if IsErr(orderRes):
        return Err[bool](Error(orderRes))
    var canonicalRules: str[]
    let rulesRes = CompilerMigrationCanonicalRules(migration.appliedRules,
                                                    canonicalRules)
    if IsErr(rulesRes):
        return Err[bool](Error(rulesRes))
    var orderedModulePaths: str[]
    var legacyRawByteLengths: int32[]
    var legacyRawCids: layout.FixedBytes32[]
    var migratedRawByteLengths: int32[]
    var migratedRawCids: layout.FixedBytes32[]
    var legacyTexts: str[]
    var migratedTexts: str[]
    for orderIndex in 0..<order.len:
        let unitIndex = order[orderIndex]
        let modulePath = migration.units[unitIndex].modulePath
        let legacyRawCid = CompilerMigrationRawBytesCid(
            migration.units[unitIndex].legacyText)
        let migratedRawCid = CompilerMigrationRawBytesCid(
            migration.units[unitIndex].migratedText)
        add(orderedModulePaths, share(modulePath))
        add(legacyRawByteLengths, migration.units[unitIndex].legacyText.len)
        add(legacyRawCids, legacyRawCid)
        add(migratedRawByteLengths, migration.units[unitIndex].migratedText.len)
        add(migratedRawCids, migratedRawCid)
        add(legacyTexts, share(migration.units[unitIndex].legacyText))
        add(migratedTexts, share(migration.units[unitIndex].migratedText))
    var expectedLegacyReceipt: ccsg.PortableSourceIdentityReceipt
    var receiptErr: str
    if !CompilerMigrationSourceReceiptFromTextsInto(
            migration.packageId,
            migration.entryModulePath,
            share(orderedModulePaths),
            legacyTexts,
            expectedLegacyReceipt,
            receiptErr):
        return Err[bool](receiptErr)
    var expectedMigratedReceipt: ccsg.PortableSourceIdentityReceipt
    if !CompilerMigrationSourceReceiptFromTextsInto(
            migration.packageId,
            migration.entryModulePath,
            share(orderedModulePaths),
            migratedTexts,
            expectedMigratedReceipt,
            receiptErr):
        return Err[bool](receiptErr)
    let legacyMismatch = CompilerMigrationSourceReceiptMismatchField(
        legacySourceIdentityReceipt,
        expectedLegacyReceipt)
    if legacyMismatch != "":
        return Err[bool](strutil.Join([
            " compiler equivalence: legacy source receipt predecessor mismatch field=",
            legacyMismatch
        ], ""))
    let migratedMismatch = CompilerMigrationSourceReceiptMismatchField(
        migratedSourceIdentityReceipt,
        expectedMigratedReceipt)
    if migratedMismatch != "":
        return Err[bool](strutil.Join([
            " compiler equivalence: migrated source receipt predecessor mismatch field=",
            migratedMismatch
        ], ""))
    let legacyPortableCid = CompilerMigrationPortableSourceBundleCid(
        migration.packageId,
        orderedModulePaths,
        legacyRawByteLengths,
        legacyRawCids)
    let migratedPortableCid = CompilerMigrationPortableSourceBundleCid(
        migration.packageId,
        orderedModulePaths,
        migratedRawByteLengths,
        migratedRawCids)
    if !layout.FixedBytes32Equal(legacyPortableCid,
                                 legacySourceIdentityReceipt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(migratedPortableCid,
                                 migratedSourceIdentityReceipt.sourceBundleCid):
        return Err[bool](
            " compiler equivalence: migration portable bundle/receipt mismatch")
    out.packageId = migration.packageId
    out.entryModulePath = migration.entryModulePath
    out.unitCount = migration.unitCount
    out.orderedModulePaths = orderedModulePaths
    out.legacyRawByteLengths = legacyRawByteLengths
    out.legacyRawCids = legacyRawCids
    out.migratedRawByteLengths = migratedRawByteLengths
    out.migratedRawCids = migratedRawCids
    out.ruleIds = canonicalRules
    out.legacySourceBundleCid = legacyPortableCid
    out.migratedSourceBundleCid = migratedPortableCid
    out.legacySourceIdentityReceipt = legacySourceIdentityReceipt
    out.migratedSourceIdentityReceipt = migratedSourceIdentityReceipt
    out.evidenceCid = CompilerMigrationEvidenceCid(out)
    if !CompilerMigrationEvidenceVerify(out):
        return Err[bool](
            " compiler equivalence: constructed evidence is invalid")
    return Ok[bool](true)

fn CompilerMigrationSourceReceiptsFromMigrationInto(
        migration: ccsg.CompilerLegacyMigration,
        outLegacy: var ccsg.PortableSourceIdentityReceipt,
        outMigrated: var ccsg.PortableSourceIdentityReceipt): Result[bool] =
    var order: int32[]
    let orderRes = CompilerMigrationCanonicalUnitOrder(migration, order)
    if IsErr(orderRes):
        return Err[bool](Error(orderRes))
    var modulePaths: str[]
    var legacyTexts: str[]
    var migratedTexts: str[]
    for orderIndex in 0..<order.len:
        let unit = migration.units[order[orderIndex]]
        add(modulePaths, share(unit.modulePath))
        add(legacyTexts, share(unit.legacyText))
        add(migratedTexts, share(unit.migratedText))
    var receiptErr: str
    if !CompilerMigrationSourceReceiptFromTextsInto(
            migration.packageId,
            migration.entryModulePath,
            share(modulePaths),
            legacyTexts,
            outLegacy,
            receiptErr):
        return Err[bool](receiptErr)
    if !CompilerMigrationSourceReceiptFromTextsInto(
            migration.packageId,
            migration.entryModulePath,
            modulePaths,
            migratedTexts,
            outMigrated,
            receiptErr):
        return Err[bool](receiptErr)
    return Ok[bool](true)

@borrows
fn CompilerMigrationEvidenceCid(evidence: CompilerMigrationEvidence): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(384)
    CompilerEquivalenceAppendText(buf, "cheng.compiler.migration_evidence")
    CompilerEquivalenceAppendText(buf, evidence.packageId)
    CompilerEquivalenceAppendText(buf, evidence.entryModulePath)
    CompilerEquivalenceAppendU32Field(buf, evidence.unitCount)
    CompilerEquivalenceAppendFixed32Field(buf,
                                          evidence.legacySourceBundleCid)
    CompilerEquivalenceAppendFixed32Field(buf,
                                          evidence.migratedSourceBundleCid)
    CompilerMigrationEvidenceReceiptAppend(
        buf,
        evidence.legacySourceIdentityReceipt)
    CompilerMigrationEvidenceReceiptAppend(
        buf,
        evidence.migratedSourceIdentityReceipt)
    for i in 0..<evidence.orderedModulePaths.len:
        CompilerEquivalenceAppendText(buf, evidence.orderedModulePaths[i])
        CompilerEquivalenceAppendU32Field(
            buf,
            evidence.legacyRawByteLengths[i])
        CompilerEquivalenceAppendFixed32Field(buf,
                                               evidence.legacyRawCids[i])
        CompilerEquivalenceAppendU32Field(
            buf,
            evidence.migratedRawByteLengths[i])
        CompilerEquivalenceAppendFixed32Field(buf,
                                               evidence.migratedRawCids[i])
    CompilerEquivalenceAppendU32Field(buf, evidence.ruleIds.len)
    for i in 0..<evidence.ruleIds.len:
        CompilerEquivalenceAppendText(buf, evidence.ruleIds[i])
    let out = lt.FixedCidFromBuf(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn CompilerMigrationEvidenceVerify(evidence: CompilerMigrationEvidence): bool =
    if evidence.unitCount <= 0 ||
       evidence.unitCount != evidence.orderedModulePaths.len ||
       evidence.unitCount != evidence.legacyRawByteLengths.len ||
       evidence.unitCount != evidence.legacyRawCids.len ||
       evidence.unitCount != evidence.migratedRawByteLengths.len ||
       evidence.unitCount != evidence.migratedRawCids.len ||
       !CompilerEquivalencePackageIdValid(evidence.packageId) ||
       !CompilerEquivalenceModulePathValid(evidence.entryModulePath):
        return false
    var entrySeen = false
    var entryIndex: int32 = -1
    var rawChanged = false
    for i in 0..<evidence.unitCount:
        if !CompilerEquivalenceModulePathValid(evidence.orderedModulePaths[i]) ||
           !CompilerEquivalenceModuleOwnedByPackage(evidence.orderedModulePaths[i],
                                                    evidence.packageId) ||
           evidence.legacyRawByteLengths[i] < 0 ||
           evidence.migratedRawByteLengths[i] < 0 ||
           layout.FixedBytes32Equal(evidence.legacyRawCids[i], layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(evidence.migratedRawCids[i], layout.FixedBytes32()):
            return false
        if i > 0 && !CompilerEquivalenceStrLess(evidence.orderedModulePaths[i - 1],
                                                 evidence.orderedModulePaths[i]):
            return false
        if evidence.orderedModulePaths[i] == evidence.entryModulePath:
            entrySeen = true
            entryIndex = i
        if evidence.legacyRawByteLengths[i] !=
                evidence.migratedRawByteLengths[i] ||
           !layout.FixedBytes32Equal(evidence.legacyRawCids[i],
                                     evidence.migratedRawCids[i]):
            rawChanged = true
    if !entrySeen || entryIndex < 0 || !rawChanged ||
       !CompilerEquivalenceModuleOwnedByPackage(
            evidence.entryModulePath,
            evidence.packageId):
        return false
    for i in 0..<evidence.ruleIds.len:
        if evidence.ruleIds[i] == "":
            return false
        if i > 0 && !CompilerEquivalenceStrLess(evidence.ruleIds[i - 1],
                                                 evidence.ruleIds[i]):
            return false
    let legacyBundleCid = CompilerMigrationPortableSourceBundleCid(
        evidence.packageId,
        evidence.orderedModulePaths,
        evidence.legacyRawByteLengths,
        evidence.legacyRawCids)
    let migratedBundleCid = CompilerMigrationPortableSourceBundleCid(
        evidence.packageId,
        evidence.orderedModulePaths,
        evidence.migratedRawByteLengths,
        evidence.migratedRawCids)
    var legacyReceipt = evidence.legacySourceIdentityReceipt
    var migratedReceipt = evidence.migratedSourceIdentityReceipt
    var receiptErr: str
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            legacyReceipt,
            receiptErr) ||
       !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            migratedReceipt,
            receiptErr):
        return false
    if legacyReceipt.sourceSnapshotCount != evidence.unitCount ||
       migratedReceipt.sourceSnapshotCount != evidence.unitCount ||
       !layout.FixedBytes32Equal(
            legacyReceipt.sourcePackageIdCid,
            ccsg.CompilerCsgPortableSourcePackageIdCid(evidence.packageId)) ||
       !layout.FixedBytes32Equal(
            migratedReceipt.sourcePackageIdCid,
            ccsg.CompilerCsgPortableSourcePackageIdCid(evidence.packageId)) ||
       !layout.FixedBytes32Equal(
            legacyReceipt.entryModulePathCid,
            ccsg.CompilerCsgPortableEntryModulePathCid(
                evidence.entryModulePath)) ||
       !layout.FixedBytes32Equal(
            migratedReceipt.entryModulePathCid,
            ccsg.CompilerCsgPortableEntryModulePathCid(
                evidence.entryModulePath)) ||
       !layout.FixedBytes32Equal(
            legacyReceipt.entrySourceCid,
            evidence.legacyRawCids[entryIndex]) ||
       !layout.FixedBytes32Equal(
            migratedReceipt.entrySourceCid,
            evidence.migratedRawCids[entryIndex]):
        return false
    if !layout.FixedBytes32Equal(legacyBundleCid, evidence.legacySourceBundleCid) ||
       !layout.FixedBytes32Equal(migratedBundleCid, evidence.migratedSourceBundleCid) ||
       !layout.FixedBytes32Equal(legacyBundleCid,
                                 legacyReceipt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(migratedBundleCid,
                                 migratedReceipt.sourceBundleCid):
        return false
    return layout.FixedBytes32Equal(evidence.evidenceCid,
                                    CompilerMigrationEvidenceCid(evidence))

fn CompilerMigrationSemanticProofSemanticReceipt(
        sourceIdentityReceiptCid: layout.FixedBytes32,
        compilerCsgCid: layout.FixedBytes32,
        outputDigest: layout.FixedBytes32,
        targetTripleCid: layout.FixedBytes32,
        bootstrapStageCid: layout.FixedBytes32,
        providerSetCid: layout.FixedBytes32,
        receiptCid: layout.FixedBytes32): sexec.CompileSemanticReceipt =
    var out: sexec.CompileSemanticReceipt
    out.sourceIdentityReceiptCid = sourceIdentityReceiptCid
    out.canonicalCompilerCsgCid = compilerCsgCid
    out.canonicalOutputDigest = outputDigest
    out.targetTripleCid = targetTripleCid
    out.bootstrapStageCid = bootstrapStageCid
    out.orderedProviderSetCid = providerSetCid
    out.receiptCid = receiptCid
    return out

@borrows
fn CompilerEquivalenceSemanticReceiptsEquivalent(
        baseline: sexec.CompileSemanticReceipt,
        migrated: sexec.CompileSemanticReceipt): bool =
    return layout.FixedBytes32Equal(baseline.canonicalCompilerCsgCid,
                                    migrated.canonicalCompilerCsgCid) &&
           layout.FixedBytes32Equal(baseline.canonicalOutputDigest,
                                    migrated.canonicalOutputDigest) &&
           layout.FixedBytes32Equal(baseline.targetTripleCid,
                                    migrated.targetTripleCid) &&
           layout.FixedBytes32Equal(baseline.bootstrapStageCid,
                                    migrated.bootstrapStageCid) &&
           layout.FixedBytes32Equal(baseline.orderedProviderSetCid,
                                    migrated.orderedProviderSetCid)

@borrows
fn CompilerMigrationSemanticProofCid(proof: CompilerMigrationSemanticProof): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(896)
    CompilerEquivalenceAppendText(buf, "cheng.compiler.migration_semantic_proof")
    CompilerEquivalenceAppendText(buf, proof.proofKind)
    CompilerEquivalenceAppendText(buf, proof.packageId)
    CompilerEquivalenceAppendText(buf, proof.channel)
    CompilerEquivalenceAppendFixed32Field(buf, proof.migrationEvidenceCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.legacySourceIdentityReceiptCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.migratedSourceIdentityReceiptCid)
    CompilerEquivalenceAppendFixed32Field(buf, proof.baselineGraphCid)
    CompilerEquivalenceAppendFixed32Field(buf, proof.migratedGraphCid)
    CompilerEquivalenceAppendFixed32Field(buf, proof.baselineSurfaceCid)
    CompilerEquivalenceAppendFixed32Field(buf, proof.migratedSurfaceCid)
    CompilerEquivalenceAppendFixed32Field(buf,
                                          proof.baselineSemanticReceiptCid)
    CompilerEquivalenceAppendFixed32Field(buf,
                                          proof.migratedSemanticReceiptCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.baselineSemanticSourceIdentityReceiptCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.migratedSemanticSourceIdentityReceiptCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.baselineSemanticCompilerCsgCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.migratedSemanticCompilerCsgCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.baselineSemanticOutputDigest)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.migratedSemanticOutputDigest)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.baselineSemanticTargetTripleCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.migratedSemanticTargetTripleCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.baselineSemanticBootstrapStageCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.migratedSemanticBootstrapStageCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.baselineSemanticProviderSetCid)
    CompilerEquivalenceAppendFixed32Field(
        buf,
        proof.migratedSemanticProviderSetCid)
    CompilerEquivalenceAppendText(buf, proof.targetTriple)
    CompilerEquivalenceAppendU32Field(buf, proof.graphEquivalent)
    CompilerEquivalenceAppendU32Field(buf, proof.exportSurfaceCompatible)
    CompilerEquivalenceAppendU32Field(buf, proof.semanticEquivalent)
    CompilerEquivalenceAppendText(buf, proof.equivalenceLabel)
    let out = lt.FixedCidFromBuf(buf)
    layout.ByteBufFree(buf)
    return out

@borrows
fn CompilerMigrationSemanticProofMake(
        packageId: str,
        channelRaw: str,
        migrationEvidence: CompilerMigrationEvidence,
        baselineGraphCid: layout.FixedBytes32,
        migratedGraphCid: layout.FixedBytes32,
        baselineSurface: ccsg.CsgExportSurface,
        migratedSurface: ccsg.CsgExportSurface,
        baselineSemanticReceipt: sexec.CompileSemanticReceipt,
        migratedSemanticReceipt: sexec.CompileSemanticReceipt,
        targetTriple: str,
        out: var CompilerMigrationSemanticProof): Result[bool] =
    let channelRes = cworld.CompilerWorldNormalizeChannel(channelRaw)
    if IsErr(channelRes):
        return Err[bool](Error(channelRes))
    var semanticErr: str
    if !sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            baselineSemanticReceipt,
            semanticErr) ||
       !sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            migratedSemanticReceipt,
            semanticErr):
        return Err[bool](semanticErr)
    let targetTripleCid = sexec.SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        targetTriple)
    if !CompilerEquivalencePackageIdValid(packageId) ||
       baselineSurface.packageId != packageId ||
       migratedSurface.packageId != packageId ||
       targetTriple == "" ||
       migrationEvidence.packageId != packageId ||
       !CompilerMigrationEvidenceVerify(migrationEvidence) ||
       !layout.FixedBytes32Equal(
            baselineSemanticReceipt.sourceIdentityReceiptCid,
            migrationEvidence.legacySourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            migratedSemanticReceipt.sourceIdentityReceiptCid,
            migrationEvidence.migratedSourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            baselineSemanticReceipt.canonicalCompilerCsgCid,
            baselineGraphCid) ||
       !layout.FixedBytes32Equal(
            migratedSemanticReceipt.canonicalCompilerCsgCid,
            migratedGraphCid) ||
       !layout.FixedBytes32Equal(baselineSemanticReceipt.targetTripleCid,
                                 targetTripleCid) ||
       !layout.FixedBytes32Equal(migratedSemanticReceipt.targetTripleCid,
                                 targetTripleCid) ||
       layout.FixedBytes32Equal(baselineSurface.surfaceCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(migratedSurface.surfaceCid,
                                layout.FixedBytes32()):
        return Err[bool](" compiler equivalence: proof predecessor mismatch")
    out.proofKind = "migration_semantic"
    out.packageId = strings.CloneStr(packageId)
    out.channel = Value(channelRes)
    out.migrationEvidenceCid = migrationEvidence.evidenceCid
    out.legacySourceIdentityReceiptCid =
        migrationEvidence.legacySourceIdentityReceipt.receiptCid
    out.migratedSourceIdentityReceiptCid =
        migrationEvidence.migratedSourceIdentityReceipt.receiptCid
    out.baselineGraphCid = baselineGraphCid
    out.migratedGraphCid = migratedGraphCid
    out.baselineSurfaceCid = baselineSurface.surfaceCid
    out.migratedSurfaceCid = migratedSurface.surfaceCid
    out.baselineSemanticReceiptCid = baselineSemanticReceipt.receiptCid
    out.migratedSemanticReceiptCid = migratedSemanticReceipt.receiptCid
    out.baselineSemanticSourceIdentityReceiptCid =
        baselineSemanticReceipt.sourceIdentityReceiptCid
    out.migratedSemanticSourceIdentityReceiptCid =
        migratedSemanticReceipt.sourceIdentityReceiptCid
    out.baselineSemanticCompilerCsgCid =
        baselineSemanticReceipt.canonicalCompilerCsgCid
    out.migratedSemanticCompilerCsgCid =
        migratedSemanticReceipt.canonicalCompilerCsgCid
    out.baselineSemanticOutputDigest =
        baselineSemanticReceipt.canonicalOutputDigest
    out.migratedSemanticOutputDigest =
        migratedSemanticReceipt.canonicalOutputDigest
    out.baselineSemanticTargetTripleCid = baselineSemanticReceipt.targetTripleCid
    out.migratedSemanticTargetTripleCid = migratedSemanticReceipt.targetTripleCid
    out.baselineSemanticBootstrapStageCid =
        baselineSemanticReceipt.bootstrapStageCid
    out.migratedSemanticBootstrapStageCid =
        migratedSemanticReceipt.bootstrapStageCid
    out.baselineSemanticProviderSetCid =
        baselineSemanticReceipt.orderedProviderSetCid
    out.migratedSemanticProviderSetCid =
        migratedSemanticReceipt.orderedProviderSetCid
    out.targetTriple = strings.CloneStr(targetTriple)
    out.graphEquivalent = CompilerEquivalenceFlag(
        layout.FixedBytes32Equal(baselineGraphCid, migratedGraphCid))
    out.exportSurfaceCompatible = CompilerEquivalenceFlag(
        layout.FixedBytes32Equal(baselineSurface.surfaceCid,
                                 migratedSurface.surfaceCid))
    out.semanticEquivalent = CompilerEquivalenceFlag(
        CompilerEquivalenceSemanticReceiptsEquivalent(
            baselineSemanticReceipt,
            migratedSemanticReceipt))
    out.equivalenceLabel = CompilerEquivalenceKind(out.graphEquivalent != 0,
                                                    out.exportSurfaceCompatible != 0,
                                                    out.semanticEquivalent != 0)
    out.proofCid = CompilerMigrationSemanticProofCid(out)
    if !CompilerMigrationSemanticProofVerify(out):
        return Err[bool](" compiler equivalence: constructed proof invalid")
    return Ok[bool](true)

@borrows
fn CompilerMigrationSemanticProofVerify(proof: CompilerMigrationSemanticProof): bool =
    if proof.proofKind != "migration_semantic":
        return false
    let channelRes = cworld.CompilerWorldNormalizeChannel(proof.channel)
    if IsErr(channelRes) || Value(channelRes) != proof.channel ||
       !CompilerEquivalencePackageIdValid(proof.packageId) ||
       proof.targetTriple == "" ||
       layout.FixedBytes32Equal(proof.migrationEvidenceCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(proof.legacySourceIdentityReceiptCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(proof.migratedSourceIdentityReceiptCid,
                                layout.FixedBytes32()):
        return false
    let baselineSemantic = CompilerMigrationSemanticProofSemanticReceipt(
        proof.baselineSemanticSourceIdentityReceiptCid,
        proof.baselineSemanticCompilerCsgCid,
        proof.baselineSemanticOutputDigest,
        proof.baselineSemanticTargetTripleCid,
        proof.baselineSemanticBootstrapStageCid,
        proof.baselineSemanticProviderSetCid,
        proof.baselineSemanticReceiptCid)
    let migratedSemantic = CompilerMigrationSemanticProofSemanticReceipt(
        proof.migratedSemanticSourceIdentityReceiptCid,
        proof.migratedSemanticCompilerCsgCid,
        proof.migratedSemanticOutputDigest,
        proof.migratedSemanticTargetTripleCid,
        proof.migratedSemanticBootstrapStageCid,
        proof.migratedSemanticProviderSetCid,
        proof.migratedSemanticReceiptCid)
    var semanticErr: str
    if !sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            baselineSemantic,
            semanticErr) ||
       !sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            migratedSemantic,
            semanticErr):
        return false
    let targetTripleCid = sexec.SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        proof.targetTriple)
    if !layout.FixedBytes32Equal(
            proof.baselineSemanticSourceIdentityReceiptCid,
            proof.legacySourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(
            proof.migratedSemanticSourceIdentityReceiptCid,
            proof.migratedSourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(proof.baselineSemanticCompilerCsgCid,
                                 proof.baselineGraphCid) ||
       !layout.FixedBytes32Equal(proof.migratedSemanticCompilerCsgCid,
                                 proof.migratedGraphCid) ||
       !layout.FixedBytes32Equal(proof.baselineSemanticTargetTripleCid,
                                 targetTripleCid) ||
       !layout.FixedBytes32Equal(proof.migratedSemanticTargetTripleCid,
                                 targetTripleCid):
        return false
    let graphEquivalent = CompilerEquivalenceFlag(
        layout.FixedBytes32Equal(proof.baselineGraphCid,
                                 proof.migratedGraphCid))
    let surfaceCompatible = CompilerEquivalenceFlag(
        layout.FixedBytes32Equal(proof.baselineSurfaceCid,
                                 proof.migratedSurfaceCid))
    let semanticEquivalent = CompilerEquivalenceFlag(
        CompilerEquivalenceSemanticReceiptsEquivalent(
            baselineSemantic,
            migratedSemantic))
    if proof.graphEquivalent != graphEquivalent ||
       proof.exportSurfaceCompatible != surfaceCompatible ||
       proof.semanticEquivalent != semanticEquivalent ||
       proof.equivalenceLabel != CompilerEquivalenceKind(
            graphEquivalent != 0,
            surfaceCompatible != 0,
            semanticEquivalent != 0):
        return false
    return layout.FixedBytes32Equal(proof.proofCid,
                                    CompilerMigrationSemanticProofCid(proof))

@borrows
fn CompilerEquivalenceGraphCidFromText(text: str,
                                         out: var layout.FixedBytes32): Result[bool] =
    let cidRes = ccsg.CompilerCsgCanonicalGraphCidFromReportText(text)
    if IsErr(cidRes):
        return Err[bool](Error(cidRes))
    out = Value(cidRes)
    return Ok[bool](true)

@borrows
fn CompilerEquivalenceGraphCompareTexts(baselineCsgText: str,
                                          migratedCsgText: str,
                                          outBaselineCid: var layout.FixedBytes32,
                                          outMigratedCid: var layout.FixedBytes32,
                                          outEquivalent: var int32): Result[bool] =
    let baselineCidRes = CompilerEquivalenceGraphCidFromText(baselineCsgText, outBaselineCid)
    if IsErr(baselineCidRes):
        return Err[bool](Error(baselineCidRes))
    let migratedCidRes = CompilerEquivalenceGraphCidFromText(migratedCsgText, outMigratedCid)
    if IsErr(migratedCidRes):
        return Err[bool](Error(migratedCidRes))
    outEquivalent = CompilerEquivalenceFlag(layout.FixedBytes32Equal(outBaselineCid, outMigratedCid))
    return Ok[bool](true)

@borrows
fn CompilerEquivalenceSurfaceCompareTexts(baselineSurfaceText: str,
                                            migratedSurfaceText: str,
                                            outBaselineCid: var layout.FixedBytes32,
                                            outMigratedCid: var layout.FixedBytes32,
                                            outCompatible: var int32): Result[bool] =
    var baselineSurface: ccsg.CsgExportSurface
    let baselineSurfaceRes = ccsg.CompilerExportSurfaceFromReportText(baselineSurfaceText, baselineSurface)
    if IsErr(baselineSurfaceRes):
        return Err[bool](Error(baselineSurfaceRes))
    var migratedSurface: ccsg.CsgExportSurface
    let migratedSurfaceRes = ccsg.CompilerExportSurfaceFromReportText(migratedSurfaceText, migratedSurface)
    if IsErr(migratedSurfaceRes):
        return Err[bool](Error(migratedSurfaceRes))
    outBaselineCid = baselineSurface.surfaceCid
    outMigratedCid = migratedSurface.surfaceCid
    outCompatible = CompilerEquivalenceFlag(ccsg.CompilerExportSurfaceCompatible(baselineSurface, migratedSurface))
    return Ok[bool](true)

@borrows
fn CompilerMigrationSemanticProofPassed(
        proof: CompilerMigrationSemanticProof): bool =
    if !CompilerMigrationSemanticProofVerify(proof):
        return false
    if proof.graphEquivalent == 0:
        return false
    if proof.exportSurfaceCompatible == 0:
        return false
    if proof.semanticEquivalent == 0:
        return false
    if proof.equivalenceLabel != "canonical_semantic_identity":
        return false
    return true

@borrows
fn CompilerMigrationSemanticProofPassedStable(
        proof: CompilerMigrationSemanticProof,
        evidence: CompilerMigrationEvidence): bool =
    if !CompilerMigrationEvidenceVerify(evidence) ||
       proof.packageId != evidence.packageId ||
       !layout.FixedBytes32Equal(proof.migrationEvidenceCid, evidence.evidenceCid) ||
       !layout.FixedBytes32Equal(
            proof.legacySourceIdentityReceiptCid,
            evidence.legacySourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            proof.migratedSourceIdentityReceiptCid,
            evidence.migratedSourceIdentityReceipt.receiptCid) ||
       !CompilerMigrationSemanticProofVerify(proof):
        return false
    return CompilerMigrationSemanticProofPassed(proof)

@borrows
fn CompilerMigrationEvidenceReport(evidence: CompilerMigrationEvidence): str =
    var out = ""
    out = strutil.Join([out, "package_id=", share(evidence.packageId), "\n"], "")
    out = strutil.Join([out, "entry_module_path=", share(evidence.entryModulePath), "\n"], "")
    out = strutil.Join([out, "unit_count=", IntToStr(evidence.unitCount), "\n"], "")
    for i in 0..<evidence.orderedModulePaths.len:
        out = strutil.Join([out, "unit[", IntToStr(i), "].module_path=",
                            share(evidence.orderedModulePaths[i]), "\n"], "")
        out = strutil.Join([out, "unit[", IntToStr(i), "].legacy_raw_byte_length=",
                            IntToStr(evidence.legacyRawByteLengths[i]), "\n"], "")
        out = strutil.Join([out, "unit[", IntToStr(i), "].legacy_raw_cid=",
                            layout.FixedBytes32Hex(evidence.legacyRawCids[i]), "\n"], "")
        out = strutil.Join([out, "unit[", IntToStr(i), "].migrated_raw_byte_length=",
                            IntToStr(evidence.migratedRawByteLengths[i]), "\n"], "")
        out = strutil.Join([out, "unit[", IntToStr(i), "].migrated_raw_cid=",
                            layout.FixedBytes32Hex(evidence.migratedRawCids[i]), "\n"], "")
    out = strutil.Join([out, "rule_id_count=", IntToStr(evidence.ruleIds.len), "\n"], "")
    for i in 0..<evidence.ruleIds.len:
        out = strutil.Join([out, "rule_id[", IntToStr(i), "]=",
                            share(evidence.ruleIds[i]), "\n"], "")
    out = strutil.Join([out, "legacy_source_bundle_cid=",
                        layout.FixedBytes32Hex(evidence.legacySourceBundleCid), "\n"], "")
    out = strutil.Join([out, "migrated_source_bundle_cid=",
                        layout.FixedBytes32Hex(evidence.migratedSourceBundleCid), "\n"], "")
    let receiptPrefixes = ["legacy_source_receipt", "migrated_source_receipt"]
    let receipts = [evidence.legacySourceIdentityReceipt,
                    evidence.migratedSourceIdentityReceipt]
    for receiptIndex in 0..<receipts.len:
        let prefix = receiptPrefixes[receiptIndex]
        let receipt = receipts[receiptIndex]
        out = strutil.Join([out, share(prefix), ".source_snapshot_count=", IntToStr(receipt.sourceSnapshotCount), "\n"], "")
        out = strutil.Join([out, share(prefix), ".import_edge_count=", IntToStr(receipt.importEdgeCount), "\n"], "")
        out = strutil.Join([out, share(prefix), ".unresolved_import_count=", IntToStr(receipt.unresolvedImportCount), "\n"], "")
        out = strutil.Join([out, share(prefix), ".source_package_id_cid=", layout.FixedBytes32Hex(receipt.sourcePackageIdCid), "\n"], "")
        out = strutil.Join([out, share(prefix), ".entry_module_path_cid=", layout.FixedBytes32Hex(receipt.entryModulePathCid), "\n"], "")
        out = strutil.Join([out, share(prefix), ".source_bundle_cid=", layout.FixedBytes32Hex(receipt.sourceBundleCid), "\n"], "")
        out = strutil.Join([out, share(prefix), ".entry_source_cid=", layout.FixedBytes32Hex(receipt.entrySourceCid), "\n"], "")
        out = strutil.Join([out, share(prefix), ".import_graph_cid=", layout.FixedBytes32Hex(receipt.importGraphCid), "\n"], "")
        out = strutil.Join([out, share(prefix), ".receipt_cid=", layout.FixedBytes32Hex(receipt.receiptCid), "\n"], "")
    out = strutil.Join([out, "evidence_cid=",
                        layout.FixedBytes32Hex(evidence.evidenceCid)], "")
    return out

@borrows
fn CompilerMigrationSemanticProofReport(proof: CompilerMigrationSemanticProof): str =
    var out = ""
    out = strutil.Join([out, "proof_kind=", share(proof.proofKind), "\n"], "")
    out = strutil.Join([out, "package_id=", share(proof.packageId), "\n"], "")
    out = strutil.Join([out, "channel=", share(proof.channel), "\n"], "")
    out = strutil.Join([out, "migration_evidence_cid=", layout.FixedBytes32Hex(proof.migrationEvidenceCid), "\n"], "")
    out = strutil.Join([out, "legacy_source_identity_receipt_cid=", layout.FixedBytes32Hex(proof.legacySourceIdentityReceiptCid), "\n"], "")
    out = strutil.Join([out, "migrated_source_identity_receipt_cid=", layout.FixedBytes32Hex(proof.migratedSourceIdentityReceiptCid), "\n"], "")
    out = strutil.Join([out, ccsg.CompilerCsgEgraphActiveContractReport(), "\n"], "")
    out = strutil.Join([out, "baseline_graph_cid=", layout.FixedBytes32Hex(proof.baselineGraphCid), "\n"], "")
    out = strutil.Join([out, "migrated_graph_cid=", layout.FixedBytes32Hex(proof.migratedGraphCid), "\n"], "")
    out = strutil.Join([out, "baseline_surface_cid=", layout.FixedBytes32Hex(proof.baselineSurfaceCid), "\n"], "")
    out = strutil.Join([out, "migrated_surface_cid=", layout.FixedBytes32Hex(proof.migratedSurfaceCid), "\n"], "")
    out = strutil.Join([out, "baseline_semantic_receipt_cid=", layout.FixedBytes32Hex(proof.baselineSemanticReceiptCid), "\n"], "")
    out = strutil.Join([out, "migrated_semantic_receipt_cid=", layout.FixedBytes32Hex(proof.migratedSemanticReceiptCid), "\n"], "")
    out = strutil.Join([out, "baseline_semantic_source_identity_receipt_cid=", layout.FixedBytes32Hex(proof.baselineSemanticSourceIdentityReceiptCid), "\n"], "")
    out = strutil.Join([out, "migrated_semantic_source_identity_receipt_cid=", layout.FixedBytes32Hex(proof.migratedSemanticSourceIdentityReceiptCid), "\n"], "")
    out = strutil.Join([out, "baseline_semantic_compiler_csg_cid=", layout.FixedBytes32Hex(proof.baselineSemanticCompilerCsgCid), "\n"], "")
    out = strutil.Join([out, "migrated_semantic_compiler_csg_cid=", layout.FixedBytes32Hex(proof.migratedSemanticCompilerCsgCid), "\n"], "")
    out = strutil.Join([out, "baseline_semantic_output_digest=", layout.FixedBytes32Hex(proof.baselineSemanticOutputDigest), "\n"], "")
    out = strutil.Join([out, "migrated_semantic_output_digest=", layout.FixedBytes32Hex(proof.migratedSemanticOutputDigest), "\n"], "")
    out = strutil.Join([out, "baseline_semantic_target_triple_cid=", layout.FixedBytes32Hex(proof.baselineSemanticTargetTripleCid), "\n"], "")
    out = strutil.Join([out, "migrated_semantic_target_triple_cid=", layout.FixedBytes32Hex(proof.migratedSemanticTargetTripleCid), "\n"], "")
    out = strutil.Join([out, "baseline_semantic_bootstrap_stage_cid=", layout.FixedBytes32Hex(proof.baselineSemanticBootstrapStageCid), "\n"], "")
    out = strutil.Join([out, "migrated_semantic_bootstrap_stage_cid=", layout.FixedBytes32Hex(proof.migratedSemanticBootstrapStageCid), "\n"], "")
    out = strutil.Join([out, "baseline_semantic_provider_set_cid=", layout.FixedBytes32Hex(proof.baselineSemanticProviderSetCid), "\n"], "")
    out = strutil.Join([out, "migrated_semantic_provider_set_cid=", layout.FixedBytes32Hex(proof.migratedSemanticProviderSetCid), "\n"], "")
    out = strutil.Join([out, "target=", share(proof.targetTriple), "\n"], "")
    out = strutil.Join([out, "graph_equivalent=", IntToStr(proof.graphEquivalent), "\n"], "")
    out = strutil.Join([out, "export_surface_compatible=", IntToStr(proof.exportSurfaceCompatible), "\n"], "")
    out = strutil.Join([out, "semantic_equivalent=", IntToStr(proof.semanticEquivalent), "\n"], "")
    out = strutil.Join([out, "equivalence_kind=", share(proof.equivalenceLabel), "\n"], "")
    out = strutil.Join([out, "proof_cid=", layout.FixedBytes32Hex(proof.proofCid)], "")
    return out

@borrows
fn CompilerEquivalenceReportCid(text: str,
                                key: str,
                                out: var layout.FixedBytes32): bool =
    let parsed = layout.FixedBytes32FromHex(
        CompilerEquivalenceReportValue(share(text), share(key)))
    if IsErr(parsed):
        return false
    out = Value(parsed)
    return true

@borrows
fn CompilerMigrationEvidenceReceiptFromReportText(
        text: str,
        prefix: str,
        out: var ccsg.PortableSourceIdentityReceipt): bool =
    var sourceSnapshotCount: int32
    var importEdgeCount: int32
    var unresolvedImportCount: int32
    if !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text,
                strutil.Join([share(prefix), ".source_snapshot_count"], "")),
            sourceSnapshotCount) ||
       !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text,
                strutil.Join([share(prefix), ".import_edge_count"], "")),
            importEdgeCount) ||
       !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text,
                strutil.Join([share(prefix), ".unresolved_import_count"], "")),
            unresolvedImportCount):
        return false
    var sourcePackageIdCid: layout.FixedBytes32
    var entryModulePathCid: layout.FixedBytes32
    var sourceBundleCid: layout.FixedBytes32
    var entrySourceCid: layout.FixedBytes32
    var importGraphCid: layout.FixedBytes32
    var receiptCid: layout.FixedBytes32
    if !CompilerEquivalenceReportCid(text,
            strutil.Join([share(prefix), ".source_package_id_cid"], ""),
            sourcePackageIdCid) ||
       !CompilerEquivalenceReportCid(text,
            strutil.Join([share(prefix), ".entry_module_path_cid"], ""),
            entryModulePathCid) ||
       !CompilerEquivalenceReportCid(text,
            strutil.Join([share(prefix), ".source_bundle_cid"], ""),
            sourceBundleCid) ||
       !CompilerEquivalenceReportCid(text,
            strutil.Join([share(prefix), ".entry_source_cid"], ""),
            entrySourceCid) ||
       !CompilerEquivalenceReportCid(text,
            strutil.Join([share(prefix), ".import_graph_cid"], ""),
            importGraphCid) ||
       !CompilerEquivalenceReportCid(text,
            strutil.Join([share(prefix), ".receipt_cid"], ""),
            receiptCid):
        return false
    out.sourceSnapshotCount = sourceSnapshotCount
    out.importEdgeCount = importEdgeCount
    out.unresolvedImportCount = unresolvedImportCount
    out.sourcePackageIdCid = sourcePackageIdCid
    out.entryModulePathCid = entryModulePathCid
    out.sourceBundleCid = sourceBundleCid
    out.entrySourceCid = entrySourceCid
    out.importGraphCid = importGraphCid
    out.receiptCid = receiptCid
    var err: str
    return ccsg.PortableSourceIdentityReceiptStrictValidateInto(out, err)

@borrows
fn CompilerMigrationEvidenceFromReportText(
        text: str,
        out: var CompilerMigrationEvidence): Result[bool] =
    let packageId = CompilerEquivalenceReportValue(text, "package_id")
    let entryModulePath = CompilerEquivalenceReportValue(text,
                                                         "entry_module_path")
    var unitCount: int32
    if !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text, "unit_count"),
            unitCount) || unitCount <= 0:
        return Err[bool](" compiler equivalence: invalid evidence unit_count")
    var orderedModulePaths: str[]
    var legacyRawByteLengths: int32[]
    var legacyRawCids: layout.FixedBytes32[]
    var migratedRawByteLengths: int32[]
    var migratedRawCids: layout.FixedBytes32[]
    for i in 0..<unitCount:
        let prefix = strutil.Join(["unit[", IntToStr(i), "]."], "")
        let modulePath = CompilerEquivalenceReportValue(
            text,
            strutil.Join([share(prefix), "module_path"], ""))
        var legacyLength: int32
        if !CompilerEquivalenceParseInt32Exact(
                CompilerEquivalenceReportValue(
                    text,
                    strutil.Join([share(prefix), "legacy_raw_byte_length"], "")),
                legacyLength):
            return Err[bool](" compiler equivalence: invalid legacy raw length")
        var legacyCid: layout.FixedBytes32
        if !CompilerEquivalenceReportCid(
                text,
                strutil.Join([share(prefix), "legacy_raw_cid"], ""),
                legacyCid):
            return Err[bool](" compiler equivalence: invalid legacy raw cid")
        var migratedLength: int32
        if !CompilerEquivalenceParseInt32Exact(
                CompilerEquivalenceReportValue(
                    text,
                    strutil.Join([share(prefix), "migrated_raw_byte_length"], "")),
                migratedLength):
            return Err[bool](" compiler equivalence: invalid migrated raw length")
        var migratedCid: layout.FixedBytes32
        if !CompilerEquivalenceReportCid(
                text,
                strutil.Join([share(prefix), "migrated_raw_cid"], ""),
                migratedCid):
            return Err[bool](" compiler equivalence: invalid migrated raw cid")
        add(orderedModulePaths, modulePath)
        add(legacyRawByteLengths, legacyLength)
        add(legacyRawCids, legacyCid)
        add(migratedRawByteLengths, migratedLength)
        add(migratedRawCids, migratedCid)
    var ruleCount: int32
    if !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text, "rule_id_count"),
            ruleCount) || ruleCount < 0:
        return Err[bool](" compiler equivalence: invalid evidence rule count")
    var ruleIds: str[]
    for i in 0..<ruleCount:
        add(ruleIds, CompilerEquivalenceReportValue(
            text,
            strutil.Join(["rule_id[", IntToStr(i), "]"], "")))
    var legacySourceBundleCid: layout.FixedBytes32
    var migratedSourceBundleCid: layout.FixedBytes32
    var legacySourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
    var migratedSourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
    var evidenceCid: layout.FixedBytes32
    if !CompilerEquivalenceReportCid(text,
                                     "legacy_source_bundle_cid",
                                     legacySourceBundleCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_source_bundle_cid",
                                     migratedSourceBundleCid) ||
       !CompilerMigrationEvidenceReceiptFromReportText(
            text,
            "legacy_source_receipt",
            legacySourceIdentityReceipt) ||
       !CompilerMigrationEvidenceReceiptFromReportText(
            text,
            "migrated_source_receipt",
            migratedSourceIdentityReceipt) ||
       !CompilerEquivalenceReportCid(text, "evidence_cid", evidenceCid):
        return Err[bool](" compiler equivalence: invalid evidence cid field")
    var next: CompilerMigrationEvidence
    next.packageId = packageId
    next.entryModulePath = entryModulePath
    next.unitCount = unitCount
    next.orderedModulePaths = orderedModulePaths
    next.legacyRawByteLengths = legacyRawByteLengths
    next.legacyRawCids = legacyRawCids
    next.migratedRawByteLengths = migratedRawByteLengths
    next.migratedRawCids = migratedRawCids
    next.ruleIds = ruleIds
    next.legacySourceBundleCid = legacySourceBundleCid
    next.migratedSourceBundleCid = migratedSourceBundleCid
    next.legacySourceIdentityReceipt = legacySourceIdentityReceipt
    next.migratedSourceIdentityReceipt = migratedSourceIdentityReceipt
    next.evidenceCid = evidenceCid
    if !CompilerMigrationEvidenceVerify(next):
        return Err[bool](" compiler equivalence: evidence verification failed")
    if text != CompilerMigrationEvidenceReport(next):
        return Err[bool](" compiler equivalence: evidence report is not canonical")
    out = next
    return Ok[bool](true)

@borrows
fn CompilerMigrationSemanticProofFromReportText(
        text: str,
        out: var CompilerMigrationSemanticProof): Result[bool] =
    if CompilerEquivalenceReportValue(text, "proof_kind") !=
           "migration_semantic":
        return Err[bool](" compiler equivalence: migration semantic proof required")
    var graphEquivalent: int32
    var exportSurfaceCompatible: int32
    var semanticEquivalent: int32
    if !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text, "graph_equivalent"),
            graphEquivalent) ||
       !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text,
                                           "export_surface_compatible"),
            exportSurfaceCompatible) ||
       !CompilerEquivalenceParseInt32Exact(
            CompilerEquivalenceReportValue(text,
                                           "semantic_equivalent"),
            semanticEquivalent):
        return Err[bool](" compiler equivalence: invalid proof numeric field")
    var migrationEvidenceCid: layout.FixedBytes32
    var legacySourceIdentityReceiptCid: layout.FixedBytes32
    var migratedSourceIdentityReceiptCid: layout.FixedBytes32
    var baselineGraphCid: layout.FixedBytes32
    var migratedGraphCid: layout.FixedBytes32
    var baselineSurfaceCid: layout.FixedBytes32
    var migratedSurfaceCid: layout.FixedBytes32
    var baselineSemanticReceiptCid: layout.FixedBytes32
    var migratedSemanticReceiptCid: layout.FixedBytes32
    var baselineSemanticSourceIdentityReceiptCid: layout.FixedBytes32
    var migratedSemanticSourceIdentityReceiptCid: layout.FixedBytes32
    var baselineSemanticCompilerCsgCid: layout.FixedBytes32
    var migratedSemanticCompilerCsgCid: layout.FixedBytes32
    var baselineSemanticOutputDigest: layout.FixedBytes32
    var migratedSemanticOutputDigest: layout.FixedBytes32
    var baselineSemanticTargetTripleCid: layout.FixedBytes32
    var migratedSemanticTargetTripleCid: layout.FixedBytes32
    var baselineSemanticBootstrapStageCid: layout.FixedBytes32
    var migratedSemanticBootstrapStageCid: layout.FixedBytes32
    var baselineSemanticProviderSetCid: layout.FixedBytes32
    var migratedSemanticProviderSetCid: layout.FixedBytes32
    var proofCid: layout.FixedBytes32
    if !CompilerEquivalenceReportCid(text,
                                     "migration_evidence_cid",
                                     migrationEvidenceCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "legacy_source_identity_receipt_cid",
                                     legacySourceIdentityReceiptCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_source_identity_receipt_cid",
                                     migratedSourceIdentityReceiptCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_graph_cid",
                                     baselineGraphCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_graph_cid",
                                     migratedGraphCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_surface_cid",
                                     baselineSurfaceCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_surface_cid",
                                     migratedSurfaceCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_semantic_receipt_cid",
                                     baselineSemanticReceiptCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_semantic_receipt_cid",
                                     migratedSemanticReceiptCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_semantic_source_identity_receipt_cid",
                                     baselineSemanticSourceIdentityReceiptCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_semantic_source_identity_receipt_cid",
                                     migratedSemanticSourceIdentityReceiptCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_semantic_compiler_csg_cid",
                                     baselineSemanticCompilerCsgCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_semantic_compiler_csg_cid",
                                     migratedSemanticCompilerCsgCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_semantic_output_digest",
                                     baselineSemanticOutputDigest) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_semantic_output_digest",
                                     migratedSemanticOutputDigest) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_semantic_target_triple_cid",
                                     baselineSemanticTargetTripleCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_semantic_target_triple_cid",
                                     migratedSemanticTargetTripleCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_semantic_bootstrap_stage_cid",
                                     baselineSemanticBootstrapStageCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_semantic_bootstrap_stage_cid",
                                     migratedSemanticBootstrapStageCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "baseline_semantic_provider_set_cid",
                                     baselineSemanticProviderSetCid) ||
       !CompilerEquivalenceReportCid(text,
                                     "migrated_semantic_provider_set_cid",
                                     migratedSemanticProviderSetCid) ||
       !CompilerEquivalenceReportCid(text, "proof_cid", proofCid):
        return Err[bool](" compiler equivalence: invalid proof cid field")
    var next: CompilerMigrationSemanticProof
    next.proofKind = "migration_semantic"
    next.packageId = CompilerEquivalenceReportValue(text, "package_id")
    next.channel = CompilerEquivalenceReportValue(text, "channel")
    next.migrationEvidenceCid = migrationEvidenceCid
    next.legacySourceIdentityReceiptCid = legacySourceIdentityReceiptCid
    next.migratedSourceIdentityReceiptCid = migratedSourceIdentityReceiptCid
    next.baselineGraphCid = baselineGraphCid
    next.migratedGraphCid = migratedGraphCid
    next.baselineSurfaceCid = baselineSurfaceCid
    next.migratedSurfaceCid = migratedSurfaceCid
    next.baselineSemanticReceiptCid = baselineSemanticReceiptCid
    next.migratedSemanticReceiptCid = migratedSemanticReceiptCid
    next.baselineSemanticSourceIdentityReceiptCid =
        baselineSemanticSourceIdentityReceiptCid
    next.migratedSemanticSourceIdentityReceiptCid =
        migratedSemanticSourceIdentityReceiptCid
    next.baselineSemanticCompilerCsgCid = baselineSemanticCompilerCsgCid
    next.migratedSemanticCompilerCsgCid = migratedSemanticCompilerCsgCid
    next.baselineSemanticOutputDigest = baselineSemanticOutputDigest
    next.migratedSemanticOutputDigest = migratedSemanticOutputDigest
    next.baselineSemanticTargetTripleCid = baselineSemanticTargetTripleCid
    next.migratedSemanticTargetTripleCid = migratedSemanticTargetTripleCid
    next.baselineSemanticBootstrapStageCid =
        baselineSemanticBootstrapStageCid
    next.migratedSemanticBootstrapStageCid =
        migratedSemanticBootstrapStageCid
    next.baselineSemanticProviderSetCid = baselineSemanticProviderSetCid
    next.migratedSemanticProviderSetCid = migratedSemanticProviderSetCid
    next.targetTriple = CompilerEquivalenceReportValue(text, "target")
    next.graphEquivalent = graphEquivalent
    next.exportSurfaceCompatible = exportSurfaceCompatible
    next.semanticEquivalent = semanticEquivalent
    next.equivalenceLabel = CompilerEquivalenceReportValue(text,
                                                           "equivalence_kind")
    next.proofCid = proofCid
    if !CompilerMigrationSemanticProofVerify(next):
        return Err[bool](" compiler equivalence: proof verification failed")
    if text != CompilerMigrationSemanticProofReport(next):
        return Err[bool](" compiler equivalence: proof report is not canonical")
    out = next
    return Ok[bool](true)
