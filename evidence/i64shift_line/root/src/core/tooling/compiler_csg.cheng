    total = total + Int64(arenamod.ArenaArrayInt32Len(
        ir.arena, ir.nodes2_funcRefCallDeclarationRows) * 4)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.nodes2_fieldTypeSourcePathIds)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_fieldOffsetBytes) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_fieldSizeBytes) * 4)
