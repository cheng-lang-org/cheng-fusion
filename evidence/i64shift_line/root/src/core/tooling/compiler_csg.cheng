        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.statementRootEndLines, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.statementRootEndColumns,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.normalizedExprProducerSourceIds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.normalizedExprSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.normalizedExprFunctionIndexes,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.normalizedExprParserNodeIds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.normalizedExprKinds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.normalizedExprStatementRoles,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionIndexes, retainedCapacity)
        total = total + Int64(CompilerCsgSequenceSlots(
                                  sidecar.functionNames.len,
                                  sidecar.functionNames.cap,
                                  retainedCapacity)) * CompilerCsgStrHeaderBytes()
        for functionIndex in 0..<sidecar.functionNames.len:
            total = total + Int64(sidecar.functionNames[functionIndex].len)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionSignatureLineNumbers,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionDeclarationSpanIds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionDeclarationHeaderSpanIds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionDeclarationOrdinals,
                            retainedCapacity)
        total = total + CompilerCsgFixed32ArrayBytesMode(
                            sidecar.functionDeclarationHeaderCids,
                            retainedCapacity)
        total = total + CompilerCsgFixed32ArrayBytesMode(
                            sidecar.functionDeclarationPathCids,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionNameSpanIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionNameSurfaceKinds,
                            retainedCapacity)
        total = total + Int64(CompilerCsgSequenceSlots(
                                  sidecar.functionNameProofCids.len,
                                  sidecar.functionNameProofCids.cap,
                                  retainedCapacity)) *
                        CompilerCsgFixed32Bytes()
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionBodySpanIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionAnnotationFlags,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionManualConsumeTargetParameterOrdinals,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionManualConsumeTargetParameterDeclarationSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionManualConsumeSourceParameterOrdinals,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.functionManualConsumeSourceParameterDeclarationSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleContractProducerSourceIds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleContractAnnotationSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleContractResultEffects,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleContractParameterStarts,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleContractParameterCounts,
                            retainedCapacity)
        total = total + CompilerCsgFixed32ArrayBytesMode(
                            sidecar.ffiHandleParserContractCids,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleParameterOrdinals,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleParameterDeclarationSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.ffiHandleParameterEffects,
                            retainedCapacity)
        if sidecar.importOrigins != nil:
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importDeclarationProducerSourceIds,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importDeclarationSourceLocalRows,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importDeclarationKeywordTokenIds,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importDeclarationSpanIds,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importDeclarationItemStarts,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importDeclarationItemCounts,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemProducerSourceIds,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemSourceLocalRows,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemDeclarationIds,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemAliasTokenIds,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemSpanIds,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemModuleTokenStarts,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemModuleTokenCounts,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importItemPrefixTokenCounts,
                                retainedCapacity)
            total = total + CompilerCsgIntArrayBytesMode(
                                sidecar.importOrigins.importModuleTokenIds,
                                retainedCapacity)
    return total

fn CompilerCsgTypeDiagnosticScalarLogicalBytes(
        csg: var CompilerCsg): int64 =
    return Int64(
               sizeof(CompilerCsgTypeDiagnosticCompletionTable)) +
           Int64(sizeof(stage_receipt.CompilerStageReceipt)) +
           Int64(csg.typeDiagnosticStageReceipt.stageKind.len) +
           Int64(csg.typeDiagnosticStageReceipt.laneKind.len) +
           Int64(csg.typeDiagnosticStageReceipt.producerIdentity.len)

@borrows
fn compilerCsgDiagnosticRowDynamicBytes(
        table: CompilerCsgTypeDiagnosticCompletionTable,
        retainedCapacity: bool): int64 =
    var total = CompilerCsgIntArrayBytesMode(
        table.diagnosticSourceIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.diagnosticAnchorKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.diagnosticAnchorNodeIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.diagnosticOwnerDeclarationSourceLocalRows,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.diagnosticSpanIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.diagnosticSeverities, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(
        table.diagnosticCodeTexts, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(
        table.diagnosticMessageTexts, retainedCapacity)
    total = total + Int64(CompilerCsgSequenceSlots(
                              table.diagnosticProofCids.len,
                              table.diagnosticProofCids.cap,
                              retainedCapacity)) *
                    CompilerCsgFixed32Bytes()
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutSourceIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutProducerRowIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutDeclarationSourceLocalRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutBuiltinKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutTypeArenaIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutSizeBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutAlignBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldCounts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutSourceRowStarts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutSourceRowCounts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutSourceRowIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldSourceIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldProducerRowIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldOwnerDeclarationSourceLocalRows,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldDeclarationSourceLocalRows,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldBuiltinKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldMemberRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldOwnerTypeArenaIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldOrdinals, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldTypeArenaIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldOffsetBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldSizeBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldAlignBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldSourceRowStarts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldSourceRowCounts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.exactLayoutFieldSourceRowIndexes, retainedCapacity)
    return total

fn CompilerCsgTypeDiagnosticDynamicSequenceBytes(
        csg: var CompilerCsg,
        retainedCapacity: bool): int64 =
    let table = csg.typeDiagnosticCompletions
    let receipt = csg.typeDiagnosticStageReceipt
    var total = CompilerCsgIntArrayBytesMode(
        table.sourceIds, retainedCapacity)
    total = total + Int64(CompilerCsgSequenceSlots(
                              table.sourceIdentityCids.len,
                              table.sourceIdentityCids.cap,
                              retainedCapacity)) *
                    CompilerCsgFixed32Bytes()
    total = total + Int64(CompilerCsgSequenceSlots(
                              table.inputArtifactCids.len,
                              table.inputArtifactCids.cap,
                              retainedCapacity)) *
                    CompilerCsgFixed32Bytes()
    total = total + Int64(CompilerCsgSequenceSlots(
                              table.outputArtifactCids.len,
                              table.outputArtifactCids.cap,
                              retainedCapacity)) *
                    CompilerCsgFixed32Bytes()
    total = total + CompilerCsgIntArrayBytesMode(
                        table.rowStarts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
                        table.rowCounts, retainedCapacity)
    total = total + Int64(CompilerCsgSequenceSlots(
                              table.completionReceiptCids.len,
                              table.completionReceiptCids.cap,
                              retainedCapacity)) *
                    CompilerCsgFixed32Bytes()
    total = total + Int64(CompilerCsgSequenceSlots(
                              receipt.countKeys.len,
                              receipt.countKeys.cap,
                              retainedCapacity)) *
                    CompilerCsgStrHeaderBytes()
    total = total + Int64(CompilerCsgSequenceSlots(
                              receipt.countValues.len,
                              receipt.countValues.cap,
                              retainedCapacity)) * Int64(8)
    for row in 0..<receipt.countKeys.len:
        total = total + Int64(receipt.countKeys[row].len)
    total = total + compilerCsgDiagnosticRowDynamicBytes(
                        table, retainedCapacity)
    return total

