fn compilerCsgDiagnosticAuthorityProjectionBytes(
        csg: var CompilerCsg,
        retainedCapacity: bool): int64 =
    let slots = retainedCapacity ?
        csg.diagnosticFailureProducerProjectionCids.cap :
        csg.diagnosticFailureProducerProjectionCids.len
    return Int64(slots) * CompilerCsgFixed32Bytes()

@borrows
fn compilerCsgFnPtrFieldCallDynamicSequenceBytes(
        table: CompilerCsgFnPtrFieldCallTable,
        retainedCapacity: bool): int64 =
    var total = CompilerCsgIntArrayBytesMode(
        table.callNodeIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.fieldNodeIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.fieldTypeIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.fieldStructuralKinds, retainedCapacity)
    total = total +
        Int64(CompilerCsgSequenceSlots(
            table.functionInterfaceCids.len,
            table.functionInterfaceCids.cap,
            retainedCapacity)) *
        CompilerCsgFixed32Bytes()
    return total

@borrows
fn compilerCsgExternFfiHandleDynamicSequenceBytes(
        table: CompilerCsgExternFfiHandleContractTable,
        retainedCapacity: bool): int64 =
    var total = CompilerCsgIntArrayBytesMode(
