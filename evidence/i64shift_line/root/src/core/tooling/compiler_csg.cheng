        freeSeq(sidecar.patternChildStarts)
        freeSeq(sidecar.patternChildCounts)
        freeSeq(sidecar.patternChildIds)
        freeSeq(sidecar.annotationProducerSourceIds)
        freeSeq(sidecar.annotationSourceLocalRows)
        freeSeq(sidecar.annotationNameTokenIds)
        freeSeq(sidecar.annotationTargetTokenIds)
        freeSeq(sidecar.annotationSpanIds)
        freeSeq(sidecar.annotationArgRootStarts)
        freeSeq(sidecar.annotationArgRootCounts)
        freeSeq(sidecar.annotationArgRootIds)
        freeSeq(sidecar.annotationArgProducerSourceIds)
        freeSeq(sidecar.annotationArgSourceLocalRows)
        freeSeq(sidecar.annotationArgOwnerIds)
        freeSeq(sidecar.annotationArgKinds)
        freeSeq(sidecar.annotationArgTokenIds)
        freeSeq(sidecar.annotationArgSeparatorTokenIds)
        freeSeq(sidecar.annotationArgSpanIds)
        freeSeq(sidecar.annotationArgChildStarts)
        freeSeq(sidecar.annotationArgChildCounts)
        freeSeq(sidecar.annotationArgChildIds)
        freeSeq(sidecar.rootNodeIds)
        freeSeq(sidecar.callEventNodeIds)
        freeSeq(sidecar.statementRootNodeIds)
        freeSeq(sidecar.statementRootRoles)
        freeSeq(sidecar.statementRootAnchorTokenIds)
        freeSeq(sidecar.statementRootBindingDeclarationStarts)
        freeSeq(sidecar.statementRootBindingDeclarationCounts)
        freeSeq(sidecar.statementRootAnchorLines)
        freeSeq(sidecar.statementRootAnchorColumns)
        freeSeq(sidecar.statementRootEndLines)
        freeSeq(sidecar.statementRootEndColumns)
        freeSeq(sidecar.normalizedExprProducerSourceIds)
        freeSeq(sidecar.normalizedExprSourceLocalRows)
        freeSeq(sidecar.normalizedExprFunctionIndexes)
        freeSeq(sidecar.normalizedExprParserNodeIds)
        freeSeq(sidecar.normalizedExprKinds)
        freeSeq(sidecar.normalizedExprStatementRoles)
        freeSeq(sidecar.functionIndexes)
        freeSeqStrRelease(sidecar.functionNames)
        freeSeq(sidecar.functionSignatureLineNumbers)
        freeSeq(sidecar.functionDeclarationSpanIds)
        freeSeq(sidecar.functionDeclarationHeaderSpanIds)
        freeSeq(sidecar.functionDeclarationOrdinals)
        freeSeq(sidecar.functionDeclarationHeaderCids)
        freeSeq(sidecar.functionDeclarationPathCids)
        freeSeq(sidecar.functionNameSpanIds)
        freeSeq(sidecar.functionNameSurfaceKinds)
        freeSeq(sidecar.functionNameProofCids)
        freeSeq(sidecar.functionBodySpanIds)
        freeSeq(sidecar.functionAnnotationFlags)
        freeSeq(sidecar.functionManualConsumeTargetParameterOrdinals)
        freeSeq(
            sidecar.functionManualConsumeTargetParameterDeclarationSourceLocalRows)
        freeSeq(sidecar.functionManualConsumeSourceParameterOrdinals)
        freeSeq(
            sidecar.functionManualConsumeSourceParameterDeclarationSourceLocalRows)
        freeSeq(sidecar.ffiHandleContractProducerSourceIds)
        freeSeq(
            sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows)
        freeSeq(sidecar.ffiHandleContractAnnotationSourceLocalRows)
        freeSeq(sidecar.ffiHandleContractResultEffects)
        freeSeq(sidecar.ffiHandleContractParameterStarts)
        freeSeq(sidecar.ffiHandleContractParameterCounts)
        freeSeq(sidecar.ffiHandleParserContractCids)
        freeSeq(sidecar.ffiHandleParameterOrdinals)
        freeSeq(sidecar.ffiHandleParameterDeclarationSourceLocalRows)
        freeSeq(sidecar.ffiHandleParameterEffects)
        if sidecar.importOrigins != nil:
            freeSeq(sidecar.importOrigins.importDeclarationProducerSourceIds)
            freeSeq(sidecar.importOrigins.importDeclarationSourceLocalRows)
            freeSeq(sidecar.importOrigins.importDeclarationKeywordTokenIds)
            freeSeq(sidecar.importOrigins.importDeclarationSpanIds)
            freeSeq(sidecar.importOrigins.importDeclarationItemStarts)
            freeSeq(sidecar.importOrigins.importDeclarationItemCounts)
            freeSeq(sidecar.importOrigins.importItemProducerSourceIds)
            freeSeq(sidecar.importOrigins.importItemSourceLocalRows)
            freeSeq(sidecar.importOrigins.importItemDeclarationIds)
            freeSeq(sidecar.importOrigins.importItemAliasTokenIds)
            freeSeq(sidecar.importOrigins.importItemSpanIds)
            freeSeq(sidecar.importOrigins.importItemModuleTokenStarts)
            freeSeq(sidecar.importOrigins.importItemModuleTokenCounts)
            freeSeq(sidecar.importOrigins.importItemPrefixTokenCounts)
            freeSeq(sidecar.importOrigins.importModuleTokenIds)
            sidecar.importOrigins = nil

fn CompilerCsgParserNormalizedExprReceiptRelease(
        receipt: var parser_receipt.ParserNormalizedExprReceipt) =
    for sourceIndex in 0..<receipt.sourceSidecars.len:
        CompilerCsgParserCanonicalSourceSidecarRelease(
            receipt.sourceSidecars[sourceIndex])
    freeSeq(receipt.sourceSidecars)
    freeSeqStrRelease(receipt.envelope.countKeys)
    freeSeq(receipt.envelope.countValues)
    receipt = parser_receipt.ParserNormalizedExprReceipt()

fn compilerCsgTerminalReleaseImpl(csg: var CompilerCsg) =
    # Terminal destruction has no observable post-release ledger: the owner is
    # cleared immediately below.  Avoid the partial-release helper's ledger
    # refresh, which exists only for callers that keep the CompilerCsg shell.
    CompilerCsgNormalizedExprLayerTerminalRelease(csg.exprLayer)
    var ownedTypeArena: typearena.TypedExprTypeArena
    ownedTypeArena = csg.typeArena
    csg.typeArena = nil
    typearena.TypedExprTypeArenaReleaseOwned(ownedTypeArena)
    CompilerCsgFnPtrFieldCallTableRelease(
        csg.fnPtrFieldCalls)
    CompilerCsgExternFfiHandleContractTableRelease(
        csg.externFfiHandleContracts)
    CompilerCsgExternFfiHandleCallCapabilityTableRelease(
        csg.externFfiHandleCallCapabilities)
    texpr.TypedExprFactTableRelease(csg.typedExprFacts)
    texpr.TypedExprIrReleasePayload(csg.typedIr)
    for nodeIndex in 0..<csg.nodes.len:
        csg.nodes[nodeIndex].modulePath = ""
        csg.nodes[nodeIndex].symbolText = ""
        csg.nodes[nodeIndex].factText = ""
        csg.nodes[nodeIndex].semanticSource = ""
        csg.nodes[nodeIndex].semanticParamTypeJoin = ""
        csg.nodes[nodeIndex].semanticReturnType = ""
        csg.nodes[nodeIndex].exportSymbolName = ""
    freeSeq(csg.nodes)
    freeSeq(csg.edges)
    CompilerCsgSemanticGraphTerminalRelease(csg.semanticGraph)
    CompilerCsgParserNormalizedExprReceiptRelease(
        csg.parserNormalizedExprReceipt)
    var diagnosticFailureReleaseReceipt: diagnostic_failure.DiagnosticFailureArtifactReleaseReceipt
    diagnostic_failure.DiagnosticFailureArtifactReleaseInto(
        csg.diagnosticFailureArtifact,
        diagnosticFailureReleaseReceipt)
    var diagnosticAuthorityReleaseReceipt: diagnostic_authority.ParserDiagnosticAuthorityReleaseReceipt
    diagnostic_authority.ParserDiagnosticAuthorityReleaseInto(
        csg.diagnosticFailureAuthority,
        diagnosticAuthorityReleaseReceipt)
    freeSeq(csg.diagnosticFailureProducerProjectionCids)
    csg = CompilerCsg()

fn CompilerCsgLifecycleRetainedBytes(csg: var CompilerCsg): int64 =
    # Failed producers may leave a valid partial owner set before the normal
    # end-of-build ledger refresh.  Terminal ownership must be derived from
    # current capacities, never from the last successful phase snapshot.
    CompilerCsgRefreshMemoryLedger(csg)
    return csg.arenaRetainedCapacityBytes +
           csg.internRetainedCapacityBytes +
           csg.dynamicSequenceRetainedCapacityBytes +
           csg.buildIndexRetainedCapacityBytes

fn CompilerCsgLifecycleTrackedPhysicalBufferCount(
        csg: var CompilerCsg): int32 =
    var count =
        diagnostic_failure.DiagnosticFailureArtifactPhysicalBufferCount(
            csg.diagnosticFailureArtifact)
    count = count +
        diagnostic_authority.ParserDiagnosticAuthorityPhysicalBufferCount(
            csg.diagnosticFailureAuthority)
    if csg.diagnosticFailureProducerProjectionCids.cap > 0:
        count = count + 1
    if csg.nodes.cap > 0:
        count = count + 1
    if csg.edges.cap > 0:
        count = count + 1
    count = count +
        CompilerCsgNormalizedExprLayerPhysicalBufferCount(
            csg.exprLayer)
    if csg.parserNormalizedExprReceipt.sourceSidecars.cap > 0:
        count = count + 1
    for sourceIndex in 0..<
            csg.parserNormalizedExprReceipt.sourceSidecars.len:
        let sidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[sourceIndex]
        if sidecar.patternOwnerKinds.cap > 0:
            count = count + 1
        if sidecar.patternOwnerRows.cap > 0:
            count = count + 1
        if sidecar.declarationLexicalScopeSpanIds.cap > 0:
            count = count + 1
    if csg.parserNormalizedExprReceipt.envelope.countKeys.cap > 0:
        count = count + 1
    if csg.parserNormalizedExprReceipt.envelope.countValues.cap > 0:
        count = count + 1
    if csg.typeArena != nil &&
       csg.typeArena.arena.capacityBytes > 0:
        count = count + 1
    if csg.typedExprFacts.arena.capacityBytes > 0:
        count = count + 1
    if csg.typedIr.arena.capacityBytes > 0:
        count = count + 1
    if csg.fnPtrFieldCalls.callNodeIndexes.cap > 0:
        count = count + 1
    if csg.fnPtrFieldCalls.fieldNodeIndexes.cap > 0:
        count = count + 1
    if csg.fnPtrFieldCalls.fieldTypeIds.cap > 0:
        count = count + 1
    if csg.fnPtrFieldCalls.fieldStructuralKinds.cap > 0:
        count = count + 1
    if csg.fnPtrFieldCalls.functionInterfaceCids.cap > 0:
        count = count + 1
    count = count + compilerCsgExternFfiHandlePhysicalBufferCount(
        csg.externFfiHandleContracts)
    count = count +
        compilerCsgExternFfiHandleCallCapabilityPhysicalBufferCount(
            csg.externFfiHandleCallCapabilities)
    if csg.semanticGraph.sourceTable.sourcePaths.cap > 0:
        count = count + 1
    if csg.semanticGraph.declTable.sourceIndex.cap > 0:
        count = count + 1
    if csg.semanticGraph.importEdgeTable.ownerSourceIndex.cap > 0:
        count = count + 1
    if csg.semanticGraph.reachableFunctionTable.sourceIndex.cap > 0:
        count = count + 1
    if csg.semanticGraph.exprSliceTable.sourceIndex.cap > 0:
        count = count + 1
    count = count +
        CompilerCsgSemanticTypedFactPhysicalBufferCount(
            csg.semanticGraph.typedFactTable)
    if csg.semanticGraph.resolvedCallTable.sourceIndexes.cap > 0:
        count = count + 1
    if csg.semanticGraph.typedIrTable.functionSourceIndexes.cap > 0:
        count = count + 1
    return count

fn CompilerCsgLifecycleStorageReleased(csg: var CompilerCsg): bool =
    return CompilerCsgLifecycleRetainedBytes(csg) == int64(0) &&
           diagnostic_failure.DiagnosticFailureArtifactReleased(
               csg.diagnosticFailureArtifact) &&
           diagnostic_authority.ParserDiagnosticAuthorityReleased(
               csg.diagnosticFailureAuthority) &&
           csg.diagnosticFailureProducerProjectionCids.cap == 0 &&
           csg.nodes.cap == 0 &&
           csg.edges.cap == 0 &&
           csg.exprLayer.exprs.cap == 0 &&
           csg.exprLayer.exprNext.cap == 0 &&
           csg.exprLayer.scopes.cap == 0 &&
           csg.exprLayer.exprLookup.slots.cap == 0 &&
           csg.exprLayer.exprLookup.buckets.cap == 0 &&
           csg.parserNormalizedExprReceipt.sourceSidecars.cap == 0 &&
           csg.parserNormalizedExprReceipt.envelope.countKeys.cap == 0 &&
           csg.parserNormalizedExprReceipt.envelope.countValues.cap == 0 &&
           csg.typeArena == nil &&
           csg.typedExprFacts.arena.capacityBytes == 0 &&
           csg.typedIr.arena.capacityBytes == 0 &&
           csg.fnPtrFieldCalls.callNodeIndexes.cap == 0 &&
           csg.fnPtrFieldCalls.fieldNodeIndexes.cap == 0 &&
           csg.fnPtrFieldCalls.fieldTypeIds.cap == 0 &&
           csg.fnPtrFieldCalls.fieldStructuralKinds.cap == 0 &&
           csg.fnPtrFieldCalls.functionInterfaceCids.cap == 0 &&
           compilerCsgExternFfiHandlePhysicalBufferCount(
               csg.externFfiHandleContracts) == 0 &&
           !csg.externFfiHandleContracts.complete &&
           layout.FixedBytes32Equal(
               csg.externFfiHandleContracts.cargoCid,
               layout.FixedBytes32()) &&
           compilerCsgExternFfiHandleCallCapabilityPhysicalBufferCount(
               csg.externFfiHandleCallCapabilities) == 0 &&
           !csg.externFfiHandleCallCapabilities.complete &&
           layout.FixedBytes32Equal(
               csg.externFfiHandleCallCapabilities.cargoCid,
               layout.FixedBytes32()) &&
           csg.semanticGraph.sourceTable.sourcePaths.cap == 0 &&
           csg.semanticGraph.declTable.sourceIndex.cap == 0 &&
           csg.semanticGraph.importEdgeTable.ownerSourceIndex.cap == 0 &&
           csg.semanticGraph.reachableFunctionTable.sourceIndex.cap == 0 &&
           csg.semanticGraph.exprSliceTable.sourceIndex.cap == 0 &&
           csg.semanticGraph.typedFactTable.sourceIndexes.cap == 0 &&
           csg.semanticGraph.resolvedCallTable.sourceIndexes.cap == 0 &&
           csg.semanticGraph.typedIrTable.functionSourceIndexes.cap == 0

fn CompilerCsgTerminalReleaseWithReceipt(
        csg: var CompilerCsg,
        releasedBufferCount: var int32,
        releasedBytes: var int64) =
    let beforeBufferCount =
        CompilerCsgLifecycleTrackedPhysicalBufferCount(csg)
    let beforeBytes = CompilerCsgLifecycleRetainedBytes(csg)
    compilerCsgTerminalReleaseImpl(csg)
    let afterBufferCount =
        CompilerCsgLifecycleTrackedPhysicalBufferCount(csg)
    let afterBytes = CompilerCsgLifecycleRetainedBytes(csg)
    if afterBufferCount != 0 || afterBytes != int64(0) ||
       !CompilerCsgLifecycleStorageReleased(csg):
        panic("compiler csg: terminal release receipt incomplete")
    releasedBufferCount = beforeBufferCount
    releasedBytes = beforeBytes

fn CompilerCsgTerminalRelease(csg: var CompilerCsg) =
    var releasedBufferCount: int32
    var releasedBytes: int64
    CompilerCsgTerminalReleaseWithReceipt(
        csg, releasedBufferCount, releasedBytes)

fn CompilerCsgI32Bytes(): int64 =
    return Int64(4)

fn CompilerCsgBoolBytes(): int64 =
    return Int64(4)

fn CompilerCsgStrHeaderBytes(): int64 =
    return Int64(24)

fn CompilerCsgFixed32Bytes(): int64 =
    return Int64(32)

fn CompilerCsgCompactProfileViewLifecycleScalarBytes(): int64 =
    return Int64(10) * Int64(8)

fn CompilerCsgNodeRowBytes(): int64 =
    return Int64(216) +
           Int64(3) * CompilerCsgStrHeaderBytes() +
           Int64(2) * CompilerCsgI32Bytes()

fn CompilerCsgEdgeRowBytes(): int64 =
    return Int64(48)

fn CompilerCsgExprRowBytes(): int64 =
    return Int64(sizeof(parser.NormalizedExpr))

fn CompilerCsgNormalizedScopeFactRowBytes(): int64 =
    return Int64(sizeof(parser.NormalizedScopeFact))

fn CompilerCsgFunctionSourceSliceIndexCapacityBytes(
        index: var fslice.FunctionSourceSliceIndex): int64 =
    let ledger = fslice.FunctionSourceSliceIndexByteLedgerBuild(index)
    return ledger.totalRetainedBytes

fn CompilerCsgExprLookupBucketRowBytes(): int64 =
    return Int64(48)

fn CompilerCsgTypedFactRowBytes(): int64 =
    return Int64(280)

fn CompilerCsgTypedIrNodeRowBytes(): int64 =
    return Int64(184)

fn CompilerCsgTypedIrStatementRowBytes(): int64 =
    return Int64(800)

fn CompilerCsgTypedIrFunctionRowBytes(): int64 =
    return Int64(128)

fn CompilerCsgColdTypeRowBytes(): int64 =
    return Int64(104)

fn CompilerCsgColdStatementRowBytes(): int64 =
    return Int64(104)

fn CompilerCsgSourceTextRowBytes(): int64 =
    return Int64(72)

fn CompilerCsgMetadataContextRowBytes(): int64 =
    return Int64(128)

fn CompilerCsgFunctionScopeRowBytes(): int64 =
    return Int64(88)

fn CompilerCsgBindingRowBytes(): int64 =
    return Int64(136)

fn CompilerCsgImportcFunctionRowBytes(): int64 =
    return Int64(232)

fn CompilerCsgImportedModuleRowBytes(): int64 =
    return Int64(48)

fn CompilerCsgTypeFieldRowBytes(): int64 =
    return Int64(96)

@borrows
fn CompilerCsgStringPayloadBytes(text: str): int64 =
    return Int64(len(text))

fn CompilerCsgCertificateMix(seed: int64,
                             value: int64): int64 =
    return (seed * Int64(1315423911) + value * Int64(2654435761) + Int64(97)) &
           Int64(9223372036854775807)

@borrows
fn CompilerCsgTextContentCertificate(text: str): int64 =
    var out = CompilerCsgCertificateMix(Int64(146959810), Int64(text.len))
    for i in 0..<text.len:
        out = CompilerCsgCertificateMix(out, Int64(text[i]))
    return out

fn CompilerCsgSequenceHeaderBytes(): int64 =
    return Int64(24)

fn CompilerCsgNormalizedFunctionDeclRowBytes(): int64 =
    return Int64(sizeof(parser.NormalizedFunctionDecl))

fn CompilerCsgNormalizedTypeDeclRowBytes(): int64 =
    return Int64(sizeof(parser.NormalizedTypeDecl))

fn CompilerCsgImportEdgeRowBytes(): int64 =
    return Int64(sizeof(parser.ImportEdge))

fn CompilerCsgNormalizedExprCallProfileRowBytes(): int64 =
    return Int64(sizeof(parser.NormalizedExprCallProfile))

fn CompilerCsgParserTextLookupBucketRowBytes(): int64 =
    return Int64(sizeof(parser.ParserTextLookupBucket))

fn CompilerCsgParserSourcePathIndexBucketRowBytes(): int64 =
    return Int64(sizeof(parser.ParserSourcePathIndexBucket))

fn CompilerCsgParserSourcePathIndexEntryRowBytes(): int64 =
    return Int64(sizeof(parser.ParserSourcePathIndexEntry))

fn CompilerCsgProfileCallLookupEntryRowBytes(): int64 =
    return Int64(sizeof(parser.ParserProfileCallLookupCacheEntry))

fn CompilerCsgNormalizedFunctionDeclSequenceBackingCapacityBytes(
        items: var parser.NormalizedFunctionDecl[]): int64 =
    return Int64(items.cap) * CompilerCsgNormalizedFunctionDeclRowBytes()

fn CompilerCsgNormalizedTypeDeclSequenceBackingCapacityBytes(
        items: var parser.NormalizedTypeDecl[]): int64 =
    return Int64(items.cap) * CompilerCsgNormalizedTypeDeclRowBytes()

fn CompilerCsgBorrowedStringSequenceBackingCapacityBytes(items: var str[]): int64 =
    return Int64(items.cap) * CompilerCsgStrHeaderBytes()

fn CompilerCsgImportEdgeSequenceBackingCapacityBytes(
        items: var parser.ImportEdge[]): int64 =
    return Int64(items.cap) * CompilerCsgImportEdgeRowBytes()

@borrows
fn CompilerCsgStringArrayLiveBytes(items: str[]): int64 =
    var total: int64 = Int64(items.len) * CompilerCsgStrHeaderBytes()
    for i in 0..<items.len:
        total = total + CompilerCsgStringPayloadBytes(items[i])
    return total

@borrows
fn CompilerCsgIntArrayLiveBytes(items: int32[]): int64 =
    return Int64(items.len) * CompilerCsgI32Bytes()

@borrows
fn CompilerCsgInternIdArrayLiveBytes(items: langintern.InternId[]): int64 =
    return Int64(items.len) * CompilerCsgI32Bytes()

@borrows
fn CompilerCsgInt64ArrayLiveBytes(items: int64[]): int64 =
    return Int64(items.len) * Int64(8)

fn CompilerCsgSequenceSlots(length: int32,
                            capacity: int32,
                            retainedCapacity: bool): int32 =
    if retainedCapacity:
        return capacity
    return length

@borrows
fn CompilerCsgIntArrayBytesMode(items: int32[],
                                retainedCapacity: bool): int64 =
    return Int64(CompilerCsgSequenceSlots(items.len,
                                          items.cap,
                                          retainedCapacity)) * Int64(4)

@borrows
fn CompilerCsgInternIdArrayBytesMode(items: langintern.InternId[],
                                     retainedCapacity: bool): int64 =
    return Int64(CompilerCsgSequenceSlots(items.len,
                                          items.cap,
                                          retainedCapacity)) * Int64(4)

@borrows
fn CompilerCsgInt64ArrayBytesMode(items: int64[],
                                  retainedCapacity: bool): int64 =
    return Int64(CompilerCsgSequenceSlots(items.len,
                                          items.cap,
                                          retainedCapacity)) * Int64(8)

@borrows
fn CompilerCsgBoolArrayBytesMode(items: bool[],
                                 retainedCapacity: bool): int64 =
    return Int64(CompilerCsgSequenceSlots(items.len,
                                          items.cap,
                                          retainedCapacity))

@borrows
fn CompilerCsgFixed32ArrayBytesMode(items: layout.FixedBytes32[],
                                    retainedCapacity: bool): int64 =
    return Int64(CompilerCsgSequenceSlots(items.len,
                                          items.cap,
                                          retainedCapacity)) *
           CompilerCsgFixed32Bytes()

@borrows
fn CompilerCsgStrArrayBytesMode(items: str[],
                                retainedCapacity: bool): int64 =
    var total = Int64(CompilerCsgSequenceSlots(items.len,
                                               items.cap,
                                               retainedCapacity)) * Int64(24)
    for i in 0..<items.len:
        total = total + Int64(items[i].len)
    return total

fn CompilerCsgEnumArrayBytesMode(length: int32,
                                 capacity: int32,
                                 retainedCapacity: bool): int64 =
    return Int64(CompilerCsgSequenceSlots(length,
                                          capacity,
                                          retainedCapacity)) * Int64(4)

fn CompilerCsgParserTextLookupCapacityBytesMode(lookup: var parser.ParserTextLookup,
                                                ownsItemPayload: bool): int64 =
    var total = CompilerCsgSequenceHeaderBytes() * Int64(2) +
                Int64(lookup.slots.cap) * CompilerCsgI32Bytes()
    total = total + Int64(lookup.buckets.cap) *
                    CompilerCsgParserTextLookupBucketRowBytes()
    for bucketIndex in 0..<lookup.buckets.len:
        total = total + Int64(lookup.buckets[bucketIndex].items.cap) *
                        CompilerCsgStrHeaderBytes()
        if ownsItemPayload:
            for itemIndex in 0..<lookup.buckets[bucketIndex].items.len:
                total = total +
                    Int64(lookup.buckets[bucketIndex].items[itemIndex].len)
    return total

fn CompilerCsgParserTextLookupCapacityBytes(lookup: var parser.ParserTextLookup): int64 =
    # Exact parser scratch ownership: lookup item strings alias the profile's
    # declaration names. The lookup owns sequence storage and str headers only.
    return CompilerCsgParserTextLookupCapacityBytesMode(lookup, false)

fn CompilerCsgProfileCallLookupEntryCapacityBytes(entry: var parser.ParserProfileCallLookupCacheEntry): int64 =
    return CompilerCsgParserTextLookupCapacityBytes(entry.localLookup) +
           CompilerCsgParserTextLookupCapacityBytes(entry.importcLookup) -
           CompilerCsgSequenceHeaderBytes() * Int64(4)

fn CompilerCsgProfileCallLookupArrayCapacityBytes(items: var parser.ParserProfileCallLookupCacheEntry[]): int64 =
    var total = CompilerCsgSequenceHeaderBytes() +
                Int64(items.cap) * CompilerCsgProfileCallLookupEntryRowBytes()
    for itemIndex in 0..<items.len:
        total = total + CompilerCsgProfileCallLookupEntryCapacityBytes(items[itemIndex])
    return total

fn CompilerCsgExprLayerCapacityBytesMode(layer: var parser.NormalizedExprLayer,
                                         ownsStringPayload: bool): int64 =
    var total = CompilerCsgSequenceHeaderBytes() * Int64(5) +
                Int64(layer.exprs.cap) * CompilerCsgExprRowBytes() +
                Int64(layer.exprNext.cap) * CompilerCsgI32Bytes() +
                Int64(layer.scopes.cap) * CompilerCsgNormalizedScopeFactRowBytes() +
                Int64(layer.exprLookup.slots.cap) * CompilerCsgI32Bytes() +
                Int64(layer.exprLookup.buckets.cap) * CompilerCsgExprLookupBucketRowBytes()
    if ownsStringPayload:
        for exprIndex in 0..<layer.exprs.len:
            let expr = layer.exprs[exprIndex]
            total = total + Int64(expr.exprId.len + expr.sourcePath.len +
                                  expr.surfaceText.len + expr.callQualifier.len +
                                  expr.callCallee.len + expr.callTarget.len +
                                  expr.callTargetSourcePath.len + expr.callArgsText.len)
        for scopeIndex in 0..<layer.scopes.len:
            total = total + Int64(layer.scopes[scopeIndex].sourcePath.len)
    return total

fn CompilerCsgExprLayerCapacityBytes(layer: var parser.NormalizedExprLayer): int64 =
    return CompilerCsgExprLayerCapacityBytesMode(layer, true)

fn CompilerCsgStringSequenceCapacityBytes(items: var str[]): int64 =
    var total = CompilerCsgSequenceHeaderBytes() +
                Int64(items.cap) * CompilerCsgStrHeaderBytes()
    for itemIndex in 0..<items.len:
        total = total + Int64(items[itemIndex].len)
    return total

@borrows
fn CompilerCsgStringSequenceCapacityBytesShallow(items: str[]): int64 =
    return CompilerCsgSequenceHeaderBytes() +
           Int64(items.cap) * CompilerCsgStrHeaderBytes()

fn CompilerCsgStructuredSourceFactsBytes(
        facts: var parser.ParserStructuredSourceFacts,
        retainedCapacity: bool): int64 =
    var total = Int64(CompilerCsgSequenceSlots(
                    facts.scopes.len, facts.scopes.cap, retainedCapacity)) *
                    Int64(sizeof(parser.NormalizedScopeFact)) +
                Int64(CompilerCsgSequenceSlots(
                    facts.seeds.len, facts.seeds.cap, retainedCapacity)) *
                    Int64(sizeof(parser.ParserStructuredStatementSeed))
    total = total + Int64(
        CompilerCsgSequenceSlots(facts.lineScopeIds.len,
                                 facts.lineScopeIds.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(facts.lineInlineSuiteBodyColumns.len,
                                 facts.lineInlineSuiteBodyColumns.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(facts.lineInlineSuiteScopeIds.len,
                                 facts.lineInlineSuiteScopeIds.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(facts.lineDeferOwnerOrdinals.len,
                                 facts.lineDeferOwnerOrdinals.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(facts.lineInlineDeferBodyColumns.len,
                                 facts.lineInlineDeferBodyColumns.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(facts.lineInlineDeferSuiteScopeIds.len,
                                 facts.lineInlineDeferSuiteScopeIds.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(facts.lineSeedStarts.len,
                                 facts.lineSeedStarts.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(facts.lineSeedCounts.len,
                                 facts.lineSeedCounts.cap, retainedCapacity)) *
        CompilerCsgI32Bytes()
    # Payload bytes are captured once by DomainInit; hot samples stay O(1).
    return total

fn CompilerCsgStructuredSourceSliceBytes(
        slice: var parser.ParserStructuredSourceSlice,
        retainedCapacity: bool): int64 =
    var total = Int64(CompilerCsgSequenceSlots(
                    slice.scopes.len, slice.scopes.cap, retainedCapacity)) *
                    Int64(sizeof(parser.NormalizedScopeFact)) +
                Int64(CompilerCsgSequenceSlots(
                    slice.seeds.len, slice.seeds.cap, retainedCapacity)) *
                    Int64(sizeof(parser.ParserStructuredStatementSeed))
    total = total + Int64(
        CompilerCsgSequenceSlots(slice.sourceScopeIds.len,
                                 slice.sourceScopeIds.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(slice.sourceStatementOrdinals.len,
                                 slice.sourceStatementOrdinals.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(slice.lineScopeIds.len,
                                 slice.lineScopeIds.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(slice.lineInlineSuiteBodyColumns.len,
                                 slice.lineInlineSuiteBodyColumns.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(slice.lineInlineSuiteScopeIds.len,
                                 slice.lineInlineSuiteScopeIds.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(slice.lineDeferOwnerOrdinals.len,
                                 slice.lineDeferOwnerOrdinals.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(slice.lineInlineDeferBodyColumns.len,
                                 slice.lineInlineDeferBodyColumns.cap, retainedCapacity) +
        CompilerCsgSequenceSlots(slice.lineInlineDeferSuiteScopeIds.len,
                                 slice.lineInlineDeferSuiteScopeIds.cap, retainedCapacity)) *
        CompilerCsgI32Bytes()
    # Slice strings retain authoritative facts payloads; count their row
    # headers here and the shared payload exactly once in facts.
    return total

fn CompilerCsgStructuredSourceDomainBytes(
        domain: var CompilerCsgStructuredSourceDomain,
        retainedCapacity: bool): int64 =
    var total = CompilerCsgBoolArrayBytesMode(domain.seenStatements,
                                               retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(domain.denseScopes,
                                                  retainedCapacity) +
                    CompilerCsgIntArrayBytesMode(domain.denseStatements,
                                                  retainedCapacity) +
                    CompilerCsgIntArrayBytesMode(domain.scopeChildCounts,
                                                  retainedCapacity) +
                    CompilerCsgIntArrayBytesMode(domain.statementLexicalCounts,
                                                  retainedCapacity)
    return total

fn CompilerCsgStructuredSidecarReportSample(
        report: var CompilerCsgStructuredSidecarReport,
        facts: var parser.ParserStructuredSourceFacts,
        slice: var parser.ParserStructuredSourceSlice,
        domain: var CompilerCsgStructuredSourceDomain) =
    let retainedBytes = domain.factsPayloadBytes +
                        CompilerCsgStructuredSourceFactsBytes(facts, true) +
                        CompilerCsgStructuredSourceSliceBytes(slice, true) +
                        CompilerCsgStructuredSourceDomainBytes(domain, true)
    let liveBytes = domain.factsPayloadBytes +
                    CompilerCsgStructuredSourceFactsBytes(facts, false) +
                    CompilerCsgStructuredSourceSliceBytes(slice, false) +
                    CompilerCsgStructuredSourceDomainBytes(domain, false)
    if retainedBytes > report.phasePeakCapacityBytes:
        report.phasePeakCapacityBytes = retainedBytes
    if liveBytes > report.phasePeakLiveBytes:
        report.phasePeakLiveBytes = liveBytes

fn CompilerCsgHashMapStrIntCapacityBytesShallow(items: hashmaps.HashMapStrInt): int64 =
    return CompilerCsgSequenceHeaderBytes() * Int64(4) +
           Int64(items.keys.cap) * CompilerCsgStrHeaderBytes() +
           Int64(items.vals.cap) * CompilerCsgI32Bytes() +
           Int64(items.hashes.cap) * Int64(8) +
           Int64(items.states.cap)

fn CompilerCsgStagingCapacityLedgerRefresh(ledger: var CompilerCsgStagingCapacityLedger) =
    ledger.totalBytes = ledger.sortingBytes + ledger.sparseIndexBytes +
                        ledger.reachabilityDeltaBytes +
                        ledger.frontierAdjacencyBytes +
                        ledger.frontierSelectionBytes +
                        ledger.frontierOutputBytes +
                        ledger.profileStateJournalBytes +
                        ledger.profilePendingBytes +
                        ledger.profileCacheOverlayBytes +
                        ledger.profileLineScratchBytes +
                        ledger.profileResolverScratchBytes +
                        ledger.parserCacheScratchBytes +
                        ledger.frontierParserScratchBytes +
                        ledger.typedFactTransactionBytes +
                        ledger.validationBytes
    ledger.phasePeakBytes = ledger.totalBytes

fn CompilerCsgStagingCapacityLedgerRecordPhase(ledger: var CompilerCsgStagingCapacityLedger,
                                                phaseRaw: CompilerCsgStagingCapacityLedger) =
    var phase = phaseRaw
    CompilerCsgStagingCapacityLedgerRefresh(phase)
    let nextSnapshotCount = ledger.phaseSnapshotCount + Int64(1)
    if nextSnapshotCount <= Int64(0):
        panic("compiler csg: staging phase snapshot counter overflow")
    if phase.totalBytes >= ledger.phasePeakBytes:
        ledger = phase
    ledger.phaseSnapshotCount = nextSnapshotCount
    if ledger.phasePeakBytes < ledger.totalBytes:
        panic("compiler csg: staging phase peak lost")

@borrows
fn CompilerCsgStagingCapacityLedgerFieldSum(ledger: CompilerCsgStagingCapacityLedger): int64 =
    return ledger.sortingBytes + ledger.sparseIndexBytes +
           ledger.reachabilityDeltaBytes + ledger.frontierAdjacencyBytes +
           ledger.frontierSelectionBytes + ledger.frontierOutputBytes +
           ledger.profileStateJournalBytes + ledger.profilePendingBytes +
           ledger.profileCacheOverlayBytes + ledger.profileLineScratchBytes +
           ledger.profileResolverScratchBytes + ledger.parserCacheScratchBytes +
           ledger.frontierParserScratchBytes +
           ledger.typedFactTransactionBytes + ledger.validationBytes

@borrows
fn CompilerCsgStagingCapacityLedgerValidate(ledger: CompilerCsgStagingCapacityLedger,
                                             err: var str): bool =
    let fieldSum = CompilerCsgStagingCapacityLedgerFieldSum(ledger)
    if ledger.sortingBytes < Int64(0) || ledger.sparseIndexBytes < Int64(0) ||
       ledger.reachabilityDeltaBytes < Int64(0) ||
       ledger.frontierAdjacencyBytes < Int64(0) ||
       ledger.frontierSelectionBytes < Int64(0) ||
       ledger.frontierOutputBytes < Int64(0) ||
       ledger.profileStateJournalBytes < Int64(0) ||
       ledger.profilePendingBytes < Int64(0) ||
       ledger.profileCacheOverlayBytes < Int64(0) ||
       ledger.profileLineScratchBytes < Int64(0) ||
       ledger.profileResolverScratchBytes < Int64(0) ||
       ledger.parserCacheScratchBytes < Int64(0) ||
       ledger.frontierParserScratchBytes < Int64(0) ||
       ledger.typedFactTransactionBytes < Int64(0) ||
       ledger.validationBytes < Int64(0) || ledger.totalBytes != fieldSum ||
       (ledger.frontierOutputPrimaryOwnsStringPayload &&
        ledger.frontierOutputScratchOwnsStringPayload) ||
       ledger.phasePeakBytes != ledger.totalBytes ||
       ledger.phaseSnapshotCount < Int64(0):
        err = Fmt" compiler csg: staging capacity ledger invalid total={ledger.totalBytes} fields={fieldSum} peak={ledger.phasePeakBytes}"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgInternPoolBytesMode(pool: langintern.InternPool,
                                  retainedCapacity: bool): int64 =
    # BIGSRC-SPLIT 后委托 intern 自带核算 (InternPoolRetainedBytes):
    # 列布局变更(keys 并入 texts 句柄, 5 列→4 列)不再破坏本统计;
    # retainedCapacity=false 语义 = 剔除 index 容量保留 (仅 header+inline
    # +textSlot+logicalPayload), 与旧口径的 live 语义对齐。
    if pool == nil:
        return Int64(0)
    let report = langintern.InternPoolRetainedBytes(pool)
    if retainedCapacity:
        return report.structuredBytes + report.logicalPayloadBytes
    return report.textSequenceHeaderBytes + report.poolInlineFieldBytes +
           report.textSlotBytes + report.logicalPayloadBytes

@borrows
fn CompilerCsgSourceTextPayloadLiveBytes(sourcePath: str,
                                         modulePath: str,
                                         text: str): int64 =
    return CompilerCsgSourceTextRowBytes() +
           CompilerCsgStringPayloadBytes(sourcePath) +
           CompilerCsgStringPayloadBytes(modulePath) +
           CompilerCsgStringPayloadBytes(text)

@borrows
fn CompilerCsgNodePayloadBytes(node: CompilerCsgNode): int64 =
    return Int64(len(node.modulePath)) +
           Int64(len(node.symbolText)) +
           Int64(len(node.factText)) +
           Int64(len(node.semanticSource)) +
           Int64(len(node.semanticParamTypeJoin)) +
           Int64(len(node.semanticReturnType)) +
           Int64(len(node.exportSymbolName))

fn CompilerCsgNodesLiveBytes(csg: var CompilerCsg): int64 =
    var total: int64 = Int64(csg.nodes.len) * CompilerCsgNodeRowBytes()
    for i in 0..<csg.nodes.len:
        total = total + CompilerCsgNodePayloadBytes(csg.nodes[i])
    return total

fn CompilerCsgEdgesLiveBytes(csg: var CompilerCsg): int64 =
    return Int64(csg.edges.len) * CompilerCsgEdgeRowBytes()

fn CompilerCsgExprLayerLiveBytes(layer: var parser.NormalizedExprLayer): int64 =
    var total: int64 = Int64(layer.exprs.len) * CompilerCsgExprRowBytes()
    total = total + Int64(layer.scopes.len) * CompilerCsgNormalizedScopeFactRowBytes()
    total = total + CompilerCsgIntArrayLiveBytes(layer.exprNext)
    total = total + CompilerCsgIntArrayLiveBytes(layer.exprLookup.slots)
    total = total + Int64(layer.exprLookup.buckets.len) * CompilerCsgExprLookupBucketRowBytes()
    for i in 0..<layer.exprs.len:
        total = total + Int64(len(layer.exprs[i].exprId))
        total = total + Int64(len(layer.exprs[i].sourcePath))
        total = total + Int64(len(layer.exprs[i].surfaceText))
        total = total + Int64(len(layer.exprs[i].callQualifier))
        total = total + Int64(len(layer.exprs[i].callCallee))
        total = total + Int64(len(layer.exprs[i].callTarget))
        total = total + Int64(len(layer.exprs[i].callTargetSourcePath))
        total = total + Int64(len(layer.exprs[i].callArgsText))
    for scopeIndex in 0..<layer.scopes.len:
        total = total + Int64(layer.scopes[scopeIndex].sourcePath.len)
    return total

@borrows
fn CompilerCsgTypedFactPayloadBytes(fact: TypedExprFact): int64 =
    return Int64(len(fact.exprId)) +
           Int64(len(fact.sourcePath)) +
           Int64(len(fact.callQualifier)) +
           Int64(len(fact.callCallee)) +
           Int64(len(fact.callTarget)) +
           Int64(len(fact.callTargetSourcePath)) +
           Int64(len(fact.callArgsText)) +
           Int64(len(fact.typeText))

fn CompilerCsgTypedFactsLiveBytes(facts: var TypedExprFactTable): int64 =
    var total: int64 = Int64(facts.count) * CompilerCsgTypedFactRowBytes()
    for i in 0..<facts.count:
        total = total + CompilerCsgTypedFactPayloadBytes(texpr.TypedExprFactAt(facts, i))
    return total

fn CompilerCsgTypedFactTableCapacityBytes(
        facts: var TypedExprFactTable): int64 =
    return Int64(facts.arena.capacityBytes) +
           CompilerCsgInternPoolBytesMode(facts.internPool, true)

fn CompilerCsgTypedIrDynamicSequenceBytes(ir: var texpr.TypedExprIr,
                                           retainedCapacity: bool): int64 =
    var total: int64
    total = total + CompilerCsgInternIdArrayBytesMode(ir.functions2_sourcePathIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.functions2_functionNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.functions2_returnTypeIds, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(
        ir.functions2_resultExprClasses.len,
        ir.functions2_resultExprClasses.cap,
        retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(
        ir.functions2_borrowsArguments,
        retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.functions2_returnExprIds, retainedCapacity)

    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_sourcePathIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_functionNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_enclosingIfConditionTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_exprIdIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_surfaceTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_bindingNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_resultTypeIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_conditionLhsTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_conditionRhsTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_conditionLiteralTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignRootNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignRootTypeIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignRootSourcePathIds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.statements2_assignRootGlobalFlags, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignFieldNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignFieldTypeIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignValueRootNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignValueRootTypeIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignValueFieldNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignValueFieldTypeIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignValueLhsTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_assignValueRhsTextIds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.statements2_assignValueRhsHasConsts, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_callQualifierIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_callCalleeIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_callTargetIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_callTargetSourcePathIds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.statements2_callTargetImportcs, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_callArgsTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.statements2_callArgTypesTextIds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.statements2_returnRoots, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_kinds.len, ir.statements2_kinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_callKinds.len, ir.statements2_callKinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_detailKinds.len, ir.statements2_detailKinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_assignPlaceKinds.len, ir.statements2_assignPlaceKinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_assignValueOpKinds.len, ir.statements2_assignValueOpKinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_rhsBailReasons.len, ir.statements2_rhsBailReasons.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_callSurfaceKinds.len, ir.statements2_callSurfaceKinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_loweringModes.len, ir.statements2_loweringModes.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.statements2_returnKinds.len, ir.statements2_returnKinds.cap, retainedCapacity)

    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_sourcePathIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_functionNameIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_resultTypeIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_surfaceTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_paramNameIds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(
        ir.nodes2_paramMutableFlags, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_callTargetIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_callTargetSourcePathIds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.nodes2_callTargetImportcs, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_literalTextIds, retainedCapacity)
    total = total + CompilerCsgInternIdArrayBytesMode(ir.nodes2_fieldTypeSourcePathIds, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.nodes2_opKinds.len, ir.nodes2_opKinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.nodes2_callKinds.len, ir.nodes2_callKinds.cap, retainedCapacity)
    total = total + CompilerCsgEnumArrayBytesMode(ir.nodes2_exprClasses.len, ir.nodes2_exprClasses.cap, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.nodes2_resultTypeManagedFlags, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.nodes2_resultTypeSendFlags, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(ir.nodes2_resultTypeSyncFlags, retainedCapacity)

    total = total + Int64(CompilerCsgSequenceSlots(ir.coldCsgTypeRows.len, ir.coldCsgTypeRows.cap, retainedCapacity)) * CompilerCsgColdTypeRowBytes()
    for i in 0..<ir.coldCsgTypeRows.len:
        total = total + Int64(ir.coldCsgTypeRows[i].sourcePath.len)
        total = total + Int64(ir.coldCsgTypeRows[i].typeName.len)
        total = total + Int64(ir.coldCsgTypeRows[i].specs.len)
        total = total + Int64(ir.coldCsgTypeRows[i].typeParams.len)
    total = total + Int64(CompilerCsgSequenceSlots(ir.coldCsgStatementRows.len, ir.coldCsgStatementRows.cap, retainedCapacity)) * CompilerCsgColdStatementRowBytes()
    for i in 0..<ir.coldCsgStatementRows.len:
        total = total + Int64(ir.coldCsgStatementRows[i].sourcePath.len)
        total = total + Int64(ir.coldCsgStatementRows[i].functionName.len)
        total = total + Int64(ir.coldCsgStatementRows[i].kind.len)
        total = total + Int64(ir.coldCsgStatementRows[i].payloadText.len)

    total = total + CompilerCsgStrArrayBytesMode(ir.globalSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.globalNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.globalTypes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.globalProducerSourceIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.globalDeclarationSourceLocalRows, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.globalInitValues, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.localBindingSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.localBindingFunctionNames, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.localBindingLineNumbers, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.localBindingNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.localBindingTypes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.localBindingNameIndexBucketHeads, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.localBindingNameIndexEntryNext, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.localBindingNameIndexEntryBindingIndexes, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.localBindingNameIndexEntryNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.importcSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.importcNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.importcReturnTypes, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.importcTargetSymbols, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.importcParamTypeJoins, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeLayoutSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeLayoutNames, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.typeLayoutSizeBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.typeLayoutAlignBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.typeLayoutFieldCounts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeLayoutProducerSourceIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeLayoutDeclarationSourceLocalRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeLayoutBuiltinKinds, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeFieldSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeFieldOwnerTypes, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeFieldNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeFieldTypes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.typeFieldOffsetBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.typeFieldSizeBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.typeFieldAlignBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeFieldProducerSourceIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeFieldOwnerDeclarationSourceLocalRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeFieldDeclarationSourceLocalRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeFieldOrdinals, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.typeFieldBuiltinKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.exactLayoutIndexSourceStarts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.exactLayoutTypeDeclarationRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.exactLayoutTypeBuiltinRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.exactLayoutFieldDeclarationRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.exactLayoutFieldBuiltinRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.exactLayoutOwnerDeclarationFieldCounts,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        ir.exactLayoutOwnerBuiltinFieldCounts, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeDefAliasSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeDefAliasNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeDefAliasTargetTypes, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeAliasSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeAliasQualifiers, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.typeAliasTargetSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.enumValueSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.enumValueNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.enumValueTypes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.enumValueOrdinals, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.refObjectSourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.refObjectTypeNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.sourceContextIndexSourcePaths, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.sourceContextIndexBucketHeads, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.sourceContextIndexEntryNext, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.sourceContextIndexEntryIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.statementFunctionIndexBucketHeads, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.statementFunctionIndexEntryNext, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.statementFunctionIndexEntryStatementIndexes, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.statementFunctionIndexEntryNames, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.statementFnBindingIndexBucketHeads, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.statementFnBindingIndexEntryNext, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.statementFnBindingIndexEntryStatementIndexes, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.statementFnBindingIndexEntryFunctionNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.statementFnBindingIndexEntryBindingNames, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.paramRefIndexBucketHeads, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.paramRefIndexEntryNext, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(ir.paramRefIndexEntryNodeIndexes, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.paramRefIndexEntrySourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.paramRefIndexEntryFunctionNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(ir.paramRefIndexEntryParamNames, retainedCapacity)
    return total

fn CompilerCsgTypedIrCoreLiveBytes(ir: var texpr.TypedExprIr): int64 =
    var total: int64
    # Interned text payload is owned and counted once by internPool. Core rows
    # contain InternId columns, so re-materializing every row would double count
    # strings and turn accounting into allocator-heavy compiler work.
    total = total + Int64(ir.functions2_functionNameIds.len) * CompilerCsgTypedIrFunctionRowBytes()
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.functions2_sourcePathIds)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.functions2_functionNameIds)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_signatureLineNumbers) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_endLineNumbers) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_bodyLineNumbers) * 4)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.functions2_returnTypeIds)
    total = total + Int64(ir.functions2_resultExprClasses.len) *
                    CompilerCsgFixed32Bytes()
    total = total + Int64(ir.functions2_borrowsArguments.len)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.functions2_returnExprIds)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_statementStarts) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_statementCounts) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_nodeStarts) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_nodeCounts) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_returnNodeIndexs) * 4)
    total = total + Int64(ir.nodes2_nodeIndexs.len) * CompilerCsgTypedIrNodeRowBytes()
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.nodes2_sourcePathIds)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.nodes2_functionNameIds)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_nodeIndexs) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_lineNumbers) * 4)
    total = total + Int64(ir.nodes2_opKinds.len) * CompilerCsgFixed32Bytes()
    total = total + Int64(ir.nodes2_callKinds.len) * CompilerCsgFixed32Bytes()
    total = total + Int64(ir.nodes2_exprClasses.len) * CompilerCsgFixed32Bytes()
    total = total + Int64(arenamod.ArenaArrayInt32Len(
        ir.arena, ir.nodes2_resultTypeProofKinds) * 4)
    total = total + Int64(ir.nodes2_resultTypeManagedFlags.len)
    total = total + Int64(ir.nodes2_resultTypeSendFlags.len)
    total = total + Int64(ir.nodes2_resultTypeSyncFlags.len)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.nodes2_resultTypeIds)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.nodes2_surfaceTextIds)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_paramSlots) * 4)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.nodes2_paramNameIds)
    total = total + Int64(ir.nodes2_paramMutableFlags.len)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_operand0NodeIndexs) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_operand1NodeIndexs) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_operand2NodeIndexs) * 4)
